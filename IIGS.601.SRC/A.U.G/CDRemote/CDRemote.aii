	PRINT NOHDR* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * File:  CDRemote.aii			**				** Module for CD-Remote (A New Desk Accessory)		** 				** Author:  Don Brady			**				** Build File:	CDRemote.make			**				** Copyright © APPLE Computer, Inc. 1987,1988		** All Rights Reserved.			**				** Modification History:			** Version 1.0				** 01/18/88  Released A1 today			** 02/11/88  Released A2 today			** 02/17/88  Converted to MAX (from APW) today		** 03/21/88  Release A4 today			** 04/01/88  Release B1 today			** 04/13/88  Release B2 (informal) today		** 04/15/88  Release B3 today			** 04/17/88  Release B4 (informal) today		** 04/18/88  Final Release of 1.0 today		**				** Version 1.1				** 07/26/88  DJB - Added CDBusy flag 		** 09/01/88  DJB - Added call to _FlashMenuBar for key presses	**				** Version 1.2				** 12/02/88  DJB - Changes made for Matt's new CD Driver	** 04/13/89  DJB - Changed from HeartBeatTask to RunQueueTask	**				** Version 1.3 - Maintenance by Cary Farrier		** 11/01/90  CAF - Fixed Bug 60966 in DoAudioR,L.	**				** Version 1.3d2 - Maintenance by Dave Lyons		** 23-Jan-91 - Made window create invisible so I can set the	**             background pattern to black before it draws the	**             first time.			** 				** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * 	PRINT OFF	INCLUDE  'Draw.equ'	INCLUDE  'CDRemote.equ'	INCLUDE  'all.macros'	PRINT ON	*===============================================**           The standard NDA Header	**===============================================*NDAHeader	PROC	IMPORT  (NDAOpen,NDAClose,NDAAction,NDAInit):CODE		STRING  ASIS	DC.L  NDAOpen	DC.L  NDAClose	DC.L  NDAAction	DC.L  NDAInit	DC.W  60		;period (60 ticks = 1 sec)	DC.W  $014E		;event mask	DC.B  '--CD Remote\H**'	;menu text	DC.B  13	DC.B  'ver 1.3/'	;...for load file dumps	DC.B  '© Copyright Apple Computer, Inc.1987-92'	STRING  PASCAL		ENDP*===============================================**	Data for NDA		**===============================================*CDData	RECORD	ENTRY  ABMode:DATA	EXPORT CDAFrame:DATA	EXPORT CDAMin:DATA	EXPORT CDASec:DATA	EXPORT CDATime:DATA	ENTRY  CDAudio:DATA	ENTRY  CDButton:DATA	EXPORT CDCurTrk:DATA	EXPORT CDIndex:DATA	ENTRY  DidAlert:DATA	ENTRY  CDError:DATA	EXPORT CDFrame:DATA	ENTRY  CDFrameA:DATA	EXPORT CDFrameB:DATA	ENTRY  CDMaxTrk:DATA	EXPORT CDMin:DATA	ENTRY  CDMinA:DATA	EXPORT  CDMinB:DATA	EXPORT CDMinTrk:DATA	ENTRY  CDMode:DATA	ENTRY  CDPMode:DATA	ENTRY  CDRepeat:DATA	ENTRY  CDScan:DATA	EXPORT CDSec:DATA	ENTRY  CDSecA:DATA	EXPORT  CDSecB:DATA	EXPORT  CDTrack:DATA	EXPORT CDTrkCnt:DATA	ENTRY  CDWait:DATA	ENTRY  CDWinPtr:DATA	ENTRY  CDWinRec:DATA	ENTRY  Modifier:DATA	ENTRY  Point:DATA	ENTRY  TimeMode:DATA	ENTRY  WinPtr2:DATA	ENTRY  EndRec:DATA 	ENTRY  EndRec2:DATA	ENTRY  WinRec2:DATA	ENTRY  WaitCur:DATA	ENTRY  ItemString:DATA	ENTRY  ErrString1:DATA	ENTRY  ErrString2:DATA	ENTRY  ErrString3:DATA	ENTRY  ErrString4:DATA	ENTRY  EndString1:DATA	ENTRY  EndString2:DATA	ENTRY  EndString3:DATA	ENTRY  EndString4:DATA	ENTRY  ErrStrPtr:DATA	ENTRY  ErrStrRect:DATA	ENTRY  OldWinPtr:DATA	ENTRY  AlertTemplate:DATA	ENTRY  WindowRect:DATA		ENTRY  WindowRect2:DATA* ENTRY  ErrorCode:DATA           * ENTRY  SenseKey:DATA            * ENTRY  SenseCode:DATA* ENTRY  CDAlert:DATA	ENTRY  MaxIndex:DATA	ENTRY  CurIndex:DATA	ENTRY  TrackMap:DATA	ENTRY  CDTask:DATA	ENTRY  CDDataDisc:DATA	ENTRY  CDBusy:DATA	ENTRY  TaskInQueue:DATA;	ENTRY  NullTask:DATA	ENTRY  AudioWait:DATA	;---------------  FLAGS  ----------------CDError	DC.W  $8000	;0 = ok, else errorCDPMode	DC.W  0	;$01=shuffle, $02=AB-repeatCDMode	DC.W  0	;0=stop,1=play,2=pause,3=no discCDRepeat	DC.W  0	;0 = off, 1 = onDidAlert	DC.W  0	;­ 0: did error alert, 0 = not yetCDAudio	DC.W  $C000	;bit 15=left, bit 14=rightCDWait	DC.W  0	;timerCDScan	DC.W  0	;0 = off, 1 = onABMode	DC.W  0TimeMode	DC.W  0	;0 = elapsed, 1 = remaining Modifier	DC.W  0	;Event record modifier flagsWaitCur	DC.W  0	;1 = wait cursor on, 0 = offCDTask	DC.W  0	;0 = no task, ­ 0 is a taskCDDataDisc	DC.W  0	;0 = not data, ­ 0 is only dataCDBusy	DC.W  0	;­ 0: CD-Remote is busyTaskInQueue	DC.W  0	;­ 0: my task is in the queue;NullTask	DC.W  0	;­ 0: means don't do task anymoreAudioWait	DC.W  0	;­ 0: if we are waiting for play completion;----------  Current settings  ----------Point	DC.L  0	;mouse coordinates (y,x)CDTrack	DC.W  0CDIndex	DC.W  0CDTrkCnt	DC.W  0	;integer number of tracksCDMinTrk	DC.W  0CDMaxTrk	DC.W  0CDCurTrk	DC.W  0	;track from Q-sub channelCDMin	DC.W  0	;time (track relative)CDSec	DC.W  0CDFrame	DC.W  0CDAMin	DC.W  0	;time (absolute)CDASec	DC.W  0CDAFrame	DC.W  0CDButton	DC.W  0	;button pushedCDMinA	DC.W  0	;AB starting pointCDSecA	DC.W  0CDFrameA	DC.W  0CDMinB	DC.W  0	;AB ending pointCDSecB	DC.W  0CDFrameB	DC.W  0CDATime	DS.B  200	;(2*100) absolute time tableCurIndex	DC.W  0MaxIndex	DC.W  0TrackMap	DS.B  100;---------  Window Data  ----------------OldWinPtr	DC.L  0		;space for _GetPortCDWinPtr	DC.L  0CDTitle  	DC.B  'CD Remote'	;window titleCDWinRec	DC.W  EndRec-CDWinRec	;data length	DC.W  $C089		;frame bits (was $C0A9 23-Jan-91 DAL; made it initially invisible)	DC.L  CDTitle		;title ptr	DC.L  0		;RefCon	DC.W  0,0,0,0		;full size	DC.L  0		;color table ptr	DC.W  0		;vertical org	DC.W  0		;horizontal org	DC.W  0		;data area height	DC.W  0		;data area width	DC.W  0		;max cont height	DC.W  0		;max cont width	DC.W  0		;vert scroll pixels	DC.W  0		;hort scroll pixels	DC.W  0		;vert page pixels	DC.W  0		;hort page pixels	DC.L  0		;info bar text ptr	DC.W  0		;info bar height	DC.L  0		;DefProc	DC.L  0		;draw info bar routine	DC.L  0		;draw content routineWindowRect	DC.W  w1Y,w1X,w1Y+dvW1,w1X+dhW1	;rect	DC.L  $FFFFFFFF		;window plane	DC.L  0		;0 = allocate win recordEndRecWinPtr2	DC.L  0WinRec2	DC.W  EndRec2-WinRec2	;data length	DC.W  %0010000000100001	;frame bits	DC.L  0		;title ptr	DC.L  0		;RefCon	DC.W  0,0,0,0		;full size	DC.L  0		;color table ptr	DC.W  0		;vertical org	DC.W  0		;horizontal org	DC.W  0		;data area height	DC.W  0		;data area width	DC.W  0		;max cont height	DC.W  0		;max cont width	DC.W  0		;vert scroll pixels	DC.W  0		;hort scroll pixels	DC.W  0		;vert page pixels	DC.W  0		;hort page pixels	DC.L  0		;info bar text ptr	DC.W  0		;info bar height	DC.L  0		;DefProc	DC.L  0		;draw info bar routine	DC.L  0		;draw content routineWindowRect2	DC.W  w2Y,w2X,w2Y+dvW2,w2X+dhW2	;rect	DC.L  $FFFFFFFF		;window plane	DC.L  0		;0 = allocate win recordEndRec2;---------  Alert Data  ----------------	STRING  PASCALItemString	DC.B  'OK'	STRING  ASISErrString1	DC.B  EndString1-ErrString1-1	DC.B  'The AppleCD SCª drive can-'	DC.B  $0D	DC.B  'not be found. Please check'	DC.B  $0D	DC.B  'your SCSI cables and  SCSI'	DC.B  $0D	DC.B  'priority assignments.'EndString1ErrString2*	DC.B  EndString2-ErrString2-1		;this string no longer used*	DC.B  'The AppleII SCSI Card ROM'*	DC.B  $0D*	DC.B  'needs to be upgraded to be'*	DC.B  $0D*	DC.B  'compatible with the drive'*	DC.B  $0D*	DC.B  'AppleCD SCª.'EndString2ErrString3*	DC.B  EndString3-ErrString3-1*	DC.B  'The AppleII SCSI Card can-'	;this string no longer used*	DC.B  $0D*	DC.B  'not be found. Please check'*	DC.B  $0D*	DC.B  'your  I/O  expansion slots'*	DC.B  $0D*	DC.B  'and Control Panel settings.'EndString3ErrString4	DC.B  EndString4-ErrString4-1	DC.B  'I am sorry,  but GS/OS is'	DC.B  $0D	DC.B  'needed to run this desk'	DC.B  $0D	DC.B  'accessory.'EndString4	STRING  PASCALItem1Template	DC.W  1		;item ID	DC.W  aDY-17,(aDX-80)/2,aDy-6,(aDX+80)/2	DC.W  $000A		;item type	DC.L  ItemString	;item descriptor	DC.W  0		;item value	DC.W  0		;item flag	DC.L  0		;item color table	Item2Template	DC.W  3		;item IDErrStrRect	DC.W  4,76,aDY,aDX	;item rect	DC.W  $800F		;item typeErrStrPtr	DC.L  ErrString3	;item descriptor	DC.W  0		;item value	DC.W  0		;item flag	DC.L  0		;item color table	AlertTemplate   DC.W  aY,aX,aY+aDY,aX+aDX	DC.W  1		;alert ID	DC.B  $80,$80,$80,$80	;stage bytes	DC.L  Item1Template	;button item	DC.L  Item2Template	;string item	DC.L  0		ENDR	*===============================================** Open up the NDA window (required NDA routine) **			** INPUT:	none		**			** OUTPUT:	window pointer (stack)	**			**===============================================*NDAOpen	PROC		IMPORT  ReadTOC	IMPORT  DoAlert	IMPORT  DoStop	IMPORT  SPRezero	IMPORT  SPOnLine	IMPORT  InitRnd	IMPORT  InitAB	IMPORT  AReadQ	IMPORT  AStatus	IMPORT  AStopTrack	IMPORT  SPInit2	IMPORT  NormalOrder	IMPORT  BCD2Int	IMPORT  SystemTask		phb	phk	plb		;for absolute addressing		lda  CDBusy	beq  cont0	brl  exit		;we are already running	lda  #true	sta  CDBusycont0	lda  CDTask		;was there a task?	beq  cont1	PushLong #SystemTask	_RemoveFromRunQ		;remove background taskcont1	lda  CDWinPtr	ora  CDWinPtr+2	beq  cont2	brl  exit		;ignore if already open		cont2	PushWord	_GetMasterSCB		;check for 320 mode	pla	and  #$0080	beq  mode320	lda  #w1X+dhW1	bra  openmode320	lda  #w1X+dhW1/2open	sta  WindowRect+6	;set window's width	PushLong #0		;open the DA's window	PushLong #CDWinRec	_NewWindow	pla	sta  OldWinPtr	pla	sta  OldWinPtr+2	ora  OldWinPtr	bne  mark	brl  exit		;some error occured!	mark	PushLong OldWinPtr	;mark as system window	_SetSysWindow*** added 23-Jan-91 DAL	pha	pha	_GetPort		;preserve port	pushlong OldWinPtr	_SetPort		;set port to our (still invisible) window	pha	pha		;space for Get640Colors result	ldx #$da04	jsl $e10000;	_Get640Colors		;get pointer to Black pattern (first pattern in table)	_SetBackPat	_SetPort		;restore port	PushLong OldWinPtr	_ShowWindow*** end of 23-Jan-91 DAL	lda  CDTask		;was there a task?	beq  setUp	stz  CDTask		;turn off flag;	lda  NullTask;	bne  setUP		;must be a new disc	jsr  AReadQ		;get the time	brl  exit		;but do not initsetUP	lda  CDError		;everything okay?	beq  okay		;yes	cmp  #errNotP16		;was it a GS/OS issue?	bne  bad		;no	shortm		;backdoor into DA !	lda  >keyModReg		;check open-apple-key	longm	and  #openAppleKey	beq  bad		;key not down	jsr  SPInit2		;initialze SmartPort data	sta  CDError	bcs  bad		;init error occured	bra  okaybad	lda  #mdNoDrive	sta  CDMode	bra  exitokay	jsr  SPOnLine		;disc on line?	bcc  disc		;yes	lda  #mdNoDisc	sta  CDMode	bra  exitdisc	jsr  ReadTOC		;set min & max track	jsr  NormalOrder	lda  CDDataDisc	bne  exit		;not an audio disc	jsr  AStatus		;check if CD playing	cmp  #audioPlay		;in play ?	beq  play		;yes	cmp  #audioPause	;in pause ?	beq  pause		;yes	jsr  DoStop	bra  exitpause	lda  #mdPause	bra  play2play	lda  #mdPlayplay2	sta  CDMode	jsr  AReadQ		;get current track	lda  CDCurTrk	sta  CDTrack		;set to current track	jsr  BCD2Int	dec  a		;zero relative index	sta  CurIndex		;set to current index	lda  CDTrack	jsr  AStopTrack		;set stop addressexit	lda  OldWinPtr+2	;pass back window ptr	sta  CDWinPtr+2	sta  7,s	lda  OldWinPtr	sta  CDWinPtr	sta  5,s	stz  CDBusy	plb	rtl			ENDP*===============================================** Close the NDA window (required NDA routine)	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*NDAClose	PROC	IMPORT  AStopTrack	IMPORT  SPOnLine	IMPORT  SystemTask	IMPORT  AStatus	phb	phk	plb		lda  CDBusy	bne  exit		;we are already running	lda  #true	sta  CDBusy		lda  CDWinPtr	ora  CDWinPtr+2	beq  exit		;ignore if inactive	PushLong CDWinPtr	_CloseWindow	stz  CDWinPtr+2	stz  CDWinPtr	lda  CDError	bne  exit		;no CD device found!	lda  CDDataDisc	bne  exit		;not an Audio Disc!	jsr  SPOnLine	bcs  exit		;no disc in drive!	jsr  AStatus	cmp  #audioPlay		;currently playing?	beq  task	cmp  #audioComplete	;completed play ?	beq  task	cmp  #audioVoid		;completed play ?	bne  exit	lda  AudioWait	bne  exittask	PushLong #SystemTask	;start task to keep DA alive	_AddToRunQ		;while it is closed.	lda  #true	sta  CDTask	exit	stz  CDBusy	plb	rtl	ENDP*===============================================** Init the NDA (required NDA routine)	**			** INPUT:	A-Reg (0=shutdown, 1=startup)	**			** OUTPUT:	none		**			**===============================================*NDAInit	PROCSystemType	equ  $E100BC		;system type byte (0 = P8, 1 = P16)	IMPORT  SPInit	IMPORT  SPOnLine	IMPORT  AStopTrack	IMPORT  SetRndL	IMPORT  SetABL	IMPORT  SystemTask	IMPORT  AStatus	IMPORT  NormalOrder	phb	phk	plb	tax	lda  >SystemType	;check which operating system	and  #$00FF	cmp  #1		;is it GS/OS ?	bne  exit		;no		cpx  #0	beq  gameOver		;shutdown call	jsr  SPInit		;initialze SmartPort data	sta  CDError	bcs  exit		;init error occured	PushLong #0	_GetTick	_SetRandSeed		;set up start seed	bra  exitgameOver		lda  CDTask		;was there a task?	beq  cont	PushLong #SystemTask	_RemoveFromRunQ		;remove background task	stz  CDTaskcont	stz  DidAlert	lda  CDError	bne  exit		;no CD device found	lda  #0	sta  CDPMode		;turn off Shuffle/AB	jsr  SetRndL		;tell DrawButton	lda  #abOff	sta  ABMode		;turn off AB	jsr  SetABL		;tell DrawButton		jsr  SPOnLine	bcs  exit		;no disc		jsr  AStatus	cmp  #audioPlay	bne  exit		;not playing		jsr  NormalOrder	ldy  MaxIndex	lda  TrackMap,y		;get the last audio track	and  #$00FF	beq  exit	jsr  AStopTrack		;set stop address to last trackexit	plb	rtl	ENDP*===============================================** Process NDA action (required NDA routine)	**			** INPUT:	A-Reg = type of action	**	X & Y-Reg = event pointer	**			** OUTPUT:	A-Reg (return flag)	**			**===============================================*NDAAction	PROCevtptr	equ  5	IMPORT  (DoActivate,DoUpdate,DoMouse,DoAbout,DoStop):CODE	IMPORT  (DoAction,ButtonDown,ButtonUp,NewTime,NewDisc):CODE	IMPORT  (NextTrack,AStatus,AReadQ,SPOnLine):CODE	IMPORT  DrawTrack	IMPORT  DrawMode	IMPORT  DoKey	IMPORT  TestAudioTrack		phb	phk	plb	phy	phx		;save event ptr	asl  A	pha		;action offset		PushLong #0	_GetPort	PullLong OldWinPtr	PushLong CDWinPtr	;set port to NDA window	_SetPort		plx		lda  CDBusy	bne  didAction		;CD-Remote is busy	lda  #$FFFF	sta  CDBusy		;we are busy	jsr  (Actions,x)	;process the action	stz  CDBusy		;we are not busydidAction		PushLong OldWinPtr	_SetPort		;restore port	pla	pla	plb	lda  #0		;return flag	rtlActions	DC.W  DoIgnore	DC.W  DoEvent	DC.W  DoRun	DC.W  DoCursor	DC.W  DoMenu	DC.W  DoUndo	DC.W  DoCut	DC.W  DoCopy	DC.W  DoPaste	DC.W  DoClearDoIgnore			;do nothing for these actionsDoCursorDoMenuDoUndoDoCutDoCopyDoPasteDoClear	rts	*-----------------------------------------------DoRun	lda  CDError	bne  endRun	jsr  SPOnLine		;disc in drive ?	bcs  endRun		;no	lda  CDDataDisc	bne  endRun		;not an audio disc	jsr  AStatus	cmp  #audioPlay		;in play state ?	beq  draw		;yes	cmp  #audioComplete	;completed play ?	beq  next		;yes	cmp  #audioVoid		;if void and we were waiting then it	bne  cont		;counts as "audioComplete"	lda  AudioWait	bne  nextcont	cmp  #audioPause	;in pause state ?	beq  endRun		;yes	lda  #mdStop	sta  CDMode	jsr  DrawMode		;force a STOP mode	bra  endRunnext	jsr  NextTrack		;get next selection to play	bra  endRundraw		jsr  AReadQ		;read Q Subcode	jsr  NewTime		;update time display	*	lda  CDCurTrk		;did we cross a track ?*	cmp  CDTrack*	beq  endRun		;same so exit*	jsr  DrawTrack		;update track displayendRun	rts*-----------------------------------------------DoEvent	phd	tsc	tcd	ldy  #10	lda  [evtptr],y		;Event.where.y	sta  Point	iny	iny	lda  [evtptr],y		;Event.where.x	sta  Point+2	iny	iny	lda  [evtptr],y		;Event.modifier	sta  Modifier	lda  [evtptr]		;Event.what	pld	cmp  #10	bcs  endEvent		;undefined event!	asl  A	tax	jsr  (Events,x)		;process eventendEvent	rtsEvents	DC.W  DoIgnore		;null	DC.W  DoMouse		;mouse down	DC.W  DoIgnore		;mouse up	DC.W  DoKey		;key down	DC.W  DoIgnore		;undefined	DC.W  DoIgnore		;auto key down	DC.W  DoUpdate		;update event	DC.W  DoIgnore		;undefined	DC.W  DoActivate	;activate	DC.W  DoIgnore		;switch	ENDP*===============================================**           Process An Activate Event	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*DoActivate	PROC	IMPORT  DoAlert		lda  Modifier		;check flag	and  #$0001	beq  exit		lda  DidAlert	bne  exit		;already told user	lda  CDError	beq  exit	jsr  DoAlert		;tell user about error	lda  #true	sta  DidAlertexit	rts	ENDP*===============================================**              Update The NDA Window	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*DoUpdate	PROC		IMPORT  NewTime	IMPORT  DrawTrack	IMPORT  DrawText	IMPORT  DrawWin	IMPORT  DrawMode		PushLong CDWinPtr	_BeginUpdate	jsr  DrawWin		;draw window's contents	lda  CDTrack	jsr  DrawTrack		;draw track display	jsr  NewTime		;draw time display	lda  CDMode	jsr  DrawMode		;draw mode display	lda  TimeMode	clc	adc  #11		;text offset	jsr  DrawText		;draw time mode	PushLong CDWinPtr	_EndUpdate	rts	ENDP	*===============================================**      Process a Key event in NDA Window	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*DoKey	PROC	; _FlashMenuBar		;tell user I eat keys	rts	ENDP	*===============================================**      Process a mouse event in NDA Window	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*DoMouse	PROCbRectPtr	equ  1	IMPORT  DoAction	IMPORT  ButtonDown	IMPORT  ButtonUp	IMPORT  DoAbout	IMPORT  DoAlert	IMPORT  DrawButton	IMPORT  IconRectPtr	IMPORT  RectTblPtr		PushLong RectTblPtr	;direct page pointer	tsc	phd	tcd		PushLong #Point	_GlobalToLocal	lda  #0@loop	pha		;find which button	asl  a	asl  a	inc  a	inc  a	tay	PushWord	PushLong #Point		;mouse position	lda [bRectPtr],y	;button coordinates	pha	dey	dey	lda [bRectPtr],y	pha	_PtInRect		;was mouse in button ?	pla	bne  found		;yes	pla	inc  A	cmp  #14		;valid data ?	bcs  next	bra  @loopfound	pla		;button number	sta  CDButton	bra  downnext		PushWord	PushLong #Point		;mouse position	PushLong IconRectPtr	;icon's coordinates	_PtInRect		;was mouse in icon ?	pla	bne  about		;yes	brl  exitabout		jsr  DoAbout		;open about window	brl  exitdown		lda  CDError	beq  okay	jsr  DoAlert		;tell user about error	brl  exitokay		jsr  ButtonDown		;process buttontrack1	PushWord #0		;wait until button up	PushWord #0	_StillDown		;is button still down ?	pla	bne  action		;yes	brl  upaction	jsr  DoAction	PushLong #Point		;track button	_GetMouse	PushWord #0	PushLong #Point	lda  CDButton	asl  a	asl  a	inc  a	inc  a	tay	lda [bRectPtr],y	;button coordinates	pha	dey	dey	lda [bRectPtr],y	pha	_PtInRect		;is mouse still in button ?	pla	bne  track1		;yes	lda  CDButton	jsr  DrawButton		;draw button uptrack2	PushWord #0	PushWord #0	_StillDown		;is button still down ?	pla	beq  up		;no	;	jsr  DoAction	PushLong #Point	_GetMouse	PushWord #0	PushLong #Point	lda  CDButton	asl  a	asl  a	inc  a	inc  a	tay	lda [bRectPtr],y	;button coordinates	pha	dey	dey	lda [bRectPtr],y	pha	_PtInRect		;is mouse back in button ?	pla	beq  track2		;no	lda  CDButton	ora  #$8000	jsr  DrawButton		;draw button down	brl  track1up	jsr  ButtonUpexit	pld		;clean-up	pla	pla	rts	ENDP	*===============================================**          Process a Button Down Event	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*ButtonDown	PROC	IMPORT  NewTime	IMPORT  InitRnd	IMPORT  RndOff	IMPORT  InitAB	IMPORT  SPOnLine	IMPORT  SPRezero	IMPORT  DrawMode	IMPORT  DrawText	IMPORT  DrawButton	IMPORT  DrawTrack	IMPORT  AStatus	IMPORT  AReadQ	IMPORT  AScanF	IMPORT  AScanR	IMPORT  AEject	IMPORT  APause	IMPORT  ASeekTrack	IMPORT  AStopTime	IMPORT  AStopTrack	IMPORT  APlayTrack	IMPORT  APlayTime	IMPORT  APlayModeTime	IMPORT  APlayMode	IMPORT  SetLAudL	IMPORT  SetRAudL	IMPORT  SetRepL	IMPORT  SetRndL	IMPORT  SetABL	IMPORT  NextTrack	IMPORT  NormalOrder	IMPORT  RandomOrder	IMPORT  DrawTime		lda  CDButton	cmp  #14		;valid data ?	bcs  exit	ora  #$8000	jsr  DrawButton	lda  CDButton	cmp  #bTime		;always allow time	beq  okay	cmp  #bRepeat		;always allow repeat	beq  okay	jsr  SPOnLine		;is a disc online ?	bcs  exit		;no, so do nothing	lda  CDButton	cmp  #bEject		;allow eject for Data Disc	beq  okay	lda  CDDataDisc	bne  exit		;not an audio disc (ie data)okay	lda  #actWait	sta  CDWait	lda  CDButton	asl  A	tax	jmp  (Funct,x)		;process buttonexit	rtsFunct	DC.W  DoStop		;Stop	DC.W  DoPlay		;Play	DC.W  DoPause		;Pause	DC.W  DoEject		;Eject	DC.W  DoSkipR		;Skip Reverse	DC.W  DoSkipF		;Skip Forward	DC.W  DoScanR		;Scan Reverse	DC.W  DoScanF		;Scan Forward	DC.W  DoAudioL		;Audio Left	DC.W  DoAudioR		;Audio Right	DC.W  DoRepeat		;Loop Repeat	DC.W  DoAB		;AB Repeat	DC.W  DoRandom		;Shuffle Play	DC.W  DoTime		;Change Time*------------------------------------------------	EXPORT DoStop	ENTRY  DoStopDoStop	stz  AudioWait		;no longer waiting for completion	lda  #mdStop	sta  CDMode	jsr  InitAB		;reset AB stuff	ldy  #0	sty  CurIndex	lda  TrackMap,y	and  #$00FF	sta  CDTrack		stz  CDMin	stz  CDSec	stz  CDFrame	stz  CDIndex		;these are zero for future displays	lda  #0	jsr  AStopTrack		;force an audio stop	lda  CDWinPtr	ora  CDWinPtr+2	beq  stEnd		;don't draw	ldx  #0	lda  #0	jsr  DrawTime		;draw 00:00	lda  CDTrack	jsr  DrawTrack		;update track display	lda  #mdStop	jsr  DrawMode		;update displaystEnd	rts*------------------------------------------------DoPlay	lda  CDPMode	cmp  #mABRept	beq  dpEnd		;ignore play during AB repeat	jsr  AStatus	cmp  #audioPlay		;in play state ?	beq  dpEnd		;yes	cmp  #audioPause	;in pause state ?	bne  dpPlay	lda  CDMode	cmp  #mdPause	beq  dpReleasedpPlay	lda  CDTrack	jsr  AStopTrack		;set stop address	bcs  dpEnd		;error	lda  CDTrack	jsr  APlayTrack		;start playing	bcs  dpEnd		;error	lda  #true	sta  AudioWait	lda  #mdPlay	sta  CDMode	jsr  DrawMode		;update display	bra  dpEnd	DoPause	jsr  AStatus	cmp  #audioComplete	;completed play ?	bne  dpCont	jsr  NextTrack		;get next selection to play	bra  dpEnddpCont	cmp  #audioPlay		;in play state ?	beq  dpPause		;yes		cmp  #audioPause	;in pause state ?	bne  dpEnd		;no	lda  CDMode	cmp  #mdPause	beq  dpRelease	bra  dpEnd	dpPause	lda  #mdPause	sta  CDMode	jsr  DrawMode		;update display	lda  #1		; fliped polarity DJB 12/2/88 	bra  dpDoItdpRelease	lda  #mdPlay	sta  CDMode	jsr  DrawMode		;update display	lda  #0dpDoIt	jsr  APause		;set/release pausedpEnd	rts*------------------------------------------------DoEject	stz  AudioWait		;no longer waiting for completion	jsr  AEject	rts*------------------------------------------------	ENTRY  DoSkipRDoSkipR	jsr  InitAB		;abort any AB stuff	ldy  CurIndex	bne  dsDec	ldy  MaxIndex	bra  dsContdsDec	dey	bra  dsCont	ENTRY  DoSkipFDoSkipF	jsr  InitAB		;abort any AB stuff	ldy  CurIndex	cpy  MaxIndex	bcc  dsInc	ldy  #0	bra  dsContdsInc	inydsCont	sty  CurIndex	lda  TrackMap,y	and  #$00FF	sta  CDTrack	jsr  DrawTrack		;update track displaydsEnd	rts*------------------------------------------------DoScanF	lda  ABMode	cmp  #abOn		;don't scan during AB-repeat	beq  dsEnd	jsr  AStatus	cmp  #audioPlay		;in play state ?	bne  dsEnd	lda  #1	sta  CDScan	lda  CDAFrame	ldx  CDASec	ldy  CDAMin	jsr  AScanF		;start forward scan	rtsDoScanR	lda  ABMode	cmp  #abOn		;don't scan during AB-repeat	beq  dsEnd	jsr  AStatus	cmp  #audioPlay		;in play state ?	bne  dsEnd	lda  #1	sta  CDScan	lda  CDAFrame	ldx  CDASec	ldy  CDAMin	jsr  AScanR		;start reverse scan	rts*------------------------------------------------DoRepeat	lda  CDRepeat	eor  #$01		;flip flag	sta  CDRepeat	jsr  SetRepL		;tell DrawButton	rts*-----------------------------------------------DoAudioL	lda  CDAudio	eor  #$8000		;flip it	sta  CDAudio	jsr  SetLAudL		;tell DrawButton		lda  CDAudio	bne  daFind	lda  #$4000		;force right back on	sta  CDAudio	jsr  SetRAudL		;tell DrawButton	lda  #bAudioR	jsr  DrawButton		;redraw Button		bra  daFindDoAudioR	lda  CDAudio	eor  #$4000		;flip it	sta  CDAudio	jsr  SetRAudL		;tell DrawButton		lda  CDAudio	bne  daFind	lda  #$8000		;force left back on	sta  CDAudio	jsr  SetLAudL		;tell DrawButton	lda  #bAudioL	jsr  DrawButton		;redraw Button		dafind	lda  CDAudio	cmp  #$c000		;stereo ?	bne  daCont1	ldx  #$09	bra  daSetdaCont1	cmp  #$8000		;left only ?	bne  daCont2	ldx  #$0A	bra  daSetdaCont2	cmp  #$4000		;right only ?	bne  daEnd	ldx  #$05daSet	lda  CDPMode	cmp  #mABRept	beq  daAB	lda  CDMode		; CAF 11/01/90	cmp  #mdPlay		; are we playing something ?	bne  daEnd		; no ->		txa	jsr  APlayMode	lda  #true	sta  AudioWait	bra  daEnddaAB	txa	jsr  APlayModeTimedaEnd	rts*------------------------------------------------DoRandom	lda  CDPMode	cmp  #mShuffle	bne  drSet	jsr  NormalOrder	;set TrackMap	ldy  #0@invMap	lda  TrackMap,y		;find index from track	and  #$00FF	cmp  CDTrack	beq  drTrk	iny	bra  @invMapdrTrk	sty  CurIndex	lda  #0	bra  drEnddrSet	jsr  InitAB		;turn off AB	jsr  RandomOrder	;set TrackMap	ldy  #0	sty  CurIndex	lda  TrackMap,y		;get "first" track	and  #$00FF	sta  CDTrack	jsr  DrawTrack	lda  CDTrack	jsr  AStopTrack	lda  CDMode	cmp  #mdStop	beq  drStop	lda  CDTrack	jsr  APlayTrack		;and play it	lda  #true	sta  AudioWait	lda  #mdPlay	sta  CDMode	jsr  DrawMode		;update display	lda  #mShuffle	bra  drEnddrStop	lda  CDTrack	jsr  ASeekTrack		;and seek there	lda  #mShuffledrEnd	sta  CDPMode	jsr  SetRndL		;tell DrawButton	rts*------------------------------------------------DoTime	lda  TimeMode	eor  #$0001		;flip it	sta  TimeMode	clc	adc  #11		;text offset	jsr  DrawText		;update mode display	jsr  NewTime		;update time display	rts*------------------------------------------------DoAB	lda  ABMode	cmp  #abOn	bne  abCont2	lda  CDTrack	jsr  AStopTrack		;reset stop address	lda  #0		;turn off AB mode	sta  CDPMode	jsr  AStatus		;check for play	cmp  #audioComplete	;end of play?	beq  abPlay	cmp  #audioVoid		;end of play?	bne  abCont1abPlay	lda  CDFrameB	ldx  CDSecB	ldy  CDMinB	jsr  APlayTime		;start playing at B	lda  #true	sta  AudioWaitabCont1	lda  #abOff	brl  abDrawabCont2	lda  CDMode	cmp  #mdStop		;in stop mode ?	bne  abCont3		;no	brl  abEndabCont3	lda  ABMode	cmp  #abSetA	beq  setA	cmp  #abSetB	beq  setB	jsr  RndOff		;turn off shuffle !	lda  #abSetA	brl  abDrawsetA	jsr  AReadQ		;read current time	lda  CDAMin		;A <-- current	sta  CDMinA	lda  CDASec	sta  CDSecA	lda  CDAFrame	sta  CDFrameA	lda  #abSetB	brl  abDrawsetB	jsr  AReadQ		;read current time	lda  CDMinA	cmp  CDAMin		;A < B ?	bcc  abOK		;yes	bne  abSwitch		;no	lda  CDSecA	cmp  CDASec	bcc  abOK		;yes	bne  abSwitch		;no	lda  CDFrameA	cmp  CDAFrame	bcc  abOK		;yes	bne  abSwitch		;no	lda  #0		;A = B, so reset!	sta  CDPMode	lda  #abOff	bra  abDrawabSwitch	lda  CDMinA		;B <-- A	sta  CDMinB	lda  CDSecA	sta  CDSecB	lda  CDFrameA	sta  CDFrameB	lda  CDAMin		;A <-- current	sta  CDMinA	lda  CDASec	sta  CDSecA	lda  CDAFrame	sta  CDFrameA	bra  abGoabOK	lda  CDAMin		;B <-- current	sta  CDMinB	lda  CDASec	sta  CDSecB	lda  CDAFrame	sta  CDFrameBabGo	ldy  CDMinB		;phrase ending time	ldx  CDSecB	lda  CDFrameB	jsr  AStopTime		;set phrase stop address	lda  CDFrameA	ldx  CDSecA	ldy  CDMinA	jsr  APlayTime		;start playing phrase	lda  #true	sta  AudioWait	lda  #mdPlay	sta  CDMode	jsr  DrawMode		;update display (in case of pause)	lda  #mABRept	sta  CDPMode	lda  #abOnabDraw	sta  ABMode	jsr  SetABL		;tell DrawButtonabEnd	rts	ENDP	*===============================================**          Process a Button Up Event	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*ButtonUp	PROC	IMPORT  BCD2Int	IMPORT  NewTime	IMPORT  NextTrack	IMPORT  DrawButton	IMPORT  DrawMode	IMPORT  APause	IMPORT  AStopTrack	IMPORT  APlayTrack	IMPORT  SPOnLine	IMPORT  DrawTime		lda  CDButton	jsr  DrawButton		;redraw button up	jsr  SPOnLine		;disc online?	bcs  exit		;no	lda  CDDataDisc	bne  exit		;not an audio disc	lda  CDScan	beq  cont	lda  ABMode	cmp  #abOn		;don't scan during AB-repeat	beq  exit		lda  #0		;release pause (changed from 1 DJB 12/2/88)	jsr  APause	lda  #0		;clear scan flag	sta  CDScan	bra  exitcont	lda  CDButton	cmp  #bSkipR	beq  skip	cmp  #bSkipF	bne  exitskip	lda  CDMode	cmp  #mdStop		;in stop mode ?	beq  pretend		;yesplay	lda  CDTrack	jsr  AStopTrack	lda  CDTrack	jsr  APlayTrack		;play new track	lda  #true	sta  AudioWait	lda  #mdPlay	sta  CDMode	jsr  DrawMode		;update displayexit	rtspretend	stz  CDMin	stz  CDSec	stz  CDFrame	stz  CDIndex		;these are zero for future displays	ldx  #0	lda  #0	jsr  DrawTime		;draw 00:00	bra  exit	ENDP	*===============================================**       Do Action While Button Is Down	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*DoAction	PROC	IMPORT  NewTime	IMPORT  DoSkipR	IMPORT  DoSkipF	IMPORT  AReadQ	IMPORT  DrawTrack	IMPORT  DrawTime	IMPORT  AStopTrack	IMPORT  SPOnLine	IMPORT  AScanF	IMPORT  AScanTrack		phb	phk	plb	jsr  SPOnLine		;disc online ?	bcc  cont1	brl  exit		;nocont1	lda  CDDataDisc	beq  cont2	brl  exit		;not an audio disccont2	lda  CDButton	cmp  #bScanR		;scan buttons ?	beq  scan	cmp  #bScanF	beq  scan	cmp  #bSkipR		;skip buttons ?	bne  cont4	dec  CDWait		;don't do every time	bne  exit	jsr  DoSkipR	lda  #actWait	sta  CDWait	bra  exitcont4	cmp  #bSkipF	bne  exit	dec  CDWait		;don't do every time	bne  exit	jsr  DoSkipF	lda  #actWait	sta  CDWait	bra  exitscan	lda  ABMode	cmp  #abOn		;don't scan during AB-repeat	beq  exit	lda  CDMode	cmp  #mdPlay		;only scanning from play	bne  exit	jsr  AReadQ	lda  CDMin		;start of disc?	ora  CDSec	ora  CDAMin	beq  restart		;yes	lda  CDCurTrk		;end of disc?	beq  restart		;yes	cmp  CDTrack		;did we cross a track ?	beq  cont6		;no (same), so exitrestart	ldx  #0	lda  #0	jsr  DrawTime		;draw 00:00	lda  CDButton	cmp  #bScanF	beq  forwardreverse	jsr  DoSkipR	lda  CDTrack	jsr  AStopTrack	ldx  #1		;X <-- reverse	bra  cont5forward	jsr  DoSkipF	lda  CDTrack	jsr  AStopTrack	ldx  #0		;X <-- forwardcont5	lda  CDTrack	jsr  AScanTrack		;X-Reg has direction	bra  exitcont6	jsr  NewTime		;update time displayexit	plb	rts			ENDP	*===============================================**       Calculate New Time for Display	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*	EXPORT  NewTime  NewTime	PROC	IMPORT  BCD2Int	IMPORT  DrawTime		lda  CDIndex		;in between tracks?	beq  limbo		;yes	lda  TimeMode	beq  elapsed	lda  CDTrack	beq  elapsed		;just draw 00:00	jsr  BCD2Int		;get integer value	dec  A	asl  A	tay		;zero relative offset	sed		;for BCD math	lda  CDATime,y	and  #$007F	sec	sbc  CDASec	and  #$00FF	php		;save carry flag	pha		;save seconds	lda  CDATime,y	xba	and  #$007F	sbc  CDAMin	and  #$00FF	tax		;x has minutes	pla	plp		;was there a borrow?	bcs  okay		;no	sec	sbc  #$40		;adjust secondsokay	cld		;back to normal	jsr  DrawTime	bra  exitelapsed	ldx  CDMin	lda  CDSec	jsr  DrawTime	bra  exitlimbo	ldx  #0	lda  #0	jsr  DrawTime		;draw 00:00exit	rts	ENDP	*===============================================**       	Test Audio Track	** - make sure track is an audio track	** - set mode if it is not		**			** INPUT:	track (A-Reg) in BCD	**			** OUTPUT:	track (A-Reg) in BCD	**	carryFlag (1 = data, 0 = audio)	**			**===============================================*	EXPORT  TestAudioTrackTestAudioTrack	PROC	IMPORT  BCD2Int	IMPORT  DrawMode	pha	jsr  BCD2Int	dec  a	asl  a	tay	lda  CDATime,y		;high bit set if data track	bpl  audio	sec	bra  exitaudio	clcexit	pla	rts		ENDP	*===============================================**       Read a CD Disc's Table of Contents	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*ReadTOC	PROC	IMPORT  BCD2Int	IMPORT  ATOCTime	IMPORT  ATOCTrack		jsr  ATOCTrack		;get min & max tracks	stx  CDMinTrk	sty  CDMaxTrk	tya  		jsr  BCD2Int		;get integer value	sta  CDTrkCnt	jsr  ATOCTime		;get absolute time table	rts		ENDP	*===============================================**           Process a New-Disc Event	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*	EXPORT  NewDisc NewDisc	PROC	IMPORT  NormalOrder	IMPORT  ReadTOC	IMPORT  DoStop	IMPORT  DrawMode	jsr  ReadTOC	jsr  NormalOrder	lda  CDDataDisc	bne  notAudio	jsr  DoStop	bra  exitnotAudio	lda  #mdNoAudio	sta  CDMode	lda  CDWinPtr	ora  CDWinPtr+2	beq  exit		;don't draw	lda  #mdNoAudio	jsr  DrawModeexit	rts	ENDP	*===============================================**           Process a No-Disc Event	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*	EXPORT  NoDisc NoDisc	PROC	IMPORT  DrawTime	IMPORT  DrawMode	IMPORT  DrawTrack	IMPORT  InitAB	IMPORT  RndOff		stz  CDTrack	stz  CDCurTrk	stz  CDMin	stz  CDSec	stz  CDFrame	stz  CDMinTrk	stz  CDMaxTrk	stz  CDTrkCnt	stz  CurIndex	stz  CDDataDisc		lda  #mdNoDisc	sta  CDMode	jsr  InitAB		;turn off AB	jsr  RndOff		;turn off shuffle	lda  CDWinPtr	ora  CDWinPtr+2	beq  exit		;don't draw	lda  #mdNoDisc	jsr  DrawMode		;display No Disc	lda  #0	ldx  #0	jsr  DrawTime		;display 00:00	lda  #0	jsr  DrawTrack		;display 00exit		rts	ENDP	*===============================================**          Handle Next Play Selection	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*NextTrack	PROC	IMPORT  DrawTrack	IMPORT  AStopTrack	IMPORT  APlayTrack	IMPORT  APlayTime	IMPORT  DoStop	IMPORT  RandomOrder	IMPORT  InitAB		lda  CDPMode	cmp  #mABRept	beq  repeatABdefault	ldy  CurIndex		;increment by default	cpy  MaxIndex	bcc  bump	lda  CDRepeat	beq  reset		;all done	lda  CDPMode	cmp  #mShuffle	bne  cont	jsr  RandomOrder	;reshuffle the ordercont	ldy  #0	bra  playbump	inyplay	sty  CurIndex	lda  TrackMap,y	and  #$00FF	sta  CDTrack	jsr  AStopTrack	lda  CDTrack	jsr  APlayTrack		;play new track	lda  #true	sta  AudioWait	lda  CDWinPtr	ora  CDWinPtr+2	beq  exit		;don't draw		lda  CDTrack	jsr  DrawTrack		;update track display	jsr  InitAB		;force A?,B? off across tracks	bra  exitrepeatAB	lda  CDFrameA	ldx  CDSecA	ldy  CDMinA	jsr  APlayTime	lda  #true	sta  AudioWait	bra  exitreset	jsr  DoStop		;reset to first trackexit	rts	ENDP	*===============================================**	Random Track		** - generates a random sequence of n unique 	**   numbers.			** - after n numbers, it starts over again	** - n is the total number of tracks on the	**   current CD Disc.		**			** INPUT:	A-Reg (0: restart, ­0: continue)**			** OUTPUT:	RandomTrack (A-Reg) {1,2,3,É,n}	**	(a 0 means end of sequence)	**			**===============================================*RandomTrack	PROC	cmp  #0	bne  continue	jsr  doInit		;restart sequencecontinue	lda  Count	dec  a	beq  okay		;last one!	bmi  doInit		;reset for next phase	PushWord #0	_Random		;get a random integer	pla	and  #$007F		;normalize to 0..127@modLoop		cmp  Count		;small enough ?	bcc  okay		;yes	sec 	sbc  Count		;else, do MOD count	bra  @modLoopokay	tax	shortm	lda  RndMap,x		;get track number	pha	ldy  Count	dey		;zero relative	lda  RndMap,y		;get "left-over" track	sta  RndMap,x		;fill in "hole"	pla	longm	and  #$00ff	dec  Count		;reduce rangeexit	rts		ENTRY  doInitdoInit	shortm	lda  #$99		;max track (BCD)	ldx  #98	sta  RndMap,x	dex	sedbcdLoop	lda  RndMap+1,x		;init table with BCD tracks	sec	sbc  #1	sta  RndMap,x	dex	bpl  bcdLoop	cld	longm	lda  CDTrkCnt	sta  Count	lda  #0		;signals end-of-list	bra  exitCount	DC.W  0RndMap	DS.B  100	ENDP	*===============================================**	Normal Order		** - fill TrackMap with sequential tracks (BCD)	** - data tracks are not put in table	** - set MaxIndex		**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*NormalOrder	PROC	IMPORT  TestAudioTrack	IMPORT  DrawMode	stz  CDDataDisc	ldx  #0	phx	lda  CDMinTrk		;starting track (BCD)test		cmp  CDMaxTrk		;out of tracks?	bcc  cont	beq  cont	bra  done		;yescont	jsr  TestAudioTrack	;an Audio track?	bcc  okay		;yes	sed	clc	adc  #1		;increment in BCD	cld	bra  testokay	plx	shortm	sta  TrackMap,x	longm	sed	clc	adc  #1		;increment in BCD	cld		inx	phx	cpx  CDTrkCnt		;last track?	bcc  test		;nodone	plx	beq  bad	dex	stx  MaxIndex	bra  exitbad	lda  #true	sta  CDDataDisc	lda  #mdNoAudio	sta  CDModeexit	rts	ENDP	*===============================================**	Random Order		** - fill TrackMap with random tracks (BCD)	** - data tracks are not put in table	** - set MaxIndex		**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*RandomOrder	PROC	IMPORT  RandomTrack	IMPORT  TestAudioTrack	ldx  #0	phxtest	lda  1,s		;A <-- X	jsr  RandomTrack	;A <-- random track (BCD)	cmp  #$0000	beq  done		;out of tracks!	jsr  TestAudioTrack	;an Audio track?	bcc  okay		;yes	bra  testokay	plx	shortm	sta  TrackMap,x	longm	inx	phx	cpx  CDTrkCnt		;last track?	bcc  test		;nodone	plx	dex	stx  MaxIndex	rts	ENDP	*===============================================**           Convert BCD to Integer Value	**			** INPUT:	BCDValue (A-Reg)	**			** OUTPUT:	IntValue (A-Reg)	**			**===============================================*BCD2Int	PROC	pha		;save low nibble	lsr  A	lsr  A	lsr  A	lsr  A		;tens digit	asl  A		;2x	pha	asl  A	asl  A		;8x	clc	adc  1,s		;multiply by 10 (2x + 8x)	sta  1,s	lda  3,s		;ones digit	and  #$000F	clc	adc  1,s		;integer result	plx		;cleanup stack	plx	rts	ENDP	*===============================================**           Turn Off Shuffle mode	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*RndOff	PROC	IMPORT  DrawButton	IMPORT  SetRndL	IMPORT  NormalOrder	lda  CDPMode	cmp  #mShuffle	bne  exit		;was not on	lda  #0	sta  CDPMode		;turn off Shuffle	jsr  SetRndL		;tell DrawButton	jsr  NormalOrder	ldy  #0@invMap	lda  TrackMap,y		;find index from track	and  #$00FF	cmp  CDTrack	beq  found	iny	bra  @invMapfound	sty  CurIndex	lda  CDWinPtr	ora  CDWinPtr+2	beq  exit	lda  #bShuffle	jsr  DrawButton		;redraw buttonexit	rts	ENDP	*===============================================**         Initialize AB-Repeat Variables	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*InitAB	PROC	IMPORT  DrawButton	IMPORT  SetABL	IMPORT  AStopTrack	lda  ABMode	cmp  #abOff	beq  exit		;already set up	lda  #abOff	sta  ABMode		;reset AB status	lda  #0	sta  CDPMode		;turn off AB mode	jsr  SetABL		;tell DrawButton	lda  CDWinPtr	ora  CDWinPtr+2	beq  exit	lda  #bAB	jsr  DrawButton		;redraw buttonexit	rts	ENDP	*===============================================**             Open NDA About Box	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*DoAbout	PROC	IMPORT  DrawAbout	IMPORT  DrawDisc	IMPORT  DrawIcon		lda  #$8000	jsr  DrawIcon		;invert icon	PushLong #0		;save current port	_GetPort	PushWord	_GetMasterSCB		;check for 320 mode	pla	and  #$0080	beq  mode320	lda  #w2X	ldx  #w2X+dhW2	bra  openmode320	lda  #w2X_320	ldx  #w2X_320+dhW2_320open	sta  WindowRect2+2	;window's hort. position	stx  WindowRect2+6*** 23-Jan-91 DAL -- call WindowGlobal(1) so the NDA window doesn't have*** to unhilite when our About window comes up.	pha	pea $0001	_WindowGlobal	pla***	PushLong #0		;open About window	PushLong #WinRec2	_NewWindow*** 23-Jan-91 DAL -- call WindowGlobal again to restore normal hiliting	pha	pea $fffe	_WindowGlobal	pla***	lda  1,s	sta  WinPtr2		;should do error check!...	lda  3,s	sta  WinPtr2+2	_SetPort	jsr  DrawAbout	wait	pha		;wait for key/mouse event	PushWord #$000E		;event mask: mouse or key	PushLong #temp	_GetOSEvent	pla	beq  wait	lda  temp	cmp  #$0001		;mouse down ?	beq  close	cmp  #$0003		;key down ?	bne  waitclose	PushLong WinPtr2	_CloseWindow	_SetPort		;back to DA window's port	lda  #0	jsr  DrawIcon		;un-invert icon	rtstemp	DS.B  16		;place to dump event record	ENDP	*===============================================**             Alert User of DA Error	**			** INPUT:	errorCode (A-Reg)	**	strPtrLow (X-Reg) SP error only	**	strPtrHi (Y-Reg) sp error only	**			** OUTPUT:	none		**			**===============================================*	EXPORT  DoAlertDoAlert	PROC		cmp  #errNoRuby	beq  noRUBY	cmp  #errNoRevC	beq  noRevC	cmp  #errNoSCSI	beq  noSCSI	cmp  #errNotP16	beq  notP16	cmp  #1		;smartport error box	bne  exit		;unknown error code	txa	tyx	bra  alertnoRUBY	lda  #ErrString1	ldx  #^ErrString1	bra  alertnoRevC	lda  #ErrString2	ldx  #^ErrString2	bra  alertnoSCSI	lda  #ErrString3	ldx  #^ErrString3	bra  alertnotP16	lda  #ErrString4	ldx  #^ErrString4alert		sta  ErrStrPtr	stx  ErrStrPtr+2	PushWord	_GetMasterSCB		;check for 320 mode	pla	and  #$0080	beq  mode320	lda  #aX	ldx  #aX+aDX	ldy  #aStrX	bra  alert2mode320	lda  #aX_320	ldx  #aX_320+aDX_320	ldy  #aStrX_320alert2	sta  AlertTemplate+2	;hort. offsets	stx  AlertTemplate+6	sty  ErrStrRect+2	PushWord #0		;space for ID	PushLong #AlertTemplate	PushLong #0	_StopAlert	plaexit	rts	ENDP	*===============================================**	Add System Task		** - Keeps the DA running in the background. 	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*SystemTask	PROC	IMPORT  SPOnLine	IMPORT  AStatus	IMPORT  NextTracktaskTicks	equ  90		; 60 ticks = 1 second*-----------------------------------------------TaskHeader	DC.L  0		; task pointerTaskCount	DC.W  taskTicks		; tick count	DC.W  $A55A		; signature	DC.L  0		; reserved*-----------------------------------------------	phb	phk	plb	jsr  AStatus	cmp  #audioError	bne  okay	jsr  SPOnLine		; disc in drive ?	bcc  done	bra  exit		; no disc, so stop future tasksokay	cmp  #audioComplete	; completed play ?	beq  next		; yes	cmp  #audioVoid		; if void and we were waiting then it	bne  done		; counts as "audioComplete"	lda  AudioWait	beq  donenext	jsr  NextTrack		; get next selection to play		done	lda  #taskTicks	sta  TaskCount		; reset counterexit	plb		; restore environment	rtl	ENDP	*===============================================*	END