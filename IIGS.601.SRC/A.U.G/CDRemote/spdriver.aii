*************************************************************** NOTE--This file is no longer used.  See the makefile.  --DAL*************************************************************** * * * * * * * * * * * * * * * * * * * * * * * ** File:  SPDRIVER.aii		**			** SmartPort Driver to AppleCD SCª (RUBY) drive	** Module for CD-Remote (A New Desk Accessory)	** 			** Date:	8/27/87 (created)	** Author:	Don Brady		**			** Build File:	CDRemote.make		**			** Copyright © APPLE Computer, Inc. 1987,1988	**			** Modification History:		** Version 1.0			** 01/18/88  Released A1 today		** 02/11/88  Released A2 today		** 02/17/88  Converted to MAX (from APW) today	** 03/21/88  Release A4 today		** 04/01/88  Release B1 today		** 04/13/88  Release B2 (informal) today	** 04/15/88  Release B3 today		** 04/17/88  Release B4 (informal) today	** 04/18/88  Final Release today		** * * * * * * * * * * * * * * * * * * * * * * * * ;...............................................................;;        Set Memory & A register to 8 bits;...............................................................	MACRO	shortm	sep  #%00100000	longa off	MEND;...............................................................;;        Set Memory & A register to 16 bits;...............................................................	MACRO	longm	rep  #%00100000	longa on	MEND;...............................................................;;        Set Memory & registers to 16 bits;...............................................................	MACRO	SetLong	rep   #%00110000	longa on	longi on	MEND;...............................................................;;        Set Memory & registers to 8 bits;...............................................................	MACRO	SetShort	sep   #%00110000	longa off	longi off	MEND	;-----------------------------------------------;;   Imported data address (from CDRemote.aii);;-----------------------------------------------	IMPORT  CDAFrame			IMPORT  CDAMin	IMPORT  CDASec	IMPORT  CDATime	IMPORT  CDCurTrk	IMPORT  CDData	IMPORT  CDFrame	IMPORT  CDMaxTrk	IMPORT  CDMin	IMPORT  CDMinTrk	IMPORT  CDSec	IMPORT  CDTrkCnt		include  'all.macros'	*===============================================**            Data for SmartPort Driver	**===============================================*SPData	PROC	ENTRY  SPBuffer	ENTRY  SPCode	ENTRY  SPCount	ENTRY  AudioBuffer	ENTRY  InitError	ENTRY  SPList	ENTRY  Units	ENTRY  Slot	ENTRY  IsOnLine	ENTRY  SPUnit	ENTRY  Params	ENTRY  SPBuffPtr	ENTRY  PlayMode	ENTRY  AControl	ENTRY  ATrack	ENTRY  AIndex	ENTRY  AMin	ENTRY  ASec	ENTRY  AFrame	ENTRY  SPErrStr	ENTRY  EndStr	ENTRY  SenseKey	ENTRY  SenseCode	ENTRY  ErrorCode	ENTRY  ControlCode	ENTRY  EntryAddr	IsOnLine	DC.W  0		;boolean flagInitError	DC.W  0		;0 = okay, else errorSlot	DC.W  0		;SCSI card slotUnits	DC.W  0		;how many unitsParams	DC.W  0		;parameter block for VersionSPBuffer	DS.B  32		;SP I/O bufferAudioBuffer	DS.B  4*99		;Audio I/O bufferSPList			;SP parameter listSPCount	DS.B  1		;parameter countSPUnit	DS.B  1		;unit numberSPBuffPtr	DC.L  SPBuffer		;buffer ptrSPCode	DS.B  10		;other stuffPlayMode	dc.w  9		;default = stereoAControl	dc.w  0ATrack	dc.w  0AIndex	dc.w  0AMin	dc.w  0		;not used ????ASec	dc.w  0AFrame	dc.w  0	STRING  ASISSPErrStr	DC.B  EndStr-SPErrStr-1	DC.B  'SmartPort error - $'ErrorCode	DC.B  'XX'	DC.B  $0D	DC.B  'Control Code - $'ControlCode	DC.B  'XX'	DC.B  $0D	DC.B  'Sense key/code - $'SenseKey	DC.B  'XX, $'SenseCode	DC.B  'XX'	DC.B  $0D	DC.B  'SP Dispatch - $'EntryAddr	DC.B  'XXXXXX'EndStr	ENDP	*===============================================**	Initialize SmartPort	** - make sure Prodos is ver. 1.0 (ie not 2.0)	** - look for SCSI Card Rev C		** - look for a AppleCD SC (RUBY) drive	** - set dispatch address		** - check if device is online		**			** INPUT:	none		**			** OUTPUT:	ErrorCode (A-Reg)	**	$0000 = okay		**	$8000 = no RUBY drive	**	$4000 = no SCSI Rev C	**	$2000 = no SCSI card	**	$1000 = not ProDos16 1.0	**===============================================*	EXPORT  SPInit	EXPORT  SPInit2SPInit	PROC	IMPORT  GetSCSI	IMPORT  GetCDROM	IMPORT  SPCall	;	_GET_VERSION Params;	lda  Params;	and  #$7F00;	cmp  #$0100		;is it ProDos 16 1.0 ?;	beq  SPInit2;	lda  #$1000;	sta  InitError;	bra  exit		ENTRY  SPInit2		;for the "backdoor"SPInit2		lda  #$2000		;no SCSI card yet	sta  InitError	ldx  #7		;start in slot 7loop	jsr  GetSCSI	bcc  next	jsr  GetCDROM	bcs  foundnext	dex	bne  loop		lda  InitError	bne  exit	lda  #$8000		;no RUBY drive	bra  exitfound	stx  Slot		;SCSI slot	lda  #$00		;Status Code	sta  SPCode	lda  #^SPBuffer	sta  SPBuffPtr+2	lda  #SPBuffer	sta  SPBuffPtr	lda  #$40		;command	ldx  #$03		;param count	jsr  SPCall		;do status call	cmp  #0	bne  offline	lda  SPBuffer	and  #$0010		;look at online bit	bne  onlineoffline	stz  IsOnLine	bra  doneonline	lda  #1	sta  IsOnLinedone	lda  #$0000		;no errorexit	cmp  #1	rts	ENDP	*===============================================**	Get SCSI Card		** - look for a SCSI card in current slot	**			** INPUT:	none		**			** OUTPUT:	found (carry bit) 1=yes, 0=no	**			**===============================================*GetSCSI	PROC	IMPORT  SPEntry	phx	txa	and  #$000F	ora  #$C0	xba	tax	lda  $E00001,x		;check SP signatures	and  #$00FF	cmp  #$20	bne  noSCSI	lda  $E00003,x	and  #$00FF	cmp  #$00	bne  noSCSI	lda  $E00005,x	and  #$00FF	cmp  #$03	bne  noSCSI	lda  $E00007,x	and  #$00FF	cmp  #$00	bne  noSCSI	lda  $E000FB,x		;check for SCSI card ID	and  #$00FF	cmp  #$82	bne  noSCSI	phx		;slot	lda  $E000FF,x		;get SP offset value	and  #$00FF	clc	adc  1,s		;slot ($Cn00)	clc	adc  #$0003		;sp offset	sta  >SPEntry+1		;set SP dispatch addr	pla		stz  InitError		;found a scsi card	secexit	plx	rtsnoSCSI	clc	bra  exit	ENDP	*===============================================**	Get CD-ROM Device	** - look for a Ruby drive in current slot	**			** INPUT:	none		**			** OUTPUT:	found (carry bit) 1=yes, 0=no	**			**===============================================*GetCDROM	PROC	IMPORT  SPUnits	IMPORT  ChkType		phx	jsr  SPUnits		;how many devices ?	sta  Units	beq  noRUBY		;none	lda  #1@loop			;look for RUBY	shortm	sta  SPUnit		;set SP unit number	longm	jsr  ChkType		;is it a RUBY ?	bcs  found	cmp  Units	bcs  noRuby	inc  a	bra  @loopfound	secexit		plx	rtsnoRUBY	clc	bra  exit	ENDP	*===============================================**	Check Device Type	** - check for a Ruby drive		**			** INPUT:	none		**			** OUTPUT:	isRUBY (carry bit) 1=yes, 0=no	**			**===============================================*ChkType	PROC	IMPORT  SPCall	pha		;preserve A-reg	ldx  bFlag	bne  doIt	inc  bFlag	bra  exitdoIt	lda  #$03		;get DIB	sta  SPCode		;status code	lda  #^SPBuffer	sta  SPBuffPtr+2	lda  #SPBuffer	sta  SPBuffPtr	lda  #$40		;command code	ldx  #$03		;number of parameters	jsr  SPCall	cmp  #0		;check for SP error	bne  notCD		lda  SPBuffer+24	;check SCSI version	cmp  #$0200		;is it Rev C ?	bne  notRevC		lda  SPBuffer		;check status byte	and  #$EF	cmp  #$A4	bne  notCD		lda  SPBuffer+22	;device type & subtype	and  #$E0FF	cmp  #$C005		;CD-ROM type/subtype ?	bne  notCD	lda  SPBuffer+6		;check vendor name	cmp  #'OS'		;'SONY'	bne  notCD	lda  SPBuffer+8	cmp  #'YN'	bne  notCD			lda  #$0000		;ok now		sta  InitError	secexit	pla	rts	notCD	clc	bra  exit	notRevC	lda  #$4000	sta  InitError	clc	bra  exitbFlag	DC.W  0	ENDP	*===============================================**	SmartPort Units		** - tells how many units (volumes) there are	**			** INPUT:	none		**			** OUTPUT:	unitCount (A-Reg)	**			**===============================================*SPUnits	PROC	IMPORT  SPCall	shortm	lda  #$00	sta  SPUnit		;SP unit number	sta  SPCode		;status code	longm	lda  #^SPBuffer	sta  SPBuffPtr+2	lda  #SPBuffer	sta  SPBuffPtr	lda  #$40		;command code	ldx  #$03		;number of parameters	jsr  SPCall	cmp  #0		;check for SP error	bne  spErr	lda  SPBuffer		;# of devices	bra  exitspErr	lda  #0exit	rts	ENDP	*===============================================**	Do SmartPort Call	**			** INPUT:	CallNum (A-Reg)		**	NumParams (X-Reg)	**			** OUTPUT:	SP Error (A-Reg)	**			**===============================================*	EXPORT  SPCall  SPCall	PROC	IMPORT  SPEntry	shortm	ora  #$40		;use extended calls	sta  SPEntry+3		;SP command number	txa	sta  SPCount		;number of parameters	longm	ldx  #8		;copy SP code to bank 0@loop	lda  SPEntry,x	pha	dex	dex	bpl  @loop	tsx	inx		;points to SP code start	pushlong #00		;result	pushlong #00		;result	pushlong #00		;a, x reg	pushword #00		;y reg	phx		;address of call	_FWEntry		;call to our code in bank zero	ply		;get Y-reg after the call ($00yy)	plx		;get X-reg after the call ($00xx)	pla		;get A-reg after the call ($00aa)	sta  atmp		;save it temporarily	pla		;pull 8-bit garbage & status reg	pla		;clean up stack (SP code)	pla	pla	pla	pla	lda  atmp		;reload the A-reg	cmp  #1	rtsatmp	DS.B  2	ENDP*===============================================**        Entry Point for SmartPort calls	**===============================================*SPEntry	PROC	jsr  $0000		;SP dispatch	DS.B  1		;SP command	DC.L  SPList		;param list ptr	rts	ENDP	*===============================================** 	SmartPort Error		** - handle a SmartPort Error		**			** INPUT:	errorCode (A-Reg)	**			** OUTPUT:	errorCode (A-Reg)	**			**===============================================*;SPError	PROC;;	IMPORT  DoAlert;	IMPORT  SPEntry;	;	and  #$00FF;	cmp  #$0027		;I/O error;	beq  ioError;	brl  exit;ioError	;	pha		;save it;	stz  SPBuffer+2;	stz  SPBuffer+12;	;	PushLong #SPEntry	;SP entry address;	PushLong #EntryAddr;	PushWord #6;	_Long2Hex;	lda  SPCode		;control code;	PushLong #0;	pha;	_HexIt;	pla;	PullWord ControlCode;	;	lda  #$05		;Status Code = Get Sense;	sta  SPCode;	lda  #^SPBuffer;	sta  SPBuffPtr+2;	lda  #SPBuffer;	sta  SPBuffPtr;	lda  #$40		;command;	ldx  #$03		;param count;	jsr  SPCall		;do status call;	;	lda  1,s		;smartport error;	PushLong #0;	pha;	_HexIt;	pla;	PullWord ErrorCode;	lda  SPBuffer+2		;sense key;	and  #$000F;	PushLong #0;	pha;	_HexIt;	pla;	PullWord SenseKey;	lda  SPBuffer+12	;sense code;	and  #$00FF;	PushLong #0;	pha;	_HexIt;	pla;	PullWord SenseCode;	;	lda  SPBuffer+12	;sense code;	and  #$00FF;	cmp  #$0084;	beq  skip;	lda  #$0001;	ldx  #SPErrStr;	ldy  #^SPErrStr;	jsr  DoAlert;skip	;	pla		;restore error code;exit	cmp  #1;	rts;;	ENDP;	*===============================================** Test RUBY for disc on line		**			** INPUT:	none		**			** OUTPUT:	A-Reg  1 = OnLine; 0 = OffLine	**	C-Flag 1 = not on line	**			** This could hang if Status keeps returning $27 **===============================================*	EXPORT  SPOnLine SPOnLine	PROC	IMPORT  (NoDisc,NewDisc):CODE		lda  #$00		;Status Code	sta  SPCode	lda  #^SPBuffer	sta  SPBuffPtr+2	lda  #SPBuffer	sta  SPBuffPtr	lda  #$40		;command	ldx  #$03		;param count	jsr  SPCall		;do status call	bcc  cont		lda  #$40		;command	ldx  #$03		;param count	jsr  SPCall		;try again	bcs  offlinecont		lda  SPBuffer	and  #$0010		;look at online bit	bne  online	lda  IsOnline	beq  offline		;already knew it	jsr  NoDisc		;reset variables	stz  IsOnLineoffline	lda  #0	sec	bra  exitonline	lda  IsOnLine	bne  okay		;no disc switch	inc  IsOnLine	jsr  NewDisc		;read TOC stuff for DAokay	lda  #1	clcexit	rts		ENDP	*===============================================**	SCSI Busy		** - check to see if SCSI Card is "busy".	**			** INPUT:	none		**			** OUTPUT:	busyflag (carry bit) 1=yes, 0=no**			**===============================================*	EXPORT  SCSIBusySCSIBusy	PROC	lda  Slot		;get NCR register locations	and  #$0007	clc	adc  #$0008	asl  a	asl  a	asl  a	asl  a	ora  #$C000	tax		;X <-- $C0n0 (n = slot + 8)	lda  $E00000,x		;check NCR registers	cmp  #$0000	bne  busy	lda  $E00002,x	cmp  #$0000	bne  busy	lda  $E00004,x	cmp  #$0800	bne  busy		sep  #$20	lda  >$E0C015		;RDCXROM	rep  #$20	and  #$00FF	beq  okay		;internal ROM active			lda  Slot		;check MSLOT ($07F8)	and  #$0007	ora  #$00C0		;$00Cn (n = slot)	cmp  >$0007F8		;was the card "active"	beq  busy		;yes!okay	clc		;C <-- "not busy"	bra  exit	busy	sec		;C <-- "busy"exit	rts	ENDP	*===============================================**	SmartPort Rezero Unit	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*	EXPORT  SPRezero SPRezero	PROC	lda  #$1d		;Control Code	sta  SPCode	lda  #^SPBuffer	sta  SPBuffPtr+2	lda  #SPBuffer	sta  SPBuffPtr	lda  #$44		;control command	ldx  #$03		;param count	jsr  SPCall	rts 	ENDP	*===============================================**	Audio SmartPort Call	**			** INPUT:	ctrlCode (A-Reg)	**			** OUTPUT:	errorCode (A-Reg)	**	carryFlag (1=error, 0=okay)	**			**===============================================*	EXPORT  ASPCallASPCall	Proc	IMPORT  (SPError,SPCall):CODE		sta  SPCode		;control code	lda  #^AudioBuffer	sta  SPBuffPtr+2	lda  #AudioBuffer	sta  SPBuffPtr	lda  #$44		;command code	ldx  #$03		;number of parameters	jsr  SPCall	cmp  #1;	bcc  exit;	jsr  SPError		;handle error (debug)exit	rts		ENDP	*===============================================**	 Audio Seek Track	** - seek to track and hold		**			** INPUT:	track (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  ASeekTrackASeekTrack	PROC		IMPORT  AStopTrack		pha	jsr  AStopTrack		;reset to this track	pla	sta  AudioBuffer+2	;set search track	lda  PlayMode	and  #$000F	xba	sta  AudioBuffer	;set play bit/play mode	stz  AudioBuffer+4	lda  #2		;use track	sta  AudioBuffer+6	;set address type	lda  #$20		;AUDIOSRCH Command	jsr  ASPCall	bcc  exit	lda  #$20	jsr  ASPCall		;try againexit	rts		ENDP	*===============================================**	  Audio Play Time	**			** INPUT:	frame (A-Reg)		**	sec (X-Reg)		**	min (Y-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  APlayTimeAPlayTime	PROC		SetShort	sta  AudioBuffer+2	;set playback FRAME	stx  AudioBuffer+3	;set playback SEC	sty  AudioBuffer+4	;set playback MIN	stz  AudioBuffer+5	;reserved	stz  AudioBuffer+0	;set stop bit	lda  PlayMode	sta  AudioBuffer+1	;set play mode	lda  #$01		;use time	sta  AudioBuffer+6	;set address type	SetLong		lda   #$21		;AUDIOPLAY Command	jsr   ASPCall	bcc   exit	lda   #$21	jsr   ASPCall		;try again	exit	rts		ENDP	*===============================================**	  Audio Play Track	**			** INPUT:	track (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  APlayTrackAPlayTrack	PROC		;A-reg has TRACK		IMPORT  TestAudioTrack	;	pha;	jsr  TestAudioTrack;	pla;	bcs  exit		;data track encountered!	stz  AudioBuffer+0	;set stop bit	ldx  PlayMode	stx  AudioBuffer+1	;set play mode	sta  AudioBuffer+2	;set playback track	sta  ATrack	stz  AudioBuffer+4	;reserved	lda  #$02		;use track	sta  AudioBuffer+6	;set address type	lda  #$21		;AUDIOPLAY Command	jsr  ASPCall	bcc  exit	lda  #$21	jsr  ASPCall		;try againexit	rts		ENDP	*===============================================**	  Audio Pause		**			** INPUT:	flag (A-Reg) 0=set,1=release	**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  APauseAPause	PROC		sta  AudioBuffer	;set pause bit	lda  #$22		;PAUSE Command	jsr  ASPCall	rts		ENDP	*===============================================**	Audio Stop Time		** - set time stoping address		**			** INPUT:	frame (A-Reg)		**	sec (X-Reg)		**	min (Y-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  AStopTimeAStopTime	PROC		SetShort	sta  AudioBuffer+0	;playback FRAME	stx  AudioBuffer+1	;playback SEC	sty  AudioBuffer+2	;playback MIN	stz  AudioBuffer+3	;reserved	lda  #$01		;use TIME	sta  AudioBuffer+4	;address type	SetLong		lda  #$23		;AUDIOSTOP Command	jsr  ASPCall	bcc  exit	lda  #$23	jsr  ASPCall		;try againexit	rts		ENDP	*===============================================**	Audio Stop Track	** - set track stoping address		**			** INPUT:	track (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  AStopTrackAStopTrack	PROC		IMPORT  TestAudioTrack	;	pha;	jsr  TestAudioTrack;	pla;	bcs  exit		;data track encountered!	sta  AudioBuffer	;stoping track	stz  AudioBuffer+2	lda  #$02	sta  AudioBuffer+4	;addr type = track		lda  #$23		;AUDIOSTOP Command	jsr  ASPCall	bcc  exit	lda  #$23	jsr  ASPCall		;try againexit	rts		ENDP	*===============================================**	  Audio Status		**			** INPUT:	none		**			** OUTPUT:	AudioStatus (A-Reg)	**	($ff = error/undefined	**			**===============================================*	EXPORT  AStatusAStatus	PROC		lda  #$24		;AUDIOSTAT Command	jsr  ASPCall	bcc  okay	lda  #$24	jsr  ASPCall		;try again	bcc  okay	lda  #$0004	bra  exitokay	lda  AudioBuffer	and  #$00ff		;return audio Statusexit	rts		ENDP	*===============================================**           Audio Scan Forward/Reverse	**			** INPUT:	frame (A-Reg)		**	sec (X-Reg)		**	min (Y-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  AScanFAScanF	PROC		;A = FRAME,X = SEC,Y = MIN		lda  #0	bra  cont		EXPORT AScanR	ENTRY  AScanRAScanR	lda  #1cont	sta  AudioBuffer+0	;direction bit		shortm	sta  AudioBuffer+2	;scan FRAME	stx  AudioBuffer+3	;scan SEC	sty  AudioBuffer+4	;scan MIN	lda  #0	sta  AudioBuffer+5	lda  #$01		;use time	sta  AudioBuffer+6	;address type	longm		lda  #$25		;AUDIOSCAN Command	jsr  ASPCall	bcc  exit	lda  #$25	jsr  ASPCall		;try againexit	rts		ENDP	*===============================================**	Audio Scan Track	**			** INPUT:	track (A-Reg)		**	direction (X-Reg) 0=FWD, 1=REV	**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  AScanTrackAScanTrack	PROC		stx  AudioBuffer+0	;direction bit		sta  AudioBuffer+2	;scan track	stz  AudioBuffer+4	lda  #$0002		;use track	sta  AudioBuffer+6	;address type		lda  #$25		;AUDIOSCAN Command	jsr  ASPCall	bcc  exit	lda  #$25	jsr  ASPCall		;try againexit	rts		ENDP	*===============================================**	   Audio Eject		**			** INPUT:	none		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  AEjectAEject	PROC		lda  #$26		;EJECT Command	jmp  ASPCall		ENDP	*===============================================**	Audio Play Mode		**			** INPUT:	mode (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  APlayModeAPlayMode	PROC		IMPORT  CDCurTrk:DATA	IMPORT  CDMinB:DATA	IMPORT  CDSecB:DATA	IMPORT  CDFrameB:DATA		sta  PlayMode		;save mode for other calls	ldx  #1	stx  AudioBuffer+0	;stop bit	sta  AudioBuffer+1	;play mode	lda  CDCurTrk	sta  AudioBuffer+2	;playback track	stz  AudioBuffer+4	lda  #$02		;use track	sta  AudioBuffer+6	;address type	bra  doIT		EXPORT APlayModeTime	ENTRY  APlayModeTimeAPlayModeTime	sta  PlayMode		;save mode for other calls	ldx  #1	stx  AudioBuffer+0	;stop bit	sta  AudioBuffer+1	;play mode	lda  CDFrameB	sta  AudioBuffer+2	;playback time	lda  CDSecB	sta  AudioBuffer+3	lda  CDMinB	sta  AudioBuffer+4	lda  #$01		;use time	sta  AudioBuffer+6	;address typedoIt	lda  #$21		;AUDIOPLAY Command	jsr  ASPCall	bcc  exit	lda  #$21	jsr  ASPCall		;try againexit	rts		ENDP	*===============================================**	Audio TOC Track		** - get first and last track numbers	**			** INPUT:	none		**			** OUTPUT:	firstTrk (X-Reg)	**	lastTrk (Y-Reg)		**			**===============================================*	EXPORT  ATOCTrackATOCTrack	PROC		stz  AudioBuffer	;track number	lda  #$04	sta  AudioBuffer+1	;allocation length	lda  #$00	sta  AudioBuffer+3	;TOC type	lda  #$27		;READTOC Command	jsr  ASPCall	bcc  okay	lda  #$27	jsr  ASPCall		;try again	bcc  okay	ldx  #0	ldy  #0	bra  exit	okay	lda  AudioBuffer	;first track	and  #$00FF	tax	lda  AudioBuffer+1	;last track	and  #$00FF	tayexit	rts		ENDP	*===============================================**	 Audio TOC Time		** - get absolute track time values	** - get control field (data/audio track)	**			** INPUT:	none		**			** OUTPUT:	carryFlag (1 = error)	**			**===============================================*	EXPORT  ATOCTimeATOCTime	PROC		;get absolute track times		IMPORT  (CDMinTrk,CDTrkCnt,CDATime):DATA		lda  CDMinTrk		;PROCing track number	sta  AudioBuffer	lda  CDTrkCnt		;track count	asl  A		;tracks * 4	asl  A	sta  AudioBuffer+1	;allocation length	lda  #$02	sta  AudioBuffer+3	;TOC type	lda  #$27		;READTOC Command	jsr  ASPCall	bcc  okay	lda  #$27	jsr  ASPCall		;try again	bcs  exit		;error occuredokay		lda  CDTrkCnt	dec  A	asl  A	asl  A	tay	lda  CDTrkCnt	dec  A	dec  A	asl  A	tax	phy	loop	lda  AudioBuffer+1,y	;AMin, ASec	xba		;lsb <-- sec, msb <-- min	sta  CDATime,x		;CDATime(x) <-- ATime(x+1)	lda  AudioBuffer-4,y	;control field	and  #$000D	cmp  #$0004		;is it a data track?	bne  cont1		;no	lda  CDATime,x	ora  #$8000		;mark entry as data	sta  CDATime,xcont1	dey	dey	dey	dey	dex	dex	bpl  loop	ply		;check last track	stz  AControl	lda  AudioBuffer,y	and  #$000D	cmp  #$0004		;is it a data track?	bne  cont2		;no	lda  #$8000	sta  AControlcont2	stz  AudioBuffer	;track number	lda  #$04	sta  AudioBuffer+1	;allocation length	lda  #$01	sta  AudioBuffer+3	;TOC type	lda  #$27		;READTOC Command	jsr  ASPCall	cmp  #1	bcs  exit		;error occured	lda  CDTrkCnt	dec  A	asl  A	tax	lda  AudioBuffer	;lead-out time	xba		;lsb <-- sec, msb <-- min	ora  AControl	sta  CDATime,x		;CDATime(n) <-- Time	clcexit	rts		ENDP	*===============================================**	Audio Read Q-Data	**			** INPUT:	none		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*	EXPORT  AReadQAReadQ	PROC	IMPORT  (CDAMin,CDASec,CDMin,CDSec,CDIndex):DATA	IMPORT  (CDAFrame,CDFrame,CDCurTrk):DATA	lda  #$28		;READQ Command	jsr  ASPCall	bcc  cont	lda  #$28		;READQ Command	jsr  ASPCall	bcs  exit		;SP errorcont		shortm	lda  AudioBuffer	;control field	sta  AControl	lda  AudioBuffer+1	cmp  #$AA		;into lead-out area ?	bne  okay		;no	lda  #0okay	sta  CDCurTrk	lda  AudioBuffer+2	sta  CDIndex	lda  AudioBuffer+3	;save track TIME	sta  CDMin	lda  AudioBuffer+4	sta  CDSec	lda  AudioBuffer+5	sta  CDFrame	lda  AudioBuffer+6	;save absolute TIME	sta  CDAMin	lda  AudioBuffer+7	sta  CDASec	lda  AudioBuffer+8	sta  CDAFrame	longmexit		rts		ENDP	*===============================================*	END