dhW2_320	equ  265		;width of About windowdvW2	equ  80		;height of About windowh5	equ  dhW1-2*h1-4*dhN-3h6	equ  dhW1-h1-dhI+2pictX1L	equ  2*h1		;picture coordinatespictX2L	equ  pictX1L+6+dhPLpictY1L	equ  v2+3pictY2L	equ  v2+3pictCX	equ  h5+2*dhN		;picture coordinatespictCY	equ  v2+9tw0	equ  30/2		;text string widthstw1	equ  30/2tw2	equ  37/2tw3	equ  36/2tw4	equ  38/2tw5	equ  30/2tw6	equ  34/2tw7	equ  42/2tw8	equ  49/2tw9	equ  27/2penMode	equ  0