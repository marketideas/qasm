* * * * * * * * * * * * * * * * * * * * * * * * ** File:  GSOSDRIVER.aii		**			** GSOS Driver to AppleCD SCª (RUBY) drive	** Module for CD-Remote (A New Desk Accessory)	** 			** Author:	Don Brady		**			** Build File:	CDRemote.make		**			** Copyright © APPLE Computer, Inc. 1987-89	** All rights reserved.		**			** Modification History:		** Version 1.1			** 07/26/88 DJB - Created today		** * * * * * * * * * * * * * * * * * * * * * * * * ;...............................................................;;        Set Memory & registers to 16 bits;...............................................................	MACRO	SetLong	rep   #%00110000	longa on	longi on	MEND;...............................................................;;        Set Memory & registers to 8 bits;...............................................................	MACRO	SetShort	sep   #%00110000	longa off	longi off	MEND	;-----------------------------------------------;;   Imported data address (from CDRemote.aii);;-----------------------------------------------	IMPORT  CDAFrame			IMPORT  CDAMin	IMPORT  CDASec	IMPORT  CDATime	IMPORT  CDCurTrk	IMPORT  CDData	IMPORT  CDFrame	IMPORT  CDMaxTrk	IMPORT  CDMin	IMPORT  CDMinTrk	IMPORT  CDSec	IMPORT  CDTrkCnt		include  'all.macros'	*===============================================**	GS/OS Constants		**===============================================*GSOSEntry	equ  $E100A8D_INFO	equ  $202CD_STATUS	equ  $202DD_CONTROL	equ  $202EdcRemove	equ  $0004dsOnline	equ  $0010devCDROM	equ  $0007pauseBit	equ  $10		; changed to $10 DJB 12/02/88stopBit	equ  $10scanForward	equ  $00;scanReverse	equ  $40scanReverse	equ  $10		; changed to $10 CAF 12/07/90tocType0	equ  $00tocType1	equ  $40tocType2	equ  $80addrBlock	equ  $00addrTime	equ  $40addrTrack	equ  $80dataTrack	equ  $8000*===============================================**         Device Driver Control Codes	**===============================================*ccEject	equ  $0002ccRezeroUnit	equ  $8001ccAudioSearch	equ  $80C8ccAudioPlay	equ  $80C9ccAudioPause	equ  $80CAccAudioStop	equ  $80CBccAudioStatus	equ  $80CCccAudioScan	equ  $80CDccReadTOC	equ  $80C1ccReadQSub	equ  $80C2ccReadHeader	equ  $80C3	*===============================================**            Data for SmartPort Driver	**===============================================*SPData	PROC	ENTRY  DeviceNumberDeviceNumber	DC.W  0	ENTRY  IsOnLineIsOnLine	DC.W  0		;boolean flag	ENTRY  ParamsParams	DC.W  0		;parameter block for Version	ENTRY  AudioBufferAudioBuffer	DS.B  4*99		;Audio I/O buffer	ENTRY  PlayModePlayMode	DC.W  9		;default = stereo	ENTRY  AControlAControl	DC.W  0	ENTRY  ATrackATrack	DC.W  0	ENTRY  AIndexAIndex	DC.W  0	ENTRY  AMinAMin	DC.W  0		;not used ????	ENTRY  ASecASec	DC.W  0	ENTRY  AFrameAFrame	DC.W  0	ENTRY  dstat_paramsdstat_params	DC.W  5		;pcount	ENTRY  dstat_devnumdstat_devnum	DC.W  0		;device number	ENTRY  dstat_codedstat_code	DC.W  0		;control code	ENTRY  dstat_listdstat_list	DC.L  dstat_data	;status list	ENTRY  dstat_rcountdstat_rcount	DC.L  6		;request count	ENTRY  dstat_tcountdstat_tcount	DC.L  0		;transfer count	ENTRY  dstat_datadstat_data	DS.B  8	ENTRY  dctrl_paramsdctrl_params	DC.W  5		;pcount	ENTRY  dctrl_devnumdctrl_devnum	DC.W  0		;device number	ENTRY  dctrl_codedctrl_code	DC.W  0		;control code	ENTRY  dctrl_listdctrl_list	DC.L  ControlList	;control list ptr.	ENTRY  dctrl_rcountdctrl_rcount	DC.L  0		;request count	ENTRY  dctrl_tcountdctrl_tcount	DC.L  0		;transfer count	ENTRY  ControlListControlList	DC.W  0		;this is always zero!	ENTRY  CommandDataCommandData	DS.B  12		;command data	ENTRY  AudioBufPtrAudioBufPtr	DC.L  AudioBuffer	;data buffer ptr.	ENTRY  part2_rcountpart2_rcount	DC.L  0		;transfer count for part 2	ENTRY dinfo_paramsdinfo_params	DC.W  8		;pcount	ENTRY dinfo_devnumdinfo_devnum	DC.W  0		;device number	ENTRY dinfo_devnamedinfo_devname	DC.L  DevNameBuf	;device name ptr	ENTRY  dinfo_devchardinfo_devchar	DC.W  0		;device characteristics	DC.L  0		;total blocks	DC.W  0		;slot number	DC.W  0		;unit number	DC.W  0		;version	ENTRY dinfo_deviddinfo_devid	DC.W  0		;device idDevNameBuf	DC.W  36		;class 1 output stringDevName	DS.B  34	ENDP	*===============================================**	Initialize Driver	** - make sure GS/OS is active		** - look for SCSI Card Rev C		** - look for a AppleCD SC (RUBY) drive	** - check if device is online		**			** INPUT:	none		**			** OUTPUT:	ErrorCode (A-Reg)	**	$0000 = okay		**	$8000 = no RUBY drive	**	$4000 = no SCSI Rev C	**	$2000 = no SCSI card	**	$1000 = not GS/OS	**===============================================*	EXPORT  SPInit	EXPORT  SPInit2SPInit	PROC		_GET_VERSION Params	lda  Params	and  #$7F00	cmp  #$0200		;is it GS/OS (2.0 or greater)?	bcs  SPInit2	lda  #$1000	bra  exit		ENTRY  SPInit2		;for the "backdoor"SPInit2		ldx  #1		;start with first deviceloop	stx  dinfo_devnum	stx  dstat_devnum		phx		;save device number		jsl  GSOSEntry	DC.W  D_INFO	DC.L  dinfo_params	plx	bcs  none		;no more devices	lda  dinfo_devchar	and  #dcRemove		;a removable device?	beq  next		;no		lda  dinfo_devid	cmp  #devCDROM		;a CD-ROM device?	bne  next		;no		phx		;save device number	jsl  GSOSEntry	DC.W  D_STATUS	DC.L  dstat_params	plx	bcs  done	stz  IsOnLine	lda  dstat_data	and  #dsOnline		;device online?	beq  done	lda  #1	sta  IsOnLine	bra  donenext	inx	bra  loopdone	stx  DeviceNumber	stx  dctrl_devnum	lda  #$0000		;no errorexit	cmp  #1	rtsnone		lda  #$8000		;no RUBY drive	bra  exit	ENDP		*===============================================** Test RUBY for disc on line		**			** INPUT:	none		**			** OUTPUT:	A-Reg  1 = OnLine; 0 = OffLine	**	C-Flag 1 = not on line	**			**===============================================*SPOnLine	PROC  EXPORT	IMPORT  NoDisc	IMPORT  NewDisc		lda  DeviceNumber	sta  dstat_devnum	lda  #6		;request 6 bytes	sta  dstat_rcount		jsl  GSOSEntry	DC.W  D_STATUS	DC.L  dstat_params	bcc  cont	jsl  GSOSEntry		;try again	DC.W  D_STATUS	DC.L  dstat_params	bcs  offlinecont	lda  dstat_data	and  #dsOnline		;device online?	bne  online	lda  IsOnline	beq  offline		;already knew it	jsr  NoDisc		;reset variables	stz  IsOnLineoffline	lda  #0	sec	bra  exitonline	lda  IsOnLine	bne  okay		;no disc switch	inc  IsOnLine	jsr  NewDisc		;read TOC stuff for DAokay	lda  #1	clcexit	rts		ENDP	*===============================================**	SCSI Busy		** - check to see if SCSI Card is "busy".	**			** INPUT:	none		**			** OUTPUT:	busyflag (carry bit) 1=yes, 0=no**			**===============================================*SCSIBusy	PROC  EXPORT	clc		;C <-- "not busy"	rts	ENDP	*===============================================**	SmartPort Rezero Unit	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*SPRezero	PROC  EXPORT	lda  #ccRezeroUnit	;control Code	sta  dctrl_code	and  #$00FF	sta  CommandData	;set SCSI command		stz  CommandData+2	stz  CommandData+4	stz  CommandData+6	stz  CommandData+8	stz  CommandData+10		jsl  GSOSEntry	DC.W  D_CONTROL	DC.L  dctrl_params	rts 	ENDP	*===============================================**            Initialize Control data	**			** INPUT:	none		**			** OUTPUT:	none		**	A, X, & Y reg preserved	**===============================================*InitCmndData	Proc	stz  dctrl_rcount		phx	ldx  #10loop	stz  CommandData,x	dex	dex	bpl  loop	plx	rts		ENDP	*===============================================**	CD-ROM Audio Call	**			** INPUT:	ctrlCode (A-Reg)	**			** OUTPUT:	errorCode (A-Reg)	**	carryFlag (1=error, 0=okay)	**			**===============================================*AudioCall	Proc  EXPORT		sta  dctrl_code		;control code	and  #$00FF	sta  CommandData	;set SCSI command	jsl  GSOSEntry	DC.W  D_CONTROL	DC.L  dctrl_params	rts		ENDP	*===============================================**	CD-ROM Status Call	**			** INPUT:	ctrlCode (A-Reg)	**			** OUTPUT:	errorCode (A-Reg)	**	carryFlag (1=error, 0=okay)	**			**===============================================*StatusCall	Proc  EXPORT		sta  dctrl_code		;status code	and  #$00FF	sta  CommandData	;set SCSI command	jsl  GSOSEntry	DC.W  D_STATUS	DC.L  dctrl_params	;use contol parameter list	rts		ENDP	*===============================================**	 Audio Seek Track	** - seek to track and hold		**			** INPUT:	track (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*ASeekTrack	PROC  EXPORT		IMPORT  AStopTrack		pha	jsr  AStopTrack		;reset to this track	pla	jsr  InitCmndData	;zero out command data	sta  CommandData+7	;set search track*	lda  PlayMode*	and  #$000F		;only bits 0-15 are valid*	xba*	sta  CommandData+2	;set play bit/play mode	lda  #addrTrack		;use track	sta  CommandData+8	;set address type	lda  #ccAudioSearch	;control code	jsr  AudioCall	bcc  exit	lda  #ccAudioSearch	jsr  AudioCall		;try againexit	rts		ENDP	*===============================================**	  Audio Play Time	**			** INPUT:	frame (A-Reg)		**	sec (X-Reg)		**	min (Y-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*APlayTime	PROC  EXPORT		jsr  InitCmndData	;zero out command data		SetShort	sty  CommandData+5	;set playback MIN	stx  CommandData+6	;set playback SEC	sta  CommandData+7	;set playback FRAME	stz  CommandData+2	;set stop bit	lda  PlayMode	sta  CommandData+3	;set play mode	lda  #addrTime		;use time	sta  CommandData+8	;set address type	SetLong		lda   #ccAudioPlay	;control code	jsr   AudioCall	bcc   exit	lda   #ccAudioPlay	jsr   AudioCall		;try again	exit	rts		ENDP	*===============================================**	  Audio Play Track	**			** INPUT:	track (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*APlayTrack	PROC  EXPORT		;A-reg has TRACK		jsr  InitCmndData	;zero out command data		stz  CommandData+2	;set stop bit	ldx  PlayMode	stx  CommandData+3	;set play mode	sta  CommandData+7	;set playback track	sta  ATrack	lda  #addrTrack		;use track	sta  CommandData+8	;set address type	lda  #ccAudioPlay	;control code	jsr  AudioCall	bcc  exit	lda  #ccAudioPlay	jsr  AudioCall		;try againexit	rts		ENDP	*===============================================**	  Audio Pause		**			** INPUT:	flag (A-Reg) 0=set,1=release	**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*APause	PROC  EXPORT		jsr  InitCmndData	;zero out command data		tax	beq  cont	lda  #pauseBitcont	sta  CommandData+2	;set pause bit	lda  #ccAudioPause	;control code	jsr  AudioCall	rts		ENDP	*===============================================**	Audio Stop Time		** - set time stoping address		**			** INPUT:	frame (A-Reg)		**	sec (X-Reg)		**	min (Y-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*AStopTime	PROC  EXPORT		jsr  InitCmndData	;zero out command data		SetShort	sty  CommandData+3	;playback MIN	stx  CommandData+4	;playback SEC	sta  CommandData+5	;playback FRAME	lda  #addrTime		;use TIME	sta  CommandData+6	;address type	SetLong		lda  #ccAudioStop	;control code	jsr  AudioCall	bcc  exit	lda  #ccAudioStop	jsr  AudioCall		;try againexit	rts		ENDP	*===============================================**	Audio Stop Track	** - set track stoping address		**			** INPUT:	track (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*AStopTrack	PROC  EXPORT		jsr  InitCmndData	;zero out command data		sta  CommandData+5	;stoping track;--- Added DJB 7 Jun 89 ------------------------	tax	bne  @normal	lda  #addrBlock		; if track = 0 we want to do a	bra  setType		; rezero unit so type must be block;--- End Addition ------------------------------@normal	lda  #addrTracksetType	sta  CommandData+6	;addr type = track		lda  #ccAudioStop	;control code	jsr  AudioCall	bcc  exit	lda  #ccAudioStop	jsr  AudioCall		;try againexit	rts		ENDP	*===============================================**	  Audio Status		**			** INPUT:	none		**			** OUTPUT:	AudioStatus (A-Reg)	**	($04 = error/undefined)	**			**===============================================*AStatus	PROC  EXPORT		jsr  InitCmndData	;zero out command data		lda  #6		;request 6 bytes	sta  dctrl_rcount	lda  #ccAudioStatus	;status code	jsr  StatusCall	bcs  again	lda  dctrl_tcount	;was our data transfered?	cmp  #6	beq  okayagain	lda  #ccAudioStatus	jsr  StatusCall		;try again	bcs  err	lda  dctrl_tcount	;was our data transfered?	cmp  #6	beq  okayerr	lda  #$0004		;simulate an error	bra  exitokay	lda  AudioBuffer	and  #$00ff		;return audio statusexit	rts		ENDP	*===============================================**           Audio Scan Forward/Reverse	**			** INPUT:	frame (A-Reg)		**	sec (X-Reg)		**	min (Y-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*AScanF	PROC  EXPORT		;A = FRAME, X = SEC, Y = MIN	jsr  InitCmndData	;zero out command data		SetShort	sty  CommandData+5	;scan MIN	stx  CommandData+6	;scan SEC	sta  CommandData+7	;scan FRAME	lda  #addrTime		;use time	sta  CommandData+8	;address type	lda  #scanForward	sta  CommandData+2	;direction bit	SetLong	bra  continue		EXPORT AScanRAScanR	jsr  InitCmndData	;zero out command data		SetShort	sty  CommandData+5	;scan MIN	stx  CommandData+6	;scan SEC	sta  CommandData+7	;scan FRAME	lda  #addrTime		;use time	sta  CommandData+8	;address type	lda  #scanReverse	sta  CommandData+2	;direction bit	SetLongcontinue		lda  #ccAudioScan	;control code	jsr  AudioCall	bcc  exit	lda  #ccAudioScan	jsr  AudioCall		;try againexit	rts		ENDP	*===============================================**	Audio Scan Track	**			** INPUT:	track (A-Reg)		**	direction (X-Reg) 0=FWD, 1=REV	**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*AScanTrack	PROC  EXPORT		jsr  InitCmndData	;zero out command data		cpx  #scanForward	beq  cont	ldx  #scanReversecont	stx  CommandData+2	;direction bit		sta  CommandData+7	;scan track	lda  #addrTrack		;use track	sta  CommandData+8	;address type		lda  #ccAudioScan	;control code	jsr  AudioCall	bcc  exit	lda  #ccAudioScan	jsr  AudioCall		;try againexit	rts		ENDP	*===============================================**	   Audio Eject		**			** INPUT:	none		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*AEject	PROC  EXPORT		jsr  InitCmndData	;zero out command data		lda  #ccEject		;control code	sta  dctrl_code	stz  CommandData	jsl  GSOSEntry	DC.W  D_CONTROL	DC.L  dctrl_params	rts		ENDP	*===============================================**	Audio Play Mode		**			** INPUT:	mode (A-Reg)		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*APlayMode	PROC  EXPORT		IMPORT  CDCurTrk:DATA	IMPORT  CDMinB:DATA	IMPORT  CDSecB:DATA	IMPORT  CDFrameB:DATA		jsr  InitCmndData	;zero out command data		sta  PlayMode		;save mode for other calls	ldx  #stopBit	stx  CommandData+2	;stop bit	sta  CommandData+3	;play mode	lda  CDCurTrk	xba	sta  CommandData+6	;playback track	lda  #addrTrack		;use track	sta  CommandData+8	;address type	bra  doIT		EXPORT APlayModeTimeAPlayModeTime	jsr  InitCmndData	;zero out command data		sta  PlayMode		;save mode for other calls	ldx  #stopBit	stx  CommandData+2	;stop bit	sta  CommandData+3	;play mode	lda  CDMinB		;playback time	sta  CommandData+5	lda  CDSecB	sta  CommandData+6	lda  CDFrameB	sta  CommandData+7	lda  #addrTime		;use time	sta  CommandData+8	;address typedoIt	lda  #ccAudioPlay	;control code	jsr  AudioCall	bcc  exit	lda  #ccAudioPlay	jsr  AudioCall		;try againexit	rts		ENDP	*===============================================**	Audio TOC Track		** - get first and last track numbers	**			** INPUT:	none		**			** OUTPUT:	firstTrk (X-Reg)	**	lastTrk (Y-Reg)		**			**===============================================*ATOCTrack	PROC  EXPORT		jsr  InitCmndData	;zero out command data		stz  CommandData+2	;track number	stz  CommandData+3	;reserved	lda  #tocType0	sta  CommandData+5	;TOC type 0	lda  #$04	sta  dctrl_rcount	;allocation length	lda  #ccReadTOC		;status code	jsr  StatusCall	bcc  okay	lda  #ccReadTOC	jsr  StatusCall		;try again	bcc  okay	ldx  #0	ldy  #0	bra  exit	okay	lda  AudioBuffer	;first track	and  #$00FF	tax	lda  AudioBuffer+1	;last track	and  #$00FF	tayexit	rts		ENDP	*===============================================**	 Audio TOC Time		** - get absolute track time values	** - get control field (data/audio track)	**			** NOTE:  This routined was patched to work	** around a SCSI Driver bug. The driver can only	** return 255 bytes of data for a status call. 	** Since each track has 4 bytes of data, a track	** count greater than 63 will exceed this limit.	** To get around this limitation I split the call** into 2 parts so that I can read all of the	** TOC data without getting an error back from   ** the driver.			**			** INPUT:	none		**			** OUTPUT:	carryFlag (1 = error)	**			**===============================================*ATOCTime	PROC  EXPORT		;get absolute track times		IMPORT  (CDMinTrk,CDTrkCnt,CDATime):DATA		stz  part2_rcount	;no part 2 yet		jsr  InitCmndData	;zero out command data	lda  #tocType2	sta  CommandData+5	;TOC type 2 call		lda  CDTrkCnt		;track count	asl  A		;tracks * 4	asl  A	sta  dctrl_rcount	;allocation length	cmp  #$0100		;is it too big for driver?	bcc  normal	sec	sbc  #252	sta  part2_rcount	;part 2 allocation length	lda  #252	sta  dctrl_rcount	;part 1 allocation lengthnormal	lda  CDMinTrk		;starting track number	sta  CommandData+2	lda  #ccReadTOC		;status code	jsr  StatusCall	bcc  okay	lda  #ccReadTOC	jsr  StatusCall		;try again	bcc  okay	brl  exit		;error occuredokay	lda  part2_rcount	;is there a part 2 ?	beq  makeTable		;no	sta  dctrl_rcount	lda  #$0064		;starting track number	sta  CommandData+2		clc	lda  AudioBufPtr	;point to part2	adc  #252	sta  AudioBufPtr	bcc  part2	inc  AudioBufPtrpart2		lda  #ccReadTOC		;status code	jsr  StatusCall	bcc  makeTable	lda  #ccReadTOC	jsr  StatusCall		;try again	bcs  exit		;error occuredmakeTable	lda  #AudioBuffer	;restore buffer pointer	sta  AudioBufPtr	lda  #^AudioBuffer	sta  AudioBufPtr+2	lda  CDTrkCnt	dec  A	asl  A	asl  A	tay	lda  CDTrkCnt	dec  A	dec  A	asl  A	tax	phy	loop	lda  AudioBuffer+1,y	;AMin, ASec	xba		;lsb <-- sec, msb <-- min	sta  CDATime,x		;CDATime(x) <-- ATime(x+1)	lda  AudioBuffer-4,y	;control field	and  #$000D	cmp  #$0004		;is it a data track?	bne  cont1		;no	lda  CDATime,x	ora  #dataTrack		;mark entry as data	sta  CDATime,xcont1	dey	dey	dey	dey	dex	dex	bpl  loop	ply		;check last track	stz  AControl	lda  AudioBuffer,y	and  #$000D	cmp  #$0004		;is it a data track?	bne  cont2		;no	lda  #dataTrack	sta  AControlcont2	stz  CommandData+2	;track number	lda  #$0004	sta  dctrl_rcount	;allocation length	lda  #tocType1	sta  CommandData+5	;TOC type 1	lda  #ccReadTOC		;status code	jsr  StatusCall	bcs  exit		;error occured	lda  CDTrkCnt	dec  A	asl  A	tax	lda  AudioBuffer	;lead-out time	xba		;lsb <-- sec, msb <-- min	ora  AControl	sta  CDATime,x		;CDATime(n) <-- Time	clcexit	rts		ENDP	*===============================================**	Audio Read Q-Data	**			** INPUT:	none		**			** OUTPUT:	carryFlag (0 = okay, 1 = error)	**			**===============================================*AReadQ	PROC  EXPORT	IMPORT  (CDAMin,CDASec,CDMin,CDSec,CDIndex):DATA	IMPORT  (CDAFrame,CDFrame,CDCurTrk):DATA	jsr  InitCmndData	;zero out command data		lda  #9		;request 9 bytes	sta  dctrl_rcount	lda  #ccReadQSub	;status code	jsr  StatusCall	bcc  cont	lda  #ccReadQSub	jsr  StatusCall		;try again	bcs  exit		;errorcont		shortm	lda  AudioBuffer	;control field	sta  AControl	lda  AudioBuffer+1	cmp  #$AA		;into lead-out area ?	bne  okay		;no	lda  #0okay	sta  CDCurTrk	lda  AudioBuffer+2	sta  CDIndex	lda  AudioBuffer+3	;save track TIME	sta  CDMin	lda  AudioBuffer+4	sta  CDSec	lda  AudioBuffer+5	sta  CDFrame	lda  AudioBuffer+6	;save absolute TIME	sta  CDAMin	lda  AudioBuffer+7	sta  CDASec	lda  AudioBuffer+8	sta  CDAFrame	longmexit		rts		ENDP	*===============================================*	END