00,$0f	DC.B  $00,$00,$00,$00,$00,$00,$0f	DC.B  $00,$00,$00,$00,$00,$00,$0f PictMapL	DC.L  Pict0L	DC.L  Pict1L	DC.L  Pict2L	DC.L  Pict3L	DC.L  Pict4L	DC.L  Pict5L	DC.L  Pict6L	DC.L  Pict7L	DC.L  Pict8L	DC.L  Pict9LPictMapS	DC.L  Pict0S	DC.L  Pict1S	DC.L  Pict2S	DC.L  Pict3S	DC.L  Pict4S	DC.L  Pict5S	DC.L  Pict6S	DC.L  Pict7S	DC.L  Pict8S	DC.L  Pict9SPictMapB	DC.L  PictB0	DC.L  PictB1	DC.L  PictB2	DC.L  PictB3	DC.L  PictB4	DC.L  PictB5	DC.L  PictB6	DC.L  PictB7AudLPtr	DC.L  PictB8aAudRPtr	DC.L  PictB9aRepPtr	DC.L  PictB10aABPtr	DC.L  PictB11aRndPtr	DC.L  PictB12a	DC.L  PictB13	PictMapT	DC.L  PictT0		;stop	DC.L  PictT1		;play	DC.L  PictT2		;pause	DC.L  PictT3		;eject	DC.L  PictT4		;track	DC.L  PictT5		;scan	DC.L  PictT6		;audio	DC.L  PictT7		;repeat	DC.L  PictT8		;shuffle	DC.L  PictT9		;time	DC.L  PictT9		;time	DC.L  PictT10		;elapsed	DC.L  PictT11		;remaining	DC.L  PictT0		;stop (display)	DC.L  PictT1		;play (display)	DC.L  PictT2		;pause (display)	DC.L  PictT12		;no disc (display)	DC.L  PictT13		;no drive (display)	DC.L  PictT14		;no audio (display)PictMapT_320	DC.L  PictT0_320	;stop	DC.L  PictT1_320	;play	DC.L  PictT2_320	;pause	DC.L  PictT3_320	;eject	DC.L  PictT4_320	;track	DC.L  PictT5_320	;scan	DC.L  PictT6_320	;audio	DC.L  PictT7_320	;repeat	DC.L  PictT8_320	;shuffle	DC.L  PictT9_320	;time	DC.L  PictT9_320	;time	DC.L  PictT10_320	;elapsed	DC.L  PictT11_320	;remaining	DC.L  PictT0_320	;stop (display)	DC.L  PictT1_320	;play (display)	DC.L  PictT2_320	;pause (display)	DC.L  PictT12_320	;no disc (display)	DC.L  PictT13_320	;no drive (display)	DC.L  PictT14_320	;no audio (display)	ENDP*===============================================**             Draw the NDA Window	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawWin  DrawWin	PROC	IMPORT  DrawText	IMPORT  DrawButtons	IMPORT  DrawIcon	IMPORT  DrawApple	IMPORT  DrawColon	IMPORT  DrawText		PushWord	_GetMasterSCB		;check for 320 mode	pla	and  #$0080	sta  DisplayMode	beq  mode320mode640			;set 640 mode values	lda  #RectTbl1	sta  RectTblPtr	lda  #^RectTbl1	sta  RectTblPtr+2	lda  #IconRect	sta  IconRectPtr	lda  #^IconRect	sta  IconRectPtr+2	PushLong #DispRect	;display's frame rect	PushWord #28		;oval width	PushWord #11		;oval height	PushLong #DispRect	;erase part of it	PushWord #28	PushWord #11	PushLong #DSRect	;drop-shadow rect	PushWord #28		;oval width	PushWord #11		;oval height	PushLong #WinRect	PushWord #2		;pen width	PushWord #1		;pen height	PushLong #Pattern2	PushWord #colorWin	PushWord #colorOut	PushWord #colorTxt	bra  setmode320			;set 320 mode values	lda  #Rect320Tbl1	sta  RectTblPtr	lda  #^Rect320Tbl1	sta  RectTblPtr+2	lda  #IconRect320	sta  IconRectPtr	lda  #^IconRect320	sta  IconRectPtr+2	PushLong #DispRect320	;display's frame rect	PushWord #28/2		;oval width	PushWord #11		;oval height	PushLong #DispRect320	;erase part of it	PushWord #28/2	PushWord #11	PushLong #DSRect320	;drop-shadow rect	PushWord #28/2		;oval width	PushWord #11		;oval height	PushLong #WinRect320	PushWord #1		;pen width	PushWord #1		;pen height	PushLong #Pattern2	PushWord #colorWin	PushWord #colorOut320	PushWord #colorTxt320set	_SetForeColor	_SetSolidPenPat	_SetBackColor	_SetBackPat	_SetPenSize	_EraseRect		;make content region black		_PaintRRect		;display's drop-shadow	_EraseRRect	_FrameRRect		;display's frame	lda  #0		;draw button strings@loop	pha	jsr  DrawText	pla	inc  A	cmp  #10	bcc  @loop	jsr  DrawButtons	;draw the buttons	lda  #0	jsr  DrawIcon		;draw disc icon	jsr  DrawApple		;Apple picture	jsr  DrawColon		;draw time colon	lda  #10	jsr  DrawText		;draw time display text	rts	ENDP	*===============================================**             Draw the About Window	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawAbout DrawAbout	PROC	lda  #4		;draw 5 stringsloop	pha	bne  cont		;(title is  bold)	PushWord #1		;bold	_SetTextFace	lda  1,scont	asl  A	asl  A		;(4 byte pointers)	tax	phx	PushWord #0		;space for width value	PushLong AStrPtr,x	_StringWidth	PullWord Width	lda  DisplayMode	beq  do320	lda  #dhW2	bra  cont2do320	lda  #dhW2_320cont2	sec	sbc  Width	lsr  A	plx	sta  StrPoint+2,x	;center string in window	PushLong AStrPtr,x	PushLong StrPoint,x	_MoveTo	_DrawString	pla	dec  A	bpl  loop	PushLong #PictInfo	;draw About picture	PushLong #PictRect	PushLong PictYX	PushWord #$0000	_PPToPort	PushWord #2		;pen width	PushWord #1		;pen height	_SetPenSize	rtsPictInfo	DC.W  $0080		;port SCB	DC.L  PictAbout		;picture ptr	DC.W  7		;picture width (bytes)PictRect	DC.W  0,0,dvR,dhR	;bounds rectPictYX	DC.W  10,40		;coordinatesWidth	DS.B  2DiscRect	DC.W  10,228,10+20,228+50	;bounds rect	ENDP		*===============================================**             Draw Time Display (00:00)	**			** INPUT:	min (X-Reg), sec (A-Reg)	**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawTime DrawTime	PROC	PushLong #0		;working space	PushLong #0	phx		;X-reg has MIN	pha		;A-reg has SEC	and  #$000F		;get 1st SEC digit	cmp  #$000A	bcc  ok1	lda  #$0000ok1	asl  A	asl  A		;A*4	sta  5,s		;save offset	pla	and  #$00F0		;get 2nd SEC digit	cmp  #$00A0	bcc  ok2	lda  #$0000ok2	lsr  A	lsr  A		;(A/16)*4	sta  5,s		;save offset	lda  1,s	and  #$000F		;get 1st MIN digit	cmp  #$000A	bcc  ok3	lda  #$0000ok3	asl  A	asl  A		;A*4	sta  7,s		;save offset	pla	and  #$00F0		;get 2nd MIN digit	cmp  #$00A0	bcc  ok4	lda  #$0000ok4	lsr  A	lsr  A		;(A/16)*4	sta  7,s		;save offset	lda  DisplayMode	beq  do320a	lda  #$0080	sta  LocInfoS		;port SCB	lda  #dhPS	sta  PictRectS+6	;horizontal width	bra  drawItdo320a	lda  #$0000	sta  LocInfoS		;port SCB	lda  #dhPS/2	sta  PictRectS+6	;horizontal widthdrawIt	ldy  #6loop	plx		;get offset	phy		;save for next pass	lda  PictMapS+2,x	;get ptr to image	sta  PictPtrS+2	lda  PictMapS,x	sta  PictPtrS	PushLong #LocInfoS	PushLong #PictRectS	lda  DisplayMode	beq  do320b	lda  PictX,y	bra  contdo320b	lda  PictX320,ycont	pha	PushWord PictY,y	PushWord #penMode	_PPToPort		;draw digit	ply	dey	dey	bpl  loop	rtsPictX	DC.W  h5		;picture coordinates	DC.W  h5+dhN	DC.W  h5+5+2*dhN	DC.W  h5+5+3*dhNPictX320	DC.W  h5/2	DC.W  (h5+dhN)/2	DC.W  (h5+5+2*dhN)/2	DC.W  (h5+5+3*dhN)/2PictY	DC.W  v2+9	DC.W  v2+9	DC.W  v2+9	DC.W  v2+9	ENDP	*===============================================**             Draw Time Display Colon (:)	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawColon DrawColon	PROC	lda  DisplayMode	beq  do320	lda  #$0080	sta  LocInfoC		;port SCB	lda  #dhC	sta  PictRectC+6	;horizontal width	lda  #pictCX	sta  PictPoint+2	bra  drawItdo320	lda  #$0000	sta  LocInfoC		;port SCB	lda  #dhC/2	sta  PictRectC+6	;horizontal width	lda  #pictCX/2+1	sta  PictPoint+2drawIt	lda  #pictCY	sta  PictPoint	PushLong #LocInfoC	PushLong #PictRectC	PushLong PictPoint	PushWord #penMode	_PPToPort	rts	ENDP	*===============================================**              Draw Track Display	**			** INPUT:	track (A-Reg)		**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawTrack  DrawTrack	PROC	pha	and  #$000F		;get 1st digit	cmp  #$000A	bcs  digit2		;bad digit!	asl  A	asl  A		;A*4	tax	lda  DisplayMode	beq  do320a	lda  #$0080	sta  LocInfoL		;port SCB	lda  #dhPL	sta  PictRectL+6	;horizontal width	lda  #pictX2L	sta  PictPoint+2	bra  pp1do320a	lda  #$0000	sta  LocInfoL		;port SCB	lda  #dhPL/2	sta  PictRectL+6	;horizontal width	lda  #pictX2L/2	sta  PictPoint+2pp1	lda  #pictY2L	sta  PictPoint	lda  PictMapL+2,x	sta  PictPtrL+2	lda  PictMapL,x	sta  PictPtrL	PushLong #LocInfoL	PushLong #PictRectL	PushLong PictPoint	PushWord #penMode	_PPToPort		;draw digit 1digit2	pla	and  #$00F0		;get 2nd digit	cmp  #$00A0	bcs  exit		;bad digit!	lsr  A	lsr  A		;(A/16)*4	tax	lda  DisplayMode	beq  do320b	lda  #pictX1L	sta  PictPoint+2	bra  pp2do320b	lda  #pictX1L/2	sta  PictPoint+2pp2	lda  #pictY1L	sta  PictPoint	lda  PictMapL+2,x	sta  PictPtrL+2	lda  PictMapL,x	sta  PictPtrL	PushLong #LocInfoL	PushLong #PictRectL	PushLong PictPoint	PushWord #penMode	_PPToPort		;draw digit 2exit	rts	ENDP	*===============================================**          Draw Buttons/Draw Button	**			** INPUT:	buttonNum (A-Reg)	**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawButtons DrawButtons	PROC		;draw buttons	ldy  #nButton-1		;number of labels@loop	phy	tya	jsr  DrawButton	ply	dey	bpl  @loop	rts	EXPORT DrawButton	ENTRY  DrawButtonDrawButton	pha	and  #$8000	sta  PictMode		;$8000=inverse, $0000=normal	pla	and  #$00FF	cmp  #nButton	bcc  okay	brl  exit		;out of rangeokay	asl  A	asl  A	tax	phx		;save for paint	lda  PictMode	bmi  invert	lda  DisplayMode	beq  draw320draw640	PushLong RectTbl1,x	;button frame parameters	PushWord #dhO	PushWord #dvO		PushLong RectTbl1,x	;erase parameters	PushWord #dhO	PushWord #dvO	PushLong RectTbl2,x	;drop shadow parameters	PushWord #dhO	PushWord #dvO	PushLong #GrayPattern	bra  drawItdraw320	PushLong Rect320Tbl1,x	;button frame parameters	PushWord #dhO/2	PushWord #dvO	PushLong Rect320Tbl1,x	;erase parameters	PushWord #dhO/2	PushWord #dvO	PushLong Rect320Tbl2,x	;drop shadow parameters	PushWord #dhO/2	PushWord #dvO	PushLong #GrayPattern320drawIt		_FillRRect		;draw drop-shadow	_EraseRRect		;erase part of it	_FrameRRect		;draw frame	bra  paintinvert		lda  DisplayMode	beq  invert320	PushLong RectTbl3,x	;draw parameters	PushWord #dhO	PushWord #dvO	PushLong RectTbl1,x	;erase parameters	PushWord #dhO	PushWord #dvO	bra  invertItinvert320	PushLong Rect320Tbl3,x	;draw parameters	PushWord #dhO/2	PushWord #dvO	PushLong Rect320Tbl1,x	;erase parameters	PushWord #dhO/2	PushWord #dvOinvertIt	_EraseRRect		;erase button & shadow	_PaintRRect		;draw inverted buttonpaint		plx	lda  PictMapB+2,x	;get ptr to image	sta  PictPtrB+2	lda  PictMapB,x	sta  PictPtrB	txa	lsr  a		;word table	tax	lda  PictY,x		;get position	tay	lda  PictX,x	tax	lda  PictMode	bpl  paint2	inx		;shift it down	inx	inypaint2	lda  DisplayMode	beq  paint320	lda  #$0080	sta  LocInfoB		;port SCB	lda  #dhL	sta  PictRectB+6	;horizontal width	bra  paint3paint320	lda  #$0000	sta  LocInfoB		;port SCB	lda  #dhL/2	sta  PictRectB+6	;horizontal width	txa	lsr  a		;half	taxpaint3	PushLong #LocInfoB	PushLong #PictRectB	phx	phy	PushWord PictMode	_PPToPort		;draw image on buttonexit	rts	EXPORT SetRepL	ENTRY  SetRepLSetRepL	cmp  #1	beq  repeat	lda  #PictB10a		;repeat off	ldx  #^PictB10a	bra  endFliprepeat	lda  #PictB10b	;repeat on	ldx  #^PictB10bendFlip	sta  RepPtr	stx  RepPtr+2	rts	EXPORT SetRndL	ENTRY  SetRndLSetRndL	cmp  #1	beq  random	lda  #PictB12a		;random off	ldx  #^PictB12a	bra  endRndrandom	lda  #PictB12b		;random on	ldx  #^PictB12bendRnd	sta  RndPtr	stx  RndPtr+2	rts	EXPORT SetLAudL	ENTRY  SetLAudLSetLAudL	and  #$8000	beq  leftOff	lda  #PictB8a		;left on	ldx  #^PictB8a	bra  endLeftleftOff	lda  #PictB8b		;left off	ldx  #^PictB8bendLeft	sta  AudLPtr	stx  AudLPtr+2	rts	EXPORT SetRAudL	ENTRY  SetRAudLSetRAudL	and  #$4000	beq  rightOff	lda  #PictB9a		;right on	ldx  #^PictB9a	bra  endRightrightOff	lda  #PictB9b		;right off	ldx  #^PictB9bendRight	sta  AudRPtr	stx  AudRPtr+2	rts	EXPORT SetABL	ENTRY  SetABLSetABL	cmp  #1	beq  setA	cmp  #2	beq  setB	cmp  #4	beq  setOn	lda  #PictB11a		;AB	ldx  #^PictB11a	bra  endABsetA	lda  #PictB11b		;A ?	ldx  #^PictB11b	bra  endABsetB	lda  #PictB11c		;B ?	ldx  #^PictB11c	bra  endABsetOn	lda  #PictB11d		;A->B	ldx  #^PictB11dendAB	sta  ABPtr	stx  ABPtr+2	rtsPictX	DC.W  h1+11		;stop	DC.W  h2+11		;play	DC.W  h3+11		;pause	DC.W  h4+11		;eject	DC.W  h1+11		;track	DC.W  h2+11	DC.W  h3+11		;scan	DC.W  h4+11	DC.W  h1+11		;audio	DC.W  h2+11	DC.W  h3+11		;repeat	DC.W  h4+10		;AB	DC.W  h1+10		;shuffle	DC.W  h2+11		;timePictY	DC.W  v1+2		;stop	DC.W  v1+2		;play	DC.W  v1+2		;pause	DC.W  v1+2		;eject	DC.W  v3+2		;track	DC.W  v3+2	DC.W  v3+2		;scan	DC.W  v3+2	DC.W  v4+2		;audio	DC.W  v4+2	DC.W  v4+2		;repeat	DC.W  v4+2		;AB	DC.W  v5+2		;shuffle	DC.W  v5+2		;timePictMode	DS.B  2	ENDP	*===============================================**            Draw Text (bit image)	**			** INPUT:	textNum (A-Reg)		**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawText DrawText	PROC	cmp  #nText+1	bcs  exit		;out of range	asl  a	tax		;(word table)	lda  PictWdth,x	sta  PictByteT		;width in bytes	asl  A	asl  A	sta  PictRectT+6	;width in pixels	lda  PictY,x		;window position	sta  PictPoint	lda  PictX,x	sta  PictPoint+2	txa	asl  a	tax		;(long table)	lda  DisplayMode	beq  do320	lda  #$0080	sta  LocInfoT		;port SCB	lda  PictMapT,x	sta  PictPtrT		;pointer to image	lda  PictMapT+2,x	sta  PictPtrT+2	bra  contdo320	lda  #$0000	sta  LocInfoT		;port SCB	lsr  PictRectT+6	;half hort. width	lsr  PictPoint+2	;half hort. position	lda  PictMapT_320,x	sta  PictPtrT		;pointer to image	lda  PictMapT_320+2,x	sta  PictPtrT+2cont	PushLong #LocInfoT	PushLong #PictRectT	PushLong PictPoint	PushWord #$0000		;copy to dest	_PPToPort		;draw text imageexit	rts	EXPORT DrawMode	ENTRY  DrawModeDrawMode	clc	adc  #13		;mapping	jmp  DrawTextPictWdth	DC.W  13,13,13,10	;bytes per line	DC.W  10,8,9,12	DC.W  13,8,8,17	DC.W  17,13,13,13	DC.W  13,13,13PictX	DC.W  h1+dhB/2-tw0	;stop	DC.W  h2+dhB/2-tw1	;play	DC.W  h3+dhB/2-tw2	;pause	DC.W  h4+dhB/2-tw3	;eject	DC.W  h1+dhB+dhS/2-tw4	;track	DC.W  h3+dhB+dhS/2-tw5	;scan	DC.W  h1+dhB+dhS/2-tw6	;audio	DC.W  h3+dhB+dhS/2-tw7	;repeat	DC.W  h1+dhB/2-tw8	;shuffle	DC.W  h2+dhB/2-tw9	;time	DC.W  h5-4-32		;time (display)	DC.W  h5-4-68		;elapsed (display)	DC.W  h5-4-68		;remaining (display)	DC.W  h5		;stop (display)	DC.W  h5		;play (display)	DC.W  h5		;pause (display)	DC.W  h5		;no disc (display)	DC.W  h5		;no drive (display)	DC.W  h5		;no audio (display)PictY	DC.W  v1-7		;stop	DC.W  v1-7		;play	DC.W  v1-7		;pause	DC.W  v1-7		;eject	DC.W  v3-7		;track	DC.W  v3-7		;scan	DC.W  v4-7		;audio	DC.W  v4-7		;repeat	DC.W  v5-7		;shuffle	DC.W  v5-7		;time	DC.W  v2+9		;time (display)	DC.W  v2+15		;elapsed (display)	DC.W  v2+15		;remaining (display)	DC.W  v2+2		;stop (display)	DC.W  v2+2		;play (display)	DC.W  v2+2		;pause (display)	DC.W  v2+2		;no disc (display)	DC.W  v2+2		;no drive (display)	DC.W  v2+2		;no audio (display)	ENDP	*===============================================**               Draw disc Icon		**			** INPUT:	mode (A-Reg) $8000 = inverse	**	             $0000 = normal	**			** OUTPUT:	none		**			**===============================================*	EXPORT  DrawIcon DrawIcon	PROC	sta  PictMode		;$8000=inverse, $0000=normal	lda  DisplayMode	beq  do320	lda  #$0080	sta  LocInfoI		;port SCB	lda  #dhI	sta  PictRectI+6	;horizontal width	lda  #h6	sta  PictPoint+2	bra  contdo320	lda  #$0000	sta  LocInfoI		;port SCB	lda  #dhI/2	sta  PictRectI+6	;horizontal width	lda  #h6/2	sta  PictPoint+2cont	lda  #v6	sta  PictPoint	PushLong #LocInfoI	PushLong #PictRectI	PushLong PictPoint	PushWord PictMode	_PPToPort		;draw image	rts	ENDP	*===============================================**               Draw Apple Picture	**			** INPUT:	none		**			** OUTPUT:	none		**			**===============================================*DrawApple	PROC	lda  DisplayMode	beq  do320	lda  #$0080	sta  LocInfoA		;port SCB	lda  #dhA	sta  PictRectA+6	;horizontal width	lda  #h1	sta  PictPoint+2	lda  #^PictApple	;get ptr to image	sta  PictPtrA+2	lda  #PictApple	sta  PictPtrA	bra  contdo320	lda  #$0000	sta  LocInfoA		;port SCB	lda  #dhA/2	sta  PictRectA+6	;horizontal width	lda  #h1/2	sta  PictPoint+2	lda  #^PictApple_320	;get ptr to image	sta  PictPtrA+2	lda  #PictApple_320	sta  PictPtrAcont	lda  #dvW1-4-dvA	sta  PictPoint	PushLong #LocInfoA	PushLong #PictRectA	PushLong PictPoint	PushWord #$0000	_PPToPort	rts	ENDP	;---------------------------------------	END	