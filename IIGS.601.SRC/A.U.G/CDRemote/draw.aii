	ENTRY  PictRectL	ENTRY  LocInfoS	ENTRY  PictPtrS	ENTRY  PictRectS	ENTRY  LocInfoB	ENTRY  PictPtrB	ENTRY  PictRectB	ENTRY  LocInfoT	ENTRY  PictByteT	ENTRY  PictPtrT	ENTRY  PictRectT	ENTRY  LocInfoC	ENTRY  PictRectC	ENTRY  LocInfoI	ENTRY  PictRectI	ENTRY  LocInfoA	ENTRY  PictPtrA	ENTRY  PictRectA	ENTRY  PictPoint	ENTRY  PictMode		EXPORT  RectTblPtr	EXPORT  IconRectPtr	DisplayMode	DC.W  $0080		;$80 = 640, $00 = 320	BRect0	DC.W  v1,h1,v1+dvB,h1+dhB	;StopBRect1	DC.W  v1,h2,v1+dvB,h2+dhB	;PlayBRect2	DC.W  v1,h3,v1+dvB,h3+dhB	;PauseBRect3	DC.W  v1,h4,v1+dvB,h4+dhB	;EjectBRect4	DC.W  v3,h1,v3+dvB,h1+dhB	;Skip RevBRect5	DC.W  v3,h2,v3+dvB,h2+dhB	;Skip FwdBRect6	DC.W  v3,h3,v3+dvB,h3+dhB	;Scan RevBRect7	DC.W  v3,h4,v3+dvB,h4+dhB	;Scan FwdBRect8	DC.W  v4,h1,v4+dvB,h1+dhB	;Audio RightBRect9	DC.W  v4,h2,v4+dvB,h2+dhB	;Audio LeftBRect10	DC.W  v4,h3,v4+dvB,h3+dhB	;RepeatBRect11	DC.W  v4,h4,v4+dvB,h4+dhB	;AB RepeatBRect12	DC.W  v5,h1,v5+dvB,h1+dhB	;ShuffleBRect13	DC.W  v5,h2,v5+dvB,h2+dhB	;TimeIRect0	DC.W  v1+1,h1+2,v1+1+dvB,h1+2+dhB  ;StopIRect1	DC.W  v1+1,h2+2,v1+1+dvB,h2+2+dhB  ;PlayIRect2	DC.W  v1+1,h3+2,v1+1+dvB,h3+2+dhB  ;PauseIRect3	DC.W  v1+1,h4+2,v1+1+dvB,h4+2+dhB  ;EjectIRect4	DC.W  v3+1,h1+2,v3+1+dvB,h1+2+dhB  ;Skip RevIRect5	DC.W  v3+1,h2+2,v3+1+dvB,h2+2+dhB  ;Skip FwdIRect6	DC.W  v3+1,h3+2,v3+1+dvB,h3+2+dhB  ;Scan RevIRect7	DC.W  v3+1,h4+2,v3+1+dvB,h4+2+dhB  ;Scan FwdIRect8	DC.W  v4+1,h1+2,v4+1+dvB,h1+2+dhB  ;Audio RightIRect9	DC.W  v4+1,h2+2,v4+1+dvB,h2+2+dhB  ;Audio LeftIRect10	DC.W  v4+1,h3+2,v4+1+dvB,h3+2+dhB  ;RepeatIRect11	DC.W  v4+1,h4+2,v4+1+dvB,h4+2+dhB  ;AB RepeatIRect12	DC.W  v5+1,h1+2,v5+1+dvB,h1+2+dhB  ;ShuffleIRect13	DC.W  v5+1,h2+2,v5+1+dvB,h2+2+dhB  ;TimeSRect0	DC.W  v1A,h1A,v1A+dvB,h1A+dhB	;StopSRect1	DC.W  v1A,h2A,v1A+dvB,h2A+dhB	;PlaySRect2	DC.W  v1A,h3A,v1A+dvB,h3A+dhB	;PauseSRect3	DC.W  v1A,h4A,v1A+dvB,h4A+dhB	;EjectSRect4	DC.W  v3A,h1A,v3A+dvB,h1A+dhB	;Skip RevSRect5	DC.W  v3A,h2A,v3A+dvB,h2A+dhB	;Skip FwdSRect6	DC.W  v3A,h3A,v3A+dvB,h3A+dhB	;Scan RevSRect7	DC.W  v3A,h4A,v3A+dvB,h4A+dhB	;Scan FwdSRect8	DC.W  v4A,h1A,v4A+dvB,h1A+dhB	;Audio RightSRect9	DC.W  v4A,h2A,v4A+dvB,h2A+dhB	;Audio LeftSRect10	DC.W  v4A,h3A,v4A+dvB,h3A+dhB	;RepeatSRect11	DC.W  v4A,h4A,v4A+dvB,h4A+dhB	;AB RepeatSRect12	DC.W  v5A,h1A,v5A+dvB,h1A+dhB	;ShuffleSRect13	DC.W  v5A,h2A,v5A+dvB,h2A+dhB	;TimeRectTbl1	DC.L  BRect0		;stop	DC.L  BRect1		;play	DC.L  BRect2		;pause	DC.L  BRect3		;eject	DC.L  BRect4		;skip L	DC.L  BRect5		;skip R	DC.L  BRect6		;scan L	DC.L  BRect7		;scan R	DC.L  BRect8		;audio L	DC.L  BRect9		;audio R	DC.L  BRect10		;repeat	DC.L  BRect11		;AB	DC.L  BRect12		;shuffle	DC.L  BRect13		;time	RectTbl2	DC.L  SRect0		;stop	DC.L  SRect1		;play	DC.L  SRect2		;pause	DC.L  SRect3		;eject	DC.L  SRect4		;skip L	DC.L  SRect5		;skip R	DC.L  SRect6		;scan L	DC.L  SRect7		;scan R	DC.L  SRect8		;audio L	DC.L  SRect9		;audio R	DC.L  SRect10		;repeat	DC.L  SRect11		;AB	DC.L  SRect12		;shuffle	DC.L  SRect13		;time	RectTbl3	DC.L  IRect0		;stop	DC.L  IRect1		;play	DC.L  IRect2		;pause	DC.L  IRect3		;eject	DC.L  IRect4		;skip L	DC.L  IRect5		;skip R	DC.L  IRect6		;scan L	DC.L  IRect7		;scan R	DC.L  IRect8		;audio L	DC.L  IRect9		;audio R	DC.L  IRect10		;repeat	DC.L  IRect11		;AB	DC.L  IRect12		;shuffle	DC.L  IRect13		;time	*-------- 320 mode button rectangles ------------B320Rect0	DC.W  v1,h1/2,v1+dvB,(h1+dhB)/2  ;StopB320Rect1	DC.W  v1,h2/2,v1+dvB,(h2+dhB)/2  ;PlayB320Rect2	DC.W  v1,h3/2,v1+dvB,(h3+dhB)/2  ;PauseB320Rect3	DC.W  v1,h4/2,v1+dvB,(h4+dhB)/2  ;EjectB320Rect4	DC.W  v3,h1/2,v3+dvB,(h1+dhB)/2  ;Skip RevB320Rect5	DC.W  v3,h2/2,v3+dvB,(h2+dhB)/2  ;Skip FwdB320Rect6	DC.W  v3,h3/2,v3+dvB,(h3+dhB)/2  ;Scan RevB320Rect7	DC.W  v3,h4/2,v3+dvB,(h4+dhB)/2  ;Scan FwdB320Rect8	DC.W  v4,h1/2,v4+dvB,(h1+dhB)/2  ;Audio RightB320Rect9	DC.W  v4,h2/2,v4+dvB,(h2+dhB)/2  ;Audio LeftB320Rect10	DC.W  v4,h3/2,v4+dvB,(h3+dhB)/2  ;RepeatB320Rect11	DC.W  v4,h4/2,v4+dvB,(h4+dhB)/2  ;AB RepeatB320Rect12	DC.W  v5,h1/2,v5+dvB,(h1+dhB)/2  ;ShuffleB320Rect13	DC.W  v5,h2/2,v5+dvB,(h2+dhB)/2  ;TimeI320Rect0	DC.W  v1+1,(h1+2)/2,v1+1+dvB,(h1+2+dhB)/2  ;StopI320Rect1	DC.W  v1+1,(h2+2)/2,v1+1+dvB,(h2+2+dhB)/2  ;PlayI320Rect2	DC.W  v1+1,(h3+2)/2,v1+1+dvB,(h3+2+dhB)/2  ;PauseI320Rect3	DC.W  v1+1,(h4+2)/2,v1+1+dvB,(h4+2+dhB)/2  ;EjectI320Rect4	DC.W  v3+1,(h1+2)/2,v3+1+dvB,(h1+2+dhB)/2  ;Skip RevI320Rect5	DC.W  v3+1,(h2+2)/2,v3+1+dvB,(h2+2+dhB)/2  ;Skip FwdI320Rect6	DC.W  v3+1,(h3+2)/2,v3+1+dvB,(h3+2+dhB)/2  ;Scan RevI320Rect7	DC.W  v3+1,(h4+2)/2,v3+1+dvB,(h4+2+dhB)/2  ;Scan FwdI320Rect8	DC.W  v4+1,(h1+2)/2,v4+1+dvB,(h1+2+dhB)/2  ;Audio RightI320Rect9	DC.W  v4+1,(h2+2)/2,v4+1+dvB,(h2+2+dhB)/2  ;Audio LeftI320Rect10	DC.W  v4+1,(h3+2)/2,v4+1+dvB,(h3+2+dhB)/2  ;RepeatI320Rect11	DC.W  v4+1,(h4+2)/2,v4+1+dvB,(h4+2+dhB)/2  ;AB RepeatI320Rect12	DC.W  v5+1,(h1+2)/2,v5+1+dvB,(h1+2+dhB)/2  ;ShuffleI320Rect13	DC.W  v5+1,(h2+2)/2,v5+1+dvB,(h2+2+dhB)/2  ;TimeS320Rect0	DC.W  v1A,h1A/2,v1A+dvB,(h1A+dhB)/2  ;StopS320Rect1	DC.W  v1A,h2A/2,v1A+dvB,(h2A+dhB)/2  ;PlayS320Rect2	DC.W  v1A,h3A/2,v1A+dvB,(h3A+dhB)/2  ;PauseS320Rect3	DC.W  v1A,h4A/2,v1A+dvB,(h4A+dhB)/2  ;EjectS320Rect4	DC.W  v3A,h1A/2,v3A+dvB,(h1A+dhB)/2  ;Skip RevS320Rect5	DC.W  v3A,h2A/2,v3A+dvB,(h2A+dhB)/2  ;Skip FwdS320Rect6	DC.W  v3A,h3A/2,v3A+dvB,(h3A+dhB)/2  ;Scan RevS320Rect7	DC.W  v3A,h4A/2,v3A+dvB,(h4A+dhB)/2  ;Scan FwdS320Rect8	DC.W  v4A,h1A/2,v4A+dvB,(h1A+dhB)/2  ;Audio RightS320Rect9	DC.W  v4A,h2A/2,v4A+dvB,(h2A+dhB)/2  ;Audio LeftS320Rect10	DC.W  v4A,h3A/2,v4A+dvB,(h3A+dhB)/2  ;RepeatS320Rect11	DC.W  v4A,h4A/2,v4A+dvB,(h4A+dhB)/2  ;AB RepeatS320Rect12	DC.W  v5A,h1A/2,v5A+dvB,(h1A+dhB)/2  ;ShuffleS320Rect13	DC.W  v5A,h2A/2,v5A+dvB,(h2A+dhB)/2  ;TimeRect320Tbl1	DC.L  B320Rect0		;stop	DC.L  B320Rect1		;play	DC.L  B320Rect2		;pause	DC.L  B320Rect3		;eject	DC.L  B320Rect4		;skip L	DC.L  B320Rect5		;skip R	DC.L  B320Re