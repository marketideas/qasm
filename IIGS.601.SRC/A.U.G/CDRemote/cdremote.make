#   File:       CDRemote.make#   Target:     CD.Remote#   Sources:    cdplay.aii draw.aii gsosdriver.aii#   Created:    Thursday, February 18, 1988 8:08:42 AM##	This will build the CDRemote project# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # cdremote.obj	Ä cdremote.equ draw.equ cdremote.aii	AsmIIGS cdremote.aii -o cdremote.objdraw.obj		Ä draw.equ draw.aii	AsmIIGS draw.aii -o draw.objgsosdriver.obj	Ä gsosdriver.aii	AsmIIGS gsosdriver.aii -o gsosdriver.objCDRemote		Ä cdremote.obj draw.obj gsosdriver.obj	LinkIIGS cdremote.obj draw.obj gsosdriver.obj -o CDRemote	SetFile -t 'B8  ' CDRemote