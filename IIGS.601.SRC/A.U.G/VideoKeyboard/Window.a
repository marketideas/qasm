*===============================================**						** File:		Window.a			** Project:	Video Keyboard			** Author:	Don J. Brady			** Build file:	MakeFile			**						** Copyright © Apple Computer, Inc. 1990-1992	** All rights reserved.				**===============================================*		INCLUDE	'M16.Event'		INCLUDE	'M16.QuickDraw'		INCLUDE	'M16.Window'		INCLUDE	'M16.Control'		INCLUDE	'M16.MiscTool'		INCLUDE	'E16.Event'		INCLUDE	'E16.Window'		INCLUDE	'Key.equ'winDY		equ	kbHeight+9		; size of window is based on size of keyboardwinDX		equ	kbWidth+7winY1		equ	200-winDYwinY2		equ	winY1+winDYwinX1		equ	0winX2		equ	winX1+winDXwinDX_320	equ	kbWidth_320+6		; 320 mode keyboard is slightly smallerboxDX		equ	15boxDY		equ	7boxInset	equ	boxDX+10aboutDY		equ	72aboutDX		equ	286+8aboutY1		equ	(200-aboutDY)/2aboutY2		equ	aboutY1+aboutDYaboutX1		equ	(640-aboutDX)/2aboutX2		equ	aboutX1+aboutDXaboutX1_320	equ	(320-aboutDX)/2aboutX2_320	equ	aboutX1_320+aboutDXkY		equ	aboutDY-42		; miny keyboard offsetskX		equ	(aboutDX-120)/2kX_320		equ	(aboutDX-60)/2portSize	EQU	$AA			; Size of GrafPortmode640		equ	$0080		MACRO&lab		_Debugger&lab		lda	>$E0C025		and	#%00000100		; Capslock ?		beq	@skip				brk	$DB@skip		MENDSHADOW		equ	$E1C035			; hardware shadow register (byte)*===============================================**===============================================*WindowData	PROC		ENTRY	kpDeltakpDelta		dc.W	kpWidth + 16;		ENTRY	dragBarRectdragBarRect	dc.W	1, 2, boxDY, winDX-2		ENTRY	closeBoxRectcloseBoxRect	dc.W	0, 9, boxDY, boxDX+9		ENTRY	zoomBoxRectzoomBoxRect	dc.W	0, winDX-boxDX-9, boxDY, winDX-9		ENTRY	zoomBoxRect2zoomBoxRect2	dc.W	0, winDX-boxDX-9, 4, winDX-6-9		ENTRY	localPortRectlocalPortRect	dc.W	0, 0, winDY, winDX		EXPORT	globalPortRectglobalPortRect	dc.W	winY1, winX1, winY2, winX2		ENTRY	aboutWinRectaboutWinRect	dc.W	aboutY1-5,aboutX1-12,aboutY2+5,aboutX2+12		ENTRY	myWinOriginmyWinOrigin	dc.W	winY1,winX1		ENTRY	myWinPtrmyWinPtr	dc.L	0		STRING	PASCAL		ENTRY	winTitlewinTitle	dc.B	'** Windoid **'		ENTRY	aboutWinRgnaboutWinRgn	ds.L	1		ENTRY	windoidRgnwindoidRgn	ds.L	1		ENTRY	tempRgntempRgn		ds.L	1		ENTRY	tempRecttempRect	ds	Rect		ENTRY	deskRgndeskRgn		ds.L	1		ENTRY	visRgnvisRgn		ds.L	1		ENTRY	windoidEventwindoidEvent	ds.W	1		ENTRY	globalPtglobalPt	ds	Point		ENTRY	localPtlocalPt		ds	Point		ENTRY	windoidPortwindoidPort	ds	portSize		ENTRY	tempLocInfotempLocInfo	ds	LocInfo		ENTRY	tempEventtempEvent	ds.B	20		ENTRY	slopRectslopRect	ds	Rect		ENTRY	limitRectlimitRect	ds	Rect		ENTRY	deskRectdeskRect	ds	Rect		ENTRY	dvdv		ds.W	1		ENTRY	dhdh		ds.W	1		ENTRY	oldRgnoldRgn		ds.L	1		ENTRY	dstLocdstLoc		ds	LocInfo		ENTRY	srcLocsrcLoc		ds	LocInfo		ENTRY	dstPtdstPt		ds	Point		ENTRY	tempPttempPt		ds	Point		ENTRY	paramsparams		ds	PaintParam		ENTRY	hilitedhilited		ds.W	1		ENTRY	aboutWinPtraboutWinPtr	ds.L	1		ENTRY	temptemp		ds.L	2			ENTRY	trackingtracking	dc.W	0		ENTRY	zoomedzoomed		dc.W	0		EXPORT	masterSCBmasterSCB	dc.W	$80		STRING	PASCAL		ENTRY	strTitlestrTitle	dc.B	'Video Keyboard'		ENTRY	strAuthorstrAuthor	dc.B	'by Don J. Brady'		ENTRY	strVersionstrVersion	dc.B	'v1.0  '		ENTRY	strCopyrightstrCopyright	dc.B	'Copyright Apple Computer, Inc. 1989-92';		ENTRY	strReserved;strReserved	dc.B	'All rights reserved.'		ENTRY	keyPtkeyPt		dc.W	11,44			; 'V'		dc.W	5,70			; 'I'		dc.W	8,32			; 'D'		dc.W	5,30			; 'E'		dc.W	5,78			; 'O'		dc.W	14,40			; ' '		dc.W	8,72			; 'K'		dc.W	5,30			; 'E'		dc.W	5,54			; 'Y'		dc.W	11,52			; 'B'		dc.W	5,78			; 'O'		dc.W	8,16			; 'A'		dc.W	5,38			; 'R'		dc.W	8,32			; 'D'		ENTRY	strCDAWarningstrCDAWarning	dc.B	'This key sequence will enable the 40/80 column text screen!'		STRING	ASIS		ENTRY	strAlertstrAlert	dc.B	'0yyxxyyxx4~*0~^#1~#0',0		ENTRY	subArraysubArray	dc.L	strCDAWarning		ENTRY	myWinListmyWinList		dc.W	endWinList-myWinList	; record size		dc.W	fMove+fVis		; frame bits		dc.L	winTitle		; ptr to title		dc.L	0			; refCon		dc.W	0,0,0,0			; zoomed rect		dc.L	0			; color table ptr		dc.W	0,0			; origin vert, horz		dc.W	0,0			; data area hight,width		dc.W	0,0			; max content height, width		dc.W	0,0			; pixels to scroll vert, horz		dc.W	0,0			; pixels to page vert, horz		dc.L	0			; info bar string		dc.W	0			; info bar height		dc.L	0			; def proc ptr		dc.L	0			; draw info bar routine		dc.L	0			; draw content routine		dc.W	0,0,0,0			; window position		dc.L	-1			; window plane		dc.L	0			; memory pointerendWinList		EXPORT	grayPatterngrayPattern			dc.W	$3333,$3333,$3333,$3333		dc.W	$3333,$3333,$3333,$3333		dc.W	$3333,$3333,$3333,$3333		dc.W	$3333,$3333,$3333,$3333		EXPORT	grayPattern_320grayPattern_320		dc.W	$EEEE,$EEEE,$EEEE,$EEEE		dc.W	$EEEE,$EEEE,$EEEE,$EEEE		dc.W	$EEEE,$EEEE,$EEEE,$EEEE		dc.W	$EEEE,$EEEE,$EEEE,$EEEE		ENTRY	whitePatternwhitePattern 		dc.W	$FFFF,$FFFF,$FFFF,$FFFF		dc.W	$FFFF,$FFFF,$FFFF,$FFFF		dc.W	$FFFF,$FFFF,$FFFF,$FFFF		dc.W	$FFFF,$FFFF,$FFFF,$FFFF		ENTRY	aboutImageaboutImage					; picture of miny keyboard		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$FF,$FF		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$FF,$FF		dc.B	$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF		dc.B	$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$FF,$0F,$FF,$FF		dc.B	$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF		dc.B	$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$FF,$0F,$FF,$FF		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$FF,$FF		dc.B	$0F,$FF,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F		dc.B	$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$FF		dc.B	$0F,$FF,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F		dc.B	$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$FF		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$FF,$0F,$FF,$FF		dc.B	$0F,$FF,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0		dc.B	$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$FF,$FF,$0F,$FF,$FF		dc.B	$0F,$FF,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0		dc.B	$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$FF,$FF,$0F,$FF,$FF		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$FF,$FF		dc.B	$0F,$FF,$FF,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF		dc.B	$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$FF,$FF,$FF,$0F,$FF,$FF		dc.B	$0F,$FF,$FF,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF		dc.B	$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$F0,$FF,$FF,$FF,$FF,$0F,$FF,$FF		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$FF,$FF		dc.B	$0F,$FF,$0F,$FF,$0F,$FF,$FF,$F0,$FF,$F0,$FF,$FF,$FF,$FF,$FF,$FF		dc.B	$FF,$FF,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$FF		dc.B	$0F,$FF,$0F,$FF,$0F,$FF,$FF,$F0,$FF,$F0,$FF,$FF,$FF,$FF,$FF,$FF		dc.B	$FF,$FF,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$0F,$FF,$FF		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$FF,$FF				ENTRY	aboutLocInfoaboutLocInfo 		dc.W	$80		dc.L	aboutImage		dc.W	32		dc.W	0,0,17,120		ENTRY	ScreenBankScreenBank	DC.W	$E1		ENDP		;--- window routines ---*===============================================** In:	none					**						** Out:	none					**						**===============================================*CreateWindoid	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	DrawWindoid				IMPORT	myWinList:ParamList		IMPORT	globalPortRect:Rect		IMPORT	localPortRect:Rect		IMPORT	dragBarRect:Rect		IMPORT	zoomBoxRect:Rect		IMPORT	zoomBoxRect2:Rect		IMPORT	tempLocInfo:LocInfo		pha		pha		_GetPort			; save original port on stack;--- initialize dummy window's data:		lda	#-8196		sta	myWinList.wPosition.top		sta	myWinList.wPosition.left		lda	#-8192		sta	myWinList.wPosition.bottom		sta	myWinList.wPosition.right				stz	myWinList.wFrameBits		stz	myWinList.wContDefProc		stz	myWinList.wContDefProc+2		stz	myWinList.wPlane		stz	myWinList.wPlane+2;--- create a dummy window for cleanup operations:			pha		pha		pea	myWinList>>16		pea	myWinList		_NewWindow		pla		plx		sta	myWinPtr		stx	myWinPtr+2		phx		pha		_SetSysWindow;--- set up rects, etc:		pha		_GetMasterSCB		pla		sta	masterSCB		and	#mode640		beq	@320@640		lda	#kpWidth+16		sta	kpDelta		lda	globalPortRect.left		clc		adc	#winDX		sta	globalPortRect.right		lda	#winDX		sta	localPortRect.right		lda	#winDX-2		sta	dragBarRect.right		lda	#winDX-9		sta	zoomBoxRect.right		bra	@zoom@320		lda	#kpWidth_320+8		sta	kpDelta		lda	globalPortRect.left		clc		adc	#winDX_320		sta	globalPortRect.right		lda	#winDX_320		sta	localPortRect.right		lda	#winDX_320-2		sta	dragBarRect.right		lda	#winDX_320-9		sta	zoomBoxRect.right@zoom;--- adjust rects for zoomed windoid:		lda	zoomed		beq	@box		lda	zoomBoxRect.right		clc		adc	kpDelta		sta	zoomBoxRect.right		lda	dragBarRect.right		clc		adc	kpDelta		sta	dragBarRect.right		lda	localPortRect.right		clc		adc	kpDelta		sta	localPortRect.right		lda	globalPortRect.right		clc		adc	kpDelta		sta	globalPortRect.right@box		lda	zoomBoxRect.right		sec		sbc	#boxDX		sta	zoomBoxRect.left		sta	zoomBoxRect2.left		clc		adc	#9		sta	zoomBoxRect2.right;--- open a port for our windoid:				pea	windoidPort>>16		pea	windoidPort		_OpenPort		pea	tempLocInfo>>16		pea	tempLocInfo		_GetPortLoc		lda	tempLocInfo.ptrToPixImage+2		and	#$00FF		sta	ScreenBank;--- offset bounds rect so we can use local coordinates:		lda	tempLocInfo.boundsRect.top		sec		sbc	globalPortRect.top		sta	tempLocInfo.boundsRect.top		lda	tempLocInfo.boundsRect.left		sec		sbc	globalPortRect.left		sta	tempLocInfo.boundsRect.left				lda	tempLocInfo.boundsRect.bottom		sec		sbc	globalPortRect.top		sta	tempLocInfo.boundsRect.bottom		lda	tempLocInfo.boundsRect.right		sec		sbc	globalPortRect.left		sta	tempLocInfo.boundsRect.right		pea	tempLocInfo>>16		pea	tempLocInfo		_SetPortLoc		pha		pha		pea	GetDesktop		pea	0		pea	0		_Desktop		pla		plx		sta	tempRgn		stx	tempRgn+2				pha		pha		_GetVisHandle		pla		plx		sta	visRgn		stx	visRgn+2		pha		pha		_NewRgn		pla		plx		sta	windoidRgn		stx	windoidRgn+2		pea	localPortRect>>16		pea	localPortRect		_SetPortRect			; port rect & vis rgn are in local coordinates		lda	windoidRgn+2		pha		lda	windoidRgn		pha		pea	globalPortRect>>16		pea	globalPortRect		_RectRgn		lda	tempRgn+2		pha		lda	tempRgn		pha		lda	windoidRgn+2		pha		lda	windoidRgn		pha		lda	windoidRgn+2		pha		lda	windoidRgn		pha		_SectRgn			; clip our windoid to desktop			lda	windoidRgn+2		pha		lda	windoidRgn		pha		lda	visRgn+2		pha		lda	visRgn		pha		_CopyRgn			; copy our windoid region to port's visRgn		lda	visRgn+2		pha		lda	visRgn		pha		lda	globalPortRect.left		eor	#$FFFF		inc	a		pha		lda	globalPortRect.top		eor	#$FFFF		inc	a		pha		_OffsetRgn			; convert it to global coordinates;--- subtract windoid from the desktop:		pha		phx		pea	FromDesk		; desktop command		lda	windoidRgn+2		pha		lda	windoidRgn		pha		_Desktop		pla				; ignore result		plx			pea	windoidPort>>16		pea	windoidPort		_SetPort			; in case Desktop call changed current port			jsl	DrawWindoidexit		_SetPort			; original port on stack		stz	tracking		;		lda	myWinPtr;		ldx	myWinPtr+2		rtl			ENDP*===============================================** In:	none					**						** Out:	none					**						**===============================================*DestroyWindoid	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	UpdateDesktop				pea	windoidPort>>16		pea	windoidPort		_ClosePort; if screen resolution was changed from 640 to 320,; then my windoidRgn could be too wide.  Therefore; we will clip it before it is added back to the; Desktop if we are in 320 mode. (BRC #75111)		pha		_GetMasterSCB		pla		and	#mode640		bne	@ok			; 640 mode, so skip the clip					pha		pha		_NewRgn				; create a desktop-sized clip region 		pla		plx		sta	tempRgn		stx	tempRgn+2		phx		pha		pea	clipRect>>16		pea	clipRect		_RectRgn		ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		phx		pha		_SectRgn			; clip region to 320 mode desktop		ldx	tempRgn+2		lda	tempRgn		phx		pha		_DisposeRgn@ok		pha		pha		pea	ToDesk		lda	windoidRgn+2		pha		lda	windoidRgn		pha		_Desktop			; add my region back to desktop		pla		plx		lda	windoidRgn		ldx	windoidRgn+2		jsl	UpdateDesktop		; force WM to clean-up my mess		lda	windoidRgn+2		pha		lda	windoidRgn		pha		_DisposeRgn		lda	myWinPtr		ora	myWinPtr+2		beq	exit				lda	myWinPtr+2		pha		lda	myWinPtr		pha		_CloseWindow			; get rid of dummy window				stz	myWinPtr+2		stz	myWinPtrexit		rtlclipRect	DC.W	0,0,200,320		ENDP*===============================================** In:	none					**						** Out:	none					**						**===============================================*DrawWindoid	PROC		LONGA	ON		LONGI	ON				IMPORT	DrawKeyboard				IMPORT	dragBarRect:Rect		pea	localPortRect>>16		pea	localPortRect		_EraseRect;--- simple pen, black and square		pea	0		_SetSolidPenPat		pea	2		pea	1		_SetPenSize			pea	localPortRect>>16		pea	localPortRect		_FrameRect;--- draw the drag bar:		pea	dragBarRect>>16		pea	dragBarRect		pea	grayPattern>>16		lda	masterSCB		and	#mode640		beq	@320		ldx	#grayPattern		bra	@fill@320		ldx	#grayPattern_320@fill		phx		_FillRect		pea	0		ldy	dragBarRect.bottom		dey		phy		_MoveTo		ldy	dragBarRect.bottom		dey		ldx	dragBarRect.right		phx		phy		_LineTo;--- draw the close box:		pea	closeBoxRect>>16		pea	closeBoxRect		_EraseRect		pea	closeBoxRect>>16		pea	closeBoxRect		_FrameRect	;--- draw the zoom box:		pea	zoomBoxRect>>16		pea	zoomBoxRect		_EraseRect		pea	zoomBoxRect>>16		pea	zoomBoxRect		_FrameRect		pea	zoomBoxRect2>>16		pea	zoomBoxRect2		_FrameRect;--- draw the keyboard:		lda	#drawBoard;		ldx	zoomed		beq	@draw		ora	#drawPad@draw		jsl	DrawKeyboard		rtl		ENDP*===============================================** In:	none					**						** Out:	none					**						**===============================================*RedrawWindoid	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	DrawWindoid		IMPORT	DrawKeyCaps		pha		pha		_GetPort			; save result on stack				pea	windoidPort>>16		pea	windoidPort		_SetPort				jsl	DrawKeyCaps		; draw the key caps that changed;		jsl	DrawWindoid		_SetPort			; old port on stack		rtl				ENDP*===============================================** In:	a-reg has event type			**	x-reg has horizontal point		**	y-reg has vertical point		**						** Out:	carry set if it was our event		**						**===============================================*CheckWindoid	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	DrawWindoid		IMPORT	DirtyWindoid		IMPORT	DragWindoid		IMPORT	ZoomWindoid		IMPORT	TrackBox		IMPORT	KillMouseEvent		IMPORT	ReleaseLastKey		IMPORT	NDAClose		IMPORT	TrackKey		IMPORT	CheckKey				IMPORT	globalPt:Point		IMPORT	localPt:Point				phb				phk		plb		sta	windoidEvent		; 0 = nullEvent, 1 = mouseDown, 2 = mouseUp		stx	globalPt.h		stx	localPt.h		sty	globalPt.v		sty	localPt.v		pha		pha		_GetPort			; leave result on stack		pea	windoidPort>>16		pea	windoidPort		_SetPort;--- we need local coordinates:		pea	localPt>>16		pea	localPt		_GlobalToLocal;--- switch on event type:		lda	windoidEvent		cmp	#mouseDownEvt		bne	@up		jsr	_mouseDown		bra	endSwitch@up		cmp	#mouseUpEvt		bne	@other		jsr	_mouseUp		bra	endSwitch@other		jsr	_nullendSwitch		sta	temp		_SetPort			; restore port (original port on stack)				lda	temp			; inform caller if event was ours		cmp	#1		plb		rtl;--- event type routines ---;-----------------------------------------------;;-----------------------------------------------		_null		lda	tracking		beq	@bashed				ldx	localPt.h		ldy	localPt.v		jsl	TrackKey		sta	tracking		bra	@done;--- check if someone bashed us (like AWGS):@bashed		ldx	globalPt.h		ldy	globalPt.v		jsl	DirtyWindoid		bcc	@done;--- we we're bashed, so redraw our windoid:				pea	windoidPort>>16		pea	windoidPort		_SetPort				jsl	DrawWindoid@done		lda	#0		rts;-----------------------------------------------; Out:	a-reg has flag;-----------------------------------------------		_mouseUp		lda	tracking		beq	@done				jsl	KillMouseEvent		jsl	ReleaseLastKey		stz	tracking		lda	#1			; it was our event@done		rts;-----------------------------------------------; Out:	a-reg has flag;-----------------------------------------------		_mouseDown		lda	tracking		beq	@skip				jsl	ReleaseLastKey		stz	tracking@skip;--- was it in our windoid ?		pha		pea	localPt>>16		pea	localPt		pea	localPortRect>>16		pea	localPortRect		_PtInRect		pla		bne	@in		brl	@exit@in				jsl	KillMouseEvent;--- check close box:				pha		pea	localPt>>16		pea	localPt		pea	closeBoxRect>>16		pea	closeBoxRect		_PtInRect		pla		beq	@zoom			; not here, so check zoom box				ldx	localPt.h		ldy	localPt.v		lda	#closeBoxRect		jsl	TrackBox		; track the user		bcc	@done				jsl	NDAClose		bra	@done		@zoom;--- check zoom box:		pha		pea	localPt>>16		pea	localPt		pea	zoomBoxRect>>16		pea	zoomBoxRect		_PtInRect		pla		beq	@drag			; not here, so check drag bar		ldx	localPt.h		ldy	localPt.v		lda	#zoomBoxRect		jsl	TrackBox		; track the user		bcc	@done				lda	zoomed		eor	#$0001		sta	zoomed		jsl	ZoomWindoid		bra	@done@drag;--- check drag bar:		pha		pea	localPt>>16		pea	localPt		pea	dragBarRect>>16		pea	dragBarRect		_PtInRect		pla		beq	@key			; not here, so must be on a 'key'				ldx	globalPt.h		ldy	globalPt.v		jsl	DragWindoid		; track the user's dragging		bra	@done;--- check keyboard:@key		ldx	localPt.h		ldy	localPt.v		jsl	CheckKey		; find out which 'key' was selected		sta	tracking@done		lda	#1			; it was our event@exit		rts*===============================================** In:	x-reg has horizontal point		**	y-reg has vertical point		**						** Out:	none					**						**===============================================*DragWindoid	PROC		LONGA	ON		LONGI	ON				IMPORT	GetDeskRect		IMPORT	UpdateDesktop				IMPORT	tempPt:Point		IMPORT	dstPt:Point		IMPORT	deskRect:Rect		IMPORT	slopRect:Rect		IMPORT	limitRect:Rect		IMPORT	globalPortRect:Rect		IMPORT	params:PaintParam		IMPORT	dstLoc:LocInfo		IMPORT	srcLoc:LocInfo		stx	tempPt.h		sty	tempPt.v		pha		pha		pea	ToDesk		lda	windoidRgn+2		pha		lda	windoidRgn		pha		_Desktop			; add my region back to desktop		pla		plx				pha		pha		_NewRgn		pla		plx		sta	tempRgn		stx	tempRgn+2				pha		pha		pea	GetDesktop		pea	0		pea	0		_Desktop		pla		plx		sta	deskRgn		stx	deskRgn+2				jsl	GetDeskRect		pha		pha		_GetWMgrPort		_SetPort			pea	srcLoc>>16		pea	srcLoc		_GetPortLoc		lda	deskRect.top		sec		sbc	#4		sta	slopRect.top		lda	deskRect.left		sta	slopRect.left		lda	deskRect.bottom		clc		adc	#4		sta	slopRect.bottom		lda	deskRect.right		sta	slopRect.right			lda	deskRect.top		clc		adc	#4		sec		sbc	tempPt.v		sta	limitRect.top		lda	deskRect.left		clc		adc	#16		sec		sbc	tempPt.h		sta	limitRect.left		lda	deskRect.bottom		sec		sbc	#4		sbc	tempPt.v		sta	limitRect.bottom		lda	deskRect.right		sec		sbc	#16		sbc	tempPt.h		sta	limitRect.right			pha		pha		pea	0		pea	0		pea	whitePattern>>16		pea	whitePattern		lda	tempPt.h		pha		lda	tempPt.v		pha		pea	globalPortRect>>16		pea	globalPortRect		pea	limitRect>>16		pea	limitRect		pea	slopRect>>16		pea	slopRect		pea	$0810		_DragRect		pla		plx		sta	dv		stx	dh		ora	dh		bne	change		brl	noChangechange;--- compute bashed rgn of our windoid:		lda	tempRgn+2		pha		lda	tempRgn		pha		pea	globalPortRect>>16		pea	globalPortRect		_RectRgn			; was part off screen ?		lda	tempRgn+2		pha		lda	tempRgn		pha		lda	windoidRgn+2		pha		lda	windoidRgn		pha		lda	tempRgn+2		pha		lda	tempRgn		pha		_DiffRgn		lda	tempRgn+2		pha		lda	tempRgn		pha		lda	globalPortRect.left		eor	#$FFFF		inc	a		pha		lda	globalPortRect.top		eor	#$FFFF		inc	a		pha		_OffsetRgn			; convert to local coordinates		lda	globalPortRect.top		clc		adc	dv		sta	dstPt.v		lda	globalPortRect.left		clc		adc	dh		sta	dstPt.h		lda	#srcLoc		sta	params.ptrToSourceLocInfo		sta	params.ptrToDestLocInfo		lda	#srcLoc>>16		sta	params.ptrToSourceLocInfo+2		sta	params.ptrToDestLocInfo+2				lda	#globalPortRect		sta	params.ptrToSourceRect		lda	#globalPortRect>>16		sta	params.ptrToSourceRect+2		lda	#dstPt		sta	params.ptrToDestPoint		lda	#dstPt>>16		sta	params.ptrToDestPoint+2		stz	params.mode		lda	deskRgn			; clip to desktop rgn		sta	params.maskHandle		lda	deskRgn+2		sta	params.maskHandle+2		pea	params>>16		pea	params		_PaintPixels			; copy pixels over to new position;--- adjust my port's bounds rect:		pea	windoidPort>>16		pea	windoidPort		_SetPort		pea	dstLoc>>16		pea	dstLoc		_GetPortLoc		lda	dstLoc.boundsRect.top		sec		sbc	dv		sta	dstLoc.boundsRect.top		lda	dstLoc.boundsRect.left		sec		sbc	dh		sta	dstLoc.boundsRect.left		lda	dstLoc.boundsRect.bottom		sec		sbc	dv		sta	dstLoc.boundsRect.bottom		lda	dstLoc.boundsRect.right		sec		sbc	dh		sta	dstLoc.boundsRect.right		pea	dstLoc>>16		pea	dstLoc		_SetPortLoc		lda	globalPortRect.top	; adjust my global rect		clc		adc	dv		sta	globalPortRect.top		lda	globalPortRect.left		clc		adc	dh		sta	globalPortRect.left		lda	globalPortRect.bottom		clc		adc	dv		sta	globalPortRect.bottom		lda	globalPortRect.right		clc		adc	dh		sta	globalPortRect.rightnoChange		pha		pha		_NewRgn		pla		plx		sta	oldRgn		stx	oldRgn+2		lda	windoidRgn+2		pha		lda	windoidRgn		pha		lda	oldRgn+2		pha		lda	oldRgn		pha		_CopyRgn			; save copy of old windoid rgn		lda	windoidRgn+2		pha		lda	windoidRgn		pha		pea	globalPortRect>>16		pea	globalPortRect		_RectRgn		ldx	deskRgn+2		lda	deskRgn		phx		pha		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		phx		pha		_SectRgn			; my new windoid rgn			ldx	windoidRgn+2		lda	windoidRgn		phx		pha		ldx	visRgn+2		lda	visRgn		phx		pha		_CopyRgn				ldx	visRgn+2		lda	visRgn		phx		pha		lda	globalPortRect.left		eor	#$FFFF		inc	a		pha		lda	globalPortRect.top		eor	#$FFFF		inc	a		pha		_OffsetRgn		pha		pha		pea	FromDesk		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		_Desktop			; subtract my new region from desktop		pla		plx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		_EmptyRgn		pla		bne	@empty				ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	visRgn+2		lda	visRgn		phx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		_SectRgn		ldx	tempRgn+2		lda	tempRgn		phx		pha		_SetVisHandle		pea	localPortRect>>16		pea	localPortRect		_EraseRect				lda	oldRgn		ldx	oldRgn+2		jsl	UpdateDesktop		; force WM to clean-up my mess		jsl	DrawWindoid		ldx	visRgn+2		lda	visRgn		phx		pha		_SetVisHandle		bra	done@empty		lda	oldRgn		ldx	oldRgn+2		jsl	UpdateDesktop		; just force WM to clean-up my messdone		ldx	oldRgn+2		lda	oldRgn		phx		pha		_DisposeRgn		ldx	tempRgn+2		lda	tempRgn		phx		pha		_DisposeRgn		rtl		ENDP*===============================================*GetDeskRect	PROC		LONGA	ON		LONGI	ON		IMPORT	deskRect:RectrgnPtr		set	1		phd				lda	deskRgn+2		pha		lda	deskRgn		pha		tsc		tcd		ldy	#2			; dereference handle		lda	[<rgnPtr],y		tax		lda	[<rgnPtr]		sta	<rgnPtr		stx	<rgnPtr+2		ldy	#2			; get the region's bounding rect		lda	[<rgnPtr],y		sta	deskRect.top		iny		iny		lda	[<rgnPtr],y		sta	deskRect.left		iny		iny		lda	[<rgnPtr],y		sta	deskRect.bottom		iny		iny		lda	[<rgnPtr],y		sta	deskRect.right				pla		pla		pld		rtl				ENDP*===============================================** In:	none					**						** Out:	none					**						**===============================================*ZoomWindoid	PROC		LONGA	ON		LONGI	ON				IMPORT	UpdateDesktop				IMPORT	zoomBoxRect:Rect		IMPORT	zoomBoxRect2:Rect		IMPORT	dragBarRect:Rect		IMPORT	localPortRect:Rect		IMPORT	globalPortRect:Rect		IMPORT	tempRect:Rect		IMPORT	tempLocInfo:LocInfo				pha		pha		_NewRgn		pla		plx		sta	tempRgn		stx	tempRgn+2		pha		pha		pea	GetDesktop		pea	0		pea	0		_Desktop		pla		plx		sta	deskRgn		stx	deskRgn+2				lda	zoomed		bne	growIt		brl	shrinkItgrowIt;--- show the keypad:			lda	zoomBoxRect.left		clc		adc	kpDelta		sta	zoomBoxRect.left			lda	zoomBoxRect.right		clc		adc	kpDelta		sta	zoomBoxRect.right		lda	zoomBoxRect2.left		clc		adc	kpDelta		sta	zoomBoxRect2.left			lda	zoomBoxRect2.right		clc		adc	kpDelta		sta	zoomBoxRect2.right			lda	dragBarRect.right		clc		adc	kpDelta		sta	dragBarRect.right		lda	localPortRect.right		clc		adc	kpDelta		sta	localPortRect.right		lda	globalPortRect.right		clc		adc	kpDelta		sta	globalPortRect.right		lda	globalPortRect.top	; calc global keypad rect & rgn		sta	tempRect.top		lda	globalPortRect.bottom		sta	tempRect.bottom		lda	globalPortRect.right		sta	tempRect.right		sec		sbc	kpDelta		sta	tempRect.left		ldx	tempRgn+2		lda	tempRgn		phx		pha		pea	tempRect>>16		pea	tempRect		_RectRgn		ldx	deskRgn+2		lda	deskRgn		phx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		phx		pha		_SectRgn		pha		pha		pea	FromDesk		ldx	tempRgn+2		lda	tempRgn		phx		pha		_Desktop			; subtract it from desktop		pla		plx		ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		phx		pha		_UnionRgn			; add it to windoid		ldx	tempRgn+2		lda	tempRgn		phx		pha		lda	globalPortRect.left		eor	#$FFFF		inc	a		pha		lda	globalPortRect.top		eor	#$FFFF		inc	a		pha		_OffsetRgn		ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	visRgn+2		lda	visRgn		phx		pha		phx		pha		_UnionRgn			; add it to visRgn				lda	localPortRect.top	; tempRect <-- area to redraw		sta	tempRect.top		lda	localPortRect.right		sec		sbc	#boxInset+2		sbc	kpDelta		sta	tempRect.left		lda	localPortRect.bottom		sta	tempRect.bottom		lda	localPortRect.right		sta	tempRect.right		brl	done;--- hide the keypad:shrinkIt		lda	zoomBoxRect.left		; adjust the local rects		sec		sbc	kpDelta		sta	zoomBoxRect.left		lda	zoomBoxRect.right		sec		sbc	kpDelta		sta	zoomBoxRect.right		lda	zoomBoxRect2.left		sec		sbc	kpDelta		sta	zoomBoxRect2.left		lda	zoomBoxRect2.right		sec		sbc	kpDelta		sta	zoomBoxRect2.right		lda	dragBarRect.right		sec		sbc	kpDelta		sta	dragBarRect.right		lda	localPortRect.right		sec		sbc	kpDelta		sta	localPortRect.right		lda	globalPortRect.right	; will we be off the screen? 		sec		sbc	kpDelta		bmi	leftSide			cmp	#boxInset		bcs	rightSideleftSide					; anchor leftside when shrinking		lda	globalPortRect.left		clc		adc	kpDelta		sta	globalPortRect.left		pea	windoidPort>>16		pea	windoidPort		_SetPort				pea	tempLocInfo>>16		pea	tempLocInfo		_GetPortLoc				lda	tempLocInfo.boundsRect.left		sec		sbc	kpDelta		sta	tempLocInfo.boundsRect.left		lda	tempLocInfo.boundsRect.right		sec		sbc	kpDelta		sta	tempLocInfo.boundsRect.right		pea	tempLocInfo>>16		pea	tempLocInfo		_SetPortLoc;--- desktop and windoid rgns are ok here					ldx	visRgn+2		lda	visRgn		phx		pha		lda	kpDelta		eor	#$FFFF		inc	a		pha		pea	0		_OffsetRgn			; need to re-compute visRgn		lda	localPortRect.top	; tempRect <-- area to redraw		sta	tempRect.top				lda	localPortRect.right		sec		sbc	globalPortRect.right		sta	tempRect.left			lda	localPortRect.bottom		sta	tempRect.bottom		lda	localPortRect.right		sta	tempRect.right		brl	donerightSide		lda	globalPortRect.top	; calc global keypad rect & rgn		sta	tempRect.top		lda	globalPortRect.right		sec		sbc	kpDelta		sta	tempRect.left		lda	globalPortRect.bottom		sta	tempRect.bottom		lda	globalPortRect.right		sta	tempRect.right		ldx	tempRgn+2		lda	tempRgn		phx		pha		pea	tempRect>>16		pea	tempRect		_RectRgn		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		phx		pha		_SectRgn			; find visible part of it		pha		pha		pea	ToDesk		ldx	tempRgn+2		lda	tempRgn		phx		pha		_Desktop			; add it to the desktop		pla		plx		lda	tempRgn		ldx	tempRgn+2		jsl	UpdateDesktop		; force WM to clean-up my mess		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		_DiffRgn			; subtract it from windoid		ldx	tempRgn+2		lda	tempRgn		phx		pha		lda	globalPortRect.left		eor	#$FFFF		inc	a		pha		lda	globalPortRect.top		eor	#$FFFF		inc	a		pha		_OffsetRgn		ldx	visRgn+2		lda	visRgn		phx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	visRgn+2		lda	visRgn		phx		pha		_DiffRgn			; subtract it from vis rgn					lda	globalPortRect.right		sec		sbc	kpDelta		sta	globalPortRect.right		lda	localPortRect.top	; tempRect <-- area to redraw		sta	tempRect.top		lda	localPortRect.right		sec		sbc	#boxInset		sta	tempRect.left		lda	localPortRect.bottom		sta	tempRect.bottom		lda	localPortRect.right		sta	tempRect.right	done		pea	windoidPort>>16		; adjust my port		pea	windoidPort		_SetPort		pea	localPortRect>>16		pea	localPortRect		_SetPortRect		ldx	tempRgn+2		lda	tempRgn		phx		pha		pea	tempRect>>16		pea	tempRect		_RectRgn		ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	visRgn+2		lda	visRgn		phx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		_SectRgn				ldx	tempRgn+2		lda	tempRgn		phx		pha		_SetVisHandle				jsl	DrawWindoid				ldx	visRgn+2		lda	visRgn		phx		pha		_SetVisHandle		ldx	tempRgn+2		lda	tempRgn		phx		pha		_DisposeRgn		rtl		ENDP*===============================================** In:	a-reg has pointer to box rect 		**	x-reg has horizontal position		**	y-reg has vertical position		**						** Out:	carry set if mouse up occurs inside of	**	box rect				**						**===============================================*TrackBox	PROC		LONGA	ON		LONGI	ON				IMPORT	KillMouseEvent				IMPORT	tempPt:Point				sta	temp			; address of rect		stx	tempPt.h		sty	tempPt.v		pea	WindowData>>16		lda	temp		pha		_InvertRect		lda	#1		sta	hilited	@while		pha		pea	0		_StillDown		pla		beq	@mouseUp		pea	tempPt>>16		pea	tempPt		_GetMouse		pha		pea	tempPt>>16		pea	tempPt		pea	WindowData>>16		lda	temp		pha		_PtInRect		pla		beq	@outside@inside		lda	hilited		bne	@while		pea	WindowData>>16		lda	temp		pha		_InvertRect		inc	hilited		bra	@while@outside		lda	hilited		beq	@while		pea	WindowData>>16		lda	temp		pha		_InvertRect		stz	hilited		bra	@while@mouseUp			jsl	KillMouseEvent		pha		pea	tempPt>>16		pea	tempPt		pea	WindowData>>16		lda	temp		pha		_PtInRect		pla		cmp	#1			; carry set if mouse up occured inside of rect		rtl				ENDP*===============================================** In:	a & x point to region to clean up	**						** Out:	none					**						**===============================================*UpdateDesktop	PROC		LONGA	ON		LONGI	ON		rgn		set	1structRgn	set	rgn+4tmpRgn		set	structRgn+4localSize	set	12		tay				; save a		phd				; make a stack frame		tsc		sec		sbc	#localSize		tcs		tcd				sty	<rgn		stx	<rgn+2		pha		pha		_NewRgn		pla		plx		sta	<tmpRgn		stx	<tmpRgn+2				pha		pha		lda	myWinPtr+2		pha		lda	myWinPtr		pha		_GetStructRgn		pla		plx		sta	<structRgn		stx	<structRgn+2				pei	<structRgn+2		pei	<structRgn		pei	<tmpRgn+2		pei	<tmpRgn		_CopyRgn			; save a copy of stuct rgn		pei	<rgn+2		pei	<rgn		pei	<structRgn+2		pei	<structRgn		_CopyRgn			; now set struct rgn to bashed rgn;--- make my window visible:		pha		lda	myWinPtr+2		pha		lda	myWinPtr		pha		_GetWFrame		pla		ora	#fVis		pha		lda	myWinPtr+2		pha		lda	myWinPtr		pha		_SetWFrame				lda	myWinPtr+2		pha		lda	myWinPtr		pha		_BringToFront				pea	0		lda	myWinPtr+2		pha		lda	myWinPtr		pha		_ShowHide		;		lda	myWinPtr+2;		pha;		lda	myWinPtr;		pha;		pea	(-2)>>16;		pea	(-2);		_SendBehind			pei	<tmpRgn+2		pei	<tmpRgn		pei	<structRgn+2		pei	<structRgn		_CopyRgn			; restore struct rgn			pei	<tmpRgn+2		pei	<tmpRgn		_DisposeRgnexit		tsc		clc		adc	#localSize		tcs		pld		rtl				ENDP*===============================================** Check to see if some BOZO application wrote	** on top of us (i.e. wrote straight to the 	** screen without checking the grafport's visRgn.**						** In:	x-reg has horizontal position 		**	y-reg has vertical position		**						** Out:	carry set if windoid is dirty		**						**===============================================*DirtyWindoid	PROC		LONGA	ON		LONGI	ON				IMPORT	RgnToRect		IMPORT	globalPortRect:Rect		IMPORT	tempRect:Rect			;--- abort check if mouse is down or an event is pending:;    (menus could be selected!)		pha		pea	0		_Button				; is the mouse down?		pla		bne	@clean				pha		pea	$0FFF		pea	tempEvent>>16		pea	tempEvent		_EventAvail			; is there an event pending?		pla@clean		bne	clean			; abort check				ldx	windoidRgn+2		lda	windoidRgn		phx		pha		pea	tempRect>>16		pea	tempRect		jsl	RgnToRect; abort check if screen is in bank 1 AND screen; shadowing is disabled (i.e. CloseView is on!)		lda	ScreenBank		; is the screen in bank 1		cmp	#$00E1		beq	@cont			; no, so continue check				lda	>SHADOW			; load the shadow register		and	#$08			; is  screen shadowing off (bit 3 set)		bne	clean@cont				lda	tempRect.left		and	#$FFFE		sta	temp			; left edge		lda	tempRect.right		sec		sbc	#8		and	#$FFFE		sta	temp+2			; right edge;--- abort check if we'll overlap:				sec		sbc	temp		cmp	#48		bcc	clean		lsr	temp			; 4 bit pixels (320 mode)		lsr	temp+2		lda	masterSCB		and	#mode640		beq	@test		lsr	temp			; 2 bit pixels (640 mode)		lsr	temp+2@test		lda	globalPortRect.top	; test the top line		cmp	tempRect.top		bne	@test2		jsr	TestIt		bcs	dirty		@test2		lda	globalPortRect.bottom	; test the bottom line		cmp	tempRect.bottom		bne	clean		dec	a		jsr	TestIt		bcc	cleandirty		sec		rtl		clean		clc		rtl;-----------------------------------------------TestItsum		set	1Screen		set	$2000			phb				tay		pha				; scratch space		xba		and	#$FF00		lsr	a		sta	sum,s			; sum <-- a * 128		tya		asl	a		asl	a		asl	a		asl	a		asl	a			; a <-- a * 32		adc	sum,s			; a <-- 128a + 32a = 160a		ply;--- if frame ­ 0 (black) then we are dirty:		tax		clc		adc	temp			; add in h1		tay				txa		clc		adc	temp+2			; add in h2		tax						pea	$E1E1		plb		plb		lda	|Screen,y		beq	@or		and	|Screen+8,y		bne	@dirty@or		lda	|Screen,x		beq	@clean		and	|Screen-8,x		beq	@clean@dirty		sec		bra	@exit@clean		clc@exit		plb			rts		ENDP*===============================================** In:	rgn, rectPtr on stack			**						** Out:	none					**						**===============================================*RgnToRect	PROCdSave		set	1			; stack offsetsrtlAddr		set	dSave+2rectPtr		set	rtlAddr+3rgn		set	rectPtr+4		phd				; make a frame		tsc		tcd				ldy	#2		lda	[<rgn],y		tax		lda	[<rgn]		sta	<rgn		stx	<rgn+2				ldy	#2		lda	[<rgn],y		sta	[<rectPtr]		ldy	#4		lda	[<rgn],y		ldy	#2		sta	[<rectPtr],y		ldy	#6		lda	[<rgn],y		ldy	#4		sta	[<rectPtr],y		ldy	#8		lda	[<rgn],y		ldy	#6		sta	[<rectPtr],y				lda	<rtlAddr		sta	<rtlAddr+8		lda	<rtlAddr+1		sta	<rtlAddr+9				pld			tsc		clc		adc	#8		tcs		rtl		ENDP*===============================================** In:	none			 		**						** Out:	none					**						**===============================================*DrawAbout	PROC		LONGA	ON		LONGI	ON				IMPORT	aboutLocInfo:LocInfo		IMPORT	tempRect:Rectframe		RECORD	1			; stack frame offsetsindex		ds.W	1width		ds.W	1spWidth		ds.W	1using640	ds.W	1xPos		ds.W	1lastTick	ds.L	1tickDelay	ds.L	1_lastframeSize	SET	_last-1		ENDRcharCount	SET	14extra		SET	2		WITH	frame		phd				; make a frame		tsc		sec		sbc	#frameSize		tcs		tcd		ldx	aboutWinPtr+2		lda	aboutWinPtr		phx		pha		_BeginUpdate		lda	#36		sta	<spWidth		lda	#6		sta	<width		pha		_GetMasterSCB		pla		sta	aboutLocInfo.portSCB		and	#mode640		beq	@320@640		ldy	#1		ldx	#kX		lda	#120		bra	@set@320		lsr	<spWidth		lsr	<width		ldy	#0		ldx	#kX_320		lda	#60@set		sty	<using640		stx	<xPos		sta	aboutLocInfo.boundsRect.right		pea	aboutLocInfo>>16		pea	aboutLocInfo		pea	aboutLocInfo.boundsRect>>16		pea	aboutLocInfo.boundsRect		phx		pea	kY		pea	0		_PPToPort		lda	aboutLocInfo.boundsRect.right		clc		adc	<xPos		pha		pea	kY+16		_MoveTo		pea	strVersion>>16		pea	strVersion		_DrawString		lda	#strCopyright		ldx	#strCopyright>>16		jsr	CenterString		pha		pea	aboutDY-4		_MoveTo		pea	strCopyright>>16		pea	strCopyright		_DrawString;		lda	#strReserved;		ldx	#strReserved>>16;		jsr	CenterString;		pha;		pea	aboutDY-3;		_MoveTo;		pea	strReserved>>16;		pea	strReserved;		_DrawString;--- type out "VIDEO KEYBOARD" on miny keyboard:		lda	#strTitle		ldx	#strTitle>>16		jsr	CenterString		sec		sbc	#extra*12/2		pha		pea	12		_MoveTo		lda	#32		jsr	Delay				stz	<index@loop						; loop for index = 0 to charCount-1				lda	<index		asl	a		asl	a		tax		lda	keyPt,x			; get Y coordinate		clc		adc	#kY		sta	tempRect.top		adc	#2		sta	tempRect.bottom				lda	keyPt+2,x		; get X coordinate		ldy	<using640		bne	@a		lsr	a@a		clc		adc	<xPos		sta	tempRect.left		clc		adc	<width		sta	tempRect.right				ldx	<index		lda	strTitle+1,x		; is this a ' ' character?		and	#$FF		cmp	#' '		bne	@b		lda	tempRect.left		clc		adc	<spWidth		; yes, so make rect wider		sta	tempRect.right@b		pea	tempRect>>16		pea	tempRect		_InvertRect				ldx	<index		lda	strTitle+1,x		and	#$FF		pha		_DrawChar				jsr	AddExtraSpace		lda	#16		jsr	Delay				pea	tempRect>>16		pea	tempRect		_InvertRect				ldx	<index		inx		stx	<index		cpx	#charCount		bcc	@loop		lda	#strAuthor		ldx	#strAuthor>>16		jsr	CenterString		pha		pea	24		_MoveTo		pea	strAuthor>>16		pea	strAuthor		_DrawString		ldx	aboutWinPtr+2		lda	aboutWinPtr		phx		pha		_EndUpdateexit		tsc		clc		adc	#frameSize		tcs		pld		rtl			rtl;-----------------------------------------------AddExtraSpace		pea	tempPt>>16		; add extra spacing for title		pea	tempPt		_GetPen				lda	tempPt+2		clc		adc	#extra		pha		lda	tempPt		pha		_MoveTo				rts;-----------------------------------------------CenterString		pha		phx		pha		_StringWidth		lda	#aboutDX		sec		sbc	1,s		lsr	a		plx		rts;-----------------------------------------------Delay		sta	<tickDelay			pha		pha		_GetTick		pla		plx		sta	<lastTick		stx	<lastTick+2@wait		pha		pha		_GetTick		pla		sec		sbc	<lastTick		tax		pla		sbc	<lastTick+2				cpx	<tickDelay		sbc	#0		bcc	@wait				rts		ENDP*===============================================** In:	a-reg: 1 = open, 0 = close		**						** Out:	none					**						**===============================================*AboutWindow	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	EnableMouseTrap		IMPORT	DisableMouseTrap		IMPORT	myWinList:ParamList		IMPORT	globalPortRect:Rect		IMPORT	aboutWinRect:Rect					tax		bne	openIt		brl	closeItopenIt;--- initialize window's position:		lda	#aboutY1		sta	myWinList.wPosition.top			lda	#aboutY2		sta	myWinList.wPosition.bottom		lda	#fAlert+fVis		sta	myWinList.wFrameBits		lda	#DrawAbout		sta	myWinList.wContDefProc		lda	#DrawAbout>>16		sta	myWinList.wContDefProc+2		lda	#(-1)		sta	myWinList.wPlane		lda	#(-1)>>16		sta	myWinList.wPlane+2;--- adjust for 320/640 screen:		pha		_GetMasterSCB		pla		and	#mode640		beq	@320@640		lda	#aboutX1		sta	myWinList.wPosition.left		lda	#aboutX2		sta	myWinList.wPosition.right		lda	#aboutX1-12		sta	aboutWinRect.left		lda	#aboutX2+12		sta	aboutWinRect.right		bra	check@320		lda	#aboutX1_320		sta	myWinList.wPosition.left		lda	#aboutX2_320		sta	myWinList.wPosition.right		lda	#aboutX1_320-12		sta	aboutWinRect.left		lda	#aboutX2_320+12		sta	aboutWinRect.rightcheck		lda	myWinPtr		ora	myWinPtr+2		beq	@skip		jsl	DisableMouseTrap;--- find where windoid overlaps:		pha		pha		_NewRgn		pla		plx		sta	aboutWinRgn		stx	aboutWinRgn+2		phx		pha		pea	aboutWinRect>>16		pea	aboutWinRect		_RectRgn		lda	aboutWinRgn		ldx	aboutWinRgn+2		phx		pha		lda	windoidRgn		ldx	windoidRgn+2		phx		pha		lda	aboutWinRgn		ldx	aboutWinRgn+2		phx		pha		_SectRgn			; aboutWinRgn = overlap		pha		pha		pea	ToDesk		lda	aboutWinRgn		ldx	aboutWinRgn+2		phx		pha		_Desktop			; add overlap region to desktop		pla		plx@skip		pha		pha		pea	myWinList>>16		pea	myWinList		_NewWindow			; create the window		pla		plx		sta	aboutWinPtr		stx	aboutWinPtr+2		jsl	DrawAbout		; draw it		brl	done;--- close the About box:closeIt		lda	aboutWinPtr		ora	aboutWinPtr+2		bne	@ok		brl	done@ok		lda	myWinPtr		ora	myWinPtr+2		bne	@overlap		brl	@alone@overlap		pha		pha		pea	FromDesk		ldx	aboutWinRgn+2		lda	aboutWinRgn		phx		pha		_Desktop			; subract overlap region from desktop		pla		plx		ldx	aboutWinPtr+2		lda	aboutWinPtr		phx		pha		_CloseWindow		stz	aboutWinPtr		stz	aboutWinPtr+2		pha		ldx	aboutWinRgn+2		lda	aboutWinRgn		phx		pha		_EmptyRgn		pla		bne	@empty;--- redraw the windoid:		pea	windoidPort>>16		pea	windoidPort		_SetPort		ldx	aboutWinRgn+2		lda	aboutWinRgn		phx		pha		lda	globalPortRect.left		eor	#$FFFF		inc	a		pha		lda	globalPortRect.top		eor	#$FFFF		inc	a		pha		_OffsetRgn		ldx	aboutWinRgn+2		lda	aboutWinRgn		phx		pha		_SetVisHandle		jsl	DrawWindoid		ldx	visRgn+2		lda	visRgn		phx		pha		_SetVisHandle@empty		jsl	EnableMouseTrap		bra	done@alone		ldx	aboutWinPtr+2		lda	aboutWinPtr		phx		pha		_CloseWindow		stz	aboutWinPtr		stz	aboutWinPtr+2done		rtl				ENDP*===============================================** In:	none					**						** Out:	carry set if it is OK to enable CDA	**						**===============================================*OkToUseCDAMenu	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	EnableMouseTrap		IMPORT	DisableMouseTrap		IMPORT	DrawWindoid				IMPORT	aboutWinRect:Rect		IMPORT	globalPortRect:Rect				jsl	DisableMouseTrap		lda	#aboutY1		sta	strAlert+1		lda	#aboutY2		sta	strAlert+5				pha		_GetMasterSCB		pla		and	#mode640		beq	@320@640		lda	#aboutX1		bra	@set@320		lda	#aboutX1_320;@set		tax		sta	strAlert+3		clc		adc	#aboutDX		sta	strAlert+7		adc	#12		sta	aboutWinRect.right		txa		sec		sbc	#12		sta	aboutWinRect.left;--- find where windoid overlaps:		pha		pha		_NewRgn		pla		plx		sta	tempRgn		stx	tempRgn+2		phx		pha		pea	aboutWinRect>>16		pea	aboutWinRect		_RectRgn		ldx	tempRgn+2		lda	tempRgn		phx		pha		ldx	windoidRgn+2		lda	windoidRgn		phx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		_SectRgn			; tempRgn = overlap		pha		pha		pea	ToDesk		ldx	tempRgn+2		lda	tempRgn		phx		pha		_Desktop			; add windoid region to desktop		pla		plx		pha		pea	$0001			; flag = use Pascal sub strings		pea	subArray>>16		pea	subArray		pea	strAlert>>16		pea	strAlert		_AlertWindow			; put up the alert, leave button result on stack;--- button result left on stack!!		pha		pha		pea	FromDesk		ldx	tempRgn+2		lda	tempRgn		phx		pha		_Desktop			; subract windoid region from desktop		pla		plx		pha		ldx	tempRgn+2		lda	tempRgn		phx		pha		_EmptyRgn		pla		bne	@empty			; no overlap, so skip redraw;--- redraw the windoid:		pea	windoidPort>>16		pea	windoidPort		_SetPort		ldx	tempRgn+2		lda	tempRgn		phx		pha		lda	globalPortRect.left		eor	#$FFFF		inc	a		pha		lda	globalPortRect.top		eor	#$FFFF		inc	a		pha		_OffsetRgn		ldx	tempRgn+2		lda	tempRgn		phx		pha		_SetVisHandle		jsl	DrawWindoid		ldx	visRgn+2		lda	visRgn		phx		pha		_SetVisHandle@empty		jsl	EnableMouseTrap;--- return carry set if user selects button #1:		pla				; get button from stack		cmp	#1		beq	exit			; carry set if equal		clc				; not equal, so clear carryexit				rtl				ENDP		END