;_______________________________________________________;; File:		Key.a; Project:	Video Keyboard; Author:	Don J. Brady;; Copyright © Apple Computer, Inc. 1990-1991; All rights reserved.;_______________________________________________________				PRINT	OFF		INCLUDE	'M16.Event'			; toolbox macros		INCLUDE	'M16.QuickDraw'		INCLUDE	'M16.Resources'		INCLUDE	'M16.MiscTool'		INCLUDE	'M16.ADB'		INCLUDE	'E16.Event'			; toolbox equates		INCLUDE	'E16.QuickDraw'		INCLUDE	'E16.MiscTool'		INCLUDE	'E16.ADB'		INCLUDE	'Key.equ'				PRINT	ON		IMPORT	_ownerid			; external data		IMPORT	layouts		IMPORT	KeyData		IMPORT	keyWidths		IMPORT	keyWidths_320		IMPORT	decimalPoints		IMPORT	modState		IMPORT	keyWidth		IMPORT	keyWidthReturn		IMPORT	keyWidthESC		IMPORT	use640		IMPORT	start		IMPORT	end		IMPORT	temp		IMPORT	currentKey		IMPORT	newTime		IMPORT	oldTime		IMPORT	dblTime		IMPORT	modKeys		IMPORT	ADBFinished		IMPORT	GetMouseTime			; external routines		IMPORT	KillMouseEvent		IMPORT	OkToUseCDAMenu		ENTRY	MakeIndex			; forward referenced routines		ENTRY	DrawKeyLegends		ENTRY	InvertKey		ENTRY	SelectKey		ENTRY	ReleaseKey		ENTRY	PostKey		;_______________________________________________________; In:	none;; Out:	none;;_______________________________________________________KeyStartUp	PROC	EXPORT		LONGA	ON		LONGI	ON		StackFrame	RECORD	1,INCRindex		DS.W	1			; local variablessum		DS.W	1lastRow		DS.W	1hStart		DS.W	1kTransID	DS.W	1tempID		DS.W	1language	DS.W	1kTransRef	DS.L	1kTransArray	DS.L	1langMap		DS.L	1doKeyTrans	DS.W	1keyWidthsPtr	DS.L	1_localSize	EQU	*-1dSave		DS.W	1rtlAddr		DS.B	3_paramBegin	EQU	*_paramSize	EQU	*-_paramBegin		ENDR 				IMPORT	dblTime		IMPORT	keyboardRect:Rect		IMPORT	keypadRect:Rect		IMPORT	keys:Key		IMPORT	strPER		WITH	StackFrame		phd				; allocate our stack frame		tsc		sec		sbc	#_localSize		tcs		tcd;--- begin ---		stz	<doKeyTrans		stz	<index		pha		_GetKeyTranslation		pla		and	#$00FF		sta	<kTransID		beq	getLanguage				pha		_GetCurResourceApp		pla		sta	<tempID		lda	_ownerid		pha		_ResourceStartup		pha		pha		pea	rKeyTrans		pea	$0FFF		lda	<kTransID		ora	#$0600		pha		_GetROMResource		pla		plx		sta	<kTransRef		stx	<kTransRef+2		ora	<kTransRef+2		beq	getLanguage				lda	[<kTransRef]		; dereference handle		sta	<kTransArray		ldy	#2		lda	[<kTransRef],y		sta	<kTransArray+2		inc	<doKeyTransgetLanguage		pha		pea	kyBdLang		_ReadBParam		pla		and	#$000F		sta	<language		asl	a			; table of words		tay		lda	layouts,y		sta	<langMap		lda	#KeyData>>16		sta	<langMap+2			pha		_GetMasterSCB		pla		and	#mode640		sta	use640		beq	@320@640		lda	#kbH2		sta	keyboardRect.right		lda	#kpH1		sta	keypadRect.left		lda	#kpH2		sta	keypadRect.right		lda	#kwRet		sta	keyWidthReturn		lda	#kwEsc		sta	keyWidthESC		lda	#kWidth		sta	keyWidth		lda	#keyWidths		bra	@cont@320		lda	#kbH2_320		sta	keyboardRect.right		lda	#kpH1_320		sta	keypadRect.left		lda	#kpH2_320		sta	keypadRect.right		lda	#kwRet_320		sta	keyWidthReturn		lda	#kwEsc_320		sta	keyWidthESC		lda	#kWidth_320		sta	keyWidth		lda	#keyWidths_320@cont		sta	<keyWidthsPtr		lda	#KeyData>>16		sta	<keyWidthsPtr+2		lda	#kRowY1		sta	lastRow				lda	keyboardRect.left		sta	hStart		sta	<sum		;--- init the printable legends based on the;    language selected and translation resource:		lda	#0keyLoop			sta	<index		jsr	MakeIndex				lda	keys.keyFlag,x		and	#kPrintable			; is this a printable key?		beq	next				; no, so skip				lda	<index		jsr	GetASCIIValue		sep	#$20		sta	keys.keyLegends+kPlain,x		tya		sta	keys.keyLegends+kPlain+kOption,x		rep	#$20		lda	<index		clc		adc	#numBoardKeys		jsr	GetASCIIValue		sep	#$20		sta	keys.keyLegends+kShift,x		tya		sta	keys.keyLegends+kShift+kOption,x		rep	#$20		lda	<index		clc		adc	#numBoardKeys*2		jsr	GetASCIIValue		sep	#$20		sta	keys.keyLegends+kCaps,x		tya		sta	keys.keyLegends+kCaps+kOption,x			rep	#$20;--- init keyWidth field:next		ldy	<index		lda	[<keyWidthsPtr],y		and	#$00FF		sta	keys.keyWidth,x	;--- calculate keyOffset.h field by adding up key widths:		jsr	CheckBounds		lda	<sum		sta	keys.keyOffset.h,x		clc		adc	keys.keyWidth,x		sta	<sum				lda	keys.keyOffset.v,x		sta	<lastRow		lda	<index		inc	a		cmp	#numTotalKeys		bcc	keyLoop		ldy	<language		lda	decimalPoints,y		and	#$00FF		ora	#$2000		sta	strPER+2		lda	<kTransID		beq	@double		lda	<doKeyTrans		beq	@skip		pea	rKeyTrans		pea	$0FFF		lda	<kTransID		ora	#$0600		pha		_ReleaseROMResource@skip		_ResourceShutdown		lda	<tempID		pha		_SetCurResourceApp@double			pha				; fetch the double-click time		pha		_GetDblTime		pla		sta	>dblTime		pla		sta	>dblTime+2; bug fix, check if real caps lock key is down:		sep	#$20		lda	>KEYMODREG		; check the hardware register		rep	#$20		and	#kmrCapsLock		; is the capslock key down?		beq	@end			; no, so skip		lda	#iCapsLock		jsr	MakeIndex		lda	keys.keyFlag,x		ora	#kSticky+kDown		; make capslock key sticky and down		sta	keys.keyFlag,x		lda	#kCaps		sta	modState		; remember that capslock modifier is down@end;--- end ---				lda	<rtlAddr		; adjust return address		sta	<rtlAddr+_paramSize		lda	<rtlAddr+1		sta	<rtlAddr+_paramSize+1				tsc				; remove our stack frame and params		clc		adc	#_localSize+_paramSize		tcs		pld		rtl;------------------------------------------------;; In:	a-reg has key offset;; Out:	a-reg has acsii value for key;	y-reg has ascii value for key+option;	x-reg preserved;------------------------------------------------GetASCIIValue		tay		lda	[<langMap],y		and	#$00FF				; get the ascii character for this key			pha		pha				ldy	<doKeyTrans			; should we translate?		beq	@done				; no		tay		lda	[<kTransArray],y		; translate char		and	#$00FF		sta	1,s		tya		clc		adc	#128				; 2nd half of table has option chars		tay		lda	[<kTransArray],y		; translate char+option		and	#$00FF		sta	3,s@done				pla		ply		rts;------------------------------------------------CheckBounds				lda	<index		cmp	#numBoardKeys			; have we reached the keypad keys?		bne	@nope		lda	#kRowY1				; account for keypad now		sta	<lastRow		lda	keypadRect.left		sta	<hStart		sta	<sum@nope		lda	<lastRow		cmp	keys.keyOffset.v,x		; have we reached a new row?		bcs	@skip		lda	<hStart				; start over		sta	<sum@skip				rts		ENDP;_______________________________________________________;; INPUT:	none;; OUTPUT:	none;;_______________________________________________________KeyShutDown	PROC	EXPORT		LONGA	ON		LONGI	ON		talkR2A2	SET	talk+$22		; talk register 2 at address 2 (keyboard)kMask		SET	((≈(kDown+kSticky))<<16)>>16		IMPORT	PostKey		IMPORT	R2Completion		IMPORT	keys:Key; first check if real capslock key is down; if its not, then our data will also think its up		lda	ModState		; do we think its down?		and	#kCaps		beq	@skip			; no, so skip rest of check				stz	ADBFinished		pea	R2Completion>>16	; completion routine		pea	R2Completion		pea	talkR2A2		; adb command		_AsyncADBReceive		; install completion routine to check ADB reg 2		bcs	@skip			; error, so skip				lda	>TickCount		clc		adc	#3		sta	Temp			; timeout time@wait		lda	>TickCount		cmp	Temp			; have we timed out yet?		bcs	@skip			; yes, so skip		lda	ADBFinished		; has completion routine finished?		beq	@wait			; no, keep waiting@skip;--- release any keys that are down:		ldx	#0@loop				phx		txa		jsr	MakeIndex				lda	keys.keyFlag,x		and	#kDown				; is the key down?		beq	@next				; no, so try next key		lda	keys.keyFlag,x		and	#kMask				; clear kDown and kSticky flags		sta	keys.keyFlag,x		lda	keys.keyRawCode,x		ldx	#keyUp		jsr	PostKey				; post key up to ADB micro		@next		plx		inx		cpx	#numTotalKeys		bcc	@loop		lda	#iRightShift			; force right shift key up		jsr	MakeIndex		lda	keys.keyFlag,x		and	#kMask				; clear kDown and kSticky flags		sta	keys.keyFlag,x		stz	modState		rtl		ENDP;_______________________________________________________;; In:	a-reg has modifiers to set;; Out:	a-reg has new modifiers;;_______________________________________________________ModifiersToSet	PROC		LONGA	ON		LONGI	ON		tax		and	#kControl			; if control key, then turn off all mods		beq	noControl				ldx	#0		bra	done	noControl		txa		and	#kModMask		tax		and	#kShift+kCaps			; if shift + caps, then turn off caps		cmp	#kShift+kCaps		bne	done		txa		and	#≈(kCaps)		taxdone		txa		rtl		ENDP		;_______________________________________________________; INPUT:	a_reg has draw flag;		(bit 0: keyboard, bit 1: keypad);; OUTPUT:	none;;_______________________________________________________DrawKeyboard	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	DrawStaticLegends		IMPORT	DrawKeyRects		IMPORT	DrawkeyLegends		cmp	#drawBoard		beq	@board		cmp	#drawPad		beq	@pad		cmp	#drawBoth		bne	exit@both		ldx	#0				; start		ldy	#numBoardKeys+numPadKeys-1	; end		bra	draw@board		ldx	#0				; start		ldy	#numBoardKeys-1			; end		bra	draw@pad		ldx	#numBoardKeys			; start		ldy	#numBoardKeys+numPadKeys-1	; enddraw							; x = start, y = end		stx	start		sty	end		jsl	DrawStaticLegends		ldx	start		ldy	end		jsl	DrawKeyRects		lda	modState		jsl	ModifiersToSet		ldx	start		ldy	end		jsl	DrawKeyLegendsexit		rtlstart		DS.W	1end		DS.W	1		ENDP;_______________________________________________________; INPUT:	none;; OUTPUT:	none;;_______________________________________________________DrawKeyCaps	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	DrawPrintableLegends		IMPORT	DrawKeyLegends				lda	modState		jsl	ModifiersToSet		jsl	DrawPrintableLegends				ldx	#iPadPeriod			; start		ldy	#iPadPeriod			; end		lda	#0				; mods		jsl	DrawKeyLegends		rtl		ENDP;_______________________________________________________;; INPUT:	x-reg has starting index;		y-reg has ending index;; OUTPUT:	none;;_______________________________________________________DrawStaticLegends PROC		LONGA	ON		LONGI	ON		IMPORT	genevaFont		IMPORT	keys:Key		stx	start		sty	end		;--- if geneva font was installed then draw the static legends:				lda	>genevaFont		ora	>genevaFont+2		beq	exit		pha		pha		_GetFont				; save current font (on stack)				lda	>genevaFont+2		pha		lda	>genevaFont		pha		_SetFont				; use  geneva font		lda	use640		beq	@320@640		lda	#6				; inset value		bra	@set@320		lda	#3				; inset value@set		sta	inset				lda	start@loop		sta	index		jsr	MakeIndex				lda	keys.keyFlag,x		and	#kStatic			; is this a static legend?		beq	@next				lda	keys.keyDataPtr+1,x		beq	@next		lda	keys.keyDataPtr+2,x		pha		lda	keys.keyDataPtr,x		pha		lda	keys.keyOffset.h,x		clc		adc	inset		pha		lda	keys.keyOffset.v,x		clc		adc	#kHeight-1		pha		_MoveTo		_DrawString@next		lda	index		inc	a		cmp	end		bcc	@loop		beq	@loop		_SetFont				; restore current font (from stack)exit		rtlstart		DS.W	1end		DS.W	1index		DS.W	1inset		DS.W	1		ENDP		;_______________________________________________________; INPUT:	x_reg = start;		y_reg = end;		a_reg = set; Out:	none;_______________________________________________________DrawKeyLegends	PROC		LONGA	ON		LONGI	ON				IMPORT	keys:Key		IMPORT	picInfo:LocInfo		stx	start		sty	end		sta	set		lda	#picDX		ldx	#$0080		ldy	use640		bne	@ok		lsr	a				; a/2		ldx	#$0000@ok		sta	picInfo.boundsRect.right		stx	picInfo.portSCB		lda	startloop		sta	i		jsr	MakeIndex		lda	keys.keyFlag,x		and	#kPrintable			; is this a printable key?		beq	picture				; no, so skip				txa		clc		adc	set		tay		lda	keys.keyLegends,y		and	#$00FF		sta	c		pha		pha		_CharWidth		pla		sta	w		lda	i		jsr	MakeIndex		lda	keys.keyWidth,x		sec		sbc	w		lsr	a				; a/2		clc		adc	keys.keyOffset.h,x		adc	#2		pha					; h = keyOffset.h + ((keyWidth - w)/2) + 2		lda	keys.keyOffset.v,x		clc		adc	#kHeight-2			; v = keyOffset.v + kHeight - 2		pha		_MoveTo				lda	c		pha		_DrawChar		brl	invertpicture		lda	keys.keyFlag,x		and	#kPicture			; is this a picture?		beq	plain				; no, so skip		lda	keys.keyDataPtr,x		sta	picInfo.ptrToPixImage		lda	keys.keyDataPtr+2,x		sta	picInfo.ptrToPixImage+2				pea	picInfo>>16		pea	picInfo		pea	picInfo.boundsRect>>16		pea	picInfo.boundsRect		lda	keys.keyWidth,x		sec		sbc	picInfo.boundsRect.right		lsr	a				; a/2		clc		adc	keys.keyOffset.h,x		adc	#3		pha					; h = keyOffset.h + 3 + ((keyWidth - picInfo.boundsRect.h2)/2);		lda	keys.keyHeight,x		clc		adc	keys.keyOffset.v,x		sec		sbc	#picDY+2		pha					; v = keyOffset.v + keyHeight - picDY - 2		pea	modeCopy		_PPToPort		bra	invertplain		lda	keys.keyFlag,x		and	#kStatic			; is this a non-static legend?		bne	invert				; no, so skip		lda	keys.keyDataPtr+1,x		; is ptr valid ?		beq	invert				; no, so skip		phx					; save key offset on stack		pha		lda	keys.keyDataPtr+2,x		pha		lda	keys.keyDataPtr,x		pha		_StringWidth		pla		sta	w				lda	1,s		tax		lda	keys.keyWidth,x		sec		sbc	w		lsr	a				; a/2		clc		adc	keys.keyOffset.h,x		adc	#2		pha					; h = keyOffset.h + ((keyWidth - w)/2) + 2;		lda	keys.keyOffset.v,x		clc		adc	#kHeight-2		pha					; v = keyOffset.v + kHeight - 2;		_MoveTo		plx		lda	keys.keyDataPtr+2,x		pha		lda	keys.keyDataPtr,x		pha		_DrawStringinvert		lda	i		jsr	MakeIndex		lda	keys.keyFlag,x		and	#kDown				; if key is down then invert it		beq	next		lda	i		jsl	InvertKeynext				lda	i		inc	a		cmp	end				; i ≤ end ?		beq	@loop		bcs	exit@loop		brl	loopexit		rtli		DS.W	1start		DS.W	1end		DS.W	1set		DS.W	1c		DS.W	1w		DS.W	1		ENDP;_______________________________________________________;; INPUT:	a_reg has index into keyLegends;_______________________________________________________DrawPrintableLegends PROC		LONGA	ON		LONGI	ON		IMPORT	keys:Key		IMPORT	temp:Rect		sta	set		lda	#0loop		sta	i		jsr	MakeIndex		lda	keys.keyFlag,x		and	#kPrintable		bne	print		brl	nextprint		lda	#$2003		sta	str		lda	#$2020		sta	str+2		txa		clc		adc	set		tay		lda	keys.keyLegends,y		sep	#$20		sta	str+2		rep	#$20		phx				pha		pea	str>>16		pea	str		_StringWidth		pla		sta	w				plx		lda	keyWidth			; make sure string will fit		sec		sbc	#3		cmp	w		bcc	tooWide				; string is too wide, adjust it		lda	keys.keyWidth,x			; center string inside of key		sec		sbc	w		lsr	a		clc		adc	keys.keyOffset.h,x		adc	#2		sta	temp.left				; temp.h = keyOffset.h + ((keyWidth - w)/2) + 2;		lda	keys.keyOffset.v,x		clc		adc	#kHeight-2		sta	temp.top				lda	temp.left		pha		lda	temp.top		pha		_MoveTo		pea	str>>16		pea	str		_DrawString		bra	nexttooWide		phx				pha		lda	str+2		and	#$00FF		pha		_CharWidth		pla		sta	w		plx		lda	keys.keyOffset.v,x		; calculate Rect for this key		inc	a		sta	temp.top		clc		adc	keys.keyHeight,x		dec	a		sta	temp.bottom		lda	keys.keyOffset.h,x		clc		adc	#2		sta	temp.left		adc	keys.keyWidth,x		sec		sbc	#2		sta	temp.right				phx				pea	temp>>16		pea	temp		_EraseRect				plx				lda	keys.keyWidth,x		sec		sbc	w		lsr	a				; a/2		clc		adc	keys.keyOffset.h,x		adc	#2		pha					; h = keyOffset.h + ((keyWidth - w)/2) + 2		lda	keys.keyOffset.v,x		clc		adc	#kHeight-2			; v = keyOffset.v + kHeight - 2		pha		_MoveTo				lda	str+2		and	#$00FF		pha		_DrawChar		next		lda	i		inc	a		cmp	#numBoardKeys		bcs	exit		brl	loopexit				rtlset		DS.W	1i		DS.W	1w		DS.W	1str		DS.B	6		ENDP;_______________________________________________________;; INPUT:	x_reg has starting key;		y_reg has ending key;; OUTPUT:	none;_______________________________________________________DrawKeyRects	PROC			LONGA	ON		LONGI	ON				IMPORT	grayPattern		IMPORT	grayPattern_320		IMPORT	keys:Key		IMPORT	keyboardRect:Rect		IMPORT	keypadRect:Rect		IMPORT	temp:Rect		stx	start		sty	end			lda	use640		beq	@320@640		lda	#grayPattern		ldx	#3		bra	@set@320		lda	#grayPattern_320		ldx	#2@set		pea	grayPattern>>16		pha					; ptr to pattern		phx					; pen width		pea	1				; pen height		_SetPenSize		_SetPenPat				lda	start@loop1		sta	index		jsr	MakeIndex		pea	0		lda	keys.keyHeight,x		dec	a		pha		lda	keys.keyOffset.h,x		pha		lda	keys.keyOffset.v,x		pha		_MoveTo		_Line				lda	index		inc	a		cmp	end		bcc	@loop1		beq	@loop1; --- include key board ---			lda	start		beq	board		brl	skipboard		lda	keyboardRect.right		pha		pea	kbV1		_MoveTo		pea	0		pea	kbHeight		_Line		lda	#kbV1@loop2		sta	index		lda	keyboardRect.left		pha		lda	index		pha		_MoveTo		lda	keyboardRect.right		dec	a		pha		lda	index		pha		_LineTo				lda	index		clc		adc	#kHeight		cmp	#kbV1+(kRows+1)*kHeight		bcc	@loop2		lda	#kRowY3		sta	temp.top		inc	a		sta	temp.bottom		lda	keyboardRect.right		sta	temp.right		sec		sbc	keyWidthESC		inc	a		sta	temp.left				pea	temp>>16		pea	temp		_EraseRect				; erase line through our return key		lda	#kRowY2+1		sta	temp.top		adc	#kHeight-1		sta	temp.bottom		lda	keyboardRect.right		clc		sbc	keyWidthReturn			; keyboardRect.right - keyWidthReturn - 1		sta	temp.left		clc		adc	#4		sta	temp.right		pea	temp>>16		pea	temp		_EraseRect				; erase line through our ']' key 		lda	keyboardRect.right		sec		sbc	keyWidthESC		pha		pea	kRowY2		_MoveTo		pea	0		pea	kHeight		_Line					; draw right line of ']' keyskip; --- include key pad ---				lda	end		cmp	#numTotalKeys-1		bcs	pad		brl	exitpad		lda	keypadRect.right		pha		pea	kpV1		_MoveTo		pea	0		pea	kbHeight		_Line		lda	#kbV1@loop3		sta	index		lda	keypadRect.left		pha		lda	index		pha		_MoveTo		lda	keypadRect.right		dec	a		pha		lda	index		pha		_LineTo				lda	index		clc		adc	#kHeight		cmp	#kbV1+(kRows-1)*kHeight		bcc	@loop3		sta	index; --- enter-key is special case ---		lda	keypadRect.left		pha		lda	index		pha		_MoveTo		lda	keypadRect.right		clc		sbc	keyWidth			; keypadRect.right - keyWidth -1		pha		lda	index		pha		_LineTo				lda	keypadRect.left		pha		lda	index		clc		adc	#kHeight		sta	index		pha		_MoveTo		lda	keypadRect.right		dec	a		pha		lda	index		pha		_LineTo	exit		rtlstart		DS.W	1end		DS.W	1index		DS.W	1		ENDP;_______________________________________________________;; In:	y_reg has vert position	(local coord);	x_reg has hort position (local coord);; Out:	a_reg true to keep tracking;;_______________________________________________________CheckKey	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	temp:Point		IMPORT	keys:Key		IMPORT	keyboardRect:Rect		sty	temp.v		stx	temp.h		stz	track		cpx	keyboardRect.right			; is temp.h > keyboardRect.h2 ?		bcc	else		beq	else				ldx	#numBoardKeys;		ldy	#numTotalKeys-1		bra	setelse		ldx	#0;		ldy	#numBoardKeys-1set			stx	start		sty	end		lda	start@loop				sta	index		jsr	MakeIndex		lda	keys.keyOffset.h,x		cmp	temp.h				; is temp.h > keyOffset.h ?		bcs	@next		adc	keys.keyWidth,x		inc	a		cmp	temp.h				; is temp.h ≤ (keyOffset.h + keyWidth + 1) ?		bcc	@next		lda	keys.keyOffset.v,x		cmp	temp.v				; is temp.v > keyOffset.v ?		bcs	@next		adc	keys.keyHeight,x		cmp	temp.v				; pt.v ≤ (keyOffset.v + keyHeight) ?		bcc	@next				lda	index		jsr	MakeIndex		bra	found@next		lda	index		inc	a		cmp	end		bcc	@loop		beq	@loop		brl	donefound		lda	keys.keyFlag,x		sta	flag		and	#kModifier			; is this a modifier key?		bne	modifier			; yes		lda	index		jsl	SelectKey				pha		pea	0				; check button 0		_StillDown				; is mouse still down ?		pla		sta	track		beq	kill				; no, so kill it		brl	done				; yes, so we're donekill				jsl	KillMouseEvent			; eat this mouse event		lda	index		jsl	ReleaseKey		bra	done;--- check for double click on a modifier:modifier		jsl	GetMouseTime			; get the time of the 2nd click		sta	newTime		stx	newTime+2						lda	flag		and	#kDown				; is this modifier key down already?		beq	selectMod			; no		lda	currentKey			; is this the current key?		cmp	index		bne	releaseMod			; no				lda	newTime				; get the time interval		sec		sbc	oldTime		tax		lda	newTime+2		sbc	oldTime+2		cpx	dblTime				; is interval < dblTime ?, ie double click		sbc	dblTime+2		bcc	double				; yesreleaseMod		lda	index		jsl	ReleaseKey		bra	timedouble		lda	index		jsr	MakeIndex		lda	keys.keyFlag,x			; set the sticky bit for this key		ora	#kSticky		sta	keys.keyFlag,x		and	#kShift				; is this a shift key?		beq	time				; no		lda	#iLeftShift			; switch to twin key		cmp	index		bne	@switch		lda	#iRightShift@switch		jsr	MakeIndex		lda	keys.keyFlag,x		ora	#kSticky			; set the sticky bit for twin key		sta	keys.keyFlag,x		bra	timeselectMod		lda	index		jsl	SelectKeytime				lda	newTime				; save time of the 1st click		sta	oldTime		lda	newTime+2		sta	oldTime+2done			lda	track		cmp	#1				; carry flag is set if true		rtl		track		DS.W	1index		DS.W	1start		DS.W	1end		DS.W	1flag		DS.W	1		ENDP;_______________________________________________________;; INPUT:	a_reg has key number;; OUTPUT:	none;;_______________________________________________________ReleaseKey	PROC		LONGA	ON		LONGI	ONkMask		SET	((≈(kDown+kSticky))<<16)>>16	; mask for clearing kDown and kSticky				IMPORT	keys:Key				ldx	modState		stx	oldModState		sta	index		jsr	release				; release this key…		lda	index		jsr	MakeIndex; --- if non-modifier key was just released then;     release any non-sticky modifier keys		lda	modState			; are there mod keys down?		beq	done				; none, so skip		lda	keys.keyFlag,x		and	#kModifier			; is this key a mod key?		bne	done				; yes, so skip		ldy	#numModKeys-1		@loop		phy		tya		asl	a		tax		lda	modKeys,x		sta	index		jsr	MakeIndex		lda	keys.keyFlag,x		and	#kDown+kSticky		cmp	#kDown				; is it down but not sticky?		bne	@next				; no, so skip it		lda	index		jsr	release				; release this modifier key…@next		ply		dey		bpl	@loopdone		lda	modState		cmp	oldModState		beq	exit				; no change, so we're done		jsl	ModifiersToSet		jsl	DrawPrintableLegends		; redraw the key legendsexit		rtl; release the key in a_reg:release		jsr	MakeIndex				lda	keys.keyFlag,x		and	#kDown		beq	@end		lda	keys.keyFlag,x		and	#kMask				; clear kDown and kSticky flags		sta	keys.keyFlag,x		phx		lda	keys.keyRawCode,x		ldx	#keyUp		jsr	PostKey				lda	index		jsl	InvertKey		plx		lda	modState			; are there mod keys down?		beq	@end				; none, so skip		lda	keys.keyFlag,x		tay		and	#kModTypeMask		trb	modState			; remove it from the list		tya		and	#kShift				; is it a shift key?		beq	@end				; no				lda	#iLeftShift			; switch to twin		cmp	index		bne	@switched		lda	#iRightShift@switched		sta	index		jsl	InvertKey			; release the sister key		lda	index		jsr	MakeIndex		lda	keys.keyFlag,x		and	#kMask				; clear kDown and kSticky flags		sta	keys.keyFlag,x@end		rtsindex		DS.W	1oldModState	DS.W	1		ENDP				;_______________________________________________________;; INPUT:	a_reg has key number;; OUTPUT:	none;;_______________________________________________________SelectKey	PROC		LONGA	ON		LONGI	ON		IMPORT	keys:Key			sta	index		jsl	InvertKey			; hilite this key		lda	index		jsr	MakeIndex		lda	keys.keyFlag,x		ora	#kDown				; mark this key as being down		sta	keys.keyFlag,x; --- check if CDA menu sequence is about to occur ---			lda	keys.keyRawCode,x		cmp	#_ESC				; is this the escape key?		bne	normal				lda	modState		and	#kApple+kControl		cmp	#kApple+kControl		; are the Apple and Control keys down?		bne	normal				phx		jsl	OkToUseCDAMenu			; alert user about 40/80 column text screen		plx		bcs	normal				; the user chose to cancel				lda	keys.keyFlag,x		and	#((≈kDown)<<16)>>16		; clear kDown flag		sta	keys.keyFlag,x		lda	index		jsl	InvertKey			; un-hilite the escape key				bra	exitnormal		lda	keys.keyRawCode,x		ldx	#keyDown		jsr	PostKey				; post key to ADB micro		lda	index		sta	currentKey		jsr	MakeIndex		lda	keys.keyFlag,x		tay		and	#kModifier			; is this a modifier key?		beq	exit				; no, so we're done				tya		and	#kModTypeMask		tsb	modState		tya		and	#kCaps				; is it the capsLock key?		beq	shiftTwin			; no				lda	keys.keyFlag,x		ora	#kSticky			; make capslock key sticky (always)		sta	keys.keyFlag,xshiftTwin		tya		and	#kShift				; is it a shift key?			beq	skip				; no				lda	#iLeftShift			; switch to the twin's index		cmp	index		bne	@switched			lda	#iRightShift		@switched		sta	index		jsl	InvertKey			; invert the twin key				lda	index		jsr	MakeIndex		lda	keys.keyFlag,x		ora	#kDown				; set the twin's kDown flag		sta	keys.keyFlag,xskip		lda	modState		cmp	#kControl			; is the control key down?		beq	exit		cmp	#kApple				; is the Apple key down?		beq	exit		jsl	ModifiersToSet		jsl	DrawPrintableLegends		; redraw the key legendsexit		rtlindex		DS.W	1		ENDP;_______________________________________________________;;_______________________________________________________ReleaseLastKey	PROC	EXPORT		LONGA	ON		LONGI	ON		lda	currentKey		jsl	ReleaseKey		rtl				ENDP;_______________________________________________________;; INPUT:	a_reg has key number;; OUTPUT:	none;;_______________________________________________________InvertKey	PROC		LONGA	ON		LONGI	ON		IMPORT	temp:Rect		IMPORT	keys:Key		IMPORT	keyboardRect:Rect		jsr	MakeIndex			lda	#3		sta	slop		lda	use640		bne	@ok		dec	slop@ok		lda	keys.keyRawCode,x		; is this the return key?		cmp	#_CR		beq	special				; yes, so treat it special		lda	keys.keyOffset.v,x		; calculate Rect for this key		inc	a		sta	temp.top		clc		adc	keys.keyHeight,x		dec	a		sta	temp.bottom				lda	keys.keyOffset.h,x		clc		adc	slop		sta	temp.left		adc	keys.keyWidth,x		sec		sbc	slop		sta	temp.right		bra	invertspecial				lda	#kRowY2+1			; top piece of return key		sta	temp.top		clc		adc	#kHeight		sta	temp.bottom				lda	keyboardRect.right		sec		sbc	keyWidthESC		clc		adc	slop		sta	temp.left		adc	keyWidthESC		sec		sbc	slop		sta	temp.right				pea	temp>>16		pea	temp		_InvertRect		lda	#kRowY3+1			; bottom piece of return key		sta	temp.top		clc		adc	#kHeight-1		sta	temp.bottom		lda	keyboardRect.right		sec		sbc	keyWidthReturn		clc		adc	slop		sta	temp.left		adc	keyWidthReturn		sec		sbc	slop		sta	temp.rightinvert				pea	temp>>16		pea	temp		_InvertRect		_ShowCursor				; cursor was obscured during _InvertRect		rtlslop		DS.W	1		ENDP;_______________________________________________________;; INPUT:	y_reg has vert position	(local coord);		x_reg has hort position (local coord);; OUTPUT:	a_reg true to keep tracking;		carry also set if true;_______________________________________________________TrackKey	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	temp:Point		IMPORT	keys:Key		sty	temp.v		stx	temp.h; --- check if mouse is ouside of the key ---		lda	currentKey		jsr	MakeIndex		lda	keys.keyOffset.h,x		; is temp.h < keyOffset.h ?		cmp	temp.h		bcs	release				adc	keys.keyWidth,x			; is temp.h > (keyOffset.h + keyWidth)?		cmp	temp.h		bcc	release				lda	keys.keyOffset.v,x		; is temp.v < keyOffset.v ?		cmp	temp.v		bcs	release				adc	keys.keyHeight,x		; is temp.v > (keyOffset.v + keyHeight)?		cmp	temp.v		bcc	release				lda	#1				; keep tracking		bra	exitrelease			lda	currentKey		jsl	ReleaseKey		lda	#0				; stop tracking	exit		cmp	#1		rtl		ENDP;_______________________________________________________;; INPUT:	a_reg has key code;		x_reg = up or down flag;; OUTPUT:	none;;_______________________________________________________PostKey		PROC		LONGA	ON		LONGI	ON		sta	temp				txa		pha		and	#keyDown		beq	next			pea	1				; bytes to send		pea	temp>>16			; ptr to data		pea	temp		pea	keyCode				; adb command		_SendInfonext		pla		and	#keyUp		beq	exit				lda	#$0080				; set "key up" bit		tsb	temp		pea	1				; bytes to send		pea	temp>>16			; ptr to data		pea	temp		pea	keyCode				; adb command		_SendInfoexit		rts		ENDP;_______________________________________________;; INPUT:	a_reg has key number; OUTPUT:	x_reg has offset to key data;;_______________________________________________MakeIndex	PROC		LONGA	ON		LONGI	ON		asl	a		asl	a		asl	a		pha		asl	a		adc	1,s		tax					; x <-- a*8 + a*16 = a*24			pla		rts		ENDP*===============================================**						**	Our Sync Completion Routine		**						**===============================================*R2Completion	PROCdataBank	SET	1			; stack offsetsdirPage		SET	dataBank+1rtlAddr		SET	dirPage+2dataPtr		SET	rtlAddr+3r2Delete	set	%01000000r2CapsLock	set	%00100000r2Reset		set	%00010000r2Control	set	%00001000r2Shift		set	%00000100r2Option	set	%00000010r2Command	set	%00000001kMask		SET	((≈(kDown+kSticky))<<16)>>16	; mask for clearing kDown and kSticky		LONGA	OFF			; completion uses 8-bit mode		LONGI	OFF		IMPORT	keys:Key		phb				; save these guys		phd		tsc				; make a stack frame		tcd		phk				; use local addressing		plb		lda	[<dataPtr]		beq	exit				ldy	#1		lda	[<dataPtr],y		; get register 2 data		eor	#$FF		and	#r2CapsLock		; is capslock key down?		beq	exit			; no, so skip		rep	#$30			; need 16-bit registers		LONGA	ON		LONGI	ON				lda	ModState		and	#≈(kCaps)		; clear capslock bit		sta	ModState		lda	#iCapsLock		jsr	MakeIndex		lda	keys.keyFlag,x		and	#kMask			; clear sticky and down flags		sta	keys.keyFlag,x				sep	#$30			; back to 8-bit registers		LONGA	OFF		LONGI	OFFexit		inc	ADBFinished		; signal that we're done				pld		plb		clc		rtl				ENDP			END