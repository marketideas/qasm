*===========================================**											**	File:		Mouse.a						**	Project:	Video Keyboard				**	Author:		Don J. Brady				**											**	Copyright © Apple Computer,Inc. 1989-91	**	All rights reserved.					**-------------------------------------------**	Modification History:					**	07/26/89	DJB		File created today	**											**===========================================*				PRINT	OFF						INCLUDE	'E16.Event'					INCLUDE	'M16.QuickDraw'					INCLUDE	'M16.Event'					INCLUDE	'M16.Locator'					INCLUDE	'M16.MiscTool'					PRINT	ONGetNextEvent	equ		$0A06EventAvail		equ		$0B06EventToolSet	equ		$06v1				equ		0					; Rect offsetsh1				equ		v1+2v2				equ		h1+2h2				equ		v2+2DECBUSYFLAG		equ		$E10068SeekRgnVec		equ		$E01ED8				; QD vectors that we patchUnDrawCursor	equ		$E01FD0IDROUTINE		equ		$FE1F				; firmware id routineRgnPtr			equ		$80					; QD zero page offsetsStatePtr		equ		RgnPtr+4;	Offsets in state record for non-rectangular regionS_GenLInfo		equ 0S_RgnPtr		equ S_GenLInfo+2S_DataPtr		equ S_RgnPtr+4S_ScanBuf		equ S_DataPtr+4S_ScanSize		equ S_ScanBuf+4 S_ThisV			equ S_ScanSize+2S_NextV			equ S_ThisV+2 S_MinX			equ S_NextV+2S_MaxX			equ S_MinX+2 S_LeftH			equ S_MaxX+2S_currVpos 		equ S_LeftH+2S_DataIndex		equ S_currVpos+2S_SeekDir		equ S_DataIndex+2StateRecSize	equ S_SeekDir+2				ENTRY	MySeekRgn			; forward referenced routines				ENTRY	MyUnDrawCursor				ENTRY	GetROMVersion*===========================================*StaticData		PROC				ENTRY	EventAvailPtrEventAvailPtr	dc.L	0				ENTRY	GetNextEventPtrGetNextEventPtr	dc.L	0				Entry	mouseTimemouseTime		dc.L	0				ENTRY	myEventRecmyEventRec		ds.B	20				ENTRY	skipPreProcess		; ­ means don't do any preprocessingskipPreProcess	dc.W	0				ENTRY	noMouseTrapnoMouseTrap		dc.W	0				ENTRY	lastCursorlastCursor		dc.L	0				ENTRY	myCursorAddrmyCursorAddr	dc.L	0				ENTRY	tempRecttempRect		dc.W	0,0,0,0				ENTRY	MySeekRgnVecMySeekRgnVec	jml		>MySeekRgn				Entry	RealSeekRgnVecRealSeekRgnVec	dc.L	0				ENTRY	_UnDrawCursor_UnDrawCursor	jml		>MyUnDrawCursor		; jump to out UnDrawCursor				Entry	jUnDrawCursorjUnDrawCursor	dc.L	0					; jump to real UnDrawCursor;---- Call table for Event manager ---------				ENTRY	EMCallTable				ENTRY	EMGetNextEvent				ENTRY	EMEventAvailEMCallTable		dc.L	(TheEnd-EMCallTable)/4 	; number of calls + 1				dc.L	0					; $01 old bootInit				dc.L	0					; $02 old startup				dc.L	0					; $03 old shutdown				dc.L	0					; $04 old version				dc.L	0					; $05 old reset				dc.L	0					; $06 old status				dc.L	0					; $07 old function				dc.L	0					; $08 old function				dc.L	0					; $09 old functionEMGetNextEvent	dc.L	0					; $0A __GetNextEventEMEventAvail	dc.L	0					; $0B __EventAvail				dc.L	0					; $0C old function				dc.L	0					; $0D old function				dc.L	0					; $0E old function				dc.L	0					; $0F old function				dc.L	0					; $10 old function				dc.L	0					; $11 old function				dc.L	0					; $12 old function				dc.L	0					; $13 old function				dc.L	0					; $14 old function				dc.L	0					; $15 old function				dc.L	0					; $16 old function				dc.L	0					; $17 old function				dc.L	0					; $18 old function				dc.L	0					; $19 old function				dc.L	0					; $1A old function				dc.L	0					; $1B old function				dc.L	0					; $1C old functionTheEnd				ENTRY	IOwnTheCursorIOwnTheCursor	dc.W	0				ENTRY	SmartAppSmartApp		dc.W	0				ENTRY	ROMVersionROMVersion		dc.W	0				IF 0 = 1 THEN				ENTRY	myCursorRecmyCursorRec		dc.w	16,5									; cursor size				dc.B	$00,$00,$00,$FF,$F0,$00,$00,$00,$00,$00	; cursor image				dc.B	$00,$00,$0F,$00,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$00,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$00,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$00,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$00,$FF,$00,$00,$00,$00,$00				dc.B	$0F,$FF,$0F,$00,$FF,$FF,$F0,$00,$00,$00				dc.B	$F0,$0F,$FF,$00,$F0,$F0,$FF,$F0,$00,$00				dc.B	$0F,$00,$FF,$00,$F0,$F0,$F0,$FF,$00,$00				dc.B	$00,$F0,$0F,$00,$00,$00,$F0,$FF,$00,$00				dc.B	$00,$F0,$0F,$00,$00,$00,$00,$FF,$00,$00				dc.B	$00,$0F,$00,$00,$00,$00,$00,$FF,$00,$00				dc.B	$00,$00,$F0,$00,$00,$00,$00,$FF,$00,$00				dc.B	$00,$00,$F0,$00,$00,$00,$0F,$F0,$00,$00				dc.B	$00,$00,$0F,$00,$00,$00,$0F,$F0,$00,$00				dc.B	$00,$00,$0F,$00,$00,$00,$0F,$F0,$00,$00								dc.B	$00,$00,$00,$FF,$F0,$00,$00,$00,$00,$00	; mask image				dc.B	$00,$00,$0F,$FF,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$FF,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$FF,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$FF,$FF,$00,$00,$00,$00,$00				dc.B	$00,$00,$0F,$FF,$FF,$00,$00,$00,$00,$00				dc.B	$0F,$FF,$0F,$FF,$FF,$FF,$F0,$00,$00,$00				dc.B	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$00,$00				dc.B	$0F,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$00,$00				dc.B	$00,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$00,$00				dc.B	$00,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$00,$00				dc.B	$00,$0F,$FF,$FF,$FF,$FF,$FF,$FF,$00,$00				dc.B	$00,$00,$FF,$FF,$FF,$FF,$FF,$FF,$00,$00				dc.B	$00,$00,$FF,$FF,$FF,$FF,$FF,$F0,$00,$00				dc.B	$00,$00,$0F,$FF,$FF,$FF,$FF,$F0,$00,$00				dc.B	$00,$00,$0F,$FF,$FF,$FF,$FF,$F0,$00,$00				dc.W	0,7										; hotspot				ENDIF				ENDP				*===========================================**	Preprocess GetEvent routines			**											**	We are looking for mouse events in our	**	windoid. If we find any we handle the	**	event ourself and remove it from the	**	queue.									**											** INPUT:	none							**											** OUTPUT:	carry set = don't pass mouse 	**			events to caller				**											**===========================================*EventPreProcess	PROC				IMPORT	CheckWindoid								phb				phk				plb								pha							; space for result				pea	mDownMask+mUpMask		; pass event mask				pea myEventRec>>16			; pass event record pointer				pea myEventRec				_OSEventAvail				; first look for mouse event											; leave result on stack for later				lda	myEventRec				bne	@time					; there is a mouse event				jsr	CheckCursor				; else check for cursor over our windoid							bra	@check@time			ldx	#owhen					; remember time of this mouse event				lda	myEventRec,x				sta	mouseTime				lda	myEventRec+2,x				sta	mouseTime+2				@check				ldy	myEventRec+owhere		; pass mouse location (in global coordinates)				ldx	myEventRec+owhere+2				lda	myEventRec				; pass event type in a-reg {0,1,2}				jsl	CheckWindoid			; check if we want it								pla							; get current mouse event (or null) off stack				beq	@else					; if ( mouseEvent AND !CheckWindoid) then				bcc	@exit					;	  "OK to let mouse events through"@else			sec							; else											;	  "don't let mouse events through"@exit			plb				rtl;-------------------------------------------;				IMPORT	GetWindoidRect		; extern pascal void GetWindoidRect()				IMPORT	globalPortRectCheckCursor;				pea	tempRect>>16			; get windoid's rect (global);				pea	tempRect;				jsl	GetWindoidRect				lda	globalPortRect+v1				sta	tempRect+v1				lda	globalPortRect+h1				sta	tempRect+h1				lda	globalPortRect+v2				sta	tempRect+v2				lda	globalPortRect+h2				sta	tempRect+h2								lda	tempRect+h1				bpl	@ok1				stz	tempRect+h1				@ok1			pha							; space for result (3 bytes)				pha				pha				_ReadMouse				pla				ply							; get mouse location				plx								cpx	tempRect+h1				; if (x < h1) or (x > h2) then skip				bcc	@outside				cpx	tempRect+h2				bcs	@outside				cpy	tempRect+v1				; if (y < v1) or (y > v2) then skip				bcc	@outside				cpy	tempRect+v2				bcc	@inside					; cursor is in our windoid@outside				stz  IOwnTheCursor								lda	 SmartApp				; is application smart?				bne  @done					; yes, so let it put the cursor back				lda	lastCursor				; was it changed?				ora	lastCursor+2				beq	@done				lda	lastCursor+2			; set it back to what it was				pha				lda	lastCursor				pha				_SetCursor				stz	lastCursor				stz	lastCursor+2				bra	@done@inside				pha							; space for result (long)				pha				_GetCursorAdr				pla				plx				cmp	myCursorAddr			; have we set our cursor yet?				bne	@set				cpx	myCursorAddr+2				beq	@doneSetFlag			; already set				@set			sta	lastCursor				; save current cursor record				stx	lastCursor+2								stz  SmartApp				stz  IOwnTheCursor			; allow cursor changes over MY windoid				lda	myCursorAddr+2			; set cursor to ours				pha				lda	myCursorAddr				pha				_SetCursor@doneSetFlag								lda  #$FFFF				sta  IOwnTheCursor			; don't allow cursor changes over MY windoid@done			rts				ENDP								*===========================================** Remove last mouse event from event queue	**											** INPUT:	none							**											** OUTPUT:	none							**											**===========================================*KillMouseEvent	PROC	EXPORT				; pascal void KillMouseEvent()				pha							; space for result				pea	mDownMask+mUpMask		; pass event mask				pea myEventRec>>16			; pass event record pointer				pea myEventRec				_GetOSEvent					; remove event from queue				pla				rtl								ENDP*===========================================** Remove last mouse event from event queue	**											** INPUT:	none							**											** OUTPUT:	none							**											**===========================================*GetMouseTime	PROC	EXPORT				; pascal Long GetMouseTime()				lda	>mouseTime+2				tax							lda	>mouseTime				; return time of last mouse event				rtl								ENDP*===========================================** EventAvail Patch Routine					**											** INPUT:	--- STACK ---					**		WORD - result space					**		WORD - event mask					**		LONG - event record pointer			**		3 BYTES - rtl addr #1				**		3 BYTES - rtl addr #2				**											** OUTPUT:	--- STACK ---					**		WORD - result						**		3 BYTES - rtl addr #1				**		3 BYTES - rtl addr #2				**											**===========================================*				__EventAvail	PROCySave			SET	1						; my stack offsetsxSave			SET	ySave+2aSave			SET	xSave+2jslAddr			SET	aSave+2rtlAddr2		SET  jslAddr+3				; input parameter stack offsetsrtlAddr1		SET  rtlAddr2+3eventPtr		SET  rtlAddr1+3eventMask		SET  eventPtr+4result			SET  eventMask+2								phb							; space for new rtl addr (3 bytes)				pha												pha							; save registers				phx				phy;------------------------------------------								lda	>skipPreProcess				ora	>noMouseTrap				bne	exit					; don't do any preprocessing				lda	#$FFFF				sta	>skipPreProcess				jsl	EventPreProcess			; do some preprocessing				bcc	@skip				lda	eventMask,s				and	#Å(mDownMask+mUpMask)	; don't let caller see mouse events				sta	eventMask,s@skip			lda	#0				sta	>skipPreProcess;------------------------------------------				exit			lda	>EventAvailPtr+1		; get address of EventAvail routine				sta	jslAddr+1,s				lda	>EventAvailPtr				sta	jslAddr,s				ply							; restore registers				plx				pla				rtl							; go to REAL EventAvail					ENDP*===========================================** GetNextEvent Patch Routine				**											** INPUT:	--- STACK ---					**		WORD - result space					**		WORD - event mask					**		LONG - event record pointer			**		3 BYTES - rtl addr #1				**		3 BYTES - rtl addr #2				**											** OUTPUT:	--- STACK ---					**		WORD - result						**		3 BYTES - rtl addr #1				**		3 BYTES - rtl addr #2				**											**===========================================*__GetNextEvent	PROCySave			SET	1						; my stack offsetsxSave			SET	ySave+2aSave			SET	xSave+2jslAddr			SET	aSave+2rtlAddr2		SET  jslAddr+3				; input parameter stack offsetsrtlAddr1		SET  rtlAddr2+3eventPtr		SET  rtlAddr1+3eventMask		SET  eventPtr+4result			SET  eventMask+2																phb							; space for new rtl addr (3 bytes)				pha									pha							; save registers				phx				phy				;------------------------------------------								lda	>skipPreProcess				ora	>noMouseTrap				bne	exit					; don't do any preprocessing				lda	#$FFFF				sta	>skipPreProcess				jsl	EventPreProcess			; do some preprocessing				bcc	@skip				lda	eventMask,s				and	#Å(mDownMask+mUpMask)	; don't let caller see mouse events				sta	eventMask,s@skip			lda	#0				sta	>skipPreProcess				bra	exit;------------------------------------------	exit			lda	>GetNextEventPtr+1		; get address of real GetNextEvent routine				sta	jslAddr+1,s				lda	>GetNextEventPtr				sta	jslAddr,s				ply							; restore registers				plx				pla								rtl							; go to REAL GetNextEvent					ENDP*===========================================**	Temporarily disable our mouse trap		**											** INPUT:	none							** OUTPUT:	none							**===========================================*DisableMouseTrap	PROC	EXPORT			; pascal void DisableMouseTrap()									lda	#$FFFF				sta	>noMouseTrap				rtl									ENDP*===========================================**	Reenable our mouse trap					**											** INPUT:	none							** OUTPUT:	none							**===========================================*EnableMouseTrap	PROC	EXPORT				; pascal void EnableMouseTrap()									lda	#0				sta	>noMouseTrap				rtl									ENDP				*===========================================**	A patch for QD's SeekRgn routine		**											** This will hopefully fix the bug in QD's	** _ScrollRect routine.  When scrolling a    ** non-rectangular region up, it would hang.	** We fix the problem by patching _SeekRgn.	**											** INPUT:	none							** OUTPUT:	none							**===========================================*MySeekRgn		PROC									ldy  #S_RgnPtr				; SeekRgn uses RgnPtr, but no one inits it!				lda  [StatePtr],y				sta  <RgnPtr				; therefore I'll init it here				iny				iny				lda  [StatePtr],y				sta  <RgnPtr+2				jmp  RealSeekRgnVec			; now its safe to call SeekRgn									ENDP*===========================================**	A patch for QD's UnDrawCursor routine	**											**===========================================*MyUnDrawCursor	PROC	rtlAddrROM01	SET  $3D9E					; _SetCursor's rtl addresses in bank $FErtlAddrROM03	SET  $50A3				pha								lda  >IOwnTheCursor				beq  skip				lda  5,s				and  #$00FF				cmp  #$00FE					; is caller's bank $FE ?				bne  skip				lda  >ROMVersion				cmp  #3				beq  @rom3@rom1				lda  3,s					; is caller _SetCursor ?				cmp  #rtlAddrROM01				bne  skip				bra  abort					; yes, so abort@rom3				lda  3,s					; is caller _SetCursor ?				cmp  #rtlAddrROM03				beq  abort					; yes, so abortskip								pla				jmp  jUnDrawCursor; --- abort the _SetCursor call ---; (ie, don't change the cursor)abort				lda  #$FFFF				sta	 >SmartApp				; assume application is smart about cursors								tsc				clc				adc  #5						; pull a_reg and rtl addr				tcs					plp				pld				jsl  >DECBUSYFLAG								lda  5,s					; move rtl addrs past input (long)				sta  5+4,s				lda  3,s				sta  3+4,s				lda  1,s				sta  1+4,s								pla							; remove input (long)				pla								lda  #0						; return no errors				clc				rtl									ENDP*===========================================**	Patch out the GetEvent toolbox calls	**											** INPUT:	none							** OUTPUT:	none							**===========================================*InstallPatch	PROC	EXPORT				; pascal void InstallPatch()				IMPORT  __GetNextEvent				IMPORT  __EventAvail				phb				phk				plb				stz	skipPreProcess			; initialize flags				stz	noMouseTrap				stz	lastCursor				stz	lastCursor+2								jsr  GetROMVersion				sta  ROMVersion							pha							; get arrow cursor record				pha				_GetCursorAdr				pla				plx				sta	myCursorAddr				stx	myCursorAddr+2				pha							;  get pointer to real routine				pha				pea	0				pea	GetNextEvent				_GetFuncPtr				pla				sta	GetNextEventPtr			; address of real routine				pla				and	#$00FF				sta	GetNextEventPtr+2								pha							;  get pointer to real routine				pha				pea	0				pea	EventAvail				_GetFuncPtr				pla				sta	EventAvailPtr			; address of real routine				pla				and	#$00FF				sta	EventAvailPtr+2								lda  #__GetNextEvent-1		; set to our routine's vector				sta  EMGetNextEvent				lda  #(__GetNextEvent-1)>>16				sta  EMGetNextEvent+2								lda  #__EventAvail-1		; set to our routine's vector				sta  EMEventAvail				lda  #(__EventAvail-1)>>16				sta  EMEventAvail+2				pea	0						; 0 = "a system tool set"				pea	EventToolSet			; tool set number				pea EMCallTable>>16			; ptr to function pointer table				pea	EMCallTable				_SetTSPtr					; patch out call;--- Patch UndrawCursor to monitor _SetCursor calls							php				sei				lda  >UnDrawCursor			; save original UnDrawCursor vector				sta  jUnDrawCursor				lda  >UnDrawCursor+2				sta  jUnDrawCursor+2				lda  _UnDrawCursor			; patch UnDrawCursor vector				sta  >UnDrawCursor				lda  _UnDrawCursor+2				sta  >UnDrawCursor+2					plp;--- Patch SeekRgn to fix a bug in _ScrollRect								pha				_QDVersion				pla				and  #$7fff					; mask out proto type bit				cmp  #$0303					; if QD version ³ 3.02 then don't patch				bcs  @exit								lda  >SeekRgnVec			; save original SeekRgn vector				sta  RealSeekRgnVec				lda  >SeekRgnVec+2				sta  RealSeekRgnVec+2				lda  MySeekRgnVec			; patch SeekRgn vector				sta  >SeekRgnVec				lda  MySeekRgnVec+2				sta  >SeekRgnVec+2@exit			plb				rtl								ENDP				*===========================================**	Remove GetEvent toolbox patches			**											** INPUT:	none							** OUTPUT:	none							**===========================================*RemovePatch		PROC	EXPORT				; pascal void RemovePatch()				phb				phk				plb												lda  RealSeekRgnVec				ora  RealSeekRgnVec+2				beq  @skipQDPatch				php				sei				lda  RealSeekRgnVec			; restore original UnDrawCursor vector				sta  >SeekRgnVec				lda  RealSeekRgnVec+2				sta  >SeekRgnVec+2				plp@skipQDPatch				lda  jUnDrawCursor				ora  jUnDrawCursor+2				beq  @skip2				php				sei				lda  jUnDrawCursor			; restore original UnDrawCursor vector				sta  >UnDrawCursor				lda  jUnDrawCursor+2				sta  >UnDrawCursor+2				plp@skip2				lda	GetNextEventPtr			; get original vector				sta	EMGetNextEvent				lda	GetNextEventPtr+2				sta	EMGetNextEvent+2				ora	GetNextEventPtr				beq	exit								lda	EventAvailPtr			; get original vector				sta	EMEventAvail				lda	EventAvailPtr+2				sta	EMEventAvail+2				ora	EventAvailPtr				beq	exit				pea	0						; 0 = "a system tool set"				pea	EventToolSet			; tool set number				pea EMCallTable>>16			; ptr to function pointer table				pea	EMCallTable				_SetTSPtr				exit			plb				rtl								ENDP								*===============================================** Get the version number of the ROM** In:	none* Out:	a-reg has ROM version	{0,1,2,É}*===============================================*GetROMVersion	PROC				LONGA	ON				LONGI	ON								pha						; space for result (4 words)				pha				pha				pha				pea  0					; a-reg on entry				pea  0					; x-reg on entry				pea  0					; y-reg on entry				pea  IDROUTINE			; firmware routine				_FWEntry				pla						; version number								plx						; ignore the rest				plx				plx				rts				END