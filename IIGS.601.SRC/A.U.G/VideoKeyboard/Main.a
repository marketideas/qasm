*===============================================**						** File:		Main.a				** Project:	Video Keyboard			** Author:	Don J. Brady			** Build file:	MakeFile			**						** Copyright © Apple Computer, Inc. 1989-1992	** All rights reserved.				**===============================================*		INCLUDE	'M16.Memory'		INCLUDE	'M16.MiscTool'		INCLUDE	'M16.QuickDraw'		INCLUDE	'M16.QDAux'		INCLUDE	'M16.Event'		INCLUDE	'M16.Menu'		INCLUDE	'M16.Font'		INCLUDE	'M16.Desk'		INCLUDE	'M16.GSOS'		INCLUDE	'M16.Locator'				INCLUDE	'E16.Memory'		INCLUDE	'E16.Event'		INCLUDE	'E16.MiscTool'		INCLUDE	'E16.Font'		INCLUDE	'E16.Desk'SysPrefsRecGS	RECORD	0;-----------------------------------------------pCount		ds.W	1preferences	ds.W	1;-----------------------------------------------		ENDR FontIDRec	RECORD	0;-----------------------------------------------famNum		ds.W	1fontStyle	ds.B	1fontSize	ds.B	1;-----------------------------------------------		ENDR FontStatRec	RECORD	0;-----------------------------------------------resultID	ds	FontIDRecresultStats	ds.W	1;-----------------------------------------------		ENDR fontManager	equ	$001BattrDP		equ	attrFixed+attrPage+attrBank*===============================================**	The standard NDA Header			**===============================================*NDAHeader	PROC		IMPORT	NDAOpen:CODE		; in NDAMain.c		IMPORT	NDAClose:CODE		IMPORT	NDAAction:CODE		IMPORT	NDAInit:CODE		EXPORT	menuID		EXPORT	menuStr				STRING	ASIS				dc.L	NDAOpen		dc.L	NDAClose		dc.L	NDAAction		dc.L	NDAInit		dc.W	60*4			; period (60 ticks = 1 sec)		dc.W	updateMask+activeMask	; event maskmenuStr		dc.B	'--Video Keyboard\H'	; menu textmenuID		dc.B	'**'		dc.B	13		dc.B	'VKB 1.0,'		; ...for load file dumps		dc.B	'Copyright © Apple Computer, Inc.1989-92';--- Global data for main module				ENTRY	openedopened		dc.W	0		ENTRY	wasOpenedwasOpened	dc.W	0		ENTRY	alreadyShutdownalreadyShutdown	dc.W	1		ENTRY	firstTimefirstTime	dc.W	1		ENTRY	busybusy		dc.W	0		ENTRY	sysPrefRecsysPrefRec	dc.W	1		dc.W	0		ENTRY	fontStatfontStat	ds	FontStatRec		STRING	PASCAL				ENTRY	aboutMenuStraboutMenuStr	dc.B	'About Video Key...'		EXPORT	genevaFontgenevaFont	dc.L	0		ENTRY	languagelanguage	ds.W	1		ENTRY	translationtranslation	ds.W	1		EXPORT	dblTimedblTime		ds.L	1		ENTRY	runCountrunCount	ds.W	1				EXPORT	_ownerid_ownerid	ds.W	1		EXPORT	_menuID_menuID		ds.W	1		EXPORT	_toolErr_toolErr	ds.L	1		ENTRY	eventevent		ds.B	16		ENDP*===============================================** In:	none					**						** Out:	GrafPortPtr (on stack)			**						**===============================================*NDAOpen		PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	KeyStartUp		IMPORT	CreateWindoid		IMPORT	InstallPatch		IMPORT	AboutWindow		IMPORT	RunTask				phb		phk		plb				lda	opened		bne	about		_WaitCursor			; are we guarenteed QDAux ???				lda	firstTime		beq	skip		stz	firstTime		pha		pea	kyBdLang		_ReadBParam		pla		sta	language				pha		_GetKeyTranslation		pla		sta	translationskip		jsl	KeyStartUp				jsl	CreateWindoid		lda	#1		sta	opened		pea	aboutMenuStr>>16	; change menu to 'About VKBÉ'		pea	aboutMenuStr		lda	menuID		pha		_SetMItemName		_InitCursor		jsl	InstallPatch		; called with arrow cursor set				stz	runCount		pea	RunTask>>16		pea	RunTask		_AddToRunQ				bra	exitabout		lda	#1		jsl	AboutWindow@while		pha		pea	mDownMask+keyDownMask		pea	event>>16		pea	event		_GetNextEvent		pla		beq	@while		lda	#0		jsl	AboutWindowexit		plb				lda	#0		sta	4,s		sta	6,s		rtl		ENDP*=======================================** In:	none				**					** Out:	none				**					**=======================================*NDAClose	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	RemovePatch		IMPORT	RunTask		IMPORT	KeyShutDown		IMPORT	DestroyWindoid		phb		phk		plb		lda	opened		beq	exit				pea	menuStr>>16		pea	menuStr		lda	menuID		pha		_SetMItem		pea	RunTask>>16		pea	RunTask		_RemoveFromRunQ		jsl	RemovePatch		jsl	KeyShutDown				jsl	DestroyWindoid		stz	openedexit			plb		rtl		ENDP*=======================================** In:	a-reg has code			**	x,y-reg have event pointer	**					** Out:	a-reg has result flag		**					**=======================================*NDAAction	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	NDARun				phb		phk		plb				ldx	busy		bne	exit		inc	busy		cmp	#runAction		bne	done				jsl	NDARundone		stz	busyexit		plb		lda	#0		rtl		ENDP*=======================================** In:	a-reg 0: shutdown, ­0: startup	**					** Out:	none				**					**=======================================*NDAInit		PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	NDAClose		IMPORT	OpenTask		phb		phk		plb				tax		beq	shutdownstartup		pha			; space for result (word)		_MMStartUp		; find out my user ID		pla		sta	_ownerid				lda	menuID		; get my menu id		sta	_menuID				lda	opened		bne	exit		stz	alreadyShutdown				pea	OpenTask>>16		pea	OpenTask		_AddToRunQ				bra	exitshutdown		lda	alreadyShutdown		bne	exit		inc	alreadyShutdown		lda	opened		sta	wasOpened		jsl	NDAClose		lda	genevaFont		ora	genevaFont+2		beq	exit		lda	genevaFont+2		pha		lda	genevaFont		pha		_DisposeHandle		stz	genevaFont		stz	genevaFont+2exit		plb		rtl				ENDP*===============================================** In:	none					**						** Out:	none					**						**===============================================*NDARun		PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	RedrawWindoid		IMPORT	KeyStartUp	;--- check if keyboard language or translation has changed			pha		_GetKeyTranslation		pha		pea	kyBdLang		_ReadBParam		pla				; get language (a)		plx				; get translation (x)		cmp	language		bne	change		cpx	translation		beq	skipchange		sta	language		stx	translation;		_WaitCursor		jsl	KeyStartUp		jsl	RedrawWindoid;		_InitCursorskip		pha				; fetch current double-click speed		pha		_GetDblTime		pla		plx		sta	dblTime		stx	dblTime+2exit		rtl		ENDP*===============================================** In:	none					**						** Out:	none					**						**===============================================*CheckFM		PROC		LONGA	ON		LONGI	ONoldPref		set	1hadToLoad	set	oldPref+2sysFontHandle	set	hadToLoad+2fontHandle	set	sysFontHandle+4size		set	fontHandle+4fmDPSpace	set	size+4sizeOfFrame	set	fmDPSpace+256		IMPORT	sysPrefRec:SysPrefsRecGS		IMPORT	fontStat:FontStatRec				phd				; make a stack frame		tsc		sec		sbc	#sizeOfFrame		tcs		tcd			stz	<hadToLoad;		lda	#1			; save GS/OS System Preferences;		sta	sysPrefRec.pCount				_GetSysPrefsGS sysPrefRec		lda	sysPrefRec.preferences		sta	<oldPref				ora	#$8000				; set bit 15: display volume mount dialog		and	#$BFFF				; clear bit 14: use standard mount dialog		sta	sysPrefRec.preferences				_SetSysPrefsGS sysPrefRec;--- see if FontManager is active:		pea	0		_FMStatus		pla		bne	active						pea	fontManager		pea	0		_LoadOneTool		bcc	loaded		brl	doneloaded		inc	<hadToLoad		lda	_ownerid		pha		tdc		clc		adc	#fmDPSpace			; offset to DP space		pha		_FMStartUp		bcc	active		brl	skipactive				pha					; save current font		pha		_GetFont		pla		plx		sta	<sysFontHandle		stx	<sysFontHandle+2				pea	$0A00				; install 10pt geneva font		pea	$0003		pea	$0000		_InstallFont		bcs	restore		pea	$0A00		pea	$0003		pea	0		pea	1		pea	fontStat>>16		pea	fontStat		_FindFontStats		bcs	restore				lda	fontStat.resultStats		and	#notFoundBit+unrealBit		bne	restore				; font not found, so skip				pha		pha		_GetFont		pla		plx		sta	<fontHandle		stx	<fontHandle+2				pha		pha		phx		pha		_GetHandleSize		pla		plx		sta	<size		stx	<size+2				pha					; space for result handle		pha		pei	<size+2				; size		pei	<size		lda	_ownerid			; id		pha		pea	attrNoSpec			; attributes		pea	0				; address		pea	0		_NewHandle		pla		plx		sta	genevaFont		stx	genevaFont+2		bcs	restore				pei	<fontHandle+2		pei	<fontHandle		phx		pha		pei	<size+2		pei	<size		_HandToHandrestore		pei	<sysFontHandle+2			; restore current font		pei	<sysFontHandle		_SetFontskip		lda	<hadToLoad		beq	done		_FMShutDown		pea	fontManager		_UnloadOneTooldone		lda	oldPref				; restore GS/OS System Preferences		sta	sysPrefRec.preferences		_SetSysPrefsGS sysPrefRec				tsc		clc		adc	#sizeOfFrame		tcs		pld		rtl*===============================================** In:	none					**						** Out:	none					**						**===============================================*OpenTask	PROC				LONGA	ON		LONGI	ON		IMPORT	CheckFM;--- RunQ Header ---------------		dc.L	0			; link (used by desk mgr)taskPeriod	dc.W	1			; period		dc.W	$A55A			; signature		dc.L	0			; reserved (used by desk mgr);-------------------------------		phb		phk		plb				; use local addressing				lda	#1			; reset the period		sta	taskPeriod		jsl	CheckFM			; load the Font Manager...		lda	wasOpened		beq	done		pha				; space for result		lda	menuID		pha		_OpenNDA		pladone		pea	OpenTask>>16		pea	OpenTask		_RemoveFromRunQ		plb		rtl		ENDP*===============================================** In:	none					**						** Out:	none					**						**===============================================*RunTask		PROC		LONGA	ON		LONGI	ON		IMPORT	NDARun		IMPORT	masterSCBrunPeriod	equ	2			; period for Run Queue task;--- RunQ Header ---------------		dc.L	0			; link (used by desk mgr)taskPeriod	dc.W	runPeriod		; period		dc.W	$A55A			; signature		dc.L	0			; reserved (used by desk mgr);-------------------------------		phb		phk		plb			lda	#runPeriod		; reset the period		sta	taskPeriod; if masterSCB changes on us then close down		pha		_GetMasterSCB		pla		cmp	>masterSCB		beq	safe		jsl	NDAClose		bra	exitsafe		lda	runCount		inc	a		inc	a		sta	runCount		cmp	#60*4		bcc	exit		stz	runCount		jsl	NDARunexit			plb		rtl				ENDP*======================================*		END