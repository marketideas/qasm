ion ---kWidth_320	equ	20kwEsc_320	equ	kWidth_320+2kwTab_320	equ	kWidth_320+kWidth_320/2+2kwCtrl_320	equ	kWidth_320+(kWidth_320*3)/4+2kwShift_320	equ	2*kWidth_320+kWidth_320/4+2kwCap_320	equ	kWidth_320+kWidth_320/4kwCmnd_320	equ	kWidth_320+kWidth_320/2+2kwSpace_320	equ	4*kWidth_320+kWidth_320/2+2kwDel_320	equ	kwTab_320kwRet_320	equ	kwCtrl_320kwOpt_320	equ	kwCap_320kbWidth_320	equ	kwEsc_320+kWidth_320*12+kwDel_320kRows		equ	5dx		equ	2			; offsets inside windowdy		equ	7kbV1		equ	dykbV2		equ	kbV1+kbHeightkbH1		equ	dxkbH2		equ	kbH1+kbWidthkbH2_320	equ	kbH1+kbWidth_320kRowY1		equ	kbV1			; vertical start offsets kRowY2		equ	kRowY1+kHeightkRowY3		equ	kRowY2+kHeightkRowY4		equ	kRowY3+kHeightkRowY5		equ	kRowY4+kHeightkpWidth		equ	kWidth*4kpV1		equ	kbV1kpV2		equ	kbV2kpH1		equ	kbH2+16kpH2		equ	kpH1+kpWidthkpWidth_320	equ	kWidth_320*4kpH1_320	equ	kbH2_320+8kpH2_320	equ	kpH1_320+kpWidth_320;--- Key Flag Bits ---; bits 0-11 is key typekPlain		equ	$00kOption		equ	$01kShift		equ	$02kCaps		equ	$04kApple		equ	$08kControl	equ	$10kModMask	equ	kShift+kOption+kCapskModTypeMask	equ	kShift+kOption+kCaps+kApple+kControlkPicture	equ	$20			; key legend is a picturekPrintable	equ	$40			; key legend is dynamickStatic		equ	$80			; key legend is static (geneva font)kModifier	equ	$0100			; key is a modifierkKeypad		equ	$0200			; key is on keypadkMShift		equ	kModifier+kShiftkMOption	equ	kModifier+kOptionkMCaps		equ	kModifier+kCapskMApple		equ	kModifier+kApplekMControl	equ	kModifier+kControl; Hi nibble is key statekDown		equ	$8000			; key is downkSticky		equ	$4000			; key is stuck (modifiers only);--- ADB Key Events ---keyUp		equ	1keyDown		equ	2keyPress	equ	3		; both (keyUp followed by a keyDown);--- ADB Raw Key Codes ---_ESC		equ	$35_1		equ	$12_2		equ	$13_3		equ	$14_4		equ	$15_5		equ	$17_6		equ	$16_7		equ	$1A_8		equ	$1C_9		equ	$19_0		equ	$1D_MIN		equ	$1B		; '-'_EQU		equ	$18		; '='_DEL		equ	$33_TAB		equ	$30_Q		equ	$0C_W		equ	$0D_E		equ	$0E_R		equ	$0F_T		equ	$11_Y		equ	$10_U		equ	$20_I		equ	$22_O		equ	$1F_P		equ	$23_LB		equ	$21		;  '[' _RB		equ	$1E		;  ']' _CTL		equ	$36		;  CONTROL _A		equ	$00_S		equ	$01_D		equ	$02_F		equ	$03_G		equ	$05_H		equ	$04_J		equ	$26_K		equ	$28_L		equ	$25_SC		equ	$29		;  ';' _QT		equ	$27		;  ''' _CR		equ	$24		;  RETURN _LSF		equ	$38		;  LEFT SHIFT _Z		equ	$06_X		equ	$07_C		equ	$08_V		equ	$09_B		equ	$0B_N		equ	$2D_M		equ	$2E_COM		equ	$2B		;  ',' _PER		equ	$2F		;  '.' _DIV		equ	$2C		;  '/' _RSF		equ	$38		; RIGHT SHIFT_CAP		equ	$39		; CAPS LOCK_OPT		equ	$3A		; OPTION	_CMD		equ	$37		; COMMAND	_BQT		equ	$32		; '`'		_SPC		equ	$31		; SPACE	_BSL		equ	$2A		; '\'		_LAW		equ	$3B		; LEFT ARROW_RAW		equ	$3C		; RIGHT ARROW_DAW		equ	$3D		; DOWN ARROW_UAW		equ	$3E		; UP ARROW	_padCLR		equ	$47		; keypad CLEAR_padEQU		equ	$51		; keypad '='_padDIV		equ	$4B		; keypad '/'_padMUL		equ	$43		; keypad '*'_pad7		equ	$59		; keypad '7'_pad8		equ	$5B		; keypad '8'_pad9		equ	$5C		; keypad '9'_padPLU		equ	$45		; keypad '+'_pad4		equ	$56		; keypad '4'_pad5		equ	$57		; keypad '5'_pad6		equ	$58		; keypad '6'_padMIN		equ	$4E		; keypad '-'_pad1		equ	$53		; keypad '1'_pad2		equ	$54		; keypad '2'_pad3		equ	$55		; keypad '3'_padENT		equ	$4C		; keypad ENTER_pad0		equ	$52		; keypad '0'_padPER		equ	$41		; keypad '.'numBoardKeys	equ	62numPadKeys	equ	18numTotalKeys	equ	numBoardKeys+numPadKeysnumModKeys	equ	5;--- Mod Key Keyboard indexes ---iDelete		equ	13iControl	equ	27iLeftShift	equ	40iRightShift	equ	51iCapsLock	equ	52iOption		equ	53iCommand	equ	54iPadPeriod	equ	17+numBoardKeys;--- Keyboard languages	---	maxLanguages	equ	10klUSA		equ	0klUK		equ	1klFrench	equ	2klDanish	equ	3klSpanish	equ	4klItalian	equ	5klGerman	equ	6klSwedish	equ	7klDvorak	equ	8klCanadian	equ	9picDY		equ	8picDX		equ	16picDX_320	equ	8rKeyTrans	EQU	$8021;--- mod key bits for KEYMODREG:KEYMODREG	equ	$E1C025kmrApple	equ	%10000000kmrOption	equ	%01000000kmrKeypad	equ	%00010000kmrRepeat	equ	%00001000kmrCapsLock	equ	%00000100kmrControl	equ	%00000010kmrShift	equ	%00000001TickCount	equ	$E100DC			; global tick count