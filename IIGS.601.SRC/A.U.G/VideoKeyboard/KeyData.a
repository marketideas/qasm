IOP@|'		DC.B	'¥ASDFGHJKL;''¥'		DC.B	'¥ZXCVBNM,.{¥'		DC.B	'¥¥¥~¥`¥¥¥¥' 		EXPORT	layoutslayouts		DC.W	layoutUSA		DC.W	layoutUSA		; UK has same layout as USA */		DC.W	layoutFrench		DC.W	layoutDanish		DC.W	layoutSpanish		DC.W	layoutItalian		DC.W	layoutGerman		DC.W	layoutSwedish		DC.W	layoutDvorak		DC.W	layoutCanadian; strings for special key legends:		STRING	PASCALstrESC		DC.B	'esc'strDEL		DC.B	'delete'strTAB		DC.B	'tab'strCTRL		DC.B	'control'strSHIFT	DC.B	'shift'strCAPS		DC.B	'caps'strOPT		DC.B	'opt'strCLR		DC.B	'clr'strAPPLE	DC.B	1,17			; apple symbolstrEQU		DC.B	'='strDIV		DC.B	'/'strMUL		DC.B	'*'strMIN		DC.B	'-'strPLUS		DC.B	'+'		EXPORT	strPERstrPER		DC.B	' . 'str9		DC.B	'9'str8		DC.B	'8'str7		DC.B	'7'str6		DC.B	'6'str5		DC.B	'5'str4		DC.B	'4'str3		DC.B	'3'str2		DC.B	'2'str1		DC.B	'1'str0		DC.B	'0'		DC.B	0		EXPORT	keyskeys						; keyboard is an array of keys;--- row 1 (14 keys) ---		DC.W	kStatic, _ESC, kHeight, kwEsc, kwEsc_320, kRowY1, kbH1		DC.L	strESC		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _1, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _2, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*1		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _3, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*2		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _4, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*3		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _5, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*4		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _6, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*5		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _7, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*6		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _8, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*7		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _9, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*8		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _0, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*9		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _MIN, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*10		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kPrintable, _EQU, kHeight, kWidth, kWidth_320, kRowY1, kbH1+kwEsc+kWidth*11		DC.L	0		DC.B	0,0,0,0,0,0				DC.W	kStatic,    _DEL, kHeight, kwDel, kwDel_320, kRowY1, kbH1+kwEsc+kWidth*12		DC.L	strDEL		DC.B	0,0,0,0,0,0	;--- row 2 (13 keys) ---		DC.W	kStatic, _TAB, kHeight, kwTab, kwTab_320, kRowY2, kbH1		DC.L	strTAB		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _Q, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _W, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*1		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _E, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*2		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _R, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*3		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _T, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*4		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _Y, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*5		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _U, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*6		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _I, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*7		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _O, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*8		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _P, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*9		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _LB, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*10		DC.L	0		DC.B	0,0,0,0,0,0		DC.W	kPrintable, _RB, kHeight, kWidth, kWidth_320, kRowY2, kbH1+kwTab+kWidth*11		DC.L	0		DC.B	0,0,0,0,0,0;--- row 3 (13 keys) ---		DC.W	kMControl+kStatic, _CTL, kHeight, kwCtrl, kwCtrl