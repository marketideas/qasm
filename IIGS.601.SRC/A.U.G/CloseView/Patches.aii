************************************************************************************** File:		Patches.aii* Project:	Close View GS* Author:	Don J. Brady** Copyright © Apple Computer, Inc. 1989-1992* All rights reserved.*************************************************************************************** Modification History:** 12/05/89	DJB	File created today* 26-Aug-91	DAL	Support smooth-launch (fiddled with patches for QDStartUp*			and ClearScreen)* 3-Feb-92	DAL	ClearScreen patch checks whether QD is active, and becomes*			transparent if not.* 4-Feb-92	DAL	QDStartUp patch checks if we are being called from AWGS*			1.1v2; if so, we disable ourselves.  Not compatible.* 9-Feb-92	DAL	QDShutDown removes Run Queue; search for date for others.*************************************************************************************  	IF	(&TYPE('DEBUG') = 'UNDEFINED') THEN DEBUG 	EQU	0  	ENDIF		PRINT	NOPAGE		PRINT	NOGEN		PRINT	OFF				INCLUDE	'M16.Memory'		; toolbox macros		INCLUDE	'M16.Locator'		INCLUDE	'M16.MiscTool'		INCLUDE	'M16.Quickdraw'		INCLUDE	'M16.Event'		INCLUDE	'M16.Control'		INCLUDE	'M16.Window'		INCLUDE	'M16.Menu'		INCLUDE	'M16.LineEdit'		INCLUDE	'M16.Scheduler'		INCLUDE	'M16.TextEdit'		INCLUDE	'M16.Font'		INCLUDE	'M16.Desk'		INCLUDE	'E16.QuickDraw'		; toolbox equates		INCLUDE	'E16.Event'		INCLUDE	'E16.Window'		INCLUDE	'CloseView.equ'		PRINT	ON;--- toolbox references:QDToolSet	equ	$04QDStartUp	equ	$0204			; QD routines that we patchQDShutDown	equ	$0304ClearScreen	equ	$1504SetSCB		equ	$1204GetSCB		equ	$1304SetAllSCBs	equ	$1404InitPort	equ	$1904OpenPort	equ	$1804HideCursor	equ	$9004InvertRect	equ	$5604SetCursor	equ	$8E04SetColorEntry	equ	$1004GetColorEntry	equ	$1104SetColorTable	equ	$0E04GetColorTable	equ	$0F04ShieldCursor	equ	$E01E98			; QD vectors that we patchDrawCursor	equ	$E01FCCUnDrawCursor	equ	$E01FD0ROM1DrawCursor	equ	$FE40C3			; ROM offsets (ick)ROM3DrawCursor	equ	$FE53A7ROM1UnDrawCursor equ	$FE41D8ROM3UnDrawCursor equ	$FE54CAEMToolSet	equ	$06EMStartUp	equ	$0206			; EM routines that we patchGetNextEvent	equ	$0A06EventAvail	equ	$0B06GetOSEvent	equ	$1606OSEventAvail	equ	$1706GetMouse	equ	$0C06Button		equ	$0D06StillDown	equ	$0E06WaitMouseUp	equ	$0F06;---  standard bottleneck procedures:StdText		equ	$E01E04StdLine		equ	$E01E08StdRect		equ	$E01E0CStdRRect	equ	$E01E10StdOval		equ	$E01E14StdArc		equ	$E01E18StdPoly		equ	$E01E1CStdRgn		equ	$E01E20StdPixels	equ	$E01E24StdComment	equ	$E01E28StdTxMeas	equ	$E01E2CStdTxBnds	equ	$E01E30StdGetPic	equ	$E01E34StdPutPic	equ	$E01E38scLnIntHnd	equ	$0AkybdIntHnd	equ	$0FcrsrUpdtHnd	equ	$18IDROUTINE	equ	$FE1F			; firmware id routine*===============================================**						** _QDStartUp Patch Routine			**						**===============================================*MyQDStartUp	PROC		LONGA	ON		LONGI	ON		IMPORT	CoreStartUp		; external routines		IMPORT	ClearRealScreen		IMPORT	PatchCursor		IMPORT	Beep		IMPORT	PatchFinder		IMPORT	MySystemTask		IMPORT	GetCVDefaults		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	ScreenHandle		IMPORT	QDStartUpVec		IMPORT	MyUserID		IMPORT	NeedToPost		IMPORT	QDGlobalsaSave		SET	1			; my stack offsetsdSave		SET	aSave+2bSave		SET	dSave+2rtlAddr2	SET	bSave+1			; input parameter stack offsetsrtlAddr1	SET	rtlAddr2+3userID		SET	rtlAddr1+3maxWidth	SET	userID+2masterSCB	SET	maxWidth+2dPageAddr	SET	masterSCB+2paramSize	SET	4*2								phb				; save registers		phd		pha				phk				; allow access to globals		plb				tsc				; make a stack frame		tcd				stz	CVStat.noScreen		; assume we'll get screen*** added 4-Feb-92 DAL -- check for incompatible applications!		lda 4+5,s		tax		lda 6+5,s		and #$00ff		jsr CheckAppCompatibility	;in: AX=caller's address, out=clc/sec		bcs @notCompatible*** end 4-Feb-92		pha				; space for handle (long)		pha				pea	0			; size of screen: $8000 (long)		pea	$8000		lda	MyUserID		pha				; user id (word)		pea	%0100000000000011	; attributes: fixed, fixed address and bank		pea	VirtualScreen>>16	; screen address (long)		pea	|VirtualScreen		_NewHandle		pla				; save the handle		plx		sta	ScreenHandle		stx	ScreenHandle+2		bcc	ok;--- add task to alert user and disable menu:@notCompatible		inc	CVStat.noScreen		; no CloseView under current application!		jsr	GetCVDefaults		; get defaults from BRAM		lda	CVStat.wasOn		sta	NeedToPost		pea	MySystemTask>>16		pea	MySystemTask		_AddToRunQok		lda	<dPageAddr		sta	QDGlobals		;;;		lda	<masterSCB;;;		and	#$7FFF			; clr UseShadowing bit;;;		sta	<masterSCB*** optimized 4-Feb-92 DAL		lda #$8000		trb <masterSCB*** end 4-Feb-92;--- call QDStartUp:				pei	<dPageAddr		pei	<masterSCB		pei	<maxWidth		pei	<userID				sep	#$20			; pass callers rtl addr (3 bytes)		lda	<rtlAddr1+2		pha		rep	#$20		pei	<rtlAddr1		lda	<aSave			; restore a-reg (WAP)		jsl	QDStartUpVec		sta	<aSave			; save error code				tsc				; clean up stack		clc		adc	#3			; remove caller's rtl addr		tcs		;--- do some post proccessing:		lda	CVStat.noScreen		bne	skip			; skip if we don't have a virtual screen*** added 26-Aug-91 DAL -- if MasterSCB $0100 is set, don't clear screen		lda <MasterSCB		and #$0100		bne @1		jsr	ClearRealScreen*** added 3-Dec-91 DAL -- if not clearing screen, copy it		bra @done@1		pea $00e1		pea $2000	;source = $00e12000		pea $0001		pea $2000	;dest = $00012000		pea $0000		pea $7d00	;length = $00007d00		_BlockMove@done*** end 3-Dec-91*** end 26-Aug-91		jsr	PatchCursor		jsr	CoreStartUp*** Removed 9-Feb-92 DAL	;		phd;		lda	<dSave			; set DP to caller's DP (appl or _StartUpTools);		tcd;		jsr	PatchFinder		; fix bug in Finder 1.3;		pld		;--- clean up stack and return:skip				lda	<rtlAddr1+1		; move up original rtl addrs		sta	<rtlAddr1+paramSize+1		lda	<rtlAddr1		sta	<rtlAddr1+paramSize		lda	<rtlAddr2+1		sta	<rtlAddr2+paramSize+1		lda	<rtlAddr2		sta	<rtlAddr2+paramSize				ldx	<aSave			; save a copy of error code in x		pla				; unlink			pld		plb		tsc		clc		adc	#paramSize		tcs		txa				; get error code		cmp	#1			; adjust carry flag		rtl				; return to tool dispatcher*** added 4-Feb-92 DAL************************************************************************************** CheckAppCompatibility** Input: AX = return address from QDStartUp call** Output: ** Method:  Check the size of the calling block and the position of the*          QDStartUp call within that block.** The Bank register is already set to the program bank.*************************************************************************************CheckAppCompatibility		stx qdStartOffset		pha		pha	;space for FindHandle result		pha		phx		_FindHandle		plx		pla		beq @noHandle		pha		pha	;space for GetHandleSize result		pha		phx	;calling block's handle***		phd		tsc		tcd		sec		lda qdStartOffset		sbc [3]		sta qdStartOffset		pld***		_GetHandleSize		pla		sta qdBlockSize		pla		ldx #badAppTableEnd-badAppTable-4@search		lda qdBlockSize		cmp badAppTable,x		bne @next		lda qdStartOffset		cmp badAppTable+2,x		bne @next;		sec		;return SEC = bad		rts@next		dex		dex		dex		dex		bpl @search@noHandle	clc		rtsqdBlockSize	dc.w 0qdStartOffset	dc.w 0badAppTable	dc.w $8000,$0118badAppTableEnd*** end 4-Feb-92		ENDP		*===============================================** _QDShutDown Patch Routine			**						**===============================================*MyQDShutDown	PROC				LONGA	ON		LONGI	ON		IMPORT	UnPatchCursor		; external routines		IMPORT	RestoreSCBs		IMPORT	UnPatchKeys		IMPORT	CoreShutDown		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	ScreenHandle		IMPORT	QDShutDownVec		import	MySystemTask								phb				; save registers		pha		phx		phy				phk				; allow access to globals		plb*** added 9-Feb-92 DAL -- No point in notifying the user that the application***   they used to be in was not compatible with CloseView.		pea	MySystemTask>>16		pea	MySystemTask		_RemoveFromRunQ			; remove ourself from the queue*** end 9-Feb-92		lda	CVStat.noScreen		; did we have a virtual screen?		bne	skip			; no, so skip		jsr	UnPatchCursor		jsr	CoreShutDown		lda	ScreenHandle+2		pha		lda	ScreenHandle		pha		_DisposeHandle			; get rid of virtual screen		stz	ScreenHandle		stz	ScreenHandle+2		lda	#1		sta	CVStat.noScreen		; we gave it away…skip		ply				; restore registers		plx		pla		plb		jmp	QDShutDownVec		; go to REAL QDShutDown				ENDP*===============================================** _EMStartUp Patch Routine			**						**===============================================*MyEMStartUp	PROC		LONGA	ON		LONGI	ON		IMPORT	PatchKeys		; external routines		IMPORT	Refresh		IMPORT	EMStartUpVec		; global data		IMPORT	CVStat:CVStatusRecaSave		SET	1			; my stack offsetsdSave		SET	aSave+2bSave		SET	dSave+2rtlAddr2	SET	bSave+1			; input parameter stack offsetsrtlAddr1	SET	rtlAddr2+3userID		SET	rtlAddr1+3yMaxClamp	SET	userID+2yMinClamp	SET	yMaxClamp+2xMaxClamp	SET	yMinClamp+2xMinClamp	SET	xMaxClamp+2queueSize	SET	xMinClamp+2dPageAddr	SET	queueSize+2paramSize	SET	7*2														phb				; save registers		phd		pha				phk				; allow short addressing (globals)		plb				tsc				; make a stack frame		tcd		;--- call EMStartUp:				pei	<dPageAddr		pei	<queueSize		pei	<xMinClamp		pei	<xMaxClamp		pei	<yMinClamp		pei	<yMaxClamp		pei	<userID				sep	#$20			; pass callers rtl addr (3 bytes)		lda	<rtlAddr1+2		pha		rep	#$20		pei	<rtlAddr1		lda	<aSave			; restore a-reg (WAP)		jsl	EMStartUpVec		sta	<aSave				tsc				; clean up stack		clc		adc	#3			; remove caller's rtl addr		tcs		;--- do some post proccessing:		lda	CVStat.noScreen		; did we get a screen?		bne	skip			; no, so skip		jsr	PatchKeys		jsr	Refreshskip				lda	<rtlAddr1+1		; move up original rtl addrs		sta	<rtlAddr1+paramSize+1		lda	<rtlAddr1		sta	<rtlAddr1+paramSize		lda	<rtlAddr2+1		sta	<rtlAddr2+paramSize+1		lda	<rtlAddr2		sta	<rtlAddr2+paramSize				ldx	<aSave			; save a copy of error code in x		pla				; unlink			pld		plb		tsc		clc		adc	#paramSize		tcs		txa				; get error code		cmp	#1			; adjust carry flag		rtl				; return to tool dispatcher				ENDP		*===============================================** _ClearScreen Patch Routine			**						**===============================================*MyClearScreen	PROC				LONGA	ON		LONGI	ON		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	ClearScreenVecbSave		set	1			; stack offsetsaSave		set	bSave+1rtlAddr2	set	aSave+2rtlAddr1	set	rtlAddr2+3colorWord	set	rtlAddr1+3		phb				; save registers		pha		*** added 3-Feb-92 DAL -- if QD isn't active yet, pass ClearScreen straight through		tax		beq real*** end 3-Feb-92		lda	>CVStat.noScreen	; do we have a virtual screen?		bne	real			; no*** added 26-Aug-91 DAL -- if MasterSCB bit $0100 is on, a smooth launch is*** in progress, so we should not do much of anything		pha		_GetMasterSCB		pla		and #$0100		bne real*** end 26-Aug-91 DAL		_HideCursor		pea	$0101			; push on the bank of virtual screen		plb				; set bank twice to		plb				; clear stack		lda	colorWord,s		ldx	#160*200-2@loop		sta	|VirtualScreen,x		dex		dex		bpl	@loop				_ShowCursor		lda	rtlAddr1+1,s		; move up rtl addresses		sta	rtlAddr1+1+2,s		lda	rtlAddr1,s		sta	rtlAddr1+2,s		lda	rtlAddr2+1,s		sta	rtlAddr2+1+2,s		lda	rtlAddr2,s		sta	rtlAddr2+2,s				pla				; restore registers		plb		pla				; remove input param		lda	#0			; no errors		clc		rtl;--- call real routine instead:real		pla				; restore registers		plb		jmp	ClearScreenVec		; go to REAL ClearScreen				ENDP*===============================================** _SetSCB Patch Routine				**						**===============================================*MySetSCB	PROC				LONGA	ON		LONGI	ON		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	ChangeSCBs		IMPORT	VirtualSCBs		IMPORT	SetSCBVecrtlAddr2	set	1			; stack offsetsrtlAddr1	set	rtlAddr2+3newSCB		set	rtlAddr1+3scanLine	set	newSCB+2		pha				; save a-reg		lda	>CVStat.magnify		beq	skip			; skip patch when NOT (magnify AND enabled)		lda	>CVStat.enabled		beq	skip		pla				; discard saved a-reg		lda	scanLine,s		cmp	#200		bcc	ok		ldx	#$0452		bra	done			; bad scan line errorok		tax		lda	newSCB,s				sep	#$20			; only store one byte		sta	>VirtualSCBs,x		rep	#$20				lda	#1		sta	>ChangeSCBs		; force update later				ldx	#0			; no errorsdone				lda	rtlAddr1+1,s		; move up rtl addresses		sta	rtlAddr1+1+4,s		lda	rtlAddr1,s		sta	rtlAddr1+4,s		lda	rtlAddr2+1,s		sta	rtlAddr2+1+4,s		lda	rtlAddr2,s		sta	rtlAddr2+4,s				pla				; remove input params		pla		txa				; pass back error code		cmp	#1		rtl;--- call real routine instead:skip		pla				; restore a-reg		jmp	SetSCBVec		; go to REAL SetSCB				ENDP*===============================================** _SetAllSCBs Patch Routine			**						**===============================================*MySetAllSCBs	PROC				LONGA	ON		LONGI	ON		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	ChangeSCBs		IMPORT	VirtualSCBs		IMPORT	SetAllSCBsVec		IMPORT	ModeSwitchrtlAddr2	set	1			; stack offsetsrtlAddr1	set	rtlAddr2+3newSCB		set	rtlAddr1+3		pha				; save a-reg		lda	>CVStat.enabled 	; skip patch when NOT enabled		beq	skip					lda	newSCB+2,s		and	#$0080			; mask out 640 bit		pha				; save result on stack		lda	>CVStat.magnify		bne	@mag		lda	>SCBData		; check it against a real SCB		bra	@mask@mag		lda	>VirtualSCBs		; check it against a virtual SCB@mask		and	#$0080			; mask out 640 bit		cmp	1,s			; are they the same?		beq	same			; yes, so skip			lda	#1		sta	>ModeSwitch		; tell core that we're switching modessame		pla				; remove scratch space				lda	>CVStat.magnify		beq	skip			; skip rest of patch when NOT magnify		pla				; discard saved a-reg		lda	newSCB,s		sep	#$20		LONGA	OFF		ldx	#200-2@loop		sta	>VirtualSCBs,x		; save as virtual SCBs		dex		bpl	@loop		rep	#$20		LONGA	ON				lda	#1		sta	>ChangeSCBs		; force update later				ldx	#0			; no errorsdone				lda	rtlAddr1+1,s		; move up rtl addresses		sta	rtlAddr1+1+2,s		lda	rtlAddr1,s		sta	rtlAddr1+2,s		lda	rtlAddr2+1,s		sta	rtlAddr2+1+2,s		lda	rtlAddr2,s		sta	rtlAddr2+2,s				pla				; remove input param		txa				; pass back error code		cmp	#1		rtl;--- call real routine instead:skip		pla				; restore a-reg		jmp	SetAllSCBsVec		; go to REAL SetAllSCBs				ENDP*===============================================** _GetSCB Patch Routine				**						**===============================================*MyGetSCB	PROC				LONGA	ON		LONGI	ON		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	VirtualSCBs		IMPORT	GetSCBVecrtlAddr2	set	1			; stack offsetsrtlAddr1	set	rtlAddr2+3scanLine	set	rtlAddr1+3scbData		set	scanLine+2paramSize	set	2		pha				; save a-reg		lda	>CVStat.magnify		beq	skip			; skip patch when NOT (magnify AND enabled)		lda	>CVStat.enabled		beq	skip		pla				; discard saved a-reg		lda	scanLine,s		cmp	#200		bcc	ok		ldx	#$0452		bra	done			; bad scan line errorok		tax		lda	>VirtualSCBs,x		and	#$00FF		sta	scbData,s				ldx	#0			; no errorsdone				lda	rtlAddr1+1,s		; move up rtl addresses		sta	rtlAddr1+1+paramSize,s		lda	rtlAddr1,s		sta	rtlAddr1+paramSize,s		lda	rtlAddr2+1,s		sta	rtlAddr2+1+paramSize,s		lda	rtlAddr2,s		sta	rtlAddr2+paramSize,s				pla				; remove input param		txa				; pass back error code		cmp	#1		rtl;--- call real routine instead:skip		pla				; restore a-reg		jmp	GetSCBVec		; go to REAL GetSCB				ENDP*===============================================** _OpenPort & _InitPort Patch Routines		**						**===============================================*MyOpenPort	PROC		LONGA	ON		LONGI	ON		IMPORT	Temp			; global data		IMPORT	OpenPortVec		IMPORT	InitPortVec		IMPORT	CVStat:CVStatusRecrtlAddrB	SET	1rtlAddrA	SET	rtlAddrB+3portPtrCopy	SET	rtlAddrA+3aSave		SET	portPtrCopy+4frameSize	SET	aSave+2-rtlAddrBrtlAddr2	SET	aSave+2			; input parameter stack offsetsrtlAddr1	SET	rtlAddr2+3portPtr		SET	rtlAddr1+3								pha				; save a-reg register		lda	#$0000		sta	>Temp		bra	start;-----------------------------------------------				ENTRY	MyInitPortMyInitPort				pha				; save a-reg register		lda	#$FFFF		sta	>Temp;-----------------------------------------------		start				tsc				; space for new stack frame		sec		sbc	#frameSize-2		tcs								lda	portPtr,s		; copy the port pointer		sta	portPtrCopy,s		lda	portPtr+2,s		sta	portPtrCopy+2,s				lda	rtlAddr1+1,s		; copy the caller's addr		sta	rtlAddrA+1,s		lda	rtlAddr1,s		sta	rtlAddrA,s				lda	#(Continue-1)>>8	; set rtl address to us		sta	rtlAddrB+1,s		lda	#(Continue-1)		sta	rtlAddrB,s				lda	aSave,s			; restore a register		lda	>Temp		bne	@init		lda	aSave,s			; restore a register		jmp	OpenPortVec		; go to REAL OpenPort@init		lda	aSave,s			; restore a register		jmp	InitPortVec		; go to REAL InitPort;-----------------------------------------------	ContinuedpSave		SET	1			; my new stack offsetsaSave		SET	dpSave+2rtlAddrB	SET	aSave+2aSaveOld	SET	rtlAddrB+3rtlAddr2	SET	aSaveOld+2		; original input parameter stack offsetsrtlAddr1	SET	rtlAddr2+3portPtr		SET	rtlAddr1+3		pha				; save error code		phd				; save dp-reg			tsc		tcd				; make a frame		;--- change the port's LocInfo -----------------		lda	>CVStat.noScreen	; is there a virtual screen		bne	skip			; no, so skip		ldy	#3		lda	#$0120			; move port image to bank $01 (was at $E1)		sta	[<portPtr],y;--- done with changes -------------------------skip		lda	rtlAddr1+1,s		; move up original rtl addrs (by 4)		sta	rtlAddr1+1+4,s		lda	rtlAddr1,s		sta	rtlAddr1+4,s		lda	rtlAddr2+1,s		sta	rtlAddr2+1+4,s		lda	rtlAddr2,s		sta	rtlAddr2+4,s				lda	aSave,s			; save a copy of error code		sta	aSaveOld+4,s		pld				; restore dp-reg		tsc				; remove garbage from stack		clc		adc	#4+3+2		tcs		pla				; restore a-reg				cmp	#1			; restore carry flag		rtl				; return to caller				ENDP		*===============================================** _SetColorEntry Patch Routine			**						**===============================================*MySetColorEntry	PROC				LONGA	ON		LONGI	ON		aSave		set	1rtlAddr2	set	aSave+2			; stack offsetsrtlAddr1	set	rtlAddr2+3newColor	set	rtlAddr1+3entryNumber	set	newColor+2tableNumber	set	entryNumber+2		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	SetColorEntryVec				pha				; save a;--- IF enabled AND (NOT magnify) AND invert THEN flip color		lda	>CVStat.enabled		beq	skip		lda	>CVStat.magnify		bne	skip		lda	>CVStat.invert		beq	skip				lda	newColor,s		; if color is black or white then flip it		and	#$0FFF		beq	flip			; $000 is black		cmp	#$0FFF			; $FFF is white		bne	skip			; ignore everything elseflip		eor	#$0FFF		sta	newColor,sskip		pla				; restore a		jmp	SetColorEntryVec	; go to REAL SetColorEntry				ENDP*===============================================** _GetColorEntry Patch Routine			**						**===============================================*MyGetColorEntry	PROC				LONGA	ON		LONGI	ON		dSave		SET	1			; my stack offsetsbSave		SET	dSave+2aSave		SET	bSave+1rtlAddr2	SET	aSave+2			; input parameter stack offsetsrtlAddr1	SET	rtlAddr2+3entryNumber	set	rtlAddr1+3tableNumber	set	entryNumber+2result		set	tableNumber+2paramSize	SET	2*2		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	GetColorEntryVec				pha;--- IF enabled AND (NOT magnify) AND invert THEN flip color		lda	>CVStat.enabled		beq	skip		lda	>CVStat.magnify		bne	skip		lda	>CVStat.invert		beq	skip		phb				; save registers		phd				phk				; allow access to globals		plb				tsc				; make a stack frame		tcd		pha				; space for result		pei	<tableNumber		pei	<entryNumber		sep	#$20		lda	<rtlAddr1+2		pha		rep	#$20		pei	<rtlAddr1		lda	<aSave			; restore a-reg (WAP)		jsl	GetColorEntryVec		sta	<aSave			; save error code				tsc		clc		adc	#5			; remove result and callers rtl address		tcs		; now do some post processing:		lda	<result			; if color is black or white then flip it		and	#$0FFF		beq	flip			; $000 is black		cmp	#$0FFF			; $FFF is white		bne	done			; ignore everything elseflip		eor	#$0FFF		sta	<result; --- clean up and return:done				lda	<rtlAddr1+1		; move up original rtl addrs		sta	<rtlAddr1+paramSize+1		lda	<rtlAddr1		sta	<rtlAddr1+paramSize		lda	<rtlAddr2+1		sta	<rtlAddr2+paramSize+1		lda	<rtlAddr2		sta	<rtlAddr2+paramSize				ldx	<aSave			; save a copy of error code in x		pld				; unlink			plb		pla		tsc		clc		adc	#paramSize		tcs		txa				; get error code		cmp	#1			; adjust carry flag		rtl				; return to tool dispatcher;--- don't do any patching:skip		pla				; restore a		jmp	GetColorEntryVec	; go to REAL GetColorEntry				ENDP*===============================================** _SetColorTable Patch Routine			**						**===============================================*MySetColorTable	PROC				LONGA	ON		LONGI	ON		ySave		set	1			; stack offsetsaSave		set	ySave+2dSave		set	aSave+2bSave		set	dSave+2rtlAddr2	set	bSave+1rtlAddr1	set	rtlAddr2+3srcTablePtr	set	rtlAddr1+3tableNumber	set	srcTablePtr+4		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	TempColorTable		IMPORT	SetColorTableVec		phb		phd		pha		phy				phk		plb		;--- IF enabled AND (NOT magnify) AND invert THEN flip colors		lda	CVStat.enabled		beq	skip		lda	CVStat.magnify		bne	skip		lda	CVStat.invert		beq	skip		tsc				; make a stack frame		tcd				ldy	#32-2@loop				lda	[<srcTablePtr],y	; if color is black or white then flip it		and	#$0FFF		beq	@flip			; $000 is black		cmp	#$0FFF			; $FFF is white		bne	@ok			; ignore everything else@flip		eor	#$0FFF@ok		sta	TempColorTable,y		dey		dey		bpl	@loop				lda	#TempColorTable		; change pointer to our table		sta	<srcTablePtr		lda	#TempColorTable>>16		sta	<srcTablePtr+2skip				ply		pla		pld		plb		jmp	SetColorTableVec	; go to REAL SetColorTable				ENDP*===============================================** _GetColorTable Patch Routine			**						**===============================================*MyGetColorTable	PROC				LONGA	ON		LONGI	ONdSave		set	1			; stack offsetsrtlAddr2	set	dSave+2rtlAddr1	set	rtlAddr2+3destTablePtr	set	rtlAddr1+3tableNumber	set	destTablePtr+4paramSize	set	6		IMPORT	CVStat:CVStatusRec	; global data		IMPORT	GetColorTableVec		pha;--- IF enabled AND (NOT magnify) AND invert THEN flip colors		lda	>CVStat.enabled		beq	skip		lda	>CVStat.magnify		bne	skip		lda	>CVStat.invert		beq	skip		pla		phd				tsc				; make a stack frame		tcd				lda	<tableNumber		inc	a		asl	a			; ((a + 1) * 32) - 2		asl	a		asl	a		asl	a		asl	a		dec	a		dec	a		tax		ldy	#32-2@loop		lda	>ColorTableData,x	; if color is black or white then flip it		and	#$0FFF		beq	@flip			; $000 is black		cmp	#$0FFF			; $FFF is white		bne	@ok			; ignore everything else@flip		eor	#$0FFF@ok		sta	[<destTablePtr],y		dex		dex		dey		dey		bpl	@loop		lda	<rtlAddr1+1		; move up original rtl addrs		sta	<rtlAddr1+paramSize+1		lda	<rtlAddr1		sta	<rtlAddr1+paramSize		lda	<rtlAddr2+1		sta	<rtlAddr2+paramSize+1		lda	<rtlAddr2		sta	<rtlAddr2+paramSize		pld				; clean up stack		pla		pla		pla		lda	#0			; return no error		clc		rtl; don't patch:skip		pla		jmp	GetColorTableVec	; just go to REAL GetColorTable		ENDP*===============================================** _InvertRect Patch Routine			**						**===============================================*MyInvertRect	PROC		LONGA	ON		LONGI	ONySave		SET	1			; stack offsetsxSave		SET	ySave+2	aSave		SET	xSave+2dSave		SET	aSave+2bSave		SET	dSave+2rtlAddr2	SET	bSave+1			; input parameter stack offsetsrtlAddr1	SET	rtlAddr2+3rectPtr		SET	rtlAddr1+3		IMPORT	InvertRectVec		IMPORT	RecordIBar		IMPORT	Temp:Rect		IMPORT	CVStat:CVStatusRec		phb				; save registers		phd		pha		phx		phy		phk				; use local addresses		plb				lda	CVStat.enabled		beq	skip		tsc				; make a stack frame		tcd		ldy	#6@loop		lda	[<rectPtr],y		; get a copy of the rect		sta	Temp,y		dey		dey		bpl	@loop				lda	Temp.right		; could this be an insertion bar?		sec		sbc	Temp.left		cmp	#1		bne	skip			; nope, too fat				jsr	RecordIBarskip				ply				; restore registers		plx		pla		pld		plb		jmp	InvertRectVec		; go to REAL InvertRect			ENDP*===============================================** _SetCursor Patch Routine			**						**===============================================*MySetCursor	PROC		LONGA	ON		LONGI	ON				IMPORT	SetCursorVec		IMPORT	ChangeCursor		IMPORT	DirtyScreen		pha				; save a-reg				lda	#1		sta	>ChangeCursor		; remember to update later		sta	>DirtyScreen				pla				; restore a-reg		jmp	SetCursorVec		; go to REAL SetCursor			ENDP*===============================================**						** In:	Temp has IBar rect			** Out:	IBarFound, IBarHeight, IBarPt		**						**===============================================*RecordIBar	PROC		LONGA	ON		LONGI	ONminHeight	SET	3maxHeight	SET	40		IMPORT	IBarFound		; global data		IMPORT	IBarHeight		IMPORT	IBarPt:Point		IMPORT	Temp:Rect		lda	Temp.top		cmp	Temp.bottom		bcc	ok		ldx	Temp.bottom		; switch them		stx	Temp.top		sta	Temp.bottomok		lda	Temp.bottom		sec		sbc	Temp.top		; a <-- height of  insertion bar		cmp	#minHeight		bcc	exit			; too short		cmp	#maxHeight+1		bcs	exit			; too tall		sta	IBarHeight		lsr	a				clc		adc	Temp.top		sta	IBarPt.v		; mid point		lda	Temp.left		sta	IBarPt.h				pea	IBarPt>>16		pea	IBarPt		_LocalToGlobal		lda	#1		sta	IBarFound	exit		rts				ENDP		*===============================================** _GetNextEvent Patch Routine			**						**===============================================*MyGetNextEvent	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	GetNextEventVec				pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	GetNextEventVec		; go to REAL GetNextEvent		ENDP*===============================================** _GetOSEvent Patch Routine			**						**===============================================*MyGetOSEvent	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	GetOSEventVec		pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	GetOSEventVec		; go to REAL GetOSEvent						ENDP*===============================================** _EventAvail Patch Routine			**						**===============================================*MyEventAvail	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	EventAvailVec		pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	EventAvailVec		; go to REAL EventAvail						ENDP*===============================================** _OSEventAvail Patch Routine			**						**===============================================*MyOSEventAvail	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	OSEventAvailVec		pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	OSEventAvailVec		; go to REAL OSEventAvail						ENDP*===============================================** _GetMouse Patch Routine			**===============================================*MyGetMouse	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	GetMouseVec				pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	GetMouseVec		; go to REAL GetMouse				ENDP		*===============================================** _Button Patch Routine				**===============================================*MyButton	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	ButtonVec				pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	ButtonVec		; go to REAL Button				ENDP*===============================================** _StillDown Patch Routine			**===============================================*MyStillDown	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	StillDownVec				pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	StillDownVec		; go to REAL StillDown				ENDP		*===============================================** _WaitMouseUp Patch Routine			**===============================================*MyWaitMouseUp	PROC		LONGA	ON		LONGI	ON		IMPORT	Refresh		IMPORT	WaitMouseUpVec				pha				; save registers		phx		phy				jsr	Refresh				ply				; restore registers		plx		pla		jmp	WaitMouseUpVec		; go to REAL WaitMouseUp				ENDP*===============================================** _*BootInit Patch Routine			**						**===============================================*MyBootInit	PROC		LONGA	ON		LONGI	ON		rtl				; just return				ENDP*===============================================** Patch for QD's ShieldCursor routine		**===============================================*MyShieldCursor	PROC			LONGA	ON		LONGI	ONminRect		SET	0top		SET	0left		SET	top+2bottom		SET	left+2right		SET	bottom+2		IMPORT	RealShieldCursor	; global data		IMPORT	DirtyScreen		IMPORT	CVStat:CVStatusRec		IMPORT	IBarOn		IMPORT	IBarFound		IMPORT	LastMinRect:Rect		IMPORT	Temp:Rect		IMPORT	Refresh			; external routines		IMPORT	RecordIBar		IMPORT	AddRefreshTask		phb				; save registers		pha		phx		phy				phk		plb; IF enabled THEN...				lda	CVStat.enabled				bne	ok		brl	doneok		lda	#1		sta	DirtyScreen		; virtual screen has new data				lda	IBarOn			; are we looking for an insertion bar?		beq	task		lda	IBarFound		bne	task				lda	<minRect+right		sec		sbc	<minRect+left		cmp	#1		bne	task				lda	<minRect+top		cmp	LastMinRect.top		bne	skip		sta	Temp.top		lda	<minRect+left		cmp	LastMinRect.left		bne	skip		sta	Temp.left		lda	<minRect+bottom		cmp	LastMinRect.bottom		sta	Temp.bottom		bne	skip		lda	<minRect+right		cmp	LastMinRect.right		bne	skip		sta	Temp.right				pea	0		_TEStatus			; only do this awlful kludge if TextEdit active		pla		beq	skip		jsr	RecordIBarskip		lda	<minRect+top		sta	LastMinRect.top		lda	<minRect+left		sta	LastMinRect.left		lda	<minRect+bottom		sta	LastMinRect.bottom		lda	<minRect+right		sta	LastMinRect.righttask		jsr	AddRefreshTask		; add post QD drawing task; ...ENDIF		done		ply				; restore registers		plx		pla		plb		jmp	RealShieldCursor		ENDP*===============================================**	Add a task to refresh us again		**===============================================*AddRefreshTask	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	TaskInQueue		; global data		IMPORT	Refresh			; external routines		lda	>TaskInQueue		bne	done			; already in queue				pha		pea	RefreshTask>>16		pea	RefreshTask		_SchAddTask			; add a task to refresh later		pla		bcs	done		sta	>TaskInQueuedone		rts		;-----------------------------------------------RefreshTask		php		cli				; bug in scheduler turns interrrupts off		lda	#0		sta	>TaskInQueue		jsr	Refresh			plp		rtl		ENDP*===============================================** Patch for QD's DrawCursor routine		**===============================================*MyDrawCursor	PROC		LONGA	ON		LONGI	ON				IMPORT	DirtyMouse		IMPORT	CursorOff		IMPORT	NextMouse:Point		IMPORT	CVStat:CVStatusRec		IMPORT	ROMVersion				lda	>CVStat.enabled		; IF enabled THEN ...		beq	skip		lda	>CursorOff		bne	abort		lda	#1		sta	>DirtyMouse; remember this cursor position:		lda	>EMYPos			; current mouse Y		sta	>NextMouse.v		lda	>EMXPos			; current mouse X		sta	>NextMouse.hskip		phb		pea	$0101			; virtual screen is in bank $01		plb		plb				lda	>ROMVersion		cmp	#3		beq	@rom3		cmp	#1		beq	@rom1		plb		bra	abort@rom1		jml	ROM1DrawCursor@rom3		jml	ROM3DrawCursorabort						; don't draw a cursor yet		clc		rtl		ENDP*===============================================** Patch for QD's UnDrawCursor routine		**===============================================*MyUnDrawCursor	PROC		LONGA	ON		LONGI	ON		IMPORT	DirtyMouse		IMPORT	CursorOff		IMPORT	CVStat:CVStatusRec		IMPORT	ROMVersion		lda	>CVStat.enabled		; IF enabled THEN ...		beq	skip		lda	>CursorOff		; if CursorOff then don't undraw		bne	abort		lda	#1		sta	>DirtyMouseskip		phb		pea	$0101			; virtual screen is in bank $01		plb		plb		lda	>ROMVersion		cmp	#3		beq	@rom3		cmp	#1		beq	@rom1		plb		bra	abort@rom1		jml	ROM1UnDrawCursor@rom3		jml	ROM3UnDrawCursorabort						; don't undraw cursor yet		clc		rtl				ENDP		*===============================================** _HideCursor Patch Routine			**===============================================*MyHideCursor	PROC		LONGA	ON		LONGI	ON				IMPORT	DirtyScreen		IMPORT	HideCursorVec		pha				; save a-reg				lda	#1		sta	>DirtyScreen				pla				; restore a-reg		jmp	HideCursorVec		; go to REAL HideCursor				ENDP*===============================================** Patch for cursor update handler		**						** IN:	none					** OUT:	carry clr if we handled key		**===============================================*MyCursorUpdate	PROC		LONGA	OFF			; called in 8-bit mode!		LONGI	OFF		IMPORT	CursorUpdateVec		IMPORT	CVStat:CVStatusRec		IMPORT	CursorOff		IMPORT	DirtyMouse		IMPORT	NextMouse:Point				lda	>CVStat.enabled		; IF enabled AND magnify THEN ...		beq	skip		lda	>CVStat.magnify		beq	skip		lda	>DirtyMouse		beq	skip		lda	#1		sta	>CursorOff		jsl	CursorUpdateVec	 	; visit real routine								lda	#0		sta	>CursorOff		rtlskip		jmp	CursorUpdateVec	 	; jump to real routine								ENDP*===============================================** Patch for keyboard interupt handler		**						** IN:	none					** OUT:	carry clr if we handled key		**===============================================*KeyFilter	PROC		LONGA	OFF			; called in 8-bit mode!		LONGI	OFF		IMPORT	Change			; global variables used		IMPORT	CVStat:CVStatusRec			IMPORT	KeyboardVec		IMPORT	IBarOn		IMPORT	IBarFound			mApple		equ	$80mOption		equ	$40mControl	equ	$20mShift		equ	$10upArrow		equ	$0BdownArrow	equ	$0A; first check modifiers					lda	>KEYMODREG		and	#mApple+mOption+mShift+mControl		cmp	#mApple+mOption		beq	@check; should we track insertion bar?		and	#mApple+mControl		bne	@skip			; if Apple or Control then skip		lda	>KBD		bpl	@skip			; no key if hi bit not set		lda	#1		sta	>IBarOn		lda	#0		sta	>IBarFound		bra	@skip; now check for a key@check		lda	>CVStat.usekeys		; do we use key equivalents?		beq	@skip			; no, so skip		lda	>KBD		bpl	@skip			; key is only valid if hi bit set		and	#$7F		cmp	#'o'		beq	@o		cmp	#'O'		beq	@o		cmp	#'x'		beq	@x		cmp	#'X'		beq	@x		cmp	#'i'		beq	@i		cmp	#'I'		beq	@i		cmp	#upArrow		beq	@up		cmp	#downArrow		beq	@down		@skip		jmp	KeyboardVec	 	; jump to real routine						@o		lda	#cfOnOff		bra	@change@x		lda	#cfMagnify		bra	@change@up		lda	#cfPowerUp		bra	@change@down		lda	#cfPowerDown		bra	@change@i				lda	#cfInvert@change					ora	>Change		sta	>Change			; just set the bits here, handle it later@exit					sta	>KBDSTRB		; clear key strobe		clc				; carry clear = we handled this interrupt		rtl		ENDP*===============================================** Patch for StdLine bottleneck procedure	**===============================================*MyStdLine	PROC		LONGA	ON		LONGI	ONportRef		SET	$24pnSizeX		SET	opnSize+2lineY1		SET	$A6lineX1		SET	lineY1+2lineY2		SET	lineX1+2lineX2		SET	lineY2+2		IMPORT	StdLineVec		IMPORT	RecordIBar		IMPORT	CVStat:CVStatusRec		IMPORT	TEMP:Rect						phb				; save registers		pha		phx		phy				phk				; allow local addressing		plb		lda	CVStat.enabled		beq	skip; IF (pnSizeX = 1) AND (pnMode = modeXOR) AND (lineX1 = lineX2) THEN		ldy	#pnSizeX		; pen size		lda	[<portRef],y		cmp	#1		bne	skip		ldy	#opnMode		; pen mode		lda	[<portRef],y		and	#$7FFF			; ignore 'NOT' bit		cmp	#modeXOR		bne	skip		lda	<lineX1		cmp	<lineX2		bne	skip				lda	<lineY1		sta	Temp.top		lda	<lineX1		sta	Temp.left		lda	<lineY2		sta	Temp.bottom		lda	<lineX2		sta	Temp.right		jsr	RecordIBar; ENDIFskip				ply				; restore registers		plx		pla		plb		jmp	StdLineVec		; jump to real routine								ENDP*===============================================**						**===============================================*PatchCursor	PROC		LONGA	ON		LONGI	ON		IMPORT	MyDrawCursor		IMPORT	MyUnDrawCursor		IMPORT	MyCursorUpdate				IMPORT	RealDrawCursor		IMPORT	RealUnDrawCursor		IMPORT	CursorUpdateAddr;--- patch CursorUpdate:		pha				; space for vector (long)		pha		pea	scLnIntHnd		_GetVector		pla		plx		cmp	#MyCursorUpdate		bne	@set		cpx	#MyCursorUpdate>>16		beq	@skip			; we're already patched			@set		sta	>CursorUpdateAddr		txa		sta	>CursorUpdateAddr+2					pea	scLnIntHnd		pea	MyCursorUpdate>>16		pea	MyCursorUpdate		_SetVector@skip;--- patch DrawCursor:				php		sei		lda	>DrawCursor		; patch DrawCursor		sta	>RealDrawCursor		lda	>DrawCursor+2		sta	>RealDrawCursor+2		lda	#MyDrawCursor		sta	>DrawCursor+1		lda	#MyDrawCursor>>8		sta	>DrawCursor+2;--- patch UnDrawCursor:		lda	>UnDrawCursor		sta	>RealUnDrawCursor		lda	>UnDrawCursor+2		sta	>RealUnDrawCursor+2		lda	#MyUnDrawCursor		sta	>UnDrawCursor+1		lda	#MyUnDrawCursor>>8		sta	>UnDrawCursor+2				plp		rts*===============================================**						**===============================================*UnPatchCursor	PROC				LONGA	ON		LONGI	ON		IMPORT	RealDrawCursor		IMPORT	RealUnDrawCursor		IMPORT	CursorUpdateAddr		;--- unpatch CursorUpdate vector:				pea	scLnIntHnd		lda	>CursorUpdateAddr+2		pha		lda	>CursorUpdateAddr		pha		_SetVector@skip;--- unpatch Draw/UnDraw Cursor:		php		sei		lda	>RealDrawCursor		sta	>DrawCursor		; unpatch DrawCursor		lda	>RealDrawCursor+2		sta	>DrawCursor+2		lda	>RealUnDrawCursor		sta	>UnDrawCursor		; unpatch UnDrawCursor		lda	>RealUnDrawCursor+2		sta	>UnDrawCursor+2		plp		rts				ENDP				*===============================================**						** IN:	none					** OUT:	none					**===============================================*PatchKeys	PROC	EXPORT		LONGA	ON		LONGI	ON		Import	KeyBoardPatched		Import	KeyboardAddr		pha		pha		pea	kybdIntHnd		_GetVector		pla		plx		cmp	#KeyFilter		bne	@set		cpx	#KeyFilter>>16		beq	@exit			; we're already patched			@set		sta	>KeyboardAddr		txa		sta	>KeyboardAddr+2					pea	kybdIntHnd		pea	KeyFilter>>16		pea	KeyFilter		_SetVector					lda	#1		sta	>KeyBoardPatched			@exit		rts		ENDP			*===============================================**						** IN:	none					** OUT:	none					**===============================================*UnPatchKeys	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	KeyBoardPatched		IMPORT	KeyboardAddr					pea	kybdIntHnd		lda	>KeyboardAddr+2		pha		lda	>KeyboardAddr		pha		_SetVector					lda	#0		sta	>KeyBoardPatched		rts		ENDP*** Removed 9-Feb-92 DAL	if 0 then	*===============================================**		Patch the Finder!		** This will fix a bug in Finder 1.3 that makes	** CloseView look bad. The Finder's custom drag	** rect routine has a hardcoded "pea  $E1E1".	** This patch changes it to a "pea  $0101". This ** patch routine should only be called if we get	** a virtual screen (in bank 1).			**						** This patch knows that Finder 1.3 uses the	** _StartUpTools call, and that it has a main	** segment size of $F346 bytes.*						** In future Finders (> 1.3), the bug will be	** fixed.  So this patch can be omited if/when	** the new Finder comes out.			**						** IN:	DP register is set to the Caller's	**	(of _QDStartUp)	DP.			**						** OUT:	none					**						**===============================================*PatchFinder	PROC		LONGA	ON		LONGI	ONmainSegSize	set	$F346			; size of Finder's main segmentmainSegOffset	set	$256F			; offset to offending coderetAddr2	set	36			; StartUpTools DP offsetsretAddr1	set	retAddr2+3startRec	set	retAddr1+3startRecFlag	set	startRec+4userID		set	startRecFlag+2result		set	userID+2; check if user ID is valid:		lda	<userID		and	#$FF00			; mask out id type		cmp	#$1000			; is it an application ?		bne	exit		; check if address is valid:		lda	<retAddr1+2		and	#$00FF			; mask out bank		cmp	#$0002		bcc	exit			; not bank 0 or 1		cmp	#$80		bcs	exit			; not in ROM				pha				; space	for result handle		pha		pha				; address of application segment		pei	<retAddr1		_FindHandle			; find handle of calling application		pla		plx		bcs	exit			; error, so skip		phx				; save a copy of the handle		pha; check if segment is the right size:		pha				; space for result (long)		pha		phx				; handle		pha		_GetHandleSize		pla		plx		bne	skip			; too big, so skip		bcs	skip			; error, so skip		cmp	#mainSegSize		bne	skip			; wrong size, so skip; now check for offending Finder code:		tsc		tcd				; make a frame				ldy	#2			; dereference handle		lda	[<1],y		tax		lda	[<1]		sta	<1		stx	<3				ldy	#mainSegOffset		lda	[<1],y			; code:  "pea $E1E1; plb; plb; rts"		cmp	#$E1F4		bne	skip		iny		iny		lda	[<1],y		cmp	#$ABE1		bne	skip		iny		iny		lda	[<1],y		cmp	#$60AB		bne	skip; code was found, so patch it!		ldy	#mainSegOffset+1		lda	#$0101			; change to 'pea  $0101'		sta	[<1],y		skip		pla				; remove copy of handle		plxexit		rts		ENDP	endif*===============================================**	Install permanent Toolbox patches	**						** Input:	*** Stack ***			**		rtlAddr - 3 BYTES		**	sp --->					**						** Output:	*** Stack ***			**		result - LONG			**		rtlAddr - 3 BYTES		**	sp --->					**===============================================*InstallPatches	PROC	EXPORT		LONGA	ON		LONGI	ON		IMPORT	MyBootInit		IMPORT	MyQDStartUp		IMPORT	MyQDShutDown		IMPORT	MyClearScreen		IMPORT	MySetSCB		IMPORT	MyGetSCB		IMPORT	MySetAllSCBs		IMPORT	MySetColorEntry		IMPORT	MyGetColorEntry		IMPORT	MySetColorTable		IMPORT	MyGetColorTable		IMPORT	MyOpenPort		IMPORT	MyInitPort		IMPORT	MyInvertRect		IMPORT	MySetCursor		IMPORT	MyHideCursor		IMPORT	MyEMStartUp		IMPORT	MyGetNextEvent		IMPORT	MyEventAvail		IMPORT	MyGetOSEvent		IMPORT	MyOSEventAvail		IMPORT	MyGetMouse		IMPORT	MyButton		IMPORT	MyStillDown		IMPORT	MyWaitMouseUp		IMPORT	QDStartUpAddr		IMPORT	QDShutDownAddr		IMPORT	ClearScreenAddr		IMPORT	SetSCBAddr		IMPORT	GetSCBAddr		IMPORT	SetAllSCBsAddr		IMPORT	SetColorEntryAddr		IMPORT	GetColorEntryAddr		IMPORT	SetColorTableAddr		IMPORT	GetColorTableAddr		IMPORT	InitPortAddr		IMPORT	OpenPortAddr		IMPORT	InvertRectAddr		IMPORT	SetCursorAddr		IMPORT	HideCursorAddr		IMPORT	EMStartUpAddr		IMPORT	GetNextEventAddr		IMPORT	EventAvailAddr		IMPORT	GetOSEventAddr		IMPORT	OSEventAvailAddr		IMPORT	GetMouseAddr		IMPORT	ButtonAddr		IMPORT	StillDownAddr		IMPORT	WaitMouseUpAddr		IMPORT	MyUserID		IMPORT	StdLineVec		IMPORT	RealShieldCursor		firstLocal	set	1			; local variablestsPtr		set	firstLocalfptPtr		set	tsPtr+4	tblSize		set	fptPtr+4handle		set	tblSize+4lastLocal	set	handle+4localSize	set	lastLocal-firstLocal		tsc				; make a stack frame		sec		sbc	#localSize		tcs		phd				; save current dp		tcdbegin		ldx	#QDStartUp		lda	#QDStartUpAddr		jsr	GetFunctionAddr				ldx	#QDShutDown		lda	#QDShutDownAddr		jsr	GetFunctionAddr				ldx	#ClearScreen		lda	#ClearScreenAddr		jsr	GetFunctionAddr				ldx	#SetSCB		lda	#SetSCBAddr		jsr	GetFunctionAddr				ldx	#GetSCB		lda	#GetSCBAddr		jsr	GetFunctionAddr				ldx	#SetAllSCBs		lda	#SetAllSCBsAddr		jsr	GetFunctionAddr				ldx	#SetColorEntry		lda	#SetColorEntryAddr		jsr	GetFunctionAddr				ldx	#GetColorEntry		lda	#GetColorEntryAddr		jsr	GetFunctionAddr				ldx	#SetColorTable		lda	#SetColorTableAddr		jsr	GetFunctionAddr				ldx	#GetColorTable		lda	#GetColorTableAddr		jsr	GetFunctionAddr				ldx	#InitPort		lda	#InitPortAddr		jsr	GetFunctionAddr				ldx	#OpenPort		lda	#OpenPortAddr		jsr	GetFunctionAddr		ldx	#InvertRect		lda	#InvertRectAddr		jsr	GetFunctionAddr		ldx	#SetCursor		lda	#SetCursorAddr		jsr	GetFunctionAddr		ldx	#HideCursor		lda	#HideCursorAddr		jsr	GetFunctionAddr		ldx	#EMStartUp		lda	#EMStartUpAddr		jsr	GetFunctionAddr		ldx	#GetNextEvent		lda	#GetNextEventAddr		jsr	GetFunctionAddr		ldx	#EventAvail		lda	#EventAvailAddr		jsr	GetFunctionAddr		ldx	#GetOSEvent		lda	#GetOSEventAddr		jsr	GetFunctionAddr		ldx	#OSEventAvail		lda	#OSEventAvailAddr		jsr	GetFunctionAddr		ldx	#GetMouse		lda	#GetMouseAddr		jsr	GetFunctionAddr		ldx	#Button		lda	#ButtonAddr		jsr	GetFunctionAddr		ldx	#StillDown		lda	#StillDownAddr		jsr	GetFunctionAddr		ldx	#WaitMouseUp		lda	#WaitMouseUpAddr		jsr	GetFunctionAddr		; patch out QD functions:		ldx	#QDToolSet		jsr	GetToolSetAddr		ldy	#(QDStartUp>>8)<<2		lda	#MyQDStartUp-1		jsr	SetFunctionAddr						ldy	#(QDShutDown>>8)<<2		lda	#MyQDShutDown-1		jsr	SetFunctionAddr						ldy	#(ClearScreen>>8)<<2		lda	#MyClearScreen-1		jsr	SetFunctionAddr						ldy	#(SetSCB>>8)<<2		lda	#MySetSCB-1		jsr	SetFunctionAddr						ldy	#(GetSCB>>8)<<2		lda	#MyGetSCB-1		jsr	SetFunctionAddr						ldy	#(SetAllSCBs>>8)<<2		lda	#MySetAllSCBs-1		jsr	SetFunctionAddr						ldy	#(SetColorEntry>>8)<<2		lda	#MySetColorEntry-1		jsr	SetFunctionAddr						ldy	#(GetColorEntry>>8)<<2		lda	#MyGetColorEntry-1		jsr	SetFunctionAddr						ldy	#(SetColorTable>>8)<<2		lda	#MySetColorTable-1		jsr	SetFunctionAddr						ldy	#(GetColorTable>>8)<<2		lda	#MyGetColorTable-1		jsr	SetFunctionAddr						ldy	#(InitPort>>8)<<2		lda	#MyInitPort-1		jsr	SetFunctionAddr						ldy	#(OpenPort>>8)<<2		lda	#MyOpenPort-1		jsr	SetFunctionAddr		ldy	#(InvertRect>>8)<<2		lda	#MyInvertRect-1		jsr	SetFunctionAddr						ldy	#(SetCursor>>8)<<2		lda	#MySetCursor-1		jsr	SetFunctionAddr						ldy	#(HideCursor>>8)<<2		lda	#MyHideCursor-1		jsr	SetFunctionAddr				ldx	#QDToolSet		jsr	SetToolSetAddr; patch out stdLine bottleneck procedure:		php		sei				lda	>StdLine+2		; first save original vector		sta	StdLineVec+2		lda	>StdLine		sta	StdLineVec		lda	#MyStdLine>>8		; now add our vector		sta	>StdLine+2		lda	#MyStdLine<<8		ora	#$005C			; 'jml' instruction		sta	>StdLine;--- patch shield cursor:		lda	>ShieldCursor		sta	>RealShieldCursor		lda	>ShieldCursor+2		sta	>RealShieldCursor+2		lda	#MyShieldCursor		sta	>ShieldCursor+1		lda	#MyShieldCursor>>8		sta	>ShieldCursor+2		plp; patch out EM functions:		ldx	#EMToolSet		jsr	GetToolSetAddr		ldy	#(EMStartUp>>8)<<2		lda	#MyEMStartUp-1		jsr	SetFunctionAddr		ldy	#(GetNextEvent>>8)<<2		lda	#MyGetNextEvent-1		jsr	SetFunctionAddr						ldy	#(EventAvail>>8)<<2		lda	#MyEventAvail-1		jsr	SetFunctionAddr						ldy	#(GetOSEvent>>8)<<2		lda	#MyGetOSEvent-1		jsr	SetFunctionAddr						ldy	#(OSEventAvail>>8)<<2		lda	#MyOSEventAvail-1		jsr	SetFunctionAddr						ldy	#(GetMouse>>8)<<2		lda	#MyGetMouse-1		jsr	SetFunctionAddr						ldy	#(Button>>8)<<2		lda	#MyButton-1		jsr	SetFunctionAddr		ldy	#(StillDown>>8)<<2		lda	#MyStillDown-1		jsr	SetFunctionAddr						ldy	#(WaitMouseUp>>8)<<2		lda	#MyWaitMouseUp-1		jsr	SetFunctionAddr		ldx	#EMToolSet		jsr	SetToolSetAddr		_SetDefaultTPT			; permanently install these patches!end		pld				; restore dp		tsc		clc		adc	#localsize		tcs				rts;-----------------------------------------------; In:	x-reg set to toolset number;; Out:	fptPtr;;-----------------------------------------------GetToolSetAddr		pha				; space for pointer (long)		pha		pea	0			; 0 = system tool set		phx				; tool set number		_GetTSPtr		pla		plx		sta	<tsPtr		stx	<tsPtr+2		lda	[<tsPtr]		; calculate the size of the table		asl	a		asl	a			; size is count * 4		sta	<tblSize		stz	<tblSize+2		pha				; space for handle (long)		pha				pei	<tblSize+2		; size		pei	<tblSize		lda	MyUserID		pha				; user id		pea	%0100000000011000	; fixed, no bank cross, no special		pea	0			; address (long), not used		pea	0		_NewHandle		pla		plx		sta	<handle		stx	<handle+2		bcc	good		brl	end		good		ldy	#2		lda	[<handle],y		tax		lda	[<handle]		sta	<fptPtr		stx	<fptPtr+2				lda	#0			; zero out new table		ldy	<tblSize		dey		dey@loop		sta	[<fptPtr],y		dey		dey		bpl	@loop				lda	<tblSize		lsr	a		lsr	a		sta	[<fptPtr]		; set function table count				rts;-----------------------------------------------; In:	x-reg set to toolset number;	fptPtr;; Out:	none;;-----------------------------------------------SetToolSetAddr; always patch bootinit:		ldy	#4		lda	#MyBootInit-1		sta	[<fptPtr],y		; set new BootInit function pointer		iny		iny		lda	#MyBootInit>>16		sta	[<fptPtr],y		pea	0			; 0 = system tool set		phx				; tool set number		pei	<fptPtr+2		; pointer to new function pointer table		pei	<fptPtr		_SetTSPtr		rts;-----------------------------------------------; In:	x-reg set to function/toolset number;	a-reg set to destination addr;; Out:	none;; assumes code & data are in the same bank!;-----------------------------------------------GetFunctionAddr		pha				; save destination addr				pha				; space for addr (long)		pha		pea	0			; 0 = system tool set		phx				; function/toolset number		_GetFuncPtr		pla		plx		inc	a			; adjust addr (was addr-1)		bne	@store		inx@store		ply				; get destination addr		sta	|$0000,y		txa		sta	|$0002,y				rts		;-----------------------------------------------; In:	y-reg set to function number*4;	a-reg set to new function addr-1;	fptPtr points to function table;; Out:	none;;-----------------------------------------------SetFunctionAddr		sta	[<fptPtr],y		; set new function pointer		iny		iny		lda	#InstallPatches>>16	; bank of our new functions		sta	[<fptPtr],y		rts						ENDP*===============================================** Add a shutdown task to the GS/OS notification	** queue.					**						** In:	none					** Out:	none					**===============================================*AddShutdownTask	PROC	EXPORT		LONGA	ON		LONGI	ON				IMPORT	SetCVDefaults		pea	NotifyParams>>16		pea	NotifyParams		_AddNotifyProc		rtsNotifyParams	dc.W	1			; pcount		dc.L	ShutdownTask		; task pointer;------------------------------------------------;	This task is called when the system;	is being shutdown (or restarted).;; In:	none; Out:	none;------------------------------------------------ShutdownTask;--- Standard Notify Queue Header ---------------Header		dc.L	0			; next task link		dc.W	0			; reserved		dc.W	$A55A			; signature		dc.L	neShutDown		; event maskEventCode	dc.L	0			; event code;------------------------------------------------		phk		plb				lda	EventCode		cmp	#neShutDown		bne	exit				jsr	SetCVDefaults		; write default values to BRAMexit		rtl		ENDP*===============================================** Get the version number of the ROM		**						** In:	none					** Out:	a-reg has ROM version	{0,1,2,…}	**===============================================*GetROMVersion	PROC	EXPORT		LONGA	ON		LONGI	ON		pha				; space for result (4 words)		pha		pha		pha		pea	0			; a-reg on entry		pea	0			; x-reg on entry		pea	0			; y-reg on entry		pea	IDROUTINE		; firmware routine		_FWEntry		pla				; version number		plx				; ignore the rest		plx		plx		rts		ENDP*===============================================** In:	a, x point to text			**	y has lenght of text			**						** Out:	none					**						**===============================================*PostAlert	PROC		LONGA	ON		LONGI	ONaboutDY		equ	83+22aboutDX		equ	302aboutY1		equ	((200-aboutDY)/2)-10aboutY2		equ	aboutY1+aboutDYaboutX1		equ	(640-aboutDX)/2aboutX1_320	equ	(320-aboutDX)/2iconY1		equ	3iconX1		equ	6iconWidth	equ	14			; byte width of icon		IMPORT	Temp		IMPORT	MyWinList:WindParamList		IMPORT	MyEvent:Event		IMPORT	IconLocInfo:LocInfo	; found in NDA segment				sta	StringPtr		; save text pointer		stx	StringPtr+2		sty	StringLength		; save lenght of text				pha		pha		_GetPort			; save the current port				lda	#fAlert+fVis		sta	myWinList.wFrameBits		lda	#aboutY1		sta	myWinList.wPosition.top		lda	#aboutY2		sta	myWinList.wPosition.bottom		pha		_GetMasterSCB		pla		sta	>IconLocInfo.portSCB		and	#mode640		beq	@320@640		lda	#aboutX1		bra	@set@320		lda	#aboutX1_320;@set		sta	myWinList.wPosition.left		clc		adc	#aboutDX		sta	myWinList.wPosition.right		pha		pha		pea	myWinList>>16		pea	myWinList		_NewWindow			; create the window		pla		plx		sta	aboutWinPtr		stx	aboutWinPtr+2		bcc	@good		brl	exit			; couldn't get window@good				phx		pha		_SetPort				pha				; space for handle		pha		lda	aboutWinPtr+2		pha				; window ptr (long)		lda	aboutWinPtr		pha		pea	controlRect>>16		; bounds Rect ptr		pea	controlRect		pea	StrOK>>16		pea	StrOK		pea	$01			; flag = bold button		pea	0			; initial value		pea	0			; param1		pea	0			; param2		pea	0			; defProcPtr = simple button (long)		pea	0		pea	0			; refcon (long)		pea	0		pea	0			; color table ptr		pea	0		_NewControl		pla		plx		sta	myHandle		stx	myHandle+2; draw Alert contents:				ldx	#iconWidth*4		lda	>IconLocInfo.portSCB		and	#$0080				; is it 640?		bne	@setRight			; yes		ldx	#iconWidth*2			; no, so adjust@setRight		txa		sta	>IconLocInfo.boundsRect.right		pea	IconLocInfo>>16		pea	IconLocInfo		pea	IconLocInfo.boundsRect>>16		pea	IconLocInfo.boundsRect		pea	iconX1		pea	iconY1		pea	0		_PPToPort		lda	StringPtr+2		; ptr to text		pha		lda	StringPtr		pha		lda	StringLength		; text length		pha		pea	textRect>>16		; bounds rect		pea	textRect		pea	0			; left justified		_LETextBox2				lda	aboutWinPtr+2		pha				; window ptr (long)		lda	aboutWinPtr		pha		_DrawControls; wait for user:@while		pha		pea	mDownMask+keyDownMask		pea	myEvent>>16		pea	myEvent		_GetNextEvent		pla		beq	@while				lda	myEvent.what		cmp	#keyDownEvt		bne	@mouse@key		lda	myEvent.message		and	#$00FF		cmp	#$000D		bne	@while				pea	2		lda	myHandle+2		pha		lda	myHandle		pha		_HiLiteControl			; hilite the button		bra	close@mouse		cmp	#mouseDownEvt		bne	@while				pha				; space for result		pea	Temp>>16		pea	Temp		lda	myEvent.where.h		pha		lda	myEvent.where.v		pha		lda	aboutWinPtr+2		pha		lda	aboutWinPtr		pha		_FindControl		pla		beq	@while				pha				; space for result		lda	myEvent.where.h		pha		lda	myEvent.where.v		pha		pea	0			; actionProc = nil		pea	0		lda	myHandle+2		pha		lda	myHandle		pha		_TrackControl		pla		bne	close		brl	@whileclose		ldx	aboutWinPtr+2		lda	aboutWinPtr		phx		pha		_CloseWindowexit		_SetPort			; restore the current port		rtsStringPtr	ds.L	1StringLength	ds.W	1aboutWinPtr	ds.L	1myHandle	ds.L	1		STRING	PASCALStrOK		dc.B	'OK'textRect	dc.W	4,80,aboutDY-8,aboutDX-10controlRect	dc.W	aboutDY-20,aboutDX/2-40,aboutDY-5,aboutDX/2+40		ENDP*===============================================**      System task				**						** IN:	none					** OUT:	none					**===============================================*MySystemTask	PROC		LONGA	ON		LONGI	ON				IMPORT	menuID		IMPORT	MyUserID		IMPORT	NeedToPost		IMPORT	HadToLoadFM		IMPORT	PostAlert		IMPORT	BeeptaskTicks	set	1			; 60 ticks = 1 secondfontManager	equ	$001B*-----------------------------------------------TaskHeader		dc.L	0			; link (used by desk mgr)TaskCount	dc.W	taskTicks		; tick count		dc.W	$A55A			; signature		dc.L	0			; reserved*-----------------------------------------------		phb		phk		plb		pea	MySystemTask>>16		pea	MySystemTask		_RemoveFromRunQ			; remove ourself from the queue*** added 9-Feb-92 DAL -- make sure Menu Mgr is here before we call it		pea 0		_MenuStatus		pla		bne @ok		stz NeedToPost		bra exit@ok*** end 9-Feb-92		lda	>menuID		pha		_DisableMItem			; disable "CloseView" from Apple menu				lda	NeedToPost		; was CloseView on before?		beq	exit			; no, so don't alert user		stz	NeedToPost;--- see if FontManager is active:		stz	HadToLoadFM		pea	0		_FMStatus		pla		bne	post			; yes, so ok to post alert						pea	fontManager		pea	0		_LoadOneTool		bcs	exit		inc	HadToLoadFM		tsc		sec		sbc	#256			; allocate dp space		tcs		inc	a		tax		lda	MyUserID		pha		phx				; dp space		_FMStartUp		bcs	skippost						jsr	Beep			; get user's attention		ldy	#endStr-StrNoMemory		lda	#StrNoMemory		ldx	#StrNoMemory>>16		jsr	PostAlert		; tell the user we didn't get screen		lda	HadToLoadFM		beq	exit		_FMShutDownskip		tsc		clc		adc	#256			; deallocate dp space		tcs		pea	fontManager		_UnloadOneToolexit		lda	#taskTicks		sta	TaskCount		; reset the period for next time		plb		rtl		STRING	ASISStrNoMemory	dc.B	1,'F'			; change the font		dc.W	$FFFE			; family = shaston		dc.B	0			; style = plain		dc.B	16			; size = 16pt		dc.B	'CloseView is not available under this application.'endStr		ENDP*===============================================** Beep at the user				**===============================================*Beep		PROC	EXPORT		LONGA	ON		LONGI	ON				php		sei		lda	#$8000@loop		ldx	#200@wait		dec	a		beq	@done		dex		bne	@wait		sep	#$20		sta	>$E1C030		; click		rep	#$20		bra	@loop@done		plp		rts		ENDP		END