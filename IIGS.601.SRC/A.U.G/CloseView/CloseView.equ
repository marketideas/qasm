image	ds.L	1width		ds.W	1boundsRect	ds	Rect;-----------------------------------------------		ENDR Event		RECORD	0			; Event Manager Event;-----------------------------------------------what		ds.W	1message		ds.L	1when		ds.L	1where		ds	Pointmodifiers	ds.W	1;-----------------------------------------------		ENDRWMTask		RECORD	0			; Task Master Record;-----------------------------------------------wmEvent		ds	EventwmTaskData	ds.L	1wmTaskMask	ds.L	1wmLastClickTick	ds.L	1wmClickCount	ds.W	1wmTaskData2	ds.L	1wmTaskData3	ds.L	1 wmTaskData4	ds.L	1wmLastClickPt	ds	Point;-----------------------------------------------		ENDRWindParamList	RECORD	0			; Window Manager ParamList;-----------------------------------------------paramLength	ds.W	1wFrameBits	ds.W	1wTitle		ds.L	1wRefCon		ds.L	1wZoom		ds	RectwColor		ds.L	1wYOrigin	ds.W	1wXOrigin	ds.W	1 wDataH		ds.W	1wDataW		ds.W	1wMaxH		ds.W	1wMaxW		ds.W	1wScrollVer	ds.W	1wScrollHor	ds.W	1wPageVer	ds.W	1wPageHor	ds.W	1wInfoRefCon	ds.L	1wInfoHeight	ds.W	1wFrameDefProc	ds.L	1wInfoDefProc	ds.L	1wContDefProc	ds.L	1wPosition	ds	RectwPlane		ds.L	1wStorage	ds.L	1;-----------------------------------------------		ENDRCVStatusRec	RECORD	0			; CloseView status record;-----------------------------------------------enabled		ds.W	1			; booleaninvert		ds.W	1			; booleanmagnify		ds.W	1			; booleanusekeys		ds.W	1			; booleanpower		ds.W	1			; word {2,3,4,6,8,12}noScreen	ds.W	1			; booleanwasOn		ds.W	1			; boolean;-----------------------------------------------		ENDR CursorInfo	RECORD	0			; Cursor information record;-----------------------------------------------location	ds	Point			; cursor's current locationheight		ds.W	1			; cursor's height (in lines)width		ds.W	1			; cursor's width (in bytes)hotSpot		ds	Point			; cursor's hotspot;-----------------------------------------------		ENDR ;--- GS/OS system equates:neReserved	equ	$0001			; notification queue eventsneGSOStoP8	equ	$0002neP8toGSOS	equ	$0004neDiskInsert	equ	$0008neDiskEject	equ	$0010neShutDown	equ	$0020neVolChange	equ	$0040		MACRO&lab		_AddNotifyProc&lab		pea	$2034		jsl	$E100B0		MENDtrue		equ	$FFFFfalse		equ	0