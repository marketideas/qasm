*===============================================**						** File:		NDA.aii				** Project:	Close view for the IIGS		** Author:	Don J. Brady			** Build file:	CloseViewII.Make		**						** Copyright © Apple Computer, Inc. 1990-1991	** All rights reserved.				**-----------------------------------------------** Modification History:				** 01/02/90 DJB	- File created today		** 9-Feb-92 DAL  - fixed copyright date		**						**===============================================*				PRINT	NOPAGE		PRINT	NOGEN		PRINT	OFF				INCLUDE	'M16.QuickDraw'		; toolbox macros		INCLUDE	'M16.Window'		INCLUDE	'M16.Control'		INCLUDE	'M16.Event'		INCLUDE	'M16.LineEdit'		INCLUDE	'M16.MiscTool'				INCLUDE	'E16.Window'		; toolbox equates		INCLUDE	'E16.Control'		INCLUDE	'E16.Event'		INCLUDE	'CloseView.equ'		PRINT	ON;--- window offsets:wHeight		equ	71wWidth		equ	316wTop		equ	31wRight		equ	16wRight320	equ	2wBottom		equ	wTop+wHeightwLeft		equ	wRight+wWidthhHeight		equ	114hWidth		equ	310hTop		equ	(200-hHeight)/3hLeft		equ	(640-hWidth)/2hBottom		equ	hTop+hHeighthRight		equ	hLeft+hWidthhWidth320	equ	hWidth-8hLeft320	equ	(320-hWidth320)/2hRight320	equ	hLeft320+hWidth320mx		equ	10			; horizontal margincx		equ	wWidth/2-2		; center lineiHeight		equ	25iWidth		equ	56iconWidth	equ	14			; byte width of iconPicWidth	equ	4			; byte width of picturesmagY1		equ	10magX1		equ	cx+32iconY1		equ	1iconX1		equ	60onY1		equ	4onX1		equ	mxoffY1		equ	onY1+11offX1		equ	mxblackY1		equ	offY1+15blackX1		equ	mxwhiteY1		equ	blackY1+11whiteX1		equ	mxpOnY1		equ	magY1+4pOnX1		equ	cx+mxpOffY1		equ	pOnY1+11pOffX1		equ	cx+mxpowerY1		equ	offY1+2powerX1		equ	wWidth-80keyY1		equ	pOffY1+15keyX1		equ	cx+mxhelpY1		equ	wHeight-16helpX1		equ	wWidth-72;--- control id numbers:idOnRadio	equ	1idOffRadio	equ	2idBlackRadio	equ	3idWhiteRadio	equ	4idKeyCheckBox	equ	5idPowerPopUp	equ	6idMagOnRadio	equ	7idMagOffRadio	equ	8idHelpButton	equ	9*===============================================**						** 	Standard NDA Header			**						**===============================================*NDAHeader	PROC	EXPORT				LONGA	ON		LONGI	ON		STRING	ASIS		IMPORT	NDAOpen		IMPORT	NDAClose		IMPORT	NDAAction		IMPORT	NDAInit				EXPORT	menuID		EXPORT	menuStr		dc.L	NDAOpen		dc.L	NDAClose		dc.L	NDAAction		dc.L	NDAInit		dc.W	1			; period (60 ticks = 1 sec)		dc.W	$016E			; event maskmenuStr		dc.B	'--CLOSE VIEW\BH'	; menu textmenuID		dc.B	'**'			; menu id		dc.B	13,13		ENDP		*===============================================**						**===============================================*NDAData		PROC		STRING	PASCAL;--- string data ---		ENTRY	strCopyrightstrCopyright	dc.B	'Apple Computer, Inc. 1990-92'		; note: © symbol is a pict		ENTRY	strVersionstrVersion	dc.B	'v1.0 '		ENTRY	strMagnifystrMagnify	dc.B	'Magnification:'strNDATitle	dc.B	'   CloseViewª   'strNull		dc.B	0strOn		dc.B	'On'strOff		dc.B	'Off'strBlackOnWhite	dc.B	'Black On White'strWhiteOnBlack	dc.B	'White On Black'strUseKey	dc.B	'Key Equivalents'strHelp		dc.B	'Help'		STRING	ASIS		ENTRY	strHelpText1		ENTRY	EndHelpText1strHelpText1		dc.B	'CloseView allows you to magnify the',13		dc.B	'contents of the desktop screen.  It can',13		dc.B	'be controlled using this Desk Accessory',13		dc.B	'or just by using the following keyboard',13		dc.B	'equivalents.'EndHelpText1		ENTRY	strHelpText2		ENTRY	EndHelpText2strHelpText2		dc.B	17,'-option-O',13		dc.B	17,'-option-X',13		dc.B	17,'-option-',13		dc.B	17,'-option-',13		dc.B	17,'-option-I',13EndHelpText2		ENTRY	strHelpText3		ENTRY	EndHelpText3strHelpText3		dc.B	'Turn CloseView On/Off',13		dc.B	'Turn Magnification On/Off',13		dc.B	'Increase Magnification',13		dc.B	'Decrease Magnification',13		dc.B	'Invert the Display',13EndHelpText3;--- window data ---		ENTRY  NDAWinPtrNDAWinPtr	dc.L	0		ENTRY	HelpWinPtrHelpWinPtr	dc.L	0stripes		dc.W	$0000,$0F00,$020F,$F0F0,$00F0		ENTRY  WinParamsWinParams		dc.W	@endParams-WinParams	; data length		dc.W	0			; frame bits		dc.L	strNDATitle		; title ptr		dc.L	0			; RefCon		dc.W	0,0,0,0			; full size		dc.L	stripes			; color table ptr		dc.W	0			; vertical org		dc.W	0			; horizontal org		dc.W	0			; data area height		dc.W	0			; data area width		dc.W	0			; max cont height		dc.W	0			; max cont width		dc.W	0			; vert scroll pixels		dc.W	0			; hort scroll pixels		dc.W	0			; vert page pixels		dc.W	0			; hort page pixels		dc.L	0			; info bar text ptr		dc.W	0			; info bar height		dc.L	0			; DefProc		dc.L	0			; draw info bar routine		dc.L	0			; draw content routine		dc.W	0,0,0,0			; window position		dc.L	$FFFFFFFF		; window plane		dc.L	0			; 0 = allocate win record@endParams;--- data for controls ---ret		equ	13				ENTRY	cOn			; current control settingscOn		dc.W	0		ENTRY	cOffcOff		dc.W	1		ENTRY	cBlackcBlack		dc.W	1		ENTRY	cWhitecWhite		dc.W	0		ENTRY	cPowercPower		dc.W	2		ENTRY	cMagOncMagOn		dc.W	0		ENTRY	cMagOffcMagOff		dc.W	1		ENTRY	cKeycKey		dc.W	1OnRadioButton	dc.W	8			; PCount		dc.L	idOnRadio		; Control ID		dc.W	onY1,onX1,0,0		; rect		dc.L	radioControl		; defproc		dc.W	1			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strOn			; title ptr		dc.W	0			; initial valueOffRadioButton	dc.W	8			; PCount		dc.L	idOffRadio		; Control ID		dc.W	offY1,offX1,0,0		; rect		dc.L	radioControl		; defproc		dc.W	1			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strOff			; title ptr		dc.W	1			; initial valueBlackOnWhiteRB	dc.W	8			; PCount		dc.L	idBlackRadio		; Control ID		dc.W	blackY1,blackX1,0,0	; rect		dc.L	radioControl		; defproc		dc.W	2			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strBlackOnWhite		; title ptr		dc.W	1			; initial valueWhiteOnBlackRB	dc.W	8			; PCount		dc.L	idWhiteRadio		; Control ID		dc.W	whiteY1,whiteX1,0,0	; rect		dc.L	radioControl		; defproc		dc.W	2			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strWhiteOnBlack		; title ptr		dc.W	0			; initial valueKeyCheckBox	dc.W	8			; PCount		dc.L	idKeyCheckBox		; Control ID		dc.W	keyY1,keyX1,0,0		; rect		dc.L	checkControl		; defproc		dc.W	0			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strUseKey		; title ptr		dc.W	1			; initial value		STRING  ASISPowerMenu	dc.B	'>>Magnification:  \H'		dc.W	500		dc.B	ret		dc.B	'==  2x  \H'		dc.W	2			; id = power		dc.B	ret		dc.B	'==  3x  \H'		dc.W	3			; id = power		dc.B	ret		dc.B	'==  4x  \H'		dc.W	4			; id = power		dc.B	ret		dc.B	'==  6x  \H'		dc.W	6			; id = power		dc.B 	ret		dc.B	'==  8x  \H'		dc.W	8			; id = power		dc.B	ret		dc.B	'==12x  \H'		dc.W	12			; id = power		dc.B	ret		dc.B	'.'			; '.' = end of menuPowerPopUp	dc.W	9			; parameter count		dc.L	idPowerPopUp		; control ID		dc.W	powerY1,powerX1,0,0	; control boundry rect		dc.L	popUpControl		; def proc ref		dc.W	$10			; flag = don't draw title & right justify		dc.W	fCtlProcRefNotPtr+4	; more flags		dc.L	0			; reference constant		dc.W	0			; title width		dc.L	PowerMenu		; menu reference		dc.W 	2			; initial value (2x)POnRadioButton	dc.W	8			; PCount		dc.L	idMagOnRadio		; Control ID		dc.W	pOnY1,pOnX1,0,0		; rect		dc.L	radioControl		; defproc		dc.W	3			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strOn			; title ptr		dc.W	0			; initial valuePOffRadioButton	dc.W	8			; PCount		dc.L	idMagOffRadio		; Control ID		dc.W	pOffY1,pOffX1,0,0	; rect		dc.L	radioControl		; defproc		dc.W	3			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strOff			; title ptr		dc.W	1			; initial valueHelpButton	dc.W	7			; PCount		dc.L	idHelpButton		; Control ID		dc.W	helpY1,helpX1,0,0	; rect		dc.L	simpleButtonControl	; defproc		dc.W	0			; flag		dc.W	fCtlProcRefNotPtr	; more flags		dc.L	0			; RefCon		dc.L	strHelp			; title ptr		ENTRY	ControlTable		; controls used in windowControlTable	dc.L	OnRadioButton		dc.L	OffRadioButton		dc.L	BlackOnWhiteRB		dc.L	WhiteOnBlackRB		dc.L	KeyCheckBox		dc.L	PowerPopUp		dc.L	POnRadioButton		dc.L	POffRadioButton		dc.L	HelpButton		dc.L	0;--- picture data ----		EXPORT  IconLocInfoIconLocInfo	dc.W 	$0080			; port SCB		dc.L	CVIconPic		; picture ptr		dc.W	iconWidth		; picture width (bytes)		dc.W	0,0,25,iconWidth*4	; bounds rectCVIconPic	dc.B  $FF,$FF,$F0,$00,$00,$0F,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $FF,$FF,$00,$00,$00,$00,$0F,$FF,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $FF,$00,$00,$FF,$FF,$F0,$00,$0F,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $FF,$00,$FF,$FF,$FF,$FF,$F0,$0F,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $F0,$0F,$FF,$FF,$F0,$FF,$FF,$00,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $F0,$0F,$FF,$FF,$0F,$FF,$FF,$00,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $00,$FF,$FF,$F0,$FF,$0F,$FF,$F0,$0F,$FF,$FF,$FF,$FF,$FF		dc.B  $00,$FF,$FF,$FF,$F0,$FF,$FF,$F0,$0F,$FF,$FF,$FF,$FF,$FF		dc.B  $00,$FF,$FF,$FF,$0F,$FF,$FF,$F0,$0F,$FF,$FF,$FF,$FF,$FF		dc.B  $00,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$0F,$FF,$FF,$FF,$FF,$FF		dc.B  $00,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$0F,$FF,$FF,$FF,$FF,$FF		dc.B  $F0,$0F,$FF,$FF,$FF,$FF,$FF,$00,$0F,$FF,$FF,$FF,$FF,$FF		dc.B  $F0,$0F,$FF,$FF,$FF,$FF,$FF,$00,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $FF,$00,$FF,$FF,$FF,$FF,$F0,$00,$FF,$FF,$FF,$FF,$FF,$FF		dc.B  $FF,$00,$00,$FF,$FF,$F0,$00,$00,$00,$00,$0F,$FF,$FF,$FF		dc.B  $FF,$FF,$00,$00,$00,$00,$00,$00,$00,$FF,$F0,$FF,$FF,$FF		dc.B  $FF,$FF,$FF,$00,$00,$00,$FF,$00,$00,$0F,$FF,$0F,$FF,$FF		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$00,$00,$FF,$F0,$FF,$FF		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0,$00,$0F,$FF,$00,$0F		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$FF,$FF,$FF,$FF,$F0,$0F		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$00,$FF,$FF,$FF,$F0,$0F		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$FF,$0F,$FF,$FF,$F0,$0F		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$00,$F0,$0F,$FF,$F0,$0F		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$00,$00,$0F,$F0,$0F		dc.B  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$00,$0F		ENTRY	PicLocInfoPicLocInfo	dc.W	$0080			; port SCB		dc.L	0			; ptr to image		dc.W	PicWidth		; width (in bytes)		dc.W	0,0,7,PicWidth*4	; bounds rect		ENTRY	UpArrowPicUpArrowPic	dc.B	$FF,$F0,$FF,$FF		dc.B	$FF,$00,$0F,$FF		dc.B	$F0,$F0,$F0,$FF		dc.B	$FF,$F0,$FF,$FF		dc.B	$FF,$F0,$FF,$FF		dc.B	$FF,$F0,$FF,$FF		dc.B	$FF,$F0,$FF,$FF		ENTRY	DownArrowPicDownArrowPic	dc.B	$FF,$F0,$FF,$FF		dc.B	$FF,$F0,$FF,$FF		dc.B	$FF,$F0,$FF,$FF		dc.B	$FF,$F0,$FF,$FF		dc.B	$F0,$F0,$F0,$FF		dc.B	$FF,$00,$0F,$FF		dc.B	$FF,$F0,$FF,$FF		ENTRY	CopyrightPicCopyrightPic	dc.B	$FF,$00,$00,$FF		dc.B	$F0,$FF,$FF,$0F		dc.B	$0F,$F0,$0F,$F0		dc.B	$0F,$0F,$FF,$F0		dc.B	$0F,$F0,$0F,$F0		dc.B	$F0,$FF,$FF,$0F		dc.B	$FF,$00,$00,$FF;--- other data:		ENTRY 	TaskRecordTaskRecord	ds	WMTask		ENTRY	NDABusyNDABusy		dc.W	0			; ­ 0 if NDA is currently busy		ENDP*===============================================**	Open the NDA's Window			**						** In:						**						** Out:	window pointer on stack			**						**===============================================*NDAOpen		PROC		LONGA	ON		LONGI	ON		IMPORT	NDAWinPtr		IMPORT	WinParams:WindParamList		IMPORT	ControlTable		IMPORT	CVStat:CVStatusRec		IMPORT	GetSettings				IMPORT	DrawWindowndaFrameBits	equ	fTitle+fClose+fMove+fVis+fCtlTie+fHilited		phb		phk		plb				lda	>CVStat.noScreen		beq	ok		_SysBeepskip		brl	exitok				lda	NDAWinPtr		ora	NDAWinPtr+2		bne	skip			; ignore if already open						lda	#ndaFrameBits		sta	WinParams.wFrameBits		lda	#DrawWindow		sta	WinParams.wContDefProc		lda	#DrawWindow>>16		sta	WinParams.wContDefProc+2		lda	#wTop		sta	WinParams.wPosition.top		lda	#wBottom		sta	WinParams.wPosition.bottom		pha		_GetMasterSCB		pla		and	#$0080		tax		lda	#wRight		cpx	#$0080			; is it 640 ?		beq	set			; yes		lda	#wRight320set		sta	WinParams.wPosition.left		clc		adc	#wWidth		sta	WinParams.wPosition.right				pha				; space for result (long)		pha		pea	WinParams>>16		; pointer to window params		pea	WinParams		_NewWindow		pla		plx		bcs	exit			; couldn't get window!		sta	NDAWinPtr		stx	NDAWinPtr+2				phx		pha		_SetSysWindow			; mark as system window		lda	NDAWinPtr+2		; pointer to window		pha		lda	NDAWinPtr		pha		_SetPort			; set to known port (bug in NewControl2)		pha				; space for handle		pha		lda	NDAWinPtr+2		; pointer to window		pha		lda	NDAWinPtr		pha		pea	ptrToPtr		; verb		pea	ControlTable>>16		pea	ControlTable		_NewControl2			; add controls		pla				; ignore handle		pla				stz	cOn			; set defaults		stz	cWhite		stz	cMagOn		lda	#1		sta	cOff		sta	cBlack		sta	cKey		sta	cMagOff		lda	#2		sta	cPower				jsr	GetSettings		; get real settingsexit		lda	NDAWinPtr+2		; pass back window ptr		sta	7,s		lda	NDAWinPtr		sta	5,s		plb		rtl		ENDP*===============================================**	Close the NDA's Window			**						** In:	none					**						** Out:	none					**						**===============================================*NDAClose	PROC		LONGA	ON		LONGI	ON		IMPORT	NDAWinPtr		phb		phk		plb				lda	NDAWinPtr		ora	NDAWinPtr+2		beq	exit			; ignore if closed		lda	NDAWinPtr+2		pha		lda	NDAWinPtr		pha		_CloseWindow		stz	NDAWinPtr+2		stz	NDAWinPtrexit			plb		rtl		ENDP*===============================================**	Startup/Shutdown the NDA		**						** In:	a-reg (a = 0: Shutdown, a ­ 0: Startup)	**						** Out:						**						**===============================================*NDAInit		PROC		LONGA	ON		LONGI	ON		rtl		ENDP*===============================================**	Handle an NDA Action			**						** In:	a-reg has type of action		**	x & y reg have event pointer		**						** Out:	a-reg has return flag			**						**===============================================*NDAAction	PROC		LONGA	ON		LONGI	ON				IMPORT	NDABusy		IMPORT	GetSettingsevtptr		set	5			; stack offset		phb		phk		plb				phy				; save event ptr for _Event		phx				ldx	NDABusy		bne	exit			; NDA is busy		inc	NDABusy			; we are busy		asl  a		tax				; action offset		jsr  (Actions,x)		; process the action			stz  NDABusy			; we are not busy anymoreexit		pla				; remove event ptr		pla		plb		lda  #0				; return flag		rtlActions		dc.W	_Ignore		dc.W	_Event		dc.W	_Run		dc.W	_Cursor		dc.W	_Menu		dc.W	_Undo		dc.W	_Cut		dc.W	_Copy		dc.W	_Paste		dc.W	_Clear;--- do nothing for these actions:_Ignore_Cursor_Menu_Undo_Cut_Copy_Paste_Clear		rts*-----------------------------------------------_Run		jsr	GetSettings		rts*-----------------------------------------------_Event		IMPORT	TaskRecord:WMTask		IMPORT	EnableCV		IMPORT	DisableCV		IMPORT	SetInvert		IMPORT	SetPower		IMPORT	SetMagnify		IMPORT	SetKeyEquiv		IMPORT	CVStat:CVStatusRec		IMPORT	HelpWindow		phd		tsc		tcd			ldy	#18@loop		lda	[evtPtr],y		sta	TaskRecord,y		dey		dey		bpl	@loop			pld			lda	#$FFFF		sta	TaskRecord.wmTaskMask		lda	#$001F		sta	TaskRecord.wmTaskMask+2		pha					; space for result (word)		pea	$FFFF				; mask		pea	TaskRecord>>16			; event record pointer		pea	TaskRecord		_TaskMasterDA		pla		and	#$00FF		cmp	#wInControl		beq	controlHit		cmp	#keyDownEvt		bne	endDoEvent		lda	TaskRecord.wmEvent.message	; look at character		and	#$00FF		cmp	#'?'				; is it a '?' char ?		beq	helpHit		cmp	#'/'				; is it a '/' char ?		bne	endDoEventhelpHit		brl	_HelpButton		controlHit			lda	TaskRecord.wmTaskData4		; check control's id		beq	endDoEvent		pha					; space for control's value		lda	TaskRecord.wmTaskData2+2	; pass contol's handle		pha		lda	TaskRecord.wmTaskData2		pha		_GetCtlValue		ply		lda	TaskRecord.wmTaskData4		; switch on control's id		dec	a		asl	a		tax		jsr	(CaseTable,x)endDoEvent		rtsCaseTable	dc.W	_OnRadio		; id = 1		dc.W	_OffRadio		; id = 2		dc.W	_BlackRadio		; id = 3		dc.W	_WhiteRadio		; id = 4		dc.W	_KeyCheckBox		; id = 5		dc.W	_PowerPopup		; id = 6		dc.W	_MagOnRadio		; id = 7		dc.W	_MagOffRadio		; id = 8		dc.W	_HelpButton		; id = 9;-----------------------------------------------_OnRadio		tya		beq	@done		lda	#1		sta	cOn		stz	cOff		jsl	EnableCV@done		rts;-----------------------------------------------_OffRadio		tya		beq	@done		lda	#1		sta	cOff		stz	cOn		jsl	DisableCV@done		rts;-----------------------------------------------_BlackRadio		tya		beq	@done		lda	#1		sta	cBlack		stz	cWhite		lda	#0		jsl	SetInvert@done		rts;-----------------------------------------------_WhiteRadio		tya		beq	@done		lda	#1		sta	cWhite		stz	cBlack		lda	#1		jsl	SetInvert@done		rts;-----------------------------------------------_KeyCheckBox		tya				; y = 0 or 1		jsl	SetKeyEquiv		rts		;-----------------------------------------------_PowerPopup		tya		beq	@done				sta	cPower		jsl	SetPower@done		rts;-----------------------------------------------_MagOnRadio		tya		beq	@done		lda	#1		sta	cMagOn		stz	cMagOff		lda	#1		jsl	SetMagnify@done		rts;-----------------------------------------------_MagOffRadio		tya		beq	@done		lda	#1		sta	cMagOff		stz	cMagOn		lda	#0		jsl	SetMagnify@done		rts;-----------------------------------------------_HelpButton		jsr	HelpWindow		rts		ENDP*===============================================**	Get real Close View Settings		**						** In:	none					**						** Out:	none					**						**===============================================*GetSettings	PROC		LONGA	ON		LONGI	ON		IMPORT	CVStat:CVStatusRec				lda	>CVStat.enabled		beq	@cmp		lda	#1@cmp		cmp	cOn			; do they match?		beq	invert				ldx	#idOnRadio		lda	cOn		eor	#$0001		sta	cOn		jsr	UpdateControl		ldx	#idOffRadio		lda	cOff		eor	#$0001		sta	cOff		jsr	UpdateControlinvert				lda	>CVStat.invert		beq	@cmp		lda	#1@cmp		cmp	cWhite			; do they match?		beq	power				ldx	#idWhiteRadio		lda	cWhite		eor	#$0001		sta	cWhite		jsr	UpdateControl		ldx	#idBlackRadio		lda	cBlack		eor	#$0001		sta	cBlack		jsr	UpdateControl	power				lda	>CVStat.power		beq	useKeys		cmp	cPower			; do they match?		beq	useKeys				sta	cPower		ldx	#idPowerPopup		jsr	UpdateControluseKeys				lda	>CVStat.useKeys		cmp	cKey			; do they match?		beq	magnify		sta	cKey		ldx	#idKeyCheckBox		jsr	UpdateControlmagnify				lda	>CVStat.magnify		beq	@cmp		lda	#1@cmp		cmp	cMagOn			; do they match?		beq	done				ldx	#idMagOffRadio		lda	cMagOff		eor	#$0001		sta	cMagOff		jsr	UpdateControl		ldx	#idMagOnRadio		lda	cMagOn		eor	#$0001		sta	cMagOn		jsr	UpdateControl	done		rts		;-----------------------------------------------; In:	x = id of control;	a = new value;-----------------------------------------------UpdateControl		pha				; new value		pha				; space for handle		pha		lda	NDAWinPtr+2		pha		lda	NDAWinPtr		pha		pea	0			; contol's ID		phx		_GetCtlHandleFromID		; handle is on stack		_SetCtlValue			; update the control		rts		ENDP*===============================================**	Draw the Contents of the NDA's Window	**						** In:	none					**						** Out:	none					**						**===============================================*DrawWindow	PROC		LONGA	ON		LONGI	ON				IMPORT	PicLocInfo:LocInfo		IMPORT	IconLocInfo:LocInfo		phb		phk		plb		; draw magnifying glass picture:		pha		_GetMasterSCB		pla		sta	PicLocInfo.portSCB		sta	IconLocInfo.portSCB		ldx	#iconWidth*4		and	#$0080				; is it 640?		bne	@set				; yes		ldx	#iconWidth*2			; no, so adjust@set		stx	IconLocInfo.boundsRect.right		pea	IconLocInfo>>16		pea	IconLocInfo		pea	IconLocInfo.boundsRect>>16		pea	IconLocInfo.boundsRect		pea	iconX1		pea	iconY1		pea	0		_PPToPort		; draw version string:		ldx	#iconX1+iWidth		lda	IconLocInfo.portSCB		and	#$0080			; is it 640?		bne	@ok			; yes		ldx	#iconX1+iWidth/2	; no, so adjust@ok		phx		pea	iconY1+iHeight-1		_MoveTo		pea	strVersion>>16		pea	strVersion		_DrawString; draw magnification string:		pea	magX1		pea	magY1		_MoveTo		pea	strMagnify>>16		pea	strMagnify		_DrawString; draw copyright picture:		ldx	#picWidth*4		lda	PicLocInfo.portSCB		and	#$0080				; is it 640?		bne	@set2				; yes		ldx	#picWidth*2			; no, so adjust@set2		stx	PicLocInfo.boundsRect.right		lda	#CopyrightPic		sta	PicLocInfo.ptrToPixImage		lda	#CopyrightPic>>16		sta	PicLocInfo.ptrToPixImage+2		pea	PicLocInfo>>16		pea	PicLocInfo		pea	PicLocInfo.boundsRect>>16		pea	PicLocInfo.boundsRect		pea	mx			; point.h		pea	wHeight-13		; point.v		pea	0		_PPToPort; draw copyright string:		ldx	#mx+20		lda	IconLocInfo.portSCB		and	#$0080			; is it 640?		bne	@ok2			; yes		ldx	#mx+10			; no, so adjust@ok2		phx		pea	wHeight-6		_MoveTo		pea	strCopyright>>16		pea	strCopyright		_DrawString		; draw separator lines:		ldx	#3		lda	IconLocInfo.portSCB		and	#$0080			; is it 640?		bne	@ok3			; yes		ldx	#1			; no, so adjust@ok3		phx		pea	1		_SetPenSize		pea	0			; left line #1		pea	offY1+12		_MoveTo		pea	cx		pea	offY1+12		_LineTo		pea	0			; left line #2		pea	whiteY1+11		_MoveTo		pea	wWidth		pea	whiteY1+11		_LineTo		pea	cx			; center line		pea	0		_MoveTo		pea	cx		pea	whiteY1+11		_LineTo		pea	cx			; right line		pea	pOffY1+11		_MoveTo		pea	wWidth		pea	pOffY1+11		_LineTo; draw the controls last:		pha		pha		_GetPort			; leave pointer on stack		_DrawControls		plb		rtl		ENDP*===============================================**	Draw the Contents of the Help Window	**						** In:	none					**						** Out:	none					**						**===============================================*DrawHelpWindow	PROC		LONGA	ON		LONGI	ON				IMPORT	PicLocInfo:LocInfokeyTextY	equ	hHeight-50		keyTextX	equ	108		arrowX		equ	71+10tabX		equ	12		phb		phk		plb				pea	strHelpText1>>16		pea	strHelpText1		pea	EndHelpText1-strHelpText1		pea	HelpRect1>>16		pea	HelpRect1		pea	0			; left justified		_LETextBox		pea	strHelpText2>>16		pea	strHelpText2		pea	EndHelpText2-strHelpText2		pea	HelpRect2>>16		pea	HelpRect2		pea	0			; left justified		_LETextBox		pea	strHelpText3>>16		pea	strHelpText3		pea	EndHelpText3-strHelpText3		pea	HelpRect3>>16		pea	HelpRect3		pea	0			; left justified		_LETextBox				pha		_GetMasterSCB		pla		sta	PicLocInfo.portSCB		ldx	#picWidth*4		and	#$0080				; is it 640?		bne	@set				; yes		ldx	#picWidth*2			; no, so adjust@set		stx	PicLocInfo.boundsRect.right; draw up arrow picture:		lda	#UpArrowPic		sta	PicLocInfo.ptrToPixImage		lda	#UpArrowPic>>16		sta	PicLocInfo.ptrToPixImage+2		pea	PicLocInfo>>16		pea	PicLocInfo		pea	PicLocInfo.boundsRect>>16		pea	PicLocInfo.boundsRect		pea	arrowX			; point.h		pea	keyTextY+19		; point.v		pea	0		_PPToPort; draw down arrow picture:		lda	#DownArrowPic		sta	PicLocInfo.ptrToPixImage		lda	#DownArrowPic>>16		sta	PicLocInfo.ptrToPixImage+2		pea	PicLocInfo>>16		pea	PicLocInfo		pea	PicLocInfo.boundsRect>>16		pea	PicLocInfo.boundsRect		pea	arrowX			; point.h		pea	keyTextY+28		; point.v		pea	0		_PPToPort		plb		rtlHelpRect1	dc.W	4,tabX,hHeight/2,hWidthHelpRect2	dc.W	keyTextY,tabX,hHeight-2,keyTextX-10HelpRect3	dc.W	keyTextY,keyTextX,hHeight-2,hWidth		ENDP*===============================================**	Open the Help Window			**						** In:	none					**						** Out:	none					**						**===============================================*HelpWindow	PROC		LONGA	ON		LONGI	ON				IMPORT	DrawHelpWindow		IMPORT	WinParams:WindParamList		IMPORT	TaskRecord:WMTaskhelpFrameBits	EQU	fAlert+fVis+fCtlTie+fHilitedeventMask	EQU	mDownMask+mUpMask+keyDownMask		pha				; space for result		pea	eventMask		; event mask		pea	0			; stop mask		_FlushEvents			; remove any key/mouse events		pla				pha		pha		_GetPort			; save current port		lda	#helpFrameBits		sta	WinParams.wFrameBits		lda	#hTop		sta	WinParams.wPosition.top		lda	#hBottom		sta	WinParams.wPosition.bottom		pha		_GetMasterSCB		ldy	#hLeft		ldx	#hRight		pla		and	#$0080			; is it 640 ?		bne	@set			; yes		ldy	#hLeft320		ldx	#hRight320@set		sty	WinParams.wPosition.left		stx	WinParams.wPosition.right		pha				; space for result (long)		pha		pea	WinParams>>16		; pointer to window params		pea	WinParams		_NewWindow		pla		plx		bcs	@exit			; couldn't get window!		sta	HelpWinPtr		stx	HelpWinPtr+2;		phx;		pha;		_SetPort;;		jsl	DrawHelpWindow;--- wait for mouse click or key press:@wait		pha				; space for result		pea	eventMask+updateMask	; mask		pea	TaskRecord>>16		; event record pointer		pea	TaskRecord		_GetNextEvent		pla		beq	@wait		lda	TaskRecord.wmEvent.what		cmp	#updateEvt		bne	@close				lda	TaskRecord.wmEvent.message		cmp	HelpWinPtr		bne	@wait		ldx	TaskRecord.wmEvent.message+2		cpx	HelpWinPtr+2		bne	@wait		phx		pha		phx		pha		_BeginUpdate		jsl	DrawHelpWindow		_EndUpdate		bra	@wait@close		lda	HelpWinPtr		ldx	HelpWinPtr+2		phx		pha		_CloseWindow@exit		_SetPort		rts		ENDP		END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            		