nROMVersion	ds.W	1		EXPORT	QDGlobalsQDGlobals	ds.W	1		EXPORT	MasterSCBMasterSCB	ds.W	1		EXPORT	CursorRectCursorRect	ds	Rect		EXPORT	CenterPtCenterPt	ds	Point			EXPORT	CVStatCVStat		ds	CVStatusRec		EXPORT	NewCursor		EXPORT	OldCursorNewCursor	ds	CursorInfoOldCursor	ds	CursorInfo		; must directly follow NewCursor		EXPORT	TableTable		ds.B	256*16		EXPORT	Table2bTable2b		ds.B	256*16		EXPORT	VirtualSCBsVirtualSCBs	ds.B	200		EXPORT	StdLineVecStdLineVec	ds.L	1		EXPORT	LastMinRectLastMinRect	ds.W	4		EXPORT	TempColorTableTempColorTable	ds.W	16		ENDP		END