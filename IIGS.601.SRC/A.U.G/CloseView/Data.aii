info bar string		dc.W	0			; info bar height		dc.L	0			; def proc ptr		dc.L	0			; draw info bar routine		dc.L	0			; draw content routine		dc.W	0,0,0,0			; window position		dc.L	-1			; window plane		dc.L	0			; memory pointerendWinList;--- boolean flags:		EXPORT	NeedToPostNeedToPost	dc.W	0		EXPORT	RefreshingRefreshing	dc.W	0		EXPORT	TaskInQueueTaskInQueue	dc.W	0		EXPORT	KeyBoardPatchedKeyBoardPatched	dc.W	0		EXPORT	CloseViewWasOnCloseViewWasOn	dc.W	0			; false is the default		EXPORT	TableSwitchTableSwitch	dc.W	0		EXPORT	ChangeSCBsChangeSCBs	dc.W	0		EXPORT	ChangeCursorChangeCursor	dc.W	0		EXPORT	IBarOnIBarOn		dc.W	0		EXPORT	IBarFoundIBarFound	dc.W	0		EXPORT	TrackingIBarTrackingIBar	dc.W	0		EXPORT	HadToLoadFM	HadToLoadFM	dc.W	0		EXPORT	ModeSwitch	ModeSwitch	dc.W	0;--- vectors to real routines:		EXPORT	RealUnDrawCursorRealUnDrawCursor dc.L	0		EXPORT	RealDrawCursorRealDrawCursor	dc.L	0		EXPORT	RealShieldCursorRealShieldCursor dc.L	0		EXPORT	QDStartUpVec		EXPORT	QDStartUpAddrQDStartUpVec	dc.B	$5C			; jml  $bbAAAAQDStartUpAddr	dc.L	0		EXPORT	QDShutDownVec		EXPORT	QDShutDownAddrQDShutDownVec	dc.B	$5C			; jml  $bbAAAAQDShutDownAddr	dc.L	0		EXPORT	ClearScreenVec		EXPORT	ClearScreenAddrClearScreenVec	dc.B	$5C			; jml  $bbAAAAClearScreenAddr	dc.L	0		EXPORT	SetSCBVec		EXPORT	SetSCBAddrSetSCBVec	dc.B	$5C			; jml  $bbAAAASetSCBAddr	dc.L	0		EXPORT	GetSCBVec		EXPORT	GetSCBAddrGetSCBVec	dc.B	$5C			; jml  $bbAAAAGetSCBAddr	dc.L	0		EXPORT	SetAllSCBsVec		EXPORT	SetAllSCBsAddrSetAllSCBsVec	dc.B	$5C			; jml  $bbAAAASetAllSCBsAddr	dc.L	0		EXPORT	SetColorEntryVec		EXPORT	SetColorEntryAddrSetColorEntryVec  dc.B	$5C			; jml  $bbAAAASetColorEntryAddr dc.L	0		EXPORT	GetColorEntryVec		EXPORT	GetColorEntryAddrGetColorEntryVec  dc.B	$5C			; jml  $bbAAAAGetColorEntryAddr dc.L	0		EXPORT	SetColorTableVec		EXPORT	SetColorTableAddrSetColorTableVec  dc.B	$5C			; jml  $bbAAAASetColorTableAddr dc.L	0	