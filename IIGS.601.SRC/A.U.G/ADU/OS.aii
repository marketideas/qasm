;################################################################;#								#;#  File:	OS.Asm from IIGS Disk Initializer		#;#								#;#--------------------------------------------------------------#;#								#;#  Description:  This file has all the glue which calls the	#;#		  prodos routines that do the initializing	#;#								#;#--------------------------------------------------------------#;#								#;#  Author:	Darryl Lovato					#;#								#;#--------------------------------------------------------------#;#								#;#  Copyright:	1987,1988 by Apple Computer Inc.		#;#		All rights reserved.				#;#								#;#--------------------------------------------------------------#;#								#;#  Modification History:					#;#								#;#	Who	When	The Change				#;#	---	------	-------------------------------------	#;#	SR	12/7/87	Created v.1 - erase & init only		#;#	DGL	1/29/88 Rewrote everything - cut size in half!  #;#	DGL	5/9/88	Finished Adding Partition Support	#;#			and other features... far too many to	#;#			list here...				#;#	DGL	6/1/88  Alpha!					#;#	DGL	6/13/88 Alpha 2					#;#	DGL	6/24/88 Alpha 3					#;#	DGL	7/1/88  Beta 1					#;#	DGL	7/13/88 Beta 2					#;#	DGL	7/20/88	Beta 3					#;#	DGL	7/27/88	Beta 4					#;#	DGL	8/1/88	Beta 5					#;#	DGL	8/8/88	Beta 6					#;#	DGL	8/15/88 Final!					#;#								#;################################################################		STRING	ASIS		BLANKS	OFF		MACHINE	M65816		LONGA	on		LONGI	on;------------------------------------------;; Equates from procedure ;;------------------------------------------ProDOS          equ    $E100A8D_Info_Call     equ    $202C             ;Call number for "D_Info"Volume_Call     equ    $2008             ;Call number for "Volume";-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	ctlblk	IMPORT	formatblk	IMPORT	infoblk	IMPORT	returnControl	IMPORT	returnErase	IMPORT	returnFormat	IMPORT	returnInfo	IMPORT	returnStatus	IMPORT	returnWrite	IMPORT	statusblk	IMPORT	writeblk;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	d_info_list	ENTRY	device_name	ENTRY	volume_list	ENTRY	volume_name;################################################################;#		misc data for the below calls			#;################################################################volume_list     PROC	EXPORT		dc.w 5			;pcount through fileSysID		DC.L	device_name	;pointer to the device name		DC.L	volume_name	;pointer to the result volume name		EXPORT	total_blkstotal_blks		DC.L	0000		;total blocks on the volume		EXPORT	free_blksfree_blks		DC.L	0000		;free blocks on the volume		EXPORT	file_system_idfile_system_id		DC.W	0000		;file system. $0001 = ProDOS		EXPORT	d_info_listd_info_list		dc.w 2			;pcount through devName		EXPORT	dev_numdev_num		DC.W	00		;device number. $0001 to -n-		DC.L	dev_name_inbuf	;pointer to device name bufferdev_name_inbuf		dc.w 32+2+2		;size for result buffer		EXPORT	device_namedevice_name		ds.w 1			;length word		DS.B 32			;room for a large name		EXPORT	volume_namevolume_name		dc.w 36+2		;size for result buffer		DS.B 36			;save room for a volume name		EXPORT	error_codeerror_code		DC.W	00		;save error code from the call		ENDP;################################################################;#		function GSOSFormat : integer;			#;################################################################	GSOSFormat	PROC	EXPORT	LONGA ON	LONGI ON		; entry code	phd	tsc	sec	sbc	#$00F8	tcd	clc	adc     #$00E4	tcs		jsl	$E100A8	DC.W	$2024	DC.L	formatblk	bcs	returnFormat	lda	#$0	returnFormat	sta     $FE		; return error	tdc			; exit code	clc	adc     #$00F8	tcs	pld	rtl		ENDP;################################################################;#		function GSOSErase : integer;			#;################################################################	GSOSErase	PROC	EXPORT	LONGA ON	LONGI ON		; entry code	phd	tsc	sec	sbc	#$00F8	tcd	clc	adc     #$00E4	tcs		jsl	$E100A8	DC.W	$2025	DC.L	formatblk		bcs	returnErase	lda	#$0	returnErase	sta     $FE		; return error	tdc			; exit code	clc	adc     #$00F8	tcs	pld	rtl		ENDP;################################################################;#		function GSOSStatus : integer;			#;################################################################	GSOSStatus	PROC	EXPORT	LONGA ON	LONGI ON		; entry code	phd	tsc	sec	sbc	#$00F8	tcd	clc	adc     #$00E4	tcs		jsl	$E100A8	DC.W	$202D	DC.L	statusblk	bcs	returnStatus	lda	#$0	returnStatus	sta     $FE		; return error	tdc			; exit code	clc	adc     #$00F8	tcs	pld	rtl		ENDP;################################################################;#		function GSOSInfo : integer;			#;################################################################	GSOSInfo	PROC	EXPORT	LONGA ON	LONGI ON		; entry code	phd	tsc	sec	sbc	#$00F8	tcd	clc	adc     #$00E4	tcs		jsl	$E100A8	DC.W	$202C	DC.L	infoblk	bcs	returnInfo	lda	#$0	returnInfo	sta     $FE		; return error	tdc			; exit code	clc	adc     #$00F8	tcs	pld	rtl		ENDP;################################################################;#		function GSOSWrite : integer;			#;################################################################	GSOSWrite	PROC	EXPORT	LONGA ON	LONGI ON		; entry code	phd	tsc	sec	sbc	#$00F8	tcd	clc	adc     #$00E4	tcs	jsl	$E100A8	DC.W	$2030	DC.L	writeblk	bcs	returnWrite	lda	#$0	returnWrite	sta     $FE		; return error	tdc			; exit code	clc	adc     #$00F8	tcs	pld	rtl		ENDP;################################################################;#		function GSOSControl : integer;			#;################################################################	GSOSControl	PROC	EXPORT	LONGA ON	LONGI ON		; entry code	phd	tsc	sec	sbc	#$00F8	tcd	clc	adc     #$00E4	tcs		jsl	$E100A8	DC.W	$202E	DC.L	ctlblk	bcs	returnControl	lda	#$0	returnControl	sta     $FE		; return error	tdc			; exit code	clc	adc     #$00F8	tcs	pld	rtl		ENDP				;################################################################;#	function D_Info(device_number,result_name):integer;	#;################################################################D_Info	PROC	EXPORT	; Changed 5/14/91 by Monte Benaresh to use Class 1 D_INFO	LONGA ON	LONGI ON				; entry code	phd			;save Direct Reg on stack	tsc			;transfer Stack Ptr to Accumulator	tcd			;transfer Accumulator to Direct Reg	lda	$0A,s		;get device_number	sta	dev_num		;store in local parameter list	jsl	ProDOS		;call the operating system	DC.W	D_Info_Call	DC.L	D_Info_List	;pointer to the parameter block	sta	$0C,s		;store error as function result	bne	exit	sep 	#$30		;to to 8 bit in m & x	longa	off	longi	off	ldy	device_name	;get number of bytes in device_name	tya	sta [$06]		;set length of P-stringloop	lda	device_name+1,y	;now transfer name to variable	sta	[$06],y		;store in caller's variable	dey	bne	loop	rep	#$30		;back to 16 bit mode	longa	on	longi	onexit	pld			;restore Direct Reg	lda	$01,s		;move up our RTL	sta	$07,s		;get rid of parameter inputs	lda	$02,s	sta	$08,s	tsc			;put stack pointer into Accumulator	clc	adc	#6		;adjust stack to point to RTL	tcs	rtl			;return to Pascal	ENDP;################################################################;#	function Volume(device_number,result_vol_name):integer;	#;################################################################Volume 	PROC	EXPORT	; Changed 5/14/91 by Monte Benaresh to use Class 1 VOLUME	; call to support long volume names.	LONGA	ON	LONGI	ON	phd			;save Direct Reg on stack	tsc			;transfer Stack Ptr to Accumulator	tcd			;transfer Accumulator to Direct Reg	sep	#$30		;to 8 bit m & x	longa	off	longi	off	lda	[$0A]		;get # of bytes in caller's device name	sta device_name		;set low byte of length word	stz device_name+1	;clear high byte	tayinloop	lda	[$0A],y	sta	device_name+1,y	;store in device_name	dey	bne	inloop	rep	#$30		;back to 16 bit mode	longa	on	longi	on	jsl 	ProDOS		;call the operating system	DC.W	volume_call	DC.L	volume_list	;pointer to the parameter block	sta	$0E,s		;store error as function result	bne	done	sep	#$30		;to to 8 bit in m & x	longa	off	longi	off	ldy	volume_name+2	;get number of bytes in volume_name	tya	sta [$06]		;set length of P-stringoutloop	lda	volume_name+3,y	;now transfer name to variable	sta	[$06],y		;store in caller's variable	dey	bne	outloop	rep 	#$30		;back to 16 bit mode	longa	on	longi	ondone	pld			;restore Direct Reg	lda	$01,s		;move up our RTL	sta	$09,s		;get rid of parameter inputs	lda	$02,s	sta	$0A,s	tsc			;put stack pointer into Accumulator	clc	adc	#8		;adjust stack to point to RTL	tcs	rtl			;return to Pascal	ENDPstack_cb	RECORD 1			;stack frame for ClearBufold_dp		ds.w 1old_dbr		ds.b 1rtn_addr	ds.b 3value		ds.w 1				;value to storebuf_size	ds.l 1buf_addr	ds.l 1				;address of buffer to clearstack_end		ENDR*	Next stuff added by Monte Benaresh -- 1-2/91		export ClearBufClearBuf	PROC		;clear specified # of bytes of memory at specified address		phb		phk		plb		phd		tsc		tcd				;use stack as direct-page		;brk $13		WITH stack_cb		lda <buf_addr		sta operand_mod+1		;self-modify operand		lda <buf_addr+1		sta operand_mod+2		;self-modify operandbank_loop		;lda #'HB'			;constant to fill buffer, "BH"		lda <value			;constant to fill buffer from caller		ldy <buf_size+2			;at least a bank?		beq @less@bank		ldx #$0000			;set index for a whole bank		bra clear_loop@less		ldx <buf_size			;set index for low word of size		beq doneclear_loop		dex		dexoperand_mod	sta >$000000,x			;*** SELF_MODIFIED ***		;txy				;test index		bne clear_loopbank_done		lda operand_mod+2		clc		adc #$100			;bump addr by a bank		sta operand_mod+2		dec <buf_size+2			;dec high word of counter		bpl bank_loop			;go complete another bank or part therofdone		lda rtn_addr,s		sta stack_end-3,s		lda rtn_addr+1,s		sta stack_end-2,s		pld		plb		tsc		clc		adc #stack_end-7		tcs		rtl		ENDWITH		ENDPstack_cgs	RECORD 1			;stack frame for CallGSOSold_dp		ds.w 1old_dbr		ds.b 1rtn_addr	ds.b 3call_num	ds.w 1				;call numberpblk_ptr	ds.l 1				;addr of param blockstack_enderror		ds.w 1				;return error		ENDR		export CallGSOSCallGSOS	PROC		;call GS/OS and return error		phb		phk		plb		phd		tsc		tcd				;use stack as direct-page		;brk $18		WITH stack_cgs		pei pblk_ptr+2		pei pblk_ptr		pei call_num		jsl $E100B0		;GS/OS stack entry point		sta <error		;return error to caller		lda rtn_addr,s		sta stack_end-3,s		lda rtn_addr+1,s		sta stack_end-2,s		pld		plb		tsc		clc		adc #stack_end-7		tcs		rtl		ENDWITH		ENDPstack_dcs	RECORD 1			;stack frame for DrvrCksumold_dp		ds.w 1old_dbr		ds.b 1rtn_addr	ds.b 3drvr_size	ds.w 1				;byte size of driver imagedrvr_ptr	ds.l 1				;addr of driver imagestack_endCksum		ds.l 1				;return computed checksum		ENDR		export DrvrCksumDrvrCksum	PROC		;compute boot driver code checksum according to method				;on page 580 of "Inside Macintosh Volume V"		phb		phk		plb		phd		tsc		tcd			;use stack as direct-page		;brk $18		WITH stack_dcs	;(to get a valid checksum, we must zero the checksum field)	;(in the driver itself and then fill it in with our result)		;lda #$0000		;ldy #$0012		;offset to checksum in driver image		;sta [drvr_ptr],y	;clear before we calculate		;iny		;iny		;sta [drvr_ptr],y	;clear low word (MAC order)		ldy #$0000		;init indexDoCksum		stz <Cksum		;initialize sum		ldx <drvr_size		;loop counter		beq CkDone		;handle 0 bytesCkLoop		lda [drvr_ptr],y	;get a word		and #$00FF		;keep low byte		clc		adc <Cksum		;add to checksum		asl a			;move 0 to low bit		adc #$0000		;copy old high bit from carry to new low bit		sta <Cksum		;update		iny			;bump index		dex			;loop counter		bne CkLoop		;next byteCkDone		lda <Cksum		;test for 0 checksum		bne exit		dec <Cksum		;convert a checksum of 0 into $FFFFexit		stz <Cksum+2		;clear high word of long		;lda <Cksum		;get result		;xba			;put bytes in MAC order		;ldy #$0014		;offset to low word of checksum		;sta [drvr_ptr],y	;put result in driver image		lda rtn_addr,s		sta stack_end-3,s		lda rtn_addr+1,s		sta stack_end-2,s		pld		plb		tsc		clc		adc #stack_end-7		tcs		rtl		ENDWITH		ENDP	END