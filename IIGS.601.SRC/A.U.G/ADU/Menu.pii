{################################################################}{#								#}{#  File:	Menu.Pas from IIGS Disk Initializer		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Description:  This file has all the routines that handle	#}{#		  the creation, functionality and disposal of	#}{#		  the menus used in the program.		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Author:	Darryl Lovato					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Copyright:	1987,1988 by Apple Computer Inc.		#}{#		All rights reserved.				#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Modification History:					#}{#								#}{#	Who	When	The Change				#}{#	---	------	-------------------------------------	#}{#	SR	12/7/87	Created v.1 - erase & init only		#}{#	DGL	1/29/88 Rewrote everything - cut size in half!  #}{#	DGL	5/9/88	Finished Adding Partition Support	#}{#			and other features... far too many to	#}{#			list here...				#}{#	DGL	5/12/88 Added Zero and Info operations		#}{#	DGL	5/20/88 Released pre-alpha version to testers	#}{#	DGL	6/1/88  Alpha!					#}{#	DGL	6/13/88 Alpha 2					#}{#	DGL	6/24/88 Alpha 3					#}{#	DGL	7/1/88  Beta 1					#}{#	DGL	7/13/88 Beta 2					#}{#	DGL	7/20/88	Beta 3					#}{#	DGL	7/27/88	Beta 4					#}{#	DGL	8/1/88	Beta 5					#}{#	DGL	8/8/88	Beta 6					#}{#	DGL	8/15/88 Final!					#}{#								#}{################################################################}{$LongGLobals-}{$ToolErrorChk-}{$A+}unit Menu;interfaceuses  InitIntfData,  InitIntfProc,  InitIntfPdos,  ListMgr,  Globals,  Utils,  Guts,  Dialog;procedure DoMenu;      {Execute a menu item}procedure SetUpMenus;  {Install menus and redraw menu bar}implementation{################################################################}{#	handle menu selections here				#}{################################################################}procedure DoMenu;var  item : integer;  bool : boolean;begin {of DoMenu}  item := LoWord(Event.wmTaskData);  case item of    AboutItem : DoAboutItem;    InitItem : ShowInit;    QuitItem : Done := true;    950,951,952,953,954 :      bool := SystemEdit(item - 949);  end;  HiliteMenu(false,HiWord(Event.wmTaskData));end; {of DoMenu}{################################################################}{#			create menu's here			#}{################################################################}procedure SetUpMenus;var  Height : integer;begin			{of SetUpMenus}  SetMTitleStart(10);   {Set Starting position of menu}  AddMenu(@EditMenuStr);{Edit Menu}  AddMenu(@FileMenuStr);{File Menu}  AddMenu(@AppleMenuStr);{Apple Menu}  FixAppleMenu(0);  Height := FixMenuBar; {Set sizes of menus}  DrawMenuBar;          {...and draw the menu bar!}  HiliteMenu(false, FileMenuID);{Initially disabled}end;    		{of SetUpMenus}end.