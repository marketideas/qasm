{################################################################}{#								#}{#  File:	Guts.Pas from IIGS Disk Initializer		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Description:  This file has all the routines make up	#}{#		  the guts of the program, these routines	#}{#		  do the partitioning and zeroing.		#}{#								#}{#--------------------------------------------------------------#} {#								#}{#  Author:	Darryl Lovato					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Copyright:	1987,1988 by Apple Computer Inc.		#}{#		All rights reserved.				#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Modification History:					#}{#								#}{#	Who	When	The Change				#}{#	---	------	-------------------------------------	#}{#	SR	12/7/87	Created v.1 - erase & init only		#}{#	DGL	1/29/88 Rewrote everything - cut size in half!  #}{#	DGL	5/9/88	Finished Adding Partition Support	#}{#			and other features... far too many to	#}{#			list here...				#}{#	DGL	5/12/88 Added Zero and Info operations		#}{#	DGL	5/20/88 Released pre-alpha version to testers	#}{#	DGL	6/1/88  Alpha!					#}{#	DGL	6/13/88 Alpha 2					#}{#	DGL	6/24/88 Alpha 3					#}{#	DGL	7/1/88  Beta 1					#}{#	DGL	7/13/88 Beta 2					#}{#	DGL	7/20/88	Beta 3					#}{#	DGL	7/27/88	Beta 4					#}{#	DGL	8/1/88	Beta 5					#}{#	DGL	8/8/88	Beta 6					#}{#	DGL	8/15/88 Final!					#}{#								#}{################################################################}{ these options turn long addressing on, and turn error checking off}{ in addition, they set the pascal comments in assembler on.}{$LongGLobals-}{$ToolErrorChk-}{$ToolErrorChk+}{$A+}unit Guts;interfaceuses  InitIntfData,  InitIntfProc,  InitIntfPDOS,  ListMgr,  Globals,  Utils;function  CallGetNumParts(dNum : integer) : integer;function  GetParts(dNum : integer; PartAddr : PartitionPtr) : integer;procedure DoDeviceZero(dNum : Integer; only8Blocks : boolean);function  SetParts(dNum : integer; partAddr : PartitionPtr) : integer;PROCEDURE ClearBuf(addr : LONGINT; count : LONGINT; value : INTEGER);	EXTERNAL;								{ added by Monte }implementation{################################################################}{#	return the number of partitions on a scsi device!	#}{################################################################}{ we don't count the partition map itself}FUNCTION CallGetNumParts(dNum : integer) : integer;  VAR    returnMe : integer;    myName : str255;  BEGIN    with infoblk do      begin        pCount := 11;          devNumber := dNum;        devname := @myname;      end;    {DINFO call}    returnme := GSOSInfo;    if infoblk.headLink <> 0 then      dNum := infoblk.headLink;    with statusblk do      begin        pCount := 5;          devNumber := dNum;        statCode := 4; {get partition map}        statlist := @dummyBlk;        requestcount := 512;      end;    with dummyblk do      begin        pmSig := $1234;        pmMapBlkCount := $1234;      end;    returnme := GSOSStatus;    if dummyBlk.pmSig <> $4D50 then { note backward ordering of bytes}      returnMe := 1    else      begin        returnMe := LoWord(SwapLong(dummyBlk.pmMapBlkCount) - 1);        if returnMe < 1 then          returnMe := 1;      end;    CallGetNumParts := returnMe;  END;{########################################################}{#	read the partition map on a SCSI device		#}{########################################################}FUNCTION GetParts(dNum : integer; PartAddr : PartitionPtr) : integer;  VAR    i, partInd : integer;    thePMapHdl : partStructhdl;    myname : string[32];  label 1;  BEGIN    GetParts := noError;    {dNum MUST BE THE HEAD OF THE LIST!!!!!}    with infoBlk do      begin        pCount := 11;          devNumber := dNum;        devname := @myname;      end;    {DINFO call}    i := GSOSInfo;    with infoblk do      if headLink <> 0 then        dNum := headLink;        with ReadCapBlk do      begin        xero := 0;        twofive := $0025;        result := @realsize;      end;          with statusblk do      begin        pCount := 5;          devNumber := dNum;        statCode := $8025; {read capacity}        statlist := @ReadCapBlk;        requestcount := 8;      end;        if GSOSStatus <> 0 then { we dont know how big this drive is, so return error}      begin        GetParts := -1; { error}        goto 1;      end;    {swap the result in realsize because its returned in mac format!}    { Matt G. said I should also add one}    realsize.numBlks := swaplong(realsize.numBlks) + 1;    realSize.blkSize := swaplong(realsize.blkSize);    diskblocksize := realsize.numBlks;    with statusblk do      begin        pCount := 5;          devNumber := dNum;        statCode := 4; {get partition map}        statlist := @dummyBlk;        requestcount := 512;      end;    { status call}    if GSOSStatus <> 0 then      dummyBlk.pmSig := 0; { this will force a "fake" partition to be made}    with partaddr^ do      if (dummyBlk.pmSig <> $4D50) or { note backward ordering of bytes}         (partcount = 1) or         (Upperstring(AryToStr(@dummyBlk.pmPartType,32)) = 'APPLE_PRODOS') then           begin		{ reset existing partition structure	}            partcount := 1;	    with partsinfo[1] do	      begin                partSize := Real2Long((realsize.numBlks - $40) / 1024);                partName := 'UNTITLED1';	      end;          end      else        begin          thePMapHdl := PartStructHdl(NewHandle(sizeof(partrec) * (partcount + 1),	  			MyMemoryID, attrBank+attrPage, nil));          with statusblk do            begin              pCount := 5;                devNumber := dNum;              statCode := 4; {get partition map}              statlist := Ptr(thePMapHdl^);              requestcount := 512 * (partcount + 1);            end;          i := GSOSStatus; {this should never happen, it succeeded above!}          partInd := 1;		{ init index into our info record	}          for i := 1 to PartCount+1 do            with partsinfo[partInd], thePMapHdl^^[i-1] do              begin      (*          partSize := Real2Long(SwapLong(pmPartBlkCount) / 1024);                partName := AryToStr(@pmPartName,32);                if (Upperstring(AryToStr(@pmPartType,32)) = 'APPLE_FREE') or		   (Upperstring(AryToStr(@pmPartType,32)) = 'APPLE_SCRATCH') { OR		   (Upperstring(AryToStr(@pmPartType,32)) = 'APPLE_DRIVER') } then                  PartCount := PartCount - 1; {we dont want to display this}       *)                IF (Upperstring(AryToStr(@pmPartType,32)) <> 'APPLE_FREE') AND                   (Upperstring(AryToStr(@pmPartType,32)) <> 'APPLE_PARTITION_MAP') AND		   (Upperstring(AryToStr(@pmPartType,32)) <> 'APPLE_SCRATCH') AND		   (Upperstring(AryToStr(@pmPartType,32)) <> 'APPLE_DRIVER') THEN		BEGIN                  partSize := Real2Long(SwapLong(pmPartBlkCount) / 1024);                  partName := AryToStr(@pmPartName,32);                  partInd := SUCC(partInd);		END;              end;	  PartCount := partInd - 1;		{ set accurate count	}          Disposehandle(Handle(thePMapHdl));	{ get rid of partition map	}        end;     tMegs := Real2Long(realsize.numBlks / 1024);1: END;{################################################################}{#	zero-out blocks on a device				#}{################################################################}procedure DoDeviceZero(dNum : Integer; only8Blocks : boolean);  var    i : integer;    avail : longint;    counter : longint;    handleSize : longint;  {  multiple : longint;	removed 3/91 by Monte	}    blocksToZero, writeBlks : longint;    H : Handle;    l : longPtr;    err : integer;    j : longint;    theCtl : ControlHandle;    myname : str255;  label 1;  begin    if not only8blocks then {we only want this message when the user said to zero..}      SetLongText(@startzerovolStr);    { find the size of the volume to erase}    with infoBlk do      begin        pCount := 11;          devNumber := dNum;        devname := @myname;      end;    {DINFO call}        i := GSOSInfo;        with infoBlk do      if not only8Blocks then        BlocksToZero := totalblocks      else        if (totalBlocks < 8) then          BlocksToZero := totalBlocks        else          BlocksToZero := 8;    { find the largest block of memory that we can allocate, even number of divisions}    compactmem;    avail := maxblock div 1024; { get total mem available/2 and convert to blocks}    {first assume we will need multiple blocks}    handleSize := avail; {   multiple := (BlocksToZero div avail);	removed 3/91 by Monte Benaresh }    if avail > BlocksToZero then { we can do it with one block}      begin        handleSize := BlocksToZero {- 1} ;  {      multiple := 1;		}      end;          {create the block}    H := NewHandle(handlesize * 512, MyMemoryID,0,nil); {this has to work!}            {zero this block out}    l := LongPtr(H^); {   j := 1;				}	{ removed by Monte 11/90	} {   repeat				} {     l^ := $444C444C; }{DLDL} {     l := LongPtr(Ord4(l) + 4);	} {     j := j + 1;			} {   until (j = (handleSize * 128));	}    ClearBuf(ORD4(l), handleSize * 512, $4842 { 'BH' } );	{ call assembly loop }    if not only8blocks then {we only want this message when the user said to zero..}      SetLongText(@zeroingvolStr);            { write it once if its a floppy, to get the motor running!}    with infoblk do      if (devid = 0) or (devid = $14) then {floppy}        begin          with writeblk do            begin              pCount := 6;              devNum := dNum;              buffer := Ptr(H^);              reqCount := handleSize * 512;              startBlk := 0;              blkSize := 512;              transCount := 0;            end;          err := GSOSWrite;          if not ((err = $2E) or (err = 0)) then            begin              DisposeHandle(h);              SetLongText(@zeroingVolFail);              {we dont need to dim erase because we didn't kill the formatting?}	      goto 1; {get out!}	    end;        end;    { for loop that writes & increments the start ptr}    counter := 0;  {  for i := 1 to multiple do		removed 3/91 by Monte	}     REPEAT      begin        writeBlks := BlocksToZero - counter;	IF writeBlks > handleSize THEN writeBlks := handleSize;        { write it}        with writeblk do          begin            pCount := 6;            devNum := dNum;            buffer := Ptr(H^);            reqCount := writeBlks * 512;            startBlk := counter;            blkSize := 512;            transCount := 0;          end;                   if GSOSWrite <> 0 then          begin            DisposeHandle(h);            if not only8blocks then              begin                SetLongText(@zeroingVolFail);                {dim erase because we killed the formatting}	        TurnOff(EraseButton);	      end;	    goto 1; {get out!}          end;        counter := counter + writeBlks;      end;     UNTIL (counter = BlocksToZero);        {dispose the block}    Disposehandle(h);    if not only8blocks then {we only want this message when the user said to zero..}      begin        SetLongText(@ZeroingVolSuccess);        {dim erase because we killed the formatting}	Turnoff(EraseButton);      end;1:  end;{################################################################}{#	write new partition map & initialize the new volumes	#}{################################################################}function SetParts(dNum : integer; partAddr : PartitionPtr) : integer;  var    i, totPartCount, charInd : INTEGER;    thePStructHdl : partStructhdl;    blocksCounted, tempLong, drvrStartBlk : longint;    err, drvrByteSize, drvrResID : integer;    blocksLeft : longint;    saveme, driverBufLen : integer;    partStart : Longint;    hdlSize : longint;    temp : longint;    nameDlogPtr, formatMsgWind, old2Port : GrafPortPtr;    itemHit, genResFileID : integer;    diskName    : str255;    myName : str255;    drvrHdl : Handle;    theDrvrDescHdl : bootDrvrDescHdl;    theDrvrDescPtr : bootDrvrDescPtr;    theSCSIString : SCSIString;    fileDrvr, hardFmtFlag, drvrErrF, macCompatF : BOOLEAN;    DDMMyPtr : DDMPtr;     LABEL 2999, 3111, 199, 99, 101;  begin    MakeCursor(watch);    err := 0;    SetParts := 0; { assume no error}    {dNum MUST BE THE HEAD OF THE LIST!!!!!}    with infoblk do      begin        pCount := 11;          devNumber := dNum;        devname := @myname;      end;          i := GSOSInfo;    with infoblk do      if headLink <> 0 then        dNum := headLink;  {  deviceNum := dNum;		}    { first find the total size of the partitions, along with the remainder }  { account for DDM, partition map & driver partitions }    blocksCounted := 1 + pMapSizeBlks + (4 * drvrSizeBlks);  { scan our internal structure of user parts and do accounting on allocated blks }  { for each partition, partSize is the # of half-megabytes }    with partAddr^ do      for i := 1 to partcount do         with Partsinfo[i] do          begin            if partsize < 1 then { make sure we don't have a half a part!}              partsize := 1;	    blocksCounted := (partSize * 1024) + blocksCounted;          end;    blocksLeft := diskblocksize - blocksCounted;  { total partition count is # of user parts + system parts + possible FREE part }    totPartCount := partAddr^.partcount + 1 + sysPartCount;    IF blocksLeft < 1 THEN totPartCount := PRED(totPartCount); { no FREE partition }  { allocate handle big enough for all our partitions }    hdlSize := 512 * totPartCount;    thePStructHdl := PartStructHdl(NewHandle(hdlSize, MyMemoryID,    	attrBank+attrPage,nil));    IF toolerrornum <> 0 THEN    BEGIN      ShowNoMem;	{ dialog }      SetParts := $1234;	{ flag error }      GOTO 2999;    END;    HLock(handle(thePStructHdl));    {zero this block out}(*					removed 2/7/91 by Monte Benaresh    l := LongPtr(@thePStructHdl^^[0]);    for i := 1 to (hdlSize div 4) do      begin        l^ := 0;        l := LongPtr(Ord4(l) + 4);      end;*)    ClearBuf(ORD4(@thePStructHdl^^[0]), hdlSize, $0000);	{ call assembly loop }      { 		**** fill partition map image ****		}  { start with generic default data for all partitions	}    FOR i := 0 TO totPartCount-1 DO    WITH thePStructHdl^^[i] DO	{ MUST use WITH to avoid compiler bugs!	}    BEGIN      pmSig := $4D50; {backwards $504D}      pmMapBlkCount := SwapLong(totPartCount);      pmPartStatus := SwapLong($37); { not bootable is default}    END;  { fill each set of partitions	}    partStart := 1;	{ starting block of current partition }  { partition map partition entry }    WITH thePStructHdl^^[0] DO	{ MUST use WITH to avoid compiler bugs!	}    BEGIN      pmPyPartStart := SwapLong(partStart);      pmPartname := StrToAry32('Apple');      pmPartType := StrToAry32('Apple_partition_map');      pmPartBlkCount := SwapLong(pMapSizeBlks);    END;    partStart := partStart + pMapSizeBlks;  { driver partition entries	}    drvrStartBlk := partStart;		{ save block # of 1st drvr for DDM }    FOR i := 1 TO 4 DO    WITH thePStructHdl^^[i] DO	{ MUST use WITH to avoid compiler bugs!	}    BEGIN      pmPyPartStart := SwapLong(partStart);      pmPartname := StrToAry32(CONCAT('Driver', CHAR(i+ORD('0'))));      pmPartType := StrToAry32('Apple_Driver');      pmPartBlkCount := SwapLong(tempLong);      pmPartBlkCount := SwapLong(drvrSizeBlks);    { copy driver processor string from table of ptrs into array }      charInd := 0;	{ init character index	}      REPEAT        charInd := SUCC(charInd);        pmProcessor[charInd-1] := drvrProcessor[i]^[charInd];      UNTIL charInd = ORD(drvrProcessor[i]^[0]);	{ compare to length byte }      partStart := partStart+drvrSizeBlks;    END;  { user partition entries	}    FOR i := 5 TO (4+partAddr^.partcount) DO      BEGIN      WITH partAddr^.partsInfo[i-4], thePStructHdl^^[i] DO { MUST use WITH to avoid compiler bugs!	}        BEGIN        pmPyPartStart := SwapLong(partStart);        pmPartname := StrToAry32(partName);        pmPartType := StrToAry32('Apple_PRODOS');      { if we overran disk size, trim off the end of last user partition }        IF (blocksLeft < 0) AND (i = partAddr^.partcount+4) THEN          pmPartBlkCount := SwapLong((Longint(partSize) * 1024) + blocksLeft)        ELSE          pmPartBlkCount := SwapLong(Longint(partSize) * 1024);        pmPartStatus := SwapLong($0000003F); { bootable}        partStart := partStart+SwapLong(pmPartBlkCount);        END;      END;  { possible FREE partition	}    IF blocksLeft > 0 THEN      WITH thePStructHdl^^[totPartCount-1] DO	{ MUST USE WITH to avoid compiler bugs!	}      BEGIN        pmPyPartStart := SwapLong(partStart);        pmPartname := StrToAry32('Apple');        pmPartType := StrToAry32('Apple_Free');        pmPartBlkCount := SwapLong(blocksLeft)      END;  { copy redundant information between fields	}    FOR i := 0 TO totPartCount-1 DO    WITH thePStructHdl^^[i] DO	{ MUST use WITH to avoid compiler bugs!	}      pmDataCnt := pmPartBlkCount;  { if only 1 user partition, find out whether user wants hard format }    hardFmtFlag := FALSE;	{ assume NO hard format }    IF partAddr^.partcount = 1 THEN	{ 1 user partition? }      BEGIN      MakeCursor(arrow);      i := AlertWindow($0020, NIL, @hardFmtAlrt);		{ prompt user }      MakeCursor(watch);      IF i = 0 THEN        BEGIN			{ user canceled }    	  SetParts := $4321;	{ indicate cancel }	  GOTO 3111;		{ return to caller }        END;      IF i = 2 THEN hardFmtFlag := TRUE;      END;  { now we have to make sure all partitions are unlocked }    i := dNum;		{ start at head }    { set up param blocks }    WITH ctlBlk DO      BEGIN      pCount := 5;      ctlCode := $F001;		{ set partition status }      ctlList := @tempLong;	{ keep list in small variable }      requestCount := 2;      END;    tempLong := $00000130;	{ set bitmap for read-/write-enable }    WITH infoBlk DO      BEGIN        pCount := 11;          devname := NIL;      END;          { set read/write status in a loop }    REPEAT      ctlBlk.devNumber := i;      err := GSOSControl;	{ make control call }      IF NOT (err IN [0, $0022, $002F]) { allow bad param for unpartitioned…	}      	THEN GOTO 2999;			{…disk, or offline			}    { get next linked device }      infoBlk.devNumber := i;      IF GSOSInfo <> 0 THEN GOTO 2999;		{ make D_INFO call }      i := infoBlk.forwardLink;    UNTIL i = 0;	{ cycle for all linked devices }  IF hardFmtFlag THEN   BEGIN	{ do a SCSI-specific hard format } { put up alert window }   old2Port := GetPort;   formatMsgWind := GetNewModalDialog(@initMsgWindow);   SetPort(formatMsgWind);   BeginUpdate(formatMsgWind);   DrawDialog(formatMsgWind);   EndUpdate(formatMsgWind);       WITH ctlBlk DO      BEGIN      pCount := 5;      devNumber := dNum;      CtlCode := $8004; { format device }      ctllist := @formatCtlList;      requestcount := 0;      END;    err := GSOSControl;	{ do hard format }  { close alert window }  CloseDialog(formatMsgWind);  SetPort(old2Port);  IF err <> 0 THEN GOTO 2999;	{ error in hard format }  { now find out whether user wants Mac compatibility, i.e., a partition map }  macCompatF := FALSE;	{ assume Mac compatibility }  MakeCursor(arrow);  i := AlertWindow($0020, NIL, @macConnectAlrt);	{ prompt user }  MakeCursor(watch);  IF i = 1 THEN macCompatF := TRUE; END;	{hard format}  IF (NOT hardFmtFlag) OR (macCompatF) THEN   BEGIN {partition}	{ do entire partition process	}     { write out partition map }       with ctlBlk do          begin            pCount := 5;            devNumber := dNum;            CtlCode := 9; {set partition map}            ctllist := Ptr(thePStructHdl^);	    requestcount := 512 * totPartCount;          end;        { control call }               if GSOSControl <> 0 then          begin  { error writing partition map }            setparts := $1234; {so I can trap this later!}            HUnLock(handle(thePStructHdl));            DisposeHandle(handle(thePStructHdl));            goto 2999;          end;  { prepare SCSI boot driver image }    { use 2nd driver image buffer for DDM }    DDMMyPtr := DDMPtr(@thePStructHdl^^[2]);    fileDrvr := FALSE; { assume that driver will not be loaded from separate file }    drvrErrF := FALSE;	{ assume driver will be installed successfully }   { get SCSI ID string to determine whether this is an Apple drive }     WITH statusBlk DO       BEGIN         pCount := 5;           devNumber := dNum;         statCode := $801A;	{ SCSI mode sense }         StatList := @modeSenseBlk;         RequestCount := SizeOf(SCSIString);       END;    WITH modeSenseBlk DO    BEGIN      version := 0;      cmd := $1A;	{ command # for Mode Sense }      pgFormat := $00;      pgCode := $30;	{ magic number	}      bufPtr := @theSCSIString;    END;  { decide which driver to use based on MODE SENSE status call }    err := GSOSStatus;    IF (err = 0) AND (Copy(theSCSIString.IDStr,1,6) = 'APPLE ') THEN      BEGIN { Apple hard disk }        drvrResID := 1;		{ ID of Apple driver }      END    ELSE      BEGIN { non-Apple HD, read generic driver from file }        genResFileID := OpenResourceFile($0001, NIL, @drvrPath);        IF toolerrornum <> 0 THEN GOTO 99;	{ skip driver if error }        fileDrvr := TRUE;	{ indicate that we did open a resource file }        drvrResID := 2;		{ ID of generic driver }      END;    drvrHdl := LoadResource(rSCSIDrvr, drvrResID);    IF toolerrornum <> 0 THEN GOTO 99;    theDrvrDescHdl := bootDrvrDescHdl(LoadResource(rSCSIDescDrvr, drvrResID));    IF toolerrornum = 0 THEN GOTO 101;	{ skip error message }99: { handle error getting driver resources }      drvrErrF := TRUE;		{ set flag for later }      MakeCursor(arrow);   {   DoAlert('Unable to load Mac Generic driver.  HFS partitions',              'will not be usable on Macintosh computers.');   }      DoAlert('Unable to load the Macintosh driver.  HFS partitions',              'will not be usable on Macintosh computers.');      GOTO 199;101: { resume here if no error getting driver resources }     driverBufLen := GetHandleSize(drvrHdl);  { update driver partition map entry with info in descriptor resource }    theDrvrDescPtr := theDrvrDescHdl^;    WITH thePStructHdl^^[1] DO    BEGIN      pmPartname := StrToAry32('Macintosh');	{ this enables checksum verification }      pmPartStatus := SwapLong($7F); 	{ bootable }      pmLgBootStart := theDrvrDescPtr^.pmLgBootStart;      pmBootSize := theDrvrDescPtr^.pmBootSize;      pmBootLoad := theDrvrDescPtr^.pmBootLoad;      pmBootLoad2 := theDrvrDescPtr^.pmBootLoad2;      pmBootEntry := theDrvrDescPtr^.pmBootEntry;      pmBootEntry2 := theDrvrDescPtr^.pmBootEntry2;      pmBootCkSum := SwapLong(DrvrCksum((drvrHdl^),      			{ take swapped hi wrd b/c mac order! }      			RealSwapInt(Longword(theDrvrDescPtr^.pmBootSize).HiWord)));    { copy boot-specific arguments }      FOR i := 0 TO 127 DO        pmBootSpecific[i] := theDrvrDescPtr^.bootArg[i];    END;199:	{ jump here to skip driver stuff due to error }  { set up Driver Descriptor Map image	}  { start with a clean buffer	}    ClearBuf(ORD4(@thePStructHdl^^[2]), $200, $0000);	{ call assembly loop }    WITH DDMMyPtr^ DO    BEGIN  { NOTE MAC BYTE SEX IN ALL FIELDS!! }      sbSig := $5245;		{ backwards $4552 }      sbBlockSize := $0002;	{ backwards $0200 }      sbBlkCount := SwapLong(diskblocksize);      sbDevType := $0100;	{ backwards $0001 }      sbDevID := $0100;		{ backwards $0001 }      sbDrvrCount := $0100;	{ we only install 1 driver }      WITH sbDDs[1] DO      BEGIN        ddBlock := SwapLong(drvrStartBlk);        ddSize := RealSwapInt(driverBufLen DIV $200);        ddType := $0100;	{ MAC system type = 1 }      END;    END;  { write out DDM and driver image if preceeding went OK }  { if any error with driver, we write a DDM with no driver entry }    IF drvrErrF THEN      BEGIN	{ nullify driver entry in DDM }	WITH DDMMyPtr^ DO	  BEGIN  { NOTE MAC BYTE SEX IN ALL FIELDS!! }	  sbDrvrCount := $0000;	{ no driver installed }	  WITH sbDDs[1] DO	    BEGIN	    ddBlock := $00000000;	    ddSize := $0000;	    ddType := $0000;	    END;	  END;      END;      WITH ctlBlk DO      BEGIN        pCount := 5;        devNumber := dNum;        CtlCode := $F000; { set hard disk params }        ctllist := @setConfigBlk;        requestcount := 26;	 { size of control list }      END;      WITH setConfigBlk DO      BEGIN        drvrNum := 1;	{ the Macintosh driver }	DDMBufSize := $200;        DDMPtr := Ptr(DDMMyPtr);	IF NOT drvrErrF THEN	  BEGIN		{ driver written OK }	  drvrInfoBufSize := $200;          drvrInfoPtr := @thePStructHdl^^[1];	  drvrBufSize := driverBufLen;          drvrDataPtr := drvrHdl^;	  END	ELSE		{ no driver, just write DDM }	  BEGIN		{ driver written OK }	  drvrInfoBufSize := 0;          drvrInfoPtr := NIL;	  drvrBufSize := 0;          drvrDataPtr := NIL;	  END;      END;      IF GSOSControl <> 0 THEN      BEGIN  { error writing DDM, map entry, & driver }        MakeCursor(arrow);      	IF drvrErrF THEN  { give different message based on whether we…	}		          {…have successfully acquired the Mac driver	}	  DoAlert('This device appears unreliable.',	  	  'The partition map may be incomplete.')	ELSE        { show alert telling user this failed }	  DoAlert('Unable to install the HFS boot driver.  This device',	         'appears unreliable.');      END;(* 199:	{ jump here to skip driver stuff due to error }*)    HUnLock(drvrHdl);  { if we opened separate resource file for generic driver, close it }    IF fileDrvr THEN CloseResourceFile(genResFileID);  { dump handle if we allocated it }  END; {partition}	{ end of partition stuff if no hard format }   {------- now we need to initialize all of the new partitions' device id's ------}     i := 1;     repeat       {start at dNum (the head), initialize each volume until there are no more!}       {dNum MUST BE THE HEAD OF THE LIST!!!!!}       if i > 1 then         dNum := saveme;       with infoblk do         begin           pCount := 11;             devNumber := dNum;           devname := @myname;         end;       if GSOSInfo <> 0 then ;         saveme := infoblk.forwardLink;       with statusBlk do         begin           pCount := 5;             devNumber := dNum;           statCode := 0;           StatList := @StatResult;           RequestCount := 6;	 end;       if GSOSStatus <> 0 then; {this isn't important}       if bitand(StatResult.general,$0010) <> 0 then {its online, proceed}         begin           diskname := partAddr^.Partsinfo[i].partName;           if diskname[1] <> '/' then             diskname := concat('/', diskName);           DoDeviceZero(dNum, true); {wipe out the first 8 blocks!}           if D_Info(dNum,myname) <> noError then             begin	       setparts := $1234;	       goto 2999;	     end           else             begin               MakeGSOSStr(myName,s1);	       MakeGSOSStr(diskName,s2);	       with formatBlk do		 begin		   pCount := 5;		   devName := @s1;		   volName := @s2;		   FSNumOut := 0;		   FSNumIn := 0;		   flags := $C000;	{ editable name, selectable FST }		 end;	       IF hardFmtFlag AND (NOT macCompatF) THEN	         err := GSOSErase	       ELSE	         err := GSOSFormat;               MakeCursor(arrow);	       if (err = noError) and (formatBlk.FSNumOut = 0 ) then	         DoAlert(concat('Initialization of the disk "',diskName,'" has been'),		   		 'canceled.  It will not be displayed in the Finder.')	       else if err = $40 then	         DoAlert(concat('Initialization failed! "',diskName,'" was not'),		   		  'a valid disk name.')	       else if err <> noError then	         DoAlert('Initialization failed! There was an error trying to ',		   	 concat('initialize the partition named "',diskname,'".'));	       MakeCursor(watch);             end;         end       else { we hit an offline partition, that means we are at the end!!!!}         saveme := 0; { so we will exit}      inc(i);    until (saveme = 0);    GOTO 3111;		{ no error }2999:	{ error exit }    setparts := $1234;3111:   { general exit  }    HUnLock(handle(thePStructHdl));    DisposeHandle(handle(thePStructHdl));  { set some reasonable volume string in case user clicks icon }  toolErr := volume(currDeviceStr, currVolumeStr);  CASE toolErr OF    IOError, OtherOS : dispVolumeStr := unInitStr;    noError : SetVolName(currVolumeStr);  end; {case}    MakeCursor(arrow);end;end.