{################################################################}{#								#}{#  File:	Utils.Pas from IIGS Disk Initializer		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Description:  This file has all the routines that are	#}{#		  general purpose - utilities.			#}{#								#}{#--------------------------------------------------------------#} {#								#}{#  Author:	Darryl Lovato					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Copyright:	1987,1988 by Apple Computer Inc.		#}{#		All rights reserved.				#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Modification History:					#}{#								#}{#	Who	When	The Change				#}{#	---	------	-------------------------------------	#}{#	SR	12/7/87	Created v.1 - erase & init only		#}{#	DGL	1/29/88 Rewrote everything - cut size in half!  #}{#	DGL	5/9/88	Finished Adding Partition Support	#}{#			and other features... far too many to	#}{#			list here...				#}{#	DGL	5/12/88 Added Zero and Info operations		#}{#	DGL	5/20/88 Released pre-alpha version to testers	#}{#	DGL	6/1/88  Alpha!					#}{#	DGL	6/13/88 Alpha 2					#}{#	DGL	6/24/88 Alpha 3					#}{#	DGL	7/1/88  Beta 1					#}{#	DGL	7/13/88 Beta 2					#}{#	DGL	7/20/88	Beta 3					#}{#	DGL	7/27/88	Beta 4					#}{#	DGL	8/1/88	Beta 5					#}{#	DGL	8/8/88	Beta 6					#}{#	DGL	8/15/88 Final!					#}{#								#}{################################################################}{ these options turn long addressing off, and turn error checking off}{ in addition, they set the pascal comments in assembler on.}{$LongGlobals-}{$ToolErrorChk-}{$A+}unit Utils;interfaceuses  InitIntfData,  InitIntfProc,  InitIntfPDOS,  ListMgr,  Globals;procedure DoAlert(static prompt, prompt2 : str255);procedure MakeCursor(newCurs : integer);procedure MakeGSOSStr(s : str255; var gs : GSOSString);FUNCTION GSToP(GSString: GSStrPtr) : STR255;function  UpperString(s : str255) : str255;procedure SetLongText(theStringPtr:StringPtr);FUNCTION RealSwapInt(aInt : INTEGER) : INTEGER;  { added 2/91 by Monte }function  SwapLong(aLong : Longint) : longint;function  AryToStr(data : Ptr; max : integer) : str255;function  StrToAry32(theStr : str255) : str32;procedure ZeroRefCons;procedure RestoreRefCons;procedure SaveAndZeroRefCons;PROCEDURE ShowNoMem;procedure PlotIconola(icon : Ptr; where : Point; smallicon : boolean);function  GetVolIcon : ptr;function  IsDA(theWind : GrafPortPtr) : boolean;function  Real2Long(value : real) : longint;function  Real2Int(value : real) : integer;procedure TurnOn(ctl : ControlHandle);procedure TurnOff(ctl : ControlHandle);procedure BlinkButton(ctl : ControlHandle);procedure AddMenu(s : Ptr);PROCEDURE SetVolName(VolStr : STR255);		{ added 8/4/91 by Monte }FUNCTION CheckOpenFiles(devNumber : INTEGER) : BOOLEAN;	{ added 8/17/91 by Monte }procedure PHK; inline $4B;procedure PLB; inline $AB;PROCEDURE PHB; inline $8B;	{ added 3/91 by Monte }PROCEDURE break; inline $00;PROCEDURE brksig; inline $24;implementationFUNCTION CheckOpenFiles(devNumber : INTEGER) : BOOLEAN;	{ added 8/17/91 by Monte }  VAR  tempGS : GSOSResultBuf;  BEGIN    WITH infoBlk DO      BEGIN        pCount := 11;          devNumber := devNumber;        devname := @tempGS;      END;    tempGS.bufsize := 35; { set size of result buf }    toolErr := GSOSInfo;	{ get device name }    WITH volBlk DO      BEGIN        pCount := 7;	{ include new characteristics word }	devName := @tempGS.gstring;	volName := NIL;      END;    toolErr := CallGSOS(@volBlk, $2008); { issue VOLUME call }    IF (toolErr <> 0) OR (BITAND(volBlk.characteristics, $0010) = 0)      THEN CheckOpenFiles := FALSE	{ if error or clear flag, no file open }      ELSE CheckOpenFiles := TRUE;  END;PROCEDURE SetVolName(VolStr : STR255);		{ added 8/4/91 by Monte }  BEGIN     currVolumeStr := VolStr;			{ set global p-string }     dispVolumeStr := currVolumeStr;     IF (dispVolumeStr[1] = '/') OR (dispVolumeStr[1] = ':') THEN            delete(dispVolumeStr,1,1);                   {Get rid of '/'}     dispVolumeStr := CONCAT('The disk name is ', dispVolumeStr);  END;{################################################################}{#	add a menu to the menu bar				#}{################################################################}procedure AddMenu(s : Ptr);  begin    InsertMenu(NewMenu(s),0);  end;{################################################################}{#	Convert a real to a long				#}{################################################################}function  Real2Long(value : real) : longint;  begin    Real2Long := trunc(round(value));  end;{################################################################}{#	Convert a real to a integer				#}{################################################################}function  Real2Int(value : real) : integer;  begin    Real2Int := Real2Long(value); {let pascal trunc it!}  end;{################################################################}{#	blink a button one then off - used in filter routines	#}{################################################################}procedure BlinkButton(ctl : ControlHandle);  begin    HiliteControl(2,ctl);    HiliteControl(0,ctl);  end;{################################################################}{#	turn on a control (hilite)				#}{################################################################}procedure TurnOn(ctl : ControlHandle);  begin    HiliteControl(0,ctl);  end;{################################################################}{#	turn off a control (dim)				#}{################################################################}procedure TurnOff(ctl : ControlHandle);  begin    HiliteControl(255,ctl);  end;{################################################################}{#	Is this window a desk accessory?			#}{################################################################}function IsDA(theWind : GrafPortPtr) : boolean;  begin    IsDA := false;    if theWind <> nil then      IsDA := BitAnd(GetWKind(theWind),$8000) <> 0;  end;{################################################################}{#	generic 1 button "ok" alert with 2 lines of text	#}{################################################################}procedure DoAlert(static prompt, prompt2 : str255);  var    AlertDLog : GrafPortPtr;    itemHit : integer;  begin    oldPort := GetPort;    miscStr := prompt;    miscStr1 := prompt2;    AlertDLog := GetNewModalDialog(@AlertDITL);    SetPort(AlertDLog);    itemHit := ModalDialog(nil);    CloseDialog(AlertDLog);    SetPort(oldPort);  end;{################################################################}{#	Utility routine to make a given string GSOS compatable	#}{################################################################}procedure MakeGSOSStr(s : str255; var gs : GSOSString);  var    i : integer;  begin    with gs do      begin        size := length(s);        for i := 1 to size do          chars[i-1] := s[i];      end;  end;  {################################################################}{#	Utility routine to convert GSOS string to P-string	#}{################################################################}FUNCTION GSToP(GSString: GSStrPtr) : STR255;  { given ptr to GS/OS string,É}                                              {Éreturn Pascal string       }  VAR  tempString : gsosstring;  tempPtr : StringPtr;  BEGIN    tempString := GSString^;    { make a copy }    tempPtr := StringPtr(@tempString);    tempPtr^[1] := tempPtr^[0];  { copy low byte to high }    GSToP := StringPtr(ORD(tempPtr)+1)^;  END;{################################################################}{#	Utility routine to make a given string uppercase	#}{################################################################}function UpperString(s : str255) : str255;  var    i : integer;    val : integer;  begin    for i := 1 to ord(s[0]) do { this is faster than length(s) }      begin        val := ord(s[i]);        if (val >= ord('a')) and           (val <= ord('z')) then { its a lower case character}	  s[i] := Char(val - $20);      end;    UpperString := s;  end;{################################################################}{#  Set the cursor to the specified type, but only if needed	#}{################################################################}procedure MakeCursor(newCurs : integer);begin  case newCurs of    arrow : if CurrCursor <> arrow then	      InitCursor;    watch : if CurrCursor <> watch then              WaitCursor;  end;  CurrCursor := newCurs;end;{################################################################}{#	performs the equivalent of SetIText on a LongStatText2	#}{################################################################}PROCEDURE SetLongText(theStringPtr : StringPtr);  VAR  tempRect : Rect;  theCtlHdl : ControlHandle;  BEGIN    oldPort := GetPort;    SetPort(InitDlogPtr);  { set substitution string ptr to new string }    subStrArray[0] := theStringPtr;    theCtlHdl := GetCtlHandleFromID(InitDlogPtr, MStatTxt);    DrawOneCtl(theCtlHdl);  { validate this control's rect so the text won't get redrawn }    tempRect := theCtlHdl^^.CtrlRect;    ValidRect(tempRect);    SetPort(oldPort);  END;{################################################################}{#		swap the two bytes of an integer		#}{################################################################}type  accesseverything = record    case integer of      1: (l : longint);      2: (w1 : integer;          w2 : integer);      3: (b1 : signedbyte;          b2 : signedbyte;          b3 : signedbyte;          b4 : signedbyte);    end;{ next function added 2/19/91 by Monte Benaresh }FUNCTION RealSwapInt(aInt : accesseverything) : INTEGER;  VAR  temp : accesseverything;  BEGIN    temp.l := 0;    temp.b2 := aint.b1;    temp.b1 := aint.b2;    RealSwapInt := temp.w1;  END;{################################################################}{#		swap the two bytes of a longint			#}{################################################################}function SwapLong(aLong : accesseverything) : longint;  var    temp : accesseverything;  begin    temp.l := 0;    temp.b4 := aLong.b1;    temp.b3 := aLong.b2;    temp.b2 := aLong.b3;    temp.b1 := aLong.b4;    SwapLong := temp.l;  end;{################################################################}{#	convert a C str to a P string				#}{################################################################}function AryToStr(data : Ptr; max : integer) : str255;  type    charPtr = ^char;  var    count : integer;  begin    count := 1;    while (charptr(data)^ <> char(0)) and (count <= max) do      begin        AryToStr[count] := charptr(data)^;        data := pointer(ord4(data) + 1);        inc(count)      end;    AryToStr[0] := char(count - 1);  end;{################################################################}{#	convert a P str to a C string				#}{################################################################}function StrToAry32(theStr : str255) : str32;  var    i : integer;  begin    if length(thestr) > 31 then      theStr[0] := char(31);    for i := 0 to 31 do      if i >= length(thestr) then        StrToAry32[i] := char(0)      else        StrtoAry32[i] := theStr[i+1];  end;        {################################################################}{#	zero refcons, dlog mgr expects them to be 0		#}{################################################################}procedure ZeroRefCons;  begin    SetCtlRefCon(0,listControl1);    SetCtlRefCon(0,listScroll1);  end;{################################################################}{#	restore refcons we saved earlier	 		#}{################################################################}procedure RestoreRefCons;  begin    SetCtlRefCon(listCtlRef1,listControl1);    SetCtlRefCon(listScrollRef1,listScroll1);  end;{################################################################}{#	save refcons, then wipe-em out				#}{################################################################}procedure SaveAndZeroRefCons;  begin    listCtlRef1 := GetCtlRefCon(listControl1);    listScrollRef1 := GetCtlRefCon(listControl1^^.CtlListBar);    ZeroRefCons;  end;{################################################################}{#	announce out-of memory					#}{################################################################}procedure ShowNoMem;  begin      MakeCursor(arrow);      DoAlert('Sorry, not enough memory to perform the selected', 'operation.');  end;{################################################################}{#	plot the icon at the point specified.			#}{################################################################} procedure PlotIconola(icon : Ptr; where : Point; smallicon : boolean);  var    AuxPLoc : LocInfoRec;  begin    with AuxPloc, boundsrect do      begin        PortSCB := ScreenMode;        PixelImage := icon;        v1 := 0;        h1 := 0;        if smallicon then          begin            Width := 8;            v2 := 8;            h2 := 32;          end        else          begin            Width := 15;            v2 := 22;            h2 := 60;          end;	IF icon <> NIL THEN PPToPort(AuxPLoc, BoundsRect,where.h,where.v,SrcCopy);      end;  end;{################################################################}{#	return vol icon for device passed in global "infoblk"	#}{################################################################}{this routine relies on infoblk to be correct, nothing is passed to us, we just look at the infoblk - we also wipe out the info blk!} function GetVolIcon : ptr;  var    i : integer;    myName : str255;  begin    GetVolIcon := @other; {default icon}    with infoblk do      case devID of        $0,$14 : {floppy disk}          GetVolIcon := @floppy;        $3, $17 : { 3.5 inch disks, incl FDHD}          GetVolIcon := @three;        $1, $2, $5, $7, $13 : { hard disks, cd rom}          if (headLink + forwardlink) <> 0 then {same as testing both for <> 0 and or'ing them}            begin              { do a dInfo on the head so we can get device # 2}              pCount := 11;              if headlink <> 0 then                devNumber := headLink;              devname := @myname;                              i := GSOSInfo;                          {now do a status on the head's forward link device,	        if its there, then we are partitioned}              with statusBlk do                begin                  pCount := 5;                    devNumber := forwardlink;                  statCode := 0;                  StatList := @StatResult;                  RequestCount := 6;                end;              i := GSOSStatus;              	      { this may seem to be an obscure way to do this but it 	        saves tons of code no- else's}	      GetVolIcon := @harddisk;	      if devID = 7 then		GetVolIcon := @CD;	      if bitand(StatResult.general,$0010) <> 0 then {its a partition}                begin		  GetVolIcon := @Partition;		  if devID = 7 then		    GetVolIcon := @CDPartition		end;		            end	  else	    begin              GetVolIcon := @harddisk;              if devID = 7 then                GetVolIcon := @cd            end;        $E, $F : { ram and rom disks}          GetVolIcon := @ramdisk;        $1E : { appletalk network}          GetVolIcon := @appletalk;      end;  end;    end.