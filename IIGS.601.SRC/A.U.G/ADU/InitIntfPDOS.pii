{$A+}UNIT InitINTFPDOS;INTERFACE {Def's below are public and represent the C-like ProDOS/16 interface}USES InitINTFDATA;TYPEP16ParamBlk    = packed record                   case integer of                       {Used by Create, SetFileInfo and GetFileInfo:}                       0: (pathname1   :   StringPtr;                           access      :   integer;                           fileType    :   integer;                           auxType     :   longint;                           storageType :   integer;                           createDate  :   integer;                           createTime  :   integer;                           modDate     :   integer;                           modTime     :   integer;                           blocksUsed  :   longint);                       {Used by Destroy:}                       1: (deletepathname  :  StringPtr);                       {For the following file access calls:}                       2: (refNum      :   integer;                           case integer of                               {Used by Open:}                               0: (pathname2   :   StringPtr;                                   ioBuffer    :   Handle);                               {Used by Read, Write:}                               1: (dataBuffer    : Ptr;                                   requestCount  : longint;                                   transferCount : longint);                               {Used by Close, Flush:}                               2: ();  );                       {Used by GetPathName, GetBootVol:}                       3: (pathName    :   StringPtr);                 end;FileRec        =   packed record                       pathname        :   Ptr;                       fAccess         :   integer;                       fileType        :   integer;                       auxType         :   longint;                       storageType     :   integer;                       createDate      :   integer;                       createTime      :   integer;                       modDate         :   integer;                       modTime         :   integer;                       blocksUsed      :   longint;                   end;PathNameRec    =   packed record                       pathname        :   Ptr;                       newPathname     :   Ptr;                   end;FUNCTION D_INFO (deviceNum : integer;                 var resultName : str255):integer;                     EXTERNAL;FUNCTION VOLUME (var deviceName, VolumeName : Str255):integer;         EXTERNAL;function GSOSStatus : integer;		external;function GSOSControl : integer;		external;function GSOSInfo : integer;		external;function GSOSWrite : integer;		external;function GSOSErase : integer;		external;function GSOSFormat : integer;		external;{ added 2/91 by Monte Benaresh:	}FUNCTION CallGSOS(pblkPtr : Ptr; callNum : INTEGER) : INTEGER;			EXTERNAL;FUNCTION DrvrCksum(drvrPtr : Ptr; drvrSize : INTEGER) : LONGINT;		EXTERNAL;{Do this so we can access these routines in the TML Pascal library file:}PROCEDURE P16GetFileInfo   (var p: P16ParamBlk);                   ProDOS 6;PROCEDURE P16GetBootVol    (var p: P16ParamBlk);                   ProDOS 40;IMPLEMENTATION {Everything below is private to this unit}END.