{################################################################}{#								#}{#  File:	Event.Pas from IIGS Disk Initializer		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Description:  This file has all the routines that handle	#}{#		  the events in the IIGS Disk Initializer.	#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Author:	Darryl Lovato					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Copyright:	1987,1988 by Apple Computer Inc.		#}{#		All rights reserved.				#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Modification History:					#}{#								#}{#	Who	When	The Change				#}{#	---	------	-------------------------------------	#}{#	SR	12/7/87	Created v.1 - erase & init only		#}{#	DGL	1/29/88 Rewrote everything - cut size in half!  #}{#	DGL	5/9/88	Finished Adding Partition Support	#}{#			and other features... far too many to	#}{#			list here...				#}{#	DGL	5/12/88 Added Zero and Info operations		#}{#	DGL	5/20/88 Released pre-alpha version to testers	#}{#	DGL	6/1/88  Alpha!					#}{#	DGL	6/13/88 Alpha 2					#}{#	DGL	6/24/88 Alpha 3					#}{#	DGL	7/1/88  Beta 1					#}{#	DGL	7/13/88 Beta 2					#}{#	DGL	7/20/88	Beta 3					#}{#	DGL	7/27/88	Beta 4					#}{#	DGL	8/1/88	Beta 5					#}{#	DGL	8/8/88	Beta 6					#}{#	DGL	8/15/88 Final!					#}{#								#}{################################################################}{$LongGLobals-}{$ToolErrorChk-}{$A+}unit Event;interfaceuses  InitIntfData,  InitIntfProc,  InitIntfPdos,  ListMgr,  Globals,  Utils,  Guts,  Dialog,  Menu;procedure MainEvent;   {Main event handling loop which repeats until Quit}implementation{################################################################}{#	main event loop, heres where the action is!		#}{################################################################}PROCEDURE MainEvent;   VAR     temp : boolean;     lastDA : boolean;     taskCode : INTEGER;  {   nowTick : LONGINT; }     hdiResult : LONGINT;     hdiFlags, hdiDev : INTEGER;     tempErr : INTEGER;     clickPoint : Point;   BEGIN       Event.wmTaskMask := $1FFFFF;  {Allow TaskMaster to do everything}       Done := false;  {Done flag will be set by Quit item}       repeat         taskCode := TaskMaster(-1,Event);         if taskCode = winMenuBar then DoMenu;	 IF taskCode = wInControl THEN ProcessInit;	{ handle ctl hit… }	 						{…in main Dlog    }	 IF taskCode = wInContent THEN	   BEGIN  { check for click in icon rectangle }	   clickPoint := Event.wmWhere;	   SetPort(InitDlogPtr);	{ just in case }	   GlobalToLocal(clickPoint);	   IF PtInRect(clickPoint, mainIconRect) THEN	   	SetLongText(@dispVolumeStr);	{ show volume name }	   END;         temp := IsDa(FrontWindow); { dim the edit menu if its a DA on top!}         if temp <> lastDA then           begin             lastDA := temp;             if temp then               SetmenuFlag($FF7F, 900)             else               SetmenuFlag($0080, 900);             DrawmenuBar;           end;    { scan for disk inserts/ejects }      hdiResult := HandleDiskInsert(hdiScan + hdiEjects, 0);      hdiFlags := Longword(hdiResult).HiWord;      hdiDev := Longword(hdiResult).LoWord;      IF (hdiDev = deviceNum) AND (hdiDev <> 0) THEN  { is it our current device? }      	BEGIN	{ must have been ejected, so move on to next online device }	MakeCursor(watch);	{repeat	}	  NextDrive; {Skip over nonexistent Disk II device and empty 3.5 drives}	{until noDevices or (not (toolErr in [noDevice,noDiskInDrive])); }	MakeCursor(arrow);	END      ELSE      	BEGIN	{ activity in some other device }	IF (hdiDev <> 0) AND (BitAND(hdiFlags, $0001) = 0)	{ was it an insert? } THEN	  BEGIN	  MakeCursor(watch);	  deviceNum := hdiResult-1;	{ this will cause NextDrive to…	}	  NextDrive;			{…move to the inserted device	}	  MakeCursor(arrow);	  END;	END;(*	nowTick := GetTick;	IF nowTick - lastPoll > 40 THEN  { has it been this many ticks… }					 {…since last device poll?	}	  BEGIN          lastPoll := nowTick;		{ reset time of last poll	}	  IF deviceNum <> 0 THEN { if we have a device online, check for eject }	    BEGIN            with statusBlk do              begin              pCount := 5;                devNumber := deviceNum;              statCode := 0;              StatList := @StatResult;              RequestCount := 6;              end;            tempErr := GSOSStatus;            IF (tempErr = 0) AND 	      (BitAND(StatResult.general, $0011) = $0001)	      THEN { offline switched? }	        BEGIN                MakeCursor(watch);             {   repeat		}                  NextDrive; {Skip over nonexistent Disk II device and empty 3.5 drives}              {  until noDevices or (not (toolErr in [noDevice,noDiskInDrive]));	      }                MakeCursor(arrow);		END;	    	    END;	  END;*)       until Done;   END;END.