UNIT ListMgr;		{ Interfaces for Resource Manager added  }			{ by Monte Benaresh -- February 16, 1991 }USES  InitIntfData,         {Apple IIGS Toolbox Interface Units}      InitIntfProc,      InitIntfPDOS;(*  ** Types for List Manager ** *)TYPE    ListMemP   = ^ListMemRec;        ListRecP = ^ListRec;        ListRec =            record                ListRec:        Rect;                ListSize:       Integer;                ListView:       Integer;                ListType:       Integer;                ListStart:      Integer;                ListCtl:        ControlHandle;                ListDraw:       ProcPtr;                ListMemHeight:  Integer;                ListMemSize:    Integer;                ListPointer:    ListMemP;                ListRefCon:     LongInt;                ListScrollClr:  ColorTablePtr;            end;        ListMemRec =            record                memPtr:  Ptr;                memFlag: Integer;            end;(* ** Routines for List Manager ** *)PROCEDURE ListStartUp;                                  Tool 28,2;PROCEDURE ListShutDown;                                 Tool 28,3;FUNCTION  ListVersion: Integer;                         Tool 28,4;PROCEDURE ListReset;                                    Tool 28,5;FUNCTION  ListStatus: Integer;                          Tool 28,6;FUNCTION  CreateList             (TheWindow: GrafPortPtr;              TheList:   ListRecP): ControlHandle;      Tool 28,9;FUNCTION  NextMember             (TheMem:  ListMemP;              TheList: ListRecP): ListMemP;             Tool 28,11;FUNCTION  ResetMember             (TheList: ListRecP): ListMemP;             Tool 28,15;PROCEDURE DrawMember             (TheMem:  ListMemP;              TheList: ListRecP);                       Tool 28,12;PROCEDURE SelectMember             (TheMem:  ListMemP;              TheList: ListRecP);                       Tool 28,13;PROCEDURE SortList             (SortProc: ProcPtr;              TheList:  ListRecP);                      Tool 28,10;FUNCTION  GetListDefProc: ProcPtr;                      Tool 28,14;PROCEDURE NewList             (TheMem:  ListMemP;              TheList: ListRecP);                       Tool 28,16;(* ** Routines for List Manager ** added 2/16/91 by Monte *)PROCEDURE DetatchResource		(ResType : INTEGER;		 ResID : LONGINT);			TOOL 30,24;FUNCTION GetResourceSize		(ResType : INTEGER;		 ResID : LONGINT): LONGINT;		TOOL 30,29;FUNCTION LoadResource		(ResType : INTEGER;		 ResID : LONGINT): Handle;		TOOL 30,14;FUNCTION OpenResourceFile		(reqAccess : INTEGER; mapPtr : Ptr;		 pathPtr : Ptr): INTEGER;		TOOL 30,10;PROCEDURE CloseResourceFile		(fileID : INTEGER);			TOOL 30,11;end.