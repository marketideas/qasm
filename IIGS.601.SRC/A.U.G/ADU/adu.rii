/*--------------------------------------------------------------*//*	resources for Advanced Disk Utility       by Monte Benaresh	*//*																*//*			created February 16, 1991							*//*--------------------------------------------------------------*/#include "Typesiigs.r"#define rSCSIDrvr		$4D61		/*	unusual value for uniqueness	*/#define rSCSIDescDrvr	$5E72		/*	unusual value for uniqueness	*/#define versionString "1.2"		/* maintain version here and in "Data.aii"	*/resource rVersion(1, $0000) {	{ 	  $1,				/* major version in BCD */	  $2,				/* minor version in BCD */	  $0,				/* bug version		    */	  release,	  $00,				/* # */	 },	verUS,	"Advanced Disk Utility",	"Copyright 1988-92, Apple Computer, Inc."};resource rComment(1, $0000) {	"Advanced Disk Utility by Darryl Lovato."	"\$0d"	"\$0d"	"Updated by Monte Benaresh."	"\$0d"	"\$0d"	"Quality assured by Brenda Knudson, Margarita Sang, "	"Llew Roberts, Steve Wesolowski, and Anil Gursahani."};/*									*//*	Equates for window flags		*//*									*/#define wtitleAsRes			$0200#define wcolorAsRes			$0800#define wctlAsRes			$0009/*									*//*	Defines for windows/controls	*//*									*/#define mainDlog			$1001#define MEraseBut			$0002#define MTitleTxt			$0003#define MDiskBut			$0005#define MStatTxt			$0008#define MPartBut			$0009#define MCancelBut			$000A#define MInitBut			$000B#define MZeroBut			$000C#define MInfoBut			$000D/*									*//*	Custom resource types			*//*									*/type rSCSIDescDrvr	{	/*	Descriptors associated with rSCSIDrvr resource							with same ID.  These are needed for the							driver's partition map entry.				*/					/* ### numbers get compiled into Mac byte order	###					   ### because that's how they appear in the	###					   ### partition map entry						### */		reversebytes{longint;};		/* pmLgBootStart		*/		reversebytes{longint;};		/* pmBootSize			*/		reversebytes{longint;};		/* pmBootLoad			*/		reversebytes{longint;};		/* pmBootLoad2			*/		reversebytes{longint;};		/* pmBootEntry			*/		reversebytes{longint;};		/* pmBootEntry2			*/	/*	reversebytes{longint;};	*/	/* pmBootCksum			*/	wide array[128] {		byte;		};						/* 128 bytes of boot-specific								   arguments					*/};type rSCSIDrvr {			/* binary image of SCSI boot driver		*/	wide array {		byte;		};};/*									*//*	Resource declarations			*//*									*//* The SCSI driver resource must be an even # of blocks in length!	*/read rSCSIDrvr    (0x00000001,preload, nonpurgeable)  "mac.driver";resource rSCSIDescDrvr (0x00000001,preload, nonpurgeable) {	/* these values get compiled into Mac byte order	*/	{	0x00000000},				/* pmLgBootStart		*/	{	0x000017E2},				/* pmBootSize			*/	{	0x00000000},				/* pmBootLoad			*/	{	0x00000000},				/* pmBootLoad2			*/	{	0x00000000},				/* pmBootEntry			*/	{	0x00000000},				/* pmBootEntry2			*/	/*{	0x000063EE}	*/				/* pmBootCksum			*/	{		/* boot-specific arguments		*/			/* These are set according to the values for any Apple-	*/			/* provided drive, from the file "hardDrives.h" for		*/			/* HDSC Partition.										*/		0x00, 0x01, 0x06, 0x00,			/* drvr signature	*/		0x00, 0x00, 0x00, 0x01,			/* pollbyte			*/		0x00, 0x00, 0x00, 0x02,			/* TIB type			*/		0x00, 0x07,						/* blind bits		*/		0x00, 0x00,						/* shutdown stop	*/		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00	};};/*	New resources for main dialog	*/resource rWindParam1 (mainDlog) {	fTitle + fVis,							/* frame bits 			*/	MTitleTxt,								/* title ID				*/	0,										/* ref con	 			*/	{0,0,0,0},								/* zoom rect			*/	0,										/* color table ID		*/	{0,0},									/* origin				*/	{0,0},									/* data size			*/	{0,0},									/* max height/width		*/	{0,0},									/* scroll amount, hor/ver	*/	{0,0},									/* page amount			*/	0,										/* info ref con			*/	0,										/* info height			*/	{50,133,154,508},						/* window position		*/	infront,								/* wPlane				*/	mainDlog,								/* controls ref			*/	wColorAsRes + wTitleAsRes + wCtlAsRes 	/* descriptor 			*/};/*	controls for main dialog		*/resource rControlList (mainDlog) {	{	MEraseBut,/*	MTitleTxt,	*/	MDiskBut,	MStatTxt,	MPartBut,	MCancelBut,	MInitBut,	MZeroBut,	MInfoBut	};};resource rControlTemplate (MEraseBut) {	MEraseBut,								/* control ID			*/	{31,125,44,220},						/* control rect			*/	SimpleButtonControl{{					/* control type			*/		0,									/* flags				*/		fctlProcNotPtr + RefIsResource,		/* more flags			*/		0,									/* ref con				*/		MEraseBut							/* title ref			*/	}};};resource rpString (MEraseBut) {	"Erase…"};resource rControlTemplate (MTitleTxt) {	MTitleTxt,								/* control ID			*/	{5,18,15,380},							/* control rect			*/	StatTextControl{{						/* control type			*/		0xFF00,								/* flag					*/		RefIsResource		+ FctlProcNotPtr,					/* moreFlags			*/		0,									/* ref con				*/		MTitleTxt							/* title ref			*/	}};};resource rTextForLETextBox2 (MTitleTxt) {	"Apple IIGS Advanced Disk Utility         v"	versionString};resource rpString (MTitleTxt) {	"Apple IIGS Advanced Disk Utility         v"	versionString};resource rControlTemplate (MDiskBut) {	MDiskBut,								/* control ID			*/	{6,262,20,353},							/* control rect			*/	SimpleButtonControl{{					/* control type			*/		0,									/* flags				*/		fctlProcNotPtr + RefIsResource			+ FctlWantsEvents,				/* more flags			*/		0,									/* ref con				*/		MDiskBut,							/* title ref			*/		0,									/* color table ref		*/		{"\0x09","\0x09",0,0}				/* key equiv			*/	}};};resource rpString (MDiskBut) {	"Disk"};resource rControlTemplate (MStatTxt) {	MStatTxt,								/* control ID			*/	{85,0,108,375},							/* control rect			*/	StatTextControl{{						/* control type			*/		0xFF03,								/* flag					*/		RefIsResource		+ FctlProcNotPtr,					/* moreFlags			*/		0,									/* ref con				*/		MStatTxt							/* title ref			*/	}};};resource rTextForLETextBox2 (MStatTxt) {	TBCenterJust	"*0"									/* substitution string	*/};resource rControlTemplate (MPartBut) {	MPartBut,								/* control ID			*/	{57,75,71,170},							/* control rect			*/	SimpleButtonControl{{					/* control type			*/		0,									/* flags				*/		fctlProcNotPtr + RefIsResource,		/* more flags			*/		0,									/* ref con				*/		MPartBut							/* title ref			*/	}};};resource rpString (MPartBut) {	"Partition…"};resource rControlTemplate (MCancelBut) {	MCancelBut,								/* control ID			*/	{57,262,71,353},						/* control rect			*/	SimpleButtonControl{{					/* control type			*/		0,									/* flags				*/		fctlProcNotPtr + RefIsResource,		/* more flags			*/		0,									/* ref con				*/		MCancelBut							/* title ref			*/	}};};resource rpString (MCancelBut) {	"Quit"};resource rControlTemplate (MInitBut) {	MInitBut,								/* control ID			*/	{6,125,20,220},							/* control rect			*/	SimpleButtonControl{{					/* control type			*/		0,									/* flags				*/		fctlProcNotPtr + RefIsResource,		/* more flags			*/		0,									/* ref con				*/		MInitBut							/* title ref			*/	}};};resource rpString (MInitBut) {	"Initialize…"};resource rControlTemplate (MZeroBut) {	MZeroBut,								/* control ID			*/	{6,20,20,115},							/* control rect			*/	SimpleButtonControl{{					/* control type			*/		0,									/* flags				*/		fctlProcNotPtr + RefIsResource,		/* more flags			*/		0,									/* ref con				*/		MZeroBut							/* title ref			*/	}};};resource rpString (MZeroBut) {	"Zero…"};resource rControlTemplate (MInfoBut) {	MInfoBut,								/* control ID			*/	{31,20,44,115},							/* control rect			*/	SimpleButtonControl{{					/* control type			*/		0,									/* flags				*/		fctlProcNotPtr + RefIsResource,		/* more flags			*/		0,									/* ref con				*/		MInfoBut							/* title ref			*/	}};};resource rpString (MInfoBut) {	"Info"};