{################################################################}{#								#}{#  File:	Globals.Pas from IIGS Disk Initializer		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Description:  This file has all the global vars and const's	#}{#		  that is used by the IIGS Disk Initializer	#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Authors:	Darryl Lovato					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Copyright:	1987,1988 by Apple Computer Inc.		#}{#		All rights reserved.				#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Modification History:					#}{#								#}{#	Who	When	The Change				#}{#	---	------	-------------------------------------	#}{#	SR	12/7/87	Created v.1 - erase & init only		#}{#	DGL	1/29/88 Rewrote everything - cut size in half!  #}{#	DGL	5/9/88	Finished Adding Partition Support	#}{#			and other features... far too many to	#}{#			list here...				#}{#	DGL	5/12/88 Added Zero and Info operations		#}{#	DGL	5/20/88 Released pre-alpha version to testers	#}{#	DGL	6/1/88  Alpha!					#}{#	DGL	6/13/88 Alpha 2					#}{#	DGL	6/24/88 Alpha 3					#}{#	DGL	7/1/88  Beta 1					#}{#	DGL	7/13/88 Beta 2					#}{#	DGL	7/20/88	Beta 3					#}{#	DGL	7/27/88	Beta 4					#}{#	DGL	8/1/88	Beta 5					#}{#	DGL	8/8/88	Beta 6					#}{#	DGL	8/15/88 Final!					#}{#								#}{################################################################}{$LongGLobals-}{$ToolErrorChk-}{$A+}unit Globals;interfaceuses  InitIntfData,         {HodgePodge Apple IIGS Toolbox Interface Units}  InitIntfProc,  InitIntfPDOS,  ListMgr;{################################################################}{#		global constants follow				#}{################################################################}CONST  arrow = 0; { cursor constants}  watch = 1;  ScreenMode        = $80;   {640 mode}  MaxX              = 640;   {Max X clamp (should correspond to ScreenMode}  MaxScan           = 160;   {Max size of scan line}  AppleMenuID       = 300;    AboutItem       = 301;  FileMenuID        = 400;    InitItem        = 401;    QuitItem        = 409;{Error Codes returned from VOLUME call}  IOError           = 39;       {$27}  NoDevice          = 40;  OtherOS           = 82;       {$52}  NoDiskInDrive     = 47;       {$2F}  NoError           = 0;{ constants added by Monte Benaresh for driver partition support  }  pMapSizeBlks = 64;	{ # of blocks for partition map	}  drvrSizeBlks = 32;	{ # of blocks for each driver partition }  sysPartCount = 5;	{ 1 partition map and 4 driver partitions }  rSCSIDrvr = $4D61;  rSCSIDescDrvr = $5E72;{ new constants to support real modeless main window }  mainDlog = $1001;  MEraseBut = $0002;  MTitleTxt = $0003;  MDiskBut = $0005;  MStatTxt = $0008;  MPartBut = $0009;  MCancelBut = $000A;  MInitBut = $000B;  MZeroBut = $000C;  MInfoBut = $000D;  rWindParam1 = $800E;  { Parameters for NewWindow2 call }{ dialog ref cons for easy ID in event filter routine for content update }  InfoRef = $1002;  DiskNameRef = $1003;  InitRef = $1004;  AboutRef = $1005;  PartRef = $1006;{################################################################}{#		global types follow				#}{################################################################}TYPE  Longword = RECORD    LoWord : INTEGER;    HiWord : INTEGER;  END;  Part = record    partSize : longint; {size in 1024 of blocks (half-megs) }    partName : string[31];  end;    PartitionRec = record    PartCount : integer;    PartsInfo : array[1..1] of Part;  end;  PartitionPtr = ^PartitionRec;  PartitionHdl = ^PartitionPtr;  myBlock = record     pCount : integer;     devNumber : integer;     devname : StringPtr;     characteristics : integer;     totalBlocks : longint;     slotNum : integer;     unitNum : integer;     version : integer;     devID : integer;   end;  infoListRec = record     devName : string[32];     devNum : integer;   end;  NameArrayTbl = array[1..1] of stringPtr;  BigIcons = packed array[0..329] of char;  LongPtr = ^Longint; IntPtr = ^INTEGER;    str32 = string[31];    PartHdl = ^PartPtr;    PartPtr = ^PartRec;    PartRec = packed record        pmSig : Integer;	 { signiature word - always $504D}        pmSigPad : Integer;	 { reserved for future use}        pmMapBlkCount : Longint; { number of blocks in map}        pmPyPartStart : Longint; { first physical block of partition}        pmPartBlkCount : Longint;{ number of blocks in partition}        pmPartName : str32; 	 { partition name}        pmPartType : str32; 	 { partition type}        pmLgDataStart : Longint; { first logical block of boot code}        pmDataCnt : Longint;	 { number of blocks in data area}        pmPartStatus : Longint;	 { partition status information}        pmLgBootStart : Longint; { first logical block of boot code}        pmBootSize : Longint;	 { size in bytes of boot code}        pmBootLoad : Longint;	 { boot code load address}        pmBootLoad2 : Longint;	 { additional boot load information}        pmBootEntry : Longint;	 { boot code entry point}        pmBootEntry2 : Longint;	 { additional boot entry information}        pmBootCkSum : Longint;	 { boot code checksum}        pmProcessor : packed array[0..15] of char; { processor type}	{ boot-specific argument fields copied from Mac HD SC Setup v3.0a2	}	CASE INTEGER OF	  1: (pmBootSpecific : PACKED ARRAY [0..375] OF BYTE); { placeholder label }	  2: (	      drvrSig     : LongInt;		{ boot specific argument 1}	      has_tags    : LongInt;		{boot specific argument 2}	      pollByte    : LongInt;		{ boot specific argument 3 }	      {boot_arg4   : LongInt;}		{ boot specific argument 4}	      blindtype   : INTEGER;		{ one of several }	      shutdown    : INTEGER;		{ set if this drive wants head park }	      { WARNING: Mac+ boot code doesn't load the last 256 bytes! }              pmBootUnused : PACKED ARRAY [0..111] OF BYTE; { unused boot-specific args}              pmUnused : packed array[0..247] of char; { other!}	      );      end;   PartStructHdl = ^PartStructPtr;   PartStructPtr = ^PartStructRec;   PartStructRec = array[0..0] of partrec;  { Driver Descriptor and Driver Descriptor Map (DDM) record added by Monte Benaresh	}    drvrDesc = PACKED RECORD        ddBlock : LONGINT;		{ first block of driver }	ddSize : INTEGER;		{ driver size in blocks }	ddType : INTEGER;		{ system type: 1 = MAC, $F = Apple IIGS }      END;    DDMRec = PACKED RECORD        sbSig : INTEGER;		{ signiature word - always $4552 in MAC order }        sbBlockSize : INTEGER;		{ block size of device }        sbBlkCount : LONGINT;		{ number of blocks on device }        sbDevType : INTEGER;		{ used internally }        sbDevID : INTEGER;		{ used internally }        sbData : LONGINT; 		{ used internally }        sbDrvrCount : INTEGER; 		{ number of driver descriptors }	sbDDs : PACKED ARRAY [1..61] OF drvrDesc;	{ driver descriptors }        sbUnused : PACKED ARRAY [1..6] of char; { leftover }      END;    DDMPtr = ^DDMRec;   myInfoBlock = record  { used for GSOS D_info calls}       pCount : integer;       devNumber : integer;       devname : StringPtr;       characteristics : integer;       totalBlocks : longint;       slotNum : integer;       unitNum : integer;       version : integer;       devID : integer;       headlink : integer;       forwardlink : integer;     end;      myWriteBlock = record { used for GSOS D_write calls}       pCount : integer;       devNum : integer;       buffer : Ptr;       reqCount : Longint;       startBlk : Longint;       blkSize : Longint;       transCount : Longint;     end;   myFormatBlock = record { used for GSOS format/erase calls}       pCount : integer;       devName : Ptr;       volName : Ptr;       FSNumOut : Integer; {0 = canceled}       FSNumIn : Integer;       flags : INTEGER;		{ fields added 2/91 by Monte Benaresh }       realVolName : Ptr;     end;    myReadCapBlk = record       xero : integer;    { must be zero}       twofive : integer; { command and flags}       unused1 : longint; { 10 unused bytes}       unused2 : longint;       unused3 : integer;       result : ptr;  { return capacity here}    end;   myStatusBlock = record { used for GSOS D_status calls}       pCount : integer;       devNumber : integer;       statCode : integer;       StatList : Ptr;       RequestCount : longint;       TransferCount : longint;     end;   myControlBlock = record { used for GSOS D_control calls}       pCount : integer;       devNumber : integer;       CtlCode : integer;       CtlList : Ptr;       RequestCount : longint;       TransferCount : longint;     end;      myVolumeBlock = record       pCount : integer;       devName : Ptr;       volName : Ptr;       totalBlks : longint;       freeBlks : longint;       fileSysId : integer;       blkSize : integer;     { next fields added by Monte 8/17/91 }       characteristics : INTEGER;     end;         myStatusResult = record { used for GSOS D_status results}     general : Integer;     blkCount : Longint;   end;   myVersionBlock = RECORD     pcount : INTEGER;     version : INTEGER;   END;      gsosstring = record      size : integer;      chars : str255;   end;   GSStrPtr = ^gsosstring;		{ added 2/91 by Monte }    GSOSResultBuf = PACKED RECORD	{ added 2/91 by Monte }      bufSize : INTEGER;      CASE INTEGER OF         1:  (rtnSize : INTEGER; data : PACKED ARRAY [0..0] OF BYTE);         2:  (gstring : gsosstring);    END;    GSResultPtr = ^GSOSResultBuf;      CapBlockRec = record     numBlks : longint;     blkSize : longint;   end;	{ next records added 2/91 by Monte	}    ModeSenseRec = PACKED RECORD	{ SCSI mode sense status list	}      version : INTEGER;      cmd : Byte;      pgFormat : Byte;      pgCode : Byte;      reserved : PACKED ARRAY [1..9] OF Byte;      bufPtr : Ptr;    END;    SCSIString = PACKED RECORD		{ SCSI ID string returned by mode sense }      garbage : PACKED ARRAY [1..13] OF Byte;      IDStr : STRING[50];    END;(*    SetConfigRec = PACKED RECORD      length : INTEGER;      bitmap : INTEGER;      DDMptr : Ptr;      drvrInfoPtr : Ptr;      drvrDataPtr : Ptr;    END;*)    SetConfigRec = PACKED RECORD      drvrNum	: INTEGER;      DDMBufSize : INTEGER;      DDMTransCount : INTEGER;      DDMPtr	: Ptr;      drvrInfoBufSize : INTEGER;      drvrInfoTransCount : INTEGER;      drvrInfoPtr : Ptr;      drvrBufSize : INTEGER;      drvrTransCount : INTEGER;      drvrDataPtr : Ptr;    END;    GSOpenRec = PACKED RECORD      pcount : INTEGER;      refNum : INTEGER;      path : Ptr;      reqAccess : INTEGER;      resNum : INTEGER;      access : INTEGER;      filetype : INTEGER;      auxtype : INTEGER;      storType : INTEGER;      createTD : PACKED ARRAY [0..7] OF Byte;      modTD : PACKED ARRAY [0..7] OF Byte;      optList : Ptr;      eof : LONGINT;    END;    GSReadRec = PACKED RECORD      pcount : INTEGER;      refNum : INTEGER;      bufPtr : Ptr;      reqCount : LONGINT;      transCount : LONGINT;    END;    GSCloseRec = PACKED RECORD      pcount : INTEGER;      refNum : INTEGER;    END;    bootDrvrDescRec = PACKED RECORD	{ this is format of SCSIDescDrvr resource }      pmLgBootStart : LONGINT;      pmBootSize : LONGINT;      pmBootLoad : LONGINT;      pmBootLoad2 : LONGINT;      pmBootEntry : LONGINT;      pmBootEntry2 : LONGINT;      bootArg : PACKED ARRAY [0..127] OF BYTE;    END;    bootDrvrDescPtr = ^bootDrvrDescRec;    bootDrvrDescHdl = ^bootDrvrDescPtr;(*    GSGDERec = PACKED RECORD	{ for GET_DIR_ENTRY }      pcount : INTEGER;      refNum : INTEGER;      reserved : INTEGER;      base : INTEGER;      disp : INTEGER;      nameBuf : Ptr;      entryNum : INTEGER;      filetype : INTEGER;      eof : LONGINT;      blocksUsed : LONGINT;      createTD : PACKED ARRAY [0..7] OF Byte;      modTD : PACKED ARRAY [0..7] OF Byte;      access : INTEGER;      auxtype : LONGINT;    END;*){################################################################}{#		global variables follow				#}{################################################################}VAR  { variables used in the list manager }  partDlog : GrafPortPtr;  myListRec : ListRec;  myList : array[1..32] of ListMemRec;  myListCtrl : ControlHandle;  listNameAry : array[1..32] of string[31];  infoList : array[1..32] of infoListRec;  selected : integer;  astr : str255;  s1,s2 : GSOSString;  listControl1 : ControlHandle;  listScroll1 : ControlHandle;  listRect1 : Rect;  listCtlRef1 : Longint;  listScrollRef1 : Longint;  realsize : CapBlockRec;  toolErr : integer; {Should be _toolErr, but symbols can't start with _}    EraseButton : ControlHandle;  PartButton : ControlHandle;  InitButton : ControlHandle;  ZeroButton : ControlHandle;  InfoButton : ControlHandle;{  CheckButton : ControlHandle;		removed 1/91 by Monte Benaresh  BackupButton : ControlHandle;  RestoreButton : ControlHandle;}  CancelButton : ControlHandle;    SizeBar : ControlHandle;  NewButton : ControlHandle;  DeleteButton : ControlHandle;  initPtr : Ptr; { used for startup/shutdown tools}  blk : myBlock;	      { prodos D_Info param block}  MyMemoryID   : integer;     {Application ID assigned by Memory Mgr}  Done         : boolean;     {True when quitting}  ToolsZeroPage: Handle;      {Handle to Zero page memory for Tools}  CurrPart     : integer;	{-1 = no current partition ; 1..4 = partition #}  Event        : wmTaskRec;   {All events are returned here}  deviceNum    : integer;  lastCheck    : longint;  CurrCursor   : integer;  currState    : integer;  isRemovable  : boolean;  curVolIcon   : Ptr; { atLeastOneDev,	}  noDevices    : boolean;  isLockedDev  : boolean;  initializedDev : boolean;  IsFloppy	: boolean;  tMegs		: longint;  MaxNumParts   : integer;  r,mesgBoxRect,  initBtnRect  : rect;  globalstr1   : str255;      {used to pass strings to dialog templates!}  globalstr2   : str255;  InitDlogPtr  : GrafPortPtr;  GlobalParts  : PartitionHdl;  currDeviceStr : str255;  currVolumeStr : str255;  dispVolumeStr : str255;  tempstr1 : str255;  tempstr2 : str255;  miscStr : str255;  miscStr1 : str255;  dummy : str255;    diskBlockSize : Longint;  infoBlk : myInfoBlock;  statusBlk : myStatusBlock;  ctlBlk : myControlBlock;  writeBlk : myWriteBlock;  volBlk : myVolumeBlock;	{ added 8/17/91 by Monte }  statResult : myStatusResult;  dummyBlk : PartRec;  ReadCapBlk : myReadCapBlk;  FormatBlk : myFormatBlock;  modeSenseBlk : ModeSenseRec;  setConfigBlk : SetConfigRec;  { next added by Monte Benaresh	}  subStrArray : PACKED ARRAY[0..0] OF StringPtr;  iconPtr : Ptr;  oldPort : GrafPortPtr;{  lastPoll : LONGINT;	}	{ for device polling }  tempGLong : LONGINT;{################################################################}{#	externally defined global variables follow		#}{################################################################}  {$XRefVar+}  { this is all our structures defined in assembler!}  AppleMenuStr: Str255;          {For creating menus}  FileMenuStr : Str255;  EditMenuStr : Str255;  DiskErrorAlert : AlertTemplate; {alerts and dialogs}  WarningAlert : AlertTemplate;  WarningItem3 : ItemTemplate;  DiskNameDlog : DialogTemplate;  InitDlog : DialogTemplate;  InitItem8 : ItemTemplate;  AboutDITL : DialogTemplate;  PartDITL : DialogTemplate;  AlertDITL : DialogTemplate;  InfoDITL : DialogTemplate;  ToolRec : ToolTable;  EditItem : ItemTemplate;  EditRect : Rect;  NilRect : Rect;    {icons}  FakeArray : array[0..3] of BigIcons;  Floppy : integer;  Three : integer;  harddisk : integer;  ramdisk : integer;  cd : integer;  tape : integer;  appletalk : integer;  partition : integer;  cdPartition : integer;  other : integer;  {NoName : integer;	removed 3/91 by Monte }  lockicon : integer;  unlockicon : integer;  total_blks : longint;  free_blks : longint;  file_system_id : integer;  FileSysStrTbl : NameArrayTbl;  okStr         : string;	{ strings}{  PromptStr     : string;	removed 3/91 by Monte }{  ShutDownStr   : string;	removed 3/91 by Monte }  warningStr    : string;  warning2Str   : string;{  warning3Str	: string;	replaced with AlertWindow 6/17/91 by Monte }{  badNameErr    : string;	removed 3/91 by Monte }{  warning4Str	: string;	replaced with AlertWindow 8/9/91 by Monte }{  otherOSStr    : string;	removed 3/91 by Monte }  Uninitialized : string;  volNameStr    : string;  successStr    : string;{  initializingStr:string;	removed 1/91 by Monte Benaresh	}  ReadPartErrStr: string;  cancelInitStr : string;  AtLeastOneCanceled : string;  blankStr      : string;  unInitStr     : string;  formatErrStr  : string;  eraseErrStr   : string;  eraseErrOpenStr   : string;	{ added 8/5/91 by Monte	}  initErrOpenStr   : string;	{ added 8/19/91 by Monte }  zeroErrOpenStr   : string;	{ added 8/19/91 by Monte }  cancelPartStr : string;  eraseSuccStr  : string;  noDevicesStr  : string;  cancelEraseStr: string;  zeroingvolStr : string;  zeroingvolSuccess : string;  zeroingVolFail : string;  startzerovolStr : string;  cancelzeroStr : string;  PartErrStr    : string;{  formatPartErrStr : string;}  successpartStr : string;  DefName	: stringPtr;  unknownptr	: stringptr;  scrollArray	: array[0..14] of integer;  ScrollColor   : integer;  ScrollColor1   : integer;  InvRect, mainIconRect : Rect;  { next stuff added by Monte Benaresh }  drvrProcessor	: PACKED ARRAY [1..4] OF StringPtr;  OpenPBlk : GSOpenRec;  drvrPath : GSOSString;  ReadPBlk : GSReadRec;  ClosePBlk : GSCloseRec;  hardFmtAlrt, zeroAlrt, partAlrt : PACKED ARRAY [0..0] OF CHAR;  partLockAlrt, formatErrAlrt : PACKED ARRAY [0..0] OF CHAR;  partOpenAlrt, macConnectAlrt : PACKED ARRAY [0..0] OF CHAR;  formatCtlList : PACKED ARRAY [0..0] OF CHAR;  initMsgWindow : PACKED ARRAY [0..0] OF CHAR;  { pointers to stuff for TLTextMountVolume call }  badStart1Str : String;  badStart2Str : String;  badStart1But : String;  badStart2But : String;    {$XRefVar-}implementationend.