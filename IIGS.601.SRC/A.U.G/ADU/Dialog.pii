{################################################################}{#								#}{#  File:	Dialog.Pas from IIGS Disk Initializer		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Description:  This file has all the routines that handle	#}{#		  the creation, functionality and disposal of	#}{#		  the dialogs used in the program.		#}{#								#}{#--------------------------------------------------------------#} {#								#}{#  Author:	Darryl Lovato					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Copyright:	1987,1988 by Apple Computer Inc.		#}{#		All rights reserved.				#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Modification History:					#}{#								#}{#	Who	When	The Change				#}{#	---	------	-------------------------------------	#}{#	SR	12/7/87	Created v.1 - erase & init only		#}{#	DGL	1/29/88 Rewrote everything - cut size in half!  #}{#	DGL	5/9/88	Finished Adding Partition Support	#}{#			and other features... far too many to	#}{#			list here...				#}{#	DGL	5/12/88 Added Zero and Info operations		#}{#	DGL	5/20/88 Released pre-alpha version to testers	#}{#	DGL	6/1/88  Alpha!					#}{#	DGL	6/13/88 Alpha 2					#}{#	DGL	6/24/88 Alpha 3					#}{#	DGL	7/1/88  Beta 1					#}{#	DGL	7/13/88 Beta 2					#}{#	DGL	7/20/88	Beta 3					#}{#	DGL	7/27/88	Beta 4					#}{#	DGL	8/1/88	Beta 5					#}{#	DGL	8/8/88	Beta 6					#}{#	DGL	8/15/88 Final!					#}{#								#}{################################################################}{ these options turn long addressing on, and turn error checking off}{ in addition, they set the pascal comments in assembler on.}{$LongGLobals-}{$ToolErrorChk-}{$ToolErrorChk+}{$A+}unit Dialog;interfaceuses  InitIntfData,  InitIntfProc,  InitIntfPDOS,  ListMgr,  Globals,  Utils,  Guts;procedure DoAboutItem;            {About item in apple menu}procedure ShowInit;               {Init Dialog}procedure SetActivePartition(thePart : integer);procedure ProcessInit;		{ handle control hit in main Dlog }procedure NextDrive;implementationprocedure DrawAlloChart(totalRedraw : boolean);			FORWARD;PROCEDURE MainWindUpdt;						FORWARD;{################################################################}{#	filter to be called for dlogs with 1 item lists		#}{################################################################}function myDlogFilter(theDlog : grafportptr; var someEvent : wmTaskRec;			  var itemhit : integer) : integer;  const    isfalse = 0;    istrue = $FFFF;        EnterChar = 3;    Tab = 9;    CRChar = 13;    Escape = 27;    LArrow = 21;    RArrow = 8;    Rubout = 127;  var    temp : integer;    theControl : ControlHandle;  {  temp1,temp2 : Longint;	}    test1 : boolean;    ch : char;  {  lowerflag : boolean;	}    tempPt : Point;  BEGIN    PHB;	{ added 3/91 by Monte }    phk; {make sure data bank is set correctly}    plb;    myDlogFilter := 0;    with someEvent do      begin        if wmWhat = 1 then { mouse-down }          begin            temp := findcontrol(theControl,wmwhere.h,wmwhere.v,theDlog);            GlobalToLocal(wmwhere);	    test1 := PtInRect(wmwhere, listRect1);            LocalToGlobal(wmwhere);	    if test1 then	      begin	        myDlogFilter := $F;	        itemhit := 100;	      end;	    if theControl <> SizeBar then {its not our scroll bar, not the lists!}              if (temp in [5..8, 129]) or test1 then                 begin                   RestoreRefCons;                   temp := TrackControl(wmwhere.h,wmwhere.v, Pointer(-1), theControl);	           ZeroRefCons;	           wmwhat := 0; {can you say kludge?}                 end;              {make cr's look like cr's!}           end        else if (wmWhat = 3) or (wmWhat = 5) then { keydown, autokey}	{	Key filter stuff eliminated 3/31/91 by Monte Benaresh		}	{	b/c we now have an init/erase dialog in the OS which enforced	}	{	name syntax and this filter is used in situations where the	}	{	ProDOS name restrictions do not apply.				}          BEGIN	    if char(loword(bitand(wmMessage,$FF))) = char($D) then { cr!}              begin                itemhit := 1; {default button}                myDlogFilter := 1; {True}                if theDlog = partDlog then                  begin                    temp := currPart;                    SetActivePartition(-2);                    currPart := temp;                  end		else		  BlinkButton(GetControlItem(theDlog,1));              end	    else	      begin		ch := char(bitand(loword(wmMessage), $FF));	(*	lowerflag := (ord(ch) >= ord('a')) and (ord(ch) <= ord('z'));		if (bitand(wmModifiers,OptionKey+ControlKey) = 0) and		   (lowerflag or		   (ch = '.') or		   (ch = char(EnterChar)) or		   (ch = char(Tab)) or		   (ch = char(Escape)) or		   (ch = char(RArrow)) or		   (ch = char(LArrow)) or		   (ch = char(Rubout)) or		   ((ord(ch) >= ord('0')) and (ord(ch) <= ord('9'))) or		   ((ord(ch) >= ord('A')) and (ord(ch) <= ord('Z')))) then		   begin	*)	       if (ch = char(Escape)) and (theDlog = partDlog) then	         begin		   itemhit := 2;	  	   myDlogFilter := isTrue;		   BlinkButton(GetControlItem(theDlog,2));	         end;	       if (ch = char(EnterChar)) and (theDlog <> partDlog) then	         begin		   itemhit := 1;		   myDlogFilter := isTrue;		   BlinkButton(GetControlItem(theDlog,1));	         end;	(*	     if lowerflag then { change it to upper case}		       wmMessage := ord(ch) - $20;		   end	*)	(*	 else		   begin		     wmMessage := 0; {so the dlog manager doesn't see it}		     itemhit := 0;		     myDlogFilter := istrue;		   end;	*)	     end;	END;      IF wmWhat = 6 THEN { update }	{ added 3/7/91 by Monte for Video Kbd }      BEGIN      oldPort := GetPort;      SetPort(GrafPortPtr(wmMessage));        CASE LONGWORD(GetWRefCon(GrafPortPtr(wmMessage))).LoWord OF        { do window-specific updating }          InfoRef :	    BEGIN              BeginUpdate(GrafPortPtr(wmMessage));	      DrawDialog(GrafPortPtr(wmMessage));              tempPt.v := 6;	{ coordinates for vol icon }	      tempPt.h := 35;	      PlotIconola(iconPtr, tempPt, FALSE); { plot current info icon }	      IF isLockedDev THEN { was it a locked device? }	      BEGIN	        tempPt.v := 6;	        tempPt.h := 2;	        PlotIconola(@lockIcon, tempPt, true); { draw lock icon }	      END;              EndUpdate(GrafPortPtr(wmMessage));              myDlogFilter := 1; { return TRUE to say we handled the event }	    END;	  PartRef :	    BEGIN              BeginUpdate(GrafPortPtr(wmMessage));	      DrawDialog(GrafPortPtr(wmMessage));	      DrawAlloChart(TRUE);              EndUpdate(GrafPortPtr(wmMessage));              myDlogFilter := 1; { return TRUE to say we handled the event }	    END;        END; {case}      SetPort(oldPort);      END; {begin}    end;    PLB;	{ caller's DBR }  END;{################################################################}{#	draw out custom list member.  It has a color coding box	#}{################################################################}     procedure DrawList(r : Rect; memRec : ListMemP; listH : ControlHandle);  var    boxR : Rect;    i : integer;  begin    PHB;	{ added 3/91 by Monte }    phk; {make sure data bank is set correctly}    plb;    with memRec^ do      begin        eraseRect(r);        boxR := r;        r.h1 := r.h1 + 30;        inc(boxR.v1);        dec(boxR.v2);        boxR.h2 := boxR.h1 + 28;        boxR.h1 := boxR.h1 + 2;        i := 0;        repeat          inc(i);        until (memRec = @myList[i]);		{SpecialRect(boxR,0,scrollarray[i]); *-DGL-*}	SpecialRect(boxR,0,scrollarray[i mod 13]);	        moveto(r.h1 + 5, r.v1 + 8);        drawstring(StringPtr(memPtr)^);        if bitand($80,memFlag) <> 0 then { we need to select it}          InvertRect(r);      end;    PLB;	{ caller's DBR }  end;{################################################################}{#		rebuild the partition name list			#}{################################################################}procedure RebuildList(startSel : integer);var  miscWord : integer;  myListRecPtr : ListRecP;begin  myListRecPtr := @myListRec;  if listControl1 <> nil then    begin (*     DrawMember(ResetMember(myListRecPtr),myListRecPtr); { remove any selections} removed 3/4/91 by Monte *)      DisposeControl(listControl1); {remove the list, so we can create a new one}      DisposeControl(listScroll1);  { also remove its scroll bar}    end;      with GlobalParts^^ do    begin      miscword := 0;      while (miscword < partCount) do        begin          inc(miscword);          listNameAry[miscWord] := PartsInfo[miscword].partName;	  with myList[miscWord] do	    begin              memPtr := @listNameAry[miscWord];              memFlag := 0;	    end;        end;    end;  with myListRec, listRec do {set up the list record}    begin      v1 := 10;      h1 := 20;      v2 := 62;      h2 := 204;      listsize := miscword; {number of items}      listview := 5;      listtype := 2;      liststart := startSel;      listctl := nil;      listdraw := @DrawList;      listmemheight := 10;      listmemsize := sizeof(listmemrec);      listpointer := @myList;      listrefcon := 0;      listscrollclr := nil;    end;  ListRect1 := myListRec.listRec;  listControl1 := CreateList(PartDlog,myListRecPtr);  listScroll1 := listControl1^^.CtlListBar;{  SelectMember(@myList[1], myListRecPtr);	removed 3/4/91 by Monte	}  SaveAndZeroRefCons;{ force redraw on next time through event loop }{  InvalRect(listRect1);		}{ added 3/4/91 by Monte }{  InvalRect(listScroll1^^.ctrlRect);	}  DrawOneCtl(listControl1);  DrawOneCtl(listScroll1);end;{################################################################}{#	check to make sure there are no duplicate partitions	#}{################################################################}function BadPartNames(var duperr : boolean) : boolean;  var    i,j : integer;  label 1;  begin    BadPartNames := false; {assume the best}    with GlobalParts^^ do      for i := 1 to PartCount do        if partsinfo[i].partName = '' then	  begin	    dupErr := false;	    badPartNames := true;	    goto 1;	  end;    with globalParts^^ do      for i := 1 to PartCount do        for j := i to PartCount do	  if (j <> i) and (partsinfo[i].partName = partsinfo[j].partName) then	    begin	      BadPartNames := true;	      duperr := true;	      goto 1;	    end;1:end;{################################################################}{#	draw the lines that group the buttons in the main dlog	#}{################################################################}procedure DrawLines;var  thePt : Point;  temp : ptr;begin  SetPort(InitDlogPtr);{  moveto(0,20);	removed 3/8/91 by Monte Benaresh	}{  lineto(380,20);	}  moveto(0,78);		{ all vertical positions reduced by 21 for new window frame }  lineto(380,78);	{ -- Monte Benaresh 3/8/91				}  moveto(235,0);  lineto(235,78);  moveto(236,0);  lineto(236,78);  with thePt do    begin      v := 27;      h := 276;    end;  PlotIconola(curVolIcon,thePt,false);  with thePt do    begin      v := 27;      h := 240;    end;     temp := @unlockicon;  if islockeddev then    temp := @lockIcon;  PlotIconola(temp, thePt, true);end;{################################################################}{#	get the sum of all current partition sizes		#}{################################################################}function SumPartSizes : integer;  var    sum : integer;    i : integer;  begin    {find the total amount that this would make on a disk}    sum := 0;    with GlobalParts^^ do      for i := 1 to partCount do        with partsinfo[i] do          if partsize = 0 then            inc(sum)          else            sum := sum + partsize;    SumPartSizes := sum;  end;{################################################################}{#	draw partition allo chart, totalredraw draws everything	#}{################################################################}procedure DrawAlloChart(totalRedraw : boolean);	{ NOTE: All GrafPort params must be preserved during this PROC	}	{ because it gets called by ScrollAction which gets called by	}	{ the Control Manager.						}  var    dumbRect, newRect : rect;    i, newY : integer;    tAllocated : integer;    oldPenSize : point;  begin    GetPenSize(@oldPenSize);    SetPenSize($0002, $0001);	{ standard pen for all our frames	}    tAllocated := 0;    with dumbRect do      begin        h1 := 240;        h2 := 320;        v2 := 148;        v1 := 148;      end;    with GlobalParts^^ do      for i := PartCount downto 1 do { do this for all partitions!}        with PartsInfo[i], dumbRect do          begin            tAllocated := tAllocated + partSize;            v2 := v1 + 1;	    v1 := v1 - Real2Int((partSize * 138) / tMegs);	    if v1 < 10 then	      v1 := 10;            if (i <= currPart) or totalRedraw then {draw it}              begin	        { this fixes any roundoff that occurs by making the last}	      	{ partition pin to the top if the disk is full.  This can slightly}		{ distort the size of the top partition though.. Testing liked it better}		{ this way, so this is how I'm doing it!}	        if (i = 1) and (SumPartSizes = tMegs) then		  v1 := 10;		{SpecialRect(dumbRect,0,ScrollArray[i]); *-DGL-*}		SpecialRect(dumbRect,0,ScrollArray[i MOD 13]);                newRect := dumbRect;{remove any old names}                newRect.h1 := newRect.h2 - 2;                newRect.h2 := newRect.h2 + 320;                EraseRect(newRect);                 newRect.h2 := newRect.h2 - 310; {draw the new ones!}                FrameRect(newRect);		newY := newRect.v1 + Real2Int((newRect.v2 - newRect.v1) / 2);                moveto(newRect.h2,newY);                lineto(newRect.h2 + 8,newY);                if (dumbrect.v2 - dumbrect.v1) > 8 then                  begin                    move(5,4); {move to the right and down a bit}                    drawstring(concat(partName,' (',			IntToString(Real2Int((partsize * 100) / tMegs)),'%)'));                  end;             end;          end;    with dumbRect do      if (tAllocated <= tMegs) then {draw empty space!}        begin          v2 := v1;          v1 := 10;          h2 := h2 + 320;          EraseRect(dumbRect);          inc(v2);          h2 := h2 - 320;          FrameRect(dumbRect);          h2 := h2 + 10;          FrameRect(dumbRect);          if (dumbrect.v2 - dumbrect.v1) > 8 then { draw the available space!!!}            begin	      newY := dumbRect.v1 + Real2Int((dumbRect.v2 - dumbRect.v1) / 2);              moveto(dumbRect.h2,newY);               lineto(dumbRect.h2 + 8,newY);              move(5,4); {move to the right and down a bit}              drawstring(concat('Available (',              	    IntToString(Real2Int(-((tAllocated - Tmegs) * 100) / tMegs)),'%)'));            end;        end;	SetPenSize(oldPenSize.h, oldPenSize.v);		{ restore pen size }  end;{################################################################}{#		set the current partitions size			#}{################################################################}procedure SetPartSize(number : integer);var  megs : integer;  fraction : str255;begin  if number < 1 then    number := 1;  GlobalParts^^.PartsInfo[CurrPart].partsize := number;  fraction := '.0';  if odd(number) then    begin      fraction := '.5';      dec(number);    end;  megs := number div 2;  TempStr1 := concat(IntToString(megs),fraction,' MB');  SetIText(PartDlog,5,@TempStr1);{  DrawAlloChart(false);		removed 3/4/91 by Monte	}  FrameRect(invRect); { redraw the scroll bar frame - kludge!!!!}     	    	      { this fizes a bug where the bottom of the}     	    	      { scroll bar would be trashed}end;{################################################################}{#		set the current partition			#}{################################################################}procedure SetActivePartition(thePart : integer);  var    tempRect : Rect;    temp : integer;    ctlhand : Handle;    ctlVal : longint;    tempName : str255;  begin    if (thePart <> CurrPart) or (thePart = -2) then { -2 = save current but don't set new}      begin        HLock(Handle(GlobalParts));        if CurrPart <> -1 then {we need to get the old partition name}          with GlobalParts^^.PartsInfo[CurrPart] do            begin              GetIText(partDlog,3,@tempName);              if tempName <> partname then                begin     	          partName := tempName;			{ our global structure}     	          listNameAry[currPart] := tempName;	{ the list structure}     	          DrawMember(@myList[currPart], @myListRec); {draw new name}     	          DrawAlloChart(true);			{ make sure graphic is totaly redrawn!}                  WITH tempRect DO		  BEGIN                    v1 := 10;	{ set enclosing rect of allo chart }		    h1 := 240;		    v2 := 150;		    h2 := 524;		  END;		  ValidRect(tempRect);	{ don't re-update allo chart }     	        end;            end;        HUnLock(Handle(GlobalParts));        if thePart <> -2 then { we can set a new one!}          begin	    ScrollColor := scrollArray[thePart MOD 13];            ScrollColor1 := ScrollColor;            with GlobalParts^^.partsinfo[thepart] do              begin                ctlVal := tMegs - partSize;                SetIText(PartDlog,3,@partname);              end;            SelIText(PartDlog,3,0,255);            InvalRect(invRect);		{ invalidate scroll bar }    (*        BeginUpdate(PartDlog);              EraseRect(PartDlog^.portRect);              DrawControls(PartDlog);            EndupDate(PartDlog);	removed by Monte 3/11/91    *)            SetCtlValue(ctlVal, SizeBar);     {	    FrameRect(invRect); }{ redraw the scroll bar frame - kludge!!!!}     	    			{ this fixes a bug where the bottom of the}     	    			{ scroll bar would be trashed}             CurrPart := thePart;	    SetPartSize(tMegs - ctlVal);          end        else          CurrPart := -1;      end;  end;  {################################################################}{#	scan to find the next good device, skip empty drives	#}{################################################################}procedure NextDrive;var  firstDevice : integer;  i : integer;  theCtl : ControlHandle;  thePt : Point;  myname : str255;  dummyResult : LONGINT;LABEL 8352;begin  SetPort(InitDlogPtr);  { prepare for icon drawing }  noDevices := false;  firstDevice := 0;  REPEAT  inc(deviceNum);  if D_Info(deviceNum,currDeviceStr) <> noError then {Loop back}  (*  if not atLeastOneDev then      begin        { there are no drives, so kill everything }	TurnOff(EraseButton);	TurnOff(PartButton);	TurnOff(InitButton);	TurnOff(ZeroButton);	TurnOff(InfoButton);        deviceNum := 0;        noDevices := true; {Prevent infinite loop if no drives available}        exit(nextDrive);      end  {if}  *)  {  else  }      begin        deviceNum := 1;   (*     atLeastOneDev := false; {Reset since we have looped back}	*)        toolErr := D_Info(deviceNum,currDeviceStr);	{ re-issue call }      end;  {else}  IF firstDevice = deviceNum THEN  { did we check same device twice? }  	BEGIN	noDevices := TRUE;        deviceNum := 0;	TurnOff(EraseButton);	TurnOff(PartButton);	TurnOff(InitButton);	TurnOff(ZeroButton);	TurnOff(InfoButton);	dispVolumeStr := noDevicesStr;	{ set current string to say no dev found }        SetLongText(@dispVolumeStr);	EraseRect(mainIconRect);	{ erase device icon }	thePt.v := 27;        thePt.h := 240;	PlotIconola(@unlockicon, thePt, true);	{ erase lock icon }	{GOTO 8352; }	EXIT(NextDrive);	END;  IF firstDevice = 0 THEN firstDevice := deviceNum;{ get info on current device	}  with infoblk do    begin      pCount := 11;        devNumber := deviceNum;      devname := @myname;      i := GSOSInfo;      tMegs := totalBlocks div 1024;      isRemovable := Bitand(characteristics, $4) <> 0;    end;{ now get status and decide whether we want this device }  with statusBlk do    begin      pCount := 5;        devNumber := deviceNum;      statCode := 0;      StatList := @StatResult;      RequestCount := 6;    end;  i := GSOSStatus;  currState := StatResult.general;8352:  UNTIL ((BITAND(infoblk.characteristics, $0080) <> 0)	{ check block device }  		AND (BITAND(currState, $0010) <> 0))	{ check online	}  	OR noDevices;	{ get online block device or no device }  { tell toolbox we have handled this device ourselves }    dummyResult := HandleDiskInsert(hdiUpdate, deviceNum);  { there is at least one (volume) device we can get info from}  TurnOn(InfoButton);  with infoblk do    if devID <> 5 then { not HD, so it can't be partitioned!}      TurnOff(PartButton)    else      if bitand(characteristics, $4000) <> 0 then { shit, its a generated device!}        begin          TurnOff(PartButton);	  MakeCursor(arrow);          DoAlert('You do not have the SCSI driver on your system disk...',                  'Therefore, you can not partition this device.');	  MakeCursor(watch);	  setlongtext(@''); {nil string}        end      else  (*      if (infoblk.headlink = 1) or (deviceNum = 1) then {it is on the boot drive}	  TurnOff(partButton) {cant re-partition the boot drive!}	else  *)		{ now allow partitioning of boot device -- Monte 8/19/91 }	  TurnOn(PartButton);    {---------- check for write protection ---------}    islockeddev := false; { assume the best}  with infoblk do    if bitand(characteristics, $40) = 0 then { write protected}      islockeddev := true    else if bitand(characteristics, $80) <> 0 then { block dev - see if write protected}      begin     (*   with statusBlk do          begin            pCount := 5;              devNumber := deviceNum;            statCode := 0;            StatList := @StatResult;            RequestCount := 6;	  end;      *)     {   i := GSOSStatus;		this is redundant -Monte 7/24/91 }     {   if bitand(StatResult.general,$4) <> 0 then	}     	IF BITAND(currState, $0004) <> 0 THEN islockedDev := true;      end;{ get volume info for this device }  initializedDev := true;	{ assume a volume is in this device }  toolErr := volume(currDeviceStr, currVolumeStr);  case toolErr of    IOError, OtherOS :      begin	dispVolumeStr := unInitStr;	{ set in case user clicks icon }   {     SetLongText(@unInitStr);	}        initializedDev := false;      end;    noError :      begin     {   dispVolumeStr := currVolumeStr;	}     {   delete(dispVolumeStr,1,1);   }                {Get rid of '/'}     {   dispVolumeStr := CONCAT('The disk name is ', dispVolumeStr);	}    {    SetLongText(@dispVolumeStr);	}        SetVolName(currVolumeStr);      end;  {noError}    otherwise { bad device, make it look like no disk in drive!}      begin        toolErr := noDiskInDrive;	initializedDev := false;	dispVolumeStr := unInitStr;	{ set in case user clicks icon }      end;  end; {case}  SetLongText(@dispVolumeStr);{  if not (toolErr in [noDevice,noDiskInDrive]) then	}    begin     { atLeastOneDev := true;	}      curVolIcon := GetVolIcon; {global infoblk holds parameters!}      with thePt do        begin    {      v := 48;	changed 3/91 by Monte}          v := 27;          h := 276;        end;      PlotIconola(curVolIcon,thePt,false);      	      with thePt do        begin    {      v := 48;	changed 3/91 by Monte}          v := 27;          h := 240;        end;      if islockeddev or {(devicenum = 1) or} (infoblk.devID = $1e) then {locked or AppleShare server }        begin	  if islockeddev then	    PlotIconola(@lockIcon, thePt, true) {only show this if its locked}	  else	    PlotIconola(@unlockicon, thePt, true);	  TurnOff(EraseButton);	{  TurnOff(partButton);		now allow for locked HD - Monte 8/12/91 }	  TurnOff(InitButton);	  TurnOff(ZeroButton);        end      else        begin          PlotIconola(@unlockicon, thePt, true);	  if initializedDev then	    begin	      TurnOn(EraseButton);	    end	  else	    begin	      TurnOff(EraseButton);	    end;	  TurnOn(InitButton);	  TurnOn(ZeroButton);	end;    end;end;{################################################################}{#	is this a valid size for the partition? too big?	#}{################################################################}procedure TestValid(var newValue : integer);  var    i : integer;    sum : integer;    dumbrect : rect;    theCtl : ControlHandle;  begin    HLock(Handle(GlobalParts));    with GlobalParts^^ do      begin        {first convert the new value into it's equivalent Mb value         and put it in the global record}        with PartsInfo[CurrPart] do	  begin	    partsize := (TMegs - newValue);	    if partsize < 0 then	      begin	        partsize := 1;		newvalue := newvalue - 1;              end;	  end;        {next find the total amount that this would make}        sum := SumPartSizes;        if sum > tMegs then {we went over the total amount avail on disk!}          begin            TurnOff(NewButton);    (*        DoAlert('Sorry... there is not enough room on the device.  The',            	    'partition will be set to the maximum possible size.');	removed 2/91 by Monte    *)            SysBeep;            { calculate the new amount that we can make this partition}            { we make the new amount fill the entire disk}            with PartsInfo[CurrPart] do              begin                partSize := partSize - (sum - tMegs);		newValue := (tMegs - partSize);              end;            setport(partDlog);            with dumbrect do              begin                h1 := 240;	        h2 := 640;	        v1 := 0;	        v2 := 200;	      end;            invalRect(dumbrect);            beginupdate(partDlog);              DrawDialog(partDlog);              DrawAlloChart(true); {we need to do a total redraw on this one!}            endupdate(partDlog);          end;      end;    HUnLock(Handle(GlobalParts));  end;{################################################################}{#	called by dlog mgr to do the scrolling size scroll bar	#}{################################################################}function ScrollAction(cmd : integer; Dlog : GrafPortPtr; itemID : integer) : integer;  var    temp : integer;    save : integer;    TempStr : str255;  begin    PHB;	{ added 3/91 by Monte }    phk; {make sure data bank is set correctly}    plb;    case cmd of      1 : { get initial view size}        temp := 1;      2 : { get initial total view size}        temp := tMegs;      3 : { get initial value}        temp := 0;      4 : { scroll line up}        begin          temp := GetDItemValue(Dlog,itemID) - 1;          if temp < 0 then             temp := 0;        end;      5 : { scroll line down}        begin          temp := GetDItemValue(Dlog,itemID) + 1;          if temp > tMegs then            temp := tMegs;        end;      6 : { scroll page up}        begin          temp := GetDItemValue(Dlog,itemID) - 4;          if temp < 0 then             temp := 0;        end;      7 : { scroll page down}        begin          temp := GetDItemValue(Dlog,itemID) + 4;          if temp > tMegs then            temp := tMegs;        end;      8 : { scroll thumb}        temp := GetDItemValue(Dlog,itemID);    end; { of case}    if cmd > 3 then {item changed !}      begin        { test to see if the new value is valid, if not,          inform user, and change it to a legal value}        if cmd in [4,6,8] then {DGL}          TestValid(temp);        SetPartSize(TMegs - temp);	DrawAlloChart(false);		{ added 3/4/91 by Monte	}      end;    ScrollAction := temp;    PLB;	{ caller's DBR }  end;{################################################################}{#	test to see if the name passed is already used		#}{################################################################}function NotDuplicate(theStr : str255) : boolean;  var    i : integer;  begin    NotDuplicate := true;    i := 0;    with globalparts^^ do      repeat        inc(i);        if Upperstring(PartsInfo[i].PartName) = theStr then          NotDuplicate := false;      until (i = (partcount - 1));  end;{################################################################}{#	make a new partition name, and make sure its unique	#}{################################################################}function MakeNewPartname : str255;  var    curStr : str255;    count : integer;  begin    count := 1;    repeat      curStr := concat('UNTITLED', IntToString(count));      inc(count);    until NotDuplicate(curStr);    MakeNewPartname := curStr;  end;{################################################################}{#	create partition dialog, & partition if neccessary	#}{################################################################}procedure Initialize; {this one initializes SCSI HardDisks (and partitions)}  VAR    itemHit,i,j : integer;    MBstring : string[12];    sum : integer;    temp : integer;    p : stringptr;    dumbrect : rect;    thePt : Point;    dupErr : Boolean;  label 1,2;  BEGIN    MakeCursor(watch);    { this pins the maximum number of partitions somewhere between 12 and 32}    MaxNumParts := ord(((ord4(tMegs * 1024) * 512) div 32000000) + 1);    if MaxNumParts > 32 then      MaxNumParts := 32    else if MaxNumParts < 8 then      MaxNumParts := 8;        itemHit := CallGetNumParts(deviceNum);    if itemHit > {12 *-DGL-*} 32 then { we can only handle 32 partitions!}      itemHit := {12 *-DGL-*} 32;    GlobalParts^^.PartCount := itemHit; { set the number we can handle!}    SetHandleSize((itemHit * sizeof(Part)) + 2, Handle(GlobalParts));    HLock(Handle(globalparts));    if GetParts(deviceNum,Pointer(GlobalParts^)) <> 0 then {error }      begin        SetLongtext(@ReadPartErrStr);        HUnlock(Handle(globalparts));        MakeCursor(arrow);        goto 1;      end;    HUnlock(Handle(globalparts));    oldPort := GetPort;    partDlog := GetNewModalDialog(@PartDITL);    SizeBar := GetControlItem(PartDlog,4);    NewButton := GetControlItem(PartDlog,6);    DeleteButton := GetControlItem(PartDlog,7);    if (GlobalParts^^.partCount >= {13 *-DGL-*} MaxNumParts) or    (SumPartSizes >= tMegs) then { disable new}      TurnOff(NewButton)    else      TurnOn(NewButton);        if GlobalParts^^.partCount = 1 then { disable delete}      TurnOff(DeleteButton)    else      TurnOn(DeleteButton);    SetPort(partDlog);    CurrPart := -1; {initialize our partition global}    SetActivePartition(1);    RebuildList(1);    SelectMember(@myList[1], @myListRec); {   DrawAlloChart(true);	this now happens @ update time -Monte 3/91 }2:  MakeCursor(arrow);    REPEAT { here we create the Partition dialog box - use a custom filter on it}    	   { because we have list controls which clash with the dialog manager  }      itemHit := ModalDialog(procPtr(Ord4(@myDlogFilter) + $C0000000));            if (SumPartSizes >= tMegs)      or (GlobalParts^^.partCount >= {13 *-DGL-*} MaxNumParts) then        TurnOff(NewButton)      else        TurnOn(NewButton);      if (itemHit = 100) or (itemHit = 6) or (itemHit = 7) then        begin          for selected := 1 to GlobalParts^^.partCount do            if myList[selected].memFlag <> 0 then              leave;          SetActivePartition(selected);        end;      if (itemHit = 6) then { it was the new partition button...}        begin	  temp := currPart;	  SetActivePartition(-2); {save old selection}	  currPart := temp;          if (GlobalParts^^.partCount = {12 *-DGL-*} MaxNumParts-1) then { disable new}            TurnOff(NewButton);          if (GlobalParts^^.partCount = 1) then { enable delete}            TurnOn(DeleteButton);          SetHandleSize(GetHandleSize(Handle(GlobalParts)) + SizeOf(part),	  	Handle(GlobalParts));	  HLock(Handle(GlobalParts));	  with GlobalParts^^ do            begin              inc(partCount);	      with partsinfo[partcount] do	        begin                  PartName := MakeNewPartName;                  partSize := 1;	        end;              RebuildList(GlobalParts^^.partCount);     	      currPart := -1;{reset the list correctly}              SetActivePartition(GlobalParts^^.partCount);     	      SelectMember(@myList[currPart], @myListRec); {select new name}              SetCtlParams(GlobalParts^^.partCount,5,listScroll1);    { 	      InvalRect(listRect1);			now done in RebuildList }    {          InvalRect(listScroll1^^.ctrlRect);				}     	      DrawAlloChart(true); {re-draw the chart}            end;	  	  HUnLock(Handle(GlobalParts));          if (SumPartSizes >= tMegs) then { disable new}            TurnOff(NewButton);         end      else if (itemHit = 7) then { it was the delete partition button...}        begin          TurnOn(NewButton);          if GlobalParts^^.partCount = 2 then { disable delete}            TurnOff(DeleteButton);          with GlobalParts^^ do            begin              dec(partcount);              for i := selected to partCount do {move the list down}                with partsinfo[i+1] do                  begin                    PartsInfo[i].PartSize := partSize;                    PartsInfo[i].PartName := partName;                  end;              RebuildList(1);	      SelectMember(@myList[1], @myListRec);              currpart := -1;              SetActivePartition(1);     	      SetCtlParams(GlobalParts^^.partCount,5,listScroll1);    { 	      InvalRect(listRect1);			now done in RebuildList }    {          InvalRect(listScroll1^^.ctrlRect);				}     	      DrawAlloChart(true); { redraw the chart}            end;        end;                UNTIL (itemHit = 2) or (itemHit = 9);        temp := currPart;    SetActivePartition(-2); {save the selection}    currPart := temp;    if itemHit <> 9 then {partition and initialize the Hard Disk}      p := @cancelPartStr    else      if BadPartNames(dupErr) then	begin	  if dupErr then	    DoAlert('Sorry, you cannot have duplicate partition names.',	          'Rename your partitions so that they are unique.')	  else	    DoAlert('Sorry, your partition names must have at least',	          'one character to be valid for your file system.');          with dumbrect do            begin              h1 := 240;	      h2 := 640;	      v1 := 0;	      v2 := 200;	    end;	  setport(partDlog);          invalRect(dumbrect);          beginupdate(partDlog);            DrawDialog(partDlog);            DrawAlloChart(true); {we need to do a total redraw on this one!}          endupdate(partDlog);	  goto 2;	end      else        begin	  HLock(Handle(globalParts));	  j := SetParts(deviceNum,Pointer(GlobalParts^));	{ do partitioning }	  IF j = $4321 THEN GOTO 2;	{ user canceled }          if j = $1234 then p := @PartErrStr	  else	    begin	      p := @SuccessPartStr;	      { parameters to getvolicon are passed in global infoblk}	      { infoblk was set during setparts call... This makes the}	      { current volume look correct when the "main" window is updated }	      CurVolIcon := GetVolIcon;	      isLockedDev := FALSE;	{ isn't locked any more }	    end;	  HUnLock(Handle(globalParts));       end;        SetLongText(p);  { remove the list, so dialog manager doesn't choke!}    DisposeControl(listControl1);    listControl1 := nil;    CloseDialog(partDlog);    partDlog := nil; { for safety sake}    SetPort(oldPort);1: { DrawLines;		removed by Monte b/c this happens @ update time }  END;{################################################################}{#	initialize a device, prompt user as neccessary		#}{################################################################}procedure InitializeVolume;var  nameDlogPtr : GrafPortPtr;  itemHit     : integer;  err : integer;  p : stringptr;  diskName    : STRING[34];  rtnVolName : PACKED ARRAY[0..36] OF CHAR;  theGPtr : GSResultPtr;begin  { do a format on the (floppy) drive}  MakeCursor(watch);        if toolerr <> noError then	{ error from volume call? }    diskName := ':UNTITLED'  else    diskName := {CONCAT(':', dispVolumeStr);} currVolumeStr;  MakeGSOSStr(currDeviceStr,s1);  theGPtr := GSResultPtr(@rtnVolName);	{ need xtra step b/c compiler sucks }  MakeGSOSStr(diskName, theGPtr^.gstring); { set default name for user to edit }  theGPtr^.bufSize := 36;			{ set buf size }  with formatBlk do    begin      pCount := 6;      devName := @s1;      volName := @theGPtr^.gstring;      FSNumOut := 0;      FSNumIn := 0;      flags := $C000;	{ editable name, selectable FST }      realVolName := @rtnVolName;    end;  err := GSOSFormat;(*  if err <> noError then    begin  {    p := @formatErrStr;	}       p := @'';       MakeCursor(arrow);       itemHit := AlertWindow($0020, NIL, @formatErrAlrt);	{ tell user }    end  else    begin      p := @cancelInitStr;      if formatBlk.FSNumOut <> 0 then        begin{	  diskName := GSToP(@theGPtr^.gstring);		}          p := @successStr;          TurnOn(EraseButton); { we can erase it now}   {       if (diskName[1] = '/') OR (diskName[1] = ':') then            delete(diskname,1,1);	}    {      dispVolumeStr := diskname;	}  	   SetVolName(GSToP(@theGPtr^.gstring));        end;     end;*)		{	*** removed 8/19/91 by Monte ***	}  CASE err OF    noError :      BEGIN      p := @cancelInitStr;	{ assume user cancelled }      IF formatBlk.FSNumOut <> 0 THEN	{ if user didn't cancel }        BEGIN        SetVolName(GSToP(@theGPtr^.gstring));        p := @successStr;        TurnOn(EraseButton); { we can erase it now}	END;      END;    $50 { open file on disk } : p := @initErrOpenStr;    OTHERWISE      BEGIN	{ some kind of hard error in formatting }        p := @'';        MakeCursor(arrow);        itemHit := AlertWindow($0020, NIL, @formatErrAlrt);	{ tell user }      END;  END; {case}  SetLongText(p);  MakeCursor(arrow); {   end;	}(*			removed 1/91 by Monte Benaresh  else    begin      CloseDialog(nameDlogPtr);      SetLongText(@cancelInitStr);    end;				*)  DrawLines;end;{################################################################}{#	erase a device, prompt user as neccessary		#}{################################################################}procedure DoErase;var  p : stringptr;  err : integer;  rtnVolName : PACKED ARRAY[0..36] OF CHAR;  theGPtr : GSResultPtr;begin  MakeCursor(watch);  MakeGSOSStr(currDeviceStr,s1);  theGPtr := GSResultPtr(@rtnVolName);	{ need xtra step b/c compiler sucks }  MakeGSOSStr(currVolumeStr, theGPtr^.gstring);  theGPtr^.bufSize := 36;			{ set buf size }  with formatBlk do    begin      pCount := 6;      devName := @s1;      volName := @theGPtr^.gstring;      FSNumOut := 0;      FSNumIn := 0;      flags := $C000;    { editable name, selectable FST }      realVolName := @rtnVolName;    end;  err := GSOSErase;  p := @cancelEraseStr;  if formatBlk.FSNumOut <> 0 then    p := @eraseSuccStr;(*  if err <> noError then    begin*)  CASE err OF    noError : SetVolName(GSToP(@theGPtr^.gstring));    $50 { open file on disk } : p := @eraseErrOpenStr;    OTHERWISE p := @eraseErrStr;  END; {case}  SetLongText(p);  MakeCursor(arrow);end;{################################################################}{#  snag tab keys & make'm look like a mouse in the vol button	#}{################################################################}function CatchTabs(theDlog : grafportptr;			var someEvent : wmTaskRec; var itemhit : integer) : integer;  var    i : integer;    tempCh : char;    myname : str255;  begin    PHB;	{ added 3/91 by Monte }    phk; {make sure data bank is set correctly}    plb;    CatchTabs := 0; {false}    { this routine is called periodically and every time there is an event}    { we need to deturmine if our disk has changed, if so we fake a volume}    { event so that the user cant do any actions on a ejected device.  We}    { keep the current devices state in currState - note : we only need to}    { check devices that have a removable media}          with someEvent do       if (wmWhat = 0) and ((tickcount - lastCheck) > 15) then { null event... do our scan}         begin           lastCheck := tickcount;           if isRemovable then             begin               {now do a status, and compare it to the last one we had}               with statusBlk do                 begin                   pCount := 5;                     devNumber := deviceNum;                   statCode := 0;                   StatList := @StatResult;                   RequestCount := 6;                 end;                                i := GSOSStatus;                      if bitand(StatResult.general,$10) <> bitand(currState,$10) then {its changed, go to next device}                 begin                   itemhit := 5; {volume}                   CatchTabs := 1; {True}		   BlinkButton(GetControlItem(theDlog,5));                 end;            end;        end      else        begin          tempCh := char(loword(bitand(wmMessage,$000000FF)));          if (wmWhat = 3) or (wmWhat = 5) then { keydown, autokey}            if tempCh = char($9) then { tab!}              begin                itemhit := 5; {volume}                CatchTabs := 1; {True}                if bitand(wmModifiers,$800) <> 0 then { option key and tab}                  begin                    dec(deviceNum);                    itemhit := 5; {volume}                    CatchTabs := 1; {True}                  end;		BlinkButton(GetControlItem(theDlog,5));              end            else if tempCh = char($1B) then {escape key}              begin                itemhit := 10; {cancel}                CatchTabs := 1; {True}		BlinkButton(GetControlItem(theDlog,10));              end;          end;    PLB;	{ caller's DBR }  end;{################################################################}{# set the info dialogs info to match the passed device num	#}{################################################################}procedure SetDialogInfo(theDlog : GrafPortPtr; dNum : Integer);  var    thePt : Point;    tempStrPtr : StringPtr;    temp : ptr;    i : integer;    junkStr : str255;  begin { set the appropriate info for the given device}    i := D_Info(dNum, aStr);    with infoBlk do      begin        pCount := 11;          devNumber := dNum;        devname := @junkStr;      end;    i := GSOSInfo;        SetIText(theDlog,12,@astr); {set the device name}        if volume(astr, globalstr1) <> noError then { there was an error- uninitialized?}      begin        SetIText(theDlog,8,@Uninitialized); {set the volume name}        SetIText(theDlog,11,ptr(unknownptr));        SetIText(theDlog,9,@'0 K');   {set used}        tempstr1 := concat(LongintToString(Real2Long(infoBlk.totalblocks DIV 2)),'K');        SetIText(theDlog,10,@tempstr1); { set avail}      end    else      begin        SetIText(theDlog,8,@globalStr1); {set the volume name}        if (file_system_id > $B) or (file_system_id < 1) then	  if infoblk.devid = $1e then	    file_system_id := $C	  else	    file_system_id := $D;        SetIText(theDlog,11,Ptr(FileSysStrTbl[file_system_id]));                  globalStr2 := concat(LongintToString(Real2Long((total_blks - free_blks +1) DIV 2)),'K');        SetIText(theDlog,9,@globalStr2);        tempstr1 := concat(LongintToString(Real2Long(free_blks DIV 2)),'K');        SetIText(theDlog,10,@tempstr1);      end;    isLockedDev := false; { assume the best}    if bitand(infoblk.characteristics, $40) = 0 then { write protected}      isLockedDev := true    else if bitand(infoblk.characteristics, $80) <> 0 then { block device - see if it's write protected}      begin        with statusBlk do          begin            pCount := 5;              devNumber := dNum;            statCode := 0;            StatList := @StatResult;            RequestCount := 6;	  end;	          i := GSOSStatus;        if bitand(StatResult.general,$4) <> 0 then          isLockedDev := true;      end; (*   with thePt do	removed b/c this happens at update time -Monte 3/91      begin   {     v := 35;        h := 48;	}        v := 6;        h := 2;      end;        temp := @unlockicon;    if islockeddev then      temp := @lockIcon;        PlotIconola(temp, thePt, true);	*)  end;{################################################################}{#	build a list that contains all partitions on a drive	#}{################################################################}function BuildDInfoList(dNum : integer; theDlog : GrafPortPtr) : integer;VAR  miscWord : integer;  devindex, devType : integer;  i : integer;  startindex : integer;  doneonce, partedFlag : boolean;  localStr : str255;  myName : str255;  pmapTstHdl : Handle;BEGIN  devIndex := dNum;  with infoblk do    begin      pCount := 11;        devNumber := devIndex;      devname := @myname;      devType := devID;    end;  {DINFO call}  i := GSOSInfo;    with infoBlk do    if headLink <> 0 then      begin { re - issue the call with the new head!!!}        devIndex := headLink;        pCount := 11;          devNumber := devIndex;        devname := @myname;        i := GSOSinfo;      end;  { check for partitions on this device }  partedFlag := FALSE;	{ assume not partitioned }  IF devType = $0005 THEN	{ SCSI hard disk?	}  	BEGIN		{ special test for SCSI HD with 1 partition }	  pmapTstHdl := NewHandle($200, MyMemoryID, attrFixed, nil);	  IF toolerrornum = 0 THEN	  BEGIN	    IntPtr(pmapTstHdl^)^ := $0000;	{ clear out signature bytes }	    WITH statusblk DO	      BEGIN		pCount := 5;  		devNumber := devIndex;		statCode := 4; {get partition map}		statlist := pmapTstHdl^;		requestcount := 512;	      END;	    IF (GSOSStatus = 0) AND (IntPtr(pmapTstHdl^)^ = $4D50) THEN	      partedFlag := TRUE;	    DisposeHandle(pmapTstHdl);	  END;	END;  doneonce := false; {dont look at next link until after we've gone through once}  { devIndex now points to the first device in the list}  { fill the infolist and set devCount to the correct number}    miscword := 0; {init counter}  repeat    if doneonce then      begin        devIndex := infoblk.forwardlink;	with infoblk do	  begin	    pCount := 11;  	    devNumber := devIndex;	    devname := @myname;	  end;	  	i := GSOSInfo;      end;          with statusBlk do      begin        pCount := 5;          devNumber := devIndex;        statCode := 0;        StatList := @StatResult;        RequestCount := 6;      end;          i := GSOSStatus;           if (bitand(StatResult.general,$0010) <> 0) then {if its online, or a cd proceed}      begin        inc(miscword);        with infoList[miscWord], myList[miscword] do          begin            if D_Info(devIndex,myname) <> noError then              devName := 'Bad Device'            else              if volume(myName, localStr) <> noError then                devName := myName              else                devName := localStr;            devNum := devIndex;            memPtr := @devName;            memFlag := 0;          end;        if devindex = dNum then          startindex := miscword;      end    else { we hit an offline partition, that means we are at the end!!!!}      if (infoblk.devID <> 7) then {if not CDROM, a we're at the end so BYE!}	infoblk.forwardlink := 0; { so we will exit - we need this!}    doneonce := true; {so we know we need to look at the next link}        until (infoblk.forwardlink = 0) or (miscword = 32);  { if we found linked devices, count this device as	}  {  partitioned whether it's a SCSI HD or not		}  IF miscword > 1 THEN partedFlag := TRUE;  {kludge beause testing wanted it this way}{  if miscword <= 1 then			changed 3/5/91 by Monte Benaresh }  IF NOT partedFlag THEN    begin      miscword := 1;      startindex := 1;      InfoList[1].devName := 'No partitions on this disk.';      InfoList[1].devNum := devIndex;      myList[1].memPtr := @InfoList[1].devName;      myList[1].memFlag := 0;    end;    BuildDInfoList := miscword; {return count}    with myListRec, listRec do {set up the list record}    begin      v1 := 65;      h1 := 125;      v2 := 106;      h2 := 375;      listsize := miscword; {number of items}      listview := 4;      listtype := 2;      liststart := startindex;      listctl := nil;      listdraw := nil;      listmemheight := 10;      listmemsize := sizeof(listmemrec);      listpointer := @myList;      listrefcon := 0;      listscrollclr := nil;    end;  ListRect1 := myListRec.listRec;  listControl1 := CreateList(theDlog,@myListRec);  listScroll1 := listControl1^^.CtlListBar;  SelectMember(@myList[startindex], @myListRec);  SaveAndZeroRefCons;END;{################################################################}{#	entry point for displaying a device's "info"		#}{################################################################}procedure DoDeviceInfo(dNum : Integer);  var    InfoDlog : GrafPortPtr;    itemHit : integer;    numberofParts : integer; {   iconPtr : Ptr;		moved to globals for update routine by Monte 3/91 }    i : integer;    thept : Point;    myName : str255;  begin { display a dialog with device (volume) information }    MakeCursor(watch);    {----- first create the dialog -----}    oldPort := GetPort;    InfoDlog := GetNewModalDialog(@InfoDITL);    SetPort(InfoDlog);    {----- set the general device info ----}    with infoBlk do      begin        pCount := 11;          devNumber := dNum;        devname := @myname;      end;          i := GSOSInfo;    iconptr := GetVolIcon; {parameters are passed in global infoblk} (*   with thePt do	this will all get done at update time! -Monte      begin        v := 6;   {     h := 29;	}        h := 34;      end;    PlotIconola(iconPtr,thePt,false);	*)        {----- add the list of partitions if any -----}    numberofParts := BuildDInfoList(dNum, InfoDlog);    {----- set the info for the current device -----}    SetDialogInfo(infoDlog, dNum);        {----- get & handle events, if a new partition is selected, display it ----}    MakeCursor(arrow);    repeat { here we create the Partition dialog box - use a custom filter on it}    	   { because we have list controls which clash with the dialog manager  }      itemHit := ModalDialog(procPtr(Ord4(@myDlogFilter) + $80000000));      if (itemHit = 100) and (numberofparts > 1) then        begin          for selected := 1 to numberofparts do            if myList[selected].memFlag <> 0 then              leave;          SetDialogInfo(infoDlog, infolist[selected].devNum);         end;    until (itemHit = 1);          DisposeControl(listControl1); {remove the list, so dialog manager doesn't choke!}    listControl1 := nil; {so we dont die when trying to partition a device}    CloseDialog(InfoDlog);    SetPort(oldPort);  { now re-scan this device to activate appropriate buttons in Main window }    deviceNum := dNum - 1;    NextDrive;			{ re-scan } {   DrawLines;		removed 3/91 by Monte b/c update takes care of this }  end;FUNCTION PartitionOK(partDev : INTEGER): BOOLEAN;	{ check whether it's OK to partition given device }  VAR  devIndex, itemClicked, headDev : INTEGER;  devUnlocked, fileOpen : BOOLEAN;  alertPtr : Ptr;  BEGIN  { first get head device }    WITH infoBlk DO      BEGIN      pCount := 11;      devNumber := partDev;      devname := NIL;      END;    toolErr := GSOSInfo;    headDev := infoBlk.headlink;    IF headDev = 0 THEN headDev := partDev;	{ if link was 0, we had head device }  { check for open files on all volumes }    fileOpen := FALSE;		{ assume no open files }    devIndex := headDev;	{ start at top }    REPEAT { scan this device forward }      fileOpen := CheckOpenFiles(devIndex);	{ make VOLUME call }    { set up D_INFO call}      WITH infoBlk DO        BEGIN        devNumber := devIndex;	END;      toolErr := GSOSInfo;      devIndex := infoBlk.forwardlink;	{ link to next device }    UNTIL (devIndex = 0) OR fileOpen;    IF fileOpen THEN      BEGIN			{ tell user he can't partition }      itemClicked := AlertWindow($0020, NIL, @partOpenAlrt);      PartitionOK := FALSE;      EXIT(PartitionOK);      END;  { get here only if no open files on any volume }    devUnlocked := TRUE;		{ assume no locked partitions }    devIndex := headDev;	{ start at top }    REPEAT { scan this device forward }    { set up D_INFO call}      WITH infoBlk DO        BEGIN        devNumber := devIndex;	END;      toolErr := GSOSInfo;      IF BITAND(infoBlk.characteristics, $0040) = 0	{ locked partition? }      THEN devUnlocked := FALSE;		{ some locked partitions }      devIndex := infoBlk.forwardlink;	{ link to next device }    UNTIL (devIndex = 0) OR NOT devUnlocked;  { now we have scanned through all partitions on this device }  { choose alert box accordingly }    IF devUnlocked { is it OK so far } THEN alertPtr := @partAlrt      ELSE alertPtr := @partLockAlrt;  { now warn user	}    itemClicked := AlertWindow($0020, NIL, alertPtr);	{ warn user }    IF itemClicked <> 1 THEN PartitionOK := FALSE	{ user declined }      ELSE PartitionOK := TRUE;  END;{################################################################}{#	take care of actions in the main dialog			#}{################################################################}procedure ProcessInit;var  itemHit : Integer;  nameDlogPtr : GrafPortPtr;  itemClicked : integer;begin { repeat		removed 3/91 by Monte b/c main Dlog now real modeless window! } {  itemHit := ModalDialog(procPtr(Ord4(@CatchTabs) + $80000000));   removed by Monte }    itemHit := event.wmTaskData4;	{ ID of ctl that took event }    case itemHit of      2  : begin { erase}             if toolerr <> noError then	{ error from volume call? }               begin                 currVolumeStr := '/DISK';                 Defname := @':UNTITLED';               end;	         DoErase;           end;      5  : begin {volume}             MakeCursor(watch);          (*   repeat	*)               NextDrive; {Skip over nonexistent Disk II device and empty 3.5 drives}          (*   until noDevices or (not (toolErr in [noDevice,noDiskInDrive]));	*)             MakeCursor(arrow);           end;      9  : begin {partition button}         (*    with WarningItem3 do { set the error text}	       begin		 ItemDescr := @warning4Str[1];		 ItemValue := length(warning4Str);	       end;	     itemClicked := CautionAlert(@WarningAlert,nil);	     if itemClicked = 2 then	 *)	{ removed 8/9/91 to allow check and warning for locked partitions }	     IF PartitionOK(deviceNum) THEN	{ check with user first }	       Initialize	{really partition}             else	       BEGIN	       SetLongText(@cancelPartStr);	       END;	   end;      10 : Done := TRUE; { quit application }      11 : InitializeVolume; { initialize button}      12 : begin {zero}         (*					changed 6/17/91 by Monte	     with WarningItem3 do { set the error text}	       begin		 ItemDescr := @warning3Str[1];		 ItemValue := length(warning3Str);	       end;	     itemClicked := CautionAlert(@WarningAlert,nil);	 *)	    IF CheckOpenFiles(deviceNum) THEN SetLongText(@zeroErrOpenStr)	    ELSE	     BEGIN	     itemClicked := AlertWindow($0020, NIL, @zeroAlrt);	{ warn user }	     if itemClicked = 1 then	       begin	         MakeCursor(watch);	       { force update of main dlog }	         BeginUpdate(InitDlogPtr);		 MainWindUpdt;			{ redraw window }		 EndUpdate(InitDlogPtr);	         DoDeviceZero(deviceNum, false);		 dispVolumeStr := unInitStr;	{ set in case user clicks icon }	         MakeCursor(arrow);	       end             else	       SetLongText(@cancelZeroStr);	    END;           end;      13 : DoDeviceInfo(deviceNum); {info}    end;  {case}    if (itemHit <> 10) and noDevices then      begin     {   SetIText(InitDlogPtr,7,@blankStr);	}        SetLongText(@noDevicesStr);      end;{  until itemHit = 10;	removed 3/91 by Monte b/c Dlog now real modeless window! }end; {################################################################}{#	create the main dialog, find first drive, & loop	#}{################################################################}function GetInitCtlItem(item : integer) : ControlHandle;  begin{    GetInitCtlItem := GetControlItem(InitDlogPtr,item);	changed 3/91 by Monte }    GetInitCtlItem := GetCtlHandleFromID(InitDlogPtr,item);  end;PROCEDURE MainWindUpdt;	{ called only for main window }  BEGIN    DrawControls(InitDlogPtr);    DrawLines;	{ this draws decorative lines and current disk icons	}  END;procedure ShowInit;begin  deviceNum := 0; { atLeastOneDev := false;	}  noDevices := false;  islockeddev := false;{  curVolIcon := @NoName;	changed 3/91 by Monte to eliminate NoName icon }  curVolIcon := NIL;	{ PlotIconola now checks this }  currDeviceStr := ' '; {initialize it!}  subStrArray[0] := @currDeviceStr;  lastCheck := tickcount;{  InitDlogPtr := GetNewModalDialog(@InitDlog);		changed 3/91 by Monte }  InitDlogPtr := NewWindow2(NIL, 0, @MainWindUpdt, NIL, 2,  			mainDlog, rWindParam1);  { put up main window }  EraseButton := GetInitCtlItem(2);  PartButton := GetInitCtlItem(9);  InitButton := GetInitCtlItem(11);  ZeroButton := GetInitCtlItem(12);  InfoButton := GetInitCtlItem(13);  CancelButton := GetInitCtlItem(10);{  SetPort(InitDlogPtr);	this is done in DrawLines -Monte 3/91 }  DrawLines;  makecursor(watch);  { get 1st device } (*   repeat	*)      NextDrive; (*   until (not (toolErr in [noDevice,noDiskInDrive])) or noDevices; *)       {Find first device on line, skipping over nonexistent	Disk II device and empty 3.5 drives}    if noDevices then      SetLongText(@noDevicesStr);  MakeCursor(Arrow);{  ProcessInit;		removed by Monte }end;{################################################################}{#	a little razzle-dazzle in an about box			#}{################################################################}procedure DoAboutItem;var  aboutDlog  : GrafPortPtr;  itemHit    : integer;{  thePt : Point;  one : integer;  two : integer;  three : integer;  four : integer;	}  myWmTaskRec : WmTaskRec;begin   { display the about box, wait for user to click ok, then close it!}   aboutDlog := GetNewModalDialog(@AboutDITL); {  DrawDialog(aboutDlog);	}   oldPort := GetPort;   SetPort(aboutDlog); {  one := 0;   two := 1;   three := 2;   four := 3;		removed 3/91 by Monte	}   REPEAT  (*   thePt.h := 9;     thePt.v := 5;  {   pauseit;		removed 1/91 by Monte	}     PlotIconola(@FakeArray[one], thePt, false);     thePt.h := 319;     PlotIconola(@FakeArray[two], thePt, false);     thePt.v := 73;     PlotIconola(@FakeArray[three], thePt, false);     thePt.h := 9;     PlotIconola(@FakeArray[four], thePt, false);     inc(one);     inc(two);     inc(three);     inc(four);     if one = 4 then       one := 0     else if two = 4 then       two := 0     else if three = 4 then       three := 0     else if four = 4 then       four := 0;		removed 3/91 by Monte	*)     itemHit := ModalDialog(procPtr(Ord4(@myDlogFilter) + $C0000000)); (*  until eventavail(10,myWmTaskRec) {mouse down or keypressed};	*)   UNTIL ItemHit = 1;   CloseDialog(aboutDlog);   SetPort(oldPort);end;end.