##############;#		Disk Name Dialog Template			#;################################################################		EXPORT	DiskNameDlogDiskNameDlog	DC.W	30,165,95,475	; rect	DC.W	$FF		; visible	DC.L	$1003		; ref con	DC.L	DiskItem1	; Item 1	DC.L	DiskItem2	; Item 1	DC.L	DiskItem3	; Item 1	DC.L	DiskItem4	; Item 1	DC.L	0		; nil terminatorDiskItem1	DC.W	1		; item 1	DC.W	45,130,59,225	; rect	DC.W	10		; button item constant	DC.L	WarningOK	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorDiskItem2	DC.W	2		; item 2	DC.W	45,25,59,120	; rect	DC.W	10		; button item constant	DC.L	WarningCancel	; re-use Cancel above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorDiskItem3	DC.W	3		; item 3	DC.W	23,10,37,290	; rect	DC.W	17		; edit line constant		EXPORT	DefNameDefName	DC.L	0	DC.W	15		; item value - only allow 15 chars	DC.W	0		; item flag	DC.L	0		; item colorNilStr	DC.B	0		; nil string!DiskItem4	DC.W	4		; item 4	DC.W	5,10,20,275	; rect	DC.W	15		; stat text item constant	DC.L	GetName		; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorGetName	str	'Please name this disk.';################################################################;#			About Dialog Template			#;################################################################		EXPORT	AboutDITLAboutDITL	DC.W	35,126,165,515	; rect	DC.W	$FFFF		; visible	DC.L	$1005		; ref con	DC.L	AboutItem1	; Item 1	DC.L	AboutItem2	; Item 2	DC.L	0		; nil terminatorAboutItem1	DC.W	2		; item 1	DC.W	10,18,100,370	; rect	DC.W	22+$8000	; long static text + item disable item constant	DC.L	AppleIIGS	; IIGS str	DC.W	EndAppleIIGS-AppleIIGS		; item value	DC.W	0		; item flag	DC.L	0		; item colorAboutItem2	DC.W	1		; item 1	DC.W	106,147,120,241	; rect	DC.W	10		; button item constant	DC.L	WarningOK	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorAppleIIGS	DC.B	1	DC.B	'J'	DC.B	1	DC.B	' Advanced Disk Utility ',13	DC.B	'Version '	Version			;insert version text	dc.b	13,13	DC.B	'By Darryl Lovato',13,13	dc.b	'Updated by Monte Benaresh',13,13	DC.B	'Copyright (c) 1988-1992 Apple Computer, Inc.',13	DC.B	'All rights reserved.',13EndAppleIIGS		EXPORT hardFmtAlrthardFmtAlrt			;AlertWindow string to ask user whether he wants				;to hard-format a device	dc.b '8'		;size of window	dc.b '3'		;note icon	dc.b '/'		;separator	dc.b 'Do you wish to hard-format this disk?  '	dc.b $0D, $0D	dc.b 'Hard formatting assures optimal performance and reliability '	dc.b 'of your hard disk, but may take up to 20 minutes.'	dc.b '/'	dc.b '#1'		;standard "Cancel" button	dc.b '/'	dc.b '^'		;default button next	dc.b '#3'		;standard "No" button	dc.b '/'	dc.b '#2'		;standard "Yes" button	dc.b 0		EXPORT macConnectAlrtmacConnectAlrt			;AlertWindow string to ask user whether he ever				;wants to connect hard disk to a Mac	dc.b '8'		;size of window	dc.b '3'		;note icon	dc.b '/'		;separator	dc.b 'Do you plan to connect this disk to a Macintosh computer?  '	dc.b $0D, $0D	dc.b 'Special formatting is required for Macintosh compatibility '	dc.b 'and takes up about 128K on your hard disk.'	dc.b '/'	dc.b '#3'		;standard "No" button	dc.b '/'	dc.b '^'		;default button next	dc.b '#2'		;standard "Yes" button	dc.b 0		EXPORT zeroAlrtzeroAlrt			;AlertWindow string to comfirm Zero of a disk	dc.b '4'		;size of window	dc.b '4'		;caution icon	dc.b '/'		;separator	dc.b 'Zeroing will destroy all of the data on this disk '	dc.b 'and may take a VERY LONG time.  Do you want to '	dc.b 'zero this disk?'	dc.b '/'	dc.b '^'		;default button next	dc.b '#3'		;standard "No" button	dc.b '/'	dc.b 'Zero'	dc.b 0		EXPORT partAlrtpartAlrt			;AlertWindow string to comfirm Partition of a disk	dc.b '4'		;size of window	dc.b '4'		;caution icon	dc.b '/'		;separator	dc.b 'Partitioning will destroy all data on this device.  '	dc.b 'Do you really want to partition this device?'	dc.b '/'	dc.b '^'		;default button next	dc.b '#1'		;standard "Cancel" button	dc.b '/'	dc.b '#0'		;standard "OK" button	dc.b 0		EXPORT partLockAlrtpartLockAlrt			;AlertWindow string to comfirm Partition of a disk				;when a locked partition resides on the device	dc.b '4'		;size of window	dc.b '4'		;caution icon	dc.b '/'		;separator	dc.b 'Partitioning will destroy all data on this device, '	dc.b 'including data on one or more locked partitions.  '	dc.b 'Do you really want to partition this device?'	dc.b '/'	dc.b '^'		;default button next	dc.b '#1'		;standard "Cancel" button	dc.b '/'	dc.b '#0'		;standard "OK" button	dc.b 0		EXPORT partOpenAlrtpartOpenAlrt			;AlertWindow string to tell user that a				;partition volume has open files	dc.b '4'		;size of window	dc.b '2'		;stop icon	dc.b '/'		;separator	dc.b 'This device cannot be partitioned because it '	dc.b 'contains one or more volumes with open files.'	dc.b '/'	dc.b '^'		;default button next	dc.b '#0'		;standard "OK" button	dc.b 0		EXPORT formatErrAlrtformatErrAlrt			;AlertWindow string to tell user a format				;error occurred	dc.b '3'		;size of window	dc.b '2'		;stop icon	dc.b '/'		;separator	dc.b 'Sorry, disk initialization failed.'	dc.b '/'	dc.b '^'		;default button next	dc.b '#0'		;standard "OK" button	dc.b 0;################################################################;#			Misc Strings				#;################################################################		EXPORT	okStrokStr	str	'OK'		EXPORT	warningStrwarningStr	str	'Initializing will erase all of the data on this disk.  Do you want to intitialize this disk?'		EXPORT	warning2Strwarning2Str	str	'Erasing will remove all of the data on this disk.  Do you want to erase this disk?'		;EXPORT	warning3Str;warning3Str	;str	'Zeroing will destroy all of the data on this disk and may take a VERY LONG time.  Do you want to zero this disk?'		;EXPORT	warning4Str;warning4Str	;str	'Partitioning will destroy all data on this device.  Do you really want to partition this device?'		EXPORT	volNameStrvolNameStr	str	'The disk name is ^0                                ' ; we need the spaces!		EXPORT	successStrsuccessStr	str	'Disk initialization successfully completed.'		EXPORT	cancelInitStrcancelInitStr	str	'Disk initialization was canceled.'		EXPORT	ReadPartErrStrReadPartErrStr	str	'Partitioning operation failed.  The SCSI Hard Disk could not be read.'		EXPORT	AtLeastOneCanceledAtLeastOneCanceled	str	'Warning! Initialization of one or more disks was canceled.'		EXPORT	blankStrblankStr	str	'  '		EXPORT	unInitStrunInitStr	str	'Uninitialized or no disk in drive'		;EXPORT	formatErrStr;formatErrStr	;str	'The disk could not be initialized.'		EXPORT	PartErrStrPartErrStr	str	'The device could not be partitioned.'		EXPORT	successpartStrsuccesspartStr	str	'Partition operation completed. '		EXPORT	eraseErrStreraseErrStr	str	'The disk could not be erased.'		EXPORT	eraseErrOpenStreraseErrOpenStr	str	'That disk can''t be erased because it contains open files.'		EXPORT	initErrOpenStrinitErrOpenStr	str	'That disk can''t be initialized because it contains open files.'		EXPORT	zeroErrOpenStrzeroErrOpenStr	str	'That disk can''t be zeroed because it contains open files.'		EXPORT	zeroingVolFailzeroingVolFail	str	'An error occurred while zeroing.'		EXPORT	startzerovolStrstartzerovolStr	str	'Setting up buffers for zero operation.'		EXPORT	eraseSuccStreraseSuccStr	str	'Erase operation successfully completed.'		EXPORT	noDevicesStrnoDevicesStr    	str	'No disks on line.'		EXPORT	cancelPartStrcancelPartStr	str	'Partition operation canceled. '		EXPORT	cancelEraseStrcancelEraseStr	str	'Erase operation canceled.'		EXPORT	cancelZeroStrcancelZeroStr	str	'Zero operation canceled.'		EXPORT	zeroingvolStrzeroingvolStr	str	'Zeroing disk... This could take a while.'		EXPORT	zeroingvolSuccesszeroingvolSuccess	str	'Zero operation successfully completed.'		EXPORT	uninitializeduninitialized	str	'Uninitialized';################################################################;#			Floppy Disk Icon Data			#;################################################################		EXPORT	FakeArrayFakeArray		EXPORT	FloppyFloppy		;			DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$FF	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$FF	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$0F,$FF,$F0,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$FF,$FF,$FF,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$FF,$FF,$FF,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$0F,$FF,$F0,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$FF,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$0F,$FF,$F0,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$0F,$FF,$F0,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$0F,$FF,$F0,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$0F,$FF,$F0,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$FF,$00,$00,$00,$00,$00,$00,$00	DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00;################################################################;#			Ram/Rom Disk Icon Data			#;################################################################		EXPORT	RamDiskRamDisk	DC.B	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$F