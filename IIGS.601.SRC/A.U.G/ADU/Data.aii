;################################################################;#								#;#  File:	Data.Asm from IIGS Disk Initializer		#;#								#;#--------------------------------------------------------------#;#								#;#  Description:  This file has all the global data used by	#;#		  the IIGS disk initializer			#;#								#;#--------------------------------------------------------------#;#								#;#  Author:	Darryl Lovato					#;#								#;#--------------------------------------------------------------#;#								#;#  Copyright:	1987,1988 by Apple Computer Inc.		#;#		All rights reserved.				#;#								#;#--------------------------------------------------------------#;#								#;#  Modification History:					#;#								#;#	Who	When	The Change				#;#	---	------	-------------------------------------	#;#	SR	12/7/87	Created v.1 - erase & init only		#;#	DGL	1/29/88 Rewrote everything - cut size in half!  #;#	DGL	5/9/88	Finished Adding Partition Support	#;#			and other features... far too many to	#;#			list here...				#;#	DGL	6/1/88  Alpha!					#;#	DGL	6/13/88 Alpha 2					#;#	DGL	6/24/88 Alpha 3					#;#	DGL	7/1/88  Beta 1					#;#	DGL	7/13/88 Beta 2					#;#	DGL	7/20/88	Beta 3					#;#	DGL	7/27/88	Beta 4					#;#	DGL	8/1/88	Beta 5					#;#	DGL	8/8/88	Beta 6					#;#	DGL	8/15/88 Final!					#;#								#;################################################################		STRING	ASIS		;BLANKS	OFF		BLANKS	ON		MACHINE	M65816		LONGA	on		LONGI	on;################################################################;#   			Imported addresses			#;################################################################	IMPORT	AboutItem2,AboutItem3,AboutItem5,AboutItem6	IMPORT	AboutItem7,AboutItem8,AboutItem9,DOS,DiskItem1	IMPORT	DiskItem2,DiskItem3,InfoAvail,InfoDevName	IMPORT	InfoFileSys,InfoItem1,InfoItem10,InfoItem11	IMPORT	InfoItem12,InfoItem2,InfoItem3,InfoItem4	IMPORT	InfoItem5,InfoItem6,InfoItem7,InfoItem8	IMPORT	InfoItem9,InfoParts,InfoUsed,InfoVolume	IMPORT	InitItem10,InitItem11,InitItem2,Item3Str	IMPORT	L,PartDel,PartInit,PartItem2,PartItem3,PartItem4	IMPORT	PartItem6,PartItem7,PartItem8,PartItem9,PartNew	IMPORT	ScrollAction,ScrollCTbl,WarningCancel,WarningItem1	IMPORT	WarningItem2,WarningOK,emptystr,miscstr,miscstr1		EXPORT	Data	Data	PROC;################################################################;#			string macro				#;################################################################ 	MACRO	str	&string		lclc	&sset&sset	SETC &SETTING('STRING')		STRING PASCAL		dc.B &string		STRING &sset	MEND;################################################################;#			version macro				#;################################################################ 	MACRO&lab	Version	lclc	&sset&sset	SETC &SETTING('STRING')	STRING ASIS&lab	DC.B	'1.2'	;maintain version string here and in "adu.rii"	STRING &sset	MEND;################################################################;#		Table for getting the File System ID String	#;################################################################		EXPORT	FileSysStrTblFileSysStrTbl		DC.L	FS1	DC.L	FS2	DC.L	FS3	DC.L	FS4	DC.L	FS5	DC.L	FS6	DC.L	FS7	DC.L	FS8	DC.L	FS9	DC.L	FSA	DC.L	FSB	DC.L	FSC		EXPORT	unknownptrunknownptr	DC.L	unknown	FS1	str	'ProDOS'FS2	str	'DOS 3.3'FS3	str	'DOS 3.1, 3.2'FS4	str	'Apple II Pascal'FS5	str	'Macintosh MFS'FS6	str	'HFS'FS7	str	'LISA'FS8	str	'Apple CP/M'FS9	str	'Character FST'FSA	str	'MS/DOS'FSB	str	'High Sierra'FSC	str	'Apple File Server'unknown	str	'Unknown File System'		EXPORT drvrProcessordrvrProcessor	;	Table of pointer to processor ID strings for		;	drver partition entries in partition map		dc.l drvrStr1		dc.l drvrStr2		dc.l drvrStr3		dc.l drvrStr4		STRING PASCALdrvrStr1	dc.b '68000'drvrStr2	dc.b '68XXX'drvrStr3	dc.b '68XXX'drvrStr4	dc.b '65XXX'		STRING ASIS		EXPORT OpenPBlkOpenPBlk	; Param block to open files		dc.w $000C	;pcount through eof		ds.w 1		;ref num		ds.l 1		;path pointer		dc.w $0001	;req access = read-only		dc.w $0000	;res num = data fork		ds.w 1		;return access		ds.w 1		;returned filetype		ds.l 1		;returned auxtype		ds.w 1		;returned storage type		ds.b 8		;create time/date		ds.b 8		;mod time/date		dc.l $00000000	;option list ptr		ds.l 1		;eof		EXPORT drvrPathdrvrPath	;expected path of generic boot driver file		dc.w @end-@start@start		dc.b '*:SYSTEM:DRIVERS:GenericMacSCSI'@end		EXPORT ReadPBlkReadPBlk	; Param block to read from file		dc.w $0004	;pcount through transfer count		ds.w 1		;ref num		ds.l 1		;data buffer		ds.l 1		;req count		ds.l 1		;transfer count		EXPORT ClosePBlkClosePBlk	; Param block to close file		dc.w $0001	;pcount		ds.w 1		;ref num;################################################################;#			INFO Dialog Template			#;################################################################		EXPORT	InfoDITLInfoDITL	DC.W	30,110,142,530	; rect	DC.W	$FF		; visible	DC.L	$1002		; ref con	DC.L	InfoItem1	; ptr to the first item	DC.L	InfoItem2	; ptr to the 2nd item	DC.L	InfoItem3	; ptr to the 3rd item	DC.L	InfoItem4	; ptr to the 4th item	DC.L	InfoItem5	; ptr to the 5th item	DC.L	InfoItem6	; ptr to the 6th item	DC.L	InfoItem7	; ptr to the 7th item	DC.L	InfoItem8	; ptr to the 8th item	DC.L	InfoItem9	; ptr to the 9th item	DC.L	InfoItem10	; ptr to the 10th item	DC.L	InfoItem11	; ptr to the 11th item	DC.L	InfoItem12	; ptr to the 12th item	DC.L	0		; terminatorInfoItem1	DC.W	1		; item 1	DC.W	90,20,104,100	; rect	DC.W	10		; button item constant	DC.L	WarningOK	; address of our first global str	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoItem2	DC.W	2		; item 2	DC.W	5,125,15,220	; rect	DC.W	15		; stat text item constant	DC.L	InfoVolume	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoVolume	str	'Disk:'InfoItem3	DC.W	3		; item 3	DC.W	15,125,25,220	; rect	DC.W	15		; stat text item constant	DC.L	InfoUsed	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoUsed	str	'Used:'InfoItem4	DC.W	4		; item 4	DC.W	25,125,35,220	; rect	DC.W	15		; stat text item constant	DC.L	InfoAvail	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoAvail	str	'Available:'InfoItem5	DC.W	5		; item 5	DC.W	35,125,45,220	; rect	DC.W	15		; stat text item constant	DC.L	InfoFileSys	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoFileSys	str	'File system:'InfoItem6	DC.W	6		; item 6	DC.W	45,125,55,220	; rect	DC.W	15		; stat text item constant	DC.L	InfoDevName	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoDevName	str	'Device name:'InfoItem7	DC.W	7		; item 7	DC.W	55,125,65,220	; rect	DC.W	15		; stat text item constant	DC.L	InfoParts	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoParts	str	'Partitions:';	these items get calculatedInfoItem8	DC.W	8		; item 8	DC.W	5,220,15,620	; rect	DC.W	15		; stat text item constant	DC.L	emptystr	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item coloremptystr	str	''InfoItem9	DC.W	9		; item 9	DC.W	15,220,25,620	; rect	DC.W	15		; stat text item constant	DC.L	emptystr	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoItem10	DC.W	10		; item 10	DC.W	25,220,35,620	; rect	DC.W	15		; stat text item constant	DC.L	emptystr	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoItem11	DC.W	11		; item 11	DC.W	35,220,45,620	; rect	DC.W	15		; stat text item constant	DC.L	emptystr	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorInfoItem12	DC.W	12		; item 12	DC.W	45,220,55,620	; rect	DC.W	15		; stat text item constant	DC.L	emptystr	; re-use OK above	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		;