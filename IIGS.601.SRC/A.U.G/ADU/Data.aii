tDITL	DC.W	28,56,186,584	; rect	DC.W	$FF		; visible	DC.L	$1006		; ref con	DC.L	PartItem2	; Item 2	DC.L	PartItem3	; Item 3	DC.L	PartItem4	; Item 4	DC.L	PartItem5	; Item 5	DC.L	PartItem6	; Item 6	DC.L	PartItem7	; Item 7	DC.L	PartItem8	; Item 8	DC.L	PartItem9	; Item 9	DC.L	0		; nil terminatorPartItem9	DC.W	9		; item #	DC.W	136,20,149,130	; rect	DC.W	$000A		; button item constant	DC.L	PartInit	; address of our str	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorPartInit	str	'Partition' 	; Init stringPartItem2	DC.W	2		; item 2	DC.W	121,20,134,130	; rect	DC.W	$000A		; statictext item constant	DC.L	WarningCancel	; address of our first global str	DC.W	0		; item value	DC.W	0		; item flag	DC.L	0		; item colorPartItem3	DC.W	3		; item 3	DC.W	67,20,80,226	; rect	DC.W	$0011		; LineEdit item constant	DC.L	Item3Str	; nil str	DC.W	15		; item value	DC.W	0		; item flag	DC.L	0		; item coloritem3Str	str	'                         ' ; place holderPartItem4 ; partitions size	DC.W	4		; item 4		EXPORT	InvRectInvRect		;			DC.W	93,143,149,175	; rect	DC.W	$000D		; scroll bar item constant	DC.L	ScrollAction	; address of our scroll bar proc	DC.W	0		; item value	DC.W	3		; item flag	DC.L	ScrollCTbl	; item colorScrollCTbl	DC.W	$0000		; bar outline = black	DC.W	$00F0		; unhilited arrow = white back; black front	DC.W	$00F0		; hilited arrow = black fore, white back	DC.W	$00F0		; arrow background = white		EXPORT	ScrollColorScrollColor	DC.W	$00DD		; unhilited thumb = color of ctl		EXPORT	ScrollColor1ScrollColor1	DC.W	$00DD		; hilited thumb = color of ctl	DC.W	$01F0		; pageRgn = dithered blue	DC.W	$00F0		; inactive control = white		EXPORT	scrollArrayscrollArray	DC.W	$0000,$DDDD,$EEEE,$BBBB,$7777,$1111,$2222	DC.W	$3333,$4444,$5555,$6666,$8888,$9999,$AAAAPartItem6	DC.W	6		; item 6	DC.W	85,20,98,130	; rect	DC.W	$000A		; button item constant	DC.L	PartNew		; address of our str	DC.W	0		; item value	DC.W	0		; item flag	DC.