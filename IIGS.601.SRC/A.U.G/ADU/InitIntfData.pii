UNIT InitINTFDATA;CONST{ Modifier Flags }Btn1State  = 64;Btn0State  = 128;AppleKey   = 256;ShiftKey   = 512;CapsLock   = 1024;OptionKey  = 2048;ControlKey = 4096;KeyPad     = 8192;attrBank           =   $0001;attrAddr           =   $0002;attrPage           =   $0004;attrNoSpec         =   $0008;attrNoCross        =   $0010;attrFixed          =   $4000;attrLocked         =   $8000;Ok                 =   1;Cancel             =   2;ButtonItem         =   10;StatText           =   15;EditLine           =   17;IconItem           =   18;LongStatText       =   16;longStatText2      =   22;ItemDisable        =   $8000;srcCopy            =   $0000;ActiveFlag         =   1;ActivateEvt        =   8;wInGoAway          =   22;wInMenuBar         =   17;wInSpecial         =   25;wInControl         =   $0021;wInContent	= $0013;atItemListLength   =   7;{ constants for new HandleDiskInsert call }hdiScan = $8000;	{ flag bits }hdiPrompt = $4000;hdiUpdate = $2000;hdiEjects = $1000;hdiNow = $0800;TYPESignedByte     = -128..127;        {1 byte}Byte           = 0..255;           {2 bytes}Ptr            = ^SignedByte;      {4 bytes}Handle         = ^Ptr;             {4 bytes}ProcPtr        = Ptr;              {4 bytes}Fixed          = longint;          {4 bytes}Str255         = String [255];     {Pascal or C string}StringPtr      = ^Str255;          {4 bytes}StringHandle   = ^StringPtr;       {4 bytes}CStringPtr     = Ptr;              {4 bytes}CStringHandle  = Handle;           {4 bytes}        SCB       = Integer;    { Bits  Meaning                                  0-3   ColorTable                                  4     Reserved                                  5     Fill, 0=off, 1=on                                  6     Interrupt, 0=off, 1=on                                  7     ColorMode, 0=320, 1=640 }ToolTable      = packed record                   NumTools : integer;                   Tools    : array [1..30] of record                                   TSNum      : integer;                                   MinVersion : integer;                              end;                 end;VHSelect       = (v,h);PointPtr       = ^Point;Point          = packed record                   case integer of                       0: (v  : integer;                           h  : integer);                       1: (vh : array [VHSelect] of integer);                 end;RectPtr        = ^Rect;Rect           = packed record                   case integer of                       0: (v1       : integer;                           h1       : integer;                           v2       : integer;                           h2       : integer);                       1: (vh1      : Point;                           vh2      : Point);                 end;ColorValue     = integer;              {Bits: 0000RRRRGGGGBBBB}ColorTablePtr  = ^ColorTable;ColorTable     = array [0..15] of ColorValue;AnSCBByte      = Byte;                 {Scanline control byte}LocInfo        = packed record                   portSCB         :   AnSCBByte;                   liReserved      :   Byte;                   ptrToPixImage   :   Ptr;                   lwidth          :   integer;                   boundsRect      :   Rect;                 end;RgnHndl        = ^RgnPtr;RgnPtr         = ^Region;Region         = packed record                   rgnSize     :   integer;                   rngBBox     :   Rect;                   {Reserve storage for more data here if not rectangular}                 end;Pattern        = array [0..15] of integer;Mask           = array [0..3]  of integer;QDProcsPtr     = ^QDProcs;QDProcs        = packed record                   stdText     :   ProcPtr;                   stdLine     :   ProcPtr;                   stdRect     :   ProcPtr;                   stdRRect    :   ProcPtr;                   stdOval     :   ProcPtr;                   stdArc      :   ProcPtr;                   stdPoly     :   ProcPtr;                   stdRgn      :   ProcPtr;                   stdPixels   :   ProcPtr;                   stdComment  :   ProcPtr;                   stdTxMeas   :   ProcPtr;                   stdTxBnds   :   ProcPtr;                   stdGetPic   :   ProcPtr;                   stdPutPic   :   ProcPtr;                 end;        LocInfoRec =            packed record                PortSCB:    SCB;                PixelImage: Ptr;                Width:      Integer;                BoundsRect: Rect;            end;GrafPortPtr    = ^GrafPort;GrafPort       = packed record                   portInfo    :   LocInfo;                   portRect    :   Rect;                   clipRgn     :   RgnHndl;                   visRgn      :   RgnHndl;                   bkPat       :   Pattern;                   pnLoc       :   Point;                   pnSize      :   Point;                   pnMode      :   integer;                   pnPat       :   Pattern;                   pnMask      :   Mask;                   pnVis       :   integer;                   fontName    :   Handle;                       fontID      :   longint;                   fontFlags   :   integer;                   txSize      :   integer;                   txFace      :   integer;                   txMode      :   integer;                   spExtra     :   Fixed;                   chExtra     :   Fixed;                   fgColor     :   integer;                   bgColor     :   integer;                                picSave     :   Handle;                   rgnSave     :   Handle;                   polySave    :   Handle;                   grafProcs   :   QDProcsPtr;                   arcRot      :   integer;                   userField   :   longint;                   sysField    :   longint;                         end;PicHndl        = ^PicPtr;PicPtr         = ^Picture;Picture        = packed record                   picSize     :   integer;                   picFrame    :   Rect;                   {Picture bytes go here -- reserve storage}                 end;FontID         = packed record                   famNum      : integer;                   fontStyle   : Byte;                   fontSize    : Byte;                 end;FontInfoRecord = packed record                   ascent  : integer;                   descent : integer;                   widMax  : integer;                   leading : integer;                 end;MenuRecPtr     = ^MenuRec;MenuRecHndl    = ^MenuPtr;MenuRec        = packed record                   menuID     : integer;                   menuWidth  : integer;                   menuHeight : integer;                   menuProc   : ProcPtr;                   menuFlag   : Byte;                   menuRes    : Byte;                   firstItem  : Byte;                   numOfItems : Byte;                   titleWidth : integer;                   titleName  : StringPtr;                 end;WindColorPtr      = ^WindColor;WindColor         = packed record                       frameColor      : integer;                       titleColor      : integer;                       tBarColor       : integer;                       growColor       : integer;                       infoColor       : integer;                    end;ParamList          = packed record                       paramLength     : integer;                       wFrameBits      : integer;                       wTitle          : StringPtr;                       wRefCon         : longint;                       wZoom           : Rect;                       wColor          : WindColorPtr;                       wYOrigin        : integer;                       wXOrigin        : integer;                       wDataH          : integer;                       wDataW          : integer;                       wMaxH           : integer;                       wMaxW           : integer;                       wScrollVer      : integer;                       wScrollHor      : integer;                       wPageVer        : integer;                       wPageHor        : integer;                       wInfoRefCon     : longint;                       wInfoHeight     : integer;                       wFrameDefProc   : ProcPtr;                       wInfoDefProc    : ProcPtr;                       wContDefProc    : ProcPtr;                       wPosition       : Rect;                       wPlane          : longint;                       wStorage        : Ptr;                    end;WmTaskRec          = packed record                       wmWhat          : integer;                       wmMessage       : longint;                       wmWhen          : longint;                       wmWhere         : Point;                       wmModifiers     : integer;                       wmTaskData      : longint;                       wmTaskMask      : longint;                       wmLastClickTick : Longint;                       wmClickCount : Integer;                       wmTaskData2 : Longint;                       wmTaskData3 : Longint;                       wmTaskData4 : Longint;                       wmLastClickPt : Point;                     end;ItemTempPtr    = ^ItemTemplate;ItemTemplate   = packed record                   itemID      : integer;                   itemRect    : Rect;                   itemType    : integer;                   itemDescr   : Ptr;                   itemValue   : integer;                   itemFlag    : integer;                   itemColor   : Ptr;                 end;DialogTemplate = record                   dtBoundsRect : Rect;                   dtVisible    : boolean;                   dtRefCon     : longint;                   dtItemList   : array [0..atItemListLength] of ItemTempPtr;                 end;AlertTempPtr  = ^AlertTemplate;AlertTemplate = record                  atBoundsRect :   Rect;                  atAlertID    :   integer;                  atStage1     :   SignedByte;                  atStage2     :   SignedByte;                  atStage3     :   SignedByte;                  atStage4     :   SignedByte;                  atItem1      :   ItemTempPtr;                  atItem2      :   ItemTempPtr;                  atItem3      :   ItemTempPtr;                  atItem4      :   ItemTempPtr;                end;PrInfoRecHndl  = ^PrInfoRecPtr;PrInfoRecPtr   = ^PrInfoRec;PrInfoRec      = packed record                   iDev    :   integer;                   iVRes   :   integer;                   iHRes   :   integer;                   rPage   :   Rect;                 end;PrStyleRecHndl = ^PrStyleRecPtr;PrStyleRecPtr  = ^PrStyleRec;PrStyleRec     = packed record                   wDev        :   integer;                   internA     :   array [0..2] of integer;                   feed        :   integer;                   paperType   :   integer;                   crWidth     :   integer;                   reduction   :   integer;                   internB     :   integer;                 end;PrJobRecHndl   = ^PrJobRecPtr;PrJobRecPtr    = ^PrJobRec;PrJobRec       = packed record                   iFstPage    :   integer;                   iLstPage    :   integer;                   iCopies     :   integer;                   bJDocLoop   :   SignedByte;                   fFromUser   :   boolean;                   pIdleProc   :   ProcPtr;                   pFileName   :   StringPtr;                   iFileVol    :   integer;                   bFileVers   :   SignedByte;                   bJobX       :   SignedByte;                 end;PrRecHndl      = ^PrRecPtr;PrRecPtr       = ^PrRec;PrRec          = packed record                   prVersion   :   integer;                   prInfo      :   PrInfoRec;                   rPaper      :   Rect;                   prStl       :   PrStyleRec;                   prInfoPT    :   array [0..13] of SignedByte;                   prXInfo     :   array [0..23] of SignedByte;                   prJob       :   PrJobRec;                   printX      :   array [0..37] of SignedByte;                   iReserved   :   integer;                 end;PrStatusRecHndl= ^PrStatusRecPtr;PrStatusRecPtr = ^PrStatusRec;PrStatusRec    = packed record                   iTotPages   :   integer;                   iCurPage    :   integer;                   iTotCopes   :   integer;        {>!<  iTotCopies}                   iCurCopy    :   integer;                   iTotBands   :   integer;                   iCurBand    :   integer;                   fPgDirty    :   boolean;                   fImaging    :   boolean;                   hPrint      :   PrRecHndl;                   pPrPort     :   GrafPortPtr;                   hPic        :   PicHndl;                 end;TypeListPtr    = ^TypeListRec;TypeList       = packed record                   NumEntries  :   Byte;                   FileType1   :   Byte;                   FileType2   :   Byte;                   FileType3   :   Byte;                   FileType4   :   Byte;                   FileType5   :   Byte;                   FileType6   :   Byte;                   FileType7   :   Byte;                   FileType8   :   Byte;                 end;SFReplyRec     = record                   good            :   boolean;                   filler          :   boolean;                   fileType        :   integer;                   auxFileType     :   integer;                   filename        :   String [15];                   fullPathname    :   String [127];                 end;        ControlHandle = ^ControlPtr;        ControlPtr    = ^ControlRec;        ControlRec    =            packed record                CtrlNext:   ControlHandle;                CtrlOwner:  GrafPortPtr;                CtrlRect:   Rect;                CtrlFlag:   Byte;                CtrlHilite: Byte;                CtrlValue:  Integer;                CtrlProc:   ProcPtr;                CtrlAction: ProcPtr;                CtrlData:   LongInt;                CtrlRefCon: LongInt;                CtrlColor:  ColorTablePtr;                case integer of                   0: { special fields for scroll bar variation of control record }                      (CtlThumbRect: Rect;                       CtlPageRect:  Rect);                   1: { special fields for list record variation of control record }                      (CtlMemDraw:   ProcPtr;                       CtlMemHeight: Integer;                       CtlMemSize:   Integer;                       CtlList:      Ptr;              { ListMemP }                       CtlListBar:   ControlHandle)            end;END.