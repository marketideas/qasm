{################################################################}{#								#}{#  File:	Init.Pas from IIGS Disk Initializer		#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Description:  This file is the main file for the IIGS disk	#}{#		  initializer.					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Authors:	Darryl Lovato					#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Copyright:	1987,1988 by Apple Computer Inc.		#}{#		All rights reserved.				#}{#								#}{#--------------------------------------------------------------#}{#								#}{#  Modification History:					#}{#								#}{#	Who	When	The Change				#}{#	---	------	-------------------------------------	#}{#	SR	12/7/87	Created v.1 - erase & init only		#}{#	DGL	1/29/88 Rewrote everything - cut size in half!  #}{#	DGL	5/9/88	Finished Adding Partition Support	#}{#			and other features... far too many to	#}{#			list here...				#}{#	DGL	5/12/88 Added Zero and Info operations		#}{#	DGL	5/20/88 Released pre-alpha version to testers	#}{#	DGL	6/1/88  Alpha!					#}{#	DGL	6/13/88 Alpha 2					#}{#	DGL	6/24/88 Alpha 3					#}{#	DGL	7/1/88  Beta 1					#}{#	DGL	7/13/88 Beta 2					#}{#	DGL	7/20/88	Beta 3					#}{#	DGL	7/27/88	Beta 4					#}{#	DGL	8/1/88	Beta 5					#}{#	DGL	8/8/88	Beta 6					#}{#	DGL	8/15/88 Final!					#}{#								#}{################################################################}{$LongGLobals-}{$ToolErrorChk-}{$A+}program Init;uses  InitIntfData,  InitIntfProc,  InitIntfPdos,  ListMgr,  Globals,  Utils,  Guts,  Dialog,  Menu,  Event;{################################################################}{#	startup tools here, return false if we failed		#}{################################################################}function StartUpTools : boolean;VAR  theVerPBLK : myVersionBlock;begin{ first check OS version }  theVerPBLK.pcount := 1;  IF (CallGSOS(@theVerPBLK, $202A) <> 0) OR	{ if error, must be bad version }    (BITAND(theVerPBLK.version, $7FFF) < $0400)	{ want GS/OS 4.0 (SD 6.0) or later }    THEN BEGIN    StartUpTools := FALSE;	{ can't run!!	}    EXIT(StartUpTools);    END;  listControl1 := nil;  partDlog := nil;  TLStartUp;              {Init Tool Locator  }  MyMemoryID := MMStartUp;{Init Memory Manager}    GlobalParts := PartitionHdl(NewHandle(2 + sizeof(part),MyMemoryID,attrBank+attrPage,nil));  InitPtr := StevesStartupTools(myMemoryID,0,@ToolRec);  startuptools := (NOT istoolerror);  CurrCursor := -1;			    {init global}  SetCtlParamPtr(@subStrArray);	{ register runtime strings with Control Mgr }  MakeCursor(arrow);                        {Init watch cursor}end;    {of StartUpTools}{################################################################}{#		Here's the main event!				#}{################################################################}begin  {of MAIN program Init}  if StartUpTools then    begin      		{ Initialize IIGS Tools }      SetUpMenus;       { Set up menus }      MakeCursor(arrow);{ put this up for a while}      ShowInit;		{ display main window	} { added 3/6/91 by Monte Benaresh }    { suppress detection of initial device inserts }      tempGLong := HandleDiskInsert(hdiUpdate, 0); { update all devices }      MainEvent;        { Use application }    end  ELSE    BEGIN		{ tell user we can't run	}	tempGLong := TLTextMountVolume(@badStart1Str, @badStart2Str, @badStart1But,				@badStart2But);    END;  SANEShutDown;		{ need this due to compiler bug	}  StevesShutDownTools(0,initPtr); { Shut down IIGS Tools }end.