unit PokeyUnit;{$LongGlobals+}interfaceUSES    QDIntf,        GSIntf,        MiscTools,        ConsoleIO;CONST	xgridmin	=15;	xwide		=67;	xgridmax	=82;	ygridmin	=20;	ygridtall	=10; 	GridLeft	=15;	GridTop		=20;	GridWidth	=67;	GridTall	=10;	Height1		=154;	Width2		=165;	Height2		=154;	Height77	=154;	Height99	=34;		ArrowHX		=35;	ArrowHY		=102;	ArrowCX		=128;	ArrowCY		=102;		SliderX1	=29;	SliderY1	=31;	SliderX2	=127;	SliderY2	=31;	SldrLength	=91;	SlideMin	=37;	SlideMax	=117;	InHueAdj	=9;	InSatAdj	=10;	AdjInc		=80;	AdjDec		=81;	AdjSave		=82;	InterlaceMode	=203;	Enable		=1;	Disable		=0;	TYPE	XColor =		packed record			case Integer of				 0:(lowbyte:	signedbyte;				    hibyte:	signedbyte);				 1:(whole:	integer);		end;       VAR 	JustOpened:	 boolean;	WeLoadedIt:	 boolean;	WeStartedIt: boolean;	ActOrDeAct:	 boolean;	UpdateTime:	 boolean;	ActivateTime:boolean;	myWindOpen:  boolean;	WantHand:	 boolean;	IsHand:		 boolean;	DoWhite:	 boolean;	EscDefault:	 boolean;	ForceThisGrid: boolean;    myWind:      NewWindowParamBlk;    myWindPtr:   WindowPtr;    myWindColor: WindowColorTbl;    Chandle:     array[1..18] of Controlhandle;    Colors:      array[1..16] of rect;    Disslevel:   array[0..7] of integer;    DissSave1:   integer;    DissSave2:   integer;	DissCancle1: integer;	Disscancle2: integer;	LastKDiss:	 integer;	LastNKDiss:	 integer;	MMode:		 integer;	MStatus:	 Integer;    Color:       Xcolor;    ii:	     	 integer;	Curpalette:	 integer;	MiniPalette: integer;	CtlColor:    integer;	RGB:		 integer;	RedValue:	 integer;	GreenValue:	 integer;	BlueValue:	 integer;	Rsave:		 integer;	Gsave:	     integer;	Bsave:	     integer;		StaySame640: boolean;	Rsave640:	 integer;	Gsave640:	 integer;	Bsave640:	 integer;	CtlColor640: integer;	RReDraw:	 integer;	GReDraw:	 integer;	BReDraw:	 integer;		IToggle:	 boolean;		SelectMode:  integer;	XString:     string;	LongOne:     longint;	WhichVMode:  integer;	LastVMode:	 integer;			FoundPart:	Integer;	Bool:		boolean;	MyPoly:		PolyHandle;	MyPoly2:	PolyHandle;  	Hand:		ARRAY[1..148] OF INTEGER;  	HandPtr:	Cursorptr;  	rectPtrX:   rect;  	SlidePos1:	Integer;  	SlidePos2:	Integer;		procedure 	UpArrow(drawstate,PointX,PointY: integer); procedure  	DownArrow(drawstate,PointX,PointY: integer);procedure	DrawSlider(drawstate,PointX,PointY,SlideY: integer);procedure	DrawCGrid;procedure	DrawCSel(jj: integer);procedure	ToRGB(ColorEntry: integer);function 	GetDissIndex(DissValue: integer):integer;function	GetKeyIndex: integer;function	LoadVDTool: boolean;procedure	UnLoadVDTool;{-------------------------------------------------------------------------------}procedure	VDStartUp;												tool 33,2;procedure	VDShutDown;												tool 33,3;function	VDStatus: boolean;										tool 33,6;procedure		VDKeySetKCol(RedValue,GreenValue,BlueValue: integer); 	tool 33,15;function	VDKeyGetRCol: integer;									tool 33,16;function	VDKeyGetGCol: integer;									tool 33,17;function	VDKeyGetBCol: integer;									tool 33,18;procedure	VDKeySetKDiss(KDissolve: integer);						tool 33,19;function	VDKeyGetKDiss: integer;									tool 33,20;procedure	VDKeySetNKDiss(KDissolve: integer);						tool 33,21;function	VDKeyGetNKDiss: integer;								tool 33,22;procedure	VDGGControl(Selector,GGCtrlVAlue: integer); 			tool 33,29;procedure 	VDInConvAdj(Selector,AdjFunction: integer);				tool 33,12;{---------------------------------------------------------------}implementation{-------------------------------------------------------------------------------  NAME:        UpArrow  PURPOSE:     	Draws an up arrow control  PASSED:		Drawstate:	integer;	(0=draw the complete arrow  										 1=just draw the outline)				PointX:		integer;	(X point of were to draw arrow)				PointY:		integer;	(Y point of were to draw arrow)  RETURNED:		NONE-------------------------------------------------------------------------------} procedure UpArrow(drawstate,PointX,PointY: integer);  begin  	If drawstate=0 then begin		{This draws the arrow} 		myPoly:=OpenPoly; 	   		MoveTo(PointX,PointY); {top point}   		LineTo(PointX-10,PointY+5); {down left slope}   		LineTo(PointX-5,PointY+5); {under}   		LineTo(PointX-5,PointY+10); {bar down}   		LineTo(PointX+5,PointY+10); {across bottom}   		LineTo(PointX+5,PointY+5); {bar up}   		LineTo(PointX+10,PointY+5); {under right side}   		LineTo(PointX,PointY); {back to starting point}   		ClosePoly; 		PaintPoly(MyPoly);   		KillPoly(MyPoly);   		end;{This draws the outline part} 	if drawstate=1 then myPoly:=OpenPoly; 	   	MoveTo(PointX-15,PointY+11); {far bottom left line}   	LineTo(PointX-15,PointY+2);   	LineTo(PointX-7,PointY-2);   	LineTo(PointX+7,PointY-2);{across top}   	LineTo(PointX+15,PointY+2);   	LineTo(PointX+15,PointY+11);    	if drawstate=1 then begin    		ClosePoly; 		InvertPoly(MyPoly);   		KillPoly(MyPoly);   		end;  	   end; {of UpArrow}{-------------------------------------------------------------------------------  NAME:        DownArrow  PURPOSE:     	Draws a down arrow.  PASSED:		Drawstate:	integer;	(0=draw the complete arrow  										 1=just draw the outline)				PointX:		integer;	(X point of were to draw arrow)				PointY:		integer;	(Y point of were to draw arrow)  RETURNED:		NONE-------------------------------------------------------------------------------} procedure DownArrow(drawstate,PointX,PointY: integer);  begin  	PointY:=PointY+22; {offset from up arrow coordinates} 	If drawstate=0 then begin		{This draws the arrow} 		myPoly:=OpenPoly; 	   		MoveTo(PointX,PointY); {top point}   		LineTo(PointX-10,PointY-5); {down left slope}   		LineTo(PointX-5,PointY-5); {under}   		LineTo(PointX-5,PointY-10); {bar down}   		LineTo(PointX+5,PointY-10); {across bottom}   		LineTo(PointX+5,PointY-5); {bar up}   		LineTo(PointX+10,PointY-5); {under right side}   		LineTo(PointX,PointY); {back to starting point}   		ClosePoly; 		InvertPoly(MyPoly);   		PaintPoly(MyPoly);   		end;{This draws the outline part} 	if drawstate=1 then myPoly:=OpenPoly; 	   	MoveTo(PointX-15,PointY-11); {far bottom left line}   	LineTo(PointX-15,PointY-2);   	LineTo(PointX-7,PointY+2);   	LineTo(PointX+7,PointY+2);{across top}   	LineTo(PointX+15,PointY-2);   	LineTo(PointX+15,PointY-11);    	if drawstate=1 then begin    		ClosePoly; 		InvertPoly(MyPoly);   		KillPoly(MyPoly);   		end;  	end; {of DownArrow}{-------------------------------------------------------------------------------  NAME:        DrawSlider  PURPOSE:     	Draws the slider control.  PASSED:		Drawstate:	integer;	(0=init. the slider  										 1=just draw the slide indicator										 2=erase the old and draw the new indicator										 3=draw drag of indicator										 4=erase drag of indicator)				PointX:		integer;	(X point of were to draw slider)				PointY:		integer;	(Y point of were to draw slider)				SlideY:		integer;	(indicator Y-value)  RETURNED:		NONE-------------------------------------------------------------------------------} procedure DrawSlider(drawstate,PointX,PointY,SlideY: integer); Var PM: Integer; label 99; begin {Draw the slide bar}{NOTE: DrawState=0 init. slider, =1 just draw slider, =2 just draw slider, =3 draw drag, =4 erase drag}99:Case DrawState of   	0:begin {Initilization}	{Draw the center dark part}		SetRect(RectPtrX,PointX,PointY,PointX+10,PointY+SldrLength);		PaintRRect(RectPtrX,6,6);   		SetRect(RectPtrX,PointX-4,PointY-2,PointX+14,PointY+SldrLength+2);   		FrameRRect(RectPtrX,8,8);   		DrawState:=1; {so will draw slide also}   		goto 99;		end; {of case 0}			1: begin {Just draw slider indicator}		{Draw the slide part (first the outside box)}   		SetDithColor(15);   		SetRect(RectPtrX,PointX-6,SlideY,PointX+16,SlideY+8);   		PaintRect(RectPtrX);{paint it white}   		SetDithColor(0);   		FrameRect(RectPtrX);   	{Now the inside box}		SetDithColor(15);   		SetRect(RectPtrX,PointX-8,SlideY+2,PointX+18,SlideY+6);   		PaintRect(RectPtrX);   		SetDithColor(0);   		FrameRect(RectPtrX);   		end; {of case 1}   		   	2: begin {Erase slide indicator}	{Erase the whole thing at once}   		SetDithColor(15);   		SetRect(RectPtrX,PointX-8,SlideY,PointX+18,SlideY+8);   		PaintRect(RectPtrX);{paint it white}   		SetDithColor(0);   		   	{Now reconstruct the inside part}   		MoveTo(PointX-4,SlideY);   		LineTo(PointX-4,SlideY+7);   		MoveTo(PointX+13,SlideY);   		LineTo(PointX+13,SlideY+7);   		SetRect(RectPtrX,PointX,SlideY,PointX+10,SlideY+8);   		PaintRect(RectPtrX);  		end; {of case 2}  	  	3: begin {draw drag}  	   	PM:=2;   	   	SetDithColor(15);  		SetPenMode(PM);{set pen to modeXOR}   		SetRect(RectPtrX,PointX-6,SlideY,PointX+16,SlideY+8);   		FrameRect(RectPtrX);   		SetRect(RectPtrX,PointX-8,SlideY+2,PointX+18,SlideY+6);   		FrameRect(RectPtrX);   		SetDithColor(0);  		SetPenMode(0);{set pen to modeCopy}  		end; {of case 3}  		   	   	end; {of case}end; {of DrawSlider}{-------------------------------------------------------------------------------  NAME:        procedure DrawCGrid;  PURPOSE:     	Draws the color grid.  PASSED:		NONE  RETURNED:		NONE-------------------------------------------------------------------------------} procedure DrawCGrid;  var i,j,k,l:	integer;  begin      {*Do Color Grid*}   i:=1;   for j:=0 to 1 do begin   for k:=0 to 7 do begin      	SetRect(Colors[i],GridLeft+j*GridWidth,GridTop+k*GridTall   	     ,GridLeft+GridWidth+j*GridWidth,GridTop+GridTall+k*GridTall); 	l:=i-1;   	SetDithColor(l); {set the interior color}   	SetDithColor(l);{just to make sure}   	PaintRect(Colors[i]); {paint the interior color}   	   {	SetDithColor(0); }{first frame it in black}  {	FrameRect(Colors[i]); }{draw the frame}   	i:=i+1;	   	end;   	end;   SetDithColor(0);   SetRect(RectPtrX,GridLeft,GridTop        ,GridLeft+2*GridWidth,GridTop+8*GridTall);   FrameRect(RectPtrX);end; {of DrawCGrid}{-------------------------------------------------------------------------------  NAME:        procedure DrawCSel;  PURPOSE:     	Draws the color grid selector rectangle.  PASSED:		jj:	integer;	(which grid you want selected)  RETURNED:		NONE-------------------------------------------------------------------------------} procedure DrawCSel(jj:integer); label 999,888; var i,j,k,L:		integer; 	myLongInt:	longInt;	y:			integer;	myPoint:	point;  begin{first erase the old selector} 	i:=CtlColor+1; {get old selected color} 	k:=(CtlColor mod 8); 	if i< 9 then j:=0 else j:=1;   	SetRect(Colors[i],GridLeft+j*Gridwidth,GridTop+k*GridTall   	     ,GridLeft+GridWidth+j*GridWidth,GridTop+GridTall+k*GridTall);   	SetDithColor(i-1); {set the interior color}   	PaintRect(Colors[i]); {paint the interior color}   	SetDithColor(0);   	SetRect(RectPtrX,GridLeft,GridTop,GridLeft+GridWidth+GridWidth,GridTop+8*GridTall);   	FrameRect(RectPtrX);{Now draw the new selected frame}{However, check to see that the Key color is indeed the selected grid color}	k:=GetKeyIndex; {determine key index}		WhichVMode:=BitAnd(GetMasterSCB,$0080);{get video mode}{Calculate which SCB corresponds to the selected grid of the DA}			MyPoint:=Point(GetContentOrigin(myWindptr));			LocalToGlobal(MyPoint);			y:=MyPoint.v;			y:=y+GridTop+5+((jj mod 8)*GridTall);			if y>199 then y:=199;{incase its off the bottom of the screen}			y:=GetSCB(y);			y:=BitAnd(y,$000f);				if WhichVMode<>LastVMode then {in case we just switched video modes}		begin			StaySame640:=false;			CtlColor640:=-1;			ForceThisGrid:=false;			end;{First check if in 640 mode and that the key color has indeed changed, else use same grid}		if ((WhichVMode<>0) and StaySame640) then begin		if ((Rsave640=VDKeyGetRCol) and (Gsave640=VDKeyGetGCol) and (Bsave640=VDKeyGetBCol)) then			begin								if CtlColor640>=0 then begin {if was valid and indicated last time}										jj:=CtlColor640;										{Now make sure the pallettes actual color didnt change}					ToRGB(GetColorEntry(y,MiniPalette));					if ((RedValue=Rsave640) and (GreenValue=Gsave640) and (BlueValue=Bsave640)) then						goto 888 else ForceThisGrid:=false;											end;			end;		end;					if (WhichVMode=0) and (RGB<>GetColorEntry(y,jj)) then {320 mode}				begin					for L:=0 to 16 do begin						if L=16 then begin  goto 999; end;						if RGB=GetColorEntry(y,L) then leave;						end;{of do}					jj:=L;				end;			if ((WhichVMode<>0) and ((CurPalette<>y) or (ForceThisGrid=false))) then {640 mode}			begin				CtlColor640:=-1;{default incase we dont find color}				for L:=7 downto -1 do begin					if L<0 then goto 999;  					if RGB=GetColorEntry(y,L) then  leave;									end;{of for loop} 									case L of						7:jj:=15;						6:jj:=14;						5:jj:=1;						4:jj:=0;						3:jj:=15;						2:jj:=8;						1:jj:=4;						0:jj:=0;						end;{of case}				end;{of 640}				888:i:=jj+1; {get new selected color}	k:=(jj mod 8);	if i < 9 then j:=0 else j:=1;   	SetDithColor(0); {now set color to black} 	SetRect(Colors[i],GridLeft+j*Gridwidth,GridTop+k*GridTall 	     ,GridLeft+GridWidth+j*GridWidth,GridTop+GridTall+k*GridTall);  	FrameRect(Colors[i]); {draw the frame}  	    SetDithColor(15); {now set color to white}   	SetRect(Colors[i],21+j*55,71+k*10,74+j*55,79+k*10); 	SetRect(Colors[i],GridLeft+1+j*Gridwidth,GridTop+1+k*GridTall 	     ,GridLeft-1+GridWidth+j*GridWidth,GridTop-1+GridTall+k*GridTall);  	FrameRect(Colors[i]); {draw the frame}  	FrameRect(Colors[i]); {draw the frame} 	SetDithColor(0); {now set color back to black}  	CtlColor:=jj;		{---This fixes the problem with 640 mode changing the selected color grid---}	CtlColor640:=jj;	Rsave640:=VDKeyGetRCol;	Gsave640:=VDKeyGetGCol;	Bsave640:=VDKeyGetBCol;999:	ForceThisGrid:=false;	LastVMode:=WhichVMode; end; {of DrawCSel} {-------------------------------------------------------------------------------  NAME:        procedure ToRGB;  PURPOSE:     	Breaks up the color into RedValue, GreenValue, BlueValue.  PASSED:		ColorEntry:	Integer;	(RGB color you want taken apart)  RETURNED:		NONE-------------------------------------------------------------------------------} procedure ToRGB(ColorEntry: integer);  var i,j:	integer;  begin  	j:=ColorEntry; 	for i:=1 to 4 do j:=BitSL(j); 	RedValue:=BitAnd(j,$f000); 	for i:=1 to 4 do j:=BitSL(j); 	GreenValue:=BitAnd(j,$f000); 	for i:=1 to 4 do j:=BitSL(j); 	BlueValue:=BitAnd(j,$f000); end; {of ToRGB}{-------------------------------------------------------------------------------  NAME:        function GetDissIndex: integer;  PURPOSE:     	To determine the dissolve level index.    PASSED:		DissValue:	integer;	(dissolve value you want to lookup)  RETURNED:		integer;	(the looked up dissolve index 0-6)-------------------------------------------------------------------------------} function GetDissIndex(DissValue: integer): integer;  begin	if (DissValue>=0) and (DissValue<5462) then GetDissIndex:=0;	if (DissValue>5461) and (DissValue<16384) then GetDissIndex:=1;	if (DissValue>16383) and (DissValue<27308) then GetDissIndex:=2;	if (DissValue>27307) and (DissValue<=32767) then GetDissIndex:=3;	if (DissValue<-27305) and (DissValue>=-32767) then GetDissIndex:=3;	if (DissValue>-27307) and (DissValue<-16384) then GetDissIndex:=4;	if (DissValue>-16385) and (DissValue<-5461) then GetDissIndex:=5;	if (DissValue>-5462) and (DissValue<=-1) then GetDissIndex:=6;	 end;{-------------------------------------------------------------------------------  NAME:        function GetKeyIndex: integer;  PURPOSE:    	Gets the current key colors index into palette    PASSED:		NONE  RETURNED:		integer;	(determines index)-------------------------------------------------------------------------------} function GetKeyIndex: integer;  var i,R,G,B:	integer; begin	R:=VDKeyGetRCol;	G:=VDKeyGetGCol;	B:=VDKeyGetBCol;	for i:=0 to 3 do begin		R:=BitSR(R);		G:=BitSR(G);		B:=BitSR(B);		end;	for i:=0 to 3 do G:=BitSR(G);	for i:=0 to 7 do B:=BitSR(B);	RGB:=BitOR(R,G);	RGB:=BitOR(RGB,B);	WhichVMode:=BitAnd(GetMasterSCB,$0080);{get video mode}	{Now scan palette for key color}	if WhichVMode=0 then begin {if 320 mode}		for i:=15 downto 0 do 			if RGB=GetColorEntry(Curpalette,i) then leave; 		GetKeyIndex:=i; 		end{of 320 mode} 	else begin {of 640 mode} 		for i:=7 downto 0 do 			 				if RGB=GetColorEntry(Curpalette,i) then leave;													case i of			7:GetKeyIndex:=15;			6:GetKeyIndex:=14;			5:GetKeyIndex:=1;			4:GetKeyIndex:=0;			3:GetKeyIndex:=15;			2:GetKeyIndex:=8;			1:GetKeyIndex:=4;			0:GetKeyIndex:=0;			end;{of case}			 		end;{of 640 mode} end;{of GetKeyIndex} {-------------------------------------------------------------------------------  NAME:        function LoadVDTool;  PURPOSE:     	Loads the Video I/O interface toolset (It will only load and  				start the toolset if its not already there)    PASSED:		NONE  RETURNED:		boolean			;true if no errors loading  								;false if error occured with loadonetool-------------------------------------------------------------------------------} function LoadVDTool: boolean;  var TLError:	integer; 	 StatusVD:	boolean; begin  	LoadVDTool:=true; {assume its going to load correctly}	WeLoadedIt:=false; 	WeStartedIt:=false; {assume we didnt start it}	 	{First check to see if the tool has already been loaded and started}	StatusVD:=VDStatus;	if IsToolError then begin {if any error, then no tool, so lets load it up}		TLError:=ToolErrorNum;{get error number}				loadonetool(33,0);{load the Video I/O interface toolset}		if IsToolError then begin				SelectMode:=99; {no tool or not enough memory}				LoadVDTool:=false;			end else begin			WeLoadedIt:=true;			end;{of else}		end;{of not tool, lets load}	StatusVD:=VDStatus;	if IsToolError=false then begin		if StatusVD=false then begin {if tool not started, then start it up}			TLError:=0;			VDStartUp;{start up the tool}			if IsToolError then begin				TLError:=ToolErrorNum;				LoadVDTool:=false;{--ver 1.2 fix--}				if TLError=$2110 then SelectMode:=98;{no pokey card found in system}				end;{of IsToolError}			if TLError=0 then WeStartedIt:=true;			end;{of StatusVD=false}		end;{of IsToolError of VDStatus}	end;{of LoadVDTool}{-------------------------------------------------------------------------------  NAME:        procedure UnLoadVDTool;  PURPOSE:     	Unloads the Video I/O interface toolset    PASSED:		NONE  RETURNED:		NONE-------------------------------------------------------------------------------} procedure UnLoadVDTool;  var TLError:	integer; 	 StatusVD:	boolean; begin 	if WeStartedIt then begin {only shut down if we started it}		VDShutDown;		WeStartedIt:=false;		end;{of if WeStartedIt}		 	if WeLoadedIt then begin {only unload if we loaded the tool}		StatusVD:=VDStatus;{get status of toolset}		If IsToolError=false then Unloadonetool(33);{Unload Video I/O interface toolset}		WeLoadedIt:=false;	end;{of WeLoadedIt} end;{of UnLoadVDTool}end.