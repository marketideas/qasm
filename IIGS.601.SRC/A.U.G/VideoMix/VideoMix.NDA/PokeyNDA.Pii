{$DeskAcc 60 -1 VideoMix}{$LongGlobals+}program PokeyNDA;{  Copyright Apple Computer, Inc.  1987, 1988, 1989  All Rights Reserved    The VideoMix DA was programmed by Dan D. Hitchens,  with many thanks to Roark Hiloman from Software QA.    Copyright TML Systems, Inc. 1987, 1988}{-------------------------------------------------------------------------------}{CHANGE HISTORY:Version 1.1 F14/24/89		DDH	-Changed period to once every second (was once every 1/60th).				-Changed when we load and unload tool033 (to correct method)				-Modified LoadVDTool routine to return a boolean=false if tool033				 is unable to load.  Also, always checks to see if the tool is				 already loaded and started before it attempts to load and				 start it.				-Added UnLoadVDTool routine to unload Tool033 only if we loaded				 and started it in the NDA.				 Version 1.1 F24/25/89		DDH	-Changed DAInit to initialize WeLoadedIt and WeStartedIt to false				-Changed UnLoadVDTool routine to correctly unload only when we				 loaded it.				Version 1.2 b17/13/89		DDH	-Fixed bug where in Video Adjust, Tint and Color buttons would				 retain mousedown events from button to button.				-Fixed DAInit & DAOpen where VD tool calls were made when the				 tool wasn't loaded or the card wasn't there.Version 1.2 Final11/3/89		DDH	-Changed version from v1.2d to v1.2 for final release.Version 1.3 4/3/90		DDH	-Fixed crash bug when user hits esc key after no card is found.7/12/91		DDH -Fixed update problem where the tool wasnt loaded and started.				-Changed copyright to 91.}{-------------------------------------------------------------------------------}{--------------------------------------------------------------------------------------------------------------------------------------------------------------}USES    QDIntf,        GSIntf,        MiscTools,        ConsoleIO,        PokeyUnit;        procedure	DrawTime;                   forward;procedure	MakeCtrls;				    forward;procedure	DAInit(Code: integer);		forward;procedure	XXKeySetKDiss(KDissolve: integer);	forward;procedure	XXKeySetNKDiss(NKDissolve: integer);	forward;VAR		JustOpened2:	boolean;{-------------------------------------------------------------------------------  NAME:        function DAOpen;  PURPOSE:		Performs the Open function of the NDA  PASSED:		NONE  RETURNED:		NONE-------------------------------------------------------------------------------}function DAOpen: WindowPtr;var 	TLError,j:	Integer;		CurrPort:	Grafptr;begin   if SelectMode<80 then SelectMode:=11;{default to pick key color mode}     if myWindOpen then SelectWindow(myWindPtr)   else begin                  	myWindPtr := NewWindow(myWind);   	SetSysWindow(myWindPtr);      end;         DAOpen    := myWindPtr;   myWindOpen := true;      currPort:=GetPort;   SetPort(GrafPtr(MyWindPtr));   JustOpened:=true;   JustOpened2:=true;   WantHand:=false;   IsHand:=false;   CurPalette:=BitAnd(GetMasterSCB,$000f); {Get current palette}      MakeCtrls;   EscDefault:=true;     if LoadVDTool then begin{Load up the toolset if it's not already loaded}        	  CtlColor:=GetKeyIndex;{--ver 1.2 fix--, moved to this if block}	  DissSave1:=VDKeyGetKDiss;{init. sliders}   	  DissSave2:=VDKeyGetNKDiss;	  j:=GetDissIndex(DissSave1);      SlidePos1:=SliderY1+2+(j*13);      j:=GetDissIndex(DissSave2);      SlidePos2:=SliderY2+2+(j*13);	  DissCancle1:=DissSave1;	  DissCancle2:=DissSave2;	  	  UnLoadVDTool;{Unload the tool set if it was loaded up by me}	  end;{of if LoadVDTool}   SetPort(currPort); end; { of DAOpen }{-------------------------------------------------------------------------------  NAME:        procedure DAClose;  PURPOSE:		Closes the NDA.  PASSED:		NONE  RETURNED:		NONE-------------------------------------------------------------------------------}procedure DAClose;begin   CloseWindow(myWindPtr);{close the window and release all controls}   InitCursor;   myWindOpen := false;   UnLoadVDTool;{unload the toolset if it was loaded up by me}   	end; { of DAClose }{-------------------------------------------------------------------------------  NAME:        procedure DAAction;  PURPOSE:		Does all the real action for the NDA.  PASSED:		Code:	Integer;	Tells which action to perfrom				Param:	Longint;	(depends on Code)				  RETURNED:		NONE-------------------------------------------------------------------------------}procedure DAAction(Code: Integer; Param: Longint);label 123, 302, 303, 307, 321, 402, 403, 455, 456, 483, 1018, 1019;var   currPort: 	GrafPtr;      WhichWin:		integer;            FoundWin:		Windowptr;      FoundW:		Windowptr;            EvenPixel:	Boolean;            i,ii,j,k :    Integer;      ptX:			Integer;      ptY:			Integer;      ptxy:			Point;      FoundPHandle:	handle;      FoundCP:		controlhandle;      Temp:			signedbyte;	  Temp2:		Integer;      Byte1:		signedbyte;      Byte2:		signedbyte;            MPoint:		ptr;	  	  MyTaskRecord:	EventRecord;	  Bool:			Boolean;	  DARunLoaded:	Boolean;       beginActivateTime:=false;  case Code of      DAEvent: begin      	 currPort:=GetPort;      	 SetPort(GrafPtr(MyWindPtr));      	 WhichVMode:=BitAnd(GetMasterSCB,$0080); {Get video mode, 0=320 mode}		          Case EventRecordPtr(param)^.what of 		          	ActivateEvt: begin											if BitAnd(EventRecordPtr(param)^.modifiers,activeflag)=activeflag then					Bool:=LoadVDTool;{It's activate time, load up and start the tool set}							 	ActivateTime:=true;			 	ptx:=EventRecordPtr(param)^.where.h;			 	pty:=EventRecordPtr(param)^.where.v;			 	WhichWin:=FindWindow(FoundWin,ptx,pty);			 								if SelectMode=2 then begin					if ((ESCDefault=false) and ((VDKeyGetKDiss=-1) and (VDKeyGetNKDiss=0))) then begin												goto 321;						end;											DissSave1:=VDKeyGetKDiss;					DissSave2:=VDKeyGetNKDiss;					j:=GetDissIndex(DissSave1);					if EscDefault then DrawSlider(2,SliderX1,SliderY1,SlidePos1) {erase old slide position}						else DrawSlider(2,SliderX1,SliderY1,SliderY1+80);{erase old (loc. =6)}					SlidePos1:=SliderY1+2+(j*13);					DrawSlider(1,SliderX1,SliderY1,SlidePos1);{draw new slide pos.}					if EscDefault then DrawSlider(2,SliderX2,SliderY2,SlidePos2) {erase old slide pos.}						else DrawSlider(2,SliderX2,SliderY2,SliderY2+2);{erase old (loc. =0)}					j:=GetDissIndex(DissSave2);					SlidePos2:=SliderY2+2+(j*13);					DrawSlider(1,SliderX2,SliderY2,SlidePos2);{draw new slide position}					if ((ESCDefault=false) and ((DissSave1<>-1) or (DissSave2<>0))) then 					begin  ESCDefault:=true; end;					end;{of if SelectMode=2}				321:				if SelectMode=3 then DrawTime;				if JustOpened=false then DrawControls(myWindPtr);				if SelectMode<>11 then CtlColor:=GetKeyIndex;				if SelectMode=11 then begin					StaySame640:=true;					if JustOpened then begin						CtlColor:=GetKeyIndex;											end else DrawCSel(GetKeyIndex);					StaySame640:=false;					end;{of SelectMode=11}            	{end;}{of in my window}													{If ActOrDeact=false then begin}				if BitAnd(EventRecordPtr(param)^.modifiers,activeflag)=0 then					UnLoadVDTool; {It's deavtivate time, unload the toolset}					{ActOrDeact:=true;					end else ActOrDeact:=false;}            	End;{of ActivateEvt}            UpdateEvt: begin				Bool:=LoadVDTool;{make sure the tool is loaded and started up}				BeginUpdate(myWindPtr);				UpdateTime:=true;            	DrawTime;				UpdateTime:=false;  				if JustOpened=false then DrawControls(myWindPtr);             	JustOpened:=false;				EndUpdate(myWindPtr);				UnLoadVDTool; {now unload the toolset if we started it up}								            	end;{of UpdateEvt}                       	            KeyDown: begin            		temp:=BitAnd(LoWord(EventRecordPtr(param)^.message),$007f);								{First check to see that we are not in an error state;DDH v1.3}				if SelectMode<90 then begin										{Now check for an ESCAPE keypress}					if temp=27 then begin {Is it an ESC key?}							if EscDefault then begin {if default time}								if SelectMode=2 then begin {if video/graphics mix}							    	InitCursor;            						DrawSlider(2,SliderX1,SliderY1,SlidePos1);{erase old}            						DrawSlider(1,SliderX1,SliderY1,SliderY1+80);{draw new (loc. 6)}									DrawSlider(2,SliderX2,SliderY2,SlidePos2);{erase old}									            						DrawSlider(1,SliderX2,SliderY2,SliderY2+2);{draw new (loc.=0)}									end;{of selectmode=2}								XXKeySetKDiss(DissLevel[6]);								XXKeySetNKDiss(DissLevel[0]);								EscDefault:=false;							end else begin {else set to last changed dissolve values}								if SelectMode=2 then begin {if video/graphic mix}							    	InitCursor;   									j:=GetDissIndex(DissSave1);           							SlidePos1:=SliderY1+2+(j*13);            						DrawSlider(2,SliderX1,SliderY1,SliderY1+80);{erase old (loc. =6)}            						DrawSlider(1,SliderX1,SliderY1,SlidePos1);{draw last }									DrawSlider(2,SliderX2,SliderY2,SliderY2+2);{erase old (loc.=0)}   									j:=GetDissIndex(DissSave2);           							SlidePos2:=SliderY2+2+(j*13);            						DrawSlider(1,SliderX2,SliderY2,SlidePos2);{draw last}									end;{of selectmode=2}								XXKeySetKDiss(DissSave1);								XXKeySetNKDiss(DissSave2);								EscDefault:=true;								end; {of else}						end;{of if esc}										{Now check for an "I" keypress}					if ((temp=105) or (temp=73)) then begin {Is it an "i" or "I" key?}						if IToggle then begin								VDGGControl(InterlaceMode,Enable);									IToggle:=false;							end else begin								VDGGControl(InterlaceMode,Disable);								IToggle:=true;							end;{of else i}																		end;{of if i or I}				end;{of if SelectMode<90}					   			Case SelectMode of            		2:begin {Keypress while in Video/Graphic Mix}            			if temp=13 then begin            				HiliteControl(2,CHandle[4]);            				goto 302;            				end;            			end;            		3:begin {Keypress while in Video Adjust}            			            			if temp=13 then begin            				HiliteControl(2,CHandle[1]);            				goto 303;            				end;            			end;            		77:begin {Keypress while in Aboutbox}            			if temp=13 then begin            				HiliteControl(2,CHandle[7]);            				goto 307;            				end;            			end;            		end;            		            	end;                        	       	    Mousedown: begin				Temp2:=BitAnd((EventRecordPtr(param)^.modifiers),AppleKey);{gets open apple key?}            	ptx:=EventRecordPtr(param)^.where.h;            	pty:=EventRecordPtr(param)^.where.v;            	WhichWin:=FindWindow(FoundWin,ptX,ptY);            	WhichWin:=BitAnd(WhichWin,$7fff);            	if WhichWin = wInContent then begin            		FoundPart:=FindControl(FoundCP,ptx,pty,myWindPtr);            		case FoundPart of            	            		{Check for mousedown on control Color grid}            		0: begin            			GetMouse(Ptxy); {get point in local coord}            			ptx:=Ptxy.h;            			pty:=Ptxy.v;												{First Check for mousedown on version no. to bring up About Box}            			if SelectMode=11 then begin            				if (Pty<15) and (Pty>6) and (Ptx>115) and (Ptx<150) then begin            					EraseControl(CHandle[2]);            					EraseControl(CHandle[3]);            					EraseControl(CHandle[12]);            					SelectMode:=77;								Drawtime;            					end;            				end;														            			if SelectMode=2 then begin {in Video/Graphcis}							if EscDefault=false then begin																SlidePos1:=SliderY1+80;								DissSave1:=DissLevel[6];								SlidePos2:=SliderY2+2;								DissSave2:=DissLevel[0];								EscDefault:=true;								end;						    {**See if on left slider}            				if (Pty>(SlidePos1)) and (Pty<(SlidePos1+8))             					and (Ptx>SliderX1-10) and (Ptx<SliderX1+20) then begin            				repeat begin            					            					Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);            					GetMouse(Ptxy);            					pty:=Ptxy.v;            					If pty<=SlideMin then pty:=SlideMin+1;             					if pty>=SlideMax then pty:=SlideMax-1;            					            					DrawSlider(3,SliderX1,SliderY1,pty-5);            					for i:=0 to 1000 do j:=1;            					DrawSlider(3,SliderX1,SliderY1,pty-5);            						            					end; {of repeat}            				            				until EventRecordPtr(param)^.what = mouseup;            				If (pty>SlideMin) and (pty<SlideMax) then begin            					i:=SliderY1+14;            					for j:=0 to 6 do begin            						if pty<(i+j*13) then begin            							i:=SliderY1+2+j*13;            							goto 1018;            							end;            						end;            					1018: DrawSlider(2,SliderX1,SliderY1,SlidePos1);{erase old}            					SlidePos1:=i;            					DrawSlider(1,SliderX1,SliderY1,SlidePos1);{draw new}								DissSave1:=DissLevel[j];            					XXKeySetKDiss(DissSave1);								EscDefault:=true;            					end;            				end; {of if was on right slider}            				{**See if on right slider}            				if (Pty>(SlidePos2)) and (Pty<(SlidePos2+8))             					and (Ptx>SliderX2-20) and (Ptx<SliderX2+20) then begin            				repeat begin            					            					Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);            					GetMouse(Ptxy);            					pty:=Ptxy.v;            					If pty<=SlideMin then pty:=SlideMin+1;             					if pty>=SlideMax then pty:=SlideMax-1;            					            					DrawSlider(3,SliderX2,SliderY2,pty-5);            					for i:=0 to 1000 do j:=1;            					DrawSlider(3,SliderX2,SliderY2,pty-5);            						            					end; {of repeat}            				            				until EventRecordPtr(param)^.what = mouseup;            				If (pty>SlideMin) and (pty<SlideMax) then begin            					i:=SliderY2+14;            					for j:=0 to 6 do begin            						if pty<(i+j*13) then begin            							i:=SliderY2+2+j*13;            							goto 1019;            							end;            						end;            					1019: DrawSlider(2,SliderX2,SliderY2,SlidePos2);{erase old}            					SlidePos2:=i;            					DrawSlider(1,SliderX2,SliderY2,SlidePos2);{draw new}								DissSave2:=DissLevel[j];            					XXKeySetNKDiss(DissSave2);								EscDefault:=true;            					end;            				end; {of if was on right slider}            				end;{of if Selectmode=2}							            			if SelectMode=3 then begin						            				{Now see which arrow its on; Is it on Tint's Up arrow?}            				if (ptx>ArrowHX-10) and (ptx<ArrowHX+10) and            				   (pty>ArrowHY) and (pty<ArrowHY+11) then begin							  	repeat begin            						GetMouse(Ptxy); {get point in local coord}            						ptx:=Ptxy.h;            						pty:=Ptxy.v;						            				if (ptx>ArrowHX-10) and (ptx<ArrowHX+10) and            				   (pty>ArrowHY) and (pty<ArrowHY+11) then begin            						UpArrow(1,ArrowHX,ArrowHY);{left up arrow}									if temp2<>0 then begin										for i:=0 to 4 do VDInConvAdj(InHueAdj,AdjInc);										end;            						VDInConvAdj(InHueAdj,AdjInc);									VDInConvAdj(InHueAdj,AdjInc);									if temp2 =0 then for i:=0 to 6000 do j:=i;{if no open apple key,time delay}									UpArrow(1,ArrowHX,ArrowHY);{left up arrow}									end;            					end;{of long if}									Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);									Temp2:=BitAnd((EventRecordPtr(param)^.modifiers),$0100);{gets open apple key?}															 		until EventRecordPtr(param)^.what = mouseup;									temp2:=FlushEvents(6,0);{flush all mouse events}           						end;														if (ptx>ArrowHX-10) and (ptx<ArrowHX+10) and            				(pty>ArrowHY+11) and (pty<ArrowHY+22) then begin							  	repeat begin            						GetMouse(Ptxy); {get point in local coord}            						ptx:=Ptxy.h;            						pty:=Ptxy.v;												if (ptx>ArrowHX-10) and (ptx<ArrowHX+10) and            				(pty>ArrowHY+11) and (pty<ArrowHY+22) then begin            						DownArrow(1,ArrowHX,ArrowHY);{left down arrow}									if temp2<>0 then begin										for i:=0 to 4 do VDInConvAdj(InHueAdj,AdjDec);										end;            						VDInConvAdj(InHueAdj,AdjDec);									VDInConvAdj(InHueAdj,AdjDec);									if temp2=0 then for i:=0 to 6000 do j:=i;{time delay}									DownArrow(1,ArrowHX,ArrowHY);{left down arrow}																		end;{of repeat}								end;{of long if}									Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);									Temp2:=BitAnd((EventRecordPtr(param)^.modifiers),$0f00);{gets open apple key?}								until EventRecordPtr(param)^.what = mouseup;									temp2:=FlushEvents(6,0);{flush all mouse events}           						end;{of if}												if (ptx>ArrowCX-10) and (ptx<ArrowCX+10) and            				(pty>ArrowCY) and (pty<ArrowCY+11) then begin								repeat begin            						GetMouse(Ptxy); {get point in local coord}            						ptx:=Ptxy.h;            						pty:=Ptxy.v;												if (ptx>ArrowCX-10) and (ptx<ArrowCX+10) and            				(pty>ArrowCY) and (pty<ArrowCY+11) then begin            						UpArrow(1,ArrowCX,ArrowCY);{Color up arrow}									if temp2<>0 then begin										for i:=0 to 4 do VDInConvAdj(InSatAdj,AdjInc);										end;            						VDInConvAdj(InSatAdj,AdjInc);									VDInConvAdj(InSatAdj,AdjInc);									if temp2=0 then for i:=0 to 6000 do j:=i;{time delay}            			       		UpArrow(1,ArrowCX,ArrowCY);{Color up arrow}									end;{of long if}									end;{of repeat}									Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);									Temp2:=BitAnd((EventRecordPtr(param)^.modifiers),$0f00);{gets open apple key?}																until EventRecordPtr(param)^.what = mouseup; 									temp2:=FlushEvents(6,0);{flush all mouse events}								end;{of if}																			if (ptx>ArrowCX-10) and (ptx<ArrowCX+10) and            			(pty>ArrowCY+11) and (pty<ArrowCY+22) then begin							   repeat begin            						GetMouse(Ptxy); {get point in local coord}            						ptx:=Ptxy.h;            						pty:=Ptxy.v;											if (ptx>ArrowCX-10) and (ptx<ArrowCX+10) and            			(pty>ArrowCY+11) and (pty<ArrowCY+22) then begin            						DownArrow(1,ArrowCX,ArrowCY);{left down arrow}									if temp2<>0 then begin										for i:=0 to 4 do VDInConvAdj(InSatAdj,AdjDec);										end;            						VDInConvAdj(InSatAdj,AdjDec);									VDInConvAdj(InSatAdj,AdjDec);									If Temp2=0 then for i:=0 to 6000 do j:=i;{time delay}            			            DownArrow(1,ArrowCX,ArrowCY);{left up arrow}									end;								end;{of long if}									Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);									Temp2:=BitAnd((EventRecordPtr(param)^.modifiers),$0f00);{gets open apple key?}								until EventRecordPtr(param)^.what = mouseup;									temp2:=FlushEvents(6,0);{flush all mouse events}								end;{of if}											end; {SelectMode=3}									if SelectMode=11 then begin				Repeat begin				            			{Now see if its on the color grid}            			for k:=0 to 1 do begin            			if (ptx > (xgridmin +(k*xwide))) and (ptx < (xgridmax+ (k*xwide))) then begin            				            				for j:=0 to 7 do begin            					i:=k*8+j;            					if (pty <= (ygridmin + (j+1)*ygridtall))            					and (pty > (ygridmin + j*ygridtall)) then begin							{We now have a mousedown in grid}							ii:=BitSR(i);{div by 2}							ii:=BitSR(ii);{div by 4}														WhichVMode:=BitAnd(GetMasterSCB,$0080); {Get video mode, 0=320 mode}		 					CurPalette:=BitAnd(GetSCB(pty),$000f); {Get current palette}							if WhichVMode=0 then Color.whole:=GetColorEntry(Curpalette,i)								else begin									if i<12 then										begin											MiniPalette:=ii;											Color.whole:=GetColorEntry(Curpalette,MiniPalette);											end										else begin											MiniPalette:=i-8;											Color.whole:=GetColorEntry(CurPalette,MiniPalette);											end;									end;								ToRGB(Color.whole);{break into R,G, and B components}							RReDraw:=RedValue;							GReDraw:=GreenValue;							BReDraw:=BlueValue;							VDKeySetKCol(RedValue,GreenValue,BlueValue);{this sets the key color}            				ForceThisGrid:=true;							DrawCSel(i);{erase old and select new}            						end;{of if}            					end;{of for j}            					end;{of if}            				end;            				Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);					GetMouse(Ptxy);					pty:=Ptxy.v;					ptx:=Ptxy.h;            				end;{of repeat}            			until EventRecordPtr(param)^.what=mouseup;            				            			end;{of selectmode=11}            			end;{of case 0}            			            		{If simple button was pressed}            		2: begin             			if FoundCp=CHandle[1] then begin            				if TrackControl(ptx,pty,nil,CHandle[1]) <> 2 then goto 123;						303:{Finish up Video Adjust}							VDInConvAdj(InHueAdj,AdjSave);{Save Hue adjustment}							VDInConvAdj(InSatAdj,AdjSave);{Save Saturation adjustment}																{Restore Key color}							if WhichVMode<>0 then VDKeySetKCol(Rsave,Gsave,Bsave);            				EraseControl(CHandle[1]);            				HiliteControl(0,CHandle[1]);            				SelectMode:=11;							Drawtime;           				end;           			if FoundCp=CHandle[2] then begin           				if TrackControl(ptx,pty,nil,CHandle[2]) <> 2 then goto 123;            				402:							SelectMode:=2;							EraseControl(CHandle[2]);            				EraseControl(CHandle[3]);            				EraseControl(CHandle[12]);            											Drawtime;							            				end;            				             			if FoundCp=CHandle[3] then begin           				if TrackControl(ptx,pty,nil,CHandle[3]) <> 2 then goto 123;            				403: 							EraseControl(CHandle[2]);            				EraseControl(CHandle[3]);            				EraseControl(CHandle[12]);            				SelectMode:=3;							Drawtime;            				end;            				           				            			if (FoundCp=CHandle[4]) or (FoundCP=CHandle[5]) then begin           				if FoundCp=CHandle[4] then            					if TrackControl(ptx,pty,nil,CHandle[4]) <> 2 then goto 123;           				if FoundCp=CHandle[5] then begin           					if TrackControl(ptx,pty,nil,CHandle[5]) <> 2 then goto 123;							DissSave1:=DissCancle1;							DissSave2:=DissCancle2;							if EscDefault then begin{if normal, (not esc default dissolve)}           						XXkeySetKDiss(DissCancle1);           						XXKeySetNKDiss(DissCancle2);								end;							           					end;            		302: EraseControl(CHandle[4]);            			EraseControl(CHandle[5]);            			HiliteControl(0,CHandle[4]);            			SelectMode:=11;						Drawtime;            			end;{of 4 or 5}           			if FoundCp=CHandle[7] then begin           				if TrackControl(ptx,pty,nil,CHandle[7]) <> 2 then goto 123;            				307: EraseControl(CHandle[7]);            				HiliteControl(0,CHandle[7]);            				SelectMode:=11;							Drawtime;            				end;  			end;            			            		{If check box pressed}            		3: begin            			if FoundCp=CHandle[12] then begin           				if TrackControl(ptx,pty,nil,CHandle[12]) <> 3 then goto 123;            				SetCtlValue(1,CHandle[12]); {Check the box}							if WhichVMode=0 then Hand[148]:=4 else Hand[148]:=8;            				SetCursor(HandPtr);							IsHand:=true;																					455:							SetPort(GrafPtr(myWindPtr));							WantHand:=true;            				repeat																							ReadMouse(MMode,MStatus,ptx,pty);								WhichWin:=FindWindow(FoundWin,ptx,pty);{see if on current window}								WhichWin:=BitAnd(WhichWin,$7fff);	  							if WantHand=true then begin {want hand cursor}																						if (MyWindPtr=FoundWin) and										(((WhichWin=wIncontent) or (WhichWin=wInDrag))										or (WhichWin=wInGoAway)) then begin									{if in content region of my da}										GetMouse(ptxy);										ptx:=Ptxy.h;										pty:=Ptxy.v;										begin {bracket else}										if IsHand=true then begin											if ((pty>117) or (WhichWin=wInDrag)) or												(WhichWin=wInGoAway) then begin											InitCursor;											IsHand:=false;											pty:=200;{for when ingoaway or indrag}											end;{of > or <}										end{of IsHand true}										else begin																if (pty<117) and ((WhichWin<>wInGoAway) and										  (WhichWin<>wInDrag)) then begin											SetCursor(HandPtr);											IsHand:=true;											end;{of > <}																			end;{of else IsHand}									end;{of bracket}														end {of wIncontent} else								if IsHand=false then begin									SetCursor(HandPtr);									IsHand:=true;									end;							end;{of WantHand}    {now check for events}     	Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);								If (EventRecordPtr(param)^.what= mousedown) then            					 begin             						456:																		ptx:=EventRecordPtr(param)^.where.h;            						pty:=EventRecordPtr(param)^.where.v;            						WhichWin:=FindWindow(FoundWin,ptX,ptY);            						WhichWin:=BitAnd(WhichWin,$7fff);																		{This looks for mousedown in the GoAway box}									if (MyWindPtr=FoundWin) and (WhichWin=wInGoAway) then begin										Bool:=TrackGoAway(ptX,ptY,MyWindPtr);										if bool=true then begin											WantHand:=false;											CloseNDAbyWinPtr(MyWindPtr);											myWindOpen := false;											ptx:=FlushEvents(mUpMask+mDownMask,0);{flush out mouse events}											goto 123;										end else begin											{bool:=GetNextEvent($ffff,EventRecordPtr(param)^);}											goto 483;{of goaway}											end;										end;																		{This looks for mousedown in the drag area}									if (MyWindPtr=FoundWin) and (WhichWin=wInDrag) then									begin										{Bool := GetNextEvent($ffff,EventRecordPtr(param)^);}										DragWindow(0,ptX,ptY,8,Nil,FoundWin);										goto 483;									end;																				{Bool:=GetNextEvent($ffff,EventRecordPtr(param)^);}									            						if WhichWin = wInContent then begin            							FoundPart:=FindControl(FoundCP,ptx,pty,myWindPtr);            							If foundpart =3 then begin{if on check box}            								InitCursor;{Back to arrow cursor}            								SetCtlValue(0,CHandle[12]);            								goto 123;            								end;{of foundpart=3}										if foundpart=2 then begin {if on button}											if FoundCp=CHandle[2] then begin												If TrackControl(ptx,pty,nil,CHandle[2])=2 then begin													InitCursor;													SetCtlValue(0,CHandle[12]);													WantHand:=false;													goto 402;													end else goto 455;												end;{of FoundCp}											if FoundCp=CHandle[3] then begin {if on Video Adj.}												If TrackControl(ptx,pty,nil,CHandle[3])=2 then begin													InitCursor;													SetCtlValue(0,CHandle[12]);													WantHand:=false;													goto 403;													end else goto 455;												end;{of FoundCp=CHandle[3]}																							end;{of foundpart=2}										end;{of wInContent}																											{Else pickup the color from the screen}            						            					            						EvenPixel:=BitAnd($0001,ptx)=0;	            						if WhichVMode<>0 then ptx:=BitSR(ptx);            						ptx:=BitSR(ptx);            						pty:=pty-2;            						if pty<0 then pty:=0;            						    								LongOne:=$e12000+ptx+(pty*$00a0);            						MPoint:=Pointer(LongOne);            						ptx:=Mpoint^;    						            						ptx:=BitAnd($000f,ptx);																											CurPalette:=BitAnd($000f,GetSCB(pty));									pty:=ptx; {save ptx at pty for DrawCSel below}									            						WhichVMode:=BitAnd(GetMasterSCB,$0080); {Get video mode, 0=320 mode}            							if WhichVMode<>0 then begin{640 mode}            							            								if EvenPixel then begin            									ptx:=BitAnd($0003,ptx);            							 		ptx:=ptx+4;            							 		end            								 else begin            							 		ptx:=BitAnd($000C,ptx);            							 		ptx:=BitSR(ptx);            							 		ptx:=BitSR(ptx);            							 		end;            								end;{of 640}            						            						Color.whole:=GetColorEntry(CurPalette,ptx);									MiniPalette:=ptx;{save so we know which palette}																		ToRGB(Color.whole);{break apart into R, G, and B components}									RReDraw:=RedValue;									GReDraw:=GreenValue;									BReDraw:=BlueValue;									VDKeySetKCol(RedValue,GreenValue,BlueValue);{this sets the key color}            						ForceThisGrid:=true;{force this particular grid}									DrawCSel(pty);{--------update color grid------}								end;{if mousedown}         														483:									MyTaskRecord.TaskMask:=2;{just handle updates}									ptx:=taskmaster($fffd,MyTaskRecord);         						until WantHand=false;            				end;             			 end;                        				            			end;            			end;            			end;            			end;      	 123: SetPort(currPort);      	 end;		 {-----------------------------------------------------------------------------------------}{ DARun:																				  }{-----------------------------------------------------------------------------------------}      DARun: begin         currPort := GetPort;         SetPort(GrafPtr(myWindPtr));		 DARunLoaded:=false;		 if WeLoadedIt=false then begin		 	Bool:=LoadVDTool;{load up and start the toolset if its not already}			DARunLoaded:=true;			end;{of if WeLoadedIt}		 if JustOpened2=false then begin			if SelectMode=2 then begin				if ((LastKDiss<>VDKeyGetKDiss) or (LastNKDiss<>VDKeyGetNKDiss)) then					begin										LastKDiss:=VDKeyGetKDiss;					LastNKDiss:=VDKeyGetNKDiss;					j:=GetDissIndex(LastKDiss);					DrawSlider(2,SliderX1,SliderY1,SlidePos1); {erase old slide position}					if ESCDefault=false then DrawSlider(2,SliderX1,SliderY1,SliderY1+80);{erase old (loc. =6)}					SlidePos1:=SliderY1+2+(j*13);					DrawSlider(1,SliderX1,SliderY1,SlidePos1);{draw new slide pos.}					DrawSlider(2,SliderX2,SliderY2,SlidePos2); {erase old slide pos.}					if ESCDefault=false then DrawSlider(2,SliderX2,SliderY2,SliderY2+2);{erase old (loc. =0)}										j:=GetDissIndex(LastNKDiss);					SlidePos2:=SliderY2+2+(j*13);					DrawSlider(1,SliderX2,SliderY2,SlidePos2);{draw new slide position}					if ((ESCDefault=false) and ((VDKeyGetKDiss<>-1) or (VDKeyGetNKDiss<>0))) then 					begin  ESCDefault:=true; end;					end;{of checking dissSave values}									end;{of if SelectMode=2}          If SelectMode=11 then		  	begin								if ((RReDraw<>VDKeyGetRCol) or ((GReDraw<>VDKeyGetGCol) or (BReDraw<>VDKeyGetBCol)))				then					begin						DrawCgrid;						StaySame640:=true;   						DrawCSel(CtlColor);						StaySame640:=false;						RReDraw:=VDKeyGetRCol;						GReDraw:=VDKeyGetGCol;						BReDraw:=VDKeyGetBCol;					end;								end;			end else begin								JustOpened2:=false;{This prevents redrawing when just opening}				RReDraw:=VDKeyGetRCol;				GReDraw:=VDKeyGetGCol;				BReDraw:=VDKeyGetBCol;								end;		 if DARunLoaded then begin		 	UnloadVDTool;{only unload if DARun loaded it}			WeLoadedIt:=false;		 	end;         SetPort(currPort);         end;      DACursor: begin		end;{DACursor}      DAMenu: begin         { HiWord(param) is MenuID           LoWord(param) is ItemID }         end;      DAUndo,      DACut,      DACopy,      DAPaste,      DAClear:  Code := 1;	end;end; { of DAAction }{-------------------------------------------------------------------------------  NAME:        procedure DAInit;  PURPOSE:		Performs the initilization phase of the NDA.  PASSED:		Code:	Integer;	(=0, DeskShutDown call, <>0, DeskStartUp)  RETURNED:		NONE-------------------------------------------------------------------------------}procedure DAInit(Code: Integer);Var TLError,j,i:	integer;	Bool:			boolean;begin   SelectMode:=11;      with myWind do begin      param_length := sizeof(NewWindowParamBlk);      wFrame       := $C0A0;      wTitle       := @'VideoMix';      wRefCon      := 0;      wZoom.top    := 0;      wZoom.left   := 0;      wZoom.bottom := 0;      wZoom.right  := 0;      wColor       := nil;      wYOrigin     := 0;      wXOrigin     := 0;      wDataH       := 0;      wDataW       := 0;      wMaxH        := 0;      wMaxW        := 0;      wScrollVer   := 0;      wScrollHor   := 0;      wPageVer     := 0;      wPageHor     := 0;      wInfoRefCon  := 0;      wInfoHeight  := 0;      wFrameDefProc:= nil;      wInfoDefProc := nil;      wContDefProc := nil;      wPosition.top    := 30;      wPosition.left   := 10;      wPosition.bottom := 184;      wPosition.right  := 175;      wPlane       := -1;      wStorage     := nil;      end;   if Code = 0 then begin   { A DeskShutDown Call, chk that my window is closed }      if myWindOpen then DAClose;		UnLoadVDTool;{unload the toolset if we loaded it last}	end   else begin   { A DeskStartUp Call, init myWindOpen flag }	  WeLoadedIt:=false;{initialize flag that we didn't load it}	  WeStartedIt:=false;{initialize flag that we didn't start it}	{--ver 1.2 fix, put all VD tool calls into block to execute only if loaded ok--}	  	  if LoadVDTool then begin{load up the VD tool set if its not already loaded}      	CtlColor:=GetKeyIndex;	  	{Init. R,G,B ReDraw to what currently the card is set to}			RReDraw:=VDKeyGetRCol;			GReDraw:=VDKeyGetGCol;			BReDraw:=VDKeyGetBCol;		end;{--ver 1.2 fix, move all VD tool calls within this block--}		UnLoadVDTool;{unload the toolset if we loaded it last}      myWindOpen := false;            {Initialize Values and pointers}      	  UpdateTime:=false;	  ActivateTime:=false;	  	  StaySame640:=false;	  ForceThisGrid:=true;	  Itoggle:=true;	  ActOrDeAct:=true;	        {Now Init Hand Cursor}	Hand[1]:=18;{slices}	Hand[2]:=4;{words wide}	Hand[147]:=1;{hot spot (was 2)}	Hand[148]:=6;		StuffHex(@Hand[3],'0000000000000000');{START OF CURSOR IMAGE}	StuffHex(@Hand[7],'0000F00000000000');	StuffHex(@Hand[11],'000F0F0000000000');	StuffHex(@Hand[15],'000F0F0000000000');	StuffHex(@Hand[19],'000F0F0000000000');	StuffHex(@Hand[23],'00FF0F0000000000');	StuffHex(@Hand[27],'0F0F0FF0F0F00000');	StuffHex(@Hand[31],'0F0F0F0F0F0F0000');	StuffHex(@Hand[35],'0F0F0000000F0000');	StuffHex(@Hand[39],'0F0F0000000F0000');	StuffHex(@Hand[43],'0F000000000F0000');	StuffHex(@Hand[47],'0F000000000F0000');	StuffHex(@Hand[51],'0F000000000F0000');	StuffHex(@Hand[55],'00F0000000F00000');	StuffHex(@Hand[59],'00FFFFFFFF000000');	StuffHex(@Hand[63],'00FFFFFF0F000000');	StuffHex(@Hand[67],'00FFFFFFFF000000');	StuffHex(@Hand[71],'0000000000000000');{END OF CURSOR IMAGE}		StuffHex(@Hand[75],'0000F00000000000');{START OF CURSOR MASK}	StuffHex(@Hand[79],'000FFF0000000000');	StuffHex(@Hand[83],'00FFFFF000000000');	StuffHex(@Hand[87],'00FFFFF000000000');	StuffHex(@Hand[91],'00FFFFF000000000');	StuffHex(@Hand[95],'0FFFFFF000000000');	StuffHex(@Hand[99],'FFFFFFFFFFFF0000');	StuffHex(@Hand[103],'FFFFFFFFFFFFF000');	StuffHex(@Hand[107],'FFFFFFFFFFFFF000');	StuffHex(@Hand[111],'FFFFFFFFFFFFF000');	StuffHex(@Hand[115],'FFFFFFFFFFFFF000');	StuffHex(@Hand[119],'FFFFFFFFFFFFF000');	StuffHex(@Hand[123],'FFFFFFFFFFFFF000');	StuffHex(@Hand[127],'0FFFFFFFFFFF0000');	StuffHex(@Hand[131],'0FFFFFFFFFF00000');	StuffHex(@Hand[135],'0FFFFFFFFFF00000');	StuffHex(@Hand[139],'0FFFFFFFFFF00000');	StuffHex(@Hand[143],'0FFFFFFFFFF00000');{END OF CURSOR MASK}	HandPTR:=@Hand[1];		      end;end; { of DAInit }{-------------------------------------------------------------------------------  NAME:        procedure MakeCtrls;  PURPOSE:		Makes the controls for the NDA.		  PASSED:		NONE  RETURNED:		NONE-------------------------------------------------------------------------------}procedure MakeCtrls;var   i,ll: 	integer;      kk,CheckBox:	ptr;begin   CheckBox:=Pointer($02000000);   ll:=0;{--Do Buttons--}   kk:=Pointer($00000000);{Button type control}      SetRect(RectPtrX,58,131,0,0);   Chandle[1]:=NewControl(myWindPtr,RectPtrX,'OK',129,0,0,100,kk,ll,nil);   SetRect(RectPtrX,4,120,161,134);   Chandle[2]:=NewControl(myWindPtr,RectPtrX,'Video/Graphics Mix',128,0,0,100,kk,ll,nil);   SetRect(RectPtrX,4,137,161,151);   Chandle[3]:=NewControl(myWindPtr,RectPtrX,'Video Adjust',128,0,0,100,kk,ll,nil);   SetRect(RectPtrX,102,131,0,0);   Chandle[4]:=NewControl(myWindPtr,RectPtrX,'OK',129,0,0,100,kk,ll,nil);   SetRect(RectPtrX,11,131,0,0);   Chandle[5]:=NewControl(myWindPtr,RectPtrX,'Cancel',128,0,0,100,kk,ll,nil);{--Check Box Control for Pick from Screen--}   SetRect(RectPtrX,12,103,0,0);   chandle[12]:=NewControl(myWindPtr,RectPtrX,'Pick from Screen',128,0,0,0,CheckBox,ll,nil);{--Aboutbox Button--}   kk:=Pointer($00000000);   SetRect(RectPtrX,58,131,0,0);   Chandle[7]:=NewControl(myWindPtr,RectPtrX,'OK',129,0,0,100,kk,ll,nil);       {DrawControls(myWindPtr);}  DissLevel[0]:=0;  DissLevel[1]:=5462;  DissLevel[2]:=16384;  DissLevel[3]:=27308;  DissLevel[4]:=38230;  DissLevel[5]:=49152;  DissLevel[6]:=60075;  DissLevel[7]:=65535;      end; { of MakeCtrls }{-------------------------------------------------------------------------------  NAME:        procedure DrawTime;    PURPOSE:     	Draws the text and the controls.  PASSED:		NONE  				(Note: SelectMode determines what to draw)  RETURNED:		NONE-------------------------------------------------------------------------------} procedure DrawTime; Var I,J:	Integer; begin	if (ActivateTime=false) and (UpdateTime=false) then begin		SetRect(RectPtrX,1,1,Width2,Height2);		EraseRect(RectPtrX);		end;      Case SelectMode of   	11:begin {Draw First Screen (Standard Colors Selection)} 		      	MoveTo(15,14);   		DrawString('KEY COLOR         v1.3');   		MoveTo (15,16);   		LineTo (148,16);   		SetRect(RectPtrX,3,2,162,117);   		SetPenSize(4,2);					FrameRect(RectPtrX);		SetPenSize(1,1);      		DrawCgrid;		StaySame640:=true;   		DrawCSel(CtlColor);		StaySame640:=false;   		ShowControl(CHandle[2]);   		ShowControl(CHandle[3]);   		ShowControl(CHandle[12]);      		end;      	2:begin {Video/Graphics Mix Screen}      	MoveTo(12,14);   		DrawString('VIDEO/GRAPHICS MIX');   		MoveTo (12,16);   		LineTo (151,16); {draw underline}   		MoveTo (22,27);   		DrawString('Key            Non-Key');   		MoveTo(53,41);   		DrawString('Graphics');   		MoveTo(64,119);   		DrawString('Video');   		j:=0;   			For I:=0 to 6 do begin   				MoveTo(SliderX1+18,SliderY1+6+J);   				LineTo(SliderX1+23,SliderY1+6+J);   				MoveTo(SliderX2-9,SliderY2+6+J);   				LineTo(SliderX2-14,SliderY2+6+J);   				j:=j+13;   				end;   	{---First determine dissolve value---}		DissCancle1:=DissSave1;		DissCancle2:=DissSave2;		{determine new slider position}   			j:=GetDissIndex(VDKeyGetKDiss);            SlidePos1:=SliderY1+2+(j*13);			   		DrawSlider(0,SliderX1,SliderY1,SlidePos1);{init. the sliders}		    j:=GetDissIndex(VDKeyGetNKDiss);            SlidePos2:=SliderY2+2+(j*13);   		DrawSlider(0,SliderX2,SliderY2,SlidePos2);   		{Now draw the dark border}   		SetRect(RectPtrX,3,2,162,152);   		SetPenSize(4,2);					FrameRect(RectPtrX);		SetPenSize(1,1);         		ShowControl(CHandle[4]);      		ShowControl(CHandle[5]);      		end;			      	3:begin {Video Adjust Screen}		if UpdateTime=false then begin							Rsave:=VDKeyGetRCol;{first save key color}				Gsave:=VDKeyGetGCol;				Bsave:=VDKeyGetBCol;						if WhichVMode<>0 then begin			{Now see if we should select White or black as the key color}			if (Rsave=-4096) and (Gsave=-4096) and (Bsave=-4096) then begin {is it white?}				VDKeySetKCol($f000,$f000,$f000);{Set key color to white}				DoWhite:=true;			end else begin {it should be set to black}				VDKeySetKCol(0,0,0);{Set key color to black}				DoWhite:=false;				end;							end;{of WhichVMode}		end;{of updatetime}      	MoveTo(15,14);   		DrawString('VIDEO ADJUST');   		MoveTo (15,16);   		LineTo (148,16);   		MoveTo (19,98);   		DrawString('Tint               Color');   		SetRect(RectPtrX,3,2,162,152);   		SetPenSize(4,2);					FrameRect(RectPtrX);		SetPenSize(1,1);	{Now paint the control color rect}		SetRect(RectPtrX,13,20,152,88);   		if WhichVMode=0 then SetDithColor(GetKeyIndex);		if WhichVMode<>0 then begin			if DoWhite=true then SetDithColor(15) else SetDithColor(0);			end;		   		PaintRect(RectPtrX); {paint the control color}		   		SetDithColor(0);		if ActivateTime=false then begin			UpArrow(0,ArrowHX,ArrowHY);{left up arrow}			UpArrow(0,ArrowCX,ArrowCY);{right down arrow}			DownArrow(0,ArrowHX,ArrowHY);{left down arrow}			DownArrow(0,ArrowCX,ArrowCY);{right down arrow}			end;		if ActivateTime=false then      			ShowControl(CHandle[1]);      		end;{3}						      	77:begin {About Box}		SetRect(RectPtrX,3,2,162,152);   		SetPenSize(4,2);					FrameRect(RectPtrX);		SetPenSize(1,1);      	MoveTo(13,14);   		DrawString('Designed By: Dan,');   		   		MoveTo (13,24);   		DrawString('Michael,and Eileen');   		MoveTo (13,26);   		LineTo (150,26);   		MoveTo(13,37);   		DrawString('Version: 1.3');   		MoveTo (13,39);   		LineTo (150,39);   		MoveTo(13,50);   		DrawString('Copyright 1988-91');   		MoveTo(13,60);   		DrawString('Apple Computer, Inc.');   		MoveTo(13,62);   		LineTo(148,62);   		MoveTo(13,73);		DrawString('Copyright 1987');		MoveTo(13,83);		DrawString('TML Systems, Inc.');		MoveTo(13,93);   		DrawString('Certain portions of');   		MoveTo(13,103);   		DrawString('this software are');   		MoveTo(13,113);   		DrawString('copyrighted by');   		MoveTo(13,123);   		DrawString('TML Systems, Inc.');   		   		ShowControl(CHandle[7]);   		end; {of case 77}      		      	98:begin {Tool Error Screen (No Pokey card found)}      		MoveTo(13,14);   			DrawString('ERROR:');   			MoveTo (13,16);			LineTo(150,16);   			MoveTo (13,26);   			DrawString('No Card found');   			end; {of case 99}      		      	99:begin {Tool Error Screen}      		MoveTo(13,14);   			DrawString('ERROR:');   			MoveTo (13,16);			LineTo(150,16);   			MoveTo (13,26);   			DrawString('TOOL033 not found or');   			MoveTo(13,36);   			DrawString('not enough memory.');   			end; {of case 99}    	end;   		   end; {DrawTime}{-------------------------------------------------------------------------------  NAME:        	XXKeySetKDiss  PURPOSE:     	Calls VDKeySetKDiss and remembers dissolve value at LastKDiss.    PASSED:		KDissolve:	integer;	(dissolve value you want set at)  RETURNED:		NONE-------------------------------------------------------------------------------}procedure XXKeySetKDiss(KDissolve: integer);begin	VDKeySetKDiss(KDissolve);	LastKDiss:=VDKeyGetKDiss;end;{-------------------------------------------------------------------------------  NAME:        	XXKeySetNKDiss  PURPOSE:     	Calls VDKeySetNKDiss and remembers dissolve value at LastNKDiss.    PASSED:		NKDissolve:	integer;	(dissolve value you want set at)  RETURNED:		NONE-------------------------------------------------------------------------------}procedure XXKeySetNKDiss(NKDissolve: integer);begin	VDKeySetNKDiss(NKDissolve);	LastNKDiss:=VDKeyGetNKDiss;end;{-------------------------------------------------------------------------------  NAME:        (Main Program)  PURPOSE:     (not needed for NDA's)  PASSED:		NONE  RETURNED:		NONE-------------------------------------------------------------------------------}beginend.