********************************************  Apple IIgs Installer**  Date and Version*******************************************	MACRO&lab	InstallerVersion	dc.b @WXYZ-*-1	dc.b 'v2.1    '@WXYZ	MEND	MACRO&lab	InstallerDate	dc.b ' 2 Apr 93';;;	SystemDate	MEND	MACRO&lab	SYSTEMDATE&lab	LCLC &EIB	; declare a temporary var to hold current string setting&EIB	SETC &SETTING('STRING') ; put	current string	setting into temp	STRING ASIS	; Set string type to ASIS.	DC.B '&SysDate' ; make the string	STRING &EIB	; restore orig	string settings	MEND