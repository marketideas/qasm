me	ds TimeRec	; TimeRec -optionList	ds.b 4	; Long -eof	ds.b 4	; Long -blocksUsed	ds.b 4	; Long - must be 0 for SetFileInforesourceEOF	ds.b 4	; Long - must be 0 for SetFileInforesourceBlocks	ds.b 4	; Long - must be 0 for SetFileInfo	EndR; Volume call Parameter Table DefinitionVolumeRecGS	Record 0pCount	ds.b 2	; Word - devName	ds.b 4	; GSString32Ptr - volName	ds.b 4	; ResultBuf255Ptr - totalBlocks	ds.b 4	; Long - freeBlocks	ds.b 4	; Long - fileSysID	ds.b 2	; Word - blockSize	ds.b 2	; Word - 	EndR