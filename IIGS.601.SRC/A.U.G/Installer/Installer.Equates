criptSourcePfxPtr	equ ScriptHandle+4	; 50 Pointer to script's source prefix.SourcePtr	equ SourcePfxPtr+4	; 54 Pointer to full source pathnameDestPtr	equ SourcePtr+4	; 58 Pointer to full destination pathnameScriptFilename	equ DestPtr+4	; 5C Pointer to script’s prefixDiskNamesHdl	equ ScriptFilename+4 ;60 Handle to DiskNames resourceDiskNamesPtr	equ DiskNamesHdl+4	; 64 Pointer to DiskNames resourceOurChar	equ DiskNamesPtr+4	; 68 1 byte for NoCaseCompare8bit (Subroutines.asm)	Eject;................................................................; GS/OS equatesGSOS	equ $E100A8	; GS/OS entry pointCreate	equ $2001	; GS/OS system call numbersDestroy	equ $2002OS_ShutDown	equ $2003Set_File_Info	equ $2005Get_File_Info	equ $2006Volume	equ $2008Set_Prefix	equ $2009Get_Prefix	equ $200ASet_Sys_Pref	equ $200CExpand_Path	equ $200EGet_Sys_Pref	equ $200FOpen	equ $2010Read	equ $2012Write	equ $2013Close	equ $2014Get_EOF	equ $2019Set_Level	equ $201AGet_Level	equ $201BGet_Dir_Entry	equ $201CGet_Dev_Num	equ $2020Format	equ $2024EraseDisk	equ $2025Get_Boot_Vol	equ $2028Quit	equ $2029Get_Version	equ $202AD_Info	equ $202CD_Status	equ $202DD_Control	equ $202ED_Write	equ $2030; GS/OS error codesInvalidDevNum	equ $11drvrIOError	equ $27	; I/O error (unformatted disk?)WriteProtected	equ $2BPathSyntax	equ $40PathNotFound	equ $44VolumeNotFound	equ $45FileNotFound	equ $46DupPathname	equ $47EndOfFile	equ $4CinvalidAccess	equ $4EBufferTooSmall	equ $4FFileIsOpen	equ $50NotProDOSDisk	equ $52DuplicateVolume	equ $57EndOfDir	equ $61QInitIt	equ $96	; query for ErrorWindow: Initialize it?QInitFormatted	equ $97	; query for ErrorWdw: Disk is formatted but...; Device characteristics definitionReadAllowed	equ %0000000000100000WriteAllowed	equ %0000000001000000BlockDevice	equ %0000000010000000; File system IDs for formattingproDOSfsID EQU $0001  ; ProDOS/SOS ; Format (OS call) flagsfFormatEdit	equ $8000	; bit 15: name is editablefFormatSelect	equ $4000	; bit 14: all file systems are selectable; D_Info call device IDD_5_25Drive	equ $0000	; Apple 5.25 drive (includes UniDisk, DuoDisk, Disk II)D_3_5Drive	equ $0003	; Apple 3.5 drive (includes UniDisk 3.5); maximum volume name length: ProDOS 15, ProDOS 27MaxPrefixLen	equ 27	Eject;................................................................; Tool call equatesToolLocator	equ $E10000		; Tool LocatorTLStartup	equ $0201TLShutDown	equ $0301TLTextMountVolume	equ $1201MessageCenter	equ $1501StartUpTools	equ $1801ShutDownTools	equ $1901		; Memory ManagerMMStartup	equ $0202MMShutDown	equ $0302NewHandle	equ $0902DisposeHandle	equ $1002DisposeAll	equ $1102GetHandleSize	equ $1802SetHandleSize	equ $1902FindHandle	equ $1A02FreeMem	equ $1B02MaxBlock	equ $1C02CompactMem	equ $1F02HLock	equ $2002HUnlock	equ $2202SetPurge	equ $2402BlockMove	equ $2B02		; Miscellaneous ToolsSysFailMgr	equ $1503SysBeep	equ $2C03SysBeep2	equ $3803		; QuickDraw IIGetMasterSCB	equ $1704SetPort	equ $1B04GetPort	equ $1C04GetPortRect	equ $2004ClipRect	equ $2604SetPenSize	equ $2C04SetPenMode	equ $2E04SetPenPat	equ $3004PenNormal	equ $3604SetSolidPenPat	equ $3704SetSolidBackPat	equ $3804MoveTo	equ $3A04Move	equ $3B04FrameRect	equ $5304PaintRect	equ $5404EraseRect	equ $5504InvertRect	equ $5604HideCursor	equ $9004ShowCursor	equ $9104GetFontInfo	equ $9604SetTextFace	equ $9A04SetTextMode	equ $9C04SetForeColor	equ $A004SetBackColor	equ $A204DrawString	equ $A504DrawText	equ $A704StringWidth	equ $A904TextWidth	equ $AB04InitCursor	equ $CA04		; Desk ManagerGetNumNDAs	equ $1B05CloseAllNDAs	equ $1D05FixAppleMenu	equ $1E05		; Event ManagerGetNextEvent	equ $0A06GetMouse	equ $0C06WaitMouseUp	equ $0F06TickCount	equ $1006GetDblTime	equ $1106FlushEvents	equ $1506SetEventMask	equ $1806		; Integer MathMultiply	equ $090BInt2Hex	equ $220BHex2Int	equ $240BHex2Long	equ $250BInt2Dec	equ $260BDec2Int	equ $280B		; Window ManagerNewWindow	equ $090ECloseWindow	equ $0B0EFrontWindow	equ $150ETaskMaster	equ $1D0EBeginUpdate	equ $1E0EEndUpdate	equ $1F0EGetWKind	equ $2B0EValidRect	equ $3C0EInvalRect	equ $3A0ENewWindow2	equ $610EErrorWindow	equ $620EDoModalWindow	equ $640EHandleDiskInsert	equ $6B0E		; Menu ManagerGetMenuBar	equ $0A0FDeleteMItem	equ $100FSetSysBar	equ $120FFixMenuBar	equ $130FCalcMenuSize	equ $1C0FSetMenuFlag	equ $1F0FDrawMenuBar	equ $2A0FHiLiteMenu	equ $2C0FEnableMItem	equ $300FDisableMItem	equ $310FSetMenuBar	equ $390FSetMItemName	equ $3A0FInsertMItem2	equ $3F0FNewMenuBar2	equ $430FInsertPathMItems	equ $500F		; Control ManagerNewControl	equ $0910HideControl	equ $0E10ShowControl	equ $0F10DrawControls	equ $1010HiliteControl	equ $1110FindControl	equ $1310TrackControl	equ $1510SetCtlValue	equ $1910GetCtlValue	equ $1A10SetCtlParams	equ $1B10SetCtlAction	equ $2010SetCtlRefCon	equ $2210DrawOneCtl	equ $2510MakeNextCtlTarget	equ $2710SendEventToCtl	equ $2910GetCtlHandleFromID	equ $3010SetCtlParamPtr	equ $3410		; System LoaderUnloadSeg	equ $0E11lGetOPathName2	equ $2211		; QuickDraw AuxilaryCopyPixels	equ $0912WaitCursor	equ $0A12DrawIcon	equ $0B12GetSysIcon	equ $0F12		; Line EditLETextBox2	equ $2014		; Dialog ManagerCloseDialog	equ $0C15ModalDialog	equ $0F15Alert	equ $1715StopAlert	equ $1815ParamText	equ $1B15GetControlDItem	equ $1E15GetIText	equ $1F15GetNewModalDialog	equ $3215		; List ManagerNextMember	equ $0F1CDrawMember2	equ $111CNextMember2	equ $121CSelectMember2	equ $141CSortList2	equ $151CNewList2	equ $161C		; Resource ManagerResourceShutDown	equ $031EOpenResourceFile	equ $0A1ECloseResourceFile	equ $0B1ELoadResource	equ $0E1EReleaseResource	equ $171E	Eject;................................................................; Miscellaneous Tool Error CodesmesNotFoundErr	equ $0111	; Message center message not found.;................................................................; Miscellaneous misc. EquatesdoneBeep	equ $4005	; beep by default, oper. complete, defer to GetNextEvent; Miscellaneous Memory Manager Equates; attrBank	equ $0001	; Handle Attribute Bits - 1 = fixed bank  ; attrPage	equ $0004	; Handle Attribute Bits - 1 = page alignedattrNoCross	equ $0010	; Handle Attribute Bits - 1 = no bank boundary crossing; attrFixed	equ $4000	; Handle Attribute Bits - 1 = not movableattrLocked	equ $8000	; Handle Attribute Bits - 1 = lockedpurgeLevel3	equ $0003	; Indicates memory will be 1st purgeddisposeNow	equ $FFFF	; dispose resource handle (ReleaseResource) now;................................................................; Event Misc. EquatesMessage	equ  2	; Offset to message in event recordModifiers	equ 14	; Offset to modifiers in event recordKeyDownEvent	equ $0003	; Event codebtn1State	equ $0040	; Event/Task Modifiers: set if btn 1 upbtn0State	equ $0080	;   set if button 0 upappleKey	equ $0100	;   set if Apple key downshiftKey	equ $0200	;   set if shift key downcapsLock	equ $0400	;   set if caps lock key downoptionKey	equ $0800	;   set if option key downcontrolKey	equ $1000	;   set if Control key downkeyPad	equ $2000	;    set if keypress from key padkeyDownMask	equ $0008autoKeyMask	equ $0020deskAccMask	equ $0400; Control Misc. EquatesrecSize	equ $000C	; DefProc - Return record size command.; Control Record OffsetsoctlRect	equ $08	; Rect    - CtlRec - Enclosing rectangle.octlHilite	equ $11	; Byte    - CtlRec - Active/Inactive & hiliting flagoctlValue	equ $12	; Integer - CtlRec - Control's value.octlData	equ $1C	; Longint - CtlRec - Reserved for CtrlProc's use.octlRefCon	equ $20	; Longint - CtlRec - Reserved for application's use.octlColor	equ $24	; Pointer - CtlRec - Pointer to appropriate color table.; Part codes for the Control ManagerSimpleButton	equ 2	; highlighted button ("active" is unhighlighted)UpArrow	equ 5DownArrow	equ 6PageUp	equ 7PageDown	equ 8Thumb	equ 129;................................................................; Item definitions for the Dialog ManagerButtonItem	equ $000AStatText	equ $000FLongStatText	equ $0010EditLine	equ $0011IconItem	equ $0012UserItem	EQU $0014LongStatText2	equ $0016ItemDisable	equ $8000;................................................................; EventMask and TaskMask equatesemDeskAcc	equ %0000010000000000emActivate	equ %0000000100000000emUpdate	equ %0000000001000000emAutoKey	equ %0000000000100000emKeyDown	equ %0000000000001000emMouseUp	equ %0000000000000100emMouseDown	equ %0000000000000010tmContentControls	equ %0000000000000001   ; TaskMask+2 bit definitionstmControlKey	EQU %0000000000000010tmInfo	equ %1000000000000000   ; TaskMask bit definitionstmInactive	equ %0100000000000000tmCReDraw	equ %0010000000000000tmSpecial	equ %0001000000000000tmContent	equ %0000000010000000tmDragW	equ %0000000001000000tmSysClick	equ %0000000000100000tmOpenNDA	equ %0000000000010000tmMenuSel	equ %0000000000001000tmFindW	equ %0000000000000100tmUpdate	equ %0000000000000010tmMenuKey	equ %0000000000000001	eject; Event and Task what field valuesmouseDownEvt EQU $0001;................................................................; Window manager equatesErrorW_Pascal	equ $0001;................................................................; Menu manager equates; for SetMenuFlagenableMenu	equ $FF7FdisableMenu	equ $0080;................................................................; Resource equatesrIcon	equ $8001	; resourceTyperControlTemplate	equ $8004rWindParam1	equ $800EScriptListCtl	equ $030C	; ctlIDPopUpMenuID	equ $000EFirstItemID	equ $0001	; menu item in popup for top itemrListFlags	equ $12rListMoreFlags	equ $14rListRefCon	equ $16rListSize	equ $1ArListView	equ $1CrListType	equ $1ErListStart	equ $20rListDraw	equ $22rListMemHeight	equ $26rListMemSize	equ $28rListRef	equ $2ArListColorRef	equ $2Ep1ContDefProc	equ $3ArIconStopID	equ $07FF0002	; stop sign in Sys.ResourcesrIconNoteID	equ $07FF0003	; talking headrIconCautionID	equ $07FF0004	; caution sign; Equates associated with the Standard Update superScript resourcerStdUpdateScript	equ $0001	; Resource type for our StdUpdateScriptStdUpdateScriptID	equ $00000001	; Resource ID for our StdUpdateScript; Equates associated with the DiskNames resourcesrDiskNames	equ $0002	; Resource type for DiskNames resourceDiskNames	equ $00000001	; Resource ID for DiskNames resource	eject;................................................................; Script Definitions; Suggestion: if you add a flag to ScriptFlag field, validate it in CompactScriptScriptVerField	equ 9	; ScriptVersion field location in scriptScriptFlagField	equ 15	; ScriptFlags field	location in scriptScriptFlagPrvtBoot  equ 18	; loc of PreventBoot flag in scriptScriptFlagEnd	equ $0d0d	; 2 cr’s indicate end of Flag fieldScriptHelpEnd	equ '\\'	; Designates end of ScriptHelp fieldHighestParent	equ 9 	; valid values of ScriptParentLevel: 0-9;................................................................; Customized Installation Pseudo Dialog Box - Dimensions;	  NOTE: Height and Width can be changed	and the; 	        resulting box will still be centered and;	        all of the controls will be within the box,;	        however, overlapping controls may appear;	        if the box is too small.; WARNING!  MANY OF THESE EQUATES MUST BE DUPLICATED IN THE RESOURCE;           DEFINITION WHICH DOESN'T RECOGNIZE ASSEMBLER SYNTAX!Width	equ 636Height	equ 142Top	equ 105-Height/2Left	equ 320-Width/2Bottom	equ Top+HeightRight	equ Left+WidthButtonLeft	equ 272	; Left side of the "center" buttonsButtonWidth	equ 100	; Width of the buttonsAppWindowLeft	equ Width-256	; Left side of Application Selection window;;;RightMargin	equ 0	; Right margin for buttons below app window;................................................................; Easy Update Window - Dimensions; WARNING!  MANY OF THESE EQUATES MUST BE DUPLICATED IN THE RESOURCE;           DEFINITION WHICH DOESN'T RECOGNIZE ASSEMBLER SYNTAX!eWidth	equ 496eHeight	equ 115eTop	equ 105-eHeight/2eLeft	equ 320-eWidth/2eBottom	equ eTop+eHeighteRight	equ eLeft+eWidth;................................................................; Menu EquatesAppleMenuID	equ 1FileMenuID	equ 2EditMenuID	equ 3HelpMenuID	equ 4UndoItemID	equ 250	; These next 6 are standard andCutItemID	equ 251	; required for DA support underCopyItemID	equ 252	; TaskMaster.PasteItemID	equ 253ClearItemID	equ 254CloseWItemID	equ 255AboutItemID	equ $100	; These are our own	responsibilityQuitItemID	equ $101ShortcutsItemID	equ $103EraseDiskItemID	equ $104HelpItemID	equ $105CreatingItemID	equ $106UpdatingItemID	equ $107HardDiskItemID	equ $108ItemChar	equ ' 'EndOfMenu	equ '.'	Eject;................................................................; internal data word for keeping ScriptFlags with each script before SuperScript is builtbDirReq	equ %1000000000000000     ; script requires selecting a directory to install to; NOTE: THE FOLLOWING IS THE SAME AS InstallRemoveMode: bit 13bNoRemove	equ %0010000000000000     ; remove not permitted; NOTE: THE FOLLOWING IS THE SAME AS InstallRemoveMode: bit 12bPreventBoot	equ %0001000000000000     ; prevent install to Boot disk: bit 12; InstallRemoveMode: other values (besides two just above)bWriteProtect	equ %1000000000000000     ; current vol is write-protectedbNoVols	equ %0100000000000000     ; no volumes on line; bNoRemove	equ %0010000000000000     ; remove not permitted; bPreventBoot	equ %0001000000000000     ; prevent install to Boot disk: bit 12bNoScripts	equ %0000100000000000     ; No Scripts selected: turn Install/Remove off; AlertMsgNo: possible values for Talking Head to use in AlertMsg routineAlertNoMsg	equ 0AlertMsg1	equ 1AlertMsg2	equ 2AlertMsg3	equ 3AlertMsg4	equ 4AlertMsg5	equ $8005	; keep alert on screen for a whileAlertMsg6	equ 6Alert