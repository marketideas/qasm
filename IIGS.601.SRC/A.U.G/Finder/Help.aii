		seg 'HELP'; help.aii;; Copyright 1991 by Apple Computer, Inc.; All Rights Reserved;.....................................................................		LONGA	ON		LONGI	ON		STRING	PASCAL				PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM		INCLUDE	'ALL.MACROS'		INCLUDE	'E16.CONTROL'		INCLUDE	'E16.WINDOW'		INCLUDE	'PASCAL.macros'		INCLUDE	'special.macros'		INCLUDE	'DP.equ'		PRINT	ONhelpWindow	PROCNAME EXPORT		IMPORT	helpWindowPtr		IMPORT	helpBlk		IMPORT	helpTopic		IMPORT	ArrowCursor		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		phb		phk		plb		_WaitCursor				pha		pha		pushlong #0			;titlePtr		pushlong #helpBlk		;refCon is ptr to our window info block		pushlong #helpDraw+$C0000000	;content draw proc		pushlong #0			;window defproc		pea	2			;refIsResource		pushlong #2			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2		pulllong >helpWindowPtr		bcc	@ok;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	>helpWindowPtr		ora	>helpWindowPtr+2		beq	@bogus		lda	>helpWindowPtr+2		tax		lda	>helpWindowPtr		jsl	CloseThisWindow				lda	#0		sta	>helpWindowPtr		sta	>helpWindowPtr+2	*** Added 21-Jan-93 JCM;;;@bogus		_InitCursor@bogus		jsl	ArrowCursor		*** End - 21-Jan-93 JCM				plb		rtl;; we were able to create the window (and get all the controls attached to it);@ok			pha		pha		pushlong >helpWindowPtr	;our window		pea	0		pea	1		;control ID		_GetCtlHandleFromID		pha		lda	3,s		;(move our handle around to conform to 		sta	1,s		;_SetCtlValue's needs)		lda	5,s		sta	3,s		lda	>helpTopic		sta	5,s		_SetCtlValue		pha		pha		pushlong >helpWindowPtr	;our window		pea	0		pea	2		;control ID		_GetCtlHandleFromID		pulllong teHandle						pea	$15		;what kind (rText)		ldx	#0		;opt 21-Jan-93 DAL (and next 6 PHXs)		phx			;which resource		lda	>helpTopic		pha					phx			;no length (gotten from resource)		phx		phx			;no style type		phx			;no style ref		phx		pushlong teHandle		_TESetText*** Added 21-Jan-93 JCM;;;		_InitCursor		jsl	ArrowCursor		*** End - 21-Jan-93 JCM						plb		rtl; Draw the help window;...................................................................................helpDraw		phb		phk		plb				pushlong >helpWindowPtr		_DrawControls		plb		rtl		; helpControls -- they hit a control in the help window;.....................................................................		EXPORT	helpControlshelpControls				IMPORT	helpTopic		phb		phk		plb		lda	<taskData4	;what did they hit in our window?		cmp	#2		beq	@goFront				cmp	#1		bne	@done		;; they hit a control... and guess what?  it's the popup... so load some rText stuff;		pha		pha		pushlong <taskData	;our window		pea	0		pea	2		;control ID		_GetCtlHandleFromID		pulllong teHandle				pha		pei	<taskData2+2		pei	<taskData2		_GetCtlValue		pla		cmp	>helpTopic		beq	@goFront				and	#$000f		asl	a		tax		lda	text,x		sta	>helpTopic	;save the help topic so we can come back to it				pea	$15		;what kind (rText)		pea	0		;which resource		pha					pea	0		;no length (gotten from resource)		pea	0		pea	0		;no style type		pea	0		;no style ref		pea	0		pushlong teHandle		_TESetText		@goFront	pei 	<taskData+2		pei	<taskData		_SelectWindow@done		plb		rtl		;; locals;teHandle	dc.L	0text		dc.w	$1000		;references to rText resources we use		dc.w	$1001		dc.w	$1002		dc.w	$1003		dc.w	$1004		dc.w	$1005		dc.w	$1006		dc.w	$1007		dc.w	$1008		dc.w	$1009		ENDP		END