;===============================================================		TITLE	'Apple IIGS Finder                            DATA.aii';;	   Copyright Apple Computer, Inc. 1986-1988;	   All rights reserved.;;	   By Dan Oliver;; Modification History for Version 1.2:; -------------------------------------;; 05/16/88 DJB	- Added "DIBlist" from Hack; 05/16/88 DJB	- Changed "devCounter" to "startupFlag" for hack; 05/16/88 DJB	- Added tool 28 to "tooltable" for hack; 05/18/88 DJB	- Added NewWindow params & info blk for Verify window; 05/23/88 DJB	- Added Darryl's Color Menu stuff; 05/26/88 DJB	- Added "IsRAMDisk" flag; 05/28/88 DJB	- Extended title tabels for GetInfo window;		- Added FileSysNames table and strings for GetInfo window;		- Shortend the day stings (date strings too crowded); 05/29/88 DJB	- Added new devices to deviceKinds table and strings; 06/30/88 DJB	- Set caching bit in color menu flags; 07/27/88 DO	- Took out the Info window title stuff (static now).; 07/27/88 JAM  - Added FindersICBlkN for use by LoadIcons; 08/05/88 DJB	- added IsDiskII array; 08/08/88 DJB	- screen2 changed to 10k x 10k to fix BRC #; 02/02/90 RDL	- added QDBank--QD’s high/bank bytes in lo/hi--for djb’s CloseView; ...; 5-Jun-92 DAL  - added PendingDeselectAll for Keyboard Navigation support;===============================================================		PRINT	OFF		PRINT	NOGEN		PRINT	NOPAGE		PAGESIZE $FFFF,126				INCLUDE	'Finder.equ'		INCLUDE	'Strings.equ'		INCLUDE	'All.Macros'		PRINT	ON		;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------;		IMPORT	clip_guts		IMPORT	info_guts		IMPORT	wind_guts		IMPORT	trashBlk;================================;	   RAM data area.;================================RAM		PROC	EXPORT; --- Static RAM data ---------------------------------------------------				EXPORT	screen2screen2		DC.W	-10000,-10000		;This one is used for the entire screen.		DC.W	10000,10000		EXPORT	DragPattDragPatt	DC.B	$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF		EXPORT	ScreenLocInfo		EXPORT	ScreenImage		EXPORT	ScreenRectScreenLocInfo	DC.W	$0080			; port SCBScreenImage	DC.L	0			; picture ptr		DC.W	640/4			; picture width (bytes)ScreenRect	DC.W	0,0,200,640		; bounds rect; Default file:;--------------		EXPORT	preferprefer		DC.W	PREF_ALL		;Preferences.		EXPORT	deskPatdeskPat		DC.B	$DD,$DD,$DD,$DD		;Default desktop pattern.		DC.B	$DD,$DD,$DD,$DD			DC.B	$DD,$DD,$DD,$DD			DC.B	$DD,$DD,$DD,$DD					EXPORT 	zoomWithoutInfozoomWithoutInfo	DC.W	zY1,zX1,zY2,zX2		Zoom RECT without double height info bar		EXPORT 	zoomWithInfozoomWithInfo	DC.W	zY1+12,zX1,zY2,zX2	Zoom RECT with double height info bar		EXPORT	MemoryIDMemoryID	DC.W	0			;our memory manager id		EXPORT	finderDPagefinderDPage	dc.w	0		EXPORT	finderTaskRecordfinderTaskRecord dc.w	0		EXPORT	StartStopRefStartStopRef	DC.L	0		EXPORT	DateFormatDateFormat	DC.W	0		export	NewDeskPatFlagNewDeskPatFlag	dc.w	0			;12-Dec-91 DAL; --- Dynamic RAM data that starts out as zero --------------------------;		EXPORT	StartZeroRAMStartZeroRAM				EXPORT	EjectNonRemovableEjectNonRemovable ds.w	1		EXPORT	CurView			;currently checked viewCurView		dc.w 	0		EXPORT lastOnToplastOnTop	dc.w	0			;last menu item for the last window which was frontmost		EXPORT	LastParamTimeLastParamTime	DS.W	1			; static data for Event Loop		EXPORT	LastScrapTimeLastScrapTime	DS.W	1		EXPORT	LastPatternTimeLastPatternTime	DS.W	1		EXPORT	LastNetTimeLastNetTime	DS.W	1		EXPORT	ScreenHandleScreenHandle	DS.L	1		EXPORT	infoWindCountinfoWindCount	DS.B	2			;Number of Info windows up (added 05/18/88 DJB)		EXPORT	verWindCountverWindCount	DS.B	2			;Number of Verify windows up (added 05/18/88 DJB)		EXPORT	badDesbadDes		DS.B	2			;Used by drag and draw (added 20 Jul SEG)		EXPORT	wrapwrap		DS.B	2			;Used by Cleanup.		EXPORT	LastScrapCountLastScrapCount	DS.B	2			;Added 08/03/88 SEG		EXPORT	cancelEmptycancelEmpty	DS.B	2			;TRUE if empty Trash was cancelled.		EXPORT	abortFindabortFind	DS.B	2			;Flag to abort FindSelect.		EXPORT	myWindCountmyWindCount	DS.B	2			;Number of directory and get info windows up.		EXPORT	saveMenuIDsaveMenuID	DS.B	2			;Save select menu's ID number.		EXPORT	srcViewsrcView		DS.B	2			;Source window view during drag.		EXPORT	sourceViewsourceView	DS.B	2			;Source window view during drag.		EXPORT	SaveOffFlagSaveOffFlag	DS.B	2			;TRUE if data files should not be saved.		EXPORT	spotCountspotCount	DS.B	2			;Counter for spot hashing.		EXPORT	spotHashOnspotHashOn	DS.B	2			;TRUE if hashing for finding a window spot is on.		EXPORT	dupIcondupIcon		DS.B	4			;Handle of icon being checked for dup name.		EXPORT	menuDimFlagmenuDimFlag	DS.B	2			;TRUE if custom color menu is dimmed.		EXPORT	drawRequestdrawRequest	DS.B	2			;TRUE if draw RECTs was asked to draw.		EXPORT	dragDeltaydragDeltay	DS.B	2			;Y offset for dragging icon outlines.		EXPORT	dragDeltaxdragDeltax	DS.B	2			;X offset for dragging icon outlines.		EXPORT	NoDOSerrNoDOSerr	DS.B	2			;TRUE to ignore DOS errors.		EXPORT	IsRAMDisk		;added 05/26/88 DJBIsRAMDisk	DS.B	2			;Flag		EXPORT	flopCountflopCount	DS.B	2			;Floppy drive counter, for icon's name.		EXPORT	IDflagIDflag		DS.B	2			;Sometimes holds the ID of a window.		EXPORT	tempSavedtempSaved	DS.B	4			;Handle of saved pathname area.		EXPORT	PrintingPrinting	DS.B	2			;TRUE if Print selected from File menu.		EXPORT	maxLengthmaxLength	DS.B	2			;Maximum pathname length allowed.		EXPORT	curCursorcurCursor	DS.B	2			;Current cursor.		EXPORT	addFlagaddFlag		DS.B	2			;Mask for icFlag for buildRects to use.		EXPORT	intoIconintoIcon	DS.B 	2			;TRUE if dragging into an icon.		EXPORT	doubleSpeeddoubleSpeed	DS.B 	2			;Time inbetween double click.		EXPORT	auxtypeauxtype		DS.B	2			;Aux type to match to icon image.		EXPORT	AccessPrivAccessPriv	DS.B	2			;Access priviledges for icon (folder/volume)		EXPORT	NetworkBitNetworkBit	DS.B	2			;Network status of icon — DJB 12/07/88		EXPORT	onlyDiskonlyDisk	DS.B	2			;Nonzero to cut only disk icons (cutNfree).		EXPORT	iconSelectediconSelected	DS.B	2			;Selected icon counter.		EXPORT	NoRealMatchNoRealMatch	DS.B	2			;TRUE if findOwnerIc did find owner.		EXPORT	defaultChgdefaultChg	DS.B	2			;TRUE if defaults have changed.		EXPORT	functionKeyfunctionKey	DS.B	2			;FALSE if function not down.		EXPORT	openAppleKey	openAppleKey	DS.B	2			;FALSE if openApple not down		EXPORT	shiftKeyStatus	shiftKeyStatus	DS.B	2			;FALSE if shift not down		EXPORT	controlKeyStatus	controlKeyStatus DS.B	2			;FALSE if control not down		EXPORT	LEwindLEwind		DS.B	4			;Save window of line edit field.		EXPORT	LEiconLEicon		DS.B	4			;Save icon of line edit field.		EXPORT	nameHitnameHit		DS.B	2			;TRUE if button down on icon's title.		EXPORT	desRectdesRect		DS.B	8			;RECT used for line edit field.		EXPORT	viewRectviewRect	DS.B	8			;RECT used for line edit field.		EXPORT	createIconcreateIcon	DS.B	2			;TRUE if icon created from disk insert.		EXPORT	posFlagposFlag		DS.B	2			;TRUE if temp points to position buffer.		EXPORT	eventReceventRec	DS.B	16			;Event record.		EXPORT	portport		DS.B	170			;Desktop port.		EXPORT	ticonobjticonobj	DS.B	icOwner+MaxPathLen	;ICONOBJ template.		EXPORT	smallRectsmallRect	DS.B	8			;Zoom RECT variable		EXPORT	bigRectbigRect		ds.B	8			;Zoom RECT variable		EXPORT	ExtCopyExtCopy		DS.B	2		EXPORT	windowIDwindowID	DS.B	2			;Type of window to accept.		EXPORT	lastClickYlastClickY	DS.B	2			;Position of last button down.		EXPORT	lastClickXlastClickX	DS.B	2		EXPORT	quoteNamequoteName	DS.B	36		EXPORT	OpenFlagOpenFlag	DS.B	2		EXPORT	pathIndexpathIndex	DS.B	2		EXPORT	saveHandsaveHand			DS.B	4			;findSelect save icHand area.		EXPORT	deltaydeltay				DS.B	2			;Values passed to moveIcons.		EXPORT	deltaxdeltax				DS.B	2		EXPORT	deltay2deltay2				DS.B	2		EXPORT	deltax2deltax2				DS.B	2		EXPORT	DeleteFlagDeleteFlag				DS.B	2		EXPORT	QDBankQDBank		DS.B	2			; save QD’s high/bank bytes in lo/hi.		EXPORT	dontDrawdontDraw	DS.B	2			; don’t redraw icons w illegal filenames		EXPORT	diffVolumesdiffVolumes	DS.B	2			; copy: source & dest vols are different		EXPORT	magicToDomagicToDo	DS.B	2			;flag used by drag/copy code if source is System folder		EXPORT	EndZeroRAMEndZeroRAM		; The block of large pathnames is below here for a reason -- we're trying really; hard to group all of the pathnames together to make sure that stuff sparses better;.....................................................................;; Block to save;		EXPORT	startSaveBlkstartSaveBlk					;block gets saved on window updates		EXPORT	C1_PathNameBufC1_PathNameBuf	DC.W	0			;class 1 output string (filled in on startup)		EXPORT	C1_PathNameC1_PathName	DS.B	MaxPathLen+MaxFileName+2	;class 1 input string		EXPORT	C1_TempPathBufC1_TempPathBuf	dc.w	0		EXPORT	C1_TempPathC1_TempPath	DS.B	MaxPathLen+MaxFileName+2	;class 1 input string		EXPORT	lastNamelastName	DS.B	34		EXPORT	endSaveBlkendSaveBlk;------- End of Block ------------------; --- Dynamic RAM that needs to be initialized each startup, using StartInitRAM -----		EXPORT	StartDynamRAMStartDynamRAM				export PendingDeselectAllPendingDeselectAll dc.w 0	;5-Jun-92 DAL for keyboard navigation support		EXPORT	screenscreen		DS.B	8		EXPORT	resolutionresolution	; 		EXPORT	SrcModeSrcMode		DS.B	2		EXPORT	SrcImageSrcImage	DS.B	4		EXPORT	SrcWidthSrcWidth	DS.B	2		EXPORT	SrcRectSrcRect		DS.B	8		EXPORT	wind_paramwind_param	 		EXPORT	wind_sizewind_size	DS.B	2		EXPORT	wind_framewind_frame	DS.B	2		EXPORT	wind_titlewind_title	DS.B	4		EXPORT	wind_refwind_ref	DS.B	4		EXPORT	wind_fullwind_full	DS.B	8		EXPORT	wind_colorwind_color	DS.B	4		EXPORT	wind_voffwind_voff	DS.B	2		EXPORT	wind_hoffwind_hoff	DS.B	2		EXPORT	wind_datahwind_datah	DS.B	2		EXPORT	wind_datawwind_dataw	DS.B	2		EXPORT	wind_max_hwind_max_h	DS.B	2		EXPORT	wind_max_wwind_max_w	DS.B	2		EXPORT	wind_vscrlwind_vscrl	DS.B	2		EXPORT	wind_hscrlwind_hscrl	DS.B	2		EXPORT	wind_vpagewind_vpage	DS.B	2		EXPORT	wind_hpagewind_hpage	DS.B	2		EXPORT	wind_infotwind_infot	DS.B	4		EXPORT	wind_infoHwind_infoH	DS.B	2		EXPORT	wind_defwind_def	DS.B	4		EXPORT	wind_infowind_info	DS.B	4		EXPORT	wind_drawwind_draw	DS.B	4		EXPORT	wind_poswind_pos	DS.B	8		EXPORT	wind_planewind_plane	DS.B	4		EXPORT	wind_recwind_rec	DS.B	4		EXPORT	wind_endwind_end		EXPORT	nextWindPosnextWindPos	DS.B	8      		EXPORT	AccessDefault		; added 12/06/88 DJBAccessDefault	DS.W	1			; default value for Network Access Priv		EXPORT	EndDynamRAMEndDynamRAM		EXPORT	stringsLenstringsLen	DS.B	8		EXPORT	notDiskFlagnotDiskFlag	DS.B 2		EXPORT	table1table1		DS.B	64;; Some more misc buffers;		EXPORT	C1_VolNameC1_VolName	DS.B	MaxFileName+2		;class 1 input string		EXPORT	c1_DevNameBufc1_DevNameBuf	DC.W	MaxFileName+4		EXPORT	c1_DeviceNamec1_DeviceName	DS.B	MaxFileName+2		EXPORT	C1_FileNameBufC1_FileNameBuf	DC.W	MaxFileName+4		;class 1 output string		EXPORT	C1_FileNameC1_FileName	DS.B	MaxFileName+2		;class 1 input string; --- Error messages --------------------------------------------------;; --- Template for RAM that needs to be	initialized ------------------------;		EXPORT	StartInitRAMStartInitRAM		dc.w	0		;PendingDeselectAll		DC.W	0,0,200,640	;Y1 is set to the bottom of the menu bar.		DC.W	$0080		;640 mode.		DC.L	0		;Pointer to pixel image to blit.		DC.W	0		;Width of pixel image, in bytes.		DC.W	0,0,0,0		;Rect of pixel image.;; Directory window parameter block:;		EXPORT	TrashWindowStartTrashWindowStart		DC.W	wind_end-wind_size	;Length of this parameter list.		DC.W	%1101111110110001	;Frame flag (visible)		DC.L	trashBlk+windTitle	;Pointer to window's title.		DC.L	TrashBlk		;RefCon - pointer to window's info block.		DC.W	zY1,zX1,zY2,zX2		;Zoom RECT.		EXPORT	TrashWindowColorTrashWindowColor DC.L	0			;Pointer to color table.		DC.W	0,0			;Y and X origin.		DC.W	0,0			;Data height and width. (was 60,480 DAL 16		DC.W	200,640			;Maximum height and width for Grow.		DC.W	10,24			;Vertical and horizontal scroll amounts.		DC.W	0,0			;Vertical and horizontal page amounts.		DC.L	TrashBlk		;Infomation bar text string.		DC.W	11			;Height of information bar.		DC.L	0			;Window frame defProc (default).		DC.L	info_guts		;Routine to draw info. bar.		DC.L	wind_guts		;Routine to draw content.		DC.W	130,20,180,500		;Size/Position of content.		DC.L	$FFFFFFFF		;Plane to put window up in.		DC.L	0			;Address of memory for window record.		EXPORT	TrashWindowEndTrashWindowEnd		DC.W	dfltWinY1,dfltWinX1,dfltWinY2,dfltWinX2;; default access privileges;		DC.W	$F007			; only owner has access	      		EXPORT	EndInitRAMEndInitRAM	;------------------------------------------------DynamRAM	set	EndDynamRAM-StartDynamRAMInitRAM		set	EndInitRAM-StartInitRAM		if	DynamRAM <> InitRAM	then			AError	'DynamicRAM ≠ InitRAM!'		endif		EXPORT	shutdown_listshutdown_list	DC.W	1		;pcount		EXPORT	shutdown_flagshutdown_flag	DC.W	0		;flag_field;; names for where stuff is supposed to go;		EXPORT	quit_listquit_list	DC.W	2		;pcount		EXPORT	quit_pathquit_path	DC.L	0		;ptr to pathname		EXPORT	quit_flagsquit_flags	DC.W	0		;flags		EXPORT	devnum_listdevnum_list	DC.W	2		;pcount		ENTRY	devnum_namedevnum_name	DC.L	C1_PathName	;ptr to volume name		EXPORT	devnum_numdevnum_num	DC.W	0		;device number		; --- Line drawing masks and data ------------------------------------------		EXPORT	pixelMask1pixelMask1	DC.W	$00FF,$003F,$000F,$0003		EXPORT	pixelMask2pixelMask2	DC.W	$00C0,$00F0,$00FC,$00FF		EXPORT	pixelMask3pixelMask3	DC.W	$00F0,$003C,$000F,$C003; --- Data for window info bar drawing -------------------------------------		EXPORT	stringsstrings		DC.W	freeKString		;strings are in Strings.aii		DC.W	usedKString		DC.W	itemsStrg		dc.W	ProDOSName				EXPORT	boldTitleboldTitle	DC.W	$FFFF		EXPORT	startXstartX		DS.B	6		DC.W	4		DC.W	dxViewDate		;X position of 'Last Modified'.		DC.W	dxViewKind		;X position of 'Kind'.		DC.W	dxViewSize		;X position of 'Size'.		DC.W	dxViewName		;X position of 'Name'.		END		