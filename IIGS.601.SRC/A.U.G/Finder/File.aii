*********************************************************						        *		    Apple IIGS Finder		        *		 File & disk copy routines		        *						        *	Copyright Apple	Computer, Inc. 1986-1993        *		   All Rights Reserved		        *						        *		  Written by Cheryl Ewy		        *	    Modified for GS/OS by Don Brady*	Modified for Finder 6.0 by Andy Nicholas*     Modified for 6.0.1 mostly by Dave Lyons, 1992-1993** Modification History for Version 1.2:* -------------------------------------* 05/17/88 DJB	- Added session_call calls to "DeleteFiles"*		- Added session_call calls to "DoFileCopy"* 07/25/88 DJB	- Added GetCreateDate() and other create*		  date stuff for disk copy.* 07/27/88 DJB	_ Added check to DoCopyFiles to skip feedback*		  dialog when duplicating files.* 07/27/88 JAM	- Addressed BRC #34406 by increasing the*		  slop cushion in GetBuffer from 3K to 24K.* 08/03/88 DJB	- Added GetDstFileSys() and CheckDstName() routines.* 08/06/88 DJB	- Made calls to SaveDevStats() routine.* 08/06/88 DJB	- Turn off Sessioning when dialog boxes are up* 08/06/88 DJB	- Changed the pcount in the create call to 5 (was 4)* 08/12/88 DJB	- Added TranslatedName to replace illegal use of FileName variable* 08/14/88 DJB  - Added RestartSession and checked for memory*                 errors inside the write loop.********************************************************** For 6.0.1 -- most changes marked with "DAL" <-- he lies - there are more "JCM"s now :-)** 12-Jun-92 DAL -- Uses DisposeHandleGlue** 19-Jun-92 DAL -- changed lots of pushlong #0 to*                  lda #0...pha pha, especially when*                  several were clustered together** 27-Jan-93 JCM - Changed all _CloseWindow macros to make jsl's*		  to new common close window functions that I've*		  added to Util.aii.**  1-Feb-93 JCM - Made IsFileMagic actually walk its match table without getting out of sync with the*		  records on a failed partial match (filetype matched/auxType didn't). By removing lots*		  of INXs on Dave's suggestion (boy, was I dumb), all is now well and Printer drivers can*		  now properly route.** 20-Mar-93 JCM - Fixed IsFileMagic to restore C1_DstPathname to *:System if the file isn't routable and*		  we're in the process of copying files. This stops non-routable files from following the*		  last file we routed into their folder.** 24-Mar-93 JCM - Guess what? The server copy code doesn't work! It's too late to re-write it (as I*		  fear needs to happen), so we're disabling it for 6.0.1. ** 24-Mar-93 JCM - Fixed the option-copy case where you dragged a file from the desktop back to the window*		  it really belongs to. Before we would try to copy the file over itself, which isn't a*		  very pretty sight.** 24-Mar-93 JCM - Fixed DoMagicRouting and IsFileMagic to better communicate to each other why files*		  could not be routed, if that's the case. We can now differentiate between the states*		  of "we aren't routing at all" and "this file isn't routable".** 25-Mar-93 JCM - We no longer attempt to route Media Control drivers. This allows us to take the easy way*		  out and always assume that the folder we're routing to will exist.** 25-Mar-93 JCM - Fixed CompareVols to be insensitive in its comparison.** 26-Mar-93 JCM - Soon after we start duping the d15 disks, I find that my CompareVols fix is broken.*		  Now it _really_ works if the volumes are different or you're holding down the option key.**  1-Apr-93 JCM - Awww, what the heck. Let's route Media Control drivers anyway. Someone can always*		  rename any destination folder, so these really aren't so special.*********************************************************		PRINT	OFF		STRING	ASIS		BLANKS	OFF		MACHINE	M65816		LONGA	on		LONGI	on		INCLUDE	'all.macros'		INCLUDE	'special.macros'		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'		INCLUDE	'Strings.equ'		include 'dp.equ'		PRINT	ON		import DisposeHandleGlue;; equates for FSTs;PRODOS_FST	equ	$01DOS33_FST	equ	$02PASCAL_FST	equ	$04HFS_FST		equ	$06MSDOS_FST	equ	$0AAPPLESHARE_FST	equ	$0D;------------------------------------------;; Equates for File Copy module;;------------------------------------------MaxIcons	equ	800			;maximum # of icons which can be copiedSFISize		equ	116			;size of SET_FILE_INFO param blocksizeOfSizeInfo	equ	10			;new equates for extended file copiesdataFork	equ	$4000resourceFork	equ	$8000*---------------------------------------------------------------* Zero Page*---------------------------------------------------------------ZStart		equ	0ProgID		equ	ZStartError		equ	ProgID+2NumFiles	equ	Error+2NumFolders	equ	NumFiles+4NumCats		equ	NumFolders+2NumItems	equ	NumCats+2		CatIndex	equ	NumItems+4CatHndl		equ	CatIndex+2CatPtr		equ	CatHndl+4BufHndl		equ	CatPtr+4BufPtr		equ	BufHndl+4BufSize		equ	BufPtr+4SoFarFlag	equ	BufSize+4DataForkYet	equ	SoFarFlag+2DataReadSize	equ	DataForkYet+4RsrcForkYet	equ	DataReadSize+4RsrcReadSize	equ	RsrcForkYet+4CatalogEOF	equ	RsrcReadSizeTotalEOF	equ	CatalogEOF+4IconListHndl	equ	TotalEOF+4IconHndl	equ	IconListHndl+4IconPtr		equ	IconHndl+4INamePtr	equ	IconPtr+4SrcPathLen	equ	INamePtr+4DstPathLen	equ	SrcPathLen+2PathNamePtr	equ	DstPathLen+2FileNamePtr	equ	PathNamePtr+4		OtherPtr	equ	FileNamePtr+4RWPtr		equ	OtherPtr+4segmentCount	equ	RWPtr+4DstFileSysID	equ	segmentCount+2		SrcFileSysID	equ	DstFileSysID+2SkipBadNames	equ	SrcFileSysID+2		NamesWereXLated	equ	SkipBadNames+2		DestDeviceNumber equ	NamesWereXLated+2	Disk2Sub	equ	DestDeviceNumber+2DeleteFlag	equ	Disk2Sub+2ReadDuplicate	equ	DeleteFlag+2WriteDuplicate	equ	ReadDuplicate+2WhichMsg	equ	WriteDuplicate+2DelAllDups	equ	WhichMsg+2NumParams	equ	DelAllDups+2IsExtended	equ	NumParams+2		NewNamePtr	equ	IsExtended+2segmentBlocks	equ	NewNamePtr+4		localTemp	equ	segmentBlocks+2MaxFileSize	equ	localTemp+4OurFileSize	equ	MaxFileSize+4CallBackStructPtr equ	OurFileSize+4ZEnd		equ	CallBackStructPtr+4		IF ZEnd>$FF THEN			WRITE 'ZEnd = '			WRITELN ZEnd			WRITELN 'WARNING... Direct page variable overflow!'			AERROR 'File.aii extended its local DP too far'		ENDIF;-----------------------------------------------;; Equates for New Block Copy			; added 4/19/89 DJB;;-----------------------------------------------segmentSize	equ	36864			; size of each segment (bytes)maxSegments	equ	200			;200 36k segments maximum (8 MB of ram used, max);-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	EndCall		IMPORT	ErrOut		IMPORT	MiscEntry		IMPORT	oEndCall		IMPORT	PathAddName		IMPORT	PToWString		IMPORT	WStringCopy		IMPORT	SaveDevStats		;in drives.aii;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY   RestartSession		ENTRY	MakeFileName		ENTRY	AddDstSlash		ENTRY	AddSrcSlash		ENTRY	AllocateMem		ENTRY	CatalogSrc		ENTRY	DrawMsg		ENTRY	DrawThermo		ENTRY	ChangePath		ENTRY	CheckDstName		ENTRY	NameErr		ENTRY	CheckKey		ENTRY	CloseFile		ENTRY	CopyDisk		ENTRY	CopyFiles		ENTRY	CreateFile		ENTRY	DeleteFiles		ENTRY	DerefIcon		ENTRY	DestroyFile		ENTRY	DoFileCopy		ENTRY	DupFiles		ENTRY	EraseDisk		ENTRY	FileStartUp		ENTRY	GetBuffer		ENTRY	GetDevInfo		ENTRY	GetDevNum		ENTRY	GetDstFileSys		ENTRY	GetFileInfo		ENTRY	GetFileInfo2		ENTRY	GetFileInfo3		ENTRY	GetMark		ENTRY	GetNextCat		ENTRY	GetNextFile		ENTRY	GetNextIcon		ENTRY	GetSelIcon		ENTRY	GetVolInfo		ENTRY	GetVolSizes		ENTRY	RebuildVCR		ENTRY	LockIcon		ENTRY	MakeDstName		ENTRY	MakeINamePtr		ENTRY	MakePathName		ENTRY	MakeSrcName		ENTRY	OpenFile		ENTRY	OpenResource		ENTRY	ProDosCall		ENTRY	ProDosErr		ENTRY	ReadBlocks		ENTRY	ReadDataFile		ENTRY	ReadRsrcFile		ENTRY	SetFileInfo		ENTRY	SetMark		ENTRY	StdEnd		ENTRY	UnLockIcon		ENTRY	WriteBlocks		ENTRY	WriteDataFile		ENTRY	WriteRsrcFile****************************************************************** FILE ROUTINES	- CALL TABLE*****************************************************************FileRoutines	PROC		DC.L	FileStartUp		DC.L	CopyFiles		DC.L	CopyDisk		DC.L	DeleteFiles		DC.L	DupFiles		ENDP****************************************************************** FILE ROUTINES	- DATA DECLARATIONS*****************************************************************FRData		PROC*---------------------------------------------------------------* Data*---------------------------------------------------------------		ENTRY	ZeroPageZeroPage	DS.B	2			;zero page assigned to File Routines		ENTRY	CP_TrustmeCP_Trustme	DC.W	3			;parameter block for CHANGE_PATH call with Trustme flag		ENTRY	CP_TOldPtrCP_TOldPtr	DC.L	0			;ptr to	original pathname		ENTRY	CP_TNewPtrCP_TNewPtr	DC.L	0			;ptr to	new pathname		ENTRY	CP_TrustmeFlagCP_TrustmeFlag	DC.W	$8000		ENTRY	OE_ParamsOE_Params	DC.W	4			;paramater block for extend OPEN call		ENTRY	OE_RefOE_Ref		DC.W	0			;reference number		ENTRY	OE_NamePtrOE_NamePtr	DC.L	0			;ptr to	pathname		ENTRY	OE_ReqAccessOE_ReqAccess	DC.W	0			;request access		ENTRY	OE_ResourceOE_Resource	DC.W	1			;resource number (use resource fork)		ENTRY	C_ParamsC_Params	DC.W	1			;parameter block for CLOSE call		ENTRY	C_RefC_Ref		DC.W	0			;reference number		ENTRY	RW_ParamsRW_Params	DC.W	4			;parameter block for READ/WRITE calls		ENTRY	RW_RefRW_Ref		DC.W	0			;reference number		ENTRY	RW_BufPtrRW_BufPtr	DC.L	0			;ptr to	data buffer		ENTRY	RW_SizeRW_Size		DC.L	0			;number	of bytes to read or write		ENTRY	RW_ActualRW_Actual	DC.L	0			;number	of bytes actually read/written		ENTRY	RWE_ParamsRWE_Params	DC.W	4			;parameter block for extend READ/WRITE		ENTRY	RWE_RefRWE_Ref		DC.W	0			;reference number		ENTRY	RWE_BufPtrRWE_BufPtr	DC.L	0			;ptr to	data buffer		ENTRY	RWE_SizeRWE_Size	DC.L	0			;number	of bytes to read or write		ENTRY	RWE_ActualRWE_Actual	DC.L	0			;number	of bytes actually read/written		ENTRY	CP_ParamsCP_Params	DC.W	2			;parameter block for CHANGE_PATH call		ENTRY	CP_OldPtrCP_OldPtr	DC.L	0			;ptr to	original pathname		ENTRY	CP_NewPtrCP_NewPtr	DC.L	0			;ptr to	new pathname		ENTRY	GM_ParamsGM_Params	DC.W	2			;parameter block for GET_MARK		ENTRY	GM_RefGM_Ref		DC.W	0			;reference number		ENTRY	GM_PositionGM_Position	DC.L	0			;position in file		ENTRY	SM_ParamsSM_Params	DC.W	3			;parameter block for SET_MARK		ENTRY	SM_RefSM_Ref		DC.W	0			;reference number		ENTRY	SM_BaseSM_Base		DC.W	0		ENTRY	SM_DisplaceSM_Displace	DC.L	0			;position in file		ENTRY	E_ParamsE_Params	DC.W	4			;parameter block for ERASE_DISK call		ENTRY	E_DevNameE_DevName	DC.L	C1_DeviceName		;ptr to	device name		ENTRY	E_VolNameE_VolName	DC.L	0			;ptr to	volume name		ENTRY	E_FileSysE_FileSys	DC.W	0			;file system ID		ENTRY	E_ReqFileSysE_ReqFileSys	DC.W	0			;requested file system ID		ENTRY	V_ParamsV_Params	DC.W	5			;parameter block for VOLUME call		ENTRY	V_DevNameV_DevName	DC.L	C1_DeviceName		;ptr to	device name		ENTRY	V_VolNameV_VolName	DC.L	FileNameBuff		;ptr to	volume name - unused		ENTRY	V_BlocksV_Blocks	DC.L	0			;total blocks -	unused		ENTRY	V_FreeV_Free		DC.L	0			;free blocks - unused		ENTRY	V_FileSysV_FileSys	DC.W	0			;file system ID		ENTRY	RWB_ParamsRWB_Params	DC.W	6			;param block for D_READ/D_WRITE calls		ENTRY	RWB_DevNumRWB_DevNum	DC.W	0			;device	number		ENTRY	RWB_BufPtrRWB_BufPtr	DC.L	0			;ptr to	data buffer		ENTRY	RWB_CountRWB_Count	DC.L	512			;bytes to read		ENTRY	RWB_BlockNumRWB_BlockNum	DC.L	0			;block number to be read or written		ENTRY	RWB_BlockSizeRWB_BlockSize	DC.L	512			;the size, in bytes, of a block		ENTRY	RWB_ActualRWB_Actual	DC.L	0			;bytes actually transfered		ENTRY	GDN_ParamsGDN_Params	DC.W	2			;parameter block for GET_DEV_NUM call		ENTRY	GDN_NameGDN_Name	DC.L	0			;ptr to	volume name		ENTRY	GDN_DevNumGDN_DevNum	DC.W	0			;device	number		ENTRY	DI_ParamsDI_Params	DC.W	2			;parameter block for D_INFO call		ENTRY	DI_DevNumDI_DevNum	DC.W	0			;device	number		ENTRY	DI_DevNameDI_DevName	DC.L	C1_DevNameBuf		;ptr to	device name (class 1 output)		ENTRY	D_ParamsD_Params	DC.W	1			;parameter block for DESTROY call		ENTRY	D_NameD_Name		DC.L	0			;ptr to	file's pathname		ENTRY	FlushParmsFlushParms	dc.w	1		dc.w	0			;flush everything		ENTRY	FI_ParamsFI_Params	DC.W	12			;parameter block for GET_FILE_INFO calls		ENTRY	FI_NameFI_Name		DC.L	0			;ptr to	pathname		ENTRY	FI_AccessFI_Access	DC.W	0			;access		ENTRY	FI_FTypeFI_FType	DC.W	0			;file type		ENTRY	FI_ATypeFI_AType	DC.L	0			;aux type		ENTRY	FI_STypeFI_SType	DC.W	0			;storage type		ENTRY	FI_CDateFI_CDate	DC.L	0,0			;create	date		ENTRY	FI_MDateFI_MDate	DC.L	0,0			;modify	date		ENTRY	FI_OptionListPtrFI_OptionListPtr dc.L	FI_OptionList		;option list support 11/21/90, by andy		ENTRY	FI_EOFFI_EOF		DC.L	0		ENTRY	FI_BlocksFI_Blocks	DC.L	0		ENTRY	FI_ResourceEOFFI_ResourceEOF	DC.L	0		ENTRY	FI_ResourceBlocksFI_ResourceBlocks DC.L	0		ENTRY	FI_OptionListFI_OptionList	dc.W	64 			;fixing BRC #77946		ds.b 	62		ENTRY	O_ParamsO_Params	DC.W	0			;paramater block for OPEN call (filled)		ENTRY	O_RefO_Ref		DC.W	0			;reference number		ENTRY	O_NamePtrO_NamePtr	DC.L	0			;ptr to	pathname		ENTRY	O_ReqAccessO_ReqAccess	DC.W	0			;request access		ENTRY	O_ResourceO_Resource	DC.W	0			;resource number		ENTRY	O_AccessO_Access	DC.W	0			;file access		ENTRY	O_FileTypeO_FileType	DC.W	0			;file type		ENTRY	O_AuxTypeO_AuxType	DC.L	0			;aux type		ENTRY	O_StoreTypeO_StoreType	DC.W	0			;storage type		ENTRY	O_CreateDateO_CreateDate	DC.L	0,0			;creation date		ENTRY	O_ModDateO_ModDate	DC.L	0,0			;modification date		ENTRY	O_OptionListO_OptionList	DC.L	0			;option list ptr		ENTRY	O_DataEOFO_DataEOF	DC.L	0			;data fork EOF		ENTRY	O_BlocksO_Blocks	DC.L	0			;blocks used		ENTRY	O_RsrcEOFO_RsrcEOF	DC.L	0			;resource fork EOF			ENTRY	session_callsession_call	DC.W	0			;parameter block for SESSION calls		ENTRY	session_listsession_list	DC.W	0			;parameter block for SESSION_STATUS call (filled)		ENTRY	session_statsession_stat	DC.W	0		ENTRY	C1_DevNameBufC1_DevNameBuf	DC.W	0			;space for device name		ENTRY	C1_DeviceNameC1_DeviceName	DS.B	34			;space for device name		ENTRY	FileNameBuffFileNameBuff	DC.W	0			;length of buffer (filled in later)		ENTRY	FileNameFileName	DS.B	MaxFileName+2		;space for local filename		ENTRY	TranslatedNameTranslatedName	DS.B	MaxFileName+3		;space for Translated filename+1		ENTRY	AbortFlagAbortFlag	DC.W	0				;added 06/09/88 DJB		EXPORT	C1_SrcPathName		ENTRY	C1_SrcPathNameC1_SrcPathName	DS.B	MaxPathLen+MaxFileName+2	;added 06/28/88 DJB		EXPORT	C1_DstPathName		ENTRY	C1_DstPathNameC1_DstPathName	DS.B	MaxPathLen+MaxFileName+2	;added 06/28/88 DJB		ENTRY	C1_IconName			;added 06/28/88 DJBC1_IconName	DS.B	MaxFileName+2;; last source and destination device numbers used by block copy;		ENTRY	Source_DevNumSource_DevNum	dc.w	0		ENTRY	Dest_DevNumDest_DevNum	dc.w	0		EXPORT	copyWindowPtrcopyWindowPtr	dc.L	0		ENTRY	ourPortourPort		dc.L	0;; parameter list for FSTSpecific file copy for AppleShare FST;		ENTRY	CopyFileParmsCopyFileParms	dc.w	4		dc.w	$000d		;AppleShare		dc.w	7		;copyFiles		dc.L	c1_SrcPathname	;srcPtr		dc.L	c1_DstPathname	;destPtr		ENDP****************************************************************** FileEntry*****************************************************************		EXPORT	FileEntryFileEntry	PROC;NOTE - this is self-modifying code!;X contains the number of the routine to execute		dex				;decrement routine #		txa				;create index into table of addresses		asl	a		asl	a		tax		lda	>FileRoutines,x		;get address of routine		sta	>Adrs+1			;and store after the JSL		lda	>FileRoutines+1,x		sta	>Adrs+2		lda	>ZeroPage		;load A with zero page assigned to usAdrs		jsl	Adrs			;execute the routine		rtl				;return to calling routine		ENDP****************************************************************** FileStartUp*****************************************************************FileStartUp	PROCZP		equ	9			;input paramsID		equ	ZP+2		phd		lda	ZP,s			;get zero page assigned	to us		sta	>ZeroPage		;and save		tcd		ldx	#ZEndZPLoop		stz	<ZStart,x		;clear zero page		dex		dex		bpl	ZPLoop		lda	ID,s			;get program ID		sta	<ProgID			;and save		phb		phk		plb				lda	#MaxFilename+4		sta	FileNameBuff				lda	#36		sta	C1_DevNameBuf		lda	#1		sta	session_list		lda	#14		sta 	O_Params				plb		ldy	#4			;param size		jml	EndCall		ENDP****************************************************************** CheckReadOnlyDest*****************************************************************CheckReadOnlyDest PROC		IMPORT	IsReadOnly		IMPORT	C1_Filename		IMPORT	doAlertWindow		;		clc				;removed 25-Aug-92 DAL!;		rts				ldy	<DstFileSysID		jsl	IsReadOnly		bcs	@readOnly		rts@readOnly	sep	#$20		LONGA OFF		ldx	#$FFFF@loop		lda	C1_DstPathname+3,x		cmp	#':'		beq	@gotRoot		sta	>C1_Filename+2,x		inx		cpx	C1_DstPathname		blt	@loop@gotRoot				rep	#$20		LONGA ON		lda	C1_DstPathname		dec	a		sta	>c1_filename		lda	#rasDragReadOnly		jsl	doAlertwindow		sec		rts		ENDP****************************************************************** CopyFiles*****************************************************************CopyFiles	PROCNAME		IMPORT	SaveCursor		IMPORT	RestoreCursor		IMPORT	ArrowCursor		IMPORT	WatchCursor		IMPORT	finderTaskRecord		IMPORT	doAlertWindow		import	WindowGlobalON		import	WindowGlobalOFF		import	FileCopyOpen		import	FileCopyClose		import	DrawCopyControls		import	DrawNumItems		import	StrAlloc		import	ChangePathFixPath		import	c1_pathname		import	c1_temppath		import	FinderDPage		IMPORT	CloseFileWindow		;in util.aii - 27-Jan-93 JCM		import	WStrCompare		;24-Mar-93 JCMOptionKey	equ	10			; WARNING: clones of OptionKey andDstPtr		equ	OptionKey+2		; DstPtr are now used in StdEndSrcPtr		equ	DstPtr+4IcHndl		equ	SrcPtr+4		;input parametersParamSize	equ	14			;# of bytes of input paramsSrcVolLen	equ	ZEnd			;zero page tempsDstVolLen	equ	SrcVolLen+2RetAdrs		equ	DstVolLen+2		IF	RetAdrs+4>$FF THEN			WRITE 'RedAdrs = '			WRITELN RetAdrs			WRITELN 'WARNING... Direct page variable overflow!'			AERROR 'CopyFiles extended its local DP too far'		ENDIF		phd		tcd		phb		phk		plb		lda	#ParamSize		;# of bytes of input params		sta	<NumParams		jsl	SaveCursor*** Added - 24-Mar-93 JCM - Fixes option-copying a file on the desktop back to its***			    original window. Previously, we would attempt to duplicate***			    the file onto itself, which is quite a bad thing.		lda 	>FinderDPage		;only look to disallow the move if the option key		tax				; is down		lda 	>modifiers,x		and 	#$0800		beq	@diffVols		pha		lda	SrcPtr+4,s		;get ptr to source (window) pathname		pha		lda	SrcPtr+4,s		pha		lda	DstPtr+8,s		;get ptr to dest (window) pathname		pha		lda	DstPtr+8,s		pha		jsl	WStrCompare		pla		beq	@diffVols		stz	<Error			;don't return an error		jmp	StdEnd@diffVols*** End - 24-Mar-93 JCM		jsl	WatchCursor				stz	<WhichMsg		;no message for	now		stz	AbortFlag		;added 06/09/88 DJB		stz	<SrcPathLen		;zero out pathname lengths		stz	<DstPathLen		stz	<NamesWereXLated	; JAM 06/01/89 Fixing BRC #49639		lda	OptionKey,s		;are we	copying	extended icons?		bmi	NoOption		;yes - so don't clear DelAllDups flag						;or put	up File	Copy Alternatives dialog		stz	<DelAllDups*** 17-Aug-92 DAL -- experimentally removed;		lda	OptionKey,s		;was Option key	held down?;		beq	NoOption		;no;		;		jsr	CopyOptions		;yes - so put up Copy Options dialog;		bcs	doQuit			;'Cancel' was selected so quitNoOption		lda	DstPtr+2,s		;get ptr to dest (window) pathname		tax		lda	DstPtr,s		phx		pha		PushLong #C1_DstPathName		jsl	WStringCopy		;copy dst pathname to our buffer		lda	SrcPtr+2,s		;get ptr to source (window) pathname		tax		lda	SrcPtr,s		phx		pha		PushLong #C1_SrcPathName		jsl	WStringCopy		;copy src pathname to our buffer		jsr	AddSrcSlash		;add separator after src pathname		jsr	AddDstSlash		;add separator after dst pathname		lda	IcHndl,s		;get handle to first icon in icon list		sta	<IconHndl		sta	<IconListHndl		;save for 'SetIconBits'		lda	IcHndl+2,s		sta	<IconHndl+2		sta	<IconListHndl+2		jsr	GetSelIcon		;search	list for first selected	icon		jsr	CompareVols		;are src and dest vols the same?;;;		beq	SameVol			;yes - 25-Mar-93 JCM		bcc	SameVol			;yes - 25-Mar-93 JCM		brl	DiffVols		;no;------------------------------------------------------------------------------doQuit		lda	#$FFFF		sta	<Error			;return	an error		jmp	StdEndSameVol		dec	<SrcPathLen		;strip off ':'		dec	<DstPathLen		;strip off ':'		stz	<CatPtr			;zero out CatPtr so error handling		stz	<CatPtr+2		;will work correctly		lda	#C1_SrcPathName		sta	CP_OldPtr		;ptr to	SrcPathName		lda	#^C1_SrcPathName		sta	CP_OldPtr+2		lda	#C1_DstPathName		sta	CP_NewPtr		;ptr to	DstPathName		lda	#^C1_DstPathName		sta	CP_NewPtr+2		jsr	CountIcons		;count the # of	icons being moved		bcs	doQuitChangeLoop	jsr	CheckKey		;does user want	to cancel?		bcs	doQuit			;yes		jsr	MakeSrcName		;make source pathname		bcs	doQuit			;name too long		jsr	MakeDstName		;make dest pathname		bcs	doQuit			;name too long		jsr	CompareNames		;are the pathnames the same?		beq	ChangeOK		;yes - so skip the ChangePath call		stz	copyWindowPtr+1		stz	srqCopyOutParms+2		pea	$0106			;finderSaysBeforeCopy		ldx	#0		pea	$8000			;how = send to first guy who accepts it		phx		phx				;target = nil		pushlong #srqCopyParms		pushlong #srqCopyOutParms	;dataOut = nil		_SendRequest		bcs	@continue		lda	srqCopyOutParms+2		bne	ChangeNext@continue		lda	#1			;flag to to append the filename to the dest pathname		jsr	DoMagicRouting		;see if we should route this file specially - 18-Jan-93 JCM		bcs	doQuit			;got error - cancel - 23-Jan-93 JCM		jsr	ChangePath		;do a ProDOS ChangePath	call		bcc	ChangeOK		;no errors		bpl	ChangeNext		;got error - skip this file		brl	doQuit			;got error - cancelChangeOK	ldy	#icFlag		lda	[<IconPtr],y		;get Flag word in IconObj record		ora	#ICCOPY+ICDELETE	;set copy & delete bits so icon		sta	[<IconPtr],y		;draw correctly				pushlong #c1_SrcPathname	;old path		pushlong #c1_temppath		jsl	WStringCopy				pushlong #c1_DstPathname	;new path		pushlong #c1_pathname		jsl	WStringCopy				ldx	<IconHndl		ldy	<IconHndl+2		jsl	ChangePathFixPath	;fix all the windows, info windows, and desktop icons		ChangeNext	jsr	GetNextIcon		bcs	@next		brl	ChangeLoop		;loop until done with all icons@next				stz	<Error			;don't return an error		jmp	StdEnd;------------------------------------------------------------------------------		srqCopyParms	dc.w	2			;parameter count=2		dc.L	C1_SrcPathName		dc.L	C1_DstPathNamesrqCopyOutParms	dc.w	0			;recvCount		dc.w	0			;abortFlag		;------------------------------------------------------------------------------		IMPORT	diffVolumesDiffVols	lda	#1		sta	>diffVolumes		;so indicate		dec	<SrcPathLen		;strip off ':'		jsr	CountIcons		;count the # of	icons being copied		bcc	@noQuit1		brl	doQuit			;too many icons	to copy	at once@noQuit1						jsr	FileCopyOpen		bcs	CatErr				jsr	DrawCopyControls		lda	#1			;start counting upwards from 1		ldy	#0		jsr	DrawNumItems		;		lda	<NumFolders		;always say "Preparing to copy...";		bne	@sayPrepare		;(for now);		lda	<NumFiles;		cmp	#10;		blt	@noPrepare		@sayPrepare	pea	15		pea	30		_MoveTo		pushlong #strAlloc		_DrawString@noPrepare		jsr	GetCatalogs		;get catalogs for all selected icons		bcc	@noQuit		brl	CatErr1			;Catalog routine got an	error@noQuit		lda	<NumCats		beq	noCatalogs				jsr	AddSrcSlash		;add separator after src pathname		jsr	GetDstFileSys		;added 08/03/88 DJB		bcs	CatErr			;user canceled from "insert disk"		jsr	CheckReadOnlyDest	;%%% shouldn't this be done before we even try to read		bcs	CatErr			;%%% the source catalog? - 19-Jan-93 JCM		jsr	DoFileCopy		;copy the files		jsr	SetIconBits		;copy flag bits	into IconObj records;		import DisposeHandleGlueCatLoop		jsl DisposeHandleGlue		;dispose of catalogs		dec	<NumCats		bne	CatLoop		noCatalogs	jsr	FileCopyClose		jmp	StdEnd; JAM 5/18/89 (Fixing BRC #47828); If we got an access error during the catalog operation, it hasn't been reported; yet, because we need more context to decide between simple "access error" and; "irreconcilable file name clash" (FICantMove error).; This code works because I modified Catalog routines to to return the error code in Y!!!; Bogosity to the max!CatErr1		cpy	#$4E			; was it access error		bne	CatErr		phy		lda	#rasNoAccess		jsl	doAlertWindow		ply		secCatErr		lda	#$FFFF			;got an	error from Catalog routine		sta	<Error			;so - quit and return an error		lda	<NumCats		;any catalogs to dispose of?		bne	CatLoop			;yes		jsr	FileCopyClose		jmp	StdEnd			;no*** Removed 17-Aug-92 DAL -- no longer called;;---------------------------------------------------------------;; CopyOptions;;---------------------------------------------------------------;;CopyOptions;		jsl	SaveCursor;		jsl	ArrowCursor;		jsl	WindowGlobalON;;		pha;		pha;		lda #0;		pha;		pha				;titlePtr;		pha;		pha				;refCon is ptr to our window info block;		pha;		pha				;content draw proc;		pha;		pha				;window defproc;		pea	2			;refIsResource;		pha;		pea	7			;window resource we want;		pea	$800e			;rWindParam1;		_NewWindow2;		;		jsl	WindowGlobalOFF;		pulllong fileWindowPtr;		bcc	@loop;;;;; close the window only if something bad happened and we actually have a window pointer;; because something could have happened when we went to add controls (but didn't;; get created because we couldn't find the disk or the resource);;;		lda	fileWindowPtr+1;		beq	@leave;;@done		jsl	CloseFileWindow;;@leave		jsl	RestoreCursor;;		lda	#$FFFF			;cancel, cancel;		sec;		rts;;;;; now that we've set all the controls values, use doModalWindow to play with everything;;;@loop		pha;		pha;		pea	0;		lda	>finderTaskRecord;		pha			;push the task record's ptr;		lda #0;		pha;		pha			;update proc;		pea $8000;		pha			;eventHook;		pha;		pha			;beep proc;		pea	$c010		;flags;		_DoModalWindow;;		pla;		plx;		cmp	#2;		blt 	@loop;;		dec	a;		dec	a;		asl	a;		tax;		lda	returns,x;		pha;;		jsl	RestoreCursor;;		jsl	CloseFileWindow;;		pla;		asl	a			;button	ID returned in A;		bmi	PUDone			;'Cancel' selected;		ror	a			;restore hi bit	of button ID;		sta	<DelAllDups		;and save;		clc				;indicate no error;PUDone		rts;;;;; locals;;;;		EXPORT	fileWindowPtr;fileWindowPtr	dc.L	0;returns		dc.w	$0000;		dc.w	$8001;		dc.w	$0001;		dc.w	$FFFF;---------------------------------------------------------------;; CompareVols;; Return SEC if C1_SrcPathNmae and C1_DstPathName are on different; volumes, or if the Option key is down.;;---------------------------------------------------------------CompareVols*** added 17-Aug-92 DAL -- experimentally make Option do a copy even to the same disk		lda >FinderDPage		tax		lda >modifiers,x		and #$0800		bne CVReturn*** end 17-Aug-92		sep	#$20		LONGA OFF		ldx	#0			;determine length of source volume nameCVSrcLoop	inx		lda	C1_SrcPathName+2,x		cmp	#SEPARATOR		;GS/OS separator character		bne	CVSrcLoop		stx	<SrcVolLen		;and save		ldx	#0			;determine length of dest volume nameCVDstLoop	inx		lda	C1_DstPathName+2,x		cmp	#SEPARATOR		;GS/OS separator character		bne	CVDstLoop		stx	<DstVolLen		;and save		cpx	<SrcVolLen		;are the lengths the same?		bne	CVReturn		;no - so volumes not the same		pha				;25-Mar-93 JCM - scratch spaceCVCmpLoop	lda	C1_SrcPathName+1,x	;compare the volume names*** Lots o' changes - 25-Mar-93 JCM - Make this thing case-insensitive.		cmp	#'a'		blt	@saveChar				cmp	#'z'+1		bge	@saveChar		and	#$DF			;convert to uppercase		@saveChar	sta	1,s		lda	C1_DstPathName+1,x		cmp	#'a'		blt	@compareChars				cmp	#'z'+1		bge	@compareChars		and	#$DF			;convert to uppercase@compareChars	cmp	1,s		bne	CVReturn2		;not the same		dex		bne	CVCmpLoop				pla				clc								bra	CVReturnCommon		;volumes are the same		CVReturn2	plaCVReturn	sec				;volumes are differentCVReturnCommon	rep	#$20		LONGA ON		rts				;return	'equal'	if vol names are same*** End - 25-Mar-93 JCM;---------------------------------------------------------------; Get the destination file system ID  (ALSO STUFFS <DestDeviceNumber per JAM 06/01/89);---------------------------------------------------------------		ENTRY	GetDstFileSysGetDstFileSys		lda	C1_DstPathName		pha				;save length of dest path		sep	#$20			;go into 8-bit mode		LONGA OFF				ldx	#0			;determine length of dest volume nameGFSLoop		inx		lda	C1_DstPathName+2,x		cmp	#SEPARATOR		;GS/OS separator character		bne	GFSLoop		stx	C1_DstPathName				rep	#$20			;go back to 16-bit mode		LONGA ON				lda	#1			;start with default (ProDOS)		sta	<DstFileSysID				lda	#C1_DstPathName		;set up	ptr to dest pathname for		sta	GDN_Name		;and for GetDevNum to use		sta	<PathNamePtr		lda	#^C1_DstPathName		sta	GDN_Name+2		sta	<PathNamePtr+2		jsr	GetDevNum		;get device #		bcs	GFSReturn		;got error				lda	GDN_DevNum		sta	<DestDeviceNumber	; JAM 06/01/89 Fixing BRC #49639		sta	DI_DevNum		jsr	GetDevInfo		;convert device	# into device name		bcs	GFSReturn		;got error		jsr	GetVolInfo		;get file system ID		bcs	GFSReturn		;got error		lda	V_FileSys		sta	<DstFileSysIDGFSReturn		pla				;restore length of dest path		sta	C1_DstPathName		rts;---------------------------------------------------------------; CompareNames;---------------------------------------------------------------CompareNames		sep	#$20		LONGA OFF		ldx	C1_SrcPathName		;get length of source pathname		cpx	C1_DstPathName		;are the pathname lengths the same?		bne	@done			;no - so names are different		inx@loop		lda	C1_SrcPathName,x	;compare the names		cmp	C1_DstPathName,x		bne	@done			;not the same		dex		bne	@loop@done		rep	#$20			;go back to 16-bit mode		LONGA ON		rts				;return	'equal'	if names are same;---------------------------------------------------------------; CountIcons;---------------------------------------------------------------		IMPORT	magicToDo		;in data.aiiCountIcons		stz	<NumFiles		;init #	of selected icons		stz	<NumFolders		stz	numMagicFiles		;18-Jan-93 JCM@loop		inc	<NumFiles		;inc # of selected icons		lda	<NumFiles		cmp	#MaxIcons+1		;too many icons	to copy	at same	time?		bcs	TooManyIcons		;yes		*** Added - 18-Jan-93 JCM - We now handle magic routing here. If magicToDo is true (it was set in dragIt in***		     	    icons.aii), then we need to match each file against the magicTypeTable. If we get***			    no matches, then we don't query the user about us doing this for them.		ldx	#0			;we're just counting routable files, not copying		jsr	IsFileMagic		;find out if we need to place this one						bcs	@getNextSelected	; nope				inc	numMagicFiles@getNextSelected jsr	GetNextIcon		;find next selected icon*** end - 18-Jan-93 JCM		bcs	@doneIcons		ldy	#icFType		lda	[<IconPtr],y		cmp	#$000F		bne	@loop		inc	<NumFolders		bra	@loop			;loop until no more selected icons@doneIcons	ldy	#icFType		;always check the last one on the way out		lda	[<IconPtr],y		cmp	#$000F		bne	@noMoreFolders		inc	<NumFolders@noMoreFolders		lda	<IconListHndl		;restore handle	to first icon in list		sta	<IconHndl		lda	<IconListHndl+2		sta	<IconHndl+2		jsr	GetSelIcon		;search	list for first selected	icon*** Added - 18-Jan-93 JCM - See if there are any files to route. If so, ask the user if they really want us***			    to do it.		lda	#rasRoutingSingle	;assume only copying one file this time		ldx	numMagicFiles		;how many files to route?		beq	@exitNoRouting		; none, don't ask		dex						beq	@askAboutRouting	; only one					dec	a			;#rasRoutingMultiple = #rasRoutingSingle - 1@askAboutRouting 		jsl	doAlertWindow		;ask if they want routing to be done*** Added - 24-Mar-93 JCM - Let's try two buttons for now.;		bne	@shouldWeRoute		; it wasn't Cancel, see if we should route		bne	@exitCountIcons*** End - 24-Mar-93 JCM		sec				;the user chose Cancel, so exit without copying any files				rts	*** Added - 24-Mar-93 JCM - Let's try two buttons for now.;@shouldWeRoute	dec	a;		bne	@exitCountIcons		;they want us to route		*** End - 24-Mar-93 JCM@exitNoRouting	lda	#0			;they chose to not let us route, so flag to copy normally		sta	>magicToDo@exitCountIcons	clc				;indicate no error*** end - 18-Jan-93 JCM		rts;; augh, say we can only copy 1000 icons at a time;TooManyIcons	lda	#rasTooMany		jsl	doAlertWindow		sec		rts;---------------------------------------------------------------; GetCatalogs;---------------------------------------------------------------GetCatalogs		pla				;get return address		sta	<RetAdrs		;and save		stz	<NumFiles		;zero out counters		stz	<NumCats		stz	<TotalEOF		stz	<TotalEOF+2GCLoop		jsr	MakeSrcName		;make pathname for icon		bcs	GCDone			;name too long		stz	srqCopyOutParms+2		pea	$0106			;finderSaysBeforeCopy		ldx	#0		pea	$8000			;how = send to first guy who accepts it		phx		phx				;target = nil		pushlong #srqCopyParms		pushlong #srqCopyOutParms	;dataOut = copyoutparms		_SendRequest		bcs	@continue		lda	srqCopyOutParms+2		bne	@abort@continue		ldx	#1			;store filecount in first cat entry		jsr	CatalogSrc		;get catalog for icon		bcs	GCDone			;Catalog routine got an	error		adc	<NumFiles		;# of files in catalog returned	in A		sta	<NumFiles		;add to	total #	of files		inc	<NumCats		;increment # of	catalogs				lda	<CatalogEOF		clc		adc	<TotalEOF		sta	<TotalEOF		lda	<CatalogEOF+2		adc	<TotalEOF+2		sta	<TotalEOF+2	@abort		jsr	GetNextIcon		;get next selected icon		bcc	GCLoop			;loop until done with all selected icons		lda	<SrcPathLen		;reset length of srcpathname back to		sta	C1_SrcPathName		;what it was when routine was called		clc				;indicate no errorGCDone		PushZWord <RetAdrs		;push return address on	stack		rts				;and return;---------------------------------------------------------------; SetIconBits;---------------------------------------------------------------SetIconBits		pla				;get return address		sta	<RetAdrs		;and save		lda	<NumCats		;start with first catalog		sta	<CatIndex		lda	<IconListHndl		;retrieve handle to start of icon list		sta	<IconHndl		ora	<IconListHndl+2		;is the	handle 0?		beq	SIBRet			;yes		lda	<IconListHndl+2		sta	<IconHndl+2		jsr	GetSelIcon		;search	list for first selected	iconIconLoop	jsr	GetNextCat		;get ptr to next catalog		ldy	#2		lda	[<CatPtr],y		;get flag from first catalog entry		bpl	NextIcon		;if hi bit clear, flag is not valid		and	#$7FFF			;mask off hi bit		ldy	#icFlag		ora	[<IconPtr],y		;and OR	the bit	settings into the		sta	[<IconPtr],y		;Flag field of the IconObj recordNextIcon	jsr	GetNextIcon		;get next selected icon		bcc	IconLoop		;loop until done with all selected iconsSIBRet		PushZWord <RetAdrs		;push return address on	stack		rts				;and return*** 18-Jan-93 JCM - This supports the Macintosh way of handling certain files that are dragged onto the***		    System folder icon. We notice what type of file they are copying (or types, in the***		    case of multiple files), and place it in the appropriate folder, if the user wishes***		    us to.;---------------------------------------------------------------;; DoMagicRouting -;		EXPORT	DoMagicRoutingDoMagicRouting	NAME		IMPORT	magicToDo		;in data.aii		IMPORT	GetBootVolume		;in alert.aii		IMPORT	C1_BootName		;in buffers.aii		IMPORT	wstrSystem		;in strings.aii		pha				;dest filename append flag; This hacky, icky kludge is because copying from the same volume (as opposed to copying from a; different volume - duh), work fundamentally differently, and we don't have access to the selected; icons any more (at least not easily or speedily). So, we do our determination if the file is; special with IsFileMagic2 when we are called with zero in the accumulator. That indicates we also don't; stuff a file name onto the end of the path (code in the write section will do that for us). If you don't; understand, then re-write it.		beq	@callIsMagic2		;should be set if accumulator is loaded right before call				ldx	#$8000			;we're actually copying now, not just counting routable files		jsr	IsFileMagic		;is the current file (<IconPtr), one we know about?         		bcc	@buildThePath		; yep, deal with it		bmi	@buildThePath2		; not a special file, but we still need to copy it 		bra	@exitMagicErr		; apparently not (or user said don't route files)		@callIsMagic2	ldy	#8			;fileType		lda	[<BufPtr],y		sta	magicFileType		iny		iny		lda	[<BufPtr],y		sta	magicAuxType		ldx	#$8000			;we're actually copying now, not just counting routable files		jsr	IsFileMagic2		;is the current file one we know about?		bcc	@buildThePath		; yep, deal with it		bmi	@buildThePath2		; not a special file, but we still need to copy it		bra	@exitMagicErr		; apparently not (or user said don't route files); %%% This would be a fine place to send finderSaysDuringRouting or some such request.		; We now have a pointer to a Pascal-type string which represents the folder (or quite possibly nested; folders) in which this single file needs to be routed. The pointer is in Y (high)/Acc (low).@buildThePath	phy		pha				;source folder string ptr (for PathAddName)				jsr	SetC1_DstToSystemFolder		PushLong #C1_DstPathName	;dest		jsl	PathAddName		;now add in the folder within the system folder		@buildThePath2	lda	C1_DstPathName		;since we've changed the dest path, we need to update 		sta	<DstPathLen		; the string length which has been stashed away			lda	1,s			;are we to append the filename?		bne	@copySameVol		; yup, do it			jsr	AppendSepToC1_Dst			bra	@exitMagicNoErr		@copySameVol	jsr	MakeDstName		;append the current file name to the new routed pathname		;		bra	@exitMagicNoErr@exitMagicErr@exitMagicNoErr	clc		pla				;dest filename append flag		rts		SetC1_DstToSystemFolder		jsl	GetBootVolume		;we need a real path to splice the folders to		PushLong #C1_BootName		;source		PushLong #C1_DstPathName	;dest		jsl	WStringCopy		;move the boot vol name to the beginning of the buffer				PushLong #wstrSystem		;source		PushLong #C1_DstPathName	;dest		jsl	PathAddName		;append the string "System"		rts		AppendSepToC1_Dst				ldx	C1_DstPathName		;get the current length of the pathname		lda	C1_DstPathName+2,x	;get the last character from the string		and	#$FF00			;non-destructively add a trailing ':'		ora	#':'		sta	C1_DstPathName+2,x	;stuff the new ':' onto the end of the string		inx		stx	C1_DstPathName		;update the wstring length to include the end ':'				rts;---------------------------------------------------------------;; IsFileMagic - Given an icon pointed at by <IconPtr, this function walks a hard-coded fileType table;		to determine if the file is 'magic'. These files are ones that we know belong in certain;		folders within the System folder. If it is magic, the carry is returned clear.;IsFileMagic	NAME		lda	>magicToDo		;is the dest the System folder?		beq	exitIsFileMagic		; nope, don't touch this one		ldy	#icFType		;index to the source file's type within the current IconObj		lda	[<IconPtr],y		;is this a type we know about?		sta	magicFileType		iny		iny				;move to the IconObj.icAuxType field		lda	[<IconPtr],y		;just get the bits that we want to check		sta	magicAuxType		bra	magicCommon; With this entry, the caller sets up the fileType and auxType.IsFileMagic2	NAME		lda	>magicToDo		;is the dest the System folder?		beq	exitIsFileMagic		; nope, don't touch this one; Now that we know the dest is the System folder, let's see if this file should be dumped somewhere within it.magicCommon	stx	typeOfMagic		;tells if we're copying or just counting magic files		ldx	#endMagicTypes-magicTypesTable ;start with the last item in the table		@checkThisType	lda	magicTypesTable,x	;snag a file type from the table		cmp	magicFileType		bne	@checkNextMagicType	; nupe, see if we have more to do; Ok, we've matched the fileType, now let's see if the auxType is one that we'll accept.								;move to the auxType AND mask		lda	magicAuxType		and	magicTypesTable+2,x		cmp	magicTypesTable+4,x	;do we want this one (move to the auxType compare bits)?		bne	@checkNextMagicType	; no way dude, run like hell		; Ok, this file is indeed one we can specially place. Return to the caller a pointer to a string which; represents the folder (or nested folders) in which this file should be placed.			lda	magicTypesTable+6,x	;get the low word of the folder string ptr		ldy	magicTypesTable+8,x	;and the high word of the pointer				clc				rts@checkNextMagicType		txa		sec		sbc	#magicRecSize		;index to the previous record		tax		bpl	@checkThisType* Since the file we were just handed isn't routable, we need to see if we're actually in the process* of copying files. If we are, then we need to restore the destination pathname to be simply the* system folder. We don't want this file to be copied to the same place the last file was routed.		lda	typeOfMagic		;are we just counting files?		bpl	exitIsFileMagic		; yup, no need to restore the pathname		jsr	SetC1_DstToSystemFolder	;restore pathname to "<bootvol>:System" (<bootvol> is fully expanded)		lda	#$FFFF			;load a negative val to signal that caller should continueexitIsFileMagic sec		rtstypeOfMagic	dc.w	0			;are we counting magic files ($0000) or copying them ($8000)?numMagicFiles	dc.w	0			;number of files to route as discovered by CountIconsmagicFileType	dc.w	0magicAuxType	dc.w	0			;%%% I probably should do all four bytes...; %%% Temp locals - move to a data seg later?; %%% Write an init function that clears the count words to zero before we start.*** Note--table is searched end-to-beginning, so put the more generic entries earlier in the table.magicTypesTable			dc.w	$C7			;Control Panel		dc.w	$0000			;auxType AND mask		dc.w	$0000			;auxType compare bits		dc.l	CDevsFolderStr		;folder to drop these files into		dc.w	$0000			;number of files we just copied of this typemagicRecEnd		dc.w	$B8			;New desk accessory		dc.w	$0000		dc.w	$0000		dc.l	DAFolderStr		dc.w	$0000					dc.w	$B9			;Classic desk accessory		dc.w	$0000		dc.w	$0000		dc.l	DAFolderStr		dc.w	$0000					dc.w	$BB			;Driver		dc.w	$0000		dc.w	$0000		dc.l	DriversFolderStr		dc.w	$0000					dc.w	$BB		dc.w	$7F00			;AND mask		dc.w	$0400			;Media Ctl drivers have $04xx or $84xx		dc.l	MediaCtlFolderStr		dc.w	$0000		dc.w	$BC			;Finder extension		dc.w	$7FFF		dc.w	$0001		dc.l	FEFolderStr		dc.w	$0000					dc.w	$C8			;Font		dc.w	$8000			;bit 15 = do not route font (1-Feb-93 DAL)		dc.w	$0000		dc.l	FontsFolderStr		dc.w	$0000					dc.w	$BD			;File System Translator		dc.w	$0000		dc.w	$0000		dc.l	FSTsFolderStr		dc.w	$0000					dc.w	$D8			;Sound resource file		dc.w	$FFFF		dc.w	$0003		dc.l	SoundsFolderStr		dc.w	$0000					dc.w	$B6			;Permanent initialization file		dc.w	$0000		dc.w	$0000		dc.l	SetupFolderStr		dc.w	$0000					dc.w	$B7			;Temporary initialization file		dc.w	$0000		dc.w	$0000		dc.l	SetupFolderStr		dc.w	$0000			endMagicTypes	dc.w	$BA			;Tool		dc.w	$0000		dc.w	$0000		dc.l	ToolsFolderStr		dc.w	$0000			magicRecSize	equ	magicRecEnd-magicTypesTable	;length of each individual record		string	GSOSCDevsFolderStr	dc.b	'CDevs'DAFolderStr	dc.b	'Desk.Accs'DriversFolderStr dc.b	'Drivers'MediaCtlFolderStr dc.b	'Drivers:Media.Control'FEFolderStr	dc.b	'FinderExtras'FontsFolderStr	dc.b	'Fonts'FSTsFolderStr	dc.b	'FSTs'SoundsFolderStr	dc.b	'Sounds'SetupFolderStr	dc.b	'System.Setup'ToolsFolderStr	dc.b	'Tools'*** end 18-Jan-93 JCM		ENDP****************************************************************** CopyDisk*****************************************************************CopyDisk	PROC		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	arrowCursor		IMPORT	watchCursor		IMPORT	PathGetName		IMPORT	c1_dest		IMPORT	c1_source		IMPORT	doAlertCopy		IMPORT	finderTaskRecord		IMPORT	CopyUpdate		IMPORT	DrawCopyControls		IMPORT	lastThermo		IMPORT	WindowGlobalON		IMPORT	WindowGlobalOFF		IMPORT	isFormattable		IMPORT	isReadOnly		IMPORT	WStrCompare		IMPORT	EjectDisk		IMPORT	doAlertWindow		IMPORT	OOMDumped		IMPORT	FileCopyOpen		IMPORT	FileCopyClose		IMPORT	strAlloc		IMPORT	DrawCopyControls		import	drawNumItems		Preference	equ	10OptionKey	equ	Preference+2DstHndl		equ	OptionKey+2SrcHndl		equ	DstHndl+4		;input parametersParamSize	equ	12			;# of bytes of input paramsSrcSize		equ	ZEnd			;zero page tempsSrcUsed		equ	SrcSize+4AdjSrcUsed	equ	SrcUsed+4DstSize		equ	AdjSrcUsed+4DstFree		equ	DstSize+4SameFlag	equ	DstFree+4SaveLength	equ	SameFlag+2segmentIndex	equ	SaveLength+4startBlock	equ	segmentIndex+4handleListHandle equ	startBlock+4handleListPtr	equ	handleListHandle+4pointerListHandle equ	handleListPtr+4pointerListPtr	equ	pointerListHandle+4endBlocks	equ	pointerListPtr+4currentSegment	equ	endBlocks+4NextContiguous	equ	currentSegment+2MaxContiguous	equ	NextContiguous+4ContiguousSoFar	equ	MaxContiguous+4lastTick	equ	ContiguousSoFar+4NumBlocksToRW	equ	LastTick+2		IF	NumBlocksToRW+4>$FF THEN			WRITE 'NumBlocksToRW = '			WRITELN NumBlocksToRW			WRITELN 'WARNING... Direct page variable overflow!'			AERROR 'CopyDisk extended its local DP too far'		ENDIFNumBlocks	equ	NumFiles		;so message routines will work		phd		tcd		phb		phk		plb		lda	#ParamSize		sta	<NumParams		;# of bytes of input params		jsl	SaveCursor		jsl	watchCursor		stz	<WhichMsg		;no message for	now		stz	AbortFlag		;added 06/09/88 DJB		stz	<SameFlag		;init flag		stz	<DelAllDups		;init to 0 in case we copy by files		stz	<SrcPathLen		;init src/dst pathname to null		stz	<DstPathLen		stz	<NamesWereXLated	; JAM 06/01/89 Fixing BRC #49639		lda	#C1_DstPathName		;set up	ptr to dest pathname for		sta	<PathNamePtr		;dialog	to use		sta	E_VolName		;and for EraseDisk to use		sta	FI_Name			;and for GetFileInfo to	use		sta	GDN_Name		;and for GetDevNum to use		lda	#^C1_DstPathName		sta	<PathNamePtr+2		sta	E_VolName+2		sta	FI_Name+2		sta	GDN_Name+2		lda	#C1_SrcPathName		;set up	ptr to src pathname for		sta	<OtherPtr		;dialog	to use		lda	#^C1_SrcPathName		sta	<OtherPtr+2		lda	SrcHndl,s		;get handle to source disk icon		sta	<IconHndl		sta	<IconListHndl		lda	SrcHndl+2,s		sta	<IconHndl+2		sta	<IconListHndl+2		jsr	DerefIcon		;dereference the handle		jsr	MakeINamePtr		;create	ptr to icon's name		jsr	MakeSrcName		;create	pathname for source disk		bcc	@nameOK		brl	doQuit			;name too long@nameOK		ldy	#icFileInfo		lda	[<IconPtr],y		sta	<SrcFileSysID		;set the file system for the source disk				ldy	#icFBytes		lda	[<IconPtr],y		;get size of src disk in blocks		sta	<SrcSize		;and save		iny		iny		lda	[<IconPtr],y		sta	<SrcSize+2		lda	DstHndl,s		;get handle to destination disk	icon		sta	<IconHndl		lda	DstHndl+2,s		sta	<IconHndl+2		jsr	DerefIcon		;dereference the handle		jsr	MakeINamePtr		;create	ptr to icon's name		jsr	MakeDstName		;create	pathname for dest disk		bcs	doQuit			;name too long				ldy	#icFileInfo		lda	[<IconPtr],y		sta	<DstFileSysID		;set the file system for the destination file system		ldy	#icFBytes		lda	[<IconPtr],y		;get size of dest disk in blocks		sta	<DstSize		;and save		iny		iny		lda	 [<IconPtr],y		sta	<DstSize+2		cmp	<SrcSize+2		;compare disk sizes		bne	@notTheSame		lda	<DstSize		cmp	<SrcSize		bne	@notTheSame		inc	<SameFlag		;set flag to indicate same size	disks@notTheSame		lda	OptionKey,s		;was Option key	held down?		beq	NoOption		;no		ldy	<DstFileSysID		jsr	CheckReadOnlyDest		bcs	doQuit		pushlong #c1_source		pushZLong <OtherPtr		jsl	PathGetName		lda	>c1_source		xba		sta	>c1_source		pushlong #c1_dest		pushZLong <PathNamePtr		jsl	PathGetName		lda	>c1_dest		xba		sta	>c1_dest		brl	CopyOptions		;yes - so put up copy options dialogNoOption	lda	<SameFlag		;are the disks the same	size?		bne	SameSize		;yes		brl	DiffSizes		;no;------------------------------------------------------------------------------doAbort		lda	#$e000		sta	<Error			;return	error		jmp	StdEnd;------------------------------------------------------------------------------doQuit		lda	#$FFFF		sta	<Error			;return	error		jmp	StdEnd;------------------------------------------------------------------------------SameSize	lda	#rasReplaceDisk		jsl	doAlertCopy		beq	doAbort		brl	ReplaceFiles		;'OK' selected;------------------------------------------------------------------------------DiffSizes		jsr	CheckReadOnlyDest		bcs	doQuit				lda	#rasDiskInFolder	;ask if	want to	put contents of	source		jsl	doAlertCopy		beq	doAbort;------------------------------------------------------------------------------CreateFolder	pea	#$0000			; indicate no block copy		jsr	CheckRoom		;check if enough room to copy src files		pla				; eliminate flag		bcs	doAbort			;error or no room		stz	<NumFiles		jsr	FileCopyOpen		bcs	doAbort				jsr	DrawCopyControls		lda	#1			;start counting upwards from 1		ldy	#0		jsr	DrawNumItems				pea	15		pea	30		_MoveTo		pushlong #strAlloc		_DrawString		ldx	#1			;store filecount in first cat entry		jsr	CatalogSrc		;catalog source	disk		bcc	@catalogOK		cpy	#$4e		bne	@goDoQuit		lda	#rasNoPrivs		jsl	doAlertWindow@goDoQuit	sec		brl	@createQuit		;Catalog routine got an	error@catalogOK		sta	<NumFiles		;# of files in catalog returned	in A		lda	#1		sta	<NumCats		;used by DoFileCopy		pha				;space for result		pha		PushZWord <NumFiles		;# of files on source disk		PushWord #13			;# of files in a directory index block		_UDivide			;calc #	of blocks needed for subdir		clc				;entry since we're creating a folder		pla				;# of blocks needed - 1		plx				;ignore	remainder		inc	a			;add 1 to get #	of blocks needed		adc	<AdjSrcUsed		;and add to blocks used	on src disk		sta	<AdjSrcUsed		;and save		jsr	CheckRoom2		;recheck if enough room	on dest	disk		bcc	@CFCont;		import DisposeHandleGlue		jsl DisposeHandleGlue		;error or no room - get	rid of catalog		bra	@createQuit@CFCont		lda	#1		sta	C1_SrcPathName		lda	#SEPARATOR		sta	C1_SrcPathName+2	;remove	src vol	name except for	separator		jsr	AddDstSlash		;add separator after dest vol name		inc	<Disk2Sub		;indicate disk to subdirectory copy		jsr	GetDstFileSys		;added 08/03/88 DJB		bcs	@createQuit						lda	<CatalogEOF		sta	<TotalEOF		lda	<CatalogEOF+2		sta	<TotalEOF+2				jsr	DoFileCopy		;copy the files		lda	<IconListHndl		;get handle to source disk icon		sta	<IconHndl		lda	<IconListHndl+2		sta	<IconHndl+2		jsr	DerefIcon		;dereference the handle		ldy	#icFlag		lda	[<IconPtr],y		ora	#ICCopy		sta	[<IconPtr],y		jsl DisposeHandleGlue			;dispose of catalog		jsr	FileCopyClose				lda	#$8000			;indicate disk copied to a folder on src		sta	<Error		jmp	StdEnd			;done@CreateQuit	jsr	FileCopyClose		lda	#$FFFF		sta	<Error		jmp	StdEnd		;-------------------------------------------------------------------------------ReplaceFiles	jsr	findEraseFST		bcc	@noErase				lda	#C1_DstPathName		sta	GDN_Name		; set up ptr to dst disk name		lda	#C1_DstPathName>>16		sta	GDN_Name+2		jsr	GetDevNum		;find the destination disk (not yet possibly munged)		bcs	@goQuit		jsr	EraseDst		;erase destination disk		bcc	@erased@goQuit		brl	doQuit			;got error@erased		lda	GDN_DevNum		jsr	RebuildVCR		;rebuild the vcr for the destination disk@noErase	lda	<SameFlag		;are disks the same size?		beq	AddFiles		;no - so must copy by files		pea 	#$FFFF			; indicate block copy imminent		jsr	CheckRoom		;get info on src disk		pla				; get rid of flag		bcs	rfQuit			;error or no room		lda	#C1_DstPathName		;create	ptr to DstPathName		sta	<PathNamePtr		;for dialog to use		lda	#C1_DstPathName>>16		sta	<PathNamePtr+2		brl	BlockCopy		;copy by blocksrfQuit		brl	doQuit;-------------------------------------------------------------------------------AddFiles		stz	<NumCats		;zero out counters		stz	<NumFiles		stz	<Error			;clear out flag	in case	disk is	empty		pea	#$0000			; indicate no block copy		jsr	CheckRoom		;check if enough room to copy src files		pla				; eliminate flag		bcs	@goDoQuit		;error or no room		ldx	#0			;don't store filecount in first cat entry		jsr	CatalogSrc		;get catalog of	source disk		bcc	@catalogOK		cpy	#$4e		bne	@goDoQuit		lda	#rasNoPrivs		jsl	doAlertWindow@goDoQuit	sec		brl	AFQuit			;Catalog routine got an	error@catalogOK		inc	<NumCats		;increment # of	catalogs		lda	#1		sta	<CatIndex		;set up	index to catalog		jsr	GetNextCat		;get ptr to first entry	in catalog		bcc	@gncOK		brl	AFLoop2			;which is the entry for	the disk name@gncOK				lda	#C1_SrcPathName		;set up	ptr to SrcPathName		sta	<PathNamePtr		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		jsr	GetNextFile		;get ptr to first file entry (add separator)		bcc	@gnfOK		brl	AFLoop2			;no files on disk@gnfOK		lda	C1_SrcPathName		;get length of source disk name		sta	<SaveLength		;with following	separator and save		stz	<TotalEOF		stz	<TotalEOF+2		jsr	FileCopyOpen		bcs	@goDoQuit				jsr	DrawCopyControls		lda	#1			;start counting upwards from 1		ldy	#0		jsr	DrawNumItems				pea	15		pea	30		_MoveTo		pushlong #strAlloc		_DrawStringAFLoop		jsr	MakePathName		;make pathname for catalog entry		bcs	AFQuit			;pathname too long		ldx	#1			;store filecount in first cat entry		jsr	CatalogSrc		;get catalog for this entry		bcc	@catalogOK		cpy	#$4e		bne	@goDoQuit		lda	#rasNoPrivs		jsl	doAlertWindow@goDoQuit	sec		bra	AFQuit			;Catalog routine got an	error@catalogOK		adc	<NumFiles		;# of files in catalog returned	in A		sta	<NumFiles		;add to	total #	of files		inc	<NumCats		;increment # of	catalogs				lda	<CatalogEOF		clc		adc	<TotalEOF		sta	<TotalEOF		lda	<CatalogEOF+2		adc	<TotalEOF+2		sta	<TotalEOF+2				lda	#0			;zero out offset so we skip directly		sta	[<CatPtr]		;to next catalog entry		jsr	GetNextFile		;get next catalog entry		bcc	AFLoop			;loop until done with all cat entries		lda	<SaveLength		;retrieve length of source disk	name		sta	C1_SrcPathName		;with ending separator		jsr	AddDstSlash		;add separator to dest disk name		dec	<NumCats		;don't count disk catalog when copying		jsr	GetDstFileSys		;added 08/03/88 DJB				jsr	DoFileCopy		;copy the files		inc	<NumCats		;recount disk catalog so it's disposedAFLoop2		jsl DisposeHandleGlue		;dispose of catalogs		dec	<NumCats		bne	AFLoop2		lda	#$8000			;indicate disk copied to root of src		sta	<Error			;to signal caller not to kill root/data files		jsr	FileCopyClose		jmp	StdEnd			;doneAFQuit		lda	#$FFFF			;got an	error		sta	<Error			;so - quit and return an error		lda	<NumCats		;any catalogs to dispose of?		bne	AFLoop2			;yes		jsr	FileCopyClose		jmp	StdEnd			;no*-----------------------------------------------**	Modified to work with 32K Segments	** 4/19/89 - DJB					**-----------------------------------------------*		IMPORT	CloseCopyWindow		;in util.aii - 27-Jan-93 JCMBlockCopy		lda	<SrcSize		;get # of blocks on disk		sta	<NumBlocks				lda	<SrcSize+2		sta	<NumBlocks+2				stz	<NumItems		;done zero blocks so far		stz	<NumItems+2		_FlushGS FlushParms		;flush everything before copying...				jsl	WindowGlobalON		pha		pha		lda #0		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pushlong #CopyUpdate+$C0000000	;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pha		pea #$000E			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2				jsl	WindowGlobalOFF		pulllong copyWindowPtr		bcc	@openOK;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	copyWindowPtr+1		beq	@leave@done		jsl	CloseCopyWindow		stz	copyWindowPtr+1@leave		sec		brl	Quit2b@openOK		pha		pha		_GetPort		pulllong ourPort				pushlong copyWindowPtr		_SetPort		pha		pha		pushlong copyWindowPtr		pushlong #3		_GetCtlHandleFromID		;nuts, stuff on stack is backwards		ply		plx		pea	0		pea	280			;max value for dial, 100% (280 pixels)		phx		phy		_SetCtlTitle			;set the scale		lda	#NullStrg		; point to null string		sta	<FileNamePtr		lda	#NullStrg>>16		sta	<FileNamePtr+2		lda	#strAlloc		; point to 'Allocating memory'		sta	<RWPtr		lda	#strAlloc>>16		sta	<RWPtr+2		stz	lastThermo		lda	<NumBlocks		ldy	<NumBlocks+2		jsr	DrawMsg		jsr	DrawCopyControls;; now, allocate a lot of memory (maybe) for our block copy;		pha		lda #0		pha				;waitFromTime		pha				;delayTime		_WaitUntil		pla		sta	<lastTick				jsr	GetSegments		; allocate memory segments for block reads		bcc	@gotSegments		brl	Quit2			; got an error@gotSegments		pha				;wait half a second for this to register in the		pei	<lastTick		;user's eyeball		pea	$01e0			;30 ticks, half a second		_WaitUntil		pla@noWait		lda	#strReadingBlks		; point to 'Reading blocks...'		sta	<RWPtr		lda	#strReadingBlks>>16		sta	<RWPtr+2		lda	<NumBlocks		ldy	<NumBlocks+2		jsr	DrawMsg;; now that the dialog and memory finagling is out of the way, start copying the disk;		lda	#SegmentSize/512		sta	RWB_BlockNum		; start with block 72 (36k inwards)		stz	RWB_BlockNum+2		jsr	CheckKey		; was cancel selected ?		bcc	ReadIt		brl	Quit2			; yes so abort;; read another hunk of their disk;ReadIt		lda	RWB_BlockNum		; remember starting block		sta	<startBlock		lda	RWB_BlockNum+2		sta	<startBlock+2		lda	#C1_SrcPathName		sta	GDN_Name		; set up ptr to src disk name for call		sta	<PathNamePtr		; and dialog (if needed)		lda	#C1_SrcPathName>>16		sta	GDN_Name+2		sta	<PathNamePtr+2		lda	#strReadingBlks		; point to 'Reading blocks...'		sta	<RWPtr		lda	#strReadingBlks>>16		sta	<RWPtr+2				lda	Source_DevNum		;rebuild the source VCR as long as the source and		cmp	Dest_DevNum		;destination VCR's weren't the same from the		beq	@noBuildSourceVCR	;last time we looked at the source disk				sta	GDN_DevNum		jsr	RebuildVCR		bcs	@noBuildSourceVCR		pha		pushlong #Filename		pushZLong <PathnamePtr		jsl	WStrCompare		pla		bne	Ok2b;; we either couldn't build a VCR for the source disk, the source and destination disks were; last in the same device, or they swapped something new into the source disk, so go find; out where the source disk went to...;@noBuildSourceVCR		jsr	GetDevNum		; get device #		bcc	Ok2bQuit2b		brl	Quit2			; yes so abort		Ok2b		lda	GDN_DevNum		sta	RWB_DevNum		sta	Source_DevNum		stz	<segmentIndex		; start at first segmentReadLoop	jsr	SetParams		; set up block read parameters		jsr	CheckKey		; was cancel selected ?		bcs	Quit2b		jsr	SetEndBlocks				jsr	ScaleThermo				lda	<numBlocks		ldy	<numBlocks+2		jsr	DrawMsg			; update 'blocks left' msg		jsr	ReadBlocks		; read blocks into segment		bcs	Quit2b			; got error		jsr	UpdateNumItems				lda	<segmentIndex		; any more segments to fill ?		cmp	<segmentCount		bcs	WriteIt			; no		lda	RWB_BlockNum+2		bne	@notAtFront		lda	RWB_BlockNum		;did we go back and copy the first 32k yet? 		beq	WriteIT@notAtFront		jsr	NextBlockNum		brl	ReadLoop		; read another segment;; write out all those blocks we just read;WriteIt		lda	<startBlock		; restore starting block		sta	RWB_BlockNum		lda	<startBlock+2		sta	RWB_BlockNum+2		lda	#C1_DstPathName		sta	GDN_Name		; set up ptr to dst disk name for call		sta	<PathNamePtr		; and dialog (if needed)		lda	#C1_DstPathName>>16		sta	GDN_Name+2		sta	<PathNamePtr+2				lda	#strWritingBlks		; point to 'Writing blocks...'		sta	<RWPtr		lda	#strWritingBlks>>16		sta	<RWPtr+2		lda	Dest_DevNum		;rebuild the destination VCR so we don't go and		cmp	Source_DevNum		;poll all the drives unless the source and		beq	@noBuildDestVCR		;destination drives from last time were the same		sta	GDN_DevNum		jsr	RebuildVCR		bcc	@goodDestVCR				ldx	<DstFileSysID		cpx	#HFSFST		bne	@noBuildDestVCR				cmp	#$5a		bne	@noBuildDestVCR		;if there's a problem doing _Volume, find the disk@goodDestVCR	pha		pushlong #Filename		;if the disk in the drive is the same as what		pushZLong <PathnamePtr		;used to be there, we're OK		jsl	WStrCompare		pla		bne	Ok2a;; we either couldn't build a VCR for the destination disk, the source and destination disks were; last in the same device, or they swapped something new into the destination drive, so go find; out where the destination disk went to...;; PLUS, because of a deficiency in the HFS FST, we can't use Get_Dev_Num to do this, we have to do; it by hand, looking at each volume name for the destination volume.;@noBuildDestVCR		jsr	GetDestDevNum		; get device #		bcc	Ok2aQuit2a		brl	Quit2			; got an errorOk2a		lda	GDN_DevNum		sta	RWB_DevNum		sta	Dest_DevNum		stz	<segmentIndex		; start at first segmentWriteLoop	jsr	SetParams		; set up block write parameters		jsr	CheckKey		; was cancel selected ?		bcs	Quit2a		jsr	SetEndBlocks		; setup the end # of blocks if were about to go to the end		jsr	ScaleThermo		;scale NumItems against SrcSize*2				lda	<NumBlocks		ldy	<NumBlocks+2		jsr	DrawMsg			; update 'blocks left' msg		jsr	WriteBlocks		; write blocks from segment		bcc	@writeOK		brl	Quit2			; got an error@writeOK		lda	<NumBlocks		; update # of blocks left		sec		sbc	<NumBlocksToRW		sta	<NumBlocks		bcs	@NumBlocksNR		dec	<NumBlocks+2@NumBlocksNR		jsr	UpdateNumItems		lda	<NumBlocks		; any more blocks left to copy?		bne	@more					lda	<NumBlocks+2		beq	Done@more		jsr	NextBlockNum				lda	<segmentIndex		; any more segments to fill ?		cmp	<segmentCount		bcc	WriteLoop		; yes		brl	ReadIt			; no;; done with the main read/write loops, so go back and write the first 32k of the; destination volume;Done				lda	#280			;100% (280 pixels)		ldx	#0			;check NumItems against what it was last time		jsr	DrawThermo		lda	#0		tay		jsr	DrawMsg			; update 'blocks left' msg		lda	GDN_DevNum		sta	DI_DevNum		jsr	GetDevInfo		;get device name for the dest device		bcs	Quit2		stz	<Error			;don't return an error		jsr	freeSegments;; try to rename the destination disk back to what it was, but because of possible FST naming conflicts,; the destination disk might now not accept the name it once had.  if this is the case, then we need to; toss the disk out at the user having attempted the rename.;; also, we'll check to see if the destination disk's file system is now read-only, in which case it can't; be renamed and must be ejected;			jsr	FixName			;rename the destination (clone of our source) back		bcs	tossTheCookies				pea	$8005			;task accomplished		_SysBeep2		bra	BuildDestVCR		;to what it was, if an error happens, toss the disk out		tossTheCookies	lda	#$c000		sta	<Error				lda	Dest_DevNum		;toss the disk out of the last spot we knew where it was				pha				;(we REALLY don't want it around)		jsl	EjectDisk		bra	Exit		;; well, if they quit, or refuse to give us the destination or source disk, we end up here.; the idea is simple: if at all possible, erase the destination disk -- if, because both the; source and destination FSTs were read-only we aren't able to erase the destination volume,; we'll make it an unknown disk by killing the boot blocks and block 2, etc.;Quit2		jsr	FreeSegments		; get rid of memory segments				lda	#$FFFF		sta	<Error			; return an error		lda	Dest_DevNum		;rebuild the destination VCR so we don't go and		cmp	Source_DevNum		;poll all the drives unless the source and		beq	@noBuildDestVCR		;destination drives from last time were the same		sta	GDN_DevNum		jsr	RebuildVCR		bcc	@goodDestVCR				ldx	<DstFileSysID		;if it's an HFS disk, see if error $5a happened		cpx	#HFSFST			;and if it did, we're guaranteed that we've got the		bne	@noBuildDestVCR		;volume name by none other than Mark Day				cmp	#$5a		bne	@noBuildDestVCR		;if there's a problem doing _Volume, find the disk@goodDestVCR	pha		pushlong #Filename		;if the disk in the drive is the same as what		pushZLong <PathnamePtr		;used to be there, we're OK		jsl	WStrCompare		pla		bne	@gotDest@noBuildDestVCR	jsr	GetDestDevNum		;damn! they ejected the destination disk!		bcs	tossTheCookies		;well, then get rid of it!		@gotDest	jsr	findEraseFST		bcs	@erase					jsr	KillDisk		;if we don't have an FST to erase with,			bra	tossTheCookies		;then kill their disk dead and then eject it		@erase		jsr	EraseDst		; erase destination disk on abort/error		bcs	tossTheCookies		buildDestVCR	lda	GDN_DevNum		jsr	RebuildVCR		;rebuild the VCR for the destination disk;; just as we exit, check to see if the last swap that was made for these disks, if that swap was; done on the same device number, don't do a volume call to rebuild the VCR that got swapped out,; otherwise, if the drives were different, rebuild the source drive's VCR;Exit		lda	Source_DevNum		cmp	Dest_DevNum		beq	@sameDrive		lda	Source_DevNum		;rebuild the VCR for the source disk		jsr	RebuildVCR		@sameDrive	lda	copyWindowPtr+1		beq	@noClose		pushlong ourPort		_SetPort				jsl	CloseCopyWindow		stz	copyWindowPtr+1@noClose	stz	<WhichMsg		jmp	StdEnd;; UpdateNumItems -- add NumBlocksToRW to NumItems;UpdateNumItems		lda	<NumItems		; update # items left		clc		adc	<NumBlocksToRW		sta	<NumItems		bcc	@NumItemsNR		inc	<NumItems+2@NumItemsNR	rts;; setup the next block number to start reading/writing from/to in RWB_BlockNum;NextBlockNum		lda	RWB_BlockNum		; update starting block number		clc		adc	<NumBlocksToRW		sta	RWB_BlockNum		bcc	@RWBnr		inc	RWB_BlockNum+2		@RWBnr				lda	RWB_BlockNum		; did we reach the end of the platter yet?		sec		sbc	<SrcSize		lda	RWB_BlockNum+2		sbc	<SrcSize+2		bcc	@done			; if not, keep reading towards the end				stz	RWB_BlockNum		stz	RWB_BlockNum+2@done		rts;; read or write the correct number of blocks to the end of the disk;SetEndBlocks		lda	RWB_BlockNum		; will the number of blocks we're going to read or		clc				; write take us past the end of the disk?		adc	<NumBlocksToRW		sta	<endBlocks		lda	RWB_BlockNum+2		adc	#0		sta	<endBlocks+2				lda	<endBlocks				sec		sbc	<SrcSize		lda	<endBlocks+2		sbc	<SrcSize+2		bcc	@notAtEndYet				lda	<SrcSize		sec		sbc	RWB_BlockNum		sta	RWB_Count		sta	<NumBlocksToRW				lda	<SrcSize+2		sbc	RWB_BlockNum+2		sta	RWB_Count+2				ldy	#8@eLoop		asl	RWB_Count		rol	RWB_Count+2		dey		bpl	@eLoop@notAtEndYet	rts;; ScaleThermo -- scale the number of blocks to 100% (Actually, # of parts per 280);;		 NumItems is how many blocks we've both read and written so far;		 SrcSize*2 is the total number of blocks which have to be both read and written		;ScaleThermo		pha		pha		pha		pha		pushZLong <NumItems		;multiply the numerator by 280 to get parts per 280		pushlong #280		_LongMul		pla		plx		ply		ply		pha		pha		pha		pha		phx				;numerator		pha						lda	<SrcSize		;denominator (SrcSize*2)		asl	a		tax		lda	<SrcSize+2		rol	a		pha		phx		_LongDivide		pla						ply				;quotient		ply						ply				;remainder		ldx	#0		jsr	DrawThermo		rts				;---------------------------------------------------------------; CopyOptions;---------------------------------------------------------------		IMPORT	CloseDiskWindow		;in util.aii - 27-Jan-93 JCMCopyOptions		jsl	SaveCursor		jsl	ArrowCursor		jsl	WindowGlobalON				pha		pha		lda #0		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pha		pha				;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pha		pea	6			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2				jsl	WindowGlobalOFF		pulllong diskWindowPtr		bcc	@loop;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	diskWindowPtr+1		beq	@leave@done		jsl	CloseDiskWindow@leave		jsl	RestoreCursor		brl	doQuit;; now that we've set all the controls values, use doModalWindow to play with everything;@setup		lda	<SameFlag		beq	@loop		pha		pha		pushlong diskWindowPtr		pushlong #2		_GetCtlHandleFromID		pha		lda	3,s			;move the handle to be at the proper point for		sta	1,s			;_SetCtlValue		lda	5,s		sta	3,s		lda	#1		sta	5,s		_SetCtlValue@loop		pha		pha		pea	0		lda	>finderTaskRecord		pha			;push the task record's ptr		lda #0		pha		pha			;update proc		pea $8000		pha			;eventHook		pha		pha			;beep proc		pea	$c010		;flags		_DoModalWindow		pla		plx		cmp	#8		bge	@chose		cmp	#5		blt	@loop		sec		sbc	#4		tax		pha		pha		pushlong diskWindowPtr		pea	0		phx		_GetCtlHandleFromID		pha		lda	3,s			;move the handle to be at the proper point for		sta	1,s			;_SetCtlValue		lda	5,s		sta	3,s		lda	#1		sta	5,s		_SetCtlValue		bra	@loop@chose		bne	@notQuit		jsl	RestoreCursor		jsl	CloseDiskWindow		brl	doQuit@notQuit	pha		pushlong diskWindowPtr		pea	0		_FindRadioButton		jsl	RestoreCursor		jsl	CloseDiskWindow				pla		asl	a		tax		jmp	(WhichCopy,x)		;jump into correct routine		EXPORT	diskWindowPtrdiskWindowPtr	dc.L	0WhichCopy	dc.W	CreateFolder		;button	0		dc.W	ReplaceFiles		;button	1		dc.W	AddFiles		;button	2;---------------------------------------------------------------; EraseDst;---------------------------------------------------------------EraseDst			lda	GDN_DevNum		sta	DI_DevNum		jsr	GetDevInfo		;convert device	# into device name		bcs	@done			;got error						jsr	EraseDisk		;erase the dest	disk@done		rts;; get the Destination disk's device number (they might have moved it);; 10/29/91 NOTE:  God, I hate to do this, but the HFS FST won't find the name of the disk if;		  I kill anything after 32K, but leave the first 32k intact, get_dev_num won't work,;		  but Volume will, so I have to manually step through all the devices until I find one;		  which matches the volume name I want in GDN_Name;; 10/29/91 LATER: Sheesh, Mark seems to have fixed the HFS FST.  Yay.;getDestDevNum		lda	#C1_DstPathName		sta	GDN_Name		; set up ptr to dst disk name		lda	#C1_DstPathName>>16		sta	GDN_Name+2		jsr	GetDevNum		;get device # of dst disk;		lda	#1;@vcrLoop	pha;		sta	GDN_DevNum;		jsr	RebuildVCR		;do a DInfo followed by a Volume call;		bcc	@gotOne;		cmp	#$11;		beq	@done;		bne	@next	;		;@gotOne	pha;		pushlong #Filename		;if the disk in the drive is the same as what;		pushlong GDN_Name		;used to be there, we're OK;		jsl	WStrCompare;		pla;		bne	@matched;		;@next		pla;		inc	a;		bra	@vcrLoop;;@matched	clc	;@done		plx		rts;; There's no FST (source or dest) which supports erasing.  Wonderful, so blow away the first; 32k on the disk ourselves...;KillDisk	lda	GDN_DevNum		sta	RWB_DevNum				stz	RWB_BlockNum		stz	RWB_BlockNum+2		lda	#4*512			;write 2k		sta	RWB_Count		; convert to bytes to read (*512)		sta	<BufSize		lda	#4*512>>16		sta	RWB_Count+2		sta	<BufSize+2				jsr	AllocateMem		; allocate a segment (fixed, unpurgable)		bcs	@ack		stx	eraseHandle+2		stx	<localTemp+2		sta	eraseHandle		sta	<localTemp		lda	[<localTemp]		tax		ldy	#2		lda	[<localTemp],y		sta	<localTemp+2		sta	RWB_BufPtr+2		stx	<localTemp		stx	RWB_BufPtr		lda	#0			;zero 2k worth		ldy	#$7FE@loop		sta	[<localTemp],y		dey		dey		bpl	@loop		;; erase any evidence of it being an MS-DOS, HFS, or ProDOS disk (or anybody else who keeps; ID bytes that HandleDiskInsert might use on blocks 0 through 3);		lda	#RWB_Params		;get ptr to READ/WRITE BLOCK		ldx	#RWB_Params>>16		;parameter block		ldy	#D_WRITE+C1		;call #		jsr	ProDosCall		;make the call;; remove any evidence of this being an ISO 9660 disk from block 64;		lda	#64		sta	RWB_BlockNum				lda	#RWB_Params		;get ptr to READ/WRITE BLOCK		ldx	#RWB_Params>>16		;parameter block		ldy	#D_WRITE+C1		;call #		jsr	ProDosCall		;make the call;; remove anybody's ID bytes on track 17 of a DOS 3.3 disk;		lda	#17*8		sta	RWB_BlockNum				lda	#RWB_Params		;get ptr to READ/WRITE BLOCK		ldx	#RWB_Params>>16		;parameter block		ldy	#D_WRITE+C1		;call #		jsr	ProDosCall		;make the call;; remove anybody's ID bytes on track 17*2 of a UniDOS 3.3 disk;		lda	#17*16		sta	RWB_BlockNum				lda	#RWB_Params		;get ptr to READ/WRITE BLOCK		ldx	#RWB_Params>>16		;parameter block		ldy	#D_WRITE+C1		;call #		jsr	ProDosCall		;make the call				pushlong eraseHandle		jsl DisposeHandleGlue		@ack		sec		rts;---------------------------------------------------------------; CheckRoom;---------------------------------------------------------------; JAM 5/17/89 (Fixing BRC #49143);   Before calling the CheckRoom entry point, first push a word;   on the stack, which is non-zero if you are trying to decide;   whether or not to BLOCK-COPY, zero if you are trying to decide;   whether or not to FILE copy.  CALLER must pop the flag upon return;   from CheckRoom!CheckRoom			lda	#C1_DstPathName		ldx	#C1_DstPathName>>16		jsr	GetVolSizes		;get sizes for dest disk		bcs	CRRet			;got error		lda	GDN_DevNum		sta	Dest_DevNum				lda	V_Free			;get # of free blocks on dst disk		sta	<DstFree		;and save		lda	#C1_SrcPathName		sta	<PathNamePtr		;and dialog (if	needed)		ldx	#^C1_SrcPathName		stx	<PathNamePtr+2		jsr	GetVolSizes		;get sizes for source disk		bcs	CRRet			;got error		lda	GDN_DevNum		sta	Source_DevNum				lda	<SrcSize		;calculate # of blocks used on source disk		sec		sbc	V_Free		sta	<SrcUsed		;and save		lda	3,s			;say we have enough room if block by block		bne	EnoughRoom				sta	<AdjSrcUsed		;to get	actual blocks used on src disk		clcCheckRoom2					;called from CreateFolder		bcs	NoRoom		sec		lda	<DstFree		;get # of free blocks on dst disk and		sbc	<AdjSrcUsed		;subtract # of blocks used on src disk		bcc	NoRoom			;error if not enough room on dst diskEnoughRoom	clc				;indicate enough roomCRRet		rtsNoRoom		lda	#rasNoRoom		jsl	doAlertCopy		eor	#$FFFF		cmp	#$FFFF		rts				;'Cancel' selected;---------------------------------------------------------------; SetParams;---------------------------------------------------------------SetParams		lda	<BufSize		; read or write bufsize # of bytes		sta	RWB_Count		lda	<BufSize+2		sta	RWB_Count+2		lda	<segmentIndex		; get offset to current segment ptr		asl	a		asl	a		tay		lda	[<pointerListPtr],y	; set up ptr to buffer		sta	RWB_BufPtr		iny		iny		lda	[<pointerListPtr],y			sta	RWB_BufPtr+2				lda	RWB_BlockNum		; if we're back at block #0 zero, we only want 1!		bne	@indexLoop		; segment!		lda	RWB_BlockNum+2		beq	@setNumBlocks		@indexLoop	inc	<segmentIndex		lda	<segmentIndex		cmp	<segmentCount		bge	@setNumBlocks		lda	<segmentIndex		; get offset to current segment ptr		asl	a		asl	a		tay		iny		iny		lda	[<pointerListPtr],y	; set up ptr to buffer		cmp	#$FFFF		bne	@setNumBlocks				lda	<BufSize		clc		adc	RWB_Count		sta	RWB_Count		bcc	@nr		inc	RWB_Count+2@nr		bra	@indexLoop@setNumBlocks	lda	RWB_Count		;bytes to read or write		sta	<numBlocksToRW		lda	RWB_Count+2		sta	<numBlocksToRW+2		ldy	#8			;convert bytes to blocks@dLoop		lsr	<NumBlocksToRW+2		ror	<NumBlocksToRW		dey		bpl	@dLoop@done		rts;; rename the destination disk to what the source disk used to be, or eject the disk; (or, eject the disk if we haven't a hope of renaming the destination disk);FixName		ldy	<SrcFileSysID		jsl	isReadOnly		;is what we copied onto the destination disk 		bcs	@bogus			;capable of being renamed?		lda	#C1_DstPathName		sta	CP_TNewPtr		lda	#C1_DstPathName>>16		sta	CP_TNewPtr+2		lda	#C1_DeviceName		sta	CP_TOldPtr		lda	#C1_DeviceName>>16		sta	CP_TOldPtr+2		lda	#CP_Trustme		; get ptr to CHANGE_PATH param block		ldx	#CP_Trustme>>16		ldy	#CHANGE_PATH+C1		; call #		jsr	ProDosCall		; make the call@bogus		rts;; try erasing first with the destination FST, then with the source FST, then with the; ProDOS FST, and finally with the HFS FST, otherwise, give up, return carry set;findEraseFST	ldy	<DstFileSysID		;try erasing with the dest FST		sty	E_ReqFileSys		jsl	isFormattable		rts*******************************************************************************************	Get Segments for block reads/writes	*						* Get as many segmentSize buffers as we can, up to <SrcSize if possible	** OUT:	segmentCount				*	handleListHandle block is full (or not) of handles to each segment*	pointerListHandle block is full (or not) of pointers to each segment*				* 	SEC if no memory available		** ASSUMPTIONS: <SrcSize contains the size of the volume we want to replicate*	       The OOM queue has not dumped before we got here** NOTES: The segments in pointerList are marked as contiguous if a block has $FFFFFFFF for its*	 pointer -- a maximum of 1/4 of the disk's size is marked as contiguous.********************************************************************************************		IMPORT	OOMDump		GetSegments	stz	<segmentCount		; no segments yet		lda	<SrcSize		;MaxContiguous := SrcSize/4		sta	<MaxContiguous			lda	<SrcSize+2		;(largest contiguous block is 1/4 of disk size, maybe)		sta	<MaxContiguous+2		ldy	#6			;MaxContiguous *= 128@mLoop		asl	<MaxContiguous		;(MaxContiguous = (MaxContiguous * 512) / 4)		rol	<MaxContiguous+2		dey		bpl	@mLoop		lda	#maxSegments*4		sta	<BufSize		lda	#maxSegments>>16		sta	<BufSize+2				jsr	AllocateMem		; get the handle list		bcc	@gotHandleList		brl	memError@gotHandleList	stx	<handleListHandle+2		sta	<handleListHandle						jsr	AllocateMem		; get the pointer list		bcc	@gotPtrList		brl	memError@gotPtrList	stx	<pointerListHandle+2		sta	<pointerListHandle		lda	[<handleListHandle]	; deref the handle list handle		tax		ldy	#2		lda	[<handleListHandle],y		sta	<handleListPtr+2		stx	<handleListPtr				lda	[<pointerListHandle]	; deref the pointer list handle		tax		lda	[<pointerListHandle],y		sta	<pointerListPtr+2		stx	<pointerListPtr		lda	#segmentSize		; size we ask for segments		sta	<BufSize		lda	#segmentSize>>16		sta	<BufSize+2AllocLoop	jsr	AllocateMem		; allocate a segment		bcs	memCheck		; got error, so we're done allocating		phx		pha		lda	<segmentCount		asl	a		asl	a		tay		pla		sta	[<handleListPtr],y		iny		iny		pla		sta	[<handleListPtr],y		inc	<segmentCount		lda	<segmentCount		cmp	#maxSegments		; have we allocated the maximum number of segments		bcs	MemCheck		; allowable?			lda	<BufSize		; assume bucket ² 64K		xba		and	#$00FF		lsr	a		sta	<SegmentBlocks		; SegmentBlocks <-- BufSize/512		pha		pha		pei	<SegmentBlocks		; # of blocks in one segment		pei	<SegmentCount		; multiplied by the number of segments		_Multiply		pla		plx				sec				; have we allocated enough segments to hold the source		sbc	<SrcSize		; volume?		txa		sbc	<SrcSize+2		bcc	AllocLoop		; if borrow required, get some more memory if possible		;; --- Check if there is at least 36K left -------;memCheck	lda	<segmentCount		bne	@memCk1@halfSegment	lsr	<BufSize+2		; divide buffer size by 2		ror	<BufSize		lda	<BufSize+2		bne	AllocLoop		; retry allocation with smaller BufSize		lda	<BufSize		cmp	#2048			; if we can't get 2K, we're hosed		bcs	Allocloop		brl	memError		; not enough memory available@memCk1		lda	>OOMDumped		; did the OOM dump?		bne	@scram			; if it dumped, give 32k back!  The system needs it!				pha				; space for result		pha		_RealFreeMem			; Get amount of RAM left (excluding OOM Queue)		pla		cmp	#$4000		pla		sbc	#$0000		bcs	memOK			; RealFreeMem ³ $4000 (16K + 24K for Finder's OOM Queue)@scram		dec	<segmentCount		; otherwise, give one back !		lda	<segmentCount		asl	a		asl	a		tay		lda	[<handleListPtr],y		tax		iny		iny		lda	[<handleListPtr],y		pha		phx		jsl DisposeHandleGlue		; give one back		lda	<segmentCount		;solves disk copy in small ram situations		beq	@halfSegment;; --- Now dereference handles -------------------;memOK		lda	<SrcFileSysID		;are we copying a DOS 3.3 disk?		cmp	#DOS33FST		bne	@notDOS33				lda	<SrcSize		;is the disk's size 280 blocks?		cmp	#280		bne	@notDOS33				pha				;did we allocate at least 140k?		pha		pei	<segmentCount		pei	<BufSize		_Multiply		pla		plx		cpx	#143360>>16		bne	@notDOS33		cmp	#(143360/1024)		;140K		blt	@goMemError		;if we have less than 140K, too bad, they need more memory@notDOS33	lda	<segmentCount		; did we give up all our segments ?		bne	@haveSegments@goMemError	brl	memError		; yes,  no memory available@haveSegments				stz	<currentSegment		stz	<nextContiguous		; start by saying that nothing is contiguous to each other		stz	<nextContiguous+2		lda	<BufSize		sta	<ContiguousSoFar		stz	<ContiguousSoFar+2@derefLoop	lda	<currentSegment		asl	a		asl	a		tax		txy		lda	[<handleListPtr],y	; get a handle		sta	<localTemp		iny		iny		lda	[<handleListPtr],y			sta	<localTemp+2		lda	[<localTemp]		; dereference it		txy		sta	[<pointerListPtr],y		ldy	#2		lda	[<localTemp],y		txy		iny		iny		sta	[<pointerListPtr],y				cmp	<nextContiguous+2	; is this pointer where we expected the next contiguous		bne	@notNext		; block to be?		txy		lda	[<pointerListPtr],y		cmp	<nextContiguous		bne	@notNext					lda	<currentSegment		;DON'T (DO NOT) mark the last segment as contiguous,		inc	a			;because we're going to need it for the R/W of the first		cmp	<segmentCount		;32k chunk of the disk		bge	@notNext					lda	<ContiguousSoFar	;is the amount of memory which is contiguous to each other		sec				;so far more than we want to have contiguous so that the		sbc	<MaxContiguous		;thermo bar updates?		lda	<ContiguousSoFar+2		sbc	<MaxContiguous+2		bcs	@notNext		lda	<ContiguousSoFar	;update how much memory we have contiguous		clc		adc	<BufSize		sta	<ContiguousSoFar		lda	<ContiguousSoFar+2		adc	<BufSize+2		sta	<ContiguousSoFar+2		jsr	@NextContiguous			lda	#$FFFF			; mark this block as being contiguous with the one		txy				; before it		sta	[<pointerListPtr],y		iny		iny		sta	[<pointerListPtr],y		bra	@wasNext@notNext	jsr	@NextContiguous		; not the next contiguous block, but tell us where the next one will be		lda	<BufSize		sta	<ContiguousSoFar		stz	<ContiguousSoFar+2		@wasNext	inc	<currentSegment		lda	<currentSegment		cmp	<segmentCount		blt	@derefLoop		clc				; indicate no error		rts;; NextContiguous --  add buffer size to our pointer to find out where the next block should be;		     for the next block to be considered contiguous, thus saving us some read time;		     because we'll be able to do a large multi-block read instead of dinky 32k reads;@NextContiguous	txy		lda	[<pointerListPtr],y		clc		adc	<BufSize		sta	<NextContiguous		iny		iny		lda	[<pointerListPtr],y		adc	#0		sta	<NextContiguous+2		rts		;; NUTS!  We got an out-of-memory error, so tell the user to close some windows or inactivate some;	 DAs or Inits, etc.;memError	jsl	OOMDump			;if we were able to dump both OOM handles, then all is OK,		bcc	@noDump			;but if not, then don't risk crashing or hanging the machine						;by displaying a dialog!				lda	#rasMemErr		jsl	doAlertWindow				@noDump		sec		rts*********************************************************************	Free Segments used by block copy	*						*******************************************************************FreeSegments	lda	<segmentCount		beq	@done		dec	a		asl	a		asl	a		tax				; start at bottom@loop		phx				txy		lda	[<handleListPtr],y		tax		iny		iny		lda	[<handleListPtr],y		pha		phx		jsl DisposeHandleGlue			; free it				plx		dex		dex		dex		dex		bpl	@loop@done		pushZLong <handleListHandle		jsl DisposeHandleGlue				pushZLong <pointerListHandle		jsl DisposeHandleGlue		rts;; locals?;		EXPORT	ThermoMaxthermoMax	dc.L	0eraseHandle	dc.L	0			;handle to 32K erase buffer		ENDP****************************************************************** DeleteFiles*****************************************************************DeleteFiles	PROCNAME		IMPORT	SaveCursor		IMPORT	WatchCursor		IMPORT	doAlertCopy		IMPORT	doAlertWindow		IMPORT	PathGetName		IMPORT	C1_FileNameCallFlag	equ	10SrcPtr		equ	CallFlag+2IcHndl		equ	SrcPtr+4		;input parametersParamSize	equ	10			;# of bytes of input params;The 'CallFlag'	parameter indicates what this routine is being called to do.;The possible values are as follows -;;    $0000 - Put files in Trash;    $0001 - Remove files;    $8000 - Empty Trash		phd		tcd		phb		phk		plb		lda	#ParamSize		;# of bytes of input params		sta	<NumParams		jsl	SaveCursor		jsl	watchCursor		stz	<WhichMsg		;no message for	now		stz	AbortFlag		;added 06/09/88 DJB		stz	<NamesWereXLated	; JAM 06/01/89 Fixing BRC #49639		lda	SrcPtr+2,s		;get ptr to source (window) pathname		tax		lda	SrcPtr,s		phx		pha		PushLong #C1_SrcPathName		jsl	WStringCopy		;copy src pathname to our buffer		lda	C1_SrcPathName		sta	<SrcPathLen		;save source pathname length		lda	IcHndl,s		;get handle to first icon in icon list		sta	<IconHndl		lda	IcHndl+2,s		sta	<IconHndl+2		jsr	GetSelIcon		;search	list for first selected	icon		lda	#$FFFF		sta	<DeleteFlag		;indicate that we're deleteing files		lda	#C1_SrcPathName		;set up	ptr to SrcPathName		sta	<PathNamePtr		sta	FI_Name			;set up	ptr to src name	for GetFileInfo		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		sta	FI_Name+2		jsl	ProDOS			;start_session, added 05/17/88 DJB		DC.W	BEGIN_SESSION+C1	;for hack		DC.L	session_callIconLoop		lda	>MenschTemp		and	#$7FFF		sta	>MenschTemp		lda	CallFlag,s		bmi	@emptying		ldy	#icFtype		;and only let them do it if it's a folder in the trash		lda	[<iconPtr],y		cmp	#$000F		bne	@emptying		ldy	#icFlag+2		;don't let them put a network folder in		lda	[<iconPtr],y		;the trash that doesn't have the "Make Changes"		tax				;bit set		and	#icNetwork>>16		beq	@emptying		txa		and	#icMakeChanges		bne	@emptying				lda	#rasNoPrivs		jsl	doAlertWindow		sec		brl	Quit2					@emptying		jsr	MakeSrcName		;make pathname for selected icon		bcs	Quit2a			;name too long		ldx	#0			;don't save filecount in first cat entry		jsr	CatalogSrc		;get catalog for icon		bcc	cat_ok		cpy	#$4E		sec		bne	Quit2a		lda	CallFlag,s		; Is CallFlag here because CatalogSrc		bne	Quit2a			; did not put a handle (+4) on the stack.		lda	#rasNoPrivs		jsl	doAlertWindow		secQuit2a		brl	Quit2			;got error in Catalog routinecat_ok		lda	CallFlag+4,s		;if called to 'Empty Trash', then don't		bmi	DeleteIt		;put up	dialog for locked files		txa				;any locked files in catalog?		beq	DeleteIt		;no - so it's OK to delete		pushlong #C1_Filename		;put the end of pathnameptr onto c1_filename		pushZLong <PathNamePtr		jsl	PathGetName		lda	#rasLocked2		jsl	doAlertWindow		cmp	#2		beq	deleteIt		cmp	#1		beq	NextIcon		;'No' was selected so skip this	icon		brl	doQuit			;'Cancel' was selectedDeleteIt	lda	CallFlag+4,s		;if called to 'Put files in Trash', then		beq	SetBit			;don't delete the files		lda	<SrcPathLen		;restore SrcPathName		inc	a			;include a separator		sta	C1_SrcPathName		lda	#1		sta	<CatIndex		;indicate only 1 catalog on stack		jsr	GetNextCat		;get ptr to first catalog entryFileLoop							lda	CallFlag+4,s		;if called to Empty Trash then user		bmi	NoCheck			;can't cancel the operation		jsr	CheckKey		;does user want	to cancel?		bcc	NoCheck			; no, continue		brl	doQuit			;yesNoCheck		jsr	MakePathName		;make pathname for catalog entry		bcs	doQuit			;name too long		lda	[<CatPtr]		;is this entry a subdirectory?		bne	NextFile		;yes - so can't delete it until empty		ldy	#2		lda	[<CatPtr],y		;is this file locked?		beq	DoDelete		;no - so delete	it		jsr	GetFileInfo2		;yes - so get file info		bcs	doQuit			;got error - cancel		lda	#$C3		sta	FI_Access		;and clear out access bits so file		pea	-1			; Mensch 5/18/89 (BRC #48301)		jsr	SetFileInfo		;can be	deleted; Mensch 5/18/89 (Fixing BRC #48301); Following code modifies original so that it ignores access errors but passes;   the rest on to the user.		bcc	doDelete		cmp	#$50			; is it a file busy error?		bne	doQuit			; if not, come to a rude end		ora	#$8000		sta	>MenschTemp		; else save the error for later		bra	NextFile		; do the next one in the listDoDelete		pea	-1			; flag for destroy		jsr	DestroyFile		;delete	the file		bcc	NextFile		cmp	#$50			; is it a file busy error?		bne	doQuit			; if not, come to a rude end		ora	#$8000		sta	>MenschTemp		; else save the error for laterNextFile	jsr	GetNextFile		bcc	FileLoop		;loop until done with all files	in cat;; Now, test to see if this icon should be flagged as deleted		lda	>MenschTemp		bpl	SetBit		bra	NextIcon; end Mensch 5/18/89 (BRC #48301)SetBit		ldy	#icFlag		lda	[<IconPtr],y		ora	#ICDELETE		;set bit in Flag field of IconObj record		sta	[<IconPtr],y		;to indicate it	was deletedNextIcon	jsl DisposeHandleGlue		;dispose of catalog		jsr	GetNextIcon		;get next selected icon		bcs 	icon_done		;loop until done with all selected icons		brl 	IconLoopicon_done;; Here, we test Mensch temp to see if any nasty access errors occurred during deletion.; If so, report them to the caller.;		lda	>MenschTemp		bpl	@LikeNormal		bra	OneWasBusy@LikeNormal; end Mensch 5/18/89 (BRC #48301)		stz	<Error			;indicate no errorDone		stz	<DeleteFlag		;clear flag		jsl	ProDOS			;stop_session, added for hack		DC.W	END_SESSION+C1		;05/17/88 DJB		DC.L	session_call		jmp	StdEnddoQuit		jsl DisposeHandleGlue		;dispose of catalogQuit2		lda	#$FFFF		sta	<Error			;return	error		bra	Done; Mensch 5/18/89 (Fixing BRC #48301)OneWasBusy; Report the file busy error to the user here		stz	<Error		bra	Done		EXPORT	MenschTempMenschTemp	ds.W	1			; used internally (watch out for bank probs); end Mensch 5/18/89 (BRC #48301)		ENDP****************************************************************** DupFiles*****************************************************************DupFiles	PROC		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	arrowCursor		IMPORT	watchCursor		IMPORT	finderTaskRecord		IMPORT	PathGetName		IMPORT	CustomPtr		IMPORT	C1_Source		IMPORT	C1_Dest		IMPORT	PToWString		IMPORT	WToPString		IMPORT	FileSysID		IMPORT	CustomPtr		IMPORT	c1_sourcebuf		import	customptr		import	customptr2		import	customptr3		import	fstNames		import	WindowGlobalON		import	WindowGlobalOFF		import	GetVolumeInfo		import	GetDeviceName		import	doAlertWindow		import	FileCopyOpen		import	FileCopyClose		import	DrawNumItems		import	DrawCopyControls		import	StrAlloc		ProcPtr		equ	10SrcPtr		equ	ProcPtr+4IcHndl		equ	SrcPtr+4		;input parametersParamSize	equ	12			;# of bytes of input params		phd		tcd		phb		phk		plb		stz	<ReadDuplicate		stz	<WriteDuplicate		lda	#ParamSize		;# of bytes of input params		sta	<NumParams		stz	<NamesWereXLated	; JAM 06/01/89 Fixing BRC #49639		jsl	SaveCursor		jsl	WatchCursor		stz	<WhichMsg		;no message for	now		stz	AbortFlag		;added 06/09/88 DJB		lda	ProcPtr,s		;get address of	routine	to call		sta	Call+1			;and store after JSL opcode		lda	ProcPtr+1,s		sta	Call+2		lda	SrcPtr+2,s		;get ptr to source (window) pathname		tax		lda	SrcPtr,s		phx		pha		PushLong #C1_SrcPathName		jsl	WStringCopy		;copy src pathname to our buffer		PushLong #C1_SrcPathName		PushLong #C1_DstPathName		jsl	WStringCopy		;copy src pathname to our buffer		lda	C1_SrcPathName		;set lengths of src and dst pathnames		sta	<SrcPathLen		lda	C1_DstPathName		sta	<DstPathLen		PushLong #C1_DeviceName		; pointer to device name		PushLong #C1_SrcPathName	; pointer to pathname		jsl	GetDeviceName		PushLong #C1_DeviceName		; pointer to device name		lda #0		pha		pha				; skip volume name		pha		pha				; skip total blocks		pha		pha				; skip free blocks		PushLong #FileSysID		; ptr to file system ID		pha		pha				; skip block size		jsl	GetVolumeInfo		lda	IcHndl,s		;get handle to first icon in icon list		sta	<IconHndl		lda	IcHndl+2,s		sta	<IconHndl+2		jsr	GetSelIcon		;search	list for first selected	icon;; get the type of the name and run the modified one through JudgeName;IconLoop	ldy	#icFType		lda	[<IconPtr],y		ldx	#1			;is it a volume?		cmp	#TypeLastone		bge	@foundType		inx		cmp	#$0f			;is it a folder?		beq	@foundType		inx				;must be just a file if it gets here@foundType	stx	nameType				lda	>fileSysID		sta	fstID		sta	<SrcFileSysID		lda	#C1_SrcPathName		sta	<PathNamePtr		;set up	ptr to SrcPathName		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		jsr	MakeSrcName		;make pathname for icon		bcc	@nameOK		brl	Quit0b@nameOK				jsr	JudgeIName				pushlong #C1_Source		pushlong #C1_SrcPathname		jsl	PathGetName		lda	>C1_Source		xba		sta	>C1_Source		lda	#10		jsr	duplicateDialog		asl	a			;button	ID returned in A		bcc	DupIt			;'OK' selected so retry	with new name		bmi	@goQuit0a		;'Cancel' was selected		brl	NextIcon		;'Skip File' selected so skip this icon@goQuit0a	brl	Quit0a;; before we duplicate anything, checkout the name the user gave us (never trust them for a; second while they're out of your sight).;DupIt		PushLong #FileName		;create	ptr to duplicate's name		PushLong #C1_Source		jsl	PToWString		_JudgeNameGS JudgeParms		bcs	@wayBogus		lda	JudgeParms+$10		beq	GoodName		@wayBogus	pushlong #filename		;move bad name to c1_dest		pushlong #c1_dest		jsl	PToWString				pushlong #c1_source		;move good name into filename		pushlong #filename		jsl	WToPString				lda	>c1_source		;*3 -- make pstr		xba		sta	>c1_source			lda	>c1_dest		;*4 -- make pstr		xba		sta	>c1_dest			lda	fstID			;*6 -- create fst name string		asl	a		asl	a		tax		lda	>fstNames,x		sta	>CustomPtr2		lda	>fstNames+2,x		sta	>CustomPtr2+2		lda	JudgeParms+$06		;move fst syntax pointer to *5		sta	>CustomPtr		lda	JudgeParms+$08		sta	>CustomPtr+2		lda	#$0c			;diaBadName		jsr	duplicateDialogrtDialog	asl	a			;button	ID returned in A		bcc	DupIt			;'OK' selected so retry	with new name		bmi	Quit0a			;'Cancel' was selected		brl	NextIcon		;'Skip File' selected so skip this icon;; if we get here we're pretty sure we got a good name;GoodName	PushLong #FileName		;create	ptr to duplicate's name		PushLong #C1_IconName		jsl	PToWString		lda	#Filename		sta	<FileNamePtr		lda	#FileName>>16		sta	<FileNamePtr+2		lda	#C1_IconName		sta	<INamePtr		lda	#C1_IconName>>16		sta	<INamePtr+2		jsr	MakeDstName		;make pathname for duplicateQuit0b		bcc	okgoQuit0		brl	Quit0			;name too longok		lda	#C1_DstPathName		;create	ptr to DstPathName		sta	FI_Name			;for GetFileInfo to use		lda	#^C1_DstPathName		sta	FI_Name+2		jsr	GetFileInfo3		;does this file	already	exist?		bcc	Cont			;no - so we're OKQuit0a		bmi	goQuit0			;got an	error, 'Cancel'	was selected		beq	@ok			; bad name typed in		brl	DupIt@ok		pushlong #C1_Dest		pushlong #C1_DstPathname		jsl	PathGetName		lda	>C1_Dest		xba		sta	>C1_Dest		jsr	JudgeIName		;result into 'Filename'		lda	#$0b			;diaNameUsed		jsr	duplicateDialog		bra	rtDialogCont		jsr	FileCopyOpen		bcs	@goDoQuit				jsr	DrawCopyControls		lda	#1			;start counting upwards from 1		ldy	#0		jsr	DrawNumItems				pea	15		pea	30		_MoveTo		pushlong #strAlloc		_DrawString		ldx	#1			;store filecount in first cat entry		jsr	CatalogSrc		;get catalog for icon being duplicated		bcc	@catalogOK		cpy	#$4e		bne	@goDoQuit		lda	#rasNoPrivs		jsl	doAlertWindow@goDoQuit	sec		brl	QuitClose		;Catalog routine got an	error@catalogOK		sta	<NumFiles		;# of files in catalog returned	in A		lda	#1		sta	<NumCats		;used by DoFileCopy		inc	<ReadDuplicate		;indicate we're duplicating		inc	<WriteDuplicate				lda	>fileSysID		sta	<DstFileSysID		;don't really care since we're duping		sta	<SrcFileSysID		lda	<CatalogEOF		sta	<TotalEOF		lda	<CatalogEOF+2		sta	<TotalEOF+2		jsr	DoFileCopy		;copy the files		jsr	FileCopyClose				lda	#1		sta	<CatIndex		;reset CatIndex		jsr	GetNextCat		;get ptr to catalog		ldy	#2		lda	[<CatPtr],y		;get flag from first cat entry		bpl	NotDuped		;if hi bit clear, flag is not valid		and	#ICCOPY			;was the file duplicated?		beq	NotDuped		;no		PushZLong <IconHndl		;push handle to	icon we	just duplicated		PushPtr	FileName		;push ptr to name of duplicateCall		jsl	Call			;call routine to create	a new icon		pla				;clean up stack		pla		pla		plaNotDuped		jsl DisposeHandleGlue		;dispose of catalog		lda	<Error			;did 'DoFileCopy' get an error?		bmi	Quit0			;yes - so quitNextIcon	jsr	GetNextIcon		;get next selected icon		bcs	Done		brl	IconLoop		;loop until done with all selected iconsDone		stz	<Error			;don't return an error		jmp	StdEndQuitClose	jsr	FileCopyCloseQuit0		lda	#$FFFF		sta	<Error			;return	error		jmp	StdEnd;; judge IName, result into 'Filename';JudgeIName	pushZLong <INamePtr		pushlong #c1_source		jsl	WStringCopy		lda	>c1_source		tax		inx		lda	>c1_source,x		and	#$00FF		ora	#$3200			;add a '2' onto the end of the name		sta	>c1_source,x		txa		sta	>c1_source				_JudgeNameGS JudgeParms		;use whatever it returns		pushlong #c1_source		pushZLong <INamePtr		jsl	WStringCopy		pushZLong <INamePtr		pushlong #Filename		jsl	WToPString		rts		;; put up the duplicate dialog of their choice;; IN: (A) contains the dialog to show;		IMPORT	CloseDupWindow		;in util.aii - 27-Jan-93 JCMduplicateDialog		pha		jsl	saveCursor		jsl	arrowCursor		jsl	WindowGlobalON		plx		pha		pha		lda #0		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pha		pha				;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pha		phx				;window resource we want		pea	$800e			;rWindParam1		_NewWindow2				jsl	WindowGlobalOFF		pulllong dupWindowPtr		bcc	@openOK;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	dupWindowPtr+1		beq	@leave@done		jsl	CloseDupWindow@leave		jsl	RestoreCursor				lda	#$FFFF		rts;; cool.  we got the resources we needed and have a window -- so set everyone's control values before; anything gets drawn;@openOK		pushlong dupWindowPtr		pushlong #4		pushlong #Filename		_SetLETextByID;; now that we've set all the controls values, use doModalWindow to play with everything;@loop		pha		pha		pea	0		lda	>finderTaskRecord		pha			;push the task record's ptr		lda #0		pha		pha			;update proc		pea $8000		pha			;eventHook		pha		pha			;beep proc		pea	$c010		;flags		_DoModalWindow		pla		plx		cmp	#5		blt	@loop		sec		sbc	#5		asl	a		tax		jmp	(@addrs,x)@addrs		dc.w	@cancel		;id = 5		dc.w	@ok		;6		dc.w	@skip		;7@close		jsl	restoreCursor		jsl	CloseDupWindow		rts@cancel		jsr	@close		lda	#$FFFF		rts@ok		pushlong dupWindowPtr		;if so, then get the text they typed		pushlong #4		pushlong #Filename		_GetLETextByID		jsr	@close		lda	#1		rts@skip		jsr	@close		lda	#$8000		rts;; locals;		EXPORT	dupWindowPtrdupWindowPtr	dc.L	0JudgeParms	dc.w	6fstID		dc.w	0			;fileSysIDnameType	dc.w	0			;nameType		dc.L	0			;syntax		dc.w	0		dc.L	C1_SourceBuf		;keep this big so it has a lot of workspace (DAL)		dc.w	0		ENDP****************************************************************** FileCopyOpen -- open the file copy window, set port to it*		  carry set if the window couldn't be opened*****************************************************************FileCopyOpen	PROC		IMPORT	WindowGlobalON		IMPORT	WindowGlobalOFF		IMPORT	CopyUpdate		IMPORT	CloseCopyWindow		;in util.aii - 27-Jan-93 JCM				jsl	WindowGlobalON				pha		pha		lda #0		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pushlong #CopyUpdate+$C0000000	;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pha		pea $D				;window resource we want		pea	$800e			;rWindParam1		_NewWindow2		jsl	WindowGlobalOFF		pulllong copyWindowPtr		bcc	@openOK;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	copyWindowPtr+1		beq	@leave		jsl	CloseCopyWindow		stz	copyWindowPtr+1@leave		sec		rts@openOK		pha		pha		_GetPort		pulllong ourPort				pushlong copyWindowPtr		_SetPort;;;		clc			;27-Jan-93 JCM - redundant - SetPort always returns w/clc		rts		ENDP****************************************************************** FileCopyClose -- close the file copy window (or not if it wasn't open)*****************************************************************FileCopyClose	PROC					IMPORT	CopyWindowPtr		IMPORT	CloseCopyWindow		;in util.aii - 27-Jan-93 JCM				lda	copyWindowPtr+1		beq	@noClose		pushlong ourPort		_SetPort		jsl	CloseCopyWindow				stz	copyWindowPtr+1@noClose	rts		ENDP****************************************************************** DoFileCopy*****************************************************************DoFileCopy	PROCNAME		IMPORT	DrawNumItems		IMPORT	CopyUpdate		IMPORT	ThermoMax		IMPORT	DrawCopyControls		IMPORT	PathGetName		IMPORT	PathAddName		IMPORT	PathSubName		IMPORT	strgCopying		IMPORT	c1_filename		IMPORT	DupFile		IMPORT	AddSlash		IMPORT	RemoveName		IMPORT	RemoveSlash		IMPORT	IncCatPtr		IMPORT	MakeDestinationName		IMPORT	lastThermo		IMPORT	WindowGlobalON		IMPORT	WindowGlobalOFF		import	doAlertWindow		import	IsReadOnly		IMPORT	DoMagicRoutingBytesLeft	equ	ZEnd			;zero page tempsMoreToRead	equ	BytesLeft+4MoreToWrite	equ	MoreToRead+2SavedCatHndl	equ	MoreToWrite+2SavedCatPtr	equ	SavedCatHndl+4SavedCatIndex	equ	SavedCatPtr+4DataReadMark	equ	SavedCatIndex+2RsrcReadMark	equ	DataReadMark+4DataWriteMark	equ	RsrcReadMark+4RsrcWriteMark	equ	DataWriteMark+4FilesInCat	equ	RsrcWriteMark+4RetAdrs		equ	FilesInCat+2OrigSrcLen	equ	RetAdrs+2OrigDstLen	equ	OrigSrcLen+2DoServerCopy	equ	OrigDstLen+2LastWriteType	equ	DoServerCopy+2		IF	LastWriteType+2>$FF THEN			WRITE 'LastWriteType = '			WRITELN LastWriteType			WRITELN 'WARNING... Direct page variable overflow!'			AERROR 'DoFileCopy extended its local DP too far'		ENDIF		pla				;get return address		sta	<RetAdrs		;and save		lda	C1_SrcPathName		;get length of srcpathname		sta	<OrigSrcLen		;and save		lda	<NumCats		;get number of catalogs	on stack		sta	<CatIndex		;set up	index into catalogs		jsr	GetNextCat		;get ptr to first entry	in first catalog		stz	<MoreToRead		;clear out flags		stz	<MoreToWrite		stz	<DataReadMark		stz	<DataReadMark+2		stz	<RsrcReadMark		stz	<RsrcReadMark+2		stz	<DataWriteMark		stz	<DataWriteMark+2		stz	<RsrcWriteMark		stz	<RsrcWriteMark+2				stz	<SkipBadNames		jsr	GetBuffer		;allocate buffer for file reads		pha		pha		pushlong copyWindowPtr		pushlong #3		_GetCtlHandleFromID		lda	<NumFiles		;get # of files	being copied		asl	a		sta	<NumItems		sta	thermoMax		ply		plx		pea	0		pha				;max value for dial		phx		phy		_SetCtlTitle			;set the scale;; now, the filename gets the null string initially.  If the source and destination FSTs are; AppleShare, we'll draw nothing yet and if the FSTs aren't both AppleShare, we'll draw; "Reading: ";;;;		lda	#$FFFF			;23-Mar-93 JCM - pulled from 6.0.1;;;		sta	<DoServerCopy		;23-Mar-93 JCM - pulled from 6.0.1		stz	lastThermo		;; get file info and read in file contents;ReadIt		NAME		jsl	ProDOS			;stop sessioning, maybe write something		DC.W	END_SESSION+C1		DC.L	session_call		jsr	RestartBuf		;set bufptr to start of	buffer		lda	<CatHndl		;save hndl to current cat so the write		sta	<SavedCatHndl		;code knows which catalog is in	use		lda	<CatHndl+2		sta	<SavedCatHndl+2		lda	<CatPtr			;save ptr to current file so the write		sta	<SavedCatPtr		;code knows which file to start	with		lda	<CatPtr+2		sta	<SavedCatPtr+2		lda	<CatIndex		;save CatIndex so the write code		sta	<SavedCatIndex		;knows how many	catalogs are left		lda	#C1_SrcPathName		;put ptr to SrcPathName		sta	O_NamePtr		;into OPEN params		sta	OE_NamePtr		sta	<PathNamePtr		;set up	ptr to SrcPathName		lda	#C1_SrcPathName>>16		sta	O_NamePtr+2		sta	OE_NamePtr+2		sta	<PathNamePtr+2				jsr	MakeFileName		jsr	CheckKey		;does user want	to cancel?		bcs	Quit2aJim;; see if the file has needed more than 1 pass, if so, print the name;		lda	<MoreToRead		;has this file been partially read?		beq	@notMultiRead		lda	#strgReading		;point to 'Reading: '		sta	<RWPtr		lda	#strgReading>>16		sta	<RWPtr+2		jsr	DrawThermoItems		jsr	DrawNumFiles		brl	notFolder		;bra if yes@notMultiRead		lda	<ReadDuplicate		;are we	duplicating a file?		beq	contRd			;bra if yes: src pathname already built		jsr	ZeroSoFar		jsr	CheckSpace		;enough	space in buffer	for file info?		bcc	GotSrcName		brl	WriteIt			;no - so write out buffer;; loop back here for every file we read into our buffer;ReadLoop	NAME		jsr	CheckKey		;does user want	to cancel?		bcs	Quit2aJim		jsr	MakeFileNamecontRd		jsr	ZeroSoFar		jsr	CheckSpace		;enough	space in buffer	for file info?		bcc	OKSpace		brl	WriteIt			;no - so write out bufferOKSpace		jsr	MakePathName		;make full pathname for	file		bcc	GotSrcName		;bra if name len okquit2aJim	brl	Quit2a			;name too longGotSrcName	jsr	StorePtr		;store ptr to pathname in buffer		jsr	GetFileInfo		;store file info in buffer		bcs	Quit2aJim		;got error		bmi	@skip				ldx	#1			;put up	dialog if access error		jsr	CheckRAccess		;is file able to be read?		bcc	OK2Read			;yes		bmi	Quit2aJim		;no - user wants to cancel		@skip		jsr	DrawCopyControls		lda	<NumFiles		ldy	#0		jsr	DrawMsg			;update	box one last time		ldy	#2			;if this is the	first entry in the cat		lda	[<CatPtr],y		;the flag word contains	the # of files		sta	<FilesInCat		;in the	catalog		brl	SkipThisFile		;no - user wants to skip file;; First, see if we can do a server copy.  If the volume the file is being copied to,; or is being copied from isn't on the same server, then this call will fail and we; proceed to copy the file normally;OK2Read				IF AllowServerCopies THEN	;24-Mar-93 JCM - doesn't work - removed from 6.0.1		lda	<DoServerCopy		beq	@goNotAppleShare					lda	<SrcFileSysID		cmp	#$0D			;AppleShare		bne	@goNotAppleshare		cmp	<DstFileSysID		beq	@gotAppleshare		ENDIF@goNotAppleshare brl	@notAppleShare		IF AllowServerCopies THEN	;24-Mar-93 JCM - doesn't work - removed from 6.0.1@gotAppleshare			lda	#C1_DstPathName		;put ptr to DstPathName		sta	<PathNamePtr		lda	#C1_DstPathName>>16		sta	<PathNamePtr+2		lda	[<PathNamePtr]		sta	<OrigDstLen		lda	<ReadDuplicate		;are we duplicating something?		bne	@duplicate		;must be first time through ReadLoop				jsr	MakePathname		bcs	@goCopyDone@duplicate		lda	#strgCopying		;point to 'Copying: '		sta	<RWPtr		lda	#strgCopying>>16		sta	<RWPtr+2		jsr	DrawThermoItems		jsr	DrawNumFiles					jsr	GetNumFiles		lda	[<CatPtr]		;is this a file entry?		beq	@serverLoop		; yup, copy it		jsr	StorePtr		;store ptr to pathname in buffer		jsr	SaveFileInfo		;make a	copy of	the file info for later		jsr	EnableAccess		;enable	all access bits		jsr	CreateFile		;create	the directory		bcc	@created		bmi	@goCopyDone		;got error - 'Cancel' selected		bra	@aShareSkip@serverLoop	_FSTSpecific CopyFileParms		bcc	@copied		cmp	#$47			;duplicate file?		beq	@duplicateFile		stz	<DoServerCopy		;don't use the server to copy next time				lda	<OrigDstLen		sta	[<PathNamePtr]		brl	@notAppleshare@duplicateFile		jsr	DupFile			;either delete the file or use dialog		bcc	@serverLoop		bpl	@aShareSkip		;skip this file@goCopyDone	brl	Quit2;; they want to skip this file, so seeing as how we're doing an AppleShare file; copy, we gotta remove the name from the destination path no matter what we do, then; we have to go through the formal skip process for the source files in the catalog;@aShareSkip	jsr	RemoveName		;remove	file name from destination path		lda	#C1_SrcPathName		;put ptr to SrcPathName		sta	<PathNamePtr		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		brl	SkipThisFile;; The file was copied OK on the server, so increment the pointers for where we are; in our catalog of files;@created	pea	#0		jsr	SetFileInfo		;fix up	access bits and	'modified' info@copied		jsr	SetCopyBit		;set the icCopy bit of this catalog		pushZLong <CatPtr		lda	[<CatPtr]		;is this a subdirectory	entry?		bne	@SubDir			;yes		jsr	RemoveName		;remove	file name		jsr	IncCatPtr		;go on to next cat entry		bra	@CkSubDirEnd		;chk type of first entry: end of subdir?@SubDir		jsr	AddSlash		;add separator to pathname@CkSubDirEnd	lda	[<CatPtr]		;get type of first entry		cmp	#$FFFF			;at end	of subdirectory?		bne	@returnOK		;bra if not: indicate no error, return		jsr	RemoveSlash		;remove	separator from pathname		jsr	RemoveName		;remove	name of	subdirectory@returnOK	pulllong <CatPtr		lda	#C1_SrcPathName		;put ptr to SrcPathName		sta	<PathNamePtr		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		dec	<NumItems		;# of dial items left		dec	<NumItems		;*2 because we both read and wrote		dec	<NumFiles		jsr	GetNextFile		;get next filename from	catalog		bcc	@aCopyNext		jsr	DrawThermoItems		jsr	DrawNumFiles		brl	CopyDone		;no more files@aCopyNext	lda	<CatHndl		;save hndl to current cat so the write		sta	<SavedCatHndl		;code knows which catalog is in	use		lda	<CatHndl+2		sta	<SavedCatHndl+2		lda	<CatPtr			;save ptr to current file so the write		sta	<SavedCatPtr		;code knows which file to start	with		lda	<CatPtr+2		sta	<SavedCatPtr+2		lda	<CatIndex		;save CatIndex so the write code		sta	<SavedCatIndex		;knows how many	catalogs are left				stz	<ReadDuplicate			brl	ReadLoop		;loop until done with all catalogs		ENDIF;; The file either wasn't from an Appleshare fileserver, or we got some kind of; error when trying to read it, so try to copy the file the normal way...;@notAppleshare	lda	#C1_SrcPathName		;put ptr to SrcPathName		sta	<PathNamePtr		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		lda	#strgReading		;point to 'Reading: '		sta	<RWPtr		lda	#strgReading>>16		sta	<RWPtr+2		jsr	DrawThermoItems		jsr	DrawNumFiles		jsr	SkipFileInfo		;inc bufptr past file info		lda	[<CatPtr]		;is this file a	subdirectory?		beq	notFolder		brl	NextFile1		;yes - so nothing to readnotFolder		lda	#$0001			; read access only		jsr	OpenFile		;no - so open the file		bcc	@noError		brl	Quit2aJim		;got error@noError	stz	<IsExtended		lda	O_StoreType		cmp	#$05			;is it an extended file?		bne	ReadSet		inc	<IsExtended		lda	#$0001			;read access only		jsr	OpenResource		bcs	Quit2a			;bra if got errorReadSet		jsr	SetReadMark		;set mark if file has been partially read		bcs	Quit1a			;got error		jsr	SetReadSize		;calc #	of bytes to read, save # in buf		bcs	Quit1a			;got error		jsr	SkipSizeInfo		;inc bufptr past size info		lda	RW_Size			;are they data bytes to read?		ora	RW_Size+2		beq	ReadExtend		;if not skip the read		jsr	ReadDataFile		;read the bytes in data fork		bcs	Quit1a			;got error		jsr	GetDataReadMark		;save mark if file only	partially read		bcs	Quit1a			;got errorReadExtend	lda	RWE_Size		;are there resource bytes to read?		ora	RWE_Size+2		beq	ReadDone		;if not skip the read		jsr	ReadRsrcFile		;read the bytes in resource fork		bcs	Quit1a			;got error		jsr	GetRsrcReadMark		;save mark if file only	partially read		bcs	Quit1a			;got errorReadDone	jsr	CloseFile		;close the file		bcs	Quit2a			;got error		jsr	IncBufPtr		;inc bufptr past file bytes		lda	<MoreToRead		;did whole file	fit in buffer?		bne	WriteIt			;no - so write out bufferNextFile1	dec	<NumItems		;# of dial items left		jsr	DrawThermoItems		jsr	GetNextFile		;get next filename from	catalog		bcs	WriteIt			;no more files - so write out buffer				stz	<ReadDuplicate		brl	ReadLoop		;loop until done with all catalogs;; stepping stones to quit code;Quit0a		brl	Quit0Quit1a		brl	Quit1Quit2a		brl	Quit2;; '# left' dialog is up; data and resources have been read; create new files and write out file contents;WriteIt		NAME		jsr	RestartBuf		;set BufPtr back to start of buffer		lda	<SavedCatHndl		;set CatHndl to	starting catalog		sta	<CatHndl		lda	<SavedCatHndl+2		sta	<CatHndl+2		lda	<SavedCatPtr		;set CatPtr to starting	file		sta	<CatPtr		lda	<SavedCatPtr+2		sta	<CatPtr+2		lda	<SavedCatIndex		;set CatIndex to # of catalogs left		sta	<CatIndex		;at start		lda	#C1_DstPathName		;put ptr to DstPathName		sta	O_NamePtr		;in OPEN params		sta	OE_NamePtr		sta	<PathNamePtr		;set up	ptr to DstPathName		lda	#^C1_DstPathName		sta	O_NamePtr+2		sta	OE_NamePtr+2		sta	<PathNamePtr+2		lda	#strgWriting		;point to 'Writing: '		sta	<RWPtr		lda	#strgWriting>>16		sta	<RWPtr+2		jsr	CheckKey		;duplicating, but does user want to cancel?		bcs	Quit2a			;yes					lda	<WriteDuplicate		;are we	duplicating a file?		beq	@notDuplicate		jsr	MakeDestinationName				lda	<MoreToWrite		;has this file been partially written?		beq	GotDstName		jsr	DrawNumFiles		;if so, print the filename and # of files left		jsr	DrawThermoItems		;'cause we can't		brl	WriteCont@notDuplicate	lda	<MoreToWrite		;has this file been partially written?		beq	@noMoreToWrite		jsr	DrawNumFiles		;if so, print the filename and # of files left		jsr	DrawThermoItems		;'cause we can't		brl	WriteCont@noMoreToWrite	lsr	<Disk2Sub		;copying a disk	to a subdirectory?		bcc	MakeWriteName		;no		ldy	#$0E			;yes - so change storage type info for		lda	#$0D			;volume	name into subdirectory storage		sta	[<BufPtr],y		;type;; loop to here as long as we have a file to write;WriteLoop	NAME		jsr	CheckKey		;does user want	to cancel?		bcc	MakeWriteName		brl	Quit2a			;yes		MakeWriteName	stz	<LastWriteType		jsr	MakeFileName		jsr	CheckSpace		;enough	space in buffer	for file info?		bcc	GotSpace		;yes		brl	ReadIt			;no - so done writing out bufferGotSpace	jsr	CheckDstName		;added 08/03/88 DJB		bcc	GoodDstName		jsr	NameErr		bcs	longQuit2a		;user canceled		bmi	skipIt			;user wants to skipGoodDstName	lda	#0			;flag to not append the filename to the dest string - 18-Jan-93 JCM		jsr	DoMagicRouting		;see if we should route this file specially - 18-Jan-93 JCM		bcs	doNextFile		;23-Jan-93 JCM - a little error checking, please?		jsr	MakePathName		;make complete pathname	for the	file		bcc	GotDstName		brl	Quit2			;name too longGotDstName	jsr	GetNumFiles		;get # of files	in cat,	set hi bit		ldx	#0			;indicate no dialog		jsr	CheckRAccess		;was file able to be read?		bcc	okToRead		;yes		;;;		dec	<NumFiles		;# of files left - 23-Jan-93 JCM - adding some error checkingdoNextFile	dec	<NumFiles		;# of files left - 23-Jan-93 JCM - adding some error checking		dec	<NumItems		;# of dial items left		jsr	GetNextFile		;get next filename from	catalog		bcc	@goContWrite				lda	thermoMax		;don't do anything which would draw the name here, you'll		ldx	#$FF			;be sorry if you do...		jsr	DrawThermo		jsr	DrawNumItems		brl	CopyDone		;no - so skip it@goContWrite	brl	contWrite				okToRead	jsr	StorePtr		;store ptr to pathname in buffer		jsr	SaveFileInfo		;make a	copy of	the file info for later		jsr	EnableAccess		;enable	all access bits		jsr	CreateFile		;create	the file		bcc	CreateOK		;no error during Create		bmi	longQuit2a		;got error - 'Cancel' selectedskipIt		brl	SkipThisFile		;file already exists, don't delete itCreateOK	jsr	DrawNumFiles		jsr	DrawThermoItems				jsr	SkipFileInfo		;inc bufptr past file info		lda	[<CatPtr]		;is this file a	subdirectory?		bne	SetBit			;yes - so nothing to writeWriteCont	lda	<LastWriteType		sta	<IsExtended		lda	#$0002			; write access only		jsr	OpenFile		;no - so open the file (both forks)		bcc	openRsrclongQuit2a	brl	Quit2a			;got erroropenRsrc	lda	#$0002			; write access only		jsr	OpenResource		bcs	longQuit2a		jsl	ProDOS			;start_session		DC.W	BEGIN_SESSION+C1		DC.L	session_call;--------------------------------------------------------		jsr	SetWriteMark		;set mark if file was partially	written		bcs	BcsQuit0		;got error  (Quit0 is too far away)		jsr	SetWriteSize		;get # of bytes	to write		jsr	SkipSizeInfo		;inc bufptr past size info		lda	RW_Size			;check if # of bytes to	write is 0		ora	RW_Size+2		beq	WriteExtend		;if so skip this write		jsr	WriteDataFile		;write out the bytes		bcs	BcsQuit0		;got error		jsr	GetDtWriteMark		;save mark if file only	partially written		bcs	BcsQuit0		;got errorWriteExtend	lda	RWE_Size		;check if # of bytes to	write is 0		ora	RWE_Size+2		beq	WriteDone		;if so skip this write		jsr	WriteRsrcFile		;write out the bytes		bcs	BcsQuit0		;got error		jsr	GetRsWriteMark		;save mark if file only	partially written		bcc	WriteDoneBcsQuit0	brl	Quit0			;got errorWriteDone	jsr	CloseFile		;close the file (both forks)		bcc	incBuf		brl	Quit2			;got errorincBuf		jsr	IncBufPtr		;inc bufptr past file bytes		lda	<MoreToWrite		;did the whole file in the buffer?		beq	SetBit			;yes - so continue		lda	<IsExtended		sta	<LastWriteType		brl	ReadIt			;no - so done writing bufferSetBit		pea	#0			; JAM 5/19/89 (Fixing BRC #48301)		jsr	SetFileInfo		;fix up	access bits and	'modified' info		jsr	SetCopyBit		;set bit in cat	to indicate file copiedNextFile2	dec	<NumFiles		;# of files left		dec	<NumItems		;# of dial items left		jsr	GetNextFile		;get next filename from	catalog		bcs	LastFileSkip		brl	contWriteLastFileSkip	lda	thermoMax		ldx	#$FF		jsr	DrawThermo		lda	<NumFiles		ldy	#0		jsr	DrawMsg			;update	box one last time		brl	CopyDoneSkipThisFile	NAME		sec		lda	<NumFiles		;# of files left to copy		sbc	<FilesInCat		;# of files to skip		sta	<NumFiles		lda	<FilesInCat		;# of files to skip		pha		sec		lda	<NumItems		;# of dial items left to display		sbc	1,s			;# of items to skip		sta	<NumItems		pla		lda	<FilesInCat				bne	@hadFiles		dec	<NumItems		;# of dial items left		dec	<NumItems		;*2 because we both read and wrote		dec	<NumFiles@hadFiles		lda	#0			;zero out offset in case it's a subdir		sta	[<CatPtr]		;so it will be skipped		jsr	GetNextFile		;skip the file		bcc	SkipLoop		bcs	LastFileSkip		;no more files to copy so we're doneSkipLoop	jsr	CheckSpace		;enough	space in buffer	for file info?		bcs	SkipDone		;no - so done skipping files		ldx	#0			;indicate no dialog		jsr	CheckRAccess		;was file able to be read?		bcs	SkipCont		;no				ldy	#$0E		lda	[<BufPtr],y		;get storage type of file		pha				;and save		jsr	SkipFileInfo		;inc bufptr past file info		pla				;retrieve storage type		cmp	#$0D			;is this file a	subdirectory?		beq	SkipCont		;yes - so nothing to skip over		stz	<isExtended		;patch to make sure that we skip extended files		cmp	#5			;correctly -- AEN, 1/30/92		bne	@notExtended		inc	<isExtended@notExtended		jsr	SetWriteSize		;get # of bytes	to skip	over in	buffer		jsr	SkipSizeInfo		;inc bufptr past size info		jsr	IncBufPtr		;skip over bytes		lda	<MoreToWrite		;any more in buffer?		bne	SkipDone		;yes - so done skipping	filesSkipCont	lda	<FilesInCat		beq	contWrite		dec	<FilesInCat		;# of files left to skip		bne	SkipLoop		;loop until done skipping filescontWrite	stz	<WriteDuplicate		;next time around say we're not duplicating		brl	WriteLoop		;(even though we are)				SkipDone	stz	<MoreToWrite		;clear out flag		stz	<MoreToRead		;clear out flag		stz	<DataReadMark		;clear out ReadMarks so SetReadSize		stz	<DataReadMark+2		;works correctly for next file		stz	<RsrcReadMark		stz	<RsrcReadMark+2		lda	<OrigSrcLen		;restore original length of SrcPathName		sta	C1_SrcPathName		;in case we're in the middle of a folder		stz	<WriteDuplicate		;next time around say we're not duplicating		stz	<ReadDuplicate		brl	ReadIt;; cancel occurred during a write, so close the file and delete it;Quit0		jsr	CloseFile		;close currently open file;		bcs	QuitDone		;got error		pea	#0			; JAM (BRC #48301)		jsr	DestroyFile		;delete	the file		bra	QuitDone;cancel	occurred during	a read,	so close the fileQuit1		jsr	CloseFile		;close currently open file;if there is a partially written file, delete itQuit2		lda	<MoreToWrite		;is there a partially written file?		beq	QuitDone		;no		lda	#C1_DstPathName		;yes - so create ptr to	name of	file		sta	<PathNamePtr		lda	#^C1_DstPathName		sta	<PathNamePtr+2		pea	#0			; JAM 5/19/89 (BRC #48301)		jsr	DestroyFile		;delete	the fileQuitDone	lda	#$FFFF		sta	<Error			;return	an error		bra	CopyDone2;done copying all files, finish	upCopyDone	stz	<Error			;don't return an error		pea	$8005			;task accomplished		_SysBeep2CopyDone2	jsl	ProDOS			;stop_session, added for hack		DC.W	END_SESSION+C1		;05/17/88 DJB		DC.L	session_call		PushZLong <BufHndl		;get rid of buffer		jsl DisposeHandleGlue		stz	<WhichMsg		;clear out msg number		stz	<Disk2Sub		;clear out flags				stz	<ReadDuplicate		stz	<WriteDuplicate		lda	<RetAdrs		pha		rts;; Zero out the counters for file copying each time a single file is copied;ZeroSoFar		stz	<SoFarFlag		;clear the 'bytes read from this file so far' flag		stz	<DataForkYet		stz	<DataForkYet+2		stz	<RsrcForkYet		stz	<RsrcForkYet+2				stz	<DataReadSize		stz	<DataReadSize+2		stz	<RsrcReadSize		stz	<RsrcReadSize+2		rts		;; DrawThermoItems;.....................................................................DrawThermoItems		lda	ThermoMax		sec		sbc	<NumItems		ldx	#0		brl	DrawThermo;; DrawNumFiles;.....................................................................DrawNumFiles		lda	<NumFiles		ldy	#0					brl	DrawMsg			;update	'number left' msg;---------------------------------------------------------------; CheckSpace;---------------------------------------------------------------CheckSpace	lda	#0		cmp	<BytesLeft+2		;is there enough space for another		bne	CSRet			;file info block and size info?		lda	#SFISize+SizeOfSizeInfo		cmp	<BytesLeftCSRet		rts				;carry clear if	enough room;---------------------------------------------------------------; StorePtr;---------------------------------------------------------------StorePtr		lda	#12			;setup pcount for Get_file_info in buffer		sta	[<BufPtr]		ldy	#2		lda	<PathNamePtr		;store PathNamePtr in buffer		sta	[<BufPtr],y		iny		iny		lda	<PathNamePtr+2		sta	[<BufPtr],y		lda	<BufPtr		clc		adc	#FI_OptionList-FI_Params	;offset of option_list ptr		ldy	#FI_OptionListPtr-FI_Params 	;andy, 11/21/90		sta	[<BufPtr],y		lda	<BufPtr+2		adc	#0		iny		iny		sta	[<BufPtr],y		tya		clc				;re-init our buffer's length		adc	#18			;or, init it in the first place		tay		lda	#64		sta	[<BufPtr],y		rts;---------------------------------------------------------------; CheckRAccess;---------------------------------------------------------------CheckRAccess		ldy	#6			;offset	to access field		lda	[<BufPtr],y		;get access bits for file		ror	a			;is read access	allowed?		bcc	ReadErr			;no		clc				;yes - so indicate no error		rtsReadErr		phx				;save dialog instructions		jsr	SkipFileInfo		;inc bufptr past file info		plx				;put up	dialog?		beq	CRARet			;no		lda	#$8002			;Finder's read access error		jsr	ProDosErr		;handle	the errorCRARet		sec				;indicate error		rts;---------------------------------------------------------------; EnableAccess;---------------------------------------------------------------EnableAccess		ldy	#6		lda	#$C3			;enable	all access bits		sta	[<BufPtr],y		rts;---------------------------------------------------------------; GetNumFiles;---------------------------------------------------------------GetNumFiles		ldy	#2			;if this is the	first entry in the cat		lda	[<CatPtr],y		;the flag word contains	the # of files		sta	<FilesInCat		;in the	catalog		lda	#$8000			;set hi	bit to indicate	flag is	valid		sta	[<CatPtr],y		;clear other bits since	used later		rts;---------------------------------------------------------------; SaveFileInfo;---------------------------------------------------------------SaveFileInfo	NAME		ldy	#SFISize-2SFILoop		lda	[<BufPtr],y		;copy file info	into FI_Params		sta	FI_Params,y		dey		dey		bpl	SFILoop		lda	#FI_OptionList		;point to our option_list within the		sta	FI_OptionListPtr	;fixed block of memory instead of pointing		lda	#FI_OptionList>>16	;to the buffer... just in case		sta	FI_OptionListPtr+2	;andy, 11/21/90;; Determine if the file we're writing is extended;		stz	<LastWriteType		ldy	#$0E			;get storage type		lda	[<BufPtr],y		cmp	#$0005			;is it an extended file?		bne	endSFE			;no		inc	<LastWriteTypeendSFE		rts;---------------------------------------------------------------; GetReadMark		(modified for extended files - DJB);---------------------------------------------------------------GetDataReadMark		clc				;indicate no error		stz	<DataReadMark		;clear out read	mark		stz	<DataReadMark+2		lda	<MoreToRead		;was file only partially read?		and	#dataFork		beq	GRMRet			;no		lda	#0		jsr	GetMark			;yes - so get data file mark		lda	GM_Position		sta	<DataReadMark		;and save for later		lda	GM_Position+2		sta	<DataReadMark+2GRMRet		rts				;carry indicates error from GetMark callGetRsrcReadMark		clc				;indicate no error		stz	<RsrcReadMark		;clear out read	mark		stz	<RsrcReadMark+2		lda	<MoreToRead		;was file only partially read?		and	#resourceFork		beq	GRMRet2			;no		lda	#1		jsr	GetMark			;yes - so get resource file mark		lda	GM_Position		sta	<RsrcReadMark		;and save for later		lda	GM_Position+2		sta	<RsrcReadMark+2GRMRet2		rts;---------------------------------------------------------------; SetReadMark		(Modified to work with extended files - DJB);---------------------------------------------------------------SetReadMark		clc				;indicate no error		lda	<MoreToRead		;was data file partially read?		and	#dataFork		beq	SRMCont			;no		lda	<DataReadMark		;yes - so get file mark	from previous		sta	SM_Displace		;read		lda	<DataReadMark+2		sta	SM_Displace+2		lda	#0		jsr	SetMark			;and set the file mark		bcs	SRMRet			;an error occuredSRMCont		lda	<MoreToRead		;was resource file partially read?		and	#resourceFork		beq	SRMRet			;no		lda	<RsrcReadMark		;yes - so get file mark	from previous		sta	SM_Displace		;read		lda	<RsrcReadMark+2		sta	SM_Displace+2		lda	#1		jsr	SetMark			;and set the file markSRMRet		rts				;carry indicates error from SetMark call;---------------------------------------------------------------; GetDtWriteMark	(modified for extended files - DJB);---------------------------------------------------------------GetDtWriteMark		clc				;indicate no error		stz	<DataWriteMark		;clear out file	mark		stz	<DataWriteMark+2		lda	<MoreToWrite		;was file only partially written?		and	#dataFork		beq	GWMRet			;no		lda	#0		jsr	GetMark			;yes - so get file mark		lda	GM_Position		sta	<DataWriteMark		;and save for later		lda	GM_Position+2		sta	<DataWriteMark+2GWMRet		rts				;carry indicates error from GetMark callGetRsWriteMark		clc				;indicate no error		stz	<RsrcWriteMark		;clear out file	mark		stz	<RsrcWriteMark+2		lda	<MoreToWrite		;was file only partially written?		and	#resourceFork		beq	GWMRet			;no		lda	#1		jsr	GetMark			;yes - so get file mark		lda	GM_Position		sta	<RsrcWriteMark		;and save for later		lda	GM_Position+2		sta	<RsrcWriteMark+2		rts				;carry indicates error from GetMark call;---------------------------------------------------------------; SetWriteMark		(modified for extended files - DJB);---------------------------------------------------------------SetWriteMark		clc				;indicate no error		lda	<MoreToWrite		;was data fork partially written?		and	#dataFork		beq	SWMCont			;no		lda	<DataWriteMark		;yes - so get file mark	from previous		sta	SM_Displace		;write		lda	<DataWriteMark+2		sta	SM_Displace+2		lda	#0		jsr	SetMark			;and set the file mark		bcs	SWMRet			;errorSWMCont		lda	<MoreToWrite		;was resource fork partially written?		and	#resourceFork		beq	SWMRet			;no		lda	<RsrcWriteMark		;yes - so get file mark	from previous		sta	SM_Displace		;write		lda	<RsrcWriteMark+2		sta	SM_Displace+2		lda	#1		jsr	SetMark			;and set the file markSWMRet		rts				;carry indicates error from SetMark call;---------------------------------------------------------------; SetReadSize		(modified for extended files - DJB);---------------------------------------------------------------SetReadSize		stz	RWE_Size		;# of resource bytes to read		stz	RWE_Size+2		stz	RW_Size			;# of data bytes to read		stz	RW_Size+2		sec		lda	<BytesLeft		;subtract bytes used for size info		sbc	#sizeOfSizeInfo		;to get	# of bytes left	in buffer		sta	<BytesLeft		lda	<BytesLeft+2		sbc	#0		sta	<BytesLeft+2		lda	<DataForkYet		ora	<DataForkYet+2		beq	SRSResourceRead		sec		lda	<DataForkYet		;calculate # of	bytes left to read		sbc	<DataReadSize		;in data fork		sta	<DataForkYet		lda	<DataForkYet+2		sbc	<DataReadSize+2		sta	<DataForkYet+2		lda	<DataForkYet		ora	<DataForkYet+2		beq	SRSResourceRead		lda	<BytesLeft		;enough	bytes left in buffer?		cmp	<DataForkYet		lda	<BytesLeft+2		sbc	<DataForkYet+2		bcs	Enough			;BytesLeft ³ O_DataEOF		lda	#dataFork		tsb	<MoreToRead		;set 'partial read' flag		lda	<BytesLeft		;not enough space in buffer so only		sta	RW_Size			;read #	of bytes which will fit		sta	<DataReadSize		lda	<BytesLeft+2		sta	RW_Size+2		sta	<DataReadSize+2		lda	<IsExtended		;an extended file ?		beq	@goSRSDone		;no		lda	#resourceFork		tsb	<MoreToRead		;set 'partial read' flag@goSRSDone	brl	SRSDoneEnough		lda	#dataFork		trb	<MoreToRead		lda	<DataForkYet		;enough	space to read entire remainder of data fork		sta	RW_Size			;# of bytes to read		sta	<DataReadSize		lda	<DataForkYet+2		sta	RW_Size+2		sta	<DataReadSize+2SRSResourceRead	lda	<IsExtended		;an extended file ?		beq	SRSDone			;no		lda	<RsrcForkYet		ora	<RsrcForkYet+2		beq	SRSDone		sec		lda	<RsrcForkYet		;calculate # of	bytes left to read		sbc	<RsrcReadSize		;in resource fork		sta	<RsrcForkYet		lda	<RsrcForkYet+2		sbc	<RsrcReadSize+2		sta	<RsrcForkYet+2		lda	<RsrcForkYet		ora	<RsrcForkYet+2		beq	SRSDone		sec		lda	<BytesLeft		;get real bytes-left		sbc	RW_Size		sta	<localTemp		lda	<BytesLeft+2		sbc	RW_Size+2		sta	<localTemp+2		lda	<localTemp		;enough	bytes left in buffer?		cmp	<RsrcForkYet		lda	<localTemp+2		sbc	<RsrcForkYet+2		bcs	Enough2			;localTemp ³ O_RsrcEOF		lda	#resourceFork		tsb	<MoreToRead		;set 'partial read' flag		lda	<localTemp		;not enough space in buffer so only		sta	RWE_Size		;read #	of bytes which will fit		sta	<RsrcReadSize		lda	<localTemp+2		sta	RWE_Size+2		sta	<RsrcReadSize+2		bra	SRSDone		Enough2		lda	#resourceFork		trb	<MoreToRead		lda	<RsrcForkYet		;enough	space to read entire remainder of resource fork		sta	RWE_Size		;# of bytes to read		sta	<RsrcReadSize		lda	<RsrcForkYet+2		sta	RWE_Size+2		sta	<RsrcReadSize+2SRSDone		lda	RW_Size		sta	[<BufPtr]		;save lo word of data 'size' in buffer		ldy	#2		lda	RW_Size+2		sta	[<BufPtr],y		;save hi word of data 'size' in buffer		iny		iny		lda	<MoreToRead		;get 'partial read' flag		sta	[<BufPtr],y		;and save in buffer		iny		iny		lda	RWE_Size		sta	[<BufPtr],y		;save lo word of resource 'size' in buffer		iny		iny		lda	RWE_Size+2		sta	[<BufPtr],y		;save hi word of resource 'size' in buffer		clc				;indicate no error		rts;---------------------------------------------------------------; SetWriteSize		(modified for extended files - DJB);---------------------------------------------------------------SetWriteSize	NAME		sec		lda	<BytesLeft		;subtract bytes used for size info		sbc	#sizeOfSizeInfo		;to get	# of bytes left	in buffer		sta	<BytesLeft		;(BytesLeft is used later)		lda	<BytesLeft+2		sbc	#0		sta	<BytesLeft+2		lda	[<BufPtr]		;get data 'size' out of buffer		sta	RW_Size			;and set up READ/WRITE param block		ldy	#2		lda	[<BufPtr],y		sta	RW_Size+2		iny		iny		lda	[<BufPtr],y		;get 'partial read' flag out of	buffer		sta	<MoreToWrite		;and set up 'partial write' flag		iny		iny		lda	[<BufPtr],y		;get resource 'size' out of buffer		sta	RWE_Size		;and set up READ/WRITE param block		iny		iny		lda	[<BufPtr],y		sta	RWE_Size+2		rts;---------------------------------------------------------------; SkipFileInfo;---------------------------------------------------------------SkipFileInfo	NAME		clc				;inc bufptr past file info		lda	<BufPtr		adc	#SFISize		sta	<BufPtr		lda	<BufPtr+2		adc	#0		sta	<BufPtr+2		sec				;subtract # of bytes used for file info		lda	<BytesLeft		;to get	# of bytes left	in buffer		sbc	#SFISize		sta	<BytesLeft		lda	<BytesLeft+2		sbc	#0		sta	<BytesLeft+2		rts;---------------------------------------------------------------; SkipSizeInfo		(modified for extended files - DJB);---------------------------------------------------------------SkipSizeInfo	NAME		clc				;inc bufptr past size info		lda	<BufPtr		adc	#sizeOfSizeInfo		sta	<BufPtr		sta	RW_BufPtr		;save new bufptr in READ/WRITE		lda	<BufPtr+2		;parameter block		adc	#0		sta	<BufPtr+2		sta	RW_BufPtr+2		lda	<IsExtended		;an extended file ?		beq	SSIRet			;no		clc				;inc bufptr past data fork data		lda	<BufPtr		adc	RW_Size		sta	RWE_BufPtr		;save new bufptr in extend READ/WRITE		lda	<BufPtr+2		;parameter block		adc	RW_Size+2		sta	RWE_BufPtr+2SSIRet		rts;---------------------------------------------------------------; IncBufPtr		(modified for extended files - DJB);---------------------------------------------------------------IncBufPtr	NAME		clc				;inc bufptr past file bytes		lda	<BufPtr		adc	RW_Size		sta	<BufPtr		lda	<BufPtr+2		adc	RW_Size+2		sta	<BufPtr+2		sec				;subtract # of bytes used for file		lda	<BytesLeft		;to get	# of bytes left	in buffer		sbc	RW_Size		sta	<BytesLeft		lda	<BytesLeft+2		sbc	RW_Size+2		sta	<BytesLeft+2		lda	<IsExtended		;an extended file ?		beq	IBPRet			;no		clc				;inc bufptr past file bytes		lda	<BufPtr		adc	RWE_Size		sta	<BufPtr		lda	<BufPtr+2		adc	RWE_Size+2		sta	<BufPtr+2		sec				;subtract # of bytes used for file		lda	<BytesLeft		;to get	# of bytes left	in buffer		sbc	RWE_Size		sta	<BytesLeft		lda	<BytesLeft+2		sbc	RWE_Size+2		sta	<BytesLeft+2IBPRet		rts;---------------------------------------------------------------; RestartBuf;---------------------------------------------------------------RestartBuf	NAME		lda	<BufSize		;reset # of bytes left in buffer		sta	<BytesLeft		lda	<BufSize+2		sta	<BytesLeft+2		lda	[<BufHndl]		;reset bufptr to start of buffer		sta	<BufPtr		ldy	#2		lda	[<BufHndl],y		sta	<BufPtr+2		rts;---------------------------------------------------------------; SetCopyBit;---------------------------------------------------------------SetCopyBit	NAME		ldy	#2		lda	[<CatPtr],y		;get flag word from first cat entry		ora	#ICCOPY			;set bit in flag word to indicate that		sta	[<CatPtr],y		;this file was copied successfully		rts		ENDP****************************************************************** GetNextFile*****************************************************************GetNextFile	PROCNAMEOffset		equ	localTemp		lda	[<CatPtr]		;is this a subdirectory	entry?		bne	SubDir			;yesEntryDone	jsr	RemoveName		;remove	file name		jsr	IncCatPtr		;go on to next cat entry		bra	CkSubDirEnd		;chk type of first entry: end of subdir?;-------------------------------------------------------------------------------SubDir		sta	<Offset			;save offset to	subdir's content entries		jsr	AddSlash		;add separator to pathname		jsr	SetCatPtr		;skip to entries for subdir's contentsCkSubDirEnd	lda	[<CatPtr]		;get type of first entry		cmp	#$FFFF			;at end	of subdirectory?		bne	returnOK		;bra if not: indicate no error, return;-------------------------------------------------------------------------------DirEnd		ldy	#2		lda	[<CatPtr],y		;get next word from cat	entry		sta	<Offset			;and save		cmp	#$FFFF			;at end	of catalog?		beq	GetNextCat		;yes - so go on	to next	catalog		jsr	RemoveSlash		;remove	separator from pathname		jsr	SetCatPtr		;go back to subdirectory entry		lda	<DeleteFlag		;are we	deleting files?		beq	EntryDone		;no - so done with subdirectory	entry		lda	#0			;yes - so still	have to	use subdir entry		sta	[<CatPtr]		;zero out subdirectory offset		jsr	RemoveName		;remove	name of	subdirectoryreturnOK	clc				;indicate no error		rts;-------------------------------------------------------------------------------; GetNextCat;; Called with handles to catalogs on stack and index to	one we need to use; in CatIndex.;; Returns with requested handle	in CatHndl, locked and derefed into CatPtr.; CatIndex is decremented by 1.;; Stack	on input looks like:;	   ...;	   Handle 2 (4 bytes);	   Handle 1 (4 bytes);	   RTS (2 bytes);   TOS	==>;-------------------------------------------------------------------------------		ENTRY	GetNextCatGetNextCat	NAME		lda	<CatIndex		;any more catalogs to handle?		beq	NoMoreCats		;no		tsc				;get stack pointer in A		inc	a			;make it point to first	handle on stack		inc	a		inc	a		pha				;save pointer to first handle on stack		lda	<CatIndex		;get index into	catalogs		dec	a			;and make into a zero-based index		asl	a			;mult by 4 to index into correct handle		asl	a		clc				;add to	value on stack		adc	1,s			;to create offset to requested handle		tax				;put in	X		pla				;clean up stack		lda	>0,x			;get requested handle from stack		sta	<CatHndl		;and save		lda	>2,x		sta	<CatHndl+2		jsr	LockCat			;lock and dereference cat handle		dec	<CatIndex		clc				;indicate no error		rtsNoMoreCats	sec				;indicate error		rts;---------------------------------------------------------------; IncCatPtr;    to get next cat entry:;      CatPtr = CatPtr + name + lenbyte + 4 info bytes;---------------------------------------------------------------		EXPORT	IncCatPtrIncCatPtr		ldy	#4		lda	[<CatPtr],y		;get length of name from cat entry		and	#$007F			;mask off hi byte and high bit (translated bit)		clc		adc	#5			;add length byte + 4 info bytes		clc		adc	<CatPtr			;add to	CatPtr to create ptr to		sta	<CatPtr			;next cat entry		lda	<CatPtr+2		adc	#0		sta	<CatPtr+2		rts;---------------------------------------------------------------; SetCatPtr;---------------------------------------------------------------SetCatPtr		clc		lda	[<CatHndl]		;get ptr to start of catalog		adc	<Offset			;and add offset	to create ptr		sta	<CatPtr			;to correct cat	entry		ldy	#2		lda	[<CatHndl],y		adc	#0		sta	<CatPtr+2		rts;---------------------------------------------------------------; RemoveName;   remove name in [<CatPtr],4 or TranslatedName from PathNamePtr;---------------------------------------------------------------		EXPORT	RemoveNameRemoveName	NAME;; Sigh, just a historical note: when Jim scans backwards for a separator, he was doing it in; complete 8-bit mode for all registers.  This is bad if the Finder's using wStrings.; Fixed to use wStrings properly. -- andy, 12/1/91;;;  JAM 5/31/89 (Fixing BRC #50015);  The old version of this routine, shown below under OLD CODE,;  used lengths of current file names to prune the accumulated pathname;  back when necessary to proceed on to another file/directory name during;  a multiple file-processing operation.  This method became invalid when we;  introduced the notion of filename translation (especially manual translation;  on the fly!), because the length of the original and translated names would;  sometimes differ (or otherwise get out of sync).  To fix BRC #46451, I;  changed specialCase (the case when we are allegedly mopping up after a;  translation) to scan backward for a separator, instead of relying on;  original/target string lengths to remain in sync.  Now, to fix BRC #50015,;  in which translation is proposed but REFUSED, it seems wise to use the same;  method of pruning the accumulated pathname.  To guard against any other;  hidden gotchas like this, I am eliminating all the original code entirely,;  and ALL cases requiring RemoveName will be served by the backscan for separator.;;;   The old version of this routine used the length of;   TranslatedName, which is an erroneous value when we are trying to back up one;   subdirectory level.  In this specialCase, we scan backward to get to a;   SEPARATOR.;; * * * * * * * * * * * * * OLD CODE; * RemoveName; *		ldy	#4; *		lda	[<CatPtr],y		;check length of name to be removed; *		bmi	specialCase		;use TranslatedName instead! -DJB; *		sec; *		lda	[<PathNamePtr]		;get length of pathname; *		ldy	#4; *		sbc	[<CatPtr],y		;subtract length of name to be removed; *		sta	[<PathNamePtr]		;and store as new length of pathname; *		bra	rnEND; * specialCase; *		lda	[<PathNamePtr]		;get length of pathname; *		sec; *		sbc	TranslatedName		;subtract length of name to be removed; *		sta	[<PathNamePtr]		;and store as new length of pathname; *rnEND	rts; * * * * * * * * * * * * * END OLD CODE;;; --- New code starts here -----------------------------------------------------------;		lda	[<PathNamePtr]		;get length of pathname		tay				;prepare to use it as an index		iny				;to compensate for length WORD		SEP 	#$20		LONGA	OFF@loop		cpy	#2			;first char index of PathName		bcc	@done		lda	[<PathNamePtr],y	;get the current char		cmp	#SEPARATOR		;is it my target?		beq	@done			;yep ... my work is done		dey				;nope		bra	@loop			@done		REP	#$20		LONGA	ON				dey				;uncompensate for length WORD		tya				;adjust the length		sta	[<PathNamePtr]				rts;---------------------------------------------------------------; AddSlash;---------------------------------------------------------------		EXPORT	AddSlashAddSlash		lda	[<PathNamePtr]		tay		iny		lda	[<PathNamePtr],y		and	#$00FF		cmp	#SEPARATOR		beq	@doneAddSep		tya		sta	[<PathNamePtr]		lda	#SEPARATOR		;add separator to end of pathname		iny		sta	[<PathNamePtr],y@doneAddSep	rts;---------------------------------------------------------------; RemoveSlash;---------------------------------------------------------------		EXPORT	RemoveSlashRemoveSlash		lda	[<PathNamePtr]		;remove	separator from end of pathname		dec	a		sta	[<PathNamePtr]		rts;---------------------------------------------------------------; LockCat;   lock and dereference cat handle;---------------------------------------------------------------LockCat		ldy	#4		lda	[<CatHndl],y		ora	#$8000			;set locked bit	in attribute word		sta	[<CatHndl],y		lda	[<CatHndl]		;dereference handle into ptr		sta	<CatPtr		ldy	#2		lda	[<CatHndl],y		sta	<CatPtr+2		rts		ENDP****************************************************************** GetBuffer*****************************************************************GetBuffer	PROCNAME		pha		pha		pei	<NumFiles		;first, try to allocate enough memory to hold		pea	SizeOfSizeInfo+SFISize+1 ;the number of files * extra size information		_Multiply		pla		sta	<BufSize		pla		sta	<BufSize+2				lda	<TotalEOF		clc		adc	<BufSize		sta	<BufSize		lda	<TotalEOF+2		adc	<BufSize+2		sta	<BufSize+2				jsr	AllocateMem		; allocate it		sta	<BufHndl		; save handle		stx	<BufHndl+2		bcc	@freeCheck	;; if we couldn't get enough to copy all the files in one pass, settle for grabbing MaxBlock; (if possible);		pha				; space for result		pha		_MaxBlock			; get size of largest memory block		pla		and	#$FE00			; allign to 512 byte boundry - DJB		sta	<BufSize		pla		sta	<BufSize+2		jsr	AllocateMem		; allocate it		bcs	@error			; got error		sta	<BufHndl		; save handle		stx	<BufHndl+2;; Check if there is at least 32K left;@freeCheck	pha				; space for result		pha		_RealFreeMem			; get amount of RAM left		pla		cmp	#$8000		pla		sbc	#$0000		bcs	@ok			; maxBlock ³ $4000 (32K);; Otherwise, give some back;		PushLong <BufHndl		; give it back		jsl DisposeHandleGlue		sec		lda	<BufSize		sbc	#$4000			; subtract 16K; 3K will be used for		sta	<BufSize		;  deleting duplicate subdirectories		lda	<BufSize+2		;  and the rest for GSOS cushion.		sbc	#0		sta	<BufSize+2		jsr	AllocateMem		; allocate memory		bcs	@error			; got error		sta	<BufHndl		; save handle		stx	<BufHndl+2;; Now it is safe to use our memory;@ok		lda	[<BufHndl]		;dereference handle		sta	<BufPtr		ldy	#2		lda	[<BufHndl],y		sta	<BufPtr+2		clc				;indicate no error@error		rts		ENDP****************************************************************** AllocateMem*****************************************************************AllocateMem	PROC		ldy	#0		phy				;space for result		phy		PushZLong <BufSize		;size of buffer	in bytes		PushZWord <ProgID		;ID		PushWord #$4000			;fixed and unpurgeable		phy				;loc not important		phy		_NewHandle			;allocate space		pla				;lo word of handle		plx				;hi word of handle		rts		ENDP****************************************************************** CallBack -- our callback routine for xCatalog*****************************************************************CallBack	PROC		IMPORT	DrawNumItems 				phb		phk		plb		phd				lda	ZeroPage		tcd				stx	<CallBackStructPtr		sty	<CallBackStructPtr+2				lda	CopyWindowPtr+1		;if there's no window, don't update the count		beq	@noWindow				lda	<NumFiles		;used to be [<CallBackStructPtr]		clc		adc	[<CallBackStructPtr]		ldy	#0		jsr	DrawNumItems		@noWindow	pld		plb		rtl		ENDP****************************************************************** CatalogSrc*****************************************************************CatalogSrc	PROCNAMERetAdrs		equ	localTemp		pla				;get return address		sta	<RetAdrs		;and save				stz	<CatalogEOF		stz	<CatalogEOF+2		pha				;space for fst result				pha				;space for file's eof result		pha				pha				;space for handle result		pha				pha				;space for integer result		pha				;space for integer result		pushlong #CallBack		pushlong #C1_SrcPathName	;ptr to	pathname		phx				;set up	by calling routine		ldx	#xCatalog		jsl	MiscEntry		;get catalog		tay				; save error code JAM 5/18/89 (BRC #48728)		pla			sta	<SrcFileSysID		;save the source file system				pla		sta	<CatalogEOF		pla		sta	<CatalogEOF+2				plx				;# of locked files		pla				;# of files in catalog		bcs	CatErr			;Catalog routine got an	errorDone		pei	<RetAdrs		rtsCatErr		pla				;clean up stack		pla		bra	Done		ENDP		****************************************************************** MakePathName*****************************************************************MakePathName	PROC		IMPORT	doAlertWindow		ldy	#4		lda	[<CatPtr],y		;get length of name in cat entry		and	#$0080		bne	specialCase		;use TranslatedName instead! -DJB		lda	[<CatPtr],y		;get length of name in cat entry		and	#$00FF		tay				;and save		clc		adc	[<PathNamePtr]		;add to	length of current pathname		cmp	#MaxPathLen		;is name too long?		bcs	Err			;yes		sta	[<PathNamePtr]		;save new length		tax		inx				;account for length word		iny				;add 4 to length of name in cat	entry		iny				;in order to skip over the 4 info bytes		iny		iny		sep	#$20		LONGA	OFF@loop		lda	[<CatPtr],y		;copy name into	pathname string		phy		txy		sta	[<PathNamePtr],y		ply		dex		dey		cpy	#4			;done with name?		bne	@loop			;no		rep	#$20			;go back to 16-bit mode		LONGA	ON		clc				;indicate no error		rtsspecialCase	lda	TranslatedName		;get length of "new" filename		and	#$00ff		tay				;and save		clc		adc	[<PathNamePtr]		;add to	length of current pathname		cmp	#MaxPathLen		;is name too long?		bcs	Err			;yes		sta	[<PathNamePtr]		;save new length		tax		inx				;account for length word		sep	#$20		LONGA	OFF@sLoop		lda	TranslatedName,y	;copy name into	pathname string		phy		txy		sta	[<PathNamePtr],y		ply		dex		dey		bne	@sLoop		rep	#$20			;go back to 16-bit mode		LONGA	ON		clc				;indicate no error		rts;-------------------------------------------------------------------------------Err		clc		lda	<CatPtr			;create	ptr to name in catalog		adc	#4			;for dialog to use		sta	<OtherPtr		lda	<CatPtr+2		adc	#0		sta	<OtherPtr+2		lda	#rasPathTooLong		jsl	doAlertWindow		sec		rts		ENDP****************************************************************** MakeSrcName:	append file name to C1_SrcPathName*****************************************************************MakeSrcName	PROC		IMPORT	doAlertWindow		lda	<srcPathLen		sta	C1_SrcPathName		lda	INamePtr+2		;points to file name		pha		lda	INamePtr		pha		PushLong #C1_SrcPathName		jsl	PathAddName		bcs	Err			;pathname length error		rts				;return with carry clear;-------------------------------------------------------------------------------Err		lda	<SrcPathLen		;set length of SrcPathName		sta	C1_SrcPathName		lda	#C1_SrcPathName		;create	ptr to SrcPathName for dialog		sta	<PathNamePtr		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		lda	<INamePtr		;create	ptr to icon name for dialog		sta	<OtherPtr		;to use		lda	<INamePtr+2		sta	<OtherPtr+2		lda	#rasPathTooLong		jsl	doAlertWindow		sec		rts		ENDP****************************************************************** MakeFileName		*****************************************************************MakeFileName	PROC		lda	<CatPtr		clc		adc	#4		sta	<FileNamePtr		lda	<CatPtr+2		adc	#0		sta	<FileNamePtr+2		clc				;indicate no error		rts		ENDP****************************************************************** MakeDestinationName		*****************************************************************MakeDestinationName PROC		IMPORT 	PathGetName		IMPORT	c1_dest		import	c1_DstPathName		import	WToPString		import	filename		pushlong #c1_dest		pushlong #c1_DstPathName		jsl	PathGetName		lda	#Filename		sta	<FileNamePtr		lda	#Filename>>16		sta	<FileNamePtr+2		pushlong #c1_dest		pushZLong <FileNamePtr		jsl	WToPString		rts		ENDP		****************************************************************** MakeDstName*****************************************************************MakeDstName	PROC		IMPORT	doAlertWindow		lda	<dstPathLen		sta	C1_DstPathName		lda	INamePtr+2		pha		lda	INamePtr		pha		PushLong #C1_DstPathName		jsl	PathAddName		bcs	Err			;pathname length error		rts				;return with carry clear;-------------------------------------------------------------------------------Err		lda	<DstPathLen		;set length of DstPathName		sta	C1_DstPathName		lda	#C1_DstPathName		;create	ptr to DstPathName for dialog		sta	<PathNamePtr		lda	#^C1_DstPathName		sta	<PathNamePtr+2		lda	<INamePtr		;create	ptr to icon name for dialog		sta	<OtherPtr		;to use		lda	<INamePtr+2		sta	<OtherPtr+2		lda	#rasPathTooLong		jsl	doAlertWindow		sec		rts		ENDP****************************************************************** Make sure destination name is OK for ProDOS** IN:	<localTemp** USES:	c1_sourceBuf*	c1_source*****************************************************************CheckDstName	PROC						import	CustomPtr		import	CustomPtr2		import	fstNames		import	c1_Source		import	c1_SourceBuf		import	PToWString		import	WToPString				lda	<CatPtr		clc		adc	#4		sta	<NewNamePtr		lda	<CatPtr+2		adc	#0		sta	<NewNamePtr+2		ENTRY	CheckDstName2CheckDstName2	lda	<DstFileSysID		sta	fstID		pushZLong <NewNamePtr		pushlong #c1_source		jsl	PToWString		_JudgeNameGS JudgeParms		php		pushlong #c1_source		;always move our translated name back (JudgeName shouldn't touch		pushlong #TranslatedName	;it unless it really was bad).		jsl	WToPString		plp		bcs	@wayBogus		lda	JudgeParms+$10		bne	@wayBogus		clc		rts		@wayBogus	lda	fstID			;*6 -- create fst name string		asl	a		asl	a		tax		lda	>fstNames,x		sta	>CustomPtr2		lda	>fstNames+2,x		sta	>CustomPtr2+2;		lda	JudgeParms+$06		;move fst syntax pointer to *5;		sta	>CustomPtr;		lda	JudgeParms+$08;		sta	>CustomPtr+2		sec		rts;; locals;JudgeParms	dc.w	6fstID		dc.w	0			;fileSysIDnameType	dc.w	3			;nameType (file)		dc.L	0			;syntax		dc.w	0		dc.L	C1_SourceBuf		;keep this big so it has a lot of workspace (DAL)		dc.w	0		ENDP;-------------------------------------------------------------------------------NameErr		PROC		IMPORT	PathGetName		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	c1_dest		IMPORT	arrowCursor		IMPORT	finderTaskRecord		IMPORT	CopyUpdate		IMPORT	CustomPtr		IMPORT	DrawCopyControls		import	WindowGlobalON		import	WindowGlobalOFF		IMPORT	CloseCopyWindow		;in util.aii - 27-Jan-93 JCM		IMPORT	CloseTransWindow	;in util.aii - 27-Jan-93 JCM		pei	<PathNamePtr+2		;save ptr		pei	<PathNamePtr		lda	<SkipBadNames		beq	noUserYet		;no user decision		cmp	#1			;does user want default?		bne	@goErrExit1		brl	UseNew			;yes, so go straight to copy@goErrExit1	brl	errExit1		;else, user wants to skip "bad" namesnoUserYet		lda	#TranslatedName		;create ptr to "new" name		sta	<OtherPtr		;for dialog to use		lda	#^TranslatedName		sta	<OtherPtr+2		clc		lda	<CatPtr			;create	ptr to "old" name		adc	#4			;for dialog to use		sta	<PathNamePtr		lda	<CatPtr+2		adc	#0		sta	<PathNamePtr+2		lda	#NullStrg		;null string for feedback message box		sta	<RWPtr		sta	<FileNamePtr		lda	#NullStrg>>16		sta	<RWPtr+2		sta	<FileNamePtr+2putBox; ------------------------------------; JAM DJB 06/07/89  Fixing BRC #50355;   If we are not processing a file that corresponds to an;   icon in the user's selection, we really cannot skip him or;   anyone in his general area.  [<CatPtr],y, where y=2 is the;   count of files in the tree underneath the icon we are;   currently processing.  If that is nonzero (discounting carry),;   we are actually looking at the catalog corresponding to the patriarch.;   If zero, we are working with a child file/folder and should not;   permit skipping, because the skipfiles routine will break if we do.;   You're damned right it's ugly.  But it's safe.;		ldy	#2;		lda	[<CatPtr],y		; get count;		and	#$7FFF			; clean him up;		bne	@Normal			; branch if patriarch;   rdl 5/2/90 - Fix BRC# 53050 / WS# BCK071SMW - current catalog is saved to CurrentCat;     Sorry, Jim, but the above code is NOT safe. That same word is non-zero if file is LOCKED!;     Instead, letÕs see where CatPtr is pointing -- if itÕs at the current catalog or;        within it;--------------------------------------;; Some more notes on the following which replaced Ron's faulty kludge of Jim's faulty kludge;; See if the pointer to the current file is a pointer to the beginning of a catalog.  If it is, then; we need to see if we're about to write the real last item, and if so only give the user the dialog; with the <OK> and <Cancel> buttons.  If <CatPtr isn't pointing to the beginning of our catalog's handle,; then we're looking at something inside a catalog and we have to use the simpler dialog because the; 'skipfiles' routine back in DoFilecopy will break.  Otherwise if <CatPtr is pointing to our catalog's; handle and we're not the last item, show the user the dialog with the <Skip> and <Translate All>; buttons.;		lda	<CatPtr			;is current catalog item a parent?		cmp	[<CatHndl]				bne	@kid					ldy	#2		lda	<CatPtr+2		cmp	[<CatHndl],y		bne	@kid		lda	<NumFiles		;see if we are about to try to write the LAST file		cmp	#1		beq	@kid		@parent		lda	#9			;no skip stuff.		bra	JustDoIt;; If here, we know we are looking at a child catalog, so don't allow skipping -- or we're just looking at; a single file;@kid		lda	#8			;dialog with skip, etc.					JustDoIt	pha		jsl	SaveCursor		jsl	ArrowCursor		lda	<PathNamePtr		;adjust for *5		sta	>CustomPtr		lda	<PathNamePtr+2		sta	>CustomPtr+2				jsl	WindowGlobalON		plx		pha		pha		lda #0		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pha		pha				;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pha		phx				;window resource we want		pea	$800e			;rWindParam1		_NewWindow2				jsl	WindowGlobalOFF		pulllong transWindowPtr		bcc	@openOK;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	transWindowPtr+1		beq	@leave@done		jsl	CloseTransWindow@leave		jsl	RestoreCursor		lda	#$FFFF		brl	errExit2;; cool.  we got the resources we needed and have a window -- so set everyone's control values before; anything gets drawn;@openOK		pushlong transWindowPtr		pushlong #4		pushlong #TranslatedName		_SetLETextByID;; now that we've set all the controls values, use doModalWindow to play with everything;@loop		pha		pha		pea	0		lda	>finderTaskRecord		pha			;push the task record's ptr		lda #0		pha		pha			;update proc		pea $8000		pha			;eventHook		pha		pha			;beep proc		pea	$c010		;flags		_DoModalWindow		pla		plx		cmp	#5		blt	@loop		sec		sbc	#5		asl	a		tax		jmp	(@addrs,x)@addrs		dc.w	@cancel		;id = 5		dc.w	@ok		;6		dc.w	@skipOne	;7		dc.w	@skipAll	;8		dc.w	@translateAll	;9@close		jsl	restoreCursor		jsl	CloseTransWindow		rts@cancel		jsl	CloseCopyWindow		stz	copyWindowPtr+1		jsr	@close		lda	#$FFFF		sec		brl	errExit2@ok		pushlong transWindowPtr		;if so, then get the text they typed		pushlong #4		pushlong #TranslatedName		_GetLETextByID		jsr	@close		brl	userOK@skipOne	jsr	@close		jsr	DrawCopyControls		lda	<NumFiles		ldy	#0		jsr	DrawMsg		lda	#$8000		brl	errExit1@skipAll	jsr	@close		jsr	DrawCopyControls		lda	<NumFiles		ldy	#0		jsr	DrawMsg		lda	#$8000		sta	<SkipBadNames		brl	errExit1@translateAll	lda	#$0001			;must be translate all		sta	<SkipBadNames		jsr	@close		bra	userOK;; locals;		EXPORT	transWindowPtrtransWindowPtr	dc.L	0;; we either arrive here after saying "yeah, translate everything," or by selecting OK for; just this item;userOK		lda	TranslatedName		;get length of name		and	#$00FF			;mask off first	char		bne	@boxOK		brl	putBox			;name is null@boxOK		lda	#TranslatedName		sta	<NewNamePtr		lda	#TranslatedName>>16		sta	<NewNamePtr+2		jsr	CheckDstName2		bcc	@nameOK		brl	putBox			; name was still bad@nameOK		inc	<NamesWereXLated	; JAM 06/01/89 Fixing BRC #49639useNew		ldy	#4		lda	[<CatPtr],y		;set hi bit of length to mark change		ora	#$0080		sta	[<CatPtr],y		lda	#strgWriting		;point to Writing: '		sta	<RWPtr		lda	#strgWriting>>16		sta	<RWPtr+2				lda	#TranslatedName		;point to "new" filename		sta	<FileNamePtr		lda	#^TranslatedName		sta	<FileNamePtr+2		jsr	DrawCopyControls		lda	<NumFiles		;don't update the thermometer, but the		ldy	#0		jsr	DrawMsg			;text?  Yah, update that.		lda	#0errExit1	clc				;no errorserrExit2		plx		stx	<PathNamePtr		;restore ptr		plx		stx	<PathNamePtr+2		tax				;set/clear the minus flag		rts		ENDP****************************************************************** AddSrcSlash*****************************************************************AddSrcSlash	PROC		inc	C1_SrcPathName		;add 1 for separator		lda	C1_SrcPathName		;get new length	of source pathname		sta	<SrcPathLen		;and save		tax		lda	#SEPARATOR		;GS/OS separator character		sta	C1_SrcPathName+1,x	;add it after pathname		rts		ENDP****************************************************************** AddDstSlash*****************************************************************AddDstSlash	PROC		inc	C1_DstPathName		;add 1 for separator		lda	C1_DstPathName		;get new length	of destination pathname		sta	<DstPathLen		;and save		tax		lda	#SEPARATOR		;GS/OS separator character		sta	C1_DstPathName+1,x	;add it after pathname		rts		ENDP****************************************************************** GetNextIcon*****************************************************************GetNextIcon	PROC		ldy	#icFlag		lda	[<IconPtr],y		;get flag bits from IconObj record		and	#ICEXTENDED		;is this an extended icon?		bne	RetSet			;yes - so don't continue down list		lda	[<IconPtr]		;get handle to next icon in list		pha				;and save		ldy	#2		lda	[<IconPtr],y		pha		jsr	UnLockIcon		;unlock	current	icon		pla				;retrieve handle to next icon		sta	<IconHndl+2		pla		sta	<IconHndl		ora	<IconHndl+2		;is handle 0?		bne	GetSelIcon		;no - so check icon to see if selectedRetSet		sec				;done with list		rts		ENTRY	GetSelIconGetSelIcon							jsr	LockIcon		;lock and deref	icon handle		ldy	#icFlag		lda	[<IconPtr],y		;get flag bits in IconObj record		and	#ICSELECTED		;is icon selected?		beq	GetNextIcon		;no - so check next icon in list		jsr	MakeINamePtr		;create	ptr to Name field of IconObj rec		clc				;indicate no error		rts		ENDP****************************************************************** MakeINamePtr*****************************************************************MakeINamePtr	PROC		clc		lda	<IconPtr		;get ptr to IconObj record		adc	#icName			;add offset to Name field		tax				;to create ptr to Name field		lda	<IconPtr+2		adc	#0		pha		phx		PushLong #C1_IconName		jsl	PToWString		;convert it to class 1 string		lda	#C1_IconName		sta	<INamePtr		lda	#^C1_IconName		sta	<INamePtr+2		rts		ENDP****************************************************************** LockIcon*****************************************************************LockIcon	PROC		lda	IconHndl+1		bne	@haveHandle				stz	IconHndl		;finish zeroing out IconHndl		stz	IconPtr			;zero out IconPtr		stz	IconPtr+2				rts		@haveHandle	ldy	#4		lda	[<IconHndl],y		ora	#$8000			;set locked bit	in attribute word		sta	[<IconHndl],y		ENTRY	DerefIconDerefIcon					;		lda	[<IconHndl]		;dereference handle into ptr		sta	<IconPtr		ldy	#2		lda	[<IconHndl],y		sta	<IconPtr+2		rts		ENDP****************************************************************** UnLockIcon*****************************************************************UnLockIcon	PROC		ldy	#4		lda	[<IconHndl],y		and	#$7FFF			;clear locked bit in attribute word		sta	[<IconHndl],y		rts		ENDP****************************************************************** CheckKey** NOTE: Because TaskMaster can call any of the window update routines, it's very possible that*	any visible icons in a window which needs to get redrawn will be left UNLOCKED.  So, it's*	extremely important that we relock the icon which we were working with before returning.*****************************************************************CheckKey	PROC@loop		pha				; space for result		pea	$056E			; event mask		pushlong #fTaskRecord		_TaskMaster		pla		beq	@done		cmp	#3		beq	@keyEvent		cmp	#5		bne	@notKey		@keyEvent	lda	fTaskMessage		cmp	#$002e		bne	@loop		lda	fTaskModifiers		and	#$0100		beq	@loop			lda	#$1b			;fake an ESC message		sta	fTaskMessage				pha		lda #0		pha		;targetOnly = false		pha		pha		;window = nil		pushlong #fTaskRecord		_SendEventToCtl		pla		bne	@gotOAPeriod		bra	@loop@notKey		cmp	#6			;wInUpdate		beq	@done		cmp	#$21			;wInControl		bne	@loop@gotOAPeriod	lda	fTaskRecord+$26		;wmTaskData4		cmp	#4		bne	@loop		lda	fTaskRecord+$26+2		bne	@loop		jsr	LockIcon				lda	#$FFFF		sta	AbortFlag		asl	a			;button	ID returned in A		rts@done		jsr	LockIcon		lda	#0			;indicate no key pressed		clc		rts		EXPORT fTaskRecordfTaskRecord	dc.w	0			;whatfTaskMessage	dc.L	0			;message		dc.L	0			;when		dc.L	0			;wherefTaskModifiers	dc.w	0			;modifiers		dc.L	0			;taskData		dc.L	$00038006		;taskMask		dc.L	0			;lastClickTick		dc.w	0			;clickCount		dc.L	0			;taskData2		dc.L	0			;taskData3		dc.L	0			;taskData4		dc.L	0			;lastClickPoint		ENDP****************************************************************** CreateFile*****************************************************************CreateFile	PROC		lda	#5			;changed from 4  - 08/06/88 DJB		sta	[<BufPtr]		;set pcount		lda	<BufPtr			;BufPtr	points to CREATE parameter block		ldx	<BufPtr+2		ldy	#CREATE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		pha		jsl	ProDOS			;start_session		DC.W	BEGIN_SESSION+C1		DC.L	session_call		pla		jsr	RestartSession		cmp	#$54		bne 	handErragain		lda	<BufPtr			;BufPtr	points to CREATE parameter block		ldx	<BufPtr+2		ldy	#CREATE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OKhandErr		jsr	ProDosErr		;handle	error		bcc	again			;try againOK		rts		ENDP****************************************************************** DestroyFile*****************************************************************DestroyFile	PROC		lda	<PathNamePtr		;get ptr to PathName		sta	D_Name		lda	<PathNamePtr+2		sta	D_Name+2		lda	#D_Params		;get ptr to DESTROY parameter block		ldx	#D_Params>>16		ldy	#DESTROY+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK; Mensch 5/18/89 (Fixing BRC #48301);  The following code enables this routine to return the error code to the caller		tax				; save the error code		lda	3,s			; get the caller flag		bpl	@Report		txa				; error back into acc		cmp	#$50			; busy?		bne	@ReportIt		bra	OK@Report		txa@ReportIt; end Mensch 5/18/89 (BRC #48301)		jsr	ProDosErr		;handle	error		bcc	DestroyFile		;try again; Mensch 5/18/89 (Fixing BRC #48301)		lda	#$FFFEOK		ply				; return address		plx				; remove flag param		phy				; return address back on stack; end Mensch 5/18/89 (BRC #48301)		rts		ENDP****************************************************************** OpenFile		(Modified to work with extended files - DJB)*****************************************************************OpenFile	PROC		sta	O_ReqAccess		ldx	#14		and	#$02			; write access ?		beq	set			; no		ldx	#3			; yes, so use min pcountset		stx	O_Params		; set the pcount		lda	#O_Params		;get ptr to OPEN parameter block		ldx	#O_Params>>16		ldy	#OPEN+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	RestartSession		;force a cache flush to get some memory		cmp	#$54			;out-of-memory error ?		bne	handErragain		lda	#O_Params		;ptr to OPEN parameter block		ldx	#O_Params>>16		ldy	#OPEN+C1		;call #		jsr	ProDosCall		;make the call		bcc	OKhandErr		jsr	ProDosErr		;handle	error		bcc	again			;try again		;; Now, save the data and resource fork lengths someplace which won't change, and only save them;OK		lda	<SoFarFlag		bne	@done				dec	<SoFarFlag				lda	O_DataEOF		sta	<DataForkYet		lda	O_DataEOF+2		sta	<DataForkYet+2		lda	O_RsrcEOF		sta	<RsrcForkYet		lda	O_RsrcEOF+2		sta	<RsrcForkYet+2@done		rts		ENTRY	OpenResourceOpenResource		sta	OE_ReqAccess		clc		lda	<IsExtended		;an extended file ?		beq	exit			;noagain2		lda	#OE_Params		;ptr to extended OPEN parameter block		ldx	#OE_Params>>16		ldy	#OPEN+C1		;call #		jsr	ProDosCall		;make the call		bcc	exit		jsr	ProDosErr		;handle	error		bcc	again2			;try againexit		rts		ENDP****************************************************************** CloseFile		(Modified to work with extended files - DJB)*****************************************************************CloseFile	PROC		lda	O_Ref		sta	C_Ref		lda	#C_Params		;ptr to CLOSE parameter block		ldx	#C_Params>>16		ldy	#CLOSE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	CloseFile		;try againOK		stz	O_Ref		lda	<IsExtended		;an extended file ?		beq	exit			;nocloseResource	lda	OE_Ref		sta	C_Ref		lda	#C_Params		;ptr to CLOSE parameter block		ldx	#C_Params>>16		ldy	#CLOSE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK2		jsr	ProDosErr		;handle	error		bcc	closeResource		;try againOK2		stz	OE_Refexit		rts		ENDP****************************************************************** ReadDataFile		(modified for extended files - DJB)*****************************************************************ReadDataFile	PROC		lda	O_Ref		sta	RW_Ref		lda	#RW_Params		;ptr to extend READ/WRITE param block		ldx	#RW_Params>>16		ldy	#READ+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	ReadDataFile		;try againOK		rts		ENTRY	ReadRsrcFileReadRsrcFile		lda	OE_Ref		sta	RWE_Ref		lda	#RWE_Params		;ptr to extend READ/WRITE param block		ldx	#RWE_Params>>16		ldy	#READ+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK2		jsr	ProDosErr		;handle	error		bcc	ReadRsrcFile		;try againOK2		rts		ENDP****************************************************************** WriteDataFile		(modified for extended files - DJB)*****************************************************************WriteDataFile	PROC		lda	O_Ref		sta	RW_ref		lda	#RW_Params		;get ptr to READ/WRITE param block		ldx	#RW_Params>>16		ldy	#WRITE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK				cmp	#$54			;out of memory error		bne 	handErr		jsr	RestartSession		;flush cache to get more memoryagain		lda	#RW_Params		;get ptr to READ/WRITE param block		ldx	#RW_Params>>16		ldy	#WRITE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OKhandErr		jsr	ProDosErr		;handle	error		bcc	again			;try againOK		rts		ENTRY	WriteRsrcFileWriteRsrcFile		lda	OE_Ref		sta	RWE_ref		lda	#RWE_Params		;get ptr to READ/WRITE param block		ldx	#RWE_Params>>16		ldy	#WRITE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK2		cmp	#$54			;out of memory error		bne 	handErr2		jsr	RestartSession		;flush cache to get more memoryagain2		lda	#RWE_Params		;get ptr to READ/WRITE param block		ldx	#RWE_Params>>16		ldy	#WRITE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK2handErr2	jsr	ProDosErr		;handle	error		bcc	again2			;try againOK2		rts		ENDP****************************************************************** GetFileInfo*****************************************************************GetFileInfo	PROC		IMPORT	GetFSTFileSize		IMPORT	doAlertWindow		IMPORT	fstNames		IMPORT	CustomPtr		IMPORT	CustomPtr2		lda	<BufPtr			;BufPtr	points to GET_FILE_INFO		ldx	<BufPtr+2		;parameter block		ldy	#GET_FILE_INFO+C1	;call #		jsr	ProDosCall		;make the call		bcc	@GetInfoOK		jsr	ProDosErr		;handle	error		bcc	GetFileInfo		;try again		rts@GetInfoOK	ldy	#FI_SType-FI_Params	;AEN, 2/19/92		lda	[<bufPtr],y		beq	@goOK		cmp	#6		blt	@gotFile@goOK		brl	@ok@gotFile		lda	<DstFileSysID		jsl	GetFSTFileSize		bcs	@ok			;if we can't find the FST, forgo the size check		stx	<MaxFileSize		sta	<MaxFileSize+2				ldy	#FI_EOF-FI_Params		lda	[<bufPtr],y		sta	<OurFileSize		ldy	#FI_EOF-FI_Params+2		lda	[<bufPtr],y		sta	<OurFileSize+2				ldy	#FI_SType-FI_Params	;AEN, 2/19/92		lda	[<bufPtr],y		cmp	#5		bne	@notExtended				lda	<OurFileSize		clc		ldy	#FI_ResourceEOF-FI_Params		adc	[<bufPtr],y		sta	<OurFileSize				lda	<OurFileSize+2		ldy	#FI_ResourceEOF-FI_Params+2		adc	[<bufPtr],y		sta	<OurFileSize+2@notExtended		lda	<OurFileSize		cmp	<MaxFileSize		;does SEC SBC		lda	<OurFileSize+2		sbc	<MaxFileSize+2		blt	@ok				lda	<DstFileSysID		;*6 -- create fst name string		asl	a		asl	a		tax		lda	>fstNames,x		sta	>CustomPtr2		lda	>fstNames+2,x		sta	>CustomPtr2+2				lda	<CatPtr			;*5 -- create source name string		clc		adc	#4		sta	>CustomPtr		lda	<CatPtr+2		adc	#0		sta	>CustomPtr+2				lda	#rasFileTooBig		jsl	doAlertWindow		eor	#$FFFF		cmp	#$FFFF		rts		@ok		ldy	#FI_OptionList-FI_Params+4 ;skip past totalSize and reqSize		lda	[<bufPtr],y		sta	<SrcFileSysID		cmp	#HFS_FST		;6		beq	zeroCoordinates		cmp	#PRODOS_FST		;prodos CAN have the same as HFS		beq	zeroCoordinates		cmp	#APPLESHARE_FST		;$0D		bne	donezeroCoordinates		ldy	#FI_OptionList-FI_Params+14		lda	#0		sta	[<bufPtr],y		iny		iny		sta	[<bufPtr],ydone		lda	#0		tax		clc		rts		ENDP****************************************************************** GetVolSize - x & a point to volume name (class 1)*****************************************************************GetVolSizes	PROC				;added 07/13/88 DJB		sta	GDN_Name		stx	GDN_Name+2		jsr	GetDevNum		;first get device number		bcs	exit		lda	GDN_DevNum		sta	DI_DevNum		jsr	GetDevInfo		;then get device name		bcs	exit		jsr	GetVolInfo		;then get the sizesexit		rts		ENDP****************************************************************** RebuildVCRLong -- rebuild the VCR for the device number in (A)*****************************************************************RebuildVCRLong	PROC	EXPORT		phb		phk		plb				jsr	RebuildVCR				plb		rtl		ENDP****************************************************************** RebuildVCR -- rebuild the VCR for the device number in (A)** NOTE: Doing a volume call to a damaged HFS disk will return the correct*	volume name for that disk and error $5A.  This is and has to be*	guaranteed behavior for only the HFS FST.  -- 11/7/91, andy*****************************************************************RebuildVCR	PROC		sta	DI_DevNum				lda	#DI_Params		;get ptr to D_INFO parameter block		ldx	#DI_Params>>16		ldy	#D_INFO+C1		;call #		jsr	ProDosCall		;make the call		bcs	@done		lda	#V_Params		;get ptr to VOLUME parameter block		ldx	#V_Params>>16		ldy	#VOLUME+C1		;call #		jsr	ProDosCall		;make the call@done		rts		ENDP****************************************************************** GetFileInfo2*****************************************************************GetFileInfo2	PROC		lda	#FI_Params		;get ptr to FILE_INFO param block		ldx	#FI_Params>>16		ldy	#GET_FILE_INFO+C1	;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	GetFileInfo2		;try againOK		rts		ENDP****************************************************************** GetFileInfo3*****************************************************************GetFileInfo3	PROC			 	;only called by DupFiles		lda	#FI_Params		;get ptr to FILE_INFO param block		ldx	#FI_Params>>16		ldy	#GET_FILE_INFO+C1	;call #		jsr	ProDosCall		;make the call		bcc	FileExists		cmp	#$46			;file not found	error?		beq	NotFound		;yes - so ignore the error		cmp	#$40			;bad syntax error ?		beq	BadName			;yes - so report the error		jsr	ProDosErr		;no - so handle	error		bcc	GetFileInfo3		;try again		rtsBadName		lda	#$8001		asl	a			;indicate bad name		rtsFileExists	lda	#$8000		asl	a			;indicate that file exists		rtsNotFound	clc				;indicate no error		rts		ENDP****************************************************************** SetFileInfo*****************************************************************SetFileInfo	PROC		lda	#FI_Params		;get ptr to FILE_INFO param block		ldx	#FI_Params>>16		ldy	#SET_FILE_INFO+C1	;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	RestartSession		cmp	#$4E		clc		beq	OK			; so drop boxes work - DJB		cmp	#$54		bne 	handErragain		lda	#FI_Params		;get ptr to FILE_INFO param block		ldx	#FI_Params>>16		ldy	#SET_FILE_INFO+C1	;call #		jsr	ProDosCall		;make the call		bcc	OKhandErr; Mensch 5/18/89 (Fixing BRC #48301);  The following code enables this routine to return the error code to the caller		tax				; save the error code		lda	3,s			; get the caller flag		bpl	@Reportit		txa				; error back into acc		cmp	#$50			; busy?		bne	@ReportIt		bra	OK@ReportIt; end Mensch 5/18/89 (BRC #48301)		txa				;AEN 12/20/91		jsr	ProDosErr		;handle	error		bcc	again			;try againOK; Mensch 5/18/89 (Fixing BRC #48301)		ply				; return address		plx				; remove flag param		phy				; return address back on stack; end Mensch 5/18/89 (BRC #48301)		rts		ENDP****************************************************************** GetMark		(modified for extended files - DJB)*****************************************************************GetMark		PROC		cmp	#0			;A: 0 = data fork, 1 = resource fork		bne	doExtend		lda	O_Ref			;refnum for data fork		bra	setdoExtend	lda	OE_Ref			;refnum for resource forkset		sta	GM_Refagain		lda	#GM_Params		;get ptr to GET_MARK parameter block		ldx	#GM_Params>>16		ldy	#GET_MARK+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	again			;try againOK		rts		ENDP****************************************************************** SetMark		(Modified to work with extended files - DJB)*****************************************************************SetMark		PROC		cmp	#0			;A: 0 = data fork, 1 = resource fork		bne	doExtend		lda	O_Ref			;refnum for data fork		bra	setdoExtend	lda	OE_Ref			;refnum for resource forkset		sta	SM_Ref		lda	#SM_Params		;get ptr to SET_MARK parameter block		ldx	#SM_Params>>16		ldy	#SET_MARK+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	RestartSession		cmp	#$4E		clc				; added so drop boxes work - DJB		beq	OK		cmp	#$54		bne 	handErragain		lda	#SM_Params		;get ptr to SET_MARK parameter block		ldx	#SM_Params>>16		ldy	#SET_MARK+C1		;call #		jsr	ProDosCall		;make the call		bcc	OKhandErr		jsr	ProDosErr		;handle	error		bcc	again			;try againOK		rts		ENDP****************************************************************** ChangePath*****************************************************************ChangePath	PROC		lda	#CP_Params		;get ptr to CHANGE_PATH	param block		ldx	#CP_Params>>16		ldy	#CHANGE_PATH+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		tax				;save error #		cmp	#$40			;illegal pathname err?		bne	PutMsg		ldx	#$8001			;yes - so convert to our own error #PutMsg		lda	#C1_SrcPathName		sta	<PathNamePtr		;set up	ptr to SrcPathName for dialog		lda	#^C1_SrcPathName		sta	<PathNamePtr+2		txa				;retrieve error	#		jsr	ProDosErr		;handle	error		bcc	ChangePath		;try againOK		rts		ENDP****************************************************************** ReadBlocks*****************************************************************ReadBlocks	PROC		lda	#RWB_Params		;get ptr to READ/WRITE BLOCK		ldx	#RWB_Params>>16		;parameter block		ldy	#D_READ+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	ReadBlocks		;try againOK		rts		ENDP****************************************************************** WriteBlocks*****************************************************************WriteBlocks	PROC		lda	#RWB_Params		;get ptr to READ/WRITE BLOCK		ldx	#RWB_Params>>16		;parameter block		ldy	#D_WRITE+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	WriteBlocks		;try againOK		rts		ENDP****************************************************************** GetDevNum*****************************************************************GetDevNum	PROC		lda	#GDN_Params		;get ptr to GET_DEV_NUM	param block		ldx	#GDN_Params>>16		ldy	#GET_DEV_NUMBER+C1	;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	GetDevNum		;try againOK		rts		ENDP****************************************************************** GetDevInfo*****************************************************************GetDevInfo	PROC		lda	#DI_Params		;get ptr to D_INFO parameter block		ldx	#DI_Params>>16		ldy	#D_INFO+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	GetDevInfo		;try againOK		rts		ENDP****************************************************************** GetVolInfo*****************************************************************GetVolInfo	PROC		lda	#V_Params		;get ptr to VOLUME parameter block		ldx	#V_Params>>16		ldy	#VOLUME+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	GetVolInfo		;try againOK		rts		ENDP****************************************************************** EraseDisk*****************************************************************EraseDisk	PROC		lda	#E_Params		;get ptr to ERASE parameter block		ldx	#E_Params>>16		ldy	#ERASE_DISK+C1		;call #		jsr	ProDosCall		;make the call		bcc	OK		jsr	ProDosErr		;handle	error		bcc	EraseDisk		;try againOK		rts		ENDP****************************************************************** ProDosCall*****************************************************************ProDosCall	PROC;NOTE -	this is	self-modifying code!		sta	>CallBlock+2		;store ptr to param block in call block		txa		sta	>CallBlock+4		tya		sta	>CallBlock		;store call number in  call blockDoCall		jsl	ProDOS			;ProDOS/16 entry vectorCallBlock					;ProDOS call block		DC.W	0			;call number		DC.L	0			;ptr to	parameter block		rts		ENDP****************************************************************** ProDosErr -- error in (A)*****************************************************************LongProDOSErr	PROC		phb		phk		plb				jsr	ProDOSErr				plb		rtl		ENDP		****************************************************************** ProDosErr*****************************************************************ProDosErr	PROCNAME		IMPORT	doAlertWindow		IMPORT	finderTaskRecord		IMPORT	hexadecimal		IMPORT	C1_source		IMPORT	pathgetroot		IMPORT	c1_filename		IMPORT	c1_srcpathname				IMPORT	pathgetname		IMPORT	WindowGlobalON		IMPORT	WindowGlobalOFF		IMPORT	PStringCopy		import	CustomPtr3		import	GetErrorTextPtrNewCatHndl	equ	localTemp;		;   Determine if the error is one we have a special dialog for.;   If not, put up the System Error dialog.;		sta	<Error		ldx	#errorsEnd-errors@loop		cmp	errors,x		beq	dispatch		dex		dex		bpl	@loop		pha				;save copy of error code (5-Dec-91 DAL)		pha		pushlong #hexadecimal		pea	4			;4 chars		_Int2Hex*** added 5-Dec-91 DAL		pla		jsl GetErrorTextPtr		;returns pointer in AX		sta >CustomPtr3+2		txa		sta >CustomPtr3*** end 5-Dec-91		lda	#rasSysErr		;dialog	# for System Error dialog		brl	Contdispatch	lda	values,x		jmp	(addrs,x)		errors		dc.w	$0047		dc.w	$8001		dc.w	$8002			;not enough privileges to copy this, skip it?		dc.w	$0027		dc.w	$002b		dc.w	$002f		dc.w	$0045		dc.w	$0048		dc.w	$0049		dc.w	$004e		dc.w	$0050		dc.w	$005A		dc.w	FICantMoveerrorsEnd	dc.w	FINoPrivsaddrs		dc.w	DupFile		dc.w	ChPath		dc.w	NoReadAccess		dc.w	MoveRoot		dc.w	MoveRoot		dc.w	MoveRoot		dc.w	MoveRoot		dc.w	Cont		dc.w	Cont		dc.w	Cont		dc.w	Cont		dc.w	MoveRoot		dc.w	Cont		dc.w	Cont		values		dc.w	0		dc.w	rasChangePath		dc.w	rasNoRead		dc.w	rasIOErr		dc.w	rasWriteProtected8		dc.w	rasNoMedia		dc.w	rasInsertDiskOrCancel8		dc.w	rasDiskFull		dc.w	rasDirFull		dc.w	rasNoAccess		dc.w	rasFileBusy		dc.w	rasIOErr		dc.w	rasCantMove		dc.w	rasNoPrivsChPath		pha		pushlong #C1_Filename		;put the end of pathnameptr onto c1_filename		pushLong #C1_SrcPathName		jsl	PathGetName		pla		jsr	Cont		sec				;carry set in either case of skip or cancel		rtsNoReadAccess	pha		pushZLong <fileNamePtr		pushlong #c1_source+2		jsl	PStringCopy		bra	Cont2			;(A) is already on stackMoveRoot	pha		jsr	MoveRootName		bra	Cont2			;(A) is already on stack		Cont		phaCont2		stz	session_stat		jsl	ProDOS			;get session status		DC.W	SESSION_STATUS+C1		DC.L	session_list		jsl	ProDOS			;stop_session just in case user ejects		DC.W	END_SESSION+C1		DC.L	session_call		pla		jsl	doAlertWindow		pha		lda	session_stat		beq	notSet		jsl	ProDOS			;restart session		DC.W	BEGIN_SESSION+C1		DC.L	session_call		stz	session_statnotSet		pla				;the button				eor	#$FFFF		cmp	#$FFFF		bcc	button1		tax		rts		button1		lda	#1		tax		clcRet		rts				;carry set if user selected 'Cancel'						;'No' or 'Skip File'		;; move the root name in pathnamePtr to c1_source;MoveRootName	pushLong #c1_source		pushZLong <PathNamePtr		jsl	PathGetRoot		lda	>c1_source		and	#$00ff		dec	a		xba		sta	>c1_source+1		rts												;-------------------------------------------------------------------------------;A 'duplicate file name' error occurred	as a result of a CREATE	or CHANGEPATH;ProDOS	call made during a file	copy or	move.		EXPORT	DupFileDupFile		lda	<CatPtr		ora	<CatPtr+2		;is CatPtr valid?		beq	ChPathDupFile		;no - so err occurred during ChangePath		jsr	CommonCode		;get catalog, put up dialog, etc.		bcs	Ret			;don't replace duplicate file		lda	[<CatPtr]		;get type of file being	copied		sta	<Error			;and save		ldy	#2		lda	[<CatPtr],y		;get flag word for first cat entry		ora	#ICDUP			;set bit in catalog to indicate		sta	[<CatPtr],y		;this file got dup error		brl	DelDupFile		;delete	the duplicate file;-------------------------------------------------------------------------------ChPathDupFile					;dup file err occured during ChangePath		IMPORT	ToUpperCase		IMPORT	doAlertWindow		IMPORT	doAlertCopy		IMPORT	C1_FileName		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	arrowCursor		IMPORT	CopyUpdate		IMPORT	DrawCopyControls		IMPORT	WStrCompare		IMPORT	CloseCopyWindow		;in util.aii - 27-Jan-93 JCM		IMPORT	CloseRepWindow		;in util.aii - 27-Jan-93 JCM		lda	#c1_dstpathname		;set up	ptr to correct pathname	for		sta	FI_Name			;GetFileInfo and SetFileInfo		lda	#c1_dstpathname>>16		sta	FI_Name+2		lda	#FI_Params		;get ptr to FILE_INFO param block		ldx	#FI_Params>>16		ldy	#GET_FILE_INFO+C1	;call #		jsr	ProDosCall		;make the call		bcs	@goDelete				lda	FI_fType		cmp	#TypeFolder		beq	@isFolder@goDelete	brl	OkToDel2		;; first, see if the destination file is is a child of the parent folder, in which case; we need to show them the rasChangePath dialog;@isFolder	lda	C1_DstPathname		cmp	C1_SrcPathname		blt	@notIntoItself				lda	C1_DstPathname		pha		lda	C1_SrcPathname		sta	C1_DstPathname		pha		pushlong #c1_DstPathname		pushlong #c1_SrcPathname		jsl	WStrCompare		ply		plx		stx	c1_DstPathname		tya		beq	@notIntoItself				lda	#rasChangePath		brl	ChPath		;; make sure the duplicate file is not an ancestor of the file we are moving;@notIntoItself		ldx	C1_DstPathName		;get length of dst pathname		inx		lda	C1_SrcPathName+1,x		and	#$00FF		cmp	#SEPARATOR		;GS/OS separator character		bne	OKtoDel2		dexCheckLoop	lda	C1_DstPathName+1,x	;if DstPathName	matches	first part of		and	#$00FF			;SrcPathName then error		jsl	ToUpperCase		pha				; save theChar		lda	C1_SrcPathName+1,x		and	#$00FF		jsl	ToUpperCase		cmp	1,s		bne	OKtoDel		pla				; remove theChar		dex		bne	CheckLoop		pushlong #C1_Filename		;put the end of pathnameptr onto c1_filename		pushLong #C1_SrcPathName		jsl	PathGetName		lda	#rasParents		jsl	doAlertWindow		beq	@cancel		lda	#$8001		brl	CommonDone@cancel		lda	#$FFFF		brl	CommonDone;No problem - so ask user if duplicate file should be deleted. If so, delete it.OKtoDel		pla				; remove theCharOKtoDel2	lda	#C1_DstPathName		sta	<PathNamePtr		;set up	ptr to dest pathname		jsr	CommonCode		;get catalog, put up dialog, etc.		bcc	@ok		rts				;don't replace duplicate file@ok		ldy	#icFType		lda	[<IconPtr],y		;get type of file being	copied		cmp	#TypeFolder		;folder?		beq	SaveType		;yes		lda	#0			;no - so it's a regular fileSaveType	sta	<Error			;save the type		ldy	#icFlag		lda	[<IconPtr],y		;get Flag word from IconObj record		ora	#ICDUP			;set bit in icon to indicate that		sta	[<IconPtr],y		;this icon got a dup file error		brl	DelDupFile		;delete	the duplicate file;-------------------------------------------------------------------------------CommonCode		lda	<DelAllDups		;OK to replace the duplicate file?		bpl	@replace		brl	CommonDone		;no - don't replace any duplicate files@replace		pha				;space for fst result		pha		pha		pha				;space for handle result		pha		pha				;space for integer result		pha				;space for integer result		pushlong #0		PushZLong <PathNamePtr		;ptr to	pathname		pea	0			;don't save filecount in first cat entry		ldx	#xCatalog		;get catalog for duplicate file		jsl	MiscEntry		pla				;pull fst		pla		pla				;pull size info		plx				;# of locked files		pla				;num files in cat		pla				;get cat handle		sta	<NewCatHndl		;and save for later		pla		sta	<NewCatHndl+2		bcc	NoCatErr; JAM 5/17/89 (Fixing BRC #48728); If we got back an "access not allowed" error ($4E) here, then a file we are;   copying or moving conflicted with a duplicate that resides within a drop folder.; Change the error number to FICantMove and loop back around.		cmp	#$4E		sec				; restore the carry we may have clobbered		beq	@RegError		lda	#FICantMove		brl	ProDosErr@RegError; end JAM 5/17/89 (BRC #48728)		lda	#$FFFF			;got error in Catalog routine so cancel		brl	CommonDoneNoCatErr		txa				;any locked files in cat?		beq	NotLocked		;no		pushlong #C1_Filename		;put the end of pathnameptr onto c1_filename		pushZLong <PathNamePtr		jsl	PathGetName		lda	#rasLocked1		jsl	doAlertWindow				cmp	#2		beq	@goDisposeCat		;'OK' selected		cmp	#1		beq	@no		lda	#$FFFF			;return	if 'No'	or 'Cancel' selected		brl	DisposeCat@no		lda	#$8001		brl	DisposeCat		@goDisposeCat	jsr	DrawCopyControls	;put the controls back the way we last saw		lda	<NumFiles		ldy	#0		jsr	DrawMsg		lda	#1		brl	CommonDoneNotLocked	lda	<DelAllDups		;OK to replace all duplicate files?		beq	@askAboutReplace		brl	CommonDone		;yes - so skip next dialog@askAboutReplace		pushlong #C1_Filename		;put the end of pathnameptr onto c1_filename		pushZLong <PathNamePtr		jsl	PathGetName		lda	<NumFiles		cmp	#2		bge	@manyFiles		lda	#rasRepFile		jsl	doAlertWindow		beq	@singleCancel		jsr	DrawCopyControls	;put the controls back the way we last saw		lda	<NumFiles		ldy	#0		jsr	DrawMsg		lda	#2			;replace all		brl	cantOpenWindow@singleCancel	lda	copyWindowPtr+1		beq	@noSingleCancel		jsl	CloseCopyWindow		stz	copyWindowPtr+1@noSingleCancel	lda	#$FFFF			;single file canceled		brl	cantOpenWindow;; if we have a whole lot of files to replace, do it with this huge dialog that no one; really likes;@manyFiles	lda	>c1_filename		xba		sta	>c1_filename		jsl	SaveCursor		jsl	ArrowCursor		jsl	WindowGlobalON		pha		pha		lda #0		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pha		pha				;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pha		pea	5			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2				jsl	WindowGlobalOFF		pulllong repWindowPtr		bcc	@beepAtThem;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	repWindowPtr+1		beq	@leave@done		jsl	CloseRepWindow@leave		jsl	RestoreCursor		lda	#$FFFF		brl	cantOpenWindow;; now that we've set all the controls values, use doModalWindow to play with everything;@beepAtThem	pea	$c054		_SysBeep2@loop		pha		pha		pea	0		lda	>finderTaskRecord		pha			;push the task record's ptr		lda #0		pha		pha			;update proc		pea $8000		pha			;eventHook		pha		pha			;beep proc		pea	$c010		;flags		_DoModalWindow		pla		plx		cmp	#7		blt	@loop		sec		sbc	#7		asl 	a		pha		bne	@notCancel		lda	copyWindowPtr+1		beq	@notCancel		jsl	CloseCopyWindow		stz	copyWindowPtr+1@notCancel		jsl	restoreCursor		jsl	CloseRepWindow		lda	1,s		beq	@noUpdate		lda	copyWindowPtr+1		beq	@noUpdate		jsr	DrawCopyControls	;put the controls back the way we last saw		lda	<NumFiles		ldy	#0		jsr	DrawMsg@noUpdate	plx		lda	buttonVals,xcantOpenWindow	tax				;save button ID		ror	a			;was one of the	'All' buttons selected?		bcs	NotAll			;no		stx	<DelAllDups		;yes - so save button ID for futureNotAll						;		txa				;retrieve button ID		bpl	CommonDone		;OK to replace duplicate fileDisposeCat	sta	<Error			;not OK	to replace duplicate file		PushZLong <NewCatHndl		jsl DisposeHandleGlue		;dispose of catalog		lda	<Error			;get back button IDCommonDone	asl	a			;set carry bit according to button ID		rts;; locals;		EXPORT	repWindowPtrrepWindowPtr	dc.L	0			;our window's ptrbuttonVals	dc.w	$FFFF			;cancel		,id = 7		dc.w	$8001			;skip		,id = 8		dc.w	$0001			;replace	,id = 9		dc.w	$8002			;skip all	,id = A		dc.w	$0002			;replace all	,id = B;-------------------------------------------------------------------------------DelDupFile					;delete the duplicate	file		PushZLong <CatHndl		;save current CatHndl		PushZLong <CatPtr		;save current CatPtr		PushZWord <CatIndex		;save current CatIndex		lda	[<PathNamePtr]		;get length of pathname		pha				;and save		PushZLong <NewCatHndl		;put CatHndl of	dup file on stack		lda	#$FFFF		sta	<DeleteFlag		;indicate that we are deleteing	files		lda	#1		sta	<CatIndex		;used by GetNextCat		jsr	GetNextCat		;get ptr to first entry	in catalog		lda	[<CatPtr]		;is the	duplicate file a subdirectory?		bne	Folder			;yes		lda	<Error			;no - so check type of file being copied		beq	TypeMatch		;it's not a subdir either so OK		bra	TypeErr			;it is a subdir	so type	mismatchFolder		lda	<Error			;check type of file being copied		bne	TypeMatch		;it's a subdir also so OKTypeErr		lda	#rasType		jsl	doAlertWindow		pha				lda	copyWindowPtr+1		beq	@noUpdate		jsr	DrawCopyControls	;put the controls back the way we last saw		lda	<NumFiles		ldy	#0		jsr	DrawMsg@noUpdate			pla		cmp	#2		beq	typeMatch		cmp	#1		beq	@no		lda	#$FFFF		bra	DelQuit			;'No' or 'Cancel' selected@no		lda	#$8001		bra	DelQuitTypeMatchDelLoop		lda	[<CatPtr]		;is this cat entry for a subdirectory?		bne	DelNext			;yes - so can't delete it until empty		ldy	#2			;check flag word of cat	entry		lda	[<CatPtr],y		;is this file locked?		beq	DelFile			;no - so delete	it		ldx	#SFISize-2PushLoop	lda	FI_Params,x		;save current contents of FI_Params		pha				;since needed later by DoFileCopy		dex		dex		bpl	PushLoop		lda	<PathNamePtr		;set up	ptr to correct pathname	for		sta	FI_Name			;GetFileInfo and SetFileInfo		lda	<PathNamePtr+2		sta	FI_Name+2		jsr	GetFileInfo2		;get file info for dup file		bcs	DelErr			;got error		lda	#$C3		sta	FI_Access		;clear out access bits so file can		pea	#0			; JAM 5/19/89 (Fixing BRC #48301)		jsr	SetFileInfo		;be deleted		ror	a			;save carry flag result		tay				;until after restore FI_Params		ldx	#0PullLoop	pla		sta	FI_Params,x		;restore previous contents of FI_Params		inx		inx		cpx	#SFISize		bcc	PullLoop		tya				;restore carry flag result from		rol	a			;SetFileInfo call		bcs	DelErr			;got error during SetFileInfo callDelFile		pea	#0			; JAM 5/19/89 (BRC #48301)		jsr	DestroyFile		;delete	the file		bcs	DelErr			;got errorDelNext		jsr	GetNextFile		;get next catalog entry		bcs	DelDone			;done with catalog		jsr	MakePathName		;make pathname for this	entry		bcs	DelErr			;name too long		bra	DelLoop			;loop until all	files in cat deletedDelDone		clc				;clear out error result		lda	#0			;indicate no errorDelErr		ror	a			;get carry bit back into ADelQuit		sta	<Error			;save error info		jsl DisposeHandleGlue		;dispose of catalog		stz	<DeleteFlag		;clear flag		pla		sta	[<PathNamePtr]		;restore pathname length		pla		sta	<CatIndex		;restore CatIndex		pla		sta	<CatPtr			;restore CatPtr		pla		sta	<CatPtr+2		pla		sta	<CatHndl		;restore CatHndl		pla		sta	<CatHndl+2		lda	<Error			;get error status back		asl	a			;set carry bit if error, else clear		rts		ENDP****************************************************************** DrawThermo -- (A) contains value for thermodial*	     	(X) if negative means always update*****************************************************************DrawThermo	PROC		ldy	copyWindowPtr+1		bne	@haveWindow		rts@haveWindow		txy		bmi	@always		cmp 	lastThermo		;the last time so we avoid some flicker		beq	@same@always		sta	lastThermo		;if it wasn't, make it		pha				;(A) on stack for _SetCtlValue		pha		pha		pushlong copyWindowPtr		pushlong #3		_GetCtlHandleFromID		_SetCtlValue			;set the thermo dial@same		rts;; locals;		EXPORT	lastThermolastThermo	dc.w	0		ENDP****************************************************************** DrawMsg -- (A) contains the low word for count*	     (Y) contains the high word for the count*****************************************************************DrawMsg		PROC		IMPORT	SizeToString		ldx	copyWindowPtr+1		bne	@haveWindow		rts@haveWindow	jsr	DrawNumItems		;feed (A) & (Y) to DrawNumItems		@same		pha		pushZLong <RWPtr		_StringWidth		pla		clc		adc	#19		ldx	#$54			;a MINIMUM of $54 pixels over to the right		cmp	#$54		blt	@minimum		tax@minimum	stx	nameRect+2		stx	rwRect+6		;erase this far from end of "Read/Write/Copy"		pea	15		pea	30		_MoveTo		pushZLong <RWPtr		_DrawString		pushlong #thePoint		_GetPen		lda	thePoint+2		sta	rwRect+2		cmp	#$54		bge	@noflickerRW		pushlong #rwRect		_EraseRect@noFlickerRW		lda	nameRect+2		pha		pea	30		_MoveTo		lda	[<fileNamePtr]		;mask the high bit off the length byte because if the name is		pha				;a translated name, this keeps it from displaying garbage because of the		and	#$FF7F			;high bit.		sta	[<fileNamePtr]		pushZLong <FileNamePtr		_DrawString		pla		sta	[<FileNamePtr]				pushlong #thePoint		_GetPen		lda	thePoint+2		sta	nameRect+2				pushlong #nameRect		_EraseRect				rts****************************************************************** DrawNumItems -- (A) contains the low word for count*	     	  (Y) contains the high word for the count*****************************************************************		EXPORT	drawNumItemsDrawNumItems		sta	num		sty	num+2				pushlong #numberStr		pushlong num		pea	0			;plain		pea	512			;blocksize (doesn't matter)		jsl	SizeToString		pha		pushlong #numberStr		_StringWidth		pla		lsr	a		sta	numberWidth		lda	#369			;find the left side of the number		sec		sbc	numberWidth		sta	numRectLeft+6		pushlong #numRectLeft		;erase from the left edge to the left side of the number		_EraseRect		lda	numRectLeft+6		pha		pea	13		_MoveTo		pushlong #numberStr		;draw the number		_DrawString				pushlong #thePoint		;erase from the right side of the number to the end of		_GetPen				;our old rectangle				lda	thePoint+2		sta	numRectRight+2		pushlong #numRectRight		_EraseRect		rts		;; locals;num		dc.L	0width		dc.w	0rwRect		dc.w	20,15,31,364	;second x coordinate gets blastednameRect	dc.w	20,$54,31,364	;first x coordinate gets blastednumRectLeft	dc.w	5,328,14,410numRectRight	dc.w	5,328,14,410numberStr	ds.b	10numberWidth	dc.w	0thePoint	dc.L	0		ENDP****************************************************************** oStdEnd0*****************************************************************oStdEnd0	PROC		ldy	#0			;# bytes of param to strip		jml	oEndCall		ENDP****************************************************************** StdEnd*****************************************************************StdEnd		PROC				IMPORT	RestoreCursor		jsl	RestoreCursor		plb				;restore data bank		ldy	<NumParams		;# of bytes of parameters to strip		ldx	<Error			;returning an error?		bne	RetErr			;yes		jml	EndCall			;standard end callRetErr		jml	ErrOut			;error end call		ENDP;===============================================;; RestartSession;; Preserves p and a-reg.;; If the error is $54 (memory full for OS) then; we look at the session status and if session; is on we do a stop and start sessions which; should flush some buffers.;; Calling routine can then retry and maybe it; will work the second time. (we hope.);;===============================================RestartSession	PROC		php				; save p		pha				; and a-reg		cmp	#$54			; is error 54?		bne	exit			; nope, alldone		stz	session_stat		jsl	ProDOS			;get session status		DC.W	SESSION_STATUS+C1		DC.L	session_list		lda	session_stat		beq	exitShutItDown	jsl	ProDOS			;stop_session to flush buffers		DC.W	END_SESSION+C1		DC.L	session_call		jsl	ProDOS			;restart session		DC.W	BEGIN_SESSION+C1		DC.L	session_call		; and try again...exit		pla				; restore a-reg		plp				; restore p		rts				; fini		ENDP; CopyUpdate -- just draw the controls in the copy window;.....................................................................		EXPORT	CopyUpdateCopyUpdate	PROC		phb		phk		plb		pushlong copyWindowPtr		_DrawControls		plb		rtl		ENDP; DrawCopyControls -- call CopyUpdate to do our updates for us so that;		      taskMaster doesn't ever do updates for the copy window;.....................................................................		EXPORT	DrawCopyControlsDrawCopyControls PROC		IMPORT	CopyUpdate		lda	copyWindowPtr+1		beq	@done		pushlong copyWindowPtr		_BeginUpdate		jsl	CopyUpdate		pushlong copyWindowPtr		_EndUpdate@done		rts		ENDP;; turn window fram redraw back on;.....................................................................WindowGlobalON	PROC	EXPORT					pha		pea	1		_WindowGlobal		pla		rtl;; turn window frame redraw off;		EXPORT WindowGlobalOFFWindowGlobalOFF		pha		php				pha		pea	$FFFE		_WindowGlobal		pla		plp		pla		rtl		ENDP				END