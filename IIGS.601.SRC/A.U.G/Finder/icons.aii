;======================================		TITLE	'Apple IIGS Finder      ICONS.aii';; Copyright Apple Computer, Inc. 1986-1993; All rights reserved.;; by Dan Oliver;;======================================		STRING	ASIS		BLANKS	OFF		PRINT	OFF		PRINT	NOGEN		PRINT	NOSYM		PRINT	NOPAGE		PAGESIZE $FFFF,126				INCLUDE	'e16.finder'		INCLUDE	'E16.event'		INCLUDE 'All.macros'		INCLUDE	'special.macros'		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'		INCLUDE	'DP.equ'		INCLUDE	'Data.equ'		INCLUDE	'Strings.equ'		INCLUDE	'GetInfo.equ'		PRINT	ONlockWidth	equ	16lockHeight	equ	8;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		import DisposeHandleGlue				IMPORT	DateToString		IMPORT	DateFormat		IMPORT	SizeToString				IMPORT	ScreenLocInfo		IMPORT	ScreenHandle		IMPORT	ScreenRect		IMPORT	ScreenImage		IMPORT	HandleToPointer		IMPORT	UnlockHandle				IMPORT	dinfo_list		;in drives.aii		IMPORT	dinfo_devnum		IMPORT  BigError1		IMPORT	PToWString		IMPORT	WToPString		IMPORT	INFO_TYPE		IMPORT	INFO_AUX		IMPORT	read_len		IMPORT	read_size		IMPORT	read_buff		IMPORT	newDataSize2		IMPORT	open_num		IMPORT	write_num		IMPORT	write_buff		IMPORT	write_len		IMPORT	WRITE_LIST		IMPORT	file_type				IMPORT	WalkGoto		IMPORT	officon		IMPORT	toCall			;in Util.aii		IMPORT	FileEntry		IMPORT	MiscEntry		IMPORT	NewDialog		IMPORT	addDataName		IMPORT	allocate		IMPORT	allocate2		IMPORT	arrowCursor		IMPORT	bigError1		IMPORT	buildPath		IMPORT	buildPath3		IMPORT	buildRectList		IMPORT	buildRects		IMPORT	checkRectHit		IMPORT	ckDataWrite		IMPORT	ckMemory		IMPORT	ckVolume				IMPORT	clearDisk		IMPORT	SaveOffFlag		IMPORT	clonePath		IMPORT	close_file		IMPORT	cur2windT		IMPORT	cutNfree		IMPORT	dayOfWeek		IMPORT	derefHand		IMPORT	deselectall		IMPORT	doGetFileInfo		IMPORT	doRead		IMPORT	doSetMark		IMPORT	doSetPrefix		IMPORT	doWrite		IMPORT	EmptyTrashMenu		IMPORT	endDraw			IMPORT	findLastName		IMPORT	findSelect		IMPORT	getExtName		IMPORT	getFrontWind		IMPORT	getHeadIcon		IMPORT	getIconPtr		IMPORT	getIconRect		IMPORT	getNextWind		IMPORT	getRootName		IMPORT	getWindID		IMPORT	getWindID2		IMPORT	getWindPath		IMPORT	getWoffset		IMPORT	geticNamePtr		IMPORT	geticNamePtr2		IMPORT	getwRefCon		IMPORT	getwRefCon2		IMPORT	hitIconName		IMPORT	ifDesk		IMPORT	killkids2		IMPORT	killkids3		IMPORT	lenError		IMPORT	lockic		IMPORT	makeField		IMPORT	makeIcRoot		IMPORT	markClosed		IMPORT	markOpen		IMPORT	matchIcName		IMPORT	newDataSize		IMPORT	noRename		IMPORT	offIcon2		IMPORT	onIcon		IMPORT	open_file		IMPORT	path2ticon		IMPORT	ProDOSErr		IMPORT	pullFields		IMPORT	pushicName		IMPORT	pushirect1		IMPORT	pushirect2		IMPORT	pushrect		IMPORT	pushwork		IMPORT	pushyrat		IMPORT	pushzpage		IMPORT	redrawText		IMPORT	removeClone		IMPORT	resetCTime		IMPORT	restoreTemp		IMPORT	saveTemp		IMPORT	selectWind		IMPORT	setInfo		IMPORT	setInfo2		IMPORT	setOrgnMask			IMPORT	setSmallRect		IMPORT	setic		IMPORT	seticBlk		IMPORT	settemp		IMPORT	sort		IMPORT	startDraw		IMPORT	startDraw2		IMPORT	startHash		IMPORT	toDeskPort		IMPORT	trashDisk		IMPORT	unlockBlk		IMPORT	unlockic		IMPORT	updateKs		IMPORT	walkBack		IMPORT	walkOfLife		IMPORT	walkOfLife2		IMPORT	walkOfLife3		IMPORT	walkWindow		IMPORT	walkback2		IMPORT	watchCursor		IMPORT	wind2top		IMPORT	windRefCon		IMPORT	windSpot		IMPORT	dontDraw		; 4/13/90 fix (rdl)		IMPORT	diffVolumes		; 4/13/90 fix (rdl)		IMPORT	UpdateWindow		; 4/13/90 fix (rdl);-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	ckIfWind		ENTRY	redrawList		ENTRY	freeRectRgn		ENTRY	freeTempRgn		ENTRY	drawDeskIcon		ENTRY	wind_guts		ENTRY	normalColor		ENTRY	saveAcross		ENTRY	backAcross		ENTRY	blinkOne		ENTRY	drawIcon2		ENTRY	ZoomRect2		ENTRY	offsetRgn		ENTRY	HeadIcon		ENTRY	setIconHead		ENTRY	desIsTrash		ENTRY	cutOutIcon		ENTRY	addFunctionKey		ENTRY	cutIcon		ENTRY	hitTest		ENTRY	findDisk		ENTRY	matchWindName		ENTRY	openFolder2		ENTRY	ckIfInTrash		ENTRY	openAll		ENTRY	padName		ENTRY	growZoom2		ENTRY	getBigRect		ENTRY	getBigRect2		ENTRY	getSmallRect		ENTRY	doClose2		ENTRY	killINfoWind		ENTRY	freeInfoBlk		ENTRY	ckExName		ENTRY	findOwnerIc		ENTRY	openIcon		ENTRY	growZoom		ENTRY	doClose		ENTRY	addIconObj		ENTRY	DrawDesk			ENTRY	info_guts		ENTRY	blinkIcon		ENTRY	drawIcon		ENTRY	ZoomRect		ENTRY	dragRects;		ENTRY	clip_guts			ENTRY	DrawDevLock		ENTRY	windClick;======================================;	   Add an ICONOBJ to;	   the icon list.;======================================;;   IN:	   wind	= window icon will belong to.;	   windblk = pointer to	window's info block.;	   a and x = pointer to	object's name.;	   y = 0 to attach at head of list, nonzero for tail;	   filetype = object's type.;	   auxtype = Aux type to match.;	   yrat	= icon's y position.;	   xrat	= icon's x position.;	   ExtCopy = TRUE for extended ICONOBJ.;	   devNumber = icon's device number.;	   AccessPriv = objects network access privileges Ñ added 12/6/88 DJB;	   Oh, and tIconObj is used for some other stuff;;  OUT:	   icHand = handle of unlocked ICONOBJ.;	   ic =	pointer	to ICONOBJ.;	   carry set if allocation failed;;======================================		EXPORT	addIconObjaddIconObj	PROCNAME				IMPORT	matchFileToIcon		IMPORT 	HalfRoundUp		IMPORT	AtCatalogEntry		IMPORT	OOMDump		IMPORT	doAlertWindow		IMPORT	FiFiFiSearch; --- Move the name into the ICONOBJ template ------------------------		sta	<ptr4		stx	<ptr4+2		sty	attachWhere		;attach to head or tail				lda	[<ptr4]		;get length		and	#$00FF		tay		and	#$0001			;is it even ?		beq	lop6		dey				;align to wordlop6		lda	[<ptr4],y		sta	ticonobj+icName,y		dey		dey		bpl	lop6		lda	[<windblk]		;Get handle of current head of list.		sta	<temp		ldy	#windIcons+2		lda	[<windblk],y		sta	<temp+2; --- Allocate an ICONOBJ ----------------------------------------------		lda	#ICSIZE			;Number of bytes to allocate.		ldx	ExtCopy			;Normal or extended ICONOBJ?		beq	ok1				lda	#icOwner		clc		adc	ticonObj+icOwner	;Size needed for extended ICONOBJ.		inc	a		inc	aok1		jsr	allocate		;Allocate an ICONOBJ record.		bcc     UseIT				jsl	OOMDump			;dump our stuff to try to ensure that we can display this		bcc	@noWarning		;if we couldn't delete either of our memory blocks, whoa we are						;in serious shit				lda	#rasMemErr		;message, or die trying		jsl	doAlertWindow@noWarning	sec		rts				UseIT		sta	<icHand			;Keep the handle of the new ICONOBJ.		stx	<icHand+2		;Store the ICONOBJ at the head of; --- Initialize the ICONOBJ record --------------------------------------				lda	<devNumber		sta	ticonobj+icDevNum		lda	<wind		sta	ticonobj+icMom		;Window this icon belongs to		lda	<wind+2		sta	ticonobj+icMom+2		lda	attachWhere		beq	@atHead		stz	ticonobj+icNext		;and say none follow		stz	ticonobj+icNext+2		lda	AtCatalogEntry		bne	@notFirst			lda	<icHand			;say this is first		sta	lasticonHandle		sta	[<windBlk]		ldy	#windIcons+2		lda	<icHand+2		sta	lastIconHandle+2		sta	[<windBlk],y				stz	ticonobj+icLast		;none precede this icon		stz	ticonobj+icLast+2		bra	skip1@notFirst	lda	lastIconHandle		sta	<temp		sta	ticonobj+icLast		;say that the previous icon was the		lda	lastIconHandle+2	;last icon		sta	<temp+2		sta	ticonobj+icLast+2		jsr	settemp				lda	<icHand			;now say that WE ARE the last icon		sta	lastIconHandle		;which was allocated		sta	[<temp]		ldy	#icNext+2		lda	<icHand+2		sta	lastIconHandle+2		sta	[<temp],y		bra	skip1;; It's an old style attach, so we want to attach the icon to the head of the icon; list for this window;@atHead		lda	<icHand					sta	[<windblk]				lda	<icHand+2		ldy	#windIcons+2		sta	[<windblk],y		stz	ticonobj+icLast		;none precede this icon we are adding		stz	ticonobj+icLast+2				lda	<temp			;Next icon: What was the head of the list,		sta	ticonobj+icNext		;is now the second one.		lda	<temp+1		sta	ticonobj+icNext+1		beq	skip1			;Is there a second icon?		jsr	settemp			;Yes, so dereference temp.		ldy	#icLast			;Prev icon: Set the second ICONOBJ record's		lda	<icHand			;last field to point to the new		sta	[<temp],y		;head of the list.		iny		lda	<icHand+1		sta	[<temp],yskip1		lda	<filetype		sta	ticonobj+icFType		cmp	#TypeFolder		;added 12/06/88 DJB		bne	skip2; JAM 5/21/89 - make sure folder icon tab shows user as owner of new guy; Check if we are going to the network, in which case we will need; to modify AccessPriv and generate the folder auxtype.		jsr	SeeIfDestWIsNetwork	; #ICNETWORK>>16 of dest is in Acc		beq	Skip2			; JAM 5/22/89 - if not network, don't monkey auxtype		tsb	ticonobj+icFlag+2	; @AuxSetup: we are going to the net		tsb	AccessPriv		; so adjust privs, etc.; end JAM 5/21/89		jsr	MakeFolderAux		;fake an auxtype for network folders		skip2		lda	auxtype			;added 05/29/88 DJB		sta	ticonobj+icFileInfo		lda	AccessPriv		;added 12/06/88 DJB		and	#ICNETACCESS>>16		tsb	ticonobj+icFlag+2; JAM 5/21/89 (Fixing BRC #46174)  -- this may now be redundant with above		lda	ticonobj+icFType	; don't set network for disk icons		cmp	#TypeLastOne		; first number in disk range		bcs	@DoneAdjusting		; bra if a device or trash				jsr	SeeIfDestWIsNetwork	; #ICNETWORK>>16 of dest is in Acc		tsb	ticonobj+icFlag+2@DoneAdjusting; end JAM 5/21/89 (BRC #46174)		ldy	<zero		ldx	auxtype		lda	<filetype		jsl	FiFiFiSearch		sta	ticonobj+icKind		stx	ticonobj+icKind+2		lda	<yrat		sta	ticonobj+icy		lda	<xrat		sta	ticonobj+icx		tsc		sec		sbc	#20			;put 5 longs on the stack		tcs		pea	$8000			;don't care about voting, match all		pea	1			;match the first one		pei	<filetype		pei <zero		lda	auxtype		pha		pushlong #ticonobj+icName		pushlong #ticonobj+icCDate		pushlong #ticonobj+icMDate		lda	ticonobj+icLocalAccess		pha		lda	ticonobj+icForked		pha		pushlong #ticonobj+icOptionList		pushlong ticonobj+icFBytes		jsl	matchFileToIcon		pulllong ticonobj+icOneDocOffset		pulllong ticonobj+icRBundle		pulllong ticonobj+icSmallIcon		pulllong ticonobj+icIcon		pla		pla				;rFinderPath goes into hyperspace...;; find out if the NumResults field of this particular OneDoc includes a kind string;		pushZLong <handle		pushZLong <ptr		lda	ticonobj+icRBundle+1	;if there's no bundle, accept whatever FiFiFi gave us		beq	@noKind				lda	ticonobj+icRBundle		sta	<handle		lda	ticonobj+icRBundle+2		sta	<handle+2				lda	[<handle]		clc		adc	ticonobj+icOneDocOffset		sta	<ptr		ldy	#2		lda	[<handle],y		adc	ticonobj+icOneDocOffset+2		sta	<ptr+2				ldy	#4			;check numresults		lda	[<ptr],y		cmp	#5		blt	@noKind				stz	ticonobj+icKind		stz	ticonobj+icKind+2		@noKind		pulllong <ptr		pulllong <handle		;; --- Set icTitleLen -----------------------------------------------------;		pha				Space for result.		pushZLong <ptr4		_StringWidth		pla		jsl	HalfRoundUp		; JAM		sta	ticonobj+icTitleLen	remember half the title's width.		jsr	setic			ic = (icHand)		ldy	#ICSIZE-2		Move the ICONOBJ template into;	  				        the allocated ICONOBJ record.		lda	ExtCopy			Extended ICONOBJ?		beq	@loop		lda	#ICEXTENDED		tsb	ticonobj+icFlag		;Mark as extended		lda	ticonobj+icOwner	Compute	index to end of	extended ICONOBJ.		clc						adc	#icOwner		tay@loop		lda	ticonobj,y		sta	[<ic],y		dey		dey		bpl	@loop				lda	ticonobj		;always fix the bottom word (always)		sta	[<ic];; --- Link icon's open window back to new icon -----------------------------;reLink		ldy	#icWind+1		Does icon have an open window?		lda	[<ic],y		beq	exit		pei	<wind+2			Saves.		pei	<wind		pei	<windBlk+2		pei	<windBlk		iny				Get open window's info block.		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	getwRefCon2		ldy	#windIc			Tell window about the new icon handle		lda	<icHand			the window opened from.		sta	[<windBlk],y		iny		iny		lda	<icHand+2		sta	[<windBlk],y		pla		sta	<windBlk		pla		sta	<windBlk+2		pla		sta	<wind		pla		sta	<wind+2exit		clc		rts;; locals;attachWhere	dc.w	0		EXPORT	lastIconHandlelastIconHandle	dc.L	0		EXPORT	AtCatalogEntryAtCatalogEntry	dc.w	0; *******************************; JAM 5/20/89 (Fixing BRC #46174); This routine assumes that <windblk is valid, and returns; icFlag.ICNETWORK>>16 (i.e., determines whether object is on net) for the; icon that owns the window of <windblk		EXPORT SeeIfDestWIsNetwork		; JAM 06/16/89 - for debugging purposesSeeIfDestWIsNetwork					; ... make this label public for maps		IMPORT NetworkBit;; Mensch 5/23/89; First test to see if the pointer is valid before we use it.		ldy 	#windic+1		lda 	[<windblk],y		bne 	@1; JAM 5/25/89 (Attempting to really fix #46174 without causing other problems.); The leap of faith.  If windic isn't valid (almost guaranteed when I am; called by OpenFolder) then gamble that NetworkBit is.  We are hoping that; windic will be valid for the volume-mounting situations in which AddIconObj; is called, and NetworkBit will be valid otherwise.		lda 	NetworkBit		and	#ICNETWORK>>16	; minimize damage if NetworkBit is ever invalid		rts@1; End of Fix		pha			; temp to hold result		phd			; we will put DP on stack, remember old one		ldy	#windic+2		lda	[<windblk],y		tax		dey		dey		lda	[<windblk],y		phx			; handle of owner icon (high)		pha			; handle of owner icon (low)		phx			; room for pointer of owner icon (high)		pha			; room for pointer of owner icon (low)		tsc		tcd			; now DP is looking onto the stack		ldy	#2		; dereference icon handle		lda	[<5],y		sta	<3		lda	[<5]		sta	<1		ldy	#icFlag+2		lda	[<1],y		and	#ICNETWORK>>16		sta	$000B,S		; put result in the result space		pla		pla		pla		pla		pld		pla			; get back return value		rts; end JAM 5/20/89 (BRC #46174)		;===============================================; Make an AuxType for network folders;	$08 = Owner Folder;	$04 = Drop Box;; IN:	AccessPriv; OUT:	AuxType;===============================================MakeFolderAux		stz	AuxType			; default (normal folder)						lda	AccessPriv		and	#$0007			; check user access bits		cmp	#$0004			; is it a drop box ?		bne	next			; no		lda	#$04			; mark as a "drop box" folder		sta	AuxType		bra	done		next		lda	AccessPriv		and	#$0008		beq	done			; bit 4 set if owner		lda	#$08			; mark as a "owner" folder		sta	AuxTypedone		rts		ENDP		; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Draw	icons in window	or desktop.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   rectRgn = region to redraw.;	   curWind = window to redraw in.;redrawList	PROCNAME	EXPORT;; --- Save walkOfLife variables	----------------------------------------;		lda	saveHand+2		pha		lda	saveHand		pha		pei	<curWind+2		Save state.		pei	<curWind		pei	<icHand+2		pei	<icHand		pei	<direction		lda	tocall+1		pha		jsr	startDraw		;; --- Redraw icon on desktop ---------------------------------;		jsr	ifDesk			Desktop	or window icon list?		bne	enter1		jsr	drawDeskIcon		bra	skip1;; --- Redraw icon in window ----------------------------------;enter1		pei	<rectRgn+2		pei	<rectRgn		_EraseRgn		pei	<rectRgn+2		Area to	be redrawn.		pei	<rectRgn		_InvalRgn			InvalRgn changes the region to global.; --- Restore walkOfLife variables ------------------------------------------skip1		jsr	endDraw		pla				Restore	state.		sta	tocall+1		pla		sta	<direction		pla		sta	<icHand		pla		sta	<icHand+2		pla		sta	<curWind		pla		sta	<curWind+2		pla		sta	saveHand		pla		sta	saveHand+2		jsr	setic		EXPORT	freeRectRgnfreeRectRgn	lda	<rectRgn+1		;Has it been freed already?		beq	@done		pei	<rectRgn+2		;Free the RECT region.		pei	<rectRgn		_DisposeRgn		stz	<rectRgn+1		;Mark as free.@done		EXPORT	freeTempRgnfreeTempRgn	lda	<tempRgn+1		;Has it been freed already?		beq	@done		pei	<tempRgn+2		;Free the temp region.		pei	<tempRgn		_DisposeRgn		stz	<tempRgn+1		;Mark as free.@done		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Draw	icons on the desktop. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   rectRgn = region to redraw.; 		EXPORT	drawDeskIcondrawDeskIcon	pei	<rectRgn+2		Clobbered region,		pei	<rectRgn		lda	port+visRgn+2		but only what's visible on the desktop,		pha		lda	port+visRgn		pha		lda	port+ClipRgn+2		equals the region to clip to.		pha		lda	port+ClipRgn		pha		_SectRgn		jsl	DrawDesk		Redraw the desktop area.		pea	screen2>>16		Set clip to full screen.		pea	screen2		_ClipRect		rts		ENDP;///////////////////////////////;	   Draw	desktop.;///////////////////////////////;;  This	routine	can be called from outside the Finder at the most;  inopportune times.  Therefore, I try	to save	global values.;;///////////////////////////////		EXPORT	DrawDeskDrawDesk	PROC		jsr	saveAcross		Save globals across call.;--- Start DJB fix of BRC# 49643----------------		lda	<deskport+1		bne	@Valid		brl	Exit100			; does BackAcross and returns@valid;--- end fix -----------------------------------		lda	port+visRgn+2		Save handle to my vis region.		pha		lda	port+visRgn		pha		pha				Get Window Mgr's port and clip handle.		pha		_GetPort		lda	1,s		sta	<wind		lda	3,s		sta	<wind+2		ldy	#ClipRgn		Replace	my vis handle with clobbered		lda	[<wind],y		area handle.		sta	port+visRgn		iny		iny		lda	[<wind],y		sta	port+visRgn+2		jsr	toDeskPort		Switch to desktop port.;--- Added 12/20/88 DJB ------------------------		lda	zoomRefresh		cmp	#2		beq	@doGuts		lda	ScreenHandle		; is there a desktop picture?		ora	ScreenHandle+2		beq	@noPic			; no				pha		pha		PushLong ScreenHandle		jsl	HandleToPointer		PullLong ScreenImage		; get pointer to desktop picture						PushLong #ScreenLocInfo		; LocInfo record		PushLong #ScreenRect		; enclosing rect		pei <zero			; X coordinate		pei <zero			; Y coordinate		PushWord #$0000			; penmode		_PPToPort			; draw the picture				PushLong ScreenHandle		jsl	UnlockHandle		; unlock it		bra	@doGuts;--- End Add -----------------------------------@noPic;		pea	screen>>16;		pea	screen*** 10-Mar-92 DAL -- use screen2 (full screen, so HideMenuBar works right)		pea screen2>>16		pea screen2*** end 10-Mar-92		_EraseRect@doGuts		lda	zoomRefresh		cmp	#1		beq	@noGuts					lda	<deskport		ldx	<deskport+2		jsr	drawGuts		Draw icons and rename field.@noGuts		stz	zoomRefresh		_SetPort			Restore	original port.		pla				Restore	handle to my clip region.		sta	port+visRgn		pla		sta	port+visRgn+2		bra	exit100;; 2 = redraw only the icons; 1 = redraw only the background pattern; 0 = redraw both the back pattern and the icons;		EXPORT	zoomRefreshzoomRefresh	dc.w	0;;///////////////////////////////////////////////;	   Draw	document window	content.;///////////////////////////////////////////////;;  This	routine	can be called from outside the Finder at the most;  inopportune times.  Therefore, I try	to save	global values.;		EXPORT	wind_gutswind_guts	jsr	saveAcross		Save state.		pha				Find out which window this is.		pha		_GetPort		pla		plx		jsr	drawGuts		Draw icons and rename field.exit100		jsr	backAcross		Restore	original state.		rtl; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Set text color to black text;	   on white background.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	normalColornormalColor	pea	15			;Background color to white.		_SetBackColor		pea 0				;Text color to black.		_SetForeColor		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Draw	icons and rename field.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=drawGuts	jsr	getwRefCon2		;windBlk = pointer to grafPort.		sta	<icHand			;Get handle of first icon in list.		stx	<icHand+2		lda	#drawIcon2		jsr	walkback2		lda	<LErename+1		;Is there a line edit field?		beq	exit200;;; Opt 19-Feb-92 DAL;		lda	<wind			Is this	the window that	has the	rename?;		cmp	LEwind;		bne	exit200		lda	<wind+1			;Is this the window that has the rename?		cmp	LEwind+1		bne	exit200		jsr	normalColor		pei	<LErename+2		pei	<LErename		_LEUpdateexit200		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Save/Restore	global values.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	saveAcrosssaveAcross			IMPORT	finderDPage				plx				Get return address.		phd				Save caller's direct page.		phb				Save caller's data bank.		phk				Switch to my data bank.		plb		lda	finderDpage			Switch to my direct page.		tcd		pei	<deref+2		pei	<deref		pei	<icHand+2		pei	<icHand		pei	<ic+2		pei	<ic		pei	<wind+2		pei	<wind		pei	<windBlk+2		pei	<windBlk		pei	<temp+2		pei	<temp		phx				;Return address back.		rts		EXPORT	backAcrossbackAcross	plx				;Get return address.		pla		sta	<temp		pla		sta	<temp+2		pla		sta	<windBlk		pla		sta	<windBlk+2		pla		sta	<wind		pla		sta	<wind+2		pla		sta	<ic		pla		sta	<ic+2		pla		sta	<icHand		pla		sta	<icHand+2		pla		sta	<deref		pla		sta	<deref+2		plb				;Return to caller's data bank.		pld				;Return to caller's data bank.		phx				;Return address back.		rts		ENDP;////////////////////////////////////////////////;	   Draw	information bar	guts.;////////////////////////////////////////////////info_guts	PROC EXPORT		IMPORT	IBName		IMPORT	IBSize		IMPORT	IBKind		IMPORT	IBDate		IMPORT	DrawAccessIcons		IMPORT	strUsed		IMPORT	strAvailable		IMPORT	pStringCat		IMPORT	freeKString		IMPORT	freeMBString		IMPORT	usedKString		IMPORT	usedMBString		IMPORT	fstNameBuffer		IMPORT	GetFSTBlockSizetheWindow	equ	7infoRefCon	equ	theWindow+4infoRect	equ	infoRefCon+4		phb		phk		plb				phd		tsc		tcd		ldy	#windIc+1		lda	[<infoRefCon],y		; get handle of opening icon		bne	@haveIcons;; Info bar is being drawn for the first time, before we're really done opening it.;; If we will have a dotted dividing line, draw it now to be pretty.;		ldy	#windView		lda	[<infoRefCon],y		cmp	#viewByName		blt	@done				lda	prefer				and	#PREF_SHOWDISK		beq	@done				jsr	drawDivider		;draw the Divider and which view they're looking at@done		brl	exit			;data not ready yet;; Draw Network Access Privilege Icons;		@haveIcons	jsr	NormalColor		; Black text, on a white background.		lda	#6		sta	startX+6		; default text starting position		lda	#16		sta	startX+14		; default text starting position				lda	#dxViewName		sta	dx		lda	#8		sta	dy		ldy	#windView		lda	[<infoRefCon],y		sta	boldTitle		cmp	#viewByName		bge	@checkDiskInfo		jsr	drawNetIcons		jsr	iconView		bra	exit@checkDiskInfo	lda	prefer		and	#PREF_SHOWDISK		beq	@noShowDisk		jsr	drawDivider		jsr	iconView		lda	#20					sta	dy		jsr	drawNetIcons		jsr	listView		bra	exit@noShowDisk	jsr	drawNetIcons		jsr	listView;; exit;exit				pld		plb		lda 2,s		sta 14,s		lda 1,s		sta 13,s		tsc		clc		adc #12		tcs		rtl		; drawDivider -- if it's view by name and the PREF_SHOWDISK is set, then;		 draw the dividing line;.....................................................................drawDivider	pushlong #oldMask		_GetPenMask		pushlong #dotMask		_SetPenMask				lda	#4		ldy	#x1			Set position of	text.		clc		adc	[<infoRect],y		pha		lda	[<infoRect]		clc		adc	#10		pha		_MoveTo		ldy	#x2		lda	[<infoRect],y		sec		sbc	#8		pha		lda	[<infoRect]		clc		adc	#10		pha		_LineTo				pushlong #oldMask		_SetPenMask		rts;; draw the network access icons if applicable;drawNetIcons	ldy	#windAccess		; Is icon from a network?		lda	[<infoRefCon],y		and	#ICNETWORK>>16		beq	@done			; no		lda	[<infoRefCon],y		and	#ICNETACCESS>>16	; get user's access bits		pha				lda	dy		clc		adc	#6		tay				; starting Y position		ldx	#4			; starting X position		pla		jsr	DrawAccessIcons		; draw access privilege icons		stx	startX+6		; new text starting position		cpx	#16			; 'name' must be at least 16 pixels over		bcc	@done		stx	startX+14		stx	dx@done		rts; List view info bar;.....................................................................listView	lda	boldTitle		cmp	#viewByName		bne	@notBoldName				lda	#1		jsr	setFace@notBoldName	jsr	setPosition		pushlong #IBName		_DrawString		lda	boldTitle		cmp	#viewByName		bne	@notName		lda	#0		jsr	SetFace@notName		lda	#dxViewSize		;set the x offset for the size field		sta	DX			;(or the next field to be displayed);; see if we should be displaying the size field at all;showSize		lda	boldTitle		cmp	#viewBySize		bne	@notBoldSize				lda	#1		jsr	SetFace		bra	@showSize		@notBoldSize	lda	prefer				and	#PREF_SHOWSIZE		bne	@showSize		bra	showKind@showSize	jsr	setPosition		pushlong #IBSize		_DrawString				lda	boldTitle		cmp	#viewBySize		bne	@notSize		lda	#0		jsr	SetFace@notSize		lda	#dxViewKind		sta	dx	;; see if we should be displaying the kind field at all;showKind		lda	boldTitle		cmp	#viewByKind		bne	@notBoldKind				lda	#1		jsr	SetFace		bra	@showKind		@notBoldKind	lda	prefer				and	#PREF_SHOWKIND		bne	@showKind		bra	showDate@showKind	jsr	setPosition		pushlong #IBKind		_DrawString				lda	boldTitle		cmp	#viewByKind		bne	@notKind		lda	#4		jsr	SetFace@notKind		lda	dx				clc		adc	#(dxViewDate-dxViewKind)		sta	dx		;; see if we should be displaying the date field at all;showDate		lda	boldTitle		cmp	#viewByDate		bne	@notBoldDate				lda	#1		jsr	SetFace		bra	@showDate		@notBoldDate	lda	prefer				and	#PREF_SHOWDATE		bne	@showDate		bra	@noDate@showDate	jsr	setPosition		pushlong #IBDate		_DrawString				lda	boldTitle		cmp	#viewByDate		bne	@noDate		lda	#0		jsr	SetFace@noDate		rts;; set the position of the text;setPosition	lda	dx		ldy	#x1			Set position of	text.		clc		adc	[<infoRect],y		pha		lda	[<infoRect]		clc		adc	dy		pha		_MoveTo		rts; viewing by icon... first, find out the name of our file system for this window;.....................................................................iconView		ldy	#windFST		lda	[<infoRefCon],y		asl	a		tax				lda	fstNames,x		sta	strings+6		;; convert number of items in window;		ldy	#windItems		lda	[<infoRefCon],y		pha				;Number of items in the window.		PushLong #itemsStrg+1		;Where to store string.				pea	4			;Number of bytes in output string.		pea	0			;Unsigned.		_Int2Dec;--- added the following hack to make Brenda happy...   DJB				sep	#$20		LONGA	OFF		lda	>itemsStrg		tax				;length (ie, offset)		lda	#'s'		sta	>itemsStrg,x		;default is plural ('items')		ldy	#windItems		lda	[<infoRefCon],y		cmp	#1		bne	cont1		lda	#' '		sta	>itemsStrg,x		;make it singular ('item')cont1		rep	#$20		LONGA	ON;; GetBlocksIn1MB -- get the number of blocks in 1 megabyte;GetBlocksIn1MB	lda	#1048576/512		;assume 512 byte blocks		sta	BlocksIn1MB				ldy	#windFST		lda	[<infoRefCon],y		jsl	GetFSTBlockSize				cmp	#512		beq	@notOddSize		pha		pha		pha		pha		pushlong #1048576		;numerator = 1MB		pea 0		pha				;denominator = block size (will never be zero)		_LongDivide		pla		sta	BlocksIn1MB		plx		plx		plx@notOddSize	;; Convert number of bytes used on disk;calcUsed	ldy	#windUsed+2		lda	[<infoRefCon],y		bne	@doUsedMegs		tax		dey		dey		ora	[<infoRefCon],y		Set notDiskFlag.  The trash window will		sta	notDiskFlag		have 0 bytes used and should not print.		lda	[<infoRefCon],y		cmp	BlocksIn1MB		bge	@doUsedMegs		pushLong #usedKString		phx		pha		pea	2			;type = K		ldy	#windFST		lda	[<infoRefCon],y		jsl	GetFSTBlockSize		pha		jsl	sizeToString		pushlong #strUsed		;src		pushlong #usedKString		;dest		jsl	PStringCat						lda	#usedKString		sta	strings+2		bra	calcFree@doUsedMegs	pushLong #usedMBString		ldy	#windUsed+2		lda	[<infoRefCon],y		pha				;Number of bytes used.		dey		dey		ora	[<infoRefCon],y		;Set notDiskFlag.  The trash window will		sta	notDiskFlag		;have 0 bytes used and should not print.		lda	[<infoRefCon],y		pha				;Far enough if zero bytes used.		pea	8			;type = MB		ldy	#windFST		lda	[<infoRefCon],y		jsl	GetFSTBlockSize		pha		jsl	sizeToString		pushlong #strUsed		;src		pushlong #usedMBString		;dest		jsl	PStringCat				lda	#usedMBString		sta	strings+2;; Convert number of bytes free on disk;calcFree		ldy	#windFree+2		lda	[<infoRefCon],y		bne	@doFreeMegs		tax		dey		dey		lda	[<infoRefCon],y		cmp	BlocksIn1MB		bge	@doFreeMegs				pushLong #freeKString		phx		pha		pea	2			;type = K		ldy	#windFST		lda	[<infoRefCon],y		jsl	GetFSTBlockSize		pha		jsl	sizeToString		pushlong #strAvailable		;src		pushlong #freeKString		;dest		jsl	PStringCat						lda	#freeKString		sta	strings		bra	calcWidths@doFreeMegs	pushLong #freeMBString		ldy	#windFree+2		lda	[<infoRefCon],y		pha				;number of bytes free.		dey		dey		lda	[<infoRefCon],y		pha		pea	8			;type = MB		ldy	#windFST		lda	[<infoRefCon],y		jsl	GetFSTBlockSize		pha		jsl	sizeToString				pushlong #strAvailable		pushlong #freeMBString		jsl	pStringCat				lda	#freeMBString		sta	strings		;; Compute the width of each string;calcWidths		ldx	#6lop1		phx		pha		pea	StringBase>>16		;get bank where strings are		lda	strings,x		pha		_StringWidth		pla		plx		clc		adc	#8			;spacing.		sta	stringsLen,x		dex		dex		bpl	lop1;; Compute the position of each string relative to the bar's width;		lda	stringsLen		;how long is everything?		clc		adc	stringsLen+2		clc		adc	stringsLen+4		clc		adc	stringsLen+6		sta	totalStringsLen				ldy	#x2		lda	[<infoRect],y		ldy	#x1		sec		sbc	[<infoRect],y		That's the bar's width,;		sec;		sbc	startX+6		;remove padding for the left		dec	a			;this is actually 3 pixels in the final		dec	a		sec				;analysis		sbc	totalStringsLen		bcc	@smashTogether				pha		pha		pha		pea	3			;divide the total amount of white space		_UDivide			;by 3 for the 3 equal areas		pla		sta	whiteSpace		plx		cmp	#4		blt	@smashTogether				lda	startX+6		clc		adc	stringsLen+6		adc	whiteSpace		sta	startX+4				clc		adc	stringsLen+4		adc	whiteSpace		sta	startX+2				clc		adc	stringsLen+2		adc	whiteSpace		sta	startX		bra	done1		;; we couldn't give everything an equivalent amount of whitespace, so we need to smash all; the strings end-to-end;@smashTogether		lda	startX+6		clc		adc	stringsLen+6		adc	#4		sta	startX+4				clc		adc	stringsLen+4		adc	#4		sta	startX+2				clc		adc	stringsLen+2		adc	#4		sta	startX;; Print the strings, checking first to see if the window is the trash window;done1		lda	notDiskFlag		bne	@isDisk		lda	startX+6		ldy	#x1			;Set position of text.		clc		adc	[<infoRect],y		pha		lda	[<infoRect]		clc		adc	#8		pha		_MoveTo		pea	StringBase>>16		;Pass string pointer to _DrawString.		lda	strings+4		pha		_DrawString		rts@isDisk		ldx	#6			;Index into title table.		ldy	#4			;Number of titles to print.@loop		phy		phx		pea	StringBase>>16		;Pass string pointer to _DrawString.		lda	strings,x		pha		lda	startX,x		ldy	#x1			;Set position of text.		clc		adc	[<infoRect],y		pha		lda	[<infoRect]		clc		adc	#8		pha		_MoveTo		_DrawString		plx		dex		dex		ply		dey		bne	@loop		rts		;; misc local routines;setFace		pha				;bold text face.		_SetTextFace		rts;; locals;BlocksIn1MB	dc.w	0totalStringsLen	dc.w	0whiteSpace	dc.w	0fstNames	dc.w	nullName		dc.w	ProDOSName		dc.w	DOS33Name		dc.w	DOS32Name		dc.w	PascalName		dc.w	MFSName		dc.w	HFSName		dc.w	LisaName		dc.w	CPMName		dc.w	nullName		dc.w	MSDOSName		dc.w	HighSierraName		dc.w	ISO9660Name		dc.w	AppleShareName		dc.w	nullName		dc.w	nullName		dx		dc.w	0dy		dc.w	8		;depends on PREF_SHOWDISKoldMask		ds.b	8dotMask		dc.b	$00		dc.b	$cc		dc.b	$00		dc.b	$cc		dc.b	$00		dc.b	$cc		dc.b	$00		dc.b	$cc		ENDP;===============================;	   Blink Icon.;===============================;;   IN:	   ic =	pointer	to locked icon to be blinked.;;===============================		EXPORT	blinkIconblinkIcon	PROC		ldx	#6			Number of state	changes, should	be even.lop1		phx				Save blink counter.		jsr	blinkOne		plx				Get blink counter.		dex		bne	lop1			All done?		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Change an icon's state and redraw.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   ic =	pointer	to locked icon to be blinked.;		EXPORT	blinkOneblinkOne	ldy	#icFlag			Flip selected state.		lda	[<ic],y		eor	#ICSELECTED		sta	[<ic],y		jsr	drawIcon2		clc				Sometimes called from walkOfLife.		rts		ENDP; drawIcon;;   IN:	   a = low word	pointer	to ICONOBJ (locked).;	   x = high word pointer to ICONOBJ (locked).;	   windBlk = pointer to	window information block.;.....................................................................drawIcon	PROC	EXPORT		IMPORT	PStrClip		IMPORT	GetFSTBlockSize		sta	<ic			Save pointer to	ICONOBJ.		stx	<ic+2; drawIcon2;; IN: 	ic =	pointer	to ICONOBJ;	windBlk = pointer to	window information block;.....................................................................		EXPORT	drawIcon2drawIcon2	name				IMPORT	zeroString		IMPORT	CheckVisEdges		IMPORT	GetIconRect3		IMPORT	GetVisRECT		;; first, get vis and check the top and bottom to see if we should be drawing or not;		jsr	GetVisRECT				ldy	#windView		lda	[<windBlk],y		jsr	getIconPtr								ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		bge	@notIconView		tay		ldx	#16-2@saveLoop	lda	<irect1,x		sta	irect1Save,x		dex		dex		bpl	@saveLoop				jsr	GetIconRect3		;Y = 0 for large icon, 1 for small icon		jsr	CheckVisEdges				php		ldx	#16-2@restoreLoop	lda	irect1Save,x		sta	<irect1,x		dex		dex		bpl	@restoreLoop		plp		bcc	@fastExit				ldy	#windView		;get the view to draw for		lda	[<windBlk],y		brl	realDrawIcon;; this was not an icon view, so we need to check our edges a little differently to; determine whether we're in the vertical visRgn or not;@notIconView	ldy 	#icTextY		lda 	[<ic],y		cmp 	<visRECT+y1		bmi	@fastExit				sec		sbc	#15		cmp 	<visRECT+y2		beq	asText		bmi 	asText@fastExit	jsr	UnlockICBLKHAND		clc		rts;; Draw filename as text;asText		ldy	#icx		lda	[<ic],y		pha				;Save X position,		lda	#textLeft		;change X position to absolute.		sta	[<ic],y		dey		dey		lda	[<ic],y		pha				;Save Y position,		ldy	#icTextY		;change to what's in icTextY field.		lda	[<ic],y		ldy	#icy		sta	[<ic],y		lda	#1			;Draw small flag.		jsr	realDrawIcon		ldy	#icy		pla				;Restore Y position.		sta	[<ic],y		iny		iny		pla				;Restore X position.		sta	[<ic],y		ldy	#icFlag			;Check if the icon is selected.		lda	[<ic],y			;If it is selected, the text color		and	#ICSELECTED		;is set wrong and will have to be		beq	@notSelected		;reset.		jsr	NormalColor		;Black text, White background@notSelected	lda	#dxViewSize		;set the x offset for the size field		sta	DX			;(or the next field to be displayed)		;; Draw Size field;drawSize		ldy	#windView		;check the current view		lda	[<windBlk],y		cmp	#viewBySize		;if it's by size, then we must display the		beq	@show			;size field		lda	prefer				and	#PREF_SHOWSIZE		bne	@show		brl	showKind@show				lda	dx		cmp	<visRECT+x2		blt	@visible		beq	@visible				clc		rts@visible			ldy	#icFType		lda	[<ic],y		cmp	#TypeFolder		; a folder?		bne	ok2			; no				lda	#3		sta	>SizeStrg		lda	#'--'			; folders don't show sizes here		sta	>SizeStrg+1		; use "---" instead		sta	>SizeStrg+3		bra	sWidth		ok2		ldy	#icFBlocks		lda	[<ic],y		tax		iny		iny		lda	[<ic],y		bne	@bigNum		txy			bne	@bignum				pha				; space for width		PushLong #zeroString		_StringWidth		lda	#dxViewKind-10		sec		sbc	1,s		sta	1,s		ldy	#icTextY		lda	[<ic],y		pha		_MoveTo		PushLong #zeroString		_DrawString				lda	#dxViewKind		;if we printed the size, we know		sta	dx			;exactly where dx should be		bra	showKind@bigNum		pushLong #sizeStrg		pha				;block size		phx		pea	2			;type = K		ldy	#icFST		lda	[<ic],y		jsl	GetFSTBlockSize		pha		jsl	sizeToString		;SizeStrg = size of icon in ASCIIsWidth		pha				;space for width		PushLong #SizeStrg		_StringWidth		lda	#dxViewKind-10		sec		sbc	1,s		sta	1,s		ldy	#icTextY		lda	[<ic],y		pha		_MoveTo		PushLong #SizeStrg		_DrawString		lda	#dxViewKind		;if we printed the size, we know		sta	dx			;exactly where dx should be		;; Draw Kind field;showKind			ldy	#windView		;check the current view		lda	[<windBlk],y		cmp	#viewByKind		;if it's by kind, we have to show		beq	@show			;the kind		lda	prefer		and	#PREF_SHOWKIND		bne	@show		brl	showDate			@show		lda	dx		cmp	<visRECT+x2		blt	@visible		beq	@visible				clc		rts@visible	lda	dx			;current x offset		pha		ldy	#icTextY		lda	[<ic],y		pha		_MoveTo		ldy	#icKind+1		lda	[<ic],y		bne	@normalKind				pushZLong <handle		pushZLong <ptr				ldy	#icRBundle		;get the handle to the rBundle		lda	[<ic],y		sta	<handle		iny		iny		lda	[<ic],y		sta	<handle+2		lda	[<handle]		;deref the handle to the rBundle		sta	<ptr		ldy	#2		lda	[<handle],y		sta	<ptr+2		;		ldy	#icOneDocOffset		;add the offset of the OneDoc to the pointer to;		lda	[<ic],y			;the rBundle;		clc;		adc	<ptr;		adc	#32			;offset +32 is the kind string;		sta	<ptr;		iny;		iny;		lda	[<ic],y;		adc	<ptr+2;		sta	<ptr+2*** fixed 11-Jan-93 DAL to propogate the carry correctly		ldy	#icOneDocOffset		;add the offset of the OneDoc to the pointer to		lda	[<ic],y			;the rBundle		clc		adc	<ptr		sta	<ptr		iny		iny		lda	[<ic],y		adc	<ptr+2		sta	<ptr+2		clc		lda	<ptr		adc	#32			;offset +32 is the kind string		sta	<ptr		bcc	@1		inc	<ptr+2@1*** end 11-Jan-93		ldy	#4			;lock the handle for drawing		lda	[<handle],y		ora	#$8000		sta	[<handle],y				ldx	<ptr+2		lda	<ptr		jsr	DrawKindField		;draw the kind field				ldy	#4			;unlock the handle		lda	[<handle],y;;;		and	#$7FFF		asl a		lsr a		sta	[<handle],y		pulllong <ptr		pulllong <handle		bra	@showAllOfKind@normalKind	ldy	#icKind+2		;get the pointer to the kind string		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	DrawKindField@showAllOfKind	lda	dx				clc		adc	#(dxViewDate-dxViewKind)		sta	dx		;; Draw 'Last Modified' field;showDate			ldy	#windView		;check the current view		lda	[<windBlk],y		cmp	#viewByDate		;if it's by date, we HAVE to show		beq	@show			;the date field		lda	prefer		and	#PREF_SHOWDATE		beq	bingo		@show				lda	dx			;is this field going to be within the 		cmp	<visRECT+x2		;right edge of our visRgn?		blt	@visible		beq	@visible		;if so, display it... 				clc				;if not, don't display it		rts@visible			lda	dx		pha		ldy	#icTextY		lda	[<ic],y		pha		_MoveTo		add4	<ic,#icMDate,<temp				PushLong #DateStrg		; ptr to dest. string		PushLong <temp			; ptr to GS/OS date record		PushWord DateFormat		; format		jsl	DateToString				PushLong #DateStrg		_DrawString						bingo		clc				;and we are outta here!		rts;; see if we really need to clip this thing -- because it's kind of pointless to clip the; kind string if nothing else is going to be printed after the kind string, huh?;DrawKindField	;		phx;		pha;		;		ldy	#windView		;check the current view;		lda	[<windBlk],y;		cmp	#viewByDate		;if it's by date, then we're going;		beq	@clipKind		;to have to clip always		;;		lda	prefer;		and	#PREF_SHOWDATE;		bne	@clipKind;		;		_DrawString			;draw what we got;		rts;;@clipKind	pushLong #tempStrg1;		pea	dxViewDate-dxViewKind-10 ; max pixel width;		jsl	PStrClip		 ; clip string to fit in our space;;		pushLong #tempStrg1;		_DrawString;		rts*** changed 24-Aug-92 DAL to use DrawStringWidth		pea $6000			;flags for DrawStringWidth (truncate on right)		phx		pha				;pstring pointer		ldx #dxViewDate-dxViewKind-10	;anticipate clipping width		ldy #windView		lda [<windBlk],y		;if it's by date, then we're going		cmp #viewByDate			;to have to clip		beq @clip		lda prefer		and #PREF_SHOWDATE		bne @clip		ldx #$3fff			;huge clip value (don't clip)@clip		phx;		_DrawStringWidth		ldx #$1512		jsl $e10000		rts*** end 24-Aug-92;; UnlockICBLKHAND -- unlock the icon block;		EXPORT	UnlockICBLKHANDUnlockICBLKHAND		ldy	#4		lda	[<icBlkHand],y		and	#$3FFF		sta	[<icBlkHand],y		rts;; locals;size		dc.w	0dx		dc.w	0			;current x offset we're working withirect1Save	ds.b	16			;saves both irect1 and irect2 which must be contiguous on DP; = = =	= = = =	= = = =	= = = =	= =;	   Real	draw icon.; = = =	= = = =	= = = =	= = = =	= =;;   IN:	   a = 0 for large icon, 1 for small icon.;	   ic =	pointer	to ICONOBJ.;	   windBlk = pointer to	window information block.;; = = =	= = = =	= = = =	= = = =	= =realDrawIcon			IMPORT	PStrClip		sta	iconSize		Save which icon	size to	draw.		pushZLong <icon			;ptr to icon		ldy	#icFlag			Is the icon selected?		lda	[<ic],y		and	#$FF07		pha				Pass mode.		ldy	#icFlag+2		Is the icon readable?		lda	[<ic],y		and	#ICREADABLE>>16		bne	cont		lda	1,s		ora	#ICOFFLINE		;change mode to fake an offline		sta	1,scont		ldy	#icx		lda	[<ic],y		ldy	#imWidth		sec		sbc	[<icon],y		pha		ldy	#icy			Icon's y position,		lda	[<ic],y		ldy	#imHeight		less it's height.		sec		sbc	[<icon],y		pha				equals icon's top side.		_DrawIcon; --- Print icon's title -----------------------		lda	<icHand			Don't draw title for icon being renamed.		cmp	LEicon		bne	ok5		lda	<icHand+1		cmp	LEicon+1		bne	ok5		brl	exit5 ;--- draw lock if icon is locked ---------------ok5		ldy	#icFlag			; get locked status		lda	[<ic],y		and	#ICLOCKED		beq	justText		; not locked		ldx	#$0001			; normal draw		ldy	#icFlag		lda	[<ic],y		and	#ICSELECTED		; if selected use inverted draw mode		beq	saveMode		ldx	#$8001			; inverted drawsaveMode	phx				; save draw mode		lda	iconSize		; Large or Small icon?		beq	big1		ldy	#icx		lda	[<ic],y		clc		adc	#16		tax				; x is set		ldy	#imHeight		lda	[<icon],y		sec		sbc	#TITLE_H		; height of font		bcs	ok4		lda	<zerook4		pha		ldy	#icy		lda	[<ic],y		clc				; a little extra		sbc	1,s		sec		sbc	#7			; kludge		ply		tay				; y is set		bra	enter5big1		ldy	#icx		lda	[<ic],y			; icon's x position		ldy	#icTitleLen		sec		sbc	[<ic],y		sec		sbc	#lockWidth/2		; re-adjust for lock's width		tax				; x is set		ldy	#icy		lda	[<ic],y			; icon's y position		clc		adc	#TITLE_H-7		tay				; y is setenter5		pla				; get draw mode		jsr	DrawDevLock		; draw lock before text;--- draw icon name in text --------------------justText	lda	iconSize		; Large or Small icon?		beq	big2		ldy	#icx			; set title position for small icon		lda	[<ic],y		clc		adc	#16		pha				; push X position		ldy	#imHeight		lda	[<icon],y		sec		sbc	#TITLE_H		; height of font		bcs	ok7		lda	<zerook7		pha		ldy	#icy		lda	[<ic],y		clc				; a little extra		sbc	1,s		plx		pha				; push Y position		bra	enter6big2		ldy	#icx			; set title position for big icon		lda	[<ic],y		ldy	#icTitleLen		sec		sbc	[<ic],y		pha				; push X position		ldy	#icy		lda	[<ic],y		clc		adc	#TITLE_H		; height of font		pha				; push Y position		enter6		ldy	#icFlag			; get locked status		lda	[<ic],y		and	#ICLOCKED		beq	move			; not locked		lda	3,s			; else adjust X for lock width		clc		adc	#lockWidth/2		ldx	iconSize		beq	save		adc	#lockWidth/2save		sta	3,smove		_MoveTo		ldy	#icFlag			Set text color for selected or not.		lda	[<ic],y		and	#ICSELECTED		beq	normal		lda	#$000F			Selected color.normal		pha		eor	#$000F		pha		_SetBackColor		_SetForeColor		jsr	pushicName		; pass icon name ptr		lda	iconSize		beq	drawName		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		beq	drawNameclip		PushLong #tempStrg1		PushWord #dxViewSize-62		jsl	PStrClip		; clip string to fit in our space		PushLong #tempStrg1drawName	_DrawString;; --- Unlock ICONBLK -----------------------------------------------;exit5		brl	UnlockICBLKHANDiconSize	DC.W	0		ENDP;============================;	   Zoom	RECT.;============================;;  In:	   a = 0 to zoom down, not 0 to	zoom up.;	   smallRect = small rect  (both in global coordinates);	   bigRect = big rect;;============================		EXPORT	ZoomRectZoomRect	PROC		IMPORT	smallRect		IMPORT	bigRect		tay		beq	down		lda	#$8000down		pha				pei <zero		pushlong #smallRect		pushlong #bigRect		_WhooshRect		rts;; zoom to local coordinates (local port);		EXPORT zoomRect2zoomRect2		tay		beq	@down		lda	#$8000@down		ora	#$4000		bra	down		;; zoomRectNoSound -- zoom quietly in current port;		EXPORT zoomRectNoSoundzoomRectNoSound lda #$E000	;bit 30 = current port, 29 = no sound		bra down		ENDP;==============================================;	   Custom draw drag routine.;	   Called by DragRect.;==============================================;;   IN:	   yrat, xrat =	starting point in local	coordinates.;	   yoffset, xoffset = offset to	global coordinates.;	   rectPtr = pointer to	RECT list.;;==============================================		dragRects	PROC EXPORT		IMPORT	QDBank		IMPORT	finderDPagedeltay		equ	7deltax		equ	deltay+2drawFlag	equ	deltax+2rectCount	equ	workrectIndex	equ	rectCount+2		phd				Save original direct page.		phb				Save original data bank.		phk				Switch to my data bank.		plb		lda	finderDpage			Switch to my direct page.		tcd		lda	deltay,s		Set parameters.		sta	dragDeltay		lda	deltax,s		sta	dragDeltax		ldx	<drawCount		lda	drawFlag,s		Am I being asked to draw?		lsr	a		bcc	store1		;		and	#1;		beq	store1		inxstore1		txa		and	#1		sta	drawRequest		jsr	hitDesIcon		;Check if cursor is over a destination				 		;icon, or off of one.		lda	drawFlag,s		Should RECTs really be drawn?		lsr	a		bcc	exit;		and	#1;		beq	exit		lda	<drawCount		Has request already been made?		and	#1		cmp	drawRequest		beq	exit		jsr	drawRects		Draw the RECT list.exit		plb		pld		lda	0,s			Move return address down stack.		sta	6,s		lda	2,s		sta	8,s		pla				Remove passed parameters.		pla		pla		rtl				Return to DragRect.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Hit test icons for dragging over;	   possible destinations.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   TaskData = source window.;;  OUT:	   windTrack = destination window.;;; Change History;; 21 Jul 87	 SEG from DanO;; Introduced BadDes variable for use in	determining if window is; is a window that can be dragged to.;; 22 Jul 87	 SEG;; Allowed for dragging into the	trash window.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =hitDesIcon		stz	BadDes				pei	<xrat			Save current yrat and xrat.		pei	<yrat		pei	<yoffset		Save.		pei	<xoffset		jsr	pushyrat		_GetMouse			yrat, xrat = current rat position (local).		jsr	pushyrat		Make the position global.		_LocalToGlobal		stz	<curWind+1		Mark as	no window.		pha		lda	#curWind		Where to store found window.		jsr	pushzpage		pei	<xrat			Pass x point to	check.		pei	<yrat			Pass y point to	check.		_FindWindow		pla		bmi	next400				cmp	#wInMenuBar		bne	@NotMenu		stz	<curWind		;added 08/08/88		stz	<curWind+2		; used by dragit() (below)		bra	@fallinhere@NotMenu	cmp	#wInDesk		;On desktop?		beq	@onDesktop			cmp	#wInContent				beq	next400		;; if they end up here, they dragged onto either the title bar, or scroll bar, or info bar, or title controls.;		jsr	cur2windT		windTrack = curWind (save last window).								lda	<curWind		;Get destination window's ID.		ldx	<curWind+2		jsr	getWindID		bcs	@gotDirWind		;Desktop as destination is OK.		cmp	#DirWindID		beq	@gotDirWind		cmp	#TrashWindID		;trash window is OK.		beq	@gotDirWind		inc	BadDes		bra	wayOff			;Directory as destination is OK.@gotDirWind			ldx	<IconTrack+1		beq	@iconNotOn		;Is any icon being tracked?		lda	<IconTrack		;If so, turn it OFF		jsr	TurnIconOff@iconNotOn	stz	<icHand+1				brl	exit401			;; they are dragging on the desktop...;@onDesktop	lda	<deskport		;Check desktop plane.		sta	<curWind		lda	<deskport+2		sta	<curWind+2@fallinhere	stz	<xoffset		No offset for desktop.		stz	<yoffsetnext400		jsr	cur2windT		windTrack = curWind (save last window).		lda	<curWind+1		Over any window?		beq	wayOff		lda	<curWind		Get destination	window's ID.		ldx	<curWind+2		jsr	getWindID		bcs	ok403			Desktop	as destination is OK.		cmp	#DirWindID		beq	ok403		cmp	#TrashWindID		trash window is	OK.		beq	ok403		inc	BadDes		bra	wayOff			Directory as destination is OK.ok403		jsr	startDraw		Switch to window cursor	is over.		jsr	pushyrat		_GlobalToLocal		jsr	endDraw			Put window's origin back to 0,0.		lda	#hitTest		On an icon or miss?		jsr	walkOfLife3		bcs	iconHit400wayOff		stz	<icHand+1		Set no hit flag.; --------- Cursor over	an icon, check to deselect current icon	----------iconHit400		ldx	<IconTrack+1		beq	skip400			Is any icon being tracked?		lda	<IconTrack		Did we hit on the same icon currently		cmp	<icHand			selected?		bne	turnOff400		cpx	<icHand+1		bne	turnOff400		brl	exit401			If yes,	done.turnOff400	jsr	TurnIconOffskip400		lda	<icHand+1		beq	exit401			Is there a new icon?		pushZLong <icHand		;save the current icon		stz	NonRemovable		;init counters		stz	iconSelected		lda	#IsNonRemovable		jsr	WalkOfLife3		;count icons & non-removable icons		pulllong <icHand		;restore icon				ldy	#4		lda	[<icHand],y		pha		jsr	lockic			ic = (icHand).		ldy	#icFlag			At this	point, any selected icons are the		lda	[<ic],y			ones being dragged.		and	#ICSELECTED		bne	exit402			Is this	icon already selected?		ldy	#icFType		Is this	an icon	that could be		lda	[<ic],y			a destination icon?		bmi	ok402			Trash can, device?		cmp	#TypeFolder		Folder?		bne	exit402			nope						ldy	#icMom			;is your mama trash ?		lda	[<ic],y		cmp	<TrashWind		bne	ok401			;no but maybe yours is		iny		iny		lda	[<ic],y			;are you really sure?		cmp	<TrashWind+2		beq	exit402			;yes, she is				bra	ok401			;clean folders can be dest.				ok402		cmp	#TypeFDrive		Floppy drives cannot be	destinations.		beq	exit402		cmp	#TypeFTrash		;is destination the trash?		bcc	ok401			;no		lda	NonRemovable		;any non-removable devices?		beq	ok401			;no		cmp	iconSelected		;were they all non-removable ?		beq	exit402			;yesok401		lda	<icHand			Remember icon being tracked.		sta	<IconTrack		ldx	<icHand+1		stx	<IconTrack+1		jsr	Ck2Erase		Erase RECTs if needed.		jsr	startDraw		jsr	onIcon			Select the icon.		jsr	endDraw		jsr	Ck2Draw			Draw RECTs if needed.exit402		pla		ldy	#4		sta	[<icHand],y		; ------ Return	to proper port for dragging -------------------------------exit401		jsr	toDeskPort		Switch to desktop port.		pla				Restore.		sta	<xoffset		pla		sta	<yoffset		pla				Restore	yrat and xrat.		sta	<yrat		pla		sta	<xrat		rtsNonRemovable	DC.W	0			;true if source icon is non-removable ;; turn the icon off that we're tracking;; IN: A&X contain the handle of the icon we're looking at;TurnIconOff	pushZLong <icHand		pushZLong <curWind		sta	<icHand		stx	<icHand+1		ldy	#4		lda	[<icHand],y		pha		jsr	lockic		ldy	#icMom		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2		jsr	Ck2Erase		Erase RECTs if needed.		jsr	startDraw		jsr	offIcon2		Deselect and redraw the	old icon.		jsr	endDraw		jsr	Ck2Draw			Draw RECTs if needed.				ldy	#4		pla		sta	[<icHand],y		pulllong <curWind		pulllong <icHand		stz	<IconTrack+1		No longer tracking an icon.		rts		;===============================================;  Look for selected + non-removable icons.;===============================================;;   IN:	   ic =	locked ICONOBJ to test.;;  OUT:	   Carry clear if not found (ie keep searching);;===============================================IsNonRemovable		import	EjectNonRemovable				ldy	#icFlag			;first check if icon selected		lda	[<ic],y		and	#ICSELECTED		beq	@done			;not selected				inc	iconSelected		;count selected icons		ldy	#icFType		;now check the type of icon		lda	[<ic],y		bpl	@done			;not a device		ldx	EjectNonRemovable		beq	@noEject		ldy	#icFtype		;see if it's a hard drive partition		lda	[<ic],y		cmp	#TypeHardPart		beq	@done@noEject	ldy	#icDevInfo		;if it's ejectable, exit		lda	[<ic],y			;andy, 12/4/90		and	#$0004		bne	@done		inc	NonRemovable		;count non-removable icons	@done		clc				;keep going flag		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Erase RECTs from screen.;  = = = = = = = = = = = = = = = = = = = = = = = = =;Ck2Erase	lda	<drawCount		Are the	RECTs on the screen?		and	#1		beq	exit300		jsr	drawRects		Erase the RECTs	from the screen.exit300		rtsCk2Draw		lda	drawRequest		Were the RECTs requested off screen?		beq	exit300			If yes,	no need	to draw	them.; = = =	= = = =	= = = =	= = = =	= = =;	   Draw	drag RECTs.; = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   dragDeltay =	deltay.;	   dragDeltax =	deltax.;	   rectPtr = pointer to	RECT list.;;  OUT:	   drawCount = bit #0 is zero if RECTs are not on screen.drawRects	inc	<drawCount		Draw counter to	tell if	on screen.		lda	[<rectPtr]		Get number of RECTs.		sta	<rectCount		bne	@haveRects		;our deep shit preventer		rts@haveRects						lda	SourceView		cmp	#viewBySmallIcon		bge	@byListView				lda	[<rectPtr]		;if by Icon		lsr	a		sta	<rectCount@byListView		jsr	toDeskPort		Switch to desktop port.		_HideCursor		ldy	#2			Index to first RECT.lop500		ldx	<zero			Clone RECT into	'irect1' and 'irect2'.lop501		lda	[<rectPtr],y		Y1.		clc		adc	dragDeltay		sta	table1,x		sta	table1+4,x		sta	table1+8,x		sta	table1+28,x		iny		iny		lda	[<rectPtr],y		X1.		clc		adc	dragDeltax		sta	table1+2,x		sta	table1+22,x		sta	table1+26,x		sta	table1+30,x		iny		iny		lda	[<rectPtr],y		Y2.		dec	a		clc		adc	dragDeltay		sta	table1+12,x		sta	table1+16,x		sta	table1+20,x		sta	table1+24,x		iny		iny		lda	[<rectPtr],y		X2.		clc		adc	dragDeltax		sta	table1+6,x		sta	table1+10,x		sta	table1+14,x		sta	table1+18,x		iny		iny		txa				ldx	SourceView		cpx	#viewBySmallIcon		bge	drawSingleRect				ldx	#32		dec	a		bpl	done500		brl	lop501		done500		sty	<rectIndex		ldy	#62		bra	outsideLoop;; --- Draw the lines -----------------------------------------;drawSingleRect	sty	<rectIndex		ldy	#30outsideLoop	ldx	#x2@loop		lda	table1,y		sta	<irect1,x		dey		dey		dex		dex		bpl	@loop		phy		lda	<irect1+y1		cmp	<irect1+y2		beq	@doHorizontal		jsr	drawVer		bra	@next@doHorizontal	jsr	drawHor@next		ply		bpl	outsideLoop		ldy	<rectIndex		Load up	index for next RECT.		dec	<rectCount		Any more RECTs?		beq	exit500		brl	lop500exit500		_ShowCursor		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Draw	a horizontal line.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   irect1 = points.drawHor		lda	<irect1+y1		;Clip line.		bmi	exit102		cmp	#200		bcc	ok103exit102		rtsok103		ldx	<irect1+x1		bpl	ok101		ldx	<zero		stx	<irect1+x1ok101		lda	<irect1+x2		;Always go from left to right.		bpl	ok102		lda	<zerook102		cmp	<irect1+x1		beq	exit100			;Completely clipped?		bcs	ok100;				      		;x = x1;				      		;a = x2		tay				;y = x2		txa				;a = what as x1, now x2.		tyx				;x = what was x2, now x1.;;				      		;x = x1ok100		tay				;y = x2		beq	exit100		cpx	#638		bcs	exit100		inc	a			;Little more, cause vertical is 2 wide.		cmp	#638		bcc	store100		lda	#638store100	stx	<irect1+x1		sta	<irect1+x2		and	#3		asl	a		tax		lda	pixelMask2,x		sta	<mask2		lda	<irect1+x1		and	#3		tax		eor	#3		inc	a		sta	<irect1+y2		txa		asl	a		tax		lda	pixelMask1,x		sta	<mask1		jsr	setupLine		ldy	<zero			First part.		lda	(<line1),y		eor	<mask1		sta	(<line1),y		iny		lda	<irect1+x2		sec		sbc	<irect1+x1		sbc	<irect1+y2		bmi	skip100		sta	<mask1		lsr	a		lsr	a		lsr	a		tax				Number of pixels.		bra	enter100lop100		lda	(<line1),y		eor	#$FFFF		sta	(<line1),y		iny		inyenter100	dex		bpl	lop100		lda	<mask1		and	#4		beq	skip100		lda	(<line1),y		eor	#$00FF		sta	(<line1),y		inyskip100		lda	(<line1),y		eor	<mask2		sta	(<line1),yexit101		plbexit100		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Draw	a vertical line.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   irect1 = points.;drawVer		lda	<irect1+x1		Completely clipped?		bmi	exit200		cmp	#638		bcs	exit200		ldx	<irect1+y1		Force top to bottom.		bpl	ok201		ldx	<zero		stx	<irect1+y1ok201		lda	<irect1+y2		bpl	ok202		lda	<zerook202		cmp	<irect1+y1		bcs	ok203		tay		txa		tyxok203		cpx	#200			Line completely	off bottom?		bcs	exit200		tay		beq	exit200			Line completely	off top?		cmp	#200			Line off botom?		bcc	store200		lda	#199			Clip to	bottom of screen.store200	stx	<irect1+y1		sta	<irect1+y2ok200		lda	<irect1+x1		and	#3		asl	a		tax		lda	pixelMask3,x		sta	<mask3		jsr	setupLine		lda	<irect1+y2		sec		sbc	<irect1+y1		beq	exit201		tax				Number of lines	to do.		ldy	#160		bra	enter200lop200		lda	(<line1),y		eor	<mask3		sta	(<line1),y		tya		clc		adc	#160		tayenter200	dex		bne	lop200exit201		plb				; restore data bank (pushed by setupLine)exit200		rts;; --- Compute the scan line addresses ------------------------;setupLine	lda	<irect1+x1		lsr	a		lsr	a		tax		lda	<irect1+y1		asl	a		tay		txa		clc		adc	[<lineAddrs],y		sta	<line1		plx				; get return address		phb				; save the current data bank		phx				; repush return address; 2/1/90: djb/rdl fix for djb for CloseView: get QuickDrawÕs bank (1 or E1); (was previously hardcoded: pea $E1E1 ; change data bank to $E1, plb, plb)		lda	QDBank			; change data bank to QDÕs scrn bank (1 or E1)		pha				; saved, lo/hi, as QDÕs high/bank		plb				; bogus		plb				; QDÕs screen bank; end djb/rdl fix		rts		ENDP;///////////////////////////////////////////////;	   Draw	clipboard window content.;///////////////////////////////////////////////;;  This	routine	can be called from outside the Finder at the most;  inopportune times.  Therefore, I try	to save	global values.;;///////////////////////////////////////////////;		EXPORT	clip_guts;clip_guts	PROC;;		jsr	saveAcross;		;;;; --- Get clipboard window's RECT -------------------------------;;;		jsr	pushrect;		_GetPortRect;;		jsr	pushrect		;added 10-Nov-90 DAL;		_EraseRect			;added 10-Nov-90 DAL;;;;; --- Draw scrap picture ----------------------------------------;;;		pha				Space for result.;		pha;		pea	1			Try for	a picture first.;		_GetScrapHandle;		pla				Get handle.;		plx;		bcs	next;;;		phx				Pass Handle of picture.;		pha;;		jsr	derefHand		temp = (temp).;;		ldy	#8;lop1		lda	[<temp],y;		tyx;		sta	<dRect-2,x;		dey;		dey;		bne	lop1;;		lda	<dRect+y2		Adjust destination to be upper left;		sec				corner of window.;		sbc	<dRect+y1;		sta	<dRect+y2;		stz	<dRect+y1;;		lda	<dRect+x2;		sec;		sbc	<dRect+x1;		sta	<dRect+x2;		lda	<dRect+x1;		and	#1;		sta	<dRect+x1;		beq	ok2;		inc	<dRect+x2;;ok2		jsr	pushrect		Pass destination RECT.;		_DrawPicture;		bra	exit;;;;; --- Print scrap text -----------------------------------------;;;next		pha				Space for result.;		pha;		pei <zero			Try for	text next.;		_GetScrapHandle;		pla				Get handle.;		plx;		bcs	exit;;		sta	<temp;		stx	<temp+2;					;		pha				Space for result.;		pha;		phx				Pass handle.;		pha;		_GetHandleSize			Get size handle, which is size of text.;		plx;		pla				(Don't need high word.);;		ldy	#4			Lock text handle.;		lda	[<temp],y;		pha				(Save handle's state.);		ora	#$8000;		sta	[<temp],y;;		dey;		dey;		lda	[<temp],y		Pass pointer to	text.;		pha;		dey;		dey;		lda	[<temp],y;		pha;		phx				Pass length of text.;		PushLong #textRect		; Pass pointer to RECT. Mensch 5/31/89 BRC #49178;		pei <zero			Left justify.;		_LETextBox2;;		ldy	#4			Restore	text handle's state.;		pla;		sta	[<temp],y;;exit		jsr	backAcross;		rtl;textRect	dc.W	2,4,16000,500		; Need valid static rect.  Mensch 5/31/89 BRC #49178;		;		ENDP;==============================================;	Draw a lock icon in a window		;added 06/07/88 DJB;; IN:	a = 0 to erase lock, non zero to draw lock;	(hi bit set to draw inverted lock);	x = horizontal start position;	y = vertical start position;==============================================DrawDevLock	PROC	EXPORT		pha		sty	PictYX			;set up rect		stx	PictYX+2		sty	PictRect2+y1		tya		clc		adc	#lockHeight		sta	PictRect2+y2		stx	PictRect2+x1		txa		clc		adc	#lockWidth		sta	PictRect2+x2		pla		beq	erase		and	#$8000		tax				; save mode		PushLong #PictInfo		; image		PushLong #PictRect		PushLong PictYX		phx				; draw mode		_PPToPort		bra	exiterase		PushLong #PictRect2		;erase the lock		_EraseRectexit		rtsPictInfo	DC.W	$0080				;port SCB		DC.L	PictLock			;picture ptr		DC.W	4				;picture width (bytes)PictRect	DC.W	0,0,lockHeight,lockWidth	;bounds rectPictYX		DC.W	0,0				;coordinatesPictRect2	DC.W	0,0,0,0		PictLock 				DC.B  $FF,$F0,$0F,$FF		;8 x 16 pixel lock image		DC.B  $FF,$0F,$F0,$FF		DC.B  $FF,$0F,$F0,$FF		DC.B  $F0,$00,$00,$0F		DC.B  $F0,$00,$00,$0F		DC.B  $F0,$00,$00,$0F		DC.B  $F0,$00,$00,$0F		DC.B  $FF,$FF,$FF,$FF		ENDP		;==============================================;	Draw Access Priv. Icons			;added 12/17/88 DJB;; IN:	x,y-reg  have point to start drawing;	a-reg has access rights of folder; OUT:	x-reg has end of drawing;==============================================DrawAccessIcons	PROCiconWidth	SET	28iconHeight	SET	7apSeeFolders	SET	1apSeeFiles	SET	2apMakeChanges	SET	4		sta	Access		sty	PictYX+y1			; set up rect		stx	PictYX+x1				lda	Access		and	#apSeeFolders		bne	next1				; user has see folder rights		lda	#FolderPicture		ldx	#FolderPicture>>16		jsr	drawIt		next1		lda	Access		and	#apSeeFiles		bne	next2				; user has see file rights		lda	#FilePicture		ldx	#FolderPicture>>16		jsr	drawIt		next2		lda	Access		and	#apMakeChanges		bne	done				; user has make change rights		lda	#PencilPicture		ldx	#FolderPicture>>16		jsr	drawItdone		ldx	PictYX+x1				rts		;------------------------------------------------------drawIt		sta	PictImage		stx	PictImage+2		PushLong #PictInfo		PushLong #PictRect		PushLong PictYX		PushWord #$0000				; draw mode		_PPToPort				lda	PictYX+x1		clc		adc	#iconWidth+2		sta	PictYX+x1		rts;------------------------------------------------------Access		DC.W	0				; access rightsPictInfo	DC.W	$0080				; port SCBPictImage	DC.L	FolderPicture			; picture ptr		DC.W	iconWidth/4			; picture width (bytes)PictRect	DC.W	0,0,iconHeight,iconWidth	; bounds rectPictYX		DC.W	0,0				; point 	FolderPicture	DC.B	$44,$F0,$00,$0F,$FF,$FF,$FF	;8 x 16 pixel lock image		DC.B	$FF,$44,$FF,$F0,$00,$00,$FF		DC.B	$FF,$0F,$44,$FF,$FF,$FF,$0F		DC.B	$FF,$0F,$FF,$44,$FF,$FF,$0F		DC.B	$FF,$0F,$FF,$FF,$44,$FF,$0F		DC.B	$FF,$0F,$FF,$FF,$FF,$44,$0F		DC.B	$FF,$00,$00,$00,$00,$00,$44FilePicture	DC.B	$44,$FF,$00,$00,$0F,$FF,$FF		DC.B	$FF,$44,$0F,$FF,$00,$FF,$FF		DC.B	$FF,$FF,$44,$FF,$00,$0F,$FF		DC.B	$FF,$FF,$0F,$44,$FF,$0F,$FF		DC.B	$FF,$FF,$0F,$FF,$44,$0F,$FF		DC.B	$FF,$FF,$0F,$FF,$FF,$44,$FF		DC.B	$FF,$FF,$00,$00,$00,$0F,$44PencilPicture	DC.B	$44,$FF,$FF,$FF,$00,$00,$FF		DC.B	$FF,$44,$FF,$F0,$00,$0F,$FF		DC.B	$FF,$FF,$44,$0F,$F0,$FF,$FF		DC.B	$FF,$FF,$FF,$44,$0F,$FF,$FF		DC.B	$FF,$FF,$F0,$FF,$44,$FF,$FF		DC.B	$FF,$FF,$F0,$00,$FF,$44,$FF		DC.B	$0F,$00,$00,$FF,$FF,$FF,$44		ENDP		;===============================================;	   Handle button down in;	   window's content or desktop.;===============================================;;   IN:	   TaskData = window that button went down in.;	   yrat	= y position of	button down, in	global.;	   xrat	= x position of	button down, in	global.;;===============================================		EXPORT	windClickwindClick	PROC		IMPORT 	pushTask		IMPORT	doAlertWindow		IMPORT	selectionIsChanging		IMPORT	isReadOnly		IMPORT	findDisk		IMPORT	BuildPath3		IMPORT	GetWindPath		IMPORT	GetVolSizes		IMPORT	UpdateRootSize				IMPORT	magicToDo		;in data.aii - 18-Jan-93 JCM		IMPORT	_VolumeChange		;in main.aii - 19-Jan 93 JCM		jsl	selectionIsChanging	;tell extensions selection is about to change		stz	OkToRename		; --- Change current window plane -----------------------------------------*** opt 7-Jul-92 DAL		lda <TaskData+1		cmp <curWind+1		beq ok1*** end 7-Jul-92		jsr	deselectall		;Deselect everything in current plane.		jsr	pullTaskData		;curWind = TaskData.ok1;; --- Hit test window's icon list --------------------------------------;		jsr	getWoffset		;Switch to current port, set origin.		jsr	pushyrat		;Make position of button down local.		_GlobalToLocal		lda	#hitTest		;Check for button down on icon.		jsr	walkOfLife		bcc	notDoubleClick		;On an icon or miss?		lda	<when			;Time of this click.		sec		sbc	<lastClick		;less time of last click,		tax		lda	<when+2		sbc	<lastClick+2		bne	iconHit		cpx	doubleSpeed		;equals time inbetween.		bcs	iconHit			;Is it a double click?		lda	lastClickY		;Is position of new click near last?		sec		sbc	<yrat		clc		adc	#2		cmp	#7		bcs	iconHit		lda	lastClickX		sec		sbc	<xrat		clc		adc	#3		cmp	#11		bcs	iconHit		jsr	endDraw			;Put window's port back.		jsr	norename		;Remove line edit field.		jsr	startDraw		;Set up window's port again. 		jsr	unlockic		;Leave the icon unlocked.		jsr	endDraw			;Return window's origin to 0,0.;; Tunneling, do they want to OPTION double-click to close the parent and open the child?;		pha		pei <zero			;we want to know if they are		jsr	pushTask		;holding down the option key for anti-tunneling		_GetNextEvent		pla		jsr	openAll			;open all the selected icons and exit				lda	modifiers		;did they want to tunnel?		and	#$0800		beq	@done				jsr	doClose			;put away the parent			@done		rts;; If they get here we haven't received notice of a double click (yet) and we also didn't hit; an icon;notDoubleClick		lda	<LErename+1		;Check if user pressed inside rename box.		beq	ok19			;Is there a line edit field?		pha				;Space for result.		jsr	pushyrat		;Pass pointer to point.		pea	viewRect>>16		pea	viewRect		;Pass pointer to RECT.		_PtInRect		pla		bne	inRename		;Handle button down in rename.		jsr	endDraw			;Put window's port back.		jsr	norename		;Remove line edit field.		jsr	startDraw		;Set up window's port again.ok19		brl	downInCont		;Button down on content region.;; They get here then there's been a hit on an icon, but not a double click (yet), so check; exactly where they hit;iconHit		lda	nameHit			Was it a hit in	the icon's name?		beq	ok11		lda	<LErename+1		Is there a line	edit field?		beq	ok2		lda	<icHand			Is it a	hit on the icon	being renamed?		cmp	LEicon		bne	ok11		lda	<icHand+2		cmp	LEicon+2		bne	ok11inRename	jsr	hitIconName		Handle button down in line edit	field.		brl	endDraw			Return window's origin and exit.ok11		lda	<LErename+1		Is there a line	edit field?		beq	ok2		jsr	endDraw		jsr	noRename		Cancel rename if there is a hit		jsr	startDraw		outside	of the line edit field.		;; --- Button down on an	icon to	select it ------------------------------;ok2		lda	<when			;Save time of this click for next time.		sta	<lastClick		lda	<when+2		sta	<lastClick+2		lda	<yrat			;Save position of click.		sta	lastClickY		lda	<xrat		sta	lastClickX;; If Shift key is down:;	   Do not deselect other icons.;	   Flip	state of icon hit.; Else:;	   Deselect all	icons if hit icon is not yet selected.;	   Select icon hit.;;; ------ Check Shift key ------------------------------------------------;		lda	<modifiers		Shift key down?		and	#shiftKey		bne	shiftDown;; --------- Shift key NOT down ---------------------------------------;		ldy	#icFlag			Is the icon hit	already	selected?		lda	[<ic],y		and	#ICSELECTED		bne	skip2			If selected, don't deselect others.		pei	<icHand+2		Save handle of icon that was hit.		pei	<icHand		lda	#officon		Deselect all icons in window.		jsr	walkBack		pla		sta	<icHand		pla		sta	<icHand+2		jsr	lockic			Lock the icon.;;;		inc	OkToRename		*** 3-Jun-92 DAL -- try only renaming if they click on the name field		lda	nameHit		sta	OkToRename*** end 3-Jun-92		ldy	#icFlagskip2		lda	[<ic],y		ora	#ICSELECTED		Set selected flag.		bra	store4;; --------- Shift key down -------------------------------------------;shiftDown	ldy	#icFlag			Flip the state of the icon.		lda	[<ic],y		eor	#ICSELECTEDstore4		sta	[<ic],y;; ------ Move the selected icon	to the head of the list	----------------;*** Added - 22-Jan-93 JCM - Moved this code into a subroutine so key nav and the new***			    active icon selection code can call it as well.;;;		ldy	#icLast+1		Already	at head	of list?;;;		lda	[<ic],y;;;		beq	hiliteit;;;;;;		jsr	cutIcon			Remove icon from list.;;;		jsr	HeadIcon		Add icon at head of list.		jsr	cutIconToHead*** End - 22-Jan-93 JCM;; ------ Redraw	the icon in its	new plane and state -------------------;hiliteit	jsr	drawIcon2; -----------------------------------------------------------------------; --- Wait to see if user dragging or just selecting --------------------; -----------------------------------------------------------------------;;   current port = window that button is down in (origin set).;   yrat = y position of button	down (local to window).;   xrat = x position of button	down (local to window).;   curWind = window button went down in.;   TaskData = window button went down in.;   windBlk = pointer to information block of window button went down in.;   icHand = handle of icon button was pressed on (locked).;   ic = (icHand).;		ldy	#icFlag			Only drag selected icons.		lda	[<ic],y		and	#ICSELECTED		beq	exitDragckdrag		lda	#4			Button up only.		jsr	getNextEvent		beq	doubleCk		Button up?exitDrag	lda	OkToRename		beq	realexit		jsr	makeField		; make a line edit fieldrealexit	jsr	unlockic		; unlock ICONOBJ and exit*** added 19-Aug-92 DAL -- Don't call SelectWindow on the desktop port		lda	<TaskData+1		cmp	<deskPort+1		beq	@noSelect*** end 19-Aug-92		pha				;see if our front window is the window we're doing		pha				;stuff in, and if it is, skip the selectwindow to 		_FrontWindow			;increase the speed of response... (Gee, could TaskMaster		pla				;do this internally for other apps Dave?).		plx		cmp	<TaskData		bne	@selectIt		cpx	<TaskData+2		beq	@noSelect		@selectIt	pushZLong <taskData		_SelectWindow@noSelect	brl	endDraw;; --- Button has not come up yet, but double check ----------------------;doubleCk	pha		pei <zero			;Button number.		_Button				;Is the button currently up?		pla		beq	exitDragckNewPos	lda	|eventRec+modifier	;Save state of function key.		and	#$0800		ora	functionKey		sta	functionKey		jsr	pushwork		;Pass place to store rat position.		_GetMouse		lda	#6			;Number of pixels needed to move.		sta	<work+4		ldx	#2lop5		lda	<work+y1,x		sec		sbc	<yrat,x		bcs	ok5		eor	#$FFFF		inc	aok5		cmp	<work+4			;Did the user move?		bcs	dragit		lsr	<work+4			;Half delta needed for vertical.		dex		dex		bpl	lop5		bra	ckdrag; ----------------------------------------------------------------------; --- Drag the icon around ---------------------------------------------; ----------------------------------------------------------------------;;   current port = window that button is down in (origin set).;   yrat = y position of button	down (local to window).;   xrat = x position of button	down (local to window).;   curWind = window button went down in.;   TaskData = window button went down in.;   windBlk = pointer to information block of window button went down in.;   icHand = handle of icon button was pressed on (locked).;   ic = (icHand).;; ----------------------------------------------------------------------dragit		ldy	#windView		Remember view of source	window.		ldx	<zero		lda	[<windBlk],y		sta	sourceView		cmp	#viewByName		bcc	store1		dexstore1		stx	srcView		jsr	buildRectList		rectHand = handle of RECT list.;; Historical Notes: 	We're doing a SetOrigin(0,0) here because there seem to be mysterious circumstances;			under which a code path ends up here and the window is still in the shifted "StartDraw";			state.  This should fix the weird disconnected scroll bar/shifted visrgn;			problems we've been seeing.;;			2/9/92, The day before SCM builds the 6.0 Golden Master.  Dave and andy, up-all-night.;				Btw, I paid Matt Ackeret $100 for being able to duplicate this.  Really.;		jsr	endDraw			;ACK!!!!!				pushZLong <deskport		;Switch to desktop port.		_SetPort		stz	<drawCount		Number of times	the RECTs are drawn.		stz	<IconTrack+1		Handle of icon cursor is over.		jsr	cur2windT		windTrack = curWind.		stz	ExtCopy			Turn off extended flag.		pha				Space for result.		jsr	pushrect		Pass address of	RECT to	drag.		pushlong #screen		Pass address of	screen RECT.		jsr	pushrect		RECT to	drag shouldn't be larger		_SectRect			than the screen.		pla				Result,	TRUE if	RECT not empty (always).		pha				Space for result.		pha		pushlong #dragRects		;Address of custom draw routine.		pushlong #dragPatt		;Pass address of drag pattern		lda	<xrat			Pass starting y	point as global.		clc		adc	<xoffset		pha				Pass starting x	point as global.		lda	<yrat		clc		adc	<yoffset		pha				Pass starting y	point.		jsr	pushrect		Pass address of	RECT to	drag.		pushlong #screen		;Pass limit bounds		pushlong #screen		;Pass slop bounds.		pea	$0288			2 pixel	grid, pass draw	flag, custom draw.		_DragRect		pla		sta	deltay			Save y delta.		sta	deltay2		pla		sta	deltax			Save x delta.		sta	deltax2; --- Check what function key is at end	of drag	----------------------------		jsr	addFunctionKey; --- Free RECT	list, compute selected icon area ---------------------------		pushZLong <rectHand		;Free handle to RECT list.		jsl DisposeHandleGlue; --- Compute source and destination information ----------------------------		stz	<filetype		Destination filetype.		stz	intoIcon		Clear 'dragging into icon' flag.		stz	magicToDo		;assume that this isn't the System folder - 18-Jan-93 JCM		lda	<IconTrack+1		Was a destination icon selected?		beq	skip4		jsr	getDesIcon		Compute	parameters for destination icon.				      		;windTrack = des icon's window.		inc	intoIcon		Set 'dragging into icon' flag.skip4		; if the windTrack is zero and IconTrack is zero we must have aborted; (old way commented out below).		lda	<WindTrack+1		ora	<IconTrack+1		beq	exit4;		lda	deltax			Was drag aborted? (dragged into	menubar);		ora	deltay;		beq	exit4			If yes,	then quit.		lda	<windTrack		;Is the destination also the source?		cmp	<TaskData		bne	skip15		lda	<windTrack+1		cmp	<TaskData+1		bne	skip15						;Destination window is same as source.		lda	<IconTrack+1		;Was user dragging to the same window's		beq	skip13			;icon?						;User must be confused, so quit the drag.exit4		brl	pullTaskData		;curWind = TaskData (source window).skip13		stz	<windTrack+1		;Same window plane flag.;; --- Set filetype to desktop if dragging to the desktop --------------------;skip15		lda	<windTrack		;Is destination window the desktop?		cmp	<deskport		bne	skip9		lda	<windTrack+1		cmp	<deskport+1		bne	skip9		lda	#1			;Copy to desktop flag.		sta	ExtCopy			;Destination will be an extended icon.		stz	<filetype		;Set destination type to desktop.skip9		jsr	pullTaskData		curWind	= TaskData (source window).;; --- Is the destination window	a disk directory? --------------------------- ;		lda	<iconTrack+1		Is there already a destination icon?		bne	skip16			bra if so		lda	<windTrack+1		Is there a destination window to check?		beq	skip16			bra if not		lda	BadDes			Is the destination wdw ok to go to?		bne	skip16			bra if bad dest - not ok		lda	<windTrack		ldx	<windTrack+2		jsr	getwRefCon2		windBlk	= destination wind's info block.		ldy	#windIC+2		Handle of icon that opened into	window.		lda	[<windBlk],y		tax		dey		dey		lda	[<windBlk],y		bne	ok16		txy		beq	skip16ok16		sta	<iconTrack		Save handle, just in case.		stx	<iconTrack+2		jsr	derefHand		temp = pointer to icon.		ldy	#icFType		Is dest window from a disk?		lda	[<temp],y		sta	<filetype		bpl	done16			bra if dest wdw is from a folder		cmp	#TypeFTrash		device of some type		bcc	ok17			bra if not trash		jsr	desIsTrash				bra	skip16ok17		ldy	#icFlag			Is icon	really open?		lda	[<temp],y		and	#ICOPENED		bne	skip16			bra if dest icon is open as wdw icon done16		stz	<iconTrack		Not a disk icon.		stz	<iconTrack+2		lda	#TypeFolder		Window must have come from a folder.		sta	<filetype;; --- Make sure	there aren't any drag conflicts ----------------------------;skip16		jsr	ckConflicts		Check for drag conflicts.		bcc	ok10			Drag error?		stz	ExtCopy		rts				Quit drag if error.;; --- Recompute	the deltas if moving to	a new window plane ------------------;ok10		lda	ExtCopy			;if icon is going to trash or desktop, don't		bne	@skip			;empty the trashcan... allow items to accumulate in trash				lda	<iconTrack+1		;if we're going into an icon, empty it		bne	@newPlane				lda	<windTrack+1		;not going into an icon, and if we also aren't going into		beq	@skip			;a window, don't empty it				lda	<windTrack		;Is the destination also the source?		cmp	<TaskData		;if the destination window is the same as the source window,		bne	@newPlane		;don't empty the trash		lda	<windTrack+1		cmp	<TaskData+1		beq	@skip@newPlane	lda	<TrashWind		;do not empty Trash if source		cmp	<TaskData		;is the Trash.		bne	@empty		lda	<TrashWind+1		cmp	<TaskData+1		beq	@skip@empty		jsr	EmptyTrashMenu@skip		jsr	makeDesPos		;Compute destination point.						;deltay & deltax = icon's position change.		stz	diffVolumes		init: source & dest vols are the same;; --- Before calling CopyFiles,	make sure it is	a copy file ------------------;		lda	ExtCopy			;Extended copy?		beq	@notExtended		;Not a disk copy if extended.		brl	skipCopy		;but don't bring the window to the front		@select		pushZlong <taskData		_SelectWindow		brl	skipCopy@notExtended				lda	<windTrack+1		;Just moving within the same window?		ora	<IconTrack+1		beq	@select			;If yes, no need to copy.		lda	<filetype		beq	RegularProgram		;bra if ???   (dragging to desktop, I think 7-Jul-92 DAL)		bmi	RegularProgram		;bra if a device of some type	;		; Now, we know we are going to a destination icon -- is it a drop folder?;		lda	<iconTrack+2		sta	<icHand+2		lda	<iconTrack		sta	<icHand		jsr	SetIc			;deref ichand				ldy	#icFileInfo		lda	[<ic],y		cmp	#$0004			; is it a drop box?		bne	RegularProgram;; Now we are going to a drop box;		lda	#rasCantSee		jsl	doAlertWindow		bne	regularProgram		sec				; cancel drag		rtsRegularProgram		lda	<filetype		;Is there a destination icon?		bpl	doCopy			;Not if zero. Copy files if dest is a folder?		lda	dragDisk		;Is a disk being dragged to the disk?		bne	skipCopy		;If so, it's a dup disk.;; Copy files being dragged;doCopy		jsr	copyFiles		sets diffVolumes if source/dest vols diff*** Added - 19-Jan-93 JCM - This forces all of the open windows on the boot volume (the one we just***			    magic routed files on) to update. It's a heck of a lot smaller than***			    trying to remember the individual windows to update, and it's a lot***			    more reliable as well.		IMPORT	GetBootVolume		import	c1_bootname		import	WStringCopy		lda	magicToDo		;did we do any special routing?		beq	noRouting		jsl	GetBootVolume		;for UpdateBootWindows so we only need to call this once		PushLong #c1_bootname		PushLong #C1_PathName		jsl	WStringCopy		lda	#DirWindID		; find all directory windows		ldx	#UpdateBootWindows		; from the boot volume only		jsr	walkWindow		clc				rts		*===============================================** Update All Directory Windows for the Boot Volume	**						** Called by walkWindows				*		*===============================================*UpdateBootWindows NAME		IMPORT	UpdateWindow		IMPORT	matchRootName		jsr	matchRootName		bcc	@nextWindow		jsr	UpdateWindow		; update this window always@nextWindow	clc				; continue flag		rtsnoRouting	lda	diffVolumes*** end - 19-Jan-93 JCM		beq	@notCopy				lda	<iconTrack+1		beq	@notCopy		lda	<windTrack+1		bne	@notCopy		lda	<iconTrack		sta	<icHand		lda	<iconTrack+2		sta	<icHand+2				jsr	setic			;deref it without locking it				ldy	#icDisk					lda	[<ic],y		sta	<icHand		iny		iny		lda	[<ic],y		sta	<icHand+2				jsr	lockic				ldy	#icFlag		lda	[<ic],y		and	#icOffline		bne	@notCopy				jsr	makeIcRoot		;pathname = separator + icName.				jsr	GetVolSizes		jsr	UpdateRootSize		jsr	unlockic		@notCopy	jsr	updateKs		Update info bars and info windows for all windows in path.skipCopy	jsr	pullTaskData		curWind	= TaskData (source window).;;  curWind = source window plane.;  windTrack = destination window plane.  windTrack+1 =	zero if	none.;  IconTrack = destination icon	if no destination window, zero if none.;; Set up for creating extended icons;		ldx	ExtCopy			Is the destination the desktop or Trash?		beq	skip1			If yes,	I need the source pathname.		lda	dragDisk		No need	for all	this if	dragging disks.		bne	skip1		lda 	<curWind		;if this is from the desktop, no way to		cmp	<deskPort		;get a source		bne	@notToTrash		lda	<curWind+2		cmp	<deskPort+2		beq	toTrash		@notToTrash	jsr	getwRefCon		windBlk	= source window	info block.		jsr	getWindPath		pathname = pathname in current info block.		jsr	path2ticon		ticonobj+icOwner = pathname.		jsr	pullTaskData		curWind	= TaskData (source window).		lda	ExtCopy			;Is the destination the Trash?		bpl	skip1			;no...toTrash		jsr	doRemove		Check if locked	files are being	tossed.		bcc	skip1			Did user cancel	operation?		sec		stz	ExtCopy			Turn extended copy off.		rtsskip1		jsr	pullTaskData		curWind	= TaskData (source window).		jsr	getwRefCon		windBlk	= current window's info block.				ldy	#windView		;Redraw only needed if view by icons.		lda	[<windBlk],y		cmp	#viewByName		bcs	@skip		lda	diffVolumes		;don't redraw if diffVolumes		bne	@skip		jsr	buildRects		Build region of	selected icons.@skip;; rdl 4/13/90: fix BRC# 49639 / WS# DTS 89.0301 (also see fixes below below); bug: names with illegal chars are copied to ProDOS, where new icon has illegal name; fix: the following code avoids drawing the new icon if volumes are different;    by sending the var dontDraw to findSelect / moveIcons;		lda	diffVolumes		;if diff volumes:		sta	dontDraw		;  redraw icons later (below)				lda	#moveIcons		;Reposition all the selected icons.		jsr	findSelect		stz	dontDraw		;reset dontDraw var;; --- Recompute	info bar for source window if the source window had something stolen -------;		lda	DeleteFlag		;Were any files deleted from source?		beq	skip401		stz	DeleteFlag		;Reset flag.		lda	<curWind		;Recompute info bar for source window.		ldx	<curWind+2		jsr	commonSetInfo;; --- Compute the region that needs to be redrawn ---------------;skip401		stz	ExtCopy			;Turn off extended flag.		jsr	getwRefCon		;Get source window's info block.		ldy	#windView		;Redraw only needed if view by icons.		lda	[<windBlk],y		cmp	#viewByName		bcs	@skip		lda	diffVolumes		;don't redraw if diffVolumes		bne	@skip		jsr	offsetRgn@skip;; --- Redraw source window --------------------------------------------;				ldy	#windView		;Redraw only needed if view by icons.		lda	[<windBlk],y		cmp	#viewByName		bcs	skip12		lda	diffVolumes		;don't redraw if diffVolumes		bne	skip12		jsr	redrawList		;Redraw region in 'rectRgn'.		bra	setDataskip12		jsr	freeRectRgn		;Free the regions.setData		lda	<curWind		ldx	<curWind+2		jsr	newDataSize		;Recompute source window.;; If there's no destination window, or if the destination window somehow got closed, don't do; anything at all, just leave...;		lda	<windTrack+1		beq	done		lda	<windTrack		ldx	<windTrack+2		jsr	newDataSize		;Recompute dest window.;; rdl 4/13/90: fix BRC# 49639 / WS# DTS 89.0301  (also see fix above); bug: names with illegal chars are copied to ProDOS, where new icon has illegal name; fix: UpdateWindow causes the new icon to be redrawn with its translated name;         (if catalog names and icon names donÕt match, it calls AddWindowIcon);      walkback2 / drawIcon2 redraws ALL the icons in the window;		lda	<windTrack		;Recompute info bar for dest window.		ldx	<windTrack+2		jsr	commonSetInfo		lda	<windTrack		ldx	<windTrack+2		jsr	getwRefCon2		;windBlk=dest wdw's info blk; wind=windTrack		ldy	#windView		lda	[<windBlk],y		cmp	#ViewByName		bge	@alwaysUpdate				lda	diffVolumes				beq	done			;bra if same volume: no action necessary		@AlwaysUpdate	lda	<windTrack		ldx	<windTrack+2		jsr	getwRefCon2		;windBlk=dest wdw's info blk; wind=windTrack		jsr	UpdateWindow		; update window to reflect new names				lda	<windTrack		ldx	<windTrack+2		jsr	getwRefCon2		;windBlk=dest wdw's info blk; wind=windTrack		sta	<icHand			;  store off handle to first ICONOBJ		stx	<icHand+2		pei	<wind+2			;switch drawing plane to our window		pei	<wind		_StartDrawing		lda	#drawIcon2		;inputs: ic = ptr to ICONOBJ; windBlk		jsr	walkback2		;draw all icons (converts icHand -> ic)		jsr	endDraw			;restore drawing coords to 0,0done		rts; end of rdl 4/13/90 fix;-----------------------------------------------;   IN:	   curWind = window to remove from.; ckDelFlag no longer in use (artifact of having had a Remove menu item in distant past); removed 2/15/90 rdl:  always 0 coming in here, so replaced with 0;	   (ckDelFlag = flag to pass to DeleteFiles:;			Bit 0 =	0 to just check	if files can be	deleted.;				1 to actually delete files.;			Bit 15 = 0 to process the entire list.;				1 to process only the icon passed.);;  OUT:	   Carry set if	user cancelled.;;-----------------------------------------------doRemove	jsr	getwRefCon		;windBlk = current window's info block.		ldy	#windID			;Removing from a directory window?		lda	[<windBlk],y		cmp	#DirWindID		beq	ok66;; --- Remove from Trash, remove extended icons ;		lda	#removeExt		jsr	walkOfLife3		;Must walk forward!		rts				;Remove all the deleted icons.;-----------------------------------------------removeExt		ldy	#icFlag			;Is this icon extended and selected?		lda	[<ic],y		and	#ICEXTENDED+ICSELECTED		cmp	#ICEXTENDED+ICSELECTED		clc		bne	exit67		jsr	getExtName		;C1_PathName = ic's icOwner field.		bcs	exit67			;Pathname error?		pei	<icHand+2		;Pass handle of icon to delete.		pei	<icHand		pea	C1_PathName>>16		;Pass pathname of owner window.		pea	C1_PathName		pei	<zero			;Pass flag not to do real remove.		ldx	#xDeleteFiles		jsl	FileEntryexit67		rts				;return error from xDeleteFiles.;; --- Normal icon remove ------------------------;ok66		jsr	getWindPath		;C1_PathName = pathname of current window.		ldy	#windIcons+2		lda	[<windblk],y		pha		lda	[<windblk]		pha		pea	C1_PathName>>16		pea	C1_PathName		pei <zero			;Pass flag not to do real remove.		ldx	#xDeleteFiles		jsl	FileEntry;--- Remove all deleted icons -----------------				rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Set curWind with TaskData.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;  OUT:	   curWind = TaskData.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =pullTaskData		lda	<TaskData		;Switch to new current plane.		sta	<curWind		lda	<TaskData+2		sta	<curWind+2		rtsOkToRename	DC.W	0; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Button down in directory window's;	   content, but	not on an icon.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   current port	= window that button is	down in	(origin	set).;	   yrat	= y position of	button down (local to window).;	   xrat	= x position of	button down (local to window).;	   curWind = window button went	down in.;	   TaskData = window button went down in.;	   modifiers = state of	modifier keys.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =downIncont*** Experiment - 21-Jan-93 JCM - I'm now using the IcVisited bit during active selection to indicate***				 whether the icon was in the previous selection rectangle. The bit***				 shouldn't be set when we get here, but as Dave said, a little***				 paranoia never hurt anyone.		lda	#clearAllVisited	;clear all <curWind icons ICSELECTED bit		jsr	walkOfLife		*** End - 21-Jan-93 JCM		lda	<modifiers		;Shift key down?		and	#shiftKey		bne	skip600			;If yes, don't deselect others.		lda	#officon		;Deselect all icons in window.		jsr	walkBack*** added 19-Aug-92 DAL -- Don't call SelectWindow on the desktop port		lda	<TaskData+1		cmp	<deskPort+1		beq	@noSelect*** end 19-Aug-92		pushZLong <taskData		;bring it to front since we're doing		_SelectWindow			;absolutely squat@noSelect;		; --- Allow user to drag open a	rubber-band box	-------------------------;skip600		lda	<yrat			Initialize starting rubber-band	box.		sta	<dRect+y1		sta	<dRect+y2		lda	<xrat		sta	<dRect+x1		sta	<dRect+x2*** Experiment - 20-Jan-93 JCM - Active selection - whooo! :-);;		PushPtr DragPortRect;;		_GetPortRect		pha		pha				;for final deltas		pushlong #activeDragRect	;address of custom action procedure;;;		lda	<zero;;;		pha				Pass no	action procedure.;;;		pha*** End - 20-Jan-93 JCM		pea	DragPatt>>16		Pass address of	drag pattern		pea	DragPatt		pei	<xrat			Pass starting point.		pei	<yrat		jsr	pushrect		Pass address of	RECT to	drag.		pea	screen2>>16		Pass limit bounds.		pea	screen2		pea	screen2>>16		Pass slop bounds.		pea	screen2		pea	$0124			;one pixel, return RECT, rubber-band		_DragRect		pla				;deltas aren't needed		pla						;rect = rubber-band RECT;; ------ Select	all icons within the rubber-band box ------------------;		stz	iconSelected		Mark 'no icons selected' flag.		lda	#ckRects		;actually, just see if any icons were selected actively;;;		jsr	walkBack		;28-Jan-93 JCM - This is a bit speedier, and since we now are not		jsr	walkOfLife		;28-Jan-93 JCM - selecting icons here, we'll have no problems		lda	iconSelected		Were any icons selected?		bne	exit600; --------- Select the icon that the window came from ----------------		jsr	ifDesk			Nothing	to select if on	the desktop.		beq	exit600		jsr	endDraw			Return selected	window to 0,0 origin.		ldy	#windIc			Get the	icon that the window came from.		lda	[<windBlk],y		sta	<icHand		iny		iny		lda	[<windBlk],y		sta	<icHand+2		jsr	lockic		ldy	#icMom			Switch to that icon's window.		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2		jsr	getwRefCon		windBlk	= window's info block.		ldy	#icFlag			Select it.		lda	[<ic],y		ora	#ICSELECTED		sta	[<ic],y		jsr	startDraw		jsr	drawIcon2		Draw it	in its new state.		jsr	unlockicexit600		brl	endDraw			Return window to 0,0 origin (EXIT).*** Experiment - 20-Jan-93 JCM - Make sure all icons have this bit clear before we start.clearAllVisited	ldy	#icFlag+2		lda	[<ic],y		and	#Å(ICVISITED)>>16	;clear visited bit		sta	[<ic],y				clc				;check all icons		rts****************************************************************************************** activeDragRect - This code is called as a custom action procedure by DragRect above.*		   It handles auto icon selection much like Macintosh System 7 Finder.*		   Its work-horse code is the walkOfLife-called function, 'checkActiveRects',*		   which directly handles the icon selection/deselection.*activeDragRect			IMPORT	QDBank		IMPORT	FinderDPage	@longReturn	equ	$4@dataBank	equ	$3@directPage	equ	$1top		equ	0left		equ	2bottom		equ	4right		equ	6		phd				Save original direct page.				phb				Save original data bank.		phk				Switch to my data bank.		plb		lda	FinderDpage		Switch to my direct page.		tcd		;;		PushPtr	CurMouseLoc;;		_GetMouse		;;		pha;;		PushPtr	CurMouseLoc;;		PushPtr	DragPortRect;;		_PtInRect;;		pla;;		bne	@noScrolling;;		ldy	#0			;vert scroll distance;;		tyx				;horz scroll distance		;;		lda	DragPortRect+bottom;;		cmp	CurMouseLoc+top;;		bge	@noVertScrolling;;		bmi	@goingDown		;;		ldy	#-2		;;@goingDown	iny		;;@noVertScrolling lda	DragPortRect+right;;		cmp	CurMouseLoc+left;;		bge	@checkScroll;;		bmi	@goingRight		;;		ldx	#-4		;;@goingRight	inx;;		inx		* Now that we've checked in both the horizontal and vertical directions for scroll deltas, lets see if we* actually have non-zero deltas. If we don't, then skip the scroll stuff entirely.		;;@checkScroll	tya		;;		bne	@goScroll		;vertical is non-zero, so scroll		;;		txa;;		beq	@noScrolling		;whoops, vert is zero too, don't scroll;;@goScroll	pea	1			;scroll the content region;;		phx;;		phy;;		jsr	ValidateMove;;		jsr	redrawDragRect		;remove the rect because we don't want splooge on redraw below		;;		pei	<curWind+2		;window to check;;		pei	<curWind;;		_SetContentOrigin2		;;		jsr	redrawDragRect		;remove the rect because we don't want splooge on redraw below@noScrolling	stz	removedDragRect		;we haven't removed the rect yet;;		pei	<curWind+2		;window to check;;		pei	<curWind;;		_StartDrawing				lda	#checkActiveRects	;check all icons to see if any of them are in the		jsr	walkOfLife		; current drag rect		lda	removedDragRect		;did checkActiveRects removed the xor box?		beq	@exitActiveDrag		; nope, don't turn it off accidentally		jsr	redrawDragRect		;turn it back on	@exitActiveDrag	plb				pld		rtl				;return to DragRect.;;ValidateMove	NAME;;		pha;;		pha;;		pei	<curWind+2;;		pei	<curWind;;		_GetContentOrigin;;		pla;;		sta	OrigOrigin+top;;		sta	OrigOrigin+bottom;;		pla;;		sta	OrigOrigin+left;;		sta	OrigOrigin+right;;		pha;;		pha;;		pei	<curWind+2;;		pei	<curWind;;		_GetDataSize;;		pla;;		clc;;		adc	OrigOrigin+bottom;;		sta	OrigOrigin+bottom;;		pla;;		clc;;		adc	OrigOrigin+right;;		sta	OrigOrigin+right		;;		pha;;		pha		;;		lda	9,s			;delta horz;;		clc;;		adc	OrigOrigin+left;;		pha;;		lda	9,s			;delta vert;;		clc;;		adc	OrigOrigin+top;;		pha;;		PushPtr	OrigOrigin;;		_PinRect;;		pla;;		sta	5,s			;new horz origin;;		pla	;;		sta	5,s			;new vert origin		;;		rtsredrawDragRect	pei	<dRect+x1		;get into place		pei	<dRect+y1		_MoveTo		lda	<dRect+x2		;draw top		dec	a		dec	a		pha		pei	<dRect+y1		_LineTo		pea	0			;move down one		pea	1		_Move		lda	<dRect+x2		;draw right		dec	a		dec	a		pha		lda	<dRect+y2		dec	a		pha		_LineTo		pea	-2			;move left two		pea	0		_move		pei	<dRect+x1		;draw bottom		lda	<dRect+y2		dec	a		pha		_LineTo			pea	0			;move up one		pea	-1		_Move		pei	<dRect+x1		;draw left		lda	<dRect+y1		inc	a		pha		_LineTo			rts;;DragPortRect	DS.W	4;;CurMouseLoc	DS.W	2;;OrigOrigin	DS.W	4****************************************************************************************** checkActiveRects - This handles auto icon selection as the DragRect rubber-band*		     is moved about the desktop or within a window. This works just*		     like the Macintosh System 7 Finder.** We do something like this:** - Is icon in current rect?* 	- Yes, was it in the rect last time (ICVISITED = 1)?* 		- No, invert ICSELECTED & ICVISITED, redraw and exit* 		- Yes, icon is already selected, do nothing and exit	**	- No, was it in the rect last time (ICVISITED = 1)?*		- Yes, invert ICSELECTED & ICVISITED, redraw and exit*		- No, icon is already unselected, do nothing and exit** So we don't have cursor splooge on the screen as we hilight and unhilight icons,* we remove the rubber-band selection if the icon we are to redraw now falls within* the rubber-band rectangle. %%% We could make this look a bit better by clipping to* the intersection with the icon we are redrawing.*checkActiveRects		IMPORT	OldCheckRectHit		ldy	#-1			;gets rid of boundary cases where the rect is empty		jsr	InsetDRect		; when the sides coincide		jsr	OldCheckRectHit		;is icon in current rect?		php				;I wish this bloody thing returned status in carry...		ldy	#1			;we shouldn't destroy the rect		jsr	InsetDRect		ldy	#icFlag+2		;previous in-icon status		lda	[<ic],y			plp		beq	@outOfCurRect		; nope, not in the current xor box		and	#ICVISITED>>16		;were we previously in the rect?		bne	@ignore			; yep, no need to redraw it the same way				bra	@invertIt		; nope, we need to change the visible state		@outOfCurRect	and	#ICVISITED>>16		;were we in the rectangle last time?		beq	@ignore			; nope, no need to redraw it the same way* Whatever the icon's visible and in-selection-rectangle state were, make them the opposite, since* we just moved into or out of the selection rectangle.@invertIt	lda	[<ic],y			;icFlag+2		eor	#ICVISITED>>16		;swap in-selection-rectangle-last-time flag		tax		dey		dey		lda	[<ic],y		eor	#ICSELECTED		;swap the current hilight state@saveNewBits	sta	[<ic],y			;icFlag		iny		iny		txa		sta	[<ic],y			;icFlag+2		and	#ICVISITED>>16		;are we still in the rect?		beq	@redrawIcon		; nope, no need to remove drag rect - no splooge possible				bit	removedDragRect		;did we already remove it?		bne	@redrawIcon		; yup, don't turn it back on yet		sta	removedDragRect		;anything non-zero		jsr	redrawDragRect		;remove the rect because we don't want splooge on redraw below		@redrawIcon	jsr	cutIconToHead		;%%% this may be bad if <ic isn't updated				jsr	drawIcon2		;redraw it in its new state@ignore		clc				;walk all of the icons			rtsInsetDRect	pea	0			;gets rid of boundary cases where the rect is empty		tdc				; when the sides coincide		clc		adc	#DRect		pha		phy		phy		_InsetRect		rtsorigDRectLeft	ds.w	1			;17-Mar-93 JCMorigDRectTop	ds.w	1			;2-Apr-93 JCMremovedDragRect	ds.w	1*** End - 20-Jan-93 JCM********************************************************************************************************* ckRects - See if any icons in the current window are selected. If they are, iconSelected will be*	    non-zero, and will contain the count of icons that were selected. As the icons are checked,*	    the IcVisited bit of each is cleared.** NOTE: This is a function that is designed to be called by walkOfLife. *		export	ckRectsckRects		*** Experiment - 20-Jan-93 JCM - So active icon selection above works.;;;		IMPORT	OldCheckRectHit		; JAM 06/04/89  mod of DJB fix:  see util.aii;;;		jsr	OldCheckRectHit		Check if this icon was in the box.;;;		beq	exitck			Was there any intersection?;;;;;;selectit	ldy	#icFlag			Flip the icon's selection state.;;;		lda	[<ic],y;;;		eor	#ICSELECTED;;;		sta	[<ic],y;;;;;;		jsr	drawIcon2		Redraw in new state.*** End - 20-Jan-93 JCMexitck		ldy	#icFlag			Do we end up with any selected icons?		lda	[<ic],y		and	#ICSELECTED		beq	exitck2		inc	iconSelected		There are selected icons in this window.;;;exitck2	rts				;28-Jan-93 JCM - Let's do double-duty and clear all of theexitck2		brl	clearAllVisited		;28-Jan-93 JCM - IcVisited bits while we're walking; = = =	= = = =	= = = =	= = = =	= = =;	   Offset rectRgn.; = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   rectRgn = handle of region to offset.;	   tempRgn = handle of temp region.;	   deltay2 = y offset.;	   deltax2 = x offset.;; = = =	= = = =	= = = =	= = = =	= = =		EXPORT	offsetRgnoffsetRgn				pei	<rectRgn+2		;Clone the original region.		pei	<rectRgn		pei	<tempRgn+2		pei	<tempRgn		_CopyRgn		pei	<tempRgn+2		;Move the region to the new position.		pei	<tempRgn		lda	deltax2			;Delta x.		pha		lda	deltay2			;Delta y.		pha		_OffsetRgn		pei	<rectRgn+2		;Add the region at the starting position		pei	<rectRgn		;to the region at the new position.		pei	<tempRgn+2		;The result is the total area that		pei	<tempRgn		;needs to be redrawn.		pei	<rectRgn+2		pei	<rectRgn		_UnionRgn				jsr	freeTempRgn		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Update window's info;	   and content if view by text.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   a and x = pointer to	window.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =		IMPORT	setInfo		IMPORT	newDataSize2commonSetInfo		cmp	<deskport		Is the window the desktop?		bne	ok500		cpx	<deskport+2		beq	exit500ok500		jsr	setInfo2		ldy	#windView		Resort and draw	destination window if		lda	[<windBlk],y		view is	text.		cmp	#viewByName		bcc	exit500		jsr	redrawText		jsr	newDataSize2exit500		rts*** Added - 22-Jan-93 JCM - This code is now called by key nav and the new active icon selection***			    stuff when an icon is selected.		EXPORT	cutIconToHeadcutIconToHead	ldy	#icLast+1		Already	at head	of list?		lda	[<ic],y		beq	@exitCutToHead		jsr	cutIcon			Remove icon from list.		jsr	HeadIcon		Add icon at head of list.@exitCutToHead			rts	*** End - 22-Jan-93 JCM		; = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Add icon to head of list.; = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   ic =	icon to	place at head.;	   icHand = ic's handle.;	   curWind = window owner.;;  OUT:	   temp	= trash.;; = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	HeadIconHeadIcon			jsr	getwRefCon		Get handle of first icon.		sta	<temp		stx	<temp+2		sta	[<ic]		ldy	#icNext+2		txa		sta	[<ic],y		ldy	#icLast			Zero out icLast	field of new first icon.		lda	<zero		sta	[<ic],y		iny		sta	[<ic],y		lda	<temp+1			Is there a first icon?		beq	setHead		jsr	derefTemp		temp = (temp).		ldy	#icLast		lda	<icHand		sta	[<temp],y		iny		lda	<icHand+1		sta	[<temp],ysetHead		ldx	<icHand+2		Replace	the handle of the first	icon		lda	<icHand			in the window.; = = =	= = = =	= = = =	= = = =	= = = =	=;	   Set head of ICONOBJ list.; = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   a = low word	of ICONOBJ handle.;	   x = high word of ICONOBJ handle.;	   curWind = window.;;  OUT:	   windblk = pointer to	window's info block.;; = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	setIconHeadsetIconHead				pha				Save new head of ICONOBJ list.		phx		jsr	getwRefCon		ldy	#windIcons+2		Set new	icon handle.		pla		sta	[<windblk],y		pla		sta	[<windblk]		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Compute parameters for icon;	   that	is destination of drag.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   IconTrack = handle of icon that is destination icon.;;  OUT:	   IconTrack is	deselected (was	selected from tracking code).;	   filetype = IconTrack's icFType field.;	   windTrack = window that IconTrack has opened	into (could be zero).;	   curWind = Trash.;	   windBlk = Trash.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		IMPORT	magicToDo		;in data.aii - 18-Jan-93 JCMgetDesIcon		lda	<IconTrack		Dereference destination	icon.		sta	<icHand		lda	<IconTrack+2		sta	<icHand+2		jsr	lockic		ldy	#icMom			Destination icon's parent window.		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2		jsr	startDraw		jsr	offIcon2		Deselect the icon the destination icon,		jsr	endDraw			cause the track	routine	left it	on.		jsr	unlockic		Unlock IconTrack.		ldy	#icFType		lda	[<ic],y		sta	<filetype		Pass the des. filetype to moveIcons.		cmp	#TypeFTrash		Trash can?		bcc	skip7		EXPORT	desIsTrashdesIsTrash		;				lda	#$FFFF		sta	ExtCopy			Destination will be an extended	icon.		lda	<TrashWind		ldx	<TrashWind+2		bra	store7 *** 18-Jan-93 JCM - This addition supports the magic routing code in file.aii. It tells it that***		    the destination icon is or is not the System folder. skip7		cmp	#$000F			;we're looking for the System folder, is this it?		bne	getIconsWindow				ldy	#icAuxType		;the System folder has a special auxType of $0002		lda	[<ic],y			;let's see if this is it		dec	a		dec	a				bne	getIconsWindow		dec	magicToDo		;signal to magic code that we're copying to the System foldergetIconsWindow	ldy	#icWind+2		;use its open window as the destination.*** end 18-Jan-93 JCM		lda	[<ic],y		tax		dey		dey		lda	[<ic],ystore7		sta	<windTrack		stx	<windTrack+2				rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Check drag conflicts, tell user.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   curWind = pointer to	source window.;	   windTrack = destination window, zero	if same	as source.;;  OUT:	   Carry clear if OK, set if drag error.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =ckConflicts		IMPORT	WStringCopy;; --- Count number of items being dragged, set flags for types ---------------;		stz	dragDisk		Initialize number being	dragged.		stz	dragFile		stz	dragTrash		stz	dragExt		stz	dragDrive		stz	dragFolder		stz	dragNetwork		lda	#countDrag		Count types and	number of icons	dragged.		jsr	findSelect;; --- Find out the destination type ------------------------------------------;		lda	<windTrack+1		Is there a destination window?		beq	skip700		lda	<windTrack		ldx	<windTrack+2		jsr	getWindID		cmp	#NoWindID		Is the destination the desktop?		bne	next700			If yes,	then OK.		lda	dragNetwork		Network item being dragged todesktop?		beq	skip700		lda	#rasSharedVol		Tell user that can't be done.		brl	err700next700		cmp	#DirWindID		Is the destination a directory window?		beq	skip700			If yes,	then OK.		cmp	#TrashWindID		Is the destination the Trash window?		beq	skip700			If yes,	then OK.		lda	#rasDesErr		Icons can't be dragged on to windows...goErr700	brl	err700;; --- Check for	dragging floppy	drives ------------------------------------- ;skip700		lda	<windTrack+1		Dragging to any	other plane?		ora	<iconTrack+1		beq	next701			If not,	ok to drag drives. ;; --- Floppy drive being dragged somewhere other than desktop --------------; 		lda	#rasDragErr4		'Drive icons cannot be moved onto...'		ldx	dragDrive		Any drive icons	being dragged?		bne	goErr700;; --- Trash icon being dragged somewhere other than desktop ----------------; 		lda	#rasDragErr1		"Trash can not be moved	to windows		ldx	dragTrash		bne	goErr700;; --- Check for dragging onto a disk icon which is locked ------------------;next701		lda	<Taskdata		;are they moving from the trash back to someplace else?		cmp	<TrashWind			bne	@notFromTrash		lda	<TaskData+2		cmp	<TrashWind+2		beq	@goDestNotIcon@notFromTrash	lda	<windTrack+1		beq	@CheckIconRO		lda	<windTrack		;is the destination window the desktop?  If so, don't check		cmp	<deskPort		;to see if the desktop is read-only or locked.		bne	@notToDesktop		lda	<windTrack+2		cmp	<deskPort+2		bne	@notToDesktop@goDestNotIcon	brl	@destNotIcon@notToDesktop	pushZLong <ic			;make ic into a pointer to the window block						;(gak)		pha		pha		pushZLong <windTrack		_GetWRefCon		pulllong <ic		ldy	#windFST		lda	[<ic],y		tay		jsl	IsReadOnly		bcc	@windowNotRO				lda	dragFile		;are we dragging files or folders to the		ora	dragFolder		;read-only destination disk?		bne	@readOnly		;if so, tell them they are naughty		lda	dragDisk		;but, if we're dragging a disk to the RO dest disk,		beq	@readOnly@goDiskNotDest	brl	@diskNotDest		;then we can't warn them... because they might be doing disk-to-disk@readOnly	lda	#windPath		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx		pushlong #c1_filename		jsl	WStringCopy		sec		lda	#rasDragReadOnly		brl	@out;; Now that we know the window we dragged into isn't a window connected to a disk with a read-only; file system, see if the root icon for this window is locked.;@windowNotRO	ldy	#windDiskIc		lda	[<ic],y		tax		iny		iny		lda	[<ic],y		sta	<ic+2		stx	<ic		bra	@checkForLocked	;; See if we dragged onto an icon, and if we did, check first to see if the icon is from a disk with a; read-only file system.  Then check to see if the icon is on a disk which is currently locked.;@CheckIconRO	lda	<iconTrack+1		bne	@destIsIcon		brl	@destNotIcon@destIsIcon			pushZLong <ic				lda	[<IconTrack]		sta	<ic		ldy	#2		lda	[<IconTrack],y		sta	<ic+2			ldy	#icFST			;is the destination icon from a read-only file		lda	[<ic],y			;system?		tay		jsl	isReadOnly		bcc	@iconNotRO			lda	dragFile		;are we dragging files or folders to the		ora	dragFolder		;read-only destination disk?		bne	@readOnly2		;if so, tell them they are naughty		lda	dragDisk		;but, if we're dragging a disk to the RO dest disk,		bne	@diskNotDest		;then we can't warn them...@readOnly2	lda	#icName		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx		pushlong #c1_filename		jsl	PToWString		sec		lda	#rasDragReadOnly		bra	@out;; Now that we know the icon we dragged into isn't an icon connected to a disk with a read-only; file system, see if the root icon for this icon is locked.;@iconNotRO	ldy	#icDisk					lda	[<ic],y		tax		iny		iny		lda	[<ic],y		sta	<ic+2		stx	<ic@checkForLocked	lda	[<ic]		tax		ldy	#2		lda	[<ic],y		sta	<ic+2		stx	<ic						ldy	#icFlag		lda	[<ic],y		and	#icLocked		beq	@diskNotDest		lda	#icName		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx		pushlong #c1_filename		jsl	PToWString		sec		lda	#rasDragLocked		bra	@out		@diskNotDest	clc@out		plx		stx	<ic		plx		stz	<ic+2		bcs	err700;; ------ Disk is being dragged ---------------------------------------------;@destNotIcon	lda	dragDisk		Are any	disk icons being dragged?		beq	exit701		lda	#rasDragErr2		"Only disk icons can be	dragged	in;					       this operation."; Disk dragged to desktop:;		ldx	<filetype		beq	exit701			Is destination the desktop?;; Disk draggged	to Trash:;		ldx	<filetype		cpx	#TypeFTrash		bcs	ckFiles700		OK dragging to trash, if no files too.;; Disk dragged to folder:; 		cpx	#$000F		beq	err700			Dragging to a folder is	an error.;; Disk being dragged to	another	disk:;		txy		bpl	err700			;used to be err700 ckFiles700	lda	#rasDragErr3		'Files can not be draged with disks.'		ldx	dragFolder		;can't drag folders with disks		bne	err700		ldx	dragFile		Dragging to another disk,		beq	exit701			can only drag disks.err700		jsl	doAlertWindow		pla				; button value				sec				Quit drag flag.		rtsexit701		clc				OK flag.		rts	; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Recompute the deltas	if moving;	   to a	new window plane.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   yrat	= local	y starting position.;	   xrat	= local	x starting position.;	   yoffset = source's y offset to global.;	   xoffset = source's x offset to global.;	   windTrack = destination window, zero	if none.;	   iconTrack = destination icon, zero if none.;	   deltay = amount cursor dragged vertically.;	   deltax = amount cursor dragged horizontally.;;  OUT:	   deltay = change in vertical position	to new window plane.;	   deltax = change in horizontal position to new window	plane.;makeDesPos;; --- Only use destination position if dragging	directly to another window ----;		lda	<windTrack+1		Is there even a	destination window?		beq	exit800			If not,	can't be dragging directly.		lda	intoIcon		Destination an icon?		bne	exit800			If yes,	not dragging directly to window.;; ------ Compute position in destination window	------------------------------;		lda	<windTrack		Switch to destination window's coordinate		ldx	<windTrack+2		system.		jsr	startDraw2		ldx	#x1lop800		lda	<yrat,x			Starting position,		clc		adc	<yoffset,x		plus source offset equals global,		clc		adc	deltay,x		plus amount of change equals		sta	deltay,x		destination global position.		dex		dex		bpl	lop800		pea	deltay>>16		Convert	the global destination		pea	deltay			position into the destination		_GlobalToLocal			local position.		lda	deltay			The destination	local,		sec		sbc	<yrat			less the source	local,		sta	deltay			equals the position change.		lda	deltax		sec		sbc	<xrat		sta	deltax		jsr	endDrawexit800		rts; = = =	= = = =	= = = =	= = = =	= = = =;	   Copy	dragged	icons.; = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   TaskData = source window.;	   windTrack = destination window, if there is one.;	   IconTrack = destination icon, if there is one.;; = = =	= = = =	= = = =	= = = =	= = = =copyFiles		lda	<TaskData		Get info block for source window.		ldx	<TaskData+2		jsr	getwRefCon2; --- Make sure	all extended icons being copied are from same disk ---------		lda	dragExt			Are extended icons being copied?		bne	doExtCopy		brl	copyFiles3doExtCopy	stz	C1_PathName		Mark 'no names checked'.		lda	#sameDisk		Check if all from same disk.		jsr	walkOfLife3		bcs	exit950			If error, don't perform copy. 		lda	#copyExt		Call copy file one at a	time.		brl	walkOfLife3		Must walk forward!; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Check if all	selected icons;	   are extended	and from same disk.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =; Call by walkOfLife.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =sameDisk		IMPORT	PathGetRoot		IMPORT	PathToPStr		IMPORT	PStringCompare						ldy	#icFlag			; only check selected icons		lda	[<ic],y		and	#ICSELECTED		beq	exit950		lda	[<ic],y			; only extended icons can be moved		and	#ICEXTENDED		beq	error950		lda	C1_PathName		; is this the first icon ?		bne	skip950		jsr	getExtName		; C1_PathName = icOwner field		bcs	error950		; pathname error		PushLong #C1_VolName		PushLong #C1_PathName		jsl	PathGetRoot		; get just the root name		PushLong #C1_VolName		PushLong #C1_TempPath		jsl	PathToPStr		; convert to Pascal string		bra	exit950skip950		jsr	getExtName		; C1_PathName = icOwner field.		bcs	error950		; Pathname error?		jsr	getRootName		; lastName = pathname root, no separator, 		pha		PushLong #lastName		PushLong #C1_TempPath		jsl	PStringCompare		pla		beq	error950		; did not matchexit950		clc		rts;; ERROR: dragging extended icons from different disks to a disk;error950	lda	#rasCopyErr		jsl	doAlertWindow		sec				; Quit walk		rts; = = =	= = = =	= = = =	= = = =	= = = =	=;	   Copy	extended icons.; = = =	= = = =	= = = =	= = = =	= = = =	=; Call by walkOfLife.;; = = =	= = = =	= = = =	= = = =	= = = =	=copyExt		ldy	#icFlag			Is this	icon extended and selected?		lda	[<ic],y		and	#ICEXTENDED+ICSELECTED		cmp	#ICEXTENDED+ICSELECTED		bne	exit900		pei	<icHand+2		Save.		pei	<icHand		pei	<ic+2		pei	<ic		jsr	copyFiles2		pla		sta	<ic		pla		sta	<ic+2		pla		sta	<icHand		pla		sta	<icHand+2		lda	functionKey		Let copy files know the	next time that		ora	#$8000			I'm in a loop copying extended icons.		sta	functionKey		rts				Carry is returned from CopyFile.exit900		clc		rts		INCLUDE	'Icons2.aii'		END