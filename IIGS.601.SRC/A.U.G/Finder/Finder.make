# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #   File:       Finder.make#   Target:     Finder#   Sources:    See CODE variable below...#   Created:    Wednesday, June 15, 1988 2:05:00 PM - DJB##	Build the IIGS Finder.## # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #	These are the directories for our components.SrcDir	=	':'ObjDir	=	':Objects:'LstDir	=	':Listings:'#	This variable is the kind for the code load segments.#	No special memory to allow us to hopefully use the shadowed screenKIND	=	$1000BANKKIND =	$1100#	Set this variable to the name of the target load file.LOADFILE	=	Finder#	Set this variable to any AsmIIGS options you want (eg -L ).AOPTIONS	= -D DEBUGSYMBOLS=0 -D AllowServerCopies=0 -D AllowSmartDesktop=0#	Set this variable to any LinkIIGS options you want (eg -L ).LOPTIONS	=#	Set this variable to any RezIIGS options you want (eg -p).ROPTIONS 	=#	Add any new files for the code segment here.MAIN	=	{ObjDir}Main.obj		¶			{ObjDir}Request.obj		¶			{ObjDir}Icons.obj		¶			{ObjDir}Menu.obj		¶			{ObjDir}Drives.obj		¶			{ObjDir}Util.obj		¶			{ObjDir}Data.obj		¶			{ObjDir}Misc.objVERIFY	=	{ObjDir}Verify.objMATCH	=	{ObjDir}Match.objINFO	=	{ObjDir}GetInfo.objCONTROL	=	{ObjDir}Common.objALERT	=	{ObjDir}Alert.objBUFFERS	=	{ObjDir}Buffers.objCODE	=	{ObjDir}GSOS.obj		¶			{ObjDir}Utility.obj		¶			{ObjDir}File.obj		¶			{ObjDir}FiFiFiTwo.obj#	This defines the files used in the data segment.DATA	=	{ObjDir}Strings.obj#	This define the files used for resourcesRESOURCES = {SrcDir}Finder.rez		¶			{SrcDir}Finder.rez.equ	¶			{SrcDir}about.rez		¶			{SrcDir}help.rez		¶			{SrcDir}dialog.rez		¶			{SrcDir}main.rez		¶			{SrcDir}prefs.rez		¶			{SrcDir}icons.rez		¶			{SrcDir}shutdown.rez	¶			{SrcDir}dialog.rez		¶			{SrcDir}KeyboardNav:KeyboardNavRsrc#	The object directory is dependant on the source directory{ObjDir}	Ä	{SrcDir}{LoadFile} ÄÄ {LoadFile}.data {LoadFile}.rsrc	if {AutoDuplicate} == 1		DuplicateIIgs -y -mac Finder :	End{LoadFile}.data	ÄÄ {MAIN} {VERIFY} {BUFFERS} {INFO} {CODE} {DATA} {MATCH} ¶						{CONTROL}  {ALERT}  							¶											{ObjDir}Help.obj			¶											{ObjDir}FiFiFiOne.obj		¶											{ObjDir}About.obj													LinkIIGS {LOPTIONS}					¶			-lseg:{BANKKIND} FINDER {MAIN}		¶			-lseg:{KIND}  BUFFERS	{BUFFERS}	¶			-lseg:{KIND}  VERIFY	{VERIFY}	¶			-lseg:{KIND}  INFO		{INFO}		¶			-lseg:{KIND}  CONTROL	{CONTROL}	¶			-lseg:{KIND}  MATCH		{MATCH}		¶			-lseg:{KIND}  ALERT		{ALERT}		¶			-lseg:{KIND}  CODE 		{CODE}		¶			-lseg:{KIND}  DATA 		{DATA}		¶			-lseg:dynamic ABOUT		{ObjDir}About.obj¶			-lseg:dynamic Help	 	{ObjDir}Help.obj					¶			-lseg:dynamic FIFIFIONE {ObjDir}FiFiFiOne.obj				¶		-at $DB03 ¶		-o {LOADFILE}#		ExpressIIGS {LOADFILE} -o START#		Beep 800,32#		duplicateiigs -y -mac START :{LoadFile}.rsrc	ÄÄ	{RESOURCES}		RezIIGS {ROPTIONS}		¶				{LOADFILE}.rez	¶				-o {LOADFILE}{SrcDir}KeyboardNav:KeyboardNavRsrc ÄÄ {SrcDir}KeyboardNav:KeyboardNavRsrc.aii.obj		LinkIIgs -t $B6 {SrcDir}KeyboardNav:KeyboardNavRsrc.aii.obj -o {SrcDir}KeyboardNav:KeyboardNavRsrc{SrcDir}KeyboardNav:KeyboardNavRsrc.aii.obj ÄÄ {SrcDir}KeyboardNav:KeyboardNav.aii		AsmIIgs {AOPTIONS} -d InitVersion=0 {SrcDir}KeyboardNav:KeyboardNav.aii -o {SrcDir}KeyboardNav:KeyboardNavRsrc.aii.obj	#	Additional dependancies for object files.{ObjDir}icons.obj	Ä	{SrcDir}icons2.aii{ObjDir}alert.obj		¶{ObjDir}drives.obj		¶{ObjDir}file.obj		¶{ObjDir}GetInfo.obj		¶{ObjDir}GSOS.obj		¶{ObjDir}icons.obj		¶{ObjDir}main.obj		¶{ObjDir}menu.obj		¶{ObjDir}misc.obj		¶{ObjDir}util.obj		¶{ObjDir}verify.obj	Ä	{SrcDir}Resource.equ#	This is a default rule to build object files from source files.	.obj	Ä .aii DP.equ Finder.equ IconObj.equ WindowBlk.equ		AsmIIGS  {AOPTIONS} -o {ObjDir}{Default}.obj {SrcDir}{Default}.aii