d, offset that the records start atFDataSize	equ	FDataStartAt+2	IconPOSLength	equ	0		;word, length of recordIconPOSColor	equ	IconPOSLength+2	;word, icon's color (in high byte)IconPOSy	equ	IconPOScolor+2	;word, icon's y positionIconPOSx	equ	IconPOSy+2	;word, icon's x positionIconPOSname	equ	IconPOSx+2	;pString for filenameIconPOSsize	equ	IconPOSname+32;; Port offsets;PortInfo	equ	0PortSCB		equ	PortInfoPixelImage	equ	PortSCB+2PixelWidth	equ	PixelImage+4BoundsRect	equ	PixelWidth+2PortRect	equ	BoundsRect+8ClipRgn		equ	PortRect+8visRgn		equ	ClipRgn+4;; --- Directory entry offsets -------------------------------------------;DirName		equ	0DirFType	equ	DirName+34DirKey		equ	DirFType+1DirSize		equ	DirKey+4DirEOF		equ	DirSize+4DirCDate	equ	DirEOF+4DirVersion	equ	DirCDate+8DirAccess	equ	DirVersion+2DirAuxType	equ	DirAccess+2DirModDate	equ	DirAuxType+2DirEntrySize	equ	DirModDate+8;; ----- Icon demension equates -------------------------------------------;TITLE_H		equ	8			Height of icon title.textLeft	equ	10			X coordinate of	icon in	view by	text.		INCLUDE 'windowBlk.equ'		;window block equates;;--- Menu equates ------------------------------;APPLEID		equ	1			; Menu Title ID	numbersFILEID		equ	APPLEID+1EDITID		equ	FILEID+1VIEWID		equ	EDITID+1DISKID		equ	VIEWID+1SPECIALID	equ	DISKID+1COLORID		equ	SPECIALID+1idAppleMenu	equ	300idFileMenu	equ	350idEditMenu	equ	400idWindowsMenu	equ	450idViewMenu	equ	500idDiskMenu	equ	550idSpecialMenu	equ	600idColorMenu	equ	650idAbout		equ	idAppleMenu+1		; id's for Apple menu itemsidHelp		equ	idAbout+1idNewFolder	equ	idFileMenu+1		; id's for file menu itemsidOpen		equ	idNewFolder+1idPrint		equ	idOpen+1idClose		equ	idPrint+1idCloseAll	equ	idClose+1idDuplicate	equ	idCloseAll+1idPutAway	equ	idDuplicate+1idValidate	equ	idPutAway+1idUndo		equ	250			; id's for file menu itemsidCut		equ	251			; (defined by system)idCopy		equ	252idPaste		equ	253idClear		equ	254idSelectAll	equ	i