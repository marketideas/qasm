//-----------------------------------------------------------------------------------// icons.rez//// Copyright 1991-93, Apple Computer, Inc.//// 3/16/91, andy// 24-Mar-93 JCM - Added new icons for File Type Descriptor files// 25-Mar-93 JCM - Added my DiskCopy icons.// //-----------------------------------------------------------------------------------// -- Icon Matching definitionsresource rBundle (1, Preload, noSpecialMemory) {	1,								// rIcon ID for finder	1,								// rBundle ID of this rBundle	{								// OneDoc structures				/*------------- icon for drop folder ----------------------------------------*/			{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_00000013},		// rIcon ID for big icon			{ICON_00000113}			// rIcon ID for small icon			},					FileType|NetworkAccess,		// match by filetype only for matchflags						MatchFileType {{				$0f				// match filetype for folder			}},			empty{},			// no auxtype stuff				empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits						matchNetworkAccess {{				$00000007,			// mask only user summary stuff				$00000004,			// want 'make changes' & !see files !see folders			}},						empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for owner's folder ----------------------------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_00000014},		// rIcon ID for big icon			{ICON_00000114}			// rIcon ID for small icon			},					FileType|NetworkAccess,		// match by filetype only for matchflags						MatchFileType {{				$0f				// match filetype for folder			}},								empty{},			// no auxtype stuff				empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			matchNetworkAccess {{				$00000080,			// mask only user summary stuff				$00000080,			// want owner			}},			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for system folder ----------------------------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_00000012},		// rIcon ID for big icon			{ICON_00000112}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype only for matchflags						MatchFileType {{				$0f				// match filetype for folder			}},				MatchAuxType {{				$0000FFFF,		// mask for only low word				$00000002		// match for system file			}},							empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for regular folder ----------------------------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_00000015},		// rIcon ID for big icon			{ICON_00000115}			// rIcon ID for small icon			},					FileType,				// match by filetype only for matchflags						MatchFileType {{				$0f				// match filetype for folder			}},			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for fonts ------------------------------------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_00000011},		// rIcon ID for big icon			{ICON_00000111}			// rIcon ID for small icon			},		 			FileType,				// match by filetype only for matchflags						MatchFileType {{				$c8				// match filetype for font			}},				empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for File Type Descriptor file - Moof! ----------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_0000003D},		// rIcon ID for big icon			{ICON_00000135}			// rIcon ID for small icon			},					FileType,			// match by filetype only for matchflags						MatchFileType {{				$42				// match filetype for file type descriptors			}},				empty{},			// no auxType			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for DiskCopy document ----------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_0000003E},		// rIcon ID for big icon			{ICON_00000136}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype and auxtype						MatchFileType {{				$E0				// match filetype for Archival library			}},				MatchAuxType {{				$0000FFFF,		// mask for only low word				$00000005		// match for DiskCopy doc			}},							empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for EasyMount doc ----------------------------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_0000003A},		// rIcon ID for big icon			{ICON_00000127}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype only for matchflags						MatchFileType {{				$e2				// match filetype for folder			}},				MatchAuxType {{				$0000FFFF,		// mask for only low word				$0000ffff		// match for system file			}},							empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for teach document ----------------------------------------*/					{			LaunchThis|reads|writes|native|creator, // launch this			{1},					// rFinderPath for this			{ICON_00000037},		// rIcon ID for big icon			{ICON_00000116}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype and auxtype for matchflags						MatchFileType {{				$50				// match filetype for teach			}},			MatchAuxType {{				$0000ffff,		// auxtype mask				$00005445		// match auxtype for teach			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for installer script ------------------------------------*/					{			LaunchThis|reads|writes|native|creator,	// launch this			{5},					// rFinderPath ID			{ICON_0000001A},		// rIcon ID for big icon			{ICON_0000011A}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype and auxtype						MatchFileType {{				$b0				// match filetype for installer script			}},			MatchAuxType {{				$0000FFFF,				$00000017		// match auxtype			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for APW src file document ---------------------------------*/					{			LaunchThis|reads, 		// launch this			{1},					// rFinderPath for this			{ICON_00000017},		// rIcon ID for big icon			{ICON_00000117} 		// rIcon ID for small icon			},					FileType,			// match by filetype for matchflags						MatchFileType {{				$b0				// match filetype for teach			}},			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for AppleWorks 3.0 WP doc for teach ----------------------*/					{			LaunchThis|reads|writes, // launch this			{1},					 // rFinderPath for this			{ICON_00000016},		 // rIcon ID for big icon			{ICON_00000116} 		 // rIcon ID for small icon			},					FileType,			// match by filetype and auxtype for matchflags						MatchFileType {{				$1A				// match filetype for aworks			}},			empty{},			// no auxtype stuff				empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for AppleWorks GS WP doc for teach ----------------------*/					{			LaunchThis|reads|writes, // launch this			{1},					// rFinderPath for this			{ICON_00000016},		// rIcon ID for big icon			{ICON_00000116}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype and auxtype for matchflags						MatchFileType {{				$50				// match filetype for aworks gs			}},			MatchAuxType {{				$0000ffff,		// auxtype mask				$00008010		// match auxtype for aworks gs			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for MacWrite 5.0 WP doc for teach ----------------------*/					{			LaunchThis|reads|writes, // launch this			{1},					// rFinderPath for this			{ICON_00000016},		// rIcon ID for big icon			{ICON_00000116},		// rIcon ID for small icon			"MacWrite 5.0 Document" // string for document			},					HFSFileType|HFSCreator,	// match by filetype and auxtype for matchflags						empty{},			// no filetype			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type						matchHFSFiletype {{				$44524f57		// HFS filetype ('WORD')			}},						matchHFSCreator {{				$4143414d		// HFS creator ('MACA')			}},			empty{},			// no option_list stuff			empty{};			// no eof stuff			/*------------- icon for Macintosh application ----------------------*/					{			DontLaunch, 			// launch this			{0},					// rFinderPath for this			{0},					// rIcon ID for big icon			{0},					// rIcon ID for small icon			"Macintosh application" // string for document			},			HFSFileType,		// match by filetype and auxtype for matchflags						empty{},			// no filetype			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			matchHFSFiletype {{				$4C505041		// HFS filetype ('APPL')			}},			empty{},			// no HFS creator stuff			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for text file --------------------------------------------*/					{			LaunchThis|reads|writes|native,	// don't launch this			{1},					// rFinderPath ID			{ICON_00000017},		// rIcon ID for big icon			{ICON_00000117}			// rIcon ID for small icon			},					FileType,				// match by filetype only for matchflags						MatchFileType {{				$04				// match filetype for text file			}},			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for applesoft file ----------------------------------------*/					{			LaunchThis,				// launch this			{2},					// rFinderPath for this			{ICON_00000018},		// rIcon ID for big icon			{ICON_00000118}			// rIcon ID for small icon			},					FileType,				// match by filetype only for matchflags						MatchFileType {{				$fc				// match filetype for text file			}},			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for binary file ----------------------------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_00000019},		// rIcon ID for big icon			{ICON_00000119}			// rIcon ID for small icon			},					FileType,				// match by filetype only for matchflags						MatchFileType {{				$06				// match filetype for text file			}},			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for archiver TOC file ---------------------------------*/					{			LaunchThis|reads|writes|native|creator, // launch this			{3},					// rFinderPath ID			{ICON_00000035}			// rIcon ID for big icon, no small icon			},					FileType|AuxType,		// match by filetype and auxtype						MatchFileType {{				$5a					// match filetype for archiver TOC file			}},			MatchAuxType {{				$0000FFFF,				$00000007		// match auxtype			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for hypercard stack ---------------------------------*/			{			LaunchThis|reads|writes|native|creator, // launch this			{4},					// rFinderPath ID			{ICON_00000038},		// rIcon ID for big icon			{ICON_00000133}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype and auxtype						MatchFileType {{				$55					// match filetype for installer script			}},			MatchAuxType {{				$0000FFFF,				$00000001		// match auxtype			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for archiver data file ---------------------------------*/					{			LaunchThis|reads|writes|native|creator,	// launch this			{3},					// rFinderPath ID (should be *:Archiver)			{ICON_00000036}			// rIcon ID for big icon, no small icon			},					FileType|AuxType,		// match by filetype and auxtype						MatchFileType {{				$e0					// match filetype for installer script			}},			MatchAuxType {{				$0000FFFF,				$00000004		// match auxtype			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for Print Manager Printer driver ----------------------*/					{			DontLaunch,				// don't launch this			{0},					// rFinderPath ID			{ICON_0000001B},		// rIcon ID for big icon			{ICON_0000011B},			// rIcon ID for small icon			"Printer Driver" 		// string for document			},					FileType|AuxType,		// match by filetype for matchflags						MatchFileType {{				$BB				// match filetype for device driver			}},			MatchAuxType {{				$00007FFF,		// auxtype and mask for auxtype				