n ID for big icon			{ICON_00000132}			// rIcon ID for small icon			},					FileType|AuxType,		// match by filetype for matchflags						MatchFileType {{				$B3				// match filetype for sys16 file			}},			MatchAuxType {{				$0000FF02,		// auxtype and mask for auxtype				$0000DB02			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for s16 files --------------------------------------------*/				{			LaunchThis,				// launch this			{0},					// rFinderPathID			{ICON_00000031},		// rIcon ID for big icon			{ICON_00000132}			// rIcon ID for small icon			},					FileType,			// match by filetype for matchflags						MatchFileType {{				$B3				// match filetype for sys16 file			}},			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for sys files --------------------------------------------*/			{			LaunchThis,				// launch this			{0},					// rFinderPath ID			{ICON_00000032},		// rIcon ID for big icon			{ICON_00000132}			// rIcon ID for small icon			},					FileType,			// match by filetype for matchflags						MatchFileType {{				$FF				// match filetype for sys file			}},			empty{},			// no auxtype			empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff	/*------------- icon for sound files ------------------------------------*/			{			DontLaunch,				// don't launch this			{0},					// rFinderPathID			{ICON_0000003C}			// rIcon ID for big icon			},					FileType|AuxType,		// match by filetype for matchflags						MatchFileType {{				$d8				// match filetype for sound file 			}},			MatchAuxType {{				$0000FFFF,		// auxtype and mask for auxtype				$00000003			}},						empty{},			// no name			empty{},			// no create date			empty{},			// no mod date			empty{},			// no access bits			empty{},			// no network access bits			empty{},			// no storage type			empty{},			// no HFS filetype			empty{},			// no HFS creator type			empty{},			// no option_list stuff			empty{};			// no eof stuff//	/*------------- icon for sys files above $be00 --------------------------------*/////			{//			LaunchThis,				// launch this//			{0},					// rFinderPath ID//			{0x3c},					// rIcon ID for big icon//			{ICON_00000132}			// rIcon ID for small icon//			},//		//			FileType|EOF,			// match by filetype for matchflags//			//			MatchFileType {{//				$FF				// match filetype for sys file//			}},////			empty{},			// no auxtype//			empty{},			// no name//			empty{},			// no create date//			empty{},			// no mod date//			empty{},			// no access bits//			empty{},			// no network access bits//			empty{},			// no storage type//			empty{},			// no HFS filetype//			empty{},			// no HFS creator type//			empty{},			// no option_list stuff////			MatchEOF {{			//				CompareAll|greater,		// anything greater than $be00//				$0000be00//			}};								};};// -- rFinderPath ($802C) resources for stuff we know aboutresource rFinderPath (1,Preload, noSpecialMemory) {		{},		"*:Teach"				// application pathname};resource rFinderPath (2,Preload, noSpecialMemory) {		{},		"*:BASIC.System"		// applicat