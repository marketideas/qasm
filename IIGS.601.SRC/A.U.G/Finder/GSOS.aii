*===============================================**						** File:		GSOS.aii			** Project:	GS Finder			** Author:	Don J. Brady			** Build file:	Finder.Make			**						** © Copyright Apple Computer, Inc. 1988-1989	** All rights reserved.				**						**===============================================** All global routines can be called from any	** where in memory.*===============================================** Global Routines:				**	ChangePath()				**	GetFSTName()				**	IsFSTUpperCase()			**	GetPrivileges()				**	SetPrivileges()				**	GetServerName()				**	GetComment()				**	GetDeviceName()				**	GetDeviceNumber()			**	GetVolumeInfo()				**	GetFileInfo()				**	GetDeviceInfo()				**	GetDeviceStatus()			**	EjectDisk()				**	EjectAllDisks()				**	FormatDisk()				**	EraseDisk()				**	DeviceScan()				**	ConsoleWrite()				**	LockTheFile()				**	DisableTheFile()			**	WalkDirectory()				**	AddNotifyProc()				**	DelNotifyProc()				**	GetModifyDate()				**	GetFinderInfo()				**	SetGSOSAlerts()				**	SetAllPriv()				**	DeviceRead()				**	DeviceWrite()				**						**	IgnoreGSOSError()			**	HandleGSOSError()			**-----------------------------------------------** Modification History:				** 01/03/89 DJB	- File created today		**						**===============================================*		LONGA	ON		LONGI	ON		STRING	PASCAL				PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM		INCLUDE	'ALL.MACROS'				INCLUDE	'Pascal.MACROS'				INCLUDE	'SPECIAL.MACROS'				INCLUDE	'GSOS.equ'		INCLUDE	'Resource.equ'		include	'e16.event'		;18-Mar-93 JCM		PRINT	ON	;; The following code was copied from the OS's common.equ file;vcr_id          equ    $0000           ;offset to volume IDvcr_name        equ    vcr_id+2        ;offset to volume name pointervcr_status      equ    vcr_name+4      ;offset volume statusvcr_open_cnt    equ    vcr_status+2    ;offset to number of open files on vol.vcr_fst_id      equ    vcr_open_cnt+2  ;offset to owner ID numbervcr_dev         equ    vcr_fst_id+2    ;offset to where volume was last seenvcr_fst_ptr     equ    vcr_dev+2       ;offset to where volume was last seenos_find_vcr	equ	$01fc48os_deref	equ	$01fc38btnCancel	equ	$00btnOK		equ	$01btnTryAgain	equ	$01btnContinue	equ	$01iconStop	equ	$32iconNote	equ	$33iconCaution	equ	$34iconDisk	equ	$35iconDiskSwap	equ	$36		ENTRY	CallGSOS		ENTRY	GSOSErrormaxDevices	equ	128			; max number of devices we can special caseFinderInfo	RECORD	0location	DS	Point			; folder's locationwindRect	DS	Rect			; folder's rectanglewindView	DS.W	1			; folder's viewwindScroll	DS	Point			; scroll positionsizeOf		EQU	*		ENDR *===============================================*LocalData	PROC				; local data for GS/OS calls				IMPORT	NotifyProc		ENTRY	GlobalStartupFlag	;set by DeviceScan, checked by notify queue stuffGlobalStartupFlag dc.w	0		ENTRY	DeviceSoFar		;device which we've gotten to so farxDeviceSoFar	dc.w	0		EXPORT	IgnoreErrors		ENTRY	IgnoreErrorsIgnoreErrors	DC.W	0		ENTRY	GSOSErrCodeGSOSErrCode	DC.W	0		ENTRY	GSOSVolNamePtrGSOSVolNamePtr	dc.L	GSOSVolName		ENTRY	GSOSFileNamePtrGSOSFileNamePtr	dc.L	GSOSFileName		ENTRY	NameBuffer1		ENTRY	Name1NameBuffer1	DC.W	maxFileName+4Name1		DS.B	maxFileName+2		ENTRY	NameBuffer2		ENTRY	Name2NameBuffer2	DC.W	maxFileName+4Name2		DS.B	maxFileName+2;--- parameter lists --------------------------		ENTRY	OptionListBuff		ENTRY	OptionListSize		ENTRY	OptionListOptionListBuff	DC.W	recOptionList.sizeOf+20OptionListSize	DC.W	0		EXPORT	OptionListOptionList	DS	recOptionList		DS.B	16			; slop space;; Moved here 2/9/92 by andy to make this section more sparse ;		ENTRY	LocalOutBuffer		ENTRY	LocalPathName		ENTRY	LocalBufferLocalOutBuffer	DC.W	512+4			; changed to 512 DJB 5 Jun 89LocalBufferLocalPathName	DS.B	512+2			; used by WalkDirectory & SetAllPriv		ENTRY	GSOSVolumeGSOSVolume	DS.B	34			; "W" string copy (with ':')		ENTRY	GSOSVolNameGSOSVolName	DS.B	34			; pascal string copy		ENTRY	GSOSFileNameGSOSFileName	DS.B	34			; pascal string copy;; --- back to parameter lists ---------------- ;		ENTRY	ChngPathParamsChngPathParams	DS	recChangePath		ENTRY	FileInfoParamsFileInfoParams	DS	recFileInfo		EXPORT	VolumeParams		ENTRY	VolumeParamsVolumeParams	DS	recVolume		ENTRY	SysPrefsParamsSysPrefsParams	DS	recSysPrefs		ENTRY	OpenParamsOpenParams	DS	recOpen		ENTRY	WriteParamsWriteParams	DS	recWrite		ENTRY	CloseParamsCloseParams	DS	recClose		ENTRY	DirParamsDirParams	DS	recGetDirEntry						ENTRY	FSTInfoParamsFSTInfoParams	DS	recGetFSTInfo		ENTRY	FSTParamsFSTParams	DS	recFSTSpecific		ENTRY	GetDevNumParamsGetDevNumParams	DS	recGetDevNum		ENTRY	FormatParamsFormatParams	DS	recFormat		ENTRY	DevInfoParamsDevInfoParams	DS	recDevInfo		ENTRY	DevCtrlParamsDevCtrlParams	DS	recDevControl		ENTRY	ControlListControlList	DS.B	16			; a dummy control list		ENTRY	DevStatParams		; added 05/26/89 DJBDevStatParams	DS	recDevControl		ENTRY	StatusList		; added 05/26/89 DJBStatusList	DS.B	16		ENTRY	DevReadParamsDevReadParams	DS	recDevRead		ENTRY	inFormat		;are we in the formatdisk or erasedisk call?inFormat	dc.w	0;--- other data --------------------------------		ENTRY	winWidthwinWidth	DC.W	0		ENTRY	winHeightwinHeight	DC.W	0; Data for use by volume changed notification handlers		ENTRY	DirtyDeviceTableDirtyDeviceTable DS.B	(MaxDevices/8);--- static data for device scan ---------------		ENTRY	SkipDeviceTblSkipDeviceTbl	DS.B	maxDevices		; static table (byte entries)		ENTRY	OnlineDeviceTableOnlineDeviceTable ds.b	(MaxDevices/8)		;bit table;; PADDING;; This DS only to pad the Final 6.0 build to lose a block for sparseness' sake;;		DS.B	177		EXPORT	OnlineMasks		ENTRY	OnlineMasks		EXPORT	ChangedMasks		ENTRY	ChangedMasksOnlineMasks	ChangedMasks		dc.b	$01			;%00000001		dc.b	$02			;%00000010		dc.b	$04			;%00000100		dc.b	$08			;%00001000		dc.b	$10			;%00010000		dc.b	$20			;%00100000		dc.b	$40			;%01000000		dc.b	$80			;%10000000				EXPORT	OfflineMasks		ENTRY	OfflineMasks		EXPORT	UnchangedMasks		ENTRY	UnchangedMasksOfflineMasks	UnchangedMasks		dc.b	$FE			;%11111110		dc.b	$FD			;%11111101		dc.b	$FB			;$11111011		dc.b	$F7			;%11110111		dc.b	$EF			;%11101111		dc.b	$DF			;%11011111		dc.b	$BF			;%10111111		dc.b	$7F			;%01111111		ENTRY	LastDeviceLastDevice	DC.W	0			; static variable		ENTRY	NotifyParamsNotifyParams	DC.W	1			; pcount		DC.L	NotifyProc		ENDP*===============================================**	Change the Path of a GSOS File		**						** INPUT:	---- STACK ----			**		oldPathPtr (Ptr)		**		newPathPtr  (Ptr)		**		retAddr  (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		retaddr (3 bytes)		**	SP -->					**===============================================*ChangePath	PROC	EXPORT				InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A register (and carry)newPathPtr	Param	Ptr			; input parameters (revese order)oldPathPtr	Param	Ptr		IMPORT	ChngPathParams:recChangePath				EntryCode;-----------------------------------------------		Begin		phk		plb		lda	#2				; initialize record			sta	ChngPathParams.pCount		lda	<oldPathPtr		sta	ChngPathParams.oldPathname		lda	<oldPathPtr+2		sta	ChngPathParams.oldPathname+2		lda	<newPathPtr		sta	ChngPathParams.newPathname		lda	<newPathPtr+2		sta	ChngPathParams.newPathname+2				ldy	#osChangePath		lda	#ChngPathParams		ldx	#ChngPathParams>>16		jsr	CallGSOSEnd;-----------------------------------------------				ExitCode				; a-reg and carry flag returned		ENDP*===============================================**	Get the name of a GSOS FST		**						** INPUT:	---- STACK ----			**		fstNamePtr (Ptr)		**		fstID  (Word)			**	SP -->					**						** OUTPUT:	result is string		**===============================================*GetFSTName	PROC	EXPORT		InitFrame		FrameType  SaveB		; save data bankfstID		Param	Word			; input parameters (reverse order)fstNamePtr	Param	Ptr		IMPORT	FSTInfoParams:recGetFSTInfo		IMPORT	WStringCopy		IMPORT	PToWString			IMPORT	strUnknown		; in string segment				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#3		sta	FSTInfoParams.pcount		lda	#1			; start with first one		sta	FSTInfoParams.fstNum		lda	#NameBuffer1		sta	FSTInfoParams.fstName		lda	#NameBuffer1>>16		sta	FSTInfoParams.fstName+2gsos		jsl	GSOSCall		DC.W	osGetFSTInfo		DC.L	FSTInfoParams		bcs	unknown		lda	FSTInfoParams.fileSysID		cmp	<fstID			; a match ?		beq	match		inc	FSTInfoParams.fstNum		bra	gsos		match		PushLong #Name1		pushZLong <fstNamePtr		jsl	WStringCopy		; copy to caller's string		bra	Endunknown		PushLong #strUnknown		pushZLong <fstNamePtr		jsl	PToWString		; copy to caller's string		End;-----------------------------------------------		ExitCode		ENDP*===============================================**   Check if FST needs Upper Case characters	**						** INPUT:	---- STACK ----			**		space (word)			**		fstID  (word)			**	SP -->					**						** OUTPUT:	---- STACK ----			**		result (word)	1 = yes, 0 = no	**	SP -->					**===============================================*IsFSTUpperCase	PROC	EXPORT		InitFrame		FrameType  SaveB		; save data bank		fstID		Param	Word			; input parameterneedsUpper	Result	Word			; output result		IMPORT	FSTInfoParams:recGetFSTInfo		IMPORT	PToWString			IMPORT	strUnknown		; in string segment				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#5		sta	FSTInfoParams.pcount		lda	#1			; start with first one		sta	FSTInfoParams.fstNum		lda	#NameBuffer1		sta	FSTInfoParams.fstName		lda	#NameBuffer1>>16		sta	FSTInfoParams.fstName+2				stz	<needsUppergsos		jsl	GSOSCall		DC.W	osGetFSTInfo		DC.L	FSTInfoParams		bcs	End			; error or end of list		lda	FSTInfoParams.fileSysID		cmp	<fstID			; a match ?		beq	match		inc	FSTInfoParams.fstNum		bra	gsos		match		lda	FSTInfoParams.fstAttrib		and	#$8000			; does FST want upper case?		beq	End			; no		inc	<needsUpper		; yesEnd;-----------------------------------------------		ExitCode		ENDP*===============================================** Local routine for Get/Set Privileges		** IN:	y = FST command				**	a,x = pathname				**						** OUT:	FSTParams is initialized		**===============================================*GetSetInit	PROCminPCount	SET	4			; access rights onlymaxPCount	SET	6			; owner & group name also		IMPORT	FSTParams:recFSTSpecific		sty	FSTParams.command		sta	FSTParams.pathname		stx	FSTParams.pathname+2		lda	#fstAppleShare		sta	FSTParams.fstID		lda	#NameBuffer1		sta	FSTParams.owner		lda	#NameBuffer1>>16		sta	FSTParams.owner+2		lda	#NameBuffer2		sta	FSTParams.group		lda	#NameBuffer2>>16		sta	FSTParams.group+2		lda	#minPCount		sta	FSTParams.pcount	; minimumn pCount		rts		ENDP*===============================================**  Get the access privileges for a folder	**						** INPUT:	---- STACK ----			**		result (long)			**		ownerPtr (long)	- class1	**		groupPtr (long)	- class1	**		pathPtr (long)	- class1	**	SP -->					**						** OUTPUT:	---- STACK ----			**		access (long)			**	a-reg/carry flag returned		**===============================================*GetPrivileges	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)pathPtr		Param	Ptr			; input parameters (reverse order)groupPtr	Param	PtrownerPtr	Param	Ptraccess		Result	Long			; result returned		minPCount	SET	4			; access rights onlymaxPCount	SET	6			; owner & group name also		IMPORT	WStringCopy		IMPORT	PToWString		IMPORT	FSTParams:recFSTSpecific		IMPORT	strAnyUser		; in string segment				EntryCode;-----------------------------------------------Begin		phk		plb		ldy	#asGetPrivileges		lda	<pathPtr		ldx	<pathPtr+2		jsr	GetSetInit		stz	<access			; in case error		stz	<access+2		; Mensch 5/19/89 (fixing BRC #49175); This call did not reset the pcount to min before progressing.  Let's fix it now!		lda	#minPCount		sta	FSTParams.pcount	; maximum pCount; end Mensch 5/19/89 (BRC #49175)				lda	<ownerPtr+1		beq	gsos				lda	#0		sta	[<ownerPtr]		; in case error		sta	[<groupPtr]				lda	#maxPCount		sta	FSTParams.pcount	; maximumn pCountgsos		ldy	#osFSTSpecific		lda	#FSTParams		ldx	#FSTParams>>16		jsr	CallGSOS		bcs	End		lda	FSTParams.access	; pass back access rights		sta	<access		lda	FSTParams.access+2		sta	<access+2		lda	<ownerPtr+1		; does caller want strings?		beq	End			; no		lda	Name1			; null string -> "<Any User>"		bne	okOwner		PushLong #strAnyUser		pushZLong <ownerPtr		jsl	PToWString		; copy to caller's string		bra	okGroup		okOwner		PushLong #Name1		pushZLong <ownerPtr		jsl	WStringCopy		; copy to caller's string		okGroup		PushLong #Name2		pushZLong <groupPtr		jsl	WStringCopy		; copy to caller's string		lda	#0			; no errorsEnd;-----------------------------------------------		ExitCode				ENDP		*===============================================**  Set the access privileges for a folder	**						** INPUT:	---- STACK ----			**		access (long)			**		ownerPtr (long)	- pascal	**		groupPtr (long)	- pascal	**		pathPtr (long)	- class1	**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	none				**		a-reg/carry flag returned	**===============================================*SetPrivileges	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)pathPtr		Param	Ptr			; input parameters (reverse order)groupPtr	Param	PtrownerPtr	Param	Ptraccess		Param	Long		IMPORT	FSTParams:recFSTSpecific		IMPORT	PStringCompare		IMPORT	WStringCopy		IMPORT	strAnyUser		; in string segmentminPCount	SET	4			; access rights onlymaxPCount	SET	6			; owner & group name also		EntryCode;-----------------------------------------------Begin		phk		plb		ldy	#asSetPrivileges		lda	<pathPtr		ldx	<pathPtr+2		jsr	GetSetInit				lda	<access		sta	FSTParams.access		lda	<access+2		sta	FSTParams.access+2		lda	<ownerPtr+1		; is caller using strings?		beq	gsos2			; no		lda	#maxPCount		sta	FSTParams.pcount	; use maximumn pCount		lda	[ownerPtr]		; poor man's W to P string		xba		sta	[ownerPtr]		pha				; space for result				ldx	<ownerPtr+2		lda	<ownerPtr		inc	a		bne	compare		inxcompare		phx		pha		PushLong #strAnyUser		jsl	PStringCompare		; is owner "<Any User>" ?		lda	[ownerPtr]		; poor man's P to W string		xba		sta	[ownerPtr]				pla		beq	getOwner		; not equal to "<Any User>"		stz	Name1			; "<Any User>" is really a null string		bra	getGroup		getOwner	pushZLong <ownerPtr		PushLong #Name1		jsl	WStringCopy		; copy from caller's stringgetGroup	pushZLong <groupPtr		PushLong #Name2		jsl	WStringCopy		; copy from caller's stringgsos2		ldy	#osFSTSpecific		lda	#FSTParams		ldx	#FSTParams>>16		jsr	CallGSOSEnd						; error code returned in a-reg;-----------------------------------------------		ExitCode		ENDP*===============================================**	Get the Server Name and Zone Name	**						** INPUT:	---- STACK ----			**		serverPtr (Ptr) - W string	**		zonePtr (Ptr)	 - W string	**		pathPtr (Ptr)	 - W string	**	SP -->					**						** OUTPUT:	none				**===============================================*GetServerName	PROC	EXPORT		InitFrame		FrameType  SaveB		; save data bankpathPtr		Param	Ptr			; input parameters (reverse order)zonePtr		Param	PtrserverPtr	Param	Ptr		IMPORT	WStringCopy		IMPORT	FSTParams:recFSTSpecific		IMPORT	PToWString		EntryCode;-----------------------------------------------Begin		phk		plb		lda	#5			; initialize record		sta	FSTParams.pcount		lda	#fstAppleShare		sta	FSTParams.fstID		lda	#asGetServerName		sta	FSTParams.command		lda	<pathPtr		sta	FSTParams.pathname		lda	<pathPtr+2		sta	FSTParams.pathname+2		lda	#NameBuffer1		sta	FSTParams.server		lda	#NameBuffer1>>16		sta	FSTParams.server+2		lda	#NameBuffer2		sta	FSTParams.zone		lda	#NameBuffer2>>16		sta	FSTParams.zone+2		lda	#0		sta	[<serverPtr]		; in case error		sta	[<zonePtr]				jsl	GSOSCall		DC.W	osFSTSpecific		DC.L	FSTParams		bcs	End		PushLong #Name1		pushZLong <serverPtr		jsl	WStringCopy		; copy to caller's string				PushLong #Name2		pushZLong <zonePtr		jsl	WStringCopy		; copy to caller's stringEnd		;-----------------------------------------------		ExitCode		ENDP		*===============================================**	Get the Comment field of a file		**						** INPUT:	---- STACK ----			**		pathPtr (long) - W string	**		commentPtr (long) - W string	**	SP -->					**						** OUTPUT:	none				**===============================================*GetComment	PROC	EXPORT				InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)commentPtr	Param	Ptr			; input parameters (revese order)pathPtr		Param	Ptr		IMPORT	WStringCopy		IMPORT	FSTParams:recFSTSpecific		EntryCode;----------------------------------------------Begin		phk		plb		lda	#fstAppleShare		; initialize record		sta	FSTParams.fstID		lda	<pathPtr		; pathname buffer		sta	FSTParams.data+2		lda	<pathPtr+2		sta	FSTParams.data+4		lda	#LocalOutBuffer		; comment string buffer ptr		sta	FSTParams.data+6		lda	#LocalOutBuffer>>16		sta	FSTParams.data+8		lda	#4			; get ready for OpenDeskTop		sta	FSTParams.pcount		lda	#asOpenDeskTop		sta	FSTParams.command		jsl	GSOSCall		; OpenDeskTop		DC.W	osFSTSpecific		DC.L	FSTParams		bcs	End		lda	#5			; get ready for GetComment		sta	FSTParams.pcount		lda	#asGetComment		sta	FSTParams.command		jsl	GSOSCall		; GetComment		DC.W	osFSTSpecific		DC.L	FSTParams		bcs	End		lda	#4			; get ready for CloseDeskTop		sta	FSTParams.pcount		lda	#asCloseDeskTop		sta	FSTParams.command		jsl	GSOSCall		; CloseDeskTop		DC.W	osFSTSpecific		DC.L	FSTParams		bcs	End		PushLong #LocalPathname		pushZLong <commentPtr		jsl	WStringCopy		; copy to caller's string		End;----------------------------------------------		ExitCode			ENDP*===============================================** Convert a Device Number to an ASCII String	**						** - returns 'unknown' if an OS error occured	** - returns 'not in any drive' if devNum = 0	**						** IN:	---- STACK ----				**	stringPtr (Ptr) - W string		**	pathname (Ptr)	- W string		**  SP->						**						** OUT:	string is set				**===============================================*GetDeviceName	PROC	EXPORT		InitFrame		FrameType  SaveB		; save data bankpathname	Param	Ptr			; input parameters (reverse order)strPtr		Param	Ptr		IMPORT	GetDevNumParams:recGetDevNum		IMPORT	DeviceToString		EntryCode;-----------------------------------------------Begin		phk		plb		lda	#2			; initialize record		sta	GetDevNumParams.pcount		lda	<pathname		sta	GetDevNumParams.devName		lda	<pathname+2		sta	GetDevNumParams.devName+2				jsl	GSOSCall		DC.W	osGetDevNum		DC.L	GetDevNumParams		bcc	ok		ldx	#0			; 0 = "not in any drive"		cmp	#$45			; was volume offline?		beq	fakeNum		ldx	#$FFFF			; $FFFF = "unknown"fakeNum		stx	GetDevNumParams.devNumok		pushZLong <strPtr		lda 	GetDevNumParams.devNum		pha		jsl	DeviceToStringEnd;-----------------------------------------------		ExitCode		ENDP				*===============================================**	Get the device number for a Volume	**						** IN:	---- STACK ----				**	space (Word)				**	pathname (Ptr)	- W string ptr		**  SP->						**						** OUT:	---- STACK ----				**	devNum (Word)				**  SP->						**===============================================*GetDeviceNumber	FUNC	EXPORT		Initframe		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)		pathname	Param	Ptr			; input parameterdevNum		Result	Word			; result returned		IMPORT	GetDevNumParams:recGetDevNum				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#2			; initialize record		sta	GetDevNumParams.pcount		lda	<pathname		sta	GetDevNumParams.devName		lda	<pathname+2		sta	GetDevNumParams.devName+2				stz	<devNum			; in case error				ldy	#osGetDevNum		lda	#GetDevNumParams		ldx	#GetDevNumParams>>16		jsl	CallGSOS		bcs	End		lda	GetDevNumParams.devNum		sta	<devNum		lda	#0			; no errorEnd;-----------------------------------------------		ExitCode		ENDP*===============================================** Get Information about a Volume in a device	**						*						** IN:	---- STACK ----				**	devNamePtr (long) - W string ptr	**	volNamePtr (long) - W string ptr	**	blkTotalPtr (long)			**	blkFreePtr (long)			**	fileSysIDPtr (long)			**	blkSizePtr (long)			**	retAddr (3 bytes)			**  SP->						**						** OUT:	---- STACK ----				**	retAddr (3 bytes)			**===============================================*GetVolumeInfo	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)blkSizePtr	Param	Ptr			; input parameters (revese order)fileSysIDPtr	Param	PtrblkFreePtr	Param	PtrblkTotalPtr	Param	PtrvolNamePtr	Param	PtrdevNamePtr	Param	Ptr		IMPORT	VolumeParams:recVolume		IMPORT	WStringCopy				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#8				;initialize record		sta	VolumeParams.pcount		lda	<devNamePtr		sta	VolumeParams.devName		lda	<devNamePtr+2		sta	VolumeParams.devName+2		lda	#NameBuffer1		sta	VolumeParams.volName		lda	#NameBuffer1>>16		sta	VolumeParams.volName+2						ldy	#osVolume		lda	#VolumeParams		ldx	#VolumeParams>>16		jsr	CallGSOS		bcc	getName		cmp	#$57		bne	end				; error occured		jsr	copyVolumeName			;copy the volume name anyway		lda	#$57				;since it's not valid under		bra	end				;System 6.0's OS		getName		jsr	copyVolumeNamegetTotal	ldy	#2		lda	<blkTotalPtr+1		beq	getFree		lda	VolumeParams.totalBlks		sta	[<blkTotalPtr]		lda	VolumeParams.totalBlks+2		sta	[<blkTotalPtr],y		; Y set above		getFree		lda	<blkFreePtr+1		beq	getID		lda	VolumeParams.freeBlks		sta	[<blkFreePtr]		lda	VolumeParams.freeBlks+2		sta	[<blkFreePtr],y			; Y set abovegetID		lda	<fileSysIDPtr+1		beq	getSize		lda	VolumeParams.fileSysID		sta	[<fileSysIDPtr]getSize		lda	<blkSizePtr+1		beq	End			; a-reg has zero		lda	VolumeParams.blkSize		sta	[<blkSizePtr]		lda	#0End;----------------------------------------------		ExitCode;; copy the volume name from our name to their volNamePtr;copyVolumeName		lda	<volNamePtr+1		beq	@done		PushLong #Name1		pushZLong <volNamePtr		jsl	WStringCopy@done		rts				ENDP				*===============================================**	Get Information about a File		**						*						** IN:	---- STACK ----				**	pathnamePtr (Ptr)			**	accessPtr (Ptr)				**	fileTypePtr (Ptr)			**	auxTypePtr (Ptr)			**	storeTypePtr (Ptr)			**	cDatePtr (Ptr)				**	mDatePtr (Ptr)				**	bytesPtr (Ptr)				**	blocksPtr (Ptr)				**	fileSysPtr (Ptr)			**  SP->						**						** OUT:	none					**===============================================*GetFileInfo	PROC	EXPORT		InitFrame		FrameType  SaveB, ReturnA	; save data bank, return A reg (and carry)fileSysPtr	Param	Ptr			; input parameters (revese order)blocksPtr	Param	PtrbytesPtr	Param	PtrmDatePtr	Param	PtrcDatePtr	Param	PtrstoragePtr	Param	PtrauxTypePtr	Param	PtrfileTypePtr	Param	PtraccessPtr	Param	PtrpathnamePtr	Param	Ptr		IMPORT	FileInfoParams:recFileInfo		IMPORT	WStringCopy		IMPORT	OptionList:recOptionList				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#12				; initialize record		sta	FileInfoParams.pcount		lda	<pathnamePtr		sta	FileInfoParams.pathname		lda	<pathnamePtr+2		sta	FileInfoParams.pathname+2		lda	#OptionListBuff		sta	FileInfoParams.optionList		lda	#OptionListBuff>>16		sta	FileInfoParams.optionList+2				ldy	#osGetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOS		bcc	getAccess		cmp	#$4F				; ignore BufferTooSmall error		beq	getAccess		brl	End				; error occuredgetAccess	lda	<accessPtr+1		beq	getFileType			; skip access		lda	FileInfoParams.access		sta	[<accessPtr]getFileType	lda	<fileTypePtr+1		beq	getAuxType			; skip filetype		lda	FileInfoParams.filetype		sta	[<fileTypePtr]getAuxType	lda	<auxTypePtr+1		beq	getStorage			; skip auxtype		lda	FileInfoParams.auxtype		sta	[<auxTypePtr]		ldy	#2		lda	FileInfoParams.auxtype+2		sta	[<auxTypePtr],y		getStorage	lda	<storagePtr+1		beq	getCDate			; skip storage type		lda	FileInfoParams.storetype		sta	[<storagePtr]getCDate	lda	<cDatePtr+1		beq	getMDate			; skip createDate		ldy	#6@LoopC		lda	FileInfoParams.create,y		sta	[<cDatePtr],y		dey		dey		bpl	@LoopCgetMDate	lda	<mDatePtr+1		beq	getbytes			; skip modDate		ldy	#6@LoopM		lda	FileInfoParams.modify,y		sta	[<mDatePtr],y		dey		dey		bpl	@LoopMgetBytes	lda	<bytesPtr+1		beq	getBlocks			; skip bytes		lda	FileInfoParams.bytes		ldx	FileInfoParams.bytes+2		ldy	FileInfoParams.storetype		cpy	#$05				; extended file ?		bne	set1		clc		adc	FileInfoParams.rescbytes	; add resource bytes		pha		txa		adc	FileInfoParams.rescbytes+2		tax		plaset1		sta	[<bytesPtr]		ldy	#2		txa		sta	[<bytesPtr],ygetBlocks	lda	<blocksPtr+1			; skip blocks		beq	getFileSys					lda	FileInfoParams.blocks		ldx	FileInfoParams.blocks+2		ldy	FileInfoParams.storetype		cpy	#$05				; extended file ?		bne	set2		clc		adc	FileInfoParams.rescblocks	; add resource blocks		pha		txa		adc	FileInfoParams.rescblocks+2		tax		plaset2		sta	[<blocksPtr]		ldy	#2		txa		sta	[<blocksPtr],ygetFileSys	lda	<fileSysPtr+1		beq	End				; skip file system (a has 0)		lda	OptionList.fileSysId		sta	[<fileSysPtr]				lda	#0				; return no errorEnd;----------------------------------------------		ExitCode		ENDP				*===============================================**	Get Information about a device		**						*						** IN:	---- STACK ----				**	devNum (word)				**	devNamePtr (Ptr) - W string ptr		**	devCharPtr (Ptr)			**	devBlocksPtr (Ptr)			**	devIDPtr (Ptr)				**  SP->						**						** OUT:	none					**===============================================*GetDeviceInfo	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)devIDPtr	Param	Ptr			; input parameters (reverse order)devBlocksPtr	Param	PtrdevCharPtr	Param	PtrdevNamePtr	Param	PtrdevNum		Param	Word		IMPORT	DevInfoParams:recDevInfo		IMPORT	WStringCopy				EntryCode;-----------------------------------------------Begin		phk		plb		lda	<devIDPtr		; does caller want devID or totalBlocks?		ora	<devBlocksPtr+1		bne	init		lda	#3			; prevent media access if not needed		bra	cont		init		lda	#8			; initialize recordcont		sta	DevInfoParams.pcount		lda	<devNum		sta	DevInfoParams.devNum		lda	#NameBuffer1		sta	DevInfoParams.devName		lda	#NameBuffer1>>16		sta	DevInfoParams.devName+2				jsl	GSOSCall		DC.W	osDevInfo		DC.L	DevInfoParams		bcs	EndgetName		lda	<devNamePtr+1		beq	getChar		PushLong #Name1		pushZLong <devNamePtr		jsl	WStringCopygetChar		lda	<devCharPtr+1		beq	getBlocks		lda	DevInfoParams.devChar		sta	[<devCharPtr]getBlocks	lda	<devBlocksPtr+1		beq	getID		lda	DevInfoParams.blocks		sta	[<devBlocksPtr]		ldy	#2		lda	DevInfoParams.blocks+2		sta	[<devBlocksPtr],y		getID		lda	<devIDPtr+1		beq	done		lda	DevInfoParams.devID		sta	[<devIDPtr]done		lda	#0End;-----------------------------------------------		ExitCode		ENDP				*===============================================**	    Get a Device's Status		**						*						* IN:	---- STACK ----				**	space (Word)				**	devNum (Word)				**  SP->						**						** OUT:	---- STACK ----				**	status (Word)				**  SP->						**===============================================*GetDeviceStatus	FUNC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)devNum		Param	Word			; input parameters (revese order)status		Result	Word			; output value		IMPORT	DevStatParams:recDevControl		EntryCode;-----------------------------------------------Begin		phk		plb		lda	#5			; initialize record		sta	DevStatParams.pcount		lda	<devNum		sta	DevStatParams.devNum		lda	#0			; generic device status		sta	DevStatParams.ctrlCode		lda	#StatusList		sta	DevStatParams.ctrlList		lda	#StatusList>>16		sta	DevStatParams.ctrlList+2		lda	#6		sta	DevStatParams.request		stz	DevStatParams.request+2						ldy	#osDevStatus		lda	#DevStatParams		ldx	#DevStatParams>>16		jsr	CallGSOS		bcs	End		lda	DevStatParams.transfer	; was at least 2 bytes transfered?		cmp	#2		bcs	goodStat		stz	StatusList		; unknown status		goodStat	lda	StatusList		sta	<status		lda	#0			; return no errorEnd;----------------------------------------------		ExitCode		ENDP		*===============================================**		 Eject a Disk			**						*						** IN:	---- STACK ----				**	devNum (Word)				**  SP->						**						** OUT:	none					**===============================================*EjectDisk	PROC	EXPORT		InitFrame		FrameType  SaveB		; save data bankdevNum		Param	Word			; input parameters (revese order)		IMPORT	DevCtrlParams:recDevControl		EntryCode;-----------------------------------------------Begin		phk		plb		lda	<devNum		sta	DevCtrlParams.devNum		lda	#5		sta	DevCtrlParams.pcount		lda	#2			; eject code		sta	DevCtrlParams.ctrlCode		lda	#ControlList		sta	DevCtrlParams.ctrlList		lda	#ControlList>>16		sta	DevCtrlParams.ctrlList+2		stz	DevCtrlParams.request		stz	DevCtrlParams.request+2								lda	IgnoreErrors		; preserve setting		pha		lda	#1		sta	IgnoreErrors		; I don't care about eject errors				ldy	#osDevControl		lda	#DevCtrlParams		ldx	#DevCtrlParams>>16		jsr	CallGSOS		pla		sta	IgnoreErrors		; restore settingEnd;----------------------------------------------		ExitCode		ENDP				; format a disk;; IN:	---- STACK ----;	space (Word);	devNamePtr (Ptr);	volNamePtr (Ptr);  SP->	;				; OUT:	none					;.....................................................................FormatDisk	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)volNamePtr	Param	Ptr			; input parameters (revese order)devNamePtr	Param	Ptr		IMPORT	FormatParams:recFormat		IMPORT	SaveCursor		IMPORT	RestoreCursor		IMPORT	WatchCursor		EntryCodeBegin		phk		plb		lda	#$FFFF		sta	inFormat		pei	devNamePtr+2		pei	devNamePtr		pushlong #0		pushlong #0		pushlong #0		pushlong #formatParams.reqFileSys		pushlong #0		jsl	getVolumeInfo		lda	formatParams.reqFileSys		cmp	#$0c		bne	@notISO9660		stz	formatParams.reqFileSys@notISO9660		pha		pushZLong <devNamePtr		jsl	GetDeviceNumber		; device number left on stack		pushZLong <devNamePtr		pushlong #0		pushlong #0		pushlong #0		jsl	GetDeviceInfo		lda	#5			; initialize record		sta	FormatParams.pcount		lda	<devNamePtr		sta	FormatParams.devName		lda	<devNamePtr+2		sta	FormatParams.devName+2		lda	<volNamePtr		sta	FormatParams.volName		lda	<volNamePtr+2		sta	FormatParams.volName+2		lda	#$c000			;let the user type a name		sta	FormatParams.flags						ldy	#osFormat		lda	#FormatParams		ldx	#FormatParams>>16		jsr	CallGSOS				bcc	End		cmp	#0			;did the user cancel?		bne	End		lda	#$8000			; fake an errorEnd		stz	inFormat		ExitCode		ENDP; erase a disk;; IN:	---- STACK ----	;	space (Word)			;	devNamePtr (Ptr)	;	volNamePtr (Ptr)	;  SP->				;			; OUT:	none		;.....................................................................EraseDisk	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)volNamePtr	Param	PtrdevNamePtr	Param	Ptr		IMPORT	FormatParams:recFormat		IMPORT	SaveCursor		IMPORT	RestoreCursor		IMPORT	WatchCursor		IMPORT	getVolumeInfo		IMPORT	GetDevNum				EntryCode		Begin		phk		plb		pei	devNamePtr+2		pei	devNamePtr		pushlong #0		pushlong #0		pushlong #0		pushlong #formatParams.reqFileSys		pushlong #0		jsl	getVolumeInfo		lda	formatParams.reqFileSys		cmp	#$0c		bne	@notISO9660		stz	formatParams.reqFileSys@notISO9660		lda	#5			; initialize record		sta	FormatParams.pcount		lda	<devNamePtr		sta	FormatParams.devName		lda	<devNamePtr+2		sta	FormatParams.devName+2		lda	<volNamePtr		sta	FormatParams.volName		lda	<volNamePtr+2		sta	FormatParams.volName+2		lda	#$c000			;let the user type a name		sta	FormatParams.flags		ldy	#osEraseDisk		lda	#FormatParams		ldx	#FormatParams>>16		jsr	CallGSOS				bcc	End		cmp	#0			;did the user cancel?		bne	End		lda	#$8000			; fake an errorEnd		ExitCode		ENDP*===============================================**	Scan GSOS Devices for Mounting		**						** This routine will look for GSOS block devices ** that are online during Finder startup. For	** each valid device a Disk_Switch event is 	** posted to the Event Manager.	If it is not a	** statup call then this routine just does a 	** D_STATUS call for removable block devices to  ** cause disk switches to be sent to the GSOS	** notification queue (See our NotifyProc).	**						** Note: Disk]['s, non-block, and non-removable	** devices are only checked once; after that 	** they are ignored forever.			**						** IN:	---- STACK ----				**	startUp (Word)				** SP -->					**						** OUT:	none					**	retAddr (3 bytes)			**===============================================*DeviceScan	PROC	EXPORT;app2Evt	equ	$000D			; disk switch event - 18-Mar-93 JCM - in e16.event		InitFrame		FrameType  SaveB		; save data bankcurTick		Local	Long			; local variablesmainDP		Local	Word			; main's DP (for glue)startUp		Param	Word			; input parameters (revese order)		IMPORT	volumeNameHandle		import	MemoryID		IMPORT	WStringCopy		IMPORT	C1_bootname		IMPORT	c1_pathname		import	c1_devicename		import	c1_volname		IMPORT	InstallTrashcan		IMPORT	prefer		IMPORT	DevInfoParams:recDevInfo		IMPORT	DevStatParams:recDevControl		IMPORT	MountDisk		IMPORT	fileSysID		IMPORT	PathAddName		IMPORT	IconsName		IMPORT	MarkDeviceOnline		tdc				; stash main's DP in x		tax				EntryCode;-----------------------------------------------		stx	<mainDP			; remember main's DP (sick)Begin		phk		plb		lda	<startUp		; on = starting up		sta	GlobalStartupFlag		beq	@notStartup				ldx	#(MaxDevices/8)-2@oLoop		stz	OnlineDeviceTable,x		dex		dex		bpl	@oLoop		stz	OnlineDeviceTable	; insurance		@notStartup	jsr	Init			; initialize our local variables		scanLoop	lda	<startUp		; flag: came in on stack: $FFFF if startup		bne	info			; bra if startup (1st time thru)		ldy	DevInfoParams.devNum	; should we skip this device ?		dey		cpy	#maxDevices				bcs	info			; ouside our table		lda	SkipDeviceTbl,y		and	#$00FF			; byte entries		beq	info		brl	next			; Disk][ , non-removable, or non-block		info		lda	DevInfoParams.devNum		sta	DeviceSoFar		; remember highest device number (+1)				jsl	GSOSCall		; get the device's characteristics		DC.W	osDevInfo		DC.L	DevInfoParams		bcc	@infoOK		brl	done			; no more devices; we're done!@infoOK		lda	DevInfoParams.devChar		and	#$0080			; is it a block device ?		bne	status			; yes		jsr	MarkDevice		; no, so mark it so we'll skip it next time		brl	next			;  (stream device: terminal, prtr, ...)status		lda	DevInfoParams.devNum		sta	DevStatParams.devNum		jsl	GSOSCall		DC.W	osDevStatus		DC.L	DevStatParams		bcc	@devOK		brl	next			; error, ignore this device@devOK		lda	DevInfoParams.devNum	; have we seen this device already?		cmp	LastDevice		bcs	@notLast		brl	next			; yes, so we're done with this device@notLast			lda	#8			; need devID parameter		sta	DevInfoParams.pcount		jsl	GSOSCall		; now get devID (with media access punishment)		DC.W	osDevInfo		DC.L	DevInfoParams		lda	#3		sta	DevInfoParams.pcount	; back to normal pCount		bcs	cont			; call failed !?		lda	DevInfoParams.devID	; is it one of those DUMB (DiskII) drives?		beq	mark			; yes, so mark it				cmp	#$20			;is it the Apple Tape Drive? GS/OS devid $20		bne	@notTapeDrive				jsr	MarkDevice		brl	next			;if so, die, die, die! (ignore it)@notTapeDrive	lda	DevInfoParams.devChar		and	#$0004			; is it a removable device ?		bne	cont			; if not mark itmark		jsr	MarkDevice		; mark device so we'll skip it next timecont		lda	StatusList		and	#$0010			; is this device online ?;;;		beq	next			; no		beq	@maybeMakeTrash		;25-Nov-92 DAL				lda	DevInfoParams.devNum		jsl	MarkDeviceOnline				jsr	FakeInsert		; yes, so force a mount@maybeMakeTrash;; Now that we've mounted the disk, if this is the startup loop AND this is device #1, install the; trashcan (meaning that old-style icons can be used to change the trash, but not new style ones);		lda	DevInfoParams.devNum	; have we seen this device already?		cmp	#1			;is our device the boot device? (#1)		bne	next		lda	<startUp		;is this our startup loop?		beq	next			;if not, don't install the trashcan				phd		lda	<mainDP			; glue to main code		tcd		jsl	InstallTrashcan		; Install the trashcan icon and open the trash's invisible window				pld		bcc	next		bra	realDone	next		inc	DevInfoParams.devNum	; move to next device		brl	scanLoopgoRealDone	clc		bra	realDonedone		lda	<startUp		beq	realDone						clc				;@@@ used to have the CLC before the PLD;----------------------------------------------realDone	lda	DevInfoParams.devNum		sta	LastDevice		; remember highest device number (+1)			ExitCode			; return to caller;-----------------------------------------------FakeInsert		ldy	#0		ldx	DevInfoParams.devID	; is it one of those DUMB drives?		bne	set			; no		lda	<startup		beq	@just525		lda	>prefer		and	#1;		and	#PREF_AUTO525		bne	@just525				ldy	#3		bra	set@just525	ldy	#1set		phd		pea	#$FFFF			;we're starting up!		lda	<mainDP			; glue to yuky main code		tcd		lda	 DevInfoParams.devNum	; device number of new disk		pha		phy				; flag: event message (hi word) = type		jsl	MountDisk		pld		rts;-----------------------------------------------MarkDevice		ldy	DevInfoParams.devNum	; get device to mark		dey				; zero-relative table		cpy	#maxDevices		; will it fit in our table?		bcs	endMark		lda	#$FF		sep	#$20		sta	SkipDeviceTbl,y		; this device will be skipped next time		rep	#$20endMark		rts;-----------------------------------------------Init		lda	#3			; initialize d_info record		sta	DevInfoParams.pcount		lda	#1			; start with first device		sta	DevInfoParams.devNum		lda	#NameBuffer1		sta	DevInfoParams.devName		lda	#NameBuffer1>>16		sta	DevInfoParams.devName+2		lda	#5			; initialize d_status record		sta	DevStatParams.pcount		lda	#0			; generic device status code		sta	DevStatParams.ctrlCode		lda	#StatusList		sta	DevStatParams.ctrlList		lda	#StatusList>>16		sta	DevStatParams.ctrlList+2		lda	#6		sta	DevStatParams.request		stz	DevStatParams.request+2				lda	<startUp		beq	endInit				stz	LastDevice		stz	DeviceSoFar		ldx	#maxDevices-2		; initialize our skip table@init		stz	SkipDeviceTbl,x		dex		dex		bpl	@initendInit		rts		ENDP;; MarkDeviceOnline -- mark device in (A) as ONLINE in the online device bit table;.....................................................................MarkDeviceOnline PROC	EXPORT		phb		phk		plb				pha		lsr	a		lsr	a		lsr	a					tax				; index into online device table		lda	1,s		and	#7		tay				; index into mask table				SEP	#$20		LONGA	OFF				lda	OnlineDeviceTable,x		ora	OnlineMasks,y		sta	OnlineDeviceTable,x				REP	#$20		LONGA	ON				pla		plb		rtl		ENDP;; MarkDeviceOffline -- mark device in (A) as OFFLINE in the online device bit table;.....................................................................		MarkDeviceOffline PROC	EXPORT		phb		phk		plb				pha		lsr	a		lsr	a		lsr	a					tax				; index into online device table		lda	1,s		and	#7		tay				; index into mask table				SEP	#$20		LONGA	OFF				lda	OnlineDeviceTable,x		and	OfflineMasks,y		sta	OnlineDeviceTable,x				REP	#$20		LONGA	ON				pla		plb		rtl		ENDP;; IsDeviceOffline -- Check if the device in (A)'s bit is ON for ONLINE in the OnlineDeviceTable;; OUT: carry set if device is online;.....................................................................		IsDeviceOnline PROC	EXPORT		phb		phk		plb				pha		lsr	a		lsr	a		lsr	a					tax				; index into online device table		lda	1,s		and	#7		tay				; index into mask table				SEP	#$20		LONGA	OFF				lda	OnlineDeviceTable,x		and	OnlineMasks,y				REP	#$20		LONGA	ON				bne	@online				clc		pla		plb		rtl		@online		sec		pla		plb		rtl		ENDP		*************************************************************************************************** MarkVolumeChanged - This procedure takes a device number and marks it dirty in our device*		      changed bit table. This is used by Finder's main event loop to determine*		      if a device needs re-read to update windows.*		MarkVolumeChanged PROCNAME	EXPORT		phb		phk		plb				tay				;device number		and	#$007F			;only devices 1-127 are valid		lsr	a		lsr	a		lsr	a					tax				;index into dirty device table		tya				;orginal device number		and	#7		tay				;index into mask table				SEP	#$20		LONGA	OFF				lda	DirtyDeviceTable,x	;get any previously dirty devices		ora	ChangedMasks,y		;we're sharing this table with the online/offline code		sta	DirtyDeviceTable,x	;moosh in this dirty device				REP	#$20		LONGA	ON				plb		rts		ENDP*************************************************************************************************** FindChangedVolume - This function looks through the volume dirty table and returns a device*		      for a volume that needs re-read. If no devices are dirty, the carry is*		      returned set. If one is found to be dirty, the carry is returned clear, and*		      the Accumulator contains a dirty device number. When a device is found as*		      dirty, its table entry is cleared to be not dirty on exit.*FindChangedVolume PROCNAME	EXPORT		phb		phk		plb		ldx	#(MaxDevices/8)-1	;8 devices per byte, zero-based table		SEP	#$30		LONGA	OFF		LONGI	OFF@checkForDirty	lda	DirtyDeviceTable,x	;get a byte of dirty flags		bne	@foundDirtyByte		dex		bpl	@checkForDirty		REP	#$30		LONGA	ON		LONGI	ON		plb		sec				;no dirty devices found				rtl* Ok, we've found a byte with some dirty bits in it. Figure out a device number for one of the bits* that's set. When we get here, X contains an index into the proper byte, so if we multiply it by 8,* we'll have bits 6-3 of the dev num. We'll always return the high bit clear. So we need to figure* out bits 2-0. Follow along...		LONGA	OFF			;we're still in short mode here		LONGI	OFF@foundDirtyByte	pha				;there's a dirty bit in here somewhere		ldy	#-1@checkNextBit	iny		lda	1,s		and	ChangedMasks,y		;is this device one that is dirty?				beq	@checkNextBit* That was simple. Y now contains a 3 bit value that we'll use for bits 2-0 of the device number.		* Now we'll calculate the high order bits 6-3. Oh, we'll also clear the dirty bit from the table* while we're at it.@foundDirtyBit	lda	DirtyDeviceTable,x		and	UnchangedMasks,y	;this device is not dirty any more (or will be when the caller is done)		sta	DirtyDeviceTable,x		txa				;contains index to byte we found a dirty bit in		asl	a		asl	a		asl	a			;shift this up to bits 6-3		sta	1,s		tya		clc		adc	1,s			;and, lo, there was a device number		ply				;this was temp space		rep	#$30		LONGA	ON		LONGI	ON				and	#$007F			;make the device number valid		plb		clc				;we've got a valid device number for them				rtl				ENDP		*===============================================**	Write a string to the Console driver	**						** INPUT:	---- STACK ----			**		strPtr (Ptr) - P string		**	SP -->					**						** OUTPUT:	none				**===============================================*ConsoleWrite	PROC	EXPORT		InitFrame		FrameType  SaveB		; save data bank		strPtr		Param	Ptr			; input parameter		IMPORT	DevInfoParams:recDevInfo		IMPORT	DevCtrlParams:recDevControl		IMPORT	OpenParams:recOpen		IMPORT	WriteParams:recWrite		IMPORT	DeviceInfo		IMPORT	DeviceControl		IMPORT	OpenFile		IMPORT	WriteFile		IMPORT	CloseFile				EntryCode;-----------------------------------------------Begin		phk		plb;--- First find the ".CONSOLE" driver ----------		lda	#8			; initialize record		sta	DevInfoParams.pcount		stz	DevInfoParams.devNum		lda	#NameBuffer1		sta	DevInfoParams.devName		lda	#NameBuffer1>>16		sta	DevInfoParams.devName+2@loop		inc	DevInfoParams.devNum		jsr	DeviceInfo		bcs	End		lda	DevInfoParams.devID		cmp	#ConsoleDriver		; is it the .CONSOLE driver ?		bne	@loop			; no;--- Reset the ".CONSOLE" driver ---------------		lda	#5			; initialize record		sta	DevCtrlParams.pcount		lda	DevInfoParams.devNum		sta	DevCtrlParams.devNum		stz	DevCtrlParams.ctrlCode	; do a reset		lda	#ControlList		sta	DevCtrlParams.ctrlList		lda	#ControlList>>16		sta	DevCtrlParams.ctrlList+2				jsr	DeviceControl		;--- Open the ".CONSOLE" driver ----------------		lda	#2			; initialize record		sta	OpenParams.pcount		lda	#Name1		sta	OpenParams.pathname		lda	#Name1>>16		sta	OpenParams.pathname+2				jsr	OpenFile		bcs	End		;--- Write string to driver -------------------						lda	#4			; initialize record		sta	WriteParams.pcount				lda	[<strPtr]		; length of data		and	#$00FF		sta	WriteParams.request		*		inc4	<strPtr			; skip length byte*		lda	<strPtr			; pointer to data*		sta	WriteParams.buffer*		lda	<strPtr+2*		sta	WriteParams.buffer+2		jsr	Kludge		lda	OpenParams.refNum		jsr	WriteFile;--- Close the driver -------------------------				lda	OpenParams.refNum		jsr	CloseFileEnd;-----------------------------------------------		ExitCode			; return to caller	;--- Start of Kludge ---------------------------Kludge		IMPORT	PStringCopy				pushZLong <strPtr		PushLong #Name1+4		jsl	PStringCopy		lda	#$0F0C			; clear viewport, home cursor, inverse		sta	Name1+0		lda	#$141A			; clear line, set horizontal position		sta	Name1+2				lda	#80		sec		sbc	WriteParams.request		lsr	a		clc		adc	#32				sep	#$20		sta	Name1+4			; horizontal position		rep	#$20		lda	WriteParams.request		clc		adc	#6		sta	WriteParams.request		tay		lda	#$0E			; set normal display mode		sta	Name1-1,y		lda	#Name1			; pointer to data		sta	WriteParams.buffer		lda	#Name1>>16		sta	WriteParams.buffer+2		rts;--- End of Kludge -----------------------------		ENDP		*===============================================**		Lock/Unlock a file		**						** IN:	---- STACK ----				**	flag 	(Word) - 0: unlock, 1: lock	**	pathPtr (Ptr) - Class 1			**  SP->						**						** OUT:	none					**===============================================*LockTheFile	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)		pathPtr		Param	Ptr			; input parameters (reverse order)flag		Param	Word		IMPORT	FileInfoParams:recFileInfo				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#2		sta	FileInfoParams.pcount				lda	<pathPtr		sta	FileInfoParams.pathname		lda	<pathPtr+2		sta	FileInfoParams.pathname+2		ldy	#osGetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOS		bcs	End				lda	FileInfoParams.access	; get current access		ora	#$00C2			; unlock (just in case)		ldx	<flag			; Lock or Unlock?		beq	store		and	#$FF3D			; lock itstore		sta	FileInfoParams.accessset		ldy	#osSetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOSEnd;-----------------------------------------------		ExitCode			; return to caller		*===============================================**		Disable/Enable a file		**						** IN:	---- STACK ----				**	flag 	(Word) - 0: enable, 1: disable	**	pathPtr (Ptr) - Class 1			**  SP->						**						** OUT:	none					**===============================================*DisableTheFile	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)		pathPtr		Param	Ptr			; input parameters (reverse order)flag		Param	Word		IMPORT	FileInfoParams:recFileInfo				EntryCode;-----------------------------------------------Begin		phk		plb				lda	#4		sta	FileInfoParams.pcount				lda	<pathPtr		sta	FileInfoParams.pathname		lda	<pathPtr+2		sta	FileInfoParams.pathname+2		ldy	#osGetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOS		bcs	End		lda	FileInfoParams.auxtype	; get AuxType field		and	#$7FFF			; make it Active		ldx	<flag			; disable/enable ?		beq	storeAux		ora	#$8000			; make it InactivestoreAux	sta	FileInfoParams.auxtype				ldy	#osSetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOSEnd;-----------------------------------------------		ExitCode			; return to caller		ENDP		*===============================================**		Walk a Directory		**						** Recursively walk a directory and count files,	** folders,and total the block/byte sizes.	**						** INPUT:	---- STACK ----			**		pathnamePtr (ptr) - class1	**		folderCountPtr (ptr)		**		fileCountPtr (ptr)		**		blockCountPtr (ptr)		**		byteCountPtr (ptr)		**		countInvisible (bool)		**	SP -->					**						** OUTPUT:	none				**						** Note:	a-reg has error code, $8000 = special	**	carry set on error (data is invalid)	**===============================================*WalkDirectory	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; saveB, return A reg (and carry)byteCount	Local	Long			; local variablesblockCount	Local	LongfileCount	Local	LongfolderCount	Local	LongentryCount	Local	IntegercurFile		Local	IntegerstartStack	Local	IntegergetSizes	Local	BooleanerrorCode	Local	WordcheckKeyTick	Local	Word			;19-Mar-93 JCMcountInvisible	Param	Boolean			; input parameters (reverse order)byteCountPtr	Param	PtrblockCountPtr	Param	PtrfileCountPtr	Param	PtrfolderCountPtr	Param	PtrpathnamePtr	Param	Ptr		IMPORT	OpenParams:recOpen		IMPORT	DirParams:recGetDirEntry				IMPORT	PathSubName		IMPORT	PathAddName		IMPORT	OpenFile		IMPORT	CloseFile		IMPORT	GetDirEntry		IMPORT	WStringCopy				IMPORT	eventRec		; Mensch 5/17/89 (fixing BRC #46359)		IMPORT	LongPathAddName; end Mensch 5/17/89 (BRC #46359)		EntryCode;----------------------------------------------Begin		phk		plb		jsr	InitWalk		; initialize variables				tsc		sta	<startStack		; remember for recursion			;--- Start of Recursion ------------------------START		jsr	OpenFile		; open the directory		bcc	count		cmp	#$4E			; network access error ?		beq	special		brl	ERRORspecial		lda	#$8000			; mark as special access error		sta	<errorCode		brl	STOP2		count		jsr	CountEntries		; get number of entries		bne	WHILE		brl	STOP		WHILE		jsr	ProcessEntry		; process each entry; Mensch 5/17/89 (fixing BRC #46359)		bcc	@EntryOK		; reverse stepping-stone		brl	ERROR			; because ERROR is too far away@EntryOK; end Mensch 5/17/89 (BRC #46359)		*** Added - 18-Mar-93 JCM - Check for command-period to terminate the calculate. We***			    look for keys every 1/2 of a second so we don't slow down***			    the operation much.		pha		pha		_TickCount		pla		tax		ply		sec		sbc	<checkKeyTick		cmp	#30			;1/2 second intervals		blt	@checkEntryType		;not enough time has passed, calc some more@checkEvents	stx	<checkKeyTick		pha				;Space for result.		PushWord #$0028			;keyDown and autoKeyEvts		PushLong #eventRec		;ptr to event record		_GetNextEvent		pla				;Return event code.		beq	@checkEntryType		;nothing doing this time			lda	>eventRec+owhat		;get the event.what field		cmp	#keyDownEvt		beq	@checkOAPeriod			cmp	#autoKeyEvt		bne	@checkEntryType		@checkOAPeriod	lda	>eventRec+omessage		cmp	#'.'		bne	@checkEntryType				lda	>eventRec+omodifiers		and	#appleKey		beq	@checkEntryType		lda	#$4000			;user terminated the calc				brl	ERROR		@checkEntryType		*** End - 18-Mar-93 JCM		lda	DirParams.fileType	; is this entry a directory?		cmp	#$0F		bne	continue		; no; Mensch 5/15/90 (fixing BRC #46359); Make this situation handle path name length errors; to make the Finder more robust for longer pathnames.		PushLong	#Name1		; move down to child directory		PushLong	#LocalPathName		jsl		PathAddName		bcc		@okPath		lda		#FINameTooLong		sta		GSOSErrCode		jsr		GSOSError		stz		GSOSErrCode		stz		DirParams.fileType		bra		continue@okPath		PushWord OpenParams.refNum	; save current state (for recursion)		PushZWord <curFile		PushZWord <entryCount; new end 5/22/89; end Mensch 5/17/89 (BRC #46359)				brl	START			; walk this directory (recursive)continue	lda	<curFile		; return from recursion		cmp	<entryCount		bcs	STOP			; end of directory		inc	<curFile		brl	WHILE			; get next entry;-----------------------------------------------STOP		lda	OpenParams.refNum	; close the file		jsr	CloseFile		bcs	ERRORSTOP2		tsc				; check for termination (of recursion)		cmp	<startStack		beq	done			; all done		PushLong #LocalPathName		jsl	PathSubName		; back up to parent directory				PullWord <entryCount		; get old state (from recursive call)		PullWord <curFile		PullWord OpenParams.refNum		bra	continue		; continue where we left offdone		jsr	ReturnData		lda	<errorCode		; report any errorsEnd;----------------------------------------------		ExitCode 		;-----------------------------------------------ERROR		pha		lda	#0			; close all open files		jsr	CloseFile		pla				ldx	<startStack		; abort the recursion		txs		bra	End			; a-reg has error code	;-----------------------------------------------ReturnDatagetBytes	ldy	#2		lda	<byteCountPtr+1		; does caller want byte count ?		beq	getBlocks		lda	<byteCount		sta	[<byteCountPtr]		lda	<byteCount+2		sta	[<byteCountPtr],y	; y set abovegetBlocks	lda	<blockCountPtr+1	; does caller want block count ?		beq	getFiles		lda	<blockCount		sta	[<blockCountPtr]		lda	<blockCount+2		sta	[<blockCountPtr],y	; y set abovegetFiles	lda	<fileCountPtr+1		; does caller want file count ?		beq	getFolders		lda	<fileCount		sta	[<fileCountPtr]		lda	<fileCount+2		sta	[<fileCountPtr],y	; y set abovegetFolders	lda	<folderCountPtr+1	; does caller want folder count ?		beq	endReturnData		lda	<folderCount		sta	[<folderCountPtr]		lda	<folderCount+2		sta	[<folderCountPtr],y	; y set above		endReturnData	rts;===============================================;	Initialize local variables;===============================================InitWalk		PushZLong <pathnamePtr		PushLong #LocalPathName		jsl	WStringCopy		stz	<folderCount		; initialize counters		stz	<folderCount+2		stz	<fileCount		stz	<fileCount+2		stz	<byteCount		stz	<byteCount+2		stz	<blockCount		stz	<blockCount+2		stz	<getSizes		stz	<errorCode		stz	<checkKeyTick		;19-Mar-93 JCM				lda	<byteCountPtr+1		; does caller want sizes ?		ora	<blockCountPtr+1		beq	getPC			; no		inc	<getSizes		; yesgetPC		lda	#3			; set up pCounts		sta	OpenParams.pcount		ldx	#12			; DJB 06/16/89 Changed from #7		lda	<getSizes		beq	setPC		stz	DirParams.optionList	; we don't need optional data		stz	DirParams.optionList+2		ldx	#17			; need size parameters toosetPC		stx	DirParams.pCount						lda	#$0001			; read only access		sta	OpenParams.reqAccess		lda	#LocalPathName		sta	OpenParams.pathname		lda	#LocalPathName>>16		sta	OpenParams.pathname+2				lda	#NameBuffer1		; the entry names will go here		sta	DirParams.name		lda	#NameBuffer1>>16		sta	DirParams.name+2		endInitWalk	rts		;===============================================;	Count file and get size of each entry;===============================================ProcessEntry		stz	DirParams.fileType	; in case we abort this entry		ldx	#0			; base <-- 0		ldy	<curFile		; displacement <-- <curFile		lda	OpenParams.refNum		jsr	GetDirEntry		; get entry's data		bcc	access				cmp	#$4E			; network access error ?		bne	isEnd		lda	#$8000			; special error code		sta	<errorCode		bra	endGood			; ignore this entryisEnd		cmp	#$61			; end of directory ??		sec		bne	endProcess		; no, some other error		stz	DirParams.fileType		lda	<curFile		; fake a termination		sta	<entryCount		bra	endGood		access		lda	DirParams.access	; get access value		and	#$0004			; check the invisible bit		beq	type			; not set				lda	<countInvisible		; should invisible files be counted?		beq	endGood			; no, so go to next catalog entry		type		lda	DirParams.fileType		cmp	#$0F			; a folder ?		beq	folder		inc	<fileCount		; count the file		bne	size		inc	<fileCount+2		bra	sizefolder		inc	<folderCount		; count the folder		bne	size		inc	<folderCount+2		size		lda	<getSizes		; does caller want sizes ?		beq	endGood					clc		lda	<byteCount		; count bytes		adc	DirParams.bytes		sta	<byteCount		lda 	<byteCount+2		;fix BRC 53957 -- andy		adc	dirParams.bytes+2	;		sta	<byteCount+2		;		clc		lda	<blockCount		; count blocks		adc	DirParams.blocks		sta	<blockCount		lda	<blockCount+2		adc	dirParams.blocks+2		sta	<blockCount+2		lda	DirParams.flags		; is it an extended file?		bpl	endGood				clc		lda	<byteCount		; count resc bytes		adc	DirParams.rescBytes		sta	<byteCount		lda	<byteCount+2		adc	dirParams.rescBytes+2		sta	<byteCount+2				clc		lda	<blockCount		; count resc blocks		adc	DirParams.rescBlocks		sta	<blockCount		lda	<blockCount+2		adc	dirParams.rescBlocks+2		sta	<blockCount+2		;end fix BRC 53957 -- andyendGood		clcendProcess	rts				; return carry flag;===============================================;    Get the number of entires in directory;===============================================CountEntries		ldx	#0			; base <-- 0		ldy	#0			; displacement <-- 0		lda	OpenParams.refNum		jsr	GetDirEntry		; get number of entries		bcc	okCount		lda	#0			; set equal flag		sta	<entryCount		bra	endCountokCount		lda	#1		sta	<curFile		; start at first entry		lda	DirParams.entryNum		sta	<entryCountendCount	rts				; return equal flag		ENDP		*===============================================**	Read a directory entry			**===============================================*GetDirEntry	PROC		IMPORT	DirParams:recGetDirEntry				stx	DirParams.base		; x-reg has base		sty	DirParams.displace	; y-reg has displacement		sta	DirParams.refNum	; a-reg has ref number		ldy	#osGetDirEntry		lda	#DirParams		ldx	#DirParams>>16		jsr	CallGSOS		rts		ENDP		*===============================================**	Set File Info				**===============================================*SetFileInfo	PROC		ldy	#osSetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOS		rts		ENDP		*===============================================**	Open up a file				**===============================================*OpenFile	PROC		ldy	#osOpen		lda	#OpenParams		ldx	#OpenParams>>16		jsr	CallGSOS		rts				ENDP		*===============================================**	Write data to a file			**===============================================*WriteFile	PROC		IMPORT	WriteParams:recWrite		sta	WriteParams.refnum	; a-reg has ref number		ldy	#osWrite		lda	#WriteParams		ldx	#WriteParams>>16		jsr	CallGSOS		rts				ENDP		*===============================================**	Close up a file				**===============================================*CloseFile	PROC		IMPORT	CloseParams:recClose		sta	CloseParams.refnum	; a-reg has ref number		lda	#1		sta	CloseParams.pCount		ldy	#osClose		lda	#CloseParams		ldx	#CloseParams>>16		jsr	CallGSOS		rts		ENDP		*===============================================**	Get Info on a Device			**===============================================*DeviceInfo	PROC		IMPORT	DevInfoParams:recDevInfo		ldy	#osDevInfo		lda	#DevInfoParams		ldx	#DevInfoParams>>16		jsr	CallGSOS		rts		ENDP*===============================================**	Send a Device Control information	**===============================================*DeviceControl	PROC		IMPORT	DevCtrlParams:recDevControl		ldy	#osDevControl		lda	#DevCtrlParams		ldx	#DevCtrlParams>>16		jsr	CallGSOS		rts		ENDP*===============================================**	Add/delete entry in Notify Queue	**						** IN:	none					**						** OUT:	none					**===============================================*		AddNotifyProc	PROC	EXPORT		IMPORT	NotifyParams:recNotifyProc				jsl	GSOSCall		DC.W	osAddNotifyProc		DC.L	NotifyParams		rtl		EXPORT	DelNotifyProcDelNotifyProc		jsl	GSOSCall		DC.W	osDelNotifyProc		DC.L	NotifyParams		rtl		ENDP*===============================================**	GS/OS Notification Procedure		**						** IN:	none					**						** OUT:	none					**===============================================*NotifyProc	PROC		IMPORT	DevInfoParams:recDevInfo		import	allowTellFinderCalls;;;app1Evt	equ	$000C			; volume change - 18-Mar-93 JCM - not used any more;app2Evt	equ	$000D			; disk switch - 18-Mar-93 JCM - in e16.event;--- Standard Notify Queue Header ---------------Header		DC.L	0					; next task link		DC.W	0					; reserved		DC.W	$A55A					; signature		DC.L	neDiskInsert+neDiskEject+neVolChange	; event mask (added neVolChange 21-Aug-92 DAL)EventCode	DC.L	0					; event code;------------------------------------------------		phk		plb				sta	EventData		lda	GlobalStartupFlag		beq	@notStartingUp				lda	EventData		cmp	DeviceSoFar		bge	exit		@notStartingUp	lda	EventCode		cmp	#neDiskInsert		beq	diskInsert		cmp	#neDiskEject		beq	diskEject		cmp	#neVolChange		bne	exitvolumeChange*** Changed 21-Aug-92 DAL;		lda	EventData;		cmp	#0			; was it a Network volume?;		bne	exit			; no, so ignore it (for now)		lda	>allowTellFinderCalls		beq	exit*** end 21-Aug-92*** Changed - 7-Feb-93 JCM - We now maintain our volume changed status in a device bit table,***			     where each bit represents a device that possibly needs windows***			     updated. The old app1Evt mechanism posted an event each time we***			     got called, which meant there could be multiple updates pending***			     when Finder's main loop got control. That was icky, and tends to***			     really bog down programs that can do a lot of writing within Finder,***			     such as HardPressed or AutoArk.;;;		pha				; space for result;;;		PushWord #app1Evt		; event code (application defined);;;		PushWord EventData		; event message (hi word) = GS/OS call #;;;		phx				; event message (lo word) = device #;;;		_PostEvent;;;		pla		txa				;device number		jsr	MarkVolumeChanged	;add this device to our dirty table				*** End - 7-Feb-93 JCM				bra	exitdiskInsert	ldy	#$8000			; insert flag bit on		bra	diskSwitchdiskEject	ldy	#$0000			; insert flag bit offdiskSwitch	ldx	EventData		; should we skip this device ?		dex		cpx	#maxDevices				bcs	post			; ouside our table		lda	SkipDeviceTbl,x		and	#$00FF			; byte entries		bne	exit			; Disk][ , non-removable, or non-blockpost		pha				; space for result		PushWord #app2Evt		; event code (application defined)		phy				; event message (hi word) = type		PushWord EventData		; event message (lo word) = device #		_PostEvent			; post it to the Event Manager		plaexit		rtlEventData	DC.W	0		ENDP*===============================================**   Get the  modify date for a file/folder	**						** IN:	---- STACK ----				**	pathPtr (Ptr) - Class 1			**	datePtr (Ptr)				**  SP->						**						** OUT:	none					**===============================================*GetModifyDate	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)datePtr		Param	Ptr			; input parameters (reverse order)pathPtr		Param	Ptr		IMPORT	FileInfoParams:recFileInfo				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#7		sta	FileInfoParams.pcount				lda	<pathPtr		sta	FileInfoParams.pathname		lda	<pathPtr+2		sta	FileInfoParams.pathname+2		ldy	#osGetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOS		bcs	End				ldy	#6@loop		lda	FileInfoParams.modify,y		sta	[<datePtr],y		dey		dey		bpl	@loop		lda	#0			; no errorsEnd;-----------------------------------------------		ExitCode				ENDP*===============================================**   Get the FinderInfo for a file/folder	**						** IN:	---- STACK ----				**	pathPtr (Ptr) - Class 1			**	infoPtr (Ptr)				**  SP->						**						** OUT:	none					**===============================================*GetFinderInfo	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)infoPtr		Param	Ptr			; input parameters (reverse order)pathPtr		Param	Ptr		IMPORT	FileInfoParams:recFileInfo		IMPORT	OptionList:recOptionList				EntryCode;-----------------------------------------------Begin		phk		plb				lda	#8				; initialize record		sta	FileInfoParams.pcount		lda	<pathPtr		sta	FileInfoParams.pathname		lda	<pathPtr+2		sta	FileInfoParams.pathname+2		lda	#OptionListBuff		sta	FileInfoParams.optionList		lda	#OptionListBuff>>16		sta	FileInfoParams.optionList+2		stz	OptionListSize		ldy	#osGetFileInfo		lda	#FileInfoParams		ldx	#FileInfoParams>>16		jsr	CallGSOS		bcc	ok		brl	Endok		lda	OptionListSize		bne	good		lda	#$FFFF		brl	End				; no data		good		ldy	#FinderInfo.location		lda	OptionList.fInfo.frLocation.v		xba		lsr	a				; pixel adjustment		sta	[<infoPtr],y		iny		iny		lda	OptionList.fInfo.frLocation.h		xba		sta	[<infoPtr],y				lda	FileInfoParams.filetype		cmp	#$0F		beq	folder				ldy	#FinderInfo.windRect		; zero out other fields		lda	#0@loop		sta	[<infoPtr],y		iny		iny		cpy	#FinderInfo.sizeOf		bcc	@loop		brl	done		folder		jsr	AdjustRect			; get window's rect		ldy	#FinderInfo.windView		; get window's view		lda	OptionList.fInfo.frView;; From observations: 	$0000 = by Icon;			$0001 = by Icon;			$8001 = by Icon;;			$4001 = by Small Icon;			$4002 = by Name;			$4003 = by Date;			$4004 = by Size;			$4005 = by Kind;			$4007 = by Label;		asl	a				;AND #$7FFF (Dave sez)		lsr	a		cmp	#1		bne	@notByIcon		dec 	a@notByIcon	and	#$0007		cmp	#6		blt	@setView		lda	#1				;default to view by small icon@setView	sta	[<infoPtr],y				ldy	#FinderInfo.windScroll		; get scroll bar offsets		lda	OptionList.fInfo.frScroll.v		xba		sta	[<infoPtr],y		iny		iny		lda	OptionList.fInfo.frScroll.h		xba		asl	a				; pixel adjustment		sta	[<infoPtr],ydone		lda	#0End;-----------------------------------------------		ExitCode*===============================================** Adjust the window RECT so it fits on our	** screen.					**===============================================*AdjustRectmenuY		set	13			; menu bartitleY		set	13			; title barinfoY		set	11			; info barscrollY		set	13			; scroll barscrollX		set	26			; scroll bariconX		set	78			; space for iconswindY		set	titleY+infoY+scrollYstartY		set	menuY+titleY+infoY	; where a window can startstartX		set	4maxY		set	200-menuY-windY-1	; max window size on a IIGS screenmaxX		set	640-startX-scrollX-iconXminY		set	39minX		set	99;-----------------------------------------------		ldy	#6		flip		lda	OptionList.fInfo.frRect.top,y		xba					; 68000 --> 65816 format		bne	flipped		cpy	#2				; only left side can be zero		bne	zeroesflipped		sta	OptionList.fInfo.frRect.top,y		dey		dey		bpl	flip		bra	adjustzeroes		ldy	#FinderInfo.windRect		; bogus data		lda	#0				; just return all zeroes@zero		sta	[<infoPtr],y		iny		iny		cpy	#FinderInfo.windRect+8		bcc	@zero		brl	endAdjustadjust		lda	#1				;always make it land on an even		trb	OptionList.fInfo.frRect.left	;pixel boundary -- andy and DAL, 1/9/91				sec					; winHeight <-- (bottom - top)		lda	OptionList.fInfo.frRect.bottom		sbc	OptionList.fInfo.frRect.top		lsr	a				; to translate square pixels		beq	zeroes		cmp	#minY		bcc	@minHeight		cmp	#maxY+1		bcc	setDY@minHeight	lda	#maxY				; clip itsetDY		sta	winHeight		sec					; winWidth <-- (right - left)		lda	OptionList.fInfo.frRect.right		sbc	OptionList.fInfo.frRect.left		beq	zeroes		cmp	#minX		bcc	@minWidth		cmp	#maxX+1		bcc	setDX@minWidth	lda	#maxX				; clip itsetDX		sta	winWidthsetTop		ldy	#FinderInfo.windRect		lda	OptionList.fInfo.frRect.top	; set rect.top (y-39)/2 + 37		bmi	defaultY		lsr	a				; translate square pixels		clc		adc	#37-(39/2)			; adjust starting position		sta	[<infoPtr],y		clc		adc	winHeight			; does it fit		cmp	#maxY+1		bcc	setBottomdefaultY	lda	#startY				; no, so squeze it in		sta	[<infoPtr],y		setBottom	clc					; set rect.botom		lda	[<infoPtr],y		ldy	#FinderInfo.windRect+4		adc	winHeight		sta	[<infoPtr],y			setLeft		ldy	#FinderInfo.windRect+2		lda	OptionList.fInfo.frRect.left	; set rect.left		cmp	#maxX-20		bcs	defaultX		sta	[<infoPtr],y		adc	winWidth			; carry is clear		cmp	#maxX+1				; does it fit		bcc	setRightdefaultX	lda	#startX				; no, so squeze it in		sta	[<infoPtr],y		setRight	clc					; set rect.right		lda	[<infoPtr],y		ldy	#FinderInfo.windRect+6		adc	winWidth		sta	[<infoPtr],yendAdjust	rts		ENDP		*===============================================**	Enable/Disable the GS/OS Alerts		**						** IN:	---- STACK ----				**	flag 	(word) - 0: enable, 1: disable	**  SP->						**						** OUT:	none					**===============================================*SetGSOSAlerts	PROC	EXPORT		InitFrame		FrameType  SaveB		; save data bank		flag		Param	Word			; input parameter		IMPORT	SysPrefsParams:recSysPrefs				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#1		sta	SysPrefsParams.pcount		jsl	GSOSCall			; get current settings		DC.W	osGetSysPrefs		DC.L	SysPrefsParams		bcs	End				; abort if error		lda	<flag		beq	enable		disable		lda	SysPrefsParams.preferences		and	#(Å(volMountAlert)<<16)>>16	; no volume mount alerts (clr bit)		ora	#noErrAlerts			; no error alerts (set bit)		sta	SysPrefsParams.preferences		bra	setenable		lda	SysPrefsParams.preferences		and	#Å(noErrAlerts)			; enable error alerts (clr bit)		sta	SysPrefsParams.preferencesset		jsl	GSOSCall		DC.W	osSetSysPrefs		DC.L	SysPrefsParamsEnd;------------------------------------------------------		ExitCode		ENDP		*===============================================**  Set the access privileges for a folder and	**  all of its children folders.			**						**  This routine does a recursive walk to reach  **  all of the children. If a folder does not 	**  have search privileges, it's priviliges are	**  temporary changed (to search) so that the	**  walk can continue. On the way back up (as 	**  folders are closed) the new privileges are	**  set.						**						** INPUT:	---- STACK ----			**		access (long)			**		ownerPtr (long)	- pascal	**		groupPtr (long)	- pascal	**		pathPtr (long)	- class1	**	SP -->					**						** OUTPUT:	none				**===============================================*SetAllPriv	PROC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)tempAccess	Local	Long			; local variablesstartStack	Local	IntegercurFile		Local	IntegerentryCount	Local	IntegererrorCode	Local	WordpathnamePtr	Param	Ptr			; input parameters (revese order)groupPtr	Param	PtrownerPtr	Param	Ptraccess		Param	long		IMPORT	OpenParams:recOpen		IMPORT	DirParams:recGetDirEntry		IMPORT	OptionList:recOptionList				IMPORT	PathSubName		IMPORT	PathAddName		IMPORT	OpenFile		IMPORT	CloseFile		IMPORT	GetDirEntry		IMPORT	WStringCopy; Mensch 5/17/89 (Fixing BRC #46359)		IMPORT	GSOSErr		IMPORT	LongPathAddName; end Mensch 5/17/89 (BRC #46359)		EntryCode;----------------------------------------------Begin		phk		plb		jsr	InitWalk		; initialize variables		bcc	stack		brl	ERROR		stack		tsc		sta	<startStack		; remember for recursion		;--- Start of Recursion ------------------------START		jsr	OpenFile		; open the directory		bcc	count		sta	<errorCode		cmp	#$4E			; just an accesss error		beq	term			; so skip this folder		brl	ERROR		count		jsr	CountEntries		; get number of entries		beq	STOP		; Mensch 5/17/89 (Fixing BRC #46359); Also, see if the path is too long.  If so, then skip this directory altogether as;  if it were empty.; Insert error checking code here so that the path addname error will be reported;   to the user and flagged as an error.		lda	>LocalPathName		; get the length of the pathname		cmp	#MaxPathLen		; see if it is too long		bcc	@LooksGood		; if less than MaxPathLen, then let's do it		lda	#FINameTooLong		; Internal "name too long" error		sta	GSOSErrCode		jsr	GSOSError		stz	GSOSErrCode		lda	#0			; set equal flag		sta	<entryCount		beq	STOP@LooksGood; end Mensch 5/17/89 (BRC #46359)		WHILE		jsr	ProcessEntry		; process each entry		bcs	ERROR				lda	DirParams.fileType	; is this entry a directory?		cmp	#$0F		bne	continue		; no				PushWord OpenParams.refNum	; save current state (for recursion)		PushZWord <curFile		PushZWord <entryCount		bra	START			; walk this directory (recursive)continue	lda	<curFile		; returns from recursion here		cmp	<entryCount		bcs	STOP			; end of directory		inc	<curFile		bra	WHILE			; get next entry;-----------------------------------------------STOP		lda	OpenParams.refNum	; close the file		jsr	CloseFile		PushZLong <access		; new access rights		PushZLong <ownerPtr		; ptr to owner string		PushZLong <groupPtr		; ptr to group string		PushLong #LocalPathName		; ptr to pathname		jsl	SetPrivileges		bcc	term		cmp	#$4E			; just an access error ?		bne	ERROR		sta	<errorCodeterm		tsc				; check for termination (of recursion)		cmp	<startStack		beq	done			; all done				PushLong #LocalPathName		jsl	PathSubName		; back up to parent directory		PullWord <entryCount		; get old state (from recursive call)		PullWord <curFile		PullWord OpenParams.refNum		bra	continue		; continue where we left offdone		lda	<errorCode		; report any errorsEnd;----------------------------------------------		ExitCode 		;-----------------------------------------------ERROR		pha		lda	#0			; close all open files		jsr	CloseFile		pla				; restore error code				ldx	<startStack		; abort the recursion		txs		bra	End			; a-reg has error code	;===============================================;	Initialize local variables;===============================================InitWalk		stz	<errorCode		PushZLong <pathnamePtr		PushLong #LocalPathName		jsl	WStringCopy			lda	#15			; set up pCounts		sta	DirParams.pCount		lda	#3		sta	OpenParams.pCount						lda	#$0001			; read only access		sta	OpenParams.reqAccess		lda	#LocalPathName		sta	OpenParams.pathname		lda	#LocalPathName>>16		sta	OpenParams.pathname+2				lda	#NameBuffer1		; the entry names will go here		sta	DirParams.name		lda	#NameBuffer1>>16		sta	DirParams.name+2				lda	#OptionListBuff		sta	DirParams.optionList		lda	#OptionListBuff>>16		sta	DirParams.optionList+2				lda	<access		sta	<tempAccess		lda	<access+2		; owner's access		ora	#$0300			; give it search/read access		sta	<tempAccess+2				PushZLong <tempAccess		; new access rights		PushLong #0			; skip owner string		PushLong #0			; skip group string		PushLong #LocalPathName		; ptr to pathname		jsl	SetPrivileges		bcc	endInit		cmp	#$4E			; just an access error?		sec		bne	endInit			; some other error		sta	<errorCode		clcendInit		rts				; carry/a-reg returned		;===============================================; Make sure each Folder has search privileges;===============================================ProcessEntry		stz	DirParams.fileType	; in case we abort this entry		ldx	#0			; base <-- 0		ldy	<curFile		; displacement <-- <curFile		lda	OpenParams.refNum		jsr	GetDirEntry		; get entry's data		bcc	type				cmp	#$61			; end of directory ??		sec		bne	endProcess		; no, some other error		stz	DirParams.fileType		lda	<curFile		; fake a termination		sta	<entryCount		bra	endGood		type		lda	DirParams.fileType		cmp	#$0F			; a folder ?		bne	endGood		PushLong #Name1			; move down to child directory		PushLong #LocalPathName; Mensch 5/17/89 (Fixing BRC #46359)		jsl	LongPathAddName		; was AddPathName; Insert error checking code here so that the path addname error will be reported;   to the user and flagged as an error.		bcc	@okPathName		lda	#FINameTooLong		; load the internal error number PathTooLong		sta	GSOSErrCode		jsr	GSOSError		stz	GSOSErrCode		stz	DirParams.filetype		lda	<curFile		; fake a termination		sta	<entryCount		bra	endGood@okPathName; end Mensch 5/17/89		lda	OptionList.access		and	#$0001			; does it have search access		bne	endGood				PushZLong <tempAccess		; new access rights		PushLong #0			; skip owner string		PushLong #0			; skip group string		PushLong #LocalPathName		; ptr to pathname		jsl	SetPrivileges		bcc	endProcess		cmp	#$4E			; just an access error ?		sec		bne	endProcess		; some other error		sta	<errorCode		stz	DirParams.fileType	; fake a non-folder		PushLong #LocalPathName		jsl	PathSubName		; back up (child will be skipped)endGood		clcendProcess	rts				; return carry flag;===============================================;    Get the number of entires in directory;===============================================CountEntries		ldx	#0			; base <-- 0		ldy	#0			; displacement <-- 0		lda	OpenParams.refNum		jsr	GetDirEntry		; get number of entries		bcc	okCount		lda	#0			; set equal flag		sta	<entryCount		bra	endCountokCount		lda	#1		sta	<curFile		; start at first entry		lda	DirParams.entryNum		sta	<entryCountendCount	rts				; return equal flag		ENDP		*===============================================**	Read data from a device			**						** IN:	---- STACK ----				**	space (long)				**	devNum 	(word)				**	buffPtr (Ptr)				**	reqBytes (long)				**	startBlk (long)				**	blkSize (word)				**  SP->						**						** OUT:	---- STACK ----				**	bytes (long)				**  SP->						**===============================================*DeviceRead	FUNC	EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)blkSize		Param	Word			; input parameters (reverse order)startBlk	Param	LongreqBytes	Param	LongbuffPtr		Param	PtrdevNum		Param	Wordbytes		Result	Long			; result returned		IMPORT	DevReadParams:recDevRead				EntryCode;-----------------------------------------------Begin		phk		plb		lda	#6			; init param list		sta	DevReadParams.pcount		lda	<devNum		sta	DevReadParams.devNum		lda	<buffPtr		sta	DevReadParams.buffer		lda	<buffPtr+2		sta	DevReadParams.buffer+2		lda	<reqBytes		sta	DevReadParams.reqBytes		lda	<reqBytes+2		sta	DevReadParams.reqBytes+2		lda	<startBlk		sta	DevReadParams.startBlock		lda	<startBlk+2		sta	DevReadParams.startBlock+2		lda	<blkSize		sta	DevReadParams.blockSize		jsl	GSOSCall		; read from device		DC.W	osDevRead		DC.L	DevReadParams			ldx	DevReadParams.tranBytes		stx	<bytes		ldx	DevReadParams.tranBytes+2		stx	<bytes+2		End;----------------------------------------------		ExitCode		ENDP*===============================================**	Local - Make a GSOS call		**						** IN:	a-reg has param list ptr (lo word)	**	x-reg has param list ptr (hi word)	**	y-reg has call number			**	IgnoreErrors flag is checked if error	**						** OUT:	a-reg has error code ($FFFF = cancel)	**	GSOSErrCode has error code		**	GSOSCallNumber has call number		**	GSOSParmListPtr has param list ptr	**						** carry flag set on error (if not handled)	**===============================================*CallGSOS	PROC		IMPORT	GSOSError		IMPORT	GetVolume		ENTRY	GSOSCallNumber		ENTRY	GSOSParmListPtr;-----------------------------------------------				sta	GSOSParmListPtr		stx	GSOSParmListPtr+2		sty	GSOSCallNumber		lda	IgnoreErrors		bne	call		cpy	#osOpen			; remember name of volume we're opening		bne	call		jsr	GetVolumecall		jsl	GSOSCallGSOSCallNumber	DC.W	0GSOSParmListPtr	DC.L	0				bcc	end		sta	>GSOSErrCode		ldx	IgnoreErrors		bne	end				jsr	GetVolume		; remember name of volume		jsr	GSOSError		bcc	call			; try call againend		rts				; carry flag and a-reg returned		ENDP*===============================================**	Save Volume Name (if call has one)	**						** IN:	GSOSCallNumber has call number		**	GSOSParmListPtr has param list ptr	**						** OUT:	GSOSVolName (if available)		**	GSOSFileName (if available)		**===============================================*GetVolume	PROC		IMPORT	PathGetRoot		IMPORT	PathGetName		IMPORT	PathToPStr		IMPORT	WToPString		ldx	GSOSParmListPtr		; get address		lda	GSOSCallNumber		cmp	#osCreate		; check call numbers		beq	saveVolume		cmp	#osVolume		beq	setVolume		cmp	#osDestroy		beq	saveVolume		cmp	#osChangePath		beq	saveVolume		cmp	#osSetFileInfo		beq	saveVolume		cmp	#osGetFileInfo		beq	saveVolume		cmp	#osGetDevNum		beq	saveVolume		cmp	#osFormat		beq	setByte6		cmp	#osEraseDisk		bne	opensetByte6	inx				; format/erase pathname is at byte 6		inx				; all others are at byte 2		inx		inx		bra	saveVolumesetVolume	open		cmp	#osOpen			; check for open must be last		bne	exit		inx				; open pathname is at byte 4		inx				; all others are at byte 2		saveVolume	phb		sep	#$20		lda	GSOSParmListPtr+2	; get bank		pha		plb				; same data bank as ParamList		rep	#$20		lda	|$0004,x		; get ptr to pathname		tay		lda	|$0002,x		plb		phy				; save for PathGetFile call below		pha		PushLong #GSOSVolume		phy		pha		jsl	PathGetRoot		; a "W" string		PushLong #GSOSVolume		PushLong #GSOSVolName		jsl	PathToPStr		; to Pascal string		pla				; path ptr (saved above)		ply		PushLong #GSOSVolume		phy		pha		jsl	PathGetName		; a "W" string		PushLong #GSOSVolume		PushLong #GSOSFileName		jsl	WToPString		; to Pascal srtingexit		rts		ENDP		*===============================================**    Disable/enable automatic error handling	**						** If a routine wants to handle its own errors	** or wants to ignore errors then it should call	** IgnoreGSOSError() before making calls to the	** CallGSOS() routine.				**						** IN:	none					**						** OUT:	none					**===============================================*IgnoreGSOSError	PROC	EXPORT		lda	#1		bra	setFlag				EXPORT	HandleGSOSErrorHandleGSOSError			lda	#0setFlag		sta	>IgnoreErrors		; can be called from any bank		rtl		ENDP		; LongGSOSError -- error code in (A), c1_pathname contains path we were operating on;.....................................................................LongGSOSError	PROC	EXPORT		import	c1_pathname		import	pathgetroot		import	pathtopstr		import	wtopstring		import	pathgetname				phb		phk		plb		stx	GSOSCallNumber				sta	GSOSErrCode		Pushlong #GSOSVolume		pushlong #c1_pathname		jsl	PathGetRoot		; a "W" string		Pushlong #GSOSVolume		Pushlong #GSOSVolName		jsl	PathToPStr		; to Pascal string		pushlong #GSOSVolume		pushlong #c1_pathname		jsl	PathGetName		; a "W" string		PushLong #GSOSVolume		PushLong #GSOSFileName		jsl	WToPString		; to Pascal srting				jsr	GSOSError				plb		rtl		ENDP		*===============================================**	Handle a GSOS Error			**						** IN:	GSOSErrCode, GSOSVolName		**						** OUT:	a-reg is zero for try again		**	(otherwise it has original error code)	** 	carry flag (1 = bad, 0 = ok)		**===============================================*GSOSError	PROC		IMPORT	WToPString		IMPORT	PathGetName		IMPORT	strNoWrite		; in string segment		IMPORT	strInsertDisk		IMPORT	strDamagedDisk		IMPORT	strDiskFull		IMPORT	strDirFull		IMPORT	strBadName		IMPORT	strNoAccess		IMPORT	strFileBusy		IMPORT	strDupPath		IMPORT	strBadChanges		IMPORT	strBadUser		IMPORT	strBadGroup		IMPORT	strBadChanges2		IMPORT	strSubPathTooLong		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	ArrowCursor		IMPORT	DevInfoParams:recDevInfo		IMPORT	RestoreCursor;-----------------------------------------------					lda	GSOSErrCode		ldx	#0loop		cmp	errorTable,x		beq	doCase		inx		inx		inx		inx		cpx	#endTable-errorTable		bcc	loop		bra	end			; carry set, a-reg has errordoCase		inx		inx		jsr	(errorTable,x)		eor	#$FFFF			; return carry flag, and a-reg		cmp	#$FFFF		beq	end				lda	#0			;carry clear if we get hereend		rts;-----------------------------------------------	errorTable	DC.W	$0045,_NoVolume		DC.W	$002B,_WriteProtect		DC.W	$0048,_DiskFull		DC.W	$0049,_DirectoryFull		DC.W	$0040,_BadSyntax		DC.W	$0050,_FileBusy		DC.W	$0027,_DamagedDisk 	; (I/O error)		DC.W	$002D,_DamagedDisk	; (invalid block)		DC.W	$005A,_DamagedDisk 	; (damaged bitmap)		DC.W	$0051,_DamagedDisk 	; (directory error)		DC.W	$0047,_DuplicatePath		DC.W	$007E,_BadUser		DC.W	$007F,_BadGroup		DC.W	$004F,_SmallBuffer	; buffer too small		DC.W	$0021,_WrongMedia	; trying to format 800k as 1440k?		DC.W	FINameTooLong, _PathTooLong  ; Tried to use pathname >maxPathLenendTable;-----------------------------------------------_WrongMedia	lda	inFormat		bmi	@wasWrongMedia		@notMFM		lda	#1		rts	@wasWrongMedia	lda	DevInfoParams.devID		cmp	#$17		beq	@gotMFM		cmp	#1		bne	@notMFM		@gotMFM		jsl	SaveCursor		jsl	ArrowCursor		pha		pea	0		pushlong #0		pea	$0099		_ErrorWindow		jsl	RestoreCursor		pla		rts;-----------------------------------------------_NoVolume	lda	GSOSVolName		; check for null string DJB 05/30/89		and	#$00FF		bne	@nameOK		lda	#0			; name not set (???) (used to load GSOS errorcode)			rts@nameOK		pha		pea	$00B5			;refIsResource		pushlong #GSOSVolNamePtr	;substitution string #1		pushlong #rasInsertDiskOrCancel	;resource ID		jsl	rats		rts_DamagedDisk	lda	GSOSVolName		; check for null string DJB 05/31/89		and	#$00FF		bne	@goodName		lda	GSOSErrCode		rts@goodName	pha		pea	$00B5			;refIsResource		pushlong #GSOSVolNamePtr	;substitution string #1		pushlong #rasMayBeDamaged	;resource ID		jsl	rats		rts_NoAccess	pha		pea	$00B5			;refIsResource		pushlong #GSOSFileNamePtr	;substitution string #1		pushlong #rasChangeNoAccess	;resource ID		jsl	rats		rts_WriteProtect	pha		pea	$00B5			;refIsResource		pushlong #GSOSVolNamePtr	;substitution string #1		pushlong #rasWriteProtected	;resource ID		jsl	rats		rts_DiskFull	pha		pea	$00B5			;refIsResource		pushlong #GSOSVolNamePtr	;substitution string #1		pushlong #rasDiskFull		;resource ID		jsl	rats		rts_DirectoryFull	pha		pea	$00B5			;refIsResource		pushlong #0			;substitution string #1		pushlong #rasDirFull		;resource ID		jsl	rats		rts_BadSyntax	lda	GSOSCallNumber		; check for a ChangePath call		cmp	#osChangePath		bne	use1st			; must be a create call		jsr	Get2ndNameuse1st		pha		pea	$00B5			;refIsResource		pushlong #GSOSFileNamePtr	;substitution string #1		pushlong #rasBadFilename	;resource ID		jsl	rats		rts_DuplicatePath	lda	GSOSCallNumber		; check for a ChangePath call		cmp	#osChangePath		bne	useNormal		; must be a create call		jsr	Get2ndNameuseNormal	pha		pea	$00B5			;refIsResource		pushlong #GSOSFileNamePtr	;substitution string #1		pushlong #11			;resource ID		jsl	rats		rts_BadUser	pha		pea	$00B5			;refIsResource		pushlong #0			;substitution string #1		pushlong #rasChangeBadUser	;resource ID		jsl	rats			rts_SmallBuffer	lda	#0			; ignore this error !		rts_BadGroup	pha		pea	$00B5			;refIsResource		pushlong #0			;substitution string #1		pushlong #rasChangeBadGroup	;resource ID		jsl	rats		rts		_PathTooLong	pha		pea	$00B5			;refIsResource		pushlong #0			;substitution string #1		pushlong #rasChangePathTooLong	;resource ID		jsl	rats		rts_FileBusy	pha		pea	$00B5			;refIsResource		pushlong #0			;substitution string #1		pushlong #rasFileBusy		;resource ID		jsl	rats		rts;; something funky dave showed me -- glue call, don't screw with this, andy;rats		jsl	SaveCursor		jsl	ArrowCursor				ldx	#$590e		jsl	$e10004;		_AlertWindow; %%% beginning MD 2/1/91 under Dave's watchful eye		lda	4,s			; the button #		tax		lda	2,s		sta	4,s		lda	1,s		sta	3,s		txa		sta	1,s			; now the error code is first on stack		; %%% end MD 2/1/91				jsl	restoreCursor		pla		rtl;-----------------------------------------------Get2ndName		phb				; get "new" name		sep	#$10		ldx	GSOSParmListPtr+2	; get bank of ParamList		phx		plb				; use same data bank as ParamList		rep	#$10		ldx	GSOSParmListPtr		; get address of ParamList		lda	|$0008,x		; get ptr to new pathname		tay		lda	|$0006,x		plb		PushLong #GSOSVolume		phy		pha		jsl	PathGetName		; returns a "W" string		PushLong #GSOSVolume		PushLong #GSOSFileName		jsl	WToPString		; convert to a Pascal string		rts				ENDP;; CheckOpenFiles -- check if the device has any open files;;  IN: (A) hi  word of pointer to pstr device name, no separator in front;      (X) low word of pointer to pstr device name;; OUT: carry set if the device has any open files;.....................................................................CheckOpenFiles	PROC	EXPORT		IMPORT	DevInfoParams:recDevInfo		IMPORT	PToWStringlocalPtr	equ	1		phb		phk		plb		pha		phx		pushlong #Name1		jsl	PToWString				ldx	#0				lda 	>$e100be		bmi 	@osBusy		ora 	#$8000		sta 	>$e100be			sep 	#$20		LONGA OFF				ldx	Name1			;zero terminate the wstring		lda	#0		sta	Name1+2,x				lda 	>$e0c068		pha		lda 	>$e0c08b		lda 	>$e0c08b				rep 	#$20		LONGA ON				phd		lda	#$bd00		tcd				lda	#0		ldx	#Name1		ldy	#Name1>>16		jsl	os_find_vcr		bcs	@noVCR				jsl	os_deref				pha		pha		tsc		tcd						stx	<localPtr		sty	<localPtr+2		ldy	#vcr_open_cnt				ldx	#$FFFF		lda	[<localPtr],y		bne	@hasOpenFiles				ldx	#0@hasOpenFiles	pla		pla@exitNoVCR	pld				sep 	#$20		LONGA OFF				pla		sta 	>$e0c068				rep 	#$20		LONGA ON				lda 	>$e100be		and 	#$7fff		sta 	>$e100be@osBusy		cpx	#1			;set the carry on exit		plb		rtl		@noVCR		ldx	#0		bra	@exitNoVCR				ENDP		END		