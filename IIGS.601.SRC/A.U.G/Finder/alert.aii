; Alert.aii;; Copyright 1991-92, Apple Computer, Inc.; All Rights Reserved;; history;; 2/21/91 -- andy, created;; 1992 DAL -- search for "DAL" for most changes;; 12-Jun-92 DAL -- calls DisposeHandleGlue instead of _DisposeHandle;; 25-Mar-93 JCM - LoadExtensions now attempts to create @:FinderExtras. This is;		  mainly to make magic routing happy.;;.....................................................................		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'		INCLUDE	'all.macros'		INCLUDE	'special.macros'		INCLUDE	'dp.equ'		include 'e16.resources'; doAlertWindow -- create the alertWindow passed in (A);; IN: (A) = dialog to create;; OUT: Result from AlertWindow is on stack;.....................................................................doAlertWindow	PROC	EXPORT		IMPORT	C1_Source		IMPORT	C1_Dest		IMPORT	C1_PathName		IMPORT	C1_DeviceName		IMPORT	C1_FileName		IMPORT	saveCursor		IMPORT	arrowCursor		IMPORT	restoreCursor		phb		phk		plb		pha		jsl	saveCursor		jsl	arrowCursor		lda	>C1_PathName		sta	C1_Path		tax		lda	>C1_PathName+2		sta	C1_Path+2		txa		dec	a		xba		sta	>C1_PathName+1		lda	>C1_DeviceName		;don't get rid of any periods on the		sta	C1_Device		;the front of the device name (they are		xba				;good).		sta	>C1_DeviceName		lda	>C1_FileName		sta	C1_File		xba		sta	>C1_FileName		lda	1,s			;get A back		pea	$00B5		pushlong #C1_PathNamePtr		pea	0		pha		_AlertWindow		lda	C1_Path		sta	>C1_PathName		lda	C1_Path+2		sta	>C1_PathName+2		lda	C1_Device		sta	>C1_DeviceName		lda	C1_File		sta	>C1_FileName		jsl	restoreCursor		pla		plb		tax				;force flags to be set based on (A)		rtl;; locals;C1_Path		dc.L	0C1_Device	dc.w	0C1_File		dc.w	0hex		dc.b	4		EXPORT	hexadecimalhexadecimal	ds.b	4		EXPORT	C1_PathNamePtrC1_PathNamePtr	dc.L	C1_PathName+2	;*0C1_DeviceNamePtr dc.L	C1_DeviceName+1	;*1C1_FileNamePtr	dc.L	C1_FileName+1	;*2C1_SourcePtr	dc.L	C1_Source+1	;*3C1_DestPtr	dc.L	C1_Dest+1	;*4		EXPORT	CustomPtrCustomPtr	dc.L	0		;*5		EXPORT	CustomPtr2CustomPtr2	dc.L	0		;*6hexPtr		dc.L	hex		;*7		dc.L	C1_Source+2	;*8		EXPORT	CustomPtr3CustomPtr3	dc.L	0		;*9		ENDP; GetErrorTextPtr -- find the error text for an OS error in A;; Out:  AX = pointer to text, in C1_QuitName;; Call with JSL;; NOTE:  This routine assumes all the rErrorString resources use;        standard window sizes and standard icons.  If they don't,;        it will get confused and return partly-garbled text.;....................................................................GetErrorTextPtr	proc export		import C1_QuitName		cmp #$0088		;network error?		bne @not88		lda #$FF88		;kludged code for Network error@not88		pha			;save error code		lda #0		sta >C1_QuitName	;in case things go horribly wrong		sta >C1_QuitName+2	;paranoia		jsr GetAndFixPrefs		pla			;retrieve error code		pha		pha			;space for LoadResource		pea rErrorString		pea $07FF		pha		_LoadResource		plx		ply		bcc @gotHandle		pha		pha		pea rErrorString		pea $07FF		pea $0072		;get the "unknown error" string		_LoadResource		plx		ply@gotHandle	jsr RestorePrefs		bcs @failed		;couldn't load resources; return null string		phd		pha		;space for @delimiter		pha		pha		;space for @ptr		phy		phx		;@handle		tsc		tcd@handle		equ 1@ptr		equ @handle+4@delimiter	equ @ptr+4		ldy #2		lda [<@handle],y		sta <@ptr+2		lda [<@handle]		sta <@ptr		ldx <@ptr+2		lda <@ptr		clc		adc #3		bcc @nr		inx@nr		phx		pha			;source for BlockMove		pushlong #C1_QuitName+1	;dest for BlockMove		pha		pha			;space for GetHandleSize (count for BlockMove)		pei <@handle+2		pei <@handle		_GetHandleSize		_BlockMove		ldy #2			;offset into error string to first delimiter		lda [<@ptr],y		and #$00ff		sta <@delimiter; search the error string for a match of the delimiter, or a "(", or a null		ldx #$ffff@search		inx		lda >C1_QuitName+2,x		and #$00ff		beq @gotLength		cmp #$0028	;open paren		beq @gotLength		cmp <@delimiter		bne @search@gotLength	txa		sep #$20		sta >C1_QuitName		rep #$20		ply		ply		ply		ply		ply		pld@failed		lda #^C1_QuitName		ldx #C1_QuitName		rtlGetAndFixPrefs	_GetSysPrefsGS oldPrefs		lda >oldPrefs+2		and #$1fff	;keep the reserved bits		ora #$C000	;turn on Use Volume Mount Dialog, no Cancel		sta >myPrefs+2		_SetSysPrefsGS myPrefs		rtsRestorePrefs	php		pha		phx		phy		_SetSysPrefsGS oldPrefs		ply		plx		pla		plp		rtsoldPrefs	dc.w 1		;1 parameter		dc.w 0		;the old SysPrefsmyPrefs		dc.w 1		dc.w 0		;my modified preferences		EndP; doAlertCopy -- create the alertWindow passed in (A);		 but preserve c1_dstpathname and c1_srcpathname;; IN: (A) = dialog to create;; OUT: Result from AlertWindow is on stack;.....................................................................doAlertCopy	PROC	EXPORT		IMPORT	C1_SrcPathName		IMPORT	C1_DstPathName		IMPORT	saveCursor		IMPORT	arrowCursor		IMPORT	restoreCursor		phb		phk		plb		pha		jsl	saveCursor		jsl	arrowCursor		lda	>C1_SrcPathName		sta	C1_Src		tax		lda	>C1_SrcPathName+2		sta	C1_Src+2		txa		dec	a		xba		sta	>C1_SrcPathName+1		lda	>C1_DstPathName		sta	C1_Dst		tax		lda	>C1_DstPathName+2		sta	C1_Dst+2		txa		dec	a		xba		sta	>C1_DstPathName+1		lda	1,s			;get A back		pea	$00B5		pushlong #C1_SrcPathNamePtr		pea	0		pha		_AlertWindow		lda	C1_Src		sta	>C1_SrcPathName		lda	C1_Src+2		sta	>C1_SrcPathName+2		lda	C1_Dst		sta	>C1_DstPathName		lda	C1_Dst+2		sta	>C1_DstPathName+2		jsl	restoreCursor		pla		plb		tax				;force flags to be set based on (A)		rtl;; locals;C1_Src		dc.L	0C1_Dst		dc.L	0C1_SrcPathNamePtr dc.L	C1_SrcPathName+2	;always +1 because we can only showC1_DstPathNamePtr dc.L	C1_DstPathName+2	;a pString from here		ENDP;; Our OutOfMemory (OOM) routine;; NOTE: This PROC CANNOT have a NAME!  Otherwise the header stuff gets;	messsed.;.....................................................................OOMRoutine	PROC	EXPORT		import DisposeHandleGlue		dc.L	0			;OOM header stuff		dc.w	0		dc.w	$A55ARTLAddress	equ	1Stage		equ	RTLAddress+3BytesNeeded	equ	Stage+2Result		equ	BytesNeeded+4		lda	#0		sta	result,s		;zero the result		sta	result+2,s		lda	stage,s			;if it's the first stage, don't dump		beq	@done			;our handle		lda	>OOMDumped		;did we dump already?		bne	@done			;if so, then don't do it again		pushlong >OOMHandle		;dump our 32k handle		jsl DisposeHandleGlue		lda	#$FFFF			;mark is as being dumped		sta	>OOMDumped		lda	#$6000			;tell the memory manager how much we freed		sta	result,s@done		sep 	#$20		LONGA OFF		pla		ply		plx		plx		plx		phy		pha		LONGA ON		rep 	#$20		rtl;; allocate 32k and put ourself in the out of memory queue -- if we can't allocate 32k here, go back; to the text screen death routine and say that there's no way we're gonna try running with a memory; situation this tight.;		EXPORT	StartUpOOMStartUpOOM		phb		phk		plb		lda	#$6000			;allocate 24k, not locked, not fixed, purge level zero		jsr	allocate		sta	OOMHandle		stx	OOMHandle+2		bcs	@done		lda	#$4000			;allocate 16k, not locked, not fixed, purge level zero		jsr	allocate		;this is our "oh shit, we need this memory to allow		sta	OOMDeepHandle		;quickdraw to put up an alertwindow" handle		stx	OOMDeepHandle+2		bcs	@done		stz	OOMDumped		stz	OOMWarnFlag		pushlong #OOMRoutine		_AddToOOMQueue@done		plb		rtl;; check the OOM and recharge it of necessary, put up a nasty dialog if we can't; allocate a 24k handle;		EXPORT RechargeOOMRechargeOOM		phb		phk		plb		lda	OOMDumped	;first check to see if our OOM handle got dumped		bne	@dumped		brl	@done		;if not, then continue as usual		;; ick, our OOM memory block is gone, so try to grab another 24k chunk;@dumped		lda	OOMWarnFlag	;did we warn the user before?		beq	@getDeep	;if not, warn them immediately and try to get our handles back		jsr	TickCount	;if we warned before, wait 60 seconds before trying to get our		tay		sec			;handles again		sbc	lastWarnTime		cmp	#2*60		blt	@done		@getDeep	lda	OOMDeepHandle+1		bne	@haveOOMDeepHandle		lda	#$4000		;see if we can get our QD safety buffer back		jsr	allocate		bcs	@done		;if we can't, let them take their chances, tough luck		sta	OOMDeepHandle		stx	OOMDeepHandle+2@haveOOMDeepHandle		lda	OOMWarnFlag		beq	@getNormal		jsr	TickCount			tay		sec					sbc	lastWarnTime		cmp	#10*60		;has it been 10 seconds yet?		blt	@done@getNormal	lda	#$6000		;we only get here if we've got our 16k safety buffer, but lost		jsr	allocate	;our 24K OOM handle		sta	OOMHandle		stx	OOMHandle+2		bcs	@whoaNelly		stz	OOMDumped	;if we got both handles back, reset the dumped flag		plb		rtl;; we should only ever get here if our OOM handle got dumped and we have our 16k safety buffer which; we'll contribute to the continued health of the system if it's going to really need it.;@whoaNelly	lda	OOMWarnFlag		beq	@warnNow				jsr	TickCount	;if we warned before, wait 60 seconds before trying to get our		tay			;handle again		sec					sbc	lastWarnTime		cmp	#60*60		;has it been 60 seconds yet?		blt	@done@warnNow	lda	#$FFFF		sta	OOMWarnFlag		pushlong OOMDeepHandle	;hope to high heaven that this works		jsl DisposeHandleGlue		stz	OOMDeepHandle+1	;say our handle is gone		lda	#rasOutOfMemory	;hopefully we have memory free to display this dialog!		jsl	doAlertWindow	;QD's region buffer takes 10K, plus slop of ???K		jsr	TickCount	;say when we last warned the user		sta	lastWarnTime@done		plb		rtl;; ShutDown our OutOfMemory queue routine;		EXPORT	OOMShutDownOOMShutDown		phb		phk		plb		pushlong #OOMRoutine		_RemoveFromOOMQueue		jsr	DumpHandles				plb		rtl;; just dump the OOMqueue's handles (both of them if possible);		EXPORT	OOMDumpOOMDump		phb		phk		plb				jsr	DumpHandles				plb		rtl;; Try dumping both the handles in the OOMqueue;; OUT: carry set if we disposed either of these memory blocks;DumpHandles	pea	0		lda 	OOMDeepHandle+1		beq 	@1		pushlong OOMDeepHandle	;hope to high heaven that this works		jsl DisposeHandleGlue		stz 	OOMDeepHandle+1		lda	#$FFFF		sta	1,s@1		lda	OOMDumped		bne	@noDump		pushlong OOMHandle		jsl DisposeHandleGlue		lda	#$FFFF		sta	OOMDumped		sta	1,s		@noDump		pla		cmp	#1		rts;; tickCount -- get the tickCount into A&X;tickCount		pha			;say when we last warned the user		pha		_TickCount		pla		plx		rts;; allocate (A) bytes of memory;; OUT: A&X contain our handle, carry set if call died;allocate	pha		pha		pea	0		pha		pei	<MyID		pea	0		pushlong #0		_NewHandle		pla		plx		rts;; globals;lastWarnTime	dc.w	0		;tickCount when they were last warned		EXPORT	OOMDeepHandleOOMDeepHandle	dc.L	0		;handle to our "oh shit" space		EXPORT	OOMWarnFlagOOMWarnFlag	dc.w	0		;have they been warned before?		EXPORT	OOMDumpedOOMDumped	dc.w	0OOMHandle	dc.L	0		ENDP********************************************************************************* GetStandardFile -- if StdFile is not here, get it and start it up********************************************************************************GetStandardFile	PROC	EXPORT		import DisposeHandleGluesfToolNumber	equ $0017		phb		phk		plb		stz 	weStartedSF		pea 	0		_SFStatus		pla		bne 	@done		pea 	sfToolNumber		pea 	0	;minimum version		_LoadOneTool		bcs 	@oops		inc 	weStartedSF		pha		pha		;space for NewHandle		pea 	$0000	;size high		pea 	$0100	;size low		pei	<MyID		pea 	$C015	;attributes = fixed bank, etc.		ldx 	#0		phx		phx		;loc=0		_NewHandle		plx		ply		bcs 	@oops		stx 	sfHandle		stx	<handle		sty 	sfHandle+2		sty	<handle+2		lda	[<handle]		sta 	sfDirPage		pei	<MyID		lda	sfDirPage		pha		_SFStartUp		plb		rtl@oops		sec		plb		rtl@done		clc		plb		rtl********************************************************************************* KillStandardFile -- if we got StdFile ourselves, shut it back down********************************************************************************		EXPORT KillStandardFileKillStandardFile		phb		phk		plb		lda 	weStartedSF		beq 	@done		_SFShutDown		pea 	sfToolNumber		_UnloadOneTool		pushlong sfHandle		jsl DisposeHandleGlue		stz 	weStartedSF@done		plb		rtlweStartedSF	dc.w 0sfHandle	dc.l 0sfDirPage	dc.w 0		ENDP;============================================;	   Pull	common icon fields.;============================================;;   IN:	   ic =	pointer	to icon	being duplicated.;;  OUT:	   filetype = icFType field.;	   ticonobj+icLocalAccess = icLocalAccess field;	   ticonobj+icNetworkAccess = icNetworkAccess field;	   ticonobj+icIcon = icIcon field;	   ticonobj+icSmallIcon = icSmallIcon field;	   ticonobj+icOneDoc = icOneDoc field;	   ticonobj+icFlag = icFlag field, color, locked and open states;	   ticonobj+icFBlocks = icFBlocks field;	   ticonobj+icFBytes = icFBytes field;	   ticonobj+icCDate = icCDate field;	   ticonobj+icMDate = icMDate field;	   ticonobj+icWind = icWind field;	   ticonobj+icOptionList = icOptionList field;;============================================;; NOTE: This routine is called from the main segment in the Finder!  It RTL's, but;	the BANK register is never set.  DON'T do anything weird here.  This was moved to;	save bytes in the main segment!;pullFieldsLong	PROC	EXPORT				IMPORT	ticonobj		IMPORT	auxtype				ldy	#icLocalAccess		lda	[<ic],y		sta	ticonobj+icLocalAccess				ldy	#icForked		lda	[<ic],y		sta	ticonobj+icForked		ldy	#icFlag			;Save icon's color and locked state.		lda	[<ic],y		and	#ICBACKCLR+ICFORECLR+ICLOCKED+ICOPENED		sta	ticonobj+icFlag		ldy	#icFlag+2		;Save icon's readable state. DJB 12/06/88		lda	[<ic],y		and	#ICREADABLE>>16		sta	ticonobj+icFlag+2		ldy	#icFBlocks		;Remember file sizes, create date, mod date.lop1		lda	[<ic],y		sta	ticonobj,y		iny		iny		cpy	#icMDate+8		bne	lop1		ldy	#icWind			;Remember window icon opened into.		lda	[<ic],y		sta	ticonobj,y		iny		iny		lda	[<ic],y		sta	ticonobj,y		ldy	#icFType		;Give new icon the same filetype.		lda	[<ic],y		sta	<filetype		ldy	#icKind			;move the pointer to the kind string		lda	[<ic],y		sta	ticonobj+icKind		iny		iny		lda	[<ic],y		sta	ticonobj+icKind+2		;; now that we're almost done moving fields around, move the option list;				ldy	#icOptionList				lda	[<ic],y		tax		clc		adc	#icOptionList		tay@loop		lda	[<ic],y		sta	ticonobj+icOptionList,x		dey		dey		dex		dex		bpl	@loop		ldy	#icAuxtype		; added 05/29/88 DJB		lda	[<ic],y		sta	auxtype		ldx	<fileType		cpx	#$0F			; is this the system folder kludge ?		bne	exit		cmp	#2		bne	exit		stz	auxtype			; yes so make it zeroexit		rtl				ENDP;.....................................................................;; LoadExtensions -- load all of the Finder extensions out of @:FinderExtras;.....................................................................LoadExtensions	procname export		IMPORT	MiscEntry		IMPORT	ExtensionIDs		IMPORT	WStringCopy		IMPORT	PToWString		IMPORT	PathAddName		IMPORT	C1_Pathname,C1_Filename		import DisposeHandleGlue		import	ProDOS		;25-Mar-93 JCMOSPublicFlags	equ	$e100b8rFinderExtension equ	$0042		phb		phk		plb		stz extensionCount*** Added - 25-Mar-93 JCM - Make sure we have a @:FinderExtras folder to play with. This is***			    mostly to make magic routing happy.		_CreateGS CreateExtrasParms*** End - 25-Mar-93 JCM*** added 2-Jun-92 DAL -- load resource-based Finder Extensions, if any*** (no need to put these in the ID table)		pha		pha			;space for GetCodeResConverter		_GetCodeResConverter		pea rFinderExtension		pea 1			;log in app converter		_ResourceConverter		pha		pha			;space for CountResources		pea rFinderExtension		_CountResources		pla		plx		tax		beq @noResources@nextRes	pha			;save index		pha		pha			;space for LoadResource		pea rFinderExtension		pha		pha			;space for GetIndResource		pea rFinderExtension		pea 0		pha			;resource number		_GetIndResource		_LoadResource		phd		tsc		tcd		ldy #1		lda [3],y		sta @callTheRes+2		lda [3]		sta @callTheRes+1		pld		pla		pla		bcs @skip@callTheRes	jsl $777777@skip		pla		dec a		bne @nextRes@noResources*** end 2-Jun-92		lda >$e100b8			; if they held down shift for 'No Inits/DAs'		bpl @useInits			; then we shouldn't load anything which would cause their		brl @exit			; system tp puke@useInits		PushLong #ExtensionsName	; pass window's pathname		ldx #xStartCatalog		jsl MiscEntry		bcc @loop		brl @done@loop		pha				; space for result		pha		ldx #xNextCatalog		jsl MiscEntry		pla		plx		bcs @done		sta <work			; save pointer to directory entry		stx <work+2		ldy #DirFType		lda [<work],y		cmp #$B6		beq @havePIF		cmp #$BC			;Finder extensions are $BC;0001		bne @loop		ldy #DirAuxType		lda [<work],y			;check auxtype		dec a				;Finder Extension auxtype is $0001		bne @loop			;not a finder extension		bra @goodExtension@havePIF		ldy #DirAuxType			;check init-file auxtype		lda [<work],y			;bit 15 set = inactive		bmi @loop@goodExtension	jsr LoadSingleExtension		bcc @loadedThisOne		pha		ldx #0		phx		phx		phx		pha		_ErrorWindow		pla		bra @loop@loadedThisOne		lda ExtensionCount		cmp #MaxExtensions		blt @loop@done		ldx #xEndCatalog		jsl MiscEntry@exit		plb		rtl;; loadSingleExtension -- load the single Finder extension;; Increments ExtensionCount if successful.;; Returns SEC, A=error if there was a problem.;; (If the file elected to be shutdown, returns CLC but does;  not increment ExtensionCount.);loadSingleExtension		pushlong #ExtensionsName		pushlong #c1_pathname		jsl WStringCopy		pushZLong <work			;make our entry a wstring		pushlong #c1_filename		jsl PToWString		pushlong #c1_filename		;add it onto @:FinderExtras		pushlong #c1_pathname		jsl PathAddName		pha		pha		pha		pha		pha		pea $A000			;Init-range IDs, please		pushlong #c1_pathname		pea 0				;okay to use special memory (QD is already started)		pea 1				;input parameter is GS/OS string		_InitialLoad2		lda ExtensionCount		asl a		tax		pla				;id		sta ExtensionID		sta >ExtensionIDs,x		pla				;start address of the program		sta @startAddress+1		pla		sep #$20		sta @startAddress+3		rep #$20		pla				;dpage address		sta @dirPageAddress		pla				;size of the dpage & stack		sta @dirPageSize		bcs @bogus		jsr @allocDirPageIfNeeded		phb		phd		tsc		sta @oldStack		lda @dirPageAddress		tcd		clc		adc @dirPageSize		dec a		tcs		lda @startAddress+2		pha		plb		plb				;set B = extension's bank		lda >ExtensionID		;pass User ID to extension in A		ldx #0		txy				;pass X and Y = 0 just in case they check 'em		phx				;word space (prezeroed); bit 0 means they want to unload@startAddress	jsl >$777777		ply				;result flags		lda >@oldStack		tcs		pld		plb		phy				;result flags		pushlong @dirPageHandle		jsl DisposeHandleGlue		stz @dirPageHandle+1		pla		lsr a		bcc @keepIt; The file wants us to unload it.  Okee dokee.		pha		lda ExtensionID		pha		pea 0			;quitFlags = 0		_UserShutDown		pla		clc		rts@keepIt		clc		inc ExtensionCount@bogus		rts@allocDirPageIfNeeded		lda @dirPageSize		bne @haveDP		pha		pha		pushlong #$1000		lda ExtensionID		pha		pea $C015		pea 0		pea 0		_NewHandle		phd		tsc		tcd		lda [3]		sta @dirPageAddress		pld		lda #$1000		sta @dirPageSize		pla		sta @dirPageHandle		pla		sta @dirPageHandle+2@haveDP		rts;; locals;@dirPageAddress	dc.w	0@dirPageSize	dc.w	0@dirPageHandle	dc.l	0@oldStack	dc.w	0ExtensionsName	dc.w	14		dc.b	'@:FinderExtras'ExtensionID	dc.w 0		EXPORT ExtensionCountExtensionCount	dc.w 0*** Added - 25-Mar-93 JCM - Try to create @:FinderExtras folder during startup.CreateExtrasParms dc.w	5		;pCount		dc.l	ExtensionsName	;pathname		dc.w	$c3		;access		dc.w	$0f		;fileType		dc.l	0		;auxType		dc.w	$d		;subdirectory*** End - 25-Mar-93 JCM		ENDP;.....................................................................;; KillExtensions -- kill all the Finder Extensions we loaded;.....................................................................KillExtensions	procname export		import ExtensionCount		import ExtensionIDssendToUserID	equ 2		;for SendRequest		phb		phk		plb		lda #0@loop		cmp ExtensionCount		bcs @done		pha		asl a		tax		lda >ExtensionIDs,x		jsr KillOneExtension		pla		inc a		bra @loop@done		plb		rtlKillOneExtension		ldx #0		;handy zero		sta theID		pea $0003	;srqGoAway		pea sendToUserID		phx		;high word of target = 0		pha		;low word of target		phx		phx		;dataIn = 0		pushlong #goAwayParms		_SendRequest; Note--at this point, if the accepted the request and said they could; not go away, it would be nice to not shut them down!  So far, we are; requiring that Extras be able to go away.		ldx #0		phx		phx		;namePtr = NIL		lda theID		pha		;user ID to kill		phx		phx		;procPtr = NIL		_AcceptRequests		pha		lda theID		pha		pea 0		;quitFlags = 0		_UserShutDown		pla		;ignore result		rtstheID		dc.w 0goAwayParms	dc.w 0		;recvCount		dc.w 0		;result ID		dc.w 0		;result flags (bit 15 = restartable from memory)		EndP; CountReadOnlyFSTs -- go through all the FSTs and find out which ones are;		       read-only and/or formattable;;		       A max of 16 read-only FSTs are stuffed into the;		       'readOnlyFSTs" list;;		       A max of 16 formattable FSTs are stuffed into the;		       'formattableFSTs' list;.....................................................................CountReadOnlyFSTs PROC EXPORT		IMPORT	C1_DevNameBuf		phb		phk		plb		stz	readOnlyFSTs		;we have zero read-only FSTs so far...		stz	formattableFSTs		stz	blocksizeFSTs		stz	FSTInfoParms+2@nextFST	inc	FSTInfoParms+2		_GetFSTInfoGS FSTInfoParms		bcs	@done;; first, stuff the blocksize of the FST and the FST ID into the blocksizeFST table ;		lda	blocksizeFSTs		cmp	#16		bge	@checkFileSize				asl	a			;*4		asl	a				tax		lda	FSTInfoParms+$04		sta	blocksizeFSTs+2,x		lda	FSTInfoParms+$0e		sta	blocksizeFSTs+4,x		inc	blocksizeFSTs;; save the maximum file size of each FST in another table;@checkFileSize	lda	fileSizeFSTs		cmp	#16		bge	@checkReadOnly				asl	a			;*6		asl	a		clc		adc	fileSizeFSTs		clc		adc	fileSizeFSTs		tax		lda	FSTInfoParms+$04		sta	fileSizeFSTs+2,x		lda	FSTInfoParms+$14		sta	fileSizeFSTs+4,x		lda	FSTInfoParms+$16		sta	fileSizeFSTs+6,x		inc	fileSizeFSTs		;; see if the FST is one which is for a read-only file system;@checkReadOnly	lda	FSTInfoParms+$0c		and	#$0800			;check read-only FST bit		beq	@checkFormattable		lda	readOnlyFSTs		cmp	#16		bge	@checkFormattable		asl	a		tax		lda	FSTInfoParms+$04	;fileSysID		sta	readOnlyFSTs+2,x		inc	readOnlyFSTs;; see if the FST is one which supports formatting;@checkFormattable		lda	FSTInfoParms+$0c		and	#$2000			;check formattable FST bit		beq	@nextFST		lda	formattableFSTs		cmp	#16		bge	@nextFST		asl	a		tax		lda	FSTInfoParms+$04	;fileSysID		sta	formattableFSTs+2,x		inc	formattableFSTs		brl	@nextFST@done		plb		rtl;; isFormattable;; IN: (Y) = FST ID to check;; OUT: carry set if it was formattable (found in formattable FSTs table);		EXPORT isFormattableisFormattable		phb		phk		plb		lda	formattableFSTs		;get the number of formattable fsts		beq	@notFormattable		asl	a			;*2		tax		tya		beq	@notFormattable@rLoop		cmp	formattableFSTs,x	;did it match the known read-only FSTs?		beq	@wasFormattable		;yes!		dex		dex		bne	@rLoop			;count down to zero@notFormattable	clc		plb		rtl@wasFormattable	sec		plb		rtl;; isReadOnly;; IN: (Y) = FST ID to check;; OUT: carry set if it was readOnly (found in read-only FSTs table);		EXPORT isReadOnlyisReadOnly		phb		phk		plb		lda	readOnlyFSTs		;get the number of formattable fsts		beq	@notReadOnly		asl	a			;*2		tax		tya		beq	@notReadOnly		@rLoop		cmp	readOnlyFSTs,x		;did it match the known read-only FSTs?		beq	@wasReadOnly		;yes!		dex		dex		bne	@rLoop			;count down to zero@notReadOnly	clc		plb		rtl@wasReadOnly	sec		plb		rtl;; GetFSTBlockSize;; IN: (A) contains FST ID whose block size we want to know;; OUT: (A) contains the block size;      carry clear if block size OK, set if FST ID not found;		EXPORT	GetFSTBlockSizeGetFSTBlockSize		phb		phk		plb		pha					lda	blocksizeFSTs		asl	a		asl	a		sta	blocksizeFSTs4				ldx	#0				;search the FST list front to back so that@loop		lda	blocksizeFSTs+2,x		;we encounter the boot FST first, which the user		cmp	1,s				;is most likely to be using		beq	@gotIt		inx		inx		inx		inx		cpx	blocksizeFSTs4		blt	@loop			lda	#512		sec		plx		plb		rtl				@gotIt		lda	blocksizeFSTs+4,x		clc		plx		plb		rtl;; GetFSTFileSize;; IN: (A) contains FST ID whose block size we want to know;; OUT: (A) contains the high word of the block size;      (X) contains the low word of the block size;      carry clear if block size OK, set if FST ID not found;		EXPORT	GetFSTFileSizeGetFSTFileSize		phb		phk		plb		pha					lda	filesizeFSTs		asl	a		asl	a		clc		adc	fileSizeFSTs		clc		adc	fileSizeFSTs		sta	fileSizeFSTs6				ldy	#0				;search the FST list front to back so that@loop		lda	filesizeFSTs+2,y		;we encounter the boot FST first, which the user		cmp	1,s				;is most likely to be using		beq	@gotIt		iny		iny		iny		iny		iny		iny		cpy	fileSizeFSTs6		blt	@loop			sec		ply		plb		rtl				@gotIt		lda	fileSizeFSTs+4,y		tax		lda	fileSizeFSTs+6,y				clc		ply		plb		rtl;; locals;FSTInfoParms	dc.w	8		;pcount		dc.w	1		;fstNum		dc.w	0		;fileSysID		dc.L	C1_DevNameBuf	;fstName		dc.w	0		;version		dc.w	0		;attributes		dc.w	0		;blocksize		dc.L	0		;max volume size (blocks)		dc.L	0		;max file size (bytes)				EXPORT	readOnlyFSTsreadOnlyFSTs	dc.w	0		ds.b	(16*2)		EXPORT	formattableFSTsformattableFSTs	dc.w	0		ds.b	(16*2)blocksizeFSTs4	dc.w	0		;# of FSTs * 4		EXPORT	blocksizeFSTsblocksizeFSTs	dc.w	0		ds.b	(16*4)		filesizeFSTs6	dc.w	0		;# of FSTs * 6		EXPORT	filesizeFSTsfilesizeFSTs	dc.w	0		ds.b	(16*6)				ENDP; lotsOfFilesAlert;; IN: (A) the number of files for the alert;; OUT: carry clear, continue;      carry set, abort;.....................................................................lotsOfFilesAlert PROC	EXPORT		IMPORT	doAlertWindow		IMPORT	SizeToString		IMPORT	itemsInFolderStr		IMPORT	folderMemStr		IMPORT	availMemStr				phb		phk		plb				sta	itemsInFolder				pha		pha		pha		pea	ICSIZE		_Multiply		pulllong folderMem		ldx	#8		;divide by 512@fLoop		lsr	folderMem+2		ror	folderMem		dex		bpl	@fLoop		pushlong #folderMemStr		pushlong folderMem		pea	2		pea	512		jsl	SizeToString		pha		pha		_RealFreeMem		pulllong availMem				ldx	#8		;divide by 512@rLoop		lsr	availMem+2		ror	availMem		dex		bpl	@rLoop				pushlong #availMemStr		pushlong availMem		pea	2		pea	512		jsl	SizeToString		pushlong #itemsInFolderStr		pea	0		lda	itemsInFolder		pha		pea	0		pea	512		jsl	SizeToString		lda	#itemsInFolderStr		sta	CustomPtr		lda	#itemsInFolderStr>>16		sta	CustomPtr+2				lda	#folderMemStr		sta	CustomPtr2		lda	#folderMemStr>>16		sta	CustomPtr2+2		lda	#availMemStr		sta	CustomPtr3		lda	#availMemStr>>16		sta	CustomPtr3+2		lda	#rasLotsOfFiles		jsl	doAlertwindow				eor	#$FFFF		cmp	#$FFFF				plb		rtl				;; locals;itemsInFolder	dc.w	0		folderMem	dc.L	0availMem	dc.L	0		ENDP		;; TextAlert -- put up a text alert box with the console driver;; Many thanks to Greg Branche for saving me a lot of time with the console driver code;; IN: (A) = GrafFlag (0 = GrafOff, not back on, either.  <>0 = GrafOff then back on).;			  use 'Quit'			       use 'Cancel';;     (X) = low word of pointer to string to display;     (Y) = high word of pointer to string to display;.....................................................................		TextAlert	PROC	EXPORT		import	textAlertStr		import	endTextAlertStr		import	textQuitStr		import	endTextQuitStr		import	textCancelStr		import	endTextCancelStr		string asis				phb		phk		plb				sta	GrafFlag				stx	<ptr		sty	<ptr+2		lda	[<ptr]		sta	writeMessageParms+8				inx		inx		stx	writeMessageParms+4		sty	writeMessageParms+6				_GrafOff		_OpenGS	openParms		lda	o_refnum         	sta	w_refnum         	sta	w_refnum2         	sta	w_refnum3		sta	w_refnum4		sta	w_refnum5		_WriteGS writeParms		;setup the box				lda	GrafFlag		bne	@showCancelText				_WriteGS writeQuitParms		bra	@showBodyText		@showCancelText	_WriteGS writeCancelParms		@showBodyText	_WriteGS writeMessageParms	;write our message in the box				sep	#$20			;wait for a keypress         	longa	off@loop		lda	>$E0C000		bpl	@loop         	sta	>$E0C010         	rep	#$20         	longa	on			_WriteGS writeHomeParms		;clear the screen before leaving		_Close	o_refnum				lda	GrafFlag		beq	@done		_GrafOn		@done		plb		rtlGrafFlag	dc.w	0openParms 	dc.w	3o_refnum	dc.w	0		dc.L	pathname         	dc.w	3pathname	dc.w	endpath-pathname-2         	dc.b	'.Console'endpath	writeParms 	dc.w	4w_refnum	dc.w	0		dc.L	textAlertStr         	dc.L	endTextAlertStr-textAlertStr		dc.L	0		writeQuitParms 	dc.w	4w_refnum4	dc.w	0		dc.L	textQuitStr         	dc.L	endTextQuitStr-textQuitStr		dc.L	0writeCancelParms dc.w	4w_refnum5	dc.w	0		dc.L	textCancelStr         	dc.L	endTextCancelStr-textCancelStr		dc.L	0writeMessageParms		dc.w	4w_refnum2	dc.w	0		dc.L	0         	dc.L	0		;size of text		dc.L	0		writeHomeParms	dc.w	4w_refnum3	dc.w	0		dc.L	textAlertStr         	dc.L	1		;size of text		dc.L	0		ENDP		; GetBootVolume -- put the boot volume;.....................................................................GetBootVolume	PROC	EXPORT		IMPORT	GetBootVolList		IMPORT	c1_bootname		phb		phk		plb				_GetBootVolGS GetBootVolList		lda	>c1_bootname		dec	a			;get rid of the trailing colon (":")		sta	>c1_bootname				plb		rtl		ENDP				END