;; Project:	GS Finder; File:		IconObj.equ; Build file:	Finder.Make; ; Copyright 1991-1992, Apple Computer, Inc.  All Rights Reserved.;.....................................................................;; --- ICONOBJ record offsets -------------------------------------------;icNext		equ	0			;Handle of next icon.icLast		equ	icNext+4		;Handle of previous icon.icMom		equ	icLast+4		;Window icon belongs to.icWind		equ	icMom+4			;Window icon is opened into.icDisk		equ	icWind+4		;Disk icon which owns this iconicFlag		equ	icDisk+4		;Defined below.icFType		equ	icFlag+4		;Icon's file typeicAuxType	equ	icFType+2		;NOTE: icAuxtype and icFileInfo are the same thing!icFileInfo	equ	icFType+2		;File's Aux type or Device's File System.icKind		equ	icFileInfo+4		;PTR to kind stringicy		equ	icKind+4		;Position of icon's bottom.icx		equ	icy+2			;X position of icon's middleicTextY		equ	icx+2			;Text's y position when viewed by text.icTitleLen	equ	icTextY+2		;Half the length of the icon's title.icName		equ	icTitleLen+2		;Name of icon.icLocalAccess	equ	icName+34		;Icon's current local accessicForked	equ	icLocalAccess+2		;high bit set if file is extended		icFBlocks	equ	icForked+2		;Icon's file block size; device’s used blocks.icFBytes	equ	icFBlocks+4		;Icon's file byte size; device’s total blocksicCDate		equ	icFBytes+4		;Icon's file creation date.icMDate		equ	icCDate+8		;Icon's file modification date.icIcon		equ	icMDate+8		;Offset into Handle and Offset lists for this iconicSmallIcon	equ	icIcon+4		;Offset into Handle and Offset lists for this iconicRBundle	equ	icSmallIcon+4		;Handle of rBundle which matched or NILicOneDocOffset	equ	icRBundle+4		;Offset to OneDoc within rBundle handleicInfo		equ	icOneDocOffset+4	;Pointer to Info window if any, else zero.icDevNum	equ	icInfo+4		;Icon's device number (device icons).icDevInfo	equ	icDevNum+2		;if icon is a device, the return from _DInfoicOptionList	equ	icDevInfo+2		;the option list for this file, 44 bytes longicFST		equ	icOptionList+2icNetworkAccess	equ	icFST+38icOptionListEnd	equ	icNetworkAccess+4ICSIZE		equ	icNetworkAccess+4;; ------ Extended ICONOBJ record -----------------------------------;icOldPosY	equ	ICSIZE			;Y position in real mom window.icOldPosX	equ	icOldPosY+2		;X position in real mom window.icOwner		equ	icOldPosX+2		;Pathname of icon's real owner.EXTSIZE		equ	icOwner+MaxPathLen+2	;Size of extended icon record.;; ----- icFlag flags -------------------------------------------------------;ICSELECTED	equ	$0001			;1 = selected, 0=normal.ICOPENED	equ	$0002			;1 = icon is opened, 0 = icon closed.ICOFFLINE	equ	$0004			;1 = offline, 0 = online.ICEXTENDED	equ	$0008			;1 = extended ICONOBJ record.ICDUP		equ	$0010			;1 = icon's duplicate was replaced.ICCOPY		equ	$0020			;1 = icon was copied to destination.ICDELETE	equ	$0040			;1 = icon was deleted from directory.ICLOCKED	equ	$0080			;1 = icon is locked.ICFORECLR	equ	$0F00			;Icon's foreground (outline) color.ICBACKCLR	equ	$F000			;Icon's background (fill) color.icYellowClr	equ	$E000			;Yellow background, black background for foldersICNETACCESS	equ	$000F0000		;Network access rights (4 bits)ICInfoMakeChanges equ	$00400000		;in info card only, set if we can make						;changes to this file and hope to have them						;stick (because folder containing this file						;has makeChanges set or not)ICNETWORK	equ	$01000000		;1 = Network, 0 = local.ICREADABLE	equ	$02000000		;1 = read access, 0 = no read access.ICVISITED	equ	$80000000		;1 = icon was visited;; Network access bits;ICASOwner	equ	$0008			; user is AppleShare owner of this folderICSeeFiles	equ	$0001			; user can see filesICSeeFolders	equ	$0002			; you can see foldersICMakeChanges	equ	$0004			; you can make/save changes_ICSELECTED	equ	$FFFE_ICOPENED	equ	$FFFD_ICOFFLINE	equ	$FFFB_ICEXTENDED	equ	$FFF7_ICDUP		equ	$FFEF_ICCOPY		equ	$FFDF_ICDELETE	equ	$FFBF_ICLOCKED	equ	$FF7F_ICFORECLR	equ	$F0FF_ICBACKCLR	equ	$0FFF