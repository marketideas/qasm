; File:		Strings.aii; Project:	GS Finder; Build file:	Finder.make;; © Copyright Apple Computer, Inc. 1986-1992, All rights reserved.;; This file contains most of the hard-coded strings used by the Finder;.....................................................................						STRING	PASCAL				PRINT	OFF		PRINT	NOGEN		PRINT	NOSYM		PRINT	NOPAGE		PRINT	ON		;=================================================;  --->	NOTE: this string file may be linked as a      <--- Read This Please;	seperate segment so use "long" addressing;	when accessing any these strings. DO NOT;	rely on the data bank register it may not;	be the same for the strings as the code!;=================================================StringBase	PROC	EXPORT		STRING pascal				export	NullButtonNullButton	dc.b	0		EXPORT	strReadingBlksstrReadingBlks	DC.B	'Reading...'		EXPORT	strWritingBlksstrWritingBlks	DC.B	'Writing...'		EXPORT 	strAllocstrAlloc	dc.b	'Preparing to copy...'		EXPORT	strValidatestrValidate 	dc.b 	'Preparing to validate...'		EXPORT	strgUntitledstrgUntitled	DC.B	'untitled'		;was "Untitled" 13-Jan-93 DAL		EXPORT	strCancelstrCancel	dc.b	'Cancel'		EXPORT	strgCopyingstrgCopying	DC.B	'Copying: '		EXPORT	strgReadingstrgReading	DC.B	'Reading: '		EXPORT	strgWritingstrgWriting	DC.B	'Writing: '		EXPORT	strgWritingTostrgWritingTo	DC.B	'Writing to: '		EXPORT	ValidateFileStringValidateFileString DC.B	'Item names'		EXPORT	ValidateCountStringValidateCountString DC.B '54321 Total'		EXPORT	strBadBlocksstrBadBlocks	DC.B	'Number of bad blocks: 65535'		string GSOS		EXPORT	wstrSystemwstrSystem	DC.B	'SYSTEM'		EXPORT	IconsNameIconsName	DC.B	'Icons'		EXPORT	DesktopNameDesktopName	dc.b	'Desktop'		EXPORT	RootNameRootName	DC.B	'Finder.Root'		EXPORT	DataNameDataName	DC.B	'Finder.Data'		EXPORT	defaultNamedefaultName	DC.B	'@:Finder.Defaults'	;Pathname of Finder defaults file		string PASCAL			EXPORT	strSystemstrSystem	DC.B	'SYSTEM'		EXPORT  FindersICBlkNFindersICBlkN	DC.B	'FINDER.ICONS'		;Filename of ÒFinderÕsÓ ICONBLK in ICONS dir		EXPORT	FindersICXBlkNFindersICXBlkN	DC.B	'FINDER.ICONS.X'	;Filename of ÒFinderÕsÓ ICONBLK in ICONS dir;===============================================;  Strings for INFO window					;===============================================;     Size: xx bytes used, yyK on disk	(for files/folders);     Size: xxK in disk, yyK available  (for volumes); Contents: xx files, yy folders	(for volumes/folders)		EXPORT	strBytesUsedstrBytesUsed	DC.B	',  '		EXPORT	strOnDiskstrOnDisk	DC.B	' on disk'		EXPORT	strInDiskstrInDisk	DC.B	' in disk,  '		EXPORT	strFilesstrFiles	DC.B	' files,  '		EXPORT	strFilestrFile		DC.B	' file,  '			; singular form of above string		EXPORT	strFoldersstrFolders	DC.B	' folders'		EXPORT	strFolderstrFolder	DC.B	' folder'			; singular form of above string		EXPORT	strAccFoldersstrAccFolders	DC.B	' folders accessible'		EXPORT	strAccFolderstrAccFolder	DC.B	' folder accessible'		; singular form of above string		EXPORT	strAvailablestrAvailable	DC.B	' free'		EXPORT	strUsedstrUsed		dc.b	' used'		EXPORT	strPressCalcstrPressCalc	DC.B	'use calculate icon...'		EXPORT	strCalculatingstrCalculating	DC.B	'calculating...'		STRING	ASIS		EXPORT	TrashText;TrashText	DC.B	'Files and folders are deleted by dragging them to the Trash.';		DC.B	'  Removable disks are unmounted by dragging them to the Trash.'*** 19-Oct-92 DAL -- Replaced with text similar to Mac 7.1 balloon help on TrashTrashText	dc.b	'To discard an item, eject a disk, or remove a shared disk icon '		dc.b	'from the desktop, drag it to the Trash.'*** end 19-Oct-92		EXPORT	endTrashTextendTrashText		STRING	ASIS		EXPORT	DriveTextDriveText	DC.B	'5.25 inch disks can be added to the desktop by inserting a'		DC.B	' disk into a 5.25 drive and then opening that driveÕs icon.'		EXPORT endDriveTextendDriveText		STRING	PASCAL		EXPORT	zeroStringzeroString	dc.B	'zero K'		dc.B	0		EXPORT	SizeStrgSizeStrg	DC.B	'123456.0K'			;buffer for size text		DC.B	0				EXPORT	DateStrgDateStrg	DC.B	'Feb 24, 1960 at 12:33 PM '	;buffer for dates		DC.B	0		EXPORT	itemsStrgitemsStrg	DC.B	'1234 items'		EXPORT	itemStrgitemStrg	DC.B	'0001 item'		EXPORT	usedKStringusedKString	DC.B	'123456K used'		EXPORT	freeKStringfreeKString	DC.B	'123456K free'		EXPORT	usedMBStringusedMBString	dc.B	'      MB used'		EXPORT	freeMBStringfreeMBString	dc.B	'      MB free';; fst name pointer list;		EXPORT	fstNamesfstNames	dc.L	nullName		dc.L	ProDOSName		dc.L	DOS33Name		dc.L	DOS32Name		dc.L	PascalName		dc.L	MFSName		dc.L	HFSName		dc.L	LisaName		dc.L	CPMName		dc.L	nullName		dc.L	MSDOSName		dc.L	HighSierraName		dc.L	ISO9660Name		dc.L	AppleShareName		dc.L	nullName		dc.L	nullName		EXPORT	nullNamenullName	dc.b	' '		EXPORT	ProDOSNameProDOSName	dc.b	'ProDOS'		EXPORT	DOS33NameDOS33Name	dc.b	'DOS 3.3'		EXPORT	DOS32NameDOS32Name	dc.b	'DOS 3.2'		EXPORT	PascalNamePascalName	dc.b	'Pascal'		EXPORT	MFSNameMFSName		dc.b	'MFS'		EXPORT	HFSNameHFSName		dc.b	'HFS'		EXPORT	LisaNameLisaName	dc.b	'Lisa'		EXPORT	CPMNameCPMName		dc.b	'Apple CP/M'		EXPORT	MSDOSNameMSDOSName	dc.b	'MS-DOS'		EXPORT	highSierraNameHighSierraName	dc.b	'High Sierra'		EXPORT	ISO9660NameISO9660Name	dc.b	'ISO 9660'		EXPORT	AppleShareNameAppleShareName	dc.b	'AppleShare'	;		; --- info bar titles for view by text window ---;		EXPORT	IBDateIBDate		DC.B	'Last modified'		EXPORT	IBKindIBKind		DC.B	'Kind'		EXPORT	IBSizeIBSize		DC.B	'Size'		EXPORT	IBNameIBName		DC.B	'Name';--- Date Strings for INFO window ---		EXPORT	strJanuarystrJanuary	DC.B	'Jan'		EXPORT	strFeburarystrFeburary	DC.B	'Feb'		EXPORT	strMarchstrMarch	DC.B	'Mar'		EXPORT	strAprilstrApril	DC.B	'Apr'		EXPORT	strMaystrMay		DC.B	'May'		EXPORT	strJunestrJune		DC.B	'Jun'		EXPORT	strJulystrJuly		DC.B	'Jul'		EXPORT	strAuguststrAugust	DC.B	'Aug'		EXPORT	strSeptemberstrSeptember	DC.B	'Sep'		EXPORT	strOctoberstrOctober	DC.B	'Oct'		EXPORT	strNovemberstrNovember	DC.B	'Nov'		EXPORT	strDecemberstrDecember	DC.B	'Dec'		EXPORT	strSundaystrSunday	DC.B	'Sun'		EXPORT	strMondaystrMonday	DC.B	'Mon'		EXPORT	strTuesdaystrTuesday	DC.B	'Tue'		EXPORT	strWednesdaystrWednesday	DC.B	'Wed'		EXPORT	strThursdaystrThursday	DC.B	'Thu'		EXPORT	strFridaystrFriday	DC.B	'Fri'		EXPORT	strSaturdaystrSaturday	DC.B	'Sat';; ----- Device Kind Strings for icon INFO ----------;		EXPORT	hardKindhardKind	DC.B	'Hard disk'		EXPORT	flopKindflopKind	DC.B	'5.25 inch disk'		EXPORT	miniKindminiKind	DC.B	'3.5 inch disk'		EXPORT	ramKindramKind		DC.B	'RAM disk'		EXPORT	cdromKindcdromKind	DC.B	'CD-ROM disc'		EXPORT	tapeKindtapeKind	DC.B	'Tape drive'		EXPORT	scsiKindscsiKind	DC.B	'SCSI generic'		EXPORT	serverKindserverKind	DC.B	'File server'		EXPORT	networkKindnetworkKind	DC.B	'Network generic'		EXPORT	hdPartKindhdPartKind	DC.B	'Hard disk partition'		EXPORT	cdPartKindcdPartKind	DC.B	'CD-ROM partition'		EXPORT	scPartKindscPartKind	DC.B	'SCSI partition';; --- Strings for Access Privileges Window ------;		EXPORT	strAnyUserstrAnyUser	DC.B	'<Any User>';; --- all possible strings for user's access privileges ---;		EXPORT	StrPriv0StrPriv0	DC.B	'none'		EXPORT	StrPriv1StrPriv1	DC.B	'See Folders'		EXPORT	StrPriv2StrPriv2	DC.B	'See Files'		EXPORT	StrPriv3StrPriv3	DC.B	'See Folders, See Files'		EXPORT	StrPriv4StrPriv4	DC.B	'Make Changes'		EXPORT	StrPriv5StrPriv5	DC.B	'See Folders, Make Changes'		EXPORT	StrPriv6StrPriv6	DC.B	'See Files, Make Changes'		EXPORT	StrPriv7StrPriv7	DC.B	'See Folders, See Files, Make Changes';; --- tab labels for info cards ----------------;		EXPORT	strGeneralstrGeneral	DC.B	'General'		EXPORT	strWherestrWhere	DC.B	'Where'		EXPORT	strAccessstrAccess	DC.B	'Access'		EXPORT	strCommentstrComment	DC.B	'Comment';; --- button titles for info access cards -------;		EXPORT	strApplystrApply	DC.B	'Apply'		EXPORT	strApplyAllstrApplyAll	DC.B	'Apply to enclosed folders'		EXPORT	strCalculatestrCalculate	DC.B	'Calculate';; --- field titles for info cards --------------;		EXPORT	strOwner		EXPORT	endOwnerstrOwner	DC.B	'Owner:'endOwner		EXPORT	strGroup		EXPORT	endGroupstrGroup	DC.B	'Group:'endGroup		EXPORT	strPrivileges		EXPORT	endPrivilegesstrPrivileges	DC.B	'Privileges:'endPrivileges		EXPORT	strLocked		EXPORT	endLockedstrLocked	DC.B	'Locked'endLocked		EXPORT	strInactive		EXPORT	endInactivestrInactive	DC.B	'Inactive'endInactive		EXPORT	strKind		EXPORT	endKindstrKind		DC.B	'Kind:'endKind		EXPORT	strSize		EXPORT	endSizestrSize		DC.B	'Size:'endSize		EXPORT	strContents		EXPORT	endContentsstrContents	DC.B	'Contents:'endContents		EXPORT	strCreated		EXPORT	endCreatedstrCreated	DC.B	'Created:'endCreated		EXPORT	strModified		EXPORT	endModifiedstrModified	DC.B	'Modified:'endModified		EXPORT	strPath		EXPORT	endPathstrPath		DC.B	'Path:'endPath		EXPORT	strDevice		EXPORT	endDevicestrDevice	DC.B	'Device:'endDevice		EXPORT	strServer		EXPORT	endServerstrServer	DC.B	'Server:'endServer		EXPORT	strZone		EXPORT	endZonestrZone		DC.B	'Zone:'endZone		EXPORT	strAddCommentstrAddComment	dc.b	'Add Comment';; Misc. Strings;				EXPORT	nullStrgnullStrg	DC.W	0		EXPORT	strBlkNumbersstrBlkNumbers	DC.B	'Block numbers'		EXPORT	strTotalstrTotal	DC.B	' total'		EXPORT	tempStrg1tempStrg1	DS.B	64			;temp string buffer (in this segment)		EXPORT	strInfo1strInfo1	DC.B	'  Info on Ò'		; name of Info window		EXPORT	strInfo2strInfo2	DC.B	'Ó  '		EXPORT	strInfo3strInfo3	DC.B	'Info on Ò'		; name of Info window		EXPORT	strInfo4strInfo4	DC.B	'Ó'		EXPORT	strMBytesstrMBytes	dc.b	' MB'		EXPORT	strBytesstrBytes	DC.B	' bytes'		EXPORT	notInDriveStrgnotInDriveStrg	DC.B	'not in any drive'	;Info window's where strings.		EXPORT	strUnknownstrUnknown	DC.B	'Unknown';; strings used by text alert code in alert.aii;		string ASIS		;; our output string goes here;; NOTE: textAlertStr must always start with the clear screen code since Alert.aii uses it to; 	clear the screen;		EXPORT	textAlertStrtextAlertStr	dc.b	12		;clear screen         	dc.b	1		;save current and reset port         	dc.b	$15		;set cursor movement word         	dc.b	$17		;DLE,Wrap,LF,Advance=TRUE, Scroll=FALSE;; set textport size to size of desired dialog box;		dc.b	2		; set new textport dimensions		dc.b	10+32		; X1		dc.b	3+32		; Y1         	dc.b	69+32		; X2         	dc.b	23-3+32		; Y2;; define the dialog box borders; screen line 5;         	dc.b	' '		;space character         	dcb.b	58,'_'         	dc.b	' ';; screen line 6;         	dc.b	$DA		;mousetext vertical bar         	dcb.b	58,$cc		;mousetext top bar         	dc.b	$DF		;mousetext vertical bar;; screen line 7-16;		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF		dc.b	$DA         	dc.b	$10,58+32	;DLE space expansion         	dc.b	$DF;; screen line 17;		dc.b	$DA         	dcb.b	58,'_'         	dc.b	$DF;; screen line 18;		dc.b	' '         	dcb.b	58,$CC      		dc.b	' ';; reset the textport size to protect the dialog box borders;		dc.b	2		dc.b	12+32		; X1         	dc.b	5+32		; Y1         	dc.b	67+32		; X2         	dc.b	23-3-2+32	; Y2				EXPORT	endTextAlertStrendTextAlertStr	;; now that the dialog box is displayed, we can fill it in with whatever message we want; first, position the cursor properly;		EXPORT textQuitStrtextQuitStr		dc.b	$1e		;gotoxy		dc.b	45+32		; X=40         	dc.b	9+32		; Y=9         	dc.b	'Quit '		dc.b	$cd		; mousetext carriage return				EXPORT	endTextQuitStrendTextQuitStr;; now that the dialog box is displayed, we can fill it in with whatever message we want; first, position the cursor properly;		EXPORT textCancelStrtextCancelStr		dc.b	$1e		;gotoxy		dc.b	45+32		; X=40         	dc.b	9+32		; Y=9         	dc.b	'Cancel '		dc.b	$cd		; mousetext carriage return				EXPORT	endTextCancelStrendTextCancelStr;; tell the user they gotta have System 6 to startup.;		EXPORT	NotSystem6NotSystem6	dc.w	NotSystem6End-NotSystem6-2	;block size (used on entry)		dc.b	$1e		;GOTOXY         	dc.b	0+32		; X = 0         	dc.b	0+32		; Y = 0		;		                  1         2         3		4	  5;		         12345678901234567890123456789012345678901234567890123456		dc.b	'Finder requires System 6.0.1 or later. Use the'		dc.b	13		dc.b	'System 6.0.1 Installer to update your system.'		dc.b	4		;pop textportNotSystem6End;; tell the user they need at least 300K free to run the Finder and a one-megabyte system.;		EXPORT	NotMemory,NotMemoryCodeNotMemory	dc.w	NotMemoryEnd-NotMemory-2		dc.b	$1e		;GOTOXY         	dc.b	0+32		; X = 0         	dc.b	0+32		; Y = 0;		                  1         2         3		4	  5;		         12345678901234567890123456789012345678901234567890123456		dc.b	'Finder requires System 6.0.1 or later and at least 300K'		dc.b	13		dc.b	'of free memory.  ($'NotMemoryCode	dc.b	'0000)'		dc.b	13		dc.b	13		dc.b	'You can increase free memory by decreasing your Control'		dc.b	13		dc.b	'Panel''s RAM Disk size, and also by restarting with the'		dc.b	13		dc.b	'Shift key held down to bypass loading inits and desk'		dc.b	13		dc.b	'accessories.'		dc.b	4		;pop textportNotMemoryEnd;; tell the user they need at least one ftype file to run the Finder;		EXPORT	NotDescriptorsNotDescriptors	dc.w	NotDescriptorsEnd-NotDescriptors-2				dc.b	$1e		;GOTOXY         	dc.b	0+32		; X = 0         	dc.b	0+32		; Y = 0;		                  1         2         3		4	  5;		         12345678901234567890123456789012345678901234567890123456		dc.b	13		dc.b	'Finder couldn''t load any file type descriptors.'		dc.b	13		dc.b	13		dc.b	'At least one "FType" (file type descriptor) file with'		dc.b	13		dc.b	'auxiliary type zero must be present in the Icons folder'		dc.b	13		dc.b	'on your startup disk for the Finder to work.'				dc.b	4		;pop textportNotDescriptorsEnd;; tell the user they need more memory;		EXPORT	MemoryFullMemoryFull	dc.w	MemoryFullEnd-MemoryFull-2				dc.b	$1e		;GOTOXY         	dc.b	0+32		; X = 0         	dc.b	0+32		; Y = 0;		                  1         2         3		4	  5;		         12345678901234567890123456789012345678901234567890123456		dc.b	'There isn''t enough memory available to open this'		dc.b	13		dc.b	'window.  The Finder is dangerously low on memory.'				dc.b	4		;pop textportMemoryFullEnd		ENDP		END