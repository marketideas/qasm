;=====================================================================		TITLE	'Apple IIGS Finder          UTIL.aii';;	   Copyright Apple Computer, Inc. 1986-1992;	   All rights reserved.;;	   By Dan Oliver;; Modification History for Version 1.2:; -------------------------------------;; 05/17/88 DJB	- change call to EjectMedia for hack;		- added types $FFF4-$FFF8 to "cutNFree" ; 08/01/88 JAM	- Changed Sort (byDate) to deal properly;		- with class 1 date and time records; 08/06/88 DJB	- Removed DayofWeek() routine (no longer needed).; 08/05/88 JAM	- BUG DAC044FND Changed Sort (byKind);		- to order Kinds according to alphabetic;		- kind string rather than integer kind value.; 08/10/88 DJB	- Changed KindToString to use more strings;=====================================================================;; 6.0 work mostly by Andy Nicholas, late 1990 to early 1992;;=====================================================================;; 6.0.1 work mostly by Dave Lyons, 1992.;;   Most changes marked with "DAL";; 1-Mar-93 JCM - For 6.0.1d14 - Fixed the problem where emptying the;		 trash with file Icon Info windows open would cause;		 them all to update as though they were disk info;		 windows.;; 18-Mar-93 JCM - Fixed my 1-Mar fix to updateInfoWind. One branch was; 		  logically backwards and it was going to the wrong spot.;		  When it branched, it pulled a word from that stack that;		  hadn't yet pushed. Whoops. This was a cool one in that if;		  you renamed devices with an info window open, you would get;		  the "Finder needs a FType file..." message. Coolness. :-);;=====================================================================		STRING	ASIS		BLANKS	OFF				PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM		PRINT	NOPAGE		PAGESIZE $FFFF,126		INCLUDE 'All.macros'		INCLUDE	'special.macros'		INCLUDE	'Pascal.MACROS'		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'		INCLUDE	'DP.equ'		INCLUDE	'Data.equ'				PRINT	ON;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		import DisposeHandleGlue		IMPORT	StringBase		IMPORT	WStringCopy		IMPORT	makeDevName		IMPORT	doVolume		IMPORT	PathAddName		IMPORT	PtoWString		IMPORT	doGetFileInfo		IMPORT	FreeBlks		IMPORT	NumBlks		IMPORT	fileSysID				IMPORT	redrawList				IMPORT	drawIcon2				IMPORT	write_buff				IMPORT	write_len			IMPORT	file_type		IMPORT	create_access				IMPORT	doWrite				IMPORT	lenError				IMPORT	doClose2				IMPORT	killInfoWind		IMPORT	cutIcon		IMPORT	info_ctime		IMPORT	info_cdate				IMPORT	getBigRect		IMPORT	growZoom		IMPORT	NewDialog;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	UpdateRootSizeW		ENTRY	UpdateRootSize		ENTRY	GetVolSizes		ENTRY	GETWINDPATH		ENTRY	GETICONRECT		ENTRY	ALLOCATERGN		ENTRY	ALLOCATERGN		ENTRY	GETICONRECT		ENTRY	GETICONRECT		ENTRY	CLOSEKIDS		ENTRY	MAKEICROOT		ENTRY	CKDATAWRITE		ENTRY	FINDLASTNAME		ENTRY	GETEXTNAME		ENTRY	KILLICON		ENTRY	allocate2				ENTRY	derefHand		ENTRY	ifDesk		ENTRY	clonePath		ENTRY	findRootIc		ENTRY	setInfo		ENTRY	setItems		ENTRY	justRootName		ENTRY	setKs		ENTRY	getFrontWind		ENTRY	getNextWind		ENTRY	getWindID		ENTRY	getWindID2		ENTRY	getWoffset2		ENTRY	RectHit2		ENTRY	buildRects2		ENTRY	getRectRgn		ENTRY	addIconRgn		ENTRY	addirect2		ENTRY	addRgn		ENTRY	buildRectList		ENTRY	StartDraw		ENTRY	endDraw		ENTRY	pushirect1		ENTRY	pushirect2		ENTRY	pushwork		ENTRY	pushTask		ENTRY	pushrect		ENTRY	pushzpage		ENTRY	WalkGoto		ENTRY	walkOfLife3		ENTRY	walkOfLife2		ENTRY	walkBack		ENTRY	walkBack2		ENTRY	tocall		ENTRY	toDesktop		ENTRY	getwRefCon		ENTRY	getwRefCon2		ENTRY	getDeskWindBlk		ENTRY	windRefCon		ENTRY	getHeadIcon		ENTRY	toDeskPort		ENTRY	lockic		ENTRY	setic		ENTRY	unlockic		ENTRY	setTemp		ENTRY	windSpot		ENTRY	startHash		ENTRY	markOffLine		ENTRY	markOnLine		ENTRY	markClosed		ENTRY	allOffLine		ENTRY	allOnLine		ENTRY	matchRootName		ENTRY	geticNamePtr2		ENTRY	addRootName		ENTRY	addName		ENTRY	getRootName		ENTRY	buildPath		ENTRY	buildPath2		ENTRY	temp2path		ENTRY	ckRoots		ENTRY	cutNfree		ENTRY	wipeIcon		ENTRY	walkExt		ENTRY	walkExt2		ENTRY	ckForExt		ENTRY	extFunc		ENTRY	onIcon		ENTRY	officon2		ENTRY	officon		ENTRY	killKids2		ENTRY	dumpExtIcon		ENTRY	selectWind		ENTRY	selectWind2		ENTRY	setSmallRect		ENTRY	newDataSize3		ENTRY	newDataSize		ENTRY	WriteRoot;; GetIconPtr;;   IN:	   ic =	pointer	to ICONOBJ.;	   a = 0 for big ICON, 1 for small ICON.;;  OUT:	   icBlkHand 	= LOCKED handle of ICONBLK.;	   icBlk 	= pointer to ic's ICONDATA. - 22-Mar-93 JCM - this isn't set, dunno why not;	   icon 	= pointer to icon data;; STACK:   | word |	RTS;	   | long |	LocalHandle;	   | long |	LocalPtr;	   | long |	LocalHandle2;	   | long |	LocalPtr2;	   | long |	LocalOffset;	   -------- <- SP;.....................................................................getIconPtr	PROC	EXPORT		IMPORT	IconHandleArray		IMPORT	IconOffsetArrayLocalHandle	equ	17LocalPtr	equ	13LocalHandle2	equ	9LocalPtr2	equ	5LocalOffset	equ	1			tay		bne	@small		ldy	#icIcon			;Get handle of icon		lda	[<ic],y;;;		sta	IconIndex		;22-Mar-93 JCM - save some bytes;;;		bra	GetHandles		;22-Mar-93 JCM		bra	GetIconPtr2		;22-Mar-93 JCM@small		ldy	#icSmallIcon		;Get handle of small icon		lda	[<ic],y		;; GetIconPtr2 -- (A) contains the index to the icon we want;		EXPORT	GetIconPtr2GetIconPtr2					sta	IconIndexGetHandles	phd		tsc		sec		sbc	#20			;5 longs		tcs		tcd		lda	>IconHandleArray	;get the handle to the array of icon handles		sta	<LocalHandle		lda	>IconHandleArray+2		sta	<LocalHandle+2		lda	[<LocalHandle]		;deref		sta	<LocalPTR		ldy	#2		lda	[<LocalHandle],y		sta	<LocalPTR+2		lda	>IconOffsetArray	;get the handle to the array of icon offsets		sta	<LocalHandle2		lda	>IconOffsetArray+2		sta	<LocalHandle2+2				lda	[<LocalHandle2]		;deref		sta	<LocalPTR2		lda	[<LocalHandle2],y		sta	<LocalPTR2+2		lda	IconIndex		sta	<LocalOffset		stz	<LocalOffset+2				asl	<LocalOffset		;multiply our index by 4		rol	<LocalOffset+2		asl	<LocalOffset		rol	<LocalOffset+2		lda	<LocalOffset		;add our index to the handle array pointer		clc		adc	<LocalPTR		sta	<LocalPTR		lda	<LocalOffset+2		adc	<LocalPTR+2		sta	<LocalPTR+2		lda	<LocalOffset		;add our index to the offset array pointer		clc		adc	<LocalPTR2		sta	<LocalPTR2		lda	<LocalOffset+2		adc	<LocalPTR2+2		sta	<LocalPTR2+2		lda	[<LocalPTR]		;from the handle array, get the handle our icon		sta	<LocalHandle		;resides in		sta	IconListHandle		ldy	#2		lda	[<LocalPTR],y		sta	<LocalHandle+2		sta	IconListHandle+2				lda	[<LocalHandle]		;deref the handle which contains our icon		sta	<LocalPTR;		sta	IconListPtr		lda	[<LocalHandle],y		sta	<LocalPTR+2;		sta	IconListPtr+2		lda	<LocalPTR		;add the offset to our icon to the pointer to			clc				;the handle containing our icon		adc	[<LocalPTR2]		sta	IconPtr		lda	<LocalPTR+2		adc	[<LocalPTR2],y		sta	IconPtr+2		tsc		clc		adc	#20		tcs		pld		lda	IconListHandle		sta	<icBlkHand		lda	IconListHandle+2		sta	<icBlkHand+2;		lda	IconListPtr;		sta	<icBlk;		lda	IconListPtr+2;		sta	<icBlk+2				lda	IconPtr		sta	<icon		lda	IconPtr+2		sta	<icon+2				ldy	#4			;lock the handle which contains our icon		lda	[<icBlkHand],y		ora	#$8000		sta	[<icBlkHand],y		rts;; locals;IconListHandle	dc.L	0IconPtr		dc.L	0IconIndex	dc.w	0		ENDP;===========================================;	   Sort	files in a window.;===========================================;;   IN:	   wind	= pointer to window to sort.;	   windBlk = pointer to	window's info block.;;===========================================sort		PROC	EXPORTySpot		equ	worktopIcHand	equ	ySpot+2topIc		equ	topIcHand+4tempIcHand	equ	topIc+4tempIc		equ	tempIcHand+4						ldy	#windView		lda	[<windBlk],y		sec		sbc	#viewByName		;View by icon?		bcc	exit			If view	by icon, nothing to sort.		asl	a			Get address of sort procedure.		tax		cpx 	#SortProcsEnd-SortProcs		bcs 	exit		lda	sortProcs,x		sta	sortGuy+1		lda	#10			Starting Y position.		sta	<work		lda	#sortem		brl	walkOfLife3		Walk list, front to back.exit		rtssortem		lda	<icHand		ldx	<icHand+2lop101		sta	<topIcHand		stx	<topIcHand+2		jsr	derefHand		sta	<topIc		stx	<topIc+2		sta	<tempIc		stx	<tempIc+2lop100		lda	[<tempIc]		sta	<tempIcHand		ldy	#icNext+2		lda	[<tempIc],y		sta	<tempIcHand+2		ora	<tempIcHand		End of list?		beq	done100		lda	[<tempIcHand]		sta	<tempIc		lda	[<tempIcHand],y		sta	<tempIc+2sortGuy		jsr	$1111			Is tempIc less than topIc?		bcs	lop100		lda	<tempIcHand		New icon to compare with.		ldx	<tempIcHand+2		bra	lop101done100		lda	<topIcHand		Was a lesser icon found?		cmp	<icHand		bne	swap		lda	<topIcHand+1		cmp	<icHand+1		beq	noswapswap		ldy	#icLast+1		lda	[<ic],y		bne	ok100		lda	<topIcHand		sta	[<windBlk]		lda	<topIcHand+2		ldy	#windIcons+2		sta	[<windBlk],yok100		ldy	#icLast+2		Swap icNext and	icLast fields.lop102		lda	[<topIc],y		tax		lda	[<ic],y		sta	[<topIc],y		txa		sta	[<ic],y		dey		dey		bpl	lop102		lda	[<topIc]		Special	case if	side by	side.		cmp	<topIcHand		bne	ok101		ldy	#icNext+2		lda	[<topIc],y		cmp	<topIcHand+2		bne	ok101		lda	<icHand		sta	[<topIc]		lda	<icHand+2		sta	[<topIc],y		iny		iny		lda	<topIcHand		sta	[<ic],y		iny		iny		lda	<topIcHand+2		sta	[<ic],yok101		jsr	Neighbor		lda	<topIcHand		sta	<icHand		lda	<topIcHand+2		sta	<icHand+2		jsr	setic		jsr	NeighbornoSwap		ldy	#icTextY		;Give the icon a position.		lda	<ySpot		sta	[<ic],y		clc		adc	#10		sta	<ySpot		clc				;Continue flag.		rtsNeighbor	ldy	#icLast+2		lda	#icNext		jsr	flip		ldy	#icNext+2		lda	#icLastflip		pha		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		bne	ok200		txy		beq	exit200ok200		jsr	derefHand		lda	1,s		tay		lda	<icHand		sta	[<temp],y		iny		iny		lda	<icHand+2		sta	[<temp],yexit200		pla		rtssortProcs	DC.W	byName		DC.W	byDate		DC.W	bySize		DC.W	byKindsortProcsEnd;;   IN:	   topIc = pointer to ICONOBJ.;	   tempIc = pointer to other ICONOBJ.;;  OUT:	   Carry set if	tempIc should not be swapped with topIc.;byName		 		pha		pei <zero				lda	#icName		clc		adc	<topIc		ldx	<topIc+2		bcc	@nr		inx@nr		phx		pha				lda	#icName		clc		adc	<tempIc		ldx	<tempIc+2		bcc	@nr2		inx@nr2		phx		pha		_CompareStrings		pla		cmp	#$FFFF		rtsbyDate						; JAM 8/1/88 - class 1 comparison		sep	#$20			; short accumulator		LONGA	OFF		ldy	#icMDate+OSDateYear		lda	[<topIc],y		cmp	[<tempIc],y		bcc	exitbydate		bne	exitbydate		ldy	#icMDate+OSDateMonth		lda	[<topIc],y		cmp	[<tempIc],y		bcc	exitbydate		bne	exitbydate		ldy	#icMDate+OSDateDay		lda	[<topIc],y		cmp	[<tempIc],y		bcc	exitbydate		bne	exitbydate		ldy	#icMDate+OSDateHour		lda	[<topIc],y		cmp	[<tempIc],y		bcc	exitbydate		bne	exitbydate		ldy	#icMDate+OSDateMinute		lda	[<topIc],y		cmp	[<tempIc],y		bcc	exitbydate		bne	exitbydate		ldy	#icMDate+OSDateSecond		lda	[<topIc],y		cmp	[<tempIc],y		LONGM		beq	byname		exitbydate	LONGM		rtsbySize		ldy	#icFBlocks+2enter400	lda	[<topIc],y		cmp	[<tempIc],y		bcc	exit400		bne	exit400		dey		dey		lda	[<topIc],y		cmp	[<tempIc],y		bne	exit400		brl	bynameexit400		rtsbyKind				pha		pei <zero				jsr	pushTemp		;get address of tempIc's kind string		pha		phx				jsr	pushTop			;get address of topic's kind string		pha		phx				_CompareStrings		jsr	afterTemp		;possibly unlock tempIc's rBundle		jsr	afterTop		;possibly unlock topIc's rBundle				pla		beq	@goByName		eor	#$8000		asl	a		rts@goByName	brl	byName	;; pushTemp -- return AX = the kind string used by <tempIc;pushTemp	ldy	#icKind+1		lda	[<tempic],y		bne	@normalKind		ldy	#icRBundle		lda	[<tempIc],y		sta	<temp		iny		iny		lda	[<tempIc],y		sta	<temp+2				ldy	#4		lda	[<temp],y		ora	#$8000		sta	[<temp],y		lda	[<temp]		tax		ldy	#2		lda	[<temp],y		sta	<temp+2		stx	<temp		;		ldy	#icOneDocOffset;		lda	[<tempIc],y;		clc;		adc	<temp;		adc	#32;		sta	<temp;		tax;		iny;		iny;		lda	[<tempIc],y;		adc	<temp+2;		sta	<temp+2*** fixed 11-Jan-93 DAL to propogate carry correctly		ldy	#icOneDocOffset		;add the offset to the OneDoc to the address of the		lda	[<tempIc],y		;rBundle		clc		adc	<temp		sta	<temp		iny		iny		lda	[<tempIc],y		adc	<temp+2		sta	<temp+2		clc		lda	<temp		adc	#32		tax		lda	<temp+2		adc	#0*** end 11-Jan-93		rts@normalKind	ldy	#icKind		lda	[<tempIc],y		tax		iny		iny		lda	[<tempIc],y		rts		;; pushTop -- return AX = kind string used by <tempIc;pushTop		ldy	#icKind+1		lda	[<topIc],y		bne	@normalKind		ldy	#icRBundle		;get the handle of the rBundle		lda	[<topIc],y		sta	<temp		iny		iny		lda	[<topIc],y		sta	<temp+2		ldy	#4			;lock it		lda	[<temp],y		ora	#$8000		sta	[<temp],y				lda	[<temp]			;deref the rBundle's handle		tax		ldy	#2		lda	[<temp],y		sta	<temp+2		stx	<temp		;		ldy	#icOneDocOffset		;add the offset to the OneDoc to the address of the;		lda	[<topIc],y		;rBundle;		clc;		adc	<temp;		adc	#32;		sta	<temp;		tax;		iny;		iny;		lda	[<topIc],y;		adc	<temp+2;		sta	<temp+2*** fixed 9-Jan-93 DAL to propogate carry correctly		ldy	#icOneDocOffset		;add the offset to the OneDoc to the address of the		lda	[<topIc],y		;rBundle		clc		adc	<temp		sta	<temp		iny		iny		lda	[<topIc],y		adc	<temp+2		sta	<temp+2		clc		lda	<temp		adc	#32		tax		lda	<temp+2		adc	#0*** end 9-Jan-93		rts				;return AX = pointer to string@normalKind	ldy	#icKind			;address of FiFiFi kind string		lda	[<topIc],y		tax		iny		iny		lda	[<topIc],y		rts		;; afterTemp -- if the icon referenced by <tempIc has its kind string in the OneDoc, unlock the rBundle;afterTemp	ldy	#icKind+1		lda	[<tempIc],y		bne	@done				ldy	#icRBundle		lda	[<tempIc],y		sta	<temp		iny		iny		lda	[<tempIc],y		sta	<temp+2				ldy	#4		lda	[<temp],y;;;		and	#$7FFF		asl a		lsr a		sta	[<temp],y@done		rts;; afterTop -- if the icon referenced by <topIc has its kind string in the OneDoc, unlock the rBundle;afterTop	ldy	#icKind+1		lda	[<topIc],y		bne	@done				ldy	#icRBundle		lda	[<topIc],y		sta	<temp		iny		iny		lda	[<topIc],y		sta	<temp+2				ldy	#4		lda	[<temp],y;;;		and	#$7FFF		asl a		lsr a		sta	[<temp],y@done		rts		ENDP				;	   Set information bar fields in window.;;   IN:	   a = low word	of window to set values	for.;	   x = high word of window to set values for.;;  OUT:	   Fields in window's info block set to:;		 windFST = FST id of window's file-system;		 windItems = number of items in	window.;		 windUsed = number of kilobytes	used on	disk window came from.;		 windFree = number of kilobytes	free on	disk window came from.;;	   wind	= given	window pointer.;	   windBlk = wind's info block.;	   curWind = same as in.;.....................................................................setInfo2	PROCNAME EXPORT		sta	<wind		stx	<wind+2		jsr	clearWindDirty		;;   IN:	   wind	= window to set	values for.;;  OUT:	   Fields in window's info block set to:;		 windFST = FST id of window's file-system;		 windItems = number of items in	window.;		 windUsed = number of kilobytes	used on	disk window came from.;		 windFree = number of kilobytes	free on	disk window came from.;.....................................................................		EXPORT	setInfosetInfo	;; Number of items in window;		pei	<curWind+2		pei	<curWind		lda	<wind		sta	<curWind		lda	<wind+2		sta	<curWind+2		jsr	ifDesk			If desktop, just quit.		bne	ok2		brl	exit2;ok2		jsr	getwRefCon;; Initialize info bar for icons;		jsr	setItems		Count icons in window.;; Get volume information;		ldy	#windID		lda	[<windBlk],y		cmp	#DirWindID		Must be	a directory window for the rest.		bne	exit1		jsr	getWindPath		C1_Pathname = windPath in info block.		jsr	justRootName		C1_Pathname = pathname's root only.				jsr	GetVolSizes		Get sizes for volume.		bcs	exit2		lda	fileSysID		ldy	#windFST		cmp	[<windBlk],y		beq	@notSameFST		sta	[<windBlk],y		ldy	#windDirty		lda	#$8000		ora	[<windBlk],y		sta	[<windBlk],y@notSameFST		jsr	setKs			Set amount used	and free on disk.		bcs	exit1		ldy	#windDirty		lda	[<windBlk],y		bpl	exit2		;; Draw the new information only if the window info bar is dirty and needs to be updated;exit1		pei	<wind+2		pei	<wind		_DrawInfoBar			;do _ShowWindow here in ver 1.3exit2		ldy	#windDirty		;clear out the high bit		lda	[<windBlk],y;;;		and	#$7fff		asl a		lsr a		sta	[<windBlk],y				pla		sta	<curWind		pla		sta	<curWind+2		rts; Count icons in window.;;   IN:	   windBlk = pointer to	window's info block.;;  OUT:	   windItems field in info block set to	number of icons	in window.;	   high bit of windDirty's field is SET if before count didn't match after;	   count ;.....................................................................		EXPORT	setItemssetItems    		ldy	#windItems		lda	[<windBlk],y		pha		stz	<work			Initialize icon	counter.		lda	#countIcons		jsr	walkOfLife3		Count icons in window.		ldy	#windItems		Set number of items in window.		lda	<work		sta	[<windBlk],y				cmp	1,s		bne	@dirty		pla		rts		@dirty		pla		ldy	#windDirty		lda	#$8000		ora	[<windBlk],y		sta	[<windBlk],y		rts;; clear the high bit of the windDirty field;		EXPORT	clearWindDirtyclearWindDirty		ldy	#windDirty		lda	[<windBlk],y;;;		and	#$7fff		asl a		lsr a		sta	[<windBlk],y		rts		; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Get just the	root name from pathname.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   C1_PathName = full pathname.;;  OUT:	   C1_PathName = only the root name of given;		pathname with separator.;; = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	justRootNamejustRootName					;	        		sep	#$20			Use just the root name.		LONGA	OFF		ldx	<zerolop1		inx		cpx	C1_PathName		Don't exceed total length.		bcs	done1		lda	C1_PathName+2,x		cmp	#SEPARATOR		;GS/OS separator character		bne	lop1		stx	C1_PathName		Set length word to be just root.done1		rep	#$20		LONGA	ON		rts		; Set windUsed	and windFree fields in window info block.;;   IN:	   FreeBlks = number of blocks free.;	   NumBlks = total number of blocks on disk.;;   OUT:   SEC if the amount of free blocks in windFree and windUsed;	   was different from the amount on the way in to this routine;	   ;          CLC if the number of free blocks in windFree and windUsed;	   was the same from the amount on the way in to this routine;.....................................................................		EXPORT	setKssetKs	        		ldy	#windFree		;if the amount free and used before is the same		lda	[<windBlk],y		;as the amount free and used after, then		sta	free			;nothing has changed, so don't update squat		iny		iny		lda	[<windBlk],y		sta	free+2				ldy	#windUsed		lda	[<windBlk],y		sta	used		iny		iny		lda	[<windBlk],y		sta	used+2		ldy	#windFree		lda	FreeBlks		sta	[<windBlk],y		iny		iny		lda	FreeBlks+2		sta	[<windBlk],y		lda	NumBlks			Total number of	blocks on disk,		sec		sbc	FreeBlks		less those free,		tax				equals number used.		lda	NumBlks+2		sbc	FreeBlks+2		ldy	#windUsed+2		sta	[<windBlk],y		dey		dey		txa		sta	[<windBlk],y		ldy	#windUsed		lda	[<windBlk],y		cmp	used		bne	@drawInfo		iny		iny		lda	[<windBlk],y		cmp	used+2		bne	@drawInfo				ldy	#windFree		lda	[<windBlk],y		cmp	free		bne	@drawInfo		iny		iny		lda	[<windBlk],y		cmp	free+2		beq	@done@drawInfo	jsr	UpdateRootSizeW		sec		rts@done		jsr	UpdateRootSizeW		clc		rts;; locals;free		dc.L	0used		dc.L	0; = = =	= = = =	= = = =	= = = =	= = = =;	   Increment counter.; = = =	= = = =	= = = =	= = = =	= = = =countIcons	inc	<work			Increment icon counter.		clc				Continue flag.		rts		ENDP;=====================================;	   Walk	window list.;=====================================;;   IN:	   a = type of windows to accept.;	   x = routine to call for every window.;;  OUT:	   Carry clear if entire list walked,;	   set if terminated by	given routine.;;  Routine will	be passed the window pointer in	'wind'.;  Routine should return clear to continue down	list, or set to	terminate.;  On return 'wind' will be used to find the next window.;;=====================================walkWindow	PROC	EXPORT		stx	routine+1		jsr	getFrontWind		bcs	exit1			exit if no windows at all		beq	next1			If this oneÕs nil, try next one.*** 16-Oct-92 DAL: Modified to preserve, routine+1 and windowID, so that the***                subroutine we call can safely call walkWindow recursively!loop		ldy	routine+1		phy		ldy	windowID		phyroutine		jsr	$1111		ply		sty	windowID		ply		sty	routine+1		bcs	exit2			Did routine wish to terminate?next1		jsr	getNextWind		bne	loopexit1		clc				Entire window list walked flag.exit2		rts; getFrontWind -- get frontmost window;;;   IN:	   a = mask for	window ID.;;  OUT:	   Carry set if	at the desktop level, wind = deskport.;	   wind	= pointer to top most visible window, desktop if no windows.;	   a = window ID with mask applied.;	   x = front window's ID no matter what the mask.;	   If a	Finder window, then;		 windBlk = pointer to window's info block.;.....................................................................		EXPORT	getFrontWindgetFrontWind	sta	windowID		Save type of window the	caller wants.		pha				;Get front most visible window.		pha				;we don't care about invisible windows		_FrontWindow			;at this point (yet)		pla		plx		jsr	getWindID		tax				Return front window's ID in X.		and	windowID		Return ID with mask applied and	A.		rts; getNextWind -- get next window;;   IN:	   windowID = mask for window ID.;;  OUT:	   Carry set if	at the desktop level, wind = deskport.;	   wind	= pointer to top most visible window, desktop if no windows.;	   a = window ID. (BEQ if no windows left.);.....................................................................		EXPORT	getNextWindgetNextWind @loop		pha		pha		pei	<wind+2		pei	<wind				_GetNextWindow		pla		plx		jsr	getWindID		Get window's ID number.		bcs	@done			At the desktop level?		and	windowID		Is this	window acceptable?		beq	@loop			Loop until acceptable window found.				pha		pei	<wind+2		pei	<wind		_GetWFrame		pla		and	#$0020			;visible?		beq	@loop		@done		rts; getWindID -- determine a window's ID;;   IN:	   a = low word	pointer	of window.;	   x = high word pointer of window.;;  OUT:	   Carry set if	null pointer passed.;	   a = window's ID number (equal flag is set to a).;	   wind	= pointer of window.;	   If a	Finder window, then;		 windBlk = pointer to window's info block.;.....................................................................		IMPORT	aboutWindowPtr		EXPORT	getWindID		getWindID  		sta	<wind		stx	<wind+2		ora	<wind+2		bne	ok300			Is there a visible window?; ------ No visible windows, so	use desktop --------------------------theDesktop	jsr	toDesktop		wind = deskport, windBlk = desktop info.		lda	#NoWindID		sec				Null pointer passed flag.		rts; --- Check if front most window is the	desktop	------------------ok300		lda	<wind			Is the window the desktop?		cmp	<deskport		bne	ok301		cpx	<deskport+2		beq	theDesktop; --- Check if front most window is a system window ------------------ok301		pha				Space for result.		phx				Pass window pointer.		pha		_GetSysWFlag		lda	#SysWindID		System window flag.		plx				Application or System window?		bne	gotit300		; --- It's an application window, find out which kind ----------------		jsr	windRefCon		windBlk	= pointer to window's info block. 		EXPORT	getWindID2getWindID2        		ldy	#windID			Return window's ID number.		lda	[<windBlk],ygotit300	tax		clc				There is a window flag.		rts		ENDP;==================================================;	   Move	curWind	into windTrack.;==================================================;;   IN:	   curWind = value to move into	windTrack.;;  OUT:	   windTrack = curWind.;	   a = low word	of curWind and windTrack.;	   x = high word of curWind and	windTrack.;;==================================================cur2windT	PROC	EXPORT		lda	<curWind		sta	<windTrack		ldx	<curWind+2		stx	<windTrack+2		rts				ENDP;=============================================;	   Get window's origin offset.;=============================================;;   IN:	   curWind = window to get offset for.;;  OUT:	   yoffset, yoffset2, xoffset, xoffset2	are set.;	   port	= curWind, origin set.;;=============================================getWoffset	PROC	EXPORT		jsr	startDraw		Switch to window's port.		EXPORT	getWoffset2getWoffset2   		ldy	#BoundsRect+y1		lda	[<curWind],y		eor	#$FFFF		inc	a		sta	<yoffset		sta	<yoffset2		(in two	places for easy	RECT offsets).		iny		iny		lda	[<curWind],y		eor	#$FFFF		inc	a		sta	<xoffset		sta	<xoffset2		rts				ENDP;======================================================;	   Check if icon is within 'rect'.;======================================================;;   IN:	   rect	= RECT to check.;	   ic =	icon to	check.;;  OUT:	   Equal is FALSE if hit (a not	0).;;======================================================; JAM 06/04/89 - Partially undoing DJB fix for BRC #45692 in the case that we are;   checking to see if we are rubberbanding a bunch of icons for multiple selection.;   Don's fix had the undesirable property of rubberbanding as if the window was;   view-by-icon even if it was view-by-text.  So, you ended up not selecting what;   you thought you were selecting in a view-by-text rubberband ("snaggletooth selection").; Don, do we really need to fake view by big icon???OldCheckRectHit	PROC	EXPORT		jsr	GetIconRect		bra	RectHit2		ENTRY	checkRectHit; end JAM 06/04/89 - Partially undoing DJB fix for BRC #45692checkRectHit;--- Start DJB fix for BRC 45692 ---------------		IMPORT	getIconRect2		ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		; view by text?		bcc	@Get		lda	<zero			; fake view by big icon@Get		jsr	getIconRect2		;irect1 = icon's enclosing RECT.;--- end fix -----------------------------------						;irect2 = icon title's RECT.		EXPORT	RectHit2RectHit2 		pha				Space for result.		jsr	pushrect		Pass pointer to	rubber-band RECT.		jsr	pushirect1		Pass pointer to	icon's RECT.		jsr	pushwork		Pass pointer to	temp RECT for result.		_SectRect			Intersect RECTs.		pla		bne	exit			Was there any intersection?		pha				Space for result.		jsr	pushrect		Pass pointer to	rubber-band RECT.		jsr	pushirect2		Pass pointer to	title's RECT.		jsr	pushwork		Pass pointer to	temp RECT for result.		_SectRect			Intersect RECTs.		plaexit		rts		ENDP ;.....................................................................;; Now, just a minute before we add you to the rectList mr. selected icon.  We need to; check and see if any of your pieces parts protrude into the visRgn.  If any part of; <irect1 or <irect2 are inside of our visRgn, then we'll add it to the list, but if; the whole icon image is outside the visRgn, then forget about adding it to the rectList; because we don't need to be dragging around more than we really need to be.;; OUT: carry set if in visrgn, the boundsrect of which is defined by <visRect;      carry clear if not in the boundsrect of the visrgn;.....................................................................CheckVisEdges	PROC	EXPORT		lda	<irect2+y2		cmp	<visRECT+y1		bmi 	@exit				lda	<irect1+y1		cmp 	<visRECT+y2		beq	@inVerticalVis		bpl	@exit;; now that we know it's inside the vertical visRgn, we need to check the horizontal; coordinates and see if the whole of the icon is outside of the visRgn's right and; left edges;; NOTE: if we're viewing something by name, it's possible to drag something which is;	completely outside the horizontal portion of our visrgn, so we should -not- check;	the horizontal portion if we're dragging from a list view.;@inVerticalVis	ldy	#windView				lda	[<windBlk],y		cmp	#viewByName		;don't check horizontal vis if list view		bge	@inHorizontalVis		lda	<irect1+x2		;check the left edge of the visRgn		cmp	<visRECT+x1		;against the right edge of our icon and		bpl	@checkRightEdge		;our icon's name				lda	<irect2+x2		cmp	<visRECT+x1		bmi	@exit		@checkRightEdge	lda	<irect1+x1		;check the right edge of the visRgn		cmp 	<visRECT+x2		;against the left edge of our icon and		beq	@inHorizontalVis	;our icon's name		bmi	@inHorizontalVis		lda	<irect2+x1		cmp 	<visRECT+x2		beq	@inHorizontalVis		bmi	@inHorizontalVis	@exit		clc		rts		@inHorizontalVis sec		rts		ENDP;==================================================;	   Build a RECT	list of;	   all the selected icons.;==================================================;;   IN:	   windBlk = info block	for icon list.;	   yoffset = amount to added to	top and	bottom sides of	RECTs.;	   xoffset = amount to added to	left and right sides of	RECTs.;;  OUT:	   rectRgn = handle of region containing all the icons.;	   tempRgn = handle of a work region.;;==================================================buildRects	PROC	EXPORT		import	deltax2		import	deltay2		import	bothRects				lda	#ICSELECTED		Add all	selected icons to region.		bra	store1		EXPORT	buildRects2buildRects2		lda	#ICDELETE		Add all	deleted	icons to region.store1		sta	addFlag			Set types of icons to add to region.; --- Allocate regions ----------------------------------------------------		jsr	getRectRgn		Allocate rectRgn and tempRgn.;; get the visRgn for the window which we're dragging stuff from, so that we only have; to show any of the icons that are inside of our visRgn, not all the stuff outside of; vis;		jsr	StartDraw				ldy	#visRgnOffset		lda	[<curWind],y		sta	<handle		iny		iny		lda	[<curWind],y		sta	<handle+2		lda	[<handle]		;deref it		tax		ldy	#2		lda	[<handle],y		sta	<ptr+2		stx	<ptr				ldy	#8			;move the rgn's boundsrect to a place we can		ldx	#6@loop		lda	[<ptr],y		;play with it		sta	<visRECT,x		dey		dey		dex		dex		bpl	@loop						jsr	EndDraw				lda	#addRects		brl	walkOfLife3; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =  =  =	=;	   Add selected	icon's area to rectRgn.; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =  =  =	=;;   IN:	   rectRgn = handle of region to accumulate icon area into.;	   tempRgn = handle of work region.;	   ic =	pointer	to icon.;; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =  =  =	=addRects		ldy	#icFlag			;Is this icon selected?		lda	[<ic],y		and	addFlag		bne	@addIconsRect				clc		rts;; See if the icon which has not been moved is in vis;@addIconsRect	jsr	getIconRect				jsr	CheckVisEdges		;is any part of this icon visible?		bcs	@addIcon		;if yes, add icon to our region				;; Now, see if the icon's new position is in vis, and if it is, add that part into the; region;		ldx	#16-2@iLoop1		lda	<irect1,x		sta	>bothRects,x		dex		dex		bpl	@iLoop1		lda	<irect1+x1		;offset the x coordinates of <irect1		clc		adc	deltax2		sta	<irect1+x1		lda	<irect1+x2		clc		adc	deltax2		sta	<irect1+x2		lda	<irect1+y1		;offset the y coordinates of <irect1		clc		adc	deltay2		sta	<irect1+y1		lda	<irect1+y2		clc		adc	deltay2		sta	<irect1+y2				lda	<irect2+x1		;offset the x coordinates of <irect2		clc		adc	deltax2		sta	<irect2+x1		lda	<irect2+x2		clc		adc	deltax2		sta	<irect2+x2		lda	<irect2+y1		;offset the y coordinates of <irect2		clc		adc	deltay2		sta	<irect2+y1		lda	<irect2+y2		clc		adc	deltay2		sta	<irect2+y2		jsr	CheckVisEdges		;is any part of this shifted icon visible?		bcc	@exit			;if not, we're outta here!					ldx	#16-2			;copy both rects back like they were@iLoop2		lda	>bothRects,x		sta	<irect1,x		dex		dex		bpl	@iLoop2@addIcon	jsr	addIconRgn2		;Add icon's region to rectRgn.@exit		clc				;Continue flag.		rts; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =;	   Allocate two	regions.; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =;;  OUT:	   tempRgn = handle of region.;	   rectRgn = handle of region.;; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =		EXPORT	getRectRgngetRectRgn  	jsr	allocateRgn		;Allocate a work region.		sta	<tempRgn		stx	<tempRgn+2		EXPORT	getOnlyRectRgngetOnlyRectRgn	jsr	allocateRgn		;Allocate a region.		sta	<rectRgn		stx	<rectRgn+2		rts; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =;	   Add an icon's area to rectRgn.; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =;;   IN:	   rectRgn = handle of region that accumulates icon areas.;	   tempRgn = handle of work area region.;	   ic =	pointer	to ICONOBJ.;	   windBlk = pointer to	icon's window info block.;; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =		EXPORT	addIconRgnaddIconRgn	jsr	getIconRect		Compute	RECTs for icon and its title.addIconRgn2	ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		bne	@bothRegions		@oneRegion	lda	#irect1		jsr	pushzpage		lda	#irect2		jsr	pushzpage		lda	#irect2		jsr	pushzpage		_UnionRect		bra	addirect2@bothRegions	lda	#irect1			Add icon's RECT to rectRgn.		jsr	addRgn		EXPORT	addirect2addirect2    	lda	#irect2			Add icon's title RECT to rectRgn.; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =;;   IN:	   a = direct page offset of RECT to add to rectRgn.;; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =		EXPORT	addRgnaddRgn		pei	<tempRgn+2		Pass handle of work region.		pei	<tempRgn		jsr	pushzpage		Pass pointer to	RECT.		_RectRgn			tempRgn	= irect1.				pei	<rectRgn+2		pei	<rectRgn		pei	<tempRgn+2		pei	<tempRgn		pei	<rectRgn+2		pei	<rectRgn		_UnionRgn		rts; GetVisRECT -- put the boundsrect of the visrgn into <visRECT;.....................................................................		EXPORT	GetVisRECTGetVisRECT	pushZLong <deref;;; Opt 20-Feb-92 DAL (new way takes one more byte of code here but saves DP space & cycles);		ldy	#$24			;get the pointer to our port;		lda	[<QuickDrawDP],y;		sta	<deref;		iny;		iny;		lda	[<QuickDrawDP],y;		sta	<deref+2***		ldx <QuickDrawDP		lda >$000024,x		sta <deref		lda >$000026,x		sta <deref+2***		ldy	#visRgnOffset		;get the offset to the grafport's visrgn handle		lda	[<deref],y		tax		iny		iny		lda	[<deref],y		sta	<deref+2		stx	<deref				lda	[<deref]		;deref the visrgn's handle		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref				ldy	#8			;move the rgn's boundsrect to a place we can		ldx	#6@loop		lda	[<deref],y		;play with it		sta	<visRECT,x		dey		dey		dex		dex		bpl	@loop				pulllong <deref		rts		; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Build a RECT	list of;	   all the selected icons.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   windBlk = info block	for icon list.;	   yoffset = amount to added to	top and	bottom sides of	RECTs.;	   xoffset = amount to added to	left and right sides of	RECTs.;;  OUT:	   rectHand = handle of	RECT list.;	   rectPtr = (rectHand).;	   rect	= bounds of all	RECTs added to list (in	global).;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	buildRectListbuildRectList					;	        maxNumber	equ	100			Max number of RECTS that can be	in list.; --- Allocate RECT list buffer	-------------------------------------------		ldx	#$4000			Locked,	I won't need it that long.		lda	#(maxNumber*16)+2	Number bytes needed for	RECT list.		jsr	allocate2		Allocate a buffer for the RECTs.		sta	<rectHand		Remember handle.		stx	<rectHand+2		jsr	derefHand		temp = memory block pointer.		sta	<rectPtr		Save pointer to	RECT list.		stx	<rectPtr+2		lda	<zero			Zero RECT count.		sta	[<rectPtr]		;; get the visRgn for the window which we're dragging stuff from, so that we only have; to show any of the icons that are inside of our visRgn, not all the stuff outside of; vis -- startdrawing already done here, so it's ok to get vis.;		jsr	GetVisRECT		lda	#addRectList		brl	walkOfLife3; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =;	   Add icon to RECT list.; =  =	=  =  =	 =  =  =  =  =	=  =  =	 =  =  =addRectList		ldy	#icFlag			Is this	icon selected?		lda	[<ic],y		and	#ICSELECTED		bne	@selected		clc		rts		@selected	jsr	getIconRect		Compute	RECTs for icon and its title.		jsr	CheckVisEdges		bcs	@inVis		brl	exit100		;; Our icon was in both the vertical and horizontal visRgn's boundsRect, so it's OK; to add it to the list of icon rectangles to be drawn;@inVis		lda	#2			;normally add 2 rects unless by some other view		sta	addHowManyRects		;other than by Icon				ldy	#windView				lda	[<windBlk],y		cmp	#viewBySmallIcon			blt	@byIcon				jsr	pushirect1		jsr	pushirect2		jsr	pushirect1		_UnionRect		lda	#1		sta	addHowManyRects		;; If the view is by small icon or large icon, then the rectangles need to be drawn; for both the icon and the name.  ;		@byIcon		lda	[<rectPtr]		Get current number of RECTs.		cmp	#maxNumber		RECT list already full?		bcs	exit101		asl	a			Times 8	(size of RECT).		asl	a		asl	a		inc	a			Plus two for the count WORD.		inc	a		tay				That the index to the next open	spot.		ldx	<zero			;Store icon RECTs in RECT list as global.lop100		phx		txa		and	#3		tax		lda	<yoffset,x		plx		clc		adc	<irect1,x		sta	<irect1,x		;also transform irect1 and irect2 to be global		sta	[<rectPtr],y		iny		iny		inx		inx		cpx	#16		bcc	lop100		lda	[<rectPtr]		Increment the RECT counter.		bne	skip100			First RECT?		ldx	<irect1+y1		Initialize bounds RECT.		stx	<dRect+y1		ldx	<irect1+x1		stx	<dRect+x1		ldx	<irect2+y2		stx	<dRect+y2		ldx	<irect1+x2		stx	<dRect+x2skip100		clc			adc	addHowManyRects		sta	[<rectPtr]; --- Compute bounds --------------------------------------------------------		jsr	pushirect1		jsr	pushirect2		jsr	pushirect1		_UnionRect		jsr	pushirect1		jsr	pushrect		jsr	pushrect		_UnionRectexit100		clc				Continue flag.exit101		rts;; locals;addHowManyRects	dc.w	0		ENDP;============================================;	   Setup window	for drawing.;============================================;;   IN:	   a = low word	of window plane	to set.;	   x = high word of window plane to set.;;============================================startDraw2	PROC	EXPORT		pei	<curWind+2		pei	<curWind		sta	<curWind		stx	<curWind+2		jsr	startDraw		pla		sta	<curWind		pla		sta	<curWind+2		rts;============================================;;   IN:	   CurWind = window pointer.;;============================================		EXPORT	StartDrawStartDraw        		jsr	ifDesk		bne	ok1		brl	toDeskPort		Switch to the desktop port.ok1		pei	<curWind+2		pei	<curWind		_StartDrawing		rts		EXPORT	endDrawendDraw 		lda	<zero		pha		pha		_SetOrigin		rts				ENDP;=======================================================;	   Test	if curWind is the desktop port.;=======================================================;;   IN:	   curWind = port to check.;	   deskport = address of desktop port.;;  OUT:	   a = low address of desktop port.;	   x = hi address of desktop port.;	   Equal flag is TRUE if curWind = deskport.;;=======================================================ifDesk		PROC	EXPORT		lda	<deskport		ldx	<deskport+2		cmp	<curWind		bne	exit		cpx	<curWind+2exit		rts		ENDP;=====================================;	   Allocate a region.;=====================================;;  OUT:	   a = lo region handle.;	   x = hi region handle.;;=====================================allocateRgn	PROC	EXPORT		pha		pha		_NewRgn		pla		plx		rts				ENDP;=========================================;	   Push	a direct page;	   address on the stack.;=========================================;;   IN:	   a = direct page offset.;;=========================================pushyrat	PROC	EXPORT		lda	#yrat		bra	pushzpage		EXPORT	pushirect1pushirect1        		lda	#irect1		bra	pushzpage		EXPORT	pushirect2pushirect2        		lda	#irect2		bra	pushzpage		EXPORT	pushworkpushwork    		lda	#work		bra	pushzpage		EXPORT	pushTaskpushTask     		lda	#TaskRec		bra	pushzpage		EXPORT	pushrectpushrect        		lda	#dRect		EXPORT	pushzpagepushzpage        		plx		pei <zero		pha		tdc		clc		adc	1,s		sta	1,s		phx		rts				ENDP;==================================================;	   Find	all the	selected icons.;==================================================;;   IN:	   a = routine to call with found selected icon.;	   curWind = list to search.;;==================================================findSelect	PROCNAME EXPORT		ldx	WalkGoto+1		phx				sta	WalkGoto+1		pushlong saveHand		lda	abortFind		pha		stz	abortFind		Clear abort flag.		lda	#ckSelect		jsr	walkBack				pla		sta	abortFind		pulllong saveHand		plx		stx	WalkGoto+1		rts		ckSelect        ldy	#icFlag			Is this	icon selected?		lda	[<ic],y		and	#ICSELECTED		beq	exit			Nothing	to do if not.		lda	<icHand+2		Save place in list.		sta	saveHand+2		Saved in a global place	so it can		lda	<icHand			changed	like when the icon is cut		sta	saveHand		out of the list.		pei	<curWind+2		pei	<curWind		EXPORT	WalkGotoWalkGoto        jsr	$1111			Call the given routine.		pla		sta	<curWind		pla		sta	<curWind+2		lda	saveHand		sta	<icHand		lda	saveHand+2		sta	<icHand+2		jsr	lockic		lda	abortFind		Should walk be aborted?		bne	exit1		lda	quit_flags		Something cause	a quit?		beq	exitexit1		sec				Abort flag.		rtsexit		clc				Continue flag.		rts		ENDP;===========================================;	   Walk	window's icon list.;===========================================;;   IN:	   wind	= window to walk. (Actually it's curWind! DAL);	   a = address of routine to call.;;  OUT:	   Carry clear if entire list walked.;	   Carry set if	terminated by given routine, ICONOBJ still locked.;;===========================================walkOfLife	PROC	EXPORT		pha		jsr	getwRefCon		Get handle of first icon in list.		bra	enter1		EXPORT	walkOfLife3walkOfLife3       		pha		jsr	getHeadIconenter1		sta	<icHand		stx	<icHand+2		pla		EXPORT	walkOfLife2walkOfLife2		sta	tocall+1		Save address to	call.		ldy	#icNext+2		sty	<direction		bra	enter2		EXPORT	walkBackwalkBack		pha				Save address to	call.		lda	#findEnd		jsr	walkOfLife		bra	skip1		EXPORT	walkBack2walkBack2		pha		lda	#findEnd		jsr	walkOfLife2skip1		ldy	#icLast+2		Walk list from back to front.		sty	<direction		pla				Get address to call.		sta	tocall+1		Set address to call.		bra	enter2; --- Walk list	---------------------------------------------------------lop1		ldy	#4			Lock ICONOBJ.		lda	[<icHand],y		ora	#$8000		sta	[<icHand],y		dey				Dereference icon's handle.		dey		lda	[<icHand],y		sta	<ic+2		lda	[<icHand]		sta	<ic*** added 30-Sep-92 DAL -- If icHand dereferenced to itself, we're in trouble ($ABABABAB, etc)		cmp	<icHand		bne	@valid		lda	<ic+1		cmp	<icHand+1		bne	@valid		jsr	WalkOfLifeWarning		clc		rts@valid*** end 30-Sep-92; --- Call given routine -----------------------------;;   ic = pointer to locked ICONOBJ.;   icHand = handle of ic.;   wind = ic's owner window.;		pei	<direction		lda	tocall+1		pha				EXPORT	tocall	tocall   	jsr	$1111			;*** self-modifying ***		pla		sta	tocall+1		pla		sta	<direction		bcs	exit		ldy	#4			Unlock ICONOBJ.		lda	[<icHand],y;;;		and	#$7FFF		asl a		lsr a		sta	[<icHand],y;; "A little paranoia never hurt anyone.  Did It?!" - DAL, quoted by andy;		lda	[<icHand]		;just for kicks, dereference the handle again JUST		sta	<ic			;in case <ic managed to move while inside of WalkOfLife		ldy	#2			;(can you say, aieee?!?!)		lda	[<icHand],y		sta	<ic+2								ldy	<direction		Get handle of the next ICONOBJ.		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		sta	<icHand			Store handle of	ICONOBJ.		stx	<icHand+2enter2		lda	<icHand+1		Any more in list?		bne	lop1		clc				Entire list walked.exit		rtsfindend			ldy	#icNext+1		Any more icons in list?		lda	[<ic],y		beq	thatsend		clc				Continue.		rtsthatsend	sec				This is	the last icon in the list.		rts*** added 30-Sep-92 DAL -- Complain about hitting an infinite loop.WalkOfLifeWarning		pha				;space for button number		lda #^warning1		pha		pea warning1		pha		pea warning2		pha		pea warning3		pha		pea warning4		_TLTextMountVolume		pla		rtswarning1	str 'Warning: Infinite loop while'warning2	str 'walking icon list.'warning3	str 'Hit Return'warning4	str ''*** end 30-Sep-92; = = =	= = = =	= = = =	= = = =	= = = =	=;	   Get window's RefCon.; = = =	= = = =	= = = =	= = = =	= = = =	=;;  get:	   a = low window.;	   x = high window.;;  OUT:	   a = low word	of first ICONOBJ.;	   x = high word of first ICONOBJ.;	   windBlk = window information	block.;;; = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	toDesktoptoDesktop	        		lda	<deskPort		ldx	<deskPort+2		bra	getwRefCon2		EXPORT	getwRefCongetwRefCon	        		lda	<curWind		ldx	<curWind+2		EXPORT	getwRefCon2getwRefCon2	        		sta	<wind		stx	<wind+2		cmp	<deskport		Desktop	or window?		bne	ok1		cpx	<deskport+2		bne	ok1; = = =	= = = =	= = = =	= = = =	= = = =	=;;  OUT:	   windBlk = pointer to	desktop	window block.;; = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	getDeskWindBlkgetDeskWindBlk	        		tdc		clc		adc	#deskic		sta	<windBlk		stz	<windBlk+2		lda	<deskic			Return handle of first icon on desktop.		ldx	<deskic+2		rts; = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   wind	= window to get	refCon for.;; = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	windRefConwindRefCon        ok1		pha				Space for result.		pha		pei	<wind+2			Pass pointer of	window.		pei	<wind		_GetWRefCon		pla				Get pointer to window info block.		sta	<windblk		pla		sta	<windblk+2		EXPORT	getHeadIcongetHeadIcon        		ldy	#windIcons+2		Get handle of first icon in list.		lda	[<windblk],y		tax		lda	[<windblk]		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Switch to the desktop port.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;		EXPORT	toDeskPorttoDeskPort       		pei	<deskPort+2		pei	<deskPort		_SetPort		rts		ENDP;=================================================;	   Compute icon	and title RECTs.;=================================================;;   IN:	   ic =	pointer	to ICONOBJ.;	   windBlk = pointer to	icon's window info block.;;  OUT:	   irect1 = icon's RECT.;	   irect2 = icon title's RECT.;	   temp	= trash.;;=================================================lockWidth	equ	16lockHeight	equ	8getIconRect	PROCNAME EXPORT		ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		View by	text?		bcc	getIconRect2; --- Small icon, text view ---------------------------------------------		ldy	#icx		lda	[<ic],y		pha				Save icon x position.		lda	#textLeft		Force text x position.		sta	[<ic],y		dey		dey		lda	[<ic],y		pha				Save icon y position.		ldy	#icTextY		Set text's y position.		lda	[<ic],y		ldy	#icy		sta	[<ic],y		lda	#1			Compute	RECTs as if a small icon.		jsr	GetIconRect2		ldy	#icy			Restore	icon's position.		pla		sta	[<ic],y		iny		iny		pla		sta	[<ic],y		rts; --- View by icon (large or small) ---------------------------------------;;  a = 0 for large, 1 for small.;;=================================================		import	UnlockICBLKHAND		;22-Mar-93 JCM		ENTRY	getIconRect2getIconRect2		pha				Save state.		jsr	getIconPtr		icon = pointer to ICON.		ply		jsr	GetIconRect3		*** Scrunched - 21-Mar-93 JCM		;;;		ldy	#4			;unlock the icon block handle;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y;;;		rts		brl	UnlockICBLKHAND		;it does the rts*** End - 21-Mar-93 JCM	;; Just calculate the rectangles for the icons -- used by drawIcon2, so do NOT trash anything; other than irect1 and irect2; ; IN: (Y) = 0 for large icon, non-zero for small icon;		EXPORT	GetIconRect3GetIconRect3	phy		;		; ------ Get RECT for image part of icon ---------------------------------;		ldy	#icy		lda	[<ic],y		sta	<irect1+y2		Bottom of icon.		iny		iny		lda	[<ic],y		ldy	#imWidth		sec		sbc	[<icon],y		sta	<irect1+x1		Left side.		clc		adc	[<icon],y		Left side plus width,		adc	[<icon],y		(Double	for 640	mode.)		sta	<irect1+x2		equals right side.		ldy	#imHeight		lda	<irect1+y2		Bottom,		sec		sbc	[<icon],y		less height,		sta	<irect1+y1		equals top side.; --- Compute icon's title rect (top and bottom already set) -------------		pla				Large or Small icon?		bne	smallIcon		lda	<irect1+y2		dec	a		sta	<irect2+y1		clc		adc	#TITLE_H+2		sta	<irect2+y2		ldy	#icx			From the icon's x position,		lda	[<ic],y		ldy	#icTitleLen		sec				subtract half the title's length,		sbc	[<ic],y			to get the title's x1 position.		sta	<irect2+x1		Title's left side.		ldy	#icFlag			;get locked status		lda	[<ic],y		and	#ICLOCKED		bne	lock			;adjust for lock		lda	<irect2+x1		;Title's left side.		bra	enter1lock		lda	<irect2+x1		sec		sbc	#lockWidth/2		;re-adjust for lock		sta	<irect2+x1		bra	enter1smallIcon	ldy	#imHeight		lda	[<icon],y		sec		sbc	#TITLE_H		Height of font.		bcs	ok1		lda	<zerook1		pha		lda	<irect1+y2		sec		sbc	1,s		sta	<irect2+y2		sbc	#TITLE_H		sta	<irect2+y1		pla		lda	<irect1+x2		sta	<irect2+x1		Title's left side,		ldy	#icx		lda	[<ic],y		clc		adc	#16enter1		ldy	#icTitleLen		; a-reg has x1		sec				(A little extra.)		adc	[<ic],y			plus half the title's length,		adc	[<ic],y			plus the other half,		sta	<irect2+x2		equals the title's right side.		ldy	#icFlag			;get locked status		lda	[<ic],y		and	#ICLOCKED		beq	exit			;not locked		lda	<irect2+x2		clc		adc	#lockWidth		;re-adjust for lock		sta	<irect2+x2exit		rts				ENDP;========================================================;	   Push	pointer	to icon's name on stack.;========================================================;;   IN:	   ic =	pointer	to ICONOBJ.;;  OUT:	   pointer to icon's name on stack.;;========================================================pushicName	PROC	EXPORT		ply				Get return address.		ldx	<ic+2		lda	<ic		clc		adc	#icName		bcc	store2		inxstore2		phx		pha		phy				Put return address back.		rts				ENDP; = = =	= = = =	= = = =	= = = =	= = = =;	   Lock	icHand.; = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   icHand = handle to lock.;;  OUT:	   icHand  is locked.;	   ic =	(icHand).;; = = =	= = = =	= = = =	= = = =	= = = =lockic      	PROC	EXPORT		ldy	#4			Lock handle.		lda	[<icHand],y		ora	#$8000		sta	[<icHand],y; = = =	= = = =	= = = =	= = = =	= = = =;	   Dereference icHand.; = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   icHand = handle of ICONOBJ.;;  OUT:	   ic =	pointer	to ICONOBJ.;; = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	seticsetic		lda	[<icHand]		sta	<ic		ldy	#2		lda	[<icHand],y		sta	<ic+2		rts; = = =	= = = =	= = = =	= = = =	= = = =;	   Unlock icHand.; = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	unlockicunlockic 		ldy	#4		lda	[<icHand],y		and	#$7FFF		sta	[<icHand],y		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Dereference a handle.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   a = lo word of handle.;	   x = hi word of handle.;;  OUT:	   temp	= dereferenced handle.;	   a = temp.;	   x = temp+2;; = = =	= = = =	= = = =	= = = =	= = = =	= = =		EXPORT	derefHandderefHand    		sta	<temp		stx	<temp+2; = = =	= = = =	= = = =	= = = =	= = = =;	   Dereference temp.; = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   temp	= handle.;;  OUT:	   a = low word	of pointer.;	   x = high word of pointer.;	   temp	= pointer;; = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	setTempsetTemp    		ldy	#2		lda	[<temp],y		tax		lda	[<temp]		sta	<temp		stx	<temp+2		rts				ENDP;====================================================;	   Allocate a movable memory block.;====================================================;;   IN:	   a = number of bytes to allocate.;;  OUT:	   a = low word	of handle.;	   x = high word of handle.;;====================================================allocate	PROC	EXPORT		ldx	<zero			Anything, anywhere attributes.;====================================================;;   IN:	   x = attributes.;;====================================================		EXPORT	allocate2allocate2    		pha				Space for result.		pha		pei <zero			Pass size of block needed.		pha		pei	<MyID		phx				Pass attributes.		pha				Pass address, not used.		pha		_NewHandle		pla		plx		rts				ENDP;============================================;	   Pull	common icon fields.;============================================;;   IN:	   ic =	pointer	to icon	being duplicated.;;  OUT:	   filetype = icFType field.;	   ticonobj+icLocalAccess = icLocalAccess field;	   ticonobj+icNetworkAccess = icNetworkAccess field;	   ticonobj+icIcon = icIcon field;	   ticonobj+icSmallIcon = icSmallIcon field;	   ticonobj+icOneDoc = icOneDoc field;	   ticonobj+icFlag = icFlag field, color, locked and open states;	   ticonobj+icFBlocks = icFBlocks field;	   ticonobj+icFBytes = icFBytes field;	   ticonobj+icCDate = icCDate field;	   ticonobj+icMDate = icMDate field;	   ticonobj+icWind = icWind field;	   ticonobj+icOptionList = icOptionList field;;============================================PullFields	PROC	EXPORT		IMPORT	 PullFieldsLong		jsl	PullFieldsLong		;save some main segment space		rts		ENDP;====================================================;	   Remove every	window and extended;	   icon	that came from the disk.;====================================================;;   IN:	   icHand = handle of disk icon	being cleared.;;====================================================clearDisk	PROC	EXPORT		jsr	ClearAll		stz	<windTrack+1		Destination window may have closed.		rts				EXPORT ClearAllClearAll	pei	<rectRgn+2		pei	<rectRgn		pei	<tempRgn+2		pei	<tempRgn		lda	saveHand+2		pha		lda	saveHand		pha		stz	<rectRgn+1		Mark as	freed, cause I saved them.		stz	<tempRgn+1		jsr	getRectRgn		Allocate rectRgn and tempRgn.		lda	#wipeIcon		Routine	to erase and free icons.		jsr	walkExt		jsr	redrawList		Redraw hole left by deleted icons.		jsr	closeKids		Close every window from	disk.		pla		sta	saveHand		pla		sta	saveHand+2		pla		sta	<tempRgn		pla		sta	<tempRgn+2		pla		sta	<rectRgn		pla		sta	<rectRgn+2		rts				ENDP;=======================================================;	   Find	the next open spot for an icon.;=======================================================;;   IN:	   windBlk = pointer to	window info block.;	   posFlag = TRUE if 'temp' points to a	position buffer.;;  OUT:	   yrat	= y position.;	   xrat	= x position.;	   icHand = trash.;	   ic =	trash.		      ;;=======================================================DeskSpot	PROC	EXPORT		import	spotHash;topRow		equ	22;vertOffset	equ	35			;added 07/26/88 DJB;leftSide	equ	52;rightSide	equ	576desktopTopRow	equ	20+10topRow		equ	21vertOffset	equ	32desktopVertOffset equ	35leftSide	equ	52rightSide	equ	570;; Because spot hashing is turned on INSIDE this routine for the desktop, deskspot can never be; expected to give a lot of performance if we were positioning a ton of icons on the desktop in; succession.;		stz	spotFlag		Set desktop flag.		stz	posFlag				jsr	StartHash		;setup spot hashing				lda	#DesktopTopRow		ldx	#rightSide		bra	enter1		EXPORT	windSpotwindSpot			lda	#$FFFF		sta	spotflag		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		blt	@byLargeIcon		lda	<zero		ldx	#14		bra	enter1@byLargeIcon	lda	#topRow-10		ldx	#leftSide+14;=======================================================;;   IN:	   x = horizontal starting position.;	   a = vertical	starting position.;	   spotFlag = TRUE if finding a	spot in	a window.;;=======================================================enter1		stx	<dRect+x1		sta	<dRect+y1		stz	spotCount		;Initialize hash counter.lop1		lda	<dRect+y1		;Compute coordinates to check.		clc		adc	#20		sta	<dRect+y2		lda	<dRect+x1		clc		adc	#40		sta	<dRect+x2		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		blt	@byLargeIcon		lda	<dRect+y1		;Compute coordinates to check for small icon view		clc		adc	#9		sta	<dRect+y2		lda	<dRect+x1		clc		adc	#142		sta	<dRect+x2@byLargeIcon;; --- Check to see if any icon is within the RECT spot being checked --------;		lda	spotHashOn		Is hashing on? (rdl: I think itÕs off during FinderInit)		beq	skip1		jsr	getHashIndex		Check if already taken.		bcs	skip1			Range error?		and	>spotHash,x		bne	nextspot		If already taken, no need to check.skip1		jsr	getHeadIcon		Start with first icon.		sta	<icHand		stx	<icHand+2		pei	<direction		save direction across walkOfLife2 call		lda	tocall+1		save walkOfLifeÕs current jsr value		pha		lda	#findspot		will be stored to tocall+1		jsr	walkOfLife2		pla		sta	tocall+1		restore		pla		sta	<direction		restore		bcs	nextSpot		Were all icons check without a hit?		brl	gotit		;; --- Go to next spot -------------------------------------------------------;nextSpot		lda	spotHashOn		Is hashing on?		beq	@nextSpot		jsr	getHashIndex		bcs	@nextSpot		Range error?		ora	>spotHash,x		sta	>spotHash,x@nextSpot	inc	spotCount		lda	spotFlag		Looking	on desktop or window?		beq	onDesk;; --------- Next spot in window	-----------------------;		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		blt	byLargeIcon		bySmallIcon	ldy	#20		lda	[<wind],y		sec		ldy	#16		sbc	[<wind],y		sta	bottom				lda	<dRect+y1		clc		adc	#10		sta	<dRect+y1		clc		adc	#10		cmp	bottom		blt	@goLop1				stz	<dRect+y1				lda	<dRect+x1		clc		adc	#150		sta	<dRect+x1@goLop1		brl	lop1		byLargeIcon	lda	<dRect+x1		Look to	the right,		clc		adc	#106		sta	<dRect+x1		ldy	#22			; JAM 06/04/89 magic offset to wind's portrect X2		cmp	[<wind],y		; off right of window? (JAM 06/04/89 was #600)		bcc	@goLop1			lda	#leftSide+14		; Start again on left side		sta	<dRect+x1			lda	<dRect+y1		next row down.		clc		adc	#vertOffset		;changed from 31 DJB 07/26/88		sta	<dRect+y1		About 12,684 icons would cause@goLop1		brl	lop1			this to	be an infinite loop.;; --------- Next spot on desktop -----------------------;onDesk		lda	<dRect+y1		clc		adc	#desktopVertOffset	;changed from 31 DJB 07/26/88		sta	<dRect+y1		cmp	#190		bcc	@goLop1		lda	#desktopTopRow		sta	<dRect+y1		lda	<dRect+x1		sec		sbc	#106		bcc	gotit			Out of room?		sta	<dRect+x1@goLop1		brl	lop1;; --- Open spot	found ----------------------------------------------------;gotit		lda	posFlag			Use icons or position file?		beq	ok1		jsr	spotInBuff		Find a spot using a position file.		bcc	ok1		brl	nextSpot		Spot is	used in	buffer,	try again.ok1		lda	<dRect+y1		clc		adc	#10		sta	<yrat		lda	<dRect+x1		sta	<xrat		rts;; locals;spotFlag	DS.B	2bottom		dc.w	0; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Check spot in position buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   rect	= spot.;	   posFile = handle of FINDER.DATA position file.;;  OUT:	   Carry clear if icon is not in spot.;	   Carry set if	icon is	in the spot.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =spotInBuff		lda	<posFile		Save handle.		ldx	<posFile+2		jsr	derefHand		temp = (posFile).		lda	[<temp]		cmp	#2		bge	@new		brl	@old@new		ldy	#FDataItems		lda	[<temp],y		sta	items				ldy	#FDataStartAt		lda	[<temp],y		clc		adc	<temp		sta	<temp		bcc	@loop		inc	<temp+2@loop		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		bne	@byLargeIcon		@bySmallIcon	ldy	#IconPosY		;irect2 contains the rect for the name		lda	[<temp],y		;irect2 contains the rect for the icon		sta	<irect1+y2		sta	<irect2+y2		sec		sbc	#8		sta	<irect1+y1		sta	<irect2+y1		iny		iny		lda	[<temp],y		sec		sbc	#4		sta	<irect1+x1		sta	<irect2+x1		clc		adc	#145+4		sta	<irect1+x2		sta	<irect2+x2		bra	@checkForHit				@byLargeIcon	ldy	#IconPosY		lda	[<temp],y		sta	<irect1+y2		sta	<irect2+y1		adc	#8		sta	<irect2+y2		sbc	#20		sta	<irect1+y1		iny		iny		lda	[<temp],y		sta	<irect1+x1		adc	#24		sta	<irect1+x2		adc	#16		sta	<irect2+x2		sbc	#56		sta	<irect2+x1@checkForHit	jsr	RectHit2		tax		bne	hit		dec	items		beq	noHit				lda	[<temp]		sec				;add one more to skip beyond		adc	<temp			;the end of the current record		sta	<temp		bcc	@loop		inc	<temp+2			bra	@loop;; look through an old Finder.Data file;	@old		ldy	#16			Offset to first	icon data part.lop100		lda	[<temp],y		beq	noHit			No more	icons to check?		phy		iny		iny		lda	[<temp],y		sta	<irect1+y2		sta	<irect2+y1		adc	#8		sta	<irect2+y2		sbc	#20		sta	<irect1+y1		iny		iny		lda	[<temp],y		sta	<irect1+x1		adc	#24		sta	<irect1+x2		adc	#16		sta	<irect2+x2		sbc	#56		sta	<irect2+x1		jsr	RectHit2		ply		tax		bne	hit		tya		clc		adc	#22		tay		bra	lop100;; locals;items		dc.w	0			;number of items in finder data; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   rect	= spot.;	   ic =	icon to	check if in spot.;;  OUT:	   Carry clear if icon is not in spot.;	   Carry set if	icon is	in the spot.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =findspot		jsr	checkRectHit		bne	hitnoHit		clc				This icon isn't in 'rect', try another		rts				icon.hit		sec				There's an icon here, try another spot.		rts; = = =	= = = =	= = = =	= = = =	= = =;	   Clear hash table.; = = =	= = = =	= = = =	= = = =	= = =;;  OUT:	   spotHashOn =	TRUE for hashing on.;; = = =	= = = =	= = = =	= = = =	= = =		EXPORT	startHashstartHash		ldx	#198		lda	<zero@loop		sta	>spotHash,x		dex		dex		bpl	@loop				stx	spotHashOn		Turn spot hash on.		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Compute index into hash table.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   spotCount = spot number.;;  OUT:	   Carry set if	spotCount is out of range.;	   a = mask.;	   y = index to	mask.;	   x = index to	byte in	hash table.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =getHashIndex		lda	spotCount		lsr	a		lsr	a		lsr	a		tax				Index to hash byte.		cpx	#200		bcs	exit300		lda	spotCount		and	#$0007		asl	a		tay		lda	spotMasks,y		Mask to	hash bit.		clc				spotCount is in	range.exit300		rtsspotMasks	DC.W	$0080,$0040,$0020,$0010,$0008,$0004,$0002,$0001		ENDP;=========================================================;	   Change icon's state (for tax reasons).;=========================================================;;   IN:	   ic =	pointer	to locked ICONOBJ.;;=========================================================markOpen	PROC	EXPORT		lda	#ICOPENED		Set 'opened' bit.		bra	set		EXPORT	markOffLinemarkOffLine       		lda	#ICOFFLINEset		ldy	#icFlag			Set bit	in icon's flag.		tax		and	[<ic],y			Already	set?		bne	exit2		txa		ora	[<ic],y		bra	exit		EXPORT	markOnLinemarkOnLine		lda	#_ICOFFLINE		bra	clear		EXPORT	markClosedmarkClosed		lda	#_ICOPENED		Clear 'opened' bit.clear		ldy	#icFlag			Clear bit in icon's flag.		tax		eor	#$FFFF			Already	clear?		and	[<ic],y		beq	exit2		txa		and	[<ic],yexit		sta	[<ic],y;; redraw the icon in its new state (close, open, whatever);		EXPORT	drawIconStatedrawIconState			pei	<curWind+2		Save current window plane.		pei	<curWind		pei	<windBlk+2		Save.		pei	<windBlk		pei	<wind+2		pei	<wind		ldy	#icMom			Set draw plane to icon's.		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2		jsr	getwRefCon		windBlk	= curWind's info block.		jsr	startDraw		jsr	drawIcon2		Draw the icon in its new state.		jsr	endDraw		pla		sta	<wind		pla		sta	<wind+2		pla		sta	<windBlk		pla		sta	<windBlk+2		pla		sta	<curWind		pla		sta	<curWind+2exit2		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Mark	all icons in every window;	   that	came from an offline icon;	   as off line.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =; This can be called while in a	walkOfLife loop.;;   IN:	   ic =	icon that is off line.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	allOffLineallOffLine     		lda	#markOffLine		bra	store1; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Mark	all icons in every window;	   that	came from an on	line icon;	   as on line.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =; This can be called while in a	walkOfLife loop.;;   IN:	   ic =	icon that is on	line.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	allOnLineallOnLine    		lda	#markOnLinestore1		sta	function		pei	<curWind+2		pei	<curWind		pei	<direction		Save walkOfLife	stuff.		lda	toCall+1		pha		pei	<icHand+2		pei	<icHand		jsr	makeIcRoot		C1_PathName = disk icon's pathname.		lda	#DirWindID		Directory windows only.		ldx	#ckParents		Perform	operation on all windows that		jsr	walkWindow		from the disk that changed states.		pla				Restore	walkOfLife stuff.		sta	<icHand			Icon that's being changed.		pla		sta	<icHand+2		lda	function		Perform	operation on all extended icons		jsr	walkExt			that came from disk.		pla		sta	toCall+1		pla		sta	<direction		pla		sta	<curWind		pla		sta	<curWind+2		brl	windRefCon		windBlk	= window's info block.function	DS.B	2; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Make	all windows that came;	   from	a disk icon the	same state;	   as the disk icon.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   C1_PathName = disk's volume name (length byte, separator, name).;	   wind	= window to check.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=ckParents	name		jsr	matchRootName		bcc	exit1			Did the	window come from pathname?		lda	function		the window.		jsr	walkback2exit1		clc				Continue flag.		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Match window's root name.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   C1_PathName = disk's volume name (length word, separator, name).;;  OUT:	   Carry set if	window came from volume	name in	pathname.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	matchRootNamematchRootName	name		jsr	windRefCon		windBlk	= window's info block.		sta	<icHand			Save handle of first icon in window.		stx	<icHand+2; --- Match disk's name to start of window's name ------------------------		ldy	#windPath		lda	[<windBlk],y		Get length of window's pathname		cmp	C1_PathName		Compare	to length of disk name.		bcc	sorry			Disk name can't be longer than window's.		lda	C1_PathName		Number of characters to	check.		sta	chars				ldx	<zero		inyloop1		iny		lda	[<windBlk],y		and	#$00FF		cmp	#'a'		bcc	@1		cmp	#'z'+1			; is it a lower-case letter?		bcs	@1		sec		sbc	#$20			; yes - so convert it to upper case	@1		sta	<temp		lda	C1_PathName+2,x		and	#$00FF		cmp	#'a'		bcc	@2		cmp	#'z'+1			; is it a lower-case letter?		bcs	@2		sec		sbc	#$20			; yes - so convert it to upper case	@2		cmp	<temp		bne	sorry		inx		dec	chars		bne	loop1		iny				OK if next character is	separator.		lda	[<windBlk],y		and	#$00FF		cmp	#SEPARATOR		;GS/OS separator character		beq	ok1		ldy	#windPath		If next	character isn't separator		lda	[<windBlk],y		then the lengths must match.		cmp	C1_PathName		bne	sorry			If not,	no match. ok1		sec				Match found flag.		bra	done1sorry		clcdone1		rts;; locals;chars		dc.w	0		ENDP;================================================;	   Save	contents of pathname,;	   C1_TempPath and lastName.;================================================;;  OUT:	   tempSaved = handle of saved block.; ;================================================		EXPORT	saveTempsaveTemp	PROC		lda	#endSaveBlk-startSaveBlk 	;Numberof bytes to save.		jsr	allocate		sta	tempSaved		stx	tempSaved+2  		pea	startSaveBlk>>16	  	;Source = C1_TempPath.		pea	startSaveBlk		jsr	pushHandle		  	;Destination = saved handle.		pei <zero		pea	endSaveBlk-startSaveBlk	  	;Number of bytes to save.		_PtrtoHand		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Restore contents of pathname,;	   C1_TempPath, lastName.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   tempSaved = handle to saved block.;;  OUT:	   Block restored.;	   tempSaved = freed.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	restoreTemprestoreTemp       ; --- Restore C1_TempPath -----------------------------------------------------		lda	tempSaved+1		Is there a saved handle?		beq	exit100		jsr	pushHandle		Source = saved handle.		pea	startSaveBlk>>16	Destination = C1_TempPath.		pea	startSaveBlk		pei <zero		pea	endSaveBlk-startSaveBlk	Number of bytes	to save.		_HandtoPtr			Move saved data	into C1_TempPath.;;; --- Free handle used for save	---------------------------------------------;		jsr	pushHandle		jsl DisposeHandleGlue		stz	tempSaved+1		Mark handle as gone.exit100		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Push	save handle on stack.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;  OUT:	   y = unchanged.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =pushHandle		plx				Get return address.		lda	tempSaved+2		Push save handle on stack.		pha		lda	tempSaved		pha		phx				Put return address back,		rts				and exit.		ENDP;=======================================================;	   Save	the pathname of	every open;	   window that came from disk icon.;=======================================================;;   IN:	   ic =	locked disk icon record.;;  OUT:	   FINDER.ROOT file created and	saved.;;  Format of FINDER.ROOT file:;;	   WORD	  ID number.;	   BLOCK  Array	of data	types:;		     WORD  Opcode: 0 - no more opcodes.;				   1 - open window's data follows (obsolete);				   2 - extended icon data follows (obsolete);				   3 - open window's data follows:;;					   WSTR	pathname ('*' for volume name).; ;				   4 - extended	icon data follows:; ;					   WORD	icFlag;					   WORD	icy ;					   WORD	icx ;					   WORD	icOldPosY ;					   WORD	icOldPosX;					   WSTR	icon's pathname ('*' for vol).;;=======================================================writeAllRoots	PROC	EXPORT			;added 06/20/88 DJB		lda	<deskport		;switch to desktop.		sta	<curWind		lda	<deskport+2		sta	<curWind+2		lda	#saveRoot		jsr	walkBack		rts		;-----------------------------------------------saveRoot		ldy	#icFlag			;the disk must be online.		lda	[<ic],y		and	#icOffline		bne	exitSave		ldy	#icFlag			;see if it's write protected		lda	[<ic],y			;if so, we'll skip trying to write		and	#icLocked				bne	exitSave				ldy	#icDevInfo		lda	[<ic],y			;look at the 'write allowed' bit		and	#$0040		beq 	exitSave				ldy	#icFType		;only disk icons.		lda	[<ic],y		cmp	#TypeHard		beq	saveIt		cmp	#TypeHardPart		beq	saveIt		cmp	#TypeSCSI		beq	saveIt		cmp	#TypeSCSIPart		beq	saveIt		cmp	#TypeFloppy		beq	saveIt		cmp	#Type3_5		beq	saveIt		cmp	#TypeRAM		bne	exitSavesaveIt		jsr	writeRoot		;write FINDER.ROOT file.exitSave		clc		rts;=======================================================		EXPORT	writeRootwriteRoot		jsr	ckDataWrite		Should data files be saved?		bne	exit; --- Allocate a buffer	for pathnames ---------------------------------------		lda	#2000			Buffer large enough for	about 32 windows.		ldx	#$4000			Allocated the buffer as	locked.		jsr	allocate2		Allocate a buffer.		sta	<posFile		Save handle.		stx	<posFile+2		bcc	ok2exit		rtsok2		jsr	derefHand		temp = (posFile).		sta	<rootBuffer		rootBuffer = temp.		stx	<rootBuffer+2		sta	write_buff		stx	write_buff+2		lda	#RootVer		Store my ID number.		sta	[<rootBuffer] 		lda	#2			Index to next free byte.		sta	<rootOffset; --- Save data	about all extended icons belonging to disk ---------------		lda	#storeExt		Routine	to store extended info.		jsr	walkExt; --- Save pathnames of	all windows that belong	to disk	icon ------------------		lda	#DirWindID		Directory windows only.		jsr	getFrontWind		Start with front most window.		bcs	done1			Are there any windows at all?		beq	next1			Front window not a directory?lop1		pei	<wind+2			Save this window pointer.		pei	<wind		lda	<wind			Pass pointer to	window to check.		ldx	<wind+2		jsr	findRootIc		Check if the window came the trashed icon		pla		sta	<wind		sta	<TaskData		pla		sta	<wind+2		sta	<TaskData+2next1		php				Save 'window from icon'	flag.		jsr	getNextWind		'A' will equal window's ID.		plp				Restore	'window from icon' flag.		pha				Save window's ID.		bcc	skipClose; ----- Save window's pathname:		pei	<wind+2			Save pointer to	next window.		pei	<wind		pei	<icHand+2		Save icon's handle.		pei	<icHand		lda	<TaskData		Get window's info block.		ldx	<TaskData+2		jsr	getwRefCon2		jsr	getWindPath		C1_PathName = window's pathname.		ldy	<rootOffset		Index to next avialable	byte.		lda	#3			Open window data follows.		sta	[<rootBuffer],y		iny		iny		jsr	putPath			Move pathname into root	buffer.		pla				Restore	handle of icon I'm checking.		sta	<icHand		pla		sta	<icHand+2		pla				Restore	pointer	to next	window.		sta	<wind		pla		sta	<wind+2skipClose		pla				Get next window's ID.		bne	lop1			Any more windows?; --- Save the pathname	list to	the icon's root directory -----------------done1		lda	<zero		ldy	<rootOffset		Pass length of pathname	buffer.		cpy	#2		beq	store1			Were there any windows open?		sta	[<rootBuffer],y		Mark end.		iny		iny		tyastore1		sta	write_len		stz	write_len+2		jsr	setic			ic = (icHand)		jsr	makeIcRoot		C1_PathName = separator + icName.		jsr	addRootName		C1_PathName = C1_PathName + :FINDER.ROOT		bcs	error101		Pathname error?		lda	#DATAFTYPE		Set create file	type to	Finder data file.		sta	file_type		Just in	case data file is created.		lda	#$0004			; set invisible bit (DJB - 12/17/88)		tsb	create_access		inc	NoDOSerr		; Don't handle DOS errors		jsr	doWrite		dec	NoDOSerr		lda	#$0004			; clear invisible bit (DJB - 12/17/88)		trb	create_accesserror101	pei	<posFile+2		pei	<posFile		jsl DisposeHandleGlueexit1		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Store extended icon info in root buffer. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   ic =	extended icon that came	from disk being	saved.;	   rootBuffer =	pointer	to root	buffer.;	   rootOffset =	index into root	buffer of next free byte. ;;  OUT:	   C1_PathName = same as in.;	   rootOffset =	incremented to next free byte.;	   Extended icon data record placed in root buffer:;;		 WORD  Opcode -	4.;		 WORD  icFlag;		 WORD  icy ;		 WORD  icx ;		 WORD  icOldPosY ;		 WORD  icOldPosX;		 WSTR  icon's pathname.;;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =storeExt				ldx	#10			Index to field indexes.		ldy	<rootOffset		Next free space.		lda	#4			Extended icon data flag.		bra	enter120lop120		phy		ldy	icIndexes,x		lda	[<ic],y		cpy	#icFlag		bne	ok120		and	#ICBACKCLR+ICFORECLRok120		plyenter120	sta	[<rootBuffer],y		iny		iny		dex		dex		bpl	lop120		phy				Save offset.		jsr	clonePath		C1_TempPath = C1_PathName (save).		jsr	buildPath		C1_PathName = pathname to ic.				ply		bcs	error102		Pathname error?		jsr	putPath			Move pathname into root	buffer.error102	jsr	temp2Path		C1_PathName = C1_TempPath (restore). 		clc		rtsicIndexes	DC.W	icOldPosX,icOldPosY,icx,icy,icFlag; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Put pathname	into root buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   y = index of	where to put name in root buffer.;	   rootBuffer =	pointer	to root	buffer.;	   C1_PathName = pathname to store.;;  OUT:	   Name	stored is pathname where first name is replaced	by '*';	   rootOffset =	index to next free byte.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =putPath		phy				;save index to length		iny				;space for length (word)		iny		lda	#'*'			;store character that means 'current vol'		sta	[<rootBuffer],y		iny		ldx	C1_PathName		inx		inx		stz	C1_PathName,x		;mark end of string		sep	#$20		LONGA	OFF		ldx	#2			;skip over first separator char@skip		inx		lda	C1_PathName,x		cmp	#SEPARATOR		;GS/OS separator character		bne	@skip				cpx	C1_PathName		beq	@loop		bcs	@next			;path is just root		@loop		lda	C1_PathName,x		;now copy icon's pathname into root buffer		beq	@next		sta	[<rootBuffer],y		inx		iny		bra	@loop@next		rep	#$20		LONGA	ON				sty	<rootOffset		;update next free byte		dey		tya		sec		sbc	1,s			;compute length		ply				;index to start of string			dec	a			sta	[<rootBuffer],y		;set pathname's length		rts		ENDP;================================================; This will create a Finder.Def file if any of the; the defaults (preferences, pattern) have changed.; added 06/20/88 DJB;================================================writeDef	PROC	EXPORT		lda	defaultChg		;have the preferences changed?		beq	exit			;if not, no reason to save		lda	#DEF_SIZE		sta	write_len		stz	write_len+2				lda	#prefer		sta	write_buff		lda	#prefer>>16		sta	write_buff+2		PushLong #defaultName		PushLong #C1_PathName		jsl	WStringCopy				lda	#DATAFTYPE		Set create file	type to	Finder data file.		sta	file_type		Just in	case data file is created.		lda	#$0004			; set invisible bit (DJB - 12/17/88)		tsb	create_access		inc	NoDOSerr		;don't handle DOS errors		jsr	doWrite			;write finder.def file		dec	NoDOSerr		lda	#$0004			; clr invisible bit (DJB - 12/17/88)		trb	create_accessexit		rts		ENDP;==================================================;	   Compute pointer to icon's name.;==================================================;;   IN:	   ic =	pointer	to ICONOBJ.;;  OUT:	   temp	= pointer to ICONOBJ->icName field.;	   a = temp;	   x = temp+2;;==================================================geticNamePtr	PROC	EXPORT		lda	OpenFlag		Special	global flag.		beq	ok1;; --- Special --- Name is the last name	in a pathname in 'pathname' --------;		jsr	findLastName		Compute	index to last name.		lda	#lastName		ldx	#lastName>>16		bra	store;;; --- Get name from icon's name --------------------------------------------;ok1		jsr	geticNamePtr2store		sta	<temp		stx	<temp+2		rts;;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Compute pointer to icName field in ICONOBJ.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   ic =	pointer	to ICONOBJ.;;  OUT:	   a = low word	pointer	to ICONOBJ's icName field.;	   x = high word pointer to ICONOBJ's icName field.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	geticNamePtr2geticNamePtr2		ldx	<ic+2		lda	<ic		clc		adc	#icName		bcc	exit100		inxexit100		rts		ENDP;===================================================;	   Append finder data filename;	   to pathname.;===================================================;;   IN:	   C1_PathName = pathname to apend to.;;  OUT:	   Carry set if	pathname error.;	   C1_PathName = C1_PathName + :FINDER.DATA;;===================================================addDataName	PROC	EXPORT			IMPORT	DataName		IMPORT	RootName		IMPORT	LongPathAddName;; AddDataName must be able to work when the folder name is close to maxPathLen,; so call the new LongPathAddName routine for it instead of PathAddName.; This allows finder.data to be read and written when you open too many windows.;						lda	#DataName		; lo-word		ldx	#DataName>>16		; hi-word		phx		pha		PushLong #C1_PathName		jsl	LongPathAddName		bcc	@exit		brl	lenError		; report length error@exit		rts				EXPORT	addRootNameaddRootName  	lda	#RootName		;lo-word		ldx	#RootName>>16		;hi-word; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Add name to pathname. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=; ;   IN:	   a+x = pointer to name to add	to pathname.;;  OUT:	   Carry set if	pathname error.;	   C1_PathName = C1_PathName + separator + given name.; ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	addNameaddName	        phx		pha		PushLong #C1_PathName		jsl	PathAddName		bcc	exit		brl	lenError		;report length errorexit		rts		ENDP;===========================================;	   Move	window's pathname;	   into	'C1_PathName'.;===========================================;;   IN:	   windBlk = window's info block.;;  OUT:	   C1_PathName = window's pathname.;;===========================================getWindPath	PROC	EXPORT		lda	#windPath		clc		adc	<windBlk		ldx	<windBlk+2		bcc	@nr		inx@nr		phx		pha		pushlong #c1_pathname		jsl	WStringCopy		rts		ENDP;===================================================;	   Move	'C1_PathName' into icon template.;===================================================path2ticon	PROC	EXPORT		lda	C1_PathName		cmp	#MaxPathLen-1		;Length too big?		bcs	@exit		pushlong #c1_pathname		pushlong #ticonobj+icOwner		jsl	WStringCopy				clc@exit		rts				ENDP;================================================;	   Get last name from pathname.;================================================;;   IN:	   C1_PathName = pathname to parse.;;  OUT:	   C1_PathName = not changed. ;	   lastName = last name	in pathname, length byte first,	zero at	end,;		      no separators. ;;================================================findLastName	PROC	EXPORT		sep	#$20		LONGA	OFF				ldx	<zero		ldy	C1_PathNameskip		lda	C1_PathName+1,y		cmp	#SEPARATOR		;start of last name ?		beq	loop		dey		bra	skiploop		lda	C1_PathName+2,y		sta	lastName+1,x		inx		iny		cpy	C1_PathName		;end of pathname ?		bcc	loop		txa		sta	lastName		;set length byte		stz	lastName+1,x		;set end of string		rep	#$20		LONGA	ON				rts				ENDP		; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Get root name from pathname. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=; ;   IN:	   C1_PathName = pathname to parse.;;  OUT:	   C1_PathName = not changed. ;	   lastName = first name in pathname, length byte first, zero at end,;		      no separators. ;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=getRootName	PROC	EXPORT  		sep	#$20		LONGA	OFF				ldx	#1loop		lda	C1_PathName+2,x		cmp	#SEPARATOR		;end of root name ?		beq	done		sta	lastName,x		inx		cpx	C1_PathName		;end of pathname ?		bcc	loopdone		dex		txa		sta	lastName		;set length byte		stz	lastName+1,x		;set end of string		rep	#$20		LONGA	ON				rts		ENDP;==============================================;	   Make	a root name from icon.;==============================================;; IN:	ic = pointer to ICONOBJ;; OUT:	C1_PathName = separator + icon name;;==============================================makeIcRoot	PROC	EXPORT		ldy	#icName		lda	[<ic],y		and	#$00FF		inc	a		sta	C1_PathName		;set length word		lda	#SEPARATOR		;GS/OS separator character		sta	C1_PathName+2		;add it in		iny		ldx	<zeroloop						;copy icon's name		lda	[<ic],y		sta	C1_PathName+3,x		iny		iny		inx		inx		cpx	C1_PathName		bcc	loop		rts				ENDP;===============================================;	   Build pathname for ICONOBJ.;===============================================;;   IN:	   icHand = handle of ICONOBJ (extended	icon is	OK, desktop icon OK).;	   windBlk = pointer to	ICONOBJ's window information block.;;  OUT:	   Carry set if	pathname error.;	   C1_PathName = full pathname to, and including, 'ic'.;;===============================================buildPath3	PROC	EXPORT		jsr	lockic		ldy	#icMom+2		Get info block of icon's mom window.		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	getwRefCon2		windBlk	= icon's mom window info block.		EXPORT	buildPathbuildPath	        		lda	OpenFlag		Special	flag?		clc				OK flag, just in case		beq	ok222		brl	exit			Already	in pathname if special flag set.ok222		pei	<temp+2			Save.		pei	<temp		jsr	geticNamePtr		temp = pointer to ic's name		lda	<temp		sta	NamePtr		lda	<temp+2		sta	NamePtr+2				pla				Restore.		sta	<temp		pla		sta	<temp+2		bra	enter1		;===============================================;;   IN:	   lastName = icon's name.; ;===============================================		EXPORT	buildPath2buildPath2	        		lda	#lastName		sta	NamePtr		lda	#lastName>>16		sta	NamePtr+2; --- Move ic's window's pathname into 'C1_PathName' -------------------enter1		stz	C1_PathName		In case	there is no window.		ldy	#icFlag			Is this	an extended icon?		lda	[<ic],y		and	#ICEXTENDED		beq	ok1		jsr	getExtName		C1_PathName = icon's icOwner field.		bcs	exit			Pathname error?		bra	skip1ok1		lda	<windBlk+2		Is the ic on the desktop?		bne	ok2		tdc		clc		adc	#deskic		cmp	<windBlk		beq	skip1			Must be	volume ic if on	desktop.ok2		lda	#windPath		clc		adc	<windBlk		ldx	<windBlk+2		bcc	@nr		inx@nr		phx		pha		pushlong #c1_pathname		jsl	WStringCopy		; --- Add ic's name -----------------------------------------------skip1		PushLong NamePtr		PushLong #C1_FileName		jsl	PtoWString				PushLong #C1_FileName		PushLong #C1_PathName		jsl	PathAddName		bcc	ok3		jsr	lenError		Report length error.		bra	exitok3		clc				OK flag.exit		rtsNamePtr		DC.L	0			;points to file name		ENDP;============================================================;	   Move	icon's icOwner field into 'C1_PathName'.;============================================================;;   IN:	   ic =	pointer	to extended ICONOBJ.;;  OUT:	   Carry set if	pathname too long.;	   C1_PathName = ic's icOwner field.;;============================================================getExtName	PROC	EXPORT		ldy	#icOwner		lda	[<ic],y			;Check for too long a name		cmp	#MaxPathLen-1		bcc	@ok		brl	lenError@ok			lda	<ic		clc		adc	#icOwner		ldx	<ic+2		bcc	@nr		inx@nr		phx		pha		pushlong #c1_pathname		jsl	WStringCopy				clc				;OK flag.		rts				ENDP;=======================================================;	   Clone 'C1_PathName' into 'C1_TempPath';=======================================================;;   IN:	   C1_PathName = pathname to clone.;;  OUT:	   C1_TempPath = C1_PathName.;;=======================================================clonePath	PROC	EXPORT				IMPORT	WStringCopy				PushLong #C1_PathName		PushLong #C1_TempPath		jsl	WStringCopy				clc		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Clone 'C1_TempPath' into 'C1_PathName'.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   C1_TempPath = name to move into	'C1_PathName'.;;  OUT:	   C1_PathName = C1_TempPath.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	temp2pathtemp2path	        		IMPORT	WStringCopy				PushLong #C1_TempPath		PushLong #C1_PathName		jsl	WStringCopy				clc		rts				ENDP;===============================================================;	   Close every window that came	from an	icon.;===============================================================;;   IN:	   icHand = Handle of icon being closed.;; Some of the variables	trashed:;;	   C1_PathName;	   wind;	   windBlk;	   TaskData;;===============================================================closeKids	PROC 	EXPORT		jsr	buildPath3		C1_PathName = icon's pathname.		bcs	exit			Pathname error?		lda	#DirWindID		Directory windows only.		jsr	getFrontWind		bcs	exit			Any windows at all?		beq	next1			Front window not a directory?lop1		pei	<wind+2			Save this window pointer.		pei	<wind		jsr	ckRoots			See if window came from	icon.		pla		sta	<wind		sta	<TaskData		Save possible window to	close.		pla		sta	<wind+2		sta	<TaskData+2next1		php				;Save 'close window' flag.		jsr	getNextWind		;Get the next window in the list						;cause I might close one and break						;the list.		plp				;Restore 'close window' flag.		pha				;Save next window's ID.		bcc	skip1			;Should window be closed?		pei	<wind+2		pei	<wind		pei	<icHand+2		Save icon's handle.		pei	<icHand		jsr	doClose2		Close the window in TaskData.		pla		sta	<icHand		pla		sta	<icHand+2		jsr	buildPath3		C1_PathName = icon's pathname.		pla		sta	<wind		pla		sta	<wind+2skip1		pla				Get the	next window's ID.		bne	lop1			Is there another window?exit		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Check if window's pathname;	   came	from 'C1_PathName'.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   wind	= window to check.;	   C1_PathName = pathname to check.;;  OUT:	   Carry clear if window did not come from 'C1_PathName'.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	ckRootsckRoots	    	NAME    		lda	<wind			Pass window.		ldx	<wind+2		jsr	getwRefCon2		windBlk	= info block.				ldy	#windPath		Window's path must be equal to or greater		lda	[<windBlk],y		in length than the name	to check.		cmp	C1_PathName		bcc	noKidOmine		If window name is shorter, then	no match.		iny		iny		ldx	<zero		lop100		lda	[<windBlk],y		and	#$00FF		cmp	#'a'		bcc	@1		cmp	#'z'+1			; is it a lower-case letter?		bcs	@1		sec		sbc	#$20			; yes - so convert it to upper case	@1		sta	<work		lda	C1_PathName+2,x		and	#$00FF		cmp	#'a'		bcc	@2		cmp	#'z'+1			; is it a lower-case letter?		bcs	@2		sec		sbc	#$20			; yes - so convert it to upper case	@2		cmp	<work		bne	noKidOmine		iny		inx		cpx	C1_PathName		All checked?		bcc	lop100				lda	[<windBlk],y		and	#$00FF		cmp	#SEPARATOR		;GS/OS separator character		sec		beq	ok100				ldy	#windPath		lda	[<windBlk],y		cmp	C1_PathName		sec				Set 'matched' flag, just in case.		beq	ok100noKidOmine	clc				Return 'no match' flag.ok100		rts		ENDP; ZoomDiskToTrash -- zoom the current icon into the trashcan;; IN: ic is the icon to zoom into the trashcan;.....................................................................ZoomDiskToTrash	PROC	EXPORT		import	getSmallRect		import	ZoomRect		jsr	getSmallRect				ldx	#6@rLoop		lda	smallRect,x		sta	bigRect,x		dex		dex		bpl	@rLoop		pushZLong <icHand		pushZLong <ic				pha		pha		pushZLong <TrashWind		_GetWRefCon		pulllong <ptr				ldy	#WindIc			;windIC is the icon which opened into this		lda	[<ptr],y		;window -- the trashcan icon		sta	<icHand		iny		iny		lda	[<ptr],y		sta	icHand+2				jsr	lockIc				jsr	getSmallRect		jsr	unlockIc		pulllong <ic		pulllong <icHand				lda	<zero			;zoom down		jsr	ZoomRect		rts		ENDP		;========================================;	   Disk	put in trash.;========================================;; Might	be called from walkOfLife walking backwards.; Called for each disk on shutdown.;;   IN:	   ic =	locked ICONOBJ of disk icon moved into trash.;;  OUT:	   Save	the pathnames of all open windows from the disk	in root	file.;	   Close all open windows from the disk.;	   Eject disk.;	   ic =	removed	from list, deallocated and erased from screen.;;========================================trashDisk	PROC	EXPORT		IMPORT	EjectDisk		import	SelectionIsChanging		import	CheckOpenFiles		jsl	SelectionIsChanging	;14-Jul-91 DAL;; --- Save the pathname	of every open directory	on disk	----------------------;		jsr	writeRoot		Save the pathnames of all open windows.;; only unmount the disk if it didn't have any open files on it;		lda	<ic		clc		adc	#icName		tax		lda	<ic+2		adc	<zero		jsl	CheckOpenFiles		bcc	@noOpenFiles				ldy	#icFtype		;DO NOT eject servers with open files!!		lda	[<ic],y		cmp	#typeServer		beq	@offline		cmp	#typeHardPart		;DO NOT eject hard disk partitions with open files!!		beq	@offline				ldy	#icDevNum		;Eject the disk.		lda	[<ic],y		beq	@offline		;Is the disk offline already?						;If offline, no need to eject it.		pha		jsl	EjectDisk@offline	rts@noOpenFiles	;; --- Remove any extended icons	that may have come from	disk ------------;		lda	#wipeIcon		Routine	to erase and free icons.		jsr	walkExt		;; --- Close every window that came from	disk or	its kids ---------------------;		jsr	closeKids; --- Eject the	disk ---------------------------------------------------------		jsr	lockic			;ic = (icHand) locked.		ldy	#icDevNum		;Eject the disk.		lda	[<ic],y		beq	skip1			;Is the disk offline already?						;If offline, no need to eject it.		pha		jsl	EjectDiskskip1		inc	onlyDisk		;Set 'remove only disks' flag.		jsr	ZoomDiskToTrash		; --- Remove the disk icon ----------------------------------------------; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Take	ICONOBJ	out of icon list and free. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   ic =	pointer	to icon	to remove.;	   onlyDisk = TRUE if only 3.5' and 5.25' disk should be cut. ;;  OUT:	   onlyDisk = zero.; ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =		EXPORT	cutNfreecutNfree	        		IMPORT	EjectNonRemovable		;; Fix both the forward and backwards links to the next and previous icon, so that if we happen to be; walking either forwards or backwards in WalkOfLife.;		ldy	#icNext+2		Fix up walkOfLife cause	I'm going		lda	[<ic],y			to cut this icon out of	the list.		sta	dummyIc+icNext+2		dey		dey		lda	[<ic],y		sta	dummyIc+icNext		ldy	#icLast+2		Fix up walkOfLife cause	I'm going		lda	[<ic],y			to cut this icon out of	the list.		sta	dummyIc+icLast+2		dey		dey		lda	[<ic],y		sta	dummyIc+icLast		jsr	killInfoWind		Close icon's info window, if any.		ldy	#icMom			Plane that icon	will be	cut from.		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2		lda	onlyDisk		Should only disk icons be cut?		beq	doit200		stz	onlyDisk		Reset flag.		ldx	EjectNonRemovable		beq	@noEject		ldy	#icFtype		;see if it's a hard drive partition		lda	[<ic],y		cmp	#TypeHardPart		beq	doit200@noEject	ldy	#icDevInfo		;12/4/90, andy, remove the icon		lda	[<ic],y			;only if it's ejectable bit is		and	#$0004			;set		beq	exit		doit200		pei	<icHand+2		;Save icon's handle,		pei	<icHand			;and passed to DisposeHandle.		jsr	cutIcon			;Remove icon from the icon list.		jsl DisposeHandleGlue		;Free ICONOBJ record (alreay on stack).skip200		lda	#dummyHand		;Reset the saved handle used by findSelect.		sta	saveHand		sta	<icHand		ldx	#dummyHand>>16		stx	saveHand+2		stx	<icHand+2exit		rtsdummyHand	DC.L	dummyIc		DC.W	0dummyic		DC.L	0			icNext (not used).		DC.L	0			icLast (fixed up).;; Below is a really bad hack to preserve the contents of c1_pathname around the call; to closekids.  WipeIcon can be called by 'WalkExt' which walsk the extended icons; on the desktop, comparing them to c1_pathname.  So, once WalkExt calls wipeIcon,; c1_pathname has to be preserved.  Here, since CloseKids can close a window which; destroys c1_temppath as well as c1_pathname, c1_pathname is copied to c1_path which; is only used by the file copying routines, not any time wipeIcon is called. -- andy;		EXPORT	wipeIconwipeIcon	name        				IMPORT	C1_Path				pushlong #c1_pathname		;c1_pathname copied to c1_path		pushlong #c1_path		;c1_path is only used by copying routines,		jsl	WStringCopy		;not by anyone else during the close process				pushZLong <wind		pushZLong <windBlk		jsr	closeKids		pulllong <windBlk		pulllong <wind		jsr	lockIc			;deref ic again, sigh		pushlong #c1_path		pushlong #c1_pathname		jsl	WStringCopy				jsr	addIconRgn		Add the	icon to	the update region.		jsr	cutNfree		Delete the icon	from the list. 		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Walk	desktop	icons for extended icons. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =; ;   IN:	   a = address of function to call for every extended icon that;	       came from the icon pointed to by	icHand.;	   icHand = owner of extended icons.;;  OUT:	   C1_PathName = pathname of owner icon.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	walkExtwalkExt        		pha				Save function address.		jsr	buildPath3		C1_PathName = ic's full patname.		pla				Restore.		bcs	exit			Pathname error?; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;   IN:	   C1_PathName = name to match.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	walkExt2walkExt2        		sta	extFunc+1		Store address of function to call.		pei	<icHand+2		Save icon to match.		pei	<icHand		pei	<curWind+2		pei	<curWind		pei	<direction		lda	toCall+1		pha; --- Check icons on desktop ---------------------------------------------		lda	<deskport		Switch to desktop.		sta	<curWind		lda	<deskport+2		sta	<curWind+2		lda	#ckForExt		jsr	walkBack; --- Check icons in Trash  ---------------------------------------------		lda	<TrashWind		Handle of first	icon in	Trash window.		sta	<curWind		lda	<TrashWind+2		sta	<curWind+2		lda	#ckForExt		jsr	walkBack		pla		sta	toCall+1		pla		sta	<direction		pla		sta	<curWind		pla		sta	<curWind+2		pla		sta	<icHand		pla		sta	<icHand+2		brl	lockic; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Remove extended icons that;	   came	from trashed disk. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   C1_PathName = name to check.;	   extFunc+1 = address to call.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	ckForExtckForExt      		ldy	#icFlag			Only check extended icons.		lda	[<ic],y		and	#ICEXTENDED		beq	exit100; --- Did icon come from name in 'C1_PathName' -------------------------		ldx	<zero		ldy	#IcOwner+2lop100		lda	[<ic],y		and	#$00FF		cmp	#'a'		bcc	@2		cmp	#'z'+1			;is it a lower-case letter?		bcs	@2		sec		sbc	#$20			;yes - so convert it to upper case	@2		sta	<work			lda	C1_PathName+2,x		;C1_PathName = icon's root		and	#$00FF		cmp	#'a'		bcc	@1		cmp	#'z'+1			; is it a lower-case letter?		bcs	@1		sec		sbc	#$20			; yes - so convert it to upper case	@1		cmp	<work		bne	exit100			; not a match		iny		inx		cpx	C1_PathName		bcc	lop100		lda	[<ic],y		and	#$00FF		cmp	#SEPARATOR		;GS/OS separator character		beq	done100		ldy	#icOwner		lda	[<ic],y		cmp	C1_PathName		bne	exit100			;Was there a match?		done100		EXPORT	extFuncextFunc		jsr	$1111		lda	<icHand+1		;Is there another icon?		bne	exit100		sec		rtsexit100		clc		rts		ENDP;===============================================;	   Find	root icon of window.;===============================================;;   IN:	   a = low word	of window.;	   x = high word of window.;	   icHand = handle of icon to check if window, or its kids, came from.;;  OUT:	   Carry clear if window did not come from icHand, carry set if	it did.;;===============================================		EXPORT	findRootIcfindRootIc	PROC				IMPORT	PathGetRoot		IMPORT	GetDeviceNumber		lop1		jsr	getwRefCon2		ldy	#windIc+2		Get handle of icon that	opened into		lda	[<windBlk],y		this window.		tax		dey		dey		lda	[<windBlk],y		cmp	<icHand			Is the open icon the icon being	trashed?		bne	next1		cpx	<icHand+2		bne	next1		sec		rtsnext1		jsr	derefHand		temp = a and x dereferenced.		ldy	#icFType		Have I hit the desktop level?		lda	[<temp],y		bpl	@match		clc				bra if device or trash		rts		@match		ldy	#icMom+2		Go back	another	window until the desktop		lda	[<temp],y		tax		dey		dey		lda	[<temp],y				cpx	<deskPort+2		;hey bud, if we look all the way back to		bne	lop1			;the desktop, then we gotta split and say		cmp	<deskPort		;that our window didn't come from icHand,		bne	lop1			;ya dig? -- andy, 1/8/91;; if we get here it's kind of like 'oh shit, we're on the desktop and we still haven't"; found the root icon (ie, folder on the desktop, now what?)";		lda	#icOwner		clc		adc	<temp		ldx	<temp+2		bcc	@nr		inx@nr		phx		pha		pushlong #C1_Pathname		jsl	WStringCopy				pushlong #c1_devicename		pushlong #C1_PathName		jsl	PathGetRoot		pha		pushlong #c1_devicename		jsl	GetDeviceNumber		pla		sta	devNum		bcs	noMatch		lda	<icHand			;walkExt trashes icHand, and we want to		sta	<temp			;see if icHand is the same as the		lda	<icHand+2		;handle to the root icon for this		sta	<temp+2			;window...				lda	<deskport		;switch to desktop.		sta	<curWind		lda	<deskport+2		sta	<curWind+2		lda	#findDeviceIc				jsr	walkBack		lda	<icHand		cmp	<temp		bne	@noMatch		lda	<icHand+2		cmp	<temp+2		bne	@noMatch		lda	<temp		sta	<icHand		lda	<temp+2		sta	<icHand+2				sec		rts		@noMatch	lda	<temp		sta	<icHand		lda	<temp+2		sta	<icHand+2		noMatch		clc		rts;; find the device icon in 'devNum';findDeviceIc	lda	devNum		ldy	#icDevNum		cmp	[<ic],y		bne	@next				ldy	#icFType	;check filetype for device type		lda	[<ic],y		;who knows, it could be trash (defensive coding)		bpl	@next		sec		rts		@next		clc		rts;; locals;devNum		dc.w	0		;device number		ENDP;===========================================;	   Deselect all	selected;	   icon's in wind.;===========================================;;   IN:	   curWind = window to deselect.;;===========================================		EXPORT	deselectalldeselectall	PROC		IMPORT	NoRename			IMPORT	SelectionIsChanging				jsl	SelectionIsChanging				jsr	NoRename				jsr	startDraw		Switch to proper plane with proper origin.		lda	#officon		jsr	walkBack		brl	endDraw			Return the port's origin back to 0,0.		EXPORT	onIcononIcon					        		jsr	getwRefCon		Get icon window's info block.		ldy	#icFlag		lda	[<ic],y		and	#ICSELECTED		bne	exit100			Already	selected?		bra	enter100;; This entry point shouldn't be used by walk-of-life.;		EXPORT	officon2officon2	jsr	getwRefCon		Get icon window's info block.		EXPORT	officonofficon		ldy	#icFlag			Is this	icon selected?		lda	[<ic],y		and	#ICSELECTED		beq	exit100			Nothing	to do if not.enter100	lda	[<ic],y		eor	#ICSELECTED		Deselect it.		sta	[<ic],y		jsr	drawIcon2		Redraw in new state.exit100		clc				Continue flag.		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Delete all windows and extended;	   icons that came from	folder.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   ic =	pointer	to folder icon.;;  OUT:	   icHand = same as in.;	   ic =	same as	in.;	   curWind = same as in.;	   windBlk = same as in.;;	   All windows and extended icons that are descendants of icon are;	   removed from	the desktop.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;		EXPORT	killKids2killKids2	PROC	EXPORT        		lda	<icHand		sta	saveHand3		lda	<icHand+2		sta	saveHand3+2		pei	<curWind+2		pei	<curWind		lda	#dumpExtIcon1		Remove extended	icons that came	from ic.		jsr	walkExt		jsr	closeKids		Remove windows that came from ic.		pla		sta	<curWind		pla		sta	<curWind+2		lda	saveHand3		sta	<icHand		lda	saveHand3+2		sta	<icHand+2		jsr	getwRefCon		brl	lockicsaveHand3	DS.B	4; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Remove icon from face of the	earth.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   ic =	icon to	dump.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=dumpExtIcon1 		lda	<icHand			Don't delete parent icon.		cmp	saveHand3		bne	dumpExtIcon		lda	<icHand+1		cmp	saveHand3+1		beq	exit68		EXPORT	dumpExtIcondumpExtIcon	        		pei	<curWind+2		pei	<curWind		pei	<rectRgn+2		pei	<rectRgn		pei	<tempRgn+2		pei	<tempRgn		pei	<direction		lda	toCall+1		pha		ldy	#icMom			Switch to icon's window.		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2		jsr	getwRefCon		stz	<rectRgn+1		Mark as	freed, cause I saved them.		stz	<tempRgn+1		jsr	getRectRgn		Allocate rectRgn and tempRgn.		jsr	wipeIcon		Cut icon out of	icon list add to redraw.		pei	<icHand+2		Icon is	now the	next icon.		pei	<icHand		jsr	redrawList		Redraw icon's (erases icon).		pla		sta	<icHand		pla		sta	<icHand+2		pla		sta	toCall+1		pla		sta	<direction		pla		sta	<tempRgn		pla		sta	<tempRgn+2		pla		sta	<rectRgn		pla		sta	<rectRgn+2		pla		sta	<curWind		pla		sta	<curWind+2		jsr	getwRefCon		lda	<icHand+1		Is there a next	icon?		beq	exit68		jsr	lockicexit68		rts		ENDP;============================================================;	   Update disk icon's create time and date.;============================================================resetCTime	PROC	EXPORT		IMPORT	updateInfoWin				jsr	makeIcRoot		;pathname = separator + icName.		jsr	doGetFileInfo		;get destination disk's new create time.		ldy	#icCDate		;update new create time in icon.@loop		lda	|info_cdate-icCDate,y		sta	[<ic],y		iny		iny		cpy	#icCDate+8		bcc	@loop				jsr	GetVolSizes		bcs	exit				lda	fileSysID		ldy	#icFileInfo		sta	[<ic],y				ldy	#icFBytes		; update new size in icon.		lda	NumBlks			; total blocks		sta	[<ic],y		iny		iny		lda	NumBlks+2		sta	[<ic],y		ldy	#icFBlocks		; update new size in icon.		lda	NumBlks			; used blks = total blks - free blks		sec		sbc	FreeBlks		sta	[<ic],y		iny		iny		lda	NumBlks+2		sbc	FreeBlks+2		sta	[<ic],y		jsr	UpdateRootSize		exit		jsr	updateInfoWin		rts				ENDP; UpdateRootSize -- update the size of the root icon for <ic from NumBlks and FreeBlks;.....................................................................UpdateRootSizeW	PROC	EXPORT		pushZLong <handle				ldy	#windDiskIc		lda	[<windBlk],y		sta	<handle		iny		iny		lda	[<windBlk],y		sta	<handle+2		bra	UpdateSize		EXPORT	UpdateRootSizeUpdateRootSize			pushZLong <handle				ldy	#icDisk		lda	[<ic],y		sta	<handle		iny		iny		lda	[<ic],y		sta	<handle+2UpdateSize	lda	[<handle]		tax		ldy	#2		lda	[<handle],y		sta	<handle+2		stx	<handle					ldy	#icFType		;if this isn't a disk icon, we're in deep...		lda	[<handle],y		;(just some protection)		bpl	@done						lda	NumBlks			;Total number of blocks on disk,		sec		sbc	FreeBlks		;less those free,		tax				;equals number used.		lda	NumBlks+2		sbc	FreeBlks+2		ldy	#icFBlocks+2		;used blocks		sta	[<handle],y		dey		dey		txa		sta	[<handle],y				ldy	#icFBytes		;total blocks		lda	NumBlks		sta	[<handle],y		iny		iny		lda	NumBlks+2		sta	[<handle],y		@done		pulllong <handle		rts		ENDP;===============================================;	   Should data files be	saved?;===============================================;;   IN:	   SaveOffFlag = TRUE to over rule prefer and functionKey to not save.;	   functionKey = special key state from	GetNextEvent.;	   prefer = global preference for saving data files.;;  OUT:	   BNE if data file should not be saved.;;===============================================ckDataWrite	PROC	EXPORT		IMPORT	controlKeyStatus		IMPORT	IsReadOnly				ldy	#icFST		lda	[<ic],y		tay		jsl	IsReadOnly		bcc	@notReadOnly		ldx	#1		bra	ok1@notReadOnly;---- Temp Patch to keep Finder.data files off servers ---- DJB		ldy	#ICFLAG+2		lda	[<ic],y		and	#ICNETWORK>>16		tax		bne	ok1;---- Temp Patch #2 to skip offline volumes		ldy	#ICFLAG		lda	[<ic],y		and	#ICOFFLINE		tax		bne	ok1;-----------------------------------------------		ldx	SaveOffFlag		Is saving turned off by	the Finder?		bne	ok1		ldx	controlKeyStatus		Was the	secret abort key down?		lda	prefer			Is the save data file turned off?		and	#PREF_DATA		bne	ok1		txa		eor	#$1000			Flip the function key state.		tax				;(state of control key)ok1		txa				Should the data	file be	written?		rts				ENDP;========================================================;	   Set horizontal scroll mask so icons;	   won't fall on odd pixel boundaries.;========================================================;;   IN:	   wind	= pointer to window to set.;;========================================================		EXPORT	SetOrgnMaskSetOrgnMask	PROC		pea	$FFFE		pei	<wind+2		pei	<wind		_SetOriginMask		rts				ENDP;=======================================================;	   Bring a invisible window to the top.;=======================================================;;   IN:	   a = low word	pointer	of Trash or Clip Board window only.;	   x = high word pointer of Trash or Clip Board	window only.;;=======================================================		EXPORT	wind2topwind2top	PROC		IMPORT	addWindow2Menu		IMPORT	insertItemRef	*		using	equates*		using	RAM		sta	<wind			Save window pointer.		stx	<wind+2		pha				Space for result.		phx				Pass pointer to	Trash window.		pha		_GetWFrame		pla				Get window's frame flag.		and	#F_VIS			Is the window visible?		bne	selectWind		If visible, bring it to	the front.; --- Window being made	visible	---------------------------------------;		pei	<wind+2			Make the window	topmost	before making		pei	<wind			it visible so it doesn't draw twice.		_BringToFront; ------ Draw zoom box for Trash window	------------------------------		lda	<wind			Set bigRect to window's port for		cmp	<TrashWind		zoomRect call.		bne	showIt		ldx	<wind+2		cpx	<TrashWind+2		bne	showIt		jsr	getBigRect		jsr	growZoom; ------ Make the window visible ------------------------------------showIt		pei	<wind+2			Make the window	visible.		pei	<wind		_ShowWindow				pha		pha		pushZLong <wind		_GetWRefCon		pulllong wind_ref		lda	wind_ref		clc		adc	#windMenuText		sta	insertItemRef+10		lda	wind_ref+2		adc	<zero		sta	insertItemRef+12						jmp	addWindow2Menu		;add the trash to the windows menu; = = =	= = = =	= = = =	= = = =	= = =;	   Call	_SelectWindow.; = = =	= = = =	= = = =	= = = =	= = =;;   IN:	    wind = pointer to window.;; = = =	= = = =	= = = =	= = = =	= = =		EXPORT	selectWindselectWind	        		lda	<wind			Pass icon's window for select.		ldx	<wind+2; = = =	= = = =	= = = =	= = = =	= = =;	   Call	_SelectWindow.; = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   a = low word	pointer	to window.;	   x = high word pointer to window.;; = = =	= = = =	= = = =	= = = =	= = =		EXPORT	selectWind2selectWind2	        		IMPORT	PickAWindow		phx		pha				pha		pha		phx		pha		_GetWRefCon		pulllong deref				ldy	#windMenuItem		lda	[deref],y		jsr	pickAWindow				_SelectWindow		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Set smallRect to area in;	   upper left corner of	screen.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=		EXPORT	setSmallRectsetSmallRect	        		lda	#14			Set small RECT for clipboard window.		sta	smallRect+y1		sta	smallRect+x1		inc	a		sta	smallRect+y2		sta	smallRect+x2		rts		ENDP;================================================;	   Compute window's data size.;================================================;;   IN:	   wind	= window pointer.;;  OUT:	   Window's data size reset and frame redrawn if needed.;;================================================		EXPORT	newDataSize2newDataSize2	PROC*		using	equatesmaxY		equ	workmaxX		equ	maxY+2minY		equ	maxX+2minX		equ	minY+2windsView	equ	minX+2curYorg		equ	windsView+2curXorg		equ	curYorg+2		lda	<wind		ldx	<wind+2		bra	newDataSize		EXPORT	newDataSize3newDataSize3	        		lda	<curWind		ldx	<curWind+2		;================================================;;   IN:	   a+x = low+high words	of window pointer.;;  OUT:	   Window's data size reset and frame redrawn if needed.;;================================================		EXPORT	newDataSizenewDataSize	        		pei	<curWind+2		Save.		pei	<curWind		sta	<curWind		stx	<curWind+2		lda	<curWind+1		Valid window?		beq	toexit		jsr	ifDesk			Is the window the desktop?		bne	ok3toexit		brl	exit			If yes,	no need	to recompute data size.; --- Find maximum right and bottom sides from icon positions -----------------ok3		pha				Max data size must start with the size		pha				of the content region.		pei	<curWind+2		pei	<curWind		_GetContentRgn		pla		plx		jsr	derefHand		ldy	#6		lda	[<temp],y		ldy	#2		sec		sbc	[<temp],y		sta	<maxY			Height of window's content region.		ldy	#8		lda	[<temp],y		ldy	#4		sec		sbc	[<temp],y		sta	<maxX			Width of window's content region.		lda	#$7FFF		sta	<minY		sta	<minX		lda	#findMaxPos		jsr	walkOfLife; --- Bring in any icon's lost off top or left sides --------------------------		lda	<minY		cmp	#$8000		beq	justSize 		pha				Space for result.		pha		pei	<curWind+2		Pass window to change.		pei	<curWind		_GetContentOrigin		pla				Get current Y origin.		sta	<curYorg		pla				Get current X origin.		sta	<curXorg		stz	<windsView		Flag to	set data size first.		ldx	#2lop1		ldy	<zero		lda	<curYorg,x		cmp	<minY,x			Is min less than curorg?		bcc	ok5			If yes,	no adjustment needed.		lda	<minY,x			Tighten	origin up as much as possible.		bra	enter1 ok5		lda	<minY,x			Is min out of bounds?		bmi	enter1			If yes,	add amount to everything.		lda	<curYorg,x		If min in bounds, make origin zero.enter1		eor	#$FFFF		inc	a		taystore1		sty	<minY,x			Amount to add to icon positions.		tya		clc		adc	<maxY,x		sta	<maxY,x			New data size.		tya		clc		adc	<curYorg,x		sta	<curYorg,x		New origin.		bcc	next1		dec	<windsView		Flag to	set origin first. next1		dex		dex		bpl	lop1		lda	<minX			Do icon	positions need to be changed?		ora	<minY		beq	skip2 		lda	#resetIconPos		Add minY and minX to icon positions.		jsr	walkOfLife; --- Set the window's data size and origin ----------------------------------skip2		lda	<windsView		Set origin or data size	first?		bmi	ok4		jsr	setDataSize		Data size got bigger, so set data size		jsr	setOrigin		and then the origin.		bra	exitok4		jsr	setOrigin		Data size got smaller, so shrink originjustSize	jsr	setDataSize		before data size. exit		pla				Restore.		sta	<curWind		pla		sta	<curWind+2		rts; = = =	= = = =	= = = =	= = = =	= = = =;	   Set window's origin. ; = = =	= = = =	= = = =	= = = =	= = = = setOrigin	pei <zero			Don't move content region.		pei	<curXorg		Pass new origin.		pei	<curYorg		pei	<curWind+2		Pass window to change.		pei	<curWind		_SetContentOrigin2		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Set window's data size.; = = =	= = = =	= = = =	= = = =	= = = =	= = =; modified 11/08/88 (VOTE) DJB setDataSize		pha				;space for result		pha		pei	<curWind+2		;window to check		pei	<curWind		_GetDataSize;--- added DJB 11/11/88 ------------------------		lda	<curWind		;check view first, if it's view by name		sta	<wind			;then we force X data size to be zero.		lda	<curWind+2		sta	<wind+2		jsr	WindRefCon		ldy	#windView		lda	[<windBlk],y		;get current view				ply				;get current height		plx				;get current width				cmp	#viewByName		;was it view by name ?		bcc	cont200			;no		stz	<maxX			;yes, use zero to force a solid thumb		bra	ok200;-----------------------------------------------cont200		cpy	<maxY			; has the height changed?		bne	ok200		cpx	<maxX			; has the width changed?		beq	exit200			; If neither changed, then done.ok200		pei	<maxX			; pass new width		pei	<maxY			; pass new height		pei	<curWind+2		; pass window to change		pei	<curWind		_SetDataSizeexit200		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Find	maximum	icon positions.;	   Called for each icon	in a list.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   maxY	= current maximum y position.;	   maxX	= current maximum x position.;	   minY	= current minimum y position.;	   minX	= current minimum x position.;	   ic =	locked ICONOBJ.;	   windBlk = window's info block.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=findMaxPos		ldy	#windView		By icon, or text?		lda	[<windBlk],y		sta	<windsView		beq	bigIcon		dec	a		beq	smallIcon; --- View by text --------------------------------------------- 		stz	<minY		stz	<minX		lda	#640		sta	<maxX		ldy	#icTextY		lda	#15		bra	checkY; --- View by big icon -----------------------------------------bigIcon		lda	#80		bra	enter100; --- View by small icon ---------------------------------------smallIcon	lda	#160enter100	ldy	#icx		clc		adc	[<ic],y		bmi	checkMin		cmp	<maxX		bcc	checkMin		sta	<maxX; --- Find minimum values --------------------------------------checkMin	ldy	#icx		ldx	#2 lop100		phx		lda	bigOffset-icy,y		ldx	<windsView		beq	ok105		lda	smallOffset-icy,yok105		plx		clc		adc	[<ic],y		phy		bmi	skip102		ldy	<minY,x			If min is already negative, 		bmi	next100			it can be beat by a positive.		cmp	<minY,x			Is this	minimum	less than current?		bcc	store100		bra	next100 skip102		ldy	<minY,x			If min is positive,		bpl	store100		then it	is beat	by a negative. 		cmp	<minY,x		bcs	next100store100	sta	<minY,xnext100		ply		dey		dey		dex		dex		bpl	lop100		lda	#15		ldy	#icycheckY		clc		adc	[<ic],y		bmi	exit100		cmp	<maxY		bcc	exit100		sta	<maxYexit100		clc				Continue flag.		rtsbigOffset	DC.W	-21,-66smallOffset	dc.w	-10,-14; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Reset the position of every icon. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   ic =	icon to	reposition.;	   minY	= amount to add	to Y position. ;	   minX	= amount to add	to X position.;;  Icon	positions are changed, but so is the window's origin.  So, nothing;  moves inside	the content, only the scroll bars move.; ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =resetIconPos		ldy	#icy		lda	[<ic],y		clc		adc	<minY		sta	[<ic],y		iny		iny		lda	[<ic],y		clc		adc	<minX		sta	[<ic],y		clc		rts		ENDP;================================================================;	   Update memory used and available in info bars.;================================================================;;;   IN:	   C1_PathName = pathname (only root name used) of windows needing;		      to be updated.  First word zero for all windows.;;================================================================updateKs	PROCNAME EXPORT		import	_UpdateInfoWin				import	ClonePath		import	WStrCompare		lda	C1_PathName		All windows?		beq	@skip		jsr	justRootName		C1_PathName = pathname's root name.		jsr	ClonePath		;c1_temppath = c1_pathname; 19-Feb-93 JCM - The change to "bcs badUpdate" fixes a fatal bug if GetVolSizes ever;		  returns with the carry set (indicating an error). We'd previously;		  restore <curWind from the stack but we hadn't pushed it yet.		jsr	GetVolSizes		Get sizes for disk.;;;		bcs	@bad			;19-Feb-93 JCM - a little optimization		bcs	badUpdate		@skip		pei	<curWind+2		Save.		pei	<curWind		lda	#DirWindID		ldx	#updateWind		jsr	walkWindow*** Added - 19-Feb-93 JCM - Optimized out about 14 bytes with this change.		bra	UpdateInfos2				;;;		lda	#InfoWindID;;;		ldx	#updateInfoWind;;;		jsr	walkWindow;;;;;;@bad		pla				Restore.;;;		sta	<curWind;;;		pla;;;		sta	<curWind+2;;;		rts;; update the info windows in c1_temppath;		EXPORT	UpdateInfosUpdateInfos	pei	<curWind+2		Save.		pei	<curWindUpdateInfos2	lda	#InfoWindID		;19-Feb-93 JCM - for optimization		ldx	#updateInfoWind		jsr	walkWindow		pla				;Restore		sta	<curWind		pla		sta	<curWind+2badUpdate	rts				;19-Feb-93 JCM - for optimization;; called by WalkWindow to update the directory windows;updateWind	lda	prefer		and	#PREF_SHOWDISK		bne	@listHasInfo				ldy	#windView		;Nothing to do if viewed by text.		lda	[<windBlk],y		cmp	#viewByName		bcs	next1@listHasInfo	lda	C1_PathName		;All windows?		bne	checkit		jsr	getWindPath		;C1_PathName = window's pathname.		jsr	justRootName		;C1_PathName = pathname's root name.		jsr	GetVolSizes		;Get sizes for disk.		bcs	next1		stz	C1_PathName		;Put pathname mark back to all windows.		bra	ok1checkit		jsr	matchRootName		bcc	next1ok1		jsr	setKs			;windBlk = pointer to window's info block		bcs	@drawInfo				ldy	#windDirty		lda	[<windBlk],y		bpl	next1		@drawInfo	pei	<wind+2			;Draw the new info bar.		pei	<wind		_DrawInfoBarnext1		ldy	#windDirty		;clear our high bit		lda	[<windBlk],y;;;		and	#$7fff		asl a		lsr a		sta	[<windBlk],y				clc				;Continue flag.		rts		;; Called by WalkWindow to update any info windows from c1_temppath. If the length word; of c1_pathname is zero, then all root disk icon info windows are updated.;updateInfoWind			pushZLong <wind		pushZLong <icHand		pushZLong <ic				lda	c1_pathname		beq	@updateInfo				jsr	BuildInfoPath		;;;		bcs	@next			;26-Feb-93 JCM		bcc	@doThisOne		;26-Feb-93 JCM		brl	@next			;26-Feb-93 JCM@doThisOne	jsr	justRootName		;C1_PathName = pathname's root name.		pha		pushlong #c1_temppath		pushlong #c1_pathname		jsl	WStrCompare		pla		beq	@next		@updateInfo	jsr	BuildInfoPath		bcs	@next		jsr	doGetFileInfo		;folder or file's new create & mod time		bcc	@goodInfo		brl	@next@goodInfo	ldy	#icCDate		;update new create time, mod time in icon@loop		lda	|info_cdate-icCDate,y		sta	[<ic],y		iny		iny		cpy	#icCDate+16		bcc	@loop*** Added - 1-Mar-93 JCM - This fixes the problem where non-disk info windows would***			   suddenly get K values from their parent disk when files***			   were emptied from the trash.		ldy	#icFType		lda	[<ic],y		cmp	#TypeLastOne;;;		bcs	@doingFileInfo	;18-Mar-93 JCM - your logic was backwards, butthead		blt	@doingFileInfo	;18-Mar-93 JCM - (that was me anyway :-)*** End - 1-Mar-93 JCM		lda	c1_pathname		pha				jsr	JustRootName		jsr	GetVolSizes		bcs	@next				ldy	#icFBytes		; update new size in icon.		lda	NumBlks			; total blocks		sta	[<ic],y		iny		iny		lda	NumBlks+2		sta	[<ic],y		ldy	#icFBlocks		; update new size in icon.		lda	NumBlks			; used blks = total blks - free blks		sec		sbc	FreeBlks		sta	[<ic],y		iny		iny		lda	NumBlks+2		sbc	FreeBlks+2		sta	[<ic],y;;;@doingFileInfo	pla			;1-Mar-93 JCM		pla				;18-Mar-93 JCM - if we branch here, we haven't pushed it yet		sta	c1_pathname@doingFileInfo	ldy	#windIc+2		;18-Mar-93 JCM		lda	[<windBlk],y		pha		dey		dey		lda	[<windBlk],y		pha		PushLong #C1_PathName		jsl	_UpdateInfoWin		@next		pulllong <ic		pulllong <icHand		pulllong <wind		clc				;Continue flag.		rts;; c1_pathname = path of icon which opened into this window;BuildInfoPath	ldy	#windIc+2		lda	[<windBlk],y		sta	<icHand+2		dey		dey		lda	[<windBlk],y		sta	<icHand		lda	[<icHand]		sta	<ic		ldy	#2		lda	[<icHand],y		sta	<ic+2				ldy	#icFlag		lda	[<ic],y		and	#icOffline		bne	@next				ldy	#icFType		lda	[<ic],y		cmp	#TypeFTrash		bge	@next		cmp	#TypeFDrive		beq	@next		cmp	#TypeExtension		beq	@next		pushZLong <wind		pushZLong <windBlk				jsr	BuildPath3		;c1_pathname = icon's pathname				pulllong <windBlk		pulllong <wind		rts		@next		sec		rts		;; locals;free		dc.L	0used		dc.L	0		ENDP;================================================;	   Remove a duplicate icon.;================================================;; Called from moveIcons, which is called from walkOfLife.;;   IN:	   ic =	pointer	to icon	being copied into another window.;	   windTrack = destination window.;	   wind	= windTrack.;	   windBlk = destination window	info block.;;  OUT:	   Duplicate icon in destination window	is removed along with any;	   of its kids.;;================================================removeClone	PROC 	EXPORT		import 	clearAll		import	BuildPath3;; --- Find duplicate icon --------------------------------------------------;		lda	saveHand+2		pha		lda	saveHand		pha		pei	<curWind+2		Save state.		pei	<curWind		pei	<icHand+2		pei	<icHand		pei	<direction		lda	tocall+1		pha		lda	<windTrack+1		bne	@haveWindow				pushlong <icHand				pushlong #c1_pathname		pla		pla				lda	<iconTrack		sta	<icHand		lda	<iconTrack+2		sta	<icHand+2		jsr	lockic				jsr	buildPath3		jsr	unlockic		pulllong <icHand		jsr	lockic					lda	<ic			Pass point to icon to match in 'temp'.		sta	<temp		lda	<ic+2		sta	<temp+2		bra	@walkDesk@haveWindow	lda	<ic			Pass point to icon to match in 'temp'.		sta	<temp		lda	<ic+2		sta	<temp+2		lda	#matchName		Find the duplicate icon.		jsr	walkOfLife3		bcs	KillIt;; Change by SEG	per DanO 21 Jul	87;		jsr	GetWindPath		C1_PathName = destwindow		@walkDesk	lda	#matchExtend		jsr	walkExt2		bra	exitKillIt				jsr	NukeIt		exit		pla				Restore	state.		sta	tocall+1		pla		sta	<direction		pla		sta	<icHand		pla		sta	<icHand+2		pla		sta	<curWind		pla		sta	<curWind+2		pla		sta	saveHand		pla		sta	saveHand+2		brl	seticmatchExtend	jsr	MatchName		bcc	exit200NukeIt		pushZLong <icHand		jsr	lockic		pushZlong <wind		pushZLong <windBlk		pha		pha		_GetPort		jsr	toDesktop		; switch to desktop 		jsr	toDeskPort		; switch to desktop port				pushZLong <curWind		lda	<deskport		; switch to desktop		sta	<curWind		lda	<deskport+2		sta	<curWind+2		jsr	ClearAll				pulllong <curWind		_SetPort		pulllong <windBlk		pulllong <wind		pulllong <icHand		jsr	lockic		jsr	killIcon		Erase and delete the duplicate icon.				secexit200		rts;; Kill the extended icon if the name matches...;;matchExtend	jsr	MatchName;		bcc	exit200;		;		jsr	dumpExtIcon;		sec;		rts		;-----------------------------------------------; does new name match old name ?;; IN:	temp = pointer to icon to match;	<ic = current icon in walk;; OUT:	carry set if names match;-----------------------------------------------matchName		IMPORT	PStringCompare		pha				; space for result		clc		lda	<temp		adc	#icName		tay		lda	<temp+2		adc	<zero		pha				; ptr to 1st sring		phy		clc		lda	<ic		adc	#icName		tay		lda	<ic+2		adc	<zero		pha		phy				; ptr to 2nd string		jsl	PStringCompare		pla		cmp	#1		rts				ENDP;========================================================;	   Take	icon off screen, delete;	   from	list, and dispose of record.;========================================================;;   IN:	   icHand = icon to kill.;	   ic =	(icHand).;;  OUT:	   ic =	no longer valid.;	   icHand = freed handle.;	   wind	= trash.;	   windBlk = trash.;	   irect1 = trash.;	   irect2 = trash.;;========================================================		EXPORT	killIconkillIcon	PROC		ldy	#icMom+2		Get icon's mother window.		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	getwRefCon2		ldy	#icFlag		lda	[<ic],y		and	#icExtended		beq	@inWindow				brl	dumpExtIcon@inWindow	ldy	#windView		View by	text don't need to be redrawn.		lda	[<windBlk],y		cmp	#viewByName		bcs	exit		lda	<wind			Setup to draw in window.		ldx	<wind+2		jsr	startDraw2		jsr	getIconRect		Get icon's RECT.		jsr	pushirect1		_EraseRect		jsr	pushirect2		_EraseRect		jsr	pushirect1		_InvalRect		jsr	pushirect2		_InvalRect		jsr	endDrawexit		brl	cutNfree		Cut icon and free record.		ENDP;==================================================;	   Get amount of free memory.;==================================================;;  OUT:	   a = low word	amount of free memory.;	   x = high word, flags	set to high value.;;==================================================ckMemory	PROC	EXPORT		pha		pha		_RealFreeMem		pla		plx		rts		ENDP;==============================================;; IN:	C1_PathName; OUT:	FreeBlks and NumBlks;==============================================GetVolSizes	PROC	EXPORT			;added 07/13/88 DJB			IMPORT	GetDeviceInfo		IMPORT	GetDeviceNumber		IMPORT	GetVolumeInfo		IMPORT	IgnoreGSOSError		IMPORT	IgnoreErrors				stz	fileSysID		stz	NumBlks		stz	NumBlks+2		stz	FreeBlks		stz	FreeBlks+2		lda	>IgnoreErrors		pha		jsl	IgnoreGSOSError				pha				; space for devNum		PushLong #C1_PathName		jsl	GetDeviceNumber		pla		bcs	exit		pha				; devNum		PushLong #C1_DeviceName		; devNamePtr		lda <zero		pha		pha				; skip devChar		pha		pha				; skip devBlocks		pha		pha				; skip devID		jsl	GetDeviceInfo		bcs	exit		PushLong #C1_DeviceName		; pointer to device name		PushLong #C1_VolName		; pointer to volume name		PushLong #NumBlks		; pointer to total blocks		PushLong #FreeBlks		; pointer to free blocks		PushLong #fileSysID		; pointer to file system ID		lda <zero		pha		pha				; skip block size		jsl	GetVolumeInfoexit		pla		sta	>IgnoreErrors		rts				ENDP*=======================================**	Fix State of an Icon's Lock	** - called from GetInfo module		**					** IN:	a,x = pointer to IconObj	**					** OUT:	none				**=======================================*FixIconLock	PROC 	EXPORT		IMPORT	toDesktop		IMPORT	toDeskPort		IMPORT	getRectRgn		IMPORT	freeRectRgn		IMPORT	addRgn		IMPORT	getIconRect		IMPORT	drawDeskIcon			phb		phk		plb		pei	<ic+2			; preserve this variable		pei	<ic				sta	<ic		stx	<ic+2				ldy	#icFlag		lda	[<ic],y		and	#ICEXTENDED		; extended icons are on the desktop		bne	onDesk		ldy	#icFType		;fundamental assertion: if it's a 		lda	[<ic],y			;device, it's on the desktop		bmi	onDesk		ldy	#icMom+2		; get icon's mother window		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	getwRefCon2		lda	<wind		 	; setup to draw in window		ldx	<wind+2		jsr	startDraw2		jsr	getIconRect		; get icon's RECT	; we no longer need to calculate any slop around the edges because the lock icon stuff; now erases the region for the original ;;		lda	<irect2+x1		; a little extra on the sides;		sbc	#10;		sta	<irect2+x1;		lda	<irect2+x2;		adc	#10;		sta	<irect2+x2		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon	;anything other than view by big icon?		bcs	notByIcon		inc	<irect2+y1		; just the text...notByIcon		jsr	pushirect2		_EraseRect		jsr	pushirect2		_InvalRect		jsr	endDraw		bra	exitonDesk		jsr	toDesktop		; switch to desktop 		jsr	toDeskPort		; switch to desktop port		jsr	getRectRgn		; allocate rectRgn and tempRgn		jsr	getIconRect		; irect1 and irect2 = trash area		lda	<irect2+x1		; a little extra on the sides		sbc	#10		sta	<irect2+x1		lda	<irect2+x2		adc	#10		sta	<irect2+x2		inc	<irect2+y1		; just the text...		lda	#irect2		jsr	addRgn 		jsr	drawDeskIcon		; redraw the icon's text		jsr	freeRectRgn		; free allocated regionsexit		pla		sta	<ic			; restore variable		plx		stx	<ic+2		plb		rtl		ENDP		; Called from lots of places to reduce the _CloseWindow macros to 1 - here.; This saves 3 bytes per call.				EXPORT	CloseThisWindow		;;;		IMPORT	fileWindowPtr ;orig window code is currently commented out		IMPORT	copyWindowPtr		IMPORT	diskWindowPtr		IMPORT	dupWindowPtr		IMPORT	transWindowPtr		IMPORT	repWindowPtr		CloseThisWindow	PROC		phx		pha		_CloseWindow		rtl;;;		EXPORT	CloseFileWindow ;orig window code is currently commented out;;;CloseFileWindow	;;;;;;		lda	fileWindowPtr;;;		ldx	fileWindowPtr+2;;;;;;		bra	CloseThisWindow		EXPORT	CloseCopyWindowCloseCopyWindow			lda	copyWindowPtr		ldx	copyWindowPtr+2		bra	CloseThisWindow		EXPORT	CloseDiskWindowCloseDiskWindow			lda	diskWindowPtr		ldx	diskWindowPtr+2		bra	CloseThisWindow		EXPORT	CloseDupWindowCloseDupWindow			lda	dupWindowPtr		ldx	dupWindowPtr+2		bra	CloseThisWindow		EXPORT	CloseTransWindowCloseTransWindow			lda	transWindowPtr		ldx	transWindowPtr+2		bra	CloseThisWindow		EXPORT	CloseRepWindowCloseRepWindow			lda	repWindowPtr		ldx	repWindowPtr+2		bra	CloseThisWindow		ENDP;==============================================		END		