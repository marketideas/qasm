		blanks off		;==============================================;	Direct page offsets;;==============================================curWind		equ	0			;Current icon port (window)wind		equ	curWind+4		;Window work pointer.windBlk		equ	wind+4			;Pointer to window info block.icHand		equ	windBlk+4		;General ICONOBJ handle.ic		equ	icHand+4		;icHand dereferenced.icBlkHand	equ	ic+4			;General ICONBLK handle.icBlk		equ	icBlkHand+4		;(icBlkHand) or pointer to ICONDATA record.icon		equ	icBlk+4			;Pointer to an ICON record.dRect		equ	icon+4			;Work RECT.irect1		equ	dRect+8			;Icon's enclosing RECT.irect2		equ	irect1+8		;Icon title's enclosing RECT.	\ these MUST betemp		equ	irect2+8		;Work pointer.			/ contiguous!tempRgn		equ	temp+4			;Handle of work region.deskPort	equ	tempRgn+4		;Address of Window Manager's portdeskic		equ	deskPort+4		;Handle of first ICONOBJ on desktopdeskID		equ	deskic+4		;Desktop ID, NoWindID.deskView	equ	deskID+2		;Desktop view, large icons.deskBlank	equ	deskView+2		;Handle of icon that desktop opened from.TaskRec		equ	deskBlank+4		;Task Master record.what		equ	TaskRecmessage		equ	what+2when		equ	message+4yrat		equ	when+4			;General y coordinate holder.xrat		equ	yrat+2			;General x coordinate holder.modifiers	equ	xrat+2TaskData	equ	modifiers+2TaskMask	equ	TaskData+4TaskLastClick	equ	TaskMask+4		TaskClickCount	equ	TaskLastClick+4TaskData2	equ	TaskClickCount+2TaskData3	equ	TaskData2+4TaskData4	equ	TaskData3+4TaskLastClickPt	equ	TaskData4+4devNumber	equ	TaskLastClickPt+4filetype	equ	devNumber+2TrashWind	equ	filetype+2		;Window pointer for Trash can.;;;ClipWind	equ	TrashWind+4		;Window pointer for clipboard. (removed 19-Aug-92 DAL)lastClick	equ	TrashWind+4		;Time of last button down on an icon.rectHand	equ	lastClick+4		;Handle of RECT list.rectPtr		equ	rectHand+4		;Pointer to RECT list.rectRgn		equ	rectPtr+4		;Handle of region containing all RECTs.lineAddrs	equ	rectRgn+4		;Address of scan line address table.mask1		equ	lineAddrs+4		;Variables used by icon drag draw rects.mask2		equ	mask1+2			mask3		equ	mask2+2			line1		equ	mask3+2			yoffset		equ	line1+2			;Window's offset to global coordinates.xoffset		equ	yoffset+2		;Window's offset to global coordinates.yoffset2	equ	xoffset+2		;Window's offset to global coordinates.xoffset2	equ	yoffset2+2		;Window's offset to global coordinates.MyID		equ	xoffset2+2		;ID number to use for memory allocation.direction	equ	MyID+2			;WalkOfLife's direction.drawCount	equ	direction+2IconTrack	equ	drawCount+2windTrack	equ	IconTrack+4posFile		equ	windTrack+4		;Handle of window position information.copyFile	equ	posFile+4		;TRUE to duplicate icons, FALSE to move.LErename	equ	copyFile+2		;Handle of line edit field for rename.work		equ	LErename+4		;*** WARNING *** Some routines use scratch						;***             space following <work!deref		equ	work+4			;local place for dereffing thingshandle		equ	deref+4			;Must be first and zero.ptr		equ	handle+4		;generic pointer, not safe to use in subshandle2		equ	ptr+4ptr2		equ	handle2+4handle3		equ	ptr2+4ptr3		equ	handle3+4;; NOTE that handle4 and rootBuffer overlap;handle4		equ	ptr3+4rootBuffer	equ	ptr3+4ptr4		equ	handle4+4		;Work string pointer.rootOffset	equ	handle4+4visRECT		equ	ptr4+4			;our visible rgn's boundsrect when drawin'QuickDrawDP	equ	visRECT+8zero		equ	QuickDrawDP+2		;This will always be a zero word (20-Feb-92 DAL)EndOfDP		equ	zero+2;; at last count there were 8 bytes free on DP, 1/24/92, andy;		IF	EndOfDP>$FF THEN			WRITE 'EndOfDP = '			WRITELN EndOfDP			AERROR 'WARNING... Direct page variable overflow!'		ENDIF; --- Offsets to other tools' direct pages --------------------------------Misc_zp		equ	0			Misc_zp, 1 zero	pages.COPY_zp		equ	Misc_zp+$0100		Copy tool.Total_zp	equ	COPY_zp+$0100		Total number of	zero pages needed.