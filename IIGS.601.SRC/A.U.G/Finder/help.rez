               $0000,          	// drawMode               $00000000       	// filterProcPtr       }};};// --- rPString Templatesresource rPString (PSTR_00001000, $0010) {       " Topic "};resource rPstring (PSTR_00001001, $0010) {		"Using Help"};resource rPString (PSTR_00001002, $0010) {       "Tunneling and Closing"};resource rPString (PSTR_00001003, $0010) {       "Pop-ups in Window Titles"};resource rPString (PSTR_00001004, $0010) {       "Dimmed Menu Commands"};resource rPString (PSTR_00001005, $0010) {       "Selecting & Coloring icons"};resource rPString (PSTR_00001006, $0010) {       "Disk Copying Options"};resource rPString (PSTR_00001007, $0010) {       "Saving Window Positions"};resource rPString (PSTR_00001008, $0010) {       "Moving Inactive Windows"};resource rPString (PSTR_00001009, $0010) {       "File Copying Options"};resource rPString (PSTR_0000100A, $0010) {       "Odds & Ends, Hints & Tips"};// --- Menu Definitionsresource rMenu (MENU_00001000, $0000) {       $0001,                  // menuID       $A000,                  // menuFlag       PSTR_00001000, {        // menuTitleRef               MENUITEM_00001000,			   MENUITEM_000010FF,               MENUITEM_00001001,               MENUITEM_00001002,               MENUITEM_00001003,               MENUITEM_00001004,               MENUITEM_00001005,               MENUITEM_00001006,               MENUITEM_00001007,               MENUITEM_00001008,			   MENUITEM_000010FF,			   MENUITEM_00001009       };};// --- Menu Item Definitionsresource rMenuItem (MENUITEM_00001000, 0) {       $1000,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001001           // itemTitleRef};// dividing line between these tworesource rMenuItem (MENUITEM_00001001, 0) {       $1001,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001002           // itemTitleRef};resource rMenuItem (MENUITEM_00001002, 0) {       $1002,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001003           // itemTitleRef};resource rMenuItem (MENUITEM_00001003, 0) {       $1003,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001004           // itemTitleRef};resource rMenuItem (MENUITEM_00001004, 0) {       $1004,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001005           // itemTitleRef};resource rMenuItem (MENUITEM_00001005, 0) {       $1005,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001006           // itemTitleRef};resource rMenuItem (MENUITEM_00001006, 0) {       $1006,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001007           // itemTitleRef};resource rMenuItem (MENUITEM_00001007, 0) {       $1007,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001008           // itemTitleRef};resource rMenuItem (MENUITEM_00001008, 0) {       $1008,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_00001009           // itemTitleRef};// dividing line bewteen these tworesource rMenuItem (MENUITEM_00001009, 0) {       $1009,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8000,                  // itemFlag       PSTR_0000100A           // itemTitleRef};resource rMenuItem (MENUITEM_000010FF, 0) {       $10FF,                  // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8080,                  // itemFlag (dimmed)       PSTR_000010FF           // itemTitleRef};resource rPString(PSTR_000010FF,0) {		"-"};// --- Window Templatesresource rWindParam1 (WPARAM1_00000002, 0) {       $C080,                  // plFrame (frame bits)       PSTR_00000106,          // plTitle (title ID)       $00000000,              // plRefCon       {  0,  0,  0,  0},      // plZoomRect       WCOLOR_07FF0001,        // plColorTable       {$0000, $0000},         // plYOrigin, plXOrigin       {$0000, $0000},         // plDataHeight, plDataWidth       {$0000, $0000},         // plMaxHeight, plMaxWidth       {$0000, $0000},         // plVerScroll, plHorScroll       {$0000, $0000},         // plVerPage, plHorPage       $00000000,              // plInfoText (info RefCon)       $0000,                  // plInfoHeight       { 62, 56,166,452},      // plPosition       infront,                // plPlane       CTLLST_00000002,        // plControlList       $0A09                   // plInDesc};// --- rText Templatesresource rText (TXT_00001000, $0000) {		"To get information on different Finder features, choose a "		"feature from the pop-up menu above."		"\$0d"		"\$0d"		"When there is more text than will fit in the window, you can "		"use the scroll-bar on the right to see the rest."};resource rText (TXT_00001001, $0000) {       "Double-clicking a folder while holding down the Option key "       "opens the folder and then closes the window the folder is in.  "       "This is called “Tunneling.”"	   "\$0D"       "\$0D"	   "Holding down the Option key while opening a group "	   "of folders also allows Tunneling."       "\$0D"       "\$0D"       "Holding down the "	   "\$11"	   " key while clicking a window’s "	   "title displays a menu of the enclosing folders; the folder you choose "	   "opens.  "       "If you also hold down the Option key, the original window then closes.  "       "This is called “Reverse Tunneling.”"       "\$0D"       "\$0D"       "Holding down the Option key while selecting a window from the Windows "	   "menu closes the window instead of bringing it to the front."       "\$0D"       "\$0D"	   "Holding down the Option key while selecting “Close” or its Command "	   "key equivalent ("	   "\$11"	   " W) has the same effect as “Close All.”"};resource rText (TXT_00001002, $0000) {       "Holding down the "	   "\$11"	   " key while clicking the title of the "       "active window shows you a pop-up menu listing the enclosing folders.  "       "Choosing a folder opens the corresponding window."};resource rText (TXT_00001003, $0000) {       "The Finder dims menu commands that can’t"       " be used right now.  Notice that when you select or deselect ic"       "ons or windows, some menu items change from regular to dimm"       "ed and vice versa.  If a menu command you want to use is dimmed,"       " try selecting some icons until the menu item becomes active."};resource rText (TXT_00001004, $0000) {       "To select icons that are grouped together, position the pointer "       "outside one corner of the group of icons and drag to the opposite "       "corner."       "\$0D"       "\$0D"       "To select icons that aren’t grouped together, select one icon by"       " clicking it.  Then hold down the Shift key as you click each"       " additional icon.  Deselect icons by holding down the Shift key "       "and clicking selected icons."	   "\$0D"	   "\$0D"	   "To select an icon by name, begin typing the name.  You can also use the "	   "arrow keys.  Tab selects the next icon alphabetically; Shift-Tab selects "	   "the previous icon alphabetically.  Esc deselects all icons and lets you "	   "keyboard-select icons in the front window.  "	   "\$11"	   "-Esc deselects all "	   "icons and lets you keyboard-select icons on the desktop."       "\$0D"       "\$0D"	   "To color an icon, select an icon (by clicking it) "	   "then choose a color from the Color menu.  To reverse the preference "	   "setting for the portion of the icon to color (background or outline), "	   "hold down the Control key while choosing a color from the Color menu."};resource rText (TXT_00001005, $0000) {	   "To see a dialog box listing the different disk copy alternatives "	   "hold down the Option key"       " as you drag the source disk’s icon onto the destination disk’s "       "icon or window."};resource rText (TXT_00001006, $0000) {       "When you close a window or drag a disk icon into the Trash, the "       "Finder creates a file on the disk that "       "records"       " the size and position of each affected window and the position "       "and color of icons in each affected window."       "\$0D"       "\$0D"	   "A check box in Preferences... allows you to turn this feature on "	   "or off."	   "\$0D"       "\$0D"	   "Holding down the Control key while closing a window reverses the "	   "preference setting of “Save Finder information onto disk.”  The Control "	   "key sequence can be combined with the other methods of closing a window."};resource rText (TXT_00001007, $0000) {       "To move an inactive window without making it active, "       "hold down the "	   "\$11"	   " key when you drag the window by its title bar."};// resource rText (TXT_00001008, $0000) {//       "When copying or moving files from one location to another, the "//       "destination disk or folder may already contain items with the sam"//       "e names as those being copied.  Unless you request otherwise, the "//	   "Finder asks you what to do about each duplicate individually."//       "\$0D"//       "\$0D"//	   "To specify in advance how to handle all the duplicates, " //       "hold down the Option key while dragging the source file icons"//       " onto the destination icon or onto the destination window."// };resource rText (TXT_00001008, $0000) {		"When you drag files and folders to another location on the same disk, "		"the Finder normally moves the items rather than making new copies."		"\$0D"		"\$0D"		"To have the Finder make copies, hold down the Option key while dragging "		"the icons."		"\$0D"		"\$0D"		"When you drag certain kinds of files to the system folder icon, the "		"Finder offers to automatically put them in the proper folders within "		"the System folder."};resource rText (TXT_00001009, $0000) {		"Option-Clean Up does “Clean Up by Name”.  "		"Clean Up by Name on a window viewed by icon places the icons onto the large "		"icon grid  based on the width of the window.  Clean Up by Name on a window "		"viewed by small icon places the icons into columns based on the height of "		"the window.  Use this, it’s cool."        "\$0D"        "\$0D"		"You can click on Name, Size, Kind, or Last modified to change a window’s view."        "\$0D"        "\$0D"	   	"Holding down the Control key while opening a folder makes the Finder "	   	"ignore any saved Finder information for that folder, opening the folder "	   	"quickly to a regular window position."        "\$0D"        "\$0D"		"Folders which aren’t on shared disks and which don’t contain a Finder "		"information file inherit the view of their parent window."		"\$0D"		"\$0D"		"For more tips on the Finder and other parts of the system, open the "		"Shortcuts file on SystemTools2."};