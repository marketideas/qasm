*===============================================**						** File:		Menu.aii			** Project:	GS Finder			** Orig Authors:	Don J. Brady & Dan Oliver	** Build file:	Finder.Make			**						** © Copyright Apple Computer, Inc. 1986-1992	** All rights reserved.				**===============================================** Global Routines:				**						**===============================================*		STRING	ASIS		BLANKS	OFF				PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM		INCLUDE 'All.macros'		INCLUDE	'special.macros'		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'		INCLUDE	'DP.equ'		INCLUDE	'Data.equ'		INCLUDE	'Strings.equ'		PRINT	ON;------------------------------------------;; Equates from procedure menudata;;------------------------------------------ret		equ	13CancelID	equ	$FFFFOKID		equ	$0001;------------------------------------------;;   Imported addresses;;------------------------------------------							IMPORT	updateInfoWin		;in main.aii		IMPORT	shutdown_list		;in data.aii		IMPORT	shutdown_flag		;in data.aii		IMPORT	FinderSaveAll		;in main.aii		IMPORT	ValidateFile		;in Verify.aii		IMPORT	GetVerifyGuts		;in Verify.aii		IMPORT	GetVerifyInfo		;in verify.aii		IMPORT	GetValidGuts		;in Verify.aii		IMPORT	GetValidInfo		;in verify.aii		IMPORT	PtoWString		;in utility.aii		IMPORT	PathAddName		;in verify.aii		IMPORT	FileSysID				IMPORT	matchWindName		IMPORT	info_access		IMPORT	info_mtime		IMPORT	info_mdate		IMPORT	info_ctime		IMPORT	info_cdate		IMPORT	info_blocks		IMPORT	storage_type		IMPORT	ChangeDialog		IMPORT	EndDialog		IMPORT	MonitorDialog		Wait for selection.		IMPORT	ProDOSerr		Handle any ProDOS error.		IMPORT	StartDialog		IMPORT	VerifyMedium		IMPORT	addFunctionKey		Check function at end of Menu track.		IMPORT	addIconObj		Add a new icon to the window.		IMPORT	addIconRgn		Add the	extended icon's area to region.		IMPORT	addRgn		IMPORT	blinkOne		IMPORT	ckIfWind			;Is there enough memory for a window?		IMPORT	cutOutIcon		Remove the extended icon's record.		IMPORT	doClose			Close the top most window.		IMPORT	doCreate		pathname = path	of folder to create.		IMPORT	drawDeskIcon		Draw the icon (Trash) where Trash was.		IMPORT	drawIcon2		IMPORT	dupDevice2		Check if the new name is taken.		IMPORT	erase			Ask ProDOS to erase disk.		IMPORT	FSysID		IMPORT	freeRectRgn		IMPORT	freeTempRgn		IMPORT	getName			pathname = new name.		IMPORT	getRectRgn		Allocate rectRgn and tempRgn.		IMPORT	matchImage		Find offset to Trash icon image.		IMPORT	menuHelp		Set new	menu help state.		IMPORT	newDataSize3		Compute	new data size for window.		IMPORT	offsetRgn		rectRgn	= old rectRgn +	new rectRgn.		IMPORT	openAll			Open all the selected icons.		IMPORT	pushTask		;pass pointer to Task record.		IMPORT	redrawList		Redraw hole left by deleted icons.		IMPORT	selectWind2		;Bring window to top and exit		IMPORT	setItems		Update number of icons in window info bar.		IMPORT	toDesktop		Switch to desktop. 		IMPORT	wipeIcon		Cut icon out of	icon list add to redraw.		IMPORT	zoomRect2		import	zoomRectNoSound		IMPORT	INFO_TYPE		IMPORT	read_len		IMPORT	read_size		IMPORT	read_buff		IMPORT	newDataSize2		IMPORT	open_num		IMPORT	write_num		IMPORT	write_buff		IMPORT	write_len		IMPORT	WRITE_LIST		IMPORT	file_type				IMPORT	WalkGoto		IMPORT	officon		IMPORT	toCall			;in Util.aii		IMPORT	FileEntry		IMPORT	MiscEntry		IMPORT	NewDialog		IMPORT	addDataName		IMPORT	allocate		IMPORT	allocate2		IMPORT	arrowCursor		IMPORT	bigError1		IMPORT	boxRename		IMPORT	buildPath		IMPORT	buildPath3		IMPORT	buildRectList		IMPORT	buildRects		IMPORT	checkRectHit		IMPORT	ckDataWrite		IMPORT	ckMemory		IMPORT	ckVolume				IMPORT	clearDisk		IMPORT	clonePath		IMPORT	close_file		IMPORT	cur2windT		IMPORT	dayOfWeek		IMPORT	derefHand		IMPORT	deselectall		IMPORT	doGetFileInfo		IMPORT	doRead		IMPORT	doSetPrefix		IMPORT	doWrite		IMPORT	endDraw			IMPORT	findLastName		IMPORT	findSelect		IMPORT	getExtName		IMPORT	getFrontWind		IMPORT	getHeadIcon		IMPORT	getIconPtr		IMPORT	getIconRect		IMPORT	getNextWind		IMPORT	getRootName		IMPORT	getWindID		IMPORT	getWindID2		IMPORT	getWindPath		IMPORT	getWoffset		IMPORT	geticNamePtr		IMPORT	geticNamePtr2		IMPORT	getwRefCon		IMPORT	getwRefCon2		IMPORT	hitIconName		IMPORT	ifDesk		IMPORT	killkids2		IMPORT	killkids3		IMPORT	lenError		IMPORT	lockic		IMPORT	makeField		IMPORT	makeIcRoot		IMPORT	markClosed		IMPORT	markOpen		IMPORT	matchIcName		IMPORT	newDataSize		IMPORT	noRename		IMPORT	offIcon2		IMPORT	onIcon		IMPORT	open_file		IMPORT	path2ticon		IMPORT	pullFields		IMPORT	pushicName		IMPORT	pushirect1		IMPORT	pushirect2		IMPORT	pushrect		IMPORT	pushwork		IMPORT	pushyrat		IMPORT	pushzpage		IMPORT	removeClone		IMPORT	resetCTime		IMPORT	restoreTemp		IMPORT	saveTemp		IMPORT	selectWind		IMPORT	setInfo		IMPORT	setInfo2		IMPORT	setOrgnMask			IMPORT	setSmallRect		IMPORT	setic		IMPORT	seticBlk		IMPORT	settemp		IMPORT	sort		IMPORT	startDraw		IMPORT	startDraw2		IMPORT	startHash		IMPORT	toDeskPort		IMPORT	trashDisk		IMPORT	unlockBlk		IMPORT	unlockic		IMPORT	updateKs		IMPORT	walkBack		IMPORT	walkOfLife		IMPORT	walkOfLife2		IMPORT	walkOfLife3		IMPORT	walkWindow		IMPORT	walkback2		IMPORT	watchCursor		IMPORT	wind2top		IMPORT	windRefCon		IMPORT	windSpot;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------;		ENTRY	menudata	;		ENTRY	menuList;		ENTRY	accmenu;		ENTRY	filemenu;		ENTRY	editmenu;		ENTRY	viewmenu;		ENTRY	volmenu;		ENTRY	specmenu		ENTRY	redrawText		ENTRY	newView;		ENTRY	menudata*===============================================**	Local Static Data for menus		*		*===============================================*LocalData	PROC		ENTRY	DeskIconStateDeskIconState	DC.W	0		EXPORT	DeskWindStateDeskWindState	DC.W	0		ENTRY	LastIconStateLastIconState	DC.W	0		ENTRY	LastWindStateLastWindState	DC.W	0		ENTRY	MenuChangeMenuChange	DC.W	0		ENDP; Initialize the Finder's menus;; IN: nothing;; OUT: nothing;.....................................................................MenuInit	PROC	EXPORT		IMPORT	colorMenuFlag		IMPORT	screen		IMPORT	colorMenuDef		;		pha;		pha;		_GetMenuBar			;get the current system menu bar;;		pha;		pha;		pea	2			;refIsResource;		pushlong #1			;ID of menuBar resource;		pushlong #0			;NIL for system menu bar;		_NewMenuBar2;		;		lda	1,s;		sta	menuBarHandle;		lda	3,s;		sta	menuBarHandle+2;		_SetSysBar;		pushlong #0;		_SetMenuBar;		_DisposeHandle			;dispose of the old system menu bar*** 10-Mar-92 DAL -- use CString-based menu strings;; Create and insert all our menus, right to left; (rCString 9 down to 2);		lda #9@make1menu	pha		pha		pha			;space for NewMenu		pha		pha			;space for LoadResource		pea $801d		;rCString		pei <zero		pha			;ID		_LoadResource		phd		tsc		tcd		ldy #2		lda [3],y		tax		lda [3]		sta <3		stx <5		pld		_NewMenu		pei <zero		;at beginning		_InsertMenu		pla		dec a		cmp #2		bcs @make1menu*** end 10-Mar-92		pha		pha		pea	idColorMenu		_GetMHandle		pulllong <deref				lda	[<deref]		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref				ldy	#6		lda	#colorMenuDef		sta	[<deref],y		iny		iny		lda	#colorMenuDef>>16		sta	[<deref],y;; this is also presented in the data.aii file;cellV		equ	12			; height of a cellcellH		equ	40			; width of a cellgapV		equ	2			; height of gap between cellsgapH		equ	5			; width of gap between cells		pea	5*gapH+3*cellH		;width		pea	7*gapV+5*cellV		;height		pea	idColorMenu		;calc the color menu		_CalcMenuSize				pea	idAppleMenu		_FixAppleMenu*** added 24-Jul-91 DAL		pha		_GetNumNDAs		pla		bne @someNDAs		pea $fffe		_DeleteMItem@someNDAs***		pha		_FixMenuBar		pla		sta	screen+y1		; save height of menu bar		pei <zero			; auto calc width		pei <zero			; auto calc height		pea	idAppleMenu		; pass ID of Apple menu		_CalcMenuSize		_DrawMenubar			; draw the system menu bar		stz	LastIconState		; init local data		stz	LastWindState		stz	DeskWindState		stz	DeskIconState		rts		;		EXPORT menuBarHandle;menuBarHandle	dc.L	0		ENDP; Do the color menus;.....................................................................ColorMenus	PROCNAME		IMPORT	SelectionIsChanging		newColor	equ	workcolorMask	equ	newColor+2				sec		sbc	#idColor_0		and	#$000F		xba		sta	<newColor				lda	<modifiers		;Save state of function key.		and	#$1000		tay		ldx	#_ICFORECLR		lda	prefer			Key down to select back	or foreground?		and	#PREF_COLOR		bne	ok2		tya				Flip the key state.		eor	#$1000		tayok2		tya		and	#$1000		bne	ok1		ldx	#_ICBACKCLR		asl	<newColor		asl	<newColor		asl	<newColor		asl	<newColorok1		stx	<colorMask		bra	aroundFRQ;; At this point, we need Y=new color value and X=color mask value;		export frqColorEntryfrqColorEntry	sty	<newColor		stx	<colorMaskaroundFRQ	jsl	SelectionIsChanging		jsr	NoRename		; JAM 5/18/89 to fix title inversion prob.;; Set the port and origin AFTER the norename call.  This fix brought to you by Andy, about 12 hours; before 6.0 GM, 2/9/92.;		jsr	startDraw		Switch to proper port and origin.		lda	#colorIcons		Routine	to call	for every selected icon.		jsr	findSelect		brl	endDraw			Put origin back.*===============================================*colorIcons		ldy	#icFlag		lda	[<ic],y		and	<colorMask		ora	<newColor		sta	[<ic],y				brl	blinkOne			ENDP; Do the new about window;.....................................................................AboutMenu	PROC export		IMPORT	insertItemRef		IMPORT	aboutWindowPtr		IMPORT	AboutWindow		IMPORT	setSmallRect		IMPORT	bigRect		IMPORT	zoomRect		IMPORT	aboutBlk		IMPORT	addWindow2Menu		IMPORT	pickAWindow		IMPORT	GetBigRect		lda	aboutWindowPtr+1		beq	@notOpen		brl	@alreadyOpen@notOpen	jsl	AboutWindow		; new About window		lda	aboutWindowPtr+1		bne	@open		rts		@open		jsr	setSmallRect				pushlong bigRect		pushlong bigRect+4		lda	aboutWindowPtr		ldx	aboutWindowPtr+2		jsr	GetBigRect						lda	#1		;zoom out		jsr	ZoomRect				pulllong bigRect+4		pulllong bigRect		pushlong aboutWindowPtr		_ShowWindow				lda	#aboutBlk		sta	wind_ref				clc		adc	#windMenuText		sta	insertItemRef+10		lda	#aboutBlk>>16		sta	wind_ref+2		adc	<zero		sta	insertItemRef+12				jmp	addWindow2Menu		;add the trash to the windows menu;; fix the windows menu to put the about box in it;@alreadyOpen	pushlong aboutWindowPtr		_SelectWindow		rts		ENDP; Do the help window;.....................................................................HelpMenu	PROC		IMPORT	insertItemRef		IMPORT	helpWindowPtr		IMPORT	helpWindow		IMPORT	setSmallRect		IMPORT	bigRect		IMPORT	zoomRect		IMPORT	helpBlk		IMPORT	addWindow2Menu		lda	helpWindowPtr+1		beq	@notOpen		brl	@alreadyOpen@notOpen	jsl	helpWindow		; do the help window		lda	helpWindowPtr+1		bne	@open		rts		@open		jsr	setSmallRect				pushlong bigRect		pushlong bigRect+4		pha		pha		pushlong helpWindowPtr		_GetStructRgn		phd		tsc		tcd				lda	[3]		;deref the handle to the region		tax		ldy	#2		lda	[3],y		sta	3+2		stx	3		ldy	#6+2		;no, don't fix this, it's not supposed to copy the first@loop		lda	[3],y		;two bytes of the structure since the bounding rect of		sta	bigRect-2,y	;the struct region is at offset +2		dey			;andy and DAL, 1/7/91		dey		bne	@loop				pld		pla		pla				lda	#1		;zoom out		jsr	ZoomRect				pulllong bigRect+4		pulllong bigRect		pushlong helpWindowPtr		_ShowWindow		lda	#helpBlk		sta	wind_ref				clc		adc	#windMenuText		sta	insertItemRef+10		lda	#helpBlk>>16		sta	wind_ref+2		adc	<zero		sta	insertItemRef+12				jmp	addWindow2Menu		;add the name to the windows menu;; fix the windows menu to put the help window in it;@alreadyOpen	pushlong helpWindowPtr		_SelectWindow		rts		ENDP; Do the print menu;.....................................................................PrintMenu	PROC		IMPORT	OpenMenu		jsr	noRename		Remove any rename field.		inc	Printing		Set print flag.		jsr	OpenMenu		Act like Open was selected.		stz	Printing		Clear Print flag.exit12		rts		ENDP; Do the empty trash menu;.....................................................................EmptyTrashMenu	PROCNAME EXPORT			; can be call from other files		IMPORT	WStringCopy		IMPORT	putBack2		IMPORT	MenschTemp		IMPORT	ProDOSErr		IMPORT	ClearWindDirty		lda	>TrashBlk+1		Is there anything in the Trash?		bne	ok		brl	exit			If not,	just quit.ok		pea	$8043		_SysBeep2		jsr	noRename		Remove any rename field.		pei	<TaskData+2		Save.		pei	<taskData		pei	<windBlk+2		pei	<windBlk		pei	<curWind+2		pei	<curWind		pei	<icHand+2		pei	<icHand		pei	<rectRgn+2		pei	<rectRgn		pei	<tempRgn+2		pei	<tempRgn		lda	<TrashWind		Switch to the Trash plane.		sta	<curWind		lda	<TrashWind+2		sta	<curWind+2		jsr	getwRefCon		Get the	window's info block.		stz	<tempRgn+1		Mark as	free cause I saved them.		stz	<rectRgn+1		jsr	getRectRgn		Allocate regions.		; Mensch 5/18/89 (Fixing BRC #48301)		lda	<zero		sta	>MenschTemp				lda	#hackEmpty		; (ORIG) Delete each icon in Trash.		jsr	walkOfLife3		; (ORIG)				bcs	@RealError		lda	>MenschTemp;;;		and	#$7FFF		asl a		lsr a		cmp	#$50		beq	@BusyError		clc		bra	@RealError@BusyError;;;		lda	#$50			;19-Feb-93 JCM - redundant - Acc = $50 from above;;;		sec				;19-Feb-93 JCM - carry is set on cmp #$50 as well		jsr	ProDOSErr		sec@RealError; end Mensch 5/18/89 (BRC #48301); NOTE:  two lines marked (ORIG) above would go here if rest of Mensch fix were not here		stz	cancelEmpty		bcc	ok10		inc	cancelEmpty		Tells me that the empty	was cancelled.ok10		lda	#dumpIcon		Cut all	the deleted icons from list.		jsr	walkOfLife3		jsr	freeRectRgn		jsr	startDraw		Erase the content region.		stz	<dRect+y1		stz	<dRect+x1		lda	#200		sta	<dRect+y2		lda	#640		sta	<dRect+x2		jsr	pushrect		_EraseRect		jsr	pushrect		_InvalRect		jsr	endDraw; --- Put Back every icon in Trash if empty was	cancelled --------------------		lda	cancelEmpty		beq	ok11		lda	<TrashWind		Switch to the Trash plane.		sta	<curWind		lda	<TrashWind+2		sta	<curWind+2		lda	#justSelect		jsr	walkOfLife		lda	ExtCopy			Save.		pha		pei	<filetype		jsr	putBack2		pla		sta	<filetype		pla				Restore.		sta	ExtCopyok11		lda	prefer		and	#PREF_SHOWDISK		bne	@updateAllWinds		ldy	#windView		update info bars on trash and everything		lda	[<windBlk],y		else.		cmp	#viewByName		bcs	skip10@updateAllWinds	jsr	clearWindDirty		jsr	setItems		New number of items.		pei	<TrashWind+2		pei	<TrashWind		_DrawInfoBarskip10		stz	C1_PathName		Update info bars for every window.		jsr	updateKs		Update info bars for all window	in path.		pla		sta	<tempRgn		pla		sta	<tempRgn+2		pla		sta	<rectRgn		pla		sta	<rectRgn+2		pla		sta	<icHand		pla		sta	<icHand+2		pla		sta	<curWind		pla		sta	<curWind+2		pla		sta	<windBlk		pla		sta	<windBlk+2		pla		sta	<TaskData		pla		sta	<TaskData+2		jsr	getwRefConexit		rts;----------------------------------------------justSelect	ldy	#icFlag		lda	[<ic],y		ora	#ICSELECTED		sta	[<ic],y		clc		rts;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!;	   Hack	Empty Trash;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!hackEmpty			ldy	#icFlag			Select icon.		lda	[<ic],y		ora	#ICSELECTED		sta	[<ic],y		lda	<ic		clc		adc	#icOwner		ldx	<ic+2		bcc	@nr		inx@nr		phx		pha		pushlong #c1_pathname		jsl	WStringCopy		pushZLong <icHand		;Pass handle of icon to delete.		pushlong #c1_pathname		;Pathname to extended icons		pea	EmptyFlag		ldx	#xDeleteFiles		jsl	FileEntry		ldy	#icFlag			Deselect icon.		lda	[<ic],y		and	#_ICSELECTED		sta	[<ic],y		rts				Carry flag set from xDeleteFiles.; ; Remove all deleted icons.;dumpIcon	ldy	#icFlag			Is the icon's delete flag set?		lda	[<ic],y		and	#ICDELETE		beq	exit65			If not,	don't delete.		ldy	#icFType		Is this	a folder?		lda	[<ic],y		cmp	#TypeFolder		bne	skip66		jsr	killKids2		Delete folder's windows/extended iconsskip66		jsr	wipeIcon		Cut icon out of	icon list add to redraw.exit65		clc				Continue flag.		rts		ENDP		; Do the new folder menu;.....................................................................NewFolderMenu	PROCNAME			IMPORT	info_store		IMPORT	OptionList		IMPORT	OptionBuff		IMPORT	GetTopLeft		IMPORT	NewUntitled		IMPORT	GetFileInfo		IMPORT	GetPrivileges		IMPORT	LenError		; From GSOS.aii  Mensch 5/15/89 fix		IMPORT	startHash		IMPORT	posFlag		IMPORT	windSpot		IMPORT	doAlertWindow		IMPORT	FolderColor		IMPORT	setInfo		IMPORT	SpotHashOn				jsr	noRename		;remove any rename field		lda	#$000F			;directory file type		sta	file_typelop20		jsr	deselectall		;deselect icons in the current plane		lda	#DirWindID		;directory window only.		jsr	getFrontWind		;wind = pointer to front most window		lda	<wind			;make front window the current plane		sta	<curWind		lda	<wind+2		sta	<curWind+2		jsr	getwRefCon		;windBlk = front window's info block		jsr	getWindPath		;C1_PathName = front window's pathname		PushLong #strgUntitled		PushLong #C1_TempPath		;C1_TempPath <-- 'UNTITLED'		jsl	PtoWString			PushLong #C1_TempPath		PushLong #C1_PathName		;C1_PathName <-- C1_PathName + 'UNTITLED'		jsl	PathAddName		bcc	lop23		jsr	lenError		bra	exit22lop23		lda	#$000D			;directory storage type		sta	storage_type		jsr	doCreate		;C1_PathName = path of folder to create.		ldy	#$0001			;set back to seedling storage type		sty	storage_type		bcc	ok20			;Was there an error on create?		cpx	#2			;Was a Try Again returned after error?		beq	lop23			;If yes, try to create the folder againnext20		cmp	#$0047			; duplicate pathname?		bne	exit22			; some unhandled error, just abort		jsr	NewUntitled		; if duplicate name, try another name		bcc	lop23			; try again		lda	#rasNoNames		jsl	doAlertWindow		; 'There are no more "UNTITLED" names...'		secexit22		rts; --- Folder created, make icon	------------------------------ok20		jsr 	startHash		; JAM 5/21/89				stz	posFlag			; don't use position buffer		jsr	WindSpot		stz	spotHashOn		lda	#$000F		sta	<filetype		lda	FolderColor		;Solid white background, black outline.		ora	#icSelected		sta	ticonobj+icFlag		PushLong #C1_PathName		; pass ptr to pathname/Untitled		PushLong #info_access		; pass ptr to access word		lda <zero		pha		pha				; skip file type		pha		pha				; skip aux type		PushLong #info_store		; skip storage type		PushLong #info_cdate		; pass ptr to create date		PushLong #info_mdate		; pass ptr to modify date		pha		pha				; skip byte count		pha		pha				; skip block count		PushLong #FileSysID		; pass ptr to file system ID (need OptionList)		jsl	GetFileInfo		stz	ticonobj+icFBlocks		stz	ticonobj+icFBlocks+2		stz	ticonobj+icFBytes		stz	ticonobj+icFBytes+2				ldy	#6dateLoop	lda	info_cdate,y		sta	ticonobj+icCDate,y		lda	info_mdate,y		; changed 06/29/88 DJB		sta	ticonobj+icMDate,y		dey		dey		bpl	dateLoop						stz	ticonobj+icFileInfo	; added 05/31/88 DJB		stz	auxtype		lda	<zero		ldx	info_store		cpx	#5		bne	@standard		lda	#$8000@standard	sta	ticonObj+icForked		lda	info_access		sta	ticonobj+icLocalAccess		and	#$0001			; check read enabled		beq	set1			; not set !		lda	#ICREADABLE>>16		; set our bitset1		sta	ticonobj+icFlag+2		lda	>OptionList-2		tax@loop		lda	>OptionList-2,x		sta	ticonobj+icOptionList,x		dex		dex		bpl	@loop				lda	ticonobj+icFST		cmp	#$0d		bne	@notNetwork		lda	ticonobj+icNetworkAccess		and	#$000F			; is user icon's owner (on network)		tsb	ticonobj+icFlag+2				lda	#ICASOWNER		; force "owner" folder icon		sta	auxtype		tsb	ticonobj+icFlag+2				lda	#ICNETWORK>>16		tsb	ticonobj+icFlag+2		bra	@wasNetwork@notNetwork	stz	ticonobj+icNetworkAccess		stz	ticonobj+icNetworkAccess+2@wasNetwork		jsr	findLastName				lda	#lastName		ldx	#lastName>>16		ldy	<zero			; add to head of icon list		jsr	addIconObj		; allocate and assign an ICONOBJ		bcc	@addOK		rts				;we're hosed if they got a memory error inside addIconObj			@addOK		jsr	lockic		ldy	#windDiskIc		;move our root icon in here		lda	[<windBlk],y		ldy	#icDisk		sta	[<ic],y		ldy	#windDiskIc+2		lda	[<windBlk],y		ldy	#icDisk+2		sta	[<ic],y		ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		bcc	ok25		PushZLong <ic		PushZLong <icHand		jsr	redrawText		; sort and draw view		PullLong <icHand		PullLong <ic		jsr	makeField		; give icon an edit field		bra	exit21ok25		jsr	startDraw		; draw new icon		jsr	drawIcon2		jsr	makeField		; give icon an edit field		jsr	endDrawexit21		jsr	unlockic		jsr	setItems		; update number of icons in window info bar		jsr	newDataSize3		; compute new data size for window		brl	updateKs		; update window info bars		ENDP; Do the Open menu;.....................................................................OpenMenu	PROC		jsr	noRename		Remove any rename field.		stz	nameHit			Clear hit on title flag	to stop	rename.				pei	<curWind+2		pei	<curWind				jsr	openAll			;open all the selected icons and exit		plx		ply		lda	<modifiers		and	#$0800		beq	@done						stx	<taskData		sty	<taskData+2		jsr	doClose@done		rts		ENDP; Do the Close menu;.....................................................................CloseMenu	PROC	 export		IMPORT	closeAllMenu		jsr	noRename		Remove any rename field.		lda	<modifiers		and	#$0800		beq	close1Window			brl	closeAllMenu		;if it's OPTION close, close everything;; close a single window -- this routine is called in a loop by CloseAllMenu;		EXPORT	close1Windowclose1Window			lda	#$FFFF			Any visible window.		jsr	getFrontWind		wind = pointer to top window.		beq	exit500			????Has	to be a	window up?????		lda	<wind			Pass pointer to	top window in TaskData.		sta	<TaskData		lda	<wind+2		sta	<TaskData+2		jsr	doClose			Close the top most window.exit500		rts				BEQ if no window, BNE if window	closed.		ENDP; Do the Icon Info menu;.....................................................................IconInfoMenu	PROC;; just in case, lets turn off the rename field when we bring this window up;		jsr noRename		stz	infoWindCount		;added 05/18/88 DJB		jsr	noRename		;Remove any rename field.		lda	#makeInfo		;Rountine to create info window.		brl	findSelect		;Create a 'Get Info' window for on icons.; Create a 'Get Info' window;; IN: ic = ptr to selected icon;.....................................................................makeInfo;; --- Bring info window	to the top if icon already has one -----------------;		ldy	#icInfo+1		;Does the icon have an info window?		lda	[<ic],y		beq	ok51		iny				;Pass pointer to window to select		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		brl	selectWind2		;Bring window to top and exit;; --- Create a New Information Window ---;ok51		IMPORT	NewInfoWindow		jsr	ckIfWind		; enough memory for a window?		bcs	error50			; no		jsr	buildPath3		;C1_PathName = icon's full pathname.		bcs	exit50			;Pathname error!		PushLong <icHand		PushLong #C1_PathName		jsl	NewInfoWindow		bcs	error50		inc	myWindCount		;Increment my window counterexit50		rtserror50		inc	abortFind		;Abort FindSelect		rts		ENDP*===============================================**	Do the Duplicate Menu			*		*===============================================*DuplicateMenu	PROC		IMPORT	OptionBuff		IMPORT	IsFSTUpperCase		IMPORT	GetVolumeInfo		IMPORT	GetDeviceName		IMPORT	doAlertWindow		lda	#mustBeSelect		Make sure there	is at least one		jsr	walkOfLife		selected icon in the list.		bcs	ok61		rtsok61		jsr	EmptyTrashMenu		jsr	noRename		Remove any rename field.;; Duplicate each selected icon;		stz	ExtCopy			Create normal icons.		lda	<curWind		Pass pointer to	window.		ldx	<curWind+2		jsr	getWindID		cmp	#DirWindID		Must be	a directory window.		beq	@ok;		lda	#rasCantDup;		jsl	doAlertWindow		rts				;Icons in the Trash and	desktop	cannt... 				      		;windBlk = pointer to window's info block.@ok		jsr	getHeadIcon		phx				Pass handle to first icon in list.		pha		jsr	getWindPath		C1_PathName = curWind's pathname.;; Duplicate the file by hook or by crook;		pea	C1_PathName>>16		Pass pointer to	destination pathname.		pea	C1_PathName		pea	makeDup>>16		pea	makeDup		ldx	#xDupFiles		jsl	FileEntry;; --- Finish drawing --------------------------------------;		ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		blt	@byIcon		jsr	redrawText@byIcon		jsr	setItems		New number of items.		jsr	newDataSize3		Compute	new data size for window.		brl	updateKs		Update window info bars.; Make a duplicate icon;.....................................................................makeDup		IMPORT	PStrToUpper		IMPORT	finderDPagesaveDbank	equ	1saveDpage	equ	saveDbank+1returnAddr	equ	saveDpage+2newName		equ	returnAddr+3		;Pointer to new file's name.duppedIc	equ	newName+4		;Handle of icon that was duplicated.		phd				;Save direct page.		phb				;Save data bank. 		phk				;Switch to my data bank.		plb		lda	finderDPage		;Switch to my direct page.		tcd		jsr	getwRefCon		;wind = curWind, windBlk = info block. 		lda	duppedIc,s		sta	<icHand		lda	duppedIc+2,s		sta	<icHand+2		jsr	setic			;ic = (icHand)		ldy	#icFType		;Same file type.		lda	[<ic],y		sta	<filetype		ldy	#icKind			;same kind		lda	[<ic],y		sta	ticonobj+icKind		iny		iny		lda	[<ic],y		sta	ticonobj+icKind+2				ldy	#icLocalAccess		lda	[<ic],y		sta	ticonobj+icLocalAccess				ldy	#icForked		lda	[<ic],y		sta	ticonobj+icForked				ldy	#icOptionList				lda	[<ic],y		tax		clc		adc	#icOptionList		;access is copied with the icon		tay@loop		lda	[<ic],y		sta	ticonobj+icOptionList,x		dey		dey		dex		dex		bpl	@loop		ldy	#icy			Same position, offset to the right.		lda	[<ic],y		clc		adc	#11			; was 0		sta	<yrat		iny		iny		lda	[<ic],y		clc		adc	#48			; was 106		sta	<xrat		ldy	#icFlag			Same color.		lda	[<ic],y		and	#$FF80			(Not selected.)		sta	ticonobj+icFlag		ldy	#icFlag+2		;added DJB 12/06/88		lda	[<ic],y		and	#(ICREADABLE+ICNETWORK)>>16		ora	#ICASOWNER		; JAM 5/21/89 (dups should be owned by user)		sta	ticonobj+icFlag+2		ldy	#icFBlocks		Give duplicate icon the	same sizeslop60		lda	[<ic],y			create and mod date and	time as	the		sta	ticonobj,y		original.		iny		iny		cpy	#icMDate+8		bcc	lop60		ldy	#icFileInfo		;Same FileInfo (added 05/29/88 DJB)		lda	[<ic],y		sta	auxtype		ldx	<fileType		cpx	#$0F			; is this the system folder kludge ?		bne	upper		cmp	#2		bne	upper		stz	auxtype			; yes so make it zero (only one allowed)		upper		lda	newName+2,s		;Pass pointer to icon's name.		tax		lda	newName,s		ldy	<zero			;add to head of icon list		jsr	addIconObj		;Create a new icon based on the old one		bcs	exit60			;hosed?  Us?  Nahh...;; --- Draw the new icon	--------------------------------------------------;		jsr	lockic		ldy	#windDiskIc		;move our root icon in here		lda	[<windBlk],y		ldy	#icDisk		sta	[<ic],y				ldy	#windDiskIc+2		lda	[<windBlk],y		ldy	#icDisk+2		sta	[<ic],y		jsr	unlockic		ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		bcs	exit60			Don't draw now if view by text.		jsr	lockic			Lock the new icon.		jsr	startDraw		jsr	drawIcon2		Draw the icon in its new state.		jsr	endDraw		jsr	unlockic		Leave new icon unlocked.exit60		plb				Restore	original data bank.		pld				Restore	original direct	page.		rtl;; Find first selected icon; mustBeSelect	ldy	#icFlag		lda	[<ic],y		and	#ICSELECTED		bne	@gotIt		clc				;This one not selected, keep looking.		rts@gotIt		sec				;Selected icon found, stop looking.		rts		ENDP; Do the Put Away menu;.....................................................................PutAwayMenu	PROCNAME				IMPORT	strSystem		IMPORT	WStrCompare		IMPORT	PStringCompare		IMPORT	C1_SystemName		IMPORT	C1_BootName		IMPORT	moveIconObj		IMPORT	WStringCopy		IMPORT	ClearDisk		IMPORT	Eject80		IMPORT	WipeIcon		import	SelectionIsChanging		import	writeRoot		import	getSmallRect		import	lockic		import	unlockic		import	zoomrect		import	smallrect		import	bigrect		import	ZoomDiskToTrash		import	setInfo		import	clearWindDirty		import	getWrefCon2		import	getwindpath		import	findowneric		import	CheckOpenFiles		jsl	SelectionIsChanging	;14-Jul-91 DAL		jsr	noRename		;Remove any rename field		ENTRY	putBack2		putBack2	lda	#putIconBack		jsr	findSelect		;Call for every selected icon		lda	#DirWindID		;Type of windows to accept		ldx	#redrawDirty		;redraw all the dirty windows		jsr	walkWindow;; Redraw Info bar if put back from Trash;		jsr	ifDesk		beq	exit70		lda	<TrashWind		Pass pointer of	window to update.		ldx	<TrashWind+2		jsr	setInfo2		Update Trash window's information bar.		lda	<TrashWind		08 Aug DanO pass pointer to window to update		ldx	<TrashWind+2		jsr	newDataSize		update trash window's scroll bars		ldy	#windView		If viewed by icons, then done.		lda	[<windBlk],y		cmp	#viewByName		bcc	exit70		jsr	redrawText		Sort and draw view.		jsr	newDataSize2				jsr	clearWindDirty		jsr	setInfoexit70		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Routine to move extended icons back home.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   ic =	pointer	to locked selected icon.;	   curWind = plane that	icon is	in.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =putIconBack		IMPORT	EjectNonRemovable				ldy	#icFtype		lda	[<ic],y		bpl	PutIconBack2				ldx	EjectNonRemovable		beq	@noEject		ldy	#icFtype		;see if it's a hard drive partition		lda	[<ic],y		cmp	#TypeHardPart		beq	@allowPutAway@noEject	ldy	#icDevInfo		;andy, 12/4/90, after borrowing jack's		lda	[<ic],y			;syquest removable		and	#$0004			;mask ejectable bit		beq	@noPutAway			@allowPutAway;; --- Save the pathname	of every open directory	on disk	----------------------;		jsr	writeRoot		Save the pathnames of all open windows.;; only unmount the disk if it didn't have any open files on it;		lda	<ic		clc		adc	#icName		tax		lda	<ic+2		adc	<zero		jsl	CheckOpenFiles		bcc	@noOpenFiles		ldy	#icFtype		;see if it's a hard drive partition		lda	[<ic],y		cmp	#TypeHardPart		beq	@noejectipoo		jsr	eject80		@noejectipoo	clc		rts@noOpenFiles	jsr	clearDisk		Remove disk's every window and ext icon.		jsr	eject80		jsr	ZoomDiskToTrash				jsr	getRectRgn		;Allocate regions.		jsr	WipeIcon		;Remove the extended icon's record.		jsr	redrawList		;Redraw the area where the icon was.@noPutAway	clc		rts;; put a regular icon back;		EXPORT	PutIconBack2PutIconBack2	ldy	#icFlag			Is this	icon an	extended icon?		lda	[<ic],y		and	#ICEXTENDED		bne	ok70			Only extended icons can	be put back.		clc		rts; --- Find window that icon belongs to -----------------------------------ok70		lda	<ic		clc		adc	#icOwner		ldx	<ic+2		bcc	@nr		inx@nr		phx		pha		PushLong #C1_TempPath		jsl	WStringCopy		lda	#DirWindID		Type of	windows	to accept.		ldx	#matchWindName		Match windows' pathname to C1_TempPath.		jsr	walkWindow		bcs	@ok			Was an owner window found?		brl	orphan70		; --- Add the icon to the window --------------------------------------;;  wind	= owner	window.;  windBlk = owner window's info block.;@ok		pei	<curWind+2		;Save current plane.		pei	<curWind		pei	<icHand+2		;Save handle of this icon.		pei	<icHand		lda	<wind			;Make owner window the current plane.		sta	<curWind		lda	<wind+2		sta	<curWind+2		stz	ExtCopy			;This will not be an extended icon.		ldy	#icOldPosY		;Same position as before.		lda	[<ic],y		sta	<yrat		iny		iny		lda	[<ic],y		sta	<xrat		ldy	#windFST		;manually fudge the FST value to be whatever the destination window		lda	[<windBlk],y		;is...		sta	ticonobj+icFST		jsr	pullFields		;Pull common icon fields to be used by the new icon;; see if it's the system folder we're puttin' back;		lda	<filetype		cmp	#$0f		bne	@notSystem				jsr	geticNamePtr		;A and X = pointer to icon's name.		pha		pushZLong <temp		pushlong #strSystem		jsl	PStringCompare		pla		beq	@notSystem		pha				;space for result		PushLong #C1_TempPath		PushLong #C1_BootName		jsl	WStrCompare		;is this the boot disk ?		pla		beq	@notSYSTEM		;no				lda	#$0002			;yes, so mark system folder		sta	auxtype;; now that everything's square, add the new icon;@notSYSTEM		jsr	geticNamePtr		;A and X = pointer to icon's name.		ldy	<zero			;add to head of list		jsr	addIconObj		;move old icon obj to the window.		bcc	@addOK		brl	redrawDirty		;oh, we are toast now boy		@addOK		jsr	lockic			;Lock the new icon for drawing.		ldy	#windDiskIc		;move our root icon in here		lda	[<windBlk],y		ldy	#icDisk		sta	[<ic],y				ldy	#windDiskIc+2		lda	[<windBlk],y		ldy	#icDisk+2		sta	[<ic],y		ldy	#windDirty		lda	#$8000		ora	[<windBlk],y		sta	[<windBlk],y		jsr	getRectRgn		Allocate regions.		jsr	addIconRgn		Add the	new icon's area to redraw region.		jsr	redrawList		Redraw the new icon.ok73		jsr	unlockic		Leave the new icon unlocked.		pla				Restore	current	icon.		sta	<icHand		pla		sta	<icHand+2		pla		sta	<curWind		pla		sta	<curWind+2		jsr	lockic; --- Remove the extended icon ----------------------------------------orphan70	ldy	#icWind		lda	[<ic],y		sta	iconWindow		iny		iny		lda	[<ic],y		sta	iconWindow+2					jsr	getwRefCon		Get this window's info block again.		ldy	#windView		Viewed by icon or text?		lda	[<windBlk],y		cmp	#viewByName		bcc	ok71			Special	case view by text, redraw later.		jsr	cutOutIcon		Remove the extended icon's record.		bra	connectWindowok71		jsr	getRectRgn		Allocate regions.		jsr	addIconRgn		Add the	extended icon's area to region.		jsr	cutOutIcon		Remove the extended icon's record.		jsr	redrawList		Redraw the area	where the icon was.connectWindow	lda	iconWindow+1		beq	@done		ldx	iconWindow+2		lda	iconWindow		jsr	GetWRefCon2				jsr	GetWindPath				jsr	findOwnerIC				ldx	iconWindow+2		lda	iconWindow		jsr	GetWRefCon2		ldy	#windIc		lda	<icHand		sta	[<windBlk],y		iny		iny		lda	<icHand+2		sta	[<windBlk],y		@done		clc		rts;; called by WalkWindow;redrawDirty	ldy	#windDirty		;clear windDirty		lda	[<windBlk],y		tax;;;		and	#$7fff		asl a		lsr a		sta	[<windBlk],y		txa		bpl	@done		jsr	setInfo			;Update the destination window's info bar.		jsr	newDataSize2		;update destination window's scroll bars		ldy	#windView		;Viewed by icons or text?		lda	[<windBlk],y				cmp	#viewByName		;if by icon, already done, if by text then		bcc	@done			;sort and redraw ONCE		jsr	redrawText		;Sort and draw view.@done		clc		rts;; locals;iconWindow	dc.L	0			ENDP*===============================================**	Do the Eject Menu			*		*===============================================*EjectMenu	PROCNAME			IMPORT	EjectDisk		IMPORT	CheckOpenFiles		IMPORT	EjectNonRemovable				lda	#eject80		Routine	to call	for every selected icon.		jsr	findSelectexit85		rts;===============================================		EXPORT	Eject80eject80				lda	<ic		clc		adc	#icName		tax		lda	<ic+2		adc	<zero		jsl	CheckOpenFiles		bcc	@noOpenFiles		ldy	#icFtype		lda	[<ic],y		cmp	#typeServer		;don't allow server partitions with open fioles to be ejected!		beq	exit80		cmp	#typeHardPart		;don't allow HD partitions with open files to be ejected!		beq	exit80		@noOpenFiles	ldx	EjectNonRemovable		beq	@noEject		ldy	#icFtype		;see if it's a hard drive partition		lda	[<ic],y		cmp	#TypeHardPart		beq	@allowEject@noEject	ldy	#icDevInfo		;andy, 12/4/90, after borrowing jack's		lda	[<ic],y			;syquest removable		and	#$0004			;mask ejectable bit		beq	exit80			@allowEject	ldy	#icDevNum		lda	[<ic],y		beq	exit80			Already	ejected!		pha		jsl	EjectDisk		; say goodbyeexit80		clc				Continue flag.		rts		ENDP*===============================================**	Do the Edit Menus			*		*===============================================*EditMenus	PROC		sec		sbc	#idUndo		rts		ENDP*===============================================**	Do the Select All Menus			*		*===============================================*SelectAllMenu	PROCNAME				IMPORT	SelectionIsChanging				jsl	SelectionIsChanging			jsr	noRename		Remove any rename field.		lda	#$FFFF			Take anything.		jsr	getFrontWind		tax				Desktop?		beq	ok140		and	#DirWindID+TrashWindID;;;		beq	exit140			------ Should never happen ----		beq SelAllMaybeTextEdit		;windID is in Xok140		lda	<wind			New current plane?		ldx	<wind+2		cmp	<curWind		bne	new140		cpx	<curWind+2		beq	same140new140		phx				Save new plane.		pha		jsr	deselectall		Deselect current plane.		pla		plx		sta	<curWind		New current plane.		stx	<curWind+2same140		jsr	startDraw		Set the	port's origin again.		lda	#select140		jsr	walkBack		brl	endDrawselect140	ldy	#icFlag		lda	[<ic],y			;Is the icon already selected?		and	#ICSELECTED		bne	exit140		lda	[<ic],y		ora	#ICSELECTED		;Set selected flag.		sta	[<ic],y		jsr	drawIcon2		;Redraw icon in its new state.exit140		clc				;Continue flag.		rtsSelAllMaybeTextEdit		txa		and #infoWindID		bne @selAllinfoWindow		txa		and #helpWindID		bne @selAllHelpWindow		clc		rts@selAllHelpWindow		lda <zero		pha		pha	;pushed $00000000 = selStart		dec a		pha		pha	;pushed $ffffffff = selEnd		pha		pha	;space for GetCtlHandleFromID		pha		pha		_FrontWindow	;window for GetCtlHandleFromID		pei <zero		pea 2	;ctl ID of Text Edit control		_GetCtlHandleFromID		_TESetSelection		clc		rts@selAllInfoWindow		pha		pha	;space for GetCtlHandleFromID		pha		pha		_FrontWindow		pei <zero		pea $E	;ctl ID of Text Edit control (OR simple button!)		_GetCtlHandleFromID		pla		sta <handle		pla		sta <handle+2		ldy #2		lda [<handle],y		sta <ptr+2		lda [<handle]		sta <ptr		ldy #$0016	;offset to high word of ctlProc		lda [<ptr],y		cmp #$8500		bne @notTE		ldy #$0010	;offset to ctlFlag (bit 7 = invisible)		lda [<ptr],y		and #$0080		bne @teInvisible		lda <zero		pha		pha		dec a		pha		pha		pei <handle+2		pei <handle		_TESetSelection@teInvisible@notTE		clc		rts		ENDP; do the show clipboard menu;.....................................................................ShowClipMenu	PROCNAME export*** Rewritten 19-Aug-92 DAL to use ShowClipboard in the Scrap Manager;		import	GetBigRect;		import	SetSmallRect;		import	zoomrect		import	RectListPtr				jsr	noRename		;Remove any rename field.;*** Thanks, Dave (4-Sep-91);		pha;		pei	<clipWind+2;		pei	<clipWind;		_GetWFrame;		pla;		and	#$0020			;fVis;		bne	@alreadyVis;*** You're welcome, Andy;;		jsr	SetSmallRect;		;		lda	<clipWind		;Pass window to check.;		ldx	<clipWind+2;		jsr	GetBigRect;;		lda	#1			;zoom out;		jsr	ZoomRect;;@alreadyVis	lda	<clipWind		;Pass window to check.;		ldx	<clipWind+2;		brl	wind2top		pha		pha		pea $8000			;flags = open		clc		lda >rectListPtr		adc #88+6+2		tax		lda >rectListPtr+2		adc #0		pha		phx				;rectangle pointer;		_ShowClipboard		ldx #$1516		jsl $e10000		pla		pla	;window pointer (ignore)		rts		ENDP; stack the windows (cool man, we get the move everything around!);.....................................................................StackWindows	PROCNAME			IMPORT	walkWindow		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	watchCursor		jsl	saveCursor		jsl	watchCursor					stz	stackCount		lda	#4		sta	dx		sta	firstX		lda	#38		sta	firstY		sta	dy		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#walkToFirst		;walk to first window		jsr	walkWindow		;we don't want opened sys windows		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#walkToEnd		;walk all the way		jsr	walkWindow		;we don't want opened sys windows@loop		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#walkToLast			jsr	walkWindow		;we don't want opened sys windows				pha		pha		pushZLong <wind			_GetWRefCon		pla		sta	<temp		pla		sta	<temp+2				ldy	#windID		lda	[<temp],y		and	#TrashWindID+DirWindID		bne	@HasInfoBar				lda	dy		sec		sbc	#10		tax		bra	@notList		@HasInfoBar	ldx	dy				ldy	#windView		lda	[<temp],y		cmp	#viewByName		blt	@notList			lda	prefer			;if 'show disk info' is on		and	#PREF_SHOWDISK		beq	@notList				txa		clc			adc	#12		tax		@notList	lda	dx			;x		pha				;y		phx		pushZLong <wind		_MoveWindow				inc	stackCount				lda	stackCount		cmp	#10		blt	@next			stz 	stackCount				lda	firstY		clc		adc	#6		sta	dy		sta	firstY				lda	firstX		clc		adc	#40		sta	firstX		sta	dx		bra	@nextWindow		@next		lda	dx		clc		adc	#20		sta	dx		lda	dy		clc		adc	#12		sta	dy		@nextWindow	lda	<wind			;is the window that we've reached		cmp	first			;the one we knew to be in front of		bne	@goLoop			;the rest when we started?		lda	<wind+2		cmp	first+2		beq	@done@goLoop		brl	@loop			;if not, then loop@done		jsl	restoreCursor				rts			;; walkToFirst -- walk to the end of the window list and mark that window as the last;walkToFirst		lda	<wind		sta	first		lda	<wind+2		sta	first+2		sec			;stop at first window		rts;; walkToEnd -- walk to the end of the window list and mark that window as the last;walkToEnd		lda	<wind		sta	last		lda	<wind+2		sta	last+2			clc			;keep going		rts		;; walkToLast -- walk until we see that we're at the last window;walkToLast		lda	<wind		;is this window the one we knew to be the		cmp	last		;last one?		bne	@notLast		lda	<wind+2		cmp	last+2		bne	@notLast				lda	previous	;now, make sure we'll back up next time		sta	last		;through...		lda	previous+2		sta	last+2				sec		rts@notLast	lda	<wind		;it's not the last, so mark window as the		sta	previous	;previous window		lda	<wind+2		sta	previous+2						clc				;keep going		rts;; locals;	first		dc.L	0		;first window (wind ptr) we encounteredlast		dc.L	0		;last window (wind ptr)previous	dc.L	0		;window before the last (wind ptr)stackCount	dc.w	0		;number of windows we've stackedfirstX		dc.w	0		;first X coordinate for the current stackfirstY		dc.w	0		;first Y coordinate for the current stackdx		dc.w	0		;amount to offset X bydy		dc.w	0		;amount to offset Y by		ENDP; PickAWindow, they selected the menu item for a window in the windows menu,; so we have to walk the directory windows list looking for a window which; matches the menu item ID the user selected.  Then, bring the window to the; front with _SelectWindow and re-order the windows menu if it says it needs; to be re-ordered front-to-back;; IN: (A) contains the menu item for which we are looking for a match;.....................................................................		EXPORT	PickAWindowPickAWindow	PROCNAME		IMPORT	ListBy		IMPORT	matchedFirst		IMPORT	walkWindow		IMPORT	matchFirst		IMPORT	matchSecond				sta	ourWindow				stz	matchedFirst		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#matchFirst		;don't check for anything, match the first open dir window		jsr	walkWindow		;we don't want opened sys windows		lda	matchedFirst		;did we match for the first window?		bne	@haveSomeWindows		rts@haveSomeWindows				ldy	#windMenuItem		;check to see that if we already are the in-front window				lda	[<windBlk],y		cmp	ourWindow		bne	@goingToFront				pushZLong <wind			;if we already are in front, move it anyway to put it in front		_SelectWindow			;of DAs		rts		@goingToFront	stz	matchedFirst		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#matchWindByID		;don't check for anything, match the first open window		jsr	walkWindow				pushZLong <wind		_SelectWindow				lda	ListBy			;if it's done alphabetically, don't bother doing squat		bne	@alpha				lda	ourWindow		pha		_DeleteMItem				lda	<windBlk		;where our title is (and will stay put)		clc		adc	#windMenuText		sta	insertItemRef+10		lda	<windBlk+2		adc	<zero		sta	insertItemRef+12				pei <zero			;refIsPtr		pushlong #insertItemRef		pea	idWindowsDivider	;insert after		pea	idWindowsMenu		;insert into		_InsertMItem2				pei <zero			;fix the windows menu's size since we lost a menu item		pei <zero		pea	idWindowsMenu		_CalcMenuSize@alpha		rts		;; our window finder;;   IN:	   wind	= window to compare.;matchWindByID	jsr	windRefCon		;windBlk = window's info block pointer.		ldy	#windMenuItem		;is it our window?		lda	[<windBlk],y		cmp	ourWindow		beq	@gotit			;exit with our window pointer in <wind		clc		rts@gotit		sec		rts		EXPORT	ListByListBy		dc.w	1			;default listBy parameterinsertItemRef	dc.w	0			;versionourWindow	dc.w	$f000			;itemID		dc.w	0			;no keystroke characters		dc.w	0			;no item check characters		dc.w	0			;item flag (refIsPtr)		dc.L	0			;title ref string (pstr); CloseAWindow, they selected the menu item for a window in the windows menu,; and just our luck -- they happened to be holding down option when they did it;; so we have to walk the directory windows list looking for a window which; matches the menu item ID the user selected.  Then, close the window; re-order the windows menu if it says it needs to be re-ordered front-to-back;; IN: (A) contains the menu item for which we are looking for a match;.....................................................................		EXPORT	CloseAWindowCloseAWindow	NAME		sta	ourWindow					stz	matchedFirst				lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#matchWindByID		;don't check for anything, match OUR open window		jsr	walkWindow		ldy	#windMenuItem		;check to see that if we already are the in-front window				lda	[<windBlk],y		pei <zero			;uncheck the prior first window (if we were the first window)		pha		_CheckMItem		lda	<wind		sta	<taskData		lda	<wind+2		sta	<taskData+2		jsr	doClose		stz	matchedFirst		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#matchFirst		;don't check for anything, match the first open dir window		jsr	walkWindow		;we don't want opened sys windows		ldy	#windMenuItem		;check to see that if we already are the in-front window				lda	[<windBlk],y		pea	$FFFF			;put a checkmark beside what we just moved to front		lda	ourWindow		;in case we actually made someone else cometofront		pha		_CheckMItem		rts		ENDP		; do the view menus;.....................................................................ViewMenus	PROCNAME EXPORT		IMPORT	resizeInfoBar		IMPORT	infoSizes		IMPORT	contentRECT		IMPORT	CurView		IMPORT	SaveCursor		IMPORT	RestoreCursor		IMPORT	WatchCursor				sec		sbc	#idByIcon				sta	<work				jsl	SaveCursor		jsl	WatchCursor				jsr	noRename		;Remove any rename field.		lda	<TaskData		;Pass selected item's ID.		jsr	newView		lda	#DirWindID+TrashWindID	;Accept directory or Trash window.		jsr	getFrontWind		bne	@ok		brl	@done			;---- Should never happen ------@ok		jsr	windRefCon		;windBlk = window's info block.		ldy	#windView		;Set window's view.		lda	[<windBlk],y		;Get old view for later.		sta	oldViewBy		lda	<work			;Set new view.		sta	[<windBlk],y		sta	newViewBy		stz	drawInfoFlag		;we had the double-height info bar setup		lda	#1		sta	resize			;worry...		lda	prefer			;first, if we don't have anything double-height,		and	#PREF_SHOWDISK		;then don't worry about anything at all		beq	@noResize		lda	oldViewBy		cmp	#viewByName		blt	@largeGoingTo				lda	newViewBy		;only resize if they changed from list -> icon		cmp	#viewByName		;or icon -> list view		blt	@resizeDown		bra	@noResize		@largeGoingTo	lda	newViewBy				cmp	#viewByName		bge	@resize		bra	@noResize		@resizeDown	dec	resize		@resize				lda	resize		jsr	resizeInfoBar						inc	drawInfoFlag		@noResize	pei	<wind+2			;Pass window pointer.		pei	<wind		_StartDrawing			;Setup window for drawing.		jsr	sort			;Sort files by window's view.		pea	screen2>>16		;Force redraw of window.		pea	screen2		_EraseRect		pea	screen2>>16		;Force redraw of window.		pea	screen2		_InvalRect		jsr	endDraw		lda	oldViewBy		cmp	#2			;Was the old view by icon?		bcs	@redraw			;If not, don't reset origin.		lda	newViewBy		cmp	#2			;Is the new view by text?		bcc	@redraw			;If not, don't reset origin.		lda	<zero			;Set window's origin to 0,0 when view is		pha				;changed from icon to text.		pha		pei	<wind+2			;Pass window to change.		pei	<wind		_SetContentOrigin@redraw		jsr	newDataSize2		;Recompute window's data size.		lda	drawInfoFlag		bne	@done				ldy	#windDirty		;mark it as a dirty old window		lda	[<windBlk],y		ora	#$8000		sta	[<windBlk],y				jsr	setInfo			;Redraw info bar.@done		jsl	RestoreCursor		rts;-----------------------------------------------;; IN:	wind = pointer to window;	windBlk = pointer to window's info block;;-----------------------------------------------		EXPORT	redrawTextredrawText				pei	<wind+2			Pass window pointer.		pei	<wind		_StartDrawing			Setup window for drawing.		jsr	sort			Sort files by window's view.		pea	screen2>>16		Force redraw of	window.		pea	screen2		_EraseRect		pea	screen2>>16		Force redraw of	window.		pea	screen2		_InvalRect		brl	endDraw		;-----------------------------------------------		EXPORT	newViewnewView		pea	$FF			Check flag.		pha				New view, to be	checked.		pei <zero			Uncheck	flag.		ldx	curView			;Old view, to be unchecked.		phx		sta	curView			Remember new view.		_CheckMItem			Uncheck	the the	old view.		_CheckMItem			Check the new view.		rts;; locals;resize		dc.w	0drawInfoFlag	dc.w	0			;booleanoldViewBy	dc.w	0newViewBy	dc.w	0		ENDP*===============================================**	Do the Clean Up Menu			*		*===============================================*CleanUpByNameMenu PROCNAME		import	OfflineMasks		import	OnlineMasks		import	GetVisRECT				lda	#$FFFF		sta	CleanUpByNameFlag		bra	ByName		EXPORT CleanUpMenuCleanUpMenu	NAME			stz	CleanUpByNameFlagByName		jsr	noRename		Remove any rename field.		lda	#$FFFF			Take any window	on top.		jsr	getFrontWind		Get the	front most window.		sta	onDesktop		tax				Desktop	is OK.		beq	@ok		and	#DirWindID+TrashWindID	Directory or Trash is OK.		bne	@ok		brl	exit170@ok				ldy	#windView		;check to see if the window's view is by icon or small icon, which		lda	[<windBlk],y		;are the only two views which can be cleaned up normally or by name.		cmp	#viewByName		;this check is needed because it's possible to be cruel and hold down		blt	@cleanUpOK		;the option key and then change views, etc.		rts@cleanUpOK		;; Continue cleaning up...;		pei	<curWind+2		Save current plane.		pei	<curWind		lda	<wind			Switch to front	most window plane.		sta	<curWind		lda	<wind+2		sta	<curWind+2;; now, check if the modifiers bit for the option key is set, and if it is, sort by name, then run; through the icon list and re-assign everyone's icx and icy coordinates.;		lda	onDesktop		;if this is on the desktop, we don't do "cleanup all" (yet)		beq	@doNormal		lda	CleanUpByNameFlag		bmi	@byName@doNormal	brl	normalCleanup@byName		jsl	WatchCursor				pei	<wind+2			Pass window pointer.		pei	<wind		_StartDrawing			Setup window for drawing.		lda	#$FFFF		sta	row		stz	rowbits		stz	rowbits+2		ldy	#20			;magic offset to window's portrect Y2		lda	[<wind],y		sec		ldy	#16			;magic offset to window's portrect Y1		sbc	[<wind],y		sta	bottom				ldy	#22			;magic offset to window's portrect X2		lda	[<wind],y		sec		ldy	#18			;magic offset to window's portrect X1		sbc	[<wind],y		sta	right		ldy	#windView		lda	[<windBlk],y		pha				lda	#viewByName		sta	[<windBlk],y		jsr	sort			Sort files by window's view.		pla		ldy	#windView		sta	[<windBlk],y		stz	positioned		lda	#10			;defaults 		sta	iconPos+y1				lda	#52+14		sta	iconPos+x1		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		bne	@notBySmall		lda	#-10			;defaults in case they don't have a finder.data		sta	iconPos+y1		;file		lda	#14		sta	iconPos+x1@notBySmall						lda	#cleanupByName		jsr	walkOfLife		pea	screen2>>16		;Force redraw of window.		pea	screen2		_EraseRect		pea	screen2>>16		;Force redraw of window.		pea	screen2		_InvalRect		jsr	endDraw		pei <zero			;reset the window to 0,0		pei <zero		pushZLong <wind		_SetContentOrigin		jsr	newDataSize2		Recompute window's data size.		jsl	ArrowCursor		pla				Restore	original plane.		sta	<curWind		pla		sta	<curWind+2		rts;; routine called by walkOfLife to quickly reposition all the icons in a window;cleanupByName	ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		bge	@bySmallIcon		brl	@byLargeIcon@bySmallIcon	@nextRow	inc	row				lda	row		cmp	#64			;extra protection just in case		bge	@newColumn				lda	iconPos+y1		clc		adc	#10		sta	iconPos+y1		tax		ldy	#windItems		lda	[<windBlk],y		cmp	#500		bge	@inWindow1				txa				clc		adc	#10		cmp	bottom		bcc	@inWindow1		@newColumn	stz	row		stz	iconPos+y1		lda	iconPos+x1		clc		adc	#150		sta	iconPos+x1				@inWindow1	lda	row			;divide the row by 8 to use as an index		lsr	a		lsr	a		lsr	a		tay		lda	row		and	#$7		tax				sep	#$20		LONGA OFF				lda	rowbits,y		;find out if the last row intruded here		and	>OnlineMasks,x				pha		lda	rowbits,y		;and reset the intrusion indicator		and	>OfflineMasks,x		sta	rowbits,y		pla						LONGA ON		rep	#$20			;if the last row to the left intruded into this column,		bne	@nextRow		;then we need to try the next row down				pha				;now that we placed the icon, see if the name makes the		lda	#icName			;icon intrude in the next column		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx		_StringWidth		pla		cmp	#128		blt	@inWindow				lda	row			;divide the row by 8 to use as an index		lsr	a		lsr	a		lsr	a		tay		lda	row		and	#$7		tax				sep	#$20		LONGA OFF				lda	rowbits,y		ora	>OnlineMasks,x			sta	rowbits,y				LONGA ON		rep	#$20		bra	@inWindow;; cleanup by large icon;@byLargeIcon	lda	positioned		bne	@position		inc	positioned		bra	@inWindow		@position	lda	iconPos+x1		;look to the right		clc		adc	#106		sta	iconPos+x1		tax				;if we've got a lot of items, try really hard not to grid them		ldy	#windItems		;wrong		lda	[<windBlk],y		cmp	#500		blt	@realRight						cpx	#1000		bcc	@inWindow		bge	@atLeft@realRight	txa		cmp	right			;off right of window?		bcc	@inWindow			@atLeft		lda	#52+14			;Start again on left side if so		sta	iconPos+x1		lda	iconPos+y1		;next row down.		clc		adc	#32					sta	iconPos+y1		@inWindow	lda	iconPos+y1		clc		adc	#10		ldy	#icy		sta	[<ic],y		lda	iconPos+x1		ldy	#icx		sta	[<ic],y		ldy	#icFlag			;deselect the icon		lda	[<ic],y		and	#$FFFF-icSelected		sta	[<ic],y		clc		rts;; locals for cleanupByName;row		dc.w	0rowbits		ds.b	8bottom		dc.w	0right		dc.w	0CleanUpByNameFlag dc.w	0onDesktop	dc.w	0positioned	dc.w	0iconPos		dc.w	0		dc.w	0;; cleanup the normal way;normalCleanup	jsl	WatchCursor		jsr	startDraw		ldx	#4			Index for desktop, just	in case.		ldy	#windID		lda	[<windBlk],y		beq	enter172		Cleaning up the	desktop?		ldy	#windView		Index for window.		lda	[<windBlk],y		asl	a		tax				0 for large icons, 2 for small icons.enter172	lda	startGridys,x		Initialize clean-up parameters.		sta	startGridy		lda	nextGridys,x		sta	nextGridy		lda	adjustGridys,x		sta	adjustGridy		lda	startGridxs,x		sta	startGridx		lda	nextGridxs,x		sta	nextGridx		lda	adjustGridxs,x		sta	adjustGridx		lda	maxYgrids,x		sta	maxYgrid		stz	wrap			Clear wrap counter.;; get the visRgn for the window which is going to be cleaned up; so that while we are cleaning up, we can check to see if we should; draw the icon being moved or not (because, if the icon isn't visible,; it's dumb to draw it);		jsr	GetVisRECT		;; now that we have the visRgn's boundsrect, continue cleaning up;		lda	#cleanup		For each icon, do clean-up.		jsr	walkOfLife		jsr	endDraw		jsr	newDataSize2		Compute	new data size for window.		jsl	arrowCursor		pla				Restore	original plane.		sta	<curWind		pla		sta	<curWind+2exit170		rts; = = =	= = = =	= = = =	= = = =	= = = =;	   Place icon's on grid.; = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   ic =	pointer	to icon	to clean-up.;	   startGrid = minimum grid coordinates.;	   nextGrid = amounts between grids.;	   windBlk = pointer to	window's info block.;; = = =	= = = =	= = = =	= = = =	= = = =		import	UnlockICBLKHAND		;22-Mar-93 JCMcleanup		pei	<direction		lda	tocall+1		pha		lda	<icHand		sta	saveIc		lda	<icHand+2		sta	saveIc+2		lda	wrap			Did I already wrap?		bmi	next170		lda	#1			Start wrap counter over.		sta	wrap; --- Find closest Y grid ------------------------------------------		lda	startgridy		ldy	#icy		bra	enter170lop170		lda	gridy		clc		adc	nextGridyenter170	sta	gridy		lda	[<ic],y		cmp	gridy		bcs	lop170; --- Find closest X grid ------------------------------------------		lda	startGridx		ldy	#icx		bra	enter171lop171		lda	gridx		clc		adc	nextGridx		cmp	#630		bcs	done171enter171	sta	gridx		lda	[<ic],y		cmp	gridx		bcs	lop171done171; --- Compute grid coordinate (centers on a grid coordinate) -------------lop174		lda	gridy		sec		sbc	adjustGridy		sta	gridy		lda	gridx		sec		sbc	adjustGridx		sta	gridx; --- Check if some other icon is on that grid ---------------------------;; gridy, gridx = closest grid coordinate.;lop172		lda	wrap			Is special 'no check icon' flag	set?		bmi	gotit170		lda	#ckGrid			Check every icon.		jsr	walkOfLife		bcc	gotit170; ------ Check next grid coordinate (moving left to right and down) ---------next170		lda	gridx			Check coordinate to right.		clc		adc	nextGridx		sta	gridx		ldy	#22			;magic offset to window's portrect X2		cmp	[<wind],y		;too far?		bcc	lop172		lda	startGridx		Start again on the left	side,		sec		sbc	adjustGridx		sta	gridx		lda	gridy			and move down one grid line.		clc		adc	nextGridy		sta	gridy		cmp	maxYgrid		bcc	lop172						; This only happens on desktop.		lda	startgridy		Start over at top.		sta	gridy		dec	wrap			Second time through here for this icon?		bpl	lop172		lda	#36			Start over at top.		sta	gridy		lda	startGridx		sta	gridx		bra	lop174gotit170	lda	saveIc		sta	<icHand		lda	saveIc+2		sta	<icHand+2		jsr	lockic; --- Move icon	to new position	-----------------------------------------------		ldy	#icy			Compute	the deltas.		lda	gridy		sec		sbc	[<ic],y		sta	deltay2		iny		iny		lda	gridx		sec		sbc	[<ic],y		sta	deltax2		ora	deltay2		bne	@checkVis		brl	skip171;; first, check the top and bottom to see if we should be drawing or not; based on our visrgn;		@checkVis			ldy	#windView		lda	[<windBlk],y		beq	@viewByIcon		cmp	#1		beq	@viewBySmall		brl	@continue		;if it's not by icon or small icon, split!@viewByIcon	jsr 	getIconPtr*** Scrunched - 21-Mar-93 JCM;;;		ldy	#4			;unlock icon, no need to lock it;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y				jsr	UnlockICBLKHAND		*** End - 21-Mar-93 JCM		;; check to see if the icon -currently- is or isn't in our visRgn, because; if it currently is, then we need to show it immediately;		ldy 	#icy		lda 	[<ic],y		clc		adc	#TITLE_H		cmp	<visRECT+y1		bmi	@fastExit				sec		ldy	#imHeight		sbc	[<icon],y		sec		sbc	#TITLE_H		cmp 	<visRECT+y2		beq	@continue		bmi 	@continue;; then, check to see if the icon isn't going to be moved into our visRgn,; because if it is, then we need to show it immediately;		lda 	gridy		clc		adc	#TITLE_H		cmp	<visRECT+y1		bmi	@fastExit				sec		ldy	#imHeight		sbc	[<icon],y		sec		sbc	#TITLE_H		cmp 	<visRECT+y2		beq	@continue		bmi 	@continue@fastExit	ldy	#icy		lda	gridy		sta	[<ic],y		iny		iny		lda	gridx		sta	[<ic],y		brl	skip171;; viewBySmall -- clip to vis for view By Small Icon;@viewBySmall		ldy 	#icy		lda 	[<ic],y		clc		adc	#TITLE_H		cmp	<visRECT+y1		bmi	@fastExit		;		sec;		ldy	#imHeight;		sbc	[<icon],y		sec		sbc	#15		;used to be TITLE_H, but wasn't big enough		cmp 	<visRECT+y2		beq	@continue		bmi 	@continue;; now, we need to check if this icon is about to appear in our; visRgn, and if it is, then show it moving into our visRgn;		lda 	gridy		clc		adc	#TITLE_H		cmp	<visRECT+y1		bmi	@fastExit		;		sec;		ldy	#imHeight;		sbc	[<icon],y		sec		sbc	#15		;used to be TITLE_H, but wasn't big enough		cmp 	<visRECT+y2		bne	@fastExit		bpl	@fastExit;; end of vertical vis Clipping stuff;@continue	jsr	getRectRgn		Allocate rectRgn and tempRgn.		jsr	addIconRgn		Make rectRgn = icon's area.		jsr	offsetRgn		rectRgn	= old rectRgn +	new rectRgn.		ldx	#x2lop173		lda	<irect1,x		sta	smallRect,x		sta	bigRect,x		dex		dex		bpl	lop173		pea	bigRect>>16		pea	bigRect		lda	deltax2		pha		lda	deltay2		pha		_OffsetRect;		ldx	#1			Use current port.;		txa				Zoom from small	to big.;		jsr	zoomRect2		jsr	zoomRectNoSound		;21-Apr-91 DAL		ldy	#icy		lda	gridy		sta	[<ic],y		iny		iny		lda	gridx		sta	[<ic],y		pei	<rectRgn+2		Redraw just what's needed.		pei	<rectRgn		_SetClip*** added 12-Dec-91 DAL*** If this is the desktop and we have a picture, do a PPToPort instead of an EraseRect		import ScreenHandle,ScreenLocInfo,HandleToPointer,UnlockHandle		import ScreenRect,ScreenImage		lda	<curWind+1		cmp	<deskPort+1		bne	@justErase		lda	ScreenHandle+1		beq	@justErase		pha		pha		PushLong ScreenHandle		jsl	HandleToPointer		PullLong ScreenImage		; get pointer to desktop picture						PushLong #ScreenLocInfo		; LocInfo record		PushLong #ScreenRect		; enclosing rect		ldx <zero		phx				; X coordinate		phx				; Y coordinate		phx				; penmode		_PPToPort			; draw the picture				PushLong ScreenHandle		jsl	UnlockHandle		; unlock it		bra	@didBackground*** end 12-Dec-91@justErase	pei	<rectRgn+2		pei	<rectRgn		_EraseRgn@didBackground;		jsr	drawIcon2				lda	#drawIcon2		jsr	walkback2		pea	screen2>>16		Set clip to full screen.		pea	screen2		_ClipRect		jsr	freeRectRgnskip171		pla		sta	tocall+1		pla		sta	<direction		lda	saveIc		sta	<icHand		lda	saveIc+2		sta	<icHand+2		jsr	unlockic		;6/13/91, andy		clc				Continue flag.		rtsgridy		DS.B	2startGridy	DS.B	2nextGridy	DS.B	2adjustGridy	DS.B	2maxYgrid	DS.B	2gridx		DS.B	2startGridx	DS.B	2nextGridx	DS.B	2adjustGridx	DS.B	2saveIc		DS.B	4startGridys	DC.W	35			;Large icons.		DC.W	15			;Small icons.		DC.W	46+8			;Desktop icons.	changed - DJB 08/03/88nextGridys	DC.W	32		DC.W	10		DC.W	35			;changed from 31 - DJB 08/03/88adjustGridys	DC.W	14		DC.W	5		DC.W	14maxYgrids	DC.W	$7FFF		DC.W	$7FFF		DC.W	200startGridxs	DC.W	120		DC.W	88		DC.W	94nextGridxs	DC.W	106		DC.W	150		DC.W	106adjustGridxs	DC.W	54		DC.W	74		DC.W	54ckGrid		ldy	#icy		lda	[<ic],y		cmp	gridy		bne	cont170		iny		iny		lda	[<ic],y		cmp	gridx		bne	cont170		lda	<icHand			Same icon?		cmp	saveIc		bne	err170		lda	<icHand+2		cmp	saveIc+2		beq	cont170err170		sec				Error, this icon is on the grid.		rtscont170		clc		rts		ENDP*===============================================** Build Device name from pathname		*		*===============================================*BuildDevName	PROC		IMPORT	GetDeviceNumber		IMPORT	GetDeviceInfo		jsr	buildPath		; C1_PathName = icon's name with a separator.		bcs	exit			; pathname error?		pha				; space for devNum		PushLong #C1_PathName		jsl	GetDeviceNumber		pla		bcs	exit		pha				; devNum		PushLong #C1_DeviceName		; devNamePtr		lda <zero		pha		pha				; skip devChar		pha		pha				; skip devBlocks		pha		pha				; skip devID		jsl	GetDeviceInfo		exit		rts		ENDP	; do the erase menu;.....................................................................EraseMenu	PROCNAME		IMPORT	NewIconName		IMPORT	GetDeviceInfo		jsr	noRename		; remove any rename field		lda	#erase180		brl	findSelect		; erase all selected disks; erase a prodos device;; IN: ic = pointer to ICONOBJ;; assertion: only unlock +online disks can get to here (no file servers either);.....................................................................erase180		IMPORT	EraseDisk		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	watchCursor		ldy	#icDevNum		lda	[<ic],y		pha				; pass device number		PushLong #C1_DeviceName		; pointer to device name		lda <zero		pha		pha				; skip characteristics		pha		pha				; skip total blocks		pha		pha				; skip device ID		jsl	GetDeviceInfo		bcs	@done		jsr	buildPath		; C1_PathName = icon's name with a separator.		bcs	@done			; pathname error?		jsl	saveCursor		jsl	WatchCursor				PushLong #C1_DeviceName		PushLong #C1_PathName		jsl	EraseDisk				php		jsl	restoreCursor		plp		bcs	@done			; unhandled error so exit				jsr	NewIconName		; update icon stuff		clc@done		rts		ENDP; do the format menu;.....................................................................FormatMenu	PROCNAME			IMPORT	PStringCopy		IMPORT	FormatDisk		IMPORT	GetDeviceInfo		jsr	noRename		Remove any rename field.		lda	#format190		Routine	to call	for every selected icon.		brl	findSelect; assertion: only unlocked and online disks get get to here (no file servers either);.....................................................................format190		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	watchCursor				ldy	#icDevNum		; pass device name to dialog		lda	[<ic],y		pha				; pass device number		PushLong #C1_DeviceName		; pointer to device name		lda <zero		pha		pha				; skip characteristics		pha		pha				; skip total blocks		pha		pha				; skip device ID		jsl	GetDeviceInfo		bcs	@done				jsr	buildPath		; C1_PathName = icon's name with a separator.		bcs	@done		jsl	saveCursor		jsl	watchCursor				PushLong #C1_DeviceName		PushLong #C1_PathName		jsl	FormatDisk				php		jsl	restoreCursor		plp		bcs	@done				jsr	NewIconName		; no error (and no cancel)		bcs	@done				pea	$8005			;task accomplished		_SysBeep2@done		rts; Change icon's name;.....................................................................		ENTRY	NewIconNameNewIconName	name		IMPORT	PStrToUpper		IMPORT	IsFSTUpperCase		IMPORT	HalfRoundUp		IMPORT	GetVolumeInfo		IMPORT	GetFileInfo		IMPORT	GetDeviceNumber		IMPORT	EjectDisk		IMPORT	WipeIcon		IMPORT	C1_PathNamePtr		IMPORT	doAlertWindow		IMPORT	updateInfoWin		IMPORT	AddIconRgn		IMPORT	GetRectRgn		IMPORT	RedrawList		IMPORT	ZoomDiskToTrash		IMPORT	VolumeParams		import	DupDevice		inc	SaveOffFlag		Turn data file saving off.		jsr	clearDisk		Remove disk's every window and ext icon.		stz	SaveOffFlag		Turn data file saving back on.@tryAgain		pushlong #C1_DeviceName		;given the device ID		pushlong #C1_PathName		;get the volume name				lda	<ic			;get the total blocks				clc		adc	#icFBytes		ldx	<ic+2		bcc	@totalNR		inx@totalNR	phx		pha						lda	<ic			;get the blocks free				clc		adc	#icFBlocks		ldx	<ic+2		bcc	@freeNR		inx@freeNR		phx		pha						lda	<ic		clc		adc	#icFileInfo		ldx	<ic+2		bcc	@fstNR		inx@fstNR		phx		pha				;get the file sys ID		lda <zero		pha		pha				;don't get the block size		jsl	GetVolumeInfo		ldy	#icFBlocks		;we got blocks free, convert to blocks		lda	[<ic],y			;used		sec		ldy	#icFBytes		sbc	[<ic],y		ldy	#icFBlocks		sta	[<ic],y		iny		iny		lda	[<ic],y		ldy	#icFBytes+2		sbc	[<ic],y		ldy	#icFBlocks+2		sta	[<ic],y			pushlong #c1_pathname		;pathname		lda <zero		pha		pha				;access		pha		pha				;filetype		pha		pha				;auxtype		pha		pha				;storagetype		lda	<ic			;create date		clc		adc	#icCDate		ldx	<ic+2		bcc	@cDateNR		inx@cDateNR	phx		pha				lda	<ic			;mod date		clc		adc	#icMDate		ldx	<ic+2		bcc	@mDateNR		inx@mDateNR	phx		pha		lda <zero				pha		pha				;bytes		pha		pha				;blocks*** 18-Jul-92 DAL -- update icon's file system;;;		pha;;;		pha				;file system		lda <ic		clc		adc #icFST		ldx <ic+2		bcc @1		inx@1		phx		pha*** end 18-Jul-92 DAL		jsl	GetFileInfo	;; see if the user made a boo-boo by naming their disk something that exists;		ldy	#icDevNum		lda	[<ic],y		tay				;skip our device and don't mark as duplicate		jsr	CheckDupDevice		bcc	@good						pha				;space for result flags		pha				;space for result device number		pea 	$4400			;flag = simulate dup-volume error		ldy	#icDevNum		lda	[<ic],y		pha		_HandleDiskInsert		pla		plx		tax		bcs	@error			;got an error, so just vaporize the icon and split		beq	@error		brl 	@tryAgain		;be super paranoid, but get the new name		@error		jsr	getRectRgn		Allocate regions.		jsr	ZoomDiskToTrash		jsr	WipeIcon		Remove the extended icon's record.		jsr	redrawList		Redraw the area	where the icon was.		sec		rts@good		jsr	getRectRgn		;Allocate regions for where the icon region WAS		jsr	addIconRgn				jsr	findLastName		lastName = volume name,	no leading separator.		pushlong #lastName		; move new name into icon name		lda	<ic		clc		adc	#icName		tax		lda	<ic+2		adc	<zero		pha		phx		jsl	PStringCopy;; Move the new device characteristics into the icDevInfo field and change the write protected status if it's; somehow changed;		lda	>VolumeParams+$16	;get the new device info stuff		ldy	#icDevInfo		sta	[<ic],y				ldy	#icFlag		and	#$0003			;check the write protected bit AND the read-only file system bit		bne	@locked			;(awwww, who knows, just check it anyway)				lda	[<ic],y		and	#_icLocked		sta	[<ic],y		bra	@unlocked		@locked		lda	[<ic],y		ora	#icLocked		sta	[<ic],y@unlocked			;; recompute the icon's icTitleLen field;		pha				Space for result.		pea	lastName>>16		Pass pointer to	icon's new name.		pea	lastName		_StringWidth		pla		jsl	HalfRoundUp		;acc := (acc DIV 2) + (acc MOD 2)		ldy	#icTitleLen		sta	[<ic],y			remember half the title's width.;; erase the old icon and put the new one in its place;		jsr	addIconRgn		jsr	redrawList				jsr	resetCTime		Update disk icon's create time and date.				clc		rts;; Check for a duplicate device;CheckDupDevice		pushZLong <icHand		pushZLong <ic		jsr	DupDevice		pulllong <ic		pulllong <icHand		rts		ENDP*===============================================**	Do the Close All Menu			*		*===============================================*		EXPORT CloseAllMenuCloseAllMenu	PROC			IMPORT	close1Window		jsr	noRename		Remove any rename field.		jsl	WatchCursorlop200		jsr	Close1Window		bne	lop200		jsl	arrowCursor		rts		ENDP*===============================================**	Do the Preferences Menu			*		*===============================================*PreferMenu	PROCNAME		IMPORT	defaultChg		IMPORT	UpdateWindow;;;		IMPORT	CheckAnyDWindow		;11-Feb-93 JCM - only used in main.aii		IMPORT	WindowGlobalON		IMPORT	WindowGlobalOFF		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		_WaitCursor				jsl	WindowGlobalON				pha		pha		lda <zero		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pha		pha				;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pushlong #3			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2		jsl	WindowGlobalOFF		pulllong prefsWindowPtr		bcc	@ok	;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	prefsWindowPtr+1		beq	@leave@done		lda	prefsWindowPtr		ldx	prefsWindowPtr+2		jsl	CloseThisWindow		*** Added 21-Jan-93 JCM;;;@leave		_InitCursor@leave		jsl	ArrowCursor		*** End - 21-Jan-93 JCM						rts;; cool.  we got the resources we needed and have a window -- so set everyone's control values before; anything gets drawn;@ok				ldy	#8			;start at control #8@ctlSetLoop	phy				tya		dec	a		asl	a		tax		lda	prefer		and	ctlMatchTable,x			bne	@set		stz	ctlValue		bra	@reset				@set		lda	#1		sta	ctlValue		@reset		pha		pha		pushlong prefsWindowPtr		;get them from the prefs window		pei <zero		phy		_GetCtlHandleFromID		pha		lda	3,s			;move the handle to be at the proper point for		sta	1,s			;_GetCtlValue		lda	5,s		sta	3,s		lda	ctlValue		sta	5,s		_SetCtlValue		ply		dey		bne	@ctlSetLoop		;stop at control #1 (no control #0);; now that we've set all the controls values, use DoModalWindow to play with everything;*** Added 21-Jan-93 JCM;;;		_InitCursor		jsl	ArrowCursor		*** End - 21-Jan-93 JCM		dmPrefsLoop	pha		pha		jsr	pushTask	;push the task record's ptr		lda <zero		pha		pha			;update proc		pea $8000		pha			;eventHook $80000000		pha		pha			;beep proc		pea	$c010		;flags		_DoModalWindow		pla		plx		cmp	#9		;stat text under disk info		beq	@toggleDiskInfo		cmp	#10		;stat text under color		beq	@toggleColor		cmp	#17		beq	@accept		cmp	#16		bne	dmPrefsLoop		lda	prefsWindowPtr		ldx	prefsWindowPtr+2		jsl	CloseThisWindow		rts		;; toggle disk info, item ID #8;@toggleDiskInfo	lda	#8		bra	@toggle;; toggle color stuff, item ID #4;@toggleColor	lda	#4;; they hit a checkbox (indirectly by smacking someone's stattext), but not on the checkbox, so toggle it;; IN: (A) contains item ID to toggle;@toggle		pha		pha		ldx	prefsWindowPtr+2		phx		ldx	prefsWindowPtr		phx		pei <zero		pha		_GetCtlHandleFromID		pha		lda	3,s			;move the handle to be at the proper point for		sta	1,s			;_GetCtlValue		sta	ctlHandle		lda	5,s		sta	3,s		sta	ctlHandle+2		_GetCtlValue		pla		and	#1		eor	#1		pha		pushlong ctlHandle		_SetCtlValue		brl	dmPrefsLoop;; they decided to hit the accept button, so go through all of the controls (ID's 1-9);@accept		ldx	#8			;start at control #8@ctlLoop	phx				pha		pha		pushlong prefsWindowPtr		;get them from the prefs window		pei <zero		phx		_GetCtlHandleFromID		pha		lda	3,s			;move the handle to be at the proper point for		sta	1,s			;_GetCtlValue		lda	5,s		sta	3,s		_GetCtlValue		pla		bne	@set@reset		lda	1,s			;get the control ID		dec	a		asl	a		tax		lda	ctlMatchTable,x			eor	#$FFFF		and	newPrefer		sta	newPrefer		bra	@next		@set		lda	1,s		dec	a		asl	a		tax			lda	ctlMatchTable,x		ora	newPrefer		sta	newPrefer@next		plx		dex		bne	@ctlLoop		;stop at control #1 (no control #0);; now, see what's new -- because if they changed the way the list views are done, we gotta; redraw all the windows (with list views) to reflect the new list view settings;		lda	prefer		sta	oldPrefer		lda	prefsWindowPtr		ldx	prefsWindowPtr+2		jsl	CloseThisWindow		lda	newPrefer		eor	prefer		and	#PREF_HDATA		beq	@noInvisiChange		lda	newPrefer		sta	prefer		lda	#DirWindID		; directory windows only.		ldx	#UpdateWindow		jsr	walkWindow				lda	oldPrefer		sta	prefer		@noInvisiChange	lda	newPrefer		eor	prefer					and	#PREF_SHOWDISK+PREF_SHOWDATE+PREF_SHOWKIND+PREF_SHOWSIZE		beq	@bingo					lda	newPrefer		sta	prefer				lda	#DirWindID+TrashWindID		ldx	#redrawListViews				jsr	walkWindow@bingo		lda	newPrefer		sta	prefer		lda	#$FFFF		sta	defaultChg		rts;; redrawListViews -- called by walkWindows, after checking whether or not this is a list; view, will redraw the window (inval it all);;   IN:	   wind	= window to compare.;;   OUT:   windPtr = pointer to windowBlk;redrawListViews		jsr	windRefCon		;stuff refcon into windBlk				ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		bge	@listView		clc		rts@listView		lda	oldPrefer		eor	newPrefer		and	#PREF_SHOWDISK		bne	@noBar				pei	<wind+2		pei	<wind		_DrawInfoBar		brl	@noChange@noBar		lda	prefer		and	#PREF_SHOWDISK		jsr	resizeInfoBar@noChange		pei	<wind+2			Pass window pointer.		pei	<wind		_StartDrawing			Setup window for drawing.				ldy	#visRgnOffset		;get our visRgn's handle		lda	[<wind],y		sta	<deref		iny		iny		lda	[<wind],y		sta	<deref+2				lda	[<deref]		;deref it		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref				ldy	#8			;move the rgn's boundsrect to a place we can		ldx	#6@loop		lda	[<deref],y		;play with it		sta	<visRECT,x		dey		dey		dex		dex		bpl	@loop						lda	<visRECT+2		;don't redraw the names field since it's		clc				;never affected		adc	#dxViewSize-2		sta	<visRECT+2		pei <zero		tdc		clc		adc	#visRECT		pha				pei <zero		pha		_EraseRect		_InvalRect		jsr	endDraw@done		clc		rts;; resizeInfoBar -- resize the info bar by growing or shrinking the content;		   info is resized according to what the preferences say that the;		   the info bar should contain;; IN: (A) = non-zero if adding double, zero if removing double;		EXPORT	resizeInfoBarresizeInfoBar			sta	resize				pha				;make the window invisible		pushZLong <wind		_GetWFrame		pla		and	#$ffdf		pha		pushZLong <wind		_SetWFrame		pha				;get the content region		pha		pushZLong <wind		_GetContentRgn		pulllong <deref				lda	[<deref]		;deref it		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref				ldy	#8			;move the rgn's boundsrect to a place we can		ldx	#6@cLoop		lda	[<deref],y		;play with it		sta	contentRECT,x		dey		dey		dex		dex		bpl	@cLoop				lda	resize		beq	@removeDuble		pushlong #zoomWithInfo		pei	<wind+2		pei	<wind		_SetZoomRect				lda	contentRECT+y1		clc		adc	#12		sta	contentRECT+y1				lda	contentRECT+y2		;remember, the window WITH the double height		sec				;info bar MUST be a minimu of 87 pixels tall, or		sbc	contentRECT+y1		;we might lose the thumb for the scroll bar		cmp	#39		bge	@newBar				lda	contentRECT+y1		;if it's not 87 pixels, force the issue		clc		adc	#39		sta	contentRECT+y2		bra	@newBar		@removeDuble	pushlong #zoomWithoutInfo		pei	<wind+2		pei	<wind		_SetZoomRect		lda	contentRECT+y1		sec		sbc	#12		sta	contentRECT+y1		@newBar		pei <zero		pushlong #contentRECT		pushZLong <wind		_ResizeWindow				ldx	<zero		lda	resize		beq	@small				ldx	#2@small		pei <zero		lda	infoSizes,x		pha		pushZLong <wind		_ResizeInfoBar				pushZLong <wind		_ShowWindow		@noChange	rts	;; locals;resize		dc.w	0		EXPORT	contentRECTcontentRECT	ds.b	8				EXPORT	infoSizesinfoSizes	dc.w	11			;no double height info bar		dc.w	11+12			;double height bar		oldPrefer	dc.w	0			;the old preferences settingsnewPrefer	dc.w	0			;the new preferences settingsredrawRECT	dc.L	0			;what we need to redraw		dc.L	0		prefsWindowPtr	dc.L	0			;pointer to our preferences window, or NILctlHandle	dc.L	0ctlValue	dc.w	0ctlMatchTable	dc.w	PREF_DATA		dc.w	PREF_HDATA		dc.w	PREF_AUTO525		dc.w	PREF_COLOR		dc.w	PREF_SHOWDATE		dc.w	PREF_SHOWSIZE		dc.w	PREF_SHOWKIND		dc.w	PREF_SHOWDISK		ENDP*===============================================**	Do the Verify Menu			*		*===============================================*VerifyMenu	PROC			IMPORT	doAlertWindow		IMPORT	PathGetRoot		IMPORT	InsertItemRef		IMPORT	AddWindow2Menu		IMPORT	VerifyHeight		IMPORT	VerifyWidth		stz	verWindCount		jsr	noRename			;Remove any rename field.		lda	#Verify250		brl	findSelect			;Verify all selected disks.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Verify a Volumn's Medium.  Added 5/5/88 DJB; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   ic =	pointer	to ICONOBJ.;; = = =	= = = =	= = = =	= = = =	= = = =	= = =Verify250		ldy	#icFType			;an icon that can be verified?		lda	[<ic],y		bpl	exit250				;not a device icon		cmp	#TypeFTrash			;Trash can?		bcs	exit250		cmp	#TypeFDrive			;5.25 Floppy Drive?		beq	exit250		cmp	#TypeServer			;Server volume?		beq	exit250		cmp	#TypeNetwork			;Network?		beq	exit250		ldy	#icFlag				;make sure it's online		lda	[<ic],y		and	#ICOFFLINE		bne	exit250		jsl	WatchCursor		jsr	buildPath			;C1_PathName = icon's name with a separator.		bcs	exit250				;Pathname error?		PushLong #C1_FileName		PushLong #C1_PathName		jsl	PathGetRoot			;get name of "root"		pha		pha		PushLong #C1_PathName 		jsl	VerifyMedium				jsl	arrowCursor		pla		sta	>verifyData		sta	<temp		pla		bmi	exit250				;user aborted		sta	>verifyData+2		sta	<temp+2		ora	>verifyData		bne	window250		pea	$C005				;task accomplished		_SysBeep2		lda	#rasVerifyGood			;tell the user they're lucky		jsl	doAlertWindow		clcexit250		rts;--- Allocate info block for Bad Block window -----------------------window250		lda	#rasVerifyBad			; ask user for summary		jsl	doAlertWindow		clc		beq	exit250		jsr	ckIfWind			;Is there enough memory for a window?		bcs	exit250				;no		lda	[<temp]		tax		ldy	#2		lda	[<temp],y		sta	<temp+2		stx	<temp				pha		pha		lda	[<temp]		pha		pea	9		_Multiply		pla		sta	>VerifyHeight		pla		sta	>VerifyHeight+2		lda	#60		sta	>verifyWidth		lda	<zero		sta	>verifyWidth+2;; find out where the first Ò starts and store our name and enclosing quote after it for the window's title;		sep	#$20		LONGA OFF		ldx	<zero@vLoop1		inx		lda	>verifyBlk+windTitle,x		cmp	#'Ò'		bne	@vLoop1			stx	<work		rep	#$20		LONGA ON				txa		clc		adc	#verifyBlk+windTitle		sta	<temp		lda	#verifyBlk>>16		sta	<temp+2		lda	<zero				sep	#$20		LONGA OFF			ldy	#icName		lda	[<ic],y		clc		adc	<work				inc	a				;+1 for closing Ó		inc	a				;+1 for closing space		sta	>verifyBlk+windTitle		;new length of the title		ldy	#icName		lda	[<ic],y		tax		clc		adc	#icName		tay		@vLoop2		lda	[<ic],y			phy		txy		sta	[<temp],y		ply		dey		dex		bne	@vLoop2				ldy	#icName		lda	[<ic],y		clc		adc	<work		tax				lda	#'Ó'		sta	>verifyBlk+windTitle+1,x		lda	#' '		sta	>verifyBlk+windTitle+2,x		rep	#$20		LONGA ON;; find out where the first Ò starts and store our name and enclosing quote after it for the window's title;		sep	#$20		LONGA OFF		ldx	<zero@vLoop3		inx		lda	>verifyBlk+windMenuText,x		cmp	#'Ò'		bne	@vLoop3			stx	<work		rep	#$20		LONGA ON				txa		clc		adc	#verifyBlk+windMenuText		sta	<temp		lda	#verifyBlk>>16		sta	<temp+2		lda	<zero				sep	#$20		LONGA OFF			ldy	#icName		lda	[<ic],y		clc		adc	<work				inc	a				;+1 for closing Ó		sta	>verifyBlk+windMenuText		;new length of the title		ldy	#icName		lda	[<ic],y		tax		clc		adc	#icName		tay		@vLoop4		lda	[<ic],y			phy		txy		sta	[<temp],y		ply		dey		dex		bne	@vLoop4				ldy	#icName		lda	[<ic],y		clc		adc	<work		tax				lda	#'Ó'		sta	>verifyBlk+windMenuText+1,x		rep	#$20		LONGA ON;; OK, allocate the memory for the verify block now;		lda	#endVerifyBlk-verifyBlk		;size of info block for window.		ldx	#$4000				;Locked, anywhere.		jsr	allocate2			;Allocate an info block.				jsr	derefHand			;Dereference the handle.		sta	>verifyBlkPtr			;refCon = window's info block.		sta	>verifyInfoRef			;infoRefCon = window's info block.		tay		txa		sta	>verifyBlkPtr+2		sta	>verifyInfoRef+2		tya		clc					;Store pointer to window's title in		adc	#windTitle			;window parameter table.		bcc	store250		inxstore250	sta	>verifyTPtr			;Pointer to window's title.		txa		sta	>verifyTPtr+2		lda	#^GetVerifyInfo			;set Draw procedures up		sta	>verifyInfoProc+2		lda	#GetVerifyInfo		sta	>verifyInfoProc		lda	#^GetVerifyGuts		ora	#$C000		sta	>verifyGutsProc+2		lda	#GetVerifyGuts		sta	>verifyGutsProc		lda	<zero		sta	>verifyBlk+windIcons		sta	>verifyBlk+windIc		sta	>verifyBlk+windIcons+2		sta	>verifyBlk+windIc+2		ldy	#(endVerifyBlk-verifyBlk)-2	;Initialize info block.@loop		tyx		lda	>verifyBlk,x		sta	[<temp],y		dey		dey		bpl	@loop;; --- Create Verify window ----------------------------------------------;		ENTRY	open250open250		inc	verWindCount		lda	verWindCount		asl	a		asl	a		asl	a			;times 8 pixels		tax		clc		adc	#verifyY1		sta	>verifywRect+y1		txa		clc		adc	#verifyY2		sta	>verifywRect+y2		txa		asl	a			;times 16 pixels		tax		clc		adc	#verifyX1		sta	>verifywRect+x1		txa		clc		adc	#verifyX2		sta	>verifywRect+x2		pha				;Space for result.		pha		pushlong #verify_param		;ptr to NewWindow parameter list.		_NewWindow		pla		plx		inc	myWindCount		;keep track of windows.;; Now that the window's been created, add it into the Windows menu;		pha		pha		phx		pha		_GetWRefCon		pulllong wind_ref				lda	wind_ref		clc		adc	#windMenuText		sta	insertItemRef+10		lda	wind_ref+2		adc	<zero		sta	insertItemRef+12						jmp	addWindow2Menu		;add the trash to the windows menu		ENDP*===============================================**	Do the Shut Down Menu			*		*===============================================*ShutDownMenu	PROCNAME		IMPORT 	setGSOSAlerts,ejectAllDisks		import 	sayGoodbyeToExtensions		import	WindowGlobalON,WindowGlobalOFF		import	defaultQuitMethod		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		jsl	WindowGlobalON				pha		pha		lda <zero		pha		pha				;titlePtr		pha		pha				;refCon is ptr to our window info block		pha		pha				;content draw proc		pha		pha				;window defproc		pea	2			;refIsResource		pushlong #4			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2		jsl	WindowGlobalOFF		pulllong <deref		bcc	@ok	;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	<deref+1		;check the middle 2 bytes of the pointer		beq	@leave@done		lda	<deref		ldx	<deref+2		jsl	CloseThisWindow*** Added 21-Jan-93 JCM;;;@leave	_InitCursor@leave		jsl	ArrowCursor		*** End - 21-Jan-93 JCM						rts;; cool.  we got the resources we needed and have a window -- so call DoModalWindow;*** Added 21-Jan-93 JCM;;;@ok		_InitCursor@ok		jsl	ArrowCursor		*** End - 21-Jan-93 JCM				*** added 23-Jun-92 DAL -- do default choice for Quit dialog		pha		pha		_GetPort		pha		pha		_FrontWindow		_SetPort		_HidePen		lda defaultQuitMethod		and #$0003		beq @normalDefault		tax		jsr setCtlID@normalDefault	_ShowPen		_SetPort*** end 23-Jun-92@dmLoop		pha		pha		jsr	pushTask	;push the task record's ptr		lda <zero		pha		pha			;update proc		pea $8000		pha			;eventHook $80000000		pha		pha			;beep proc		pea	$c010		;flags		_DoModalWindow		pla		plx		tay		bne	@notNIL		txy		bne	@notNIL			lda	<what		cmp	#3		beq	@gotKEY		cmp	#5		bne	@dmLoop	;; we got a keypress back in our null events;@gotKEY		lda	<message		and	#$00ff		cmp	#$0B		;is it up arrow?		beq	@up		cmp	#$0A		;is it down arrow?		bne	@dmLoop	;; Down-arrow;@down		jsr	getRadButton		cmp	#2		beq	@dmLoop		inc	a		tax		jsr	setCtlID		bra	@dmLoop	;; Up-arrow;@up		jsr	getRadButton		beq	@dmLoop		dec	a		tax		jsr	setCtlID		bra	@dmLoop		;; they actually hit a control (ie, don't number them from zero);@notNIL		cmp	#5		blt	@dmLoop		bne	@radButton		brl	@done@radButton	jsr 	getRadButton		;0, 1, or 2		asl 	a			;0, 2, or 4		pha				;save doubled index		lda	<deref		ldx	<deref+2		jsl	CloseThisWindow				plx				;pre-doubled index		jmp	(@addr,x);; addresses for shutdown routines;@addr		dc.W	ShutItDown		;rad button 0		dc.W	Restart270		;rad button 1		dc.W	ID_QUIT			;rad button 2;; set the ID in (X) to <ON>;setCtlID	pha		pha		pushZlong <deref		pei <zero		phx		_GetCtlHandleFromID		pea	1		lda	3,s		sta	1,s		lda	5,s		sta	3,s		_SetCtlValue		rts;; get our radio button;getRadButton	pha		pushZlong <deref		pei <zero		_FindRadioButton		pla		rts; shutdown routines;.....................................................................		EXPORT	ShutItDown		EXPORT	RealShutdown		EXPORT	RealRestartShutItDown					; Shut Down selected		stz	quit_path		; Mark "no name to quit to..."		stz	quit_path+2				lda	#$C001		sta	quit_flags		; let event loop handle this baby		rts		RealShutDown	stz	shutdown_flag		; flag = power downgoodbye		jsl SayGoodbyeToExtensions	;10-Jul-91 DAL		_DeskShutdown			; shutdown the Desk Manager.		pei <zero		jsl	SetGSOSAlerts		; enable GS/OS alerts - 02/17/89				jsl	Prodos		DC.W	OS_SHUTDOWN+C1		DC.L	shutdown_list		rts				; it should never come back!!;-----------------------------------------------Restart270	stz	quit_path		; Mark "no name to quit to..."		stz	quit_path+2				lda	#$C003		sta	quit_flags		; let event loop handle this baby		rts		RealRestart	lda	#1		sta	shutdown_flag		; flag = cold boot		bra	goodbyeStopTick	DC.L	0;-----------------------------------------------		EXPORT	ID_QUIT		ID_QUIT		stz	quit_path		Mark 'no name to quit to'.		stz	quit_path+2		lda	#$C000		sta	quit_flags		rts		ENDP*===============================================**	Do the Validate Menu			*		*===============================================*ValidateMenu	PROC		IMPORT	verifyWidth		IMPORT	verifyHeight		jsr	noRename		;Remove any rename field.		lda	#Validate280		;Rountine to do Validation.		brl	findSelect		;do it for each icon.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Validate a File System.  Added 5/24/88 DJB; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   ic =	pointer	to ICONOBJ.;; = = =	= = = =	= = = =	= = = =	= = = =	= = =Validate280		ldy	#icFType		;an icon that can be validated?		lda	[<ic],y		cmp	#TypeFTrash		;Trash can?		bcs	exit280		cmp	#TypeFDrive		;5.25 Floppy Drive?		beq	exit280		jsl	WatchCursor		jsr	buildPath		;C1_PathName = icon's name with a separator.		bcs	exit280			;Pathname error?		jsl	ValidateFile		; pointer to bad data		bcc	@imdone		jsr	window280@imdone				jsl	arrowCursor		clcexit280		rts	;	; --- Allocate info block for Bad Files window -----------------------;window280	sta	>validateData			;handle to verify data buffer		sta	<work		txa		sta	>validateData+2		sta	<work+2				lda	[<work]				;dereference this handle		tax		ldy	#2		lda	[<work],y		sta	<work+2		stx	<work				pha		pha		lda	[<work]		pha		pea	9		_Multiply		pla		sta	>verifyHeight		pla		sta	>verifyHeight+2				lda	#280		sta	>verifyWidth		lda	#280>>16		sta	>verifyWidth+2;; find out where the first Ò starts and store our name and enclosing quote after it for the window's title;		sep	#$20		LONGA OFF		ldx	<zero@vLoop1		inx		lda	>validateBlk+windTitle,x		cmp	#'Ò'		bne	@vLoop1			stx	<work		rep	#$20		LONGA ON				txa		clc		adc	#validateBlk+windTitle		sta	<temp		lda	#validateBlk>>16		sta	<temp+2		lda	<zero				sep	#$20		LONGA OFF			ldy	#icName		lda	[<ic],y		clc		adc	<work				inc	a				;+1 for closing Ó		inc	a				;+1 for closing space		sta	>validateBlk+windTitle		;new length of the title		ldy	#icName		lda	[<ic],y		tax		clc		adc	#icName		tay		@vLoop2		lda	[<ic],y			phy		txy		sta	[<temp],y		ply		dey		dex		bne	@vLoop2				ldy	#icName		lda	[<ic],y		clc		adc	<work		tax				lda	#'Ó'		sta	>validateBlk+windTitle+1,x		lda	#' '		sta	>validateBlk+windTitle+2,x		rep	#$20		LONGA ON;; find out where the first Ò starts and store our name and enclosing quote after it for the window's title;		sep	#$20		LONGA OFF		ldx	<zero@vLoop3		inx		lda	>validateBlk+windMenuText,x		cmp	#'Ò'		bne	@vLoop3			stx	<work		rep	#$20		LONGA ON				txa		clc		adc	#validateBlk+windMenuText		sta	<temp		lda	#validateBlk>>16		sta	<temp+2		lda	<zero				sep	#$20		LONGA OFF			ldy	#icName		lda	[<ic],y		clc		adc	<work				inc	a				;+1 for closing Ó		sta	>validateBlk+windMenuText	;new length of the title		ldy	#icName		lda	[<ic],y		tax		clc		adc	#icName		tay		@vLoop4		lda	[<ic],y			phy		txy		sta	[<temp],y		ply		dey		dex		bne	@vLoop4				ldy	#icName		lda	[<ic],y		clc		adc	<work		tax				lda	#'Ó'		sta	>validateBlk+windMenuText+1,x		rep	#$20		LONGA ON;; OK, allocate the memory for the window...;		jsr	ckIfWind			;Is there enough memory for a window?		bcc	@ok		rts					;no@ok		lda	#endValidateBlk-validateBlk	;size of info block for window.		ldx	#$8000				;Locked, anywhere.		jsr	allocate2			;Allocate an info block.		jsr	derefHand			;Dereference the handle.				sta	>verifyBlkPtr			;refCon = window's info block.				sta	>verifyInfoRef			;infoRefCon = window's info block.		tay		txa		sta	>verifyInfoRef+2		sta	>verifyBlkPtr+2		tya		clc					;Store pointer to window's title in		adc	#windTitle			;window parameter table.		bcc	store280		inxstore280	sta	>verifyTPtr			;Pointer to window's title.		txa		sta	>verifyTPtr+2				lda	#^GetValidInfo			;set Draw procedures up		sta	>verifyInfoProc+2		lda	#GetValidInfo		sta	>verifyInfoProc				lda	#^GetValidGuts		ora	#$C000		sta	>verifyGutsProc+2		lda	#GetValidGuts		sta	>verifyGutsProc		lda	<zero		sta	>validateBlk+windIcons		sta	>validateBlk+windIc		sta	>validateBlk+windIcons+2		sta	>validateBlk+windIc+2		ldy	#(endValidateBlk-validateBlk)-2	;Initialize info block.@loop		tyx		lda	>validateBlk,x		sta	[<temp],y		dey		dey		bpl	@loop					brl	open250				; borrow code from Verify		ENDP		*===============================================*	Get a new UNTITLED name.** Appends an '.a', '.b', '.c'...** IN:	C1_PathName (ending in "untitled")** OUT:	C1_PathName (ending in "untitled.a")*	carry set if no more names** 13-Jan-93 DAL: Made suffixes lowercase**===============================================NewUntitled	PROC	EXPORT		ldy	C1_PathName		;offset to '.X' suffix		lda	C1_PathName,y		tax		and	#$00FF		cmp	#'.'			;have we started appending ?		bne	next		txa		bra	skipnext		inc	C1_PathName		;increase length by two		inc	C1_PathName		lda	#$602E			;'.a', '.b', '.c',...skip;;;		clc;;;		adc	#$0100*** optimized 13-Jan-93 DAL		xba		inc	a		xba*** end 13-Jan-93		cmp	#$7B2E			; passed '.z' ?		bcs	exit				ldy	C1_PathName		; offset to '.x' suffix		sta	C1_PathName,y		;;;		clcexit		rts		ENDP;==============================================;	Set menu items to state of desktop;==============================================;; IN:	curWind = current selected window plane;;==============================================CheckMenus	PROCNAME EXPORT		IMPORT	IconStates		IMPORT	ChangeMenus		IMPORT	matchedFirst		IMPORT	matchFirst		IMPORT	walkWindow		IMPORT	findDisk				lda	DeskIconState		; remember last state		sta	LastIconState		lda	DeskWindState		sta	LastWindState		stz	DeskIconState		; start with state flags cleared		stz	DeskWindState;--- Find out state of	icons ------------------		lda	>TrashBlk+1		; any items in trash window ?		beq	chkIcons		lda	#winTrashFull		; set 'something in Trash'		tsb	DeskWindStatechkIcons	lda	#IconStates		jsr	findSelect;--- Find out state of windows	----------------		stz	matchedFirst		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#matchFirst		;don't check for anything, match the first open dir window		jsr	walkWindow		;we don't want opened sys windows		lda	matchedFirst		;did we match for the first window?		bne	@hasFinderWindows		lda	#winNoFinder		tsb	DeskWindState@hasFinderWindows lda	#$FFFF			; any front window ?		jsr	getFrontWind		bne	winType		lda	#winDeskTop		; set desktop only (no windows)		tsb	DeskWindState		brl	done			; all donewinType		tax		cpx	#DirWindID		bne	chkTrash		ldy	#windDiskIc		;icHand = disk that icon came from		lda	[<windBlk],y		sta	<icHand		iny		iny		lda	[<windBlk],y		sta	<icHand+2		lda	[<icHand]		sta	<ic		ldy	#2		lda	[<icHand],y		sta	<ic+2				ldy	#icFlag		lda	[<ic],y		and	#icOffline		beq	@notOffline				lda	#winOffline		tsb	DeskWindState		@notoffline	lda	[<ic],y		and	#icLocked		beq	@notLocked				lda	#winLocked		tsb	DeskWindState@notLocked		;; look at the icon which opened into this window and see if we're able to write to it; if we get here, we're definitely a directory window;		ldy	#icFlag+2		;look at the network bit first from the original disk		lda	[<ic],y		and	#icNetwork>>16		beq	@notFromNetwork		;if not a network volume, don't continue		ldy	#windAccess		;see if this icon says we can make changes		lda	[<windBlk],y		and	#icMakeChanges		bne	@notFromNetwork				lda	#winLocked		;if not, say winLocked		tsb	DeskWindState@notFromNetwork		ldy	#windView		; Is directory window viewed by text?		lda	[<windBlk],y		cmp	#viewByName		bcc	noText		lda	#winTopDir+winTopText	; view by text directory window on top		bra	setItnoText		lda	#winTopDir		; view by icon directory window on top		bra	setIt;--- Check Trash and Clipboard ----------------chkTrash	cpx	#TrashWindID		; is it the trash window ?		bne	notTrash		; No, try clipboard.		ldy	#windView		; see if it viewed by text		lda	[<windBlk],y		cmp	#viewByName		bcc	TrashByIcon		lda	#winTopTrash+winTopText		bra	setItTrashByIcon	lda	#winTopTrash		bra	setItnotTrash	lda	#winTopClip		; Clip window on top (just in case)		cpx	#ClipWindID		beq	setIt		lda	#winTopInfo		; Info window on top (just in case)		cpx	#InfoWindID		beq	setIt		lda	#winTopAbout		; about window on top (just in case)		cpx	#AboutWindID		beq	setIt				lda	#winTopHelp		; about window on top (just in case)		cpx	#HelpWindID		beq	setIt		lda	#winTopVerify		cpx	#VerifyWindID		beq	setIt		cpx	#SysWindID		bne	any		lda	#winTopSys		; system window on topsetIt		tsb	DeskWindStateany		lda	#winAny			; there must be some window up		tsb	DeskWindStatedone		brl	ChangeMenus		ENDP		*===============================================**	Change the state of menu items		**						** IN:	DeskIconState				**	LastIconState				**	DeskWindState				**	LastWindState				**						** Out:	none					**===============================================*ChangeMenus	PROCNAME		IMPORT	SetMenuFlag		IMPORT	FixMenuTitles		IMPORT	FixTrash				stz	MenuChange		lda	DeskIconState		; have there been any icon changes?		eor	LastIconState		beq	testWind		sta	LastIconState		; remember bits that changed				inc	MenuChange;; --- Do Color menu by hand ---------------------;		lda	#iconAny		and	LastIconState		; has the state changed?		beq	iconMenus		; no		ldy	#MENUENABLE		lda	#iconAny		and	DeskIconState		; is change to enable or disable?		bne	store		ldy	#MENUDISABLEstore		lda	#idColorMenu		; pass menu id				jsr	SetMenuFlag;; --- Icon Menu Items ---------------------------;iconMenus		ldx	#(endIconItem-iconItemTbl)-2loop1		lda	iconItemTbl-2,x		; get the enable bits		and	LastIconState		; has the state changed?		bne	change1			; yes		lda	iconItemTbl,x		; get the over ride bits		beq	next1			; none		and	LastIconState		; has the state changed?		beq	next1			; nochange1		ldy	#ITEMENABLE		lda	iconItemTbl-2,x		; get the enable bits again		and	DeskIconState		; were any of ours set?		beq	forceDim1		; no		lda	iconItemTbl,x		; get the over ride bits		beq	ok1		and	DeskIconState		; were any of ours set?				beq	ok1			; noforceDim1	ldy	#ITEMDISABLEok1		phx				; save index		phy				; pass flag change		lda	iconItemTbl-4,x		pha				; pass item's ID number		_SetMItemFlag		plx				; restore indexnext1		dex		dex		dex		dex		dex		dex		bpl	loop1;; --- Check window related menu items -----------;testWind	lda	DeskWindState		; have there been any window changes?		eor	LastWindState		bne	delta		brl	done			; no changes, so exitdelta		inc	MenuChange			sta	LastWindState		; remember bits that changed		and	#winTrashFull		; has the state of the Trash changed?		beq	windMenus		jsr	FixTrash	;		; --- Window Menu Items -------------------------;windMenus	ldx	#(endWindItem-windItemTbl)-2loop2		lda	windItemTbl-2,x		; get the enable bits		and	LastWindState		; has the state changed?		bne	change2			; yes		lda	windItemTbl,x		; get the over ride bits		beq	next2			; none		and	LastWindState		; has the state changed?		beq	next2			; nochange2		ldy	#ITEMENABLE		lda	windItemTbl-2,x		; get the enable bits again		and	DeskWindState		; were any of ours set?		beq	forceDim2		; no		lda	windItemTbl,x		; get the over ride bits		beq	ok2		and	DeskWindState		; were any of ours set?				beq	ok2			; noforceDim2	ldy	#ITEMDISABLEok2		phx				; save index		phy				; pass flag change		lda	windItemTbl-4,x		pha				; pass item's ID number		_SetMItemFlag		plx				; restore indexnext2		dex		dex		dex		dex		dex		dex		bpl	loop2done		lda	MenuChange		; any changes ?		beq	exit		jsr	FixMenuTitlesexit		rts;-------------------------------------------------------; menu item table format:; menu id, enable bits, disablebits (overides enable bits);-------------------------------------------------------;--- menu items related strictly to icon statesiconItemTbl	dc.W	idOpen,iconAny,iconOffline+iconNoAccess		dc.W	idPrint,iconDocument,iconOffline+iconNoAccess		dc.W	idIconInfo,iconAny,0		dc.W	idDuplicate,iconFile,iconOffline+iconNoAccess+iconTrash+iconDrive+iconDisk+iconInLocked+iconInTrash+iconExtended		dc.W	idPutAway,iconExtended+iconRemovable,iconTrash+iconDrive		dc.W	idEject,iconRemovable,iconOffline+iconFloppy		dc.W	idErase,iconDisk,iconOffline+iconLocked+iconServer+iconTrash+iconDrive		dc.W	idFormat,iconDisk,iconOffline+iconLocked+iconServer+iconTrash+iconDrive		dc.W	idVerify,iconDisk,iconOffline+iconServer+iconTrash+iconDrive		dc.W	idValidate,iconDisk+iconFile,iconOffline+iconNoAccess+iconTrash+iconDriveendIconItem;--- menu items related strictly to window stateswindItemTbl	dc.W	idClose,winAny,0		dc.W	idCloseAll,winAny,0		dc.W	idNewFolder,winTopDir,winOffline+winLocked		dc.W	idUndo,winTopSys,0		dc.W	idCut,winTopSys+winTopInfo,0		dc.W	idCopy,winTopSys+winTopHelp+winTopInfo,0		dc.W	idPaste,winTopSys+winTopInfo,0		dc.W	idClear,winTopSys+winTopInfo,0		dc.W	idEmptyTrash,winTrashFull,0		dc.W	idSelectAll,winDeskTop+winTopDir+winTopTrash+winTopHelp+winTopInfo,0		dc.W	idCleanUp,winDeskTop+winTopDir+winTopTrash,winTopText		dc.W	idByIcon,winTopDir+winTopTrash,0		dc.W	idByTinyIcon,winTopDir+winTopTrash,0		dc.W	idByName,winTopDir+winTopTrash,0		dc.W	idByDate,winTopDir+winTopTrash,0		dc.W	idBySize,winTopDir+winTopTrash,0		dc.W	idByKind,winTopDir+winTopTrash,0		dc.W	idStackWindows,winTopDir+winTopInfo+winTopTrash+winTopClip+winTopAbout+winTopHelp+winTopSys+winTopVerify,winNoFinderendWindItem		ENDP		*===============================================**	Fix State of Menu Titles		**						** IN:	a-reg = menu id				**	y-reg = menu flag			**						** OUT:	none					**===============================================*SetMenuFlag	PROC		sta	<temp			; save menu id		phy				; pass menu flag		pha				; pass menu id		_SetMenuFlag		pei <zero			; pass unhilite flag		PushZWord <temp			; pass menu id		_HiliteMenu		rts		ENDP*=======================================**	Fix State of Menu Titles	**					** IN:	none				** OUT:	none				**=======================================*FixMenuTitles	PROC		ldx	<zero		; x is index into tablemenuLoop	lda	MenuItems,x		beq	exit		; no more titles		sta	<work		; remember title's id		inx		inx		lda	#ITEMDISABLE	; assume disabled to start		sta	<tempitemLoop	lda	MenuItems,x		beq	setTitle		ldy	<temp		; have we found an enabled item?		cpy	#ITEMENABLE		beq	next		phx			; save x		pha			; space for flag		pha			; pass id		_GetMItemFlag		pla			; check item's flag		plx		and	#ITEMDISABLE	; is it disabled ?		bne	next		; yes, so on to next item		lda	#ITEMENABLE	; change our assumption			sta	<temp		next		inx		inx		bra	itemLoop	; check next item		setTitle	phx			; save x		pha			; space for flag		PushZWord <work		; pass id		_GetMenuFlag		pla			; check current menu flag		and	#ITEMDISABLE		bne	check		lda	#ITEMENABLEcheck		cmp	<temp		; already set ?		beq	endSet		ldy	<temp		; menu flag		lda	<work		; menu id		jsr	SetMenuFlagendSet		plx			; restore x		inx		inx		bra	menuLoop	; process next title		exit		rts;-----------------------------------------------MenuItems	DC.W	idFileMenu		DC.W	idNewFolder		DC.W	idOpen		DC.W	idPrint		DC.W	idClose		DC.W	idCloseAll		DC.W	idDuplicate		DC.W	idPutAway		DC.W	idValidate		DC.W	0		dc.W	idWindowsMenu		dc.W	idStackWindows		dc.W	0		DC.W	idViewMenu		DC.W	idByIcon		DC.W	idByTinyIcon		DC.W	idByName		DC.W	idByDate		DC.W	idBySize		DC.W	idByKind		DC.W	0		DC.W	idDiskMenu		DC.W	idFormat		DC.W	idErase		DC.W	idVerify		DC.W	idEject		DC.W	0,0				ENDP*=======================================**	Fix State of Menu Titles	**					** IN:	DeskWindState			**	TrashIc				** OUT:	none				**=======================================*FixTrash	PROCNAME		IMPORT	MatchFileToIcon		IMPORT	AddIconRgn		IMPORT	GetRectRgn		IMPORT	RedrawList		pushZLong <curWind				lda	>TrashIc		; Get handle of Trash icon		sta	<icHand		lda	>TrashIc+2		sta	<icHand+2		jsr	lockic		jsr	toDesktop		; Switch to desktop 		jsr	toDeskPort		; Switch to desktop port		lda	<deskport		Switch to desktop.		sta	<curWind		lda	<deskport+2		sta	<curWind+2		jsr	GetRectRgn		jsr	AddIconRgn						ldx	#TypeTrash		; empty trash file type		lda	DeskWindState		and	#winTrashFull		; empty or not?		beq	store2		dex		phx		pea	$8042					_SysBeep2		plxstore2		stx	<filetype		; store type of icon to match		stz	auxtype		stz	ticonobj+icOptionList	;nobody home		stz	ticonObj+icLocalAccess		stz	ticonobj+icForked		;; andy and dave -- fix the trashcan disappearing and sometimes turning into an apple;                  folder bug.		longa off		longi off		sep #$30				lda	>trashBlk+windMenuText		tax@tLoop		lda	>trashBlk+windMenuText,x		sta	ticonobj+icName,x	;added ,x 17-Oct-92 DAL		dex		bpl	@tLoop		longa on		longi on		rep #$30;end fix		tsc		sec		sbc	#20			;put 5 longs on the stack		tcs		pea	$8000			;don't care about voting, match all		pea	1			;match the first one		pei	<filetype		lda <zero		pha		pha				;auxtype		pushlong #ticonobj+icName		pushlong #ticonobj+icCDate		pushlong #ticonobj+icMDate		pha				;ticonobj+icLocalAccess		pha				;ticonobj+icForked		pha		pha				;ticonobj+icOptionList		pha		pha				;no eof		jsl	matchFileToIcon		pla		ldy	#icOneDocOffset		sta	[<ic],y		iny		iny		pla		sta	[<ic],y		pla		ldy	#icRBundle		sta	[<ic],y		iny		iny		pla		sta	[<ic],y		pla		ldy	#icSmallIcon		sta	[<ic],y		iny		iny		pla		sta	[<ic],y		pla		ldy	#icIcon		sta	[<ic],y		iny		iny		pla		sta	[<ic],y				pla		pla						jsr	AddIconRgn		jsr	RedrawList							jsr	unlockic		; leave Trash icon unlocked		lda	<filetype		cmp	#TypeTrash		; did we go to an empty trash ?		bne	exit		lda	<TrashWind		; switch to the Trash plane		sta	<curWind		lda	<TrashWind+2		sta	<curWind+2		jsr	getwRefCon		; get the window's info block		ldy	#windItems		; set number of items in window		lda	[<windBlk],y		beq	exit			; already empty		lda	<zero		sta	[<windBlk],y		jsr	startDraw		; erase the content region		stz	<dRect+y1		stz	<dRect+x1		lda	#200		sta	<dRect+y2		lda	#640		sta	<dRect+x2		jsr	pushrect		_EraseRect		jsr	endDraw		pei	<TrashWind+2		pei	<TrashWind		_DrawInfoBar			; redraw info bar item count		exit		pulllong <curWind		rts		ENDP*===============================================** Set DeskIconState bits for selected icons	** --> Called from findSelect			**						** IN:	ic = pointer to selected ICONOBJ	**						** OUT:	DeskIconState is updated		**===============================================*IconStates	PROCNAME		IMPORT	GetWindPath		IMPORT	ClonePath		IMPORT	FindDisk		IMPORT	isReadOnly		IMPORT	EjectNonRemovable		ldy	#icMom+2		lda	[<ic],y		tax		dey		dey		lda	[<ic],y				jsr	GetWRefCon2		;setup wind and windBlk		ldy	#icFlag			; is this an extended icon ?		lda	[<ic],y		and	#ICEXTENDED		beq	@notExtended		lda	#iconExtended		; an extended icon is selected		tsb	DeskIconState@isDiskIcon	brl	@isReadOnly	@notExtended	ldy	#icFType		;don't check this stuff for disk icons				lda	[<ic],y		bmi	@isDiskIcon		pushZLong <icHand		pushZLong <ic				ldy	#windDiskIc		;icHand = disk icon that window came from		lda	[<windBlk],y		sta	<icHand		iny		iny		lda	[<windBlk],y		sta	<icHand+2				lda	[<icHand]		sta	<ic		ldy	#2		lda	[<icHand],y		sta	<ic+2			ldy	#icFlag					lda	[<ic],y		and	#icLocked		beq	@notLocked				lda	#iconInLocked				tsb	DeskIconState		@notLocked	pulllong <ic		pulllong <icHand		ldy	#icFlag+2		;look at the network bit first		lda	[<ic],y		and	#icNetwork>>16		beq	@isReadOnly		ldy	#icFType		; is the icon a disk ?		lda	[<ic],y		bmi	@isReadOnly		; bra if a disk icon		lda	<wind+2		cmp	<TrashWind+2		;see if it's in the trashcan		bne	@notInTrash		lda	<wind		cmp	<TrashWind		bne	@notInTrash				lda	#iconInTrash		tsb	DeskIconState@NotInTrash		ldy	#windAccess		;see if we can make changes		lda	[<windBlk],y		and	#icMakeChanges		bne	@isReadOnly				lda	#iconInLocked		;say icon is in a locked window on a server		tsb	DeskIconState	;; see if the icon came from a window which is from a read-only disk;@isReadOnly			ldy	#windFST		;get the window which contains this icon, get its FST		lda	[<windBlk],y		tay		jsl	isReadOnly		bcc	@isOnline				lda	#IconInLocked		;mark it as being an icon in a window which is locked (can't write)		tsb	DeskIconState		;; see if our disk is online;@isOnline	ldy	#icFlag		lda	[<ic],y			; is the icon offline ?		and	#ICOFFLINE		beq	@isNoAccess		lda	#iconOffline		; an offline icon is selected		tsb	DeskIconState;@isLocked	lda	[<ic],y			; is the icon locked ?;		and	#ICLOCKED;		beq	@isNoAccess;		lda	#iconLocked		; a locked icon is selected;		tsb	DeskIconState@isNoAccess	ldy	#icFlag+2		; is the icon readable ?		lda	[<ic],y		and	#ICREADABLE>>16		bne	@isDisk			; yes		lda	#iconNoAccess		; a no-access icon is selected		tsb	DeskIconState@isDisk		ldy	#icFType		; is the icon a disk ?		lda	[<ic],y		bpl	file			; bra if a file/folder icon;--- Trash and 5.25 Drive are not disks! -------		cmp	#TypeFTrash		; Trash icon selected ?		bcc	@notTrash		lda	#iconTrash		; trash icon is selected		tsb	DeskIconState		brl	done@notTrash	cmp	#TypeFloppy		;5.25 floppy disk icon selected?		bne	@isDrive		lda	#iconFloppy		tsb	DeskIconState		bra	disk@isDrive	cmp	#TypeFDrive		; Floppy drive icon selected ?		bne	@isServer		lda	#iconDrive		; 5.25 drive icon is selected		tsb	DeskIconState		bra	done@isServer	cmp	#TypeServer		;is this a server volume icon ?		bne	disk		lda	#iconServer		;a server icon is selected		tsb	DeskIconStatedisk		lda	#iconDisk		; a disk icon is selected		tsb	DeskIconState;; --- Is the disk icon REALLY write-protected? --------------;		ldy	#icDevInfo		lda	[<ic],y		and	#$0002		beq	@isRemovable				lda	#iconLocked		tsb	DeskIconState		;; --- Is the disk icon removable ? --------------;@isRemovable	ldx	EjectNonRemovable		beq	@noEject		ldy	#icFtype		;see if it's a hard drive partition		lda	[<ic],y		cmp	#TypeHardPart		beq	done@noEject	ldy	#icDevInfo		;12/2/90, andy		lda	[<ic],y		and	#$0004			;mask the removable (ejectable) bit		beq	done			;if it's not set, then we can't get rid of itremove		lda	#iconRemovable		; a removable icon is selected		tsb	DeskIconState		bra	done			; all done with disk type attributes		;--- Is the icon a document icon ? -------------file		cmp	#$000F			; find out what it isn't		beq	justFile		; folders aren't documents		cmp	#$00FF			; P8 applications aren't documents		beq	justFile		cmp	#$00B3			; GS/OS applications aren't documents		beq	justFile		lda	#iconDocument		; must be a document icon		tsb	DeskIconStatejustFile	lda	#iconFile		; file/folder icon is selected		tsb	DeskIconStatedone		lda	#iconAny		; always mark 'some icon' selected		tsb	DeskIconState		clc		rts				ENDP*===============================================**	Process A Menu Selection		**						** IN:	TaskRecord data				**						** OUT:	none					**===============================================*ProcessMenu	PROC	EXPORT		IMPORT	pushTask		import	SayExtrasChosen		import	controlKeyStatus		import	shiftKeyStatus		import	functionKey		import	openAppleKey		import	allowTellFinderCalls		pei	<modifiers		;Dave 'sez OR the modifiers together!		pha		pei <zero			;we want to know if they are		jsr	pushTask		;holding down the option key for tunneling		_GetNextEvent		pla		pla		ora	<modifiers		and	#$feff			;get rid of the apple key		sta	<modifiers		sta	srqMenuParms+6		jsr	SetupFunctionKeys				lda	<TaskData+2		; remember menu ID number		sta	saveMenuID		sta	srqMenuParms+4		lda	<TaskData		; a <-- menu item's ID number		cmp	#$f000			;is it something that was added to the		blt	@notWindowsItem		;windows menu?		lda	FunctionKey				bne	@optionSelect					lda	<taskData		jsr	PickAWindow		bra	unHilite@optionSelect	lda	<taskData		jsr	CloseAWindow		bra	unHilite;; if we get this far, it's not a Windows menu item;@notWindowsItem		cmp	#$e000		bcc	@notExtrasItem*** added 24-Mar-93 DAL -- preserve SaveMenuID		tax		lda SaveMenuID		pha		txa*** end 24-Mar-93		jsl	SayExtrasChosen		;in request.aii*** added 24-Mar-93 DAL		pla		sta	SaveMenuID*** end 24-Mar-93		bra	unHilite@notExtrasItem;; if we get this far, it's a regular menu item in the table;		sta	srqMenuParms+2		stz	srqMenuOutParms+2		lda	>allowTellFinderCalls		pha		lda	#$ffff		sta	>allowTellFinderCalls		pea	$0103			;finderSaysMItemSelected		ldx	<zero		phx				;how = send to everyone		phx		phx				;target = nil		pushlong #srqMenuParms		pushlong #srqMenuOutParms	;dataOut = keep going or not		_SendRequest		pla		sta	>allowTellFinderCalls		bcs	tellFinderSelectMItemEntry		lda	srqMenuOutParms+2		bne	unhilite;; finder extensions telling the Finder to select a menu item enter here;; TaskData, modifiers, and SaveMenuID are already valid at this point;		EXPORT	tellFinderSelectMItemEntrytellFinderSelectMItemEntry		lda	<TaskData		ldx	<zero@loop		cmp	MenuMap,x		; is this an item I know about?		beq	found			; yes		inx		inx		inx		inx		cpx	#EndMenuMap-MenuMap		bcc	@loop		bra	exit			; unknown menu id		found		jsr	(MenuMap+2,x)		; a-reg has item's idunHilite	lda	SaveMenuID		; pass menu ID		beq	exit		pei <zero			; pass Unhilite flag		pha		_HiliteMenuexit		rts	;; srqMenuParms and srqMenuOutParms;srqMenuParms	dc.w	3			;pcount		dc.w	0			;menu item id		dc.w	0			;menu id		dc.w	0			;modifierssrqMenuOutParms	dc.w	0			;recvCount		dc.w	0			;handledIt flag		;-----------------------------------------------MenuMap		DC.W	idAbout,AboutMenu		DC.W	idHelp,HelpMenu		DC.W	idNewFolder,NewFolderMenu		DC.W	idOpen,OpenMenu		DC.W	idPrint,PrintMenu		DC.W	idClose,CloseMenu		DC.W	idCloseAll,CloseAllMenu		DC.W	idDuplicate,DuplicateMenu		DC.W	idPutAway,PutAwayMenu		DC.W	idValidate,ValidateMenu		DC.W	idUndo,EditMenus		DC.W	idCut,EditMenus		DC.W	idCopy,EditMenus		DC.W	idPaste,EditMenus		DC.W	idClear,EditMenus		DC.W	idSelectAll,SelectAllMenu		DC.W	idShowClip,ShowClipMenu		dc.W	idStackWindows,StackWindows		DC.W	idByIcon,ViewMenus		DC.W	idByTinyIcon,ViewMenus		DC.W	idByName,ViewMenus		DC.W	idByDate,ViewMenus		DC.W	idBySize,ViewMenus		DC.W	idByKind,ViewMenus		DC.W	idFormat,FormatMenu		DC.W	idErase,EraseMenu		DC.W	idVerify,VerifyMenu		DC.W	idEject,EjectMenu		DC.W	idCleanUp,cleanUpMenu		DC.W	idEmptyTrash,EmptyTrashMenu		DC.W	idPreferences,PreferMenu		DC.W	idIconInfo,IconInfoMenu		DC.W	idShutDown,ShutDownMenu		DC.W	idCleanUpByName,CleanUpByNameMenu		DC.W	idColor_0,ColorMenus		DC.W	idColor_1,ColorMenus		DC.W	idColor_2,ColorMenus		DC.W	idColor_3,ColorMenus		DC.W	idColor_4,ColorMenus		DC.W	idColor_5,ColorMenus		DC.W	idColor_6,ColorMenus		DC.W	idColor_7,ColorMenus		DC.W	idColor_8,ColorMenus		DC.W	idColor_9,ColorMenus		DC.W	idColor_A,ColorMenus		DC.W	idColor_B,ColorMenus		DC.W	idColor_D,ColorMenus		DC.W	idColor_E,ColorMenus		DC.W	idColor_F,ColorMenusEndMenuMap;; setup the function keys by reading the modifiers field and checking the; resultant bits in the modifiers...;		EXPORT	setupFunctionKeysSetupFunctionKeys		stz	openAppleKey				lda	<modifiers		and	#$0200		sta	shiftKeyStatus				lda	<modifiers		and	#$1000		sta	controlKeyStatus		lda	<modifiers		and	#$0800			;mask for option key		sta	functionKey		rts				ENDP				END