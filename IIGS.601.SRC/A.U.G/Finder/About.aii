		seg 'ABOUT'; about.aii;; Copyright 1991-93 by Apple Computer, Inc.; All Rights Reserved;.....................................................................		LONGA	ON		LONGI	ON		STRING	PASCAL				PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM		INCLUDE	'ALL.MACROS'		INCLUDE	'E16.CONTROL'		INCLUDE	'E16.WINDOW'		INCLUDE	'PASCAL.macros'		INCLUDE	'special.macros'				PRINT	ONAboutWindow	PROC	EXPORT		IMPORT	lastAboutTime		IMPORT	aboutWindowPtr		IMPORT	aboutBlk		IMPORT	ArrowCursor		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCMhandlePtr	equ	1		phb		phk		plb		_WaitCursor				phd		pha		pha		tsc		tcd		pha		pha		_TickCount		pla		sta	>lastAboutTime		pla		pha		pha		pushlong #0			;titlePtr		pushlong #aboutBlk		;refCon is ptr to our window info block		pushlong #aboutDraw+$80000000	;content draw proc (background)		pushlong #0			;window defproc		pea	2			;refIsResource		pushlong #1			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2		pulllong >aboutWindowPtr		bcc	@ok	;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	>aboutWindowPtr		ora	>aboutWindowPtr+2		beq	@leave		lda	>aboutWindowPtr+2		tax		lda	>aboutWindowPtr		jsl	CloseThisWindow				lda	#0		sta	>aboutWindowPtr		sta	>aboutWindowPtr+2@leave		jsl	ArrowCursor				pla		pla		pld		plb		rtl;; we were able to create the window (and get all the controls attached to it);		@ok		pha		pha		_TotalMem		pulllong totalMem				ldx	#9		;divide by 1024tLoop		lsr	totalMem+2		ror	totalMem				dex		bpl	tLoop				lda	totalMem		pha		pushlong #$80000000+totalMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec				pha		pha		_RealFreeMem		pulllong realFreeMem				ldx	#9		;divide by 1024rLoop		lsr	realFreeMem+2		ror	realFreeMem		dex		bpl	rLoop				lda	realFreeMem		pha		pushlong #$80000000+realFreeMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec			jsl	calcMemoryUsed	;go calculate the amount of memory people are					;using.		ldx	#9		;divide everyone by 1024fLoop		lsr	finderMem+2		ror	finderMem						lsr	systemMem+2		ror	systemMem		lsr	daMem+2		ror	daMem				lsr	setupMem+2		ror	setupMem		dex		bpl	fLoop		lda	realFreeMem		sta	realFreeMemBefore		lda	finderMem		sta	finderMemBefore		lda	systemMem		sta	systemMemBefore		lda	daMem		sta	daMemBefore		lda	setupMem		sta	setupMemBefore				lda	finderMem		pha		pushlong #$80000000+finderMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec			lda	systemMem		pha		pushlong #$80000000+systemMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec		lda	daMem		pha		pushlong #$80000000+daMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec		lda	setupMem		pha		pushlong #$80000000+setupMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec		pha		pha		pea	$8029		;rVersion		pushlong #1		;ID=1		_LoadResource		pulllong finderVersionHandle				pea	$8029		;detach it so we can manage it		pushlong #1		_DetachResource				lda	finderVersionHandle		sta	handlePtr		lda	finderVersionHandle+2		sta	handlePtr+2						lda	[handlePtr]	;deref it		tax		ldy	#2		lda	[handlePtr],y		stx	handlePtr		stx	finderVersionPtr		sta	handlePtr+2		sta	finderVersionPtr+2				pea	0		ldy	#2		lda	[handlePtr],y		pha		lda	[handlePtr]		pha		pushlong #finderVersion		_VersionString				pha			;get the current resource file (Finder)		_GetCurResourceFile				pea	1		;use the stuff from sys.resources		_SetCurResourceFile				pha		pha		pea	$8029		;rVersion		pushlong #1		;ID=1		_LoadResource		pulllong systemVersionHandle				pea	$8029		;detach it so we can manage it		pushlong #1		_DetachResource				lda	systemVersionHandle		sta	handlePtr		lda	systemVersionHandle+2		sta	handlePtr+2						ldy	#4		;lock the handle down!		lda	[handlePtr],y		ora	#$8000		sta	[handlePtr],y				lda	[handlePtr]	;deref it		tax		ldy	#2		lda	[handlePtr],y		stx	handlePtr		stx	systemVersionPtr		sta	handlePtr+2		sta	systemVersionPtr+2				pea	0		;flags		ldy	#2		lda	[handlePtr],y	;the actual version string		pha		lda	[handlePtr]		pha		pushlong #systemVersion	;where to put it		_VersionString				_SetCurResourceFile	;reset the current resource file to the Finder		jsl	ArrowCursor				pla		pla		pld		plb		rtltotalMem	dc.L	0realFreeMem	dc.L	0finderMem	dc.L	0systemMem	dc.L	0daMem		dc.L	0setupMem	dc.L	0		EXPORT	realFreeMemBeforerealFreeMemBefore dc.w	0		EXPORT	finderMemBeforefinderMemBefore	dc.w	0		EXPORT	systemMemBeforesystemMemBefore	dc.w	0		EXPORT	daMemBeforedaMemBefore	dc.w	0		EXPORT	setupMemBeforesetupMemBefore	dc.w	0totalMemStr	str	'     K'realFreeMemStr	str	'     K'findermemStr	str	'     K'systemMemStr	str	'     K'daMemStr	str	'     K'setupMemStr	str	'     K'		EXPORT	finderVersionHandlefinderVersionHandle dc.L 0finderVersionPtr dc.L 0		EXPORT	systemVersionHandlesystemVersionHandle dc.L 0systemVersionPtr dc.L 0finderVersion	ds	10systemVersion	ds	10; see if anything changed from the last time we called this routine to update the; about window -- if anything did, inval the rect for the K used;................................................................		EXPORT doAboutRecalcdoAboutRecalc		phb		phk		plb				lda	>aboutWindowPtr+1		bne	@1		brl	doneRecalc2		@1		jsl	calcMemoryUsed	;don't do this too often				pha		pha		_GetPort		pushlong >aboutWindowPtr		_SetPort				pha		pha		_RealFreeMem		pulllong realFreeMem				ldx	#9		;divide everyone by 1024cLoop		lsr	realFreeMem+2		ror	realFreeMem		lsr	finderMem+2		ror	finderMem		lsr	systemMem+2		ror	systemMem		lsr	daMem+2		ror	daMem		lsr	setupMem+2		ror	setupMem		dex		bpl	cLoop		lda	realFreeMem		cmp	realFreeMemBefore		beq	checkFMem		sta	realFreeMemBefore				lda	realFreeMem		pha		pushlong #$80000000+realFreeMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec		pushlong #realFreeMemRect		_InvalRect		checkFMem	lda	finderMem		cmp	finderMemBefore		beq	checkSMem		sta	finderMemBefore		lda	finderMem		pha		pushlong #$80000000+finderMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec						pushlong #finderMemRect		_InvalRect				checkSMem	lda	systemMem		cmp	systemMemBefore		beq	checkDMem		sta	systemMemBefore				lda	systemMem		pha		pushlong #$80000000+systemMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec		pushlong #systemMemRect		_InvalRect		checkDMem	lda	daMem		cmp	daMemBefore		beq	checkSetupMem		sta	daMemBefore				lda	daMem		pha		pushlong #$80000000+daMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec		pushlong #daMemRect		_InvalRect		checkSetupMem	lda	setupMem		cmp	setupMemBefore		beq	doneRecalc		sta	setupMemBefore		lda	setupMem		pha		pushlong #$80000000+setupMemStr+1		pea	5		;5 chars available		pea	0		;unsigned		_Int2Dec		pushlong #setupMemRect		_InvalRectdoneRecalc	_SetPortdoneRecalc2 	plb		rtlrealFreeMemRect	dc.w	28,435-76,38,485-76finderMemRect	dc.w	44,145,54,195systemMemRect	dc.w	55,145,65,195daMemRect	dc.w	44,435-76,54,485-76setupMemRect	dc.w	55,435-76,65,485-76; calculate the amount of memory that the Finder, System, DAs, and Setup files are using;  by walking the handle list and finding who owns what and how big of a block they own.;; inputs: none;; outputs: finderMem is filled;          systemMem is filled;	   daMem is filled;	   setupMem is filled;; assumptions: $e1600 always points to the handle list;		we are able to disable interrupts while walking the list so no one;		disturbs the handle list behind our back;		handlePtr is defined above as 1;................................................................		EXPORT calcMemoryUsedcalcMemoryUsed			phb		phk		plb		pha		_MMStartUp		pla		sta	theFinderID		php				;disable interrupts while walking the		sei				;handle list		phd		pha		pha		tsc		tcd				stz	finderMem		stz	finderMem+2				stz	systemMem		stz	systemMem+2				stz	daMem		stz	daMem+2				stz	setupMem		stz	setupMem+2				lda	>$e11600		sta	handlePtr		lda	>$e11600+2		sta	handlePtr+2look		ldy	#4		lda	[handlePtr],y		bmi	includeLocked		;if it's locked, include it		and	#%0000001100000000	;check the purgable bits in attrib word		bne	nextHandle		;if it's the least bit purgable, don't include it				includeLocked	ldy	#6		lda	[handlePtr],y		beq	nextHandle		;never, ever add ID's of just zero		tax				;keep the ID handy for a sec		eor	theFinderID		and	#$F0FF			;Finder memory is "application", and		beq	addApp			;other $1xxx memory is not counted!		txa				;get the ID back		and	#$f000		xba				lsr	a		lsr	a		lsr	a				tax		jmp  	(addr,x)theFinderID	dc.w	0		addr		dc.W	addSystem		;0=memory manager's unmanaged areas		dc.W	nextHandle		;1=application, other than the Finder		dc.W	nextHandle		;2=control program		dc.W	addSystem		;3=GSOS		dc.W	addSystem		;4=Toolsets		dc.W	addDA			;5=Desk Accessories		dc.W	addSystem		;6=runtime libraries		dc.W	addSystem		;7=system loader		dc.W	addSystem		;8=firmware		dc.W	addSystem		;9=tool locator		dc.W	addSetup		;A=setup files		dc.W	nextHandle		;B=undefined		dc.W	nextHandle		;C=undefined		dc.W	nextHandle		;D=undefined		dc.W	nextHandle		;E=undefined		dc.W	nextHandle		;F=undefined		;; find the next handle (if there is one);nextHandle	ldy	#16		lda	[handlePtr],y		tax		bne	notDoneYet				iny		iny		lda	[handlePtr],y		beq	doneCalc		stx	handlePtr		sta	handlePtr+2		bra	looknotDoneYet	iny		iny		lda	[handlePtr],y		stx	handlePtr		sta	handlePtr+2		bra	lookaddApp		ldy	#8		lda	[handlePtr],y		clc		adc	finderMem		sta	finderMem		iny		iny		lda	[handlePtr],y		adc	finderMem+2		sta	finderMem+2		bra	nextHandle		addSystem	ldy	#8		lda	[handlePtr],y		clc		adc	systemMem		sta	systemMem		iny		iny		lda	[handlePtr],y		adc	systemMem+2		sta	systemMem+2		bra	nextHandleaddDA		ldy	#8		lda	[handlePtr],y		clc		adc	daMem		sta	daMem		iny		iny		lda	[handlePtr],y		adc	daMem+2		sta	daMem+2		bra	nextHandle		addSetup	ldy	#8		lda	[handlePtr],y		clc		adc	setupMem		sta	setupMem		iny		iny		lda	[handlePtr],y		adc	setupMem+2		sta	setupMem+2		bra	nextHandle		doneCalc	lda	#<$15000	;manually compensate for those memory manager		clc			;blocks which are included in the language card		adc	systemMem	;areas and elsewhere (see: 0ink in niftylist)		sta	systemMem		lda	#^$15000		adc	systemMem+2		sta	systemMem+2		pla		pla		pld				plp			;re-enable interrupts		plb		rtl; Draw the about box with all the memory figures;...................................................................................aboutDraw	phb		phk		plb				phd		pha		pha		tsc		tcd				pushlong #memRect	;erase what memory stuff might have been there		_EraseRect						pushlong >aboutWindowPtr		_DrawControls			lda	systemVersionPtr		sta	handlePtr		lda	systemVersionPtr+2		sta	handlePtr+2				pea	120		pea	24		_MoveTo		ldy	#6		;add the length of the first string to		lda	[handlePtr],y	;where our handle ptr points to		and	#$00ff		;so we can find the second string		clc		adc	handlePtr 		tax		lda	handlePtr+2		adc	#0		tay				txa			;now, add 6 to the address to compensate for		clc			;the international word and version long		adc	#7		;but add 7 to compensate for the length byte of the		tax			;first string		tya		adc	#0		pha		phx		_DrawString		;draw Copyright string from Finder					pea	120		;print 'System Software' in the box		pea	13		;(just in case someone in international decides		_MoveTo			;to call it Systeme or something)		lda	systemVersionPtr		clc		adc	#6		tax		lda	systemVersionPtr+2		adc	#0		pha		phx		_DrawString		pea	4		;move over 4 pixels (Dave says it's one space		pea	0		;in Shaston 8)		_Move		pushlong #systemVersion		_DrawString				pha		pushlong #totalMemStr		_StringWidth				lda	#195		sec		sbc	1,s		sta	1,s		;we avoid pulling and pushing				pea	38		_MoveTo		pushlong #totalMemStr		_DrawString				pha		pushlong #realFreeMemStr		_StringWidth				lda	#485-76		sec		sbc	1,s		sta	1,s		;we avoid pulling and pushing				pea	38		_MoveTo		pushlong #realFreeMemStr		_DrawString				pha		pushlong #finderMemStr		_StringWidth				lda	#195		sec		sbc	1,s		sta	1,s		;we avoid pulling and pushing				pea	53		_MoveTo		pushlong #finderMemStr		_DrawString				pha		pushlong #daMemStr		_StringWidth				lda	#485-76		sec		sbc	1,s		sta	1,s				pea	53		_MoveTo		pushlong #daMemStr		_DrawString				pha		pushlong #systemMemStr		_StringWidth				lda	#195		sec		sbc	1,s		sta	1,s		;we avoid pulling and pushing (DAL)				pea	64		_MoveTo		pushlong #systemMemStr		_DrawString				pha		pushlong #setupMemStr		_StringWidth				lda	#485-76		sec		sbc	1,s		sta	1,s		;we avoid pulling and pushing				pea	64		_MoveTo		pushlong #setupMemStr		_DrawString		pla		pla		pld				plb		rtlmemRect		dc.w	26,140,66,490			Export UnloadSegsUnloadSegs	pha		_MMStartup		lda #0		pha		pha		_UnloadSegNum		rtl		ENDP		END