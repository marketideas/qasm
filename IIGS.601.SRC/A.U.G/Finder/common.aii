*****************************************************************							       **		     Common Strip Routines		       **			 Version 1.0D3			       **			August 13, 1986			       **							       *; 05/23/88 DJB	- Added Darryl's Color Menu stuff*********************************************************************************************************************************							       **		    Copyright (C) 1985-1989		       **		    All	Rights Reserved			       **		    Apple Computer, Inc.		       **							       *****************************************************************		PRINT	OFF		PRINT	NOGEN		PRINT	NOSYM		MACHINE	M65816		INCLUDE	'ALL.MACROS'		INCLUDE	'special.macros'		INCLUDE	'E16.CONTROL'		INCLUDE	'finder.equ'		INCLUDE	'GetInfo.equ'		PRINT	ONDecBusyFlg	equ	$E10068;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	ErrOut		seg	'CONTROL'COMMON		PROC		ENDP****************************************************************** EndCall Routines.** Functions exit through the EndCall routines.	These routines* fix the stack	by moving the RTL addresses up and stripping* off any input	parameters.** The number of	bytes to strip off the stack is	passed in the* y-register.** There	are 8 end call routines**	EndCall	       Pulls D off stack before	cleaning up.  Sets*		       a-reg to	zero and clears	carry.*	oEndCall       Does not	pull D off the stack before*		       cleaning	up.  Sets a-reg	to zero	and clears*		       carry.*	ErrOut	       Pulls D off stack, cleans up and	returns*		       error code passed in x-register,	setting*		       carry if	x is not zero.*	oErrOut	       Does not	pull D off stack before	cleaning up.*		       returns error code passed in x-register,*		       setting carry if	x is not zero.**	BusyEC	       Decrements the busy flag, pulls D off stack*		       and cleans up.*	oBusyEC	       Decrements the busy flag, does not pull D off stack*		       and cleans up.*	BusyErr	       Decrements the busy flag, pulls D off stack,*		       cleans up and returns error code	passed in*		       x-register, setting the carry if	x is not zero.*	oBusyErr       Decrements the busy flag, does not pull D off*		       the stack, cleans up and	returns	error code passed*		       in x-register.*****************************************************************		EXPORT	StripStrip		PROC		EXPORT	BusyECBusyEC		ldx	#0		EXPORT	BusyErrBusyErr		jsl	DecBusyFlg		bra	ErrOut		EXPORT	EndCallEndCall		ldx	#0		EXPORT	ErrOutErrOut		pld			; restore direct register		EXPORT	oErrOutoErrOut					;       		phy			; save amount to strip on stack		tsc			; get stack pointer		clc			; add to it the	amount to strip		adc	1,s		tay			; put this result in Y		tsc			; get back orig	stack pointer		phx			; save error on	stack		tax			; put orig stack in X		phb			; now save the data bank reg		pea	$0000		; set data bank	reg to 0		plb		plb		lda	|3+4,x		; now use x and	y to move 6 bytes		sta	|3+4,y		; of rtl info from current pos		lda	|3+2,x		; to final pos.		sta	|3+2,y		lda	|3+0,x		sta	|3+0,y		plb			; restore data bank register		plx			; restore x register with error		tsc			; get stack again		clc			; bump it by amount to strip Plus 2		adc	1,s		; to make up for amount	to strip		adc	#2		; still	on stack		tcs			; reset	stack pointer		txa			; error	into a-reg		cmp	#1		; set carry correctly		rtl			; fini		EXPORT	oBusyECoBusyEC					;       		ldx	#0		EXPORT	oBusyErroBusyErr				;       		jsl	DecBusyFlg		bra	oErrOut		EXPORT	oEndCalloEndCall				;       		ldx	#0		bra	oErrOut		ENDP*===============================================**	     Data for custom control		**===============================================*MyData		RECORD		ENTRY	Style:DATA		ENTRY	FillRect:DATA		ENTRY	Colors:DATA		ENTRY	ColorPen:DATA		ENTRY	ColorBack:DATA		ENTRY	ColorIFore:DATA		ENTRY	ColorIBack:DATA		ENTRY	OldPenState:DATA		ENTRY	NewPenState:DATA		ENTRY	PenWidth:DATA		ENTRY	PenPattern:DATAStyle		DC.W	0		;0 = vertical, 1 = horizontalColorsColorPen	DC.W	0		;outlineColorBack	DC.W	0		;interiorColorIFore	DC.W	0		;indicator foregroundColorIBack	DC.W	0		;indicator background (& solid)OldPenState	DS.B	50		;space for PenState recordNewPenState	DC.W	0,0		;pen location		DC.W	1		;pen heightPenWidth	DC.W	1		;pen width		DC.W	$0000		;pen modePenPattern	DC.W	$0000,$0000,$0000,$0000	;pen pattern		DC.W	$0000,$0000,$0000,$0000		DC.W	$0000,$0000,$0000,$0000		DC.W	$0000,$0000,$0000,$0000		DC.B	$FF,$FF,$FF,$FF	;pen mask		DC.B	$FF,$FF,$FF,$FFFillRect				;indicator boundry rectRectY1		DC.W	0RectX1		DC.W	0RectY2		DC.W	0RectX2		DC.W	0		ENDR************************************************************COLORMENUDEF	PROC EXPORT** by Steven E. Glass* August 9, 1988** Written in the middle of the night (the day we freeze* to avoid using code created by the TML Pascal compiler.** This is the menu definition procedure called by the* MenuManager to draw our custom color menu.** The menu is defined by cMenuRects in the file* data.aii** External Refs** Entrys*		none** Mode		longa on		longi on**************************************************************GapH		equ	5GapV		equ	2True		equ	$FFFFFalse		equ	$0000		DefineStackOrigD		wordRTLAdr		block 3MenuParam	wordMenuY		wordMenuX		wordMenuRectPtr	longMenuHandle	longMenuMsg		wordResultWord	wordSizeInputs	equ ResultWord-MenuParam		phd		tsc		tcd		phb		phk		plb					stz ResultWord	; init result			PushLong #SavedPenState		_GetPenState			pea     2		pea     1		_SetPenSize			lda MenuMsg		asl a		tax			jsr (MsgTable,x)			PushLong #SavedPenState		_SetPenState			lda RTLAdr		sta RTLAdr+SizeInputs		lda RTLAdr+1		sta RTLAdr+SizeInputs+1			plb	; restore dbr			pld		tsc		clc		adc #SizeInputs		tcs		rtlMsgTable	dc.W DrawMenu		dc.W ChooseMenu		dc.W SizeMenu		dc.W DrawTitle		dc.W DrawItem		dc.W GetItemID;-----------------------------------------------------------;; Draws the entire menu.;DrawMenu		pea 0000@loop		pla		cmp #15		bcs @done			inc a		pha		ldx #0		jsr DrawThisItem			bra @loop	@Done		rts;-----------------------------------------------------------;; Does the hit test for the menu manager.;ChooseMenu; first check to point is even in the menu 		pha		lda #MenuY		jsr PushDP		pei MenuRectPtr+2		pei MenuRectPtr		_PtInRect		pla		beq @NeverMind	; now loop through and find out which rect its in;		pea 0000	; start with zero@loop		pla		cmp #15		bcs @done			inc a	; bump and pub back on stack		pha			jsr MoveThisRectToTemp		jsr OffsetTempRect			lda TempRect	; expand for gaps between rects		sec		sbc #GapV		sta TempRect			lda TempRect+2		sec		sbc #GapH		sta TempRect+2			lda TempRect+4		clc		adc #GapV		sta TempRect+4			lda TempRect+6		clc		adc #GapH		sta TempRect+6					pha		lda #MenuY		jsr PushDP		PushLong #TempRect		_PtInRect		pla		beq @loop	; Found the right item.;		pla	; remove counter from stack		ora #$8000		sta ResultWord			ldy #2	; check to see if menu is disabled		lda [MenuHandle],y		tax		lda [MenuHandle]		sta MenuHandle		stx MenuHandle+2			ldy #$000A	; offset to flags word		lda [MenuHandle],y		and #$0080	; is the m-disabled		beq @nochange			lda #$4000	; is disabled so set this bit		tsb ResultWord	@nochange@Done@NeverMind		rts;-----------------------------------------------------------;; Do nothing, just return false.;SizeMenu		rts;-----------------------------------------------------------;; Do nothing, just return false.DrawTitle		rts;-----------------------------------------------------------;; DrawItem		lda MenuParam		and #$3FFF		ldx #True		jsr DrawThisItem			rts;-----------------------------------------------------------;; GetItemID		lda MenuParam		; take the incoming parameter		cmp #$000D		; if D or greater, inc to avoid second gray		bcc @NoPatch		inc a@NoPatch	clc			; add to offset to return desired id		adc #idColorMenu		sta ResultWord		rts;-----------------------------------------------------------;; Draws the desired item passed in a-reg; Use x-reg as hilite flag;DrawThisItem		phx		pha		jsr MoveThisRectToTemp			jsr OffsetTempRect			lda 3,s	; look at hilite flag		beq @NoHilite	@Hilite		dec TempRect		inc TempRect+4		lda TempRect+2		sec		sbc #4		sta TempRect+2		lda TempRect+6		clc		adc #4		sta TempREct+6			pea     4		pea     1		_SetPenSize			pea     2		_SetPenMode			pea     $FFFF		_SetSolidPenPat			PushLong #TempRect		_FrameRect			pla		pla			rts			@NoHilite			pla			; which rect in a-reg		PushLong #TempRect	; a-reg preserved		pea     0		; still preserved		dec a			; convert to 0 based counter to use as index		asl a			; into table		tax		lda cMenuPats,x		pha		_SpecialRect			pla	; clear off hilite flag			rts	;-----------------------------------------------------------;; Offsets the temp rect by menu rect;OffsetTempRect		lda TempRect	; offset the temp rect by menurect		clc		adc [MenuRectPtr]		sta TempRect		lda TempRect+2		clc		ldy #2		adc [MenuRectPtr],y		sta TempRect+2			lda TempRect+4		clc		adc [MenuRectPtr]		sta TempRect+4		lda TempRect+6		clc		ldy #2		adc [MenuRectPtr],y		sta TempRect+6			rts;-----------------------------------------------------------;; Moves the rect passed in a-reg from rect table to; temp rect.;MoveThisRectToTemp		dec a			; convert to zero based counter		asl a			; to use as index into table		asl a		asl a		tax			lda cMenuRects,x		sta TempRect		lda cMenuRects+2,x		sta TempRect+2		lda cMenuRects+4,x		sta TempRect+4		lda cMenuRects+6,x		sta TempRect+6		rts;-----------------------------------------------------------;; pushes long pointer to offset on d-page; a-reg contains the offset;PushDP		plx			; save rts		pea 0000		; hi word is zero		pha			; put d-page offset on stack		tdc		clc			; add in d-page		adc 1,s		sta 1,s		phx		rts;################################################################;#								#;#   Pre-Computed rectangles for each menu item, this takes a	#;#   lot less space and is faster than doing the calculations	#;#								#;################################################################cellV		equ	12	; height of a cellcellH		equ	40	; width of a cell	cMenuRects	DC.W	1*gapV+0*cellV,1*gapH+0*cellH,1*gapV+1*cellV,1*gapH+1*cellH	; rect 0		DC.W	1*gapV+0*cellV,2*gapH+1*cellH,1*gapV+1*cellV,2*gapH+2*cellH	; rect 1		DC.W	1*gapV+0*cellV,3*gapH+2*cellH,1*gapV+1*cellV,3*gapH+3*cellH	; rect 2			DC.W	2*gapV+1*cellV,1*gapH+0*cellH,2*gapV+2*cellV,1*gapH+1*cellH	; rect 3		DC.W	2*gapV+1*cellV,2*gapH+1*cellH,2*gapV+2*cellV,2*gapH+2*cellH	; rect 4		DC.W	2*gapV+1*cellV,3*gapH+2*cellH,2*gapV+2*cellV,3*gapH+3*cellH	; rect 5		DC.W	3*gapV+2*cellV,1*gapH+0*cellH,3*gapV+3*cellV,1*gapH+1*cellH	; rect 6		DC.W	3*gapV+2*cellV,2*gapH+1*cellH,3*gapV+3*cellV,2*gapH+2*cellH	; rect 7		DC.W	3*gapV+2*cellV,3*gapH+2*cellH,3*gapV+3*cellV,3*gapH+3*cellH	; rect 8		DC.W	4*gapV+3*cellV,1*gapH+0*cellH,4*gapV+4*cellV,1*gapH+1*cellH	; rect 9		DC.W	4*gapV+3*cellV,2*gapH+1*cellH,4*gapV+4*cellV,2*gapH+2*cellH	; rect 10		DC.W	4*gapV+3*cellV,3*gapH+2*cellH,4*gapV+4*cellV,3*gapH+3*cellH	; rect 11		DC.W	5*gapV+4*cellV,1*gapH+0*cellH,5*gapV+5*cellV,1*gapH+1*cellH	; rect 12		DC.W	5*gapV+4*cellV,2*gapH+1*cellH,5*gapV+5*cellV,2*gapH+2*cellH	; rect 13		DC.W	5*gapV+4*cellV,3*gapH+2*cellH,5*gapV+5*cellV,3*gapH+3*cellH	; rect 14;################################################################;#								#;#   patterns for each color menu item.				#;#								#;################################################################cMenuPats	DC.W	$0000,$1111,$2222,$3333,$4444,$5555,$6666,$7777		DC.W	$8888,$9999,$AAAA,$BBBB,$DDDD,$EEEE,$FFFF	TempRect	dc.w 0,0,0,0SavedPenState	ds.b 50			; size of pen state record		ENDP*===============================================** Card deck Custom control DefProc		**===============================================*		DefineStackctlPtr		long				;stack & DP offsetsctlColorPtr	longcardPtr		longrtlAddr		block 3	ctlHandle	longctlParam	longctlMessage	wordrtlValue	longparmSize	SET	10			;bytes used by parametersrect		RECORD  0;----------------------------------------------top		DS.W	1left		DS.W	1bottom		DS.W	1right		DS.W	1sizeOf;-----------------------------------------------		ENDRCustCtlRecord	RECORD  0;----------------------------------------------ctlNext		DS.L	1ctlOwner	DS.L	1ctlRect		DS	rectctlFlag		DS.B	1ctlHilite	DS.B	1ctlValue	DS.W	1ctlProc		DS.L	1ctlAction	DS.L	1ctlData		DS.L	1ctlRefCon	DS.L	1ctlColor	DS.L	1ctlReserved	DS.B	16ctlID		DS.L	1ctlMoreFlags	DS.W	1ctlVersion	DS.W	1ctlTabHeight	DS.W	1ctlTabWidth	DS.W	1ctlTabSpace	DS.W	1ctlCardCount	DS.W	1sizeOf;-----------------------------------------------		ENDRCardTemplate	RECORD  0;----------------------------------------------pCount		DS.W	1id		DS.L	1rect		DS	RectprocRef		DS.L	1flag		DS.W	1moreFlags	DS.W	1refCon		DS.L	1value		DS.W	1count		DS.W	1tabHeight	DS.W	1tabWidth	DS.W	1tabSpace	DS.W	1colorRef	DS.L	1cardRef		DS.L	1;-----------------------------------------------		ENDRpartCodeBase	EQU	160			;application part codeswireColor	EQU	$3333			;dark greycdStrings	EQU	2; --- Color record offsets ---outline		EQU	0			;outline colorbackground	EQU	outline+2		;background colorinterior	EQU	background+2		;interior colortext		EQU	interior+2		;text color*===============================================**	 Local Data for Custom Card Control	**===============================================*CardData	PROC		ENTRY	InteriorPatInteriorPat	DS.B	32			;interior pattern (inside card)		ENTRY	BackgroundPatBackgroundPat	DS.B	32			;background pattern (outside card)			ENTRY	NumberOfCardsNumberOfCards	DC.W	0		ENTRY	CurrentCardCurrentCard	DC.W	0		ENTRY	TabHeightTabHeight	DC.W	0		ENTRY	TabWidthTabWidth	DC.W	0		ENTRY	TabSpaceTabSpace	DC.W	0		ENTRY	TabRectTabRect		DS	rect		ENTRY	MousePointMousePoint	DC.W	0		;current mouse position			ENTRY	CardColorTblCardColorTbl	DC.W	$0000,$000F,$000F,$0000	;default color table		ENTRY	FrameRectFrameRect	DS	rect			;outside boundry rect		ENTRY	TempPatternTempPattern	DS.B	16			;space for shifted pattern		ENTRY	SpiralPatternSpiralPattern	DS.B	32				ENTRY	WirePatternWirePattern	DC.W	$0000			;8 x 8 spiral's wire pattern		DC.W	$00F0		DC.W	$0F0F		DC.W	$0F00			DC.W	$0F00			;wire only		DC.W	$0F00		DC.W	$0F00		DC.W	$0000				ENTRY	BasePattern		ENTRY	BasePattern2BasePattern	DC.W	$0000			;8 x 8 spiral's base pattern		DC.W	$0000		DC.W	$0000		DC.W	$FFFF			;outline & background (top)BasePattern2	DC.W	$0000		DC.W	$FFF0					DC.W	$F0F0		DC.W	$FFF0			;hole & interior (bottom)		ENTRY	TempRectTempRect	DS	rect		ENDP	*===============================================**          Setup Data for Custom Control	**						** - Creates QD Patterns:			**       Pen (PenPattern)			**       Interior (InteriorPat)			**       Backgorund (BackgroundPat)		** 						** INPUT:	--- In Direct Page ---		**		ctlParam   (Long)		**		ctlHandle  (Long)		**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue   (Long)		**						**===============================================*CardSetUp	PROC				WITH	CustCtlRecord		IMPORT	FillRect:rect		IMPORT	FrameRect:rect		ldy	#ctlFlag		;get style flag		lda	[<ctlPtr],y		and	#$0001		sta	Style				ldy	#ctlCardCount		;get number of cards		lda	[<ctlPtr],y		sta	NumberOfCards		ldy	#ctlTabHeight		;get tab dimentions		lda	[<ctlPtr],y		sta	TabHeight		ldy	#ctlTabWidth		lda	[<ctlPtr],y		sta	TabWidth		ldy	#ctlTabSpace		lda	[<ctlPtr],y		sta	TabSpace				ldy	#ctlValue		;get current card		lda	[<ctlPtr],y		sta	CurrentCard				ldy	#ctlData		;get card table ptr		lda	[ctlPtr],y		sta	cardPtr		iny		iny		lda	[ctlPtr],y		sta	cardPtr+2			jsr	SetColors		;create colors		jsr	SetPatterns		;create patterns		jsr	SetRectangles		;create rectangles		exit		rts		*===============================================**	Set up Colors from Color Table		**===============================================*SetColors		ldy	#ctlColor		;get color table ptr		lda	[ctlPtr],y		sta	<ctlColorPtr		iny		iny		lda	[ctlPtr],y		sta	<ctlColorPtr+2			ora	<ctlColorPtr		bne	copyColors		lda	#^CardColorTbl		;use default table		sta	<ctlColorPtr+2		lda	#CardColorTbl		sta	<ctlColorPtrcopyColors		ldy	#0@loop0		lda	[<ctlColorPtr],y		and	#$000F		pha		asl	a		asl	a		asl	a		asl	a		ora	1,s		sta	1,s		xba		ora	1,s		sta	Colors,y		pla		iny		iny		cpy	#4*2		bcc	@loop0		rts		*===============================================**	    Set up the Patterns			**===============================================*SetPatterns					;create spiral pattern		ldy	#6@loop1		lda	BasePattern,y		and	Colors+outline		;add outline color		pha		lda	BasePattern,y		eor	#$FFFF		and	Colors+background	;add background color		ora	1,s		sta	SpiralPattern,y		;save it		lda	BasePattern2,y		and	Colors+outline		;add outline color			sta	1,s		lda	BasePattern2,y		eor	#$FFFF		and	Colors+interior		;add interior color		ora	1,s		sta	SpiralPattern+8,y	;save it		pla		dey		dey		bpl	@loop1		ldy	#14@loop2		lda	WirePattern,y		and	#wireColor		;add wire color		pha		lda	WirePattern,y		eor	#$FFFF		and	SpiralPattern,y		;add base colors		ora	1,s		sta	SpiralPattern,y		;save it		pla		dey		dey		bpl	@loop2						;create fill patterns		ldy	#30@loop3		lda	Colors+outline		sta	PenPattern,y		;outline		lda	Colors+interior		sta	InteriorPat,y		;interior		lda	Colors+background		sta	BackgroundPat,y		;background		dey		dey		bpl  @loop3				rts		*===============================================**	    Set up the Rectangles		**===============================================*		ENTRY	SetRectanglesSetRectangles					;calculate Fill & Frame rects		ldy	#ctlRect		lda	[ctlPtr],y	;Y1		inc	a		sta	FillRect.top		inc	a		inc	a		sta	FrameRect.top		iny		iny		lda	[ctlPtr],y	;X1		sta	FrameRect.left		inc	a		inc	a		sta	FillRect.left		iny		iny		lda	[ctlPtr],y	;Y2		sec		sbc	#11		sta	FrameRect.bottom		dec	a		sta	FillRect.bottom		iny		iny		lda	[ctlPtr],y	;X2		sta	FrameRect.right		dec	a		dec	a		sta	FillRect.right		rts				ENDWITH		ENDP			*===============================================**	Get X coordinate of Tab in A-reg	** 						** INPUT:	CurrentCard			**						** OUTPUT:	none				*	*						**===============================================*GetTabX		PROC		IMPORT	FrameRect:rect		cmp	#0		beq	exit		pha		pha		dec	a		pha				; cards-1		lda	TabWidth		clc		adc	#6			;tab spacing		pha		_Multiply			;(cards-1) * (width+spacing)		pla		plx		clc		adc	#6			;tab spacing		adc	FrameRect.leftexit		rts				ENDP		*===============================================**              Select Current Card's Tab	** 						** INPUT:	A-Reg has tab to select		**						** OUTPUT:	none				*	*						**===============================================*SelectTab	PROC		IMPORT	FillRect:rect				cmp	#0		beq	exit		pha				;save which tab						;fill in all tabs		PushWord FillRect.left		;X begin		PushWord FillRect.bottom	;Y begin		_MoveTo		PushWord FillRect.right		;X end		PushWord FillRect.bottom	;Y end		_LineTo		PushLong #InteriorPat		_SetPenPat			;make pen an eraser		pla				;get back which tab		jsr	GetTabX		pha				;X position		PushWord FillRect.bottom	;Y position		_MoveTo		PushWord TabWidth		;X displacement		pea     0			;Y displacement		_Line				;fake active tab		PushLong #PenPattern		;restore pattern		_SetPenPatexit		rts				ENDP		*===============================================**    Draw controls by clearing invisible bit	** 						** INPUT:	card (a-reg)			**						** OUTPUT:	none				*	*						**===============================================*DrawControls	Proc		WITH	CustCtlRecord		dec	a		bmi	exit			; bad card number		asl	a		asl	a		tay				lda	[<cardPtr],y		; get pointer to card's data		clc		adc	#4			; skip over string pointer		tax				; save as index 		iny		iny		lda	[<cardPtr],y		sep	#$20		pha				; set data bank		plb		rep	#$20loop		lda	|$0000,x		; get control IDs		ora	|$0002,x		beq	done			; terminated by null ID		phx		pha				; space for handle (long)		pha		PushLong [<ctlPtr],ctlOwner		PushLong |$0000,x		; ID of control		_GetCtlHandleFromID		_ShowControl			; show it		plx				lda	|$0000,x		cmp	#idCommentFld		bne	@notComment				phx		pha				; space for handle (long)		pha		PushLong [<ctlPtr],ctlOwner		PushLong |$0000,x		; ID of control		_GetCtlHandleFromID		_MakeThisCtlTarget		plx		@notComment	inx				; to next ID (long)		inx		inx		inx		bra	loop		done		phk		plb				; restore data bankexit		rts		ENDWITH		ENDP		*===============================================**    Hide controls by setting invisible bit	** 						** INPUT:	card (a-reg)			**						** OUTPUT:	none				*	*						**===============================================*HideControls	Proc			WITH	CustCtlRecord		dec	a		bmi	exit			; bad card number		asl	a		asl	a		tay				lda	[<cardPtr],y		; get pointer to card's data		clc		adc	#4			; skip over string pointer		tax				; save as index 		iny		iny		lda	[<cardPtr],y		sep	#$20		pha				; set data bank		plb		rep	#$20loop		lda	|$0000,x		; get control IDs		ora	|$0002,x		beq	done			; terminated by null ID		phx		pha				; space for handle (long)		pha		PushLong [<ctlPtr],ctlOwner			PushLong |$0000,x		; ID of control		_GetCtlHandleFromID		phd		tsc		tcd		ldy 	#2			;dereference handle		lda	[<$03],y		tax		lda	[<$03]		sta	<$03		stx	<$03+2		ldy	#ctlFlag		lda	[<$03],y		; get flag		ora	#ctlInVis		; set invisible bit		sta	[<$03],y		; set flag		pld		pla				; remove pointer		pla		plx		inx				; to next ID (long)		inx		inx		inx		bra	loop		done		phk		plb				; restore data bankexit		rts		ENDWITH		ENDP		*===============================================**    Show controls by clearing invisible bit	** 						** INPUT:	card (a-reg), cardPtr		**						** OUTPUT:	none				*	*						**===============================================*ShowControls	Proc		WITH	CustCtlRecord		dec	a		bmi	exit			; bad card number		asl	a		asl	a		tay				lda	[<cardPtr],y		; get pointer to card's data		clc		adc	#4			; skip over string pointer		tax				; save as index 		iny		iny		lda	[<cardPtr],y		sep	#$20		pha				; set data bank		plb		rep	#$20loop		lda	|$0000,x		; get control IDs		ora	|$0002,x		beq	done			; terminated by null ID		phx		pha				; space for handle (long)		pha		PushLong [<ctlPtr],ctlOwner			PushLong |$0000,x		; ID of control		_GetCtlHandleFromID		phd		tsc		tcd		ldy 	#2			; dereference handle		lda	[<$03],y		tax		lda	[<$03]		sta	<$03		stx	<$03+2		ldy	#ctlFlag		lda	[<$03],y		; get flag		and	#Å(ctlInVis)		; clear invisible bit		sta	[<$03],y		; set flag		pld		pla				; remove pointer		pla		plx		inx				; to next ID (long)		inx		inx		inx		bra	loop		done		phk		plb				; restore data bankexit		rts		ENDWITH		ENDP		*===============================================**            Draw the Custom Control		** 						** INPUT:	--- In Direct Page ---		**		ctlParam   (Long)		**		ctlHandle  (Long)		**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue   (Long)		**						**===============================================*MyDrawControl	Proc		IMPORT	FillRect:rect		IMPORT	FrameRect:rect		WITH	CustCtlRecord		jsr  CardSetUp				pha				;space for handle		pha		_GetPort		PushLong [ctlPtr],ctlOwner		_SetPort			;set to our window				PushLong #OldPenState		;save their settings		_GetPenState		PushLong #NewPenState		;use our settings		_SetPenState				lda	<ctlParam		;get part code		beq	all			;0 means entire control		sec		sbc	#partCodeBase		bra	select			;just draw this tab		all		pea	2			;make pen square		pea	1		_SetPenSize			PushLong #FrameRect		_FrameRect			;draw card's frame		pea	1			;restore pen size		pea     1		_SetPenSize			;		PushLong #FillRect;		PushLong #InteriorPat;		_FillRect			;draw card's interior		jsr	DrawSpiral		;draw spiral at top		jsr	DrawTabs		;draw tabs at bottom		jsr	DrawTabText		;draw tab text		lda	CurrentCardselect		jsr	SelectTab		;select current tab		done		PushLong #OldPenState		;restore settings		_SetPenState		_SetPort		stz	rtlValue		stz	rtlValue+2		rts		*===============================================**              Draw Tab Text			**===============================================*DrawTabText	pha		_GetBackColor		PushWord Colors+interior		_SetBackColor		lda	#0@text		pha				; save counter		asl	a		asl	a		tay				lda	[<cardPtr],y		tax		iny		iny		lda	[<cardPtr],y		sep	#$20		pha				; set data bank		plb		rep	#$20		pha				; space for string width		lda	|$0002,x		; push ptr to string		pha		sta	>StringPtr+2		lda	|$0000,x		pha		sta	>StringPtr		phk		plb				; restore data bank		_StringWidth		lda	TabWidth		sec		sbc	1,s		lsr	a		sta	1,s			;offset inside tab				lda	3,s			;card = counter + 1		inc	a		jsr	GetTabX			;offset to tab		clc		adc	1,s		inc	a		inc	a		sta	1,s			;X start		lda	TabHeight		sbc	#7		lsr	a		clc		adc	FrameRect.bottom		adc	#7		pha				;Y start		_MoveTo		PushLong StringPtr		_DrawString		pla				;get counter		inc	a		cmp	NumberOfCards		bcc	@text		_SetBackColor			;restore background pattern		rtsStringPtr	DC.L	0*===============================================**              Draw Spiral Part			**===============================================*DrawSpiral	ldy	#ctlRect.top		lda	[<ctlPtr],y		and	#$0007			;get line offset		asl	a		tay				;Y = new start of pattern		ldx	#0loop		lda	SpiralPattern,x		;shift pattern for alignment		sta	TempPattern,y		iny		iny		cpy	#16		bcc	here		ldy	#0here		inx		inx		cpx	#16		bcc	loop		PushLong #TempPattern		;change to spiral pattern		_SetPenPat		pea     1			;set pen to 1 x 8		pea     8		_SetPenSize					PushWord FillRect.left		;X position		ldy	#ctlRect.top		lda	[<ctlPtr],y		pha				;Y position		_MoveTo		PushWord FillRect.right		;X position		ldy	#ctlRect.top		lda	[<ctlPtr],y		pha				;Y position		_LineTo		pea     1			;restore pen size		pea     1		_SetPenSize			PushLong #PenPattern		;restore pattern		_SetPenPat		rts*===============================================** 	  Draw Tabs at Bottom of Card		**===============================================*DrawTabs			IMPORT	TempRect:rect						;draw sides of tabs		lda	FrameRect.bottom		sta	TempRect.top		clc		adc	TabHeight		sta	TempRect.bottom		ldy	NumberOfCards		dey		lda	FrameRect.left		;start it@inside		phy				;save counter		clc		adc	#6+2		sta	TempRect.left		adc	TabWidth		dec	a		dec	a		sta	TempRect.right		pha				;save it		PushLong #TempRect		PushLong #InteriorPat		_FillRect			;draw tabs's interior		pla				;get it back		ply				;get counter		dey		bpl	@inside				pea     2			;use wide pen		pea     1		_SetPenSize			ldy	NumberOfCards		dey		lda	FrameRect.left		;start it@sides		phy				;save counter		clc		adc	#6		pha				;save it		pha				;X begin		PushWord FrameRect.bottom	;Y begin		_MoveTo		pea     0			;X displacement		lda	TabHeight		dec	a		dec	a		pha				;Y displacement		_Line		pea     1			;X displacement		pea     1			;Y displacement		_Move		pea     1			;X displacement		pea     0			;Y displacement		_Line		pla				;get it		clc		adc	TabWidth		pha				;save it again		pha				;X begin		PushWord FrameRect.bottom	;Y begin		_MoveTo		pea     0			;X displacement		lda	TabHeight		dec	a		dec	a		pha				;Y displacement		_Line		pea     -2			;X displacement		pea     1			;Y displacement		_Move		pea     1			;X displacement		pea     0			;Y displacement		_Line		pla				;get it back		ply				;get counter		dey		bpl	@sides		pea     1			;restore pen size		pea     1		_SetPenSize			ldy	NumberOfCards		dey		lda	FrameRect.left		;start it@bottoms	phy				;save counter		clc		adc	#6+2		pha				;save it		inc	a		pha				;X begin		lda FrameRect.bottom		clc		adc	TabHeight		pha				;Y begin		_MoveTo		lda	TabWidth		sec		sbc	#6-1		pha				;X displacement		pea     0			;Y displacement		_Line		pla				;get it back		clc		adc	TabWidth		dec	a		dec	a		ply				;get counter		dey		bpl	@bottoms				rts			ENDWITH		ENDP	*===============================================**	  Test for mouse in control		** 						** INPUT:	--- In Direct Page ---		**		ctlParam   (Long)		**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue   (Long)		**						**===============================================*MyTestControl	PROC		IMPORT	TabRect:rect		IMPORT	FrameRect:rect		jsr	CardSetUp		lda	<ctlParam		;get mouse point		sta	MousePoint		lda	<ctlParam+2		sta	MousePoint+2		stz	<rtlValue		;no hit yet		stz	<rtlValue+2		lda	FrameRect.bottom		sta	TabRect.top		clc		adc	TabHeight		inc	a			;allow some slop		sta	TabRect.bottom		ldy	#0@test		phy				;save counter		tya				;card = counter + 1		inc	a		jsr	GetTabX			;offset to tab		sta	TabRect.left		clc		adc	TabWidth		inc	a			;allow some slop		sta	TabRect.right		pha				;space for result		PushLong #MousePoint		PushLong #TabRect		_PtInRect			;is mouse in this tab ?		pla		bne	yes		ply				;get counter		iny		cpy	NumberOfCards		bcc	@test				bra	exityes		ply		iny		tya		clc		adc	#partCodeBase		sta	<rtlValue		;part code = card number + baseexit		rts		ENDP*===============================================**              Process a new Value		** 						** INPUT:	--- In Direct Page ---		**		ctlParam   (Long)		**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue   (Long)		**						**===============================================*MyNewValue	PROC		jsr  CardSetUp		stz  <rtlValue		stz  <rtlValue+2exit		rts		ENDP*===============================================**           Return Control Record Size		** 						** INPUT:	none				**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue   (Long)		**						**===============================================*MyRecordSize	PROC		lda  #CustCtlRecord.sizeOf	;record size		sta  <rtlValue		stz  <rtlValue+2		rts				ENDP		*===============================================** 						** INPUT:	--- In Direct Page ---		**		ctlParam  (Long)		**		ctlPtr	  (Long)		**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue   (Long)		**						**===============================================*MyDragControl	PROC		WITH	CustCtlRecord		IMPORT	FillRect:rect		lda	<ctlParam		bne	ok		brl	doneok		jsr	CardSetUp		lda	<ctlParam		sec		sbc	#partCodeBase		; get card number		sta	CurrentCard		jsr	SwitchToNewCard		done		lda	#1		sta	<rtlValue		stz	<rtlValue+2		rts;; Made this into a subroutine, 16-Apr-91 DAL;		export SwitchToNewCardSwitchToNewCard	ldy	#ctlValue		lda	[<ctlPtr],y		; get old card		cmp	CurrentCard		; are we already on this card?		beq	@done		jsr	HideControls		; make old card's controls hide		pha				; space for handle		pha		_GetPort		PushLong [ctlPtr],ctlOwner		_SetPort			; set to our window				PushLong #OldPenState		; save their settings		_GetPenState		PushLong #NewPenState		; use our settings		_SetPenState		lda	CurrentCard		jsr	SelectTab		; draw new tab		lda	FillRect.top		clc		adc	#8		sta	FillRect.top		PushLong #FillRect		PushLong #InteriorPat		_FillRect			; erase old controls				ldy	#ctlValue		lda	CurrentCard		sta	[<ctlPtr],y		; set new card		jsr	DrawControls		; draw new card's controls		PushLong #OldPenState		; restore settings		_SetPenState		_SetPort			; set back to their window@done		rts				ENDWITH		ENDP		*===============================================**           Initialize Control Record		** 						** INPUT:	--- In Direct Page ---		**		ctlParam  (Long)		**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue  (Long)		**						**===============================================*MyInitControl	PROC		WITH	CustCtlRecord;--- copy parameters from template into record ---		ldy	#CardTemplate.tabHeight		lda	[ctlParam],y		ldy	#ctlTabHeight		sta	[ctlPtr],y		ldy	#CardTemplate.tabWidth		lda	[ctlParam],y		ldy	#ctlTabWidth		sta	[ctlPtr],y				ldy	#CardTemplate.tabSpace		lda	[ctlParam],y		ldy	#ctlTabSpace		sta	[ctlPtr],y		ldy	#CardTemplate.value		lda	[ctlParam],y		ldy	#ctlValue		sta	[ctlPtr],y		ldy	#CardTemplate.count		lda	[ctlParam],y		ldy	#ctlcardCount		sta	[ctlPtr],y		ldy	#CardTemplate.colorRef		lda	[ctlParam],y		tax		iny		iny		lda	[ctlParam],y		ldy	#ctlColor+2		sta	[ctlPtr],y		dey		dey		txa		sta	[ctlPtr],y		ldy	#CardTemplate.cardRef		lda	[ctlParam],y		tax		iny		iny		lda	[ctlParam],y		ldy	#ctlData+2		sta	[ctlPtr],y		dey		dey		txa		sta	[ctlPtr],y		ldy	#ctlData		; get card table ptr		lda	[ctlPtr],y		sta	cardPtr		iny		iny		lda	[ctlPtr],y		sta	cardPtr+2			ldy	#ctlValue		lda	[ctlPtr],y		jsr	ShowControls		; clear inivisible bits				stz	<rtlValue		stz	<rtlValue+2		rts				ENDWITH		ENDP*===============================================**						** MyHandleEvent -- if they typed Apple-1, ...	** then switch to the corresponding card.	**						** 16-Apr-91 Dave Lyons				**						**===============================================*MyHandleEvent	PROC		With CustCtlRecord		import SwitchToNewCard		jsr CardSetUp		lda [<ctlParam]		cmp #3		beq @isKey			;was it 3 (keyDownEvt)?@reject		stz <rtlValue		stz <rtlValue+2			;didn't handle event		rts@isKey		ldy #14				;offset to modifiers field		lda [<ctlParam],y		and #$1b00			;Apple+Option+Shift+Ctrl		cmp #$0100			;Apple		bne @reject		ldy #2				;message field		lda [<ctlParam],y		and #$00ff		sec		sbc #$0031			;less than "1"?		bcc @reject		cmp NumberOfCards		bcs @reject		inc a		sta CurrentCard		jsr SwitchToNewCard		lda #-1		sta <rtlValue		sta <rtlValue+2			;we took the event!		rts		EndWith		EndP*===============================================**  The following Routines are not really used.	**  In most cases the "default" action is taken.	**  They are included for completeness.		**						** INPUT:	none				**						** OUTPUT:	--- In Direct Page ---		*	*		rtlValue (Long) <-- 0		**						**===============================================*Defaults	PROC		ENTRY  MyCalculateRect		ENTRY  MyDisposeControl		ENTRY  MyPostControl		ENTRY  MyThumbControl		ENTRY  MyAutoTrack		ENTRY  MySetParams		ENTRY  MyMoveControl		MyCalculateRect				;use entire control (default rect)MySetParamsMyDisposeControl			;continue disposal (default)MyPostControl				;not usedMyThumbControl				;not usedMyAutoTrack				;not usedMyMoveControl				;no calculations needed		stz	<rtlValue		stz	<rtlValue+2		rts			ENDP*===============================================**	    Card Deck Custom Control		**         Control Definition Procedure		**						** INPUT:	--- On the Stack ---		**		longSpace  (Long)		**		ctlMessage (Word)		**		ctlParam   (Long)		**		ctlHandle  (Long)		**						**						** OUTPUT:	--- On the Stack ---		*	*		rtlValue   (Long)		**						**===============================================*CardCtrlProc	PROC	EXPORTnumMsgsExtended	equ 14				;16-Apr-91 DAL to cover MyHandleEvent		PushLong #0			;work space (12 bytes)		PushLong #0		PushLong #0		tsc		phd		phb		phk		plb		tcd				;set DP to stack		ldy 	#2			;dereference handle		lda	[ctlHandle],y		sta	<ctlPtr+2		lda	[ctlHandle]		sta	<ctlPtr		lda	<ctlMessage		cmp	#numMsgsExtended	;16-Apr-91 DAL		bcs	exit		asl	a		tax		jsr	(Operation,x)exit		plb		pld		lda	rtlAddr+1,s		sta	rtlAddr+parmSize+1,s		lda	rtlAddr,s		sta	rtlAddr+parmSize,s		tsa				;clean up stack		clc		adc	#parmSize+12		tas		rtl		Operation	DC.W	MyDrawControl		DC.W	MyCalculateRect		DC.W	MyTestControl		DC.W	MyInitControl		DC.W	MyDisposeControl		DC.W	MyPostControl		DC.W	MyThumbControl		DC.W	MyDragControl		DC.W	MyAutoTrack		DC.W	MyNewValue		DC.W	MySetParams		DC.W	MyMoveControl		DC.W	MyRecordSize		dc.w	MyHandleEvent		;16-Apr-91 DAL		ENDP*===============================================*		END