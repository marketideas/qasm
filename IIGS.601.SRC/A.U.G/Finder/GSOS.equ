=====asBufferControl		equ	$01		; command numbersasByteRangeLock		equ	$02asSpecialOpenFork	equ	$03asGetPrivileges		equ	$04asSetPrivileges		equ	$05asUserInfo		equ	$06asCopyFile		equ	$07asOpenDeskTop		equ	$09asCloseDeskTop		equ	$0AasGetComment		equ	$0BasSetComment		equ	$0CasGetServerName		equ	$0D;================================================;	Notification Queue Events;================================================neReserved	equ	$0001neGSOStoP8	equ	$0002neP8toGSOS	equ	$0004neDiskInsert	equ	$0008neDiskEject	equ	$0010neShutDown	equ	$0020neVolChange	equ	$0040;================================================;	System Preferences;================================================volMountAlert	equ	$8000noErrAlerts	equ	$2000;================================================;	Device ID Numbers;================================================DiskII			equ	$0000Profile5Meg		equ	$0001Profile10Meg		equ	$0002Disk3_5			equ	$0003SCSIGeneric		equ	$0004SCSIHardDisk		equ	$0005SCSITapeDrive		equ	$0006SCSICDROM		equ	$0007SCSIPrinter		equ	$0008SerialModem		equ	$0009ConsoleDriver		equ	$000ASerialPrinter		equ	$000BSerialLaserWriter	equ	$000CAppleTalkLaserWriter	equ	$000DRAMDisk			equ	$000EROMDisk			equ	$000FFileServer		equ	$0010IBX			equ	$0011AppleDesktopBus		equ	$0012HardDisk		equ	$0013FloppyDisk		equ	$0014TapeDrive		equ	$0015CharacterDevice		equ	$0016MFMFloppyDisk		equ	$0017Network			equ	$0018SCSISequential		equ	$0019SCSIScanner		equ	$001AScanner			equ	$001BLaserWriterSC		equ	$001CAppleTalkMain		equ	$001DAppleTalkFile		equ	$001EAppleTalkRPM		equ	$001F;================================================;	General Constants;================================================maxFileName	equ	32			; we'll handle names this long;================================================;	GS/OS System Records;================================================recDate		RECORD	0			; GS/OS date record;-----------------------------------------------second		DS.B	1minute		DS.B	1 hour		DS.B	1year		DS.B	1day		DS.B	1month		DS.B	1 null		DS.B	1weekday		DS.B	1;-----------------------------------------------		ENDR recChangePath	RECORD  0			; $04;-----------------------------------------------pCount		DS.W	1oldPathname	DS.L	1newPathname	DS.L	1sizeOf;-----------------------------------------------		ENDR recFileInfo	RECORD  0			; $05, $06;-----------------------------------------------pCount		DS.W	1pathname	DS.L	1access		DS.W	1filetype	DS.W	1auxtype		DS.L	1storetype	DS.W	1create		DS	recDatemodify		DS	recDateoptionlist	DS.L	1bytes		DS.L	1blocks		DS.L	1rescbytes	DS.L	1rescBlocks	DS.L	1sizeOf;-----------------------------------------------		ENDR recVolume	RECORD  0			; $08;-----------------------------------------------pCount		DS.W	1devName		DS.L	1volName		DS.L	1totalBlks	DS.L	1freeBlks	DS.L	1fileSysID	DS.W	1blkSize		DS.W	1characteristics DS.W	1devID		DS.W	1sizeOf;-----------------------------------------------		ENDR recSysPrefs	RECORD  0			; $0C, $0F;-----------------------------------------------pCount		DS.W	1preferences	DS.W	1sizeOf;-----------------------------------------------		ENDR recOpen		RECORD  0			; $10;-----------------------------------------------pCount		DS.W	1refNum		DS.W	1pathname	DS.L	1reqAccess	DS.W	1resource	DS.W	1access		DS.W	1fileType	DS.W	1auxType		DS.L	1storeType	DS.W	1create		DS	recDatemodify		DS	recDateoptionList	DS.L	1bytes		DS.L	1blocks		DS.L	1rescBytes	DS.L	1rescBlocks	DS.L	1sizeOf;-----------------------------------------------		ENDRrecWrite	RECORD  0			; $13;-----------------------------------------------pCount		DS.W	1refNum		DS.W	1buffer		DS.L	1request		DS.L	1transfer	DS.L	1cache		DS.W	1sizeOf;-----------------------------------------------		ENDRrecClose	RECORD  0			; $14;-----------------------------------------------pCount		DS.W	1refNum		DS.W	1sizeOf;-----------------------------------------------		ENDRrecGetDirEntry	RECORD  0			; $1C;-----------------------------------------------pCount		DS.W	1refNum		DS.W	1flags		DS.W	1base		DS.W	1displace	DS.W	1name		DS.L	1entryNum	DS.W	1fileType	DS.W	1bytes		DS.L	1blocks		DS.L	1createDate	DS	recDatemodifyDate	DS	recDateaccess		DS.W	1auxType		DS.L	1fileSysID	DS.W	1optionList	DS.L	1rescBytes	DS.L	1rescBlocks	DS.L	1sizeOf;-----------------------------------------------		ENDRrecGetDevNum	RECORD	0			; $20;-----------------------------------------------pCount		DS.W	1devName		DS.L	1devNum		DS.W	1sizeOf;-----------------------------------------------		ENDRrecFormat	RECORD	0			; $24;-----------------------------------------------pCount		DS.W	1devName		DS.L	1volName		DS.L	1fileSysID	DS.W	1reqFileSys	DS.W	1flags		DS.W	1sizeOf;-----------------------------------------------		ENDRrecGetFSTInfo	RECORD	0			; $2B;-----------------------------------------------pCount		DS.W	1fstNum		DS.W	1fileSysID	DS.W	1fstName		DS.L	1fstVersion	DS.W	1fstAttrib	DS.W	1fstBlkSize	DS.W	1fstMaxBlks	DS.L	1fstMaxBytes	DS.L	1sizeOf;-----------------------------------------------		ENDRrecDevInfo	RECORD  0			; $2C;-----------------------------------------------pCount		DS.W	1devNum		DS.W	1devName		DS.L	1devChar		DS.W	1blocks		DS.L	1slot		DS.W	1unit		DS.W	1version		DS.W	1devID		DS.W	1headLink	DS.W	1forwardLink	DS.W	1sizeOf;-----------------------------------------------		ENDRrecDevControl	RECORD  0			; $2E;-----------------------------------------------pCount		DS.W	1devNum		DS.W	1ctrlCode	DS.W	1ctrlList	DS.L	1request		DS.L	1transfer	DS.L	1sizeOf;-----------------------------------------------		ENDRrecDevRead	RECORD  0			; $2F;-----------------------------------------------pCount		DS.W	1devNum		DS.W	1buffer		DS.L	1reqBytes	DS.L	1startBlock	DS.L	1blockSize	DS.W	1tranBytes	DS.L	1sizeOf;-----------------------------------------------		ENDRrecFSTSpecific	RECORD  0			; $33;-----------------------------------------------pCount		DS.W	1fstID		DS.W	1command		DS.W	1datapathname	DS.L	1			; for Get/Set privilegesserver						; for GetSrvrNameaccess		DS.L	1			; for Get/Set privilegeszone						; for GetSrvrNameowner		DS.L	1			; for Get/Set privilegesgroup		DS.L	1			; for Get/Set privilegessizeOf;-----------------------------------------------		ENDRrecNotifyProc	RECORD  0;-----------------------------------------------pCount		DS.W	1procPtr		DS.L	1sizeOf;-----------------------------------------------		ENDRPoint		RECORD	0			; QuickDrawII point record;-----------------------------------------------v		DS.W	1h		DS.W	1 ;-----------------------------------------------		ENDR Rect		RECORD	0			; QuickDrawII rectangle record;-----------------------------------------------top		DS.W	1left		DS.W	1 bottom		DS.W	1right		DS.W	1;-----------------------------------------------		ENDR FileInfo	RECORD	0			; AppleShare Finder File Info;-----------------------------------------------fdType		DS.L	1			; file typefdCreator	DS.L	1			; file's creatorfdFlags		DS.W	1			; flagsfdLocation	DS	Point			; file's location in windowfdWindow	DS.W	1			; file's window typefdIconID	DS.W	1			; file's icon IDfdUnused	DS.W	4			; reservedfdComment	DS.W	1			; file's comment IDfdPutAway	DS.L	1			; home directory IDsizeOf		EQU	*;-----------------------------------------------		ENDR DirInfo		RECORD	0			; AppleShare Finder Directory Info;-----------------------------------------------frRect		DS	Rect			; folder's rectanglefrFlags		DS.W	1			; flagsfrLocation	DS	Point			; folder's locationfrView		DS.W	1			; folder's viewfrScroll	DS	Point			; scroll positionfrOpenChain	DS.L	1			; directory ID chainfrUnused	DS.W	1			; reservedfrComment	DS.W	1			; file's comment IDfrPutAway	DS.L	1			; home directory IDsizeOf		EQU	*;-----------------------------------------------		ENDR recOptionList	RECORD	0			; FST option list (AppleShare);-----------------------------------------------fileSysID	DS.W	1fInfo		DS	DirInfoparentDirID	DS.L	1access		DS.L	1sizeOf		EQU	*;-----------------------------------------------		ENDR		; JAM 5/17/89 (fixing BRC #46359, from Mensch research); THESE CONSTANTS ARE IDENTICAL IN VALUE TO CORRESPONDING CONSTANTS;   IN FINDER.EQU-- be careful to change ALL copies, if you change ANY copiesFINameTooLong	equ	$FE01			; Finder Internal Error: pathname too longMaxPathLen	equ	1023-MaxFileName; NOTE MaxFileName in FINDER.EQU is 31.  In this file, it is 32.; MaxPathLen def was modified slightly here from that in FINDER.EQU so that; the ultimate value would be the same.; end JAM 5/17/89