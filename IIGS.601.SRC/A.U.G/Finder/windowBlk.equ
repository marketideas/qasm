;; --- Block pointed to by RefCon (called window's info block) -----------;windIcons	equ	0			;Handle of first icon in window.windID		equ	windIcons+4		;Window's ID number.windView	equ	windID+2		;0-5, icon, small, name, size, date, kind.windIc		equ	windView+2		;Handle of ICONOBJ that opened into.windDiskIc	equ	windIc+4		;Handle of disk icon that originally owns this						;(the root icon)windItems	equ	windDiskIc+4		;Number of items in window.windUsed	equ	windItems+2		;Number of bytes used in window.windFree	equ	windUsed+4		;Numnber of bytes free on disk.windFST		equ	windFree+4		;FST ID of this windowwindAccess	equ	windFST+2		;AppleShare access bitswindDirty	equ	windAccess+2		;  bit 15 = window's info bar needs to be written back						;  bits 14-0 are reserved and 0						;(Icon Info windows have their own uses for windDirty)windTitle	equ	windDirty+2		;Window's title (padded with spaces).						;Damaged Files On "", maximum namewindMenuItem	equ	windTitle+54		;Window's menu item #windMenuText	equ	windMenuItem+2		;Window's title for the menu item						;Damaged Files On "", maximum namewindDate	equ	windMenuText+52		;Window's datewindPath	equ	windDate+8		;Complete pathname to window.WINDBLKSIZE	equ	windPath+MaxPathLen