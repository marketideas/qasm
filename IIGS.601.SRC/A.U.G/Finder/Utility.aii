*===============================================**						** File:		Utility.aii			** Project:	GS Finder			** Author:	Don J. Brady			** Build file:	Finder.Make			**						** © Copyright Apple Computer, Inc. 1988-1993	** All rights reserved.				**						**===============================================** Global Routines:				**	DateToString()				**	SizeToString()				**	DeviceToString()			**	PStringCat()				**	PStringCopy()				**	PStringCompare()			**	PStrToUpper()				**	TextToWString()				**	PToWString()				**	WToPString()				**	WStringCopy()				**	WStrCompare()				**						**	HandleToPointer()			**	UnlockHandle()				**	NewHandle()				**	HalfRoundUp()				**	ToUpperCase()				**	PStrClip()				**						**	PathAddName()				**	PathSubName()				**	PathGetName()				**	PathGetRoot()				**	PathToPStr()				**-----------------------------------------------*** Modification History:* 12/12/88 DJB	- File created today* 03/02/90 rdl - Fixed bug: if you entered a*		‘\’ char into an icon’s name & *		pressed return the AlertWindow *		box posted the remaining part of*		its message (following the ‘\’)*		as the OK button text!*		Changed text sep char fr ‘\’ to 2.****************************************************************************** 6.0.1** Note that tons and tons of changed are not listed here.  Oh, well.** 13-Jan-93 DAL (6.0.1d13)*   Changed SizeToString to set bit 31 of Long2Dec, to give "zero"*   instead of "0", and made it not add commas into the "zero"*   string.****************************************************************************		LONGA	ON		LONGI	ON		STRING	PASCAL				PRINT	OFF		*		PRINT	NOGEN		PRINT	NOSYM		INCLUDE	'ALL.MACROS'				INCLUDE	'Pascal.MACROS'				INCLUDE	'SPECIAL.MACROS'				PRINT	ON	*===============================================*Date		RECORD	0			; GS/OS date record;-----------------------------------------------second		DS.B	1minute		DS.B	1 hour		DS.B	1year		DS.B	1day		DS.B	1month		DS.B	1 null		DS.B	1weekday		DS.B	1;-----------------------------------------------		ENDR 		*===============================================**  Convert GSOS Date Record to an ASCII String	**						** IN:	---- STACK ----				**	stringPtr (LONG)			**	datePtr (LONG)				**	format  (WORD)				**		bit 15: use 24 hour time	**		bit 14: add week day to string	**		bit 0-1: %00 = MM_DD_YY		**			 %01 = DD_MM_YY		**			 %10 = YY_MM_DD		**			 %11 = undefined	**	returnAddr (3 bytes)			**			<-- SP			** OUT:	---- STACK ----				**	returnAddr (3 bytes)			**===============================================*DateToString	PROC	EXPORT		DefineStackmonthPtr	longweekDayPtr	longretAddr		block	3format		worddatePtr		longstringPtr	longinParms		SET	10locParms	SET	8		IMPORT	PStringCopy		IMPORT	StringBase		; strings from string segment		IMPORT	strJanuary		IMPORT	strFeburary		IMPORT	strMarch		IMPORT	strApril		IMPORT	strMay		IMPORT	strJune		IMPORT	strJuly		IMPORT	strAugust		IMPORT	strSeptember		IMPORT	strOctober		IMPORT	strNovember		IMPORT	strDecember		IMPORT	strSunday		IMPORT	strMonday		IMPORT	strTuesday		IMPORT	strWednesday		IMPORT	strThursday		IMPORT	strFriday		IMPORT	strSaturday		IMPORT	strUnknown*===============================================*				PushLong #0			; work space (monthPtr & weekDayPtr)		PushLong #0		tsc		phb				; preserve data bank		phd		tcd				; set DP to stack				phk		plb				; can be called from another bank								ldy	#Date.year		lda	[<datePtr],y		bne	ok		brl	unknownok		and	#$00FF		clc		adc	#1900		pha		PushLong #YearStr		PushWord #4			; 4 digits		PushWord #0			; unsigned		_Int2Dec		ldy	#Date.minute		lda	[<datePtr],y		and	#$003F		pha		PushLong #MinuteStr		PushWord #2			; 2 digits		PushWord #0			; unsigned		_Int2Dec		sep	#$20		LONGA	OFF		lda	MinuteStr		cmp	#' '		bne	skip		lda	#'0'			; change space to zero		sta	MinuteStrskip		rep	#$20		LONGA	ON			ldy	#Date.hour		lda	[<datePtr],y		and	#$001F		ldx	#'  '			; spaces		ldy	<format		bmi	setAMPM			; use 24 hour display				ldx	#'MA'			; "AM" (hard coded ok since "AM"		cmp	#0			; is international )		beq	twelve			; 12 midnight		cmp	#12		bcc	setAMPM		ldx	#'MP'			; "PM" (hard coded ok since "PM"		sec				; is international )		sbc	#12			; convert 24 hour to 12 hour		bne	setAMPMtwelve		lda	#12setAMPM		stx	AMPMStr				pha		PushLong #HourStr		PushWord #2			; 2 digits		PushWord #0			; unsigned		_Int2Dec		ldy	#Date.day		lda	[<datePtr],y		and	#$001F		inc	a			; make it 1 relative		pha		PushLong #DayStr		PushWord #2			; 2 digits		PushWord #0			; unsigned		_Int2Dec				ldy	#Date.month		lda	[<datePtr],y		and	#$000F		cmp	#12		bcc	setMonth		lda	#0setMonth	asl	a		tax		lda	MonthNames,x		sta	<monthPtr		lda	#^StringBase		sta	<monthPtr+2		lda	<format		and	#$4000			; use week day ?		beq	build			; no		ldy	#Date.weekday		lda	[<datePtr],y		and	#$0007		dec	a		asl	a		tax		lda	WeekDayNames,x		sta	<weekDayPtr		lda	#^StringBase		sta	<weekDayPtr+2build		lda	<format			; now put pieces together		and	#$0003		asl	a		tax		ldy	Formats,x				ldx	#0			; string index		lda	<format		and	#$4000			; use week day ?		bne	while			; yes		iny				; else, skip over weekday token		iny		while		lda	|$0000,y		; while token ≠ 0		beq	done		dec	a		pha		rts				; add token's string to DateStrcontinue	iny		iny		bra	whiledone		txa		sta	[<stringPtr]		; set length byte		tay		sep	#$20@loop		lda	DateStr-1,y		sta	[<stringPtr],y		; copy to caller's string		dey		bne	@loop		rep	#$20		bra	exit		unknown		PushLong #strUnknown		; pass 'Unknown' string back		PushLong <stringPtr		jsl	PStringCopy		exit		pld		plb		lda	retAddr+1,s		;clean up stack		sta	retAddr+inParms+1,s		lda	retAddr,s		sta	retAddr+inParms,s		tsa		clc		adc	#inParms+locParms		tas		rtl;-----------------------------------------------		_WeekDay	phy				; "Mon"		sep	#$20		LONGA	OFF			ldy	#1@loop		lda	[<weekDayPtr],y		sta	DateStr,x		inx		iny		tya		cmp	[<weekDayPtr]		bcc	@loop		beq	@loop			rep	#$20		LONGA	ON		ply		brl	_Comma_Day		lda	DayStr			; "24"		sta	DateStr,x		inx		inx		brl	continue		_Month		phy				; "Feb"		sep	#$20		LONGA	OFF			ldy	#1@loop		lda	[<monthPtr],y		sta	DateStr,x		inx		iny		tya		cmp	[<monthPtr]		bcc	@loop		beq	@loop			rep	#$20		LONGA	ON		ply		brl	continue		_Year		lda	YearStr			; "1960"		sta	DateStr,x		inx		inx		lda	YearStr+2		sta	DateStr,x		inx		inx		brl	continue		_Time		lda	HourStr			; "  00:00 PM"		sta	DateStr,x		inx		inx		lda	#':'		sta	DateStr,x		inx		lda	MinuteStr		sta	DateStr,x		inx		inx		lda	#' '		sta	DateStr,x		inx		lda	AMPMStr		sta	DateStr,x		inx		inx		brl	continue_Space		lda	#' '		sta	DateStr,x		inx		brl	continue		_Comma		lda	#' ,'			; ", "		sta	DateStr,x		inx		inx		brl	continueMinuteStr	DC.W	0HourStr		DC.W	0YearStr		DC.L	0DayStr		DC.W	0AMPMStr		DC.W	0DateStr		DS.B	32Formats		DC.W	MM_DD_YY		; Feb 24, 1960 12:24		DC.W	DD_MM_YY		; 24 Feb 1960 12:24		DC.W	YY_MM_DD		; 1960 Feb 24 12:24		MM_DD_YY	DC.W	_WeekDay,_Month,_Space,_Day		DC.W	_Comma,_Year,_Comma,_Time,0DD_MM_YY	DC.W	_WeekDay,_Day,_Space,_Month		DC.W	_Space,_Year,_Comma,_Time,0YY_MM_DD	DC.W	_WeekDay,_Year,_Space,_Month		DC.W	_Space,_Day,_Comma,_Time,0MonthNames	DC.W	strJanuary		; these are in string segment		DC.W	strFeburary		DC.W	strMarch		DC.W	strApril		DC.W	strMay		DC.W	strJune		DC.W	strJuly		DC.W	strAugust		DC.W	strSeptember		DC.W	strOctober		DC.W	strNovember		DC.W	strDecemberWeekDayNames	DC.W	strSunday		; these are in string segment		DC.W	strMonday		DC.W	strTuesday		DC.W	strWednesday		DC.W	strThursday		DC.W	strFriday		DC.W	strSaturday		ENDP		*=============================================================** Convert long Size to ASCII String** IN:	---- STACK ----*	stringPtr (LONG)*	size (LONG)*	type (word)*	blocksize (word)*	retAddr (3 bytes)*  SP->*	TYPE:	0 = plain (no suffix)*		1 = bytes (size is in bytes)*		2 = K (size is in half-K blocks)*		4 = .5K	(fractional) (size is in half-K blocks)*		8 = xx.x MB (fractional) (size is in half-K blocks)** OUT:	---- STACK ----*	retAddr (3 bytes)*=============================================================SizeToString	PROCNAME EXPORT		DefineStackretAddr		block	3blocksize	wordtype		wordsize		longstrPtr		longinParams	SET	12digits		SET	10typeByte	SET	1typeKilo	SET	2typeKiloFrac	SET	4typeMega	SET	8		IMPORT	strBytes		; in string segment		IMPORT	strMBytes*===============================================*		tsc		phb		phd		tcd				; set DP to stack				phk		plb				; can be called from another bank		;; If the size string isn't just bytes, convert the size string into 512 byte blocks;				lda	<type		cmp	#typeKilo		blt	@justBytes		lda	<blocksize		cmp	#512		beq	@justBytes				pha				;we need the number of blocks multiplied		pha				;by the number of bytes per block		pha		pha		pea	0		pei	<blocksize		pushZLong <size		_LongMul		pla		plx		ply		ply				pha				;divided by 512 yields # of 512 byte blocks		pha		pha		pha		phx		pha		pushlong #512		_LongDivide		pulllong <size		pla		pla;; After this point, <size contains our size in 512 byte blocks;@justBytes	lda	<type		cmp	#typeMega		beq	mb		cmp	#typeKiloFrac		beq	shift		cmp	#typeKilo		beq	k		bne	ascii;; 8 = convert to fractional MB, SIZE is in 1/2K blocks;mb		pha		pha		pha		pha		pushZLong <size		pushlong #5		_LongMul		plx		ply		pla		pla		pha		pha		pha		pha		phy		phx		pushlong #1024			;divide to get MB		_LongDivide		pla		plx		ply		ply		phx		pha*** modified 13-Jan-93 DAL		ora 3,s		sta AllZeroFlag		PushLong #NumberStr+$80000000	;where to store string (bit 31 for "zero")*** end 13-Jan-93 DAL		pea	digits+2		;digits to return		pea	0			;unsigned		_Long2Dec		sep	#$30		LONGA	OFF		LONGI	OFF				ldx	#0			;shift all number up 1 digit to make@loop		lda	numberStr+1,x		;room for the decimal point		sta	numberStr,x		inx		cpx	#10		blt	@loop			lda	#'.'		sta	kiloStr		rep	#$30		LONGI	ON		LONGA	ON		bra	ask;; 2 = convert to K, SIZE in 1/2K blocks;k		lsr	<size+2		ror	<size		bcc	@even		inc	<size			;round to nearest K if odd		bne	@even		inc	<size+2@even		bra	ascii		;; 4 = convert to fractional K, SIZE in 1/2K blocks;shift		lsr	<size+2			;div 2		ror	<size		lda	#'0.'			;'.0'		bcc	setKilo			;was the amount even?		lda	#'5.'			;'.5'setKilo		sta	KiloStr;; --- Convert number to ascii -------------------;		ascii		PushLong <size			;size to convert*** modified 13-Jan-93 DAL		lda <size+2		ora <size		sta AllZeroFlag		PushLong #NumberStr+$80000000	;where to store string (bit 31 for "zero")*** end 13-Jan-93		PushWord #digits		;digits to return		PushWord #0			;unsigned		_Long2Dec		;; --- Remove leading spaces ---------------------;ask		sep	#$30			;use short registers		LONGA	OFF		LONGI	OFF		ldx	#0		ldy	#0		loop1		lda	NumberStr,x*** added 13-Jan-93 DAL -- keep the blank on the end of "zero "		cpx	#digits-1		beq	@noSkip*** end 13-Jan-93		cmp	#' '		beq	skip@noSkip		sta	NumberStr,y		inyskip		inx		cpx	#digits		bcc	loop1;		; --- Add commas every 3 digits -----------------;		tyx				;small hack -- if the number didn't have any digits, make		bne	@haveDigits		;sure it leads off with a '0' (zero)			lda	#'0'		sta	NumberStr		iny@haveDigits		phy				;save counter		ldy	#0		tyx		loop2		lda	NumberStr,x		sta	SizeStr,y		;copy digit		inx		iny		pla				;get counter		dec	a		bmi	suffix		beq	suffix			;all done		pha				;save counter again		sec@mod		sbc	#3			;get mod 3 of counter		beq	comma			;divisable by 3 so add comma		bmi	loop2		bra	@mod		comma*** added 13-Jan-93 DAL -- don't add any commas to "zero "		lda	AllZeroFlag		ora	AllZeroFlag+1		;Duh, 8-bit mode (25-Jan-93 DAL)		beq	loop2*** end 13-Jan-93		lda	CommaCharacter		beq	loop2			;this line brought to you by DAL, 5-Sep-91		sta	SizeStr,y		;add comma		iny		bra	loop2		;--- Add suffix to number ---------------------				suffix		rep	#$30			;back to long registers		LONGA	ON		LONGI	ON		lda	type		beq	done		cmp	#typeKilo		beq	kilo			;add "K" suffix		cmp	#typeKiloFrac		beq	kiloFrac		;add ".5K" suffix		cmp	#typeByte		beq	bytes			;add " bytes" suffix		cmp	#typeMega				beq	mBytes			;add " MB" suffix		bra	donemBytes		lda	kiloStr		sta	sizeStr,y		iny		iny		lda	>strMBytes+1		sta	sizeStr,y		iny		lda	>strMBytes+2		sta	sizeStr,y		iny		iny		bra	done		bytes		ldx	#0		sep	#$20@loop3		lda	>strBytes+1,x		; add " bytes"		sta	SizeStr,y		iny		inx		txa		cmp	>strBytes		bcc	@loop3		rep	#$20		bra	donekiloFrac	lda	KiloStr			; add in fraction ('.5')		sta	SizeStr,y		iny		inykilo		lda	#'K'			; add in kilo ('K')		sta	SizeStr,y		iny;--- Copy to caller's string -------------------done		tya		sta	[<strPtr]		; set length byte		tay			sep	#$20@loop4		lda	SizeStr-1,y		sta	[<strPtr],y		; copy to caller's string		dey		bne	@loop4		rep	#$20exit		pld		plb		lda	retAddr+1,s		sta	retAddr+inParams+1,s		lda	retAddr,s		sta	retAddr+inParams,s		tsa		clc		adc	#inParams		tcs		rtlSizeStr		DS.B	16NumberStr	DS.B	10KiloStr		DS.B	2		EXPORT	CommaCharacterCommaCharacter	dc.w	0AllZeroFlag	dc.w	0			;added 13-Jan-93 DAL		ENDP				*===============================================** Convert a Device Number to an ASCII String	**						** - returns 'unknown' if an OS error occured	** - returns 'not in any drive' if devNum = 0	**						** IN:	---- STACK ----				**	stringPtr (LONG) - W string		**	devNum (WORD)				**	retAddr (3 bytes)			**  SP->						**						** OUT:	---- STACK ----				**	retAddr (3 bytes)			**===============================================*DeviceToString	PROC	EXPORT		DefineStackretAddr		block	3devNum		wordstrPtr		longparmSize	SET	6D_INFO		SET	$202CGS_OS		SET	$E100A8		IMPORT	WStringCopy		IMPORT	PToWString		IMPORT	NotInDriveStrg		; in string segment		IMPORT	strUnknown		; in string segment*===============================================*		tsc		phb		phd		tcd				; set DP to stack				phk		plb				lda	<devNum		beq	offLine		cmp	#$FFFF		beq	unknown		sta	di_devnum				jsl	GS_OS		DC.W	D_INFO		DC.L	di_list		bcs	unknown		PushLong #devNameC1Str		PushLong <strPtr		jsl	WStringCopy		; copy to caller's string		bra	exitoffLine		PushLong #NotInDriveStrg		bra	copyunknown		PushLong #strUnknowncopy		PushLong <strPtr		jsl	PToWString		; copy to caller's string		exit		pld		plb		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsa		clc		adc	#parmSize		tas		rtl;--- data ---		di_list		DC.W	2			;pcountdi_devnum	DC.W	0			;dev_num		DC.L	devNameBuff		;dev_namedevNameBuff	DC.W	32devNameC1Str	DS.B	32		ENDP				*===============================================**	   Concatenate src to dst		**						** INPUT:	---- STACK ----			**		srcPtr (long)			**		dstPtr (long)			**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		retaddr (3 bytes)		**	SP -->					**===============================================*PStringCat	PROC	EXPORT		DefineStackretAddr		block	3dst		longsrc		longparmSize	SET	8*===============================================*		tsc		phd		tcd				clc		lda	[<dst]		and	#$00FF		pha				; save length of dst		sep	#$20		adc	[<src]			; add length of src		sta	[<dst]			; set final length		rep	#$20				clc		pla		adc	<dst		sta	<dst			; move up dst ptr		bcc	cont		inc	<dst+2cont		lda	[<dst]		pha				; remember this char				lda	[<src]		and	#$00FF		tay		dey				@loop		lda	[<src],y		sta	[<dst],y		dey		dey		bpl	@loop				pla		SHORTM		sta	[<dst]			; restore that char		LONGM				pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		rtl		ENDP		*===============================================** Copy src string to dst string			**						** INPUT:	---- STACK ----			**		srcPtr (long)			**		dstPtr (long)			**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		retaddr (3 bytes)		**	SP -->					**===============================================*PStringCopy	PROC	EXPORT		DefineStackretAddr		block	3dst		longsrc		longparmSize	SET	8*===============================================*				tsc		phd		tcd				lda	[<src]		and	#$00FF		beq	@done		tay		dey@loop		lda	[<src],y		; copy string		sta	[<dst],y		dey		dey		bpl	@loop@done		SHORTM		lda	[<src]			;final catch-all for uncopied byte		sta	[<dst]			;if we were an even number of bytes		LONGM		pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		rtl		ENDP*===============================================**	Compare Two Pascal Strings		**						** INPUT:	---- STACK ----			**		space (word)			**		srcPtr1 (long)			**		srcPtr2 (long)			**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		flag (word) 1 = True, 0 = False	**		retaddr (3 bytes)		**	SP -->					**===============================================*PStringCompare	PROC	EXPORT		DefineStackretAddr		block	3srcPtr2		longsrcPtr1		longflag		wordparmSize	SET	8*===============================================*				tsc		phd		tcd				stz	<flag			; assume false				pha				; scratch space		lda	[<srcPtr1]		and	#$00FF		tay		sta	1,S			;compare lengths		lda	[<srcPtr2]		and	#$00FF		cmp	1,S		bne	Exit@loop		lda	[<srcPtr1],y		and	#$00FF				cmp	#'a'		bcc	@1		cmp	#'z'+1			;is it a lower-case letter?		bcs	@1		sec		sbc	#$20			;yes - so convert it to upper case	@1		sta	1,s		lda	[<srcPtr2],y		and	#$00FF		cmp	#'a'		bcc	@2		cmp	#'z'+1			;is it a lower-case letter?		bcs	@2		sec		sbc	#$20			;yes - so convert it to upper case	@2		cmp	1,s		bne	exit		dey		bne	@loop			;JAM - was bpl, but check of length;						    was bogus because it was after;						    ToUpperCase!  So skip that byte.				lda	#1			;return true		sta	<flagexit		pla				; free scratch		pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		rtl		ENDP*===============================================**    Convert a Pascal String to Upper Case	**						** INPUT:	---- STACK ----			**		strPtr (long)			**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		retaddr (3 bytes)		**	SP -->					**===============================================*PStrToUpper	PROC	EXPORT		DefineStackretAddr		block	3strPtr		longparmSize	SET	4				tsc		phd		tcd		lda	[<strPtr]		and	#$00FF		tay				; get string length@loop		lda	[<strPtr],y		and	#$00FF		cmp	#'a'		bcc	@1		cmp	#'z'+1			; is it a lower-case letter?		bcs	@1		sec		sbc	#$20			; yes - so convert it to upper case	@1		sep	#$20		sta	[<strPtr],y		; save it (low byte only)		rep	#$20		dey		bne	@loop		pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		pla				; remove input parameter		pla		rtl		ENDP*===============================================** Copy src string to dst string			**						** INPUT:	---- STACK ----			**		srcPtr (long)			**		dstPtr (long) - W string	**		length	(word)			**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		retaddr (3 bytes)		**	SP -->					**===============================================*TextToWString	PROC	EXPORT		DefineStackretAddr		block	3len		worddst		longsrc		longparmSize	SET	10*===============================================*						tsc		phd		tcd				lda	<len		sta	[<dst]			; set length		beq	exit			; nothing to copy		lda	<dst		clc		adc	#2		sta	<dst		bcc	@nr		inc	<dst+2@nr				lda	<len		and	#$00FF		cmp	#1		beq	@done				tay		dey			dey@loop		lda	[<src],y		; copy string		sta	[<dst],y		dey		dey		bpl	@loop@done		SHORTM		lda	[<src]		sta	[<dst]		LONGM		exit		pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		rtl		ENDP*===============================================** Convert a Pascal string into a Word string	**						** INPUT:	----  Stack  ----		**		previous contents		**		PStringPtr  (Long)		**		WStringPtr  (Long)		** 	             		   <-- SP	**						** OUTPUT:	none				**						**===============================================*PToWString	PROC	EXPORT		DefineStackretAddr		block	3dstPtr		longsrcPtr		longparmSize	SET	8*===============================================*		tsc		phd		tcd				lda	[srcPtr]		sta	[dstPtr]		and	#$00FF		tay		beq	exit		inc	dstPtr		bne	cont		inc	dstPtr+2cont		sep	#$20		LONGA	OFF@loop		lda	[srcPtr],y		sta	[dstPtr],y		dey		bpl	@loop				lda	#00		sta	[dstPtr]		;clear msb of length		rep	#$20		LONGA	ONexit		pld				;clean up		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		clc		rtl			ENDP*===============================================**     Convert Word string to Pascal string	**						** INPUT:	----  Stack  ----		**		previous contents		**		WStringPtr (Long)		**		PStringPtr (Long)		**	SP -->					**						** OUTPUT:	carry set on error		**						**===============================================*WToPString	PROC	EXPORT		DefineStackretAddr		block	3dstPtr		longsrcPtr		longparmSize	SET	8*===============================================*		tsc		phd		tcd				lda	[srcPtr]		sep	#$20		sta	[dstPtr]		rep	#$20		tax		beq	ok			;nothing to convert				xba		bne	error			;too long to convert				inc	srcPtr		bne	cont		inc	srcPtr+2cont		ldy	#1		dex				sep	#$20		LONGA	OFF@loop		lda	[srcPtr],y		sta	[dstPtr],y		iny		dex		bpl	@loop		rep	#$20		LONGA	ON		ok		ldx	#0		exit		pld				;clean up		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		cpx	#1			;return carry flag		rtl	error		ldx	#$FFFF		bra	exit				ENDP*===============================================** Copy a Word string to a Word string		**						** INPUT:	----  Stack  ----		**		previous contents		**		SrcStrPtr  (Long)		**		DstStrPtr  (Long)		** 	             		  <-- SP	**						** OUTPUT:	none				**						**===============================================*WStringCopy	PROC	EXPORT		DefineStackretAddr		block	3dstPtr		longsrcPtr		longparmSize	SET	8*===============================================*		tsc		phd		tcd				lda	[srcPtr]		tay@loop		lda	[srcPtr],y		sta	[dstPtr],y		dey		dey		bpl	@loop		lda	[srcPtr]		sta	[dstPtr]		pld				;clean up		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		clc		rtl		ENDP*===============================================**	Compare Two Word Strings		**						** INPUT:	---- STACK ----			**		space (word)			**		srcPtr1 (long)			**		srcPtr2 (long)			**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		flag (word) 1 = True, 0 = False	**		retaddr (3 bytes)		**	SP -->					**===============================================*WStrCompare	PROC	EXPORT		DefineStackretAddr		block	3srcPtr2		longsrcPtr1		longflag		wordparmSize	SET	8*===============================================*				tsc		phd		tcd				stz	<flag			; assume false				pha				; scratch space		lda	[<srcPtr1]		inc	a			; compensation for length WORD size		tay; JAM (See PStringCompare) 5/12/89;   We need to first check the lengths of the strings to see if they are;   truly equal, in case the first is a strict substring of the second.		sta	1,S		lda	[<srcPtr2]		inc	a			; compensation for length WORD size		cmp	1,S		bne	Exit; END JAM addition@loop		lda	[<srcPtr1],y		and	#$00FF		cmp	#'a'		bcc	@1		cmp	#'z'+1			; is it a lower-case letter?		bcs	@1		sec		sbc	#$20			; yes - so convert it to upper case	@1		sta	1,s		lda	[<srcPtr2],y		and	#$00FF		cmp	#'a'		bcc	@2		cmp	#'z'+1			; is it a lower-case letter?		bcs	@2		sec		sbc	#$20			; yes - so convert it to upper case	@2		cmp	1,s		bne	exit		dey		cpy	#2			; first char index of word-string		bcs	@loop			; ignore bytes 0..1 (checked above)				lda	#1			; return true		sta	<flagexit		pla				; free scratch		pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsc		clc		adc	#parmSize		tcs		rtl		ENDP*===============================================**	Convert a Handle to a Pointer		**	(the handle is also locked)		**						** INPUT:	---- STACK ----			**		space (long)			**		handle (long)			**		retAddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		pointer (long)			**		retaddr (3 bytes)		**	SP -->					**===============================================*HandleToPointer	FUNC	EXPORT		DefineStackretAddr		block	3handle		longresult		longparmSize	SET	4*===============================================*			tsc		phd		tcd		ldy	#4			; first lock it		lda	[<handle],y		ora	#$8000		sta	[<handle],y		ldy	#2			; then dereference it		lda	[<handle],y		sta	<result+2		lda	[<handle]		sta	<result		pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		pla		pla		rtl		ENDP		*===============================================**		Unlock a Handle			**						** INPUT:	---- STACK ----			**		handle (long)			**		retAddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		retaddr (3 bytes)		**	SP -->					**===============================================*UnlockHandle	PROC	EXPORT		DefineStackretAddr		block	3handle		longparmSize	SET	4*===============================================*			tsc		phd		tcd		ldy	#4			; unlock it		lda	[<handle],y		and	#$7FFF		sta	[<handle],y		pld		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		pla		pla		rtl		ENDP		*===============================================**	    Allocate a New Handle		**						** INPUT:	---- STACK ----			**		space (long)			**		size (word)			**		retAddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		handle (long)			**		retaddr (3 bytes)		**	SP -->					**===============================================*NewHandle    	PROC	EXPORT		DefineStackretAddr		block	3size		wordhandle		wordparmSize	SET	2attributes	SET	$0000		IMPORT	MemoryID		; Global Finder data*===============================================*		lda	size,s		pha				; space for result		pha		PushWord #0			; size of block needed		pha		PushWord >MemoryID		PushWord #attributes		; attributes		PushLong #0			; address (not used)		_NewHandle		pla		plx		sta	handle,s		txa		sta	handle+2,s		lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		pla		rtl				ENDP		*===============================================**	Divide A Register by 2, rounding up	**						** IN:	A-reg has value				**						** OUT:	A-reg has (A DIV 2) + (A MOD 2)		**						**	X & Y registers preserved		**===============================================*HalfRoundUp	PROC	EXPORT		lsr	a			; Half it,		adc     #0			; and round up		rtl				; maybe this should be a macro		ENDP				; but we'll do it this way for now*===============================================**	Convert an ASCII char to upper case	**						** IN:	A-reg has character to convert		**						** OUT:	A-reg has converted character		**						**	X & Y registers preserved		**===============================================*ToUpperCase	PROC	EXPORT				and	#$00FF		cmp	#'a'		bcc	exit		cmp	#'z'+1			; is it a lower-case letter?		bcs	exit		sec		sbc	#$20			; yes - so convert it to upper case	exit		rtl		ENDP		*===============================================**	Convert an ASCII char to upper case	**  CAUTION!  ASSUMES m=1 (8-bit memory, acc!)	**						** IN:	A-reg has character to convert		**						** OUT:	A-reg has converted character		**						**	X & Y registers preserved		**===============================================*ToUpperCaseM8	PROC	EXPORT		LONGA	OFF		cmp	#'a'		bcc	exit		cmp	#'z'+1			; is it a lower-case letter?		bcs	exit		sec		sbc	#$20			; yes - so convert it to upper case	exit		rtl		LONGA	ON		ENDP		*===============================================** Clip a Pascal String to a Given Pixel Width	** and append a '…' to the end. The destination	** string must be at least as long as the source	** string.					**						** INPUT:	---- STACK ----			**		srcPtr (long)			**		dstPtr (long)			**		pixels (word)			**		retaddr (3 bytes)		**	SP -->					**						** OUTPUT:	---- STACK ----			**		retaddr (3 bytes)		**	SP -->					** No error is returned				**===============================================*PStrClip	PROC	EXPORTStackFrame	RECORD	1retAddr 	DS.B	3			; place holder for return addressparamBegin	SET	*			; start parameters after this pointpixels		DS.W	1			; maximumn number of pixels for stringdstPtr		DS.L	1			; result stringsrcPtr		DS.L	1			; input stringparamSize	SET	*-paramBegin		; size of all the passed parameters 		ENDR 		WITH	StackFrame		; cover our local stack frame		tsc		phd				; save direct page register		tcd				; direct page is now our stack frame*-----------------------------------------------		;--- first copy to destination -----------------		lda	[<srcPtr]		and	#$00FF		tay		dey				; align to even number@pLoop		lda	[<srcPtr],y		; copy string		sta	[<dstPtr],y		dey		dey		bpl	@pLoop		SHORTM		lda	[<srcPtr]		sta	[<dstPtr]		LONGM		;--- now check string width --------------------@loop		pha				; space for width		PushZLong <dstPtr		; pass string ptr		_StringWidth		pla		cmp	<pixels			; is width ≤ pixels ?		bcc	exit		beq	exit				lda	[<dstPtr]		; no, so shrink string		and	#$00FF		beq	exit			; abort		dec	a		beq	exit			; abort		dec	a				SHORTM		sta	[<dstPtr]		; remove 2 characters		tay		lda	#'…'		sta	[<dstPtr],y		; change last chararcter to '…'		LONGM		bra	@loop;--- all done ----------------------------------exit		pld				; restore direct page register		lda	retAddr+1,s		; adjust return address		sta	retAddr+paramSize+1,s		lda	retAddr,s		sta	retAddr+paramSize,s		tsc				; remove caller's parameters		clc		adc	#paramSize		tcs		rtl		ENDP*===============================================**		Path Add Name			** - Adds a filename to a pathname by appending	**   it. Both string pointers point to class 1 	**   input strings. A ':' separator is used.	**						** INPUT:	----  Stack  ----		**		previous contents		**		fileNamePtr  (Long)		**		pathNamePtr  (Long)		** 	             		   <-- SP	**						** OUTPUT:	carry bit, 0 = OK		**			   1 = overflow error	**						**===============================================*; Mensch 5/12/89 (fixing BRC #46905) - insertion B (A is in util.aii)LongPathAddName	PROC	EXPORT;This alternative entry is provided to allow PathAddName to work with; filenames that the Finder wants to be larger than maxPathLen.		IMPORT	AltPathAddEnt		InitFrame		endY		Local	Word			; local variablespath		Param	Ptr			; input parameters (revese order)file		Param	Ptr		EntryCode;----------------------------------------------Begin		lda	[path]		inc	a		inc	a		tay				;appending offset		clc		inc	a			;account for ':'		adc	[file]		cmp	#1022			; our new max...		bcs	End			;string overflow error		bra	AltPathAddEntEnd		ExitCode		ENDP; end BRC #46905 insertion BPathAddName	PROC	EXPORT		InitFrame		endY		Local	Word			; local variablespath		Param	Ptr			; input parameters (revese order)file		Param	PtrMaxPathLen	set	1022-32		EntryCode;----------------------------------------------Begin		lda	[path]		inc	a		inc	a		tay				;appending offset		clc		inc	a			;account for ':'		adc	[file]		cmp	#MaxPathLen-1		bcs	End			;string overflow error		; Mensch 5/12/89 (fixing BRC #46905) - insertion C		ENTRY	AltPathAddEntAltPathAddEnt; end BRC #46905 insertion C		sta	<endY		dec	a		dec	a		sta	[path]			;new pathname length		lda	#'::'		sta	[path],y		;add a separator		iny		lda	<file		clc		adc	#2		sta	<file		bcc	loop		inc	<file+2loop						;copy file name into path name		lda	[file]		sta	[path],y		iny		iny		cpy	<endY		bcs	done		lda	<file		clc		adc	#2		sta	<file		bcc	loop		inc	<file+2		bra	loopdone		clc				;indicate no errorEnd;----------------------------------------------		ExitCode			ENDP	*===============================================**             	Path Subtract Name		** - Subtracts a filename from a pathname by	**   updating the pathname length. The string	**   pointer points to a class 1 input string.	**						** INPUT:	----  Stack  ----		**		pathNamePtr  (Long)		**						** OUTPUT:	none				*	*						**===============================================*PathSubName	PROC	EXPORT		InitFrame		path		Param	Ptr			; input parameters (revese order)		EntryCode;----------------------------------------------Begin			lda	[path]		beq	End			; null string ?		tayloop						; look for seperator		lda	[path],y		dey		and	#$00FF		cmp	#':'		bne	loop				cpy	#2			;added 4/3/91, andy		blt	End		dey		tya		sta	[path]			; new pathname length	End;----------------------------------------------		ExitCode			ENDP		*===============================================**             	Path Get Name			** - Extracts the filename from a pathname and	**   copies it into the destination. Both string	**   pointers point to class 1 input strings.	**						** INPUT:	----  Stack  ----		**		fileNamePtr  (Long)		**		pathNamePtr  (Long)		**						** OUTPUT:	none				*	*						**===============================================*PathGetName	PROC	EXPORT		InitFrame		length		Local	Word			; local variablespath		Param	Ptr			; input parameters (revese order)file		Param	Ptr		EntryCode;----------------------------------------------Begin		lda	#0		sta	[<file]				lda	[<path]		beq	End			; null string ?		tayloop1						; look for seperator		lda	[<path],y		dey		bmi	End			; not a valid path		and	#$00FF		cmp	#':'		bne	loop1				sty	<length		lda	[<path]			; calculate length		sec		sbc	<length		sta	<length			; length of filename		tya		clc		adc	<path		sta	<path		bcc	cont		inc	path+2cont		lda	<length		sta	[<file]			; length of filename		inc	<length		inc	<length			ldy	#2loop2		lda	[<path],y		sta	[<file],y		iny		iny		cpy	<length		bcc	loop2End;----------------------------------------------		ExitCode			ENDP	*===============================================**             	Path Get Root			** - Extracts the rootname from a pathname and	**   copies it into the destination. Both string	**   pointers point to class 1 input strings.	**						** INPUT:	----  Stack  ----		**		rootNamePtr  (ptr)		**		pathNamePtr  (ptr)		**						** OUTPUT:	none				*	*						**===============================================*PathGetRoot	PROC	EXPORT		InitFrame		max		Local	Word			; local variablespath		Param	Ptr			; input parameters (revese order)root		Param	Ptr		EntryCode;----------------------------------------------Begin			lda	[<path]		sta	[<root]		beq	End			; null string ?		inc	a		inc	a		sta	<max				ldy	#3			; look for seperatorloop1		lda	[<path],y		and	#$00FF		cmp	#':'		beq	found		iny		cpy	<max		bcc	loop1		found		sty	<max		dey		dey		tya		sta	[<root]			; length of root name			ldy	#2loop2		lda	[<path],y		sta	[<root],y		iny		iny		cpy	<max		bcc	loop2End;----------------------------------------------		ExitCode			ENDP	*===============================================**             	Path To P String		** Convert path to P string and copy to the	** destination string.				**						** INPUT:	----  Stack  ----		**		pathPtr  (ptr)	class 1		**		pStrPtr  (ptr)	pascal		**						** OUTPUT:	none				*	*						**===============================================*PathToPStr	PROC	EXPORT		InitFramepStr		Param	Ptr			; input parameters (revese order)path		Param	Ptr		EntryCode;----------------------------------------------Begin			lda	[<path]			; get path length		tay@loop		lda	[<path],y		; copy string (and convert)		dey		dey		bmi	@done		sta	[<pStr],y		tya		bne	@loop		@done		lda	[<path]		dec	a			; the first ':' was dropped		SHORTM		sta	[<pStr]			; set P String length		LONGMEnd;----------------------------------------------		ExitCode*===============================================** 		Cursor routines			** IN:	none					**						** OUT:	none					**						** DJB fix for BRC #49559:			** Modified Save/Restore cursor routines so that	** they can be nested. This also means that they ** MUST be used in pairs (ie must be balanced).	**===============================================*InitCursor	PROC	EXPORT				phb		phk		plb		_InitCursor			; get address of arrow		pha		pha		_GetCursorAdr		pullLong ArrowPtr		_HideCursor						_IBeamCursor		pha		pha		_GetCursorAdr		pulllong InsertPtr 				_WaitCursor			; get address of watch		pha		pha		_GetCursorAdr		pullLong WatchPtr		_ShowCursor				stz	MyIndex		plb		rtl		;------------------------------------------------		EXPORT	ArrowCursorArrowCursor		pha		pha		_GetCursorAdr		pla		ply		cmp	>ArrowPtr		bne	@setArrow		tya		cmp	>ArrowPtr+2		bne	@setArrow		rtl@setArrow	PushLong >ArrowPtr		_SetCursor		rtl;------------------------------------------------		EXPORT	WatchCursorWatchCursor		pha		pha		_GetCursorAdr		pla		ply		cmp	>WatchPtr		bne	@setWatch		tya		cmp	>WatchPtr+2		bne	@setWatch		rtl@setWatch	PushLong >WatchPtr		_SetCursor		rtl;------------------------------------------------		EXPORT	InsertCursorInsertCursor		pha		pha		_GetCursorAdr		pla		ply		cmp	>InsertPtr		bne	@setInsert		tya		cmp	>InsertPtr+2		bne	@setInsert		rtl@setInsert	PushLong >InsertPtr		_SetCursor		rtl;------------------------------------------------		EXPORT	SaveCursorSaveCursor		phb		phk		plb		pha		pha		_GetCursorAdr		lda	MyIndex		asl	a			; * 4 (array of longs)		asl	a		tax		pla		sta	LastCursor,x		pla		sta	LastCursor+2,x		inc	MyIndex		plb		rtl;------------------------------------------------		EXPORT	RestoreCursorRestoreCursor		phb		phk		plb		pha				;get our current cursor's address		pha				;and leave on stack		_GetCursorAdr		dec	MyIndex		lda	MyIndex		asl	a			; * 4 (array of longs)		asl	a		tax					pla		ply		cmp	lastCursor,x		bne	@set		tya		cmp	lastCursor+2,x		bne	@set				plb		rtl;; they only get here if they had a different cursor from last time (you never know what; the last cursor could have been.  this is weird code -- andy);@set		lda	LastCursor+2,x		pha		lda	LastCursor,x		pha		_SetCursor				plb		rtl;------------------------------------------------MyIndex		DC.W	0			; index into LastCursor arrayLastCursor	DS.L	5			; 5 deep should be enough		EXPORT	WatchPtrWatchPtr	DC.L	0		EXPORT	ArrowPtrArrowPtr	DC.L	0		EXPORT	InsertPtrInsertPtr	DC.L	0		ENDP		*===============================================*		END		