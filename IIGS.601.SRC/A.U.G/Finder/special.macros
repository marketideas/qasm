;---------------------------------------------------------	macro&lab	SetMode16&lab	rep #$30	longa on	longi on	ENDM	macro&lab	SetMode8&lab	sep #$30	longa off	longi off	ENDM	MACRO&lab	PushPtr &addr&lab	dc.B $F4	dc.W (&addr)>>16	dc.B $F4	dc.W &addr	MEND;---------------------------------------------------------	MACRO	PushZPtr &A		pea  $0000		tdc		clc		adc  #&A		pha	MEND;---------------------------------------------------------	MACRO	PushZLong &A		pei &A+2		pei &A	MEND;---------------------------------------------------------	MACRO	PushZWord &A		pei  &A	MEND;---------------------------------------------------------------;-----------------------------------------------------------;; This is the template for statTextControl.;StatTextTemplate	RECORD  0pCount	ds.w  1	;parameter count (7 or 8)ID	ds.l  1	;ID for the control Rect	ds.w  4	;bounding rectangleProcRef	ds.l  1	;StatTextControl = $81000000Flag	ds.w  1	;low 2 bits refer to TextRefMoreFlags	ds.w  1	;must be 0RefCon	ds.l  1	;application definedTextRef	ds.l  1	;Pointer, Handle, resourceID, or OffsetTextSize	ds.w  1	;If text is ref'ed by ptr or offset, this is validJust	ds.w  1	;Initial justification word to be passed to LETextBox2RecordSize	ENDR;-----------------------------------------------------------;; This is the template for LineEdit controls;LineEditTemplate	RECORD  0pCount	ds.w  1	;parameter count (8)ID	ds.l  1	;ID for the control Rect	ds.w  4	;bounding rectangleProcRef	ds.l  1	;LineEditControl = $83000000Flag	ds.w  1	;old style flag wordMoreFlags	ds.w  1	;new flag wordRefCon	ds.l  1	;application definedMaxLen	ds.w  1	;maximum length of input lineIVRef	ds.l  1	;Reference to initial valueRecordSize	ENDR