alog window.		DC.W	Text		DC.W	TextTopPos,TextLeftPos	Y and X	starting position of text.		DC.W	5			# of strings		DC.W	strgExtraSpace		DC.W	strgUnread1		'GS/OS can't read...'		DC.W	strgInit6		'(device...'		DC.W	String2					DC.W	strgUnread2		'). Do you want...'		ENTRY	enterEjectenterEject	DC.W	StdBtn		DC.W	100			Width.		DC.W	2			# of buttons		DC.W	strgEject		Pointer	to title.		DC.W	CancelID		ID number.		DC.W	strContinue		Pointer	to title.		DC.W	OKID			ID number.		ENTRY	enterInit		commonn init dataenterInit	DC.W	Icon		DC.W	CAUTION			Offset into ICONBLK.		DC.W	Text		DC.W	initLEboxY1,10		Y and X	starting position of text.		DC.W	1			# of strings		DC.W	strgGetName		DC.W	LineEdit		DC.W	initDRect>>16		Hi word	of destination RECT.		DC.W	initDRect		Lo word	of destination RECT.		DC.W	initVRect>>16		Hi word	of view	RECT.		DC.W	initVRect		Lo word	of view	RECT.		DC.W	32			Max length.		DC.W	string1		DC.W	Box		DC.W	initLEbox		RECT.		DC.W	$FFFF			End of list.		ENTRY	initDRectinitDRect	DC.W	initLEboxY1,initLEboxX1,initLEboxY2,initLEboxX2		ENTRY	initVRectinitVRect	DC.W	initLEboxY1-3,initLEboxX1-4,initLEboxY2,initLEboxX2+4		ENTRY	initLEboxinitLEbox	DC.W	initLEboxY1-3,initLEboxX1-6,initLEboxY2,initLEboxX2+8;-----------------------------------------------------------------------------; 2	   Items in the	Trash can't be opened.  Please drag the items back;	   into	a disk or folder window.;-----------------------------------------------------------------------------;		ENTRY	dtInTrashdtInTrash	DC.W	dh2,460			Height/width of	dialog window.;;		DC.W	Text;		DC.W	TextTopPos,TextLeftPos	Y and X	starting position of text.;		DC.W	3			# of strings;		DC.W	strgExtraSpace;		DC.W	strgInTrash;		DC.W	strgBack2Wind;;		DC.W	Jump			OK button.;		DC.W	OKstop;;;------------------------------------------------------------------------------; 4	   Initialization failed.  This	disk is	write-protected.;-----------------------------------------------