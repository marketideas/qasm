ant to adjustXFudge		equ	26HalfXFudge	equ	(XFudge / 2)leBoxY		equ	42+YFudge		ENTRY	dtTransFiledtTransFile		DC.W	110+YFudge,400+XFudge	Height/width of	dialog window.		DC.W	Text		DC.W	TextTopPos,TextLeftPos	Y and X	starting position of text.		DC.W	4			# of strings		DC.W	strgExtraSpace		DC.W	strgTransFile1		DC.W	String1		DC.W	strgTransFile2		DC.W	Icon		DC.W	Caution			Offset into ICONBLK.		DC.W	Text		DC.W	leBoxY,TextLeftPos+HalfXFudge	y,x position of	start of  		DC.W	1			# of strings		DC.W	strgNameDup2		DC.W	LineEdit		DC.W	DRect2>>16		Hi word	of destination RECT.		DC.W	DRect2			Lo word	of destination RECT.		DC.W	VRect2>>16		Hi word	of view	RECT.		DC.W	VRect2			Lo word	of view	RECT.		DC.W	15			Max length.		DC.W	String2			Default	string name.		DC.W	Box		DC.W	BoxRect2		RECT.		DC.W	SpecialBtn		DC.W	216			Width		DC.W	13			Height		DC.W	2			# of buttons		DC.W	56+YFudge,(400+XFudge-216)/2	y,x position.		DC.W	strgSkipAll		Pointer	to title.		DC.W	$8002			ID number.		DC.W	72+YFudge,(400+XFudge-216)/2		y,x position.		DC.W	strgTranAll		Pointer	to title.		DC.W	$8003			ID number.		DC.W	StdBtn		DC.W	100			Width.		DC.W	3			# of buttons		DC.W	strgCancel		Pointer	to title.		DC.W	CancelID		ID number.		DC.W	strgSkip		Pointer	to title.		DC.W	$8001			ID number.		DC.W	1			Next button is bold round		DC.W	strgOK			Pointer	to title.		DC.W	OKID			ID number.		DC.W	$FFFF			End of template.; JAM 06/07/89 (Fixing BRC #50355); We use the following template instead of dtTransFile when the bad file name; is encountered at a nesting level that the skipfiles mechanism wasn't; designed to handle.  It's ugly and inconvenient, but it's safe.;-----------------------------------------------------------------------------; 196	   The destination file/folder name "xxx" ... is not valid. (No skip);-----------------------------------------------------------------------------		ENTRY	dtTransOrElsedtTransOrElse		DC.W	110+YFudge,400+XFudge	Height/width of	dialog window.		DC.W	Text		DC.W	TextTopPos,TextLeftPos	Y and X	starting position of text.		DC.W	4			# of strings		DC.W	strgExtraSpace		DC.W	strgTransFile1		DC.W	String1		DC.W	strgTransFile2		DC.W	Icon		DC.W	Caution			Offset into ICONBLK.		DC.W	Text		DC.W	leBoxY,TextLeftPos+HalfXFudge	y,x position of	start of  		DC.W	1			# of strings		DC.W	strgNameDup2		DC.W	LineEdit		DC.W	DRect2>>16		Hi word	of destination RECT.		DC.W	DRect2			Lo word	of destination RECT.		DC.W	VRect2>>16		Hi word	of view	RECT.		DC.W	VRect2			Lo word	of view	RECT.		DC.W	15			Max length.		DC.W	String2			Default	string name.		DC.W	Box		DC.W	BoxRect2		RECT.		DC.W	StdBtn		DC.W	100			Width.		DC.W	2			# of buttons		DC.W	strgCancel		Pointer	to title.		DC.W	CancelID		ID number.		DC.W	1			Next button is bold round		DC.W	strgOK			Pointer	to title.		DC.W	OKID			ID number.		DC.W	$FFFF			End of template.		ENTRY	DRect2DRect2		DC.W	leBoxY,170+XFudge,leBoxY+9,315+XFudge		ENTRY	VRect2VRect2		DC.W	leBoxY-1,166+XFudge,leBoxY+10,319+XFudge		ENTRY	BoxRect2BoxRect2	DC.W	leBoxY-2,162+XFudge,leBoxY+11,323+XFudge;-----------------------------------------------------------------------------; 120	   Initializing	'NAME' will remove all of its information.;	   Completely erase the	disk 'NAME'?;-----------------------------------------------------------------------------		ENTRY	dtInit2dtInit2		DC.W	dh5,425			Height/width of	dialog window.		DC.W	Text		DC.W	TextTopPos,TextLeftPos	Y and X	starting position of text.		DC.W	6			# of strings;		DC.W	strgExtraSpace		DC.W	strgInit5		'Initializing will destroy...'		DC.W	strgErase2		'Completely erase the volume...'		DC.W	VolName1					DC.W	strgInit6		'(device		DC.W	String2					DC.W	strgQuestion2		DC.W	StdBtn		DC.W	100			Width.		DC.W	2			# of buttons		DC.W	strgCancel		Pointer	to title.		DC.W	CancelID		ID number.		DC.W	strContinue		Pointer	to title.		DC.W	OKID			ID number.		DC.W	Jump			LE Box & caution icon		DC.W	