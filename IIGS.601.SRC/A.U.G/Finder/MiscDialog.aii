;===============================================================		TITLE	'Apple IIGS Finder                            MISCDIALOG.aii';;			Dialog Routines;;	   Copyright Apple Computer, Inc. 1986-1988;		      All rights reserved;;		 By Dan	Oliver and Cheryl Ewy;; ===> converted to MAX 04/21/88 - DJB;;===============================================================;; Modification History for Version 1.2:; -------------------------------------; 05/09/88 DJB - Added "diaVerify" Record and "ThermoDial" stuff; 05/10/88 DJB - Added ModifyMLDialog, StartMLDialog, and CheckMLDialog;		 routines; "Modeless" flag; "SpecialText" type; 05/11/88 DJB - Added "diaShutDown" Record; 05/24/88 DJB - Added "diaValid" Record; 05/26/88 DJB - Added "diaShutDown2" Record; 06/29/88 JAM - Swapped CAUTION and STOP icon structures; 		    such that CAUTION is ? and STOP is !; 07/13/88 DJB - changed dtCanntDup template to make dialog longer (dh4); 07/27/88 DO	- added _HiliteControl call to doKey; 08/01/88 DJB	- added dtNonRemove template.; 08/03/88 DJB	- added dtTransFile template.; 08/04/88 DJB	- added dtDamaged template.;===============================================================		PRINT	OFF		INCLUDE	'Strings.equ'		;IMPORT strings		PRINT	ON		;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	ThermoDialProc		;------------------------------------------;; Equates from procedure DiaData;;------------------------------------------mouseDownEvt	equ	$01			;Mouse-down eventMaxString	equ	450			;max length of dialog text;------------------------------------------;; Equates from procedure Dialogs;;------------------------------------------Text		equ	0BoldText	equ	2StdBtn		equ	4SpecialBtn	equ	6RadioBtn	equ	8Icon		equ	10LineEdit	equ	12Box		equ	14Jump		equ	16CheckBoxes	equ	18ThermoDial	equ	20			;added 05/09/88 DJBSpecialText	equ	22			;added 05/10/88 DJBString1		equ	0String2		equ	2VolName1	equ	4VolName2	equ	6FileName1	equ	8FileName2	equ	10DecNum		equ	12HexNum		equ	14Centered	equ	16CancelID	equ	$FFFFOKID		equ	$0001TryAgainID	equ	$0002TextTopPos	equ	1			;Y position of first line of text.TextLeftPos	equ	88			;X starting position of text.dh1		equ	50			;Height of dialog with 1 line of text.dh2		equ	53			;Height of dialog with 2 lines of text.dh3		equ	61			;Height of dialog with 3 lines of text.dh4		equ	69			;Height of dialog with 4 lines of text.dh5		equ	77LEboxy1		equ	8LEboxx1		equ	275			;moved over 25 pixels 05/31/88 DJBLEboxy2		equ	LEboxy1+12LEboxx2		equ	LEboxx1+128initLEboxY1	equ	dh5-38initLEboxX1	equ	360/2initLEboxY2	equ	initLEboxY1+12initLEboxX2	equ	initLEboxX1+230preferX		equ	20helpRow1	equ	35helpRow2	equ	helpRow1+18helpRow3	equ	helpRow2+18helpCol1	equ	40helpCol2	equ	240;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	ChangeDialog		ENTRY	ModifyMLDialog		ENTRY	DISKICON		ENTRY	DiaAddrs		ENTRY	DrawDiaGuts		ENTRY	EndDialog		ENTRY	GetData		ENTRY	MonitorDia		ENTRY	CheckDia		ENTRY	CheckMLDialog		ENTRY	MonitorDialog		ENTRY	NewDialog		ENTRY	SaveLEText		ENTRY	StartDialog		ENTRY	StartMLDialog		ENTRY	UpdateDialog		ENTRY	UpdateEvent		ENTRY	ck_LE		ENTRY	killLE		ENTRY	pushTask		ENTRY	pushyrat		ENTRY	pushzpage		ENTRY	dtVerify		ENTRY	dtVerify2		ENTRY	dtVerifyGood		ENTRY	dtVerifyBad		ENTRY	dtValid		ENTRY	dtValid2		ENTRY	dtValidGood		ENTRY	dtValidBad		ENTRY	ReDrawDiaGuts		ENTRY	dtShutDown		ENTRY	dtShutDown2		ENTRY	dtSharedVol		ENTRY	dtNoAccess		ENTRY	dtNoAccess2		****************************************************************** DIALOG ROUTINES - DATA DECLARATIONS*****************************************************************DiaData		PROCMiscDialogBegin name		ENTRY	ScreenSizeScreenSize	DC.W	200,640		ENTRY	Screen2Screen2		DC.W	0,0,200,640		ENTRY	PNamePName		DS.B	34			;space for filename or diskname		ENTRY	StrgNum0StrgNum0	DS.B	1		ENTRY	StrgNum1StrgNum1	DS.B	10			;must follow 'strgNum0'		ENTRY	TextStrTextStr		DS.B	MaxString		ENTRY	DialValueDialValue	DC.W	0			;current value for dial; added 05/09/88 DJB		ENTRY	DialMaxDialMax		DC.W	0			;max value for dial; added 05/09/88 DJB		ENTRY	DialHandleDialHandle	DC.L	0			;handle for dial; added 05/09/88 DJB		ENTRY	DialColorDialColor	DC.W	$0000,$000F,$0000,$0004; --- Dialog window NeWindow parameter list ----------------------------		ENTRY	diaW_paramdiaW_param		ENTRY	diaW_sizediaW_size	DC.W	diaW_end-diaW_size		ENTRY	diaW_framediaW_frame	DC.W	%0010000000101001		ENTRY	diaW_titlediaW_title	DC.L	0		ENTRY	diaW_refdiaW_ref	DC.L	0		ENTRY	diaW_fulldiaW_full	DC.W	0,0,0,0		ENTRY	diaW_clrdiaW_clr	DC.L	0		ENTRY	diaW_voffdiaW_voff	DC.W	0		ENTRY	diaW_hoffdiaW_hoff	DC.W	0		ENTRY	diaW_datahdiaW_datah	DC.W	0		ENTRY	diaW_datawdiaW_dataw	DC.W	0		ENTRY	diaW_max_hdiaW_max_h	DC.W	0		ENTRY	diaW_max_wdiaW_max_w	DC.W	0		ENTRY	diaW_vscrldiaW_vscrl	DC.W	0			;Number of pixels to scroll vertically.		ENTRY	diaW_hscrldiaW_hscrl	DC.W	0			;Number of pixels to scroll horizontally.		ENTRY	diaW_vpagediaW_vpage	DC.W	0			;Number of pixels to page vertically.		ENTRY	diaW_hpagediaW_hpage	DC.W	0			;Number of pixels to page horizontally.		ENTRY	diaW_infotdiaW_infot	DC.L	0			;Infomation bar text string.		ENTRY	diaW_infoHdiaW_infoH	DC.W	0			;Height of information bar.		ENTRY	diaW_defdiaW_def	DC.L	0			;DefProc.		ENTRY	diaW_infodiaW_info	DC.L	0			;Routine to draw info. bar.		ENTRY	diaW_drawdiaW_draw	DC.L	UpdateEvent		;Routine to draw content.		ENTRY	diaW_posdiaW_pos	DC.W	0,0,0,0			;Size/Position of content.		ENTRY	diaW_planediaW_plane	DC.L	$FFFFFFFF		;Plane to put window up in.		ENTRY	diaW_recdiaW_rec	DC.L	0			;Address of memory for window record.		ENTRY	diaW_enddiaW_end		ENDP;==================================================;	   Entry point for dialog routines;==================================================;; IN:	PUSH:WORD - space for result;	PUSH:LONG - pointer to first string;	PUSH:LONG - pointer to second string;	PUSH:LONG - long integer (to be used in dialog);	PUSH:WORD - dialog number;	PUSH:WORD - function number:;			 0 = NewDialog;			 2 = EndDialog;			 4 = ChangeDialog;			 6 = StartDialog;			 8 = MonitorDialog;			10 = ModifyMLDialog;			12 = CheckMLDialog;			14 = StartMLDialog;;	a = CDU's direct page, dialog's direct page is the one after;; OUT:	WORD - ID of selected item in dialog;;==================================================CallDialog	PROCFunction	equ	14DiaIndex	equ	Function+2Int		equ	DiaIndex+2StrPtr2		equ	Int+4StrPtr1		equ	StrPtr2+4Result		equ	StrPtr1+4		IMPORT	DoCredits		phd				;Save original direct page.		phb				;Save original data bank.		phk				;Use this data bank.		plb		clc		adc	#$0100			;Use direct page after CDU.		tcd		pha				;Save original port.		pha		_GetPort			;Leave on stack.		lda	StrPtr1,s		;get ptr to first string and save		sta	<String1Ptr		lda	StrPtr1+2,s		sta	<String1Ptr+2		lda	StrPtr2,s		;get ptr to second string and save		sta	<String2Ptr		lda	StrPtr2+2,s		sta	<String2Ptr+2;------------------------------------------------;	Addded the following KLUDGE to keep class 1 strings out - DJB		lda	[<String1Ptr]		cmp	#$0100			;is 2nd byte zero? (ie a class 1 string)		bcs	okStr1			;no		xba				;fake a pascal string		sta	[<String1Ptr]		inc	<String1Ptr		bne	okStr1		inc	<String1Ptr+2okStr1			lda	[<String2Ptr]		cmp	#$0100			;is 2nd byte zero? (ie a class 1 string)		bcs	okStr2			;no		xba				;fake a pascal string		sta	[<String2Ptr]		inc	<String2Ptr		bne	okStr2		inc	<String2Ptr+2		;end of kludge...we'll now return to the okStr2						;program in progress.;------------------------------------------------		lda	Int,s			;get number and save		sta	<Number		lda	Int+2,s		sta	<Number+2		lda	Result,s		;get value and save		sta	DialValue		lda	DiaIndex,s		;get index of dialog		tax		lda	DiaAddrs,x		;convert to address of dialog		sta	<Template		;and save		lda	Function,s		tax		jsr	(FuncTable,x)		;Go to dialog function.;------------------------------------------------;	Addded the following KLUDGE	DJB		lda	StrPtr1,s		;check ptr to see if it changed		cmp	<String1Ptr		beq	undo1		dec	<String1Ptr		lda	[<String1Ptr]		xba				;back to class 1 string		sta	[<String1Ptr]undo1			lda	StrPtr2,s		;check ptr to see if it changed		cmp	<String2Ptr		beq	undo2		dec	<String2Ptr		lda	[<String2Ptr]		xba				;back to class 1 string		sta	[<String2Ptr]undo2;------------------------------------------------		lda	<ItemID		sta	Result,s		;Return ID of selected item in dialog.		_SetPort			;Restore original port (already on stack).		lda	[<String2Ptr]		and	#$00FF			;get rid of Pascal 		lda	[<String2Ptr]				ldy	#16			;# of parameters		jmp	StdEnd;-------------------------------------------------------------------------------FuncTable	DC.W	NewDialog		;0		DC.W	EndDialog		;2		DC.W	ChangeDialog		;4		DC.W	StartDialog		;6		DC.W	MonitorDialog		;8		DC.W	ModifyMLDialog		;10  Added 05/10/88 DJB		DC.W	CheckMLDialog		;12  Added 05/10/88 DJB		DC.W	StartMLDialog		;14  Added 05/10/88 DJB		ENDP;=====================================;	   One shot dialog.;=====================================;;   IN:	   a = dialog index.;;  OUT:	   a = item number selected.;=====================================NewDialog	PROC		jsr	StartDialog		;Put up	dialog window.		jsr	EndDialog		;erase dialog window		rts				ENDP;==================================================;	   Put up a dialog type	window.;==================================================;;  Why not use the Dialog Manager?  Size.  The Dialog Manager is 12k and I;  should be able to special case my dialogs in	much less space.;;  Yes, but the Dialog Manager has to be there anyways for DA's! (DJB);;   IN:	   a = dialog index.;;  OUT:	   a = item number selected.;==================================================StartDialog	PROC;; --- Create a dialog type window -----------------------------------;; ------ Center	the window ------------------------------------------;		stz	<Modeless		bra	sdStart				ENTRY	StartMLDialog		;Added 05/10/88 DJBStartMLDialog			lda	#$FFFF		sta	<Modeless		sdStart		jsr	EndDialog		;if a dialog is currently up, get rid of						;it before putting up this dialog		stz	<defaultBtn		stz	<defaultBtn+2		stz	<CancelBtn		stz	<CancelBtn+2		stz	DialHandle		stz	DialHandle+2		;Added 05/09/88 DJB		jsr	GetData			;get height of dialog window		sta	<DiaSize+Y1		jsr	GetData			;get width of dialog window		sta	<DiaSize+X1		ldx	#x1			;start with widthlop1		lda	ScreenSize,x		;get width/height of screen		sec		sbc	<DiaSize,x		;subtract width/height of window		lsr	a			;and half of that to get		and	#$FFFE			;(Put window on dither boundary.)		sta	diaW_pos+y1,x		;window centered horizontally/vertically		clc		adc	<DiaSize,x		;add width/height to left/top		sta	diaW_pos+y2,x		;to get right/bottom		dex		dex		bpl	lop1			;now do height		pha				;Space for result.		pea	1			;Turn window hiliting off for now.		_WindowGlobal		pla				;No need for result.		pha				;Space for result.		pha		pea	diaW_param>>16		;Pass address of parameter block.		pea	diaW_param		_NewWindow		lda	1,s		sta	<diaWind		lda	3,s		sta	<diaWind+2		_SetPort		jsr	DrawDiaGuts		lda	<Modeless		beq	monitor		jsr	CheckDia		bra	saveLEmonitor		jsr	MonitorDiasaveLE		jsr	SaveLEText		;save text from Line Edit record		rts				ENDP;==================================================;	   Reuse the dialog window.;==================================================;;   IN:	   a = dialog index.;	   diaWind = pointer to	dialog window.;	   Dialog window is the	current	port.;;  OUT:	   a = item number selected.;==================================================ChangeDialog	PROC*		using DiaData*		using ZP_Two		lda	<diaWind		;is there a dialog currently up?		ora	<diaWind+2		beq	Done			;no - so we're done		pei	<diaWind+2		pei	<diaWind		_SetPort		jsr	UpdateDialog		jsr	DrawDiaGuts		jsr	MonitorDia		jsr	SaveLEText		;save text from Line Edit recordDone		rts		ENDP;==================================================;      Modify the dialog window. Added 05/09/88 DJB;==================================================;;   IN:	   a = dialog index.;	   diaWind = pointer to	dialog window.;	   Dialog window is the	current	port.;;  OUT:	   a = item number selected.;==================================================ModifyMLDialog	PROC		lda	<diaWind		;is there a dialog currently up?		ora	<diaWind+2		beq	done			;no - so we're done		pei	<diaWind+2		pei	<diaWind		_SetPort		jsr	ReDrawDiaGuts		jsr	CheckDia;		jsr	SaveLEText		;save text from Line Edit recorddone		rts		ENDP;=====================================;	   Done	with the dialog;=====================================EndDialog	PROC		lda	<diaWind		;is there a dialog currently up?		ora	<diaWind+2		beq	Done			;no - so we're done		stz	<RadioIn		;reset info about which radio buttons		stz	<RadioIn+2		;should be on when dialog is drawn		jsr	killLE			;Kill line edit if there is one.		ldx	<diaWind+2		;Close dialog.		lda	<diaWind		jsl	CloseThisWindow		stz	<diaWind		;clear out window pointer		stz	<diaWind+2		;to indicate that no dialog is up		pha				;Space for result.		pea	$FFFE			;Turn window hiliting back on.		_WindowGlobal		pla				;No need for result.Done		rts		ENDP;==================================================;	   Update dialog contents;==================================================UpdateDialog	PROC*		using DiaData*		using ZP_Two*		pea	screen2>>16		;Force redraw of dialog's content.*		pea	screen2*		_InvalRect		pea	screen2>>16		;Clear dialog's content.		pea	screen2		_EraseRect		pei	<diaWind+2		;Kill the dialog's controls.		pei	<diaWind		_KillControls		stz	<DefaultBtn		;Mark no default button.		stz	<DefaultBtn+2		stz	<CancelBtn		;Mark no Cancel button.		stz	<CancelBtn+2		jsr	KillLE			;Kill LineEdit field if there is one		rts				ENDP;==================================================;	   Kill	LineEdit field if one exists;==================================================killLE		PROC*		using DiaData*		using ZP_Two		lda	<LEfield+1		;Is there a line edit field?		beq	exit		pei	<LEfield+2		pei	<LEfield		_LEDispose		stz	<LEfield+1		;Mark 'no line edit' flag.exit		rts		ENDP;=========================================================;	 Save text from	Line Edit record.;=========================================================;;   LEfield = handle to	line edit record.SaveLEText	PROC*		using DiaData*		using ZP_Two		lda	<LEfield+1		;Is there a line edit field?		beq	exit			;no		pha				;space for result		PushZLong <LEField		;handle to Line Edit record		_LEGetTextLen		pla				;get text length		sta	pname			;and save		pha				;space for result		pha		PushZLong <LEField		;handle to Line Edit record		_LEGetTextHand		pla				;get handle to text		sta	<Temp		pla		sta	<Temp+2		lda	[<Temp]			;dereference the text handle		tax		ldy	#2		lda	[<Temp],y		sta	<Temp+2		stx	<Temp		sep	#$30			;go into 8-bit mode		longa	off		longi	off		ldy	pname			;get length of text		deyloop		lda	[<temp],y		;move text		sta	pname+1,y		dey		bpl	loop		rep	#$30			;go back to 16-bit mode		longa	on		longi	onexit		rts		ENDP;==================================================;	   Draw	the contents of	the dialog;==================================================DrawDiaGuts	PROC		stz	<CntlFlagCtlLoop		jsr	GetData			;Get control type.		bmi	ListDone		tax		jsr	(ctltypes,x)		;Call dialog item creator.		bra	CtlLoopListDone 		pei	<diaWind+2		pei	<diaWind		_DrawControls			;force controls to be drawn		lda	<LEfield+1		;Is there a line edit field?		beq	exit		pei	<LEfield+2		pei	<LEfield		_LEUpdateexit		rts		ENTRY	ReDrawDiaGuts		;Added 05/10/88 DJBReDrawDiaGuts		jsr	GetData			;Get control type.		bmi	exit		tax		jsr	(ctltypes,x)		;Call dialog item creator.		bra	ReDrawDiaGuts ;---------- Jump Table ---------------------------------------------------------ctltypes		DC.W	_Text			;type 0		DC.W	_BoldText		;type 2		DC.W	_StdBtn			;type 4		DC.W	_SpecialBtn		;type 6		DC.W	_RadioBtn		;type 8		DC.W	_Icon			;type 10		DC.W	_LineEdit		;type 12		DC.W	_Box			;type 14		DC.W	_Jump			;type 16		DC.W	_CheckBox		;type 18		DC.W	_ThermoDial		;type 20  (Added 05/09/88 DJB)		DC.W	_SpecialText		;type 22  (Added 05/10/88 DJB); --------- Special Text String ---------------------- Added 05/10/88 DJB --_SpecialText 		jsr	GetData			;get text width		sta	<CtlRect+X2		jsr	GetData			;get text height		sta	<CtlRect+Y2		jsr	GetData			;get top of text		sta	<CtlRect+Y1		clc		adc	<CtlRect+Y2		;add text height		sta	<CtlRect+Y2		;to get bottom of text		jsr	GetData			;get left side of text		sta	<CtlRect+X1		clc		adc	<CtlRect+X2		;add text width		sta	<CtlRect+X2		;to get right side of text		lda	#1		sta	<NumItems		stz	<TextLen		;length of text		stz	<Just			;left justifiedstrLoop		jsr	GetData			;get address of string		sta	<StringPtr		cmp	#18			;dialog text string?		bcc	strCont			;no		lda	#18			;yes - so set X correctlystrCont		tax		jsr	(StringType,x)		;copy string into text		dec	<NumItems		;done with all strings?		bne	strLoop			;no		PushZWord <CtlRect+X1		lda	<CtlRect+Y1		adc	#8		pha		_MoveTo				PushPtr	TextStr			;ptr to text string		PushZWord <TextLen		;length of text string		_DrawText			;draw the text				PushZPtr <CtlRect		;ptr to text rect		_GetPen		lda	<CtlRect+Y1		sec		sbc	#8		sta	<CtlRect+Y1		PushZPtr <CtlRect		;ptr to text rect		_EraseRect				rts		; --------- Text String	-------------------------------------------_Text 		jsr	GetData			;get top of text		sta	<CtlRect+Y1		jsr	GetData			;get left side of text		sta	<CtlRect+X1		lda	<DiaSize+Y1		;get bottom of dialog window		sta	<CtlRect+Y2		sec		lda	<DiaSize+X1		;get right side of dialog window		sbc	#10		sta	<CtlRect+X2		jsr	GetData			;get # of stringsstringCount	sta	<NumItems		stz	<TextLen		;length of text		stz	<Just			;left justifiedStringLoop	jsr	GetData			;get address of string		sta	<StringPtr		cmp	#18			;dialog text string?		bcc	JmpString		;no		lda	#18			;yes - so set X correctlyJmpString	tax		jsr	(StringType,x)		;copy string into text		dec	<NumItems		;done with all strings?		bne	StringLoop		;no		PushPtr	TextStr			;ptr to text string		PushZWord <TextLen		;length of text string		PushZPtr <CtlRect		;ptr to text rect		PushZWord <Just			;justification		_LETextBox2			;draw the text		rts;-------------------------------------------------------------------------------StringType	DC.W	xString1		;0		DC.W	xString2		;2		DC.W	xVolName1		;4		DC.W	xVolName2		;6		DC.W	xFileName1		;8		DC.W	xFileName2		;10		DC.W	xDecNum			;12		DC.W	xHexNum			;14		DC.W	xCentered		;16		DC.W	xRegString		;18;-------------------------------------------------------------------------------xString1		lda	<String1Ptr		;set up ptr to first string input		sta	<StringPtr		lda	<String1Ptr+2		sta	<StringPtr+2		jsr	CopyString		;copy pathname into text		rts;-------------------------------------------------------------------------------xString2 		lda	<String2Ptr		;set up ptr to second string input		sta	<StringPtr		lda	<String2Ptr+2		sta	<StringPtr+2		jsr	CopyString		;copy pathname into text		rts;-------------------------------------------------------------------------------xVolName1		lda	<String1Ptr		;set up ptr to first string input		sta	<StringPtr		lda	<String1Ptr+2		sta	<StringPtr+2xVolName		lda	[<StringPtr]		;Is the string a pathname?		and	#$FF00		cmp	#SEPARATOR<<8		;Must start with a separator.		beq	done3		brl	CopyString		;Take string as is if not a pathname.done3		lda	[<StringPtr]		;get length of pathname and leading separator		pha				;and save		ldy	#1		sep	#$30			;go into 8-bit mode		LONGA	off		LONGI	offVolLoop		iny				;extract volume name from pathname		tya		cmp	1,s			;at end of pathname?		beq	GotVol			;yes		lda	[<StringPtr],y		cmp	#SEPARATOR		;at end of volume name?		bne	VolLoop			;no		dey				;don't count ending separatorGotVol		rep	#$30			;go back to 16-bit mode		LONGA	on		LONGI	on		tya				;get volume name length		and	#$00FF			;clear hi byte		ora	#$2200			;put double-quote char in hi byte		sta	[<StringPtr]		;store over original length and separator		jsr	CopyString		;copy volume name into text		jsr	AddQuoteMark		;add double-quote mark after vol name		pla		sta	[<StringPtr]		;restore original length of pathname		rts				;and leading separator;-------------------------------------------------------------------------------xVolName2		lda	<String2Ptr		;set up ptr to second string input		sta	<StringPtr		lda	<String2Ptr+2		sta	<StringPtr+2		bra	xVolName;-------------------------------------------------------------------------------xFileName1		lda	<String1Ptr		;set up ptr to first string input		sta	<StringPtr		lda	<String1Ptr+2		sta	<StringPtr+2xFileName					; 		lda	[<StringPtr]		;get length of pathname		and	#$00FF		tay				;make sure hi byte of Y is 0		ldx	#0			;make sure both bytes of X are 0		sep	#$30			;go into 8-bit mode		LONGA	off		LONGI	offFileLoop					; extract local	filename from pathname		lda	[<StringPtr],y		;by working backwards from end of string		cmp	#SEPARATOR		;until a separator is found		beq	GotName		inx				;increment # of chars in filename		dey		bne	FileLoopGotName		txa				;store length of filename where the		sta	[<StringPtr],y		;separator used to be		rep	#$30			;go back	to 16-bit mode		LONGA	on		LONGI	on		tya				;offset to start of filename		clc				;create ptr to filename		adc	<StringPtr		sta	<StringPtr		lda	<StringPtr+2		adc	#0		sta	<StringPtr+2		ldy	#1			;Is the string already in quotes.		lda	[<StringPtr],y		and	#$00FF		cmp	#$0022		bne	done1		jsr	CopyString		bra	done2;done1		jsr	AddQuoteMark		;add double-quote mark before filename		jsr	CopyString		;copy filename into text		jsr	AddQuoteMark		;add double-quote mark after filenamedone2		sep	#$30			;go into 8-bit mode		LONGA	off		LONGI	off		lda	#SEPARATOR		;GS/OS separator character		sta	[<StringPtr]		;restore it		rep	#$30			;go back to 16-bit mode		LONGA	on		LONGI	on		rts;-------------------------------------------------------------------------------xFileName2		lda	<String2Ptr		;set up ptr to second string input		sta	<StringPtr		lda	<String2Ptr+2		sta	<StringPtr+2		bra	xFileName;-------------------------------------------------------------------------------xDecNum		lda	#8		sta	strgNum0		;length of decimal string		PushZLong <Number		;number to convert		PushPtr	StrgNum1		;ptr to string		pea	8			;max length of string		pea	0			;unsigned number		_Long2Dec			;convert number to decimal string		lda	#StrgNum0		sta	<StringPtr		;set up ptr to dec string		lda	#^StrgNum0		sta	<StringPtr+2		brl	CopyString		;copy string into text;-------------------------------------------------------------------------------xHexNum		lda	#4		sta	strgNum0		;length of hex string		pha				;space for result		pha		PushZWord <Number		;number to convert		_HexIt				;convert number to hex string		pla		sta	strgNum1		pla		sta	strgNum1+2		lda	#StrgNum0		sta	<StringPtr		;set up ptr to hex string		lda	#^StrgNum0		sta	<StringPtr+2		brl	CopyString		;copy string into text;-------------------------------------------------------------------------------xCentered 		lda	#1		sta	<Just			;center justification		lda	<DiaSize+X1		;set right side of text rect to right		sta	<CtlRect+X2		;side of dialog window so text will		rts				;center correctly;-------------------------------------------------------------------------------xRegString		lda	#^StringBase		sta	<StringPtr+2		set hi word of stringptr correctly		jsr	CopyString		copy string into text		rts;-------------------------------------------------------------------------------AddQuoteMark		ldx	<TextLen		get length of text		inc	<TextLen		increment length of text		lda	#'"'		sta	TextStr,x		add a double-quote character		rts;-------------------------------------------------------------------------------CopyString 		lda	[<StringPtr]		get length of string		and	#$00FF			mask off hi byte		beq	CopyDone		quit if	length is 0		tay		clc		adc	<TextLen		and add	to current length of text		cmp	#MaxString		String too big?		bcs	CopyDone		If too big, don't add string.		sta	<TextLen		to create new length of	text		tax		dex				no length byte in text		sep	#$20			Acc = 8	bits.		LONGA	offCopyLoop	lda	[<StringPtr],y		copy string		sta	TextStr,x		into text		dex		dey				done with string?		bne	CopyLoop		no		rep	#$20			go back	to 16-bit mode		LONGA	onCopyDone	rts; --------- Bold Text String ------------------------------------_BoldText 		pea	1			;Bold text		_SetTextFace		jsr	_Text			;Print the text		pea	0			;Normal text		_SetTextFace		rts; --------- Standard Buttons ----------------------------------------_StdBtn						; 		inc	<CntlFlag		jsr	GetData			get button width		sta	<BtnWidth		jsr	GetData			get # of buttons		sta	<NumItems		tax		sec		lda	<DiaSize+X1		get width of dialog windowSubLoop		sbc	<BtnWidth		subtract width of button		dex				done with all buttons?		bne	SubLoop			no		sta	<BtnSpace		result=amount of space not used	by btns		lda	<NumItems		get # of buttons		asl	a			multiply by 2		tax		jsr	(BtnCalc,x)		calculate space	between	buttons		stz	<CtlRect+X2		sec		lda	<DiaSize+Y1		get height of dialog window		sbc	#5			subtract 5		sta	<CtlRect+Y2		to get bottom of buttons		sbc	#15			subtract standard button height		sta	<CtlRect+Y1		to get top of buttonsStdBtnLoop					; 		clc		lda	<CtlRect+X2		get current right side of button		adc	<BtnSpace		add space between buttons		sta	<CtlRect+X1		to get left side of next button		adc	<BtnWidth		add button width		sta	<CtlRect+X2		to get right side of next button		stz	<BtnFlag		Flag is	0 for normal round buttons		stz	<BtnValue		Value is 0 for standard	buttons		stz	<BtnDefProc		DefProc	is 0 for standard buttons		lda	(<Template)		get adrs of title of button		cmp	#4			is button normal round?		bcs	ItsNormal1		yes		sta	<BtnFlag		no - so	set Flag to button type		jsr	GetData			skip over button type infoItsNormal1					; 		jsr	MakeButton		make the button		dec	<NumItems		done with all buttons in list?		bne	StdBtnLoop		no		rts;-------------------------------------------------------------------------------BtnCalc		DC.W	0			;0		DC.W	_OneBtn			;2		DC.W	_TwoBtns		;4		DC.W	_ThreeBtns		;6;-------------------------------------------------------------------------------_OneBtn 		lda	<BtnSpace		;get remaining space		lsr	a			;divide by 2		sta	<BtnSpace		;to get space between buttons		rts;-------------------------------------------------------------------------------_TwoBtns 		pha				;space for result		pha		PushZWord <BtnSpace		;get remaining space		PushWord #3			;devide by 3		_UDivide		pla		sta	<BtnSpace		;to get space between buttons		pla				;ignore remainder		rts;-------------------------------------------------------------------------------_ThreeBtns		lda	<BtnSpace		;get remaining space		lsr	a		lsr	a			;divide by 4		sta	<BtnSpace		;to get space between buttons		rts; --------- Special Buttons -------------------------------------_SpecialBtn		inc	<CntlFlag		jsr	GetData			get button width		sta	<BtnWidth		jsr	GetData			get button height		sta	<BtnHeight		jsr	GetData			get # of buttons		sta	<NumItemsSpecBtnLoop 		jsr	GetData			get top	side		sta	<CtlRect+y1		clc		adc	<BtnHeight		add button height		sta	<CtlRect+y2		to get bottom side		jsr	GetData			get left side		sta	<CtlRect+x1		clc		adc	<BtnWidth		add button width		sta	<CtlRect+x2		to get right side		stz	<BtnFlag		Flag is	0 for normal round buttons		stz	<BtnValue		Value is 0 for standard	buttons		stz	<BtnDefProc		DefProc	is 0 for standard buttons		lda	(<Template)		get adrs of title of button		cmp	#4			is button normal round?		bcs	ItsNormal2		yes		sta	<BtnFlag		no - so	set Flag to button type		jsr	GetData			skip over button type infoItsNormal2					; 		jsr	MakeButton		make the button		dec	<NumItems		done with all buttons in list?		bne	SpecBtnLoop		no		rts; --------- Radio Buttons ---------------------------------------_RadioBtn		inc	<CntlFlag		lda	<RadioIn		Get info about which btns should be on		sta	<RadioOut		and init info for 'GetRadioInfo'.		lda	<RadioIn+2		sta	<RadioOut+2		jsr	GetData			Get number of buttons.		sta	<NumItemsRadioBtnLoop 		jsr	getData			Get top	side.		sta	<ctlRect+y1		jsr	getData			Get left side.		sta	<ctlRect+x1		stz	<ctlRect+y2		Let Control Manager compute the	bottom		stz	<CtlRect+x2		and right sides.		stz	<BtnValue		lda	#$0400		sta	<BtnDefProc		ldy	#2		lda	(<Template),y		Get ID number.		and	#$FF00			Get family number.		xba		sta	<BtnFlag		tax		lda	(<Template),y		Get ID number.		and	#$00FF			Mask off family	number.		cmp	<RadioIn,x		Should this button be on?		bne	NotOn			No.		inc	<BtnValue		Yes.NotOn		jsr	MakeButton		Make the radio button.		dec	<NumItems		Done with all buttons in list?		bne	RadioBtnLoop		no		rts; --------- Draw an Icon  ----------------------------------_Icon		jsr	getData			a = address of icon image data				tax				lda	|$0000,x		sta	imageRect+y2		inx		inx		lda	|$0000,x		sta	width		inx		inx		stx	image		asl	a			Compute	width in pixels.		asl	a		sta	imageRect+x2		pea	LocInfo>>16		Pass pointer to	parameter block.		pea	LocInfo		pea	imageRect>>16		Pass pointer to	source RECT.		pea	imageRect		pea	8			Pass X position.		pea	4			Pass Y position. 		pea	0			Pass mode (normal copy).		_PPToPort			Blit.		rtsLocInfo		DC.B	$80,$00			SCB (640 mode).image		DC.L	DISKICON		Pointer	to pixel image.width		DC.W	0			Width of image.imageRect	DC.W	0,0,0,0			Bounds RECT of image.; --------- Create a line edit field ----------------------------------_LineEdit			inc	<CntlFlag		pha				Space for result.		pha		ldy	#5			Push 5 words.lop200		jsr	getData		pha		dey		bne	lop200		sta	<temp			Save max length.		_LENew		pla		sta	<LEfield		plx		stx	<LEfield+2;		phx		pha		_LEActivate;;		jsr	GetData			Get address of text. If	it's 0, then a		beq	UseStr1Ptr		string ptr was passed as input param 1.		cmp	#2		beq	UseStr2Ptr		string ptr was passed as input param 2.		pea	DiaData>>16		push hi	word of	ptr to default text		pha				push lo	word of	ptr to default text		ldy	#0		lda	(1,s),y			get length of text		and	#$00FF			mask off hi byte		pha				and push		lda	3,s			get lo word of ptr to text		inc	a			adjust ptr to not include length byte		sta	3,s			and save		bra	LEContUseStr1Ptr	pei	<String1Ptr+2		push hi	word of	ptr to default text		lda	<String1Ptr		adjust lo word of ptr to not include		inc	a			length byte		pha				and push		lda	[<String1Ptr]		get length of text		and	#$00FF			mask off hi byte		pha				and push		bra	LEContUseStr2Ptr	pei	<String2Ptr+2		push hi	word of	ptr to default text		lda	<String2Ptr		adjust lo word of ptr to not include		inc	a			length byte		pha				and push		lda	[<String2Ptr]		get length of text		and	#$00FF			mask off hi byte		pha				and pushLECont		pei	<LEfield+2		pei	<LEfield		_LESetText		pea	0			Select from beginning,		pei	<temp			to end (saved max length).		pei	<LEfield+2		pei	<LEfield		_LESetSelect		rts; --------- Frame a box	 ----------------------------------_box		pea	3		pea	1		_SetPenSize		pea	DiaData>>16		jsr	getData		pha		_FrameRect		rts; --------- Change list	pointer	----------------------------_jump		jsr	getData			Value become new list pointer.		sta	<template		rts		; --------- Check boxes	---------------------------------------_CheckBox			inc	<CntlFlag		Set 'control to monitor' global	flag.		jsr	GetData			Get number of boxes.		sta	<NumItemslop100		jsr	getData			Get top	side.		sta	<ctlRect+y1		jsr	getData			Get left side.		sta	<ctlRect+x1		stz	<ctlRect+y2		Let Control Manager compute the	bottom		stz	<CtlRect+x2		and right sides.		lda	#$0200			Check box defProc number.		sta	<BtnDefProc		stz	<BtnValue		lsr	<RadioIn		Should this box	be checked?		bcc	skip100		inc	<BtnValue		Yes.skip100		jsr	MakeButton		Make the check box.		dec	<NumItems		Any more check boxes?		bne	lop100		rts; --------- ThermoDial Control ------------------  Added 05/09/88 DJB_ThermoDial		lda	DialHandle		;is there a ThermoDial already?		ora	DialHandle+2		beq	new			;no - so create one		jsr	GetData			;remove data		jsr	GetData		jsr	GetData		jsr	GetData						lda	DialMax		sec		sbc	DialValue		;current value		pha				;new dial value		lda	DialHandle+2		pha		lda	DialHandle		pha		_SetCtlValue			;update dial's value		bra	donenew		jsr	GetData			;get dial width		sta	<BtnWidth		jsr	GetData			;get dial height		sta	<BtnHeight		jsr	GetData			;get top side		sta	<CtlRect+y1		clc		adc	<BtnHeight		;add dial height		sta	<CtlRect+y2		;to get bottom side		jsr	GetData			;get left side		sta	<CtlRect+x1		clc		adc	<BtnWidth		;add dial width		sta	<CtlRect+x2		;to get right side		pha				;space for result		pha		pei	<DiaWind+2		;Window owner		pei	<DiaWind		lda	#CtlRect		;pass pointer to enclosing RECT.		jsr	pushzpage		pea	$0000			;(not used)				lda	DialMax			;get dial's maximum value		pha				pea	$0001			;dial type (horizontal)		sec		sbc	DialValue		;current value		pha				;dial's start value		pea	$0000			;param1 (not used)		pea	$0000			;param2 (not used)		pea	ThermoDialProc>>16	;defProc for ThermoDial		pea	ThermoDialProc		pea	$0000			;refCon	(not used)		pea	$0000		pea	DialColor>>16		;color table ptr		pea	DialColor		_NewControl		pla				;get handle to control		sta	DialHandle		pla		sta	DialHandle+2done		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Create a button; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =MakeButton		pha				Space for result.		pha		pei	<DiaWind+2		Window owner.		pei	<DiaWind		lda	#CtlRect		Pass pointer to	enclosing RECT.		jsr	pushzpage		pea	StringBase>>16		Pass pointer to	title string.		jsr	GetData		pha		pei	<BtnFlag		Pass flag.		ldy	#0		pei	<BtnValue		Pas value.		phy				Param1.		phy				Param2.		pei	<BtnDefProc		Pass defProc.		phy		phy				Refcon.		jsr	GetData			ID number.		sta	<BtnID		pha		phy				Default	color table.		phy		_NewControl		pla				Get handle to control.		plx		ldy	<BtnFlag		Was that a default button?		beq	cont			no		sta	<DefaultBtn		Remember default button's handle.		stx	<DefaultBtn+2cont		ldy	<BtnID			; was that a cancel button ?		cpy	#CancelID		bne	NotDef2			;no		sta	<CancelBtn		Remember cancel button's handle.		stx	<CancelBtn+2NotDef2		rts		ENDP;==================================================;	   Monitor the controls	in the dialog;==================================================MonitorDia	PROC*		using DiaData*		using ZP_Two		lda	<CntlFlag		any controls to	monitor?		bne	MonitorDialog		yes - so continue		stz	<ItemID			no - so	return 0 as item ID		rts		;------------------------------------------------		ENTRY	CheckDia		;Added 05/10/88 DJBCheckDia      		lda	<CntlFlag		;any controls to monitor?		beq	CheckExit		;no - so exit				ENTRY	CheckMLDialog		;Added 05/10/88 DJBCheckMLDialog      		lda	#$FFFF		sta	<Modeless		bra	mdStartCheckExit	lda	#0		stz	<ItemID			;return 0 as item ID		rts		;------------------------------------------------		ENTRY	MonitorDialogMonitorDialog   		stz	<ModelessmdStart				lda	#%1000000000000110	;Update and find window only.		sta	<TaskMaskpoll		lda	<LEfield+1		;Is there a line edit field?		beq	skip1		pei	<LEfield+2		;Let line edit blink cursor.		pei	<LEfield		_LEIdle;skip1		pha				;Space for result.;		pea	$0F6E			;Event mask -- take everything		pea	$0E2E			;MouseDown, MouseUp, KeyDown, AutoKey;						;Switch, deskAcc, Driver 		jsr	pushTask		;Pass pointer to Task record.		_TaskMaster		pla		bne	handevnt		lda	<Modeless		beq	poll		bra	CheckExit;;; --- Handle event ----------------------------------------------------;handevnt	cmp	#wInContent		beq	buttDown		cmp	#inKey		beq	doKey		cmp	#inAutoKey		beq	doKey		lda	<what		cmp	#mouseDownEvt		bne	poll		_SysBeep			;added 05/11/88 DJB		bra	poll;;; ------ Key input ----------------------------------------------------doKey		lda	<message		Get key.		cmp	#13			Is it the return key?		bne	cont11		lda	<DefaultBtn		ldx	<DefaultBtn+2		beq	flashErr		tay		beq	flashErruseKey		sta	<foundCtl		stx	<foundCtl+2			pea	2			;pass part to hiLite (simple button part code)		phx				;pass control's		pha		_HiliteControl			;hilite the default button so user will be happy		brl	exit;------- DJB ------cont11		cmp	#27			; is it the ESC key?		bne	ok11		lda	<CancelBtn		ldx	<CancelBtn+2		beq	flashErr		tay		beq	flashErr		bra	useKey		;------------------ok11		lda	<LEfield+1		Is there a line	edit field?		bne	ok10flashErr	_SysBeep			; was a _FlashMenuBar before		bra	topollok10		jsr	FilterProc		check to see if	key is allowed		bcs	topoll			key isn't allowed so skip it		pei	<message		Pass key.		pei	<modifiers		Pass key modifiers.		pei	<LEfield+2		Pass handle of line edit.		pei	<LEfield		_LEKeytopoll		brl	poll;;; ------- Handle button	down in	content	--------------------------------;buttDown	pha				Space for result.		lda	#foundCtl		Pass address of	place to store handle.		jsr	pushzpage		pei	<xrat			Pass position of button	down.		pei	<yrat		pei	<diaWind+2		Pass control's window.		pei	<diaWind		_FindControl		pla				Any hit?		bne	trackit;		lda	<LEfield+1		Is there a line	edit field?		beq	topoll		jsr	ck_LE			Check if button	down in	line edit.		bra	topoll;trackit		pha				Space for result.		pei	<xrat			Pass position of button	down.		pei	<yrat		lda	#0			Pass no	action procedure.		pha		pha		pei	<foundCtl+2		Pass handle of control to track.		pei	<foundCtl		_TrackControl		pla		beq	topoll		cmp	#4			Was hit	on a radio button?		bne	next1			No.;		pea	$FFFF			Pass TRUE to turn on.		pei	<FoundCtl+2		Pass control's handle.		pei	<FoundCtl		_SetCtlValue			Turn radio button on.;		pha				Space for result		pha		pei	<FoundCtl+2		Pass control's handle.		pei	<FoundCtl		_GetCtlRefCon			Get control's refcon.		lda	1,s		and	#$FF00			Get family number.		xba		tax		pla		and	#$00FF			get ID #		sta	<RadioOut,x		and save		plx		bra	topollnext1		cmp	#3			Was it a hit in	a check	box.		bne	exit		pha				Space for result.		pei	<FoundCtl+2		Pass control's handle.		pei	<FoundCtl		_GetCtlValue		pla		eor	#1		pha		pei	<FoundCtl+2		Pass control's handle.		pei	<FoundCtl		_SetCtlValueexit		pha				Space for result.		pha		pei	<foundCtl+2		Pass handle of control to track.		pei	<foundCtl		_GetCtlRefCon			Get control's refCon.		pla				Control's ID number.		sta	<ItemID		plx		rts;;;= = = = = = = = = = = = = = = = = = =;	 Filter	Proc;= = = = = = = = = = = = = = = = = = =; Liberally hacked 25-Jan-89 by JAM.  Forgive me, God.;   This must be rethought and rewritten when we get;   FST support for filesystem lexical enforcementFilterProc					; 		ldx	#10		lda	<Message		get keyKeyLoop		cmp	SpecialKeys,x		is it a	special	key?		beq	KeyOK			yes - so it's OK		dex		dex		bpl	KeyLoop; JAM 25-Jan-89:  following code enforces ProDOS lexical rules, but is not;   applicable to all filesystems.  IÕm leaving it here for reference.;		cmp	#'.'			is it a	period?;		beq	CheckPos		yes - so check if first	char;		cmp	#'0';		bcc	BadKey;		cmp	#'9'+1			is it a	digit?;		bcc	CheckPos		yes - so check if first	char;		cmp	#'A';		bcc	BadKey;		cmp	#'Z'+1			is it a	capital	letter?;		bcc	KeyOK			yes - so it's OK;		cmp	#'a';		bcc	BadKey;		cmp	#'z'+1			is it a	lower-case letter?;		bcs	BadKey;		sec;		sbc	#$20			yes - so convert it to upper case;		sta	<Message;  END OF ARCHIVAL SECTION 25-Jan-89; JAM 25-Jan-89:  In Finder 1.3, we will permit practically anything to go through;   and sort it out later.  Future Finders may be more intelligent when FSTs provide;   lexical arbitrators.		cmp	#' '			; is it greater or equal to blank?		bcc	BadKey			; nope		cmp     #127			; is it less than DEL? (regular ASCII?)		bcc	KeyOK			; yep, so is potentially "legal"		cmp	#$FA			; is it greater Mac can display?		bcs	BadKey			; yep, so you gotta draw the line somewhere		KeyOK		clc				indicate that key is OK		rts				; JAM 25-Jan-89: More archival stuff;    The following code again enforces ProDOS lexical restrictions and;    is inappropriate for Finder 1.3;** Note	- the following	section	of code	looks at the contents of the;**	  Line Edit record directly and	will no	longer work if the;**	  offset to the	SelStart field changes.;CheckPos	lda	[<LEField]		get pointer to Line Edit record;		sta	<Temp;		ldy	#2;		lda	[<LEField],y;		sta	<Temp+2;		ldy	#32			offset to SelStart field;		lda	[<Temp],y		get SelStart field from	Line Edit record;		bne	KeyOK			not first char so key is allowed;BadKey;		sec				indicate that key is not allowed;		rts; END JAM 25-Jan-89 archival stuffBadKey						; JAM 25-Jan-89 version - no holds barred		lda	#'.'		sta	<Message		; replace bad key w/something visible		clc				;   and acceptable to all filesystems		rtsSpecialKeys	DC.W	$06			control-F		DC.W	$18			control-X		DC.W	$19			control-Y		DC.W	$7F			backspace		DC.W	$08			left arrow		DC.W	$15			right arrow		ENDP;=========================================;	   Check button	down;	   in line edit	fields.;=========================================;;   IN:	   yrat	= y coordinate to check	(in global).;	   xrat	= x coordinate to check	(in global).ck_LE		PROC*	   using DiaData*	   using ZP_TwoTextHandle	equ	0Length		equ	TextHandle+4MaxLength	equ	Length+2DestRect	equ	MaxLength+2ViewRect	equ	DestRect+8;;		lda	<yrat			Save global rat	position.		sta	<temp		lda	<xrat		sta	<temp+2;		jsr	pushyrat		_GlobalToLocal;		pha				Space for result (PtInRect).		jsr	pushyrat		Pass pointer to	point to check.;		ldy	#4			Lock line edit handle.		lda	[<LEfield],y		ora	#$8000		sta	[<LEfield],y;		dey				Dereference handle.		dey		lda	[<LEfield],y		tax		lda	[<LEfield]		clc				Compute	address	of viewRect.		adc	#viewRect		bcc	ok1		inxok1		phx				Pass pointer to	RECT to	check.		pha		_PtInRect;		ldy	#4			Unlock line edit handle.		lda	[<LEfield],y		and	#$7FFF		sta	[<LEfield],y;		pla				Get result.		beq	exit			Was the	point in the RECT?;		lda	<temp			Restore	global rat position.		sta	<yrat		lda	<temp+2		sta	<xrat;		jsr	pushTask		Pass pointer to	Task record.		pei	<LEfield+2		pei	<LEfield		_LEClick;			  exit		rts		ENDP;==================================================;	   Handle update event;==================================================UpdateEvent	PROC		rtl				ENDP;=========================================================;	   Move	saved Line Edit	text into destination.;=========================================================;;   IN : LONG =	ptr to destination string;;=========================================================GetName		PROCDestPtr		equ	10		phd				Save original direct page.		phb				Save original data bank.		phk				Use this data bank.		plb		clc		adc	#$0100			Use direct page	after CDU.		tcd		lda	DestPtr,s		get ptr	to destination string		sta	<DesPtr		lda	DestPtr+2,s		sta	<DesPtr+2		sep	#$30			go into	8-bit mode		longa	off		longi	off		ldy	pname			get length of textloop		lda	pname,y			move text to destination		sta	[<desPtr],y		dey		bpl	loop		rep	#$30			go back	to 16-bit mode		longa	on		longi	on		jmp	StdEnd4				ENDP;=========================================================;	   Indicate which radio	button should be on;=========================================================;;   IN : WORD =	family #;   IN : WORD =	ID # of	button which should be on;;=========================================================SetRadioBtn	PROC*		using DiaData*		using ZP_TwoIDNum		equ	10FamNum		equ	IDNum+2		phd				Save original direct page.		phb				Save original data bank.		phk				Use this data bank.		plb		clc		adc	#$0100			Use direct page	after CDU.		tcd		lda	FamNum,s		get family #		tax		lda	IDNum,s			get ID # of button which should	be on		sta	<RadioIn,x		and save it		jmp	StdEnd4				ENDP;=========================================================;	   Set the maximum value for the Thermo Dial;=========================================================;;   IN : WORD =	Maximum value;;=========================================================SetDialMax	PROCvalue		equ	10		phd				Save original direct page.		phb				Save original data bank.		phk				Use this data bank.		plb		clc		adc	#$0100			Use direct page	after CDU.		tcd		lda	value,s			;get value and save it		sta	DialMax		ldy	#2		jmp	StdEnd				ENDP;=========================================================;	   Return ID of	radio button which is on;=========================================================;;   IN : WORD =	family # to return info	about;;   OUT: WORD =	ID # of	button which is	on;;=========================================================GetRadioBtn	PROC*	       using DiaData*	       using ZP_TwoFamNum		equ	10Result		equ	FamNum+2		phd				Save original direct page.		phb				Save original data bank.		phk				Use this data bank.		plb		clc		adc	#$0100			Use direct page	after CDU.		tcd		lda	FamNum,s		get family #		tax		lda	<RadioOut,x		get ID # of button which is on		sta	Result,s		ldy	#2		jmp	StdEnd		ENDP;====================================================;	   Get a WORD from the dialog list.;====================================================GetData		PROC*	   using DiaData*	   using ZP_Two		lda	(<template)		pha		inc	<template		inc	<template		pla				;Make sure flags are set correctly		rts				ENDP;=========================================;	   Push	a direct page;	   address on the stack.;=========================================;;   IN:	   a = direct page offset.;;=========================================pushyrat	PROC*		using DiaData*		using ZP_Two		lda	#yrat		bra	pushzpage		ENTRY	pushTaskpushTask      		lda	#TaskRec		ENTRY	pushzpagepushzpage      		plx		pea	0		pha		tdc		clc		adc	1,s		sta	1,s		phx		rts				ENDP****************************************************************** FINDER DIALOG	DATA*****************************************************************Dialogs		PROC; --- Dialog Item Types	-----------------------------; --- Special Text Types -----------------------------; --- 3.5" disk	icon ---------------------------------		ENTRY	DISKICON	;(new one)DISKICON	DC.W	19,12		DC.B	$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$0F,$F0		DC.B	$0F,$F0,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$F0		DC.B	$0F,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0		DC.B	$0F,$FF,$FF,$00,$00,$00,$00,$00,$00,$FF,$FF,$F0		DC.B	$0F,$FF,$FF,$00,$FF,$00,$00,$00,$00,$FF,$FF,$F0		DC.