;.....................................................................; File:		Match.aii; Project:	GS Finder; Author:	Andy Nicholas; Build file:	Finder.Make;; ©ÊCopyright Apple Computer, Inc. 1991-93; All rights reserved.;; Global Routines:; ----------------;; AllocateChains(); LoadResources(); KillChains()		-- commented out; LoadRBundle(); MatchFileToIcon(); QueryDatabase(); AddBundles2Desktop();.....................................................................;; 12-Jun-92 DAL for 6.0.1;   Use DisposeHandleGlue instead of _DisposeHandle.;; 24-Mar-93 JCM - Fixed setupCompare which is used by matchCreateDateTime and;		  matchModDateTime to copy the timeRec out of the oneDoc. It used;		  to copy too many bytes to the wrong location, which just about;		  guaranteed that the two match types would always fail.;;  2-Apr-93 JCM - Fixed AddBundle2Desktop to correctly draw the destination disk;		  name if the pathname is @:Desktop.;;.....................................................................		LONGA	ON		LONGI	ON		STRING	PASCALNIL		equ	0		seg	'Match'		PRINT	OFF		PRINT	NOSYM		INCLUDE	'ALL.MACROS'		INCLUDE	'Pascal.MACROS'		INCLUDE	'SPECIAL.MACROS'		INCLUDE	'DP.equ'		INCLUDE	'match.equ'		INCLUDE 'e16.finder'		PRINT	ONMaxChains	equ	200			;Maximum # of chains for each chunk of the Chain TableMaxArrayIcons	equ	200			;Maximum # of icons in each chunk of the IconOffsetList						;and IconHandleList		import DisposeHandleGlue;; MatchGlobals -- things that get used by any of these routines and anyone;		  outside;.....................................................................MatchGlobals	PROCNAME EXPORT		IMPORT	AllowTellFinderCalls; -----------------------------------------------------------------------------------------------; DO NOT, I repeat, DO NOT change the order and offsets of these fields.  People other than; the Finder will really depend on them!; -----------------------------------------------------------------------------------------------		EXPORT StartofDebugInfoStartofDebugInfo		EXPORT	NameChain		;don't change the order theseNameChain	dc.L	0			;are in, the request stuff copies		EXPORT	fTypeListPtr		;them in this order for debug infofTypeListPtr	dc.L	0		EXPORT	dTypeListPtrdTypeListPtr	dc.L	0		EXPORT	MasterChainMasterChain	dc.L	0		EXPORT	rFPListHandlerFPListHandle	dc.L	0		EXPORT	rFPCountrFPCount	dc.w	0			;if you have more than 64k apps, you're						;outta your mind!		EXPORT	NameChainInsertNameChainInsert	dc.L	0		dc.L	0			;unused for now (1/10/92), not removed to leave debug info intact		EXPORT	MasterChainInsertMasterChainInsert dc.L	0		dc.L	0			;unused for now (1/10/92), not removed to leave debug info intact		EXPORT	ChainTableChainTable 	dc.L	0			;handle to chain table		EXPORT	IconOffsetArrayIconOffsetArray	dc.L	0		EXPORT	IconHandleArrayIconHandleArray	dc.L	0		EXPORT	IconArrayUsedIconArrayUsed	dc.w	0		EXPORT	IconArraySizeIconArraySize	dc.w	0		dc.L	AllowTellFinderCalls		EXPORT	EndOfDebugInfoEndOfDebugInfo;; END of super-important chain and handle stuff; ---------------------------------------------------------------------------------------------		EXPORT	GenericSIconHandleGenericSIconHandle dc.L	0		EXPORT	GenericIconHandleGenericIconHandle dc.L	0		EXPORT	FinderPathIDFinderPathID	dc.w	0		EXPORT	BundleIDBundleID	dc.w	0		EXPORT	IconListIDIconListID	dc.w	0		EXPORT	rFPMaxrFPMax		dc.w	0			;how many records we have room for...		ENDP;; allocateChains -- allocate the handle chains that are used throughout the;                   lifetime of the finder;; OUT: carry set if we couldn't allocate a memory block we needed;.....................................................................allocateChains  PROCNAME EXPORT		IMPORT	NewHandle		IMPORT	HandleToPointer		IMPORT	LoadRBundle		IMPORT	IconListID		IMPORT	BundleID		IMPORT	FinderPathID		IMPORT	IconOffsetArray		IMPORT	IconHandleArray		IMPORT	fileTypeList		IMPORT	deviceTypeList		IMPORT	fTypeListPtr		IMPORT	dTypeListPtr		IMPORT	fTypeInsertList		phb		phk		plb				lda	<MyID				;icons have ID's of this type		and	#$F0FF		ora	#$0700		sta	BundleID		and	#$F0FF		ora	#$0800		sta	IconListID		and	#$F0FF		ora	#$0900		sta	FinderPathID		;; allocate the chain table;		lda	#16*MaxChains		ldx	#$0008		jsr	NewHandleAttribs				stx	ChainTable		stx	<deref		sta	ChainTable+2		sta	<deref+2		bcc	@gotChains@goBogus	brl	@bogus@gotChains		lda	[<deref]		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref		ldy	#10				;zero out the first entry (important)		lda	#0@zLoop		sta	[<deref],y		dey		dey		bpl	@zLoop		lda	#1				;one record in the table so far		sta	[<deref]		ldy	#4		lda	#MaxChains			;say we have room for 'MaxChains' records currently		sta	[<deref],y				stz	NameChain		stz	NameChain+2		stz	NameChainInsert		stz	NameChainInsert+2				stz	MasterChain		stz	MasterChain+2		stz	MasterChainInsert		stz	MasterChainInsert+2		;; allocate and zero out the filetype and devicetype lists (devicetype list is at the top of the; filetype list) and also the ftype insertion list and the dtype insertion list;		ldx	#((256*4)*4)-2			;zero out the lists (we might have been restarted)		lda	#0@loop		sta	>fileTypeList,x		dex		dex		bpl	@loop		lda	#fileTypeList		sta	fTypeListPtr		lda	#fileTypeList>>16		sta	fTypeListPtr+2		lda	#deviceTypeList		sta	dTypeListPtr		lda	#deviceTypeList>>16		sta	dTypeListPtr+2;; allocate both the IconOffsetArray and the IconHandleList and set their sizes for 200 icons; as unlocked, unfixed, and unpurgable, and no special memory;				lda	#4*MaxArrayIcons		;# of records		ldx	#$0008				;no special memory		jsr	NewHandleAttribs		stx	IconHandleArray		sta	IconHandleArray+2		bcs	@bogus					lda	#4*MaxArrayIcons		;# of records		ldx	#$0008				;no special memory		jsr	NewHandleAttribs		stx	IconOffsetArray		sta	IconOffsetArray+2		bcs	@bogus		;; setup MaxArrayIcons and IconArrayUsed HERE before we add anything else to the arrays;		lda	#MaxArrayIcons		sta	IconArraySize		lda	#2		sta	IconArrayUsed				;; allocate the rFinderPath list;		lda	#40*32		ldx	#$0008				;no special memory		jsr	NewHandleAttribs		stx	rFPListHandle		sta	rFPListHandle+2		bcs	@bogus		stz	rFPCount			;number of rFinderPath records		lda	#40				;when we get here, start resizing		sta	rFPMax		@bogus		tya					;error code was in Y if SEC		plb		rtl					;return SEC/A=error;; NewHandleAttribs -- allocate a new handle of (A) bytes, but use (X) as the attributes;; Returns SEC/Y=error;NewHandleAttribs		pha					;Space for result.		pha		pea	0				;Pass size of block needed.		pha						pei	<MyID		phx					;attributes		pha					;Pass address, not used.		pha		_NewHandle		tay					;error code in Y		plx		pla		rts		ENDP;; Now that the icon file is open, load the Generic icons and load all the rest of the icons;; OUT: 	A&X contain the handle of the rBundle which was loaded for the Finder or NIL;	if we had a disaster;; Also, on error we return SEC and Y=error code (12-Aug-92 DAL);;.....................................................................SetupLoad	PROCNAME	EXPORT		IMPORT	GenericIconHandle		IMPORT	GenericSIconHandle		IMPORT	IconOffsetArray		IMPORT	IconHandleArray		IMPORT	LoadRBundle		IMPORT	fileTypeList		IMPORT	fTypeInsertList				phb		phk		plb				pha		pha		pea	$8001			;rIcon		pushLong #$00000010		_LoadResource		tay		pulllong GenericIconHandle		bcc	@loadOK@goBogus	brl	@bogus@loadOK		pha		pha		pea	$8001			;rIcon		pushLong #$00000110		_LoadResource		tay		pulllong GenericSIconHandle		bcs	@goBogus;; stuff the handles of each of the generic icons into the handle array;		lda	IconHandleArray		sta	<handle		lda	IconHandleArray+2		sta	<handle+2				lda	[<handle]		sta	<ptr		ldy	#2		lda	[<handle],y		sta	<ptr+2				lda	GenericIconHandle		sta	[<ptr]		lda	GenericIconHandle+2		sta	[<ptr],y				ldy	#4		lda	GenericSIconHandle		sta	[<ptr],y		iny		iny		lda	GenericSIconHandle+2		sta	[<ptr],y;; stuff the offsets to each of the generic icons into the offset array;		lda	IconOffsetArray		sta	<handle		lda	IconOffsetArray+2		sta	<handle+2				lda	[<handle]		sta	<ptr		ldy	#2		lda	[<handle],y		sta	<ptr+2		lda	#0		sta	[<ptr]		sta	[<ptr],y		iny		iny		sta	[<ptr],y		iny		iny		sta	[<ptr],y;; now, walk through the rBundle and load everything we didn't load before ;		pha				;space for the rBundleHandle		pha		pea	$8000			;we're loading the Finder's stuff		pushlong #0			;zero == Finder's resources		pea	0			;by resource ID		pushlong #1			;get finder's RBundle resource		jsl	LoadRBundle		;result from LoadRBundle stays on stack		tay				;possible error code in Y		ldx	#((256*4)*2)-2		;zero the insertion offset lists		lda	#0			;so that we start inserting at the head of the list@loop		sta	>fTypeInsertList,x				dex		dex		bpl	@loop		stz	NameChainInsert		stz	NameChainInsert+2				stz	MasterChainInsert		stz	MasterChainInsert+2;; Exit with A&X set (or not set), but definitely exit this way!;		pla				;result from LoadRBundle		plx				;rBundle handle goes into hyperspace		beq @bogus		plb		clc				;no error		rtl@bogus		lda	#0			;Y = error code		tax		plb		sec		rtl		ENDP;; LoadResources		Load all resource of the specified type and attributes;			from the resource file, return the handle to the resource fork, file still;			open if successful;; IN:	|  space  |	long, space for the resource map handle;	|  flags  |	word, if bit 0 == 1 then process rBundle(1), if bit 1 == 1 then process all rBundles;	|  type   |	word, if NIL then load all types;	|  attr	  |	word, attributes to match to decide whether to load or not;	|  memID  |	word, memory ID	to assign to everything that gets NewHandled;	|  path   |	long, pathname of application;	----------- <- SP;; OUT:  |  long	  |	resource fork handle;	----------- <- SP ;	;	(A) contains either zero or an error code, carry set if error;; ERRORS: $1E02 if the resource fork either isn't a GS resource fork, or if the map is toast;.....................................................................LoadResources	PROCNAME EXPORT		IMPORT	rFPListHandle		IMPORT	rFPCount		IMPORT	WStringCopy		IMPORT	PathAddName		IMPORT	WStrCompare		IMPORT	c1_path		IMPORT	DesktopName		IMPORT	IconListID		IMPORT	IconsName		IMPORT	IconArrayUsed		IMPORT	IconArraySize		IMPORT	IconHandleArray		IMPORT	IconOffsetArrayGSOSStackCall	equ	$e100b0Move_Info	equ	$e10200rFileVersion	equ	0rFileToMap	equ	4rFileMapSize	equ	8		mapNext		equ	0mapFlag		equ	4mapOffset	equ	6mapSize		equ	10mapToIndex	equ	14mapFileNum	equ	16mapID		equ	18resType		equ	0resID		equ	2resOffset	equ	6resAttr		equ	10resSize		equ	12resHandle	equ	16resRecSize	equ	20		DefineStackLastSmallIconIndex wordLastLargeIconIndex wordLastIconIndex	wordLastIconID	longLastSmallIconID longLastLargeIconID longresourceType	wordresourceID	longOffsetListPtr	longOffsetListStart	longOffsetListHandle longHandleListPtr	longHandleListStart	longHandleListHandle longIconHandleSize	longTotalIconCount	wordTotalIconCount4 longIconList	longIconListHandle	longIconListPtr	longDocListPtr	longOneDocPtr	longOneDocCount	wordBundleResRefRec	longResRefRec	longResRefRecStart	longDestPtr		longDestHandle	longDestSize	longrMapSize	longrMap		longOffset		longrFork		longerror		wordCloseParms	block	4ReadParms	block	$10OpenParms	block	$3aretAddr		block	3pathname	longmemoryID	wordattributes	wordtype		wordflags		wordrForkHandle	longinParms		SET	12locParms	SET	122+$3a+$10+$4		tsc		sec		sbc	#locParms		;allocate extra DP space for local DP		tcs		phb				;preserve data bank		phd		tcd				;set DP to stack		phk		plb;; first, get a memory block as large as the file's resource fork;		lda	#15			;pcount		sta	<OpenParms				lda	<pathname		sta	<OpenParms+4		lda	<pathname+2		sta	<OpenParms+6				lda	#1					sta	<OpenParms+8		;requestAccess		sta	<OpenParms+10		;resource number (resource fork)		stz	OpenParms+$26		;zero out the option list		stz	OpenParms+$26+2				pea	0			;address of parm block		tdc		clc		adc	#OpenParms		pha		pea	$2010			;_OpenGS		jsl	GSOSStackCall		bcc	@openOK		brl	errorExit@openOK		pha		pha		pushZLong <openParms+$32	;get enough for the resource fork's EOF		pei	<MemoryID		pea	$8000			;locked		pha		pha		_NewHandle		plx		stx	<rForkHandle		plx		stx	<rForkHandle+2		bcc	@gotForkHandle		brl	closeExit		@gotForkHandle	lda	[<rForkHandle]		tax		ldy	#2		lda	[<rForkHandle],y				sta	<rFork+2		;put the resource fork here			sta	<readParms+6		stx	<rFork		stx	<readParms+4		;; now, read the entire resource fork into the memory block we just allocated;		lda	#4		sta	<ReadParms		;pcount				lda	<OpenParms+2		;refnum		sta	<ReadParms+2				lda	<OpenParms+$32		;howmuch		sta	<ReadParms+8		lda	<OpenParms+$34		sta	<ReadParms+10				pea	0		tdc		clc		adc	#ReadParms		pha		pea	$2012			;_ReadGS		jsl	GSOSStackCall		bcc	@readOK		brl	DisposeFork@readOK;; Well, that's it for the disk access we'll have to do -- from now on it's just NewHandle calls; and a lot of memory moves as we walk the resource map;		lda	[<rFork]		bne	@notGSFork		ldy	#2		lda	[<rFork],y		beq	@gotGSFork		@notGSFork	lda	#$1e02			;resBadFormat		brl	CloseExit@gotGSFork		ldy	#rFileToMap		lda	[<rFork],y		clc		adc	<rFork		sta	<rMap		iny		iny		lda	[<rFork],y		adc	<rFork+2		sta	<rMap+2;; check the offset of our resource map;		ldy	#rFileToMap		lda	[<rFork],y		sta	<Offset			;Offset to Map		iny		iny		lda	[<rFork],y		sta	<Offset+2				ldy	#mapOffset		lda	[<rMap],y		cmp	<Offset		bne	@goDisposeFork		iny		iny		lda	[<rMap],y		cmp	<Offset+2		bne	@goDisposeFork;; check the size of our resource map;		ldy	#rFileMapSize		lda	[<rFork],y		sta	<rMapSize		iny		iny		lda	[<rFork],y		sta	<rMapSize+2				ldy	#mapSize		lda	[<rMap],y		cmp	<rMapSize		bne	@goDisposeFork		iny		iny		lda	[<rMap],y		cmp	<rMapSize+2		beq	@validOffset@goDisposeFork	lda	#$1e02			;resBadFormat		brl	DisposeFork@validOffset;; Now that we move the map into its own handle, walk the map and move the resources into; separate handles which match our input criteria;		lda	#0			;zero rMapNext		sta	[<rMap]		ldy	#mapNext+2		sta	[<rMap],y				iny				;zero mapFlag		iny		sta	[<rMap],y		ldy	#mapFileNum		;setup the file number for this file		lda	OpenParms+2		sta	[<rMap],y				ldy	#mapToIndex		;set resRefRec to the beginning of the resource		lda	[<rMap],y		;reference record list		clc		adc	<rMap		sta	<resRefRec		sta	<resRefRecStart		lda	<rMap+2		adc	#0		sta	<resRefRec+2		sta	<resRefRecStart+2		;; loop back here for every resRefRec;ResRefRecLoop	lda	[<resRefRec]		bne	@notLastResRefRec		brl	@lastResRefRec@notLastResRefRec		ldy	#resHandle		;start by zeroing out the resRefRec handle		lda	#0		sta	[<resRefRec],y		iny		iny		sta	[<resRefRec],y		lda	<type			;check our resource type to see if we should allocate		beq	@loadAllTypes		;a handle for it		cmp	[<ResRefRec]		bne	@nextResRefRec@loadAllTypes		lda	<attributes		;check our resource attributes to see if we should		cmp	#$FFFF			;allocate a handle for it		beq	@loadAllAttr		ldy	#resAttr		and	[<resRefRec],y		beq	@nextResRefRec		@loadAllAttr		lda	flags			;if we are dealing with a file that has Bundles, DO NOT		and	#3			;preload all the icons and rBundles, do that later into one		beq	@noBundles		;big list		lda	[<ResRefRec]		cmp	#$802B			;rBundle ID		beq	@nextResRefRec		cmp	#$8001			;rIcon ID		beq	@nextResRefRec@noBundles	jsr	MoveRefRecToHandle		bcs	ErrorExit		@nextResRefRec	ldy	#resAttr		;ALWAYS clear the preload bit (we're preloading it now)		lda	[<resRefRec],y		and	#$FFBF					sta	[<resRefRec],y		lda	<resRefRec		clc		adc	#ResRecSize		sta	<resRefRec		bcc	@goResRecLoop		inc	<resRefRec+2@goResRecLoop	brl	ResRefRecLoop;; we're done!  say we did have any errors;@lastResRefRec	stz	<error		lda	flags			;are we dealing with a fork which has rBundles and rIcons?		and	#3		beq	done				jsr	GlueIcons		;if so, glue them all together in a big mess		bcs	ErrorExit		bra	done;; DisposeFork -- get rid of the handle that contains the entire resource fork;DisposeFork		pha		pushZlong <rForkHandle		jsl DisposeHandleGlue		pla;; exit path for errors which need to close the resource fork;CloseExit	sta	<error				lda	#1			;pcount		sta	CloseParms				lda	OpenParms+2		sta	CloseParms+2				pea	0		tdc		clc		adc	#CloseParms		pha		pea	$2014			;_CloseGS		jsl	GSOSStackCall		bra	done		;; exit path for errors;ErrorExit	sta	<error		;; all done, exit;done		ldy	<error		pld		plb		lda	retAddr+1,s		;clean up stack		sta	retAddr+inParms+1,s		lda	retAddr,s		sta	retAddr+inParms,s		tsc		clc		adc	#inParms+locParms		tcs		tya		cmp	#1			;set or clear carry based on (A)		rtl;; Move what's in this ResRefRec into a handle of its own with the attributes it asked for;MoveRefRecToHandle		pha		pha		ldy	#resSize+2		;how much		lda	[<resRefRec],y		sta	<DestSize+2		pha		dey		dey		lda	[<resRefRec],y		sta	<DestSize		pha		pei	<MemoryID		;memory ID		ldy	#resAttr		lda	[<resRefRec],y		;attributes		and	#$c31f			;mask for valid memory manager values		pha		pha				;no fixed location		pha		_NewHandle		plx		stx	<DestHandle		plx		stx	<DestHandle+2		bcs	@done			;if we're out of memory, do the next resRefRec		ldy	#resOffset		;make our source pointer		lda	[<resRefRec],y		clc		adc	<rFork		tax		iny		iny		lda	[<resRefRec],y		adc	<rFork+2		pha		phx		ldy	#2			;deref the destination handle and use as dest ptr		lda	[<DestHandle],y		pha		lda	[<DestHandle]		pha		pushZLong <DestSize		pea	$0805		jsl	Move_Info		ldy	#resHandle		lda	<DestHandle		sta	[<resRefRec],y		iny		iny		lda	<DestHandle+2		sta	[<resRefRec],y		clc@done		rts;; Glue all the icons together for either all the rBundles or rBundle(1);GlueIcons	stz	<IconHandleSize		stz	<IconHandleSize+2		stz	<TotalIconCount				lda	flags			;if bit 1 is set, we have to add the icons from all the bundles		and	#2		bne	@addAllBundles		lda	#$802B		ldx	#1		ldy	#0		jsr	findResource		bcc	@noMoveToHandle		lda	<ResRefRec		;save the pointer to our rBundle		sta	<BundleResRefRec		lda	<ResRefRec+2		sta	<BundleResRefRec+2				ldy	#resOffset		lda	[<ResRefRec],y		clc		adc	<rFork		sta	<DestPtr		iny		iny		lda	[<ResRefRec],y		adc	<rFork+2		sta	<DestPtr+2		lda	#addIconSizeToHandle		jsr	WalkBundle				lda	<BundleResRefRec		sta	<ResRefRec		lda	<BundleResRefRec+2		sta	<ResRefRec+2				jsr	MoveRefRecToHandle		bcc	@addDone		rts		;; add all sizes of all the icons in all the rBundles in this resource fork into IconHandleSize; also add the total number of icons which are really used by all the rBundles we're using;@addAllBundles	lda	#$802B		ldx	#0		txy		jsr	findResource		bcc	@addDone		lda	<ResRefRec		;save the pointer to our rBundle		sta	<BundleResRefRec		lda	<ResRefRec+2		sta	<BundleResRefRec+2		@addLoop	lda	[<BundleResRefRec]		beq	@addDone		cmp	#$802B		bne	@addDone								ldy	#resOffset		lda	[<BundleResRefRec],y		clc		adc	<rFork		sta	<DestPtr		iny		iny		lda	[<BundleResRefRec],y		adc	<rFork+2		sta	<DestPtr+2		lda	#addIconSizeToHandle		jsr	WalkBundle				lda	<BundleResRefRec		sta	<ResRefRec		lda	<BundleResRefRec+2		sta	<ResRefRec+2				jsr	MoveRefRecToHandle		bcc	@noMoveToHandle		rts@noMoveToHandle	lda	<BundleResRefRec		clc		adc	#ResRecSize		sta	<BundleResRefRec		lda	<BundleResRefRec+2		adc	#0		sta	<BundleResRefRec+2@goAddLoop	bra	@addLoop		;; now that we've added up the size of all the icons in either all the rBundles or just rBundle(1),; allocate enough memory for the new icon list;@addDone	lda	<IconHandleSize		ora	<IconHandleSize+2		bne	@haveIcons		clc		rts@haveIcons		pha		pha		pushZLong <IconHandleSize		lda	IconListID		pha				;memory ID				ldx	#$0000			;if flags isn't 3, then most likely we're starting up the		lda	flags			;finder, so DON'T put our handle list on top of the SHR screen		and	#2		bne	@all		ldx	#$0008	@all		phx				;attributes		pha		pha		_NewHandle		plx		stx	<IconListHandle		plx		stx	<IconListHandle+2		bcc	@gotHandle		rts@gotHandle		lda	IconHandleArray		sta	<HandleListHandle		lda	IconHandleArray+2		sta	<HandleListHandle+2		lda	IconOffsetArray		sta	<OffsetListHandle		lda	IconOffsetArray+2		sta	<OffsetListHandle+2		lda	IconArrayused		clc		adc	<TotalIconCount		cmp	IconArraySize		blt	@noSizeAdjust				inc	a		sta	<TotalIconCount4		stz	<TotalIconCount4+2;; we need to extend the IconListArrays by 4*TotalIconCount apiece;		asl	<TotalIconCount4				rol	<TotalIconCount4+2		asl	<TotalIconCount4				rol	<TotalIconCount4+2		ldy	#4		lda	[<HandleListHandle],y	;unlock and unfix the block		and	#$3FFF		sta	[<HandleListHandle],y		pha				;get the old handle size and stretch		pha				;it by a longword		pushZLong <HandleListHandle		_GetHandleSize			;and it had BETTER be unlocked at this		pla				;point		clc		adc	<TotalIconCount4	;want to add enough for 'TotalIcons' more records		tax		pla		adc	<TotalIconCount4+2		pha		phx		pushZLong <HandleListHandle		_SetHandleSize		bcc	@HandleListExtended		rts@handleListExtended						ldy	#4		lda	[<OffsetListHandle],y	;unlock and unfix the block		and	#$3FFF		sta	[<OffsetListHandle],y		pha				;get the old handle size and stretch		pha				;it by a longword		pushZLong <OffsetListHandle		_GetHandleSize			;and it had BETTER be unlocked at this		pla				;point		clc		adc	<TotalIconCount4	;want to add enough for 'TotalIcons' more records		tax		pla		adc	<TotalIconCount4+2		pha		phx		pushZLong <OffsetListHandle		_SetHandleSize		bcc	@OffsetListExtended		rts@OffsetListExtended		lda	IconArrayUsed		;say what the new size that we have available really is		clc		adc	<TotalIconCount		inc	a		sta	IconArraySize@noSizeAdjust;; IMPORTANT -- past this point, don't do anything that could move memory!  The fork, Icon List,;	       icon list arrays must not move!;		lda	[<IconListHandle]	;pointer the first available spot in the icon handle		sta	<IconListPtr		sta	<IconList		ldy	#2		lda	[<IconListHandle],y		sta	<IconListPtr+2		sta	<IconList+2		;; setup the pointer to the offset list;				lda	[<OffsetListHandle]		sta	<OffsetListStart		ldy	#2		lda	[<OffsetListHandle],y		sta	<OffsetListStart+2;; setup the pointer to the handle list;		lda	[<HandleListHandle]		sta	<HandleListStart		ldy	#2		lda	[<HandleListHandle],y		sta	<HandleListStart+2;; Now either move just the single rBundle(1)'s icons into the Icon List which we just allocated, or; move the icons from EVERY index rBundle in this resource fork;		lda	flags		and	#2			;if bit 1 is set, we have to move the icons from all the bundles		bne	@moveAllBundles		lda	#$802B		ldx	#1		ldy	#0		jsr	findResource		bcc	@moveDone		ldy	#resHandle		lda	[<ResRefRec],y		sta	<DestHandle		iny		iny		lda	[<ResRefRec],y		sta	<DestHandle+2				lda	[<DestHandle]		sta	<DestPtr		ldy	#2		lda	[<DestHandle],y		sta	<DestPtr+2				lda	#addIconToHandle		jsr	WalkBundle		clc		rts@moveAllBundles	lda	#$802B		ldx	#0		txy		jsr	findResource		bcc	@moveDone		lda	<ResRefRec		;save the pointer to our rBundle		sta	<BundleResRefRec		lda	<ResRefRec+2		sta	<BundleResRefRec+2				@moveLoop	lda	[<BundleResRefRec]		beq	@moveDone		cmp	#$802B		bne	@moveDone				ldy	#resHandle		lda	[<BundleResRefRec],y		sta	<DestHandle		iny		iny		lda	[<BundleResRefRec],y		sta	<DestHandle+2				lda	[<DestHandle]		sta	<DestPtr		ldy	#2		lda	[<DestHandle],y		sta	<DestPtr+2		lda	#addIconToHandle		jsr	WalkBundle		lda	<BundleResRefRec		clc		adc	#ResRecSize		sta	<BundleResRefRec		lda	<BundleResRefRec+2		adc	#0		sta	<BundleResRefRec+2		bra	@moveLoop		@moveDone	clc		rts						;; WalkBundle -- walk through the given rBundle ID, move the rBundle into a separate handle,;	        and move its icons into the IconList, marking their offsets and handles in the;	        rBundle as we go (or NIL if the rIcon can't be found).;; IN:  	(A) = local address to call for both the small icon and large icon in each OneDoc;	<DestPtr points to the Bundle;WalkBundle	sta	address		stz	<LastLargeIconID		stz	<LastLargeIconID+2				stz	<LastSmallIconID		stz	<LastSmallIconID+2		stz	<LastLargeIconIndex		stz	<LastSmallIconIndex				ldy	#2		lda	[<DestPtr],y		clc		adc	<DestPtr		sta	<DocListPtr		lda	<DestPtr+2		adc	#0		sta	<DocListPtr+2				lda	<DocListPtr		clc		adc	#2		sta	<OneDocPtr		lda	<DocListPtr+2		adc	#0		sta	<OneDocPtr+2		stz	<OneDocCount				lda	[<DocListPtr]		;are there any OneDocs?		bne	@loop		rts;; every time through this loop, add the size of the icons in the resource, or add the icon data into; the icon list;@loop		ldy	#4			;NumResults		lda	[<OneDocPtr],y		cmp	#3		blt	@next		jsr	SaveLarge				ldy	#16			;LargeIconResourceID		ldx	#0		jsr	(address,x)		jsr	RestoreLarge		bcc	@NoNewLarge		inc	<TotalIconCount@NoNewLarge		ldy	#4			;NumResults		lda	[<OneDocPtr],y		cmp	#4		blt	@next				jsr	SaveSmall		ldy	#24			;SmallIconResourceID		ldx	#0		jsr	(address,x)		jsr	RestoreSmall		bcc	@noNewSmall		inc	<TotalIconCount@NoNewSmall@next		lda	[<OneDocPtr]		clc		adc	<OneDocPtr		sta	<OneDocPtr		bcc	@nr		inc	<OneDocPtr+2@nr				inc	<OneDocCount		lda	<OneDocCount		cmp	[<DocListPtr]		blt	@loop		rts;; DON'T do anything in the following 4 routines which might change the carry!;SaveLarge	lda	<LastLargeIconID		sta	<LastIconID		lda	<LastLargeIconID+2		sta	<LastIconID+2		lda	<LastLargeIconIndex		sta	<LastIconIndex		rts		RestoreLarge	lda	<LastIconID		sta	<LastLargeIconID		lda	<LastIconID+2		sta	<LastLargeIconID+2		lda	<LastIconIndex		sta	<LastLargeIconIndex		rtsSaveSmall	lda	<LastSmallIconID		sta	<LastIconID		lda	<LastSmallIconID+2		sta	<LastIconID+2		lda	<LastSmallIconIndex		sta	<LastIconIndex		rtsRestoreSmall	lda	<LastIconID		sta	<LastSmallIconID		lda	<LastIconID+2		sta	<LastSmallIconID+2		lda	<LastIconIndex		sta	<LastSmallIconIndex		rts				;; addIconSizeToHandle -- add the size of the icon at the offset in (Y) in the OneDoc to the; 			 total size needed for all of our icons ;; IN: (Y) contains the offset into the OneDoc to  look for an rIcon resource;AddIconSizeToHandle		phy		lda	[<OneDocPtr],y		;is the rIcon ID == NIL?		iny		iny		ora	[<OneDocPtr],y		clc		beq	@noResource		;if so, leave				dey		dey		lda	[<OneDocPtr],y		tax		iny		iny		lda	[<OneDocPtr],y		cmp	<LastIconID+2		bne	@notSameID		cpx	<LastIconID		bne	@notSameID				ply				;balance the stack!		iny		iny		iny		iny		lda	#0			;this code just in case the LAST icon wasn't able to be found!		cpy	#21			;is this for the large icon?		blt	@large1			;if so, zero is index into offset table		inc	a			;is not, 1 is index into offset table@large1		sta	[<OneDocPtr],y		iny		iny		lda	#0		sta	[<OneDocPtr],y		clc				;if we're the same as the last time, don't add any more to our size		rts		@notSameID	dey		dey		lda	[<OneDocPtr],y		sta	<LastIconID		tax		iny		iny		lda	[<OneDocPtr],y		sta	<LastIconID+2		tay		lda	#$8001		jsr	findResource@noResource	ply		bcs	@foundResource		lda	#0			;zero out the rIcon ID and the icon handle and		sta	[<OneDocPtr],y		;offset into the icon handle table and icon		iny				;offset table		iny		sta	[<OneDocPtr],y		iny		iny		cpy	#21			;is this for the large icon?		blt	@large			;if so, zero is index into offset table		inc	a			;is not, 1 is index into offset table@large		sta	[<OneDocPtr],y		iny		iny		lda	#0		sta	[<OneDocPtr],y		clc		rts@foundResource	ldy	#resSize		lda	[<resRefRec],y		clc		adc	<IconHandleSize		sta	<IconHandleSize		iny		iny		lda	[<resRefRec],y		adc	<IconHandleSize+2		sta	<IconHandleSize+2		sec		rts;; addIconToHandle -- add the icon at the offset in (Y) in the OneDoc to the; 		     handle just allocated for all our icons ;; IN: (Y) contains the offset into the OneDoc to  look for an rIcon resource;AddIconToHandle		phy		lda	[<OneDocPtr],y		;is the rIcon ID == NIL?		iny		iny		ora	[<OneDocPtr],y		clc		beq	@noResource		;if so, leave		dey		dey		lda	[<OneDocPtr],y		tax		iny		iny		lda	[<OneDocPtr],y		cmp	<LastIconID+2		bne	@notSameID		cpx	<LastIconID		bne	@notSameID				ply		iny				;the RESULT goes a longword hence our resource ID		iny		iny		iny		lda	<LastIconIndex		;store the index into the icon handle and offsets arrays		sta	[<OneDocPtr],y		;in the OneDoc		iny		iny		lda	#0		sta	[<OneDocPtr],y		clc				;if we're the same as the last time, don't add any more to our size		rts		@notSameID	dey		dey		lda	[<OneDocPtr],y		sta	<LastIconID		tax		iny		iny		lda	[<OneDocPtr],y		sta	<LastIconID+2		tay		lda	#$8001		jsr	findResource@noResource	ply		bcs	@foundResource		rts@foundResource	iny				;the RESULT goes a longword hence our resource ID		iny		iny		iny		lda	IconArrayUsed		;store the index into the icon handle and offsets arrays		sta	<LastIconIndex		sta	[<OneDocPtr],y		;in the OneDoc		iny		iny		lda	#0		sta	[<OneDocPtr],y		ldy	#resOffset		;make our source pointer		lda	[<resRefRec],y		clc		adc	<rFork		tax		iny		iny		lda	[<resRefRec],y		adc	<rFork+2		pha		phx		pushZLong <IconList		;destination pointer (it moves)				ldy	#resSize+2		;the size to move		lda	[<resRefRec],y		pha		dey		dey		lda	[<resRefRec],y		pha			pea	$0805		jsl	Move_Info				lda	IconArrayUsed		;make an index into our list of icon handles and		sta	<Offset		stz	<Offset+2				asl	<Offset			;Offset *= 4		rol	<Offset+2		asl	<Offset		rol	<Offset+2				lda	<Offset			;add the offset to the start of the offset list		clc		adc	<OffsetListStart		sta	<OffsetListPtr		lda	<Offset+2		adc	<OffsetListStart+2		sta	<OffsetListPtr+2				lda	<Offset			;add the offset to the start of the handle list		clc		adc	<HandleListStart		sta	<HandleListPtr		lda	<Offset+2		adc	<HandleListStart+2		sta	<HandleListPtr+2		lda	<IconList		;take the current icon pointer and make an offset		sec				;from the beginning of the IconList		sbc	<IconListPtr		sta	[<OffsetListPtr]		lda	<IconList+2		sbc	<IconListPtr+2		ldy	#2		sta	[<OffsetListPtr],y		lda	<IconListHandle		;store the handle of the block of our icon		sta	[<HandleListPtr]		lda	<IconListHandle+2		sta	[<HandleListPtr],y		inc	IconArrayUsed				ldy	#resSize		;point to the next spot to stuff an icon		lda	[<resRefRec],y		;into our handle		clc		adc	<IconList		sta	<IconList		iny		iny		lda	[<resRefRec],y		adc	<IconList+2		sta	<IconList+2		sec		rts		;; findResource -- given a type and ID, walk the resRefRec array and see if a resource type;		   and ID exist;; IN:  (A) = resource type;      (X) = resource ID, low word    \ if resource ID == 0, find first resource of that type;      (Y) = resource ID, high word   /;; OUT: SEC if resource found, <RESREFREC points to it resRefRec;      CLC if resource not found;findResource	sta	<resourceType		stx	<resourceID		sty	<resourceID+2		lda	<resRefRecStart		sta	<resRefRec		lda	<resRefRecStart+2		sta	<resRefRec+2		@ResRefRecLoop	lda	[<resRefRec]		bne	@haveResRefRec		clc		rts		@haveResRefRec	cmp	<resourceType		bne	@nextResRefRec				lda	<resourceID		;if resourceID == 0, we've found the first one		ora	<resourceID+2		beq	@gotIt				ldy	#resID		lda	[<resRefRec],y		cmp	<resourceID		bne	@nextResRefRec		iny		iny		lda	[<resRefRec],y		cmp	<resourceID+2		beq	@gotIt@nextResRefRec	lda	<resRefRec		clc		adc	#ResRecSize 		sta	<resRefRec		bcc	@goResRecLoop		inc	<resRefRec+2@goResRecLoop	brl	@ResRefRecLoop		@gotIt		sec		rts		;; local (makes it non-romable, but oh well);address		dc.w	0		ENDP		;; LoadRBundle;; load the given RBundle resource and put its constituent pieces (OneDocs); in their proper places.;;	IN:;		---stack---;		|  long   |	space for the rBundleHandle;		|  word	  |	flag, bundle is the Finder's if = $8000, otherwise must be 0000!;		|  long   |	handle to the volume name;		|  word   |	flag, boolean, rBundle is a resource (0) or handle (1);		|  long	  |	rBundle resource #;		| 3 bytes |	return address;		----------- <-SP;;	OUT:;		---stack---;		|  long   |	rBundleHandle (unlocked when done) or NIL if error;		| 3 bytes |	return address;		----------- <-SP;; Return error code in A.;;.....................................................................LoadRBundle	PROCNAME EXPORT		IMPORT	fileTypeList		IMPORT	deviceTypeList		IMPORT	fTypeInsertList		IMPORT	dTypeInsertList		IMPORT	NewHandle		IMPORT	HandleToPointer		IMPORT	BundleID		IMPORT	FinderPathID				DefineStackPriorItemOffset long				;offset to prior item in chainPriorItemPtr	longNextItemOffset 	long				;offset to next item in chainNextItemPtr	long				ItemPtr		longItemOffset	long				;offset of the item which we're adding to chainChainInsert	long				;ptr to offset to insertion point in chainChainStart	long				;ptr to offset to start of chainTablePtr	longTableHandle	longrFPathID	long				;ID for rFinderPath resourcerVersID		long				;ID for rVersion  resourcerVersHandle	longrIconHandle	longrFPList		longOneDocOffset	longrFinderHandle	longMatchFlags	longrBundle		longDocList		longOneDoc		longrFinderPath	longhandleSize	longretAddr		block 3resource	longhandleFlag	wordvolumeNameHandle longfinderFlag	wordrBundleHandle	longinParms		SET	12	;14-1 longlocParms	SET	92		tsc		sec		sbc	#locParms		tcs		phb				;preserve data bank		phd		tcd				;set DP to stack		phk		plb;; now that our stack frame is all setup, get the resource and scatter its; component OneDOC's through a whole bunch of handles...;		lda	<resource		;move this to rBundleHandle in case		sta	<rBundleHandle		;this is actually a handle and not		ldx	<resource+2		;a resource ID		stx	<rBundleHandle+2				ldy	handleFlag		;if we've got a handle, don't load		bne	goodRBundle		;anything				pha		pea	1		_SetResourceFileDepth		pla		sta	oldDepth		pha		pha		pea	$802B			;rBundle		pushZLong <resource		_LoadResource		tay		pla		sta	<rBundleHandle		plx		stx	<rBundleHandle+2		bcc	goodRBundle				stz	<rBundleHandle		stz	<rBundleHandle+2		brl	done_error		;not loaded, so nothing to releasegoodRBundle		pha		pha		phx		pha		jsl	handleToPointer		;this also locks it down (very good)		pulllong <rBundle		ldy	#6			;say this bundle is MINE!		lda	BundleID		sta	[<rBundleHandle],y		ldy	#4			;only set the purge level to zero if it's not		lda	[<rBundleHandle],y	;already		and	#$0300		beq	@noPurge				pea	0			;set the purge level of the handle to zero		pushZLong <rBundleHandle	;so it won't leave		_SetPurge@noPurge;; first, check the version to make sure we can handle it (currently version == 0);		lda	[<RBundle]		beq	versionWeKnow		bmi	versionWeKnow				jsr	detachRBundle		jsr	disposeRBundle		brl	done			;detach 'em and dispose 'emversionWeKnow		ldy	handleFlag		;if we've got a handle, save the rBundle's ID		bne	@noRBundleID				ldy	#8			;rBundleID		lda	<resource		sta	[<rBundle],y		iny		iny		lda	<resource+2		sta	[<rBundle],y@noRBundleID				ldy	#12			;rBundleVolumeHandle		lda	<volumeNameHandle		sta	[<rBundle],y		iny		iny		lda	<volumeNameHandle+2		sta	[<rBundle],y			ldy	#2		lda	[<rBundle],y		;offset to oneDocs		clc		adc	<rBundle		sta	<DocList		lda	<rBundle+2		adc	#0		sta	<DocList+2		lda	[<DocList]		;if we don't have any OneDocs, then		sta	countOfONEdocs		;we're not going to do squat		bne	@haveSomeOneDocs				jsr	detachRBundle		jsr	disposeRBundle		brl	done			;detach 'em and dispose 'em@haveSomeOneDocs		lda	<DocList		clc		adc	#2		sta	<OneDoc		lda	<DocList+2		adc	#0		sta	<OneDoc+2;; now, go through each ONEdoc structure, moving each structure out of the RBundle; resource into the match chain for each filetype or into the master match list; for anything else;; the idea here is fairly simple -- there is one master chain, and our oneDoc handle;				    gets added on...;nextOneDoc			lda	<OneDoc			;calculate the offset of our OneDoc from		sec				;the beginning of the rBundle handle		sbc	<rBundle				sta	<OneDocOffset		lda	<OneDoc+2		sbc	<rBundle+2		sta	<OneDocOffset+2				ldy	#4			;get rFinderPath (if there is one)		lda	[<OneDOC],y		cmp	#2		bge	@givePath		brl	@noIconAtAll@givePath	lda	<handleFlag		;if we're doing things by handle, then		beq	@rFPathIsID		;we've already got this loaded... (or not)				ldy	#12		lda	[<OneDOC],y		sta	<rFinderHandle		iny		iny		lda	[<OneDOC],y		sta	<rFinderHandle+2				ora	<rFinderHandle		;if we got a handle..		bne	@rFPathIsHandle		;then we can use that handle		brl	@noIconAtAll		;if not, ignore that handle		@rFPathIsID	ldy	#12		lda	#0		sta	[<OneDOC],y		;zero out the rFinderPathHandle		iny		iny		sta	[<OneDOC],y		ldy	#8			;but only get it if there is one		lda	[<OneDOC],y		bne	@loadRFinderPath		iny		iny		ora	[<OneDOC],y		bne	@loadRFinderPath		brl	@noIconAtAll@loadRFinderPath		pha		pha		pea	$802C			;rFinderPath		ldy	#10			;rFinderPathID+2		lda	[<OneDOC],y		sta	<rFPathID+2		pha		dey		dey		lda	[<OneDOC],y		sta	<rFPathID		pha		_LoadResource		tay		pla		plx		bcs	@errorRFinderPath		ldy	#12			;rFinderPathHandle		sta	[<OneDOC],y		sta	<rFinderHandle		iny		iny		txa		sta	[<OneDOC],y		sta	<rFinderHandle+2		;; drop down here if the rFPath is already loaded -- we need to change its memory ID and make; it non-purgable;@rFPathIsHandle	ldy	#6		lda	FinderPathID		sta	[<rFinderHandle],y		ldy	#4		lda	[<rFinderHandle],y		and	#$0300		beq	@loadRVersion				pea	0			;set the purge level of the handle to zero		pushZLong <rFinderHandle	;so it won't leave		_SetPurge		bra	@loadRVersion@errorRFinderPath		cpy	#$1e06			;if we couldn't find that icon, mark it as generic		beq	@noRFinderPath		;but, if we had some other kind of error, just		brl	errorResource		;leave, don't dispose anything, but mark as error		@noRFinderPath	lda	#0			;if we got an error getting the				ldy	#8			;rFinderPathID		sta	[<OneDOC],y		iny		iny		sta	[<OneDOC],y				iny		iny		sta	[<OneDOC],y		;rFinderPathHandle		iny		iny		sta	[<OneDOC],y		brl	@noIconAtAll;; now that we've grabbed the rFinderPath, grab the rVersion from the rFinderPath;@loadRVersion		stz	<rVersID		stz	<rVersID+2				stz	<rVersHandle		stz	<rVersHandle+2				ldy	#4			;lock the rFinderPath down for a moment		lda	[<rFinderHandle],y	;while we get the rVersion referenced		ora	#$8000			;by it...		sta	[<rFinderHandle],y		lda	[<rFinderHandle]	;deref rFinderPath's handle		tax		ldy	#2		lda	[<rFinderHandle],y		sta	<rFinderPath+2		stx	<rFinderPath		ldy	#4			;find out if there really is an		lda	[<rFinderPath],y	;rVersion reference		cmp	#1		bge	@hasRVersion				jsr	unlockRFPath		brl	@noIconAtAll@hasRVersion		lda	#0		ldy	#10			;zero out the rVersionHandle		sta	[<rFinderPath],y		iny		iny		sta	[<rFinderPath],y		ldy	#6			;if there is, see if it's non-zero		lda	[<rFinderPath],y		bne	@loadRVers		iny		iny		ora	[<rFinderPath],y		bne	@loadRVers				jsr	unlockRFPath		brl	@noIconAtAll@loadRVers	pha		pha		pea	$8029			;rVersion		ldy	#8			;rVersionID+2		lda	[<rFinderPath],y		sta	<rVersID+2		pha		dey		dey		lda	[<rFinderPath],y		sta	<rVersID		pha		_LoadResource		tay		pla		plx		bcs	@errorRVersion		ldy	#10			;rVersionHandle		sta	[<rFinderPath],y		sta	<rVersHandle		iny		iny		txa		sta	[<rFinderPath],y		sta	<rVersHandle+2		ldy	#6		lda	FinderPathID		sta	[<rVersHandle],y		ldy	#4			;if the purge level is already zero, then		lda	[<rVersHandle],y	;don't set the purge level again		and	#$0300		beq	@unlockRFPath				pea	0			;set the purge level of the handle to zero		pushZLong <rVersHandle		;so it won't leave		_SetPurge@unlockRFPath	jsr	unlockRFPath		bra	@addRFPToList@errorRVersion	cpy	#$1e06			;if we couldn't find that icon, mark it as generic		beq	@noRVersion		;but, if we had some other kind of error, just		brl	errorResource		;leave, don't dispose anything, but mark as error		@noRVersion	lda	#0		ldy	#10			;rVersionHandle		sta	[<rFinderPath],y		iny		iny		sta	[<rFinderPath],y		jsr	unlockRFPath		brl	@noIconAtAll		;don't add us to the rFinderPathList		;; addRFPToList -- add our rFinderPath's handle, ID, rVersion handle, rVersion ID,;             	  rBundle handle, OneDoc offset, and volume handle to the rFinderPath;       	  list;@addRFPToList			lda	rFPCount		cmp	rFPMax		blt	@rFPNotFull		inc	rFPMax		inc	a			;always allocate enough space		sta	rFPIndex		stz	rFPIndex+2				ldx	#4			;multiply by 32@xLoop		asl	rFPIndex		rol	rFPIndex+2		dex		bpl	@xLoop		pushlong rFPIndex		;add 32 onto the end of our handle		pushlong rFPListHandle		_SetHandleSize		bcc	@rFPNotFull		;if it added, then we're OK				dec	rFPMax			;didn't work, so don't ad any more rFPaths to memory		brl	@noIconAtAll				@rFPNotFull	lda	rFPListHandle		;get the handle to the rFinderPath		sta	<rFPList		;list		lda	rFPListHandle+2		sta	<rFPList+2		lda	[<rFPList]		;deref			tax		ldy	#2		lda	[<rFPList],y		sta	<rFPList+2		stx	<rFPList		lda	rFPCount		;find our current index		sta	rFPIndex		stz	rFPIndex+2		inc	rFPCount		;always one more				ldx	#4			;multiply by 32@iLoop		asl	rFPIndex		rol	rFPIndex+2		dex		bpl	@iLoop				lda	rFPIndex		;add index to ptr		clc		adc	<rFPList		sta	<rFPList		lda	rFPIndex+2		adc	<rFPList+2		sta	<rFPList+2				lda	<rFinderHandle		;rFinderPath's handle first		sta	[<rFPList]		ldy	#2		lda	<rFinderHandle+2		sta	[<rFPList],y				iny				;rFinderPath's ID next		iny		lda	<rFPathID		sta	[<rFPList],y		iny		iny		lda	<rFPathID+2		sta	[<rFPList],y				iny				;rBundle's handle next		iny		lda	<rBundleHandle		sta	[<rFPList],y		iny		iny		lda	<rBundleHandle+2		sta	[<rFPList],y		iny				;OneDocOffset next		iny		lda	<OneDocOffset		sta	[<rFPList],y		iny		iny		lda	<OneDocOffset+2		sta	[<rFPList],y		iny				;rVersion handle next		iny		lda	<rVersHandle		sta	[<rFPList],y		iny		iny		lda	<rVersHandle+2		sta	[<rFPList],y		iny				;rVersion ID next		iny		lda	<rVersID		sta	[<rFPList],y		iny		iny		lda	<rVersID+2		sta	[<rFPList],y		iny				;handle of volume name is last		iny		lda	<volumeNameHandle		sta	[<rFPList],y		iny		iny		lda	<volumeNameHandle+2		sta	[<rFPList],y		;; now, decide which list this onedoc is going to go into... either the name !filetype; chain, or the filetype chain, or the everything else (master) chain.;@noIconAtAll		ldy	#2			;get the offset to the matchflags		lda	[<oneDoc],y		clc		adc	<OneDoc		sta	<matchFlags		lda	<OneDoc+2		adc	#0		sta	<matchFlags+2		lda	ChainTable		sta	<TableHandle		lda	ChainTable+2		sta	<TableHandle+2				lda	[<tableHandle]		sta	<tablePtr		ldy	#2		lda	[<tableHandle],y		sta	<tablePtr+2		lda	[<matchFlags]		;see if we're going to be matching		and	#matchFiletype		;by filetype		bne	@typeMatchList		lda	[<matchFlags]		;see if we're going to be matching		and	#matchFilename		;by filename		bne	@nameMatchList;; ouch, there is no match by prodos filetype criteria, so, we stick it into the; master match list and move this oneDoc structure to the beginning of the chain;@masterMatchList		lda	#MasterChainInsert		sta	<ChainInsert		lda	#MasterChainInsert>>16		sta	<ChainInsert+2				lda	#MasterChain		sta	<ChainStart		lda	#MasterChain>>16		sta	<ChainStart+2				brl	@checkChain		;; ouch, there is no match by prodos filetype criteria, so, we stick it into the; name match list and move this oneDoc structure to the beginning of the chain;@nameMatchList		lda	#NameChainInsert		sta	<ChainInsert		lda	#NameChainInsert>>16		sta	<ChainInsert+2		lda	#NameChain		sta	<ChainStart		lda	#NameChain>>16		sta	<ChainStart+2		brl	@checkChain;; anything after here gets stuck in the filetype list -- we put the OneDoc structure; in a chain of handles for that filetype, each of which has to be looked through; before saying something matched or not...;@typeMatchList		ldy	#4			;see if the ID for this matchXXX		lda	[<MatchFlags],y		;field is correct for matchFiletype		cmp	#matchFiletypeID		bne	@masterMatchList		ldy	#6		lda	[<MatchFlags],y		bmi	@deviceType		and	#$00FF			;just in case (who knows what it is?)		asl	a			;a = a*4		asl	a				tax		clc		adc	#fTypeInsertList		sta	<ChainInsert		lda	#fTypeInsertList>>16		adc	#0		sta	<ChainInsert+2		txa		clc		adc	#fileTypeList		sta	<ChainStart		lda	#fileTypeList>>16		adc	#0		sta	<ChainStart+2		bra	@checkChain;; the OneDoc is for a device (filetype is negative), so put the OneDoc into the; devicetype list;@deviceType	and	#$00FF			;just in case (who knows what it is?)		asl	a			;a = a*4		asl	a				tax		clc		adc	#dTypeInsertList		sta	<ChainInsert		lda	#dTypeInsertList>>16		adc	#0		sta	<ChainInsert+2		txa		clc		adc	#deviceTypeList		sta	<ChainStart		lda	#deviceTypeList>>16		adc	#0		sta	<ChainStart+2;; if the chain table is full, extend it by another 'MaxChains' records if possible;@checkChain	ldy	#4			;does the number we have size for match the number		lda	[<tablePtr]		;which we've used so far?		cmp	[<tablePtr],y		blt	@noExtend				lda	[<tableHandle],y	;unlock and unfix the block		and	#$3FFF		sta	[<tableHandle],y		pha				;get the old handle size and stretch		pha				;it by a longword		pushZLong <tableHandle		_GetHandleSize			;and it had BETTER be unlocked at this		pla				;point		sta	<handleSize		clc		adc	#16*MaxChains		;want to add enough for 'MaxChains' more records		tax		pla		sta	<handleSize+2		adc	#0		pha		phx		pushZLong <tableHandle		_SetHandleSize		lda	[<tableHandle]		;deref the new handle to our chain table		sta	<tablePtr		ldy	#2		lda	[<tableHandle],y		sta	<tablePtr+2		iny				;say we can handle 'MaxChains' more records		iny		lda	[<tablePtr],y		clc		adc	#MaxChains		sta	[<tablePtr],y;; now that we're sure we have enough space to add the extra record, add it;@noExtend	lda	[<tablePtr]		sta	<ItemOffset		stz	<ItemOffset+2				ldx	#3			;add the record onto 16*recordCount@rolLoop	asl	<ItemOffset		rol	<ItemOffset+2		dex		bpl	@rolLoop		stz	<NextItemOffset		stz	<NextItemOffset+2;; find out where the item in front of the item we're adding is -- and if it doesn't exist, there's no way; to change its backwards link to point to us, and there's also no way to adjust the item PRIOR to the; the item we're adding to have its forward link point to the item being added.;		lda	[<ChainInsert]		sta	<PriorItemOffset		ldy	#2		lda	[<ChainInsert],y		sta	<PriorItemOffset+2				ora	<PriorItemOffset		bne	@linkForward		ldx	#0		lda	[<ChainStart]		ora	[<ChainStart],y		beq	@first				lda	[<ChainStart]		sta	<NextItemOffset		lda	[<chainStart],y		sta	<NextItemOffset+2		inx@first				lda	<ItemOffset		;if there's no next item, then the item we're adding		sta	[<ChainStart]		;goes to the head of the list and we need to make the		lda	<ItemOffset+2		;start of the chain point to it		sta	[<ChainStart],y				txa		beq	@noLinkForward		bra	@linkAtFront		;; if there actually is a "prior" item in our list, after saving that prior item's forwards pointer, we need; to adjust the "prior" item's forwards link to point to the item which we're adding... ;@linkForward	lda	<PriorItemOffset	;take our next chain offset and make a pointer to the forward		clc				;chain with it.		adc	<TablePtr		sta	<PriorItemPtr		lda	<PriorItemOffset+2		adc	<TablePtr+2		sta	<PriorItemPtr+2				lda	[<PriorItemPtr]		sta	<NextItemOffset		ldy	#2		lda	[<PriorItemPtr],y		sta	<NextItemOffset+2				lda	<ItemOffset+2		;make our forward item link back to the item which we're		sta	[<PriorItemPtr],y	;adding to the list		dey		dey		lda	<ItemOffset		sta	[<PriorItemPtr],y		;; Make the backwards pointer of the next item point to the item which we're inserting into the list; only if there actually IS a next item to point back to us...;		lda	<NextItemOffset		;if there's no next item, then don't try to add us anywhere		ora	<NextItemOffset+2		beq	@noLinkForward@linkAtFront	lda	<NextItemOffset		clc		adc	<TablePtr		sta	<NextItemPtr		lda	<NextItemOffset+2		adc	<TablePtr+2		sta	<NextItemPtr+2						ldy	#12		lda	<itemOffset		sta	[<NextItemPtr],y		iny		iny		lda	<itemOffset+2		sta	[<NextItemPtr],y;; Now, put the offset to the item we're adding into the beginning of our chain (which either resides in the; filetype insert list, the device type insert list, the name chain insert, or the master chain insert.;@noLinkForward		lda	<ItemOffset		;put the offset to our new item into the insert pointer		sta	[<ChainInsert]		;for this particular chain to the new record		ldy	#2		lda	<ItemOffset+2		sta	[<ChainInsert],y		lda	<ItemOffset		clc		adc	<TablePtr		sta	<ItemPtr		lda	<ItemOffset+2		adc	<TablePtr+2		sta	<ItemPtr+2;; Move the OneDoc information (bundle handle and offset into bundle) into the 16 byte item,; including the offset of the next item and prior item (if it existed);		lda	<NextItemOffset		;move the old offset to my first record in the chain		sta	[<ItemPtr]		;into this record		lda	<NextItemOffset+2		sta	[<ItemPtr],y		;y is already 2		iny		iny		lda	<rBundleHandle		;use this first OneDoc structure		sta	[<ItemPtr],y		;as first in chain		iny		iny		lda	<rBundleHandle+2	;put our rBundle handle first		ora	finderFlag		;either $8000 or $0000		sta	[<ItemPtr],y		iny				;then, put the OneDoc's offset in the		iny				;new item		lda	<OneDocOffset		sta	[<ItemPtr],y		iny		iny		lda	<OneDocOffset+2		sta	[<ItemPtr],y		iny				;then put the prior item's offset into 		iny				;the new item		lda	<PriorItemOffset		sta	[<ItemPtr],y		iny		iny		lda	<PriorItemOffset+2		sta	[<ItemPtr],y		lda	[<tablePtr]				inc	a			;say we got one more record in the chain table		sta	[<tablePtr]		lda	<OneDoc			;make ptr to next OneDoc structure		clc		adc	[<OneDoc]		;yes, this is only a word folks...		sta	<OneDoc		bcc	@nr		inc	<OneDoc+2@nr		dec	countOfOneDocs		beq	doneWithResource		brl	nextOneDoc;; we're done fiddling with this rBundle resource, so we can release it, reset the; resource depth and we'll be on our way shortly;doneWithResource		jsr	detachRBundle		jsr	detachAllFromBundle				ldy	#4			;unlock and unfix the rBundle resource		lda	[<rBundleHandle],y		and	#$3fff		sta	[<rBundleHandle],ydone		ldy #0done_error	lda	handleFlag		;if we've got a handle, don't load		bne	@wasByHandle		phy		pha				;reset the file depth before leaving		lda	oldDepth		pha		_SetResourceFileDepth		pla		ply@wasByHandle		pld		plb		lda	retAddr+1,s		;clean up stack		sta	retAddr+inParms+1,s		lda	retAddr,s		sta	retAddr+inParms,s		tsc		clc		adc	#inParms+locParms		tcs		tya				;error code if stack result = NIL		rtl;; detachAllFromBundle -- detach all the rFinderPath's, all the rVersions attached to the rFinderPath's,;                        and all the rIcons attached to this rBundle;detachAllFromBundle		lda	<handleFlag		;if this is being done by handle, don't detach squat		bne	@leave				lda	[<DocList]		;if we don't have any OneDocs, then		sta	countOfONEdocs		;we're not going to do squat		bne	@haveSomeOneDocs@leave		rts@haveSomeOneDocs		lda	<DocList		clc		adc	#2		sta	<OneDoc		lda	<DocList+2		adc	#0		sta	<OneDoc+2;; see if we have an rFinderPath and also an rVersion attached to the rFinderPath and detach either.;@loop		ldy	#4			;get rFinderPath (if there is one)		lda	[<OneDOC],y		;check numResults		cmp	#2		bge	@givePath		brl	@nextOneDoc@givePath	ldy	#8			;but only get it if there is one		lda	[<OneDOC],y		bne	@hasRFinderPath		iny		iny		ora	[<OneDOC],y		bne	@hasRFinderPath		brl	@nextOneDoc@hasRFinderPath	ldy	#12+1			;did we get a handle for the rFinderPath?		lda	[<OneDOC],y		beq	@nextOneDoc		;if not, then don't detach anything				pea	$802C			;rFinderPath		ldy	#10		lda	[<OneDOC],y		pha		dey		dey		lda	[<OneDOC],y		pha		_DetachResource				ldy	#12		lda	[<OneDOC],y		sta	<rFinderHandle		iny		iny		lda	[<OneDOC],y		sta	<rFinderHandle+2				ldy	#4			;lock the rFinderPath down for a moment		lda	[<rFinderHandle],y	;while we get the rVersion referenced		ora	#$8000			;by it...		sta	[<rFinderHandle],y		lda	[<rFinderHandle]	;deref rFinderPath's handle		tax		ldy	#2		lda	[<rFinderHandle],y		sta	<rFinderPath+2		stx	<rFinderPath		ldy	#4			;find out if there really is an		lda	[<rFinderPath],y	;rVersion reference		cmp	#1		bge	@hasRVersion				jsr	unlockRFPath		bra	@nextOneDoc@hasRVersion		ldy	#6			;if there is, see if it's non-zero		lda	[<rFinderPath],y		bne	@detachRVersion		iny		iny		ora	[<rFinderPath],y		bne	@detachRVersion				jsr	unlockRFPath		bra	@nextOneDoc@detachRVersion	ldy	#10+1			;did we get a handle for this?		lda	[<rFinderPath],y		beq	@nextOneDoc		;if not, don't detach anything				pea	$8029			;rVersion		ldy	#8		lda	[<rFinderPath],y		pha		dey		dey		lda	[<rFinderPath],y		pha		_DetachResource		jsr	unlockRFPath;; look at the next OneDoc;@nextOneDoc	lda	<OneDoc			;make ptr to next OneDoc structure		clc		adc	[<OneDoc]		;yes, this is only a word folks...		sta	<OneDoc		bcc	@nr		inc	<OneDoc+2@nr		dec	countOfOneDocs		beq	@done		brl	@loop@done		rts;; unlock the rFinderPath;unlockRFPath		ldy	#4			;unlock the rFinderPath's handle		lda	[<rFinderHandle],y		and	#$7FFF		sta	[<rFinderHandle],y		rts		;; detach the RBundle resource if we're not doing this by handle;detachRBundle		lda	<handleFlag		if it's by handle, don't detach anything		bne	@noDetach				pea	$802B			;detach this rBundle		pushZLong <resource		_DetachResource@noDetach	rts;; dispose the RBundle handle if we're not doing this by handle;disposeRBundle		lda	<handleFlag		;if it's by handle, don't detach anything		bne	@noDetach		pushZLong <rBundleHandle	;get rid of the rBundle because we're		jsl DisposeHandleGlue		;not going to use it at all...		@noDetach	stz	<rBundleHandle		;flag as an error		stz	<rBundleHandle+2		rts			;; errorResource -- maybe we ran out of memory, so detach the rBundle and everything in it;		   but under NO CIRCUMSTANCES should anything in the rBundle be disposed because;		   we don't know how much made it into memory and how much got added to any of the;		   chains (and we don't care to walk the chains to find out).;errorResource		jsr	detachRBundle		jsr	detachAllFromBundle				ldy	#4			;unlock the rBundle resource		lda	[<rBundleHandle],y		and	#$7fff		sta	[<rBundleHandle],y				stz	<rBundleHandle		;say we had an accident so maybe someone can compensate		stz	<rBundleHandle+2		brl	done		;; locals;rFPIndex	dc.L	0			;index into rFinderPath listdeviceTypeToMatch dc.w	0			;these are here forfiletypeToMatch dc.w	0			;clarity's sakeoldDepth	dc.w	0countOfONEdocs	dc.w	0		ENDP;; matchFileToIcon;; Given the following parameters, look through all the loaded icon files and see; if there is a match.  If there isn't a match, then NIL is returned as the OneDOC; ptr and the handle returned is to the generic document icon.;; The method if searching is simple -- we first look through the master match list; of stuff which isn't going to match by filetype.  If nothing in the master match list; wants the file, then we go look at the filetype index table to see if anything; matches.  If no OneDOC structures exist for the given filetype (ie, handle to; chain is NIL), then the generic icon is used.;; The 'whichMatch' parameter is used so that if we couldn't find the application which; normally opens this document, we can suggest an alternative to the user by suggesting; that "I can't find app xxx, would you like to use app yyy instead?"  This assumes; that we go out and find app yyy before showing the user the dialog.;;	IN:;		|  long  |   	space;		|  long  |	space;		|  long  |	space;		|  long  |	space;		|  long  |	space;		|  word  |	voting bits (4-7) we want ($8000 = don't care);		|  word  |	which match we want (1 or higher);		|  word  |	filetype;		|  long  |	auxtype;		|  long  |	ptr to filename to match against;		|  long  |	ptr to create date/time;		|  long  |	ptr to mod date/time;		|  word  |	local access word;		|  word  |	extended (high bit);		|  long  |	ptr to option_list or NIL;		|  long  |	eof to match against;		---------- <-SP;;	OUT:;		|  long  |	handle to rFinderPath or NIL if no one owns icon;		|  long  |	Index to Large Icon to use (can be NIL);		|  long  |	Index to Small Icon to use (can be NIL);		|  long  |	handle to rBundle structure which matches or NIL;		|  long	 |	offset to OneDoc structure which matches or NIL;		---------- <-SP;.....................................................................matchFileToIcon PROCNAME EXPORT		IMPORT	fileTypeList		IMPORT	deviceTypeList		DefineStackSourceValue	block 8	CompareValue	block 8	matchPtr	long	matchFlagsPtr	long	OneDocPtr	long	TablePtr	longTableHandle	long	ChainOffset	longChainPtr	long	rBundlePtr	long	retAddr		block 3	DataForkEOF	long				4optionListPtr	long				8ExtendedType	word				10localAccess	word				12ModDatePtr	long				16CreateDatePtr	long				20FilenamePtr	long				24Fauxtype	long				28Ffiletype	word				30whichMatch	word				32votingBits	word				34OneDocOffset	long				38rBundleHandle	long				42SmallIconIndex	long				46LargeIconIndex	long				50FinderPathHandle long				54	inParms		SET	34			;54-5 longslocParms	SET	48				tsc		sec		sbc	#locParms		;allocate extra DP space for local DP		tcs		phb				;preserve data bank		phd		tcd				;set DP to stack		phk		plb;; now that we have the stack setup, go searchin';		stz	<FinderPathHandle	;but we might not have a place get the		stz	<FinderPathHandle+2	;finder path handle		stz	<LargeIconIndex		;might not have something specifying		stz	<LargeIconIndex+2	;the large icon's handle, either		lda	#1			;might not have anything specifying		sta	<SmallIconIndex		;the small icon's handle either		stz	<SmallIconIndex+2		lda	ChainTable		sta	<TableHandle		lda	ChainTable+2		sta	<TableHandle+2				lda	[<TableHandle]		sta	<TablePtr		ldy	#2		lda	[<TableHandle],y		sta	<TablePtr+2;; NOTE: Each record in the chain table is composed of 4 longs, the first being the offset of the;	next record in the chain.  The second long being the rBundle for an icon, the third being;	the offset into the rBundle for the OneDoc for the icon, and the last being the offset of;	the previous record in the chain (or nil if no previous record).;		lda	NameChain		;find out where the name chain		sta	<chainOffset		;is (and don't make any tool calls which		lda	NameChain+2		;could move memory or you'll be sorry)		sta	<chainOffset+2@nameLoop	ora	<ChainOffset		beq	@lookAtFiletypes		lda	<TablePtr		clc		adc	<ChainOffset		sta	<ChainPtr		lda	<TablePtr+2		adc	<ChainOffset+2		sta	<ChainPtr+2		jsr	findMatch		bcs	@matchedInName@nextName	lda	[<chainPtr]		sta	<ChainOffset		ldy	#2		lda	[<ChainPtr],y		sta	<ChainOffset+2		bra	@nameLoop;; matchedInName -- we found a match in the name list, but before we leave, we need;		   to be sure that this is the match that we were asked for...;@matchedInName		dec	<whichMatch		bne	@nextName		brl	@matched;; we're done looking through all the stuff in the master list of stuff to match; against;@lookAtFiletypes		lda	<FfileType		bpl	@filetype		lda	#deviceTypeList		;get the pointer to the 1K deviceType		sta	<chainPtr		;list of handles		lda	#deviceTypeList>>16		sta	<chainPtr+2		bra	@deviceType@fileType	lda	#fileTypeList		;get the pointer to the 1K filetype list		sta	<chainPtr		;of handles		lda	#fileTypeList>>16		sta	<chainPtr+2@deviceType	lda	<Ffiletype		and	#$00FF		asl	a		asl	a		tay				lda	[<chainPtr],y		;if there is, then get the handle		sta	<ChainOffset		iny		iny		lda	[<chainPtr],y		sta	<ChainOffset+2@filetypeLoop	ora	<ChainOffset		beq	@lookAtMaster				lda	<TablePtr		clc		adc	<ChainOffset		sta	<ChainPtr		lda	<TablePtr+2		adc	<ChainOffset+2		sta	<ChainPtr+2				jsr	findMatch		;see if the OneDOC structure matches		bcs	@matchedInTypes@nextType	lda	[<ChainPtr]		sta	<ChainOffset		ldy	#2		lda	[<ChainPtr],y		sta	<ChainOffset+2		bra	@filetypeLoop;; matchedInTypes -- we found a match in the types list, but before we leave, we need;		    to be sure that this is the match that we were asked for...;@matchedInTypes		dec	<whichMatch		bne	@nextType		brl	@matched;; lookAtMaster -- look through the master list as a 'catch all' of anything that didn't;		  already match through filetypes or by name;@lookAtMaster		lda	MasterChain		;find out where the master chain		sta	<ChainOffset		;is (and don't make any tool calls which		lda	MasterChain+2		;could move memory or you'll be sorry)		sta	<ChainOffset+2@masterLoop	ora	<ChainOffset		beq	@nothing		lda	<TablePtr		clc		adc	<ChainOffset		sta	<ChainPtr		lda	<TablePtr+2		adc	<ChainOffset+2		sta	<ChainPtr+2		jsr	findMatch		bcs	@matchedInMaster@nextMaster	lda	[<chainPtr]		sta	<ChainOffset		ldy	#2		lda	[<ChainPtr],y		sta	<ChainOffset+2		bra	@masterLoop;; matchedInMaster -- we found a match in the master list, but before we leave, we need;		     to be sure that this is the match that we were asked for...;@matchedInMaster		dec	<whichMatch		bne	@nextMaster;; if it matched, then retrieve the large icon, small icon, rFinderPath (if there is any); and onedoc handle -- oneDoc handle is already filled out for us after the 'findMatch'; routine.;@matched	lda	<OneDocPtr		;calculate the offset		sec		sbc	<rBundlePtr		sta	<OneDocOffset		lda	<OneDocPtr+2		sbc	<rBundlePtr+2		sta	<OneDocOffset+2		ldy	#4			;see if they have a place for us to		lda	[<OneDOCPtr],y		;get the finderpath handle from		cmp	#2		blt	@done		ldy	#12			;rFinderPathHandle		lda	[<OneDocPtr],y		sta	<FinderPathHandle		iny		iny		lda	[<OneDocPtr],y		sta	<FinderPathHandle+2		ldy	#4			;do they have a place for us to		lda	[<OneDOCPtr],y		;get the large icon from?		cmp	#3		blt	@done		ldy	#20			;Index to find large icon		lda	[<OneDocPtr],y		sta	<LargeIconIndex		iny		iny		lda	[<OneDocPtr],y		sta	<LargeIconIndex+2		ldy	#4			;do they have a place for us to		lda	[<OneDOCPtr],y		;get the small icon from?		cmp	#4		blt	@done		ldy	#28			;Index to find small icon		lda	[<OneDocPtr],y		sta	<SmallIconIndex		iny		iny		lda	[<OneDocPtr],y		sta	<SmallIconIndex+2		bra	@done;; we didn't match squatola, so set the icons to the generic icon set and NIL for; everything else -- the generic icons are setup on the way in;@nothing	stz	<OneDocOffset		stz	<OneDocOffset+2		stz	<rBundleHandle		stz	<rBundleHandle+2		;; we be chillin', we're finished;@done		pld		plb		lda	retAddr+1,s		;clean up stack		sta	retAddr+inParms+1,s		lda	retAddr,s		sta	retAddr+inParms,s		tsc		clc		adc	#inParms+locParms		tcs		rtl;; findMatch -- see if the OneDOC structure that chainPtr is a pointer to a handle to;	       really matches the criteria;findMatch	ldy	#4		lda	[<chainPtr],y		;get the rBundle handle		tax		iny		iny		lda	[<chainPtr],y				cmp	#$FFFF			;check to see if the entry was removed		bne	@notRemoved		;(rbundle handle is $FFFFFFFF is so)		cpx	#$FFFF		bne	@notRemoved		clc		rts		@notRemoved	and	#$7FFF			;mask bit 31 off of the rBundle's handle		sta	<rBundleHandle+2		stx	<rBundleHandle				lda	[<rBundleHandle]	;deref the handle		tax		ldy	#2					lda	[<rBundleHandle],y		sta	<rBundlePtr+2		stx	<rBundlePtr				ldy	#8			;add the offset to the derefed handle		lda	[<chainPtr],y		clc		adc	<rBundlePtr		sta	<OneDocPtr		iny		iny		lda	[<chainPtr],y		adc	<rBundlePtr+2		sta	<OneDocPtr+2		bit	<votingBits		bmi	@letItVote		ldy	#6			;see if any of the voting bits match		lda	[<OneDocPtr],y		;the voting level that we asked for		and	#$00F0			;if the high bit is set, always let it		and	<votingBits		;vote		bne	@letItVote		clc		rts@letItVote	ldy	#2			;add offset to matchFlags		lda	[<OneDocPtr],y		clc		adc	<OneDocPtr		sta	<matchFlagsPtr		lda	<OneDocPtr+2		adc	#0		sta	<matchFlagsPtr+2		lda	<matchFlagsPtr		;skip over the flags longword		clc		adc	#4		sta	<matchPtr		lda	<matchFlagsPtr+2		adc	#0		sta	<matchPtr+2		stz	matched			;nothing matched so far		ldx	#0		lda	[<matchFlagsPtr]		and	#$0FFF			;current used bits@loop		lsr	a		pha		bcc	@nr@zLoop		lda	[<matchPtr]		bne	@gotit		lda	<matchPtr		clc		adc	#2		sta	<matchPtr		bcc	@zLoop		inc	<matchPtr+2		bra	@zLoop@gotit		phx				;dispatch to match routine,		jsr	(addr,x)		;on return, carry set if matched,		plx				;carry clear if no match		bcs	@next		pla		rts@next		clc		adc	<matchPtr		sta	<matchPtr		bcc	@nr		inc	<matchPtr+2@nr		pla		beq	@done		inx		inx		bra	@loop@done		sec		rts;; lookFiletype -- see if there's a matchFiletype structure, and if there is, see if;		  our filetype matches;lookFiletype		lda	[<matchPtr]		cmp	#matchFiletypeID	;0x1		beq	@look		clc		rts@look		ldy	#2		lda	[<matchPtr],y		cmp	<FfileType		beq	@matched		clc		rts@matched	lda	#4		sec		rts;; lookAuxtype -- see if there's a matchAuxtype structure, and if there is, see if;		 our auxtype matches;lookAuxtype	lda	[<matchPtr]		cmp	#matchAuxtypeID		;0x2		beq	@look			;safety check, if we find anything other		clc		rts				;than the ID, just abort@look		lda	<Fauxtype		ldy	#2		and	[<matchPtr],y		ldy	#6		cmp	[<matchPtr],y		bne	@noMatch		lda	<Fauxtype+2		ldy	#4		and	[<matchPtr],y		ldy	#8		cmp	[<matchPtr],y		beq	@matched@noMatch	clc		rts@matched	lda	#10		sec		rts;; lookFilename -- see if there's a matchFiletype structure, and if there is, see if;		  our filetype matches;lookFilename		lda	[<matchPtr]		cmp	#matchFilenameID	;0x3		beq	@look		clc		rts@look		lda	<matchPtr		clc		adc	#2		sta	<matchPtr		bcc	@nr		inc	<matchPtr+2@nr		sep	#$30		LONGA	off		LONGI	off		lda	[<filenamePtr]		sta	filenameChars		ldy	#1		lda	[<matchPtr],y		cmp	#'*'		beq	lastToFirst;; hey, what about the 'abc*xyz' possibility?;; match first to last (we know there's at least 1 character in the match string, and; the first is not a wildcard;firstToLast	ldx	#0@loop		inx		lda	[<matchPtr],y		cmp	#'*'			;if wildcard, then all other match		beq	@matched		;following chars, if any, match wildcard		cpx	filenameChars		;done with name?		blt	@checkTarget		;if no, go ahead with comparison scan		bne	@noMatch		;if yes, no match because template longer@checkTarget	jsr upcaseA8	;2-Apr-92 DAL;		cmp	#'a';		bcc	@alreadyUpper;		cmp	#'z'+1			; is it a lower-case letter?;		bcs	@alreadyUpper;		sec;		sbc	#$20			; yes, convert it to upper case;@alreadyUpper		pha		phy		txy		lda	[<filenamePtr],y;		cmp	#'a';		bcc	@alreadyUpper2;		cmp	#'z'+1			; is it a lower-case letter?;		bcs	@alreadyUpper2;		sec;		sbc	#$20			; yes, convert it to upper case		jsr upcaseA8	;2-Apr-92 DAL;@alreadyUpper2		sta	char		ply		pla				;target char same as template char?		cmp	char		bne	@noMatch		;if no, no match		tya		cmp	[<matchPtr]		;done with template?		beq	@doneWithMatch		iny		bra	@loop@doneWithMatch	cpx	filenameChars		;done with name also?		beq	@matched@noMatch	rep	#$30		LONGA	ON		LONGI	ON		clc		rts@matched	rep	#$30		LONGA	ON		LONGI	ON		lda	[<matchPtr]		and	#$00ff		inc	a		sec		rts;; match last to first (we know that the match string contains at least one character; and that the first (perhaps only) character in it is a wildcard;		longa off		longi offlastToFirst	ldx	filenameChars		lda	[<matchPtr]		tay@loop		lda	[<matchPtr],y		cmp	#'*'			;if wildcard then the rest matches		beq	@matched		pha		phy		txy		lda	[<filenamePtr],y;		cmp	#'a';		bcc	@alreadyUpper;		cmp	#'z'+1			; is it a lower-case letter?;		bcs	@alreadyUpper;		sec;		sbc	#$20			; yes, convert it to upper case		jsr upcaseA8	;2-Apr-92 DAL;@alreadyUpper		ply		sta	char		pla		jsr upcaseA8	;2-Apr-92 DAL		cmp	char		bne	@noMatch		dey		dex;;;		bne	@loop		bpl	@loop		;9-Apr-92 DAL -- Leading wildcard matches zero or more chars@noMatch	rep	#$30		longa on		longi on		clc		rts@matched	rep	#$30		longa on		longi on		lda	[<matchPtr]		and	#$00ff		inc	a		sec		rts*** added 2-Apr-92 DAL		longa offupcaseA8	cmp #'a'		bcc @alreadyUpper		cmp #'z'+1		bcs @alreadyUpper		and #$df@alreadyUpper	rts		longa on*** end 2-Apr-92;; lookCreateDateTime -- see if there's a matchCreateDateTime structure, and if there is,;		        see if our filetype matches;lookCreateDateTime		lda	[<matchPtr]		cmp	#matchCreateDateTimeID	;0x4		beq	@look		clc		rts@look		ldy	#6			;move the value we're comparing		ldx	#6@sLoop		lda	[<CreateDatePtr],y	;against		sta	<CompareValue,x		dey		dey		dex		dex		bpl	@sLoop		jsr	setupCompare		jsr	doCompare		lda	#12		rts;; lookModDateTime -- see if there's a matchModDateTime structure, and if there is, see;		     if our modDateTime matches;lookModDateTime		lda	[<matchPtr]		cmp	#matchModDateTimeID	;0x5		beq	@look		clc		rts@look		ldy	#6			;move the value we're comparing		ldx	#6@sLoop		lda	[<ModDatePtr],y		;against		sta	<CompareValue,x		dey		dey		dex		dex		bpl	@sLoop		jsr	setupCompare		jsr	doCompare		lda	#12		rts;; lookLocalAccess -- see if there's a matchAccess structure, and if there is, see if;		     our access matches;lookLocalAccess		lda	[<matchPtr]		cmp	#matchLocalAccessID	;0x6		beq	@look		clc		rts@look		lda	<localAccess		;mask the access word off		ldy	#2		and	[<matchPtr],y		ldy	#4		cmp	[<matchPtr],y		;then do the comparison		beq	@matched		clc		rts@matched	lda	#6		sec		rts;; lookNetworkAccess -- see if there's a matchAccess structure, and if there is, see if;		     our access matches;lookNetworkAccess		lda	[<matchPtr]		cmp	#matchNetworkAccessID	;0x7		beq	@look		clc		rts@look		lda	<ffiletype		;our file has to be a folder in order		cmp	#$0f			;for this to work		beq	@isFolder		cmp	#$fff5			;or a server		bne	@noMatch@isFolder	lda	<OptionListPtr+1		beq	@noMatch				ldy	#2			;our file also has to have come from		lda	[<optionListPtr],y	;AppleShare		cmp	#$0d		bne	@noMatch		ldy	#$28			;$28 offset into the option list		lda	[<optionListPtr],y	;mask the access word off		ldy	#2		and	[<matchPtr],y		ldy	#6		cmp	[<matchPtr],y		;then do the comparison		bne	@noMatch		ldy	#$2A		lda	[<optionListPtr],y	;mask the access word off		ldy	#4		and	[<matchPtr],y		ldy	#8		cmp	[<matchPtr],y		beq	@matched@noMatch	clc		rts@matched	lda	#10		sec		rts;; lookExtended -- see if there's a matchExtended structure, and if there is, see;		     if our StorageType matches;lookExtended		lda	[<matchPtr]		cmp	#matchExtendedID	;0x8		beq	@look		clc		rts@look		lda	<ExtendedType		ldy	#2		and	[<matchPtr],y		iny		iny		cmp	[<matchPtr],y		bne	@matched		clc		rts@matched	lda	#6		sec		rts;; lookHFSFiletype -- see if there's a matchHFSFiletype structure, and if there is, see;		     if our filetype matches;lookHFSFiletype		lda	#4		sta	filetypeOffset		lda	[<matchPtr]		cmp	#matchHFSFiletypeID	;0x9		beq	lookHFS		clc		rts;; lookHFSCreator -- see if there's a matchHFSCreator structure, and if there is, see if;		    our filetype matches;lookHFSCreator		lda	#8		sta	filetypeOffset		lda	[<matchPtr]		cmp	#matchHFSCreatorID	;0xA		beq	lookHFS		clc		rtslookHFS		lda	<ffiletype		;if they are a folder, there's no		cmp	#$0F			;way we can match because the info		beq	@noMatch		;we need isn't there...		cmp	#$fff5		beq	@noMatch		;same for a server		lda	<OptionListPtr+1		beq	@noMatch				lda	[<optionListPtr]		cmp	#10			;gotta at least have the filetype		blt	@noMatch		;and creator fields		ldy	#2		lda	[<OptionListPtr],y		cmp	#1		beq	@try		cmp	#6		beq	@try		cmp	#$0d		bne	@noMatch@try		ldy	#2		lda	[<matchPtr],y		ldy 	filetypeOffset		cmp	[<optionListPtr],y		bne	@noMatch		ldy	#4		lda	[<matchPtr],y		ldy	filetypeOffset		iny		iny		cmp	[<optionListPtr],y		beq	@matched@noMatch	clc		rts@matched	lda	#6		sec		rts;; lookOptionList -- see if there's a matchOptionList structure, and if there is, see if;		    our filetype matches;; incidently, the 'offset into the optionlist' is the offset from reqSize, the word; before the FST id;lookOptionList		lda	<OptionListPtr+1		beq	@noOptionList				lda	[<matchPtr]		cmp	#matchOptionListID	;0xB		beq	@look@noOptionList	clc		rts@look		lda	[<optionListPtr]		cmp	#2		bge	@haveList		clc		rts@haveList	sec		sbc	#2		sta	sizeOfOptionList	;make sure we have enough so that						;we don't compare against garbage		ldy	#2		lda	[<matchPtr],y		sta	fstGroupOptions		lda	<matchPtr		clc		adc	#2		sta	<matchPtr		bcc	@nr		inc	<matchPtr+2@nr		stz	currentGroupOption;; now, look through all the FSTGroupOptions one at a time (while we also check each FST; specified for each GroupOption).  This little nightmare courtesy of Dave A. Lyons;@nextGroupOption		lda	[<matchPtr]		asl	a		tay@loop		lda	[<matchPtr],y		tyx		ldy	#2			;check FileSysID		cmp	[<optionListPtr],y		beq	@gotFileSystem		txy		dey		dey		bne	@loop		inc	currentGroupOption		lda	currentGroupOption		cmp	fstGroupOptions		blt	@nextGroup		clc		rts@nextGroup	lda	[<matchPtr]		asl	a		clc		adc	#14		clc		adc	<matchPtr		sta	<matchPtr		bra	@nextGroupOption@gotFileSystem	lda	[<matchPtr]		;get all the values ahead of time so		inc	a			;that we don't have to save and restore		asl	a			;a whole bunch of indices		tay		lda	[<matchPtr],y		sta	optionOffset		iny		iny		lda	[<matchPtr],y		sta	optionMask		iny		iny		lda	[<matchPtr],y		sta	optionMask+2		iny		iny		lda	[<matchPtr],y		sta	SourceValue		iny		iny		lda	[<matchPtr],y		sta	SourceValue+2		iny		iny		lda	[<matchPtr],y		sta	compare		ldy	optionOffset		;apply the mask		cpy	sizeOfOptionList		beq	@thisGroup		bge	@nextGroup@thisGroup	lda	[<OptionListPtr],y		and	optionMask		sta	CompareValue		iny		iny		lda	[<OptionListPtr],y		and	optionMask+2		sta	CompareValue+2		jsr	doCompare		bcc	@nextGroup		lda	#14		rts;; lookEOF -- see if there's a matchEOF structure, and if there is, see if it matches the one we're;	     comparing things against;lookEOF				lda	[<matchPtr]		cmp	#matchEOFID		;0xC		beq	@look		clc		rts@look		lda	<DataForkEOF		;setup the value to compare against		sta	<CompareValue		lda	<DataForkEOF+2		sta	<CompareValue+2				stz	<CompareValue+4		stz	<CompareValue+6		ldy	#2			;setup the state of the comparison		lda	[<matchPtr],y		sta	compare		iny		iny		lda	[<matchPtr],y		sta	<sourceValue		iny		iny		lda	[<matchPtr],y		sta	<sourceValue+2		stz	<sourceValue+4		stz	<sourceValue+6		jsr	doCompare		lda	#8		rts;; setupCompare -- setup the comparison for the time routines;setupCompare		ldy	#2			;setup the state of the comparison		lda	[<matchPtr],y		sta	compare		ldy	#4+6			;move the value we're comparing from;;;		ldx	#4+6			;24-Mar-93 JCM - whoagus (thought-provokingly bogus)		ldx	#6			;24-Mar-93 JCM - copy the right number of bytes@loop		lda	[<matchPtr],y*** Maximally bogus - 24-Mar-93 JCM - This used to copy 10 bytes (instead of 8) to a fundamentally***				      wrong location. Since <SourceValue is at the beginning of our***				      DP, the "-4" caused us to store at $FD,x, which overwrote unknown***				      values way up the caller's stack. This caused matchCreateDateTime***				      and matchModeDateTime to fail unless you were _extremely_ lucky.;;;		sta	<SourceValue-4,x		sta	<SourceValue,x		;stick the date/time in the right place*** End - 24-Mar-93 JCM		dey		dey		dex		dex		bpl	@loop		rts;; Compare 'SourceValue' with 'CompareValue' based on the CompareSpec in 'compare';doCompare	lda	compare			;mask off the proper bytes for this		and	#$000F			;comparison		asl	a		asl	a		tax		lda	<CompareValue		and	masks,x		sta	<CompareValue		lda	<CompareValue+2		and	masks+2,x		sta	<CompareValue+2		lda	compare			;mask off the proper bytes for this		and	#$00F0			;comparison		lsr	a		lsr	a			;quick multiply by 4 of this nybble		tax		lda	<CompareValue+4		and	masks,x		sta	<CompareValue+4		lda	<CompareValue+6		and	masks+2,x		sta	<CompareValue+6		lda	compare			;dispatch to the correct comparison		xba		and	#$0003		asl	a		tax		jsr	(@comparisons,x)		lda	compare			;see if the 'invert comparison' bit is on		and	#$0400		beq	@dontInvert		bcs	@noMatch		sec		rts@noMatch	clc@dontInvert	rts@lessThan	ldx	#6@ltLoop		lda	<SourceValue,x		cmp	<CompareValue,x		bne	@ltNotEqual		dex		dex		bpl	@ltLoop		sec		rts@ltNotEqual	sec				;is the long in the source time		lda	<SourceValue		;less than or equal to ours?		sbc	<CompareValue		lda	<SourceValue+2		sbc	<CompareValue+2		lda	<SourceValue+4		sbc	<CompareValue+4		lda	<SourceValue+6		sbc	<CompareValue+6		bcc	@noMatch		;borrow not required		sec				;no borrow required, so optValue =< value		rts@equalTo	ldx	#6			;is the long in the source time equal@eqLoop		lda	<SourceValue,x		;to ours?		cmp	<CompareValue,x		bne	@noMatch		dex		dex		bpl	@eqLoop		sec		rts@greaterThan	sec				;is the long in the source time		lda	<SourceValue		;less than or equal to ours?		sbc	<CompareValue		lda	<SourceValue+2		sbc	<CompareValue+2		lda	<SourceValue+4		sbc	<CompareValue+4		lda	<SourceValue+6		sbc	<CompareValue+6		bcs	@noMatch		;no borrow required		sec				;optValue > value, borrow required		rts@comparisons	dc.w	@lessThan		dc.w	@equalTo		dc.w	@greaterThan		dc.w	@noMatch;; locals;filetypeOffset	dc.w	0filenameChars	dc.w	0char		dc.w	0masks		dc.L	$00000000	;0		dc.L	$000000FF	;1		dc.L	$0000FF00	;2		dc.L	$0000FFFF	;3		dc.L	$00FF0000	;4		dc.L	$00FF00FF	;5		dc.L	$00FFFF00	;6		dc.L	$00FFFFFF	;7		dc.L	$FF000000	;8		dc.L	$FF0000FF	;9		dc.L	$FF00FF00	;10		dc.L	$FF00FFFF	;11		dc.L	$FFFF0000	;12		dc.L	$FFFF00FF	;13		dc.L	$FFFFFF00	;14		dc.L	$FFFFFFFF	;15value		dc.L	0compare		dc.w	0optionValue	dc.L	0optionMask	dc.L	0optionOffset	dc.w	0sizeOfOptionList dc.w	0fstGroupOptions dc.w	0currentGroupOption dc.w	0matched		dc.w	0			;boolean, did we match?addr		dc.w	lookFiletype		dc.w	lookAuxtype		dc.w	lookFilename		dc.w	lookCreateDateTime		dc.w	lookModDateTime		dc.w	lookLocalAccess		dc.w	lookNetworkAccess		dc.w	lookExtended		dc.w	lookHFSFileType		dc.w	lookHFSCreator		dc.w	lookOptionList		dc.w	lookEOF				ENDP; QueryDatabase;; Given a pointer to an rVersion string which is in a memory block which is; locked, this routine checks the list of Applications in the Finder's rFinderPath; list, finding out whether the Finder knows about that app or not.;; Each entry in the rFinderPath list looks like this:;; 	rFinderPathHandle	long	+0; 	rFinderPathID		long	+4; 	rBundleHandle		long	+8; 	OneDocOffset		long	+12; 	rVersionHandle		long	+16; 	rVersionID		long	+20; 	volumeHandle		long	+24;; If an entry is updated, the 'Desktop' file in the 'Icons' folder on the volume found; in the volume handle is used (if possible).  Also, any rBundles which are out-of-date; are removed from their respective volumes if possible.;;   IN: |  word  |	space	;	|  word  |	space;	|  word  |	match how, bit 15 allows removing outdated rBundle or updating the rFinderPath for an exact match;	|  long  |	ptr to pathname to use for update or NIL if no update (new path for rFinderPath resource);	|  long  |	ptr to rVersion resource to compare against (must be locked);	---------- <-SP;;  OUT:	|  word  |	boolean, 0 if no match found, $FFFF if exact match found, $8000 if newer rVersion found;	|  word  |	0 if no error, non-zero if error;	---------- <-SP;; USES: c1_filename;	c1_path;.....................................................................QueryDatabase	PROCNAME EXPORT		IMPORT	rFPListHandle		IMPORT	rFPCount		IMPORT	WStringCopy		IMPORT	PathAddName		IMPORT	WStrCompare		IMPORT	c1_path		IMPORT	DesktopName		IMPORT	IconsName			DefineStackrBundleID	longrBundlePtr	longrBundleHandle	longoldDepth	wordvolumePtr	longvolumeHandle	longnextCount	wordnextPtr		longfileID		wordrFPathID	longrFPathHandle	longrFPathPtr	longvPtr		longvHandle		longcount		wordlistPtr		longlistHandle	longretAddr		block	3rVersionPtr	long			pathnamePtr	long			matchHow	worderror		word			matchFound	word			inParms		SET	10locParms	SET	60		tsc		sec		sbc	#locParms		;allocate extra DP space for local DP		tcs		phb				;preserve data bank		phd		tcd				;set DP to stack		phk		plb;; first, dereference and lock the rFPListHandle;		stz	<error			;say no error		stz	<matchFound		;say no match found				lda	rFPListHandle		sta	<listHandle		lda	rFPListHandle+2		sta	<listHandle+2				lda	[<listHandle]		tax		ldy	#2		lda	[<listHandle],y		sta	<listPtr+2		stx	<listPtr				ldy	#4		lda	[<listHandle],y		ora	#$8000		sta	[<listHandle],y				stz	<count*** opt 7-Jul-92 DAL -- We already did this above;;;		stz	<matchFound		;say we didn't find anything by default		lda	rFPCount		;if there aren't any entries, just		bne	@loop			;say we're done		brl	@done		;; now, from entry zero in the list, look at all the rVersions in each record all the; way up to rFPCount;@loop				ldy	#16			;the handle of the rVersion resource		lda	[<listPtr],y		;is at offset +16 in the record		sta	<vHandle		iny		iny		lda	[<listPtr],y		sta	<vHandle+2				lda	[<vHandle]		;deref the handle		tax		ldy	#2		lda	[<vHandle],y		sta	vPtr+2		stx	vPtr		lda	#0			;clear both A and B sides of accumulator				SEP	#$20		LONGA	OFF				ldy	#6			;first, see if the pstring lengths are		lda	[<rVersionPtr],y	;the same		cmp	[<vPtr],y		bne	@goNextRecord				tax		@compare	iny		lda	[<rVersionPtr],y		cmp	[<vPtr],y		beq	@nextc@goNextRecord	brl	@nextRecord		@nextc		dex		bne	@compare				REP	#$20		LONGA	ON;; Now, check to see if the version of this thing in the in-memory database is the same or; less than the one we're checking it against;; A quick explanation of the way this is supposed to work: ;; (1) If the database's rVersion is less than our rVersion, then we need to remove the database's rBundle.;; (2) If the database's rVersion is greater than our rVersion, then we need to keep going, but mark matchFound;  	as having found a newer version than the thing we were looking for.;; (3) If the database's rVersion is equal to our rVersion, then we need to say we found an exact match and we;  	need to update the rFinderPath if possible.;		ldy	#2		lda	[<vPtr],y		;is the one we're looking at >= the one in the		cmp	[<rVersionPtr],y	;database?  If so, then it matched		beq	@2			;if they're ==, check the prototype stuff		bge	@MarkAsNewer		bra	@markOutOfDate@2		lda	[<vPtr]			;if the numbers are equal, but the develop number		cmp	[<rVersionPtr]		;is less, then we don't have a match		beq	@matchFound		bge	@MarkAsNewer		@markOutOfDate	lda	<matchHow		bpl	@noRemove				jsr	RemoveOutOfDate@noRemove	brl	@nextRecord;; MarkAsNewer -- mark 'matchHow' with $8000 to indicate that we found a newer version of the rVersion;		 in the database.;@MarkAsNewer	lda	#$8000		sta	<matchFound		brl	@nextRecord		;; we found we have a match for the rVersion, so depending on what 'matchHow' says,; we'll either update their rFinderPath, return and say we found the match;@matchFound	lda	#$FFFF			;say we found a match for the rVersion we were		sta	<matchFound		;looking for		lda	<matchHow		bmi	@update			brl	@done;; we found we have a match for the rVersion, so see if their rFinderPath matches the path that; we're about to use or launch.  if the path matches, then we don't need to do an update.  if the; pathname doesn't match, then we'll have to do an update (arghhh...) if they ask for it.;		@update		lda	[<listPtr]		sta	<rFPathHandle		ldy	#2		lda	[<listPtr],y		sta	<rFPathHandle+2				lda	[<rFPathHandle]		tax		lda	[<rFPathHandle],y	;y is already 2		sta	<rFPathPtr+2		stx	<rFPathPtr				pha		lda	[<rFPathPtr],y		;y is already 2		clc		adc	<rFPathPtr		;get the offset of the actual pathname in the		tax				;rFinderPath		lda	<rFPathPtr+2		adc	#0		pha		phx		pushZlong <pathnamePtr		;are the pathnames already the same?		jsl	WStrCompare		pla		beq	@needsUpdate		;if not, then update the rFinderPath		brl	@nextRecord@needsUpdate			lda	[<listPtr]		sta	<rFPathHandle		ldy	#2		lda	[<listPtr],y		sta	<rFPathHandle+2				ldy	#4		lda	[<rFPathHandle],y	;unlock and unfix the handle		and	#$3FFF		sta	[<rFPathHandle],y				pea	0				lda	[<pathnamePtr]		clc		adc	#16			;14 for the version, offset, and pcount,+2 for wstr		pha		pushZLong <rFPathHandle		_SetHandleSize		bcc	@resizeOK		brl	@nextRecord@resizeOK				lda	[<rFPathHandle]		tax		ldy	#2		lda	[<rFPathHandle],y		sta	<rFPathPtr+2		stx	<rFPathPtr				lda	#0			;rFinderPath's version		sta	[<rFPathPtr]		ldy	#4			;rFinderPath's pcount (1)		lda	#1		sta	[<rFPathPtr],y		ldy	#20		lda	[<listPtr],y		ldy	#6			;move the rVersion ID from list to rFinderPath		sta	[<rFPathPtr],y				ldy	#22		lda	[<listPtr],y		ldy	#8		sta	[<rFPathPtr],y				ldy	#2			;rFinderPath offset to pathname		lda	#6		sta	[<ptr3],y				pushZLong <pathnamePtr		lda	<rFPathPtr		clc		adc	#14		ldx	<rFPathPtr+2		bcc	@nr2		inx@nr2		phx		pha		jsl	WStringCopy		ldy	#24		lda	[<listPtr],y		sta	<volumeHandle		iny		iny		lda	[<listPtr],y		sta	<volumeHandle+2		ora	<volumeHandle		bne	@haveVolume		brl	@nextRecord		@haveVolume	jsr	OpenVolumeForWrite		bcs	@addError; @@@ 7-Jul-92 DAL.  The error handling here looks bogus to me.  Won't we use a random fileID for updateDesktop???				pha		pea	1		_SetResourceFileDepth		pla		sta	<oldDepth				ldy	#4		lda	[<listPtr],y		sta	<rFPathID		iny		iny		lda	[<listPtr],y		sta	<rFPathID+2				pea	$802c			;kill the old reference to		pushZLong <rFPathID		;the rFinderPath		_RemoveResource		bcc	@removedOK		bra	@addError		@removedOK	pushZLong <rFPathHandle		;our rFinderPath's handle				pea	$0040			;Preload!		pea	$802C		pushZLong <rFPathID		_AddResource		bcc	@addedOK@addError	sta	<error		jsr	updateDesktop		;updateDesktop falls into detachRFPath				pushZLong <rFPathHandle		jsl DisposeHandleGlue		bra	@done@addedOK	jsr	updateDesktop		;; look at the next record in the rFinderPathList;@nextRecord	REP	#$20		LONGA	ON		inc	<count				lda	<count		cmp	rFPCount		bge	@done				lda	<listPtr		clc		adc	#32		sta	<listPtr		bcc	@nr		inc	<listPtr+2@nr		brl	@loop	;; we be chillin', we're finished;@done				ldy	#4			;unlock the rFinderPathlist		lda	[<listHandle],y		and	#$7FFF		sta	[<listHandle],y		pld		plb		lda	retAddr+1,s		;clean up stack		sta	retAddr+inParms+1,s		lda	retAddr,s		sta	retAddr+inParms,s		tsc		clc		adc	#inParms+locParms		tcs		rtl;; updateDesktop -- update the resource file we've got open;updateDesktop		pei	<fileID		_UpdateResourceFile		pea	$802C			;rFinderPath		pushZLong <rFPathID		;rFinderPathID		_DetachResource						lda	<fileID		ora	#$8000		pha		_CloseResourceFile				pha		pei	<oldDepth		_SetResourceFileDepth		pla		rts		;; RemoveOutOfDate -- remove the out of date rBundle resource from the volume in this record;RemoveOutOfDate		ldy	#24		lda	[<listPtr],y		sta	<volumeHandle		iny		iny		lda	[<listPtr],y		sta	<volumeHandle+2		ora	<volumeHandle		bne	@haveVolume		rts		@haveVolume	ldy	#8			;get the rBundle's handle		lda	[<listPtr],y		sta	<rBundleHandle		iny		iny		lda	[<listPtr],y		sta	<rBundleHandle+2		ora	<rBundleHandle		beq	@done			;be paranoid				lda	[<rBundleHandle]			sta	<rBundlePtr		ldy	#2		lda	[<rBundleHandle],y		sta	<rBundlePtr+2				ldy	#8		lda	[<rBundlePtr],y		sta	<rBundleID		iny		iny		lda	[<rBundlePtr],y		sta	<rBundleID+2		ora	<rBundleID		beq	@done			;be really paranoid		jsr	OpenVolumeForWrite		bcs	@done		pha		pea	1		_SetResourceFileDepth		pla		sta	<oldDepth								pea	$802B			;rBundle		pushZLong <rBundleID				_RemoveResource		lda	<fileID			;close it the hell anyway, regardless		ora	#$8000		pha		_CloseResourceFile				pha		pei	<oldDepth		_SetResourceFileDepth		pla@done		rts;; OpenVolumeForWrite -- open the Desktop file in the volume in volumeHandle for writing;; IN: VolumeHandle contains the handle of the volume whose desktop file we want write access to;; OUT: <fileID contains the resource file id;      Carry set if error opening, error in (A);OpenVolumeForWrite		lda	[<volumeHandle]		;get the volume name		tax		ldy	#2		lda	[<volumeHandle],y		sta	<volumePtr+2		stx	<volumePtr		pushZLong <volumePtr		pushlong #c1_path		jsl	WStringCopy				pushlong #IconsName		;add 'Icons' to it		pushlong #c1_path		jsl	PathAddName				pushlong #DesktopName		;add 'Desktop' to it		pushlong #c1_path		jsl	PathAddName				pha		pea	$8003			;we NEED write access, gotta have write access+no preload		pushlong #0		pushLong #c1_path		_OpenResourceFile		plx		bcs	@done		stx	<fileID@done		rts				ENDP		; AddBundle2Desktop;; Given a pointer to a c1_pathname, open that path, look for 1 and only 1 rBundle, copy the; contents of the rBundle either to the 'DESKTOP' file of the volume this file came from, or; to the 'DESKTOP' file on the boot volume.  If the desktop file doesn't exist, it is created if; possible.;; NOTE: We'll trust that the user isn't trying to update a network volume's database (which don't;       get loaded anyway.;; NOTE: This routine explicitly forbids adding any version of the Finder's resources to the;	'Desktop' database via looking at the rVersion(1) resource and seeing if it says;	'Finder' and if so, issues error $4206, fErrNotPrudent (all the references to;	rFinderPaths in the Finder's resource fork would be changed to point to the Finder;	that's being launched, causing things like Teach files to become linked to the Finder.;; NOTE: The source file is opened read-only.;; NOTE: Any segments in the pathname to the desktop file which don't exist are created.;;   IN: |  word  |   	space;	|  word	 |	flag, high bit = update if exists;	|  long  |	rBundle ID to put into desktop database, or zero for first ID;	|  long	 |	ptr to pathname for desktop file to add rBundle;	|  long  |	ptr to pathname to examine;	---------- <-SP;;  OUT: |  word  |	result, non-zero if error;	---------- <-SP;; USES: c1_devicename;.....................................................................AddBundle2Desktop PROCNAME EXPORT		IMPORT	C1_DeviceName		IMPORT	C1_Filename		IMPORT	strgReading		IMPORT	strgWritingTo		IMPORT	GetDeviceStatus		IMPORT	GetDeviceNumber		IMPORT	PathGetRoot		IMPORT	PathGetName		IMPORT	WStringCopy		IMPORT	NewHandle		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		IMPORT	c1_temppath		;2-Apr-93 JCM*** Added - 2-Apr-93 JCM - These are really defined in finder.equ, but there are a bunch of***			   conflicts from this file to things defined in there.MaxFileName	equ	31MaxPathLen	equ	1022-MaxFileName*** End - 2-Apr-93 JCM		DefineStackLastIconID	longLastIconHandle	longLastSmallIconID longLastLargeIconID longLastSmallIconHandle longLastLargeIconHandle longdesktopPathLen	wordthermo		wordourPort		longuniqueID	longiconOffset	wordrIconHandle	longrIconID		longrVersionID	longrVersionPtr	longrVersionHandle	longrFinderPathID	longrFinderPathPtr	longrFinderPathHandle longOneDocCount	wordOneDocPtr	longDocListPtr	longrBundlePtr	longrBundleHandle	longdesktopFileID	word			sourceFileID	wordretAddr		block 3			pathnamePtr	long			desktopPathPtr	long			rBundleID	longupdateFlag	worderror		word	inParms		SET	14		locParms	SET	92				tsc		sec		sbc	#locParms		;allocate extra DP space for local DP		tcs		phb				;preserve data bank		phd		tcd				;set DP to stack		phk		plb		stz	<error			;no errors unless we say so		stz	addBundleWindowPtr+1	;flag we have no window to close (unless we do);; first, before anything else, open the file as read-only;		pha			pea	$8001			;open how (no preload, read-only)					pushlong #0			;res map addr (NIL)		pushZLong <pathnamePtr		_OpenResourceFile		plx		stx	<sourceFileID		bcc	@loadRBundle		sta	<error		brl	@done;; now, load the specified rBundle by maybe searching for it;@loadRBundle		pha		_GetCurResourceFile		pla		sta	finderFileID		pha		pea	1		_SetResourceFileDepth		pla		sta	oldDepth				lda	<rBundleID		ora	<rBundleID+2		bne	@noSearchForID		pha		pha		pea	$802B			;rBundle;;;		pushlong #0			;get the first rBundle		pushlong #1			;get first rBundle (was 0, 26-May-92 DAL)		_GetIndResource		plx		stx	<rBundleID		plx		stx	<rBundleID+2		bcc	@noSearchForID		;if there aren't any, then time's up		brl	@sourceClose				@noSearchForID		pha		pea	$802B			;rBundle		pushZLong <rBundleID		_GetResourceAttr		;see if resource exists from map, not disk		plx						bcc	@grabRVersion		brl	@sourceClose;; try to load the rVersion(1) resource -- we'll need it for all sorts of stuff;@grabRVersion		pha		pha		pea	$8029			;rVersion		pushlong #1		_LoadResource		pulllong <rVersionHandle		bcc	@gotRVersion		jsr	forceSource		;say we don't have an rVersion (morons, ugh)		brl	@resetDepth@gotRVersion		lda	[<rVersionHandle]	;deref the handle to see if the file we're		tax				;looking through is		ldy	#2		lda	[<rVersionHandle],y		sta	<rVersionPtr+2		stx	<rVersionPtr		ldy	#6				lda	[<rVersionPtr],y		cmp	#$4606			;length byte, capital 'F'		bne	@notFinder				iny		lda	[<rVersionPtr],y		cmp	#$6946			;capital 'F', lowercase 'i'		bne	@notFinder				iny		iny		lda	[<rVersionPtr],y		cmp	#$646e			;lowercase 'n', lowercase 'd'		bne	@notFinder				iny		iny		lda	[<rVersionPtr],y		cmp	#$7265			;lowercase 'e', lowercase 'r'		bne	@notFinder				lda	#fErrNotPrudent		brl	@sourceClose		;@@@ UNCOMMENT THIS@notFinder	pea	$8029			;rVersion		pushlong #1		_DetachResource;; check the in-memory database against the file we're launching;		lda	<updateFlag		bpl	@openDestLoop		pha		pha		pea	$8000			;if match found, do update		pushZLong <pathnamePtr		pushZLong <rVersionPtr		jsl	QueryDatabase		pla				;error		plx				;matchFound (boolean)		beq	@openDestloop		;if no match is found, update the database				jsr	forceSource		;match found, update done (we hope)		brl	@resetDepth		;; now, open the desktop file we're going to be putting this stuff in;@openDestLoop	pushlong #c1_deviceName		pushZLong <desktopPathPtr		jsl	PathGetRoot				pha		pushlong #c1_deviceName		jsl	GetDeviceNumber		;result on stack		plx		bcs	@destOpenErr		;if there's no volume around with this name, exit				phx		phx				;same here, if there's no volume around, exit		jsl	GetDeviceStatus			plx		bcs	@destOpenErr					txa		and	#$0003			;is it write-protected or read-only?		beq	@openDest				lda	#$002b			;fake a write-protected error		brl	@sourceClose@openDest	pha		pea	$8000			;as allowed, don't preload anything!		pushlong #0			;res map addr (NIL)		pushZLong <desktopPathPtr		_OpenResourceFile		plx		stx	<desktopFileID		bcc	@stealRVersion		cmp	#$44		beq	@createPaths		cmp	#$46			;if it's not found, and since there's a device 		bne	@destOpenErr		;which we can write to around, try to create it...		@createDest	pushlong #3			;auxtype		pea	$c9			;filetype		pea	$c3			;access		pushZLong <desktopPathPtr		_CreateResourceFile		bcc	@openDest		@destOpenErr	brl	@sourceClose;; yuk. try to create all the segments in the pathname or exit ;@createPaths	lda	<desktopPathPtr		sta	CreateParms+2		lda	<desktopPathPtr+2		sta	CreateParms+2+2					lda	[<desktopPathPtr]		sta	<desktopPathLen		ldy	#1@cLoop		iny@createLoop	iny		lda	[<desktopPathPtr],y		and	#$00ff		cmp	#':'		beq	@createSegment			dey		cpy	<desktopPathLen		blt	@cLoop		lda	<desktopPathLen		sta	[<desktopPathPtr]		bra	@createDest@createSegment	dey		dey		tya		sta	[<desktopPathPtr]				_CreateGS CreateParms		bcs	@createError		@nextSegment	lda	[<desktopPathPtr]		inc	a		inc	a		tay		bra	@createLoop@createError	cmp	#$47		beq	@nextSegment		cmp	#$40		beq	@nextSegment				lda	<desktopPathLen		sta	[<desktopPathPtr]		lda	#$44		brl	@sourceClose		;; now, load the rVersion(1) resource out of the source file, but check to see if it's the Finder; we're trying to launch, 'cause if it is, we just wanna get out of here quickly...;@stealRVersion		pha		pha		pea	$0002			;anything in $0002xxx, but definitely not 0x00000001		pea	$8029		_UniqueResourceID		plx		stx	<rVersionID		plx		stx	<rVersionID+2		bcc	@hasUniqueRVersion		brl	@errorClose		@hasUniqueRVersion		pushZLong <rVersionHandle		pea	$0040			;preload		pea	$8029		pushZLong <rVersionID		_AddResource		bcc	@lookRBundle		brl	@errorClose;; lookRBundle -- go load the RBundle and have our way with it;@lookRBundle		jsr	setSourceFile				pha				;load the rBundle again		pha		pea	$802B			;rBundle		pushZLong <rBundleID		_LoadResource		plx		stx	<rBundleHandle		plx		stx	<rBundleHandle+2		bcc	@lookRBundleAgain				sta	<error		brl	@errorClose@lookRBundleAgain		ldy	#4			;lock it		lda	[<rBundleHandle],y		ora	#$8000		sta	[<rBundleHandle],y				lda	[<rBundleHandle]	;dereference the handle		tax		ldy	#2		lda	[<rBundleHandle],y		sta	<rBundlePtr+2		stx	<rBundlePtr		lda	[<rBundlePtr]		beq	@buildRFinderPath				lda	#fErrBadBundle		brl	@errorClose;; now, add a built rFinderPath (one, and only one rFinderPath please Vasili) to the Desktop;; Finder Trivia: because only 1 rFinderPath will get added for multiple things to match against,; when the Finder updates that single rFinderPath, all the paths from multiple icons; get simultaneously updated.;@buildRFinderPath		pha		pha		lda	[<pathnamePtr]		clc		adc	#16			;14 for the version, offset, and pcount,+2 for wstr		pha		jsl	NewHandle		;offset, and enough for a bunch of		plx		stx	<rFinderPathHandle		plx		stx	<rFinderPathHandle+2		bcc	@newRFPOK		brl	@errorClose@newRFPOK;		ldy	#4			;actually, we don't care if this moves once we;		lda	[<rFinderPathHandle]	;move the important stuff into it;		ora	#$8000;		sta	[<rFinderPathHandle]				lda	[<rFinderPathHandle]		tax		ldy	#2		lda	[<rFinderPathHandle],y		sta	<rFinderPathPtr+2		stx	<rFinderPathPtr				lda	#0			;rFinderPath's version		sta	[<rFinderPathPtr]				ldy	#2			;rFinderPath offset to pathname		lda	#14		sta	[<rFinderPathPtr],y		ldy	#4			;rFinderPath's pcount (1)		lda	#1		sta	[<rFinderPathPtr],y				ldy	#6			;rFinderPath's rVersion		lda	<rVersionID		sta	[<rFinderPathPtr],y		iny		iny		lda	<rVersionID+2		sta	[<rFinderPathPtr],y				iny				;space for the rVersion handle		iny		lda	#0		sta	[<rFinderPathPtr],y		iny		iny		sta	[<rFinderPathPtr],y				pushZLong <pathnamePtr		lda	<rFinderPathPtr		clc		adc	#14		ldx	<rFinderPathPtr+2		bcc	@nr2		inx@nr2		phx		pha		jsl	WStringCopy		jsr	setDesktopFile		pha		pha		pea	$0002			;anything in $0002xxx, but definitely not 0x1		pea	$802C		_UniqueResourceID		plx		stx	<rFinderPathID		plx		stx	<rFinderPathID+2		bcs	@noUniqueRFPath				pushZLong <rFinderPathHandle	;our rFinderPath's handle				pea	$0040			;Preload!		pea	$802C		pushZlong <rFinderPathID		_AddResource		bcc	@walkRBundle	@noUniqueRFPath	pha		pushlong <rFinderPathHandle		jsl DisposeHandleGlue		pla		brl	@errorClose	;; if we get this far, life is good.  We have a resource fork, definite desktop file, we've created; an rFinderPath for this application, and stolen its rVersion(1) resource, and we have an; rBundle to walk through;@walkRBundle		ldy	#2			;make the pointer to the DocList		lda	[<rBundlePtr],y		clc		adc	<rBundlePtr		sta	<DocListPtr		lda	<rBundlePtr+2		adc	#0		sta	<DocListPtr+2		lda	<DocListPtr		;make the pointer to the first OneDoc struct		clc		adc	#2		sta	<OneDocPtr		lda	<DocListPtr+2		adc	#0		sta	<OneDocPtr+2		stz	<OneDocCount		lda	[<DocListPtr]		;only show the updating window for 4 OneDocs and up		bne	@haveSomeOneDocs		brl	@doneWithOneDocs	;if we don't have any OneDocs, leave@haveSomeOneDocs		cmp	#4					bge	@ShowWindow		brl	@doneWindow		;; put up the window with the thermo control and a stat text item;			@ShowWindow	lda	finderFileID		pha		_SetCurResourceFile		pha				;set the depth deep enough to get the		lda	oldDepth		;thermo control defproc		pha		_SetResourceFileDepth		pla		pha		pha		pushlong #0			;titlePtr		pushlong #0			;refCon is ptr to our window info block		pushlong #AddBundleUpdate	;content draw proc		pushlong #0			;window defproc		pea	2			;refIsResource		pushlong #$11			;window resoure "Updating Desktop Database..."		pea	$800e			;rWindParam1		_NewWindow2		pulllong addBundleWindowPtr		bcc	@windowOK		sta	<error				lda	addBundleWindowPtr+1		beq	@noWindow				lda	addBundleWindowPtr		ldx	addBundleWindowPtr+2		jsl	CloseThisWindow@noWindow	brl	@errorClose@windowOK	pha		pha		_GetPort		pulllong <ourPort				pushLong addBundleWindowPtr		_SetPort		pha		pha		pushLong addBundleWindowPtr		pushlong #3		_GetCtlHandleFromID		lda	[<DocListPtr]		;# of items		inc	a			;plus 2 extra for read or rBundle and write of same		asl	a		ply		plx		pea	0		pha				;max value for dial		phx		phy		_SetCtlTitle			;set the scale		pushlong #c1_filename		pushZlong <pathnamePtr		jsl	PathGetName				lda	>c1_filename		xba		sta	>c1_filename				pea	12		pea	26		_MoveTo		pushlong #strgReading		_DrawString		pushlong #c1_filename+1		_DrawString				jsl	AddBundleUpdate		;draw the bundle stuff		lda	#1			;say we read the rBundle		jsr	DrawThermo				pha		pea	1		_SetResourceFileDepth		pla;; now that we're done putting up the window for the user to yawn at, get about the more serious; business of copying all the stuff out of the source fork into the destination fork.;@doneWindow	jsr	setSourceFile		stz	<LastLargeIconID		stz	<LastLargeIconID+2		stz	<LastSmallIconID		stz	<LastSmallIconID+2				;; loadLoop -- walk all of the OneDocs, loading the rIcons into memory and marking them unpurgable;@loadLoop		ldy	#4			;check numResults		lda	[<OneDocPtr],y		cmp	#3		blt	@nextOneDocLoad				jsr	SaveLarge				ldy	#16			;load the large icon		jsr	loadIcon		jsr	RestoreLarge				bcc	@loadSmallIcon		brl	@errorClose		@loadSmallIcon	ldy	#4			;check numResults		lda	[<OneDocPtr],y		cmp	#4		blt	@nextOneDocLoad		jsr	SaveSmall				ldy	#24			;load the small icon		jsr	loadIcon		jsr	RestoreSmall				bcc	@nextOneDocLoad		brl	@errorClose		;; process the next OneDoc structure;@nextOneDocLoad		inc	<OneDocCount		lda	addBundleWindowPtr+1		beq	@noThermoLoad		lda	<OneDocCount		inc	a		jsr	DrawThermo@noThermoLoad						lda	<OneDocCount		cmp	[<DocListPtr]		bge	@doneWithLoad				lda	[<OneDocPtr]		clc		adc	<OneDocPtr			sta	<OneDocPtr		bcc	@goLoadLoop		inc	<OneDocPtr+2@goLoadLoop	brl	@loadLoop;; doneWithLoad -- we're done loading all the rIcons.  They're sitting around in memory, hopefully;		  very movable at this point;@doneWithLoad		stz	<LastLargeIconHandle	;start off with the 'last' handles set to zero so they don't		stz	<LastLargeIconHandle+2	;match any 'last' handle...		stz	<LastSmallIconHandle		stz	<LastSmallIconHandle+2				lda	<DocListPtr		;make the pointer to the first OneDoc struct		clc		adc	#2		sta	<OneDocPtr		lda	<DocListPtr+2		adc	#0		sta	<OneDocPtr+2		stz	<OneDocCount		jsr	setDesktopFile		lda	[<DocListPtr]		;only show the updating window for 4 OneDocs and up		cmp	#4		blt	@saveLoop*** Added - 2-Apr-93 JCM - Make sure @ is expanded so we have a real volume name to show.		lda	#MaxPathLen+MaxFileName+4		sta	c1_temppath-2		lda	<desktopPathPtr		sta	sourcePath		lda	<desktopPathPtr+2		sta	sourcePath+2		_ExpandPathGS expandDesktopParms*** End - 2-Apr-93 JCM		pushlong #c1_filename		pushZlong <desktopPathPtr		jsl	PathGetRoot				lda	>c1_filename		dec	a			;get rid of the colon		xba		sta	>c1_filename+1				pushlong #nameRect		_EraseRect		pea	12		pea	26		_MoveTo				pushlong #strgWritingTo		_DrawString				pushlong #c1_filename+2		_DrawString;; saveLoop -- walk all of the OneDocs, detaching and saving the rIcons as we go;@saveLoop	ldy	#4			;check numResults		lda	[<OneDocPtr],y		cmp	#2			;is there at least 2 result fields?		bcs	@have2Results		brl	@nextOneDocSave		;if not, look at the next one@have2Results		pei	<rFinderPathID+2		pei	<rFinderPathID				ldy	#6		lda	[<OneDocPtr],y		and	#$0001			;launchThis?		bne	@launchThis						lda	#0		sta	1,s		sta	3,s		@launchThis	ldy	#8			;stuff our created rFinderPath ID into the		lda	1,s			;the rFinderPath result field		sta	[<OneDocPtr],y		iny		iny		lda	3,s		sta	[<OneDocPtr],y		pla		pla		jsr	zeroHandle		;sero the next longword in the OneDoc		;; now, add the large and small rIcons to the desktop file;		ldy	#4			;check numResults		lda	[<OneDocPtr],y		cmp	#3		blt	@nextOneDocSave				jsr	SaveLarge		ldy	#16			;save the large icon		jsr	saveIcon		jsr	RestoreLarge				bcc	@saveSmallIcon		brl	@errorClose		@saveSmallIcon	ldy	#4			;check numResults		lda	[<OneDocPtr],y		cmp	#4		blt	@nextOneDocSave			jsr	SaveSmall				ldy	#24			;load the small icon		jsr	saveIcon		jsr	RestoreSmall				bcc	@nextOneDocSave		brl	@errorClose		;; process the next OneDoc structure;@nextOneDocSave		inc	<OneDocCount				lda	addBundleWindowPtr+1		beq	@noThermoSave		lda	<OneDocCount		clc		adc	[<DocListPtr]		;(A) on stack for _SetCtlValue		inc	a		jsr	DrawThermo@noThermoSave		lda	<OneDocCount		cmp	[<DocListPtr]		bge	@doneWithOneDocs				lda	[<OneDocPtr]		clc		adc	<OneDocPtr			sta	<OneDocPtr		bcc	@goSaveLoop		inc	<OneDocPtr+2@goSaveLoop	brl	@saveLoop;; done walking all the OneDocs and writing out all the attached information (at this point the; user should be bored to tears) so write out the rBundle and close everything;@doneWithOneDocs		jsr	setSourceFile				pea	$802B		pushZLong <rBundleID		_DetachResource		jsr	setDesktopFile		pha		pha		pea	$802B		_CountResources		pla		plx				pha		pha		pea	$802B		phx		pha		_GetIndResource		bcc	@gotFirstOK				lda	#0			;just to be sure, we can't depend on the return		sta	1,s			;from getIndexedResource		sta	3,s		@gotFirstOK	pla		clc		adc	#1			;next resource please		plx		bcc	@nr		inx	@nr		stx	<UniqueID+2		sta	<UniqueID		ldy	#4			;zero the rIcon for this app field		lda	#0		sta	[<rBundlePtr],y		iny		iny		sta	[<rBundlePtr],y				iny				;save the unique ID for the rBundle inside of the		iny				;rBundle itself		lda	<uniqueID		sta	[<rBundlePtr],y		iny		iny		lda	<uniqueID+2		sta	[<rBundlePtr],y				pushZLong <rBundleHandle		pea	$0040		pea	$802B		pushZLong <UniqueID		_AddResource		bcc	@addRBundleOK		@errorClose	sta	<error		jsr	forceBoth		bra	@resetDepth@sourceClose	sta	<error		jsr	forceSource		bra	@resetDepth@addRBundleOK	jsr	closeBoth		bcc	@resetDepth		;if we get an error closing, close them again						;really hard		sta	<error		jsr	forceBoth;; reset the resource search path depth and leave;@resetDepth		pha		lda	oldDepth		pha		_SetResourceFileDepth		pla		lda	finderFileID		pha		_SetCurResourceFile				lda	addBundleWindowPtr+1		beq	@noClose		lda	<OneDocCount		clc		adc	[<DocListPtr]				inc	a		inc	a		jsr	DrawThermo		;draw the last segment in the thermo bar		pha				;wait half a second for this to register in the		pea	0			;user's eyeball		pea	$01e0			;30 ticks, half a second		_WaitUntil		pla		pushZLong <ourPort		_SetPort		lda	addBundleWindowPtr		ldx	addBundleWindowPtr+2		jsl	CloseThisWindow@noClose		;; we be chillin', we're finished;@done				pld		plb		lda	retAddr+1,s		;clean up stack		sta	retAddr+inParms+1,s		lda	retAddr,s		sta	retAddr+inParms,s		tsc		clc		adc	#inParms+locParms		tcs		rtl*** Added - 2-Apr-93 JCM - For expanding @.expandDesktopParms dc.w 3			;pCountsourcePath	dc.L 0				;inputPath ptr		dc.L c1_temppath-2		;outputPath ptr		dc.w 0				;flags - don't uppercase chars*** End - 2-Apr-93 JCM;; DrawThermo -- update the thermometer bar;; IN: (A) = value for thermo bar;DrawThermo	sta	<thermo				pha		_GetCurResourceFile		pea	1		_SetCurResourceFile		pei	<thermo			;(A) on stack for _SetCtlValue		pha		pha		pushlong addBundleWindowPtr		pushlong #3		_GetCtlHandleFromID		_SetCtlValue			;set the thermo dial		_SetCurResourceFile		rts;; DON'T do anything in the following 4 routines which might change the carry!;SaveLarge	lda	<LastLargeIconHandle		sta	<LastIconHandle		lda	<LastLargeIconHandle+2		sta	<LastIconHandle+2				lda	<LastLargeIconID		sta	<LastIconID		lda	<LastLargeIconID+2		sta	<LastIconID+2		rts		RestoreLarge	lda	<LastIconID		sta	<LastLargeIconID		lda	<LastIconID+2		sta	<LastLargeIconID+2		lda	<LastIconHandle		sta	<LastLargeIconHandle		lda	<LastIconHandle+2		sta	<LastLargeIconHandle+2		rtsSaveSmall	lda	<LastSmallIconHandle		sta	<LastIconHandle		lda	<LastSmallIconHandle+2		sta	<LastIconHandle+2				lda	<LastSmallIconID		sta	<LastIconID		lda	<LastSmallIconID+2		sta	<LastIconID+2		rtsRestoreSmall	lda	<LastIconID		sta	<LastSmallIconID		lda	<LastIconID+2		sta	<LastSmallIconID+2		lda	<LastIconHandle		sta	<LastSmallIconHandle		lda	<LastIconHandle+2		sta	<LastSmallIconHandle+2		rts		;; load the icon located at offset in Y in the current OneDoc, save the handle at offset Y+4;loadIcon	sty	<iconOffset		lda	[<OneDocPtr],y		sta	<rIconID		iny		iny		lda	[<OneDocPtr],y		sta	<rIconID+2		ora	<rIconID		bne	@hasIcon		clc		rts@hasIcon		lda	<LastIconID		cmp	<rIconID		bne	@genuineLoad		lda	<LastIconID+2		cmp	<rIconID+2		bne	@genuineLoad				lda	<LastIconHandle		sta	<rIconHandle		lda	<LastIconHandle+2		sta	<rIconHandle+2		bra	@alreadyLoaded@genuineLoad	pha		pha		pea	$8001		pushZLong <rIconID		_LoadResource		plx		stx	<rIconHandle		stx	<LastIconHandle		plx		stx	<rIconHandle+2		stx	<LastIconHandle+2		bcc	@loadedicon		rts@loadedIcon		lda	<rIconID		sta	<LastIconID		lda	<rIconID+2		sta	<LastIconID+2				pea	$8001		pushZLong <rIconID		_DetachResource		ldy	#4			;unlock the handle, let it float		lda	[<rIconHandle],y		and	#$7fff		sta	[<rIconHandle],y		and	#$0300		beq	@noPurge		pea	0			;set the purge level of the handle to zero		pushZLong <rIconHandle		;so it won't leave until we write it		_SetPurge@noPurge@alreadyLoaded	ldy	<iconOffset		;save the rIcon's handle		iny		iny		iny		iny				lda	<rIconHandle		sta	[<OneDocPtr],y		iny		iny		lda	<rIconHandle+2		sta	[<OneDocPtr],y				clc		rts;; save the icon located at offset in Y in the current OneDoc;saveIcon	sty	<iconOffset		;is there an icon there?		lda	[<OneDocPtr],y		iny		iny		ora	[<OneDocPtr],y		bne	@hasIcon		;if so, save it			jsr	zeroHandle		;if not, zero the handle space also		clc		rts@hasIcon				iny				;has the icon, so get its handle from the OneDoc		iny		lda	[<OneDocPtr],y		sta	<rIconHandle		iny		iny		lda	[<OneDocPtr],y		sta	<rIconHandle+2				cmp	<LastIconHandle+2		bne	@needNewID		lda	<rIconHandle		cmp	<LastIconHandle		bne	@needNewID				ldy	<iconOffset		;save the unique ID we just made into the OneDoc		lda	<LastIconID		sta	[<OneDocPtr],y		iny		iny		lda	<LastIconID+2		sta	[<OneDocPtr],y				jsr	zeroHandle		;and zero the handle space		bra	@addRIconOK		@needNewID	lda	<rIconHandle		sta	<LastIconHandle		lda	<rIconHandle+2		sta	<LastIconHandle+2				pha		pha		pea	$FFFF			;application valid range		pea	$8001		_UniqueResourceID		plx		stx	<uniqueID		stx	<LastIconID		plx		stx	<uniqueID+2		stx	<LastIconID+2		bcc	@hasUniqueRIcon		rts@hasUniqueRIcon		ldy	<iconOffset		;save the unique ID we just made into the OneDoc		lda	<uniqueID		sta	[<OneDocPtr],y		iny		iny		lda	<uniqueID+2		sta	[<OneDocPtr],y				jsr	zeroHandle		;and zero the handle space		pushZLong <rIconHandle		pea	$0040			;preload		pea	$8001		pushZLong <UniqueID		_AddResource		bcc	@addRIconOK		rts@addRIconOK	clc		rts;; set source resource file;setSourceFile		pei	<sourceFileID		_SetCurResourceFile		rts;; set desktop resource file;setDesktopFile		pei	<desktopFileID		_SetCurResourceFile		rts;; zeroHandle -- zero the next handle address in Y;zeroHandle		iny				;zero the handle space		iny		lda	#0		sta	[<OneDocPtr],y		iny		iny		sta	[<OneDocPtr],y		rts		;; close both resource files;closeBoth		pei	<sourceFileID		_CloseResourceFile				pei	<desktopFileID		_CloseResourceFile		rts;; damn well close both files unconditionally, no ifs and, or buts;forceBoth		lda	<desktopFileID		ora	#$8000		pha		_CloseResourceFile		forceSource		lda	<sourceFileID		ora	#$8000		pha		_CloseResourceFile		rts;; addBundleUpdate -- draw the controls in the "Updating the desktop file" window;addBundleUpdate		phb		phk		plb				pha		_GetCurResourceFile				lda	finderFileID		pha		_SetCurResourceFile		pha				;set the depth deep enough to get the		lda	oldDepth		pha				;thermo control defproc		_SetResourceFileDepth		pushlong addBundleWindowPtr		_DrawControls				lda	1,s		pha		_SetResourceFileDepth		pla				_SetCurResourceFile				plb		rtl		;; locals;CreateParms	dc.w	4			;pcount		dc.L	0			;ptr to pathname		dc.w	$c3			;access		dc.w	$0f			;filetype		dc.L	0			;auxtype		nameRect	dc.w	16,12,26+1,343		;added 1, 13-Jul-92 DALfinderFileID	dc.w	0oldDepth	dc.w	0characteristics dc.w	0addBundleWindowPtr dc.L	0		END