****************************************************************************************************************************** KeyboardNav.aii** This is an Init or Finder Extension that implements Keyboard* Navigation for Finder 6.0 (similar to Macintosh Finder 7.0).** by David A. Lyons and Andy Nicholas (with a guest appearance*	 	 by Jim Murphy)** Copyright 1992-1993, Apple Computer, Inc.* All Rights Reserved******************************************************************************************************************************* REVISION HISTORY** 21-Feb-92 DAL*   Begun.  Borrowed skeleton from Sound Control Panel.*   Doesn't do much, but it sends the front window to the*     back if you type Command-zero.** 22..23-Feb-92 DAL and Andy*   Make this thing actually do something useful.*   Arrow keys work pretty well in all views, in windows and*     on desktop.  (Small Icon needs some work.)*   Discovered and hacked around two bugs in Finder 6.0:*     (1) tellFinderSetSelectedIcons bit 31 is broken*     (2) icon height & width fields in extended stringLists*         (tellFinderGetSelectedIcons/tellFinderGetWindowIcons)*         are broken.  We patch 6.0 Finder to avoid crashing*         the system (potentially).*   Discovered that there is a Rename field too much of the*     time.  Will need to patch around that, too.*   Need to make Tab and letter-navigation work.** 24-Feb-92 DAL*   Fixed a bad branch at @skipDeselect.** 25-Feb-92 DAL, 1.0d3*   Redundant finderSaysGoodbye now does nothing.*   Fixed address of RTL for skanky 6.0 patch.** 7-Mar-92 DAL, 1.0d4*   Work on letter navigation.** 3..4-Jun-92 DAL, 1.0d5*   Conditional InitVersion stuff (if 0, we're building the*   rFinderExtension resource version).**   Moved DebugSymbols to makefiles.** 4-Jun-92 DAL*   Made letter and Tab/Shift-Tab navigation work.** 8-Jun-92 DAL*   Icon list no longer gets thrown away unnecessarily the 2nd*   time it is accessed.  Removed debugging SysBeep.** 23-Jun-92 DAL*   Tick counts now come from finderSaysKeyHit, not GetTick.** 22-Mar-93 JCM - Removed all code associated with the Init version. Since we*   v1.0d15       won't be releasing it, the stuff was just cluttering up the*                 code. If you want to see what it did, do a compare revisions*                 to something before this date. Or not.** 25-Mar-93 DAL*   If-ed out Jim experimental stuff.*   Fixed a problem when there are no icons in the window.*   Fixed letter navigation to go to the alphabetically last*     item if the string comes after all the items.** 2-Apr-93 JCM - Fixed to invalidate the cached icon list if we get a selection*                changed notification that we didn't initiate.** 2-Apr-93 JCM - Fixed the backwards window cycling code to skip invisible windows.** 2-Apr-93 DAL*   ¥Changed request procedure name to show version 1.0 final.*   ¥Fixed navigation to scroll so that that an icon's whole*   name gets scrolled into view, when viewing by small icon.** 2-Apr-93 JCM - Fixed the case where our VisRgn could get offset*                by the scroll amount, which would really screw up*                any hope of drawing things into the window correctly.*                ScrollToShowXY was calling _StartDrawing, but was*                never resetting the origin with _SetOrigin(0,0).******************************************************************************************************************************* USER INTERFACE** Interesting things about keyboard navigation in Mac Finder 7.0:** Tab/Shift-Tab = select next/previous icon alphabetically** Command-shift-up-arrow = make desktop active*   (We could select top-right icon on the desktop)** Command-up makes parent window active*   (with Option, closes current window)*   (We can use tellFinderOpenWindow and tellFinderCloseWindow?)** Command-down = open (with option, closes current window)*   (we can use tellFinderMItemSelected(Open))** Arrow keys with -no- icons selected selects the extreme icon* in the chosen direction.*** In general, what happens if multiple icons are already* selected? It seems to pick one, but I don't know which one.******************************************************************************************************************************* OPERATION** We receive finderSaysKeyHit requests and ask the Finder to* select icons appropriately, using tellFinderGetWindowIcons,* tellFinderSetSelectedIcons, etc.** I hope this is fast enough!** (Provide much more detail here later.)  [Or not.]***************************************************************	include 'all.macros'	include 'E16.Finder'	include 'E16.Locator'	include 'E16.Event';; --- ICONOBJ record offsets -------------------------------------------;icNext	equ 0		;Handle of next icon.icLast	equ icNext+4		;Handle of previous icon.icMom	equ icLast+4		;Window icon belongs to.icWind	equ icMom+4		;Window icon is opened into.icDisk	equ icWind+4		;Disk icon which owns this iconicFlag	equ icDisk+4		;Defined below.icFType	equ icFlag+4		;Icon's file typeicAuxType	equ icFType+2		;NOTE: icAuxtype and icFileInfo are the same thing!icFileInfo	equ icFType+2		;File's Aux type or Device's File System.icKind	equ icFileInfo+4		;PTR to kind stringicy	equ icKind+4		;Position of icon's bottom.icx	equ icy+2		;X position of icon's middleicTextY	equ icx+2		;Text's y position when viewed by text.icTitleLen	equ icTextY+2		;Half the length of the icon's title.icName	equ icTitleLen+2		;Name of icon.icLocalAccess	equ icName+34		;Icon's current local accessicForked	equ icLocalAccess+2		;high bit set if file is extended		icFBlocks	equ icForked+2		;Icon's file block size; deviceÕs used blocks.icFBytes	equ icFBlocks+4		;Icon's file byte size; deviceÕs total blocksicCDate	equ icFBytes+4		;Icon's file creation date.icMDate	equ icCDate+8		;Icon's file modification date.icIcon	equ icMDate+8		;Offset into Handle and Offset lists for this iconicSmallIcon	equ icIcon+4		;Offset into Handle and Offset lists for this iconicRBundle	equ icSmallIcon+4		;Handle of rBundle which matched or NILicOneDocOffset	equ icRBundle+4		;Offset to OneDoc within rBundle handleicInfo	equ icOneDocOffset+4	;Pointer to Info window if any, else zero.icDevNum	equ icInfo+4		;Icon's device number (device icons).icDevInfo	equ icDevNum+2		;if icon is a device, the return from _DInfoicOptionList	equ icDevInfo+2		;the option list for this file, 44 bytes longicFST	equ icOptionList+2icNetworkAccess	equ icFST+38icOptionListEnd	equ icNetworkAccess+4ICSIZE	equ icNetworkAccess+4;; ------ Extended ICONOBJ record -----------------------------------;icOldPosY	equ ICSIZE		;Y position in real mom window.icOldPosX	equ icOldPosY+2		;X position in real mom window.icOwner	equ icOldPosX+2		;Pathname of icon's real owner.;; Window type ID's;DirWindID	equ $0002	;Directory windowTrashWindID	equ $0004	;Trash windowClipWindID	equ $0008	;Clipboard windowInfoWindID	equ $0010	;Info windowVerifyWindID	equ $0020	;Verify windowaboutWindID	equ $0040	;about windowhelpWindID	equ $0080	;help window;; View numbers;viewByIcon	equ $0viewBySmallIcon	equ $1viewByName	equ $2viewByDate	equ $3viewBySize	equ $4viewByKind	equ $5;; extended stringlist equates;exSLOffset	equ 0exSLIconY	equ 2exSLIconX	equ 4exSLIconTextY	equ 6exSLIconHeight	equ 8exSLIconWidth	equ 10exSLIconObj	equ 12;exSLwString	equ ??	;field is not at a guaranteed offset!;; character constants;upArrowKey	equ $0BdownArrowKey	equ $0AleftArrowKey	equ $08rightArrowKey	equ $15tabKey	equ $09;; text-navigation constants;MaxNavPrefixLength	equ 32MaxDelayBetweenKeys	equ 40**************************************************************** MAIN ENTRY POINT FOR INIT** Validate the environment and install our request procedure.** Our Memory ID is in A.* The data bank register is undefined.** To ask the caller to unload us, we can set bit 0 of the* word just under the RTL address.***************************************************************KeyboardNav	procname	import KeyNavRequestProc	import myMemID	pushlong #NavReqProcName	pha	_MMStartUp	;my user ID (leave on stack)	lda 1,s	sta >myMemID	pushlong #KeyNavRequestProc	_AcceptRequests	rtlNavReqProcName	str 'Apple~FinderNavigation~1.0~'**************************************************************** KeyNavRequestProc (called by SendRequest)** On entry, D and B are undefined, and the stack looks like* this:**   +014  WORD      result ($8000 to accept)*   +012  WORD      request code*   +008  LONG      dataIn value*   +004  LONG      dataOut pointer*   +001  3 bytes   RTL address** Dispatch the request to the appropriate routine, set bit 15* of result if we're accepting the request, and then strip off* ten bytes of input parameters before returning with RTL.***************************************************************KeyNavRequestProc	procname	DefineStackzero	wordkeyHit	wordmodifiers	wordextSelList	longextSelListPtr	longextIconList	longextIconListPtr	longourValue	wordrecordPtr	longcurrentRecordNum	wordbestValue	wordbestRecordPtr	longNewSList	longNewSListPtr	longsList	longsListPtr	longptr	long	;temp window pointertickCount	wordsizeLocals	EndLocalssaveBank	block 1saveDPage	wordreturnAddr	block 3	BegParmsdataOut	longdataIn	longrequest	wordsizeParms	EndParmsresult	word	tsc	and #$ff00	xba	dec a	bne @stackOkay	brl @quickExit@stackOkay	phd	;Save directPage register.	phb	phk	plb	tsc	;Make space for locals.	sec	sbc #sizeLocals	tcd	;Set directPage register.	tcs	stz <zero	lda <request	sta @requestTable	ldx #@procTable-@requestTable@search	dex	dex	cmp @requestTable,x	bne @search	lda <dataIn+2	ldy <dataIn	jsr (@procTable,x)	;return with SEC to accept request@done	ror <result	;set bit 15 to accept the request	tsc	;Get rid of local variables.	clc	adc #sizeLocals	tcs	plb	;Restore caller's bank register	pld	;Restore caller's direct-page register.@quickExit	lda 2,s	;strip 10 bytes from stack and exit	sta 12,s	lda 1,s	sta 11,s	ply	ply	ply	ply	ply	rtl@requestTable	dc.w $0000	;dummy entry for sentinel search	dc.w finderSaysKeyHit	dc.w finderSaysSelectionChanged	dc.w finderSaysHello	dc.w finderSaysGoodbye	dc.w finderSaysMItemSelected	dc.w srqGoAway** Procedures receive dataIn in AY, return SEC to accept a request.*@procTable	dc.w @ignore	dc.w handleKeyHit	dc.w handleSelectionChanged	dc.w handleHello	dc.w handleGoodbye	dc.w handleMItemSelected	dc.w handleGoAway@ignore	clc	;reject the request	rts***************************************************************** handleKeyHit** Respond to a finderSaysKeyHit request.** Inputs:  <dataIn (AY) points to:*             +000  WORD   Parameter count (at least 3 for 6.0.1)*             +002  WORD   Key code from TaskMaster (low byte)*             +004  WORD   Modifiers from TaskMaster*             +006  LONG   Tick count from keyDown event*          <dataOut = reserved****************************************************************handleKeyHit	name	ldy #6	;get the low word of the tick count	lda [<dataIn],y	sta <tickCount	ldy #2	;get the key	lda [<dataIn],y	and #$00ff	sta <keyHit	ldy #4	;get modifiers	lda [<dataIn],y	sta <modifiers;; If the key is Command-KeyPad-zero, cycle the front; window to the back.;;	;lda <modifiers	and #keyPad+appleKey+optionKey+controlKey	cmp #keyPad+appleKey	bne @notCycleWindows	lda <keyHit	;get the key	cmp #'0'	bne @notCycleWindows; If Shift is down, cycle the other way	lda <modifiers	and #shiftKey	bne @cycleBackwards; Cycle forwards (send front window to back)	jsr GetFrontWindPtr	beq @notCycleWindows	pushlong #$fffffffe	;-2 = behind all others	phy	phx	_SendBehind	sec	;accept the request	rts;; Find backmost window and select it;@cycleBackwards	jsr GetFrontWindPtr	beq @notCycleWindows*** Added - 2-Apr-93 JCM - Make sure we ignore invisible windows are we select the previous window.;	ldy <ptr+2;	ldx <ptr;@search	sty <ptr+2;	stx <ptr;	pha;	pha	;space for next window;	phy;	phx	;this window;	_GetNextWindow;	plx;	ply;;	bne @search;	txa;	bne @search	jsr GetDeepestVisibleWindow	beq @notCycleWindows	phy	phx;; We got nil, so the previous window pointer is the one to select;;	pei <ptr+2;	pei <ptr*** End - 2-Apr-93 JCM	_SelectWindow	sec	rts@notCycleWindows;; See if we should use the key to navigate (if there are; interesting modifiers down, pass up the key so someone; else can do something exciting with it).;	lda <modifiers	;get modifiers	and #keyPad+appleKey+controlKey	beq @navigating@toNotNavigation	brl notNavigation@navigating;; If KeyTranslation is off and Option is down, this keystroke is not for us.; Leave it for somebody else.;	lda <modifiers	and #optionKey	beq @optionNotDown	pha	_GetKeyTranslation	pla	beq @toNotNavigation@optionNotDown;; Do something really exciting here, like navigate!;; Arrow keys move up and down in lists, free-form by icon.; Tab moves to the alphabetically-next icon, Shift-Tab to previous.; Letter keys accumulate a prefix if you type them fast;   enough, selecting the first thing that matches the;   whole prefix-in-progress.  (How fast is fast enough?;   ListKey uses 40 ticks.  What does the Mac do?);	jsr GetExtSelIcons		;get the extended selected icon list	stz gwInfoWindView		;view by icon if on the desktop	lda gsiWindow+1	beq @onDesktop	jsr GetWindowInfo		;get the kind of window that's@onDesktop	lda gsiWindow+2	ldx gsiWindow	jsr GetExtIconList		;get the complete icon list	jsr derefExtIList	jsr derefExtSelList	jsr DispatchTheKey		;returns SEC to accept request	php; Dispose of handles if we want...or keep one around!	pushlong gsiStringList	_DisposeHandle	stz gsiStringList+1	plp	rts;; Dispatch to various routines based on the keystroke;DispatchTheKey	lda <keyHit	ldx #EndNavKeys-NavKeys-2@iLoop	cmp NavKeys,x	beq @dispatch	dex	dex	bpl @iLoop	brl LetterNavigation@dispatch	lda gwInfoWindView	cmp #viewByName	bcs NavListView;; NavIconView -- handle keyboarding when the window with the selected icons is in the icon view;NavIconView	lda [<extSelListPtr]  ;feed in icon count/BEQ	jmp (NavIconHow,x);; NavListView -- handle keyboarding when the window with the selected icons;                is in a list view;NavListView	lda [<extSelListPtr]  ;feed in icon count/BEQ	jmp (NavListHow,x);; Navigation key list;NavKeys	dc.w upArrowKey	dc.w downArrowKey	dc.w leftArrowKey	dc.w rightArrowKey	dc.w tabKeyEndNavKeysNavIconHow	dc.w IconUp	;up arrow	dc.w IconDown	;down arrow	dc.w IconLeft	;left arrow	dc.w IconRight	;right arrow	dc.w tabNavigation	;tab keyNavListHow	dc.w ListUp	;up arrow	dc.w ListDown	;down arrow	dc.w NotNavigation	;left arrow	dc.w NotNavigation	;right arrow	dc.w tabNavigation	;tab key;; IconUp -- Icon or small icon view, try to move upwards;IconUp	name	beq @extremeIconUp	jsr InitVerticalLawnmower	ldy #exSLIconY+2	lda [<extSelListPtr],y	tax	;ourValue	ldy #0	;initial bestValue	lda #iconUpWalker	jsr WalkTheIcons	sec	;accept the keyHit request	rts@extremeIconUp	jsr MaxLawnmower	ldx #0	;ourValue	ldy #$ffff	;initial best value	lda #iconDownWalker	jsr WalkTheIcons	sec	rtsiconUpWalker	name	ldy #exSLIconY	lda [<recordPtr],y	cmp <ourValue	bcs @noGood	cmp <bestValue	bcc @noGood	pha	jsr CheckVerticalLawnmower	pla	;new bestValue in A, in case carry is clear	rts@noGood	sec	rts;; IconDown -- Icon or small icon view, try to move downwards;IconDown	name	beq @extremeIconDown	jsr InitVerticalLawnmower	ldy #exSLIconY+2	lda [<extSelListPtr],y	tax	;ourValue	ldy #$ffff	;initial best value	lda #iconDownWalker	jsr WalkTheIcons	sec	;accept the keyHit request	rts@extremeIconDown	jsr MaxLawnmower	ldx #$ffff	;ourValue	ldy #0	;initial best value	lda #iconUpWalker	jsr WalkTheIcons	sec	rtsiconDownWalker	name	ldy #exSLIconY	lda [<recordPtr],y	cmp <ourValue	beq @noGood	bcc @noGood	cmp <bestValue	bcs @noGood	pha	jsr CheckVerticalLawnmower	pla	;new bestValue in A, in case carry is clear	rts@noGood	sec	rts;; MaxLawnmower -- Max the lawnmower band as tall/wide as possible;MaxLawnmower	name	stz LawnmowerMin	lda #$3fff	sta LawnmowerMax	rts;; InitVerticalLawnmower;; Set the left and right edges of the lawnmower band; according to the position and width of the first icon; record in the list at extSelListPtr.;InitVerticalLawnmower name	ldy #exSLIconX+2	lda [<extSelListPtr],y	tax	clc	ldy #exSLIconWidth+2	adc [<extSelListPtr],y	adc #20	;slop	sta LawnmowerMax	txa	sec	sbc [<extSelListPtr],y	sbc #20	;slop	sta LawnmowerMin	rts;; CheckVerticalLawnmower;; See if the X coordinate of [<recordPtr] is within a; tall narrow band bounded by LawnmowerMin on the left; and LawnmowerMax on the right.  Return CLC if it's; good.;CheckVerticalLawnmower name	ldy #exSLIconX	lda [<recordPtr],y	cmp LawnmowerMin	bmi @bad	;was bcc	cmp LawnmowerMax	bpl @bad@good	clc	rts@bad	sec	rtsLawnmowerMin	dc.w 0LawnmowerMax	dc.w 0;; IconLeft -- Icon or small icon view, try to move left;IconLeft	name	beq @extremeIconLeft	jsr InitHorizontalLawnmower	ldy #exSLIconX+2	lda [<extSelListPtr],y	tax	;ourValue	ldy #0	;initial bestValue	lda #iconLeftWalker	jsr WalkTheIcons	sec	;accept the keyHit request	rts@extremeIconLeft	jsr MaxLawnmower	ldx #0	;ourValue	ldy #$ffff	;initial best value	lda #iconRightWalker	jsr WalkTheIcons	sec	rtsiconLeftWalker	name	ldy #exSLIconX	lda [<recordPtr],y	cmp <ourValue	bcs @noGood	cmp <bestValue	bcc @noGood	pha	jsr CheckHorizontalLawnmower	pla	;new bestValue in A, in case carry is clear	rts@noGood	sec	rts;; IconRight -- Icon or small icon vuew, try to move right;IconRight	name	beq @extremeIconRight	jsr InitHorizontalLawnmower	ldy #exSLIconX+2	lda [<extSelListPtr],y	tax	;ourValue	ldy #$ffff	;initial best value	lda #iconRightWalker	jsr WalkTheIcons	sec	;accept the keyHit request	rts@extremeIconRight	jsr MaxLawnmower	ldx #$ffff	;ourValue	ldy #0	;initial best value	lda #iconLeftWalker	jsr WalkTheIcons	sec	rtsiconRightWalker	name	ldy #exSLIconX	lda [<recordPtr],y	cmp <ourValue	beq @noGood	bcc @noGood	cmp <bestValue	bcs @noGood	pha	jsr CheckHorizontalLawnmower	pla	;new bestValue in A, in case carry is clear	rts@noGood	sec	rts;; InitHorizontalLawnmower;; Set the top and bottom edges of the lawnmower band; according to the position and height of the first icon; record in the list at extSelListPtr.;InitHorizontalLawnmower name	ldy #exSLIconY+2	lda [<extSelListPtr],y	tax	lda gwInfoWindView	cmp #viewBySmallIcon	beq @smallIcon* %%% Fix to use icon height from record; hard-code a canonical icon height	txa	clc	adc #12+6	sta LawnmowerMax	txa	sec	sbc #20+6	sta LawnmowerMin	rts@smallIcon	txa	clc	adc #4	;??? was 1	sta LawnmowerMax	txa	sec	sbc #9	sta LawnmowerMin	rts;; CheckHorizontalLawnmower;; See if the X coordinate of [<recordPtr] is within a; tall narrow band bounded by LawnmowerMin on the left; and LawnmowerMax on the right.  Return CLC if it's; good.;CheckHorizontalLawnmower name	ldy #exSLIconY	lda [<recordPtr],y	cmp LawnmowerMin	bmi @bad	;was bcc	cmp LawnmowerMax	bpl @bad@good	clc	rts@bad	sec	rts;; ListUp -- List view, try to move upwards;; Inputs:  extSelListPtr points to the extended selected-icons list;ListUp	name	beq @extremeUp	ldy #exSLIconTextY+2	lda [<extSelListPtr],y	tax	;ourValue	ldy #0	lda #listUpWalker	jsr WalkTheIcons	sec	;accept the keyHit request	rts@extremeUp	ldx #0	;ourValue	ldy #$ffff	;initial best value	lda #listDownWalker	jsr WalkTheIcons	sec	rtsListUpWalker	name	ldy #exSLIconTextY	lda [<recordPtr],y	cmp <ourValue	bcs @noGood	cmp <bestValue	bcc @noGood	clc	;new bestValue in A	rts@noGood	sec	rts;; ListDown -- List view, try to move downwards;ListDown	name	beq @extremeDown	ldy #exSLIconTextY+2	lda [<extSelListPtr],y	tax	;ourValue	ldy #$ffff	;initial best value	lda #listDownWalker	jsr WalkTheIcons	sec	;accept the keyHit request	rts@extremeDown	ldx #$ffff	;ourValue	ldy #0	;initial best value	lda #listUpWalker	jsr WalkTheIcons	sec	rtsListDownWalker	name	ldy #exSLIconTextY	lda [<recordPtr],y	cmp <ourValue	beq @noGood	bcc @noGood	cmp <bestValue	bcs @noGood	clc	;new bestValue in A	rts@noGood	sec	rts;; NotNavigation -- can't navigate with this window (sorry).;NotNavigation	name	jsr ZapThePrefix	clc	;reject request	rts;; LetterNavigation -- accumulate keypress & look for new best icon;LetterNavigation	name	jsr AccumulateKey	lda #$FF01	;large alphabetical pstring	sta bestNameSoFar	lda #PrefixStrWalker	jsr WalkTheIcons*** added 25-Mar-93 DAL -- If we're beyond the last item, choose the last item***   (Example: with items A, B, and C, hit Z, which is beyond the end. It***   should navigate to C.)	lda bestNameSoFar	;still $FF01?	cmp #$FF01	bne @noProblem	stz bestNameSoFar	lda #AlphaLastWalker	jsr WalkTheIcons@noProblem*** end 25-Mar-93	sec	;accept the keyHit request	rts;; PrefixStringWalker;; To be better than bestNameSoFar, the name must come alphabetically; before bestNameSoFar, but equal-or-after navPrefixPString.;PrefixStrWalker	name	jsr GrabIconNamePtr	pha	;space for CompareStrings	pei <zero	;flag to compare PStrings	pei <ptr+2	pei <ptr	pushlong #bestNameSoFar	_CompareStrings	pla	bpl pswNoGood	pha	;space for CompareStrings	pei <zero	;flag to cmpare PStrings	pei <ptr+2	pei <ptr	pushlong #navPrefixPString	_CompareStrings	pla	bmi pswNoGood@goodSetBestNameSoFar	pei <ptr+2	pei <ptr	pushlong #bestNameSoFar	pei <zero	pea 33	_BlockMove	clc	;new best value	rtspswNoGood	sec	rts;; AlphaLastWalker;; Find the alphabetically-last item.;AlphaLastWalker	name	jsr GrabIconNamePtr	pha	;space for CompareStrings	pei <zero	;flag to cmpare PStrings	pei <ptr+2	pei <ptr	pushlong #bestNameSoFar	_CompareStrings	pla	bmi pswNoGood	bra SetBestNameSoFarbestNameSoFar	ds.b 33;; GrabIconNamePtr;; Input:  <recordPtr points into an extended icon list record; Output: <ptr points to pstring name of icon (not locked);GrabIconNamePtr	name	ldy #exSLIconObj+2	lda [<recordPtr],y	sta <ptr+2	dey	dey	lda [<recordPtr],y	sta <ptr; <ptr is iconObj handle	ldy #2	lda [<ptr],y	tax	lda [<ptr]	clc	adc #icName	bcc @1	inx@1	sta <ptr	stx <ptr+2	; <ptr points to iconObj.icName (pstring)	rts;; TabNavigation;; Handle Tab or Shift-Tab;TabNavigation	name	jsr ZapThePrefix	jsr GetSelectedIconName  ;into currentName	ldx #$ff01	lda <modifiers	and #shiftKey	beq @forward	ldx #0	;for backwards@forward	stx bestNameSoFar	lda #TabWalker	jsr WalkTheIcons	sec	;accept request	rts;; For Tab:;   For name to be better it has to come alphabetically before bestNameSoFar,;   but after currentName.;; For Shift-Tab:;   For name to be better it has to come alphabetically after bestNameSoFar,;   but before currentName.;TabWalker	name	jsr GrabIconNamePtr	pha	;space for CompareStrings	pei <zero	;flag to compare PStrings	pei <ptr+2	pei <ptr	pushlong #bestNameSoFar	jsr SwapIfBackwards	_CompareStrings	pla	bpl @noGood	pha	;space for CompareStrings	pei <zero	;flag to compare PStrings	pei <ptr+2	pei <ptr	pushlong #currentName	jsr SwapIfBackwards	_CompareStrings	pla	bmi @noGood	beq @noGood@good	jmp SetBestNameSoFar@noGood	sec	rts;; If Shift is down, reverse the two longs on the stack so; CompareStrings compares in the other order;SwapIfBackwards	lda <modifiers	and #shiftKey	beq @noShift	lda 3,s	tax	lda 3+4,s	sta 3,s	txa	sta 3+4,s	lda 5,s	tax	lda 5+4,s	sta 5,s	txa	sta 5+4,s@noShift	rts;; Set currentName to name of first selected icon;GetSelectedIconName	name	lda #$ff01	sta currentName	lda [<extSelListPtr]	beq @gotName	ldy #exSLIconObj+2+2  ;2 for count word; 2 for high word of handle	lda [<extSelListPtr],y	sta <ptr+2	dey	dey	lda [<extSelListPtr],y	sta <ptr; <ptr is iconObj handle	ldy #2	lda [<ptr],y	tax	lda [<ptr]	clc	adc #icName	bcc @1	inx@1	phx	pha	;source is iconObj.icName	pushlong #currentName	pei <zero	pea 33	_BlockMove@gotName	rtscurrentName	ds.b 33***************************************************************** WalkTheIcons** Call a routine repeatedly for each extended icon record* in the list extIconListPtr points at, and then select* the best icon found.** Inputs:  A = address of subroutine to call*          X = <ourValue (for convenience of walk proc)*          Y = initial <bestValue*          extIconListPtr** The subroutine's inputs are:*   <recordPtr** The subroutine's outputs are:*   CLC if the icon just visited is a better match,*       new best-value in A****************************************************************WalkTheIcons	name	sta @callWalkProc+1	stx <ourValue	sty <bestValue	stz <currentRecordNum	stz <bestRecordPtr+1	lda <extIconListPtr	clc	adc #2	sta <recordPtr	lda <extIconListPtr+2	adc <zero	sta <recordPtr+2*** added 25-Mar-93 DAL -- Oops, check for NO ICONS being present	lda [<extIconListPtr]	bne @continue	rts@continue*** end 25-Mar-93@loop@callWalkProc	jsr $7777	;** self-modified **	bcs @noBetter	sta <bestValue	lda <recordPtr	sta <bestRecordPtr	lda <recordPtr+2	sta <bestRecordPtr+2@noBetter;; Advance to next record by adding wStringOffset+wStringLength+2;	lda [<recordPtr]	tay	;Y = offset to WString	inc a	inc a	clc	adc [<recordPtr],y	adc <recordPtr	sta <recordPtr	bcc @1	inc <recordPtr+2@1	inc <currentRecordNum	lda <currentRecordNum	cmp [<extIconListPtr]	blt @loop	jsr SelectBest	;does nothing if bestRecordPtr=NIL	rts***************************************************************** handleSelectionChanged** If we get a finderSaysSelectionChanged that definitely was* not caused by us calling tellFinderSetSelectedIcons, then* zap the navigation prefix (start a new one on the next* keystroke).****************************************************************handleSelectionChanged name	lda ExpectingSelChanged	bne @done	jsr ZapThePrefix	jsr InvalidateIconList@done	stz ExpectingSelChanged	sec	;accept the request	rts***************************************************************** handleHello** Respond to a finderSaysHello request.** Inputs:  <dataIn points to some global data****************************************************************handleHello	name	pea tellFinderGetDebugInfo	pea sendToName+stopAfterOne	jsr pushFinderName	pei <zero	pei <zero	pushlong #debugInfoOut	_SendRequest	stz ExpectingSelChanged	jsr InvalidateIconList	sec	;accept the request	rtsdebugInfoOut	dc.w 0	;recvCount	dc.w 0	;finderResult	dc.w 0	;pCountfinderDirPage	dc.w 0	ds.b 128***************************************************************** handleGoodbye** Respond to a finderSaysGoodbye request.** Inputs: none** Remove our item(s) from the Extras menu.****************************************************************handleGoodbye	name	jsr DisposeIconList@doNothing	sec	;accept the request	rts***************************************************************** handleMItemSelected** If somebody chooses a menu item and we notice it, let's* invalidate our cached copy of the icon list for curWind.****************************************************************handleMItemSelected	name	jsr InvalidateIconList	clc	;reject the request	rts***************************************************************** handleGoAway** Respond to an srqGoAway request (we're being asked to remove* ourself from the system completely).** dataOut points to the following structure:*   +000: recvCount (used by SendRequest)*   +002: userID (we fill in our userID if we can go away)*   +004: flags ($8000 to be able to restart from RAM)****************************************************************handleGoAway	name	lda <zero	;resource version can't do srqGoAway!	ldy #2	sta [<dataOut],y	iny	iny	;y=4	sta [<dataOut],y	;return flags	sec	;accept the request	rts******************************************************************************************************************************** Miscellaneous routines*******************************************************************************************************************************;; PushFinderName -- push the address of "Apple~Finder~" onto;                   the stack, under the RTS address.  (Saves;                   3 bytes per occurance over PEA, PEA.);; A and X are preserved!;PushFinderName	name	ply	pushlong #nameOfFinder	phy	rts***************************************************************** GetFrontWindPtr** Outputs:  window pointer in <ptr and YX, BEQ if NIL****************************************************************GetFrontWindPtr	name	pha	pha	_FrontWindow	plx	stx <ptr	ply	sty <ptr+2	lda <ptr+1	rts*** Added - 2-Apr-93 JCM - Make sure we ignore invisible windows are we select the previous window.***************************************************************** GetDeepestVisibleWindow** Outputs:  window pointer in <ptr and YX, or NIL if none****************************************************************GetDeepestVisibleWindow name	stz resultWindPtr	stz resultWindPtr+2	phy	phx@getNextWindow	lda 3,s	pha	lda 3,s	pha	_GetNextWindow	lda 2,s	beq @exit	pha	lda 5,s	pha	lda 5,s	pha	_GetWFrame	pla	and #$0020	;fVis	beq @getNextWindow	lda 3,s	sta resultWindPtr+2	lda 1,s	sta resultWindPtr		bra @getNextWindow@exit	pla	pla		ldy resultWindPtr+2	ldx resultWindPtr		lda resultWindPtr+1	;return beq/bne		rtsresultWindPtr	dc.l 0*** End - 2-Apr-93 JCM***************************************************************** Select the icon pointed to by <bestRecordPtr** Inputs:*   <bestRecordPtr*   gwInfoWindView*   gsiWindow****************************************************************SelectBest	name	lda <bestRecordPtr+1	bne @continue	rts@continue	pha	pha	;space for NewHandle result	pei <zero	;high word of size	lda [<bestRecordPtr]     ;offset to wString	tay	lda [<bestRecordPtr],y   ;length of icon pathname	clc	adc #4	;2 for icon count, 2 for wString length word	pha	lda myMemID	pha	ldx <zero	phx	;attributes	phx	phx	;location	_NewHandle	pulllong <NewSList	lda [<NewSList]	sta <NewSListPtr	ldy #2	lda [<NewSList],y	sta <NewSListPtr+2;; Set new stringList's icon count to 1;	lda #1	sta [<NewSListPtr];; Copy the pathname into the new string list;	lda [<bestRecordPtr]	clc	adc <bestRecordPtr	tax	lda <bestRecordPtr+2	adc <zero	pha	phx	;pushed source address	clc	lda <NewSListPtr	adc #2	tax	lda <NewSListPtr+2	adc <zero	pha	phx	;pushed dest address	pei <zero	;high word of length	lda [<bestRecordPtr]   ;offset to wString	tay	lda [<bestRecordPtr],y ;length of wString	inc a	inc a	pha	_BlockMove	pea tellFinderSetSelectedIcons	pea sendToName+stopAfterOne	jsr PushFinderName	lda <NewSList+2	ora #$8000	;bit 31 = deselect old icons first	pha	;dataIn	pei <NewSList	pushlong #ssiOut	_SendRequest	inc ExpectingSelChanged	pei <NewSList+2	pei <NewSList	_DisposeHandle	stz <NewSList+1	stz <NewSListPtr+1;; If the selected icon is not in view, scroll the window so it is.;	lda gwInfoWindView	cmp #viewByName	bcc @iconView@listView	ldy #exSLIconTextY	lda [<bestRecordPtr],y	sec	sbc #4	tay	ldx #0	bra @doScroll@iconView	ldy #exSLIconX	lda [<bestRecordPtr],y	tax	ldy #exSLIconY	lda [<bestRecordPtr],y	tay@doScroll	jsr ScrollToShowXY	rtsssiOut	dc.w 0	;recvCount	dc.w 0	;finderResult;; ScrollToShowXY;; Inputs:  X = X coordinate;          Y = Y coordinate;          gsiWindow = window pointer;ScrollToShowXY	name	stx neededX	sty neededY	lda gsiWindow+1	bne @notDesktop	rts@notDesktop	jsr setupSlopForView	stz needToScroll	;anticipate no need to scroll	pha	pha	;space for GetContentOrigin	jsr pushWindow	_GetContentOrigin	pla	sta viewY	pla	sta viewX	pha	pha	_GetPort	;preserve port	jsr pushWindow	_StartDrawing	pushlong #theRect	_GetPortRect	sec	lda theRect+6	sbc theRect+2	sta windowWidth	sec	lda theRect+4	sbc theRect	sta windowHeight; Do we need to scroll left?	lda neededX	sec	sbc xViewSlop	bpl @x1ok	lda #0@x1ok	cmp viewX	bcs @leftOK	sta viewX	inc needToScroll@leftOK*** added 2-Apr-93 DAL -- bump neededX to the right edge of the icon (or name)	lda gwInfoWindView	cmp #viewBySmallIcon	bne @notSmallicon; by Small Icon -- adjust by the name width@smallicon	jsr GetIconNameWidth	bra @adjustForRightEdge@notSmallicon	cmp #viewByIcon	bne @adjusted; by Icon -- adjust:;   if the icon is wider than the name, adjust by icon width;   if the name is wider than the icon, adjust by HALF of iconWidth+nameWidth;@byIcon	jsr GetIconNameWidth	ldy #exSLiconWidth	cmp [<bestRecordPtr],y	bcs @adjByIconWidth	jsr GetIconNameWidth	clc	ldy #exSLiconWidth	adc [<bestRecordPtr],y	lsr a	bra @adjustForRightEdge@adjByIconWidth	lda [<bestRecordPtr],y@adjustForRightEdge	clc	adc neededX	sta neededX@adjusted*** end 2-Apr-93; Do we need to scroll right?	lda neededX	clc	adc xViewSlop	cmp theRect+6	bcc @rightOK; Set viewX scroll so neededX+xViewSlop is visible:;   viewX = neededX+xViewSlop - window width	sec	sbc windowWidth	sta viewX	inc needToScroll@rightOK; Do we need to scroll up?	lda neededY	sec	sbc yViewSlop	bpl @y1ok	lda #0@y1ok	cmp viewY	bcs @upOK	sta viewY	inc needToScroll@upOK; Do we need to scroll down?	lda neededY	clc	adc yViewSlop	cmp theRect+4	bcc @downOK; Set viewY scroll so neededY+yViewSlop is visible:;   viewY = neededY+yViewSlop - window height	sec	sbc windowHeight	sta viewY	inc needToScroll@downOK	lda needToScroll	beq @noScroll	lda viewX	;X coordinate	pha	lda viewY	;Y coordinate	pha	jsr pushWindow	_SetContentOrigin@noScroll	lda <zero	pha	pha	_SetOrigin	_SetPort	;restore port	rtsneededY	dc.w 0neededX	dc.w 0viewY	dc.w 0viewX	dc.w 0needToScroll	dc.w 0theRect	ds.b 8windowWidth	dc.w 0windowHeight	dc.w 0xViewSlop	dc.w 0yViewSlop	dc.w 0*** modified 2-Apr-93 DAL to have separate slops for Small Icon viewSetupSlopForView	ldy #0	;anticipate icon view	lda gwInfoWindView	cmp #viewByIcon	beq @gotIt	ldy #4	;anticipate small icon view	cmp #viewBySmallIcon	beq @gotIt	ldy #8	;index to list view slops@gotIt	lda slops,y	sta yViewSlop	lda slops+2,y	sta xViewSlop	rtsslops	dc.w 12,24	;y,x for icon view	dc.w 12,32	;y,x for Small icon view (xslop big enough to allow for padlock)	dc.w 5,50	;y,x for list view;; pushWindow -- push gsiWindow onto the stack under RTS address;pushWindow	plx	pushlong gsiWindow	phx	rts;; GetIconNameWidth - Return the length of the name string.;	GetIconNameWidth	ldy #exSLIconObj+2	lda [<bestRecordPtr],y	sta <ptr+2	dey	dey	lda [<bestRecordPtr],y	sta <ptr; <ptr is iconObj handle	ldy #2	lda [<ptr],y	tay	lda [<ptr]	sty <ptr+2	sta <ptr	;points to iconObj	ldy #icTitleLen	;this is 1/2 of the width of the name string	lda [<ptr],y	asl a	rts***************************************************************** Get window's info** IN:* OUT:* USES: gsiWindow must contain a valid window pointer for a*       Finder window****************************************************************GetWindowInfo	name	pea tellFinderGetWindowInfo	pea sendToName+stopAfterOne	jsr PushFinderName	pushlong gsiWindow	;dataIn	pushlong #gwInfoOut	_SendRequest	rtsgwInfoOut	dc.w 0	;recvCountgwInfoResult	dc.w 0	;finderResultgwInfoWindType	dc.w 0gwInfoWindView	dc.w 0gwInfoWindFST	dc.w 0gwInfoWindTitle	dc.L 0gwInfoWindPath	dc.L 0	dc.L 0	dc.L 0***************************************************************** Get window's icons** Input: window pointer in AX (or NIL for Desktop)****************************************************************GetExtIconList	name	sta whatWindow+2	stx whatWindow	jsr CheckOldHandleValid	bcc @stillValid;;;	pea $c;;;	_SysBeep2	jsr DisposeIconList	pea tellFinderGetWindowIcons	pea sendToName+stopAfterOne	jsr PushFinderName	lda whatWindow+2	ora #$8000	;set the Extended bit	pha	lda whatWindow	pha	;dataIn	pushlong #gwiOut	_SendRequest; *** change the owner to me!	pha	;space for result	lda myMemID	pha	pushlong gwiStringList	_SetHandleID	pla	;discard old ID@stillValid	lda gwiStringList	sta <extIconList	lda gwiStringList+2	sta <extIconList+2	pha	pha	_GetTick	pla	sta staleIconsTick	pla	rtsgwiOut	dc.w 0	;recvCountgwiResult	dc.w 0	;finderResultgwiStringList	dc.L 0	;handle to extended stringlistwhatWindow	dc.l 0	;temp, local;; CheckOldHandleValid;; Return CLC if the gwiStringList handle is still valid;CheckOldHandleValid	name	ldx FinderDirPage	lda >1,x	cmp oldCurWindMiddle	sta oldCurWindMiddle	bne @bad	lda gwiStringList+1	beq @bad	pha	pha	_GetTick	pla	plx	sec	sbc staleIconsTick	cmp #4*60	bcs @bad	clc	rts@bad	sec	rtsoldCurWindMiddle	dc.w 0staleIconsTick	dc.w 0;; InvalidateIconList;; Arrange for the icon list handle to be recomputed at; the next opportunity.;InvalidateIconList	name	stz oldCurWindMiddle	rts;; DisposeIconList;; If gwiStringList is not nil, dispose it and nil it out.;; (This is our cached copy of the icons in the current; window.);DisposeIconList	name	lda gwiStringList+1	beq @noHandle	pushlong gwiStringList	_DisposeHandle	stz gwiStringList+1@noHandle	rts***************************************************************** Get extended selected icons** Input:  none* Output: gsiWindow and gsiStrings contain what's selected and*         the window in which it's selected****************************************************************GetExtSelIcons 	name	pea tellFinderGetSelectedIcons	pea sendToName+stopAfterOne	jsr PushFinderName	pushlong #$80000000	;dataIn (give us the extended stringlist stuff)	pushlong #gsiOut	_SendRequest	lda gsiStringList	sta <extSelList	lda gsiStringList+2	sta <extSelList+2; *** change the owner to me!	pha	;space for result	lda myMemID	pha	pei <extSelList+2	pei <extSelList	_SetHandleID	pla	;discard old ID	rtsgsiOut	dc.w 0	;recvCountgsiResult	dc.w 0	;finderResultgsiWindow	dc.L 0	;window containing selected iconsgsiStringList	dc.L 0	;handle to the stringlist handle (sometimes extended)***************************************************************** AccumulateKey** Input: <keyHit** Accumulates the key into the theNavPrefix, if the time* between keystrokes is fast enough.** Returns SEC if we've already hit the maximum prefix length.****************************************************************AccumulateKey	name	pha	jsr ZapIfTooSlow	pla	ldy navPrefixLength	cpy #MaxNavPrefixLength	bcs @done	sep #$20	sta theNavPrefix,y	rep #$20	inc navPrefixLength	inc navPrefixPString	clc@done	rts;; Make the navigation prefix null if it's been more than; MaxDelayBetweenKeys ticks since the last character we; accumulated.;ZapIfTooSlow;	pha;	pha;	_GetTick;	pla;	plx*** 23-Jun-92	lda <tickCount***	tay	;save tick in Y	sec	sbc lastNavTick	cmp #MaxDelayBetweenKeys	bcc @okay	jsr ZapThePrefix@okay	sty lastNavTick	rtsZapThePrefix	name	stz navPrefixLength	stz navPrefixPString	rts***************************************************************** deref routines, etc.****************************************************************derefSList	name	lda [<sList]	sta <sListPtr	ldy #2	lda [<sList],y	sta <sListPtr+2	rtsderefExtIList	lda [<extIconList]	sta <extIconListPtr	ldy #2	lda [<extIconList],y	sta <extIconListPtr+2	rtsderefExtSelList	lda [<extSelList]	sta <extSelListPtr	ldy #2	lda [<extSelList],y	sta <extSelListPtr+2	rts***************************************************************** VARIABLE STORAGE****************************************************************	export myMemIDmyMemID	dc.w 0LastNavTick	dc.w 0navPrefixLength	dc.w 0navPrefixPString	dc.b 0theNavPrefix	ds.b MaxNavPrefixLengthExpectingSelChanged	dc.w 0	;we did a SetSelectedIcons***************************************************************** STATIC STORAGE****************************************************************NameOfFinder	str 'Apple~Finder~'	EndP	END