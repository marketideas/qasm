*===============================================** File:		Verify.aii			** Project:	IIGS Finder			** Build file:	Finder.Make			**						** Copyright Apple Computer, Inc. 1988-1992	** All rights reserved.				**===============================================*		LONGA	ON		LONGI	ON		STRING	ASIS				PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM				INCLUDE	'DP.equ'		INCLUDE	'ALL.MACROS'		INCLUDE	'Pascal.macros'				INCLUDE	'special.macros'				INCLUDE	'GSOS.equ'		INCLUDE	'Resource.equ'		INCLUDE	'windowBlk.equ'		include 'E16.Event'		SEG	'Verify'				PRINT	ON; --- RECT record offsets ------------------------------------------------y1		equ	0x1		equ	y1+2y2		equ	x1+2x2		equ	y2+2RECTSIZE	equ	x2+2CancelID	equ	$FFFFOKID		equ	$0001TryAgainID	equ	$0002slowBlocks	equ	32			; blocks per "pass" for slow drivesfastBlocks	equ	128			; blocks per "pass" for fast drivesbuffSize	equ	$FFFF*2DataBuffer	EQU	$FE0000			; ROM space to READ to;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	C1_PathName		;in data.aii		IMPORT	C1_FileName		;in data.aii		IMPORT	C1_FileNameBuf		;in data.aii		;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------				ENTRY	OpenFile		ENTRY	CloseFile		ENTRY	GetDirEntry		ENTRY	GSOSError		ENTRY	DoRead		ENTRY	CountFiles			ENTRY	ReadFiles		*===============================================*		*	Data For Verify/Validate Routines	**===============================================*VerifyData	PROC		ENTRY	numberStrnumberStr	ds.b	10		ENTRY	numberWidthnumberWidth	dc.w	0		EXPORT vTaskRecord		vTaskRecord	dc.w	0			;what		dc.L	0			;message		dc.L	0			;when		dc.L	0			;where		dc.w	0			;modifiers		dc.L	0			;taskData		dc.L	$00038006		;taskMask		dc.L	0			;lastClickTick		dc.w	0			;clickCount		dc.L	0			;taskData2		dc.L	0			;taskData3		dc.L	0			;taskData4		dc.L	0			;lastClickPoint		STRING	PASCAL			ENTRY	OpenParamsOpenParams	DC.W  	15			;pcount		ENTRY	RefNumRefNum		DC.W 	 0			;ref num		DC.L  	C1_PathName		;pathname		DC.W  	$0001			;request access		ENTRY	ResourceNumberResourceNumber	DC.W  	0			;resource number		DC.W  	0			;access		DC.W  	0			;file type		DC.L  	0			;aux type		ENTRY	opStorageTypeopStorageType	DC.W  	0			;storage type		DC.L  	0,0			;create date/time		DC.L  	0,0			;mod date/time		DC.L  	0			;option list		ENTRY	DataEOFDataEOF		DC.L  	0			;end of file (bytes)		DC.L  	0			;blocks used		ENTRY	ResourceEOFResourceEOF	DC.L  	0			;resource eof		DC.L  	0			;resource blocks		ENTRY	CloseParamsCloseParams	DC.W  	1			;pcount		ENTRY	cpRefNumcpRefNum	DC.W  	0			;ref. num		ENTRY	DirectParamsDirectParams	DC.W  	12			;pcount		ENTRY	dpRefNumdpRefNum	DC.W  	0			;ref num		DC.W  	0			;flag		ENTRY	dpBasedpBase		DC.W 	 0			;base		ENTRY	dpDispdpDisp		DC.W  	0			;displacement		DC.L  	C1_FileNameBuf		;name ptr		ENTRY	dpEntryNumdpEntryNum	DC.W  	0			;entry number		ENTRY	dpFileTypedpFileType	DC.W  	0			;file typedpEOF		dc.L	0dpBlockCount	dc.L	0dpCTime		dc.L	0,0dpMTime		dc.L	0,0		ENTRY	dpAccess		; access privileges flagsdpAccess	dc.L	0			ENTRY	ReadParamsReadParams	DC.W  	4			;pcount		ENTRY	rpRefNumrpRefNum	DC.W  	0			;ref num		ENTRY	rpDataPtrrpDataPtr	DC.L  	0			;data buffer ptr		ENTRY	rpReqBytesrpReqBytes	DC.L  	0			;request count (bytes)		ENTRY	rpTranBytesrpTranBytes	DC.L  	0			;transfer count (bytes)				ENTRY	StartStackStartStack	DC.W  	0		ENTRY	EntryCountEntryCount	DC.W  	0			;number of directory entries		ENTRY	CurFileCurFile		DC.W  	0		ENTRY	FileCountFileCount	DC.L	0			;number of files on volume		ENTRY	CounterCounter		DC.L	0			;temp counter		ENTRY	AbortFlagAbortFlag	DC.W	0			;flag ­Ê0 means Abort requested		ENTRY	BadFilesBadFiles	DC.L	0			;number of bad files encountered		ENTRY	numRectnumRect		dc.w	5,328,14,410		ENTRY	numRectLeftnumRectLeft	dc.w	5,328,14,410		ENTRY	numRectRightnumRectRight	dc.w	5,328,14,410		ENTRY	nameRectnameRect	dc.w	20,$54,31,364	;first x coordinate gets blasted		ENTRY	thePointthePoint	dc.L	0		ENTRY	LevelParmsLevelParms	dc.w	1			;parameters for get/set level		dc.w	0		ENDP*===============================================** FUNCTION VerifyMedium (pathName: Ptr) : Handle;**===============================================VerifyMedium	PROC	EXPORT		InitFrameerrStrPtr	Local	LongIntvolName		Local	34curBlock	Local	LongIntnextBlock	Local	LongIntbadBlocks	Local	Integer			; count (and index) of bad blocksreqBlocks	Local	Integer			; blocks to read per passtranBytes	Local	LongInt			; bytes actually readreqBytes	Local	LongInt			; bytes to read per passtotalBlocks	Local	LongIntdevName		Local	34devNum		Local	IntegerdevID		Local	IntegerdataPtr		Local	LongInt			; pointer to our summary dataoldDP		Local	IntegerpathName	Param	Ptr			; input parametersdataHand	Result	Handle			; handle to our summary data		IMPORT	GetDeviceNumber		; imported routines		IMPORT	GetVolumeInfo		IMPORT	GetDeviceInfo		IMPORT	GetFileInfo		IMPORT	doAlertWindow		IMPORT	DeviceRead		IMPORT	WToPString		IMPORT	WStringCopy		IMPORT	PStringCopy		IMPORT	NewHandle		IMPORT	HandleToPointer		IMPORT	SizeToString		IMPORT	strBadBlocks		; in string segment		IMPORT	nullStrg		IMPORT	vTaskRecord		IMPORT	WindowGlobalON		IMPORT	WindowGlobalOFF		IMPORT	DrawItemsLeft		import	DisposeHandleGlue		entry	vTaskMaster						tdc				; stash old DP in x		tax				EntryCode;----------------------------------------------Begin		phb		phk		plb		stx	<oldDP			; remember old DP						stz	<curBlock		; start at block 0		stz	<curBlock+2		stz	<badBlocks		; no errors yet		stz	<dataHand		stz	<dataHand+2		lda	#nullStrg		sta	<errStrPtr		lda	#nullStrg>>16		sta	<errStrPtr+2		jsr	GetDeviceStuff		bcs	abort			; fatal error so abort				jsr	InitDialog		; open status dialog		bcs	abortrepeat		clc		lda	<curBlock		; nextBlock <-- curBlock + reqBlocks		adc	<reqBlocks		sta	<nextBlock		lda	<curBlock+2		adc	#0		sta	<nextBlock+2				lda	<totalBlocks		; is totalBlocks ³ nextBlock ?		cmp	<nextBlock		lda	<totalBlocks+2		sbc	<nextBlock+2		bcs	read			; yes, so ok to read		jsr	AdjustBlocks		; no, so adjust for last passread		jsr	ReadBlocks		; read reqBlocks worth of blocks		bcc	ok		jsr	ReadAgain		; try to find the error		bcs	abortok		jsr	RedoDialog		; update status dialog		cmp	#CancelID		; did user cancel ?		beq	abort		lda	<nextBlock		; if curBlock ­ totalBlocks then repeat		sta	<curBlock		ldx	<nextBlock+2		stx	<curBlock+2		cmp	<totalBlocks		bne	Repeat		cpx	<totalBlocks+2		bne	Repeat				jsr	KillDialog		; remove status dialogEnd		plb				ExitCode			; dataHand is returned ;----------------------------------------------abort		jsr	KillDialog		; remove status dialog		lda	<dataHand		; get rid of any summary data		ora	<dataHand+2		beq	mark		PushZLong <dataHand		jsl DisposeHandleGlue		stz	<dataHandmark		lda	#$8000			; mark as "abort"		sta	<dataHand+2		bra	End ;===============================================;	Adjust variables for last pass;===============================================AdjustBlocks		sec		lda	<totalBlocks		; reqBlocks <-- (totalBlocks - curBlock)		sbc	<curBlock		sta	<reqBlocks		sta	<reqBytes		stz	<reqBytes+2		ldx	#9			; reqBytes <-- (reqBlocks * 512)@loop		asl	<reqBytes		rol	<reqBytes+2		dex		bne	@loop		clc		lda	<curBlock		; nextBlock <-- (curBlock + reqBlocks)		adc	<reqBlocks		sta	<nextBlock		lda	<curBlock+2		adc	#0		sta	<nextBlock+2		rts;===============================================;	Read Block by Block to find error;===============================================ReadAgain		PushZLong <reqBytes		; preserve reqBytes		lda	#512		sta	<reqBytes		; read one block only		stz	<reqBytes+2				ldy	<reqBlocks		; re-read each blockreadLoop	phy				jsr	ReadBlocks		bcc	readNext		jsr	BlockError		; handle this error		bcs	readBad		readNext	ply		dey		beq	readDone		inc	<curBlock		bne	readLoop		inc	<curBlock+2		bra	readLoopreadBad		ply		pulllong <reqBytes		sec		rtsreadDone	PullLong <reqBytes		clc		rts		;===============================================;	Handle a block error (a-reg);===============================================BlockError		cmp	#$0027		beq	realError		cmp	#$002D		beq	realError		sec		rts				realError	lda	<badBlocks		inc	a		cmp	#100-2			; we can only handle this many...		bcs	endError		sta	<badBlocks		jsr	DrawError		lda	<dataHand		; do we have a data buffer?		ora	<dataHand+2		bne	saveBlock		pha		pha		pea	400			; space for 100 blocks		jsl	NewHandle		PullLong <dataHand		pha		pha		PushZLong <dataHand		jsl	HandleToPointer		PullLong <dataPtr				lda	#0			; init count to zero		ldy	#2		sta	[<dataPtr]		sta	[<dataPtr],ysaveBlock	lda	<badBlocks		; get index into data		sta	[<dataPtr]		; save count in summary		asl	a		asl	a		tay		lda	<curBlock		; save the block number		sta	[<dataPtr],y		iny		iny		lda	<curBlock+2		sta	[<dataPtr],y		endError	clc		rts;===============================================DrawError		pei	<badBlocks		; unsigned number of bad blocks		pea	strBadBlocks>>16	; bank of string		lda	>strBadBlocks		and	#$00FF			; get length		sec		sbc	#4			; backup 4 chars (for 5 digits)		clc		adc	#strBadBlocks		pha				; offset into end of string		pea	5			; number of digits		pea	0			; value is unsigned		_Int2Dec		lda	#strBadBlocks		sta	<errStrPtr		lda	#strBadBlocks>>16		sta	<errStrPtr+2		rts		;===============================================;	Get information about the device;===============================================GetDeviceStuff		pha				; space for number		PushZLong <pathName		; pointer to pathname		jsl	GetDeviceNumber		PullWord <devNum		bcs	@goEndGDS		PushZWord <devNum		; device number		PushZPtr <devName		; pointer to device name		PushLong #0			; skip characteristics		PushZPtr <totalBlocks		; pointer to total blocks		PushZPtr <devID			; pointer to device ID		jsl	GetDeviceInfo@goEndGDS	bcs	endGDS		PushZPtr <devName		; pointer to device name		pushZPtr <volName		lda	#0		pha		pha		pha		pha				pha		pha		pha		pha		jsl	GetVolumeInfo		bcs	endGDS								lda	<devID			; is it a slow device?		cmp	#DiskII		beq	slowDev		cmp	#Disk3_5		beq	slowDev		cmp	#FloppyDisk		beq	slowDev		cmp	#MFMFloppyDisk		beq	slowDev		lda	#fastBlocks		; set request blocks to 128		ldx	#fastBlocks>>16		bra	doneGDS		slowDev		lda	#slowBlocks		; limit request blocks to 32		ldx	#slowBlocks>>16doneGDS		sta	<reqBlocks		sta	<reqBytes		stx	<reqBlocks+2		stx	<reqBytes+2				ldx	#9			; reqBytes <-- (reqBlocks * 512)@loop		asl	<reqBytes		rol	<reqBytes+2		dex		bne	@loop		clc		endGDS		rts;===============================================;	Read blocks from the device;===============================================ReadBlocks		pha				; space for result		pha		PushZWord <devNum		; our device number		PushLong #DataBuffer		; pointer to read buffer		PushZLong <reqBytes		; number of bytes to read		PushZLong <curBlock		; starting block number		pea	512			; block size of our device		jsl	DeviceRead		plx		stx	<tranBytes		; bytes actually transfered		plx		stx	<tranBytes+2		rts				; A has error		;===============================================;	Startup feedback dialog box;===============================================		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCMInitDialog	pushZLong <pathname		pushlong #c1_pathname		jsl	WStringCopy					lda	>c1_pathname		and	#$00ff		dec 	a		xba		sta	>c1_pathname+1						jsl	WindowGlobalON				pha		pha		pushlong #0			;titlePtr		pushlong #0			;refCon is ptr to our window info block		pushlong #verifyRedraw+$C0000000 ;content draw proc		pushlong #0			;window defproc		pea	2			;refIsResource		pushlong #$f			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2		jsl	WindowGlobalOFF		pulllong verifyWindowPtr		bcc	@openOK	;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	verifyWindowPtr+1		beq	@leave @done		lda	verifyWindowPtr		ldx	verifyWindowPtr+2		jsl	CloseThisWindow@leave		sec		rts;; cool.  we got the resources we needed and have a window -- so set everyone's control values before; anything gets drawn;@openOK				pha		pha		_GetPort		pulllong OurPort				pushlong verifyWindowPtr		_SetPort		pha		pha		pushlong verifyWindowPtr		pushlong #3		_GetCtlHandleFromID		ply		plx		pea	0		pea	280			;max value for dial		phx		phy		_SetCtlTitle			;set the scale				lda	<TotalBlocks+2		ldx	<TotalBlocks		jsr	DrawItemsLeft@getDisk	pushlong verifyWindowPtr		_BeginUpdate				jsl	verifyRedraw					pushlong verifyWindowPtr		_EndUpdate		pushZPtr <volName		lda	#0		pha				; access pointer		pha				pha				; filetype pointer		pha				pha				; auxtype pointer		pha				pha				; storagetype pointer		pha				pha				; create date pointer		pha				pha				; mod date pointer		pha				pha				; bytes pointer		pha				pha				; blocks pointer		pha				pha				; file system pointer		pha		jsl	GetFileInfo		bcc	@noSkip				cmp	#$45		bne	@error				lda	#rasInsertDiskOrCancel		jsl	doAlertWindow		pla		bne	@getDisk@error		sec		rts@noskip		clc		rts;; verify window content update routine;verifyRedraw	phb		phk		plb		pushlong verifyWindowPtr		_DrawControls				plb		rtl;; locals;verifyWindowPtr	dc.L	0ourPort		dc.L	0		;===============================================;	Update the feedback dialog box;===============================================RedoDialog	jsr	ScaleValue				pha		pha		pha		pushlong verifyWindowPtr		pushlong #3		_GetCtlHandleFromID		_SetCtlValue				lda	<TotalBlocks		sec		sbc	<nextBlock		tax		lda	<TotalBlocks+2		sbc	<NextBlock+2		jsr	DrawItemsLeft		@loop;		pha				; space for result;		pea	$056E			; event mask;		pushlong #vTaskRecord;		_TaskMaster;		pla*** 12-Jun-92 DAL		jsr vTaskMaster*** end 12-Jun-92		beq	@done				cmp	#6			;wInUpdate		beq	@done				cmp	#$21			;wInControl		bne	@loop		lda	vTaskRecord+$26		;wmTaskData4		cmp	#4		bne	@loop		lda	vTaskRecord+$26+2		bne	@loop				lda	#CancelID		rts		@done		lda	#0		rts;; vTaskMaster--call TaskMaster and turn Command-period into Esc;vTaskMaster	pha				; space for result		pea	$056E			; event mask		pushlong #vTaskRecord		_TaskMaster; If it's a Command-period, make it an Esc		lda vTaskRecord		cmp #keyDownEvt		bne @notCmdPeriod		lda vTaskRecord+2		cmp #'.'		bne @notCmdPeriod		lda vTaskRecord+14		;modifiers		and #appleKey		beq @notCmdPeriod		lda #27		sta vTaskRecord+2; use TaskMaster result space for SendEventToCtl result		pea 0				;targetOnly = false		pha		pha		_FrontWindow		pushlong #vTaskRecord		_SendEventToCtl		pla		beq @rts		lda #$21			;wInControl		rts@notCmdPeriod	pla@rts		rts;===============================================;	Remove the feedback dialog box;===============================================		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCMKillDialog	pushlong ourPort		_SetPort		lda	verifyWindowPtr		ldx	verifyWindowPtr+2		jsl	CloseThisWindow		rts;; ScaleValue -- scale the number of blocks to 100% (Actually, # of parts per 280);;		 NumItems is how many blocks we've both read and written so far;		 SrcSize*2 is the total number of blocks which have to be both read and written;; IN: 'nextblock' contains # of blocks done so far;     'totalBlocks' contains # of blocks total;; OUT: (A) contains value of counter/filecount scaled to parts per 280 pixels (width of thermo);.....................................................................ScaleValue	pha		pha		pha		pha		pushZLong <NextBlock		;multiply the numerator by 280 to get parts per 280		pushlong #280		_LongMul		pla		plx		ply		ply		pha		pha		pha		pha		phx				;numerator		pha						pushZLong <TotalBlocks		;denominator		_LongDivide		pla						ply				;quotient		ply						ply				;remainder		rts		ENDP;; DrawItemsLeft -- draw the number of items left;; IN: (A) = high word of count to display;     (X) = low word of count to display;.....................................................................drawItemsLeft	PROC	EXPORT			IMPORT	sizeToString		pushlong #numberStr		pha		phx		pea	0			;plain		pea	512			;blocksize (doesn't matter)		jsl	SizeToString				pha		pushlong #numberStr		_StringWidth		pla		lsr	a		sta	numberWidth		lda	#369			;find the left side of the number		sec		sbc	numberWidth		sta	numRectLeft+6		pushlong #numRectLeft		;erase from the left edge to the left side of the number		_EraseRect		lda	numRectLeft+6		pha		pea	13		_MoveTo		pushlong #numberStr		;draw the number		_DrawString				pushlong #thePoint		;erase from the right side of the number to the end of		_GetPen				;our old rectangle				lda	thePoint+2		sta	numRectRight+2		pushlong #numRectRight		_EraseRect		rts		ENDP		*===============================================** 	   Validate a File System		**						** - Does a recursive file by file validation	**						** In:	C1_PathName (in file data.aii)		**						** Out:	ptr to summary data or nil		**	carry flag is set if there is data	**===============================================*ValidateFile	PROC	EXPORT		IMPORT	C1_source		IMPORT	WToPString		IMPORT	PathGetName		IMPORT	ANameTooLong		; Mensch 06/05/89 Fixing BRC #50354		IMPORT	doAlertWindow		IMPORT	finderTaskRecord		IMPORT	SizeToString		IMPORT	WindowGlobalON		IMPORT	WindowGlobalOFF		IMPORT	WatchCursor		IMPORT	ArrowCursor		IMPORT	DrawItemsLeft		IMPORT	strValidate		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		phb		phk		plb		stz	BadFiles		stz	AbortFlag		stz	FileCount		lda 	#0		sta 	>ANameTooLong						PushLong #C1_FileName		PushLong #C1_PathName		jsl	PathGetName		;get name of "root"		pushlong #c1_filename		pushlong #c1_source+1		jsl	WToPString				jsl	WindowGlobalON				pha		pha		pushlong #0			;titlePtr		pushlong #0			;refCon is ptr to our window info block		pushlong #validRedraw+$C0000000	;content draw proc		pushlong #0			;window defproc		pea	2			;refIsResource		pushlong #$10			;window resource we want		pea	$800e			;rWindParam1		_NewWindow2		jsl	WindowGlobalOFF		pulllong validWindowPtr		bcc	@openOK	;; close the window only if something bad happened and we actually have a window pointer; because something could have happened when we went to add controls (but didn't; get created because we couldn't find the disk or the resource);		lda	validWindowPtr+1		beq	@leave @done		lda	validWindowPtr		ldx	validWindowPtr+2		jsl	CloseThisWindow@leave		sec		plb		rtl;; cool.  we got the resources we needed and have a window -- so set everyone's control values before; anything gets drawn;@openOK		pha		pha		_GetPort		pulllong ourPort				pushlong validWindowPtr		_SetPort				pushlong validWindowPtr		_BeginUpdate				jsl	validRedraw			ldx	#0			;say zero files to copy		txa		jsr	DrawItemsLeft		pea	15			;Reading: <filename>		pea	30		_MoveTo		pushlong #strValidate		;"Preparing to validate..."		_DrawString				pushlong validWindowPtr		_EndUpdate		_GetLevelGS LevelParms		inc	LevelParms+2		;next level, sir		_SetLevelGS LevelParms;; Now that the dialog has been drawn, make preparing to validate actually work...;		pha		pushlong #0		_WaitUntil		pla		sta	lastTick		jsr	CountFiles		bcc	@okCount				jsr	SetPortClose		lda	BadFiles		beq	done		brl	badFile		@okCount	pha				;wait at least half a second for this to register in the		lda	lastTick		;user's eyeball		pha		pea	$0200			;30+ ticks, ~half a second		_WaitUntil		pla		pha		pha		pushlong validWindowPtr		pushlong #3		_GetCtlHandleFromID		ply		plx		pea	0		pea	280			;max value for dial		phx		phy		_SetCtlTitle			;set the scale		lda	badfiles		beq	startRead		brl	badFile			;error while countingstartRead	jsr	ReadFiles		jsr	SetPortClose				lda	AbortFlag		bne	done			;user selected 'Cancel'		lda	BadFiles		bne	badfilegoodFile	pea	$C005			;task accomplished		_SysBeep2		PushLong #C1_FileName		PushLong #C1_PathName		jsl	PathGetName		;get name of "root"			lda	#rasValidGood		jsl	doAlertWindow		done		dec	LevelParms+2		;next level down, sir		_SetLevelGS LevelParms				lda	<handle		ldx	<handle+2				ldy	BadFiles		cpy	#1			;return carry flag		plb		rtl					badFile	 	jsr	SetPortClose		lda	#rasValidBad		jsl	doAlertWindow		bne	done			;OK selected		stz	BadFiles		;cancel was selected 		bra	done;; SetPortClose -- set the port to our old port and close the window;SetPortClose	lda	validWindowPtr+1		beq	@done				pushlong ourPort		_SetPort		lda	validWindowPtr		ldx	validWindowPtr+2		jsl	CloseThisWindow				stz	validWindowPtr+1@done		rts		;; redraw the validate window;validRedraw	phb		phk		plb		pushlong validWindowPtr		_DrawControls				plb		rtl;; locals;		EXPORT	validWindowPtrvalidWindowPtr	dc.L	0ourPort		dc.L	0lastTick	dc.w	0		ENDP;; ScaleThermo -- scale the number of blocks to 100% (Actually, # of parts per 280);;		 NumItems is how many blocks we've both read and written so far;		 SrcSize*2 is the total number of blocks which have to be both read and written;; IN: 'counter' contains # of files done so far;     'fileCount' contains # of files total;; OUT: (A) contains value of counter/filecount scaled to parts per 280 pixels (width of thermo);.....................................................................ScaleThermo	PROC	EXPORT		pha		pha		pha		pha		pushlong counter		;multiply the numerator by 280 to get parts per 280		pushlong #280		_LongMul		pla		plx		ply		ply		pha		pha		pha		pha		phx				;numerator		pha						pushlong fileCount		;denominator		_LongDivide		pla						ply				;quotient		ply						ply				;remainder		rts*===============================================**	   	Read Files			** - Reads the data of each file from the "root"	**						* * INPUT:	none				**						** OUTPUT:	none				*	*						**===============================================*ReadFiles	PROC		IMPORT	C1_source		IMPORT	WToPString		IMPORT	PathSubName		IMPORT	PathAddName		IMPORT	PathGetName		IMPORT	SizeToString		IMPORT	validWindowPtr		IMPORT	vTaskRecord		stz	Counter		stz	Counter+2				tsc		sta	StartStack		;remember for recursion					lda	#<DataBuffer		;set up data buffer		sta	rpDataPtr		lda	#DataBuffer>>16		sta	rpDataPtr+2		doOpen		stz	ResourceNumber		;open data fork		_OpenGS	OpenParams		;open the file		bcc	cont1	;		; If the open failed, we should mark this guy as never opened.; Previously, this was not the case.;		lda	#$FFFF		sta	opStorageType		; flag as never opened;; Insert test here to see if the error was access privilege.  If so, then assume; it must be meant not to be read and do not count the error.  Instead, just skip; to the next file in the chain.;		cmp	#$4E			; access error!		beq	cont1			; so don't count it		jsr	errorHandcont1		lda	FileCount		beq	@abort2		sec		sbc	Counter		bcs	@noAbort@abort2		brl	abort			; overflow !!@noAbort	jsr	showValidCount				inc	Counter		bne	@loop		inc	Counter+2		@loop;		pha				; space for result;		pea	$056E			; event mask;		pushlong #vTaskRecord;		_TaskMaster;		pla*** 12-Jun-92 DAL		jsr vTaskMaster*** end 12-Jun-92		beq	check				cmp	#6			;wInUpdate		beq	check				cmp	#$21			;wInControl		bne	@loop		lda	vTaskRecord+$26		;wmTaskData4		cmp	#4		bne	@loop		lda	vTaskRecord+$26+2		bne	@loop				lda	#CancelID@abort		brl	abortcheck		lda	opStorageType		;check for a directory		cmp	#$0F		beq	directory		cmp	#$0D		beq	directory		cmp	#$FFFF		bne	else		brl	terminate		;was never opened!else		brl	file			;just a filedirectory	lda	RefNum		sta	dpRefNum		stz	dpBase		stz	dpDisp				_GetDirEntryGS DirectParams	;get number of entries		bcc	cont2		jsr	errorHand		bra	doClose			;don't continue from here...cont2		lda	#1		sta	CurFile			;start at first entry		lda	dpEntryNum		sta	EntryCount		beq	doClose			;no files to check	while						;loop for each file entry		lda	RefNum		sta	dpRefNum		stz	dpBase		lda	CurFile		sta	dpDisp		_GetDirEntryGS DirectParams		bcc	cont3		jsr	errorHand		bra	doClose			;don't continue from here...	cont3; Test here for entries that are not read-access.  If we get one, then simply; ignore it and go to the next file.		lda	dpAccess		; get the file access privileges		lsr	a		bcs	@GoodEntry		; carry set means it should be OK to read		bra	contWhile		; else just skip this guy@GoodEntry		PushLong #C1_FileName		PushLong #C1_PathName		jsl	PathAddName		bcs 	contwhile		lda	RefNum			;save for recursion		pha		lda	CurFile		pha		lda	EntryCount		pha		brl	doOpen			;start recursioncontWhile	lda	CurFile			;return from recursion		cmp	EntryCount		bcs	doClose			;end of loop		inc	CurFile		bra	while	file		jsr	DoRead			;read the file		bcc	doClose		jsr	errorHanddoClose		lda	AbortFlag		beq	@noAbort		brl	abort@noAbort	lda	RefNum		sta	cpRefNum		_CloseGS CloseParams		;close the fileterminate	PushLong #C1_PathName		;remove file from path		jsl	PathSubName		tsc				;check for termination		cmp	StartStack		beq	done		PullWord EntryCount		;data from recursion		PullWord CurFile		PullWord RefNum		bra	contWhile		;continue where we left off!done		lda	fileCount		sta	Counter		lda	fileCount+2		sta	Counter+2		jsr	showValidCount	exit		rts;; abort the whole thing;abort		lda  	StartStack		;reset stack pointer		tcs		stz	cpRefNum		_CloseGS CloseParams		;close all files		lda	#$FFFF		sta	AbortFlag		lda	#0		clc		bra	exit			;go home;; handle the error;errorHand	cmp	#$004E			;read-protected		beq	openErr		cmp	#$0050			;file is open		beq	openErr		bra	Add1BadFile				lda  	StartStack		;reset stack pointer		tcs		stz	cpRefNum				_CloseGS CloseParams		;close all files		bra	exit			;go homeopenErr		lda	#$FFFF		sta	opStorageType		;mark as not opened;; Add 1 Bad file name to our bad file buffer which has the format;; +0       = word, # of entries; +2       = pstring #1; +32+2    = pstring #2, etc.;		IMPORT	NewHandle		ENTRY	Add1BadFileAdd1BadFile				lda	BadFiles		bne	@haveBadFiles				pha		pha		pea	#32+2			;# of files+name of this file+this entry		jsl	NewHandle		pla		sta	<handle		pla		sta	<handle+2				lda	#32		sta	<ptr2		stz	<ptr2+2		bra	@gotHandle		@haveBadFiles	lda	BadFiles		inc	a		sta	<ptr2		stz	<ptr2+2				ldx	#4@rLoop		asl	<ptr2		rol	<ptr2+2		dex		bpl	@rLoop		lda	<ptr2		clc		adc	#2		tax		lda	<ptr2+2		adc	#0		pha		phx		pushZLong <handle		_SetHandleSize@gotHandle	inc	BadFiles				lda	<ptr2		;backtrack 32-2 bytes		sec		sbc	#30		sta	<ptr2		lda	<ptr2+2		sbc	#0		sta	<ptr2+2				lda	[<handle]		sta	<ptr		ldy	#2		lda	[<handle],y		sta	<ptr+2				lda	BadFiles		sta	[<ptr]				lda	<ptr		clc		adc	<ptr2		sta	<ptr2		lda	<ptr+2		adc	<ptr2+2		sta	<ptr2+2						lda	>c1_filename		tax		tay				sep	#$20		LONGA	OFF		txa		sta	[<ptr2]			;save the length byte		@copy		lda	>c1_filename+1,x		sta	[<ptr2],y		dey		dex		bne	@copy				rep	#$20		LONGA	ONerrorEnd	rts;; showValidCount -- display the number of items, etc;.....................................................................showValidCount			IMPORT	strgReading				jsr	ScaleThermo				pha		pha		pha		pushlong validWindowPtr		pushlong #3		_GetCtlHandleFromID		_SetCtlValue			;set the thermo dial		lda	fileCount		sec		sbc	counter		tax		lda	fileCount+2		sbc	counter+2		jsr	DrawItemsLeft			;say how many left		;; now just redraw the file's name which we're verifying;		pea	15			;Reading: <filename>		pea	30		_MoveTo		pushlong #strgReading		_DrawString		lda	>c1_filename		xba		sta	>c1_filename				pushlong #c1_filename+1		_DrawString				lda	>c1_filename		xba		sta	>c1_filename				pushlong #thePoint		;finally, erase to the end of the rectangle		_GetPen		lda	thePoint+2		sta	nameRect+2				pushlong #nameRect		_EraseRect				rts		ENDP	*===============================================**		Read a File			** 						** INPUT:	none				**						** OUTPUT:	GS/OS ErrorCode (A-Reg)		*	*		carry (set on error)		*	*						**===============================================*DoRead		PROC				lda	DataEOF		sta	bytes		lda	DataEOF+2		sta	bytes+2		stz	whichFork		;data fork		loop;		pha				; space for result;		pea	$056E			; event mask;		pushlong #vTaskRecord;		_TaskMaster;		pla*** 12-Jun-92 DAL		jsr vTaskMaster*** end 12-Jun-92		beq	@done				cmp	#6			;wInUpdate		beq	@done				cmp	#$21			;wInControl		bne	loop		lda	vTaskRecord+$26		;wmTaskData4		cmp	#4		bne	loop		lda	vTaskRecord+$26+2		bne	loop		lda	#CancelID		brl	abort		@done		lda	bytes		ora	bytes+2		bne	@notDone				lda	whichFork		bne	@goDone		lda	opStorageType		cmp	#5		beq	@resourceFork@goDone		brl	done		@resourceFork	lda	refNum		sta	cpRefNum		_CloseGS CloseParams				lda	#1		sta	ResourceNumber		sta	whichFork		_OpenGS OpenParams		bcs	exit				lda	ResourceEOF		sta	bytes		lda	ResourceEOF+2		sta	bytes+2		@notDone	lda	bytes		cmp	#<buffSize		;4-byte compare		lda	bytes+2		sbc	#buffSize>>16		bcc	lastOne			;EOF < buffSize				lda	#<buffSize		;ReqBytes <-- buffSize		sta	rpReqBytes		lda	#BuffSize>>16		sta	rpReqBytes+2				lda	bytes			;EOF <-- (EOF - buffSize)		sec		sbc	#<buffSize		sta	bytes		lda	bytes+2		sbc	#buffSize>>16		sta	bytes+2		bra	readlastOne		lda	bytes			;ReqButes <-- EOF		sta	rpReqBytes		lda	bytes+2		sta	rpReqBytes+2				stz	bytes			;EOF <-- 0		stz	bytes+2read		lda	RefNum		sta	rpRefNum				_ReadGS	ReadParams		;read the file		bcs	exit			;error occured		brl	loopdone		lda	#0			;okay		clcexit		stz	ResourceNumber		rts	abort		lda	#$FFFF		sta	AbortFlag		bra	done;; locals;bytes		dc.L	0whichFork	dc.w	0		ENDP	*===============================================**		Count Files			** - Counts the number of files/folders below	**   the current "root".				** 						** INPUT:	none				**						** OUTPUT:	carry set on error		*	*						**===============================================*CountFiles	PROC				IMPORT	PathSubName		IMPORT	PathAddName			tsc		sta	StartStack		;remember for recursion			lda	#1			;count the "root"		sta	FileCount		;initialize counter		stz	FileCount+2		jsr	OpenFile		;open the first file		bcc	cont1		brl	errorcont1		lda	opStorageType		cmp	#$000D			;directory file?		beq	cont2		cmp	#$000F			;root directory file?		beq	cont2		brl	doClosedoOpen		jsr	OpenFile		;open the file		bcc	cont2		brl	error	cont2		ldx	#0			;base <-- 0		lda	#0			;displacement <-- 0		jsr	GetDirEntry		;get number of entries		bcc	cont3		brl	errorcont3				lda	#1		sta	CurFile			;start at first entry		lda	dpEntryNum		sta	EntryCount		beq	doClose			;no files to check		clc		adc	FileCount		sta	FileCount		lda	#0		adc	FileCount+2		sta	FileCount+2				ldx	FileCount		lda	FileCount+2		jsr	DrawItemsLeft		while						;loop for each file entry		ldx	#0			;base <-- 0		lda	CurFile			;displacement <-- CurFile		jsr	GetDirEntry		bcs	error				lda	dpFileType		;don't open regular files		cmp	#$0F		bne	contWhile;		; Modified to check a directory's privileges before adding it to the list.; If the directory does not support read access then no need to recurse and; its entry need not be added to the list.;		lda	dpAccess		; get the access word		lsr	a			; put access bit into carry		bcs	directory		; carry set means we can read it		bra	contWhile		; otherwise, skip him	;; first test to see if we can add this file name and make it longer;directory	PushLong #C1_FileName		PushLong #C1_PathName		jsl	PathAddName		bcc 	@CanRecurse		; if carry clear then no error;; If we execute the following code, its because we can not add the pathname,; so recursion must now stop!;		lda 	#$FFFF			; flag a name too long occured		sta 	>ANameTooLong		bra 	contwhile@CanRecurse		lda	RefNum			;save for recursion		pha		lda	CurFile		pha		lda	EntryCount		pha		brl	doOpen			;start recursioncontWhile	lda	CurFile			;return from recursion		cmp	EntryCount		bcs	doClose			;end of loop		inc	CurFile		bra	whiledoClose		lda	RefNum			;close file(refNum)		jsr	CloseFile		bcs	error		tsc				;check for termination		cmp	StartStack		beq	done		PushLong #C1_PathName		jsl	PathSubName			PullWord EntryCount		;data from recursion		PullWord CurFile		PullWord RefNum		bra	contWhile		;continue where we left offdone		clcexit		rts	;; Bad news, and we are outta here!;error		lda	StartStack		tcs		sec		rts				EXPORT	ANameTooLongANameTooLong	ds.W 1		ENDP	*===============================================**	Open up a file				**===============================================*OpenFile	PROC		stz	ResourceNumber		_OpenGS	OpenParams		bcc	exit		jsr	GSOSError		bcc	OpenFile		;try againexit		rts				ENDP		*===============================================**	Close up a file				**===============================================*CloseFile	PROC		sta	cpRefNum		;A-reg has ref number				_CloseGS CloseParams		bcc	exit		jsr	GSOSError		bcc	CloseFile		;try againexit		rts		ENDP		*===============================================**	Read a directory entry			**===============================================*GetDirEntry	PROC		stx	dpBase			; X-reg has base		sta	dpDisp			; Y-reg has displacement		lda	RefNum			; use refnum from OPEN		sta	dpRefNum				_GetDirEntryGS DirectParams		bcc	exit		jsr	GSOSError		bcc	GetDirEntry		;try againexit		rts				ENDP				*===============================================**	Handle a GS/OS error			**===============================================*GSOSError	PROC		IMPORT	C1_source		IMPORT	PathGetRoot		IMPORT	C1_PathNamePtr		IMPORT	doAlertWindow				cmp	#$45			;volume offline?		beq	InsertDisk		jsr	Add1BadFile				sec		rtsInsertDisk	lda	#rasInsertDiskOrCancel		jsl	doAlertWindow				pla		bne	@noskip		sec		rts@noskip		clc		rts		ENDP*===============================================**	Draw the guts of a Verify Window	**===============================================*GetVerifyGuts	PROC	EXPORT		InitFramevTemp		Local	Ptrstring		Local	10yPos		Local	Integercount		Local	IntegerdataHand	Local	Handle			; handle to our summary datadataPtr		Local	Ptr			; pointer to our summary data		IMPORT	HandleToPointer		IMPORT	UnlockHandle		EntryCode;----------------------------------------------Begin				lda	#8		sta	<yPos				lda	#8		sta	<string			; set length of Pascal string		pha				; space for refCon		pha		pha				; space for window ptr		pha		_GetPort		_GetWRefCon		PullLong <vTemp			; pointer to window info block		ldy	#windUsed		lda	[<vTemp],y		; get handle to summary data		sta	<dataHand		iny		iny		lda	[<vTemp],y		sta	<dataHand+2				pha		pha		PushZLong <dataHand		jsl	HandleToPointer		PullLong <dataPtr		; pointer to summary data				lda	[<dataPtr]		; header has count of bad blocks		sta	<count@loop		lda	<count		asl	a		asl	a		tay		lda	[<dataPtr],y		tax		iny		iny		lda	[<dataPtr],y		pha				; bad block number		phx		PushZPtr <string+1		; where to store string		pea	8			; number of bytes in output string		pea	0			; unsigned		_Long2Dec		pea	10			; horizontal offset		pei	<yPos			; vertical offset			_MoveTo			PushZPtr <string		_DrawString				lda	<yPos		clc		adc	#9		sta	<yPos		dec	<count		bne	@loop				PushZLong <dataHand		; unlock summary data handle		jsl	UnlockHandleEnd;-----------------------------------------------		ExitCode		ENDP*===============================================**	Draw the info bar in Verify window	**===============================================*GetVerifyInfo	PROC	EXPORT		InitFramedataHand	Local	Handle			; handle to our summary datadataPtr		Local	Ptr			; pointer to our summary datasLen1		Local	IntegersLen2		Local	Integerwidth		Local	IntegertheWindow	Param	PtrinfoRefCon	Param	PtrinfoRectPtr	Param	Ptr		IMPORT	HandleToPointer		IMPORT	UnlockHandle		IMPORT	PStringCat		IMPORT	strBlkNumbers		IMPORT	strTotal		IMPORT	tempStrg1				EntryCode;----------------------------------------------Begin				lda	#5		sta	>tempStrg1		; set length of Pascal string		ldy	#x1			; set position of text		lda	[<infoRectPtr],y		clc		adc	#10		pha				; horizontal offset		lda	[<infoRectPtr]		clc		adc	#8		pha				; vertical offset		_MoveTo			PushLong #strBlkNumbers		_DrawString			; draw "Block numbers"				ldy	#windUsed		; get handle to summary data		lda	[<infoRefCon],y		sta	<dataHand		iny		iny		lda	[<infoRefCon],y		sta	<dataHand+2		pha		pha		PushZLong <dataHand		jsl	HandleToPointer		PullLong <dataPtr		; pointer to summary data		lda	[<dataPtr]		; header has count of bad blocks		pha		PushLong #tempStrg1+1		; where to store string		pea	5			; number of bytes in output string		pea	0			; unsigned		_Int2Dec		PushLong #strTotal		; add in "Total"		PushLong #tempStrg1		jsl	PStringCat		ldy	#x2		lda	[<infoRectPtr],y		ldy	#x1		sec		sbc	[<infoRectPtr],y		sta	<width			; Info bar's width		pha		PushLong #strBlkNumbers		_StringWidth					pla		sta	<sLen1			; 1st string's width		pha		PushLong #tempStrg1		_StringWidth		pla		sta	<sLen2			; 2nd string's width		clc		adc	<sLen1		adc	#40			; space between them		cmp	<width		bcc	leftJust		lda	<sLen1		clc		adc	#20		bra	moveleftJust	lda	<width		sec		sbc	<sLen2		sbc	#10move		ldy	#x1			; set position of text		clc		adc	[<infoRectPtr],y		pha				; horizontal offset		lda	[<infoRectPtr]		clc		adc	#8		pha				; vertical offset		_MoveTo		PushLong #tempStrg1		_DrawString			; draw "12345 total"		PushZLong <dataHand		; unlock summary data handle		jsl	UnlockHandleEnd;-----------------------------------------------		ExitCode		ENDP*===============================================**	Draw the guts of a Validate Window	**===============================================*GetValidGuts	PROC	EXPORTvTemp		equ	1			;stack/dp offsetsvCount		equ	vTemp+4yPos		equ	vCount+2vHandle		equ	yPos+2		phb		phk		plb		phd				pha				;temp workspace		pha		pha		pha		pha		pha				tsc		tcd		lda	#8		sta	<yPos				pha				;find out which window this is.		pha		_GetPort		pla		plx				pha				;space for result		pha		phx		pha		_GetWRefCon		pla		sta	<vTemp		pla		sta	<vTemp+2		ldy	#windUsed		lda	[<vTemp],y		;get pointer to data buffer		tax		iny		iny		lda	[<vTemp],y		sta	<vHandle+2		stx	<vHandle				ldy	#4		lda	[<vHandle],y		ora	#$8000		sta	[<vHandle],y				lda	[<vHandle]		tax		ldy	#2		lda	[<vHandle],y		sta	<vTemp+2		stx	<vTemp				lda	[<vTemp]		;header has count of bad blocks		sta	<vCount				lda	<vTemp		clc		adc	#2		sta	<vTemp		bcc	@loop		inc	<vTemp+2;; draw all of the bad filenames 1 per every 32 bytes excluding the 2 byte header;@loop		pea	10			;horizontal offset		pei	<yPos			;vertical offset			_MoveTo			PushZLong <vTemp		_DrawString		lda	<vTemp		clc		adc	#32		sta	<vTemp		bcc	@nr		inc	<vTemp+2@nr				lda	<yPos		clc		adc	#9		sta	<yPos				dec	<vCount		bne	@loop		;; done, we're outta here;		ldy	#4		lda	[<vHandle],y		and	#$7fff		sta	[<vHandle],y				pla				;clean up		pla		pla		pla		pla		pla		pld		plb		rtl		ENDP*===============================================**	Draw the info bar in Validate window	**===============================================*GetValidInfo	PROC	EXPORT		IMPORT	ValidateCountString		IMPORT	ValidateFileString		theWindow	equ	6infoRefCon	equ	theWindow+4infoRect	equ	infoRefCon+4		phd				;setup 		tsc		tcd		phb		phk		plb		ldy	#x1			;Set position of text.		lda	[<infoRect],y		clc		adc	#10		pha				;horizontal offset		lda	[<infoRect]		clc		adc	#8		pha				;vertical offset		_MoveTo			PushLong #validateFileString		_DrawString			ldy	#windUsed		lda	[<infoRefCon],y		sta	<theWindow		;use theWindow as scratch space		iny		iny		lda	[<infoRefCon],y		sta	<theWindow+2		lda	[<theWindow]		tax		ldy	#2		lda	[<theWindow],y		sta	<theWindow+2		stx	<theWindow				lda	[<theWindow]		;header has count of bad blocks				pha				;Number of bad files.		PushLong #ValidateCountString+1	;where to store string.		pea	5			;length of output string.		pea	0			;unsigned.		_Int2Dec		ldy	#x2		lda	[<infoRect],y		ldy	#x1		sec		sbc	[<infoRect],y		sta	width			;Info bar's width		pha		PushLong #validateFileString		_StringWidth					pla		sta	sLen1			;1st string's width		pha		PushLong #validateCountString		_StringWidth		pla		sta	sLen2			;2nd string's width		clc		adc	sLen1		adc	#40			;space between them		cmp	width		bcc	leftJust		lda	sLen1		clc		adc	#20		bra	moveleftJust	lda	width		sec		sbc	sLen2		sbc	#10move		ldy	#x1			;Set position of text.		clc		adc	[<infoRect],y		pha				;horizontal offset		lda	[<infoRect]		clc		adc	#8		pha				;vertical offset		_MoveTo		PushLong #validateCountString		_DrawStringexit		plb				;Clean up and exit			pld		lda	2,s		sta	14,s		lda	0,s		sta	12,s		tsc		clc		adc	#12		tcs		rtlsLen1		DC.W	0sLen2		DC.W	0width		DC.W	0		ENDP		END