."};resource rComment(1) {	"by Dave “Mr Tangent” Lyons\n"	"and Jim “Whoops!” Murphy\n"};/*resource rComment(1) {	"by Dave “Mr Tangent” Lyons\n\n"	"“After using EasyMount for a little while, I’ve decided that it’s "	"really cool.”\n"	"                                                   —Andy Nicholas"	"\n\n"	"“For the school environment, EasyMount is the hottest thing since "	"safe sex.\n"	"                                                    —Ron Lichty"};*/resource rComment(2) {	"To use EasyMount, put it in the System.Setup folder "	"inside your System folder.  The next time you start your system, "	"you will be able to double-click on EasyMount alias documents, "	"and “Make Alias…” will appear in the Finder’s Extras menu."};resource rIcon (1) {		0x8000,							/* Kind */		20,								/* Height */		28,								/* Width */		$"FFFFFFFFFFFF0FFF000000FFFFFF"		$"FFFFFFFFFFF0a0FF0FFFF00FFFFF"		$"FFFF000FFF0aaa0F0FDDD000FFFF"		$"FFF0eee000000aa00FDDFFF0FFFF"		$"FFF0eeeeeeee0aaa0FDDDDF0FFFF"		$"FFF0eeeeeeee0aaaa0FFFFF0FFFF"		$"FFF0eeeeeeee0aaa0FDDDFF0FFFF"		$"FFF0eeeeeeee00a00FFFFFF0FFFF"		$"FFF0000000000F0F00000000FFFF"		$"FCCCCCCCCCCCCCCCCCCCCCCCCCFF"		$"FFCCCCCCCCCCCCCCCCCCCCCCCFFF"		$"FFFFFFF0F0F0F0FF0F0FFFFFFFFF"		$"FFFFFFFF0F0F0F0F0F0FFFFFFFFF"		$"FFFFFFFFF0F0FFF00F0FFFFFFFFF"		$"FFFFFFFFFF00FFFFFF0FFFFFFFFF"		$"FFFFFFFFFFFF0FFFFF0FFFFFFFFF"		$"FFFFFFFFFFF000000000FFFFFFFF"		$"FFFFFFFFFFF0DDDDDDD0FFFFFFFF"		$"FFFFFFFFFFF0D0DDDDD0FFFFFFFF"		$"FFFFFFFFFFF0DDDDDDD0FFFFFFFF",		$"000000000000F000FFFFFF000000"		$"00000000000FFF00FFFFFFF00000"		$"0000FFF000FFFFF0FFFFFFFF0000"		$"000FFFFFFFFFFFFFFFFFFFFF0000"		$"000FFFFFFFFFFFFFFFFFFFFF0000"		$"000FFFFFFFFFFFFFFFFFFFFF0000"		$"000FFFFFFFFFFFFFFFFFFFFF0000"		$"000FFFFFFFFFFFFFFFFFFFFF0000"		$"000FFFFFFFFFFFFFFFFFFFFF0000"		$"0FFFFFFFFFFFFFFFFFFFFFFFFF00"		$"00FFFFFFFFFFFFFFFFFFFFFFF000"		$"0000000FFFFFFFFFFFF000000000"		$"00000000FFFFFFFFFFF000000000"		$"000000000FFFFFFFFFF000000000"		$"0000000000FFFFFFFFF000000000"		$"000000000000FFFFFFF000000000"		$"00000000000FFFFFFFFF00000000"		$"00000000000FFFFFFFFF00000000"		$"00000000000FFFFFFFFF00000000"		$"00000000000FFFFFFFFF00000000";};// --- Control List Definitionsresource rControlList (CTLLST_00000E02, $0000) {       {       CTLTMP_00000001,        // control 1       CTLTMP_00000002,        // control 2       CTLTMP_00000003,        // control 3       CTLTMP_00000004,        // control 4       CTLTMP_00000005,        // control 5       CTLTMP_00000007,        // control 7	   CTLTMP_00000006,        // control 6       CTLTMP_00000008,        // control 8       CTLTMP_00000009,        // control 9       CTLTMP_0000000A,        // control 10       CTLTMP_0000000B,        // control 11       };};// Save button = 1resource rControlTemplate (CTLTMP_00000001, $0000) {       $00000001,              // ID       {108,12,121,98},      // rect       simpleButtonControl {{               $0000,          // flag               $3002,          // moreFlags               $00000000,      // refCon               PSTR_00000001,  // titleRef               0,              // colorTableRef               {"S","s",$0100,$3900}  // key equivalents       }};};resource rPString (PSTR_00000001, $0000) {       "Save"};// Cancel button = 2resource rControlTemplate (CTLTMP_00000002, $0000) {       $00000002,              // ID       {108,106,121,192},      // rect       simpleButtonControl {{               $0000,          // flag               $3002,          // moreFlags               $00000000,      // refCon               PSTR_00000002,  // titleRef               0,              // colorTableRef               {"\$1B", "\$1B",$0000,$0000}  // key equivalents       }};};resource rPString (PSTR_00000002, $0000) {       "Cancel"};// Connect button = 3resource rControlTemplate (CTLTMP_00000003, $0000) {       $00000003,              // ID       {108,204,121,290},      // rect       simpleButtonControl {{               $0001,          // flag               $3002,          // moreFlags               $00000000,      // refCon               PSTR_00000003,  // titleRef               0,              // colorTableRef               {"\$0D", "\$0D",$0000,$0000}  // key equivalents       }};};resource rPString (PSTR_00000003, $0000) {       "Connect"};// Registered user radio buttonresource rControlTemplate (CTLTMP_00000004, $0000) {       $00000004,              // ID       {51,84,60,222},         // rect       radioControl {{               $0001,          // flag               $3002,          // moreFlags               $00000000,      // refCon               PSTR_00000004,  // titleRef               $0000,          // initialValue               0,              // colorTableRef               {"R","r",$0100,$3900}  // key equivalents       }};};resource rPString (PSTR_00000004, $0000) {       "Registered User"};// Guest radio buttonresource rControlTemplate (CTLTMP_00000005, $0000) {       $00000005,              // ID       {40,84,49,152},         // rect       radioControl {{               $0001,          // flag               $3002,          // moreFlags               $00000000,      // refCon               PSTR_00000005,  // titleRef               $0000,          // initialValue               0,              // colorTableRef               {"G","g",$0100,$3900}  // key equivalents       }};};resource rPString (PSTR_00000005, $0000) {       "Guest"};resource rControlTemplate (CTLTMP_00000008, $0000) {       $00000008,              // ID       {2,2,29,60},      // rect       iconButtonControl {{               $000E,          // flag               $1020,          // moreFlags               $00000000,      // refCon               1,              // iconRef               0,              // titleRef               0,              // colorTableRef               $0000           // displayMode       }};};resource rControlTemplate (CTLTMP_00000009, $0000) {       $00000009,              // ID       {7,64,35,295},      // rect       statTextControl {{               $0003,          // flag (substitute pstring)               $1002,          // moreFlags               $00000000,      // refCon               LETXTBOX_00000001,     // textRef               0,              // textSize               $0000           // just       }};};resource rTextForLETextBox2 (LETXTBOX_00000001, $0000) {       "Connect to the file server “*0” as:"};// NAME stuffresource rControlTemplate (CTLTMP_0000000B, $0000) {       $0000000B,              // ID       {69,42,79,81},      // rect       statTextControl {{               $0004,          // flag (fast)               $1002,          // moreFlags               $00000000,      // refCon               LETXTBOX_00000003,     // textRef               0,              // textSize               $0000           // just       }};};resource rTextForLETextBox2 (LETXTBOX_00000003, $0000) {       "Name:"};resource rControlTemplate (CTLTMP_00000007, $0000) {       $00000007,              // ID       {68,84,81,292},      // rect       editLineControl {{               $0000,          // flag               $7002,          // moreFlags               $00000000,      // refCon               $001F,          // maxSize               0               // defaultRef       }};};// PASSWORD stuffresource rControlTemplate (CTLTMP_0000000A, $0000) {       $0000000A,              // ID       {86,12,96,81},      // rect       statTextControl {{               $0004,          // flag (fast)               $1002,          // moreFlags               $00000000,      // refCon               LETXTBOX_00000002,     // textRef               0,              // textSize               $0000           // just       }};};resource rTextForLETextBox2 (LETXTBOX_00000002, $0000) {       "Password:"};resource rControlTemplate (CTLTMP_00000006, $0000) {       $00000006,              // ID       {84,84,97,176},      // rect       editLineControl {{               $0000,          // flag               $7002,          // moreFlags               $00000000,      // refCon               $8008,          // maxSize               0               // defaultRef       }};};// --- Window Templates// "Connect to Blah as" window (Guest/Registered/Name/Password)resource rWindParam1 (WPARAM1_00000001, $0000) {       $2080,                  // plFrame (frame bits)       NIL,                    // plTitle (no Title)       $00000000,              // plRefCon       { 0,  0,  0,  0},      // plZoomRect       NIL,                    // plColorTable (standard colors)       {$0000, $0000},         // plYOrigin, plXOrigin       {$0000, $0000},         // plDataHeight, plDataWidth       {$0000, $0000},         // plMaxHeight, plMaxWidth       {$0000, $0000},         // plVerScroll, plHorScroll       {$0000, $0000},         // plVerPage, plHorPage       $00000000,              // plInfoText (info RefCon)       $0000,                  // plInfoHeight       {34,168,162,472},      // plPosition       infront,                // plPlane       CTLLST_00000E02,        // plControlList       $0009                   // plInDesc};