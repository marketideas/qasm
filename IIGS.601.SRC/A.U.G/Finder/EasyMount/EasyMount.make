#   File:       EasyMount.make#   Target:     EasyMount#   Created:    Tuesday, March 12, 1991 4:28:41 AMEasyMount ÄÄ EasyMount.DataFork EasyMount.RezFork	delete -i EasyMount	duplicate -y -d EasyMount.DataFork EasyMount	duplicate -y -r EasyMount.RezFork  EasyMount	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac EasyMount :	EndEasyMount.RezFork ÄÄ EasyMount.rii	reziigs EasyMount.rii -o EasyMount.RezForkEasyMount.DataFork ÄÄ EasyMount.aii.obj DES.aii.obj	linkiigs -t $B6 EasyMount.aii.obj DES.aii.obj -o EasyMount.DataFork.aii.obj Ä .aii	asmiigs {Default}.aii -o {Default}.aii.obj -d DebugSymbols=0