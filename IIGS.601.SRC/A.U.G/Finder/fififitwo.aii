***************************************************************************** The all-inclusive, setup-and-search Finder Filetype Finder** (FiFiFi for short)** by Matt Deatherage and Dave Lyons, 5/17/89* Copyright Apple Computer, 1989.  All rights reserved.** Extensive thanks to Dave Lyons and Eric Soldan, who gave great input* on this routine and on the data structures it searches, knowing their* names would be immortalized within Finder Source Code until Jim and Don* rewrite it all in Modula-2 Pascal Ada C Prolog Lisp ++.** This routine has lots of equates and two entry points:**  JSL FiFiFi	; loads all type $42 files from *:Icons**  JSL FiFiFiSearch	; takes a filetype/auxtype combination and returns* 	; a pointer to a Pascal String describing it.** Of course there are input and output parameters.  They're discussed* in the routines themselves.****************************************************************************** REVISION HISTORY -- 6.0.1** 1-Oct-92	Dave Lyons for 6.0.1d11*   FiFiFiSearch now tries a 2nd time, masking bit 15 off the auxtype, if*   it matched a generic filetype that can be inactivated, and bit 15*   happens to be set in the target auxtype.****************************************************************************	PRINT OFF	INCLUDE 'M16.Memory'	INCLUDE 'M16.Util'	INCLUDE 'M16.IntMath'	INCLUDE 'Strings.Equ'	; for Finder's purposes	INCLUDE 'Data.equ'	INCLUDE 'Finder.equ'	PRINT ONGSOS	equ $E100A8ohVersion	equ 0		; offset to version in headerohFlags	equ 2		; offset to flagsohNumEntries	equ 4		; number of entriesohReserved	equ 6		; reserved word (for our use)ohIndRecSize	equ 8		; IndexRecordSizeohOffsetToInd	equ 10		; offset to indexoFiletype	equ 0		; offset to filetype in each entryoauxtype	equ 2		; offset to auxtypeoFlags	equ 6		; offset to FlagsoOffset	equ 8		; offset to offsetOurRecSize	equ 8		; the size of the records in the memory block			; we create to show where to search***************************************************************************** FiFiFi entry point #2 - find the given file.** Here we take the filetype/auxtype in the registers and return,* in the registers, a pointer to the string that matches.** Inputs:*   Filetype	A register	Word Filetype to match*   auxtypeL	X register	Low word of auxtype to match*   auxtypeH	Y register	High word of auxtype to match** Outputs:*   XA = Pointer to string*   Y = flags from FTD entry (for example, 0 = generic type can be Inactive)** *Some* string will always be returned; since everything is already* set up, there can be no tool errors or anything of the sort.****************************************************************************;; First, we need to set up the predefined stack space;Lists	equ 0		; DP pointer to listsCurHand	equ Lists+4		; pointer to current file being searchedCount	equ CurHand+4		; number of files left to searchAdder	equ Count+2		; the shifted index to precalculateNumber	equ Adder+2		; the number of entries in the current fileRecSize	equ Number+2		; bytes/entry in current fileIndOffset	equ RecSize+2		; offset to first index entry in current fileDelta	equ IndOffset+2		; the delta to add/subtract from offsetPtrRec	equ Delta+2		; the pointer to the current recordTopOfIndex	equ PtrRec+2		; pointer to last record in current filefiletype	equ TopOfIndex+2		; filetype to matchRauxtype	equ filetype+2		; auxtype to matchFutz2Size	equ Rauxtype+4FiFiFiSearch	PROC EXPORT	EXPORT ListPtr*** added 1-Oct-92 DAL	phd	pha	pha	pha		;space for result we will return (3 words)	pha		;filetype	phy		;auxtype high	phx		;auxtype low@auxtype	equ 1@filetype	equ @auxtype+4@result	equ @filetype+2	tsc	tcd	lda <@filetype	jsr @Search2		;inputs = A YX	tya	and #$8001		;$8000=generic filetype, $0001=can be Inactive	cmp #$8001		;generic+inactive = try again with masked one	bne @done	lda <@auxtype+2	bne @done		;strange, don't mess with it	lda <@auxtype	bpl @done		;already active	asl a	lsr a	tax		;auxtype & $7FFF	ldy <@auxtype+2	lda <@filetype	jsr @Search2@done	ply	ply	ply		;pulled filetype/auxtype	pla		;result pointer low	plx		;result pointer high	ply		;result flags	pld	rtl@Search2	jsl FiFiFiSearch2	sty <@result+4	stx <@result+2	sta <@result	rts*** end 1-Oct-92FiFiFiSearch2	phd	phy		; auxtype+2	phx		; auxtype	pha		; filetype	tsc	sec	sbc #Futz2Size-6	tcs	inc a	tcd	lda >ListPtr+2	sta <Lists+2	lda >ListPtr	sta <Lists	lda #0	sta >ResultFlags		;1-Oct-92 DAL;; Finish the setup;	stz <Count		; initialize the count variable	ldy #2;; Note the following is a slight adulteration of original Finder code to handle the; fact that Finder treats devices as if they had filetypes greater than $FF;	lda <FileType		; get the filetype we're searching;;;	cmp #$0100		; if > $FF then its a device	cmp #$FF00		; if >= $FF00 it's special (1-Oct-92 DAL)	blt SearchNextFile		; so if not, go find itdevice	eor #$FFFF		;Compute index to Kind field string.	asl a	asl a	tax	lda >deviceKinds,x	tay		;save in y for a moment	lda >deviceKinds+2,x	tax	jmp ThisRecTwoSearchNextFile	iny	iny	iny	iny	lda [Lists],y	sta <CurHand	iny	iny	lda [Lists],y	sta <CurHand+2		; CurHand points to first fileBSloop			; (That's "Big Search Loop")	ldy #ohNumEntries	lda [CurHand],y		; get count of entries in this file	sta <Number	iny	iny	lda [CurHand],y		; get top of index we calculated in EntryOne	sta <TopOfIndex	iny	iny	lda [CurHand],y		; get index record size	sta <RecSize	iny	iny	lda [CurHand],y	sta <IndOffset		; offset to first index entry	lda <Number	ldx #1	stx <adder		; reinitialize the adder	dex@1	asl <adder		; shift the adder up	inx	lsr a		; shift the accumulator down	bne @1		; do it again	lsr <adder		; back it up by one	dex		; x = number of ASLs made on adder;; At this point, the adder contains the index entry NUMBER to start with.; We now have to convert that to an offset for indexed searching.  Since; we know adder is a power of two, we kept track of how many shifts we did; to create it and will shift the index size the same number of times.  This; creates the offset from the start of the index to the index entry we want.; Then we save this in "delta", and will use it in the loop to prevent; having to do any math other than adding, subtracting and shifting.;	lda <RecSize	txy	beq @wasZero@2	asl a	dex	bne @2@wasZero	sta <Delta		; Delta is now set up;; We should be ready to actually start searching.;	clc	adc <IndOffset	sec	sbc <RecSize	sta <PtrRec		; keep this for Choose, if needed	tay		; Y now has index, soSSLoop	lda [CurHand],y		; check the filetype in the index	cmp <FileType	beq @SS1		; equal, check the auxtype	blt TooSmall		; we need to go lower	bra TooBig		; we need to go higher (makes sense)@SS1	iny	iny	lda [CurHand],y		; check low byte of auxtype	cmp <Rauxtype	bne Choose		; decide which way to go next	iny	iny	lda [CurHand],y		; check high byte of auxtype	cmp <Rauxtype+2	bne Choose		; decide which way to go next	iny	iny	lda [CurHand],y     	; flags	bmi TooSmall        	; generic counts as too small	sta >ResultFlags	iny	iny		; got to offset	brl ThisRecord		; we found it!;; An auxtype comparison has just failed.  We now do a quick four-byte; subtraction to know whether the four-byte auxtype in the record is too big; or too small.;Choose	ldy <PtrRec	iny	iny	lda [CurHand],y		; low byte of auxtype	sec	sbc <Rauxtype	iny	iny	lda [CurHand],y	sbc <Rauxtype+2;; And, at this point, the carry is set if no borrow was needed, meaning that; the index auxtype was greater than the desired auxtype (we already knew; that it wasn't equal), so:;	bcs TooBig		; it was too big, or	bcc TooSmall		; it was too small, or;; We know (at this point) the index record is too big, so we have to go; to a smaller record.;TooBig	lsr <adder		; divide it in half	beq @1	lsr <delta		; this too	sec	lda <PtrRec	sbc <delta	sta <PtrRec		; PtrRec now points to the new value@1	bra NextRecord		; check boundaries and loop;; We need to search bigger, so increase the record number.  Check to make; sure we don't go over the top, then keep searching;TooSmall	lsr <adder		; divide this in half	beq @1	lsr <delta		; this too	lda <delta		; get the delta	clc	adc <PtrRec	cmp <TopOfIndex		; have we gone too far?	blt @TS2	lda <TopOfIndex	sec	sbc <RecSize@TS2	sta <PtrRec		; no further than the top, please@1;	bra NextRecord;; Check the boundaries and see what's going on;NextRecord	lda <adder	beq CheckGeneric	; no exact match here	ldy <PtrRec	brl SSLoop		; keep looking here!;; This is the one we want - [CurHand],y points to the offset to the string;; return XA = pointer to Pascal string;ThisRecord	clc	lda [CurHand],y	adc <CurHand	ldx <CurHand+2	bcc @1	inx@1	tay		;XY = ptr to stringThisRecTwo	tsc	clc	adc #Futz2Size	tcs	pld	lda >ResultFlags	pha	tya		;XA = ptr to string	ply		;Y = result flags	clc	rtlResultFlags	dc.w 0;; There's no exact match, so check the generic record previous;CheckGeneric	ldy #ohFlags	lda [CurHand],y	bpl NoGeneric		; bit $8000 = some generic auxtypesScanGeneric	ldy <PtrRec	lda [CurHand],y	cmp <FileType	blt NoGeneric	bne ScanBackwards;	ldy <PtrRec	iny	iny	iny	iny	iny	iny	lda [CurHand],y	bpl ScanBackwards		; bit $8000 = any auxtype	sta >ResultFlags	iny	iny	brl ThisRecordScanBackwards	lda <PtrRec	sec	sbc <RecSize	bcc NoGeneric		; searched back off end of table	sta <PtrRec	cmp <IndOffset	blt NoGeneric	sta <PtrRec	bra ScanGenericNoGeneric;; There's no match in this file, so go to the next one.;NextTry	inc <Count		; bump the count			; (don't you love comments like that?)	lda <Count	cmp [Lists]	beq LastFile		; this was the last file	asl a	asl a	asl a	inc a	inc a		; A := (A*8) +2	tay	brl SearchNextFile	; go do this again;; This was the last file, so point to the UNKNOWN string, which must be at; the beginning of the index table in the last file (filetype 00, auxtype 0000);LastFile	lda <IndOffset	clc	adc #8	tay	brl ThisRecord		; CurHand still points to the right file;; Static storage;ListPtr	dc.l 0		; pointer to list of file handles for searching; --- Data for Get Info windows --------------------------------------deviceKinds	DC.L trashBlk+windMenuText	DC.L trashBlk+windMenuText	DC.L HardKind	DC.L flopKind	DC.L miniKind	DC.L ramKind	DC.L flopKind		;not used	DC.L cdromKind		;new kinds added 05/29/88 DJB	DC.L tapeKind	DC.L scsiKind	DC.L serverKind	DC.L networkKind	DC.L hdPartKind	DC.L cdPartKind	DC.L scPartKind	EndP	END