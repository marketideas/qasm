; Buffers.aii;; Buffers used by the Apple IIGS Finder;; Copyright Apple Computer, Inc.  1991;; By Andy Nicholas;.....................................................................		INCLUDE	'Finder.equ'		INCLUDE 'Strings.equ'		INCLUDE 'All.Macros'		Buffers		PROC	EXPORTFinderInfo	RECORD	0location	DS.W	2			; folder's locationwindRect	DS.W	4			; folder's rectanglewindView	DS.W	1			; folder's viewwindScroll	DS.W	2			; scroll position		ENDR ;		IMPORT	clip_guts;;;;; Clipboard window parameter block;;;		EXPORT	clip_param;clip_param	DC.W	clip_end-clip_param	;Document window template.;		DC.W	%1101111111000001	;Window's flags.;		DC.L	clipBlk+windtitle	;Pointer to window's title.;		DC.L	clipBlk			;Pointer to window's info block.;		DC.W	zY1-10,zX1,zY2,zX2	;Zoom RECT.	;		EXPORT	clip_color;clip_color	DC.L	0			;Pointer to color table.;		DC.W	0			;Y origin.;		DC.W	0			;X origin.;		DC.W	300			;Data height.;		DC.W	700			;Data width.;		DC.W	200			;Window's maximum grow height.;		DC.W	640			;Window's maximum grow width.;		DC.W	8			;Number of pixels to scroll vertically.;		DC.W	20			;Number of pixels to scroll horizontally.;		DC.W	0			;Number of pixels to page vertically.;		DC.W	0			;Number of pixels to page horizontally.;		DC.L	0			;Infomation bar text string.;		DC.W	0			;Height of information bar.;		DC.L	0			;DefProc.;		DC.L	0			;Routine to draw info bar.;		DC.L	clip_guts+$80000000	;Routine to draw content.;		DC.W	120,20,180,500		;Size/Position of content.;		DC.L	$FFFFFFFF		;Plane to put window up in (top most).;		DC.L	0			;Address of memory for window record.;		EXPORT	clip_end;clip_end	;; Verify window parameter block:		;		EXPORT	verify_paramverify_param	DC.W	verify_end-verify_param			DC.W	%1101111110110001	Window's flags.		EXPORT	verifyTPtrverifyTPtr	DC.L	0			Pointer	to window's title.		EXPORT	verifyBlkPtrverifyBlkPtr	DC.L	0			Pointer	to window's info block.		DC.W	zY1,zX1,zY2,zX2		Zoom RECT		EXPORT	verifyColorverifyColor	DC.L	0			Pointer	to color table.		DC.W	0			Y origin.		DC.W	0			X origin.		EXPORT	verifyHeightverifyHeight	DC.W	300			Data height.		EXPORT	verifyWidthverifyWidth	DC.W	700			Data width.		DC.W	200			Window's maximum grow height.		DC.W	540			Window's maximum grow width.		DC.W	8			Number of pixels to scroll vertically.		DC.W	20			Number of pixels to scroll horizontally.		DC.W	0			Number of pixels to page vertically.		DC.W	0			Number of pixels to page horizontally.		EXPORT	verifyInfoRefverifyInfoRef	DC.L	0			Infomation bar text string.		DC.W	11			Height of information bar.		DC.L	0			Window frame defProc (default).		EXPORT	verifyInfoProcverifyInfoProc	DC.L	0			Routine	to draw	info. bar.		EXPORT	verifyGutsProcverifyGutsProc	DC.L	0			Routine	to draw	content.		EXPORT	verifywRectverifywRect	DC.W	0,0,0,0			Size/Position of content (dynamic).		DC.L	$FFFFFFFF		Plane to put window up in (top most).		DC.L	0			Address	of memory for window record.		EXPORT	verify_endverify_end;; rest of the stuff we use;		EXPORT	GetBootVolListGetBootVolList	DC.W	1			;pcount		DC.L	C1_BootNameBuf		;ptr to boot volume name bufferC1_BootNameBuf 	DC.W	36		EXPORT	C1_BootNameC1_BootName	DS.B	34			;; ----------------------------------------------------------------------------------; EVERYTHING BELOW THIS POINT MUST BE COMPOSED OF ZEROES TO PRESERVE THE SPARSENESS; OF THIS SECTION OF THE FINDER.  THIS REDUCES FINDER'S SPACE ON DISK A LOT.; ----------------------------------------------------------------------------------;;; Verify window's info block;		EXPORT	verifyBlkverifyBlk	DC.L	0		;Handle of first icon in window.		DC.W	0		;Verify window ID number.		DC.W	0		;View by icon (not used).		DC.L	0		;Handle of opening icon.		DC.L	0		;disk icon which is the root of the window		DC.W	0		;Number of items in window (not used).		EXPORT	verifyDataverifyData	DC.L	0		;Bytes used in disk (not used).		DC.L	0		;Bytes free on disk (not used).		dc.w	0		;verify fst		dc.w	0		;windAccess		dc.w	0		;verifyDirty		DS.B	54		DS.B	2		DS.B	52		EXPORT	endVerifyBlkendVerifyBlk;; Validate window's info block;		EXPORT	validateBlkvalidateBlk	DC.L	0		;Handle of first icon in window.		DC.W	0		;Verify window ID number.		DC.W	0		;View by icon (not used).		DC.L	0		;Handle of opening icon.		DC.L	0		;disk icon which is the root of the window		DC.W	0		;Number of items in window (not used).		EXPORT	validateDatavalidateData	DC.L	0		;Bytes used in disk (not used).		DC.L	0		;Bytes free on disk (not used).		dc.w	0		;validate FST		dc.w	0		;windAccess		dc.w	0		;validate dirty		DS.B	54		DS.B	2		DS.B	52		EXPORT	endValidateBlkendValidateBlk;; Clipboard window's info block:;		EXPORT	clipBlkclipBlk		DC.L	0		;Handle of first icon in window.		DC.W	0		;Clipboard window ID number (filled in)		DC.W	0		;View by icon (not used).		DC.L	0		;Handle of opening icon (not used).		DC.L	0		;disk icon which is the root of the window		DC.W	0		;Number of items in window (not used).		DC.L	0		;Bytes used in disk (not used).		DC.L	0		;Bytes free on disk (not used).		ds.b	2		;windFST		ds.b	2		;windAccess		ds.b	2		;is clipboard dirty?		ds.b	54		;window title		ds.b	2		;window menu title		ds.b	52		;window menu title text;; about window's info block:;		EXPORT	aboutBlkaboutBlk	DC.L	0		;Handle of first icon in window.		DC.W	0		;About box window ID number (filled in)		DC.W	0		;View by icon (not used).		DC.L	0		;Handle of opening icon (not used).		DC.L	0		;disk icon which is the root of the window		DC.W	0		;Number of items in window (not used).		DC.L	0		;Bytes used in disk (not used).		DC.L	0		;Bytes free on disk (not used).		ds.b	2		;about box FST (yeah, right)		ds.b	2		;windAccess		ds.b	2		;is about dirty?		ds.b	54		;window title		ds.b	2		;window menu title		ds.b	52		;window menu title text;; help window's info block:;		EXPORT	helpBlkhelpBlk		DC.L	0		;Handle of first icon in window.		DC.W	0		;About window ID number (filled in)		DC.W	0		;View by icon (not used).		DC.L	0		;Handle of opening icon (not used).		DC.L	0		;disk icon which is the root of the window		DC.W	0		;Number of items in window (not used).		DC.L	0		;Bytes used in disk (not used).		DC.L	0		;Bytes free on disk (not used).		ds.b	2		;help window fst		ds.b	2		;windAccess		ds.b	2		;is about dirty?		ds.b	54		;window title		ds.b	2		;window menu title		ds.b	52		;window menu title text;; Trash	window's info block:;		EXPORT	TrashBlkTrashBlk	DC.L	0		;Handle of first icon in window.		DC.W	0		;Trash window ID number (filled in)		DC.W	0		;View by icon.		EXPORT	TrashIcTrashIc		DC.L	0		;Handle of Trash icon.		DC.L	0		;disk icon which is the root of the window		DC.W	0		;Number of items in window.		DC.L	0		;Bytes used in disk.		DC.L	0		;Bytes free on disk.		DC.w	0		;help FST (nada)		DS.b	2		;windAccess		DS.b	2		;dirty flag		DS.B	54		;rest of window title space		DS.B	2		;window menu title		DS.B	52;; ONLY ZEROES go from here to the end to preserve our sparseness;		EXPORT	BothRectsbothRects	ds.b	16		EXPORT	itemsInFolderStritemsInFolderStr ds.b	7		EXPORT	folderMemStrfolderMemStr	ds.b	7		EXPORT	availMemStravailMemStr	ds.b	7		EXPORT	FinfoFinfo		DS	FinderInfo		EXPORT	ExtensionIDsExtensionIDs	ds.b	MaxExtensions*2		EXPORT	spotHashspotHash	DS.B 	200			;Hash table for open icon spots.		EXPORT	C1_QuitNameC1_QuitName	DS.B	MaxPathLen+2	 	;class 1 input string	;; buffers used primarily by misc.aii;		EXPORT	levelArraylevelArray	DS.B	MaxPathLen+2		EXPORT	C1_PathBufC1_PathBuf	DC.W	0			;class 1 output string (we stuff it on startup)		EXPORT	C1_PathC1_Path		DS.B	MaxPathLen+MaxFileName+2		EXPORT	C1_SourceBufC1_SourceBuf	dc.w	0			EXPORT	C1_sourceC1_Source	DS.B	(MaxFileName*4)+4	;class 1 input string		EXPORT	C1_DestBufC1_DestBuf	dc.w	0		EXPORT	C1_destC1_Dest		DS.B	(MaxFileName*4)+4	;class 1 input string;; all of the following 3 sets of buffers must be contiguous because they are zeroed; out by 'allocateChains' in match.aii;		EXPORT	filetypeListfileTypeList	ds.B	(256*4)		EXPORT	deviceTypeListdeviceTypeList	ds.B	(256*4)		EXPORT	fTypeInsertListfTypeInsertList	ds.B	(256*4)		EXPORT	dTypeInsertListdTypeInsertList	ds.B	(256*4)		;; PADDING;; The value below is strictly for padding a block out in the 6.0 GM build to; pad it to be more sparse...;;		ds.b	64				ENDP		END