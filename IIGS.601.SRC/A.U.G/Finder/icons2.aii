		lda	wind_pos+y2		;no double-height info bar, so the window can		sec				;be a measly 75 pixels in height		sbc	wind_pos+y1		cmp	#39		bge	@noHeightPin		lda	wind_pos+y1		clc		adc	#39		sta	wind_pos+y2@noHeightPin;; create the window, including the zoom effect;		lda	wind_pos+x1		;adjust for the true position of where our window will be		sec		sbc	#2		sta	bigRect+x1				lda	wind_pos+y1		sec		sbc	#23		sta	bigRect+y1				lda	wind_pos+x2		clc		adc	#26		sta	bigRect+x2				lda	wind_pos+y2		clc		adc	#13		sta	bigRect+y2				jsr	growZoom		;Draw zoom rect.		pha				;Space for result.		pha		pea	wind_param>>16		pea	wind_param		_NewWindow		tax		pla		sta	<wind		sta	MyLocalWinPtr				pla		sta	<wind+2		sta	MyLocalWinPtr+2		bcc	@ourWindowOK		lda	<wind+1		beq	@noWindow		lda	<wind		ldx	<wind+2		jsl	CloseThisWindow@noWindow	lda	<posFile+1		beq	@noPosFile		pushZLong <posFile		jsl DisposeHandleGlue@noPosFile	jsr	FreeInfoBlk		jsl	OOMDump			;see if we can get rid of either handle		bcc	@DeepMemoryErr		;if not, they get the text screen to avoid crashing			lda	#rasMemErr		;tell the user they're toast.		jsl	doAlertwindow		bra	@notSoDeep		@DeepMemoryErr	lda	#$FFFF		ldx	#MemoryFull		ldy	#MemoryFull>>16		jsl	TextAlert@notSoDeep	stz	modifiers		;make sure the desktop doesn't auto-close						;a window if they were tunneling		inc	AbortFind		sec		rts		;; Our window was created OK, keep going...;@ourWindowOK	inc	myWindCount		;Increment windows I create counter.		ldx	NoRealMatch		;if IC doesn't -really- own this window, then		bne	@icNotOpen		;don't update the window it opened into field		ldy	#icWind			lda	<wind		sta	[<ic],y		iny		iny		lda	<wind+2		sta	[<ic],y@icNotOpen		jsr	unlockic		jsr	setOrgnMask		;Set horizontal scroll mask so icons						;won't fall on odd pixel boundaries.;; Create icons for window's directory;		lda	#$FFFF		sta	row		stz	rowbits		stz	rowbits+2		stz	positioned		lda	#10			;defaults in case they don't have a finder.data		sta	iconPos+y1		;file		lda	#52+14		sta	iconPos+x1		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		bne	@notBySmall		lda	#-10			;defaults in case they don't have a finder.data		sta	iconPos+y1		;file		lda	#14		sta	iconPos+x1@notBySmall						lda	typeOfFData		cmp	#FinderVer		bne	@notNew				stz	lookingAt		;looking at first item				lda	<posFile		;Save handle.		ldx	<posFile+2		jsr	derefHand		;temp = (posFile).		ldy	#FDataItems				lda	[<temp],y		sta	itemsInFData		lda	<temp			;set temp to the beginning of the icon POS		clc				;records		ldy	#FDataStartAt		adc	[<temp],y				tax		lda	<temp+2		adc	<zero		sta	startOfRecords+2		sta	lookingAtAddr+2		stx	startOfRecords		stx	lookingAtAddr@notNew		jsr	startHash		;Turn spot hashing on.		jsr	getWindPath		;C1_PathName = pathname in current info block.		jsr	path2ticon		;ticonobj+icOwner = C1_PathName		stz	AtCatalogEntry		;start at entry #0		PushLong #C1_PathName		;Pass window's pathname.		ldx	#xStartCatalog		jsl	MiscEntry		bcc	@noStartError		cmp	#$61		beq	@noStartError				ldx	#OPEN+C1		jsl	LongGSOSError		brl	iconAbort@noStartError	lda	ce_entry_num		sta	filesInFolder		cmp	#500			;if there are >= 500 files, don't use the finder.data file		blt	lop4				lda	<posFile+1		beq	@noPosFile2		pushZLong <posFile		;if we have >= 500 files, DON'T use the Finder.data file		jsl DisposeHandleGlue			;if there is one		stz	<posFile+1		stz	read_len@noPosFile2			lda	filesInFolder		jsl	lotsOfFilesAlert		bcc	lop4		brl	iconAbort				lop4		pha				;Space for result.		pha		ldx	#xNextCatalog		jsl	MiscEntry		tay		pla		plx		bcc	ok4			;Done?		cpy	#$61		beq	goDone4				tya		ldx	#GET_DIR_ENTRY+C1		jsl	LongGSOSErrorgoDone4		brl	done4ok4		sta	<work			;Save pointer to directory entry.		stx	<work+2		lda	ce_access		; get access value		and	#$0004			; check the invisible bit		beq	fType			; not set				lda	prefer			; Should invisible files be