; = = =	= = = =	= = = =	= = = =	= =;	   Call	CopyFile.; = = =	= = = =	= = = =	= = = =	= =		IMPORT	WStringCopy		IMPORT	ZoomDiskToTrash		IMPORT	EjectDisk		import	wipeIcon		import	EraseIcon		import	CutNFree		import	abortFindcopyFiles2	pei	<icHand+2		Pass handle of first icon.		pei	<icHand		ldx	<ic+2			Pass pointer to	source name.		lda	<ic		clc		adc	#icOwner		bra	chkHi			bra w carry intact to incr hi byte if nec.;		bcc	store900		improved w above bra chkHi -- rdl: 3/9/90;		inx				    ";		bra	store900		    ";;; --- Copy files ---------------------------------------------; copyFiles3	ldy	#2			Pass hdl of 1st icon to FileEntry/xCopyFiles.		lda	[<windblk],y		pha		lda	[<windblk]		pha		ldx	<windBlk+2		lda	<windBlk		clc		adc	#windPathchkHi		bcc	store900		inxstore900	phx				Pass pointer to	source pathname.		pha		PushLong #C1_TempPath		jsl	WStringCopy		PushLong #C1_TempPath		push: FileEntry/xCopyFiles parameter		lda	<windTrack+1		Is the destination a window?		beq	ok900			bra if not a wdw		lda	<windTrack		ldx	<windTrack+2		jsr	getwRefCon2		windblk	= pointer to window's info block.		jsr	getWindPath		C1_PathName = destination window's pathname.		bra	ok901ok900		lda	<iconTrack+2		sta	<icHand+2		lda	<IconTrack		sta	<icHand		jsr	lockic		ldy	#icFType		Is the destination on the desktop?		lda	[<ic],y		bpl	ok902			bra if file or folder		jsr	makeIcRoot		else device/trash: C1_PathName = separator + icName.		bra	ok901ok902		jsr	buildPath3		bcs	error101		Pathname error?ok901		pea	C1_PathName>>16		Pass pointer to	destination pathname.		pea	C1_PathName		lda	functionKey		Pass secret key.		pha		ldx	#xCopyFiles		jsl	FileEntryerror101	rts; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Reposition icons.;	   Called from walkOfLife.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   deltay = delta y.;	   deltax = delta x.;	   filetype = destination filetype.;;	   IconTrack = handle of destination ICONOBJ if	the destination;		       does not	have a window.;	   windTrack = window of destination.;;	   curWind = source window.;;	   ExtCopy = negative if moving	to Trash;		     greater than zero if to desktop.;;	   ticonobj+icOwner = source window pathname if	ExtCopy	is not zero.;;	   If both IconTrack+1 and windTrack+1 are zero, the icon is staying;	   in the same window.;;	   intoIcon = TRUE if icon was dragged into an icon.;		IMPORT	C1_SystemName		IMPORT	WStrCompare		IMPORT	cknames		import	cknames2		IMPORT	PathAddName		IMPORT	KillIcon		IMPORT	walkExt2		IMPORT	BuildPath3		IMPORT	EjectNonRemovable		moveIcons	name				lda	<windTrack+1		Is the destination the same as source?		ora	<IconTrack+1		bne	next300;; --- Reposition the icon in the same window ----------------------------------;		ldy	#icy		lda	[<ic],y		clc		adc	deltay		sta	[<ic],y		iny		iny		lda	[<ic],y		clc		adc	deltax			Delta X.		sta	[<ic],y		clc				Continue flag.		rts;; --- Move icon	into another icon -----------------------------------;;	   This	should only be executed	when files are dragged in a folder;	   or disk that	does not have an open window.  Since the files have;	   already been	copied,	all that's left is to erase the icons moved.;;modifier	equ	14;next300		lda	ExtCopy		bmi	@copied		bne	@copied				ldy	#icFType		;if this thing we've "moving" is a disk, then		lda	[<ic],y			;we'd better continue		bmi	@copied				ldy	#icFlag			;otherwise, they were moving some kind of file,		lda	[<ic],y			;so it's safe to assume that they went through		and	#icCopy			;CopyFiles before this and we can abort what went		bne	@copied			;and what didn't go...		clc		rts		@copied		lda	<IconTrack+1		Did user drag into a disk or folder?		bne	ok311		brl	ckWind			If not,	check window.ok311		lda	<filetype		Is the destination a disk?		inc	a			(gets rid of the trash type.)		inc	a		bpl	ck300		brl	ckDiskCopyck300		lda	<windTrack+1		Is there a destination window?		beq	ok312		brl	ckWind2ok312		ldy	#icWind+1		Does icon have an open window?		lda	[<ic],y		beq	done310; --- Copying open folder into an unopened directory ----------------------		pei	<icHand+2		Saves.		pei	<icHand		pei	<wind+2		pei	<wind		pei	<windBlk+2		pei	<windBlk		iny		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	getwRefCon2		windBlk	= icon's open window info block.		jsr	getWindPath		C1_PathName = window's pathname (use later).		jsr	clonePath		C1_TempPath = C1_PathName.		jsr	findDisk		icHand = disk icon that	window came from.		ldy	#windIc			Store new moma icon in window's info.		lda	<icHand		sta	[<windBlk],y		iny		iny		lda	<icHand+2		sta	[<windBlk],y		pla				Restore.		sta	<windBlk		pla		sta	<windBlk+2		pla		sta	<wind		pla		sta	<wind+2		pla		sta	<icHand		pla		sta	<icHand+2		jsr	lockicdone310		ldy	#icFlag			Did the	icon replace a duplicate?		lda	[<ic],y		and	#ICDUP		beq	@noClone		jsr	removeClone		Remove the icon	that was replaced.@noClone	brl	skip304			Check if source	icon needs to be erased.ckDiskCopy	ldy	#icFType		Is the source also a disk?		lda	[<ic],y		inc	a			(gets rid of the trash type.)		inc	a		bmi	@ok		brl	ck300			bra if file or folder or trash@ok		lda	<iconTrack		itÕs a device		ldx	<iconTrack+2		cmp	<icHand			Is the source and destination the same?		bne	ok303		cpx	<icHand+2		beq	skip303			If same, then abort disk dup.ok303		pei	<icHand+2		Save icon being	copied.		pei	<icHand		pei	<icHand+2		Pass handle of source disk.		pei	<icHand		sta	<icHand			Remember destination disk.		stx	<icHand+2		phx				Pass handle of destination disk.		pha		lda	FunctionKey		TRUE if	function key pressed.		pha		pei <zero			Pass block copy	preference.		ldx	#xCopyDisk		jsl	FileEntry		bcc	ok307				;; Cancel of ANY disk block-copy (one-drive or not) was leaving destination disk;   with a different create date than when it started (and had the potential of;   invalidating any open windows or extended icons that might have been on the;   desktop prior to the copy operation).  Here, we clear the desktop and reset;   the create date just as we do when the copy terminates normally.;			cpx	#$8000		beq	@trueAbort		cpx	#$e000		beq	@trueAbort		cpx	#$c000		beq	@trashReadOnly				phx		jsr	clearAndReset		plx		@trueAbort	pulllong <icHand		jsr	lockic			; dereference it		cpx	#$8000			; were files copied to folder/root ?		beq	moveIcon		brl	exit301			; must have aborted copy@trashReadOnly	lda	<iconTrack		;get handle of destination icon		sta	<icHand		lda	<iconTrack+2		sta	<icHand+2				jsr	lockic				jsr	ZoomDiskToTrash		jsr	wipeIcon				stz	<iconTrack		stz	<iconTrack+2		stz	<windTrack		;there is NO destination window any more fellas!		stz	<windTrack+2				pulllong <icHand		jsr	lockic			; dereference it			inc	abortFind		brl	exit301ok307		jsr	clearAndReset		pulllong <icHandskip303		jsr	lockic			; dereference itskip304		brl	ckDelete		; check if source icon should be deletedmoveIcon	inc	diffVolumes				lda	diffVolumes		sta	dontDraw				lda	<windTrack+1		; is there a destination window?		beq	exit300			; no		stz	ExtCopy		brl	replane300; --- Move icon	to a new window	-------------------------------------------ckWind		lda	<windTrack+1		Is there a destination window?		beq	exit300ckWind2		lda	ExtCopy			Is the destination window the trash?		bpl	replane300		; bra if not trash		ldy	#icFType		Disk going into	trash?		lda	[<ic],y		bpl	replane300		; bra if not a device		ldx	EjectNonRemovable		beq	@noEject		ldy	#icFtype		;see if it's a hard drive partition		lda	[<ic],y		cmp	#TypeHardPart		beq	cont300@noEject	ldy	#icDevInfo		lda	[<ic],y		and	#$0004			;mask ejectable bit, andy, 12/4/90		bne	cont300				lda	#rasNonRemove		jsl	doAlertWindow		bra	exit300			;device is not removablecont300		pushZLong <icHand		pushZLong <rectRgn		pushZLong <tempRgn		stz	<rectRgn+1		stz	<tempRgn+1		jsr	EmptyTrashMenu		; empty the trash before trashing		pulllong <tempRgn		pulllong <rectRgn		pulllong <icHand		jsr	lockic		jsr	trashDisk		Handle disk icon dragged to trashexit300		clc				Continue flag.		rts;; remove the icons from this disk (ic) and reset its create time;clearAndReset	jsr	lockic			; ic = destination disk icon		inc	SaveOffFlag		;Turn data file saving off.		jsr	clearDisk		;Remove disk's every window and ext icon.		stz	SaveOffFlag		;Turn data file saving back on.		jsr	resetCTime		; update disk icon's create time/date		brl	unlockic		; --- Move an icon to a	new window plane -----------------------------------;;  ic =	icon to	move.;  icHand = icon's handle.;  windTrack = new home.;  curWind = source window.;  ExtCopy = negative if moving	to Trash, greater than if to desktop.;  ticonobj+icOwner = source window pathname if	ExtCopy	is not zero.;  srcView = view type of source window.;;------------------------------------------------		IMPORT	strSystem		IMPORT	C1_BootName		replane300	lda	ExtCopy			Is the icon going to a place that		beq	next301			requires an extended ICONOBJ?		bpl	ok305		ldy	#icFlag			Icons going to Trash must have delete		lda	[<ic],y			bit set.		and	#ICDELETE		bne	ok306		brl	exit301			If delete bit not set, skip this one.ok306		pei	<TaskData+2		pei	<TaskData		jsr	killkids2		pla		sta	<TaskData		pla		sta	<TaskData+2ok305		ldy	#icFlag			Is icon	already	extended?		lda	[<ic],y		ldy	#icy			Save icon's last position (just in case).		and	#ICEXTENDED		beq	ok304				      		;Keep same extended pathname.		jsr	getExtName		;C1_PathName = icon's icOwner field.		bcs	error102		Pathname error?		jsr	path2ticon		ticonobj+icOwner = C1_PathName		ldy	#icOldPosY		Keep same old position.ok304		lda	[<ic],y			Remember Y position.		sta	ticonobj+icOldPosY		iny		iny		lda	[<ic],y			Remember X position.		sta	ticonobj+icOldPosX		bra	ok301next301		ldy	#icFlag			Should the icon	be copied?		lda	[<ic],y		and	#ICCOPY		bne	ok301error102	brl	ckDeleteok301		pei	<icHand+2		;Saves.		pei	<icHand		pei	<filetype		jsr	pullFields		;Pull common icon fields to be used						;by the new icon.		lda	<windTrack		;Destination window.		ldx	<windTrack+2		jsr	getwRefCon2		;wind = windTrack.				      		;windBlk = windTrack's info block pointer.;; Manually fudge the FST value in the icon's option list to be whatever the destination window's FST is...;*** added 7-Jul-92 DAL -- Don't mess up the FST ID if we're just dragging to the desktop!		lda <windTrack+1		cmp <deskPort+1		beq @noFSTchange*** end 7-Jul-92		ldy	#windFST		lda	[<windBlk],y		beq	@noFSTchange		sta	ticonObj+icFST@noFSTchange		lda	diffVolumes		;anything moving to another volume is NOT marked as opened!		beq	@notCopy				lda	ticonobj+icFlag		and	#_ICOPENED		sta	ticonobj+icFlag				stz	ticonobj+icWind		stz	ticonobj+icWind+2@notCopy						ldy	#icFType		; kludge to make disk become folder		lda	[<ic],y		bpl	cont			; bra if not a device		lda	#TypeFolder		; device: give it folder filetype		sta	<filetype		stz	auxType;; JAM 5/21/89 (Fixing BRC #49015);; Kludge time again, kiddies.  In general, the Finder has no problems with; copying the lock item over to duplicates or copies of locked folders, files, etc.; This isn't exactly cool behavior, but it is harmless enough.  However, the lock; SHOULD be maintained when moving the icon around on the same disk or within the; same window.  (Actually, we should probably not allow a locked icon to be moved; out of its home window, but it can be copied or duplicated to the same or different; windows, with the clone losing its lock status.)  The real solution is to know; whether one is simply copying/duplicating or moving, removing the lock in the; former case and disallowing moves outside the current window in the latter (with; moves from and to the desktop being weird cases).  IN THE CASE COVERED BY THIS BUG,; (changing a disk icon to a folder) we know that we MUST be copying, so it is OK; to blast the locked flag bit, may the powers that be have mercy on our souls.;		lda	#ICLOCKED				trb	ticonobj+icFlag				cont		ldy	#icFlag			Did the	icon replace a duplicate?		lda	[<ic],y		and	#ICDUP		beq	skip301		jsr	removeClone		Remove the icon	that was replaced.		lda	<windTrack		Destination window.		ldx	<windTrack+2		jsr	getwRefCon2		wind = windTrack.;				      		windBlk = windTrack's info block pointer.skip301		lda	intoIcon		Was original destination an icon?		beq	ok300			bra if not		stz	posFlag		jsr	StartHash				pei	<icHand+2		Save.		pei	<icHand		jsr	windSpot		User did not select a spot in the window.		pla				Restore.		sta	<icHand		pla		sta	<icHand+2		jsr	lockic		stz	spotHashOn		lda	#moveIcons		Restore	walkOfLife to me.		sta	tocall+1		brl	skip302;;; --- Give destination icon a position from the	position the user dragged to --;;  JAM 5/21/89 (addressing BRC #46908); Ignore the following commentary.  I ripped the fix out on 5/25/89 because the fixed; behavior was worse than the original.  I am leaving the commentary so we can revisit; this problem at a more convenient time.;  This isn't precisely a "fix," since the behavior inherent in the original design is;  clear, if unattractive to just about everyone seeing it.  Problem is, when copying;  icons from textview to iconview, we would like them to plop down wherever we;  finished the drag, such that those in a multiple-selection stay together.  Old design;  did this, by relating the new, iconview y-position to the old, textview y-position.;  (Actually, the x-position was relative to the textview x as well, but since textview;  x position is constant, it is not the interesting item in this discussion.)  The net effect;  was that copied icons were fanned out and somewhat overlapped in a vertical line, which many;  found unpleasant.  Now, we will relate the new x and y to the old ICONVIEW x and y, which;  should lead to some interesting behavior.  In a kinder, gentler world, we would compute;  a neat grid in which to place the icons, relative the the place where the user quit;  dragging.  If given time, we may just do that.ok300		ldy	#icy		ldx	srcView		beq	ok309			bra if source window not viewed by text		ldy	#icTextYok309		lda	[<ic],y		clc		adc	deltay		sta	<yrat;		ldy	#icx		lda	[<ic],y		txy		beq	ok308			bra if source window not viewed by text		lda	#textLeftok308		clc		adc	deltax		sta	<xrat;  end JAM 5/21/89 (BRC #46908);;; --- If destination is	desktop, make sure it's on the desktop ------------;		lda	ExtCopy			Going to desktop?		dec	a		bmi	skip302			bra if not;		lda	<xrat		bpl	ok310		lda	<zerook310		cmp	#640		bcc	ok313		lda	#640ok313		sta	<xrat;		lda	<yrat		bpl	ok314		lda	<zerook314		cmp	#190		bcc	ok315		lda	#190ok315		sta	<yrat;; Create the new icon;skip302		stz	<devNumber		Files and folders don't have device #.;; see if this is the icon for the system folder or not;				lda	<filetype		cmp	#$0f		beq	@isFolder		brl	@notSystem		@isFolder	stz	auxtype		jsr	geticNamePtr		Get pointer to icon's name and pass.		pha		pushZLong <temp		pushlong #strSystem		jsl	PStringCompare		pla		beq	@notSystem		lda	ExtCopy			;are we moving to the desktop?		beq	@inWindow		;if not, then we're moving to a window...		;; Find out if where we came from is the boot disk (we're going to the desktop).;		pushZLong <windBlk		pushZLong <wind		lda	<Taskdata		;source window		ldx	<Taskdata+2		jsr	getwRefCon2		;windBlk = icon's mom window info block.		jsr	getWindPath		pulllong <wind		pulllong <windBlk				bra	@onDesktop	;; Find out if we're going back to the boot disk;@inWindow	pushZLong <windBlk		;moving to a window...		pushZLong <wind		lda	<windTrack		;Destination window.		ldx	<windTrack+2		jsr	getwRefCon2		;windBlk = icon's mom window info block.		jsr	getWindPath		pulllong <wind		pulllong <windBlk@onDesktop					pha				;space for result		PushLong #C1_PathName		PushLong #C1_BootName		jsl	WStrCompare		;is this the boot disk ?		pla		beq	@notSYSTEM		;no		lda	#$0002			;yes, so mark system folder		sta	auxtype@notSYSTEM;; now, actually create the new icon object;			ldy	#icDisk			;if we go to the desktop, we inherit our icDisk field		lda	[<ic],y			;from the previous icon		sta	ticonobj+icDisk		iny		iny		lda	[<ic],y		sta	ticonobj+icDisk+2				lda	ExtCopy			;Going to desktop?		bne	@toDesktop		pushZLong <windBlk		;icon's root is now whichever icon owns this window		pha		pha		pushZLong <windTrack		_GetWRefCon		pulllong <windBlk				ldy	#windDiskIc		lda	[<windBlk],y		sta	ticonobj+icDisk		iny		iny		lda	[<windBlk],y		sta	ticonobj+icDisk+2		pulllong <windBlk@toDesktop		jsr	geticNamePtr		;Get pointer to icon's name and pass.		ldy	<zero			;add icon to the head of the list		jsr	addIconObj		;move the existing icon object		bcs	doneDraw		lda	dontDraw		;ok to draw? (set in windClick)		bne	doneDraw		;no; may be illegal chars		lda	<windTrack		ldx	<windTrack+2		jsr	startDraw2		;Switch to proper port and origin.		jsr	lockic			;Draw the icon in its new window.		jsr	drawIcon2		jsr	endDraw			;Set window's origin back to 0,0.doneDraw	pla				;Restores from ok301		sta	<filetype		pla		sta	<icHand		pla		sta	<icHand+2		jsr	lockic			;ic = (icHand) locked.ckDelete	lda	ExtCopy			;Extended copy?		bne	cutOutIcon		;Always remove if to Trash or desktop.		ldy	#icFlag			;Should the source icon be deleted?		lda	[<ic],y		and	#ICDELETE		beq	exit301		EXPORT	cutOutIconcutOutIcon		inc	DeleteFlag		Set delete flag	to signal change.		jsr	cutNfree		Take icon out of list (erased later).		bra	exit302			Branch around cause icon is gone now.exit301		ldy	#icFlag			Clear all copy related bits.		lda	[<ic],y		and	#Å(ICDUP+ICCOPY+ICDELETE)		sta	[<ic],yexit302		clc				Continue flag.		rts		; fix all the existing windows and desktop icons to be from the proper places;; IN: 	c1_pathname = new pathname;	c1_temppath = old pathname;	(X) = low word of handle to icon which is changing;	(Y) = hi word of handle to icon which is changing;.....................................................................		EXPORT	ChangePathFixPathChangePathFixPath				import	finderDPage		phb		phk		plb				phd		lda	finderDPage		tcd				pushZLong <TaskData		pushZLong <ic		pushZLong <icHand		pushZLong <windBlk		pushZLong <wind				stx	<icHand					sty	<icHand+2				lda	[<icHand]		sta	<ic		ldy	#2		lda	[<icHand],y		sta	<ic+2				jsr	findLastName			;don't trash <iconTrack or <windTrack or you'll		jsr	ckNames2			;be very sorry...				pulllong <wind		pulllong <windBlk		pulllong <icHand		pulllong <ic		pulllong <TaskData				pld		plb		rtl; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Get next event.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   a = event mask.;;  OUT:	   a = TRUE if event happened.;	   eventRec = event record.;		EXPORT	getNextEventgetNextEvent		pha				Space for result.		pha				Pass event mask.		pea	eventRec>>16		Pass pointer to	event.		pea	eventRec		_GetNextEvent		pla				Return event code.		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Get current Function	key state.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =		EXPORT	addFunctionKeyaddFunctionKey		lda	<zero			Ask for	a null event.		jsr	getNextEvent		lda	|eventRec+modifier	Save state of function key.		and	#$0800		ora	functionKey		sta	functionKey		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Count number	and types;	   of icons being dragged.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   Called by walkOfLife for every selected icon.;;   IN:	   ic =	pointer	to locked selected icon	being dragged.;	   icHand = ic's handle.;;  OUT:	   dragDisk = number of	disk icons being dragged.;	   dragDrive = number of drive icons being dragged. ;	   dragFile = numnber of file icons being dragged.;	   dragTrash = number of trash icons being dragged.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =countDrag		lda	<icHand			Save the handle	of the selected	icon.		sta	DragHandle		lda	<icHand+2		sta	DragHandle+2		ldy	#icFST			Check if icon is from network.		lda	[<ic],y		cmp	#AppleShareFST		bne	cont200		inc	dragNetworkcont200		ldy	#icFType		Check if icon dragged is special.		lda	[<ic],y		cmp	#TypeFolder		bne	next200			bra if not a folder		inc	dragFolder		had label inc200: not used (rdl 2/14/90)		bra	ok200next200		tax		bmi	next201			bra if itÕs a device or trash		inc	dragFile		bra	ok200next201		cmp	#TypeFTrash		bcc	next202			bra if not trash		inc	dragTrash		bra	ok200next202		cmp	#TypeFDrive		Floppy drive?		bne	ok201		inc	dragDriveok201		inc	dragDiskok200		ldy	#icFlag		lda	[<ic],y		and	#ICEXTENDED		beq	exit200		inc	dragExtexit200		clc				Continue flag.		rtsdragHandle	DS.B	4			Handle of selected icon, used when one.dragFile	DS.B	2			Number of file icons being dragged.dragDisk	DS.B	2			Number of disks	being dragged.dragDrive	DS.B	2			Number of 5.25"	drives being dragged.dragTrash	DS.B	2			Number of trash	cans being dragged.dragExt		DS.B	2			Number of extended icons being dragged.dragFolder	DS.B	2			Number of folders being	dragged.dragNetwork	DS.B	2			Number of folders being	dragged.; = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Cut icon out	of list.; = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   ic =	icon to	cut out	of list.;	   curWind = window owner.;;  OUT:	   temp	= trash.;;	   temp	= ic.icLast;	   if temp <> 0;		 temp =	(temp);		 temp.icNext = ic.icNext;	   else;		 wind->icon list = ic.icNext;;	   temp	= ic.icNext;	   if temp <> 0;		 temp =	(temp);		 temp.icLast = ic.icLast;		EXPORT	cutIconcutIcon				ldy	#icLast			temp = (ic.icLast)		jsr	geticPtr		beq	newHead;		ldy	#icNext			temp.icNext = ic.icNext		jsr	setValue		bra	skip20;newHead		ldy	#icNext+2		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	setIconHead;;skip20		ldy	#icNext		jsr	geticPtr		beq	exit20;		ldy	#icLast;;setValue	lda	[<ic],y		sta	[<temp],y		iny		lda	[<ic],y		sta	[<temp],yexit20		rts;;geticPtr	lda	[<ic],y		sta	<temp		iny		lda	[<ic],y		sta	<temp+1		beq	exit30;;; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Dereference temp handle.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;derefTemp		lda	[<temp]		tax		ldy	#1		lda	[<temp],y		stx	<temp		sta	<temp+1			Set not	equal flag.exit30		rts;????? somebody rewrite this for a little speed, please???  -- andy;   |;  \ /;   V;; = = =	= = = =	= = = =	= = = =	= =;	   Hit test icons.; = = =	= = = =	= = = =	= = = =	= =;;   IN:	   ic =	locked ICONOBJ to hit test.;	   yrat	= y poistion to	check.;	   xrat	= x position to	check.;	   windBlk = window's info block.;;  OUT:	   Carry clear if no hit.;; = = =	= = = =	= = = =	= = = =	= =		EXPORT	hitTesthitTest		jsr	getIconRect		Get icon's enclosing RECT.		ldy	#windView		Special	case view by text.		lda	[<windBlk],y		cmp	#viewByName		bcc	ok40		lda	#textLeft-8		When viewed by text, change the	area		sta	<irect1+x1		RECT to	go from	one side of the	window		lda	#640			to the other.		sta	<irect1+x2ok40		ldy	#irect2			Test hit in icon's title.		jsr	testRect		sta	nameHit			Remember if hit	on title.		bne	hit		ldy	#irect1			Test hit in icon's RECT.		jsr	testRect		beq	noHithit		sec				Terminate, icon	hit found.		rts   noHit		clc				Keep going flag.		rtstestRect		pha				Space for result.		jsr	pushyrat		Pass pointer to	point.		tya		jsr	pushzpage		Pass pointer to	RECT.		_PtInRect		pla		rts				ENDP		;====================================================;	   Search for a	window's owner icon.;====================================================;; This routine is called whenever a window is opened.  However,	it can be; called for different reasons.;;	   1. The owner	icons for every	window must be rechecked whenever a;	      window is	opened.	 This is the same as checking every icon in;	      the new window to	see if they are	currently open.;;	   2. When a window is opened from a FINDER.ROOT file its owner	icon;	      is unknown and must be found.;;  If the owner	icon is	not found, the disk icon is considered the owner.;;;   IN:	   C1_PathName = pathname to find nearest icon owner.;;  OUT:	   icHand = icon owner.;	   C1_PathName = trash.;	   C1_TempPath = trash.;	   NoRealMatch = TRUE if pathname did not match	an icon	and icHand is;			 the handle of the disk	icon belonging to the path.;; rdl 2/14/90: fixing BRC #53066: provided weÕre only checking directory windows; 		(not info wdws), then they can open only from folders or devices (incl trash).;		Replacing call to matchIcName w call to new routine matchDevIconName.;		It tests ag TypeFolder and TypeLastOne before going to matchIcName.;====================================================findOwnerIc	PROCNAME EXPORT		stz	NoRealMatch		Clear flag.		jsr	clonePath		C1_TempPath = C1_PathName; --- Chop off last name -----------------------------------------		jsr	chopLast		beq	useDesk			Any pathname left to check?;				      		lastName = last name in path.;				      		tempPath = pathname less last name.		lda	<deskic			Check devices on desktop.		sta	<icHand		lda	<deskic+2		sta	<icHand+2		pei	<direction		lda	tocall+1		pha		lda	#matchExtIcName		jsr	walkOfLife2		Carry set if match found (should have).		bcs	foundIt		pla		sta	tocall+1		pla		sta	<direction; --- First, try to find a window that the pathname matches -------------		lda	#DirWindID		Directory windows only.		ldx	#matchWindName		jsr	walkWindow		Look for a window that matches C1_TempPath.		ldy	#windIcons+2		Get handle of first icon in window,		lda	[<windBlk],y		just in	case.		tay		lda	[<windBlk]		bcs	ckIcList		Matching window	found?	Then find icon;					        inside the window that matches lastName.; ------ Now find icon in the window that matches 'C1_PathName' ---------------;   IN:	   C1_TempPath = C1_PathName.;  OUT:	   icHand = icon that matches first name in C1_TempPath.;	   lastName = trash.;	   C1_TempPath = trash.		EXPORT	findDiskfindDisk		@loop		jsr	chopLast		Chop off names until none are left.		bne	@loop		inc	NoRealMatch		Have to	match to root, not real	one.;						lastName = root icon.useDesk		lda	<deskic			Use disk icon instead.		ldy	<deskic+2		sta	<icHand			Handle of icon list to check.		sty	<icHand+2		pei	<direction		lda	tocall+1		pha		lda	#matchDeviceName	send folder or device to matchIcName		jsr	walkOfLife2		Carry set if match found.		bcs	foundit		bra	checkExtended;; ------ Now find icon in the window that matches 'lastName' ---------------;ckIcList	sta	<icHand			Handle of icon list to check.		sty	<icHand+2		pei	<direction		lda	tocall+1		pha		lda	#matchDevIconName	send folder or device to matchIcName		jsr	walkOfLife2		Carry set if match found.		bcs	foundit; ; --------- Couldn't find the icon, maybe it's an extended icon	-------------; checkExtended		lda	<deskic			Check extended icons on	disktop.		sta	<icHand		lda	<deskic+2		sta	<icHand+2 		lda	#matchExtIcName		jsr	walkOfLife2		Carry set if match found (should have).foundit		pla				; Exit with icHand = to owner icon.		sta	tocall+1		pla		sta	<direction		rts;; make sure itÕs a folder or a device before sending it to matchIcName.;matchDevIconName		ldy	#icFType		;Only check folder or device icons.		lda	[<ic],y		cmp	#TypeFolder		;Folder?		beq	okMatchIc		cmp	#TypeLastOne		; first number in disk range		bcc	exitmatchDev		; bra if not a device or trashokMatchIc	brl	matchIcName exitmatchDev	clc		rts;; make sure itÕs a device ONLY before sending it to matchIcName.;matchDeviceName		ldy	#icFType		Only check folder or device icons.		lda	[<ic],y		cmp	#TypeLastOne		; first number in disk range		bcc	exitmatchDev		; bra if not a device or trash		brl	matchIcName ; just match first window for which walkWindow is being called for;; IN: matchedFirst is reset;; OUT: matchedFirst is set;..................................................................... 		EXPORT	matchFirstmatchFirst	lda	#$FFFF		sta	matchedFirst		sec		rts		EXPORT	matchedFirstmatchedFirst	dc.w	0; match second window for which walkWindow is being called for;; IN: matchedSecond is either 0 or 1;; OUT: matchedSecond is incremnted;..................................................................... 		EXPORT	matchSecondmatchSecond	inc	matchedSecond		lda	matchedSecond		cmp	#2		bge	@done		clc		rts		@done		sec		rts		EXPORT	matchedSecondmatchedSecond	dc.w	0;   IN:	   wind	= window to compare.;	   C1_TempPath = C1_Pathname to compare.;.....................................................................		EXPORT	matchWindNamematchWindName						IMPORT	WStrCompare		jsr	windRefCon		;windBlk = window's info block pointer.		lda	<windBlk		clc		adc	#windPath		ldx	<windBlk+2enter100	bcc	@nr		inx@nr		pha				;space for result		phx				;ptr to 1st string		pha		PushLong #C1_TempPath		;ptr to 2nd string		jsl	WStrCompare		pla				;result (0 or 1)		cmp	#1		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Match extended icon to names. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   C1_TempPath = name to match icOwner field.;	   lastName = name to match icName field.;;  OUT:	   Carry set if	match. ;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =matchExtIcName		ldy	#icFlag			Only check extended icons.		lda	[<ic],y		and	#ICEXTENDED		beq	exit200; --- First, check where icon came from	----------------------------- 		ldx	<ic+2		lda	<ic		clc		adc	#icOwner		jsr	enter100		bcc	exit200			No match?; --- Now check	name ------------------------------------------------ 		brl	matchIcName exit200		clc		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Chop	last name from C1_TempPath.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;; IN:	C1_TempPath = pathname.;; OUT:	lastName = last name in path (no separator).;	C1_TempPath = original pathname	less last name and separator.;	BEQ if C1_TempPath is a null string.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=chopLast		sep	#$20		LONGA	OFF		ldx	C1_TempPath		stz	C1_TempPath+2,x		;mark end of string	@loop		lda	C1_TempPath+1,x		cmp	#SEPARATOR		;GS/OS separator character		beq	gotit		dex		bne	@loop				rep	#$20		LONGA	ON		rts		LONGA	OFFgotit		dex		stx	C1_TempPath		inx		ldy	<zero@loop2		inx		iny		lda	C1_TempPath+1,x		sta	lastName,y		bne	@loop2		dey		tya		sta	lastName		REP	#$20					LONGA	ON		lda	C1_TempPath		Return Equal TRUE if no	more pathname.		rts		ENDP;===============================;	   Open	an icon.;===============================;;   IN:	   ic =	pointer	to locked ICONOBJ to be	opened.;	   windBlk = pointer to	icon window's info block.;;  OUT:	   AbortFind = not zero to quit.;===============================openIcon	PROCNAME EXPORT		IMPORT	SaveDevStats		IMPORT	PStringCompare		IMPORT	PStringCopy		IMPORT	WStringCopy		IMPORT	doAlertWindow		import	PendingDeselectAll		inc	PendingDeselectAll	;5-Jun-92 DAL		lda	OpenFlag		;Special flag?		beq	ok$		brl	openFolder		;I know the window has to be created.; --- You can never tell if disk icons are already open	by their flag --------ok$		ldy	#icFType		;Is this a disk icon being opened?		lda	[<ic],y		cmp	#TypeFDrive		;Floppy drive icon?		bne	next2;; open floppy drive;		ldy	#icDevNum		;Pass the floppy drive's device number.		lda	[<ic],y				sta	dinfo_devnum		pha				; space for result		PushWord #app2Evt		; event code (application defined)		PushWord #$0000			; event message (hi word) = Ejected Disk		PushWord dinfo_devnum		; event message (lo word) = device #		_PostEvent		PushWord #app2Evt		; event code (application defined)		PushWord #$8000			; event message (hi word) = Inserted Disk		PushWord dinfo_devnum		; event message (lo word) = device #		_PostEvent		pla				; ignore result		rts;; trash can opened;next2		cmp	#TypeFTrash		;Trash can?		bcc	next3;; open trash can;		export OpenTheTrashCanOpenTheTrashCan	jsr	markOpen		;Mark and draw trash icon as open.;; Check	if Trash window	already	visible:;		ldy	#icWind+2		;Place window pointer in icWind.		ldx	<TrashWind+2		txa		sta	[<ic],y		dey		dey		lda	<TrashWind		sta	[<ic],y		jmp	wind2top;; check if icon has read access;next3		ldy	#icFlag+2		;Is this icon readable?		lda	[<ic],y		and	#ICREADABLE>>16				bne	next4		jsr	makeIcRoot		;C1_PathName = separator + icName				stz	modifiers		;don't auto-close the window if they were tunneling				lda	#rasNoAccess2		jsl	doAlertWindow		;tell user they don't have access rights		sec		rts;; Check if a directory window already exists;next4		ldy	#icFType		;Is this	a folder being opened?		lda	[<ic],y		cmp	#TypeFolder		;Folder?		beq	ok6		tax		bmi	ok6			;3.5', 5.25', RAM, Hard drive, other device?						;else a document or application to be launched		brl	launch			;If not, try application or document.;; open a folder or device into its window;ok6		jsr	getwRefCon		;windBlk = icon's window info block.		jsr	buildPath		;C1_PathName = icon's pathname.		bcs	error100		;Pathname error?		lda	C1_PathName		;Open no windows without room for files.		cmp	#MaxPathLen		bcc	ok9				stz	modifiers		brl	lenErrorerror100	rtsok9		jsr	clonePath		;C1_TempPath = C1_PathName.		lda	#DirWindID		;Directory windows only.		ldx	#matchWindName		;Check for match.		jsr	walkWindow		bcc	openFolder		;Create a window if it doesn't exist.		brl	selectWind		;Call _SelectWindow with 'wind'.; --- Open a new directory window ---------------------------------------;;   IN:	   curWind = window that owns icon being opened.;	   icHand = handle of icon being opened.;;  OUT:	   Carry set if	unable to open window.	Open loop should be aborted.;;-----------------------------------------------openFolder	name	FinderInfo	RECORD	0location	DS.W	2			; folder's locationwindRect	DS.W	4			; folder's rectanglewindView	DS.W	1			; folder's viewwindScroll	DS.W	2			; scroll position		ENDR 		IMPORT	c1_BootName		IMPORT	AtCatalogEntry		IMPORT	StrSystem		IMPORT	WStrCompare		IMPORT	ce_access		IMPORT	ce_flags		IMPORT	OptionBuff		IMPORT	OptionBuffFST		IMPORT	PStringCompare		IMPORT	info_mdate		IMPORT	GetFinderInfo		IMPORT	PStringCompare		IMPORT	findOwnerIc		IMPORT	PStringAlphabetize		IMPORT	read_file2		IMPORT	oldZoom		IMPORT	FolderColor		IMPORT	AbortFind		IMPORT	ckIfWindMax		IMPORT	OOMDump		jsr	ckIfWindMax		;Check if there is enough memory for a 		bcs	exit3			;window to be created		jsr	ckIfInTrash		Is the item in the Trash?		bcc	ok1exit3		rts				Abort opens in Trash.ok1		jsr	lockic			;ic = (icHand) locked.		jsr	getWoffset		;Set global offsets of port's origin.		jsr	endDraw			;Put window back to 0,0.;; build the window's pathname, allocate a window info block for the window;		EXPORT	openFolder2openFolder2	name			jsr	buildPath		;C1_PathName = window's pathname.		bcc	@pathOK			;Pathname error?		rts@pathOK		lda	C1_PathName		;Open no windows without room for files.		cmp	#MaxPathLen		bcc	@pathLenOK				stz	modifiers		brl	lenError@pathLenOK		;		lda	#windPath;		clc;		adc	c1_pathname;		inc	a;		inc	a			;Number of bytes to allocate		lda 	#WINDBLKSIZE		;@@@ TEMPORARY! (Maybe)		ldx	#$4000			;Fixed block, cause of window's title.		jsr	allocate2		;Allocate the memory.		bcc	@windBlkOK				jsl	OOMDump		bcc	@noDump		lda	#rasMemErr		jsl	doAlertWindow@noDump		stz	modifiers		;make sure the desktop doesn't auto-close						;a window if they were tunneling		inc	abortFind		sec		rts		@windBlkOK	sta	<temp			;Save handle.		stx	<temp+2		jsr	setTemp			;Dereference 'temp'.		sta	wind_ref		;RefCon = address of information block.		stx	wind_ref+2		sta	wind_infot		;Set info bar refCon also.		stx	wind_infot+2		clc				;Compute address of title.		adc	#windTitle		bcc	store1		inxstore1		sta	wind_title		stx	wind_title+2		sta	<work			;Remember title's address.		stx	<work+2		lda	<zero			;Clear the info block.		ldy	#windPath-2		;Number of bytes in block.lop12		sta	[<temp],y		dey		dey		bpl	lop12		sta  	[<temp]			;in case of odd length		jsr	geticNamePtr		;temp = pointer to ic's name;; add this window into the window's menu bar;		lda	wind_ref		;setup work to point to out menu item		clc		adc	#windMenuText		sta	insertItemRef+10		lda	wind_ref+2		adc	<zero		sta	insertItemRef+12		pushZlong <temp 		;src (yes, the icon from which this is fetched must		pushlong insertItemRef+10	;dest (still be around at this point, do tunneling		jsl	PStringCopy		;afterwards)		jsr	padName			;Build window's padded title;; now that we've allocated a window info block, start filling it in with all the; important stuff;		EXPORT	openFolder3openFolder3	name		IMPORT	C1_PathNamePtr		import	frqGlobalError		IMPORT	C1_SystemName		IMPORT	c1_source		IMPORT	PathGetRoot		IMPORT	RectListPtr		IMPORT	info_access		import	ce_file_type		import	ce_aux_type		import	ce_prodos_entry		import	ce_mod_date		import	ce_create_date		import	AccessPriv		import	FreeInfoBlk		import	write_len		import	FreeAllIcons		import	textAlert		import	MemoryFull		import	OfflineMasks		import	OnlineMasks		import	ce_entry_num		import	LotsOfFilesAlert		import	Finfo		import	walkback		import	cutnfree		import	LongGSOSError		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM				jsr	setInfoPtr		;windBlk = wind_ref.lop11		jsr	doGetFileInfo		;Check for valid pathname.		sta	>frqGlobalError		bcs	error				lda	info_type		;Must be a folder or a volume.		cmp	#TypeFolder		beq	ok7		lda	#frqErrFailed		sta	>frqGlobalErrorerror		ldx	OpenFlag		;Ignore error when doing a special open.		bne	cancel		cmp	#$44		beq	@notFound		cmp	#$45		beq	@notFound		cmp	#$46		beq	@notFound				ldx	#GET_FILE_INFO+C1		jsl	LongGSOSError		bcs	cancel		brl	lop11		@notFound	pushlong #c1_source		;c1_filename is root of c1_pathname		pushlong #c1_pathname		jsl	PathGetRoot		lda	>c1_source		and	#$00ff		dec	a		xba			sta	>c1_source+1		lda	#rasInsertDiskorCancel8		jsl	doAlertWindow		beq	cancel		brl	lop11cancelerror101	jsl	arrowCursor		brl	freeInfoBlk		;Free allocated info block and exit.ok7		lda	info_access		;don't allow opening windows from		and	#$0004			;invisible folders if the show invisible		beq	@notInvisible		;files flag is OFF				lda	prefer		and	#pref_hdata		;hide invisibles?		beq	@notInvisible		;nope, so allow it to be opened				lda	#frqErrFailed		;otherwise, hide invisibles means you can't		sta	>frqGlobalError		;open folders from one... ack!		bra	cancel		@notInvisible	PushLong #C1_PathName		lda	<windBlk		clc		adc	#windPath		ldx	<windBlk+2		bcc	@nr		inx@nr		phx		pha		jsl	WStringCopy		;move C1_PathName into info block;; set this window's mod date;		ldy	#windDate+6		ldx	#6@dateLoop	lda	info_mdate,x		sta	[<windBlk],y		dey		dey		dex		dex		bpl	@dateLoop;; use network finder info;		stz	typeOfFData				stz	read_len		;no finder.data yet		stz	<posFile		stz	<posFile+2		lda	OptionBuff+4		;Check our FST		cmp	#AppleShareFST		beq	@onNetwork		; yes, so children will also be there		stz	NetworkBit		brl	localData		; no, so don't get Finder Info					;; don't even -TRY- putting the following inline.  I tried late one night and it was; a large pain in the rear.  If are seriously considering this, they must not have; given you enough work to do.  Call your manager and tell him to give you more work.;@onNetwork	lda	#icNetwork>>16		sta	NetworkBit		PushLong #C1_PathName				PushLong #FInfo		jsl	GetFinderInfo		bcc	good		brl	ok2				; find window a positiongood		ldx	#6				; set window's rect@loop		lda	>FInfo+FinderInfo.windRect,x		sta	wind_pos,x		dex		dex		bpl	@loop				lda	>FInfo+FinderInfo.windView	; set window's view		ldy	#windView		sta	[<windBlk],y;		lda	>FInfo+FinderInfo.windScroll	; set scroll bar offsets;		sta	wind_voff;		lda	>FInfo+FinderInfo.windScroll+2;		sta	wind_hoff		stz	wind_voff			;force scroll bars to top		stz	wind_hoff				lda	wind_pos+y1		ora	wind_pos+x1		ora	wind_pos+y2		ora	wind_pos+x2		bne	cont3		brl	ok2				; use default window positioncont3		brl	ok3;; try to read the directory's position file from finder.data;localData	lda	<modifiers		and	#$1000		beq	@noControlKey		brl	ok2@noControlKey				lda	C1_PathName		Save current pathname's length.		pha		jsr	addDataName		Add name of finder data	filename.		bcc	@ok		pla		sta	C1_PathName		brl	error102		Pathname error?@ok				lda	#FDataSize		;read the first bytes of a new style finder.data		sta	read_size		;file (maybe not)		stz	read_size+2		ldx	#$8000			Allocated the buffer as	locked (not fixed!)		jsr	allocate2		Allocate a buffer.		sta	<posFile		Save handle.		stx	<posFile+2		bcs	@bad			Allocation error?		jsr	derefHand		temp = (posFile).		lda	<temp		sta	read_buff		lda	<temp+2		sta	read_buff+2		ldx	#C1_PathName		ldy	#^C1_PathName		lda	#$0001			; open read only		jsr	open_file@bad		pla		sta	C1_PathName		bcs	goOK2		jsr	read_file2		bcs	badRead		lda	[<temp]		sta	typeOfFData		cmp	#FinderVer		beq	newFinder		cmp	#1		bne	badRead		brl	oldFinderbadRead		stz	read_len		jsr	close_filegoOK2		brl	ok2;; newFinder -- read the remainder of the finder.data file into a buffer which we'll; 	       resize to fit the amount of data yet to be read;newFinder	name		ldy	#4			;unlock handle		lda	[<posFile],y;;;		and	#$7fff		asl a		lsr a		sta	[<posFile],y		ldy	#FDataStartAt		lda	[<temp],y		clc		ldy	#FDataRecSize		adc	[<temp],y		tax		iny		iny		lda	[<temp],y		adc	<zero		pha		phx		pei	<posFile+2		pei	<posFile		_SetHandleSize		bcs	newFError		ldy	#4			;lock the handle		lda	[<posFile],y		ora	#$8000		sta	[<posFile],y		lda	<posFile		;Save handle.		ldx	<posFile+2		jsr	derefHand		;temp = (posFile).		ldy	#FDataStartAt		;set the mark to the beginning of our data		lda	[<temp],y		jsr	doSetMark		ldy	#FDataRecSize		lda	[<temp],y		sta	read_size		iny		iny		lda	[<temp],y		sta	read_size+2				ldy	#FDataStartAt		lda	[<temp],y		clc		adc	<temp		sta	read_buff		lda	<temp+2		adc	<zero		sta	read_buff+2				jsr	read_file2				php		jsr	close_file		plp		bcs	newFError		brl	error102		newFError	pushZLong <posFile		jsl DisposeHandleGlue		stz	<posFile+1		stz	read_len		brl	ok2;; oldFinder -- read an old finder data file (given that we have one already open) ;oldFinder	name		ldy	#4			;unlock handle		lda	[<posFile],y;;;		and	#$7fff		asl a		lsr a		sta	[<posFile],y				pei <zero		pea FDataBufSize-FDataSize		pei	<posFile+2		pei	<posFile		_SetHandleSize		bcs	oldFError				ldy	#4			;lock the handle		lda	[<posFile],y		ora	#$8000		sta	[<posFile],y				lda	<posFile		;Save handle.		ldx	<posFile+2		jsr	derefHand		;temp = (posFile).		lda	#FDataBufSize-FDataSize		sta	read_size		stz	read_size+2				lda	<temp		clc		adc	#FDataSize		sta	read_buff		lda	<temp+2		adc	<zero		sta	read_buff+2		jsr	read_file2			php		jsr	close_file		plp		bcc	error102		oldFError	pushZLong <posFile		jsl DisposeHandleGlue		stz	<posFile+1		stz	read_len		brl	ok2error102	lda	read_len		Is there anything in the buffer?		beq	ok2			If not,	do a manual position.		ldy	#x2+2			Set the	position and size of the window.@loop		lda	[<temp],y		sta	wind_pos-2,y		dey		dey		bne	@loop		ldy	#FDyOrg			Set window's starting origin.		lda	[<temp],y		sta	wind_voff		iny		iny		lda	[<temp],y		sta	wind_hoff		iny				Set window's view.		iny		lda	[<temp],y		ldy	#windView		sta	[<windBlk],y				bra	ok3;; Find the window a position;WhichWindow	dc.w	0ok2				stz	matchedFirst		lda	#DirWindID+TrashWindID		ldx	#matchFirst				jsr	walkWindow		lda	matchedFirst		bne	@notTopWindow				stz	WhichWindow		@notTopWindow	stz	wind_voff		stz	wind_hoff		lda	WhichWindow		and	#7		asl	a		asl	a		asl	a		inc	a		inc	a		tay				lda	rectListPtr		sta	<ptr		lda	rectListPtr+2		sta	<ptr+2				ldx	<zero@loop		lda	[<ptr],y		sta	wind_pos,x		iny		iny		inx		inx		cpx	#8		blt	@loop		inc	WhichWindow;; find out which icon owns this window (if any);ok3				jsr	findOwnerIc		lda	wind_ref		Get pointer to window's info block.		sta	<windBlk		lda	wind_ref+2		sta	<windBlk+2		ldy	#windIc+1		Mark 'this window's owner icon		lda	<zero			has not	been found' flag		sta	[<windBlk],y		ldy	#windID			Directory window ID number.		lda	#DirWindID		sta	[<windBlk],y		jsr	lockic			ic = (icHand) locked.		ldy	#windAccess		lda	<zero		sta	[<windBlk],y				lda	NetworkBit		beq	@notOnNetwork		 		lda	OptionBuff+$2a		;our folder's privileges as gotten by GetFileInfo		and	#icNetAccess>>16	;$000F		ora	#icNetwork>>16		;add the network bit into this		ldy	#windAccess		sta	[<windBlk],y@notOnNetwork;; Fill out the windDiskIc field from the DiskIc field of the owner icon;		ldy	#icDisk		lda	[<ic],y		ldy	#windDiskIc		sta	[<windBlk],y				ldy	#icDisk+2		lda	[<ic],y		ldy	#windDiskIc+2		sta	[<windBlk],y;; make our window inherit the view of the parent if the window doesn't have a finder; data file and if the window isn't on the network;		lda	read_len		bne	@hasFinderData				lda	NetworkBit				bne	@hasFinderData		ldy	#icMom			;get the parent window of the		lda	[<ic],y			;icon which opened into our window		tax		iny		iny		lda	[<ic],y		cmp	<deskPort+2		;DON'T inherit if it's an icon		bne	@notDesk		;without finder data right on the		cpx	<deskPort		;desktop!		beq	@hasFinderData@notDesk		pha		pha		pha		phx		_GetWRefCon			;get the refcon (could not be desktop)		pulllong <temp				ldy	#windView		lda	[<temp],y		cmp	#viewByKind+1		bge	@hasFinderData		;crap protection