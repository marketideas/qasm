n		;Is there a buffer?		sta	posFlag			;Set flag that tell 'windSpot' there is		beq	@noFinderData		brl	hasFinderData		;a position file pointed to be 'temp'.;; if there isn't a finder.data file to use to position the icons, do it by hand since we're not; going to magically get a finder.data file halfway through this process, it's safe to just keep; moving the icon positions to the right until we're out of the window, in which case we just; move down and back over to the left.;@noFinderData		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		beq	bySmallIcon		brl	byLargeIconbySmallIcon	ldy	#20			;magic offset to window's portrect Y2		lda	[<wind],y		sec		ldy	#16			;magic offset to window's portrect Y1		sbc	[<wind],y		sta	bottom@nextRow	inc	row				lda	row		cmp	#64			;extra protection just in case		bge	@newColumn				lda	iconPos+y1		clc		adc	#10		sta	iconPos+y1				ldx	filesInFolder		;if we have >= 500 files, then always use columns of 64		cpx	#500			;files so we don't overflow quickdraw's conceptual		bge	@inWindow1		;drawing space (+16k, -16k)					clc		adc	#10		cmp	bottom		bcc	@inWindow1		@newColumn	stz	row				lda	iconPos+x1		clc		adc	#150		sta	iconPos+x1				stz	iconPos+y1		@inWindow1	lda	row			;divide the row by 8 to use as an index		lsr	a		lsr	a		lsr	a		tay		lda	row		and	#$7		tax				sep	#$20		LONGA OFF				lda	rowbits,y		;find out if the last row intruded here		and	>OnlineMasks,x				pha		lda	rowbits,y		;and reset the intrusion indicator		and	>OfflineMasks,x		sta	rowbits,y		pla						LONGA ON		rep	#$20			;if the last row to the left intruded into this column,		bne	@nextRow		;then we need to try the next row down				lda	iconPos+y1		clc		adc	#10		sta	<yrat		lda	iconPos+x1		sta	<xrat				pha				;now that we placed the icon, see if the name makes the		pushZLong <work			;icon intrude in the next column		_StringWidth		pla		cmp	#128		blt	@goSkip20				lda	row			;divide the row by 8 to use as an index		lsr	a		lsr	a		lsr	a		tay		lda	row		and	#$7		tax				sep	#$20		LONGA OFF				lda	rowbits,y		ora	>OnlineMasks,x			sta	rowbits,y				LONGA ON		rep	#$20@goSkip20	brl	skip20				;; locals for small icon positioning;row		dc.w	0rowbits		ds.b	8			;if we have more than 64 rows, we've got problemsbottom		dc.w	0				;; If we end up here, the window is being viewed by icon or a list view, so we assign the default icon; positions when the view is changed to be by small icon or icon;byLargeIcon	lda	positioned		bne	@position		inc	positioned		bra	@inWindow		@position	lda	iconPos+x1		;look to the right		clc		adc	#106		sta	iconPos+x1				ldx	filesInFolder		;if there are >= 500 files, ignore thr right edge of the		cpx	#500			;window and hopefully place a lot of files within the view		blt	@widthCompare					cmp	#1000		bcc	@inWindow		bge	@atLeft		@widthCompare	ldy	#22			;magic offset to wind's portrect X2		cmp	[<wind],y		;off right of window?		bcc	@inWindow			@atLeft		lda	#52+14			;Start again on left side if so		sta	iconPos+x1		lda	iconPos+y1		;next row down.		clc		adc	#32				sta	iconPos+y1		@inWindow	lda	iconPos+y1		clc		adc	#10		sta	<yrat		lda	iconPos+x1		sta	<xrat		brl	skip20hasFinderData				lda	typeOfFData		cmp	#FinderVer		beq	newFinderData		brl	oldFinderData;; newFinderData -- match icon positions as if the new finder.data files is being; 		   used;newFinderData	name				lda	lookingAt		sta	startedAt		@loop		lda	lookingAtAddr+2		sta	<temp+2		lda	lookingAtAddr		sta	<temp		clc		adc	#iconPOSname		tax		lda	<temp+2		adc	<zero		pha		pha		phx		pushZLong <work		jsl	pStringCompare		pla		bne	matchedNew				inc	lookingAt		lda	lookingAt		cmp	itemsInFData		blt	@next		stz	lookingAt				lda	startOfRecords		sta	lookingAtAddr			lda	startOfRecords+2		sta	lookingAtAddr+2		lda	lookingAt		;did we wrap around?		cmp	startedAt		beq	noMatchNew		;yep, so we failed to find the icon... bummer		bra	@loop		@next		lda	lookingAt		;did we wrap around?		cmp	startedAt		beq	noMatchNew		;yep, so we failed to find the icon... bummer		lda	<temp		sec				;always add one more so we start at the (true)		adc	[<temp]			;next record		sta	lookingAtAddr		lda	<temp+2		adc	<zero		sta	lookingAtAddr+2		bra	@loop		noMatchNew	pushZLong <work		jsr	windSpot		;Find the icon a spot in the window.		pulllong <work		brl	skip20		matchedNew	lda	ticonobj+icFlag		;Get lock flag,		and	#$00FF			;and dump color.		sta	ticonobj+icFlag		ldy	#iconPOSColor		;Get index to ICONPOS record.		lda	[<temp],y		;Get IPOSflag.		tax				;Save flag.		and	#$FF00			;Get color.		ora	ticonobj+icFlag		sta	ticonobj+icFlag		;Set color.		iny		iny		lda	[<temp],y		;Get IPOSy,		sta	<yrat		iny		iny		lda	[<temp],y		;and IPOSx		and	#$fffe			;always make it even -- andy, 1/15/91		sta	<xrat		inc	lookingAt				lda	lookingAt		cmp	itemsInFData		blt	@next				stz	lookingAt				lda	startOfRecords		sta	lookingAtAddr			lda	startOfRecords+2		sta	lookingAtAddr+2		brl	skip20		@next		lda	<temp		sec				;one extra to get to next record		adc	[<temp]		sta	lookingAtAddr		lda	<temp+2		adc	<zero		sta	lookingAtAddr+2		brl	skip20;; local locals;filesInFolder dc.w	0			;total number of files in folder when we opened folderpositioned	dc.w	0			;did we position any icons yet?iconPos		dc.w	0			;y		dc.w	0			;xtypeOfFData	dc.w	0			;1 = old, 2 = new finder.dataitemsInFData	dc.w	0lookingAt	dc.w	0startedAt	dc.w	0startOfRecords	dc.L	0lookingAtAddr	dc.L	0		;; oldFinderData -- match icon positions as if the old finder.data file is being used;oldFinderData		lda	<posFile		;Save handle.		ldx	<posFile+2		jsr	derefHand		;temp = (posFile).		ldy	#FDiconPos		;Offset to first icon in buffer.lop20		lda	[<temp],y		bne	ok22			;Any more icons?		pei	<work+2		pei	<work		jsr	windSpot		;Find the icon a spot in the window.		pla		sta	<work		pla		sta	<work+2		bra	skip20ok22		ldx	<temp+2			;compute offset to name		tya		clc		adc	<temp		bcc	ok20		inxok20		clc		adc	#IPOSname		bcc	nameCompare		inx;--- new way -----------------------------------nameCompare	phy				;save index to ICONPOS record		pha				;space for result		phx				;pass pointer to icon's name		pha		PushZLong <work			;pass pointer to entry's name		jsl	PStringCompare		pla		bne	match		pla				;Next ICONPOS.		clc		adc	#IPOSSIZE		tay		bra	lop20match		lda	ticonobj+icFlag		;Get lock flag,		and	#$00FF			;and dump color.		sta	ticonobj+icFlag		ply				;Get index to ICONPOS record.		lda	[<temp],y		;Get IPOSflag.		tax				;Save flag.		and	#$FF00			;Get color.		ora	ticonobj+icFlag		sta	ticonobj+icFlag		;Set color.		iny		iny		lda	[<temp],y		;Get IPOSy,		sta	<yrat		iny		iny		lda	[<temp],y		;and IPOSx		and	#$fffe			;always make it even -- andy, 1/15/91		sta	<xratskip20		stz	<devNumber		;Files and folders don't have device #.		lda	ce_access		sta	ticonobj+icLocalAccess		lda	ce_flags		sta	ticonobj+icForked		ldy	OptionBuff+2@loop		lda	OptionBuff+2,y		sta	ticonobj+icOptionList,y		dey		dey				bpl	@loop		lda	OptionBuff+4		cmp	#$0d		bne	@notFromNetwork		lda	<filetype		cmp	#$0f		bne	@notFromNetwork				lda	OptionBuff+$2A		;munge the owner bit of the user summary byte into		and	#$0080			;our icon flag stuff		lsr	a		lsr	a		lsr	a		lsr	a		tsb	ticonobj+icFlag+2				lda	OptionBuff+$2A		and	#$000F			;is user icon's owner (on network)		tsb	ticonobj+icFlag+2				lda	ticonobj+icFlag+2		and	#icNetAccess>>16		sta	AccessPriv				bra	@wasFromNetwork@notFromNetwork	stz	ticonobj+icNetworkAccess		stz	ticonobj+icNetworkAccess+2@wasFromNetwork;; see if this is the icon for the system folder or not;				lda	<filetype		cmp	#$0F			;is icon a folder?		bne	@notSYSTEM		;no				stz	auxtype					pha		pushZLong <work		pushlong #strSystem		jsl	PStringCompare		pla		beq	@notSystem		pha				;space for result		PushLong #C1_PathName		PushLong #C1_BootName		jsl	WStrCompare		;is this the boot disk ?		pla		beq	@notSYSTEM		;no				lda	#$0002			;yes, so mark system folder		sta	auxtype@notSYSTEM;; now, make an icon object for our directory entry;		lda	<work			Pass pointer to	directory entry's name.		ldx	<work+2		ldy	#1			;add icons to the TAIL of the icon list		jsr	addIconObj		;Create and add the icon to the window.		bcc	@addIconOK		lda	AtCatalogEntry		beq	@goAbort			pushZLong <curWind		lda	<wind		sta	<curWind		lda	<wind+2		sta	<curWind+2		stz	iconsKilled				lda	#killAFewIcons		jsr	walkBack				pulllong <curWind				lda	AtCatalogEntry		beq	@goAbort		cmp	#$FFFF		beq	@goAbort				lda	iconsKilled		cmp	#24576/ICSIZE		bcs	done4@goAbort	brl	IconAbort;; We added the icon OK, so keep going...;@addIconOK	inc	AtCatalogEntry		;say we're at the next catalog entry		brl	lop4			;^^ used by addIconObjdone4		lda	<posFile+1		Is there a position buffer to free?		beq	skip2		pei	<posFile+2		Free the position buffer.		pei	<posFile		jsl DisposeHandleGlueskip2		ldx	#xEndCatalog		jsl	MiscEntry		stz	spotHashOn		Turn spot hashing off.		ldy	#windView		Does the window	have a text view?		lda	[<windBlk],y		cmp	#viewByName		bcc	skip3		jsr	sort			Best do	a sort to set positions, order.skip3		jsr	newDataSize2		Set window's data size.;; Finally, relink any windows on the desktop to icons in the window which we just; opened;			lda	#DirWindID		Directory windows only.		jsr	getFrontWind		Get front most window.		bne	lop300		brl	done300			Are there any windows?lop300		jsr	getWindPath		C1_PathName = window's pathname.		pei	<windBlk+2		pei	<windBlk		pei	<wind+2		pei	<wind		jsr	findOwnerIc		Find the nearest icon that opened into		pla				this window.		sta	<wind		pla		sta	<wind+2		pla		sta	<windBlk		pla		sta	<windBlk+2		ldy	#windIc+2		Get the	old icon that opened window.		lda	[<windBlk],y		tax		dey		dey		lda	[<windBlk],y		cmp	<icHand			Is it a	new icon?		bne	newIcon		cpx	<icHand+2		beq	next1			If not,	there's nothing to do.newIcon		phx				Save the old icon.		pha		lda	<icHand+1		;if the root icon couldn't be found then 		bne	@ok			;DON'T MESS WITH IT		pla		plx		bra	next1@ok		lda	<icHand			Save new opened	icon in	window.		sta	[<windBlk],y		iny		iny		lda	<icHand+2		sta	[<windBlk],y		lda	NoRealMatch		If this	icon isn't really the window's		bne	skip5			icon then don't mark as open.		jsr	lockic		ldy	#icWind			Put icon's open window in icon record.		lda	<wind		sta	[<ic],y		iny		iny		lda	<wind+2		sta	[<ic],y		jsr	markOpen		Mark and draw icon as open.		jsr	unlockicskip5		pla				Get icon that is no longer open.		sta	<icHand		pla		sta	<icHand+2		lda	<icHand+1		Valid handle?		beq	next1		jsr	lockic		ldy	#icWind			Is this	really the icon's window?		lda	[<ic],y		cmp	<wind		bne	skip6		iny		lda	[<ic],y		cmp	<wind+1		bne	skip6		jsr	markClosed		Mark old icon as closed.skip6		jsr	unlockicnext1		jsr	getNextWind		Get next directory window.		beq	done300		brl	lop300			Any more windows?done300		lda	MyLocalWinPtr		ldx	MyLocalWinPtr+2		jsr	setInfo2		Set window's information bar values.		stz	posFlag			Reset flag to 'no position file'.*** added 25-Mar-93 DAL -- Now it's safe to update our window in the background		pushlong #wind_guts+$C0000000		pushlong MyLocalWinPtr		_SetContentDraw*** end 25-Mar-93;; now we have to find out which item id is not used after $f000, so we have to linearly try them; all until someone gives us an error -- dave astutely notes that this will be faster than walking; the list of windows looking for the first unused menuItemID;; but don't worry about adding the checkmarks for which window is at front because that'll get done in; the main loop by CheckFront;.....................................................................		EXPORT	addWindow2MenuaddWindow2Menu 	name		ldx	#$f000@nextItemID	phx		pha				;put us in this loop until we run outta gas and find an open		pha				;menu item ID		phx		_GetMItem		pla		pla		plx		bcs	@useThisOne		inx		cpx	#$ff00		blt	@nextItemID		rts				;don't insert it if we have a zillion windows open		@useThisOne	stx	insertItemRef+2		stz	matchedSecond		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#matchSecond				jsr	walkWindow		lda	matchedSecond		cmp	#2		bge	@notAtFirst		lda	wind_ref		sta	<deref		lda	wind_ref+2		sta	<deref+2		lda	insertItemRef+2		;save the window item we just got in our window block so that we can		ldy	#windMenuItem		;go do neat stuff with it later		sta	[<deref],y				pea	idNoWindowsOpen		;yes, so get rid of that ugly "no windows open" stuff		_DeleteMItem		pei <zero			;refIsPtr		pushlong #insertItemRef		pea	idWindowsDivider	;add after the dividing line		pea	idWindowsMenu		_InsertMItem2		bra 	@calcWindMenuSize@notAtFirst	lda	wind_ref		sta	<deref		lda	wind_ref+2		sta	<deref+2		lda	insertItemRef+2		;save the window item we just got in our window block so that we can		ldy	#windMenuItem		;go do neat stuff with it later		sta	[<deref],y		stz	windPtr			;say we initially compare against nada		stz	windPtr+2		lda	#idWindowsDivider	;say we should insert after the dividing line		sta	windowID		;(initially, before our walk through the window list)				lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#windCompare				jsr	walkWindow								pei <zero			;refIsPtr		pushlong #insertItemRef		lda	windowID		;add after this window's ID		pha		pea	idWindowsMenu		_InsertMItem2@calcWindMenuSize		lda <zero			;fix the windows menu for the new window		pha		pha		pea	idWindowsMenu		_CalcMenuSize		clc		rts		;; Two abort routines when opening Windows and we get into deep shit;IconAbort	stz	spotHashOn		lda	#$FFFF		sta	write_len		jsr	FreeAllIcons		;get rid of all the icons in the window				ldx	#xEndCatalog		jsl	MiscEntry		jsr	freeInfoBlk		;Free window's info block.		dec	myWindCount		Decrement my window counter.		lda	<wind		ldx	<wind+2		jsl	CloseThisWindow				lda	<posFile+1		;Is there a position buffer to free?		beq	@noPosFile		pei	<posFile+2		;Free the position buffer.		pei	<posFile		jsl DisposeHandleGlue		@noPosFile	stz	modifiers		;make sure the desktop doesn't auto-close						;a window if they were tunneling		inc	abortFind		sec		rts; KillAFewIcons -- walk backwards and kill 24K/ICSIZE icons;.....................................................................KillAFewIcons	lda	iconsKilled		cmp	#24576/ICSIZE		bge	@done		lda	AtCatalogEntry		cmp	#$FFFF		beq	@done				jsr	CutNFree		inc	iconsKilled		dec	AtCatalogEntry@done		clc		rts;; locals;iconsKilled	dc.w	0; setDefaultWindowPos -- set the default window position before creating the window;.....................................................................setDefaultWindowPos		lda	#dfltWinY1		;Reset the next window position.		sta	nextWindPos+y1		lda	#dfltWinX1			sta	nextWindPos+x1		lda	#dfltWinY2		sta	nextWindPos+y2		lda	#dfltWinX2		sta	nextWindPos+x2		rts; addIWindow2Menu -- add the info window to the menu;.....................................................................		EXPORT	addIWindow2MenuaddIWindow2Menu		phb		phk		plb				pushZLong <windBlk		jsr	addWindow2Menu		pulllong <windBlk				plb		rtl		;; our window finder;;   IN:	   wind	= window to compare.;;   OUT:   windPtr = pointer to window which gives us the closest match;	   windID = ID for window which gave us the closest match;; and remember, if windPtr is NIL, then we're just going to insert at the top of the list;.....................................................................windCompare	jsr	windRefCon		;windBlk = window's info block pointer.		lda	<windBlk		cmp	wind_ref		bne	@notOurs		lda	<windBlk+2		cmp	wind_ref+2		bne	@notOurs				clc		rts;; if we get this far, we know that at least we're not trying to compare against our own open window;@notOurs	lda	windPtr			;if windPtr is NIL, we're at the top of the window list		ora	windPtr+2		beq	@secondCompare				pha				;space		pei <zero			;flags				lda	windPtr		clc		adc	#windMenuText		tax		lda	windPtr+2		adc	<zero		pha		phx				lda	<windBlk		;compare the old window which was closest alphabetically		clc				;to the window which we're looking at now. if this window		adc	#windMenuText		;is before our old closest match, then throw it out.  if		tax				;this window is after the closest match so far, then		lda	<windBlk+2		;check against the window which we're opening.		adc	<zero		pha		phx		_CompareStrings		pla				beq	@equal		bmi	@secondCompare		;B>A, so it might be closer to wind_ref		@equal		clc				;if we fall through to here, the item entry we're comparing		rts				;it against is no closer than the previous menu item's text		@secondCompare			pha		pei <zero			;flags				lda	<windBlk		;window which we got from walkWindow (which we're inside of)		clc		adc	#windMenuText		tax		lda	<windBlk+2		adc	<zero		pha		phx				lda	wind_ref		;info block of window which we're opening		clc		adc	#windMenuText		tax		lda	wind_ref+2		adc	<zero		pha		phx		_CompareStrings		pla				beq	@BgreaterA		cmp	#1			;then A>B		beq	@done		@BgreaterA	ldy	#windMenuItem		;say 'insert this new window after this windowID'		lda	[<windBlk],y		sta	windowID				lda	<windBlk		;if our window is still alphabetically after the window		sta	windPtr			;we got from this iteration through walkWindow, then		lda	<windBlk+2		;this window must be closer alphabetically to the window		sta	windPtr+2		;which we are opening, so say that		@done		clc		rts;; locals;windPtr		dc.L	0			;needs to be set to zero each time we use windComparewindowID	dc.w	0			;need to be set to the divider ID each time we use windCompare				EXPORT	insertItemRefinsertItemRef	dc.w	0			;version		dc.w	$f000			;itemID		dc.w	0			;no keystroke characters		dc.w	0			;no item check characters		dc.w	0			;item flag (refIsPtr)		dc.L	0			;title ref string (pstr);-----------------------------------------------; Why doesn't the "@#$!*%?" finder use local variables ?????; The _NewWindow call above puts the window pointer in a global;  (wind) variable which some of the routines above decide to; trash!! I don't want setInfo() to happen until everything is; done so I now keep my window pointer in a LOCAL variable so; that when I do reference it it is still valid. DJB;MyLocalWinPtr	DC.L	0		STRING	PASCAL; Launch an application ;.....................................................................		IMPORT	info_store		IMPORT	IconsName		IMPORT	DesktopName		IMPORT	PathAddName		IMPORT	AddBundle2Desktop		IMPORT	BootFST		IMPORT	KillStandardFile		IMPORT	GetStandardFile		IMPORT	GetBootVolume		launch		name		lda	Printing		sta	srqPrintFlag	*** Moved - 18-Mar-93 JCM - This would only let the correct modifiers be sent out with the first***			    SendRequest. We now set them up outside of the launching loop.		;;;		lda	<modifiers		;get current modifiers to pass to finderSaysBeforeOpen;;;		sta	launchModifiers;;;		sta	srqModifiers		*** End - 18-Mar-93 JCM		stz	modifiers		;don't do anything screwy if the launch fails for						;any reason		jsr	ckIfInTrash		Is the item in the Trash?		bcc	ok24		rts				Items in the Trash can't be opened.ok24		stz	desRect			Make a null string.		ldx	#desRect		Pass pointer to	null string.		ldy	#desRect>>16		jsr	doSetPrefix		Reset ProDOS prefix to null string.		jsl	GetBootVolume		ldy	#icFType		Is this	an application or document?		lda	[<ic],y		cmp	#$00FF			Older application?		beq	@goRunApp;		cmp	#$00B5			EXE file?;		beq	@goRunApp		cmp	#$00B3			New application?		bne	runDoc@goRunApp	brl	runApp; ------ Launch	application from document -------------------------		export 	srqOpenParmssrqOpenParms	dc.w	7		;oops, pcount was 6 in 6.0 (fixed 17-Feb-92 DAL)		dc.l	C1_PathnamesrqRectangle	dc.l	srqTheRect		export	srqFiletypesrqFiletype	dc.w	0		export	srqAuxtypesrqAuxtype	dc.l	0		export	srqModifierssrqModifiers	dc.w	0		export	srqIconHandlesrqIconHandle	dc.L	0		export	srqPrintFlagsrqPrintFlag	dc.w	0		EXPORT	srqTheRectsrqTheRect	dc.w	0,0,0,0runDoc				IMPORT	temp2Path		IMPORT  PathGetName		IMPORT	WStringCopy		IMPORT	doAlertWindow		import	UnlockICBLKHAND		;22-Mar-93 JCM;; Now, before we do much of anything else, we have to make sure that the disk with the document on it; is actually online.  If it's not, then there's no point in going any further or allowing them to; update any icon links or desktop database links.;		jsr	buildPath		bcs	@continue		ldy	#icFlag			;if the disk isn't online, then we have to		lda	[<ic],y			;ask the user nicely to put it back		and	#icOffline		beq	@online	@getDisk	jsr	PutOnline		bcc	@PutOnline		brl	CanceledSFDialog@PutOnline	jsr	doGetFileInfo		;and if they don't put it back, then we have		bcc	@online			;to ask them again... and again... and again...		cmp	#$46		beq	@getDisk		cmp	#$45		beq	@getDisk;; Let's send out the finderSaysBeforeOpen request;@online		jsr	doSaysBeforeOpen		bcs	@continue		jsl	ArrowCursor		rts@continue	ldy	#icRBundle+1		lda	[<ic],y		beq	@failed				ldy	#icRBundle		;get the handle to the rBundle			lda	[<ic],y		sta	<icBlkHand		iny		iny		lda	[<ic],y		sta	<icBlkHand+2				lda	[<icBlkHand]		;deref it		tax		ldy	#2		lda	[<icBlkHand],y		sta	<icBlk+2		stx	<icBlk				lda	[<icBlk]		;high bit is set if converted		sta	converted		ldy	#icOneDocOffset		lda	[<ic],y		clc		adc	<icBlk		sta	<icBlk		iny		iny		lda	[<ic],y		adc	<icBlk+2		sta	<icBlk+2				ldy	#12			;rFinderPathHandle, might be empty		lda	[<icBlk],y		sta	<icBlkHand		iny		iny		lda	[<icBlk],y		sta	<icBlkHand+2		lda	<icBlkHand+1		;see if there's really an rFinderPath handle		beq	@failed		brl	ok301				;; Let's send the finderSaysOpenFailed request;@failed				pea	$0105			;finderSaysOpenFailed		ldx	<zero		pea	$8000			;how = send to first guy who accepts it		phx		phx				;target = nil		pushlong #srqOpenParms		phx		phx				;dataOut = nil		_SendRequest		bcs	@cont2		jsl	ArrowCursor		rts@cont2; If the file has an rComment(2) resource, let's display it; in an alert		pha				;space for OpenResourceFile result		pea 1				;request read access		lda <zero		pha		pha				;map address = nil		pushlong #C1_Pathname		_OpenResourceFile		plx		bcc @1		brl noComment2@1		phx				;save resource file number for CloseResourceFile		pha				;space for 2nd SetResourceFileDepth result		pha				;space for SetResourceFileDepth result		pea 1				;new depth		_SetResourceFileDepth		pha		pha				;space for result		pea $802A			;rComment		pei <zero		pea 2		_LoadResource		pla		sta rComment2Handle		pla		sta rComment2Handle+2		pea $802a		pei <zero		pea 2		_DetachResource		_SetResourceFileDepth		;restore depth		pla				;ignore original depth		_CloseResourceFile		;resource file number already on stack		lda rComment2Handle+1		bne @2		brl noComment2@2;; grow handle by one byte (room for CString terminator);		pha		pha		pushlong rComment2Handle		_GetHandleSize		lda 1,s		inc a		sta 1,s		pushlong rComment2Handle		_SetHandleSize; dereference		pushlong rComment2Handle		phd		tsc		tcd		ldy #2		lda [3],y		sta rCommentSubArray+2		lda [3]		sta rCommentSubArray		pld		_HLock; put a CString terminator on the end		phd		pushlong rCommentSubArray		tsc		tcd		pha		pha		pushlong rComment2Handle		_GetHandleSize		ply		pla		dey		lda #0		sep #$20		sta [1],y		rep #$20		pla		pla		pld*** Added 21-Jan-93 JCM;;;		_InitCursor		jsl	ArrowCursor		*** End - 21-Jan-93 JCM						pha				;space for result		pea $0034			;by resource, C substitution strings, sound, cool button pos		pushlong #rCommentSubArray		pushlong #rasRComment2		_AlertWindow		pla		pushlong rComment2Handle		jsl DisposeHandleGlue		rtsrComment2Handle	dc.l 0rCommentSubArray dc.l 0noComment2		lda	#rasNoApplication		jsl	doAlertWindowerror104	rts				;Quit the open.;; evidently, we have something to run, so try to run it;ok301		ldy	#4		lda	[<icBlkHand],y		ora	#$8000		sta	[<icBlkHand],y				lda	[<icBlkHand]		;deref it		tax		ldy	#2		lda	[<icBlkHand],y		sta	<icBlk+2		stx	<icBlk		ldy	#2		lda	[<icBlk],y		clc		adc	<icBlk		sta	<icBlk		bcc	@nr		inc	<icBlk+2@nr		pushZLong <icBlk		pushlong #C1_Pathname		jsl	WStringCopy		pushZLong <icBlk		jsr	sendPathMess		;Send names of documents to application.		pulllong <icBlk		pushZLong <icBlk		pushlong #C1_Pathname		jsl	WStringCopy*** Scrunched - 21-Mar-93 JCM;;;		ldy	#4;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y				jsr	UnlockICBLKHAND		*** End - 21-Mar-93 JCM;; If the rBundle was a converted rBundle, then its kosher to get rid of all the slashes in the; pathname which we're launching.  Otherwise, stripping the "/"'s would be a bad idea;		lda	converted		bpl	@notConverted				sep	#$20		LONGA	OFF		ldy	C1_PathName@loop		lda	C1_PathName,y		;remap '/' to ':'		cmp	#'/'		bne	@ok		lda	#SEPARATOR		sta	C1_PathName,y@ok		dey		bpl	@loop		rep	#$20		LONGA	ON@notConverted	lda	launchModifiers		and	#optionKey		beq	runlop		ldx	#4			;second prompt		brl	MakeIconLinkrunlop		jsr	doGetFileInfo		;Is the application there?		bcs	@lostApp				lda	info_type		;it's also got to really BE an application		cmp	#$B5		beq	@launch		cmp	#$B3			;and not just something like a folder		beq	@launch				cmp	#$FF		bne	@lostApp		jsr	CheckDocFST		;run it only from a prodos or appleshare volume		bcs	@bogus		jsr	CheckFST		;run it only off of a prodos or appleshare volume		bcc	@launch@bogus		brl	CanceledSFDialog@launch		ldy	info_type				lda	info_aux				ldx	info_aux+2				jsr	FinderSaysBeforeApp	;send finderSaysBeforeOpen on this application		bcs	@goLaunch		;nobody accepted the request		rts@goLaunch	brl	finishLaunch		;No error if file found.@lostApp	PushLong #C1_FileName		PushLong #C1_PathName		jsl	PathGetName		;extract the application name		lda	#rasNoApp		jsl	doAlertWindow				ldx	<zero			;first prompt		cmp	#1		beq	@goRunLop		;Try Again?		blt	@bogus		bra	Locate@goRunLop	brl	runLop;; Nuts, they chose LOCATE, so we put up a SFGetFile dialog, then use that pathname as ours;Locate				IMPORT	iconsName		IMPORT	desktopName		IMPORT	PathAddName		IMPORT	fileSysID				lda	#controlKey+optionKey		sta	launchModifiers		MakeIconLink	phx		jsl	GetStandardFile		plx		bcc	@gotSF		lda	#rasNoStandardFile		jsl	doAlertWindow		bra	@noStandardFile		;if we get an error, they're hosed@gotSF		pea	120			;x		pea	40			;y		pea	2			;promptRefDesc (resource pstring)		lda	SFGetFilePrompts+2,x		pha		lda	SFGetFilePrompts,x		pha		lda <zero		pha		pha				;filterProc		pushlong #typeList		pushlong #SFGetFileReply		_SFGetFile2		jsl	KillStandardFile				lda	goodLocate		bne	@noCancel		@noStandardFile	brl	CanceledSFDialog@noCancel		lda	pathRefLocate		sta	<handle		lda	pathRefLocate+2		sta	<handle+2				ldy	#2		lda	[<handle],y		tax		lda	[<handle]		clc			;it's a C1_Output string		adc	#2		bcc	@copyIt				inx@copyIt		phx		pha		pushlong #c1_pathname		jsl	WStringCopy				jsr	doGetFileInfo		;did they link it to something which isn't there? (huh?)		bcs	@noStandardFile		jsr	CheckFST		;did they link it to a P8 app on an HFS disk?		bcs	@noStandardFile		jsr	CheckDocFST		bcs	@noStandardFile				lda	launchModifiers		and	#controlKey		;control held down?		bne	relinkApp*** Added - 9-Mar-93 JCM - Always make sure we send a finderSaysBeforeOpen no matter why or how***			   we're attempting to launch an application.		SendSFGetAppReq	ldy	fileTypeLocate				lda	auxTypeLocate				ldx	auxTypeLocate+2				jsr	FinderSaysBeforeApp	;send finderSaysBeforeOpen on this application		bcs	@goLaunch		;nobody accepted the request		rts*** End - 9-Mar-93 JCM@goLaunch	brl	finishLaunch		;No error if file found.relinkApp		;; now that we have our complete pathname, see what kind of rBundle we actually; were working with (converted or native).;			ldy	#icRBundle		;get the handle to the rBundle			lda	[<ic],y		sta	<handle		iny		iny		lda	[<ic],y		sta	<handle+2				lda	[<handle]		;deref it		tax		ldy	#2		lda	[<handle],y		sta	<ptr+2			;ptr points to our OneDoc (in just a second)		stx	<ptr				lda	[<ptr]			;high bit is set if converted		sta	converted				ldy	#12			;save the volume name's handle		lda	[<ptr],y		sta	volumeHandle		iny		iny		lda	[<ptr],y		sta	volumeHandle+2				ldy	#icOneDocOffset		lda	[<ic],y		clc		adc	<ptr		sta	<ptr		iny		iny		lda	[<ic],y		adc	<ptr+2		sta	<ptr+2		jsr	OpenLocalOrBoot		;results in A&X		bcc	@gotDatabase;;;		brl	finishLaunch		brl	SendSFGetAppReq		;9-Mar-93 JCM	@gotDatabase	txy				;check if we had to create a desktop file, and		bpl	@lookConverted		brl	@converted		;if so, always generate a new rBundle		@lookConverted	ldx	converted		bpl	@native		brl	@converted	;; This isn't a converted icon, it's a native one, so we'll first try to write just the; rFinderPath back to our original volume.  If that doesn't work, then we'll try writing; a new rBundle back to the boot volume.;@native		tax		bpl	@local			;is result is 0, then update the local		brl	@converted		@local		pha		pea	1		_SetResourceFileDepth		pla		sta	oldDepth				ldy	#8		lda	[<ptr],y		sta	rFinderPathID		tax		iny		iny		ora	[<ptr],y		beq	@needNewFPath		;if we don't have an rFinderPath, don't remove		lda	[<ptr],y		;one		sta	rFinderPathID+2				pea	$802c		pha		phx		_RemoveResource		bra	@useOldFPath		@needNewFPath	pha		pha		pei <zero		pea	$802C			;rFinderPath		_UniqueResourceID		pla		sta	rFinderPathID		ldy	#8		sta	[<ptr],y		iny		iny		pla		sta	rFinderPathID+2		sta	[<ptr],y@useOldFPath	jsr	addFPathToDatabase		lda	resFileID		ora	#$8000			;close it anyway		pha		_CloseResourceFile				pha		lda	oldDepth		pha		_SetResourceFileDepth		pla;;;		brl	finishLaunch		brl	SendSFGetAppReq		;9-Mar-93 JCM;; this is a converted icon, so allocate memory for an rBundle, copy the OneDoc to the; rBundle...;	@converted	pha				;Space for result.		pha		pei <zero		lda	[<ptr]			;size of rBundle is size of OneDoc + 18		clc		adc	#18		pha		pei	<MyID		pea	$8000			;attributes (locked)		pha				;address, not used.		pha		_NewHandle		pulllong <handle2		bcc	@convertedOK;;;		brl	finishLaunch		brl	SendSFGetAppReq		;9-Mar-93 JCM@convertedOK		pha		pea	1		_SetResourceFileDepth		pla		sta	oldDepth				lda	[<handle2]		tax		ldy	#2		lda	[<handle2],y		sta	<ptr2+2		stx	<ptr2			pushZLong <ptr			;source		lda	<ptr2			;destination		clc		adc	#18		ldx	<ptr2+2		bcc	@nr		inx@nr		phx		pha		pei <zero				lda	[<ptr]			;how much (one OneDoc worth)		pha		_BlockMove				lda	<zero			;rBundle version		sta	[<ptr2]				ldy	#4			;rIcon ID for this app (none)		sta	[<ptr2],y		iny		iny		sta	[<ptr2],y				ldy	#12			;volumeNameHandle (used internally by us)		sta	[<ptr2],y		iny		iny		sta	[<ptr2],y		ldy	#2			;offset to DocList		lda	#16		sta	[<ptr2],y		ldy	#16			;Number of OneDocs (always one because we're making one)		lda	#1		sta	[<ptr2],y		ldy	#18+4			;NumResults		lda	[<ptr2],y		cmp	#2			;if there's no space for an rFinderPath, just save the bundle		bge	@haveRFPath		brl	@saveBundle@haveRFPath		ldy	#18+12			;FinderPathReserved+18		lda	<zero		sta	[<ptr2],y		iny		iny		sta	[<ptr2],y		ldy	#18+4			;NumResults		lda	[<ptr2],y		cmp	#3			;if there's no space for the large icon, just save the		blt	@saveRFPath		;rFinderPath and the bundle				ldy	#18+20			;LargeIconReserved+18		lda	<zero		sta	[<ptr2],y		iny		iny		sta	[<ptr2],y		ldy	#18+4			;NumResults		lda	[<ptr2],y		cmp	#4			;if there's no space for the small icon, just save the		blt	@saveLargeIcon		;rFinderPath, the large icon, and the bundle				ldy	#18+28			;SmallIconReserved+18		lda	<zero		sta	[<ptr2],y		iny		iny		sta	[<ptr2],y;; now that we have the desktop file open... add the large icon to the resource file;@saveLargeIcon	ldy	#18+4			;NumResults		lda	[<ptr2],y		cmp	#3		blt	@saveRFPath		ldx	#20			;our large icon's handle offset from source OneDoc		lda	#18+16			;our large icon's ID stuffed into the rBundle clone		jsr	addIconToDatabase		bcc	@largeIconOK		brl	@stopCSave@largeIconOK;; add the small icon the to the desktop file;@saveSmallIcon	ldy	#18+4			;NumResults		lda	[<ptr2],y		cmp	#4		blt	@saveRFPath				ldx	#28			;our small icon's handle offset from source OneDoc		lda	#18+24			;our small icon's ID stuffed into the rBundle clone		jsr	addIconToDatabase		bcc	@smallIconOK		brl	@stopCSave@smallIconOK;; add just the rFinderPath;@saveRFPath		pha		pha		pei <zero		pea	$802C			;rFinderPath		_UniqueResourceID		pulllong rFinderPathID		jsr	addFPathToDatabase		bcc	@addSmallOK		brl	@stopCSave@addSmallOK		ldy	#18+8			;rFinderPathID+18		lda	rFinderPathID		sta	[<ptr2],y		iny		iny		lda	rFinderPathID+2		sta	[<ptr2],y;; now that we saved the rFinderPath, both rIcons, save the actual cloned rBundle;@saveBundle		pha		pha		pea	$802B		_CountResources		pla		plx				pha		pha		pea	$802B		phx		pha		_GetIndResource		bcc	@gotFirstOK				lda	<zero			;just to be sure, we can't depend on the return		sta	1,s			;from getIndexedResource		sta	3,s		@gotFirstOK	pla		clc		adc	#1			;next resource please		plx		bcc	@nr2		inx	@nr2			ldy	#8		;save the rBundle ID in itself		sta	[<ptr2],y		sta	BundleID		iny		iny		txa		sta	[<ptr2],y		sta	BundleID+2				pushZLong <handle2	;handle to our cloned rBundle		pea	$0040		;Preload!		pea	$802B		pushlong BundleID		_AddResource@stopCSave	lda	resFileID		ora	#$8000		;close it anyway		pha		_CloseResourceFile		pha		lda	oldDepth		pha		_SetResourceFileDepth		pla;;;		brl	finishLaunch		brl	SendSFGetAppReq		;9-Mar-93 JCM;; try opening desktop file on the volume which contained this rBundle.  If we can't create; a desktop file on that volume, try it on the boot volume;; OUT: carry set of bad, error in A;      carry clear if good, A = 0 if on local volume;     			    A = $FFFF if on boot volume;			    X = 0 if opened RW;			    X = $FFFF is desktop createdOpenLocalOrBoot		lda	volumeHandle+1		bne	@writeToVolume		brl	@writeToBoot		;will also flag "create an rBundle"@writeToVolume		stz	which		stz	how				lda	volumeHandle		sta	<handle3		lda	volumeHandle+2		sta	<handle3+2				ldy	#4		lda	[<handle3],y		ora	#$8000		sta	[<handle3],y				lda	[<handle3]		tax		ldy	#2		lda	[<handle3],y		sta	<ptr3+2		stx	<ptr3		pha				;see if the volume which they want us to		pushZLong <ptr3			;add to the desktop on is already the boot		pushlong #c1_bootname		;volume -- if so, then we'll try to open it		jsl	WStrCompare		;normally and not flag it as being our last		pla				;resort -- ie, if it's able to open the desktop		bne	@toBootAnyway		;file on boot, great! (don't write new stuff)		pushZLong <ptr3		pushlong #c1_tempPath		jsl	WStringCopy				jsr	CheckVolume		;see if we can write to the volume		bcs	@writeToBoot		;(maybe not!)				lda	>fileSysID		;check the volume's FST		cmp	#AppleShareFST		;never write to an appleshare volume		beq	@writeToBoot		jsr	AddDatabaseName		@openLoop	jsr	OpenDatabase		bcs	@problemWVolume		brl	@cool@problemWVolume					cmp	#$63		beq	@createDatabase		cmp	#$46		beq	@createDatabase		cmp	#$45		beq	@writeToBoot		sec		rts		@writeToBoot	lda	#$FFFF		sta	which		@toBootAnyway	pushlong #c1_bootname		pushlong #c1_tempPath		jsl	WStringCopy				jsr	CheckVolume		;see if we can write to the volume		bcs	@noHope			;(maybe not!)				lda	>fileSysID		;check the boot volume's FST		cmp	#AppleShareFST			bne	@canWriteToBoot				lda	#1			;boot volume is AppleShare, so make the		sta	>c1_tempPath		;database save to @:Desktop		lda	#'@'		sta	>c1_temppath+2		jsr	addAppleShareName	;save to @:Desktop instead of @:icons:desktop		bra	@bootWasAppleShare@canWriteToBoot	jsr	AddDatabaseName		@bootWasAppleShare		jsr	openDatabase		bcc	@cool				jsr	CreateDatabase		;if we can't create it on the boot volume,		bcc	@openLoop		;then they don't get to save their link		rts		@createDatabase				jsr	CreateDatabase		bcc	@openLoop				cmp	#$2b			;if regular volume is write-protected, try to		beq	@writeToBoot		;write it to the boot volume@writeProtected	sec@noHope		rts		@cool		lda	which		ldx	how		clc		rts		;; OpenLocalOrBoot Locals;which		dc.w	0			;0 = local volume, $FFFF = boot volumehow		dc.w	0			;0 = opened RW, $FFFF = created;; check to see if the volume is either write-protected, read-only, and if the volume is; actually online.  If we don't stand a chance of writing to this volume, return with the; carry set;; IN: c1_temppath has the name of the volume;; OUT: carry clear if we can write to this volume;      'fileSysID' contains the file system of the volume;CheckVolume		IMPORT	GetDeviceNumber		IMPORT	GetDeviceInfo		IMPORT	GetVolumeInfo		IMPORT	VolumeParams		IMPORT	GetIconPtr2				pha				;see if the volume is still around		pushlong #c1_temppath		jsl	GetDeviceNumber		;result on stack		plx		bcs	cvDone		phx				; devNum		PushLong #C1_DeviceName		; devNamePtr		lda <zero		pha		pha				; skip devChar		pha		pha				; skip devBlocks		pha		pha				; skip devID		jsl	GetDeviceInfo		bcs	cvDone		PushLong #C1_DeviceName		; pointer to device name		lda <zero		pha		pha				; pointer to volume name		pha		pha				; pointer to total blocks		pha		pha				; pointer to free blocks		PushLong #fileSysID		; pointer to file system ID		pha		pha				; skip block size		jsl	GetVolumeInfo		bcs	cvDone				lda	>VolumeParams+$16		and	#$0003			;is it write-protected or read-only?		bne	cvBoguscvDone		rtscvBogus		lda	#$002b			;say it's write-protected		sec		rts		;; AddDatabaseName -- add Icons:Desktop to c1_tempPath;AddDatabaseName		pushlong #iconsName		pushlong #c1_tempPath		jsl	PathAddNameAddAppleShareName				pushlong #desktopName		pushlong #c1_tempPath		jsl	PathAddName		rts;; OpenDatabase -- open the desktop database;OpenDatabase		pha		pea	$8003			;rw access, also no preload of anything		lda <zero		pha		pha		pushlong #c1_tempPath		_OpenResourceFile		plx		stx	resFileID		rts;; CreateDatabase -- create the resource file for the desktop database in c1_tempPath;CreateDatabase		lda	#$FFFF		sta	how		pushlong #3		pea	$c9		pea	$c3		pushLong #c1_tempPath		_CreateResourceFile		rts;; addFPathToDatabase;; IN: rFinderPathID = ID of resource for rFinderPath;addFPathToDatabase				pha				Space for result.		pha		pei <zero		lda	c1_pathname		clc		adc	#8			;6 for the version, offset, and pcount,+2 for wstr		pha		pei	<MyID		pea	$8000			;attributes (locked)		pha				;address, not used.		pha		_NewHandle		pulllong <handle3		bcc	@newRFPOK		rts@newRFPOK				lda	[<handle3]		tax		ldy	#2		lda	[<handle3],y		sta	<ptr3+2		stx	<ptr3				lda	<zero			;rFinderPath's version		sta	[<ptr3]		ldy	#4			;rFinderPath's pcount (0)		sta	[<ptr3],y				ldy	#2			;rFinderPath offset to pathname		lda	#6		sta	[<ptr3],y				pushlong #c1_pathname		lda	<ptr3		clc		adc	#6		ldx	<ptr3+2		bcc	@nr2		inx@nr2		phx		pha		jsl	WStringCopy				pushZLong <handle3		;our rFinderPath's handle				pea	$0040			;Preload!		pea	$802C		pushlong rFinderPathID		_AddResource		bcc	@done			pha		pushlong <handle3		jsl DisposeHandleGlue		pla		sec@done		rts		;; addIconToDatabase -- in, X = OffsetOfIndex, A = OffsetOfId;addIconToDatabase		import	UnlockICBLKHAND		;22-Mar-93 JCM		stx	OffsetOfIndex		sta	OffsetOfID		pha		pha		pei <zero		pea	$8001			;rIcon		_UniqueResourceID		pulllong IconID		ldy	OffsetOfIndex				lda	[<ptr],y		jsr	GetIconPtr2		;make <icon point to the icon				ldy	#2		lda	[<icon],y		asl	a		clc		adc	#8		sta	handleSize		ldx	<zero		stz	handleSize+2				phx				;Space for result		phx		phx				;exact clone		pha		pei	<MyID		pea	$8000			;attributes (locked)		pha				;address, not used.		pha		_NewHandle		pulllong <handle3		bcc	@newHandleOK		*** Scrunched - 21-Mar-93 JCM;;;		ldy	#4;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y;;;		rts				brl	UnlockICBLKHAND		;it does the rts		*** End - 21-Mar-93 JCM@newHandleOK		pushZLong <icon		pushZLong <handle3		pushlong handleSize		_PtrToHand		*** Scrunched - 21-Mar-93 JCM;;;		ldy	#4;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y				jsr	UnlockICBLKHAND		*** End - 21-Mar-93 JCM		pushZLong <handle3		pea	$0040			;Preload! (at least)		pea	$8001		pushlong IconID		_AddResource		bcc	@addSmallOK				pha		pushZLong <handle3		jsl DisposeHandleGlue		pla		sec		rts@addSmallOK		ldy	OffsetOfID		lda	IconID		sta	[<ptr2],y		iny		iny		lda	IconID+2		sta	[<ptr2],y		clc		rts;; locals;oldDepth	dc.w	0SFGetFilePrompts		dc.L	rPStringPrompt		dc.L	rPStringPrompt2		launchModifiers	dc.w	0converted	dc.w	0		;if high bit set, this icon was converted from old iconsvolumeHandle	dc.L	0BundleID	dc.L	0resFileID	dc.w	0IconID		dc.L	0OffsetOfID	dc.w	0OffsetOfIndex	dc.w	0rFinderPathID	dc.L	0handleSize	dc.L	0;; they cancelled the SF dialog, or they cancelled the first dialog saying that; there wasn't an app to run in the first place;CanceledSFDialog				;Cancel selected.		jsl	arrowCursorgoAway		pea	DelMessage		;get rid of anything we might have accumulated in		pea	FilesMessage		;message center		pha		pha		_MessageCenter		pea	DelMessage		;get rid of anything we might have accumulated in		pea	LongFilesMessage	;message center		pha		pha		_MessageCenter				rts********************************************************************************** FinderSaysBeforeApp - Does a SendRequest on the application we are about to*			launch. The application's pathname must be in C1_Pathname.*			Pass fileType in Y and auxType in Acc (low), X (high).*FinderSaysBeforeApp		sty	srqFiletype		sta	srqAuxtype		stx	srqAuxtype+2		stz	srqIconHandle		stz	srqIconHandle+2		stz	srqPrintFlag		pea	$0104			;finderSaysBeforeOpen		ldx	<zero		pea	$8000			;how = send to first guy who accepts it		phx		phx				;target = nil		pushlong #srqOpenParms		phx		phx				;dataOut = nil		_SendRequest		rts;; ------ Launch	application -----------------------------------------------;runApp		ldy	#icMom+2		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	getwRefCon2		;windBlk = ic's window info block.				jsr	buildPath		;C1_PathName = ic's full pathname.		bcs	goAway			;Pathname error?			ldy	#icFlag			;if the disk isn't online, then we have to		lda	[<ic],y			;ask the user nicely to put it back		and	#icOffline		beq	@online	@getDisk	jsr	PutOnline		bcs	goAway		@online		jsr	doGetFileInfo		;and if they don't put it back, then we have		bcc	@checkFST			;to ask them again... and again... and again...		cmp	#$46		beq	@getDisk		cmp	#$45		beq	@getDisk@checkFST	jsr	CheckFST		bcs	goAway			jsr	doSaysBeforeOpen				bcs	doQuit		rts;; doQuit -- see if we're launching an extended file, and if so, try to add the app's rBundle to our;           desktop database;		doQuit		jsl	WatchCursor				lda	info_store		cmp	#5		beq	@isExtended		brl	finishLaunch@isExtended		pushlong #c1_temppath		pushlong #c1_pathname		jsl	PathGetRoot				pha		pushlong #c1_bootname		pushlong #c1_temppath		jsl	WStrCompare		pla		bne	@writeToBoot2				jsr	CheckVolume		bcs	@writeToBoot				lda	>fileSysID		;check the volume's FST, if it's AppleShare, don't		cmp	#AppleShareFST		;write the Desktop to it, only to the boot volume		beq	@writeToBoot		jsr	addDatabaseName		jsr	addBundle				beq	finishLaunch				cmp	#$1e06			;rBundle or rVersion resource not found?		beq	finishLaunch		;If so, don't try adding it again		cmp	#fErrNotPrudent		beq	finishLaunch		cmp	#fErrBadBundle		beq	finishLaunch		cmp	#$48			;volume full?		beq	finishLaunch;; if we couldn't write to the volume which the application is on, then try to create the Desktop; file on the boot volume, even if it's AppleShare (but, if it's AppleShare, create it in the; '@' prefix;@writeToBoot	pushlong #c1_bootname		pushlong #c1_temppath		jsl	WStringCopy@writeToBoot2	jsr	CheckVolume		;see if the boot volume is around		bcs	finishLaunch		;'cause if it's not, we have no hope of writing to boot		lda	>fileSysID		cmp	#AppleShareFST		bne	@noAShareBoot						lda	#1		sta	>c1_temppath		lda	#'@'		sta	>c1_temppath+2				jsr	addAppleShareName		bra	@addBundle@noAShareBoot	jsr	addDatabaseName				@addBundle	jsr	addBundle		;if this fails, tough, keep going;; finish launching;finishLaunch	jsl	WatchCursor		pushlong #c1_pathname		pushlong #c1_quitname		jsl	WStringCopy						lda	#C1_QuitName		sta	quit_path		lda	#^C1_QuitName		sta	quit_path+2		ZoomLaunch	jsr	getSmallRect		;from <ic, which better be there...				lda	#4		sta	bigRect+x1		lda	#636		sta	bigRect+x2		lda	#16		sta	bigRect+y1		lda	#196		sta	bigRect+y2				lda	#1			;zoom up		jsr	zoomRect		lda	#$C000		sta	quit_flags		rts;; Let's send out the finderSaysBeforeOpen request;doSaysBeforeOpen		lda	<icHand		sta	srqIconHandle		lda	<icHand+2		sta	srqIconHandle+2			ldy	#icFType		lda	[<ic],y		sta	srqFiletype		ldy	#icFileInfo		lda	[<ic],y		sta	srqAuxtype		iny		iny		lda	[<ic],y		sta	srqAuxtype+2		jsr	GetSmallRect		ldy	#6@rLoop		lda	smallrect,y		sta	srqTheRect,y		dey		dey		bpl	@rLoop				pea	$0104			;finderSaysBeforeOpen		ldx	<zero		pea	$8000			;how = send to first guy who accepts it		phx		phx				;target = nil		pushlong #srqOpenParms		phx		phx				;dataOut = nil		_SendRequest		rts;; add a bundle from c1_pathname to c1_temppath;addBundle		pha		pea	$8000		pushlong #1		pushlong #c1_temppath		pushlong #c1_pathname		jsl	AddBundle2Desktop			pla				;damn the errors, full speed ahead!		rts;; checkFST -- if it's a P8 app, check the FST to make sure it's either ProDOS or AppleShare;		EXPORT	CheckFSTCheckFST	lda	info_type		cmp	#$FF		bne	GoodFST				lda	OptionBuffFST		cmp	#ProDOSFST		beq	GoodFST		cmp	#AppleShareFST		beq	GoodFST				lda	#rasWrongAppFST		jsl	doAlertWindow		sec		rts		GoodFST		clc		rts;; check the fst for the document icon;		EXPORT	CheckDocFSTCheckDocFST	lda	info_type		;is this a P8 app they linked to?		cmp	#$FF		bne	GoodFST				ldy	#icOptionList+2		;it's a P8 app, but is the document on a server or prodos		lda	[<ic],y			;volume?  if not, say that's a no-no		cmp	#AppleShareFST		beq	GoodFST		cmp	#ProDOSFST		beq	GoodFST				lda	#rasWrongDocFST		jsl	doAlertWindow		sec		rts;; See if our icon is online, and if not, ask for the disk's name which is the root of c1_pathname;; OUT: Carry clear if they pressed OK to insert or if the disk was already online;PutOnline	pushlong #C1_Source		pushlong #C1_Pathname		jsl	PathGetRoot				lda	>c1_source		dec	a		xba			sta	>c1_source+1				lda	#rasInsertDiskOrCancel8	;uses *8 as substitution string		jsl	doAlertWindow		clc		bne	@online			;button 1 = OK		sec@online		rts		;; locals;TypeList	dc.w	3			;entries in filetype list				dc.w	$8000			;match filetype, any auxtype		dc.w	$00FF		dc.L	0				dc.w	$8000			;match filetype, any auxtype		dc.w	$00B3		dc.L	0				dc.w	$8000			;match filetype, any auxtype		dc.w	$00B5		dc.L	0SFGetFileReply	goodLocate	dc.w	0			;good or notfileTypeLocate	dc.w	0			;filetypeauxTypeLocate	dc.L	0			;auxtypenameRefDescLocate dc.w	3			;ref will be a handlenameRefLocate	dc.L	0			;filename refpathRefDescLocate dc.w	3			;ref will be a handlepathRefLocate	dc.L	0			;pathname ref; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Check if opening something;	   in the Trash.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;   IN:	   curWind = window being checked.;  OUT:	   Carry set if	curWind	is the Trash.		EXPORT	ckIfInTrashckIfInTrash						jsr	getwRefCon		windblk	= pointer to curWind's info block.		jsr	getWindID2		a = window's ID.		cmp	#TrashWindID		Openning something in the Trash?		clc				Not Trash flag,	just in	case.		bne	exit150			If not in the Trash, then OK.		stz	modifiers		;prevent trash from closing if they tried to tunnel		lda	#rasInTrash		jsl	doAlertWindow		sec				Abort flag.exit150		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Move	wind_ref into windBlk. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = = setInfoPtr		lda	wind_ref		Get the	address	of the window's		sta	<windBlk		information block.		lda	wind_ref+2		sta	<windBlk+2		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Send	message	with pathname of;	   every selected document to application.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =sendPathMess	lda	#9			;Number of bytes to allocate.		jsr	allocate		sta	<temp		stx	<temp+2		lda	#10			;Number of bytes to allocate (1 extra for long message's		jsr	allocate		;terminator)		sta	<handle2		stx	<handle2+2		lda	[<temp]			;Dereference handle.		sta	<work		ldy	#2		lda	[<temp],y		sta	<work+2		lda	[<handle2]		;Dereference handle.		sta	<ptr2		lda	[<handle2],y		sta	<ptr2+2		ldy	#7			;store the terminating zero if we get nothing		lda	<zero		sta	[<work],y		iny		sta	[<ptr2],y		;and the terminating zero WORD if we get nothing (???)		ldy	#messType		;Set message type.		lda	#FilesMessage		sta	[<work],y		lda	#LongFilesMessage		sta	[<ptr2],y		iny		iny		lda	Printing		;1 to print documents, else 0.		sta	[<work],y		sta	[<ptr2],y		jsr	clonePath		;C1_TempPath = C1_PathName, pass to add2Message.		lda	#add2Message		jsr	findSelect		pha		pha		pushZLong <temp		_GetHandleSize		pla		plx		bne	@addMessage1		cmp	#9		beq	@noMessage1@addMessage1	pea	AddMessage		;Pass action value.		pea	FilesMessage		;Pass type of message.		pei	<temp+2			;Pass handle to MessageCenter.		pei	<temp		_MessageCenter@noMessage1	pea	AddMessage		;Pass action value.		pea	LongFilesMessage	;Pass type of message.		pei	<handle2+2		;Pass handle to MessageCenter.		pei	<handle2		_MessageCenter		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Add icon's pathname to message.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   temp	= handle of message.;	   ic =	selected icon.;	   C1_TempPath = application's pathname.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =add2Message;; --- Check if this icon's boss is the same as the launching application -----;				ldy	#icRBundle		lda	[<ic],y		sta	<icBlkHand		iny		iny		lda	[<ic],y		sta	<icBlkHand+2				lda	[<icBlkHand]		tax		ldy	#2		lda	[<icBlkHand],y		sta	<icBlk+2		stx	<icBlk				ldy	#icOneDocOffset		lda	[<ic],y		clc		adc	<icBlk		sta	<icBlk		iny		iny		lda	[<ic],y		adc	<icBlk+2		sta	<icBlk+2		ldy	#12			;rFinderPathHandle		lda	[<icBlk],y		tax		iny		iny		lda	[<icBlk],y		sta	<icBlkHand+2		stx	<icBlkHand				lda	[<icBlkHand]		;deref it		tax		ldy	#2		lda	[<icBlkHand],y		sta	<icBlk+2		stx	<icBlk		ldy	#2			;add offset of pathname		lda	[<icBlk],y		clc		adc	<icBlk		sta	<icBlk		bcc	@nr		inc	<icBlk+2@nr		pha		pushZLong <icBlk		pushlong #c1_tempPath		jsl	WStrCompare		pla		bne	@hasBoss		brl	exit400			; icon doesn't have same boss@hasBoss;; --- Add icon's pathname to message -------------------------------------;		jsr	buildPath		C1_PathName = ic's full pathname.		bcc	@pathOK		brl	exit400			Pathname error?@pathOK		lda	c1_Pathname		cmp	#256		bge	longPath		tax				;check to see if this path contains a '/' and if it@sLoop		lda	c1_pathname+1,x		;does, don't add it to the files message		and	#$00FF		cmp	#'/'		beq	longPath		dex		bne	@sLoop		pha				Space for handle's size.		pha		pei	<temp+2			Pass message handle.		pei	<temp		_GetHandleSize		lda	1,s			Compute	next free spot in message.		dec	a		sta	<work		lda	C1_PathName		Get size of name to add,		sec				(plus one for length byte)		adc	1,s			and add	to current message size.		sta	1,s		pei	<temp+2			Pass the handle	to grow.		pei	<temp		_SetHandleSize		ldy	#2		lda	[<temp],y		tay		lda	[<temp]			Dereference message handle.		clc		adc	<work			Next free spot.		bcc	store400		inystore400	sta	<work		sty	<work+2				sep	#$30		LONGA	OFF		LONGI	OFF		ldy	C1_PathName		iny		lda	<zero			;mark end of list		bra	enter401lop401		lda	C1_PathName+1,yenter401	cmp	#SEPARATOR		bne	kludge		lda	#'/'kludge		sta	[<work],y		dey		bne	lop401		lda	c1_pathname		sta	[<work]				rep	#$30		LONGA	ON		LONGI	ON;; Now, add a long pathname to the LongFilesMessage;longPath	pha				;Space for handle's size.		pha		pushZLong <handle2		_GetHandleSize		lda	1,s			;next available spot		sec		sbc	#2		sta	<ptr2		lda	3,s		sbc	<zero		sta	<ptr2+2		;		lda	C1_PathName		;Get size of name to add,;		clc				;(plus two for length word);		adc	1,s			;and add to current message size.;		adc	#2;		sta	1,s;		lda	3,s;		adc	<zero;		sta	3,s*** fixed 11-Jan-93 DAL		clc		lda	1,s		adc	C1_Pathname		sta	1,s		lda	3,s		adc	<zero		sta	3,s		clc		lda	1,s		adc	#2		sta	1,s		lda	3,s		adc	<zero		sta	3,s*** end 11-Jan-93		pushZLong <handle2		_SetHandleSize		ldy	#2		lda	[<handle2],y		tay		lda	[<handle2]		;Dereference message handle.				clc		adc	<ptr2			;Next free spot.		sta	<ptr2		tya		adc	<ptr2+2		sta	<ptr2+2				pushlong #C1_Pathname		pushZLong <ptr2		jsl	WStringCopy		ldy	c1_pathname		iny		iny				lda	<zero		sta	[<ptr2],yexit400		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Check if file already on desktop.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   C1_PathName = directory pathname.;	   work	= pointer to file name.;;  OUT:	   Carry clear if already on desktop.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =ckInTrash		IMPORT	PStringCompare		lda	>TrashBlk+2		tay		lda	>TrashBlk		bra	enter700		ENTRY	ckOnDesk		; JAM 06/09/89 (Fixing BRC #50497)		EXPORT	ckOnDesk		;   dittockOnDesk		lda	<deskic		ldy	<deskic+2		bra	enter700lop700		jsr	lockic		jsr	ckExName		; compare 'C1_PathName' to icOwner		bcc	next700			; not from 'C1_PathName'		pei	<temp+2		pei	<temp		jsr	geticNamePtr2		pha				; space for result		phx				; pass pointer to ic's name		pha		PushZLong <work		jsl	PStringCompare		pla		eor	#1			; flip it		cmp	#1			; get carry flag (clr if match)		pla		sta	<temp		pla		sta	<temp+2		bcc	exit700			; match foundnext700		ldy	#icNext+2		lda	[<ic],y		tay		lda	[<ic]enter700	sta	<icHand			Store handle of	next ICONOBJ.		sty	<icHand+2		lda	<icHand+1		Any more in list?		bne	lop700		sec				Not on desktop.exit700		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Open	all the	selected icons.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   curWind = list to search.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	openAllopenAll			jsl	WatchCursor		*** Added - 18-Mar-93 JCM - Send out the proper modifiers with each icon we open, not just the first.		lda	<modifiers		;get current modifiers to pass to finderSaysBeforeOpen		sta	launchModifiers		sta	srqModifiers		*** End - 18-Mar-93 JCM						lda	#openIcon		;Routine to call for every selected icon.		jsr	findSelect		lda	quit_flags		;if someone wants us to quit, don't draw the arrow cursor		bne	@done			;AGAIN...				jsl	arrowCursor@done		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Build space padded window title. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   temp	= pointer to name (no spaces on	ends).;	   work	= pointer to area to store new name.;;  OUT:	   work	= pointer to name that is (temp) with leading and;		  trailing space.; ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	padNamepadName	 		sep	#$30		LONGA	OFF		LONGI	OFF		lda	[<temp]			Length of icon's name,		beq	@done		tax				(save for length counter later)		inc	a			plus room for leading space,		inc	a			plus room for trailing space,		sta	[<work]			will be	the length of the title.		ldy	#1			Pad title with a leading space.		lda	#' '		sta	[<work],y@loop		lda	[<temp],y		Move icon's name into title.		iny		sta	[<work],y		dex				(x is icon's name length counter)		bne	@loop		lda	#' '			Pad title with trailing	space.		iny		sta	[<work],y@done		rep	#$30		LONGA	ON		LONGI	ON		rts 		ENDP;=====================================================;	   Draw	a zoom RECT for	closing	window.;=====================================================;;   IN:	   a = 0 to go down, not 0 to zoom up.;	   ic =	destination icon.;;=====================================================growZoom	PROC	EXPORT		jsr	getSmallRect;=====================================================;   IN:	   smallRect = small RECT for zoom.;=====================================================		EXPORT	growZoom2growZoom2			lda	#1			Up direction.		brl	ZoomRect; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Get window's port RECT for zoom.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   a = lo address of window.;	   x = hi address of window.;;  OUT:	   bigRect = window's port in global.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	getBigRectgetBigRect	name		sta	<wind		stx	<wind+2; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;   IN:	   wind	= window.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	getBigRect2getBigRect2		pha		pha		pushZLong <wind		_GetStructRgn		phd		tsc		tcd				lda	[3]		;deref the handle to the region		tax		ldy	#2		lda	[3],y		sta	3+2		stx	3		ldy	#6+2		;no, don't fix this, it's not supposed to copy the first@loop		lda	[3],y		;two bytes of the structure since the bounding rect of		sta	bigRect-2,y	;the struct region is at offset +2		dey			;andy and DAL, 1/7/91		dey		bne	@loop				pld		pla		pla		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Get icon RECT for zoom.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   ic =	ICONOBJ	pointer.;;  OUT:	   smallRect = RECT over ic.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =		import	UnlockICBLKHAND	;22-Mar-93 JCM		EXPORT	getSmallRectgetSmallRect	name		pushZLong <windBlk		pushZLong <curWind				ldy	#icMom			Switch to window that opened icon is in.		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2				jsr	getWoffset		Get that window's global offsets.		jsr	endDraw			Put origin back.;		jsr	getSmallRect		smallRect = RECT around	Trash icon.				lda	<curWind		cmp	<deskPort		bne	collapseIntoWind		ldx	<curWind+2		cpx	<deskPort+2		bne	collapseIntoWind				tdc		clc		adc	#deskic		sta	<windBlk		stz	<windBlk+2 		bra	collapseOnDesktop	collapseIntoWind		pha		pha		pushZLong <curWind		_GetWRefCon		pla		sta	<windBlk		pla		sta	<windBlk+2	collapseOnDesktop		ldy	#windView		lda	[<windBlk],y		cmp	#viewBySmallIcon		beq	@viewBySmallIcon		cmp	#viewByIcon		bne	@viewByName		brl	@viewByIcon	@viewByName	ldy	#icTextY		lda	[<ic],y		clc		adc	<yoffset		sta	smallRect+y2		sec		sbc	#TITLE_H		;subtract the height of our text (most of the time,		sta	smallRect+y1		;this is also the height of our icon, and since we're						;zooming back to the beginning of our text, we'll						;come close, which is better than exists now)								lda	#textLeft*2		;text's normal left position		clc		adc	<xoffset		sec		sbc	#2		sta	smallRect+x2		;this is a rough approximation of the small icon's		sec				;position on the screen		sbc	#16		sta	smallRect+x1		;ok, it's an ugly way to do it, but getIconRect		brl	viewByAnythingElse	;doesn't work from here, so sue me -- andy 12/22/90	@viewBySmallIcon		lda	#1		jsr	GetIconPtr*** Scrunched - 21-Mar-93 JCM;;;		ldy	#4;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y				jsr	UnlockICBLKHAND		*** End - 21-Mar-93 JCM		ldy	#icx			;get small icon's x coordinates		lda	[<ic],y		clc		adc	<xoffset		adc	#2		sta	smallRect+x2		ldy	#imWidth		sec		sbc	[<icon],y		sta	smallRect+x1		ldy	#icy			;get small icon's y coordinates		lda	[<ic],y		clc		adc	<yoffset		sta	smallRect+y2		ldy	#imHeight		sec		sbc	[<icon],y		sta	smallRect+y1		bra	viewByAnythingElse	@viewbyIcon					lda	<zero		jsr	GetIconPtr		*** Scrunched - 21-Mar-93 JCM;;;		ldy	#4;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y				jsr	UnlockICBLKHAND		*** End - 21-Mar-93 JCM				ldy	#icy			;icY		lda	[<ic],y		clc		adc	<yoffset		;Make global.		sta	smallRect+y2		;icY -is- y1		sec		ldy	#imHeight		sbc	[<icon],y		;add the height to get y2		sta	smallRect+y1				ldy	#icx		lda	[<ic],y			;icX		clc		adc	<xoffset		;Make global		sec		ldy	#imWidth		;subtract the width, which is actually half the		sbc	[<icon],y		;width (how convenient)		sta	smallRect+x1				clc		adc	[<icon],y		;width of icon		clc		adc	[<icon],y		;add twice because it lies about the width		sta	smallRect+x2		;or, says the width in 320 mode pixels	viewByAnythingElse		pulllong <curWind		pulllong <windBlk		rts		;=====================================================;	   Check if a window can be created.;900==================================================		EXPORT	ckIfWindckIfWind				IMPORT	doAlertWindow		IMPORT	AbortFind		IMPORT	OOMDump; --- Check if there are already the max number	of open	windows	----------		lda	#rasMaxWindows		No more	windows	can be opened.		ldx	myWindCount		How many windows are open now?		cpx	#WOpenMaximum		bcs	abort900; --- Check if there is	enough memory to open a	window -------------------		jsr	ckMemory		a + x =	real free memory.		bne	ok900		cmp	#WOpenThreshhold	Is there enough	memory to open a window?		bcs	ok900; JAM (5/16/89)  48K is a lot of memory to require for opening a window, fellas!;  Dan Oliver says that 32K was original threshhold that QuickDraw needed to keep going,;  plus 16K for slop.  Steve Glass says this number has been reduced at least once;  before.  It may not be wise to reduce it further at this time.  LetÕs pin this down.		pha				; hiword for result		pha				; loword for result		phx				; size of segment is result of ckMemory		pha				; lo-word of segment size		pei <MyID				lda <zero		pha				; don't care about attributes		pha		pha				; don't care about address		_NewHandle		ply				; make the stack safe for democracy		plx		bcs @AllocFailed		phx				; put the handle back on the stack		phy		jsl DisposeHandleGlue			; allocation successful@AllocFailed					; In any case, see if we shook loose any more RAM.		jsr	ckMemory		a + x =	real free memory.		bne	ok900		cmp	#WOpenThreshhold	Is there NOW enough memory to open a window?		bcs	ok900		; If we are here, we couldn't cajole enough memory out of the system.  Bummericus Maximus		stz	modifiers		;make sure the desktop doesn't auto-close						;a window if they were tunneling		jsl	OOMDump			;just in case, so we can display this alert		bcc	DeepMemoryErr		lda	#rasMemErr		;Nopeabort900	jsl	doAlertWindow		inc	AbortFind		sec				;Abort opens.		rtsok900		clc		rts;=====================================================;	   Check if a window can be created.;=====================================================		EXPORT	ckIfWindMaxckIfWindMax				IMPORT	doAlertWindow		IMPORT	AbortFind		IMPORT	OOMDumped		IMPORT	MemoryFull		IMPORT	OOMDeepHandle		IMPORT	TextAlert		;; --- Check if there are already the max number	of open	windows	----------;		ldx	myWindCount		How many windows are open now?		cpx	#WOpenMaximum		bcc	@checkMem		lda	#rasMaxWindows		No more	windows	can be opened.		jsl	doAlertWindow				stz	modifiers		;make sure the desktop doesn't auto-close						;a window if they were tunneling		inc	AbortFind		sec				;Abort opens.		rts;; Check out if we have enough memory to open the window;@checkMem	lda	>OOMDumped		;did the OOM queue dump yet?		beq	ok900			;if not, everything probably will be OK later				lda	>OOMDeepHandle+1		beq	DeepMemoryErr				pha		pha		_RealFreeMem		pla		plx				;if we have at least 1 bank, chance it and keep		bne	ok900			;going...				cmp	#32*1024		;if we have at least 32k free, chance it and hope that		bge	ok900			;we use the OOMDeepHandle later to inform the user				jsl	OOMDump			;see if we can get rid of either handle		bcc	DeepMemoryErr		;if not, they get the text screen to avoid crashing		stz	modifiers		;make sure the desktop doesn't auto-close						;a window if they were tunneling				lda	#rasMemErr		;tell the user they're toast.		jsl	doAlertwindow				inc	AbortFind		sec		rts		DeepMemoryErr	lda	#$FFFF		ldx	#MemoryFull		ldy	#MemoryFull>>16		jsl	TextAlert		stz	modifiers		;make sure the desktop doesn't auto-close						;a window if they were tunneling		inc	AbortFind		sec		rts		ENDP;================================;	   Close window.;================================;;   IN:	   TaskData = window to	close.;;  OUT:	   C1_PathName = trash.;	   C1_TempPath = trash.;;================================doClose		PROCNAME EXPORT		jsl	WatchCursor		jsr	noRename		Remove any rename field.store1		jsr	doClose2		jsl	arrowCursor		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Close the window in TaskData.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;   IN:	   TaskData = pointer to window	to close.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =		EXPORT	doClose2		IMPORT	finderVersionHandle		IMPORT	systemVersionHandle		IMPORT	zoomRefresh		IMPORT	closeAny		IMPORT	create_access		IMPORT	selectionIsChanging		IMPORT	drawIconState			doClose2;		; --- Get the ID of the	closing	window ------------------------------;		lda	<TaskData		;Get pointer of window to close.		ldx	<TaskData+2		jsr	getWindID		;ID the window being closed.						;wind = TaskData (window being closed).						;windBlk = pointer to window's info block.						;a = window's ID. (carry set if bogus, a=0)				bcc	@goodWindow		;who knows, maybe we're trying to close the		rts				;desktop (would be bad)		@goodWindow	sta	IDflag			;Remember window's ID.;; Get the icon that opened into the window;		ldy	#windIc			;Get the handle of the ICONOBJ		lda	[<windBlk],y		;that opened into the window or NIL if it's not a		sta	<icHand			;directory window		iny		iny		lda	[<windBlk],y		sta	<icHand+2;; dispatch to close routine for each type of window;		lda	IDflag				ldx	<zero@loop		cmp	@table,x		beq	@dispatch		inx		inx		cpx	#9*2		blt	@loop		jmp	closeWind		@dispatch	jmp	(@vectors,x)@table		dc.w	NoWindID		dc.w	SysWindID		dc.w	DirWindID		dc.w	TrashWindID		dc.w	ClipWindID		dc.w	InfoWindID		dc.w	VerifyWindID		dc.w	AboutWindID		dc.w	HelpWindID		@vectors	dc.w	closeWind	;Window ID error		dc.w	closeSys	;Close a system window		dc.w	closeDir	;Close a directory window		dc.w	closeTrash	;Close the Trash window (just hide)		dc.w	closeClip	;Close the clip board window (hide)		dc.w	closeInfo	;Close an 'Get Info' window		dc.w	closeVerify	;Close a 'Verify' or 'Validate' window		dc.w	closeAbout	;Close the about box		dc.w	closeHelp	;Close the help window		;=========================================;	   Close a system window.;=========================================;;   IN:	   TaskData = window to	close.;;  OUT:;;=========================================closeSys		pei	<TaskData+2		Pointer	of window to close.		pei	<TaskData		_CloseNDAbyWinPtr		Close desk accessory window.		rts;============================================;	   Close a directory window.;BLOCK 700 ==================================;   IN:	   TaskData = window to	close.;	   wind	= window to close.;	   windBlk = pointer to	window's info block.;	   icHand = handle of icon that	opened into window (or disk icon).;  OUT:;============================================closeDir	name		IMPORT	matchedFirst		IMPORT	matchedSecond		IMPORT	matchFirst		IMPORT	matchSecond		IMPORT	walkWindow		IMPORT	WhichWindow		dec	myWindCount		Decrement my window counter.; --- Mark the icon that opened	into this window as closed -------------------		jsr	lockic			;ic = (icHand)				jsr	collapse		Collapse window	into mother icon, icon gets unlocked		jsr	afterCollapse; --- Every icon in the	closing	window that is opened will --------------; --- have to be linked	back to	the mother disk	icon --------------------		jsr	getWindPath		C1_pathname = window's pathname (use later).				ldy	#windDiskIc		;icHand = disk icon to which this window belongs		lda	[<windBlk],y		sta	<icHand		iny		iny		lda	[<windBlk],y		sta	<icHand+2				lda	[<icHand]		;deref the root device icon		sta	<work		ldy	#2		lda	[<icHand],y		sta	<work+2						ldy	#icFlag			;see if it's write protected		lda	[<work],y		and	#icLocked		;if so, we'll skip trying to write		sta	saveFinderData		;finder data		lda	#icFlag			;also don't save finder data if it's offline		lda	[<work],y		and	#icOffline		ora	saveFinderData		sta	saveFinderData				ldy	#icDevInfo		lda	[<work],y		;look at the 'write allowed' bit		and	#$0040		eor	#$0040		ora	saveFinderData		;include it with the write protected stuff		sta	saveFinderData				lda	<icHand			Pass handle of icon that open windows		sta	<work			should be linked back to.		lda	<icHand+2		sta	<work+2		lda	#linkBack		jsr	walkOfLife3		lda	<TaskData		;Get the window's information block.		ldx	<TaskData+2		jsr	getwRefCon2		jsr	removeMenuItem		;take the window out of the windows menu		;; Allocate a Finder.DATA buffer;		stz	write_len		Flag - 'write to position file'.		jsr	ckDataWrite		Should data files be saved?		bne	dontWrite				lda	saveFinderData		bne	dontWrite		ldy	#windItems		;if there 500 items or more, don't write finder.data		lda	[<windBlk],y		cmp	#500		bge	dontWrite				pha		pha		ldy	#windItems		lda	[<windBlk],y		pha		pea	iconPOSsize		_Multiply		pla		plx		bne	dontWrite		;if we need more than a bank (~>1000 icons)				clc		adc	#FDataSize		;allocate a buffer for this many items		ldx	#$4000			;Allocated the buffer as locked.		jsr	allocate2		;Allocate a buffer.		sta	<posFile		;Save handle.		stx	<posFile+2		bcc	ok700			;Able to allocate buffer?dontWrite	inc	write_len		;Flag - "don't write to position file".		brl	enter700		;Skip storage to FINDER.DATA buffer.;; --- Build the	FINDER.DATA buffer ---------------------------------------;ok700		jsr	derefHand		temp = (posFile).;; FINDER.DATA version number;		lda	#FinderVer		Store ID number.		sta	[<temp]		;; FINDER.DATA position and size of window;		pha		pha		pushZLong <taskData		_GetContentRgn		pulllong <deref				lda	[<deref]	;deref rgn handle		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref				ldy	#x2+2		;no, don't fix this, it's not supposed to copy the first@loop		lda	[<deref],y	;two bytes of the structure since the bounding rect of		sta	[<temp],y	;the struct region is at offset +2		dey			;andy and DAL, 1/7/91		dey		bne	@loop				pha		pha		pei	<taskData+2		;get the zoom rectangle		pei	<taskData		_GetZoomRect		pulllong <deref				ldy	#6		ldx	#FDataZoomRect+6@zrLoop		lda	[<deref],y		phy		txy		sta	[<temp],y		ply		dex		dex		dey		dey		bpl	@zrLoop;; FINDER.DATA window's origin;		pha				;Get the window's origin.		pha		pei	<TaskData+2		pei	<TaskData		_GetContentOrigin		ldy	#FDataYOrigin		;Save window's origin.		pla		sta	[<temp],y		pla		iny		iny		sta	[<temp],y		ldy	#windView		Save window's view.		lda	[<windBlk],y		ldy	#FDataView		sta	[<temp],y;; see if they were looking at a list view with the double height info bar;		lda	prefer			;save the existing preferences		ldy	#FDataInfoBar		sta	[<temp],y		ldy	#windItems		;save the number of items		lda	[<windBlk],y		ldy	#FDataItems		sta	[<temp],y				ldx	#6			;zero out the reserved spaces		ldy	#FDataReserved2+2		lda	<zero@rLoop		sta	[<temp],y		dey		dey		dex		dex		bpl	@rLoop					ldy	#FDataStartAt		lda	#FDataSize		sta	[<temp],y		; ------ Store the names and positions of all the icons	in the window -------; ------ Also, free every ICONOBJ in the window	-----------------------------enter700	lda	<temp		clc		adc	#FDataSize		sta	<work		lda	<temp+2		adc	<zero		sta	<work+2				jsr	FreeAllIcons; ------ Store the names and positions of all the icons	-------------------; ------ on the	desktop	that belong to the window  ------------------------		lda	write_len		Should I store to FINDER.DATA buffer?		bne	freeWind;; Save position file to disk;		jsr	addDataName		bcs	error700		Pathname error?		lda	<temp			Pass address of	buffer to write.		sta	write_buff		lda	<temp+2		sta	write_buff+2		lda	<work		sec		sbc	<temp		sta	write_len		lda	<work+2		sbc	<temp+2		sta	write_len+2				lda	write_len		;set the total length without the header		sec		sbc	#FDataSize		;FDataSize is the size of the header		ldy	#FDataRecSize		sta	[<temp],y		lda	write_len+2		sbc	<zero		ldy	#FDataRecSize+2		sta	[<temp],y						lda	write_len+2		pha				Buffer's new size.		lda	write_len		pha		pei	<posFile+2		Free posFile.		pei	<posFile		_SetHandleSize			Shrink buffer size. (ok on locked block)		lda	#DATAFTYPE		Set create file	type to	Finder data file.		sta	file_type		Just in	case data file is created.		lda	#$0004			; set invisible bit (DJB - 12/17/88)		tsb	create_access				inc	NoDOSerr		Don't handle DOS errors.		jsr	doWrite		dec	NoDOSerr		lda	#$0004			; clear invisible bit (DJB - 12/17/88)		trb	create_accesserror700	pei	<posFile+2		Free posFile.		pei	<posFile		jsl DisposeHandleGluefreeWind	jsr	freeInfoBlk		Free window's info block.;    (((((( Fall through to CloseWind )))))); = = =	= = = =	= = = =	= = = =	= =;	   Window ID error.; = = =	= = = =	= = = =	= = = =	= =;;   IN:	   TaskData = window to	close.;;  OUT:	   Window closed.;; = = =	= = = =	= = = =	= = = =	= =		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCMcloseWind		lda	quit_flags		beq	@normal		pha		pei	<TaskData+2		Pass the window	pointer.		pei	<TaskData		_GetWFrame		pla				and	#Å(F_VIS)		; make it invisible				pha		pei	<TaskData+2		Pass the window	pointer.		pei	<TaskData		_SetWFrame			; fake a close window		@normal		ldx	<TaskData+2		Pass the window	pointer.		lda	<TaskData		jsl	CloseThisWindow		rts;; Free all the icons allocated to our window, <windBlk;		EXPORT	FreeAllIconsFreeAllIcons	jsr	getHeadIcon		sta	<icHand		stx	<icHand+2		bra	enter701lop701		jsr	lockic		lda	write_len		Should I store to FINDER.DATA buffer?		bne	skip701		jsr	storePosskip701		pei	<icHand+2		Pass handle to be freed.		pei	<icHand		jsr	killInfoWind		Close icon's info window, if any.		ldy	#icNext+2		lda	[<ic],y		sta	<icHand+2		dey		dey		lda	[<ic],y		sta	<icHand			;Store handle of next ICONOBJ.		jsl DisposeHandleGlue		;Free ICONOBJ.enter701	lda	<icHand+1		;Any more in list?		bne	lop701		rts		;; locals;menuItem2Remove	dc.w	0			;menu item we're removing right nowsaveFinderData	dc.w	0; hideWind;;     in: taskdata = window to hide;;    out:  window hidden;.....................................................................hideWind		pei	<taskData+2		pei	<taskData		_HideWindow		rts; close the about box;.....................................................................closeAbout			IMPORT	aboutWindowPtr		IMPORT	aboutWindow		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		jsr	setSmallRect				pha		pha		pushZLong <taskData		_GetStructRgn		phd		tsc		tcd				lda	[3]		;deref the handle to the region		tax		ldy	#2		lda	[3],y		sta	3+2		stx	3		ldy	#6+2		;no, don't fix this, it's not supposed to copy the first@loop		lda	[3],y		;two bytes of the structure since the bounding rect of		sta	bigRect-2,y	;the struct region is at offset +2		dey			;andy and DAL, 1/7/91		dey		bne	@loop				pld		pla		pla		lda	#1		;only draw desktop		sta	zoomRefresh				jsr	hideWind				lda	<zero		;collapse the zoom rect		jsr	ZoomRect		lda	#2		;only draw icons		sta	zoomRefresh		pushlong #bigRect		_RefreshDesktop		pushlong finderVersionHandle		jsl DisposeHandleGlue				pushlong systemVersionHandle		jsl DisposeHandleGlue		lda	<TaskData	;Get the window's information block.		ldx	<TaskData+2		jsr	getwRefCon2		jsr	removeMenuItem	;take the about box out of the window menu		lda	<taskData		ldx	<taskData+2		jsl	CloseThisWindow				pha			;unload the dynamic segment for the About		pha			;box (mark it as purgable) -- to be nice to		pha			;DAL -- andy 1/9/91		pushlong #aboutWindow		_UnloadSeg		pla			;memID		pla			;file#		pla			;seg #		stz	aboutWindowPtr	;zero out aboutWindowPtr just in case		stz	aboutWindowPtr+2		rts		; close the help window;.....................................................................closeHelp		IMPORT	helpWindowPtr		IMPORT	helpWindow		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		jsr	setSmallRect				pha		pha		pushZLong <taskData		_GetStructRgn		phd		tsc		tcd				lda	[3]		;deref the handle to the region		tax		ldy	#2		lda	[3],y		sta	3+2		stx	3		ldy	#6+2		;no, don't fix this, it's not supposed to copy the first@loop		lda	[3],y		;two bytes of the structure since the bounding rect of		sta	bigRect-2,y	;the struct region is at offset +2		dey			;andy and DAL, 1/7/91		dey		bne	@loop				pld		pla		pla		lda	#1		;only draw desktop		sta	zoomRefresh				jsr	hideWind				lda	<zero		;collapse the zoom rect		jsr	ZoomRect		lda	#2		;only draw icons		sta	zoomRefresh		pushlong #bigRect		_RefreshDesktop		lda	<TaskData	;Get the window's information block.		ldx	<TaskData+2		jsr	getwRefCon2		jsr	removeMenuItem	;take the about box out of the window menu		lda	<taskData		ldx	<taskData+2		jsl	CloseThisWindow				pha			;unload the dynamic segment for the About		pha			;box (mark it as purgable)		pha						pushlong #helpWindow		_UnloadSeg		pla			;memID		pla			;file#		pla			;seg #				stz	helpWindowPtr	;zero out aboutWindowPtr just in case		stz	helpWindowPtr+2		rts		; remove the title of one of the info windows;.....................................................................		EXPORT	removeMenuInfoItemremoveMenuInfoItem		phb		phk		plb		pei	<windBlk+2		pei	<windBlk				stx	<windBlk		sty	<windBlk+2		jsr	removeMenuItem				pla		sta	<windBlk		pla		sta	<windBlk+2		plb		rtl;; now that we know where the window's info block is, get rid of the menu item ID for this window.  If it gets; all the way down to $f-zero, then re-attach the "No Windows Open" resource to the window;		IMPORT	lastOnTop		EXPORT	removeMenuItemremoveMenuItem	name		pei	<windBlk		pei	<windBlk+2		ldy	#windMenuItem		lda	[<windBlk],y		sta	menuItem2Remove				pha				;if there's currently a checkmark		pha				;beside the little dude, then we need to		_GetMItemMark			;force an update next time we get back to the		pla				;main loop		beq	@notChecked		stz	lastOnTop@notChecked				lda	menuItem2Remove		pha		_DeleteMItem				stz	matchedFirst		lda	#DirWindID+InfoWindID+TrashWindID+ClipWindID+VerifyWindID+AboutWindID+HelpWindID		ldx	#matchFirst		;don't check for anything, match the first open window		jsr	walkWindow		lda	matchedFirst		bne	@doneMenu				pea	2			;refIsResource		pushlong #resNoWindowsOpen	;resource ID		pea	$ffff			;add onto the end		pea	idWindowsMenu		_InsertMItem2		@doneMenu	lda <zero			;fix the windows menu's size since we lost a menu item		pha		pha		pea	idWindowsMenu		_CalcMenuSize		pla		sta	<windBlk+2		pla		sta	<windBlk		rts	; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Close icon's info window.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   ic =	pointer	to icon.;;  OUT:	   if ic has info window, the window will be closed.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	killINfoWindkillInfoWind					ldy	#icInfo+1		lda	[<ic],y		beq	exit700		pei	<TaskData+2		Save.		pei	<TaskData		pei	<windBlk+2		pei	<windBlk		; 2/26/90 rdl fix BRC#53087 / DTS 89.0398  &  BRC#60184 / MSF131FND; highest byte of TaskData was nonzero, causing crash when emptying trash if an iconÕs;   Info wdw was open		stz	<TaskData+2; end of 2/26/90 rdl fix		sta	<TaskData+1		Pass pointer to	info window to close.		dey		lda	[<ic],y		sta	<TaskData		ldx	<TaskData+2		Get window's info block pointer.		jsr	getwRefCon2				dec	myWindCount		; JAM 7/14/88, to fix bug 25373				jsr	hideWind		;hide the window, THEN free the info block		jsr	removeMenuItem		jsr	freeWind		;finally, free the info block for this window 		pla				;Restore.		sta	<windBlk		pla		sta	<windBlk+2		pla		sta	<TaskData		pla		sta	<TaskData+2exit700		rts;===============================================;	   Close an 'Get Info' window.;BLOCK 300 =====================================;   IN:	   TaskData = window to	close.;	   wind	= window to close.;	   windBlk = pointer to	window's info block.;	   icHand = handle of icon that	opened into window (or disk icon).;  OUT:	   Window closed.;	   Info	block freed.;===============================================closeInfo		IMPORT	writeComment		IMPORT	doAlertWindow		IMPORT	pathGetRoot		IMPORT	c1_source		dec	myWindCount		Decrement my window counter.		jsr	lockic			ic = (icHand);; first, see if the icon came from the network and if it's already extended, and if it's; already extended, if it has only a >GS< resource fork... if all of that is true, and we; have some text to write back, then we'll ask about extending the file;; we ought to have a routine in here which can walk back to the disk icon to check if it's; locked...;		ldy	#icFlag			;is it locked?		lda	[<ic],y			and	#icLocked		beq	@notLocked		brl	@done			;if so, forget about writing anything@notLocked	ldy	#windDirty		lda	[<windBlk],y;;;		and	#$7fff			;mask off the 'GS fork' bit		asl a		lsr a		cmp	#5			;is it some kind of extended file?		bne	@noFork			;nope, then we might have to ask them if they		brl	@hasFork		;want it extended...@noFork		ldy	#icFlag+2		;check if the icon's on the network		lda	[<ic],y		and	#icNetWork>>16		bne	@goNetwork		@goExit		brl	@done			;if it's not on the network, don't write squat						;because it doesn't have a fork or a prayer to						;get written as a comment@goNetwork	ldy	#windAccess		lda	[<windBlk],y		and	#icInfoMakeChanges>>16	;make changes in order to ask them to extend it		beq	@goExit			;exit if we can't make changes;; now, for a slight diversion -- if it's a SYS file on the network (ie, how we got here),; and it's also a SYS file, then skip this step and only write the network comment;		ldy	#icFType		;if it's a SYS file, never ask if they want		lda	[<ic],y			;a resource fork added		cmp	#$00bd		beq	@goHasFork		cmp	#$00f9		beq	@goHasFork		cmp	#$00ff		bne	@notSYSfile@goHasFork	brl	@hasFork@notSYSfile		lda	[<ic],y			;if it's any kind of volume, don't ask		bpl	@notVolume		brl	@hasFork@notVolume		cmp	#$000f			;if it's a folder, don't ask...		bne	@notFolder		brl	@hasFork@notFolder		pha				; space for handle		pha		PushZLong <taskData		pushlong #idCommentFld		_GetCtlHandleFromID		;handle to TE record		pla		sta	<deref		sta	teHandle		pla		sta	<deref+2		sta	teHandle+2				lda	[<deref]		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref				ldy	#$16		lda	[<deref],y		cmp	#$8500			;textedit ctrlProc		bne	@goExit		dey		dey		lda	[<deref],y		beq	@gotComment		brl	@done@gotComment	ldy	#$10			;check the textEdit dirty flag		lda	[<deref],y		and	#$0040		beq	@goExit			;if it's not dirty, they didn't touch it		;; If we don't already have a comment, would they like to add one?  If so, extend the; file for them and write a new resource map out... if not, just save to the; network database;; and, for a slight diversion, if there aren't any characters in the te control, then; we're not going to ask them about extending it (kind of stupid to add a null comment);				pushlong #teChars		pea	1			;return 1 field		pushlong teHandle		_TEGetTextInfo		lda	teChars		ora	teChars+2		beq	@hasFork		lda	#rasServerComment	;do they really want to add the comment?		jsl	doAlertWindow		beq	@hasFork@addResourceAgain		pha						pha				;auxtype		pha				;filetype		pha				;access		lda	#InfoBlock.windText.path ;fill in the path information for both		clc				;calls		adc	<windBlk		tax		lda	<windBlk+2		adc	<zero		pha		phx		_CreateResourceFile		bcs	@badCreate				ldy	#windDirty		lda	#$8005		sta	[<windBlk],y				ldy	#icForked		;say that the icon is now extended		lda	[<ic],y		ora	#$8000		sta	[<ic],y		bra	@hasFork		;; bad create -- we weren't able to finish creating the resource fork and map, so something; is very wrong... they could be doing all sorts of evil things with the disk right now;@badCreate	cmp	#$46		beq	@lostTheDisk		@lostTheDisk	pushlong #C1_Source		lda	#InfoBlock.windText.path		clc		adc	<windBlk		tax		lda	<windBlk+2		adc	<zero		pha		phx		jsl	PathGetRoot						lda	>C1_Source		and	#$00ff		dec	a		xba			sta	>C1_Source+1				lda	#rasInsertDiskOrCancel8		jsl	doAlertWindow		beq	@done		bra	@addResourceAgain	; nope ... try again to keep them honest		@hasFork	pushZLong <taskData		pushZLong <windBlk		pushZLong <ic		jsl	writeComment		@done		ldy	#icInfo+1		Mark icon as not having	a Get Info window.		lda	<zero		sta	[<ic],y		jsr	collapse		;Collapse window into mother icon while also hiding it;; last I looked, windBlk was still ok here;		pha				;get the control handle of the info window's		pha				;icon button		pushZLong <wind		pushlong #$8029			;idIconButton		_GetCtlHandleFromID		pulllong <deref				lda	[<deref]		;deref the icon button's handle		tax		ldy	#2		lda	[<deref],y		sta	<deref+2		stx	<deref				ldy	#$40+2			;from the icon button control record, dispose the		lda	[<deref],y		;reference to the icon handle		pha		dey		dey		lda	[<deref],y		pha		jsl DisposeHandleGlue				jsr	removeMenuItem		;get rid of the menu item for this		brl	freeWind		Free info block, close window.;; local locals;teChars		dc.L	0			;# of chars in textedit controlteHandle	dc.L	0			;text edit handle;===============================================; Close a 'Verify' or 'Validate' window.    ;===============================================;;   IN:	   TaskData = window to	close.;	   wind	= window to close.;	   windBlk = pointer to	window's info block.;	   icHand = handle of disk icon.;;  OUT:	   Window closed.;	   Info	block freed.;;===============================================		EXPORT	closeVerifycloseVerify			dec	myWindCount		;Decrement my window counter.				jsr	hideWind		jsr	removeMenuItem				ldy	#windUsed+2		lda	[<windBlk],y		pha		dey		dey		lda	[<windBlk],y		pha		jsl DisposeHandleGlue				jmp	freeWind				EXPORT	VerifyCloseVerifyClose	lda	<wind			;Get pointer of window to close.		sta	<TaskData		ldx	<wind+2		stx	<TaskData+2		jsr	getWindID		;ID the window being closed.		jsr	closeVerify				clc		rts;=======================================================;	   Close the clip board	window (hide).;=======================================================;;   IN:	   TaskData = window to	close.;;=======================================================closeClip		jsr	setSmallRect		;smallRect = point in upper left corner					 	;of screen.		jsr	collapse2		jmp	removeMenuItem;========================================================;	   Close the Trash window (just	hide).;BLOCK 600 ==============================================;;   IN:	   TaskData = window to	close.;	   wind	= window to close.;	   windBlk = pointer to	window's info block.;	   icHand = handle of Trash icon.;;  OUT:;;========================================================closeTrash		jsr	lockic				jsr	collapse		jsr	afterCollapse				brl	removeMenuItem; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Zoom	window down to owner icon.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   TaskData = window to	collapse.;	   wind	= window to close.;	   windBlk = pointer to	window's info block.;	   icHand = handle of icon that	opened into window (or disk icon).;;  OUT:	   Zoom	Rect called.;	   Window hidden.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =		IMPORT	zoomRefreshcollapse	name				jsr	getSmallRect		jsr	unlockic		Leave opened icon unlocked.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Zoom	window down to smallRect.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   smallRect = destination for zoom.;	   TaskData = window to	collapse.;	   wind	= window to collapse.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =collapse2			IMPORT	GetRectRgn		IMPORT	FreeRectRgn		IMPORT	AddIconRgn		IMPORT	StartDraw		IMPORT	EndDraw		IMPORT	pushzpage		IMPORT	GetIconRect		IMPORT	GetOnlyRectRgn		IMPORT	DrawDeskIcon		IMPORT	ToDesktop		jsr	getBigRect2		;Get window's RECT for zoomRect.		lda	quit_flags		beq	@doCollapse		brl	@skipIt			;don't collapse if we're shutting down@doCollapse		pha				;see if we are closing the front window		pha		_FrontWindow			;but leave the parms on the stack		lda	1,s		tax		lda	3,s		cmp	<taskData+2		;_RefreshDesktop		bne	@notInFront		cpx	<taskData		bne	@notInFront				lda	#1			;just erase to background		sta	zoomRefresh@notInFront	jsr	hideWind		;window's ptr		lda	<icHand+1		beq	@dontDraw				jsr	lockic		jsr	drawIconState				jsr	unlockic@dontDraw		lda	<zero			;Go down direction.		jsr	zoomrect		pla				;then check to see if the frontwindow was		plx				;chosen -- if not, then don't do a special		cmp	<taskData		;_RefreshDesktop		bne	@skipIt		cpx	<taskData+2		bne	@skipIt		pushZLong <curWind		pushZLong <wind		pushZLong <windBlk		pushZLong <rectRgn				jsr	toDesktop		; switch to desktop 		jsr	toDeskPort		; switch to desktop port				jsr	GetOnlyRectRgn				pushZlong <rectRgn		pushlong #bigRect		_RectRgn				lda	#2			;only draw icons		sta	zoomRefresh		jsr	DrawDeskIcon		pushZLong <rectRgn		_DisposeRgn				pulllong <rectRgn		pulllong <windBlk		pulllong <wind		pulllong <curWind@skipIt		rts; afterCollapse;; check to see if the icon needs to be redrawn a specific way (closed, highlighted, etc);.....................................................................afterCollapse			IMPORT	IconCount		IMPORT	findSelect		IMPORT	findFirstIcon				pei <zero			;don't redraw anything at all		jsr	lockic		ldy	#icWind			;Did the icon really come from		lda	[<ic],y			;the closing window?		cmp	<TaskData		bne	@notClosing		iny		lda	[<ic],y		cmp	<TaskData+1		bne	@notClosing		lda	<zero			;Clear icon's open window field.		sta	[<ic],y		dey		sta	[<ic],y		ldy	#icFlag			;say that the window isn't opened from this icon		lda	[<ic],y			;any more		and	#_icOpened		sta	[<ic],y		lda	#$FFFF			;say this must be redrawn		sta	1,s@notClosing;;; Removed 3-Mar-93 DAL -- always select the icon we're closing into;		lda	<curWind		;if we're closing the current window for selected icons,;		cmp	<TaskData		;then we can safely highlight the icon which we're zooming;		bne	@notClosingCurrent	;down to, and set the window which that icon is in to;		lda	<curWind+2		;be curWind;		cmp	<TaskData+2;		beq	@closingCurrent;;@notClosingCurrent;		stz	iconCount;		;		pushZLong <windBlk;		pushZLong <wind;		pushZLong <icHand;		pushZLong <ic;;		lda	#findFirstIcon;		jsr	findSelect;		;		pulllong <ic;		pulllong <icHand;		pulllong <wind;		pulllong <windBlk;		;		lda	iconCount;		bne	@currentHasIcons;;@closingCurrent*** added 3-Mar-93 DAL		pushzlong <wind		pushzlong <windBlk		pushzlong <ic		pushzlong <icHand		jsr	deselectAll		pulllong <icHand		pulllong <ic		pulllong <windBlk		pulllong <wind*** end 3-Mar-93		ldy	#icMom			;Switch to window that opened icon is in.		lda	[<ic],y		sta	<curWind		iny		iny		lda	[<ic],y		sta	<curWind+2		;;;		jsl	selectionIsChanging	;removed 3-Mar-93 DAL						ldy	#icFlag			;mark the icon as selected		lda	[<ic],y		ora	#ICSELECTED		sta	[<ic],y						lda	#$FFFF		sta	1,s;;;@currentHasIcons		jsr	lockic		pla		beq	@done		jsr	drawIconState@done		jsr	unlockic		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Free	window info block record. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   windBlk = pointer to	info block.; ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		EXPORT	freeInfoBlkfreeInfoBlk			pha				;Space for result.		pha		pei	<windBlk+2		;Pass pointer to window info block.		pei	<windBlk		_FindHandle			;Find the handle of the info block,		jsl DisposeHandleGlue		;and set it free (if it loves you			rts				;it will come back to you).; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Compare 'pathname' to icOwner field.;BLOCK 500  = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   ic =	pointer	to icon.;	   C1_PathName = name to compare to.;;  OUT:	   Carry clear if name doesn't match or not an extended icon.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =		EXPORT	ckExNameckExName			IMPORT	WStrCompare		ldy	#icFlag		lda	[<ic],y		and	#ICEXTENDED		; only check extended icons		clc		beq	@done		pha				; space for result flag		lda	<ic		clc		adc	#icOwner		ldx	<ic+2		bcc	@nr		inx@nr		phx				; pass pointer to icon's name		pha		PushLong #C1_PathName		jsl	WStrCompare		pla		cmp	#1			; return carry flag@done		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Called by WalkOfLife	to link	open;	   windows from	the closing window,;	   to the icon that opened the closing window.;BLOCK 100  = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   work	= handle of icon opened	windows	can be linked back to.linkBack	ldy	#icFlag			Is this	icon open?		lda	[<ic],y		and	#ICOPENED		beq	exit100		ldy	#icWind+2		Get the	window that icon opened	into.		lda	[<ic],y		tax		dey		dey		lda	[<ic],y		jsr	getwRefCon2		ldy	#windIc			Icon that window is being linked back to.		lda	<work		sta	[<windBlk],y		iny		lda	<work+1		sta	[<windBlk],yexit100		clc				Continue flag.		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Store icon's name and;	   position in posFile buffer.;BLOCK 200  = =	= = = =	= = = =	= = = =	= = = =;;   Called from	walkOfLife.;;   IN:	   ic =	pointer	to locked ICONOBJ;	   work	= pointer to locked posFile buffer;;  OUT:    work = pointer to next position in posFile buffer;	          for next record;;	   work	= max number of	icon spaces in buffer;	   work+2 = index into buffer.; 1-May-89 JAM:  Made some changes so that file names are always saved upper-case;    in the FINDER.DATA files for backwards compatibility to Finders prior to 1.3		IMPORT  ToUpperCase		; we're in longa mode so this is the guystorePos	name 		ldy	#icName			;save how long this record is		lda	[<ic],y				and	#$00ff		clc		adc	#8		inc	a			;plus one for the length byte of the name! argh!		sta	[<work]				ldy	#icFlag			;Get icon's color.		lda	[<ic],y		and	#$FF00		ora	#$0001			;Icon came from directory window.			ldy	#IconPOSColor		sta	[<work],y		ldy	#icy			;save icon's y position		lda	[<ic],y		ldy	#IconPOSy		sta	[<work],y		ldy	#icx			;save icon's x position		lda	[<ic],y		ldy	#IconPOSx		sta	[<work],y						ldy	#icName			;save icon's name		lda	[<ic],y		and	#$00ff		ldy	#IconPosName		sta	[<work],y		clc		adc	#IconPosName		sta	nameLength		ldx	#iconPosName+1		ldy	#icName+1@loop		lda	[<ic],y		jsl	ToUpperCase		phy		txy		sep	#$20		sta	[<work],y		rep	#$20		ply		iny		inx		cpx	nameLength		blt	@loop		beq	@loop							lda	[<work]		sec				;always add 1 more than we have to continue		adc	<work			;at the next available spot in the file		sta	<work		bcc	@nr		inc	<work+2@nr				clc				;Continue flag.		rts;; locals;nameLength	dc.w	0		ENDP