********************************************************		TITLE	'Apple IIGS Finder   MISC.aii'*						       **		    Apple //GS Finder		       **		      Misc Routines		       **						       **	Copyright Apple	Computer, Inc. 1986-1992       **		   All Rights Reserved		       **						       **		  Written by Dan Oliver		       **		     and Cheryl	Ewy		       **						       ** ===> converted to MAX 04/21/88 - DJB		       **						       **						       ********************************************************** Modification History for version 1.2:* -------------------------------------* 05/17/88 DJB	- Changed "startCat" routine for hack*		- Changed "nextCat" routine for hack*		- Changed "readDir" routine for hack* 05/27/88 DJB  - added code to convert dates back to old format!* 08/06/88 DJB	- added SaveDevStats() call to ProDOSerr routine.********************************************************** 6.0 work mostly by Andy Nicholas, late 1990 to early 1992*********************************************************** 6.0.1 work mostly by Dave Lyons, 1992.**   Most changes marked with "DAL"*********************************************************;;; Files	needed:;;	   Misc.aii;	   MiscDIALOG.aii;		PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM		PRINT	NOPAGE		PAGESIZE $FFFF,126		MACHINE	M65816		LONGA	ON		LONGI	ON		BLANKS	OFF		INCLUDE	'ALL.MACROS'		INCLUDE	'special.macros'		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'				PRINT	ON;---------------------------------------------------------------;; Zero Page One	Equates (used by DIB routines and Catalog routines);;---------------------------------------------------------------MyID		equ	0			;ID number to allocate memory.DIBindex	equ	MyID+2			;Index to current DIB.SlotAddr	equ	DIBindex+2		;Pointer to slots.driveNum	equ	SlotAddr+4devID		equ	driveNum+2		;Device ID.input		equ	devID+2dosBuffer	equ	input+4			;Handle of 512 byte DOS buffer.dirBuffer	equ	dosBuffer+4		;Pointer to 512 byte DOS buffer.blockCnt	equ	dirBuffer+4		;Block file counter.e_length	equ	blockCnt+2		;Length of a directory entry.e_blockLen	equ	e_length+2		;Number of entries per directory block.e_numFiles	equ	e_blockLen+2		;Number of files in this directory.ePtr		equ	e_numFiles+2		;Index to current directory entry.ErrNamePtr	equ	ePtr+4entries		equ	ErrNamePtr+4work		equ	entries+2		;$80-$FF used.;---------------------------------------------------------------;; Zero Page Two	Equates (used by Dialog	routines and IconDraw routines);;---------------------------------------------------------------diaWind		equ	0			;Pointer to dialog window.DefaultBtn	equ	diaWind+4		;Handle of default simple button.LEfield		equ	DefaultBtn+4		;Handle of Line Edit record.foundCtl	equ	LEfield+4		;Handle of control to track.desPtr		equ	foundCtl+4		;Pointer of where to store line edit text.TaskRec		equ	desPtr+4what		equ	TaskRecmessage		equ	what+2when		equ	message+4yrat		equ	when+4			;General y coordinate holder.xrat		equ	yrat+2			;General x coordinate holder.modifiers	equ	xrat+2TaskData	equ	modifiers+2TaskMask	equ	TaskData+4template	equ	TaskMask+4String1Ptr	equ	template+2String2Ptr	equ	String1Ptr+4Number		equ	String2Ptr+4		;changed to long, 06/21/88 DJBNumItems	equ	Number+4StringPtr	equ	NumItems+2Just		equ	StringPtr+4TextLen		equ	Just+2BtnHeight	equ	TextLen+2BtnWidth	equ	BtnHeight+2BtnSpace	equ	BtnWidth+2BtnFlag		equ	BtnSpace+2BtnValue	equ	BtnFlag+2BtnDefProc	equ	BtnValue+2RadioIn		equ	BtnDefProc+4RadioOut	equ	RadioIn+4DiaSize		equ	RadioOut+4CntlFlag	equ	DiaSize+4CtlRect		equ	CntlFlag+2ItemID		equ	CtlRect+8CancelBtn	equ	ItemID+2		;Handle of cancel simple button.BtnID		equ	CancelBtn+4		;ID of button controlTemp		equ	BtnID+2ModeLess	equ	Temp+8			;added 05/10/88 DJB;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		import DisposeHandleGlue		IMPORT	EndCall		IMPORT	ErrOut		IMPORT	Strip		IMPORT	PathGetName;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	GetEntry		ENTRY	GetNumEntries		ENTRY	MiscStartup		ENTRY	StdEnd		ENTRY	StartCatalog		ENTRY	NextCatalog		ENTRY	EndCatalog		ENTRY	Catalog****************************************************************** MISC ROUTINES	- CALL TABLE*****************************************************************MiscRoutines	PROC		DC.L	MiscStartup		DC.L	0			;was  DiskScan 05/17/88 DJB		DC.L	0			;was  MakeDIBs 05/17/88 DJB		DC.L	0		DC.L	Catalog		DC.L	StartCatalog		DC.L	NextCatalog		DC.L	EndCatalog		DC.L	0		DC.L	0		DC.L	0		DC.L	0		DC.L	0		ENDP****************************************************************** MISC ROUTINES	- DATA DECLARATIONS*****************************************************************MRData		PROC*---------------------------------------------------------------* Constants*---------------------------------------------------------------*---------------------------------------------------------------* Data*---------------------------------------------------------------		ENTRY	ZeroPageZeroPage	DS.B	2			;Address of first zero page		ENTRY	Error_CodeError_Code	DS.B	2		ENDP****************************************************************** MiscEntry*****************************************************************MiscEntry	PROCNAME EXPORT;X contains the	number of the routine to execute		dex				;decrement routine #		txa				;create	index into table of addresses		asl	a		asl	a		tax		lda	>MiscRoutines,x		;get address of	routine		sta	>Adrs+1			;and store after the JSL		lda	>MiscRoutines+1,x		sta	>Adrs+2		lda	>ZeroPage		;load A	with zero page assigned	to usAdrs		jsl	Adrs			;execute the routine		rtl				;return	to calling routine		ENDP****************************************************************** MiscStartUp*****************************************************************MiscStartup	PROCdirectPage	equ	9IDnum		equ	directPage+2		phd		lda	directPage,s		;Get direct page to use,		sta	>ZeroPage		;and save		tcd		ldx	#$FE			;Clear 1  direct pagelop1		stz	<$00,x		dex		dex		bpl	lop1		lda	IDnum,s			;Get ID to use for memory allocation.		sta	<MyID		ldy	#4		jml	EndCall		ENDP****************************************************************** StdEnd0*****************************************************************StdEnd0		PROC		ldy	#0		bra	StdEnd				ENDP****************************************************************** StdEnd4*****************************************************************StdEnd4		PROC		ldy	#4		bra	StdEnd				ENDP****************************************************************** StdEnd6*****************************************************************StdEnd6		PROC		ldy	#6		bra	StdEnd				ENDP****************************************************************** StdEnd*****************************************************************StdEnd		PROC		plb				;restore data bank		lda	>error_code		;Get error code.		tax		beq	NoErr		lda	#0			;Reset error code to no error		sta	>error_code		;for next time.		jml	ErrOut			;error end callNoErr		jml	EndCall			;standard end call		ENDP****************************************************************** Setup	 (called by Catalog routines)*****************************************************************Setup		PROC		plx		phd		tcd		phb		phk		plb		lda	10,s			;Put the last input parameter		sta	<input			;into a direct page variable.		lda	12,s		sta	<input+2		phx		rts				ENDP		;===============================================================;;			Catalog	Routines;;	   Copyright Apple Computer, Inc. 1986-1987;		      All rights reserved;;		 By Dan	Oliver and Cheryl Ewy;; ===> converted to MAX 04/21/88 - DJB;;===============================================================; --- Directory block offsets ------------------------------------;EntryLen	equ	$23			;Length of each entry.;PerBlock	equ	EntryLen+1		;Number of entries per block.;NumFiles	equ	PerBlock+1		;Total number of file in directory.;EntryPtr	equ	NumFiles+6		;Pointer to first entry.;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	BuildPath		ENTRY	DoClose		ENTRY	GetFileInfo		ENTRY	DoOpen		ENTRY	ProDosErr		ENTRY	addFilename		ENTRY	addName		ENTRY	allocate		ENTRY	allocate2		ENTRY	endCat		ENTRY	nextCat		ENTRY	readDir		ENTRY	startCat****************************************************************** CATALOG ROUTINES - DATA DECLARATIONS*****************************************************************CatData		PROC; --- Open file	parameter list -------------		ENTRY	open_listopen_list	DC.W	3			;pcount		ENTRY	open_numopen_num	DC.W	0			;Returned reference number.		ENTRY	open_nameopen_name	DC.L	0			;Pointer of file's pathname.		DC.W	1			;request access (read only); --- Close file parameter list -------------		ENTRY	close_listclose_list	DC.W	1			;pcount		ENTRY	close_numclose_num	DC.W	0			;reference number; --- Get File Info parameter list ----------		ENTRY	info_listinfo_list	DC.W	12			;pcount		ENTRY	info_pathinfo_path	DC.L	0			;pathname		ENTRY	info_accessinfo_access	DC.W	0			;access attribute		ENTRY	info_typeinfo_type	DC.W	0			;file_type		ENTRY	info_auxinfo_aux	DC.L	0			;aux_type		ENTRY	info_storageinfo_storage	DC.W	0			;storage_type		ENTRY	info_createDateinfo_createdate	ds.b	8		ENTRY	info_modDateinfo_modDate	ds.b	8		ENTRY	info_OptionListinfo_OptionList	dc.L	OptionBuff		ENTRY	info_EOFinfo_EOF	dc.L	0		ENTRY	info_BlocksUsedinfo_BlocksUsed	dc.L	0		ENTRY	info_resourceEOFinfo_resourceEOF dc.L	0		ENTRY	info_resourceBlocksinfo_resourceBlocks dc.L 0;------ Added for hack, 05/17/88 DJB ----------------		ENTRY	ce_open_listce_open_list	DC.W	3		ENTRY	ce_open_numce_open_num	DC.W	0		ENTRY	ce_path_namece_path_name	DC.L	0		DC.W	1			;request access (read only)		ENTRY	ce_close_listce_close_list	DC.W	1		ENTRY	ce_close_numce_close_num	DC.W	0		ENTRY	ce_get_dir_listce_get_dir_list	DC.W	17			;pcount		ENTRY	ce_get_dir_numce_get_dir_num	DC.W	0			;reference number		ENTRY	ce_flags		EXPORT	ce_flagsce_flags	DC.W	0			;flags		ENTRY	ce_basece_base		DC.W	1			;base = forward relative		ENTRY	ce_dispce_disp		DC.W	1			;displacement = one entry at a time		DC.L	ce_name_buffer		EXPORT	ce_entry_num		ENTRY	ce_entry_numce_entry_num	DC.W	0			;entry number				EXPORT	ce_file_type		ENTRY	ce_file_typece_file_type	DC.W	0		EXPORT	ce_eof		ENTRY	ce_eofce_eof		DC.L	0		EXPORT	ce_blks_used		ENTRY	ce_blks_usedce_blks_used	DC.L	0		EXPORT	ce_create_date		ENTRY	ce_create_datece_create_date  DC.L	0,0			;2 longs		EXPORT	ce_mod_date		ENTRY	ce_mod_datece_mod_date	DC.L	0,0			;2 longs		EXPORT	ce_access		ENTRY	ce_accessce_access	DC.W	0		EXPORT	ce_aux_type		ENTRY	ce_aux_typece_aux_type	DC.L	0		DC.W	0		DC.L	optionBuff		EXPORT	ce_rsrc_eof		ENTRY	ce_rsrc_eofce_rsrc_eof	DC.L	0		EXPORT	ce_rsrc_blks		ENTRY	ce_rsrc_blksce_rsrc_blks	DC.L	0		ENTRY	optionBuff		EXPORT	optionBuffoptionBuff	DC.W	64		ds.B	2		ENTRY	OptionBuffFST		EXPORT	OptionBuffFSTOptionBuffFST	ds.b	2		DS.B	58		ENTRY	ce_name_bufferce_name_buffer	DC.W	32+4			;buffer size		EXPORT	ce_name_len		ENTRY	ce_name_lence_name_len	DC.W	0		EXPORT	ce_name		ENTRY	ce_namece_name		DS.B	32			;buffer for the name		EXPORT	ce_prodos_entry		ENTRY	ce_prodos_entryce_prodos_entry	DS.B	DirEntrySize+4		;standard prodos entry		ENDP;======================================;	   Start catalog.;======================================;;   IN:	   PUSH:LONG - pointer to directory pathname.;;======================================StartCatalog	PROC		jsr	setup		lda	<input		ldx	<input+2		jsr	startCat		jmp	StdEnd4				ENDP;===========================================;	   Get next catalog entry.;===========================================;;   IN:	   PUSH:LONG - space for result.;;  OUT:	   LONG	- pointer to directory entry (storage type nibble cleared).;;	   Error codes:;		 DOS read error, EndCatalog called.;		 $0061 - no more entries, EndCatalog called.;;===========================================NextCatalog	PROCresult		equ	10		jsr	setup		jsr	nextCat		sta	result,s		txa		sta	result+2,s		jmp	StdEnd0				ENDP;======================================;	   End catalog.;======================================;;   IN:	   None.;  OUT:	   None.;;======================================EndCatalog	PROC		jsr	setup		jsr	endCat		jmp	StdEnd0				ENDP;======================================;	   Start catalog routine.;======================================;;   IN:	   a = low address of pathname.;	   x = high address of pathname.;;======================================startCat	PROC		sta	ce_path_name		stx	ce_path_name+2		jsl	ProDOS			;do a prodos open call		DC.W	OPEN+C1		DC.L	ce_open_list		bcs	ce_error_out		lda	ce_open_num		sta	ce_get_dir_num		sta	ce_close_num		stz	ce_disp			;we want an entry count		stz	ce_base				jsl	ProDOS			;do a get dir entry call		DC.W	GET_DIR_ENTRY+C1		DC.L	ce_get_dir_list		;get the number of entries		ldx	#$0001			;setup for catalog		stx	ce_base		stx	ce_disp		bcc	ce_noerror				pha				jsl	ProDOS		DC.W	CLOSE+C1		DC.L	ce_close_list		stz	ce_close_num		place_error_out	sta	error_code		sec		rts		ce_noerror	lda	#0						clc		rts				;return carry flag; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Get next directory entry.;; changed for hack, 05/17/88 DJB; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =		ENTRY	nextCatnextCat      ; --- Check if no more directory entries ----------------------------------		jsl	ProDOS		DC.W	GET_DIR_ENTRY+C1		DC.L	ce_get_dir_list		bcc	tran		cmp	#$4F			; ignore BufferTooSmall errors		bne	ce_close_dirtran		jsr	ce_translate		ldx	#^ce_prodos_entry		lda	#ce_prodos_entry		clc		rtsce_close_dir	sta	error_code		jsl	ProDOS		DC.W	CLOSE+C1		DC.L	ce_close_list				stz	ce_close_num		sec		rts		ENTRY	ce_translatece_translate		ldy	#$27		lda	#$0000ce_clear_loop		sta	ce_prodos_entry,y		dey		bpl	ce_clear_loop		ldy	ce_name_len		;get the length of the name		sty	ce_prodos_entryce_move_loop		lda	ce_name-1,y		sta	ce_prodos_entry,y	;save the name (class 0)		dey		bne	ce_move_loop		lda	ce_file_type		sta	ce_prodos_entry+DirFType		lda	ce_blks_used		sta	ce_prodos_entry+DirSize		lda	ce_blks_used+2		sta	ce_prodos_entry+DirSize+2		lda	ce_eof		sta	ce_prodos_entry+DirEOF		lda	ce_eof+2 		sta	ce_prodos_entry+DirEOF+2		lda	ce_access		sta	ce_prodos_entry+DirAccess		lda	ce_aux_type		sta	ce_prodos_entry+DirAuxType		lda	ce_flags			; was it extended ?		bpl	dateStuff			; no		clc		lda	ce_prodos_entry+DirSize		adc	ce_rsrc_blks		sta	ce_prodos_entry+DirSize			lda	ce_prodos_entry+DirSize+2		adc	ce_rsrc_blks+2		sta	ce_prodos_entry+DirSize+2		clc		lda	ce_prodos_entry+DirEOF		adc	ce_rsrc_eof		sta	ce_prodos_entry+DirEOF 		lda	ce_prodos_entry+DirEOF+2		adc	ce_rsrc_eof+2 		sta	ce_prodos_entry+DirEOF+2dateStuff		ldy	#6ce_date		lda	ce_create_date,y		;get create date 		sta	ce_prodos_entry+DirCDate,y		lda	ce_mod_date,y			;get mod date 		sta	ce_prodos_entry+DirModDate,y		dey		dey		bpl	ce_date		rts; = = =	= = = =	= = = =	= = = =	=;	   End catalog.; = = =	= = = =	= = = =	= = = =	=		ENTRY	EndCatEndCat       		stz	<dosBuffer+1		;Set 'not cataloging' flag.				lda	ce_close_num		beq	@done				jsl	ProDOS		DC.W	CLOSE+C1		DC.L	ce_close_list		stz	ce_close_num		@done		rts		ENDP;======================================================================================;	   Catalog;======================================================================================;;   IN:	   LONG - space for result;	   LONG - space for result;	   WORD - space for result;	   WORD - space for result;	   WORD - space for result;	   LONG - pointer to address to call for callback routine;	   LONG - pointer to pathname (class 1), no separator at end;		    <= SP;;  OUT:	   LONG	- handle to catalog buffer, zero is error;	   WORD	- total	number of files	in catalog;	   WORD	- number of locked files in catalog;	   LONG - total number of bytes used by all files in catalog excluding folders;	   WORD - file system of catalog;	       <= SP;; This routine creates the complete catalog of a disk, subdirectory or file.; The catalog buffer is	an array of entry structures.  There are 4 types of; entries as shown below -;; File Entry;   WORD - $0000;   WORD - Flag	- 0 if file is not locked, non-zero if file is locked;   STRG - Filename, length byte first,	no separators;; Subdirectory Entry;   WORD - Offset to first entry for subdirectory's contents;   WORD - Flag	- 0 if subdir is not locked, non-zero if subdir	is locked;   STRG - SubDirName, length byte first, no separators;; EndSubDirectory Entry;   WORD - $FFFF;   WORD - Offset to subdirectory's entry;; EndCatalog Entry;   WORD - $FFFF;   WORD - $FFFF;; In addition, the Flag	word for the first catalog entry will contain the total; number of files in the catalog if the	calling	routine	requests it.;;	   For example,	the directory that looks like:;;	   ROOT				main directory;	     FRUIT			  subdirectory;	       APPLES			    subdirectory;		 CORTLAND		      file;		 MACS			      file;	       PEARS			    subdirectory;	     ANIMALS			  subdirectory;	       DOGS			    file;	       CATS			    file;	     VEGETABLES			  file;;	   Would have a	catalog	buffer that looks like:;;	   00:	 0D 00 00 00 04	R O O T		      ;Subdirectory entry;	   09:	 FF FF FF FF			      ;EndCatalog entry;	   0D:	 36 00 00 00 05	F R U I	T	      ;Subdirectory entry;	   17:	 6E 00 00 00 07	A N I M	A L S	      ;Subdirectory entry;	   23:	 00 00 00 00 0A	V E G E	T A B L	E S   ;File entry;	   32:	 FF FF 00 00			      ;EndSubDir entry (ROOT);	   36:	 50 00 00 00 06	A P P L	E S	      ;Subdirectory entry;	   42:	 6A 00 00 00 05	P E A R	S	      ;Subdirectory entry;	   4C:	 FF FF 0D 00			      ;EndSubDir entry (FRUIT);	   50:	 00 00 00 00 08	C O R T	L A N D	      ;File entry;	   5D:	 00 00 00 00 04	M A C S		      ;File entry;	   66:	 FF FF 36 00			      ;EndSubDir entry (APPLES);	   6A:	 FF FF 42 00			      ;EndSubDir entry (PEARS);	   6E:	 00 00 00 00 04	D O G S		      ;File entry;	   77:	 00 00 00 00 04	C A T S		      ;File entry;	   80:	 FF FF 17 00			      ;EndSubDir entry (ANIMALS);; On entry to the callback routine:;; Y = high word of callback structure; X = low word of callback structure;; Callback structure: +0   word    Count of files so far;		      +4   long	   EOF of only files so far;;===========================================================================================Catalog		PROCNAME		IMPORT	doAlertWindow		IMPORT	saveCursor		IMPORT	arrowCursor		IMPORT	restoreCursor		IMPORT	levelArray		IMPORT	c1_Path;; --- Call Parameters ------------------------------------------;FileCountFlag	equ	10PathNameIn	equ	FileCountFlag+2CallBackAddress equ	PathNameIn+4FSTResult	equ	CallBackAddress+4EOFResult	equ	FSTResult+2LResult		equ	EOFResult+4CResult		equ	LResult+2HResult		equ	CResult+2;; --- Zero Page	Temps -------------------------------------------;catHand		equ	work			;Handle of catalog buffer.catBuffer	equ	catHand+4		;Pointer to catalog buffer.catIndex	equ	catBuffer+4		;Index into catBuffer of next free byte.catError	equ	catIndex+2level		equ	catError+2		;Index into level array.PathLen		equ	level+2FileCount	equ	PathLen+2NumLocked	equ	FileCount+2LockFlag	equ	NumLocked+2CallBackFlag	equ	LockFlag+2TotalCatEOF	equ	CallBackFlag+2CatSize		equ	TotalCatEOF+4		IF	CatSize+4>$FF THEN			WRITE 'CatSize = '			WRITELN CatSize			WRITELN 'WARNING... Direct page variable overflow!'			AERROR 'Catalog in Misc.aii extended its local DP too far'		ENDIF		jsr	setup		stz	CallBackFlag		lda	CallBackAddress+1,s		beq	@noCallBack				lda	CallBackAddress,s	;setup our callback address		sta	CallBack+1		SEP	#$20		LONGA OFF		lda	CallBackAddress+2,s		sta	CallBack+3		REP #$20		LONGA ON		dec	CallBackFlag@noCallBack				stz	<TotalCatEOF		stz	<TotalCatEOF+2				lda	#C1_Path		sta	open_name		lda	#C1_Path>>16		sta	open_name+2; --- Allocate a catalog data area --------------------------------------		_CompactMem			;compact memory		pha				;space for result		pha		_MaxBlock			;get size of largest mem block available		pla		sta	<CatSize		;and save result		pla		beq	NotTooBig		lda	#$FFFF			;we don't want more than 64K		sta	<CatSizeNotTooBig 		sec		lda	<CatSize		sbc	#$0400			;subtract 1K for later		sta	<CatSize		jsr	allocate		bcc	ok1				ldy	#10		jmp	StdEnd			;error exitok1		sta	<catHand		stx	<catHand+2		sta	hresult,s		;Return the handle of the catalog.		txa		sta	hresult+2,s		jsr	flipcatHand		;Lock the catalog buffer.		dey		dey		lda	[<catHand],y		;Dereference handle of catalog buffer.		sta	<catBuffer+2		lda	[<catHand]		sta	<catBuffer; ------ Place the local name in the catalog ---------------------------		lda	#1		sta	<FileCount		stz	<NumLocked		stz	<level				lda	#$FFFF		sta	>levelArray				stz	<catIndex		stz	<ePtr		lda	PathNameIn,s		sta	<dirBuffer		sta	info_path		sta	<ErrNamePtr		;used in case of ProDos error		lda	PathNameIn+2,s		sta	<dirBuffer+2		sta	info_path+2		sta	<ErrNamePtr+2		jsr	NameStuff		jsr	GetFileInfo		bcc	NoGFIErr		brl	DoQuit			;got an errorNoGFIErr 	stz	<LockFlag		lda	info_access		;get access bits		and	#$0080		bne	Enabled			;destroy bit enabled		inc	<NumLocked		;destroy bit disabled		inc	<LockFlagEnabled 		lda	info_storage		cmp	#$0D			;directory file?		beq	SubType			;yes		cmp	#$0F			;volume?		beq	SubType			;yes		lda	info_EOF		sta	<TotalCatEOF		lda	info_EOF+2		sta	<TotalCatEOF+2				lda	info_ResourceEOF		clc		adc	<TotalCatEOF		sta	<TotalCatEOF		lda	info_ResourceEOF+2		adc	<TotalCatEOF+2		sta	<TotalCatEOF+2		jsr	DoCallBack		lda	#0			;no - so it's a regular file		bra	SaveTypeSubType		lda	#$D0SaveType	pha				;save filetype for later		jsr	addFilename		;Add local name to catalog buffer.		jsr	markEnd			;Mark end of directory.		pla				;retrieve filetype		beq	done			;quit if regular file		lda	Open_Name		;set up ptr to correct filename		sta	<ErrNamePtr		;for dialog code to use in case of		lda	Open_Name+2		;ProDos error		sta	<ErrNamePtr+2; --- Build directories	----------------------------------------------------		stz	<level		lda	#0		sta	>levelArraylop2		ldx	<level		lda	>levelArray,x		tay		lda	[<catBuffer],y		cmp	#$FFFE			;Is this a directory file that needs its		bne	next1			;directory read and added to the catalog?; ------ Add a directory to the	catalog	----------------------------------		lda	<catIndex		;Link the index of what will be the		sta	[<catBuffer],y		;new directory to its subdirectory name.		ldx	<level			;Add the new directory to the search		inx				;array for the next.  By not incrementing		inx				;'level' it won't be used yet.		sta	>levelArray,x		jsr	readDir			;Add the directory to the catalog buffer.		bcs	DoQuit			;got an error so quit		inc	<level			;Now increment to search the new directory		inc	<level			;for subdirectories that need to be read.		bra	lop2; ------ Done searching	this directory ----------------------------------next1		cmp	#$FFFF			;End of directory?		bne	next2		dec	<level			;Pop one level.		dec	<level			;Return to search last directory.		bmi	done			;Any more directories to search?; ------ Move to next entry -------------------------------------------next2		ldx	<level			;Move to next directory entry.		lda	>levelArray,x		jsr	nextLine		sta	>levelArray,x		bra	lop2; --- Shrink catalog buffer to only what's needed ------------------------done 		lda	FileCountFlag,s		;store filecount in first cat entry?		beq	DoneCont		;no		ldy	#2		lda	[<catHand],y		;Dereference handle of catalog buffer		sta	<catBuffer+2		;to get back to first catalog entry		lda	[<catHand]		sta	<catBuffer		lda	<FileCount		;get # of files in catalog and store		sta	[<CatBuffer],y		;in flag word of first catalog entryDoneCont 		jsr	flipcatHand		;Unlock catalog handle.		pea	0			;Pass new size (never more then 64k).		pei	<catIndex		;(index to next free byte).		pei	<catHand+2		;Pass handle of catalog buffer.		pei	<catHand		_SetHandleSize		lda	OptionBuffFST		;used for last entry gotten for both getfileinfo and 		sta	FSTResult,s		;also for getdirentry				lda	<TotalCatEOF		sta	EOFResult,s		lda	<TotalCatEOF+2		sta	EOFResult+2,s		lda	<FileCount		sta	cresult,s		;return # of files in catalog		lda	<NumLocked		sta	lresult,s		;return # of locked files in catalog				ldy	#10		jmp	StdEnd			;bye-bye;; --- Got an error -------------------------------------------------------;DoQuit;; JAM 05/18/89 (Fixing BRC #48728); The old code, shown below, appeared to put a useless value into >Error_Code.; The new code puts the value of the x accumulator in there, which, under;   MANY (but perhaps not all) circumstances, carries the error code of the;   last ProDOS operation.  Every routine I've checked so far seems to ignore;   >Error_Code's value, and relies instead only on the carry-set status.;  We should be vigilant to ensure that this is true, and also that routines;   aren't haphazardly clobbering the value of >Error_Code for their own reasons.;; Mensch 06/05/89 (Fixing BRC #50299);  If X does NOT have a proper error code here, make sure that it has at least an;  improper one, since this IS an error exit routine anyway, misleading name aside.		cpx	#0		bne	@1		inx@1; end Mensch 06/05/89 (BRC #50299)		txa		sta	>Error_Code; end JAM 05/18/89 (BRC #48728)		pei	<catHand+2		;Pass handle of catalog buffer.		pei	<catHand		jsl DisposeHandleGlue		;Free catalog buffer; OLD CODE	lda	#1;		sta	>Error_Code		;indicate error				ldy	#10		jmp	StdEnd;; DoCallBack -- call back the address which was passed to us;DoCallBack	lda	<CallBackFlag		beq	noCallBack				lda	<FileCount		sta	CBackStruct				lda	<TotalCatEOF		sta	CBackStruct+4		lda	<TotalCatEOF+2		sta	CBackStruct+6				ldx	#CBackStruct		ldy	#CBackStruct>>16CallBack	jsl	$000000			;self-modified!				noCallBack	rts;; locals -- our callback structure;CBackStruct	dc.L	0		dc.L	0; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Make	copy of	C1_Path, remove local name, etc.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=NameStuff		IMPORT	WStringCopy		PushLong <DirBuffer		PushLong #C1_Path		jsl	WStringCopy		; make copy of pathname				PushLong #C1_Temp		PushLong #C1_Path		jsl	PathGetName		; get local name		lda	>C1_Path		sec		sbc	C1_Temp		dec	a		sta	<PathLen		;save length of (pathname - local name)		lda	C1_Temp		xba				;make it class 0		sta	C1_Temp				lda	#^C1_Temp+1		sta	<DirBuffer+2		;create ptr to local name		lda	#C1_Temp+1		sta	<DirBuffer		rtsC1_Temp		DS.B	34; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Flip	the lock state of the catalog buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=flipcatHand		ldy	#4			;Lock the catalog buffer.		lda	[<catHand],y		eor	#$8000		sta	[<catHand],y		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Move	index to next entry in catalog buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   a = index to	current	line in	'catBuffer'.;;  OUT:	   a = index to	next line in 'catBuffer'.;	   x = same as in.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =nextLine		tay		iny		iny		iny		iny		phy		lda	[<catBuffer],y		; Get length of name.		and	#$00FF			; byte field		sec		adc	1,s		ply		rts; = = =	= = = =	= = = =	= = = =	= = = =	=;	   Read	a subdirectory.; = = =	= = = =	= = = =	= = = =	= = = =	=;;   IN:	   C1_Path = volume name.;; changed for hack, 05/17/88 DJB; = = =	= = = =	= = = =	= = = =	= = = =	=		ENTRY	readDirreadDir 				jsr	BuildPath		;Build the path name.		bcc	pathOK		rtspathOK		jsr	DoOpen			;open the file		bcc	openOK		rtsopenOK		jsr	GetNumEntries		;get the number of entries (in A-reg)		bcc	readOK		brl	ErrExit30		;close the file pleasereadOK		sta	<e_numFiles		;Total number of files.		sta	<entries		clc		adc	<FileCount		;add to current catalog count		sta	<FileCount		jsr	DoCallBack;; --- Move the directory into the catalog buffer ------------------------;		lda	<entries		;are there any entries ?		bne	lop30		brl	exit30			;close the file pleaselop30		jsr	GetEntry		;read a directory entry		bcc	have_entry		cmp	#$61		beq	@endOfDir		brl	ErrExit30				@endOfDir	lda	<FileCount		;if we reach the end of directory prematurely, then		sec				;we need to adjust the FileCount to take into account the		sbc	<entries		;entries in this catalog which we weren't able to read 'cause we		sta	<FileCount		;got stopped		brl	Exit30			;close the file pleasehave_entry	jsr	ce_translate		;convert to old directory entry				lda	ce_file_type		;don't ever count folder sizes		cmp	#$000F		beq	@haveAFolder		lda	ce_eof		clc		adc	<TotalCatEOF		sta	<TotalCatEOF		lda	ce_eof+2		adc	<TotalCatEOF+2		sta	<TotalCatEOF+2				lda	ce_rsrc_eof		clc		adc	<TotalCatEOF		sta	<TotalCatEOF		lda	ce_rsrc_eof+2		adc	<TotalCatEOF+2		sta	<TotalCatEOF+2@haveAFolder		lda	#ce_prodos_entry		sta	<DirBuffer		lda	#^ce_prodos_entry	;pointer to a ProDOS entry		sta	<DirBuffer+2		ldx	#$0020			;defaul type = sapling		lda	ce_file_type		cmp	#$000F			;is this a directory?		bne	not_a_dir		ldx	#$00D0			;this is a directorynot_a_dir		txa				;get the storage type please		ora	ce_prodos_entry		;add in the length		pha				;save file type		stz	<LockFlag		ldy	#DirAccess		lda	[<DirBuffer],y		;get access bits in hi byte		and	#$0080		bne	DestroyOK		;destroy bit enabled		inc	<NumLocked		;destroy bit disabled		inc	<LockFlagDestroyOK		pla				;retrive file type		jsr	addFilename		;Add this filename to the catalog buffer.		bcs	GotMemErr		dec	<entries		bne	lop30;; --- Directory read -----------------------------------------;exit30		lda	open_num		sta	ce_close_num		jsl	ProDOS		DC.W	CLOSE+C1		;close the directory		DC.L	ce_close_list		bcs	GotPDErr2markEnd 	clc		lda	<CatIndex		adc	#4		cmp	<CatSize		;enough room in catalog buffer?		bcs	GotMemErr2		;no		jsr	CatUpdate				clc				;indicate no error		rts;; --- Got directory error -------------------------------------;errExit30	sta	<catError		lda	open_num		sta	ce_close_num		jsl	ProDOS		DC.W	CLOSE+C1		;close the directory		DC.L	ce_close_list		bcs	GotPDErr2		clc		lda	<CatIndex		adc	#4		cmp	<CatSize		;enough room in catalog buffer?		bcs	GotMemErr2		;no		jsr	CatUpdate				ldx	<catError		sec				;indicate error		rts;-------------------------------------------------------------GotMemErr	jsr	DoCloseGotMemErr2	lda	#rasMemErr		jsl	doAlertWindow		sec				;indicate error		rtsGotPDErr	jsr	DoClose			;clean upGotPDErr2	sec				;indicate error		rts;; Mark the end of this directory;CatUpdate	ldy	<catIndex		;Mark end of directory.		lda	#$FFFF		sta	[<catBuffer],y		iny		iny		ldx	<level		lda	>levelarray,x		sta	[<CatBuffer],y		iny		iny		sty	<catIndex		;Index to next free byte in catalog buffer.		rts		; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Add directory name to catalog buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   a = file type.;	   catIndex = index into catalog buffer.;	   catBuffer = address of catalog buffer.;	   ePtr	= index	into directory buffer.;	   dirBuffer = address of directory buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =maxFileSize	SET	32		ENTRY	addFilenameaddFilename		tax				;save contents of A		clc		lda	<CatIndex		adc	#maxFileSize+4		cmp	<CatSize		;enough room in catalog buffer?		bcc	GotRoom2		;yes		rts				;no - return with carry setGotRoom2		txa				;retrieve contents of A		ldx	#$FFFE			;Mark for directory file.		and	#$00F0		cmp	#$00D0		beq	store40		ldx	#0			;Mark for standard file.store40		txa		ldy	<catIndex		sta	[<catBuffer],y		iny		iny		lda	<LockFlag		sta	[<CatBuffer],y		;save locked status in flag word		tya		clc		adc	#maxFileSize		tay		lda	<ePtr		clc		adc	#maxFileSize-2		taxlop40		phy		txy		lda	[<dirBuffer],y		ply		sta	[<catBuffer],y		dey		dey		dex		dex		bmi	exit40		cpx	<ePtr		bcs	lop40exit40		and	#$00FF			; length (byte)		sec		adc	<catIndex		inc	a		inc	a		inc	a		inc	a		sta	<catIndex*		iny				;Backup to the length byte.*		iny*		lda	[<catBuffer],y*		and	#$FF0F			;Clear the flag nibble from the length.*		sta	[<catBuffer],y		clc				;indicate no error		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Build pathname from levelArray buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   levelArray =	array of index offset into 'catBuffer'.;	   level = index of last offset	in levelArray.;;  OUT:	   C1_Path = full pathname.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =		ENTRY	BuildPathBuildPath		lda	<PathLen		sta	>C1_Path		;reset pathname length		ldx	#0lop50		lda	>levelArray,x		phx				;Save index into levelArray.		tay		jsr	addName			;Add name from catalog to pathname.		plx		bcs	BPRet		inx		inx		cpx	<level		bcc	lop50		beq	lop50		clc				;indicate no errorBPRet		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Add a name on the end of pathname.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   C1_Path = current pathname.;	   y = index to	entry in 'catBuffer'.;	   catBuffer = catalog buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =		ENTRY	addNameaddName		lda	>C1_Path		;Get current length.		tax		inx				sep	#$20		LONGA	OFF		lda	#SEPARATOR		;add GS/OS separator character		sta	>C1_Path+1,x				rep	#$20		LONGA	ON				iny		iny		iny		iny		lda	[<catBuffer],y		and	#$00ff		sec				;always one more		adc	>c1_path		cmp	#MaxPathLen		bcs	TooLong		sta	>C1_Path		;New length of pathname.		sta	lentemp			sep	#$20		LONGA	OFF		@loop		iny		inx		lda	[<catBuffer],y		sta	>C1_Path+1,x		cpx	lentemp		bcc	@loop		rep	#$20		LONGA	ON		clc				;indicate no error		rtsTooLong		lda	#rasPathTooLong		jsl	doAlertWindow		sec				rts;; locals;lentemp		dc.w	0		ENDP;====================================================;	 Get File Info;====================================================GetFileInfo	PROC		jsl	ProDOS		DC.W	GET_FILE_INFO+C1	;command #		DC.L	info_list		bcc	exit		cmp	#$4F			; ignore buffer too small		beq	ok		jsr	ProDosErr		bcc	GetFileInfo		;try again		bra	exitok		clcexit		rts				; return carry flag		ENDP;====================================================;	 Open File;====================================================DoOpen		PROC		jsl	ProDOS		DC.W	OPEN+C1			;command #		DC.L	open_List		bcc	OK		jsr	ProDosErr		bcc	DoOpen			;try againOK		rts		ENDP;====================================================;	 Close File;====================================================DoClose		PROC		lda	open_num		sta	close_num				jsl	ProDOS		DC.W	CLOSE+C1		;command #		DC.L	close_list		bcc	OK		jsr	ProDosErr		bcc	DoClose			;try againOK		rts		ENDP;====================================================;	 Read Directory Entry		;====================================================GetEntry	PROC		jsl	ProDOS			;do a get dir entry call		DC.W	GET_DIR_ENTRY+C1		DC.L	ce_get_dir_list		;get the number of entries		bcc	@ok		tax		cmp	#$61		beq	@exit		cmp	#$4F		bne	@err		clc		rts		@err		jsr	ProDosErr		bcc	GetEntry		;try again@exit		sec@ok		rts		ENTRY	GetNumEntriesGetNumEntries	lda	open_num		sta	ce_get_dir_num		;set ref number				stz	ce_disp			;we want an entry count		stz	ce_base				jsl	ProDOS			;do a get dir entry call		DC.W	GET_DIR_ENTRY+C1		DC.L	ce_get_dir_list		;get the number of entries		bcc	@ok		cmp	#$4F		bne	@err2		clc		bra	@ok		@err2		jsr	ProDosErr		bcc	GetNumEntries		;try again@ok		lda	#$0001			;setup for catalog		sta	ce_base		sta	ce_disp				lda	ce_entry_num		;get the total file count				rts				;return carry flag		ENDP;====================================================;	 Handle	ProDos Error;====================================================ProDosErr	PROC		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	arrowCursor		IMPORT	hexadecimal		IMPORT	pathGetRoot		import	GetErrorTextPtr				sta	err				cmp	#$27			;I/O error?		beq	IOErr			;yes		cmp	#$5A			;damaged bitmap?		beq	IOErr			;yes		cmp	#$63			;file doesn't contain required resource		beq	IOErr			;yes		cmp	#$51			;directory error?		beq	IOErr			;yes		cmp	#$2F			;no media error?		beq	NoMedia			;yes		cmp	#$45			;volume	not found error?		beq	NoVol			;yes		cmp	#$4E			;access	error?		beq	AccessErr		;yes		cmp	#FINoPrivs		beq	NoPrivs;; Note--rasSysErr uses substitution *7 for the hex value, so the table;       below is kludged (11-Jul-91 DAL);		pha				;push copy of error code (5-Dec-91 DAL)		pha		pushlong #hexadecimal		pea	4			;4 chars		_Int2Hex*** added 5-Dec-91 DAL		pla		jsl GetErrorTextPtr		;returns pointer in AX		sta >sub9Ptr+2		txa		sta >sub9Ptr*** end 5-Dec-91		lda	#rasSysErr		;generic error msg		bra	ContIOErr		lda	#rasIOErr		bra	ContNoMedia		lda	#rasNoMedia		bra	ContNoVol		lda	#rasInsertDiskOrCancel		bra	ContAccessErr	tax		sec		rtsNoPrivs		lda	#rasNoPrivsCont		pha				pushlong #errName		pushZLong <errNamePtr		jsl	PathGetRoot				lda	errName		dec	a		xba		sta	errName+1				jsl	saveCursor		;make it a normal cursor		jsl	arrowCursor		lda	1,s			;it's already on the stack, and we						;needed to push a word anyway...		pea	$00B5			;refIs (Preloaded) Resource		pushlong #errorStrPtr		;substitution string #1		pea	0		pha		_AlertWindow		jsl	restoreCursor				ldx	err		cpx	#$45		bne	@noChoice@volErr		pla		beq	@cancel		clc		rts		@noChoice	pla@cancel		sec		rtserr		dc.w	0errPath		dc.L	0errName		ds.b	34errorStrPtr	dc.L	errName+2	;*0 -- pointer to thing we'll use in error string		dc.l	0		;*1		dc.l	0		;*2		dc.l	0		;*3		dc.l	0		;*4		dc.l	0		;*5		dc.l	0		;*6		dc.l	hexadecimal-1	;*7		dc.l	errName+2	;*8 -- pointer to thing we'll use in error stringsub9ptr		dc.l	0		;*9 -- for rasSysErr (5-Dec-91 DAL)		ENDP;====================================================;	   Allocate a memory block.;====================================================;;   IN:	   a = number of bytes to allocate.;;  OUT:	   a = low word	of handle.;	   x = high word of handle.;====================================================allocate	PROC		ldx	#0			;Anyting, anywhere attributes.;====================================================;   IN:	   x = attributes.;====================================================		ENTRY	allocate2allocate2		pha				;Space for result.		pha		pea	0			;Pass size of block needed.		pha		pei	<MyID		phx				;Pass attributes.		pha				;Pass address, not used.		pha		_NewHandle		sta	error_code		;Just in case.		pla		plx		rts		ENDP		;=========================================;	   Push	a direct page;	   address on the stack.;=========================================;;   IN:	   a = direct page offset.;;=========================================pushyrat	PROC*		using DiaData*		using ZP_Two		lda	#yrat		bra	pushzpage		ENTRY	pushTaskpushTask      		lda	#TaskRec		ENTRY	pushzpagepushzpage      		plx		pea	0		pha		tdc		clc		adc	1,s		sta	1,s		phx		rts				ENDP		END