.W	midPrivate		; initial value		ENTRY	CheckBox1CheckBox1	DC.W	10			; PCount	;added keys 8-Apr-91 DAL		DC.L	idLocked		; Control ID		DC.W	eY1-1,cX2-40,eY2-1,cX2-sp		DC.L	checkControl		DC.W	ctlInVis		; flag		DC.W	fCtlProcRefNotPtr+fCtlWantEvents	; more flags		DC.L	0			; RefCon		DC.L	nullStrg		; title ptr		DC.W	0			; initial value		dc.l	0			; color table		dc.b	$4C,$6C			; key equivalents (L)		dc.w	0,0			; modifiers		ENTRY	CheckBox2CheckBox2	DC.W	10			; PCount	;added keys 8-Apr-91 DAL		DC.L	idInactive		; Control ID		DC.W	eY3-3,cX2-40,eY4-3,cX2-sp		DC.L	checkControl		DC.W	ctlInVis		; flag		DC.W	fCtlProcRefNotPtr+fCtlWantEvents	; more flags		DC.L	0			; RefCon		DC.L	nullStrg		; title ptr		DC.W	0			; initial value		dc.l	0			; color table		dc.b	$49,$69			; key equivalents (i)		dc.w	0,0			; modifiersIconColorTbl	DC.W	$00F0,$00F0,$00F0,$00F0,$00F0		ENTRY	CalcIconButtonCalcIconButton	DC.W	11			; PCount (was 10 28-Apr-92 DAL)		DC.L	idCalculate		; Control ID		DC.W	cY2-29,cX2-56,cY2-4,cX2-10		DC.L	iconButtonControl		DC.B	ctlInVis+2+4		; flag		DC.B	0			; hilite		DC.W	fCtlProcRefNotPtr+fCtlWantEvents	; more flags		DC.L	0			; RefCon		DC.L	CalculateIcon		; icon ref		DC.L	0			; title ref		DC.L	0			; color table ref		DC.W	0			; display mode		dc.b	$4B,$6B		dc.w	$0100,$0100		; key equiv (Command-K) 28-Apr-92 DAL		ENTRY	IconButtonIconButton	DC.W	10			; PCount		DC.L	idIconButton		; Control ID		DC.W	cY1+8,cX1+21,cY1+35,cX1+93		DC.L	iconButtonControl		DC.B	ctlInVis+4+8		; flag not selectable		DC.B	0			; hilite		DC.W	fCtlProcRefNotPtr+$10 	; more flags (RefIsHandle)		DC.L	0			; RefCon		DC.L	0			; icon ref		DC.L	0			; title ref		DC.L	IconColorTbl		; color table ref		DC.W	0			; display mode		ENTRY	LineText1LineText1	DC.W	8			; PCount		DC.L	idLineStr1		; Control ID		DC.W	eY4-6,cX1+10,eY4+3,cX2-10	; control rect		DC.L	statTextControl		; proc ref		DC.B	ctlInVis		; flag		DC.B	inactiveHilite		; hilite		DC.W	fCtlProcRefNotPtr	; more flags		DC.L	0			; RefCon		DC.L	LineStr+1		; title ptr		DC.W	EndLineStr-LineStr-1		ENTRY	LineText2LineText2	DC.W	8			; PCount		DC.L	idLineStr2		; Control ID		DC.W	bY1-10,cX1+10,bY1-1,cX2-10	; control rect		DC.L	statTextControl		; proc ref		DC.B	ctlInVis		; flag		DC.B	inactiveHilite		; hilite		DC.W	fCtlProcRefNotPtr	; more flags		DC.L	0			; RefCon		DC.L	LineStr+1		; title ptr		DC.W	EndLineStr-LineStr-1		ENTRY	CommonControlsCommonControls	DC.L	IconButton		; controls common to all cards		DC.L	NameField		DC.L	RealNameField		;version information		DC.L	KindText		DC.L	KindField		DC.L	CopyrightField		DC.L	SizeText		DC.L	SizeField		DC.L	ContentText		DC.L	ContentField		DC.L	CreateText		DC.L	CreateField		DC.L	ModifyText		DC.L	ModifyField		DC.L	TrashField		DC.L	DriveField		DC.L	CalcIconButton		DC.L	PathText		DC.L	PathField		DC.L	DeviceText		DC.L	DeviceField		DC.L	ServerText		DC.L	ServerField		DC.L	ZoneText		DC.L	ZoneField		DC.L	InfoCard		; this one must be last!		DC.L	0		ENTRY	LockControlsLockControls	DC.L	CheckBox2		DC.L	LockedText		DC.L	CheckBox1		DC.L	InactiveText		DC.L	0				ENTRY	NetworkControlsNetworkControls	DC.L	OwnerText		; controls used for network (access)		DC.L	OwnerField		DC.L	GroupText		DC.L	GroupField		DC.L	PrivilegeText		DC.L	PrivilegeField		DC.L	LineText1		; this "line" must be last !		DC.L	0		ENTRY	OwnerControlsOwnerControls	DC.L	ApplyButton		; controls used for owner (access)		DC.L	AllButton		DC.L	OwnerEditLine		DC.L	OwnerText		DC.L	GroupEditLine		DC.L	GroupText		DC.L	PopUp1		DC.L	PopUp2		DC.L	PopUp3		DC.L	PopUp4		DC.L	LineText1		; these "lines" must be last !		DC.L	LineText2		; so they don't overlap other controls		DC.L	0;		; Mappings for class pop-up		;		ENTRY	SettingsSettings	DC.W	midOwner,midOwner,midOwner		; private (2)		DC.W	midEveryone,midEveryone,midEveryone	; public (3)		DC.W	midOwner,midOwner,midEveryone		; drop box (4)		DC.W	midEveryone,midEveryone,midOwner	; bulletin board (5)				ENTRY	IDsIDs		DC.W	idSeeFolders,idSeeFiles,idMakeChanges,idClass				ENTRY	CalculateIconCalculateIcon	DC.W	$8000			; icon's type		DC.W	6*15			; icon's size		DC.W	15			; icon's height		DC.W	6*2			; icon's width		DC.B	$00,$00,$00,$00,$00,$00	; ееееееееееее icon's image		DC.B	$0F,$FF,$FF,$FF,$FF,$F0	; е          е		DC.B	$0F,$00,$00,$00,$00,$F0	; е ееееееее╩е		DC.B	$0F,$0E,$EE,$EE,$E0,$F0	; е е      е╩е		DC.B	$0F,$00,$00,$00,$00,$F0	; е ееееееее е		DC.B	$0F,$FF,$FF,$FF,$FF,$F0	; е          е		DC.B	$0F,$00,$F0,$0F,$44,$F0	; е ее ее ее е		DC.B	$0F,$FF,$FF,$FF,$FF,$F0	; е         ╩е		DC.B	$0F,$00,$F0,$0F,$00,$F0 ; е ее ее ее е		DC.B	$0F,$FF,$FF,$FF,$FF,$F0	; е         ╩е		DC.B	$0F,$00,$F0,$0F,$00,$F0 ; е ее ее ее е		DC.B	$0F,$FF,$FF,$FF,$FF,$F0	; е         ╩е		DC.B	$0F,$00,$F0,$0F,$00,$F0 ; е ее ее ее е		DC.B	$0F,$FF,$FF,$FF,$FF,$F0	; е         ╩е		DC.B	$00,$00,$00,$00,$00,$00	; ееееееееееее		DC.B	$FF,$FF,$FF,$FF,$FF,$FF	; icon's mask		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		DC.B	$FF,$FF,$FF,$FF,$FF,$FF		ENDP*===============================================**						** Dynamically calculate text rects from strings **						**===============================================*CalculateRects	PROC		IMPORT	InfoWinParam:ParamList				IMPORT	RealNameField:StatTextTemplate		IMPORT	CopyrightField:StatTextTemplate		IMPORT	KindText:StatTextTemplate		IMPORT	SizeText:StatTextTemplate		IMPORT	ContentText:StatTextTemplate		IMPORT	CreateText:StatTextTemplate		IMPORT	ModifyText:StatTextTemplate		IMPORT	KindField:StatTextTemplate		IMPORT	SizeField:StatTextTemplate		IMPORT	ContentField:StatTextTemplate		IMPORT	CreateField:StatTextTemplate		IMPORT	ModifyField:StatTextTemplate		IMPORT	NameField:StatTextTemplate				IMPORT	PathText:StatTextTemplate		IMPORT	DeviceText:StatTextTemplate		IMPORT	ServerText:StatTextTemplate		IMPORT	ZoneText:StatTextTemplate		IMPORT	PathField:StatTextTemplate		IMPORT	DeviceField:StatTextTemplate		IMPORT	ServerField:StatTextTemplate		IMPORT	ZoneField:StatTextTemplate		IMPORT	InactiveText:StatTextTemplate		IMPORT	LockedText:StatTextTemplate		IMPORT	OwnerText:StatTextTemplate		IMPORT	GroupText:StatTextTemplate		IMPORT	OwnerField:StatTextTemplate		IMPORT	GroupField:StatTextTemplate				IMPORT	OwnerEditLine:LineEditTemplate		IMPORT	GroupEditLine:LineEditTemplate				IMPORT	PrivilegeText:StatTextTemplate		IMPORT	PrivilegeField:StatTextTemplate		IMPORT	infoWindCount				IMPORT	strOwner			; in string segment		IMPORT	strGroup		IMPORT	strLocked		IMPORT	strInactive		IMPORT	strKind		IMPORT	strSize		IMPORT	strContents		IMPORT	strVersion		IMPORT	strCreated		IMPORT	strModified		IMPORT	strPath		IMPORT	strDevice		IMPORT	strServer		IMPORT	strZone				lda	>infoWindCount		inc	a		sta	>infoWindCount				dec	a		tax		lsr	a				;divide # of windows by 8		lsr	a		lsr	a		pha		txa		and	#7		clc		adc	1,s		plx		inc	a				asl	a		asl	a		asl	a				;times 8 pixels		tax		clc		adc	#infoY1		sta	InfoWinParam.wPosition.top		txa		clc		adc	#infoY2		sta	InfoWinParam.wPosition.bottom		lda	>InfoWindCount			dec	a		and	#7		inc	a		asl	a		asl	a		asl	a		asl	a				;times 16 pixels		tax		clc		adc	#infoX1		sta	InfoWinParam.wPosition.left		txa		clc		adc	#infoX2		sta	InfoWinParam.wPosition.right		lda	KindText.Rect+x1	; are static text templates done ?		beq	initRects		brl	exit			; yes, so we're done;--- 1st set up edit line title rects ----------initRects	stz	Width		pha		PushLong #strOwner		_StringWidth		PullWord Width1		sta	Width				pha		PushLong #strGroup		_StringWidth		PullWord Width2		cmp	Width		bcc	cont2		sta	Width		cont2		lda	Width		clc		adc	#cX1+sp			; right side + space		tax				; x <-- end of title text		adc	#16		sta	OwnerField.Rect+x1		sta	GroupField.Rect+x1		stx	OwnerText.Rect+x2		stx	GroupText.Rect+x2				txa		sec		sbc	Width1		sta	OwnerText.Rect+x1		txa		sbc	Width2		sta	GroupText.Rect+x1		txa		clc		adc	#10		sta	OwnerEditLine.Rect+x1		sta	GroupEditLine.Rect+x1		adc	#292		sta	OwnerEditLine.Rect+x2		sta	GroupEditLine.Rect+x2;----  part 2  ------------------------------		stz	Width		pha		PushLong #String1		_StringWidth		PullWord Width1		sta	Width				pha		PushLong #String2		_StringWidth		PullWord Width2		cmp	Width		bcc	cont3		sta	Width		cont3		pha		PushLong #String3		_StringWidth		PullWord Width3		cmp	Width		bcc	cont4		sta	Width		cont4		lda	Width		clc		adc	#cX1+pX			; right side + offset		sta	column			; left justify column		sec		sbc	Width1		sta	PopRect1+x1		lda	Column		sec		sbc	Width2		sta	PopRect2+x1		lda	Column		sec		sbc	Width3		sta	PopRect3+x1;--- now set rects for 'Locked' and 'Inactive';; we calculate these rects since they belong; to a checkbox. Clicking inside these rects; will set the checkbox.		pha		PushLong #strLocked		_StringWidth		lda	#cX2-48		sec		sbc	1,s		sta	LockedText.Rect+x1		dec	a		dec	a		dec	a		dec	a		sta	NameField.Rect+x2	; clip name field so they won't clash !		PushLong #strInactive		_StringWidth		lda	#cX2-48		sec		sbc	1,s		sta	InactiveText.Rect+x1		pla;--- now set rects for General card text --------;; we calculate these rects so they will be; as close to the left side as possible, ; even after being localized.		pha		PushLong #strKind		_StringWidth		PullWord Width1		sta	Width			; width has maximum string width		pha		PushLong #strSize		_StringWidth		PullWord Width2		cmp	Width		bcc	cont5		sta	Widthcont5		pha		PushLong #strContents		_StringWidth		PullWord Width3		cmp	Width		bcc	cont6		sta	Widthcont6		pha		PushLong #strCreated		_StringWidth		PullWord Width4		cmp	Width		bcc	cont7		sta	Widthcont7		pha		PushLong #strModified		_StringWidth		PullWord Width5		cmp	Width		bcc	cont8		sta	Widthcont8		lda	#cX1+sp			; start of longest text title		clc		adc	Width		tax				; x <-- end of text titles		adc	#16		tay				; y <-- start of text fields				stx	KindText.Rect+x2		stx	SizeText.Rect+x2		stx	ContentText.Rect+x2		stx	CreateText.Rect+x2		stx	ModifyText.Rect+x2		sty	RealNameField.Rect+x1		sty	KindField.Rect+x1		sty	SizeField.Rect+x1		sty	CopyrightField.Rect+x1		sty	ContentField.Rect+x1		sty	CreateField.Rect+x1		sty	ModifyField.Rect+x1		sty	NameField.Rect+x1		txa				; set start of text titles		sec		sbc	Width1		sta	KindText.Rect+x1		txa		sbc	Width2		sta	SizeText.Rect+x1		txa		sbc	Width3		sta	ContentText.Rect+x1		txa		sbc	Width4		sta	CreateText.Rect+x1		txa		sbc	Width5		sta	ModifyText.Rect+x1;--- now set rects for Where card text --------		pha		PushLong #strPath		_StringWidth		PullWord Width1		sta	Width		pha		PushLong #strDevice		_StringWidth		PullWord Width2		cmp	Width		bcc	cont9_2		sta	Widthcont9_2		pha		PushLong #strServer		_StringWidth		PullWord Width3		cmp	Width		bcc	cont10		sta	Widthcont10		pha		PushLong #strZone		_StringWidth		PullWord Width4		cmp	Width		bcc	cont11		sta	Widthcont11		lda	#cX1+sp			; start of longest text title		clc		adc	Width		tax				; x <-- end of text titles		adc	#16		tay				; y <-- start of text fields		stx	PathText.Rect+x2		stx	DeviceText.Rect+x2		stx	ServerText.Rect+x2		stx	ZoneText.Rect+x2		sty	PathField.Rect+x1		sty	DeviceField.Rect+x1		sty	ServerField.Rect+x1		sty	ZoneField.Rect+x1		txa		sec		sbc	Width1		sta	PathText.Rect+x1		txa		sbc	Width2		sta	DeviceText.Rect+x1		txa		sbc	Width3		sta	ServerText.Rect+x1		txa		sbc	Width4		sta	ZoneText.Rect+x1;--- now set rects for Access card text --------		pha				; space for width		PushLong #strPrivileges		_StringWidth		pla		clc		adc	#cX1+sp		sta	PrivilegeText.Rect+x2		adc	#16		sta	PrivilegeField.Rect+x1exit		rtsColumn		DC.W	0Width		DC.W	0		Width1		DC.W	0		Width2		DC.W	0		Width3		DC.W	0		Width4		DC.W	0		Width5		DC.W	0		STRING	PASCALString1		DC.B	'See Folders:'String2		DC.B	'See Files:'String3		DC.B	'Make Changes:'		ENDP		*===============================================**	Draw Contents of an Info Window		**	(Called by Window Manager)		**						** IN:	none					** OUT:	none					**===============================================*DrawInfoWindow	PROCNAME		IMPORT	InfoWinParam:ParamList		IMPORT	TempRect:Rect		phb		phk		plb		PushWord #4		PushWord #tH+2		_SetPenSize				PushLong #Pattern3		_SetPenPat				lda	#-(tH)		sta	TempRect.top		lda	InfoWinParam.wPosition.bottom		sec		sbc	InfoWinParam.wPosition.top		sta	TempRect.bottom		lda	InfoWinParam.wPosition.right		sec		sbc	InfoWinParam.wPosition.left		sta	TempRect.right		PushLong #TempRect		_FrameRect			PushLong #BlackPattern		_SetPenPat		pha		pha		_GetPort		_DrawControls		plb		rtl		ENDP*===============================================**	    Add New Text to a Control		**						** IN:	control's ID (a-reg)			**	InfoBlock offset (y-reg)		**	infoBlkPtr (direct page)		**	infoWinPtr (direct page)		**						** OUT:	none					**===============================================*NewTextField	PROC		phy				; save offset		tax				; save id				pha				; space for handle		pha		PushZLong <infoWinPtr		PushWord #0			; ID (hi word)		phx				; ID (lo word)		_GetCtlHandleFromID		PullLong theHandle				lda	1,s			; get offset to text		tay		lda	[<infoBlkPtr],y		pha				; new text size		PushLong theHandle		_SetCtlValue		ldx	<InfoBlkPtr+2		pla				; get offset to text		inc	a			; skip over size word		inc	a		clc		adc	<InfoBlkPtr		bcc	ok		inxok		phx				; ptr to new text		pha		PushLong theHandle		_SetCtlTitle				rts				ENDP*===============================================** Update an INFO window's info block based on	** the data in the IconObject record.		**						** IN:	infoWinPtr, iconObjPtr & infoBlkPtr	**	iconPathPtr (a,x-reg)			**						** OUT:	none					**===============================================*UpdateInfoBlk	PROC				IMPORT	SetInfoTitle		IMPORT	SetInfoDates		IMPORT	SetInfoAccess		IMPORT	SetInfoSize		IMPORT	SetInfoContent		IMPORT	SetInfoKind		IMPORT	SetInfoWhere		IMPORT	SetInfoDevice		IMPORT	SetInfoComment		jsr	SetInfoWhere		; update path field (uses x,a-reg)		jsr	SetInfoTitle		; update window's title		jsr	SetInfoDates		; update date fields		jsr	SetInfoAccess		; update access priv. names		jsr	SetInfoSize		; update size field		jsr	SetInfoContent		; update content field		jsr	SetInfoKind		; update kind field		jsr	SetInfoComment		; update comment field;--- update lock control		lda	IconType		and	#itTrash		beq	@ok		brl	exit@ok			lda	IconType		;do allow locking local volumes		and	#itVolume		beq	@notVolume		lda	IconType		;no, do not allow locking network volumes		and	#itNetwork		beq	@notServer		rts	@goExit		brl	exit@notServer	ldy	#IconObject.devNum	;fill in the device number		lda	[<iconObjPtr],y		sta	GetLockParms+2		sta	GetLockDevice+2		_DInfoGS GetLockDevice		bcs	@goExit				lda	GetLockDevice+$14	;is it a hard disk?		cmp	#5		bne	@goExit				stz	GetControlList				_DStatusGS GetLockParms		;then again, if it doesn't support this call,		bcs	@goExit			;then screw 'em...				lda	GetControlList		and	#$0020		eor	#$0020			;flip just that bit		beq	setLock		lda	#1		bra	setLock		@notVolume	ldy	#IconObject.flag	; get icon's locked bit		lda	[<iconObjPtr],y		and	#icLocked		beq	setLock		lda	#1setLock		pha				; new value		pha				; space for handle		pha		PushZLong <infoWinPtr		PushLong #idLocked		; control's ID		_GetCtlHandleFromID		_SetCtlValue			; set control's value		;--- update inactive control				lda	IconType		and	#itDriver		beq	exit				ldy	#IconObject.fileInfo	; get icon's inactive bit		lda	[<iconObjPtr],y		and	#$8000		beq	setIt		lda	#1setIt		pha				; new value		pha				; space for handle		pha		PushZLong <infoWinPtr		PushLong #idInactive		; control's ID		_GetCtlHandleFromID		_SetCtlValue			; set contol's valueexit		rts		ENDP		*===============================================**	    Update an INFO window		**						** INPUT:	--- On the Stack ---		**		iconObjPtr (Long)		**		iconPathPtr (Long)		**		retAddr (3 bytes)		**	SP--->					**						** OUTPUT:	--- On the Stack ---		*	*		retAddr (3 bytes)		**	 SP--->					**						** Does not change direct page or use any Global	** variables.					**===============================================*_UpdateInfoWin	PROC	EXPORT		DSECT	workSpaceretAddr		block	3	iconPathPtr	longiconObjHand	longparmSize	SET	8		IMPORT	HandleToPointer		IMPORT	UnLockHandle		IMPORT	GetIconType*===============================================*					sec		tsc				; get work space		sbc	#workSize		tcs				phb		phk		plb		phd		tcd				; set DP to stack		pha		pha		PushZLong <iconObjHand		; convert handle to pointer		jsl	HandleToPointer		PullLong <iconObjPtr		jsr	GetIconType				pha				; space for pointer		pha		PushLong [<iconObjPtr],IconObject.infoWin		_GetWRefCon		PullLong <infoBlkPtr				ldy	#IconObject.infoWin		lda	[<iconObjPtr],y		sta	<infoWinPtr		iny		iny		lda	[<iconObjPtr],y		sta	<infoWinPtr+2				lda	<iconPathPtr		ldx	<iconPathPtr+2		jsr	UpdateInfoBlk				PushZLong <iconObjHand		jsl	UnLockHandle		pld		plb				lda	retAddr+1,s		sta	retAddr+ParmSize+1,s		lda	retAddr,s		;clean up stack		sta	retAddr+parmSize,s		tsa		clc		adc	#parmSize+workSize		tas		rtl				ENDP		*===============================================**	    Create a new INFO window		**						** INPUT:	--- On the Stack ---		**		iconObjHand (Long)		**		iconPathPtr (Long)		**		retAddr (3 bytes)		**	SP--->					**						** OUTPUT:	--- On the Stack ---		*	*		retAddr (3 bytes)		**	 SP--->					** Carry Flag set if error in creating window	** Does not change direct page or use any Global	** variables.					**===============================================*NewInfoWindow	PROC	EXPORT		DSECT	workSpaceretAddr		block	3	iconPathPtr	longiconObjHand	longparmSize	SET	8		IMPORT	PathSubName		IMPORT	GetPrivileges		IMPORT	PStringCat		IMPORT	PStringCopy		IMPORT	getFileInfo		IMPORT	doAlertWindow		IMPORT	C1_path		IMPORT	arrowCursor		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	insertItemRef		IMPORT	wind_ref		IMPORT	UnLockHandle		IMPORT	HandleToPointer		IMPORT	NewHandle		IMPORT	InfoWinParam:ParamList		IMPORT	InfoCard:CardTemplate		IMPORT	GetIconType		IMPORT	addWindow2Menu		IMPORT	PathGetRoot		IMPORT	AddBundle2Desktop		IMPORT	WStringCopy		IMPORT	PathAddName		IMPORT	BootFST		IMPORT	IconsName		IMPORT	DesktopName		IMPORT	c1_bootname		IMPORT	IconHandleArray		IMPORT	IconOffsetArray		IMPORT	IsReadOnly		IMPORT	CloseThisWindow		;in Util.aii - 27-Jan-93 JCM		IMPORT	SCSIPriority		IMPORT	RealNameField:StatTextTemplate	;24-Mar-93 JCM		*===============================================*				sec		tsc				; get work space		sbc	#workSize		tcs		phb		phk		plb		phd		tcd				; set DP to stack		lda	#$FFFF		sta	SCSIPriority		;17-Feb-93 JCM - illegal SCSI priority (must be 0-7)		sta	useLockControls		;; Mensch 5/12/89 (fixing BRC #48929); Preload the icon button to avoid UGLY control manager error message; if the resource is not on line.;;; This code can be called before bringing up any window that uses an Icon Button; It will return with the carry SET if no icon button can be loaded and CLEAR; if Icon button code can be loaded.;@tryAgain			pha		pha		PushZLong <iconObjHand		jsl	HandleToPointer		PullLong <iconObjPtr				jsr	GetIconType		jsr	CalculateRects				pha		pha		lda	#infoBlock.windText.path		clc		adc	[<iconPathPtr]		clc		adc	#8+2			;used to be +8, and 2 extra for length word		pha		jsl	NewHandle		;simply ask to get the same number of						;bytes as our source handle		;--- added check for NewHandle failure DJB 06/08/89		pla				; get handle, check for zero		plx		bcs	@exit			; memory allocation error !!		bne	ok		cmp	#0		bne	ok@exit		brl     bogus			; zero ... forget about icon info, babe;-----------------------------------------------ok		pha				; space for pointer		pha		phx				; handle MSW		stx	infoHandle+2		pha				; handle LSW		sta	infoHandle		jsl	HandleToPointer		pla		sta	InfoWinParam.wRefCon	; refCon = window's info block		sta	<infoBlkPtr		pla		sta	InfoWinParam.wRefCon+2		sta	<infoBlkPtr+2		lda	<iconObjHand		; remember handle of icon		ldy	#InfoBlock.windIcons		sta	[<infoBlkPtr],y		ldy	#InfoBlock.windIc		sta	[<infoBlkPtr],y				lda	<iconObjHand+2		ldy	#InfoBlock.windIcons+2		sta	[<infoBlkPtr],y		ldy	#InfoBlock.windIc+2		sta	[<infoBlkPtr],y		lda	#InfoWindID		; set window's ID (for closing)		ldy	#InfoBlock.windID		sta	[<InfoBlkPtr],y				ldy	#infoBlock.windMenuItem ;zero out the menu item (not in menu yet)		lda	#0		sta	[<infoBlkPtr],y		jsr	MoveIconToHandle				pha				; space for handle		pha		PushLong #InfoWinParam		_NewWindow			; create window		PullLong <infoWinPtr		bcc	@newWindowOK				lda	<InfoWinPtr+1		;did we make a window?		beq	@noClose		;if no, then nothing to close			lda	<InfoWinPtr		ldx	<InfoWinPtr+2		jsl	CloseThisWindow		@noClose	pushlong infoHandle		jsl DisposeHandleGlue				pushlong iconButton+$1a		jsl DisposeHandleGlue		brl	bogus		@newWindowOK			;---- Set up General card ----		ldy	#IconObject.fileType		lda	 [<iconObjPtr],y		cmp	#$FFF9			; is icon a 5.25 floppy drive?		beq	is525Drive		lda	IconType		; is icon a volume ?		and	#itVolume		bne	isVolume		lda	IconType		; is icon a folder ?		and	#itFolder		bne	isFolder		lda	IconType		; is icon a driver ?		and	#itDriver		bne	isDriver		lda	IconType		; is icon the Trash ?		and	#itTrash		bne	isTrash		lda	#GeneralCard		bra	setGeneralisTrash		lda	#TrashGenCard		bra	setGeneral		isDriver	lda	#DrvGeneralCard		bra	setGeneral		isFolder	lda	#FoldGeneralCard		bra	setGeneral;; it's a volume, so see if we can make dcontrol calls to this partition, and if we can, use; a different card with a lock icon on it;isVolume	ldy	#IconObject.devNum		lda	[<iconObjPtr],y		sta	GetLockParms+2		sta	GetLockDevice+2*** Added - 17-Feb-93 JCM - Let's attempt to get the SCSI ID of this device. If we get an error, we***			    just won't show the ID at all on the card.				sta	GetSCSITargetPriority+2	;17-Feb-93 JCM		_DStatusGS GetSCSITargetPriority ;try to get the SCSI ID*** End - 17-Feb-93 JCM		_DInfoGS GetLockDevice		bcs	@oldVolumeCard				lda	GetLockDevice+$14		cmp	#5		bne	@oldVolumeCard		stz	GetControlList				_DStatusGS GetLockParms	;see if we can get the control parms		bcs	@oldVolumeCard				lda	#NewVolumeCard		bra	setGeneral@oldVolumeCard	lda	#VolGeneralCard		bra	setGeneralis525Drive	lda	#DriveGenCardsetGeneral	ldy	#InfoBlock.cardTable+0		sta	[<InfoBlkPtr],y		iny		iny		lda	#GeneralCard>>16		sta	[<InfoBlkPtr],y;---- Set up Where card ----		ldy	#IconObject.fileType		lda	 [<iconObjPtr],y		cmp	#$FFF9			; is icon a 5.25 floppy drive?		beq	isTrash2		lda	IconType		and	#itTrash		bne	isTrash2		lda	IconType		and	#itNetwork		bne	isNetwork		lda	#WhereCard		bra	setWhere		isTrash2	lda	#1		sta	InfoCard.count		; set card count		stz	<tempA			clc				; set card table reference		lda	<InfoBlkPtr		adc	#InfoBlock.cardTable		sta	InfoCard.cardRef		lda	<InfoBlkPtr+2		adc	#0		sta	InfoCard.cardRef+2		brl	doneWithFork		isNetwork	lda	#NetWhereCardsetWhere	ldy	#InfoBlock.cardTable+4		sta	[<InfoBlkPtr],y		iny		iny		lda	#WhereCard>>16		sta	[<InfoBlkPtr],y;; ---- Set up Comment card ----;; if we get this far, we always have a comment card (ie, not for trash, but we do for; everything else (except local volumes and folders);		ldy	#InfoBlock.cardTable+8		lda	#CommentCard		sta	[<InfoBlkPtr],y		iny		iny		lda	#CommentCard>>16		sta	[<InfoBlkPtr],y;; ---- Set up Access card ----;			stz	<tempA		lda	#^NetworkControls		sta	<tempA+2		lda	IconType		;is icon from network?		and	#itNetwork		bne	testOwner		;yes, so folders and volume can have						;comments				lda	IconType		;is icon a (local) volume/folder?		and	#itFolder+itVolume		bne	isLocal			;yes, so no comment or access cards		set3Cards	lda	#LocAccessCard		;must be a local file		ldx	#3		bra	setAccess		testOwner	lda	IconType		;is it a network volume or folder?		and	#itFolder+itVolume		beq	set3Cards		;nope, then we don't want an access card				lda	IconType		;is icon an owner?		and	#itOwner		bne	isOwner			;yes		lda	#NetWorkControls		sta	<tempA		lda	#NetAccessCard		ldx	#4		bra	setAccess		isOwner		lda	#OwnerControls		sta	<tempA		lda	#NetAccessCard2		ldx	#4		bra	setAccess		isLocal		lda	#LocAccessCard		ldx	#2			; no comments/access for local volumes/folderssetAccess	stx	InfoCard.count		; set card count		ldy	#InfoBlock.cardTable+12		sta	[<InfoBlkPtr],y		iny		iny		lda	#NetAccessCard>>16		sta	[<InfoBlkPtr],ysetCardRef	clc				; set card table reference		lda	<InfoBlkPtr		adc	#InfoBlock.cardTable		sta	InfoCard.cardRef		lda	<InfoBlkPtr+2		adc	#0		sta	InfoCard.cardRef+2;; the following was conceived after I realized that the privileges for a file weren't; really getting saved in the icon object -- so, we need to get the folder which the; file resides and see if we can "make changes" to IT instead;			lda	IconType		and	#itNetwork		beq	@dontCheckPrivs				lda	[<iconPathPtr]		pha				pushZLong <iconPathPtr		jsl	pathSubName				pha				;space for privileges		pha		pushlong #0			;don't want owner		pushlong #0			;don't want group		pushZlong <iconPathPtr		jsl	GetPrivileges		pla		and	#icMakeChanges		;only want "make changes" bit from		asl	a		asl	a		asl	a		asl	a			;move to high nybble		ldy	#IconObject.flag+2	;user summary byte (bit 2, which is also		ora	[<iconObjPtr],y		;the same as icMakeChanges)				ldy	#InfoBlock.windAccess		sta	[<InfoBlkPtr],y				pla				;extra user privs		pla				;restore our pathname		sta	[<iconPathPtr]@dontCheckPrivs		lda	LockedText+18		and	#$00FF		sta	LockedText+18		sta	InactiveText+18				lda	CheckBox1+18		and	#$00FF		sta	CheckBox1+18		sta	CheckBox2+18				ldy	#IconObject.fst		lda	[<iconObjPtr],y		cmp	#6			;HFSFST		bne	@checkReadOnly				ldy	#IconObject.filetype		lda	[<iconObjPtr],y		cmp	#$000F		beq	@noLock		@checkReadOnly	ldy	#IconObject.fst		lda	[<iconObjPtr],y		tay		jsl	IsReadOnly		bcc	@checkMakeChanges		@noLock		stz	useLockControls		;nah, don't even display the lock		bra	@forkStuff@checkMakeChanges		lda	IconType		and	#itNetwork		beq	@forkStuff				ldy	#InfoBlock.windAccess		lda	[<InfoBlkPtr],y		and	#icMakeChanges		bne	@forkStuff				lda	LockedText+18		ora	#InactiveHilite<<8		sta	LockedText+18		sta	InactiveText+18				lda	CheckBox1+18		ora	#InactiveHilite<<8		sta	CheckBox1+18		sta	CheckBox2+18;; if the icon in question has a fork, try to get the comment out of it -- if it doesn't; have a fork, then just add the comment;; if it's a mac comment or if there's some kind of crap in the resource fork, then; we set the number of cards to 2 if we're not on the network (and the windDirty; field will be set to 5 indicating that it has a fork, but the high bit won't be set; indicating that it's not a GS fork).;; Also, if it's a $FF or $F9 (GSOS System) file then we don't even allow a comment card; because someone could really screw up the system by allowing comments on those; types of files. - 21-Mar-93 JCM - We now allow the comment card on these files if the; file is already extended. This lets files like Sys.Resources show their version numbers; and other useful stuff.;@forkStuff		ldy	#InfoBlock.windDirty		lda	#0		sta	[<InfoBlkPtr],y				ldy	#iconObject.filetype	;is it a SYS file?		lda	[<iconObjPtr],y		cmp	#$00bd			;don't let them have a comment on FSTs		beq	@startGSOS		cmp	#$00f9			;don't let them have a comment on		beq	@startGSOS		;start.gs.os files		cmp	#$00ff		bne	@notSYSfile*** Added - 21-Mar-93 JCM - We'll allow a comment card with these special types if the file is already***			    extended (as is the case with Sys.Resources).@startGSOS	ldy	#iconObject.extended	;is this file already extended (like Sys.Resources?)		lda	[<iconObjPtr],y		bmi	@itsExtended		; absomolutelyish!		*** End - 21-Mar-93 JCM				lda	IconType		;get 3 cards if networked SYS file		and	#itNetwork		beq	@goFromLocal		brl	@fromNetwork		;only get 2 cards if local SYS file@goFromLocal	brl	@fromLocal@notSYSfile		ldy	#IconObject.extended	;is it an extended file?		lda	[<iconObjPtr],y		bpl	@noFork		@itsExtended 	ldy	#InfoBlock.windDirty	;say it's an extended file		lda	#5		sta	[<InfoBlkPtr],y		bra	@hasFork@noFork		ldy	#IconObject.fst		;is it a file on a read only file system without a		lda	[<iconObjPtr],y		;resource fork?		tay		jsl	IsReadOnly		bcs	@goFromLocal					lda	IconType		and	#itNetwork		beq	@notFromNetwork		brl	@fromNetwork		;; If we end up down here, we're going to give them a comment card with an <Add Comment>; button...;@notFromNetwork	pha				;space for handle		pha		PushZLong <infoWinPtr		pea	singlePtr		PushLong #AddCommentButton		_NewControl2			;add common controls		pla				;ignore handle		pla		brl	doneWithFork@hasFork	ldy	#IconObject.filetype				lda	[<iconObjPtr],y				cmp	#$B3		beq	@noAddToDesktop				pushlong #C1_Path		pushZLong <iconPathPtr		;put the root of iconPathPtr in		jsl	PathGetRoot		;C1_Path		lda	IconType		and	#itNetwork		beq	@addIconsName				pushlong #c1_bootname		pushlong #c1_path		jsl	WStringCopy		lda	>BootFST		cmp	#$0D		bne	@addIconsName				lda	#1		sta	>c1_path		lda	#'@'		sta	>c1_path+2		bra	@addDesktop@addIconsName	pushlong #IconsName		pushlong #c1_path		jsl	PathAddName		@addDesktop	pushlong #DesktopName		pushlong #c1_path		jsl	PathAddName				pha		pea	$8000			;update if needed		pushlong #1			;use rBundle #1		pushlong #c1_path		;update this desktop file		pushZLong <iconPathPtr		jsl	AddBundle2Desktop		pla		@noAddToDesktop	pha		pea	$8000			;as allowed, don't preload anything!		pushlong #0			;res map addr (NIL)		pushZLong <iconPathPtr		_OpenResourceFile		plx		stx	resFileID		bcc	@goodFork		cmp	#$46			;file not found		beq	@lostTheDisk		lda	IconType		;last chance, see if it's from the		and	#itNetwork		;network (in which case, they'll get		beq	@fromLocal		brl	@LimitTo199		;get a comment)		@fromLocal	ldx	#2			;c'este la vie, mac files don't get		stx	InfoCard.count		;comment cards.. sorry guys		brl	doneWithFork				@lostTheDisk	pushlong #C1_Path		pushZLong <iconPathPtr		;put the root of iconPathPtr in		jsl	PathGetRoot		;C1_Path				lda	#rasInsertDiskOrCancel		jsl	doAlertWindow		beq	@lostDisk		brl	@hasFork@lostDisk		pushlong IconButton+$1a		jsl DisposeHandleGlue				pushlong infoHandle		jsl DisposeHandleGlue				lda	<infoWinPtr		ldx	<infoWinPtr+2		jsl	CloseThisWindow		brl	bogus		;; cool, we actually have an online resource file which no one screwed up opening;@goodFork	pha		pea	1		;search only this file		_SetResourceFileDepth		pla		sta	oldDepth		ldy	#InfoBlock.windText.verName		sta	[<InfoBlkPtr],y		ldy	#InfoBlock.windText.verCopyright		sta	[<InfoBlkPtr],y		pha		pha		pea	rVersion	;$8029		pushlong #1		_LoadResource		pla		sta	<tempE		pla		sta	<tempE+2				bcc	@haveAVersion		brl	@noVersion@haveAVersion		lda	[<tempE]		tax		ldy	#2		lda	[<tempE],y		sta	<tempE+2		stx	<tempE;; convert the GS style version longword into a pascal string and modify the; stat text control to use it;		pea	0		ldy	#2		lda	[<tempE],y		;32 bit long version		pha		lda	[<tempE]		pha		pushlong #versionNumber+1	;address of version string (out)		_VersionString		lda	versionNumber		;now, add a space to the beginning of		xba				;the version number		and	#$00ff		inc	a		ora	#$2000		sta	versionNumber		;; move the product's name string into the space for the version stuff;		ldy	#6		lda	[<tempE],y		tax		and	#$00ff		cmp	#40		blt	@goodProductName		txa		and	#$ff00		ora	#40			;pin it at 40 characters		sta	[<tempE],y@goodProductName		lda	<tempE			;source pstring		clc		adc	#6		tax		lda	<tempE+2		adc	#0		pha		phx		lda	<infoBlkPtr		;destination pstring		clc		adc	#InfoBlock.windText.verName		tax		inc	a		sta	RealNameField+$1A		lda	<infoBlkPtr+2		adc	#0		sta	RealNameField+$1A+2		pha		phx		jsl	PStringCopy				pushlong #versionNumber		lda	<infoBlkPtr		;destination pstring		clc		adc	#InfoBlock.windText.verName		tax		lda	<infoBlkPtr+2		adc	#0		pha		phx		jsl	PStringCat		;concatenate them together		ldy	#InfoBlock.windText.verName		lda	[<infoBlkPtr],y		and	#$00ff			;how long?		sta	RealNameField+$1E;; now, move the copyright string (truncate it to 39 characters first);		ldy	#6		lda	[<tempE],y		and	#$00ff		clc		adc	#7			;one extra to compensate for the		tay				;first pstring's length byte		lda	[<tempE],y		tax		and	#$00ff		cmp	#63		blt	@goodCopyright		txa		and	#$ff00		ora	#63			;pin it at 63 characters		sta	[<tempE],y@goodCopyright		and	#$00ff			;how long?		sta	CopyrightField+$1E		ldy	#6			;source of copyright string		lda	[<tempE],y		and	#$00ff		clc;;; Note--Andy's code assumes the pstring is 255-7 characters long, or less, so this will not carry. --DAL		adc	#7			;one extra to compensate for the		adc	<tempE			;first pstring's length byte		tax		lda	<tempE+2		adc	#0		pha		phx		lda	<infoBlkPtr		;destination pstring		clc		adc	#InfoBlock.windText.verCopyright		tax		inc	a		sta	CopyrightField+$1A		lda	<infoBlkPtr+2		adc	#0		sta	CopyrightField+$1A+2		pha		phx		jsl	PStringCopy				pea	-1		pea	rVersion	;$8029		pushlong #1		_ReleaseResource		ldy	#cX2-6			;24-Mar-93 JCM - assume no check box		ldx	#VerGeneralCard		lda	IconType		; is icon a driver ?		and	#itDriver		beq	@noDriver		*** Added - 24-Mar-93 JCM - This futzes with the right edge of the product name string so it doesn't***			    overlap the "Inactive" check box title. Yeah, it's a hack, so what.		ldy	#cX2-108		*** End - 24-Mar-93 JCM				ldx	#InVerGeneralCard@noDriver	txa		sty	RealNameField.Rect+6	;24-Mar-93 JCM - update rect for checkbox being here or not		ldy	#InfoBlock.cardTable		sta	[<InfoBlkPtr],y		;; just close the resource file and continue...;@noVersion	pha		lda	oldDepth		pha		_SetResourceFileDepth		pla		lda	resFileID		pha				;don't bother with anything else, we 		_CloseResourceFile		;just wanted to know what was what		ldy	#InfoBlock.windDirty		lda	[<infoBlkPtr],y		ora	#$8000			;say yes, we have a GS resource fork		sta	[<infoBlkPtr],y		@fromNetwork	stz	CommentField+$40	;no limit on characters, unless...				ldy 	#IconObject.filetype		lda	[<iconObjPtr],y		cmp	#$00ff		beq	@limitTo199		cmp	#$000f			;yeah, well if it's a folder on appleshare,		bne	@noLimit		;limit it if there's a mac resource fork	@limitTo199	lda	#199			;limit to 199 characters if a network SYS file		sta	CommentField+$40@noLimit					lda	#$6208			;create as editable (will disable later)		sta	CommentField+$1A+2			ldy	#IconObject.fst		lda	[<iconObjPtr],y		tay		jsl	IsReadOnly		bcs	@wasReadOnly				ldy	#IconObject.flag	;so, create the textedit control		lda	[<iconObjPtr],y		;but first check if it's going to be		and	#icLocked		;editable of not...		beq	@notLocked		@wasReadOnly	lda	#$6608			;normally created as editable, so disable		sta	CommentField+$1A+2		@notLocked	pha				; space for handle		pha		PushZLong <infoWinPtr		pea	singlePtr		PushLong #CommentField		_NewControl2			; add common controls		pla				; ignore handle		pla		bcc	doneWithForkbogusControls	pushlong IconButton+$1a		jsl DisposeHandleGlue				pushlong infoHandle		jsl DisposeHandleGlue				lda	<infoWinPtr		ldx	<infoWinPtr+2		jsl	CloseThisWindow		brl	bogus		;; we're done playing with their resource fork for the moment, so just add the controls; and be happy;doneWithFork		lda	<tempA		beq	commonCtls		; no network stuff		pha				; space for handle		pha		PushZLong <infoWinPtr		pea	ptrToPtr		PushZLong <tempA		_NewControl2			; add network controls		pla				; ignore handle		pla		bcs	bogusControlscommonCtls	lda	useLockControls		beq	@noLockControls				pha				; space for handle		pha		PushZLong <infoWinPtr		pea	ptrToPtr		PushLong #LockControls		_NewControl2			; add common controls		pla				; ignore handle		pla@goBogusControls bcs	bogusControls		@noLockControls		pha				; space for handle		pha		PushZLong <infoWinPtr		pea	ptrToPtr		PushLong #CommonControls		_NewControl2			; add common controls		pla				; ignore handle		pla		bcs	@goBogusControls		lda	<iconPathPtr		ldx	<iconPathPtr+2		jsr	UpdateInfoBlk		; update fields		ldy	#IconObject.infoWin	; update icon's record		lda	<infoWinPtr		sta	[<iconObjPtr],y		iny		iny		lda	<infoWinPtr+2		sta	[<iconObjPtr],y				PushZLong <iconObjHand		jsl	UnLockHandleexit		pld		plb				lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		;clean up stack		sta	retAddr+parmSize,s		tsa		clc		adc	#parmSize+workSize		tas		clc		rtlbogus		pld		plb				lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		;clean up stack		sta	retAddr+parmSize,s		tsa		clc		adc	#parmSize+workSize		tas		sec		rtl;; Move icon to its own separate handle;		EXPORT MoveIconToHandleMoveIconToHandle		ldy	#IconObject.icon	;update the icon button control		lda	[<iconObjPtr],y		;and the info block to have the		sta	IconIndex		;icon handle;; get a pointer to our icon in the list of icons;		lda	>IconHandleArray	;get the handle to the array of icon handles		sta	<TempA		lda	>IconHandleArray+2		sta	<TempA+2		lda	[<TempA]		;deref		sta	<TempB		ldy	#2		lda	[<TempA],y		sta	<TempB+2		lda	>IconOffsetArray	;get the handle to the array of icon offsets		sta	<TempC		lda	>IconOffsetArray+2		sta	<TempC+2				lda	[<TempC]		;deref		sta	<TempD		lda	[<TempC],y		sta	<TempD+2		lda	IconIndex		sta	<TempE		stz	<TempE+2				asl	<TempE			;multiply our index by 4		rol	<TempE+2		asl	<TempE		rol	<TempE+2		lda	<TempE			;add our index to the handle array pointer		clc		adc	<TempB		sta	<TempB		lda	<TempE+2		adc	<TempB+2		sta	<TempB+2		lda	<TempE			;add our index to the offset array pointer		clc		adc	<TempD		sta	<TempD		lda	<TempE+2		adc	<TempD+2		sta	<TempD+2		lda	[<TempB]		;from the handle array, get the handle our icon		sta	<TempA			;resides in		ldy	#2		lda	[<TempB],y		sta	<TempA+2				lda	[<TempA]		;deref the handle which contains our icon		sta	<TempB		lda	[<TempA],y		sta	<TempB+2		lda	<TempB			;add the offset to our icon to the pointer to			clc				;the handle containing our icon		adc	[<TempD]		tax		lda	<TempB+2		adc	[<TempD],y		sta	<TempD+2		stx	<TempD		ldy	#4			;lock the handle		lda	[<TempA],y		ora	#$8000		sta	[<TempA],y				pha		pha				ldy	#2		lda	[<TempD],y		asl	a		clc		adc	#8		pha		jsl	NewHandle		;allocate a block for our icon		pla		sta	<TempB		sta	IconButton+$1a		pla		sta	<TempB+2		sta	IconButton+$1a+2				ldy	#4			;unlock the icon block		lda	[<TempA],y		and	#$3FFF		sta	[<TempA],y		bcc	@iconOK		brl	bogus@iconOK				pushZLong <tempD		;source		ldy	#2			;dest		lda	[<TempB],y		pha		lda	[<TempB]		pha				pea	0		ldy	#2			;Dest size		lda	[<TempD],y		asl	a		clc		adc	#8		pha		pea	$0805		jsl	Move_Info		rts		;; locals;IconIndex	dc.L	0		versionNumber	ds.b	11		;local copy of the version number					;with an extra space on the frontuseLockControls dc.w	0oldDepth	dc.w	0resFileID	dc.w	0infoHandle	dc.L	0		ENDP		*===============================================**						**	handle a control selection		**						** INPUT:	--- On the Stack ---		**		ctrlWinPtr (Long)		**		ctrlHand (Long)			**		ctrlPart  (Word)		**		ctrlID   (Long)			**		retAddr (3 bytes)		**	 SP--->					**						** OUTPUT:	--- On the Stack ---		*	*		retAddr (3 bytes)		**	 SP--->					**						**===============================================*InfoControls	PROC	EXPORT				IMPORT	doAlertWindow		IMPORT	writeComment		DSECT	workSpaceretAddr		block	3	ctrlID		longctrlPart	wordctrlHand	longctrlWinPtr	longparmSize	SET	14AuxType		EQU	tempD			; Mensch 5/19/89, fixing BRC #49175		IMPORT	GetPrivileges		; Mensch 5/19/89, fixing BRC #49175		IMPORT	FiFiFiSearch		IMPORT	matchFileToIcon		IMPORT	c1_pathname		IMPORT	pathGetRoot		IMPORT	setTEEditable		IMPORT	saveCursor		IMPORT	restoreCursor		IMPORT	arrowCursor		IMPORT	finderDPage		IMPORT	longNoRename		IMPORT	GetAccessValues		IMPORT	GetIconType		IMPORT	GetText		IMPORT	SetPrivileges		IMPORT	SetAllPriv		IMPORT	CalculateSize		IMPORT	LockTheFile		IMPORT	DisableTheFile		IMPORT	HandleToPointer		IMPORT	UnlockHandle		IMPORT	ArrowCursor		IMPORT	WatchCursor		IMPORT	SetInfoAccess		IMPORT	RedrawIconLock		IMPORT	WStrCompare		IMPORT	WStringCopy		IMPORT	WToPString		IMPORT	aboutWindowPtr				IMPORT	strAccessError		; in string segment		IMPORT	strBadChanges2		IMPORT	strChangeOwner		IMPORT	MoveIconToHandlebtnCancel	set	$01btnOK		set	$02btnTryAgain	set	$04btnContinue	set	$08iconStop	set	$32iconNote	set	$33iconCaution	set	$34iconDisk	set	$35iconDiskSwap	set	$36*===============================================*			sec		tsc				; get work space		sbc	#workSize		tcs				phb		phk		plb				phd		tcd				; set DP to stack		lda	<ctrlID		bmi	exit			; these are invalid ID's		beq	exit				lda	<ctrlWinPtr		sta	<infoWinPtr		lda	<ctrlWinPtr+2		sta	<infoWinPtr+2		pha				; space for pointer		pha		PushZLong <infoWinPtr		_GetWRefCon		PullLong <infoBlkPtr				pha		pha		PushLong [<infoBlkPtr],InfoBlock.windIcons		jsl	HandleToPointer		PullLong <iconObjPtr		jsr	GetIconType				lda	<ctrlID		dec	a		asl	a		tax		jsr	(CaseTable,x)		PushLong [<infoBlkPtr],InfoBlock.windIcons		jsl	UnlockHandleexit		pld		plb						lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		sta	retAddr+parmSize,s		tsa		clc		adc	#parmSize+workSize		tas		rtl;-----------------------------------------------		CaseTable	DC.W	_ApplyButton		;1		DC.W	_AllButton		;2		DC.W	_OwnerLineEdit		;3		DC.W	_GroupLineEdit		;4		DC.W	_ClassPopUp		;5		DC.W	_SeeFoldersPopUp	;6		DC.W	_SeeFilesPopUp		;7		DC.W	_MakeChangesPopUp	;8		DC.W	_LockedCheck		;9		DC.W	_InactiveCheck		;10		DC.W	_CalcButton		;11		DC.W	_LockedText		;12		DC.W	_InactiveText		;13		dc.W	_HitAddComment		;14;-----------------------------------------------		_ApplyButton_AllButton		jsl	WatchCursor		ldy	#idOwner		lda	#OwnerStr		ldx	#OwnerStr>>16		jsr	GetText			; get Owner string			add4	<InfoBlkPtr,#InfoBlock.windText.owner,<tempA		pha				; space for result		PushLong #OwnerStr		PushZLong <tempA		jsl	WStrCompare		; is owner string changing ?		pla		bne	sameOwner		; nope				add4	<InfoBlkPtr,#InfoBlock.windText.name,<tempB		PushZLong <tempB		PushLong #GroupStr		; temp place for name		jsl	WToPString				jsl	SaveCursor		jsl	ArrowCursor				pha		pea	$00B5			;refIsResource		pushlong #groupStrPtr		;substitution string #1		pushlong #rasChangeOwner	;resource ID		_AlertWindow		jsl	restoreCursor		pla		bne	@contApply		;button #1 = change		brl	undoApply		; reset settings@contApply			PushLong #OwnerStr		PushZLong <tempA		jsl	WStringCopy		; update to current ownersameOwner	ldy	#idGroup		lda	#GroupStr		ldx	#^GroupStr		jsr	GetText			; get Group string		jsr	GetAccessValues		; get Access rights				phx				; new access rights		pha		PushLong #OwnerStr		; ptr to owner string		PushLong #GroupStr		; ptr to group string		add4	<InfoBlkPtr,#InfoBlock.windText.path,<tempA		PushZLong <tempA		; ptr to pathname		lda	<ctrlID		cmp	#idApplyAll		; is this an Apply to all ?		beq	@doAll			; yes		jsl	SetPrivileges		; tell AppleShare		bcs	undoApply		; error, so undo settings		bra	endApply@doAll		jsl	SetAllPriv		; tell AppleShare		bcc	endApply		cmp	#$4E			; were there access errors ?		bne	undoApply		lda	#rasCouldntApply	;the changes couldn't be applied		jsl	doAlertWindow		sec		bra	endApplyundoApply	jsr	SetInfoAccess		; error, so restore settings		pha				; space for handle1		pha		pha				; space for handle2		pha		PushZLong <infoWinPtr		; control's window		PushLong #idOwner		; ID		_GetCtlHandleFromID		; get owner control handle		_GetCtlTitle			; get editLine handle		_LEUpdate			; redraw the text		pha				; space for handle1		pha		pha				; space for handle2		pha		PushZLong <infoWinPtr		; control's window		PushLong #idGroup		; ID		_GetCtlHandleFromID		; get owner control handle		_GetCtlTitle			; get editLine handle		_LEUpdate			; redraw the textendApply	bcc	@SetNewIconVal		; Mensch 5/19/89 (BRC #49175)@End1		jsl	ArrowCursor		rts;		; The Apply went fine, so now update the icon's flags to reflect the proper;   folder type by setting the access bits in its field to the new privileges the;   OS thinks we have;;; Call the FST to get our access privileges;@SetNewIconVal 		lda	#0		pha				; room for result		pha		pha				; Owner pointer (NIL, field not needed)		pha		pha				; Group pointer (NIL, field not needed)		pha;; now push the pathname pointer;		add4	<InfoBlkPtr, #InfoBlock.windText.path,<tempA		PushZLong <tempA		; pointer to pathname		jsl	GetPrivileges		; now get our access privileges		pla				; pull off the result		ldy	#IconObject.NetworkAccess		sta	[<iconObjPtr],y		tax		pla		iny		iny		sta	[<iconObjPtr],y				txa		and	#$0087			; strip off all the bits we need		cmp	#$0008			; are we the owner?		blt	@NotOwner		and	#$0007			; strip the OS owner bit		ora	#ICASOwner		; and add to our owner bit@NotOwner		pha				; save it on the stack		ldy	#IconObject.flag+2		lda	[<iconObjPtr],y		and	#$FFF0			; mask out user's access bits		ora	1,s			; add in new settings		ora	#$8000+ICREADABLE>>16	; set read access always and touched bits		tax				; and save it		and	#$0003			; can we save the thing?		bne	@CanRead		; yes - leave read access		txa				; get access rights back		eor	#ICREADABLE>>16		; Reset read access		tax				; save the privileges@CanRead	txa				; recover the correct privileges		sta	[<iconObjPtr],y		; and save the new access privs...		plx				; sweep debris from stack;; Now create the new AUX type from the folder in question;		stz	<AuxType		and	#$0007			; check user access bits		cmp	#$0004			; is this (shudder) a DROP box?		bne	@NotDrop		; in case "no"		sta	<AuxType		; in case "yes"		bra	@done			; now install new icon offset		@NotDrop	lda	[<iconObjPtr],y		and	#$0008		beq	@done			; bit 4 set if owner		sta	<AuxType;; AuxType is valid, so let's set up to create the icon;		@done		lda	<AuxType		ldy	#IconObject.fileInfo		sta	[<iconobjPtr],y		; save as the new auxtype				tax		ldy	#IconObject.filetype		lda	[<iconObjPtr],y		ldy	#0		jsl	FiFiFiSearch				ldy	#IconObject.kind		sta	[<IconObjPtr],y		iny		iny		txa		sta	[<IconObjPtr],y;; now, actually go out and do the match;		tsc		sec		sbc	#20			;put 5 longs on the stack		tcs		pea	$8000			;don't care about voting, match all		pea	1			;match the first one				ldy	#IconObject.filetype		lda	[<iconObjPtr],y		pha		pea	0		ldy	#IconObject.fileInfo		lda	[<iconobjPtr],y		; new auxtype		pha		lda	#IconObject.name	;ptr to the name		clc		adc	<iconObjPtr		tax		lda	<iconObjPtr+2		adc	#0		pha		phx				lda	#IconObject.CDate	;ptr to the create date		clc		adc	<iconObjPtr		tax		lda	<iconObjPtr+2		adc	#0		pha		phx				lda	#IconObject.MDate	;ptr to the mod date		clc		adc	<iconObjPtr		tax		lda	<iconObjPtr+2		adc	#0		pha		phx				ldy	#IconObject.LocalAccess	;local access value		lda	[<iconObjPtr],y		pha		ldy	#IconObject.Extended	;extended or not		lda	[<iconObjPtr],y		pha				lda	#IconObject.OptionList	;ptr to the option list		clc		adc	<iconObjPtr		tax		lda	<iconObjPtr+2		adc	#0		pha		phx		pushlong #0			;length zero		jsl	matchFileToIcon		pla		ldy	#IconObject.OneDocOffset		sta	[<iconObjPtr],y		iny		iny		pla		sta	[<iconObjPtr],y		pla		ldy	#IconObject.rBundle		sta	[<iconObjPtr],y		iny		iny		pla		sta	[<iconObjPtr],y				pla		ldy	#IconObject.SmallIcon		sta	[<iconObjPtr],y		iny		iny		pla		sta	[<iconObjPtr],y				pla		ldy	#IconObject.Icon		sta	[<iconObjPtr],y		iny		iny		pla		sta	[<iconObjPtr],y		pla		pla				;rFinderPath goes into hyperspace...		jsr	MoveIconToHandle	;(X) is used as an input		pha		pha		pushZLong <infoWinPtr		pushlong #idIconButton		_GetCtlHandleFromID		lda	1,s		sta	<TempA		lda	3,s		sta	<TempA+2				lda	[<TempA]		sta	<TempB		ldy	#2		lda	[<TempA],y		sta	<TempB+2				ldy	#$40+2		lda	[<TempB],y		pha		dey		dey		lda	[<TempB],y		pha		jsl DisposeHandleGlue		_DisposeControl			;get rid of the old icon button			pha				;space for handle		pha		PushZLong <infoWinPtr		pea	singlePtr		PushLong #IconButton		_NewControl2			;add the control, created invisible		pla				;because the card isn't showing		pla		brl	@End1		groupStrPtr	dc.L	GroupStrOwnerStr	DS.B	34GroupStr	DS.B	34;-----------------------------------------------		_OwnerLineEdit_GroupLineEdit		rts;-----------------------------------------------		_ClassPopUp		add4	<infoBlkPtr,#InfoBlock.PopValue,<tempA				pha				; space for pop up's value		PushZLong <ctrlHand		_GetCtlValue		pla		cmp	#2			; we don't allow custom (or 0)		bcc	done10		cmp	#6			; ignore bad values		bcs	done10		ldy	#PopVal.class		sta	[<tempA],y		dec	a		dec	a		asl	a		pha		asl	a		clc		adc	1,s		tax				; X <-- (value-2) * 6		pla				ldy	#0loop10		phy		phx		lda	Settings,x		; new value for pop up		cmp	[<tempA],y		; same as before ?		beq	next10		sta	[<tempA],y		; update our view of things		pha				; new value		pha				; space for handle		pha		PushZLong <infoWinPtr		pea	$0000			; hi word of ID		lda	IDs,y		pha				; lo word of ID		_GetCtlHandleFromID		_SetCtlValuenext10		plx		inx		inx		ply		iny		iny		cpy	#3*2		bcc	loop10		done10		rts		;-----------------------------------------------		_SeeFoldersPopUp_SeeFilesPopUp_MakeChangesPopUp		lda	<infoBlkPtr		clc		adc	#InfoBlock.PopValue		sta	<tempA		lda	<infoBlkPtr+2		adc	#0		sta	<tempA+2		pha				; space for pop up's value		PushZLong <ctrlHand		_GetCtlValue		lda	<ctrlID		sec		sbc	#idSeeFolders		asl	a		tay		pla		beq	done20		cmp	#6			; ignore bad values		bcs	done20		sta	[<tempA],y		; update our view of things				ldx	#0		ldy	#2loop20		phy		ldy	#PopVal.folder		lda	[<tempA],y		; check if settings match		cmp	Settings,x		bne	next20		ldy	#PopVal.file		lda	[<tempA],y		cmp	Settings+2,x		bne	next20		ldy	#PopVal.change		lda	[<tempA],y		cmp	Settings+4,x		beq	match20next20		ply		iny		txa		clc		adc	#6		tax		cpx	#4*6		bcc	loop20		pea	1			; else, use custommatch20		pla		ldy	#PopVal.class		cmp	[<tempA],y		; same as before?		beq	done20					sta	[<tempA],y		; update our view of things		pha				; new value		pha				; space for handle		pha		PushZLong <infoWinPtr		PushLong #idClass		; ID		_GetCtlHandleFromID		_SetCtlValue		done20		rts;-----------------------------------------------		_LockedCheck	name		phd		lda	>finderDPage		tcd		jsl	longNoRename		;remove the rename field if we have one		pld				;so that _LEUpdate in the window update						;proc won't blow away what we were						;supposed to be printing (ie, going from						;unlocked to locked		pha				; space for handle		pha		PushZLong <infoWinPtr		pushlong #idCommentFld		_GetCtlHandleFromID		;handle to TE record		pla		sta	<tempE		sta	coHandle		pla		sta	<tempE+2		sta	coHandle+2				lda	[<tempE]		tax		ldy	#2		lda	[<tempE],y		sta	<tempE+2		stx	<tempE				ldy	#$16		lda	[<tempE],y		cmp	#$8000		bne	@writeComment		dey		dey		lda	[<tempE],y		;simple button ctrlProc		bne	@ack		ldy	#iconObject.flag		lda	[<iconObjPtr],y		and	#icLocked		;if it's being locked, set the button		bne	@beingUnlocked		;so say that we can't add squat				pea	255		bra	@beingLocked@beingUnlocked	pea	0@beingLocked	pushLong coHandle		_HiliteControl		bra	@ack		@writeComment	pushZlong <infoWinPtr		;try REALLY hard to write the comment		pushZLong <infoBlkPtr		;out...		pushZLong <iconObjPtr		jsl	writeComment@ack		ldy	#iconObject.flag	;if the icon is extended, the icon is		lda	[<iconObjPtr],y			;drawn as it exists in the iconObject,		and	#icExtended		;so in that case, 		bne	@onDesk					ldy	#iconObject.filetype		lda	[<iconObjPtr],y		;if it's a volume we're locking, it'd better		bmi	@onDesk			;be on the desktop				ldy	#iconObject.flag		lda	[<iconObjPtr],y		pha				ora	#icLocked		sta	[<iconObjPtr],y		lda	<iconObjPtr		;this is a deceptive name for this		ldx	<iconObjPtr+2		;call because it actually just invalidates		jsr	RedrawIconLock		;it... andy 11/26/90					pla		ldy	#iconObject.flag		eor	#icLocked		sta	[<iconObjPtr],y				jsr	setTEEditable		bra	realLock		@onDesk		ldy	#iconObject.flag	;like I said... so, in that case, we		lda	[<iconObjPtr],y		;have to flip the bit ahead of time		eor	#icLocked		;so that the icon will get redrawn in		sta	[<iconObjPtr],y		;its correct state				lda	<iconObjPtr		;this is a deceptive name for this		ldx	<iconObjPtr+2		;call because it actually just invalidates		jsr	RedrawIconLock		;it... andy 11/26/90				jsr 	setTEEditable		jsr	realLock		rtssetError	lda	<tempB			; if call fails, flip control back		eor	#1		pha		PushZLong <ctrlHand		_SetCtlValue				ldy	#iconObject.flag	;if the icon is extended, the icon is		lda	[<iconObjPtr],y			;drawn as it exists in the iconObject,		and	#icExtended		;so in that case, 		bne	@onDesk					ldy	#iconObject.flag	;like I said... so, in that case, we		lda	[<iconObjPtr],y		;have to flip the bit ahead of time		pha		ora	#icLocked		;so that the icon will get redrawn in		sta	[<iconObjPtr],y		;its correct state				lda	<iconObjPtr		;this is a deceptive name for this		ldx	<iconObjPtr+2		;call because it actually just invalidates		jsr	RedrawIconLock		;it... andy 11/26/90				pla		ldy	#iconObject.flag			eor	#icLocked		sta	[<iconObjPtr],y						jsr	setTEEditable		rts		@onDesk		ldy	#iconObject.flag	;like I said... so, in that case, we		lda	[<iconObjPtr],y		;have to flip the bit ahead of time		eor	#icLocked		;so that the icon will get redrawn in		sta	[<iconObjPtr],y		;its correct state				lda	<iconObjPtr		;this one for the desktop actually draws the		ldx	<iconObjPtr+2		;the icon in its current state		jsr	RedrawIconLock						jsr	setTEEditable		rts	;; lock the file for real now that we're done fooling around with controls and such;realLock		pha				;space for control's value		PushZLong <ctrlHand		_GetCtlValue			;get lock value (0 | 1)		PullWord <tempB		ldy	#IconObject.fileType		lda	 [<iconObjPtr],y		bpl	@lockTheFile		;if this is negative, then it's gotta be						;a volume...		ldx	#$0110			;value for control list from matt's 2.0 ERS		lda	<tempB		bne	@lockTheVolume		ldx	#$0130			;value to unlock the volume (from 2.0 ERS)		@lockTheVolume	stx	SetControlList				ldy	#IconObject.devNum	;fill in the device number		lda	[<iconObjPtr],y		sta	SetLockParms+2		ldy	#IconObject.devInfo	;flip bit #1 to say we're locked or not		lda	[<iconObjPtr],y		eor	#$0002		sta	[<iconObjPtr],y		_DControlGS SetLockParms		bcc	@done		brl	setError			@lockTheFile	add4	<infoBlkPtr,#InfoBlock.windText.path,<tempA		pei 	<tempB			;value		PushZLong <tempA		;ptr to pathname		jsl	LockTheFile		bcc	@done		brl	setError@done		rts		;-----------------------------------------------		_InactiveCheck		pha				; space for contol's value		PushZLong <ctrlHand		_GetCtlValue			; get inactive value (0 | 1)		PullWord <tempB				add4	<infoBlkPtr,#InfoBlock.windText.path,<tempA				PushZWord <tempB		; value		PushZLong <tempA		; ptr to pathname		jsl	DisableTheFile		bcc	@ok		lda	<tempB			; if call fails, flip control back		eor	#1			; to what it was		pha		PushZLong <ctrlHand		_SetCtlValue		rts@ok		ldy	#IconObject.fileInfo	; flip icon's inactive bit		lda	[<iconObjPtr],y		eor	#$8000		sta	[<iconObjPtr],y 				rts;-----------------------------------------------		_CalcButton	_WaitCursor		pha		pha		_TickCount		jsr	CalculateSize		*** Added 21-Jan-93 JCM;;;		_InitCursor		jsl	ArrowCursor		*** End - 21-Jan-93 JCM						pha			;6-Nov-91 DAL -- SysBeep2 if it's been 2 seconds		pha		_TickCount		pla		sec		sbc 3,s		tax		pla		sbc 3,s		bne @longTime		cpx #120		bcc @notLong@longTime	pea $8005	;task complete		_SysBeep2@notLong	pla		pla		;discard orig tick value		rts		;-----------------------------------------------		_LockedText_InactiveText		pha				; space for handle		pha		PushZLong <infoWinPtr		; control's window		PushWord #0			; ID - high word		lda	<ctrlID		cmp	#idInactiveStr		bne	getLock		PushWord #idInactive		; ID - low word		bra	textGetgetLock		PushWord #idLocked		; ID - low wordtextGet		_GetCtlHandleFromID		; get the handle of the checkbox		PullLong <ctrlHand		pha				; space for contol's value		PushZLong <ctrlHand		_GetCtlValue			; get lock value (0 | 1)		pla		eor	#1			; flip it (new value)		sta	<tempB		pha				; new value		PushZLong <ctrlHand		_SetCtlValue			; set control's new value				lda	<ctrlID		cmp	#idLockedStr		bne	@makeInactive				brl	_LockedCheck@makeInactive	brl	_InactiveCheck;; _hitAddComment -- they hit the Text Edit control on the comment card.  Check the;		  dirty flags to see if we need to write this stuff if they change;		  cards or close the window;_hitAddComment	name		pha				; space for handle		pha		PushZLong <infoWinPtr		pushlong #idCommentFld		_GetCtlHandleFromID		;handle to TE record		pla		sta	<tempE		sta	coHandle		pla		sta	<tempE+2		sta	coHandle+2				lda	[<tempE]		tax		ldy	#2		lda	[<tempE],y		sta	<tempE+2		stx	<tempE				ldy	#$16			;simple button control proc		lda	[<tempE],y		cmp	#$8000		bne	@goExit		dey		dey		lda	[<tempE],y		beq	@isButton@goExit		rts				;so we need to write it back;; now that we know that the actually hit the button (and not text edit); we'll be asking them if they'd like to extend this file;@isButton		lda	#rasAddComment		;do they really want to add the comment?		jsl	doAlertWindow		bne	@writeMap		rts		@writeMap	lda #0		pha						pha				;auxtype		pha				;filetype		pha				;access		lda	#InfoBlock.windText.path ;fill in the path information for both		clc				;calls		adc	<infoBlkPtr		tax		lda	<infoBlkPtr+2		adc	#0		pha		phx		_CreateResourceFile		bcc	@hasLocalComment		cmp	#$46		beq	@lostTheFileAgain		cmp	#$2b		beq	@writeProtected		rts				@lostTheFileAgain		jsr	askForDisk		bne	@writeMap		rts		@writeProtected		pushlong #C1_PathName		lda	#InfoBlock.windText.path		clc		adc	<infoBlkPtr		tax		lda	<infoBlkPtr+2		adc	#0		pha		phx		jsl	PathGetRoot		;C1_PathName		lda	#rasWriteProtected		jsl	doAlertWindow		bne	@writeMap		rts;; yaaaahooo... we finally have a resource fork, so we can add a local comment, but; first, we need to get rid of the button and mark the icon as $8005 (extended, has; GS res fork) and put the TE control in it's place;@hasLocalComment		pha		pha		pushlong [<infoBlkPtr],InfoBlock.windIc		jsl	HandleToPointer		PullLong <iconObjPtr		ldy	#IconObject.extended		lda	[<iconObjPtr],y		ora	#$8000		sta	[<iconObjPtr],y		pushlong coHandle		_DisposeControl		pha				;space for handle		pha		PushZLong <infoWinPtr		pea	singlePtr		PushLong #CommentField		_NewControl2			;add te control, created invisible		lda	1,s		tax		lda	3,s		pha		phx		_ShowControl			;double handle on stack		_MakeThisCtlTarget		;make the cursor blink				ldy	#InfoBlock.windDirty	;set the file as having a GS resource		lda	#$8005			;fork and being extended		sta	[<InfoBlkPtr],y		@exit		rts		;; ask them for the disk (they can cancel);askForDisk		pushlong #C1_Pathname		lda	#InfoBlock.windText.path		clc		adc	<infoBlkPtr		tax		lda	<infoBlkPtr+2		adc	#0		pha		phx		jsl	PathGetRoot		;C1_Pathname				lda	#rasInsertDiskOrCancel		jsl	doAlertWindow		rts;; local locals;coHandle	dc.L	0extendParms	dc.w	5	;pcount		dc.L	0	;pathname		dc.w	$e3	;access		dc.w	4	;filetype		dc.L	0	;auxtype		dc.w	$8005	;extend this, please				ENDP		*===============================================** Write a Comment back to either the resource	** fork and/or the network desktop database	**						** INPUT:	--- On the Stack ---		**		windowPtr  (Long)		**		windBlkPtr (Long)		**		iconPtr	   (Long)		**		retAddr (3 bytes)		**	SP--->					**						** OUTPUT:	--- On the Stack ---		*	*		retAddr (3 bytes)		**	 SP--->					**===============================================*writeComment	PROCNAME	EXPORT		IMPORT	doAlertWindow		IMPORT	pathGetRoot		IMPORT	C1_PathName				DSECT	workSpaceretAddr		block	3	iconPtr		longwindBlkPtr	longwindowPtr	longparmSize	SET	12*===============================================*				sec		tsc				; get work space		sbc	#workSize		tcs		phb		phk		plb		phd		tcd				; set DP to stack		pha				; space for handle		pha		PushZLong <windowPtr		pushlong #idCommentFld		_GetCtlHandleFromID		;handle to TE record		pla		sta	<tempE		sta	teHandle		pla		sta	<tempE+2		sta	teHandle+2				lda	[<tempE]		tax		ldy	#2		lda	[<tempE],y		sta	<tempE+2		stx	<tempE				ldy	#$16		lda	[<tempE],y		cmp	#$8500		bne	@goExit		dey		dey		lda	[<tempE],y		;textedit ctrlProc		bne	@goExit				ldy	#$10			;check the textEdit dirty flag		lda	[<tempE],y		and	#$0040		bne	@dirty			;if it's dirty, they changed the comment@goExit		brl	@exit			;so we need to write it back@dirty		;; first, see if we have a comment to write back;		ldy	#icFlag			;is it locked?		lda	[<iconPtr],y			and	#icLocked		beq	@keepSmiling		brl	@exit			;if so, forget about writing anything@keepSmiling	ldy	#InfoBlock.windDirty		lda	[<windBlkPtr],y		bmi	@hasLocalComment			ldy	#IconObject.flag+2		lda	[<iconPtr],y		and	#icNetWork>>16		beq	@goExit@goNetwork	ldy	#infoBlock.windAccess		lda	[<windBlkPtr],y		and	#icInfoMakeChanges>>16		beq	@goExit		brl	@hasNetworkComment;; we have a comment to write, so first check to see if it's a local; comment, and if so, write it back locally...;@hasLocalComment		pha		_GetCurResourceFile		pla		sta	firstResourceFile				pha		pea	$8000			;as allowed, don't preload anything!		pushlong #0			;res map addr (NIL)		lda	#InfoBlock.windText.path		clc		adc	<windBlkPtr		tax		lda	<windBlkPtr+2		adc	#0		pha		phx		_OpenResourceFile		plx		stx	resFileID		bcc	@goodFork		cmp	#$46			;file not found		beq	@askForDisk		brl	@checkNetwork		@askForDisk	pushlong #C1_PathName		lda	#InfoBlock.windText.path		clc		adc	<windBlkPtr		tax		lda	<windBlkPtr+2		adc	#0		pha		phx		jsl	PathGetRoot		;C1_PathName				lda	#rasInsertDiskOrCancel		jsl	doAlertWindow		bne	@hasLocalComment	; nope ... try again to keep them honest		brl	@checkNetwork;; Cool.   We were able to open our resource file, so remove the old rComment resource; and Add the new rComment resource, then close it (write it back).;; but first, see if we got write permissions from the file to be able to write it back;@goodFork	pha		lda	resFileID		pha		_GetOpenFileRefNum		pla				sta	refInfoParms+2				jsl	$e100a8		dc.w	$2039			;_GetRefInfo refInfoParms		dc.L	refInfoParms				lda	refInfoParms+4		;get access we were provided		and	#$0002		bne	@OKToWrite		bra	@tryClosing@OKToWrite	pha		pea	1		_SetResourceFileDepth		pla		sta	oldDepth				pea	rComment		;$802a		pushlong #1		_RemoveResource				pha		pha		pea	$001D			;ref is ptr to handle, unformatted text		pushlong #textHandle		;buffer ref		pushlong #0			;buffer length		pea	0			;style descriptor		pushlong #0			;no style info		pushlong teHandle		_TEGetText		pla				;we don't care how much		pla				pushlong textHandle		pea	0			;attributes (nothing)		pea	rComment		;$802A		pushlong #1			;id		_AddResource		@tryClosing	pha		lda	oldDepth		pha		_SetResourceFileDepth		pla				lda	resFileID		pha		_CloseResourceFile		bcs	@badClose		ldy	#$10			;clear the fRecordDirty bit (we wrote it!)				lda	[<tempE],y		and	#$ffBf		sta	[<tempE],y		brl	@checkNetwork;; we weren't able to close the file, so see if the file is offline and prompt them; for it if it's not online -- otherwise, we have a big problem;@badClose	cmp	#$46			;is it a 'file not found' error?		beq	@askforDisk2		cmp	#$2b		beq	@writeProtected		bra	@resetResourceFile		@writeProtected	pushlong #C1_PathName		lda	#InfoBlock.windText.path		clc		adc	<windBlkPtr		tax		lda	<windBlkPtr+2		adc	#0		pha		phx		jsl	PathGetRoot		;C1_PathName		lda	firstResourceFile		pha		_SetCurResourceFile		lda	#rasWriteProtected		jsl	doAlertWindow		beq	@resetResourceFile		bra	@tryClosing		@askForDisk2	pushlong #C1_PathName		lda	#InfoBlock.windText.path		clc		adc	<windBlkPtr		tax		lda	<windBlkPtr+2		adc	#0		pha		phx		jsl	PathGetRoot		;C1_PathName		lda	firstResourceFile		pha		_SetCurResourceFile				lda	#rasInsertDiskOrCancel		jsl	doAlertWindow		beq	@resetResourceFile		brl	@tryClosing		; nope ... try again to keep them hones;; if we get to this point, something went agog, so try to recover as best we can by; putting the finder back as the current resource file;; and the resource file is still open, ack!  ack!;@resetResourceFile		lda	resFileID		ora	#$8000			;close it anyway		pha		_CloseResourceFile		lda	firstResourceFile		pha		_SetCurResourceFile		;; before we go dancing away after writing (or not writing, whatever) the comment; locally, see if we should write a network comment (well, ok, only the first 200; bytes of it);@checkNetwork	ldy	#IconObject.flag+2		lda	 [<iconPtr],y		and	#icNetWork>>16		bne	@hasNetworkComment		brl	@exit;; then, if it's also (or) a network comment, write out the first 200; characters of the comment to the network database;; we don't care how long the block that is returned is because the AppleShare FST; will truncate it to 199 characters -- whadda guy that Mark Day;@hasNetworkComment		pha		pha		pea	$001A			;ref is ptr to handle, c1_inputstring		pushlong #textHandle		;buffer ref		pushlong #0			;buffer length		pea	0			;style descriptor		pushlong #0			;no style info		pushlong teHandle		;space for handle		_TEGetText		pla		pla		lda	textHandle		sta	<tempD		lda	textHandle+2		sta	<tempD+2		lda	[<tempD]		;dereference the comment		sta	SetCommentParms+$c		ldy	#2		lda	[<tempD],y		sta	SetCommentParms+$c+2			lda	#InfoBlock.windText.path ;fill in the path information for both		clc				;calls		adc	<windBlkPtr		sta	OpenDesktopParms+8		sta	SetCommentParms+8		lda	<windBlkPtr+2		adc	#0		sta	OpenDesktopParms+10		sta	SetCommentParms+10				jsl	$e100a8		dc.w	$2033		dc.L	OpenDesktopParms	;quit if errors		bcs	@exit		lda	OpenDesktopParms+6	;move the desktop refnum		sta	SetCommentParms+6				jsl	$e100a8					dc.w	$2033		dc.L	SetCommentParms		;don't care about errors, just fall thru;; we're (finally) done writing the new comment;@exit		pld		plb				lda	retAddr+1,s		sta	retAddr+parmSize+1,s		lda	retAddr,s		;clean up stack		sta	retAddr+parmSize,s		tsa		clc		adc	#parmSize+workSize		tas		clc		rtl;; locals;oldDepth	dc.w	0teHandle	dc.L	0teChars		dc.L	0refInfoParms	dc.w	2		dc.w	0	;input, refnum		dc.w	0	;accessfirstResourceFile 		dc.W	0resFileID	dc.W	0infoHandle	dc.L	0textHandle	dc.L	0	;handle to our comment text teHowMuch	dc.L	0OpenDesktopParms		dc.w	4	;pcount		dc.w	$0d	;AppleShare		dc.w	$9	;open desktop		dc.w	0	;dtRefNum		dc.L	0	;pathnamePtr		SetCommentParms			dc.w	5	;pcount		dc.w	$0d	;AppleShare		dc.w	$c	;set comment		dc.w	0	;dtRefNum		dc.L	0	;pathnamePtr		dc.L	0	;commentPtr				ENDP				*===============================================**	Get Line Edit Text From Control		**						** IN:	id (y-reg), stringPtr (a,x-reg)		**						** OUT:	none					**===============================================*GetText		PROC		IMPORT	TextToWString		IMPORT	HandleToPointer				sta	<tempB		stx	<tempB+2				pha				; space for handle 2		pha		pha				; space for handle 1		pha		PushZLong <infoWinPtr		PushWord #0			; ID (hi word)		phy				; ID (lo word)		_GetCtlHandleFromID		; get control handle		_GetCtlTitle			; get editLine handle		PullLong theHandle		pha				; space for pointer		pha		pha				; space for handle		pha		PushLong theHandle		; handle to Line Edit record		_LEGetTextHand		jsl	HandleToPointer		; ptr to text on stack		PushZLong <tempB			; ptr to string		pha				; space for length		PushLong theHandle		; handle to Line Edit record		_LEGetTextLen			; get length (on stack)		jsl	TextToWString				rts		ENDP*===============================================**     Set Info where from Icon Object record.	**						** IN:	infoBlkPtr, iconPathPtr (a,x-reg)	** OUT:	none					**===============================================*SetInfoWhere	PROC		IMPORT	DeviceToString		IMPORT	GetDeviceName		IMPORT	NewTextField		IMPORT	WStringCopy		IMPORT	GetServerName		IMPORT	PToWString		IMPORT	PStringCat				sta	<tempD		stx	<tempD+2		lda	IconType		and	#itTrash		beq	ok		brl	exit;---- Update Path field ----		ok		add4	<InfoBlkPtr,#InfoBlock.windText.path,<tempA		PushZLong <tempD		PushZLong <tempA		jsl	WStringCopy		lda	#idPathFld			; ID		ldy	#InfoBlock.windText.path	; offset		jsr	NewTextField;---- Update Device field ----		lda	IconType		and	#itNetwork		bne	doNet				; not a local volume				add4	<InfoBlkPtr,#InfoBlock.windText.device,<tempA			lda	IconType		and	#itVolume		bne	vol				; volumes have good devNum				add4	<InfoBlkPtr,#InfoBlock.windText.path,<tempB			PushZLong <tempA		PushZLong <tempB		jsl	GetDeviceName			; use pathname to get device name		bra	cont1		vol		PushZLong <tempA		ldy	#IconObject.devNum		PushWord [<iconObjPtr],y			jsl	DeviceToString*** Added - 17-Feb-93 JCM - Let's show the SCSI ID right after the device name if it's a SCSI device.cont1		lda	SCSIPriority			;did we get a valid SCSI ID?		bmi	@skipSCSIID			; nope, bye-bye				clc		adc	#$30				;convert to '0' - '7'		sta	strSCSIIDByte		lda	[<tempA]			;get current device string length		inc	a		inc	a				;move over length word		tay				ldx	#0		@copySCSIIDStr	lda	strSCSIID,x		sta	[<tempA],y				iny		iny		inx		inx		cpx	#8		bne	@copySCSIIDStr				lda	#8		clc		adc	[<tempA]		sta	[<tempA]@skipSCSIID	*** End - 17-Feb-93 JCM		lda	#idDeviceFld			; ID		ldy	#InfoBlock.windText.device	; offset		jsr	NewTextField		bra	exit		;---- Update Server & Zone fields ----doNet		add4	<InfoBlkPtr,#InfoBlock.windText.server,<tempA			add4	<InfoBlkPtr,#InfoBlock.windText.zone,<tempB			add4	<InfoBlkPtr,#InfoBlock.windText.path,<tempC		PushZLong <tempA		PushZLong <tempB		PushZLong <tempC		jsl	GetServerName				lda	#idServerFld			; ID		ldy	#InfoBlock.windText.server	; offset		jsr	NewTextField		lda	#idZoneFld			; ID		ldy	#InfoBlock.windText.zone	; offset		jsr	NewTextFieldexit		rts		string ASIS			EXPORT	strSCSIIDstrSCSIID	dc.b	', SCSI 'strSCSIIDByte	ds.b	2				;one byte is filler		ENDP*===============================================** 	Set Info kind from Icon Object record.	**						** IN:	infoBlkPtr, iconObjPtr			** OUT:	none					**===============================================*SetInfoKind	PROCNAME		IMPORT	NewTextField		IMPORT	PToWString		IMPORT	PStringCopy		IMPORT	GetFSTName		IMPORT	PStringCat		;---- Update Kind field ----		lda	#0		ldy	#InfoBlock.windText.kind		sta	[<InfoBlkPtr],y			; set length to zero		add4	<InfoBlkPtr,#InfoBlock.windText.kind,<tempA		lda	IconType			; is icon a volume?		and	#itVolume		beq	kind				; no		PushZLong <tempA		ldy	#IconObject.fileInfo		PushWord [<iconObjPtr],y			jsl	GetFSTName			; get File System name		lda	[<tempA]			; cheap W to P string		inc	a		tay		xba		sta	[<tempA]		iny		lda	#' '		sta	[<tempA],y			; add in space character		kind		ldy	#IconObject.kind+1		lda	[<IconObjPtr],y		bne	@NoOneDoc				ldy	#IconObject.rBundle		lda	[<IconObjPtr],y		sta	<TempB		iny		iny		lda	[<IconObjPtr],y		sta	<TempB+2				lda	[<tempB]		tax		ldy	#2		lda	[<tempB],y		sta	<tempB+2		stx	<tempB				ldy	#IconObject.OneDocOffset		lda	[<IconObjPtr],y		clc		adc	<tempB;;;		adc	#32		tax		iny		iny		lda	[<IconObjPtr],y		adc	<tempB+2		pha		phx*** fixed 11-Jan-93 DAL to propogate carry correctly		clc		pla		adc	#32		pha		bcc	@1		lda	3,s		inc	a		sta	3,s@1*** end 11-Jan-93		bra	@hadOneDoc@NoOneDoc	ldy	#IconObject.kind+2		;get pointer to kind string		lda	[<iconObjPtr],y		pha		dey		dey		lda	[<iconObjPtr],y		pha		@hadOneDoc	ldx	<tempA+2		lda	<tempA		inc	a		bne	cont		inxcont		phx		pha		jsl	PStringCat			; add in kind string		lda	[<tempA]			; cheap P to W string		xba		sta	[<tempA]*** Added - 17-Mar-93 JCM - Clear the old kind string out before we draw the new one.***			    That way, if the new one is shorter than the older one, we***			    won't get any leftover gunk.				pha		pha		_GetPort				PushZLong <infoWinPtr		_SetPort				pha				; space for handle		pha		PushZLong <infoWinPtr		PushLong #idKindFld		;ID		_GetCtlHandleFromID		phd				tsc		tcd				lda	[3]		clc		adc	#8			;oCtlRect		tax		ldy	#2		lda	[3],y		adc	#0		pha		phx		_EraseRect				pld				pla		pla			_SetPort	*** End - 17-Mar-93 JCM		lda	#idKindFld			; ID		ldy	#InfoBlock.windText.kind	; offset		jsr	NewTextField		rts		ENDP*===============================================** 	Set Info Comment field			**						** IN:	infoBlkPtr, iconObjPtr			** OUT:	none					**===============================================*SetInfoComment	PROC		IMPORT	NewHandle		IMPORT	HandleToPointer		IMPORT	PstringCopy		IMPORT	NewTextField		IMPORT	WStringCopy		IMPORT	GetComment		IMPORT	doAlertWindow		IMPORT	pathGetRoot		IMPORT	c1_PathName		lda	IconType		and	#itNetwork		bne	isFromNetwork		;; only check for volumes or folders on local devices and do *NOT*, I repeat, do NOT; get comments for local SYS files;		lda	IconType		;we dunna want it if it's a volume or		and	#itVolume+itFolder	;or folder (just extended files)		beq	isFromNetwork			rts						isFromNetwork	ldy	#InfoBlock.windDirty		lda	[<InfoBlkPtr],y		bmi	@hasFork		;dunna have a (GS) resource fork		brl	checkNetwork			@hasFork	pha		pea	$8000			;as allowed, don't preload anything!;;;		pushlong #0			;res map addr (NIL) - 17-Mar-93 JCM		lda	#0			;17-Mar-93 JCM		pha				;17-Mar-93 JCM		pha				;17-Mar-93 JCM		lda	#InfoBlock.windText.path		clc		adc	<InfoBlkPtr		tax		lda	<infoBlkPtr+2		adc	#0		pha		phx		_OpenResourceFile		plx		stx	resFileID		bcc	@goodFork		cmp	#$46			;file not found		beq	@askForDisk		brl	checkNetwork		@askForDisk		pushlong #C1_PathName		lda	#InfoBlock.windText.path		clc		adc	<InfoBlkPtr		tax		lda	<infoBlkPtr+2		adc	#0		pha		phx		jsl	PathGetRoot		;C1_PathName				lda	#rasInsertDiskOrCancel		jsl	doAlertWindow		beq	@hasFork		rts;; now, get the comment ;@goodFork	pha				; space for handle		pha		PushZLong <infoWinPtr		pushlong #idCommentFld		_GetCtlHandleFromID		;handle to TE record		pulllong teHandle		pha		pea	1		_SetResourceFileDepth		pla		sta	oldDepth				pha		pha		pea	rComment	;$802A		pushlong #1		_LoadResource		pla		plx		bcc	@haveAComment		brl	@checkBeforeClosing@haveAComment				sta	commentHandle		sta	<tempE		stx	commentHandle+2		stx	<tempE+2				ldy	#4			;lock the handle down		lda	[<tempE],y		ora	#$8000		sta	[<tempE],y						pea	$D			;textRef is handle, unformatted text		pushZLong <tempE		pushlong #0			;length		pea	0			;style		pushlong #0			;styleref	 	pushlong teHandle		_TESetText		pea	-1		pea	rComment		;$802A		pushlong #1		_ReleaseResource		;; before closing, check to see if we were able to get write permissions for this file,; and set the bits in textFlags accordingly;@checkBeforeClosing		pha		lda	resFileID		pha		_GetOpenFileRefNum		pla				sta	refInfoParms+2				jsl	$e100a8		dc.w	$2039			;_GetRefInfo refInfoParms		dc.L	refInfoParms				lda	teHandle		sta	<tempE		lda	teHandle+2		sta	<tempE+2				lda	[<tempE]		tax		ldy	#2		lda	[<tempE],y		sta	<tempE+2		stx	<tempE				lda	refInfoParms+4		;get access we were provided		and	#$0002		tax							lda	teTextFlags,x		;0=disable, 2=enable		ldy	#$28+2		sta	[<tempE],y				lda	resFileID		pha		_CloseResourceFile				pha		lda	oldDepth		pha		_SetResourceFileDepth		pla		rts;; checkNetwork -- see if this icon belonged the something on the net, and if so, read; the comment out into a handle which we'll use to do the TESetText;checkNetwork		lda	IconType		and	#itNetwork		bne	@fromNetwork		rts@fromNetwork	pha		pha		pea	202			;need a 202 byte handle		jsl	NewHandle			pulllong commentHandle				pha		pha		pushlong commentHandle		;lock it down		jsl	HandleToPointer		pulllong <tempB			;put the comment here		add4	<InfoBlkPtr,#InfoBlock.windText.path,<tempA		PushZLong <tempA		;ptr to pathname		PushZLong <tempB		;ptr to comment string		jsl	GetComment				pea	2			;textDescriptor is a C1_InputString		pushZLong <tempB		;textRef		pushlong #0			;length		pea	0			;style		pushlong #0			;styleref	 			pha				; space for handle		pha		PushZLong <infoWinPtr		pushlong #idCommentFld		_GetCtlHandleFromID		;handle to TE record		_TESetText		jsr	SetTEEditable		pushlong commentHandle		jsl DisposeHandleGlue		rts;; locals;oldDepth	dc.w	0			;old resource manager search depthrefInfoParms	dc.w	2		dc.w	0			;input, refnum		dc.w	0			;access	teHandle	dc.L	0teTextFlags	dc.w	$6608			;no editing		dc.w	$6208			;allow editing		resFileID	dc.w	0commentHandle	dc.L	0; setTEEditable -- set the TE control to allow editing if it looks like;		   we'll be able to write the comment back;;		   for this to work, the icon has to be unlocked, and;		   also the current folder has to allow;;.....................................................................		export	SetTEEditableSetTEEditable	name				pha				; space for handle		pha		PushZLong <infoWinPtr		pushlong #idCommentFld		_GetCtlHandleFromID		;handle to TE record		pla		sta	<tempE		pla		sta	<tempE+2				lda	[<tempE]		tax		ldy	#2		lda	[<tempE],y		sta	<tempE+2		stx	<tempE		lda	IconType		and	#itNetwork		beq	@canMakeChanges				ldy	#InfoBlock.windAccess		lda	[<infoBlkPtr],y		and	#icInfoMakeChanges>>16		bne	@canMakeChanges				lda	teTextFlags		;turn the textEdit editing off...		ldy	#$28+2		sta	[<tempE],y				rts@canMakeChanges	ldy	#icFlag		lda	[<iconObjPtr],y		and	#icLocked		beq	@writable				lda	teTextFlags		;disable comment editing		bra	@notWritable		@writable	lda	teTextFlags+2		;enable comment editing@notWritable	ldy	#$28+2		sta	[<tempE],y		rts		ENDP		*===============================================** Set Content from Icon Object record.		**						** IN:	infoBlkPtr, iconObjPtr			** OUT:	none					**===============================================*SetInfoContent	PROC		IMPORT	NewTextField		IMPORT	PToWString		IMPORT	strPressCalc		lda	IconType		and	#itVolume+itFolder		beq	exit				; not a volume		add4	<InfoBlkPtr,#InfoBlock.windText.content,<tempA		PushLong #strPressCalc			; "use calculate icon..."		PushZLong <tempA		jsl	PToWString				lda	#idContentFld			; ID		ldy	#InfoBlock.windText.Content	; offset		jsr	NewTextFieldexit		rts				ENDP		*===============================================**    Set Info Size from Icon Object record.	**						** IN:	infoBlkPtr, iconObjPtr			** OUT:	none					**===============================================*SetInfoSize	PROC				IMPORT	SizeToString		IMPORT	NewTextField		IMPORT	PStringCopy		IMPORT	PStringCat		IMPORT	GetFSTBlockSize		IMPORT	strPressCalc			; in string segment		IMPORT	strBytesUsed		IMPORT	strInDisk		IMPORT	strAvailable		IMPORT	strOnDisk		lda	IconType		and	#itTrash		beq	notTrash		brl	exit;---- Update file size ----notTrash		lda	#0		ldy	#InfoBlock.windText.size		sta	[<InfoBlkPtr],y			; set length to zero		add4	<InfoBlkPtr,#InfoBlock.windText.size+1,<tempA				lda	IconType			; is icon a folder?		and	#itFolder		beq	notFolder		brl	foldernotFolder	lda	IconType			; is icon a volume?		and	#itVolume		beq	file		brl	volume;; --- Set size for file icon ----------------------------				;file		ldy	#IconObject.fileBlocks		lda	[<iconObjPtr],y		sta	blocks		iny		iny		lda	[<iconObjPtr],y		sta	blocks+2		lda	#2			;default to K		sta	multiplier		jsr	GetBlocksIn1MB				ldy	#IconObject.fileBlocks+2		lda	[<IconObjPtr],y		bne	@blocksInMB		dey		dey		lda	[<IconObjPtr],y		cmp	BlocksIn1MB		blt	@blocksInK	@blocksInMB	lda	#8		sta	multiplier@blocksInK		PushLong #blkStr			; get block count in ascii		PushLong blocks		lda	multiplier			; type = kilo or MB		pha		ldy	#IconObject.fst		lda	[<IconObjPtr],y		jsl	GetFSTBlockSize		pha		jsl	SizeToString		PushZLong <tempA			; get byte count in ascii		PushLong [<IconObjPtr],IconObject.fileBytes		pea	1				; type = byte		pea	512				; blocksize (doesn't matter)		jsl	SizeToString		PushLong #strBytesUsed			; add " used, "		PushZLong <tempA		jsl	PStringCat				PushLong #blkStr			; add block count		PushZLong <tempA		jsl	PStringCat		PushLong #strOnDisk			; add " on disk"		PushZLong <tempA		jsl	PStringCat		brl	set;--- Set size for volume icon --------------------------volume		ldy	#IconObject.fileBytes		; total blocks (volume)		lda	[<iconObjPtr],y		sec		ldy	#IconObject.fileBlocks		; blocks used		sbc	[<iconObjPtr],y		sta	blocks				ldy	#IconObject.fileBytes+2		lda	[<iconObjPtr],y		ldy	#IconObject.fileBlocks+2		sbc	[<iconObjPtr],y		sta	blocks+2				lda	#2		sta	multiplier		jsr	GetBlocksIn1MB				lda	blocks+2		bne	@freeInMB		lda	blocks		cmp	BlocksIn1MB		blt	@freeInK@freeInMB	lda	#8		sta	multiplier@freeInK		PushLong #blkStr				pushlong blocks				; blocks available (hi word)		lda	multiplier		pha		ldy	#IconObject.fst		lda	[<iconObjPtr],y		jsl	GetFSTBlockSize		pha		jsl	SizeToString			; get used blocks in ascii		ldy	#IconObject.fileBlocks		lda	[<iconObjPtr],y		sta	blocks		iny		iny		lda	[<iconObjPtr],y		sta	blocks+2		lda	#2		sta	multiplier				ldy	#IconObject.fileBlocks+2		lda	[<iconObjPtr],y		bne	@usedInMB		dey		dey		lda	[<iconObjPtr],y		cmp	BlocksIn1MB		blt	@usedInK@usedInMB	lda	#8		sta	multiplier@usedInK		PushZLong <tempA		PushLong blocks		lda	multiplier		pha		ldy	#IconObject.fst		lda	[<iconObjPtr],y		jsl	GetFSTBlockSize		pha		jsl	SizeToString			; get blocks used in ascii		PushLong #strInDisk			; add " in disk,  "		PushZLong <tempA		jsl	PStringCat		PushLong #blkStr			; add available blocks		PushZLong <tempA		jsl	PStringCat		PushLong #strAvailable			; add " free"		PushZLong <tempA		jsl	PStringCat		bra	set;; --- Folder icons don't have any size (yet) -----------;folder		PushLong #strPressCalc		PushZLong <tempA		jsl	PStringCopy		set		ldy	#InfoBlock.windText.size		lda	[<InfoBlkPtr],y		xba					; cheap P to W conversion		sta	[<InfoBlkPtr],y		lda	#idSizeFld			; ID		ldy	#InfoBlock.windText.size	; offset		jsr	NewTextFieldexit		rts;; GetBlocksIn1MB -- get the number of FST sized blocks in 1MB;GetBlocksIn1MB	lda	#1048576/512		;assume 512 byte blocks		sta	BlocksIn1MB				ldy	#IconObject.fst		lda	[<IconObjPtr],y		jsl	GetFSTBlockSize				cmp	#512		beq	@notOddSize		pha		pha		pha		pha		pushlong #1048576		;numerator = 1MB		pea	0		pha				;denominator = block size (will never be zero)		_LongDivide		pla		sta	BlocksIn1MB		plx		plx		plx@notOddSize	rts;; locals;blocksIn1MB	dc.w	0multiplier	dc.w	2				;K or MBbytes		ds.b	4blocks		ds.b	4blkStr		DS.B	10		ENDP*===============================================**    Set Info Access Privilege Names.		**						** IN:	infoBlkPtr, iconObjPtr, IconType,	**	infoWinPtr				** OUT:	none					**===============================================*SetInfoAccess	PROC		IMPORT	SetAccessValues		IMPORT	GetPrivileges		IMPORT	NewTextField		IMPORT	PStringCat		IMPORT	PStringCopy		IMPORT	PToWString		IMPORT	StringBase		; strings from string segment		IMPORT	strPriv0		IMPORT	strPriv1		IMPORT	strPriv2		IMPORT	strPriv3		IMPORT	strPriv4		IMPORT	strPriv5		IMPORT	strPriv6		IMPORT	strPriv7;---- Check for Network AND Volume/Folder ----		lda	IconType		and	#itNetwork+itVolume+itFolder		cmp	#itNetwork+itVolume		beq	good				cmp	#itNetwork+itFolder		beq	good		brl	exit			; not a network folder/volume		good		add4	<InfoBlkPtr,#InfoBlock.windText.owner,<tempA		add4	<InfoBlkPtr,#InfoBlock.windText.group,<tempB		add4	<InfoBlkPtr,#InfoBlock.windText.path,<tempC;---- Get the Access Priv. data ----		pha				; space for access result		pha		PushZLong <tempA		; ptr to owner string		PushZLong <tempB		; ptr to group string		PushZLong <tempC		; ptr to pathname		jsl	GetPrivileges		PullLong <tempC		bcc	which		brl	exit			; error		which		lda	IconType		and	#itOwner		beq	staticSetUp		brl	dynamicSetUpstaticSetUp;---- Update static owner & group name ----		lda	#idOwnerFld			; ID		ldy	#InfoBlock.windText.owner	; offset		jsr	NewTextField		lda	#idGroupFld			; ID		ldy	#InfoBlock.windText.group	; offset		jsr	NewTextField;---- Update privileges summary ----		add4	<InfoBlkPtr,#InfoBlock.windText.privilege,<tempA		PushWord #StringBase>>16		lda	<tempC		and	#$0007		asl	a		tax		lda	StringMap,x		pha		PushZLong <tempA		jsl	PToWString		lda	#idPrivilegeFld			; ID		ldy	#InfoBlock.windText.privilege	; offset		jsr	NewTextField		brl	exit;---- Update dynamic owner name ----dynamicSetUp		lda	<tempC		ldx	<tempC+2		jsr	SetAccessValues		lda	[<tempA]		; get length & move pointer up		tax		clc		lda	<tempA		adc	#2		sta	<tempA		lda	<tempA+2		adc	#0		sta	<tempA+2		PushZLong <tempA		; text pointer		phx				; text length		pha				; space for handle1		pha		pha				; space for handle2		pha		PushZLong <infoWinPtr		PushLong #idOwner		; ID		_GetCtlHandleFromID		_GetCtlTitle			; get editLine handle		_LESetText				lda	[<tempB]		; get length & move pointer		tax		clc		lda	<tempB		adc	#2		sta	<tempB		lda	<tempB+2		adc	#0		sta	<tempB+2		;---- Update dynamic group name ----		PushZLong <tempB		; text pointer		phx				; text length		pha				; space for handle1		pha		pha				; space for handle2		pha		PushZLong <infoWinPtr		PushLong #idGroup		; ID		_GetCtlHandleFromID		_GetCtlTitle			; get editLine handle		_LESetText		exit		rtsStringMap	DC.W	StrPriv0,StrPriv1,StrPriv2,StrPriv3		DC.W	StrPriv4,StrPriv5,StrPriv6,StrPriv7		ENDP		*===============================================**    Set Info title from Icon Object record.	**						** IN:	infoBlkPtr, iconObjPtr			** OUT:	none					**===============================================*SetInfoDates	PROC		IMPORT	DateToString		IMPORT	NewTextField		;---- get user's date format ----		lda	IconType		and	#itTrash		beq	notTrash		brl	exitnotTrash		pha		PushWord #$34			; Get date format		_ReadBParam		PullWord <tempA			; set date format bits				pha		PushWord #$35			; Get time format		_ReadBParam		pla		beq	ok0		lda	#$8000			; set 24 hour bitok0		ora	#$4000			; set use weekday bit		tsb	<tempA;---- Update modify date ----		add4	<iconObjPtr,#IconObject.mDate,<tempC		add4	<infoBlkPtr,#InfoBlock.windText.modify+1,<tempB		lda	#0		ldy	#InfoBlock.windText.modify		sta	[<infoBlkPtr],y		PushZLong <tempB			; ptr to destination string		PushZLong <tempC			; ptr to date record		PushWord <tempA			; date format		jsl	DateToString				ldy	#InfoBlock.windText.modify		lda	[<infoBlkPtr],y		xba					; cheap P to C1 conversion		sta	[<infoBlkPtr],y				lda	#idModifyFld			; ID		ldy	#InfoBlock.windText.modify	; offset		jsr	NewTextField;---- Update create date ----		add4	<infoBlkPtr,#InfoBlock.windText.create+1,<tempB		add4	<iconObjPtr,#IconObject.cDate,<tempC		lda	#0		ldy	#InfoBlock.windText.create		sta	[<infoBlkPtr],y		PushZLong <tempB			; ptr to destination string		PushZLong <tempC			; ptr to date record		PushWord <tempA				; date format		jsl	DateToString				ldy	#InfoBlock.windText.create		lda	[<infoBlkPtr],y		xba					; cheap P to C1 conversion		sta	[<infoBlkPtr],y		lda	#idCreateFld			; ID		ldy	#InfoBlock.windText.create	; offset		jsr	NewTextFieldexit		rts		ENDP				*===============================================**    Set Info title from Icon Object record.	**						** IN:	infoBlkPtr, iconObjPtr			** OUT:	none					**===============================================*SetInfoTitle	PROC		IMPORT	finderDPage		IMPORT	insertItemRef		IMPORT	wind_ref		IMPORT	addIWindow2Menu		IMPORT	removeMenuInfoItem				IMPORT	NameField:StatTextTemplate		IMPORT	PStringCat		IMPORT	PStringCopy		IMPORT	PToWString		IMPORT	PStrClip		IMPORT	strInfo1		; strings in string segment		IMPORT	strInfo2		IMPORT	strInfo3		IMPORT	strInfo4		IMPORT	tempStrg1;; update window title;		add4	<InfoBlkPtr,#InfoBlock.windtitle,<tempA		add4	<iconObjPtr,#IconObject.name,<tempB						PushLong #strInfo1		; source = '  Info on "'		PushZLong <tempA		; destination		jsl	PStringCopy				PushZLong <tempB		; source = icon name		PushZLong <tempA		; destination		jsl	PStringCat		PushLong #strInfo2		; source = '"  '		PushZLong <tempA		; destination		jsl	PStringCat		PushZLong <tempA		; ptr to title string		PushZLong <infoWinPtr		_SetWTitle;; update window's menu title field;		add4	<InfoBlkPtr,#InfoBlock.windMenuText,<tempA						PushLong #strInfo3		; source = 'Info on "'		PushZLong <tempA		; destination		jsl	PStringCopy				PushZLong <tempB		; source = icon name		PushZLong <tempA		; destination		jsl	PStringCat		PushLong #strInfo4		; source = '"'		PushZLong <tempA		; destination		jsl	PStringCat				ldy	#windMenuItem		;see if we already assigned a menu item		lda	[<infoBlkPtr],y		beq	@justAdd		;if we didn't just add it		lda	<infoBlkPtr		tax		lda	<infoBlkPtr+2		tay				phd		lda	>finderDPage		tcd		jsl	removeMenuInfoItem		pld@justAdd	lda	<infoBlkPtr		sta	>wind_ref				clc		adc	#windMenuText		sta	>insertItemRef+10		lda	<infoBlkPtr+2		sta	>wind_ref+2		adc	#0		sta	>insertItemRef+12		phd		lda	>finderDPage		tcd		jsl	addIWindow2Menu		;add the trash to the windows menu		pld;; update icon name field;		add4	<InfoBlkPtr,#InfoBlock.windText.name,<tempA				PushZLong <tempB		; source = icon name		PushLong #tempStrg1		lda	NameField.rect+x2		sec		sbc	NameField.rect+x1		pha				; pixel width		jsl	PStrClip		; clip to pixel width				PushLong #tempStrg1		PushZLong <tempA			; destination		jsl	PToWString		lda	#idNameFld			; ID		ldy	#InfoBlock.windText.name	; offset		jsr	NewTextField		rts		ENDP		*===============================================**    Get Icon Type form its attributes		**						** IN:	iconObjPtr				** OUT:	IconType				**===============================================*GetIconType	PROC				stz	IconTypeisNetwork	ldy	#IconObject.flag+2		lda	 [<iconObjPtr],y		and	#icNetWork>>16		beq	isVolume		lda	#itNetwork		tsb	IconType		isVolume	ldy	#IconObject.fileType		lda	 [<iconObjPtr],y		bpl	isFolder		cmp	#$FFF9		beq	trashy		cmp	#$FFFE		bcc	conttrashy		lda	#itTrash		tsb	IconType				bra	exitcont		lda	#itVolume		tsb	IconType		bra	isOwnerisFolder	cmp	#$000F		bne	isDriver		lda	#itFolder		tsb	IconType		isOwner		ldy	#IconObject.flag+2		lda	 [<iconObjPtr],y		and	#$0008		beq	isDriver		lda	#itOwner		tsb	IconType		bra	exit		isDriver	ldy	#IconObject.fileType		lda	 [<iconObjPtr],y;*** added 1-Oct-92 DAL -- filetypes $38-3F can be inactive (6.0.1);		cmp	#$38;		bcc	exit;		cmp	#$3F+1;		bcc	good;*** end 1-Oct-92;		cmp	#$CA			;we also do finder icon files;		beq	good			;		cmp	#$C7			;we also do CDev files;		beq	good;		cmp	#$B6			;$B6  ▓ FileType ▓ $BD  ?;		bcc	exit;		cmp	#$BD+1;		bcs	exit;		cmp	#$BA			;we don't do tool files;		beq	exit;*** commented out following 2 lines 16-Apr-91 DAL so we can inactivate $BC files;;		cmp	#$BC			; we don't do generic load files;;		beq	exit*** added 1-Oct-92 DAL		import FiFiFiSearch		ldx #$ffff		txy		;impossible auxtype (match only generic filetype)		jsl FiFiFiSearch		tya		;Y = flags		lsr a		bcc exit	;bit 0 set --> can be inactive*** end 1-Oct-92good		lda	#itDriver		tsb	IconType		exit		rts		ENDP		*===============================================**	Set Access values for Pop Ups		**						** IN:	infoBlkPtr, infoWinPtr,access (a,x-reg)	**						** OUT:	none					**===============================================*SetAccessValues	PROC		sta	Access		stx	Access+2;---- map access settings to pop-up values ----				ldy	#0loop1		stz	Value		lda	Access+1		; get the everyone setting		and	Mask,y		beq	chkOwner		lda	#4		tsb	Value			; set bit 2		bra	saveValue		; all done since everyone overrideschkOwner	lda	Access+3		; get the owner setting		and	Mask,y		beq	chkGroup		lda	#1		tsb	Value			; set bit 0		chkGroup	lda	Access+2		; get the group setting		and	Mask,y		beq	saveValue		lda	#2		tsb	Value			; set bit 1		saveValue	lda	Value		inc	a			; make it 1 relative		sta	PopValues,y		iny		iny		cpy	#2*3		bcc	loop1;---- now match setting to a class ----				ldx	#0		ldy	#2loop2		lda	PopValues		; check if settings match		cmp	Settings,x		bne	next		lda	PopValues+2		cmp	Settings+2,x		bne	next		lda	PopValues+4		cmp	Settings+4,x		beq	matchnext		iny		txa		clc		adc	#6		tax		cpx	#4*6		bcc	loop2		ldy	#1			; else, use custommatch		sty	PopValues+6;---- update our data structures ----		sep	#$10		ldx	<infoBlkPtr+2		phx		plb		rep	#$10		ldy	<infoBlkPtr				ldx	#0@loop3		phy		phx		lda	>PopValues,x		sta	|InfoBlock.PopValue,y	; update our record		sta	|InfoBlock.PopDefault,y		pha				; new value		pha				; space for handle		pha		PushZLong <infoWinPtr		pea	$0000			; hi word of ID		lda	>IDs,x		pha				; lo word of ID		_GetCtlHandleFromID		_SetCtlValue			; update control's record		plx		ply		iny		iny		inx		inx		cpx	#4*2		bcc	@loop3		phk		plb		rts		PopValues	DS.W	4Access		DS.L	1Value		DS.W	1Mask		DC.W	1,2,4			;see folder, see file, make changes		ENDP		*===============================================**	Get Access values from Pop Ups		**						** IN:	infoBlkPtr, iconObjPtr			**						** OUT:	access (a,x-reg)			**===============================================*GetAccessValues	PROC;---- Get data from our data structures ----		ldx	#0		ldy	#InfoBlock.PopValue		@loop1		lda	[<infoBlkPtr],y		; look at our record		dec	a			; make it 0 relative		sta	PopValues,x		iny		iny		inx		inx		cpx	#3*2		bcc	@loop1;---- map pop-up values to access settings ----				stz	Access		stz	Access+2				ldy	#0loop2		lda	PopValues,y		; check if owner has access		and	#$0001		beq	chkGroup		; no		lda	Mask,y		tsb	Access+3		; set owner bits chkGroup	lda	PopValues,y		; check if group has access		and	#$0002		beq	chkEveryone		; no		lda	Mask,y		tsb	Access+2		; set group bits 		chkEveryone	lda	PopValues,y		; check if everyone has access		and	#$0004		beq	next			; no		lda	Mask,y		tsb	Access+1		; set everyone bits 		next		iny		iny		cpy	#2*3		bcc	loop2;		ldy	#IconObject.access+2;		lda	[<iconObjPtr],y;		and	#$F000			; mask out user's access bits;		ora	Access			; add in new settings;		sta	[<iconObjPtr],y		lda	Access		ldx	Access+2		rts		PopValues	DS.W	4Access		DS.L	1Value		DS.W	1Mask		DC.W	1,2,4			;see folder, see file, make changes		ENDP		*===============================================** Calculate the size occupied by a folder	**===============================================*CalculateSize	PROCPREF_HDATA	equ	$0010				; TRUE to hide invisible files		IMPORT	Prefer		IMPORT	SizeToString		IMPORT	NewTextField		IMPORT	WalkDirectory		IMPORT	PStringCat		IMPORT	PtoWString		IMPORT	PStringCopy		IMPORT	GetFSTBlockSize		IMPORT	strBytesUsed			; in string segment		IMPORT	strOnDisk		IMPORT	strFiles		IMPORT	strFolders		IMPORT	strFile				; variations on a string		IMPORT	strFolder		IMPORT	strAccFolder		IMPORT	strAccFolders		IMPORT	strCalculating		IMPORT	strPressCalc			;18-Mar-93 JCM				IMPORT	SetInfoContent			;18-Mar-93 JCM		*===============================================*		stz	OKAccess		add4	<InfoBlkPtr,#InfoBlock.windText.content,<tempA		PushLong #strCalculating		PushZLong <tempA		jsl	PtoWString			; display "Calculating..."			lda	#idContentFld			; ID		ldy	#InfoBlock.windText.content	; offset		jsr	NewTextField		lda	IconType			; don't calc size if volume		and	#itVolume		bne	cont		add4	<InfoBlkPtr,#InfoBlock.windText.size,<tempA		PushLong #strCalculating		PushZLong <tempA		jsl	PtoWString			; display "Calculating..."			lda	#idSizeFld			; ID		ldy	#InfoBlock.windText.size	; offset		jsr	NewTextFieldcont		lda	<InfoBlkPtr		clc		adc	#InfoBlock.windText.path		tax		lda	<InfoBlkPtr+2		adc	#0		pha					; ptr to pathname - MSW		phx					; ptr to pathname - LSW		PushZPtr <tempA				; ptr to folder count		PushZPtr <tempB				; ptr to file count		lda	IconType			; don't calc size if volume		and	#itVolume		beq	needSize			*** Ick! - 18-Mar-93 JCM;;;		PushLong #0				; don't want block count;;;		PushLong #0				; don't want byte count		lda	#0		pha		pha		pha		pha*** End - 18-Mar-93 JCM		bra	prefneedSize	PushZPtr <tempC				; ptr to block count		PushZPtr <tempD				; ptr to byte countpref		lda	>prefer				; get user's preference		and	#PREF_HDATA		eor	#PREF_HDATA		pha					; flag н 0: count invisible files		jsl	WalkDirectory		bcc	ok	*** Added - 18-Mar-93 JCM - Did the user terminate the calculate?			cmp	#$4000				;user terminated with OA-.		beq	@OAPeriodHit	*** End - 18-Mar-93 JCM			inc	OKAccess			; was it an accessiblity problem?		cmp	#$8000		beq	ok				; yes				add4	<InfoBlkPtr,#InfoBlock.windText.size,<tempA		PushLong #strBadSize		PushZLong <tempA		jsl	PtoWString			; use "(not enought Privileges)"			brl	set*** Added - 18-Mar-93 JCM - The user hit command-period to kill the calculate. Now we***			    need to reset the field or fields back to "use calculate icon...".@OAPeriodHit	lda	IconType			;size is ok for volumes		and	#itVolume		bne	@setContents		add4	<InfoBlkPtr,#InfoBlock.windText.size,<tempA		PushLong #strPressCalc			; "use calculate icon..."		PushZLong <tempA		jsl	PToWString				lda	#idSizeFld			; ID		ldy	#InfoBlock.windText.size	; offset		jsr	NewTextField@setContents	jsr	SetInfoContent				rts		*** End - 18-Mar-93 JCM		;--- Convert numbers to ascii --------------------------ok		PushLong #blockStr			; get block count in ascii		PushZLong <tempC		pea	2				; type = K		ldy	#IconObject.fst		lda	[<iconObjPtr],y		jsl	GetFSTBlockSize		pha				jsl	SizeToString		PushLong #fileStr			; get file count in ascii 		PushZLong <tempB		pea	0				; type = plain		pea	512				; blocksize (doesn't matter)		jsl	SizeToString		PushLong #folderStr			; get folder count in ascii 		PushZLong <tempA		pea	0				; type = plain		pea	512				; blocksize (doesn't matter)		jsl	SizeToString;--- make size string ----------------------------------		lda	IconType			; don't calc size if volume		and	#itVolume		bne	content		lda	#0		ldy	#InfoBlock.windText.size		sta	[<InfoBlkPtr],y			; set string length to zero		add4	<InfoBlkPtr,#InfoBlock.windText.size+1,<tempC		PushZLong <tempC				; get byte count in ascii		PushZLong <tempD		pea	1				; type = byte		pea	512				; blocksize (doesn't matter)		jsl	SizeToString		PushLong #strBytesUsed			; add " used, "		PushZLong <tempC		jsl	PStringCat				PushLong #blockStr			; add block count		PushZLong <tempC		jsl	PStringCat		PushLong #strOnDisk			; add " on disk"		PushZLong <tempC		jsl	PStringCat		ldy	#InfoBlock.windText.size		lda	[<InfoBlkPtr],y		xba					; cheap P to W conversion		sta	[<InfoBlkPtr],y				lda	#idSizeFld			; ID		ldy	#InfoBlock.windText.size	; offset		jsr	NewTextField;--- Get content string ---content		lda	#0		ldy	#InfoBlock.windText.content		sta	[<InfoBlkPtr],y			; set string length to zero		add4	<InfoBlkPtr,#InfoBlock.windText.content+1,<tempC		PushLong #fileStr			; add file count		PushZLong <tempC		jsl	PStringCopy		PushWord #strFiles>>16			; push string bank		lda	<tempB+2			; is file count = 1 ?		bne	pluarl2		lda	<tempB		cmp	#1		bne	pluarl1		lda	 #strFile			; add "file, "		bra	cont1pluarl1		lda	 #strFiles			; add "files, "cont1		pha		PushZLong <tempC		jsl	PStringCat		PushLong #folderStr			; add folder count		PushZLong <tempC		jsl	PStringCat		PushWord #strFolders>>16		; push string bank		lda	<tempA+2			; is folder count = 1 ?		bne	pluarl2		lda	<tempA		cmp	#1		bne	pluarl2		lda	OKAccess			; any access problems?		beq	singular2		lda	 #strAccFolder			; add " folder accessible"		bra	cont2singular2	lda	 #strFolder			; add " folder"		bra	cont2pluarl2		lda	OKAccess			; any access problems?		bne	access		lda	 #strFolders			; add " folders"		bra	cont2access		lda	 #strAccFolders			; add " folders accessible"cont2		pha		PushZLong <tempC		jsl	PStringCatconvert		ldy	#InfoBlock.windText.content		lda	[<InfoBlkPtr],y		xba					; cheap P to W conversion		sta	[<InfoBlkPtr],y		set		lda	#idContentFld			; ID		ldy	#InfoBlock.windText.content	; offset		jsr	NewTextField		rtsblockStr	DS.B	16fileStr		DS.B	16folderStr	DS.B	16OKAccess	DC.W	0		STRING	PASCALstrBadSize	DC.B	'(encountered file system errors)'		ENDP		*===============================================**	Redraw the Icon's Lock			**						** IN:	a,x = iconObjPtr			** OUT:	none					**===============================================*RedrawIconLock	PROC		IMPORT	finderDPage		IMPORT	FixIconLock		tay				; temp save of a-reg				phd				; glue to "Bad" code		lda	>finderDPage		tcd		tya				; a,x = iconObjPtr		jsl	FixIconLock		pld		rts				ENDP		END