;.....................................................................;; File:		GetInfo.aii			; Project:	GS Finder			; Author:	Don J. Brady			; Build file:	Finder.Make			;						; й Copyright Apple Computer, Inc. 1988-1993; All rights reserved.				;						; Global Routines:				;	UpdateInfoWin(iconBlkHand, pathPtr)	;	NewInfoWindow(iconBlkHand, pathPtr)	;	InfoControls(winPtr,hand,part,id)	;	AboutWindow()				;; Modification History:				; 10/11/88 DJB	- File created today		;						; Spring, 1991 -- ripped up and reworked everything for resources;		  andy;; Spring, 1992 -- Dave Lyons wuz here.;;; 17-Feb-93 -- Jim Murphy wuz here too, stuck in code to show SCSI IDs and left quickly.;              This stuff is icky! :-);; 18-Mar-93 JCM - We now erase kind strings before setting to a new string so we don't;	    	  have any bits of the old string remaining if it's longer.;; 18-Mar-93 JCM - Pressing command-period during a folder or disk size calculation now;		  terminates the process cleanly.;; 21-Mar-93 JCM - We now allow comment cards for all file types if the file was already;		  extended. Otherwise, with types $FF, $F9, and $BD, we still don't allow;		  us to extend the file by adding a comment. This allows files like;		  Sys.Resources to show their version info, for example.;; 21-Mar-93 JCM - Just to be safe, I've moved my 17-Feb-93 SCSI ID code so we only call it;		  if we're sure the icon we're dealing with is a volume. Before we would;		  rely on the devNum field being zero for non-volumes icons, and I'm not sure;		  that we can. In any case, I saved 5 bytes.;; 24-Mar-93 JCM - Added some code to dynamically resize the real name control's rect to;		  account for the Inactive check box's existance. I also set a new bit in;		  the same control's flags field to draw the stat text via DrawStringWidth;		  if need be. Now we clip the strings to look cool if they're too long.;;.....................................................................		LONGA	ON		LONGI	ON		STRING	PASCAL				PRINT	OFF				PRINT	NOGEN		PRINT	NOSYM		INCLUDE	'ALL.MACROS'		INCLUDE	'E16.CONTROL'		INCLUDE	'E16.WINDOW'		include 'e16.resources'		INCLUDE	'PASCAL.macros'		INCLUDE	'special.macros'		INCLUDE	'resource.equ'		MaxFileName	equ	31MaxPathLen	equ	1022-MaxFileName		INCLUDE	'windowBlk.equ'		INCLUDE	'IconObj.equ'		INCLUDE	'GetInfo.equ'Move_Info	equ	$e10200		PRINT	ON				seg 'INFO'		import DisposeHandleGlue	;--- strings in string segment that we use -----		IMPORT	strGeneral		; strings in string segment		IMPORT	strWhere		IMPORT	strAccess		IMPORT	strComment		IMPORT	strApply		IMPORT	strApplyAll		IMPORT	strCalculate		IMPORT	strAddComment		IMPORT	nullStrg		IMPORT	strgOK		IMPORT	strOwner		IMPORT	endOwner		IMPORT	strGroup		IMPORT	endGroup		IMPORT	strPrivileges		IMPORT	endPrivileges		IMPORT	strLocked		IMPORT	endLocked		IMPORT	strInactive		IMPORT	endInactive		IMPORT	strKind		IMPORT	endKind		IMPORT	strSize		IMPORT	endSize		IMPORT	strContents		IMPORT	endContents		IMPORT	strVersion		IMPORT	endVersion		IMPORT	strCreated		IMPORT	endCreated		IMPORT	strModified		IMPORT	endModified		IMPORT	strPath		IMPORT	endPath		IMPORT	strDevice		IMPORT	endDevice		IMPORT	strServer		IMPORT	endServer		IMPORT	strZone		IMPORT	endZone		IMPORT	trashText		IMPORT	endTrashText		IMPORT	driveText		IMPORT	endDriveTextIconButtonTemplate RECORD  0pCount		ds.w  1		;parameter count (7)ID		ds.l  1		;ID for the control Rect		ds.w  4		;bounding rectangleProcRef		ds.L  1		;ButtonControl = $8D000000Flag		ds.w  1		;old style flag wordMoreFlags	ds.w  1		;bit 0 refers to PicRef (0 handle, 1 resource)RefCon		ds.l  1		;application definedIconRef		ds.L  1		;handle or resourceTitleRef	ds.L  1		;handle or resourceColorRef	ds.L  1		;handle or resourceDisplayMode	ds.w  1		;		ENDR*===============================================** Direct Page Work Space Used by All Routines	**===============================================*		DSECT	1iconObjPtr	longinfoBlkPtr	longinfoWinPtr	longtempA		longtempB		longtempC		longtempD		longtempE		longworkSpace	DSectSizeworkSize	EQU	workSpace-1*===============================================**	drawing offsets for info window		**===============================================*y1		equ	0x1		equ	y1+2y2		equ	x1+2x2		equ	y2+2cDY		equ	102cDX		equ	416-20cY1		equ	0cY2		equ	cY1+cDYcX1		equ	2cX2		equ	cX1+cDXtW		equ	80			;tab widthtH		equ	10			;tab heighttS		equ	6			;tab spacesp		equ	18			;edge spacingwDY		equ	cY2+tH+1wDX		equ	cX1+cX2infoY1		equ	20infoY2		equ	infoY1+wDYinfoX1		equ	4infoX2		equ	infoX1+wDXbY2		equ	cY2-4			;button end YbY1		equ	bY2-12			;button start YpY3		equ	bY1-3-14		;start of 3rd pop uppY2		equ	pY3-14			;start of 2nd pop uppY1		equ	pY2-14			;start of 1st pop uppX		equ	178-40;gX		equ	85gY1		equ	cY1+34			;start of first general card stringgY2		equ	gY1+11			;  "    "   2nd    "      "     "gY3		equ	gY2+20			;  "    "   3rd    "      "     "gY4		equ	gY3+11			;  "    "   4th    "      "     "gY5		equ	gY4+11			;  "    "   5th    "      "     ";wX1		equ	85;wX2		equ	wX1+15wY1		equ	cY1+20			;start of 1st where card stringwY2		equ	wY1+11			;  "    " 2nd   "     "     "wY3		equ	wY2+15			;  "    " 3rd   "     "     "eY1		equ	cY1+10			;start of first edit lineeY2		equ	eY1+13			;end of first edit lineeY3		equ	eY2+1			;start of second edit lineeY4		equ	eY3+13			;end of second edit lineitFolder	equ	$01			;icon type attribute bitsitVolume	equ	$02itNetwork	equ	$04itOwner		equ	$08itDriver	equ	$10itTrash		equ	$80midCustom	equ	1			;pop up menu IDsmidPrivate	equ	2midPublic	equ	3midDropBox	equ	4midBulletin	equ	5midNobody	equ	1midOwner	equ	2midGroup	equ	3midOwnerGroup	equ	4midEveryone	equ	5;-----------------------------------------------ret		equ	13Point		RECORD	0;-----------------------------------------------v		DS.W	1h		DS.W	1 ;-----------------------------------------------		ENDR Rect		RECORD	0			;QuickDrawII rectangle record;-----------------------------------------------top		DS.W	1left		DS.W	1 bottom		DS.W	1right		DS.W	1sizeOf;-----------------------------------------------		ENDR LocInfo		Record	0;-----------------------------------------------portSCB		ds.W	1image		ds.L	1width		ds.W	1boundsRect	ds	rect;-----------------------------------------------		ENDR TaskRecord	Record	0;-----------------------------------------------what		DS.W	1message		DS.L	1when		DS.L	1where		DS	Pointmodifiers	DS.W	1taskData	DS.L	1taskMask	DS.L	1lastClickTick	DS.L	1clickCount	DS.W	1taskData2	DS.L	1taskData3	DS.L	1taskData4	DS.L	1lastClickPt	DS	PointsizeOf;-----------------------------------------------		ENDR Date		RECORD	0			;GS/OS date record;-----------------------------------------------second		DS.B	1minute		DS.B	1 hour		DS.B	1year		DS.B	1day		DS.B	1month		DS.B	1 null		DS.B	1weekday		DS.B	1;-----------------------------------------------		ENDR ParamList	RECORD	0			; Window;-----------------------------------------------paramLength	DS.W	1 wFrameBits	DS.W	1wTitle		DS.L	1wRefCon		DS.L	1wZoom		DS	RectwColor		DS.L	1wYOrigin	DS.W	1wXOrigin	DS.W	1wDataH		DS.W	1wDataW		DS.W 	1wMaxH		DS.W	1wMaxW		DS.W	1wScrollVer	DS.W	1wScrollHor	DS.W	1wPageVer	DS.W	1wPageHor	DS.W	1wInfoRefCon	DS.L	1wInfoHeight	DS.W 	1wFrameDefProc	DS.L	1wInfoDefProc	DS.L	1wContDefProc	DS.L	1wPosition	DS	RectwPlane		DS.L	1wStorage	DS.L	1;-----------------------------------------------		ENDR CardTemplate	RECORD  0;----------------------------------------------pCount		DS.W	1id		DS.L	1rect		DS	RectprocRef		DS.L	1flag		DS.W	1moreFlags	DS.W	1refCon		DS.L	1value		DS.W	1count		DS.W	1tabHeight	DS.W	1tabWidth	DS.W	1tabSpace	DS.W	1colorRef	DS.L	1cardRef		DS.L	1;-----------------------------------------------		ENDRIconObject	RECORD	0;-----------------------------------------------next		DS.L	1			; handle of next iconlast		DS.L	1			; handle of previous iconmom		DS.L	1			; window icon belongs towindow		DS.L	1			; window icon is opened intodisk		DS.L	1			; disk icon which is the root of this evil iconflag		DS.L	1			; icon's attributesfileType	DS.W	1			; icon's file typefileInfo	DS.L	1			; icon's Aux_Type or File_Systemkind		DS.L	1			; PTR to icon's kind stringpoint		DS	Point			; icon's position (bottom right)textY		DS.W	1			; text's y position (view by text)titleLen	DS.W	1			; half the length of icon's titlename		DS.B	34			; icon's name (string)localAccess	ds.W	1			; icon's local accessextended	ds.W	1			; is icon extended?fileBlocks	DS.L	1			; icon's file block sizefileBytes	DS.L	1			; icon's file byte sizecDate		DS	Date			; icon's file creation datemDate		DS	Date			; icon's file modification dateicon		ds.L	1			; handle to iconsmallIcon	ds.L	1			; handle to small iconrBundle		ds.L	1			; handle to rBundle resourceOneDocOffset	ds.L	1			; offset in rBundle to OneDocinfoWin		DS.L	1			; pointer to Info window (or zero)devNum		DS.W	1			; icon's device numberdevInfo		ds.W	1			;device characteristics if a device iconOptionList	ds.b	2			;option listfst		ds.b	38			;fst inside option_listNetworkAccess	ds.L	1			;network access for icon;-----------------------------------------------		ENDR ; misc equates;.....................................................................InfoWindID	equ	$0010			; Info window's id (for closing)iDataBig	equ	86			; offset to icon data; locals;.....................................................................LocalData	PROC		IMPORT	CardCtrlProc		IMPORT	DrawInfoWindow		IMPORT	DrawAboutWindow				ENTRY	GetLockDeviceGetLockDevice	dc.w	8		;pcount		dc.w	0		;devNum		dc.L	nameBuffer	;output name buffer		dc.w	0		;characteristics		dc.L	0		;total blocks		dc.w	0		;slot number		dc.w	0		;unit number		dc.w	0		;version		dc.w	0		;device ID		nameBuffer	dc.w	35		ds.b	33		ENTRY	GetLockParmsGetLockParms	dc.w	5		;pcount		dc.w	0		;devnum		dc.w	$f001		;code, GetConfig		dc.L	getControlList			dc.L	2		;request_count		dc.L	0		;transfer_count				ENTRY	getControlListgetControlList	dc.w	0		;get write protect status				ENTRY	SetLockParmsSetLockParms	dc.w	5		;pcount		dc.w	0		;devnum		dc.w	$f001		;code		dc.L	setControlList			dc.L	2		;request_count		dc.L	0		;transfer_count				ENTRY	setControlListsetControlList	dc.w	$0130		;clear write protect status*** Added - 17-Feb-93 JCM - for getting the SCSI ID for the Where card		ENTRY	GetSCSITargetPriorityGetSCSITargetPriority	dc.w	5		;pcount		dc.w	0		;devnum		dc.w	$4000		;code, GetSCSITargetPriority		dc.L	SCSIPriority			dc.L	2		;request_count		dc.L	0		;transfer_count		ENTRY	SCSIPrioritySCSIPriority	dc.w	0		;for target priority*** End - 17-Feb-93 JCM		ENTRY	theHandletheHandle	DC.L	0		ENTRY	InfoWinParamInfoWinParam	DC.W	InfoWinEnd-InfoWinParam		DC.W	fTitle+fClose+fMove+fVis+fHilited		DC.L	nullStrg		; Ptr to title		DC.L	0			; RefCon		DC.W	0,0,0,0			; Full Size (0= default)		EXPORT	InfoWinColorTablePtrInfoWinColorTablePtr 				DC.L	0			; Color Table Pointer		DC.W	0			; Vertical origin		DC.W	0			; Horizontal origin		DC.W	200			; RECORD Area Height		DC.W	640			; RECORD Area Width		DC.W	200			; Max Cont Height		DC.W	640			; Max Cont Width		DC.W	0			; pixels to scroll vertically		DC.W	0			; pixels to scroll horizontally		DC.W	0			; pixels to page vertically		DC.W	0			; pixels to page horizontally		DC.L	0			; Infomation bar text string		DC.W	0			; Info bar height	  		DC.L	0			; DefProc		DC.L	0			; Routine to draw info. bar		DC.L	DrawInfoWindow+$80000000 ; Routine to draw content		DC.W	60,70,60+wDY,70+wDX	; Size/pos of content 		DC.L	$FFFFFFFF		; Plane to put window up in		DC.L	0			; Address for window recordInfoWinEnd		ENTRY	TempRectTempRect	ds.b	8			;it's a rect		bColor		equ	$EEEE		ENTRY	Pattern3Pattern3	DC.W	bColor			; 8 x 8 color pattern		DC.W	bColor		DC.W	bColor		DC.W	bColor		DC.W	bColor		DC.W	bColor		DC.W	bColor		DC.W	bColor		ENTRY	BlackPatternBlackPattern	DC.W	$0000			; 8 x 8 black pattern		DC.W	$0000		DC.W	$0000		DC.W	$0000		DC.W	$0000		DC.W	$0000		DC.W	$0000		DC.W	$0000		ENTRY	IconTypeIconType	DC.W	0		ENTRY	GeneralCardGeneralCard	DC.L	strGeneral		DC.L	idIconButton		DC.L	idNameFld		; controls on General card		DC.L	idKindStr		DC.L	idKindFld		DC.L	idSizeStr		DC.L	idSizeFld		DC.L	idCreateStr		DC.L	idCreateFld		DC.L	idModifyStr		DC.L	idModifyFld		DC.L	idLockedStr		DC.L	idLocked		DC.L	0		ENTRY	VerGeneralCardVerGeneralCard	DC.L	strGeneral		DC.L	idIconButton		DC.L	idNameFld		; controls on 'Version' General card		DC.L	idRealNameFld		DC.L	idKindStr		DC.L	idKindFld		DC.L	idSizeStr		DC.L	idSizeFld		DC.L	idCopyrightFld		DC.L	idCreateStr		DC.L	idCreateFld		DC.L	idModifyStr		DC.L	idModifyFld		DC.L	idLockedStr		DC.L	idLocked		DC.L	0		ENTRY	InVerGeneralCardInVerGeneralCard DC.L	strGeneral		DC.L	idIconButton		DC.L	idNameFld		; controls on 'Version' General card		DC.L	idRealNameFld		; which can have an inactive check box also		DC.L	idKindStr		DC.L	idKindFld		DC.L	idSizeStr		DC.L	idSizeFld		DC.L	idCopyrightFld		DC.L	idCreateStr		DC.L	idCreateFld		DC.L	idModifyStr		DC.L	idModifyFld		DC.L	idLockedStr		DC.L	idLocked		DC.L	idInactiveStr		DC.L	idInactive		DC.L	0		ENTRY	DrvGeneralCardDrvGeneralCard	DC.L	strGeneral		DC.L	idIconButton		DC.L	idNameFld		; controls on "driver" General card		DC.L	idKindStr		DC.L	idKindFld		DC.L	idSizeStr		DC.L	idSizeFld		DC.L	idCreateStr		DC.L	idCreateFld		DC.L	idModifyStr		DC.L	idModifyFld		DC.L	idLockedStr		DC.L	idLocked		DC.L	idInactiveStr		DC.L	idInactive		DC.L	0		ENTRY	VolGeneralCardVolGeneralCard	DC.L	strGeneral		DC.L	idIconButton		DC.L	idNameFld		; controls on volume General card		DC.L	idKindStr		DC.L	idKindFld		DC.L	idSizeStr		DC.L	idSizeFld		DC.L	idContentStr		DC.L	idContentFld		DC.L	