/ Desk Manager		 6,$0300,	// Event Manager		14,$0303,	// Window Manager		15,$0303,	// Menu Manager		16,$0303,	// Control Manager		18,$0304,	// QD Aux		20,$0303,	// Line Edit		21,$0304,	// Dialog Manager		22,$0301,	// Scrap Manager		28,$0303,	// List Manager		27,$0303,	// Font Manager		34,$0103	// Text Edit	}};// --- rFinderExtension resourcesread rFinderExtension (1,Convert,locked)  ":KeyboardNav:KeyboardNavRsrc";// --- rPString Templatesresource rPString (PSTR_0000000A, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "  Extras  "};// --- rCString menu stringsresource rCString(2,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--@\\XN300\n"	">>About This Apple IIgs...\\N301\n"	">>Help\\N302*?/\n"	">>-\\DN65534\n"	"."};resource rCString(3,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--  File  \\DN350\n"	">>New Folder\\DN351*Nn\n"	">>Open\\DN352*Oo\n"	">>Print\\DN353\n"	">>Close\\DN354*Ww\n"	">>Close All\\DN355\n"	">>-\\DN65534\n"	">>Duplicate...\\DN356*Dd\n"	">>Put Away\\DN357*Yy\n"	">>Validate\\DN358\n"	"."};resource rCString(4,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--  Edit  \\N400\n"	">>Undo\\DN250*Zz\n"	">>-\\DN65534\n"	">>Cut\\DN251*Xx\n"	">>Copy\\DN252*Cc\n"	">>Paste\\DN253*Vv\n"	">>Clear\\DN254\n"	">>Select All\\N401*Aa\n"	">>-\\DN65534\n"	">>Show Clipboard\\N402\n"	"."};resource rCString(5,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--  Windows  \\DN450\n"	">>Stack Windows\\DN451\n"	">>-\\DN452\n"						// this dividing line ID is important	">>No Finder Windows\\DN453\n"	"."};resource rCString(6,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--  View  \\DN500\n"	">>by Icon\\DN501\n"	">>by Small Icon\\DN502\n"	">>-\\DN65534\n"	">>by Name\\DN503\n"	">>by Date\\DN504\n"	">>by Size\\DN505\n"	">>by Kind\\DN506\n"	"."};resource rCString(7,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--  Disk  \\DN550\n"	">>Initialize...\\DN551\n"	">>Erase...\\DN552\n"	">>Verify\\DN553\n"	">>-\\DN65534\n"	">>Eject\\DN554*Ee\n"	"."};resource rCString(8,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--  Special  \\N600\n"	">>Clean Up\\N601\n"	">>Empty Trash\\DN602*Tt\n"	">>Preferences...\\N603\n"	">>-\\DN65534\n"	">>Icon Info...\\DN604*Ii\n"	">>-\\DN65534\n"	">>Shut Down\\N605*Qq\n"	"."};resource rCString(9,locked,fixed,nocrossbank,preload,noSpecialMemory) {	"--  Colors  \\DN650\n"	"."};// No Finder Windows stuffresource rMenuItem (MENUITEM_00000015, Locked, Fixed, Preload, noSpecialMemory) {       453,                    // itemID       "","",                  // itemChar, itemAltChar       NIL,                    // itemCheck       $8080,                  // itemFlag       PSTR_0000001E           // itemTitleRef};resource rPString (PSTR_0000001E, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "No Finder Windows"};// Clean Up stuffresource rPString (PSTR_00000029, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "Clean Up"};resource rPString (PSTR_0000002E, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "Clean Up by Name"};//// --- strings we use *A LOT*//resource rPString (PSTR_000000F9, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "Stop"};resource rPString (PSTR_000000FA, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "Skip"};resource rPString (PSTR_000000FB, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "Replace"};resource rPString (PSTR_000000FC, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       ""};resource rPString (PSTR_000000FD, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "Accept"};resource rPString (PSTR_000000FE, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "Cancel"};resource rPString (PSTR_000000FF, Locked, Fixed, NoCrossBank, Preload, noSpecialMemory) {       "OK"};//// -- rPStrings for misc stuff in the finder (Trash, Clip, About)//// These don't need to be preloaded, but they need to be nailed down because// we attempt to move them someplace safe in memory once we load them.  The// largest size for each string is 31 characters.//// Actually, they don't need to be nailed down because we use pStringCopy to// move them to their final resting spot and then dispose of them immediately//resource rPString (PSTR_00000100, Preload) {       "  About This Apple IIgs  "};resource rPString (PSTR_00000101, Preload) {       "About This Apple IIgs"}; resource rPString (PSTR_00000102, Preload) {       "  Trash  "};resource rPString (PSTR_00000103, Preload) {       "Trash"};resource rPString (PSTR_00000104, Preload) {       "  Clipboard  "};resource rPString (PSTR_00000105, Preload) {       "Clipboard"};resource rPString (PSTR_00000106, Preload) {       "  Finder Help  "};resource rPString (PSTR_00000107, Preload) {       "Finder Help"};resource rPString (PSTR_00000108, Preload) {       "  Bad Blocks On “”"};resource rPString (PSTR_00000109, Preload) {       "Bad Blocks On “”"};resource rPString (PSTR_0000010A, Preload) {       "  Damaged Files In “”"};resource rPString (PSTR_0000010B, Preload) {       "Damaged Files In “”"};// -- rPstring for SFGetFile promptresource rPString (PSTR_00000200, $0000) {       "Where is this application located?"};resource rPString (PSTR_00000201, $0000) {       "Launch which application for this document?"};// --- Menu Definitions// Extras menuresource rMenu (MENU_00000009, Locked, Fixed, Preload, noSpecialMemory) {       1000,                  	// menuID       $A008,                  	// menuFlag       PSTR_0000000A, {        	// menuTitleRef       };};// --- rVersion templatesresource rVersion(1,locked, fixed, preload, noSpecialMemory) {	{ 	  $6,				/* major version in BCD */	  $0,				/* minor version in BCD */	  $1,				/* bug version		    */	  release,	  $00,				/* # */	 },	verUS,	"Finder",	"Copyright 1987-93, Apple Computer, Inc."};// -- rComment templateresource rComment(1,0) { 	"The Apple IIGS Finder"	"\$0d"	"\$0d"	"by Jim Murphy, Andy Nicholas, and Dave Lyons with special thanks to those who have walked "	"this path..."	"\$0d"	"\$0d"	"Ron Lichty, Don J. Brady, Jim Merritt, Steve Glass, Mensch, "	"Matt Deatherage, Andy Stadler, Cheryl Ewy, and Dan Oliver"};// -- rWindColor resourceresource rWindColor(1,locked,fixed,preload) {		$0000,				$0F00,									// default folder colors		$020F,		$F0F0,		$00F0};resource rWindColor(2,locked,fixed,preload) {		$0000,				$0F00,									// default getinfo colors		$020F,		$F0F0,		$00F0};// -- rRectList resourceresource rRectList(1,locked,fixed,preload) {  {	{ 39, 14,103,358},		/* first default window position 	*/	{ 49, 24,113,368},		/* second default window position 	*/	{ 59, 34,123,378},		/* third default window position 	*/	{ 69, 44,133,388},		/* fourth default window position 	*/	{ 79, 54,143,398},		/* fifth default window position 	*/	{ 89, 64,153,408},		/* sixth default window position 	*/	{ 99, 74,163,418},		/* seventh default window position 	*/	{109, 84,173,428},		/* eighth default window position 	*/	{$e000,$002c,$FFFF,  0},							/* Y1 = default folder background and outline color */							/* X1 = international comma character				*/							/* Y2 = default preference settings					*/							/* X2 = default quit setting (low 2 bits, 6.0.1)	*/		{180,570,  0,  0},		/* default trashcan position			*/	{120, 20,180,500},		/* default trash window position		*/		{ 120,20,180,500},		/* default clipboard window position 	*/		{$dddd,$dddd,$dddd,$dddd}, /* default desktop pattern			*/	{$dddd,$dddd,$dddd,$dddd}	  }};			//// --- rAlertString Templates//resource rAlertString (ALERT_00000001, $0000) {       "64~The filename “*0” is unacceptable to the destination file system.~^#6"       "\$00"};resource rAlertString (ALERT_00000002, $0000) {       "64~Are you sure you want to change the owner for "       "“*0”"       "?~#1~^#0"       "\$00"};resource rAlertString (ALERT_00000003, $0000) {       "52~The changes to some folders could not be applied."       " Only the owner can change make changes.~^#0"       "\$00"};resource rAlertString (ALERT_00000005, preload,locked,fixed,noSpecialMemory) {       "56~Please insert the disk “*0”."       "~#1~^#0"       "\$00"};resource rAlertString (ALERT_00000006, $0000) {       "62~There was a problem while using “*0”.  The disk may be physically"       " damaged.~^#6"       "\$00"};resource rAlertString (ALERT_00000007, $0000) {       "64~You do no have the access privileges to change "       "“*0”.  Only the owner can change the access privileges."       "~^#6"       "\$00"};resource rAlertString (ALERT_0000000B, $0000) {       "62~The name "       "“*0”"       " is already taken.  Please use a different name.~^#6"       "\$00"};resource rAlertString (ALERT_0000000C, $0000) {       "52~The changes could not be applied."       "\$0D"       "(unknown user)~^#6"       "\$00"};resource rAlertString (ALERT_0000000D, $0000) {       "52~The changes could not be applied."       "\$0D"       "(unknown group)~^#6"       "\$00"};resource rAlertString (ALERT_0000000E, $0000) {       "52~The changes could not be applied."       "\$0D"       "(the pathname is too long)~^#6"       "\$00"};resource rAlertString (ALERT_0000000F, $0000) {       "52~This operation could not be completed because a file on the disk is "       "open.~^#1"       "\$00"};resource rAlertString (ALERT_00000010, $0000) {       "62~Items in the trash can’t be opened.  Please drag the items ba"       "ck into a disk icon or folder window, or onto the desktop.~^#6"       "\$00"};resource rAlertString (ALERT_00000011, $0000) {       "52~The disk directory is full.  This operation can’t be completed.~^"       "#1"       "\$00"};resource rAlertString (ALERT_00000012, $0000) {       "52~The disk is full.  This operation can’t be completed.~^#1"       "\$00"};resource rAlertString (ALERT_00000013, $0000) {       "63~The disk “*0” is write protected.~#1~^#4"       "\$00"};resource rAlertString (ALERT_00000015, $0000) {       "62~You do not have the access privileges needed to use (or make changes"       " to) all the selected items.~^#6"       "\$00"};resource rAlertString (ALERT_00000017, $0000) {       "52~The Trash icon can’t be moved into a window or onto another "       "icon.~^#6"       "\$00"};resource rAlertString (ALERT_00000018, $0000) {       "52~Disk icons can be dragged only onto other disk icons.~^#6"       "\$00"};resource rAlertString (ALERT_00000019, $0000) {       "52~Disk icons can’t be dragged with file or folder icons for"       " this operation.~^#6"       "\$00"};resource rAlertString (ALERT_0000001A, $0000) {       "52~5.25-inch disk drive icons can’t "       "be moved into a window or onto another icon.~^#0"       "\$00"};resource rAlertString (ALERT_0000001B, $0000) {       "62~Icons can only be dragged into directory windows, the Trash"       " window, or onto the desktop.~^#6"       "\$00"};resource rAlertString (ALERT_0000001C, $0000) {       "52~Items from file servers may not be moved onto the desktop.~^#6"       "\$00"};resource rAlertString (ALERT_0000001D, $0000) {       "63~The folder “*2” can’t be moved into itself or into one of"	   " its own folders.~#1~^Skip"       "\$00"};resource rAlertString (ALERT_0000001E, $0000) {       "72~There was a problem while using “*8”.  The disk may be physically"       " damaged.  This operation can’t be completed.~^#1"       "\$00"};resource rAlertString (ALERT_0000001F, preload,locked,fixed,noSpecialMemory) {       "62~“*8” was ejected while being used.  This operation can’t"       " be completed.~^#1"       "\$00"};resource rAlertString (ALERT_00000020, $0000) {       "52~That item could not be moved (an item with that name already "       "exists).~^#1"       "\$00"};resource rAlertString (ALERT_00000021, $0000) {       "62~Your access privileges do not permit you to perform that oper"       "ation on the selected item(s).~^#6"       "\$00"};resource rAlertString (ALERT_00000022, $0000) {       "62~You do not have the access privileges necessary to open “*0”."	   "  Only the owner can change the access privileges.~^#6"       "\$00"};resource rAlertString (ALERT_00000023, preload,locked,fixed,noSpecialMemory) {       "72~System Error ($*7).  This operation can’t be completed."	   "\$0d"	   "\$0d"       "*9.~^#1\$00"};resource rAlertString (ALERT_00000024, $0000) {       "62~Finder can’t copy more than 800 items from the same folder at the same"	   " time.  Try dragging the items in smaller groups.~^#1"       "\$00"};resource rAlertString (ALERT_00000025, $0000) {       "52~No more windows can be opened.~^#1"       "\$00"};resource rAlertString (ALERT_00000026, preload,locked,fixed,noSpecialMemory) {       "82~There isn’t enough memory remaining to complete this operation."	   "\$0d"	   "\$0d"	   "Closing windows will help this situation immediately.  Inactivating Icon files, "	   "Desk Accessories, and Setup files will help the next time the system is restarted."       "~^#1"       "\$00"};resource rAlertString (ALERT_00000027, $0000) {       "64~You do not have the necessary access privileges to see all of"       " the items you are putting into this folder/disk.~#1~^#6"       "\$00"};resource rAlertString (ALERT_00000028, $0000) {       "62~The disk “*0” is already on the desktop.  There can’t"       " be two disks with the same name on the desktop.~^#6"       "\$00"};resource rAlertString (ALERT_00000029, $0000) {       "72~The 5.25-inch drive “*0” is already on the desktop.  There can’t"       " be another icon with the same name as “*0” on the desktop.~^#6"       "\$00"};resource rAlertString (ALERT_0000002A, $0000) {       "63~The item “*8” can’t be copied because its access privileges won’t "	   "allow it to be read.~#1~^Skip"       "\$00"};resource rAlertString (ALERT_0000002B, $0000) {       "63~The disk “*8” is write protected.~#1~^#4"       "\$00"};resource rAlertString (ALERT_0000002C, $0000) {       "52~These items are from separate disks.  Please move them separately."       "~^#6"       "\$00"};resource rAlertString (ALERT_0000002F, $0000) {       "52~The pathname is too long to complete this operation.~^#1"       "\$00"};resource rAlertString (ALERT_00000032, $0000) {       "52~An application can’t be found for this document.~^#1"       "\$00"};resource rAlertString (ALERT_00000033, $0000) {       "63~You cannot replace “*2” because a folder cannot be replaced by "	   "an item it contains.~#1~^Skip"       "\$00"};resource rAlertString (ALERT_00000034, $0000) {       "54~You are attempting to replace a file with a folder or vice versa."       "  Should it be replaced?~#1~Skip~^Replace"       "\$00"};resource rAlertString (ALERT_00000035, $0000) {       "74~Completely replace the contents of “*1” with the contents of “*0”"       "?~#1~^Replace"       "\$00"};resource rAlertString (ALERT_00000036, $0000) {       "74~The two disks are different sizes, so the contents of “*0” will"       " be placed in a folder on “*1”.~#1~^#0"       "\$00"};resource rAlertString (ALERT_00000037, $0000) {       "74~The item “*2”"       " already exists and is locked (or contains items that are locked"       ").  Replace it anyway?~#1~Skip~^Replace"       "\$00"};resource rAlertString (ALERT_00000038, $0000) {       "74~The item “*2”"       " is locked (or contains items that are locked).  Remove it anyway?"       "~#1~Skip~^Remove"       "\$00"};resource rAlertString (ALERT_00000039, $0000) {       "72~There is not enough room on “*1” to copy the contents of “*0”.~^#1"       "\$00"};resource rAlertString (ALERT_0000003B, $0000) {       "62~The application “*2” can’t be found for this document.~#1~#4~^Locate..."       "\$00"};resource rAlertString (ALERT_0000003C, $0000) {       "52~Non-removable devices can’t be dragged into the trash.~^#0"       "\$00"};resource rAlertString (ALERT_0000003D, $0000) {       "62~There are no more “untitled”"       " names available for this window.  Please rename some icons if you"       " wish to create more folders.~^#6"       "\$00"};resource rAlertString (ALERT_0000003E, $0000) {       "74~Unless this file is placed on a server, attaching a comment to"	   " it makes it unusable by any application which uses ProDOS 8."	   "~#1~^Attach"       "\$00"};resource rAlertString (ALERT_00000040, $0000) {       "84~Your comment is about to be recorded on the server.  You can also "	   "attach the comment to the file itself, but this will make the file "	   "unusable by ProDOS 8 if the file is dragged off the server."	   "\$0d"	   "\$0d"	   "The comment will be limited to 199 characters if it is not attached to the file."	   "~Don’t Attach~^Attach"       "\$00"};resource rAlertString (ALERT_00000043, $0000) {  /* this is for rComment(2) */       "83~*0~^#1"       "\$00"};resource rAlertString (ALERT_00000044, $0000) {       "53~All disk blocks are good on disk “*0”."       "~^#0"       "\$00"};resource rAlertString (ALERT_00000045, $0000) {       "73~Some disk blocks are bad on disk “*0”.  "       "Do you want a summary of the bad blocks?~#1~^#0"       "\$00"};resource rAlertString (ALERT_00000046, $0000) {       "53~The file structure of “*3” seems to be OK."       "~^#0"       "\$00"};resource rAlertString (ALERT_00000047, $0000) {       "73~Some bad items were found in “*3”.  "       "Do you want a summary of the bad items?~#1~^#0"       "\$00"};resource rAlertString (ALERT_00000048, preload, locked, fixed,noSpecialMemory) {       "56~Please insert the disk “*8”."       "~#1~^#0"       "\$00"};resource rAlertString (ALERT_00000049, $0000) {       "64~The item “*2” already exists.  Replace this item?"       "~#1~^Replace"       "\$00"};resource rAlertString (ALERT_0000004A, preload, locked, fixed,noSpecialMemory) {       "94~The Finder is dangerously low on memory."	   "\$0d"	   "\$0d"	   "Closing windows will help this situation immediately.  Inactivating Icon files and "	   "removing “Desktop” files from Icons folders will help when the Finder "	   "is launched again.  Inactivating Desk Accessories and Setup files will help the "	   "next time the system is restarted."       "~^#6"       "\$00"};resource rAlertString (ALERT_0000004C, 0) {       "62~The Standard File toolset could not be started.  This operation can’t be "	   "completed."       "~^#1"       "\$00"};resource rAlertString (ALERT_0000004D, 0) {       "62~ProDOS 8 applications can only be launched from AppleShare or ProDOS disks."       "~^#1"       "\$00"};resource rAlertString (ALERT_0000004E, 0) {       "62~Documents which launch ProDOS 8 applications must reside on AppleShare or "	   "ProDOS disks."       "~^#1"       "\$00"};resource rAlertString (ALERT_0000004F, 0) {       "62~You cannot change the contents of the disk “*2”, because the disk "	   "is locked."       "~^#1"       "\$00"};resource rAlertString (ALERT_00000050, 0) {       "62~You cannot change the contents of the disk “*2”, because the disk "	   "uses a read-only file system."       "~^#1"       "\$00"};resource rAlertString (ALERT_00000051, 0) {       "63~The file “*5” can’t be copied because it’s too large for the *6 file system."       "~#1~^Skip"       "\$00"};resource rAlertString (ALERT_00000052, 0) {       "74~This folder contains *5 items.  Opening this folder requires about *6.  "	   "About *9 is available.  Opening this 