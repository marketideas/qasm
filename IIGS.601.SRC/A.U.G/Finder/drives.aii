;*********************************************************************************************;;	File:		drives.aii;;	Contains:	Drives stuff;;	Written by:	Dan Oliver, later by Don J. Brady, Jim Merrrit, and a cast of;			Thousands (6.0: Andy Nicholas and Dave Lyons);;	Copyright:	© 1991-93 by Apple Computer, Inc., all rights reserved.;;*********************************************************************************************;; CHANGE HISTORY FOR 6.0.1;; 16-Oct-92	Dave Lyons;   After opening a window from Finder.Root of a newly inserted disk, we set the;   PendingDeselectAll flag so that keyboard navigation happens in the new window.;;; 22-Mar-93 JCM - Now calling UnlockICBLKHAND in a number of places instead of doing it inline.;;  1-Apr-93 JCM - We now load new-style icons from @:Desktop if we're net booted. Since we've;		  always written there, it's rather stupid not to read as well. Duh.;;*********************************************************************************************		STRING	ASIS		BLANKS	OFF		PRINT	OFF		PRINT	NOGEN		PRINT	NOSYM		PRINT	NOPAGE		PAGESIZE $FFFF,126		INCLUDE 'All.macros'		INCLUDE	'Pascal.macros'		INCLUDE	'special.macros'		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'		INCLUDE	'DP.equ'		INCLUDE	'Data.equ'		INCLUDE	'Strings.equ'		INCLUDE	'match.equ'		PRINT	ON;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		import DisposeHandleGlue;		IMPORT	SysAlertsOff		; in common.aii;		IMPORT	SysAlertsOn		; in common.aii		IMPORT	ShutItDown		; in menu.aii		IMPORT	updateInfoWin2		; in main.aii		IMPORT	PToWString		IMPORT	NewDialog		IMPORT	clonePath		IMPORT	buildPath		IMPORT	getName		IMPORT	lockic		IMPORT	unlockic		IMPORT	startDraw		IMPORT	markOnLine		IMPORT	endDraw		IMPORT	allOnline		IMPORT	blinkIcon		IMPORT	toDesktop		IMPORT	DeskSpot		IMPORT	addIconObj		IMPORT	drawIcon2		IMPORT	findLastName		IMPORT	walkOfLife		IMPORT	setic		IMPORT	makeIcRoot		IMPORT	path2temp2		IMPORT	addRootName		IMPORT	allocate2		IMPORT	derefHand		IMPORT	path2ticon		IMPORT	toDeskPort		IMPORT	ckIfWind		IMPORT	ckIfWindMax		IMPORT	openFolder2		IMPORT	temp2Topath		IMPORT	noRename		IMPORT	markOffLine		IMPORT	allOffLine		IMPORT	addName		IMPORT	MiscEntry		IMPORT	addName		IMPORT	watchCursor		IMPORT	arrowCursor		IMPORT	allocate		IMPORT	setTemp		IMPORT	unlockblk;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	newDevice		ENTRY	typeDevice		ENTRY	readRoot		ENTRY	matchDevice		ENTRY	openExtIcon		ENTRY	openExtIconLong		ENTRY	openWindow		ENTRY	openWindowLong		ENTRY	fetchPath		ENTRY	fetchPathLong		ENTRY	dinfo_list		ENTRY	dinfo_devnum		ENTRY	dinfo_devchar		ENTRY	dinfo_devid		ENTRY	GetAccessPriv		ENTRY	dupDevice		ENTRY	dupDevice2		ENTRY	matchIcName		ENTRY	doSetPrefix2		ENTRY	doSetPrefix		ENTRY	doSetMark		ENTRY	doGetFileInfo		ENTRY	doCreate		ENTRY	ProDOSerr		ENTRY	doRead		ENTRY	read2		ENTRY	open_file		ENTRY	read_file		ENTRY	read_file2		ENTRY	doWrite		ENTRY	close_file		ENTRY	dos_var		ENTRY	chkPartition;========================================;	   RAM for DOS routines.;========================================dos_var		PROC	EXPORT		IMPORT	OptionBuff; --- Open file	parameter list -------------		EXPORT	open_listopen_list	DC.W	13			;pcount		EXPORT	open_numopen_num	DC.W	0			;ref_num		EXPORT	open_nameopen_name	DC.L	0			;ptr to file's pathname		EXPORT	open_requestopen_request	DC.W	0			;request_access		EXPORT	open_resourceopen_resource	DC.W	0			;resource_number		EXPORT	open_accessopen_access	DC.W	0			;access		EXPORT	open_typeopen_type	DC.W	0			;file_type		EXPORT	open_auxopen_aux	DC.L	0			;aux_type		EXPORT	open_storeopen_store	DC.W	0			;storage_type		EXPORT	open_cdateopen_cdate	DC.L	0,0			;create_date		EXPORT	open_mdateopen_mdate	DC.L	0,0			;mod_date		EXPORT	open_optionopen_option	DC.L	OptionBuff		;ptr to option_list		EXPORT	open_eofopen_eof	DC.L	0			;eof		EXPORT	open_blksopen_blks	DC.L	0			;blocks_used; --- Close file parameter list -------------		EXPORT	close_listclose_list	DC.W	1			;pcount		EXPORT	close_numclose_num	DC.W	0			;ref_num; --- Read file	parameter list --------------		EXPORT	read_listread_list	DC.W	4			;pcount		EXPORT	read_numread_num	DC.W	0			;ref_num		EXPORT	read_buffread_buff	DC.L	0			;ptr to input buffer		EXPORT	read_sizeread_size	DC.L	0			;number of bytes to read (64K max)		EXPORT	read_lenread_len	DC.L	0			;actual number of bytes read; --- Write file list -----------------------		EXPORT	write_listwrite_list	DC.W	4			;pcount		EXPORT	write_numwrite_num	DC.W	0			;ref_num		EXPORT	write_buffwrite_buff	DC.L	0			;ptr to output buffer		EXPORT	write_lenwrite_len	DC.L	0			;number of bytes to write		EXPORT	writtenwritten		DC.L	0			;actual number of byte written; --- Create file list -----------------------		EXPORT	create_listcreate_list	DC.W	5			;pcount		EXPORT	create_namecreate_name	DC.L	C1_PathName		;ptr to file's name		EXPORT	create_accesscreate_access	DC.W	%0000000011000011	;unlocked, rename ok, read/write ok		EXPORT	file_typefile_type	DC.W	0			;file_type		EXPORT	create_auxcreate_aux	DC.L	0			;aux_type		EXPORT	storage_typestorage_type	DC.W	1			;storage_type (seedling file); --- Destroy file list -------------------------		EXPORT	destroy_listdestroy_list	DC.W	1			;pcount		DC.L	C1_PathName		;ptr to file's name; --- Set/Get prefix list -----------------------		EXPORT	prefix_listprefix_list	DC.W	2			;pcount		EXPORT	prefix_numprefix_num	DC.W	0			;prefix_number		EXPORT	prefix_nameprefix_name	DC.L	0			;ptr to pathname		EXPORT	null_prefix_listnull_prefix_list DC.W	2			;pcount		EXPORT	null_prefix_numnull_prefix_num	DC.W	0			;prefix_number		EXPORT	null_prefix_namenull_prefix_name DC.L	null_prefix		;ptr to pathnamenull_prefix	dc.W	0; --- Get file info list -----------------------		EXPORT	info_listinfo_list	DC.W	12			;pcount		EXPORT	info_nameinfo_name	DC.L	C1_PathName		;ptr to file's pathname.		EXPORT	info_accessinfo_access	DC.W	0			;access		EXPORT	info_typeinfo_type	DC.W	0			;file_type		EXPORT	info_auxinfo_aux	DC.L	0			;aux_type		EXPORT	info_storeinfo_store	DC.W	0			;storage_type (null for SET_FILE_INFO)		EXPORT	info_cdateinfo_cdate	DC.L	0,0			;create_date		EXPORT	info_mdateinfo_mdate	DC.L	0,0			;mod_date		EXPORT	info_optioninfo_option	DC.L	OptionBuff		;ptr to option_list		EXPORT	info_eofinfo_eof	DC.L	0			;eof (null for SET_FILE_INFO)		EXPORT	info_blocksinfo_blocks	DC.L	0			;blocks_used (null for SET_FILE_INFO)		EXPORT	info_rsrc_eofinfo_rsrc_eof	DC.L	0			;resource eof		EXPORT	info_rsrc_blksinfo_rsrc_blks	DC.L	0			;resource blocks used; --- EOF list ----------------------------------		EXPORT	EOF_listEOF_list	DC.W	3			;pcount		EXPORT	EOF_numEOF_num		DS.B 2				;ref_num		EXPORT	eof_baseeof_base	DC.W	0			;base		EXPORT	EOF_placeEOF_place	DS.B 4				;displacement; --- Volume list -------------------------------		EXPORT	volume_listvolume_list	DC.W	8			;pcount		ENTRY	DevNameDevName		DC.L	C1_DeviceName		;ptr to device name		DC.L	C1_PathNameBuf		;ptr to volume name buffer		EXPORT	NumBlksNumBlks		DC.L	0			;total_blocks		EXPORT	FreeBlksFreeBlks	DC.L	0			;free_blocks		EXPORT	FileSysIDFileSysID	DC.W	0			;file_sys_id		EXPORT	BlockSizeBlockSize	DC.W	0			;number of bytes of a block		EXPORT	DeviceCharacteristicsDeviceCharacteristics	DC.W	0		;device characteristics		EXPORT	DeviceID		DeviceID	DC.W	0			;deviceID		EXPORT	BootFST			BootFST		dc.w	0			;file system we used to boot; --- File position mark list -------------------		EXPORT	mark_listmark_list	DC.W	3			;pcount		EXPORT	mark_nummark_num	DC.W	0			;ref_nummark_base	DC.W	0			;base		EXPORT	mark_posmark_pos	DC.L	0			;displacement; --- D_INFO list -------------------------------		EXPORT	dinfo_listdinfo_list		DC.W	8			;pcount		EXPORT	dinfo_devnumdinfo_devnum	DC.W	0			;dev_num		DC.L	c1_DevNameBuf		;dev_name		EXPORT	dinfo_devchardinfo_devchar	DC.W	0			;dev_char		DC.L	0			;total_blocks		DC.W	0			;slot_num		DC.W	0			;unit_num		DC.W	0			;version		EXPORT	dinfo_deviddinfo_devid	DC.W	0			;device_id_num		DC.W	0			;head_link		DC.W	0			;forward_link; --- CHANGE_PATH list --------------------------		ENTRY	cpath_listcpath_list	DC.W	2			;pcount		DC.L	C1_DeviceName		;ptr to old pathname		DC.L	C1_PathName		;ptr to new pathname		ENTRY	StartUpFlagStartUpFlag	dc.w	0		ENDP*===============================================**	      Mount a GSOS Disk			**						** IN:	---- STACK ----				**	startFlag (Word)			**	devNum (Word)				**	flag (Word)				**  SP-->					**						** OUT:	A reg, carry flag			**===============================================*MountDisk	PROCNAME EXPORT		InitFrame		FrameType  SaveB,ReturnA	; save data bank, return A reg (and carry)devID		Local	WorddevChar		Local	WorddevStatus	Local	WorddevName		Local	34			; name of devicevolName		Local	34			; name of volumetotalBlocks	Local	LongfreeBlocks	Local	LongblkSize		Local	WordfileSystem	Local	WordfileAccess	Local	WordcreateDate	Local	8modifyDate	Local	8errorCode	Local	WorddialogNum	Local	WordoldDP		Local	WordHDIflags	Local	Wordflag		Param	Word			; input parameters (reverse order)devNum		Param	WordstartFlag	Param	Word		IMPORT	WStringCopy		IMPORT	doAlertWindow		IMPORT	C1_PathNamePtr		IMPORT	GetDeviceName		IMPORT	GetDeviceInfo		IMPORT	GetDeviceStatus		IMPORT	GetVolumeInfo		IMPORT	GetFileInfo		IMPORT	EjectDisk		IMPORT	FormatDisk		IMPORT	IgnoreGSOSError		IMPORT	HandleGSOSError		IMPORT	GetProDOSName		IMPORT	SetProDOSName		IMPORT	NewUntitled		IMPORT	PathAddName		IMPORT	DeviceCharacteristics		IMPORT	VolumeParams		tdc				; stash old DP in x		tax		EntryCode;-----------------------------------------------		stx	<oldDP			; remember old DPBegin			phk		plb		lda	<startFlag		sta	startUpFlag		lda	<flag		and	#$0002		beq	getMountData		stz	createIcon		; clear 'icon created' flag		PushZWord <devNum		; pass device number		PushZPtr <devName		; pointer to device name		PushZPtr <devChar		; pointer to characteristics		PushZPtr <totalBlocks		; pointer to total blocks		PushZPtr <devID			; pointer to device ID		jsl	GetDeviceInfo		bcc	@ok		brl	End@ok		PushZPtr <devName		PushLong #C1_DeviceName		jsl	WStringCopy		lda	<devChar		and	#$fffc			;strip the locked & FSTisWriteOnly bits		ora	#$0040			;say the device is writable		sta	DeviceCharacteristics				lda	<devID		sta	dinfo_devid		;fake the devNum and devID to newdevice		lda	<devNum		sta	_DevNum		lda	#1		sta	info_access		lda	#280		sta	NumBlks		stz	NumBlks+2		stz	C1_PathName		; pass empty path (flag it)		phd		lda	<oldDP		tcd		lda	_DevNum		sta	<devNumber		jsr	NewDevice		; add 5.25 drive icon		pldgoToEnd		brl	endgetMountData		jsr	GetGSOSInfo		; get mount data		bcc	map		jsr	MountError		; handle errors		lda	#$FFFF		bcs	goToEnd		brl	Begin			; try to mount againmap		stz	createIcon		; clear 'icon created' flag		PushZPtr <volName		PushLong #C1_PathName		jsl	WStringCopy		PushZPtr <devName		PushLong #C1_DeviceName		jsl	WStringCopy		lda	<devID					sta	dinfo_devid				lda	<devNum		sta	_DevNum		ldx	#6@loop		lda	<createDate,x		sta	info_cdate,x		dex		dex		bpl	@loop		ldx	#6@loop2		lda	<modifyDate,x		sta	info_mdate,x		dex		dex		bpl	@loop2		lda	<fileAccess		sta	info_access		lda	<totalBlocks		sta	NumBlks		lda	<totalBlocks+2		sta	NumBlks+2		lda	<freeBlocks		sta	FreeBlks		lda	<freeBlocks+2		sta	FreeBlks+2		lda	<fileSystem		sta	FileSysID		lda	<blkSize		sta	BlockSize		phd		lda	<oldDP		tcd		lda	_DevNum		sta	<devNumber		jsr	NewDevice		; add disk icon		pld		bcc	@notMounted		brl	getMountData		@notFirst	sec		lda	#$27		bra	end@notMounted		lda	<devID			; is this a Disk][ ?		bne	endGlue			; no		lda	<flag			; is this a first time Disk][?		and	#1		beq	@notFirst		; no		lda	<devChar		and	#$fffc			;clear the fst and write-protected bits		ora	#$0040			;add in the writable bit		sta	DeviceCharacteristics			stz	C1_PathName		; pass empty path (flag it)		phd		lda	<oldDP		tcd		lda	_DevNum		sta	<devNumber		jsr	NewDevice		; add 5.25 drive icon		pldendGlue		lda	#0			; no errorEnd;-----------------------------------------------		ExitCode;; locals;_DevNum		DC.W	0;-----------------------------------------------		ENTRY	GetGSOSInfoGetGSOSInfo		stz	<errorCode		jsl	IgnoreGSOSError		PushZWord <devNum		; pass device number		PushZPtr <devName		; pointer to device name		PushZPtr <devChar		; pointer to characteristics		PushZPtr <totalBlocks		; pointer to total blocks		PushZPtr <devID			; pointer to device ID		jsl	GetDeviceInfo		bcs	badInfo		lda	<devChar		and	#$0080			; a block device ?		bne	okInfo			; yes		lda	#$8001badInfo		sta	<errorCode		brl	endGSOSokInfo		;		pha				; space for status;		PushZWord <devNum		; pass device number;		jsl	GetDeviceStatus;		pla;		sta	<devStatus		; pull status;		bcs	badInfo;		and	#$0010			; device online ?;		bne	okStat			; yes;		lda	#$8002;		bra	badInfookStat		PushZPtr <devName		; pointer to device name		PushZPtr <volName		; pointer to volume name		PushZPtr <totalBlocks		; pointer to total blocks		PushZPtr <freeBlocks		; pointer to free blocks		PushZPtr <fileSystem		; pointer to file system ID		PushZPtr <blkSize		; pointer to block size		jsl	GetVolumeInfo		bcs	badInfo		lda	>VolumeParams+$16		sta	DeviceCharacteristics		PushZPtr <volName		; pointer to volume name		PushZPtr <fileAccess		; pointer to access		PushLong #0			; skip file type		PushLong #0			; skip aux type		PushLong #0			; skip storage type		PushZPtr <createDate		; pointer create date		PushZPtr <modifyDate		; pointer modify date		PushLong #0			; skip bytes		PushLong #0			; skip blocks		PushZPtr <fileSystem		; file system		jsl	GetFileInfo		bcc	endGSOS		cmp	#$4F			; ignore bufferToSmall errors		beq	endGSOS		sta	<errorCodeendGSOS		jsl	HandleGSOSError		lda	<errorCode		cmp	#1		rts;; a-reg has error code;mountError	stz	HDIFlags*** 28-Oct-92 DAL -- Errors 2D, 46, 51, and 5A no longer set the hdiUnreadable bit for HandleDiskInsert		cmp	#$46		beq	_SomeWeirdError		cmp	#$52			; disk initialized by another OS?		beq	_WrongOS		cmp	#$5D			; disk initialized by another OS?		beq	_WrongOS		cmp	#$27			; uninitialized or no disk?		beq	_Uninitialized		cmp	#$2D			; FATAL ERROR - bad block number ?		beq	_SomeWeirdError		cmp	#$51			; FATAL ERROR - directory error ?		beq	_SomeWeirdError		cmp	#$5A			; FATAL ERROR - damaged bitmap ?		beq	_SomeWeirdError		cmp	#$57			; duplicate volume (for example, boot volume's name)		beq	_Duplicateabort		secendMountError	rts;; someone stuck an unitialized disk into a drive, handle it;_Uninitialized	lda	#$0100			;hdiUnreadable		sta	HDIFlags_SomeWeirdError		lda	<devID			; is this a Disk][ ?		bne	_Duplicate		; no		lda	<flag			; is this a first time Disk][?		and	#1		beq	_Duplicate		; no		jsr	addDrive		;add the drive icon, just not the disk		sec		rts;; someone stuck a disk in that GS/OS doesn't have an FST for, handle it;_WrongOS;; someone tried to mount a duplicate volume.  Let HandleDiskInsert handle it;_Duplicate	pha				;space for result flags		pha				;space for result device number		lda	#$4400			;handle the specific device (next parm)		ora	HDIFlags		pha		pei 	<devNum		_HandleDiskInsert		pla		plx		tax				;is result device number zero?		bcs	@notMounted		bne 	@mounted@notMounted	lda	<flag			;Was this a 525 drive that wasn't mounted?		and	#1			;if so, mount the drive icon, but not the disk		beq	@not525		jsr	AddDrive@not525		sec@mounted	rts;-----------------------------------------------AddDrive		stz	createIcon		; clear 'icon created' flag		PushZPtr <devName		PushLong #C1_DeviceName		jsl	WStringCopy		lda	<devChar		;set the characteristics for this device		and	#$fffc		ora	#$0040		sta	DeviceCharacteristics			lda	<devID		sta	dinfo_devid		;fake the devNum and devID to newdevice		lda	<devNum		sta	_DevNum		lda	#1		sta	info_access		lda	#280		sta	NumBlks		stz	NumBlks+2		stz	C1_PathName		; pass empty path (flag it)		phd		lda	<oldDP		tcd		lda	_DevNum		sta	<devNumber		jsr	NewDevice		; add 5.25 drive icon		pld		sec		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;	   Determine type of device.;	   Add device to desktop if necessary.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=;; IN:	startupFlag = zero if not in startup, nonzero if startup.;	devNumber = device number.;	dinfo_devid = type of device;	volList = result from ProDOS volume call.;		DevName:	pointer to device name.;		VolName:	pointer to 'pathname' which contains volume name.;		NumBlks:	size of device in blocks.;		FreeBlks:	number of free blocks in device.;		FileSysID:	identifies the volume's file system.;	C1_PathName = volume name with leading separator (leading 0 = put up DiskII icon);	lastName = volume name, no separator.;;; OUT:	Device added to desktop if necessary.;	C1_PathName = trash.;	C1_VolName = original pathname.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	=newDevice	PROCNAME		IMPORT	LoadIcons		IMPORT	OptionList		IMPORT	WStringCopy		IMPORT	EjectDisk		IMPORT	C1_PathNamePtr		IMPORT	doAlertWindow		import	DeselectAll		IMPORT	DeviceCharacteristics		import	dupDeviceNum		import	RebuildVCRLong		import	RootIconHandle;; --- Save pathname of new volume ------------------------------------;		PushLong #C1_PathName		PushLong #C1_VolName		jsl	WStringCopy;; --- Classify the volume --------------------------------------------;		jsr	typeDevice		;find device type.;		tax;		beq	exit101			;Valid device?		cmp	#TypeRAM		; added 05/26/88 DJB		bne	cont101		ldx	#$FFFF		stx	IsRAMDisk		bra	skip100cont101		cmp	#TypeFDrive		; Floppy drive?		bne	skip100;--- Floppy disk -------------------------------		lda	#TypeFloppy		; Floppy disk icon		ldx	C1_PathName		; Is there really a disk there?		bne	skip100;--- Make floppy drive (DiskII icon) if this is first time ---		PushLong #C1_DeviceName		; move device name into pathname		PushLong #C1_PathName		jsl	WStringCopy		lda	#SEPARATOR<<8		sta	C1_PathName+1		; replace '.' with separator character		stz	FileSysID		; no filesystem		lda	#TypeFDrive		; Floppy drive icon		sta	<filetype		; remember icon type to assign		jsr	findLastName		; lastName = pathname less leading separator.		brl	ok101			; add Floppy drive icon;--- Does device already have an icon ? (maybe itÕs coming back online?)  --------skip100		sta	<filetype		; remember icon type to assign		ldy	#0			;don't skip any devices, we didn't make an iconobj yet		jsr	dupDevice		; check if there is a duplicate device		bcs	cont100		brl	ok101			; not a duplicate device, ok to add icon; ----------------------------------------------;	Check if this is the same device;	coming back on line.;; icHand = duplicate icon.; lastName = name to match.; filetype = filetype to match.; devNumber = device number.; info_cdate = new volume's create date.;;------------------------------------------------cont100		jsr	lockic		ldy	#icCDate+6		; must be created on same date		ldx	#6dateLoop	lda	[<ic],y		cmp	info_cdate,x		bne	dupDiskErr		; different disk!		dey		dey		dex		dex		bpl	dateLoop		ldy	#icFType		; must be same device type		lda	[<ic],y		cmp	<filetype		bne	dupDiskErr		brl	next100dupDiskErr	jsr	unlockic		pha				;space for result flags		pha				;space for result device number		pea 	$4400			;flag = simulate dup-volume error		pei 	<devNumber		_HandleDiskInsert		pla		plx 		tax		bcs	@notMounted		bne	@mounted		@notMounted	lda	dupDeviceNum		beq	@noRebuild		jsl	RebuildVCRLong@noRebuild	clc		rts@mounted	sec		rts;; --------- Device found --------------------------------------------------;next100		ldy	#icFlag			;Is this icon coming back on line?		lda	[<ic],y		and	#ICOFFLINE		beq	skip600		ldy	#icDevNum		;Give icon its device number back.		lda	<devNumber		sta	[<ic],y		jsr	setDeviceLock				jsr	startDraw		jsr	markOnLine		;Make icon on line.		jsr	endDraw		jsr	allOnline		;Make all windows from disk as on line.		jsr	updateInfoWin2		;added 07/27/88 DJBskip600		ldy	#icFType		;Is this a floppy disk?		lda	[<ic],y		cmp	#TypeFloppy		beq	skip601		ldy	#icDevNum		;check devNum to see if this disk is		lda	[<ic],y			;already online which means its twin		cmp	<devNumber		;was inserted into another drive!		beq	exit600		brl	dupDiskErrskip601		jsr	blinkIcon		;Flash the icon to let the user know						;that this icon is online.exit600		jsr	unlockic		;Stop flag, match found.		clc		rts;; --- Create an	icon for the device ------------;ok101		ldy	#6dateLoop2	lda	info_cdate,y		; changed 06/29/88 DJB		sta	ticonobj+icCDate,y		lda	info_mdate,y		sta	ticonobj+icMDate,y		dey		dey		bpl	dateLoop2		jsr	toDesktop		; add to desktop list		jsr	toDeskPort		; switch to desktop port		jsr	DeskSpot		; find an open spot on the desktop		inc	createIcon		; set 'icon created' flag		lda	#ICBACKCLR		; solid white background, black outline		sta	ticonobj+icFlag		lda	info_access		and	#$0001			; check read enabled		beq	@set1			; not set !		lda	#ICREADABLE>>16		; set our bit@set1		sta	ticonobj+icFlag+2		lda	info_access		sta	ticonobj+icLocalAccess		stz	ticonobj+icForked		lda	>OptionList-2		tax		cpx	#icOptionListEnd-icOptionList-2		bcc	@sizeOkay		ldx	#icOptionListEnd-icOptionList-2@sizeOkay@loop		lda	>OptionList-2,x		sta	ticonobj+icOptionList,x		dex		dex		bpl	@loop		lda	>OptionList		cmp	#AppleShareFST		bne	@notNetwork		lda	<filetype		;check the filetype and the FST		cmp	#$0f		beq	@isNetwork		cmp	#typeServer		bne	@notNetwork@isNetwork	lda	>OptionList+$26		sta	ticonobj+icNetworkAccess		lda	>OptionList+$28		sta	ticonobj+icNetworkAccess+2		bra	@wasNetwork@notNetwork	stz	ticonobj+icNetworkAccess		stz	ticonobj+icNetworkAccess+2@wasNetwork*** added 14-Jul-91 DAL		lda	StartUpFlag		bne	@startingUp		jsr	DeselectAll		;11-Jul-91 DAL (will select new icon!)		jsr	toDesktop		jsr	toDeskPort@startingUp*** end 14-Jul-91		stz	AccessPriv		;andy & Dave, 27-Sep-91						;(That's a better explanation than						;the ones DJB and JAM put in!);; Based on the startup flag, either show the icon and read the icons or read the icons and then; show the icon... or... ;		lda	StartUpFlag		bne	startUp				jsr	MakeAndDrawDisk		bcs	@badMake				lda	<filetype		; don't check for root if drive icon.		cmp	#TypeFDrive		beq	@no525Drives		pei	<devNumber		;save device number in case drive follows		jsl	loadIcons		;load any icon files from inserted disk, *.ICONS		jsr	readRoot		;check if the disk has a root file		pla		sta	<devNumber		; restore device number		@no525Drives	jsr	unlockic		clc@badMake	rts;; we're in the startup loop, so load the icons, display the icon, then read the root file;startUp		lda	<filetype		;don't check for icon files if drive icon		cmp	#TypeFDrive		beq	@no525Icons		pei	<devNumber		;save device number in case drive follows		jsl	loadIcons		;load any icon files from inserted disk, *.ICONS		pla		sta	<devNumber@no525Icons			jsr	MakeAndDrawDisk				bcs	@badMake		lda	<filetype		;don't check for root if drive icon.		cmp	#TypeFDrive		beq	@no525Root		pei	<devNumber		;save device number in case drive follows		jsr	readRoot		;check if the disk has a root file		pla		sta	<devNumber		;restore device number@no525Root		jsr	unlockic		;leave the disk icon unlocked		clc@badMake	rts;; set the devInfo field from the device characteristics and update the ICLOCK bit in icFlag;setDeviceLock	lda	DeviceCharacteristics			ldy	#icDevInfo		;save the new device characteristics		sta	[<ic],y				and	#$0003			;check the write-protected and read-only FST bits		beq	@notWP			jsr	setLocked@notWP		lda	DeviceCharacteristics			and	#$0040			;check the writable device bit		bne	@writable		jsr	setLocked@writable	rts;; set the locked bit in icFlag;setLocked	ldy	#icFlag		lda	#icLocked		ora	[<ic],y		sta	[<ic],y		rts;; MakeAndDrawDisk -- make the iconObj and when done, draw it either in its highlighted state;		     or not highlighted depending on whether we're in the startup loop or not;MakeAndDrawDisk		lda	#lastName		ldx	#lastName>>16		ldy	#0			;add icon to the head of the icon list		jsr	addIconObj		; allocate and assign an ICONOBJ		bcc	@addOK		rts	@addOK;; ------ Fill in icon fields ----------------------------------------------;		jsr	lockic		ldy	#icDisk			;stuff our own icon handle into our icDisk field,		lda	<icHand			;creating a reference to ourself as being a root		sta	[<ic],y			;icon		sta	RootIconHandle		iny		iny		lda	<icHand+2		sta	[<ic],y		sta	RootIconHandle+2*** added 11-Jul-91 DAL -- select the new icon!		lda	StartUpFlag		bne	@startingUp		ldy 	#icFlag		lda	[<ic],y		ora	#ICSELECTED		sta	[<ic],y		lda	<deskPort		;make the desktop the current plane		ldx	<deskPort+2		sta	<curWind		stx	<curWind+2		bra	@notStartingUp@startingUp	lda	<devNumber		;if this is the boot device and we're starting up, then select it.		cmp	#1		bne	@notStartingUp		ldy 	#icFlag		lda	[<ic],y		ora	#ICSELECTED		sta	[<ic],y@notStartingUp*** end 11-Jul-91				ldy	#icFBytes		; total blocks		lda	NumBlks		sta	[<ic],y		iny		iny		lda	NumBlks+2		sta	[<ic],y		ldy	#icFBlocks		; used blocks = total blks - free blks		lda	NumBlks		sec		sbc	FreeBlks		sta	[<ic],y		iny		iny		lda	NumBlks+2		sbc	FreeBlks+2		sta	[<ic],y		ldy	#icDevNum		lda	<devNumber		sta	[<ic],y		stz	AccessPriv		;added 12/06/88 DJB; JAM 5/22/89 3:20am  (damage control);  Because of mods recently made to addiconobj (icons.aii),;    the ICNETWORK bit may already be set here.  Undo that damage now.;  (If it needs to be set, it will be under DJB 12/06/88, below)		ldy	#icFlag+2		lda	[<ic],y		and     #$FEFF			(#$FFFF-(ICNETWORK>>16))		sta	[<ic],y			; damage now undone		ldy	#icFileInfo		;added 05/29/88 DJB		lda	FileSysID		sta	[<ic],y		cmp	#AppleShareFST		; is it Apple Share ?		bne	@ok		jsr	GetAccessPriv		; yes, so get access privileges		lda	AccessPriv		and	#$000F		sta	AccessPriv		; only care about user's rights		ldy	#icFlag+2		lda	[<ic],y		ora	#ICNETWORK>>16		; set network bit		ora	AccessPriv		; add in user's rights		sta	[<ic],y@ok		jsr	setDeviceLock		jsr	drawIcon2		; draw the new ICONOBJ				clc		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Check if the	device already has;	   an icon on the desktop.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   C1_PathName = volume name to check.;	   Y = device number to skip;;  OUT:	   Carry set if	there is a device on the desktop of the	same name.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =dupDevice	PROC	EXPORT		IMPORT	OurDevice		sty	ourDevice		jsr	findLastName		;lastName = pathname less leading separator.		stz	dupIcon+1		bra	store800; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   lastName = name to match (no	separators).;;  OUT:	   Carry set if	there is a device on the desktop of the	same name.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	dupDevice2dupDevice2		lda	<icHand		ldx	<icHand+2		sta	dupIcon			;Save handle of icon being checked.		stx	dupIcon+2		stz	ourDevicestore800	pei	<curWind+2		pei	<curWind		lda	<deskport		;Check desktop ICONOBJ list.		sta	<curWind		lda	<deskport+2		sta	<curWind+2		lda	#matchDevice		jsr	walkOfLife		pla		sta	<curWind		pla		sta	<curWind+2		lda	dupIcon+1		;Was an icon saved?		beq	exit800		sta	<icHand+1		;Restore given icon.		lda	dupIcon		sta	<icHandexit800		brl	setic			;Exit with carry set if match found.		ENDP;////////////////////////////////;	   Match device.;////////////////////////////////;;   IN:	   lastName = name to match.;	   ic =	icon to	check.;	   dupIcon = handle of icon being checked (don't match).;;  OUT:	   Carry set if	match;	   matchedIconHandle is icon's handle if match;;////////////////////////////////matchDevice	PROCNAME		lda	<icHand		sta	matchedIconHandle		lda	<icHand+2		sta	matchedIconHandle+2				ldy	#icFType		;Check all devices.		lda	[<ic],y;		cmp	#TypeFDrive		;added for hack 05/16/88 DJB;		beq	noDup		cmp	#TypeLastOne		bcc	noDup		inc	a			;(Gets rid of trash types.)		inc	a		bpl	noDup		lda	ourDevice		;if we're not comparing against anything		beq	@normal			;we aren't, so act normal		ldy	#icDevNum		cmp	[<ic],y		beq	noDup@normal		ldy	#icDevNum		lda	[<ic],y		sta	dupDeviceNum				lda	dupIcon+1		;Is this the original icon being checked?		cmp	<icHand+1		bne	check800		;If so, force no match.		lda	dupIcon		cmp	<icHand		beq	noDupcheck800	brl	matchicName		;Check if name is the same.noDup		clc		rts;; locals;		EXPORT	matchedIconHandlematchedIconHandle dc.L	0		EXPORT	ourDeviceourDevice	dc.w	0			;if it's this device, it's ours, so skip it		EXPORT	dupDeviceNumdupDeviceNum	dc.w	0		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Classify a device type.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;; IN:	NumBlks = size of device in blocks.;	devNumber = device number;	dinfo_devid = type of device;; OUT:	a   =	TypeFDrive	if floppy.;		TypeRAM		if RAM disk.;		Type3_5		if 3.5" disk.;		TypeHard	if hard disk or tape drive;		TypeCDROM	if CDROM disc.;		TypeNetwork;		TypeServer;		TypeSCSI;		zero		if not a valid device.;; = = =	= = = =	= = = =	= = = =	= = = =	= = =typeDevice	PROC		lda	dinfo_devid		cmp	#(MapTypesEnd-MapTypes)/2 ;ID out of range?		bcs	guess		asl	a		tax		lda	mapTypes,x		beq	guess			;Unknown ID?		cmp	#TypeFDrive		beq	exit200		ldx	C1_PathName		;Was there an I/O error?		bne	exit200		lda	#0			;Return, not a device.exit200		jsr	chkPartition		rts; --- If unknown device, type from guess (size) ----------------------------guess		lda	#TypeHard		;Hard disk icon type, just in case.		ldx	NumBlks+2		;Size of device, in blocks.		bne	exit201			;More than 32meg?		ldx	NumBlks		cpx	#10240			;Greater than or equal to 5meg?		bcs	exit201		lda	#Type3_5		;3.5" disk icon type, just in case.		cpx	#800			;400k?		beq	exit201		cpx	#1600			;800k?		beq	exit201		cpx	#2880			;14.4M?		beq	exit201		cpx	#3200			;1.6M?		beq	exit201		lda	#TypeRAM		;RAM disk icon, just in case.		cpx	#280			;140k?		bne	exit201			;If not, must be a RAM disk.		lda	#TypeFDrive		;Floppy drive icon.exit201		rtsmapTypes	DC.W	TypeFDrive		;$00 = Disk II		DC.W	TypeHard		;$01 = ProFile 5 meg		DC.W	TypeHard		;$02 = ProFile 10 meg		DC.W	Type3_5			;$03 = Disk 3.5		DC.W	TypeSCSI		;$04 = Generic SCSI		DC.W	TypeHard		;$05 = SCSI hard disk		DC.W	TypeHard		;$06 = SCSI tape drive		DC.W	TypeCDROM		;$07 = SCSI CDROM		DC.W	TypeSCSI		;$08 = SCSI printer		DC.W	0			;$09 = Modem		DC.W	0			;$0A = Consol		DC.W	0			;$0B = Printer		DC.W	0			;$0C = Serial LaserWriter		DC.W	0			;$0D = AppleTalk LaserWriter		DC.W	TypeRAM			;$0E = RAM disk		DC.W	TypeRAM			;$0F = ROM disk		DC.W	TypeServer		;$10 = File server		DC.W	0			;$11 = IBX		DC.W	0			;$12 = AppleDesktop Bus		DC.W	TypeHard		;$13 = Generic hard disk		DC.W	TypeFDrive		;$14 = Generic floppy drive		DC.W	TypeHard		;$15 = Generic tape drive		DC.W	0			;$16 = Generic character		DC.W	Type3_5			;$17 = Super 3.5		DC.W	TypeServer		;$18 = Generic network		DC.W	0			;$19 = Sequential access device		DC.W	TypeSCSI		;$1A = SCSI scanner		DC.W	0			;$1B = Generic scaner		DC.W	TypeSCSI		;$1C = LaserWriter SC		DC.W	0			;$1D = AppleTalk main driver		DC.W	TypeServer		;$1E = AppleShare file server		DC.W	0			;$1F = AppleTalk RPM driver		DC.W	TypeHard		;$20 = Apple's Tape DrivemapTypesEnd				ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Read	the disk's root finder;	   data	file for any open windows.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   icHand = disk icon.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =readRoot	PROC		IMPORT	WStringCopy,PendingDeselectAll; --- Read root	file into buffer --------------------------------------		jsr	makeIcRoot		;C1_PathName = ':' + icName.		PushLong #C1_PathName		PushLong #C1_VolName		jsl 	WStringCopy		; C1_VolName <-- C1_PathName		jsr	addRootName		;C1_PathName = C1_PathName + ':' + FINDER.ROOT		bcs	exit502			;Pathname error?		jsr	doGetFileInfo		bcs	exit502			;Exit if there isn't a FINDER.ROOT file.		lda	info_type		;Get the file's type.		cmp	#DATAFTYPE		;Is it my file type?		bne	exit502			;If not, never mind.		lda	#2000			;Buffer large enough for about 32 windows.		sta	read_size		stz	read_size+2		stz	read_len		ldx	#$4000			;Allocated a locked pathname buffer.		jsr	allocate2		;Allocate a buffer.		sta	<posFile		;Save handle.		stx	<posFile+2		bcc	ok500			;Allocate error?exit502		rtsok500		jsr	derefHand		;temp = (posFile).		sta	read_buff		;Tell future read where buffer is.		stx	read_buff+2		jsr	doRead			;Read FINDER.ROOT.		lda	read_len		;Was anything read?		beq	exit501		cmp	#2000			;Was the max read?		beq	exit501			;If so, might be error so quit.;; --- Process root buffer -------------------------------------------;		lda	[<temp]			;Get ID number.		cmp	#RootVer		;Does it match the number I use to create?		beq	@nativeRoot		cmp	#OldRootVer		bne	exit501			;If not, don't use it.@nativeRoot	lda	#2			Index to first opcode.		sta	pathIndex@loop		ldy	pathIndex		Fetch opcode.		lda	[<temp],y		beq	@done			No more	opcodes?		dec	a			;1 = Open window data		beq	@openWindow				dec	a			;2 = Extended icon data		beq	@openExtIcon		dec	a			;3 = Open window data (with a length word)		beq	@openWindowLong		dec	a			;4 = Extended icon data (with a length word)		bne	@done			If none	of these, then error in	buffer.		jsr	openExtIconLong		bcs	@done			Error?		bra	@loop		@openWindowLong	jsr	openWindowLong		bcs	@done			Error in buffer?		bra	@loop@openExtIcon	jsr	openExtIcon		bcs	@done			Error?		bra	@loop@openWindow	jsr	openWindow		bcs	@done			Error in buffer?*** added 16-Oct-92 DAL -- keyboard navigate in the new window!		lda	#1		sta	>PendingDeselectAll*** end 16-Oct-92		bra	@loop@done		stz	OpenFlag		Reset the special open flag.exit501		pei	<posFile+2		Free the pathname buffer.		pei	<posFile		jsl DisposeHandleGlueexit500		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Put an extended icon	on;	   the desktop from root buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   C1_VolName = volume name.;	   y = offset into buffer that points to data block.;	   temp	= root buffer.;;  OUT:	   Carry set if	error in buffer.;	   pathIndex = offset to next byte to process in buffer.;;	old	 WORD  Opcode -	2.;		 WORD  icFlag;		 WORD  icy;		 WORD  icx;		 WORD  icOldPosY;		 WORD  icOldPosX;		 STRG  icon's pathname, first character is '*'.;;	new	 WORD  Opcode -	4.;		 WORD  icFlag;		 WORD  icy;		 WORD  icx;		 WORD  icOldPosY;		 WORD  icOldPosX;		 WSTR  icon's pathname, first character is '*'.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =openExtIconLong	PROC		IMPORT	WStrCompare		IMPORT	OptionBuff		IMPORT	PStringCompare		IMPORT	C1_BootName		IMPORT	strSystem		stz	longflag		dec	longflag		bra	openIcon		EXPORT	openExtIconopenExtIcon	stz	longflagopenIcon	iny				;Skip over opcode.		iny		lda	[<temp],y		sta	ticonobj+icFlag		iny		iny		lda	[<temp],y		sta	<yrat		iny		iny		lda	[<temp],y		sta	<xrat		iny		iny		lda	[<temp],y		sta	ticonobj+icOldPosY		iny		iny		lda	[<temp],y		sta	ticonobj+icOldPosX		iny		iny		lda	longFlag		bpl	@old				lda	#MaxPathLen		jsr	fetchPathLong		C1_PathName = extended icon's pathname.		bcc	ok660			Pathname too long?		rts@old		lda	#MaxPathLen		jsr	fetchPath		C1_PathName = extended icon's pathname.		bcc	ok660			Pathname too long?		rtsok660		sty	pathIndex		Next byte to process.		jsr	doGetFileInfo		bcc	ok999		brl	exit661			Something wrong! So ignore icon.ok999		lda	info_type		Set file type.		sta	<fileType		lda	info_access		; set read access		and	#$0001			; check read enabled		beq	set1			; not set !		lda	ticonobj+icFlag+2		ora	#ICREADABLE>>16		; set our bitset1		sta	ticonobj+icFlag+2		ldx	#0			Set locked state.		lda	info_access		and	#$0080			Just checking destroy enable bit.		bne	store660		ldx	#ICLOCKEDstore660	txa				merge lock status with color		ora	ticonobj+icFlag		and put	back.		sta	ticonobj+icFlag		ldy	#6dateLoop3	lda	info_cdate,y		Get create date.		sta	ticonobj+icCDate,y		lda	info_mdate,y		Get modified date.		sta	ticonobj+icMDate,y		dey		dey		bpl	dateLoop3		lda	info_blocks		Get blocks used	(size of file).		sta	ticonobj+icFBlocks		lda	info_blocks+2		sta	ticonobj+icFBlocks+2		lda	info_eof		Get bytes used	(size of file).		sta	ticonobj+icFBytes		lda	info_eof+2		sta	ticonobj+icFBytes+2		lda	info_access		sta	ticonobj+icLocalAccess		ldy	OptionBuff+2@loop		lda	OptionBuff+2,y		sta	ticonobj+icOptionList,y		dey		dey		bpl	@loop		lda	OptionBuff+4		;we can only get privs info on		cmp	#AppleShareFST		;stuff on AppleShare		bne	@notFolder		lda	<filetype		;we can only get privs info on folders		cmp	#$0f		beq	@isFolder		cmp	#typeServer		bne	@notFolder@isFolder	lda	OptionBuff+$2A		sta	ticonobj+icNetworkAccess		lda	OptionBuff+$2C		sta	ticonobj+icNetworkAccess+2		bra	@wasFolder@notFolder	stz	ticonobj+icNetworkAccess		stz	ticonobj+icNetworkAccess+2@wasFolder		stz	ticonobj+icForked		lda	info_store		cmp	#$05			; is this file extended ?		bne	aux		lda	#$8000		sta	ticonobj+icForked		clc		lda	ticonobj+icFBlocks	; add in resource blocks		adc	info_rsrc_blks		sta	ticonobj+icFBlocks		lda	ticonobj+icFBlocks+2		adc	info_rsrc_blks+2		sta	ticonobj+icFBlocks+2		clc		lda	ticonobj+icFBytes		adc	info_rsrc_eof		sta	ticonobj+icFBytes		lda	ticonobj+icFBytes+2		adc	info_rsrc_eof+2		sta	ticonobj+icFBytes+2		aux		lda	info_aux		Get Aux type (added 05/31/88 DJB)		sta	ticonobj+icFileInfo		sta	auxType		pei	<temp+2			Save pointer to	root buffer.		pei	<temp 		jsr	findLastName		lastName = last	name in	pathname.		lda	lastName		and	#$00FF			;get length byte		pha		lda	C1_PathName		Cut last name off pathname		clc		sbc	1,s		sta	C1_PathName		plx		jsr	path2ticon		Move pathname into icOwner field.		;; see if it's the system folder we're puttin' back on the desktop;		lda	<filetype		cmp	#$0F		bne	@notSystem		stz	auxtype		pha		pushlong #lastName		pushlong #strSystem		jsl	PStringCompare		pla		beq	@notSystem		pha				;space for result		PushLong #C1_Pathname		PushLong #C1_BootName		jsl	WStrCompare		;is this the boot disk ?		pla		beq	@notSYSTEM		;no		lda	#$0002			;yes, so mark system folder		sta	auxtype;; we got past the system folder kludge (yippee!);@notSYSTEM		stz	ExtCopy			Make an	extended icon.		inc	ExtCopy		jsr	toDesktop		jsr	toDeskPort		Switch to desktop port.		lda	RootIconHandle		sta	ticonobj+icDisk		lda	RootIconHandle+2		sta	ticonobj+icDisk+2		lda	#lastName		ldx	#lastName>>16		ldy	#0		jsr	addIconObj		bcc	@iconOK		stz	ExtCopy			Turn off extended icon maker.		pulllong <temp		rts		@iconOK		jsr	lockic		jsr	drawIcon2		Draw the new ICONOBJ.		jsr	unlockic		stz	ExtCopy			Turn off extended icon maker.		pulllong <tempexit661		clc				Return OK flag.exit660		rts;; locals;longflag	dc.w	0		EXPORT	RootIconHandleRootIconHandle	dc.L	0		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Open	a window from data;	   in root buffer.; = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   C1_VolName = volume name.;	   y = offset into buffer that points to data block.;	   temp	= root buffer.;;  OUT:	   Carry set if	error in buffer.;	   pathIndex = offset to next byte to process in buffer.;; = = =	= = = =	= = = =	= = = =	= = = =	= =openWindowLong	PROC		iny				;Skip over opcode.		iny		lda	[<temp],y		;Get length of pathname.		sec				;An extra byte for the string length byte,		adc	pathIndex		;plus the current index,		inc	a			;plus two bytes for the opcode,		inc	a		inc	a			;plus 1 extra byte for the word string		sta	pathIndex		;equals index to next opcode.				lda	#MaxPathLen		jsr	fetchPathLong		;Fetch window's pathname.		bcs	err650			;Pathname too long?		bra	openWordWindow				EXPORT	openWindowopenWindow	iny				;Skip over opcode.		iny		lda	[<temp],y		;Get length of pathname.		and	#$00FF		sec				;An extra byte for the string length byte,		adc	pathIndex		;plus the current index,		inc	a			;plus two bytes for the opcode,		inc	a		sta	pathIndex		;equals index to next opcode.		lda	#MaxPathLen		jsr	fetchPath		;Fetch window's pathname.		bcs	err650			;Pathname too long?openWordWindow	jsr	ckIfWindMax		;Is there enough memory to create a window?		bcs	err650		pei	<curWind+2		;Save data around call to openFolder2.		pei	<curWind		pei	<icHand+2		pei	<icHand		pei	<temp+2		pei	<temp						;curWind = window that owns open icon.						;icHand = opening icon.		stz	OpenFlag		;Set special open flag to show window is		inc	OpenFlag		;not being opened from an icon.		jsr	openFolder2		stz	OpenFlag		;Clear special open flag.		pla		sta	<temp			;restore data		pla		sta	<temp+2		pla		sta	<icHand		pla		sta	<icHand+2		pla		sta	<curWind		pla		sta	<curWind+2err650		rts		ENDP; = = =	= = = =	= = = =	= = = =	= =;	   Fetch pathname.; = = =	= = = =	= = = =	= = = =	= =;;   IN:	   a = maximum pathname	length to allow.;	   y = index into buffer;	   temp	= pointer to buffer;	   C1_VolName = volume name in the form ':VOL';;  OUT:	   y = index to	byte after name	in buffer;	   C1_PathName = name in C1_VolName plus name pointed to by Y;	   Carry set if	name too long (error);; = = =	= = = =	= = = =	= = = =	= =fetchPathLong 	PROC		IMPORT	WStringCopy				stz	longFlag		dec	longFlag		bra	getLongPath		EXPORT	fetchPathfetchPath	stz	longFlaggetLongPath	sta	maxLength		;Remember maximum pathname to allow.		phy		PushLong #C1_VolName		PushLong #C1_PathName		jsl	WStringCopy		; C1_PathName <-- C1_VolName		ldx	C1_PathName		;get offset into pathname		inx		ply				lda	[<temp],y		;Make sure name won't be too long		and	#$00FF			;get length byte		bit	longflag		bpl	@notLong				lda	[<temp],y		;Make sure name won't be too long@notLong	clc		adc	C1_PathName		dec	a			;less '*' character		cmp	maxLength		bcs	@exit			;error out if name too long		sta	C1_PathName		;set new length.		iny				;skip length byte		iny				;skip '*'				lda	longflag		beq	@notLong2		iny@notLong2		sep	#$20		LONGA	OFF@loop		lda	[<temp],y		bit	longflag		;if we're working with a long path, don't change '/' to ':'		bmi	@cont				cmp	#'/'		bne	@cont		lda	#SEPARATOR		;change '/' to ':' -DJB@cont		sta	C1_PathName+1,x		iny		inx		cpx	C1_PathName		;done ?		bcc	@loop		beq	@loop		clc				;return OK flag		rep	#$20		LONGA	ON@exit		rts;; locals;longflag	dc.w	0		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Match icon name to lastName.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   lastName = name to match.;	   ic =	pointer	to ICONOBJ.;;  OUT:	   Carry set if	lastName matches icon's name.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =matchIcName	PROC	EXPORT		IMPORT	PStringCompare		pha				; space for result		PushLong #lastName		; ptr to string 1		lda	<ic		clc		adc	#icName		tax		lda	<ic+2		adc	#0		pha				; ptr to string 2		phx		jsl	PStringCompare		pla				; result (0 or 1)		cmp	#1			; update carry flag		rts		ENDPdoSetPrefix2	PROC	EXPORT		ldx	#C1_PathName		;lo-word		ldy	#^C1_PathName		;hi-word;=========================================;;   IN:	   x = low word	address	of pathname.;	   y = high word address of pathname.;;=========================================		EXPORT	doSetPrefixdoSetPrefix		stx	prefix_name		;store pointer to pathname		sty	prefix_name+2				stz	null_prefix_num		;set prefix 0 to null		jsl	ProDOS		DC.W	SET_PREFIX+C1		DC.L	null_prefix_list		lda	#8			;set prefix 8 to null		sta	null_prefix_num		jsl	ProDOS		DC.W	SET_PREFIX+C1		DC.L	null_prefix_list		stz	prefix_num		;try setting prefix 0		jsl	ProDOS		DC.W	SET_PREFIX+C1		DC.L	prefix_list				lda	#8			;try setting prefix 8		sta	prefix_num		jsl	ProDOS		DC.W	SET_PREFIX+C1		DC.L	prefix_list@done		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Set file position mark.; = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   a = position.;; = = =	= = = =	= = = =	= = = =	= = = =	= =doSetMark	PROC	EXPORT		sta	mark_pos		lda	open_num		sta	mark_num		jsl	ProDOS		DC.W	SET_MARK+C1		DC.L	mark_list		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;	   Search driectory for	filename.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =;;   IN:	   pathname = pathname of file to get info of.;;  OUT:	   Carry clear if no error, file found.;	   Carry set if	error, a = $46 if file not found.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= =doGetFileInfo	PROC	EXPORT		jsl	ProDOS		DC.W	GET_FILE_INFO+C1		DC.L	info_list		rts		ENDP; = = =	= = = =	= = = =	= = = =	= =;	   Create a file.; = = =	= = = =	= = = =	= = = =	= =;;   IN:	   C1_PathName = pathname of file to create.;	   file_type = file type.;	   aux_data = whatever.;	   NoDOSerr = TRUE to ignore DOS errors.;;  OUT:	   Carry clear if file created.;	   Carry set if	error.;; = = =	= = = =	= = = =	= = = =	= =doCreate	PROC	EXPORT		jsl	ProDOS		DC.W	CREATE+C1		DC.L	create_list		ldx	NoDOSerr		;Ignore DOS errors?		bne	exit3		bcs	ProDOSerrexit3		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Handle some general ProDOS errors.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   a = error code.;;  OUT:	   a = ProDOS error code.;	   x = result from dialog:    $8000 if no dialog put up.;				      $FFFF Cancel selected.;				      $0001 OK selected.;				      $0002 Try	Again selected.; Errors Handled:;;	   Error			   X returned.;	   $0049 Disk directory	full.	   Cancel.;	   $0048 Disk full.		   Cancel.;	   $002B Write-protected.	   Cancel, Try Again.;	   $0045 Volume	not found.	   Cancel, OK.;	   $0040 Pathname syntax.	   OK.;	   $004E No Access Privileges.	   OK.;	   $0050 File is busy.		   OK.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	ProDOSerrProDOSerr		IMPORT	C1_PathNamePtr		IMPORT	doAlertWindow		IMPORT	C1_Source		IMPORT	C1_PathName		IMPORT	PathGetRoot		sta	errorCode		tax		bne	@error		clc		rts@error; ------ Volume	directory full error ---------------------------------		ldx	#rasDirFull			;resource number		cmp	#$0049		bne	@tryDiskFull		jsr	tellError		ldx	#$FFFF		sec		lda	errorCode		rts;; ------ Disk full error ----------------------------------------------;@tryDiskFull		ldx	#rasDiskFull		cmp	#$0048		bne	@tryWriteProtected		jsr	tellError		ldx	#$FFFF		sec		lda	errorCode		rts;; ------ Disk is write-protected error --------------------------------;@tryWriteProtected		ldx	#rasWriteProtected		cmp	#$002B		bne	@tryVolume		jsr	tellError		eor	#$ffff		cmp	#$ffff		bge	@cancelWP		lda	#2		;try again		sec@cancelWP		tax		lda	errorCode		rts;; ------ Volume	not found ---------------------------------------------;@tryVolume		cmp	#$0045		bne	@tryAccess		pushlong #c1_source		pushlong #c1_pathname		jsl	PathGetRoot		lda	>c1_source		and	#$00ff		dec	a		xba		sta	>c1_source+1		ldx	#rasInsertDiskOrCancel8		jsr	tellError		eor	#$ffff		cmp	#$ffff		bge	@cancelVol		lda	#1		;OK		sec@cancelVol	tax		lda	errorCode		rts;; ------ Invalid Access error ---------------------------------------;@tryAccess		ldx	#rasNoAccess		cmp	#$004E		bne	@tryBusy@wasBusy	jsr	tellError		ldx	#1		sec		lda	errorCode		rts;; ------ File Busy error ---------------------------------------;@tryBusy		ldx	#rasFileBusy		cmp	#$0050		beq	@wasBusy@none		ldx	#$8000			Return 'no dialog put up' flag.		sec				;and say nothing wrong!!		rts;; say what the error was, and use AlertWindow to do it;tellError	txa		jsl	doAlertWindow		rts;; locals;errorCode	dc.w	0		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Open, Read, Close a file.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   pathname = name of file to read.;	   read_buff = address of destination buffer.;	   read_size = number of bytes to read.;;   OUT:   Carry clear if file read.;	   Carry set if	error.;; = = =	= = = =	= = = =	= = = =	= = = =	= = =doRead		PROC	EXPORT		ldx	#C1_PathName		ldy	#^C1_PathName		EXPORT	read2read2		lda	#$0001			; open read only		jsr	open_file		bcs	exit2		jsr	read_file2exit		php		pha		jsr	close_file		pla		plpexit2		rts; = = =	= = = =	= = = =	= = = =	=;	   Open	a file.; = = =	= = = =	= = = =	= = = =	=;;   IN:	   x = low word	address	of pathname.;	   y = high word address of pathname.;	   a = request access;;  OUT:	   Carry flag is clear if file opened.;	   Else, a = 0 if user wants operation aborted,;		   = nonzero if	new pathname in	lbuffr.;; = = =	= = = =	= = = =	= = = =	=		EXPORT	open_fileopen_file		sta	open_request		stx	open_name		Address	of pathname to open.		sty	open_name+2		stz	open_num		; in case open has error		jsl	ProDOS		DC.W	OPEN+C1		DC.L	open_list		rts; = = =	= = = =	= = = =	= = = =	=;	   Read	a file.; = = =	= = = =	= = = =	= = = =	=;;   IN:	   x = low word	address	of buffer to read into.;	   y = high word address of buffer to read into.;;  OUT:	   Carry = set if error, A = error code.;; = = =	= = = =	= = = =	= = = =	=		EXPORT	read_fileread_file		stx	read_buff		Pass address of	buffer to read into.		sty	read_buff+2		EXPORT	read_file2read_file2; = = =	= = = =	= = = =	= = = =	=;;   IN:	   read_buff = address of buffer to read data into.;; = = =	= = = =	= = = =	= = = =	=		lda	open_num		Pass reference number of opened	file.		sta	read_num		jsl	ProDOS		DC.W	READ+C1		DC.L	read_list		rts; = = =	= = = =	= = = =	= = = =	= = = =;	   Write to a file.; = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   C1_PathName = pathname of where to write file.;	   write_buff =	address	of buffer to write.;	   write_len = number of bytes to write.;;  OUT:	   Carry clear if file written.;	   Carry set if	error.;; = = =	= = = =	= = = =	= = = =	= = = =		EXPORT	doWritedoWrite		lda	write_len		Is there anything to write?		ora	write_len+2		bne	ok20		jsl	ProDOS			Delete the file.		DC.W	DESTROY+C1		DC.L	destroy_list		rtsok20		ldx	#C1_PathName		ldy	#^C1_PathName		lda	#$0003			; read/write access		jsr	open_file		bcc	ok1			Can't even open?		cmp	#$0046			Not found?		bne	errorOut		jsr	doCreate		Create the file.		bcc	doWrite			Try now	if no error.		rtserrorOut	sec		rtsok1		lda	open_num		Pass reference number of file.		sta	write_num		sta	EOF_num		jsl	ProDOS		DC.W	WRITE+C1		DC.L	write_list		php		lda	written		sta	EOF_place		lda	written+2		sta	EOF_place+2		jsl	ProDOS		DC.W	SET_EOF+C1		DC.L	EOF_list		jsr	close_file		plp		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Close last opened file.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   Needed information is in open_list.;;  OUT:	   Carry = set if error, A = error code.;; = = =	= = = =	= = = =	= = = =	= = = =	= = =		EXPORT	close_fileclose_file		lda	open_num		sta	close_num		jsl	ProDOS		DC.W	CLOSE+C1		DC.L	close_list		rts; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Check for a Partitioned device.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;;   IN:	   a = device icon type;;  OUT:	   a = TypeHardPart  	if HD partition;	       TypeCDROMPart 	if CD ROM partition.;	       TypeSCSIPart 	if SCSI partition.;	       original type	if not a partitioned device.;; = = =	= = = =	= = = =	= = = =	= = = =	= = =chkPartition	PROC	EXPORT		IMPORT	DeviceCharacteristics		pha		cmp	#TypeHard		beq	ok		cmp	#TypeCDROM		beq	ok		cmp	#TypeSCSI		bne	noPartok		lda	DeviceCharacteristics 	;check for linked device		and	#$2000			;linked bit set?		beq	noPart			;no		pla		cmp	#TypeHard		bne	cont1		lda	#TypeHardPart		bra	donecont1		cmp	#TypeCDROM		bne	cont2		lda	#TypeCDROMPart		bra	donecont2		lda	#TypeSCSIPartdone		rtsnoPart		pla		rts		ENDP;==============================================;  Get the access privileges for a folder;; IN:	C1_PathName; OUT:	AccessPriv (0 if not from network);==============================================GetAccessPriv	PROC	EXPORT		stz	AccessPriv		jsl	ProDOS		DC.W	FST_SPECIFIC+C1		DC.L	ap_list		bcs	exit			; ignore errors		lda	ap_access		; get User rights (bits 0..2)		and	#$0007		tsb	AccessPriv		lda	ap_access		; get User ownership (bit 7)		and	#$0080		lsr	a		lsr	a		lsr	a		lsr	a		tsb	AccessPriv		lda	ap_access+1		; get World rights (bits 8..10)		and	#$0007		asl	a		asl	a		asl	a		asl	a		tsb	AccessPriv		lda	ap_access+2		; get Group rights (bits 16..18)		and	#$0007		xba		tsb	AccessPriv		lda	ap_access+3		; get Owner rights (bits 24..26)		and	#$0007		xba		asl	a		asl	a		asl	a		asl	a		tsb	AccessPrivexit		rtsap_list		DC.W	4			; pcountap_fst		DC.W	$0D			; FST id (AppleShare)ap_cmnd		DC.W	4			; GetPrivilegesap_path		DC.L	C1_PathName		; pathname to directoryap_access	DC.L	0		ENDP;; Load any old style, then new style icons from icon files and desktop files on this volume;;   IN:	   newVolName =	name of	volume to check.;.....................................................................LoadIcons	PROC	EXPORT		IMPORT	iconsName		IMPORT	desktopName		IMPORT	PToWString		IMPORT	PStringCompare		IMPORT	WStrCompare		IMPORT	WStringCopy		IMPORT	PStringCopy		IMPORT	FindersICXBlkN		IMPORT	PathAddName		IMPORT	PathSubName		IMPORT	LoadRBundle		IMPORT	c1_bootname		IMPORT	fileSysID		IMPORT	BootFST		IMPORT	BundleID		IMPORT	FinderPathID		IMPORT	IconListID		IMPORT	NewHandle		IMPORT	LoadResources		IMPORT	fileTypeList,ftypeInsertList		IMPORT	NameChain,NameChainInsert,NameChainEnd		IMPORT	MasterChain,MasterChainInsert,MasterChainEnd				phb		phk		plb;; Copy the insertion lists into a safe place;		lda	StartupFlag		bne	@getVolHandle		;; This isn't being called at startup time, so make sure that any new icons get inserted at the head of the; list;		ldx	#((256*4)*2)-2		;copy 2 tables@iLoop		lda	>fileTypeList,x		sta	>fTypeInsertList,x		dex		dex		bpl	@iLoop		lda	>MasterChain		sta	>MasterChainInsert		lda	>MasterChain+2		sta	>MasterChainInsert+2				lda	>NameChain		sta	>NameChainInsert		lda	>NameChain+2		sta	>NameChainInsert+2;; Allocate a handle to save the name of this volume (and attach it to the rBundle resource in memory);@getVolHandle	pha		pha		lda	>c1_volname		;number of bytes to allocate		inc	a		inc	a		pha		jsl	NewHandle				pla		sta	<handle		sta	volumeNameHandle		pla		sta	<handle+2		sta	volumeNameHandle+2		bcs	@bad		lda	[<handle]		tax		ldy	#2		lda	[<handle],y				pushlong #c1_volname		;DON'T do anything which could move		pha				;memory inside of WStringCopy!		phx		jsl	WStringCopy*** %%% - 1-Apr-93 JCM - Why are we doing this here, when we do the same thing down below at***		         @localDisk? I'm confused again... I'll nuke it for 6.0.2.		pushlong #C1_VolName		pushlong #C1_PathName		jsl	WStringCopy		lda	#IconsName		; add 'ICONS' to pathname		ldx	#IconsName>>16		jsr	addName		bcc	@LoadDesktopIcons@bad		plb		rtl*** %%% - 1-Apr-93 JCM JCM;; first, try to load some -real- icons from rBundle resources in a desktop file which; must be in the icons folder.;; As a side note, I'm doing this less than 10 hours before GM.  I re-arranged the order in which; the chains are searched, and because of that, the first loaded stuff gets searched first on a; particular volume, so the Desktop file HAS to be loaded first, then the regular icons.;; andy -- 2/9/92, 12:50 AM;@LoadDesktopIcons*** Changed - 1-Apr-93 JCM - This is the confusing way it used to work. We now load icons from the***		             Desktop file in @ if we're booted from an AppleShare server.;		pha;		pushlong #c1_volname		;if it's the boot volume, skip it;		pushlong #c1_bootname;		jsl	WStrCompare;		pla;		beq	@notBootVolume;		;		lda	fileSysID		;save the boot fst for later when we check ;		sta	BootFST			;;		bra	@AShareBoot		;@@@ used to be bra @doneLoading;;@notBootVolume	lda	fileSysID		;don't load icons from appleshare volumes unless it's ;		cmp	#AppleShareFST		;their boot volume (which is done elsewhere);		beq	@doneLoading;	;@AShareBoot	pushlong #c1_volname;		pushlong #c1_pathname;		jsl	WStringCopy		;		;		pushlong #IconsName;		pushlong #c1_pathname;		jsl	PathAddName;;		jsl	loadNewIcons;@doneLoading			lda	fileSysID		;save the boot FST for use by GetInfo.aii for comment cards		sta	BootFST		cmp	#AppleShareFST		;is this an AppleShare volume?		bne	@localDisk		; nope, load both types of icons* Since this disk is AppleShare, if it's not the boot volume, don't load any icons from a* desktop file in the icons folder.		pha		pushlong #c1_volname		pushlong #c1_bootname		jsl	WStrCompare		pla		beq	@loadOldStyleIcons	; not boot vol, just do old icons* Since we're net booted, load new-style icons from "@:Desktop".				lda	#1		sta	c1_pathname		;length of the string		lda	#'@'		sta	c1_pathname+2		;the pathname		jsl	loadNewIcons		;load any icons in @:Desktop* Load the new-style icons from "<c1_volname>:Icons:Desktop".	@localDisk	pushlong #c1_volname		pushlong #c1_pathname		jsl	WStringCopy						pushlong #IconsName		pushlong #c1_pathname		jsl	PathAddName		jsl	loadNewIcons@loadOldStyleIcons*** End - 1-Apr-93 JCM;; --- Catalog :VOL:ICONS ------------------------;		PushLong #C1_PathName		; pass window's pathname		ldx	#xStartCatalog		jsl	MiscEntry		bcc	@loop		brl	@done@loop		pha				; space for result		pha		ldx	#xNextCatalog		jsl	MiscEntry		pla		plx		bcc	@entryOK		brl	@done			; done?@entryOK		sta	<work			; save pointer to directory entry		stx	<work+2		ldy	#DirFType		; pass filetype to addIconObj		lda	[<work],y		and	#$00FF		cmp	#ICON_TYPE		; is the file the correct type?		bne	@loop		ldy	#DirAuxType		;see if we've already converted this icon file		lda	[<work],y		;if it's got its high bit set, then its been		bmi	@loop			;converted (or, don't load it)		cmp	#$1000			;or, if it's a desktop file, don't convert(?!)		beq	@loop			;it, don't even try...		pha				;don't convert the Finder.Icons file		PushLong #FindersICBlkN		PushZLong <work		jsl	PStringCompare		pla		bne	@loop		pha				;don't convert the Finder.Icons.X file either		pushlong #FindersICXBlkN		pushZLong <work		jsl	PStringCompare		pla		bne	@loop;; Filename isn't anything that we've converted to the new icon format, so load; and convert it;		lda	#$1000-$400		sta	rBundleSize		stz	rBundleSize+2				pha				Space for result.		pha		pushlong #$1000			;4k should be adequate for now		lda	<MyID			;this will become a bundle resource (maybe)		and	#$F0FF		ora	#$0700		pha		pea	$8000			;attributes (locked)		pha				;address, not used.		pha		_NewHandle		pulllong <handle*** Fixed - 31-Mar-93 JCM - We would die big-time if we got an error.;;;		bcc	@ok;;;		rts			bcs	@done*** End - 31-Mar-93 JCM@ok		ldy	#6		lda	>BundleID		sta	[<handle],y				jsr	derefHandleToPtr		lda	C1_PathName		Save length of current pathname.		pha		lda	<work			Add filename to	pathname.		ldx	<work+2		phx		pha		pea	C1_FileName>>16		pea	C1_FileName		jsl	PToWString		;to class 1		lda	#C1_FileName		ldx	#C1_FileName>>16		jsr	addName		jsr	convertOldIcons		;load and convert icon file		bcc	@err		pushZLong <handle		jsl DisposeHandleGlue@err		pla				;Restore length of pathname.		sta	C1_PathName		brl	@loop			;Next entry in icon directory.@done		ldx	#xEndCatalog		jsl	MiscEntry		plb		rtl;; LoadNewIcons, load a new set of icons out of someone's desktop file which is either in; :Volume:ICONS:Desktop or @:Desktop (if we're the AppleShare boot volume) ;.....................................................................		EXPORT	LoadNewIconsLoadNewIcons	name		phb		phk		plb		pushlong #DesktopName		pushlong #c1_pathname		jsl	PathAddName		pha		pha		pea	3			;process all rbundles (preload them all and mark their maps as loaded)		pea	0		pea	$0040		lda	<MyID		ora	#$0100		pha		pushlong #c1_pathname		jsl	LoadResources		pulllong <handle		bcc	@DesktopOK		brl	@noRBundle@DesktopOK				lda	[<handle]		sta	<ptr		ldy	#2		lda	[<handle],y		sta	<ptr+2		pha		pea	1			;need only read access, ok to preload		pushZLong <ptr		pushlong #c1_pathname		_OpenResourceFile				php		pushZLong <handle		jsl DisposeHandleGlue		plp				pla		sta	resourceFileID		bcs	@noRBundle		pha		pea	1		_SetResourceFileDepth		pla		sta	oldDepth		lda	#1		sta	rBundleIndex		stz	rBundleIndex+2@resLoadLoop	pha		pha		pea	$802B			;rBundle		pushlong rBundleIndex		_GetIndResource		plx		pla		bcs	@doneResLoad		stx	rBundleIndex		sta	rBundleIndex+2		pha				;space for rBundleHandle		pha		pea	0			;user icons, not finder icons		pushlong volumeNameHandle		pea	0			;we not doing this by handle 		pushlong rBundleIndex		;resource ID we just got (and are going to load)		jsl	loadRBundle		pla		pla		inc	rBundleIndex		bne	@resLoadLoop		inc	rBundleIndex+2		bra	@resLoadLoop@doneResLoad	lda	resourceFileID		pha		_CloseResourceFile		pha		lda	oldDepth		pha		_SetResourceFileDepth		pla@noRBundle	pushlong #c1_pathname		jsl	pathSubName		plb		rtl;; Install and show Trash can icon;.....................................................................		EXPORT 	InstallTrashcanInstallTrashcan		IMPORT	toDesktop		IMPORT	toDeskPort		IMPORT	addIconObj		IMPORT	lockIc		IMPORT	unlockIc		IMPORT	drawIcon2		IMPORT	addIconObj		IMPORT	setOrgnMask		import	wind_param		import	wind_frame		import	RectListPtr		import	TrashWindowEnd		import	TrashWindowStart		import	wind_guts		phb		phk		plb		jsr	toDesktop		windBlk	= desktop icon list.		jsr	toDeskPort		Switch to desktop port.		lda	#TypeTrash		Empty Trash can	file type.		sta	<filetype		stz	auxtype		lda	rectListPtr		sta	ptr		lda	rectListPtr+2		sta	ptr+2				ldy	#72+2		lda	[<ptr],y		sta	<yrat		iny		iny		lda	[<ptr],y		sta	<xrat		ldy	#80+6+2			;move the trashcan window rectangle		ldx	#6@loop		lda	[<ptr],y		sta	wind_pos,x		dey		dey		dex		dex		bpl	@loop				lda	#ICBACKCLR		Solid white background,	black outline.		sta	ticonobj+icFlag		lda	#ICREADABLE>>16		sta	ticonobj+icFlag+2	;added DJB 12/06/88;--- set the Trash's create date ---------------		ldx	#6@date		stz	ticonobj+icCDate,x		stz	ticonobj+icMDate,x		dey		dey		bpl	@date		stz	<devNumber		stz	ticonobj+icLocalAccess		stz	ticonobj+icForked		stz	ticonobj+icNetworkAccess		stz	ticonobj+icNetworkAccess+2		stz	ticonobj+icOptionList		lda	#trashBlk+windMenuText	;Pass icon's name.		ldx	#trashBlk+windMenuText>>16		ldy	#0			;add icon to the head of the list		jsr	addIconObj		bcs	@to_error		jsr	lockic				ldy	#icDisk			;stuff our own icon handle into our icDisk field,		lda	<icHand			;creating a reference to ourself as being a root		sta	[<ic],y			;icon		iny		iny		lda	<icHand+2		sta	[<ic],y		jsr	drawIcon2		;Draw the trash can.		lda	<icHand			;Store the trash icon handle in the trash		sta	>TrashIc		;window's info block as the icon that		sta	>trashBlk+windDiskIc		lda	<icHand+2		;opened into the window.		sta	>TrashIc+2		sta	>trashBlk+WindDiskIc+2;; Open an invisible Trash window;				ldx	#TrashWindowEnd-TrashWindowStart@loop2		lda	>TrashWindowStart,x		sta	>wind_param,x		dex		dex		bpl	@loop2		lda	>TrashWindowStart		sta	>wind_param			lda	wind_frame		and	#$FFDF		sta	wind_frame					pha				;Space for result.		pha		PushLong #wind_param		;Pass pointer to NewWindow parameter list.		_NewWindow@to_error	bcs	@error		ldy	#icWind			Store pointer to Trash window in Trash		pla				icon's open window field.		sta	<TrashWind		sta	<wind		sta	[<ic],y		iny		iny		pla		sta	<TrashWind+2		sta	<wind+2		sta	[<ic],y*** added 25-Mar-93 DAL (took the flag bits out of the wind_params template)		pushlong #wind_guts+$C0000000		pei <TrashWind+2		pei <TrashWind		_SetContentDraw*** end 25-Mar-93		jsr	unlockic		Leave with Trash icon unlocked.		jsr	setOrgnMask		clc		@error		lda	wind_frame		ora	#$0020			;invisible bit for frame		sta	wind_frame				plb		rtl;; locals;oldDepth	dc.w	0rBundleIndex	dc.L	0resourceFileID	dc.w	0		EXPORT	volumeNameHandlevolumeNameHandle dc.L	0; Convert old icons to the new 'desktop' icon file format;;   IN:	   C1_PathName 	= full pathname of ICONBLK file to load.;	   handle	= handle to block for rBundle;	   ptr		= pointer to block for rBundle;;  OUT:	   icBlkHand = ICONBLK's handle.;.....................................................................ConvertOldIcons		IMPORT	IconHandleArray		IMPORT	IconOffsetArray		IMPORT	IconArrayUsed		IMPORT	IconArraySize		IMPORT	WStrCompare		import	UnlockICBLKHAND		;22-Mar-93 JCM		stz	lastRFPathHandle		stz	lastRFPathHandle+2				ldx	#C1_PathName		;lo-word		stx	<work		ldy	#C1_PathName>>16	;hi-word		sty	<work+2		lda	#1			; read access only		jsr	open_file		bcc	@openOK		rts;; Allocate a block big enough to hold the entire icon file, then read the icon file into that; block;@openOK		pha				;Space for result.		pha		lda	open_eof+2		Pass size of block needed.		sta	read_size+2		pha		lda	open_eof		sta	read_size		pha		lda	<MyID			;mark this with an icon file ID		and	#$F0FF		ora	#$0800		pha		pea	$c000			;attributes.		pha				;address, not used.		pha		_NewHandle		pulllong <icBlkHand		bcc	@gotHandle		rts@gotHandle				lda	[<icBlkHand]		sta	<icBlk		ldy	#2		lda	[<icBlkHand],y		sta	<icBlk+2;; Now, read the icon file into memory;@fit		ldx	<icBlk			Buffer to read into.		ldy	<icBlk+2		jsr	read_file		bcc	@readOK		brl	errorOut2		Error?@readOK		jsr	close_file		bcc	@closeOK		brl	errorOut2		Error?@closeOK;; do a quick check to see if this is really an genuine Apple IIGS Finder icon file;		ldy	#IBlkID			Check block's ID.		lda	[<icBlk],y		cmp	#$0001		beq	@idOK		brl	errorOut2		Error if wrong ID number.@idOK;; initialize the rBundle resource;		lda	#$8000			;our version number is zero with the high		sta	[<ptr]			;bit set to indicate that we were converted		ldy	#2		lda	#16			;offset to DocList structure		sta	[<ptr],y		ldy	#4			;rIcon ID for the App (NIL)		lda	#0@zLoop		sta	[<ptr],y		;zero the rBundle's Icon ID, rBundleID,		iny				;volumeNameHandle, and number of OneDocs		iny		cpy	#18		blt	@zLoop		lda	#26		clc		adc	<icBlk		sta	<icon		lda	<icBlk+2		adc	#0		sta	<icon+2		lda	ptr		clc		adc	#18		sta	ptr2		lda	ptr+2		adc	#0		sta	ptr2+2		jsr	MakeArrayPtrs		;; now, for each time through this loop, move the old icon stuff to the new icon format;@loop		lda	[<icon]		bne	@anotherIcon		brl	@done@anotherIcon		stz	matchFlags		ldy	#66		lda	[<icon],y		tax		and	#$00ff		beq	@noFilename		txa				;if we've got just a '*' for the filename to		cmp	#$2a01			;match by, then don't include a filename field		beq	@noFilename		lda	#matchFilename		ora	matchFlags		sta	matchFlags@noFilename		ldy	#82		lda	[<icon],y		beq	@noFiletype		lda	#matchFiletype		ora	matchFlags		sta	matchFlags@noFiletype		ldy	#84		lda	[<icon],y		beq	@noAuxtype		lda	#matchAuxtype		ora	matchFlags		sta	matchFlags@noAuxtype;; if we have a generic icon, then just go find the next icon in the list, otherwise; stuff the old finder information into OneDoc structures;		lda	matchFlags		bne	@notGeneric		brl	@nextIcon@notGeneric		ldy	#2			;set the offset to the matchFlags field		lda	#32		sta	[<ptr2],y		ldy	#4			;numResults = 4		tya		sta	[<ptr2],y		ldy	#6			;don't launch this (yet)		lda	#0		sta	[<ptr2],y		ldy	#32			;save the stuff which we match by		lda	matchFlags		sta	[<ptr2],y		iny		iny		lda	#0		sta	[<ptr2],y;; is there a filetype to match by?  if so, put it right after the matchflags field;		ldx	#36			;offset after matchFlags		txy		lda	#0			;zero out the filetype field so it can be		sta	[<ptr2],y		;de-rezzed (which it never will be since it's an						;internal data structure thing, but what why not?)		lda	matchFlags		and	#matchFiletype		beq	@notByFiletype		txy		lda	#matchFiletypeID		sta	[<ptr2],y		inx		inx		ldy	#82		lda	[<icon],y		txy		sta	[<ptr2],y;; is there an auxtype to match by?  if so, put it right after the end of the filetype; field;@notByFiletype	inx		inx		txy		lda	#0		sta	[<ptr2],y		lda	matchFlags		and	#matchAuxtype		beq	@notByAuxtype		txy		lda	#matchAuxtypeID		sta	[<ptr2],y		inx		inx		lda	#$FFFF		txy		sta	[<ptr2],y		inx		inx		lda	#0		txy		sta	[<ptr2],y		inx		inx		ldy	#84		lda	[<icon],y		txy		sta	[<ptr2],y		inx		inx		lda	#0		txy		sta	[<ptr2],y;; is there a name to match by?  is so, put it right after the end of the auxtype field;@notByAuxtype	inx		inx		txy		lda	#0		sta	[<ptr2],y		lda	matchFlags		and	#matchFilename		beq	@doneWithFields		txy		lda	#matchFilenameID		sta	[<ptr2],y		inx		inx		phx		lda	<icon			;source pstring		clc		adc	#66		tay		lda	<icon+2		adc	#0		pha		phy		txa				;destination pstring		clc		adc	<ptr2		tay		lda	<ptr2+2		adc	#0		pha		phy		jsl	PStringCopy		plx				;how far into this onedoc we put this		stx	namePtr			;wstring		ldy	#66			;add the length of the pstring to our index		lda	[<icon],y		;into the OneDoc		and	#$00ff		clc		adc	namePtr		tax		dex;; now that we're done with the actual fields involved with the OneDoc structure, we need; to update some pointers and then build the associated rFinderPath resource for this; OneDoc structure (if it has one), and move the icons to their very own handles, saving; the handles;@doneWithFields		inx				;next location, please		inx		stx	nextOneDoc				lda	<icon		clc		adc	#86			;+86 for offset into icon record		sta	<ptr4		lda	<icon+2		adc	#0		sta	<ptr4+2		ldy	#20			;LargeIconReserved		jsr	AddIconToList		bcc	@LargeIconAdded		brl	@done			;use what icons we were able to get@LargeIconAdded;; now, save the offsets of the small icon into our offset array;;		ldy	#2;		lda	[<ptr4],y		;size of the icon image in bytes;		asl	a			;*2 to compensate for the image and its mask;		clc;		adc	#8			;+8 for the icon header data;		adc	#86;		adc	<icon;		sta	<ptr4;		lda	<icon+2;		adc	#0;		sta	<ptr4+2*** fixed 11-Jan-93 DAL to propogate carry correctly		ldy	#2		lda	[<ptr4],y		;size of the icon image in bytes		asl	a			;*2 to allow for image+mask;;;		clc		adc	<icon		sta	<ptr4		lda	<icon+2		adc	#0		sta	<ptr4+2		clc		lda	<ptr4		adc	#86+8			;+8 for the icon header data		sta	<ptr4		bcc	@1		inc	<ptr4+2@1*** end 11-Jan-93		ldy	#28			;SmallIconReserved		jsr	AddIconToList		bcc	@SmallIconAdded		brl	@done			;use what icons we were able to get@SmallIconAdded;; now, after all that grief, make an rFinderPath if there is one to make;		ldy	#8			;rFinderPathID		lda	#0@fpzLoop	sta	[<ptr2],y		iny		iny		cpy	#16		blt	@fpzLoop		ldy	#2		lda	[<icon],y		and	#$00ff		beq	@goNoRFPath		cmp	#2		bge	@gotPath				iny		lda	[<icon],y		and	#$007f		cmp	#'*'		beq	@goNoRFPath		cmp	#':'		beq	@goNoRFPath		cmp	#'/'		bne	@gotPath@goNoRFPath	brl	@noRFinderPath@gotPath;; Now, boys and girls, time for a really neat hack: look at the last rFinderPath handle that was allocated for; this file, and if it matches the icon's boss pathname of the record we're looking at now, don't allocate another; completely new handle for it -- this helps cut down the handle count because often many of the records in any; icon file will, sequentially, have the same icon boss pathname;		lda	lastRFPathHandle+1		beq	@noLastRFPath				lda	lastRFPathHandle		sta	<handle3		lda	lastRFPathHandle+2		sta	<handle3+2				lda	[<handle3]		;deref the handle to the last rFinderPath		sta	<ptr3		ldy	#2		lda	[<handle3],y		sta	<ptr3+2				lda	[<icon],y		;save the length of the icon record and the length of the icon boss		pha		lda	[<icon]					pha				lda	[<icon],y		;get the length of the icon boss name now		and	#$00FF		dey		sta	[<icon],y		;make it a wstring				pha		iny		lda	[<ptr3],y		;last allocated rFinderPath pathname		clc		adc	<ptr3		tax		lda	<ptr3+2		adc	#0		pha		phx				ldx	<icon			;icon boss -1 to compensate for making this a wstring		lda	<icon+2		inx			bne	@nrIcon		inc	a@nrIcon		pha		phx				jsl	WStrCompare				plx				;0 = no match, 1 = match		pla						sta	[<icon]					ldy	#2		pla		sta	[<icon],y		;restore the length of the icon record and the length of the icon boss		txa		beq	@noLastRFPath				ldy	#12			;rFinderPathReserved		lda	<handle3		sta	[<ptr2],y		iny		iny		lda	<handle3+2		sta	[<ptr2],y		brl	@noRFinderPath		;if the last rFinderPath and the new one are the same, don't allocate a						;new one!;; Well, OK, if we end up here we need to allocate a new rFinderPath for this record (and maybe the records which; follow it).;@noLastRFPath	ldy	#2		lda	[<icon],y		and	#$00ff		clc				;6 for the rFinderPath stuff, 2 to make it		adc	#8			;a wString		pha				;Space for result.		pha		pha		jsl	NewHandle		pla		sta	<handle3		;store the handle at our		sta	lastRFPathHandle		ldy	#12			;rFinderPathHandle		sta	[<ptr2],y		iny		iny		pla		sta	<handle3+2		sta	lastRFPathHandle+2		sta	[<ptr2],y		bcc	@finderPathOK		brl	errorOut2		;memory error, ack!@finderPathOK		ldy	#6			;make the ID for an rFinderPath		lda	>FinderPathID		sta	[<handle3],y				ldy	#6			;launch this		lda	#1		sta	[<ptr2],y		lda	[<handle3]		;deref our handle		tax		ldy	#2		lda	[<handle3],y		sta	<ptr3+2		stx	<ptr3		lda	#0			;version		sta	[<ptr3]		ldy	#2		lda	#6			;offset to pathname		sta	[<ptr3],y		iny				;pcount		iny		lda	#0		sta	[<ptr3],y		lda	<icon			;source		clc		adc	#2		tax		lda	<icon+2		adc	#0		pha		phx		lda	#6			;destination wstring		clc		adc	<ptr3		tax		lda	<ptr3+2		adc	#0		pha		phx		jsl	PToWString;; now that we're done fiddling with the rFinderPath resource, make the next offsets for; the next icon record in the finder's old icons file, and the next offset for the next; OneDoc structure;@noRFinderPath	lda	nextOneDoc		;set the size of this OneDoc		sta	[<ptr2]		lda	nextOneDoc		clc		adc	<ptr2		sta	<ptr2		bcc	@nextIcon		inc	<ptr2+2@nextIcon			lda	ptr2		sec		sbc	ptr		sta	CurrentRBSize		lda	ptr2+2		sbc	ptr+2		sta	CurrentRBSize+2				lda	CurrentRBSize		sec		sbc	rBundleSize		lda	CurrentRBSize+2		sbc	rBundleSize+2		bcc	@noResize						ldy	#4			;unlock the handle to resize it		lda	[<handle],y		and	#$3FFF		sta	[<handle],y				lda	<ptr2			;only re-enable this code once we know how		sec				;to grow the handle if the OneDoc gets		sbc	<ptr			;larger		tax		lda	<ptr2+2		sbc	<ptr+2		pha		phx		txa		clc		adc	#$800		sta	rBundleSize		sta	1,s		bcc	@nr		lda	3,s		inc	a		sta	3,s		inc	rBundleSize+2@nr				lda	rBundleSize		sec			sbc	#$400		sta	rBundleSize		lda	rBundleSize+2		sbc	#0		sta	rBundleSize+2				pushZLong <handle		_SetHandleSize		ldy	#4			;re-lock the handle after the resize		lda	[<handle],y		ora	#$8000		sta	[<handle],y		bcs	@done		jsr	derefHandleToPtr		lda	CurrentRBSize		clc		adc	<ptr		sta	<ptr2		lda	CurrentRBSize+2		adc	<ptr+2		sta	<ptr2+2@noResize			lda	[<icon]			;go to the next icon record		clc		adc	<icon		sta	<icon		bcc	@nr2		inc	<icon+2@nr2		ldy	#16			;we converted another to a OneDoc		lda	[<ptr],y		inc	a		sta	[<ptr],y		brl	@loop;; we're done converting all the icons for this file;@done		ldy	#16			;first, see if we converted anything...		lda	[<ptr],y		bne	@haveSomeOneDocs		brl	errorOut2@haveSomeOneDocs		ldy	#4			;unlock the handle to resize it		lda	[<handle],y;;;		and	#$7FFF		asl a		lsr a		sta	[<handle],y				lda	<ptr2			;only re-enable this code once we know how		sec				;to grow the handle if the Bundle gets		sbc	<ptr			;larger		tax		lda	<ptr2+2		sbc	<ptr+2		pha		phx		pushZLong <handle		_SetHandleSize		ldy	#4			;re-lock the handle after the resize		lda	[<handle],y		ora	#$8000		sta	[<handle],y		pha				;we don't care about the rBundleHandle		pha		pea	0			;user icons, not finder icons		pushlong volumeNameHandle		pea	1			;by handle		pushZLong <handle		jsl	loadRBundle		pla		pla*** Scrunched - 21-Mar-93 JCM;;;		ldy	#4;;;		lda	[<icBlkHand],y;;;		and	#$3FFF;;;		sta	[<icBlkHand],y;;;		rts				brl	UnlockICBLKHAND		;it does the rts		*** End - 21-Mar-93 JCMerrorOut2	pushZLong <icBlkHand		jsl DisposeHandleGlue				sec		rts;; Add the icon at <Ptr4 to the icon handle and offset arrays, and also stuff our index into; the OneDoc at the offset in Y;; IN: (Y) contains the offset into our OneDoc to store the icon array index;         (for the small or large icon);AddIconToList	sty	OneDocResult		;we'll need this later		lda	#0		sta	[<ptr2],y		iny		iny		sta	[<ptr2],y				dey		dey		dey		dey		lda	#0			;zero out the resource ID for dave so it looks nice		sta	[<ptr2],y		;in the data structure dumper		dey		dey		sta	[<ptr2],y						lda	>IconArrayUsed		inc	a		cmp	>IconArraySize		bcs	@sizeAdjust		brl	@noSizeAdjust@sizeAdjust						clc		adc	#200			;enough for 200 more icons		stz	Offset+2;; we need to extend the IconListArrays by 4*(IconArraySize+200) apiece;		asl	a				rol	Offset+2		asl	a				rol	Offset+2		sta	Offset		lda	>IconHandleArray		sta	<handle3		lda	>IconHandleArray+2		sta	<handle3+2		ldy	#4		lda	[<handle3],y		;unlock and unfix the block		and	#$3FFF		sta	[<handle3],y		pha				;get the old handle size and stretch		pha				;it by a longword		pushZLong <handle3		_GetHandleSize			;and it had BETTER be unlocked at this		pla				;point		clc		adc	Offset			;want to add enough for 'TotalIcons' more records		tax		pla		adc	Offset+2		pha		phx		pushZLong <handle3		_SetHandleSize		bcc	@HandleListExtended		rts	@HandleListExtended								lda	>IconOffsetArray		sta	<handle3		lda	>IconOffsetArray+2		sta	<handle3+2			ldy	#4		lda	[<handle3],y	;unlock and unfix the block		and	#$3FFF		sta	[<handle3],y		pha				;get the old handle size and stretch		pha				;it by a longword		pushZLong <handle3		_GetHandleSize			;and it had BETTER be unlocked at this		pla				;point		clc		adc	Offset			;want to add enough for 'TotalIcons' more records		tax		pla		adc	Offset+2		pha		phx		pushZLong <handle3		_SetHandleSize		bcc	@OffsetListExtended		rts@OffsetListExtended						lda	>IconArrayUsed		inc	a		clc		adc	#200			;enough for 200 more icons		sta	>IconArraySize@noSizeAdjust		jsr	MakeArrayPtrs		;dereference the array ptrs again just in case... (sigh)		;; If we get this far, we either had enough room for the additional icon offset and handle records, or we; succesfully extended the length of each of the handle and offset handles;		ldy	OneDocResult		lda	>IconArrayUsed		;take our current index		tax		sta	[<ptr2],y		iny		iny		lda	#0		sta	[<ptr2],y		stz	Offset+2		txa				asl	a			;Offset *= 4		rol	Offset+2		asl	a		rol	Offset+2		sta	Offset				clc				;add the offset to the start of the offset list		adc	OffsetArrayPtr		sta	<handle3		lda	Offset+2		adc	OffsetArrayPtr+2		sta	<handle3+2		;handle3 is now a pointer to our offset array record				lda	Offset			;add the offset to the start of the handle list		clc		adc	HandleArrayPtr		sta	<ptr3		lda	Offset+2		adc	HandleArrayPtr+2		sta	<ptr3+2				lda	<ptr4			;take the current icon pointer and make an offset		sec				;from the beginning of the IconList		sbc	<icBlk		sta	[<handle3]		;keep in mind that handle3 is a pointer, not a handle here		lda	<ptr4+2		sbc	<icBlk+2		ldy	#2		sta	[<handle3],y		lda	<icBlkHand		;store the handle of the block of our icon		sta	[<ptr3]		lda	<icBlkHand+2		sta	[<ptr3],y		lda	>IconArrayUsed		inc	a		sta	>IconArrayUsed				clc		rts;; dereference the icon handle array and the icon offset array;MakeArrayPtrs		lda	>IconHandleArray		sta	<handle3		lda	>IconHandleArray+2		sta	<handle3+2				lda	[<handle3]		sta	HandleArrayPtr		ldy	#2		lda	[<handle3],y		sta	HandleArrayPtr+2		lda	>IconOffsetArray		sta	<handle3		lda	>IconOffsetArray+2		sta	<handle3+2				lda	[<handle3]		sta	OffsetArrayPtr		lda	[<handle3],y		;y is already 2		sta	OffsetArrayPtr+2		rts		;; locals;lastRFPathHandle dc.L	0			;last rFinderPath handle allocatedOffsetArrayPtr	dc.L	0HandleArrayPtr	dc.L	0Offset		dc.L	0OneDocResult	dc.w	0CurrentRBSize	dc.L	0rBundleSize	dc.L	0matchFlags	dc.w	0namePtr		dc.w	0nextOneDoc	dc.w	0; derefHandleToPtr -- dereference 'handle' into 'ptr';.....................................................................derefHandleToPtr		lda	[<handle]		tax		ldy	#2		lda	[<handle],y		sta	<ptr+2		stx	<ptr		rts		ENDP;==============================================		END