******************************************************************************** File:		Main.aii* Project:	GS Finder* Orig Authors:	Don J. Brady & Dan Oliver* Build file:	Finder.Make** © Copyright Apple Computer, Inc. 1986-1993* All rights reserved.********************************************************************************* Finder 6.0 changes by Andy Nicholas, Dave Lyons, Ron Lichty.* (Shipped in February, 1992.)********************************************************************************* REVISION HISTORY AFTER 6.0** 18-Feb-92 Dave Lyons*   Fixed bug where IBeamCursor appears on desktop, when icon being renamed*   in a window is scrolled outside the visible part of the window.  New*   code is smaller.**   Added _InInfoBar to handle clicking in the column headers of a list-view*   window.** 19..20-Feb-92 Dave Lyons*   Invalidates dir+trash windows containing dates when date format changes.*   Various optimizations, including using <zero instead of #0 or pea 0.** 10-Mar-92 DAL*   Requires GS/OS $0402 for 6.0.1.** 20-Mar-92 DAL*   Remove LEFilter routine & replaced with shorter routine using IsSpecialLEKey.** 5-Jun-92 DAL*   Added stuff for Keyboard Navigation.  PendingDeselectAll works after an Open*   to make the new front window the current plane.  Esc deselects all and makes*   the front window the current plane; Command-Esc deselects all and makes the*   desktop the current plane.** 9-Jun-92 DAL*   Made Control with with Command-W and Option-Command-W.  Made Command-Shift-*   UpArrow work like Command-Esc to select the desktop.** 22-Jun-92 DAL*   Added tick count to finderSaysKeyHit broadcast.  Parameter count is now 3.** 23-Jun-92 DAL*   Stores default quit choice from rRectList(1) in defaultQuitChoice.** 8..9-Jul-92 DAL*   Fixed a SpliceName problem (renaming to a shorter length was not working).*   Made a few optimizations.** 16-Jul-92 DAL (6.0.1d7)*   Removed redundant MessageCenter call to delete message $11.** 16-Oct-92 DAL (6.0.1d12)*   UpdateWindow preserves <wind to make Invisible preference update right.** 20-Jan-93 JCM - Fixed the problem where a server disconnecting unexpectedly would*		  cause an infinite icon walk if a window from that server was frontmost.*		  In _DiskSwitched, <curWind was being restored to the window we just closed.** 18-Feb-93 JCM - Changed CheckIcons and CompareIcon so that during a VolumeChange call we notice *		  everything that may have changed in a file's directory entry.** 17-Mar-93 JCM - When we update a changed icon in NewIconData, we now update the kind string pointer*		  as well. This allows the View by and Icon Info windows to change to the proper new*		  kind.** 18-Mar-93 JCM - Fixed rename with an Icon Info window open on the target file to work for regular*		  files. In 6.0 it only redrew the Icon Info name for devices and folders.** 24-Mar-93 JCM - Conditionally started to add code to notice changes to files on the desktop. This*		  won't be included in 6.0.1.**  2-Apr-93 JCM - Fixed to call selectionIsChanging when an icon is renamed and the list is resorted.*		  This allows Key Nav to flush it's icon cache at a useful time.*******************************************************************************		PRINT	OFF		PRINT	GEN		PRINT	NOSYM		PRINT	NOPAGE		INCLUDE	'all.macros'		INCLUDE	'special.macros'		string asis		blanks off		INCLUDE	'Finder.equ'		INCLUDE	'Resource.equ'		INCLUDE	'DP.equ'		INCLUDE	'Data.equ'		INCLUDE	'E16.LineEdit'		INCLUDE	'E16.Event'		INCLUDE	'E16.QuickDraw'		INCLUDE	'Strings.equ'			;import strings		PRINT	ON		;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	PStringCopy		IMPORT	PStringCat		IMPORT	ConsoleWrite		; in GSOS.aii		IMPORT	DateFormat		IMPORT	WStringCopy		IMPORT	ScreenHandle		IMPORT	MemoryID		IMPORT	PathAddName		IMPORT	PToWString		IMPORT	EjectAll		; in drives.aii		IMPORT	writeDef		; in util.aii		IMPORT	writeAllRoots		; in util.aii		IMPORT	FileEntry		IMPORT	MiscEntry		IMPORT	matchDIB		IMPORT	VerifyMedium		IMPORT	ADDICONOBJ		IMPORT	ADDIRECT2		IMPORT	ADDNAME		IMPORT	ALLOCATE		IMPORT	ARROWCURSOR		IMPORT	BIGERROR1		IMPORT	BUILDPATH		IMPORT	BUILDPATH2		IMPORT	BUILDPATH3		IMPORT	CKDATAERROR		IMPORT	CKMEMORY		IMPORT	CKROOTS		IMPORT	CLONEPATH		IMPORT	CLOSEKIDS		IMPORT	CUTNFREE		IMPORT	DEREFHAND		IMPORT	DEVICESCAN		IMPORT	DOCLOSE		IMPORT	DOSETPREFIX2		IMPORT	DOWRITE		IMPORT	DRAWDESK		IMPORT	DRAWICON2		IMPORT	DUMPEXTICON		IMPORT	DUPDEVICE2		IMPORT	ENDDRAW		IMPORT	FINDLASTNAME		IMPORT	GETFRONTWIND		IMPORT	GETICNAMEPTR		IMPORT	GETICONRECT		IMPORT	GETNEXTWIND		IMPORT	GETRECTRGN		IMPORT	GETWREFCON		IMPORT	GETWREFCON2		IMPORT	ID_BYDATE		IMPORT	ID_BYICON		IMPORT	ID_BYKIND		IMPORT	ID_BYNAME		IMPORT	ID_BYSICON		IMPORT	ID_BYSIZE		IMPORT	IFDESK		IMPORT	INACTFILE		IMPORT	LOCKFILE		IMPORT	LOCKIC		IMPORT	MENULIST		IMPORT	NEWDATASIZE2		IMPORT	NEWVIEW		IMPORT	NORMALCOLOR		IMPORT	PADNAME		IMPORT	PRODOSERR		IMPORT	PUSHTASK		IMPORT	PUSHYRAT		IMPORT	PUSHZPAGE		IMPORT	READ2		IMPORT	READ_BUFF		IMPORT	READ_SIZE		IMPORT	REDRAWLIST		IMPORT	RESTORETEMP		IMPORT	SAVETEMP		IMPORT	SETICBLK		IMPORT	SETORGNMASK		IMPORT	STARTDRAW		IMPORT	TEMP2PATH		IMPORT	TODESKPORT		IMPORT	TODESKTOP		IMPORT	UNLOCKIC		IMPORT	WALKBACK		IMPORT	WALKEXT2		IMPORT	WALKWINDOW		IMPORT	WATCHCURSOR		IMPORT	WINDCLICK		IMPORT	WINDREFCON		IMPORT	WRITEROOT		IMPORT	WRITE_BUFF		IMPORT	WRITE_LEN				IMPORT	FiFiFI			; JAM 06/06/89 per MD/DTS		import  UnloadSegs;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	updateInfoWin		ENTRY	updateInfoWin2		ENTRY	noRename		ENTRY	hitIconName		ENTRY	handleEvent		ENTRY	getPattern		ENTRY	FinderSaveAll		ENTRY	CheckLECursormaxCharWidth	equ	12			; maximum width of char in pixelsFVis		equ	$0020*===============================================**	This is where we start			**===============================================*main		PROC		IMPORT	FinderStartUp		IMPORT	FinderInit		IMPORT	FinderEventLoop		IMPORT	FinderShutDown		IMPORT	FinderQuit		IMPORT	TextAlert		IMPORT	QuitUsDown		IMPORT	NotDescriptors				phk		plb		ora	#$0100		sta	MemoryID;; Now that we have an initialization segment that we're done with, we should; dispose of it before starting to read in icons or taking up memory in; general.;; Call FiFiFi to init itself and then unload it.;		jsl     FiFiFi		bcc	@fififiOK		lda	#0		ldx	#NotDescriptors		ldy	#NotDescriptors>>16		jsl	TextAlert				brl	QuitUsDown		@fififiOK	jsl     UnloadSegs		; unload the FiFiFi segment				jsr	FinderStartUp		jsr	FinderInit		jsr	FinderEventLoop				EXPORT	SuperShutDownSuperShutDown	jsr	FinderShutDown		jmp	FinderQuit				ENDP		*===============================================**	Startup the resources we need		**===============================================*FinderStartUp	PROC				IMPORT	MyIDLong		IMPORT	C1_PathNamePtr		IMPORT	finderDPage		IMPORT	finderTaskRecord		IMPORT	StartStopRef		IMPORT	StartupRecord		IMPORT  ChangePath		IMPORT	QDBank		IMPORT	aboutWindowPtr		IMPORT	helpWindowPtr		IMPORT	lastOnTop		import	line1		import	line2		import	NullButton		import	OKStrText		import	didSmoothie		import	prefer		import	deskpat		import	commacharacter		import	InfoWinColorTablePtr		import	StartUpOOM		import	LoadResources		import	AllocateChains		import	SetupLoad		import	MenuInit		import	TextAlert		import	NotMemory		import	NotSystem6		import	TrashWindowColor				import	VerifyColor		import 	c1_devnamebuf		import 	c1_filenamebuf		import	c1_pathbuf		import	c1_sourcebuf		import	c1_destbuf		import	c1_temppathbuf		import	c1_pathnamebuf		import	DisposeHandleGlue		import	NotMemoryCode;; Initialize this section of RAM;		ldx	#(EndDynamRAM-StartDynamRAM)-2@loop1		lda	StartInitRAM,x		sta	StartDynamRAM,x		dex		dex		bpl	@loop1		lda	StartInitRAM		sta	StartDynamRAM;; Zero out this section of RAM;		ldx	#(EndZeroRAM-StartZeroRAM)-2@loop2		stz	StartZeroRAM,x		dex		dex		bpl	@loop2		stz	StartZeroRAM;; --- Zero out my direct page ------------------;		ldx	#$FE@dpLoop		stz	<0,x		dex		dex		bpl	@dpLoop				tdc		sta	finderDPage		clc		adc	#TaskRec		sta	finderTaskRecord		stz	aboutWindowPtr		;tell it the about window is not open		stz	aboutWindowPtr+2		stz	helpWindowPtr		stz	helpWindowPtr+2;; patch some addresses;				lda #MaxPathLen+MaxFileName+4	;set our c1_output buffer sizes		sta >C1_TempPathBuf		sta >C1_PathBuf		sta >C1_PathNameBuf		lda #(MaxFileName*4)+4		sta >C1_SourceBuf		sta >C1_DestBuf		;; startup tool locator;		_TLStartUp		;		; startup Memory Manager;						pha				; start Memory Manager		_MMStartup		pla		sta	<myID			; my memory manager ID number;; Start tools;		_GetVersionGS VersionParms				lda	VersionParms+2;		and	#$7FFF			;mask proto bit		asl a		lsr a		cmp	#$0402			;10-Mar-92 DAL		bge	@got6_0		@notSystem6	lda	#0		ldx	#NotSystem6		ldy	#NotSystem6>>16		jsl	TextAlert		brl	ShutUsDown@got6_0		pei	<MyID		_ResourceStartup		jsl	allocateChains		;returns carry set or clear (error in A??)		bcc	@gotDefaults		tax		brl	Requires6_0@gotDefaults		pha		pha		pei	<MyID		pea	1		_LGetPathname2		pla		sta	<ptr		pla		sta	<ptr+2				_GetLevelGS OldLevelParms		_SetLevelGS SetLevelParms		pha		pha		pea	1			;process rBundle(1)		pei <zero		pea	$0040		lda	<MyID		ora	#$0100		pha		pushZLong <ptr		jsl	LoadResources		pulllong <handle2		bcs	@loadResError		pha		pha		pei	<MyID		pea	1		_LGetPathname2		pla		sta	<ptr		pla		sta	<ptr+2				lda	[<handle2]		sta	<ptr2		ldy	#2		lda	[<handle2],y		sta	<ptr2+2						pha		pea	1		pushZLong <ptr2			;resource fork address		pushZLong <ptr			;pathname		_OpenResourceFile		tax		pla		bcs	@goRequires6_0		_SetLevelGS OldLevelParms				jsl	SetupLoad		bcc	@loadOK			;returns error in Y		tyx				;error code now in X@goRequires6_0	phx		pushZLong <handle2		jsl DisposeHandleGlue		plx@loadResError	phx		_SetLevelGS OldLevelParms		plx		brl	Requires6_0@loadOK		pushZLong <handle2		jsl DisposeHandleGlue				pha				; space for reference		pha		pei	<myID		pea	$0012			;refIsResource, no resource startup		pushlong #1			;reference		_StartUpTools		tax		pulllong startStopRef		bcc	good		phx		lda	StartStopRef+1		;if we didn't get a handle, we're toast		beq	@noStartStopRef				pea	$0011			;start/stop record is a HANDLE, no resource shutdown		PushLong StartStopRef		;no smooth quit, they're toast!		_ShutDownTools@noStartStopRef	plx		cpx	#$0046		beq	@goNotSystem6		cpx	#$0110		bne	Requires6_0@goNotSystem6	_ResourceShutDown		brl	@notSystem6Requires6_0*** added 12-Aug-92 DAL -- put error code into the "needs 300K" message		pha		pha				;space for HexIt		phx		_HexIt		pla		sta >NotMemoryCode		pla		sta >NotMemoryCode+2*** end 12-Aug-92		_ResourceShutDown		lda	#0		ldx	#NotMemory		ldy	#NotMemory>>16		jsl	TextAlert		ShutUsDown	jsr	DidSmoothie		EXPORT	QuitUsDownQuitUsDown	_QuitGS QuitParms		;and if they survive this... wow.QuitParms	dc.w	0VersionParms	dc.w	1		dc.w	0OldLevelParms	dc.w	2			;we want the real level stuff		dc.w	0			;level		dc.w	0			;level_modeSetLevelParms	dc.w	2			;we want an absolute system level of $31		dc.w	$31			;level		dc.w	0			;level_modegood		;; allocate 32k and put ourself in the out of memory queue -- if we can't allocate 32k here, go back; to the text screen death routine and say that there's no way we're gonna try running with a memory; situation this tight.;		jsl	StartUpOOM		tax		bcs	requires6_0	;should be go to a routine which says we need more memory!*** 25-Nov-90 DAL****** In Icons.aii, the routine drawHor (which draws a horizontal line segment*** directly to screen memory) has a quirk where it reads and re-writes the*** first byte immediately following screen memory, when you drag an icon*** (on the desktop) to the very bottom-right of the screen.  It doesn't*** *change* the byte, but it does re-write it.****** The scanline control bytes immediately follow screen memory, but the*** bank-one copies of the SCBs are not used (by convention) even though*** the hardware shadows them.  When we have bank-1 shadowing enabled, this*** means dragging an icon to the bottom right of the screen changes the*** first SCB to the garbage value at $019d00.****** The kludge fix is to copy $e19d00 to $019d00 if we got shadowing.****** If anybody has a legitimate reason for changing the first SCB while*** the Finder is running, this kludge will break.****** And we thank you for your support.****** 13-Mar-91 DAL****** Fixed this fix to check the SHADOW register instead of the MasterSCB,*** because CloseView may be using SHR shadowing even if we didn't get*** it from QDStartUp.***		lda >$e1c035		and #8		bne @noShadow		lda >$e19d00		sta >$019d00@noShadow*** end 25-Nov-90 DAL;; Get quickdraw's WAP so we can maybe like play with it;		pha		pha		pei <zero		pea 4		_GetWAP		pla		sta	<QuickDrawDP		pla		;	; ------ Allocate some zero pages for the finder --------------------------;		ldx	<zero		phx				space for handle		phx		phx				3 pages, high word		pea	Total_zp		low word.		lda	<MyID			; My master credit card number		ora	#$0F00			; Tool DPs get their own auxID		pha				; Pass credit card number.		pea	$C005			locked,	fixed, fixed bank		phx				No special address.		phx		_NewHandle		bcc	@okay		tax		brl	requires6_0		;should be go to a routine which says we need more memory!@okay		pulllong <handle		lda 	#$200			; diagnostic tag 8/10/88 (JAM)		ora	<MyID		pha				;Let MiscStuff use my credit card.		lda	[<handle]		;zp to use.				if	misc_zp<>0 then		clc		adc	#Misc_zp		endif				pha				Pass direct page for MiscStuff to use.		ldx	#xMiscStartup		Miscellaneous Finder routines.		jsl	MiscEntry		lda	#$300			; diagnostic tag 8/10/88 (JAM)		ora	<MyID		pha				Let File routines use my credit card.		lda	[<handle]		zp to use.		clc		adc	#COPY_zp		pha		ldx	#xFileStartUp		jsl	FileEntry		lda	<MyID		ora	#$0100		sta	<MyID		sta	MemoryID;; 2/1/90: djb/rdl fix for djb for CloseView: get QuickDraw’s bank (1 or E1);		pha		pha		_GetPort			; we’ve only started QD,		pla				;  so this should give us a		sta	<temp			;  QD port with QD’s bank		pla		sta	<temp+2				ldy	#optrToPixImage+1	; offset to high/bank of pixel image		lda	[<temp],y		; in LocInfo record		sta	QDBank			; save it; end djb/rdl fix		pushlong #c1_PathNamePtr		_SetCtlParamPtr;; Initialize and draw our menu bar;		jsr	MenuInit		; setup Finder menus;; load the resources necessary for the trashcan, clipboard, help, and about box;		IMPORT	PStringCopy		IMPORT	aboutBlk		IMPORT	trashBlk		IMPORT	clipBlk		IMPORT	helpBlk		IMPORT	validateBlk		IMPORT	verifyBlk			stz	whichResource		@loadLoop	pha		pha		pea	$8006		;rPString for "About the Finder" menu text				pei <zero		lda	whichResource		asl	a		tax		lda	resourceIDs,x		pha		_LoadResource		pulllong deref				lda	[deref]		tax		ldy	#2		lda	[deref],y		sta	deref+2		stx	deref				pushZlong deref		;from		lda	whichResource	;to		asl	a		asl	a		tax			lda	putWhere+2,x		pha		lda	putWhere,x		pha		jsl	PStringCopy	;move the resource		pea	-1		;dispose this guy immediately		pea	$8006		;rPString				pei <zero		lda	whichResource		asl	a		tax		lda	resourceIDs,x		pha		_ReleaseResource		inc	whichResource		lda	whichResource		cmp	#12		;number of strings to move		blt	@loadLoop		;; stuff the window type ID's into the clipboard, about box, help window, and trash window blocks; We stuff the ID's in here to allow those block to run together and hopefully become sparse;;;;		lda	#clipBlk		lda	#clipWindID	;Andy!  Cool bug!  --1-Dec-91 DAL		sta	>clipBlk+windID		lda	#AboutWindID		sta	>aboutBlk+windID		lda	#helpWindID		sta	>helpBlk+windID		lda	#trashWindID		sta	>trashBlk+windID		lda	#VerifyWindID		sta	>validateBlk+windID		sta	>verifyBlk+windID;; now, load and deref the rRectList(1) resource;		pha		pha		pea	$c001		pushlong #1		_LoadResource		pulllong <deref				lda	[<deref]		tax		ldy	#2		lda	[<deref],y		sta	rectlistPtr+2		sta	<ptr+2		stx	rectListPtr		stx	<ptr				ldy	#68+2		lda	[<ptr],y		sta	prefer*** 23-Jun-92 DAL for 6.0.1		iny		iny		lda [<ptr],y		sta defaultQuitMethod***				ldy	#96+14+2		ldx	#14@loop		lda	[<ptr],y		sta	deskpat,x		dey		dey		dex		dex		bpl	@loop				ldy	#64+2		lda	[<ptr],y		and	#$FF00		sta	FolderColor		iny		iny		lda	[<ptr],y		sta	>CommaCharacter		;; now, load and deref the rWindColor resources (must be locked, fixed, and preload);		pha				;load GetInfo's rWindColor resource		pha		pea	$8010		pushlong #2		_LoadResource		pulllong <deref				lda	[<deref]		tax		ldy	#2		lda	[<deref],y		sta	>InfoWinColorTablePtr+2		txa		sta	>InfoWinColorTablePtr		pha				;load directory, trash, clip window's		pha				;rWindColor resource		pea	$8010		pushlong #1		_LoadResource		pulllong <deref				lda	[<deref]		tax		ldy	#2		lda	[<deref],y		sta	wind_color+2;;;		sta	>clip_color+2		sta	>TrashWindowColor+2		sta	>VerifyColor+2		txa		sta	wind_color;;;		sta	>clip_color		sta	>TrashWindowColor		sta	>VerifyColor		rts;; locals;		EXPORT	rectListPtrrectListPtr	dc.L	0		EXPORT	FolderColorFolderColor	dc.w	0		export defaultQuitMethoddefaultQuitMethod dc.w 0whichResource	dc.w	0		;counter to load resources aboveresourceIDs	dc.w	$100		;" About the Apple IIgs Finder "		dc.w	$101		;"About the Finder"		dc.w	$102		;" Trash "		dc.w	$103		;"Trash"		dc.w	$104		;" Clipboard "		dc.w	$105		;"Clipboard"		dc.w	$106		;" Finder Help "		dc.w	$107		;"Finder Help"		dc.w	$108		;" Bad Blocks "		dc.w	$109		;"Bad Blocks"		dc.w	$10A		;" Damaged Files "		dc.w	$10B		;"Damaged Files"	putWhere	dc.L	aboutBlk+windTitle		dc.L	aboutBlk+windMenuText		dc.L	trashBlk+windTitle		dc.L	trashBlk+windMenuText		dc.L	clipBlk+windTitle		dc.L	clipBlk+windMenuText		dc.L	helpBlk+windTitle		dc.L	helpBlk+windMenuText		dc.L	verifyBlk+windTitle		dc.L	verifyBlk+windMenuText		dc.L	validateBlk+windTitle		dc.L	validateBlk+windMenuText		EXPORT finderStringfinderString	str	'Apple~Finder~'		endP*===============================================*	*						**		FinderShutDown			**						**===============================================*		FinderShutDown	PROCNAME		IMPORT	freeBlk		IMPORT	StartStopRef		IMPORT	DelNotifyProc		IMPORT	SetGSOSAlerts		IMPORT	HandleToPointer		IMPORT	aboutWindowPtr		IMPORT	helpWindowPtr		IMPORT	finderVersionHandle		IMPORT	systemVersionHandle		IMPORT	finderString		import	SayGoodbyeToExtensions		import	PathSubName		import	OOMShutDown		import	DisposeHandleGlue;--- Remove ourself from Notification queue ---- 		jsl SayGoodbyeToExtensions		jsl DelNotifyProc		;;;		pushlong #finderString*** 2-Jun-92 DAL -- kill all request procs with main ID		pei <zero		pei <zero;;;		pei <myID		lda <myID		and #$f0ff		pha*** end 2-Jun-92		pei <zero		pei <zero			;procedure address 0 = remove 		_AcceptRequests							pei <zero		jsl SetGSOSAlerts		; enable GS/OS alerts - 02/10/89;--- Release Window resources ------------------;commented out 11/9/90 by andy -- the window manager marks all windows as invisible and then;closes them, so there is no need to close the windows individually which would slow the shutdown;;		PushZLong <TrashWind		; kill Trash window;		_CloseWindow;;		PushZLong <clipWind		; kill Clipboard window;		_CloseWindow*** optimized 8-Jul-92 DAL		ldx <TrashWind+2		lda <TrashWind		jsr MakeWindowInvisible;		pha				;make the trash and clip invisible;		pushZLong <TrashWind		;so that they are removed when we;		_GetWFrame			;do our resfreshdesktop call;		pla				;andy 11/21/90;		and	#$ffdf;		pha;		pushZLong <TrashWind;		_SetWFrame*** Removed (3 lines) 19-Aug-92 DAL since clipboard is now a system window;		ldx <clipWind+2;		lda <clipWind;		jsr MakeWindowInvisible;		pha;		pushZLong <clipWind;		_GetWFrame;		pla;		and	#$ffdf;		pha;		pushZLong <clipWind;		_SetWFrame*** end 8-Jul-92		lda	aboutWindowPtr+1		beq	@noAbout				pushlong finderVersionHandle		jsl DisposeHandleGlue				pushlong systemVersionHandle		jsl DisposeHandleGlue		*** opt 8-Jul-92 DAL		ldx aboutWindowPtr+2		lda aboutWindowPtr		jsr MakeWindowInvisible;		pha;		pushlong aboutWindowPtr;		_GetWFrame;		pla;		and	#$ffdf;		pha;		pushlong aboutWindowPtr;		_SetWFrame*** end 8-Jul-92@noAbout				lda	helpWindowPtr+1		beq	@noHelp*** opt 8-Jul-92 DAL		ldx helpWindowPtr+2		lda helpWindowPtr		jsr MakeWindowInvisible;		pha;		pushlong helpWindowPtr;		_GetWFrame;		pla;		and	#$ffdf;		pha;		pushlong helpWindowPtr;		_SetWFrame*** end 8-Jul-92@noHelp;--- Shutdown the tools and dispose memory -----	*** Moved - 22-Mar-93 JCM - Only copy the app to quit to if we're going to be using it.***			    If C1_QuitName happened to be used to hold an error string, but***			    we're not launching an app from here, then we'd copy far too many***			    bytes with the WStringCopy. This would kill us.	;;;		PushLong #C1_QuitName;;;		PushLong #C1_PathName;;;		jsl	WStringCopy		;;;		jsr	findLastName		; lastName = application name.;;;		pushlong #c1_pathname;;;		jsl	PathSubName		*** End - 22-Mar-93 JCM				lda	quit_path		; Just quitting? (i.e., is		ora	quit_path+2		; quit_path word zero?)		bne	checkLaunchInfo				pei <zero			;get rid of anything left on the		pei <zero			;screen if we are quitting		_RefreshDesktop		brl	justShutDowncheckLaunchInfo*** Moved - 22-Mar-93 JCM - Only copy the app to quit to if we're going to be using it.***			    If C1_QuitName happened to be used to hold an error string, but***			    we're not launching an app from here, then we'd copy far too many***			    bytes with the WStringCopy. This would kill us.			PushLong #C1_QuitName		PushLong #C1_PathName		jsl	WStringCopy				jsr	findLastName		; lastName = application name.		pushlong #c1_pathname		jsl	PathSubName		*** End - 22-Mar-93 JCM				_GetFileInfoGS launchInfoParms		bcc	@1		brl	justShutDown@1;		lda	launchInfoParms+8	;get filetype, must be $B3;		cmp	#$B3;		beq	@2;		cmp	#$FF;		beq	@3;		brl	justShutDown;@2;;		lda	launchInfoParms+10	;get auxtype, must be $db02 at least;		and	#$ff02;		cmp	#$db02;		beq	@3;		brl	justShutDown;@3		pha		pha		_GetPort				pha		pha		_GetMenuMgrPort		_SetPort				pha		pha		_GetMenuBar		pla		plx				pha				;space		pha		phx		pha		jsl	handleToPointer		;deref the handle to our menu bar's		pulllong <work			;menu bar record		ldy	#8		ldx <zerorLoop		lda	[work],y		sta	myzz3rect,x		inx		inx		iny		iny		cpx	#8		blt	rLoop		pushlong #myzz3rect		pea	2		pea	1		_InsetRect		pushlong #myzz3rect		_EraseRect				pha				;find out how long our app's name is		pushlong #lastName+1		_CStringWidth		pla		lsr	a			;divide by 2 because we're centering it		sta	work+4				ldy	#10			;add the right edge to the left edge of		lda	[work],y		;our menu bar's rect		clc		ldy	#14		adc	[work],y		lsr	a			;div by 2 because we're centering		sec		sbc	work+4			;the total length - the string length		pha				;will tell us where to put our text so		pea	10			;that it's centered.		_MoveTo				pushlong #lastname+1		;draw it up there -- everyone is happy		_DrawCString				_SetPort		pei <zero			;we only do this trick if the desktop is going		pei <zero			;to bother to stay on the screen		_RefreshDesktop				;;		PushZLong <deskPort		; close desktop port;;		_ClosePort;;	;;		stz	<deskPort;;		stz	<deskPort+2		jsr CloseDeskPortSafelyPlease	;9-Feb-92 DAL		pea	5			;shut us down without turning off the		PushLong StartStopRef		_ShutDownTools		bra	didSmoothie		;SHR screen since our next app is a desktopjustShutDown;;		PushZLong <deskPort		; close desktop port;;		_ClosePort;;	;;		stz	<deskPort;;		stz	<deskPort+2		jsr CloseDeskPortSafelyPlease	;9-Feb-92 DAL		pea	1			;start/stop record is a HANDLE		PushLong StartStopRef		_ShutDownTools;; first, see if Standard File is still active, and if it is, shut it down;		export	DidSmoothiedidSmoothie	pei <zero		_SFStatus		pla		beq	@SFNotActive				_SFShutDown;; now, get rid of all the extra allocated memory we grabbed or used in our OOM routine;@SFNotActive	jsl	OOMShutDown		;get rid of our OutOfMemory routine (if it's there);		lda	#$0900			;rFinderPath and rVersion ID's;		jsr	Dispose0A00;		lda	#$0800			;rBundle ID's;		jsr	Dispose0A00;		lda 	#$0700			;rIcon ID's;		jsr 	Dispose0A00;		lda 	#$0200;		jsr 	Dispose0A00;		lda 	#$0300;		jsr 	Dispose0A00;		lda 	#$0F00;		jsr 	Dispose0A00;		lda 	#$0100;		jsr 	Dispose0A00*** opt 8-Jul-92 DAL (saved 33 bytes)		lda MemoryID		ora #$0F00		ldx #15		;do 15 DisposeAll calls, $1Fxx..$11xx@disposeMore	pha		phx		pha		;ID to dispose		_DisposeAll		plx		pla		xba		dec a		xba		dex		bne @disposeMore*** end 8-Jul-92		lda	MemoryID		and	#$F0FF			;The id by which Mr. MM knows me		pha		_MMShutdown			;Memory manager off for me		_TLShutDown			;shut the tool locator down				rts;		EXPORT	Dispose0A00;Dispose0A00	pha;		lda MemoryID;		and #$F0FF;		ora 1,s;		sta 1,s;		_DisposeAll;		rts*** 8-Jul-92 DAL -- MakeWindowInvisible subroutine saves bytes (window in XA)MakeWindowInvisible		pha	;space for SetWFrame frame value		phx		pha	;window ptr for SetWFrame		pha	;space for GetWFrame		phx		pha	;window pointer		_GetWFrame		pla		and #$ffdf	;clear the fVisible bit		sta 5,s		_SetWFrame		rts*** end 8-Jul-92*** added 9-Feb-92 DAL -- We need to call Desktop(7,nil) so the Window Manager***   will stop trying to magically update our port's visRgn.CloseDeskPortSafelyPlease		pea 7			;BackGroundRgn		pei <zero		pei <zero		;no background region!		_Desktop		PushZLong <deskPort	; close desktop port		_ClosePort		stz <deskPort		stz <deskPort+2		rts*** end 9-Feb-92 DAL		launchInfoParms	dc.W	4		dc.L	C1_QuitName		dc.W	0			;access		dc.W	0			;filetype		dc.L	0			;auxtype		myzz3rect	ds	8			;dave made up this name		ENDP*===============================================**		Application quit 		**						** Note: all direct page variables are gone!!	**===============================================*FinderQuit	PROCNAME		IMPORT	IgnoreGSOSError				jsl	IgnoreGSOSError		; don't handle errors (no alerts)		lda	quit_path		; Just quitting? (i.e., is		ora	quit_path+2		; quit_path word zero?)		beq	justQuit; --- Print name of application	being launched ----------------------------				PushLong #lastName 		jsl	ConsoleWrite; --- Set prefix 0 or 8 to c1_pathname (app is in that folder) ------------		jsr	doSetPrefix2		; Set prefix to application's directory.; --- Quit to application -------------------------------------------------justQuit		jsl	ProDOS			;Do a ProDOS Quit call		DC.W	QUIT+C1		DC.L	quit_list		ENDP;==============================================;	Finder's Main Event Loop;==============================================FinderInit	PROC		IMPORT	volumeNameHandle		IMPORT	C1_SystemName		IMPORT	C1_BootName		IMPORT	GetBootVolList		IMPORT	matchForStoragetype		IMPORT	matchForHFSFiletype		IMPORT	matchForHFSCreator		IMPORT	matchForOptionList		IMPORT	allocateChains		IMPORT	toTop		IMPORT	getClickSpeed		IMPORT	AddNotifyProc		IMPORT	SetGSOSAlerts		IMPORT	InitCursor		IMPORT	HandleGSOSError		import  requestProc		import	numExtrasItems		import	SayHelloToExtensions		import	WStringCopy		import	LoadNewIcons		import	rectListPtr		import	SuperShutDown		import	OOMFlag		import	doAlertWindow		import	KillChains		import	CloseAllMenu		import	PuticonBack2		import	WalkOfLife3		import	Dispose0A00		import	CountReadOnlyFSTs		import	ID_QUIT		import	cleanupState		import	GetBootVolume		import	NewView		import	DisposeHandleGlue				jsl	InitCursor		jsl	CountReadOnlyFSTs		PushWord #1		jsl	SetGSOSAlerts		; disable GS/OS alerts - 02/10/89		jsl	HandleGSOSError		; handle errors ourselves (our alerts)		pea	DelMessage		pea	FilesMessage		pha		pha		_MessageCenter*** Removed 16-Jul-92 DAL, because the toolbox does this automatically on killing msg 1;		pea	DelMessage;		pea	LongFilesMessage;		pha;		pha;		_MessageCenter		jsr	getClickSpeed		Fetch system double click speed.; --- Load default file	from @:Finder.Defaults ---------------------------------		lda	#DEF_SIZE		sta	read_size		stz	read_size+2		lda	#prefer		sta	read_buff		lda	#prefer>>16		sta	read_buff+2		ldx	#defaultName		ldy	#defaultName>>16		jsr	read2		jsr	getPattern		; get the pattern in the system		lda	prefer		and	#PREF_ALL		; clear unused bits		sta	prefer; --- Open a desktop port ----------------------------------------------		lda	#port		ldx	#port>>16		sta	<deskPort		stx	<deskPort+2		sta	<curWind		Current	icon plane is the desktop.		stx	<curWind+2		phx		pha		_OpenPort		pea	deskPat>>16		Desktop	color.		pea	deskPat		_SetBackPat		pea	7			Pass my	visRgn as the floor region.		lda	port+VisRgn+2		pha		lda	port+VisRgn		pha		_DeskTop			;Window Manager will now set my visRgn						;to the desktop less any windows whenever						;there is any change in the windows.; --- Install my draw desktop routine ---------------------------------		pea	5		pea	DrawDesk>>16		Address	of my routine to draw desktop.		pea	DrawDesk		_DeskTop			Also draw the desktop.; --- Get scan line addresses for my RECT draw routine --------------------		pha				Space for result.		pha		pea	1			Get scan line address table command.		_GetAddress		pla		sta	<lineAddrs		pla		sta	<lineAddrs+2		jsl	GetBootVolume*** Removed 18-Aug-92 DAL; ------ Open an invisible Clipboard window -------------------------------;;		lda	rectListPtr;		sta	<ptr;		lda	rectListPtr+2;		sta	<ptr+2;		;		ldy	#88+6+2;		ldx	#6;@loop		lda	[<ptr],y;		sta	wind_pos,x;		dey;		dey;		dex;		dex;		bpl	@loop;		;		pha				;Space for result.;		pha;		PushLong #clip_param		;Pass pointer to NewWindow parameter list.;		_NewWindow;		PullLong <clipWind;; add us to the sendRequest queue;		pushlong #finderString;;;		pei	MyID*** 2-Jun-92 DAL		lda <MyID		and #$f0ff		pha*** end 2-Jun-92		pushlong #requestProc 		_AcceptRequests		lda <zero		sta >numExtrasItems		jsl SayHelloToExtensions;; --- Add ourself to the Notification Queue ----;			jsl	AddNotifyProc;; --- Find out what devices are	connected to the system	------------------; --- mount them; put up icon(s); read FINDER.ROOT; open windows ---------;		stz	quit_flags				PushWord #$FFFF			; indicates a startup		jsl	DeviceScan		; force online devices to be mounted		bcc	@scanOK		brl	ID_QUIT@scanOK;; --- Force the	last top window	to be top again	--------------------------;		lda	#MaxPathLen+MaxFilename+6 ;Number of bytes to allocate.		jsr	allocate		bcs	noMessageMemory		phx				Pass to	DisposeHandle.		pha		pea	GetMessage		Check if top window message is there.		pea	TopMessage		Top window message.		phx				Handle of data area to place message in.		pha		_MessageCenter		bcs	noMessage		lda	3,s		tax		lda	1,s			a,x = handle of	message.		phx		pha		_HLock				Lock the handle.		lda	3,s		tax		lda	1,s			a,x = handle of	message.		jsr	derefHand		temp = (Handle)		lda	#DirWindID		ldx	#toTop		jsr	walkWindow		Check every directory window.noMessage	jsl DisposeHandleGluenoMessageMemory	pea	DelMessage		;remove the top message now		pea	TopMessage		pha		pha		_MessageCenter		stz	cleanupState				jsl	ArrowCursor				rts				ENDP;==============================================;	Finder's Main Event Loop;==============================================FinderEventLoop	PROCNAME		import	checkCleanUp		IMPORT	DeviceScan		IMPORT	DeskWindState		IMPORT	CheckFront		IMPORT	CheckWindows;		IMPORT	CheckScrap		IMPORT	CheckSysParams		IMPORT	CheckPattern		IMPORT	CheckScrollBars		IMPORT	CheckMenus		IMPORT	CheckLECursor		IMPORT	CheckDevice		IMPORT	checkAboutRecalc		IMPORT	openAppleKey		IMPORT	shiftKeyStatus		IMPORT	controlKeyStatus		IMPORT	CheckSelectionChanged		IMPORT	RechargeOOM		IMPORT	SayIdle		IMPORT	VerifyClose		IMPORT	WalkWindow		import	DeselectAll,PendingDeselectAll		IMPORT	CheckVolumeChanged*** added 5-Jun-92 DAL -- If PendingDeselectAll (from an Open), deselect everything and***                       make front directory window the active plane		lda PendingDeselectAll		beq @noDeselectAll		stz PendingDeselectAll		jsr DeselectAll		lda #DirWindID+TrashWindID		jsr getFrontWind		beq @noDeselectAll		lda <wind+2		ldx <wind		sta <curWind+2		stx <curWind@noDeselectAll*** end 5-Jun-92		jsr	CheckDevice		; status all removable disks		jsr	CheckVolumeChanged	;7-Feb-93 JCM - see if we need to update windows because of extensions		jsr	CheckFront		;every time through the loop, check if a new window has come to front		jsl	RechargeOOM				lda	quit_flags		beq	@noExit		brl	exit@noExit				lda	#$7F3F			;no bit 6 because we want to handle drags		sta	<TaskMask		;ourself 		lda	#$001E			;no bit 15, we handle content stuff ourself		sta	<TaskMask+2		;no bit 7 because we do content ourself				lda	<LErename+1		beq	skip2		jsr	startDraw		pei	<LErename+2		pei	<LErename		_LEIdle		jsr	endDrawskip2		lda	#$FFFF		sta	allowTellFinderCalls		jsl	SayIdle				jsl	CheckSelectionChanged		pha				; space for result		PushWord #$3F6E			; event mask		jsr	pushTask		; Pass pointer to Task record		_TaskMaster		plx		bne	haveEventnullEvent	sec		lda	<when		sbc	eventTicks		sta	idleTicks		lda	<when+2		sbc	eventTicks+2		sta	idleTicks+2		jsr	CheckAboutRecalc		jsr	CheckCleanUp		jsr	CheckWindows		;check our windows for changes;		jsr	CheckScrap		;check for scrap changes		jsr	CheckSysParams		;check for new system parameters		jsr	CheckPattern		;check for new pattern message		jsr	CheckScrollBars		;check if scroll bars changed		jsr	CheckMenus		;set menu items to state of desktop		jsr	CheckLECursor		;fix cursor over a rename field		brl	FinderEventLoop;; the tickCounts below contain the number of ticks that we have been idle and the tickCount after we; last handled an event;		EXPORT	idleTicksidleTicks	dc.L	0eventTicks	dc.L	0		EXPORT	frqGlobalErrorfrqGlobalError	dc.w	0		EXPORT	allowTellFinderCallsallowTellFinderCalls dc.w 0;; we had something happen (run, as fast and as far as you can);haveEvent	stz	allowTellFinderCalls		lda	<modifiers		and	#$0800			;mask for option key		sta	functionKey				lda	<modifiers		and	#$0100			;mask for open-Apple key		sta	openAppleKey				lda	<modifiers		and	#$0200		sta	shiftKeyStatus				lda	<modifiers		and	#$1000		sta	controlKeyStatus		txa		jsr	HandleEvent		; handle event		jsr	CheckMenus		; now set menu items to state of desktop		pha				;save the tickCount when we handled this event		pha		_TickCount		pulllong eventTicks		lda	quit_flags		; is there an application to launch?		bne	exit		brl	FinderEventLoop		; no;-----------------------------------------------exit		name		jsr	noRename		; remove any rename field				_WaitCursor				jsr	FinderSaveAll		; save all important stuff		;--- Drag all online disk icons to the Trash ---		_CloseAllNDAs				pushlong <Taskdata		; close all the validate and verify windows		lda	#VerifyWindID		ldx	#VerifyClose		jsr	walkWindow				pulllong <TaskData		lda	<deskport		; switch to desktop		sta	<curWind		lda	<deskport+2		sta	<curWind+2		lda	#alldisks		jsr	walkBack		lda	#cutNFree		; free all icons on the desktop		jsr	walkBack		; must walk backwards; Mensch 5/15/89 (Fixing BRC #49179) - insertion A (others are in menu.aii); Added to support better quitting when you use the shutdown menu.; Shutdown/Restart and normal finder quit operations now all exit via the same code.; Also, shutdown & restart save the finder.data files properly.				IMPORT	RealRestart		IMPORT	RealShutdown				lda	quit_flags		; test quit flag to see if it was shut		and	#$000F		beq	@PlainQuit		; if the bit is clear, regular quit		and	#$0002			; how about restart or shutdown?		beq	@ShutDown		; go to a stepping-stone		brl	RealRestart@ShutDown		brl	RealShutdown@PlainQuit; end of BRC #49179 - insertion A		rts				; quit to application		;----------------------------------------------alldisks	name		ldy	#icFType		; only disk icons		lda	[<ic],y		bpl	exit100			; not a disk if not negative		cmp	#TypeFTrash		; not a disk		bcs	exit100		cmp	#TypeFDrive		; not a disk		beq	exit100		jsr	closeKids		; close this icon's windowsexit100		clc		rts		EXPORT	lastAboutTimelastAboutTime	dc.w	0			;last time we updated the aboutBox		EXPORT	aboutWindowPtraboutWindowPtr	dc.L	0		EXPORT	helpWindowPtrhelpWindowPtr	dc.L	0		EXPORT	helpTopichelpTopic	dc.w	$1000		ENDP*===============================================** Status Removable Devices for Disk Switches	**===============================================*CheckDevice	PROC		lda	<when		sec		sbc	lastTime		cmp	#52			; about 1 second		bcc	@done		lda	<when			; start counter again		sta	lastTime		pei <zero			; not a startup call		jsl	DeviceScan		; force disk inserts to be posted@done		rts;; locals;lastTime	dc.w	0		ENDP*===============================================** Check for new system parameters		**===============================================*CheckSysParams	PROC		IMPORT	GetClickSpeed		lda	<when		sec		sbc	LastParamTime		cmp	#90			; about 1.5 seconds		bcc	end		lda	<when			; start counter again		sta	LastParamTime		jsr	GetClickSpeed		; fetch system double click speed		lda DateFormat		pha				;save old format to see if it changes		pha		PushWord #$34			; Get user's date format		_ReadBParam		PullWord DateFormat		; set date format bits				pha		PushWord #$35			; Get time format		_ReadBParam		pla		beq	set		lda	#$8000			; set 24 hour bitset		tsb	DateFormat*** 20-Feb-92 DAL -- If we actually changed DateFormat, we walk the windows and*** invalidate any list-view windows that show the date in them.		pla				;retrieve old format		cmp DateFormat		beq @same		lda #dirWindID+trashWindID		ldx #InvalIfByDate		jsr walkWindow@same*** end 20-Feb-92		end		rts;; InvalIfByDate;; Invalidate window if it's a directory window & contains; a Last Modified column;; Input:  <wind, <windBlk;InvalIfByDate	ldy #windView		lda [<windBlk],y		cmp #viewByName		bcc @skip	;don't inval if by icon		cmp #viewByDate		beq @invalThis	;definitely inval if by date		lda prefer		and #PREF_SHOWDATE		beq @skip	;don't inval if no Date column@invalThis	pha		pha		_GetPort		pei <wind+2		pei <wind		_SetPort		pushlong #bigRect		_InvalRect		pushlong #bigRect		_EraseRect		_SetPort@skip		clc		;continue the walk		rtsbigRect		dc.w 0,0,10000,10000		ENDP*===============================================** Check for Scroll Bar changes			**===============================================*CheckScrollBars	PROC		lda	#DirWindID+TrashWindID		jsr	getFrontWind		beq	end			; skip if not a directory or Trash window.		lda	<TaskData		; were the scroll bars touched?		cmp	#wInFrame		beq	ckSize			; if yes, recompute window's data size.		cmp	#wInZoom		; was the window zoomed?		beq	ckSize			; if yes, recompute window's data size.		cmp	#wInGrow		; was the window resized?		bne	end			; if not, never mindckSize		jsr	newDataSize2		; compute new data for windowend		rts		ENDP*** Removed 19-Aug-92 DAL;*===============================================*;* Check Scrap for changes			*;*===============================================*;;CheckScrap	PROC;;		lda	<when;		sec;		sbc	LastScrapTime;		cmp	#90			; about 1.5 seconds;		bcc	end;;		lda	<when			; start counter again;		sta	LastScrapTime;;		pha				; Look at scrap count;		_GetScrapCount;		pla;		cmp	LastScrapCount		; has it changed?;		beq	end			; no;		sta	LastScrapCount		; Yes, update our last;		pha				; is the clipboard visible?;		pei	<clipWind+2;		pei	<clipWind;		_GetWFrame;		pla;		and	#FVis;		beq	end			; not vis, so no change;		pha				; save the current port;		pha;		_GetPort;		pei	<clipWind+2		; make clipboard window the current port;		pei	<clipWind;		_SetPort;		lda	#work			; get the port rect into temp area;		jsr	pushzpage;		_GetPortRect;		lda	#work			; call inval rect;		jsr	pushzpage;		_InvalRect		;		_SetPort			; restore port;		;end		rts;;		ENDP*===============================================** Check for a new Pattern Message		**===============================================*CheckPattern	PROC		import NewDeskPatFlag*** added 12-Dec-91 DAL		lda	NewDeskPatFlag		bmi	@definitelyNew*** end 12-Dec-91		lda	<when		sec		sbc	LastPatternTime		cmp	#60*10			; about 10 seconds		bcc	end@definitelyNew	lda	<when			; start counter again		sta	LastPatternTime		jsr	getPattern		bpl	end		pea	5		pea	DrawDesk>>16		pea	DrawDesk		_DeskTop			; draw the desktopend		rts				ENDP;-----------------------------------------------; Check if cursor is over a line edit field;-----------------------------------------------CheckLECursor	PROC		IMPORT	ArrowCursor		IMPORT	InsertCursor		IMPORT	ArrowPtr		IMPORT	InsertPtr		lda	<LErename+1		; is there a line edit field?		bne	@hasLE		rts@hasLE		lda	LEwind		sta	<curWind		lda	LEwind+2		sta	<curWind+2		jsr	StartDraw		pushlong #mousePoint		_GetMouse		lda	mousePoint		sta	<yrat		lda	mousePoint+2		sta	<xrat		pushlong #mousePoint		_LocalToGlobal				pha		pushlong #TopWindow		pushlong mousePoint		_FindWindow		pla		cmp #wInDesk		beq @onDesk		cmp #wInContent		bne @resetCursor	;if we're over a scroll bar/etc, use arrow		bra @notDesk*** If we're in the desktop, use IBeam only if LEWind is deskPort@onDesk		lda <deskPort+1		bra @checkWindow@notDesk	lda TopWindow+1@checkWindow	cmp <curWind+1		bne @resetCursor@inLEWindow	pha				; space for result		PushZPtr <yrat		PushLong #viewRect		_PtInRect@notInLEWindow	ply				; was it in the line edit field?		beq	no		jsl	InsertCursor		bra	done@resetCursorno		jsl	ArrowCursordone		jsr	EndDrawexit		rts;; locals;TopWindow	dc.L	0				mousePoint	dc.L	0		ENDP		; = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Force correct top window.; = = =	= = = =	= = = =	= = = =	= = = =	= = =;; Called from walkWindow for each current directory window.  A window that; matches the pathname in the message will be made the top window.;;   IN:	   temp	= pointer to message that contains pathname of top window.;	   wind	= window to check.;	   windBlk = window's info block.;; = = =	= = = =	= = = =	= = = =	= = = =	= = =toTop		PROC		IMPORT	WStrCompare				pha				; space for result				ldx	<windBlk+2		lda	<windBlk		clc		adc	#windPath		; offset to window's pathname		bcc	cont1		inxcont1		phx				; pass ptr to window's name		pha		ldx	<temp+2		lda	<temp		clc		adc	#6			; offset to pathname in message		bcc	cont2		inxcont2		phx				; pass ptr to message's name		pha		jsl	WStrCompare		pla		clc		beq	@done		PushZLong <wind			; make this window the active window		_SelectWindow		sec				; quit walkWindow@done		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Fetch system	double click speed.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =GetClickSpeed	PROC		pha				; space for result		pha		_GetDblTime			; fetch system double click speed		pla		plx		sta	doubleSpeed		rts		ENDP;==============================================;	   Handle TaskMaster event.;==============================================;;   IN:	   a-reg = Task Master event code;;==============================================handleEvent	PROCNAME EXPORT		IMPORT	insertItemRef		IMPORT	OpenAll		IMPORT	helpControls		IMPORT	closeAllMenu,closeMenu		IMPORT	matchWindName		IMPORT	pathGetName		IMPORT	allocate2		IMPORT	setTemp		IMPORT	openFolder3		IMPORT	pathSubName		IMPORT	aboutWindowPtr		IMPORT	GrowLErects		IMPORT	SetLErects		IMPORT	InfoControls;		IMPORT	LEfilter		IMPORT	LEWind		IMPORT	CleanUpLE		IMPORT	RenameIcon		IMPORT	walkWindow		IMPORT	WStringCopy		IMPORT	FindWindows		IMPORT	matchDev		IMPORT	walkOfLife		IMPORT	MountDisk		IMPORT	ProcessMenu		IMPORT	GetDeviceInfo		IMPORT	GetVolumeInfo		IMPORT	moveMenuToFront		IMPORT	pickAWindow		IMPORT	allowTellFinderCalls		IMPORT	getWindID		IMPORT	deselectAll		IMPORT	NoRename		IMPORT	MakeField		IMPORT	findFirstIcon		IMPORT	findSelect		IMPORT	lockic		IMPORT	unlockic		IMPORT	iconCount		IMPORT	firstIcon		IMPORT	MarkDeviceOffline		IMPORT	MarkDeviceOnline		IMPORT	IsDeviceOnline		import	DisposeHandleGlue		IMPORT	selectionIsChanging;;;volChangedEvt	equ	app1Evt	;8-Feb-93 JCM - no longer useddiskSwitchEvt	equ	app2EvtwInControl	equ	$0021wInSpecial	equ	$0019*** 20-Feb-92 DAL -- changed to a sentinel search		sta EventTable		ldx #EndTable-EventTable@search		dex		dex		dex		dex		cmp EventTable,x		bne @search		jmp (EventTable+2,x)*** end 20-Feb-92;-----------------------------------------------EventTable	dc.w	$7777,_ignore; JAM 06/01/89 Fixing BRC #49639; NOTE:  We have disabled GS/OS Volume Change Notification, so the only one who; will use this entry is the Finder, whenever it has to mop up a window with brute force;;;		DC.W	volChangedEvt,_VolumeChange	; end JAM 06/01/89 BRC #49639 - 7-Feb-93 JCM - no longer passed as events		dc.w	wInControl,_InControl		dc.w	wInContent,_InContent		dc.w	wInMenuBar,_InMenuBar		dc.w	wInSpecial,_InMenuBar		dc.w	wInGoAway,_InGoAway		dc.w	keyDownEvt,_KeyDown		dc.w	autoKeyEvt,_AutoKey		dc.w	wInInfo,_InInfoBar		dc.w	diskSwitchEvt,_DiskSwitch		dc.w	wInDesk,_InDesk		dc.w	wInDrag,_InDragEndTable;-----------------------------------------------_ignore		rts*** added 18-Feb-92 DAL -- Change Views by clicks in the info bar;; handle a mouseDown in the info bar;_InInfoBar	name		import ViewMenus,GetWRefCon2		lda <TaskData		;Get window's info block.		ldx <TaskData+2		jsr GetWRefCon2		;into <windBlk		ldy #windID		lda [<windBlk],y		and #dirWindID+trashWindID		beq @bogus		ldy #windView		;Icon view has no headers to click on		lda [<windBlk],y		cmp #viewByName		bcc @bogus		pha		pha		_GetPort		pei <TaskData+2		pei <TaskData		_SetPort		pei <zero		tdc		clc		adc #yrat		pha		_GlobalToLocal		lda <yrat		cmp #-9		bcc @notInHeader		cmp #-2		bcs @notInHeader		jsr ComputeViewFromX	;into carry, A		bcs @notInHeader		ldy #windView		cmp [<windBlk],y		beq @viewAlreadyOK		clc		adc #idByIcon		jsr ViewMenus@viewAlreadyOK@notInHeader	_SetPort@bogus		rts;; ComputeViewFromX;; Input:  <xrat = horizontal position in info bar (local coordinates);; Output: CLC, A = view number they clicked in;         SEC, not in a column header;;; "[access] Name      [Size]  [Kind]  [Date]";ComputeViewFromX ;name		jsr ComputeColumns		ldx <zero@checkRange	lda nameCoords,x		beq @tryNextCol		cmp <xrat		bcs @tryNextCol		lda <xrat		cmp nameCoords+2,x		bcs @tryNextCol		txa		lsr a		tax		lda translateToView,x;		clc		rts@tryNextCol	inx		inx		inx		inx		cpx #16		bcc @checkRange;		sec		rtstranslateToView	dc.w viewByName,viewBySize,viewByKind,viewByDateComputeColumns	;namecolumnTwo	equ dxViewSize		stz sizeCoords		;in case field is not displayed!		stz kindCoords		stz dateCoords		jsr ComputeNameColumn	;into nameCoords		lda #columnTwo		sta curX		lda #viewBySize		jsr CheckColumnPresent		bcs @noSize		sta sizeCoords		lda #dxViewKind-dxViewSize		jsr AdvanceCurX@noSize		lda #viewByKind		jsr CheckColumnPresent		bcs @noKind		sta kindCoords		lda #dxViewDate-dxViewKind		jsr AdvanceCurX@noKind		lda #viewByDate		jsr CheckColumnPresent		bcs @noDate		sta dateCoords@noDate		ldx #3@widths		phx		txa		pha			;space for StringWidth		pea StringBase>>16		asl a			;0..3 counter still in A		tax		lda theHeaderStrings,x		pha			;pushed string pointer		_StringWidth		lda 3,s			;get counter back		asl a		asl a		tax		pla			;get string's width		clc		adc nameCoords,x		sta nameCoords+2,x		plx		dex		bpl @widths		rts;; ComputeNameColumn;; Output: nameCoords = horizontal position of the Name column;; This is a function of the window's network access.; Returned value is the maximum of 16 or 4+N, where; N is the number of server access icons needed.;ComputeNameColumn		lda #16		sta nameCoords		ldy #windAccess		; Is icon from a network?		lda [<windBlk],y		and #ICNETWORK>>16		beq @done		; no		lda [<windBlk],y	;get user's access bits		and #7			;apSeeFiles+apSeeFolders+apMakeChanges		eor #7			;apSeeFiles+apSeeFolders+apMakeChanges		beq @done		;no icons, use X=16; Now add 32 for each access bit set in A; (Note than N=BitWiseAND(N,N-1) always decreases the number of "1" bits by one)		ldx #4@countBits	pha		txa		clc		adc #28+4		;icon width plus gap		tax		lda 1,s		dec a		and 1,s		sta 1,s		pla		bne @countBits		stx nameCoords@done		rts;; CheckColumnPresent;; Input:  view number in A (date, size, or kind);; Output: SEC if column is not displayed in this window;         CLC if column is displayed, and A = curX;CheckColumnPresent		ldy #windView		cmp [<windBlk],y		beq @present		asl a		tax		lda viewMasks,x		and prefer		beq @absent@present	lda curX		clc		rts@absent		sec		rtsviewMasks	dc.w 0			;icon		dc.w 0			;small icon		dc.w 0			;name		dc.w PREF_SHOWDATE	;date		dc.w PREF_SHOWSIZE	;size		dc.w PREF_SHOWKIND	;kindAdvanceCurX	clc		adc curX		sta curX		rtscurX		dc.w 0nameCoords	dc.w 0,0sizeCoords	dc.w 0,0kindCoords	dc.w 0,0dateCoords	dc.w 0,0theHeaderStrings dc.w IBName,IBSize,IBKind,IBDate  ;in strings.aii*** end 18-Feb-92;; handle mousedown in drag region;_InDrag		NAME		lda	<modifiers		and	#$0100		bne	@appleKey				pea	$8000			;default drag resolution, bring to front afterwards		pei	xrat			;startX		pei	yrat			;startY		pea	8			;grace (distance away from boundsrect before snapping back)		pei <zero		pei <zero			;boundsRectPtr		pushZLong <taskData		_DragWindow		rts;; They hit the apple key while clicking in the drag region (title bar) of the window.  We need to see if they hit; inside the title of the window only if the window is frontmost.;@dragBehind	pei <zero			;default drag resolution, don't bring to front		pei <xrat			;startX		pei <yrat			;startY		pea 8				;grace (distance away from boundsrect before snapping back)		pei <zero		pei <zero			;boundsRectPtr		pushZLong <taskData		_DragWindow		rts@appleKey	pha		pha		_FrontWindow		pulllong deref		;		lda	deref;		cmp	taskData;		bne	@dragBehind;		lda	deref+2;		cmp	taskData+2;		bne	@dragBehind*** optimized 9-Jun-92 DAL		lda <deref+1		cmp <taskData+1		bne @dragBehind*** end 9-Jun-92		pha		pha		pushZLong taskData		_GetWRefCon		pulllong deref;;;		ldy	#4		ldy	#windID		lda	[deref],y		and	#dirWindID		beq	@dragBehind		pha		pha		_GetPort				pha		pha		_GetWMgrPort		_SetPort		pha		lda	#windTitle	;find out how wide the title is		clc		adc	deref		tax		lda	deref+2		adc <zero		pha		phx		_StringWidth		pla		lsr	a		;1/2 the width		sta	halfWidth	;this wide				pha		pha		pushZlong taskData	;get the struct region for our window so we		_GetStructRgn		;can find out if we're in the middle		pulllong deref				lda	[deref]		;dereference the handle from structrgn		tax		ldy	#2		lda	[deref],y		sta	deref+2		stx	deref		ldy	#2		;find the window's top, then find the left		lda	[deref],y	;and right edges		sta	windowTop		iny		iny			;find the boundsRect of the region at +2		lda	[deref],y	;(y,x,y,x)		ldy	#8		clc		adc	[deref],y		php		lsr	a		plp		bpl	@1		ora	#$8000@1		sta	windowMiddle				sec		sbc	halfWidth		sta	titleLeft				lda	windowMiddle		clc		adc	halfWidth		sta	titleRight				lda	xrat		cmp	titleLeft		bmi	@notInTitle			cmp	titleRight		bmi	@inTitle		@notInTitle	_SetPort		brl	@dragBehind;; if they get this far, they hit OA-click in the title of the window, so show them a; path.;; DAL's cool pop-up menu stuff follows;@inTitle			jsr 	BuildPathMenu				lda	PopUpMenuHandle		sta	deref		lda	PopUpMenuHandle+2		sta	deref+2				lda	[deref]		;deref the menu to find the width		tax		ldy	#2		lda	[deref],y		stx	deref		sta	deref+2				lda	[deref],y	;menu width		lsr	a		eor	#$FFFF		sec		adc	windowMiddle	;		and	#$fffe		;align it to an even pixel boundary		lsr a		asl a		tax				pha			;space for PopUpMenuSelect result		lda 	pmHighestID	;select with last (top) item inserted		pha		phx 			;x coord, global coordinates		lda	windowTop	 ;y coord, global coordinates		clc						adc <zero		;special twiddling stuff courtesy of DAL		pha		pea 	$0040		;flag (type 2 menu, no white space added)		pushlong PopUpMenuHandle ;dave says "I don't care, it works"		_PopUpMenuSelect		pla		sta 	theChosenItem			pha		pei <zero		;we want to know if they are		jsr pushTask		;holding down the option key for anti-tunneling		_GetNextEvent		pla			_SetPort		;restore the old port		jsr 	KillPathMenu		lda 	theChosenItem		;did they choose anything?		bne 	@notDone@done		rts	;; stuff the proper pathname into C1_Pathname and make the proper title;@notDone		pha		pha		pushZLong taskData		_GetWRefCon		pulllong deref		lda	deref			;get the pathname for this window		clc		adc	#windPath		ldx	deref+2		bcc	@nr		inx	@nr		phx		pha		pushlong #C1_Pathname		jsl	WStringCopy				lda 	theChosenItem		cmp	pmHighestID		beq	@done@popUpSome	pha		pushlong #C1_Pathname		jsl	pathSubName		;remove one level from the path		pla		inc 	a		cmp 	pmHighestID		;the top-level item		bne 	@popUpSome;; now, check to see if the window which we THINK we are about to open already; is open -- if it is, make it the front window.  If not, open it, making it the; front window;; the FRQ routines also use this entry to open a window from a pathname;		EXPORT frqOpenfrqOpen		import PendingDeselectAll		inc PendingDeselectAll		;5-Jun-92 DAL		jsr	clonePath		;C1_TempPath = C1_PathName		lda	#DirWindID		;Directory windows only.		ldx	#matchWindName		jsr	walkWindow		;Look for a window that matches C1_TempPath.		bcc	@noWindowFound		pei	<wind+2			;walkWindow leaves the window it found		pei	<wind			;'wind'		_SelectWindow		lda	<modifiers		;are they attempting to anti-tunnel?		and	#$0800		beq	@nope			;nope, just do the bringToFront			jsr	doClose			;otherwise, close the child window@nope		lda <zero			;no error		rts;; the window wasn't already open, so open a new one, allocating memory for the window; info block and making a title and proper windPath from C1_Pathname;@noWindowFound		lda	#windPath		;Number of bytes to allocate.		clc		adc	c1_pathname		inc	a		inc	a		ldx	#$4000			;Fixed block, cause of window's title.		jsr	allocate2		;Allocate the memory.		sta	<temp			;Save handle.		stx	<temp+2		jsr	setTemp			;Dereference 'temp'.		sta	wind_ref		;RefCon = address of information block.		stx	wind_ref+2		sta	wind_infot		;Set info bar refCon also.		stx	wind_infot+2		clc				;Compute address of title.		adc	#windTitle		bcc	@store1		inx@store1		sta	wind_title		stx	wind_title+2		sta	<work			;Remember title's address.		stx	<work+2		lda <zero			;Clear the info block.		ldy	#windPath-2		;Number of bytes in block.@wzLoop		sta	[<temp],y		dey		dey		bpl	@wzLoop		sta  	[<temp]			;in case of odd length		pushlong #C1_TempPath		pushlong #C1_Pathname		jsl	PathGetName		;get the end name into C1_Tempath				lda	C1_TempPath		;make C1_TempPath into a pstring		xba		sta	C1_TempPath				lda	#C1_TempPath+1		;temp is source		sta	<temp		lda	#^C1_TempPath+1		sta	<temp+2				pha				;source		pei	<temp		lda	wind_ref		;setup to point to out menu item		clc		adc	#windMenuText		sta	insertItemRef+10		tax		lda	wind_ref+2		adc <zero		sta	insertItemRef+12		pha				;dest		phx		jsl	PStringCopy		;move the name into the menu text				lda	wind_ref		;work is destination		clc		adc	#windTitle		sta	<work		lda	wind_ref+2		adc <zero		sta	<work+2				jsr	padName			;pad our name with spaces and stuff it						;into the window's title field				jsr	openFolder3				lda	<modifiers		;are they attempting to anti-tunnel?		and	#$0800		beq	@noAntiTunnel		;nope, just do the bringToFront			jsr	doClose			;otherwise, close the child window@noAntiTunnel	rts		;; BuildPathMenu -- new routine 14-Jan-91 DAL;BuildPathMenu	stz 	pmHandle1+1		stz 	pmHandle2+1		stz 	PopUpMenuBar+1		stz 	PopUpMenuHandle+1		pha		pha		_GetMenuBar		pla		sta 	OldMenuBar		pla		sta 	OldMenuBar+2			pha		pha		pei <zero		pei <zero		_NewMenuBar		lda 	3,s		sta 	PopUpMenuBar+2		lda 	1,s		sta 	PopUpMenuBar		_SetMenuBar			pha		pha		pei <zero		pushlong #MyMenuTemplate		_NewMenu2		lda 	1,s		sta 	PopUpMenuHandle		lda 	3,s		sta 	PopUpMenuHandle+2		pei <zero		;insert new menu at beginning of bar		_InsertMenu			pha		pha		pushZLong taskData		_GetWRefCon		pulllong deref					pea 	$0004		;open folders, device at bottom		clc		lda 	deref		adc 	#windPath		tax		lda 	deref+2		adc <zero		pha		phx			;pathname pointer (word-length string)		pei <zero		;device number of device so we don't runn their drive		pea 1			;Menu ID		pei <zero		;insert at beginning of menu		pea $0101		;starting Item ID		pushlong #IPMIResults		_InsertPathMItems		rts;; KillPathMenu;KillPathMenu	pea 1		_DeleteMenu		pushlong PopUpMenuHandle		_DisposeMenu		pushlong PopUpMenuBar		jsl DisposeHandleGlue		pushlong pmHandle1		jsl DisposeHandleGlue		pushlong pmHandle2		jsl DisposeHandleGlue		pushlong OldMenuBar		_SetMenuBar		rts;; locals;pathDItemNum	dc.w 	0thePathItemBox	dc.w 	0,0,0,0MyMenuTemplate	dc.w 	0		;version		dc.w 	1		;Menu ID		dc.w 	$0020		;everything is by pointer; XOR drawing		dc.l 	MyMenuTitle	;empty title		dc.l 	0		;no itemsMyMenuTitle	dc.b 	0		;null pStringOldMenuBar	dc.l 	0PopUpMenuBar	dc.l 	0PopUpMenuHandle	dc.l 	0theChosenItem	dc.w 	0IPMIResultspmHighestID	dc.w 	0pmHandle1	dc.l 	0pmHandle2	dc.l 	0windowTop	dc.w	0windowMiddle	dc.w	0halfWidth	dc.w	0titleLeft	dc.w	0titleRight	dc.w	0;; Handle button down in info window;_InControl	NAME		pha		pha		pushZlong <taskData		_GetWRefCon		pulllong <deref				ldy	#windID		lda	[<deref],y		and	#infoWindID		bne	@info				lda	[<deref],y		and	#helpWindID		beq	@done		jsl	helpControls@done		rts		@info		PushZLong <TaskData		;control's window		PushZLong <TaskData2		;control's handle		PushZWord <TaskData3		;control's part code		PushZLong <TaskData4		;control's ID		jsl  	InfoControls		rts;; _InControl locals;teHandle	dc.L	0		;handle to our text edit control		text		dc.w	$1000		;references to rText resources we use		dc.w	$1001		dc.w	$1002		dc.w	$1003		dc.w	$1004		dc.w	$1005		dc.w	$1006		dc.w	$1007		dc.w	$1008;; Handle button down on desktop;_InDesk		NAME		lda	<deskport		sta	<TaskData		lda	<deskport+2		sta	<TaskData+2		brl	windclick		;; Handle button down in window's content region;_InContent	NAME		stz	<taskData2		stz	<taskData2+2				stz	<taskData3		stz	<taskData3+2				stz	<taskData4		stz	<taskData4+2				pha		pushlong #ourCtlHandle		pei	<xrat		pei	<yrat		pushZLong #taskData		_FindControl		pla		sta	<taskData3		;did they hit a control?		bne	@inControl		brl	notInControl		;nope, must have hit something else?@inControl				lda	ourCtlHandle		sta	<taskData2		lda	ourCtlHandle+2		sta	<taskData2+2@getCtlID	pha		pha		pushZLong <taskData2		_GetCtlID		pulllong <taskData4		;our ID		bcs	@bogus		pha				;see if our front window is the window we're doing		pha				;stuff in, and if it is, skip the selectwindow to 		_FrontWindow			;increase the speed of response... (Gee, could TaskMaster		pla				;do this internally for other apps Dave?).		plx		cmp	<TaskData		bne	@selectIt		cpx	<TaskData+2		beq	@noSelect		@selectIt	pushZLong <taskData		_SelectWindow@noSelect						pha		pei	xrat			;x		pei	yrat			;y		pushlong #$FFFFFFFF		;actionProcPtr		pushZLong <taskData2		;ourCtlHandle		_TrackControl		pla		bne	hitAControl		;they definitely hit it if get past here@bogus		rts		hitAControl	;name		sta	<taskdata3+2		;the part code when the user released				cmp	#3			;check box?		beq	@setVals		cmp	#4		bne	@goControls		@setVals	pha		pushZlong <taskData2		_GetCtlValue		pla		bne	@reset		pea	1		bra	@set@reset		pei <zero@set		pushZlong <taskData2		_SetCtlValue		@goControls	brl	_InControl;; notInControl -- only called if we think that they didn't hit anything in a control;; we only want to call windClick if they were in the trash or a directory window;notInControl		lda	<taskData		ldx	<taskData+2		jsr	getWindID		cmp	#DirWindID		;is the window they clicked in a directory window?		beq	enter1		cmp	#TrashWindID		beq	enter1		pha				;see if our front window is the window we're doing		pha				;stuff in, and if it is, skip the selectwindow to 		_FrontWindow			;increase the speed of response... (Gee, could TaskMaster		pla				;do this internally for other apps Dave?).		plx		cmp	<TaskData		bne	@selectIt		cpx	<TaskData+2		beq	@noSelect		@selectIt	pushZLong <TaskData		_SelectWindow@noSelect	rtsenter1		jsr	windclick		rtsourCtlHandle	dc.L	0;; Handle menu selection;_InMenuBar	NAME		jsr	ProcessMenu		; uses task data		rts;; Handle close window;_InGoAway	NAME		lda	<modifiers		;are they attempting to close everything?		and	#$0800			beq	@nope			;nope, just close a single window		brl	closeAllMenu@nope		brl	doClose			; uses task data;; Handle key event;_KeyDown	NAME_AutoKey*** added 6-Mar-93 DAL -- If systemSaysMenuKey ate the key, don't do anything		lda	<what		bne	@continue		rts@continue*** end 6-Mar-93		lda	<modifiers		and	#$0100			;Command key down?		beq	@checkLE*** added 9-Jun-92 DAL -- Make Command-Control-W work (close window, toggle save setting)		lda	<message		cmp	#'W'-$0040		;Control-W		bne	@notClose		jmp	closeMenu@notClose*** end 9-Jun-92		lda	<modifiers		and	#$0800		beq	@checkLE		;was the option key down? (nope);; if we get here, they were holding down OA and OPTION, so we probably want to close; something, somehow;		lda	<message		cmp	#'W'			;no key trans		beq	@optionW*** added 9-Jun-92 DAL		cmp	#'W'-$0040		;Contnrol-W		beq	@optionW*** end 9-Jun-92		cmp	#'w'			;no key trans		beq	@optionW		cmp	#$e3			;OPTION-Shift-w (key trans on)		beq	@optionW		cmp	#$b7			;OPTION-w	(key trans on)		bne	@checkOpen		@optionW	jmp	closeAllMenu		@checkOpen	cmp	#'O'			;no key trans		beq	@optionO		cmp	#'o'			;no key trans		beq	@optionO		cmp	#$af			;OPTION-Shift-o (key trans on)		beq	@optionO		cmp	#$bf			;OPTION-o	(key trans on)		bne	@checkLE		@optionO*** added 1-Mar-93 DAL -- If there's nothing to open, make sure we don't close curWind		stz	iconCount		lda	#findFirstIcon		jsr	findSelect		lda	iconCount		beq	@done*** end 1-Mar-93 DAL		pei	<curWind+2		pei	<curWind				jsr	openAll				plx		ply				lda	<modifiers		;did they want to tunnel?		and	#$0800		beq	@done				stx	<taskData			sty	<taskData+2				jsr	doClose			;put away the parent			@done		rts;; they didn't hit the OA key, so check for an LE field;@checkLE*** added 9-Jun-92 DAL -- Command-Shift-Up = select desktop (like Command-Esc)		lda	<message		cmp	#$000b			;up arrow		bne	@notCmdShiftUp		lda	<modifiers		and	#appleKey+shiftKey+controlKey+optionKey		cmp	#appleKey+shiftKey		beq	@handleEsc@notCmdShiftUp*** end 9-Jun-92		lda	<LErename+1		; is there a line edit field?;;;		bne	@haveLE		beq	@noLE		jmp	@haveLE@noLE		lda	<message		cmp	#13		bne	@notCR			stz	iconCount		lda	#findFirstIcon		jsr	findSelect		lda	iconCount;;		beq	@notCR;;		cmp	#2;;		bge	@notCR		dec a		bne @notCR		lda	firstIcon		sta	<icHand		lda	firstIcon+2		sta	<icHand+2				jsr	lockic		jsr	makeField		brl	unlockic				@notCR		cmp	#27		bne	@notEsc@handleESC	jsr	deselectAll*** added 5-Jun-92 DAL***   If Command is not down, make the front window the current plane.***   If Command is down, make the Desktop the current plane.		lda <modifiers		and #appleKey		*** Added - 20-Jan-93 JCM - This code is now used in a special case for AppleShare servers going offline, so***			    I threw it into a subroutine. When it's called, the Accumulator contains a flag***			    that indicates if it is to make the top window (A=0), or the desktop (A≠0) active.				jsr	SetupProperCurWind;;;		bne @selDesktop;;;;;;		lda #DirWindID+TrashWindID;;;		jsr getFrontWind;;;		beq @selDesktop;;;		lda <wind+2;;;		ldx <wind;;;		bra @selectAX;;;;;;@selDesktop	lda <deskPort+2;;;		ldx <deskPort;;;;;;@selectAX	sta <curWind+2;;;		stx <curWind*** end 5-Jun-92 DAL*** End - 20-Jan-93 JCM		rts		@notEsc		lda	<message		sta	srqKeyHitParms+2		lda	<modifiers		sta	srqKeyHitParms+4*** added 22-Jun-92 DAL for 6.0.1		lda	<when+2		sta	srqKeyHitTicks+2		lda	<when		sta	srqKeyHitTicks*** end 22-Jun-92		lda	#$FFFF		sta	allowTellFinderCalls				pea	$010A			;finderSaysKeyHit		ldx <zero		pea	$8000			;how = send to first guy who accepts it		phx		phx				;target = nil		pushlong #srqKeyHitParms		phx		phx				;dataOut = nil		_SendRequest		stz	allowTellFinderCalls		rts@haveLE		lda	<message		; was the key a return key?		cmp	#27			; was the key an ESC key?		beq	@handleESC		cmp	#13		bne	useKey		jsr	RenameIcon		; yes, so rename the icon		bcs	@toExitKey		jsl 	selectionIsChanging	;2-Apr-93 JCM - let things like Key Nav know about resorting of icons		jsr	noRename@toExitKey	bra	exitKeyuseKey		jsr	startDraw;;		lda	<message;;		jsr	LEfilter		; filter out funny keys;;		sta	<message;;		bcs	post			; just post edit keys*** 20-Mar-92 DAL -- use LEClassifyKey to identify LE edit keys		pha		pea 0		tdc		clc		adc #TaskRec		pha;		_LEClassifyKey		ldx #$2514		jsl $e10000		pla		bmi post	;bit 15 = special editing character		lda <message		cmp #$0020		bcs @okay		lda #$002e	;make it into a period		sta <message@okay*** end 20-Mar-92 DAL;--- If there's no selection and current length;--- is 31 then beep at the user and ignore key		lda	<modifiers		and	#AppleKey		bne	beep		lda	[<LErename]		; get the line edit record pointer		sta	<temp		ldy	#2		lda	[<LErename],y		sta	<temp+2		ldx <zero			; fake length of zero (used below)		ldy	#oleSelStart		; see if there is any selection		lda	[<temp],y		ldy	#oleSelEnd		cmp	[<temp],y		bne	@here			; yes, so accept new key		ldy	#oleLength		; get the text's length		lda	[<temp],y		tax@here*** Removed bogus PLA (20-Feb-92 DAL);;;		pla				; get char back		cpx	LE_MaxLen		bcc	growbeep		pea	10		_SysBeep2			; beep at user		bra	doneKey			; don't post keygrow		jsr	GrowLErects		; grow view & dest rects;-----------------------------------------------post		PushZWord <message		; pass key		PushZWord <modifiers		; pass modifier keys		PushZLong <LErename		; pass handle of line edit field		_LEKey				inc	LEdirty			; changes were made		jsr	SetLErects		; set view & dest rects		jsr	CleanUpLE		; cleanup underneath shrinking rects		doneKey		jsr	endDrawexitKey		rts;; locals;		ENTRY	LE_CenterLE_Center	DC.W	0		ENTRY	LE_MaxLenLE_MaxLen	DC.W	31		ENTRY	LEdirtyLEdirty		DC.W	0srqKeyHitParms	dc.w	3			;pcount (2 for 6.0, 3 for 6.0.1)		dc.w	0			;message		dc.w	0			;modifiers*** added for 6.0.1srqKeyHitTicks	dc.l	0			;tick count (22-Jun-92 DAL)*** end of 6.0.1 additions		******************************************************************************************		** SetupProperCurWind - This properly sets up <curWind to either the front-most window*		       (if Acc=0) or the desktop (if Acc≠0). If there is no front window, then*		       the desktop will be selected. It is called by the key handling*		       code if Esc is detected, and by the _DiskSwitch code if an AppleShare*		       volume has gone offline.*		SetupProperCurWind NAME	EXPORT		bne @selDesktop			;value stuffed into acc must have set up Z bit		lda	#DirWindID+TrashWindID		jsr	getFrontWind		beq	@selDesktop		lda	<wind+2		ldx	<wind		bra	@selectAX@selDesktop	lda	<deskPort+2		ldx	<deskPort@selectAX	sta	<curWind+2		stx	<curWind				rts;; Handle disk switch;_DiskSwitch	NAME		lda	<message		; get device number		sta	<devNumber		lda	<message+2		; get type of switch		bmi	@diskInsert		; high bit means eject	@diskEject	pushZLong <curWind		lda	<deskport		; check desktop ICONOBJ list		sta	<curWind		lda	<deskport+2		sta	<curWind+2		lda	<devNumber		; mark the device as offline		jsl	MarkDeviceOffline		stz	serverGoingOffline	;20-Jan-93 JCM - assume this isn't a server that's been switched		lda	#matchDev		; mark the device as offline (and dim icons and windows)		jsr	walkOfLife*** Added - 20-Jan-93 JCM - This fixes the bug if a server window went away unexpectedly (connection went down/***			    admin bumped you off/etc.). If a window was open from that server, and it was***			    frontmost, then it was left as <curWind even after it was closed. Bad. Very bad.***			    This was one of the causes of the infinite walkOfLife message.		lda	serverGoingOffline	;was the device that just got ejected a server?		beq	@restoreCurWind		;				inc	a			;Acc was $FFFF		jsr	SetupProperCurWind				pla				;window pointer of window that may have been closed		pla				rts	@restoreCurWind	pulllong <curWind;;;		pulllong <curWind*** End - 20-Jan-93 JCM		rts		@diskInsert	jsr	CheckQForEvent		;check the event queue for inserts		bcs	@end			 or ejects involving this device				lda	<devNumber		;does the Finder think that this device number is still online?		jsl	IsDeviceOnline		bcc	@mount			;if not, then sure, mark this device as online and mount it				jsr	@diskEject		@mount		lda	<devNumber		jsl	MarkDeviceOnline				pei <zero			;we are not starting up...		PushZWord <devNumber		; device number of new disk		lda	<message+2;		and	#$7FFF		asl a		lsr a		pha				; pass remaining bits as flag		jsl	MountDisk		bcs	@end			; not mounted		jsr	_VolumeChange		; JAM 5/20/80 (Fixing BRC #36621)@end		rts		EXPORT  serverGoingOfflineserverGoingOffline ds.w	1			;20-Jan-93 JCM - Added to fix infinite server icon walk bug		;; Handle volume change;		IMPORT	UpdateDesktopIcons	;22-Mar-93 JCM		EXPORT	_VolumeChange		;19-Jan-93 JCM - for icons.aii magic routing code_VolumeChange	NAME		lda	<message		; a <-- device number		beq	exitVol		pha				; pass device number		ldx <zero			;20-Feb-92 DAL		PushLong #C1_DeviceName		; pointer to device name		phx		phx				; skip characteristics		phx		phx				; skip total blocks		phx		phx				; skip device ID		jsl	GetDeviceInfo		bcs	exitVol		PushLong #C1_DeviceName		; pointer to device name		PushLong #C1_VolName		; pointer to volume name		ldx <zero			;20-Feb-92 DAL		phx		phx				; skip total blocks		phx		phx				; skip free blocks		phx		phx				; skip file system ID		phx		phx				; skip block size		jsl	GetVolumeInfo		bcs	exitVol*** added 21-Aug-92 DAL -- FindWindows wants the volume name in C1_Pathname		pushlong #C1_VolName		pushlong #C1_Pathname		pea 0		lda >C1_VolName		inc a		inc a		pha		_BlockMove*** end 21-Aug-92*** Removed 21-Aug-92 DAL.  Gosh, I wonder if this will be a bug again, but I need this WalkWindows.	; This fixes a problem in which, with a text-view window popping out of a newly-; inserted volume icon, the system would hang, sometimes crashing, and sometimes; going into an endless loop somewhere in the _EndUpdate tool call.; The window that popped out had to be in text-view, had to be the first one on; the desktop, and had to include an icon ON the desktop.  The difficulty appeared; to be caused by the VolumeChange window-update walk.  Don solved the problem; by arranging not to do the update walk if we knew that this was the icon’s first; appearance.;		lda	createIcon		; is this a new volume?;		bne	exitVol			; yes, so don’t bother to update*** end 21-Aug-92 DAL		lda	#DirWindID		; find all directory windows		ldx	#FindWindows		; from this volume		jsr	walkWindow				IF	AllowSmartDesktop THEN				jsr	UpdateDesktopIcons	;22-Mar-93 JCM		ENDIFexitVol		rts;; Check the event queue for a disk insert or disk eject event for the same device; that we're checking now.;; On Event Manager DP: $24 = Handle to event queue;		       $2E = Offset to first element in queue;; Each element in the queue is an 18 byte record, the first word is the offset in the;  queue handle of the next element.  The remaining 16 bytes are a standard event;  record.;; OUT: Carry clear if no other event pending;      Carry set if another event for the same device is pending;CheckQForEvent	pha		pha		pei <zero		pea 6			;Event Manager toolset number		_GetWAP		pulllong <ptr				ldy	#$2e		;are any other events pending at all?		lda	[<ptr],y		beq	@done		;none, so we're done				ldy	#$24		;get handle to event manager's event queue		lda	[<ptr],y		sta	<handle2		iny		iny		lda	[<ptr],y		sta	<handle2+2		lda	[<handle2]	;deref handle to event queue		tax		ldy	#2		lda	[<handle2],y		sta	<ptr2+2		stx	<ptr2				ldy	#$2e		;find offset into memory block for the first		lda	[<ptr],y	;event record@loop		tax		txy		iny		iny		lda	[<ptr2],y	;event what		cmp	#diskSwitchEvt		beq	@switch		@nextEvent	txy		lda	[<ptr2],y		bne	@loop				@done		clc		rts		@switch		iny		iny		lda	[<ptr2],y	;event message		cmp	<devNumber	;is it our device?		bne	@nextEvent					sec			;our device shows an insert or eject coming, skip		rts				ENDP******************************************************************************************		** CheckVolumeChanged - Scan the volume dirty table for volumes that need refreshing.**		IMPORT	FindChangedVolumeCheckVolumeChanged PROC	EXPORT@findMoreDirty	jsl	FindChangedVolume	;are any volumes dirty?		bcs	@exitVolumeChanged	; nope, nothing to do		sta	<message		;pass device number to _VolumeChanged		jsr	_VolumeChange		;update any open windows from this volume		bra	@findMoreDirty		;see if we have any more to do@exitVolumeChanged rts				;we be gone				ENDP; Find all icons of a device number;; IN: ic = pointer to ICONOBJ (from WalkOfLife);     devNumber = device number to check;.....................................................................matchDev	PROC		IMPORT  pushirect2		IMPORT  getwRefCon		IMPORT	addRgn		IMPORT	freeRectRgn		IMPORT  getIconRect		IMPORT	TrashDisk		IMPORT	eraseIcon		IMPORT	allOffLine		IMPORT	markOffLine		IMPORT	drawDeskIcon		IMPORT	AddIconRgn		IMPORT  serverGoingOffline		ldy	#icDevNum		lda	[<ic],y		cmp	<devNumber		bne	next		ldy	#icFType		; and yet another DISKII Special case check		lda	[<ic],y		cmp	#TypeFDrive		; is it a STUPID diskII drive ?		beq	next		lda	<icHand		cmp	LEicon		bne	cont		lda	<icHand+2		cmp	LEicon+2		bne	cont				jsr	NoRename		; remove icon's rename field (if any)		cont		ldy	#icFType		lda	[<ic],y		cmp	#TypeServer		; is this a server volume		bne	normal		dec	serverGoingOffline	;20-Jan-93 JCM - make = $FFFF - fixes server unmount bug		jsr	toDesktop		; switch to desktop 		jsr	toDeskPort		; switch to desktop port		jsr	getRectRgn		; allocate rectRgn and tempRgn		jsr	AddIconRgn				jsr	TrashDisk		; throw the server volume in trash		jsr	redrawList		sec				; terminate the walk of life		bra	exitnormal		jsr	toDesktop		; switch to desktop 		jsr	toDeskPort		; switch to desktop port		jsr	getRectRgn		; allocate rectRgn and tempRgn		jsr	getIconRect		; irect2 = icon's title area		ldy	#icDevInfo		;when CD-ROM's go offline, don't clear the locked bit so that		lda	[<ic],y			;the Finder has an accurate idea of what kind of device that's there...		and	#$0040					beq	@cdrom			;check the "writing allowed" bit		ldy	#icFlag		lda	[<ic],y		and	#≈(ICLOCKED)		; clear locked bit so it redraws		sta	[<ic],y			; without the lock@cdrom		lda	#irect2		jsr	addRgn		jsr	redrawList		jsr	lockic		ldy	#icDevNum		lda <zero			; zero means offline		sta	[<ic],y		pei	<devNumber		jsr	markOffLine		; mark icon as off line and redraw		jsr	allOffLine		; mark all windows from disk as off line		pla		sta	<devNumber		jsr	updateInfoWin2		;added 07/27/88 DJBnext		clc				; continue.exit		rts		ENDP; match second icon that findSelect is called for;; IN: iconCount is either 0 or 1;; OUT: iconCount is incremented;..................................................................... 		findFirstIcon	PROC	EXPORT		IMPORT	abortFind		inc	iconCount		lda	iconCount		cmp	#2		bge	@done		lda	<icHand		sta	firstIcon		lda	<icHand+2		sta	firstIcon+2				clc		rts		@done		inc	abortFind		;stop!!		sec		rts		EXPORT	iconCounticonCount	dc.w	0		EXPORT	firstIconfirstIcon	dc.L	0		ENDP		; give an icon a new name;.....................................................................nameIcon	PROC		IMPORT	HalfRoundUp		; JAM 5/12/89: To fix BRC #47825		jsr	geticNamePtr		temp = pointer to icon's name field.		ldy	#30			Set icon's name to new name.lop101		lda	lastName,y		sta	[<temp],y		dey		dey		bpl	lop101		pha				Space for result.		pea	lastName>>16		pea	lastName		_StringWidth		pla		jsl	HalfRoundUp		; JAM 5/12/89: a := (acc DIV 2) + (acc MOD 2)		ldy	#icTitleLen		sta	[<ic],y			remember half the title's width.		jsr	unlockicexit100		clc				; rename done.		rts		ENDP; rename icon;; IN: LEicon = handle of icon to rename;     LErename = handle of line edit record that has new name;; OUT: carry;      clear = icon is rename, set = error;.....................................................................RenameIcon	PROCNAME		IMPORT	ckNames		IMPORT	ChangePath		IMPORT	C1_PathNamePtr		IMPORT	C1_Source		IMPORT	FSTNames		IMPORT	doAlertWindow		IMPORT	GetFileInfo		IMPORT	SetLERects		IMPORT	BoxRename		IMPORT	CleanupLE		IMPORT	PathSubName		IMPORT	finderString		IMPORT	allowTellFinderCalls		IMPORT	UpdateWindow		IMPORT	ArrowCursor		import	C1_Source		import	C1_SourceBuf		import	StrCancel		import	GetBootVolume		import	matchedIconHandle		import	GetRectRgn		import	AddIconRgn		import	MatchFileToIcon		import	RedrawList		import	AddRgn		import	FreeRectRgn		IMPORT	FiFiFiSearch						lda	LEicon		sta	<icHand		lda	LEicon+2		sta	<icHand+2		jsr	lockic		jsr	getwRefCon		; windBlk = window info block		jsr	buildPath		; C1_PathName = old pathname		bcc	cont		brl	abort			; pathname errorcont		jsr	clonePath		; C1_TempPath = C1_PathName		lda	[<LErename]		; get the line edit record pointer		sta	<temp		ldy	#2		lda	[<LErename],y		sta	<temp+2		ldy	#oleLength		; get the string's length		lda	[<temp],y		bne	setLen		brl	abort			; no string, so cancel renamesetLen		sta	lastName		lda	[<temp]			; get the text handle		sta	<work		ldy	#2		lda	[<temp],y		sta	<work+2		lda	[<work]			; dereference the text handle		sta	<temp		lda	[<work],y		sta	<temp+2		ldy	#30			; move text part of name@loop		lda	[<temp],y		sta	lastName+1,y		dey		dey		bpl	@loop		ldy	#icFType		; renaming a disk?		lda	[<ic],y		sta	nameType		ldy	#icMom			;we have to be on the desktop to do dupDevice		lda	[<ic],y		cmp	<deskport		bne	change		iny		iny		lda	[<ic],y		cmp	<deskport+2		bne	change		jsr	dupDevice2		; check if the new name is taken already		bcc	change		lda	matchedIconHandle		sta	<handle		lda	matchedIconHandle+2		sta	<handle+2				lda	[<handle]		sta	<ptr4		ldy	#2		lda	[<handle],y		sta	<ptr4+2				ldy	#icFType		;if the thing we ran into is a 5.25" drive, we can't give our existing		lda	[<ptr4],y		;icon the same name under any conditions		cmp	#TypeFDrive		beq	@noRename				ldy	#icFType		; renaming a disk?		lda	[<ic],y		cmp	#TypeLastOne		bcc	change			; bra if not a device@noRename	PushLong #lastName		PushLong #lastName		jsl	PToWString		stz	C1_PathName		PushLong #lastName		PushLong #C1_PathName		jsl	PathAddName		; move lastName into pathname		ldy	#icFType		lda	[<ptr4],y		cmp	#TypeFDrive		bne	@not525				lda	#rasDup525		jsl	doAlertWindow		bra	@was525@not525		lda	#rasDupDev		jsl	doAlertwindow@was525		jsr	unlockicerror		sec				; rename not done		rts;; not a device, or a device which doesn't already exist, so judge the name and; then rename;change		ldx	#1			;is it a volume?		ldy	#icFType		lda	[<ic],y		cmp	#TypeLastOne		bge	@foundType		inx		cmp	#$0f			;is it a folder?		beq	@foundType		inx				;must be just a file if it gets here@foundType	stx	nameType				pushlong #lastName		pushlong #C1_Source		jsl	PToWString		ldx <zero				;20-Feb-92 DAL		pushlong #c1_pathname		phx		phx				;access = nil		pushlong #srqFiletype		;filetype		pushlong #srqAuxtype		;auxtype		phx		phx				;storage type = nil		phx		phx				;create date = nil		phx		phx				;mod date = nil		phx		phx				;eof = nil		phx		phx				;blocks = nil		pushlong #fstID			;file sys id		jsl	GetFileInfo		bcs	error		jsr	buildPath2		; C1_PathName = icon's new pathname		bcs	error			; pathname error		lda	fstID		asl	a		asl	a		tax		lda	>fstNames,x		sta	JudgeSubstitutions+4		lda	>fstNames+2,x		sta	JudgeSubstitutions+6		_JudgeNameGS JudgeParms		bcc	@maybeBogus@notBogus	brl	@wayBogus@maybeBogus		lda	JudgeParms+$10		beq	@notBogus				lda	>c1_source		xba		sta	>c1_source		jsl	ArrowCursor				lda	JudgeParms+$06		;move fst syntax pointer		sta	JudgeSubstitutions+12		lda	JudgeParms+$08		sta	JudgeSubstitutions+14		pha				;space for result		pea 	$0095			;by resource, Pascal substitution strings		pushlong #JudgeSubstitutions		pushlong #$07ff1701		;JudgeName alert window ID		_AlertWindow		pla		bcs 	@cancel		sec		bne	@editNewName@cancel		rts				;they clicked "No Change"--exit with SEC@editNewName			jsr	StartDraw		jsr	CleanupLE		pushlong #c1_source+2		;or, they wanted to edit the new name		lda	>c1_source+1		and	#$00ff		pha		pushZLong <LErename		_LESetText		jsr	SetLErects		; now make view/dest rect fit text;;		pea	0			;select from the beginning.;;		lda	>C1_Source+1		;to the end;;		and	#$00ff;;		pha*** changed 0..end to FF..FF, 12-Dec-91 DAL		lda	#$00FF		pha				;start = end of text		pha				;end = end of text*** end 12-Dec-91		pushZLong <LErename		_LESetSelect		pushZLong <LERename		_LEActivate		pushZlong <LErename		_LEUpdate		;;;		lda	[<LErename]		; get the line edit record pointer;;;		sta	<temp;;;		ldy	#2;;;		lda	[<LErename],y;;;		sta	<temp+2;;;		ldy	#oleViewRect+x2		; update to new view rect;;;		lda	[<temp],y;;;		sta	viewRect+x2;;;;;;		dec	viewRect+y1		Top, down one line.;;;		dec	viewRect+x1		Left side, to the left two pixels.;;;		dec	viewRect+x1;;;		inc	viewRect+x2		Right side, down two lines.;;;		inc	viewRect+x2;;;		;;;		jsr	boxRename		Draw a box around the rename field.				jsr	endDraw		sec		rts@wayBogus	stz	srqRenameOutParms+2		pea	$0109			;finderSaysBeforeRename		ldx <zero		pea	$8000			;how = send to first guy who accepts it		phx		phx				;target = nil		pushlong #srqRenameParms		pushlong #srqRenameOutParms	;dataOut		_SendRequest		bcs	@rename		lda	srqRenameOutParms+2		bne	@goAbort@rename		PushLong #C1_TempPath		; old pathname		PushLong #C1_PathName		; new pathname		jsl	ChangePath		bcc	OK		cmp	#$FFFF			; did user cancel ?		beq	@goAbort		; yes, so remove rename		brl	error@goAbort	brl	abortOK		jsr	ckNames				lda	LEicon		sta	<icHand		lda	LEicon+2		sta	<icHand+2		jsr	lockic				jsr	GetWRefCon		ldy	#icIcon			;save the offsets to our old large and small icons		lda	[<ic],y		sta	oldIcon		iny		iny		lda	[<ic],y		sta	oldIcon+2		ldy	#icSmallIcon		lda	[<ic],y		sta	oldSmallIcon		iny		iny		lda	[<ic],y		sta	oldSmallIcon+2		tsc		sec		sbc	#20			;put 5 longs on the stack		tcs		pea	$8000			;don't care about voting, match all		pea	1			;match the first one		ldy	#icFtype		lda	[<ic],y		pha		pei <zero		ldy	#icAuxtype		lda	[<ic],y		pha				lda	<ic			;ptr to our NEW name		clc		adc	#icName		tax		lda	<ic+2		adc <zero		pha		phx				lda	<ic			;ptr to the same old create date		clc		adc	#icCDate		tax		lda	<ic+2		adc <zero		pha		phx		lda	<ic			;ptr to the same old mod date		clc		adc	#icCDate		tax		lda	<ic+2		adc <zero		pha		phx		ldy	#icLocalAccess		lda	[<ic],y		pha		ldy	#icForked		lda	[<ic],y		pha				lda	<ic			;ptr to the same old option list		clc		adc	#icOptionList		tax		lda	<ic+2		adc <zero		pha		phx				ldy	#icFBytes+2		lda	[<ic],y		pha		dey		dey		lda	[<ic],y		pha		jsl	matchFileToIcon		pla		ldy	#icOneDocOffset		sta	[<ic],y		iny		iny		pla		sta	[<ic],y		pla		ldy	#icRBundle		sta	[<ic],y		iny		iny		pla		sta	[<ic],y		pulllong NewSmallIcon		pulllong NewIcon				pla		pla				;rFinderPath goes into hyperspace...;; find out if the NumResults field of this particular OneDoc includes a kind string;		ldy	#icAuxtype		;put the auxtype in (X)		lda	[<ic],y		tax				ldy	#icFtype		;put the filetype in (A)		lda	[<ic],y				ldy <zero			;high word of auxtype is always zero		jsl	FiFiFiSearch		ldy	#icKind		sta	[<ic],y		iny		iny		txa		sta	[<ic],y		pushZLong <handle		pushZLong <ptr		ldy	#icRBundle+1		lda	[<ic],y			;if there's no bundle, accept whatever FiFiFi gave us		beq	@noKind				dey		lda	[<ic],y		sta	<handle		iny		iny		lda	[<ic],y		sta	<handle+2				lda	[<handle]		clc		ldy	#icOneDocOffset		adc	[<ic],y		sta	<ptr		ldy	#2		lda	[<handle],y		ldy	#icOneDocOffset+2		adc	[<ic],y		sta	<ptr+2				ldy	#4			;check numresults		lda	[<ptr],y		cmp	#5		blt	@noKind				ldy	#icKind		lda <zero		sta	[<ic],y		iny		iny		sta	[<ic],y		@noKind		pulllong <ptr		pulllong <handle;; Logic down here goes like this: first, is this the 'Name' view. If so, the view needs to be resorted, and;  the possibly new icon values are stuffed in their new fields and everything is redrawn, all nice like.;		ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		bne	notByName				jsr	StuffIconFields		jsr	UpdateWindow				bra	abort;; We're not being viewed by name, so first check and see if the large icon has changed, and if it has,;  stuff the new icon values into the icon itself and redraw the large icon only if were being viewed by;  icon (why redraw what the user can't see?).;notByName	lda	newIcon		cmp	oldIcon		bne	@redrawLarge		lda	newIcon+2		cmp	oldIcon+2		beq	@lookSmall		@redrawlarge	jsr	GetRectRgn		jsr	AddIconRgn		jsr	StuffIconFields				ldy	#windView		lda	[<windBlk],y		cmp	#viewByIcon		bne	@lookSmall				jsr	AddIconRgn		jsr	RedrawList		bra	abort		;; We're not being viewed by name, so first check and see if the small icon has changed, and if it has,;  stuff the new icon values into the icon itself and redraw the small icon only if it's not being viewed by;  icon (why redraw what the user can't see?).  If the icons (by now, both small and large) didn't change,;  then don't redraw squat.;@lookSmall	lda	newSmallIcon		cmp	oldSmallIcon		bne	@redrawSmall		lda	newSmallIcon+2		cmp	oldSmallIcon+2		beq	abort@redrawSmall	jsr	GetRectRgn		jsr	AddIconRgn		jsr	StuffIconFields		ldy	#windView		;check the window's view, if it's by icon or by name, don't redraw		lda	[<windBlk],y		;the window at all (our small icon changed, so redrawing the large icon		cmp	#viewByIcon		;is stupid -- and in the case of by name, we'll redraw the entire window		beq	@abortDraw		;anyway, so why bother here?)		ldy	#windView		;see if the window is being viewed by small icon... if it's not, then		lda	[<windBlk],y		;we are left with one of the other list views, and the kind string might have		cmp	#viewBySmallIcon	;(ugh) changed, so we'll extend the region which needs to be redrawn way to the		beq	@noRedrawType		;right		lda	#dxViewDate		sta	<irect1+x2				lda	#irect1		jsr	addRgn		@noRedrawType	jsr	addIconRgn		jsr	RedrawList		bra	abort		@abortDraw	jsr	FreeRectRgnabort		jsl	GetBootVolume		clc				; rename was done (or abort)exit		rts;; StuffIconFields -- put NewIcon and NewSmallIcon into the actual icon since they're different from; 		     what's already there...;StuffIconFields				ldy	#icIcon		lda	NewIcon		sta	[<ic],y		iny		iny		lda	NewIcon+2		sta	[<ic],y		ldy	#icSmallIcon		lda	NewSmallIcon		sta	[<ic],y		iny		iny		lda	NewSmallIcon+2		sta	[<ic],y		rts;; locals;srqRenameParms	dc.w	4			;parameter count=4		dc.L	C1_TempPath		dc.L	C1_PathnamesrqFiletype	dc.w	0srqAuxtype	dc.L	0srqRenameOutParms dc.w	0		dc.w	0JudgeSubstitutions		dc.L	LastName		;trial name	*0		dc.L	0			;fst name	*1		dc.L	C1_Source+1		;sub name	*2		dc.L	0			;fst syntax	*3		dc.L	strCancel		;"cancel"	*4JudgeParms	dc.w	6fstID		dc.w	0			;fileSysIDnameType	dc.w	0			;nameType		dc.L	0			;syntax		dc.w	0		dc.L	C1_SourceBuf		;keep this big so it has a lot of workspace (DAL)		dc.w	0		newIcon		dc.L	0newSmallIcon	dc.L	0oldIcon		dc.L	0oldSmallIcon	dc.L	0		ENDP; change all pathnames affected by rename;; IN: C1_Pathname = new pathname;     C1_TempPath = old pathname;     lastName = new filename;; USES: C1_Path to hold the difference between the new and old pathnames;.....................................................................ckNames		PROCNAME	EXPORT		IMPORT	ClonePath		IMPORT	UpdateInfos		IMPORT	GetDeviceName		IMPORT	GetVolumeInfo		IMPORT	IsFSTUpperCase		IMPORT	PStrToUpper		IMPORT	FileSysID		IMPORT	removeMenuInfoItem		IMPORT	addIWindow2Menu		IMPORT	wind_ref		IMPORT	insertItemRef		IMPORT	PStringCopy		IMPORT	PToWString		IMPORT	c1_path		IMPORT	JustRootName		;		PushLong #C1_DeviceName		; pointer to device name;		PushLong #C1_PathName		; pointer to pathname;		jsl	GetDeviceName;;		PushLong #C1_DeviceName		; pointer to device name;		PushLong #0			; skip volume name;		PushLong #0			; skip total blocks;		PushLong #0			; skip free blocks;		PushLong #FileSysID		; ptr to file system ID;		PushLong #0			; skip block size;		jsl	GetVolumeInfo;;		pha				; space for result;		PushWord FileSysID;		jsl	IsFSTUpperCase;		pla;		beq	nameIt;		;		PushLong #lastName;		jsl	PStrToUpper;		jsr	nameIcon		First, give the	icon the new name.		EXPORT	ckNames2ckNames2	lda <zero		sep	#$20		LONGA OFF				ldy <zero@fLoop		lda	c1_pathname+2,y		cmp	c1_temppath+2,y		bne	@found		iny		cpy	c1_pathname		blt	@fLoop			rep	#$20		LONGA ON				lda	c1_pathname		cmp	c1_temppath		bne	@NotSame				lda	lastName		and	#$00FF		pha				lda	c1_pathname		sec		sbc	1,s		tay			pla		@notSame	sep	#$20		LONGA OFF		@found		sty	diffStart		ldx <zero*** added 9-Jul-92 DAL -- What a pain!  Not having this line was screwing things up***                       big-time if you renamed something to a shorter name that***                       started out the same (like a disk with an open window).		bra @enterLoop*** end 9-Jul-92@cLoop		lda	c1_pathname+2,y		sta	>c1_path+2,x		inx		iny@enterLoop	cpy	c1_pathname		blt	@cLoop			rep	#$20		LONGA ON		txa		sta	>c1_path		lda	c1_temppath		;the total length of the old pathname minus		sec				;the start of the difference between the new and old paths		sbc	diffStart		;yields the length of the splice which we'll have to make		sta	spliceLength				ldy	#icFType		Only need to check disks and folders.		lda	[<ic],y		bmi	fixem			bra if device or trash		cmp	#TypeFolder			beq	fixem			bra if folder		jsr	UpdateInfoFileNames		brl	exit; ------ Rename	window that came from icon ------------------------- fixem		ldy	#icWind			Get pointer to icon's open window.		lda	[<ic],y		sta	<wind		iny		lda	[<ic],y		sta	<wind+1		bne	ok110		brl	skip110			Is the icon open?		ok110		;; not only rename the window, but also rename the window's info block so that the title; in the windows menu is correct (augh);				pushZLong <wind				pha		pha		pushZlong <wind		_GetWRefCon		pulllong infoBlockPtr 				lda	infoBlockPtr		tax		lda	infoBlockPtr+2		tay				jsl	removeMenuInfoItem		pushlong #lastName		;from				lda	infoBlockPtr		sta	wind_ref				clc		adc	#windMenuText		sta	insertItemRef+10		tax		lda	infoBlockPtr+2		sta	wind_ref+2		adc <zero		sta	insertItemRef+12		pha		phx				;to		jsl	PStringCopy		jsl	addIWindow2Menu		;add the trash to the windows menu		pulllong <wind;; now, rename our actual title that has the padding on the ends;		pha				Space for result.		pha		pei	<wind+2			Pass pointer to	window.		pei	<wind		_GetWTitle		pla		sta	<work			Pass title pointer to padName.		pla		sta	<work+2				lda	#lastName		Pass pointer to	title.		sta	<temp		lda	#lastName>>16		sta	<temp+2		jsr	padName			Put spaces on ends of name.		pei	<work+2			Pass pointer to	new name.		pei	<work		pei	<wind+2			Pass pointer to	window.		pei	<wind		_SetWTitle; ------ Check all windows to update pathname in info block ---------------- skip110		jsr	UpdateInfoFileNames	;18-Mar-93 JCM		jsr	temp2path		C1_PathName = C1_TempPath (old pathname).;------------------------------------------------;; Changed by SEG on 20 Jul 87 to work if top; window is not	a dir window.  GetFrontWindow; only returns the top window. It does not; return topmost with correct id.;;------------------------------------------------		lda	#DirWindID		Directory windows only.		jsr	getFrontWind		Start with front most window.		bne	lop110			Top is dir window!		bcs	done110			No windows at all		jsr	getNextWind		Top is not, try	others		beq	done110			No windows!lop110		pei	<wind+2			Save this window pointer.		pei	<wind		jsr	ckRoots			Check if window	came from icon.		pla		sta	<wind		sta	<TaskData		pla		sta	<wind+2		sta	<TaskData+2		php				Save 'window from icon'	flag.		jsr	getNextWind		'A' will equal window's ID.		plp				Restore	'window from icon' flag.		bcc	next110		pha				Save window's ID.		pei	<wind+2			Save pointer to	next window.		pei	<wind		pei	<icHand+2		Save icon's handle.		pei	<icHand		lda	<TaskData		Get window's info block.		ldx	<TaskData+2		jsr	getwRefCon2		lda	<windBlk		Compute	pointer	to windPath field.		clc		adc	#windPath		sta	<windBlk		bcc	ok112		inc	<windBlk+2ok112		pei	<zero			;flag = not resizing an iconObj		jsr	SpliceName		bcc	ok113			Splice OK?		jsr	saveTemp		Save C1_TempPath.		jsr	doClose			Pathname too long, close the window.		jsr	restoreTemp		Restore	C1_TempPath.ok113		pla				Restore	handle of icon I'm checking.		sta	<icHand		pla		sta	<icHand+2		pla				Restore	pointer	to next	window.		sta	<wind		pla		sta	<wind+2		jsr	temp2path		C1_PathName = C1_TempPath (old name).		pla				Get next window's ID.next110		tax				Any more windows?		bne	lop110done110; ------ Check all extended icons ------------------------------------------;;  C1_PathName = old name.;;-----------------------------------------------		pei	<icHand+2		Save icon being	renamed.		pei	<icHand		lda	#MaxPathLen		Set maximum pathname length allowed.		sta	maxLength		lda	#nameExt		Call 'nameExt' for every extended icon		jsr	walkExt2		that came from renamed icon.		pla		sta	<icHand		pla		sta	<icHand+2		jsr	lockicexit		clc		rts*** Added - 18-Mar-93 JCM - So we can call this when a file is renamed. Before this would only be***			    called for devices and folders.UpdateInfoFileNames		lda	#MaxPathLen		Set maximum pathname length allowed.		sta	maxLength		jsr	saveTemp		Save C1_TempPath.		jsr	JustRootName		jsr	ClonePath				jsr	UpdateInfos		jsr	restoreTemp		Restore	C1_TempPath.		rts*** End - 18-Mar-93 JCMinfoBlockPtr	dc.L	0; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;	   Check for new pathname in extended icons. ; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =;;   IN:	   ic =	extended icon that came	from icon being	renamed.;;  OUT:	   C1_PathName = not changed (can't be changed because walkExt needs it).;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = = =nameExt		ldx	<ic+2			Compute	pointer	to icOwner field.		lda	<ic		clc		adc	#icOwner		bcc	store250		inxstore250	sta	<windBlk		Pass pointer of	name to	splice.		stx	<windBlk+2		pea	1			;flag = we're resizing an iconObj		jsr	SpliceName		Check to change	pathname.		bcc	exit250		jsr	dumpExtIcon		Remove icon because pathname is	too long.exit250		clc		rts*===============================================**	   Splice new name into	pathname. **   IN:	   windBlk = pointer to	pathname to be spliced*	   C1_TempPath = old pathname*          C1_Pathname = new pathname*	   lastName = new last segment of name (not used)*          c1_path = piece of new pathname after the splice(?)**          On stack:  Word = nonzero if we're splicing an iconObj (SuperKludge!)**  OUT:	   Carry set if	spliced	name would be greater than MaxPathLen*	   windBlk = pointer to	spliced	pathname*	   work+1 = trash* *	   If the first	part of	(windBlk) equals (C1_TempPath) then replace*	   the name in (windBlk) that is in the	same position as the last*	   name	in (C1_TempPath) with the name in lastName.* *===============================================*SpliceName	NAME		IMPORT	c1_path		lda	>c1_path		sta	LLastName		lda	c1_temppath		sec		sbc	spliceLength		tay		iny		sty	startSplice		Rememeber where	to start splice.		lda	C1_TempPath		inc	a		sec		sbc	startSplice		cmp	LLastName		;Is new name larger or smaller?		bcc	bigger;; New name is smaller, move new name over old name;		sep	#$20		LONGA	OFF		ldx <zero*** added 8-Jul-92 DAL -- Iterate zero times if necessary (to get length right below)		bra @enterLoop*** end 8-Jul-92@loop2		inx		iny		lda	>c1_path+1,x		sta	[<windBlk],y@enterLoop	cpx	LLastName		;New name moved in?		bne	@loop2;; ------ Pull end of pathname in --------------------------;		rep	#$20		LONGA on		lda	C1_TempPath		cmp	[<windBlk]		beq	@drawnIn		tax		inx		@loop3		sep	#$20		LONGA off		inx		iny		phy		txy		lda	[<windBlk],y		ply		sta	[<windBlk],y		rep	#$20		LONGA on		txa		cmp	[<windBlk]		blt	@loop3		beq	@loop3@drawnIn	dey		tya				;Set new length		sta	[<windBlk]		brl	okExit;; --- New name is larger or same size -----------------------------------;		LONGA	ON		bigger		pha		lda	LLastName		;New name,		sec		sbc	1,s			;less length of old name,		sta	1,s			;equals the number of characters added.		lda	[<windBlk]		Make sure string won't be too long.		tay				y = old	length.		clc		adc	1,s		plx		tax				x = new	length.		cmp	maxLength		bcc 	@good1		brl	badExit@good1		lda	[<windBlk]		Compute	number of characters to	move.		sec		sbc	C1_TempPath		sta	startSplice		txa		sta	[<windBlk]		Set new	length.; X and Y are important!*** This is where we really want to resize the icon object		lda 3,s			;check kludge flag--nonzero = resizing iconObj		beq @notIconObj		phx		phy			;save X and Y		txa			;get new length back		clc		adc #2		adc #icOwner		pei <zero		;high word of new iconObj size		pha			;low word of new iconObj size; just leave the new size on there for SetHandleSize; unlock icHand		ldy #4		lda [<icHand],y		asl a		lsr a				;clear bit 15 (unlocks handle)		sta [<icHand],y		pei <icHand+2			;new size already on stack		pei <icHand		_SetHandleSize		php				;save error status		ldy #4		lda [<icHand],y		ora #$8000		sta [<icHand],y		ldy #2				;dereference it again		lda [<icHand],y		sta <ic+2		lda [<icHand]		sta <ic		plp		bcs badExit			;if we got an error growing it, kill it		ldx	<ic+2			Compute	pointer	to icOwner field.		lda	<ic		clc		adc	#icOwner		bcc	@store250		inx@store250	sta	<windBlk		Pass pointer of	name to	splice.		stx	<windBlk+2		ply				;restore X and Y!		plx*** End of resizing an iconObj handle@notIconObj;; ------ Move end of pathname out to make room -----------------------;				lda	startSplice		sep	#$20		LONGA	OFF		beq	enter900		If no change in	length,	add new	name.		iny		inx		@bLoop		lda	[<windBlk],y		phy		txy		sta	[<windBlk],y		ply		dey		dex		rep	#$20		LONGA on		dec	startSplice		sep	#$20		LONGA off		bne	@bLoop		dex; ------ Add new name over old name --------------------------------enter900	txy		iny		ldx	LLastName@loop		lda	>c1_path+1,x		sta	[<windBlk],y		dey		dex		bne	@loopokExit		clc				Return OK flag.badExit		rep	#$30		LONGA ON		LONGI ON; Exiting SpliceName: remove input flag word from stack		plx		;grab RTS		ply		;kill input		phx		;put RTS back		rts;; locals;diffStart	dc.w	0spliceLength	dc.w	0startSplice	dc.w	0LLastName	dc.w	0			;lastname's length as a word		ENDP*===============================================**    Set the LE rects to match the text length	**						** IN:	<LErename has handle to LE record	** OUT:	the LE record has new view/dest rect	**===============================================*SetLErects	PROC		pei	<work+2			;fix BRC #68318, view by would screw up because <work was getting trashed		pei	<work			;11/9/90 -- andy			lda	[<LErename]		; get the line edit record pointer		sta	<temp		ldy	#2		lda	[<LErename],y		sta	<temp+2		ldy	#oleLineHandle		; get the text handle		lda	[<temp],y		sta	<work		iny		iny		lda	[<temp],y		sta	<work+2		pha				; space for width		ldy	#2		lda	[<work],y		; dereference the text handle		pha				; pass text pointer		lda	[<work]		pha		ldy	#oleLength		; get the text length		lda	[<temp],y		pha				; pass text length		_TextWidth			; width left on stack				ldy	#oleJust		; get the justification style		lda	[<temp],y		cmp	#leJustCenter		; is it centered ?		beq	bigsmallIconLE	pla				; get text width		ldy	#oleViewRect+x1		clc		adc	[<temp],y		; add it to start		inc	a		inc	a		bra	common		big		pla				; get text width		inc	a			; align to even pixels		lsr	a			; get half		pha				; save it		lda	LE_Center		sec		sbc	1,s			; subtract it from center		ldy	#oleDestRect+x1		sta	[<temp],y		; our new dest rect start		dec	a		dec	a		ldy	#oleViewRect+x1		sta	[<temp],y		; our new view rect start		lda	LE_Center		clc		adc	1,s			; add it to center		plx				; remove itcommon		ldy	#oleDestRect+x2		sta	[<temp],y		; our new dest rect end		inc	a		inc	a		ldy	#oleViewRect+x2		sta	[<temp],y		; our new view rect end		pla				;end fix BRC #68318 -- 11/9/90 -- andy		sta	<work		pla		sta	<work+2		rts		ENDP		*===============================================**    Grow the LE rects to fit a new character	**						** IN:	<LErename has handle to LE record	** OUT:	the LE record has new view/dest rect	**===============================================*GrowLErects	PROC		lda	[<LErename]		; get the line edit record pointer		sta	<temp		ldy	#2		lda	[<LErename],y		sta	<temp+2		ldy	#oleJust		; get the justification style		lda	[<temp],y		cmp	#leJustCenter		; is it centered (ie a big icon)?		beq	bigsmall		ldy	#oleDestRect+x2		lda	[<temp],y		clc		adc	#maxCharWidth		; room to grow		sta	[<temp],y		; our new dest rect end		bra	common		big		ldy	#oleDestRect+x1		lda	[<temp],y		sec		sbc	#maxCharWidth/2		; room to grow		sta	[<temp],y		; our new dest rect start		dec	a		dec	a		ldy	#oleViewRect+x1		sta	[<temp],y		; our new view rect start		ldy	#oleDestRect+x2		lda	[<temp],y		clc		adc	#maxCharWidth/2		; room to growcommon		sta	[<temp],y		; our new dest rect end		inc	a		inc	a		ldy	#oleViewRect+x2		sta	[<temp],y		; our new view rect end		rts		ENDP*===============================================** Clean up bashed areas from shrinking LE field **						**===============================================*CleanUpLE	PROC		stz	Bashed			; use as a flag (see below)		lda	[<LErename]		; get the line edit record pointer		sta	<temp		ldy	#2		lda	[<LErename],y		sta	<temp+2		lda	viewRect+x1		; if old.x1 < new.x1 then redraw		ldy	#oleViewRect+x1		cmp	[<temp],y		bcs	leftSide		sec				; give some slop			sbc	#6		sta	desRect+x1		; set bashed rect #1		lda	[<temp],y		clc				; give some slop		adc	#6		sta	desRect+x2		lda	#1			; remember that rect #1 is bad		tsb	BashedleftSide	lda	viewRect+x2		; if old.x2 > new.x2 then redraw		ldy	#oleViewRect+x2		cmp	[<temp],y		bcc	cont		clc				; give some slop		adc	#6		sta	viewRect+x2		; set bashed rect #2		lda	[<temp],y		sec				; give some slop			sbc	#6		sta	viewRect+x1		lda	#2		tsb	Bashed			; remember that rect #2 is badcont		lda	Bashed			; are there bashed rects ?		beq	done		lda	viewRect+y1		; get bashed rects vert coordinates		sta	desRect+y1		lda	viewRect+y2		sta	desRect+y2				jsr	ifDesk		bne	window		jsr	getRectRgn		; allocate regions for clobbered area		ldx	#x2			; move rect #1 into irect2@loop1		lda	desRect,x		sta	<irect2,x		dex		dex		bpl	@loop1		jsr	addirect2		; add irect2 to clobbered region		inc	viewRect+x2		inc	viewRect+x2				lda	viewRect+x1		; move rect #2 into irect2		sta	<irect2+x1		lda	viewRect+x2		sta	<irect2+x2		jsr	addirect2		; add irect2 to clobbered region		jsr	redrawList		; force redraw of erased hole		bra	done		window		lda	Bashed		and	#1		beq	inval2		PushLong #desRect		_InvalRect			; force a redraw of bashed rect #1inval2		lda	Bashed		and	#2		beq	done		PushLong #viewRect		_InvalRect			; force a redraw of bashed rect #2done		lda	[<LErename]		; get the line edit record pointer		sta	<temp		ldy	#2		lda	[<LErename],y		sta	<temp+2		ldy	#oleViewRect+x1		; update to new view rect		lda	[<temp],y		sta	viewRect+x1		ldy	#oleViewRect+x2		lda	[<temp],y		sta	viewRect+x2		rtsBashed		DC.W	0			; bit flag		ENDP;========================================================;	   Make	line edit field	for icon's name.;========================================================;;   IN:	   ic =	icon to	rename.; ;  OUT:	   Carry clear if line edit field made.;;========================================================makeField	PROC	EXPORT; --- Check if icon can	be renamed ---------------------------------------		ldy	#icFType		; check if we can rename this device		lda	[<ic],y		cmp	#TypeFTrash		bcs	goodbye			; bra if trash can		cmp	#TypeFDrive		beq	goodbye			; bra if 5.25 drive		cmp	#TypeServer		beq	goodbye			; bra if server volume		ldy	#icFlag			; extended icons can't be renamed;		lda	[<ic],y;		and	#ICEXTENDED;		bne	goodbye		lda	[<ic],y			; is it locked or offline?		and	#ICLOCKED+ICOFFLINE		beq	ok2			; no, so ok to rename it		goodbye		sec				; field not created flag (carry)		rts;--- Setup RECT for small icon	----------------ok2		jsr	getIconRect		; irect2 = icon's title RECT.		lda	<irect2+y1		; top and bottom need a little adjustment		dec	a		sta	desRect+y1		lda	<irect2+y2		inc	a		sta	desRect+y2		sta	viewRect+y2		lda	<irect2+x1		clc		adc	#6		sta	viewRect+x1		inc	a		inc	a		sta	desRect+x1;--- Setup RECT for large icon -----------------		ldy	#windView		; if view by small, then ready		lda	[<windBlk],y		bne	common		lda	<irect2+y1		; top and bottom need a little adjustment		inc	a		sta	desRect+y1		lda	<irect2+y2		inc	a		sta	desRect+y2		sta	viewRect+y2		ldy	#icx		lda	[<ic],y		sta	LE_Center		; remember center of field		ldy	#icTitleLen		sec		sbc	[<ic],y			; subtract half of text width		sta	desRect+x1		; our dest rect's start;		dec	a;		dec	a		sta	viewRect+x1		; our view rect's startcommon		lda	desRect+y1		inc	a		sta	viewRect+y1;--- make rects real small so LE won't draw the text (it's already drawn)		lda	viewRect+x1		sta	viewRect+x2		; our view rect's end		lda	desRect+x1		sta	desRect+x2		; our dest rect's end;--- Start DJB fix for BRC #49646 --------------		ldy	#windView		; if not small icon then skip		lda	[<windBlk],y		beq	@normal		lda	<irect2+x2		sec		sbc	<irect2+x1		cmp	#dxViewSize-62		; did we clip the text ??		bcc	@normal			; nope		lda	<irect2+x2		; yes, so make some real rects		sta	viewRect+x2		; to force LE to draw the text		dec	a		dec	a		sta	desRect+x2@normal;--- end DJB fix -------------------------------;--- Create line edit record -------------------		lda	<curWind		; save current state.		sta	LEwind		lda	<curWind+2		sta	LEwind+2		lda	<icHand		sta	LEicon		lda	<icHand+2		sta	LEicon+2		jsr	startDraw		jsr	normalColor		pha				; space for handle		pha		PushLong #desRect		; destination RECT ptr		PushLong #viewRect		; view RECT ptr		PushWord LE_MaxLen		; maximum length		_LENew		PullLong <LErename		ldy	#windView		; if view by small, then ready		lda	[<windBlk],y		bne	ok3		PushWord #leJustCenter		; center justify line edit field		PushZLong <LErename		_LESetJustok3		jsr	getIcNamePtr		; get pointer to icon's name field		inc	a			; skip length byte		bne	store1		inxstore1		phx				; pass pointer to text part of name		pha		lda	[<temp]			; pass length of text		and	#$00FF		pha		sta	<temp			; (Save for next call.)		PushZLong <LErename		; pass handle of line edit record		_LESetText		pei <zero			; select from the beginning.		PushZWord <temp			; to the end (temp = saved max length)		PushZLong <LErename		_LESetSelect		PushZLong <LErename		_LEActivate		PushZLong <LErename		_LEUpdate		jsr	SetLErects		; now make view/dest rect fit text				lda	[<LErename]		; get the line edit record pointer		sta	<temp		ldy	#2		lda	[<LErename],y		sta	<temp+2		ldy	#oleViewRect+x2		; update to new view rect		lda	[<temp],y		sta	viewRect+x2; --- Compute RECT for outlining name ------------------------------;;;		dec	viewRect+y1		Top, down one line.;;;		dec	viewRect+x1		Left side, to the left two pixels.;;;		dec	viewRect+x1;;;		inc	viewRect+x2		Right side, down two lines.;;;		inc	viewRect+x2;;;		jsr	boxRename		Draw a box around the rename field.		jsr	endDraw		stz	LEdirty			; no changes made yet		clc				; line edit field created		rts*==============================================		EXPORT	boxRenameboxRename        ;;;		pea	2;;;		pea	1;;;		_SetPenSize;;;;;;		pea	-1;;;		_SetSolidPenPat;;;		;;;		pea	viewRect>>16;;;		pea	viewRect;;;		pea	-2;;;		pea	0;;;		_InsetRect;;;		;;;		pea	viewRect>>16;;;		pea	viewRect;;;		_FrameRect;;;;;;		pea	viewRect>>16;;;		pea	viewRect;;;		pea	0;;;		pea	-1;;;		_InsetRect;;;		;;;		pea	0;;;		_SetSolidPenPat;;;;;;		pea	viewRect>>16;;;		pea	viewRect;;;		_FrameRect;;;		rts		ENDP; longNoRename -- call no rename from just about anywhere;.....................................................................longNoRename	proc EXPORT		phb		phk		plb				jsr	noRename				plb		rtl		endp		*===============================================**	    Remove a Line Edit Field		**						** The icon's title is left on the screen and is ** highlighted acording to the icon's state (ie  ** if the icon is selected then the text will be ** inverted).					**						** IN:	LErename				**	LEwind					**	LEicon					**	LEdirty					**						** OUT:						**	carry sec if no LE field		**===============================================*NoRename        PROCNAME EXPORT		IMPORT	InsertPtr		IMPORT	getwRefCon		IMPORT	pushirect2		lda	<LErename+1		; is there a line edit field?		bne	valid		brl	exit			; novalid		PushZLong <curWind		; save current state		PushZLong <icHand		lda	LEwind			; set to line edit plane and icon		sta	<curWind		lda	LEwind+2		sta	<curWind+2		jsr	getwRefCon		lda	LEicon		sta	<icHand		lda	LEicon+2		sta	<icHand+2		jsr	lockic				stz	LEicon			; mark as gone		stz	LEwind+2;--- Start of DJB fix for BRC# 49646 -----------;		;		ldy	#windView		; is it a small icon ?;		lda	[<windBlk],y;		beq	@normal			; no;		;		lda	viewRect+x2		; was original text clipped?;		sec;		sbc	viewRect+x1;		cmp	#dxViewSize-62;		bcc	@normal			; no, so do a normal redraw;		;		jsr	getIconRect		; irect2 = icon's title RECT;;		jsr	startDraw		; force a redraw;		jsr	pushirect2;		_EraseRect;		jsr	pushirect2;		_InvalRect;		jsr	endDraw;;		brl	done;@normal;--- End of DJB fix ----------------------------;;--- Start of rdl fix for BRC# 53121 / WS# MSF348SMW, of DJB fix for BRC# 49646 -----------; The above djb fix was testing the size of the CURRENT text, not the original; and it was erasing only the original text size, not the larger of original or current.; So if you had made a short filename very long or a long filename even longer, the; extension would be left on the screen as an artifact after mousing out or hitting Escape.;; But Ron, the only thing which needs to get nuked is the stuff which protrudes outside of; the area that the list view clips to, NOT the entire thing.  We also don't even need to; do this AT ALL when using small icon view. andy, 2/8/92.  40 hours before 6.0 GM?;		ldy	#windView		; is it an icon and not a list view?		lda	[<windBlk],y		cmp	#viewByName		blt	atNormal				jsr	getIconRect		; irect2 = icon's title RECT		lda	<irect2+x2		; was original text clipped?		sec		sbc	<irect2+x1		cmp	#dxViewSize-62		bcc	atNormal		; no, so do a normal redraw				jsr	startDraw		; force a redraw of larger of view or initial rect		lda	<irect2+x2		; which is larger, then or now? (erase the larger)		cmp	viewRect+x2		bcs	@eraseIRect		; bra if irect is greater or equal to erase it			ldx	#6			;if viewRect is larger, copy it to irect2 since this is a	@loop		lda	viewRect,x		;(we hope, 1 day before GM? Ack.) localized patch (Hi Dave! :)		sta	<irect2,x		dex		dex		bpl	@loop@eraseIRect	lda	<irect2+x1		clc		adc	#dxViewSize-68		sta	<irect2+x1		jsr	pushirect2		;only erase the part that protrudes!		_EraseRect		jsr	pushirect2		_InvalRect			jsr	endDraw		brl	doneatNormal;--- End of rdl fix for BRC# 53121 / WS# MSF348SMW, of DJB fix ----------------------------;--- End of AEN fix of RDL fix or DJB fix -------------------------------------------------		lda	LEdirty			; was field even touched ?		bne	redraw			; yes		brl	done			; no;--- Set LE's text back to icon's text ---------redraw		jsr	startDraw		jsr	getIcNamePtr		; get pointer to icon's name field		inc	a			; skip length byte		bne	store1		inxstore1		phx				; pass pointer to text part of name		pha		lda	[<temp]			; pass length of text		and	#$00FF		pha		PushZLong <LErename		; pass handle of line edit record		_LESetText		jsr	SetLErects		; now make view/dest rect fit text;--- Make sure text is properly highlighted ----		ldy	#icFlag		lda	[<ic],y		and	#ICSELECTED		bne	selected		; icon is selected so draw it inverted		PushZLong <LErename		; unhighlight selection/remove the caret		_LEDeactivate		PushZLong <LErename		_LEUpdate		bra	eraseField		selected	pei <zero			; select (highlight) the entire text		PushWord LE_MaxLen		PushZLong <LErename		_LESetSelect		PushZLong <LErename		_LEActivate		PushZLong <LErename		_LEUpdate;--- Erase any "bashed" areas ----------------------------------------;;								      ;;	|---- icon's rect ----|           |-- icon's rect --|	      ; (orig: returning to this);				  or				      ;;	   |-- view rect --|	       |------ view rect ------|      ; (undoing this);								      ;;  (ok since new text is bigger)    (bad since new text is smaller)   ; (new text is orig. text);---------------------------------------------------------------------;eraseField	jsr	getIconRect		; irect2 = icon's title RECT		lda	viewRect+x1		; is view rect smaller (on left side)?		cmp	<irect2+x1		bcc	cont			; bra if no, to redraw bashed areas		lda	viewRect+x2		; is view rect smaller (on right side)?		cmp	<irect2+x2		bcs	cont			; bra if no, to redraw bashed areas		brl	stop			; view rect smaller, nothing to docont		lda	<irect2+x2		; desRect <-- "right bashed area of view rect"		sta	desRect+x1		lda	viewRect+x2		sta	desRect+x2				lda	viewRect+y1		sta	desRect+y1		lda	viewRect+y2		sta	desRect+y2		lda	<irect2+x1		; viewRect <-- "left bashed area of view rect"		sta	viewRect+x2; rdl 5/17/90 fix: bug is that renaming a large icon at the left edge of the window ; so that the new filename extends off the left edge of the screen and into negative x coords ; would be left on the screen after hitting escape or mousing out of the filename.  ; So I commented out the first three lines of the following, which do not handle ; the possibility of negative coords.  (viewRect’s coords are the rect on the left half ; of the icon that are being undone because the original name was smaller so the left part ; of the new name has to be erased.)  ; If there is a valid possibility of an x2 that’s smaller than an x1, there could be implications!;		lda	viewRect+x1;		cmp	viewRect+x2;		bcs	skip1; end of rdl 5/17/90 fix (see also below) (skip1 probably no longer in use)		PushLong #viewRect		_EraseRect			; erase from desktopskip1		PushLong #desRect		_EraseRect		jsr	ifDesk			; is it desktop or window icon list?		bne	window		jsr	getRectRgn		; allocate regions for clobbered area		lda	viewRect+y1		; move viewRect into irect2		sta	<irect2+y1		lda	viewRect+x1		sta	<irect2+x1		lda	viewRect+y2		sta	<irect2+y2		lda	viewRect+x2		inc	a		inc	a		sta	<irect2+x2		jsr	addirect2		; add irect2 to clobbered region		lda	desRect+y1		; move desRect into irect2		sta	<irect2+y1				lda	desRect+x1		sta	<irect2+x1		lda	desRect+y2		sta	<irect2+y2		lda	desRect+x2		inc	a		inc	a		sta	<irect2+x2		jsr	addirect2		; add irect2 to clobbered region		jsr	redrawList		; redraw erased holes		bra	stopwindow; rdl 5/17/90 fix (see also above) ;		lda	viewRect+x1;		cmp	viewRect+x2;		bcs	skip2; end of rdl 5/17/90 fix (skip2 probably no longer in use)		PushLong #viewRect		; force a redraw of bashed areas		_InvalRectskip2		PushLong #desRect		_InvalRectstop		jsr	endDraw;--- Free line edit record ---------------------done		jsr	unlockic		PushZLong <LErename		; done with the old line edit field		_LEDispose		stz	<LErename		; mark as no line edit field		stz	<LErename+2;--- Remove the Insert Cursor (if any) ---------		pha				; space for address		pha		_GetCursorAdr			; get current cursor address		pla		plx				cmp	>InsertPtr		; is it an Insert Bar ?		bne	restore		txa		cmp	>InsertPtr+2		bne	restore		jsl	ArrowCursor		; force an arrow cursor;---  restore original state -------------------restore		PullLong <icHand		; restore variables		PullLong <curWind		jsr	lockic			; ic = (icHand)		jsr	getwRefCon		; windBlk = curWind info blockexit		sec				; no line edit field flag		rts		ENDP; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;	   Handle hit in line edit field.; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =;;  IN:	   LErename = valid line edit handle.;	   Task	record = button	down, hit event.;; = = =	= = = =	= = = =	= = = =	= = = =	= = = =	= = =hitIconName	PROC	EXPORT		jsr	startDraw		jsr	pushyrat		_LocalToGlobal		jsr	pushTask		; pass pointer to Task record		pei	<LErename+2		pei	<LErename		_LEClick			; track user's movements		inc	LEdirty			; changes were made				brl	endDraw		ENDP;============================================;	   Get current pattern or picture;============================================;;  OUT:	   a = zero if pattern hasn't changed.;	       one if there isn't a pattern message.;	       negative	if new pattern.;	       (temporary for a is work);;============================================getPattern	PROC	EXPORT		import	NewDeskPatFlag,DisposeHandleGlue		stz	<work			Set 'no pattern message' flag.		inc	<work;		lda	#24			Number of bytes	to allocate.;		jsr	allocate;		phx				Pass to	DisposeHandle.;		pha;;		pea	GetMessage		Pass action value.;		pea	DeskMessage		Pass type of message.;		phx				Pass handle to MessageCenter.;		pha;		_MessageCenter			Parameters on stack.***		pha		pha				;space for GetMsgHandle		pea 1				;flags = get msg by type		pei <zero			;high word of data (ignored)		pea DeskMessage			;message 2		_GetMsgHandle***		bcc	@ne1@toExit		brl	exit			Was a pattern message found?@ne1		lda	3,s			Dereference the	message	handle.		tax		lda	1,s		jsr	derefHand		stz	<work			Set 'no change'	flag.;--- Added 12/20/88 DJB -----------------------		ldy	#6		lda	[<temp],y		; get Draw Type		beq	isPattern		cmp	#1			; is it a picture ?		bne	@toExit		lda	ScreenHandle+1		; do we have a buffer already ?		bne	gotBuffer		lda	#32000			; allocate buffer for picture		jsr	allocate		sta	ScreenHandle		stx	ScreenHandle+2		ora	ScreenHandle+2		beq	@toExit			; allocation failed!		lda	3,s			Dereference the	message	handle.		tax		lda	1,s		jsr	derefHand		dec	NewDeskPatFlaggotBuffer	add4	<temp,#8,<temp		PushZLong <temp		PushLong ScreenHandle		PushLong #32000		_PtrToHand			; copy picture to our buffer*** added 12-Dec-91 DAL		lda NewDeskPatFlag		sta <work*** end 12-Dec-91		bra	exit;--- End Add ----------------------------------isPattern*** added 12-Dec-91 DAL*** Kill old deskpicture handle, if any		lda	ScreenHandle+1		beq	@noPicHandle		pushlong ScreenHandle		jsl DisposeHandleGlue		stz ScreenHandle		stz ScreenHandle+2		dec	<work@noPicHandle*** end 12-Dec-91		ldy	#messData+16		ldx	#14lop1		lda	[<temp],y		cmp	deskpat,x		Any change?		beq	next1		dec	<work			Set 'pattern has changed' flag.next1		sta	deskpat,x		dey		dey		dex		dex		bpl	lop1*** added 12-Dec-91		lda	<work		bpl	@noNeed*** Now set the background pattern in deskport to our new pattern		pha		pha		_GetPort		pei <deskPort+2		pei <deskPort		_SetPort		pushlong #deskpat		_SetBackPat		_SetPort@noNeed*** end 12-Dec-91exit;;;		_DisposeHandle			Parameters on stack.		pla		pla				;discard message handle		stz	NewDeskPatFlag		lda	<work		rts		ENDP		;================================================;;================================================FinderSaveAll	PROC	EXPORT		IMPORT	EmptyTrashMenu		IMPORT	WStringCopy		import	DisposeHandleGlue		jsr	EmptyTrashMenu		; delete everything in the Trash		jsr	writeDef		; write Finder.Def file; ------ Save the pathname of the top most window -------------------------		lda	#$FFFF			;any window.		jsr	getFrontWind		;find the top window.		cmp	#DirWindID		;is the top window a directory window?		bne	saveRoots		ldy	#windPath				lda	[<windBlk],y				clc		adc	#8			;Number of bytes to allocate. (6+2)		jsr	allocate		phx				;Pass to DisposeHandle.		pha		pea	AddMessage		Pass parameters	to MessageCenter.		pea	TopMessage		phx		pha		jsr	derefHand		temp = (Handle)		lda	#windPath		clc		adc	<windBlk		ldx	<windBlk+2		bcc	@nr		inx	@nr		phx		pha		lda	<temp			;add 6 to the destination because		clc				;the filename starts at offset +6		adc	#6			;not offset +0		ldx	<temp+2		bcc	@nr2		inx@nr2		phx		pha		jsl	WStringCopy		_MessageCenter		jsl DisposeHandleGluesaveRoots	jsr	writeAllRoots		; write FINDER.ROOT files		_UnloadScrap			;fix BRC #44569 -- andy				rts				ENDP					; = = =	= = = =	= = = =	= = = =	= = = =	=;	   Pathname length error.; = = =	= = = =	= = = =	= = = =	= = = =	=;;  OUT:	   Carry set.;; = = =	= = = =	= = = =	= = = =	= = = =	=lenError	PROC	EXPORT				IMPORT	doAlertWindow		rep	#$30			;some callers in 8 bit, so switch to 16.						;hey, what about switching BACK to 8????? -- andy				lda	#rasPathTooLong		jsl	doAlertWindow		sec				;error flag.		rts		ENDP		;-----------------------------------------------;	Invalidate the content of Info windows	;added 07/27/88 by Dan O.;	of selected icons.;; IN:	ic - icon to check;-----------------------------------------------updateInfoWin	Proc	EXPORT		IMPORT	_UpdateInfoWin		lda	#iconRect		ldx	#iconRect>>16		bra	begin		EXPORT	updateInfoWin2updateInfoWin2	lda	#whereRect		ldx	#whereRect>>16begin		sta	locRectPtr		stx	locRectPtr+2		ldy	#icInfo+1		;does icon have an Info window?		lda	[<ic],y		beq	@exit				PushZLong <icHand		PushLong #C1_PathName		jsl	_UpdateInfoWin		@exit		rtslocRectPtr	DC.L	0iconRect	DC.W	0,infoDX>>1,infoY1+10,infoDXwhereRect	DC.W	infoDY>>1,70,(infoDY>>1)+12,infoX2;-----------------------------------------------						ENDP		*===============================================**    Find All Directory Windows for a Volume	**						** Called by walkWindows				*		*===============================================*FindWindows	PROC	EXPORT		IMPORT	CheckAnyDWindow		IMPORT	matchRootName		jsr	matchRootName		bcc	next		jsr	CheckAnyDWindow		; update this window				PushLong #C1_VolName		PushLong #C1_PathName		jsl	WStringCopy		; C1_Pathname <-- volume namenext		clc				; continue flag		rts		ENDP; check windows on desktop for who has become the front window; this will put a checkmark beside the frontmost window in the windows menu; and also remove the checkmark from the other window;; INPUTS: none;; OUTPUTS: topmost window is checkmarked, last topmost window has its;	   checkmark removed;.....................................................................CheckFront	PROC		IMPORT	matchedSecond		IMPORT	matchSecond		IMPORT	NoRename		IMPORT	LEWind		IMPORT	NewView		IMPORT	LastOnTop		IMPORT	CurView			pha		pha		_FrontWindow		pulllong <deref				lda	<deref+1		;is anyone open?		bne	@who		stz	lastOnTop				jsr	UncheckView		;uncheck the views menu@done		rts				;nope;; first, check if LEWind is the same as the desktop port, if so then leave the line edit; control alone.  If LEWind is different from the front window, get rid of the line; edit control so that only the front window can have a line edit control in it;@who		;;; Opt 20-Feb-92 DAL;		lda	LEWind;		cmp	<deskport;		bne	@lookAtFrontWind;		lda	LEWind+2;		cmp	<deskport+2;		beq	@noRemove		lda LEWind+1		cmp <deskPort+1		beq @noRemove;@lookAtFrontWind;;; Opt 20-Feb-92 DAL;		lda	<deref		;		cmp	LEWind		;		bne	@removeRename	;		lda	<deref+2;		cmp	LEWind+2;		beq	@noRemove		lda <deref+1		cmp LEWind+1		beq @noRemove;;@removeRename		jsr	noRename@noRemove	pha		pushZLong <deref		_GetSysWFlag		pla		bpl	@finderWindow				jsr	UncheckWindow		;uncheck the windows menu		brl	UncheckView		;uncheck the views menu;; We have a finder window on top of the pile of windows;@finderWindow	pha		pha		pushZLong <deref		_GetWRefCon		pulllong <deref;; first, we'll have to check or uncheck the view type for this finder window;			ldy	#windID		lda	[<deref],y		cmp	#DirWindID		bne	@UncheckWindow				ldy	#windView		lda	[<deref],y;;; Opt 20-Feb-92 DAL;		asl	a;		tax;		lda	CurView;		cmp	ViewItems,x;		beq	@viewSet***		clc		adc #idByIcon		cmp CurView		beq @viewSet***		jsr	UncheckView		;uncheck the current view				ldy	#windView		;setup the new view		lda	[<deref],y;;; Opt 20-Feb-92 DAL;		asl	a;		tax;		lda	ViewItems,x***		clc		adc #idByIcon***		sta	CurView				pea	$FFFF			;check the new view		pha		_CheckMItem		bra	@viewSet@UncheckWindow	jsr	UncheckView		;; Now, finish checking the windows menu item, etc.;@viewSet	ldy	#windMenuItem		lda	lastOnTop		cmp	[<deref],y		bne	@notAlready		rts		@notAlready	jsr	UncheckWindow				ldy	#windMenuItem		lda	[<deref],y		sta	lastOnTop				pea	$FFFF			;turn the checkmark on on this item		pha		_CheckMItem		rts	;; UncheckWindow -- uncheck the current window if there is one and leave the current window;		   set as nothing...;UncheckWindow	lda	lastOnTop				beq	@done		pei <zero			;uncheck the window item currently checked		pha		_CheckMItem		stz	lastOnTop@done		rts		;; UncheckView -- uncheck the current view if there is one and leave the current view set as;		 nothing...;UncheckView	lda	CurView		beq	@done		pei <zero			;uncheck the view item currently checked		pha		_CheckMItem		stz	curView		@done		rts;; Locals;;;; Opt 20-Feb-92 DAL;viewItems	DC.W	idByIcon;		DC.W	idByTinyIcon;		DC.W	idByName;		DC.W	idByDate;		DC.W	idBySize;		DC.W	idByKind		ENDP; CheckCleanup -- see if they are holding down the option key, and if they are,;  		  change "cleanup" to "cleanup by name";; IN: nothing;; OUT: nothing;.....................................................................CheckCleanup	PROC		IMPORT	GetFrontWind		IMPORT	DeskWindState		lda	<modifiers		and	#$0800		beq	@ChangeToClean		lda	#$FFFF			;Take any window on top.		jsr	GetFrontWind		;Get the front most window.		beq	@ChangeToClean		;if we're at the desktop, don't change		and	#DirWindID+TrashWindID	;Directory or Trash is OK.		beq	@ChangeToClean		ldy	#windView		lda	[<windBlk],y		cmp	#viewByName		bge	@ChangeToClean@ChangeToCleanByName		lda	CleanupState		bmi	@done		dec	CleanupState				pea	2		pushlong #rMItemCleanupByName		pea	601		_SetMItemName2				pea	606			;new		pea	601			;old		_SetMItemID		bra	@calcMenuSize		@ChangeToClean			lda	CleanupState		beq	@done		stz	CleanupState				pea	601			;new		pea	606			;old		_SetMItemID		pea	2		pushlong #rMItemCleanup		pea	601		_SetMItemName2				@calcMenuSize	pei <zero		pei <zero		pea 600		_CalcMenuSize						lda	DeskWindState		eor	#winTopText		sta	DeskWindState		;blast this so that the cleanup menu item gets dimmed (or not)		@done		rts		;; locals;		EXPORT	CleanupStateCleanupState	dc.w	0		endp; checkAboutRecalc -- see if it's time to recalculate the space free and used by the system;; INPUTS: none;; OUPUTS: none;.....................................................................checkAboutRecalc proc				IMPORT	doAboutRecalc		lda	when		sec		sbc	lastAboutTime		cmp	#15*60			;15 seconds		blt	@done		jsl	doAboutRecalc				lda	when		sta	lastAboutTime@done		rts		EndP		; check windows on desktop for changes;; INPUTS: none;; OUTPUTS: none;.....................................................................CheckWindows	PROCNetLatency	equ	30			; JAM 5/31/89 to improve Finder perf. (in seconds)		IMPORT	walkWindow		IMPORT	CheckWindow		IMPORT	DrawHearts				lda	<when		sec		sbc	LastNetTime		cmp	#60*NetLatency		; about NetLatency seconds		bcc	end		lda	<when			; start counter again		sta	LastNetTime		lda	#DirWindID		; directory windows only.		ldx	#CheckWindow		jsr	walkWindowend		rts		ENDP		*===============================================**    Check each window on desktop for changes	**    (called by walkWindow)			**						** INPUT:	wind				** OUTPUT:	carry flag clear		**						**===============================================*CheckAnyDWindow	PROC 	EXPORT		IMPORT	CheckIcons		IMPORT	GetModifyDate		IMPORT	windRefCon		IMPORT	getWindPath		IMPORT	redrawText		IMPORT	redrawList		IMPORT	setItems		IMPORT	newDataSize3		IMPORT	updateKs		IMPORT	setInfo2		IMPORT	freeRectRgn		IMPORT	ClearWindDirty		IMPORT	selectionIsChanging		stz 	IsNewer			;init		phd				;save it for exit		pea	$FFFF			;don't exclude non-net items		bra	StartCkWin		EXPORT	UpdateWindowUpdateWindow		lda	#1		sta	IsNewer			;update no matter what		bra	common		EXPORT	CheckWindowCheckWindow	stz 	IsNewer			;initcommon		phd				;save it for exit		pei	<zero			;behave as usual	;		; Save the window pointer here, it can be trashed by routines that walk the ; various lists (in particular kill child). This way we can restore it later if; we need to.;StartCkWin			lda 	<wind			;get the current window pointer		sta 	CkWindPtr		;save it in our local pointer		lda 	<Wind+2		sta 	CkWindPtr+2				jsr	windRefCon		;windBlk = window's info block pointer		jsr	getWindPath		;C1_PathName = window's pathname				lda	IsNewer			;check date?		bne	DatesDiffer		;bra if no: update no matter what		ldy	#windDate		;is date valid ?@loop		lda	[<windBlk],y		bne	OK		iny		iny		cpy	#windDate+8		bcc	@loopGotoExit	brl	exit			; probably a ProDOS root folder;-----------------------------------------------		OK		ldy	#windIC			; is this a Network icon ?		lda	[<windBlk],y		sta	<icHand		iny		iny		lda	[<windBlk],y		sta	<icHand+2		jsr	lockic		ldy	#icFlag+2		lda	[<ic],y		and	#ICNETWORK>>16		; is this directory on the Network?		bne	ContCkWin		; bra if no: ignore non-network directories.		lda	1,S			; do we want to process all directories?		beq	gotoexit		; no, so go home; At this point, the volume is not on the network, and we know that we want to; process everybody (probably to handle a local disk insertion).  If it is a ProDOS; root volume we should go ahead and process the directory, regardless of the; last modified date.  If it is not a root volume, then we need to process only; after making sure that the last modified date warrants processing.;; %%%; COMPATIBILITY ALERT:  THE FOLLOWING CODE WILL ALMOST CERTAINLY NEED TO BE; REWRITTEN WHEN WE GET NEW FSTs.		ldy	#icFType		lda	[<ic],y		cmp	#TypeLastOne		bcc	ContCkWin		; bra if not a device icon, so not a root dir.		ldy	#icFileInfo				lda	[<ic],y			; What's the file system?		cmp	#$1			; Is it ProDOS?		bne	ContCkWin		; bra if NO: last mod date is assumed valid.		inc	IsNewer			; else YES:  Last mod date may be wrong.		bra	DatesDiffer		; So use brute-force, & assume they differ.;-----------------------------------------------ContCkWin	PushLong #C1_PathName		; pass pathname pointer		PushLong #Date			; pass date address		jsl	GetModifyDate		bcs 	GotoExit		ldx	#6		ldy	#windDate+6loop		lda	Date,x		cmp	[<windBlk],y		; is window out dated ?		beq	next		inc	IsNewer		sta	[<windBlk],y		; update window's datenext		dey		dey		dex		dex		bpl	loop		DatesDiffer	lda	IsNewer		sta	IconChanged		; zero the changed flag if no changes		beq	exit			; This beq MUST be here !!!! - DJB			jsr	getRectRgn		; goAhead:  allocate rectRgn and tempRgn		jsr	CheckIcons		; update window's icons			bcs	exit			; error so abort update				lda	IconChanged		; get the icon changed flag		beq	SetData			; if no changes, don't redraw		stz	IconChanged		jsl 	selectionIsChanging		;; Restore the window pointer to its original setting before calling any routine; that can cause window drawing;		lda 	CkWindPtr		sta 	<Wind		lda 	CkWindPtr+2		sta 	<Wind+2;; Now also, test to see if the window pointer that we are in has the current; rename field, if so, it should be turned off (rename that is) so that when the; window is redrawn (which it is since its a text view) and the icon you are renaming; moves (as they usually do) their will not be a stray rename field;		ldy	#windView		;first test to see if we need to 		lda	[<windBlk],y		;redraw the whole window in text mode		cmp	#viewByName		bcc	byIcon		lda 	Wind+2			;get the pointer to the current window		cmp 	LEWind+2		;compare it to the current rename icon		bne 	@NotThiswind		;if not equal dont worry		lda 	wind		cmp 	LEWind		bne 	@NotThiswind		jsr 	noRename		; if they are the same, dump the rename field@NotThiswind				jsr	redrawText		Act like a new view was	just selected.		bra	setdatabyIcon		jsr	redrawList		Redraw hole left by deleted icons.setdata		ldy	#windID			If directory window, then update number		lda	[<windBlk],y		of icons.		cmp	#DirWindID		bne	@notDir		jsr	clearWindDirty		jsr	setItems		Set new	number of items.@notDir	*** added 16-Oct-92 DAL -- preserve <wind, especially for when we're called by WalkWindows		pei	<wind+2		pei	<wind*** end 16-Oct-92		jsr	newDataSize3		Compute	new data size for window.		jsr	updateKs		Update info bars for all window	in path.		lda	<TrashWind		Update Trash window's info bar in case		ldx	<TrashWind+2		some extended icons were removed.		jsr	setInfo2		New number of items.*** added 16-Oct-92 DAL -- restore <wind		pla		sta	<wind		pla		sta	<wind+2*** end 16-Oct-92		jsr	freeRectRgn		Free allocated regions.exit		pld				; get rid of argument (trashing dp pointer...)		pld				; make up for trashing DP pointer just now		clc		rts				ENTRY	IconChanged		EXPORT	IconChangedIconChanged	ds.W	1		Date		DS.B	8IsNewer		DS.W	1CkWindPtr	ds.L 	1				ENDP*===============================================**     Check each icon in window for changes	**						** INPUT:	wind,windBlk			** OUTPUT:	none				**						**===============================================*CheckIcons	PROC	EXPORT		IMPORT	CompareIcon		IMPORT	ExtraIcon		IMPORT	WalkOfLife3		IMPORT	AddWindowIcon		IMPORT	IsIconInTrash		IMPORT	IsIconOnDesk				IMPORT	OptionBuff		IMPORT	IconChanged		import	ce_access		import	ce_file_type		import	ce_aux_type		import	ce_mod_date		import	startHash		import	SpotHashOn		import	CopyDirEntryToIconTemplate		jsr 	startHash		; JAM 5/21/89				PushLong #C1_PathName		; pass window's pathname		ldx	#xStartCatalog		jsl	MiscEntry		bcs	toExit			; bra if open error: abort		Loop		lda	<zero		sta	>OptionBuff+olFileSysID		pha				; space for result		pha		ldx	#xNextCatalog		jsl	MiscEntry		plx		stx	<work			; get pointer to directory entry		plx		stx	<work+2		bcc	ok		cmp	#$0061			;end of directory error?		beq	done			; end of directory		sectoExit		bra	exit			; error, so abortok						; copy info for dir entry to icon template*** Added - 18-Feb-93 JCM - Lets copy some more info locally so that CompareIcon can do a much more***			    thorough job, like actually noticing files changing. Wow. What a concept.		jsr	CopyDirEntryToIconTemplate ;get lots of common stuff;;;		ldx	#6			;18-Feb-93 JCM - this was copied when CopyDir... was called;;;copydate	lda	ce_mod_date,x		; get modified date;;;		sta	ticonobj+icMDate,x;;;		dex;;;		dex;;;		bpl	copydate; The last bit of info we need is the fileType/auxType combo.		lda	ce_file_type		sta	ticonobj+icFType		lda	ce_aux_type		sta	ticonobj+icAuxType		lda	ce_aux_type+2		sta	ticonobj+icAuxType+2*** End - 18-Feb-93 JCM		ldy	#DirName+30		; get entry name		ldx	#30copyname	lda	[<work],y		sta	ticonobj+icName,x		dey		dey		dex		dex		bpl	copyname;; Fixing bug that allows old, non-invisible Finder data files to be; made visible in a special-update situation (such as volume update, net update, etc.);		lda	ce_file_type		cmp	#DATAFTYPE		beq	DoWeHideIt		; don't care about the invisible bit				lda	ce_access		; get access value		and	#$0004			; check the invisible bit		beq	check			; not set		DoWeHideIt	lda	prefer			; should invisible files be hidden?		and	#PREF_HDATA		bne	loop			; if yes, go to next catalog entry		check		lda	#CompareIcon		; check if entry is in our list		jsr	WalkOfLife3		bcs	loop		jsr	IsIconInTrash		; check if entry is really in our trash		bcs	loop				jsr	IsIconOnDesk		; is the icon on desktop already?		bcs	loop		jsr	AddWindowIcon		; no, so add missing icon		bra	loop		done		ldx	#xEndCatalog		jsl	MiscEntry		lda	#ExtraIcon		; check for extra icons in our list		jsr	WalkOfLife3		clcexit		stz	SpotHashOn		rts		ENDP*===============================================**     Compare entry against icon list		**						** INPUT:	ic				** OUTPUT:	carry set if found		**						**===============================================********************************************************************************************************** Some notes from Jim "whoops" Murphy* -----------------------------------** Under Finder 6.0, there was (and actually still is, but it is not longer used) a mechanism to inform* Finder that a directory had changed, and you wished it to be rebuilt and redisplayed. Fine enough,* except the only things Finder 6.0 could notice were files being created or deleted, access privileges* changing (both local and network), file modification data changing, or in the odd case, a new icon to* match with a file. Unfortunately, Finder never noticed changes in a file's size, or type, or auxType,* or quite a few other attributes. The fixes below are an attempt to make Finder notice any and all* changes that can occur to a file with 100% accuracy. Here we go (part of my motivation is to get Andy* McFadden to just hush up about this problem :-)...********************************************************************************************************CompareIcon	PROC				IMPORT	PStringCompare		IMPORT	NewIconData		IMPORT	OptionBuff		IMPORT	IconChanged		IMPORT	MatchImage		pha				; space for result		ldx	<ic+2		lda	<ic		clc		adc	#icName		bcc	push		inxpush		phx				; pass icon's name ptr		pha		PushLong #ticonobj+icName	; pass entry's name ptr		jsl	PStringCompare		clc		pla		beq	@exitNotFound		; not this icon		jsr	CheckIconForChanges@exitFound	ldy	#icFlag+2		;mark this icon as being visited so we don't remove		lda	[<ic],y			; it from our list when we're done		ora	#ICVISITED>>16		sta	[<ic],y		sec				;we matched on this icon@exitNotFound	rts************************************************************************************** CheckIconForChanges - *		EXPORT	CheckIconForChangesCheckIconForChanges		stz	iconIsOutOfDate		;assume that this icon's data is current		jsr	TestPrivs		;always test for privilege change		bcc	@checkFileType		inc	iconIsOutOfDate		;we'll need to update the icon later* Now that we've located a file we know about, we'll check groups of fields with a few* short loops to see if any of them have changed. As we check each field below, if one* does not match the iconObj data, we'll go ahead and update everything associated with* the file.; Check the fileType and auxType in a single loop since they are consecutively stored; in the iconObj.@checkFileType		ldy	#icFType		lda	#icFType+6		jsr	CheckObjChunk; Now we'll do a large check that includes the local access, forks count, block size, file size,; create date and modification date.			ldy	#icLocalAccess		lda	#icIcon		jsr	CheckObjChunk	; Our final check will be if anything in the optionList has changed. Only check the bytes in the; optionList that were actually returned from the GetDirEntry call.				ldy	#icOptionList		lda	OptionBuff+olBytesReturned		clc		adc	#icOptionList+2		jsr	CheckObjChunk; Now that we've done all of that, let's see if we actually need to rebuild this icon, shall we?; If iconIsOutOfDate is non-zero, then we need to update.		lda	iconIsOutOfDate		beq	@exitCheckIcon; Here we test to see if the icon we are changing has the rename field, if it; does we should end the rename.		lda 	<icHand+2		;compare the current icon		cmp 	LEIcon+2		;to the icon that's being renamed		bne 	@updateIcon		lda 	<icHand		cmp 	LEIcon		bne 	@updateIcon				jsr 	noRename		;if this one, dump rename field@updateIcon	jsr	NewIconData@exitCheckIcon	rts				ENTRY	iconIsOutOfDateiconIsOutOfDate	ds.w	1***************************************************************************************** TestPrivs - This routine tests the privileges returned in OptionBuff against those* that your icon claims to have. If they are the same, then these attributes of the* icon did not change.TestPrivs; First, be sure that this is a folder.		ldy	#icFType		lda	[<ic],y		cmp	#TypeFolder		; is it a folder?		beq	@cont@L1		jsr 	FixLocked		; Mensch 5/30/89 if not, test locked and end		rts@cont		ldy	#icFlag+2		lda	[<ic],y		and	#ICNETWORK>>16		; is this a network folder?		beq	@L1		lda	[<ic],y			; refresh the flags		and	#$000F			; strip off AppleShare privileges		pha				; and save this for later comparisons; Create a new 4-bit access privileges field from the OptionBuff data.;;;		lda	>OptionBuff+olFileSysID	;11-Feb-93 JCM - buffer is in same segment, and bank is set here		lda	OptionBuff+olFileSysID		cmp	#$000D			; is this AppleShare?		bne	@ExitNoChange;;;		lda	>OptionBuff+olPrivileges ; get the proper word		lda	OptionBuff+olPrivileges	; get the proper word		and	#$0087			; only bits we understand right now		cmp	#8			; see if bit 7 is set...		blt	@DoCompare		; if bit 7 not set, then do the compare		ora	#$0008			; set our owner bit		and	#$000F			; clear their owner bit@doCompare		cmp	1,S		beq	@exitNoChange		; end with no change flagged; If we did not exit, then something is different.		sta	1,s			; save the new privileges		lda	[<ic],y		and	#$FFF0			; apply the new privs to the icon		ora	1,s		ora	#ICReadable>>16		; flag the read-enabled bit		sta	1,s			; and resave it for a second		and	#$0003			; can we read it?		bne	@CanRead		lda	#ICReadable>>16		eor	1,s		sta	1,s@CanRead		lda	1,s		sta	[<ic],y			; resave the privileges		pla				; discard the crap; Now change the icon that goes with this file.		tax		and	#$0007		cmp	#$0004			; is it a drop box???		beq	@GetIcon		; if so, just get the icon		txa		and	#$000F		cmp	#$0007			; test if bit 3 is set		blt	@NotMine				lda	#$0008		bra	@GetIcon		@NotMine	lda	#$0000@GetIcon; Swap in the new icon offset.		ldy	#icFileInfo		sta	[<ic],y			;Save as the new Aux type				jsr	FixLocked		;Mensch 5/30/89		sec				;flag that a change was made and return		rts@ExitNoChange	pla* Fixes the locked status and returns carry set or clear to indicate that* a change has occurred.FixLocked		ldy	#icFlag		lda	[<ic],y		and	#ICLOCKED		beq	@NotLocked@AlreadyLocked		ldy	#dirAccess		lda	[<work],y		and	#$0080		beq	@NoChange		@changed		ldy	#icFlag		lda	[<ic],y		eor	#ICLocked		sta	[<ic],y		sec		rts		@noChange		clc		rts@notLocked		ldy	#dirAccess		lda	[<work],y		and	#$0080		bne	@noChange		bra	@changed		***************************************************************************************** CheckObjChunk - This function takes two parameters; a start and end iconObj field*		  offset. It compares all fields in the range that are referenced by*		  [<ic] to those that are in ticonobj. If any field does not match,*		  iconIsOutOfDate is incremented by one and the field value in [<ic]*		  is updated to be current.*CheckObjChunk	pha				;end field to check@checkThisField lda	ticonobj,y		;most current date from the dir entry		cmp	[<ic],y			;what the icon thinks it is		beq	@checkThisField2	;is the icon right?		sta	[<ic],y			; nope, update this iconObj field		inc	iconIsOutOfDate		;we'll need to update the icon later@checkThisField2 iny		iny		tya		cmp	1,s		bcc	@checkThisField		pla				;end of range offset				rts				IF	AllowSmartDesktop THEN				***************************************************************************************** UpdateDesktopIcons - ** C1_VolName = name of disk the check icons from**		IMPORT	WalkOfLife		IMPORT	PathToPStr		IMPORT	justRootName		IMPORT	getExtName		IMPORT	WStrCompare		EXPORT	UpdateDesktopIconsUpdateDesktopIcons		PushZLong <curWind		lda	<deskport		; check desktop ICONOBJ list		sta	<curWind		lda	<deskport+2		sta	<curWind+2					jsr	toDesktop		; switch to desktop 		jsr	toDeskPort		; switch to desktop port		PushLong #C1_VolName		PushLong #C1_Temppath		;diskname to match against		jsl	WStringCopy		lda	#MatchDesktopIcon		jsr	WalkOfLife		pla		sta	<curWind		pla		sta	<curWind+2		rts		* Called by walkIconsMatchDesktopIcon		brk	$00		ldy	#icFlag			;we don't want disk icons, just files and folders		lda	[<ic],y			; that were dragged to the desktop		and	#ICEXTENDED		beq	@exitNoMatch		jsr	getExtName		;C1_PathName = <ic.icOwner field		bcs	@exitNoMatch				jsr	justRootName		;C1_Pathname = pathname's root only		pha		PushLong #C1_Pathname		PushLong #C1_TempPath		jsl	WStrCompare		pla		beq	@exitNoMatch;;;		jsr	CheckIconForChanges@exitNoMatch	clc				;do all of the icons on the desktop		rts		ENDIF		ENDP*===============================================**     Check if icon is in trash			**===============================================*IsIconInTrash	PROC		IMPORT	PStringCompare		IMPORT	WalkOfLife		pei	<wind+2			; preserve current window		pei	<wind		pei	<windBlk+2		pei	<windBlk		pei	<curWind+2		pei	<curWind		lda	<TrashWind		; set to trash window		sta	<curWind		lda	<TrashWind+2		sta	<curWind+2check		lda	#TestIcon		; check if entry is in our trash list		jsr	WalkOfLife		; carry set if entry is in trash		pla		sta	<curWind		pla		sta	<curWind+2		pla		sta	<windBlk		pla		sta	<windBlk+2		pla				; restore window		sta	<wind		pla		sta	<wind+2		rts				; carry flag returned;-----------------------------------------------TestIcon	pha				; space for result		ldx	<ic+2		lda	<ic		clc		adc	#icName		bcc	push		inxpush		phx				; pass icon's name ptr		pha		PushLong #ticonobj+icName	; pass entry's name ptr		jsl	PStringCompare		pla		cmp	#1			; carry set if name matches				rts		ENDP		; start JAM 06/11/89 (Fixing BRC #50497)		*===============================================**     Check if icon is on desktop		**===============================================*IsIconOnDesk	PROC EXPORT			; Call with JSR or equiv.		IMPORT CkOnDesk			; Must be in same code bank as us.; On Entry, we expect C1_Pathname to hold the name of the current window;  <work holds directory entry for the name to check; On exit, CARRY CLEAR if icon of the given name is NOT ON DESKTOP.;   CARRY SET if an icon belonging to the given file IS ON DESKTOP.; Preserves longword values of DP locations temp, DeskIC, Ic, IcHand, and Work.		pushZLong <temp		pushZLong <DeskIc		pushZLong <Ic		pushZLong <IcHand		pushZLong <Work		clc				lda	#DirName		adc	<work		sta	<work		lda	<work+2		adc	<zero		sta	<work+2		jsr	CkOnDesk		;returns opposite carry		bcc	@isOnDesktop		clc		bra	ReturnHome@isOnDesktop	sec				;signal file is on the desktopReturnHome		pla		sta	<Work		pla		sta	<Work+2		pla		sta	<IcHand		pla		sta	<IcHand+2		pla		sta	<Ic		pla		sta	<Ic+2		pla		sta	<DeskIc		pla		sta	<DeskIc+2		pla		sta	<temp		pla		sta	<temp+2		rts		ENDP; end   JAM 06/11/89 (Fixing BRC #50497)				*===============================================**     Check if icon was visited			**						** INPUT:	ic				** OUTPUT:	carry clear			**						**===============================================*ExtraIcon	PROC				IMPORT	DelWindowIcon		ldy	#icFlag+2		; check if visited		lda	[<ic],y		and	#ICVISITED>>16		beq	remove			; no, so remove it		lda	[<ic],y		and	#≈(ICVISITED)>>16	; clear visited bit		sta	[<ic],y		bra	exitremove		jsr	DelWindowIcon		exit		clc		rts		ENDP		*===============================================**    Update an Icon's data			**						** INPUT:	none				** OUTPUT:	carry set if found		**						**===============================================*NewIconData	PROC;; Mensch 5/21/89 (Fixing BRC #49175); This routine was totally empty before, so this is its first edition.;		IMPORT	MatchFileToIcon		IMPORT	IconChanged		IMPORT	addIconRgn		IMPORT	StartDraw2		IMPORT	EndDraw		IMPORT	getIconRect		IMPORT	PushiRect1		IMPORT	PushIRect2		IMPORT	MatchImage		IMPORT	FiFiFiSearch		;17-Mar-93 JCM	;	; Since the icon changed, redraw it.  First, set up the drawing environment.;		jsr	lockic		lda	<wind		ldx	<wind+2		jsr	startDraw2		; switch to proper port and origin		jsr	AddIconRgn		; add the icon's region to update region;; now erase the old icon;		jsr	GetIconRect		jsr	pushirect1		_EraseRect		lda	<iRect2+2		; now change this stupid rect		sbc	#8		sta	<irect2+2		lda	<irect2+6		adc	#8		sta	<irect2+6		jsr	pushirect2		_EraseRect				jsr	pushirect1		_InvalRect		jsr	pushirect2		_InvalRect;; swap in the new icon offset;		tsc		sec		sbc	#20			;put 5 longs on the stack		tcs		pea	$8000			;don't care about voting, match all		pea	1			;match the first one		ldy	#icFType		lda	[<ic],y			; get the file type		pha		pei	<zero		ldy	#icFileInfo		lda	[<ic],y			; get the Aux Type		pha*** Added - 17-Mar-93 JCM - Get a pointer to this icon's kind string. We'll check below***			    to see if we've got a bundle that better describes it.		ldy	<zero		tax				;auxType		lda	5,s			;fileType		jsl	FiFiFiSearch		sta	ticonobj+icKind		stx	ticonobj+icKind+2*** End - 17-Mar-93 JCM		lda	#icName			;ptr to the name		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx				lda	#icCDate		;ptr to the create date		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx				lda	#IcMDate		;ptr to the mod date		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx				ldy	#IcLocalAccess		;local access value		lda	[<ic],y		pha						ldy	#icForked		;extended or not		lda	[<ic],y		pha				lda	#IcOptionList		;ptr to the option list		clc		adc	<ic		tax		lda	<ic+2		adc	<zero		pha		phx				ldy	#icFBytes+2		;file's size in bytes		lda	[<ic],y		pha		dey		dey		lda	[<ic],y		pha		jsl	matchFileToIcon		pla		ldy	#IcOneDocOffset		;update the onedoc pointer		sta	[<ic],y		sta	<ptr		iny		iny		pla		sta	[<ic],y		sta	<ptr+2		pla		ldy	#IcRBundle		;update the rBundle handle		sta	[<ic],y		sta	<handle		iny		iny		pla		sta	[<ic],y		sta	<handle+2				pla				;update the small icon handle		ldy	#IcSmallIcon		sta	[<ic],y		iny		iny		pla		sta	[<ic],y				pla				;update the large icon handle		ldy	#IcIcon		sta	[<ic],y		iny		iny		pla		sta	[<ic],y		pla		pla				;rFinderPath goes into hyperspace...*** Added - 17-Mar-93 JCM - If there's a OneDoc for this icon and it has a kind string,***			    use it instead of the one FiFiFi may have found.* Find out if the NumResults field of this particular OneDoc includes a kind string.		lda	<handle+1		;is there a bundle?		beq	@useFiFiFiKindPtr	; nope, use FiFiFi's		lda	[<handle]		clc		adc	<ptr			;oneDocOffset		sta	<ptr		ldy	#2		lda	[<handle],y		adc	<ptr+2			;oneDocOffset+2		sta	<ptr+2				ldy	#4			;check numResults		lda	[<ptr],y		cmp	#5		blt	@useFiFiFiKindPtr				stz	ticonobj+icKind		;use the OneDoc kind string		stz	ticonobj+icKind+2		@useFiFiFiKindPtr		ldy	#icKind		lda	ticonobj+icKind		sta	[<ic],y		iny		iny		lda	ticonobj+icKind+2		sta	[<ic],y*** End - 17-Mar-93 JCM;; and redraw the icon;		jsr	drawIcon2		; draw the icon in its new window		jsr	enddraw			; set window's origin back to 0,0		lda	#1		sta	>IconChanged		rts		ENDP		*===============================================**     Add an Icon to a window			**						** INPUT:	none				** OUTPUT:	none				**						**===============================================*DelWindowIcon	PROC		IMPORT	killKids2		IMPORT	wipeIcon		; 6/6/89 Mensch brc#50297; test to see if the icon we are throwing away is the same as the icon being renamed; if it is be sure to dump the rename field		lda <icHand+2			; test current icon		cmp LEIcon+2			; against the renamed one		bne @NotThisOne		lda <ICHand		cmp LEIcon		bne @NotThisOne		jsr noRename			; if they the same, dump it daddy@NotThisOne; end brc #50297 fix #4				ldy	#icFType		; is this a folder?		lda	[<ic],y		cmp	#TypeFolder		bne	cont			; bra if not a folder;--- Delete all windows and extended icons that came from folder		jsr	killKids2;--- Cut icon out of icon list add to redraw regioncont		jsr	wipeIcon		clc		rts		ENDP		*===============================================**     Add an Icon to a window			**						** INPUT:	none				** OUTPUT:	none				**						**===============================================*AddWindowIcon	PROC		IMPORT	AccessPriv		IMPORT	C1_BootName		IMPORT	PStringCompare		IMPORT	WStrCompare		IMPORT	strSystem		IMPORT	OptionBuff				IMPORT	ce_access		IMPORT	ce_flags		IMPORT	addIconObj		IMPORT	startDraw2		IMPORT	lockic		IMPORT	drawIcon2		IMPORT	endDraw		IMPORT	redrawText		IMPORT	GetTopLeft		IMPORT	PathAddName		IMPORT	PathAddName		IMPORT	PToWString		IMPORT	startHash		IMPORT	windSpot		IMPORT	posFlag		IMPORT	FolderColor		import	ce_prodos_entry		import	ce_create_date		import	ce_mod_date		import	ce_aux_type		import	ce_file_type		import	ce_access		import	CopyDirEntryToIconTemplate		pushZlong <work			; save <work prior to calling WindSpot		stz	posFlag			; don't use position buffer		jsr	WindSpot		; this will occasionally clobber <work ptr		pulllong <work			; Get <work back		stz	<devNumber		; files/folders don't have device #		lda	ce_file_type		; pass filetype to addIconObj		sta	<filetype		lda	ce_aux_type		sta	auxtype			; also used for icFileInfo		jsr	CopyDirEntryToIconTemplate ;18-Feb-93 JCM - copy common stuff				ldx	#ICBACKCLR		lda	ce_access		and	#$0080			; check destroy enable bit		bne	store2		ldx	#ICLOCKED+ICBACKCLRstore2		stx	ticonobj+icFlag		lda	ce_access		and	#$0001			; check read enabled bit		beq	set1			; not set !		lda	#ICREADABLE>>16		; set our bitset1		ora	NetworkBit		; add in network status		sta	ticonobj+icFlag+2		stz	ticonobj+icWind		; icon has no open window		stz	ticonobj+icWind+2				lda	OptionBuff+4		cmp	#$0d		bne	@notNetwork		lda	<filetype		cmp	#$0f		beq	@isNetwork		cmp	#typeServer		bne	@notNetwork		@isNetwork	lda	OptionBuff+$2A		sta	ticonobj+icNetworkAccess		lda	OptionBuff+$2C		sta	ticonobj+icNetworkAccess+2		lda	OptionBuff+$2A		;munge the owner bit of the user summary byte into		and	#$0080			;our icon flag stuff		lsr	a		lsr	a		lsr	a		lsr	a		tsb	ticonobj+icFlag+2		lda	OptionBuff+$2A		and	#$000F			; is user icon's owner (on network)		tsb	ticonobj+icFlag+2					lda	ticonobj+icFlag+2		and	#icNetAccess>>16		sta	AccessPriv		bra	@wasNetwork		@notNetwork	stz	ticonobj+icNetworkAccess		stz	ticonobj+icNetworkAccess+2@wasNetwork;; done looking through the access stuff, so see if this is the special 'System'; folder (which gets the apple in the folder icon);		lda	<filetype		cmp	#$0F		bne	@notSystem		lda	ticonobj+icFlag		and	#$00FF		ora	FolderColor		sta	ticonobj+icFlag				stz	auxtype				pha		pushZLong <work		pushlong #strSystem		jsl	PStringCompare		pla		beq	@notSystem				pha				;space for result		PushLong #C1_Pathname		PushLong #C1_BootName		jsl	WStrCompare		;is this the boot disk ?		pla		beq	@notSYSTEM		;no				lda	#$0002			;yes, so mark system folder		sta	auxtype@notSystem	;; done with the system folder stuff, so just search for matches in the icon matching; stuff;		lda	<work			;pass pointer to icon's name		ldx	<work+2		ldy	<zero			;add icon to the head of the list		jsr	addIconObj		;create and add the icon to the window		bcs	exit			;oh, and how we are hosed		jsr	lockic		ldy	#windDiskIc		;move our root icon in here		lda	[<windBlk],y		ldy	#icDisk		sta	[<ic],y				ldy	#windDiskIc+2		lda	[<windBlk],y		ldy	#icDisk+2		sta	[<ic],y		lda	<wind		ldx	<wind+2		jsr	startDraw2		;switch to proper port and origin		jsr	drawIcon2		;draw the icon in its new window		jsr	endDraw			;set window's origin back to 0,0		ldy	#icFlag+2		;mark this icon as being visited		lda	[<ic],y			; so we don't remove it when we're done		ora	#ICVISITED>>16		; walking the directory		sta	[<ic],y		jsr	unlockicexit		clc		rts				ENDP*** Added - 18-Feb-93 JCM - This code is just collected from AddWindowIcon into a separate***			    subroutine so others can call it as well.*********************************************************************************** CopyDirEntryToIconTemplate - This copies most of the interesting fields from the*			       directory entry buffer to our new icon template.*CopyDirEntryToIconTemplate PROC				IMPORT	OptionBuff				IMPORT	ce_access		IMPORT	ce_flags		import	ce_prodos_entry		import	ce_create_date		import	ce_mod_date		import	ce_aux_type		import	ce_file_type		import	ce_access		ldx	#6date1		lda	ce_mod_date,x		sta	ticonobj+icMDate,x		lda	ce_create_date,x		sta	ticonobj+icCDate,x		dex		dex		bpl	date1		lda	ce_prodos_entry+DirSize	; get size in blocks		sta	ticonobj+icFBlocks		lda	ce_prodos_entry+DirSize+2		sta	ticonobj+icFBlocks+2		* %%% It appears that Finder doesn't track resource blocks and resource lengths??		lda	ce_prodos_entry+DirEOF	; get size in bytes		sta	ticonobj+icFBytes		lda	ce_prodos_entry+DirEOF+2		sta	ticonobj+icFBytes+2		lda	ce_access		sta	ticonobj+icLocalAccess		lda	ce_flags		sta	ticonobj+icForked				lda	OptionBuff+2		tay@loop		lda	OptionBuff+2,y		sta	ticonobj+icOptionList,y		dey		dey		bpl	@loop		rts				ENDP*** End - 18-Feb-93 JCM;; DisposeHandleGlue -- 9-Jun-92 DAL to save bytes;DisposeHandleGlue proc export		ldx #$1002		jsl $e10004	;glue vector		rtl		EndP		*===============================================*		END