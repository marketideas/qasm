***************************************************************************** The all-inclusive, setup-and-search Finder Filetype Finder*  * (FiFiFi for short)** by Matt Deatherage and Dave Lyons, 5/17/89* Copyright Apple Computer, Inc. 1989-1992* All rights reserved.** code tightened by Ron Lichty, 1/9/90** Extensive thanks to Dave Lyons and Eric Soldan, who gave great input* on this routine and on the data structures it searches, knowing their* names would be immortalized within Finder Source Code until Jim and Don* rewrite it all in Modula-2 Pascal Ada C Prolog Lisp ++.** This routine has lots of equates and two entry points:** JSL FiFiFi	; loads all type $42 files from the directory*	; '*:Icons' and prepares for searching.* JSL FiFiFiSearch	; takes a filetype/auxtype combination and returns*	; a pointer to a Pascal String describing it.** Of course there are input and output parameters.  They're discussed*in the routines themselves.****************************************************************************	PRINT PUSH,OFF	INCLUDE 'M16.Memory'	INCLUDE 'M16.Misctool'	INCLUDE 'M16.Util'	INCLUDE 'M16.IntMath'	include 'm16.gsos'	PRINT POPGSOS	equ $E100A8ohVersion	equ 0	; offset to version in headerohFlags	equ 2	; offset to flagsohNumEntries	equ 4	; number of entriesohReserved	equ 6	; reserved word (for our use)ohIndRecSize	equ 8	; IndexRecordSizeohOffsetToInd	equ 10	; offset to indexoFiletype	equ 0	; offset to filetype in each entryoAuxtype	equ 2	; offset to auxtypeoFlags	equ 6	; offset to FlagsoOffset	equ 8	; offset to string offsetOurRecSize	equ 8	; the size of the records in the memory block		; we create to show where to search***************************************************************************** FiFiFi entry point #1 - set everything up.** This is the routine called at Finder startup time, which loads all the* filetype descriptors it can find, sorts them, and prepares everything* for entry point #2, which will do the searching.** Input parameters:** None, but the user ID will be gotten from _MMStartUp and ored with* #$0300 for our use, and the prefix in the equate 'PrefixNum' will be* used as the location for the Ftype files.** Output:** Carry is set if there was a fatal system error, and A contains the* number.  Carry is clear if all went according to plan.****************************************************************************FiFiFi	PROC EXPORT	IMPORT ListPtrMaxFiles	equ 30	; maximum number of $42 files we acceptOurFType	equ $42	; filetype of our filesReqAType	equ $0000	; auxtype of the required file (currently unused)BufTooSmall	equ $4F	; GS/OS Buffer Too Small errorEndOfDir	equ $61	; GS/OS end of directory errorLFNSM	equ $C008	; locked, fixed and no special memoryOpen	equ $2010	; GS/OS open call numberClose	equ $2014	; GS/OS close (etc., etc.)SetPrefix	equ $2009GetPrefix 	equ $200ARead 	equ $2012GetDirEntry	equ $201CNoFtypeFiles	equ $4242	; error when no $42 files are foundNoAuxZero	equ $4243	; no file with auxtype zeroPrefixNum	equ 1	; search this prefix for the Ftype filesOurID	equ 0DPScratch	equ OurID+2	; scratch spaceDPScratch2	equ DPScratch+4LLPointer	equ DPScratch2+4	; pointer to the listPrefix	equ LLPointer+4	; the prefix to searchFileTemp	equ Prefix+2	; temporary file pointerScrapWord	equ FileTemp+4	; temporary word storageFutz1Size	equ ScrapWord+2	; size of stack frame;; First, we want Futz1Size bytes of stack space to use as a stack frame / dir page;	phb	phk	plb		; switch data bank to this one	phd	tsc	sta oldStack		; save original stack value for restore - rdl	sec	sbc #Futz1Size	tcs	inc a	tcdGetParms	pha		; space for result	_MMStartUp	pla	ora #$0300		; and in the $x3xx nibble	sta <OurID	;	lda #PrefixNum		; the prefix number to use;	sta <Prefix;; Create the handle for the list.  It will have the following; format:;; WORD - number of entries; and for each entry:;; LONG - auxtype of this file; LONG - pointer to file in memory;; We will handle a maximum of 30 files, so we create a handle with; 30*8 + 2 = 242 bytes, and we'll lock it and keep the pointer on DP.;BuildLL	pha	pha		; space for result	lda #0		; -- 0 for NewHandle phaÕs  --rdl	pha		; size of block: high word is 0  --rdl	pea #MaxFiles*OurRecSize+2	; size of block: low word  --rdl	pei <OurID		; our user ID	pea LFNSM		; attributes	pha		; 0  --rdl	pha		; 0  --rdl; this is for Doug Davies' benefit --md	_NewHandle	bcs FatalHop1		; any error here is fatal	pullLong <DPScratch	lda [DPScratch]	sta <LLPointer	ldy #2	lda [DPScratch],y	sta <LLPointer+2		; handle now dereferenced		ldy #MaxFiles*OurRecSize	; length of handle minus two	lda #0@loop1	sta [LLPointer],y	dey	dey	bpl @loop1		; when done, the new memory block is zeroed;; Now open the directory to read.  The following commented-out code was changed 6/6/89; to hard code the directory '*:Icons' instead of using a prefixed directory - MD; Also changed storage like PrxLen from long to absolute addressing - RDL 1/10/90;OpenDir	pei <Prefix		; the prefix number (for Int2Dec);	lda #3;	sta >PfxLen		; the length;	lda #'01'		; default prefix number;	sta >PfxNum;	lda #$003A		; ":";	sta >PfxNum+2;	pushlong #PfxNum		; space for string in parameter block;	pea 2		; two bytes long;	pea 0		; unsigned;	_Int2Dec;	;	lda >PfxNum;	tay		; save a copy;	and #$00FF		; strip off second character;	cmp #$0020		; is the first character a space;	bne @NoSpace		; no, so go on;	tya 		; get the copy;	and #$FF00		; strip out old character;	ora #$0030		; or in a '0';	sta >PfxNum@NoSpace;*** added 4-Feb-92 DAL -- set sys prefs to prompt for disk if needed;	_GetSysPrefsGS oldPrefs;	lda theOldPrefs;	and #$1fff;	ora #$8000;	sta theNewPrefs;	_SetSysPrefsGS newPrefs;*** end 4-Feb-92*** 5-Oct-92 DAL -- use DoSysPrefs instead	pha		;space for old prefs	pea $E000		;bits to clear	pea $8000		;bits to set	ldx #$3f03	jsl $e10000;	_DoSysPrefs	pla	sta oldPrefs*** end 5-Oct-92	jsl GSOS	dc.w Open		; class 1 open	dc.l OpenParms		; parameter block:  *:Icons;*** added 4-Feb-92 DAL -- restore sys prefs;	php;	pha	;dang, added 11-Feb-92 DAL;	_SetSysPrefsGS oldPrefs;	pla	;dang, added 11-Feb-92 DAL;	plp;*** end 4-Feb-92*** 5-Oct-92 DAL -- restore using DoSysPrefs	php	pha	pha	;space for result	pea $ffff	;bits to clear	lda oldPrefs	pha	;bits to set	ldx #$3f03	jsl $E10000;	_DoSysPrefs	pla	;ignore old prefs	pla	plp*** end 5-Oct-92FatalHop1	bcs FatalHop		; fatal error if can't open directory		lda OpenParms+2		; the reference number for *:Icons	sta DirParms+2;; Last thing before the Big Loop - swap our prefix and prefix zero;;	lda <Prefix;	beq BigLoop		;don't work if you can avoid it	; get prefix zero into parameter block one	jsl GSOS	dc.w GetPrefix		; class one get prefix	dc.l PfxParms		; first parameter block	; now set prefix zero to our prefix	jsl GSOS	dc.w SetPrefix		; class one set prefix	dc.l SPFxParms		; second parameter block;; And here's the Big Loop!;BigLoop	jsl GSOS	dc.w GetDirEntry		; GetDirEntry (class 1)	dc.l DirParms	bcc contLoop	cmp #BufTooSmall		; just buffer too small	beq BigLoop		; go on to the next file	cmp #EndOfDir		; end of directory?	bne FatalHop	brl EndSearch		; go close the directoryFatalHop	brl FatalErrorcontLoop	lda DirFtype	cmp #OurFType	bne BigLoop		; not a file type descriptor; go on to next file;; We've got one, so add it where it goes in the list.  First,; read the file into a fixed handle and check to see if it's of proper; version, etc.  Then, create a new LL entry.;AddFile	pha	pha		; space for result	pushlong DirEOF		; length equal to length of file	pei <OurID		; our user ID	pea LFNSM		; locked+fixed+noSpecialMemory	lda #0	pha	pha		; no pointer to where	_NewHandle	bcs FatalHop		; errors here are fatal as well	pullLong <DPScratch		; pull into file temporary storage	lda [DPScratch]	sta <FileTemp	ldy #2	lda [DPScratch],y	sta <FileTemp+2		; pointer to handle is now in FileTemp	jsl GSOS	dc.w Open		; class one open on Ftype file	dc.l OpenParms2	bcs FatalHop	lda OpenParms2+2	sta ReadParms+2		; put the reference number in the read block	lda <FileTemp+2	sta ReadParms+6		; put the pointer as the read buffer	lda <FileTemp	sta ReadParms+4	lda DirEOF+2	sta ReadParms+10		; request count = file size	lda DirEOF	sta ReadParms+8	jsl GSOS	dc.w Read		; class one read of Ftype file	dc.l ReadParms	bcs FatalHop	dec OpenParms2	dec OpenParms2		; pcount = 1	jsl GSOS	dc.w Close		; class one close	dc.l OpenParms2		; same used to open it	inc OpenParms2	inc OpenParms2		; put it back to 3	lda [FileTemp]	and #$0F00		; strip out all but major version	cmp #$0100		; version 1.x?	bne SkipFile	ldy #ohFlags	lda [FileTemp],y	; get flags word;	and #$7FFF		; leave all but high bit*** changed 1-Oct-92 DAL -- allow bit 0 to be set, and 1..6 while I'm at it	and #$7f00		; skip file if any bits 14..8 are set*** end 1-Oct-92	bne SkipFile		; and skip if any of them are set 			; (records other than filetype/any auxtype)	iny	iny	lda [FileTemp],y	beq SkipFile		; skip if 0 entries in file	iny	iny	lda [FileTemp],y	; does this file have over 64K entries?	bne SkipFile		; yes, so don't use it.	bra AddListSkipFile	pha	pha		; space for result	pei <FileTemp+2	pei <FileTemp	_FindHandle	_DisposeHandle;; We're done with this one, so look at the next file;NextFile	brl BigLoop		; get the next directory entry;; Add it to the list.  First, put the TopOfIndex field in the memory block;AddList	pha	pha		; space for result	ldy #ohNumEntries	lda [FileTemp],y		; get number of entries in file	pha	ldy #ohIndRecSize	lda [FileTemp],y		; get size of each index entry	pha	_Multiply	pla	plx		; don't need high word	ldy #ohOffsetToInd	; offset to OffsetToIndex	clc	adc [FileTemp],y	ldy #ohReserved		; "reserved" word	sta [FileTemp],y		; and keep it in memory	lda [LLPointer]	inc a	sta [LLPointer]		; bump up the number of files by one		dec a		; create index (zero-based)	asl a	asl a	asl a		; multiply by eight	inc a	inc a		; and add two	tay		; we've now got our index	lda DirAuxtype	sta [LLPointer],y	lda DirAuxtype+2	iny	iny	sta [LLPointer],y	lda <FileTemp	iny	iny	sta [LLPointer],y	lda <FileTemp+2	iny	iny	sta [LLPointer],y		lda [LLPointer]	cmp #MaxFiles		; have we gone as fur as we kin go?	blt NextFile		; no, so keep looking;; We've finished the directory, so close it ;EndSearch	lda OpenParms	sta <DPScratch		; save this for a second	lda #1	sta OpenParms		jsl GSOS	dc.w Close		; class one close on directory	dc.l OpenParms		lda <DPScratch	sta OpenParms		; restore for restartableness	;; Put prefix zero back the way it was.;UnSwapPfx	jsl GSOS	dc.w SetPrefix	dc.l PfxSParms		; original is back as well;; Did we find any files at all?;	lda [LLPointer]	bne MakeList		; yes, we did	lda #NoFTypeFiles 		; a telling error number	brl FatalError		; no files in *:Icons: fatal error;; Now we bubble-sort the list so it's in descending order;MakeList	lda [LLPointer]		; get the count of files in the list	cmp #1	bne @ML1	brl DoneSort		; don't sort if only one entry@ML1	sta <ScrapWord		; and keep a work copy on DP	sta BSort		; and another in our data area	NextPass	ldy #2		; we're going to get the first pointerReSort	tya	clc	adc <LLPointer	sta <DPScratch	lda #0	adc <LLPointer+2	sta <DPScratch+2		tya	clc	adc #8	clc		; and then the second pointer	adc <LLPointer	sta <DPScratch2	lda #0	adc <LLPointer+2	sta <DPScratch2+2	Compare	ldy #0	sec	lda [DPScratch],y	sbc [DPScratch2],y	iny	iny	lda [DPScratch],y	sbc [DPScratch2],y	; at this point, carry still set means [DPScratch] was bigger than [DPScratch2],; and no swapping is necessary	bcs BumpEntries	ldy #0Swap	lda [DPScratch],y	tax	lda [DPScratch2],y	sta [DPScratch],y	txa	sta [DPScratch2],y	iny	iny	cpy #8	blt Swap	BumpEntries	dec <ScrapWord	lda <ScrapWord	cmp #1	beq BumpSort		; time to shrink and sort again	lda #8		; length of an entry	clc	adc <DPScratch	sta <DPScratch	lda #0	adc <DPScratch+2	sta <DPScratch+2		lda #8	clc	adc <DPScratch2	sta <DPScratch2	lda #0	adc <DPScratch2+2	sta <DPScratch2+2		bra Compare	BumpSort	lda BSort	dec a	sta BSort	cmp #1		; have we fully bubbled?	beq DoneSort	sta <Scrapword	bra NextPass	DoneSort	lda <LLPointer	sta >ListPtr	lda <LLPointer+2	sta >ListPtr+2;; make sure the system's filetype file (auxtype=0) was present;	lda [LLPointer]	dec a	asl a	asl a	asl a	inc a	inc a	tay	lda [LLPointer],y	iny	iny	ora [LLPointer],y	beq @auxZero	lda #NoAuxZero		; the required file isn't here!	bra FatalError@auxZero;; Now Dave says I have to set the handle size of the LLPointer list; to be as small as it can be and still retain its unique identity.;	lda [LLPointer]	asl a	asl a	asl a		; multiply by eight	inc a	inc a		; and add two - now it's the size		pea $0000	pha		; the size of the handle		pha	pha		; space for _FindHandle result		pei <LLPointer+2	pei <LLPointer		; push the pointer to the list	_FindHandle	_SetHandleSize	;; now unfutz the stack frame;	lda #0		; no errorFatalError	tax		; save the error code	lda oldStack		; restore orig stack location - rdl	tcs	pld	plb	txa	cmp #1		;set or clear the carry based on value in (A)	rtl;; Data for use by this routine;oldStack	dc.w 0	; stack pointer after futz (for FatalError)BSort	dc.w 0	; word for bubble sort's use;*** added 4-Feb-92 DAL;oldPrefs	dc.w 1;theOldPrefs	dc.w 0;;newPrefs	dc.w 1;theNewPrefs	dc.w 0;*** end 4-Feb-92oldPrefs	dc.w 0	;new for DoSysPrefs (5-Oct-92 DAL)OpenParms	dc.w 3	; parameter count	dc.w 0	; space for reference number	dc.l PfxLen	; pointer to pathname buffer	dc.w 1	; read access only, alwaysOpenParms2	dc.w 3	; parameter count	dc.w 0	; space for reference number	dc.l PathBuff2+2	; pointer to pathname buffer	dc.w 1	; read access only, always;; Ignore these labels - this is the directory we use for the files;PfxLen	dc.w 7PfxNum	dc.b '*:Icons'	; where to find our filesDirParms	dc.w 13	; 13 parameters	dc.w 0	; reference number (stored later)	dc.w 0	; flags	dc.w 1	; base	dc.w 1	; displacement	dc.l PathBuff2	; pathname buffer #2	dc.w 0	; entry numberDirFtype	dc.w 0	; filetype returnedDirEOF	dc.l 0	; EOF returned	dc.l 0	; block count returned	dc.l 0	dc.l 0	dc.l 0	dc.l 0	; create and modify dates/times	dc.w 0	; access returnedDirAuxtype	dc.l 0	; auxtype returnedPathBuff2	dc.w 36	ds.b 34	; storage for GetDirEntry names.	ReadParms	dc.w 4	dc.w 0	; reference number	dc.l 0	; buffer pointer (filled in)	dc.l 0	; request count (filled in)	dc.l 0	; transfer count (result)	PfxParms	dc.w 2	; two parameters	dc.w 0	; prefix number (always zero)	dc.l PfxBuf	; pointer to prefix buffer	Pfx2Parms	dc.w 2	dc.w 0	dc.l PfxBuf2	; storage for our prefix	PfxSParms	dc.w 2	dc.w 0	; the prefix number	dc.l PfxBuf+2	; pointer to input string	SPFxParms	dc.w 2	dc.w 0	dc.l PfxLen	; pointer to our directory	PfxBuf	dc.w 67	; maximum of sixty-three	ds.b 65	; sixty-five storage bytes (inc. count word)PfxBuf2	dc.w 67	; maximum of sixty-three	ds.b 65	; sixty-five storage bytes (inc. count word)	EndP	END