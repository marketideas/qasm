;.....................................................................;; Request.aii;; Copyright 1991-1993, Apple Computer, Inc.; All rights reserved;; by andy nicholas and Dave Lyons;;.....................................................................;; 6.1 REVISION HISTORY;; xx-Feb-92 DAL;   finderSaysIdle passes the idle ticks as dataIn.;; 24-Feb-92 DAL;   finderSaysHello dataIn has a flags word (for disabling KeyboardNav init).;   tellFinderSetSelectedIcons bit 31 now works with a nonzero pathname count.;     (In 6.0 you have to do select zero icons and then select the ones you;      really want).;   tellFinderGetSelectedIcons/tellFinderGetWindowIcons now skips the bad;      code for returning icon height and width.  (The fields are never;      stored to, but at least it doesn't access random memory.);   tellFinderSpecialPreferences now returns finderResult $0000 (it was;      returning the dragFlag value as the finderResult in 6.0);   tellFinderRemoveFromExtras(0) was removing the first menu item in the;      menu bar!  Now I validate the item to be $Exxx before removing it.;; 4-Mar-92 DAL (6.0.1d2);   tellFinderOpenWindow had a bad exit path if ExpandPath returned an error.;     It was failing to do a PLD on the way out (ka-boom).  Fixed, and even;     saved 4 bytes.;; 5-Jun-92 DAL (6.0.1d5);   Added a STZ PendingDeselectAll in tellFinderSetSelectedIcons.;; 19-Jan-93 DAL (6.0.1d13);   Added handling for srqQuit ($0011).;; 5-Mar-93 JCM (6.0.1d14);   Made tellFinderSetSelectedIcons not deselect the current icon if there is only one,;   and we're being asked to reselect it. This stops Keyboard Navigation from flickering;   when you navigate to the currently selected icon.;; 22-Mar-93 JCM (6.0.1d15);  Fixed tellFinderGetSelectedIcons (extended) to properly return the icon height and;  icon widths. Coolness has been reached. Now to fix Keyboard Nav. Thanks Dave. :-);; 29-Mar-93 JCM/DAL (6.0.1d16);  Made tellFinderLaunchThis zero out the modifiers on the Finder's direct page in case any;  random mods happend to be down when the request was made to us. ;;.....................................................................	PRINT GEN	PRINT NOSYM	PRINT NOPAGE	string asis	blanks off	include 'all.macros'	include 'special.macros'	include 'Finder.equ'	include 'DP.equ'	include 'Data.equ'	include 'E16.Finder'oldDPage	equ 1RTL1	equ 3DataOut	equ 6DataIn	equ 10Request	equ 14Result	equ 16;.....................................................................;; Get the SendRequest stuff, process it;.....................................................................requestProc	procname export	IMPORT finderDPage	IMPORT tFinderDebug	IMPORT tFinderAreYouThere	IMPORT tFinderOpenWindow	IMPORT tFinderCloseWindow	IMPORT tFinderGetSelectedIcons	IMPORT tFinderSetSelectedIcons	IMPORT tFinderLaunchThis	IMPORT tFinderShutDown	IMPORT tFinderEmptyTrash	IMPORT tFinderPutInTrash	IMPORT tFinderPutOnDesktop	IMPORT tFinderAddBundle	IMPORT tFinderInformOfChange	IMPORT tFinderCleanUp	IMPORT tFinderColorSelection	IMPORT tFinderAddToExtras	IMPORT tFinderAddDesktopIcon	IMPORT tFinderIdleHowLong	import tFinderGetWindowIcons	import tFinderGetWindowInfo	import tFinderRemoveFromExtras	import tFinderAdjustHelpTopics	import tFinderSelectMItem	import allowTellFinderCalls	import tFinderMatchFileToIcon	import tFinderCheckDatabase	import tFinderSpecialPreferences	import NewDeskPatFlag	phd	tsc	tcd	phb	phk	plb	lda <dataIn+2		;set bit31 negative if it's set	tax	and #$8000	sta bit31	txa;;;	and #$7fff	asl a	lsr a	sta <dataIn+2	lda <Request	bpl @notFinderSpecific	cmp #tellFinderGetDebugInfo	beq @noTest	cmp #tellFinderIdleHowLong	beq @noTest		ldx allowTellFinderCalls	bne @noTest		lda #fErrBusy	clc	bra @exit@noTest	asl a		;isn't that cool, bit 15 dies!	tax	cpx #reqHandlersEnd-reqHandlers	bcs @exit	jsr PreserveImportantStuff	;doesn't mess up A/X/P	jsr (reqHandlers,x)	jsr RestoreImportantStuff	;doesn't mess up A/X/P;; We come back from the request handler with;;  SEC = we didn't handle the request;  CLC = we handled it;        A = error code (zero if no problem);@exit	bcs @bogus		;we couldn't handle it	ldy #2		;offset to finderError field	sta [dataOut],y	lda #$8000	sta <Result	bra @leaving;; Handle request codes in the global range ($0001..7FFF);; $0008 is systemSaysNewDeskMessage (there is a new desktop pattern/pic);@notFinderSpecific	cmp #8	;systemSaysNewDeskMsg	bne @notNewDeskMsg	lda #$ffff	sta >NewDeskPatFlag	lda #$8000	sta <Result	bra @leaving	;added 19-Jan-93 DAL@notNewDeskMsg*** added 19-Jan-93 DAL	import handleQuit	cmp #$0011	;srqQuit	bne @notQuit	jsr handleQuit	lda #$8000	sta <Result@notQuit*** end 19-Jan-93@leaving@bogus	plb	pld	lda 2,s	sta 12,s	lda 1,s	sta 11,s	ply	ply	ply	ply	ply	rtl;; PreserveImportantStuff -- save the resource app and menu bar;   (on stack, under RTS addr);PreserveImportantStuff	sta theAvalue	stx theXvalue	php	php	pla	sta thePvalue	pla	sta theRTSaddr	pha	_GetCurResourceApp	pha	pha	_GetMenuBar	pha	_MMStartUp	_SetCurResourceApp	ldx #0	phx	phx	_SetMenuBar	lda theRTSaddr	pha	lda thePvalue	pha	lda theAvalue	ldx theXvalue	plp	plp	rts;; RestoreImportantStuff -- restore the resource app and menu bar;   (data is on stack under RTS addr);RestoreImportantStuff	sta theAvalue	stx theXvalue	php	php	pla	sta thePvalue	pla	sta theRTSaddr	_SetMenuBar	_SetCurResourceApp	lda theRTSaddr	pha	lda thePvalue	pha	lda theAvalue	ldx theXvalue	plp	plp	rtstheRTSaddr	dc.w 0theAvalue	dc.w 0theXvalue	dc.w 0thePvalue	dc.w 0	EXPORT bit31bit31	dc.w 0reqHandlers	dc.w tFinderDebug		;$8000	dc.w tFinderAreYouThere	;$8001	dc.w tFinderOpenWindow	;$8002	dc.w tFinderCloseWindow	;$8003	dc.w tFinderGetSelectedIcons	;$8004	dc.w tFinderSetSelectedIcons	;$8005	dc.w tFinderLaunchThis	;$8006	dc.w tFinderShutDown	;$8007	dc.w tFinderSelectMItem	;$8008	dc.w tFinderAreYouThere	;$8009 (instead of tFinderLoadBundle)	dc.w tFinderMatchFileToIcon	;$800A	dc.w tFinderAddBundle	;$800B	dc.w tFinderInformOfChange	;$800C	dc.w tFinderCheckDatabase	;$800D	dc.w tFinderColorSelection	;$800E	dc.w tFinderAddToExtras	;$800F	dc.w tFinderAddDesktopIcon	;$8010 (not in 6.0)	dc.w tFinderIdleHowLong	;$8011	dc.w tFinderGetWindowIcons	;$8012	dc.w tFinderGetWindowInfo	;$8013	dc.w tFinderRemoveFromExtras	;$8014	dc.w tFinderSpecialPreferences	;$8015;	dc.w tFinderAdjustHelpTopics	;$8016 (not in 6.0)reqHandlersEnd	EndP;.....................................................................;; tFinderDebug -- get debug information;.....................................................................tFinderDebug	procname	IMPORT finderDPage	IMPORT StartOfDebugInfo	IMPORT EndOfDebugInfo	ldy #4	lda #9	sta [dataOut],y	ldy #6	lda >finderDPage	tax	sta [dataOut],y	iny	iny	lda >deskic,x	sta [dataOut],y	lda >deskic+2,x	iny	iny	sta [dataOut],y	ldx #0		;copy the major chain lists out@loop	iny	iny	lda >StartofDebugInfo,x	sta [dataOut],y	inx	inx	cpx #EndOfDebugInfo-StartOfDebugInfo	blt @loop	clc	lda #0		;no problem	rts	EndP;.....................................................................;; tFinderAreYouThere() -- tell the requestor that the Finder is awake;.....................................................................tFinderAreYouThere	procname	clc	lda #0		;no problem	rts	EndP;.....................................................................;; tFinderOpenWindow() -- open a window given a full pathname from dataIn;; dataIn = pathname of window to open;; dataOut:;  +000 = recvCount;  +002 = finder result;  +004 = window pointer (long);.....................................................................tFinderOpenWindow	procname	IMPORT frqOpen	IMPORT WStringCopy	IMPORT finderDPage	import frqGlobalError	import OpenTheTrashCan	import ShowClipMenu	import AboutMenu	import lockic	import unlockic	import OpenFlag	import CheckMenus	phd	lda <dataIn	sta expandParms+2	lda <dataIn+2	sta expandParms+4	pushzlong <dataIn	pushlong #c1_pathname	jsl WStringCopy		lda >finderDPage	tcd	stz modifiers		;so that they don't accidently tunnel	stz OpenFlag	lda #0	sta >frqGlobalError;; need to check for "Trash", "Clip", and "About";	jsr OpenSpecialWindow	bcc @success	_ExpandPathGS expandParms	bcc @goodExpand	sta >frqGlobalError	bra @exit@goodExpand	lda >c1_pathname		;see if they have a null pathname	bne @havePath	lda #fErrBadInput	sta >frqGlobalError	bra @success	@havePath	lda #1		;tell it to ignore errors and NOT prompt for disk insertions	sta OpenFlag	pushzlong <curWind	jsr frqOpen		;open C1_PathName to be new front window	pla	sta <curWind	pla	sta <curWind+2	stz OpenFlag@success	jsr CheckMenus@exit	pld	ldx #0	txy		;anticipate NIL window pointer	lda >frqGlobalError	bne @returnWindPtr	pha	pha	_FrontWindow	ply	plx		;windPtr in XY@returnWindPtr	tya		;windPtr in XA	ldy #4	sta [<dataOut],y	iny	iny	txa	sta [<dataOut],y	clc	lda >frqGlobalError	rts;; expandParms -- always, always, always expand the pathname we're working with before sending;                stuff to the Finder!;expandParms	dc.w 3	dc.L 0	dc.L c1_pathname-2	dc.w 0;; OpenSpecialWindow;; Input: C1_PathName;        Finder direct page is set; Output: CLC if we opened a special window;OpenSpecialWindow; check for Trash	lda C1_Pathname	cmp #5	;length of Trash and About	bne @checkClip	lda C1_PathName+2	cmp #$7254	;"Tr"	bne @notTrash	lda C1_PathName+4	cmp #$7361	;"as"	bne @notTrash	lda C1_PathName+5	cmp #$6873	;"sh"	bne @notTrash; open trash	lda >TrashIc+2	sta <icHand+2	lda >TrashIc	sta <icHand	jsr lockic	jsr OpenTheTrashCan	jsr unlockic	clc	rts@notTrash	lda C1_PathName+2	cmp #$6241	;"Ab"	bne @notAbout	lda C1_PathName+4	cmp #$756F	;"ou"	bne @notAbout	lda C1_PathName+5	cmp #$7475	"ut"	bne @notAbout; open About window	jsr AboutMenu	clc	rts@notAbout@checkClip	lda C1_PathName	cmp #4	bne @notClip	lda C1_PathName+2	cmp #$6C43	;"Cl"	bne @notClip	lda C1_PathName+4	cmp #$7069	;"ip"	bne @notClip; open clipboard	jsr ShowClipMenu	clc	rts@notClip@notSpecial	sec	rts	EndP;.....................................................................;; tFinderCloseWindow(pathnamePtr/4);.....................................................................tFinderCloseWindow	procname	IMPORT doClose	IMPORT finderDPage	IMPORT matchWindName	IMPORT walkWindow	IMPORT WStringCopy	import aboutWindowPtr	import DeselectAll	import CheckMenus	pushzlong <dataIn	pushlong #C1_TempPath	jsl WStringCopy	ldx <dataIn	ldy <dataIn+2	phd	lda >finderDPage	tcd	pushZLong <taskData		;save everything	pushZLong <wind	stx closeExpandParms+2	;was dataIn	sty closeExpandParms+4	;was dataIn+2	jsr DeselectAll		;calls SelectionIsChanging;; check for special window names: Trash/Clip/About;	jsr CloseSpecialWindow	bcc @success	_ExpandPathGS closeExpandParms	tax	bcs @nothing	lda #DirWindID		;Directory windows only.	ldx #matchWindName		;Check for against C1_TempPath	jsr walkWindow	ldx #frqErrFailed	bcc @nothing		;we didn't match squat, so don't do squat	lda <wind	sta <taskData	lda <wind+2	sta <taskdata+2	jsr doClose		;hope that this doesn't change much...@success	jsr CheckMenus	ldx #frqErrNoError@nothing	pulllong <wind	pulllong <taskdata	pld	clc		;handled the request	txa		;error code	rts;; closeExpandParms -- always, always, always expand the pathname we're working with before sending;                stuff to the Finder!;closeExpandParms	dc.w 3	dc.L 0	dc.L c1_temppath-2	dc.w 0;; CloseSpecialWindow;; Input: window name in C1_TempPath;        Finder direct page is set; Output: CLC if we closed a special window;CloseSpecialWindow; check for Trash	lda C1_TempPath	cmp #5	;length of Trash and About	bne @checkClip	lda C1_TempPath+2	cmp #$7254	;"Tr"	bne @notTrash	lda C1_TempPath+4	cmp #$7361	;"as"	bne @notTrash	lda C1_TempPath+5	cmp #$6873	;"sh"	bne @notTrash; close trash	lda <trashWind+2	ldx <trashWind; closeAX -- close window in AX, if it's visible@closeAX	sta <taskData+2	stx <taskData	pha	;space for GetWFrame	pha	phx	;window pointer	_GetWFrame	pla	and #$0020	bne @canClose	;it's visible!	sec	rts@canClose	jsr doClose	clc	rts@notTrash	lda C1_TempPath+2	cmp #$6241	;"Ab"	bne @notAbout	lda C1_TempPath+4	cmp #$756F	;"ou"	bne @notAbout	lda C1_TempPath+5	cmp #$7475	"ut"	bne @notAbout; close About window	lda >aboutWindowPtr+1	bne @isOpen	clc	rts@isOpen	lda >aboutWindowPtr	tax	lda >aboutWindowPtr+2	bra @closeAX@notAbout@checkClip	lda C1_TempPath	cmp #4	bne @notClip	lda C1_TempPath+2	cmp #$6C43	;"Cl"	bne @notClip	lda C1_TempPath+4	cmp #$7069	;"ip"	bne @notClip; close clipboard;	lda <clipWind+2;	ldx <clipWind;	bra @closeAX*** changed 19-Aug-92 DAL -- clipboard window is now done with Scrap Manager	pha	pha	pea $4000	;flag to close clipboard	pei <zero	pei <zero;	_ShowClipboard	ldx #$1516	jsl $e10000	pla	pla	clc	rts*** end 19-Aug-92@notClip@notSpecial	sec	rts	EndP;.....................................................................;; tFinderGetSelectedIcons -- get the selected icons from the current port;	as output we specify the full paths of all the selected;	icons.;; dataOut:;  +000 = recvCount;  +002 = finderResult;  +004 = pointer to window, NIL for desktop;  +008 = new stringList handle;; StringList format:;  +000 = number of pathnames following;  +002 = wString1;  +xxx = wString2;  +xxx = ...;; Extended StringList format:;  +000 = number of pathnames following;  +002 = Offset to WString1 (Offset from start of record);  +004 = y coordinate of icon;  +006 = x coordinate of icon;  +008 = y coordinate of icon's text if list view;  +xxx = wString1;  +xxx = Offset to wString2 (offset from start of this record);  +xxx = y coordinate of icon;  +xxx = x coordinate of icon;  +xxx = y coordinate of icon's text if list view;  +xxx = wString1;.....................................................................tFinderGetSelectedIcons procname	import FinderDPage	import allocate	import FindSelect	import buildpath3	import bit31	import getIconPtr	;22-Mar-93 JCM	import UnlockICBLKHAND ;22-Mar-93 JCM	phd	lda >FinderDPage	tcd	lda #2	jsr allocate	stx <temp+2	sta <temp; set the string count to zero	ldy #2	lda [<temp],y	sta <work+2	lda [<temp]	sta <work	lda #0	sta [<work]	lda #addToHandle	jsr FindSelect	lda <temp	ldx <temp+2	;new handle in XA	pld	ldy #8	sta [<dataOut],y	iny	iny	txa	sta [<dataOut],y; anticipate that the icons were on the desktop	ldy #4	lda #0	sta [<dataOut],y	iny	iny	sta [<dataOut],y; see if Finder's <curWind = <deskPort.  If not, return the window pointer.	lda >FinderDPage	tax	lda >curWind,x	cmp >deskPort,x	bne @returnWindow	lda >curWind+2,x	cmp >deskPort+2,x	beq @isDesktop@returnWindow	lda >curWind,x	ldy #4	sta [<dataOut],y	iny	iny	lda >curWind+2,x	sta [<dataOut],y@isDesktop	clc	lda #0	rts** addToHandle** Input:*   ic = selected icon*   temp = handle to strings*	export addToHandleaddToHandle	pushZLong <temp	jsr buildPath3		;input=ic, output=C1_Pathname; if the icon is the trash or an Extension, kill the leading ":"	ldy #icFType	lda [<ic],y	cmp #TypeTrash	beq @killColon	cmp #TypeFTrash	beq @killColon	cmp #TypeExtension	bne @noKill@killColon	pushlong #C1_Pathname+3	pushlong #C1_Pathname+2	pea 0	lda C1_Pathname	pha	_BlockMove	dec C1_Pathname	bra @continue@noKill; if the icon is a 5.25 drive, change the ":" to a "."	ldy #icFType	lda [<ic],y	cmp #TypeFDrive	bne @continue	lda #$2e	;'.'	sep #$20	sta C1_Pathname+2	rep #$20@continue	pha	pha	pei <temp+2	pei <temp	_GetHandleSize	pla	plx	stx old_size+2	sta old_size	clc	adc C1_Pathname	bcc @1	inx@1	clc	adc #2	bcc @2	inx	@2	bit bit31	;are we using an extended stringlist?	bpl @3	;if not, then don't add 16	clc	adc #16	bcc @3	inx	@3	phx	pha	pei <temp+2	pei <temp	_SetHandleSize	ldy #2	lda [<temp],y	sta <work+2	lda [<temp]	sta <work	lda [<work]	inc a	sta [<work]	pushlong #C1_Pathname		bit bit31	bmi @coordinates		clc	lda <work	adc old_size	tax	lda <work+2	adc old_size+2	brl @move	@coordinates	clc	;put coordinates in extended stringlist handle	lda <work	adc old_size	sta <work	lda <work+2	adc old_size+2	sta <work+2		lda #16	;offset to wstring is 16	sta [<work]		ldy #icy	;icy	lda [<ic],y	ldy #2	sta [<work],y		ldy #icx	;icx	lda [<ic],y	ldy #4	sta [<work],y		ldy #icTextY	;icTextY	lda [<ic],y	ldy #6	sta [<work],y*** THE FOLLOWING CODE IS IN 6.0, AND IT'S TOAST.  The icon handle is not*** stored at icIcon (the index number is).  KeyboardNav init for 6.0 patches*** this to be:***    ldy #10***    bra @goodCode (offset $3F);	ldy #icIcon	;get the icon handle;	lda [<ic],y;	sta <temp;	iny;	iny;	lda [<ic],y;	sta <temp+2;;	ldy #windView;	lda [<windBlk],y;	cmp #viewByName;	blt @byIcon;;	ldy #icSmallIcon	;get the small icon handle;	lda [<ic],y;	sta <temp;	iny;	iny;	lda [<ic],y;	sta <temp+2;@byIcon;;	lda [<temp]	;dereference it;	tax;	ldy #2;	lda [<temp],y;	sta <temp+2;	stx <temp;	;	ldy #4	;get the icon height;	lda [<temp],y;	ldy #8;	sta [<work],y;	;	ldy #6	;get the icon width;	lda [<temp],y;	ldy #10;	sta [<work],y;;@goodCode*** end of bad 6.0 code*** will fix this for real later -- for now, don't trash memory (24-Feb-92 DAL)*** (the iconHeight and iconWidth fields are not set);;;	ldy #10	;21-Mar-93 JCM - fixed below*** end of temp fix*** Added - 21-Mar-93 JCM - Let's really return the icon height and width.	ldx #0	;assume big icon view	ldy #windView	lda [<windBlk],y	cmp #viewBySmallIcon	blt @byIcon		inx	;nope, we want the small one@byIcon	txa	;0 = get big icon, 1 = small	jsr getIconPtr	;get ptr to locked icon data in <icon	jsr UnlockICBLKHAND	;no need to keep it locked* The iconHeight is at +4 and the iconWidth is at +6.	ldy #4	;get the icon height	lda [<icon],y	ldy #8	sta [<work],y		dey	;get the icon width (+6)	dey	lda [<icon],y	ldy #10	sta [<work],y*** End - 21-Mar-93 JCM	iny	;save the icon record's handle	iny	lda <icHand	sta [<work],y	iny	iny	lda <icHand+2	sta [<work],y		lda <work	;add 16 onto where we want the pathname moved	clc	adc #16	tax	lda <work+2	adc #0	@move	pha	phx	pea 0	lda C1_Pathname	clc	adc #2	pha	_BlockMove	pulllong <temp	rtsold_size	dc.l 0	EndP;.....................................................................;; tFinderGetWindowIcons --;.....................................................................tFinderGetWindowIcons procname	import FinderDPage	import allocate	import walkOfLife	import addToHandle	ldy <dataIn+2	ldx <dataIn	;YX = window pointer (dataIn)	phd	lda >FinderDPage	tcd; preserve curWind	pei <curWind+2	pei <curWind; set curWind to input pointer (translate NIL into deskPort)	txa	bne @notDesktop	tya	bne @notDesktop	ldy <deskPort+2	ldx <deskPort@notDesktop	sty <curWind+2	stx <curWind; allocate StringList handle holding zero strings (just a word of zero)	lda #2	jsr allocate	stx <temp+2	sta <temp; set the string count to zero	ldy #2	lda [<temp],y	sta <work+2	lda [<temp]	sta <work	lda #0	sta [<work]	lda #addToHandle	jsr walkOfLife; restore curWind	pla	sta <curWind	pla	sta <curWind+2; return new handle	lda <temp	ldx <temp+2	;new handle in XA	pld	ldy #4	;offset to result handle	sta [<dataOut],y	iny	iny	txa	sta [<dataOut],y	lda #0	clc	rts	EndP;.....................................................................;; tFinderSetSelectedIcons -- set the selected icons for a given window;; dataIn = StringList handle of icons to select;; uses: c1_tempPath;       c1_filename;.....................................................................tFinderSetSelectedIcons procname	import FinderDPage,DeselectAll,CheckMenus	import wstringcopy	import pathSubName	import walkwindow	import wstrcompare	import pathgetname	import pstringcompare	import walkOfLife	import windRefCon	import drawIcon2	import startDraw	import endDraw	import drawIconState	import selectionIsChanging	import PendingDeselectAll	import ckRects	;5-Mar-93 JCM - for counting selected icons	stz PendingDeselectAll  ;5-Jun-92 DAL	stz DidDeselectFlag	;5-Mar-93 JCM	stz iconSelected	;5-Mar-93 JCM	jsl selectionIsChanging	ldy #4	;lock the stringlist handle	lda [<dataIn],y	ora #$8000	sta [<dataIn],y	ldx <dataIn	ldy <dataIn+2	phd	lda >FinderDPage	tcd	sty <temp+2	stx <temp		lda <temp+1	beq @deselect		ldy #2	lda [<temp],y	tax	lda [<temp]	sta <temp	stx <temp+2	lda [<temp]	sta strings	sta strings2	;5-Mar-93 JCM - this one isn't a decremented counter	bne @select	@deselect	jsr deselect	brl done;; We have some icons, so first find the window for the first icon in the stringList;@select	lda bit31	bpl @noDeselect		*** Added - 5-Mar-93 JCM - This hack helps to not reselect an icon if it's the only***	       one selected and we're being asked to select it again.***	       This is helpful for Keyboard Navigation when you type a***	       series of keys within the tick limit which cause the same icon***	       to be reselected. This puts an end to the flashing you would***	       see.	lda strings	;number of icons they want us to select	dec a	;do they want a single icon to be selected?	bne @select2	; nope, don't do anything different this time		lda #ckRects	;count the number of selected icons in this plane	jsr walkOfLife	;if there are more than 1, deselect them all first	lda iconSelected	;how many are selected?			dec a		beq @noDeselect	; only 1, so defer the deselection for now	lda #1	tsb DidDeselectFlag ;we deselected more than one icon here@select2	jsr deselect*** End - 5-Mar-93 JCM@noDeselect			lda <temp	clc	adc #2	sta <ptr	lda <temp+2	adc #0	sta <ptr+2;; every time through this loop, look through all the icons on the desktop and see ; if we have a match against our pathname;nextPathLoop	pushZLong <curWind	lda <deskPort	sta <curWind	lda <deskPort+2	sta <curWind+2		lda #setDeskIcon	jsr WalkofLife	pulllong <curWind	bcc lookAtWindows	;didn't find it on the desktop		lda <deskPort	cmp <curWind	bne @deselect	lda <deskPort+2	cmp <curWind+2	beq @goNextpath@deselect	jsr deselect	;deselect everything in the current plane before		;setting the current window to the desktop	lda <deskPort		sta <curWind	lda <deskPort+2	sta <curWind+2	@goNextPath	brl nextPath	;; every time through this loop, look through all the open windows and see if we have a match; against our pathname;lookAtWindows	lda [<ptr]	pha		pushZLong <ptr	jsl PathSubName		lda [<ptr]	cmp 1,s	bne @notDisk	clc	bra @diskIcon	@notDisk	lda #DirWindID	;Type of windows to accept.	ldx #matchWindow	;Match windows' pathname to C1_TempPath.	jsr walkWindow@diskIcon	pla	sta [<ptr]		bcc nextPath	;Was an owner window found?  if not, next path please...		;; found owner window, set all the icons in the list to ON;inWindow	pushZLong <curWind	lda <wind	sta <curWind	ldx <wind+2	stx <curWind+2		pushlong #c1_filename	pushZLong <ptr	jsl PathGetName		lda >c1_filename	;make the end segment a pstr	xba	sta >c1_filename			lda #setWindowIcon	;turn the icon ON and draw it ON	jsr walkOfLife	;if it didn't draw it, too bad...		pulllong <curWind	bcc nextPath		lda <wind	cmp <curWind	bne @deselect	lda <wind+2	cmp <curWind+2	beq nextPath@deselect	jsr deselect	;calls SelectionIsChanging	lda <wind	sta <curWind	lda <wind+2	sta <curWind+2	;; go to the next pathname in the stringList;nextPath	lda [<ptr]	inc a	inc a	clc	adc <ptr	sta <ptr	bcc @1	inc <ptr+2@1		dec strings	beq done	brl nextPathLoop	;; whoopee!  we're done setting (or not) all the icons;done	*** Added - 5-Mar-93 JCM - If someone asks us to select a single icon, but we can't find***	       it, we need to make sure we deselect the icon if they allow us***	       to deselect them. In that case, we wouldn't have already done***	       the deselection.	lda bit31	bpl @fixMenus		lda DidDeselectFlag ;did we match any icons to select?	bmi @fixMenus	; yep, so don't deselect here	jsr deselect	;make sure we behave just like 6.0@fixMenus*** End - 5-Mar-93 JCM	jsr CheckMenus	clc	lda #frqErrNoError	pld	rts;; deselect everything, but preserve <wind!;deselect	pushZLong <ic	;5-Mar-93 JCM	pushZLong <icHand	;5-Mar-93 JCM	pushZLong <wind	pushZLong <temp	;24-Feb-92 DAL for 6.1	jsr deselectAll	pulllong <temp	;24-Feb-92 DAL for 6.1	pulllong <wind	pulllong <icHand	;5-Mar-93 JCM	pulllong <ic	;5-Mar-93 JCM	rts;; IN: wind = window to compare;     <ptr = wstring pathname to compare;matchWindow					jsr windRefCon	;windBlk = window's info block pointer.	lda <windBlk	clc	adc #windPath	ldx <windBlk+2	bcc @nr	inx@nr	pha				;space for result	phx				;ptr to 1st string	pha	pushZlong <ptr 	;ptr to 2nd string	jsl WStrCompare	pla				;result (0 or 1)	cmp #1	rts;; see if the icon pointed to by <ic matches our pstring at <ptr2;setWindowIcon	pha	lda <ic	clc	adc #<icName	tax	lda <ic+2	adc #0	pha	phx	pushlong #c1_filename+1	jsl PStringCompare	pla	bne setIcon	clc	rts		IMPORT cutIconToHeadsetIcon	lda #$8000	;5-Mar-93 JCM	tsb DidDeselectFlag	;5-Mar-93 JCM		ldy #icFlag	lda [<ic],y	and #icSelected	bne @done	*** Added - 5-Mar-93 JCM - This stops keyboard navigation flicker if the same icon is to be***	       reselected.	@doSingleIconStuff	lda strings2	;how many icons are we to select?	dec a	;only one?	bne @setIt	; nope, we've already deselected the icons	lda DidDeselectFlag	;have we already deselected the old icons?	and #1	bne @setIt		jsr deselect	lda #1	tsb DidDeselectFlag	ldy #icFlag@setIt*** End - 5-Mar-93 JCM		lda [<ic],y	ora #icSelected	sta [<ic],y		jsr DrawIconState		jsr cutIconToHead	@done	sec	rts;; see if the desktop icon pointed to by <ic matches our wstring at <ptr2;setDeskIcon	ldy #icFlag	;if we're walking the desktop icons, and 	lda [<ic],y	;we're not extended, see if we're a disk name or device	and #icExtended	beq  @notExtended;; we'll take a look at this extended icon;	ldy #2	  	lda [<ptr],y	and #$00ff	cmp #'.'	;no extended icon can match a disk device	beq @done	cmp #':'	bne @done		pushlong #c1_filename ;get the last section of the pathname	pushZLong <ptr	jsl PathGetName		lda >c1_filename	;make it a pstr	xba	sta >c1_filename		pha	;compare the name of the icon and the last portion of	pushlong #c1_filename+1 ;our pathname segment	lda <ic	clc	adc #icName	tax	lda <ic+2	adc #0	pha	phx	jsl PStringCompare	pla	;if the name of the icon and last segment of our pathname	beq @done	;don't match, then don't select this		lda [<ptr]	;save our path's length	pha		pushZLong <ptr	;remove last pathname segment	jsl PathSubName		lda [<ptr]	;see if we were actually able to remove the segment	cmp 1,s	bne @havePath	;if we were, then compare the owner path and our path	pla	sta [<ptr]	bra @done@havePath	pha	lda <ic	clc	adc #<icOwner	tax	lda <ic+2	adc #0	pha	phx	pushZLong <ptr	jsl WStrCompare	plx		pla	sta [<ptr]		txa	beq @done	brl seticon	@done	clc	rts;; take a look at this non-extended icon;@notExtended	ldy #2  	lda [<ptr],y	and #$00ff	cmp #'.'	;if it's something that begins with a dot "." then it's	beq @device	;probably an AppleDisk 5.25	cmp #':'	bne @notDisk		lda [<ptr]	;see if we can remove a segment from this pathname	pha		pushZLong <ptr	jsl pathSubName		pla		cmp [<ptr]	sta [<ptr]	;if we can remove a segment, it's NOT a volume name	bne @done@device	lda [<ptr]	dec a	xba	ldy #1	sta [<ptr],y	pha	;compare our icon+icName against a manufactured	lda <ic	;pstring at [<ptr]+2	clc	adc #<icName	tax	lda <ic+2	adc #0	pha	phx	lda <ptr	ldx <ptr+2	clc	adc #2	bne @nr	inx@nr	phx	pha	jsl PStringCompare		ldy #1	;restore the beginning of our string	lda [<ptr],y	xba	inc a	sta [<ptr]	xba	and #$00ff	ora #$3a00	sta [<ptr],y		pla	beq @done	brl setIcon@notDisk	lda [<ptr]	;make a pstring	xba	sta [<ptr]		pha	;compare our icon+icName against a manufactured	lda <ic	;pstring at [<ptr]+1	clc	adc #<icName	tax	lda <ic+2	adc #0	pha	phx	lda <ptr	ldx <ptr+2	inc a	bne @nr2	inx@nr2	phx	pha	jsl PStringCompare		lda [<ptr]	xba	sta [<ptr]		pla	beq @done2	brl setIcon@done2	clc	rts		;; locals;strings	dc.w 0strings2	dc.w 0	;5-Mar-93 JCMDidDeselectFlag	dc.w 0	;5-Mar-93 JCM	EndP;.....................................................................;; tFinderLaunchThis -- launch a document or an app;;	input parm block consists of a word (0=launch, 1=print);	followed by a pointer to the pathname we want to launch;.....................................................................tFinderLaunchThis	procname	IMPORT  quit_flags	IMPORT WStringCopy	IMPORT info_type	import doGetFileInfo	import srqOpenParms	import srqIconHandle	import srqTheRect	import srqFiletype	import srqAuxtype	import srqPrintFlag	import info_aux	import srqModifiers	import CheckFST	import finderDPage	;29-Mar-93 JCM*** Added - 29-Mar-93 JCM - Make sure the mods are zero.	lda >finderDPage	tax	lda #0	sta >modifiers,x*** End - 29-Mar-93 JCM	ldy #4	lda [<dataIn],y	pha	dey	dey	lda [<dataIn],y	pha	pushlong #C1_QuitName	jsl WStringCopy	_ExpandPathGS expandParms ;both expand it and...	bcc @expandOK@goDone	brl @done@expandOK	jsr doGetFileInfo	;check to see if it's really there	bcs @goDone		lda #$005c	;not system file GSOS error	ldx info_type	cpx #$FF	beq @launch	cpx #$B3	beq @launch	cpx #$B5	bne @done@launch	jsr CheckFST	bcs @done			lda info_type			sta srqFiletype	lda info_aux			sta srqAuxtype	lda info_aux+2			sta srqAuxtype+2	stz srqIconHandle	stz srqIconHandle+2	stz srqPrintFlag	stz srqModifiers		ldx #6@rLoop	stz srqTheRect,x	dex	dex	bpl @rLoop	pea $0104	;finderSaysBeforeOpen	ldx #0	pea $8000	;how = send to first guy who accepts it	phx	phx				;target = nil	pushlong #srqOpenParms	phx	phx				;dataOut = nil	_SendRequest	bcs @goLaunch		lda #0	rts@goLaunch	pushlong #c1_pathname	pushlong #c1_quitname	jsl WStringCopy	lda #C1_QuitName	;tell it to launch from here	sta quit_path	lda #C1_QuitName>>16	sta quit_path+2	lda #$c000	sta quit_flags	lda #0	;no problem@done	clc	;moved CLC here 19-Aug-91 DAL, because we want to	rts	;handle the request even though there was an error;; expandParms -- always, always, always expand the pathname we're working with before sending;                stuff to the Finder!;expandParms	dc.w 3	dc.L c1_quitname	dc.L c1_pathname-2	dc.w 0	EndP;.....................................................................;; tFinderShutDown -- dataIn was 0, 1, or 2;.....................................................................tFinderShutDown	procname	IMPORT quit_path	IMPORT quit_flags	lda <dataIn	beq sdTurnOff	cmp #1	beq sdRestart	cmp #2	bne sdBogus;; just tell the main event loop to quit;	export handleQuithandleQuit@quit	lda #$c000	sta quit_flags	bra sdDone;; tell the main event loop to restart;sdRestart	lda #$c003	sta quit_flags	bra sdDone;; tell the main event loop to shut off the system power (if it could);sdTurnOff	lda #$C001	sta quit_flagssdDone	stz quit_path	stz quit_path+2	clc	lda #0		;no problem	rtssdBogus	clc	lda #frqErrBadInput	rts	EndP; tFinderCheckDatabase;.....................................................................tFinderCheckDatabase procname	import QueryDatabase	pha	pha	ldy #0@loop	lda [<dataIn],y	pha	iny	iny	cpy #10	blt @loop		jsl QueryDatabase	pla	ldy #4	sta [<dataOut],y	plx		clc		;handled the request	rts	EndP; tFinderMatchFileToIcon;; +000 Word	pcount (11), minimum of 10; +002 Word	Voting bits (4-7) we want ($8000 = donÕt care); +004 Word	Which match we want (1 or higher); +006 Word	filetype; +008 Long	auxtype; +012 Long	pointer to filename to match against; +016 Long	pointer to create date/time, GS/OS format; +020 Long	pointer to mod date/time, GS/OS format; +024 Word	local access word; +026 Word	flags, bit 15 = extended file, all other bits reserved; +028 Long	pointer to  option_list or NIL; +032 Long	Combined (resource and data fork) EOF;.....................................................................tFinderMatchFileToIcon procname	import MatchFileToIcon		ldx #fErrBadInput		lda [<dataIn]	cmp #12	bge @bogus	cmp #10	blt @bogus		tsc	sec	sbc #20		;put 5 longs on the stack	tcs	ldy #2@stuff	lda [<dataIn],y	pha	iny	iny	cpy #32	blt @stuff	lda [<dataIn]	cmp #11	blt @min		lda [<dataIn],y	pha	iny	iny	lda [<dataIn],y	pha	bra @match@min	pea 0	pea 0	@match	jsl MatchFileToIcon	ldy #4@pull	pla	sta [<dataOut],y	iny	iny	cpy #24	blt @pull	ldx #frqErrNoError		;error code@bogus	txa	clc		;handled the request	rts	EndP	;.....................................................................;; tFinderAddBundle -- tell the finder to examine the contents of the path and;	  add to memory or desktop as necessary;; dataIn = +000 bit 15 = add to desktop, bit 14 = add to memory;          +002 ptr to source pathname;          +006 ptr to dest pathname;          +010 rBundle ID to get;.....................................................................tFinderAddBundle 	procname	import UpdateWindow		;input=<wind	IMPORT finderDPage	IMPORT matchWindName	IMPORT walkWindow	IMPORT WStringCopy	IMPORT AddBundle2Desktop	ldy #2		;expand the source pathname	lda [<dataIn],y	sta expandSource+2	iny	iny	lda [<dataIn],y	sta expandSource+4		_ExpandPathGS expandSource	tax	bcs @nothing	ldy #6		;expand the destination pathname	lda [<dataIn],y	sta expandDest+2	iny	iny	lda [<dataIn],y	sta expandDest+4		lda #MaxPathLen+MaxFileName+4	sta c1_temppath-2		_ExpandPathGS expandDest	tax	bcs @nothing	pha	pea $8000		;always update link if possible	ldy #12	lda [<dataIn],y	pha	dey	dey	lda [<dataIn],y	pha	pushlong #c1_temppath	pushlong #c1_pathname	jsl AddBundle2Desktop	plx	bne @nothing	ldx #frqErrNoError@nothing	clc		;handled the request	txa		;error code	rts;; expandParms -- always, always, always expand the pathname we're working with before sending;                stuff to the Finder Dave!  The Dave-man, D-D-D-Dave!, Daverino!;expandSource	dc.w 3	dc.L 0	dc.L c1_pathname-2	dc.w 0	expandDest	dc.w 3	dc.L 0	dc.L c1_temppath-2	dc.w 0	EndP;.....................................................................;; tFinderInformOfChange -- tell the finder that the xxx path has changed; (handle tellFinderAboutChange);;.....................................................................tFinderInformOfChange procname	import UpdateWindow		;input=<wind	IMPORT finderDPage	IMPORT matchWindName	IMPORT walkWindow	IMPORT WStringCopy*** 21-Aug-92 DAL -- replace code with return-no-error (Volume Changed events should be enough)	lda #0	clc	rts*** end 21-Aug-92;	ldx <dataIn;	ldy <dataIn+2;;	phd;	lda >finderDPage;	tcd;;	pushZLong <wind;	pushzlong <curWind;;	phy		;source W string;	phx;	pushlong #C1_Pathname	;dest W string;	jsl WStringCopy;;	lda #MaxPathLen+MaxFileName+4;	sta c1_temppath-2;;	_ExpandPathGS expandParms;	tax;	bcs @nothing;;	lda #DirWindID		;Directory windows only.;	ldx #matchWindName		;Check for against C1_TempPath;	jsr walkWindow;	ldx #frqErrFailed;	bcc @nothing		;we didn't match squat, so don't do squat;;; window pointer is now in <wind, where UpdateWindow expects it;	jsr UpdateWindow;;	ldx #frqErrNoError;;@nothing	pulllong <curWind;	pulllong <wind;;	pld;;	clc		;handled the request;	txa		;error code;	rts;;;;; expandParms -- always, always, always expand the pathname we're working with before sending;;                stuff to the Finder Dave!  The Dave-man, D-D-D-Dave!, Daverino!;;;expandParms	dc.w 3;	dc.L c1_pathname;	dc.L c1_temppath-2;	dc.w 0	EndP;.....................................................................;; tFinderColorSelection -- color the current selected icons the given color;; Low word of dataIn = new color values ($xy00); High word of dataIn = color mask ($xy00);;.....................................................................tFinderColorSelection procname	import FinderDPage	import frqColorEntry	import CheckMenus	import bit31	lda <dataIn+2		;this is the mask word	ora bit31	ora #$00ff		;don't let them change the other flags	tax	lda <dataIn		;this is the new color word	and #$ff00		;don't let them change the other flags	tay	phd	lda >finderDPage	tcd	jsr frqColorEntry	;Y=newColor, X=colorMask	jsr CheckMenus	pld	clc	lda #frqErrNoError	rts	EndP;.....................................................................;; doIdleHowLong -- return the # of ticks since we had an event;.....................................................................tFinderIdleHowLong	procname	IMPORT idleTicks	ldy #4	lda >idleTicks	sta [<dataOut],y	iny	iny	lda >idleTicks+2	sta [<dataOut],y	clc	lda #0	;no problem	rts	EndP;.....................................................................;; tFinderGetWindowInfo --;; dataIn = pointer to a Finder window;; dataOut = pointer to a buffer:;  +000: recvCount;  +002: finderResult;  +004: windID (type of window: 2=directory, 4=trash, 8=clipboard,;                $10=info, $20=verify, $40=about, $80=help);  +006: windView (0=Icon, 1=small icon, 2=name, 3=date, 4=size, 5=kind);  +008: windFST;  +010: windTitle (PTR to PString);  +014: windPath (PTR to WString);;.....................................................................tFinderGetWindowInfo procname	import FinderDPage,clipBlk	lda >FinderDPage	tax	lda <dataIn	sta >temp,x	lda <dataIn+2	sta >temp+2,x	lda <dataOut	sta >ptr,x	lda <dataOut+2	sta >ptr+2,x	phd	txa	tcd	;<temp is dataIn, <ptr is dataOut	lda <temp	ora <temp+2	beq @badInput	;NIL is bad*** added 20-Aug-92 DAL -- Pretend the clipboard window is ours.	pha	pha	;space for ShowClipboard	lda #0	pha	;flags (just return pointer)	pha	pha	;rect pointer (nil);	_ShowClipboard	ldx #$1516	jsl $e10000	plx	ply	cpy <temp+2	bne @notClipboard	cpx <temp	bne @notClipboard	ldy #clipBlk>>16	ldx #clipBlk	bra @windBlkYX@notClipboard*** end 20-Aug-92	pha	;space for GetSysWFlag	pei <temp+2	pei <temp	_GetSysWFlag	pla	beq @appWindow@badInput	lda #frqErrBadInput	bra @exit@appWindow	pha	pha	pei <temp+2	pei <temp	_GetWRefCon	plx	ply@windBlkYX	stx <temp	sty <temp+2	;temp is now windBlk	lda <temp+1	beq @badInput	;if refcon is 0, this is some weird window (modal?)	ldy #windID	lda [<temp],y	ldy #4	sta [<ptr],y	ldy #windView	lda [<temp],y	ldy #6	sta [<ptr],y	ldy #windFST	lda [<temp],y	ldy #8	sta [<ptr],y	clc	lda <temp	adc #windTitle	ldy #10	sta [<ptr],y	lda <temp+2	adc #0	iny	iny	sta [<ptr],y	clc	lda <temp	adc #windPath	ldy #14	sta [<ptr],y	lda <temp+2	adc #0	iny	iny	sta [<ptr],y	lda #0	;no problem@exit	clc	pld	rts	EndP;.....................................................................;; tFinderAddToExtras -- add the following title and dispatch point to;                     the Extras menu;;; dataIn points to a menu item template.  Bit 15 of the item version;   is set if this is the *first* item being inserted in this group.;; dataOut points to a result buffer:;    recvCount;    result code;    result item ID;; Item numbering scheme for the Extras menu:;; Menu Item IDs $Exxx are reserved for Extras.; Actual items have odd numbered IDs (E001, E003, ...); The first item in each group has a dividing line associated;   with it (above it).  The dividing line item ID is one less;   than the item ID.;;.....................................................................tFinderAddToExtras	procname	import FixUpExtrasMenu,noHiliteKludge	lda #0	ldy #4	sta [<dataOut],y		;pre-zero item id	iny	iny	sta [<dataOut],y		;pre-zero menu id	lda [<dataIn]		;flag bits in 14&15	sta oldMenuVersionField	and #$3FFF		;clear bits 14 and 15	sta [<dataIn]*** create the Extras menu if it doesn't already exist	lda numExtrasItems	bne @alreadyHere	pha	pha	pea 2		;refIsResource	pea 0	pea 9		;menu resource ID 9 = Extras	_NewMenu2	plx	ply	bcs @error0	phy	phx	pea 650		;after Color menu	_InsertMenu	bcs @error0	pha	_FixMenuBar	pla@alreadyHere*** done creating the menu	inc numExtrasItems*** check for a specific insertAfter value	lda #$ffff	sta afterWhatID	lda oldMenuVersionField	and #$4000	;bit 14 = insert after specified item	beq @boring	ldy #2	lda [<dataIn],y	;get the ID to insert after	sta afterWhatID@boring*** Now look for a free item ID to use (odd numbers from $E001 for items; the*** even numbers are reserved for dividing lines)	ldx #$e001@nextItemID	phx	pha		;put us in this loop until we run outta gas and find an open	pha		;menu item ID	phx	_GetMItem	pla	pla	plx	bcs @useThisOne	inx	inx	cpx #$f000	bcc @nextItemID	lda #frqErrFailed@error0	brl @error@useThisOne	stx nextExtraID	txa	ldy #2	sta [<dataIn],y		;stuff a new item ID in their template*** If necessary, insert a dividing line before this item	dec a	sta thisDividingID	lda numExtrasItems	dec a	beq @noDividingLine		;first item in menu --> no dividing line	lda oldMenuVersionField	bpl @noDividingLine		;bit 15 of template version = dividing line flag	pea 0		;pointer	pushlong #dividingLineTmpl	lda afterWhatID	pha	pea 1000	_InsertMItem2		;if it doesn't work, too bad	lda thisDividingID	sta afterWhatID@noDividingLine*** Insert the actual item	pea 0		;pointer	pei <dataIn+2	pei <dataIn	lda afterWhatID	pha	pea 1000		;Extras menu ID	_InsertMItem2*** restore the template flag bits! ***	php	pha	lda oldMenuVersionField	sta [<dataIn]	pla	plp*** done restoring the version field	bcs @error	pea 0	pea 0	pea 1000	_CalcMenuSize	lda nextExtraID		;store the menu item id	ldy #4	sta [<dataOut],y	lda #1000		;store the Extras menu ID	ldy #6	sta [<dataOut],y	lda NumExtrasItems	dec a	bne @notFirst	inc noHiliteKludge		;18-Nov-91 DAL@notFirst	jsr FixUpExtrasMenu	stz noHiliteKludge		;18-Nov-91 DAL*** If the Extras menu has just appeared, Hilite it once to make it draw	lda NumExtrasItems	dec a	bne @noHiliteNeeded;;	pea 0;;	pea 1000;;	_HiliteMenu*** added 14-Nov-91 DAL -- instead of hiliting the menu, call DrawMenuBar, so*** TrasnProg will show up right (and anybody else who is patching DrawMenuBar)	jsr ClippedDrawMenuBar*** end 14-Nov-91@noHiliteNeeded	lda #frqErrNoError@error	clc	rts	export numExtrasItemsnumExtrasItems	dc.w 0nextExtraID	dc.w 0dividingLineTmpl	dc.w 0	;versionthisDividingID	dc.w 0	;menu item id	dc.b 0,0	;key equivs	dc.w 0	;check char	dc.w $0080	;flags = disabled	dc.l divideStringdivideString	dc.b 1,'-'oldMenuVersionField	dc.w 0afterWhatID	dc.w 0;.....................................................................;; ClippedDrawMenuBar -- refresh the menu bar from Extras over;;.....................................................................ClippedDrawMenuBar	name	pha	pha	_GetPort	;preserve port	pha	pha	_GetMenuMgrPort	_SetPort	;set to Menu Mgr port	pha	pha	_NewRgn	lda 3,s	pha	lda 3,s	pha	;duplicate the handle	_GetClip	jsr FindExtrasCoordinate	sta myClipRect+2	pushlong #myClipRect	_ClipRect	_DrawMenuBar	;refresh just from Extras over	_SetClip	;old clip region on stack	_SetPort	;restore port	rtsmyClipRect	dc.w 0,0,10000,10000** Walk through the menu bar adding up the widths of the menus, until* we get to Extras.  Return X coordinate in A.*FindExtrasCoordinate	phd	pha	pha	;space for menu handle	pha	pha	;space for menu bar handle/ptr	_GetMenuBar	pha	_GetMTitleStart	tsc	tcd@position	equ 1@bar	equ @position+2@menu	equ @bar+4	ldy #2	lda [<@bar],y	tax	lda [<@bar]	sta <@bar	stx <@bar+2	ldy #$28-4	;offset to first menu (minus 4)@addOneMenu	iny	iny	iny	iny	phy	lda [<@bar],y	sta <@menu	iny	iny	lda [<@bar],y	sta <@menu+2	ldy #2	;got a menu handle; now deref it	lda [<@menu],y	tax	lda [<@menu]	sta <@menu	stx <@menu+2	lda [<@menu]	;get menu ID	cmp #1000	;Extras menu ID	beq @done	ldy #$0E	;offset to menu width	clc	lda <@position	adc [<@menu],y	sta <@position	ply	bra @addOneMenu@done	ply	;discard menu index	pla	;pull position (return in A)	ply	ply	;discarded bar ptr	ply	ply	;discarded menu ptr	pld	rts	EndP;.....................................................................;; tFinderRemoveFromExtras;.....................................................................tFinderRemoveFromExtras procname	import numExtrasItems,ExtensionsShuttingDown,FixUpExtrasMenu*** added 24-Feb-92 DAL -- Validate the item ID (must be $Exxx)	lda <dataIn	and #$f000	cmp #$e000	sec	bne @bcsFailed*** end 24-Feb-92	pha	pha	pei <dataIn	_GetMItem	plx	plx@bcsFailed	bcs @failed*** Remove the dividing line above this item, if there is one	lda <dataIn	dec a	pha	_DeleteMItem	;if it doesn't work, that's ok	pei <dataIn	_DeleteMItem	bcs @failed	lda numExtrasItems	cmp #2	bcc @dying	jsr KillOrphanedDivLine  ;15-Sep-91 DAL@dying	lda #0	pha	;new width	pha	;new height	pea 1000	;Extras menu ID	_CalcMenuSize	dec numExtrasItems	bmi @nothingToRemove	bne @done	pha	pha	pea 1000	;Extras menu ID	_GetMHandle	;leave handle on stack for DisposeMenu	pea 1000	_DeleteMenu	_DisposeMenu	;handle already on stack	lda ExtensionsShuttingDown	bne @dontDrawMBar	pha	_FixMenuBar	pla	_DrawMenuBar@done	jsr FixUpExtrasMenu@dontDrawMBar	lda #frqErrNoError	clc	rts@nothingToRemove	stz numExtrasItems@failed	lda #frqErrFailed	clc	rts;.....................................................................;; KillOrphanedDivLine;; If removing an item left the very first item in the menu a dividing; line (an even-numbered item) then delete it!;; Look at offset $0018 in the Extras menu handle to find the item ID; of the first item.  This is cheating, but who cares?;;.....................................................................KillOrphanedDivLine	phd	pha	pha	;space for GetMHandle	pea 1000	_GetMHandle	tsc	tcd	ldy #2	lda [1],y	tax	lda [1]	sta <1	stx <3	ldy #$0018	;offset to ID of first menu item	lda [1],y	tax	lsr a	bcs @exit	;odd number = fine	phx	_DeleteMItem@exit	pla	pla	pld	rts	EndP;.....................................................................;; tFinderSelectMItem;.....................................................................tFinderSelectMItem procname	import SaveMenuID,FinderDPage,tellFinderSelectMItemEntry,allowTellFinderCalls	import setupFunctionKeys,CheckMenus	lda >FinderDPage	tax	ldy #2	lda [<dataIn],y	and #$feff	sta >modifiers,x	lda [<dataIn]	sta >TaskData,x		ldx #0@loop	cmp MenuIDMap,x	;is this an item I know about?	beq @found	;yes	inx	inx	inx	inx	cpx #EndMenuIDMap-MenuIDMap	bcc @loop		lda #fErrBadInput	clc	rts@found	lda MenuIDMap+2,x	sta SaveMenuID	cmp #idColorMenu	bne @notColorMenu		pha	pha	_GetMenuFlag	bra @commonCode@notColorMenu	lda [<dataIn]	pha	pha	_GetMItemFlag@commonCode	pla	and #$0080	beq @enabled		lda #FErrDimmed	clc	rts@enabled	ldy #4	lda [<dataIn],y	bpl @noHilite			pea $FFFF	; pass hilite flag	lda SaveMenuID	pha	; pass menu ID	_HiliteMenu	bra @hilite	@noHilite	stz SaveMenuID@hilite	phd	lda >finderDPage	tcd	lda >allowTellFinderCalls	pha	lda #0	sta >allowTellFinderCalls	jsr SetupFunctionKeys	jsr tellFinderSelectMItemEntry	jsr CheckMenus	pla	sta >allowTellFinderCalls	pld		lda #fErrNoError	clc	rts	MenuIDMap	DC.W idAbout,idAppleMenu	DC.W idHelp,idAppleMenu	DC.W idNewFolder,idFileMenu	DC.W idOpen,idFileMenu	DC.W idPrint,idFileMenu	DC.W idClose,idFileMenu	DC.W idCloseAll,idFileMenu	DC.W idDuplicate,idFileMenu	DC.W idPutAway,idFileMenu	DC.W idValidate,idFileMenu	DC.W idUndo,idEditMenu	DC.W idCut,idEditMenu	DC.W idCopy,idEditMenu	DC.W idPaste,idEditMenu	DC.W idClear,idEditMenu	DC.W idSelectAll,idEditMenu	DC.W idShowClip,idEditMenu	dc.W idStackWindows,idWindowsMenu	DC.W idByIcon,idViewMenu	DC.W idByTinyIcon,idViewMenu	DC.W idByName,idViewMenu	DC.W idByDate,idViewMenu	DC.W idBySize,idViewMenu	DC.W idByKind,idViewMenu	DC.W idFormat,idDiskMenu	DC.W idErase,idDiskMenu	DC.W idVerify,idDiskMenu	DC.W idEject,idDiskMenu	DC.W idCleanUp,idSpecialMenu	DC.W idEmptyTrash,idSpecialMenu	DC.W idPreferences,idSpecialMenu	DC.W idIconInfo,idSpecialMenu	DC.W idShutDown,idSpecialMenu	DC.W idCleanUpByName,idSpecialMenu	DC.W idColor_0,idColorMenu	DC.W idColor_1,idColorMenu	DC.W idColor_2,idColorMenu	DC.W idColor_3,idColorMenu	DC.W idColor_4,idColorMenu	DC.W idColor_5,idColorMenu	DC.W idColor_6,idColorMenu	DC.W idColor_7,idColorMenu	DC.W idColor_8,idColorMenu	DC.W idColor_9,idColorMenu	DC.W idColor_A,idColorMenu	DC.W idColor_B,idColorMenu	DC.W idColor_D,idColorMenu	DC.W idColor_E,idColorMenu	DC.W idColor_F,idColorMenuEndMenuIDMap	EndP; tellFinderSpecialPreferences;.....................................................................tFinderSpecialPreferences procname	import EjectNonRemovable	ldy #2	lda [<dataIn],y	sta EjectNonRemovable	lda #0	;finderResult (added 24-Feb-92 DAL)@done	clc	rts;.....................................................................;; SayExtrasChosen -- send out the finderSaysExtrasChosen message;; Input: Menu ID in A;; Call with JSL;;.....................................................................SayExtrasChosen	procname export	import allowTellFinderCalls		tax	lda #$FFFF	sta >allowTellFinderCalls	txa	ldx #0		;a handy zero	pea finderSaysExtrasChosen	pea $8000		;stop after one acceptance	phx	phx		;target=nil (everybody)	phx		;high word of dataIn (reserved)	pha		;low word of dataIn (menu item number)	phx	phx		;dataOut = nil	_SendRequest	bcc @accepted	pea $000C		;sbOperationFailed	_SysBeep2@accepted	lda #0	sta >allowTellFinderCalls	rtl	EndP;.....................................................................;; SayIdle -- send out the finderSaysIdle message;; Input: Nothing;; Call with JSL;;.....................................................................SayIdle	procname export	import allowTellFinderCalls,pushtask	import idleTicks	pha		;space	pea $f000		;application events pending? (like disk inserts)	jsr pushTask		;ptr to task record (same as event record)	_EventAvail	pla	bne @done	ldx #0		;a handy zero	pea finderSaysIdle	phx		;don't stop (oooo, oooo)	phx	phx		;target=nil (everybody);;;	phx		;high word of dataIn (reserved);;;	pha		;low word of dataIn (reserved) in 6.0 (zero)*** changed 17-Feb-92 -- pass the idle time as dataIn to finderSaysIdle in 6.0.1	lda >idleTicks+2	pha	lda >idleTicks	pha*** end 17-Feb-92	phx	phx		;dataOut = nil	_SendRequest@done	rtl	EndP;.....................................................................;; SayHelloToExtensions -- send out the finderSaysHello message;; Call with JSL;; dataIn passed to SendRequest points to a buffer in this format:;   +000 Word  parameter count (at least 2);   +002 Long  rVersion word;   +006 Word  Finder's memory ID for SetCurResourceApp;;.....................................................................SayHelloToExtensions procname export	import selectionIsChanging	import allowTellFinderCalls	import LoadExtensions,KillExtensions	jsl LoadExtensions		;6-Nov-91 DAL	lda #$FFFF	sta >allowTellFinderCalls	jsl selectionIsChanging	lda #0	sta >ExtensionsShuttingDown	pha	_MMStartUp	pla	sta >helloMemID	pha	pha	pea $8029		;rVersion(1)	pushlong #1	_LoadResource	phd	tsc	tcd	ldy #2	lda [3],y	tax	lda [3]	sta <3	stx <5		;dereferenced rVersion handle	lda [3]		;grab first longword = version	sta >helloVersion	lda [3],y	sta >helloVersion+2	pld	pla	pla	pea finderSaysHello		;request code	ldx #0	phx		;send to everybody who wants it	phx	phx		;target=nil (everybody)	pushlong #helloDataIn	;data in	phx	phx		;data out	_SendRequest	lda #0	sta >allowTellFinderCalls	rtl;; once the finder is started up, DON'T move the helloDataIn values or change them.  Matt Deatherage; is depending on them staying around;helloDataIn	dc.w 4	;4 for 6.0.1 (3 parameters in 6.0)helloVersion	dc.l 0helloMemID	dc.w 0	dc.w ICSIZE	;3rd parm = size of non-extended icon (for finding extended fields)*** Fields added for 6.0.1helloFlags	dc.w $0001	;bit 0 disables the 6.0 KeyboardNav init (2-Jun-92 DAL)*** end of 6.0.1 fields	export SayGoodbyeToExtensionsSayGoodbyeToExtensions	lda #1	sta >ExtensionsShuttingDown	lda #finderSaysGoodbye	jsl SendSomeReq		;6-Nov-91 DAL	jsl KillExtensions		;6-Nov-91 DAL	rtl		;6-Nov-91 DAL	entry SendSomeReqSendSomeReq	tax		;save request code in X	lda >allowTellFinderCalls	pha	lda #$FFFF	sta >allowTellFinderCalls	txa		;A = request code	pha		;push reqCode	ldx #0		;a handy zero	phx		;send to everybody who wants it	phx	phx		;target=nil (everybody)	phx		;	phx		;dataIn = nil	phx	phx		;dataOut = nil	_SendRequest		pla	sta >allowTellFinderCalls	rtl	export ExtensionsShuttingDownExtensionsShuttingDown dc.w 0	EndP;.....................................................................;; selectionIsChanging;.....................................................................selectionIsChanging procname export	lda #$FFFF	sta >changed	rtl;.....................................................................;; CheckSelectionChanged -- called by main loop;; If the selection has changed, tell all the extensions about it;;.....................................................................	export CheckSelectionChangedCheckSelectionChanged	lda >changed	bne @itChanged	rtl@itChanged	lda #0	sta >changed	lda #finderSaysSelectionChanged	jsl SendSomeReq	phb	phk	plb	jsr FixUpExtrasMenu	plb	rtlchanged	dc.w 0		;boolean, has the selection changed?** FixUpExtrasMenu -- disable menu if all items are disabled*	export FixUpExtrasMenuFixUpExtrasMenu	lda numExtrasItems	beq @noExtras	ldx #$dfff@checkNextItem	pha	jsr GetNextItemFlag	ldy #$ff7f	;enable menu	and #$0080	beq @enabled	pla	dec a	bne @checkNextItem	pha	ldy #$0080	;disable menu@enabled	pla	;discard item count	jsr mySetMenuFlag	;input in Y@noExtras	rts** mySetMenuFlag -- new menu flag value in Y (menu ID = 1000, Extras menu)*mySetMenuFlag	phy	pha	pea 1000	_GetMenuFlag	pla	eor 1,s	and #$0080	beq @noHilite	lda 1,s	pha	pea 1000	_SetMenuFlag	lda noHiliteKludge	bne @noHilite	;18-Nov-91 DAL	pea 0	pea 1000	_HiliteMenu@noHilite	ply	rts	export noHiliteKludgenoHiliteKludge	dc.w 0** GetNextItemFlag -- Running Item ID in X, return flag in A** Remember, real items have odd-numbered item IDs, and dividing* lines have even-numbered IDs.  We assume all the dividing lines* are disabled (duh), and only look at the real items.*GetNextItemFlag	phx@tryNext	plx	inx	inx	phx	pha	pha	;space for GetMItem	phx	_GetMItem	pla	pla	;discard result	bcs @tryNext	plx	phx	pha	;space for GetMItemFlag	phx	;item id	_GetMItemFlag	pla	plx	rts	EndP;=====================================================================;; THE FOLLOWING FINDER REQUESTS ARE NOT IMPLEMENTED IN 6.0;;=====================================================================;.....................................................................;; tFinderAdjustHelpTopics --;; Provides a way for Finder Extensions to add their Help items to; the Finder's pop-up Help menu.;;.....................................................................tFinderAdjustHelpTopics proc	EndP;.....................................................................;; tFinderAddDesktopIcon -- oo, ick.;; Concept:  Add a brand new icon to the desktop (not corresponding;           to a file).  When people do things to this icon (like;           opening it or dragging files onto it), the extension that;           created it gets to handle it.;;.....................................................................tFinderAddDesktopIcon proc	EndP;.....................................................................;; tFinderPutInTrash -- put a file from a full pathname into the trash;.....................................................................tFinderPutInTrash	proc	EndP;.....................................................................;; tFinderPutOnDesktop -- put a file from a full path onto the desktop;; This would be really handy for Find File!;;.....................................................................tFinderPutOnDesktop proc	clc	lda #frqErrNotImp	rts	EndP	END