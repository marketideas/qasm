## Build.All# 15 May 89## This Script builds all the AUG files for the 6.0 disk:##     ADU#     Installer#     Finder#     Control Panel and CDevs#	  VideoMix stuff#     CDRemote#     GSCalcNDA#     EasyAccess stuff## 2/1/90	Mensch#		Add Closeview stuff...## 11/05/90	Branche#		Add GSCalcNDA stuff...###################################################################directory ADUBuildProgram {Parameters} ADV.DISK.UTILdirectory ::FinderBuildProgram {Parameters} Finderdirectory :EasyMount:BuildProgram {Parameters} EasyMountdirectory :::InstallerBuildProgram {Parameters} InstallerBuildProgram {Parameters} Installer.Devdirectory ::ctlpanelBuildEverything {Parameters}directory ::CDRemoteBuildProgram {Parameters} CDRemotedirectory ::GSCalcNDABuildProgram {Parameters} GSCalc.NDAdirectory ::VideoMix:VideoMix.NDABuildProgram {Parameters} VideoMix.NDAdirectory ::VideoMix.INITBuildProgram {Parameters} AppleIIVOC.INITdirectory :::CloseViewBuildProgram {Parameters} CloseViewdirectory ::VideoKeyboardBuildProgram {Parameters} VideoKeyboarddirectory ::MediaCtlBuildEverthing {parameters}directory ::EasyAccessBuildProgram {parameters} EasyAccessdirectory ::Apple.BowlEcho "# `Date -t` --- This is actually building AppleBowl"BuildProgram {parameters} alldirectory ::