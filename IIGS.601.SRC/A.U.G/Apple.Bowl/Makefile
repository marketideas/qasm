# define object files necessary to build the compilerSources	=	:compiler:Basic.p ¶			:compiler:Parser.p ¶			:compiler:Scanner.p ¶			:compiler:CodeGen.p ¶			:compiler:BasicCom.pall			ÄÄ	Apple.Bowl Read.MeApple.Bowl	ÄÄ	Bowl.r	RezIIGS Bowl.r -o Apple.BowlApple.Bowl	ÄÄ	Bowl.obj BowlBin.obj ProgAid.lib :Compiler:IntBasicLib	LinkIIGS -w2 -t S16 -l >Bowl.map ¶		Bowl.obj ¶		BowlBin.obj ¶		-lib :compiler:IntBasicLib ¶		-lib ProgAid.lib ¶		-o Apple.BowlRead.Me		ÄÄ	Read.Me.txt Read.Me.r	Duplicate -d -y Read.Me.txt Read.Me	RezIIGS Read.Me.r -o Read.Me -t $70505445 -c pdosBowlBin.obj	Ä	BowlBin.aii	AsmIIGS BowlBin.aii -o BowlBin.objBowl.obj	Ä	Bowl.bas :Compiler:IntBasicIIGS	:Compiler:IntBasicIIGS Bowl.bas -o Bowl.objProgAid.lib	Ä	ProgAid.obj	Delete -i ProgAid.lib	MakeLibIIGS -l ProgAid.lib -r ProgAid.objProgAid.obj	Ä	ProgAid.aii	AsmIIGS ProgAid.aii -o ProgAid.obj:Compiler:IntBasicIIGS	Ä	{Sources}	directory :Compiler:	make IntBasicIIGS >makeout	makeout	delete makeout	directory :::Compiler:IntBasicLib Ä	:Compiler:BasicLib.aii :Compiler:BasicLib.macros	directory :Compiler:	AsmIIGS BasicLib.aii -o :obj:BasicLib.obj	Delete -i IntBasicLib	MakeLibIIGS -l IntBasicLib -r :obj:BasicLib.obj	directory ::