E USER *REM * INSTRUCTIONS IN PRINTED *REM * FORMAT, SIMPLY RUN THIS *REM * PROGRAM. (TEXT FOLLOWS) *REM *                         *REM ***************************REM Shape table MUST be named ShapeTbl in assembly source.REM Programmer's Aid library accesses it by name.REM Programmer's Aid Library variablesX0 = 0Y0 = 0COLR = 0SHAPE = 0ROT = 0SCALE = 1COLLSN = 0REM Program variablesI = 0J = 0X = 0Y = 0Z = 0DIM PIN(38),SET(2),A$(255),N$(20)TEXTCALL HomeGOSUB "Title"GOSUB "InitTextScreen"CALL CursorOffVTAB 2: TAB 31: PRINT "A P P L E   B O W L"        TAB 31: PRINT "- - - - -   - - - -"PRINTTAB 21: PRINT "< By Charlie Kellner and Eric Larson >"TAB 21: PRINT "< Apple IIGS Version by Greg Branche >"PRINTTAB 17: PRINT "Copyright (C) 1978, 1992   Apple Computer Inc."TAB 15: PRINT "Portions Copyright (C) 1991   The Byte Works, Inc."PRINT:PRINTTAB 18: PRINT "Apple Bowl is a copyrighted software product"TAB 15: PRINT "and as such may not be duplicated or transmitted."PRINT:PRINTTAB 19: PRINT "Copyright infringement may result in civil"TAB 14: PRINT "damages whether or not a profit motive is involved."VTAB 23: TAB 23PRINT "Press the space bar to continue...";: CALL ClearStrobe"WaitKey_2"GOSUB "WaitForKey"CALL KeyboardIF Key # 32 THEN "WaitKey_2"GOSUB "InitTextScreen"REM   "          1         2         3         4         5         6         7REM   "01234567890123456789012345678901234567890123456789012345678901234567890123456789VTAB 2: TAB 31: PRINT "A P P L E   B O W L"VTAB 9PRINT " The Apple Bowl is a 3-D, Hi-Resolution graphic simulation of a bowling alley."PRINT " The computed motion of the ball & pins is derived from the laws of physics."PRINT " All conditions normally encountered in bowling, such as the direction, speed,"PRINT " spin, and weight of the ball and pins are included with the ball's position"PRINT " to realistically determine the correct fall of the pins, and resulting score."PRINT " The ball can be thrown from any point across the width of the bowling alley."PRINT " Its direction, speed and spin are set at the moment of release by the mouse"PRINT " and two keys on the keyboard - the Apple and Option keys."VTAB 23: TAB 21: PRINT "Need instructions? (Hit 'Y' or 'N')...";"WaitKey_3"GOSUB "WaitForKey"CALL KeyboardIF Key = ASC("N") OR  Key = ASC("n") THEN "Begin_Game"IF Key # ASC("Y") AND Key # ASC("y") THEN "WaitKey_3"GOSUB "InitTextScreen"VTAB 1: TAB 29: PRINT "I N S T R U C T I O N S": PRINTREM   "          1         2         3         4         5         6         7REM   "01234567890123456789012345678901234567890123456789012345678901234567890123456789PRINT " Three lanes are shown on your screen.  Notice that you are (appropriately) on"PRINT " lane ][.  Occasionally you may notice activity on lanes I and ]I[: Don't let"PRINT " this concern you; they're on different teams, and won't affect your score."PRINT " When it's your turn to bowl, the Apple will display a small moving pointer at"PRINT " the front of your lane.  This will be the point from which the ball will be "PRINT " released when you press either the Apple or Option keys on the keyboard."PRINT " Moving the mouse left and right controls the angle of release of the ball"PRINT " (direction left to right), and moving the mouse backwards and forwards"PRINT " controls its speed."PRINTPRINT " Your mouse positions will be shown by an indicator at each side of the lane."PRINT " If you use the Option key to throw the ball, it will hook slightly to the"PRINT " left.  If you press the Apple key, the ball will hook to the right (the "PRINT " hook is more noticeable at slower speeds). "PRINTPRINT " The Apple keeps score automatically.  Strikes and spares (marks) are scored "PRINT " by standard rules.  Extra ball(s) are awarded for marks in the tenth frame."PRINT " To interrupt a game before the tenth frame, just hit the Escape (ESC) key."PRINT " If you decide to quit, you will be shown the last four score sheets."PRINTVTAB 24: TAB 22: PRINT "Ready to begin?  (hit 'Y' or 'N')...";"WaitKey_5"GOSUB "WaitForKey"CALL KeyboardIF Key = ASC("Y") OR Key = ASC("y") THEN "Begin_Game"IF Key # ASC("N") AND Key # ASC("n") THEN "WaitKey_5"TEXT80CALL NormalCALL HomeENDREM ******************REM * INITIALIZATION *REM ******************"Begin_Game"CALL Normal : REM Clear 80 column screenCALL HomeTEXTCALL HomeCALL NormalCALL GetSysSpeed : REM read current system speedOldSysSpeed = SysSpeed : REM save for restoration laterSysSpeed = 0 : REM set 1 MHz speedCALL SetSysSpeedCALL SetMousePositionREM  DRAW LANESCALL InitCOLR = 127: X0 = 0: Y0 = 0: CALL HPlotX0 = 278: CALL LineY0 = 70: CALL LineX0 = 0: CALL HPlotY0 = 0: CALL LineCOLR = 85: Y0 = 44: CALL HPlotX0 = 279: CALL LineCOLR = 127FOR I = 1 TO 187 STEP 93    X0 = I: Y0 = 0: CALL HPlot    Y0 = 70: CALL Line    X0 = I + 92: CALL HPlot    Y0 = 0: CALL LineNEXT IX0 = 93: Y0 = 70: CALL HPlotX0 = 0: Y0 = 159: CALL LineX0 = 186: Y0 = 70: CALL HPlotX0 = 279: Y0 = 159: CALL LineREM  DRAW GUTTERSCOLR = 170: X0 = 80: Y0 = 70: CALL HPlotX0 = 0: Y0 = 133: CALL LineX0 = 198: Y0 = 70: CALL HPlotX0 = 279: Y0 = 133: CALL LineX0 = 11: Y0 = 70: CALL HPlotX0 = 1: Y0 = 75: CALL LineX0 = 279: Y0 = 75: CALL HPlotX0 = 268: Y0 = 70: CALL LineX0 = 105: Y0 = 70: CALL HPlotX0 = 36: Y0 = 159: CALL LineX0 = X0 - 2: CALL HPlotX0 = 105: Y0 = 70: CALL LineX0 = 174: Y0 = 70: CALL HPlotX0 = 243: Y0 = 159: CALL LineX0 = X0 + 2: CALL HPlotX0 = 174: Y0 = 70: CALL LineREM  DRAW FEATURESCOLR = 42FOR I = 1 TO 187 STEP 93    X0 = I + 84: Y0 = 2: CALL HPlot    X0 = I + 6: CALL Line    X0 = I + 45: Y0 = 42: CALL Line    X0 = I + 84: Y0 = 2: CALL LineNEXT ICOLR = 85FOR I = 86 TO 192 STEP 26    X0 = I: Y0 = 149: CALL HPlotNEXT IFOR L = 0 TO 2    SET(L) = 1    GOSUB "Lane_Cycle"    SHAPE = 2    X0 = L * 93 + 74: Y0 = 3: CALL XDraw    SHAPE = 5    X0 = X0 - 67: Y0 = 41: CALL XDraw    X1 = X0 + 70    FOR X0 = X1 - L * 3 TO X1 STEP 3        SHAPE = 6        CALL XDraw    NEXT X0NEXT L"Get_Name"CALL HomeCALL ClearTextVTAB 22: INPUT "Hi! What's your name? ",A$IF A$="" THEN "Get_Name"I = LEN(A$)IF I > 20 THEN I = 20N$ = A$(1,I) : REM Save player's name"Got_Name"CALL HomeGOSUB "Lane_Reset"REM  ****************REM  * MAIN CONTROL *REM  ****************"Main_Loop"CALL SetSysSpeed : REM Make sure we're running slowCALL KeyboardIF Key = 155 OR F > 9 THEN "Game_End_2"CALL ClearStrobe : REM clear any pending keystrokesG = 0IF L # 1 OR RND(SP + ST + SV + 2) THEN "Player_Input"L = RND(2) * 2IF OP0 <> PDL(0) / 10 OR OP1 <> PDL(1) / 10 THEN GOSUB "Draw_Settings"X0 = 133 * L: Y0 = 100: S = -2: X1 = (RND(200) + 150) * (1 - L)FOR I = 1 TO 1000    REM nothing!NEXT IX3 = 0REM  BALL MOTION"Ball_Motion"SHAPE = 7: ROT = 0: X2 = X0 * 100: CALL XDrawFOR I = 158 - (58 * (L # 1)) TO 70 STEP S    CALL XDraw    IF ABS(X0 - 133) + 33 < I OR L # 1 THEN "L2130"    G = 1    X1 = SGN(133 - X0) * 100    X2 = 13300 - (I - 33) * X1    X0 = X2 / 100"L2130"    X1 = X1 + X3    X2 = X2 + X1    X0 = X2 / 100    Y0 = I    CALL XDraw    FOR J = 1 TO 30        REM delay    NEXT JNEXT ICALL XDrawGOSUB "Pinfall"FOR I = 1 TO 600    REM delayNEXT IIF L = 1 THEN GOSUB "Scoring"GOSUB "Lane_Cycle"GOTO "Main_Loop"REM  PLAYER INPUT"Player_Input"Call ReadButtonsREM Ensure player releases buttons before continuingIF Button0 > 127 OR Button1 > 127 THEN "Player_Input"SHAPE = 2ROT = 32L = 1Z = RND(200) + 200X0 = XP: Y0 = 156: CALL XDrawIF OP0 = PDL(0) / 10 AND OP1 = PDL(1) / 10 THEN GOSUB "Draw_Settings""No_Pdl_Change"CALL KeyboardIF Key = 155 THEN "Game_End"CALL ClearStrobe : REM clear any pending keystrokesX1 = 63 - PDL(0) / 2X3 = 0IF OP0 <> PDL(0) / 10 OR OP1 <> PDL(1) / 10 THEN GOSUB "Draw_Settings"S = (255 - PDL(1)) / 86 - 4X1 = X1 * SCall ReadButtonsIF Button0 > 127 THEN X3 = -2 * SIF Button1 > 127 THEN X3 = 2 * SIF X3 THEN "L2250"XP = XP + DXIF XP > 210 THEN DX = -2IF XP < 75 THEN DX = 2Z = Z - 1CALL XDrawIF NOT Z THEN "Main_Loop"X0 = XP: CALL XDrawGOTO "No_Pdl_Change""L2250"CALL XDrawX0 = X0 - RND(5) - 7Y0 = 170GOTO "Ball_Motion""Draw_Settings"S1 = Y0S2 = X0S3 = COLRCOLR = 255Y0 = 159: X0 = 73: CALL HPlotY0 = 157: CALL LineX0 = 231: CALL HPlotY0 = 159: CALL LineX0 = 206: CALL HPlotY0 = 157: CALL LineX0 = 48: CALL HPlotY0 = 159: CALL LineY0 = 158: COLR = 0: X0 = 49: CALL HPlotX0 = 72: CALL LineX0 = 230: CALL HPlotX0 = 207: CALL LineX0 = 206: CALL HPlotCOLR = 255X0 = 206 + (PDL(1) / 10): CALL LineX0 = 60: CALL HPlotX0 = 60 + (PDL(0) - 127) / 10: CALL LineOP0 = PDL(0) / 10OP1 = PDL(1) / 10COLR = S3Y0 = S1X0 = S2RETURNREM *******************REM *   LANE RESET    *REM *******************"Lane_Reset"Call ClearMixedCALL InverseVTAB 21FOR I = 1 TO 159    PRINT " ";NEXT ICALL WriteLastSpaceN = N + 1VTAB 21: TAB 1: PRINT "Game ";IF N < 10 THEN PRINT "#";PRINT N;"    Bowler: ";N$FOR I = 1 TO 10    PRINT "_";I;"_ ";NEXT ICALL SetMixedFOR I = 1 TO 1000    REM delayNEXT IFOR L = 0 TO 2    IF SET(L) THEN GOSUB "Lane_Cycle"NEXT LXP = 100DX = 2RETURNREM *******************REM *   END OF GAME   *REM *******************"Game_End"SHAPE = 2ROT = 32X0 = XP: Y0 = 156: CALL XDraw"Game_End_2"CALL ClearStrobeCALL NormalVTAB 24PRINTPRINT"~Try_Again"INPUT "Another game? ",A$IF A$ # "" THEN IF A$(1,1)="N" OR A$(1,1)="n" THEN "All_Done"IF A$(1,1) = "Y" OR A$(1,1) = "y" THEN "Nuther_Game"Call Bell : VTAB 22 : Call ClearEOS : VTAB 23 : GOTO "~Try_Again""Nuther_Game"PRINT"~Try_Again_2"VTAB 21CALL ClearEOSPRINTINPUT "Same bowler? ",A$IF A$ = "" THEN "~Try_Again_2"IF A$(1,1) = "Y" OR A$(1,1) = "y" THEN "Same_Bowler"IF A$(1,1) = "N" OR A$(1,1) = "n" THEN "New_Bowler"Call Bell : Goto "~Try_Again_2""New_Bowler"VTAB 22CALL ClearEOSINPUT "Hi! What's your name? ",A$IF A$ = "" THEN "New_Bowler"I = LEN(A$)IF I > 20 THEN I = 20N$ = A$(1,I) : REM Save player's name"Same_Bowler"E = 0F = 0SP = 0ST = 0SV = 0T = 0ROT = 0GOSUB "Lane_Reset"GOTO "Main_Loop""All_Done"SysSpeed = OldSysSpeed : REM Reset the system speedCALL SetSysSpeedCALL SetText : REM turn graphics offCALL ClearHiRes : REM and ensure hi-res switch is turned offPRINTVTAB 21CALL NormalCALL ClearEOSVTAB 24: TAB 8: PRINT "Press any key to exit...";GOSUB "WaitForKey"CALL CursorOnENDREM **************REM * TITLE PAGE *REM **************"Title"TEXTCALL HomeCALL InverseTAB 19: PRINT      "   "TAB 18: PRINT     "     "TAB 18: PRINT     "     "TAB 17: PRINT    "       "TAB 17: PRINT    "       "TAB 18: PRINT     "     "TAB 18: PRINT     "     "TAB 19: PRINT      "   "TAB 19: PRINT      "   "TAB 18: PRINT     "     "TAB 17: PRINT    "       "TAB 16: PRINT   "         "TAB 15: PRINT  " -Welcome- "TAB 14: PRINT "             "TAB 14: PRINT " Apple  Bowl "TAB 14: PRINT "             "TAB 14: PRINT "$16,384 HiRes"TAB 14: PRINT "             "TAB 14: PRINT " Competition "TAB 14: PRINT "             "TAB 15: PRINT  " -No Pets- "TAB 16: PRINT   "         "TAB 17: PRINT    "       "CALL NormalFor I = 1 to 35    For J = 1 to 5000    Next JNext IRETURN"InitTextScreen"TEXT80CALL NormalCALL HomeRETURNREM *****************REM * PINFALL LOGIC *REM *****************"Pinfall"K = L * 13H = 0IF G THEN "In_Gutter_2"X1 = X1 / 100X3 = X0Z = 0FOR Y = 1 TO 4    X = L * 93 + 4: X3 = X3 + X1    IF X3 < X THEN X3 = X    IF X3 > X + 72 THEN X3 = X + 72    SHAPE = 7    X0 = X3: Y0 = 70 -Y * 2: CALL XDraw    G = 0    FOR X = 1 TO Y        X2 = (X3 - L * 93 + Y * (7 + L) - X * 16 - 32) / 3        IF ABS(X2) > 3 THEN "Skip"        S = 15 - Y * 4 + X        IF PIN(K + S) # 1 THEN "Skip"        Z = ((S - (S > 6) - 2 * (S > 9)) * 7 + X2) * 2 : REM calc array offset        CALL TranslateZ : REM read pinfall table        I = 0        IF G THEN "In_Gutter_1"        G = 1        CALL XDraw"In_Gutter_1"        IF PIN(K + I) = 1 AND Z MOD 2 THEN PIN(K + I) = 0        Z = Z / 2        I = I + 1        IF Z THEN "In_Gutter_1"        GOSUB "Pin_Action"        X1 = X1 + X2        IF Y = 4 THEN Z = 1"Skip"    NEXT X    IF NOT G THEN CALL XDrawNEXT YSHAPE = 1ROT = 16 + 32 * RND(2)X0 = L * 93 + ROT + RND(40)Y0 = 60 + RND(6)COLR = 127IF RND(Z+1) THEN CALL DrawROT = 0RETURN"In_Gutter_2"FOR I = 1 TO 50    CALL ClickNEXT IRETURNREM  **************REM  * PIN ACTION *REM  **************"Pin_Action"SHAPE = 1FOR I = 4 TO 1 STEP -1    FOR J = 4 TO I STEP -1        X0 = L * 13 + I * 3 + J - 4        IF PIN(X0) THEN "Missed_Pin"        PIN(X0) = -1        H = H + 1        X0 = L * 93 - (L - 1) * (4 - I) * 3 - I * 8 + J * 16 + 14        Y0 = 70 + I * 2 - 13        COLR = 0        CALL Draw        COLR = 127        Y0 = 60        X0 = L * 83 + 25        CALL HPlot        X0 = X0 + 65        CALL Line        CALL Click: CALL Click: CALL Click: CALL Click"Missed_Pin"    NEXT JNEXT IFOR I = 1 TO 4    FOR J = I TO 4        IF PIN(L * 13 + I * 3 + J - 4) < 1 THEN "Missed_Pin_2"        X0 = L * 93 - (L - 1) * (4 - I) * 3 - I * 8 + J * 16 + 14        Y0 = 70 + I * 2 - 15        COLR = 0        IF I > 1 THEN CALL Draw        Y0 = Y0 + 2        COLR = 127        CALL Draw"Missed_Pin_2"    NEXT JNEXT IRETURNREM  **************REM  * LANE CYCLE *REM  **************"Lane_Cycle"SET(L) = NOT SET(L)FOR I = 45 TO 69    Z = L * 93 + 2    X0 = Z    Y0 = I    CALL HPlot    X0 = Z + 90 - (L = 2)    COLR = 127    CALL Line    Y0 = Y0 - 4    IF Y0 > 44 THEN CALL HPlot    X0 = Z    COLR = 213    IF Y0 > 44 THEN CALL LineNEXT ISHAPE = 4X0 = L * 93 + 46Y0 = 12IF SET(L) THEN CALL XDrawREM  PIN SWEEPERGOSUB "Pin_Spotter"X = L * 93 + 2Y = X + 90 - (L = 2)J = 0FOR I = 69 TO 45 STEP -1    X0 = X: Y0 = I: CALL HPlot    X0 = Y: COLR = 0: CALL Line    Y0 = Y0 - 4    IF Y0 > 44 THEN CALL HPlot    X0 = X    COLR = 127    IF Y0 > 44 THEN CALL Line    IF I > 59 THEN J = J+1    X0 = X + (2 - L) * J - 2    Y0 = I: CALL HPlot    X0 = Y - L * J + 1    IF I = 60 THEN CALL Line    CALL HPlotNEXT IREM  PIN SETTERSHAPE = 1FOR I = 1 TO 4    FOR J = I TO 4        K = L * 13 + I * 3 + J - 4        IF NOT SET(L) THEN PIN(K) = 1        IF PIN(K) < 1 THEN "Skip_Setup"        X0 = L * 93 - (L - 1) * (4 - I) * 3 - I * 8 + J * 16 + 14        Y0 = 55 + I * 2        IF I < 2 THEN "Skip_Draw"        COLR = 0: CALL Draw"Skip_Draw"        Y0 = Y0 + 2        COLR = 127        CALL Draw"Skip_Setup"    NEXT JNEXT ISHAPE = 2Y0 = 3X0 = L * 93 + 10CALL XDrawX0 = X0 + 64: CALL XDrawFOR I = 1 TO 500    REM delayNEXT IIF H = 10 AND SET(L) THEN "Lane_Cycle"RETURNREM  ***************REM  * PIN SPOTTER *REM  ***************"Pin_Spotter"SHAPE = 3H = 10FOR I = 1 TO 4    FOR J = I TO 4        K = L * 13 + I * 3 + J - 4        COLR = 127 * (SET(L) AND PIN(K) = 1)        IF PIN(K) = 1 THEN H = H - 1        X0 = L * 93 - I * 8 + J * 16 + 14        Y0 = I * 8        CALL Draw    NEXT JNEXT IIF H < 10 AND SET(L) THEN "Short_Pause"COLR = SET(L) * 127X0 = X0 - 4: Y0 = 15: CALL HPlotX0 = X0 + 8: Y0 = Y0 - 8: CALL LineX0 = X0 - 8: Y0 = Y0 + 8: CALL LineX0 = X0 + 8: CALL HPlotX0 = X0 - 8: Y0 = Y0 - 8: CALL LineX0 = X0 + 8: Y0 = Y0 + 8: CALL Line"Short_Pause"FOR I = 1 TO 200    REM delayNEXT ISHAPE = 4X0 = L * 93 + 46: Y0 = 12IF NOT SET(L) THEN CALL XDrawRETURNREM  ***********REM  * SCORING *REM  ***********"Scoring"T = T + HIF NOT ST AND NOT SP THEN "No_Extras"GOSUB "L1780"T = T + HIF NOT SP THEN T = T + H1"No_Extras"SP = 0ST = SVSV = 0IF NOT SET(L) THEN "L1750"VTAB 23TAB E-2PRINT ":";IF H + H1 < 10 THEN "No_Spare"PRINT "/";SP = 1IF E = 40 THEN E = 42GOTO "Score_Done""No_Spare"IF H THEN PRINT H;IF NOT H THEN PRINT "-";GOSUB "L1780"GOTO "Score_Done""L1750"E = E + 1 + 3 * (E < 40)VTAB 23TAB E - 3IF H < 10 THEN "L1760"IF E < 40 THEN PRINT "<X>"IF E > 39 THEN PRINT "X";SV = 1GOTO "Score_Done""L1760"IF H THEN PRINT H;IF NOT H THEN PRINT "-";"Score_Done"H1 = HRETURN"L1780"F = F + 1IF F > 10 THEN RETURNVTAB 24TAB F * 4 - 3 + (T < 10)PRINT T;RETURN"WaitForKey"Call ClearStrobe"~loop"Call KeyboardIF Key < 128 then "~loop"Call ClearStrobeReturn