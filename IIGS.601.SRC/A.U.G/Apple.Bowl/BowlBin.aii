;; ReadButtons -	Read game control buttons and place the	values into variables;ReadButtons	PROC	EXPORT		IMPORT	Button0, Button1		lda	>$E0C061		;read game control buttons ($C061 & $C062)		sep	#$20		sta	>Button0		;store so the values can be read by BASIC		xba		sta	>Button1		rep	#$20		rtl		ENDP;; ClearHiRes - sets lores display mode;ClearHiRes	PROC	EXPORT		sep	#$20		sta	>$E0C056		rep	#$20		rtl		ENDP;; SetHiRes - sets hires	display	mode (POKE -16297,0);SetHiRes	PROC	EXPORT		sep	#$20		sta	>$E0C057		rep	#$20		rtl		ENDP;; ClearText - turns off	text mode (graphics on);ClearText	PROC	EXPORT		sep	#$20		sta	>$E0C050		rep	#$20		rtl		ENDP;; SetText - accesses soft switch to turn text display on;SetText		PROC	EXPORT		sep	#$20		lda	>$E0C051		rep	#$20		rtl		ENDP;; ClearMixed - turns off mixed mode;ClearMixed	PROC	EXPORT		sep	#$20		sta	>$E0C052		rep	#$20		rtl		ENDP;; SetMixed - turns on mixed mode;SetMixed	PROC	EXPORT		sep	#$20		sta	>$E0C053		rep	#$20		rtl		ENDP;; CursorOff - sends Ctrl-F to output device to turn cursor off;CursorOff	PROC	EXPORT		IMPORT	~ChOut		lda	#$0006		bra	do_write;; CursorOn - Sends Ctrl-E to output device to turn cursor on;		EXPORT	CursorOnCursorOn		lda	#$0005do_write		jsr	~ChOut			; use library routine		rtl		ENDP;; WriteLastSpace - stores a space character in the lower right corner of the screen;WriteLastSpace	PROC	EXPORT		sep	#$20		longa	off		lda	#' '		sta	>$0007F7		rep	#$20		longa	on		rtl		ENDP;; GetSysSpeed -	retrieves current system speed and stores into BASIC variable;GetSysSpeed	PROC	EXPORT		IMPORT	SysSpeed		sep	#$20		longa	off		lda	>$E0C036		;read CYA register		asl	a			;shift speed bit into carry		rep	#$20			;back to 16-bit	mode		longa	on		lda	#0			;clear accumulator		rol	a			;shift carry into bit 0	of accumulator		sta	>SysSpeed		;store into BASIC variable		rtl		ENDP;; SetSysSpeed -	resets current system speed;SetSysSpeed	PROC	EXPORT		Import	SysSpeed		sep	#$20			;8-bit mode		longa	off		lda	>$E0C036		;read the CYA register		asl	a			;shift speed bit off		xba				;hide in high byte		lda	>SysSpeed		;read the BASIC	variable		lsr	a			;shift bit into	carry		xba				;retrieve CYA settings		ror	a			;rotate	speed bit in		sta	>$E0C036		;store back into CYA register		rep	#$20		longa	on		rtl		ENDP;; SetMousePosition - initializes mouse values; Note:	assumes	mouse max clamp	= 255;SetMousePosition PROC	EXPORT		pea	128			;set to	midpoint of range		pea	128		ldx	#$1E03			;PosMouse		jsl	$E10000		rtl		ENDPTranslateZ	PROC	EXPORT		IMPORT	Z, PinTable		lda	Z			;get value of Basic's Z variable		clc		adc	#4			;calculate correct offset		tax		lda	PinTable,x		;get the value there		sta	Z			;store back into Basic's variable		rtl		ENDPShapeTbl	RECORD	Export		DC.W	$0007			;# of shapes in	table		DC.W	PinImage-ShapeTbl	;Offset	to Shape_1		DC.W	Arrow-ShapeTbl		;Offset	to Shape_2		DC.W	Dot-ShapeTbl		;Offset	to Shape_3		DC.W	Logo-ShapeTbl		;Offset	to Shape_4		DC.W	Apple-ShapeTbl		;Offset	to Shape_5		DC.W	I_Image-ShapeTbl	;Offset	to Shape_6		DC.W	Ball-ShapeTbl		;Offset	to Shape_7PinImage	DC.B	$92,$3A,$27,$27,$3C,$24,$24,$25	;shape 1		DC.B	$2C,$24,$25,$24,$3C,$24,$25,$2D		DC.B	$2E,$36,$37,$36,$2E,$36,$35,$2E		DC.B	$36,$36,$37,$3E,$3E,$3C,$27,$27		DC.B	$3C,$24,$25,$2C,$24,$25,$24,$24		DC.B	$24,$17,$0D,$16,$92,$32,$2E,$36		DC.B	$35,$3E,$36,$3F,$3C,$24,$67,$64		DC.B	$B4,$35,$2E,$17,$E6,$24,$04,$00Arrow		DC.B	$35,$35,$35,$35,$0C,$2C,$2C,$2C	;shape 2		DC.B	$1F,$3F,$3F,$15,$35,$0C,$04,$00Dot		DC.B	$27,$2D,$36,$3F,$27,$64,$2D,$15	;shape 3		DC.B	$36,$1E,$3F,$04,$00Logo		DC.B	$0C,$0D,$0D,$15,$F6,$17,$36,$0E	;shape 4		DC.B	$15,$F6,$1E,$1F,$DC,$9F,$1F,$1C		DC.B	$1C,$E4,$24,$24,$64,$0C,$0D,$0D		DC.B	$0C,$64,$0C,$4C,$36,$1E,$17,$07		DC.B	$00Apple		DC.B	$E7,$1C,$64,$0C,$2D,$35,$36,$36	;shape 5		DC.B	$4D,$12,$24,$24,$24,$2C,$2D,$15		DC.B	$15,$F6,$1E,$6F,$49,$91,$24,$24		DC.B	$24,$2C,$2D,$15,$15,$F6,$1E,$6F		DC.B	$49,$21,$24,$24,$24,$96,$52,$49		DC.B	$09,$0C,$0C,$3C,$3F,$17,$17,$76		DC.B	$0E,$2D,$2D,$00I_Image		DC.B	$6D,$FD,$24,$24,$24,$3C,$6F,$29	;shape 6		DC.B	$05,$00Ball		DC.B	$35,$35,$2D,$2E,$2D,$2D,$2C,$25	;shape 7		DC.B	$25,$25,$3F,$3E,$3E,$37,$27,$37		DC.B	$27,$3F,$3C,$3C,$27,$2D,$35,$35		DC.B	$25,$35,$25,$35,$25,$25,$3F,$3F		DC.B	$3F,$3C,$3F,$67,$2D,$2D,$2E,$24		DC.B	$35,$2E,$24,$35,$2E,$35,$2D,$3C		DC.B	$3C,$27,$E5,$3B,$3F,$37,$3F,$67		DC.B	$31,$00		ENDRPinTable	Record		DC.B	$0F,$00		DC.B	$03,$00		DC.B	$01,$00z_base		DC.B	$01,$00		DC.B	$01,$00		DC.B	$01,$00		DC.B	$01,$00		DC.B	$0E,$00		DC.B	$06,$00		DC.B	$02,$00		DC.B	$02,$00		DC.B	$02,$00		DC.B	$02,$00		DC.B	$03,$00		DC.B	$0C,$00		DC.B	$04,$00		DC.B	$04,$00		DC.B	$04,$00		DC.B	$04,$00		DC.B	$06,$00		DC.B	$07,$00		DC.B	$08,$00		DC.B	$08,$00		DC.B	$08,$00		DC.B	$08,$00		DC.B	$08,$00		DC.B	$0C,$00		DC.B	$0F,$00		DC.B	$38,$00		DC.B	$16,$00		DC.B	$12,$00		DC.B	$10,$00		DC.B	$11,$00		DC.B	$11,$00		DC.B	$10,$00		DC.B	$60,$00		DC.B	$2C,$00		DC.B	$24,$00		DC.B	$20,$00		DC.B	$22,$00		DC.B	$23,$00		DC.B	$30,$00		DC.B	$40,$00		DC.B	$48,$00		DC.B	$48,$00		DC.B	$40,$00		DC.B	$44,$00		DC.B	$46,$00		DC.B	$61,$00		DC.B	$00,$03		DC.B	$68,$01		DC.B	$24,$01		DC.B	$02,$01		DC.B	$11,$01		DC.B	$10,$01		DC.B	$00,$01		DC.B	$00,$02		DC.B	$40,$02		DC.B	$48,$02		DC.B	$04,$02		DC.B	$22,$02		DC.B	$31,$02		DC.B	$00,$03		DC.B	$00,$10		DC.B	$00,$12		DC.B	$48,$12		DC.B	$26,$10		DC.B	$11,$11		DC.B	$00,$11		DC.B	$00,$10		ENDR		END