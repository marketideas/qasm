****************************************************************************************************		MACRO		inc4  &a1		inc		&a1		bne		@a		inc		&a1+2@a 		MEND****************************************************************************************************	MACRO	PH2 &addr,&reg	IF &addr[1:1]='#' AND &SETTING('LONGA')='ON' THEN		pea		|&addr[2:255]	ELSE		IF &addr­'' THEN			IF &reg­'' THEN 				lda		&addr,&reg			ELSE				lda		&addr			ENDIF		ENDIF		pha	ENDIF	MEND****************************************************************************************************	MACRO	PH4 &addr,&offset	IF &addr[1:1]='#' THEN		pea		&addr[2:255]>>16		pea		|&addr[2:255]	ELSEIF &addr[1:1]='[' THEN		ldy		#&offset+2		ph2 &addr,y		ldy		#&offset		ph2 &addr,y	ELSEIF &offset='s' THEN		ph2 &addr+2,s		ph2 &addr+2,s	ELSEIF &offset='' THEN		ph2  &addr+2		ph2  &addr	ELSE		ph2 &addr+2,&offset		ph2 &addr,&offset	ENDIF	MEND****************************************************************************************************	MACRO	SUB2   &a1,&a2,&a3	IF &a1­'' THEN		lda		&a1	ENDIF		sec		sbc		&a2	IF &a3­'' THEN		sta		&a3	ENDIF	MEND****************************************************************************************************	MACRO	PL4 &addr1,&addr2	IF &addr1='' THEN	IF &addr2­'' THEN 		AERROR 'Illegal 2nd parameter'	ENDIF		PL2		PL2	ELSEIF &addr2='' THEN		PL2  &addr1		PL2  &addr1+2	ELSEIF &addr1[1:1]='[' THEN		ldy   #&addr2		PL2  &addr1,y		ldy   #&addr2+2		PL2  &addr1,y	ELSE		PL2  &addr1		sta   &addr2		PL2  &addr1+2		sta   &addr2+2	ENDIF	MEND****************************************************************************************************		MACRO		BLE	&BP		BLT	&BP		BEQ	&BP		MEND****************************************************************************************************	MACRO	longm		rep		#%00100000		longa	on	MEND	MACRO	longx		rep		#%00010000		longi	on	MEND	MACRO	longmx		rep		#%00110000		longa	on		longi	on	MEND****************************************************************************************************	MACRO	shortmx		sep		#%00110000		longa	off		longi	off	MEND	MACRO	shortm		sep		#%00100000		longa	off	MEND	MACRO	shortx		sep		#%00010000		longi	off	MEND****************************************************************************************************		MACRO		JGE	&BP		BLT	@1		BRL	&BP@1		MEND****************************************************************************************************	MACRO	PL2 &addr,&reg		pla	IF &addr­'' THEN		IF &reg­'' THEN			sta		&addr,&reg		ELSE			sta		&addr		ENDIF	ELSEIF &reg­'' THEN 		AERROR 'Illegal 2nd parameter'	ENDIF	MEND****************************************************************************************************		MACRO		_SYSBEEP		LDX	#$2C03		JSL	$E10000		MEND		MACRO		_ClampMouse		ldx	#$1C03		jsl	$E10000		MEND		MACRO		_WRITECHAR		LDX	#$180C		JSL	$E10000		MEND		MACRO		QUIT	&DCB		JSL	$E100A8		DC.w	$29		DC.l	&DCB		MEND		MACRO		_INT2DEC		LDX	#$260B		JSL	$E10000		MEND		MACRO		_Multiply		ldx	#$090B		jsl	$E10000		MEND		MACRO		_SDivide		ldx	#$0A0B		jsl	$E10000		MEND		MACRO		_NewHandle		ldx	#$0902		jsl	$E10000		MEND		MACRO		_QDStartUp		ldx	#$0204		jsl	$E10000		MEND		MACRO		_QDShutDown		ldx	#$0304		jsl	$E10000		MEND		MACRO		_LineTo		ldx	#$3C04		jsl	$E10000		MEND		MACRO		_MoveTo		ldx	#$3A04		jsl	$E10000		MEND		MACRO		_SetSolidPenPat		ldx	#$3704		jsl	$E10000		MEND		MACRO		_ReadMouse		ldx	#$1703		jsl	$E10000		MEND		MACRO		_GetPixel		ldx	#$8804		jsl	$E10000		MEND		MACRO		_EMStatus		ldx	#$0606		jsl	$E10000		MEND		MACRO		_InitMouse		ldx	#$1803		jsl	$E10000		MEND		MACRO		_LONGDIVIDE		LDX	#$0D0B		JSL	$E10000		MEND		MACRO		_LONGMUL		LDX	#$0C0B		JSL	$E10000		MEND		MACRO		_READTIMEHEX		LDX	#$0D03		JSL	$E10000		MEND****************************************************************************************************		macro		subroutine &parms,&work		lclc	&macWork&macWork	setc	&work		IF &work­'' GOTO .a&macWork	setc	'0'.a		gbla	&totallen		gbla	&worklen&worklen	seta	&s2i(&macWork)&totallen	seta	0		IF	&parms='' GOTO .e		lclc	&length		lclc	&p		lcla	&i&i		seta	&NBR(&parms).b&p		setc	&parms[&i]&length		setc	&SubStr(&p,2,1)		IF	&length=':' GOTO .c&length		setc	&SubStr(&p,1,2)&p		setc	&SubStr(&p,4,&len(&p)-3)		GOTO .d.c&length		setc	&SubStr(&p,1,1)&p		setc	&SubStr(&p,3,&len(&p)-2).d&p		equ	&totallen+3+&macWork&totallen	seta	&totallen+&s2i(&length)&i		seta	&i-1		IF	&i GOTO .b.e		tsc		sec		sbc	#&macWork		tcs		inc	a		phd		tcd		mend****************************************************************************************************		macro		return	&r		gbla	&totallen		gbla	&worklen		lclc	&length		lclc	&rr&rr		setc	&r		IF	&r­'' GOTO .a&rr		setc	'0'&length		setc	'0'		GOTO .h.a&length		setc	&SubStr(&rr,2,1)		IF	&length=':' GOTO .b&length		setc	&SubStr(&rr,1,2)&rr		setc	&SubStr(&rr,4,&len(&rr)-3)		GOTO .c.b&length		setc	&SubStr(&rr,1,1)&rr		setc	&SubStr(&rr,3,&len(&rr)-2).c		IF	&s2i(&length)<>2 GOTO .d		ldy	&rr		GOTO .h.d		IF	&s2i(&length)<>4 GOTO .e		ldx	&rr+2		ldy	&rr		GOTO .h.e		IF	&s2i(&length)<>10 GOTO .g		ldy	#&rr		ldx	#^&rr		GOTO .h.g		aerror	'Not a valid return length'		mexit.h		IF	&totallen=0 GOTO .i		lda	&worklen+1		sta	&worklen+&totallen+1		lda	&worklen		sta	&worklen+&totallen.i		pld		tsc		clc		adc	#&worklen+&totallen		tcs		IF	&s2i(&length)=0 GOTO .j		tya.j		rtl		mend****************************************************************************************************