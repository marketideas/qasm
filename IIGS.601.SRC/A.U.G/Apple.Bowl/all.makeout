Set Echo 1RezIIGS Bowl.r -o Apple.Bowldirectory :Compiler:make IntBasicIIGS >makeoutmakeoutdelete makeoutdirectory :::Compiler:IntBasicIIGS Bowl.bas -o Bowl.objAsmIIGS BowlBin.aii -o BowlBin.objAsmIIGS ProgAid.aii -o ProgAid.objDelete -i ProgAid.libMakeLibIIGS -l ProgAid.lib -r ProgAid.objdirectory :Compiler:AsmIIGS BasicLib.aii -o :obj:BasicLib.objDelete -i IntBasicLibMakeLibIIGS -l IntBasicLib -r :obj:BasicLib.objdirectory ::LinkIIGS -w2 -t S16 -l >Bowl.map ¶	Bowl.obj ¶	BowlBin.obj ¶	-lib :compiler:IntBasicLib ¶	-lib ProgAid.lib ¶	-o Apple.BowlDuplicate -d -y Read.Me.txt Read.MeRezIIGS Read.Me.r -o Read.Me -t $70505445 -c pdos