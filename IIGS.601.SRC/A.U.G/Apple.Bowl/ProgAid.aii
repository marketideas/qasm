***************************			 ** Apple-][ Hi-Resolution **  Graphics Subroutines	 **			 **    By	Woz   9/13/77	 **			 **  All Rights Reserved	 **			 **  Converted to	IIGS by	 **  Greg	Branche	7/25/91	 **			 ***************************;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	COLR		IMPORT	ROT		IMPORT	SCALE		IMPORT	SHAPE		IMPORT	ShapeTbl		IMPORT	X0		IMPORT	Y0		IMPORT	collsn;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		ENTRY	bdrawx		ENTRY	cshft2		ENTRY	getx0		ENTRY	gety0		ENTRY	hdraw		ENTRY	hlin		ENTRY	hplot1		ENTRY	hposn		ENTRY	hposn3		ENTRY	hxdraw		ENTRY	pcolr*  Hi-Res Equates; Direct page usagesTblPtr		equ	$00			;pointer to shape tablehColor1		equ	$02			;running color maskCountH		equ	$04HBasL		equ	$06			;base address for current hi-res lineHBasH		equ	HBasl+1HMask		equ	$0ADXL		equ	$0C			;Delta-X for HLin, ShapeDXH		equ	$0DShapeX		equ	$0E			;shape tempDY		equ	$10			;Delty-Y for HLin, ShapeQDRnt		equ	$12			;ROT Quandrant (Shape)EL		equ	$14			;error for HLinEH		equ	$15; soft switch locationsHiRes		equ	$E0C057			;switch	to hi-res videoMixSet		equ	$E0C053			;select	text/graphics mixTxtClr		equ	$E0C050			;select	graphics mode**  Data	area*HPag		RECORD	Export		DS.B	2		ENDRVars		RECORDX0L		DS.B	1X0H		DS.B	1My_Y0		DS.B	2HColor		DS.B	2Hndx		DS.B	2my_scale	DS.B	2my_dp		DS.B	2UserID		DS.B	2msktbl		DC.B	$81			;leftmost bit of byte		DC.B	$82,$84,$88		DC.B	$90,$a0		DC.B	$c0			;rightmost bit of byteeq1c		DC.B	$1ccos		DC.B	$ff,$fe,$fa,$f4,$ec,$e1,$d4,$c5,$b4		DC.B	$a1,$8d,$78,$61,$49,$31,$18,$ff		ENDR* basic_entry -	used to	set up environment when	called from Basicbasic_entry	PROC		with	Vars		plx				;retrieve return address		phb				;save DBR		phk				;set to	our bank		plb		phd				;save caller's direct page		lda	my_dp			;set to	our direct page		tcd		phx				;put return address back on stack		sep	#$30			;shift into 8-bit mode		rts		ENDP* basic_exit - used to restore environment and return to Basicbasic_exit	PROC		rep	#$30			;back to 16-bit	mode		pld				;restore caller's direct page		plb				;and DBR		rtl				;then back to caller		ENDP**  High	Resolution Graphics Inits** entry	points from Apple ][ basicINIT		PROC	EXPORT		with	Vars		longa	on		longi	on		phb				;save caller's DBR		phk				;set to	my variables		plb		pha				;space for returned UserID		ldx	#$0202			;MMStartUp		jsl	$E10000		pla				;retrieve UserID		sta	UserID		pha				;space for handle		pha		pea	0		pea	32			;need 32 bytes for direct page		pha				;UserID	still in accumulator		pea	%1100000000010001	;attributes		pea	0			;bank 0		pea	0		ldx	#$0902			;NewHandle		jsl	$E10000		plx				;retrieve handle		pla		bcc	have_handle		;no errorsdie		brk	0			;else just diehave_handle		phb				;save DBR		pha				;put high word of handle on stack		plb				;reset DBR		lda	|0,x			;deref handle		plb				;restore DBR		plb		sta	my_dp			;save for use later		phd				;save caller's direct page		tcd				;and use mine		pha				;space for handle		pha		pea	0		pea	$4000			;size of hi-res	pages		lda	UserID		pha				;UserID		pea	%1100000000010111	;attributes		pea	$E0			;bank $E0		pea	$2000			;hires buffers at $2000-$5FFF		ldx	#$0902			;NewHandle		jsl	$E10000		plx				;retrieve handle		pla		bcs	die			;die if	we can't get the memory		lda	#$20			;Init for $2000-3fff		sta	HPag			;hi-res	screen memory		sep	#$20		longa	off		lda	>hires			;set hires display mode		lda	>mixset			;with text at bottom		lda	>txtclr			;set graphics display mode		lda	#$E0			;set bank byte of base pointer		sta	hbasl+2		rep	#$20		longa	on		pld				;restore caller's direct page temporarily		plb				;restore caller's DBR		EXPORT	CLEARCLEAR		jsr	basic_entry		;set up	environment		longa	off		longi	off		lda	#$0Bkgnd0		sta	hcolor1			;set for black background		lda	hpag			;init hi-res screen mem		sta	sTblPtr+1		;for current page, normally		ldy	#$0		sty	sTblPtr			;$2000-3fff or $4000-5fff		pea	$E0E0			;set DBR to graphics memory		plb		plb				;set to	video memory bankbkgnd1		lda	hcolor1		sta	(sTblPtr),y		jsr	cshft2			;(sTblPtr) will	specify		iny				;32 separate pages		bne	bkgnd1			;throughout the	init		inc	sTblPtr+1		lda	sTblPtr+1		and	#$1f			;test for done		bne	bkgnd1		jmp	basic_exit		;return	to caller		EXPORT	BKGNDBKGND		jsr	basic_entry		;set up	environment		jsr	pcolr			;background call		bra	bkgnd0		ENDPPOSN		PROC	EXPORT		with	Vars		jsr	basic_entry		;set up	environment		jsr	local_posn		;call the real routine		jmp	basic_exit		;then return		Entry	local_posnlocal_posn		jsr	pcolr			;posn call, colr from basic		sta	hcolor		jsr	gety0			;y0 from basic		pha		jsr	getx0			;x0 from basic		pla		jsr	hposn		rts		ENDPHPLOT		PROC	EXPORT		jsr	basic_entry		;set up	environment		jsr	local_POSN		;plot call (basic)		jsr	hplot1		jmp	basic_exit		ENDPLINE		PROC	EXPORT		with	Vars		jsr	basic_entry		;set up	environment		lda	hndx		lsr	a			;set hcolor1 from		jsr	pcolr			;basic var colr		jsr	hposn3		jsr	getx0			;line call. get	x0 from	basic		txa		pha		tya		tax		jsr	gety0			;y0 from basic		tay		pla		jsr	hlin		jmp	basic_exit		;return	to caller		ENDP* draw routinesDRAW		PROC	EXPORT		jsl	POSN		EXPORT	DRAW1DRAW1		jsr	basic_entry		;set up	environment		jsr	bdrawx			;draw call from	basic		jsr	hdraw		jmp	basic_exit		;return	to caller		ENDPXDRAW		PROC	EXPORT		jsl	POSN		EXPORT	XDRAW1XDRAW1		jsr	basic_entry		;set up	environment		jsr	bdrawx			;ex-or draw		jsr	hxdraw			;from basic		jmp	basic_exit		ENDP* hi-res graphics coordinate restore subroutineFIND		PROC	EXPORT		with	Vars		jsr	basic_entry		;set up	environment		lda	hbasl		asl	a			;converts base adr		lda	hbash			;to y-coord		and	#$3		rol	a			;for hbasl = EABABOOO		ora	hbasl			;    hbash = PPPFGHCD		asl	a		asl	a			;generate		asl	a			;y-coord = ABCDEFGH		sta	My_Y0		lda	hbash			;(PPP=screen page,		lsr	a			;normally 001 for		lsr	a			;$2000-3fff		and	#$7			;hi-res	screen		ora	My_Y0		sta	My_Y0			;converts hndx (index		lda	hndx			;from base adr)		asl	a			;and hmask (bit		adc	hndx			;mask) to x-coord		asl	a			;in (x0l, x0h)		tax				;(range	$0-$133)		dex		lda	hmask		and	#$7fhfind1		inx		lsr	a		bne	hfind1		sta	x0h		txa		clc				;calc hndx*7 +		adc	hndx			;log(base2) hmask		bcc	hfind2		inc	x0hhfind2		sta	x0l		jmp	basic_exit		;return	to caller		ENDP* hi-res graphics position and plot subroutineshposn		PROC		with	vars		sta	My_Y0			;enter with Y in A-reg.		stx	x0l			;xl in x-reg		sty	x0h			;and xh	in y-reg		pha		and	#$c0		sta	hbasl			;for y-coord = 00abcdef		lsr	a			;calculates base address		lsr	a			;in hbasl, hbash for		ora	hbasl			;accessing screen mem		sta	hbasl			;via [hbasl],y addressing mode		pla		sta	hbash		asl	a			;calculates		asl	a			;hbash = pppfghcd,		asl	a			;hbasl = eabab000		rol	hbash		asl	a			;where ppp=001 for $2000-3fff		rol	hbash			;screen	mem range and		asl	a			; ppp=010 for $4000-5fff		ror	hbasl			;(given	y-coord=abcdefgh)		lda	hbash		and	#$1f		ora	hpag		sta	hbash		txa				;divide	x0 by 7	for		cpy	#$0			;index from base addr		beq	hposn2			;(quotient) and	bit		ldy	#$23			;within	screen mem byte		adc	#$4			;(mask spec'd by remainder)hposn1		inyhposn2		sbc	#$7			;subtract out sevens		bcs	hposn1		sty	hndx			;works for x0 from		tax				;0 to 279, low-order		lda	msktbl-249,x		;byte in x-reg		sta	hmask			;high in y-reg on entry		tya		lsr	a			; if on	odd byte (carry	set)		lda	hcolor			;then rotate hcolor one		ENTRY	hposn3hposn3		sta	hcolor1			;bit for 180 degree shift		bcs	to_cshft2		;prior to copying to hcolor1		rtsto_cshft2	jmp	cshft2		ENDPhplot1		PROC		lda	hcolor1			;calc bit posn in hbasl,h		eor	[hbasl],y		;hndx, and hmask from		and	hmask			;y-coord in a-reg.		eor	[hbasl],y		;x-coord in x,y-regs		sta	[hbasl],y		;for any 'l' bits of hmask		rts				;substitute corrpesponding bit of hcolor1		ENDP* hi-res graphics l,r,u,d subroutineslftrt		PROC		with	Vars		bpl	right			;use sign for lft/rt selectleft		lda	hmask		lsr	a			;shift low-order		bcs	left1			;7 bits	of hmask		eor	#$c0			;one bit to lsblr1		sta	hmask		rtsleft1		dey				;decr horiz index		bpl	left2		ldy	#$27			;wrap around screenleft2		lda	#$c0			;new hmask, rightmostnewndx		sta	hmask			;dot of	byte		sty	hndx			;update	horiz indexcshift		lda	hcolor1		ENTRY	cshft2cshft2		asl	a			;rotate	low-order		cmp	#$c0			;7 bits	of hcolor1		bpl	rts1			;one bit posn		lda	hcolor1		eor	#$7f			;zxyxyxyx -> zyxyxyxy		sta	hcolor1rts1		rtsright		lda	hmask		asl	a			;shift low-order		eor	#$80			;7 bits	of mask		bmi	lr1			;one bit to msb		lda	#$81		iny				;next byte		cpy	#$28		bcc	newndx		ldy	#$0			;wrap around screen if >279		bcs	newndx			;always	taken* l,r,u,d, subroutines		ENTRY	lrudx1lrudx1		clc				;no 90 deg rot (x-or)		ENTRY	lrudx2lrudx2		lda	shapex		and	#$4			;if b2=0 then no plot		beq	lrud4		lda	#$7f			;for ex-or into	screen mem		and	hmask		and	[hbasl],y		;screen	bit set?		bne	lrud3		inc	collsn		lda	#$7f		and	hmask		bpl	lrud3			;always	taken		ENTRY	lrud1lrud1		clc				;no 90-deg rot		ENTRY	lrud2lrud2		lda	shapex		and	#$4			;if b2=0 then no plot		beq	lrud4		lda	[hbasl],y		eor	hcolor1			;set hi-res screen bit		and	hmask			;to corresponding hcolor1		bne	lrud3			;if bit	of screen changes		inc	collsn			;then incr collsn detectlrud3		eor	[hbasl],y		sta	[hbasl],ylrud4		lda	shapex			;add qdrnt to		adc	qdrnt			;specified vector		and	#$3			;and move lft, rteq3		equ	*-1			;up, down based		cmp	#$2			;on sign and carry		ror	alrud		bcs	lftrtupdwn		bmi	down4			;sign for up/dwn selectup		clc		lda	hbash			;calc base address		bit	eq1c			;(adr of leftmost byte)		bne	up4			;for next line up		asl	hbasl			;in (hbasl, hbash)		bcs	up2			;with 192-line wraparound		bit	eq3		beq	up1		adc	#$1F			;***** bit map *****		sec		bcs	up3			;for row = ABCDEFGHup1		adc	#$23		pha		lda	hbasl			;hbasl = EABAB000		adc	#$b0			;hbash = PPPFGHCD		bcs	up5		adc	#$f0			;where PPP=001 for primaryup5		sta	hbasl			;hi-res	page ($2000-3fff)		pla		bcs	up3up2		adc	#$1fup3		ror	hbaslup4		adc	#$fcupdwn1		sta	hbash		rtsdown		clcdown4		lda	hbash		adc	#$4			;calc base adr for next	lineeq4		equ	*-1			;down to (hbasl, hbash)		bit	eq1c		bne	updwn1		asl	hbasl			;with 192-line wraparound		bcc	down1		adc	#$e0		clc		bit	eq4		beq	down2		lda	hbasl		adc	#$50		eor	#$f0		beq	down3		eor	#$f0down3		sta	hbasl		lda	hpag		bcc	down2down1		adc	#$e0down2		ror	hbasl		bcc	updwn1* hi-res graphics line draw subroutineshlinrl		stz	x0l			;set (x0l,x0h) and y0 to zero for		stz	x0h			;rel line draw		stz	My_Y0			;(dx, dy)		ENTRY	hlinhlin		pha				;on entry		sec				;xl: a-reg		sbc	x0l			;xh: x-reg		pha				; y: y-reg		txa		sbc	x0h		sta	qdrnt			;calc abs(x-x0)		bcs	hlin2			;in (dxl, dxh)		pla		eor	#$ff			;x dir to sign bit		adc	#$1			;of qdrnt		pha				;0=right (dx pos)		lda	#$0			;1=left	(dx neg)		sbc	qdrnthlin2		sta	dxh		sta	eh			;init (el,eh) to		pla				;abs(x-x0)		sta	dxl		sta	el		pla		sta	x0l		stx	x0h		tya		clc		sbc	My_Y0			;calc -abs(y-0)-1		bcc	hlin3			;in dy		eor	#$ff		adc	#$fehlin3		sta	dy			;rotate	y dir into		sty	My_Y0			;qdrnt sign bit		ror	qdrnt			;(0=up,	1=down)		sec		sbc	dxl			;init (countl, counth)		tax				;to -(deltx+delty+1)		lda	#$ff		sbc	dxh		sta	counth		ldy	hndx			;horiz index		bcs	movex2			;always	takenmovex		asl	a			;move in x-dir use		jsr	lftrt			;qdrnt b6 for lft/rt select		secmovex2		lda	el			;assume	carry set		adc	dy			;(el,eh)-delty to (el,eh)		sta	el			;note: dy is (-delty)-1		lda	eh			;carry clr if (el,eh)		sbc	#$0			;goes neghcount		sta	eh		lda	[hbasl],y		;screen	byte		eor	hcolor1			;plot dot of hcolor1		and	hmask			;current bit mask		eor	[hbasl],y		sta	[hbasl],y		inx				;done (deltx+delty)		bne	hlin4			;dots?		inc	counth		bne	hlin4			;no, continue		rtshlin4		lda	qdrnt			;for direction test		bcs	movex			;if car	set, (el,eh) pos		jsr	updwn			;if clr, neg, move ydir		clc		lda	el			;(el,eh)+deltx		adc	dxl			;to (el,eh)		sta	el		lda	eh			;car set if (el,eh) goes pos		adc	dxh		bvc	hcount			;always	taken		ENDP* hi-res graphics shap draw subr** shape	draw* r = 0	to 63* scale	factor used (1=normal)*hdraw		PROC		with	Vars		stx	sTblPtr			;draw definition pointer		sty	sTblPtr+1hdraw1		tax		lsr	a			;rot ($0-$3f)		lsr	a		lsr	a			;qdrnt 0=up, 1=rt		lsr	a			;2=dwn,	3=lft		sta	qdrnt		txa		and	#$f		tax		ldy	cos,x			;save cos and sin		sty	dxl			;vals in dxl and dy		eor	#$f		tax		ldy	cos+1,x		iny		sty	dyhdraw2		ldy	hndx			;byte index from hi-res	base address		stz	collsn			;clear collision count		phb				;save DBR		pea	ShapeTbl>>8		;set DBR to shape table	bank		plb		plb		lda	(sTblPtr)		;1st shape def bytehdraw3		plbhdraw3_1	sta	shapex		ldx	#$80		stx	el			;el,eh for fractional		stx	eh			;l,r,u,d vectors		ldx	my_scale		;scale factor.hdraw4		lda	el		sec				;if frac cos ovfl		adc	dxl			;then move in		sta	el			;specified vector		bcc	hdraw5			;direction		jsr	lrud1		clchdraw5		lda	eh			;if frac sin ovfl		adc	dy			;then move in		sta	eh			;specified vector		bcc	hdraw6			;direction +90 deg		jsr	lrud2hdraw6		dex				;loop on scale		bne	hdraw4			;factor		lda	shapex		lsr	a			;next 3-bit vector		lsr	a			;of shape def.		lsr	a		bne	hdraw3_1		;not done this byte		inc	sTblPtr			;next byte of shape definition		bne	hdraw7		inc	sTblPtr+1hdraw7		phb				;save DBR		pea	ShapeTbl>>8		plb		plb		lda	(sTblPtr,x)		bne	hdraw3			;done if zero		plb		rts		ENDP* hi-res graphics shape	ex-or subroutine** ex-or	shape into screen** rot =	0 to 3 (quandrant only)* scale	is used*hxdraw		PROC		with	Vars		stx	sTblPtr			;shape definition pointer		sty	sTblPtr+1hxdraw1		tax		lsr	a			;rot ($0-$3f)		lsr	a		lsr	a			;qdrnt 0=up, 1=rt		lsr	a			;      2=dwn, 3=lft		sta	qdrnt		txa		and	#$f		tax		ldy	cos,x			;save cos and sin		sty	dxl			;vals in dxl and dy		eor	#$f		tax		ldy	cos+1,x		iny		sty	dyhxdraw2		ldy	hndx			;index from hi-res base	adr		stz	collsn			;clear collision detect		phb		pea	ShapeTbl>>8		plb		plb		lda	(sTblPtr)		;1st shape def bytehxdraw3		plbhxdraw3_1	sta	shapex		ldx	#$80		stx	el			;el,eh for fractional		stx	eh			;l,r,u,d vectors		ldx	my_scale		;scale factor.hxdraw4		lda	el		sec				;if frac cos ovfl		adc	dxl			;then move in		sta	el			;specified vector		bcc	hxdraw5			;direction		jsr	lrudx1		clchxdraw5		lda	eh			;if frac sin ovfl		adc	dy			;then move in		sta	eh			;specified vector		bcc	hxdraw6			;direction +90 deg		jsr	lrudx2hxdraw6		dex				;loop on scale		bne	hxdraw4			;factor		lda	shapex		lsr	a			;next 3-bit vector		lsr	a			;of shape def.		lsr	a		bne	hxdraw3_1		;not done this byte		inc	sTblPtr			;move to next byte		bne	hxdraw7		inc	sTblPtr+1hxdraw7		phb		pea	ShapeTbl>>8		plb		plb		lda	(sTblPtr,x)		bne	hxdraw3			;done if zero		plb		rts		ENDPbdrawx		PROC		with	Vars		lda	>SCALE			;SCALE from BASIC		sta	my_scale		lda	>ROT			;ROTation from BASIC		pha				;save on stack		lda	#<ShapeTbl		sta	sTblPtr			;start of shape	table		lda	#>ShapeTbl		sta	sTblPtr+1		phb				;save our DBR		pea	ShapeTbl>>8		;put table's bank on stack		plb		plb				;and set DBR to	it		lda	>SHAPE			;Shape from BASIC		beq	skip_it		cmp	(sTblPtr)		;>num of shapes?		beq	bdrwx1		bcs	skip_it			;yes, range errorbdrwx1		asl	a		bcc	bdrwx2		inc	sTblPtr+1		clcbdrwx2		tay				;shape no * 2		lda	(sTblPtr),y		;add 2-byte index to shape table		adc	sTblPtr			;start address		tax		iny		lda	(sTblPtr),y		adc	sTblPtr+1		tayskip_it		plb		pla				;rot from stack		rts		ENDP* basic	param fetch subroutinespcolr		PROC		lda	>COLR+1			;BASIC COLR variable		bne	rerr1		lda	>COLRrtsb		rts		ENTRY	getx0getx0		lda	>X0			;BASIC variable	low order byte		tax		lda	>X0+1			;hi order byte		tay		cpx	#$18		sbc	#$1			;range err if >279		bcc	rtsbrerr1		brk	0		ENTRY	gety0gety0		lda	>Y0			;BASIC variable		cmp	#$c0			;(err if > 191)		bcs	rerr1		rts		ENDP		END