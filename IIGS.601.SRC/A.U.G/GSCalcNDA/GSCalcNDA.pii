{ ------------------------------------------------------------------------------------REVISION HISTORYSystem 6.0  1.0d19	DDH	-First official build  1.0d20	DDH  	-Changed 'Ok' to 'OK' on dialog button	-Changed copyright to reflect 1989-90  1.0d22	DAL (Dave Lyons) 11..13-Dec-90	-Converted to Max Pascal	-Added SetOriginMask on the window	-Removed TML copyright from the about box (we're in Max Pascal now)	-Sets window background pattern instead of doing a PaintRect at Update time	-Draws controls in update, never in Activate	-Doesn't unload tools at NDA Close time	-SANE direct page is page-aligned and has the NDA's memory ID (not $5A00)	-now properly shuts down SANE and disposes of handle at DeskShutDown time	-Apple-W and Apple-w close the NDA	-Improved timing of hiliting buttons on keyboard operations	-Cleaned up source code quite a bit	-Centered the about box and made it fully visible in 320 mode	-"h" or "H" toggles in and out of Hex mode	-Apple-c and Apple-x are key equivalents to Copy and Cut (put result onto clipboard)	-Fixed bug where decimal point would show up inside "INF" and "NaN(00x)" results	-Beeps twice if we don't have the right system version (QD must be at least 3.7)	-First attempt at allowing chaining (3 * 2 = = gives 12)	-The buttons no longer go inactive when the window isn't in front (updates faster)	- / = is now a reciprocal function (1/x)  1.0d22	DAL 6-Jan-91    -Make the Hex key controls have capital letters for their names.  1.0d23	DAL 17-Jan-91    -Made the About box really on the screen in 320 mode this time.	-Changed "NAN" display to read "Not a number".	-Changed "INF" display to read "Infinity".	-Hitting "0" after "Clear" no longer beeps.	-The background is now red in both 640 and 320 now (it was blue in 320 before).  1.0d24	DAL 27-Jan-91    -Calls WindowGlobal around the about box to make the main window stay hilited.  1.0d24	DAL 28-Jan-91    -Fix the 320-mode About window again.  This time it was off the top of the	 screen.  1.0d28    DAL 5-Mar-91    -Changed the menu name and window title from "GS Calculator" to "Calculator".  1.0d33	DAL 18-Apr-91    -Add zoom box to reveal hex keys.  Updates own zoom rectangle during run	 events!  Z zooms window.	-This moves coordinates up by $22 for the regular buttons and the display.	-Move initial window position down by $11 pixels.	-Changed some SysBeep calls into SysBeep2 calls.  1.0d35	DAL 5-May-91    -Moved initialization of calcMode to work correctly on open.  1.0d40	DAL 17-Jun-91    -No longer masking off bit 7 of key strokes, so Option-x keys don't do	 weird stuff any more.  1.0d41	DAL 23-Jun-91    -Fixed bug where we would forget we started SANE (or Integer Math) on the	 second time we are opened.	-Removed code for loading and starting Integer Math, since it isn't really	 needed at present.	-Removed some old crusty I-changed-this-today comments.	-The about box updates now.  1.0d43	DAL 4-Jul-91    -Handle our own window zooming by accepting Action code number 10, instead	 of kludging our zoom rectangle during Run events.  1.0d45	DAL 24-Jul-91    -Set my window's FontFlags to $0004 to allow 16-color text, and set the	 text background color to yellow around all the display DrawString calls.  1.0d52	DAL 2-Oct-91    -Allow Pasting of text.	-Window opens in same zoom state as last time you closed it.	-Fixed a mess of bugs where the display would be out of sync with	 what it would update to, if you forced it to update.  1.0d53	DAL 11-Oct-91    -Changed two Rounds to Truncs so that Hex calculations don't round up.  1.0d55	DAL 25-Oct-91    -Hitting Clear in Hex mode no longer gives you "0." (which was converting	 into -2 if you switched to decimal or hit equals).	-No longer initializes calcMode to decimal on open (mode is preserved).  1.0d60	DAL 2-Dec-91    -Cut now does a Clear.	-Command-V now works reliably for paste.  1.0d60	DAL 4-Dec-91    -Changed ScrapStatus to myScrapStatus so I can check _toolErr!  1.0		DAL 5-Feb-92 (for 6.0d70)    -Changed version to 1.0, copyright to include 92.------------------------------------------------------------------------------------System 6.0.1    1.1d12	23-Nov-92 DAL    -Changed version to 1.1d12.	-Disables the Undo item in the Edit menu (if it's not there or has a	 nonstandard item ID, no big loss, nothing happens).	   1-Apr-93 SS -- Changed version to 1.1 (release)}UNIT GSCalc;INTERFACEUSES	Types, Locator, Memory, MiscTool, QuickDraw, Events, IntMath, SANE, Controls,    Windows, Menus, Dialogs, Scrap, Desk;{$Z+} { Export these procedures and functions. These are in the assembly file. }  FUNCTION NDAOpen: WindowPtr;    PROCEDURE NDAClose;    FUNCTION NDAAction(code: integer; param: EventRecordPtr): integer;  PROCEDURE NDAInit(code: integer);{$Z-}IMPLEMENTATIONCONST	windowHeight = 117;	windowTop    =  50;	windowBottom = 167;		DisplayCol	=  20;	DisplayRow	=  16;	Row1		=  26;	Row2		=  43;	Row3		=  60;	Row4		=  77;	Row5		=  94;	Column1		=  20;	Column2		=  60;	Column3		= 100;	Column4		= 140;	Column5		= 200;	Column6		= 240;	NumButtons	=  25;	ctlFlags	=  2;	{ square buttons for most digits }	Enter		=  13;	CtrlX		=  24;	ESC			=  27;	beepBadKey	=  8;	beepBadInputValue = 9;	beepFieldFull = 10;	beepImpossible = 11;TYPE	SysClickRecPtr = ^SysClickRec;	SysClickRec = RECORD		result: integer;		FindWindowValue: integer;		Window: WindowPtr;		Event: EventRecordPtr;	END;procedure	MakeCtrls;		forward;procedure	Conv2Dec;		forward;procedure	Conv2Hex;		forward;procedure	SwitchCMode;	forward;procedure	BlankDisplay;	forward;procedure	ShowResults;	forward;procedure	ConvertVal;		forward;procedure	DoFunction(Operator: integer; ChainFlag: boolean); forward;procedure	DoPlus;			forward;procedure	DoMinus;		forward;procedure	DoMultiply;		forward;procedure	DoDivide;		forward;procedure	DoEqual;		forward;procedure	DoHexChrs;		forward;procedure	DoClear;		forward;procedure	DoPeriod;		forward;procedure   DoAbout;		forward;procedure   CLoadTools;		forward;procedure   CUnloadTools;	forward;procedure	DoEditCopy;		forward;function	DoEditPaste: boolean;	forward;PROCEDURE mySANEStartUp(dPageAddr:Integer);	INLINE $020AA2,$E1000022;PROCEDURE mySANEShutDown;					INLINE $030AA2,$E1000022;FUNCTION  mySANEStatus : Integer;			INLINE $060AA2,$E1000022,$03B0,$0000A9,$8F,'_toolErr';FUNCTION  myScrapStatus: Integer;			INLINE $0616A2,$E1000022,$03B0,$0000A9,$8F,'_toolErr';procedure debug; inline $0000;VAR	myWindOpen:  boolean;	myWind:	     ParamList;	myWindPtr:   WindowPtr;	myWindowTitle: string[20];	windowZoomed: boolean;	RectPtrX:	rect;	Chandle:	array[0..25] of CtlRecHndl;	DataString:	DecStr;	DataString2: string;	IData:		integer;	theKey, LastKey:	signedbyte;	NumPeriods:	integer;	MyLong:		longint;	MyReal1, MyReal2, ChainConstant: extended;	OtherKey:	integer;	CalcMode:	(modeDecimal, modeHex);	Myrect:		rect;	Operator, ChainOperator: integer; { operation to perform }	MinusKey:	integer;	GotFirstOperand:	boolean;	ITemp:		integer;	AppleMenuStr:	Str255;	WeStartedSANE: boolean;	ToolZP:			Handle;	statustool: 	integer;	btnA, btnB, btnC, btnD, btnE, btnF: String[1];	btnDec, btnHex, btnClr: String[3];	btn0, btn1, btn2, btn3, btn4, btn5, btn6, btn7, btn8, btn9, btnDot, btnEqual,		btnMinus, btnPlus, btnTimes, btnDivide, btnEqual2: String[1];	btnOK: string[2];procedure DrawTheWindow;	forward;procedure DrawTheDisplay;	forward;procedure ClearAll;			forward;procedure AddInKey;			forward;function BadSystemVersion: boolean;var	qdVers: integer;begin	qdVers := band($0fff,QDVersion);	BadSystemVersion := (qdVers < $0307);end;{ required the port set to my window }procedure ToggleWindowSize;var	r: rect;	newWidth: integer;	pt: point;begin	GetPortRect(r);	if r.right < 280 then begin		newWidth := 292;		windowZoomed := true;	end else begin		newWidth := 198;		windowZoomed := false;	end;	SizeWindow(newWidth,r.bottom,myWindPtr);	pt.h := 0; pt.v := 0;	LocalToGlobal(pt);	if (pt.h + newWidth) < 20 then begin { oops, off left edge! }		if band(GetMasterSCB,$80)<>0 then pt.h := 50 else pt.h := 14;		MoveWindow(pt.h,pt.v,myWindPtr);	end;end;function NDAOpen: WindowPtr;var	origPort: GrafPortPtr;begin	if BadSystemVersion then begin		NDAOpen := nil;		SysBeep;		SysBeep;		exit(NDAOpen);	end;	origPort := GetPort;	myWindowTitle := ' Calculator ';	with myWind do begin		paramLength  := sizeof(ParamList);		wFrameBits	  := $C188; { zoom box = $0100! }		wTitle	      := @myWindowTitle;		wRefCon      := 0;		wZoom.top    := 0;		wZoom.left   := 0;		wZoom.bottom := 0;		wZoom.right  := 0;		wColor	     := nil;		wYOrigin     := 0;		wXOrigin     := 0;		wDataH	     := 0;		wDataW	     := 0;		wMaxH	     := 0;		wMaxW	     := 0;		wScrollVer   := 0;		wScrollHor   := 0;		wPageVer     := 0;		wPageHor     := 0;		wInfoRefCon  := 0;		wInfoHeight  := 0;		wFrameDefProc:= nil;		wInfoDefProc := nil;		wContDefProc := nil;		wPosition.top    := windowTop;		wPosition.left   := 50;		wPosition.bottom := windowBottom; { 191; }		if windowZoomed then			wPosition.right := 342 { 292+50 }		else			wPosition.right := 248 { 50+198 };		if band(GetMasterSCB,$80)=0 then OffsetRect(wPosition,14-50,0);		wPlane	   	  := WindowPtr(-1);		wStorage	  := nil;	end;	myWindPtr := NewWindow(myWind);	SetPort(myWindPtr);	SetSysWindow(myWindPtr);	SetFontFlags(4); { allow 16-color text }	SetOriginMask($fffe,myWindPtr);	if band(GetMasterSCB,$0080)<>0 then		SetBackPat(PatternPtr(LongInt(Get640Colors)+4*32)^)  { color 4 in 640 mode = red }	else		SetBackPat(PatternPtr(LongInt(Get640Colors)+7*32)^);	{ color 7 in 320 mode = red }	CLoadTools;	MakeCtrls; { Make the controls and load tools }	ShowWindow(myWindPtr);	DoClear;				{ 13-Dec-90 DAL }{	CalcMode := modeDecimal; removed 25-Oct-91 DAL }	ShowResults;	NDAOpen    := myWindPtr;	myWindOpen := true;	SetPort(origPort);end; { of NDAOpen }procedure NDAClose;var Mcount:	integer;begin   CloseWindow(myWindPtr);   myWindOpen := false;end;procedure DoKeyDown(param: EventRecordPtr);var	theAppleKey: boolean;begin	lastKey := theKey;	theKey := band(LoWord(param^.message),$00ff);	theAppleKey := band(param^.modifiers,$0100)<>0; { Apple key }	if theAppleKey then begin		if (theKey=integer('?')) or (theKey=integer('/')) then begin			DoAbout;			exit(DoKeyDown);		end;{		if (theKey=integer('w')) or (theKey=integer('W')) then begin			CloseNDAByWinPtr(myWindPtr);			exit(DoKeyDown);		end;}		if (theKey=integer('c')) or (theKey=integer('C')) then begin			DoEditCopy;			exit(DoKeyDown);		end;		if (theKey=integer('x')) or (theKey=integer('X')) then begin			DoEditCopy;			DoClear;			exit(DoKeyDown);		end;		if (theKey=integer('v')) or (theKey=integer('V')) then begin			if not DoEditPaste then SysBeep2(beepImpossible);			exit(DoKeyDown);		end;		if (theKey=integer('z')) or (theKey=integer('Z')) then begin			SysBeep2(beepImpossible);			exit(DoKeyDown);		end;		exit(DoKeyDown);	end;	{ First check for numbers 0-9 }	if (theKey>=integer('0')) and (theKey<=integer('9')) then begin		ITemp := theKey-integer('0');		HiliteControl(2,CHandle[ITemp]);		AddInKey;		HiliteControl(0,CHandle[ITemp]);		MinusKey := 1;			exit(DoKeyDown);	end; { of 48 to 58 }	if (theKey>=integer('a')) and (theKey<=integer('f')) then		theKey := integer(theKey)-32;	if ((theKey>=integer('A')) and (theKey<=integer('F'))) then begin		DoHexChrs;		exit(DoKeyDown);	end;	{ Now check for 'Clear' }	if (theKey=CtrlX) or (theKey=ESC) then begin		HiliteControl(2,Chandle[16]);		DoClear;		HiliteControl(0,Chandle[16]);		exit(DoKeyDown);	end;						if theKey=integer('=') then begin		HiliteControl(2,Chandle[17]);		DoEqual;		HiliteControl(0,Chandle[17]);		exit(DoKeyDown);	end;	if theKey=Enter then begin		HiliteControl(2,Chandle[23]);		DoEqual;		HiliteControl(0,Chandle[23]);{		OtherKey := 1; }{		theKey := 0;   }		exit(DoKeyDown);	end;				if theKey=integer('/') then begin		HiliteControl(2,Chandle[18]);		DoDivide;		HiliteControl(0,Chandle[18]);		exit(DoKeyDown);	end;				if theKey=integer('*') then begin		HiliteControl(2,Chandle[19]);		DoMultiply;		HiliteControl(0,Chandle[19]);		exit(DoKeyDown);	end;			if theKey=integer('+') then begin		HiliteControl(2,Chandle[20]);		DoPlus;		HiliteControl(0,Chandle[20]);		exit(DoKeyDown);	end;			if theKey=integer('-') then begin		HiliteControl(2,Chandle[21]);		DoMinus;		HiliteControl(0,Chandle[21]);		exit(DoKeyDown);	end;			if theKey=integer('.') then begin		HiliteControl(2,Chandle[22]);		DoPeriod;		HiliteControl(0,Chandle[22]);		exit(DoKeyDown);	end;	if (theKey=integer('h')) or (theKey=integer('H')) then begin		SwitchCMode;		exit(DoKeyDown);	end;	if (theKey=integer('z')) or (theKey=integer('Z')) then begin		ToggleWindowSize;		exit(DoKeyDown);	end;end; { of DoKeyDown }procedure DoMouseDown(param: EventRecordPtr);var	ptx:		integer;	pty:		integer;	WhichWin:	integer;	FoundWin:	WindowPtr;	I:			integer;	FoundPart: integer;	FoundCP:	CtlRecHndl;	Ptxy:		point;begin	lastKey := theKey;	theKey := 0;	ptx := param^.where.h;	pty := param^.where.v;	WhichWin := FindWindow(FoundWin,ptx,pty);	WhichWin := band(WhichWin,$7fff);	if WhichWin = wInContent then begin		FoundPart := FindControl(FoundCP,ptx,pty,myWindPtr);		case FoundPart of			2: begin { 2 is simple button part code }				for i := 0 to NumButtons do begin					if FoundCP = CHandle[i] then begin						if TrackControl(ptx,pty,nil,CHandle[i])=2 then begin							theKey := integer('0')+i;							if i>9 then theKey := theKey+7;							HiliteControl(0,CHandle[i]);													if i=22 then theKey := integer('.');							if i=21 then theKey := integer('-');							if (i=23) or (i=17) then theKey := integer('=');							if (i=18) then theKey := integer('/');							if (i<16) then begin									AddInKey;								OtherKey := 0;							end;							{ ### What's going on here?  Are we handling '.' and '-' twice? }							case i of								16:DoClear;								17:DoEqual;								18:DoDivide;								19:DoMultiply;								20:DoPlus;								21:DoMinus;								22:DoPeriod;								23:DoEqual;								24:SwitchCMode;								25:SwitchCMode;							end; { of case }						end; { of trackcontrol }					end; { of if CHandle }					end; { of for i }			end; { of case 2 }		end; { of case FoundPart }		{ ### should really use GlobalToLocal here--it's possible to slide onto the Apple }		GetMouse(ptxy);		ptx := Ptxy.h;		pty := Ptxy.v;		if (ptx<18) and (pty>106 ) then DoAbout;	end; { of if in wInContent }end; { of mousedown }{  DoEditCopy -- put the contents of the display onto the clipboard as a Text scrap,                if the Scrap Manager is active}procedure DoEditCopy;var	started: integer;begin	{ copy the result onto the clipboard }	started := myScrapStatus;	if (_toolErr<>0) or (started=0) then exit(DoEditCopy);	ZeroScrap;	PutScrap( integer(DataString2[0]), textScrap, @DataString2[1] );end;{  DoEditPaste -- use the clipboard contents as keyboard input,  				 return True if successful}function DoEditPaste: boolean;type	CharArray = packed array[1..65535] of char;	CharArrayPtr = ^CharArray;	CharHandle = ^CharArrayPtr;var	started: integer;	i, size: longint;	theText: CharHandle;	eventRec: EventRecord;begin	DoEditPaste := false; { anticipate failure }	started := myScrapStatus;	if (_toolErr<>0) or (started=0) then exit(DoEditPaste);	size := GetScrapSize(0);	if (_toolErr<>0) then exit(DoEditPaste);	eventRec.what := keyDownEvt;	eventRec.modifiers := 0; { 2-Dec-91 DAL }	theText := CharHandle(GetScrapHandle(0));	for i := 1 to size do begin		eventRec.message := integer(theText^^[i]);		DoKeyDown(@eventRec);	end;	DoEditPaste := true;end;function NDAAction(Code: Integer; Param: EventRecordPtr): integer;var	currPort:	GrafPortPtr;	p: SysClickRecPtr;begin	NDAAction := 0;	currPort := GetPort;	SetPort(GrafPortPtr(myWindPtr));	case Code of		eventAction: begin			Case param^.what of				updateEvt: begin					BeginUpdate(myWindPtr);					DrawTheWindow;					EndUpdate(myWindPtr);				end; { of UpdateEvt }				keyDownEvt, autoKeyEvt:					DoKeyDown(param);				mouseDownEvt:					DoMouseDown(param);				activateEvt:					DisableMItem(250); { disable the Undo item }			end; { of Case What }		end; { of case eventAction }		undoAction: begin			SysBeep2(beepImpossible);			NDAAction := 1;		end;		cutAction: begin			DoEditCopy;			DoClear;			NDAAction := 1;		end;		copyAction: begin			DoEditCopy;			NDAAction := 1;		end;		pasteAction: begin			NDAAction := 1;			if not DoEditPaste then				SysBeep2(beepImpossible);		end;				clearAction: begin			DoClear;			NDAAction := 1;		end;		10 { sysClickAction } : begin			p := SysClickRecPtr(param);			if p^.findWindowValue = $0017 { wInZoom } then begin				if TrackZoom(p^.Event^.where.h,p^.Event^.where.v,myWindPtr) then					ToggleWindowSize;				p^.result := 1;			end;			NDAAction := 0; { doesn't matter }		end;	end;	SetPort(currPort);end; { of DAAction }procedure NDAInit(Code: Integer);begin   if Code = 0 then begin      {	A DeskShutDown Call, chk that my window	is closed }      if myWindOpen then NDAClose;      CUnLoadTools; {unload the toolset if we loaded it last}   end else	begin      {	A DeskStartUp Call }	  WeStartedSANE := false;      myWindOpen := false;   end;end;procedure DrawTheWindow;var	i: 	integer;begin	MoveTo(6,115);  { was 6,149 }	SetTextMode(4);	SetForeColor($ffff);	DrawChar(chr(17));	SetForeColor(0);	SetTextMode(0);	DrawControls(MyWindPtr);	BlankDisplay; { draw blank display area }	DrawTheDisplay;end;{--------------------------------------------------------------Name:		MakeCtrls;Purpose:	To make the button controls---------------------------------------------------------------}procedure MakeCtrls;var	ll:	integer;	kk:	ptr;	myccolor: bttnColors;	mycptr: ptr;	hexHilite: integer;  { added 25-Oct-91 DAL }begin	if calcMode = modeDecimal then		hexHilite := $FF02 { dimmed }	else		hexHilite := $0002;	{--Do Buttons--}	kk := Pointer($00000000); {Button type control}	mycptr := @myccolor;	myccolor.bttnOutline := $ffff;	myccolor.bttnNorBack := $ffff;	myccolor.bttnSelBack := $ffff;	myccolor.bttnNorText := $ffff;	myccolor.bttnSelText := $ffff;		btnA := 'A';	btnB := 'B';	btnC := 'C';	btnD := 'D';	btnE := 'E';	btnF := 'F';	btn0 := '0';	btn1 := '1';	btn2 := '2';	btn3 := '3';	btn4 := '4';	btn5 := '5';	btn6 := '6';	btn7 := '7';	btn8 := '8';	btn9 := '9';	btnDec := 'Dec';	btnHex := 'Hex';	btnClr := 'Clr';	btnDot := '.';	btnEqual := '=';	btnMinus := '-';	btnPlus := '+';	btnTimes := '*';	btnDivide := '/';	btnEqual2 := '=';		SetRect(RectPtrX,Column5,Row2,0,0);	Chandle[10] := NewControl(myWindPtr,RectPtrX,@btnA,hexHilite,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column6,Row2,0,0);	Chandle[11] := NewControl(myWindPtr,RectPtrX,@btnB,hexHilite,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column5,Row3,0,0);	Chandle[12] := NewControl(myWindPtr,RectPtrX,@btnC,hexHilite,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column6,Row3,0,0);	Chandle[13] := NewControl(myWindPtr,RectPtrX,@btnD,hexHilite,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column5,Row4,0,0);	Chandle[14] := NewControl(myWindPtr,RectPtrX,@btnE,hexHilite,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column6,Row4,0,0);	Chandle[15] := NewControl(myWindPtr,RectPtrX,@btnF,hexHilite,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column5,Row1,Column5+37,Row1+14);	Chandle[24] := NewControl(myWindPtr,RectPtrX,@btnDec,band($ff00,hexHilite),0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column6,Row1,Column6+37,Row1+14);	Chandle[25] := NewControl(myWindPtr,RectPtrX,@btnHex,$ff00-band($ff00,hexhilite),0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column1,Row1,Column1+37,Row1+14);	Chandle[16] := NewControl(myWindPtr,RectPtrX,@btnClr,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column2,Row1,0,0);	Chandle[17] := NewControl(myWindPtr,RectPtrX,@btnEqual,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column3,Row1,0,0);	Chandle[18] := NewControl(myWindPtr,RectPtrX,@btnDivide,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column4,Row1,0,0);	Chandle[19] := NewControl(myWindPtr,RectPtrX,@btnTimes,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column1,Row2,0,0);	Chandle[7] := NewControl(myWindPtr,RectPtrX,@btn7,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column2,Row2,0,0);	Chandle[8] := NewControl(myWindPtr,RectPtrX,@btn8,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column3,Row2,0,0);	Chandle[9] := NewControl(myWindPtr,RectPtrX,@btn9,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column4,Row2,0,0);	Chandle[20] := NewControl(myWindPtr,RectPtrX,@btnPlus,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column1,Row3,0,0);	Chandle[4] := NewControl(myWindPtr,RectPtrX,@btn4,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column2,Row3,0,0);	Chandle[5] := NewControl(myWindPtr,RectPtrX,@btn5,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column3,Row3,0,0);	Chandle[6] := NewControl(myWindPtr,RectPtrX,@btn6,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column4,Row3,0,0);	Chandle[21] := NewControl(myWindPtr,RectPtrX,@btnMinus,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column1,Row4,0,0);	Chandle[1] := NewControl(myWindPtr,RectPtrX,@btn1,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column2,Row4,0,0);	Chandle[2] := NewControl(myWindPtr,RectPtrX,@btn2,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column3,Row4,0,0);	Chandle[3] := NewControl(myWindPtr,RectPtrX,@btn3,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column1,Row5,Column1+77,Row5+14);	Chandle[0] := NewControl(myWindPtr,RectPtrX,@btn0,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column3,Row5,Column3+38,Row5+14);	Chandle[22] := NewControl(myWindPtr,RectPtrX,@btnDot,ctlFlags,0,0,100,kk,ll,nil);		SetRect(RectPtrX,Column4,Row4,Column4+38,Row5+14);	Chandle[23] := NewControl(myWindPtr,RectPtrX,@btnEqual2,ctlFlags,0,0,100,kk,ll,nil);end;procedure AddInKey;	label 100;var	KeysMax: integer;begin	if CalcMode=modeDecimal then		keysmax := 19	else		keysmax := 8;	if OtherKey<>0 then begin		BlankDisplay;		OtherKey := 0;		IData := 0;		NumPeriods := 0;	end;	if theKey=integer('.') then NumPeriods := 1;			if IData<Keysmax then begin		if (theKey=integer('0')) and (DataString='0') then begin			{ MoveTo(167,DisplayRow); }			goto 100;		end else begin		    IData := IData+1;		    DataString[0] := Chr(IData);	    	DataString[IData] := Chr(theKey);	    end;{		if NumPeriods=0 then			moveto(175-(8*IData),DisplayRow)		else	   		moveto(178-(8*IData),DisplayRow);}100:	MoveTo(175-StringWidth(DataString),DisplayRow);{100:}	SetBackColor($eeee);		DrawString(DataString);		SetBackColor($ffff);		DataString2 := DataString; { DAL 13-Dec-90 ### }	end else		SysBeep2(beepFieldFull);end; { of AddInKey }Procedure ClearAll;var	ii:	integer;	BlankString: string;begin	IData := 0;	NumPeriods := 0;	MyReal1 := 0.0;	MyReal2 := 0.0;		DataString[0] := Chr(IData);	MinusKey := 0;	MyLong := 0;	GotFirstOperand := false;	OtherKey := 0;	BlankDisplay;end; { of procedure ClearAll }Procedure BlankDisplay;begin	SetRect(myRect,DisplayCol-10,DisplayRow-10,DisplayCol+167,DisplayRow+4);	Set640Color(14);	SetBackColor($eeee);	PaintRRect(myrect,15,15);	if CalcMode=modeHex then begin		MoveTo(DisplayCol,DisplayRow);	    DrawString('Hex:');	end;	SetBackColor($ffff);end;procedure DrawTheDisplay;begin	If CalcMode=modeDecimal then{		MoveTo(182-(8*ord(DataString2[0])),DisplayRow) {+9}		MoveTo(175-StringWidth(DataString2),DisplayRow) { 2-Oct-91 DAL }	else		MoveTo(175-(8*ord(DataString2[0])),DisplayRow);	SetBackColor($eeee);	DrawString(DataString2);	SetBackColor($ffff);end;{ Input to ShowResults = MyReal2 }procedure ShowResults;	label 700,800,900;var	power: 	integer;	i:	integer;	j:	integer;	theFormat: decform;begin	BlankDisplay;	if CalcMode=modeDecimal then begin		theFormat.style := FLOATDECIMAL;		theFormat.digits := 10;		Num2Str(theFormat, MyReal2, DataString);	end else begin		MyLong := Trunc(MyReal2);		Conv2Hex;	end;	DataString2 := DataString;	    		if CalcMode=modeDecimal then begin {if decimal mode}		if(ord(DataString[0])=4) then begin			DataString2 := 'Infinity';			goto 900;		end;		if(ord(DataString[0])=9) then begin			DataString2 := 'Not a number';			goto 900;		end;		{First determine power value}		if ord(DataString[0]) > 15 then goto 900;		power := ord(DataString[15])-48;		if DataString[14] = '-' then power := -power;		if (power>9) or (power<-9) then goto 900;		if power >= 0 then begin			for i := 4 to 3+power do DataString2[i-1] := DataString2[i];			DataString2[3+power] := '.';			DataString2[0] := chr(12);			for i := 1 to 12 do begin				if DataString2[13-i]<>'0' then goto 800;				end; { of do }			800:DataString2[0] := chr(13-i);		end {of power>=0} else begin {of power <0}			DataString2[2] := '.';			j := 2;			if power<>-1 then begin				{add in front zeros}				for i := 1 to -power-1 do begin					j := j+1;					DataString2[j] := '0';					end; { of do }				end; { of power<>-1 }				j := j+1;				DataString2[j] := DataString[2]; { leading decimal }				for i := 1 to 9 do begin					j := j+1;					DataString2[j] := DataString[3+i];					end; { of do 1,9 }				for i := 1 to 9 do begin					if DataString2[j]='0' then j := j-1 else						goto 700;					end; { of do 1,9 }				700:DataString2[0] := chr(j);				end; { of power<0 }	end; { of other display mode }900: DrawTheDisplay;	OtherKey := 1; end;    		procedure SwitchCMode;var	i:	integer;begin	if CalcMode=modeHex then begin {if Hex mode}		for i := 10 to 15 do HiliteControl(255,CHandle[i]);		HiliteControl(255,CHandle[24]);		HiliteControl(0,CHandle[25]);		Conv2Dec; { convert to decimal }		MyReal2 := MyLong;		CalcMode := modeDecimal;		SetFontFlags(4);		BlankDisplay;		ShowResults;		OtherKey := 1; { 2-Oct-91 DAL }	end else begin {if Decimal mode}		for i := 10 to 15 do			HiliteControl(0,CHandle[i]);		HiliteControl(0,CHandle[24]);		HiliteControl(255,CHandle[25]);		CalcMode := modeHex;		SetFontFlags(6); { monospaced flag since "E" and "F" }		{first convert to real}				MyReal2 := Str2Num(DataString);				{now convert to integer}		MyLong := Trunc(MyReal2);		BlankDisplay;		Conv2Hex;		OtherKey := 1;  { 2-Oct-91 DAL }		MoveTo(175-StringWidth(DataString),DisplayRow);		SetBackColor($eeee);		DrawString(DataString);		DataString2 := DataString;		SetBackColor($ffff);	end; { of decimal mode }end;procedure Conv2Hex;var	i, j, k, l:	integer;	XLong:		longint;	divResult:	LongDivRec;begin	XLong := MyLong;	datastring[0] := chr(8);	i := 8;	for l := 1 to 8 do begin		k := band($000f,LoWord(XLong));		if K>9 then k := k + 7;		datastring[i] := chr(k+48);		{ XLong := XLong div 16; }		divResult := LongDivide(XLong,$10);		XLong := divResult.quotient;		i := i - 1;	end; { of for }end;procedure Conv2Dec;var	k:	integer;	n:	integer;	m:	integer;begin	MyLong := 0;	m := ord(datastring[0]);	for k := 1 to m do begin		n := ord(datastring[k]);		if datastring[k]>chr(71) then n := n - 32;		if datastring[k]>chr(57) then n := n - 7;		n := n - 48;		MyLong := 16 * MyLong + n;	end;end; { of Conv2Dec }PROCEDURE ConvertVal;begin	if CalcMode=modeDecimal then		MyReal2 := Str2Num(DataString)	else begin		Conv2dec;		MyReal2 := MyLong;	end;end;procedure DoFunction(Operator: integer; ChainFlag: boolean);begin	if OtherKey=0 then begin		MyReal1 := MyReal2;		if ChainFlag then			MyReal2 := ChainConstant		else begin			ConvertVal;			ChainConstant := MyReal2;		end;		if GotFirstOperand then begin	    					case Operator of				21:  MyReal2 := MyReal1 - MyReal2;				20:  MyReal2 := MyReal1 + MyReal2;				19:  MyReal2 := MyReal1 * MyReal2;				18:  MyReal2 := MyReal1 / MyReal2;			end;		end;		ShowResults;		GotFirstOperand := true;		NumPeriods := 0;  { added 2-Oct-91 DAL }	end;	OtherKey := 1;end;Procedure DoHexChrs;begin	if CalcMode=modeHex then begin {if in Hex mode}		ITemp := theKey-55;		if ITemp>15 then ITemp := ITemp-32;		HiliteControl(2,CHandle[ITemp]);		AddInKey;		HiliteControl(0,CHandle[ITemp]);	end else		SysBeep2(beepBadKey);end;procedure DoClear;begin	ClearAll;	if calcMode = modeDecimal then		DataString := '0.'	else		DataString := '00000000';	DataString2 := DataString;	MoveTo(175-StringWidth(DataString),DisplayRow);	SetBackColor($eeee);	DrawString(DataString);	SetBackColor($ffff);			Operator := 0;	GotFirstOperand := true;	OtherKey := 1;	ChainConstant := 0.0;	ChainOperator := 0;		theKey := 0;end;procedure DoEqual;begin	OtherKey := 0;	if (LastKey=integer('=')) or (LastKey=Enter) then begin		DoFunction(ChainOperator,true)	end else begin		if LastKey=integer('/') then begin			MyReal2 := 1.0;		end;				ChainOperator := Operator;		DoFunction(Operator,false);		Operator := 0;	end;	GotFirstOperand := true;	OtherKey := 1;end;procedure DoDivide;begin	DoFunction(Operator,false);	Operator := 18;end;procedure DoMultiply;begin	DoFunction(Operator,false);	Operator := 19;end;procedure DoPlus;begin	DoFunction(Operator,false);	Operator := 20;end;procedure DoMinus;begin	DoFunction(Operator,false);	Operator := 21;	{ What's this stuff? --DAL }	{if OtherKey=1 then begin		if MinusKey=0 then begin			OtherKey := 1;			AddInKey;			MinusKey := 1;				end else begin		Operator := 21;			OtherKey := 1;			MinusKey := 0;			DoFunction(Operator,false);		end;		end	 else begin			Operator := 21;			OtherKey := 1;			MinusKey := 0;			DoFunction(Operator,false);			end;}end;procedure DoPeriod;begin	if (CalcMode=modeDecimal) and (NumPeriods=0) then		AddInKey	else		SysBeep2(beepBadKey);	NumPeriods := 1;end;procedure myTextItem(theDialog: ptr; theItem: integer);begin	MoveTo(10,14);  DrawString('Calculator');	MoveTo(10,18);  Line(215,0);	MoveTo(10,30);  DrawString('Programmed by Dan Hitchens');	MoveTo(10,41);	DrawString('and Dave Lyons');	MoveTo(10,52);  DrawString('Version 1.1');	MoveTo(10,56);  Line(215,0);	MoveTo(10,69);  DrawString('Copyright 1989-93');	MoveTo(10,79);  DrawString('Apple Computer, Inc.');	MoveTo(10,84);  Line(215,0);end;procedure DoAbout;var	aboutDlog: DialogPtr;	r:		   Rect;	itemHit:   Integer;	dummy:	   integer;begin	dummy := WindowGlobal(1);	SetRect(r,0,0,240,125);	if band(GetMasterSCB,$0080)=0 then		OffsetRect(r,(320-240) div 2,30)  { 320 mode }	else		OffsetRect(r,(640-240) div 2,30); { 640 mode }	aboutDlog := NewModalDialog(r,true,0);	SetPort(aboutDlog);		btnOK := 'OK';	SetRect(r,175,105,0,0);	NewDItem(aboutDlog,1,r,10,@btnOK,0,0,nil);	SetRect(r,0,0,200,100);	NewDItem(aboutDlog,2,r,$8014{userItem},@myTextItem,0,0,nil);	itemHit := ModalDialog(nil);	CloseDialog(aboutDlog);		dummy := WindowGlobal($fffe);	end;Procedure CLoadTools;begin	{ Load SANE if it isn't here }	StatusTool := integer(mySANEStatus);  if _toolErr<>0 then StatusTool := 0;	if StatusTool=0 then begin		LoadOneTool(10,$300);		ToolZP := NewHandle(256,MMStartUp,$c015,nil);		MyLong := Ord4(ToolZP^);		StatusTool := LoWord(MyLong);		mySANEStartup(StatusTool);			WeStartedSANE := true;	end;end;Procedure CUnloadTools;begin	if WeStartedSANE then begin		mySANEShutdown;		DisposeHandle(ToolZP);		UnloadOneTool(10);		WeStartedSANE := false;	end;end;end.