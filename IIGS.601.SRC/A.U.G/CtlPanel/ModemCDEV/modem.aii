;;;	modem - modem CDEV.;;	Michael V. Stein	04/04/90.;;	© Apple, 1990.	blanks	off;;	equates.recty0	equ	0		rectangle offsetsrectx0	equ	2recty1	equ	4rectx1	equ	6Slot2ID equ	$22		battery parameter telling the value of the slot2wind_atalk_h	equ 47+15+22	;window height for AppleTalk devicewind_modem_h	equ 131+15+22	;window height for modem or printer devicewind_w		equ 200		;window width;;	imported addresses.	import	devlen	import	devptr	import	nbut	import	modemabout	import	modemalist	import	modemlist	import	slotlen	import	slotptr		;;	include files.	include	'::cdev.h'	include	'::commonmacros.h'	include	'::dp.h'	include	'e16.control'	include	'm16.control'	include	'm16.event'	include	'm16.menu'	include	'm16.misctool'	include	'm16.util2'	;;	main program.main	procmodem	phb			save calling data bank	phk	plb			set our data bank		;	make room on stack for direct page.	tsc				sec				sbc	#dpsize		make room on stack for new direct page	tcs				phd			save the current direct page	tcd			new direct page	lda	message		cmp	#12			bcs	modem1		if message defintely not handled			asl	a		times 2 into word table	tax			move into index reg	jsr	(t_cdev-2,x)	call the handler of this messagemodem1  pld			restore direct page	tsc	clc	adc	#dpsize			tcs			reset the stack	lda	1,s		Bump the stack up to prepare	sta	11,s		to take off the 3 parameters	lda	3,s			sta	13,s	pla			get rid of message space		pla			get rid of data1 space	pla					pla			get rid of data2 space	pla					lda	#0		return 0 to caller	sta	5,s	sta	7,s			plb		rtl		t_cdev	dc.w	cccE		Null - not used	dc.w	cccE		handle machine message	dc.w	cccE		handle boot message	dc.w	icc		init cdev controls	dc.w	cccE		close the cdev	dc.w	cccE		handle event message	dc.w	ccc		create cdev controls	dc.w	ham		handle about message	dc.w	hrm		handle rectangle message	dc.w	hhm		handle hit message	dc.w handle_run		;RunCDEV	;;	ccc - create cdev controls.;;	entry	[data1] = window ptr.;		(modemlist..) = table of ptrs to controls if not appletalk selected.;		(modemalist..) = table of ptrs to controls if appletalk selected.;		slot2ID = battery parameter for slot 2 identification.;		(slotlen..) = table of string lengths of slot 2 possibilities.;		(slotptr..) = table of ptrs to slot 2 names..;;	exit	(devlen) = length of slot 2 name.;		(devptr) = offset of name in bank.;		[wptr] = window pointer.ccc	ldx	#slot2ID	jsr	rbp		read battery parameter	sta old_dev		;save for comparisons	asl	a	tax	lda	slotptr,x	get lo ptr to string	sta	devptr	lda	slotlen,x	get length of string	sta	devlen	pha			space for result	pha	lda	data1+2	pha			hi word of window ptr	sta	wptr+2	lda	data1	pha			lo word of window ptr	sta	wptr	pushw	#3		next item is a ptr to a list of template pointers			ldx	#slot2ID	jsr	rbp		read battery parameter	cmp	#2	beq	ccc1		if appletalk is set in slot 2	pushl	#modemlist	controls if not appletalk in port	bra	ccc2	ccc1	pushl	#modemalist	controls if appletalk is set in portccc2	_NewControl2	pla	pla			don't care about result	cccE	rts;;	ham - handle about message.;;	entry	[data1] = ptr to window.;		(modemabout..) = template of about box control.;;	exit	About box control is created.ham	pha			space for result	pha	pushl	data1		window pointer	pushw	#0		next item is a ptr to a template	pushl	#modemAbout	_NewControl2	pla	pla			don't care about result	rts	goto .no_he		;don't assemble this routine!handle_event		;handle EventsCDEV message and poll for change			;in the type of device connected to our port	lda [data1]		;get event code	bne @no_action		;if not null, don't check BRAM@null;	check BRAM to see whether our device type has changed, and;	re-create the CDEV window if it has	lda old_dev		;check whether inited	bmi @no_action	ldx #slot2ID	jsr rbp			;check BRAM	cmp old_dev		;did it change?	beq @no_action@changed	sta old_dev		;update for next time	pei data2+2		;push window ptr	pei data2	_KillControls		;get rid of current controls	pea wind_w	lda old_dev		;get device type again	cmp #2			;AppleTalk?	beq @atalk@modem	pea wind_modem_h	bra @resize@atalk	pea wind_atalk_h@resize	pei data2+2		;push window ptr	pei data2	ldx #$1C0E		;SizeWindow	jsl $E10000		;resize the window;	now we call our own CreateCDEV and InitCDEV;	routines to set up the new window	lda data2	ldx data2+2	sta data1		;put window ptr in data1 for CreateCDEV	stx data1+2	stz data2		;clear data2 (not used)	stz data2+2	jsr ccc			;create new controls;	InitCDEV takes same params as CreateCDEV, so we'll;	just assume they're still in place	jsr icc@no_action	rts.no_he			;assembly skips to herehandle_run		;handle RunCDEV message and poll for change			;in the type of device connected to our port;	check BRAM to see whether our device type has changed, and;	re-create the CDEV window if it has	lda old_dev		;check whether inited	bmi @no_action	ldx #slot2ID	jsr rbp			;check BRAM	cmp old_dev		;did it change?	beq @no_action@changed	sta old_dev		;update for next time	lda wptr+2		;push window ptr	pha	lda wptr	pha	_KillControls		;get rid of current controls	pea wind_w	lda old_dev		;get device type again	cmp #2			;AppleTalk?	beq @atalk@modem	pea wind_modem_h	bra @resize@atalk	pea wind_atalk_h@resize	lda wptr+2		;push window ptr	pha	lda wptr	pha	ldx #$1C0E		;SizeWindow	jsl $E10000		;resize the window;	now we call our own RectCDEV, CreateCDEV, and InitCDEV;	routines to set up the new window	stz hr_dummy_rect	;set up dummy rectangle	stz hr_dummy_rect+2	lda #125	sta hr_dummy_rect+4	lda #200	sta hr_dummy_rect+6	lda #<hr_dummy_rect	sta data1		;set up ptr to rectangle	lda #^hr_dummy_rect	sta data1+2	stz data2		;clear data2 (not used)	stz data2+2	jsr hrm			;handle rectangle, adjust button position	lda wptr	ldx wptr+2	sta data1		;put window ptr in data1 for CreateCDEV	stx data1+2	jsr ccc			;create new controls;	InitCDEV takes same params as CreateCDEV, so we'll;	just assume they're still in place	jsr icc@no_action	rtshr_dummy_rect			;dummy rectangle for when we call our				;rectangle routine	ds.w 4;;	hhm - handle hit message.;;	entry	(bat..) = table of battery parameter values.;		batL1 = # of popups.;		batL2 = total # of controls to set.;		[data1] = handle to control that was hit.;		[data2] = id of control that was hit.;		(default..) = table of default values for controls.;		[wptr] = ptr to window.;;	exit	hit is processed.hhm	ldx	data2	cpx	#30	beq	hhm3		if user hit normal settings button		pha			space for result	pushl	data1	_GetCtlValue		ply			get value of control	ldx	data2	cpx	#batL1+1	bcs	hhm1		if a checkbox	dey			chooseing from a popup	bra	hhm2hhm1	tya	beq	hhm2		if checkbox isn't set	ldy	#1			hhm2	lda	bat-1,x		get battery parameter to set	and	#$ff	tax	tya	jmp	wbp		write battery parameter and returnhhm3	ldx	#0hhm4	stx	w1	lda	default,x	and	#$ff		default value for this battery parameter	tay			save for now	lda	bat,x	and	#$ff		battery parameter to set	tax	tya				jsr	wbp		write battery parameter		ldx	w1	inx	cpx	#batl2	bcc	hhm4		if more to set	lda	wptr	sta	data1	lda	wptr+2	sta	data1+2	jmp	icc		init cdev controls and return			;;	hrm - handle rectangle message.;;	entry	[data1] = ptr to rectangle.;		slot2ID = battery param to check for slot 2 id.;;	exit	rectangle is set.  If Appletalk is enabled for slot 2;		then the rectangle is smaller.hrm	ldx	#slot2ID	jsr	rbp		read battery parameter	ldx	#wind_atalk_h	assume appletalk	cmp	#2	beq	hrm1		if appletalk is selected	ldx	#wind_modem_hhrm1	txa	ldy	#recty1	sta	[data1],y	set lower part of rectangle	sec	sbc	#15	ldy	#6+recty0	sta	nbut+6+recty0	upper y of button	clc	adc	#13	sta	nbut+6+recty1	lower y of button	rts		;;	icc - init cdev controls.;;	entry	(bat..) = table of battery parameter values.;		batL1 = # of popups.;		batL2 = total # of controls to set.;;	exit	controls are initialized to the values in battery param.;	first set the popups.icc	ldx	#1		control id of parityicc1	stx	w1		init counter	lda	bat-1,x	and	#$ff	tax	jsr	rbp		read battery parameter	ldx	w1		jsr	scv		set control value	ldx	w1	inx	cpx	#batL1+1	# of popups	bcc	icc1		if more to set	;	set checkboxes.icc2	stx	w1		init counter	lda	bat-1,x	and	#$ff	tax	jsr	rbp		read battery parameter	ldx	w1		id of control	jsr	scvE		set control value	ldx	w1	inx	cpx	#batL2+1			bcc	icc2		if more to set	rts		;;	rbp - read battery parameter.;;	entry	(x) = parameter to read.;;	exit	(a) = value of parameter.rbp	pha			space for result	phx			parameter to read	_ReadBparam	pla			get value	rts;;	scv - set control value.;;	entry	(a) = value to set -1.;		(x) = id of control.;		[data1] = window pointer.;;	exit	control value is set.;;	alternate entrypoint: scvE.;;	scvE is called to set a checkbox.  makes sure value is 0 or 1.scv	ina	bra	scv1			scvE	tay	beq	scv1		if checkbox not set	lda	#1	scv1	pha			value to set	pha			space for result	pha					pushl	data1		window pointer	pushw	#0		hi word of id	phx			id of control	_GetCtlHandleFromID	lda	1,s	ora	1+2,s	beq	scv2		if not an actual control because of appletalk		_SetCtlValue		value to set was already on stack	rtsscv2	pla			get stuff off of stack	pla	pla	rts	;;	wbp - write battery parameter.;;	entry	(a) = value of parameter to set.;		(x) = battery parameter to set.;;	exit	battery parameter is set.wbp	pha			new value	phx			parameter to set	_WriteBparam	rts	;	data used by this program.;	battery parameter locations used.bat	dc.b	$14			dc.b	$12			dc.b	$0d			dc.b	$13		batL1	equ	*-bat		# of popups	dc.b	$0e			dc.b	$0f			dc.b	$11	dc.b	$10	dc.b	$15	dc.b	$16	dc.b	$17batL2	equ	*-bat		total number of parameters;	default values for battery parameter settings.default	dc.b	2	dc.b	7		1200 baud	dc.b	0	dc.b	6	dc.b	0	dc.b	0	dc.b	0	dc.b	0	dc.b	1	dc.b	1	dc.b	0wptr	ds.b	4		hold window ptrold_dev	dc.w $FFFF		;last device type seen in BRAM, initedÉ				;Éto special value	endp	end