;;;	rename - rename an AppleTalk printer.;;	Michael V. Stein	02/26/90.;;	© Copyright Apple Computer, 1990.;;;	routines included in this source file.;;	rtp - rename this printer.;	cls - check for laserwriter spooler.;	cnn - check new name.;	fek - filter escape key.;	riw - rename imagewriter.;	rlw - rename LaserWriter.;	wfp - wait for printer.	blanks	off	;;	equates.;;	include files.	include	'::commonmacros.h'	include	'::dp.h'	include	'e16.event'	include	'e16.control'	include	'e16.dialog'	include	'm16.control'	include	'm16.dialog'	include	'm16.list'	include	'm16.qdaux'	include	'm16.quickdraw'	include	'm16.util2'	include	'netprinter.h';;	main program.rename	proc;;	imported addresses.	import	cmd	import	cps	import	ctp	import	damE	import	devices	import	dptr	import	gdt	import	ghp	import	gip	import	hpe	import	hzl	import	knl	import	lookupF	import	lszone	import	mneE	import	omd	import	osd	import	osdE	import	otp	import	plisthdl	import	popen_pblk:open_printer	import	pread_pblk:read_printer	import	prec:printersetup	import	pstat_pblk:status_printer	import	pwrite_pblk:write_printer	import	readbuff	import	rfp	import	rfpE	import	rtpstat	import	screenF	import	stp	import	stpE	import	wtp;;	exported addresses.	export	newname	export	rtp;;	rtp - rename this printer.;;	entry	printer is selected.;		(screenF) = $8000 if 640 mode.;;	exit	if no error, printer is renamed.;		if error, user is told of the problem in an alert.rtp	jsr	ghp			get highlighted printer	dea				offset into list	jsr	gip			get index into printers	ldy	#memrec.memptr	lda	[l4],y	sta	rtpeptr			lo word of ptr to name in pascal format	sta	l2	iny	iny	lda	[l4],y	sta	rtpeptr+2		hi word of ptr to name in pascal format	sta	l2+2	;	adjust dialog for screen resolution.	lda	#(320-rtpw)/2	ldx	screenF	bpl	rtp1			if 320 mode	lda	#(640-rtpw)/2rtp1	sta	rtpdlg+2		left x	clc	adc	#rtpw	sta	rtpdlg+6		right x;	handle dialog.	lda	#rtpdlg	ldy	#^rtpdlg	jsr	omd			open modal dialog		stz	newname			make sure no name	brl	rtp14			inactivate the rename button	rtp2	pha				space for result	lda	#^fek;;;	ora	#$8000			set high bit	ora	#$c000			;also set bit 30 for I-beam (25-Aug-92 DAL)	pha	lda	#fek	pha	stz	eflag			reset flag		_ModalDialog	ply				get item hit	bne @gotSomething	lda	eflag	bmi	rtp2a			if user hit escape	bne	rtp2			if just a null event@gotSomething	cpy	#rtpcanID	bne	rtp3			if not cancel buttonrtp2a	brl	cmd			close modal dialog and returnrtp3	cpy	#rtpokID	beq	rtp4			if hit ok	brl	rtp13			check other dialog items	rtp4	jsr	cnn			check new name	bcc	rtp6			if user selected different name		brl	cmd			close modal dialog and return	rtp6	lda	#$ffff	sta	lookupF			flag to not start any more lookups	jsr	knl			kill name lookup		pushl	l5			ptr to grapfport	pushw	#1	_RemoveDItem			remove the ok button	pushl	l5			ptr to grapfport	pushw	#2	_RemoveDItem			remove the cancel button		pushl	l5			ptr to grapfport	pushw	#rtpm3ID	_RemoveDItem			remove the cancel button	pushl	l5			ptr to grapfport	pushw	#rtpe1ID	_RemoveDItem				pushl	l5			ptr to grapfport	pushw	#rtptitleID	_RemoveDItem						pushl	l5			grafport	pushl	#rtpstatbut		button	_GetNewDItem	pushl	l5			grafport	pushl	#dlg2item		button	_GetNewDItem	pushl	l5	_DrawDialog		_WaitCursor	lda	#status	sta	pstat_pblk.statbuf	lda	#^status	sta	pstat_pblk.statbuf+2	stz	status+4		length of responce	jsr	stp			status the printer	tax	bne	rtp10			if error stating the printer		jsr	otp			open the printer	jsr	wfp			wait for printer	bcs	rtp11			if user gave up	tay	bne	rtp10			if error occurred			pushl	l5			ptr to grapfport	pushw	#2	_RemoveDItem			remove the cancel button		pushl	l5	pushw	#3	pushl	#rtpstat	_SetIText			lda	devices	beq	rtp8			if laserwriter is selected	jsr	riw			rename imagewriter	bra	rtp8brtp8	jsr	cls			check for laserwriter spooler	cpx	#1+1	bcs	rtp10			if error occured	txa	beq	rtp8a			if normal printer		brl	rtp20			is a spooler	rtp8a	jsr	rlw			rename laser writerrtp8b	bcs	rtp10			if error occurred	lda	#100			enough to wait for a while	sta	w3	;	make sure it eventually gives up.rtp9	jsr	stpE			status the printer	dec	w3	beq	rtp11			if time to give up	tax	beq	rtp9			if no error	cmp	#$805	beq	rtp11			if the correct error	cmp	#$808	beq	rtp11			if the correct errorrtp10	pha	jsr	cmd			close modal dialog	pla	jsr	hpe			handle pap error	jsr	ctp			close the printer	bra	rtp12		rtp11	jsr	ctp			close the printer connection	jsr	cmd			close modal dialogrtp12	_InitCursor	stz	lookupF	stz	lszone			force recalc of printers	stz	lszone+2	brl	hzl			handle zone list and return	rtp13	cpy	#rtpe1ID			bne	rtp16			if not edit box, must be cancelrtp14	pushl	l5	pushw	#rtpe1ID	pushl	#newname	_GetIText		ldx	#inactiveHilite	lda	newname	and	#$ff	beq	rtp15			if to inactivate the rename button	cmp	#1	ldx	#nohilite		activate the rename button	rtp15	phx				state of button	pha	pha				space for result		pushl	l5			ptr to grafport	pushw	#rtpokID	_GetControlDItem	_HiliteControl			hilite the rename button appropriately	brl	rtp2		rtp16	rts;	handle case of trying to rename a spooler.rtp20	jsr	cmd			close modal dialog	jsr	ctp			close the printer connection	lda	#rtpspool	ldy	#^rtpspool	jsr	damE			display stop alert message	bra	rtp12			finish things up		rtpspool  dc.b	rtpspoolL	dc.b	'That printer is a spooler'	dc.b	13	dc.b	'and cannot be renamed.'rtpspoolL  equ	*-rtpspool-1;	data used here.	string	pascal	rtpl	equ	170rtpr	equ	470rtpw	equ	rtpr-rtplrtpmid	equ	rtpw/2rtpt	equ	55rtpb	equ	130rtph	equ	rtpb-rtptrtpdlg	dc.w	rtpt,rtpl,rtpb,rtpr	dc.w	$FFFF			visible	dc.l	0			refcon		dc.l	rtptit	dc.l	rtpm3	dc.l	rtpe1	dc.l	rtpok,rtpcan	dc.l	0rtptitleID  equ	3rtptit	dc.w	rtptitleID		id	dc.w	3,rtpmid-55,3+9,rtpmid+60	dc.w	statText+ItemDisable	dc.l	rtptittxt,0,0rtptittxt  dc.b	'Rename Printer'rtpm1ID	equ	rtptitleID+1rtpm2ID	equ	rtpm1ID+1	rtpm3ID	equ	rtpm2ID+1rtpm3	dc.w	rtpm3ID	dc.w	20,5,29,100	dc.w	statText+ItemDisable	dc.l	rtpm3txt	dc.l	0,0rtpm3txt  dc.b	'New Name:'	rtpe1ID	equ	rtpm3ID+1rtpe1	dc.w	rtpe1ID	dc.w	30,5,30+13,rtpw-5  	5 pixels indented on either end	dc.w	EditLinertpeptr	dc.l	0	dc.w	namelen-1		max chars for printer name	dc.w	0	dc.l	0rtpokID  equ	1rtpok	dc.w	rtpokID			dc.w	rtph-17,165,rtph-4,165+100	dc.w	ButtonItem	dc.l	rtpoktxt,0,0rtpoktxt  dc.b	'Rename'rtpcanID equ	rtpokID+1rtpcan	dc.w	rtpcanID		cancel button	dc.w	rtph-17,35,rtph-4,35+100	dc.w	ButtonItem	dc.l	rtpcantxt,0,0rtpcantxt  dc.b	'Cancel'rtpstatbut  dc.w  2	dc.w	50,100,63,100+84	dc.w	ButtonItem	dc.l	rtpcantxt,0,0dlg2item  dc.w	3			item id	dc.w	20,46,20+13,290		rectangle	dc.w	statText+ItemDisable	type	dc.l	osdmess			descr	dc.w	0			value	dc.w	0			flag	dc.l	0			color table	osdmess	dc.b	'   Looking for the printer...';;	cls - check for laserwriter spooler.;;	entry	(pwrite_pblk..)  = parameter block for writing to printer.;		(spquery..) = query to have spooler identify itself.;;	exit	(x) = 0 if real printer.;		(x) = 1 if spooler.cls	lda	#spqueryL	sta	pwrite_pblk.buflen	lda	#spquery	sta	pwrite_pblk.bufptr	lda	#^spquery	sta	pwrite_pblk.bufptr+2	shortm	lda	#1	sta	pwrite_pblk.eofbyte	this is all we want to send	longm		jsr	rfpE			read from printer	jsr	wtp			write to printer	tax	bne	cls2			if some sort of error occurred	jsr	rfp			read from printer	cls1	lda	pread_pblk.result	cmp	#PapBusy	beq	cls1			if call hasn't completed		tax	bne	cls2			if error of some sort				ldx	#0			assume it is a real printer	lda	readbuff	cmp	#'af'			compare against first two lettters of 'false'	beq	cls2			if not a spooler	inx				flag as spoolercls2	rts		string 	asis		spquery	dc.b	'%%?BeginQuery:  rUaSpooler'	dc.b	13	dc.b	'false = flush'	dc.b	13	dc.b	'%%?EndQuery true'	dc.b	13spqueryL  equ	*-spquery;;	cnn - check new name.;;	entry	(newname..) = pascal string containing new name of printer.;		[l2] = ptr to original name;;	exit	(c) set if new name is equivalent to old name.cnn	shortmx	cnn2	lda	[l2]			get length of original name	cmp	newname			compare against the new name length	bne	cnn4			if not equal lengths		ldy	#1	cnn3	lda	[l2],y	cmp	newname,y	bne	cnn4			if not equal	cpy	newname	bcs	cnn5			if done checking and strings are equal	iny	bra	cnn3			check next character	cnn4	clc				flag that strings are differentcnn5	longmx	rts					;;	fek - filter escape key.;;	entry	from dialog manager after it gets an event.;;	exit	(eflag) = 1 if null event.;		(eflag) = $ffff if escape is hit.;		else (eflag) is unchanged.;	stack frameresult	equ	16dlgptr	equ	12eventptr  equ	8itemptr	equ	4fek_waiting	lda #$ffff	bra commonfek	lda #0common	sta >handle_nulls	tsc	phd				save direct page	pha	pld				set new direct page		ldx	#0			assume we don't want to handle	lda	[eventptr]		get the type of event	bne	fek1			if not a null event		lda	#1	sta	>eflag			flag a null event;;;	dex				set x to $ffff - we want to handle it	lda	>handle_nulls	tax	bra	fek4			finish things up	fek1	cmp	#keyDownEvt	beq	fek2			if key down	cmp	#autoKeyEvt	bne	fek4			if not auto key event	fek2	ldy	#2	lda	[eventptr],y		get message	and	#$ff	cmp	#$1b	bne	fek4			if user didn't type escape	;	user wants out.fek3	pha				space for result	pha		lda	>dptr+2	pha				hi ptr to grafport	lda	>dptr	pha				lo ptr to grafport		pushw	#2			id of cancel button	_GetControlDItem	pla				low word of handle	plx				hi word of handle		pushw #0	phx				hi word of control pointer	pha				lo word of control pointer	pushw #2	phx				hi word of control pointer	pha				lo word of control pointer	_HiliteControl			highlight the cancel button	_HiliteControl			make it look normal	ldx	#$ffff		txa	sta	>eflag			flag that user wants to escape;	clear garbage off of stack.fek4	pld				restore direct page	lda	1,s	tay	lda	1+2,s	sta	1+3+4+4+3,s		store high word	tya	sta	1+3+4+4+1,s		store low word		txa	sta	1+3+4+4+4,s		store result		tsc	clc	adc	#3+4+4+4-3	tcs		rtl	handle_nulls dc.w 0	;25-Aug-92 DAL;;	riw - rename imagewriter.;;	entry	(newname..) = pascal string containing new name of printer.;;	exit	imagewriter is renamed.;		(c) set if error occurred.riw	lda	#('b'<<8)+$1b		first two chars are escape followed by 'b'	sta	riwa			;	copy new name to command string.	lda	#riwa+2	sta	l1	lda	#^riwa+2	sta	l1+2	lda	#newname	sta	l2	lda	#^newname	sta	l2+2	jsr	cps			copy pascal string;	copy new type to command string.	lda	[l2]	pha				save length for now	jsr	mneE			move to next element	jsr	gdt			get device type [l2]	jsr	cps			copy pascal string	jsr	mneE			move to next element	lda	#0	sta	[l1]			add in trailing zero byte	;	send the command to the imagewriter.	jsr	rfpE			read from printer	lda	#riwa	sta	pwrite_pblk.bufptr	lo ptr to buffer to send	lda	#^riwa	sta	pwrite_pblk.bufptr+2	hi ptr to buffer to send			pla				retrieve length of new name	shortm	clc	adc	[l2]			length of typename	adc	#2+1+1+1		2 for command, 2 for length bytes and 1 for 0 byte	sta	pwrite_pblk.buflen	length of buffer to send	stz	pwrite_pblk.buflen+1	lda	#1	sta	pwrite_pblk.eofbyte	not done yet	longm		jsr	wtp			write to printer	tax	bne	riw1			if error occurred		jsr	ctp			close the printer	clc				flag no error	rts	riw1	pha	jsr	ctp			close the printer	pla	sec				flag error occurred	rts		;	data used here.riwa	ds.b	100			hold command for printerriwb	ds.b	2			;;	rlw - rename LaserWriter.;;	entry	(newname..) = pascal string containing new name of printer.;;	exit	LaserWriter is renamed.;		(c) set if error occurred.rlw	lda	#rlwa	sta	pwrite_pblk.bufptr	lo ptr to buffer to send	lda	#^rlwa	sta	pwrite_pblk.bufptr+2	hi ptr to buffer to send	lda	#rlwaL	sta	pwrite_pblk.buflen	length of buffer to send	shortm	stz	pwrite_pblk.eofbyte	not done yet	longm	jsr	rfpE			read from printer	rlw0	jsr	wtp			write to the printer		tax	bne	rlw4			if error occurred	shortmx		ldx	newname			length of new name	txy				save for laterrlw1	lda	newname,x		get char from name	sta	rlwc-1,x		write new name	dex	bne	rlw1			if more to copy	rlw2	lda	rlwd,x			get last part of command	sta	rlwc,y			copy it down	iny	inx	cpx	#rlwdl	bcc	rlw2			if more to copy		longmx		lda	#rlwb	sta	pwrite_pblk.bufptr	lo ptr to buffer to send	lda	#^rlwb	sta	pwrite_pblk.bufptr+2	hi ptr to buffer to send	lda	newname	and	#$ff	clc	adc	#rlwbL+20		rlwbL+rlwdL		sta	pwrite_pblk.buflen	length of buffer to send	shortm	lda	#1	sta	pwrite_pblk.eofbyte	last bit of data	longm	jsr	rfp			read from printer		jsr	wtp			write to printer		tax	bne	rlw4	rlw3	jsr	ctp			close the printer	clc				flag no error	rtsrlw4	pha	jsr	ctp			close the printer	pla	sec				flag the error	rts			;	data used here.	string	asisrlwa	dc.b	'serverdict begin 0 exitserver'	dc.b	13rlwaL	equ	*-rlwa	rlwb	dc.b	'statusdict begin('rlwbL	equ	*-rlwbrlwc	ds.b	35+20			holds new name of printer and rest of commandrlwd	dc.b	')setprintername end'	dc.b	13rlwdL	equ	*-rlwd	;;	wfp - wait for printer.;;	entry	modal dialog is created.;		open call has been made to printer.;;	exit	either the connection will be established or;		the user will cancel out.  ;		(c) set if user cancelled out.wfp	pha				space for result	lda	#^fek_waiting	ora	#$8000			set high bit	pha	lda	#fek_waiting	pha	stz	eflag			reset flag	_ModalDialog	ply				get item hit	lda	eflag			get flag from filter proc		bmi	wfp2			if user hit escape	bne	wfp1			if null event		cpy	#2				beq	wfp2			if user clicked in escape buttonwfp1	lda	popen_pblk.result	get status	cmp	#papbusy	beq	wfp			if printer is still busy	clc				flag that printer connection is now open	rtswfp2	jsr	ctp			close the printer	sec	rts				;	global data.eflag	dc.w	0			escape flag		newname	ds.b	40			hold the new name for the printerstatus	ds.b	256			hold status buffer  	endp	end