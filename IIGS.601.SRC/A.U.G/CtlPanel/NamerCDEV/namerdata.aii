;;;	namerdata - data records and strings used by namer CDEV.;;	Michael V. Stein	04/21/90.;;	© Copyright Apple Computer, 1990.	blanks	off	;;	equates.fCtlCanBeActive equ 	$4000InsideScrollBar	equ	4;;	include files.	include	'e16.control'	include	'e16.gsos'	include	'e16.list'	include	'netprinter.h';;	main program.netdata	proc;;	exported addresses.		export	about	export	appletalk	export	asterisk	;export	atalkerr	export atalkerrm	export	atalkF	export	choosepr	export	cprect	export	ctllist	export	emess7	export	emess10	export	emess11	export	emess13	export NBPbusyMsg	export	ginfoparams	export	gmyp_pblk	export	gmyz_pblk	export	kill_pblk	export	oktext	export	popen_pblk	export	plist	export	pread_pblk	export	psetpr_pblk	export	pstat_pblk	export	ptypes	export	punload_pblk	export	pwrite_pblk	export	quit	export	rtpbut	export	rtpstat	export	tryagain	export	typeptr	export	zlist	export	zonelist_pblk;;	imported addresses.	import	acr	import	myzonename	import	namesbuffer	import	netobj	import	openblock	import	openblock2	import	readbuff	import	username	import	zonebuffer			atalkF	dc.w	1			!= 0 if appletalk is active, defaults to active;	error strings.	string	asis	emess7	dc.b	emess7L	dc.b	'There is not enough memory'	dc.b	$0d	dc.b	'to continue.'emess7L	equ	*-emess7-1;	error messages used by the rename and emulator routines.emess10	dc.b	emess10L	dc.b	'The selected printer'	dc.b	$0d	dc.b	'is not responding.'	dc.b	$0d	dc.b	'Please try again.'emess10L  equ	*-emess10-1emess11	dc.b	emess11L	dc.b	'A network error has'	dc.b	$0d	dc.b	'occurred.  Please try'	dc.b	$0d	dc.b	'again.'emess11L  equ	*-emess11-1emess13	dc.b	emess13L	dc.b	'The selected printer'	dc.b	$0d	dc.b	'could not be found.'emess13L  equ	*-emess13-1NBPbusyMsg	dc.b @end-@start@start	dc.b 'A list of printers cannot', $0D	dc.b 'be displayed because a', $0D	dc.b 'network search is already', $0D	dc.b 'in progress on this computer.'@end	string	pascalappletalk  dc.b	'APPLETALK'asterisk  dc.b	'*'oktext	dc.b	'OK'quit	dc.b	'Quit'			used in disk error alertsrtptitle  dc.b	'Rename Printer…'	title of rtp buttontryagain  dc.b	'Try Again'		used in disk error alertsptypes	laser	dc.b	'LaserWriter'im	dc.b	'ImageWriter'imlq	dc.b	'LQ'typeptr  dc.w	laser,im,imlq	string	asisrtpstat  dc.b	rtpstatL	dc.b	'    Renaming the printer...'rtpstatL  equ	*-rtpstat-1zonetext  dc.b	'AppleTalk Zones:',0zonetextL  equ	*-zonetext-1;	appletalk parameter blocks.;	parameter block to get appletalk info.GinfoParams  dc.b  synchronous	type	dc.b	GetInfoCmd	command	dc.w	0		result	dc.l	0		completion routine	dc.w	0		ThisNet	dc.b	0		Abridge	dc.b	0		HardWareID	dc.w	0		Rom version	dc.b	0		node number		;	parameter block to find printers.	gmyp_pblk  dc.b	asynchronous		mode	dc.b	NBPLookup		command	dc.w	busy			result	dc.l	acr			completion routine	dc.l	netobj			ptr to name of what we want to find	dc.b	1			retry period in 1/4 secs		dc.b	1			# of times to retry	dc.w	0			somehting internal	dc.w	pblocksize		receive buffer size	dc.l	openblock2		store responses here	dc.b	maxsrvrs		maximum # of responses allowed	dc.b	0			actual number of responces received;	parameter block to get my zone.gmyz_pblk  dc.b	asynchronous		mode	dc.b	GetMyZone		command	dc.w	busy			result	dc.l	0			no completion routine	dc.l	myzonename		bufptr	dc.b	2			retry period	dc.b	8			# of retrys	dc.w	2			reserved;	parameter block to kill the current name lookup.kill_pblk  dc.b  synchronous		mode	dc.b	KillNBP			kill name binding protocol	dc.w	0			result code	dc.l	gmyp_pblk		starting parameter block					;	parameter block to get the zone list.	zonelist_pblk  dc.b  synchronous	dc.b	GetZoneList	dc.w	busy	dc.l	0			iocomp	dc.w	MaxZones*(NameLen+4)   	buflen	dc.l	0			bufptr (filled in dynamically)	dc.b	0			brnode	dc.w	1			strtindex	dc.b	1			retryinterval	dc.b    2			retrycount	dc.w    0			# of zones??    	dc.w	0			reserved		;	pap parameter blocks.punload_pblk  dc.b	synchronous	dc.b	$27			pap unload command	dc.w	0			result	dc.l	0			completion ptr		popen_pblk  dc.b	asynchronous	dc.b	Popen			command	dc.w	0			result	dc.l	0			iocomp	dc.b	0			refnum	dc.l	0			ptr to name	dc.b	1			flowq	dc.l	readbuff		statbuf	psetpr_pblk  dc.b	synchronous	dc.b	PMSetPrinterCmd	  	command	dc.w	0			result	dc.l	0			iocomp	dc.l	atinitrec+34		ptr to printer tuple	dc.b	0			flags	dc.w	2			flush interval	dc.w	30*4			timeout interval	dc.w	20			# of buffers	pstat_pblk  dc.b	asynchronous		dc.b	Pstatus			command	dc.w	0			result	dc.l	0			iocomp	dc.l	0			ptr to entity	dc.l	readbuff		stat buffer	pread_pblk  dc.b	asynchronous	dc.b	Pread			command	dc.w	0			result	dc.l	0			iocomp	dc.b	0			refnum	dc.w	0			buflen	dc.l	readbuff		bufptr	dc.b	0			eofbyte	dc.w	0			reserved		pwrite_pblk  dc.b	asynchronous	dc.w	PWrite			command	dc.w	0			result	dc.l	0			iocomp	dc.b	0			refnum	dc.w	0			buflen	dc.l	0			bufptr	dc.b	0			eofbyte		;	ctllist contains a list of controls whose handles we don't need very often.ctllist dc.l	choosepr	dc.l	ztext	dc.l	0choosepr  dc.w	9			PCount	dc.l	1			control ID	dc.w	5,leftedge,17,rightedge  rectangle	dc.l	$87000000		procRef	dc.w	$0040			flag	dc.w	$1084			moreflags (added $0080 popDownTriangle 25-Aug-92 DAL)	dc.l	0			refcon	dc.w	64			titleWidth	dc.l	chooseprmenu		menuref	dc.w	0			initialvalue	chooseprmenu	dc.b 	'>>Printer:\H'	dc.w 	1	dc.b 	$0D	dc.b 	'==LaserWriter\H'	dc.w 	1	dc.b 	$0D	dc.b 	'==ImageWriter\H'	dc.w 	2	dc.b	$0d	dc.b 	'==ImageWriter LQ\H'	dc.w	3	dc.b	$0d	dc.b	'.'about	dc.w	8			Pcount	dc.l	10			ID	dc.w	38,5,138,280	dc.l	statTextControl	dc.w	0	dc.w	fCtlProcRefNotPtr	dc.l	0	dc.l	atext	dc.w	AtextLatext	dc.b	'The Namer Control Panel lets you rename '	dc.b	'any AppleTalk printer.  Select the '	dc.b	'type of printer with the pop-up menu.  '	dc.b	'Once you have chosen a printer, click '	dc.b	'on the "Rename Printer…" button.'	atextL	equ	*-atext;atalkerr  dc.w	8		PCount	;dc.l	11		id	;dc.w	8,leftedge,38,Rightedge+20	;dc.l	statTextControl	;dc.w	0	;dc.w	fCtlProcRefNotPtr	;dc.l	0	;dc.l	atalkerrm	ptr to text	;dc.w	atalkerrmL	length		atalkerrm	dc.b atalkerrmL-1	dc.b	'AppleTalk must be'	dc.b	13	dc.b	'installed and enabled to'	dc.b	13	dc.b	'run this Control Panel.'	dc.b	13	;dc.b	' 'atalkerrmL  equ	*-atalkerrm	plist	dc.w	15		PCount	dc.l	2		ID	dc.w	20		rectangle	dc.w	LeftEdge	dc.w	62	dc.w	Rightedge	dc.l	listControl	ctrldefproc	dc.w	$80		ctlFlag	dc.w	fCtlTarget+fCtlProcRefNotPtr+fCtlCanBeTarget+fCtlWantEvents	moreFlags	dc.l	0		ref con	dc.w	0		ctlListSize	dc.w	MaxSrvrView	ctlListView	dc.w	selectOnlyOne+InsideScrollBar	dc.w	1		ctlListstart	dc.l	0		ctlListDraw	dc.w	10		ctlListMemHeight	dc.w	memrec.sizeof	ctlListMemSize	dc.l	namesbuffer	ctlListRef	dc.l	0		ctlColorRef	zlist	dc.w	15		PCount	dc.l	3		ID	dc.w	100-3		rectangle	dc.w	LeftEdge	dc.w	142-3	dc.w	RightEdge	dc.l	listControl	ctrldefproc	dc.w	$80		ctlflag	dc.w	fctlProcRefNotPtr+fCtlCanBeTarget+fCtlWantEvents	moreFlags	dc.l	0		ref con	dc.w	0		ctlListSize	dc.w	MaxZoneView	ctlListView	dc.w	selectOnlyOne+InsideScrollBar	dc.w	1		ctlListstart	dc.l	0		ctlListDraw	dc.w	10		ctlListMemHeight	dc.w	memrec.sizeof	ctlListMemSize	dc.l	zonebuffer	ctlListRef	dc.l	0		ctlColorRef			cprect	dc.w	0,0,200,300	control panel rectangle	ztext	dc.w	8		Pcount	dc.l	9		ID number	dc.w	94-4-3	dc.w	leftedge	dc.w	103-4-3	dc.w	rightedge	dc.l	statTextcontrol	dc.w	0		flag, c string	dc.w	fctlProcRefNotPtr	dc.l	0		ref con	dc.l	zonetext	text ref	dc.w	zonetextL	length of string;	buttons.	rtpbut	dc.w	9		Pcount	dc.l	5		ID number	dc.w	69	dc.w	leftedge+5+40	dc.w	69+13	dc.w	rightedge-5-40	dc.l	simpleButtoncontrol	dc.w	simpRound+ctlInvis	dc.w	fCtlWantEvents+fctlProcRefNotPtr	dc.l	0	dc.l	rtptitle	dc.l	0		;color table	dc.b	'R','r'		;key equivalents R and r with	dc.w	$0100,$0100	;the Command key	EndP	end