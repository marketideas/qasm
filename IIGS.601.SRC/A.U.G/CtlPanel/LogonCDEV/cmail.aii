;;;	cmail - check for mail folder on AppleShare.;;	Michael V. Stein	03/21/90.;;	© Apple, 1990.	blanks	off	case	on;;	equates.;;	imported addresses.;;	include files.	include	'::commonmacros.h'	include	'e16.dialog'	include	'm16.dialog'	include	'm16.gsos'	include	'm16.misctool'	include	'm16.qdaux'	include	'm16.quickdraw'	include	'm16.window';;	macros.;;	main program.main	proc		;;	cmail - check for mail folder on AppleShare.;;	entry	user has logged into their AppleShare account;		stack contains a ptr to the pathname of the mail directory.;;	exit	If there are files in the mail folder, a note alert will come ;		up and tell them this information.;;	exported addresses.	export	cmailcmail	phb	phk	plb		tsc	lda	1+3+1,s		get low word of ptr	sta	open_pblk+4	lo ptr to pathname to check	lda	1+3+1+2,s	get hi word of ptr	sta	open_pblk+4+2	hi ptr to pathname to check	_OpenGS	open_pblk	bcs	cmail1		if can't open file	lda	open_pblk+2	sta	dir_pblk+2	refnum of open file	_GetDirEntryGS  dir_pblk	php			save error code	_CloseGS  close_pblk	close the file	plp	bcs	cmail1		if error occurred	lda	dir_pblk+$e	get # of entries	beq	cmail1		if nothing in folder		jsr	daw		display alert window		cmail1	plb	tsc	lda	1,s	sta	1+4,s		move low 16 bits up	lda	1+1,s	sta	1+4+1,s		move high 16 bits up	pla	pla			remove parameter	rtl						;	data used here.	;	parameter block to get the number of entries in the directory.close_pblk  dc.w 1		PCount	dc.w	0		refnumdir_pblk  dc.w	6		PCount	dc.w	0		refnum	dc.w	0		flags	dc.w	0		base	dc.w	0		displacement	dc.l	dirbuff		ptr to buffer to hold name	dc.w	0		entrynum	dirbuff	ds.b	35		hold name returned by callaaf1	sta	open_pblk+4	lo ptr to pathname	stx	open_pblk+6	hi ptr to pathnameopen_pblk  dc.w	2		PCount	dc.w	0		refnum	dc.l	0		pathname;;	daw - display alert window.;;	entry	none.;;	exit	alert is displayed.daw	ldx	#(320-daww)/2	pha			space for result	_GetMasterSCB	pla	xba	rol	a		bcc	daw1		if 320 mode	ldx	#(640-daww)/2daw1	stx	dawa+1+2	left x	txa	clc	adc	#daww	sta	dawa+1+6	right x*** added 28-May-91 DAL	pha	_QDVersion	pla	and #$0fff	cmp #$0307	bcc @skipbeep*** end of 28-May-91 DAL*** added 9-Mar-91 DAL	pea $C100	;"You have mail" SysBeep2 code = $0100; defer to GetNextEvent, silent	ldx #$3803	jsl $e10000;	_SysBeep2*** end of 9-Mar-91 DAL@skipbeep	pha			space for result	pushw	#0		flags	pha	pha			subsitution array - not used	pushl	#dawa		reference to string	_AlertWindow	pla			get item hit off of the stack	rts		daww	equ	300		width of windowdawa	dc.b	'0'	dc.w	60,0,120,0	dc.b	'3'	dc.b	'/You have mail waiting./^#0',0	endp	end