				INCLUDE		'all.macros'				CASE		ON				EXPORT		SortLst				IMPORT		ZoneList;___________________________;SortLst;___________________________SortLst			PROC		EXPORT				PushLong	#myCompare				PushLong	ZoneList				_SortList2								rtlmemberA			equ			6memberB			equ			memberA+4min				ds.b		1temptest		ds.b		1myCompare				phd				tsc				tcd				ldy			#$02				lda			[memberA]				tax				lda			[memberA],y				sta			memberA+2				stx			memberA				lda			[memberB]				tax				lda			[memberB],y				sta			memberB+2				stx			memberB				sep			#$30				LONGA		OFF				LONGI		OFF				lda			[memberA]		;				cmp			[memberB]		;compare it to memberB					blt			cont1			;if memberB >= memberA then branch around					lda			[memberB]		;elsecont1			sta			min				;store memberB as the shortest string				ldy			#$00loop			iny				lda			[memberB],y				jsr			makecap				sta			temptest				lda			[memberA],y				jsr			makecap				cmp			temptest				bne			stopcmp			;we have a difference				cpy			min				;chars are the same so check if more bytes to check				beq			short			;no more bytes to check, shortest string completed scan				bra			loop			;more chars to go...	stopcmp			bge			AgeB			;A>=B				bra			AlB				;if A !> B then must be A<Bshort			lda			[memberA]		;the shortest string is less than the longer				cmp			[memberB]		;				blt			AlB				;AgeB			sec							;A>=B then sec				bra			bye				;AlB				clc							;A<B then clc			bye				rep			#$30			;				LONGA		ON				LONGI		ON				lda			0+2				;remove input params and return				sta			8+2				lda			2+2				sta			10+2				pld				pla				pla				pla				pla				rtl				LONGA		off				LONGI		offmakecap			cmp			#'a'				blt			quit				cmp			#'z'+1				bge			quit				sec				sbc			#$20quit			rts				LONGA		ON				LONGI		ON				END				ENDPROC