## This is the makefile for the AppleShare (logon) CDEV.## The CDEV file itself is called "AppleShare".  Its code is put# in the file AppleShare.Load and then RezIIGS'd with the rest# of the resources into the CDEV.## 31-May-90	MSD	Fixed dependencies to accurately reflect#			how files depend on each other (particularly#			due to including ".h" files.### The CDEV file depends on the code segment, and on the resource# definitions.#AppleShare	Ä	AppleShare.Load AppleShare.r	reziigs AppleShare.r -o AppleShare -t "C7  " -c "pdos"	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac AppleShare :	End## AppleShare.Load contains the single code segment used by# the CDEV.  It depends on all of the object files.#AppleShare.Load	Ä	¶		Appleshare.c.obj 	¶		AutoLogon.c.obj 	¶		Dialog1.c.obj 		¶		Dialog2.c.obj 		¶		ASPCalls.c.obj 		¶		PasswordDialog.c.obj 	¶		ErrorHandling.c.obj 	¶		myglobals.c.obj 	¶		GSOS.c.obj		¶		VolumePassword.c.obj	¶		DES.aii.obj 		¶		AlphaSort.aii.obj	¶		ple.aii.obj		¶		cmail.aii.obj# used to say linkiigs -w -x..., but -w masks out missing-symbol errors!  --DAL	linkiigs -w -x -lseg:$1000 scott	¶		Appleshare.c.obj 	¶		AutoLogon.c.obj 	¶		Dialog1.c.obj 		¶		Dialog2.c.obj 		¶		ASPCalls.c.obj 		¶		PasswordDialog.c.obj 	¶		ErrorHandling.c.obj 	¶		myglobals.c.obj 	¶		GSOS.c.obj 		¶		VolumePassword.c.obj	¶		DES.aii.obj 		¶		AlphaSort.aii.obj	¶		ple.aii.obj		¶		cmail.aii.obj		¶		"{CIIGSLibrary}"CLib(@main) ¶		"{CIIGSLibrary}"CLib(@~globals) ¶		-lib "{CIIGSLibrary}"CLib ¶		 -o AppleShare.Load## Here are the specific dependencies for individual object files.# Each file depends on its source, and any local ".h" file it# includes.  No build rules are included.  These are only dependencies.## Note: If the system-supplied include files (i.e. the ones in# MPW's Interface folder) change, the file should be completely# rebuilt.#Appleshare.c.obj 	Ä	¶		Appleshare.c	¶		TYPES.h		¶		GSOS.h		¶		LIST.h		¶		resmg