{*****************************************************************}{{ Slots CDEV{{ Copyright (C)   1988-1991{ Apple Computer, Inc.{ All Rights Reserved{{ By Darryl Lovato{{ This is the pascal code to implement the SLOTS CDEV{{{ Change History{{ 24 Mar 89		Steven Glass{{ Added check for what machine we are on so can treat GS { different from Tenspeed.{{ Create different controls if running on GS vs TenSpeed.{{ Changed CheckPopUpItems to see what machine.{{ 3-Jun-91 Dave Lyons (and a couple weeks ago, too){{ Changed slot 5 to be dimmed on Mark Twain.  Changed slot 7{ to say "SCSI" instead of "Your Card" (you can also still set{ 7 to AppleTalk).{{ 1-Jul-91 DAL{{ Commented out Mark Twain stuff.{{*****************************************************************}{$LongGlobals+}{$toolerrorchk-}{$a+}unit Slots;interfaceuses  QDIntf, GSIntf, misctools, Prodos16, ResMgr, CDEVMgr, newinterface; function Slots_DEFPROC(message : Integer; data1, data2 : Longint) : Longint;procedure EnablePopupItem(ctlID : integer; item : integer);procedure DisablePopupItem(ctlID : integer; item : integer);procedure CheckPopupItems;implementationconst	{ BParam ID Values }	Slot1ID = $21;	Slot2ID = $22;	Slot3ID = $23;	Slot4ID = $24;	Slot5ID = $25;	Slot6ID = $26;	Slot7ID = $27;	BootID = $28;		{ BParam Setting Values }	Slot1Printer = 0;	Slot1YourCard = 1;	Slot1ATalk = 2;	Slot1modem = 3;		Slot2Modem = 0;	Slot2YourCard = 1;	Slot2ATalk = 2;	Slot2Printer = 3;		Slot7Appletalk = 0;	Slot7YourCard = 1;		{ Control IDs are equal to setting values plus 1 }	var  OrigGS : boolean;  wind : windowPtr;  {$XRefVar+}  GSSlotsList : integer;  TenSpeedSlotsList : integer;{  MarkTwainSlotsList : integer; }  SlotsAbout : integer;  {$XRefVar-}function Slots_DEFPROC(message : Integer; data1, data2 : Longint) : Longint;  var    tempCtl : ControlHandle;	Atemp, XTemp, YTemp, PTemp : integer;	slot1Item, slot2Item, popVal, slotSet : INTEGER; { added 10/23/91 by Monte Benaresh	}	  procedure debug; inline $00;	  begin { this will only get called when a ctl is hit, and before its displayed }	Slots_DEFPROC := 0;	case message of	  CreateCDEV :	    begin		  FWEntry(Atemp,XTemp,YTemp,PTemp,$FE1F);		  OrigGS :=  YTemp < 2 ;		  wind := WindowPtr(data1);		  if OrigGS then		    tempCtl := NewControl2(wind,3,ord4(@GSSlotsList))		  else{		    if YTemp=3 then }  		      tempCtl := NewControl2(wind,3,ord4(@TenSpeedSlotsList)){			else			  tempCtl := NewControl2(wind,3,ord4(@MarkTwainSlotsList)) } ;		end;	  InitCDEV :	    begin		{ for slots 1 & 2, on ROM 01 we set the popup item based on the actualÉ	}		{Éslot setting AND the device type of the corresponding port			}			IF OrigGS THEN				BEGIN					IF ReadBParam(Slot1ID) = Slot1YourCard THEN						slot1Item := 2	{ set to "your card" }					ELSE	{ check port setting }						IF ReadBParam($0) = 0 THEN { port 1 set to printer?	}							slot1Item := 1						ELSE							slot1Item := 3;	{ set to modem	}					IF ReadBParam(Slot2ID) = Slot2YourCard THEN						slot2Item := 2	{ set to "your card" }					ELSE	{ check port setting }						IF ReadBParam($C) = 1 THEN { port 2 set to modem?	}							slot2Item := 1						ELSE							slot2Item := 3;	{ set to printer	}				END			ELSE				BEGIN	{ set Tenspeed the easy way	}					slot1Item := ReadBParam(Slot1ID)+1;					slot2Item := ReadBParam(Slot2ID)+1;				END;			SetCtlValue(slot1Item,GetCtlHandleFromID(WindowPtr(data1),1));			SetCtlValue(slot2Item,GetCtlHandleFromID(WindowPtr(data1),2));	{		SetCtlValue(ReadBParam(Slot1ID)+1,						GetCtlHandleFromID(WindowPtr(data1),1));	}	{		SetCtlValue(ReadBParam(Slot2ID)+1,						GetCtlHandleFromID(WindowPtr(data1),2));	}			SetCtlValue(ReadBParam(Slot3ID)+1,GetCtlHandleFromID(WindowPtr(data1),3));			SetCtlValue(ReadBParam(Slot4ID)+1,GetCtlHandleFromID(WindowPtr(data1),4));			SetCtlValue(ReadBParam(Slot5ID)+1,GetCtlHandleFromID(WindowPtr(data1),5));			SetCtlValue(ReadBParam(Slot6ID)+1,GetCtlHandleFromID(WindowPtr(data1),6));			SetCtlValue(ReadBParam(Slot7ID)+1,GetCtlHandleFromID(WindowPtr(data1),7));			SetCtlValue(ReadBParam(BootID)+1,GetCtlHandleFromID(WindowPtr(data1),8));			CheckpopupItems;		end;	  HitCDEV :	    begin		{ for slots 1 & 2, on ROM 01 we must set the serial port device typeÉ	}		{Ébased on the popup menu item											}			IF OrigGS AND ((data2 = 1) OR (data2 = 2))	{ check ctl ID	} THEN				BEGIN				popVal := GetCtlValue(ControlHandle(data1));				CASE popVal OF					2: slotSet := 1;	{ set to "Your Card }					1,3:						BEGIN						slotSet := 0;	{ set to internal	}						IF data2 = 1 THEN	{ printer port? }							BEGIN							IF popVal = 1 THEN								WriteBParam(0,0)	{ set to printer }							ELSE								WriteBParam(1,0);	{ set to modem	}							END						ELSE							BEGIN							IF popVal = 3 THEN								WriteBParam(0,$C)	{ set to printer }							ELSE								WriteBParam(1,$C);	{ set to modem	}							END;						END;				END; {case}				WriteBParam(slotSet, $20 + loword(data2));	{ set slot int/ext	}				END {begin}			ELSE				WriteBParam(GetCtlValue(ControlHandle(data1))-1, $20 + loword(data2));			CheckpopupItems;		end;	  AboutCDEV :	    tempCtl := NewControl2(WindowPtr(data1),3,ord4(@SlotsAbout));	end; {case}  end;procedure EnablePopupItem(ctlID : integer; item : integer);  var    mymenuBar : MenuBarHandle;  begin    mymenuBar := GetMenuBar;	SetMenuBar(MenuBarHandle(GetCtlHandleFromID(wind,ctlID)));	EnableMItem(item);	SetMenuBar(mymenuBar);  end;  procedure DisablePopupItem(ctlID : integer; item : integer);  var    mymenuBar : MenuBarHandle;  begin    mymenuBar := GetMenuBar;	SetMenuBar(MenuBarHandle(GetCtlHandleFromID(wind,ctlID)));	DisableMItem(item);	SetMenuBar(mymenuBar);  end;  procedure CheckPopupItems;  var    bytePtr : StringPtr;{	saveit : integer;	}    tempHndl : ControlHandle;  begin  	if OrigGS then		begin			{ Assume every thing is ok by enabling appletalk in slot 7 pop up}			EnablePopupItem(7,Slot7AppleTalk+1);						{ Now check if we have the case that AppleTalk is not allowed }			if (ReadBParam(Slot1ID) = Slot1Printer) and (ReadBParam(Slot2ID) = Slot2Modem) then				begin					{ Both slot 1 and 2 are set to internal so must disable appletalk in 7 }					{ and force the pop up to have your card. }					DisablePopupItem(7,1);					SetCtlValue(Slot7YourCard+1, GetCtlHandleFromID(wind,7));					WriteBParam(Slot7YourCard,slot7Id);				end;		end	else		begin			EnablePopupItem(1,3);			EnablePopupItem(2,3);			EnablePopupItem(7,1);			if ReadBParam($21) = 2 then			  DisablePopupItem(2,3)			else if ReadBParam($22) = 2 then			  DisablePopupItem(1,3)			else			  begin				WriteBParam(1, $27);				SetCtlValue(2, GetCtlHandleFromID(wind,7));				DisablePopupItem(7,1);			  end;		end;	if origGS then	{	case ReadBParam(slot1ID) of			*** removed 10/24/91 by Monte		  Slot1Printer : writeBParam(0,0);		  (* start JAM 07/26/89:  Fixing BRC #51944 *)		  Slot1YourCard : BEGIN (* writeBParam(1,0) *) END (* null statement *);		  (* In fixing BRC #51944, we leave slot 1 firmware alone when switching to		  	 Your Card.  This helps those such as Remote Print Manager, who want to treat			 AppleTalk as a printer, but cannot unless the proper firmware is in place.			 			 Real solution to this problem is to rewrite printer port and modem port			 CDEVs to allow the user to change the type of device connected, and avoid			 switching the firmware in the slots CDEV at all.		  *)		  (* end   JAM 07/26/89:  Fixing BRC #51944 *)		end	}	else		case ReadBParam(slot1ID) of		  Slot1Printer : writeBParam(0,0);		  Slot1YourCard : writeBParam(3,0);		  Slot1ATalk : writeBParam(2,0);		  Slot1Modem : writeBParam(1,0);		end;		bytePtr := StringPtr($E102E1);	{ BRAM buffer starts at $E102C0	}	if (ReadBParam(slot7ID) = Slot7Appletalk) and (ReadBParam(slot1ID) = slot1Atalk) then	  bytePtr^[0] := char(1)	else	  bytePtr^[0] := char(0);	  	if origGS then	(*	case ReadBParam(slot2ID) of			*** removed 10/24/91 by Monte		  Slot2Modem : writeBParam(1,$C);		  Slot2YourCard : { writeBParam(0,$C)	removed 10/21/91 by Monte	} ;		end	*)	else	{ TenSpeed	}	  BEGIN		case ReadBParam(Slot2ID) of		  Slot2Printer : writeBParam(0,$C);		  Slot2YourCard : writeBParam(3,$C);		  Slot2ATalk : writeBParam(2,$C);		  Slot2Modem : writeBParam(1,$C);		end;	{ on TenSpeed check whether boot slot can be AppleTalk	}		IF (ReadBParam(slot1ID) <> Slot1ATalk)				AND (ReadBParam(slot2ID) <> Slot2ATalk) THEN			BEGIN	{ don't allow boot from AppleTalk	}				tempHndl := GetCtlHandleFromID(WindowPtr(wind),8);				IF GetCtlValue(tempHndl) = 11 THEN					BEGIN	{ must change setting	}						SetCtlValue(1, tempHndl);	{ set to "Scan" }						WriteBParam(0, BootID);					END;				DisablePopupItem(8,11);	{ disable AppleTalk startup	}			END		ELSE			BEGIN	{ allow boot from AppleTalk	}				EnablePopupItem(8,11);	{ enable AppleTalk startup	}			END;	  END;  end;  end.