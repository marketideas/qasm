;;;	printerdata - initialized data for the printer cdev.;;	Michael V. Stein	04/01/90.;;	© Copyright Apple Computer, 1990.	blanks off;;	include files.	include	'e16.control';;	equates.y1	equ	2y2	equ	y1+9y3	equ	y1+15y4	equ	y3+15y5	equ	y4+15y6	equ	y5+15y7	equ	y6+15y8	equ	y7+10y9	equ	y8+10y10	equ	y9+10y11	equ	y10+10y12	equ	y11+10y13	equ	y12+10ya3	equ	y3ya4	equ	ya3+15ya5	equ	ya4+10ya6	equ	ya5+10data	proc;;	exported addresses.	export	devptr	export	devlen	export	nbut	export	printerabout	export	printeralist	export	printerlist	export	slotlen	export	slotptr			slotptr	dc.w	sname0	dc.w	sname1	dc.w	sname2	dc.w	sname3slotlen	dc.w	sname1-sname0	dc.w	sname2-sname1	dc.w	sname3-sname2	dc.w	send-sname3	sname0	dc.b	'Printer'sname1	dc.b	'Your Card'sname2	dc.b	'AppleTalk'sname3	dc.b	'Modem'send	equ	*		devc	dc.W	8			; pcount	dc.L	$8001			;static text item	dc.W	y1,5,y1+10,100		; boundry rect	dc.L	statTextControl		; procRef	dc.W	inactiveHilite<<8	; flag	dc.W	$1000			; moreFlags		dc.L	0			; refCon	dc.L	devstr			; textRef	dc.W	devstrL			; text lengthdevstr	dc.b	'Device Type:'devstrL	equ	*-devstr	devslt	dc.W	8			; pcount	dc.L	$8001			;static text item	dc.W	y1,104,y1+10,195	; boundry rect	dc.L	statTextControl		; procRef	dc.W	inactiveHilite<<8	; flag	dc.W	$1000			; moreFlags		dc.L	0			; refCondevptr	dc.l	devslt			; textRef (hi word is valid)devlen	dc.W	0			; text length	string ASISPrinter1 dc.w	9	dc.l	1	dc.w	y3,5,y3+12,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	95	dc.l	Printer1Menu	dc.w	1	Printer1menu	dc.B '>> Parity:\H'	dc.W 1	dc.B $0D	dc.B '== Odd\H'	dc.W 1	dc.B $0D	dc.B '== Even\H'	dc.W 2	dc.B $0D	dc.B '== None\IH'	dc.W 3	dc.B $0D	dc.B '.'		Printer2 dc.w	9	dc.l	2	dc.w	y4,5,y4+12,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	95	dc.l	Printer2Menu	dc.w	1	Printer2menu	dc.B '>> Baud:\H'	dc.W 2	dc.B $0D	dc.B '== 50\H'	dc.W 1	dc.B $0D	dc.B '== 75\H'	dc.W 2	dc.B $0D	dc.B '== 110\H'	dc.W 3	dc.B $0D	dc.B '== 134.5\H'	dc.W 4	dc.B $0D	dc.B '== 150\H'	dc.W 5	dc.B $0D	dc.B '== 300\H'	dc.W 6	dc.B $0D	dc.B '== 600\H'	dc.W 7	dc.B $0D	dc.B '== 1200\H'	dc.W 8	dc.B $0D	dc.B '== 1800\H'	dc.W 9	dc.B $0D	dc.B '== 2400\H'	dc.W 10	dc.B $0D	dc.B '== 3600\H'	dc.W 11	dc.B $0D	dc.B '== 4800\H'	dc.W 12	dc.B $0D	dc.B '== 7200\H'	dc.W 13	dc.B $0D	dc.B '== 9600\IH'	dc.W 14	dc.B $0D	dc.B '== 19200\H'	dc.W 15	dc.B $0D	dc.B '.'	Printer3  dc.w	9	dc.l	3	dc.w	y5,5,y5+12,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	95	dc.l	Printer3Menu	dc.w	1	Printer3menu	dc.B '>> Line Length:\H'	dc.W 3	dc.B $0D	dc.B '== Unlimited\IH'	dc.W 1	dc.B $0D	dc.B '== 40\H'	dc.W 2	dc.B $0D	dc.B '== 72\H'	dc.W 3	dc.B $0D	dc.B '== 80\H'	dc.W 4	dc.B $0D	dc.B '== 132\H'	dc.W 5	dc.B $0D	dc.B '.'		Printer4  dc.w	9	dc.l	4	dc.w	y6,5,y6+12,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	95	dc.l	Printer4Menu	dc.w	1	Printer4menu	dc.B '>> Data/Stop:\H'	dc.W 4	dc.B $0D	dc.B '== 5-1\H'	dc.W 1	dc.B $0D	dc.B '== 5-2\H'	dc.W 2	dc.B $0D	dc.B '== 6-1\H'	dc.W 3	dc.B $0D	dc.B '== 6-2\H'	dc.W 4	dc.B $0D	dc.B '== 7-1\H'	dc.W 5	dc.B $0D	dc.B '== 7-2\H'	dc.W 6	dc.B $0D	dc.B '== 8-1\IH'	dc.W 7	dc.B $0D	dc.B '== 8-2\H'	dc.W 8	dc.B $0D	dc.B '.'		string PASCAL	; from here on, we need pascal stringsPrinter5 dc.w 8	dc.L 5	dc.w y7,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L Printer5Title	dc.w 0Printer5Title	dc.b 'Delete LF after CR'	Printer6  dc.w 8	dc.L 6	dc.w y8,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L Printer6Title	dc.w 0Printer6Title	dc.b 'Add LF after CR'	Printer7  dc.w 8	dc.L 7	dc.w y10,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L Printer8Title	dc.w 0Printer7Title	dc.b 'Echo'	Printer8 dc.w 8	dc.L 8	dc.w y9,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L Printer7Title	dc.w 0Printer8Title	dc.b 'Buffering'	Printer9  dc.w 8	dc.L 9	dc.w y11,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L Printer9Title	dc.w 0Printer9Title	dc.b 'DCD Handshake'	Printer10  dc.w 8	dc.L 10	dc.w y12,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L Printer10Title	dc.w 0Printer10Title	dc.b 'DSR/DTR Handshake'	Printer11  dc.w 8	dc.L 11	dc.w y13,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L Printer11Title	dc.w 0Printer11Title	dc.b 'XON/XOFF Handshake'	PrinterList		dc.l	devc	dc.l	devslt	dc.l	Printer1	dc.l	Printer2	dc.l	Printer3	dc.l	Printer4	dc.l	Printer5	dc.l	Printer6	dc.l	Printer7	dc.l	Printer8	dc.l	Printer9	dc.l	Printer10	dc.l	Printer11	dc.l	nbut	dc.l	0			string asis	PrinterA1  dc.w	9	dc.l	3	dc.w	ya3,5,ya3+12,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	95	dc.l	PrinterA1Menu	dc.w	1	PrinterA1menu	dc.B '>> Line Length:\H'	dc.W 3	dc.B $0D	dc.B '== Unlimited\IH'	dc.W 1	dc.B $0D	dc.B '== 40\H'	dc.W 2	dc.B $0D	dc.B '== 72\H'	dc.W 3	dc.B $0D	dc.B '== 80\H'	dc.W 4	dc.B $0D	dc.B '== 132\H'	dc.W 5	dc.B $0D	dc.B '.'		string PASCAL	; from here on, we need pascal stringsPrinterA2   dc.w 8	dc.L 5	dc.w ya4,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L PrinterA2Title	dc.w 0PrinterA2Title	dc.b 'Delete LF after CR'	PrinterA3 dc.w 8	dc.L 6	dc.w ya5,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L PrinterA3Title	dc.w 0PrinterA3Title	dc.b 'Add LF after CR'	PrinterA4   dc.w 8	dc.L 8	dc.w ya6,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L PrinterA4Title	dc.w 0PrinterA4Title	dc.b 'Echo'	PrinteraList		dc.l	devc	dc.l	devslt		dc.l	PrinterA1	dc.l	PrinterA2	dc.l	PrinterA3	dc.l	PrinterA4	dc.l	nbut	dc.l	0	PrinterAbout	dc.w 8	dc.L 1	dc.w 38,5,138,280	dc.L $81000000	dc.w $0000	dc.w $1000	dc.L 0	dc.L TheText	dc.w EndText-TheText	string asisTheText	dc.b 'The Printer Port Control Panel allows you to change the Printer Port '	dc.b 'settings.  These include the Parity, Baud, Line Length, Data/Stop '	dc.b 'bits, and a host of others.  If you are using a modem or printer, you should consult '	dc.b 'your User’s Guide for that peripheral. If the Printer Port (slot 1) is '	dc.b 'set up for AppleTalk, only a subset of the normal settings will be available '	dc.b 'for modification.'EndText	string pascalnbut	dc.w	9		Pcount	dc.l	30		ID number	dc.w	132-7	dc.w	5+10	dc.w	132+13-7	dc.w	195-10	dc.l	simpleButtoncontrol	dc.w	simpRound	dc.w	fCtlWantEvents+fctlProcRefNotPtr	dc.l	0	dc.l	nbutit	dc.w	0		length?	dc.w	0		key equivalent	string	pascalnbutit	dc.b	'Standard Settings'		endp		END