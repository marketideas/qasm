CDEV = PRINTER{CDEV}			 	Ä				{CDEV}.Load 	¶									{CDEV}.r	reziigs {CDEV}.r -o {CDEV} -t "C7  " -c "pdos"	if {dup}				# test whether we should duplicateiigs		duplicateiigs -m -y {CDEV} {CDEV}	end{CDEV}.Load		Ä	¶									{CDEV}.aii.obj ¶									{CDEV}Data.aii.obj	linkiigs  		¶		-x -l -s >{CDEV}.map ¶		-lseg printer ¶			{CDEV}.aii.obj ¶			{CDEV}Data.aii.obj ¶		-o {CDEV}.Load {CDEV}.aii.obj 		Ä 								¶							{CDEV}.aii						asmiigs {CDEV}.aii {CDEV}Data.aii.obj 		Ä 								¶							{CDEV}Data.aii	asmiigs {CDEV}Data.aii 