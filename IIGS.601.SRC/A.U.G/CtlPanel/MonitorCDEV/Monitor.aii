;************************************************************************;; Monitor control panel for System 6.0.1; by David A. Lyons, September 1992;; Rewritten from the 6.0 Monitor control panel in 6.0,; which was by Michael V. Stein 02/24/90 (TMLPascal).;; © Copyright Apple Computer, 1990-1992; All Rights Reserved;;************************************************************************;;  8-Sep-92 DAL;   Initial coding.;; 18-Sep-92 DAL;   Widened window, realigned pop-up menus, added checkbox.;;************************************************************************debugSymbols	equ 0	include 'all.macros'	include 'e16.resources'	include 'e16.locator'	include 'e16.desk'	include 'e16.event'	import MonitorsListMachineCDEV	equ 1	;called when rebuilding cdev.data to see if cdev should be includedBootCDEV	equ 2	;boot time init call or install call - no paramsShutDownCDEV	equ 3	;reserved for future useInitCDEV 	equ 4	;called when being shown - data1 equ windowPtrCloseCDEV 	equ 5	;called when being removed - data1 equ windowPtrEventsCDEV	equ 6	;called when an event - data1 equ ptr to event recordCreateCDEV	equ 7	;called so that CDEV can create its controls inline - data1 equ windowAboutCDEV 	equ 8	;called so that CDEV can create its about text inline - no paramsRectCDEV	equ 9	;called so that CDEV can dynamically compute its rectangleHitCDEV	equ 10	;called when ctl is "hit" - data1 equ Hdl to Ctl hit, data2 equ Ctl IdRunCDEV	equ 11	;caled when da run is calledEditCDEV 	equ 12	;called when SystemEdit is calledwantMachine 	equ 1wantBoot 	equ 2wantShutDown	equ 4wantInit	equ 8wantClose 	equ 16wantEvents 	equ 32wantCreate 	equ 64wantAbout 	equ 128wantRect 	equ 256wantHit 	equ 512wantRun 	equ 1024wantEdit	equ 2048updateSSfromBRAM	equ 16384;; Control IDs;ColorTypeID	equ 1	;Color/Monochrome pop-upColumnsID	equ 2	;80/40 pop-upTextColorID	equ 3	;Text color pop-upBackColorID	equ 4	;background color pop-upBorderColorID	equ 5	;border color pop-upCursorFlickerID	equ 6	;cursor flicker checkbox;; battery parameter values.;toolbox_param	equ $5f*************************************************************************** Monitor control panel -- MAIN ENTRY POINT** At this point, the stack contains:** 14..17,s  LONG  Result Space* 12..13,s  WORD  Message* 08..11,s  LONG  Data1* 04..07,s  LONG  Data2* 01..03,s     RTL**************************************************************************MonitorCP	procname export	phb	;save calling data bank	phk	plb	phd	tsc	tcdoldD	equ 1oldB	equ oldD+2rtlAddr	equ oldB+1data2	equ rtlAddr+3data1	equ data2+4message	equ data1+4result	equ message+2	stz <result	stz <result+2	lda <message	asl a	tax	cmp #DispatchEnd-Dispatch	bcs @ignore	jsr (Dispatch,x)@ignore	pld	plb	lda 1,s	sta 1+10,s	;move low word of return address	lda 2,s	sta 2+10,s	;move high word of return address (overlaps)	ply	ply	ply	ply	ply	;pull ten bytes of input parameters	rtlDispatch	dc.w ignore 	; 0 = reserved	dc.w ignore	; 1 = MachineCDEV	dc.w ignore	; 2 = BootCDEV	dc.w ignore	; 3 = reserved	dc.w doInit	; 4 = InitCDEV	dc.w ignore	; 5 = CloseCDEV	dc.w ignore	; 6 = EventsCDEV	dc.w doCreate	; 7 = CreateCDEV	dc.w doAbout	; 8 = AboutCDEV	dc.w ignore	; 9 = RectCDEV	dc.w doHit	;10 = HitCDEV;	dc.w ignore	;11 = RunCDEV;	dc.w ignore	;12 = EditCDEVDispatchEnd*************************************************************************** ignore -- don't do anything with a CDEV message**************************************************************************ignore	rts**************************************************************************************************************************************************** handle CreateCDEV message**************************************************************************doCreate	name	pha	pha	;space for NewControl2 result	pei <data1+2	pei <data1	;window pointer	pea 3	;control list pointer	pushlong #MonitorsList	_NewControl2	pla	pla	;ignore result*** Keep a global copy of the window pointer	lda <data1+2	sta wind+2	lda <data1	sta wind	rts**************************************************************************************************************************************************** handle AboutCDEV message**************************************************************************doAbout	name	import MonitorAbout	pha	pha	pei <data1+2	pei <data1	pea 3	;pointer to control list	pushlong #MonitorAbout	_NewControl2	pla	pla	rts**************************************************************************************************************************************************;; doInit - init controls;; data1 = ptr to window.;;; Set all five pop-up menus from Battery RAM.;; ID  BRAM  What; --  ----  ----;  1  $18   Color/Monochrome;  2  $19   80/40 Columns;  3  $1A   Text color;  4  $1B   Background color;  5  $1C   Border color;; Location $5F bit 2 is the "smooth mouse cursor" bit (no scanline ints).;*************************************************************************doInit	namecounter	equ data2*** set up the "Smoother Mouse Cursor" checkbox	ldx #$5f	jsr ReadBatteryParam	and #4	lsr a	lsr a	pha	;value for checkbox = bit 2 of BRAM $5F	pei <data1+2	pei <data1	;window pointer	pea 0	pea 6	;checkbox ID = 6	ldx #$3c10	jsl $e10000;	_SetCtlValueByID*** set up the pop-up menus	lda #5	;control ID/loop counter	sta <counter@next	lda <counter	clc	adc #$17	tax	jsr ReadBatteryParam	inc a	pha	;value for SetCtlValueByID	pei <data1+2	pei <data1	;window pointer	pea 0	;high word of control ID	pei <counter	;low word control ID;	_SetCtlValueByID	ldx #$3c10	jsl $e10000	dec counter	bne @next	brl DisableSomeColors;	rts**************************************************************************************************************************************************;; doHit - hit control;; entry;	data1 = handle of control that was hit.;	data2 = id of control that was hit.;; exit	Took appropriate action for the control that was;	hit.;*************************************************************************doHit	name	lda <data2	;get id of control	asl a	cmp #HitDispatchEnd-HitDispatch	bcs @done	tax	jmp (HitDispatch,x)@done	rtsHitDispatch	dc.w ignore	;0	dc.w StuffBRAM	;1 = Color/Monochrome pop-up	dc.w StuffBRAM	;2 = 80/40 pop-up	dc.w CarefulColors	;3 = Text color pop-up	dc.w CarefulColors	;4 = Background color pop-up	dc.w StuffBRAM	;5 = Border color pop-up	dc.w hitCheckbox	;6 = cursor flicker checkboxHitDispatchEnd*************************************************************************;; StuffBRAM;; For any pop-up menu, we write the new pop-up value (minus one) into; Battery RAM location $17 plus the control's ID.;*************************************************************************StuffBRAM	name	pha	;space for control value	pei <data1+2	pei <data1	_GetCtlValue	pla	dec a	;value minus one for Battery RAM	pha	clc	lda <data2	;control ID + $17 = BRAM parameter	adc #$17	tax	pla;;;	brl WriteBatteryParam  ;A=value, X=parm*************************************************************************;; WriteBatteryParam;; entry	(a) = value of parameter to set.;	(x) = battery parameter to set.;; exit	battery parameter is set.;*************************************************************************WriteBatteryParam	name	pha	;new value	phx	;parameter to set	_WriteBparam	rts*************************************************************************;; CarefulColors;; For any the Text color or Background color pop-up menus, we write; the new value just like in StuffBRAM, but we have to be careful to; disallow the text and background colors ever being the same.;*************************************************************************CarefulColors	name	jsr EnableSomeColors	jsr StuffBRAM*************************************************************************;; DisableSomeColors;; Make sure they can't choose the same Text color and Background color.;*************************************************************************DisableSomeColors	pha	pha	_GetMenuBar	ldx #4	;background pop-up	jsr SetMenuToPopUp	ldx #$17+3	;text color	jsr ReadBatteryParam	inc a	sta dimmedBackItem	jsr DisableItemA	ldx #3	;text color pop-up	jsr SetMenuToPopUp	ldx #$17+4	;background color	jsr ReadBatteryParam	inc a	sta dimmedTextItem	jsr DisableItemA	bra restoreMenuBar;; SetMenuToPopUp--pop-up control ID in X;SetMenuToPopUp	pha	pha	;space for GetCtlHandleFromID	pushlong wind	pea 0	phx	_GetCtlHandleFromID	_SetMenuBar	rtsDisableItemA	pha	_DisableMItem	rts*************************************************************************;; EnableSomeColors;; Enable the menu items we disabled.;*************************************************************************EnableSomeColors	name	pha	pha	_GetMenuBar	ldx #3	;text color pop-up	jsr SetMenuToPopUp	lda dimmedTextItem	pha	_EnableMItem	ldx #4	;background color pop-up	jsr SetMenuToPopUp	lda dimmedBackItem	pha	_EnableMItemrestoreMenuBar	_SetMenuBar	rts*************************************************************************** hitCheckBox -- toggle the Cursor Flicker checkbox** Set bit 2 of BRAM $5F according to the value of our checkbox (ID=6).**************************************************************************hitCheckBox	name	ldx #$5f	jsr ReadBatteryParam	and #$ff-$04	;clear out our bit	pha	pha	;space for GetCtlValue	pei <data1+2	pei <data1	;control handle	_GetCtlValue	pla	beq @1	;if not set	lda #4	;mask to OR into BRAM value@1	ora 1,s	ply	;discard old value	ldx #$5f	brl WriteBatteryParam*************************************************************************;; ReadBatteryParam;; entry	(x) = parameter to read.;; exit	(a) = value of parameter.;*************************************************************************ReadBatteryParam	name	pha	;space for result	phx	;parameter to read	_ReadBparam	pla	;get value	rts*************************************************************************;; GLOBALS;*************************************************************************CursorFlickerFlag	dc.w 0wind	dc.l 0dimmedTextItem	dc.w 0	;this text color is not availabledimmedBackItem	dc.w 0	;this background color is not available	EndP	end