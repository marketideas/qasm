	dc.B '== Orange\H'	dc.W 10	dc.B $0D	dc.B '== Light Gray\H'	dc.W 11	dc.B $0D	dc.B '== Pink\H'	dc.W 12	dc.B $0D	dc.B '== Light Green\H'	dc.W 13	dc.B $0D	dc.B '== Yellow\H'	dc.W 14	dc.B $0D	dc.B '== Aquamarine\H'	dc.W 15	dc.B $0D	dc.B '== White\IH'	dc.W 16	dc.B $0D	dc.B '.'	ENDP	monitor4 PROC EXPORT	dc.w	9	dc.l	4	dc.w	47,5,59,195+20	dc.l	$87000000	dc.w	$0040*	dc.w	$1004	dc.w	$1084	;turn on bit 7 = fDrawArrowIcon, 21-Jan-91 DAL	dc.l	0	dc.w	80	dc.l	monitor4Menu	dc.w	1	monitor4menu	dc.B '>> Back:\H'	dc.W 4	dc.B $0D	dc.B '== Black\H'	dc.W 1	dc.B $0D	dc.B '== Deep Red\H'	dc.W 2	dc.B $0D	dc.B '== Dark Blue\H'	dc.W 3	dc.B $0D	dc.B '== Purple\H'	dc.W 4	dc.B $0D	dc.B '== Dark Green\H'	dc.W 5	dc.B $0D	dc.B '== Dark Gray\H'	dc.W 6	dc.B $0D	dc.B '== Medium Blue\IH'	dc.W 7	dc.B $0D	dc.B '== Light Blue\H'	dc.W 8	dc.B $0D	dc.B '== Brown\H'	dc.W 9	dc.B $0D	dc.B '== Orange\H'	dc.W 10	dc.B $0D	dc.B '== Light Gray\H'	dc.W 11	dc.B $0D	dc.B '== Pink\H'	dc.W 12	dc.B $0D	dc.B '== Light Green\H'	dc.W 13	dc.B $0D	dc.B '== Yellow\H'	dc.W 14	dc.B $0D	dc.B '== Aquamarine\H'	dc.W 15	dc.B $0D	dc.B '== White\H'	dc.W 16	dc.B $0D	dc.B '.'	ENDPmonitor5 PROC EXPORT	dc.w	9	dc.l	5	dc.w	62,5,74,195+20	dc.l	$87000000	dc.w	$0040*	dc.w	$1004	dc.w	$1084	;turn on bit 7 = fDrawArrowIcon, 21-Jan-91 DAL	dc.l	0	dc.w	80	dc.l	monitor5Menu	dc.w	1	monitor5menu	dc.B '>> Border:\H'	dc.W 5	dc.B $0D	dc.B '== Black\H'	dc.W 1	dc.B $0D	dc.B '== Deep Red\H'	dc.W 2	dc.B $0D	dc.B '== Dark Blue\H'	dc.W 3	dc.B $0D	dc.B '== Purple\H'	dc.W 4	dc.B $0D	dc.B '== Dark Green\H'	dc.W 5	dc.B $0D	dc.B '== Dark Gray\H'	dc.W 6	dc.B $0D	dc.B '== Medium Blue\IH'	dc.W 7	dc.B $0D	dc.B '== Light Blue\H'	dc.W 8	dc.B $0D	dc.B '== Brown\H'	dc.W 9	dc.B $0D	dc.B '== Orange\H'	dc.W 10	dc.B $0D	dc.B '== Light Gray\H'	dc.W 11	dc.B $0D	dc.B '== Pink\H'	dc.W 12	dc.B $0D	dc.B '== Light Green\H'	dc.W 13	dc.B $0D	dc.B '== Yellow\H'	dc.W 14	dc.B $0D	dc.B '== Aquamarine\H'	dc.W 15	dc.B $0D	dc.B '== White\H'	dc.W 16	dc.B $0D	dc.B '.'	ENDPcheckbox6 PROC EXPORT	dc.w	10	dc.l	6	dc.w	77,5+8,89,195+8	dc.l	$82000000	;checkbox	dc.w	0			;flag	dc.w	$3000		;moreFlags	dc.l	0			;refcon	dc.l	checkTitle	dc.w	0			;initial value	dc.l	0			;color table	dc.b	$53,$73,0,0,0,0	;key equiv = "S"checkTitle	str 'Smoother Mouse Cursor'	EndP	string PASCAL	; from here on, we need pascal stringsmonitorsList	PROC EXPORT	dc.l	monitor1	dc.l	monitor2	dc.l	monitor3	dc.l	monitor4	dc.l	monitor5	dc.l	checkbox6	dc.l	0	ENDPAbout1	PROC EXPORT	dc.w 8	dc.L 1	dc.w 38,5,138,280	dc.L $81000000	dc.w $0000	dc.w $1000	dc.L 0	dc.L TheText	dc.w EndText-TheText	string asisTheText;	dc.b 'The Monitor control panel allows you to change settings that affect ';	dc.b 'the monitor.  These include Color/Monochrome, the number of characters ';	dc.b 'to display on each line, the text, background, and border colors.  ';	dc.b 'The text and background colors only affect the ';	dc.b 'text screen in "classic" Apple II programs.'	dc.b 'The Monitor control panel lets you change your monitor settings.  '	dc.b 'The text and background colors affect only the text screen, not the '	dc.b 'desktop.'	dc.b 13,13	dc.b '“Smoother Mouse Cursor” is useful with a Video Overlay Card '	dc.b 'or an accelerator.'EndText	string pascal	ENDPmonitorAbout PROC EXPORT	dc.l	about1	dc.l	0	ENDP	END