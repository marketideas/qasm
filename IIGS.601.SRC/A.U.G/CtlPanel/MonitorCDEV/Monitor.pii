еееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееNOTE:  This file is no longer used!  Monitor.aii replaces it.  9-Sep-92 DALеееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее{$LongGlobals+}{$toolerrorchk-}{$A+}unit monitor;interfaceuses  QDIntf, GSIntf, misctools, Prodos16, ResMgr, CDEVMgr, NewInterface; function MONITOR_DEFPROC(message : Integer; data1, data2 : Longint) : Longint;procedure DisablePopupItem(ctlID : integer; item : integer);procedure EnablePopupItem(ctlID : integer; item : integer);implementationtype  wordPtr = ^integer;var  wind : windowPtr;  {$XRefVar+}  MonitorsList : integer;  MonitorAbout : integer;  {$XRefVar-}function MONITOR_DEFPROC(message : Integer; data1, data2 : Longint) : Longint;  var    tempCtl : ControlHandle;  begin { this will only get called when a ctl is hit}    MONITOR_DEFPROC := 0;	case message of	  CreateCDEV :	    begin		  tempCtl := NewControl2(WindowPtr(data1),3,ord4(@MonitorsList));		  wind := windowptr(data1);		end;	  InitCDEV :	    begin		  SetCtlValue(ReadBParam($18)+1,GetCtlHandleFromID(WindowPtr(data1),1)); 		  SetCtlValue(ReadBParam($19)+1,GetCtlHandleFromID(WindowPtr(data1),2));		  SetCtlValue(ReadBParam($1A)+1,GetCtlHandleFromID(WindowPtr(data1),3));		  SetCtlValue(ReadBParam($1B)+1,GetCtlHandleFromID(WindowPtr(data1),4));		  SetCtlValue(ReadBParam($1C)+1,GetCtlHandleFromID(WindowPtr(data1),5)); 		  DisablePopupItem(3, ReadBParam($1B)+1); {disable text item that is back item}		  DisablePopupItem(4, ReadBParam($1A)+1); {disable back item that is text item}		end;	  HitCDEV :	    case loword(data2) of		  1 : WriteBParam(GetCtlValue(ControlHandle(data1))-1, $18);		  2 : WriteBParam(GetCtlValue(ControlHandle(data1))-1, $19);		  3 : 		    begin			  EnablePopupItem(4, ReadBParam($1A)+1); {enable whatever was there}			  WriteBParam(GetCtlValue(ControlHandle(data1))-1, $1A);		  	  DisablePopupItem(4, ReadBParam($1A)+1); {disable back item that is text item}			end;		  4 :		    begin		  	  EnablePopupItem(3, ReadBParam($1B)+1); {enable what was there}			  WriteBParam(GetCtlValue(ControlHandle(data1))-1, $1B);		  	  DisablePopupItem(3, ReadBParam($1B)+1); {disable text item that is back item}			end;		  5 : WriteBParam(GetCtlValue(ControlHandle(data1))-1, $1C);		end;	  AboutCDEV :	    tempCtl := NewControl2(WindowPtr(data1),3,ord4(@MonitorAbout));	end;  end;procedure EnablePopupItem(ctlID : integer; item : integer);  var    mymenuBar : MenuBarHandle;  begin    mymenuBar := GetMenuBar;	SetMenuBar(MenuBarHandle(GetCtlHandleFromID(wind,ctlID)));	EnableMItem(item);	SetMenuBar(mymenuBar);  end;  procedure DisablePopupItem(ctlID : integer; item : integer);  var    mymenuBar : MenuBarHandle;  begin    mymenuBar := GetMenuBar;	SetMenuBar(MenuBarHandle(GetCtlHandleFromID(wind,ctlID)));	DisableMItem(item);	SetMenuBar(mymenuBar);  end;end.