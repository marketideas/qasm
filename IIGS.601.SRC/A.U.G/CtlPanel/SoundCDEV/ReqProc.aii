******************************************************************************************************************************* ReqProc.aii -- AcceptRequests procedure for Sound CDev* by David A. Lyons** Copyright 1991-92, Apple Computer, Inc.* All Rights Reserved******************************************************************************************************************************* REVISION HISTORY** 24-Jun-91 DAL*   Borrowed skeleton from Noises init (by DAL).** 21-Oct-91 DAL*   Start putting some real guts in here.  To set the sound*   configuration handle, we now accept srqConfigSounds.** 28..29-Oct-91 DAL*   Got this thing working for real.** 30-Oct-91 DAL (version 2.0b10)*   In the SoundCPStdBeep routine (chained into BELLVECTOR),*   if I can't handle the request I now chain to the old routine,*   rather than RTLing with the carry set.** 4-Nov-91 DAL*   Accepts new request $8003, srqMakeStdBeep, which tries to*   make the standard beep even if the system beep is remapped.** 6-Nov-91 DAL*   Add support for asynchronous sounds.*   Accept srqHelloWorld for patching Sound tools, etc.** 7-Nov-91 DAL*   Calls SetDefaultTPT after patching Sound tools.** 9-Nov-91 DAL*   Make direct-page space high in bank 0, not low (just*   for kicks).** 19-Nov-91 DAL*   FindSoundHandle returns SEC if handle is NIL.*   Implemented srqGetrSoundSample (loads sounds from disk*     as needed, when possible).*   Forces sounds to be unlocked and not-purgeable when loaded.** 21-Nov-91 DAL (2.0b14 for 6.0d59)*   Loading a sound on the fly is now case-insensitive like it*     was supposed to be (was mistakenly passing original name*     through to RMFindNamedResource instead of using the one we*     carefully stored in soundsHandle).** 24-Jan-92 DAL (2.0b15 for 6.0d65)*   When we play a sound handle, we now call SendRequest with*     code srqPlayrSoundSample.  This way if we can't play the*     sound (because the Sound Tools are in use, for example),*     then maybe somebody else can play it for us.*   Visual indication of sounds now applies to certain SysBeep2*     codes as well as System Beep.  It applies to codes 0..$F,*     $30, $33, $50..$59, $0Exx, and $0Fxx (reserved).** 25-Jan-92 DAL (2.0b16 for 6.0d66)*   No visual indication of sounds assigned to silence.*   Visual indication of SysBeep even if it's reassigned to a*     sampled sound.*   Visual indication comes after sound is started, not before,*     and it's done locally (not through volume=0, SysBeep).** 27-Jan-92 DAL (still for d66)*   If a SysBeep or SysBeep2 happens while the stack is in the*     $01xx page, we are running out of space & going ka-boom.*     So now I preserve the stack while handling request $0006,*     srqPlayrSoundSample.***************************************************************** 2-Apr-92 DAL for 6.1d3** Fixed chopped-off Restart sound (WaitForSoundToFinish was* assuming the bank register was set).** 7-Jul-92 DAL (2.1d6 for 6.0.1d6)** Added srqConvertRelPitch ($8200).  dataIn low = relPitch,* dataOut +002 = frequency value for FFStartSound.** Made srqHelloWorld not do any damage on a redundant call.*****************************************************************************************************************************DebugSymbols	equ 0	include 'all.macros'	include 'e16.locator'	include 'e16.resources'srqSetSoundGlobals	equ $8000	;set data from dataInsrqGetSoundGlobals	equ $8001	;return info at dataInsrqMakeStdBeep	equ $8003	;play a standard beepsrqHelloWorld	equ $8100	;initialize selfsrqConvertRelPitch	equ $8200	;convert relPitch to FFStartSound freq (6.0.1);---------------------------------------------------------------------;; configHandle;; configHandle records mappings for all the sounds in the;   user's active set;; The format is exactly like an rTaggedStrings resource, mapping; from events into strings.;; +000: Count; +002: TagWord1; +004: PString1; +xxx: TagWord2; +yyy: PString2; +zzz: ...;; The strings are the names of Sound resources.; There are a few special strings:;   "0" = silence;   "*" = standard beep;;---------------------------------------------------------------------;; data structure for soundsHandle;; soundHandle records mappings for all the sounds appearing;   in the Sound pop-up;; IMPORTANT!  The soundsHandle is locked while the Sound pop-up menu;             exists.  The menu items are pointers into this handle.;;---------------------------------------------------------------------oVersion	equ 0	;zerooEntryOffset	equ 2	;offset to the entry listoEntryCount	equ 4	;number of entries followingHEADERSIZE	equ 6;; Each entry:;oNextEntry	equ 0	;offset to next entry (from here)oNameHash	equ 2	;quick check against nameoMenuItem	equ 4	;menu item number in Sounds pop-upoPathOffset	equ 6	;offset from entry to pathname (WString) (or zero)oNameOffset	equ 8	;offset from entry to resname (PString) (or zero)oSoundData	equ 10	;long sound data (for ex, handle to sound sample)ENTRYSIZE	equ 14	;(not including strings!);; Values for Binding field (these match the menu item; numbers for the first 3 items in the Sound pop-up).;itemNotAssigned	equ 1itemSilence	equ 2itemStandardBeep	equ 3CLOCKCTL	equ $C034	; DFB 0 ;Clock control registerVERTCNT	EQU $C02E	; DFB 0 ;Addr for read of video cntr bits V5-VB****************************************************************************************************************************** SoundCPReqProc** Plays user-selected sounds in reponse to systemSaysSound,* and responds to a few other request codes.***************************************************************SoundCPPermCode	proc export	;DON'T NAME THIS PROC!	brl SoundCPReqProc	;+0	brl SoundCPStdBeep	;+3SoundCPReqProc	nameoldDPage	equ 1RTL1	equ 3DataOut	equ 6DataIn	equ 10Request	equ 14Result	equ 16	phd	tsc	tcd	phb	phk	plb	lda @requestTable	pha	;preserve for interrupt	lda <Request	sta @requestTable	ldx #@procTable-@requestTable@search	dex	dex	cmp @requestTable,x	bne @search	lda <dataIn+2	ldy <dataIn	jsr (@procTable,x)	;return with SEC to handle	pla	sta @requestTable	;restore (in case we were an interrupt)@done	ror <Result	plb	pld	lda 2,s	sta 12,s	lda 1,s	sta 11,s	ply	ply	ply	ply	ply	rtl@requestTable	dc.w $0000	dc.w srqHelloWorld	dc.w srqMakeStdBeep	dc.w srqPlayrSoundSample	dc.w srqSetSoundGlobals	dc.w srqGetSoundGlobals	dc.w srqSynchronize	dc.w srqConvertRelPitch	;added 7-Jul-92 DAL	dc.w srqGetrSoundSample	dc.w systemSaysBeep** Procedures receive dataIn in AY, return SEC to accept a request.*@procTable	dc.w @ignore	dc.w helloWorld	dc.w makeStdBeep	dc.w doSrqPlayrSoundSample	dc.w setGlobals	dc.w getGlobals	dc.w WaitForSoundToFinish	dc.w convertRelPitch	;added 7-Jul-92 DAL	dc.w getSoundHandle	dc.w handleSound@ignore	clc	rts**************************************************************** helloWorld -- gets called right after we are installed***************************************************************helloWorld	name*** added 7-Jul-92 DAL in case some bozo calls us again	lda oops	bne @doNothing	inc oops*** end 7-Jul-92	jsr InstallSoundNP	jsr PatchSoundTools@doNothing	sec	;accept request	rtsoops	dc.w 0	;added 7-Jul-92**************************************************************** makeStdBeep -- do our best to play the standard beep, the*                one we control the pitch of.***************************************************************makeStdBeep	name	lda #1	sta StandardBeepKludge  ;prevent remapping	_SysBeep	stz StandardBeepKludge	sec	;accept request	rts**************************************************************** SoundCPStdBeep** The $E1006C system beep vector (BELLVECTOR) comes here.** Input:*   8-bit native mode** Output:*   8-bit native mode*   X preserved*   Y=0*   carry clear if we handled the beep***************************************************************SoundCPStdBeep	name	rep #$30	phb	phk	plb	phx	jsr doStdBeep	;returns CLC = handled	plx	plb	ldy #0	sep #$30	bcc @handled	brl ChainBellVector@handled	rtldoStdBeep	name	lda StandardBeepKludge	bne @reject	phd	ldx #0	phx	;space for result	pea $0001	;systemSaysBeep	phx	;high word of dataIn (zero)	pea $FFFE	;low word of dataIn	phx	phx	;dataOut	jsl SoundCPReqProc	pla	pld	eor #$8000	asl a	;clc if accepted	rts@reject	sec	rtsStandardBeepKludge	dc.w 0	;avoid beeping for a remapped event!**************************************************************** handleSound** Try playing a sound for the sound in <dataIn.*   Bit 31 = don't actually play anything.** Return with SEC to accept the request.** Input:  AY = dataIn***************************************************************handleSound	name;;;	tya;;;	sta localDataIn	sta localDataIn+2	sty localDataIn	jsr PreserveTheStack	lda localDataIn	;sound number	jsr FindSoundHandle	;get sound handle in AY (returns $FFFFFFFF if SEC!)	sta handleToPlay+2	sty handleToPlay	bcs @noSoundToPlay;;;	bcs @unableToPlay*** Note:  AY= 1 for silence, 2 for SysBeep;;;	ldx <dataIn+2	ldx localDataIn+2	bmi @dontPlay	;bit 31 = just testing!;	jsr PlaySoundHandle	;sound handle still in AY;	bcs @unableToPlay*** added 24-Jan-92 DAL -- use SendRequest to play the sound handle	ldx #0	pea srqPlayrSoundSample	pea $8000	;stop after one, send to all	phx	phx	;target = nil	pha	phy	;dataIn = handle	phx	phx	;dataOut = nil	_SendRequest;;;	bcs @playFailed*** end 24-Jan-92@noSoundToPlay	php	;sec = reject event, clc=accept*** Blinking the border and then rejecting the event leads to weirdness	bcs @noVisIndication****** added 24-Jan-92 DAL -- give visual indication of certain sounds*** If bit 0 of BRAM $5E = 0, user wants visual indication of sounds	lda >$e102c0+$5e	;peek at BRAM location $5E	lsr a	bcs @noVisIndication*** Blink border for sounds 0..$F, $30, $33, $50..59, $0Exx, $0Fxx, maybe $FFFE;;;	lda <dataIn	lda localDataIn	cmp #$fffe	;SysBeep!	beq @doVisibleSysBeep	cmp #$F+1	bcc @doVisible	cmp #$30	beq @doVisible	cmp #$33	beq @doVisible	cmp #$50	bcc @noVisIndication	cmp #$59+1	bcc @doVisible	and #$ff00	cmp #$0e00	beq @doVisible	cmp #$0f00	beq @doVisible	bra @noVisIndication@doVisibleSysBeep@doVisible*** skip visual indication if we're mapping to silence or SysBeep*** (If sound was not assigned through us, handleToPlay will be $ffffffff & we'll blink the border)	lda handleToPlay+2	;saved sound handle $0000xxxx = special	beq @noVisIndication	jsr BlinkTheBorder@noVisIndication	plp	bcs @unableToPlay@dontPlay	sec	;accept request	bra @exit;;;@playFailed@unableToPlay	clc	;reject request@exit	jsr RestoreTheStack	;preserves carry	rtslocalDataIn	dc.l 0handleToPlay	dc.l 0*************************************************************************** BlinkTheBorder -- give visual indication of a sound** (Stolen from Patch2:Misc.tools.asm, VolumeIsZero)**************************************************************************BlinkTheBorder	name	sep #$30	longa off	longi off	phb	; save dbr	pea $E0E0	plb	plb	lda |ClockCtl	and #$0F	pha	; save original border	jsr WaitForVBL	lda #$0F	; force white	tsb |ClockCtl	jsr Wait	jsr WaitForVBL	lda #$0F	; force black	trb |ClockCtl	jsr Wait	jsr WaitForVBL	lda #$0F	; force white	tsb |ClockCtl	jsr Wait	jsr WaitForVBL	lda #$0F	; force black	trb |ClockCtl	jsr Wait	plx	; get restore color	in x	php	; save interrupt status	sei	; ints off	lda #$0F	; force black	trb |ClockCtl	txa	tsb |ClockCtl	; restore orig	plp	; restore ints	plb	; restore dbr	rep #$30	rts	longa on	longi on;-------------------------------------------------;; WaitForVBL;; Called in 8-bit mode with data bank set to $E0; Trashes a-reg;;; The counter assumes 18 cycles per loop; 2.8 million cycles per second; 60 vbls a second;; 2800000/60/18 Å 2600;; (Add 200 more for good luck);WaitForVBL	rep #%00010000	longi on	longa off	ldx #2800	; no more than 2800 times through loop@wait	lda |VERTCNT	and #$7F	asl a	cmp #220	bcs @done	dex	bne @wait@done	sep #%00010000	longi off	rts;-------------------------------------------------;; Wait;; Little routine called in mixed native	mode to; call the wait routine.;; Inputs:  none; Outputs: none; All registers trashed.;; Can be called with m or x in any state.  m & x are; preserved.;*** Does not to use FWEntry (I'm paranoid about stack space)Wait	php	rep #$30	longa on	longi on	phb	pea $e0e0	plb	plb	ldy $c036	;preserve old speed value in Y	lda #$80	trb $c036	;slow speed	lda #$c0	;delay factor	sec@2	pha@1	sbc #1	bne @1	pla	sbc #1	bne @2	sty $c036	plb	plp	rts*************************************************************************** FindSoundHandle** Input:  A = sound number** Output: SEC: did not find sound, AY = $FFFFFFFF*         CLC: AY = sound handle**************************************************************************FindSoundHandle	name	ldx configHandle+1	beq @nope; use configHandle to map from event (in A) to name in resNameBuffer	jsr MapEventToName	lda resNameBuffer	and #$00ff	beq @notAssigned	lda resNameBuffer	cmp #$3001	;"0" = silence	bne @notSilence	lda #0	ldy #1	;$00000001 = silence	clc	rts@notSilence	cmp #$2a01	;"*" = standard beep	bne @notStdBeep	lda #0	ldy #2	;$00000002 = standard beep	clc	rts@notStdBeep; search through configHandle for an appropriate sound handle	jsr FindNamedEntry	;out=AX pointing to entry	phd	pha	phx	tsc	tcd*** 19-Nov-91 DAL	ldy #oSoundData+1	lda [1],y	sec	beq @noHandle*** end 19-Nov-91	ldy #oSoundData	lda [1],y	tax	iny	iny	lda [1],y	clc@noHandle	ply	ply	pld	txy;;;	clc	rts; sound handle in AY@notAssigned@nope	sec*** added 27-Jan-92 DAL	lda #-1	tay*** end 27-Jan-92	rts*************************************************************************** srqPlayrSoundSample -- play sound handle from dataIn** Input: AY = dataIn (sound handle, or $0000xxxx for special things)** Output: SEC if we handled the request**************************************************************************doSrqPlayrSoundSample name	jsr PlaySoundHandle	;AY already have dataIn	bcs @fail	sec	;accept request	rts@fail	clc	;reject request	rts;;; Damn, the stack is *already* overflown when we get here!;*** 27-Jan-92 DAL -- rewritten to preserve page-one stack if needed;doSrqPlayrSoundSample name;	sta handleToPlay+2;	sty handleToPlay;;	jsr PreserveTheStack  ;does not preserve registers!;	lda handleToPlay+2;	ldy handleToPlay;	jsr PlaySoundHandle	;AY contain dataIn;	jsr RestoreTheStack;	bcs @reject;;@accept	sec	;accept request;	rts;;@reject	clc	;reject request;	rts;;handleToPlay	dc.l 0** PreserveTheStack*PreserveTheStack	stz theOldStackPtr	;anticipate no stack fiddling	tsc	and #$ff00	xba	dec a	bne @notPageOne	ldx #$fe@keepStack	lda >$000100,x	sta stackImage,x	dex	dex	bpl @keepStack	tsc	inc a	inc a	sta theOldStackPtr	plx	lda #$01ff	tcs	phx@notPageOne	rts** RestoreTheStack -- preserves the Carry!*RestoreTheStack	lda theOldStackPtr	beq @noFutzing	ply	;rts address	php	php	pla	sta pRegister	sei	;preserve and disable interrupts & Carry flag	ldx #$fe@restoreStack	lda stackImage,x	sta >$000100,x	dex	dex	bpl @restoreStack	lda theOldStackPtr	tcs	lda pRegister	pha	plp	plp	;restore interrupt status and Carry flag	phy	;rts address@noFutzing	rtstheOldStackPtr	dc.w 0	;zero means we didn't preserve the stackstackImage	ds.b 256pRegister	dc.w 0*** end 27-Jan-92*************************************************************************** PlaySoundHandle** Input:  Handle to rSoundSample in AY* Special cases:*    $00000001 = silence*    $00000002 = standard beep** Output:  CLC if we played it**************************************************************************;; Format of an rSoundSample resource (handle);oFormat	equ 0oWaveSize	equ 2oRelPitch	equ 4oStereo	equ 6oSampleRate	equ 8oSound	equ 10PlaySoundHandle	name	import RelPitchAtoFreq	tax	bne @notSpecial;; Special case $00000001 = silence;	cpy #1	bne @notSilence	clc	rts;; Special case $00000002 = standard beep;@notSilence	cpy #2	bne @notSpecial	inc StandardBeepKludge	_SysBeep	stz StandardBeepKludge	clc	rts@notSpecial	phd	pha	phy	pha	phy	tsc	tcd@handle	equ 1@ptr	equ 5	jsr StealSoundTools	bcc @ok	brl @exit	;return sec = fail@ok*** lock & dereference handle and set	lda <@handle+2	ldy <@handle	sta activeSoundHandle+2	sty activeSoundHandle	ldy #4	lda [<@handle],y	sta oldAttributes	ora #$8000	sta [<@handle],y	dey	dey	lda [<@handle],y	sta <@ptr+2	tax	lda [<@handle]	sta <@ptr	clc	adc #oSound	;offset to sound data	bcc @1	inx@1	stx ffSoundPtr+2	sta ffSoundPtr*** resource Format must be zero	sec	lda [<@ptr]	;sound Format must be 0	bne @stopAndExit*** set up wave size	ldy #oWaveSize	lda [<@ptr],y	sta ffWaveSize*** set up the pitch	ldy #oRelPitch	lda [<@ptr],y;;;	bmi @relSubtract;;;;;;	clc;;;	adc #$3C00	;middle C (semitone 60);;;	bra @getPitch;;;;;;@relSubtract	and #$7FFF;;;	eor #$FFFF;;;	inc a	;negate;;;	adc #$3C00	;middle C minus relPitch;;;;;;@getPitch	jsr PitchToFreq*** 7-Jul-92 DAL -- Made into subroutine for new request handler	jsr RelPitchAtoFreq*** end 7-Jul-92	sta ffFreq*** start the sound	ldy #oStereo	;low nibble = channel number	lda [<@ptr],y	and #$000f	xba	asl a	asl a	asl a	asl a	ora #$0201	;Generator 2, FFSynth	pha	pushlong #ffSoundBlock	_FFStartSound	bcs @stopAndExit;;;*** wait until the sound is done playing;;;@wait	pha;;;	pea $0002	;generator 2;;;	_FFSoundDoneStatus;;;	pla;;;	beq @wait;;;;;;*** free up the generator;;;	pea $0004;;;	_FFStopSound	clc	bra @exit@stopAndExit	php	jsr RelinquishSoundTools*** restore handle state	ldy #4	lda oldAttributes	sta [<@handle],y	plp	bra @exit@exit	ply	;clc = played soiund	ply	ply	ply	pld	rtsactiveSoundHandle	dc.l 0	;handle to the sound we're playingoldAttributes	dc.w 0	;old state of sound-sample handleffSoundBlockffSoundPtr	dc.l 0ffWaveSize	dc.w 0	;in pagesffFreq	dc.w 0	;frequency	dc.w $8000	;address in sound RAM	dc.w $0006	;use 16K DOC buffer	dc.l 0	;next wave (none)	dc.w $00FF	;maximum volume**************************************************************** StealSoundTools***************************************************************StealSoundTools	name	lda StoleSoundTools	beq @continue	jsr RelinquishSoundTools@continue	pea 0	_SoundToolStatus	pla	bne @fail	;somebody else using Sound tools	pha	pha	pushlong #$0100	;size = 1 page	pha	_MMStartUp	;my id	pea $8015	;dp attributes	ldx #0	phx	phx	;zero (bank)	_NewHandle	plx	ply	bcs @fail	sty dpSoundHandle+2	stx dpSoundHandle	phy	phx	phd	tsc	tcd	lda [3]	pha	_SoundStartUp	pld	plx	ply	inc StoleSoundTools	clc	rts@fail	sec	rts;StopSoundTools	name;	_SoundShutDown;	pushlong dpSoundHandle;	_DisposeHandle;	stz dpSoundHandle+1;	rtsdpSoundHandle	dc.l 0stoleSoundTools	dc.w 0**************************************************************** WaitForSoundToFinish** If interrupts are enabled, just wait until our sound* is done playing.** BANK REGISTER IS NOT NECESSARILY SET!  --  2-Apr-92 DAL***************************************************************WaitForSoundToFinish name	php	php	pla	and #$0004	;I bit	bne @dontWait@busyWaiting	lda >StoleSoundTools   ;long addressing! (2-Apr-92 DAL)	beq @dontWait	pha	pea $0002	;generator 2	_FFSoundDoneStatus	pla	beq @busyWaiting@dontWait	sec	;accept request	rts**************************************************************** RelinquishSoundTools** Stop playing my sound, shut down sound tools, dispose of* direct-page space, and clear the StoleSoundTools flag.***************************************************************RelinquishSoundTools name	lda >StoleSoundTools	beq @done	phb	phk	plb	pea $0004	;generator 2	_FFStopSound; unlock the previously-playing sound	lda activeSoundHandle+1	beq @noSound	phd	pushlong activeSoundHandle	tsc	tcd	ldy #4	lda [1],y	asl a	lsr a	sta [1],y	ply	ply	pld	stz activeSoundHandle+1@noSound	_SoundShutDown	pushlong dpSoundHandle	_DisposeHandle	stz dpSoundHandle+1	stz StoleSoundTools	plb@done	rts****************************************************************************************************************************** PatchSoundTools***************************************************************PatchSoundTools	name	pha	pha	pea 0	pea 8	_GetTSPtr	phd	tsc	tcd	lda [3]	sta mySoundPatch	pld	ply	ply	pha	pha	pea 0	;system tool	pea $0608	;SoundToolStatus	_GetFuncPtr	pla	inc a	sta oldSoundStatus+1	pla	sep #$20	sta oldSoundStatus+3	rep #$20	pha	pha	pea 0	;system tool	pea $0208	;SoundStartUp	_GetFuncPtr	pla	inc a	sta oldSoundStartUp+1	pla	sep #$20	sta oldSoundStartUp+3	rep #$20	pea $0000	;system tool	pea $0008	;Sound	pushlong #mySoundPatch	_SetTSPtr	_SetDefaultTPT	;added 7-Nov-91 DAL	rtsmySoundPatch	dc.l 0	;function count (filled in)	dc.l sBootInit-1	;$0108 SoundBootInit	dc.l sStartUp-1	;$0208 SoundStartUp	dc.l 0	;$0308 SoundShutDown	dc.l 0	;$0408 SoundVersion	dc.l 0	;$0508 SoundReset	dc.l sStatus-1	;$0608 SoundToolStatus	dc.l 0	;$0708	dc.l 0	;$0808	dc.l 0	;$0908 WriteRamBlock	dc.l 0	;$0A08 ReadRamBlock	dc.l 0	;$0B08 GetTableAddress	dc.l 0	;$0C08 GetSoundVolume	dc.l 0	;$0D08 SetSoundVolume	dc.l 0	;$0E08 FFStartSound	dc.l 0	;$0F08 FFStopSound	dc.l 0	;$1008 FFSoundStatus	dc.l 0	;$1108 FFGeneratorStatus	dc.l 0	;$1208 SetSoundMIRQV	dc.l 0	;$1308 SetUserSoundIRQV	dc.l 0	;$1408 FFSoundDoneStatus	dc.l 0	;$1508 FFSetUpSound	dc.l 0	;$1608 FFStartPlaying	dc.l 0	;$1708 SetDocReg	dc.l 0	;$1808 ReadDocReg	dc.l 0	;$1908 expansion	dc.l 0	;$1A08 expansion	dc.l 0	;$1B08 expansion	dc.l 0	;$1C08 expansion	dc.l 0	;$1D08 expansion	dc.l 0	;$1E08 expansion	dc.l 0	;$1F08 expansion	dc.l 0	;$2008 expansion	dc.l 0	;$2108 expansion	dc.l 0	;$2208 expansion**************************************************************** SoundToolStatus patch -- If I have stolen the sound tools,*                          return FALSE.***************************************************************sStatus	pha	lda >StoleSoundTools	beq @old	pla	lda #0	sta 7,s	;return status = false	clc	rtl@old	plaoldSoundStatus	jml >$777777**************************************************************** SoundBootInit patch -- do nothing***************************************************************sBootInit	lda #0	clc	rtl**************************************************************** SoundStartUp patch -- give up the sound tools and pass*                       control to the real startup function.***************************************************************sStartUp	pha	phx	phy	jsr RelinquishSoundTools	ply	plx	plaoldSoundStartUp	jml >$777777****************************************************************************************************************************** Install notify proc -- give up sound tools on switch to P8***************************************************************InstallSoundNP	name	pushlong #notifyParms	pea $2034	;AddNotifyProc	jsl $e100b0	rtsnotifyParms	dc.w 1	dc.l myNotifyProcmyNotifyProc	dc.l 0	;link (reserved)	dc.w 0	;reserved	dc.w $a55a	;signature	dc.l $00000022	;event flags (shutdown, switch to P8)	dc.l 0	;event codeSoundCPNotifyProc	name	jsr WaitForSoundToFinish	jsr RelinquishSoundTools	rtl**************************************************************************************************************************************************** convertRelPitch -- handle an srqConvertRelPitch request (new for 6.0.1)*** Input: AY = dataIn value (Y = relPitch value)** Output:  sec to accept the request*          dataOut:*            +000: recvCount*            +002: frequency for FFStartSound**************************************************************************convertRelPitch	name	import RelPitchAtoFreq	tya	jsr RelPitchAtoFreq	ldy #2	sta [<dataOut],y	sec	rts**************************************************************************************************************************************************** getSoundHandle -- handle an srqGetrSoundSample request** Input:  AY = dataIn (pointer to PString sound name, case insensitive)** Output:  clc to reject request*          sec to accept (must fill in dataOut handle and flags)** dataOut:*   +000: recvCount*   +002: sound handle*   +006: flags (bit 15 = caller should dispose handle)**************************************************************************getSoundHandle	name	pei <dataIn+2	pei <dataIn	pushlong #resNameBuffer	lda [<dataIn]	and #$00ff	inc a	pea 0	pha	_BlockMove	jsr FindNamedEntry	;out=AX pointing to entry	bcs @reject	phd	pha	phx	tsc	tcd	ldy #oSoundData	lda [1],y	tax	iny	iny	lda [1],y	ply	ply	pld	;handle in AX	tay	bne @ok	txy	bne @ok*** Try to load the sound from disk	jsr LoadSoundFromDisk  ;return AX = sound handle, Y=result flags	bcs @reject	phy	jsr StuffHandleAX	pla	;result flags	ldy #6	sta [<dataOut],y	sec	;accept request	rts@ok	jsr StuffHandleAX	lda #0	ldy #6	sta [<dataOut],y	;caller should not dispose	sec	;accept request	rts@reject	clc	;reject request	rtsStuffHandleAX	ldy #4	sta [<dataOut],y	dey	dey	txa	sta [<dataOut],y	rts*************************************************************************** LoadSoundFromDisk** Input:  Pascal string sound name in resNameBuffer** Output: SEC = failed to load sound*         CLC = loaded sound from disk*               AX = rSoundSample handle*               Y = result flags*                   $0000=we're keeping the sound (we needed it)*                   $8000=caller should eventually dispose of handle**************************************************************************LoadSoundFromDisk	name	stz @sHandle+1	phd	jsr FindNamedEntry  ;this will succeed	pha	phx	pushlong soundsHandle	tsc	tcd@soundsHandleCopy	equ 1@entry	equ @soundsHandleCopy+4	ldy #4	;force soundsHandle locked	lda [<@soundsHandleCopy],y	pha	ora #$8000	sta [<@soundsHandleCopy],y	pha	_GetCurResourceApp	pha	_MMStartUp	_ResourceStartUp	pha	;space for result	pea $0001	;request access = read	pea 0	pea 0	;map address = NIL	ldy #oPathOffset	lda [<@entry],y	clc	adc @entry	tax	lda <@entry+2	adc #0	pha	phx	_OpenResourceFile	pla	bcs @failOpen	pha	;keep ref num on stack	pha	pha	;space for result	pea rSoundSample;;;	pushlong #resNameBuffer*** added 21-Nov-91 DAL -- use recorded name (with correct case!)	ldy #oNameOffset	lda [<@entry],y	clc	adc @entry	tax	lda <@entry+2	adc #0	pha	phx*** end 21-Nov-91	pushlong #theFileNumber	_RMFindNamedResource	plx	pla	bcs @failFind	sta @id+2	stx @id	pha	pha	;space for LoadResource	pea rSoundSample	pha	phx	;resource ID	_LoadResource	plx	pla	bcs @failLoad	sta @sHandle+2	;this flags it as successful!	stx @sHandle	pea 0	;purge level	pha	phx	;handle for SetPurge	pha	phx	;handle for HUnlock	_HUnlock	_SetPurge	pea rSoundSample	lda @id+2	pha	lda @id	pha	_DetachResource@failFind@failLoad	_CloseResourceFile@failOpen	_ResourceShutDown	_SetCurResourceApp*** set up sFlags, and store the handle in soundsHandle if needed	jsr DoWeNeedThisSound  ;SEC=not needed, caller should dispose	lda #0	ror a	sta @sFlags	bmi @noStore	ldy #oSoundData	lda @sHandle	sta [<@entry],y	iny	iny	lda @sHandle+2	sta [<@entry],y@noStore	pla	;restore locked state of soundsHandle	ldy #4	sta [<@soundsHandleCopy],y	ply	ply	;pulled soundsHandleCopy	ply	ply	;pulled entry	pld	sec	lda @sHandle+1	beq @bye	ldy @sFlags	lda @sHandle+2	ldx @sHandle	clc@bye	rts@sHandle	dc.l 0@sFlags	dc.w 0@id	dc.l 0theFileNumber	dc.w 0	;ignored*************************************************************************** MapEventToName** Input:  A = event** Output: resNameBuffer**************************************************************************MapEventToName	name	sta @target	stz resNameBuffer	;null string (not assigned)	phd	pushlong configHandle	tsc	tcd@temp	equ 1	ldy #2	lda [<@temp]	tax	lda [<@temp],y	sta <@temp+2	stx <@temp	lda [<@temp]	;number of mappings	beq @done	tax	lda #2	jsr @bumpTemp@tryOneMapping	lda [<@temp]	cmp @target	bne @next	lda #2	jsr @bumpTemp	pei <@temp+2	pei <@temp	pushlong #resNameBuffer	pea 0	lda [<@temp]	and #$00ff	inc a	pha	_BlockMove	bra @done@next	ldy #2	lda [@temp],y	and #$00ff	inc a	inc a	inc a	jsr @bumpTemp	dex	bne @tryOneMapping@done	ply	ply	pld	rts@bumpTemp	clc	adc <@temp	sta <@temp	bcc @ok	inc <@temp+2@ok	rts@target	dc.w 0*************************************************************************** FindNamedEntry** Input: resNameBuffer (pstring), soundsHandle** Output: CLC, AX = pointer to entry*         SEC = not found** Need to simulate entries for Silence, Standard Beep, Not Assigned.**************************************************************************FindNamedEntry	name	jsr ComputeNameHash	lda resNameBuffer	cmp #$2A01	;"*"	bne @notStdBeep	lda #^fakeStdBeep	ldx #fakeStdBeep	clc	rts@notStdBeep	cmp #$3001	;"0"	bne @notSilence	lda #^fakeSilence	ldx #fakeSilence	clc	rts@notSilence	phd	pushlong soundsHandle	tsc	tcd@ptr	equ 1	ldy #2	lda [<@ptr]	tax	lda [<@ptr],y	sta <@ptr+2	stx <@ptr	ldy #oEntryCount	lda [<@ptr],y	sta @count	beq @fail	ldy #oEntryOffset	lda [<@ptr],y	jsr @bumpPtr@checkOneEntry	jsr @CompareName	;returns CLC if equal	lda <@ptr+2	ldx <@ptr	bcc @found	lda [<@ptr]	jsr @bumpPtr	dec @count	bne @checkOneEntry	lda #^fakeNotAssigned	ldx #fakeNotAssigned@fail	sec@found	ply	ply	pld	rts@count	dc.w 0@bumpPtr	clc	adc <@ptr	sta <@ptr	bcc @nr	inc <@ptr+2@nr	rts** CompareName -- return CLC if resNameBuffer matches @ptr entry*@CompareName	ldy #oNameHash	lda [<@ptr],y	cmp resNameHash	sec	;no match	bne @exit	pushlong #resNameBuffer	clc	ldy #oNameOffset	lda [<@ptr],y	adc <@ptr	tax	lda <@ptr+2	adc #0	pha	phx	jsr ComparePStrings@exit	rts	;return clc=match, sec=notComparePStrings	phd	tsc	tcd@one	equ 5@two	equ @one+4	sep #$30	longa off	longi off	lda [@one]	tay	cmp [@two]	bne @noMatch@nextChar	lda [@one],y	jsr upcase	sta @cheat+1	lda [@two],y	jsr upcase@cheat	cmp #$77	;self-modified	bne @noMatch	dey	bne @nextChar	clc	bra @exit@noMatch	sec@exit	rep #$30	longa on	longi on	pld	plx	;rts addr	ply	ply	ply	ply	phx	;rts addr	rts	longa offupcase	cmp #'a'	bcc @up	cmp #'z'+1	bcs @up	and #$df@up	rts	longa onfakeNotAssigned	dc.w 0,0,itemNotAssigned,0,0,0,0fakeSilence	dc.w 0,0,itemSilence,0,0,0,0fakeStdBeep	dc.w 0,0,itemStandardBeep,0,0,0,0*************************************************************************** ComputeNameHash** Input:  pstring in resNameBuffer** Output: A, resNameHash**************************************************************************ComputeNameHash	name;@@@ (later)	lda #$BEEF	sta resNameHash	rts*************************************************************************** DoWeNeedThisSound** Input:  resNameBuffer (sound name, PString)** Output: SEC if we don't need this sound*         CLC if we need this sound** The sounds we need are the ones in configHandle (any sound currently* bound to any event).*;---------------------------------------------------------------------;; configHandle;; configHandle records mappings for all the sounds in the;   user's active set;; The format is exactly like an rTaggedStrings resource, mapping; from events into strings.;; +000: Count; +002: TagWord1; +004: PString1; +xxx: TagWord2; +yyy: PString2; +zzz: ...;*************************************************************************DoWeNeedThisSound	name	phd	pushlong configHandle	tsc	tcd@temp	equ 1	ldy #2	lda [<@temp]	tax	lda [<@temp],y	sta <@temp+2	stx <@temp	lda [<@temp]	sta @count	beq @notNeeded	lda #4	jsr @bumpTemp@check1	pushlong #resNameBuffer	pei <@temp+2	pei <@temp	jsr ComparePStrings	bcc @exit	;equal!	lda [<@temp]	and #$00ff	inc a	inc a	inc a	jsr @bumpTemp	dec @count	bne @check1@notNeeded	sec@exit	ply	ply	pld	rts@bumpTemp	clc	adc <@temp	sta <@temp	bcc @1	inc <@temp+2@1	rts@count	dc.w 0**************************************************************************************************************************************************** setGlobals** Set the global sound configuration handle from dataIn.* Always accept the request.** Input:  AY = dataIn.**************************************************************************setGlobals	name	pha	phy	pushlong #GLOBALS	bra commonGlobals**************************************************************************************************************************************************** getGlobals** Set the global sound configuration handle from dataIn.* Always accept the request.** Input:  AY = dataIn.**************************************************************************getGlobals	name	pushlong #GLOBALS	pha	phycommonGlobals	pushlong #ENDGLOBALS-GLOBALS	_BlockMove	sec	;accept request	rts*************************************************************************** Globals**************************************************************************GLOBALSconfigHandle	dc.l 0soundsHandle	dc.l 0myProcMemID	dc.w 0ChainBellVector	jml >$777777	;JML to old BELLVECTORENDGLOBALS*************************************************************************resNameBuffer	ds.b 256resNameHash	dc.w 0	EndP****************************************************************** RelPitchAtoFreq** Input:*   relPitch value in A** Output:*   FFStartSound frequenty value in A*****************************************************************RelPitchAtoFreq	procname export	tay	bmi @relSubtract	clc	adc #$3C00	;middle C (semitone 60)	bra @getPitch@relSubtract	and #$7FFF	eor #$FFFF	inc a	;negate	adc #$3C00	;middle C minus relPitch@getPitch	;;; fall into PitchToFreq****************************************************************** PitchToFreq** Inputs:	Pitch word in A, full native mode** Outputs:	Freq word in A** Uses:	x and y*** (Stolen from HyperCard IIgs 1.1, 23-Oct-91 DAL)*****************************************************************	export PitchToFreqPitchToFreq	nameoctave	equ 12*256Adjust	equ  $07C8	; 3 half steps, 41/128th step (Mark 341)	clc	adc #Adjust	ldy #11	; maximum octave count	sec	sbc #octave	bmi hitbottomploop	dey 	; keep subtracting octaves to	sbc #octave	; find out how many	bpl ploophitbottom	adc #octave	; went too far; back up. (carry was ok)* now the octave count is in y and the remainder is in a	phy	and #$FFFE	tay	lda freqtable,y	; lookup in top octave table* now we have the right pitch, but the wrong octave, in a	ply	dey	bmi Pdoneshift	lsr A	; divide by two for each octave down	dey	bpl shiftPdone	rts* the frequency table* for a doc clock of 892337.5* middle c is 261.625565 Hzfreqtable	DC.W 20905,20914,20924,20933,20943,20952,20962,20971	;0	DC.W 20981,20990,21000,21009,21018,21028,21037,21047	DC.W 21056,21066,21075,21085,21094,21104,21114,21123	DC.W 21133,21142,21152,21161,21171,21180,21190,21199	DC.W 21209,21219,21228,21238,21247,21257,21267,21276	DC.W 21286,21295,21305,21315,21324,21334,21343,21353	DC.W