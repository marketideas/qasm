; Note--are duplicated in reqproc.  Fix this.; MapEventToName, FindNamedEntry, ComputeNameHash; DoWeNeedThisSound;************************************************************************;; Sound Control Panel for System 6.0;; Michael V. Stein   02/24/90; David A. Lyons     1991-92;; © Copyright Apple Computer, 1990-1992; All Rights Reserved;;; 20-Jan-91 DAL;   Changed stack clean-up code to remove the correct number;   of bytes (10, not 9).  This bug was masked by the Pascal;   Control Panel NDA, which accidentally tolerated stack;   imbalance.;; 21-Mar-91 DAL;   Added a _GetPort during CreateCDEV so it wouldn't get;   the wrong value for the check-box control handle since;   the window isn't the front window yet.  Changed the;   check-box value check to always examine the check box,;   not the control that was hit (which was sometimes the;   static text control).;; 23-Jun-91 DAL;   Semi-major rewrite to match my coding style and implement;   Jim Merritt's new design.  New layout, additional controls;   for configuring SysBeep2 sounds and recording sounds.;; 1-Jul-91 DAL, 2.0b7;   Commented out stuff on Recording.;; 20..21-Oct-91 DAL, 2.0b8;   Lots of work.;   Start by using the rTaggedStrings(1) resource to build;     the Event pop-up.;; 28..29-Oct-91 DAL, 2.0b9;   Fixed double-bonk bugs--scroll bar action procedures don't;     beep on part-code zero.;   Optimized a bunch of GetCtlHandleFromID calls into a subroutine.;   Build the Sounds pop-up & make this sucker work!;; 30-Oct-91 DAL;   Hooks into BELLVECTOR to remap System Beep.;   Pop-ups are type 2 (type 1 was working poorly since they are not;     near the top of the screen and can be long).;   Saves and loads Sound.Settings from *:System:Sounds.;; 30-Oct-91 DAL (for 2.0b10 for d56);   Made ChainBellVector a global so I can really use it.;   Fixed FindNamedEntry to return pointer to unassigned entry;     if you have no sounds.;   "Standard Beep" now plays when selected from Sound menu.;   Pitch scroll bar makes standard beep instead of system beep.;; 5-Nov-91 DAL (2.0b11 for d57);   Added support for asynchronous sounds.  Passes srqHelloWorld;     to our request proc.;; 9-Nov-91 DAL;   Make direct-page handle load high in bank 0.;   Copy and Cut put current sound (and its name) onto the clipboard.;   Return plays the current sound.;; 18-Nov-91 DAL (2.0b13 for d58);   At boot time, allocates a big temp handle around loading sounds,;     so we can't accidentally cram RAM full of sounds.;; 19-Nov-91 DAL (2.0b14 for d59);   Coded the DoWeNeedThisSound routine.;   CheckForDuplicate does not consider a not-loaded sound to be a dup.;   Forces sounds to be unlocked and not-purgeable when loaded.;; 24-Nov-91 DAL;   The Sounds menu is now in alphabetical order.;; 24-Jan-92 DAL;   Don't mark the settings file dirty just for popping up the;     Sounds menu (added curSoundValue).;   Other changes in ReqProc.aii.;;************************************************************************;; FUTURE ENHANCEMENTS;; Core Features;   Play sounds even if the Sound Tools are in use, by saving and;     restoring the state of the sound chip.  Play sounds even;     under P8, where no bank 0 space is available.;   Check for a minimum amount of stack space available; don't play;     sounds if it's not safe.;; Human Interface;   Make arrow keys adjust the scroll bars;     left/right=volume, command-left/right=pitch;   Make space bar play the system beep.;;************************************************************************debugSymbols	equ 0	blanks off	include '::commonmacros.h'	include 'all.macros'	include 'e16.resources'	include 'e16.locator'	include 'e16.desk'	include 'e16.event'	import SoundAboutMachineCDEV	equ 1	;called when rebuilding cdev.data to see if cdev should be includedBootCDEV	equ 2	;boot time init call or install call - no paramsShutDownCDEV	equ 3	;reserved for future useInitCDEV 	equ 4	;called when being shown - data1 equ windowPtrCloseCDEV 	equ 5	;called when being removed - data1 equ windowPtrEventsCDEV	equ 6	;called when an event - data1 equ ptr to event recordCreateCDEV	equ 7	;called so that CDEV can create its controls inline - data1 equ windowAboutCDEV 	equ 8	;called so that CDEV can create its about text inline - no paramsRectCDEV	equ 9	;called so that CDEV can dynamically compute its rectangleHitCDEV	equ 10	;called when ctl is "hit" - data1 equ Hdl to Ctl hit, data2 equ Ctl IdRunCDEV	equ 11	;caled when da run is calledEditCDEV 	equ 12	;called when SystemEdit is calledreserved2 	equ 13	;reserved for future usereserved3 	equ 14	;reserved for future useNeverUsed1	equ 15	;this will never be usedNeverUsed2	equ 16	;this will never be usedwantMachine 	equ 1wantBoot 	equ 2wantShutDown	equ 4wantInit	equ 8wantClose 	equ 16wantEvents 	equ 32wantCreate 	equ 64wantAbout 	equ 128wantRect 	equ 256wantHit 	equ 512wantRun 	equ 1024wantEdit	equ 2048updateSSfromBRAM	equ 16384;; Sound equates;maxpitch 	equ 14	;maximum value of pitchmaxvol	equ 14	;maximum value of volume;; Control IDs;volumeControlID	equ 1	;volume scroll barpitchControlID	equ 2	;pitch scroll barvisualControlID	equ 5	;visual indication of soundseventControlID	equ 9	;Event pop-up menusoundControlID	equ $A	;Sound pop-up menu;; Communication with the Sound Request Procedure;srqSetSoundGlobals	equ $8000	;set data from dataInsrqGetSoundGlobals	equ $8001	;return info at dataIn;;;srqPlaySoundHandle equ $8002	;test--play dataIn=rSoundSample handlesrqMakeStdBeep	equ $8003	;play a standard beepsrqHelloWorld	equ $8100	;initialize self;srqGetrSoundSample	equ $0004;srqSynchronize	equ $0005	;wait for sounds to finish;---------------------------------------------------------------------;; configHandle;; configHandle records mappings for all the sounds in the;   user's active set;; The format is exactly like an rTaggedStrings resource, mapping; from events into strings.;; +000: Count; +002: TagWord1; +004: PString1; +xxx: TagWord2; +yyy: PString2; +zzz: ...;; The strings are the names of Sound resources.; There are a few special strings:;   "0" = silence;   "*" = standard beep;;---------------------------------------------------------------------;; data structure for soundsHandle;; soundsHandle records mappings for all the sounds appearing;   in the Sound pop-up;; IMPORTANT!  The soundsHandle is locked while the Sound pop-up menu;             exists.  The menu items are pointers into this handle.;;---------------------------------------------------------------------oVersion	equ 0	;zerooEntryOffset	equ 2	;offset to the entry listoEntryCount	equ 4	;number of entries followingHEADERSIZE	equ 6;; Each entry:;oNextEntry	equ 0	;offset to next entry (from here)oNameHash	equ 2	;quick check against nameoMenuItem	equ 4	;menu item number in Sounds pop-upoPathOffset	equ 6	;offset from entry to pathname (WString) (or zero)oNameOffset	equ 8	;offset from entry to resname (PString) (or zero)oSoundData	equ 10	;long sound data (for ex, handle to sound sample)ENTRYSIZE	equ 14	;(not including strings!);; Values for Binding field (these match the menu item; numbers for the first 3 items in the Sound pop-up).;itemNotAssigned	equ 1itemSilence	equ 2itemStandardBeep	equ 3;; stack equates for special action procedures:;handleid	equ 4+1	;offset of handleid on stackpart	equ handleid+4	;offset to part on stack;; battery parameter values.;aug_param	equ $5e	;bit 0 set means no closed captioningpitch_param	equ $1f	;battery parameter to set pitchvolume_param	equ $1e	;battery parameter to set volume*************************************************************************** Sound Control Panel -- MAIN CDEV ENTRY POINT** At this point, the stack contains:** 14..17,s  LONG  Result Space* 12..13,s  WORD  Message* 08..11,s  LONG  Data1* 04..07,s  LONG  Data2* 01..03,s     RTL**************************************************************************SoundCP	procname export	phb	;save calling data bank	phk	plb	phd	tsc	tcdoldD	equ 1oldB	equ oldD+2rtlAddr	equ oldB+1data2	equ rtlAddr+3data1	equ data2+4message	equ data1+4result	equ message+2	lda <message	asl a	tax	cmp #DispatchEnd-Dispatch	bcs @ignore	jsr (Dispatch,x)@ignore	pld	plb	lda 1,s	sta 1+10,s	;move low word of return address	lda 2,s	sta 2+10,s	;move high word of return address (overlaps)	ply	ply	ply	ply	ply	;pull ten bytes of input parameters	rtlDispatch	dc.w ignore 	; 0 = reserved	dc.w ignore	; 1 = MachineCDEV	dc.w doBoot	; 2 = BootCDEV	dc.w ignore	; 3 = reserved	dc.w doInit	; 4 = InitCDEV	dc.w doClose	; 5 = CloseCDEV	dc.w doEvent	; 6 = EventsCDEV	dc.w doCreate	; 7 = CreateCDEV	dc.w doAbout	; 8 = AboutCDEV	dc.w ignore	; 9 = RectCDEV	dc.w doHit	;10 = HitCDEV	dc.w doRun	;11 = RunCDEV	dc.w doEdit	;12 = EditCDEVDispatchEnd*************************************************************************ignore	rts**************************************************************************************************************************************************** doBoot -- handle BootCDEV message**************************************************************************doBoot	name	pha	_QDVersion	pla	and #$0fff	cmp #$0307	;QD 3.7 is on 6.0	bcs @goodQDversion	_SysBeep	rts@goodQDversion	jsr InstallReqProc*** 29-Oct-91 DAL -- if we're a duplicate copy, X out our icon	bcc @ok	lda #1	sta [<data1]	;store into result flag	rts@ok;; Load the Sound.Settings file, or create an empty handle;	jsr LoadSettings;; Build data structure of sounds!;*** added 18-Nov-91 DAL -- allocate big temp handle to avoid cramming RAM full of sounds	pha	pha	pushlong #$050000	;big temp handle!	pha	_MMStartUp	;my id	pea 0	;attributes	phx	phx	;ignored	_NewHandle*** end 18-Nov-91 DAL	jsr ScanForSounds	;input: SEC if short on RAM	_DisposeHandle	;kill temp handle (18-Nov-91 DAL);; tell the Request Procedure about our new soundsHandle;	jsr SetSoundGlobals	rts*** end 29-Oct-91*************************************************************************** LoadSettings** Load Sound.Settings from disk, or create an empty settings handle.**************************************************************************LoadSettings	name	stz configIsDirty	lda #$0001	;read/write	jsr OpenSettings	bcs @createEmpty	_GetEOFGS getEOFparms	bcs @ouch	ldy theEOF+2	ldx theEOF	sty rwReqCount+2	stx rwReqCount	jsr MakeConfigHandleYX	jsr LockAndDerefConfig	sta rwWhere+2	stx rwWhere	_ReadGS rwSettingsParms@ouch	pha	;save error code	jsr UnlockConfig	jsr CloseSettings	pla	cmp #1	;sec if error	bcs @createEmpty	rts@createEmpty	jsr MakeEmptyConfigHandle	clc	rtsgetEOFparms	dc.w 2settingsRef5	dc.w 0theEOF	dc.l 0*************************************************************************** SaveSettings** Save Sound.Settings to disk if necessary.** Exit with SEC/A=error if there was a problem.**************************************************************************SaveSettings	name	lda configIsDirty	beq @notDirty	_CreateGS CreateSettingsParms	bcc @created	cmp #$0047	;duplicate file is okay	beq @created	sec	rts@created	lda #$0003	;read/write	jsr OpenSettings	bcs @exit	_SetEOFGS emptySettings	pha	pha	pushlong configHandle	_GetHandleSize	pla	sta rwReqCount	pla	sta rwReqCount+2	jsr LockAndDerefConfig	sta rwWhere+2	stx rwWhere	_WriteGS rwSettingsParms	pha	;save error code	jsr UnlockConfig	jsr CloseSettings	pla	sta configIsDirty	;still dirty if we got an error	cmp #1	;sec if error@exit@notDirty	rtsOpenSettings	sta settingsAccess	_OpenGS OpenSettingsParms	bcs @exit	lda settingsRef	sta settingsRef2	sta settingsRef3	sta settingsRef4	sta settingsRef5@exit	rtsCloseSettings	_CloseGS CloseSettingsParms	rts*************************************************************************** LockAndDerefConfig** Returns:  AX = address of config buffer**************************************************************************LockAndDerefConfig	name	phd	pushlong configHandle	tsc	tcd	ldy #4	lda [1],y	ora #$8000	sta [1],y	;locked handle	lda [1]	tax	;low word in X	dey	dey	;Y=2	lda [1],y	;high word in A	ply	ply	pld	rts*************************************************************************** UnlockConfig**************************************************************************UnlockConfig	name	pushlong configHandle	_HUnlock	rts*************************************************************************CreateSettingsParms	dc.w 4	dc.l SettingsPath	dc.w $00C3	;unlocked	dc.w $005A	;config file	dc.l 0	;no auxtype for nowOpenSettingsParms	dc.w 3settingsRef	dc.w 0	dc.l SettingsPathsettingsAccess	dc.w 0rwSettingsParms	dc.w 4settingsRef2	dc.w 0rwWhere	dc.l 0rwReqCount	dc.l 0rwXferCount	dc.l 0CloseSettingsParms	dc.w 1settingsRef3	dc.w 0SettingsPath	dc.w 30	dc.b '*:System:Sounds:Sound.Settings'emptySettings	dc.w 3settingsRef4	dc.w 0	dc.w 0	;base=0 (absolute)	dc.l 0	;displacement=0**************************************************************************************************************************************************** handle CreateCDEV message**************************************************************************doCreate	name*** ### for debugging, so we don't need to get BootCDEV	lda myProcMemID	bne @nonzero	pha	_MMStartUp	pla	ora #$0e00	sta myProcMemID@nonzero*** ### for debugging, so we don't need to get BootCDEV	jsr GetSoundGlobals	pha	pha	;space for NewControl2 result	pei <data1+2	pei <data1	;window pointer	pea 9	;control list resource	pushlong #1	;ID of my control list	_NewControl2	pla	pla	;ignore result	lda #soundControlID	jsr GetControlByID	pla	sta soundMenuHandle	pla	sta soundMenuHandle+2	lda #eventControlID	jsr GetControlByID	pla	sta eventMenuHandle	pla	sta eventMenuHandle+2	jsr BuildEventPopUp	rtssoundMenuHandle	dc.l 0eventMenuHandle	dc.l 0**************************************************************************************************************************************************** BuildEventPopUp** Add items to the Event pop-up from the rTaggedStrings(1) resource.** <data1 is window pointer.  Controls have already been created.**************************************************************************BuildEventPopUp	name	pha	pha	_GetMenuBar	lda #eventControlID	jsr GetControlByID	_SetMenuBar	;menu bar is set to my pop-up	pha	pha	;space for LoadResource	pea rTaggedStrings	pushlong #1	_LoadResource	;this is locked and fixed	plx	ply	bcs @err	phd	phy	phx	tsc	tcd@ptr	equ 1	ldy #4	lda [<@ptr],y	ora #$8000	sta [<@ptr],y	;lock it, just to be paranoid	dey	dey	lda [<@ptr],y	tax	lda [<@ptr]	sta <@ptr	stx <@ptr+2	lda [<@ptr]	beq @addDone	sta @count	lda #2	jsr @bumpPtr	;skip past count field@addOne	lda [<@ptr]	sta itemID	lda #2	jsr @bumpPtr	lda <@ptr+2	ldy <@ptr	sta namePtr+2	sty namePtr	pea 0	;template is pointer	pushlong #itemTemplate	pea $ffff	;add at end	pea 1	;menu id	_InsertMItem2	lda [<@ptr]	and #$00ff	inc a	jsr @bumpPtr	;skip past pstring	dec @count	bne @addOne@addDone	lda #0	pha	;width	pha	;height	inc a	pha	;menu id within pop-up	_CalcMenuSize	pla	pla	;discard ptr	pld@err	_SetMenuBar	rts@bumpPtr	clc	adc <@ptr	sta <@ptr	bcc @p1	inc <@ptr+2@p1	rts@count	dc.w 0itemTemplate	dc.w 0	;versionitemID	dc.w 0	dc.b 0,0	;key equivs	dc.w 0	;check character	dc.w 0	;item flagnamePtr	dc.l 0**************************************************************************************************************************************************** BuildSoundPopUp** Determine what sounds are available and add their names to the Sound* pop-up.** <data1 is window pointer.  Controls have already been created.** This LOCKS soundsHandle, and it must stay locked until the Sound* pop-up is gone.**************************************************************************BuildSoundPopUp	name	clc	;18-Nov-91 DAL -- not short on RAM	jsr ScanForSounds	pha	pha	_GetMenuBar	lda #soundControlID	jsr GetControlByID	_SetMenuBar	;menu bar is set to my pop-up	phd	pushlong soundsHandle	pha	pha	;space for entry pointer	pha	pha	;space for @sort	tsc	tcd@sort	equ 1@entry	equ @sort+4@soundPtr	equ @entry+4	ldy #4	lda [<@soundPtr],y	ora #$8000	sta [<@soundPtr],y	;lock the soundsHandle	dey	dey	lda [<@soundPtr],y	tax	lda [<@soundPtr]	sta <@soundPtr	stx <@soundPtr+2	ldy #oEntryCount	lda [<@soundPtr],y	beq @noSounds	jsr @sortEntries	bcs @noSounds@insertOneSound	jsr @pointAtNextEntry	bcs @noMoreEntries	ldy #oMenuItem	lda [<@entry],y	sta itemID	clc	lda <@entry	ldy #oNameOffset	adc [<@entry],y	sta namePtr	lda <@entry+2	adc #0	sta namePtr+2	pea 0	;template is pointer	pushlong #itemTemplate	pea $ffff	;add at end	pea 1	;menu id	_InsertMItem2	bra @insertOneSound@noMoreEntries	jsr @cleanUpAfterSort  ;24-Nov-91 DAL	bra @calcSize;; If there are no sounds, kill the dividing line at the; bottom of the Sound pop-up.;@noSounds	pea $F001	_DeleteMItem@calcSize	lda #0	pha	;width	pha	;height	inc a	pha	;menu id within pop-up	_CalcMenuSize	ply	ply	;discard @sort	ply	ply	;discard entry ptr	ply	ply	;discard sound data pointer	pld	_SetMenuBar	rts*************************************************************************** sortEntries** Input:  @soundPtr points to soundsHandle data*         @entry points to first entry** Output: SEC if something's wrong** On exit, we're prepared for pointAtNextEntry to be called* repeatedly to walk all sounds alphabetically.**************************************************************************@sortEntries	clc	; point @entry at first entry	ldx <@soundPtr+2	lda <@soundPtr	ldy #oEntryOffset	adc [<@soundPtr],y	bcc @1	inx@1	sta <@entry	stx <@entry+2	ldy #oEntryCount	lda [<@soundPtr],y	asl a	asl a	sta @maxIndex	pha	pha	;space for NewHandle	pea 0	pha	;entry*4 = size	lda myProcMemID	pha	pea $C000	;locked and fixed	pha	pha	;ignored	_NewHandle	plx	ply	sty @sortHandle+2	stx @sortHandle	bcs @exit	sty @sort+2	stx @sort	ldy #2	lda [@sort],y	tax	lda [@sort]	sta <@sort	stx <@sort+2*** make a list of all the entry pointers	ldy #0	;index into @sort data@stuffOnePtr	lda <@entry	sta [<@sort],y	iny	iny	lda <@entry+2	sta [<@sort],y	iny	iny	clc	lda <@entry	adc [<@entry]	sta <@entry	bcc @noRoll	inc <@entry+2@noRoll	cpy @maxIndex	bcc @stuffOnePtr*** now do a surrogate bubble sort on the entry pointers, key=name field@nextPass	stz @swapFlag	jsr @oneBubblePass	lda @swapFlag	bne @nextPass	stz @sortIndex	clc@exit	rts** oneBubblePass -- set swapFlag if we do any swaps*@oneBubblePass	ldy #0@compareOne	phy	iny	iny	iny	iny	cpy @maxIndex	ply	bcs @passDone	phy	;save index	pha	;space for CompareStrings	pea 0	;flags (reserved)	jsr @PushNamePtr	jsr @PushNamePtr	_CompareStrings	pla	bmi @noSwap	beq @noSwap	;shouldn't happen, but just in case	ply	phy	jsr @swap2@noSwap	ply	iny	iny	iny	iny	bra @compareOne@passDone	rts** PushNamePtr -- push name of entry at [@sort],y and* point Y at next entry pointer*@PushNamePtr	pla	sta @rts	lda [<@sort],y	sta <@entry	iny	iny	lda [<@sort],y	sta <@entry+2	iny	iny	sty @yTemp	ldy #oNameOffset	clc	lda <@entry	adc [<@entry],y	tax	iny	iny	lda <@entry+2	adc #0	pha	phx	ldy @yTemp	lda @rts	pha	rts@yTemp	dc.w 0@rts	dc.w 0** swap2 -- swap entries at [@sort],y and [@sort],y+4*@swap2	phy	jsr @swapWordY	iny	iny	jsr @swapWordY	ply	inc @swapFlag	rts** swapWordY -- exchange word at [@sort],y with word at [@sort],y+4*@swapWordY	lda [<@sort],y	pha	iny	iny	iny	iny	lda [<@sort],y	tax	pla	sta [<@sort],y	dey	dey	dey	dey	txa	sta [<@sort],y	rts@swapFlag	dc.w 0*************************************************************************** pointAtNextEntry** Output: SEC if there are no more entries**************************************************************************@pointAtNextEntry	lda @sortIndex	tay	inc a	inc a	inc a	inc a	sta @sortIndex	cpy @maxIndex	bcs @nextExit	lda [<@sort],y	sta <@entry	iny	iny	lda [<@sort],y	sta <@entry+2	clc@nextExit	rts@sortHandle	dc.l 0@sortIndex	dc.w 0	;walks through sortHandle@maxIndex	dc.w 0*************************************************************************** cleanUpAfterSort**************************************************************************@cleanUpAfterSort	lda @sortHandle+2	pha	lda @sortHandle	pha	_DisposeHandle	stz @sortHandle+1	rts**************************************************************************************************************************************************** ScanForSounds** INPUT:*   SEC if we are way short on memory.** Look through all the rSoundSample resources in *:System:Sounds, and* add them to soundsHandle if they aren't already there.** If soundsHandle is NIL, we need to create it.**************************************************************************ScanForSounds	name	php	jsr CreateSoundsHandle  ;make empty handle if needed	plp	bcs @exit	lda #8	jsr getPfx	phy	phx	;preserve prefix 8	lda #0	jsr getPfx	phy	phx	;preserve prefix 0	_SetPrefixGS setZeroNull	_SetPrefixGS setEightSoundsDir	jsr OpenDirectory	bcs @fail@next	jsr GetNextSoundFile	bcs @done	jsr ScanOneFile	bra @next@done	_CloseGS CloseSoundsDir@fail	plx	ply	lda #0	jsr setPfx	;restore prefix 0	plx	ply	lda #8	jsr setPfx	;restore prefix 8@exit	rts*************************************************************************** CreateSoundsHandle** If soundsHandle is NIL, try to create it.  Initialize it to show* we know about zero sounds.**************************************************************************CreateSoundsHandle	name	lda soundsHandle+1	bne @exists	pha	pha	;space for NewHandle	pushlong #HEADERSIZE	lda myProcMemID	pha	pea 0	;attributes = unlocked	pha	pha	;ignored	_NewHandle	plx	ply	bcs @exit	sty soundsHandle+2	stx soundsHandle;; initialize soundsHandle;	phd	phy	phx	tsc	tcd	ldy #2	lda [1],y	tax	lda [1]	sta <1	stx <3	lda #0;;;	ldy #oVersion	;zero	sta [1]	;set Version = 0	ldy #oEntryCount	sta [1],y	;set EntryCount = 0	ldy #oEntryOffset	lda #HEADERSIZE	sta [1],y	;set EntryOffset to HEADERSIZE	ply	ply	pld@exit@exists	rts********************************************************************************* OpenDirectory********************************************************************************OpenDirectory	name	_OpenGS OpenSoundsDir	bcs @done	lda dirRef	sta dirRef2	sta dirRef3@done	rts********************************************************************************* GetNextSoundFile********************************************************************************GetNextSoundFile	name	_GetDirEntryGS GetDirEnt	bcs @err	lda entFlags	bpl GetNextSoundfile  ;go back for an Extended one!	clc	;success@err	rts*************************************************************************** Scan one file for sounds** Find all the named rSoundSample resources** Input:*   Prefix 8 is already set to the sound directory*   Filename of an extended file is in theFileName*   soundsHandle exists**************************************************************************ScanOneFile	name	pha	_GetCurResourceFile*** open resource file	pha	;space for result	pea $8001	;no-preload, read-only	pea 0	pea 0	;map handle	pushlong #theFileName	_OpenResourceFile	plx	;resource file id	stx @thisResfile	bcs @doneWithFile	pha	jsr CountSounds	pla	sta @numSounds	beq @didThemAll	_ExpandPathGS expandParms	lda #1	;first resource@nextSound	pha; get indexed sound	jsr GetAthSoundID	;return ID in AX	sta thisSoundID+2	stx thisSoundID; get its name	pea rSoundSample	pha	phx	pushlong #resNameBuffer	_RMGetResourceName	bcs @doneWithOneRes; add sound to the list	jsr MergeOneSound	;takes resNameBuffer, thisSoundID, theFileName@doneWithOneRes	pla	inc a	dec @numSounds	bne @nextSound@didThemAll	lda @thisResFile	pha	_CloseResourceFile@doneWithFile	_SetCurResourceFile	rts@numSounds	dc.w 0@thisResFile	dc.w 0thisSoundID	dc.l 0resNameBuffer	ds.b 256resNameHash	dc.w 0expandParms	dc.w 3	dc.l theFileName	dc.l fileNameBuff	dc.w 0********************************************************************************* CountSounds -- set file depth to 1 and count the rSoundSample resources** Result is on stack (caller passed a word of space)********************************************************************************CountSounds	name	pha	;result space for restoring depth	pha	;space for old depth	pea 1	_SetResourceFileDepth  ;leave old depth on stack	pha	pha	;space for result	pea rSoundSample	_CountResources	pla	plx	sta 7,s	;past 2 data words & RTS address	_SetResourceFileDepth	pla	rts********************************************************************************* GetAthSoundID -- set file depth to 1 and get the Ath rSoundSample resource** Result ID is in AX********************************************************************************GetAthSoundID	name	pha	;preserve	pha	;space for old depth	pea 1	_SetResourceFileDepth  ;leave old depth on stack	pla	sta @oldDepth	pla	;restore passed value to A	pha	pha	;space for result	pea rSoundSample	pea 0	;high word of index	pha	;low word of index	_GetIndResource	;leave on stack until we exit	pha	lda @oldDepth	pha	_SetResourceFileDepth	pla	plx	pla	;pull GetIndResource result	rts@oldDepth	dc.w 0********************************************************************************* muck with prefixes 0 and 8********************************************************************************setZeroNull	dc.w 2	dc.w 0	dc.l nullPathnullPath	dc.w 0setEightSoundsDir	dc.w 2	dc.w 8	dc.l SoundsDirPathSoundsDirPath	dc.w 15	dc.b '*:System:Sounds'OpenSoundsDir	dc.w 3dirRef	dc.w 0	dc.l SoundsDirPath	dc.w $0001	;read onlyCloseSoundsDir	dc.w 1dirRef3	dc.w 0GetDirEnt	dc.w 13dirRef2	dc.w 0entFlags	dc.w 0,1,1	;flags, base, displacement	dc.l fileNameBuff	dc.w 0	;entry numentType	dc.w 0	;filetype	dc.l 0	;eof	dc.l 0	;blocksentCreateDate	dc.l 0,0	;create date/timeentModDate	dc.l 0,0	;mod date/time	dc.w 0	;accessentAuxType	dc.l 0	;auxtypefileNameBuff	dc.w 258theFileName	ds.b 256*************************************************************************** MergeOneSound** Input:*   Resource name in resNameBuffer (PString)*   rSoundSample ID in thisSoundID (long)*   Filename in theFileName (WString)** Output:*   none (adds sound to soundsHandle if possible)**************************************************************************MergeOneSound	name	jsr CheckForDuplicate	bcc @notDuplicate@exit	rts@notDuplicate	jsr LoadSoundIfNeeded	sta thisSoundHandle+2	stx thisSoundHandle*** 19-Nov-91 DAL -- if name already has an entry, just stuff the handle	jsr FindNamedEntry	bcs @createNewEntry	phd	pha	phx	tsc	tcd	ldy #oSoundData+2	lda thisSoundHandle+2	sta [1],y	lda thisSoundHandle	dey	dey	sta [1],y	ply	ply	pld	rts*** end 19-Nov-91 DAL@createNewEntry	phd	pushlong soundsHandle	tsc	tcd@entry	equ 1@handle	equ @entry	;same thing!; compute size needed for new entry (ENTRYSIZE + resNameBuffer+1 + theFileName+2)	clc	lda resNameBuffer	and #$00ff	adc theFileName	adc #ENTRYSIZE+1+2	;1 for pstring + 2 for wstring	sta sizeNeeded; grow soundsHandle by needed size	pha	pha	pei <@handle+2	pei <@handle	_GetHandleSize	;leave size on stack	clc	lda 1,s	adc sizeNeeded	tax	lda 3,s	adc #0	pha	phx	pei <@handle+2	pei <@handle	_SetHandleSize	bcc @ok	brk $42	;@@@ (later)@ok; deref handle, grab entry count, and increment it	lda [<@handle]	tax	ldy #2	lda [<@handle],y	sta <@handle+2	stx <@handle	ldy #oEntryCount	lda [<@handle],y	sta prevNumEntries	inc a	sta [<@handle],y; compute pointer to new entry	clc	pla	;add old size	adc <@handle	sta <@entry	pla	adc <@handle+2	sta <@entry+2; store new entry length	lda sizeNeeded	sta [<@entry]	;oNextEntry; store name hash	jsr ComputeNameHash	ldy #oNameHash	sta [<@entry],y; store menu id	ldy #oMenuItem	lda prevNumEntries	clc	adc #$1000	;number the items from $1000+	sta [<@entry],y; store path offset	ldy #oPathOffset	lda #ENTRYSIZE	sta [<@entry],y; store name offset	clc	adc theFileName	inc a	inc a	ldy #oNameOffset	sta [<@entry],y; store sound data	ldy #oSoundData	lda thisSoundHandle	sta [<@entry],y	iny	iny	lda thisSoundHandle+2	sta [<@entry],y; store pathname	pushlong #theFileName  ;source	clc	lda <@entry	ldy #oPathOffset	adc [<@entry],y	tax	lda <@entry+2	adc #0	pha	phx	;destination	pea 0	;high word of size	lda theFileName	inc a	inc a	;low word of size	pha	_BlockMove; store resource name	pushlong #resNameBuffer	clc	lda <@entry	ldy #oNameOffset	adc [<@entry],y	tax	lda <@entry+2	adc #0	pha	phx	pea 0	lda resNameBuffer	and #$00ff	inc a	pha	_BlockMove	ply	ply	;discard entry pointer	pld	rtsthisSoundHandle	dc.l 0sizeNeeded	dc.w 0prevNumEntries	dc.w 0*************************************************************************** CheckForDuplicate** Input:  sound name in resNameBuffer** Output: SEC if we already have a sound with this name**************************************************************************CheckForDuplicate	name	jsr FindNamedEntry	bcs @fine	;not found--that's good*** 19-Nov-91 DAL -- don't count a nil-handle entry as a duplicate	phd	pha	phx	tsc	tcd	ldy #oSoundData+1	lda [1],y	ply	ply	pld	tax	beq @fine*** end 19-Nov-91	sec	;oops, we found a duplicate	rts@fine	clc	;return not-duplicate	rts*************************************************************************** LoadSoundIfNeeded** Input:  sound name in resNameBuffer, ID in thisSoundID** Output:  handle in AX (NIL if not needed or error)**************************************************************************LoadSoundIfNeeded	name	jsr DoWeNeedThisSound	bcs @notNeeded	pha	pha	;space for LoadResource	pea rSoundSample	pushlong thisSoundID	_LoadResource	plx	ply	bcs @error	phy	phx	;copy to return*** added 19-Nov-91 DAL -- force sounds unlocked and not-purgeable	phy	phx	;preserve YX	pea 0	;purge level	phy	phx	;handle for SetPurge	phy	phx	;handle for HUnlock	_HUnlock	_SetPurge	plx	ply	;restore YX*** end 19-Nov-91 DAL	pha	;space for result	lda myProcMemID	pha	phy	phx	_SetHandleID	pla	;discard old ID	pea rSoundSample	pushlong thisSoundID	_DetachResource	plx	pla	;return handle in AX	rts@notNeeded@error	lda #0	tax	rts*************************************************************************** DoWeNeedThisSound** Input:  resNameBuffer (sound name, PString)** Output: SEC if we don't need this sound*         CLC if we need this sound** The sounds we need are the ones in configHandle (any sound currently* bound to any event).*;---------------------------------------------------------------------;; configHandle;; configHandle records mappings for all the sounds in the;   user's active set;; The format is exactly like an rTaggedStrings resource, mapping; from events into strings.;; +000: Count; +002: TagWord1; +004: PString1; +xxx: TagWord2; +yyy: PString2; +zzz: ...;*************************************************************************DoWeNeedThisSound	name	phd	pushlong configHandle	tsc	tcd@temp	equ 1	ldy #2	lda [<@temp]	tax	lda [<@temp],y	sta <@temp+2	stx <@temp	lda [<@temp]	sta @count	beq @notNeeded	lda #4	jsr @bumpTemp@check1	pushlong #resNameBuffer	pei <@temp+2	pei <@temp	jsr ComparePStrings	bcc @exit	;equal!	lda [<@temp]	and #$00ff	inc a	inc a	inc a	jsr @bumpTemp	dec @count	bne @check1@notNeeded	sec@exit	ply	ply	pld	rts@bumpTemp	clc	adc <@temp	sta <@temp	bcc @1	inc <@temp+2@1	rts@count	dc.w 0*************************************************************************** ComputeNameHash** Input:  pstring in resNameBuffer** Output: A, resNameHash**************************************************************************ComputeNameHash	name;@@@ (provide a useful hashing function later)	lda #$BEEF	sta resNameHash	rts*************************************************************************** getPfx - retrieves current prefix for the supplied* prefix number.  The handle to the stored prefix is* returned to the caller.** on entry:*     Acc = prefix number** on exit:*     X, Y = handle of stored prefix (low,high)**************************************************************************getPfx	name@tmpPtr	equ $01@pfxHndl	equ $05 	;handle to stored prefix	sta prefixNum	;put prefix number in parmblock (for later)	pha	;make space for temp pointer	pha	pha	;and prefix handle	pha	tsc	;make stack frame	phd	tcd		pha	;make space for NewHandle call	pha	pea 0	;size of block to create	pea 256	;we'll try 256 bytes at first	lda myProcMemID	pha	pea $8010	;attributes	pha	;location pointer	pha	;(not used)	_NewHandle	;go get some memory	pla	;retreive handle	plx	bcc @got_mem@memerr	lda #0	pha	;oops!  put up an ErrorWindow	pha	;subString type (not used)	pha	;subStringPtr (not used)	pha	pea $8D	;"Memory is full"	bra @showErr@got_mem	sta @pfxHndl	;save for return to caller	stx @pfxHndl+2	ldy #2	;dereference handle	lda [@pfxHndl]	sta @tmpPtr	sta bufPtr	lda [@pfxHndl],y	sta @tmpPtr+2	sta bufPtr+2	lda #256	;initialize length of buffer	sta [@tmpPtr]	lda #2	;set up parm block	sta pCount	;prefixNum set up above@try_again	_GetPrefixGS parmBlock	;get the current prefix	bcc @got_prefix	;no error, continue	cmp #$4f	;buffer too small?	beq @grow_buf	;yes, grow the buffer and try again	pha	;else just puke!	pea 0	;subString type (not used)	pea 0	;subStringPtr (not used)	pea 0	pha	;put error code on stack@showErr	_ErrorWindow	pla	;;retrieve button number	sec	;we had a problem	bra @exit	;just exit@grow_buf	ldy #2	lda [@tmpPtr],y	;get returned length word	clc	adc #4	;allow for length words	pha	;save new length on stack	pea 0	;high word of new size allocation	pha	;low word of length	pei @pfxHndl+2	;put handle on stack	pei @pfxHndl	ldy #4	;unlock the handle first	lda [@pfxHndl],y	and #$7FFF	sta [@pfxHndl],y	_SetHandleSize	;make the block bigger	bcs @memerr	;abort on error	ldy #4	;lock it down again	lda [@pfxHndl],y	ora #$8000	sta [@pfxHndl],y	ldy #2	;dereference handle again	lda [@pfxHndl]	sta @tmpPtr	sta bufPtr	lda [@pfxHndl],y	sta @tmpPtr+2	sta bufPtr+2	pla	;retrieve new length of buffer	sta [@tmpPtr]	;store in buffer	bra @try_again	;go try again@got_prefix	ldy #4	;unlock the handle	lda [@pfxHndl],y	and #$7FFF	sta [@pfxHndl],y		pea 0	;high word of new size allocation	ldy #2	lda [@tmpPtr],y	;get the length of the returned string	clc	adc #4	;include length words	pha	;put on stack for call	pei @pfxHndl+2	pei @pfxHndl	_SetHandleSize	;resize the handle so it's just the right size	ldy @pfxHndl+2	;return handle to caller	ldx @pfxHndl	clc	;no error@exit	pld	;clean up stack frame	pla	pla	pla	pla	rts*************************************************************************** setPfx - restore prefix to it's original value** on entry:*    Acc = prefix number*    X,Y = handle to stored prefix**************************************************************************setPfx	name@tmpPtr	equ $01	sta prefixNum	;save prefix number in parm block	pha	;make space on stack for temp pointer	pha	tsc	;make stack frame	phd	tcd	lda #2	;2 parms for SetPrefix call	sta pCount	stx @tmpPtr	sty @tmpPtr+2	ldy #2	;dereference handle to prefix string	lda [@tmpPtr]	;but set pointer to length	clc	;word within buffer	adc #2	sta bufPtr	lda [@tmpPtr],y	adc #0	sta bufPtr+2	_SetPrefixGS parmBlock	pei <@tmpPtr+2	pei <@tmpPtr	_DisposeHandle	pld	;clean up stack	pla	pla	rtsparmBlockpCount	dc.w 0prefixNum	dc.w 0bufPtr	dc.l 0**************************************************************************************************************************************************** handle AboutCDEV message**************************************************************************doAbout	name	pha	;space for NewControl2 result	pha	pei <data1+2	pei <data1	;window pointer	pea 0	;next item is a control pointer	pushl #soundAbout	_NewControl2	pla	pla	;don't care about result	rts**************************************************************************************************************************************************** doRun** Poll the system settings in case they changed.** If they did, update our controls accordingly!** <data1 = our window pointer**************************************************************************doRun	name	ldx #volume_param	jsr ReadBatteryParam ;don't use GetCurrentVolume--it sets curvol	cmp curvol	beq @volumeOK	sta curvol	pha	lda #volumeControlID	jsr GetControlByID	_SetCtlValue@volumeOK	jsr GetCurrentPitch	cmp curpitch	beq @pitchOK	sta curpitch	pha	lda #pitchControlID	jsr GetControlByID	_SetCtlValue@pitchOK	ldx #aug_param	jsr ReadBatteryParam	eor ccflag	lsr a	;carry clear if bit 0 matches	bcc @visualBoxOK	lda ccflag	pha	lda #visualControlID	jsr GetControlByID	;uses window = <data1	_SetCtlValue	lda #1	eor ccflag	sta ccflag@visualBoxOK	rts**************************************************************************************************************************************************** doEdit** Handle Cut and Copy by putting the current sound on the clipboard,* if we have one.**************************************************************************doEdit	name	lda <data1	cmp #cutAction	beq @doCopy	cmp #copyAction	beq @doCopy	pea $000B	;task impossible	_SysBeep2	rts** Copy the current sound and its name onto the clipboard*@doCopy	pea 0	_ScrapStatus	pla	bne @continue	brl @failed@continue	pea srqGetrSoundSample	pea sendToName+stopAfterOne	pushlong #myReqProcName	pushlong #resNameBuffer	pushlong #getSoundOut	_SendRequest	bcs @failed	_ZeroScrap	pea 0	;size, high word	lda resNameBuffer	and #$00ff	pha	;size, low word	pea $0000	;type is textScrap	pushlong #resNameBuffer+1	_PutScrap	;put the name on the clipboard	bcs @failed	phd	pushlong soundOutHandle	tsc	tcd	ldy #4	lda [1],y	pha	;push old attributes	ora #$8000	sta [1],y	;lock the handle	pha	pha	;space for GetHandleSize	pei 3	pei 1	;push sound handle	_GetHandleSize	;leave size on stack for PutScrap	pea $0002	;soundScrap	ldy #2	lda [1],y	pha	lda [1]	pha	;pushed sound pointer	_PutScrap	ldy #4	pla	sta [1],y	;restore handle attributes	ply	ply	pld	bcs @failed	;carry still conditioned from PutScrap	rts@failed	pea $000C	;task failed	_SysBeep2	rts**************************************************************************************************************************************************** doEvent** If they hit return, handle it like a hit on the Sound pop-up.** Input:  data1 is eventRecord pointer*         data2 is window pointer**************************************************************************doEvent	name	lda [<data1]	;get event.what	cmp #keyDownEvt	beq @key	cmp #autoKeyEvt	beq @key	rts@key	ldy #oMessage	lda [<data1],y	and #$00ff	cmp #$000D	;return?	bne @notReturn	jsr hitSoundPopUp@notReturn	rts**************************************************************************************************************************************************;; doHit - hit sound controls.;; entry	aug_param = aug group battery parameter byte.;	data1 = handle of control that was hit.;	data2 = id of control that was hit.;; exit	Took appropriate action for the control that was;	hit.;*************************************************************************doHit	name	lda <data2	;get id of control	asl a	cmp #HitDispatchEnd-HitDispatch	bcs @done	tax	jmp (HitDispatch,x)@done	rtsHitDispatch	dc.w ignore	;0	dc.w ignore	;1 = volume scroll bar (has action proc)	dc.w ignore	;2 = pitch scroll bar (has action proc)	dc.w ignore	;3 = text	dc.w ignore	;4 = text	dc.w hitCheckBox	;5 = check box (visual indication of sounds);;;	dc.w hitRecord	;6 = Record Sound... box	dc.w ignore	;6 = not used	dc.w ignore	;7 = not used	dc.w ignore	;8 = not used	dc.w hitEventPopUp	;9 = Event pop-up	dc.w hitSoundPopUp	;$A = Sound pop-upHitDispatchEnd*************************************************************************** hitCheckBox -- toggle the visual indication of sounds check box**************************************************************************hitCheckBox	name	pha	;space for GetCtlValue	pei <data1+2	pei <data1	;control handle	_GetCtlValue	pla	beq hsc1	;if not set	lda #1	;force it to onehsc1	eor #1	;invert the flag so that 0 = on, 1 = off	sta ccflag	ldx #aug_param	jsr ReadBatteryParam	and #$fe	ora ccflag	;set closed captioning flag as appropriate	ldx #aug_param	brl WriteBatteryParam;*************************************************************************;*************************************************************************;*;* hitRecord -- record a new sound;*;*************************************************************************;hitRecord	pha;	pea $0030;	pea 0;	pea 0;	pushlong #noTapeDeck;	_AlertWindow;	pla;	rts;;noTapeDeck	dc.b '33/Pretend this is a cool little Tape Deck control panel, okay?/^#0',0*************************************************************************** hitEventPopUp -- Show them the sound associated with this event** This gets called during Init, so don't assume data1 and data2 are* set up like a HitCDEV event!**************************************************************************hitEventPopUp	name	pha	pushlong eventMenuHandle	_GetCtlValue	pla; get current value for Event	jsr MapEventToName	;in=A, out=resNameBuffer; get item number for name (in resNameBuffer)	jsr FindNamedEntry	;out=AX pointing to entry	phd	pha	phx	tsc	tcd	ldy #oMenuItem	lda [1],y	ply	ply	pld; set the Sound pop-up to the corresponding value	pha	;new value	sta curSoundValue	;24-Jan-92 DAL	pushlong soundMenuHandle	_SetCtlValue	rts*************************************************************************** MapEventToName** Input:  A = event** Output: resNameBuffer**************************************************************************MapEventToName	name	sta @target	stz resNameBuffer	;null string (not assigned)	phd	pushlong configHandle	tsc	tcd@temp	equ 1	ldy #2	lda [<@temp]	tax	lda [<@temp],y	sta <@temp+2	stx <@temp	lda [<@temp]	;number of mappings	beq @done	tax	lda #2	jsr @bumpTemp@tryOneMapping	lda [<@temp]	cmp @target	bne @next	lda #2	jsr @bumpTemp	pei <@temp+2	pei <@temp	pushlong #resNameBuffer	pea 0	lda [<@temp]	and #$00ff	inc a	pha	_BlockMove	bra @done@next	ldy #2	lda [@temp],y	and #$00ff	inc a	inc a	inc a	jsr @bumpTemp	dex	bne @tryOneMapping@done	ply	ply	pld	rts@bumpTemp	clc	adc <@temp	sta <@temp	bcc @ok	inc <@temp+2@ok	rts@target	dc.w 0*************************************************************************** FindNamedEntry** Input: resNameBuffer (pstring), soundsHandle** Output: AX = pointer to entry*         SEC = we returned the "not assigned" entry** Simulates entries for Silence, Standard Beep, Not Assigned.**************************************************************************FindNamedEntry	name	jsr ComputeNameHash	lda resNameBuffer	cmp #$2A01	;"*"	bne @notStdBeep	lda #^fakeStdBeep	ldx #fakeStdBeep	clc	rts@notStdBeep	cmp #$3001	;"0"	bne @notSilence	lda #^fakeSilence	ldx #fakeSilence	clc	rts@notSilence	phd	pushlong soundsHandle	tsc	tcd@ptr	equ 1	ldy #2	lda [<@ptr]	tax	lda [<@ptr],y	sta <@ptr+2	stx <@ptr	ldy #oEntryCount	lda [<@ptr],y	sta @count	beq @fail	ldy #oEntryOffset	lda [<@ptr],y	jsr @bumpPtr@checkOneEntry	jsr @CompareName	;returns CLC if equal	lda <@ptr+2	ldx <@ptr	bcc @found	lda [<@ptr]	jsr @bumpPtr	dec @count	bne @checkOneEntry@fail	lda #^fakeNotAssigned	ldx #fakeNotAssigned	sec@found	ply	ply	pld	rts@count	dc.w 0@bumpPtr	clc	adc <@ptr	sta <@ptr	bcc @nr	inc <@ptr+2@nr	rts** CompareName -- return CLC if resNameBuffer matches @ptr entry*@CompareName	ldy #oNameHash	lda [<@ptr],y	cmp resNameHash	sec	;no match	bne @exit	pushlong #resNameBuffer	clc	ldy #oNameOffset	lda [<@ptr],y	adc <@ptr	tax	lda <@ptr+2	adc #0	pha	phx	jsr ComparePStrings@exit	rts	;return clc=match, sec=not*************************************************************************** ComparePStrings** Input: two Pascal String pointers on stack** Output: CLC if equal**************************************************************************ComparePStrings	phd	tsc	tcd@one	equ 5@two	equ @one+4	sep #$30	longa off	longi off	lda [@one]	tay	cmp [@two]	bne @noMatch@nextChar	lda [@one],y	jsr upcase	sta @cheat+1	lda [@two],y	jsr upcase@cheat	cmp #$77	;self-modified	bne @noMatch	dey	bne @nextChar	clc	bra @exit@noMatch	sec@exit	rep #$30	longa on	longi on	pld	plx	;rts addr	ply	ply	ply	ply	phx	;rts addr	rts	longa offupcase	cmp #'a'	bcc @up	cmp #'z'+1	bcs @up	and #$df@up	rts	longa onfakeNotAssigned	dc.w 0,0,itemNotAssigned,0,0,0,0fakeSilence	dc.w 0,0,itemSilence,0,0,0,0fakeStdBeep	dc.w 0,0,itemStandardBeep,0,0,0,0*************************************************************************** hitSoundPopUp -- Assign a new sound to the current event (and play*                  the sound as a sample** This can be called from a variety of places--be very careful about* using data1 and data2!  They are not always set up for a HitCDEV.**************************************************************************hitSoundPopUp	name	pha	pushlong soundMenuHandle   ;9-Nov-91 DAL	_GetCtlValue	pla	sta @value; put name of Sound in resNameBuffer	stz resNameBuffer	cmp #itemNotAssigned	beq @assignIt	ldx #$3001	;"0"	stx resNameBuffer	cmp #itemSilence	beq @assignIt	ldx #$2A01	;"*"	stx resNameBuffer	cmp #itemStandardBeep	beq @assignIt	pha	pha	_GetMenuBar	pushlong soundMenuHandle	_SetMenuBar	pha	pha	lda @value	pha	_GetMItem	pushlong #resNameBuffer	phd	tsc	tcd	lda [7]	and #$00ff	inc a	pld	pea 0	pha	_BlockMove	_SetMenuBar@assignIt*** added 24-Jan-92 DAL -- don't make config dirty if this isn't a change	lda @value	cmp curSoundValue	sta curSoundValue	beq @justPlay*** end 24-Jan-92	pha	pushlong eventMenuHandle	_GetCtlValue	pla	jsr SetConfigMapping   ;map event A to resNameBuffer@justPlay	jsr PlayNamedSound	rts@value	dc.w 0curSoundValue	dc.w 0	;added 24-Jan-92 DAL*************************************************************************** PlayNamedSound** Play the sound named in resNameBuffer** If necessary, loads the sound from disk.**************************************************************************PlayNamedSound	name	lda resNameBuffer	cmp #$2a01	;"*" = Standard Beep	beq @stdBeep	pea srqGetrSoundSample	pea sendToName+stopAfterOne	pushlong #myReqProcName	pushlong #resNameBuffer	pushlong #getSoundOut	_SendRequest	bcs @exit;;;	pea sendToName+stopAfterOne;;;	pushlong #myReqProcName*** 24-Jan-92 DAL	pea srqPlayrSoundSample	pea stopAfterOne	ldx #0	phx	phx	pushlong soundOutHandle;;;	pushlong #playSoundOut	phx	phx*** end 24-Jan-92	_SendRequest;;; On 2nd thought, this isn't actually needed--we're playing the sound because they;;; just now assigned it to something, so we won't want to dispose of it.;*** added 19-Nov-91 DAL -- if necessary, dispose of the sound handle, after it stops;	lda soundOutFlags;	bpl @noDispose;;	pea srqSynchronize;	pea sendToAll;	ldx #0;	phx;	phx	;target=nil;	phx;	phx	;in=nil;	phx;	phx	;out=nil;	_SendRequest;;	pushlong soundOutHandle;	_DisposeHandle;	stz soundOutHandle+1;@noDispose;*** end 19-Nov-91@exit	rts@stdBeepmakeStandardBeep	pea srqMakeStdBeep	pea sendToName+stopAfterOne	pushlong #myReqProcName	lda #0	pha	pha	;data in	pha	pha	;data out	_SendRequest	rtsgetSoundOut	dc.w 0soundOutHandle	dc.l 0soundOutFlags	dc.w 0;;;playSoundOut	dc.w 0**************************************************************************************************************************************************** doClose** Unlock the soundsHandle**************************************************************************doClose	name	jsr SaveSettings	pushlong soundsHandle	_HUnlock	rts**************************************************************************************************************************************************;; doInit - init sound controls.;; entry	aug_param = battery parameter byte containing closed captioning flag.;	data1 = ptr to window.;	maxpitch = max pitch used on the GS.;; exit	sound controls are initialized.;*************************************************************************doInit	name	jsr GetCurrentVolume	sta curvol	jsr GetCurrentPitch	sta curpitch	pushl #HandleVolumeControl	lda #volumeControlID	jsr GetControlByID	_SetCtlAction	;set Volume action proc	pushl #HandlePitchControl	lda #pitchControlID	jsr GetControlByID	_SetCtlAction	;set Pitch action proc	pushw curvol	lda #volumeControlID	jsr GetControlByID	_SetCtlValue	lda curpitch	pha	lda #pitchControlID	jsr GetControlByID	_SetCtlValue;; Build the Sound menu;	jsr BuildSoundPopUp	jsr hitEventPopUp	;set corresponding Sound item;; Set up the "visual indication of sounds" bit from battery RAM;	ldx #aug_param	jsr ReadBatteryParam	and #1	;isolate the bit	sta ccflag	;added 30-Oct-91 DAL	eor #1	;invert the value	pha	;value to set in checkbox	lda #visualControlID	jsr GetControlByID	_SetCtlValue	rts*************************************************************************** GetControlByID** Input: A=control ID (for a control in the <data1 window)** Output: control handle on stack**************************************************************************GetControlByID	name	pha	pha	;space	pei <data1+2	pei <data1	;window ptr	pea 0	pha	;control ID	_GetCtlHandleFromID	ply	pla	plx	;return address	pha	phy	phx	;return address	rts*************************************************************************;; GetCurrentPitch;; entry	maxpitch = maximum pitch value.;	pitch_param = battery parameter containing pitch.;; exit	(a) = current pitch;	If the pitch is somehow greater than the maximum pitch;	it will reset the battery parameter to the maximum.;*************************************************************************GetCurrentPitch	name	ldx #pitch_param	jsr ReadBatteryParam	cmp #maxpitch	bcc gcp1	;if ok value	lda #maxpitch	ldx #pitch_param	jsr WriteBatteryParam	lda #maxpitch	;restore current pitchgcp1	rts*************************************************************************;; GetCurrentVolume;; entry	maxvol = maximum volume allowed.;	volume_param = battery parameter containing volume.;; exit	(a) = current volume.;	If the volume is somehow greater than the maximum volume;	it will reset the battery parameter to the maximum.;*************************************************************************GetCurrentVolume	name	ldx #volume_param	jsr ReadBatteryParam	sta curvol	cmp #maxvol	bcc gcv1		;if ok volume	lda #maxvol	ldx #volume_param	jsr WriteBatteryParamgcv1	lda curvol	rts*************************************************************************;; HandlePitchControl;; entry	(curpitch) = current pitch.;	[handleid,s] = handle of control that was hit.;	maxpitch = maximum pitch used on the GS.;	(part,s) = part of control that was hit.;	pitch_param = battery parameter that controls pitch for;	SysBeep.;;	Called by control manager.;; exit	curpitch is adjusted, ctlvalue is adjusted,;	and appropriate sound is made.;*************************************************************************HandlePitchControl	name	phb	phk	plb	lda part,s*** added 28-Oct-91 DAL -- if part=0, make no sound (avoids double beep sometimes)	beq makeNoSound1*** end 28-Oct-91	cmp #6	;scroll arrow	bne hpc1	lda curpitch	cmp #maxpitch	bcs hpc5	;if already the highest possible	inc a	bra hpc4hpc1	cmp #5	;scroll arrow	bne hpc2	lda curpitch	beq hpc5	;if already the lowest possible	dec a	bra hpc4hpc2	cmp #8	bne hpc3	;if not page up	lda curpitch	cmp #maxpitch	bcs hpc5	;if max possible	inc a	cmp #maxpitch	bcs hpc4	;if max possible	inc a	bra hpc4hpc3	cmp #7	;page region	bne hpc6	lda curpitch	beq hpc5	;if lowest possible	dec a	beq hpc4	;if lowest possible	dec ahpc4	sta curpitchhpc5	lda curpitch	pha	;new pitch	lda handleid+2+2,s	;hi word of handleid	pha	lda handleid+4,s	;lo word of handleid	pha	_SetCtlValuehpc6	pha	lda handleid+2+2,s	pha	lda handleid+4,s	pha	_GetCtlValue	pla	sta curpitch	ldx #pitch_param	jsr UpdateASetting	jsr makeStandardBeepmakeNoSound1	plb	;restore data bank	lda 1,s	sta 7,s	lda 2,s	sta 8,s	ply	ply	ply	rtl*************************************************************************;; HandleVolumeControl;; entry	(curvol) = current volume.;	[handleid,s] = handle of control that was hit.;	maxvol = maximum volume level on the GS.;	(part,s) = part of control that was hit.;	volume_param = battery parameter that controls system volume.;;	called by control manager.;; exit	curpitch is adjusted, ctlvalue is adjusted,;	and appropriate sound is made.;*************************************************************************HandleVolumeControl	name	phb	phk	plb	lda part,s*** added 28-Oct-91 DAL -- if part=0, make no sound (avoids double beep sometimes)	beq makeNoSound*** end 28-Oct-91	cmp #5	bne hvc1	;if not hit in scroll bar up arrow	lda curvol	beq hvc5	;if already the lowest possible	dec a	bra hvc4hvc1	cmp #6	bne hvc2	;if not in scroll bar down arrow	lda curvol	cmp #maxvol	beq hvc5	;if already the highest possible	inc a	bra hvc4hvc2	cmp #7	bne hvc3	;if not page up	lda curvol	beq hvc5	;if lowest possible	dec a	beq hvc4	;if lowest possible	dec a	bra hvc4hvc3	cmp #8	bne hvc5a	;if tracking the thumb	lda curvol	cmp #maxvol	beq hvc5	;if max possible	inc a	cmp #maxvol	beq hvc4	;if max possible	inc ahvc4	sta curvolhvc5	pha	;new value	lda handleid+2+2,s	;hi word of handleid	pha	lda handleid+4,s	;lo word of handleid	pha	_SetCtlValuehvc5a	pha	lda handleid+2+2,s	pha	lda handleid+4,s	pha	_GetCtlValue	pla	sta curvolhvc6	lda curvol	ldx #volume_paramhvcE	jsr UpdateASetting	_SysBeepmakeNoSound	plb	;restore data bank	lda 1,s	sta 7,s	lda 2,s	sta 8,s	ply	ply	ply	rtl*************************************************************************;; ReadBatteryParam;; entry	(x) = parameter to read.;; exit	(a) = value of parameter.;*************************************************************************ReadBatteryParam	name	pha	;space for result	phx	;parameter to read	_ReadBparam	pla	;get value	rts*************************************************************************;; UpdateASetting;; entry	(a) = value of parameter to set.;	(x) = battery parameter to set.;; exit	battery parameter is set and a sysbeep;	is made based on the new settings.;*************************************************************************UpdateASetting	name	jsr WriteBatteryParam	phb	;save data bank	pea 0	plb	plb	php	;save processor status	sep #$30	;set everything short	sec	;set so slots will NOT be changed	jsl $e10094	;jsl to 'tobramsetup' entrypoint	plp	;restore processor status	plb	;restore data bank	rts*************************************************************************;; WriteBatteryParam;; entry	(a) = value of parameter to set.;	(x) = battery parameter to set.;; exit	battery parameter is set.;*************************************************************************WriteBatteryParam	name	pha	;new value	phx	;parameter to set	_WriteBparam	rts*************************************************************************;; global data;*************************************************************************ccflag	ds.b 2	;closed captioning flagcurvol	ds.b 2	;current volumecurpitch	ds.b 2	;current pitch*************************************************************************** InstallReqProc -- install our AcceptRequests procedure** And, while we're at it, install our BELLVECTOR patch, too.** (return SEC if error)**************************************************************************InstallReqProc	name	pha	pha	;space for GetCodeResConverter	_GetCodeResConverter	pea rCodeResource	pea $0001	;log flags (application, in)	_ResourceConverter	pha	pha	;space for LoadResource	pea rCodeResource	pea 0	pea 1	;ID=1	_LoadResource	bcc @1	brl @oops@1	phd	;deref proc handle	tsc	tcd	ldy #2	lda [3],y	sta procPtr+2	lda [3]	sta procPtr	pld	pla	sta procHandle	pla	sta procHandle+2	pea rCodeResource	pea 0	pea 1	;ID=1	_DetachResource	pha	;space for SetHandleID result	pha	;space for GetNewID result	pea $5E00	_GetNewID	lda 1,s	sta myProcMemID	lda procHandle+2	pha	lda procHandle	pha	_SetHandleID	pla	;ignore old id	pushlong #myReqProcName	lda myProcMemID	pha	lda procPtr+2	pha	lda procPtr	pha	_AcceptRequests*** added 5-Nov-91 DAL -- say hello to our request proc	pea srqHelloWorld	pea sendToName+stopAfterOne	pushlong #myReqProcName	ldx #0	phx	phx	;dataIn = NIL	phx	phx	;dataOut = NIL	_SendRequest*** end 5-Nov-91*** added 30-Oct-91 DAL -- install BELLVECTOR patch (2nd BRL in code resource)	pha	pha	;space	pea $001B	_GetVector	pla	sta ChainBellVector+1	pla	sep #$20	sta ChainBellVector+3  ;fed to ReqProc when we call SetSoundGlobals	rep #$20	pea $001B	lda procPtr+2	pha	lda procPtr	clc	adc #3	pha	_SetVector*** end 30-Oct-91	rts	;return with SEC if error@oops	plx	plx	_SysBeep	sec	rtsprocHandle	dc.l 0procPtr	dc.l 0myReqProcName	str 'Apple~SoundCP~'*************************************************************************** Get/SetSoundGlobals** Input: AY = handle to sound configuration** Informs the request procedure of the new handle.**************************************************************************GetSoundGlobals	name	pea srqGetSoundGlobals	bra getOrSetSetSoundGlobals	name	pea srqSetSoundGlobalsgetOrSet	pea sendToName+stopAfterOne	pushlong #myReqProcName	pushlong #GLOBALS	pea 0	pea 0	;dataOut = NIL	_SendRequest	rts*************************************************************************** MakeEmptyConfigHandle**************************************************************************MakeEmptyConfigHandle name	stz configIsDirty	ldx #2	ldy #0	;size of empty tagged-strings structure = 2MakeConfigHandleYX	pha	pha	;space for NewHandle	phy	phx	lda myProcMemID	pha	pea 0	;unlocked	pha	pha	;ignored	_NewHandle;@@@ (later) needs error check	lda 1,s	sta configHandle	lda 3,s	sta configHandle+2	phd	tsc	tcd	ldy #2	lda [3]	tax	lda [3],y	sta <5	stx <3	lda #0	sta [3]	pld	pla	pla	rts*************************************************************************** SetConfigMapping** Input: A = event to add to configHandle*        resNameBuffer = name to add**************************************************************************SetConfigMapping	name	sta @mapping	jsr RemoveMappingA	lda resNameBuffer	and #$00ff	bne @notNull	;just omit null mappings	rts@notNull	phd	pushlong configHandle	tsc	tcd@temp	equ 1	pha	pha	;space for GetHandleSize	pushlong configHandle	_GetHandleSize	clc	lda resNameBuffer	and #$00ff	adc #3	adc 1,s	tax	lda 3,s	adc #0	pha	phx	pei <@temp+2	pei <@temp	_SetHandleSize	ldy #2	lda [<@temp]	tax	lda [<@temp],y	sta <@temp+2	stx <@temp	lda [<@temp]	inc a	sta [<@temp]	;incremented the mapping count	clc	pla	adc <@temp	sta <@temp	pla	adc <@temp+2	sta <@temp+2	lda @mapping	sta [<@temp]	pushlong #resNameBuffer	clc	lda <@temp	adc #2	tax	lda <@temp+2	adc #0	pha	phx	pea 0	lda resNameBuffer	and #$00ff	inc a	pha	_BlockMove	ply	ply	pld	lda #1	sta configIsDirty	rts@mapping	dc.w 0*************************************************************************** RemoveMappingA** Input:  A = event code to remove from configHandle**************************************************************************RemoveMappingA	name	sta @mapping	phd	pushlong configHandle	pushlong configHandle	tsc	tcd@temp	equ 1@ptr	equ @temp+4	ldy #2	lda [<@temp]	tax	lda [<@temp],y	sta <@temp+2	stx <@temp	sta <@ptr+2	stx <@ptr	lda [<@temp]	sta @count	bne @noFail	brl @fail@noFail	lda #2	jsr @bumpTemp@search	lda [<@temp]	cmp @mapping	beq @gotIt	brl @next@gotIt	lda #1	sta configIsDirty	lda [<@ptr]	dec a	sta [<@ptr]	;decrement mapping count; bring the remainder of the handle forward to close gap	clc	ldy #2	lda [<@temp],y	and #$00ff	inc a	inc a	inc a	sta @deltaSize	adc <@temp	tax	lda <@temp+2	adc #0	pha	phx	;source = temp+sizeof(rec)	pei <@temp+2	pei <@temp	;dest; size = (start+HandleSize) - source	pha	pha	pushlong configHandle	_GetHandleSize	clc	pla	adc <@ptr	tax	pla	adc <@ptr+2	tay	;high word	txa	sec	sbc 5,s	tax	tya	sbc 7,s	;subtracted source	pha	phx	;pushed length	_BlockMove; shrink the handle by deltaSize	pha	pha	pushlong configHandle	_GetHandleSize	sec	pla	sbc @deltaSize	tax	pla	sbc #0	pha	phx	pushlong configHandle	_SetHandleSize	bra @done@next	ldy #2	lda [<@temp],y	and #$00ff	inc a	inc a	inc a	jsr @bumpTemp	dec @count	beq @done	brl @search@done@fail	ply	ply	ply	ply	pld	rts@bumpTemp	clc	adc <@temp	sta <@temp	bcc @1	inc <@temp+2@1	rts@count	dc.w 0@mapping	dc.w 0@deltaSize	dc.w 0**************************************************************************************************************************************************** These globals are shared with the request procedure.  This buffer* must match the one there!**************************************************************************GLOBALSconfigHandle	dc.l 0	;CDev copy of configHandlesoundsHandle	dc.l 0	;CDev copy of soundsHandlemyProcMemID	dc.w 0ChainBellVector	jml >$777777	;JML to old BellVector value*************************************************************************configIsDirty	dc.w 0	endp	end