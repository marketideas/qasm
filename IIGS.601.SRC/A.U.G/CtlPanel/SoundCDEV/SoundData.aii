*******************************************************************;; SoundData - data for the Sound CDEV.;; Michael V. Stein	03/21/90.;; © Copyright Apple Computer, 1990.;; 9-Mar-91 DAL--added 'g' and 'G' key equivs to check box;; DAL--moved most of this stuff to the .r file (control templates);; 30-Oct-91 DAL;   Edited the help text to for sound-remapping features.;*******************************************************************	blanks off	string ASISsoundAbout	PROC EXPORT	dc.w 8	dc.l 1	dc.w 38,5,138,280	dc.l $81000000	dc.w $0000	dc.w $1000	dc.l 0	dc.l TheText	dc.w EndText-TheText	string asisTheText	dc.b 'The Sound Control Panel lets you change the pitch of the '	dc.b 'standard beep and the volume of all sounds.',13,13;	dc.b 'The check box is for use with software applications that can ';	dc.b 'provide visual cues to substitute for sound.'	dc.b 'To assign a sound to an event, first choose the event from '	dc.b 'the Event menu, and then choose a sound from the Sound '	dc.b 'menu.  Sounds are stored in the Sounds folder inside the '	dc.b 'System folder.'EndText	string pascal	ENDP	END