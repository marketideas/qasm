***********************************************************************************                                                                                **	Format tables for the time/date input control for auto-selection.      **                                                                                **	Copyright Apple Computer Inc. 1989  ALL RIGHTS RESERVED                **                                                                                **                                                                                ******************************************************************************************	REVISION HISTORY:	******************************************************	September 5, 1989	Monte Benaresh**		Created this file.***********************************************************************************		export format1format1		PROCtable_start**************************************************************	equates for the format of the display string      **************************************************************;	the display string is Pascal style and looks like this ("_" indicates space character):;;		AUG_29_1989__10:20:43_AM;		|   |  |     |  |  |  |;		|   |  |     |  |  |  am_pm_offset (if selected at run time);		|   |  |     |  |  |;		|   |  |     |  |  second_offset (if selected at assembly time);		|   |  |     |  |;		|   |  |     |  minute_offset;		|   |  |     |;		|   |  |     hour_offset;		|   |  |;		|   |  year_offset;		|   |;		|  day_offset;		|;		|;		month_offset		; equates for these offsets into a Pascal string:month_offset	equ 1month_end		equ month_offset	+ 3day_offset	equ month_end	+ 1day_end		equ day_offset	+ 2year_offset	equ day_end	+ 1year_end		equ year_offset	+ 4hour_offset	equ year_end	+ 2hour_end		equ hour_offset	+ 2minute_offset	equ hour_end	+ 1minute_end	equ minute_offset	+ 2		if seconds = 1 thensecond_offset	equ minute_end	+ 1	;include seconds fieldsecond_end	equ second_offset	+ 2		elsesecond_end	equ minute_end		;exclude seconds field		endifam_pm_offset	equ second_end	+ 1am_pm_end		equ am_pm_offset	+ 2string_size	dc.w am_pm_end		;this doesn't include the length bytepart_left				;table of left character positions by part code				;must subtract 1 because they are byte positions…				;…in a Pascal string		dc.w month_offset-1		dc.w day_offset-1		dc.w year_offset-1		dc.w hour_offset-1		dc.w minute_offset-1		if seconds = 1 then		dc.w second_offset-1	;insert entry if seconds requested		endif		dc.w am_pm_offset-1part_right			;table of right character positions by part code		dc.w month_end-1		dc.w day_end-1		dc.w year_end-1		dc.w hour_end-1		dc.w minute_end-1		if seconds = 1 then		dc.w second_end-1	;insert entry if seconds requested		endif		dc.w am_pm_end-1part_next				;table of each part's right neighbor		dc.w part_day	;month		dc.w part_year	;day		dc.w part_hour	;year		dc.w part_minute	;hour		if seconds = 1 then		;include seconds		dc.w part_second	;minute		dc.w part_am_pm	;second		else			;exclude seconds		dc.w part_am_pm	;minute		endif		dc.w 0		;am/pm field has no right neighborpart_prev				;table of each part's left neighbor		dc.w 0		;month has no left neighbor		dc.w part_month	;day		dc.w part_day	;year		dc.w part_year	;hour		dc.w part_hour	;minute		if seconds = 1 then		dc.w part_minute	;seconds		dc.w part_second	;am/pm		else		dc.w part_minute	;am/pm		endiffirst_field	dc.w part_monthlast_field	dc.w part_am_pmtable_end		export table_length:equtable_length	equ table_end - table_start		ENDP		export format2format2		PROC;		import table_lengthtable_start2**************************************************************	equates for the format of the display string      **************************************************************;	the display string is Pascal style and looks like this ("_" indicates space character):;;		29_AUG_1989__10:20:43_AM;		|  |   |     |  |  |  |;		|  |   |     |  |  |  am_pm_offset;		|  |   |     |  |  |;		|  |   |     |  |  second_offset;		|  |   |     |  |;		|  |   |     |  minute_offset;		|  |   |     |;		|  |   |     hour_offset;		|  |   |;		|  |   year_offset;		|  |;		|  month_offset;		|;		|;		day_offset		; equates for these offsets into a Pascal string:day_offset	equ 1day_end		equ day_offset	+ 2month_offset	equ day_end	+ 1month_end		equ month_offset	+ 3year_offset	equ month_end	+ 1year_end		equ year_offset	+ 4hour_offset	equ year_end	+ 2hour_end		equ hour_offset	+ 2minute_offset	equ hour_end	+ 1minute_end	equ minute_offset	+ 2		if seconds = 1 thensecond_offset	equ minute_end	+ 1	;include seconds fieldsecond_end	equ second_offset	+ 2		elsesecond_end	equ minute_end		;exclude seconds field		endifam_pm_offset	equ second_end	+ 1am_pm_end		equ am_pm_offset	+ 2string_size	dc.w am_pm_end		;this doesn't include the length bytepart_left				;table of left character positions by part code				;must subtract 1 because they are byte positions…				;…in a Pascal string		dc.w month_offset-1		dc.w day_offset-1		dc.w year_offset-1		dc.w hour_offset-1		dc.w minute_offset-1		if seconds = 1 then		dc.w second_offset-1	;insert entry if seconds requested		endif		dc.w am_pm_offset-1part_right			;table of right character positions by part code		dc.w month_end-1		dc.w day_end-1		dc.w year_end-1		dc.w hour_end-1		dc.w minute_end-1		if seconds = 1 then		dc.w second_end-1	;insert entry if seconds requested		endif		dc.w am_pm_end-1part_next				;table of each part's right neighbor		dc.w part_year	;month		dc.w part_month	;day		dc.w part_hour	;year		dc.w part_minute	;hour		if seconds = 1 then		;include seconds		dc.w part_second	;minute		dc.w part_am_pm	;second		else			;exclude seconds		dc.w part_am_pm	;minute		endif		dc.w 0		;am/pm field has no right neighborpart_prev				;table of each part's left neighbor		dc.w part_day	;month		dc.w 0		;day has no left neighbor		dc.w part_month	;year		dc.w part_year	;hour		dc.w part_hour	;minute		if seconds = 1 then		dc.w part_minute	;seconds		dc.w part_second	;am/pm		else		dc.w part_minute	;am/pm		endiffirst_field	dc.w part_daylast_field	dc.w part_am_pmtable_end2table_length2	equ table_end2 - table_start2	if (table_length2 = table_length) goto .ok	aerror '### ERROR: Time/date control format tables not of equal length'.ok	anop		ENDP		if table3 = 1 then		;assemble last table only if…					;…option is set		export format3format3		PROC;		import table_lengthtable_start3**************************************************************	equates for the format of the display string      **************************************************************;	the display string is Pascal style and looks like this ("_" indicates space character):;;		1989_AUG_29__10:20:43_AM;		|    |   |   |  |  |  |;		|    |   |   |  |  |  am_pm_offset;		|    |   |   |  |  |;		|    |   |   |  |  second_offset;		|    |   |   |  |;		|    |   |   |  minute_offset;		|    |   |   |;		|    |   |   hour_offset;		|    |   |;		|    |   month_offset;		|    |;		|    day_offset;		|;		|;		year_offset		; equates for these offsets into a Pascal string:year_offset	equ 1year_end		equ year_offset	+ 4month_offset	equ year_end	+ 1month_end		equ month_offset	+ 3day_offset	equ month_end	+ 1day_end		equ day_offset	+ 2hour_offset	equ day_end	+ 2hour_end		equ hour_offset	+ 2minute_offset	equ hour_end	+ 1minute_end	equ minute_offset	+ 2		if seconds = 1 thensecond_offset	equ minute_end	+ 1	;include seconds fieldsecond_end	equ second_offset	+ 2		elsesecond_end	equ minute_end		;exclude seconds field		endifam_pm_offset	equ second_end	+ 1am_pm_end		equ am_pm_offset	+ 2string_size	dc.w am_pm_end		;this doesn't include the length bytepart_left				;table of left character positions by part code				;must subtract 1 because they are byte positions…				;…in a Pascal string		dc.w month_offset-1		dc.w day_offset-1		dc.w year_offset-1		dc.w hour_offset-1		dc.w minute_offset-1		if seconds = 1 then		dc.w second_offset-1	;insert entry if seconds requested		endif		dc.w am_pm_offset-1part_right			;table of right character positions by part code		dc.w month_end-1		dc.w day_end-1		dc.w year_end-1		dc.w hour_end-1		dc.w minute_end-1		if seconds = 1 then		dc.w second_end-1	;insert entry if seconds requested		endif		dc.w am_pm_end-1part_next				;table of each part's right neighbor		dc.w part_day	;month		dc.w part_hour	;day		dc.w part_month	;year		dc.w part_minute	;hour		if seconds = 1 then		;include seconds		dc.w part_second	;minute		dc.w part_am_pm	;second		else			;exclude seconds		dc.w part_am_pm	;minute		endif		dc.w 0		;am/pm field has no right neighborpart_prev				;table of each part's left neighbor		dc.w part_year	;month		dc.w part_month	;day		dc.w 0		;year has no left neighbor		dc.w part_day	;hour		dc.w part_hour	;minute		if seconds = 1 then		dc.w part_minute	;seconds		dc.w part_second	;am/pm		else		dc.w part_minute	;am/pm		endiffirst_field	dc.w part_yearlast_field	dc.w part_am_pmtable_end3table_length3	equ table_end3 - table_start3	if (table_length3 = table_length) goto .ok	aerror '### ERROR: Time/date control format tables not of equal length'.ok	anop		ENDP		endif		;from option controlled by "table3"