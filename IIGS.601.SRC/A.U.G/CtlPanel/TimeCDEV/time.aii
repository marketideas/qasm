;;;	time - time CDEV.;;	Michael V. Stein	03/30/90.;;	© Apple, 1990.	blanks	off	;;	equates.aug_param  equ	$5e		bit 0 set means no closed captioning				;bit 1 set means standard time				;      clear if daylight savings time				;bit 2 set means not to have auto daylight savings				;      clear means to have auto daylight savings				;bit 3 and 4 are the amount of menublink to have	radio1ID  equ	10radio4ID  equ	radio1ID+3	ID of 4th radio controlradio6ID  equ	radio4ID+2	ID of 6th radio controlcheckID	equ	radio6ID+2	ID of checkbox;	time/date control infoTDCtlRec	RECORD  0		;record for the Time/Date controlctlNext		ds.l  1ctlOwner	ds.l  1ctlRect		ds.w  4ctlFlag		ds.b  1ctlHilite	ds.b  1ctlValue	ds.w  1ctlProc		ds.l  1ctlAction	ds.l  1ctlData		ds.l  1ctlRefCon	ds.l  1ctlColor	ds.l  1ctlReserved	ds.b  16ctlID		ds.l  1ctlMoreFlags	ds.w  1		;bit 0 = 1 --> 24 hour format				;bit 1 = 1 --> control currently dimmedctlVersion	ds.w  1		;control-specific fieldsdateRec		ds.b 8		;GS/OS time/date recordcwidth		ds.w 1		;width of each character in the stringarrowPos	ds.w 1		;pixel position of arrows relative to control rectcurrPart	ds.w 1		;currently active part (string field)formatRef	ds.w 1		;pointer to format tabledrawFlag	ds.w 1		;flag to tell us not to draw twice when we get shownctlSizectlKey1		equ ctlReservedctlKey2		equ ctlKey1+1ctlKeyMods	equ ctlKey2+1ctlKeyModsCareBits	equ ctlKeyMods+2ctlJust		equ ctlReserved		ENDR		;;	include files.	include	'::cdev.h'	include	'::commonmacros.h'	include	'::dp.h'	include	'e16.control'	include	'e16.event'	include	'm16.control'	include	'm16.event'	include	'm16.intmath'	include	'm16.menu'	include	'm16.misctool'	include	'm16.quickdraw'	include	'm16.util2'	include	'm16.window'	;;	main program.main	proc;;	imported addresses.	import	about	import	ctllist	import	dayctl	import	daylen	import	dctl	import	tctl	;;	exported addresses.	export	cdsatime	phb			save calling data bank	phk	plb			set our data bank		;	make room on stack for direct page.	tsc				sec				sbc	#dpsize		make room on stack for new direct page	tcs				phd			save the current direct page	tcd			new direct page	lda	message		cmp	#12			bcs	time1		if message defintely not handled			asl	a		times 2 into word table	tax			move into index reg	jsr	(t_cdev-2,x)	call the handler of this messagetime1  	pld			restore direct page	tsc	clc	adc	#dpsize			tcs			reset the stack	lda	1,s		Bump the stack up to prepare	sta	11,s		to take off the 3 parameters	lda	3,s			sta	13,s	pla			get rid of message space		pla			get rid of data1 space	pla					pla			get rid of data2 space	pla					lda	#$0		return 0 to caller	sta	5,s	sta	7,s			plb		rtl		t_cdev	dc.w	cccE		handle machine message - ignored	dc.w	cccE		handle boot message - ignored	dc.w	cccE		reserved - ignored	dc.w	icc		init cdev controls	dc.w	ctc		close the cdev	dc.w	hem		handle event message	dc.w	ccc		create cdev controls	dc.w	ham		handle about message	dc.w	cccE		handle rectangle message - ignored	dc.w	hhm		handle hit message	dc.w	rtc		handle run message;;	ccc - create cdev controls.;;	entry	(ctllist..) = pointers to most of the controls.;		[data1] = window pointer.;		(dayctl..) = day of year control template.;		(dctl..) = date control template.;		(tctl..) = time control template.;;	exit	controls are created.ccc	jsr	cds		create day of year string	pha	pha			space for result	pushl	data1		window ptr	pushw	#0		next item is a ptr	pushl	#dayctl	_NewControl2	pulll	dayhdl		handle to day of year control	pha	pha			space for result	pushl	data1		window ptr	pushw	#0		next item is a ptr	pushl	#dctl	_NewControl2	pulll	dhdl		handle to date control		pha	pha			space for result	pushl	data1		window ptr	pushw	#0		next item is a ptr	pushl	#tctl	_NewControl2	pulll	thdl		handle to time control		pha			space for result	pha	pushl	data1		window pointer	pushw	#3		next item is a ptr to a list of template pointers	pushl	#ctllist	_NewControl2	pla	pla			don't care about result	cccE	rts;;	ctc - close the cdev.;;	entry	none.;;	exit	updates the time and date and exits.ctc	jmp	utd		update time and date and return				;;	ham - handle about message.;;	entry	[data1] = window pointer.;		(about..) = template for about screen.;;	exit	The About control is created.ham	pha			space for result	pha	pushl	data1		window pointer	pushw	#0		next item is a ptr to a template	pushl	#about	_NewControl2	pla	pla			don't care about result	rts;;	hem - handle event message.;;	entry	[dhdl] = handle to date control.;		[data1] = ptr to event record.;		(readyF) = 0 if the controls are initialized.;		[wptr] = window pointer.;;	exit	if the user types something and there is a target control;		the control is given the event, everything us updated and;		the event is turned into a null event.  We process it here;		since TaskmasterDA is way too slow to use for something that;		occurs as often as a human typing a key.hem0	rtshem	lda	readyF	bne	hem0		if controls not initialized yet			ldy	#owhat	lda	[data1],y	get what type of event occurred	cmp	#keyDownEvt	beq	hem1		if user typed something	cmp	#autoKeyEvt	bne	hem0		if not an auto key event then return	hem1	ldy	#omessage	lda	[data1],y	sta	eventrec+2	pha			space for result	pushw	#$ffff		send to target only	pushl	wptr		window ptr	pushl	#eventrec	_SendEventtoCtl	pla			get result from stack		pha	pha	_FindTargetCtl	pla			low word	plx			high word		cmp	dhdl	bne	hem4		if not date handle	cpx	dhdl+2	bne	hem4		if not date handle	jsr	udy		update day of year		hem2	;jsr	sdc		set daylight controls 	jsr	udo		update date only	bra	hem5hem4	jsr	utd		update time and datehem5	jsr	sdc		set daylight controls	lda	#nullEvt	ldy	#owhat	sta	[data1],y	remove the eventhem6	rts;;	hhm - handle hit message.;;	entry	[data1] = handle to control that was hit.;		[data2] = id of control that was hit.;;	exit	battery parameter locations are updated.hhm	lda	data2		id of control	cmp	#radio1ID	bcs	hhm1		if radio control	jmp	hhm12			hhm1	pha	jsr	utd		update time and date	lda	thdl	ldx	thdl+2	jsr	dts		disable target status		lda	dhdl	ldx	dhdl+2	jsr	dts		disable target status		pla	cmp	#radio4ID	bcs	hhm2		if not first family of radio buttons	sbc	#radio1ID-1	(c) clear	ldx	#$34		battery paramater for date format	jmp	udf		update display formats		hhm2	cmp	#radio6ID	bcs	hhm3		if not the time format	sbc	#radio4ID-1	(c) clear	ldx	#$35		parameter for ampm/military format	jmp	udf		update display format and return		hhm3	cmp	#checkID	bcs	hhm7		if the auto daylight checkbox	cmp	format	beq	hhm6		if the same as before	sta	format		ldx	#aug_param	jsr	rbp		read battery parameter	sta	w1		save for now	ldy	#2		assume standard time	lda	data2	cmp	#radio6ID	beq	hhm4		if set to standard time		ldy	#$0		flag that it is daylight timehhm4	sty	w2	lda	w1	and	#%11111101	reset to daylight time	ora	w2		set daylight/standard time as appropriate	ldx	#aug_param	jsr	wbp		write battery parameter and return	lda	#3600	ldx	#^3600	ldy	w2	beq	hhm5		if selected daylight time	lda	#-3600	ldx	#^-3600hhm5	jsr	ats		adjust the time by seconds	lda	thdl	ldx	thdl+2	jsr	itd		init time and date		lda	dhdl	ldx	dhdl+2	jsr	itd		init time and date 		pushl	thdl	_DrawoneCtlhhm6	rtshhm7	ldx	#aug_param	jsr	rbp		read battery param	sta	w1		save for now	pha			space for result	pushl	data1		handle of checkbox control	_GetCtlValue		ldy	#0		assume auto daylight savings	plx		bne	hhm8		if auto daylight savings	ldy	#4hhm8	sty	w2	lda	w1	and	#%11111011	reset to auto daylight savings	ora	w2		set auto daylight / manual daylight as appropriate	ldx	#aug_param	jsr	wbp		write battery parameter	lda	w2	bne	hhm10		if not auto daylight savings		lda format		;get current standard/daylight setting	pha			;save for after call	jsr	sdc		set daylight controls	pla			;get old format	cmp format		;new format different?	beq @no_fmt_change@changed		;adjust hour based on change	lda	#3600	ldx	#^3600	ldy format		;what is new format?	cpy #radio6ID+1		;daylight time?	beq	@daylight	if selected daylight time	lda	#-3600	ldx	#^-3600@daylight	jsr	ats		adjust the time by seconds@no_fmt_change;	;bcc	hhm10		if ok;	;cpx	#radio6id;	;beq	hhm9		if switching from daylight to standard time;	;jmp	sah		spring ahead an hour and return;	;hhm9	;jmp	fbh		fall back an hour and return	hhm10	jmp	urc		update radio controls and returnhhm12	cmp	#5	bne	hhm13		if not the days left	lda	thdl	ldx	thdl+2	jsr	dts		disable target status		lda	dhdl	ldx	dhdl+2	jsr	dts		disable target status	lda	dispF	eor	#1	sta	dispF	lda	#$ffff	jsr	cdsE		create day string - always	pushw	daylen	pushl	dayhdl	_SetCtlValue	pushl	dayhdl	_DrawOneCtl	rts		hhm13	cmp	#2	bne	hhm15		if not date control	jsr	udo		update date only		hhm14	jsr	udy		update day of year	bra	hhm16		hhm15	jsr	utd		update time and date	hhm16	pha	pushl	checkhdl	_GetCtlValue	pla;	beq	hhm17		if not auto daylight	jmp	sdc		set daylight controls nd returnhhm17	rts;;	icc - init cdev controls.;;	entry	[data1] = window pointer.;		;	exit	[checkhdl] = handle of Auto Daylight savings checkbox control.;		[radio6hdl] = handle to control for standard time button.;		[radio7hdl] = handle to control for daylight time button.;		(readyF) = 0.;		[wptr] = window pointer.;		controls are intialized to the battery settings.icc	lda	data1		save window pointer for later	sta	wptr	lda	data1+2	sta	wptr+2		ldx	#$35		parameter for ampm/24 hour format	jsr	rbp		read battery parameter	clc	adc	#radio4ID	tax			id of control to set	lda	#1		value to set the radio button	jsr	scv		set control value			ldx	#$34		battery parameter for date format	jsr	rbp		read battery parameter	clc	adc	#radio1ID	tax	lda	#1		value to set the radio button	jsr	scv		set control value	pha	pha			space for result	pushl	data1		window ptr	pushl	#radio6ID	ID of control	_GetCtlHandleFromID	pulll	radio6hdl		pha	pha			space for result	pushl	data1		window ptr	pushl	#radio6ID+1	ID of control	_GetCtlHandleFromID	pulll	radio7hdl			pha			space for getctlhandle call	pha			space for getctlhandle call		pushl	data1		window pointer	pushl	#checkid	id of control	_GetCtlHandleFromID	pulll	checkhdl	lda	thdl	ldx	thdl+2	jsr	itd		init time and date		lda	dhdl	ldx	dhdl+2	jsr	itd		set time and date 		ldx	#aug_param	jsr	rbp		read battery parameter	and	#$4	bne	icc1		if not auto daylight time		lda	#1	ldx	#checkID	checkbox ID	jsr	scv		set control value	jsr	sdcE		set daylight controls - forced	jsr	urc		update radio controls (dim them)	bra	icc3		finish things upicc1	ldx	#aug_param	jsr	rbp		read battery parameter	ldx	#radio6ID	assume standard time	and	#$2	bne	icc2		if standard time	inx			set daylight timeicc2	lda	#1	jsr	scv		set control valueicc3	stz	readyF	pha	pushl	radio6hdl	_GetCtlValue	ldx	#radio6id	assume standard time	pla	bne	icc4		if standard time is set	inx			daylight time is seticc4	stx	format	icc_setrect			;set rect to erase when switching hour display	lda	thdl	ldx	thdl+2	jsr	dah		dereference a handle	ldy #TDCtlRec.ctlRect+6	;start at last point in rect	ldx #6@rect_loop	lda [l2],y		;access ctl record	clc	adc erase_offsets,x	;signed add to get our rect to erase	sta erase_rect,x	dey	dey	dex	dex	bpl @rect_loop	rtserase_offsets			;offsets to modify ctl rect to get rect…				;…we erase when switching hour format	dc.w 0,75,0,25;;	rtc - run the cdev.;;	entry	[wptr] = window pointer.;;	exit	if the controls aren't being editted and they have;		changed, then they are updated and redisplayed.rtc0	rtsrtc	pha	pha	_FrontWindow	pla	plx	cmp	wptr	bne	rtc0		if not front window	cpx	wptr+2	bne	rtc0		if not front window		pha	pha	_FindTargetCtl	pla			low word	plx			high word		sta	l4	stx	l4+2	cmp	thdl	bne	rtc1		if not time handle	cpx	thdl+2	beq	rtc2		if time handlertc1	lda	thdl	ldx	thdl+2	jsr	itd		init time and date	lda	oldsec	cmp	newsec	beq	rtc5		if hasn't changed yet	pushl	thdl	_DrawOneCtlrtc2	lda	l4	cmp	dhdl	bne	rtc3		if not date handle	lda	l4+2	cmp	dhdl+2	bne	rtc3		if date handle isn't the target handle		jsr	udo		update date only	bra	rtc4	rtc3	lda	dhdl	ldx	dhdl+2	jsr	itd		init time and date 	lda	oldday	cmp	newday	beq	rtc5		if hasn't changed yet	pushl	dhdl	_DrawOneCtlrtc4	jsr	udy		update day of year	bcs	rtc5		if nothing changed	jmp	sdc		set daylight controls and return	rtc5	rtsrtca	dc.w	0		counter for when to draw;	teriary routines used by the message handling routines.;;	ats - adjust the time by seconds.;;	entry	[a,x] = # of seconds to adjust the time.;;	exit	clock is adjusted.ats	sta	l1		save change for now	stx	l1+2	pha			space for result	pha			space for result	pushw	#6		get current time based on seconds	pushl	#0	pushl	#buff		buffer to use	ldx	#$3703	jsl	$e10000		convert seconds;	adjust the seconds.	lda	1,s	clc	adc	l1	sta	1,s	lda	1+2,s	adc	l1+2	sta	1+2,s			plx			lo word of seconds	ply			hi word of seconds	pha			space for result	pha			space for result	pushw	#7		set current time based on seconds	phy			hi word of seconds	phx			lo word of seconds	pushl	#buff		buffer to use		pushw	#$e1e1		kludge for misc tools bug	plb			kludge for misc tools bug	plb			kludge for misc tools bug	ldx	#$3703	jsl	$e10000		convert seconds		phk			kludge for misc tools bug	plb			kludge for misc tools bug		pla	plx	rts	buff	ds.b	10;;	cds - create day string.;;	cds creates the string like 'Day 103 of this year.;				     262 days left in this year.;;	entry	(leapF) = 1 if leap year.;;	exit	(cdsa..) = string of days left in year.;		(daylen) = length of string.cds	lda	leapFcdsE	sta	cdsg	jsr	cdy		compute day of year	cmp	cday	sta	cday	bne	cds1		if has definetly changed	ldx	leapF	cpx	cdsg	bne	cds1		if year changed to or from a leap year	sec	bra	cds1a	cds1	clccds1a	php			save status for later	pha			int to convert	pushl	#cdsf		dest string	pushw	#3		3 chars long	pushw	#0		unsigned	_Int2Dec	ldx	#0	txy	lda	cday	cmp	#100	bcs	cds2		if three digit #	inx	cmp	#10	bcs	cds2		if two digit #	inxcds2	shortmxcds3	lda	cdsf,x	sta	cdsa+4,y	iny	inx	cpx	#3	bcc	cds3		if more to copy		ldx	#0cds4	lda	cdsb,x	sta	cdsa+4,y	copy over ' of year',$d	iny	inx	cpx	#cdsbL	bcc	cds4		if more to copy	sty	w3		save offset for now		longmx		lda	leapF	clc	adc	#365	sta	w1		length of year	sec	sbc	cday	ldx	dispF	beq	cds5		if till end of year	sbc	#6		(c) set	bcs	cds5		if not last week of year	adc	w1		(c) clear, adjust for the last weekcds5	sta	w2		save for now	pha			int to convert	pushl	#cdsf		dest string	pushw	#3		3 chars long	pushw	#0		unsigned	_Int2Dec	ldx	#0	lda	w2	cmp	#100	bcs	cds6		if three digit #	inx	cmp	#10	bcs	cds6		if two digit #	inxcds6	ldy	w3		restore offset	shortmxcds7	lda	cdsf,x	sta	cdsa+4,y	save digit	iny	inx	cpx	#3	bcc	cds7		if more to copy		longmx	lda	#'d '	sta	cdsa+4,y	iny	iny	lda	#'ya'	sta	cdsa+4,y	add 'ay'	iny	iny	ldx	w2	dex	beq	cds8		if only 1 day left	lda	#' s'	sta	cdsa+4,y	iny	cds8	shortmx	ldx	dispF	beq	cds10		if till end of year	ldx	#0cds9	lda	cdsd,x	sta	cdsa+4,y	iny	inx	cpx	#cdsdL	bcc	cds9		if more to copy	bra	cds11	cds10	lda	cdsc,x	sta	cdsa+4,y	iny	inx	cpx	#cdscL	bcc	cds10		if more to copy	cds11	tya	adc	#4-1		(c) set	sta	daylen		length of string	longmx	plp	rts		;	data used here.cdsa	dc.b	'Day '	ds.b	75		hold rest of text item	cdsb	dc.b	' of this year.',$d	cdsbL	equ	*-cdsb		length of stringcdsc	dc.b	' left in this year.'cdscL	equ	*-cdsc		length of stringcdsd	dc.b	' ''til Christmas.'cdsdL	equ	*-cdsd		length of stringcdsf	ds.b	5		hold stringcdsg	ds.b	2		used to hold the old leap year flag;;	cdy - compute day of year.;;	entry	clock is set to time.;;	exit	(a) = day of year.;		(leapF) = 0 if not leap year.;			= 1 if leap year.cdy	pha	pha	pha	pha			space for result	_ReadTimeHex	stz	leapF		assume not leap year	lda	4,s		get year and hour	and	#$ff		remove hour	cmp	#100	beq	cdy1		if the year 2000, then not leapyear	and	#3			bne	cdy1		if not leap year	inc	leapF		flag that it is a leap yearcdy1	lda	6,s		get month and filler	and	#$ff		remove filler	sta	w1		ending month	stz	w2		current day count	ldx	#0cdy2	cpx	w1	bcs	cdy4		if done	lda	cdymonth,x	get days in this month	and	#$ff		only low byte is significant	clc	adc	w2	cpx	#1	bne	cdy3		if not adding in february	clc	adc	leapF		add in the effects of leap yearcdy3	sta	w2		current day count	inx	bra	cdy2		process next month	cdy4	lda	5,s		get day of month and  month	and	#$ff		remove month	adc	w2		(c) set		plx			clear off stack	plx	plx	plx	rts	cdymonth  dc.b	31,28,31,30,31,30,31,31,30,31,30,31	;;	dah - dereference a handle.;;	entry	[a,x] = handle.;;	exit	[l2] = derefenced handle.dah	sta	l1	stx	l1+2		lda	[l1]	sta	l2		low word of ptr	ldy	#2	lda	[l1],y	sta	l2+2		hi word of ptr	rts				;;	dts - disable target status.;;	entry	[a,x] = hqandle to control.;;	exit	control is no longer the target.dts	sta	l4	stx	l4+2	jsr	dah		dreference a handle	ldy	#TDCtlRec.ctlMoreFlags	lda	[l2],y	and	#$7fff		control is no longer target	sta	[l2],y	pha	pha	pushl	l4		control handle	pushw	#ctlChangeTarget	pha	pha				_CallCtlDefProc	pla	pla	rts;;	fbh - fall back an hour.;;	entry	none.;;	exit	clock is moved back an hour.fbh	lda	#-3600	ldx	#^-3600	jmp	ats		adjust the time be seconds and return		;;	gds - get daylight status.;;	entry	clock is set up to the time.;;	exit	(c) set if standard time.gds	pha			space for result	pha			space for result	pha			space for result	pha			space for result	_ReadTimeHex	lda	6,s		get month and filler	and	#$ff		remove filler	cmp	#3	bcc	gds2a		if not at least april, then it is standard time		cmp	#3	bne	gds3		if not april	;	see if past the first sunday in april.	lda	5,s	and	#$ff		get day of month	cmp	#6+1	bcs	gds9		if definetly past the first sunday of the month		tax	stx	w1		save for now		lda	8,s		get day of week	and	#$ff		remove extra garbagegds1	cmp	#1	beq	gds2		if found the first sunday of the month	dea	dex	bpl	gds1		if more to check in the month	bra	gds8		if definetly standard time	gds2	cpx	w1	bne	gds9		if past the first sunday of april	;	today is the first sunday of april.	lda	3,s		get hour and year	and	#$ff		remove year	cmp	#2	bcs	gds9		if in daylight savingsgds2a	bra	gds8		if standard time	gds3	cmp	#9	bcc	gds9		if defintely daylight savings	bne	gds8		if defintely standard time		lda	5,s	and	#$ff		get day of month in low bye	cmp	#30-6	bcc	gds9		if definetly in daylight savings	tax	stx	w1	lda	8,s		get day of week	and	#$ff		remove extra garbage	gds4	cmp	#1	beq	gds7		if found the last sunday of the month	ina	cmp	#8	bcc	gds5		if haven't wrapped	lda	#1		reset to sundaygds5	inx	cpx	#30+1	bcc	gds4		if more to check in the month	bra	gds8		if defintely standard time	gds7	cpx	w1	bne	gds9		if before the last sunday of the month	;	today is the last sunday of october.	lda	3,s		get hour and year	and	#$ff		remove year	cmp	#2	bra	gds10		(c) set if standard time	gds8	sec			flag standard time	skip1			skip the next instructiongds9	clc			flag daylight savings timegds10	plx			clear off stack	plx	plx	plx	rts	;;	rbp - read battery parameter.;;	entry	(x) = parameter to read.;;	exit	(a) = value of parameter.rbp	pha			space for result	phx			parameter to read	_ReadBparam	pla			get value	rts;;	scv - set control value.;;	entry	(a) = value to set.;		(x) = id of control.;;	exit	none.scv	pha			value to set	pha			space for result	pha					pushl	wptr		window pointer	pushw	#0	phx			id of control	_GetCtlHandleFromID	_SetCtlValue		value to set was already on stack	rts;;	sdc - set daylight controls.;;	entry	none;;	exit	if clock is in different time than controls then the radio;		buttons are reset.;;	alternate entrypoint:  sdcE.;;	forces the control to be setsdc	clc	skip1sdcE	sec	ror	sdca		pha			space for result	pushl	radio6hdl		_GetCtlValue		jsr	gds		get daylight status	ldx	#radio6id	id of standard time control	stx	format	pla	bcs	sdc1		if standard time	inx	stx	format		id of selected radio control	ldy	sdca	bmi	sdc2		if forced setting		tay	beq	sdc3		if set correctly	bra	sdc2	;	standard time.sdc1	ldy	sdca	bmi	sdc2		if forced setting		tay	bne	sdc3		if set correctly	sdc2	lda	#1	phx			save for now	jsr	scv		set control value	jsr	urc		update radio control		sec	plx			id of control that is correct	rts				sdc3	clc	rtssdca	dc.w	0;;	sah - spring ahead an hour.;;	entry	none.;;	exit	clock is moved ahead an hour.sah	lda	#3600	ldx	#^3600	jmp	ats		adjust the time be seconds	;;	itd - init time and date.;;	entry	[a,x] = handle to control.;;	exit	(oldsec) = old seconds.;		(newsec) = new seconds of control.;		(oldday) = old day of year of control.;		(newday) = new day of year of control.;		controls date and time fields are updated.itd	jsr	dah		derefeence a handle	pha	pha	pha	pha	_ReadTimeHex	ldy	#TDCtlRec.daterec	lda	[l2],y	sta	oldsec		old seconds	pla	sta	newsec		new seconds	sta	[l2],y		store seconds and minute in control	iny	iny	pla	sta	[l2],y		store hour and year	iny	iny	lda	[l2],y	sta	oldday	pla	sta	newday	sta	[l2],y		store day of month and month	iny	iny	pla	sta	[l2],y		store filler and day of week	rts;;	urc - update radio controls.;;	entry	[checkhdl] = handle of checkbox control.;		[radio6hdl] = handle to standard time button.;		[radio7hdl] = handle to daylight time button.;		;	exit	if the checkbox is set, the radio buttons are dimmed.urc	pha	pushl	checkhdl	_GetCtlValue		ldx	#inactivehilite	pla	bne	urc1		if set	ldx	#nohilite		urc1	phx	phx			what to set the radio controls to			pushl	radio6hdl	_HiliteControl		pushl	radio7hdl	_HiliteControl	pushl	radio6hdl	_DrawOneCtl	pushl	radio7hdl	_DrawOneCtl		rts;;	udf - update display formats.;;	entry	[dhdl] = handle to day of year control.;		[thdl] = handle to time of day control.;;	exit	controls are reinitialized and redrawn.udf	jsr	wbp		write battery parameter	pha	pha	pushl	dhdl		control handle	pushw	#3		init control	pushl	#dctl	_CallCtlDefProc	pla	pla		pha	pha	pushl	thdl		control handle	pushw	#3		init control	pushl	#tctl	_CallCtlDefProc	pla	pla		lda	thdl	ldx	thdl+2	jsr	itd		init time and date		lda	dhdl	ldx	dhdl+2	jsr	itd		set time and date 	;pushl	#udfa	;_EraseRect	pushl #erase_rect	_EraseRect		pushl	thdl	_DrawOneCtl	pushl	dhdl	_DrawOneCtl	rts;udfa	dc.w	5,160+65,5+10,160+65+100;udfa	dc.w	5,240,18,290erase_rect	ds.w 4			;kludge rect to erase to clean					;things up -- set in icc;;	udo - update date only.;;	entry	[dhdl] = handle to day of year control.;;	exit	the date is updated in the real-time clock.udo	lda	dhdl	ldx	dhdl+2	jsr	dah		dereference a handle		ldy	#TDCtlRec.daterec+4	lda	[l2],y		get month and date	sta	w2		save for now	dey	dey	lda	[l2],y		get year in hi byte	and	#$ff00	cmp	#$400	bcs	uto1	lda	#$400uto1	sta	w1		save for nowuto2	pha	pha	pha	pha			space for result	_ReadTimeHex	lda	3,s		get year and hour	and	#$ff		strip off year	ora	w1		add in correct year	sta	w3		save for now		lda	1,s	plx	plx	plx	plx		ldx	w2	phx	ldx	w3	phx	pha	_WriteTimeHex	rts;;	udy - update day of year.;;	entry	none.;;	exit	day of year string is updated.udy	jsr	cds		create day of year string	bcs	udy1		if nothing changed		pushw	daylen	pushl	dayhdl	_SetCtlValue	pushl	dayhdl	_DrawOneCtl	clc	udy1	rts;;	utd - update time and date.;;	entry	[dhdl] = handle to day of year control.;		[thdl] = handle to time of day control.;;	exit	The system clock is updated based on the settings of the;		2 controls.utd	lda	dhdl	ldx	dhdl+2	jsr	dah		dereference a handle		lda	utdnday	sta	utdoday		lda	utdnyear	sta	utdoyear		ldy	#TDCtlRec.daterec+4	lda	[l2],y		get month and date	sta	utdnday	pha	dey	dey	lda	[l2],y		get year in hi byte		sta	utdnyear		and	#$ff00	cmp	#$400	bcs	utd1	lda	#$400utd1	sta	w1		save for now			lda	thdl	ldx	thdl+2	jsr	dah		dereference a handle		ldy	#TDCtlRec.daterec+2	lda	[l2],y	and	#$ff		leave hour in low byte	ora	w1		add in year	pha	dey	dey	lda	[l2],y		get minute and second	pha	_WriteTimeHex		rts		;	data used here.utdoyear  ds.b	2utdnyear  ds.b	2utdoday	ds.b	2utdnday	ds.b	2;;	wbp - write battery parameter.;;	entry	(a) = value of parameter to set.;		(x) = battery parameter to set.;;	exit	battery parameter is set.wbp	pha			new value	phx			parameter to set	_WriteBparam	rts	;	data used here.cday	dc.w	$ffff		current day of yeardispF	ds.b	2		= 0 to display till end of year infodayhdl	ds.b	4		handle to day of year controldhdl	ds.b	4		handle to date controlcheckhdl  ds.b	4		handle to auto daylight checkboxeventrec  dc.w	keydownevt	ds.b	$30		format	dc.w	$ffff		id of control leapF	dc.w	$ffff		= 0 if not leap year, else = 1newday	ds.b	2		day of month from clocknewsec	ds.b	2		seconds value from clockoldday	ds.b	2		day of month value displayedoldsec	ds.b	2		seconds value currently displayedradio6hdl  ds.b	4		handle to sixth radio buttonradio7hdl  ds.b	4		handle to seventh radio button	readyF	dc.w	$ffff		flag not ready for events yetthdl	ds.b	4		handle to time of day controlwptr	ds.b	4		window ptr				endp	end