***********************************************************************************                                                                                **	ArchiverGS                                                             **		-- a general-purpose backup utility for the Apple][GS        **                                                                                **	Custom time/date input control for auto-selection.                     **                                                                                **	Copyright Apple Computer Inc. 1989  ALL RIGHTS RESERVED                **                                                                                **                                                                                ******************************************************************************************	REVISION HISTORY:	******************************************************	August 26, 1989	Monte Benaresh**		Created this file.***********************************************************************************		machine M65816jump		PROC		;first bytes of this code image must be the entry point		import time_date_defproc		jmp time_date_defproc		ENDP;-----------------------------------------------------------;; New action messages supported by some controls;ctlHandleEvent	equ 13	;Send the event record to controlctlChangeActivity	equ 14	;The activity bit in MoreFlags just changed.ctlChangeBounds	equ 15ctlWindChangeSize   equ 16ctlHandleTab	equ 17ctlNotifyMultiPart	equ 18	;Called if set and when HideControl is calledctlWinStateChange	equ 19	;Called if window state changes.MaxMessages	equ 19;-----------------------------------------------------------;; Extended task record def;NewTaskRecord	RECORD 0taskWhat   	ds.W 1		; Word - WmTaskRec -  taskMessage   	ds.L 1		; Long - WmTaskRec -  taskWhen   	ds.L 1		; Long - WmTaskRec -  taskWhere   	ds.L 1		; Point - WmTaskRec -  taskModifiers   	ds.W 1		; Word - WmTaskRec -  taskData   	ds.L 1		; Long - WmTaskRec - TaskMaster return value.taskMask   	ds.L 1		; Long - WmTaskRec - TaskMaster feature mask.taskLastClick	ds.L 1taskClickCount	ds.W 1taskData2		ds.L 1taskData3		ds.L 1taskData4		ds.L 1		ENDRnullEvt      EQU   $0000 ; Event Code -  mouseDownEvt EQU   $0001 ; Event Code -  mouseUpEvt   EQU   $0002 ; Event Code -  keyDownEvt   EQU   $0003 ; Event Code -  autoKeyEvt   EQU   $0005 ; Event Code -  updateEvt    EQU   $0006 ; Event Code -  activateEvt  EQU   $0008 ; Event Code -  switchEvt    EQU   $0009 ; Event Code -  deskAccEvt   EQU   $000A ; Event Code -  driverEvt    EQU   $000B ; Event Code -  app1Evt      EQU   $000C ; Event Code -  app2Evt      EQU   $000D ; Event Code -  app3Evt      EQU   $000E ; Event Code -  app4Evt      EQU   $000F ; Event Code -  gsos_date		RECORD 0		;GS/OS™ time and date formatseconds		ds.b 1minutes		ds.b 1hour		ds.b 1year		ds.b 1day		ds.b 1month		ds.b 1null		ds.b 1weekday		ds.b 1		ENDR**************************************************************	special fudge equates			**************************************************************arrow_height	equ 4		;height of each arrow pixelsarrow_width	equ 20		;width of arrows in pixelsicon_width	equ 5		;byte width of arrow iconsrect_height	equ arrow_height*2 + 5	;height of control rectanglestring_v_pos	equ 2		;vertical adjustment for string positionstring_h_pos	equ 3		;horizontal adjustment for string positionTDCtlRec		RECORD  0		;record for the Time/Date controlctlNext		ds.l  1ctlOwner		ds.l  1ctlRect		ds.w  4ctlFlag		ds.b  1ctlHilite		ds.b  1ctlValue		ds.w  1ctlProc		ds.l  1ctlAction		ds.l  1ctlData		ds.l  1ctlRefCon		ds.l  1ctlColor		ds.l  1ctlReserved	ds.b  16ctlID		ds.l  1ctlMoreFlags	ds.w  1		;bit 0 = 1 --> 24 hour format				;bit 1 = 1 --> control currently dimmedctlVersion	ds.w  1		;control-specific fieldsdateRec		ds.b 8		;GS/OS time/date recordcwidth		ds.w 1		;width of each character in the stringarrowPos		ds.w 1		;pixel position of arrows relative to control rectcurrPart		ds.w 1		;currently active part (string field)formatRef		ds.w 1		;pointer to format tabledrawFlag		ds.w 1		;flag to tell us not to draw twice when we get shownctlSizectlKey1		equ ctlReservedctlKey2		equ ctlKey1+1ctlKeyMods	equ ctlKey2+1ctlKeyModsCareBits	equ ctlKeyMods+2ctlJust		equ ctlReserved		ENDR**************************************************************	part codes for the control			**************************************************************			;values in the range 32-127 are available for application usepart_month	equ 32part_1st		equ part_monthpart_day		equ 33part_year		equ 34part_hour		equ 35part_minute	equ 36		if seconds = 1 thenpart_second	equ 37		;include secondspart_am_pm	equ 38part_up		equ 39		;up arrowpart_down		equ 40		;down arrow		elsepart_am_pm	equ 37		;exclude secondspart_up		equ 38		;up arrowpart_down		equ 39		;down arrow		endifpart_last_str	equ part_am_pm	;highest part number of string field			;indexes into tables for each partmonth_index	equ 0day_index		equ 2year_index	equ 4hour_index	equ 6minute_index	equ 8		if seconds = 1 thensecond_index	equ 10		;include secondsam_pm_index	equ 12		elseam_pm_index	equ 10		;exclude seconds		endif			;other random equatestabChar		equ $09		;TAB characterup_arrow_key	equ 11dn_arrow_key	equ 10l_arrow_key	equ 8		;left arrowr_arrow_key	equ 21		;right arrowrepeat_delay	equ 25		;ticks before auto-repeat when trackingrepeat_period	equ 6		;ticks between auto-repeat when trackingstring_buf_size	equ 28		;size of the string bufferdp		RECORD 1		;offsets on direct page		if seconds = 1 thenfield_count	equ 7		elsefield_count	equ 6		endif			;direct-page for private use:ctl_ptr		ds.l 1			;dereferenced control handletable_ptr		ds.w 1			;short ptr to format tableformat_table				;copy of format tablestring_size	ds.w 1part_left		ds.w field_countpart_right	ds.w field_countpart_next		ds.w field_countpart_prev		ds.w field_countfirst_field	ds.w 1last_field	ds.w 1dp_size		equ *-1			;pushed parameters:old_dp		ds.w 1			;caller's direct pageold_db		ds.b 1			;caller's DBRreturn_addr	ds.b 3move_start			;start of stuff to skip over when fixing stacktheControlHandle	ds.l 1ctlParam		ds.l 1ctlMessage	ds.w 1move_end				;end of stuff to skip over when fixing stackresult		ds.l 1move_dist		equ move_end-move_start		;distance to move parameters…						;…when fixing stack		ENDR			;global storage for the controlhour_flag		ds.w 1		;space for flag in high bit to indicate 24-hour formatlong_field_flag	dc.w 0		;flag to tell set_field_rect whether it should…				;…include white space at end of a string field…				;…when figuring the rectangle bounds. default is…				;…$0000 = do NOT include white spacetemp_rect		ds.b 16		;space for temporary RECT structure for use with PtInRectmouse_pos		ds.w 2		;this space used for point returned by GetMouseold_port		ds.l 1		;Graph Port on entry, to be restored on exitold_pen_state	ds.b 50		;Pen State record on entry, restored on exitdim_pen_mask	dcb.w 4,$55AA	;used to dim control		export time_date_defproctime_date_defproc	PROC		;defproc for the time/date control		import div_ten		import calc_c_coord		import pt_in_rect		import set_field_rect		import invert_part		import draw_arrow_icon		import build_string		import change_value		import format1		import format2	if table3 = 1 then		import format3	endif		import table_length		import draw_frame		import hide_frame		import roll_field		import set_up_table		import set_up_table2		import hide_arrows		import set_arrow_rect		phb			;save data bank		phk			;set up our bank register		plb		;brk $41		phd			;save old direct page		tsc		sec		sbc #dp.dp_size		;make room for direct page		tcs		tcdset_up		ldx <dp.ctlMessage		;what operation are we performing?		cpx #12			;RecSize message?		beq @setup_done		;if so skip all setup		lda [dp.theControlHandle]		sta <dp.ctl_ptr		;dereference control handle		ldy #2		lda [dp.theControlHandle],y		sta <dp.ctl_ptr+2		pha		pha			;LONG space for result		ldx #$1C04		;GetPort		jsl $E10000		pla			;save caller's GrafPort		sta old_port		pla		sta old_port+2		ldy #TDCtlRec.ctlOwner+2	;points to window GrafPort		lda [dp.ctl_ptr],y		;get high word		pha		dey		dey		lda [dp.ctl_ptr],y		;get low word		pha		ldx #$1B04		;SetPort		jsl $E10000		pea old_pen_state>>16	;buffer for current pen state		pea old_pen_state		ldx #$2B04		;GetPenState		jsl $E10000		;save current pen in this GrafPort			;set up our pen		ldx #$3604		;PenNormal		jsl $E10000		pea $0002			;new pen width		pea $0001			;new pen height		ldx #$2C04		;SetPenSize		jsl $E10000		ldx <dp.ctlMessage		cpx #3			;initCtl message?		beq @setup_done		;if initCtl, don't attempt to find format table@copy				;copy format table to direct-page		jsr set_up_table		;check control record and copy appropriate table…					;…to direct-page@setup_donedispatch		lda <dp.ctlMessage		;what operation are we performing?		;brk $40		cmp #MaxMessages+1		;verify that it's in range		bcc @ok		brl done			;return now if undefined@ok		asl a			;multiply for word offset		tax		jmp (proc_table,x)proc_table	;			 message number		dc.w draw			;0		dc.w not_implemented	;1		dc.w testCtl		;2		dc.w initCtl		;3		dc.w not_implemented	;4		dc.w not_implemented	;5		dc.w not_implemented	;6		dc.w not_implemented	;7		dc.w autoTrack		;8		dc.w not_implemented	;9		dc.w not_implemented	;10		dc.w not_implemented	;11		dc.w recSize		;12		dc.w handleEvent		;13		dc.w changeActivity		;14		dc.w not_implemented	;15		dc.w not_implemented	;16		dc.w handleTab		;17		dc.w notifyMultipart	;18		dc.w stateChange		;19draw		ldy #TDCtlRec.drawFlag		lda [dp.ctl_ptr],y		;were we just made visible?		dec a			;look for 1		bne @cont			;if not 1, go ahead and draw@shown				;we are newly shown		sta [dp.ctl_ptr],y		brl done@cont		dec a			;was it 2?		bne @leave_alone		;if not, leave flag where it was		inc a			;put back to 1		sta [dp.ctl_ptr],y		;set flag to ignore next time@leave_alone		ldy #TDCtlRec.ctlFlag		lda [dp.ctl_ptr],y		;get flags		and #$0080		;is it invisible?		beq @visible		brl done			;don't draw if invisible@visible		lda <dp.ctlParam		;what part to draw		beq @whole_control		;if 0, draw whole thing		cmp #part_up		;test for arrows		bcc @string_field		brl done			;handle arrows elsewhere@string_field		brl @change_hilite@whole_control		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;is there a hilighted(?) part?		beq @no_erase		;if not, nothing to erase@erase				;erase rect of current part to correct for dorked-out…				;…Control Manager		jsr set_field_rect		;set temp_rect to current part		pea temp_rect>>16		pea temp_rect		ldx #$5504		;EraseRect		jsl $E10000		;erase rect enclosing that part@no_erase				;now would be a good time to draw the string		jsr build_string		;compile the display string		ldy #TDCtlRec.ctlRect + 2	;point to left edge of control's rectangle		lda [dp.ctl_ptr],y		;get x coordinate		clc		adc #string_h_pos		;adjust to make room for frame		pha		dey		dey			;back to top edge		lda [dp.ctl_ptr],y		;get y coordinate		clc		adc #8+string_v_pos		;add ascent for Shaston font + adjustment		pha		ldx #$3A04		;MoveTo		jsl $E10000		pha			;space for result		ldx #$9904		;GetFontFlags		jsl $E10000		;leave old FontFlags on stack		pea $0002			;select numeric spacing for DrawString		ldx #$9804		;SetFontFlags		jsl $E10000		pea string_buf>>16		pea string_buf		ldx #$A504		;DrawString		jsl $E10000		;draw the string					;previous FontFlags word is still on stack		ldx #$9804		;SetFontFlags		jsl $E10000		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;is any part hilighted?		pha			;save on STACK		;beq @no_part		;removed 1/14/91 to keep frame permanent		jsr draw_frame		;if active part, draw frame@no_part		pla			;restore part code		ldx <dp.ctlParam+2		;check window activity		bne @inactive@active		tax			;save part code		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;get MoreFlags		and #$FFFD		;remove flag now that we're drawn un-dimmed		sta [dp.ctl_ptr],y		txa			;get back part code		beq @no_part2		;if 0, don't try to hilight		jsr invert_part		;hilight part		ldy #arrows>>16		;now draw arrows		ldx #arrows		jsr draw_arrow_icon		;draw this arrow icon		bra @done@inactive		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;get MoreFlags		ora #$0002		;set flag to tell draw routine that image…					;…is in inactive state		sta [dp.ctl_ptr],y		jsr hide_arrows		;get rid of arrows		pea dim_pen_mask>>16	;set to dimming pattern for inactive		pea dim_pen_mask		ldx #$3204		;SetPenMask		jsl $E10000		pea $8000			;pen mode notCopy, draw in white		ldx #$2E04		;SetPenMode		jsl $E10000		lda <dp.ctl_ptr		;get address of control record		clc		adc #TDCtlRec.ctlRect	;compute address of control rect		tax		lda <dp.ctl_ptr+2		adc #0		pha			;push ptr to control rect		phx		ldx #$5404		;PaintRect		jsl $E10000@no_part2@done		brl done@change_hilite			;change hilighting to new part		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;get MoreFlags		and #$0002		;check flag, "are we in a dimmed state?"		bne @set_new		;if dimmed, never invert any field@not_dimmed		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;get currently hilighted part		beq @new			;none currently hilighted, just hilight new one		cmp <dp.ctlParam		;is it the same field as new one?		bne @old			;if not, reverse old hilighting		brl done			;same field, don't bother@old		jsr invert_part		;part # in accum@new		lda <dp.ctlParam		;get new part number		jsr invert_part@set_new		lda <dp.ctlParam		;get new part number		ldy #TDCtlRec.currPart		sta [dp.ctl_ptr],y		;set in control record		brl donerecSize		lda #TDCtlRec.ctlSize	;this is our record size		sta <dp.result		stz <dp.result+2		;brl done		brl done_no_recinitCtl;	First set up default date.		ldy #TDCtlRec.dateRec+6	;point to last field of date record in control		ldx #6			;point to same place in local copy@loop		lda init_date_rec,x		;copy our daterec into the control		sta [dp.ctl_ptr],y		dey		dey		dex		dex		bpl @loop;	Set action proc to autoTrack.		ldy #TDCtlRec.ctlAction	;point to action field		lda #$FFFF		;this goes in high & low words		sta [dp.ctl_ptr],y		;set action proc ptr to -1 so autoTrack will be…		iny			;…used to track our arrows		iny		sta [dp.ctl_ptr],y;	Decide format for display based on Control Panel setting.				;get time/date setting from b-ram		pha			;space for result		pea $0034			;request month/day/year format		ldx #$0C03		;ReadBParam		jsl $E10000		ldy #TDCtlRec.formatRef	;preload Y with index to field		pla			;get result		beq @format1		;MM/DD/YY		cmp #3			;range check		bcs @format1		;unknown, so use American format		if table3 = 1 then		;assemble only if we need year-first…					;…display format		dec a			;1 = DD/MM/YY		beq @format2		;use day before month@format3				;we want year, month, day		lda #<format3		bra @store_format		endif@format2				;day before month		lda #<format2		bra @store_format@format1		lda #<format1@store_format		sta [dp.ctl_ptr],y		;set up short pointer		sta <dp.table_ptr		;we need this pointer to find string size				;get hour format setting from b-ram, set bit 0 of moreFlags…				;…in control record iff 24-hour format is selected		pha			;space for result		pea $0035			;request hour format		ldx #$0C03		;ReadBParam		jsl $E10000		ldy #TDCtlRec.ctlMoreFlags	;preload Y with index to field		pla			;get result		beq @12			;12-hour format@24		lda [dp.ctl_ptr],y		;get more flags		ora #$0001		;set bit 0		bra @store_hour@12		lda [dp.ctl_ptr],y		;get more flags		and #$FFFE		;clear bit 0@store_hour		sta [dp.ctl_ptr],y		;set moreFlags back@find_type			;determine whether we want time, date, or both		ldy #$12			;offset to CtlFlag in template		lda [dp.ctlParam],y		;get flags byte in template		and #$0003		;lower 2 bits are control type:					;	01 = time only					;	10 = date only					;	11 = time and date					;	00 = bad value		ldy #TDCtlRec.ctlFlag		ora [dp.ctl_ptr],y		;add bits to field in record		sta [dp.ctl_ptr],y@get_table		jsr set_up_table2		;use current table_ptr and copy table to direct-page;	Calculate position for arrows based on character widths.		pha			;space for result		ldx #$9904		;GetFontFlags		jsl $E10000		;leave old FontFlags on stack		pea $0002			;select numeric spacing for DrawString		ldx #$9804		;SetFontFlags		jsl $E10000		pha			;space for result		pea '0'			;get width of a character		ldx #$A804		;CharWidth		jsl $E10000		pla		ldy #TDCtlRec.cwidth		sta [dp.ctl_ptr],y		;keep track of how wide the characters are					;previous FontFlags word is still on stack		ldx #$9804		;SetFontFlags		jsl $E10000		lda <dp.string_size		;character position for arrows		dec a			;adjust		jsr calc_c_coord		;get actual pixel position		inc a		inc a			;adjust right 2 pixels		pha			;save unmodified for below		ldy #TDCtlRec.ctlRect+2	;point to left edge		sec		sbc [dp.ctl_ptr],y		;make relative to control rectangle		ldy #TDCtlRec.arrowPos	;set position of arrows in record		sta [dp.ctl_ptr],yinit_icons;	Set icon data based on graphics mode.		pha			;space for result		ldx #$1704		;GetMasterSCB		jsl $E10000		pla			;this is master SCB		sta arrows		;put copy in each icon image		sta arrows_up		sta arrows_down		xba			;mode is now in high bit		asl a			;put in carry		lda #icon_width*4		;assume 640 mode		bcs @store_width@320		lsr a			;divide width by 2 for 320 mode@store_width		sta arrows+14		;put copy of pixel width in each icon image		sta arrows_up+14		sta arrows_down+14;	Set control rectangle.set_ctl_rect			;arrow position on stack		lda #arrow_width+2		;get pixel width of arrows + margin		bit arrows-1		;test SCB		bmi @640			;bit 7 set, we're in 640 mode@320		lsr a			;divide by 2 for 320 mode		inc a			;need a pixel more in 320@640				;arrows X position on stack		clc		adc 1,s			;add to pos of arrows rel to grafport		ply			;clean it off the stack		ldy #TDCtlRec.ctlRect+6	;right edge		sta [dp.ctl_ptr],y		;set right edge of control rect		ldy #TDCtlRec.ctlRect	;top edge		lda [dp.ctl_ptr],y		;get top edge of window		clc		adc #rect_height		;this is the height of the ctlRect		ldy #TDCtlRec.ctlRect+4		sta [dp.ctl_ptr],y		;set bottom edge of window;	Init private flags.		lda #0		ldy #TDCtlRec.drawFlag		sta [dp.ctl_ptr],y		;clear flag. drawFlag indicates that we are…					;…changing state from invisible to visible…					;…so that the draw routine will only run…					;…once even though we get a draw message twice		brl donetestCtl		;brk $E0		stz <dp.result+2		;high word of part code		lda <dp.ctlParam		;copy mouse position to global		sta mouse_pos		lda <dp.ctlParam+2		sta mouse_pos+2@up_arrow		jsr set_arrow_rect		;set temp_rect to rect enclosing both arrows		lda temp_rect		;get top edge		clc		adc #arrow_height+string_v_pos		sta temp_rect+4		;set bottom edge for up arrow				;now test with PtInRect		jsr pt_in_rect		;call PtInRect		beq @down_arrow		;failed, try other arrow		lda #part_up		sta <dp.result		brl done@down_arrow		ldy #TDCtlRec.ctlRect+4	;point to bottom edge of control rect		lda [dp.ctl_ptr],y		sta temp_rect+4		;set bottom edge		sec		sbc #arrow_height+string_v_pos		sta temp_rect		;set top edge				;now test with PtInRect		jsr pt_in_rect		;call PtInRect		beq @string_fields		;if false, go on to string fields		lda #part_down		sta <dp.result		brl done@string_fields			;test all the string fields		lda <dp.first_field		;start with first string part		sta test_part		;init loop variable@loop		inc long_field_flag		;tell set_field_rect to include white…					;…space in rectangle. this flag will…					;…be reset by set_field_rect		jsr set_field_rect		;set up rectangle in temp_rect for part # in Accum		jsr pt_in_rect		bne @part_hit		;if hit, break loop@next_part		lda test_part		asl a			;make word offset		sbc #(part_1st*2)-1		;normalize. carry is clear		tax			;use as index		lda <dp.part_next,x		;get next part		sta test_part		bne @loop			;loop if non-0@no_hit				;no part was hit		stz <dp.result		brl done@part_hit		lda test_part		sta <dp.result@become_target			;now this control becomes target		pei dp.theControlHandle+2		pei dp.theControlHandle		ldx #$2810		;MakeThisCtlTarget		jsl $E10000		brl donechangeActivity		;brk $49		ldy #TDCtlRec.ctlFlag		lda [dp.ctl_ptr],y		;get flags		and #$0080		;is it invisible?		beq @visible		ldy #TDCtlRec.currPart		lda #0		sta [dp.ctl_ptr],y		;set current part to null		brl done			;don't draw if invisible@visible		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;get MoreFlags		and #$8000		;check FCtlTarget bit		beq @hide_arrows		;if clear, we are not target any more@show_arrows		ldy #arrows>>16		ldx #arrows		jsr draw_arrow_icon		;draw this arrow icon@draw_frame				;put box around control when active		;jsr draw_frame		;removed 1/14/91 since frame now permanent		brl done@hide_arrows		jsr hide_arrows		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;get MoreFlags		and #$0002		;are we in a dimmed state?		bne @no_invert		;if dimmed, don't try to invert		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;what part is currently hilighted?		beq @no_part		;should never be taken		jsr invert_part@no_invert		ldy #TDCtlRec.currPart		lda #0		sta [dp.ctl_ptr],y		;set current part to null@hide_frame		;jsr hide_frame		;removed 1/14/91 to keep frame permanent@no_part		brl donehandleEvent		ldy #TDCtlRec.ctlFlag		lda [dp.ctl_ptr],y		;get flags		and #$0080		;is it invisible?		bne @dont_handle@visible		ldy #NewTaskRecord.taskWhat		lda [dp.ctlParam],y		;what event is it?		cmp #keyDownEvt		beq @key		cmp #autoKeyEvt		beq @key@dont_handle		stz <dp.result		stz <dp.result+2		;indicate that we did not take the event		brl done@key		ldy #NewTaskRecord.taskModifiers		lda [dp.ctlParam],y		;get modifiers		and #$1900		;check for control, option, command		bne @dont_handle		;we don't deal with modified keys		ldy #NewTaskRecord.taskMessage		lda [dp.ctlParam],y		;get low word of message		and #$00FF		;low byte contains ASCII code		cmp #$30 + 10		;low enough for numeral?		bcs @not_num		cmp #$30 + 0		;high enough?		bcc @not_num@numeral		jsr roll_field		;roll that number into right of string		brl @done@not_num		cmp #tabChar		;is it a TAB character?		beq @tab		cmp #up_arrow_key		beq @up		cmp #dn_arrow_key		beq @down		cmp #l_arrow_key		beq @left		cmp #r_arrow_key		beq @right@unknown				;key we don't care about		bra @dont_handle@tab		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;what is current active part?		cmp <dp.last_field		;is it the last string field?		beq @pass_target		;if so, pass target status to next control		pha			;save part number		jsr invert_part		;un-hilight that part		pla			;restore part number		sec		sbc #part_1st		;get relative part number		asl a			;word offset		tax		lda <dp.part_next,x		;move to next string part		ldy #TDCtlRec.currPart		sta [dp.ctl_ptr],y		;set new active part		jsr invert_part		;hilight new part		bra @done@pass_target		pha		pha			;LONG space for result		ldx #$2710		;MakeNextCtlTarget		jsl $E10000		pla		plx		cmp <dp.theControlHandle	;is it me?		bne @NotSame		;no		cpx <dp.theControlHandle+2		beq @done			;yes, just eat it up@NotSame				;not me		pha			;call the new one.		pha		phx		pha		pea 17			;HandleTab message		pea 0		pea 0		ldx #$2C10		;CallCtlDefProc		jsl $E10000		pla		pla		bra @done@up		ldx #$0000		;command to move value up		bra @change_value@down		ldx #$0001		;command to move value down@change_value		jsr change_value		bra @done@left		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;what is current active part?		cmp <dp.first_field		;is it the first string field?		beq @done			;don't go past 1st field		pha			;save part		jsr invert_part		;un-hilight old part		pla			;restore part number		sec		sbc #part_1st		;get relative part number		asl a			;word offset		tax		lda <dp.part_prev,x		;move left a string part		bra @new_field@right		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;what is current active part?		cmp <dp.last_field		;is it the last string field?		beq @done		pha			;save part		jsr invert_part		;un-hilight old part		pla			;restore last part		sec		sbc #part_1st		;get relative part number		asl a			;word offset		tax		lda <dp.part_next,x		;move right a string part@new_field		ldy #TDCtlRec.currPart		sta [dp.ctl_ptr],y		;set new active part		jsr invert_part		;hilight new part@done		lda #$FFFF		sta <dp.result		sta <dp.result+2		;indicate that we took the event		brl donehandleTab		lda <dp.first_field		ldy #TDCtlRec.currPart		sta [dp.ctl_ptr],y		;when we get tabbed to, make first field active		jsr invert_part		;hilight it		brl donenotifyMultipart		lda <dp.ctlParam		;get submessage		cmp #2			;is it "show entire control" ?		bne @done@show_all	; If we get here, we have just become visible. That means that the	; Control Manager will call us with the draw message TWICE, which	; messes-up our display, so we set a flag to tell the draw routine	; to ignore the SECOND of the calls.  We ignore the second call	; because that's when the vis region may be set to a limited area,	; whereas on the first call, the vis region is very large and the	; control draws correctly		ldy #TDCtlRec.drawFlag		lda #$0002		;use as counter to ignore 2nd draw message		sta [dp.ctl_ptr],y		;were we just made visible?@done		brl doneautoTrack		;brk $47		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;get MoreFlags		and #$8000		;check FCtlTarget bit		beq @abort		;if clear, we are not target		lda dp.ctlParam		;get part code		cmp #part_up		;make sure it's an arrow		bcs @continue@abort		brl done@continue		stz drawn_flag		;nothing is drawn as tracked yet				;init test rectangle		jsr set_arrow_rect		;set temp_rect to rect enclosing both arrows		lda dp.ctlParam		;get part code again		cmp #part_up		;up arrow?		bne @down@up		lda temp_rect		;get top edge		clc		adc #arrow_height+string_v_pos+1		sta temp_rect+4		;set bottom edge		lda #arrows_up>>16		;set up icon reference		sta icon_ref+2		lda #arrows_up		sta icon_ref		bra @loop			;ready to enter the track loop@down		lda temp_rect+4		;get bottom edge		sec		sbc #arrow_height+string_v_pos+1		sta temp_rect		;set top edge		lda #arrows_down>>16	;set up icon reference		sta icon_ref+2		lda #arrows_down		sta icon_ref@loop		pha			;space for result		pea 0			;read mouse button		ldx #$0F06		;WaitMouseUp		jsl $E10000		pla			;boolean result		bne @still_down		brl @done@still_down			;mouse button still down		pea mouse_pos>>16		pea mouse_pos		ldx #$0C06		;GetMouse		jsl $E10000		;where is mouse?				;now test with PtInRect		jsr pt_in_rect		;call PtInRect		bne @in		brl @out@in		lda #$8000		;use high bit as flag		tsb drawn_flag		;I always wanted to use this instruction		beq @first_down		;bit was clear, first mouse down		pha		pha			;space for result		ldx #$2503		;GetTick		jsl $E10000		pla			;get low word		sta now_tick		pla		sta now_tick+2		lda timeout_tick+2		;when do we time out?		cmp now_tick+2		;are we past that time?		bcc @timeout		;high word past it		lda timeout_tick		cmp now_tick		;low words		bcc @timeout		bra @loop			;we haven't timed out yet@first_down				;draw the arrows in hilighted state		ldx icon_ref		ldy icon_ref+2		jsr draw_arrow_icon		pha		pha			;space for result		ldx #$2503		;GetTick		jsl $E10000		pla			;low word		clc		adc #repeat_delay		;set delay before auto-repeat		sta timeout_tick		;this is tick count at next timeout		pla			;high word		adc #0		sta timeout_tick+2		bra @change_value		;first down changes value@timeout		lda now_tick		clc		adc #repeat_period		;set delay between auto-repeats		sta timeout_tick		lda now_tick+2		adc #0		sta timeout_tick+2@change_value			;change control value		;brk $4C		lda <dp.ctlParam		;get part code		sec		sbc #part_up		;this produces the proper comand number		tax		jsr change_value		;bump value and update display		brl @loop@out		lda #$8000		;use high bit as flag		trb drawn_flag		;I always wanted to use this instruction		bne @draw		brl @loop			;bit was already clear, don't do anything@draw				;draw the arrows in inactive state		ldy #arrows>>16		ldx #arrows		jsr draw_arrow_icon		brl @loop			;re-enter track loop@done				;draw the arrows in inactive state		ldy #arrows>>16		ldx #arrows		jsr draw_arrow_icon		bra donestateChange			;owner window has changed state		lda dp.ctlParam		;which way is state changing?		bne @activate		;just invalidate our rect@deactivate		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;get MoreFlags		ora #$0002		;set flag to tell draw routine that image…					;…is in inactive state		sta [dp.ctl_ptr],y@activate				;invalidate ctl rect to ensure it's in update rgn		lda dp.ctl_ptr		clc		adc #TDCtlRec.ctlRect		tax		lda dp.ctl_ptr+2		adc #0		pha		phx		ldx #$3A0E		;InvalRect		jsl $E10000@done		bra donenot_implemented		stz <dp.result		stz <dp.result+2done				;now we move the stack stuff		pea old_pen_state>>16	;restore pen in this port		pea old_pen_state		ldx #$2A04		;SetPenState		jsl $E10000		lda old_port+2		;now restore old GrafPort		pha		lda old_port		pha		ldx #$1B04		;SetPort		jsl $E10000done_no_rec			;exit point for RecSize		WITH dp		lda <old_dp		sta <old_dp+move_dist		lda <old_db		sta <old_db+move_dist		lda <return_addr+1		sta <return_addr+1+move_dist		tsc		clc		adc #move_dist+dp_size		tcs		pld			;restore direct page		plb			;restore data bank		rtl		ENDWITH				;storagedrawn_flag	ds.w 1			;keep track of whether we need to hilight…					;…when autotracking arrowstest_part		ds.w 1			;part being tested during test loopnow_tick		ds.l 1			;current tick count in track looptimeout_tick	ds.l 1			;tick count for next timeouticon_ref		ds.l 1			;current hilight icon for autoTrack		export string_bufstring_buf	ds.b string_buf_size		export month_tablemonth_table		;strings of names of months of the…			;…year		string pascal				;these strings are each 4 bytes long and are…				;…referenced by offset rather than by pointerJanuary		dc.b 'Jan'February		dc.b 'Feb'March		dc.b 'Mar'April		dc.b 'Apr'May		dc.b 'May'June		dc.b 'Jun'July		dc.b 'Jul'August		dc.b 'Aug'September		dc.b 'Sep'October		dc.b 'Oct'November		dc.b 'Nov'December		dc.b 'Dec'		export short_monthsshort_months		;months with 30 days			;note that February is special-cased in the code		dc.w 8,3,5,10	;numbers minus one of the months that have…				;…30 days				;September, April, June, November		export field_typefield_type		;table of flags to tell how a date record field is stored			;$00 = stored as-is			;$80 = stored -1			;*** these are BYTE entries !! ***		dc.b $80		;month		dc.b $80		;day		dc.b $00		;year		dc.b $00		;hour		dc.b $00		;minute		if seconds=1 then		dc.b $00		;seconds		endifinit_date_rec		;initial date record for the control		dc.b 0		;seconds		dc.b 0		;minutes		dc.b 12		;hour		dc.b 89		;year		dc.b 28-1		;day		dc.b 8-1		;month		dc.b 0		;null		dc.b 2		;weekday = Monday		;icon images for the up/down arrows		export LocInfoRecLocInfoRec		dc.w  0,0,9,20		export arrowsarrows		ds.w 1			;portSCB, filled-in at init time		dc.l  arrow_image1		;ptr to pixel image		dc.w  icon_width		;width of each line in bytes		dc.w  0,0,9,20		;RECT defining boundaryarrow_image1			;inactive arrows		dc.b $FF, $FF, $0F, $FF, $FF		dc.b $FF, $F0, $F0, $FF, $FF		dc.b $FF, $0F, $FF, $0F, $FF		dc.b $F0, $00, $00, $00, $FF		dc.b $FF, $FF, $FF, $FF, $FF		dc.b $F0, $00, $00, $00, $FF		dc.b $FF, $0F, $FF, $0F, $FF		dc.b $FF, $F0, $F0, $FF, $FF		dc.b $FF, $FF, $0F, $FF, $FFicon_size		equ * - arrowsarrows_up		ds.w 1			;portSCB, filled-in at init time		dc.l  arrow_image2		dc.w  icon_width		dc.w  0,0,9,20		;RECT defining boundaryarrow_image2			;up arrow active		dc.b $FF, $FF, $0F, $FF, $FF		dc.b $FF, $F0, $00, $FF, $FF		dc.b $FF, $00, $00, $0F, $FF		dc.b $F0, $00, $00, $00, $FF		dc.b $FF, $FF, $FF, $FF, $FF		dc.b $F0, $00, $00, $00, $FF		dc.b $FF, $0F, $FF, $0F, $FF		dc.b $FF, $F0, $F0, $FF, $FF		dc.b $FF, $FF, $0F, $FF, $FFarrows_down		ds.w 1			;portSCB, filled-in at init time		dc.l  arrow_image3		dc.w  icon_width		dc.w  0,0,9,20		;RECT defining boundaryarrow_image3			;down arrow active		dc.b $FF, $FF, $0F, $FF, $FF		dc.b $FF, $F0, $F0, $FF, $FF		dc.b $FF, $0F, $FF, $0F, $FF		dc.b $F0, $00, $00, $00, $FF		dc.b $FF, $FF, $FF, $FF, $FF		dc.b $F0, $00, $00, $00, $FF		dc.b $FF, $00, $00, $0F, $FF		dc.b $FF, $F0, $00, $FF, $FF		dc.b $FF, $FF, $0F, $FF, $FF		ENDP		include 'td.ctl.tables'		export div_tendiv_ten		PROC		;divide a value in the range 0 to 99 into tens…				;…part and ones part				;enter with value in accumulator				;exit with ones in Y, tens in X		ldx #$FFFF		;init tens counter		sec			;prepare for first subtraction@10		inx			;bump tens count		tay			;save last value < 10		sbc #10			;carry should always be set		bcs @10@tens_done		rts		ENDP		export hex_to_asciihex_to_ascii	PROC		;convert a value in the range 0 to 99 into ascii…				;…representation				;enter with value in accumulator				;exit two characters in accum		ldx #$FFFF		;init tens counter		sec			;prepare for first subtraction@10		inx			;bump tens count		tay			;save last value < 10		sbc #10			;carry should always be set		bcs @10@tens_done		sep #$20			;8-bit accum		LONGA OFF		tya			;move ones value to low byte		xba			;flip bytes		txa			;move tens digit to low byte		rep #$21			;16-bit accum, clear carry		LONGA ON		adc #'00'			;convert to ACSII. carry should be clear		rts		ENDP		export calc_c_coordcalc_c_coord	PROC		;calculate character pixel coordinate				;enter with character number in Accum				;return with pixel coordinate in Accum		tax			;get counter in x		beq add_left		;if 0, just add left edge@do_multiply		lda #0			;init result		ldy #TDCtlRec.cwidth	;point to character width		clc			;prepare for adds@loop		adc [dp.ctl_ptr],y		dex		bne @loopadd_left				;now add coordinate of left edge		ldy #TDCtlRec.ctlRect+2	;point to left edge of control rect		clc		adc [dp.ctl_ptr],y		;add left edge of ctl rect		adc #string_h_pos		;adjust for space from frame		rts		ENDP		export pt_in_rectpt_in_rect	PROC		;call PtInRect with point in the result stack frame and…				;…the rectangle in temp_rect		pha			;space for result		pea mouse_pos>>16		;this is the point of interest		pea mouse_pos					;…of the point passed to us on the stack		pea temp_rect>>16		pea temp_rect		ldx #$4F04		;PtInRect		jsl $E10000		pla			;get boolean result		rts		ENDP		export invert_partinvert_part	PROC		;invert rectangle belonging to a part				;enter with part in accumulator		sec		sbc #part_1st		;get relative part number		asl a			;word offset		pha			;save for below		tax		lda <dp.part_left,x		;get character position		jsr calc_c_coord		;get its coordinate in window		sta temp_rect+2		;set left edge		plx			;restore index		phx			;leave on stack still		lda <dp.part_right,x	;get character position		jsr calc_c_coord		;get its coordinate in window		plx			;restore index again		cpx #(part_am_pm-part_1st)*2	;was it the am/pm field?		adc #$0000		;carry set if am/pm field, will push…					;…right edge out 1 pixel		sta temp_rect+6		;set right edge		ldy #TDCtlRec.ctlRect+4	;point to bottom edge of control rect		lda [dp.ctl_ptr],y		dec a			;pull in 1 pixel from edge		dec a		sta temp_rect+4		;set bottom edge		ldy #TDCtlRec.ctlRect	;point to top edge of control rect		lda [dp.ctl_ptr],y		inc a			;pull in 1 pixel from edge		inc a		sta temp_rect		;set top edge		pea temp_rect>>16		pea temp_rect		ldx #$5604		;InvertRect		jsl $E10000		;this should invert the part		rts		ENDP		export draw_arrow_icondraw_arrow_icon	PROC		;draw one of the various arrow icons		import LocInfoRec				;enter with icon refernce in X (low) and Y (high)		phy			;high word of icon reference		phx			;low word  "   "       "		pea LocInfoRec>>16		pea |LocInfoRec		ldy #TDCtlRec.arrowPos		lda [dp.ctl_ptr],y		;get position of arrows		ldy #TDCtlRec.ctlRect+2	;point to left edge		clc		adc [dp.ctl_ptr],y		;add left edge		pha				ldy #TDCtlRec.ctlRect		lda [dp.ctl_ptr],y		;get top edge		clc		adc #string_v_pos		pha		lda #0			;pen mode = modeCopy		pha		ldx #$D604		;PPToPort		jsl $E10000		;draw the icon		rts		ENDP		export build_stringbuild_string	PROC		;build the display string		import string_buf		import hex_to_ascii		import month_table		ldx <dp.string_size		dex		dex			;point behind last word in string		lda #'  '			;go by word@loop		sta string_buf+1,x		;init string to spaces		dex		dex		bpl @loop			;note that if string_size is an odd…					;…number, we miss the first byte		ldy #TDCtlRec.ctlFlag		lda [dp.ctl_ptr],y		;check ctl type		and #$0002		;this bit always set if date needed		beq time			;no date, go do timedate@month		ldy #TDCtlRec.dateRec + gsos_date.day		lda [dp.ctl_ptr],y		;get day and month values		pha			;save on stack		xba			;move month to low byte		and #$00FF		;byte only		asl a		asl a			;index into string table, 4 bytes each		tax		ldy <dp.part_left+month_index		lda month_table+1,x		;copy the 3-character month string		sta string_buf+1,y		lda month_table+2,x		sta string_buf+2,y@day		pla			;restore month and day		and #$00FF		;keep day byte only		inc a			;adjust, since they start at 0		cmp #10			;check for number less than 10		php			;save result		jsr hex_to_ascii		plp			;restore compare to 10		bcs @day_ok		;day 10 or greater		eor #(' ' EOR '0')		;change leading 0 to a space@day_ok		ldy <dp.part_left+day_index		sta string_buf+1,y@year		ldy #TDCtlRec.dateRec + gsos_date.hour		lda [dp.ctl_ptr],y		;get hour and year values		xba			;move year to low byte		and #$00FF		;keep low byte only		cmp #100			;later than 1999?		bcc @20_cent		;no, 20th century@21_cent		;sec			;carry is set		sbc #100			;get MOD 100		pea '02'			;ASCII for year 20XX		bra @convert@20_cent		pea '91'			;ASCII for year 19XX@convert		jsr hex_to_ascii		ldy <dp.part_left+year_index		sta string_buf+3,y		;store to last 2 digits in year		;lda #'91'			;year is always "19XX"		pla			;get ASCII digits for century		ldy <dp.part_left+year_index		sta string_buf+1,y		;copy to year field in string		ldy #TDCtlRec.ctlFlag		lda [dp.ctl_ptr],y		;check ctl type		ror a			;this bit always set if time needed		bcs time			;if set, continue		brl touch_up		;no time, just pack uptime@hour		ldy #TDCtlRec.dateRec + gsos_date.hour		lda [dp.ctl_ptr],y		;get hour and year values		and #$00FF		;keep hour		tax			;save while we check hour format		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		;find out whether 24 hr or 12 hr					;bit 0 is hour format flag		ror a		ror a			;move low bit to high		sta hour_flag		;keep for handy reference		asl a			;test it now		bcs @hour_number		;if 24-hour, just use the number@12		txa			;restore hour value		bne @not_midnight		lda #24			;midnight stored as 0@not_midnight		;inc a			;adjust because they start at 0		ldy #'MA'			;anticipate AM		cmp #12			;range check the hour value		beq @pm			;if 12, we use PM by convention		bcc @store		;if less than 12, use value as-is		sec			;hour greater than 12		sbc #12			;preserve 12-hour format		cmp #12			;is it 12 again?		beq @store@pm		ldy #'MP'			;if we get here, we have a PM hour@store		tax			;save accum		tya			;move 2 characters to accum		ldy <dp.part_left+am_pm_index		sta string_buf+1,y@hour_number		txa			;restore accum		cmp #10			;check for number less than 10		php			;save result		jsr hex_to_ascii		;convert hour value in accum		plp			;restore compare to 10		bcs @hour_ok		;hour 10 or greater		bit hour_flag		;24-hour format?		bmi @hour_ok		;keep leading zeros		eor #(' ' EOR '0')		;change leading 0 to a space@hour_ok		ldy <dp.part_left+hour_index		sta string_buf +1,y		;store to hour field in string@minute		if seconds = 1 then		ldy #TDCtlRec.dateRec + gsos_date.seconds		lda [dp.ctl_ptr],y		;get seconds and minutes		pha			;save for seconds below		and #$FF00		;keep minutes in high byte		xba		else		ldy #TDCtlRec.dateRec + gsos_date.minutes		lda [dp.ctl_ptr],y		;get minutes value		and #$00FF		;byte only		endif		jsr hex_to_ascii		ldy <dp.part_left+minute_index		sta string_buf +1,y		;store to minute field in string		sep #$20			;single characters		LONGA OFF		lda #':'		ldy <dp.part_left+hour_index		sta string_buf+3,y		;add colon after hour		if seconds=1 then		;code to handle seconds field		rep #$20		LONGA ON@second		pla			;restore minutes and seconds		and #$00FF		;keep seconds only		jsr hex_to_ascii		;get 2 characters in accum		ldy <dp.part_left+second_index	;get offset in string to field		sta string_buf+1,y		;store number characters in string		sep #$20			;single characters		LONGA OFF		lda #':'		ldy <dp.part_left+minute_index		sta string_buf+3,y		;add colon after minute		endiftouch_up				;fix string size		sep #$20			;single characters		LONGA OFF		lda <dp.string_size		sta string_buf		;set length byte		rep #$20		LONGA ON		rts		ENDP		export draw_fielddraw_field	PROC		;draw a text field with given text mode		import calc_c_coord				;enter with:	part number in accumulator				;		text mode in X		sta part			;save part number		stx text_mode		;save text mode		pha			;space for result		ldx #$9904		;GetFontFlags		jsl $E10000		;leave old FontFlags on stack		pha			;space for result		ldx #$9D04		;GetTextMode		jsl $E10000		lda part		sec		sbc #part_1st		;get relative part number		asl a			;use as word offset		tax			;index		lda <dp.part_left,x		;get left character position		clc		adc #<string_buf+1		;get pointer to text		tay			;save low part		lda #^string_buf+1		bcc @no_carry		inc a@no_carry		pha			;push low part of string ptr		phy			;push high part		lda <dp.part_right,x	;get right character position		sec		sbc <dp.part_left,x		;get number of characters		pha			;stack is now set up for DrawText		lda <dp.part_left,x		;get left character position again		jsr calc_c_coord		pha		dey		dey			;back to top edge		lda [dp.ctl_ptr],y		;get y coordinate		clc		adc #8+string_v_pos		;add ascent for Shaston font + adjustment		pha			;push y coordinate		ldx #$3A04		;MoveTo		jsl $E10000		lda text_mode		pha		ldx #$9C04		;SetTextMode		jsl $E10000		pea $0002			;select numeric spacing for DrawString		ldx #$9804		;SetFontFlags		jsl $E10000		ldx #$A704		;DrawText		jsl $E10000		;stack is set up for this call		ldx #$9C04		;SetTextMode		jsl $E10000		;restore previous text mode					;previous FontFlags word is still on stack		ldx #$9804		;SetFontFlags		jsl $E10000		rtspart		ds.w 1text_mode		ds.w 1		ENDP		export bump_fieldbump_field	PROC		;bump value of a field up or down by 1		import short_months		import part_to_offset	;enter with:	part number in accum	;		command in X: 0 = inc, 1 = dec		stx command		;save inputs		asl a			;convert part # to word offset		tax		jmp (jump_tbl-(part_month*2),x)jump_tbl		dc.w month		dc.w day		dc.w year		dc.w hour		dc.w minute		if seconds = 1 then		dc.w second		endif		dc.w am_pmmonth		ldy #TDCtlRec.dateRec + gsos_date.day		lda [dp.ctl_ptr],y		;get day and month values		pha			;save for later		jsr general_case		;bump month. X must be part num *2@check_day			;now make sure day value is OK for new month		jsr get_month_max		;month should still be in accumulator		pla			;restore day & month		and #$00FF		;keep low byte only		cmp month_max		;is current day too high?		bcc @day_ok		lda month_max		;if day was over, use maximum allowed value		dec a			;adjust because days start at 0		ldy #TDCtlRec.dateRec + gsos_date.day		brl store1		;store value and return@day_ok		rtsday		phx			;save part num*2		ldy #TDCtlRec.dateRec + gsos_date.month		lda [dp.ctl_ptr],y		;get month value		and #$00FF		jsr get_month_max		;set up number of days in that month in month_max		plx			;restore part num*2		tya			;month_max is in Y		sta field_max-(part_month*2),x	;store month_max into table		bra general_case		;bump value, store, and returnyear		;jsr general_case		;bump value, store	;now support years 1940-2039		ldy #TDCtlRec.dateRec + gsos_date.year		lda [dp.ctl_ptr],y		;get year value		and #$00FF		ldy command		beq yr_upyr_dn		dec a		bmi @underflow		;if negative, we definitely went too low		cmp #40			;minimum year is 1940		bcs yr_str		;branch if OK@underflow		lda #139			;max is year 2039		bra yr_stryr_up		inc a		cmp #140			;max year is 2039		bcc yr_str		lda #40			;min year 1940yr_str		ldy part_to_offset-(part_1st*2),x	;get index into date record		sep #$20		LONGA OFF		sta [dp.ctl_ptr],y		;set value		rep #$20		LONGA ON				;return with year in accum@check_feb_29			;special-case check when switching from a leap year		and #$0003		;keep lowest 2 bits		beq @done			;if now a leap year, we're OK		ldy #TDCtlRec.dateRec + gsos_date.day		lda [dp.ctl_ptr],y		;get day and month values		cmp #$011C		;is it February 29?		bne @done@fix		lda #$011B		;February 28		sta [dp.ctl_ptr],y@done		rtsam_pm		ldy #TDCtlRec.dateRec + gsos_date.hour		lda [dp.ctl_ptr],y		;get hour value		and #$00FF		;keep low byte		cmp #12			;what range is it in?		bcs @high@low		adc #12			;switch to other range. carry is clear		bra store1		;store value and return@high		sbc #12			;switch to other range. carry is set		bra store1		;store value and returnhourminutesecondgeneral_case			;internal subroutine to handle general case of bumping…				;…a field up or down				;enter with:	part number times 2 in X		ldy part_to_offset-(part_1st*2),x	;get offset to field in control record		sty daterec_index		lda [dp.ctl_ptr],y		;get field value		and #$00FF		;keep low byte		ldy command		beq incdec		dec a		;bmi @underflow		;if negative, we definitely went too low		bpl store			;if positive, we're ok;@underflow		lda field_max-(part_month*2),x	;wrap to maximum value		dec a			;table contains (max value -1)		bra storeinc		inc a		cmp field_max-(part_month*2),x	;overflow?		bne store		lda #$0000		;wrap to min valuestore		ldy daterec_index		;restore index into date recordstore1		sep #$20		LONGA OFF		sta [dp.ctl_ptr],y		;set value		rep #$20		LONGA ON		rts		export month_maxmonth_max		ds.w 1command		ds.w 1daterec_index	ds.w 1field_max			;table of maximum values +1 for each field by part number		dc.w 12		;month		ds.w 1		;day, must be filled in!		dc.w 100		;year	** no longer used; now support  **				;	** years 1940-2039		  **		dc.w 24		;hour		dc.w 60		;minute		if seconds = 1 then		dc.w 60		;second		endif;		*****************		export get_month_maxget_month_max			;internal subroutine to determine number of days in…				;…given month				;enter with month in accumulator		cmp #1			;is it February?		bne @not_feb@february		ldy #TDCtlRec.dateRec + gsos_date.year		lda [dp.ctl_ptr],y		;must check for leap year		ldy #29			;assume leap year		and #$0003		;keep lowest 2 bits (OK for yr 2000)		;beq @leap		beq @store_y_days@not_leap		;lda #28			;days in Feb in non-leap year		dey			;one less day on non-leap year		bra @store_y_days@leap		;lda #29		;bra @store_days@not_feb		ldy #30			;assume short month		ldx #6			;there are 4 months with 30 days@loop		cmp short_months,x		beq @30			;if it's on the list, it has 30 days		dex		dex		bpl @loop@31		iny			;bump Y to 31@30@store_y_days		;tya		;bra @store_days;@30		;lda #30;@store_days		sty month_max		rts		ENDP		export set_field_rectset_field_rect	PROC		;set temp_rect to rectangle enclosing a string field				;enter with:	part # in accum				;	long_field_flag = 0 --> include white…				;			    …space				;		      = 1 --> don't include		sec		sbc #part_1st		;get relative part number		asl a			;use as word offset		pha			;save for below		tax			;index		lda <dp.part_left,x		;get left character position		jsr calc_c_coord		sta temp_rect+2		;store in left edge		plx			;restore index		ldy long_field_flag		;test whether we want whitespace		beq @no_space		;if 0, no space@space		lda <dp.part_next,x		;get his right neighbor		beq @no_space		;no right neighbor, no space		sec		sbc #part_1st		;normalize part #		asl a			;word offset		tax		lda <dp.part_left,x		;get start of next field		bra @calc			;go calculate pixel position@no_space		lda <dp.part_right,x	;get right character position@calc		jsr calc_c_coord		sta temp_rect+6		;store in right edge		ldy #TDCtlRec.ctlRect	;point to top edge of control rect		lda [dp.ctl_ptr],y		sta temp_rect		;set top edge		ldy #TDCtlRec.ctlRect+4	;point to bottom edge of control rect		lda [dp.ctl_ptr],y		sta temp_rect+4		;set bottom edge		stz long_field_flag		;reset that flag		rts		ENDP		export change_valuechange_value	PROC		;change current field value by 1 and update the display				;enter with:	command in X; 0 = up, 1 = down		import bump_field		import build_string		import draw_field		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;what field are we changing?		pha			;save for later		jsr bump_field		;inc or dec the value		jsr build_string		;build new string		lda 1,s			;restore part code of field		ldx #$8000		;draw it inverted		jsr draw_field		;display new value		pla			;restore part again		cmp #part_month		beq @fix_day		;if month, day may have changed		cmp #part_hour		beq @fix_am_pm		;if hour, am/pm indicator may have changed		cmp #part_year		beq @fix_day		;if year, may have Feb 29 on non-leap year		rts@fix_day		lda #part_day		ldx #$0000		;use pen modeCopy		jsr draw_field		rts@fix_am_pm		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		and #$0001		;24-hour format?		bne @24			;if so, no AM/PM field		lda #part_am_pm		ldx #$0000		;use pen modeCopy		jsr draw_field@24		rts		ENDP		export draw_framedraw_frame	PROC		;draw box around control		;brk $86		lda <dp.ctl_ptr		;get address of control record		clc		adc #TDCtlRec.ctlRect	;compute address of control rect		tax		lda <dp.ctl_ptr+2		adc #0		pha			;push ptr to control rect		phx		ldx #$5304		;FrameRect		jsl $E10000		rts		ENDP		export hide_framehide_frame	PROC		;erase box around control		pea $8000			;pen mode notCopy		ldx #$2E04		;SetPenMode		jsl $E10000		lda <dp.ctl_ptr		;get address of control record		clc		adc #TDCtlRec.ctlRect	;compute address of control rect		tax		lda <dp.ctl_ptr+2		adc #0		pha			;push ptr to control rect		phx		ldx #$5304		;FrameRect		jsl $E10000		ldx #$3604		;PenNormal		jsl $E10000		rts		ENDP		export roll_fieldroll_field	PROC		;roll number into string representation of numeric field value	;enter with:	;	A	= ASCII code of numeric key ($30+number)		import month_max		import get_month_max		;brk $85		sec		sbc #$30			;make into real number		sta number		;save it		ldy #TDCtlRec.currPart		lda [dp.ctl_ptr],y		;what part is active?		cmp #part_month		beq @no_roll		;don't deal with month@next1		if seconds = 1 then		cmp #part_second+1		;highest acceptable		else		cmp #part_minute+1		;highest acceptable		endif		bcc @cont@no_roll		brl done			;must be AM/PM field@cont				;get here with part # in accum		sta part_code		asl a			;*2		tax			;use as table index		ldy part_to_offset-(part_1st*2),x	;get offset to field in control record		sty field_index		;use later		lda [dp.ctl_ptr],y		;get value of field		tax			;save for moment		and #$FF00		;get unused byte		sta old_field		;save it		txa			;restore original full word		and #$00FF		;keep our part only		ldx part_code		cpx #part_hour		beq @hour			;hour is special@check_inc		bit field_type-part_1st-1,x	;test field_type byte in high byte of access		bpl @no_inc		;if high bit clear, stored as-is@inc		inc a		bra @not_hour@hour				;if hour, may have to convert to 12-hour number		stz hour_adjust		;assume AM, or 24-hour format		tax			;save hour value while we check format		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		ror a			;test low bit		ror hour_flag		;roll to high bit for easy reference		bpl @12			;is it 24-hour?@24		lda #23+1		sta hour_limit		;set limit for hour to 23		txa		bra @am			;treat it like AM now@12		lda #12+1		sta hour_limit		txa			;restore hour value for display		bne @not_midnight		lda #12			;midnight stored as 0		bra @am			;set to adjust back later@not_midnight		cmp #12			;in PM range?		beq @set_adjust		;if noon, count as pm, but don't subtract		bcc @am		sec		sbc #12@set_adjust		ldy #12		sty hour_adjust@am@not_hour@no_inc		jsr div_ten		;get ones in Y, tens in Xrecalc				;calculate new value		lda #0-10			;init value@tens_loop		clc			;we need this inside loop b/c we start with neg value		adc #10		dey			;use old ones value as tens counter		bpl @tens_loop@ones		clc			;carry will be set if ten_loop executed once		adc number		;carry should be clear		ldx part_code		bit field_type-part_1st-1,x	;test field_type byte in high byte of access		bpl @no_dec		;if high bit clear, stored as-is@dec					;hour and day are stored -1		dec a		bpl @dec_ok		;OK as long as we didn't underflow@underflow		inc a			;put it back to 0@dec_ok@no_deccheck_range		ldx part_code		cpx #part_year		bne @not_year@year		cmp #40			;did we get value less than 1940?		bcs @check_feb_29		;no, we're OK		clc		adc #100			;year less than 1940, move ahead 100 yrs@check_feb_29		pha			;save year on stack		and #$0003		;keep lowest 2 bits		beq @year_done		;if now a leap year, we're OK		ldy #TDCtlRec.dateRec + gsos_date.day		lda [dp.ctl_ptr],y		;get day and month values		cmp #$011C		;is it February 29?		bne @year_done@fix_year		lda #$1B00		;day 28 in high byte		sta old_field		;this happens to contain the day!@year_done		pla			;restore year		bra @range_ok@not_year		cpx #part_day		bne @not_day@day		pha			;save day value		ldy #TDCtlRec.dateRec + gsos_date.month		lda [dp.ctl_ptr],y		;get month value		and #$00FF		jsr get_month_max		;set up number of days in that month in month_max		pla			;restore our day value		cmp month_max		;are we over?		bcc @range_ok		lda number		;just use indicated digit		beq @range_ok		;if 0, don't decrement, will be converted…					;…to day 1		dec a			;convert back to record format		bra @range_ok@not_day		cpx #part_hour		bne @not_hour@hour		cmp hour_limit		bcc @hour_ok@fix_hour		lda number		;use indicated digit@hour_ok		bit hour_flag		;24-hour format?		bmi @range_ok		;we're covered for 24-hour format		cmp #12			;are we past end of am/pm range?		bne @hour_ok2		lda #0			;wrap to 0 within am/pm range@hour_ok2		clc		adc hour_adjust		;add 12 if it was PM		bra @range_ok@not_hour@minutes_seconds				;must be minutes or seconds		cmp #60		bcc @range_ok		lda number		;just use given digit@range_ok				;enter with new field value in Accum		ora old_field		;OR-in unused byte		ldy field_index		sta [dp.ctl_ptr],y		;update value		jsr build_string		;build new string		lda part_code		;restore part code of field		ldx #$8000		;draw it inverted		jsr draw_field		;display new value		lda part_code		cmp #part_year		;did we change the year?		bne done@update_day		lda #part_day		ldx #$0000		;use pen modeCopy		jsr draw_field		;draw it just in casedone		rts		export part_to_offsetpart_to_offset			;field value offsets in control record, indexed by part number				;starts with part_month		WITH TDCtlRec		dc.w dateRec + gsos_date.month		dc.w dateRec + gsos_date.day		dc.w dateRec + gsos_date.year		dc.w dateRec + gsos_date.hour		dc.w dateRec + gsos_date.minutes		if seconds = 1 then		dc.w dateRec + gsos_date.seconds		endif		ENDWITH				;storagenumber		ds.w 1field_index	ds.w 1old_field		ds.w 1part_code		ds.w 1hour_adjust	ds.w 1hour_limit	ds.w 1		ENDP		export set_up_tableset_up_table	PROC		;get correct format table and patch for various…				;…formats if necessary				;copy format table to direct-page		ldy #TDCtlRec.formatRef		lda [dp.ctl_ptr],y		;get pointer to format table		sta <dp.table_ptr		export set_up_table2set_up_table2			;alternate entry pt, does NOT set up pointer to table		ldy #table_length-2		;point to last word in table@loop1		lda (dp.table_ptr),y		tax			;next addr mode only supported for X-reg!!		stx <dp.format_table,y	;copy onto direct-page		dey		dey		bpl @loop1				;check for type of control		ldy #TDCtlRec.ctlFlag		lda [dp.ctl_ptr],y		;get flags byte		and #$0003		;lower 2 bits are control type:					;	01 = time only					;	10 = date only					;	11 = time and date					;	00 = bad value		dec a		beq @time_only  		dec a		bne @both@date_only			;patch out time fields;	figure out how much to adjust size of string	if table3 = 1 then		;do we need year-month-day?		lda dp.part_prev+hour_index	;find out what field comes before hour		sec		sbc #part_1st		;normalize		asl a			;use as word offset		tax		lda dp.part_right,x		;get right position of last date field		clc		adc dp.string_size		;next we subtract right position of…					;…last time field so we wind up…					;…subtracting a difference		stz dp.part_next,x		;terminate right neighbor link list	else		lda dp.string_size		clc		adc dp.part_right+year_index	;add right position of year_field	endif				;get here with sum of string length and position…				;…of end of last date field		sec		sbc dp.part_right+am_pm_index	;subtract right position of am/pm field		sta dp.string_size;	terminate right neighbor link list	if table3 <> 1 then		;no support for year-month-day?		stz dp.part_next+year_index	;indicate that year has no right neighbor	endif				;this was already done in code generated…					;…for year-month-day;	set new last field	if table3 = 1 then		;do we need year-month-day?		lda dp.part_prev+hour_index	;what is the last field now?	else		lda #part_year		;we know last field if there is no…					;…year-month-day format	endif		sta dp.last_field		bra done			;setup is done@time_only;	adjust character positions now that date is gone				;figure out how much to adjust by		lda dp.part_left+hour_index	;offset in characters		eor #$FFFF		;complement so we can add, but is ONE LESS		tay			;keep in register				;field positions by # of chars in date portion		sec			;use carry set b/c complement is off by 1!!		adc dp.string_size		;subtract hour offset		sta dp.string_size		ldx #(part_am_pm-part_year)*2	;index across word for each time field in loop@time_loop		;adjust string positions of time fields			;enter with complement-1 of adjustment in Y		tya			;restore complement of hour position -1		sec			;use carry set b/c complement is off by one!!		adc dp.part_right+hour_index-2,x	;subtract hour offset		sta dp.part_right+hour_index-2,x	;put back		tya			;restore complement of hour position -1		sec			;use carry set b/c complement is off by one!!		adc dp.part_left+hour_index-2,x	;subtract hour offset		sta dp.part_left+hour_index-2,x	;put back		dex		dex			;pull index back a word		bne @time_loop;	terminate left neighbor link list		stz dp.part_prev+hour_index		;hour has no left neighbor		lda #part_hour		sta dp.first_field		lda #part_am_pm		sta dp.last_field@both				;now patch table if 24-hour format		ldy #TDCtlRec.ctlMoreFlags		lda [dp.ctl_ptr],y		and #$0001		;24-hour format?		beq @12			;branch if 12-hour format@24				;patch-out AM/PM field in table		lda dp.string_size		dec a		dec a		dec a			;account for space and 2 characters		sta dp.string_size		if seconds = 1 then		stz dp.part_next+second_index	;indicate that seconds field has no right neighbor		else		stz dp.part_next+minute_index	;indicate that minutes field has no right neighbor		endif		dec dp.last_field		;bump down to minutes@12done		rts		ENDP		export hide_arrowshide_arrows	PROC		;erase rect where arrows are drawn		import set_arrow_rect				;first set up rectangle that contains arrows		jsr set_arrow_rect		;set temp_rect to rect enclosing both arrows		pea temp_rect>>16		pea temp_rect		ldx #$5504		;EraseRect		jsl $E10000		;erase the arrows		rts		ENDPset_arrow_rect	PROC		;set temp_rect to rect enclosing both arrows		import arrows		ldy #TDCtlRec.ctlRect	;point to top edge of control rect		lda [dp.ctl_ptr],y		inc a			;move 1 pixel from frame		sta temp_rect		;set top edge		ldy #TDCtlRec.ctlRect+4	;point to bottom edge of control rect		lda [dp.ctl_ptr],y		dec a			;move 1 pixel from frame		sta temp_rect+4		;set bottom edge		ldy #TDCtlRec.arrowPos		lda [dp.ctl_ptr],y		;get arrow position		ldy #TDCtlRec.ctlRect+2	;point to left edge		clc		adc [dp.ctl_ptr],y		;add left edge		sta temp_rect+2		lda #arrow_width		bit arrows-1		;test SCB		bmi @640@320		lsr a			;divide by 2 for 320 mode@640		clc		adc temp_rect+2		;add to left edge		sta temp_rect+6		;set right edge		rts		ENDP		END