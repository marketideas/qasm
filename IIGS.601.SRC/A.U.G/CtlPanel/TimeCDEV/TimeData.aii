;;;	timedata - data records and strings used by time CDEV.;;	Michael V. Stein	03/30/90.;;	© Apple, 1990.	blanks	off	;;	equates.moontop		equ	50		top of moon textdaytop		equ	40		top of day of year textfam1top		equ	daytop+29	top of family 1 radio buttonsfam2left  	equ	112		family 2 left indentfam3top		equ	fam1top+45	top of family 3 radio buttonsleftedge  	equ	5		leftedge for controlsradio1ID	equ	10radio4ID	equ	radio1ID+3	ID of 4th radio controlradio6ID  	equ	radio4ID+2	ID of 6th radio controlcheckID		equ	radio6ID+2	ID of checkboxRightEdge	equ	195rspace		equ	12		spacing between radio buttons;;	include files.	include	'e16.control'	include	'm16.util';;	main program.timedata	proc;;	exported addresses.	export	about	export	check1	export	ctllist	export	dayctl	export	daylen	export	dctl	export	radio1	export	radio2		export	radio3	export	radio4	export	radio5	export	radio6	export	radio7	export	tctl			;;	imported addresses.	import	cdsa		import	time_date_defproc			ctllist  dc.l	radio1	dc.l	radio2		dc.l	radio3	dc.l	radio4	dc.l	radio5	dc.l	radio6	dc.l	radio7	dc.l	check1	dc.l	line1	dc.l	line2	dc.l	0;	control for setting the date.dctl	dc.w	6	dc.l	2		ID	dc.w	20,50,0,0	rect	dc.l	time_date_defproc	dc.w	ctlInvis+2	flags - date control	dc.w	fctlcanbetarget+$400	dc.l	0		refcon;	control for setting the time.tctl	dc.w	6	dc.l	3		ID	dc.w	5,50,0,0	rect	dc.l	time_date_defproc	dc.w	ctlInvis+1	flags	dc.w	fctlcanbetarget+$400	dc.l	0		refcon		;	control for the about box.About	dc.w	8	dc.L 	1	dc.w 	38,5,138,280	dc.L 	$81000000	dc.w 	$0000	dc.w 	$1000	dc.L 	0	dc.L 	AboutText	dc.w 	AboutTextL	string 	asisAboutText	dc.b 	'The Time Control Panel allows you to set the clock and change the display '	dc.b 	'formats for date and time in your machine.'		dc.b	'  The radio buttons can be used '	dc.b 	'to manually adjust the clock to compensate for daylight '	;	dc.b	'savings time.  Check the Auto daylight savings checkbox ';	dc.b	'only if your area follows US daylight savings time.'	dc.b	'savings time.  Set the checkbox '		dc.b	'to have the clock automatically adjust for daylight '	dc.b	'savings time in the future (April and October).'	AboutTextL  equ	*-AboutText;	day of year control.dayctl	dc.w	8		PCount	dc.l	5		ID	dc.w	daytop		rectangle	dc.w	leftedge	dc.w	daytop+18	dc.w	rightedge	dc.l	stattextcontrol	dc.w	1		flag (pascal strings)	dc.w	FctlProcRefNotPtr  more flags	dc.l	0		refcon	dc.l	cdsa		constructed in time.aiidaylen	dc.w	30				;	date format radio button mm/dd/yy.radio1	dc.w	8		Pcount	dc.l	radio1ID		ID	dc.w	fam1top	dc.w	leftedge	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio1T		ptr to title	dc.w	0		initial valueradio1t	str	'MM/DD/YY';	date format radio button dd/mm/yy.radio2	dc.w	8		Pcount	dc.l	radio1ID+1		ID	dc.w	fam1top+rspace	dc.w	leftedge	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio2T		ptr to title	dc.w	0		initial valueradio2t	str	'DD/MM/YY';	date format for radio button  yy/mm/dd.radio3	dc.w	8		Pcount	dc.l	radio1ID+2		ID	dc.w	fam1top+rspace*2	dc.w	leftedge	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio3T		ptr to title	dc.w	0		initial valueradio3t	str	'YY/MM/DD';	hour format radio button  am/pm.radio4	dc.w	8		Pcount	dc.l	radio4id	ID	dc.w	fam1top	dc.w	leftedge+fam2left	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	2		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio4T		ptr to title	dc.w	0		initial valueradio4t	str	'AM/PM';	hour format radio button  24 hour.radio5	dc.w	8		Pcount	dc.l	radio4ID+1	ID	dc.w	fam1top+rspace	dc.w	leftedge+fam2left	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	2		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio5T		ptr to title	dc.w	0		initial valueradio5t	str	'24 Hour';	standard time radio button.radio6	dc.w	8		Pcount	dc.l	radio6ID	ID	dc.w	fam3top	dc.w	leftedge	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	3		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio6T		ptr to title	dc.w	0		initial valueradio6t	str	'Standard Time';	daylight time radio button.radio7	dc.w	8		Pcount	dc.l	radio6ID+1	ID	dc.w	fam3top+rspace	dc.w	leftedge	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	3		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio7t		ptr to title	dc.w	0		initial valueradio7t	str	'Daylight Time';	checkbox for auto-daylight savings.check1 	dc.w 	8		PCount	dc.L 	checkID		ID	dc.w 	fam3top+rspace*2	dc.w	leftedge	dc.w	0	dc.w	0	dc.L 	checkcontrol		dc.w 	0		flag	dc.w 	$1000		moreflags	dc.L 	0		refcon	dc.L 	check1t		ptr to title	dc.w 	0		initial value	check1t	str 'Auto daylight savings'	;	dividing line.line1	dc.w	8		Pcount	dc.l	18		ID	dc.w	fam1top-14	dc.w	leftedge	dc.w	fam1top-14+10	dc.w	rightedge			dc.l	stattextcontrol		dc.w	1		flag pascal string	dc.w	fctlProcRefNotPtr	more flags	dc.l	0		refcon	dc.l	line2t	dc.w	23line2	dc.w	8		Pcount	dc.l	19		ID	dc.w	fam3top-14	dc.w	leftedge	dc.w	fam3top-14+10	dc.w	rightedge			dc.l	stattextcontrol		dc.w	1		flag pascal string	dc.w	fctlProcRefNotPtr	more flags	dc.l	0		refcon	dc.l	line2t	dc.w	23line2t	dc.b	'_______________________'		endp	end