*********************************************************************************			DirectConnect CDEV***		Copyright 1988,1989 Apple Computer, Inc.*			All rights reserved***		Written by : 	Tim Harrington*				     and*				Scott Kuechle*********************************************************************************** Revision History** 1.0e14    3/21/89   TGH	-First try at this thing.* 1.0d16    3/29/89   TGH	-First public release.* 1.1d1	    3/20/90   MVS	Version 1.1*				User can now select LaserWriter so postscript files*				can be generated.  Lists are now sorted.  Makes sure*				that starting selection is always visible.*                               A whole bunch of changes by Monte.*           8/15/91   BAK	Added dialog if error on read or write PRINTER.SETUP.*           8/16/91   BAK	If AppleShare FST is the boot FST (ie, we booted from*				the network), then the path to PRINTER.SETUP is as*				follows: "{GetUserPath FST specific call}:Printer.Setup".********************************************************************************		msb	off		string	asis		INCLUDE	'M16.UTIL'		INCLUDE	'M16.GSOS'		INCLUDE	'M16.CONTROL'		INCLUDE	'M16.MISCTOOL'		INCLUDE 'M16.LIST'		INCLUDE	'M16.MEMORY'		INCLUDE	'M16.INTMATH'		INCLUDE	'M16.PRINT'		include 'M16.QUICKDRAW'		include 'M16.WINDOW'		include 'M16.DIALOG'		include	'e16.dialog'		INCLUDE	'E16.CONTROL'		ENTRY	bogusCDEV,\			InitCDEV,\			CloseCDEV,\			CreateCDEV,\			AboutCDEV		ENTRY	C2Printer,CPort		ENTRY	WriteData		ENTRY	screenF :data		import	sulzp0		equ	0		;Zero page usezp1		equ	zp0+4zpsize		equ	zp1+4		;Length of zero page.MemRecSize	equ	5		;Size of each member record.*##############################################################################** Below is the main entry point for this CDEV.  All messages (commands)* passed to the CDEV by the Control Panel go through this point.  This CDEV* handles only 4 of the standard CDEV calls.  These are listed below:**	Call Name	Call Number*	---------	-----------*	INIT		4*	CLOSE		5*	CREATE		7*	ABOUT		8** ON ENTRY:	C,X,Y =	Unknown*		Stack =	Result Space (Long)*			Message (Word)*			Data1 (Long)*			Data2 (Long)*			Return Address (3 Bytes)**			Message = Call Number*			Data1 = Window Grafport*			Data2 = Unused** ON EXIT	C,X,Y =	Changed*		Stack =	Result (Long)**			Result = 0 (always)**##############################################################################main		PROC		ENTRY	Data1,Data2		ENTRY	ControlList		ENTRY	AboutList		ENTRY	MErrorList		ENTRY	Mem1RecH,Mem2RecH		ENTRY	MyID		ENTRY	List1Count,List2Count		ENTRY	List1ID,List2ID		ENTRY	CreateError		phb			;Save old data reg		phk			;Set data reg = prog reg		plb		lda	5,s		;Load DATA2 off the stack		sta	Data2		;and store it locally.		lda	7,s		sta	Data2+2		lda	9,s		;Load DATA1 off the stack		sta	Data1		;and store it locally.		lda	11,s		sta	Data1+2		lda	13,s		;Load MESSAGE off the		sta	Message		;stack and store it locally.		lda	1,s		;Bump the stack up to prepare		sta	11,s		;to take off the 3 parameters		lda	3,s		;that we stored about.		sta	13,s		PullWord		;Get rid of MESSAGE space		PullLong		;Get rid of DATA1 space		PullLong		;Get rid of DATA2 space		lda	Message		;Load the call number		cmp	#12		;Compare againts max+1		bcs	ret_addr	;If >= max+1, just leave.		pea	ret_addr-1	;Push our return address		asl	a		;Times 2 into word table		tax			;Move into index reg		lda	cdev_calls,x	;Load the address of call handler		pha			;Push the address of routine on the stack		rts			;Jump to the call handlerret_addr	lda	#0		;Make sure we return zeros.		sta	5,s		sta	7,s		plb			;Restore NDAs data bank register		rtl			;Return to Control Panel NDA.Message		dc.w	0		;Local storage for MESSAGEData1		dc.l	0		;Local storage for DATA1Data2		dc.l	0		;Local storage for DATA2MyID		dc.w	0CreateError	dc.w	0		;0 = no error, 1 = errorcdev_calls	dc.w	bogusCDEV-1	;0	;Null		dc.w	bogusCDEV-1	;1	;MachineCDEV		dc.w	bogusCDEV-1	;2	;BootCDEV		dc.w	bogusCDEV-1	;3	;ShutdownCDEV		dc.w	InitCDEV-1	;4		dc.w	CloseCDEV-1	;5		dc.w	bogusCDEV-1	;6	;EventsCDEV		dc.w	CreateCDEV-1	;7		dc.w	AboutCDEV-1	;8		dc.w	bogusCDEV-1	;9	;RectCDEV		dc.w	bogusCDEV-1	;10	;HitCDEV		dc.w	bogusCDEV-1	;11	;RunCDEVControlList		dc.l	List2Control		dc.l	List1Control		dc.l	SText1Control	;Port:		dc.l	SText2Control	;Printer:		dc.l	0LeftEdge	equ	10RightEdge	equ	190TL1Vert		equ	18BR1Vert		equ	60TL2Vert		equ	79BR2Vert		equ	121TL3Vert		equ	8BR3Vert		equ	18TL4Vert		equ	69BR4Vert		equ	79List1Control	dc.w	14		;PCountList1ID		dc.l	1		;ID number		dc.w	TL1Vert		dc.w	LeftEdge		dc.w	BR1Vert		dc.w	RightEdge		dc.l	$89000000	;listcontrol ID		dc.w	0		;Flag		dc.w	$1401+fCtlCanBeTarget+fCtlWantEvents	;More Flags		dc.l	0		;Ref conList1Count	dc.w	0		dc.w	0		;Number seen		dc.w	6		;Single selection Pascal stringsList1Start	dc.w	1		;1st member seen		dc.l	0		;Draw routine		dc.w	10		;Height		dc.w	5		;List record sizeMem1RecH	dc.l	0List2Control	dc.w	14		;PCountList2ID		dc.l	2		;ID number		dc.w	TL2Vert		dc.w	LeftEdge		dc.w	BR2Vert		dc.w	RightEdge		dc.l	$89000000	;listcontrol ID		dc.w	0		;Flag		dc.w	$1401+fCtlCanBeTarget+fCtlWantEvents	;More Flags		dc.l	0		;Ref conList2Count	dc.w	0		dc.w	0		;Number seen		dc.w	6		;Single selection Pascal stringsList2Start	dc.w	1		;1st member seen		dc.l	0		;Draw routine		dc.w	10		;Height		dc.w	5		;List record sizeMem2RecH	dc.l	0SText1Control	dc.w	8		;PCount		dc.l	3		;ID number		dc.w	TL3Vert		dc.w	LeftEdge		dc.w	BR3Vert		dc.w	RightEdge		dc.l	$81000000	;Static text		dc.w	1		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SText1		dc.w	SText1LenSText2Control	dc.w	8		;PCount		dc.l	4		;ID number		dc.w	TL4Vert		dc.w	LeftEdge		dc.w	BR4Vert		dc.w	RightEdge		dc.l	$81000000	;Static text		dc.w	1		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SText2		dc.w	SText2LenSText1		dc.b	'Select a Port:'SText1Len	equ	*-SText1SText2		dc.b	'Select a Printer Type:'SText2Len	equ	*-SText2AboutList	dc.w	8		;Pcount		dc.l	1		;ID		dc.w	38,5,138,280		dc.l	$81000000		dc.w	1		dc.w	$1000		dc.l	0		dc.l	AboutText		dc.w	AboutTextLenAboutText	dc.b	'The Direct Connect Printer Control Panel allows you to '		dc.b	'select a printer port and type for '		dc.b	'directing your printer output.  '		dc.b	'Only the printer and port drivers '		dc.b	'present in your system are listed.'AboutTextLen	equ	*-AboutTextMErrorList	dc.w	8		;Pcount		dc.l	1		;ID		dc.w	TL1Vert		dc.w	LeftEdge		dc.w	BR2Vert		dc.w	RightEdge		dc.l	$81000000		dc.w	1		dc.w	$1000		dc.l	0		dc.l	MErrorText		dc.w	MErrorTextLenMErrorText	dc.b	'An error occured while trying to allocate '		dc.b	'memory.  This CDEV requires some free '		dc.b	'memory in order to operate.'MErrorTextLen	equ	*-MErrorText		ENDP*##############################################################################*			Below are the CDEV handler routines		      **##############################################################################bogusCDEV	PROC		rts		ENDPInitCDEV	PROCinit		ldx	#1		;ctl ID		jsr	initE		;start the port list from the selected member		ldx	#2		;ctl ID		; fall through to start the driver list from the selected memberInitE		stx	inita		PushLong #0		;Result space		PushLong Data1		;Window pointer		PushWord #0		;Push high word of list #		Phx			;Push low word of list #		_GetCtlHandleFromID		pla		plx				pha			;space for result		pushword #0		;start from top		phx			;hi word of list control		pha			;lo word of list control		_NextMember2		;find the selected item		lda	#$34		sta	>$ff0001	;**********************		lda	1,s		sta	>$ff0001				PushLong #0		;Result space		PushLong Data1		;Window pointer		PushWord #0		;Push high word of list #		pushword inita		;Push low word of list #		_GetCtlHandleFromID		_SelectMember2		;make sure it is visible		rts		inita		dc.w	0				ENDP*##############################################################################******************************************************************************** Times5** This routine will multiply the number in X with 5 and return the result* in the variable AddIndex.** Inputs: X = Number to mulitiply** Outputs: AddIndex = Result (long)*******************************************************************************Times5		PROC		ENTRY	AddIndex		PushLong #0		;Result space		phx			;Item number		PushWord #5		;Item length		_Multiply		PullLong AddIndex	;Offset into member list		rtsAddIndex	dc.l	0		ENDP;;	dam - display alert message.;;	entry	[a,y] = ptr to message.;;	exit	centered caution alert displayed.dam		PROC	; ported from NetPrinter CDEV by Monte Benaresh 4/3/91	sec	EXPORT damEdamE	clc	ror	damF		;save type wanted for now	sta	dammsg		;save message ptr	sty	dammsg+2	_InitCursor		;make sure cursor is reset	ldx	#(320-damw)/2	lda	screenF	bpl	dam1		;if 320 mode	ldx	#(640-damw)/2dam1	stx	damtemp+2	;left edge	txa	clc	adc	#damw	sta	damtemp+6	;right edge	pha	pea damtemp >>16	pea damtemp		;template	lda #$0000	pha	pha			;no filter		;jsr	dwh		;disable window highlightingdwh	pha	pea $0001		;flag for disabling window highlighting	_WindowGlobal	pla		lda	damF	bpl	dam2		;if user wants a stop alert		_CautionAlert	bra	dam3dam2	_StopAlert		dam3	;jsr	ewh		;enable window highlightingewh	pha	pea $FFFE		;flag for enabling window highlighting	_WindowGlobal	pla	pla			;ignore item hit but get it off the stack	rts		damt	equ	60damb	equ	140damh	equ	damb-damtdaml	equ	170damr	equ	470damw	equ	damr-damldamtemp dc.w	damt,daml,damb,damr	dc.w	2376			;id	dc.b	$80	dc.b	$80	dc.b	$80	dc.b	$80	dc.l	okitem	dc.l	damstr	dc.l	0okitem	dc.w	ok			;okay button	dc.w	damh-17,190,damh-4,260	dc.w	buttonItem	dc.l	oktext,0,0damstr	dc.w	1348			;text item	dc.w	5,75,5+6*9,280	dc.w	StatText+ItemDisabledammsg	dc.l	0,0,0	damF	dc.w	0	oktext	dc.b 2				;length byte	dc.b	'OK'		ENDPCloseCDEV	PROC		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 4 bytes		sbc	#4			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage		lda	CreateError		beq	@CloseIt		jmp	Exit@CloseIt	ldx	List1ID		;Look at list #1		jsr	FindSelected	;Find selected member		bne	@FoundOne	;Branch if we found one!		jmp	Exit		;No member selected! (just leave)@FoundOne	dex			;Minus 1 for multiply		jsr	Times5		;Times 5 for each record.;------------------------------------------------------------------------------; Below we add the offset for this record number (# times 5) to the; base location to the member pointer list.;------------------------------------------------------------------------------		PushLong Mem2RecH		_HLock		lda	Mem1RecH		sta	zp0		lda	Mem1RecH+2		sta	zp0+2		ldy	#2		lda	[zp0]		tax		lda	[zp0],y		sta	zp0+2		stx	zp0		clc		lda	AddIndex	;Load low word of offset		adc	zp0		;Add it to low word of base		sta	zp0		;Store on zero page.		lda	AddIndex+2	;Now do the same for the		adc	zp0+2		;high word.		sta	zp0+2		ldy	#2		;Zero page location 00-03 now		lda	[zp0]		;points to a value that is a		tax			;pointer to the string to move.		lda	[zp0],y		;Get this pointer and hold it		pha			;in the X and Y registers.					;Pushlong pointer to string.		phx			;Must go onto the stack high-low!;------------------------------------------------------------------------------; Below we move the name of the file from our member list into the; PRINTER.SETUP file buffer for writting out.  We're falling through here; with the source address pointer on the stack.;------------------------------------------------------------------------------		PushLong #CPort		PushLong #33		_BlockMove		PushLong Mem1RecH		_HUnlock;------------------------------------------------------------------------------; Now we do the same thing to list #2 that we did for list #1;------------------------------------------------------------------------------		ldx	List2ID		jsr	FindSelected		bne	notExit		brl	ExitnotExit		dex		jsr	Times5;------------------------------------------------------------------------------; Below we add the offset for this record number (# times 5) to the; base location to the member pointer list.;------------------------------------------------------------------------------		PushLong Mem2RecH		_HLock		lda	Mem2RecH		sta	zp0		lda	Mem2RecH+2		sta	zp0+2		ldy	#2		lda	[zp0]		tax		lda	[zp0],y		sta	zp0+2		stx	zp0		clc		lda	AddIndex	;Load low word of offset		adc	zp0		;Add it to low word of base		sta	zp0		;Store on zero page.		lda	AddIndex+2	;Now do the same for the		adc	zp0+2		;high word.		sta	zp0+2		ldy	#2		;Zero page location 00-03 now		lda	[zp0]		;points to a value that is a		tax			;pointer to the string to move.		lda	[zp0],y		;Get this pointer and hold it		pha			;in the X and Y registers.					;Pushlong pointer to string.		phx			;Must go onto the stack high-low!;------------------------------------------------------------------------------; Below we move the name of the file from our member list into the; PRINTER.SETUP file buffer for writting out.  We're falling through here; with the source address pointer on the stack.;------------------------------------------------------------------------------		PushLong #C2Printer		PushLong #33		_BlockMove		PushLong Mem2RecH		_HUnlock			jsr	WriteData		bcc	NoWriteError		;BAK 8/15/91		import	no_iosuccess_msg		lda	#no_iosuccess_msg		ldy	#^no_iosuccess_msg		jsr	damENoWriteError		PushWord #0		;Result space		_PMStatus		;Is the PM running?		pla			;0 = no		beq	Exit		;Branch if not running		PushWord #0		;Unload both drivers		_PMUnloadDriver		;Unload printer and port driversExit		tsc				;*Stack -> C reg.		clc				;Subtract 4 bytes.		adc	#4			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.		lda	MyID		beq	@NoID		PushWord MyID			;Dispose of all our membory		_DisposeAll		PushWord MyID			;Dispose of our		_DeleteID			;memory ID.@NoID		rts		export no_iosuccess_msg		;BAK 8/15/91no_iosuccess_msg		dc.b @end-@start@start		dc.b 'Unable to read or write'		dc.b $0D		dc.b 'the printer selection'		dc.b $0D		dc.b 'from or to boot disk.'@end******************************************************************************** FindSelected** This routine will call the list manager tool to find the selected member* of the specified list and return it in X.** Inputs: X = List number** Outputs: X = Item number ( 0 = no item selected)*******************************************************************************FindSelected	PushWord #0		;Result space (for _ResetMember2);------------------------------------------------------------------------------; Below we get the control handle for list #n and put it on the stack; for the _ResetMember2 call.;------------------------------------------------------------------------------		PushLong #0		;Result space		PushLong Data1		;Window pointer		PushWord #0		;Push high word of list #		phx			;Push low word of list #		_GetCtlHandleFromID		bcs	@BadExit;------------------------------------------------------------------------------; After the above code, the control handle is on the stack for use in the; next call.;------------------------------------------------------------------------------		ldx	#$131C		jsl	>$E10000	;_ResetMember2		plx			;Pull item number		bcs	@BadExit		rts@BadExit	lda	#0		rts		ENDP*##############################################################################AboutCDEV	PROC		PushLong #0			;Space for result		PushLong Data1			;Grafport		PushWord #0			;Ptr to single		PushLong #AboutList		_NewControl2		PullLong		rts		ENDP*##############################################################################CreateCDEV	PROC		import damE						;SCB stuff added 4/3/91 by Monte		pha				;space for result		_GetMasterSCB		pla		xba		and	#$8000		sta	screenF			; != 0 if 640 mode		PushWord #0			;Result space		PushWord #$5000			;DA type		_GetNewID		PullWord MyID		bcc	@GotID		jmp	@MemoryError1@GotID		PushLong #0			;Result space		PushLong #1			;Size of block		PushWord MyID			;User ID		PushWord #$8018			;Attributes		PushLong #0			;Pointer to mem		_NewHandle		PullLong Mem1RecH		bcc @mem1_ok		brl	@MemoryError2@mem1_ok		PushLong #0			;Result space		PushLong #1			;Size of block		PushWord MyID			;User ID		PushWord #$8018			;Attributes		PushLong #0			;Pointer to mem		_NewHandle		PullLong Mem2RecH		bcs	@MemoryError2		stz	List1Count		stz	List2Count		stz	PrePickFlag		;0 = don't pre-pick		jsr	ReadPSetup				bcc	@NoReadError		;BAK 8/15/91		import	no_iosuccess_msg		lda	#no_iosuccess_msg		ldy	#^no_iosuccess_msg		jsr	damE		sec@NoReadError				bcs	@L1		lda	CFlag			;If AppleTalk printer is old		bne	@L1			;pick, don't search.		inc	PrePickFlag		;Try to pre-pick selections.;------------------------------------------------------------------------------; Below we add zpsize bytes to the stack and point the direct page register; there.  We need zpsize bytes of zero page in SCAN4DRIVERS.;------------------------------------------------------------------------------@L1		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 12 bytes		sbc	#zpsize			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage		jsr	Scan4Drivers		tsc				;*Stack -> C reg.		clc				;Subtract 12 bytes.		adc	#zpsize			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.		; check for missing printer/port drivers added 4/3/91		; by Monte Benaresh		lda List1Count			;check for 0 port drivers		bne @maybe_none@none						;display alert		lda #no_print_msg		;tell user to install print SW		ldy #^no_print_msg		jsr damE			;display stop alert		bra @continue@maybe_none		lda List2Count			;how about printer drivers?		beq @none@continue		PushLong #0			;Space for result		PushLong Data1			;WindPort		PushWord #3			;Ptr to Ptrs		PushLong #ControlList		;Ptr to control list		_NewControl2		PullLong			;Discard zeros		stz	CreateError		;Flag no error!		jsr	stl			;sort the lists				rts@MemoryError1	stz	MyID		;Flag no ID@MemoryError2	lda	#0001		;Flag error!		sta	CreateError		PushLong #0		;Space for result		PushLong Data1		;WindPort		PushWord #0		;Ptr to single		PushLong #MErrorList	;Ptr to control		_NewControl2		PullLong		;Discard		rtsno_print_msg		dc.b @end-@start@start		dc.b 'Can''t find printer drivers.'		dc.b $0D		dc.b $0D		dc.b 'Please install printer'		dc.b $0D		dc.b 'software to your startup'		dc.b $0D		dc.b 'disk.'@end;		maybe put this in a better spot....;;		stl - sort the lists.;	;		entry	scrolling lists have been initialized with id of 1 and 2.;;		exit	lists will be sorted as if they were uppercase only.;;;		alternate entry point:  stlE;;		stlE can be used to sort a given list.;	;		entry	(x) = of list to sort.stl		ldx	#1		jsr	stlE		;sort the list (ports)		ldx	#2		;fall into stlE for printer drivers	stlE		PushLong #0		;Result space		PushLong Data1		;Window pointer		PushWord #0		;Push high word of list #		phx			;Push low word of list #		_GetCtlHandleFromID		pla			;lo word of control handle		ply			;hi word of control handle		jmp	sul		;sort uppercase list and return		;------------------------------------------------------------------------------; READPSETUP / WRITEDATA;; This routine reads in the PRINTER.SETUP file in the system folder.  If it; doesn't exist, it will create one.;; Inputs: NONE; Outputs: NONE - Global data only;; Entry point WRITEDATA: Writes the PRINTER.SETUP file out.;; Errors: Both routines return with carry set if error.;------------------------------------------------------------------------------		ENTRY	WriteDataReadPSetup	jsr	dco		;Build and set path to printer.setup file		_OpenGS OpenPBlock	;Open the file.		bcs	@L2		;Branch if error.		lda	OPRef		;Transfer reference number		sta	RPRef		;to the read and close call		sta	CRef		;blocks.		_ReadGS ReadPBlock	;Read the file.@L00		php			;Save the read/write error if any		_CloseGS CloseBlock	;Close the file		plp			;Restore read error flag@L1		rts@L2		cmp	#$0046		;File not found error?		sec			;Assume branch condition		bne	@L1		;Branch if not		_CreateGS CreatePBlock	;Try to create the file		bcs	@L1		;Branch on error		sep	#$30		longa	off		longi	off		ldy	DefC2Printer	;Move the default printer driver@L10		lda	DefC2Printer,y	;name into write buffer.		sta	C2Printer,y		dey		bpl	@L10		ldy	DefCPort	;Move the default port driver@L20		lda	DefCPort,y	;name into write buffer.		sta	CPort,y		dey		bpl	@L20		ldy	DefCUser	;Move the default user name@L30		lda	DefCUser,y	;into write buffer.		sta	CUser,y		dey		bpl	@L30		rep	#$30		longa	on		longi	on		jsr	WriteData		rtsWriteData	jsr	dco		;Build and set path to printer.setup file		_OpenGS OpenPBlock	;Open the file.		bcs	@L1		;Branch on error		lda	OPRef		;Transfer reference number		sta	RPRef		;to the write and close call		sta	CRef		;blocks.		stz	CFlag		;Zero DC/ATALK flag in write buffer		_WriteGS ReadPBlock	;Write the file.		php			;Save the read/write error if any		_CloseGS CloseBlock	;Close the file		plp			;Restore write error flag@L1		rts;;dco: build and store-ptr networked or local pathname for printer.setup file:;dco		phd			;getting direct page...		tsc		sec		sbc #4		tcs		ina		tcddco_dpA		equ 0				_DInfoGS dco_DInfoB	;get boot device name		bcs dco_islocal				_VolumeGS dco_VolumeB	;get boot FST id		bcs dco_islocal				lda dco_FSTid		;is it appleshare FST?		cmp #$000D		;find out by comparing FST id from the		beq dco_isnetwork	;Volume call; branch to local or		bra dco_islocal		;network case handling code		dco_isnetwork	_FSTSpecific dco_GupB	;here if network: get path string address		bcs dco_islocal				lda dco_GupBPPtr+0	;build our path string and set string ptrs		sta dco_dpA+0		;access pathname pointer and put in dp variable		lda dco_GupBPPtr+2		sta dco_dpA+2		ora dco_GupBPPtr+0		beq dco_islocal				lda [dco_dpA]		;copying pathname...		sta dco_PPathNet+0	;copy initial len word first		shortm		ldy #2			;y starts beyond len words and will be running dest str idx		ldx #0			;x is count of lendco_copyloop1	lda [dco_dpA],y		sta dco_PPathNet,y		iny			;bump address		inx			;bump string count		cpx dco_PPathNet+0	;go until length		bne dco_copyloop1		longm			;y now points to next index						ldx #0			;adding ":Setup:Printer.Setup"...		shortmdco_copyloop2	lda dco_PSStr+2,x		sta dco_PPathNet,y		iny			;bump destination string running index		inx			;bump "Printer.Setup" string length count		cpx #dco_PSStrE-dco_PSStrB		bne dco_copyloop2		longm				lda dco_PPathNet+0	;now adjust string length of destination string		clc		adc #dco_PSStrE-dco_PSStrB		sta dco_PPathNet+0				ldx #dco_PPathNet	;network pathname to printer.setup file		ldy #^dco_PPathNet		bra dco_setpathptrsdco_islocal	ldx #PPathLocal		;here if local: set string ptrs		ldy #^PPathLocal	;local pathname to printer.setup file and drop thrudco_setpathptrs	stx CPPathPtr+0		;set the pathname pointers now		stx OPPathPtr+0		sty CPPathPtr+2		sty OPPathPtr+2				tsc			;deallocating direct page...		clc		adc #4		tcs		pld				rts		dco_DInfoB	dc.w 2			;pcount				;_DInfo parameter block		dc.w 1			;dev_num: input: 1=boot		dc.l dco_DevName	;dev_nmae outbuff: input		dco_DevName	dc.w 36			;buffer length			;Device name string bufferdco_DevName2	dc.w 0			;string length		ds.b 36			;buffer for device namedco_VolumeB	dc.w 5			;pcount				;_Volume parameter block		dc.l dco_DevName2	;dev_name: input		dc.l dco_VolName	;vol_name outbuff: input		dc.l 0			;total_blocks: result		dc.l 0			;free_blocks: resultdco_FSTid	dc.w 0			;fst_id: resultdco_VolName	dc.w 36			;buffer length			;Volume name string bufferdco_VolName2	dc.w 0			;string length		ds.b 36			;buffer for volume namedco_GupB	dc.w 3			;pcount				;FST-spec GetUserPath block		dc.w $000D		;fst_id: input: appleshare		dc.w 8			;command:input: GetUserPathdco_GupBPPtr	dc.l 0			;prefix_ptr: resultdco_PPathNet	dc.w 0			;string length			;Built-up network path		ds.b 36+16						;ie, .../Printer.Setup		dco_PSStr	dc.w dco_PSStrE-dco_PSStrBdco_PSStrB			dc.b ':Setup:Printer.Setup'dco_PSStrE;------------------------------------------------------------------------------; SCAN4DRIVERS;; This routine will scan the DRIVERS directory on the system disk in order; to find all the Printer and Port drivers.  It will include the file names; into the appropriate list.  The AppleTalk driver will be; excluded.;; Inputs: NONE - Global data only; Outputs: NONT - Global data only;------------------------------------------------------------------------------Scan4Drivers	_OpenGS OpenDBlock		bcc	@L1		rts@L1		lda	ODRef		sta	GDERef		sta	CRefScanLoop	_GetDirEntryGS GetDirEntryBlock		bcc	@L00		cmp	#$004F		;Is the name just too big?		beq	ScanLoop	;Branch if yes.		jmp	ScanExit	;Else, error out.@L00		lda	FPath+2		;Load length of string		cmp	#0033		;Is the file name too large?		bcs	ScanLoop	;Branch if file name too large		xba			;Turn string into Pascal type		sta	FPath+2		;string.		lda	GDEFileType	;Is the file a driver?		cmp	#$00BB		;$BB = driver		bne	ScanLoop	;Branch if not.		ldx	GDEAUXType	;Is it a Printer driver?		cpx	#$0001		;1 = Printer driver		bne	TryPortType	;Branch if not.		jsr	MovePrinter			inc	List2Count	;Bump our valid Printer driver counter.Back2Scan	jmp	ScanLoop	;Go back for more!TryPortType	ldx	GDEAUXType	;Is it a Port driver?		cpx	#$0002		;2 = Port driver		bne	Back2Scan	;Branch if not.;------------------------------------------------------------------------------; We fall through to the CHECKSTR routine with X containing 2.  This will; cause the CHECKSTR routine to only check for the string APPLETALK;------------------------------------------------------------------------------		jsr	MovePort	;Check for "APPLETALK"		bcs	Back2Scan	;Branch if found.		inc	List1Count	;Bump our Port driver counter.		bra	Back2Scan	;Go back for more!ScanExit	_CloseGS CloseBlock		rts******************************************************************************** MovePrinter** This routine will add the name to the list record and copy* into a new memory segment.** Inputs:	None** Outputs:	None	*******************************************************************************PrinterBExit	plp		sec		rtsMovePrinter	php		rep	#$30		longa	on		longi	on		lda	List2Count		ldx	Mem2RecH		ldy	Mem2RecH+2		jsr	BumpMemRec		bcs	PrinterBExit		longa	off		longi	off		lda	PrePickFlag		beq	PrinterGExit		ldy	FPath+3@L1		lda	FPath+3,y		cmp	C2Printer,y		bne	PrinterGExit		dey		bpl	@L1		ldy	#4		lda	#$80		sta	[zp1],yPrinterGExit	plp		clc		rts		longa	on		longi	on******************************************************************************** MovePort** This routine will first check the name at FPATH+3 againts the string* 'APPLETALK' and if it's equal, returns with the carry set.  If not* it adds the name to the list record and copies into a new memory segment* and returns with the carry clear.** Inputs:	None** Outputs:	Carry:	Clear = String copied and valid*	  		Set   = String copied but not valid (matched)********************************************************************************MovePort	php		sep	#$30		longa	off		longi	off		ldy	FPath+3@L1		jsr	GetUCase		cmp	ATalkName,y		bne	CheckPort		dey		bpl	@L1PortBExit	plp		sec		rtsCheckPort	rep	#$30		longa	on		longi	on		lda	List1Count		ldx	Mem1RecH		ldy	Mem1RecH+2		jsr	BumpMemRec		bcs	PortBExit	;Branch on error		longa	off		longi	off		lda	PrePickFlag		beq	PortGExit		ldy	FPath+3@L1		lda	FPath+3,y		cmp	CPort,y		bne	PortGExit		dey		bpl	@L1		ldy	#4		lda	#$80		sta	[zp1],yPortGExit	plp		clc		rts;-----------------------------------------------------------------------------; The routine below will fetch a character from FPATH+3,Y and force it to; upper case.;-----------------------------------------------------------------------------GetUCase	lda	FPath+3,y	;Load the character		cmp	#$61		;If < "a" don't bother		bcc	@L1		cmp	#$7B		;If > "z"+1 don't bother		bcs	@L1		and	#$DF		;Else force it to upper case.@L1		rts		longa	on		longi	on******************************************************************************** BumbMemRec** This routine will bump the member record list, move the file name pointed* to by FPATH+3 into a new memory handle, update the new member record to* point to the new memory handle containing the file name and zero the* selection byte for the new member record..** Inputs:	A:	ListCount for this record*		X:	Low word of MemberList handle*		Y:	High word of MemberList handle** Outputs:	Carry:	Clear = String copied*	  		Set   = Memory allocation error*		Long C,X,Y if error*		Short C,X,Y if no error********************************************************************************BumpMemRec	sta	zp0		;Store the ListCount		stx	zp1		;Store the handle (low word)		sty	zp1+2		;Store the handle (high word);-----------------------------------------------------------------------------; Below we first try to unlock the handle of the member record list.  Then; get the old size, add the length of a new record, and the re-size the; handle.  After that, we just lock it down.  If we get any errors, we leave; the BUMPMEMREC routine with the carry set.;-----------------------------------------------------------------------------		PushLong zp1		;Push handle		_HUnlock		;Unlock the handle		bcc	@OKUnlock	;Branch if no error@ShortExit	jmp	@Exit		;Else we exit with carry set.@OKUnlock	PushLong #0		;Result space		PushLong zp1		;Push handle		_GetHandleSize		;Get the current handle size		tay			;Save the error state for now					;We fall through with the current					;size of the handle on the stack.		clc			;Add in the length of the new		pla			;member record item so we can		adc	#MemRecSize	;re-size the member record list.		tax		pla		adc	#0		phy			;Save the error state on the stack.		pha			;Push the new length of the		phx			;handle onto the stack.		PushLong zp1		;Push the handle		_SetHandleSize		;Set the new size		pha			;Save the error state on the stack.		PushLong zp1		;Push the handle		_HLock			;Lock the sucker.		plx			;Pull error on SetHandleSize		ply			;Pull error on GetHandleSize		bcs	@ShortExit	;Branch if error on _HLock		sec			;Assume error		bne	@ShortExit	;Branch if error on GetHandleSize		cpx	#0		;Error on SetHandleSize?		bne	@ShortExit	;Branch if yes.;-----------------------------------------------------------------------------; Below we ask for a segment of memory that will hold the file name in; FPATH+3.;-----------------------------------------------------------------------------		PushLong #0		;Result space		PushWord #0		;High word of size of block		lda	FPath+3		and	#$00FF		ina		pha			;Low word of size of block		PushWord MyID		;User ID		PushWord #$C018		;Attributes		PushLong #0		;Pointer to mem		_NewHandle		plx			;Pull the result off the stack		ply			;and hold it in X and Y regs.		bcs	@Exit		;Branch if we didn't get the memory.		pei	zp0		;Push the ListCount for later use.		stx	zp0		;Store handle to file name		sty	zp0+2		;buffer on zero page.		ldy	#2		;De-reference the handle		lda	[zp0]		;and store it back on to		tax			;the zero page at ZP0.		lda	[zp0],y		sta	zp0+2		stx	zp0		ldy	#2		;Dereference handle that		lda	[zp1]		;points to the beginning of		tax			;the member record list and		lda	[zp1],y		;put the result back into the		sta	zp1+2		;zero page location ZP1.		stx	zp1		plx			;Pull the ListCount back off		jsr	Times5		;and multiply it by 5.		clc			;Add the offset to the address		lda	AddIndex	;of the beginning of the buffer		adc	zp1		;to get new pointer to member		sta	zp1		;record and put it back into		lda	AddIndex+2	;the zero page location ZP1.		adc	zp1+2		sta	zp1+2		ldy	#2		;Dereference handle that points		lda	zp0		;to the location to put the		sta	[zp1]		;file name into and put it back		lda	zp0+2		;into the zero page location ZP0.		sta	[zp1],y		sep	#$30		;Short everything		longa	off		longi	off		ldy	#4		;Force the selection byte to		lda	#00		;zero (not selected).		sta	[zp1],y		ldy	FPath+3		;Load the length byte@CopyLoop	lda	FPath+3,y	;Move the entire string including		sta	[zp0],y		;the length byte into buffer pointed		dey			;to by ZPO		bpl	@CopyLoop		clc			;No error!@Exit		rts			;RETURN		longa	on		longi	on		ENTRY	C2Printer		ENTRY	CPortPrePickFlag	dc.w	0ATalkName	str	'APPLETALK'OpenDBlock	dc.w	3		;PCountODRef		dc.w	0		dc.l	DPath		;Pathname pointer		dc.w	0001		;Request accessDPath		dc.w	DPathLen		dc.b	'*/SYSTEM/DRIVERS/'DPathLen	equ	*-DPath-2GetDirEntryBlock dc.w	13		;PCountGDERef		dc.w	0		dc.w	0		;Flags		dc.w	1		;Base		dc.w	1		;Displacement		dc.l	FPath		dc.w	0		;Entry numberGDEFileType	dc.w	0		;FileType		dc.l	0		;EOF		dc.l	0		;Block count		dc.l	0,0		;Create date/time		dc.l	0,0		;Mod date/time		dc.w	0		;AccessGDEAUXType	dc.l	0		;AUX typeFPath		dc.w	FPathLen		dc.w	0		ds.b	32FPathLen	equ	*-FPathCreatePBlock	dc.w	4		;PCountCPPathPtr	dc.l	0		;Pathname pointer		dc.w	$C3		;Access byte		dc.w	6		;File type		dc.l	0		;AUX typeOpenPBlock	dc.w	3		;PCountOPRef		dc.w	0OPPathPtr	dc.l	0		;Pathname pointer		dc.w	0003		;Request access (R/W)PPathLocal	dc.w	PPathLocalLen		dc.b	'*/SYSTEM/DRIVERS/Printer.Setup'PPathLocalLen	equ	*-PPathLocal-2ReadPBlock	dc.w	4		;PCountRPRef		dc.w	0		dc.l	ReadPBuffer		dc.l	RBufferLength	;Request count		dc.l	0		;Transfer countCloseBlock	dc.w	1		;PCountCRef		dc.w	0ReadPBufferC1Printer	ds.b	33C2Printer	ds.b	33CPort		ds.b	33CUser		ds.b	16CNet		ds.b	33CZone		ds.b	33CFlag		ds.b	2RBufferLength	equ	*-ReadPBufferDefC2Printer	str	'IMAGEWRITER'DefCPort	str	'PRINTER'DefCUser	str	'John Q. Public'		ENDPscreenF		ds.b	2		; = $8000 if this is a 640 mode screen		END