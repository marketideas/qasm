;;;	sul - sort uppercase list.;;	Michael V. Stein	02/21/90.;;	© Apple, 1990.	blanks	off	;;	equates.;;	imported addresses.;;	include files.	include	'm16.list'	include	'm16.util2'			;;	main program.	main	proc	export	sulsul	pushlong #cue		;compare uppercase elements	phy			;hi word to list handle	pha			;lo word to list handle	_SortList2	rts;;	cue - compare uppercase elements.;;	entry	none.;;	exit	none.memberA	equ	4+2memberB	equ	memberA+4cue	phd	tsc	tcd			use stack as a direct page			phb			save data bank	phk	plb		ldy	#$02	lda	[memberA]	dereference first handle	tax	lda	[memberA],y	sta	memberA+2	stx	memberA				lda	[memberB]	dereference second handle	tax	lda	[memberB],y	sta	memberB+2	stx	memberB	shortmx		lda	[memberA]			cmp	[memberB]	compare it to memberB		bcc	cue1		if length(memberB) >= length(memberA)	lda	[memberB]	cue1	sta	min		shortest length of either string	ldy	#$00	cue2	iny	lda	[memberB],y	jsr	cal		capitalize a letter	sta	temp	lda	[memberA],y	jsr	cal		capitalize a letter	cmp	temp	bne	cue5		we have a difference	cpy	min		chars are the same so check if more bytes to check	bcc	cue2		no more bytes to check	cue4	lda	[memberA]	the shortest string is less than the longer	cmp	[memberB]	set carry if a >= b	cue5	longmx			carry set if a >= b			lda	0+2			sta	8+2	lda	2+2	sta	10+2	plb			restore data bank		pld			restore direct page	pla	pla	pla	pla	rtlmin	ds.b	1temp	ds.b	1;;	cal - capitalize a letter.;;	entry	none.;;	exit	none.	longa	off	longi	off	cal	cmp	#'a'	bcc	cal1		if not lowercase	cmp	#'z'+1	bcs	cal1		if not lowercase	sbc	#$20-1		(c) clear	cal1	rts		endp	end