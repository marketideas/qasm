;;;	ramdiskdata - data for the ram CDEV..;;	Michael V. Stein	04/01/90.;;	© Apple, 1990.	blanks off	string ASIS	include	'e16.control'data	proc;;	imported address.;	import	cstr	import	rstr	import	str1	import	str2	import	str3;;	exported addresses.;	export	killresize	export	ramabout	export	ramlist	export ram1	export ram2;scrW	equ 38			;width for scroll barsscrW	equ 36			;width for scroll bars in 640 mode, changed…				;…in ccc for 320 moderam1 	dc.w	9			;pcount	dc.l	1			;ctl ID	dc.w	11,55,60,55+scrW	;rect	dc.l	scrollBarControl	dc.w	3			;flag	dc.w	$1000			;more flag	dc.l	0			;ref con	dc.w	14			;max size	dc.w	1			;view size	dc.w	0			;init value		ram2 	dc.w	9	dc.l	2	dc.w	11,152,60,152+scrW	dc.l	scrollBarControl	dc.w	3	dc.w	$1000	dc.l	0	dc.w	14	dc.w	1	dc.w	0	ram3 	dc.w	8	dc.l	3		dc.w	1,20,11,100	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	ram3t	dc.w	ram3tLram3t	dc.b	'RAM Disk:'ram3tL	equ	*-ram3t	ram4 	dc.w	8	dc.l	4		dc.w	1,110,11,200	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	ram4t	dc.w	ram4tLram4t	dc.b	'RAM Cache:'ram4tL	equ	*-ram4t	ram5 	dc.w	8	dc.l	5		dc.w	64,10,74,120	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0 	dc.l	ram5t	dc.w	ram5tLram5t	dc.b	'Memory in use:'ram5tL	equ	*-ram5t	ram6 	dc.w	8	dc.l	6		dc.w	74,10,84,145	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	ram6t	dc.w	ram6tL;ram6t	dc.b	'Free memory:'ram6t	dc.b	'Available memory:'	changed 1/24/91 by Monte Benareshram6tL	equ	*-ram6t		;	ramdisk K size	ram7 	dc.w	9				dc.l	7		dc.w	30,10,40,55-4	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	rstr	dc.w	6	dc.w	-1	;	cache K size.ram8 	dc.w	9	dc.l	8		dc.w	30,105,40,150-4	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	cstr	dc.w	6	dc.w	-1			string PASCAL	; from here on, we need pascal stringsRam9 	dc.w	8	dc.l	9	dc.w	85+10,10,0,0	dc.l	checkControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	Ram9Title	dc.w	0Ram9Title	dc.b	'Resize after reset'		;	value string for memory in use.ram10 	dc.w	9	dc.l	10		dc.w	64,195-70,74,190	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	str1	dc.w	6	dc.w	-1		right justified;	value string for available memory.ram11 	dc.w	9	dc.l	11	dc.w	74,140,84,190	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	str2	dc.w	6	dc.w	-1		right justified	string	asisram12	dc.w	8	dc.l	6		dc.w	84,10,94,120	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	ram12t	dc.w	ram12tLram12t	dc.b	'Max block size:'ram12tL	equ	*-ram12t;	value string for max blockram13 	dc.w	9	dc.l	13	dc.w	84,195-70,94,190	dc.l	statTextControl	dc.w	0	dc.w	$1000	dc.l	0	dc.l	str3	dc.w	6	dc.w	-1		right justified	ramList		dc.l	ram1	dc.l	ram2	dc.l	ram3	dc.l	ram4	dc.l	ram5	dc.l	ram6	dc.l	ram7	dc.l	ram8	dc.l	ram10	dc.l	ram11	dc.l	ram12	dc.l	ram13KillResize	dc.l	ram9	dc.l	0	RamAbout		dc.w	8	dc.l	1	dc.w	38,5,138,280	dc.l	statTextControl	dc.w	$0000	dc.w	$1000	dc.l	0	dc.l	TheText	dc.w	EndText-TheText	string asisTheText	dc.b	'The RAM control panel lets you change the sizes of the RAM cache and '	dc.b	'RAM disk.  If you set '	dc.b	'the RAM disk to zero K, no RAM disk is created.  If resize '	dc.b	'after next reset is enabled (ROM 3 only), '	dc.b	'the RAM disk will be resized the next time you boot.  The RAM cache '	dc.b	'is the amount of memory set aside for GS/OS '	dc.b	'to speed up disk access.'EndText	string pascal	ENDP	END