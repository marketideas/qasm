;;;	ramdisk - ram CDEV.;;	Michael V. Stein	04/01/90.;;	© Apple, 1990.	blanks	off;;	equates.;	stack equates for special action procedures:handleid  equ	4+1		offset of handleid on stackpart	equ	handleid+4	offset to part on stack;	rectangle offsetsrecty0	equ	0		rectx0	equ	2recty1	equ	4rectx1	equ	6scroll320Width	equ 18		;added 10/29/91 by Monte		;;	include files.	include	'::cdev.h'	include	'::commonmacros.h'	include	'::dp.h'	include	'e16.control'	include	'm16.control'	include	'm16.event'	include	'm16.intmath'	include	'm16.memory'	include	'm16.misctool'	include 'm16.quickdraw'	;added 9-Dec-91 DAL	include	'm16.util2'	;;	main program.main	proc;;	exported addresses	export	cstr	export	rstr	export	str1	export	str2	export	str3;;	imported addresses	import	killresize	import	ramabout	import	ramlist	import ram1	import ram2ram	phb			save calling data bank	phk	plb			set our data bank		;	make room on stack for direct page.	tsc				sec				sbc	#dpsize		make room on stack for new direct page	tcs				phd			save the current direct page	tcd			new direct page	lda	message		cmp	#12			bcs	ram_1	if message defintely not handled			asl	a		times 2 into word table	tax			move into index reg	jsr	(t_cdev-2,x)	call the handler of this messageram_1 	pld			restore direct page	tsc	clc	adc	#dpsize			tcs			reset the stack	lda	1,s		Bump the stack up to prepare	sta	11,s		to take off the 3 parameters	lda	3,s			sta	13,s	pla			get rid of message space		pla			get rid of data1 space	pla					pla			get rid of data2 space	pla					lda	#0		return 0 to caller	sta	5,s	sta	7,s			plb		rtl		t_cdev	dc.w	cccE		Null	dc.w	cccE		handle machine message	dc.w	cccE		handle boot message	dc.w	icc		init cdev controls	dc.w	cccE		close the cdev	dc.w	cccE		handle event message	dc.w	ccc		create cdev controls	dc.w	ham		handle about message	dc.w	cccE		handle rectangle message	dc.w	hhm		handle hit message	dc.w handle_run		;RunCDEV	;;	ccc - create cdev controls.;;	entry	[data1] = window pointer.;		(ramlist..) = table of pointers to control templates to create.;;	exit	controls are created.ccc	lda data1	sta my_wind_ptr		;keep copy of window ptr for later	lda data1+2	sta my_wind_ptr+2	pha	pha			space for result	_TotalMem			pulll	l1		total memory available	lda l1	sta my_total_mem	;save for later	lda l1+2	sta my_total_mem+2		lda	l1+1	jsr	cms		compute max size		jsr get_mem_state	;made subroutine 10/29/91 -- Monte Benaresh		jsr	dmt		determine machine type		bcs @not_01		if a new machine;	if not a ten speed, then remove the resize checkbox.;;;	lda	#0;;;	sta	killresize;;;	sta	killresize+2*** optimized 9-Dec-91 DAL	stz killresize	stz killresize+2*** end 9-Dec-91@not_01;	check video mode and resize scroll bars for 320 mode	pha			;space for result	_GetMasterSCB	pla	xba	xba			;test bit 7	bmi @640		;all set for 640 mode@320	lda ram1+6+2		;get x1 for ctl rect	clc	adc #scroll320Width	sta ram1+6+6		;store in x2	lda ram2+6+2		;get x1 for ctl rect	clc	adc #scroll320Width	sta ram2+6+6		;store in x2@640ccc1	pha			space for result	pha	pushl	data1		window pointer	pushw	#3		next item is a ptr to a list of template pointers	pushl	#ramList	_NewControl2	pla	pla			don't care about result		pha	pha			space for result	pushl	data1		window ptr	pushl	#7		if of ram disk scroll bar	_GetCtlHandleFromID	pulll	ramhdl			pha	pha			space for result	pushl	data1		window ptr	pushl	#8		if of cache scroll bar	_GetCtlHandleFromID	pulll	cachehdl	cccE	rts;;	ham - handle about message.;;	entry	[data1] = window pointer.;		(ramAbout..) = template for about screen.;;	exit	The About control is created.ham	pha			space for result	pha	pushl	data1		window pointer	pushw	#0		next item is a ptr to a template	pushl	#ramAbout	_NewControl2	pla	pla			don't care about result	rtshandle_run	;handle RunCDEV message;	check low word of tick count to decide whether it's;	time to update our RAM use statistics	pha	pha			;space for result	_GetTick	pla	plx	sta w1			;save low word	sec	sbc last_redraw		;get elapsed time	cmp #180+1		;this many ticks since last update?	bcc @no_redraw	lda w1			;low word of current tick	sta last_redraw		;update our redraw time	jsr get_mem_state	;get free mem, etc	lda #10			;ID of mem in use ctl	jsr @draw_ctl	lda #11			;ID of free mem ctl	jsr @draw_ctl	lda #13			;ID of max block ctl	jsr @draw_ctl@no_redraw	rts@draw_ctl	;private subroutine for this routine	pha	pha			;space for result	ldx my_wind_ptr+2	phx	ldx my_wind_ptr	phx	pea $0000	pha			;low word of ctl ID	_GetCtlHandleFromID	_DrawOneCtl		;pass handle left on stack	rts;;	hhm - handle hit message.;;	entry	[data1] = handle to control that was hit.;		[data2] = id of control that was hit.;;	exit	battery parameter locations are updated.hhm	lda	data2	cmp	#9	bne	hhm2		if not the resize checkbox		pha			space for result	pushl	data1		handle to control	_GetCtlvalue		get control value	pla	beq	hhm1		if not set	lda	#1hhm1	pha	ldx	#$54		battery parameter for resizing ram disk	jsr	wbp		write battery parameter	pla	shortm	sta	>$e115ff	set ram disk power up byte in memory	longm	rts	hhm2	cmp	#1	bne	hhm3		if not ram disk scroll bar		pha			space for result	pushl	data1	_GetCtlValue	lda	max	sec	sbc	1,s	jsr	grsE		set the ramdisk battery params	pla	;jmp	drs		display ramdisk setting and return	rtshhm3	cmp	#2	bne	hhm5		if not cache scroll bar		pha	pushl	data1	_GetCtlValue	lda	max	sec	sbc	1,s	jsr	gcsE		set the ramdisk battery params	pla	;jmp	dcs		display cache size and return	rts	hhm5	rts;;	hrm - handle rectangle message.;;	entry	[data1] = ptr to rectangle.;;	exit	rectangle is adjusted if the resize checkbox isn't there.hrm	jsr	dmt		determine machine type	bcs	hrm1		if tenspeed or greater machine	lda	#96	ldy	#recty1	sta	[data1],y	set lower part of rectanglehrm1	rts		;;	icc - init cdev controls.;;	entry	[data1] = window pointer.;		(iccbat..) = table of battery parameters to check.;;	exit	controls are intialized to the battery settings.icc	pha	pha			;space for result	_GetTick	pla	plx	sta last_redraw		;save low word only, keep track of last…				;…time we redrew ram usage statistics	jsr	gcs		get cache size	jsr	grs		get ram disk size	lda	max	sec		sbc	ramdisk	ldx	#1	jsr	scv		set control value		lda	max	sec	sbc	cache	ldx	#2	jsr	scv		set control value	jsr	dmt		determine machine type	bcc	icc1		if not resize control		ldx	#$54	jsr	rbp		read battery parameter	ldx	#9		id of resize box	jsr	scvE		set control value	icc1	ldx	#1		if of control	jsr	scp		set control params	ldx	#2		id of control to set	jsr	scp		set control params	lda	#hrc		handle ram control	ldx	#1		id of control	jsr	sca		set control action		lda	#hcc		handle cache control	ldx	#2		id of control	jsr	sca		set control action		jsr	dcs		display cache size		jmp	drs		display ram size and return			;	teriary routines called by the above routines.		;;	cms - calculate max size.;;	entry	(a) = total memory / 256.;;	exit	(max) = max size of ramdisk or cache in 32K chunks.cms	lsr	a	lsr	a		divide by 1024	sec	sbc	#256	lsr	a	lsr	a	lsr	a	lsr	a			lsr	a		divide by 32	cmp	#$fe	bcc	cms1		if ok value	lda	#$fe		maximum value can be 254*32cms1	sta	max	rts		;;	dcs - display cache size.;;	entry	(cache) = current size of cache in 32K chunks.;;	exit	cache size is displayed.;		(cstr..) = ascii representation of size of cache in kilobytes.dcs	lda	cache	asl	a	asl	a	asl	a	asl	a	asl	a		*32	pha			int to convert	pushl	#cstr		cache string	pushw	#5		5 chars long	pushw	#0		unsigned	_Int2Dec	pushl	cachehdl	_DrawOneCtl		rts		;;	dmt - determine machine type.;;	entry	none.;;	exit	(c) set if not a rom 1 machinedmt	lda	#0			pha			space	pha			space	pha			space	pha			space	pha			(a)	pha			(x)	pha			(y)	pushw	#$fe1f		entrypoint to call	_FWEntry		call the firmware	ply			(y)	plx			(a) - unused	plx			(x) - unused	plx			(p) - unused	cpy	#2	rts	;;	drs - display ram size.;;	entry	(ramdisk) = size of ram disk in 32K chunks.;;	exit	cache size is displayed.;		(cstr..) = ascii representation of size of cache in kilobytes..drs	lda	ramdisk	asl	a	asl	a	asl	a	asl	a	asl	a		*32	pha			int to convert	pushl	#rstr		cache string	pushw	#5		5 chars long	pushw	#0		unsigned	_Int2Dec		pushl	ramhdl	_DrawOneCtl			rts;;	gcs - get cache size.;;	entry	battery parameter $81 = cache size or $ff if unitialized.;;	exit	battery parameter is updated if out of range.;		(cache) = size of cache.;;	alternate entry point:  gcsE.;;	entry	(a) = new size of cache.;	;	exit	battery parameters are updated.;		(cache) = new size of cache.gcs	ldx	#$81		battery parameter for cache size	jsr	rbp		read battery parameter	and	#$ff			sta	cache		save size of cache	cmp	#$ff	bne	gcs1		if has been initialized allready	lda	#1	bra	gcs2		reset to smallest size	gcs1	cmp	max	bcc	gcs3		if ok	beq	gcs3		if ok	lda	maxgcsE	gcs2	sta	cache		save	ldx	#$81		battery parameter for cache size	jmp	wbp		write battery parameter and returngcs3	rts		;;	grs - get ram disk size.;;	entry	battery parameter $36 = ramdisk size or $ff if unitialized.;;	exit	both battery parameters are updated if out of range.;		(ramdisk) = size of ramdisk.;;	alternate entry point:  grsE.;;	entry	(a) = new size of ramdisk.;	;	exit	both battery parameters are updated.;		(ramdisk) = new size of ramdisk.grs	ldx	#$36		battery parameter for minimum ram disk size	jsr	rbp		read battery parameter	and	#$ff	sta	ramdisk		save size of ramdisk	cmp	#$ff	bne	grs1		if has been initialized allready	lda	#1			bra	grs2		reset to smallest size	grs1	cmp	max	bcc	grs3		if ok	beq	grs3		if ok	lda	maxgrsE	grs2	sta	ramdisk		save	pha			save for now	ldx	#$36	jsr	wbp		write battery parameter	pla	ldx	#$37	jmp	wbp		write battery parameter and return	grs3	rts		;;	hcc - handle cache control.;;	entry	[handleid,s] = handle of control that was hit.;		maxpitch = maximum pitch used on the GS.;		(part,s) = part of control that was hit.;		;		called by control manager.;;	exit	(cache) = new size of the cache.;		control value is set and new value displayed if different.hcc	phb	phk	plb		lda	part,s	cmp	#5	bne	hcc1		if not hit in scroll bar up arrow	lda	cache	cmp	max	bcs	hcc7		if already the highest possible	ina		bra	hcc4		set the new valuehcc1	cmp	#6	bne	hcc2		if not in scroll bar down arrow	lda	cache	beq	hcc7		if alredy the lowest possible	dea	bra	hcc4		set the new valuehcc2	cmp	#7	bne	hcc3		if not page up	lda	cache	clc	adc	#4	cmp	max	bcc	hcc4		if ok	lda	max	bra	hcc4		set to the max possible	hcc3	cmp	#8		page down	;bne	hcc7		if dragging the thumb	bne @thumb		if dragging the thumb  *** changed 10/28/91 by Monte	lda	cache	sec	sbc	#4	bcs	hcc4		if ok, set the new value	lda	#0		reset to min possible	;*** next code added 10/28/91 by Monte Benaresh	bra @set_val@thumb	pha			;space for result	lda	handleid+2+2,s	hi word of handleid	pha	lda	handleid+4,s	lo word of handleid	pha		_GetCtlValue	lda max	sec	sbc 1,s			;subtract new value	plx			;fix stack	; fall through and set new value@set_val	;*** end 10/28/91hcc4	cmp	cache	beq	hcc7		if nothing changes	sta	cache		save new value	lda	max	sec	sbc	cache	pha			new ram disk	lda	handleid+2+2,s	hi word of handleid	pha	lda	handleid+4,s	lo word of handleid	pha		_SetCtlValue	hcc6	jsr	dcs		display cache size	hcc7	jmp	hrcE		clean up stack and exit	;;	hrc - handle ram control.;;	entry	[handleid,s] = handle of control that was hit.;		(part,s) = part of control that was hit.;		;		called by control manager.;;	exit	(ramdisk) = new size of ramdisk.;		display is updated if out of range.;;	alternate entry point: hrcE.;;	hrcE is used to get the stuff off the stack from this sort of call.hrc	phb	phk	plb		lda	part,s	cmp	#5	bne	hrc1		if not hit in scroll bar up arrow	lda	ramdisk	cmp	max	bcs	hrc7		if already the highest possible	ina		bra	hrc4		set the new valuehrc1	cmp	#6	bne	hrc2		if not in scroll bar down arrow	lda	ramdisk	beq	hrc7		if alredy the lowest possible	dea	bra	hrc4		set the new valuehrc2	cmp	#7	bne	hrc3		if not page up	lda	ramdisk	clc	adc	#4	cmp	max	bcc	hrc4		if ok	beq	hrc4		if ok (max possible)	lda	max	bra	hrc4		set to the max possible	hrc3	cmp	#8		page down	;bne	hrc6		if dragging the thumb	bne @thumb		if dragging the thumb  *** changed 10/28/91 by Monte	lda	ramdisk	sec	sbc	#4	bcs	hrc4		if ok, set the new value	lda	#0		reset to min possible	;*** next code added 10/28/91 by Monte Benaresh	bra @set_val@thumb	pha			;space for result	lda	handleid+2+2,s	hi word of handleid	pha	lda	handleid+4,s	lo word of handleid	pha		_GetCtlValue	lda max	sec	sbc 1,s			;subtract new value	plx			;fix stack	; fall through and set new value@set_val	;*** end 10/28/91hrc4	cmp	ramdisk	beq	hrc7		if hasn't changed;	jsr	grsE		set the ramdisk battery params	sta	ramdisk	lda	max	sec	sbc	ramdisk	pha			new ram disk	lda	handleid+2+2,s	hi word of handleid	pha	lda	handleid+4,s	lo word of handleid	pha		_SetCtlValuehrc6	jsr	drs		display ram size	hrc7hrcE	plb			restore data bank	lda	1,s	sta	7,s	lda	2,s	sta	8,s	tsc	clc	adc	#6		move stack up	tcs	rtl				;;	rbp - read battery parameter.;;	entry	(x) = parameter to read.;;	exit	(a) = value of parameter.rbp	pha			space for result	phx			parameter to read	_ReadBparam	pla			get value	rts;;	sca - set control action.;;	entry	(a) = address of action proc.;		(x) = lo word of control id.;		[data1] = window ptr.;;	exit	action proc is set.sca	ldy	#^sca	phy			bank of action procedure	pha			address of action proc	pha	pha			space for result	pushl	data1		window ptr	pushw	#0		hi word of control id	phx			lo word of control id	_GetCtlHandleFromID	_SetCtlAction		set action proc	rts	;;	scp - set control params.;;	entry	(x) = lo word of control id.;		[data1] = windwo ptr.;		(max) = data size of scroll bar.;;	exit	control parameters are set for scroll bar.scp	lda	max			ina*** added 9-Dec-91 DAL*** Since we're passing 4 for the View size, we need to pass*** max+4, not max+1, as the data size.	inc a	inc a	inc a*** end 9-Dec-91	pha			data size of scroll bar	pushw	#4		view of scroll bar		pha	pha			space for result	pushl	data1		window pointer		pushw	#0		hi word of id	phx			lo word of id	_GetCtlHandleFromID	_SetCtlParams		handle to control is on the stack	rts	;;	scv - set control value.;;	entry	(a) = value of control to set -1.;		(x) = id of control.;		[data1] = window pointer.;;	exit	control is set to the value desired.;;	alternate entry point: scvE.;;	scvE is called when setting the contol value of a checkbox.	scvE	tay	beq	scv1		if checkbox not set	lda	#1scv	scv1	pha			value to set	pha			space for result	pha					pushl	data1		window pointer	pushw	#0		hi word of id	phx			lo word of id	_GetCtlHandleFromID	_SetCtlValue		handle to control is on the stack	rtsget_mem_state		;get state of memory use and update strings	;made subroutine 10/29/91 by Monte Benaresh	pha	pha			;space for result	_RealFreeMem		changed 1/24/91 by Monte Benaresh --	;			Note that this changes the value shown for	;			"Memory in use" to NOT include purgeable	;			memory	pulll	l2		free memory available	lda my_total_mem	sec	sbc	l2	sta	l3	lda my_total_mem+2	sbc	l2+2	sta	l3+2		memory in use	lda	l3+1	lsr	a			lsr	a		/ (256 * 4)		pha			int to convert	pushl	#str1		dest string	pushw	#5		5 chars long	pushw	#0		unsigned	_Int2Dec		lda	l2+1	lsr	a	lsr	a		/ 256 * 4		pha			int to convert	pushl	#str2		dest string	pushw	#5		5 chars long	pushw	#0		unsigned	_Int2Dec			pha	pha	_MaxBlock	pulll	l1		lda	l1+1	lsr	a	lsr	a		/ (256 * 4)		pha			int to convert	pushl	#str3		dest string	pushw	#5		5 chars long	pushw	#0		unsigned	_Int2Dec		rts	;;	wbp - write battery parameter.;;	entry	(a) = value of parameter to set.;		(x) = battery parameter to set.;;	exit	battery parameter is set.wbp	pha			new value	phx			parameter to set	_WriteBparam	rts			;	data used here.cache	ds.b	2		size of cachecachehdl  ds.b	4		handle to cache controlramdisk	ds.b	2		size of ramramhdl	ds.b	4		handle to ramdisk controlmax	ds.b	2		max size of cache or ram disk		;next storage added by Monte Benaresh -- Oct 1991my_wind_ptr	ds.l 1		;CDEV's window pointermy_total_mem	ds.l 1		;total machine memorylast_redraw	ds.w 1		;low word of tick count at last redraw;	define storage for total memory amount.str1	ds.b	5		5 chars for string	dc.b	'K'		;	define storage for free memory amount.str2	ds.b	5		5 chars for string	dc.b	'K'		;	define storage for max block amount.str3	ds.b	5		5 chars for string	dc.b	'K'		;	define storage for cache amount.cstr	ds.b	5		5 chars for string	dc.b	'K'		append the K;	define storage for ramdisk amount.rstr	ds.b	5		5 chars for the string	dc.b	'K'		append the K				endp	end