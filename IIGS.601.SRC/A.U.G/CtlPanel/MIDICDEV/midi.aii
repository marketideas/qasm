;;		midi - cdev to choose midi driver.;;		Michael Stein		6/20/90;;		(c) Copyright Apple Computer 1990.		msb	off		string	asis		blanks	off		INCLUDE	'E16.CONTROL'		INCLUDE	'M16.UTIL'		INCLUDE	'M16.GSOS'		INCLUDE	'M16.CONTROL'		INCLUDE	'M16.MISCTOOL'		INCLUDE 'M16.LIST'		INCLUDE	'M16.MEMORY'		INCLUDE	'M16.INTMATH'		INCLUDE	'M16.PRINT'		ENTRY	bogusCDEV,\			InitCDEV,\			hitCDEV, \			CloseCDEV,\			CreateCDEV,\			AboutCDEV				ENTRY	WriteData		import	sulzp0		equ	0		;Zero page usezp1		equ	zp0+4zpsize		equ	zp1+4		;Length of zero page.MemRecSize	equ	5		;Size of each member record.AShareFST	equ	$0d*##############################################################################** Below is the main entry point for this CDEV.  All messages (commands)* passed to the CDEV by the Control Panel go through this point.  This CDEV* handles only 4 of the standard CDEV calls.  These are listed below:**	Call Name	Call Number*	---------	-----------*	INIT		4*	CLOSE		5*	CREATE		7*	ABOUT		8** ON ENTRY:	C,X,Y =	Unknown*		Stack =	Result Space (Long)*			Message (Word)*			Data1 (Long)*			Data2 (Long)*			Return Address (3 Bytes)**			Message = Call Number*			Data1 = Window Grafport*			Data2 = Unused** ON EXIT	C,X,Y =	Changed*		Stack =	Result (Long)**			Result = 0 (always)**##############################################################################main		PROC		ENTRY	Data1,Data2		ENTRY	ControlList		ENTRY	AboutList		ENTRY	MErrorList		ENTRY	Mem1RecH		ENTRY	MyID		ENTRY	List1Count		ENTRY	List1ID		ENTRY	CreateError		phb			;Save old data reg		phk			;Set data reg = prog reg		plb		lda	5,s		;Load DATA2 off the stack		sta	Data2		;and store it locally.		lda	7,s		sta	Data2+2		lda	9,s		;Load DATA1 off the stack		sta	Data1		;and store it locally.		lda	11,s		sta	Data1+2		lda	13,s		;Load MESSAGE off the		sta	Message		;stack and store it locally.		lda	1,s		;Bump the stack up to prepare		sta	11,s		;to take off the 3 parameters		lda	3,s		;that we stored about.		sta	13,s		PullWord		;Get rid of MESSAGE space		PullLong		;Get rid of DATA1 space		PullLong		;Get rid of DATA2 space		lda	Message		;Load the call number		cmp	#12		;Compare againts max+1		bcs	ret_addr	;If >= max+1, just leave.		pea	ret_addr-1	;Push our return address		asl	a		;Times 2 into word table		tax			;Move into index reg		lda	cdev_calls,x	;Load the address of call handler		pha			;Push the address of routine on the stack		rts			;Jump to the call handlerret_addr	lda	#0		;Make sure we return zeros.		sta	5,s		sta	7,s		plb			;Restore NDAs data bank register		rtl			;Return to Control Panel NDA.Message		dc.w	0		;Local storage for MESSAGEData1		dc.l	0		;Local storage for DATA1Data2		dc.l	0		;Local storage for DATA2MyID		dc.w	0CreateError	dc.w	0		;0 = no error, 1 = errorcdev_calls	dc.w	bogusCDEV-1	;0	;Null		dc.w	bogusCDEV-1	;1	;MachineCDEV		dc.w	bogusCDEV-1	;2	;BootCDEV		dc.w	bogusCDEV-1	;3	;ShutdownCDEV		dc.w	InitCDEV-1	;4		dc.w	CloseCDEV-1	;5		dc.w	bogusCDEV-1	;6	;EventsCDEV		dc.w	CreateCDEV-1	;7		dc.w	AboutCDEV-1	;8		dc.w	bogusCDEV-1	;9	;RectCDEV		dc.w	hitCDEV-1	;10	;HitCDEV		dc.w	bogusCDEV-1	;11	;RunCDEVControlList	dc.l	List1Control		dc.l	SText1Control	;Port:		dc.l	SText2Control		dc.l	radio1		dc.l	radio2		dc.l	radio3		dc.l	radio4		dc.l	radio5		dc.l	radio6		dc.l	radio7		dc.l	radio8		dc.l	radio9		dc.l	radio10		dc.l	0LeftEdge	equ	10RightEdge	equ	190TL1Vert		equ	90BR1Vert		equ	TL1Vert+42TL2Vert		equ	79BR2Vert		equ	121TL3Vert		equ	TL1Vert-10BR3Vert		equ	TL1VertTL4Vert		equ	69BR4Vert		equ	79List1Control	dc.w	14		;PCountList1ID		dc.l	1		;ID number		dc.w	TL1Vert		dc.w	LeftEdge		dc.w	BR1Vert		dc.w	RightEdge		dc.l	$89000000	;listcontrol ID		dc.w	0		;Flag		dc.w	$1401+fCtlCanBeTarget+fCtlWantEvents	;More Flags		dc.l	0		;Ref conList1Count	dc.w	0		dc.w	0		;Number seen		dc.w	6		;Single selection Pascal stringsList1Start	dc.w	1		;1st member seen		dc.l	0		;Draw routine		dc.w	10		;Height		dc.w	5		;List record sizeMem1RecH	dc.l	0SText1Control	dc.w	8		;PCount		dc.l	3		;ID number		dc.w	3		dc.w	LeftEdge		dc.w	3+10		dc.w	RightEdge		dc.l	$81000000	;Static text		dc.w	1		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SText1		dc.w	SText1LenSText1		dc.b	'MIDI connection:'SText1Len	equ	*-SText1SText2Control	dc.w	8		;PCount		dc.l	3		;ID number		dc.w	TL3Vert		dc.w	LeftEdge		dc.w	BR3Vert		dc.w	RightEdge		dc.l	$81000000	;Static text		dc.w	1		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SText2		dc.w	SText2LenSText2		dc.b	'MIDI driver:'SText2Len	equ	*-SText2AboutList	dc.w	8		;Pcount		dc.l	1		;ID		dc.w	38,5,138,280		dc.l	$81000000		dc.w	1		dc.w	$1000		dc.l	0		dc.l	AboutText		dc.w	AboutTextLenAboutText	dc.b	'The MIDI Control Panel lets you specify how you are using '		dc.b	'a MIDI device.  Select the port or slot that the MIDI '		dc.b	'device is connected to and then specify the MIDI driver.'		DC.B	$0D,'Example:',$0D		DC.B	'     An APPLE MIDI interface connects to either the '		DC.B	'printer or modem port, and the driver file is '		DC.B	'ÒApple.MidiÓ.', $0D		DC.B	'     MIDI driver files are read from the ÒDriversÓ folder. 'AboutTextLen	equ	*-AboutTextMErrorList	dc.w	8		;Pcount		dc.l	1		;ID		dc.w	TL1Vert		dc.w	LeftEdge		dc.w	BR2Vert		dc.w	RightEdge		dc.l	$81000000		dc.w	1		dc.w	$1000		dc.l	0		dc.l	MErrorText		dc.w	MErrorTextLenMErrorText	dc.b	'An error occured while trying to allocate '		dc.b	'memory.  This CDEV requires some free '		dc.b	'memory in order to operate.'MErrorTextLen	equ	*-MErrorText;leftedge2	equ	35leftedge2	equ	10radio1ID	equ	10radiotop	equ	14rhspace		equ	40rvspace		equ	12		vertical spacing between radio buttons;	radio buttons.radio1	dc.w	8		Pcount	dc.l	radio1ID	ID	dc.w	radiotop	dc.w	leftedge	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio1T		ptr to title	dc.w	0		initial valueradio1t	str	'Printer Port'radio2	dc.w	8		Pcount	dc.l	radio1ID+1	ID	dc.w	radiotop+rvspace	dc.w	leftedge	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio2T		ptr to title	dc.w	0		initial valueradio2t	str	'Modem Port'radio3	dc.w	8		Pcount	dc.l	radio1ID+2	ID	dc.w	radiotop+rvspace*2;	dc.w	leftedge+25	dc.w	leftedge	dc.w	radiotop+rvspace*2+10;	dc.w	leftedge+25+100	dc.w	leftedge+100	dc.l	$81000000	;Static text	dc.w	1		;Flag	dc.w	$1000		;More flag	dc.l	0	dc.l	radio3t	dc.w	radio3lenradio3t	 dc.b	'Card Slot:'radio3len  equ	*-radio3tradio4	dc.w	8		Pcount	dc.l	radio1ID+3	ID	dc.w	radiotop+rvspace*3	dc.w	leftedge2	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio4T		ptr to title	dc.w	0		initial valueradio4t	str	'1'radio5	dc.w	8		Pcount	dc.l	radio1ID+4	ID	dc.w	radiotop+rvspace*3	dc.w	leftedge2+rhspace	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio5T		ptr to title	dc.w	0		initial valueradio5t	str	'2'radio6	dc.w	8		Pcount	dc.l	radio1ID+5	ID	dc.w	radiotop+rvspace*3	dc.w	leftedge2+rhspace*2	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio6T		ptr to title	dc.w	0		initial valueradio6t	str	'3'radio7	dc.w	8		Pcount	dc.l	radio1ID+6	ID	dc.w	radiotop+rvspace*3	dc.w	leftedge2+rhspace*3	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio7T		ptr to title	dc.w	0		initial valueradio7t	str	'4'radio8	dc.w	8		Pcount	dc.l	radio1ID+7	ID	dc.w	radiotop+rvspace*4	dc.w	leftedge2	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio8T		ptr to title	dc.w	0		initial valueradio8t	str	'5'radio9	dc.w	8		Pcount	dc.l	radio1ID+8	ID	dc.w	radiotop+rvspace*4	dc.w	leftedge2+rhspace	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio9T		ptr to title	dc.w	0		initial valueradio9t	str	'6'radio10	dc.w	8		Pcount	dc.l	radio1ID+9	ID	dc.w	radiotop+rvspace*4	dc.w	leftedge2+rhspace*2	dc.w	0		bottom y - let system figure it out	dc.w	0		right x  - let system figure it out	dc.l	radiocontrol	dc.w	1		family 1	dc.w	FctlProcRefNotPtr	dc.l	0		ref con	dc.l	radio10T	ptr to title	dc.w	0		initial valueradio10t  str	'7'		ENDP*##############################################################################*			Below are the CDEV handler routines		      **##############################################################################bogusCDEV	PROC		rts		ENDPHitCDEV		PROC		IMPORT	scv,slot,intext		hit		lda	data2		id of control		cmp	#10		bcc	hit2		if not radio control		cmp	#12		beq	hit2		if slot button		bcs	hit1		if external slot selection				pha			save for now		lda	slot		clc		adc	#10+2		tax		lda	#0		jsr	scv		set control value		pla				sec		sbc	#10-1		(c) clear, convert to slot 1 or 2		sta	slot		save		stz	intext		rtshit1		sbc	#10+2		(c) set, convert to external slot 1-7		sta	slot		lda	#1		sta	intexthit2		rts				ENDP										InitCDEV	PROC		IMPORT	slot,intext,scv,wptrinit		lda	data1		sta	wptr		lda	data1+2		sta	wptr+2						PushLong #0		;Result space		PushLong Data1		;Window pointer		Pushlong #1		;Push list #		_GetCtlHandleFromID		pla		plx				pha			;space for result		pushword #0		;start from top		phx			;hi word of list control		pha			;lo word of list control		_NextMember2		;find the selected item		PushLong #0		;Result space		PushLong Data1		;Window pointer		pushLong #1		;Push list #		_GetCtlHandleFromID		_SelectMember2		;make sure it is visible				;		init the radio buttons.		lda	#1		ldx	intext		bne	init2		if external slot				ldy	slot		cpy	#2+1		bcs	init3		if some sort of error occurred		ldx	#10		dey		beq	init1		if printer port		inxinit1		jmp	scv		set control value and returninit2		lda	slot		clc		adc	#10+2		tax		lda	#1		jmp	scv		set control value and return			init3		rts				ENDP*##############################################################################******************************************************************************** Times5** This routine will multiply the number in X with 5 and return the result* in the variable AddIndex.** Inputs: X = Number to mulitiply** Outputs: AddIndex = Result (long)*******************************************************************************Times5		PROC		IMPORT	drvr		EXPORT AddIndex		PushLong #0		;Result space		phx			;Item number		PushWord #5		;Item length		_Multiply		PullLong AddIndex	;Offset into member list		rtsAddIndex	dc.l	0		ENDPCloseCDEV	PROC		IMPORT	drvr		phd			;Save the old D reg.		tsc			;*Stack -> C reg.		sec			;Add 4 bytes		sbc	#4		; (actually minus)		tcs			;C reg. -> *Stack		ina		tcd			;C reg. -> *DPage		lda	CreateError		beq	@CloseIt		jmp	Exit@CloseIt	ldx	List1ID		;Look at list #1		jsr	FindSelected	;Find selected member		bne	@FoundOne	;Branch if we found one!		jmp	Exit		;No member selected! (just leave)@FoundOne	dex			;Minus 1 for multiply		jsr	Times5		;Times 5 for each record.;------------------------------------------------------------------------------; Below we add the offset for this record number (# times 5) to the; base location to the member pointer list.;------------------------------------------------------------------------------		PushLong Mem1RecH		_HLock		lda	Mem1RecH		sta	zp0		lda	Mem1RecH+2		sta	zp0+2		ldy	#2		lda	[zp0]		tax		lda	[zp0],y		sta	zp0+2		stx	zp0		clc		lda	AddIndex	;Load low word of offset		adc	zp0		;Add it to low word of base		sta	zp0		;Store on zero page.		lda	AddIndex+2	;Now do the same for the		adc	zp0+2		;high word.		sta	zp0+2		ldy	#2		;Zero page location 00-03 now		lda	[zp0]		;points to a value that is a		tax			;pointer to the string to move.		lda	[zp0],y		;Get this pointer and hold it		pha			;in the X and Y registers.					;Pushlong pointer to string.		phx			;Must go onto the stack high-low!;------------------------------------------------------------------------------; Below we move the name of the file from our member list into the; MIDI.SETUP file buffer for writting out.  We're falling through here; with the source address pointer on the stack.;------------------------------------------------------------------------------		PushLong #drvr		PushLong #33		_BlockMove		PushLong Mem1RecH		_HUnlock		jsr	WriteDataExit		tsc			;*Stack -> C reg.		clc			;Subtract 4 bytes.		adc	#4		; (actually plus)		tcs			;C reg. -> *Stack		pld			;Restore old D reg.		lda	MyID		beq	@NoID		PushWord MyID		;Dispose of all our membory		_DisposeAll		PushWord MyID		;Dispose of our		_DeleteID		;memory ID.@NoID		rts******************************************************************************** FindSelected** This routine will call the list manager tool to find the selected member* of the specified list and return it in X.** Inputs: X = List number** Outputs: X = Item number ( 0 = no item selected)*******************************************************************************FindSelected	PushWord #0		;Result space (for _ResetMember2);------------------------------------------------------------------------------; Below we get the control handle for list #n and put it on the stack; for the _ResetMember2 call.;------------------------------------------------------------------------------		PushLong #0		;Result space		PushLong Data1		;Window pointer		PushWord #0		;Push high word of list #		phx			;Push low word of list #		_GetCtlHandleFromID		bcs	@BadExit;------------------------------------------------------------------------------; After the above code, the control handle is on the stack for use in the; next call.;------------------------------------------------------------------------------		ldx	#$131C		jsl	>$E10000	;_ResetMember2		plx			;Pull item number		bcs	@BadExit		rts@BadExit	lda	#0		rts		ENDP*##############################################################################AboutCDEV	PROC		PushLong #0			;Space for result		PushLong Data1			;Grafport		PushWord #0			;Ptr to single		PushLong #AboutList		_NewControl2		PullLong		rts		ENDP*##############################################################################CreateCDEV	PROC		PushWord #0			;Result space		PushWord #$5000			;DA type		_GetNewID		PullWord MyID		bcc	@GotID		jmp	@MemoryError1@GotID		PushLong #0			;Result space		PushLong #1			;Size of block		PushWord MyID			;User ID		PushWord #$8018			;Attributes		PushLong #0			;Pointer to mem		_NewHandle		PullLong Mem1RecH		bcs	@MemoryError2		stz	List1Count		stz	PrePickFlag		;0 = don't pre-pick		jsr	ReadPSetup		bcs	@L1		inc	PrePickFlag		;Try to pre-pick midi driver filename.		;------------------------------------------------------------------------------; Below we add zpsize bytes to the stack and point the direct page register; there.  We need zpsize bytes of zero page in SCAN4DRIVERS.;------------------------------------------------------------------------------@L1		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 12 bytes		sbc	#zpsize			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage		jsr	Scan4Drivers		tsc				;*Stack -> C reg.		clc				;Subtract 12 bytes.		adc	#zpsize			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.		PushLong #0			;Space for result		PushLong Data1			;WindPort		PushWord #3			;Ptr to Ptrs		PushLong #ControlList		;Ptr to control list		_NewControl2		PullLong			;Discard zeros		stz	CreateError		;Flag no error!		jsr	stl			;sort the lists				rts@MemoryError1	stz	MyID			;Flag no ID@MemoryError2	lda	#0001			;Flag error!		sta	CreateError		PushLong #0			;Space for result		PushLong Data1			;WindPort		PushWord #0			;Ptr to single		PushLong #MErrorList		;Ptr to control		_NewControl2		PullLong			;Discard		rts;;	gnp - generate network path.;gnp		phd			;Save the old D reg.		tsc			;*Stack -> C reg.		sec			;Add 12 bytes		sbc	#zpsize		; (actually minus)		tcs			;C reg. -> *Stack		ina		tcd			;C reg. -> *DPage		_FSTSpecific  gup_pblk	  get user path		lda	gup_pblk+8		sta	zp0		lda	gup_pblk+8+2		sta	zp0+2;	copy over path to user's folder.		sep	#$30		longa	off		longi	off		lda	[zp0]		sta	w1		# to copy		ldy	#2		ldx	#0gnp1		cpx	w1		bcs	gnp2		if done		lda	[zp0],y		sta	netobj,x	save here for now		iny		inx		bra	gnp1		move next char	;	add over the final ':Setup:MIDI.SETUP'gnp2		ldy	#0gnp3		cpy	#aafaL		bcs	gnp4		if done		lda	aafa,y		get next char of ending string		sta	netobj,x		iny		inx		bra	gnp3		process next char	gnp4		lda	w1		clc		adc	#aafaL				rep	#$30		longa	on		longi	on		and	#$ff		sta	netobj		length of gs/os string		ldx	#netobj		ldy	#^netobj		tsc			;*Stack -> C reg.		clc			;Subtract 12 bytes.		adc	#zpsize		; (actually plus)		tcs			;C reg. -> *Stack		pld			;Restore old D reg.		rts		;	parameter block to get user path from appleshare.aafa		dc.b	':Setup:MIDI.SETUP'aafaL		equ	*-aafa		length of this portion of pathgup_pblk  	dc.w	3		3 parameters		dc.w	AShareFST	id of the appleshare fst		dc.w	8		command for get user path		ds.b	4		ptr to pathnamenetobj		ds.b	100w1		ds.b	2;;	inb - is network boot.;;	entry	(inba..) = gs/os parameter block to get info on boot device.;;	exit	(x) != 0 if this was a network boot.inb		_DinfoGS  inba		get device info on boot device		ldx	#0		assume not network boot		lda	inba+$14	get device id		cmp	#$1e				bne	inb1		if not appleshare fst		inx			flag that this is a network bootinb1		rts		inba		dc.w	8		8 parameters needed		dc.w	1		want info on the boot device		dc.l	bootdev		buffer to name of boot device		ds.b	14		hold resultsbootdev		ds.b	35		hold name of boot device;;		stl - sort the lists.;	;		entry	scrolling list has been initialized.;;		exit	lists will be sorted as if they were uppercase only.stl		ldx	#1			PushLong #0		;Result space		PushLong Data1		;Window pointer		PushWord #0		;Push high word of list #		phx			;Push low word of list #		_GetCtlHandleFromID		pla			;lo word of control handle		ply			;hi word of control handle		jmp	sul		;sort uppercase list and return		;------------------------------------------------------------------------------; READPSETUP;; This routine reads in the MIDI.SETUP file in the system folder.  If it; doesn't exist, it will create one.;; Inputs: NONE; Outputs: NONT - Global data only;------------------------------------------------------------------------------		ENTRY	optr,WriteDataReadPSetup	jsr	inb		is network boot		txa		beq	read1		if not network boot		jsr	gnp		get network path		stx	optr		lo ptr to pathname		stx	optr+2		hi ptr to pathname				read1		_OpenGS OpenPBlock	;Open the file.		bcs	@L2		;Branch if error.		lda	OPRef		;Transfer reference number		sta	RPRef		;to the read and close call		sta	CRef		;blocks.		_ReadGS ReadPBlock	;Read the file.@L00		php			;Save the read/write error if any		_CloseGS CloseBlock	;Close the file		plp			;Restore read error flag@L1		rts@L2		cmp	#$0046		;File not found error?		sec			;Assume branch condition		bne	@L1		;Branch if not		_CreateGS CreatePBlock	;Try to create the file		bcs	@L1		;Branch on error		sep	#$30		longa	off		longi	off		ldy	Defdrvr		;Move the default MIDI driver@L10		lda	Defdrvr,y	;name into write buffer.		sta	drvr,y		dey		bpl	@L10		if more to copy		rep	#$30		longa	on		longi	on		lda	#defintext		sta	intext		internal/external flag				lda	#defslot			sta	slot		default slot		WriteData	_OpenGS OpenPBlock	;Open the file.		bcs	@L1		;Branch on error		lda	OPRef		;Transfer reference number		sta	RPRef		;to the write and close call		sta	CRef		;blocks.		_WriteGS ReadPBlock	;Write the file.				php			;Save the read/write error if any		_CloseGS CloseBlock	;Close the file		plp			;Restore write error flag@L1		rts;------------------------------------------------------------------------------; SCAN4DRIVERS;; This routine will scan the DRIVERS directory on the system disk in order; to find all the MIDI and Port drivers.  It will include the file names; into the appropriate list.  The AppleTalk driver will be; excluded.;; Inputs: NONE - Global data only; Outputs: NONT - Global data only;------------------------------------------------------------------------------Scan4Drivers	_OpenGS OpenDBlock		bcc	@L1		rts@L1		lda	ODRef		sta	GDERef		sta	CRefScanLoop	_GetDirEntryGS GetDirEntryBlock		bcc	@L00		cmp	#$004F		;Is the name just too big?		beq	ScanLoop	;Branch if yes.		jmp	ScanExit	;Else, error out.@L00		lda	FPath+2		;Load length of string		cmp	#0033		;Is the file name too large?		bcs	ScanLoop	;Branch if file name too large		xba			;Turn string into Pascal type		sta	FPath+2		;string.		lda	GDEFileType	;Is the file a driver?		cmp	#$00BB		;$BB = driver		bne	ScanLoop	;Branch if not.		ldx	GDEAUXType	;Is it a MIDI driver?;		cpx	#$0001		;1 = MIDI driver		cpx	#$300		; $300 = MIDI driver		bne	Back2scan		jsr	movemidi		bcs	ScanLoop	if error occurred		inc	List1Count	;bump the midi driver counterBack2Scan	jmp	ScanLoop	;Go back for more!ScanExit	_CloseGS CloseBlock		rts		longa	on		longi	on******************************************************************************** movemidi** This routine will add the name to the list record and copies * into a new memory segment.** Inputs:	None** Outputs:	Carry:	Clear = String copied and valid*	  		Set   = if memory error********************************************************************************movemidi	php		rep	#$30		longa	on		longi	on		lda	List1Count		ldx	Mem1RecH		ldy	Mem1RecH+2		jsr	BumpMemRec		bcs	PortBExit	;Branch on error		longa	off		longi	off		lda	PrePickFlag		beq	PortGExit		ldy	FPath+3@L1		lda	FPath+3,y		cmp	drvr,y		bne	PortGExit	if not the selected one		dey		bpl	@L1		ldy	#4		lda	#$80		sta	[zp1],yPortGExit	plp		clc		rtsPortBExit	plp		sec		rts;-----------------------------------------------------------------------------; The routine below will fetch a character from FPATH+3,Y and force it to; upper case.;-----------------------------------------------------------------------------GetUCase	lda	FPath+3,y	;Load the character		cmp	#$61		;If < "a" don't bother		bcc	@L1		cmp	#$7B		;If > "z"+1 don't bother		bcs	@L1		and	#$DF		;Else force it to upper case.@L1		rts		longa	on		longi	on;;	scv - set control value.;;	entry	(a) = value to set.;		(x) = id of control.;;	exit	none.		export	scvscv		pha			value to set		pha			space for result		pha						pushlong  wptr		window pointer		pushword  #0		phx			id of control		_GetCtlHandleFromID		_SetCtlValue		value to set was already on stack		rts******************************************************************************** BumbMemRec** This routine will bump the member record list, move the file name pointed* to by FPATH+3 into a new memory handle, update the new member record to* point to the new memory handle containing the file name and zero the* selection byte for the new member record..** Inputs:	A:	ListCount for this record*		X:	Low word of MemberList handle*		Y:	High word of MemberList handle** Outputs:	Carry:	Clear = String copied*	  		Set   = Memory allocation error*		Long C,X,Y if error*		Short C,X,Y if no error********************************************************************************BumpMemRec	sta	zp0		;Store the ListCount		stx	zp1		;Store the handle (low word)		sty	zp1+2		;Store the handle (high word);-----------------------------------------------------------------------------; Below we first try to unlock the handle of the member record list.  Then; get the old size, add the length of a new record, and the re-size the; handle.  After that, we just lock it down.  If we get any errors, we leave; the BUMPMEMREC routine with the carry set.;-----------------------------------------------------------------------------		PushLong zp1		;Push handle		_HUnlock		;Unlock the handle		bcc	@OKUnlock	;Branch if no error@ShortExit	jmp	@Exit		;Else we exit with carry set.@OKUnlock	PushLong #0		;Result space		PushLong zp1		;Push handle		_GetHandleSize		;Get the current handle size		tay			;Save the error state for now					;We fall through with the current					;size of the handle on the stack.		clc			;Add in the length of the new		pla			;member record item so we can		adc	#MemRecSize	;re-size the member record list.		tax		pla		adc	#0		phy			;Save the error state on the stack.		pha			;Push the new length of the		phx			;handle onto the stack.		PushLong zp1		;Push the handle		_SetHandleSize		;Set the new size		pha			;Save the error state on the stack.		PushLong zp1		;Push the handle		_HLock			;Lock the sucker.		plx			;Pull error on SetHandleSize		ply			;Pull error on GetHandleSize		bcs	@ShortExit	;Branch if error on _HLock		sec			;Assume error		bne	@ShortExit	;Branch if error on GetHandleSize		cpx	#0		;Error on SetHandleSize?		bne	@ShortExit	;Branch if yes.;-----------------------------------------------------------------------------; Below we ask for a segment of memory that will hold the file name in; FPATH+3.;-----------------------------------------------------------------------------		PushLong #0		;Result space		PushWord #0		;High word of size of block		lda	FPath+3		and	#$00FF		ina		pha			;Low word of size of block		PushWord MyID		;User ID		PushWord #$C018		;Attributes		PushLong #0		;Pointer to mem		_NewHandle		plx			;Pull the result off the stack		ply			;and hold it in X and Y regs.		bcs	@Exit		;Branch if we didn't get the memory.		pei	zp0		;Push the ListCount for later use.		stx	zp0		;Store handle to file name		sty	zp0+2		;buffer on zero page.		ldy	#2		;De-reference the handle		lda	[zp0]		;and store it back on to		tax			;the zero page at ZP0.		lda	[zp0],y		sta	zp0+2		stx	zp0		ldy	#2		;Dereference handle that		lda	[zp1]		;points to the beginning of		tax			;the member record list and		lda	[zp1],y		;put the result back into the		sta	zp1+2		;zero page location ZP1.		stx	zp1		plx			;Pull the ListCount back off		jsr	Times5		;and multiply it by 5.		clc			;Add the offset to the address		lda	AddIndex	;of the beginning of the buffer		adc	zp1		;to get new pointer to member		sta	zp1		;record and put it back into		lda	AddIndex+2	;the zero page location ZP1.		adc	zp1+2		sta	zp1+2		ldy	#2		;Dereference handle that points		lda	zp0		;to the location to put the		sta	[zp1]		;file name into and put it back		lda	zp0+2		;into the zero page location ZP0.		sta	[zp1],y		sep	#$30		;Short everything		longa	off		longi	off		ldy	#4		;Force the selection byte to		lda	#00		;zero (not selected).		sta	[zp1],y		ldy	FPath+3		;Load the length byte@CopyLoop	lda	FPath+3,y	;Move the entire string including		sta	[zp0],y		;the length byte into buffer pointed		dey			;to by ZPO		bpl	@CopyLoop		clc			;No error!@Exit		rts			;RETURN		longa	on		longi	on				PrePickFlag	dc.w	0ATalkName	str	'APPLETALK'OpenDBlock	dc.w	3		;PCountODRef		dc.w	0		dc.l	DPath		;Pathname pointer		dc.w	0001		;Request accessDPath		dc.w	DPathLen		dc.b	'*/SYSTEM/DRIVERS/'DPathLen	equ	*-DPath-2GetDirEntryBlock dc.w	13		;PCountGDERef		dc.w	0		dc.w	0		;Flags		dc.w	1		;Base		dc.w	1		;Displacement		dc.l	FPath		dc.w	0		;Entry numberGDEFileType	dc.w	0		;FileType		dc.l	0		;EOF		dc.l	0		;Block count		dc.l	0,0		;Create date/time		dc.l	0,0		;Mod date/time		dc.w	0		;AccessGDEAUXType	dc.l	0		;AUX typeFPath		dc.w	FPathLen		dc.w	0		ds.b	32FPathLen	equ	*-FPathCreatePBlock	dc.w	4		;PCount		dc.l	PPath		;Pathname pointer		dc.w	$C3		;Access byte		dc.w	6		;File type		dc.l	0		;AUX typeOpenPBlock	dc.w	3		;PCountOPRef		dc.w	0optr		dc.l	PPath		;Pathname pointer		dc.w	0003		;Request access (R/W)		PPath		dc.w	PPathLen		dc.b	'*/SYSTEM/DRIVERS/MIDI.SETUP'PPathLen	equ	*-PPath-2ReadPBlock	dc.w	4		;PCountRPRef		dc.w	0		dc.l	ReadPBuffer		dc.l	filelen		;Request count		dc.l	0		;Transfer countCloseBlock	dc.w	1		;PCountCRef		dc.w	0				export	wptr,intext,slot,drvr	wptr		ds.b	4		window pointerReadPBufferintext		ds.b	2		;0 = internal, 1 = externalslot		ds.b	2		;slot 1 - 7drvr		ds.b	32		;pascal string containing name of midi driverfilelen		equ	*-intext	;length of file;		default values.defintext	equ	0		;internaldefslot		equ	1		;printer portdefdrvr		str	'Apple.Midi'		ENDP		END