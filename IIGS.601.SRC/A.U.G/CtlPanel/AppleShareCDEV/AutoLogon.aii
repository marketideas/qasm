;======================================================================;;			AutoLogon.aii;; This file contains the routines used when mounting volumes at boot; time.  It does call some common routines in the main CDEV code, but; the routines here are only needed at boot time.;; 20-Sep-91 MSD	No longer starts up Font Manager or List Manager at;		boot time since these tools are never used.  Does a;		HideMenuBar after initializing the tools so we don't;		have to stare at an empty menu bar.  Changed NBP lookup;		to retry 12 times, every 1/4 second; this means you;		wait only 3 seconds instead of 11 for each server that;		can't be found.  Removed definition of DebugSymbols.;;  4-Oct-91 MSD	Must set up the MyID variable at boot time because the;		routines that use the Message Center use it.  Also make;		sure to allocate messageHandle.;; 29-Oct-91 MSD	Now starts up the List Manager at boot time so that it;		can use _CompareStrings.;; 07-Jan-92 MSD	When setting up the entity name for the lookup, it now;		copies the zone name into LookupZone so TryLogin will;		set the zone properly (the zone field was showing as;		empty as returned by FIListSessions2 and in the Finder's;		GetInfo Where card).;;======================================================================		print	push,off		include	'M16.GSOS'		include	'M16.Debug'		include	'M16.IntMath'		include	'E16.Types'		include	'M16.Memory'		include	'M16.Util'		include	'E16.Locator'		include	'M16.Locator'		include	'M16.Control'		include	'M16.QuickDraw'		include 'M16.Menu'				include	'AppleShareEQU.aii'		print	pop;======================================================================;;			AutoLogon;; This is the main routine called by the BootCDEV message to make; volumes get mounted at system startup time.  It reads in the data; from the AppleShare.Prep file and then loops through the server and; volume lists, mounting as it goes.;;======================================================================AutoLogon	procname export		import	OpenGS:OpenGSRec		import	ReadGS:ReadGSRec		import	CloseGS:CloseGSRec		import	SetMarkGS:SetMarkGSRec		import	serverInfo:ServerInfoRec		import	volInfo:VolumeInfoRec		import	FILogin:FILogin2Rec		import	FILogout:FILogoutRec		import	BuildPrepPath,BootConnectAs,subText		import	FindTheServer,CopyUserName,CopyPassword		import	GetStatus,hasAFP20,hasGuest,hasClearText,hasScrambled		import	TryLogin,selectedUAM,userName,volsMounted		import	StartTools,StopTools,CopyVolPassword,MountAVol		import	mountFlag,AskForVolPass,serverCount		import	AddSrvrPass,AddVolPass		import	messageHandle,myID,NewHandle				;; Get my Memory Manager user ID;		pha			; space for result		_MMStartup		pla		ora	#$0100		; use auxID of 1 for my memory		sta	myID;; Allocate handle for Message Center data;		lda	#8		; just enough for count word		jsr	NewHandle		bcs	@err		; don't bother trying		sty	messageHandle		stx	messageHandle+2;; Set up pointers to server and volume names;		lda	#<serverInfo.serverName		sta	subText		; point *0 to server name		lda	#^serverInfo.serverName		sta	subText+2		lda	#<volInfo.volName		sta	subText+8	; point *2 to volume name		lda	#^volInfo.volName		sta	subText+10				jsr	BuildPrepPath	; make the pathname to the file		lda	#1		; want read-only access		sta	OpenGS.reqAccess		_OpenGS	OpenGS		bcc	isopen				jsr	StopTools	; used only for _DisposeAll@err		rts			; error, so just exit		isopen		lda	OpenGS.refnum	; copy file's refnum		sta	ReadGS.refnum		sta	CloseGS.refnum		sta	SetMarkGS.refnum;; First, read count of servers;		lda	#<serverCount		sta	ReadGS.buffer		lda	#^serverCount		sta	ReadGS.buffer+2		lda	#2		; just a word		sta	ReadGS.reqCount		_ReadGS	ReadGS		bcs	ToCloseExit	; error, just close the file		lda	serverCount	; any servers in the list?		bne	ServerLoop	; yes, so loop through themToCloseExit	brl	CloseExit	; just close and exit now;; For each server in the list, read its info record;ServerLoop		stz	volsMounted	; no volumes mounted yet				lda	#<serverInfo		sta	ReadGS.buffer		lda	#^serverInfo		sta	ReadGS.buffer+2		lda	#ServerInfoRec.sizeof		sta	ReadGS.reqCount		_ReadGS	ReadGS		bcs	ToCloseExit;		lda	serverInfo.volCount;		beq	NextServer	; no volumes, so do next server;----------; Now log on to the file server.  If we get a bad name or password,; then we put up the "Connect as..." dialog.;----------		jsr	FindTheServer	; try to find the server		bcs	ToSkipVolumes	; not found, go to next server				jsr	GetStatus	; see what server supports		bcs	ToSkipVolumes	; no response, go to next server		lda	hasAFP20	; does it support AFP 2.0?		beq	ToSkipVolumes	; no, so next server		;; If saved to log on as guest, and server doesn't support guest,; then skip it.  Otherwise, set selectedUAM and go log on.;		jsr	CopyUserName	; set up userName variable		jsr	CopyPassword	; set up serverPassword variable				lda	userName		and	#$00FF		; get length of name		bne	@registered; Here, they want to log on as a guest		lda	hasGuest	; guest logins allowed?		beq	ToSkipVolumes	; no, so forget this server		stz	selectedUAM	; select NoUserAuthent		bra	@log		; go try the login@registered;; See which UAM is best to use.  If none, then skip this server;		lda	hasScrambled	; I prefer scrambled		beq	@clear		; no go, try cleartext		lda	#rScrambled		bra	@uam		; got the uam@clear		lda	hasClearText		beq	ToSkipVolumes	; don't bother trying guest		lda	#rClearText@uam		sta	selectedUAM		bit	serverInfo.serverFlags		bmi	@interact	; save name only, put up dialog@log		jsr	TryLogin	; go try and log in		bcc	LoggedOn	; no error, so mount the volumes		cmp	#FIUserNotAuth	; bad password?		beq	@interact		cmp	#FIParamErr	; bad user name?		bne	ToSkipVolumes@interact		jsr	StartTools	; tools: start your engines		bcs	ToSkipVolumes	; couldn't, try other servers		jsr	BootConnectAs	; try the "Connect as..." dialog		bcc	LoggedOn	; worked, mount volumesToSkipVolumes	brl	SkipVolumes	; no dice, try next server;; For each volume in the list, read its info record;LoggedOn		jsr	AddSrvrPass	; save the server's passwordVolumeLoop		lda	#<volInfo		sta	ReadGS.buffer		lda	#^volInfo		sta	ReadGS.buffer+2		lda	#VolumeInfoRec.sizeof		sta	ReadGS.reqCount		_ReadGS	ReadGS		bcs	CloseExit;; Here is where we mount the volume.  If it has a password, and one; wasn't saved, we should ask for it.;		jsr	CopyVolPassword				lda	#$0080		; set mount flag		bit	volInfo.volFlags		bvc	@notuser	; bit 14 = user volume		ora	#$0001		; set user volume bit@notuser		bit	volInfo.volFlags		bpl	@mount		; no volume password, just mount it		ora	#$0040		; set volume password bit		bit	serverInfo.serverFlags		bpl	@mount		; password saved, try to mount		sta	mountFlag	; save mountFlag for AskForVolPass@interact		jsr	StartTools		bcs	NextVolume		jsr	AskForVolPass		bcc	GotVolume		bcs	NextVolume@mount		sta	mountFlag	; save for AskForVolPass		ldx	#<volInfo.volName		ldy	#^volInfo.volName		jsr	MountAVol		bcc	GotVolume	; no error, volume was mounted		cmp	#FIAccessErr	; was it a bad password?		beq	@interact	; yes, so ask for right one		bne	NextVolume	; no, so couldn't mount this oneGotVolume		lda	mountFlag		and	#$0040		; was there a password?		beq	@nopass		; no, so don't save it		jsr	AddVolPass@nopass		inc	volsMounted	; the volume did get mountedNextVolume		dec	serverInfo.volCount		bne	VolumeLoop		lda	volsMounted	; were any volumes mounted		bne	NextServer	; yes, so do next server; No volumes mounted on this server, so log off		lda	FILogin.sessRefNum		sta	FILogout.sessRefNum		ATCall	FILogoutNextServer		dec	serverCount		beq	CloseExit		brl	ServerLoopCloseExit		jsr	StopTools		_CloseGS CloseGS				rtsSkipVolumes;; Here, we couldn't find the server, so skip forward to next server; by setting the mark past the records for this server's volumes.;		lda	#2		; mark := mark + displacement		sta	SetMarkGS.base		pha			; room for product		pha		lda	serverInfo.volCount	; number of volumes		pha		pea	VolumeInfoRec.sizeof	; times size of volume record		_Multiply		pla		sta	SetMarkGS.displacement		pla		sta	SetMarkGS.displacement+2		_SetMarkGS SetMarkGS		bra	NextServer		endp;======================================================================;;			BootButton;; This is a temporary function so I can call the autologon code from; the main CDEV window (and I won't have to reboot all the time).;;======================================================================BootButton	procname export		import	tStarted:data		import	StopTools,subText				lda	#1		sta	tStarted	; tools are already started				lda	StopTools		pha		lda	#$EA60		; put an RTS at StopTools		sta	StopTools				pha			; room for result		pha		_GetCtlParamPtr		; get old sub. array		PushLong #subText		_SetCtlParamPtr				jsr	AutoLogon				_SetCtlParamPtr				pla		sta	StopTools				stz	tStarted				rts;======================================================================;;			CopyUserName;; Copy the user's name from the ServerInfoRec to our global.;;======================================================================CopyUserName	procname		import	serverInfo:ServerInfoRec		import	userName		ldx	#30		; offset of last wordloop		lda	serverInfo.userName,x		sta	userName,x		dex		dex		bpl	loop				rts				endp;======================================================================;;			CopyPassword;; Copy the server password from the ServerInfoRec to our global.  Note; that we also set the length by finding the last non-null character.; If the Save My Name Only flag is set, set the password to empty.;;======================================================================CopyPassword	procname		import	serverInfo:ServerInfoRec		import	serverPassword,cryptKey		stz	serverPassword	; assume password length is zero		bit	serverInfo.serverFlags		bmi	exit		; name only => leave null password				sep	#$30		longa	off		longi	off				ldx	#1		; start with first characterloop		lda	serverInfo.srvrPassword-1,x		eor	cryptKey-1,x		sta	serverPassword,x		beq	null		stx	serverPassword	; save last non-null character offset	null		inx		cpx	#9		blt	loop				rep	#$30		longa	on		longi	onexit		rts				endp;======================================================================;;			CopyVolPassword;; Copy the volume password from the VolumeInfoRec to our global.  Note; that we also set the length by finding the last non-null character.; If the Save My Name Only flag is set, set the password to empty.;;======================================================================CopyVolPassword	procname		import	serverInfo:ServerInfoRec		import	volInfo:VolumeInfoRec		import	volPassword,cryptKey		stz	volPassword	; assume password length is zero		bit	serverInfo.serverFlags		bmi	exit		; name only => leave null password				sep	#$30		longa	off		longi	off				ldx	#1		; start with first characterloop		lda	volInfo.volPassword-1,x		eor	cryptKey-1,x		sta	volPassword,x		beq	null		stx	volPassword	; save last non-null character offset	null		inx		cpx	#9		blt	loop				rep	#$30		longa	on		longi	onexit		rts				endp;======================================================================;;			FindTheServer;; Given a ServerInfoRec, build up an NBP entity for use by LookupName; and then do a lookup to find the server.;;======================================================================FindTheServer	procname		import	serverInfo:ServerInfoRec		import	lookup:LookupNameRec		import	LookupType,LookupZone,entity		import	lbuf,serverAddress		sep	#$30		longa	off		longi	off		;; Copy server name;		ldx	#0		; offset to destinationloop1		lda	serverInfo.serverName,x		sta	entity,x		inx		cpx	serverInfo.serverName		blt	loop1		beq	loop1;; Copy type;		ldy	#0		; offset to sourceloop2		lda	LookupType,y		sta	entity,x		inx		iny		cpy	LookupType		blt	loop2		beq	loop2;; Copy zone;		ldy	#0loop3		lda	serverInfo.serverZone,y		sta	LookupZone,y	; copy for use by TryLogin (7-Jan-92 MSD)		sta	entity,x		inx		iny		cpy	serverInfo.serverZone		blt	loop3		beq	loop3				rep	#$30		longa	on		longi	onlookloop			ATCall	lookup		; try to find server's address		bcc	found		; found a match!		lda	lookup.result		cmp	#NBPBusy		beq	lookloop	; NBP was busy, keep trying		bra	exit		; return the errorfound		lda	lbuf		sta	serverAddress		lda	lbuf+2		sta	serverAddress+2		lda	#0		; no errorexit		cmp	#1		; set carry if non-zero result		rts				endptStarted	dc.w	0		; I haven't started them yetoldCtlParamPtr	dc.l	0		; saved text substitution pointer;; Note: Tool versions listed here are those present in 6.0;startStopRec	record		dc.w	0		; flags, always zero		dc.w	$0080		; use 640 mode		dc.w	0		; resource file ID saved here		dc.l	0		; zero page handle saved here		dc.w	(end-start)/4	; number of tool sets in tablestart		dc.w	$0003,$0302	; misc. tools		dc.w	$0004,$0307	; QuickDraw II		dc.w	$0006,$0301	; Event manager		dc.w	$000B,$0300	; int math		dc.w	$000E,$0303	; window manager		dc.w	$000F,$0303	; menu manager		dc.w	$0010,$0303	; control manager		dc.w	$0012,$0304	; QuickDraw II Aux		dc.w	$0014,$0303	; Line Edit		dc.w	$0016,$0301	; scrap manager		dc.w	$001C,$0303	; List Manager (for _CompareStrings)end		endr				;======================================================================;;			StartTools;; This routine starts up the tools used by the "Connect as..." and; volume password dialogs.  It can be called as many times as you want; since it checks a flag to see if it has started the tools yet.;;======================================================================StartTools	procname		import	tStarted,startStopRec,oldCtlParamPtr		import	subText				clc			; assume no error		lda	tStarted		bne	done				pha			; room for result		pha		pha			; room for Memory Manager ID		_MMStartup		; get memory manager ID		PushWord #refIsPointer+noResourceMgr		PushLong #startStopRec		_StartUpTools; Ignore result of StartUpTools.  Leave the four bytes on the stack; for GetCtlParamPtr to return its result.		_GetCtlParamPtr		; get old substitution array		pla		sta	oldCtlParamPtr		pla		sta	oldCtlParamPtr+2		PushLong #subText		_SetCtlParamPtr;; Hide the menu bar so we don't have to stare at an empty one;		_HideMenuBar;; Make the cursor an arrow instead of a watch.;		_InitCursor				inc	tStarted	; set started flagdone		rts				endp		;======================================================================;;			StopTools;; This routine is called to shutdown any tools I started up with; StartTools above.  It also checks tStarted so it can always be; called.;;======================================================================StopTools	procname		import	tStarted,startStopRec,oldCtlParamPtr,myID				PushWord myID		_DisposeAll		; make sure all memory is disposed of		lda	tStarted		beq	done		PushLong oldCtlParamPtr		_SetCtlParamPtr		; restore sub. array				PushWord #refIsPointer+leaveScreenClean+noResourceMgr		PushLong #startStopRec		_ShutDownTools				dec	tStarteddone		rts		endp						;----------------------------------------------------------------------;;			Private data areas;;----------------------------------------------------------------------lbufsize	equ	110		; more than enough for 1 entitylbuf		ds.b	lbufsizeentity		ds.b	99		; room for entity name to findlookup		record		dc.b	$00,$10		; sync LookupName		dc.w	0		; result		dc.l	0		; completion routine		dc.l	entity		; entity name		dc.b	1,12		; retry 12 times, every 1/4 second		dc.w	0		; reserved		dc.w	lbufsize	; buffer length		dc.l	lbuf		; buffer pointer		dc.b	1		; max of 1 match		dc.b	0		; actual matches		endr		end