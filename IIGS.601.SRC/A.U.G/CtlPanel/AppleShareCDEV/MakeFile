######################################################################## This MakeFile contains the build rules for the new and improved# Assembly AppleShare CDEV.### by Mark Day## Modification History:# 23-Jul-91	MSD	First try# 10-Sep-91	MSD	Added a new source file: AutoLogon.aii# 20-Sep-91	MSD	Added new shell variables to control listings#			and debugging code/symbols.###############################################################################################################################################	You can set the values of the following variables to#	control the generation of listings and whether symbols#	will be imbedded in the code.  You can either set a shell#	variable and export it, or define them on the command line.##  ASCDEVListFlag	"-l" to generate listings, empty otherwise#  ASCDEVSymFlag	1 to generate debugging symbols and code###############################################################################################################################################	The AppleShare file itself#######################################################################AppleShare		Ä	AppleShare.code AppleShare.r	RezIIGS AppleShare.r -o AppleShare -t "C7  " -c "pdos"########################################################################	The AppleShare code resource#######################################################################AppleShare.code		Ä	AppleShare.aii.obj AutoLogon.aii.obj globals.aii.obj DES.aii.obj	linkiigs -x -lseg:$1000 AppleShare ¶		AppleShare.aii.obj ¶		AutoLogon.aii.obj ¶		globals.aii.obj ¶		DES.aii.obj ¶		-o AppleShare.code ¶		{ASCDEVListFlag} > AppleShare.map########################################################################	The individual source/object files#######################################################################AppleShare.aii.obj	Ä	AppleShare.aii AppleShareEqu.aii	AsmIIGS -d DebugSymbols=0{ASCDEVSymFlag} {ASCDEVListFlag} AppleShare.aiiAutoLogon.aii.obj	Ä	AutoLogon.aii AppleShareEqu.aii	AsmIIGS -d DebugSymbols=0{ASCDEVSymFlag} {ASCDEVListFlag} AutoLogon.aiiglobals.aii.obj		Ä	globals.aii AppleShareEqu.aii	AsmIIGS -d DebugSymbols=0{ASCDEVSymFlag} {ASCDEVListFlag} globals.aiiDES.aii.obj		Ä	DES.aii	AsmIIGS -d DebugSymbols=0{ASCDEVSymFlag} {ASCDEVListFlag} DES.aii