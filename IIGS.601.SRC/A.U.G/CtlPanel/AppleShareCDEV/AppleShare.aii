;======================================================================;; AppleShare CDEV 2.0 -- The Real Thing;		by Mark Day;;; This Control Panel allows the user to log on to a file server and; mount volumes from the server.;; This version REQUIRES system 6.0 and AppleTalk Phase 2 drivers; because it uses new calls (such as 6.0's case-insensitive compare; and the GetZoneList2 call).;; Modification History:;; == Version 0.01 ==; 23-Jul-91	MSD	Written from scratch in assembly language!;; == Version 2.0d2 ==; 26-Aug-91	MSD	Fixed to use FILogin2 so that the server and;			zone names will be set correctly.  Fixed the;			main window and volume list so that a double-;			click in a list will make the OK button blink.;; == Version 2.0d3 ==; 27-Aug-91	MSD	Started removing all BRK instructions and make;			the code do something intelligent (like try;			to put up an error message).  Testing for;			AppleTalk and allocating memory now happen;			at RectCDEV time so I can use a smaller;			rectangle if there was an error.  CreateCDEV;			message added; it creates a different list;			of controls if there was an error.; 28-Aug-91	MSD	Removed RectCDEV and CreateCDEV messages.  Re-;			activated MachineCDEV and moved checking there.;			Added code to SelectVol to handle errors from;			mounting a volume.; == Version 2.0d4 ==; 06-Sep-91	MSD	Starting to add auto-logon functionality.; 14-Sep-91	MSD	It now successfully reads the AppleShare.Prep;			file, logs on to the servers, and mounts the;			volumes.  It puts up dialogs for passwords as;			needed (if it wasn't saved, or if the saved one;			was incorrect).; 15-Sep-91	MSD	Clicking on the "Quit" button from the volume;			list dialog no longer saves your password and;			will not update the AppleShare.Prep file.  BTW,;			the button title has been changed to "Cancel".;; == Version 2.0d5 ==; 20-Sep-91	MSD	Turned off debugging symbols by default.  Made;			AddVolPass and GetVolPass functional.; 26-Sep-91	MSD	¥ StartLookup now displays an error if it gets;			an NBP busy error.;			¥ Passwords in the message center are now;			stored scrambled (not plain text).;			¥ RunCDEV now checks to see if there are no;			zones.  If so, it checks again (in case they;			become available).;; == Version 2.0d7 ==; 16-Oct-91	MSD	¥ In CloseCDEV, the user name is written before;			disposing my memory (so if a dialog comes up, the;			list controls will continue to draw properly).;			¥ If you hit the zone control (including TAB),;			it only updates the server list if the zone;			actually changed.;			¥ The user name is written to the ATINIT file;			only if it has actually changed.;; == Version 2.0d10 ==;  8-Nov-91 MSD		¥ After volumes are mounted, call GetUserPath;			to force FIUserPrefix to be set.; 11-Nov-91 MSD		¥ Fix bug with no volumes returned.  It was;			returning an error when it should just display;			an empty list.;;======================================================================;; Begin 6.0.1;;  4-Mar-93 DAL		¥ For 6.0.1d14, adding AFP 2.1 support (we use;			AFP 2.1 instead of 2.0 if it's available).;; 25-Mar-93 DAL		¥ For 6.0.1d15, added range check on tracking;			checkboxes next to items in the volume list.;			If there were fewer than 4 volumes listed, we;			we tracking phantom checkboxes before.;			¥ Removed the "inc hasAFP21" with "if 0 then".;			Support is needed elsewhere in the system before;			we enable this, so it's turned off for 6.0.1.;;======================================================================		print	push,off				include 'E16.Types'		include 'E16.Resources'		include 'M16.Util'		include	'M16.MiscTool'		include 'E16.Memory'		include 'M16.Memory'		include 'M16.QuickDraw'		include 'E16.Window'		include 'M16.Window'		include	'E16.Control'		include 'M16.Control'		include	'E16.List'		include 'M16.List'		include	'M16.LineEdit'		include	'E16.Event'		include 'M16.Event'		include 'M16.IntMath'		include	'M16.Debug'		include 'E16.Locator'		include 'M16.Locator'		include	'M16.GSOS'				print	pop				include	'AppleShareEqu.aii';======================================================================;;			EnterCDEV;; This is the main entry point for the CDEV.  It receives the various; messages passed by the Control Panel itself.;; I will allocate a small stack frame for local variables and set up; the direct page register to get to them.  Each routine is called with; a JSR and the result will be pre-set to 0.  On return, the stack will; be cleaned up and control will return to the caller.;; On entry, the stack contains:;	Long	Result space;	Word	Message		(call number);	Long	Data1		(generally the cdev's grafport);	Long	Data2		(unused);	3 byte	Return address;;======================================================================;; This is what our direct page will look like to called routines;dp		record	1locals		ds.b	localSize	; just for nowsavedD		ds.w	1		; old D is pushed heresavedB		ds.b	1		; old B is pushed hereretCP		ds.b	3		; return address to Control Paneldata2		ds.l	1		; passed by CPdata1		ds.l	1		; passed by CPmessage		ds.w	1		; passed by CPresult		ds.l	1		; will pre-set to 0		endrEnterCDEV	procname		import	EventsCDEV,HitCDEV,InitCDEV,CloseCDEV,RunCDEV		import	MachineCDEV,BootCDEV,EditCDEV,RectCDEV,CreateCDEV				;; Save bank and direct registers;		phb			; save old bank just in case		phk		plb			; lets us use absolute addressing		phd			; save old direct page;; Make a stack frame with some room for local vars;		tsc		sec		sbc	#localSize	; size of locals		tcs			; push down stack		tcd			; point D to it, too;; Pre-set the result to 0;		stz	dp.result		stz	dp.result+2;; Call the appropriate message handler;		lda	dp.message		cmp	#MaxMessage+1	; beyond defined messages?		bge	bye		; yes, so just exit now				asl	a		; times 2 as index to jump table		tax				jsr	(calls,x)	; go to appropriate message handler;; Now I squeeze the locals and the input parameters out of the stack; by copying the saved direct and bank registers and the return address; up just under the result and then adjusting the stack pointer.  I'm; depending on the fact that I only need to copy 6 bytes (D, B, RTL); and that all I have to squeeze is the locals plus 10 bytes of input.;bye		lda	dp.savedD		sta	dp.result-6		lda	dp.savedD+2		sta	dp.result-4		lda	dp.savedD+4		sta	dp.result-2				tsc		clc		adc	#localSize+10	; squeeze input and locals out		tcs				pld		plb		rtl;; addresses of message handlers;calls		dc.w	@rts		;  0 = undefined		dc.w	MachineCDEV	;  1 = MachineCDEV		dc.w	BootCDEV	;  2 = BootCDEV		dc.w	@rts		;  3 = reserved for ShutDownCDEV		dc.w	InitCDEV	;  4 = InitCDEV		dc.w	CloseCDEV	;  5 = CloseCDEV		dc.w	EventsCDEV	;  6 = EventsCDEV		dc.w	@rts		;  7 = CreateCDEV		dc.w	@rts		;  8 = AboutCDEV		dc.w	@rts		;  9 = RectCDEV		dc.w	HitCDEV		; 10 = HitCDEV		dc.w	RunCDEV		; 11 = RunCDEV		dc.w	EditCDEV	; 12 = EditCDEV		@rts		rts				endp;======================================================================;;			BootCDEV;; This routine is called by the control panel during boot.  This gives; me a chance to mount volumes from the AppleShare.Prep file.;; If I want an X drawn through my icon, I have to set bit 0 of the; word pointed to by data1.;;======================================================================BootCDEV	procname		import	TestATalk,AutoLogon				jsr	TestATalk	; see if AppleTalk is active		lda	#0		rol	a		; A=1 if there was an error		sta	[dp.data1]	; tell CP to "X" me out or not		bne	exit		; if error, don't auto logon		jsr	AutoLogon	exit		rts				endp		;======================================================================;;			MachineCDEV;; This routine is called by the control panel to see whether the CDEV; should run under the current machine state.  I use it to check for; the presence of the AppleShare FST.;; Return non-zero to display, zero not to display.  Since result was; already set to zero before we got called, we have to set it to 1; if everything is OK.;;======================================================================MachineCDEV	procname		import	TestATalk,AllocMem,AlertByID				jsr	TestATalk		bcc	getmem				_InitCursor		lda	#rNoAppleTalk		jmp	AlertByID	; put up alert and exitgetmem		jsr	AllocMem		bcc	exit				_InitCursor		lda	#rOutOfMemory		jmp	AlertByIDexit		inc	dp.result	; everything is OK for running		rts				endp		;======================================================================;;			TestATalk;; This routine returns with carry clear if AppleTalk is active (i.e.,; the AppleShare FST is present) or carry set otherwise.;;======================================================================TestAtalk	procname		import	FSTInfo:GetFSTInfoRec				lda	#1		sta	FSTInfo.fstNum	; start scanning with 1loop		jsl	$E100A8		; GS/OS inline entry		dc.w	$202B		; GetFSTInfo		dc.l	FSTInfo		bcs	exit		; return carry set if error				inc	FSTInfo.fstNum	; prepare for next FST		lda	FSTInfo.fileSysID		cmp	#$D		; is it AppleShare?		bne	loop		; no, try others				clc			; AppleShare is activeexit		rts		endp		;======================================================================;;			EventsCDEV;; This routine is called by the Control Panel before calling TaskMaster; so that the CDEV can change the event record.;; The AppleShare CDEV uses this to detect double-clicks in the server; list, which it translates into a Return key press (which will cause; a hit on the OK button).;;======================================================================EventsCDEV	procname		import	TestDoubleClick		;; TestDoubleClick expects a pointer to the event record at offset; 1 and 4 bytes of workspace at offset 5 on direct page.  Luckily,; this is the start of our local variables.  So, just copy the; event pointer and call it.;event		equ	1		lda	dp.data1	; data1 was pointer to event		sta	event		lda	dp.data1+2		sta	event+2				jsr	TestDoubleClick				rts		endp		;======================================================================;;			HitCDEV;; This routine is called to tell the CDEV that there has been a hit; on a control.;; If there is a hit on the zone list, we cancel the old NBPLookup,; clear the server list, get the new zone name, start a Lookup in the; new zone.;; On Entry:;	Data1 = handle to control;	Data2 = control's ID;;======================================================================HitCDEV		procname		with	dp		import	myWindow,userName,wereHosed		import	dblClick,subText,Deref		import	NBPKill,StartLookup,lastZone		import	DoConnectAs,SelectVols		import	srvrListH,srvrMembers		import	HiliteByID,serverAddress		import	volsMounted,BlinkByID		import	FILogin:FILogin2Rec		import	FILogout:FILogoutRec		import	BootButton		import	prepHandle,ReadPrepFile,WritePrepFile		import	SetDefName				local		record	localsh		ds.l	1		; space for deref of handlesactiveOK	ds.w	1		; has OK button's active state		endr				lda	wereHosed	; any fatal errors?		bne	DoNothing	; if so, ignore all events				lda	data2		cmp	#12		; was it the server list?		beq	ServerHit		cmp	#13		; was it the OK button?		beq	OKHit		cmp	#15		; zone list?		beq	ZoneHitDoNothing		rts		ServerHit		pha			; result space		pea	0		; start at item zero		PushLong data1		; push the control handle		_NextMember2		; get first selected member if any				ldx	#$FF		; assume inactive for control		pla			; anything selected?		beq	@hilite		ldx	#0		; activate the control@hilite		stx	local.activeOK		lda	#ServerOKButton ; button's ID		jsr	HiliteByID				lda	dblClick	; was it a double-click?		beq	@exit		; no, so just leave		stz	dblClick	; don't let us see it for other lists		lda	local.activeOK	; is OK button highlighted?		beq	BlinkOK		; yes, so blink and hit OK button@exit		rts		;; The user has selected something in the zone list.  Stop the lookup in; the old zone and start one in the new zone.  Make the OK button inactive; since there are no zones selected.;ZoneHit		pha			; result space		pea	0		; start at item zero		PushLong data1		; control handle		_NextMember2		pla			; get currently selected zone		cmp	lastZone	; was it the same as last selected zone?		sta	lastZone	; update lastZone just in case it changed		beq	@nochange				ATCall	NBPKill				jsr	StartLookup@nochange		rts		BlinkOK		lda	#ServerOKButton		jsr	BlinkByID	; blink the OK button as feedbackOKHit		ATCall	NBPKill		; stop new lookups;; Read in the AppleShare.Prep file so I can update it if the user makes; any changes.;		jsr	ReadPrepFile;; Save old port and substitution array;		pha			; room for result		pha		_GetPort		pha			; room for result		pha		_GetCtlParamPtr		; get old substitution pointer				PushLong #subText		_SetCtlParamPtr		; set new substitutions;; For each server selected in the list...;@loop		pha			; room for result		PushLong srvrListH		_ResetMember2		; find next selected member		pla		beq	@done		; 0 means no more selected				dea			; adjust to 0 offset		pha			; push space		pha		pha			; push 0-based index		PushWord #5		; size of member record		_Multiply;; Deref member array handle and add (n-1)*5 to point to; nth item's member record.;		lda	srvrMembers	; deref member list handle		sta	local.h		lda	srvrMembers+2		sta	local.h+2		ldy	#2		pla			; get offset low word		clc		adc	[local.h]	; add low word of base		tax			; save low word		pla			; get offset high word		adc	[local.h],y	; add high word of base		sta	local.h+2		stx	local.h		; h points to nth member record;; Copy pointer to PString from member record to substitution array;		lda	[local.h]		sta	subText		lda	[local.h],y		sta	subText+2;; Get server's internet address from NBP Lookup buffer (it is 5; bytes before the server's name).;		sec		lda	subText		; get pointer to server name		sbc	#5		; back up to server's address		pha			; save low word		lda	subText+2		sbc	#0		tax			; put high word in X		pla			; get low word in A				jsr	Deref		; grab the 4 bytes				sta	serverAddress	; save net (first two bytes)		stx	serverAddress+2	; save node and socket;; Set up a default user name and password;		jsr	SetDefName		;; Do the "Connect As..." dialog and pick volumes;		jsr	DoConnectAs	; ask how they want to log on		bcs	@loop		; cancelled, so try next server		jsr	SelectVols	; select and mount volumes		lda	volsMounted	; were volumes already mounted?		bne	@loop		; yes, so don't log out@logout		lda	FILogin.sessRefNum		sta	FILogout.sessRefNum		ATCall	FILogout		brl	@loop		; try next one		@done		_SetCtlParamPtr		; restore old sub array		_SetPort		; restore old port;; Write out the new AppleShare.Prep file if it has changed.;		jsr	WritePrepFile		jsr	StartLookup	; go back to looking again				rts		endwith		endp								;======================================================================;;			Deref;; This routine takes a pointer in A,X (A low word, X high word); and returns the first four bytes at that address in A,X (A low).; Useful for dereferencing handles.;;======================================================================Deref		procname		phd			; save D		phy			; save Y				phx			; put pointer on stack		pha				tsc		tcd			; make stack frame				ldy	#2		lda	[1],y		; get high word		tax		lda	[1]		; get low word				ply			; remove pointer from stack		ply				ply			; restore Y		pld			; restore D		rts				endp		;======================================================================;;			NewPointer;; This is a simplified form of the NewHandle tool call.  It allocates; a locked, fixed handle with my ID and returns a pointer to it.;; On entry:;	A = size of memory block;; On exit:;	X = high word of pointer;	Y = low word of pointer;	A = error code (if any);	carry set on error;;======================================================================NewPointer	procname		import	myID		pha			; room for result		pha		pea	0		; high word of length		pha			; low word of length		PushWord myID		PushWord #attrLocked+attrFixed		pha			; location pointer is ignored		pha		_NewHandle		ply			; get handle		plx		bcs	err		; don't deref if error				tya			; put low word of handle in A		jsr	Deref		; deref the handle		tay			; put low word back in Y		clc			; no error		lda	#0err		rts		endp;======================================================================;;			NewHandle;; This is a simplified for of the _NewHandle tool call that allocates; a movable handle with my ID and returns the handle to it.;; On entry:;	A = size of memory block;; On exit:;	X = high word of handle;	Y = low word of handle;	A = error code (if any);	carry set on error;;======================================================================NewHandle	procname export		import	myID		pha			; room for result		pha		pea	0		; high word of size		pha			; low word of size		PushWord myID		PushWord #attrNoPurge		pha			; locationPtr is ignored		pha		_NewHandle		ply			; get low word of handle		plx			; get high word of handle		rts			; return with error if any				endp				;======================================================================;;			AllocMem;; This routine allocates all the handles I need for buffers and; arrays of member records.  It sets up and uses myID which is my; memory manager ID with the aux field set to 1.  If there is any; error, I dispose of evrything I allocated and return with the carry; set.;;======================================================================AllocMem	procname		import	myID,messageHandle		import	LookupName:LookupNameRec		import	GZL2:GetZoneList2Rec		import	GetSrvrParms:SPCommandRec		import	srvrMembers,zoneMembers,volMembers;; Get my Memory Manager user ID;		pha			; space for result		_MMStartup		pla		ora	#$0100		; use auxID of 1 for my memory		sta	myID;; Allocate room for the member records and lookup buffer for the; server list.;; First, the lookup buffer		lda	#SrvrBufSize		jsr	NewPointer		bcs	NoMem		sty	LookupName.bufPtr		stx	LookupName.bufPtr+2; Now, the member record array		lda	#SrvrMemSize		jsr	NewHandle		bcs	NoMem		sty	srvrMembers		stx	srvrMembers+2;; Allocate a buffer for GetZoneList to store the zone list;		lda	#ZoneBufSize		jsr	NewPointer		bcs	NoMem		sty	GZL2.bufferPtr		stx	GZL2.bufferPtr+2;; Allocate a buffer for zone list's member records;		lda	#ZoneMemSize		jsr	NewHandle		bcs	NoMem		sty	zoneMembers		stx	zoneMembers+2;; Volume list buffer;		lda	#VolBufSize		jsr	NewPointer		bcs	NoMem		sty	GetSrvrParms.replyBufPtr		stx	GetSrvrParms.replyBufPtr+2;; Volume list member records;		lda	#VolMemSize		jsr	NewHandle		bcs	NoMem		sty	volMembers		stx	volMembers+2;; Message center data;		lda	#8		; just enough for count word		jsr	NewHandle		bcs	NoMem		sty	messageHandle		stx	messageHandle+2		clc			; no errors		rts;; If I get here, I couldn't get the memory I need.  Free up anything; I did get and try to put up an alert.  ;NoMem		PushWord myID		_DisposeAll		sec			; got an error		rts		endp		;======================================================================;;			InitCDEV;; This routine is responsible for setting up the value of controls.;; At this point, it only intializes the zone list.  I will keep the; zone buffer as a locked handle for now so that I can use pointers; in the member records (rather than allocate a whole bunch of extra; handles and copying the zone list).;; On entry, data1 = window pointer;;======================================================================InitCDEV	procname		with	dp				import	myID,myWindow,wereHosed		import	srvrMembers,srvrListH		import	BuildZoneList,StartLookup,zoneListH		import	GetUserName,userNamelocal		record	dp.localsh		ds.l	1		; to deref handles		endr				lda	wereHosed		bne	Exit		; don't do init if error;; Save off my window pointer (for HitCDEV which doesn't get it);		lda	dp.data1		sta	myWindow		lda	dp.data1+2		sta	myWindow+2		;; Find the server list control;		pha			; space for result		pha		pushldp	dp.data1	; my window		PushLong #ServerList	; server list control's ID		_GetCtlHandleFromID		PullLong srvrListH;; Get and save handle to zone list control;		pha			; space for control handle		pha		pushldp	dp.data1	; search in our window		PushLong #ZoneList	; ID of zone list		_GetCtlHandleFromID	; find control handle		PullLong zoneListH	; pull handle to zone list;; Build the zone list;		jsr	BuildZoneList;; Start the lookups in my zone;		jsr	StartLookup;; Get and set the default value for the user name.;		jsr	GetUserName				PushLong myWindow		PushLong #UserLE		PushLong #userName		_SetLETextByIDExit		rts		endwith		endp		;======================================================================;;			CloseCDEV;; Stop any pending async lookups and release allocated memory.;;======================================================================CloseCDEV	procname		import	myID,wereHosed		import	NBPKill,WriteUserName				lda	wereHosed		bne	Exit		; fatal error, nothing to clean up				ATCall	NBPKill		; stop any async lookups				jsr	WriteUserName				PushWord myID		_DisposeAllExit		rts				endp;======================================================================;;			RunCDEV;; I use this to see if any new servers have shown up in the LookupName; buffer and add them to the displayed list.;;======================================================================RunCDEV		procname		import	LookupName:LookupNameRec		import	srvrListSize,wereHosed		import	srvrMembers,srvrListH		import	GZL2:GetZoneList2Rec,BuildZoneList		local		record	dp.localsh		ds.l	1		; used to deref handlesmemPtr		ds.l	1		; points into member arrayentPtr		ds.l	1		; points into entity name		endr		with	local				lda	wereHosed		bne	@exit;; If there were no zones, see if there are some now.;		lda	GZL2.zonesReturned	; any zones found?		bne	@zones		; yes, so leave 'em		jsr	BuildZoneList@zones;; See if any new servers have shown up in the buffer.;		lda	srvrListSize		cmp	LookupName.actMatch		bne	New@exit		brl	NoNewNew;----------; We have new servers.  Append them to the member array.  First,; skip over the first (srvrListSize) entity names in the buffer; and the same number of member records.;----------		pha			; save current size for loop count;; First, set up pointers to start of buffer and member array;		lda	LookupName.bufPtr		sta	entPtr		lda	LookupName.bufPtr+2		sta	entPtr+2				lda	srvrMembers	; deref member handle		ldx	srvrMembers+2		jsr	Deref		sta	memPtr		stx	memPtr+2		;; Now skip over the first (srvrListSize) items which are already in the list.; I have to use a loop like this for the lookup buffer because the entities; have variable lengths.;		plx			; get current list size		cpx	#0		; originally no items?		beq	append		; correct, don't update pointers@loop		lda	#4		; add 5 for net/node/socket/enumerator		jsr	bumpent		; note: bumpent adds an extra 1!		lda	[entPtr]		jsr	bumpent		; skip past object string		lda	[entPtr]		jsr	bumpent		; skip past type string		lda	[entPtr]		jsr	bumpent		; skip past zone string		dex		bne	@loop;; Skip over first (srvrListSize) items in the member array by simply; adding srvrListSize * (size of member record).;		pha			; room for product		pha		PushWord srvrListSize		PushWord #5		_Multiply				clc		pla			; low word of offset		adc	memPtr		sta	memPtr		pla			; high word of offset		adc	memPtr+2		sta	memPtr+2;; Now add the new items to the list;append		ldx	srvrListSize	; X will be loop index		lda	LookupName.actMatch		sta	srvrListSize	; update new list size		ldy	#0		; offset into member array@loop		lda	#4		; past net/node/socket/enum		jsr	bumpent				lda	entPtr		; copy pointer to object string		sta	[memPtr],y	; into member record		iny		iny		lda	entPtr+2	; high word of pointer		sta	[memPtr],y		iny			; point to memSelect - 1		lda	#0		; will clear high byte of pointer		sta	[memPtr],y	; and de-select the new member		iny		iny			; point to next member record				lda	[entPtr]		jsr	bumpent		; point past object string		lda	[entPtr]		jsr	bumpent		; point past type string		lda	[entPtr]		jsr	bumpent		; point past zone string				inx			; X = number of items now in list		cpx	srvrListSize	; is that all of 'em?		bne	@loop;; Rebuild and sort the list;		PushLong #0		; use default draw routine		lda	#$FFFF		; value for defaults		pha			; don't change list start		pha			; don't change list reference		pha		pha			; don't change listRefDesc		phx			; push new listSize		PushLong srvrListH	; do it to the server list control		_NewList2				PushLong #1		; use case-insensitive sort		PushLong srvrListH		_SortList2;; We're all done updating the list, so just return;NoNew		rts;; A local subroutine to add (low byte of A) + 1 to entPtr.  It is used; to bump the pointer past a pascal string or internet address.;bumpent		and	#$00FF		; make sure to add only a byte		sec		adc	entPtr		sta	entPtr		bcc	@nohi		inc	entPtr+2@nohi		rts				endwith			; local		endp		;======================================================================;;			EditCDEV;; This message passes edit codes the same as SystemEdit passes to; NDA's.  I use them to allow editing of the user name line edit.;; On entry:;	data1 = edit code (low word);			5 = Undo;			6 = Cut;			7 = Copy;			8 = Paste;			9 = Clear;	data2 = window pointer;;======================================================================EditCDEV	procname		import	wereHosed						lda	wereHosed		beq	doit				rts			; was error, ignore edit callsdoit;; Leave handle to the edit record on stack for the calls;		pha			; room for edit record handle		pha		pha			; room for control's handle		pha		pei	dp.data2+2	; push window		pei	dp.data2		PushLong #UserLE	; control ID		_GetCtlHandleFromID		_GetCtlTitle					; edit record handle is on the stack;; Dispatch to the appropriate handler;		lda	dp.data1	; get edit code		sec		sbc	#5		; get 0-based offset		asl	a		; get index into table		tax		jmp	(editcalls,x)		editcalls		dc.w	undo		dc.w	cut		dc.w	copy		dc.w	paste		dc.w	clearundo		pla			; remove edit record handle		pla		rts			; do nothing for Undocut		_LECut		_LEToScrap		rts		copy		_LECopy		_LEToScrap		rts		paste		_LEFromScrap		_LEPaste		rts		clear		_LEDelete		rts				endp				;======================================================================;;			BuildZoneList;; This routine builds the zone list by doing a GetZoneList2, selecting; my zone (as returned by GetMyZone), and sorting the list.  The list; control is updated with a NewList2 call.;;======================================================================BuildZoneList	procname		import	myID,lastZone		import	zoneMembers,zoneListH		import	GZL2:GetZoneList2Rec		import	GMZBuffer		import	GetMyZone:GetMyZoneRec		import	ATGetInfo:ATGetInfoRec		local		record	dp.localsh		ds.l	1		; for deref of handlememPtr		ds.l	1		; points into member arrayzonePtr		ds.l	1		; points into zone buffer		endr		stz	GZL2.zonesReturned	; assume no zones;; Test ARouter before trying to get zones;		ATCall	ATGetInfo		lda	ATGetInfo.aBridge		and	#$00FF		; it's just a byte		bne	Router		rts			; no router, so leave list emptyRouter;; Do a GetMyZone so I know which item in the list to select.;		ATCall	GetMyZone		bcc	@noerr@errexit	rts			; error, assume no zones@noerr;; Now do the GetZoneList2 call;		stz	GZL2.zipWork	; init work for whole list		stz	GZL2.zipWork+2		ATCall	GZL2		; make the call		bcs	@errexit	; didn't work, assume no zones;; Construct the array of member records to point to the zone; names in the zone buffer.  The member handle can remain unlocked; because I don't make any tool calls inside the loop.;		with	local				lda	GZL2.bufferPtr		sta	zonePtr	; point to start of zone list		lda	GZL2.bufferPtr+2		sta	zonePtr+2				lda	zoneMembers	; deref member array handle		ldx	zoneMembers+2		jsr	Deref		sta	memPtr		stx	memPtr+2				ldx	GZL2.zonesReturned		ldy	#0@loop		lda	zonePtr		sta	[memPtr],y	; copy low word of string pointer		iny		iny			; point to high word of pointer		lda	zonePtr+2		sta	[memPtr],y	; copy high word of string pointer		iny			; point to memFlag-1;; Here, we see if the zone matches GetMyZone.  If so, select this item.;		lda	#0		sta	[memPtr],y	; clear high byte of pointer and memFlag					; this defaults the item to not selected		phx			; toolbox will munge X,Y!		phy				pha			; space for result		PushWord #0		; flags (reserved)		PushLong #GMZBuffer	; my zone		pushldp	zonePtr		; the current zone		_CompareStrings		pla			; will be 0 if they equal		ply			; restore X,Y		plx		cmp	#0		; did strings match?		bne	@notmyzone	; no, so don't select		lda	#$8000		; set selected in memFlag		sta	[memPtr],y@notmyzone		iny		iny			; point past memFlag				lda	[zonePtr]	; get string length		and	#$00FF		; want just length byte		sec			; plus 1 for length byte		adc	zonePtr		; get addr of next string		sta	zonePtr		bcc	@nohigh		; branch if no bank cross		inc	zonePtr+2	; add carry to bank@nohigh		dex			; more zones?		bne	@loop				endwith			; local;; Create the new list with all of the new members;		PushLong #0		; no special member draw routine		PushWord #1		; start with first member (will change)		PushLong zoneMembers	; reference to member array		PushWord #refIsHandle	; it's a handle		PushWord GZL2.zonesReturned	; list size		PushLong zoneListH	; handle to list control		_NewList2;; Sort the list;		PushLong #1		; do case-insensitive sort		PushLong zoneListH		_SortList2;; Now, select my zone by finding the first (and only) selected; item and re-selecting it.;; find the first selected member		pha			; room for result		PushWord #0		; start at beginning of list		PushLong zoneListH	; push handle to control		_NextMember2		; find first selected; save currently selected zone		lda	1,s		sta	lastZone		; using that item number, select it		PushLong zoneListH		_SelectMember2		rts		endp;======================================================================;;			StartLookup;; Resets the server list to empty, then gets the zone from the zone; list (or "*") and begins the async LookupName.  Servers are actually; added to the list during RunCDEV messages.;;======================================================================StartLookup	procname		import	LookupName:LookupNameRec		import	myWindow,srvrListSize		import	zoneMembers,zoneListH,LookupZone		import	srvrListH,srvrMembers		import	HiliteByID,AlertByID		local		record	dp.localsh		ds.l	1		; used to deref handles		endr				stz	SrvrListSize	; server list will be empty;; Rebuild a new, empty, server list;		PushLong #0		; use default draw routine		PushWord #1		; first displayed item		PushLong srvrMembers	; reference to member array		PushWord #refIsHandle		PushWord #0		; zero items in list		PushLong srvrListH	; handle to list control		_NewList2;; Disable the OK button since no servers are selected;		ldx	#255		; disable control		lda	#ServerOKButton ; OK button's ID		jsr	HiliteByID		;; Copy the zone name from the zone list to the entity name used; by the lookup call (this makes us look in the selected zone).;		lda	#$2A01		; "*" as a two-byte string		sta	LookupZone	; use "*" as default zone name				pha			; room for member number		PushWord #0		; start at beginning of list		PushLong zoneListH	; look in zone list		_NextMember2		pla			; get item number		beq	NoZones		; no zones, just use "*"				dea			; make it 0-based		pha			; push room for product		pha		pha			; push item number - 1		PushWord #5		; push size of zone member		_Multiply		; now have offset to item				lda	zoneMembers	; deref handle to zone members		sta	local.h		lda	zoneMembers+2		sta	local.h+2		ldy	#2		clc		pla			; add offset to start of member array		adc	[local.h]	; to pointer to member array		tax		pla		adc	[local.h],y		stx	local.h		; put back in h to use as pointer		sta	local.h+2	; local.h points to nth member record				lda	[local.h]	; get pointer to member's string		tax		lda	[local.h],y		stx	local.h		sta	local.h+2	; now local.h points to zone's string				ldy	#32		; always copy 34 bytes of zone string@loop		lda	[local.h],y	; copy from zone list		sta	LookupZone,y	; and into lookup's entity		dey		dey		bpl	@loopNoZones;; Now, start the async LookupName;		ATCall	LookupName		lda	LookupName.result		cmp	#NBPBusy		bne	@done		_InitCursor		lda	#rNBPBusy		jsr	AlertByID@done		rts				endp;======================================================================;;			CtlHandleByID;; This is basically a simplified version of the GetCtlHandleFromID; toolbox call.  Put the low word of the control ID in A (the high word; is assumed to be zero) and the handle will be returned in A,X (with; the high word in A, low word in X).  The current port must be set; to the window containing the control.;;======================================================================CtlHandleByID	procname		pha		; room for handle (and save A)		pha		pha		; room for port		pha		_GetPort		lda	7,s	; recover control ID		PushWord #0	; high word of control ID		pha		; low word of control ID		_GetCtlHandleFromID		plx		; low word of control handle		pla		; high word of control handle		rts				endp		;======================================================================;;			HiliteByID;; Given a part code (in X) and a control ID (in A), this routine finds; the control and then calls HiliteControl.  It assumes the window; is the current GrafPort.  It also assumes that the upper word of; the control ID is zero.;;======================================================================HiliteByID	procname		phx			; push part code		jsr	CtlHandleByID		pha			; push control handle		phx		_HiliteControl		rts				endp		;======================================================================;;			HideByID;; Given a control ID in A, this routine will hide that control by; finding its handle and using HideControl.  It assumes that the high; word of the control ID is zero.;;======================================================================HideByID	procname		jsr	CtlHandleByID				pha			; push control handle		phx		_HideControl		rts				endp		;======================================================================;;			ShowByID;; Given a control ID in A, this routine will show that control by; finding its handle and using ShowControl.  It assumes that the upper; word of the control ID is zero.;;======================================================================ShowByID	procname		jsr	CtlHandleByID				pha			; push control handle		phx		_ShowControl		rts				endp		;======================================================================;;			SelectLEByID;; This routine takes the low word of a control ID of a line edit; control in A, makes it the target, and selects all of its text.; The high word of the control is assumed to be zero.;;======================================================================SelectLEById	procname		PushWord #0		; select from start of text		PushWord #256		; select to end of text		pha			; room for LineEdit record handle		pha		jsr	CtlHandleByID	; find the control				pha			; one copy for MakeThisCtlTarget		phx				pha			; one copy for GetCtlTitle		phx				_MakeThisCtlTarget	; make it the target control		_GetCtlTitle		; get LineEdit record handle		_LESetSelect		; select the text		rts		;======================================================================;;			SetCtlValByID;; A simplified _SetCtlValue.  The new value is passed in X and the; control ID is in A (low word, the high word is zero).;;======================================================================SetCtlValByID	procname		phx			; push new value		jsr	CtlHandleByID	; get control handle		pha			; push control handle		phx		_SetCtlValue		rts				endp		;======================================================================;;			BlinkByID;; This routine takes the low word of a control ID in A (the high word; must be zero) and hilites then unhilites the control.  It is used; to make the OK button "blink" in the main window and the volume list; dialog when the user double-clicks in a list.;;======================================================================BlinkById	procname		pha			; save control ID		ldx	#1		; hilite it		jsr	HiliteByID				pla			; get control ID back		ldx	#0		jmp	HiliteByID				endp		;======================================================================;;			RetryCommand;; Given a pointer to an AppleTalk parameter block in X and Y, this; routine will keep making the command until it gets an error other; than too many ASP commands.;;======================================================================RetryCommand	procname		phy			; save X,Y in case we have to		phx			; try the call againagain		jsl	$E11014		; try to dispatch the call		bcc	Exit		; no error, so return now		lda	1,s		; get X (low word)		tax		lda	3,s		; get Y (high word)		tay		phd			; create a stack frame so I can		tsc			; look at the parameter block		tcd		ldy	#2		; offset to result field		lda	[3],y		; get result from pb		pld			; clean up stack frame		cmp	#SPTooManyCalls		beq	againExit		ply			; clean up stack		plx		rts				endp		;======================================================================;;			SetupHadConn;; This routine is called to change the "Connect As..." dialog if the; user was already logged in.  It will show how they are logged in,; what their user name is, etc.  It also sets up selectedUAM to; either rScrambled (randnum exchange) or 0 (guest).  The userName; variable is set to their user name.;;======================================================================SetupHadConn	procname		import	SPCommand:SPCommandRec		import	FILogin:FILogin2Rec		import	cmdBuf,replyBuf,selectedUAM		import	connWindow,userName		import	HideNameAndPass,ShowNameAndPass		;; Put up "Already connected" instead of "Connect as";		lda	#rAlreadyConn		jsr	ShowByID;; Figure out what their user name is (empty string if they logged; on as a guest).;		lda	FILogin.sessRefNum		sta	SPCommand.sessRefNum				lda	#FPGetUserInfo		sta	cmdBuf		lda	#$100		; bitmap = user ID		sta	cmdBuf+6		lda	#8		; command length		sta	SPCommand.bufLen				ldx	#<SPCommand		ldy	#^SPCommand		jsr	RetryCommand				lda	#FPMapUserID		sta	cmdBuf		lda	replyBuf+2	; copy user ID		sta	cmdBuf+2		lda	replyBuf+4		sta	cmdBuf+4		lda	#6		; command length		sta	SPCommand.bufLen				ldx	#<SPCommand		ldy	#^SPCommand		jsr	RetryCommand		;; User name is now in replyBuf (empty string if Guest);		lda	replyBuf		and	#$FF		; get length byte		beq	Guest;; Here, they are logged on as a registered user so dim the Guest; button, hide the "(Scrambled)" string, fill in and deactivate; the user name, hide the password, set selectedUAM to rScrambled.;		lda	#rScrambled	; pretend logon by randnum exchange		sta	selectedUAM				ldx	#$FF		; dim guest button		lda	#rGuest		jsr	HiliteByID;; Copy user name from replyBuf to userName and show the user name; static text control.;		ldx	#30@loop		lda	replyBuf,x		sta	userName,x		dex		dex		bpl	@loop				lda	#rNameLE		jsr	HideByID		lda	#rPassStr		jsr	HideByID		lda	#rPassLE		jsr	HideByID		lda	#rNameStatText		jsr	ShowByID;; Now to do something kind of ugly.  I'm going to change the control ID; of the Registered User button so that my modal dialog code won't; react if the user clicks on it (this way I won't go showing the; password field, etc.).;		PushLong #$0000FFFF	; new control ID		lda	#rRegistered		jsr	CtlHandleByID	; get control handle		pha			; push control handle		phx		_SetCtlID				rts;; Here, they are logged on as a guest so select the guest button,; hide all the registered user stuff (dim the Registerd User button; itself), set selectedUAM to 0.;Guest		stz	selectedUAM				ldx	#1		lda	#rGuest		jsr	SetCtlValByID		ldx	#$FF		; dim registered user button		lda	#rRegistered		jsr	HiliteByID				jsr	HideNameAndPass	; do dimming/hiding for guest				rts				endp				;======================================================================;;			SetupNewConn;; This routine is called to change the "Connect As..." dialog if the; user is not yet logged in.  It checks the UAMs to determine what; options to give the user, etc.;;======================================================================SetupNewConn	procname		import	hasGuest,hasScrambled,hasClearText		import	selectedUAM,userName,serverPassword		import	connWindow,HideNameAndPass		;; Put up the "Connect as..." string;		lda	#rConnString		jsr	ShowByID;; See if the guest UAM is present.  If not, dim the Guest button.;		lda	hasGuest		bne	GuestOK		ldx	#$FF		; inactive control		lda	#rGuest	; dim the Guest radio button		jsr	HiliteByIDGuestOK;; See if it supports registered users (Randnum Exchange or Clear Text).; If it does, leave selectedUAM set to the most secure method.;		lda	#rScrambled	; assume Randnum Exchange		sta	selectedUAM		lda	hasScrambled		bne	GotRegistered	; Randnum exchange supported!				inc	selectedUAM	; change to Clear Text				lda	hasClearText		bne	GotRegistered; Neither ClearText nor Randnum Exchange supported, so dim out; Registered user button and hide user name and password fields.		stz	selectedUAM	; best we can do is guest		ldx	#$FF		; inactive control		lda	#rRegistered	; dim the Registered User button		jsr	HiliteByID		ldx	#1		; set Guest button to on		lda	#rGuest		; button's ID		jsr	SetCtlValByID		jsr	HideNameAndPass	; do other dimmming/hiding		bra	GotUAMGotRegistered		lda	selectedUAM		jsr	ShowByID	; show the registered user UAM;; Set the user name in the dialog.  This is set up by the caller of; DoConnectAs to be either the name from AppleShare.Prep or the name; from the main window.;		PushLong connWindow		PushLong #rNameLE		PushLong #userName		_SetLETextByID;; Set the default password from the serverPassword variable.;		PushLong connWindow		PushLong #rPassLE		PushLong #serverPassword		_SetLETextByID;; If the user name is the empty string, select it (make it the; target control).  Otherwise, select the password.;		ldx	#rPassLE	; assume select password		lda	userName	; get name length		and	#$00FF		; only want a byte		bne	@id		; non-zero, so use password field		ldx	#rNameLE	; empty name, select it@id		txa			; need control ID in A		jsr	SelectLEByID	; select the right line edit controlGotUAM		rts				endp				;======================================================================;;			DoConnectAs;; Given a file server, determine the UAM's it supports and ask how; the user wants to connect to it (i.e. as a Guest or a Registered; User).  If the user presses OK, we will actually log in (so that; we can display an error and as for the name/password again).;; On entry, SetCtlParamPtr must have been called, setting *0 to the; name of the file server.;; On exit, the selected UAM will be in the global selectedUAM (zero if; Guest was selected).  The carry flag will be set if the user cancelled.;; 13-Sep-91 MSD	If the global variable "interactive" is zero, then we;		will try to log on first.  If we get an error, we will;		put up the dialog.  On exit, interactive will be negative;		if we actually did put up the dialog.  Inputs are the;		same as for TryLogin.;;======================================================================DoConnectAs	procname		import	connWindow,userName		import	NewWindByID,selectedUAM,serverPassword		import	taskRecord:ExtTaskRec		import	FindString,AlertByID,serverAddress		import	hasGuest,hasClearText,hasScrambled,hasChgPwd		import	TryLogin,alreadyConn,hasAFP20,SetPassword		import	FILogin:FILogin2Rec		import	FILogout:FILogoutRec		import	ShowPFIErr,GetStatus		import	HideNameAndPass,ShowNameAndPass;; Go see which features/versions/UAMs the server supports;		jsr	GetStatus		bcc	@noerr				lda	#rNoResponse		jsr	AlertByID		sec			; pretend it was cancelled		rts			; return with A=0@noerr;; See if we're already connected to this file server by doing an; FILogin with a command buffer length of zero.  If we're connected,; the sessRefNum will be set and we'll get an error.;		stz	alreadyConn	; assume not connected yet				lda	serverAddress		sta	FILogin.srvrAddr		lda	serverAddress+2		sta	FILogin.srvrAddr+2				stz	FILogin.bufLen				ATCall	FILogin		bcc	NewLogin	; no error => not logged in		inc	alreadyConn	; yep, already connectedNewLogin		lda	hasAFP20		bne	@okVers; They don't support AFP 2.0 so put up an error message		lda	#rBadAFPVers		jsr	AlertByID		sec			; pretend cancel hit		rts			; return with A=0@okVers		lda	hasGuest		ora	hasClearText		ora	hasScrambled	; aything I support?		bne	@okUAM; They don't support any UAM I know about, so put up an alert		lda	#rBadUAM		jsr	AlertByID	; A = 0 because only one button		sec			; pretend cancel hit		rts			; A = 0 means cancelled@okUAM		export	BootConnectAsBootConnectAs	name;; Save the current port;		pha			; room for cancel flag		pha		pha		_GetPort;; Create the "Connect as..." window;		lda	#rConnDlg		jsr	NewWindByID		stx	connWindow		sta	connWindow+2		;; If the server doesn't support changing passwords, dim the button;		lda	hasChgPwd		bne	@SetPassOK		ldx	#$FF		; inactive control		lda	#rCSetPass	; dim the Set Password button		jsr	HiliteByID@SetPassOK;; Set up the dialog appropriately depending on whether they were already; logged on or not.;		lda	alreadyConn		bne	@HadConn		jsr	SetupNewConn	; set up for new connection		bra	@IsSetup@HadConn		jsr	SetupHadConn	; set up for existing connection@IsSetup;; Now, wait for the user to hit one of the buttons;@loop		pha			; room for result		pha		PushLong #taskRecord	; pointer to my extended task record		lda	#0		; value for defaults		pha			; use standard update routine		pha		pea	$8000		; Event hook = $80000000		pha			; to do Cmd-. => Esc translation		pha			; use default beep routine		pha		PushWord #mwIBeam	; DoModalWindow flags		_DoModalWindow		pla			; get control ID		plx			; ignore high word of ID		cmp	#0		; null event?		beq	@loop		; yes, keep going		cmp	#rDlg1Last+1	; beyond what I care about?		bge	@loop		; yes, so keep doing dialog		sec		sbc	#rDlg1First	; get 0 offset for IDs		asl	a		tax		jsr	(hitTable,x)	; do the right thing		bcc	@loop		;; Whatever it was, we're done.;		sta	5,s		; save cancel flag		PushLong connWindow		_CloseWindow		_SetPort		; restore old port		_InitCursor		; force arrow cursor (2-Apr-92 DAL)		pla			; get cancel flag back				lsr	a		; set carry if cancel		rtshitTable		dc.w	DoGuest		dc.w	DoRegistered		dc.w	DoCancel		dc.w	DoOK		dc.w	DoSetPass;; DoGuest -- Called when Guest button clicked.;DoGuest		jsr	HideNameAndPass		clc			; continue dialog		rts;; DoRegistered -- Called when Registered User button clicked.;DoRegistered		jsr	ShowNameAndPass		clc			; continue dialog		rts;; DoSetPass -- The Set Password button was clicked.  We end up; logging on, then doing an FPChangePassword call.  We will remain; logged on just as if they hit the OK button (as long as they; don't cancel from the set password dialog).;DoSetPass		jsr	SetPassword	; carry set if OK		rts;; The cancel button was hit.;DoCancel		lda	#1		sec		rts;; The OK button was hit.  Extract the selected UAM, user name,; and password.;DoOK		lda	alreadyConn	; already connected?		bnel	@exit		; yes, so just exit now				pha			; room for value		lda	#rGuest		jsr	CtlHandleByID		pha			; push control handle		phx		_GetCtlValue		pla		beq	@registered		stz	selectedUAM		stz	userName	; set userName to empty		bra	@guest		@registered;; They picked Registered User so copy out the user name and password.;		PushLong connWindow		PushLong #rNameLE		PushLong #userName		_GetLETextByID;; Fill password buffer with nulls, then get password.  This will; have the effect of leaving an 8 byte, null padded password at; serverPassword+1.;		ldx	#8@padloop		stz	serverPassword,x		dex		dex		bpl	@padloop		PushLong connWindow		PushLong #rPassLE		PushLong #serverPassword		_GetLETextByID@guest;; Now, try to log in;		jsr	TryLogin		bcc	@exit		pha			; save error code		jsr	ShowPFIErr	; put up a dialog explaining error		plx			; get error code back;; If error was unknown user or bad password, select the corresponding; line edit field and give user another chance to log on.;		lda	#1		; pretend cancel pressed		cpx	#FIUserNotAuth	; bad password?		beq	@password		cpx	#FIParamErr	; bad user name?		bne	@exit2		; no, other errors just exit;; Here, the user name was bad (or password expired in HHG).  Let them; re-enter the name and try again.;		lda	#rNameLE		jsr	SelectLEByID				clc			; not done yet		rts@password;; Here, the password was bad.  Let them re-enter it.;		lda	#rPassLE		jsr	SelectLEByID				clc			; not done yet		rts		@exit		lda	#0		; no cancel@exit2		sec			; done with dialog		rts				endp		;======================================================================;;			HideNameAndPass;; This routine hides the name, password, and UAM fields in the "Connect; as..." dialog.  It also makes the Set Password button inactive.; This routine is appropriate when the Guest radio button has been; selected (by the user or by the connect code).;;======================================================================HideNameAndPass	procname		import	selectedUAM				lda	#rNameStr		jsr	HideByID		lda	#rNameLE		jsr	HideByID				lda	#rPassStr		jsr	HideByID		lda	#rPassLE		jsr	HideByID				lda	selectedUAM	; this is control ID of		jsr	HideByID	; the UAM string		ldx	#$FF		; inactive control		lda	#rCSetPass	; dim the Set Password button		jsr	HiliteByID		rts				endp;======================================================================;;			HideNameAndPass;; This routine hides the name, password, and UAM fields in the "Connect; as..." dialog.  It also makes the Set Password button inactive.; This routine is appropriate when the Guest radio button has been; selected (by the user or by the connect code).;;======================================================================ShowNameAndPass	procname		import	selectedUAM,hasChgPwd				lda	#rNameStr		jsr	ShowByID		lda	#rNameLE		jsr	ShowByID				lda	#rPassStr		jsr	ShowByID		lda	#rPassLE		jsr	ShowByID				lda	selectedUAM	; this is control ID of		jsr	ShowByID	; the UAM string; Now check to see if I should enable the Set Password button based; on the the hasChgPwd flag.		lda	hasChgPwd	; did server support set password?		beq	noSetPass	; no, so leave dimmed		ldx	#0		; active control		lda	#rCSetPass	; activate the Set Password button		jsr	HiliteByIDnoSetPass		rts				endp;======================================================================;;			TryLogin;; This routine is called at boot time and from the Connect As dialog; to attempt to connect to a given file server.  This does not put; up any dialogs (so boot mount can put up Connect As and Connect As; can put up a dialog).;; On entry:;	serverAddress	4-byte internet address of file server;	selectedUAM	0 = Guest, or rClearText, rScrambled;	userName	set if UAM <> Guest;	serverPassword	set if UAM <> Guest;; On exit:;	A = error code (zero if no error);	carry set on error, clear otherwise;	session refnum in FILogin.sessRefNum (if no error);;======================================================================TryLogin	procname export		import	FILogin:FILogin2Rec		import	FILoginCont:FILoginContRec		import	serverAddress,selectedUAM		import	userName,serverPassword		import	cmdBuf,replyBuf,AFPVersion20,AFPVersion21,hasAFP21		import	GuestUAM,ClearTextUAM,ScrambledUAM		import	PutString,DES,subText		;; Set up server's address;		lda	serverAddress		sta	FILogin.srvrAddr		lda	serverAddress+2		sta	FILogin.srvrAddr+2;; Set up pointer to server's name (zone name is at a constant; location, so it is set up in globals.aii).;		lda	subText		; server name is "*0"		sta	FILogin.serverName		lda	subText+2		sta	FILogin.serverName+2;; Set up FPLogin command packet in cmdBuf;		lda	#FPLogin		sta	cmdBuf				ldx	#1		; offset for AFPVersion*** changed 4-Mar-93 DAL		lda	#$0200		;anticipate AFP2.0		sta	FILogin.afpVersion		PushLong #AFPVersion20	; string to add		lda	hasAFP21		beq	@no21		lda	#AFPVersion21		sta	1,s		lda	#$0201		sta	FILogin.afpVersion@no21*** end 4-Mar-93		jsr	PutString	; put PString in cmdBuf				ldy	selectedUAM		beq	Guest		cpy	#rClearText		beq	ClearText		bra	Randnum;; UAM is guest;Guest		PushLong #GuestUAM		jsr	PutString		bra	SendIt		;; UAM is Clear text;ClearText		PushLong #ClearTextUAM		jsr	PutString		PushLong #userName		jsr	PutString		txa			; if X is odd, put a pad byte		lsr	a		bcc	@nopad		stz	cmdBuf,x	; put pad byte in		inx@nopad		ldy	#0@loop		lda	serverPassword+1,y ; don't copy length byte!		sta	cmdBuf,x		inx		inx		iny		iny		cpy	#8		; copy 4 words of password		bne	@loop		bra	SendIt		;; UAM is Randnum exchange;Randnum		PushLong #ScrambledUAM		jsr	PutString		PushLong #userName		jsr	PutString;; The packet is built and the length is in X.  Now send it out.;SendIt		stx	FILogin.bufLen		ATCall	FILogin		lda	FILogin.result		cmp	#FILogContErr	; login continue?		bne	Exit;; Got a LoginContinue error so extract the random number, encrypt; it, and do an FILoginCont call.;Continue		ldx	#<DESParamBlock		ldy	#^DESParamBlock		jsl	DES				lda	#FPLoginCont		sta	cmdBuf		lda	replyBuf	; copy (transaction) ID		sta	cmdBuf+2		sep	#$20		longa	off		lda	FILogin.sessRefNum		sta	FILoginCont.sessRefNum		rep	#$20		longa	on				ATCall	FILoginCont		lda	FILoginCont.resultExit		cmp	#1		; set carry if A<>0		pha		pla			; set N,Z according to A		rtsDESParamBlock		dc.l	serverPassword+1		dc.l	replyBuf+2	; get straight from reply		dc.l	cmdBuf+4	; put in place for login continue		endp		;======================================================================;;			PutString;; Copies a Pascal string (address passed on the stack) into cmdBuf; at the offset given in the X register.  On exit, X is the offset; in cmdBuf of the byte after the last byte of the string.;;======================================================================PutString	procname		import	cmdBuf		dp		record	1savedD		ds.w	1rts		ds.w	1str		ds.b	3count		ds.b	1		; really high byte of str		endr		phd		tsc		tcd			; create a stack frame				sep	#$20		longa	off				ldy	#0		lda	[dp.str]	; get string length		ina			; plus 1 for length byte		sta	dp.countloop		lda	[dp.str],y		sta	cmdBuf,x		iny		inx		dec	dp.count		bne	loop				rep	#$20		longa	on				pld		pla			; get return address		sta	3,s		; overwrite pointer high word		pla			; pop string pointer low word		rts		endp		;======================================================================;;			HideVolButtons;; This routine hides the Save My Name and Save My Name and Password; buttons in the volume list dialog.;;======================================================================HideVolButtons	procname		lda	#idNameOnly		jsr	HideByID		lda	#idNameAndPass		jsr	HideByID		rts				endp		;======================================================================;;			ShowVolButtons;; This routine shows the Save My Name and Save My Name and Password; buttons in the volume list dialog.  It only shows the buttons; if you logged on as a registered user.;;======================================================================ShowVolButtons	procname		import	selectedUAM				lda	selectedUAM		beq	done				lda	#idNameOnly		jsr	ShowByID		lda	#idNameAndPass		jsr	ShowByIDdone		rts				endp		;======================================================================;;			SetupVolPath;; This routine sets up the volPath buffer to be a volume name turned; into a path by prepending a "/" to the front of the volume name.;; On entry:;	A =	high word of volume name pointer;	X = 	low word of volume name pointer;; On exit:;	volPath is set up;;======================================================================SetupVolPath	procname		import	volPath		dp		record	1volPtr		ds.l	1savedD		ds.w	1		endr;; Set up a local stack frame;		phd		pha			; high word of volume pointer		phx			; low word of volume pointer		tsc		tcd		sep	#$30		longa	off		longi	off		;; Do the string copy;		lda	[dp.volPtr]	; copy length byte		tay		ina			; add 1 for "/"		sta	volPathloop		lda	[dp.volPtr],y		sta	volPath+1,y	; +1 is room for "/"		dey		bne	loop		lda	#'/'		sta	volPath+1				rep	#$30		longa	on		longi	on;; Clean up stack and exit;		pla			; remove volPtr		pla		pld		rts		endp		;======================================================================;;			MountAVol;; This routine is called at boot time or from the volume list dialog; to attempt to mount a volume.  It doesn't put up any dialogs (the; boot mount code or SelectVols should do that).;; On entry:;	FILogin.sessRefNum	sessRefnum to use (set up by TryLogin);	A (low byte)		mount flags set up for FIMountVol;	X (low), Y (high)	pointer to volume name (no leading slash);	volPassword		(used if password bit set in flags); (Note: the high byte of A is ignored);; On exit:;	A = error code (zero if no error);	carry set on error, clear otherwise;;======================================================================MountAVol	procname export		import	FILogin:FILogin2Rec		import	FIMountVol:FIMountVolRec				stx	FIMountVol.volName		sty	FIMountVol.volName+2				sep	#$20		longa	off				sta	FIMountVol.flags				lda	FILogin.sessRefNum		sta	FIMountVol.sessRefNum				rep	#$20		longa	on				ATCall	FIMountVol				lda	FIMountVol.result		cmp	#1		; set carry if error		pha		pla			; set N,Z according to A				rts				endp		;======================================================================;;			BuildVolList;; This routine gets the list of volumes from a server and builds; up the member array.  It sets the memFlag field to tell me if; the volume should be dimmed (either because it is already mounted; or because I don't have enough access privileges) and whether; to check the box.  Volumes with passwords are assumed to have enough; access privileges to mount.;; The memFlag field is a word so it can contain these extra flags:;	bit 15	set if volume is checked (mount at boot time);	bit 14	set if volume has a password;	bit 13	set if volume is a user's volume;;======================================================================BuildVolList	procname		import	GetSrvrParms:SPCommandRec		import	FIMountVol:FIMountVolRec		import	FIAccess:FIAccessRec		import	FILogin:FILogin2Rec		import	volMembers,volPath,numVols		import	myID,checkCount,volsMounted		import	AlertByID				local		record	dp.localsh		ds.l	1bufPtr		ds.l	1		; point to GetSrvrParms buffermemPtr		ds.l	1		; points to member recordsnumVols		ds.w	1		; loop counterbufIndex	ds.w	1		; index into GetSrvrParms buffer		endr		stz	volsMounted	; assume no volumes already mounted		stz	numVols		; assume error from server		sep	#$20		longa	off		lda	FILogin.sessRefNum		sta	FIMountVol.sessRefNum		sta	GetSrvrParms.sessRefNum		rep	#$20		longa	on;; Deref handle to member records;		lda	volMembers		ldx	volMembers+2		jsr	Deref		sta	local.memPtr		stx	local.memPtr+2		;; Do an FPGetSrvrParms to get a list of all the volumes.;		lda	GetSrvrParms.replyBufPtr		sta	local.bufPtr	; make local copy		lda	GetSrvrParms.replyBufPtr+2		sta	local.bufPtr+2				ldx	#<GetSrvrParms		ldy	#^GetSrvrParms		jsr	RetryCommand		bcc	@noerr3		lda	#rNoResponse		bne	@alert		; always taken@noerr3		lda	GetSrvrParms.cmdResult+2		beq	@noerr4; got an error, probably ParamErr because user must change password		stz	numVols		; no volumes returned		lda	#rUnknownErr@alert		jsr	AlertByID			sec			; indicate an error@toExit		brl	Exit@noerr4		ldy	#4		; offset to number of volumes		lda	[local.bufPtr],y		and	#$00FF		; get just NumVols byte		sta	numVols		sta	local.numVols		clc			; assume no error		beq	@toExit		; no volumes????;----------; For each volume in the list, attempt to mount it and get access; information from it.  If I get an FIWasMounted error, dim the; volume.  If the volume has a password, don't try to get access.; Any volume successfully mounted in this way will get unmounted.;----------		iny			; point to first volume's flags		stz	checkCount	; nothing checked yetVolLoop		sty	local.bufIndex	; save index to reply;; Build a member record.  Set up pointer to volume name string; and default memFlag of selectable.;		ldy	#0		lda	local.bufIndex		sec			; add 1 to get past flags		adc	local.bufPtr		sta	[local.memPtr],y		sta	local.h		; make another copy locally		iny		iny		lda	local.bufPtr+2		adc	#0		sta	[local.memPtr],y		sta	local.h+2;; See if the given server and volume are stored in AppleShare.Prep.; If so, mark the server as checked.;		jsr	FindVolPrep	; see if volume is checked		pha			; save checked flag		ldy	local.bufIndex		lda	[local.bufPtr],y ; get volume flags		and	#$0081		; password and user bits only		lsr	a		; password to bit 6, user in carry		bcc	@nouser		ora	#$20		; set bit 5 for user volume@nouser		xba			; put flags in high byte		ora	1,s		; add volume checked flag		ply			; pull volume checked flag		bpl	@nocheck		inc	checkCount@nocheck		ldy	#4		; offset to memFlag		ora	#memSelected	; selected, not checked		sta	[local.memPtr],y;; Make a copy of the name with a slash in front of it so I can do; an FIAccess call.;		ldx	local.h		lda	local.h+2		jsr	SetupVolPath;; Now try mounting the volume to see if it's already mounted and so I; can do an FIAccess to see if I have enough privileges to use it.;		lda	#$0080		; mount, no password, no user volume		ldx	local.h		ldy	local.h+2		jsr	MountAVol	; try to mount it		bcs	MountErr	; error, so no FIAccess		ATCall	FIAccess		lda	FIAccess.rights		and	#$0083		; am I owner or have some access?		bne	Unmount		; yes, leave item selectable		ldy	#omemFlag		lda	[local.memPtr],y		and	#$FF00		; turn off selected bit		ora	#memDisabled+memNever	; can't select this one		sta	[local.memPtr],yUnmount		lda	#0		; just unmount		ldx	local.h		ldy	local.h+2		jsr	MountAVol		bra	NextVol		MountErr		lda	FIMountVol.result		cmp	#FIWasMounted	; was volume already mounted?		bne	NextVol		; other error, leave selectable		ldy	#omemFlag		lda	[local.memPtr],y		and	#$FF00		; turn off selected bit		ora	#memDisabled+memNever		sta	[local.memPtr],y		inc	volsMounted	; say that volumes were mountedNextVol		clc		lda	local.memPtr		adc	#6		; point to next member record		sta	local.memPtr		bcc	@nohi		inc	local.memPtr+2@nohi				inc	local.bufIndex	; point past flags		ldy	local.bufIndex		lda	[local.bufPtr],y		and	#$00FF		; get length byte only		sec			; plus 1 for length byte itself		adc	local.bufIndex		tay			; put back in Y		dec	local.numVols		bnel	VolLoop		clc			; no errorsExit		rtsFindVolPrep		import	prepHandle,LookupZone,subText; On entry, local.h points to volume name.  Server name pointer is at; subText.  Zone name is at LookupZone.  Return $0000 in A if not in list; or return $8000 in A if volume is in listvName		equ	1pPrep		equ	5sCount		equ	9vCount		equ	11		ldx	local.h		ldy	local.h+2		phd		tsc		sec		sbc	#12		tcs		tcd				stx	vName		sty	vName+2				lda	prepHandle		ora	prepHandle+2		beql	@exit		; no handle, return not found				lda	prepHandle+2		pha		lda	prepHandle		pha		_HLock				lda	prepHandle		ldx	prepHandle+2		jsr	Deref		sta	pPrep		stx	pPrep+2				lda	[pPrep]		; get server count		sta	sCount		beql	@unlock		; none, return not found		clc		lda	pPrep		adc	#2		; point past server count		sta	pPrep		lda	pPrep+2		adc	#0		sta	pPrep+2@sloop; See if server name matches		pha			; room for result		pea	0		; flags, reserved		PushLong subText		clc		lda	pPrep		adc	#<ServerInfoRec.serverName		tax		lda	pPrep+2		adc	#^ServerInfoRec.serverName		pha			; pointer to server name in prep data		phx		_CompareStrings		pla		bne	@snext; compare zone names		pha			; room for result		pea	0		; flags, reserved		PushLong #LookupZone		clc		lda	pPrep		adc	#<ServerInfoRec.serverZone		tax		lda	pPrep+2		adc	#^ServerInfoRec.serverZone		pha			; point to zone in prep data		phx		_CompareStrings		pla		beq	@vfind@snext; Compute size of ServerInfoRec and associated VolumeInfoRec's.  Then; add this to pPrep to point to the next ServerInfoRec.		pha			; room for product		pha		ldy	#ServerInfoRec.volCount		lda	[pPrep],y	; get volume count		pha		pea	VolumeInfoRec.sizeof		_Multiply		clc		pla		adc	#ServerInfoRec.sizeof		plx			; remove high word of product		clc		adc	pPrep		sta	pPrep		lda	pPrep+2		adc	#0		sta	pPrep+2		dec	sCount		bne	@sloop		bra	@notfound@vfind; Here, server and zone match.  Now try to match the volume.		ldy	#ServerInfoRec.volCount		lda	[pPrep],y		sta	vCount		beq	@notfound				clc		lda	pPrep		adc	#<ServerInfoRec.sizeof		sta	pPrep		lda	pPrep+2		adc	#^ServerInfoRec.sizeof		sta	pPrep+2@vloop; compare volume name		pha		pea	0		pei	vName+2		pei	vName		clc		lda	pPrep		adc	#<VolumeInfoRec.volName		tax		lda	pPrep+2		adc	#^VolumeInfoRec.volName		pha		phx		_CompareStrings		pla		beq	@found				clc		lda	pPrep		adc	#<VolumeInfoRec.sizeof		sta	pPrep		lda	pPrep+2		adc	#^VolumeInfoRec.sizeof		sta	pPrep+2		dec	vCount		bne	@vloop@notfound		lda	#0		; return not found		beq	@unlock@found		lda	#$8000		; return found@unlock		pha			; save found flag		lda	prepHandle+2		pha		lda	prepHandle		pha		_HUnlock				pla			; recover found flag@exit		tax			; save in X		tsc		clc		adc	#12		tcs		pld		txa			; put flag in A		rts				endp		;======================================================================;;			SelectVols;; Allow the user to select and mount volumes from server.  If the user; made any changes that need to be saved to the AppleShare.Prep file,; we delete that server's information (if any) from the file.  Then; we open the file, set the mark to the end (to append) and write a; ServerInfoRec.  In the volume loop, if the volume was checked we; write out a VolumeInfoRec.  After the volume loop, we close the file.;;======================================================================SelectVols	procname		import	volListH,CheckListDraw,checkCount		import	windOrigin,volWindow,numVols		import	taskRecord:ExtTaskRec		import	VolListHook,checkRect,checkBoxTempl		import	dblClick,AskForVolPass,NewWindByID		import	volMembers,subText,volsMounted		import	mountFlag,ShowPFIErr,AddSrvrPass,AddVolPass		import	prepChange,DelSrvrPrep,WriteSrvrInfo,WriteVolInfo		import	serverInfo:ServerInfoRec		import	volInfo:VolumeInfoRec		import	GetSrvrPass,GetVolPass,saveNameOnly				local		record	dp.localsvCounth		ds.l	1p		ds.l	1activeOK	ds.w	1		endr		stz	prepChange	; no changes needed yet;; Save old port;		pha		pha		_GetPort;; Create the volume list window;		lda	#rVolDlg		jsr	NewWindByID		stx	volWindow		sta	volWindow+2;; If the user saved name and password, make sure that radio button; is selected.;		bit	saveNameOnly		bmi	NameOnly		ldx	#1		lda	#idNameAndPass		jsr	SetCtlValByID		; turn on name and passwordNameOnly;; Get the handle to the volume list;		lda	#idVolList		jsr	CtlHandleByID		stx	volListH		sta	volListH+2;; Compute the rectangle where the check boxes live;		stx	local.h		; deref handle to volume list control		sta	local.h+2		ldy	#2		lda	[local.h],y		tax		lda	[local.h]		sta	local.h		stx	local.h+2				ldy	#octlRect+ov1		lda	[local.h],y	; get top of control		sta	checkRect+ov1	; save as top of rect		ldy	#octlRect+ov2		lda	[local.h],y	; get bottom		sta	checkRect+ov2		iny		iny			; Y = octlRect+oh2		lda	[local.h],y	; get right		sta	checkRect+oh2	; save as right		sec		sbc	#checkWidth+1	; left is based on right edge		sta	checkRect+oh1		;; Fix up the left and right edges in check box template;		clc		adc	#4		sta	checkBoxTempl+8 ; fix up left		clc		adc	#25		; width of check box itself		sta	checkBoxTempl+12 ; fix up right		;; Build the volume list member records;		jsr	BuildVolList		bcsl	ExitVols	; close window if error;; Update the contents of the list;				PushLong #CheckListDraw		PushWord #1		; listStart		PushLong volMembers	; listRef		PushWord #refIsHandle		PushWord numVols	; listSize		PushLong volListH		_NewList2;; Sort the list;		PushLong #1		; case-insensitive compare proc		PushLong volListH		_SortList2;; To make life easier, all enabled items were marked as selected.; This way, I can find the first selected item and select it.  I; end up with the first enabled item being selected.;		pha			; room for result		PushWord #0		; start from beginning of list		PushLong volListH		_NextMember2		pla			; get first selected, if any		beq	NoneSelected				pha			; select that member		PushLong volListH		_SelectMember2;		; Make the OK button active since something is selected;		ldx	#0		; make active		lda	#idVOK		; control ID		jsr	HiliteByIDNoneSelected;; Make the buttons visible if at least one box checked;		lda	checkCount	; are any checked?		beq	NoneChecked		jsr	ShowVolButtonsNoneChecked;; Now, wait for the user to hit one of the buttons;@loop		pha			; room for result		pha		PushLong #taskRecord	; pointer to my extended task record		lda	#0		; value for defaults		pha			; use standard update routine		pha		PushLong #VolListHook	; use custom event hook for checkboxes		pha			; use default beep routine		pha		PushWord #mwIBeam	; DoModalWindow flags		_DoModalWindow		pla			; get control ID		plx			; ignore high word of ID		cmp	#idVolMax+1	; beyond what I care about?		bge	@loop		; yes, so keep doing dialog		asl	a		tax		jsr	(hitTable,x)	; do the right thing		bcc	@loop		;; Whatever it was, we're done;ExitVols		PushLong volWindow		_CloseWindow		_SetPort				rtshitTable		dc.w	IgnoreEvent		dc.w	DoList		; in the volume list		dc.w	DoNameOnly		dc.w	DoNamePass		dc.w	DoQuit		dc.w	DoOKIgnoreEvent		lda	prepChange		beq	@nochange				ldx	#0		; make OK button active		lda	#idVOK		jsr	HiliteByID@nochange		clc			; null event, keep going		rtsDoList;; If nothing in the list is selected, disable the OK button; and don't bother looking for a double click.;; Leave OK enabled if the check boxes were changed;		pha			; room for result		pea	0		; start at item 0		pushlong volListH	; handle to list control		_NextMember2				ldx	#$FF		; assume inactive for button		pla			; see if anything selected		ora	prepChange	; or checkboxes changed		beq	@hilite		; nothing, so make inactive		ldx	#0		; something selected, make active@hilite		stx	local.activeOK	; remember button state		lda	#idVOK		; control ID		jsr	HiliteByID				lda	dblClick	; was it a double-click?		beq	@exit		; no, so return		stz	dblClick	; don't let us see it for other lists		lda	local.activeOK	; is OK button enabled?		beq	BlinkOK		; yes, so blink and hit OK button@exit		clc			; keep going		rts		DoNameOnlyDoNamePass		lda	#1		sta	prepChange	; AppleShare.Prep needs to be updated				clc			; keep going		rtsDoQuit		sec			; stop the dialog		rtsBlinkOK		lda	#idVOK		jsr	BlinkByID		DoOK;; Save the server password in the Message Center in case they want to; save volumes to mount at boot time (they might log on later and the; only way I can get the password to save is from the Message Center).; Only save it if we're logging on for the first time (volsMounted=0); since otherwise we don't know the password;		lda	volsMounted		bne	@loop		; was already connected		jsr	AddSrvrPass;; For each volume selected in the list, go and mount it.;@loop		pha			; room for result		PushLong volListH		_ResetMember2		; find next selected member		pla		beql	@done;; Make a pointer to the item's member record;		dea			; adjust to 0 offset		pha			; push space		pha		pha			; puhs 0-based index		PushWord #6		; size of member record		_Multiply		lda	volMembers		sta	local.h		lda	volMembers+2		sta	local.h+2		ldy	#2		pla			; get offset low word		clc		adc	[local.h]		tax		pla			; get offset high word		adc	[local.h],y		sta	local.h+2	; h points to nth member record		stx	local.h;; Set up volPath so we'll be ready to mount the volume.  While we've; got a pointer to the volume name, set it up as *2 for dialogs.;		lda	[local.h]	; get pointer to volume name		tax		lda	[local.h],y		stx	subText+8	; substitute for *2		sta	subText+10		jsr	SetupVolPath	; build the path;; Figure out what the mount flags should be;		ldy	#4		lda	[local.h],y	; get my memFlags		xba			; put in low byte		bit	#$0020		; see if user volume set		php			; save user volume flag		and	#$0040		; keep password bit only		plp		beq	@nouser		ora	#$0001		; set user volume bit@nouser		ora	#$0080		; set mount bit;; If the volume has a password, ask for it.  Otherwise, just mount it.;		sta	mountFlag		and	#$0040		; volume password bit set?		beq	@noPass		; no, so just mount the volume@askPass				jsr	AskForVolPass	; got to get a password to mount it		bcs	@loop		; Cancel?  Try next volume.		jsr	AddVolPass	; save password in message center		bra	@success@noPass		lda	mountFlag		ldx	subText+8	; get pointer to volume name		ldy	subText+10		jsr	MountAVol		bcc	@success;; Handle a volume mount error.  Put up an alert and continue mounting; volumes if possible.;		pha		jsr	ShowPFIErr	; put up an alert		pla		cmp	#FITooManyVols	; was it too many volumes?		beq	@done		; yes, so don't try any more		brl	@loop		; no, so try other volumes@success		inc	volsMounted	; one more volume is mounted		brl	@loop		; mount more volumes@done;; If we need to update the AppleShare.Prep data, do it now by scanning; the whole volume list again.;		lda	prepChange	; any changes made?		beq	@nodel		jsr	DelSrvrPrep	; delete this server from file		lda	checkCount	; any volumes to save?		beq	@nodel		; no, so skip it		pha			; room for control value		lda	#idNameOnly		jsr	CtlHandleByID		pha		phx		_GetCtlValue		; see if Save My Name Only set		pla		lsr	a		; put flag in carry		ror	a		; put it in bit 15		sta	serverInfo.serverFlags	; save Save My Name Only flag		jsr	GetSrvrPass	; get password from Message Center		jsr	WriteSrvrInfo	; write this server's record; Scan through member records looking for checked volumes		lda	volMembers+2		pha		lda	volMembers		pha		_HLock			; need it locked!		lda	volMembers		ldx	volMembers+2		jsr	Deref		sta	local.p		stx	local.p+2	; save member pointer		lda	numVols		sta	local.vCount	; save volume count@vloop		ldy	#2		lda	[local.p]	; get pointer to name		sta	subText+8	; save as *2		lda	[local.p],y		sta	subText+10		iny		iny			; Y = 4		lda	[local.p],y	; checked flag in bit 15		bpl	@vnext		; not checked		and	#$7F00		; get rid of other flags		asl	a		; password flag now in bit 15		sta	volInfo.volFlags ; save password and user volume bits		bpl	@novpass		jsr	GetVolPass	; get password from Message Center@novpass		jsr	WriteVolInfo	; append to AppleShare.Prep data@vnext		clc		lda	local.p		adc	#6		; size of a member record		sta	local.p		lda	local.p+2		adc	#0		sta	local.p+2		dec	local.vCount		bne	@vloop@nodel; Added 8-Nov-91 MSD		jsl	$E100A8		; call GS/OS		dc.w	$2033		; FST specific		dc.l	GetUserPath; End 8-Nov-91 MSD		sec			; exit dialog		rts; Added 8-Nov-91 MSDGetUserPath		dc.w	3		; pcount		dc.w	$D		; AppleShare FST ID		dc.w	8		; Get_User_Path		dc.l	0		; prefix pointer returned here; End 8-Nov-91 MSD		endp		;======================================================================;;			CheckListDraw;; This is my custom draw routine for the volume list.  The basic method; is the following:;   1.	Move the right edge of the rectangle left by 35 pixels to make;	room for the check box.;   2.	Set the clip region to this smaller rectangle.;   3.	Use StringWidth to see if string will fit.  If not, do a;	SetCharExtra(-1.0) to squeeze the string.;   4.	Restore the clip region.;   5.	Move to near right edge and draw one of the chars from the Control;	Manager's font (empty checkbox or checked checkbox).;;======================================================================CheckListDraw	procname		import	norMask,dimMask		dp		record	1savedD		ds.w	1retaddr		ds.b	3	; return addresslistHandle	ds.l	1memRecPtr	ds.l	1rectPtr		ds.l	1		endrinputSize	equ	12	; number of bytes of input to squeeze		with	dp;; Create a stack frame;		phd		tsc		tcd		;; Save old clip region and charExtra;		pha		; room for region handle		pha		_NewRgn		lda	3,s	; make a copy of region handle		pha		; on the stack		lda	3,s		pha		_GetClip	; save old clip region		pha		; room for saved charExtra		pha		_GetCharExtra		;; Shrink the rectangle and clip to it;		ldy	#oh2		; right side of rect		lda	[rectPtr],y		sec		sbc	#checkWidth		sta	[rectPtr],y				pei	rectPtr+2		pei	rectPtr		_ClipRect		;; Draw the member (do disabled, selected, or too wide items);		pei	rectPtr+2		pei	rectPtr		_EraseRect				ldy	#oh1		lda	[rectPtr],y		clc		adc	#textOffset		pha		ldy	#ov2		lda	[rectPtr],y		sec		sbc	#2		pha		_MoveTo			; MoveTo(rect.h1+10,rect.v2-2); If room in rectangle < StringWidth, crunch text		pha			; room for string width		ldy	#2		lda	[memRecPtr],y	; get pointer to member string		pha		lda	[memRecPtr]		pha		_StringWidth				ldy	#oh2		lda	[rectPtr],y		ldy	#oh1		sec		sbc	[rectPtr],y	; width of rectangle (not including check box)		sec		sbc	#textOffset	; now have width of text part		cmp	1,s		; compare to string width		bge	NoScrunch	; text is narrow enough, so draw it		PushLong #$FFFF0000	; -1.0 (as a fixed point number)		_SetCharExtraNoScrunch		pla			; remove string width from stack		; Finally, draw the string		ldy	#2		lda	[memRecPtr],y	; get pointer to member string		pha		lda	[memRecPtr]		pha		_DrawString; If it is selected, invert the text rectangle				ldy	#omemFlag		lda	[memRecPtr],y		and	#memSelected+memDisabled		cmp	#memSelected	; must be selected but not disabled		bne	NotSelected		pei	rectPtr+2		pei	rectPtr		_InvertRectNotSelected; If it is disabled (selected or not), dim it out		ldy	#omemFlag		lda	[memRecPtr],y		and	#memDisabled		beq	NotDisabled; Dim by erasing a checkerboard pattern		PushLong #dimMask		_SetPenMask		pei	rectPtr+2		pei	rectPtr		_EraseRect		PushLong #norMask		_SetPenMaskNotDisabled;; Restore charExtra, clip region, and fix the rectangle;		ldy	#oh2		lda	[rectPtr],y		clc		adc	#checkWidth		sta	[rectPtr],y				_SetCharExtra				lda	3,s		; make a copy of region handle		pha		lda	3,s		pha		_SetClip		_DisposeRgn		;; Draw the appropriate form of the checkbox;		ldy	#oh2		lda	[rectPtr],y		sec		sbc	#checkWidth-checkOffset		pha			; push horizontal		ldy	#ov1		lda	[rectPtr],y		ina			; draw it down a pixel		pha		_MoveTo				pha			; room for current font		pha		_GetFont		pha		pha			; room for Control Manager's font		PushLong #$FFFFFFFF	; return old font		_SetCtlIcons		_SetFont		; change to Control Manager's font				ldx	#0		; assume unchecked character		ldy	#4		; offset to memFlag and checked flag		lda	[memRecPtr],y	; checked flag in high bit		bpl	NotChecked		inx		inx			; 2 = checked boxNotChecked				; X=0 => unchecked, 2 = checked		phx		_DrawChar				_SetFont		; restore old font;; Fix up the stack and return;		lda	retaddr		sta	retaddr+inputSize		lda	retaddr+1		sta	retaddr+1+inputSize				pld				tsc		clc		adc	#inputSize		tcs				rtl				endwith			; dp		endp				;======================================================================;;			VolListHook;; This routine intercepts events to the volume list window.  Its; biggest goal in life is to detect when the user is clicking in one of; the checkboxes in the list, track it, change its value in the member; record, and return a null event.;; I will swallow the mousedown event if it was within checkRect (a; rectangle covering the right side of the list where the check boxes; are all placed).  If it was actually within one of the check boxes,; I create a check box control over the member, track it, and update; the member's record.;; Checking the horizontal position of the point is pretty easy (just; a certain range from the right edge).  Testing the vertical position; is a little harder.  I find the vertical offset of the point from; the top of the list; the offset MOD the member height tells me how; far down in the member's rectangle it was (now it becomes a simple; range test); the offset DIV the member height tells me which member; was hit, relative to the top one displayed.;; 26-Aug-91 MSD	Added translation from Command-period to Esc.;;======================================================================VolListHook	procname		import	whichWindow,whichControl,whichPt		import	volWindow,volListH,volMembers		import	vOffset,itemNum,checkBoxTempl		import	checkBoxH,checkRect,checkCount		import	TestDoubleClick,prepChange				dp		record	1vOffset		ds.w	1		; offset from top of listitemNum		ds.w	1		; 0-based item number hitmemPtr		ds.l	1		; points to list control recordsavedD		ds.w	1savedB		ds.b	1rtl		ds.b	3event		ds.l	1		; pointer to task recordparmSize	equ	*-rtl		endr;; Set up stack frame;		phb		phk		plb			; set bank to my data		phd				pha			; make room for locals		pha		pha		pha				tsc		tcd			; point to stack frame		;; See if the event type is something I want;		lda	[dp.event]	; get event.what		cmp	#keyDownEvt		bne	TryMouse;; If key was command-period, change to ESC.;		ldy	#omodifiers		lda	[dp.event],y		and	#appleKey+shiftKey+optionKey+controlKey		cmp	#appleKey	; command key down?		bne	@exit		; no, don't translate				ldy	#omessage		lda	[dp.event],y		and	#$00FF		; get key byte only		cmp	#'.'		; period down?		bne	@exit		; no, don't do it; Was command-period.  Change to Esc.		ldy	#omodifiers		lda	[dp.event],y		and	#ÅappleKey	; turn off Apple key bit		sta	[dp.event],y				ldy	#omessage		lda	#$1B		; ESC		sta	[dp.event],y@exit		brl	exitTryMouse		cmp	#mouseDownEvt		bne	neExit		; pass through other events;; Check for double click.;; TestDoubleClick wants a pointer to the event record at offset 1 on; direct page and 4 bytes of workspace at offset 5.  This just happens; to fit in our locals, so copy the event pointer and call it.;		lda	dp.event		sta	1		lda	dp.event+2		sta	3		jsr	TestDoubleClick		;; Where did the event happen?;		pha			; room for result		PushLong #whichWindow	; where to store window pointer		ldy	#owhere+2	; offset to where.x		lda	[dp.event],y		sta	whichPt+2	; save point, just in case		pha		dey		dey			; offset to where.y		lda	[dp.event],y		sta	whichPt		pha		_FindWindow		pla		cmp	#wInContent	; inside some window?		bne	neExit; If not in volume list window, just exit		lda	whichWindow		cmp	volWindow		bne	neExit		lda	whichWindow+2		cmp	volWindow+2neExit		bnel	exit		; bne exit;; Get the local coordinates of the point;		pha			; room for current port		pha		_GetPort		; leave port on stack		PushLong volWindow		_SetPort		PushLong #whichPt		_GlobalToLocal;; I will claim the event if the point was within checkRect;		pha			; room for result		PushLong #whichPt		PushLong #checkRect		_PtInRect		pla		beq	toPortExit;; It was near the check boxes, so claim the event;		lda	#0		sta	[dp.event]		; change the event to a null event;; Find out which check box it was in (if any);; check horizontal position		lda	whichPt+2	; get X of point		sec		sbc	checkRect+oh1	; rect.left		cmp	#5		blt	toPortExit	; to right of check boxes		cmp	#30		bge	toPortExit	; to left, so try in item; Check vertical (and find which item it was in)		pha			; room for remainder		pha			; room for quotient		lda	whichPt		; get point's Y		sec		sbc	checkRect+ov1	; get offset inside rect		pha		PushWord #11		; member height		_UDivide				pha			; room for result		PushLong volListH		_GetCtlValue		; get first displayed item				pla			; get first displayed		clc		adc	1,s		; plus offset from top of list		dea			; minus 1 to make 0-based		sta	itemNum		pla			; pop quotient				pla			; get remainder		sta	vOffset		; offset from top of member		cmp	#2		blt	toPortExit	; above box		cmp	#11		blt	InCheckBoxtoPortExit	brl	PortExitInCheckBox*** added 25-Mar-93 DAL -- range-check the itemNum against the total number***   of items, so we don't track a "phantom" checkbox below the last item,***   if fewer than 4 items are being displayed		pha		pha			;space for GetCtlTitle		pushlong volListH	;list control		_GetCtlTitle		pla			;ignore low word (# items visible at once)		pla			;high word = total items in list* itemNum is zero-based, and total items is an absolute number* To proceed, itemNum must be strictly less than total items,* which is toay total items must be strictly greater than itemNum.* So we should bail if total items is less than or equal to itemNum.		cmp	itemNum		;itemNum (0-based) must be < total items		bcc	toPortExit	;less than --> outta here		beq	toPortExit	;equal --> outta here@continue*** end 25-Mar-93;; Here, click was in a checkbox.  vOffset holds the offset in pixels from; top of the item.  itemNum holds the 0-based member number.  Create a; checkbox and track it, changing the member's record when done.;; Set up a pointer to the member's record and lock it		lda	volMembers+2		sta	dp.memPtr+2		pha			; push for HLock		lda	volMembers		sta	dp.memPtr		pha			; push for HLock		_HLock		ldy	#2		lda	[dp.memPtr],y		tax		lda	[dp.memPtr]		sta	dp.memPtr		stx	dp.memPtr+2				pha			; room for result		pha		PushWord itemNum		PushWord #6		; member record size		_Multiply		clc		pla		adc	dp.memPtr		sta	dp.memPtr		pla		adc	dp.memPtr+2		sta	dp.memPtr+2; Fix up bounding rectangle and initial value in template		lda	whichPt		; get mousedown vertical		sec		sbc	vOffset		; find top of item		ina			; leave one pixel white space		sta	checkBoxTempl+6	; fix up top		clc		adc	#11		sta	checkBoxTempl+10 ; fix up bottom				ldy	#omemFlag		lda	[dp.memPtr],y	; get checked flag in high bit		and	#$8000		; only checked bit		asl	a		rol	a		; now have 0/1 in A		sta	checkBoxTempl+$1E ; fix up initial value		; Create the check box		pha			; room for control handle		pha		PushLong volWindow	; window pointer		PushWord #singlePtr		PushLong #checkBoxTempl		_NewControl2		PullLong checkBoxH	; get control handle back; Track the control		pha			; room for result		ldy	#owhere+2		lda	[dp.event],y		pha			; push event.where.x		dey		dey		lda	[dp.event],y		pha			; push event.where.y		lda	#0		pha			; push NIL actionProc		pha		PushLong checkBoxH		_TrackControl		pla		beq	NoChange	; no part, no change; They changed checkbox, so change value in control and in member record		pha			; room for control's value		PushLong checkBoxH		_GetCtlValue		pla		eor	#1		; flip between on and off		pha			; push new value; Keep track of how many boxes are checked so I can hide/show the; Save My Name/Save My Name and Password buttons.		beq	@off		; branch if now off		; Box just turned on.  Make sure buttons are visible		lda	checkCount	; were any checked before?		bne	@noshow		; yes, so buttons already visible		jsr	ShowVolButtons@noshow		inc	checkCount	; one more box checked		bra	SetCheckVal		; Box just turned off.  If all off, hide buttons.@off		dec	checkCount	; one less box checked		bne	@nohide		; more still on, don't hide buttons		jsr	HideVolButtons@nohide		; Update the checkbox's state on screen (new value is still on stack)SetCheckVal		PushLong checkBoxH		_SetCtlValue				lda	#1		sta	prepChange	; need to update AppleShare.Prep				ldy	#omemFlag		lda	[dp.memPtr],y		eor	#$8000		; invert checked flag		sta	[dp.memPtr],yNoChange		; Terminate the check box		PushLong checkBoxH		_DisposeControl;; Unlock the member records;		PushLong volMembers		_HUnlock		;; Restore the port and exit;PortExit		_SetPort;; Clean up stack and return;exit		lda	dp.rtl		sta	dp.rtl+4		lda	dp.rtl+1		sta	dp.rtl+5				pla			; pull locals off		pla		pla		pla				pld		plb				pla			; remove space for task record pointer		pla				rtl				endp;======================================================================;;			ReadPrepFile;; This routine creates a handle to hold a copy of the AppleShare.Prep; data.  It then reads the contents of the file into the handle.  If; there is an error (out of memory, file read error), prepHandle will; be set to zero and the handle deallocated.  If the file does not; exist, I will create a handle with a zero word in it.;;======================================================================ReadPrepFile	procname		import	OpenGS:OpenGSRec		import	GetEOFGS:GetEOFGSRec		import	ReadGS:ReadGSRec		import	CloseGS:CloseGSRec		import	BuildPrepPath,prepHandle						stz	prepHandle	; assume none created		stz	prepHandle+2		jsr	BuildPrepPath	; build pathname				lda	#1		; want read-only access		sta	OpenGS.reqAccess		_OpenGS	OpenGS		bcc	opened		cmp	#$46		; file not found?		bne	toexit		; other error, just exit		lda	#2		; handle with just a word in it		jsr	NewHandle		bcs	toexit				sty	prepHandle		stx	prepHandle+2		tya			; ready for Deref		jsr	Deref		phd			; create stack frame		phx			; push high word of pointer		pha			; low word		tsc		tcd		lda	#0		; zero servers		sta	[1]		pla		plx		pld		toexit		brl	exitopened		lda	OpenGS.refnum		sta	GetEOFGS.refnum		sta	ReadGS.refnum		sta	CloseGS.refnum				_GetEOFGS GetEOFGS		bcs	closeexit		lda	GetEOFGS.eof+2	; bigger than 64K?		bne	closeexit	; can't deal with that!				lda	GetEOFGS.eof	; get file/handle size		sta	ReadGS.reqCount		stz	ReadGS.reqCount+2		jsr	NewHandle	; allocate a moveable handle		bcs	closeexit				sty	prepHandle	; save handle		stx	prepHandle+2				phx		phy		_HLock			; lock the handle				lda	prepHandle		ldx	prepHandle+2		jsr	Deref		; deref handle to get pointer		sta	ReadGS.buffer	; where data should be read		stx	ReadGS.buffer+2		_ReadGS	ReadGS		; read the data		php			; save error status				lda	prepHandle+2		pha		lda	prepHandle		pha		_HUnlock		; always unlock handle				plp			; get error from read		bcc	closeexit	; no error, keep handle				lda	prepHandle+2		pha		lda	prepHandle		pha		_DisposeHandle		; read bad, throw away handle		stz	prepHandle		stz	prepHandle+2closeexit		_CloseGS CloseGS		exit		rts				endp;======================================================================;;			WritePrepFile;; This routine writes out the contents of prepHandle to the; AppleShare.Prep file, creating it if needed.  The handle is; always disposed before leaving.;;======================================================================WritePrepFile	procname		import	CreateGS:CreateGSRec		import	OpenGS:OpenGSRec		import	SetMarkGS:SetMarkGSRec	; used for SetEOFGS		import	ReadGS:ReadGSRec	; used for WriteGS		import	CloseGS:CloseGSRec		import	BuildPrepPath,prepHandle,prepDirty						lda	prepHandle		ora	prepHandle+2		beql	exit		lda	prepDirty		beql	dispose		; data didn't change, don't write		jsr	BuildPrepPath		_CreateGS CreateGS		lda	#3		; want read/write		sta	OpenGS.reqAccess		_OpenGS	OpenGS		bcs	dispose				lda	OpenGS.refnum		sta	SetMarkGS.refnum		sta	ReadGS.refnum		sta	CloseGS.refnum				stz	SetMarkGS.base	; EOF := displacement		pha			; room for handle size		pha		lda	prepHandle+2		pha		lda	prepHandle		pha		_GetHandleSize		pla		sta	SetMarkGS.displacement		sta	ReadGS.reqCount		pla		sta	SetMarkGS.displacement+2		sta	ReadGS.reqCount+2				_SetEOFGS SetMarkGS		bcs	closeexit		lda	prepHandle+2		pha		lda	prepHandle		pha		_HLock			; lock the data before I write				lda	prepHandle		ldx	prepHandle+2		jsr	Deref		; get pointer to data		sta	ReadGS.buffer		stx	ReadGS.buffer+2				_WriteGS ReadGS		; write data out		lda	prepHandle+2		pha		lda	prepHandle		pha		_HUnlock		; always unlock		closeexit		_CloseGS CloseGS	; always close filedispose		lda	prepHandle+2		pha		lda	prepHandle		pha		_DisposeHandleexit		rts				endp		;======================================================================;;			DelSrvrPrep;; This routine scans the contents of prepHandle and squeezes out any; ServerInfoRec's that have the same server and zone name as the; current server; the corresponding VolumeInfoRec's are also squeezed.;; A pointer to the server's name (a PString) is at subText.  The zone; name PString is at LookupZone.;;======================================================================DelSrvrPrep	procname		import	subText,LookupZone,prepHandle,prepDirtylocal		record	dp.localscount		ds.w	1		; count of serversrecsize		ds.w	1		; size of server's recordsp		ds.l	1		; points to ServerInfoRecprepEnd		ds.l	1		; original end of prepHandle dataprepStart	ds.l	1		; start of prepHandle data		endr		lda	prepHandle		ora	prepHandle+2		beql	done		; no data to check!		lda	prepHandle+2		pha		lda	prepHandle		pha		_HLock			; lock handle while during scan		lda	prepHandle		ldx	prepHandle+2		jsr	Deref		; get pointer to data		sta	local.p		sta	local.prepStart		stx	local.p+2		stx	local.prepStart+2		pha			; room for size		pha		lda	prepHandle+2		pha		lda	prepHandle		pha		_GetHandleSize		clc		pla		adc	local.p		sta	local.prepEnd	; compute end of prep data		pla		adc	local.p+2		sta	local.prepEnd+2				lda	[local.p]	; get count of servers		sta	local.count		beql	unlock		; no servers, we're done		clc		lda	local.p		; point to first ServerInfoRec		adc	#2		; two bytes into data		sta	local.p		lda	local.p+2		adc	#0		sta	local.p+2;; For each server in the list, check it against the current server.; If it matches, squeeze it out of the data.;loop; Find size of this ServerInfoRec and its associated VolumeInfoRec's		pha			; room for product		pha		ldy	#ServerInfoRec.volCount		lda	[local.p],y	; get volume count		pha		pea	VolumeInfoRec.sizeof		_Multiply		; get size of VolumeInfoRec's		clc		pla			; volume(s) size		adc	#ServerInfoRec.sizeof		sta	local.recsize		pla			; ignore high word of product		; Compare server names		pha			; room for result		pea	0		; flags, reserved		PushLong subText		clc		lda	local.p		; get pointer to serverName		adc	#<ServerInfoRec.serverName		tax			; save low word		lda	local.p+2		adc	#^ServerInfoRec.serverName		pha			; push pointer to serverName		phx		_CompareStrings		pla			; zero => strings match		bne	next		; different, try next record; Compare zone names		pha		pea	0		PushLong #LookupZone		clc		lda	local.p		adc	#<ServerInfoRec.serverZone		tax		lda	local.p+2		adc	#^ServerInfoRec.serverZone		pha		phx		_CompareStrings		pla		bne	next		; different, try next;; Here the server and zone strings match.  Move the data after the; current record through prepEnd down over the start of the current; record.;		lda	#1		sta	prepDirty	; data was modified				lda	[local.prepStart]		dea			; adjust server count		sta	[local.prepStart]		; source is this record + size of this record		clc		lda	local.p		adc	local.recsize		tax		lda	local.p+2		adc	#0		pha		phx; destination is this record		lda	local.p+2		pha		lda	local.p		pha; count is prepEnd - source		sec		lda	local.prepEnd		sbc	5,s		tax		lda	local.prepEnd+2		sbc	7,s		pha		phx		_BlockMove				bra	next2		; p already points to next recordnext		clc		lda	local.p		adc	local.recsize	; point to next ServerInfoRec		sta	local.p		lda	local.p+2		adc	#0		sta	local.p+2next2		dec	local.count		bnel	loop; Here, local.p points to end of the real data.  Subtract the start; of the real data to get the new handle size.		sec		lda	local.p		sbc	local.prepStart		tax		lda	local.p+2		sbc	local.prepStart+2		pha			; push new size		phx		lda	prepHandle+2		pha			; push handle		lda	prepHandle		pha		_SetHandleSizeunlock		lda	prepHandle+2		pha		lda	prepHandle		pha		_HUnlockdone		rts				endp;======================================================================;;			WriteSrvrInfo;; This routine appends a ServerInfoRec to prepHandle.; On entry, the serverInfo.serverFlags field must be correctly set.; The volume count is obtained from checkCount.  The server count is; incremented.;;======================================================================WriteSrvrInfo	procname		import	serverInfo:ServerInfoRec		import	subText,LookupZone,prepHandle		import	userName,serverPassword,cryptKey		import	checkCount,prepDirty				local		record	dp.localsoldSize		ds.l	1prepStart	ds.l	1		endr		lda	prepHandle		ora	prepHandle+2		beql	done		; no handle to append to; get the old handle size and add the size of a ServerInfoRec		pha			; room for size		pha		lda	prepHandle+2		pha		lda	prepHandle		pha		_GetHandleSize		clc		lda	1,s		sta	local.oldSize		adc	#<ServerInfoRec.sizeof		sta	1,s		lda	3,s		sta	local.oldSize+2		adc	#^ServerInfoRec.sizeof		sta	3,s		lda	prepHandle+2		pha		lda	prepHandle		pha		_SetHandleSize		bcsl	done		; couldn't expand; set the server name		PushLong subText	; push handle to server name (*0)		PushLong #serverInfo.serverName		PushLong #32		_BlockMove; set the zone name		PushLong #LookupZone		PushLong #serverInfo.serverZone		PushLong #34		_BlockMove; zero out user name and password in case we're saving a guest or; name only		ldx	#38		; size(name) + size(password) - 2loop1		stz	serverInfo.userName,x		dex		dex		bpl	loop1; set the user name		lda	userName		and	#$00FF		beq	guest		; don't save name or password		PushLong #userName		PushLong #serverInfo.userName		PushLong #32		_BlockMove; set the password		bit	serverInfo.serverFlags		bmi	guest		; don't save password		ldx	#6loop2		lda	serverPassword+1,x		eor	cryptKey,x		sta	serverInfo.srvrPassword,x		dex		dex		bpl	loop2guest		lda	checkCount		sta	serverInfo.volCount; Lock handle and copy our data into it		lda	prepHandle+2		pha		lda	prepHandle		pha		_HLock		PushLong #serverInfo	; source		lda	prepHandle		ldx	prepHandle+2		jsr	Deref		sta	local.prepStart		stx	local.prepStart+2		clc		adc	local.oldSize	; start + oldSize  = dest		tay			; save low word in Y		txa		adc	local.oldSize+2		pha		phy			; push dest		PushLong #ServerInfoRec.sizeof		_BlockMove		lda	[local.prepStart]		ina			; one more ServerInfoRec		sta	[local.prepStart]				lda	#1		sta	prepDirty		; Unlock handle and exit		lda	prepHandle+2		pha		lda	prepHandle		pha		_HUnlockdone		rts				endp;======================================================================;;			WriteVolInfo;; This routine appends a VolumeInfoRec to prepHandle.  Caller must; set volInfo.volFlags.  The volume name is pointed to by subText+8.;;======================================================================WriteVolInfo	procname		import	serverInfo:ServerInfoRec		import	volInfo:VolumeInfoRec		import	cryptKey,volPassword,subText,prepHandle		local		record	dp.locals+8oldSize		ds.l	1prepStart	ds.l	1		endr		lda	prepHandle		ora	prepHandle+2		beql	done		; no handle to append to; get the old handle size and add the size of a ServerInfoRec		pha			; room for size		pha		lda	prepHandle+2		pha		lda	prepHandle		pha		_GetHandleSize		clc		lda	1,s		sta	local.oldSize		adc	#<VolumeInfoRec.sizeof		sta	1,s		lda	3,s		sta	local.oldSize+2		adc	#^VolumeInfoRec.sizeof		sta	3,s		lda	prepHandle+2		pha		lda	prepHandle		pha		_SetHandleSize		bcs	done		; couldn't expand; set the volume name		PushLong subText+8	; volume name source		PushLong #volInfo.volName		PushLong #28		_BlockMove; set the password (to null if no password or not saved)		ldx	#6loop		stz	volInfo.volPassword,x		bit	serverInfo.serverFlags		bmi	next		; not saving passwords		bit	volInfo.volFlags		bpl	next		; no password to save		lda	volPassword+1,x		eor	cryptKey,x		sta	volInfo.volPassword,xnext		dex		dex		bpl	loop; Lock handle and copy our data into it		lda	prepHandle+2		pha		lda	prepHandle		pha		_HLock		PushLong #volInfo	; source		lda	prepHandle		ldx	prepHandle+2		jsr	Deref		sta	local.prepStart		stx	local.prepStart+2		clc		adc	local.oldSize	; start + oldSize  = dest		tay			; save low word in Y		txa		adc	local.oldSize+2		pha		phy			; push dest		PushLong #VolumeInfoRec.sizeof		_BlockMove; Unlock handle and exit		lda	prepHandle+2		pha		lda	prepHandle		pha		_HUnlockdone		rts				endp;======================================================================;;			SetDefName;; This routine sets up default values for userName and serverPassword.; It also sets up a default value for saveNameOnly (used in the; volume list window).;;======================================================================SetDefName	procname		import	myWindow,userName,serverPassword		import	saveNameOnly,subText,LookupZone		import	cryptKey,prepHandlelocal		record	1p		ds.l	1		; pointer to prep datacount		ds.w	1		; server countsizeof		endr		phd		tsc		sec		sbc	#local.sizeof-1		tcs		tcd;; The default values are the user name from the "Connect as"; window, an empty password, and Save My Name Only.  If the; AppleShare.Prep file has an entry for the same server and; zone, then these values will be replaced.;		PushLong myWindow		PushLong #UserLE		PushLong #userName		_GetLETextByID		stz	serverPassword	; no default password		lda	#$8000		sta	saveNameOnly	; default to name only;; Scan the contents of prepHandle looking for a matching; server and zone name.;		PushLong prepHandle		_HLock				lda	prepHandle		ldx	prepHandle+2		jsr	Deref		sta	local.p		stx	local.p+2				lda	[local.p]	; get server count		sta	local.count		beql	notfound				clc		lda	local.p		adc	#2		; point to first server entry		sta	local.p		lda	local.p+2		adc	#0		sta	local.p+2loop; Compare server names		pha			; room for result		pea	0		; flags, reserved		PushLong subText	; pointer to server name		clc		lda	local.p		adc	#<ServerInfoRec.serverName		tax		lda	local.p+2		adc	#^ServerInfoRec.serverName		pha		phx			; point to server name in prep data		_CompareStrings		pla		bne	next; Compare zone names		pha		pea	0		PushLong #LookupZone		clc		lda	local.p		adc	#<ServerInfoRec.serverZone		tax		lda	local.p+2		adc	#^ServerInfoRec.serverZone		pha		phx		_CompareStrings		pla		beq	foundnext		pha			; room for result		pha		ldy	#ServerInfoRec.volCount		lda	[local.p],y	; get volume count		pha		PushWord #VolumeInfoRec.sizeof		_Multiply		clc		pla			; get size of volume records		adc	#ServerInfoRec.sizeof		adc	local.p		sta	local.p		pla		adc	local.p+2		sta	local.p+2				dec	local.count		bne	loop		bra	notfoundfound; Here the server and zone names match.  Pick up the user name,; password, and Save My Name Only flag.		clc		lda	local.p		adc	#<ServerInfoRec.userName		tax		lda	local.p+2		adc	#^ServerInfoRec.userName		pha			; source is userName field		phx		PushLong #userName	; dest is userName global		PushLong #32		; always do 32 bytes		_BlockMove				lda	[local.p]		and	#$8000		; get Save My Name Only flag		sta	saveNameOnly		bmi	notfound	; no password to copy				clc		lda	local.p		adc	#<ServerInfoRec.srvrPassword		sta	local.p		lda	local.p+2		adc	#^ServerInfoRec.srvrPassword		sta	local.p+2				sep	#$30		longa	off		longi	off				ldy	#0		; index into string		ldx	#$FF		; assume string length of zeroploop		lda	[local.p],y		eor	cryptKey,y		sta	serverPassword+1,y		beq	@nosize		tyx			; save index of last non-zero char@nosize		iny		cpy	#8		blt	ploop		inx			; get string length		stx	serverPassword				rep	#$30		longa	on		longi	onnotfound		PushLong prepHandle		_HUnlock				tsc		clc		adc	#local.sizeof-1		tcs		pld				rts				endp								;======================================================================;;			AskForVolPass;; Put up a simple dialog asking the user for a volume's password.; Note: it preserves the current port so that SelectVols can get; its controls.;; On exit:;	carry set if they pressed "Cancel";	volPassword set and null padded if they hit "OK";;======================================================================AskForVolPass	procname export		import	vpWindow,windOrigin,taskRecord		import	NewWindByID,volPassword,mountFlag		import	subText,ShowPFIErr		pha			; room for cancel flag		pha			; room for current port		pha		_GetPort;; Create the "Enter a password..." window;		lda	#rVPDialog		jsr	NewWindByID		stx	vpWindow		sta	vpWindow+2		;; Now handle the dialog until a button is clicked;loop		pha			; room for result		pha		PushLong #taskRecord		lda	#0		; value for defaults		pha			; use standard update routine		pha		pea	$8000		; Event hook = $80000000		pha			; to do Cmd-. => Esc translation		pha			; use default beep routine		pha		PushWord #mwIBeam	; DoModalWindow flags		_DoModalWindow		pla			; get control ID		plx			; ignore high word				cmp	#3		; beyond one of the buttons?		bge	loop		asl	a		tax		jsr	(hitTable,x)	; do appropriate handler		bcc	loop				sta	5,s		; save cancel flag		PushLong vpWindow		_CloseWindow		_SetPort		; restore old port		pla			; get cancel flag		lsr	a		; put it in carry				rtshitTable		dc.w	nullEvent		dc.w	ok		dc.w	cancelnullEvent		clc			; keep going		rtsok;; Fill password buffer with nulls, then get password.  This will; have the effect of leaving an 8 byte, null padded password at; volPassword+1.;		ldx	#8@padloop		stz	volPassword,x		dex		dex		bpl	@padloop		PushLong vpWindow		PushLong #idVPLE		PushLong #volPassword		_GetLETextByID;; Now, try to mount the volume (if there is an error, put up a; dialog and let them change the password).;		lda	mountFlag		ldx	subText+8	; point to volume name		ldy	subText+10		jsr	MountAVol		bcc	@done		; it worked, exit dialog;; Put up an error message and let them try again;		pha			; save error code		jsr	ShowPFIErr	; tell user what went wrong		pla			; get error code back		cmp	#FIAccessErr	; access denied (bad password)?		bne	cancel		; no, so quit trying;; Error was bad volume password.  Select it and let them try again.;		lda	#idVPLE		jsr	SelectLEByID		clc			; don't exit dialog		rts		@done		lda	#0		; they pressed OK		sec			; exit dialog		rtscancel		lda	#1		; they pressed cancel		sec			; exit dialog		rts				endp								;======================================================================;;			TestDoubleClick;; This is a common routine used by the event hooks to test for double; clicks.  It keeps track of the last mousedown and compares the; current mousedown with the previous one.  If the time between clicks; is greater than GetDblTime() or the distance between clicks is more; than 5 pixels, then it is not considered a double click.  The; distance formula I use is the sum of the absolute values of the; differences in X and Y position (i.e. |x1-x2| + |y1-y2|).;; The caller must set up a direct page and place a pointer to the event; record at location 1 and provide 4 bytes of temporary space at; location 5.;; On exit, the global dblClick will be modified.  It will be non-zero; if the last click was a double click, or zero otherwise.;;======================================================================TestDoubleClick	procname		import	dblClick,lastWhere,lastWhen		event		equ	1		; pointer on caller's direct pagework		equ	5		; 4 bytes space on caller's dp		lda	[event]		; get event code		cmp	#mouseDownEvt		bne	ignore		; not mousedown, so ignore it;; Now see if the last mousedown time and place are close enough; to the current one to be considered a double-click.  The test is:;	event.when-lastWhen < GetDblTime;		AND;	abs(event.where.v-lastWhere.v)+abs(event.where.h-lastWhere.h) < 5;		stz	dblClick	; assume it isn't a double-click;; First, compute the difference in times as deltaT;		ldy	#owhen		lda	[event],y	; get event's when		sec		sbc	lastWhen	; compute delta time		sta	work		; save low word of time difference		iny		iny		lda	[event],y		sbc	lastWhen+2	; get high word of difference		sta	work+2		;; If GetDblTime() < deltaT then it's not a double-click;		pha		pha			; space for result		_GetDblTime		pla		cmp	work		; compare low word		pla		sbc	work+2		; continue compare to high word				blt	update		; not a double-click;; Now compute the difference in mouse position in pixels;		ldy	#owhere		lda	[event],y	; get V from event		sec		sbc	lastWhere	; get difference in V		bcs	@absV		; branch in difference is positive		eor	#$FFFF		; get one's complement		ina			; now have abs(delta V)@absV		sta	work		iny		iny			; offset to H in event		lda	[event],y		sec		sbc	lastWhere+2		bcs	@absH		eor	#$FFFF		ina@absH		clc		adc	work		; get sum of deltas		bcs	update		; carry?  sum is way too large		cmp	#6		; 6 or more pixels off?		bge	update		; yes, so not a double-click;; Finally, we have a double-click.  Set the flag and fall into updating; the last mousedown info.;		inc	dblClick	; yes, it was a double-click;; Here, copy the when and where from the event record to our globals;update		ldy	#owhen		lda	[event],y		sta	lastWhen		iny		iny		lda	[event],y		sta	lastWhen+2				iny		iny			; offset to where.v		lda	[event],y		sta	lastWhere		iny		iny			; offset to where.h		lda	[event],y		sta	lastWhere+2		ignore		rts		endp;======================================================================;;			NewWindByID;; This routine creates and shows a new window by simply supplying a; resource ID of an rWindParam1 resource.  The window is created,; the port is set to it, the window is moved right 160 pixels if we're; in 640 mode (so the resource's rectangle should be set up for 320; mode), and finally the window is shown.  It assumes that the high; word of the rWindParam1 resource ID is zero.;; On entry:;	A = low word of rWindParam1 resource ID;; On exit:;	A = high word of window pointer;	X = low word of window pointer;; Uses:;	windOrigin			a Point in the globals;;======================================================================NewWindByID	procname		import	windOrigin		;; Create the window;		pha			; space for result		pha		ldx	#0		; value for using defaults		phx			; don't replace title		phx		phx			; don't replace refcon		phx		phx			; don't replace content draw		phx		phx			; don't replace defproc		phx		PushWord #refIsResource		pea	0		; high word of resource ID is zero		pha			; push low word of resource ID		PushWord #rWindParam1		_NewWindow2;; Set the current port to the window I just created;		lda	3,s		pha			; make a copy of window pointer		lda	3,s		pha		_SetPort		; set port to new window;; Here, I check to see if we're in 640 mode.  If so, I; want to move the window right by 160 pixels.;		pha			; room for result		_GetMasterSCB		pla		and	#$0080		; are we in 640 mode?		beq	was320		; no, so leave window alone		stz	windOrigin		stz	windOrigin+2		PushLong #windOrigin		_LocalToGlobal		; find out where window is now		lda	3,s		; get high word of window pointer		tax		lda	1,s		; get low word of window pointer		tay		lda	windOrigin+2		clc		adc	#160		; move right by 160 pixels		pha		lda	windOrigin		pha			; use old Y		phx			; push window pointer		phy		_MoveWindowwas320;; Make the window visible;		lda	3,s		pha			; make a copy of window pointer		lda	3,s		pha		_ShowWindow;; Clean up stack and exit;		plx			; get window pointer in A,X		pla				rts				endp;======================================================================;;			FindString;; This is a special-purpose routine for comparing a given string with; a list of strings in ReplyBuf.  It is used to find AFP versions and; UAM's that are returned in an SPGetStatus call.;; On entry,;	Long pointer to target string on stack below RTS;	A = offset in ReplyBuf of count of strings (in 68000 order);; On exit,;	target string pointer removed from stack;	Z = 1 iff target string was found in list;;======================================================================FindString	procname		import	ReplyBuf		dp		record	1savedD		ds.w	1str		ds.l	1		; pointer into ReplyBufrts		ds.w	1target		ds.l	1		; pointer to target string		endr;; Create stack frame and build pointer to first string;		xba			; put offset in 65xxx order				pha			; room for high word of dp.str				tax			; save ReplyBuf offset in X				sec			; add 1 to skip over string count		adc	#<ReplyBuf	; create pointer to first string		pha			; create/set low word of dp.str		phd			; save old direct register		lda	#^ReplyBuf		adc	#0		sta	dp.str+2,s	; set high word of dp.str				tsc		tcd			; point D to top of stack		sep	#$30		; go to short A,X,Y for chars		longa	off		longi	off				lda	ReplyBuf,x	; get string count		tax		;; Compare one string;loop_string	lda	[dp.target]	; get length of string to compare		tay			; use Y as string indexloop		lda	[dp.target],y		cmp	[dp.str],y		bne	next		; no match, try next string		dey		bpl	loop		bne	exit		; always taken!next		rep	#$30		longa	on		longi	on		lda	[dp.str]	; get length of string		and	#$00FF		; length byte only		ina			; plus 1 for length byte itself		clc		adc	dp.str		sta	dp.str		; point to next string in list		bcc	nohi		inc	dp.str+2nohi		sep	#$30		longa	off		longi	off		dex			; more strings to check?		bne	loop_string	;fixed branch (was loop, 4-Mar-93 DAL)exit;; Note: When we get here, Z=1 if strings DIDN'T match.  This is opposite; of the return condition we want, so we'll just invert the Z bit since; we have to save it off anyway.;		rep	#$30		longa	on		longi	on				php			; save Z,m,x status		php			; save 16 bits worth		pla		eor	#$0202		; invert Z bit in both copies		sta	dp.target	; save where I can get it later				pld			; restore stack		pla			; pop dp.str		pla		pla			; get RTS		sta	3,s		; put at dp.target+2		plp			; pop byte at dp.target		plp			; get stored P from above		rts				endp				;======================================================================;;			AlertByID;; This is a simplified version of AlertWindow.  It takes the low word; of a resource ID for an rAlertString resource in A (the high word is; assumed to be zero).  It passes subText as the substitution array; and tells it to use PStrings.  It returns the button hit in A (this; is AlertWindow's result).;;======================================================================AlertByID	procname		import	subText				pha			; space for result		PushWord #RefIsResource*2+1+$20	; alert is by resource,					; Pascal substitution strings					; do buttons in the new way		PushLong #subText	; my usual substitution array		PushWord #0		; high word of resource ID is zero		pha			; push low word of resource ID				_AlertWindow				pla			; return result in A		rts				endp;======================================================================;;			GetStatus;; Do an SPGetStatus to find out whether the server supports changing; passwords, the AFP versions supported, and the supported UAM's.;;======================================================================GetStatus	procname export		import	replyBuf,FindString		import	hasChgPwd,hasAFP20,hasAFP21		import	hasGuest,hasClearText,hasScrambled		import	SPGetStatus:SPGetStatusRec		import	AFPVersion20,AFPVersion21,GuestUAM,ClearTextUAM		import	ScrambledUAM,serverAddress				lda	serverAddress		sta	SPGetStatus.srvrAddr		lda	serverAddress+2		sta	SPGetStatus.srvrAddr+2				ATCall	SPGetStatus		bcs	Exit		; return if error;; See if it supports changing passwords;		lda	replyBuf+8	; flags bit 1 = SupportsChgPwd		and	#$0200		; get just SupportsChgPwd flag		sta	hasChgPwd		;; See if it supports AFP version 2.0;		stz	hasAFP20		PushLong #AFPVersion20		lda	replyBuf+2	; offset to count of versions		jsr	FindString		bne	noAFP20		inc	hasAFP20noAFP20*** added 4-Mar-93 DAL;; See if it supports AFP version 2.1;		stz	hasAFP21		PushLong #AFPVersion21		lda	replyBuf+2	; offset to count of versions		jsr	FindString		bne	noAFP21;########################################################################; FOR AFP 2.1 SUPPORT, ENABLE THIS! --25-Mar-93 DAL	if 0 then		inc	hasAFP21	endif;########################################################################noAFP21*** end 4-Mar-93;; See which UAMs it supports;		stz	hasGuest	; assume no guest access		PushLong #GuestUAM		lda	replyBuf+4	; offset to count of UAM's		jsr	FindString		bne	noguest		inc	hasGuestnoguest		stz	hasClearText	; assume no Clear Text		PushLong #ClearTextUAM		lda	replyBuf+4	; offset to count of UAM's		jsr	FindString		bne	nocleartext		inc	hasClearTextnocleartext		stz	hasScrambled	; assume no Randnum Exchange		PushLong #ScrambledUAM		lda	replyBuf+4	; offset to count of UAM's		jsr	FindString		bne	noscrambled		inc	hasScramblednoscrambled		clc			; return no errorExit		rts				endp								;======================================================================;;			ShowPFIErr;; This routine puts up an AlertWindow corresponding to the error code; passed in the A register.;;======================================================================ShowPFIErr	procname		ldy	#ErrCount		ldx	#0		; offset to error tablesloop		cmp	ErrTable,x	; compare against PFI error		beq	found		inx		inx		inx		inx		dey		bne	loopfound		lda	ErrTable+2,x	; get corresponding alert ID		jsr	AlertByID				rts;; This table is an array of word pairs.  The first word in a pair is; the PFI error; the second is the corresponding Alert ID.  There are; ErrTable+1 pairs.  The last entry is a catch-all unknown error (the; PFI error is zero).;ErrTable		dc.w	$0A01,rTooManySess		dc.w	$0A02,rServerBusy		dc.w	$0A03,rNoResponse		dc.w	$0A04,rBadUAM		; login continue???		dc.w	$0A07,rBadPassword	; access denied, bad volume password		dc.w	$0A08,rTooManyVols		dc.w	$0A15,rBadPassword		dc.w	$0A16,rBadUserName		dc.w	$0A17,rShuttingDown		dc.w	$0A18,rBadUAM		dc.w	$0A19,rBadAFPVersErrCount	equ	(*-ErrTable)/4		dc.w	0,rUnknownErr		endp;======================================================================;;			AppendToPath;; Appends a given GString to the GString stored at "Path".  It is used; in building up path names to the ATInit and AppleShare.Prep files.;; On entry:;	A = path pointer (high);	X = path pointer (low);;======================================================================AppendToPath	procname		import	Pathstr		equ	1		phd			; save before stack frame				pha			; save path pointer		phx				tsc		tcd			; create a stack frame; Get length of string to append		lda	[str]		; get length of string		tax			; save in X for count; Adjust string pointer for common string index		lda	str		sec		sbc	Path		; length of existing path		sta	str		lda	str+2		sbc	#0		sta	str+2; Point to first char to copy		ldy	Path		; length of existing path		iny			; plus two for length word		iny		sep	#$20		longa	offloop		lda	[str],y		sta	Path,y		iny		dex		bne	loop		rep	#$20		longa	on		; Save new path length		dey			; adjust for length word		dey		sty	Path		; save new length				plx		pla		pld				rts				endp;======================================================================;;			BuildSetupPath;; This routine builds the pathname of the folder where ATInit and; AppleShare.Prep are stored and puts the name in Path (with a trailing; colon).  The path will either be "*:System:System.Setup:" or; (":" BootVolName ":Users:" UserName ":Setup:") depending on whether; we booted from a file server.;;======================================================================BuildSetupPath	procname		import	FSTInfo:GetFSTInfoRec		import	GetUserPath:GetUserPathRec		import	SetupFolder,SystemSetup,Path						stz	Path		; make it empty string first		;; See if the boot FST (the first FST) was AppleShare;		lda	#1		sta	FSTInfo.fstNum		jsl	$E100A8		; GS/OS inline entry		dc.w	$202B		; GetFSTInfo		dc.l	FSTInfo		lda	FSTInfo.fileSysID		cmp	#$D		; AppleShare?		bne	Local;; They booted from a server, so we have to actually construct; the path by getting the UserPath and appending ":Setup:".;		jsl	$E100A8		dc.w	$2033		; FST specific		dc.l	GetUserPath		bcs	Local		; error, so use local name		ldx	GetUserPath.prefixPtr		lda	GetUserPath.prefixPtr+2		jsr	AppendToPath	; start with user path				ldx	#<SetupFolder		lda	#^SetupFolder		jmp	AppendToPath	; append ":Setup:" to pathLocal;; They booted locally, so use a hard-coded constant pathname;		ldx	#<SystemSetup		lda	#^SystemSetup		jmp	AppendToPath	; set it and exit		endp				;======================================================================;;			BuildATInitPath;; Build a pathname to the ATInit file.;;======================================================================BuildATInitPath	procname		import	ATInit				jsr	BuildSetupPath				ldx	#<ATInit		lda	#^ATInit		jmp	AppendToPath		endp;======================================================================;;			BuildPrepPath;; Build a pathname to the AppleShare.Prep file.;;======================================================================BuildPrepPath	procname export		import	ASharePrep				jsr	BuildSetupPath				ldx	#<ASharePrep		lda	#^ASharePrep		jmp	AppendToPath				endp		;======================================================================;;			GetUserName;; This routine looks in the ATInit file for the user's name.  If found,; it will set the userName variable; otherwise, userName will be set; to the empty string.  The oldUserName will also be set.;; Note: the user's name is at offset -133 from EOF and is a maximum of; 33 bytes (including the length byte).;;======================================================================GetUserName	procname		import	userName,oldUserName		import	OpenGS:OpenGSRec		import	SetMarkGS:SetMarkGSRec		import	ReadGS:ReadGSRec		import	CloseGS:CloseGSRec						stz	userName	; leave empty on error;; Figure out where to get ATInit file from;		jsr	BuildATInitPath;; Open, get end of file, set mark, and read user name;		lda	#1		; want read-only access		sta	OpenGS.reqAccess		_OpenGS	OpenGS		bcs	Exit		lda	OpenGS.refnum		sta	SetMarkGS.refnum		sta	ReadGS.refnum		sta	CloseGS.refnum				lda	#1		; base = EOF - displacement		sta	SetMarkGS.base		lda	#133		; offset from EOF		sta	SetMarkGS.displacement		stz	SetMarkGS.displacement+2		_SetMarkGS SetMarkGS		bcs	CloseExit				lda	#<userName		sta	ReadGS.buffer		lda	#^userName		sta	ReadGS.buffer+2		lda	#33		; read all of reserved space		sta	ReadGS.reqCount		_ReadGS	ReadGS		CloseExit		_CloseGS CloseGSExit;; Copy userName to oldUserName so we can test whether it gets changed.;		ldx	#32		; index of last word@loop		lda	userName,x		sta	oldUserName,x		dex		dex		bpl	@loop				rts				endp;======================================================================;;			WriteUserName;; This routine takes the user name in the main window's line edit; box and writes it out to the ATInit file.  It assumes BuildATInitPath; has already been called (from the InitCDEV message).;;======================================================================WriteUserName	procname		import	myWindow,userName,oldUserName		import	CreateGS:CreateGSRec		import	OpenGS:OpenGSRec		import	GetEOFGS:GetEOFGSRec		import	SetMarkGS:SetMarkGSRec		import	ReadGS:ReadGSRec		import	CloseGS:CloseGSRec;; Get the current name from the line edit box;		PushLong myWindow		PushLong #UserLE		PushLong #userName		_GetLETextByID;; See if current name matches previous name.  If so,; don't bother updating it.;		sep	#$30		; short mode for chars		ldx	userName		cpx	oldUserName	; compare lengths first		bne	@done@loop		lda	userName,x		cmp	oldUserName,x		bne	@done		dex		bne	@loop; If we get here, names match and Z is set (i.e. BEQ is taken)@done		rep	#$30		; back to 16-bit mode		bne	TryIt		; changed, write it		brl	Exit		; no change, don't writeTryIt		jsr	BuildATInitPath		;; Create the file if it isn't there (if it is, ignore the error).;		_CreateGS CreateGS;; Open the file for writing;		lda	#2		; want write-only access		sta	OpenGS.reqAccess		_OpenGS	OpenGS		bcsl	Error		lda	OpenGS.refnum		sta	GetEOFGS.refnum		sta	SetMarkGS.refnum		sta	ReadGS.refnum		sta	CloseGS.refnum;; Make sure the file is long enough.  If the EOF is less than 133, set; it to 133.;		_GetEOFGS GetEOFGS		bcs	CloseError		lda	GetEOFGS.eof		cmp	#133		lda	GetEOFGS.eof+2		sbc	#0		bcs	DoSetMark	; long enough, so do it;; Here, the file isn't long enough, so extend it.  I use the SetMarkGS; parameter block because it has the same format as SetEOFGS.;		stz	SetMarkGS.base	; base = displacement		lda	#133		; size I need		sta	SetMarkGS.displacement		stz	SetMarkGS.displacement+2		_SetEOFGS SetMarkGS		bcs	CloseErrorDoSetMark;; Back up in the file to where the user name goes;		lda	#1		sta	SetMarkGS.base	; base = EOF-displacement		lda	#133		; size I need		sta	SetMarkGS.displacement		stz	SetMarkGS.displacement+2		_SetMarkGS SetMarkGS		bcs	CloseError;; I use the ReadGS parameter block because it is formatted the same; as the WriteGS parameter block, and it has all the right values.;		lda	#<userName		sta	ReadGS.buffer		lda	#^userName		sta	ReadGS.buffer+2		lda	#33		sta	ReadGS.reqCount		_WriteGS ReadGS		bcs	CloseError;; Close the file!;		_CloseGS CloseGS		bcs	Error		rtsCloseError		_CloseGS CloseGSError		lda	#rATInitWriteErr		jsr	AlertByID		beql	TryIt		; button 0 = try againExit				rts			; else, just exit				endp;======================================================================;;			SetPassword;; This routine allows the user to change their password.  It does all; the work of bringing up the dialog, logging on, etc.  On exit, the; carry will be set if the change password was successful (carry clear; means they cancelled).;;======================================================================SetPassword	procname		import	connWindow,setPassWind,taskRecord		import	serverPassword,volPassword,emptyStr		import	userName,cmdBuf,selectedUAM,DES		import	ScrambledUAM,ClearTextUAM		import	SPCommand:SPCommandRec		import	FILogin:FILogin2Rec		import	FILogout:FILogoutRec		import	alreadyConnlocal		record	dp.localsconfirm		ds.w	1		; non-zero if confirming new password		endr;; Save old port;		pha			; room for cancel flag		pha			; room for old port		pha		_GetPort;; Create the set password window;		lda	#rSetPassDlg		jsr	NewWindByID		stx	setPassWind		sta	setPassWind+2		stz	local.confirm	; not confirming yet;; Now, wait for the user to hit one of the buttons;loop		pha			; room for result		pha		PushLong #taskRecord	; pointer to my extended task record		lda	#0		; value for defaults		pha			; use standard update routine		pha		pea	$8000		; Event hook = $80000000		pha			; to do Cmd-. => Esc translation		pha			; use default beep routine		pha		PushWord #mwIBeam	; DoModalWindow flags		_DoModalWindow		pla			; get control ID		plx			; ignore high word of ID		cmp	#idSetPassOK+1	; beyond what I care about?		bge	loop		; yes, so keep doing dialog		asl	a		tax		jsr	(hitTable,x)	; do the right thing		bcc	loop		;; Whatever it was, we're done.;		sta	5,s		; save cancel flag		PushLong setPassWind		_CloseWindow		_SetPort		; restore caller's port		pla			; get cancel flag back				lsr	a		; set carry if cancel		rtshitTable		dc.w	nullEvent		dc.w	Cancel		dc.w	OKnullEvent		clc		rtsCancel		lda	#0		; indicate Cancel pressed		sec			; end the dialog		rtsOK;; If we're not yet confirming the new password, then hide the old password; line edit, show the old password static text, get the text out of the new; password into serverPassword, set the new password to empty, and continue; the dialog.;		lda	local.confirm		bne	PassCompare	; go confirm/compare password				lda	#idSetPassOld		jsr	HideByID		lda	#idSPOldStat		jsr	ShowByID				PushLong setPassWind		PushLong #idSetPassNew		PushLong #serverPassword		_GetLETextByID		PushLong setPassWind		PushLong #idSetPassNew		PushLong #emptyStr		_SetLETextByID		inc	local.confirm	; now need to confirm new password				lda	#rConfirmPass	; tell user we need to confirm		jsr	AlertByID				clc			; not done with dialog yet		rts;; If we're currently confirming the new password, get it's text into; volumePassword (as a temporary place) and compare it to serverPassword; (where the first copy was placed).  If they don't match, put up an alert; and let them try again.  If they do match, try to do the change password.;PassCompare		ldx	#8padloop		stz	volPassword,x	; pad password with nulls		dex		dex		bpl	padloop		PushLong setPassWind		PushLong #idSetPassNew		PushLong #volPassword		_GetLETextByID;; See if both copies of new password match;		sep	#$30		; compare is easier in 8 bits		longa	off		longi	off				ldx	volPasswordcmploop		lda	volPassword,x		cmp	serverPassword,x		bne	NoMatch		dex		bpl	cmploop				rep	#$30		; back to 16 bits		longa	on		longi	on		brl	TryChange;; Passwords didn't match.  Tell the user and let them try again.;NoMatch		rep	#$30		longa	on		longi	on		lda	#rPassNoMatch		jsr	AlertByIDTryAgain		PushLong setPassWind		PushLong #idSetPassOld		PushLong #emptyStr		_SetLETextByID		; empty the old password field				PushLong setPassWind		PushLong #idSetPassNew		PushLong #emptyStr		_SetLETextByID		; empty the new password field				lda	#idSPOldStat		jsr	HideByID		lda	#idSetPassOld		jsr	ShowByID				lda	#idSetPassOld		jsr	SelectLEByID	; just to make it the target				stz	local.confirm	; not confirming any more				clc			; not done yet		rts;----------;; Try to log on and change the password;;----------TryChange;; Get old password;		ldx	#8@pad		stz	serverPassword,x	; pad password with nulls		dex		dex		bpl	@pad				PushLong setPassWind		PushLong #idSetPassOld		PushLong #serverPassword		_GetLETextByID;; If we're already connected, then userName is already set and; we don't need to log on.;		lda	alreadyConn	; already connected?		bne	ChangeIt	; yes, so just change it;; Get user name from the Connect As window;		PushLong connWindow		PushLong #rNameLE		PushLong #userName		_GetLETextByID				jsr	TryLogin	; have to log on first		bcc	ChangeIt	; login worked, change password;; Login didn't work.  Show them an error and let them try again;		cmp	#$0A15		; bad password		bne	@PFI		lda	#rOldPassBad	; old password bad		jsr	AlertByID		brl	TryAgain@PFI		jsr	ShowPFIErr		brl	TryAgain;; Now build up a change password packet and try it out.  If it fails, we; log off (if we weren't logged on before) and let them try again.;ChangeIt		lda	FILogin.sessRefNum		sta	SPCommand.sessRefNum		sta	FILogout.sessRefNum				lda	#FPChangePass		sta	cmdBuf				ldx	#2		; offset for UAM string		lda	selectedUAM		cmp	#rClearText		beq	@clear				PushLong #ScrambledUAM		jsr	PutString		bra	AddName@clear		PushLong #ClearTextUAM		jsr	PutStringAddName		txa		lsr	a		bcc	@nopad		stz	cmdBuf,x		inx@nopad		PushLong #userName		jsr	PutString		txa		lsr	a		bcc	@nopad2		stz	cmdBuf,x		inx@nopad2		lda	selectedUAM		cmp	#rClearText		beq	Clear;; Point to where passwords go;		txa		clc		adc	#<cmdBuf		sta	DESOldByNew+8		clc		adc	#8		sta	DESNewByOld+8		txa		clc		adc	#16		; get length of packet		pha		; Encrypt old password with new password and put in packet		ldx	#<DESOldByNew		ldy	#^DESOldByNew		jsl	DES; Encrypt new password with old password and put in packet		ldx	#<DESNewByOld		ldy	#^DESNewByOld		jsl	DES				pla			; put packet length back in A		bra	SendChangeClear; Put old and new passwords (clear text) in packet		ldy	#0@loop		lda	serverPassword+1,y		sta	cmdBuf,x		lda	volPassword+1,y		sta	cmdBuf+8,x		inx		inx		iny		iny		cpy	#8		bne	@loop				txa		clc		adc	#8		; adjust for second passwordSendChange		sta	SPCommand.bufLen ; save command packet length		ldx	#<SPCommand		ldy	#^SPCommand		jsr	RetryCommand		bcs	@err		lda	SPCommand.cmdResult+2	; any AFP error?		bne	@err; Copy the new password into serverPassword		ldx	#8		; index of last word@loop		lda	volPassword,x		sta	ServerPassword,x		dex		dex		bpl	@loop				lda	#1		; indicate all went well		sec			; end the dialog		rts@err		lda	alreadyConn	; were we already connected?		bne	@show		; yes, so don't log off!		ATCall	FILogout@show		lda	#rCantChangePass		jsr	AlertByID		brl	TryAgainDESOldByNew		dc.l	volPassword+1	; new password is key		dc.l	serverPassword+1 ; old password is data		dc.l	cmdBuf		; where to put resultDESNewByOld		dc.l	serverPassword+1 ; old password is key		dc.l	volPassword+1	; new password is data		dc.l	cmdBuf		; where to put result				endp;======================================================================;			FindMessage;; Find a server or volume's entry in the message center.  If there is; no message, one is created with zero entries.  It then updates or; retrieves the associated password.;; On entry:;	serverAddress		internet address of server for compare;	subText+8		points to volume name;	A = flags;		bit 15 set if message should be added/updated;		bit 14 set if do volume; On exit:;	carry set if entry not found;;======================================================================FindMessage	procname		import	messageHandle,msgOffset		import	serverAddress,subText,cryptKey		import	serverPassword,volPassword		local		record	1p		ds.l	1passPtroffset		ds.w	1		; offset into handlecount		ds.w	1		; number of entries in messagemsgKind		ds.w	1		; message typeentrySize	ds.w	1		; size of one entryflags		ds.w	1sizeof		endr		phd				pha			; save flags				tsc		sec		sbc	#local.flags-1	; allocate rest of locals		tcs		tcd			; set up local stack frame;; Set up message type and entry size;		ldx	#SrvrPassMsg	; assume server message		ldy	#12		; size of server entry		bit	local.flags	; was volume bit (overflow) set?		bvc	@kind		; no, so use server numbers		ldx	#VolPassMsg		ldy	#40		; size of volume entry@kind		stx	local.msgKind		sty	local.entrySize;; Get the old message if there is one.;		PushWord #getMessage		pei	local.msgKind	; message type		PushLong messageHandle		_MessageCenter		bcc	found;; There was no message.  If we're just getting (not updating/adding),; return entry not found.  If upating, resize handle and set count; to zero entries and fall through.;		bit	local.flags		bpll	errexit		; return with carry set		PushLong #8		PushLong messageHandle		_SetHandleSize				jsr	DerefMH				ldy	#6		; offset to count word		lda	#0		sta	[local.p],y		found;; Here, we have a message.  Start looking for an entry with a matching; address (and volume name).  We keep the handle locked since we may; call _CompareStrings.;		PushLong messageHandle		_HLock		jsr	DerefMH				ldy	#6		lda	[local.p],y	; get count of entries		sta	local.count		iny		iny		sty	local.offset		tax			; see if count was zero		beq	append		; yes, so just add to the endloop		ldy	local.offset		lda	[local.p],y	; get net number		cmp	serverAddress		bne	next		iny		iny		lda	[local.p],y	; get node/socket		cmp	serverAddress+2		bne	next; If doing volumes, compare the volume name here		bit	local.flags		bvcl	match		; address is all we needed!				pha			; room for result		pea	0		; flags (reserved)		PushLong subText+8	; pointer to real volume name		clc		lda	local.offset		adc	#4		; offset to volume name string		clc		adc	local.p		; point to volume name in message		tax		lda	local.p+2		adc	#0		pha			; push volume pointer		phx		_CompareStrings		pla			; get result		beql	match		; found it!next		clc		lda	local.offset		adc	local.entrySize	; point to next entry		sta	local.offset		dec	local.count		bne	loop;; Here, no matching entry was found.  If only getting, return an error.; If updating, need to add a new entry to the handle, set its address; and volume name, and fall into match.;		bit	local.flags		bmi	appenderrexit				sec			; not found!		brl	unlink		; unlock handle and exitappend		PushLong messageHandle		_HUnlock		; unlock before resize				pea	0		; high word of new length		clc		lda	local.offset	; current length		adc	local.entrySize	; add size of one entry		pha			; low word of new size		PushLong messageHandle		_SetHandleSize				PushLong messageHandle		_HLock			; lock handle again		jsr	DerefMH				ldy	#6		lda	[local.p],y		ina			; increment entry count		sta	[local.p],y				ldy	local.offset		lda	serverAddress		sta	[local.p],y	; update network number		iny		iny		lda	serverAddress+2		sta	[local.p],y	; update node/socket		iny		iny			; offset to volume name				bit	local.flags	; need to do volume name?vcmatch		bvc	match		; no, so fall into update				PushLong subText+8	; source is volume name		clc		tya			; offset to our volume in entry		adc	local.p		; pointer to volume in entry		tax		lda	local.p+2		adc	#0		pha			; push destination		phx		PushLong #28		; length of volume name		_BlockMove		match;; Here, we've got (or created) a matching entry.  Return or set; the password as appropriate.  Build offset to the password in; the message, and pointer to password global.  Local.p will point; to password within the entry and local.passPtr will point to the; password global.;		clc		lda	local.offset	; start of this entry		adc	local.entrySize	; end of this entry		sec		sbc	#8		; start of password in entry		clc		adc	local.p		sta	local.p		; point directly to password		lda	local.p+2		adc	#0		sta	local.p+2				lda	#^serverPassword ; our bank		sta	local.passPtr+2		lda	#<serverPassword		bit	local.flags		bvc	@novol		lda	#<volPassword@novol		sta	local.passPtr				bit	local.flags		bmi	update		; go write to message; Copy password out of message.  Don't forget to set length byte!		sep	#$30		longa	off		longi	off				ldy	#0		tyx			; assume length of zero@loop		lda	[local.p],y	; get from message		eor	cryptKey,y	; make it plain text		iny		sta	[local.passPtr],y ; store to password		cmp	#0		beq	@next		; don't update length		tyx			; remember offset of non-zero char@next		cpy	#8		bne	@loop		txa			; get length in A		sta	[local.passPtr]	; update length byte				rep	#$30		longa	on		longi	on				clc			; no error		bra	unlink		; unlock and exit		update		inc	local.passPtr	; point past length byte		ldy	#6		; offset of last word@loop		lda	[local.passPtr],y		eor	cryptKey,y	; scramble it		sta	[local.p],y		dey		dey		bpl	@loop				PushWord #addMessage		pei	local.msgKind		PushLong messageHandle		_MessageCenterunlink		php		php			; save carry in two bytes		plx			; leave P in X (A gets destroyed)				tsc		clc		adc	#local.sizeof-1	; remove local vars		tcs		pld		phx			; put P on stack again				PushLong messageHandle		_HUnlock		; make sure handle stays unlocked				plp		plp			; recover carry flag				rtsDerefMH		lda	messageHandle		ldx	messageHandle+2		jsr	Deref		sta	local.p		stx	local.p+2		rts				endp								;======================================================================;;			AddSrvrPass;; Add the current server's password to the Message Center data so it; will be available in case the user wants to save their name and; password.;; On entry:;	serverAddress		contains server's internet address;	serverPassword+1	contains server's password (null padded);; If there is an existing entry with the given serverAddress, its; password will be replaced; otherwise a new entry will be appended; to the message.;;======================================================================AddSrvrPass	procname export				lda	#$8000	; update, no volume		jsr	FindMessage		rts				endp;======================================================================;;			GetSrvrPass;; Get the current server's password from the Message Center data; (so I can save it in AppleShare.Prep).;; On entry:;	serverAddress		contains server's internet address;; On exit:;	serverPassword+1	contains server's password (null padded);;%%%;%%%	If I can't determine the password, it would be nice to ask;%%%	the user for it.  If they cancel, then it shouldn't be saved.;%%%;======================================================================GetSrvrPass	procname		import	serverPasswordrAutoNoPass	equ	600		; server password unknown		lda	#$0000	; get password, no volume		jsr	FindMessage		bcc	exit				ldx	#8loop		stz	serverPassword,x ; set password to empty		dex		dex		bpl	loop				lda	#rAutoNoPass		jsr	AlertByID		secexit		rts				endp		;======================================================================;;			AddVolPass;; Add the current volumes's name and password to the Message Center; data so it will be available in case the user wants to save their; name and password.;; On entry:;	serverAddress	contains server's internet address;	subText+8	points to volume name PString;	volPassword+1	contains volume's password (null padded);; If there is an existing entry with the given serverAddress and; volume name, its password will be replaced; otherwise, a new entry; will be appended to the message.;;======================================================================AddVolPass	procname export		lda	#$C000	; add, with volume		jsr	FindMessage		rts				endp		;======================================================================;;			GetVolPass;; Get the current volume's password from the Message Center so it can; be saved in the AppleShare.Prep file.;; On entry:;	serverAddress	contains server's internet address;	subText+8	points to volume name PString;; On exit:;	volPassword+1	contains volume's password (null padded);;%%%;%%%	If I can't determine the password, it would be nice to ask;%%%	the user for it.  If they cancel, then it shouldn't be saved.;%%%;======================================================================GetVolPass	procname		import	volPasswordrAutoNoVPass	equ	601		; volume password unknown error		lda	#$4000	; get, with volume		jsr	FindMessage		bcc	exit				ldx	#8loop		stz	volPassword,x	; set password to empty		dex		dex		bpl	loop				lda	#rAutoNoVPass		jsr	AlertByID		sec			; return an errorexit		rts				endp		end