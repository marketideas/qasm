checkWidth	equ	35		; number of pixels to leave for checkboxcheckSize	equ	25		; actual size of check boxcheckOffset	equ	5		; move checkbox right this many pixelstextOffset	equ	10		; move text right this many pixelslocalSize	equ	16		; size of local vars inside all messagesMaxZones	equ	255ZoneBufSize	equ	MaxZones*33	; zone list bufferZoneMemSize	equ	MaxZones*5	; zone member recordsMaxServers	equ	255ReplyEntSize	equ	33+10+33	; object + "AFPServer" + zoneSrvrBufSize	equ	MaxServers*ReplyEntSize	; server lookup bufferSrvrMemSize	equ	MaxServers*5	; server member recordsMaxVols		equ	50VolBufSize	equ	MaxVols*33+5	; room for FPGetSrvrParms replyVolMemSize	equ	MaxVols*6memChecked	equ	$8000		; in second byte of memFlag for volume listsmemNever	equ	$0020		; never select this itemMaxMessage	equ	12		; highest CDEV message number;; Control IDs for the main CDEV window;ServerString	equ	11ServerList	equ	12ServerOKButton	equ	13ZoneString	equ	14ZoneList	equ	15UserString	equ	16UserLE		equ	17;; IDs for the "Connect as..." window;; Note: all buttons have IDs greater or equal to rConnButtons; and all other controls have IDs that are less.;rConnDlg	equ	20rDlg1First	equ	21		; first ID of dialog 1rGuest		equ	21rRegistered	equ	22rConnButtons	equ	23		; first button IDrCCancel	equ	23rCOK		equ	24rCSetPass	equ	25rDlg1Last	equ	25		; last ID I care aboutrConnString	equ	26		; "Connect to _server_ as:"rNameStr	equ	27rNameLE		equ	28rPassStr	equ	29rPassLE		equ	30rScrambled	equ	31		; the "(Scrambled)" stringrClearText	equ	32		; the "(Clear text)" stringrAlreadyConn	equ	33		; "Already connected to..."rNameStatText	equ	34		; user name as static text (*1);; Resource and control IDs for the volume list window;idVolList	equ	1		; control IDidNameOnly	equ	2idNameAndPass	equ	3idVQuit		equ	4idVOK		equ	5idVolMax	equ	5		; max control ID I care aboutrVolDlg		equ	40		; resource IDrSelStr		equ	41rVolList	equ	42rCheckedStr	equ	43rNameOnly	equ	44rNameAndPass	equ	45rVQuit		equ	46rVOK		equ	47;; Resource and control IDs for the volume password window;idVPOK		equ	1		; the OK buttonidVPCancel	equ	2		; the Cancel buttonidVPText1	equ	3		; "Enter a volume name..."idVPText2	equ	4		; "Password:"idVPLE		equ	5		; the line edit boxrVPDialog	equ	60;; Resource and control IDs for the set password window;rSetPassDlg	equ	80idSetPassCancel	equ	1		; Cancel buttonidSetPassOK	equ	2		; OK buttonidSetPassOld	equ	3		; old password line editidSetPassNew	equ	4		; new password line editidSPOldStat	equ	5		; old password as static text;; Resource IDs for AlertWindow messages;rBadAFPVers	equ	100rBadUAM		equ	101rTooManySess	equ	102		; PFI's tables are fullrServerBusy	equ	103		; too many people logged onrNoResponse	equ	104rBadPassword	equ	105rBadUserName	equ	106rShuttingDown	equ	107rNBPBusy	equ	108		; NBP busy errorrUnknownErr	equ	199rATInitWriteErr	equ	200rConfirmPass	equ	300		; please confirm new passwordrPassNoMatch	equ	301		; confirmation password didn't matchrOldPassBad	equ	302		; old password didn't workrCantChangePass	equ	303		; couldn't change password (AccessDenied)rNoAppleTalk	equ	400rOutOfMemory	equ	401rTooManyVols	equ	500rVolMiscErr	equ	501;; AFP command numbers, etc.;FPLogin		equ	18FPLoginCont	equ	19FPGetUserInfo	equ	37+$100		; has ThisUser bit setFPMapUserID	equ	$15+$100FPGetSrvrParms	equ	16FPChangePass	equ	36FILogContErr	equ	$0A04		; PFI's login continue errorFIAccessErr	equ	$0A07		; PFI's access deniedFITooManyVols	equ	$0A08FIUserNotAuth	equ	$0A15		; bad passwordFIParamErr	equ	$0A16		; bad user name or password expiredFIWasMounted	equ	$0A11		; volume was already mountedSPTooManyCalls	equ	$0702NBPBusy		equ	$0408		; NBP too many processes;; Constants for using the Message Center;SrvrPassMsg	equ	$0044		; message number for server passwordsVolPassMsg	equ	$0046		; message number for volume passwords;======================================================================;; Parameter block definitions;;======================================================================GetFSTInfoRec	record	0pCount		ds.w	1fstNum		ds.w	1fileSysID	ds.w	1fstName		ds.l	1	; result buffer for FST nameversion		ds.w	1attributes	ds.w	1blockSize	ds.w	1maxVolSize	ds.l	1maxFileSize	ds.l	1		endrGetUserPathRec	record	0pCount		ds.w	1fstID		ds.w	1cmd		ds.w	1prefixPtr	ds.l	1		endrCreateGSRec	record	0pcount		ds.w	1path		ds.l	1access		ds.w	1type		ds.w	1auxtype		ds.l	1		endrOpenGSRec	record	0pcount		ds.w	1refnum		ds.w	1path		ds.l	1reqAccess	ds.w	1		endrGetEOFGSRec	record	0pcount		ds.w	1refnum		ds.w	1eof		ds.l	1		endrSetMarkGSRec	record	0pcount		ds.w	1refnum		ds.w	1base		ds.w	1displacement	ds.l	1		endrReadGSRec	record	0pcount		ds.w	1refnum		ds.w	1buffer		ds.l	1reqCount	ds.l	1transCount	ds.l	1		endrCloseGSRec	record	0pcount		ds.w	1refnum		ds.w	1		endrATGetInfoRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1compReturn	ds.l	1thisNet		ds.w	1aBridge		ds.b	1hardwareID	ds.b	1romVers		ds.w	1nodeNumber	ds.b	1		endrGetZoneList2Rec	record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1bufferLen	ds.w	1bufferPtr	ds.l	1startIndex	ds.w	1retryInterval	ds.b	1retryCount	ds.b	1zonesReturned	ds.w	1zipWork		ds.l	1reserved	ds.l	1		endrGetMyZoneRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1bufPtr		ds.l	1retryInterval	ds.b	1retryCount	ds.b	1reserved	ds.l	1		endrLookupNameRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1entity		ds.l	1retryInterval	ds.b	1retryCount	ds.b	1reserved	ds.w	1bufLen		ds.w	1bufPtr		ds.l	1maxMatch	ds.b	1actMatch	ds.b	1		endrNBPKillRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1parmPtr		ds.l	1		endrFILogin2Rec	record	0async		ds.b	1command		ds.b	1result		ds.w	1srvrAddr	ds.l	1		; net, node, socketbufLen		ds.w	1bufPtr		ds.l	1replyBufLen	ds.w	1replyBufPtr	ds.l	1sessRefNum	ds.b	1attnRoutine	ds.l	1serverName	ds.l	1		; pointer to server name (PString)zoneName	ds.l	1		; pointer to zone name (PString)afpVersion	ds.w	1		endrFILoginContRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1sessRefNum	ds.b	1bufLen		ds.w	1bufPtr		ds.l	1replyBufLen	ds.w	1replyBufPtr	ds.l	1		endr		FIMountVolRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1sessRefNum	ds.b	1flags		ds.b	1volName		ds.l	1		; pointer to volume namevolID		ds.w	1unitNum		ds.b	1passwordPtr	ds.l	1		endrFIAccessRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1flags		ds.b	1rights		ds.l	1		; the access rights themselvespath		ds.l	1		; points to pathnamecreator		ds.l	1		; points to creator namegroup		ds.l	1		; points to group name		endrFILogoutRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1sessRefNum	ds.b	1		endrSPGetStatusRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1srvrAddr	ds.l	1		; net, node socketbufLen		ds.w	1bufPtr		ds.l	1actLen		ds.w	1		; actual length returned		endrSPCommandRec	record	0async		ds.b	1command		ds.b	1result		ds.w	1completion	ds.l	1sessRefNum	ds.b	1bufLen		ds.w	1bufPtr		ds.l	1replyBufLen	ds.w	1replyBufPtr	ds.l	1cmdResult	ds.l	1		; ASP client's (AFP's) resultreplyLen	ds.w	1		; actual reply length		endrExtTaskRec	record	0wmWhat		ds.w	1wmMessage	ds.l	1wmWhen		ds.l	1wmWhere		ds.l	1wmModifiers	ds.w	1wmTaskData	ds.l	1wmTaskMask	ds.l	1wmLastClickTick	ds.l	1wmClickCount	ds.w	1wmTaskData2	ds.l	1wmTaskData3	ds.l	1wmTaskData4	ds.l	1wmLastClickPt	ds.l	1		endr		;======================================================================;; Data types used by the auto-logon code (and in AppleShare.Prep);; The format of the AppleShare.Prep file is a word, srvrCount, followed; by srvrCount instances of a ServerInfoRec.  After each ServerInfoRec; are volCount VolInfoRec structures (volCount is the last field of; a ServerInfoRec).;; For the serverFlags field:;	$8000 = save my name only (i.e. ask for server and volume passwords);; For the volFlags field:;	$8000 = volume has a password;	$4000 = volume is a user volume;;======================================================================ServerInfoRec	record	0serverFlags	ds.w	1serverName	ds.b	32serverZone	ds.b	34userName	ds.b	32		; empty string means guestsrvrPassword	ds.b	8volCount	ds.w	1sizeof		endrVolumeInfoRec	record	0volFlags	ds.w	1volName		ds.b	28volPassword	ds.b	8sizeof		endr;======================================================================;; Macro definitions;;======================================================================		macro&lbl		ATCall	&parm&lbl		ldx	#<&parm		ldy	#^&parm		jsl	$E11014		endm;; PushLDP (Push Long Direct Page) -- Pushes 4 bytes onto the stack; from direct page using PEI instructions.  Like PushLong, but more; efficient.;		macro&lbl		pushldp	&parm&lbl		pei	&parm+2		; push high word first		pei	&parm		; push low word		endm;; PStr -- Defines a Pascal string (i.e. with a leading length byte); independent of the current mode of the STRING directive.;		macro&lbl		pstr	&parm		lclc	&ss&ss		setc	&setting('STRING')		string	pascal&lbl		dc.b	&parm		string	&ss		endm;; GStr -- Defines a GS/OS string (i.e. with a leading length word); independent of the current mode of the STRING directive.;; Note: The &len() operator counts the quotes around the string, too; so I have to subtract 2 to account for them.;		macro&lbl		gstr	&parm		lclc	&ss&ss		setc	&setting('STRING')		string	asis&lbl		dc.b	&len(&parm)-2,(&len(&parm)-2)/256,&parm		string	&ss		endm;----------; The following are "long" branch instructions.  They invert the; meaning of the original branch to branch around a BRL that goes; to the real address.  This way I don't have to make up funny; labels all the time.;----------		macro&lbl		beql	&parm&lbl		bne	*+5		brl	&parm		endm		macro&lbl		bnel	&parm&lbl		beq	*+5		brl	&parm		endm		macro&lbl		bvcl	&parm&lbl		bvs	*+5		brl	&parm		endm		macro&lbl		bccl	&parm&lbl		bcs	*+5		brl	&parm		endm		macro&lbl		bcsl	&parm&lbl		bcc	*+5		brl	&parm		endm		macro&lbl		bpll	&parm&lbl		bmi	*+5		brl	&parm		endm		macro&lbl		bmil	&parm&lbl		bpl	*+5		brl	&parm		endm