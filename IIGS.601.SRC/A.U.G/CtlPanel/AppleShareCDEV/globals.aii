;======================================================================;;			Globals.aii;; This file contains the global data used by the CDEV that must be; imbedded in the CDEV itself.;; 26-Aug-91 MSD	Changed the FILogin record to be an FILogin2 call.; 23-Sep-91 MSD	Added new variable, saveNameOnly.  If the high bit is;		set, then SelectVols should default to Save My Name Only.; 4-Mar-93 DAL	Added AFPVersion21 and hasAFP21.;======================================================================		print	push,off		include	'E16.Control'		include	'AppleShareEqu.aii'		print	pop				export	(myID,myWindow,connWindow,setPassWind):data		export	(lastWhen,lastWhere,dblClick,lastZone):data		export	(zoneMembers,zoneListH):data		export	(GMZBuffer):data		export	(srvrListSize,srvrMembers,srvrListH):data		export	(taskRecord,userName,oldUserName):data		export	(windOrigin,volWindow,cryptKey):data		export	(volListH,volMembers):data		export	(norMask,dimMask,serverAddress):data		export	(whichWindow,whichControl):data		export	(whichPt,vOffset,itemNum):data		export	(checkBoxH,checkRect):data		export	(vpWindow,checkCount):data		export	(selectedUAM,serverPassword):data		export	(wereHosed,messageHandle):data						myID		dc.w	0		; my Memory Manager user IDmyWindow	dc.l	0		; will put my GrafPort herewereHosed	dc.w	0		; non-zero if fatal errormessageHandle	dc.l	0		; handle to message center datalastWhen	dc.l	0		; time of last mousedownlastWhere	dc.l	0		; last mousedown point (v,h)		dblClick	dc.w	0		; non-zero if we detected a double-clicklastZone	dc.w	0		; item number of last zone selectedzoneMembers	dc.l	0		; handle to member array of zone listzoneListH	dc.l	0		; handle to zone list controlsrvrMembers	dc.l	0		; handle to server list member arraysrvrListH	dc.l	0		; handle to server list controlsrvrListSize	dc.w	0		; number of items in server listvolListH	dc.l	0		; handle to volume list controlvolMembers	dc.l	0		; handle to volume list member arrayATGetInfo	record	export		dc.b	0,2		dc.w	0		dc.l	0		; completion routine return address		dc.w	0		; thisNet		dc.b	0		; aBridge		dc.b	0		; hardwareID		dc.w	0		; romVers		dc.b	0		; node number		endrGZL2		record	export		dc.b	0,$3C		; sync GetZoneList2		dc.w	0		; result		dc.l	0		; completion routine		dc.w	ZoneBufSize	; buffer size		dc.l	0		; buffer pointer		dc.w	1		; start index		dc.b	4,2		; retry count,interval		dc.w	0		; number of zones returned		dc.l	0		; zipWork (set to 0 on first call)		dc.l	0		; reserved		endrGMZBuffer	dcb.b	33,0		; my zone will be returned hereGetMyZone	record	export		dc.b	0,$1A		; sync GetMyZone		dc.w	0		; result		dc.l	0		; completion routine		dc.l	GMZBuffer	; buffer pointer		dc.b	2,4		; retry interval,count		dc.l	0		; reserved		endrLookupEntity	record	export		export	(LookupType,LookupZone):data		pstr	'='		; any objectLookupType	pstr	'AFPServer'	; type serverLookupZone	dcb.b	34,0		; room for zone name plus 1 extra					; byte to make it even length		endr		LookupName	record	export		dc.b	$80,$10		; async LookupName		dc.w	0		; result		dc.l	0		; completion routine		dc.l	LookupEntity	; entity		dc.b	4,$FF		; retry 255 seconds, every second		dc.w	0		; reserved		dc.w	SrvrBufSize	; buffer length		dc.l	0		; buffer pointer		dc.b	$FF		; max of 255 matches		dc.b	0		; actual matches		endrNBPKill		record	export		dc.b	0,$46		; sync NBPKill		dc.w	0		; result		dc.l	LookupName	; param block pointer		endr		windOrigin	dc.l	0connWindow	dc.l	0		; Connect as... window pointervolWindow	dc.l	0		; volume list window pointervpWindow	dc.l	0		; volume password dialogsetPassWind	dc.l	0		; set password dialogtaskRecord	ds	ExtTaskRecwhichWindow	dc.l	0		; result from FindWindowwhichControl	dc.l	0		; result from FindControlwhichPt		dc.l	0		; point during event hookvOffset		dc.w	0		; offset from top of list in pixelsitemNum		dc.w	0		; item number in listcheckBoxH	dc.l	0		; handle to check box controlcheckRect	dc.w	0,0,0,0		; rectangle where check boxes livecheckCount	dc.w	0		; number of checkboxes checkedserverAddress	dc.l	0		; address of server we're connecting toselectedUAM	dc.w	0		; 0 = cancelled, 1 = Guest,					; 2 = ClearText, 3 = RandNumExchangeuserName	ds.b	34		; Str32 and terminating zero byteoldUserName	ds.b	34serverPassword	ds.b	10		; 8 bytes plus length and zero bytesubText		record	export		dc.l	0		; point to "*0" (server name)		dc.l	userName	; for *1		dc.l	0		; fill in with pointer to volume name		endrcryptKey	dc.b	$5A,$2F,$42,$2B,$E2,$34,$BA,$5DdimMask		DC.B	$55,$AA,$55,$AA,$55,$AA,$55,$AAnorMask		DC.B	$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FFcheckBoxTempl	record	export		dc.w	8		; pCount		dc.l	100		; control ID		dc.w	0,0,0,0		; bounding rectangle		dc.l	$82000000	; procRef		dc.w	0		; flags, control visible		dc.w	fCtlProcRefNotPtr ; more flags, fCtlProcRefNotPtr		dc.l	0		; refcon		dc.l	emptyPStr	; title reference		dc.w	0		; initial valueemptyPStr	dc.b	0		; empty Pascal string		endrFSTInfo		record	export		dc.w	2		; only fstNum and fileSysID		dc.w	0		; fstNum		dc.w	0		; fileSysID		endrGetUserPath	record	export		dc.w	3		dc.w	$D		; AppleShare FST ID		dc.w	8		; get user path command		dc.l	0		; prefix pointer returned here		endrCreateGS	record	export		import	Path		dc.w	4		dc.l	Path		dc.w	$00C3		; access: everything		dc.w	$00E2		; file type = AppleTalk data file		dc.l	0		; auxtype		endrOpenGS		record	export		import	Path		dc.w	3		; through requestAccess		dc.w	0		; refnum returned here		dc.l	Path		dc.w	1		; only want to read		endrGetEOFGS	record	export		dc.w	2		dc.w	0		; refnum		dc.l	0		; EOF returned here		endrSetMarkGS	record	export		dc.w	3		dc.w	0		; refnum		dc.w	1		; base = EOF - displacement		dc.l	133		; offset for ATInit name		endrReadGS		record	export		dc.w	4		dc.w	0		; refnum		dc.l	userName	; buffer		dc.l	33		; request count		dc.l	0		; actual transfer count returned here		endrCloseGS		record	export		dc.w	1		dc.w	0		; refnum		endr;======================================================================;; Data structures used to actually log on and mount volumes.;;======================================================================cmdBufSize	equ	512replyBufSize	equ	512		export	(cmdBuf,replyBuf):datacmdBuf		ds.b	cmdBufSizereplyBuf	ds.b	replyBufSize; This is actually an FILogin2 parameter block... (26-Aug-91 MSD)FILogin		record	export		dc.b	0,$38		; sync FILogin2		dc.w	0		dc.l	0		; put internet address here		dc.w	cmdBufSize		dc.l	cmdBuf		dc.w	replyBufSize		dc.l	replyBuf		dc.b	0		; sessRefNum returned here		dc.l	0		; use default attention routine		dc.l	0		; pointer to server name		dc.l	LookupZone	; pointer to zone name		dc.w	$0200		; AFP version 2.0 or 2.1 (modified)		endrFILoginCont	record	export		dc.b	0,$2C		dc.w	0		dc.b	0		; put sessRefNum here		dc.w	12		; FPLoginCont command size		dc.l	cmdBuf		dc.w	replyBufSize		dc.l	replyBuf		endrFIMountVol	record	export		import	(volPath,volPassword):data		dc.b	0,$2E		dc.w	0		dc.b	0		; put sessRefNum here		dc.b	0		; put mount flag here		dc.l	volPath		; put pointer to volume pathname here		dc.w	0		; volID returned here		dc.b	0		; unitNum returned here		dc.l	volPassword+1	; put pointer to volume password here		endrFIAccess	record	export		import	volPath:data		dc.b	0,$32		dc.w	0		dc.b	0		; put flags here (0=get rights only)		dc.l	0		; access rights set or returned here		dc.l	volPath		; path pointer		dc.l	0		; creator pointer		dc.l	0		; group pointer		endr		FILogout	record	export		dc.b	0,$2D		dc.w	0		dc.b	0		; put sessRefNum here		dc.b	0		; extra byte so I can store a word		endrSPGetStatus	record	export		dc.b	0,$1D		dc.w	0		dc.l	0		dc.l	0		; put server internet address here		dc.w	replyBufSize		dc.l	replyBuf		dc.w	0		; actual length returned here		endrSPCommand	record	export		dc.b	0,$20		dc.w	0		dc.l	0		dc.b	0		; put sessRefNum here		dc.w	0		; put command length here		dc.l	cmdBuf		dc.w	replyBufSize		dc.l	replyBuf		dc.l	0		; AFP result returned here		dc.w	0		; actual reply length returned here		endr		GetSrvrParms	record	export		dc.b	0,$20		; really an SPCommand		dc.w	0		dc.l	0		dc.b	0		; put sessRefNum here		dc.w	1		; FPGetSrvrParms is only 1 byte		dc.l	getSrvrParmsCmd	; point to this command only		dc.w	VolBufSize		dc.l	0		; put volume buffer pointer here		dc.l	0		; AFP result returned here		dc.w	0		; actual reply length returned here		getSrvrParmsCmd	dc.b	FPGetSrvrParms	; command packet		endr				export	(GuestUAM,ClearTextUAM,ScrambledUAM,AFPVersion20,AFPVersion21):dataGuestUAM	pstr	'No User Authent'ClearTextUAM	pstr	'Cleartxt passwrd'ScrambledUAM	pstr	'Randnum exchange'AFPVersion20	pstr	'AFPVersion 2.0'AFPVersion21	pstr	'AFPVersion 2.1'	;added 4-Mar-93 DAL		export	(hasGuest,hasClearText,hasScrambled,hasChgPwd):datahasGuest	dc.w	0		; non-zero if Guest supportedhasClearText	dc.w	0		; non-zero if ClearText supportedhasScrambled	dc.w	0		; non-zero if Randnum Exchange supportedhasChgPwd	dc.w	0		; non-zero if Set Password supported		export	(hasAFP20,hasAFP21,alreadyConn,mountFlag):datahasAFP20	dc.w	0		; non-zero if AFP 2.0 supportedhasAFP21	dc.w	0		; non-zero if AFP 2.1 supported (added 4-Mar-93 DAL)alreadyConn	dc.w	0		; non-zero if already connectedmountFlag	dc.w	0		; mount flag for FIMountVol		export	(numVols,volPassword,volPath,volsMounted):datanumVols		dc.w	0		; number of volumes in listvolPassword	ds.b	10		; zero-terminated PStringvolPath		ds.b	34		; 31 chars+slash+length bytevolsMounted	dc.w	0		; non-zero if volumes already mounted		export	(SystemSetup,SetupFolder,ATInit,ASharePrep,Path):dataSystemSetup	gstr	'*:System:System.Setup:'SetupFolder	gstr	':Setup:'ATInit		gstr	'ATInit'ASharePrep	gstr	'AppleShare.Prep'Path		ds.b	80		; maximum length should be 74 bytes		export	emptyStr:dataemptyStr	dc.b	0		; empty Pascal string		export	(prepHandle,serverInfo,volInfo,prepChange,prepDirty,serverCount):dataprepHandle	dc.l	0		; handle to AppleShare.Prep dataserverInfo	ds	ServerInfoRecvolInfo		ds	VolumeInfoRecprepChange	dc.w	0		; non-zero if AppleShare.Prep info changed for this serverprepDirty	dc.w	0		; non-zero if AppleShare.Prep needs to be writtenserverCount	dc.w	0		; number of servers in AppleShare.Prep		export	saveNameOnly:datasaveNameOnly	dc.w	0		end