##############################################################															##	File:			SetStart.make							##	Version:		1.0										##	Author:			Greg Branche							##	Copyright:		(c) 1989 by Apple Computer, Inc.		##															##	Description:	This file contains the commands needed	##					to build the SetStart CDEV for the IIgs	##															##	Based on the example shell CDEV by Darryl Lovato		##															##-----------------------------------------------------------##															##	Development History:									##															##	Who		Date		The Modification					##	---		--------	----------------					##	GAB		05/12/89	Created the file					##	GAB		06/07/89	Added dependencies for START		##															##############################################################all				ÄÄ	SetStart StartSetStart		ÄÄ	SetStartcode SetStart.r	RezIIgs SetStart.r -o SetStart -t "C7  " -c "pdos"SetStart.p.obj		Ä	SetStart.p	PascalIIgs SetStart.p -o SetStart.p.objSetStart.aii.obj	Ä	SetStart.aii SetStart.mac	AsmIIgs SetStart.aii -o SetStart.aii.objOpenFile.obj		Ä	OpenFile.aii	AsmIIGS OpenFile.aii -o OpenFile.objSetStartcode		Ä	SetStart.p.obj SetStart.aii.obj OpenFile.obj	LinkIIgs -w2 -x ¶		-lib "{PIIGSLibraries}PLib" ¶		-lseg SetStart:$1000 ¶			SetStart.p.obj ¶			SetStart.aii.obj ¶			OpenFile.obj ¶			"{PIIGSLibraries}PLib"(@main,@PLib,@~globals) ¶		-o SetStartcode ¶		-l >setstart.map#########################################################################Start			ÄÄ	Startup.aii.obj	LinkIIGS -o Start -t S16 -at $DB03 Startup.aii.objStartup.aii.obj	Ä	Startup.aii SetStart.mac	AsmIIGS Startup.aii -o Startup.aii.obj