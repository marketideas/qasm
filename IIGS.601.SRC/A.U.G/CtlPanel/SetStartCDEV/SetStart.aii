*******************************************************************************************;#								#;#	File:			SetStart.aii			#;#	Version:		1.0				#;#	Author:			Greg Branche			#;#	Copyright:		(c) 1989-1993			#;#				Apple Computer,	Inc.		#;#				All Rights Reserved		#;#								#;#	Description:	This file contains the assembler needed	#;#			by the SetStart	CDEV on	the IIGS.	#;#								#;#	Based upon the example shell CDEV by Darryl Lovato	#;#								#********************************************************************************************* Revision History** 6.0**	Who		Date		The Modification*	---		--------	----------------*	GAB		05/12/89	Created	the file********************************************************************************************** Begin 6.0.1** 29-Oct-92 DAL*   Added checkboxes (programmer CDAs; show boot icons)** 15-Jan-93 DAL*   Added code in doBoot to initialize location $59 (programmer CDAs) to $00 if there*   is a $FF there.********************************************************************************************		blanks	off		string	asismaxNameLen	equ	20		;maximum length	of name	in menu, must be evenbootname	Proc		dc.b	'=='		dcb.b	maxNameLen,$20		dc.b	'\H'		dc.w	2		dc.b	$0d		dc.b	'.'		endp;################################################################;#								#;# Variables used by the CDev					#;#								#;################################################################myVars		RecordfileSelected		ds.w	1CtlHndl		ds.l	1		export	goodInitgoodInit	ds.w	1ownerID		ds.w	1dPageHndl	ds.l	1pfx0		ds.l	1pfx8		ds.l	1SFActive	ds.w	1nullPfx		dc.w	0		;looks like a null prefixparmBlockpCount		dc.w	0prefixNum	dc.w	0bufPtr		dc.l	0eofParms	dc.w	2		;pCounteof_refnum	dc.w	0file_length	dc.l	0readParms	dc.w	4		;pCountread_refNum	dc.w	0read_buff	dc.l	0read_count	dc.l	0read_xfer	dc.l	0closeParms	dc.w	1		;pCountclose_refNum	dc.w	0createParms	dc.w	5		;pCountcr_path		dc.l	0		;pathnamecr_access	dc.w	%0000000011100111 ;access (invisible)cr_filetype	dc.w	$5A		;filetypecr_auxtype	dc.l	4		;auxtypecr_storage	dc.w	0		;storage type (standard	file)set_eof_parms		dc.w	3		;pCountset_eof_refnum		dc.w	0		dc.w	0		;base		dc.l	0		;displacement		endr;################################################################;#								#;#	Various	procedures for the Pascal CDEV shell		#;#		(done in assembly since	I don't like Pascal!)	#;#								#;################################################################		include	'SetStart.mac'		seg	'main';################################################################;#								#;#	getMenuName procedure					#;#								#;#	This procedure accepts a pointer to a word-length	#;#	pathname string	and builds a string suitable for	#;#	insertion into a menu.	The pointer to the string is	#;#	passed as a parameter on the stack, and	the menu string	#;#	is built in the	buffer named bootname.			#;#	The string pointer is removed from the stack prior	#;#	to returning to	the caller (Pascal protocol)		#;#								#;################################################################getMenuName	procstrPtr		equ	$03		tsc			;make local direct page		phd		tcd		lda	#'='+('='<<8)	;initialize menu string		sta	bootname		ldy	#maxNameLen	;clear new menu	item string to blanks		lda	#' '+(' '<<8)@clear		sta	bootname,y		dey		dey		bne	@clear		lda	[strPtr]	;get length of complete	pathname		tay			;put into Y register		iny			;adjust	for length word		iny		sep	#$20		;8-bit accumulator		longa	off		lda	#':'		;look for pathname separator@loop		dey		cmp	[strPtr],y	;look at character		bne	@loop		;(there's got to be at least 1 separator)		rep	#$20		;back to 16-bit	accumulator		longa	on		tya			;get offset to filename	separator		sec		sbc	[strPtr]	;calculate length of filename		eor	#-1		;(two's compliment math)		inc	a		inc	a		;bump past separator		tax			;save length of	filename in X for a bit		tya			;get offset to filename	separator again		clc		adc	strPtr		;adjust	pointer		sta	strPtr		;to separator character		lda	strPtr+2		adc	#0		sta	strPtr+2		sep	#$20		;8-bit accumulator again		longa	off		cpx	#maxNameLen+1	;filename too long?		bcc	good_len	;no...		ldy	#maxNameLen/2	;else must shrink the name to fit@loop2		lda	[strPtr],y	;copy the first	6 characters		sta	bootname+1,y		dey		bne	@loop2		lda	#'É'		;then pop in an	elipsis		sta	bootname+(maxNameLen/2+2)		txy			;set pointer to	end of name		ldx	#maxNameLen/2-1	;copy 5	characters from	end of name@loop3		lda	[strPtr],y		sta	bootname+(maxNameLen/2+2),x		dey		dex		bne	@loop3		bra	menu_set_up	;menu string's all set up now, go insert itgood_len		txy			;put count into	Y@loop		lda	[strPtr],y	;copy filename to menu string		sta	bootname+1,y		dey		bne	@loopmenu_set_up		rep	#$20		;back to long accumulator		longa	on		pld			;restore original direct page		pla			;remove	parameter by moving return address up		sta	3,s		;over it (only a 2 byte	return address here)		pla		rts		endp;################################################################;#								#;#	openStdFile procedure					#;#	used to	start up the Standard File toolset		#;#								#;#	returns	carry set if the operation fails		#;#								#;################################################################openStdFile	proc		with	myVarstmpPtr		equ	1		pha			;make space for	temp pointer		pha		tsc		phd		tcd		stz	SFActive	;initialize variable		pha			;space for returned result		_SFStatus		;check for StdFile active		pla		bcs	must_load	;must load the toolset		sta	SFActive	;save status for shutdown later		bne	is_active	;function returned TRUE, StdFile already activemust_load		pea	23		;load tool023 (StdFile)		pea	$0300		;must be at least version 3.0		_LoadOneTool		;load the tool		bcc	load_ok		;so far, so good		pha			;space for result		pea	%0000000000000110 ;alertFlags (alertStrRef is a resource ID)		lda	#0		pha			;subStrPtr (not	used)		pha		pha			;resource ID for AlertWindow		pea	3		_AlertWindow		;make the alert	window		bra	errExitload_ok		pha			;make space for	newhandle call		pha		pea	0		;size of block to create		pea	256		;(one page)		lda	ownerID		pha		pea	%1100000000010101 ;attributes (locked, noMove, noCross,pageAligned,fixedBank		pea	0		;put in	bank 0 (direct page)		pea	0		_NewHandle		pla			;retrieve handle		sta	dPageHndl		sta	tmpPtr		pla		sta	dPageHndl+2		sta	tmpPtr+2		bcc	start_it		lda	#0		pha			;oops!	put up an ErrorWindow		pha			;subString type	(not used)		pha			;subStringPtr (not used)		pha		pea	$8D		;"Memory is full"		_ErrorWindowerrExit		pla			;retrieve button number		sec		bra	exit		;then just exitstart_it		lda	ownerID		;set up	for SFStartup call		pha		lda	[tmpPtr]	;dereference handle to get address of DPage		pha		_SFStartUpis_active		clcexit		pld		pla		pla		rts		endp;################################################################;#								#;#	closeStdFile procedure					#;#	used to	shutdown the Standard File toolset IF we	#;#	started	it up						#;#								#;################################################################closeStdFile	proc		with	myVars		lda	SFActive	;was StdFile active before we took control?		bne	leave_active	;yes, so leave it active		_SFShutDown		;shut down Standard File		lda	dPageHndl+2	;deallocate StdFile direct page		pha		lda	dPageHndl		pha		_DisposeHandle		pea	23		;then unload the tool		_UnloadOneToolleave_active		rts		endp;################################################################;#								#;#	loadResource procedure					#;#	loads the start	pathname and returns a handle		#;#	in X and Y						#;#								#;################################################################loadResource	proc		Import	fileID		with	myVarsrHndl		equ	1		pha			;make space for local handle		pha		tsc		phd			;save caller's direct page		tcd			;make local direct page; GetEOF to determine size of pathname		lda	fileID		sta	eof_refnum		sta	read_refnum		jsl	$E100A8		;call GS/OS		dc.w	$2019		;to get	the file's length		dc.l	eofParms		bcs	no_data; calculate size of memory block required		lda	file_length		sta	read_count		tax			;save in X too		lda	file_length+2		sta	read_count+2		tay		ora	file_length	;is there anything in the file?		beq	no_data		;no...; NewHandle a memory block		pha			;result	space		pha		phy			;blocksize		phx		pha			;get our userID		ldx	#$0202		;MMStartup		jsl	$E10000		;(leave	result on stack)		pea	%0000000000010000 ;attributes(locked, nocross)		lda	#0		pha			;location pointer		pha		_NewHandle		plx			;retrieve handle		ply		bcs	no_data		;exit on error		stx	rHndl		sty	rHndl+2; Read the string into Handle		ldy	#2		;deref		lda	[rHndl],y		tax		lda	[rHndl]		sta	read_buff		stx	read_buff+2		jsl	$E100A8		;call GS/OS		dc.w	$2012		;to read the file		dc.l	readParms		bcc	all_doneno_data		sec			;signify errorall_done	pld			;restore caller's direct page		plx			;return	handle		ply		rts		EndP;################################################################;#;#	doRect(rectPtr) procedure;#;# Replaces Pascal code:;#;#	if Not doInit then	{ save the current default prefix & check for STDFile };#	  RectPtr(data1)^.bottom := 32;;#;# and then also adjusts the rectangle height to include one;# or two new checkboxes:;#;#     Start up with: [Finder     v];#     [x] Show startup icons;#     [x] Enable programmer CDAs;#;################################################################doRect		proc export		import doInit		phd		tsc		tcd@rect		equ	 6	;1-2=DP, 3-5=RTL, 6-9=rect ptr		pha		;space for function result		jsl	doInit		pla		bne	@initOkay		lda	#32		bra	@setHeight@initOkay	; Check for ROM 3 w/ Control Panel jumper set--only show top checkbox		pha		pha		pha		pha		;space for results		pha		pha		pha		;A, X, Y (who cares)		pea	$FE1F		_FWEntry		ply		;Y value		plx		;X value		pla		;A value		pla		;P value		cpy	#3	;Is this ROM 3?		bne	@FullSize		pushlong #IsPanelActive		pushlong #ReadLocation		pea $0009	;read location and store result at IsPanelActive		_ReadKeyMicroMemory			lda	>IsPanelActive		and	#$0040	;save bit 6 (jumper active)		beq	@FullSize		lda	#34	;height with one checkbox		bra	@setHeight@fullSize	lda	#47	;height with both checkboxes@setHeight	ldy	#4	;bottom of rect		sta	[<@rect],y		pld		lda 2,s		;pull rect ptr from stack		sta 2+4,s		lda 1,s		sta 1+4,s		pla		pla		rtlReadLocation	dc.l $00E8	;key micro $E8 bit 6 has control panel jumperIsPanelActive	dc.w 0		endp;################################################################;#								#;#	doInit function						#;#	called during init to save the current GSOS prefix	#;#	and load Standard File if it's not already loaded	#;#								#;#	Returns	'True' if all goes well, 'False' if something	#;#	wierd happens.						#;#								#;################################################################doInit		proc	export		Import getPfx		with	myVarsretValue	equ	$9tmpPtr		equ	$1		phb			;save current DBR		phk		plb		pha			;make space for	temp pointer		pha		tsc		phd		tcd		stz	retValue	;init return value (assume the worst)		pha			;space for ID		pea	$5000		;ID type = DA		_GetNewID		pla			;get the ID		sta	ownerID		lda	#0		;go get	prefix 0		jsr	getPfx		bcs	exit		;error occurred		stx	pfx0		sty	pfx0+2		lda	#8		;and prefix 8		jsr	getPfx		bcs	exit		;error occurred		stx	pfx8		sty	pfx8+2		inc	retValue	;the world is fine, return TRUEexit		lda	retValue	;copy return value to global variable		sta	goodInit		pld			;restore original direct page		pla			;remove	extra space from stack		pla		plb			;restore DBR		rtl		endp;################################################################;#								#;#	getPfx - retrieves current prefix for the supplied	#;#	prefix number.	The handle to the stored prefix	is	#;#	returned to the	caller.					#;#								#;#	on entry:						#;#		Acc = prefix number				#;#								#;#	on exit:						#;#		X, Y = handle of stored	prefix (low,high)	#;#								#;################################################################getPfx		Proc		with	myVarstmpPtr		equ	$01pfxHndl		equ	$05		;handle	to stored prefix		sta	prefixNum	;put prefix number in parmblock	(for later)		pha			;make space for	temp pointer		pha		pha			;and prefix handle		pha		tsc			;make stack frame		phd		tcd		pha			;make space for	NewHandle call		pha		pea	0		;size of block to create		pea	256		;we'll try 256 bytes at first		lda	ownerid		;put our ID on the stack		pha		pea	%1000000000010000 ;attributes		pea	0		;location pointer		pea	0		;(not used)		_NewHandle		;go get	some memory		pla			;retreive handle		plx		bcc	got_memmemerr		lda	#0		pha			;oops!	put up an ErrorWindow		pha			;subString type	(not used)		pha			;subStringPtr (not used)		pha		pea	$8D		;"Memory is full"		bra	showErrgot_mem		sta	pfxHndl		;save for return to caller		stx	pfxHndl+2		ldy	#2		;dereference handle		lda	[pfxHndl]		sta	tmpPtr		sta	bufPtr		lda	[pfxHndl],y		sta	tmpPtr+2		sta	bufPtr+2		lda	#256		;initialize length of buffer		sta	[tmpPtr]		lda	#2		;set up	parm block		sta	pCount		;prefixNum set up abovetry_again		_GetPrefixGS parmBlock	;get the current prefix		bcc	got_prefix	;no error, continue		cmp	#$4f		;buffer	too small?		beq	grow_buf	;yes, grow the buffer and try again		pha			;else just puke!		pea	0		;subString type	(not used)		pea	0		;subStringPtr (not used)		pea	0		pha			;put error code	on stackshowErr		_ErrorWindow		pla			;retrieve button number		sec			;we had	a problem		bra	exit		;just exitgrow_buf		ldy	#2		lda	[tmpPtr],y	;get returned length word		clc		adc	#4		;allow for length words		pha			;save new length on stack		pea	0		;high word of new size allocation		pha			;low word of length		pei	pfxHndl+2	;put handle on stack		pei	pfxHndl		ldy	#4		;unlock	the handle first		lda	[pfxHndl],y		and	#$7FFF		sta	[pfxHndl],y		_SetHandleSize		;make the block	bigger		bcs	memerr		;abort on error		ldy	#4		;lock it down again		lda	[pfxHndl],y		ora	#$8000		sta	[pfxHndl],y		ldy	#2		;dereference handle again		lda	[pfxHndl]		sta	tmpPtr		sta	bufPtr		lda	[pfxHndl],y		sta	tmpPtr+2		sta	bufPtr+2		pla			;retrieve new length of	buffer		sta	[tmpPtr]	;store in buffer		bra	try_again	;go try	againgot_prefix		ldy	#4		;unlock	the handle		lda	[pfxHndl],y		and	#$7FFF		sta	[pfxHndl],y		pea	0		;high word of new size allocation		ldy	#2		lda	[tmpPtr],y	;get the length	of the returned	string		clc		adc	#4		;include length	words		pha			;put on	stack for call		pei	pfxHndl+2		pei	pfxHndl		_SetHandleSize		;resize	the handle so it's just the right size		ldy	pfxHndl+2	;return	handle to caller		ldx	pfxHndl		clc			;no errorexit		pld			;clean up stack	frame		pla		pla		pla		pla		rts		endp;################################################################;#								#;#	doClose	procedure					#;#	restores default prefix	to it's original setting	#;#	This is	called from the	close portion of the		#;#	Pascal CASE statement					#;#								#;################################################################doClose		proc	export		Import setPfx		with	myVars		phb			;save current DBR		phk		plb		tsc			;make stack frame		phd		tcd		lda	#8		;restore prefix	8		ldx	pfx8		ldy	pfx8+2		phy			;save on stack for DisposeHandle call		phx		jsr	setPfx		_DisposeHandle		;now dispose of	the memory		lda	#0		;restore prefix	0		ldx	pfx0		ldy	pfx0+2		phy			;save on stack for DisposeHandle call		phx		jsr	setPfx		_DisposeHandle		;now dispose of	the memory		lda	ownerID		;and our local ID		pha		_DeleteID		pld			;restore original direct page		plb			;restore DBR		rtl		endp;################################################################;#								#;#	setPfx - restore prefix	to it's original value		#;#								#;#	on entry:						#;#		Acc = prefix number				#;#		X,Y = handle to	stored prefix			#;#								#;################################################################setPfx		ProctmpPtr		equ	$01		with	myVars		sta	prefixNum	;save prefix number in parm block		pha			;make space on stack for temp pointer		pha		tsc			;make stack frame		phd		tcd		lda	#2		;2 parms for SetPrefix call		sta	pCount		stx	tmpPtr		sty	tmpPtr+2		ldy	#2		;dereference handle to prefix string		lda	[tmpPtr]	;but set pointer to length		clc			;word within buffer		adc	#2		sta	bufPtr		lda	[tmpPtr],y		adc	#0		sta	bufPtr+2		_SetPrefixGS parmBlock		pld			;clean up stack		pla		pla		rts		endp;################################################################;#								#;#	doBoot procedure					#;#		copies filename	resource within	data file	#;#		returns 0: operation proceeded			#;#			1: operation skipped at user's request	#;#								#;################################################################doBoot		func	export		Import	OpenFile,fileID		with	myVarsrHndl		equ	$01tmpPtr		equ	$05rtlAddr		equ	$09flag		equ	$0c		pha			;make room for local variables		pha		pha		pha		tsc			;make stack frame		phd		tcd*** added 15-Jan-93 DAL -- if BRAM location $59 is set to $FF, that's annoying; set it to zero		pha		pea $59		_ReadBParam		pla		cmp #$00ff		bne @iLike		pea 0		pea $59		_WriteBParam@iLike*** end 15-Jan-93		phb			;set DBR to our	memory		phk		plb		lda	#1		;assume we're gonna see the Apple key pressed		sta	[flag]		sep	#$20		;8-bit accumulator		lda	>$E0C025	;get keyboard modifiers	state		rep	#$20		;16-bit	accumulator		and	#%0000000010000000 ;open-apple key pressed?		bne	skip_it		;yup, just skip	the startup app		sta	[flag]		;don't draw an X through the icon		jsr	OpenFile	;go open the resource file		bcs	skip_it		;just skip it if an error occurs		jsr	loadResource	;go get	the pathname from the data file		bcs	skip_it2	;just forget it	then!		stx	rHndl		;store the returned handle		sty	rHndl+2		lda	[rHndl]		;deref		sta	tmpPtr		ldy	#2		lda	[rHndl],y		sta	tmpPtr+2		lda	[tmpPtr]	;get length of pathname		pha			;save on stack for a minute		clc		adc	#8		;+2 (length word) + 6 (header length)		pea	0		;always	<64K		pha			;new length		pei	rHndl+2		pei	rHndl		_SetHandleSize		;grow the handle		plx			;retrieve pathname length		bcs	skip_it2	;punt if there's no memory		pei	rHndl+2		;source	handle		pei	rHndl		ldy	#2		lda	[rHndl],y	;destination pointer		pha		lda	[rHndl]		clc		adc	#6		pha		pea	0		;always	<64K		inx			;+2 for	length word		inx		phx		_HandToPtr		;move pathname up in the handle		pea	1		;place the pathname in the message		pea	messageID	;my reserved message type		pei	rHndl+2		;handle	to message		pei	rHndl		_MessageCenterskip_it2		lda	fileID		;close the file		sta	close_refnum		jsl	$E100A8		;call GS/OS		dc.w	$2014		dc.l	closeParmsskip_it		lda	#2		;null out prefix 8		sta	pCount		lda	#8		sta	prefixNum		lda	#nullPfx>>16		sta	bufPtr+2		lda	#nullPfx		sta	bufPtr		_SetPrefixGS parmBlock	;set the prefix		lda	rtlAddr+1	;clean up stack frame		sta	flag+2		lda	rtlAddr		sta	flag+1		plb			;restore DBR		pld			;restore original direct page		tsc			;remove stuff from stack		clc		adc	#12		tcs		rtl		endf;################################################################;#								#;#	initMenu function					#;#	Inserts	filename in popup menu if a filename is		#;#	available.  This function returns the menu item		#;#	ID of the initial item to display.  1 if there		#;#	no filename currently selected,	or 2 if	there is.	#;#								#;################################################################initMenu	proc	export		Import	OpenFile,fileID		with	myVarsrHndl		equ	$01		;resource handlerPtr		equ	$05		;resource pointer (dereferenced	handle)controlH	equ	$0d		;control handle	passed from PascalretValue	equ	$11		;space for return value		phb			;put DBR on stack		tsc			;get stack pointer		sec		sbc	#8		;make room for temporary variables		tcs		phd			;save original direct page		tcd			;make local direct page		phk			;set to	our memory		plb		lda	#1		sta	fileSelected	;initialize our	flag to	initial	menu item		jsr	OpenFile	;open the data file		bcc	get_resource	;file opened, so go get	the resource		brl	no_file		;else just exitget_resource		jsr	loadResource	;get the pathname		bcc	got_resource		brl	skip_it		;if no resource, leave things as isgot_resource		stx	rHndl		;store the handle		sty	rHndl+2		ldy	#2		;dereference handle		lda	[rHndl]		tax		lda	[rHndl],y		pha			;put pointer to	string on stack		phx		jsr	getMenuName	;go build the menu string		lda	#2		;return	item number of selected	filename		sta	fileSelected		pha			;space for result		pha		_GetMenuBar		;get handle to current menu bar	and leave on stack		pei	controlH+2	;get handle to popup control		pei	controlH		_SetMenuBar		;make it the current menu bar		pea	bootname>>16	;insert	filename into menu		pea	bootname		pea	1		;insert	after first item		pea	1		;insert	into menu #1 (only one we have!)		_InsertMItem		pea	0		;remove	the checkmark from Finder		pea	1		_SetMItemMark		pea	18		;and put it with the selected filename		pea	2		_SetMItemMark		pea	0		;recalculate menu size		pea	0		pea	1		_CalcMenuSize		_SetMenuBar		;reset to original menu	barskip_it		lda	fileID		;must close the	file before exiting		sta	close_refnum		jsl	$E100A8		;call GS/OS		dc.w	$2014		dc.l	closeParmsno_file		lda	fileSelected	;return	the current setting		sta	retValue		pld			;restore original direct page		tsc			;remove	temporary variables from stack		clc		adc	#8		tcs		pla			;move return address up	over parameter		sta	3,s		pla		sta	3,s		plb		rtl		endp;; InitCheckBoxes;InitCheckBoxes	proc	export		import	CheckLocation,CheckBitMask,CheckNegateMask,CheckBoxIndex		phd		tsc		tcd		phb		phk		plbwindPtr		equ 6		ldx #0@nextOne	stx CheckBoxIndex		pha			;space for result		lda CheckLocation,x		pha		_ReadBParam		pla		ldx CheckBoxIndex		and CheckBitMask,x		eor CheckNegateMask,x		beq @zero		lda #1@zero		pha			;push new checkbox value		pei <windPtr+2		pei <windPtr		pea 0			;high word of ctlID		lda CheckBoxIndex		lsr a		adc #$00C1		;build $00C1 or $00C2		pha;		_SetCtlValueByID		ldx #$3c10		jsl $e10000		ldx CheckBoxIndex		inx		inx		cpx #4		bcc @nextOne		plb		pld		lda 2,s			;remove input ptr from stack		sta 2+4,s		lda 1,s		sta 1+4,s		pla		pla		rtl		EndP;################################################################;#								#;#	doSelect procedure					#;#	handles	a control hit by calling SFGetFile2 (if		#;#	an application should be selected), or by deleting	#;#	the pathname resource if the Finder is selected.	#;#								#;################################################################*** 29-Oct-92 DAL -- Added ctrlID parameter & checkbox supportdoSelect	proc	export		Import	OpenFile,fileID,fileName		with	myVarsctrlHndl	equ	$0f+4		;control handle	passed from PascalctrlID		equ	$0f		;control ID (added 29-Oct-92 DAL)retAddr		equ	$0b		;location of return address and	DBRmemHandle	equ	$07tmpVal		equ	$05tmpPtr		equ	$01		phb			;save DBR		tsc			;make stack frame		sec		sbc	#10		;make room for temp variables		tcs		phd		tcd		phk		plb			;set to	code bank*** 29-Oct-92 DAL -- check for checkboxes		lda	<ctrlID		and	#$FFF0		cmp	#$00c0		;checkboxes are ID=$00Cx		bne	open_it		jsr	HandleCheckbox		brl	exit*** end 29-Oct-92open_it		jsr	OpenFile	;go open the data file containing the resource		bcc	file_opened	;file opened just fine,	thank you		cmp	#$0046		;file not found	error?		bne	oops		;no, just punt		lda	#fileName	;else create the file		sta	cr_path		lda	#fileName>>16		sta	cr_path+2		jsl	$E100A8		;call GS/OS		dc.w	$2001		;to create the file		dc.l	createParms		bcc	open_it		;now that it's created, go open it					; else fall through and	report the erroroops		pha			;space for result		pea	%0000000000000110 ;alertFlags (alertStrRef is a resource ID)		pea	0		;subStrPtr (not	used)		pea	0		pea	0		;resource ID for AlertWindow		pea	1		_AlertWindow		;make the alert	window		pla			;remove	returned parameter		brl	show_filename	;then just exitfile_opened		lda	#8		;restore prefix	8 for Standard File		ldx	pfx8		ldy	pfx8+2		jsr	setPfx		pha			;space for result		pei	ctrlHndl+2		pei	ctrlHndl		_GetCtlValue		;get the control value		pla		dec	a		;make 0-3		asl	a		;make offset into jump table		tax		jsr	(itemTable,x)	;go to the necessary subroutineshow_filename		lda	fileSelected	;set the value to display the current setting		pha		pei	ctrlHndl+2		pei	ctrlHndl		_SetCtlValueclose_file		lda	fileID		;get the resource file ID		beq	exit		;if not	open, don't try to close it		sta	close_refnum		jsl	$E100A8		;close the data	file		dc.w	$2014		dc.l	closeParmsexit		lda	retAddr		;move return address up	in stack frame		sta	ctrlHndl		lda	retAddr+2		sta	ctrlHndl+2		pld			;restore original direct page		tsc			;clean up stack	frame		clc		adc	#18		tcs		plb			;remove	extra byte from	stack		rtl*** 29-Oct-92 DAL -- handle a checkbox (control ID in A; box already toggled)HandleCheckbox	lda	ctrlID		sec		sbc	#$00c1		;0=startup icons, 1=enable prog CDAs		asl	a		sta	checkBoxIndex		pha			;space for result		pei	<ctrlHndl+2		pei	<ctrlHndl		_GetCtlValue		pla		sta	checkValue		ldx	checkBoxIndex		lda	CheckLocation,x		pha			;space for result		pha			;location to read		_ReadBParam		pla		ldx	checkBoxIndex		and	CheckStripMask,x		ldy	checkValue		beq	@noOR		ora	CheckBitMask,x@noOR		eor	CheckNegateMask,x		pha			;value to write		lda	CheckLocation,x		pha			;Battery RAM location to write		_WriteBParam		rtscheckValue	dc.w 0			;nonzero if box is presently checked		export checkBoxIndexcheckBoxIndex	dc.w 0		export CheckLocation,CheckBitMask,CheckNegateMask*                    icons  CDAs*                    -----  ----CheckLocation	dc.w $005F,$0059CheckStripMask	dc.w $FFFD,$FF7FCheckBitMask	dc.w $0002,$0080CheckNegateMask	dc.w $0002,$0000	;reverse sense of the bit*** end 29-Oct-92itemTable	dc.w	finderItem	;used when 'Finder' menu item is selected		dc.w	do_nothing	;do nothing when application name is reselected		dc.w	current_app	;used when 'Current App' is selected		dc.w	selectItem	;used when 'Select AppÉ' is selectedfinderItem		lda	fileSelected	;was there an existing selection?		cmp	#1		beq	do_nothing	;no, just exit		lda	fileID		sta	set_eof_refnum		jsl	$E100A8		;call GS/OS		dc.w	$2018		dc.l	set_eof_Parms		bcs	to_error_window		pha			;space for result		pha		_GetMenuBar		;get current menu bar and leave	handle on stack		pei	ctrlHndl+2	;set current menu to our popup		pei	ctrlHndl		_SetMenuBar		pea	2		_DeleteMItem		;delete	the filename from the menu		pea	18		;put a checkmark on 'Finder'		pea	1		_SetMItemMark		pea	0		;recalculate menu size		pea	0		pea	1		_CalcMenuSize		_SetMenuBar		;reset to original menu	bar		lda	#1		;set internal variable		sta	fileSelecteddo_nothing		rts			;back to main blockto_error_window		brl	do_error_windowcurrent_app; This is where	we make	a GetName call,	and a GetPrefix	call on	prefix 9, concatenate the; two strings that we receive from the OS, and then perform a GetFileInfo call with the; resulting pathname to	make sure we can determine what	the currently executing	application; is.  If this fails, we put up	an AlertWindow letting the user	know that we can't figure; out what the current application is, and leave it set	to whatever it was set to before.; If the GetFileInfo call succeeds, we merge into the selectItem routine as if the user; had selected a file with StandardFile.		_GetNameGS nameParms	;do a GetName call		pha			;space for return value		pha		lda	appID		;application's ID returned from		pha			;  GetName		pea	1		;always	file #1		ldx	#$2211		;LGetPathname2		jsl	$E10000		;call the system loader		pla			;retrieve pointer		sta	tmpPtr		sta	infoName		pla		sta	tmpPtr+2		sta	infoName+2		bcs	no_can_do	;oops, can't get the app's pathname		_GetFileInfoGS infoParms ;make sure we can find	the file		bcc	found_app	;call succeeded, we've found the application!no_can_do		pha			;space for result		pea	%0000000000000110 ;alertFlags (alertStrRef is a resource ID)		pea	0		;subStrPtr (not	used)		pea	0		pea	0		;resource ID for AlertWindow		pea	2		_AlertWindow		;make the alert	window		pla			;remove	returned parameter		rtsfound_app		pha			;make space for	newhandle call		pha		pea	0		;size of block to create		lda	[tmpPtr]	;get length of pathname		inc	a		;allow for length word		inc	a		pha			;put on	stack		sta	tmpVal		;and save for a	bit		lda	ownerID		pha		pea	%1000000000011000 ;attributes (locked, noCross, noSpecialMemory)		pea	0		pea	0		_NewHandle		pla			;retrieve handle		sta	memHandle		pla		sta	memHandle+2		bcs	no_can_do	;if we can't get the memory		pei	tmpPtr+2	;put parms on stack		pei	tmpPtr		pei	memHandle+2		pei	memHandle		pea	0		;always	<64K		pei	tmpVal		_PtrToHand		;move the string into the handle		brl	_common_	;then go to common code	to save	everythingdo_nothing2		rts		Import sfFilterProcselectItem		jsr	openStdFile	;get standard file up and running		bcs	do_nothing2	;oops, just skip it		lda	#3		sta	nameVerb	;initalize verbs in reply record		sta	pathVerb		pha			;get the current screen	resolution		_GetMasterSCB		pla			;get the value		ldx	#120		;assume	640 mode		and	#%0000000010000000 ;check the resolution bit		bne	@640		;it's 640		ldx	#30		;else set up for 320 mode@640		phx			;then put X coordinate on stack		pea	30		;Y coordinate		pea	2		;verb -	resource ID of Pascal string		pea	0		;resource ID of	Pascal string		pea	75		pea	sfFilterProc>>16 ;pointer to filter proc		pea	sfFilterProc		pea	typelist>>16	;pointer to type list		pea	typelist		pea	replylist>>16	;pointer to reply list		pea	replylist		_SFGetFile2		;go get	the filename of	the application		jsr	closeStdFile	;now we	can shut it down again		lda	isGood		;did the user press cancel?		beq	do_nothing2	;yes, just show	the existing filename		lda	pathRef+2	;put handle into direct	page		sta	memHandle+2		lda	pathRef		sta	memHandle		ldy	#4		;lock the handle		lda	[memHandle],y		ora	#$8000		sta	[memHandle],y		ldy	#2		;dereference handle		lda	[memHandle],y		tax		lda	[memHandle]		clc		adc	#2		;set pointer to	length word of string		sta	tmpPtr		txa		adc	#0		sta	tmpPtr+2		pha			;put pointer on	stack		pei	tmpPtr		pei	memHandle+2	;put handle on stack		pei	memHandle		pea	0		;has to	be < 64K bytes		lda	[tmpPtr]	;get length of pathname		inc	a		;allow for length word		inc	a		sta	tmpVal		;save for a bit		pha			;put length of move on stack		_PtrToHand		;copy pathname down over buffer	length word		ldy	#4		;unlock	the block		lda	[memHandle],y		and	#$7FFF		sta	[memHandle],y		pea	0		;set to	new size		pei	tmpVal		pei	memHandle+2		pei	memHandle		_SetHandleSize		;shrink	the handle		lda	nameRef+2	;now delete the	filename handle		pha		lda	nameRef		pha		_DisposeHandle_common_		lda	fileID		sta	set_eof_refnum		jsl	$E100A8		;call GS/OS		dc.w	$2018		;SetEOF		dc.l	set_eof_parms		bcs	do_error_window		jsr	$E100A8		;then reset the	mark		dc.w	$2016		dc.l	set_eof_parms		bcs	do_error_window		lda	[memHandle]	;deref the handle		sta	read_buff	;set I/O buffer		ldy	#2		lda	[memHandle],y		sta	read_buff+2		pha			;result	space		pha		pei	memHandle+2		pei	memHandle		ldx	#$1802		;GetHandleSize		jsl	$E10000		pla		plx		bcs	skip		sta	read_count		stx	read_count+2		lda	fileID		sta	read_refNum		jsl	$E100A8		;call GS/OS		dc.w	$2013		;to write the pathname to the file		dc.l	readParms		bcc	all_okdo_error_window		ldx	#0		phx			;space for result		phx			;type of substitution string		phx			;pointer to substitution string	(none)		phx		pha			;error number		ldx	#$620e		;ErrorWindow		jsl	$E10000		pla			;remove	result from stack		secskip		bra	oops2all_ok		ldy	#2		;deref the pathname handle		lda	[memHandle],y		pha		lda	[memHandle]		pha		jsr	getMenuName	;go make a menu	string		pha			;space for result		pha		_GetMenuBar		;get current menu bar and leave	handle on stack		pei	ctrlHndl+2	;set current menu to our popup		pei	ctrlHndl		_SetMenuBar		pea	2		_DeleteMItem		;delete	the filename from the menu		pea	bootname>>16	;insert	filename into menu		pea	bootname		pea	1		;insert	after first item		pea	1		;insert	into menu #1 (only one we have!)		_InsertMItem		pea	0		;remove	the checkmark from Finder		pea	1		_SetMItemMark		pea	18		;and put it with the selected filename		pea	2		_SetMItemMark		pea	0		;recalculate menu size		pea	0		pea	1		_CalcMenuSize		_SetMenuBar		;reset to original menu	bar		lda	#2		;set our flag		sta	fileSelectedoops2		pei	memHandle+2		pei	memHandle		_DisposeHandle		;dispose of the	memory block		rts			;back to main block of codetypelist		dc.w	2		;allow only two	filetypes (SYS and S16)		dc.w	%1000000000000000 ;display SYS with any auxtype		dc.w	$ff		;SYS file		dc.l	0		dc.w	%1000000000000000 ;display S16 with any auxtype		dc.w	$b3		;S16 file		dc.l	0replylistisGood		dc.w	0		dc.w	0		;space for filetype		dc.l	0		;space for auxtypenameVerb	dc.w	3		;name verbnameRef		dc.l	0		;space for returned handlepathVerb	dc.w	3		;path verbpathRef		dc.l	0		;space for returned handlenameParms	dc.w	2		;parameter block for GetName call		dc.l	nameBufappID		ds.w	1		;space for application's user IDnameBuf		dc.w	36		;application name buffer for GetName callappName		dc.w	0		ds.b	32infoParms	dc.w	2		;parameter block for GetFileInfo callinfoName	dc.l	0		;space for name	pointeraccess		dc.w	0		;we don't really care, but this has to be here		endp;################################################################;#								#;#	sfFilterProc procedure					#;#	used by	SFGetFile2 call	to filter out certain files	#;#	(namely	ProDOS,	Start, and Finder)			#;#								#;################################################################sfFilterProc	ProctmpPtr		equ	1namePtr		equ	tmpPtr+2OrigDirect	equ	namePtr+4RTLAdr		equ	OrigDirect+2EntryPtr	equ	RTLAdr+3Result		equ	EntryPtr+4o_name		equ	$0a		; offset to filename		phd			; save caller's direct page		pha			; make space for name pointer		pha		pha			; make space for temp pointer		tsc		tcd		phb		phk		plb		lda	#2		; assume selectable		sta	Result		ldy	#o_name+2	;get pointer to	name buffer		lda	[EntryPtr],y		tax		dey		dey		lda	[EntryPtr],y		clc		adc	#2		;bump past buffer length word		bcc	@1		;to get	to string length word		inx@1		sta	namePtr		stx	namePtr+2		ldx	#-2		; index	into name tablecompare		rep	#$20		; make sure we've got 16-bit Acc		longa	on		inx			; move to next table entry		inx		lda	nameTable,x		beq	AllsOK		; end of table reached with no matches		sta	tmpPtr		lda	[namePtr]	; get the length of the	name		cmp	(tmpPtr)	; same length?		bne	compare		; no, can't match		inc	a		; account for high byte	of length word		tay			; into Y as index		sep	#$20		longa	offnameLoop		lda	[namePtr],y		and	#%11011111	; shift	to upper case		cmp	(tmpPtr),y		bne	compare		; no match, move to next name		dey		bne	nameLoopDimThisOne	rep	#$20		; we have a match		longa	on		stz	result		; don't even display this file		longa	offAllsOK		lda	RTLAdr+1		sta	RTLAdr+4+1		lda	RTLAdr		sta	RTLAdr+4		plb			; restore caller's DBR		pla			; remove name pointer		pla		pla			; remove temp pointer		pld			; restore direct register		pla			; remove passed	pointer		pla		rtl			; returnnameTable	dc.w	ProDOSName		dc.w	StartName		dc.w	FinderName		dc.w	0		; terminatorProDOSName	wstr	'PRODOS'StartName	wstr	'START'FinderName	wstr	'FINDER'		longa	on		ENDP		end