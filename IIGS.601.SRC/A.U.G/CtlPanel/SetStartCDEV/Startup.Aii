;------------------------------------------;; Equates from procedure;;------------------------------------------rHndl		equ	0strptr		equ	rHndl+4real_length	equ	strptr+4		INCLUDE	'SetStart.mac'startup		PROC	Export		phk		plb		ldx	#2				;reset infoParms pCount		stx	infoParms		pha					;make space for NewHandle call		pha		pea	0				;size of block to create		pea	256				;this ought to be enough		ora	#$0100				;alter auxID field		pha					;put our ID on the stack		pea	%0000000000010000		;attributes (noCross)		lda	#0		pha					;location pointer		pha					;(not used)		_NewHandle				;go get some memory		pla					;retrieve handle		plx		bcs	@skip_to_finder			;just skip it if there's not enough memory		stx	rHndl+2		sta	rHndl		pea	2				;action = getMessage		pea	messageID			;private message type		phx					;handle for retrieved message		pha		_MessageCenter				;go get the message		bcs	@skip_to_finder			;skip it if the message doesn't exist		ldy	#4				;lock the handle		lda	[rHndl],y		ora	#$8000		sta	[rHndl],y				ldy	#2		lda	[rHndl]				;dereference message handle		clc		adc	#6				;skip message header		sta	quitPath			;store into parmlist		sta	infoPath		sta	strptr		lda	[rHndl],y		sta	quitPath+2		sta	infoPath+2		sta	strptr+2				lda	#%1100000000000000		;initialize the quit flags		sta	quitFlags			; to place us on the quit stack		lda	#$8000				;set system preferences		sta	prefFlag			;(display Mount dialog)		_SetSysPrefsGS prefparms				_GetFileInfoGS infoparms		;ensure the file is there		php					;save status			stz	prefFlag			;reset system preferences		_SetSysPrefsGS prefparms		plp					;restore status from GetFileInfo call@skip_to_finder		bcs	do_finder			;had a problem, punt to the Finder		lda	[strptr]			;get length of pathname		sta	real_length			;save for a bit		tax					;into X temporarily		inx					;adjust for leading length word		sep	#$20				;8-bit accumulator		longa	off		ldy	#2				;get leading separator character		lda	[strptr],y		txy					;get indexor@loop		cmp	[strptr],y			;parse backwards looking for last		beq	@found				;  separator		dey		bne	@loop		bra	@skip_prefix			;impossible!@found		rep	#$20				;found end of pathname portion		longa	on		dey					;adjust final length		tya		sta	[strptr]			;store as length of prefix		stz	infoparms			;prefix # = 0		_SetPrefixGS pfxParms			;set the prefix		lda	real_length			;reset the original pathname length		sta	[strptr]@skip_prefix		rep	#$20				;make sure we're in 16-bit mode		longa	on		bra	do_quit				;now we can launch it		do_finder		stz	quitFlags			;fix flags for quitting to finder		lda	#fndr				;store pointer to pathname		sta	quitPath		sta	infoPath		lda	#fndr>>16		sta	quitPath+2		sta	infoPath+2		_GetFileInfoGS infoparms		;is the Finder available?		bcc	do_quit				;yes, we can 'quit' to it		stz	quitPath			;else null out the pathname pointer		stz	quitPath+2			; so GQuit will use the Program Launcherdo_quit		pea	3				;action = deleteMessage		pea	messageID			;private message type		phx					;handle (not used for delete)		pha		_MessageCenter		; ignore errors (doesn't matter if message didn't exist)		_quitGS	quitparms		brk			quitparms	DC.W	2quitPath	DC.L	fndrquitFlags	DC.W	%1100000000000000		pfxParms	dc.w	2				;pCount for SetPrefix callinfoparms	DC.W	2				;pCount for GetFileInfo call, prefix num for SetPrefixinfoPath	DC.L	0				;pathname pointer		DC.W	0				;access			prefparms	DC.W	1				;pCountprefFlag	DC.W	0				;preferencesfndr		wstr	'*:System:Finder'		ENDP		end