			include 'SetStart.mac'****************************************************************************************************** OpenFile - opens the SetStart CDev's data file (resource file, actually).  It has to determine* the correct location of the file first, depending on whether the machine has been booted up* from a local device or over a network.** This routine modifies prefix 8, without restoring it when done.*****************************************************************************************************OpenFile	Proc	Export			Import	fileID			stz		fileID			;init variable (file's not open yet)			_DInfoGS infoParms		;get the device name for the boot device			bcs		oops			_VolumeGS volParms		;now do a Volume call to get the ID of the boot FST			bcs		oops			lda		fst_id			;get the ID number of the boot FST			cmp		#$000D			;is it AppleShare?			bne		local_boot		;no, must have been a local bootaShare_boot			_FSTSpecificGS fstParms	;do an FSTSpecific GetUserPath call			bcs		oops			;punt if we can't determine the pathname of the user's folder			ldx		userPfx			;get the pointer to the prefix			ldy		userPfx+2			bra		do_setPfx		;go set the prefixlocal_boot			ldx		#localPfx		;get the pointer to the local prefix			ldy		#localPfx>>16do_setPfx			stx		prefix			;store the pointer to the prefix to use			sty		prefix+2			_SetPrefixGS pfxParms	;set the prefix to the correct location			bcs		oops			jsl		$E100A8			;call GS/OS			dc.w	$2010			;to open the file			dc.l	openParms			bcc		good			;if error, set fileID to 0			stz		fileIDoopsgood			rts						;return to caller, carry set if an error occurredinfoParms	dc.w	2				;pCount			dc.w	1				;device number (boot device is ALWAYS device 1)			dc.l	devName			;pointer to result buffer for device namedevName		dc.w	36				;buffer lengthdevName2	dc.w	0				;string length			ds.b	32				;buffer for device namevolParms	dc.w	5				;pCount			dc.l	devName2		;pointer to device name			dc.l	volname			;pointer to volume name buffer			dc.l	0				;total blocks			dc.l	0				;free blocksfst_id		dc.w	0				;FST ID numbervolname		dc.w	36				;buffer lengthvolname2	dc.w	0				;string length			ds.b	32				;string bufferfstParms	dc.w	3				;pCount			dc.w	$000d			;FST ID number (AppleShare)			dc.w	8				;command number (GetUserPath)userPfx		ds.l	1				;space for the prefix pointerpfxParms	dc.w	2				;pCount			dc.w	8				;prefix numberprefix		ds.l	1				;space for the prefix pointerlocalPfx	wstr	'*:System:'			Export	fileNamefileName	wstr	'8:SetStart.data'			Export	fileIDopenParms	dc.w	3				;pCountfileID		ds.w	1				;refNumpathname	dc.l	fileName		;pathname pointerrequestAccess dc.w	3				;open file for reading & writing			EndP			End