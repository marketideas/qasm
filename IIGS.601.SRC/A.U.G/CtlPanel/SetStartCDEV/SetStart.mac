 MACRO&lab _ReadBParam&lab ldx #$0C03     jsl $E10000 MEND MACRO&lab _WriteBParam&lab ldx #$0B03     jsl $E10000 MEND MACRO&lab _FWEntry&lab ldx #$2403     jsl $E10000 MEND MACRO&lab _ReadKeyMicroMemory&lab ldx #$0B09     jsl $E10000 MEND;............................................................;;        Push long (4 bytes) onto stack;;    pushlong address             - push contents of address;    pushlong address,x           - push contents of address,x;    pushlong const,s             - push contents of stack+const    ;    pushlong #address/const      - push address or constant;    pushlong [zeropage],offset   - push using indirect address;...............................................................	MACRO	pushlong &addr,&offset	IF &addr[1:1]='#' THEN		pea		&addr[2:255]>>16		pea		|&addr[2:255]	ELSEIF &addr[1:1]='[' THEN		ldy		#&offset+2		pushword &addr,y		ldy		#&offset		pushword &addr,y	ELSEIF &offset='s' THEN		pushword &addr+2,s		pushword &addr+2,s	ELSEIF &offset='' THEN		pushword  &addr+2		pushword  &addr	ELSE		pushword &addr+2,&offset		pushword &addr,&offset	ENDIF	MEND		MACRO		wstr	&string		lclc	&sset&sset	SETC &SETTING('STRING')		STRING ASIS		dc.w	(&len(&string)-2)			;must allow for string delimiters		dc.B	&string		STRING	&sset		MEND		MACRO&lab	_ResourceStartup&lab	ldx		#$021E		jsl		$E10000		MEND		MACRO&lab	_ResourceShutdown&lab	ldx		#$031E		jsl		$E10000		MEND		MACRO&lab	_DetachResource&lab	ldx		#$181E		jsl		$E10000		MEND		MACRO&lab	_LoadResource&lab	ldx		#$0E1E		jsl		$E10000		MEND		MACRO&lab	_OpenResourceFile&lab	ldx		#$0A1E		jsl		$E10000		MEND		MACRO&lab	_RemoveResource&lab	ldx		#$0F1E		jsl		$E10000		MEND		MACRO&lab	_CloseResourceFile&lab	ldx		#$0B1E		jsl		$E10000		MEND		MACRO&lab	_AddResource&lab	ldx		#$0C1E		jsl		$E10000		MEND		MACRO&lab	_QuitGS	&params&lab	jsl		$E100A8		DC.W	$2029		DC.L	&params		MEND		MACRO&lab	_GetNameGS &param