;;;	general - General CDEV.;;	Michael V. Stein	03/01/90.;;	© Apple, 1990.	blanks	off	;;	equates.aug_param  equ	$5e		 bit 0 set means no closed captioning				;bit 1 set means standard time				;      clear if daylight savings time				;bit 2 set means not to have auto daylight savings				;      clear means to have auto daylight savings				;bit 3 and 4 are the amount of menublink to have;;	include files.	include	'::cdev.h'	include	'::commonmacros.h'	include	'::dp.h'	include	'e16.control'	include	'e16.event'	include	'm16.control'	include	'm16.event'	include	'm16.font'	include	'm16.locator'	include	'm16.memory'	include	'm16.menu'	include	'm16.misctool'	include	'm16.quickdraw'	include	'm16.textedit'	include	'm16.util2'	include	'm16.window'	;;	main program.main	proc;;	imported addresses.	import	generalabout	import	generalabout2	import	generallist	import	gsmouse1menu	import	mouse1menu	import	mouseptr	import	trick	import	trick1			general	phb			save calling data bank	phk	plb			set our data bank		;	make room on stack for direct page.	tsc				sec				sbc	#dpsize		make room on stack for new direct page	tcs				phd			save the current direct page	tcd			new direct page	lda	message		cmp	#11			bcs	general1	if message defintely not handled			asl	a		times 2 into word table	tax			move into index reg	jsr	(t_cdev-2,x)	call the handler of this messagegeneral1  pld			restore direct page	tsc	clc	adc	#dpsize			tcs			reset the stack	lda	1,s		Bump the stack up to prepare	sta	11,s		to take off the 3 parameters	lda	3,s			sta	13,s	pla			get rid of message space		pla			get rid of data1 space	pla					pla			get rid of data2 space	pla					lda	#0		return 0 to caller	sta	5,s	sta	7,s			plb		rtl		t_cdev	dc.w	cccE		handle machine message - ignored	dc.w	cccE		handle boot message - ignored	dc.w	cccE		unused	dc.w	icc		init cdev controls	dc.w	ctc		close the cdev	dc.w	hem		handle event message	dc.w	ccc		create cdev controls	dc.w	ham		handle about message	dc.w	cccE		handle rectangle message	dc.w	hhm		handle hit message	;;	ccc - create cdev controls.;;	entry	[data1] = window pointer.;		(generallist..) = table of pointers to control templates to create.;		(mouse1menu..) = mouse menu to use when not on a ten speed.;		(trick..) = table of bank offsets for keyboard language menu.;		(trick1..) = table of bank offsets for display language menu.;;	exit	controls are created.ccc	lda	#0			pha			space	pha			space	pha			space	pha			space	pha			(a)	pha			(x)	pha			(y)	pushw	#$fe1f		entrypoint to call	_FWEntry		call the firmware	ply			(y)	plx			(a) - unused	plx			(x) - unused	plx			(p) - unused	cpy	#2	bcs	ccc1		if a new machine;	if not a ten speed, then reset the mouse menu to have fewer options.	lda	#GSmouse1menu	sta	mouseptr	lda	#^GSmouse1menu	sta	mouseptr+2		;	reset the keyboard and display language menus to what is available.ccc1	ldx	#$41		battery parameter to get # of keyboard languages	jsr	rbp		read battery parameter	asl	a	tax	lda	trick,x	sta	l1		low word of loc to mark as end		ldx	#$38		battery parameter to get # of display languages	jsr	rbp		read battery parameter	asl	a	tax	lda	trick1,x	sta	l2		low word of loc to mark as end		lda	#^trick	sta	l1+2		set hi words	sta	l2+2				shortm	lda	#'.'	sta	[l1]		shorten the menu as appropriate	sta	[l2]		shorten the menu as appropriate	longm		pha			space for result	pha	pushl	data1		window pointer	pushw	#3		next item is a ptr to a list of template pointers	pushl	#GeneralList	_NewControl2	pla	pla			don't care about result	cccE	rts;;	ctc - close the cdev.;;	entry	none.;;	exit	tools are shutdown, and any memory we allocated is released.ctc	jsr	stt		shutdown the tools	jmp	dom		dispose of memory and return	;;	ham - handle about message.;;	entry	[data1] = window pointer.;		(GeneralAbout..) = template for about screen.;;	exit	The About control is created.ham	pushw	#0	_FMStatus	pla	beq	ham1		if not active		jmp	ham8ham1	bcc	ham3		if font manager is loaded	inc	font2F		flag that this has to be unloaded	ham2	pushw	#$1b	pushw	#0	_LoadOneTool	bcc	ham3		if no error loading the tool	jsr	daw		display alert window	tax	beq	ham7		if user gave up	bra	ham2		if user wants to try againham3  	inc	fontF		flag that this has to be shutdown	pha			space for handle	pha	pushl	#$100		1 page	pha	_MMStartup		get mem id	pushw	#$C005		locked, fixed, fixed bank, pg algned	pushl	#0	_NewHandle	bcs	ham6		if unable to get memory	pla	sta	l1	sta	fmhdl	pla	sta	l1+2	sta	fmhdl+2	ham5	pha			space for result	_MMStartup		id to use	lda	[l1]	pha			address of direct page	_FMStartup	bcc	ham8		if ok	cmp	#$200	bcs	ham6		if memory manager error	jsr	daw		display alert window	tax	beq	ham7		if user wants to quit	bra	ham5		try to load it again	ham6	jmp	ham14		show the out of memory boxham7	rts		ham8	pushw	#0	_TEStatus	pla	bne	ham13		if text edit is already active	bcc	ham11		if tool is already loadedham9	pushw	#$22	pushw	#0			_LoadOneTool		bcc	ham10	jsr	daw	bra	ham9ham10	inc	text2F		flag that tool should be unloadedham11	pha			space for handle	pha	pushl	#$100		1 page	pha	_MMStartup		get mem id	pushw	#$C005		locked, fixed, fixed bank, pg algned	pushl	#0	_NewHandle	bcs	ham6		if unable to get memory		pla	sta	l1	sta	tehdl		pla	sta	l1+2	sta	tehdl+2	pha			space for result	_MMStartup		id to use	lda	[l1]	pha			address of direct page	_TEStartup	inc	textF		flag that this has to be shut down			ham13	pha			space for result	pha	pushl	data1		window pointer	pushw	#0		next item is a ptr to a template	pushl	#GeneralAbout	_NewControl2	pla	pla			don't care about result			rts;	if unable to show big about - tell user the bad news.ham14	pha			space for result	pha	pushl	data1		window pointer	pushw	#0		next item is a ptr to a template	pushl	#GeneralAbout2	_NewControl2	pla	pla			don't care about result	rts;;	hem - handle event message.;;	entry	[data1] = event.;;	exit	If it detects an activate event, it will shutdown any tools;		we started up and dispose of any memory we allocated.hem	ldy	#owhat	lda	[data1],y	get what type of event occurred	cmp	#ActivateEvt	bne	hem1		if not activate event		ldy	#omodifiers	lda	[data1],y		lsr	a	bcc	hem1		if window is being deactivated	jsr	stt		shutdown the tools	jmp	dom		dispose of memory and return	hem1	rts		;;	hhm - handle hit message.;;	entry	[data1] = handle to control that was hit.;		[data2] = id of control that was hit.;;	exit	battery parameter locations are updated.hhm	pha			space for result	pushl	data1	_GetCtlValue		pla	dea			this is what most things want		ldx	data2		get id of control	dex	bne	hhm1		if not setting menu blink		pha			save for later recall	pha	_SetMItemBlink		set the menu blink	pla	asl	a		-----XX-	asl	a		----XX--	asl	a		---XX---	sta	w1		save for now	ldx	#aug_param	jsr	rbp		read battery parameter	and	#%11100111	remove the menuitem blink	ora	w1		set as appropriate	ldx	#aug_param	bra	hhm10		write battery parameter and return	hhm1	dex	bne	hhm2		if not setting cursor flash	ldx	#$2f	bra	hhm10		write battery parameter and return	hhm2	dex	bne	hhm3		if not setting the system speed	pha			save for now	ldx	#$20		battery parameter loc for speed	jsr	wbp		write battery parameter	pla	shortm	lsr	a	ror	a	ora	>$e1c036	sta	>$e1c036	set or reset the speed	longm				rts	hhm3	dex	bne	hhm4		if not setting the mouse speed	ldx	#$33	bra	hhm10		write battery parameter and return	hhm4	dex	bne	hhm5		if not setting the double click speed	ldx	#$2e	bra	hhm10		write battery parameter and return	hhm5	dex	bne	hhm6		if not setting monitor display	ldx	#$29	bra	hhm10		write battery parameter and return	hhm6	dex	bne	hhm7		if not setting the keyboard language	ldx	#$2a	bra	hhm10		write battery parameter and return	hhm7	dex	bne hhm7a		if not setting translation	tax			(a) = value of control -1	beq	hhm9		if setting translation none		cmp	#2-1	bne	hhm8		if not 'standard' macintosh translation	lda	#$ff-1hhm8	ina			adjust for initial decrement	hhm9	pha	_SetKeyTranslation	rtshhm7a	;			handle "sort DA's" checkbox	pha			save value-1	ldx #$005F		Dave Lyons' BRAM byte	jsr rbp			get current value	ldx #$005F		preset X with param # for store	ply			restore control value	beq @on			was 1, turn on bit@off	and #$FFFE		turn off bit 0	bra hhm10		set new value@on	ora #$0001		turn on bit 0	;			fall through to write new BRAM valuehhm10	jmp	wbp		write battery parameter and return;;	icc - init cdev controls.;;	entry	[data1] = window pointer.;		(iccbat..) = table of battery parameters to check.;;	exit	controls are intialized to the battery settings.icc	ldx	#aug_param	jsr	rbp		read battery parameter	lsr	a		----XX--	lsr	a		-----XX-	lsr	a		------XX	and	#3	ldx	#1	jsr	scv		set control value	;	init cursor flash, sys speed, mouse speed, double click, monitor display and keybaord display.	ldx	#2		control id of cursor flashicc1	stx	w1		init counter	lda	iccbat-2,x	and	#$ff	tax	jsr	rbp		read battery parameter	ldx	w1	jsr	scv		set control value	ldx	w1	inx	cpx	#7+1		compare against highest control to set this way	bcc	icc1		if more to set	;	set keybaord translation.	pha	_GetKeyTranslation	pla	cmp	#$ff	bne	icc2		if not 'normal' iigs translation	lda	#2	bra	icc3icc2	tax	bne	icc3		if not 'standard' macintosh like translation	inaicc3	dea			scv will increment it	ldx	#8		id of translation	jsr	scv		set control value;	check "sort DAs" bit	;brk $04	ldx #$5F		Dave Lyons' BRAM byte	jsr rbp			read BRAM	and #$0001		keep bit 0, so now we have a checkbox ctl value!	ldx #9			ID of "sort DA's" check box	jmp scv2		set ctl value & return;	battery parameter locations.	iccbat	dc.b	$2f		cursor flash	dc.b	$20		system speed	dc.b	$33		mouse speed	dc.b	$2e		double click time	dc.b	$29		monitor language translation	dc.b	$2a		keyboard language translation			;	teriary routines used in this program.;;	daw - display alert window.;;	entry	(dawa..) = alert string.;		daww = width of window.;;	exit	none.daw	ldx	#(320-daww)/2	pha			space for result	_GetMasterSCB	pla	xba	rol	a		bcc	daw1		if 320 mode	ldx	#(640-daww)/2daw1	stx	dawa+1+2	left x	txa	clc	adc	#daww	sta	daw+1+6		right x	pha			space for result	pushw	#0		flags	pha	pha			subsitution array - not used	pushl	#dawa		reference to string	_AlertWindow	pla	rts		daww	equ	300		width of windowdawa	dc.b	'0'	dc.w	60,0,100,0	dc.b	'6'	dc.b	'/Please insert your startup disk./#1/^#4',0	;;	dom - dispose of memory.;;	entry	[fmhdl] = 0 or the handle to the space needed for the font manager.;		[tehdl] = 0 or the handle to the space for textedit.;;	exit	Handles are disposed.;		[fmhdl] = 0.;		[tehdl] = 0.dom	lda	tehdl	ora	tehdl+2	beq	dom1		if no handle for textedit		pushl	tehdl	_DisposeHandle	stz	tehdl	stz	tehdl+2	dom1	lda	fmhdl	ora	fmhdl+2	beq	dom2		if no handle for font manager		pushl	fmhdl	_DisposeHandle	stz	fmhdl	stz	fmhdl+2	dom2	rts;;	rbp - read battery parameter.;;	entry	(x) = parameter to read.;;	exit	(a) = value of parameter.rbp	pha			space for result	phx			parameter to read	_ReadBparam	pla			get value	rts;;	scv - set control value.;;	entry	(a) = value of control to set -1.;		(x) = id of control.;		[data1] = window pointer.;;	exit	control is set to the value desired.scv	inascv2	pha			value to set	pha			space for result	pha					pushl	data1		window pointer	pushw	#0	phx			id of control	_GetCtlHandleFromID	_SetCtlValue		value to set was already on stack	rts;;	stt - shutdown tools.;;	entry	(fontF) !=0 if we started up the font manager.;		(font2F) != 0 if we loaded the font manager.;		(textF) != 0 if we started up textedit.;		(text2F) != 0 if we loaded textedit.;;	exit	everything is set back to the way it was.;		(fontF) = (font2F) = (textF) = (text2F) = 0.stt	lda	fontF	beq	stt1		if we didn't start up the font manager	_FMShutDown	stt1	lda	font2F	beq	stt2		if we didn't load the font manager	pushw	#$1b	_UnloadOneTool		unload the font manager since we loaded it	stt2	lda	textF	beq	stt3		if we didn't start up textedit	_TEShutdown	stt3	lda	text2F	beq	stt4		if we didn't load textedit	pushw	#$22	_UnloadOneTool		unload textedit since we loaded itstt4	stz	fontF	stz	font2F	stz	textF	stz	text2F	rts;;	wbp - write battery parameter.;;	entry	(a) = value of parameter to set.;		(x) = battery parameter to set.;;	exit	battery parameter is set.wbp	pha			new value	phx			parameter to set	_WriteBparam	rts	;	global data.fmhdl	ds.b	4		handle to direct page needed by font managerfontF	ds.b	2		!= 0 if font manager needs to be shut downfont2F	ds.b	2		!= 0 if font manager needs to be unloadedtehdl	ds.b	4		handle to direct page needed by text edittextF	ds.b	2		!= 0 if text edit needs to be shut downtext2F	ds.b	2		!= 0 if textedit needs to be unloaded			endp	end