;;;	generaldata - initialized data for general CDEV.;;	Michael V. Stein	03/01/90.;;	© Apple, 1990.	include 'E16.Control'	BLANKS ON	string ASIS;;	equates.left	equ	5right	equ	195top	equ	2hgt	equ	12tothgt	equ	hgt+3space	equ	8;	control for menublink popup.general1 PROC EXPORT	dc.w	9	dc.l	1	dc.w	top,left,top+hgt,right	dc.l	popUpControl	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	105	dc.l	general1Menu	dc.w	1	general1menu	dc.b	'>> Menu Blinking:\H'	dc.w	1	dc.b	$0D	dc.b	'== Off\H'	dc.w	1	dc.b	$0D	dc.b	'== 1 Time\H'	dc.w	2	dc.b	$0D	dc.b	'== 2 Times\H'	dc.w	3	dc.b	$0D	dc.b	'== 3 Times\IH'	dc.w	4	dc.b	$0D	dc.b	'.'	ENDP;	control for cursor flash popup.	general2 PROC EXPORTtop2	equ	top+tothgt	dc.w	9	dc.l	2	dc.w	top2,left,top2+hgt,right	dc.l	popUpControl	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	105	dc.l	general2Menu	dc.w	1	general2menu	dc.b	'>> Cursor Flash:\H'	dc.w	2	dc.b	$0D	dc.b	'== Slowest\H'	dc.w	1	dc.b	$0D	dc.b	'== Slow\H'	dc.w	2	dc.b	$0D	dc.b	'== Medium\IH'	dc.W	3	dc.b	$0D	dc.b	'== Fast\H'	dc.w	4	dc.b	$0D	dc.b	'== Fastest\H'	dc.w	5	dc.b	$0D	dc.b	'.'	ENDP	;	control for system speed popup.general3 PROC EXPORTtop3	equ	top+tothgt*2	dc.w	9	dc.l	3	dc.w	top3,left,top3+hgt,right	dc.l	popUpControl	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	105	dc.l	general3Menu	dc.w	1	general3menu	dc.b	'>> System Speed:\H'	dc.w	3	dc.b	$0D	dc.b	'== Normal\H'	dc.w	1	dc.b	$0D	dc.b	'== Fast\IH'	dc.w	2	dc.b	$0D	dc.b	'.'	ENDP			string ASIS;	control for mousespeed popup.mouse1 PROC EXPORTtop4	equ	top+tothgt*3+space	dc.w	9	dc.l	4	dc.w	top4,left,top4+hgt,right	dc.l	popUpControl	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	110	export mouseptrmouseptr	import mouse1menu	dc.l	mouse1Menu	dc.w	1	ENDP;	menu for ROM 1.GSmouse1menu proc export	dc.b	'>> Mouse Speed:\H'	dc.w	1	dc.b	$0D	dc.b	'== Slow\IH'	dc.w	1	dc.b	$0D	dc.b	'== Fast\H'	dc.w	2	dc.b	$0D	dc.b	'.'	ENDP;	menu for ROM 3.	mouse1menu proc export	dc.b	'>> Mouse Speed:\H'	dc.w	1	dc.b	$0D	dc.b	'== Slowest\IH'	dc.w	1	dc.b	$0D	dc.b	'== Slow\H'	dc.w	2	dc.b	$0D	dc.b	'== Medium\H'	dc.w	3	dc.b	$0D	dc.b	'== Fast\H'	dc.w	4	dc.b	$0D	dc.b	'== Fastest\H'	dc.w	5	dc.b	$0D	dc.b	'.'	ENDP;	control for double click speed.mouse2 PROC EXPORTtop5	equ	top+tothgt*4+space		dc.w	9	dc.l	5	dc.w	top5,left,top5+hgt,right	dc.l	popUpControl	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	110	dc.l	mouse2Menu	dc.w	1	mouse2menu	dc.b	'>> Double Click:\H'	dc.w	2	dc.b	$0D	dc.b	'== Slowest\H'	dc.w	1	dc.b	$0D	dc.b	'== Slow\H'	dc.w	2	dc.b	$0D	dc.b	'== Medium\IH'	dc.w	3	dc.b	$0D	dc.b	'== Fast\H'	dc.w	4	dc.b	$0D	dc.b	'== Fastest\H'	dc.w	5	dc.b	$0D	dc.b	'.'	ENDP			;	alphabet stuff.inter1 PROC EXPORTtop6	equ	top+tothgt*5+space*2	dc.w	9	dc.l	6	dc.w	top6,left,top6+hgt,right	dc.l	popUpControl	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	80	dc.l	inter1Menu	dc.w	1	export trick1Trick1	dc.w	zero	dc.w	one	dc.w	two	dc.w	three	dc.w	four	dc.w	five	dc.w	six	dc.w	seven	dc.w	eight	dc.w	nine	dc.w	ten	dc.w	eleven	dc.w	twelve	dc.w	thirteen	dc.w	fourteen	dc.w	fifteen	dc.w	sixteen	dc.w	seventeen	dc.w	eighteen	dc.w	nineteen	dc.w	twenty	inter1menu	dc.b	'>> Monitor:\H'	dc.w	6	dc.b	$0Dzero	dc.b	'== U.S.A.\IH'	dc.w	1	dc.b	$0Done	dc.b	'== U.K.\H'	dc.w	2	dc.b	$0Dtwo	dc.b	'== French\H'	dc.w	3	dc.b	$0Dthree	dc.b	'== Danish\H'	dc.w	4	dc.b	$0Dfour	dc.b	'== Spanish\H'	dc.w	5	dc.b	$0Dfive	dc.b	'== Italian\H'	dc.w	6	dc.b	$0Dsix	dc.b	'== German\H'	dc.w	7	dc.b	$0Dseven	dc.b	'== Swedish\H'	dc.w	8	dc.b	$0Deight	dc.b	'== Dvorak\H'	dc.w	9	dc.b	$0Dnine	dc.b	'== Canadian\H'	dc.w	10	dc.b	$0Dten	dc.b	'== Flemish\H'	dc.w	11	dc.b	$0Deleven	dc.b	'== Hebrew\H'	dc.w	12	dc.b	$0Dtwelve	dc.b	'== Japanese\H'	dc.w	13	dc.b	$0Dthirteen	dc.b	'== Arabic\H'	dc.w	14	dc.b	$0Dfourteen	dc.b	'== Greek\H'	dc.w	15	dc.b	$0Dfifteen	dc.b	'== Turkish\H'	dc.w	16	dc.b	$0Dsixteen	dc.b	'== Finnish\H'	dc.w	17	dc.b	$0Dseventeen	dc.b	'== Portuguese\H'	dc.w	18	dc.b	$0Deighteen	dc.b	'== Tamil\H'	dc.w	19	dc.b	$0Dnineteen	dc.b	'== Hindi\H'	dc.w	20	dc.b	$0Dtwenty	dc.b	'.'	ENDPkeyboard1 PROC EXPORT;	control for keyboard language.top7	equ	top+tothgt*6+space*2	dc.w	9	dc.l	7	dc.w	top7,left,top7+hgt,right	dc.l	popUpControl	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	80	dc.l	keyboard4Menu	dc.w	1	export trickTrick	dc.w	zero	dc.w	one	dc.w	two	dc.w	three	dc.w	four	dc.w	five	dc.w	six	dc.w	seven	dc.w	eight	dc.w	nine	dc.w	ten	dc.w	eleven	dc.w	twelve	dc.w	thirteen	dc.w	fourteen	dc.w	fifteen	dc.w	sixteen	dc.w	seventeen	dc.w	eighteen	dc.w	nineteen	dc.w	twentykeyboard4menu	dc.b	'>> Keyboard:\H'	dc.w	4	dc.b	$0Dzero	dc.b	'== U.S.A.\IH'	dc.w	1	dc.b	$0Done	dc.b	'== U.K.\H'	dc.w	2	dc.b	$0Dtwo	dc.b	'== French\H'	dc.w	3	dc.b	$0Dthree	dc.b	'== Danish\H'	dc.w	4	dc.b	$0Dfour	dc.b	'== Spanish\H'	dc.w	5	dc.b	$0Dfive	dc.b	'== Italian\H'	dc.w	6	dc.b	$0Dsix	dc.b	'== German\H'	dc.w	7	dc.b	$0Dseven	dc.b	'== Swedish\H'	dc.w	8	dc.b	$0Deight	dc.b	'== Dvorak\H'	dc.w	9	dc.b	$0Dnine	dc.b	'== Canadian\H'	dc.w	10	dc.b	$0Dten	dc.b	'== Flemish\H'	dc.w	11	dc.b	$0Deleven	dc.b	'== Hebrew\H'	dc.w	12	dc.b	$0Dtwelve	dc.b	'== Japanese\H'	dc.w	13	dc.b	$0Dthirteen	dc.b	'== Arabic\H'	dc.w	14	dc.b	$0Dfourteen	dc.b	'== Greek\H'	dc.w	15	dc.b	$0Dfifteen	dc.b	'== Turkish\H'	dc.w	16	dc.b	$0Dsixteen	dc.b	'== Finnish\H'	dc.w	17	dc.b	$0Dseventeen	dc.b	'== Portuguese\H'	dc.w	18	dc.b	$0Deighteen	dc.b	'== Tamil\H'	dc.w	19	dc.b	$0Dnineteen	dc.b	'== Hindi\H'	dc.w	20	dc.b	$0Dtwenty	dc.b	'.'	ENDP		other1	PROC EXPORTtop8	equ	top+tothgt*7+space*2	dc.w	9			;pcount	dc.l	8			;ctl ID	dc.w	top8,left,top8+hgt,right	;rect	dc.l	popUpControl		;procRef	dc.w	$0040			;ctlFlag	dc.w	$1002			;moreFlags	dc.l	0			;refCon	dc.w	105			;title width	dc.l	$07ff1000		;menuRef, from the System resource…					;…file, so that it will follow…					;…localization	dc.w	1			;initial item	top9		equ	top+tothgt*8+20		export sortChecksortCheck		dc.w	8			;pcount		dc.l	9			;ctl ID		dc.w	top9,left+22,top9+hgt,right	;rect		dc.l	checkControl		;procRef		dc.w	$0000			;ctlFlag		dc.w	$1000			;moreFlags		dc.l	0			;refCon		dc.l checkTitle		dc.w	0			;initial valuecheckTitle		dc.b @end - @start@start		dc.b ' Alphabetize DAs '@end;	list of controls.		generalList	PROC EXPORT		dc.l	general1		dc.l	general2		dc.l	general3		dc.l	mouse1		dc.l	mouse2		dc.l	inter1		dc.l	keyboard1		dc.l	other1		dc.l sortCheck		dc.l	0		ENDPgeneralabout2	PROC EXPORT	dc.w	8	dc.l	1	dc.w	38,5,138,280	dc.l	$81000000	dc.w	$0000	dc.w	$1000	dc.l	0	dc.l	ab2	dc.w	ab2Lab2	dc.b	'Not enough memory.'ab2L	equ	*-ab2	endp;	text edit control for about box.generalabout	proc	export	dc.w 16			; pCount - Just until the text length.	dc.l $00000021		; ID.	dc.w	38,5,138,280	; rect	dc.l $85000000		; procRef - TextEdit control is $85000000.	dc.w	$0	dc.w $7400		; moreFlags - references are for pointers.	dc.l $00000000		; refCon - not needed.	dc.l $45900000		; textFlags - no selecting, draws border, etc.	dc.w $ffff,$ffff	; indentRect - use the default amounts.	dc.w $ffff,$ffff	dc.l $ffffffff		; vertBar - let TextEdit create the scroll bar.	dc.w $0000		; vertAmount - use the default amount for scrolling.	dc.l $00000000		; horzBar - not used.	dc.w $0000		; horzAmount - not used.	dc.l $00000000		; styleRef - there are no initial styles.	dc.w $0004		; textDescriptor - text is pointer to LETextBox2.	dc.l thetext		; textRef - to be supplied by the program._aboutFullProgramTitleLength_	dc.l endtext-thetext	; textSize - to be supplied by the program.	string asis	TheText	dc.b	'The General Control Panel allows you to change miscellaneous '	dc.b	'system settings.  Menu Blinking is the number of times '	dc.b	'that menu items will blink when they are chosen.  '	dc.b	'Cursor Flash is how fast the insertion point '	dc.b	'will blink when you are editing text.  System Speed allows '	dc.b	'you to slow down the processor for compatibility with older '	dc.b	'Apple II programs.  '	dc.b 	'Mouse '	dc.b 	'Speed controls the speed of the mouse across the screen.  Double '	dc.b 	'Click is the interval of time between two mouse clicks for them to '	dc.b 	'be considered a double click.  '	dc.b	'The Monitor item lets you select a foreign character set for ' 	dc.b	'the text screen.  '  	dc.b 	'The Keyboard item allows you to set the keyboard type.  Setting '	dc.b	'the Translation item to “Standard” will allow you to type foreign '	dc.b	'characters.  '	dc.b	'Alphabetize DAs causes NDAs and CDAs to be listed in '	dc.b	'alphabetical order after the system is restarted.'EndText	ENDP	END