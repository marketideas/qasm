;;;	netdata - data records and strings used by netprinter CDEV.;;	Michael V. Stein	01/21/90.;;	© Copyright Apple Computer, 1990.	blanks	off	;;	equates.fCtlCanBeActive equ 	$4000InsideScrollBar	equ	4;;	include files.	include	'e16.control'	include	'e16.gsos'	include	'e16.list'	include	'netprinter.h';;	main program.netdata	proc;;	exported addresses.	export	about	export	appletalk	export	asterisk	;export	atalkerr	export atalkerrm	export	atalkF	export	atinit	export	atinitlpath	export	btitle	export	cfemes	export	choosepr	export	close_pblk	export create_pblk		;added 2/4/91 by Monte Benaresh	export	cprect	export	ctllist	export	dtemes	export	edctl	export	emess1	export	emess2	export	emess3	export	emess4	export	emess5	export	emess6	export	emess7	export	emess10	export	emess11	export	emess12	export	emess13	export NBPbusyMsg	export fileLockedMsg	export	entity	export	ginfoparams	export	gmyp_pblk	export	gmyz_pblk	export	gup_pblk	export	open_pblk	export	iwebut	export	iwempath	export	kill_pblk	export	oktext	export	popen_pblk	export	plist	export	pread_pblk	export	prec	export	psetpr_pblk	export	psetuppath	export psetupname		;added 2/3/91 by Monte Benaresh toÉ	export psetupnmL:equ		;Ésupport access of printer.setup on network boot	export	pstat_pblk	export	ptypes	export	punload_pblk	export	pwrite_pblk	export	quit	export	rw_pblk	export	sm_pblk	export	tryagain	export	typeptr	export	zlist	export	zonelist_pblk; used by dte:	export	geteof	export	rewind	export	iwemHandle;;	imported addresses.	import	acr	import	myzonename	import	namesbuffer	import	netobj	import	openblock	import	openblock2	import	readbuff	import	username	import	zonebufferatinit	ds	atinitrec	hold data from atinit fileentity	ds	entityrec	hold printer entityprec	ds	printersetup	printer.setup internal record	atalkF	dc.w	1		!= 0 if appletalk is active, defaults to activeiwemHandle dc.l	0		; handle to IWEM buffer;	error strings.	string	asisemess1	dc.b	emess1L	dc.b	'The user name can only be 31'	dc.b	13	dc.b	'characters long.'emess1L	equ	*-emess1-1	emess2	dc.b	emess2L	dc.b	'Please reinsert your startup'	dc.b	13	dc.b	'disk.'emess2L	equ	*-emess2-1	emess3	dc.b	emess3L	dc.b	'Access Denied error.  No'	dc.b	13	dc.b	'changes can be saved.'	dc.b	13	dc.b	'Check with your'	dc.b	13	dc.b	'network administrator.'emess3L	equ	*-emess3-1	emess4	dc.b	emess4L	dc.b	'Having trouble accessing'	dc.b	13	dc.b	'printer data files from'	dc.b	13	dc.b	'your startup disk.  Please'	dc.b	13	dc.b	're-install the printer'	dc.b	13	dc.b	'software on your startup'	dc.b	13	dc.b	'disk.'emess4L	equ	*-emess4-1	emess5	dc.b	emess5L	dc.b	'The startup disk is write'	dc.b	13	dc.b	'protected.'emess5L	equ	*-emess5-1emess6	dc.b	emess6L	dc.b	'The disk is full.'	dc.b	13	dc.b	'No changes can be'	dc.b	13	dc.b	'saved.'emess6L	equ	*-emess6-1	emess7	dc.b	emess7L	dc.b	'There is not enough memory'	dc.b	$0d	dc.b	'to continue.'emess7L	equ	*-emess7-1;	error messages used by the rename and emulator routines.emess10	dc.b	emess10L	dc.b	'The selected printer'	dc.b	$0d	dc.b	'is not responding.'	dc.b	$0d	dc.b	'Please try again.'emess10L  equ	*-emess10-1emess11	dc.b	emess11L	dc.b	'A network error has'	dc.b	$0d	dc.b	'occurred.  Please try'	dc.b	$0d	dc.b	'again.'emess11L  equ	*-emess11-1emess12	dc.b	emess12L	dc.b	'The ImageWriter Emulator'	dc.b	$0d	dc.b	'is already installed in'	dc.b	$0d	dc.b	'the selected printer.'emess12L  equ	*-emess12-1emess13	dc.b	emess13L	dc.b	'The selected printer'	dc.b	$0d	dc.b	'could not be found.'emess13L  equ	*-emess13-1NBPbusyMsg	dc.b @end-@start@start	dc.b 'A list of printers cannot', $0D	dc.b 'be displayed because a', $0D	dc.b 'network search is already', $0D	dc.b 'in progress on this computer.'@endfileLockedMsg	dc.b @end-@start@start	dc.b 'The new settings cannot be ', $0D	dc.b 'saved because the ÒATInitÓ ', $0D	dc.b 'or ÒPrinter.SetupÓ files are ', $0D	dc.b 'locked.'@end	string	pascalappletalk  dc.b	'APPLETALK'asterisk  dc.b	'*'btitle	dc.b	'ImageWriter Emulator'	title of iwebutoktext	dc.b	'OK'quit	dc.b	'Quit'			used in disk error alerts;;;rtptitle  dc.b	'Rename PrinterÉ'	title of rtp buttontryagain  dc.b	'Try Again'		used in disk error alerts;	this data is somewhat odd since the LaserWriter and ImageWriter;	both have the same name that is used in the printer.setup file;	to identify the printer and the type name for name lookups.  The;	ImageWriterLQ on the other hand uses 'LQ' when doing name lookups;	and is stored as 'ImageWriter.LQ' in the printer.setup file.ptypes	laser	dc.b	'LaserWriter'		name used for bothim	dc.b	'ImageWriter'		name used for bothimlq	dc.b	'LQ'			name used for lookupsimlqfile  dc.b	'ImageWriter.LQ'	name needed for printer.setuptypeptr  dc.w	laser,im,imlq,imlqfile	string	asiscfemes	dc.b	cfemesL	dc.b	'Checking for presence of'	dc.b	$0d	dc.b	'the ImageWriter Emulator...'cfemesL  equ	*-cfemes-1dtemes	dc.b	dtemesL	dc.b	'Downloading the emulator...'dtemesL	 equ	*-dtemes-1	usertitle  dc.b	'User Name:',0usertitleL  equ  *-usertitle-1zonetext  dc.b	'AppleTalk Zones:',0zonetextL  equ	*-zonetext-1;	appletalk parameter blocks.;	parameter block to get appletalk info.GinfoParams	dc.b synchronous	;type	dc.b GetInfoCmd		;command	dc.w 0			;result	dc.l 0			;completion routine	dc.w 0			;ThisNet	dc.b 0			;Abridge	dc.b 0			;HardWareID	dc.w 0			;Rom version	dc.b 0			;node number;	parameter block to find printers.	gmyp_pblk  dc.b	asynchronous		mode	dc.b	NBPLookup		command	dc.w	busy			result	dc.l	acr			completion routine	dc.l	netobj			ptr to name of what we want to find	dc.b	1			retry period in 1/4 secs		dc.b	1			# of times to retry	dc.w	0			somehting internal	dc.w	pblocksize		receive buffer size	dc.l	openblock2		store responses here	dc.b	maxsrvrs		maximum # of responses allowed	dc.b	0			actual number of responces received;	parameter block to get my zone.gmyz_pblk  dc.b	asynchronous		mode	dc.b	GetMyZone		command	dc.w	busy			result	dc.l	0			no completion routine	dc.l	myzonename		bufptr	dc.b	2			retry period	dc.b	8			# of retrys	dc.w	2			reserved;	parameter block to kill the current name lookup.kill_pblk  dc.b  synchronous		mode	dc.b	KillNBP			kill name binding protocol	dc.w	0			result code	dc.l	gmyp_pblk		starting parameter block		;	parameter block to get the zone list.	zonelist_pblk	dc.b	synchronous	dc.b	GetZoneList	dc.w	busy	dc.l	0		iocomp	dc.w	MaxZones*(NameLen+4)   buflen	dc.l	0		bufptr (filled in dynamically)	dc.b	0		brnode	dc.w	1		strtindex	dc.b	1		retryinterval	dc.b    2		retrycount	dc.w    0		;# of zones returned    	dc.w	0		reserved	;	pap parameter blocks.	popen_pblk  dc.b  asynchronous	dc.b	Popen		command	dc.w	0		result	dc.l	0		iocomp	dc.b	0		refnum	dc.l	0		ptr to name	dc.b	1		flowq	dc.l	readbuff	statbuf	psetpr_pblk  dc.b  synchronous	dc.b	PMSetPrinterCmd	  command	dc.w	0		result	dc.l	0		iocomp	dc.l	atinitrec+34	ptr to printer tuple	dc.b	0		flags	dc.w	2		flush interval	dc.w	30*4		timeout interval	dc.w	20		# of buffers	pstat_pblk  dc.b  asynchronous		dc.b	Pstatus		command	dc.w	0		result	dc.l	0		iocomp	dc.l	0		ptr to entity	dc.l	readbuff	stat buffer	pread_pblk  dc.b  asynchronous	dc.b	Pread		command	dc.w	0		result	dc.l	0		iocomp	dc.b	0		refnum	dc.w	0		buflen	dc.l	readbuff	bufptr	dc.b	0		eofbyte	dc.w	0		reservedpunload_pblk  dc.b  synchronous	dc.b	$27		pap unload command	dc.w	0		result	dc.l	0		completion ptr		pwrite_pblk  dc.b	asynchronous	dc.w	PWrite		command	dc.w	0		result	dc.l	0		iocomp	dc.b	0		refnum	dc.w	0		buflen	dc.l	0		bufptr	dc.b	0		eofbyte	dc.b	0		; extra, so we can use a word store to eofbyte	;	gs/os parameter blocks.;	parameter block for creating printer.setupcreate_pblk	dc.w	5		pcount through storage type	ds.l 1			pathname	dc.w $00C3		access	dc.w $0006		filetype = binary	dc.l $00000000		auxtype	dc.w $0000		storage typeclose_pblk  dc.w  1		only one parameter	ds.b	2		refnum;	parameter block to get user path from appleshare.gup_pblk  dc.w	3		3 parameters	dc.w	AShareFST	id of the appleshare fst	dc.w	8		command for get user path	ds.b	4		ptr to pathname;	parameter block to open a file.open_pblk  dc.w	6		only care about 6 parameters	ds.b	$e		hold rest of parameter block;	parameter block for read/write operations on a file.	rw_pblk	dc.w	4		only care about 4 parameters	ds.b	$e		hold rest of parameter block;	parameter block to set the mark on a file.sm_pblk	dc.w	3		3 parameters	dc.w	0		ref num	dc.w	eofMinus	displacement from end	dc.l	atinitrec.sizeofrewind				; added 10-Jan-92 MSD	dc.w	3		; SetMark - pcount = 3	dc.w	0		; refnum	dc.w	startPlus	; absolute offset from start of file	dc.l	0		; seek to start of filegeteof	dc.w	2		; GetEOF - pcount = 2	dc.w	0		; refnum	dc.l	0		; returned EOF;	ctllist contains a list of controls whose handles we don't need very often.ctllist dc.l	choosepr	dc.l	utext	dc.l	ztext	dc.l	0choosepr  dc.w	9		PCount	dc.l	1		control ID	dc.w	5,leftedge,17,rightedge  rectangle	dc.l	$87000000	procRef	dc.w	$0040		flag	dc.w	$1084		moreflags (added $0080 pop-down triangle 25-Aug-92 DAL)	dc.l	0		refcon	dc.w	64		titleWidth	dc.l	chooseprmenu	menuref	dc.w	0		initialvalue	chooseprmenu	dc.b 	'>>Printer:\H'	dc.w 	1	dc.b 	$0D	dc.b 	'==LaserWriter\H'	dc.w 	1	dc.b 	$0D	dc.b 	'==ImageWriter\H'	dc.w 	2	dc.b	$0d	dc.b 	'==ImageWriter LQ\H'	dc.w	3	dc.b	$0d	dc.b	'.'about	dc.w	8		;Pcount	dc.l	10		;ID	dc.w	38,5,138,280	dc.l	statTextControl	dc.w	0	dc.w	fCtlProcRefNotPtr	dc.l	0	dc.l	atext	dc.w	AtextLatext	dc.b	'The Net Printer Control Panel allows you '	dc.b	'to direct your printer output to '	dc.b	'any printer on the AppleTalk network.  '	dc.b	'Select the type of printer with the '	dc.b	'pop-up menu.  The ImageWriter Emulator '	dc.b	'can be downloaded to any LaserWriter '	dc.b	'for those applications that normally print '	dc.b	'to an ImageWriter.'	atextL	equ	*-atext;	static text control removed 12/3/91 by Monte Benaresh;	because an alert box is now used;atalkerr  dc.w	8		PCount	;dc.l	11		id	;dc.w	8,leftedge,38,Rightedge+20	;dc.l	statTextControl	;dc.w	0	;dc.w	fCtlProcRefNotPtr	;dc.l	0	;dc.l	atalkerrm	ptr to text	;dc.w	atalkerrmL	length		atalkerrm	dc.b atalkerrmL-1	dc.b	'AppleTalk must be'	dc.b	13	dc.b	'installed and enabled to'	dc.b	13	dc.b	'run this Control Panel.'	dc.b	13	;dc.b	' 'atalkerrmL  equ	*-atalkerrm	plist	dc.w	15		PCount	dc.l	2		ID	dc.w	20		rectangle	dc.w	LeftEdge	dc.w	62	dc.w	Rightedge	dc.l	listControl	ctrldefproc	dc.w	$80		ctlFlag	dc.w	fCtlProcRefNotPtr+fCtlCanBeTarget+fCtlWantEvents	moreFlags	dc.l	0		ref con	dc.w	0		ctlListSize	dc.w	MaxSrvrView	ctlListView	dc.w	selectOnlyOne+InsideScrollBar	dc.w	1		ctlListstart	dc.l	0		ctlListDraw	dc.w	10		ctlListMemHeight	dc.w	memrec.sizeof	ctlListMemSize	dc.l	namesbuffer	ctlListRef	dc.l	0		ctlColorRef	zlist	dc.w	15		PCount	dc.l	3		ID	dc.w	100-3		rectangle	dc.w	LeftEdge	dc.w	142-3	dc.w	RightEdge	dc.l	listControl	ctrldefproc	dc.w	$80		ctlflag	dc.w	fctlProcRefNotPtr+fCtlCanBeTarget+fCtlWantEvents	moreFlags	dc.l	0		ref con	dc.w	0		ctlListSize	dc.w	MaxZoneView	ctlListView	dc.w	selectOnlyOne+InsideScrollBar	dc.w	1		ctlListstart	dc.l	0		ctlListDraw	dc.w	10		ctlListMemHeight	dc.w	memrec.sizeof	ctlListMemSize	dc.l	zonebuffer	ctlListRef	dc.l	0		ctlColorRef			editrect  dc.w	142,LeftEdge,162,RightEdge+20   edit box rectanglecprect	dc.w	0,0,200,320	control panel rectangleedctl	dc.w	8		PCount	dc.l	20		ID number	dc.w	155		rectangle	dc.w	LeftEdge	dc.w	169	dc.w	RightEdge	dc.l	editLineControl	dc.w	0		flag	dc.w	fctlProcRefNotPtr+fctlWantEvents+fCtlCanBeActive	dc.l	0		ref con	dc.w	NameLen		length	dc.l	username	ptr to name		utext	dc.w	8		Pcount	dc.l	7		ID number	dc.w	149-4		rectange	dc.w	leftedge	dc.w	159-4	dc.w	rightedge	dc.l	statTextcontrol	 procref	dc.w	0		flag c strings	dc.w	fctlProcRefNotPtr	dc.l	0		refcon	dc.l	usertitle	text ref	dc.w	usertitleL	length of string	ztext	dc.w	8		Pcount	dc.l	9		ID number	dc.w	94-4-3	dc.w	leftedge	dc.w	103-4-3	dc.w	rightedge	dc.l	statTextcontrol	dc.w	0		flag, c string	dc.w	fctlProcRefNotPtr	dc.l	0		ref con	dc.l	zonetext	text ref	dc.w	zonetextL	length of string;	buttons.iwebut	dc.w	9		Pcount	dc.l	4		ID number	dc.w	69	dc.w	leftedge+5+40	dc.w	69+13	dc.w	rightedge-5-40	dc.l	simpleButtoncontrol	dc.w	simpRound+ctlInvis	dc.w	fCtlWantEvents+fctlProcRefNotPtr	dc.l	0	dc.l	btitle	dc.w	0		length?	dc.w	0		key equivalent	;	gs/os paths used. atinitlpath  dc.w	atinitlpathL	dc.b	'*/SYSTEM/SYSTEM.SETUP/ATINIT'atinitlpathL	equ	*-atinitlpath-2iwempath  dc.w  iwempathL	dc.b	'*/SYSTEM/DRIVERS/IWEM'iwempathL  equ	*-iwempath-2psetuppath  dc.w	psetuppathL	;dc.b	'*/SYSTEM/DRIVERS/PRINTER.SETUP'	dc.b	'*:SYSTEM:DRIVERS'	dc.b ':PRINTER.SETUP'psetuppathL	equ	*-psetuppath-2psetupname				;added 2/3/91 by Monte to support network boot	dc.b ':SETUP:PRINTER.SETUP'psetupnmL	equ	*-psetupname	endp	end