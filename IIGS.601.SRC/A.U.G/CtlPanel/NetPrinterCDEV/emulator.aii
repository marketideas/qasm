;;;	emulator - download the Imagewriter emulator to an AppleTalk printer.;;	Michael V. Stein	03/20/90.;;	© Apple, 1990.;; 10-Jan-92 MSD	There is a problem with downloading the IWEM to the Personal;		Laserwriter NT: after we send a packet, we read in the next block;		and the Laserwriter is sending its PAP SendData packet.  If we had;		interrupts off while doing the read (reading from a floppy, for;		example), we'd miss the SendData and have to wait for the printer;		to retry and send it again approximately 15 seconds later.  This;		means we average 512 bytes every 15 seconds -- very slow!;;		The solution is to try to pre-load the IWEM file into memory before;		downloading it.  We'll try to get a handle large enough for the whole;		file.  If that fails, we resort to the old method of reading 512 bytes;		at a time.;;		Note: So the version checking code wouldn't need to change, the first;		block still gets read into the internal buffer.  If we get the handle,;		then we set the mark back to the start of the file and read the whole;		thing in.;;		Procs affected:	dte (Download The Emulator);	blanks	off;;	equates.;;	include files.	include	'::commonmacros.h'	include	'::dp.h'	include	'e16.control'	include	'e16.dialog'	include	'e16.gsos'	include	'm16.memory'	include	'm16.control'	include	'm16.dialog'	include	'm16.gsos'	include	'm16.list'	include	'm16.qdaux'	include	'm16.quickdraw'	include	'm16.util2'	include	'netprinter.h';;	main program.emulator	proc;;	imported addresses.	import	cfemes	import	close_pblk	import	cmd	import	ctp	import	damE	import	dtemes	import	emess4	import	emess12	import	gip	import	hfo	import	hpe	import	hzl	import	iwempath	import	lookupF	import	lszone	import	omd	import	open_pblk	import	osd	import	otp	import	pclose_pblk:close_printer	import	plisthdl	import	popen_pblk:open_printer	import	pread_pblk:read_printer	import	pstat_pblk:status_printer	import	pwrite_pblk:write_printer	import	readbuff	import	rfp	import	rfpE	import	rtpstat	import	rw_pblk	import	screenF	import	stp	import	stpE	import	wtp; used by dte:	import	geteof	import	rewind	import	iwemHandle;;	exported addresses	export	cfe;;	cfe - check for emulator.;;	entry	controls have been set up and a printer selected.;		(cfemes..) = status dialog to display.;		(emess12..) = message to give when emulator is present.;		(emquery..) = postscript string to query for emulator presence.;		emqueryL = length of query message.;		PapBusy = status meaning that the pap call hasn't finished.;		(pread_pblk..) = parameter block for reading from a printer.;		(pwrite_pblk..) = parameter block for writing to a printer.;		(readbuff..512) = buffer to use when reading from a printer.;;	exit	The routine checks for the presence of the emulator.  If the emulator;		is already present, it puts up an alert and exits.  If the emulator isn't;		there it is downloaded to the printer.  In any case, the routine exits to ;		hzl to rebuild the zone list.cfe	jsr oef			open emulator file now	txa			test error	beq @open_ok;	a file error has occurred when opening the iwem file and trying to read the first block.  ;	The routine hfo makes sure the file is closed so we remove the dialog ;	and exit through hzl.	;jsr	cmd		close modal dialog 	brl cfe7		init cursor & return@open_ok	; At this point the 1st 512 bytes of the emulator image		; is in the buffer. We now search for a version string		; in the buffer.	;brk $8B	ldy #$0000		index into buffer@search_string	ldx #$0000		index to our copy@str_loop	lda em_ver,x		get 2 bytes of our string	cmp writebuff,y		check in buffer	bne @next_buf		no match, move on in buffer@maybe	inx	inx	cpx #$0008		whole string?	beq @match		we're done	iny	iny			move ahead in buffer	bra @str_loop		continue compare@next_buf	phx	plx			test x	bne @no_ybump		only bump Y if X is 0	iny			move ahead in buffer@no_ybump	cpy #512-8+1		still room for our string?	bcc @search_string	start string loop again@not_found	bra try_dnload		no version, use default@match	iny	iny			point to version numeral text in buf	lda writebuff,y	sta em_ver+8	iny	lda writebuff,y		copy 3 characters	sta em_ver+9try_dnload			;issue query and see if printer wants our emulator	lda	#cfemes	ldy	#^cfemes	jsr	osd		open status dialog	_WaitCursor		jsr	stp		status the printer	tax	bne	cfe4		if some sort of error occured		jsr	otp		open the printer	tax	bne	cfe4		if some sort of error occurred		lda	#emqueryL	sta	pwrite_pblk.buflen	lda	#emquery	sta	pwrite_pblk.bufptr	lda	#^emquery	sta	pwrite_pblk.bufptr+2		shortm	lda	#1	sta	pwrite_pblk.eofbyte	longm	jsr	rfpE		read from printer	jsr	wtp		write to printer	tax	bne	cfe4		if some sort of error occurred	jsr	rfp		read from printer	cfe1	lda	pread_pblk.result	cmp	#PapBusy	beq	cfe1		if call hasn't completed	lda	readbuff	and	#$ff	cmp	#'0'	bne	cfe2		if emulator is present	jsr	dte		download the emulator	bra	cfe3		finish things up	;	The emulator is already present.cfe2	jsr	cmd		close modal dialog	jsr	ctp		close the printer	lda	#emess12	'The ImageWriter emulator is alreadyÉ'	ldy	#^emess12	jsr	damE		display alert message	bra	cfe6		close IWEM file & return			cfe3	bcc	cfe5		if no error occurredcfe4	pha	jsr	cmd		close modal dialog	pla	jsr	hpe		handle pap error		cfe5	jsr	ctp		close the printercfe6	_CloseGS  close_pblk	close IWEm filecfe7	_InitCursor;	Since the GS has been occupied for a dozen seconds, better start a new name lookup.	stz	lookupF		flag that it is ok to start name lookup	stz	lszone		force recalc of printers	stz	lszone+2	brl	hzl		handle zone list and return - regets the printer list;;	oef - open emulator file.;;	entry	ASCIIText = file type for ASCII files.;		(iwempath..) = path to the emulator file.;		read = GS/OS call # for reading a file.;		(writebuff..512) = buffer to use when writing.;;	exit	(a) = return code.;		file is opened and the first block is read in.oef	lda	#read	sta	w1		save disk op	lda	#iwempath	path to printer.setup file	sta	open_pblk+4	lda	#^iwempath			sta	open_pblk+6	lda	#writebuff	sta	rw_pblk+4	lo ptr to buffer	lda	#^writebuff	sta	rw_pblk+6	hi ptr to buffer	lda	#512	sta	rw_pblk+8	lo word of request count	stz	rw_pblk+10	hi word of request count	sta	w3		flag that file should be kept open		lda	#ASCIIText	type of file wanted	brl	hfo		handle file operation		;;	dte - download the emulator.;;	entry	[l5] = dialog pointer.;		oef must have been called successfully;;	exit	(c) set if error, (a) = error code.;; Note: On entry, the read parameter block (rw_pblk) points at a 512 byte buffer; inside the CDEV's code space, and the request count is already set t0 512.;dte	pushl	l5	pushw	#3	pushl	#dtemes	_SetIText;; 10-Jan-92 MSD	Get the file's EOF and try to allocate a handle of the same;		size.  If we get it, change the buffer pointer, rewind, and;		read the file in.  The general algorithm is:;;		repeat;			read from file;			if (no read error);				write buffer := read buffer;				while transfer count > 0;					write Min(transfer count,512) bytes to printer;					transfer count := transfer count - 512;					write buffer := write buffer + 512;		until read error;	jsr	rfp		; make sure we have an outstanding read to printer		lda	open_pblk+2	; get file's refnum	sta	geteof+2	; put in GetEOF block	sta	rewind+2	; put in SetMark block	_GetEOFGS geteof		stz	iwemHandle	; in case we don't get the handle	stz	iwemHandle+2		pha			; room for handle	pha	lda	geteof+6	pha			; push size of handle (EOF of file)	lda	geteof+4	pha			; size low	pha			; room for memory manager ID	_MMStartup		; get our user ID	pea	$C000		; locked/fixed attributes	pha			; starting address (ignored)	pha	_NewHandle	plx			; clean handle from stack	ply	bcs	@write		; didn't get it - start writing 512 bytes at a time		stx	iwemHandle	; save handle so we can dispose of it later	sty	iwemHandle+2		phd			; save D so we can deref pointer	phy			; put handle back on stack	phx	tsc	tcd			; point D at stack	lda	[1]		; get low word of pointer	sta	rw_pblk+4	ldy	#2	lda	[1],y		; get high word of pointer	sta	rw_pblk+6	pla			; remove handle	pla	pld			; restore D		lda	geteof+4	; copy EOF to request count	sta	rw_pblk+8	lda	geteof+6	sta	rw_pblk+10	_SetMarkGS rewind	; set mark to start of file;; Read the next "chunk" from the file.;@read	_ReadGS	rw_pblk		; try to read some	bcs	@readerr	; done reading;; Point PAPWrite buffer to our read buffer;@write	lda	rw_pblk+4	sta	pwrite_pblk.bufPtr	lda	rw_pblk+6	sta	pwrite_pblk.bufPtr+2;; Keep looping as long as there is more to write to the printer;@writeloop	lda	rw_pblk+14	; did we get more than 64K?	bne	@big		; yes, so do 512 bytes	lda	rw_pblk+12	; how much left?	cmp	#512		; less than a block?	blt	@gotlen		; yes, so do just what's left@big	lda	#512		; was 512 or more, so use 512@gotlen	sta	pwrite_pblk.buflen	stz	pwrite_pblk.eofbyte	; don't set the EOF flag	sep	#$20	longa	off	lda	popen_pblk.refnum	sta	pwrite_pblk.refnum	; make sure refnum is set	rep	#$20	longa	on;; Write the next 512 bytes (or less);	jsr	@pwrite			; do the PAPWrite	tax				; did we get a PAP error?	bne	@paperr			; yes, so close file an return error;; Adjust transfer count (i.e. amount left in buffer) and buffer pointer;	clc	lda	pwrite_pblk.bufPtr	adc	pwrite_pblk.buflen	sta	pwrite_pblk.bufPtr	; update buffer pointer	bcc	@nohi	inc	pwrite_pblk.bufPtr+2@nohi	sec	lda	rw_pblk+12	sbc	pwrite_pblk.buflen	sta	rw_pblk+12		; update transfer count	lda	rw_pblk+14	sbc	#0	sta	rw_pblk+14	ora	rw_pblk+12		; anything left in buffer?	bne	@writeloop		; yes, so write some more	bra	@read			; time to read some more from file@readerr	pha				; save error code;; We got an error on read (possibly EOF error).  Write zero bytes and EOF.;	stz	pwrite_pblk.buflen	inc	pwrite_pblk.eofbyte	; set EOF byte	jsr	@pwrite	tax				; was there an error?	beq	@ok			; no	plx				; remove read error code from stack	bra	@paperr			; return the pap error@ok;; Dispose of our handle, close dialog, and if error was not EOF error, then; display a message.;	jsr	@dispose		; dispose of our handle	jsr	cmd			; close modal dialog		pla				; get read error back	cmp	#eofEncountered		; was it EOF?	bne	@showerr		; no, so show the error		clc				; no error	rts@showerr	lda	#emess4	ldy	#^emess4	jmp	damE		display alert message (stop alert) and return@paperr	pha			; save error	_CloseGS  close_pblk	; close the file	jsr	@dispose	; dispose of our handle	pla			; restore error	sec	rts	@pwrite	jsr	rfp			; make sure there is an outstanding read		ldx	#<pwrite_pblk	ldy	#^pwrite_pblk	jsl	$E11014			; call AppleTalk	@pwrite1	lda	pwrite_pblk.result	cmp	#PapBusy		; still busy?	bne	@pwrite2		; no, so return		jsr	rfp			; keep reading just in case		bra	@pwrite1@pwrite2	rts@dispose	lda	iwemHandle+2		; push handle	pha	lda	iwemHandle	pha	_DisposeHandle		rts******************************************************************	IF 0 THEN	; emulator file now gets opened and closed in main routine	;jsr	oef		open emulator file	;txa	;beq	dte1		if no error occurred;	a file error has occurred when opening the iwem file and trying to read the first block.  ;	The routine hfo makes sure the file is closed so we call dte12 to remove the dialog ;	and clear the carry so we don't display a pap error.	;brl	dte12		make sure		dte0	brl	dte10		handle file error and close file	dte1	jsr	rfp		read from printer		lda	#0	bra	dte4		dte3	_ReadGS  rw_pblk	bcs	dte0		if read error occurred with file	dte4	sta	w1		save result	ldx	#0		assume we haven't reached the end	ldy	rw_pblk+$c	transfer count	cpy	#512	beq	dte5		if still more to read	ldx	#1		this is the last blockdte5	cmp	#eofEncountered	bne	dte6		if didn't hit the end	ldx	#1		reached the enddte6	sty	pwrite_pblk.buflen     amt to send	shortmx	stx	pwrite_pblk.eofbyte    =1 if this is the last packet	longmx	lda	#writebuff	sta	pwrite_pblk.bufptr	lda	#^writebuff	sta	pwrite_pblk.bufptr+2	jsr	rfp		read from printer	shortm	lda	popen_pblk.refnum	sta	pwrite_pblk.refnum	longm	ldx	#pwrite_pblk	ldy	#^pwrite_pblk	jsl	$e11014	dte7	lda	pwrite_pblk.result	cmp	#PapBusy	bne	dte8		if no longer busy 	jsr	rfp		read from printer (make sure always reading)	bra	dte7		check again	dte8	tax	bne	dte13	jsr	rfp		read from printer	lda	pwrite_pblk.eofbyte	and	#$ff	beq	dte3		if more to do	dte9	;_CloseGS  close_pblk		bra	dte12		finish things up	;	if file error occurred.dte10	;_CloseGS  close_pblkdte11	jsr	cmd		close modal dialog	lda	#emess4	ldy	#^emess4	jmp	damE		display alert message (stop alert) and returndte12	jsr	cmd		close modal dialog 	clc	rts;	if pap error occurred.dte13	pha			save error	_CloseGS  close_pblk	pla			restore error	sec	rts	ENDIF******************************************************************;	data used by this program.emquery	;dc.b	'%!PS-Adobe-2.0 Query'	;dc.b	13	;dc.b	'%%?BeginProcSetQuery IWEm 1 1'	;dc.b	13	;dc.b	'/IWEmDict where {1} {0} ifelse =='	;dc.b	13	;dc.b	'flush\n%%?EndProcSetQuery'	;dc.b	13	;dc.b	'%%EOF'	;dc.b	13	; New query 6/20/91 by Wes Johnson to have printer determine whether	; currently installed IWEm is newer than ours	dc.b	'%!PS-Adobe-2.0 Query'	dc.b	13	dc.b	'%%?BeginProcSetQuery IWEm 1 1'	dc.b	13	dc.b	'/Ver (ImageWriter Emulator 'em_ver	dc.b	'Version 1.3) def'			;break string for label	dc.b	13	dc.b	'/IWEmDict where{pop IWEmDict '	dc.b	'/Version known{Ver IWEmDict begin Version end gt}{true} ifelse}'	dc.b	'{true}ifelse {0}{1} ifelse == flush'	dc.b	13	dc.b	'% 0 = download new code, 1 = skip download'	dc.b	13	dc.b	'%%?EndProcSetQuery'	dc.b	13	dc.b	'%%EOF'	dc.b	13emqueryL  equ	*-emquerywritebuff  ds.b	512		hold blocks from the emulator file	endp	end