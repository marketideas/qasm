;;;	netpr - AppleTalk Network Printer CDEV.;;	Michael V. Stein	01/25/90.;;	© Copyright Apple Computer, 1990.;;;	routines included in this source file.;;	ccc - create cdev controls.;	ctc - close the cdev.;	alternate entrypoint:  ctcE.;	ham - handle about messsage.;	hem - handle event message;	hhm - handle hit message.;	icc - init cdev controls.;	rtc - run the cdev.;	aaf - access atinit file.;	acr - appletalk completion routine.;	ane - add next element.;	anl - add names to list.;	asf - access setup file.;	cac - create actual controls.;	cbs - change button status.;	cmd - close modal dialog.;	cnd - check for new devices.;	alternate entrypoint:  cndE.;	cps - copy pascal string.;	cst - create static text.;	ctp - close the printer.;	cus - compare uppercase strings.;	dah - dereference a handle.;	dam - display alert message.;	alternate entry point:  damE.;	dwh - disable window highlighting.;	dzl - draw zone list.;	ewh - enable window highlighting.;	fsp - find selected printer.;	fsz - find starting zone in list.;	gap - get actual pointer.;	gcp - get and compare printer type.;	gdt - get device type.;	gpn - get printer names.;	gsd - get starting device.;	gsz - get starting zone.;	ghl - get handle and length of text.;	ghp - get highlighted printer.;	ghz - get highlighted zone.;	gip - get index into printers.;	giz - get index into zones.;	gmz - get my zone.;	goa - get offset into array.;	gzl - get zone list.;	heb - handle emulator button.;	hfo - handle file operation.;	hom - handle out of memory.;	hpe - handle pap error.;	hpl - hit printer list.;	hpu - hit pop up.;	hre - handle recoverable disk error.;	hzl - hit zone list.;	alternate entry point:  hzlE.;	alternate entry point:  hzlEE.;	iai - is appletalk active.;	inb - is network boot.;	ipl - initialize printer list.;	knl - kill name lookup.;	mne - move to next element.;	alternate entrypoint:  mneE.;	omd - open modal dialog.;	osd - open status dialog.;	otp - open the printer.;	rfp - read from printer.;	snl - start name lookup.;	stp - status the printer.;	alternate entry point:  stpE.;	ubd - unload both drivers.;	udf - update data files.;	wtp - write to printer.	blanks	off	;;	equates.recty0	equ	0		rectangle offsetsrectx0	equ	2recty1	equ	4rectx1	equ	6stack_entry  equ  $e100b0	gs/os stack entry point;;	include files.	include	'::commonmacros.h'	include	'::cdev.h'	include	'::dp.h'	include	'e16.control'	include	'e16.dialog'	include	'e16.event'	include	'e16.gsos'	include	'e16.lineedit'	include	'e16.list'	include	'e16.memory'	include	'e16.quickdraw'	include	'm16.control'	include	'm16.dialog'	include	'm16.gsos'	include	'm16.intmath'	include	'm16.lineedit'	include	'm16.list'	include	'm16.memory'	include	'm16.misctool'	include	'm16.QDAux'	include	'm16.quickdraw'	include	'm16.print'	include	'm16.util2'	include	'm16.window'	include	'netprinter.h'	;;	main programmain	proc;;	exported addreses.	export	acr	export	cmd		export	cps	export	ctp	export	dah	export	dam	export	damE	export	devices	export	gdt	export	ghp	export	gip	export	hfo	export	hpe	export	hzl	export	knl	export	lookupF	export	lszone	export	mneE	export	myzonename	export	namesbuffer	export	netobj	export	omd	export	openblock	export	openblock2	export	osd	export	otp	export	plisthdl	export	rfp	export	rfpE	export	screenF	export	stp	export	stpE	export	username	export	wtp	export	zonebuffer	export	zlisthdl;;	imported addresses.	import	about	import	appletalk	import	asterisk	;import	atalkerr	import atalkerrm	import	atalkF	import	atinit:atinitrec	import	atinitlpath	import	cfe	import	choosepr	import	close_pblk	import create_pblk		;added 2/4/91 by Monte Benaresh	import	cprect	import	ctllist	import	edctl	import	edctllen	import	emess1	import	emess2	import	emess3	import	emess4	import	emess5	import	emess6	import	emess7	import	emess8	import	emess10	import	emess11	import	emess12	import	emess13	import NBPbusyMsg	import fileLockedMsg	import	entity:entityrec	import	GinfoParams	import	gmyp_pblk:NBPLType	import	gmyz_pblk	import	gup_pblk	import	iwebut	import	kill_pblk	import	oktext	import	open_pblk	import	plist	import	popen_pblk:open_printer	import	pread_pblk:read_printer	import	prec:printersetup	import	psetpr_pblk:PMSetPrinterType	import	psetuppath	import psetupname	;added 2/3/91 by Monte Benaresh toÉ	import psetupnmL	;Ésupport access of printer.setup on network boot	import	pstat_pblk:status_printer	import	ptext	import	ptypes	import	punload_pblk	import	pwrite_pblk:write_printer	import	rw_pblk	import	sm_pblk	import	tryagain	import	quit	import	rtp	import	rtpbut	import	sul	import	tryagain	import	typeptr	import	wtext	import	zlist	import	zonelist_pblk:gzonelistnetpr	phb			save calling data bank	phk	plb			set our data bank		;	make room on stack for direct page.	tsc				sec				sbc	#dpsize		make room on stack for new direct page	tcs				phd			save the current direct page	tcd			new direct page	stz cdev_result		;init result for Control Panel	stz cdev_result+2	lda	message		cmp	#11+1			bcs	netpr1		if message defintely not handled	ldx	atalkF	beq	netpr1		if appletalk isn't present			asl	a		times 2 into word table	tax			move into index reg	jsr	(t_cdev-2,x)	call the handler of this messagenetpr1	pld			restore direct page	tsc	clc	adc	#dpsize			tcs			reset the stack	lda	1,s		Bump the stack up to prepare	sta	11,s		to take off the 3 parameters	lda	3,s			sta	13,s	pla			get rid of message space		pla			get rid of data1 space	pla					pla			get rid of data2 space	pla					lda cdev_result		;result for Control Panel	sta	5,s	lda cdev_result+2	sta	7,s			plb		rtl		t_cdev	dc.w	Machine_CDEV	handle machine message	dc.w	ctcE		handle boot message - ignored	dc.w	ctcE		handle shutdown message - ignored	dc.w	icc		init cdev controls	dc.w	ctc		close the cdev	dc.w	hem		handle event message	dc.w	ccc		create cdev controls	dc.w	ham		handle about message	dc.w	ctcE		handle rectangle message - ignored	dc.w	hhm		handle hit message	dc.w	rtc		run the cdev	;	secondary routines.Machine_CDEV		;check for AppleTalk active and show alert if not;	check screen resolution in case we have to show alert box	pha			space for result	_GetMasterSCB	pla	xba	and	#$8000	sta	screenF		!= 0 if 640 mode	jsr iai			;check for AppleTalk active	bcs @no_atalk@active	inc cdev_result		;return success	rts@no_atalk	lda #atalkerrm	ldy #^atalkerrm	brl dam			;display alert box	rts			;return (default) 0 result --> failed;;	ccc - create cdev controls.;;	entry	(atalkerr..) = appletalk error message control.;		[data1] = window ptr.;		read = gs/os command to read from a file.;;	exit	if appletalk isn't installed, the appletalk error;		text control is created.;;		if appletalk is active:;		controls are created.;		the zonelist is created and sorted.;		current printer setup is read from files into prec.;		(prec..) = printer setup.;		(username..) = pascal string of the user's name.;		(selF) = 0.;		(screenF) != 0 if 640 mode;		[wptr] = window pointer.ccc	;jsr	iai		is appletalk active	;bcc	ccc1		if  active	;ldx	#atalkerr	'AppleTalk must be installed to run É'	;ldy	#^atalkerr	;brl	cst		create static text control and return	;lda #atalkerrm	;ldy #^atalkerrm	;brl dam			;display alert boxccc1	_Waitcursor	stz	selF		no selection was made yet	stz	pmatch	stz	pmatch+2		stz	pindex		init printer index	stz zonenamehdl	stz zonenamehdl+2	;no name handle yet;	next code moved to MachineCDEV by Monte Benaresh -- 12/3/91	;pha			space for result	;_GetMasterSCB	;pla	;xba	;and	#$8000	;sta	screenF		!= 0 if 640 mode	ldx	#<GInfoParams	ldy	#^GInfoParams	jsl	$E11014		; get completion routine return address	lda	GInfoParams+GetInfo.CompRtnRet	sta	compret+1	; modify the JML instruction	lda	GInfoParams+GetInfo.CompRtnRet+1	sta	compret+2		lda	data1	sta	wptr		save window pointer for later	lda	data1+2	sta	wptr+2	jsr	inb		is network boot	lda	#read	jsr	asf		access printer setup file		;	The printer name stored at prec.printer is not very useful for the;	imagewriter LQ.  It stores 'ImageWriter.LQ' when what I really need;	is the typename to use for lookups, etc.  So If the name stored at;	prec.printer is 'ImageWriter.LQ' I change it to be a pascal string;	of 'LQ'.  This way I change it here at the start and don't have to special;	case the LQ printer all over the place in the code.	lda	#2+1	sta	devices	jsr	gcp		get and compare printer	bne	ccc2		if not imagewriter LQ	lda	#2|('L'<<8)	sta	prec.printer	lda	#'Q'	sta	prec.printer+2	ccc2	;brk $81	lda	#read	jsr	aaf		access atinit file	lda	#atinit.name	sta	l2		source loc	lda	#^atinit.name	sta	l2+2	lda	#prec.name	sta	l1		dest loc	lda	#^prec.name	sta	l1+2	ldx	#15		max of 15 chars	jsr	cpsE		copy pascal string	lda	#username	sta	l1	lda	#^username	sta	l1+2	jsr	cps		copy pascal string;	next 3 lines moved out of gzl for better generality	jsr	gsd		get starting device	lda	devices	sta	ldwpns		last device with printer name selected	jsr	gzl		get zone list	stz NBPBusyF		assume NBP not busy	jsr	gpn		get printer names	cmp #$0408		too many NBP lookups active?	bne @lookup_ok		no, continue@cant_lookup	dec NBPBusyF		set flag to display message at init time@lookup_ok	jsr	ipl		initialize printer list	jsr	cac		create actual controls	lda	zlisthdl	lo word of list handle	ldy	zlisthdl+2	hi word of list handle	jsr	sul		sort uppercase list	stz	zindex		zone index of 0		;	since szl will only sort the names, now go through list, find the local;	zone and show it as selected.	jsr	fsz		find starting zone		jsr	dzl		draw zone list	_InitCursor	rts			;;	ctc - close the cdev.;;	entry	called when to close the cdev and appletalk is active.;;	exit	name lookup is stopped.;		files are updated and memory is disposed.;;	alternate entrypoint:  ctcE.;;	ctcE is used as a convenient rts instruction.ctc	lda	#$ffff	sta	lookupF		flag to not start any more lookups	jsr	knl		kill name lookup	jsr	udf		update data files	pushl	zonenamehdl	_DisposeHandle		get rid of memory we allocatedctcE	ctc1	rts	;;	ham - handle about messsage.;;	entry	(about..) = static text control containg the about text.;;	exit	The 'about' control is created.ham	ldx	#about	ldy	#^about	brl	cst		create static text control and return		;;	hem - handle event message;;	entry	[data1] = ptr to event record.;		(emess1..) = text for the alert box.;;	exit	if user tries typing an illegal char then a sysbeep is;		generated and the event is changed to a null event.;		if the user tries to type too many characters then an alert box;		is displayed and the event is changed to a null event.hem	ldy	#owhat	lda	[data1],y	get what type of event occurred	cmp	#keyDownEvt	beq	hem1		if user typed something	cmp	#autoKeyEvt	bne	hem5		if not an auto key event then returnhem1	ldy	#omessage	lda	[data1],y	and	#$ff	cmp	#':'	beq	hem2		if user tried to type a colon	cmp	#'/'	bne	hem3		if user didn't try to type a slash	hem2*** 25-Aug-92 DAL -- use SysBeep2	pea $0008		;sbBadKeypress	_SysBeep2*** end 25-Aug-92;;;	_SysBeep	bra	hem4		remove event and return	;	check if typing in too many characters.hem3	jsr	ghl		get handle and length of text	cmp	#unamelen	bcc	hem5		if ok	ldy	#omessage	lda	[data1],y	get char	and	#$ff	cmp	#$7f			beq	hem5		if typed in a delete	cmp	#$18			beq	hem5		if typed in a clear key	cmp	#$9	beq	hem5		if typed in a tab key	cmp	#$8		beq	hem5		if typed in a left arrow	cmp	#$15	beq	hem5		if typed in a right arrow		lda	#emess1		'user name can only be 31 characters'	ldy	#^emess1	jsr	dam		display alert messagehem4	lda	#nullEvt	ldy	#owhat	sta	[data1],y	remove the eventhem5	rts	;;	hhm - handle hit message.;;	entry	[data1] = handle to control.;		[data2] = id of control that was hit.;;	exit	control hit is processed.hhm	lda	data2		get id of control that was hit	cmp	#4+1	bcs	hhm1		if not important control	asl	a	tax	jmp	(hhmtab-2,x)	jump to the proper handler and return	hhm1	rts			hhmtab	dc.w	hpu		hit pop-up	dc.w	hpl		hit printer list	dc.w	hzl		hit zone list	dc.w	heb		hit emulator button	;;	icc - init cdev controls.;;	entry	(atalkF) = 0 if appletalk isn't active.;;	exit	zone list is drawn if appletalk is active.icc	lda	atalkF	beq	icc1		if appletalk is not active	;brl	dzl		draw zone list and return	jsr	dzl		draw zone listicc1	rts;;	rtc - run the cdev.;;	entry	(lookupF) != 0 if not to do any more lookups.;;	exit	if lookups are allowed and out window is the frontmost, it starts a ;		lookup if the last one has stopped.rtc	lda NBPBusyF		check flag for NBP busy	beq @NBP_ok	stz NBPBusyF		clear flag	lda	#NBPbusyMsg	'A network search is already activeÉ'	ldy	#^NBPbusyMsg	jsr	dam		display alert message@NBP_ok;	next code to check for zones appearing after none could;	be found adapted from AppleShare CDEV v2.0 by Mark Day;;	added 11/16/91 by Monte Benaresh	lda zonelist_pblk.numberzones	and #$00FF		;keep byte only	bne @have_zones		;we found zones, all OK	jsr gzl			;no zones, try to find them now	pushl	#0		standard draw routine	pushw	#1			pushl	#$ffffffff	use current listref	pushw	#$ffff		use current listrefdesc	pushw	zlist+$1a	size of list	pushl	zlisthdl	handle of list control record	_NewList2	lda	zlisthdl	lo word of list handle	ldy	zlisthdl+2	hi word of list handle	jsr	sul		sort uppercase list	stz	zindex		zone index of 0		;	since szl will only sort the names, now go through list, find the local;	zone and show it as selected.	jsr	fsz		find starting zone		jsr	dzl		draw zone list@have_zones	lda	lookupF	bne	rtc1		if not to look for new devices	pha	pha	_FrontWindow	pla	plx	cmp	wptr	bne	rtc1		if no longer the front window	cpx	wptr+2	bne	rtc1		if no longer the front window	brl	cnd		check for new devices and return	rtc1	rts;	teriary routines called by the message handling routines.;;	aaf - access atinit file.;;	entry	(a) = disk operation $2012 = read, $2013 = write.;		(netbootF) != 0 if booted over network.;		(atinitlpath..) = path to use when local boot.;		(atinitnpath..) = path to use when on network.;		atalkfile = file type for appletalk files.;;	exit	file is read or written.;		(c) set if error.aaf	sta	w1		save disk op (read or write)	lda	#atinitlpath	ldx	#^atinitlpath	assume local boot		ldy	netbootF	beq	aaf5		if local boot		_FSTSpecific  gup_pblk	get user path	lda	gup_pblk+6	sta	l1	lda	gup_pblk+6+2	sta	l1+2;	copy over path to user's folder.	shortmx	lda	[l1]	sta	w5		# to copy	ldy	#2	ldx	#0aaf1	cpx	w5	bcs	aaf2		if done	lda	[l1],y	sta	netobj+2,x	save here for now	iny	inx	bra	aaf1		move next char	;	add over the final ':Setup:ATINIT'aaf2	ldy	#0aaf3	cpy	#aafaL	bcs	aaf4		if done	lda	aafa,y		get next char of ending string	sta	netobj+2,x	iny	inx	bra	aaf3		process next char	aaf4	lda	w5	clc	adc	#aafaL	longmx	and	#$ff	sta	netobj		length of gs/os string	lda	#netobj	ldx	#^netobj		aaf5	sta	open_pblk+4	lo ptr to pathname	stx	open_pblk+6	hi ptr to pathname	lda	#atinit		ptr to buffer	sta	rw_pblk+4	lda	#^atinit	sta	rw_pblk+6		lda	#atinitrec.sizeof	sta	rw_pblk+8	request count	stz	rw_pblk+10			stz	w3		close file when done			lda	#appletalkfile	type of file wanted	brl	hfo		handle file operation and return;	data used here.aafa	dc.b	':Setup:ATINIT'aafaL	equ	*-aafa		length of this portion of path	;;	acr - appletalk completion routine.;;	entry	called by the appletalk routines with a jsl when an asynch call ;		has completed.;;	exit	(calcompF) = $ffffacr	lda	#$ffff	sta	>callcompF	flag that the call completedcompret	jml	0		; jump back to AppleTalk		;;	ane - add next element.;;	entry	[l1] =  ptr to current spot in the namelist.;		[l4] =  ptr to current record in list manager list.;;	exit	entry is added to list.;		[l1] = ptr to next spot in the namelist.;		[l4] = ptr to next element in the list manager list.;	copy new element into our list.ane	ldy	#entityrec.netnum	lda	[l1],y			ldy	#memrec.netnum	sta	[l4],y		lda	l1	clc	adc	#entityrec.objname	ldy	#memrec.memptr	sta	[l4],y		lda	l1+2	adc	#0	ldy	#memrec.memptr+2	sta	[l4],y		shortmx	ldy	#entityrec.nodeid	lda	[l1],y	ldy	#memrec.nodeid	sta	[l4],y		ldy	#entityrec.scktnum	lda	[l1],y	ldy	#memrec.scktnum	sta	[l4],y		ldy	#entityrec.enumerator	lda	[l1],y	ldy	#memrec.enumerator	sta	[l4],y	ldy	#memrec.memflag	lda	#0	sta	[l4],y		mark it as not selected	longmx	ane3	jsr	mne		move to next element	lda	l4	clc	adc	#memrec.sizeof	sta	l4	bcc	ane4		if didn't cross bank	inc	l4+2ane4	rts				;;	anl - add names to list.;;	entry	(gymp_pblk..) = parameter block for getting printer list.;		MaxSrvrs = max number of printers per zone to worry about.;		(openblock..) = current printer name list.;		(openblock2..) = new printer name list.;		[plisthdl] = handle to printer list.;		(plistsize) = current size of printer list.;;	exit	if the number of printers has changed then this routine will ;		recreate the printer list with the info from the new call.anl	lda	gmyp_pblk.rgotten	and	#$ff	cmp	plistsize	beq	anl3		if same size  (branch doesn't reach bottom);	different # of objects, so copy openblock2 to openblock.	shortm	ldx	#MaxSrvrs*(99+5)-1anl1	lda	openblock2,x	sta	openblock,x	dex	bne	anl1	longm	lda	#openblock	sta	l1	lda	#^openblock	sta	l1+2		lda	#0	sta	w5	jsr	gip		get index into printers [l4]	lda	gmyp_pblk.rgotten	and	#$ff	sta	w6		responses received	anl2	lda	w5		current index	cmp	w6		compare against total	bcs	anl4		if done	jsr	ane		add next element		inc	w5		bump the counter	bra	anl2		process next element	anl3	rtsanl4	lda	w6	sta	plistsize	new size of list	jsr	ghp		get highlighted printeranl6	pushl	#0		standard draw routine	pushw	#1			pushl	#$ffffffff	use current listref	pushw	#$ffff		use current listrefdesc	pushw	plistsize	size of list	pushl	plisthdl	handle of list control record	_NewList2					lda	plisthdl	lo word of list handle	ldy	plisthdl+2	hi word of list handle	jsr	sul		sort uppercase list		stz	pindex				jsr	fsp		find starting printer	pushw	pindex		index of printer, might be zero	pushl	plisthdl	_SelectMember2		scroll list so current zone is shown	lda	#noHilite	assume laserwriter	ldx	pindex	bne	anl7		if a match was found		lda	#inactiveHiliteanl7	brl	cbs		chnage button status and return			;;	asf - access setup file.;;	entry	(a) = operation to perform $2012 = read, $2013 = write.;		(psetuppath..) = path to printer.setup file if local boot.;		(prec..+printersetup.sizeof) = buffer to use.;		Binary = filetype for binary files.;		printersetup = record describing format of printer.setup file;		sel2F = flag whether printer.setup dirty;;	exit	file is read or written.asf	sta	w1		save disk op	; network boot support added 2/3/91 by Monte Benaresh	;brk $93	cmp #$2013		do we intend to write the file?	bne @read	lda sel2F		did user select a printer?	bne @cont		yes, update the file@untouched	clc	rts			return without writing b/c no change@cont@read	ldy	netbootF	beq	asf_loc		if local boot		_FSTSpecific  gup_pblk	get user path	lda	gup_pblk+6	sta	l1	lda	gup_pblk+6+2	sta	l1+2;	copy over path to user's folder.	shortmx	lda	[l1]	sta	w5		# to copy	ldy	#2		source index	ldx	#0		dest index@cpy_loop	cpx	w5	bcs	up_done		if done	lda	[l1],y	sta	netobj+2,x	save here for now	iny	inx	bra	@cpy_loop	move next char	;	add over the final ':Setup:ATINIT'up_done	ldy	#0@cpy2_loop	cpy	#psetupnmL	bcs	fn_done		if done	lda	psetupname,y	get next char of ending string	sta	netobj+2,x	iny	inx	bra	@cpy2_loop		process next char	fn_done	lda	w5	clc	adc	#psetupnmL	longmx	and	#$ff	sta	netobj		length of gs/os string	lda	#netobj	ldx	#^netobj	bra asf_set_path		asf_loc	;sta	open_pblk+4	lo ptr to pathname	;stx	open_pblk+6	hi ptr to pathname	lda	#psetuppath	path to printer.setup file	ldx	#^psetuppathasf_set_path		sta	open_pblk+4	lo ptr to pathname	stx	open_pblk+6	hi ptr to pathname	lda	#prec	sta	rw_pblk+4	lo ptr to buffer	lda	#^prec	sta	rw_pblk+6	hi ptr to buffer		lda	#printersetup.sizeof	sta	rw_pblk+8	request count	stz	rw_pblk+10		stz	w3		close file when done	lda	#Binary		type of file wanted	brl	hfo		handle file operation and return		;;	cac - create actual controls.;;	entry	(ctllist..) = table of long ptrs to control templates.;		[data1] = ptr to window.;		(devices) = index of current printer type.;		(edctl..) = template for line edit control.;		(choosepr..) = template for the popup menu.;		(iwebut..) = template for emulator button.;		(plist..) = template for printer list.;		(rtpbut..) = template for rename button.;		(zlist..) = template for zone list.;;	exit	controls and created and program control falls into;		cbs to set the buttons appropriately.;		[edctl] = handle to lineedit control.;		[iwebuthdl] = handle to emulator button control.;		[plisthdl] = handle to printer list control;		[rtpbuthdl] = handle to rename button control.;		[zlisthdl] = handle to zone list control.cac	lda	devices	ina	sta	choosepr+$20	set initial item in popup		pha			space for result	pha	pushl	data1		window pointer	pushw	#3		next item is a ptr to a list of template pointers	pushl	#ctllist	_NewControl2	pla	pla			don't care about result	pha	pha			space for result	pushl	data1		window pointer	pushw	#0		next item is a control	pushl	#zlist	_NewControl2	pulll	zlisthdl	handle to control	pha	pha			space for result	pushl	data1		window pointer	pushw	#0		next item is a control	pushl	#plist	_NewControl2	pulll	plisthdl	handle to control	pha	pha			space for result	pushl	data1		window pointer	pushw	#0		next item is a control	pushl	#edctl			_NewControl2	pulll	edithdl		handle to control	pha	pha			space for result	pushl	data1		window pointer	pushw	#0		next item is a control	pushl	#iwebut	_NewControl2	pulll	iwebuthdl	handle to control		lda	#inactiveHilite	;	routine falls into cbs and returns.  Obviously things will work better;	if cbs is the next routine.		;;	cbs - change button status.;;	entry	(a) = new status for emulator button (inactive or nohilite).;		(devices) = type of device.;		[iwebuthdl] = handle to emulator button control.;;	exit	If the button is set to inactive then the emulator button is set ;		to inactive.  If the button is set to nohilite then if the current ;		device is a laserwriter then the emualtor is set to nohilite, else it is ;		set to inactive.cbs	pha			save on stack for emulator button	cmp	#noHilite	bne	cbs1		if making inactive	lda	devices	beq	cbs1		if laserwriter	lda	#inactiveHilite	sta	1,s		only laserwriter can use imagewriter emulator	cbs1	pushl	iwebuthdl	_HiliteControl;	to eliminate annoying flicker due to a possibly pending update;	event, let's validate the button's control rect	pei l1+2		;save old values just in case	pei l1	lda iwebuthdl	sta l1	lda iwebuthdl+2	sta l1+2	lda [l1]		;deref control handle	clc	adc #octlRect		;make ptr to rect	tax	ldy #2	lda [l1],y	bcc @no1_carry	inc a@no1_carry	sta l1+2	stx l1	ldy #6			;init offset to last word@rect_loop	lda [l1],y	sta tempRect,y	dey	dey	bpl @rect_loop	pla	sta l1			;restore ptr	pla	sta l1+2	pea tempRect>>16	pea tempRect	_ValidRect	rtstempRect	ds.w 4			;space for copy of control rect	;;	cmd - close modal dialog.;;	entry	[l5] = dialog pointer.;;	exit	dialog is closed.;		window highlighting enabled.cmd	pushl	l5		close the dialog	_CloseDialog	brl	ewh		enable window highlighting and return	;;	cnd - check for new devices.;;	entry	(calcompF0 = 0 if last asynch call didn't complete.;		(gymp_pblk..) = paramater block to get printers in selected zone.;		(lookupF) = 0 if ok to do lookup.;;;	exit	If (lookupF) is true then the current name lookup is killed and the;		routine exits.  Else if the current call hasn't completed then;		the routine simply exits.  If the call has completed, the retry counts;		are updated and the list is updated if the size has changed.  If it finds;		no printers it will retry once else will assume that is correct.  Then;		a new lookup is started.;;	alternate entrypoint:  cndE.;;	cndE will start a new lookup.cnd	lda	lookupF	beq	cnd1		if ok to do lookup	brl	knl		kill name lookup and return	cnd1	lda	callcompF	beq	cnd8		if previous call didn't complete		lda	gmyp_pblk.retryper	and	#$ff	cmp	#5	bcs	cnd2		if at maximum	ina	shortm	sta	gmyp_pblk.retryper	increment retry period	sta	gmyp_pblk.retrycnt	increment retry count	longm	cnd2	lda	gmyp_pblk.rgotten  # found so far	and	#$ff		255 max	cmp	plistsize	bcs	cnd3		if found something	dec	cnda			bpl	cnd4		if should try again	cnd3	lda	#1	sta	cnda		reset retry counter			jsr	anl		add names to list	;	start another lookup.	cndE	cnd4	jsr	ghz		get highlighted zone	beq	cnd5		if no other zones		dea	jsr	giz		get index into zones [l4]		lda	#myzonename	sta	l2	lda	#^myzonename	sta	l2+2		ldy	#memrec.memptr	lda	[l4],y	sta	l1	iny	iny	lda	[l4],y	sta	l1+2			jsr	cus		comapre uppercase strings	bcc	cnd6		if didn't select the current zone	cnd5	lda	#asterisk	the asterisk represents the current zone in search	sta	l3	lda	#^asterisk	sta	l3+2	bra	cnd7	cnd6	lda	l1		save ptr to zone name to search	sta	l3	lda	l1+2	sta	l3+2	cnd7	stz	callcompF 	call not completed	brl	snl		start name lookup and return	cnd8	rts					cnda	dc.w	1	;;	cps - copy pascal string.;;	entry	[l1] = ptr to destination string;		[l2] = ptr to source string.;;	exit	string is copied.cps	ldx	#$ffcpsE	stx	w1		save max # of chars to copy	shortmx	lda	[l2]	sta	w2		length of source string	ldy	#0	cps1	sty	w3		current index	cpy	w1	bcc	cps2		if not past max count	bne	cps4		if past max count	cps2	cpy	w2	bcc	cps3		if not past source string length	bne	cps5		if done	cps3	lda	[l2],y		get char from source string	sta	[l1],y		place into destination string	iny	bne	cps1		if didn't wrap, process next char	bra	cps5		finish things up	cps4	dey	tya	sta	[l1]		replace new lengthcps5	longmx	rts;;	cst - create static text.;;	entry	[x,y] = ptr to control.;		[data1] = window ptr.;;	exit	control is created.cst	pha			space for result	pha	pushl	data1		window pointer	pushw	#0		next item is a ptr to a control	phy			hi word of control	phx			lo word of control	_NewControl2		create the control	pla	pla			don't care about result	rts			;;	ctp - close the printer.;;	entry	(popen_pblk.refnum) = refnum of open connection.;;	exit	printer connection is closed.ctp	ldx	#punload_pblk	ldy	#^punload_pblk	jsl	$e11014		close all printer connections	rts	;;	cus - compare uppercase strings.;;	entry	[l1] = ptr to first pascal string.;		[l2] = ptr to second pascal string.;;	exit	strings are compared case insensitive.;		(c) set if strings are equal.cus	shortmx	lda	[l1]	sta	w1	cmp	[l2]	bne	cus4		if string lengths are different			ldy	#0cus1	iny	sty	w3	lda	[l1],y	cmp	#'a'	bcc	cus2		if not lowercase	cmp	#'z'+1	bcs	cus2		if not lowercase	sbc	#$20-1		(c) clear	cus2	sta	w2		save	lda	[l2],y	cmp	#'a'	bcc	cus3		if not lowercase	cmp	#'z'+1	bcs	cus3		if not lowercase	sbc	#$20-1		(c) clear	cus3	cmp	w2	bne	cus4		if strings don't match	cpy	w1	bcc	cus1		if more to check	longmx	rts			(c) set, strings match	cus4	longmx	clc	rts			strings don't match			;;	dah - dereference a handle.;;	entry	[a,x] = handle to dereference.;;	exits	(a) = upper word of dereferenced handle.;		[l1] = dereferenced handledah	sta	l2	stx	l2+2	lda	[l2]	sta	l1		lo ptr	ldy	#2	lda	[l2],y	sta	l1+2		hi ptr	rts			;;	dam - display alert message.;;	entry	[a,y] = ptr to message.;;	exit	centered caution alert displayed.;;	alternate entry point:  damE.;;	entry	[a,y] = ptr to message.;;	exit	centered stop alert is displayed.dam	sec	skip1			damE	clc	ror	damF		save type wanted for now	sta	dammsg		save message ptr	sty	dammsg+2	_InitCursor		make sure cursor is reset	ldx	#(320-damw)/2	lda	screenF	bpl	dam1		if 320 mode	ldx	#(640-damw)/2dam1	stx	damtemp+2	left edge	txa	clc	adc	#damw	sta	damtemp+6	right edge	pha	pushl	#damtemp	template	pushl	#0		no filter		jsr	dwh		disable window highlighting		lda	damF	bpl	dam2		if user wants a stop alert		_CautionAlert	bra	dam3dam2	_StopAlert		dam3	jsr	ewh		enable window highlighting		pla			ignore item hit but get it off the stack	rts		damt	equ	60damb	equ	140damh	equ	damb-damtdaml	equ	170damr	equ	470damw	equ	damr-damldamtemp dc.w	damt,daml,damb,damr	dc.w	2376		id	dc.b	$80	dc.b	$80	dc.b	$80	dc.b	$80	dc.l	okitem	dc.l	damstr	dc.l	0okitem	dc.w	ok		okay button	dc.w	damh-17,190,damh-4,260	dc.w	buttonItem	dc.l	oktext,0,0damstr	dc.w	1348		text item	dc.w	5,75,5+6*9,280	dc.w	StatText+ItemDisabledammsg	dc.l	0,0,0	damF	dc.w	0	;;	dwh - disable window highlighting.;;	entry	none.;;	exit	window highlighting disabled.dwh	pha	pushw	#$0001		flag for disabling window highlighting	_WindowGlobal	pla	rts;;	dzl - draw zone list.;;	entry	(zindex) = item # of selected zone.;		[zlisthdl] = handle to zone list.;;	exit	list is redrawn so current item is displayed.dzl	pushw	zindex		index of zone	pushl	zlisthdl	_SelectMember2		scroll list so current zone is shown	rts		;;	ewh - enable window highlighting.;;	entry	none.;;	exit	window highlighting enabled.ewh	pha	pushw	#$FFFE		flag for enabling window highlighting	_WindowGlobal	pla	rts;;	fsp - find selected printer.;;	fsp is called when we have a new printer list.  It goes through the list;	to see if the default printer specified in the printer.setup file is ;	in this list.  If it is, then the routine selects the printer.;;;	entry	(namesbuffer..) = list manager list for printer list.;		(plistsize) = size of printer list for zone.;		(prec..) = info from printer.setup file.;;	exit	If the specified printer in the printer.setup file is found then;		printer drivers are unloaded.;		entry is selected.;		[cszone] = ptr to zone that is selected.;		(pindex) = index of selected printer.;		[pmatch] = ptr to entry that is selected.;		(selF) = 1.fsp0	rtsfsp	stz	w4			init counter		lda	plistsize		get size of list	sta	w5			# to check	lda	#namesbuffer	sta	l3	lda	#^namesbuffer	sta	l3+2	fsp1	lda	w4			get index	cmp	w5			compare against total	bcs	fsp0			if not found	inc	w4			bump up ctr		ldy	#memrec.memptr	lda	[l3],y	sta	l1			lo ptr to name		iny	iny	lda	[l3],y	sta	l1+2			hi ptr to name			lda	#prec.netname		name of printer specified in printer.setup	sta	l2	lda	#^prec.netname	sta	l2+2		jsr	cus			compare uppercase strings	bcs	fsp2			if matched	brl	fsp6fsp2	lda	prec.zone	and	#$ff	beq	fsp3			if no zone named in file		lda	cszone	clc	adc	#memrec.memptr	sta	l1			lo word of ptr to selected zone record	lda	cszone+2	adc	#0	sta	l1+2			hi word of ptr to selected zone record	ldy	#memrec.memptr	lda	[l1],y	tax	iny	iny	lda	[l1],y	sta	l1+2	stx	l1			[l1] = ptr to currently selected zone		lda	#prec.zone	sta	l2				lda	#^prec.zone	sta	l2+2	jsr	cus			compare uppercase strings	bcc	fsp6			if zones don't match	fsp3	jsr	gcp			get and compare printer type	bcc	fsp6			if device types don't match		lda	prec.appletlk	beq	fsp6			if not appletalk printer	shortmx	lda	#memselected	ldy	#memrec.memflag	sta	[l3],y			mark it as selected	longmx		lda	#1	sta	selF			flag that something is selected		lda	l3	sta	pmatch			lo word of ptr	lda	l3+2	sta	pmatch+2		hi word of ptr		lda	w4			current index in list (has been incremented)	sta	pindex			item that is selected in list	jsr	ubd			unload both drivers	bra	fsp7				fsp6	shortmx	ldy	#memrec.memflag	lda	#0	sta	[l3],y			mark it as not selected	longmx	fsp7	lda	l3	clc	adc	#memrec.sizeof	sta	l3	bcc	fsp8			if didn't cross bank	inc	l3+2fsp8	brl	fsp1;;	fsz - find starting zone in list.;;	This routine is called to see if a specified zone is in our zone list.;	If the zone is in the list, it is selected.;;;	entry	(zonebuffer..) = list manager list containing zone list.;		(zonename..) = name of zone to look for.;		(zlist..) = zone list control template.;;	exit	If the zone is found:;		zone is selected.;		[cszone] = ptr to zone in list.;		[lszone] = ptr to zone in list.;		(zindex) = index of zone that was selected.fsz	stz	w4		init counter	lda	zlist+$1a	get list size	sta	w5		# to check	lda	#zonebuffer	sta	l3	lda	#^zonebuffer	sta	l3+2	lda	#zonename	sta	l2	lda	#^zonename	sta	l2+2	fsz1	lda	w4		get index	cmp	w5		compare against total	bcs	fsz3		if not found	inc	w4		ldy	#memrec.memPtr	lda	[l3],y	sta	l1	iny	iny	lda	[l3],y	sta	l1+2			jsr	cus		compare uppercase string	bcs	fsz2		if found a match;	move to next element.	lda	l3	adc	#memrec.sizeof	(c) clear	sta	l3	bcc	fsz1		if didn't cross bank	inc	l3+2	bra	fsz1		process next entry	;	found a match.fsz2	lda	l3	sta	cszone		save current zone selection	sta	lszone	lda	l3+2	sta	cszone+2	sta	lszone+2		shortmx	ldy	#memrec.memflag	lda	#memselected	sta	[l3],y		select the current printer	longmx		lda	w4	sta	zindex		index of zone in list		fsz3	rts	;;	gap - get actual pointer.;;	gap will retrieve the pointer to a string in an entry in a ;	list manager list.;;;	entry	[l4] = ptr to this entry in list manager list.;;	exit	[l2] = ptr to string for this item.gap	ldy	#memrec.memptr	lda	[l4],y	sta	l2		low owrd of ptr	iny	iny	lda	[l4],y	sta	l2+2		high word of ptr	rts;;	gcp - get and compare printer type.;;	entry	(prec.printer..) = name of last selected printer type.;;	exit	(c) set if the name of the last selected printer type is same as current.gcp	jsr	gdt		get device type [l2]		lda	#prec.printer	sta	l1	lda	#^prec.printer	sta	l1+2	brl	cus		compare uppercase strings and return;;	gdt - get device type.;;	entry	(devices) = index of printer type in table.;		(typeptr..) = ptrs to printer type names.;;	exit	[l2] = name of current printer type.gdt	lda	devices		type of printer	asl	a	tax	lda	typeptr,x	sta	l2	lda	#^typeptr	bank	sta	l2+2	rts;;	gpn - get printer names.;;	entry	(zonename..) = pascal string containing zone name to look in.;;	exit	name lookup is started.gpn	lda	#zonename	sta	l3	lda	#^zonename	sta	l3+2	brl	snl		start name lookup and return	;;	gsd - get starting device.;;	entry	none.;;	exit	(devices) = 2 if printer is imagewriter LQ.;		(devices) = 1 if printer is an imagewriter.;		(devices) = 0 if printer is laserwriter, or if;			      none of the others are found.;		(c) set if found device in printer.setup file.gsd	ldx	#0gsd1	stx	devices		index	jsr	gcp		get and compare printer type	bcs	gsd2		if found starting type	ldx	devices	inx	cpx	#2+1	bcc	gsd1		if more to check	stz	devices		couldn't find it so default to laserwriter	clc	gsd2	rts				;;	gsz - get starting zone.;;	entry	(appletalk..) = pascal string of "Appletalk".;		(myzonename..) = pascal string of user's zone.;		(prec.appletlk) = 0 if not an appletalk printer.;		(prec.port..) = pascal string describing connection.;		(prec.zone..) = pascal string of printer's zone in file.;;	exit	;;	if the printer.setup file shows appletalk on, the current printer,;	the port is correct, a zone is specified and the user has more than one;	zone, then set 'zonename' equal to the zone in the printer.setup file.  ;;	else, set 'zonename' equal to myzonename.;;;	if no zone in the printer.setup file and there is a current zone, copy the zone;	name into lzwpns.  Else if there is no current zone and there is a zone;	specified in the printer.setup file, remove the name from prec and lzwnps, else;	set lzwpns to the zone specified in the printer.setup file.gsz	lda	prec.appletlk	beq	gsz1		if not appletalk printer selected		jsr	gcp		get and compare printer type	bcc	gsz1		if not same type of printer		lda	#prec.port	sta	l1	lda	#^prec.port	sta	l1+2	lda	#appletalk	string 'Appletalk'	sta	l2	lda	#^appletalk	sta	l2+2	jsr	cus		compare uppercase strings	bcc	gsz1		if not appletalk printer		lda	myzonename	and	#$ff	beq	gsz1		if there is no other zones		lda	prec.zone	and	#$ff	beq	gsz1		if no zone specified in file;	use the zone in the printer.setup file as the starting zone.	lda	#prec.zone	sta	l2	lda	#^prec.zone	sta	l2+2	bra	gsz2		;	use my current zone as the starting zone.gsz1	lda	#myzonename	sta	l2	lda	#^myzonename	sta	l2+2	gsz2	lda	#zonename	sta	l1	lda	#^zonename	sta	l1+2	jsr	cps		copy pascal string	lda	#lzwpns	sta	l1		dest loc for eventual copy	lda	#^lzwpns	sta	l1+2		lda	zonename	and	#$ff	beq	gsz3		if don't have a zone name		lda	prec.zone	and	#$ff	bne	gsz4		if a zone is specified in printer.setup			lda	#zonename	source loc	ldx	#^zonename	bra	gsz6		copy zonename to lzwpns	gsz3	lda	prec.zone	and	#$ff	beq	gsz5		if no name in setup file	gsz4	lda	zonename	and	#$ff	bne	gsz5		if a zonename is present		stz	prec.zone	no zone name	stz	lzwpns		no zone name	bra	gsz7	gsz5	lda	#prec.zone	ldx	#^prec.zonegsz6	sta	l2		lo source ptr	stx	l2+2		hi source ptr	brl	cps		copy pascal string and return	gsz7	rts		;;	ghl - get handle and length of text.;;	entry	[edithdl] = handle to linedit control.;;	exit	(a) = length of text.;		[l1] = ptr to text.ghl	lda	edithdl			ldx	edithdl+2	jsr	dah		derefence a handle	pha			space on stack	ldy	#octlData+2	lda	[l1],y	pha			hi word	tax			save for later	dey	dey	lda	[l1],y	pha			lo word		pha			space on stack	pha			space on stack	phx			hi word	pha			lo word	_LEGetTextHand	pla			lo byte of handle to text	plx			hi word of handle to text	jsr	dah		derefence a handle	_LEGetTextLen		data is already on stack	pla			length of field	rts;;	ghp - get highlighted printer.;;	entry	[plisthdl] = handle to printer list control.;;	exit	(a) = item # of highlighted printer.ghp	pha			space for call	pushw	#0		start from top of list	pushl	plisthdl	use printer list	_NextMember2	pla	rts;;	ghz - get highlighted zone.;;	entry	[zlisthdl] = handle to zone list control.;;	exit	(a) = item # of highlighted zone.	ghz	pha			space for result	pushw	#0		start from top of list	pushl	zlisthdl	_NextMember2	pla			selected zone, or 0 if none selected	rts			;;	gip - get index into printers.;;	entry	(a) = index of desired printer.;		(namesbuffer..) = printer list definition.;;	exit	[l4] = ptr to entry in namesbuffer list.gip	jsr	goa		get offset into array	clc	adc	#namesbuffer	sta	l4		low word of ptr	tya	adc	#^namesbuffer	sta	l4+2		high word of ptr	rts			;;	giz - get index into zones.;;	entry	(a) = index of desired zone.;		(zonebuffer..) = zone list definition.;;	exit	[l4] = ptr to entry in zonebuffer list.giz	jsr	goa		get offset into array		clc	adc	#zonebuffer	sta	l4		low word of ptr	tya	adc	#^zonebuffer	sta	l4+2		hi word of ptr	rts;;	gmz - get my zone.;;	entry	(gmyz_pblk..) = parameter block to get current zone.;;	exit	(myzonename..) = pascal string containing user's zone.gmz	ldx	#gmyz_pblk	ldy	#^gmyz_pblk	jsl	$e11014		gmz1	lda	gmyz_pblk+2	cmp	#busy	beq	gmz1		if request not finished yet	tay	beq	gmz2		if no error		stz	myzonename	assume no name for zonegmz2	rts		;;	goa - get offset into array.;;	entry	(a) = offset desired.;		memrec.sizeof = size of each element;;	exit	[l4] = offset of entrygoa	pha	pha			space for call	pha			element wanted	pushw	#memrec.sizeof	_Multiply	pla	sta	l4		low word of ptr	ply	sty	l4+2		high word of ptr	rts	;;	gzl - get zone list.;;	entry	(ginfoprarams..) = parameter block to get appletalk info.;		maxzones = max # of zones to worry about.;		namelen = max length of object names.;		(zlist..) = zone list control template.;		(zonelist_pblk..) = parameter block to get zone list.;;	exit	[cszone] = 0.;		(devices) = starting device.;		(ldwpns) = starting device.;		[lszone] = 0.;		[zonenamehdl] = handle to memory for zone list.;		(zonebuffer..) = list mamanger list containing zones.;;		if there is for memory for zonenamehdl, routine exits to hom.gzl		shortm	lda	GinfoParams+getinfo.ABridge	sta	bridge			sta	zonelist_pblk.brnode	longm	lda zonenamehdl	ora zonenamehdl+2	;do we have this handle yet?	bne gzl_haveHndl	;yes, don't allocate again	lda	#maxzones*(namelen+1+5)  	gzl1	pha			space for result	pha			space for result	pushw	#0		hi word of size to create	pha			lo word of size to create	pha			space for memory id	_MMStartup		put control panel mem ID on stack	pushw	#attrLocked		 	pha	pha	_NewHandle	pla	sta	zonenamehdl	pla	sta	zonenamehdl+2	bcc	gzl3		if no memory problems	gzl2	brl	hom		handle out of memory and returngzl_haveHndlgzl3	lda	bridge	beq	gzl6		if no bridge	jsr	gmz		get my zone	lda	#3	sta	w1gzl4	lda	zonenamehdl	ldx	zonenamehdl+2	jsr	dah		derefence a handle	sta	zonelist_pblk.bufptr+2    hi word	lda	l1	sta	zonelist_pblk.bufptr	  lo word	gzl5	ldx	#zonelist_pblk	ldy	#^zonelist_pblk	jsl	$e11014			lda	zonelist_pblk.numberzones  	and	#$ff		only 255 possible	bne	gzl6		if got some zones	dec	w1	bne	gzl5		if should try againgzl6	sta	zlist+$1a	size of list - total # of zones that were found;	next 3 lines moved to ccc so this routine could be used by rtc	;jsr	gsd		get starting device	;lda	devices	;sta	ldwpns		last device with printer name selected		jsr	gsz		get starting zone	;	now create all of the pointers to the pascal strings in zonenames.	lda	zonenamehdl	ldx	zonenamehdl+2	jsr	dah		dereference a handle	lda	#zonebuffer	sta	l2	lda	#^zonebuffer	sta	l2+2	stz	w2		current index into list	gzl9	ldy	#memrec.memptr	lda	l1	sta	[l2],y		low ptr to this string	iny	iny	lda	l1+2	sta	[l2],y		high ptr to this string		shortmx	ldy	#memrec.memflag	lda	#0	sta	[l2],y		entry is not selected	longmx		lda	l2	clc	adc	#memrec.sizeof	sta	l2	bcc	gzl10	inc	l2+2gzl10	jsr	mneE		move to next element	lda	w2		current index into zone list	ina	sta	w2	cmp	zlist+$1a	compare against total zones	bcc	gzl9		if more zones to do			lda	#1	sta	zlist+$20	start at top of list		stz	cszone	stz	cszone+2	nothing is currently selected		stz	lszone	stz	lszone+2	nothing was selected		rts		;;	heb - handle emulator button.;;	entry	user has clicked on the imagewriter emulator button.;;	exit	the current name lookup is killed then the program ;		attempts to download the emulator.heb	lda	#$ffff	sta	lookupF	jsr	knl		kill name lookup	brl	cfe		check for emulator and return;;	hfo - handle file operation.;;	entry	(a) = type of file wanted.;		appletalkfile = file type for appletalk files.;		(close_pblk..) = parameter block for closing gs/os file.;		(diskerror) != 0 if get error previously.;		(emess2..) = volume not found error message.;		(emess3..) = access denied error message.;		(emess4..) = i/o error message.;		(emess5..) = write protect error message;		(emess6) = disk full error message.;		(open_pblk..) = parameter block for gs/os open call.;		(rw_pblk..) = parameter block for gs/os read/write calls.;		(sm_pblk..) = parameter block for setting a file mark.;		(w1) = gs/os command, read = $2011, write = $2012;		(w3) != 0 if file is to be kept open after operation.;;	exit	(c) set if file operation couldn't be performed.;		(close_pblk..) has refnum set so the file can be closed.;		(diskerror) = error #,  =1 if user quit.		hfo	sta	w2		save type of file wanted for now	lda	#1	sta	w4		assume no error	stz diskerr		clear error word	hfo1	_OpenGS  open_pblk	ldx	open_pblk+2	file reference number	stx	close_pblk+2	stx	sm_pblk+2	stx	rw_pblk+2	bcc	hfo3		if no problemshfo_open_err	stz	w4		flag that an error occurred	stz	close_pblk+2	clear ref num so we won't close	cmp #fileNotFound	bne @err2@not_there	ldx w2			get type of file	cpx #Binary		is it printer.setup?	bne @err2		no, continue error handling@psetup_missing	lda w1			check caller command	cmp #$2013		do we intend to write?	beq @create		if writing, create it@clear	;			no printer.setup to read, so clear rec in mem	ldx #printersetup.sizeof-2	point to last word@clr_loop	stz prec,x	dex	dex	bpl @clr_loop	stz prec		clear 1st byte in case size was odd number	bra hfo1a		return error if anyone cares@create	lda	open_pblk+4	lo ptr to pathname	ldx	open_pblk+6	hi ptr to pathname	sta create_pblk+2	copy to create params	stx create_pblk+2+2	_CreateGS create_pblk	bcc hfo1		try again to open it	bra hfo_open_err	handle error@err2	cmp	#volnotfound	bne	hfo2		if not a volume not found problem	lda	#emess2	ldy	#^emess2	jsr	hre		handle recoverable disk error	tax	bmi	hfo1a		if user wants to quit	bra	hfo1		try againhfo1a	sec	ldx	#1	stx	diskerr	rtshfo2	cmp	#invalidAccess	bne	hfo4		if not an invalid access problem, give generic message	lda	#emess3		'Access Denied error.  É'	bra	hfo5		uses same bank as emess4	hfo3	lda	open_pblk+$e	get filetype of file	cmp	w2	beq	hfo6		if found the correct file	_CloseGS  close_pblk	make sure it gets closedhfo4	lda	#emess4		'Havng trouble accessing printer data files É'hfo5	ldy	#^emess4	jsr	dam		display alert message	bra	hfo10a		finish things uphfo6	lda	w2	cmp	#appletalkfile	bne	hfo7		if not atint file, no need to set mark	_SetMarkGS  sm_pblk	bcs	hfo4		if an error occured of some sort - should never happen		hfo7	pushl	#rw_pblk	parameter block	;lda	w1	pushw	w1		either $2012 or $2013	jsl	stack_entry	make the call	bcc	hfo11		if no error		stz	w4		flag an error	cmp	#$2b	bne	hfo7a		if not a write-protect error		lda	#emess5	ldy	#^emess5		jsr	hre		handle recoverable error	tax	bmi	hfo10a		if user wants to quit	bra	hfo7		try againhfo7a	cmp	#invalidAccess	bne	hfo8		if not an invalid access problem	lda open_pblk+$C	;get access word	and #$0002		;check write enable	bne @vol_access_err	;not locked file, must be access denial@file_locked	lda #fileLockedMsg	ldy #^fileLockedMsg	;tell user file is locked	bra hfo_show@vol_access_err	lda	#emess3		'Access Denied' error	bra	hfo10			hfo8	cmp	#volumeFull	bne	hfo9		if volume full error	lda	#emess6		'The disk is full.  É'	bra	hfo10		uses same bank as emess4	hfo9	lda	#emess4hfo10	ldy	#^emess4hfo_show	jsr	dam		display alert message	_CloseGS  close_pblk	make sure it gets closed	hfo10a	lda	#1	sta	diskerr		flag error for next file	hfo11	ldx	w4	bne	hfo13		if no error ever occurred	pushl	#cprect	_InvalRect		invalidate the control panel rectanglehfo13	lda	w3	bne	hfo14		if user wants file left open	lda	close_pblk+2	check if we ever opened	beq hfo14		invalid ref num, don't close	_CloseGS  close_pblkhfo14	ldx	diskerr		error flag	rts		;;	hom - handle out of memory.;;	entry	program wasn't able to get memory wanted.;;	exit	memory dialog displayed and removed.;		(atalkF) = 0.hom	stz	atalkF		pretend there is no appletalk	lda	#emess7		'There is not memory to continue'	ldy	#^emess7	brl	damE		display stop alert and return;;	hpe - handle pap error.;;	entry	(a) = error.;		(emess10..) = error message for when printer is not responding.;		(emess11..) = error message for when network error.;		(emess13..) = error message for when printer can't be found.;;	exit	error message is displayed in a centered stop alert.	hpe	cmp	#$805	bne	hpe1		if not a name not found error	cmp	#$807	bne	hpe1		if not a network error	lda	#emess13	'The selected printer could not be found'	bra	hpe3hpe1	cmp	#$808	bne	hpe2		if not a server not responding error	lda	#emess10	'The selected printer is not responding...'	bra	hpe3hpe2	lda	#emess11	'A network error has occurred...'hpe3	ldy	#^emess11	bank is the same for all messages	brl	damE		display alert message and return;;	hpl - hit printer list.;;	entry	user clicked in an entry in the printer list.;		Atalkon = flag to indicate that appletalk is on.;		(devices) = index of device type.;		[plisthdl] = handle to printer list control.;		[zlisthdl] = handle to zone list control.;;	exit	emulator button is highlighted if laserwriter.;		(ldwpns) = (devices).;		(lzwpns..) = last zone with printer name selected.;		(prec.appletlk) =  Atalkon.;		(prec.netname..) = pascal string containing printer name.;		(sel2F) = 1.hpl	jsr	ghp		get highlighted printer	beq	hpl2		if nothing selected, exits		ldx	#1	stx	selF		flag that a selection was made	stx	sel2F		flag that printersetup might have changed		dea	jsr	gip		get index into printers  [l4]		lda	#noHilite	jsr	cbs	jsr	gap		get actual pointer		lda	#prec.netname	sta	l1	lda	#^prec.netname	sta	l1+2	jsr	cps		copy pascal string		stz	prec.zone	stz	lzwpns		jsr	ghz		get highlighted zonehpl2	beq	hpl3		if no zone is selected		dea	jsr	giz		get index into zones  [l4]		jsr	gap		get actual pointer		lda	#lzwpns		last zone with printer name selected	sta	l1	lda	#^lzwpns	sta	l1+2	jsr	cps		copy pascal string		lda	#prec.zone	sta	l1	lda	#^prec.zone	sta	l1+2	jsr	cps		copy pascal stringhpl3	lda	devices	sta	ldwpns		last device with printer name selected	; next code added 9/16/91 by Monte Benaresh	cmp #2			ImageWriterLQ?	bne @not_LQ;	For ImageWriterLQ we leave our "internal" version of the printer;	name in the printer.setup image, which is "LQ".	lda #$0002	sta prec.printer	set length byte & next byte as garbage	lda #'QL'		'LQ'	sta prec.printer+1	bra @name_done@not_LQ	jsr gdt			get device type in [l2]	lda	#prec.printer	sta	l1	lda	#^prec.printer	sta	l1+2	jsr	cps		copy pascal string@name_done	lda	#ATalkOn	sta	prec.Appletlk	rts		;;	hpu - hit pop up.;;	entry	user has selected an item from the popup.;		[data1] = handle to popup control.;		(devices) = current device type.;		(ldwpns) = last device with printer name selected.;		(lzwpns..) = last zone with printer name selected.;		(selF) != 0 if selection was made.;;	exit	if the user chose the same as current nothing is done. Else a new printer;		list is generated for this zone.hpu	pha			space for result	pushl	data1		ptr to control	_GetCtlValue	pla	dea	cmp	devices	beq	hpu9		if the same as previous printer type		sta	devices		new device type to use		lda	ldwpns		last device with printer name selected	cmp	devices	bne	hpu1		if not the same as selected device		lda	SelF	beq	hpu1		if no selection	pha			space for result	pushl	zlisthdl	handle to list control	_ResetMember2		unselect the current zone	pushl	zlisthdl		_DrawMember2		redraw the zone unselected		lda	#lzwpns	sta	l2	lda	#^lzwpns	sta	l2+2	lda	#zonename	sta	l1	lda	#^zonename	sta	l1+2	jsr	cps		copy pascal string			jsr	fsz		find starting zone	jsr	dzl		draw zone listhpu1	jsr	ghz		get highlighted zone	beq	hpu8		if no zones		stz	lszone	stz	lszone+2	force it to recalculate	brl	hzlE		handle zone list  (will get new list of printers) and returnhpu8	brl	hzlEE		handle zone list and returnhpu9	rts;;	hre - handle recoverable disk error.;;	entry	[a,y] = ptr to message.;;	exit	centered stop alert displayed.;		(a) = 0 if user wants to try again.;		(a) = $ffff if user wants to quit.hre	sta	hremsg		lo ptr to text	sty	hremsg+2	hi ptr to text	jsr	dwh		disable window highlighting	_InitCursor		ldx	#(320-hrew)/2	lda	screenF	bpl	hre1		if 320 mode	ldx	#(640-hrew)/2hre1	stx	hredlg+2	txa	clc	adc	#hrew	sta	hredlg+6	pha	pushl	#hredlg		alert template	pushl	#0		no filter	_StopAlert	pla			get item hit	cmp	#ok	bne	hre2		if user wants to quit	lda	#0	rtshre2	lda	#$ffff	rtshrel	equ	10hrer	equ	310hrew	equ	hrer-hrelhret	equ	60hreb	equ	130hreh	equ	hreb-hrethredlg	dc.w	hret,hrel,hreb,hrer	dc.b	$b1,$82	dc.b	$80,$80,$80,$80	dc.l	hretext,hrecanc,hreok,0hreok	dc.w	ok		ok button	dc.w	hreh-17,165,hreh-4,165+100	dc.w	ButtonItem	dc.l	tryagain,0,0hrecanc dc.w	cancel		quit button	dc.w	hreh-17,35,hreh-4,35+100	dc.w	ButtonItem	dc.l	quit,0,0hretext dc.w	3		text item	dc.w	5,75,5+4*9,hrew	dc.w	StatText+ItemDisablehremsg	dc.l	0		ptr to text message	dc.l	0,0	;;	hzl - hit zone list.;;	entry	user clicked in the zone list to select a zone.;		[lszone] = ptr to last selected zone.;;	exit	if the selected zone hasn't changed, routine just returns, else;		the current name lookup is stopped.;		a new name lookup is started with the selected zone.;		buttons are inactivated.;		[lszone] = ptr to zone the user clicked on.;		(pindex) = 0.;		[pmatch] = 0.;		(plistsize) = 0.;;	alternate entry point:  hzlE.;;	(a) = item # of zone.;;	alternate entry point:  hzlEE.;;	force routine to kill current lookup and restart a name lookup.hzl	jsr	ghz		get highlighted zonehzlE	dea	jsr	giz		get index into zones [l4]	ldx	l4	stx	cszone		lo ptr to record of selected zone	lda	l4+2	sta	cszone+2	hi ptr to record of selected zone	cmp	lszone+2	bne	hzl1		if not the same zone			cpx	lszone	beq	hzl2		if selected the same zone as before	hzl1	stx	lszone	sta	lszone+2	save for next comparisonhzlEE	jsr	knl		kill name lookup	stz	pmatch	stz	pmatch+2		stz	pindex		nothing selected	stz	plistsize	flag nothing valid			pushl	#0		use standard	pushw	#1		item # of first displayed member	pushl	#$ffffffff	use current value for listref	pushw	#$ffff		no change to listref descriptor	pushw	#0		size of list	pushl	plisthdl	handle to list	_NewList2			lda	#inactiveHilite	jsr	cbs		change button status	brl	cndE		check for new devices and return	hzl2	rts	;;	iai - is appletalk active.;;	entry	(iaia..) = gs/os parameter block to get the device # of appletalk driver.;;	exit	(c) set if appletalk driver isn't active.;		(atalkF) = 0 if no appletalk, else = 1.iai	_GetDevNumberGS  iaia	lda	#1		asssume found	bcc	iai1		if no error - appletalk active	deaiai1	sta	atalkF		set flag	rtsiaia	dc.w	2		two parameters	dc.l	iaib		ptr to device name	ds.b	2		result - not used	iaib	dc.w	iaiblen			dc.b	'.APPLETALK'iaiblen	equ	*-iaib-2	;;	inb - is network boot.;;	entry	(inba..) = gs/os parameter block to get info on boot device.;;	exit	(c) set if network boot.;		(netbootF) != 0 if this was a network boot.inb	_DinfoGS  inba		get device info on boot device	stz	netbootF	assume not network boot	lda	inba+$14	get device id	cmp	#$1e			bne	inb1		if not appleshare fst	sta	netbootF	flag that this is a network bootinb1	rts		inba	dc.w	8		8 parameters needed	dc.w	1		want info on the boot device	dc.l	bootdev		buffer to name of boot device	ds.b	14		hold results;;	ipl - initialize printer list.;;	ipl is used to go through the printer list and mark all of the;	items as unselected.;;	entry	maxsrvrs = max # of printers to worry about per zone.;		(namesbuffer..) = printer list.;;	exits	every element is unselected.;		(plistsize) = 0.ipl	stz	w1		init counter	lda	#namesbuffer	sta	l1	lda	#^namesbuffer	sta	l1+2	stz	plistsize	nothing in the listipl1	shortmx	ldy	#memrec.memflag		lda	#0	sta	[l1],y	longmx	lda	w1	ina	sta	w1		bump up counter	cmp	#maxsrvrs	bcs	ipl2		if done		lda	l1	adc	#memrec.sizeof	(c) clear	sta	l1	bcc	ipl1		if didn't cross bank	inc	l1+2	bra	ipl1		process next entry	ipl2	rts	;;	knl - kill name lookup.;;	entry	(kill_pblk..) = parameter block to stop name lookup.;;	exit	lookup is stopped.;		(gmyp_pblk.retryper) = 1 for next name lookup call.;		(gymp_pblk.retrycnt) = 1 for next name lookup call.knl	ldx	#kill_pblk	ldy	#^kill_pblk	jsl	$e11014	shortm	lda	#1	sta	gmyp_pblk.retryper	reset retry period for intial look	sta	gmyp_pblk.retrycnt	reset retry count for initial look	longm	rts;;	mne - move to next element.;;	mne is used to move past an entry in the buffer that is created;	by a name lookup call.;;	entry	[l1] = ptr to current entry in buffer.;;	exit	[l1] = ptr to next entry in buffer.;;	alternate entrypoint:  mneE.;;	mneE will move past a pascal string.;;	entry	[l1] = ptr to start of pascal string.;;	exit	[l1] = ptr is moved past the stringmne	lda	l1	clc	adc	#5	sta	l1	bcc	mne1		if no carry into hi word	inc	l1+2mne1	jsr	mneE		get past type field	jsr	mneE		get past zone field twice;	routine jsr's to here from above since that is the most efficient;	way of doing this.mneEmne2	lda	[l1]			and	#$ff		get length of field	sec	adc	l1		add in length of string + length byte	sta	l1	bcc	mne3		if no carry into hi word	inc	l1+2mne3	rts;;	omd - open modal dialog.;;	entry	[a,y] = fwa of dialog template.;;	exit	modal dialog is opened.;		window highlighting is turned off.;		[l5] = dialog pointer.omd	pha			space for result	pha		phy			hi ptr to dialog template	pha			lo ptr to dialog template	jsr	dwh		disable window highlighting	_GetNewModalDialog	pla			get dialog pointer	sta	l5	pla	sta	l5+2	rts;;	osd - open status dialog.;;	osd is used to create a dialog containg just a status message.;;	entry	[a,y] = ptr to text to display in dialog.;		dlgw = width of dialog.;		(osdlg..) = dialog template.;		(screenF) = $8000 if 640 mode.;;	exit	dialog is created and displayed.osd	sta	osdptr	sty	osdptr+2		save ptr to text;	adjust the location	ldx	#(320-dlgw)/2	lda	screenF	bpl	osd1		if 320 mode	ldx	#(640-dlgw)/2osd1	stx	osddlg+2	left edge	txa	clc	adc	#dlgw	sta	osddlg+6	right edge	lda	#osddlg	ldy	#^osddlg	jsr	omd		open modal dialog 		pushl	l5	_DrawDialog	rts;	data used here.dlgt	equ	60dlgb	equ	122dlgh	equ	dlgb-dlgtdlgl	equ	170dlgr	equ	470dlgw	equ	dlgr-dlglosddlg	dc.w	dlgt,dlgl,dlgb,dlgr	rectangle	dc.w	$ffff		visisble	dc.l	0		refcon	dc.l	osditem	dc.l	0	osditem  dc.w	3		item id	dc.w	20,46,60,300	rectangle	dc.w	statText+ItemDisable	typeosdptr	dc.l	0		ptr	dc.w	0		value	dc.w	0		flag	dc.l	0		color table	;;	otp - open the printer.;;	entry	(popen_pblk..) = parameter block to open a printer connection.;		[pstat_pblk.prname] = ptr to printer name.;;	exit	(a) = result code.otp	lda	pstat_pblk.prname	move ptr to name over	sta	popen_pblk.prname	lda	pstat_pblk.prname+2	sta	popen_pblk.prname+2  		ldx	#popen_pblk	get low word pointer to parameter list	ldy	#^popen_pblk	get high word pointer to parameter list	jsl	$e11014otp1	lda	popen_pblk.result	cmp	#papbusy	bne	otp2		if no longer busy	bra	otp1	otp2	rts;;	rfp - read from printer.;;	rfp is used to keep a constant read coming from the printer so;	there is never a time when the printer is waiting to send status.;	The data read from the printer is ignored.;;	entry	(popen_pblk.refnum..) = refnum of open connection.;		(pread_pblk..) = parameter block to read from printer connection.;;	exit	read request is started if the last one has stopped.rfp	lda	pread_pblk.result	cmp	#PapBusy	beq	rfp1		if last call hasn't finished yet	rfpE	shortm	lda	popen_pblk.refnum	sta	pread_pblk.refnum	longm		lda	#512	sta	pread_pblk.buflen		ldx	#pread_pblk	get low word pointer to parameter list	ldy	#^pread_pblk	get high word pointer to parameter list	jsl	$e11014	rfp1	rts				export	readbuff	readbuff	ds.b	512					;;	snl - start name lookup.;;	entry	none.;;	exit	namelookup is started.;		(lookupF) = 0.snl	lda	#('='<<8)+1	one char string of '='	sta	netobj		any object	lda	#netobj+2	sta	l1	lda	#^netobj+2	sta	l1+2	jsr	gdt		get device type [l2]	jsr	cps		copy pascal string	jsr	mneE		move to next elementsnl1	lda	l3		lo ptr to zonename to check	sta	l2	lda	l3+2		hi ptr to zonemname to check	sta	l2+2	jsr	cps		copy pascal string	stz	lookupF		don't stop the lookup	ldx	#gmyp_pblk	ldy	#^gmyp_pblk	jsl	$e11014	lda gmyp_pblk.result	get result in case caller cares	rts;;	stp - status the printer.;;	entry	a printer is selected.;		(pstat_pblk..) = parameter block to status a printer.;;	exit	(a) = result code.;		(netobj2..) = printer tuple.;;	alternate entry point:  stpE.;;	entry	[pstat_pblk.prname] = ptr to printer tuple.stp	jsr	ghp		get highlighted printer	dea			offset into list (always is 1 selected)	jsr	gip		get index into printers	ldy	#memrec.memptr	lda	[l4],y	sta	l2		lo word of ptr to name	iny	iny	lda	[l4],y	sta	l2+2		hi word of ptr to name	lda	#netobj2	sta	pstat_pblk.prname	sta	l1	lda	#^netobj2	sta	pstat_pblk.prname+2	sta	l1+2	jsr	cps		copy pascal string		jsr	mneE		move to next element	jsr	gdt		get device type	jsr	cps		copy pascal string	jsr	mneE		move to next element	lda	cszone	ora	cszone+2	bne	stp1		if have selected a zone		lda	#asterisk	current zone	bra	stp2	stp1	lda	#lzwpns		last zone with printer name selectedstp2	sta	l2	lda	#^lzwpns	sta	l2+2	jsr	cps		copy pascal string	stpE	jsr	knl		kill name lookup		ldx	#pstat_pblk	ldy	#^pstat_pblk	jsl	$e11014	stp3	lda	pstat_pblk.result	cmp	#papbusy	beq	stp3		if not done yet	rts		;;	ubd - unload both drivers.;;	entry	none.;;	exit	printer drivers are unloaded if necessary.ubd	pha			space for result	_PMStatus			pla	bcs	ubd1		if error occured	beq	ubd1		if print manager isn't active	pushw	#0		want to unload both drivers	_PMUnloadDriverubd1	rts		;;	udf - update data files.;;	entry	none.;;	exit	atinit and printer.setup are created.udf	jsr	ghl		get LineEdit handle and length	sta	udfa		length of text		shortx	ldy	#0udf1	lda	[l1],y		move the name over	sta	udfa+1,y		iny	iny	cpy	udfa	bcc	udf1		if more to copy	longx;	copy the user's name into the printer setup record.	lda	#udfa	sta	l2	lda	#^udfa	sta	l2+2		source loc		lda	#prec.name	sta	l1	lda	#^prec.name	sta	l1+2		dest	ldx	#15		# of chars to copy 	jsr	cpsE		copy pascal string	;	copy the user's name into the ATINIT record.	lda	#atinit.name	sta	l1	lda	#^atinit.name	sta	l1+2	jsr	cps		copy pascal string	;	copy the zone over into the printer setup record.	lda	bridge	bne	udf1a		if there is a bridge	lda	#asterisk	use asterisk for current zone	sta	l2		source ptr	lda	#^asterisk	bra	udf1b			udf1a	lda	#lzwpns		last zone with printer name selected	sta	l2	lda	#^lzwpnsudf1b	sta	l2+2	lda	#prec.zone	sta	l1		dest ptr	lda	#^prec.zone	sta	l1+2	jsr	cps		copy pascal string	lda	sel2F	beq	udf2		if no selection was made		lda	#1	sta	prec.AppleTlk	flag that appletalk is on		lda	#appletalk	sta	l2		source ptr	lda	#^appletalk	sta	l2+2		ptr to the string "appletalk"	lda	#prec.port	sta	l1		dest ptr	lda	#^prec.port	sta	l1+2	jsr	cps		copy pascal string		lda	ldwpns		last device with printer name selected	cmp	#2	bne	udf1c		if not imagewriterLQ	ina			increase so it returns the correct nameudf1c	sta	devices	jsr	gdt		get device type		lda	#prec.printer	sta	l1		dest ptr	lda	#^prec.printer	sta	l1+2	jsr	cps		copy pascal string		lda	ATINIT.pflags	and	#$9f		mask off local printer (bit 6) and emulator bit (bit 5)	ora	#networkprinter	  flag as network printer		ldx	devices	bne	udf1d		if not laserwriter	ora	#emulatorBit	flag that this printer has a postscript emulator	udf1d	sta	ATINIT.pflags	replace the flag byte	jsr	ubd		unload both drivers	udf2	stz	diskerr		assume no error has occurred so far	lda	#write	jsr	asf		access setup file		;	copy over the printer tuple: net, printer, zone.	lda	ldwpns	sta	devices	jsr	gdt		get device type		shortmx	ldx	#-1udf3	inx	lda	prec.netname,x	 copy over netname	sta	atinit.tuple,x	cpx	prec.netname	bcc	udf3		if more to copy		lda	[l2]	sta	w1		save length of typename for now		ldy	#-1udf4	inx	iny	lda	[l2],y		get next char of typename	sta	atinit.tuple,x	cpy	w1	bcc	udf4		if more to copy		ldy	#-1udf5	inx	iny	lda	lzwpns,y	last zone with printer name selected	sta	atinit.tuple,x	cpy	lzwpns	bcc	udf5		if more to copy		longmx		lda	#write	jsr	aaf		access atinit file		lda	prec.appletlk	beq	udf6		if not appletalk printer  	lda	#prec.port	sta	l2	lda	#^prec.port	sta	l2+2	lda	#appletalk	sta	l1	lda	#^appletalk	sta	l1+2	jsr	cus		    compare uppercase strings	bcc	udf6		    if not appletalk printer			shortm	lda	#1	sta	psetpr_pblk.flags    want to retrieve current settings	longm		lda	#openblock2	    lo ptr to dummy buffer to use	sta	psetpr_pblk.entity	lda	#^openblock2	    hi ptr to dummy buffer to use	sta	psetpr_pblk.entity+2	ldx	#psetpr_pblk	ldy	#^psetpr_pblk	jsl	$e11014	shortm	lda	ATINIT.pflags	    get flag byte to use	sta	psetpr_pblk.flags	longm	lda	#ATInit.tuple		low ptr to entity name	sta	psetpr_pblk.entity	lda	#^ATInit.tuple		hi ptr to entity name	sta	psetpr_pblk.entity+2	ldx	#psetpr_pblk	ldy	#^psetpr_pblk	jsl	$e11014udf6	rts		;	data used here.udfa	ds	namelen+5				;;	wtp - write to printer.;;	entry	(popen_pblk.refnum) = connection refnum.;		(pwrit_pblk..) = parameter block for write command.;;	exit	data is written to printer;		(a) = result code.wtp	shortm	lda	popen_pblk.refnum	sta	pwrite_pblk.refnum	longm	ldx	#pwrite_pblk	ldy	#^pwrite_pblk	jsl	$e11014	wtp1	lda	pwrite_pblk.result	cmp	#PapBusy	beq	wtp1			if still busy 	rts;	uninitialized data.bootdev	ds.b	35		holds name of boot device - not usedbridge	ds.b	2		bridge # callcompF  ds.b	2		!= 0 if call completedcszone	ds.b	4		ptr tp currently selected zonedevices	ds.b	2		offset of type of devicediskerr	ds.b	2		!= 0 if got a disk erroredithdl	ds.b	4		handle to edit box controliwebuthdl  ds.b	4		handle to emulator button controlldwpns	ds.b	2		last device with printer name selectedlookupF	ds.b	2		!= 0 if to look for new deviceslszone	ds.b	4		ptr to last selected zonelzwpns	ds.b	namelen+1	last zone with printer name selectedmyzonename  ds.b	namelen+1	name of user's home zonenamesbuffer ds.b	memrec.sizeof*MaxSrvrsnetbootF  ds.b	2		!= 0 if network bootnetobj	ds.b	100		build network entity herenetobj2  ds.b	100		hold nameopenblock  ds.b	MaxSrvrs*(99+5)	 holds memory for call to get printer namesopenblock2  ds.b  MaxSrvrs*(99+5)	 holds memory for call to get printer names	pindex	ds.b	2		offset of printer in listplisthdl  ds.b	4		handle to printer list control recordplistsize  ds.b	2		size of printer listpmatch	ds.b	4		ptr to printer name in listscreenF	ds.b	2		= $8000 if this is a 640 mode screenselF	ds.b	2		!= 0 if a selection was madesel2F	ds.b	2		!= 0 if printersetup might have changedusername  ds.b	33		user namewptr	ds.b	4		window pointerzindex	ds.b	2		index to zoneszlisthdl  ds.b	4		handle to zone list control	zonebuffer  ds.b	memrec.sizeof*maxzones  list of zones for list manager		zonename  ds.b	33		name of zonezonenamehdl  ds.b	4	handle to zonename list from nbp callNBPBusyF	ds.w 1		flag to say we couldn't lookup b/c NBP was busycdev_result	ds.l 1		;result for Control Panel	endp	end