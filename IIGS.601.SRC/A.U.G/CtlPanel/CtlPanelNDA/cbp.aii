;;;	cbp - check battery parameters.;;	Michael V. Stein	05/01/90.;;	© Copyright Apple Computer, 1990.	blanks	off;;	equates.aug_param  equ	$5e		 bit 0 set means no closed captioning				;bit 1 set means standard time				;      clear if daylight savings time				;bit 2 set means not to have auto daylight savings				;      clear means to have auto daylight savings				;bit 3 and 4 are the amount of menublink to have;;	include files.	include	'::commonmacros.h'	include	'm16.menu'	include	'm16.misctool';;	main program.file	proc;;	exported addresses.	export	cbpcbp	phb	phk	plb		jsr	cad		check auto daylight savings***	jsr	cmb		check menublink	plb	rtl;;	ats - adjust the time by seconds.;;	entry	[a, x] = amount of seconds to adjust clock.;;	exit	clock is adjusted.ats	sta	atsa		save change for now	stx	atsa+2	pha			space for result	pha			space for result	pushw	#6		get current time based on seconds	pushl	#0	pushl	#buff		buffer to use	ldx	#$3703	jsl	$e10000		convert seconds;	adjust the seconds.		lda	1,s	clc	adc	atsa	sta	1,s	lda	1+2,s	adc	atsa+2	sta	1+2,s			plx			lo word of seconds	ply			hi word of seconds	pha			space for result	pha			space for result	pushw	#7		set current time based on seconds	phy			hi word of seconds	phx			lo word of seconds	pushl	#buff		buffer to use		pushw	#$e1e1		kludge to get around bug in misc tools	plb			kludge to get around bug in misc tools	plb			kludge to get around bug in misc tools			ldx	#$3703	jsl	$e10000		convert seconds	pla	plx		phk			kludge to get around bug in misc tools	plb			kludge to get around bug in misc tools		rts		atsa	ds.b	2buff	ds.b	10;;	cad - check auto daylight savings.;;	entry	battery RAM is as defined above.;;	exit	If the machine thinks it is not synched with the;		real status of daylight savings, the clock is either;		advanced or decreased by an hour.cad	ldx	#aug_param			jsr	rbp		read battey parameter	sta	cada	tax	and	#$4	bne	cad3		if no auto daylight savings check	phx	jsr	gds		get daylight savings flag	pla	and	#2	bne	cad1		if machine thinks this is standard time	;	machine thinks this is daylight savings time.	bcc	cad3		if it actually is daylight savings;	fall back one hour.	lda	cada	ora	#$2		set bit 1 - it is standard time	pha			save new value for now	lda	#-3600	ldx	#^-3600	bra	cad2	;	machine thinks that this is standard time.cad1	bcs	cad3		if actually is standard time;	spring ahead one hour.		lda	cada	and	#$fd	pha		lda	#3600	ldx	#^3600	cad2	jsr	ats		adjust time in seconds 	pla	ldx	#aug_param	jmp	wbp		write battery parameter and returncad3	rtscada	dc.w	0;;	cmb - check menu blink.;;	entry	none.;;	exit	menu blink is set as battery params dictate.;;;cmb	ldx	#aug_param;	jsr	rbp		read battery parameter;	lsr	a;	lsr	a;	lsr	a		;	and	#$3		amt of menublink to use;	pha;	_SetMItemBlink;	rts;;;	gds - get daylight status.;;	entry	none.;;	exit	(c) set if standard time, clear if daylight savings.gds	pha			space for result	pha			space for result	pha			space for result	pha			space for result	_ReadTimeHex	lda	6,s		get month and filler	and	#$ff		remove filler	cmp	#3	bcc	gds1a		if not at least april, standard time		cmp	#3	bne	gds3		if not april	;	see if past the first sunday in april.	lda	5,s	and	#$ff		get day of month	cmp	#6+1	bcs	gds9		if definetly past the first sunday of the month		tax	stx	gdsa		save for now		lda	8,s		get day of week	and	#$ff		remove extra garbagegds1	cmp	#1	beq	gds2		if found the first sunday of the month	dea	dex	bpl	gds1		if more to check in the monthgds1a	bra	gds8		if definetly standard time	gds2	cpx	gdsa	bne	gds9		if past the first sunday of april	;	today is the first sunday of april.	lda	3,s		get hour and year	and	#$ff		remove year	cmp	#2	bcs	gds9		if in daylight savings	bra	gds8		if standard time	gds3	cmp	#9	bcc	gds9		if defintely daylight savings	bne	gds8		if defintely standard time		lda	5,s	and	#$ff		get day of month in low bye	cmp	#30-6	bcc	gds9		if definetly in daylight savings	tax	stx	gdsa	lda	8,s		get day of week	and	#$ff		remove extra garbage	gds4	cmp	#1	beq	gds7		if found the last sunday of the month	ina	cmp	#8	bcc	gds5		if haven't wrapped	lda	#1		reset to sundaygds5	inx	cpx	#30+1	bcc	gds4		if more to check in the month	bra	gds8		if defintely standard time	gds7	cpx	gdsa	bne	gds9		if before the last sunday of the month	;	today is the last sunday of october.	lda	3,s		get hour and year	and	#$ff		remove year	cmp	#2	bra	gds10		(c) set if standard time	gds8	sec			flag standard time	bra	gds10gds9	clc			flag daylight savings timegds10	plx			clear off stack	plx	plx	plx	rtsgdsa	dc.w	0		scratch value;;	rbp - read battery parameter.;;	entry	(x) = parameter to read.;;	exit	(a) = value of parameter.rbp	pha			space for result	phx			parameter to read	_ReadBparam	pla			get value	rts;;	wbp - write battery parameter.;;	entry	(a) = value of parameter to set.;		(x) = battery parameter to set.;;	exit	battery parameter is set.wbp	pha			new value	phx			parameter to set	_WriteBparam	rts		endp	end