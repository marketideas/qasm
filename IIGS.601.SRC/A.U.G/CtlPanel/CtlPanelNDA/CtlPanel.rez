0d53. * * 25-Oct-91 DAL *   Version 2.0d28 for 6.0d55. * * 29-Oct-91 DAL *   Removed the "X" resource (moved it to Sys.Resources). * * 30-Oct-91 DAL *   Version 2.0d29 for 6.0d56. * * 11-Nov-91 DAL *   Version 2.0d30 for 6.0d57. * * 19-Nov-91 DAL *   Version 2.0d31 for 6.0d59. * * 3-Dec-91 DAL *   Version 2.0d32 for 6.0d60. * * 9-Dec-91 DAL *   Version 2.0d33 for 6.0d61. * * 27-Jan-92 DAL *   Version 2.0d34 for 6.0d66. * * 5-Feb-92 DAL *   Version 2.0d35 for 6.0d70 (GM1?). * * 7-Feb-92 DAL (for d70) *   Version 2.0 final. *   Adjusted horizontal position of the version string control. * ************************************************************* * * 16-Mar-92 DAL (for 6.0.1d2) *   Version 2.1d1. * * 2-Jul-92 DAL *   Version 2.1d6. * * 15-Jul-92 DAL (for 6.0.1d7) *   Version 2.1d7. * * 12-Aug-92 DAL (for 6.0.1d9) *   Version 2.1d9. * * 3-Sep-92 DAL (for 6.0.1d10) *   Version 2.1d10. * * 28-Oct-92 DAL (for 6.0.1d12) *   Version 2.1d12. * * 3-Mar-93 SS (for 6.0.1d14) *   Version 2.1d14. * * 16-Mar-93 SS (for 6.0.1d15) *   Version 2.1d15. * * 1-Apr-93 SS (for 6.0.1d16) *   Version 2.1 (release) * * 22-Apr-93 DAL (for 6.0.1d17) *   Moved version number to make it pretty. **************************************************************/#include "typesiigs.r"#define CTLLST_00001003 $1003#define CTLTMP_00000001 1#define CTLTMP_00000002 2#define CTLTMP_00000003 3// #define CTLTMP_00000004 4#define CTLTMP_00000005 5/* #define PSTR_00010002 $10002 */#define PSTR_00010003 $10003#define PSTR_00010004 $10004#define PSTR_00010005 $10005#define WPARAM1_00000FFA 1#define WCOLOR_00000001 $07ff0001resource rVersion(1) {	{ 2, 1, 0, release, $00 },	verUS,	"Control Panel",	"Copyright 1990-93 Apple Computer, Inc."};resource rComment(2) {	"To use this Desk Accessory, put it in the Desk.Accs folder "	"inside your System folder.  The next time you start your system, "	"“Control Panels” will appear under the Apple menu."};// --- Control List Definitionsresource rControlList (CTLLST_00001003, $0000) {       {       CTLTMP_00000001,        // control 1       CTLTMP_00000002,        // control 2       CTLTMP_00000003,        // control 3//       CTLTMP_00000004,        // control 4       CTLTMP_00000005,        // control 5       };};/* List control, ID=1 */resource rControlTemplate (CTLTMP_00000001, $0000) {       $00000001,              // ID       {  2, 10,105,106},      // rect       listControl {{               $0000,          // flag               $3400,          // moreFlags               $00000000,      // refCon               $0000,          // listSize               $0003,          // listView               $0000,          // listType               $0001,          // listStart//             $00000000,      // listDraw (pointer to draw routine)               $0021,          // listMemHeight               $0012,          // listMemSize               $00000000,      // listRef	      $00000000	    // color ref       }};};/* Open button, ID=2 */resource rControlTemplate (CTLTMP_00000002, $0000) {       $00000002,              // ID       { 18,142, 31,232},      // rect       simpleButtonControl {{               $0001,          // flag               $3002,          // moreFlags               $00000000,      // refCon               PSTR_00010004,  // titleRef               0,              // colorTableRef               {"\$0D", "\$0D",$0000,$0000}  // key equivalents       }};};/* Help button (help on a CDev), ID=3 */resource rControlTemplate (CTLTMP_00000003, $0000) {       $00000003,              // ID       { 41,142, 54,232},      // rect       simpleButtonControl {{               $0000,          // flag               $3002,          // moreFlags               $00000000,      // refCon               PSTR_00010003,  // titleRef               0,              // colorTableRef               {"H", "h",$0100,$3900}  // key equivalents       }};};/* About the Control Panel button, ID=4 */// resource rControlTemplate (CTLTMP_00000004, $0000) {//        $00000004,              // ID//        { 75,144, 88,234},      // rect//        simpleButtonControl {{//                $0080,          // flag (invisible)//                $3002,          // moreFlags//                $00000000,      // refCon//                PSTR_00010002,  // titleRef//                0,              // colorTableRef//                {"?","/",$0100,$3900}  // key equivalents//        }};// };/* version string, ID=5 */resource rControlTemplate (CTLTMP_00000005, $0000) {       $00000005,              // ID       { 96,194+22,106,241},      // rect       statTextControl {{               $0000,          // flag               $1000,          // moreFlags (text by pointer)               $00000000,      // refCon               0,              // textRef               $00000000, 	    // textSize               $0000           // just       }};};/* resource rPString (PSTR_00010002, $0000) { "About..." }; */resource rPString (PSTR_00010003, $0000) { "Help" };resource rPString (PSTR_00010004, $0000) { "Open" };resource rPString (PSTR_00010005, $0000) { " Control Panels " };// --- rTwoRectsresource rTwoRects(1) {	{ 29, 40, 136, 286 },	// 320	{ 29, 40, 136, 286 }	// 640};// --- Window Templatesresource rWindParam1 (WPARAM1_00000FFA, $0000) {       $C0C8,                  // plFrame (frame bits--invisible)       PSTR_00010005,          // plTitle (title ID)       $00000000,              // plRefCon       {  0,  0,  0,  0},      // plZoomRect       WCOLOR_00000001,        // plColorTable       {$0000, $0000},         // plYOrigin, plXOrigin       {$0000, $0000},         // plDataHeight, plDataWidth       {$0000, $0000},         // plMaxHeight, plMaxWidth       {$0000, $0000},         // plVerScroll, plHorScroll       {$0000, $0000},         // plVerPage, plHorPage       $00000000,              // plInfoText (info RefCon)       $0000,                  // plInfoHeight       { 29, 40,136,286},      // plPosition       infront,                // plPlane       CTLLST_00001003,        // plControlList       $0A09                   // plInDesc};