{$toolErrorchk-}{$a+}{$longGlobals+}unit CDEVMGR;interfaceuses  QDIntf, GSIntf, MiscTools, Prodos16, RESMgr;const  machineCDEV = 	1; { called when rebuilding cdev.data to see if cdev should be included }  BootCDEV = 		2; { boot time init call or install call - no params}  ShutDownCDEV = 	3; { reserved for future use}  InitCDEV = 		4; { called when being shown - data1 = windowPtr}  CloseCDEV = 		5; { called when being removed - data1 = windowPtr}  EventsCDEV = 		6; { called when an event - data1 = ptr to event record}  CreateCDEV = 		7; { called so that CDEV can create its controls inline - data1 = window}  AboutCDEV =		8; { called so that CDEV can create its about text inline - no params}  RectCDEV =	 	9; { called so that CDEV can dynamically compute its rectangle}  HitCDEV =			10;{ called when ctl is "hit" - data1 = Hdl to Ctl hit, data2 = Ctl Id}  RunCDEV =			11;{ caled when da run is called}  reserved1 =		12;{ reserved for future use}  reserved2 =		13;{ reserved for future use}  reserved3 =		14;{ reserved for future use}  NeverUsed1 =		15;{ this will never be used}  NeverUsed2 =		16;{ this will never be used}    { wantReserved0 =	1; }  wantMachine =		1;  wantBoot =		2;  wantShutDown =	4;  wantInit =		8;  wantClose =		16;  wantEvents =		32;  wantCreate =		64;  wantAbout =		128;  wantRect =		256;  wantHit =			512;  wantRun =			1024;  wantReserved1 =	2048;  wantReserved2 =	4096;  wantReserved3 =	8192;  updateSSfromBRAM= 16384;  CanBeUnActive =	32768;    CDEV_ResType = $8018;  FLAG_ResType = $8019;  TwoRect_ResType = $801A;  rCodeResource = $8017;    CDEV_FileType = $C7;  CDEV_AuxType = 0;    CDEVDATA_FileType = $00;  CDEVDATA_AuxType = $00;    fCtlActive = $8000;  fCtlCanBeActive = $4000;  fCtlWantEvents = $2000;  fCtlProcRefNotPtr = $1000;    type    str32 = string[32];  	str15 = string[15];	str8 = string[8];    FlagsHdl = ^FlagsPtr; 	FlagsPtr = ^FlagsRec;	FlagsRec = packed record	  CDEVFlags : Integer;		{ messages we respond to & Flags}	  Enabled : boolean;		{ are we enabled?}	  Version : byte; 			{ version # of the control panel it works with 1 = 1.0}	  Machine : byte;			{ what machine do we need to be run  0,1 = old GS; 2 = tenspeed}	  Reserved : byte;			{ reserved byte}	  DataRect : Rect;			{ really the width & height; top, left = 0}	  name : str15;				{ name of the CDEV, upper/lower case}	  author : str32;			{ name of the author}	  versStr : str8;			{ version of the CDEV}	end;		IconHdl = ^IconPtr;	IconPtr = ^IconRec;	IconRec = packed record	  kind : Integer;  { always -1 = color}	  size : Integer;  { always 280}	  height : Integer;{ always 20}	  width : Integer; { always 28}	  image : packed array[0..19,0..13] of byte;	  mask : packed array[0..19,0..13] of byte;	end;			CDEVFake = ^CDEV;    CDEV = record	  path : str255;	{ full path, including file name of the CDEV}	  flags : FlagsRec;	{ flags from above}	  icon : IconRec;	{ icon from above}	  reserved : array[1..4] of integer;	end;		CDEVHeader = record	  identifier : Integer; { identifier, 'DL'}	  version : Integer;	{ should be 1}	  lastMachine : Integer;{ last machine this was run on}	  Count : integer;		{ # of CDEV's below}	  reserved : array[1..4] of longint; { reserved for future use}	end;		CDEVArray = array[1..1] of CDEV;		CDEVHdl = ^CDEVPtr;	CDEVPtr = ^CDEVRec;	CDEVRec = record	  header : CDEVHeader; { header from above}	  CDEVS : CDEVArray;   { the CDEV's}	end;	DITLHdl = ^DITLPtr;	DITLPtr = ^DITLRec;	DITLRec = record	  theRefs : array[1..1] of longint;	end;	SavePosHdl = ^SavePosPtr;	SavePosPtr = ^SavePosRec;	SavePosRec = record	  rect320 : Rect;	  rect640 : Rect;	end;function GetAndUpdateCDEVS : CDEVHdl;function UpperString(s : str255) : str255;procedure QuickSort(i,j : Integer; var A : CDEVArray);implementationfunction  GetCodeResConverter : Ptr; tool $3, $34;function  Disp(message : Integer; data1, data2 : Longint; thecode : ptr) : Longint; external;procedure die; inline $00; function GetAndUpdateCDEVS : CDEVHdl;  type    weirdness = record	  buffsize : integer;	  resultsize : integer;	  result : packed array[1..128] of char;	end;  var    p: P16ParamBlk;	dirDate, dirTime : Integer;	index, i  : integer;	fileID : Integer;	DataHandle : CDEVHdl;	newSize : Longint;	flagH : FlagsHdl;	IconH : IconHdl;    CDEVDataPtr : StringPtr;    CDEVDirPtr : StringPtr;	pascalName : string[128];	savePrefix : string[128];	CDEVDataPath : string[32];    CDEVDirPath : string[32];	currentName : weirdness;	dummy : Ptr;	Atemp,XTemp,YTemp,PTemp : integer;	scr : longint;	currCDEVCode : Ptr;	tempHdl : Handle;  label 1,2;    begin	FWEntry(Atemp,XTemp,YTemp,PTemp,$FE1F); {ytemp holds the machine rom #}    CDEVDataPath := '*/SYSTEM/CDEVS/CDEV.DATA';    CDEVDirPath := '*/SYSTEM/CDEVS';    CDEVDataPtr := @CDEVDataPath;    CDEVDirPtr := @CDEVDirPath;    GetAndUpdateCDEVS := nil;    currentName.buffSize := 128;    { first, try to find the CDEV's folder, it if is not there, exit}	p.pathname1 := CDEVDirPtr;		P16GetFileInfo(p);	if isToolError then	  begin	    DataHandle := nil; { the directory didn't exist - return nil handle!}		goto 2;	  end	else	  begin	    dirDate := p.modDate;		dirTime := p.modTime;	    { second, try to find the CDEV.DATA file, if it is not there or it	      has a older mod date than the directory, rebuild it.  If the directory	      is write protected ???? SHIT, WHAT DO I DO ????}	    p.pathname1 := CDEVDataPtr;			    P16GetFileInfo(p);		if (not isToolError) and ((dirDate + dirTime) = (p.ModDate + p.ModTime)) then		  begin {we dont need to re-build the file - just read it!}		    p.pathname2 := CDEVDataPtr;  			P16Open(p);  			P16GetEOF(p);  			p.requestCount := p.eof;  			Datahandle := CDEVHdl(NewHandle(p.requestCount, MMStartup, NoBankCross + locked, ptr(0)));  			p.dataBuffer := Ptr(Datahandle^);						  			P16Read(p);						if istoolerror or			     (Datahandle^^.header.identifier <> $444C) or {<-- trashed file}			     (Datahandle^^.header.version <> 1) then { bad version #}			  begin { trashed file, try to build it below}				DisposeHandle(Handle(DataHandle));				DataHandle := nil;				P16Close(p);			  end			else			  begin				P16Close(p);				goto 2;			  end;		  end;				P16Destroy(p); { remove it if it's there}				{save the old prefix}		p.prefixNum := 7;		p.prefix := @savePrefix;		p16GetPrefix(p);		{set the new prefix}		p.prefixNum := 7;		p.prefix := CDEVDirPtr;		p16SetPrefix(p);		p.pathname2 := CDEVDirPtr;		P16Open(p);		p.reserved := 0;		p.base := 0;		p.displacement := 0;		p.nameBuffer := @currentname;		P16GetDirEntry(p);				DataHandle := CDEVHdl(NewHandle(sizeof(cdevheader) + (p.entrynum * sizeof(CDEV)),					MMStartup, NoBankCross + Locked, ptr(0)));		if istoolerror then { not enough memory!}		  begin		    DataHandle := nil;			P16Close(p); {this closes the directory}						{restore the old prefix}			p.prefixNum := 7;			p.prefix := @savePrefix;			p16SetPrefix(p);					goto 2;		  end;		{ fill the header!}		with DataHandle^^, header do		  begin			identifier := $444C; {'DL'}			lastMachine := YTemp;			version := 1;			count := 0;		    reserved[1] := 0;		    reserved[2] := 0;		    reserved[3] := 0;		    reserved[4] := 0;		  end;		for index := 1 to p.entrynum do		  with DataHandle^^ do			begin							  p.displacement := index;			  P16GetDirEntry(p);							  {build the pascal file name}			  pascalName[0] := char(currentName.resultSize);			  for i := 1 to currentName.resultsize do				pascalName[i] := currentName.result[i];							  {build the path name to the file for opening its resources}			  for i := currentName.resultsize+2 downto 2 do				currentName.result[i] := currentName.result[i-2];			  currentName.result[1] := '7'; { we use prefix 7 as our directory!}			  currentName.result[2] := '/';			  currentName.resultSize := currentName.resultsize + 2;			  			  if ((p.fileFiltyp = CDEV_FileType) and			     (BitAnd(p.fileAuxType,$8000) = 0)) then				begin				  fileID := OpenResFile(1,nil,@currentName.resultsize);				  inc(header.count);				  with CDEVS[header.count] do					begin					  reserved[1] := 0;					  reserved[2] := 0;					  reserved[3] := 0;					  reserved[4] := 0;					  path := concat(CDEVDirPath,'/',pascalName);					  					  IconH := IconHdl(LoadRes(rIcon,1));   { add its icon to our struct }					  					  if istoolerror then						begin						  dec(header.count);						  goto 1;						end;					  icon := IconH^^;					  ReleaseRes(3,rIcon,1);   { then trash it! }					  					  FlagH := FlagsHdl(LoadRes(FLAG_ResType,1)); { add its flags to our stuct}					  					  if istoolerror then						begin						  dec(header.count);						  goto 1;						end;					  		              if YTemp < FlagH^^.machine then					    begin					      ReleaseRes(3,FLAG_ResType,1); { wrong machine, get lost.}						  dec(header.count);						  goto 1;						end;										 if (BitAnd(flagH^^.CDEVFlags, wantmachine) <> 0 ) then					 	begin							scr := 1;														ResConverter(GetCodeResConverter, CDEV_ResType, login);							tempHdl := LoadRes(CDEV_ResType,1); { load the code!}												if not isToolerror then {in case the resource is not there, dont crash}					  		begin								HLock(tempHdl);								CurrCDEVCode := tempHdl^;								scr := Disp(machineCDEV, 0, 0, currCDEVCode); 								ReleaseRes(3,CDEV_ResType,1); {zombie the code}								{log out of the resource converter}								ResConverter(GetCodeResConverter, CDEV_ResType, logout);					  		end;						if scr = 0 then							dec(header.count);													end;						  flags := FlagH^^;					  ReleaseRes(3,FLAG_ResType,1); { then trash it!}					end;					1:				  CloseResFile(fileid);				end;			end;				newSize := sizeof(cdevheader) + (DataHandle^^.header.count * sizeof(CDEV));		SetHandleSize(newSize, Handle(DataHandle));		P16Close(p); {this closes the directory}				{restore the old prefix}		p.prefixNum := 7;		p.prefix := @savePrefix;		p16SetPrefix(p);				{Do a sort by name !!!!}				HLock(Handle(dataHandle));		with datahandle^^ do		  Quicksort(1,header.count, CDEVS);		HLock(Handle(dataHandle));		{create a new cdev.data file & write the new info to it!}				p.pathname1 := CDEVDataPtr;		p.access := $83;		p.fileType := CDEVDATA_FileType;		p.auxType := CDEVDATA_AuxType;		p.storageType := 5;		p.createDate := 0;		p.createTime := 0;			p16create(p);		if istoolerror then		  goto 2; { we couldn't create it, so leave!}		p.pathname2 := CDEVDataPtr;		p16open(p);		p.requestcount := newSize;		p.databuffer := Ptr(DataHandle^);				p16Write(p);		if istoolerror then		  begin { must not be enough room, kill it & leave}			p16Close(p);			p.deletepathname := CDEVDataPtr;			p16destroy(p);			goto 2; 		  end;		p16Close(p);				p.pathname1 := CDEVDataPtr;		p16GetFileInfo(p);		p.access := $C1; {destroy enable, rename enable, backup needed, READ ONLY}		p16SetFileInfo(p);2:		GetAndUpdateCDEVS := DataHandle;	  end;  end;function UpperString(s : str255) : str255;  var    i : integer;    val : integer;  begin    for i := 1 to ord(s[0]) do { this is faster than length(s) }      begin        val := ord(s[i]);        if (val >= ord('a')) and           (val <= ord('z')) then { its a lower case character}	  			s[i] := Char(val - $20);      end;    UpperString := s;  end;procedure QuickSort(i,j : Integer; var A : CDEVArray);  var    pivot : str15;	pivotIndex : Integer;	k : Integer;	  function FindPivot(i, j : Integer) : Integer;    var      firstKey : str15;	  k : Integer;    begin      firstKey := upperstring(A[i].flags.name);	  FindPivot := 0;	  for k := (i+1) to j do	    if upperstring(A[k].flags.name) > firstKey then	      FindPivot := k        else if upperstring(A[k].flags.name) < firstKey then	      FindPivot := i;    end;procedure SwapCDEV(var cdev1, cdev2 : CDEV);  var    temp : CDEV;  begin	temp := cdev1;	cdev1 := cdev2;	cdev2 := temp;   end;  function Partition(i, j : integer; var pivot : str15) : Integer;    var      l, r : integer;    begin      l := i;	  r := j;	  repeat	    SwapCDEV(A[l], A[r]);	    while upperstring(A[l].flags.name) < upperstring(pivot) do	      inc(l);	    while upperstring(A[r].flags.name) >= upperstring(pivot) do	      dec(r);	  until l > r;	  Partition := l;    end;  begin    pivotindex := findpivot(i,j);	if pivotindex <> 0 then	  begin	    pivot := A[pivotindex].flags.name;		k := partition(i,j,pivot);		quicksort(i,k-1,A);		quicksort(k,j,A);	  end;  end;end.