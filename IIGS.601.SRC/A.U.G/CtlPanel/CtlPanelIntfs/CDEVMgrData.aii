;;;	CDEVMgrData - data for the code resource that builds the cdev.data files.;;	Michael V. Stein	05/10/90.;;	© Copyright Apple Computer, 1990.	blanks	off	;;	equates.;;	include files.* no longer needed {gab}*	include 'm16.util';;	macros.;;	main program.file	proc;;	exported addresses.	export	dispdisp; rewritten by Greg Branche 	lda	6,s			;get high 16-bits of 32-bit destination pointer	tay				;save in Y for a second	lda	4,s			;get low 16-bits	dec	a			;prepare for eventual RTL	tax				;save in X	pla				;retrieve low 16-bits of return address	sta	3,s			;put back on stack, overwriting destination pointer	sep	#$20			;8-bit accumulator	pla				;retrieve high 8-bits of return address	sta	4,s			;put back on stack	tya				;get high 8-bits of destination pointer	sta	1,s			;put on stack	rep	#$20			;back to 16-bit accumulator	phx				;put low 16-bits of destination pointer on stack	rtl				;and 'return' to destination	endp	end