unit newinterface;uses qdintf, gsintf;const  simpleButton = $80000000;  checkBox =     $82000000;  radio = 		 $84000000;  srollBar =	 $88000000;  grow = 		 $8A000000;  statText = 	 $81000000;  editline = 	 $83000000;  editText = 	 $85000000;  popUp =		 $87000000;  list = 		 $89000000;  iconButton = 	 $8B000000;  pictCtl = 	 $8D000000;    wInControl = $21;type  NEWEventRecord = record    oldRec : eventrecord;	wmLastClick : longint;	wmclickcount : integer;	wmtaskData2 : longint;	wmtaskData3 : longint;	wmtaskData4 : longint;    wmLastClickPt : Point;  end;    simpleButtonHdl = ^simpleButtonPtr;  simpleButtonPtr = ^simpleButtonRec;  simpleButtonRec = record    pCount : integer; { in this case - 7}	ctlID : longint;  { 1,2,3...}	ctlRect : rect;	  { the rect}	ctlProcRef : longint; { $80000000}	ctlFlag : integer;{ 2}	ctlMoreFlags : integer;{ 2}	ctlRefCon : longint; { 0 }	TitleRef : longint; { resource id of string}	colorRef : longint;  end;  RadioButtonHdl = ^RadioButtonPtr;  RadioButtonPtr = ^RadioButtonRec;  RadioButtonRec = record    pCount : integer; { in this case - 7}	ctlID : longint;  { 1,2,3...}	ctlRect : rect;	  { the rect}	ctlProcRef : longint; { $80000000}	ctlFlag : integer;{ 2}	ctlMoreFlags : integer;{ 2}	ctlRefCon : longint; { 0 }	TitleRef : longint; { resource id of string}	InitialValue : Integer; { inital value}	colorRef : longint;  end;  CheckButtonHdl = ^CheckButtonPtr;  CheckButtonPtr = ^CheckButtonRec;  CheckButtonRec = record    pCount : integer; { in this case - 7}	ctlID : longint;  { 1,2,3...}	ctlRect : rect;	  { the rect}	ctlProcRef : longint; { $80000000}	ctlFlag : integer;{ 2}	ctlMoreFlags : integer;{ 2}	ctlRefCon : longint; { 0 }	TitleRef : longint; { resource id of string}	InitialValue : Integer; { inital value}	colorRef : longint;  end;  MenuItemHdl = ^MenuItemPtr;MenuItemPtr = ^MenuItemRec;MenuItemRec = packed record  version : Integer;  ItemID : Integer;  ItemChar : Char;  ItemAltChar : Char;  ItemCheck : Integer;  ItemFlag : Integer;  ItemTitleRef : Longint; {top 2 bits set for title is resource id}end;MenuH = ^MenuP;MenuP = ^MenuR;MenuR = record  version : integer;  menuID : integer;  menuFlag : integer; {top 4 bits are set = menu title & item are resources}  menuTitleRef : longint;  Items : array[1..1] of Longint;end;PopUpHdl = ^PopUpPtr;PopUpPtr = ^PopUpRec;PopUpRec = record  pCount : integer; { in this case - 9}  ctlID : longint;  { 1,2,3...}  ctlRect : rect;	  { the rect}  ctlProcRef : longint; { $87000000}  ctlFlag : integer;{ 0}  ctlMoreFlags : integer;{ fCtlProcRefNotPtr + 2}  ctlRefCon : longint; { 0 }  TitleWidth : Integer; { stringwidth(title) }  MenuRefRef : longint; { resource id of menu}  InitialValue : Integer; { inital value (item id)}end;function  LGetPathName2(memID, fileNum : integer) : Ptr; tool $11, $22;function  TaskMasterDA(mask : integer; event : NEWeventrecord) : integer; tool 14, $5F;function  NewControl2(wind : windowPtr; inputType : Integer;						reference : longint) : ControlHandle; tool 16,$31;function  GetCtlHandleFromID(theWind : WindowPtr; id : longint) : ControlHandle; tool 16, $30;function  GetCtlID(ctlHdl : Controlhandle) : longint; tool 16, $2A;procedure AddToRunQ(addr : procPtr); tool $05, $1f;procedure RemoveFromRunQ(addr : procPtr); tool $05, $20;function  GetCodeResConverter : Ptr; tool $3, $34;function  GetCtlParamPtr : Ptr; tool $10, 35;procedure SetCtlParamPtr(p : Ptr); tool $10,34;FUNCTION  TaskMaster2(EventMask : Integer; Event: NewEventRecord):Integer;Tool 14,29;procedure SetKeyTranslation(trans : integer); tool 6, $1C;function  GetKeyTranslation : integer; tool 6, $1B;procedure PHB; inline $8B;procedure PHK; inline $4B;procedure PLB; inline $AB;end.