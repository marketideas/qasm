{ resource manager pascal interface}unit ResMgr;interfaceuses  QDIntf, GSIntf;  const  rIcon = $8001;  rPicture = $8002;  rControlList = $8003;  rControlTemplate = $8004;  rWindow = $8005;  rString = $8006;  rStringList = $8007;  rMenuBar = $8008;  rMenu = $8009;  rMenuItem = $800A;  rTextForLETextbox2 = $800B;  rCtlDefProc = $800C;  rCtlColorTbl = $800D;    login = 1; {for resource converter}  logout = 2;  type  ResourceRec = record    resType : Integer;	resID : Longint;  end;procedure ResBootInit;												tool 30,  1;procedure ResStartup(memoryID : integer);							tool 30,  2;procedure ResShutdown;												tool 30,  3;function  ResVersion : Integer;										tool 30,  4;procedure ResReset;													tool 30,  5;function  ResStatus : integer;										tool 30,  6;procedure CreateResFile(auxType : Longint; 						fileType, access : Integer;	fileName : Ptr);tool 30,  9;function  OpenResFile(access : integer;						mapAddr : Ptr; fileName : Ptr) : Integer;	tool 30, 10;procedure CloseResFile(id : Integer);								tool 30, 11;procedure AddRes(theHandle : handle;						attr, resType : Integer; resId : Longint);	tool 30, 12;procedure UpdateResFile(memoryID : Integer);						tool 30, 13;function  LoadRes(resType : Integer; resID : Longint) : Handle;		tool 30, 14;procedure RemoveRes(resType : Integer; resID : Longint);			tool 30, 15;procedure MarkResChange(changed : boolean; resType : Integer;						resID : Longint);							tool 30, 16;procedure SetCurResFile(memoryID : Integer);						tool 30, 17;function  GetCurResFile : Integer;									tool 30, 18;procedure SetCurResApp(memoryID : Integer);							tool 30, 19;function  GetCurResApp : Integer;									tool 30, 20;function  HomeResFile(theType:Integer; resID : Longint) : Integer;	tool 30, 21;procedure WriteRes(resType : Integer; resID : Longint);				tool 30, 22;procedure ReleaseRes(purgeLevel : integer;					  resType : Integer; resID : Longint);			tool 30, 23;procedure DetatchRes(resType : integer; resID : Longint);			tool 30, 24;function  UniqueResID(IDRange, resType : Integer) : Longint;		tool 30, 25;procedure SetResID(newID : Longint; 						resType : Integer; resID : Integer);		tool 30, 26;function  GetResAttr(resType : Integer; resID : Longint) : Integer;	tool 30, 27;procedure SetResAttr(theAttr, resType : integer; resID : Longint);	tool 30, 28;function  GetResSize(resType : Integer; resID : Longint) : Longint;	tool 30, 29;procedure MatchResHandle(var foundRec : ResourceRec;						theHand : Handle);							tool 30, 30;function  GetOpenFileRefNum(fileId : Integer) : Integer;			tool 30, 31;function  CountTypes : Integer;										tool 30, 32;function  GetIndType(index : integer) : integer;					tool 30, 33;function  CountRes(resType : Integer) : Longint;					tool 30, 34;function  GetIndRes(resType: integer; index: longint) : Handle;		tool 30, 35;procedure SetResLoad(load : boolean);								tool 30, 36;procedure SetResFileDepth(numToSearch : Integer);					tool 30, 37;function  GetMapHandle(fileId : Integer) : Handle;					tool 30, 38;procedure ResConverter(converter : Ptr; theType : Integer; flags : integer); tool 30,40;procedure ResDebug(on : integer); tool 30, $29;implementationend.