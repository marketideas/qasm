************************************************************************;;;;	networkdata - data records and strings used by Network CDEV.;;	From Namer CDEV code originally by Michael V. Stein 04/21/90.;;	Adapted 4/30/91 by Monte Benaresh;;	© Copyright Apple Computer, 1991-92;************************************************************************** REVISION HISTORY** 18-Jun-92 DAL for 6.0.1d6*   Added keyboard equivalents to the two radio buttons and the two*   icon buttons.** 9-Sep-92 DAL for 6.0.1d10*   Changed EtherTalk button to read Ethernet.  Fixed capitalization*   in help to be "Network control panel".*************************************************************************	;blanks	off	BLANKS ON;;	equates.fCtlCanBeActive equ 	$4000ListBugFixBit	equ	4;;	include files.	include	'e16.control'	include	'e16.gsos'	include	'e16.list'	include 'network.h'netdata	proc;;	exported addresses.	export	about	;export	appletalk	;export	asterisk	export	atalkerr	export	atalkF	;export	cprect	export	ctllist	;export	emess7	;export	emess10	;export	emess11	;export	emess13	export	ginfoparams	export GSRad	;export	oktext	export P8Rad	;export	quit	;export	tryagain	;export local_icbut	;export ether_icbut;;	imported addresses.	import	acr	import	netobj	import	openblock	import	openblock2	import	readbuff		atalkF	dc.w	1			;!= 0 if appletalk is active, defaults to active;	error strings.;;	string	asis;;	;emess7	dc.b	emess7L;	dc.b	'There is not enough memory';	dc.b	$0d;	dc.b	'to continue.';emess7L	equ	*-emess7-1;;;	error messages used by the rename and emulator routines.;;emess11 dc.b	emess11L;	dc.b	'A network error has';	dc.b	$0d;	dc.b	'occurred.  Please try';	dc.b	$0d;	dc.b	'again.';emess11L  equ	*-emess11-1;;;	string	pascal;;appletalk  dc.b	'APPLETALK';;asterisk  dc.b	'*';;oktext	dc.b	'OK';;quit	dc.b	'Quit'			;used in disk error alerts;;tryagain  dc.b	'Try Again'		;used in disk error alerts;	string	asis;	appletalk parameter blocks.;	parameter block to get appletalk info.GinfoParams	dc.b  synchronous	;type		dc.b	GetInfoCmd	;command		dc.w	0		;result		dc.l	0		;completion routine		dc.w	0		;ThisNet		dc.b	0		;Abridge		dc.b	0		;HardWareID		dc.w	0		;Rom version		dc.b	0		;node number			;	ctllist contains a list of controls whose handles we don't need very often.ctllist	;dc.l local_icbut	* these are created 	*	;dc.l ether_icbut	* with NewControl2	*  if Ethernet then	dc.l netText  endif	dc.l startText  if Ethernet then	dc.l rectCtl  endif	;dc.l P8Rad	* these are created 	*	;dc.l GSRad	* with NewControl2	*	dc.l 0about	dc.w	8			;Pcount	dc.l	10			;ID	dc.w	38,5,138,280	dc.l	statTextControl	dc.w	0	dc.w	fCtlProcRefNotPtr	dc.l	0	dc.l	atext	dc.w	AtextLatext	dc.b	'The Network control panel lets you choose '    if Ethernet then	dc.b	'the type of network connection to use and '	;dc.b	*'the network zone you want to connect to.'    endif	dc.b	'which operating system will be loaded when you '	dc.b	'start up over the network.'atextL	equ	*-atextatalkerr  dc.w	8			;PCount	dc.l	11			;id	dc.w	8,leftedge,38,Rightedge+20	dc.l	statTextControl	dc.w	0	dc.w	fCtlProcRefNotPtr	dc.l	0	dc.l	atalkerrm		;ptr to text	dc.w	atalkerrmL		;length		atalkerrm  dc.b	'AppleTalk must be'	dc.b	13	dc.b	'installed and enabled'	dc.b	13	dc.b	'to run this Control'	dc.b	13	dc.b	'Panel.'atalkerrmL  equ	*-atalkerrm		BLANKS ON	if Ethernet thennetText		dc.w	8		;Pcount		dc.l	2		;ID number		dc.w	5		;rect -	top		dc.w	15		;	left		dc.w	5+10		;	bottom		dc.w	190		;	right		dc.l	statTextcontrol		dc.w	0		;flag, c string		dc.w	fctlProcRefNotPtr		dc.l	0		;ref con		dc.l	netStr		;text ref		dc.w	netLen		;length of stringnetStr		dc.b 'Network type:'netLen		equ * - netStr		;coordinate position constants for icons;icY		equ 3icY		equ 20ic1X		equ 7ic2X		equ 100icHeight	equ 40icWidth		equ 93local_icbut				;icon button for LocalTalk		dc.w 11			;pcount		dc.l localIcID		;ctl ID		dc.w icY, ic1X, icY+icHeight, ic1X+icWidth	;rect		dc.l iconButtonControl	;procRef		dc.w $0012		;flags		dc.w $3000		;more flags		dc.l 0			;ref con		dc.l local_icon		;icon ref		dc.l local_title	;title ref		dc.l 0			;color table		dc.w 0			;display mode		dc.b 'B','b'		;key equivs		dc.w 0,0		;modifier masksether_icbut			;icon button for Ethernet		dc.w 11			;pcount		dc.l etherIcID		;ctl ID		dc.w icY, ic2X, icY+icHeight, ic2X+icWidth	;rect		dc.l iconButtonControl	;procRef		dc.w $0012		;flags		dc.w $3000		;more flags		dc.l 0			;ref con		dc.l ether_icon		;icon ref		dc.l ether_title	;title ref		dc.l 0			;color table		dc.w 0			;display mode		dc.b 'E','e'		;key equivs		dc.w 0,0		;modifier maskslocal_icon	dc.w $0000, $00E4, $0013, $0018	dc.b $FF, $FF, $FF, $FF, $FF, $C0, $00, $3F, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $00, $FC, $03, $F0, $0F, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $F0, $FF, $FF, $FF, $FF, $F0, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $C3, $F0, $FF, $0F, $F0, $FC, $3F, $FF, $FF	dc.b $FF, $FF, $FF, $0F, $FF, $FF, $FF, $FF, $FF, $0F, $FF, $FF	dc.b $FF, $FF, $FF, $0F, $03, $FF, $03, $F0, $3F, $0F, $FF, $FF	dc.b $FF, $FF, $FF, $C3, $FF, $FF, $FF, $FF, $FC, $3F, $FF, $FF	dc.b $FF, $FF, $FF, $F0, $0F, $C0, $FC, $0F, $00, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $03, $FF, $FF, $FC, $0F, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $00, $00, $0F, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $F0, $3F, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FC, $0F, $FC, $00, $00, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FC, $0F, $C0, $F0, $3C, $0F, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FC, $0F, $FF, $F0, $3F, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $F0, $3C, $0F, $03, $F0, $3F, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $00, $00, $3F, $F0, $3F, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FC, $0F, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $00, $00, $00, $00, $00, $FF, $FF, $F0, $00, $00, $00, $00	dc.b $00, $00, $00, $00, $FF, $0F, $FF, $0F, $F0, $00, $00, $00	dc.b $00, $00, $00, $0F, $00, $00, $00, $00, $0F, $00, $00, $00	dc.b $00, $00, $00, $FF, $0F, $00, $F0, $0F, $0F, $F0, $00, $00	dc.b $00, $00, $00, $F0, $00, $00, $00, $00, $00, $F0, $00, $00	dc.b $00, $00, $00, $F0, $FF, $00, $FF, $0F, $F0, $F0, $00, $00	dc.b $00, $00, $00, $FF, $00, $00, $00, $00, $0F, $F0, $00, $00	dc.b $00, $00, $00, $0F, $F0, $FF, $0F, $F0, $FF, $00, $00, $00	dc.b $00, $00, $00, $00, $FF, $00, $00, $0F, $F0, $00, $00, $00	dc.b $00, $00, $00, $00, $00, $FF, $FF, $F0, $00, $00, $00, $00	dc.b $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00	dc.b $00, $00, $00, $00, $00, $00, $00, $0F, $F0, $00, $00, $00	dc.b $00, $00, $00, $00, $0F, $F0, $0F, $FF, $FF, $00, $00, $00	dc.b $00, $00, $00, $00, $0F, $F0, $FF, $0F, $FF, $F0, $00, $00	dc.b $00, $00, $00, $00, $0F, $F0, $00, $0F, $F0, $00, $00, $00	dc.b $00, $00, $00, $0F, $FF, $F0, $FF, $0F, $F0, $00, $00, $00	dc.b $00, $00, $00, $00, $FF, $FF, $F0, $0F, $F0, $00, $00, $00	dc.b $00, $00, $00, $00, $0F, $F0, $00, $00, $00, $00, $00, $00	dc.b $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00ether_icon	dc.w $0000, $00E4, $0013, $0018	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FC, $3F, $0F, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $C3, $C0, $F0, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FC, $3F, $FC, $3F, $0F, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $C3, $FF, $C3, $F0, $FF	dc.b $F0, $0F, $00, $0F, $00, $00, $00, $00, $3F, $FC, $3F, $0F	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $C3, $F0	dc.b $0F, $00, $0F, $00, $00, $00, $00, $00, $3F, $FC, $3F, $0F	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $C3, $FF, $C3, $F0, $FF	dc.b $FF, $FF, $F0, $FC, $3F, $FF, $FC, $3F, $FC, $3F, $0F, $FF	dc.b $FF, $FF, $0F, $03, $C3, $FF, $FF, $C3, $C0, $F0, $FF, $FF	dc.b $FF, $F0, $FC, $3F, $FC, $3F, $FF, $FC, $3F, $0F, $FF, $FF	dc.b $FF, $0F, $C3, $FF, $C3, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $F0, $FC, $3F, $FC, $00, $00, $00, $00, $00, $F0, $00, $F0	dc.b $0F, $C3, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $F0, $FC, $3F, $FC, $00, $00, $00, $00, $F0, $00, $F0, $0F	dc.b $FF, $0F, $C3, $FF, $C3, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $F0, $FC, $3F, $FC, $3F, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $0F, $03, $C3, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $F0, $FC, $3F, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	dc.b $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF, $FF	STRING ASISlocal_title		dc.b @end-@start	;length byte@start		dc.b 'Built-In'@endether_title		dc.b @end-@start	;length byte@start		dc.b 'Ethernet'		;was EtherTalk, 9-Sep-92 DAL@endrectCtl		;rectangle control used to draw a line		dc.w	6		;Pcount		dc.l	1		;ID number		dc.w	startYBase-8	;rect -	top		dc.w	LeftEdge-7	;	left		dc.w	startYBase-7	;	bottom		dc.w	RightEdge+1	;	right		dc.l	rectangleControl		dc.w	$FF02		;flag, disabled, black pattern		dc.w	fctlProcRefNotPtr		dc.l	0		;ref conzoneYbase	equ 45			cprect	dc.w	0,0,200,300		;control panel rectangle	******************************************************************	endif		;if EthernetLeftEdge	equ	15RightEdge	equ	190;startYBase	equ 105			;for Dudley version	if Ethernet thenstartYBase	equ 75			;for DoRight version	elsestartYBase	equ 6			;for 6.0 version	endifstartText		dc.w	8		;Pcount		dc.l	1		;ID number		dc.w	startYBase	;rect		dc.w	leftedge		dc.w	startYBase+10		dc.w	rightedge		dc.l	statTextcontrol		dc.w	0		;flag, c string		dc.w	fctlProcRefNotPtr		dc.l	0		;ref con		dc.l	startStr	;text ref		dc.w	startLen	;length of stringstartStr		dc.b 'Start up with:'startLen	equ * - startStrP8Rad		dc.w 10			;pcount through init val		dc.l P8_id		;ctl ID		dc.w startYBase+13	;top	** rect		dc.w leftedge+15	;left		dc.w startYBase+13+10	;bottom		dc.w leftedge+15+100	;right		dc.l radioProc		;procref		dc.w $0001		;flags & family		dc.w $3000		;more flags		dc.l 0			;ref con		dc.l P8String		;title ref		dc.w 0			;initial value		dc.l 0			;color table		dc.b 'P','p'		;key equivs		dc.w 0,0		;modifier masksP8String		dc.b @end-@start	;length byte@start		dc.b 'ProDOS 8'@endGSRad		dc.w 10			;pcount through init val		dc.l GS_id		;ctl ID		dc.w startYBase+25	;top	** rect		dc.w leftedge+15	;left		dc.w startYBase+25+10	;bottom		dc.w leftedge+15+100	;right		dc.l radioProc		;procref		dc.w $0001		;flags & family		dc.w $3000		;more flags		dc.l 0			;ref con		dc.l GSString		;title ref		dc.w 0			;initial value		dc.l 0			;color table		dc.b 'G','g'		;key equivs		dc.w 0,0		;modifier masksGSString		dc.b @end-@start	;length byte@start		dc.b 'GS/OS'@end	endp	end