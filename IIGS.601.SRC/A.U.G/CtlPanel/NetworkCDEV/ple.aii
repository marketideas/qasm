;;;	ple - print line with ellipses.;;	Michael V. Stein	03/11/90.;;	© Apple, 1990.	blanks	off	;;	equates.recty0	equ	0		rectangle offsetsrectx0	equ	2recty1	equ	4rectx1	equ	6;;	imported addresses.;;	include files.	include	'::commonmacros.h'	include	'::dp.h'	include	'e16.quickdraw'	include	'm16.quickdraw'	include	'm16.util2';	include	'netprinter.h';;	macros.;;	main program.main	proc;;	exported addresses.	export	plememrectptr  equ	dpsize+1+3+4	pointer to member's record that needs to be displayedrectptr	equ	dpsize+1+3+4+4	pointer to rect enclosing memberple	tsc	sec				sbc	#dpsize		make room on stack for new direct page	tcs				phd			save the current direct page	tcd			new direct page	phb			save callers data bank	phk	plb			make sure our bank is set		pushl	#plec		record to hold pen state	_GetPenState		pha	_GetTexTMode		save for later		pushw	#modeCopy		_SetTextMode	pushl	rectptr	_EraseRect		clear the rectangle enclosing text		pha	pushl	#pleb		'...'	_StringWidth	pla	lsr	a	sta	w1		1/2 the length of the three dots		ldy	#rectx0	lda	[rectptr],y	clc	adc	#10	pha			x loc of line		ldy	#recty1	lda	[rectptr],y	dea				dea	pha			y loc of line		_MoveTo	ldy	#rectx1	lda	[rectptr],y	ldy	#rectx0	sec	sbc	[rectptr],y	sbc	#10		(c) set, left and right margin of 10	sta	l3		save total width allowed	lsr	a	sec	sbc	w1		1/2 the width of the three dots	sta	l3+2		save breaking point in line	ldy	#2	lda	[memrectptr],y	sta	l2+2	lda	[memrectptr]	[a,x] = handle to string	sta	l2	lda	[l2]	sta	l1	lda	[l2],y	sta	l1+2	pha			space for result	pushl	l2		ptr to string	_StringWidth	pla		cmp	l3	bcc	ple1		if fits	bne	ple2		if doesn't fitple1	jmp	ple10		it fits, so just go draw itple2	ldy	#1	stz	w2		current widthple3	sty	w1		current character offset	lda	[l2],y		get next char	and	#$ff	pha	pha			char to check	_CharWidth	pla	clc	adc	w2	sta	w2	cmp	l3+2			bcs	ple4		if past the middle			ldy	w1	iny	bra	ple3		check next character	;	Now start from right edge and see what can fit in string.ple4	lda	[l2]	and	#$ff	sta	w6		length of string	tay			char to start looking at	stz	w3		width from right edge	ple5	sty	w4	lda	[l2],y	and	#$ff	pha			space for result	pha			char to check	_CharWidth	pla	clc	adc	w3	sta	w3		width so far on the right	ldy	w4	cmp	l3+2	beq	ple7		if just fits	bcs	ple6		if past the middle	dey	bra	ple5		check if next char to the left can fitple6	inc	w4		starting char after seperator;	create a string to print 'aaaaa...bbbbb'.ple7	ldy	#0ple8	lda	[l2],y	sta	plea,y		move these characters over	iny	iny	cpy	w1	bcc	ple8		if more to copy from left edge		ldx	w1	lda	pleb+1	sta	plea,x		put in the first space and the ellipses	inx	inx	lda	pleb+1+2	sta	plea,x		add in last part of seperator			inx			offset to store right edge	ldy	w4		place to start movingple9	lda	[l2],y		get next character	sta	plea,x		place into new string	inx	inx	iny	iny	;cpx	w6	cpy	w6		changed 2/21/91 by Monte Benaresh	bcc	ple9		if more to copy	beq	ple9		if more to copy		shortmx	lda	w6	sec	sbc	w4		# of chars from right side -1	adc	#3-1		(c) set , length( middle seperator) -1 	adc	w1		(c) clear, amt from left side +1	sta	plea		actual length of new string	longmx		pushl	#plea		bra	ple11	ple10	pushl	l2ple11	_DrawString		draw the string	ldy	#4	lda	[memrectptr],y	and	#$80	beq	ple12		if not selected		pushl	rectptr	_InvertRect		mark it as selectedple12	pushl	#plec			_SetPenState		restore orginal penstate		_SetTextMode		restore original text mode	plb			restore orginal data bank		pld			restore original direct page		lda	dpsize+2,s	sta	dpsize+15-1,s	move upper 16 bits to top of stack	lda	dpsize+1,s	sta	dpsize+15-2,s	move lower 16 bits to top of stack		tsc	clc	adc	#dpsize+15-3		tcs			return address is now on top of stack		rtl				;	data used here.;plea	ds.b	namelen+5	leave some slop space	plea	ds.b	33+5		pleb	dc.b	3,'...'plec	ds.b	pnStateSize	hold pen state	endp	end