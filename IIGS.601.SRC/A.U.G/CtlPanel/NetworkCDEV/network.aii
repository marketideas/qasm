;;;	network - AppleTalk Network CDEV.;;	From original code by Michael V. Stein	01/25/90.;;	Adapted 4/30/91 by Monte Benaresh;;	© Copyright Apple Computer, 1991;	;blanks	off;;	equates.recty0	equ	0		;rectangle offsetsrectx0	equ	2recty1	equ	4rectx1	equ	6stack_entry  equ  $e100b0	;gs/os stack entry point;;	include files.	include	'::commonmacros.h'	include	'::cdev.h'	include	'::dp.h'	include	'e16.control'	include	'e16.dialog'	include	'e16.event'	include	'e16.gsos'	include	'e16.lineedit'	include	'e16.list'	include	'e16.memory'	include	'e16.quickdraw'	include	'm16.control'	include	'm16.dialog'	include	'm16.gsos'	include	'm16.intmath'	include	'm16.lineedit'	include	'm16.list'	include	'm16.memory'	include	'm16.misctool'	include	'm16.quickdraw'	include	'm16.print'	include	'm16.QDAux'	include	'm16.util2'	include	'm16.window'	include 'network.h';;	main program.main  	proc;;	exported addreses.	;export	acr	;export	cmd		;export	cps	;export	ctp	;export	dah	;export	dam	;export	damE	;export	dptr	;export	gdt	;export	ghp	;export	gip	;export	hpe	;export	hzl	;export	knl	;export	lookupF	;export	mneE	;export	netobj	;export	omd	;export	openblock	;export	openblock2	;export	otp	;export	rfp	;export	rfpE	;export	screenF	;export	stp	;export	stpE	;export	wtp;;	imported addresses.	import	about	;import	appletalk	;import	asterisk	;import	atalkerr	import	atalkF	;import	atinit:atinitrec	;import	atinitlpath	;import	cfe	;import	cprect	import	ctllist	;import	emess1	;import	emess2	;import	emess3	;import	emess4	;import	emess5	;import	emess6	;import	emess7	;import	emess8	;import	emess10	;import	emess11	;import	emess12	;import	emess13	;import	GinfoParams	import GSRad	;import	oktext	import P8Rad	;import	tryagain	;import	quit	;import	rtp	;import	sul	;import	tryagain	;import	wtext	import local_icbut	import ether_icbutnet_cdev	phb			;save calling data bank	phk	plb			;set our data bank		;	make room on stack for direct page.	tsc				sec				sbc	#dpsize		;make room on stack for new direct page	tcs				phd			;save the current direct page	tcd			;new direct page	lda	message		cmp	#11+1			bcs	net_cdev1	;if message defintely not handled	;ldx	atalkf	;beq	net_cdev1	;if appletalk isn't present			asl	a		;times 2 into word table	tax			;move into index reg	jsr	(t_cdev-2,x)	;call the handler of this messagenet_cdev1	pld			;restore direct page	tsc	clc	adc	#dpsize			tcs			;reset the stack	lda	1,s		;Bump the stack up to prepare	sta	11,s		;to take off the 3 parameters	lda	3,s			sta	13,s	pla			;get rid of message space		pla			;get rid of data1 space	pla					pla			;get rid of data2 space	pla					lda	#0		;return 0 to caller	sta	5,s	sta	7,s			plb		rtl		t_cdev	dc.w	ctcE		;handle machine message - ignored	dc.w	ctcE		;handle boot message - ignored	dc.w	ctcE		;handle shutdown message - ignored	dc.w	icc		;init cdev controls	dc.w	ctc		;close the cdev	dc.w	ctcE		;phandle event message - ignored	dc.w	ccc		;create cdev controls	dc.w	ham		;handle about message	dc.w	ctcE		;handle rectangle message - ignored	dc.w	hhm		;handle hit message	dc.w	rtc		;run the cdev;	secondary routines;;	ccc - create cdev controls.;;	entry	(atalkerr..) = appletalk error message control.;		[data1] = window ptr.;		read = gs/os command to read from a file.;;	exit	if appletalk isn't installed, the appletalk error;		text control is created.;;		if appletalk is active then:;		controls are created.;		[wptr] = window pointer.ccc	;jsr	iai		;is appletalk active	;bcc	ccc1		;if  active		;ldx	#atalkerr	;'AppleTalk must be installed to run É'	;ldy	#^atalkerr	;brl	cst		;create static text control and return  if Ethernet then	jsr check_ether		;set flag for presence of ethertalk  endifccc1	_Waitcursor	pha			;space for result	_GetMasterSCB	pla	xba	and	#$8000	sta	screenF		;!= 0 if 640 mode	lda	data1	sta	wptr		;save window pointer for later	lda	data1+2	sta	wptr+2	jsr	cac		;create actual controls			_InitCursor	rts	;;	ctc - close the cdev.;;	entry	called when to close the cdev and appletalk is active.;;	exit	name lookup is stopped.;		memory is disposed.;;	alternate entrypoint:  ctcE.;;	ctcE is used as a convenient rts instruction.ctc	;lda	#$ffff	;sta	lookupF		;flag to not start any more lookups	;jsr	knl		;kill name lookup	ctcE	ctc1	rts	;;	ham - handle about messsage.;;	entry	(about..) = static text control containg the about text.;;	exit	The 'about' control is created.ham	ldx	#about	ldy	#^about	brl	cst		;create static text control and return		;;	hhm - handle hit message.;;	entry	[data1] = handle to control.;		[data2] = id of control that was hit.;;	exit	control hit is processed.hhm	lda	data2		;get id of control that was hit	cmp #P8_id		;P8 radio button?	bne @next1@p8	lda #$0002		;BRAM value for P8	bra @set_bram@next1	cmp #GS_id		;GS/OS radio button?	bne @next2@gs	lda #$0001		;BRAM value for GS/OS@set_bram	ldx #$0062		;BRAM location for net boot os	jsr wbp			;new value in A	bra hhm1@next2**********   if Ethernet then	cmp #localIcID		;LocalTalk icon?	bne @next3	lda current_media	;what is currently selected?	beq hhm1		;already LocalTalk@set_local	stz current_media	;set to localtalk	ldx etherIcHdl	ldy etherIcHdl+2	bra @clear_icon		;reset the ethertalk icon@next3	cmp #etherIcID		;Ethertalk icon?	bne @next4	lda current_media	;what is currently selected?	bne hhm1		;already ether@set_ether	inc a			;A=1	sta current_media	;set to ether	ldx localIcHdl	ldy localIcHdl+2	;reset localtalk icon@clear_icon		;get here with icon control handle in X, Y	phy	phx			;leave handle on stack for DrawOneCtl	pea $0000		;new control value	phy	phx	_SetCtlValue	_DrawOneCtl		;handle is on stack; now set BRAM accordingly	lda current_media	inc a			;this converts to correct BRAM value	ldx #$0061		;BRAM location for network media	jsr wbp			;write to BRAM	bra hhm1		;all done@next4    endif	;if Ethernet**********hhm1	rts	;;	icc - init cdev controls.;;	entry	(atalkF) = 0 if appletalk isn't active.icc	;lda	atalkF	;beq	icc1		;if appletalk is not active	ldx #$0062		;battery parameter loc for startup OS	jsr rbp			;read from BRAM	cmp #$0002		;is P8 selected?	beq @p8			;go set P8 button@gs	ldx #$0062	lda #$0001		;make sure standard value is there	jsr wbp	lda GSHdl		;get handle	ldx GSHdl+2	bra @set_button@p8	lda P8Hdl	ldx P8Hdl+2@set_button	pea $0001		;set value to 1	phx			;high word of hdl	pha			;low   "   "   "	_SetCtlValue		;hilight button**********    if Ethernet then	ldx #$0061		;battery parameter loc for net media type	jsr rbp			;read from BRAM	cmp #$0002		;is EtherTalk selected?	beq @ether		;go select EtherTalk icon@local	ldx #$0061	lda #$0001		;make sure standard value is there	jsr wbp	stz current_media	;set to LocalTalk	lda localIcHdl		;get handle	ldx localIcHdl+2	bra @set_icon@ether	lda #$0001	sta current_media	;set to EtherTalk	lda etherIcHdl	ldx etherIcHdl+2@set_icon	pea $0001		;set value to 1	phx			;high word of hdl	pha			;low   "   "   "	_SetCtlValue		;hilight icon    endif**********icc1	rts;;	rtc - run the cdev.;;	entry	(lookupF) != 0 if not to do any more lookups.;;	exit	if lookups are allowed and out window is the frontmost, it starts a ;		lookup if the last one has stopped.rtc	;lda	lookupF	;bne	rtc1		;if not to look for new devices	;pha	;pha	;_FrontWindow	;pla			;lo ptr to window	;plx			;hi ptr to window	;cmp	wptr	;bne	rtc1		;if no longer the front window	;cpx	wptr+2	;bne	rtc1		;if no longer the front window	;brl	cnd		;check for new devices and return	rtc1	rts;;	cst - create static text.;;	entry	[x,y] = ptr to control.;		[data1] = window ptr.;;	exit	control is created.cst	pha			;space for result	pha	pushl	data1		;window pointer	pushw	#0		;next item is a ptr to a control	phy			;hi word of control	phx			;lo word of control	_NewControl2		;create the control	pla	pla			;don't care about result	rts;;	cac - create actual controls.;;	entry	(ctllist..) = table of long ptrs to control templates.;		[data1] = ptr to window.;;	exit	controls are createdcac	pha			;space for result	pha	pushl	data1		;window pointer	pushw	#3		;next item is a ptr to a list of template pointers	pushl	#ctllist	_NewControl2	pla	pla			;don't care about result	pha	pha			;space for result	pushl	data1		;window pointer	pushw	#0		;next item is a control	pushl	#P8Rad	_NewControl2	pulll	P8Hdl		;handle to control	pha	pha			;space for result	pushl	data1		;window pointer	pushw	#0		;next item is a control	pushl	#GSRad	_NewControl2	pulll	GSHdl		;handle to control    if Ethernet then	pha	pha			;space for result	pushl	data1		;window pointer	pushw	#0		;next item is a control	pushl	#local_icbut	_NewControl2	pulll	localIcHdl	;handle to control	pha	pha			;space for result	pushl	data1		;window pointer	pushw	#0		;next item is a control	pushl	#ether_icbut	_NewControl2	pulll	etherIcHdl	;handle to control    endif	rts	    if Ethernet thencheck_ether	;routine to check for presence of EtherTalk		;card and set haveEtherF accordingly	lda #$0001		;for now, pretend it's there	sta haveEtherF	rts    endif	; next routines from General CDEV;;	rbp - read battery parameter.;;	entry	(x) = parameter to read.;;	exit	(a) = value of parameter.rbp	pha			space for result	phx			parameter to read	_ReadBparam	pla			get value	rts;;	wbp - write battery parameter.;;	entry	(a) = value of parameter to set.;		(x) = battery parameter to set.;;	exit	battery parameter is set.wbp	pha			new value	phx			parameter to set	_WriteBparam	rtswptr		ds.b	4	;window pointerscreenF		ds.b	2	;high bit set if this is a 640 mode screenP8Hdl		ds.l 1		;P8 radio button handleGSHdl		ds.l 1		;GS/OS radio button handle	if Ethernet thenlocalIcHdl	ds.l 1		;LocalTalk icon control handleetherIcHdl	ds.l 1		;EtherTalk icon control handlehaveEtherF	ds.w 1		;flag for presence of EtherTalk card				; 0 --> no EtherTalk card				; 1 --> have EtherTalk cardcurrent_media	ds.w 1		;currently selected network media				; 0 --> LocalTalk				; 1 --> EtherTalk	endif	STRING ASIS	ENDP	END