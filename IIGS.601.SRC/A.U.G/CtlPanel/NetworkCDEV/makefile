CDEV = networkOPTIONS = -d Ethernet=0{CDEV}			 	Ä				{CDEV}.Load 	¶									{CDEV}.r	reziigs {OPTIONS} {CDEV}.r -o {CDEV} -t "C7  " -c "pdos"	if {dup}				# test whether we should duplicateiigs		duplicateiigs -m -y {CDEV} {CDEV}	end{CDEV}.Load		Ä	¶			network.aii.obj  ¶			networkdata.aii.obj 		linkiigs -x -lseg:$1000 network ¶			network.aii.obj  ¶			networkdata.aii.obj  ¶			 -o {CDEV}.Load			 {CDEV}.aii.obj 		Ä 		{CDEV}.aii	Makefile			¶							::cdev.h  ::commonmacros.h ::dp.h	asmiigs {OPTIONS} {CDEV}.aii networkdata.aii.obj 		Ä 		networkdata.aii	Makefile			¶							::cdev.h  ::commonmacros.h ::dp.h	asmiigs {OPTIONS} networkdata.aii 