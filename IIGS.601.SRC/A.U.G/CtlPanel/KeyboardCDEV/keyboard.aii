;;;	keyboard - cdev to control keyboard.;;	Michael V. Stein	01/08/90.;;	Copyright Apple Computer, 1990.	blanks	off		;;	equates.bpMKeysDelay	equ	$55	battery parameter for mouse key delaybpMKeysAccel	equ	$56	battery parameter for mouse key accelerationbpMKeysSpeed	equ	$57	battery parameter for mouse key speedidDelay		equ	10idAccel		equ	11idSpeed		equ	12;;	imported addresses.	import	keyabout	import	keyboardlist	import	keyboardr3menu	import	keyptr;;	include files.	include	'::cdev.h'	include	'::commonmacros.h'	include	'::dp.h'	include	'm16.control'	include	'm16.misctool'	include	'm16.util'			;;	main program.main	proc	export	keykey	phb			save calling data bank	phk	plb			set our data bank		;	make room on stack for direct page.	tsc				sec				sbc	#dpsize		make room on stack for new direct page	tcs				phd			save the current direct page	tcd			new direct page	lda	message		cmp	#11			bcs	key1		if message defintely not handled			asl	a		times 2 into word table	tax			move into index reg	jsr	(t_cdev-2,x)	call the handler of this messagekey1	pld			restore direct page	tsc	clc	adc	#dpsize			tcs			reset the stack	lda	1,s		Bump the stack up to prepare	sta	11,s		to take off the 3 parameters	lda	3,s			sta	13,s	pla			get rid of message space		pla			get rid of data1 space	pla					pla			get rid of data2 space	pla					lda	#0		return 0 to caller	sta	5,s	sta	7,s			plb		rtl		t_cdev	dc.w	cccE		Null	dc.w	cccE		handle machine message	dc.w	cccE		handle boot message	dc.w	icc		init cdev controls	dc.w	cccE		close the cdev	dc.w	cccE		handle event message	dc.w	ccc		create cdev controls	dc.w	ham		handle about message	dc.w	cccE		handle rectangle message	dc.w	hhm		handle hit message		;;	ccc - create cdev controls.;;	entry	[data1] = window pointer.;		(keybaordlist..) = table of pointers to control templates to create.;		(keyboard3menu..) = different popup menu to use when not on a rom 1 machine.;		[keyptr] = ptr to popup for repeat speed.;	;	exit	controls are created.ccc	lda	#0		is this necessary?	pha			space	pha			space	pha			space	pha			space	pha			(a)	pha			(x)	pha			(y)	pushw	#$fe1f		entrypoint to call	_FWEntry		call the firmware	ply			(y)	plx			(a) - unused	plx			(x) - unused	plx			(p) - unused	cpy	#2	bcc	ccc1		if not a new machine;	use other menu.	lda	#keyboardr3menu	sta	keyptr	lda	#^keyboardr3menu	sta	keyptr+2		ccc1	pha			space for result	pha	pushl	data1		window pointer	pushw	#3		next item is a ptr to a list of template pointers	pushl	#KeyboardList	_NewControl2	pla	pla			don't care about resultcccE	rts;;	ham - handle about message.;;	entry	[data1] = window pointer.;		(KeyAbout..) = template for about screen.;;	exit	The About control is created.ham	pha			space for result	pha	pushl	data1		window pointer	pushw	#0		next item is a ptr to a template	pushl	#KeyAbout	_NewControl2	pla	pla			don't care about result	rts	;;	hhm - handle hit message.;;	entry	[data1] = handle to control that was hit.;		[data2] = id of control that was hit.;;	exit	battery parameter locations are updated.hhm	pha			space for result	pushl	data1	_GetCtlValue	lda	data2		control that was hit	cmp	#10	bcs	hhm5		if keybaord mouse controls	cmp	#4	bcs	hhm1		if in checkboxes	pla	dea	bra	hhm2	hhm1	pla	beq	hhm2	lda	#1		if non-zero, make it one	hhm2	pha			replace back on stack for nowhhm3	ldx	data2		id of control that was hit	lda	params-1,x	tax			battery parameter to set	pla			get back value	bra	hhm8		set battery parameter and returnhhm5	cmp	#10	bne	hhm6		if not delay		pla			get value of control	dea			value to set	ldx	#bpMKeysDelay	bra	hhm8		set battery parameter and return			hhm6	cmp	#11	bne	hhm7		if not acceleration time	pla	dea	ldx	#bpMKeysAccel	bra	hhm8		set battery parameter and return				hhm7	cmp	#12	bne	hhm9	pla	dea	ldx	#bpMKeysSpeedhhm8	jmp	wbp		write battery parameter and return	hhm9	rts		;;	icc - init cdev controls.;;	entry	[data1] = window pointer.;		(params..) = table of battery parameters to check.;		bpMKeysDelay = battery parameter for keyboard mouse delay;		bpMKeysAccel = battery parameter for keyboard mouse accelleration.;		bpMKeysSpeed = battery paramter for keyboard mouse max speed.;		idAccel = id of control for keyboard mouse acceleration.;		idDelay = id of control for keyboard mouse delay.;		idSpeed = id of control for keyboard mouse max speeed.;		;	exit	controls are intialized to the battery settings.icc	ldx	#6		highest control	icc1	stx	icca		save for now	lda	params-1,x		and	#$ff	tax			parameter to check	jsr	rbp		read battery parameter	ldx	icca	cpx	#4	bcc	icc3		if not in checkboxes		tay	beq	icc3a		if checkbox shouldn't be set	lda	#1-1	icc3	inaicc3a	pha			put control value on stackicc4	pha			space for result	pha					pushl	data1		window pointer	pushw 	#0	pushw  	icca		id of control	_GetCtlHandleFromID	_SetCtlValue		value to set was already on stack		ldx	icca	dex	bne	icc1		if more controls to set;	init the keyboard mouse stuff.		ldx	#bpMKeysDelay	BRAM offset	jsr	rbp		read battery parameter	cmp	#255	bne	icc5		if already intialized	lda	#2		defaulticc5	ina	pha			new value	pha			space for handle	pha	Pushl 	data1		window ptr	pea	0	pea	idDelay		control's ID	_GetCtlHandleFromID	_SetCtlValue		set contol's value	ldx	#bpMKeysAccel	jsr	rbp		read battery parameter	cmp	#255	bne	icc6		if already initialed	lda	#2		defaulticc6	ina	pha			new value	pha			space for handle	pha	Pushl 	data1		window ptr	pea	0	pea	idAccel		control's ID	_GetCtlHandleFromID	_SetCtlValue		set contol's value		ldx	#bpMKeysSpeed	jsr	rbp		read battery parameter	cmp	#255	bne	icc7		if already initialized	lda	#6		defaulticc7	ina	pha			new value	pha			space for handle	pha	Pushl	 data1		window ptr	pea	0	pea	idSpeed		control's ID	_GetCtlHandleFromID	_SetCtlValue		set contol's value	rts	icca	dc.w	0		hold loop index	;;	rbp - read battery parameter.;;	entry	(x) = parameter to read.;;	exit	(a) = value of parameter.rbp	pha			space for result	phx			parameter to read	_ReadBparam	pla			get value	rts;;	wbp - write battery parameter.;;	entry	(a) = value of parameter to set.;		(x) = battery parameter to set.;;	exit	battery parameter is set.wbp	pha			new value	phx			parameter to set	_WriteBparam	rts	;	global data.;	battery parameters to check/set.params	dc.b	$2c	dc.b	$2d	dc.b	$32	dc.b	$2b	dc.b	$30	dc.b	$31			endp	end