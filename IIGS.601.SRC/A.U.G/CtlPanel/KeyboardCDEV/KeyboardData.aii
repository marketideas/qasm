;;;	keyboarddata - initialized data for keyboard CDEV.;;	Michael V. Stein	03/01/90.;;	© Apple, 1990.	blanks off	include	'e16.control'	string ASIS	dataseg	proc;	exported addresses.	export	keyabout	export	keyboardlist	export	keyboardr3menu	export	keyptrkeyboard1  	dc.w	9	dc.l	1	dc.w	2,5,14,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	70keyptr	dc.l	keyboardr1Menu	dc.w	1		;	menu to use for revision 1 roms.keyboardr1menu	dc.B '>> Speed:\H'	dc.W 1	dc.B $0D	dc.B '== 1 Char/Sec\H'	dc.W 1	dc.B $0D	dc.B '== 2 Chars/Sec\H'	dc.W 2	dc.B $0D	dc.B '== 4 Chars/Sec\H'	dc.W 3	dc.B $0D	dc.B '== 8 Chars/Sec\IH'	dc.W 4	dc.B $0D	dc.B '== 11 Chars/Sec\H'	dc.W 5	dc.B $0D	dc.B '== 15 Chars/Sec\H'	dc.W 6	dc.B $0D	dc.B '== 20 Chars/Sec\H'	dc.W 7	dc.B $0D	dc.B '== 24 Chars/Sec\H'	dc.W 8	dc.B $0D	dc.B '.'		;	menu to use if rom is at least rev 3.keyboardr3menu	dc.B '>> Speed:\H'	dc.W 1	dc.B $0D	dc.B '== 1 Char/Sec\H'	dc.W 1	dc.B $0D	dc.B '== 2 Chars/Sec\H'	dc.W 2	dc.B $0D	dc.B '== 4 Chars/Sec\H'	dc.W 3	dc.B $0D	dc.B '== 8 Chars/Sec\H'	dc.W 4	dc.B $0D	dc.B '== 11 Chars/Sec\H'	dc.W 5	dc.B $0D	dc.B '== 15 Chars/Sec\IH'	dc.W 6	dc.B $0D	dc.B '== 20 Chars/Sec\H'	dc.W 7	dc.B $0D	dc.B '== 24 Chars/Sec\H'	dc.W 8	dc.B $0D	dc.B '== 30 Chars/Sec\H'	dc.W 9	dc.B $0D	dc.B '== 40 Chars/Sec\H'	dc.W 10	dc.B $0D	dc.B '.'	keyboard2  	dc.w	9	dc.l	2	dc.w	17,5,29,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	70	dc.l	keyboard2Menu	dc.w	1	keyboard2menu	dc.B '>> Delay:\H'	dc.W 2	dc.B $0D	dc.B '== .25 Sec\H'	dc.W 1	dc.B $0D	dc.B '== .50 Sec\H'	dc.W 2	dc.B $0D	dc.B '== .75 Sec\IH'	dc.W 3	dc.B $0D	dc.B '== 1.0 Sec\H'	dc.W 4	dc.B $0D	dc.B '== No repeat\H'	dc.W 5	dc.B $0D	dc.B '.'	keyboard3  	dc.w	9	dc.l	3	dc.w	32,5,44,195	dc.l	$87000000	dc.w	$0040	dc.w	$1004	dc.l	0	dc.w	85	dc.l	keyboard3Menu	dc.w	1	keyboard3menu	dc.B 	'>> Dual Speed:\H'	dc.W 	3	dc.B 	$0D	dc.B 	'== Normal\IH'	dc.W 	1	dc.B 	$0D	dc.B 	'== Fast\H'	dc.W 	2	dc.B 	$0D	dc.B 	'.'		string pascalkeyboard5  	dc.w 8	dc.L 5-1	dc.w 49+5,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L keyboard5Title	dc.w 0keyboard5Title	dc.b 'Keyboard Buffering'	keyboard6  	dc.w 8	dc.L 6-1	dc.w 59+5,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L keyboard6Title	dc.w 0keyboard6Title	dc.b 'Shift Caps/Lowercase'	keyboard7  	dc.w 8	dc.L 7-1	dc.w 69+5,5,0,0	dc.L $82000000	dc.w 0	dc.w $1000	dc.L 0	dc.L keyboard7Title	dc.w 0keyboard7Title	dc.b 'Fast Space/Delete'	keyboardList	 	dc.l	keyboard1	dc.l	keyboard2	dc.l	keyboard3	dc.l	keyboard5	dc.l	keyboard6	dc.l	keyboard7	dc.L	SpeedPopup	dc.L	DelayPopup	dc.L	AccelPopup	dc.L	MouseKeyText	dc.l	0			rWidth		equ	200rX1		equ		5rX2		equ		rWidth-8textY1		equ	90textY2		equ	textY1+10delayY1		equ	textY2+2delayY2		equ	delayY1+12accelY1		equ	delayY2+3accelY2		equ	accelY1+12speedY1		equ	accelY2+3speedY2		equ	speedY1+12idDelay		equ	10idAccel		equ	11idSpeed		equ	12		STRING	ASISMouseKeyText		dc.W	8			pcount	dc.L	$8001	dc.W	textY1,rX1,textY2,rX2	boundry rect	dc.L	statTextControl		procRef	dc.W	inactiveHilite<<8	flag	dc.W	$1000			moreFlags		dc.L	0			refCon	dc.L	MouseKeyStr		textRef	dc.W	endStr-MouseKeyStr	text lengthMouseKeyStr		dc.B	'Keyboard Mouse:'endStrSpeedPopup	dc.W	9			pcount	dc.L	idSpeed			id	dc.W	speedY1,rX1,speedY2,rX2	  boundary rect	dc.L	$87000000		procRef	dc.W	$0042			flag	dc.W	$1004			moreFlags	dc.L	0			refCon	dc.W	0			title width	dc.L	SpeedPopupMenu		menuRef	dc.W	1			initial value	SpeedPopupMenu	dc.B	'>> Speed: \H'	dc.W	1	dc.B	$0D	dc.B	'== 8 Pixels/Sec\H'	dc.W	1	dc.B	$0D	dc.B	'== 11 Pixels/Sec\H'	dc.W	2	dc.B	$0D	dc.B	'== 15 Pixels/Sec\H'	dc.W	3	dc.B	$0D	dc.B	'== 20 Pixels/Sec\H'	dc.W	4	dc.B	$0D	dc.B	'== 24 Pixels/Sec\H'	dc.W	5	dc.B	$0D	dc.B	'== 30 Pixels/Sec\H'	dc.W	6	dc.B	$0D	dc.B	'== 40 Pixels/Sec\IH'	dc.W	7	dc.B	$0D	dc.B	'== 60 Pixels/Sec\H'	dc.W	8	dc.B	$0D	dc.B	'== 120 Pixels/Sec\H'	dc.W	9	dc.B	$0D	dc.B	'== 180 Pixels/Sec\H'	dc.W	10	dc.B	$0D	dc.B	'.'	DelayPopup	dc.W	9			pcount	dc.L	idDelay			id	dc.W	delayY1,rX1,delayY2,rX2	  boundry rect	dc.L	$87000000		procRef	dc.W	$0042			flag	dc.W	$1004			moreFlags	dc.L	0			refCon	dc.W	0			title width	dc.L	DelayPopupMenu		menuRef	dc.W	1			initial value	DelayPopupMenu	dc.B	'>> Initial Delay: \H'	dc.W	2	dc.B	$0D	dc.B	'== 0.25 Sec\H'	dc.W	1	dc.B	$0D	dc.B	'== 0.50 Sec\H'	dc.W	2	dc.B	$0D	dc.B	'== 0.75 Sec\IH'	dc.W	3	dc.B	$0D	dc.B	'== 1.0 Sec\H'	dc.W	4	dc.B	$0D	dc.B	'== 1.25 Sec\H'	dc.W	5	dc.B	$0D	dc.B	'.'AccelPopup	dc.W	9			pcount	dc.L	idAccel			id	dc.W	accelY1,rX1,accelY2,rX2	  boundry rect	dc.L	$87000000		procRef	dc.W	$0042			flag	dc.W	$1004			moreFlags	dc.L	0			refCon	dc.W	0			title width	dc.L	AccelPopupMenu		menuRef	dc.W	1			initial value	AccelPopupMenu	dc.B	'>> Acceleration: \H'	dc.W	3	dc.B	$0D	dc.B	'== 6.0 Sec\H'	dc.W	1	dc.B	$0D	dc.B	'== 4.5 Sec\H'	dc.W	2	dc.B	$0D	dc.B	'== 3.0 Sec\IH'	dc.W	3	dc.B	$0D	dc.B	'== 1.5 Sec\H'	dc.W	4	dc.B	$0D	dc.B	'== 0.0 Sec\H'	dc.W	5	dc.B	$0D	dc.B	'.'	string pascalkeyAbout	 	dc.w 	8	dc.L 	1	dc.w 	38,5,138,280	dc.L 	$81000000	dc.w 	$0000	dc.w 	$1000	dc.L 	0	dc.L 	TheText	dc.w 	EndText-TheText	string asisTheText	dc.b 	'The Keyboard Control Panel allows you to change system settings that '	dc.b 	'affect the keyboard.  The Keyboard Mouse allows you to '	dc.b	'simulate the mouse by using the keypad.'EndText		endp	end