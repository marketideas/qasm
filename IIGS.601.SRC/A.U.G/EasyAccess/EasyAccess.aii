*===============================================**						** File:		EasyAccess.aii			** Project:	Easy Access for the IIGS	** Author:	Don J. Brady			** Build file:	EasyAccess.Make			**						** Copyright © Apple Computer, Inc. 1989,1990	** All rights reserved.				**-----------------------------------------------** Modification History:				** 11/07/89 DJB	- File created today		*** 12/5/90  JLM	- Bug fixed today with recognition of early ROM 01 machines** 6-Jun-91 Dave Lyons*   Added a single XBA instruction when pushing*   the parmeters to FakeMouse.  This was making*   modifiers not work on keyboard-mouse clicks.**						**===============================================*		STRING	ASIS				PRINT	NOPAGE		PRINT	NOGEN		PRINT	OFF				INCLUDE	'M16.Memory'		; toolbox macros		INCLUDE	'M16.Quickdraw'		INCLUDE	'M16.Event'		INCLUDE	'M16.Menu'		INCLUDE	'M16.Locator'		INCLUDE	'M16.MiscTool'		INCLUDE	'M16.ADB'		INCLUDE	'M16.IntMath'		INCLUDE	'E16.ADB'		; toolbox equates		INCLUDE	'EasyAccess.equ'				PRINT	ONpicDV		equ	8picDH		equ	20picX		equ	640-picDH-4picY		equ	2*===============================================*Start		PROC		IMPORT	Install				brl	Install				ENDP*===============================================**	Data used by Easy Access		**===============================================*GlobalData	PROC		;--- general data:				ENTRY	UserIDUserID		ds.W	1		ENTRY	ADBVersionADBVersion	ds.W	1		ENTRY	TempTemp		ds.B	8		ENTRY	ModsToFreeModsToFree	dc.W	0		ENTRY	NewImageNewImage	dc.L	0		ENTRY	LastTickLastTick	dc.L	0;--- data for MouseKeys:		ENTRY	MouseKeysOnMouseKeysOn	dc.W	0		ENTRY	MKMultOnMKMultOn	dc.W	0		ENTRY	MouseDirectionMouseDirection	dc.W	0		ENTRY	PixelsPerPressPixelsPerPress	dc.W	0		ENTRY	ButtonStateButtonState	dc.W	0		ENTRY	ClampAddrClampAddr	ds.L	1		ENTRY	MKLastTickMKLastTick	ds.L	1		ENTRY	MKDelayPassedMKDelayPassed	ds.W	1		ENTRY	MKAccelPassedMKAccelPassed	ds.W	1		ENTRY	MKDelayTicksMKDelayTicks	ds.W	1		ENTRY	MKAccelTicksMKAccelTicks	ds.W	1		ENTRY	SubPixTotalSubPixTotal	ds.W	1		ENTRY	SubPixDeltaSubPixDelta	ds.W	1		ENTRY	SubPixMaxSubPixMax	ds.W	1		ENTRY	SubPixAccelSubPixAccel	ds.W	1		ENTRY	MKDelayData		; ticks to waitMKDelayData		dc.W	15			; 0.25 sec		dc.W	30			; 0.50 sec		dc.W	45			; 0.75 sec		dc.W	60			; 1.00 sec		dc.W	75			; 1.25 sec		ENTRY	MKAccelData		; ticks until max speedMKAccelData		dc.W	360			; 6.0 sec		dc.W	270			; 4.5 sec		dc.W	180			; 3.0 sec		dc.W	90			; 1.5 sec		dc.W	0			; 0.0 sec		ENTRY	MKSpeedDataMKSpeedData					; 1/256th pixels per tick (sub pixels)		dc.W	8*256/60		;   8  pixels/sec		dc.W	11*256/60		;  11	"		dc.W	15*256/60		;  15	"			dc.W	20*256/60		;  20	"		dc.W	24*256/60		;  24	"		dc.W	30*256/60		;  30	"		dc.W	40*256/60		;  40	"		dc.W	60*256/60		;  60	"		dc.W	120*256/60		; 120	"		dc.W	180*256/60		; 180	";--- data for sticky keys:		ENTRY	TempY	TempY		dc.W	0		ENTRY	TempX	TempX		dc.W	0		ENTRY	LastKey	LastKey		dc.W	0		ENTRY	KeyCount	KeyCount	dc.W	0		ENTRY	Flag	Flag		dc.W	0		ENTRY	SBits	SBits		dc.W	0		ENTRY	LBits	LBits		dc.W	0		ENTRY	ADBData	ADBData		dc.W	0;--- ROM 03 sticky keys data:				ENTRY	LastLockStateLastLockState	dc.W	0		ENTRY	LastStuckStateLastStuckState	dc.W	0		ENTRY	LastBitsLastBits	dc.W	0		ENTRY	LastStateLastState	dc.W	0		ENTRY	PicLocInfo		ENTRY	PicImage		ENTRY	PicRectPicLocInfo	DC.W	$80			; port SCBPicImage	DC.L	$0000			; image ptr		DC.W	5			; image width (bytes)PicRect		DC.W 	0,0,picDV,picDH		; bounds rect		ENTRY	PicPtPicPt		dc.W	picY,picX		ENTRY	OnImageOnImage		dc.B	$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00		dc.B	$00,$00,$00,$00,$00		dc.B	$0F,$F0,$00,$00,$FF		dc.B	$00,$F0,$00,$00,$F0		dc.B	$00,$F0,$00,$00,$F0		dc.B	$00,$FF,$FF,$FF,$F0		ENTRY	StickImageStickImage	dc.B	$00,$00,$0F,$00,$00		dc.B	$00,$00,$0F,$00,$00		dc.B	$00,$0F,$FF,$FF,$00		dc.B	$00,$00,$FF,$F0,$00		dc.B	$0F,$F0,$0F,$00,$FF		dc.B	$00,$F0,$00,$00,$F0		dc.B	$00,$F0,$00,$00,$F0		dc.B	$00,$FF,$FF,$FF,$F0		ENTRY	LockImageLockImage	dc.B	$00,$00,$0F,$00,$00		dc.B	$00,$00,$0F,$00,$00		dc.B	$00,$0F,$FF,$FF,$00		dc.B	$00,$00,$FF,$F0,$00		dc.B	$0F,$F0,$0F,$00,$FF		dc.B	$00,$FF,$FF,$FF,$F0		dc.B	$00,$FF,$FF,$FF,$F0		dc.B	$00,$FF,$FF,$FF,$F0		ENTRY	NumToBitMaskNumToBitMask	dc.W	%00000001		; 0, control		dc.W	%00000010		; 1, apple		dc.W	%00000100		; 2, shift		dc.W	%00001000		; 3, caps lock		dc.W	%00010000		; 4, option;--- vectors to patch:		ENTRY	GetNextEventVecGetNextEventVec	dc.B	$5C			; jml  $bbAAAA		dc.L	0		ENTRY	DrawMenuBarVecDrawMenuBarVec	dc.B	$5C			; jml  $bbAAAA		dc.L	0		ENTRY	BRSVecBRSVec		dc.B	$5C			; jml  $bbAAAA		dc.L	0		ENDP*===============================================**						**	Patch into ADB keyboard			**						**===============================================*Install		PROC				LONGA	ON		LONGI	ON		IMPORT	NewTSFuncPtr		IMPORT	MyGetNextEvent		IMPORT	MyDrawMenuBar		IMPORT	PatchKeyboard		IMPORT	GetKeyModBits		IMPORT	CheckMKeyParams				phb				; use local addressing		phk		plb				jsr	GetKeyModBits		and	#kmOption		; if option key down		beq	ok		brl	exit			; don't install patch	ok		pha				; space for userID (word)		_MMStartUp		pla		sta	UserID			; used for memory allocations		stz	MouseKeysOn;--- Check which version of ADB micro:		pea	1			; number of data bytes		pea	Temp>>16		; pointer to data		pea	Temp		pea	readVersionNum		; command		_ReadKeyMicroData		lda	Temp		sta	ADBVersion; 12/5/90 Mensch; OOops Don had a bug here where he was testing for a certain key micro version; what he should have done was level test to insure that the key micro is earlier; than rom 03 ; was:;		cmp #adbVerROM01;		bne @skip;		cmp	#adbVerROM03		bge	@skip			; only need completion routine if ROM 01;--- Move keyboard to new address:		jsr	PatchKeyboard;--- Get data for MouseKeys:		pha				; space for address (long)		pha		pea	mouseClamps		_GetAddr			; get address of mouse clamps		pla		sta	ClampAddr		pla		sta	ClampAddr+2		jsr	CheckMKeyParams		; get MouseKeys parameters from BRAM;--- Install toolbox patches:@skip				pha				; space for result (long)		pha		pea	GetNextEvent		pea	MyGetNextEvent>>16		pea	MyGetNextEvent-1		jsl	NewTSFuncPtr		; patch out _GetNextEvent		pla		plx		inc	a		bne	@set1		inx@set1		sta	GetNextEventVec+1			stx	GetNextEventVec+3		pha				; space for result (long)		pha		pea	DrawMenuBar		pea	MyDrawMenuBar>>16		pea	MyDrawMenuBar-1		jsl	NewTSFuncPtr		; patch out _DrawMenuBar		pla		plx		inc	a		bne	@set2		inx@set2		sta	DrawMenuBarVec+1		stx	DrawMenuBarVec+3		_SetDefaultTPT			; permanently install these patches!		exit		plb		rtl		ENDP*===============================================*PatchKeyboard	PROC		LONGA	ON		LONGI	ON				IMPORT	KBCompletion		IMPORT	SendADBInfo		IMPORT	KMSTATUSTask;--- disable keymicro autopoll		ldx	#1			; bytes to send		ldy	#setModes		; command = disable keyboard autopoll		lda	#%00000001		; data (bit 0 = ADB keyboard autopoll)		jsr	SendADBInfo;--- install our SRQ routine:		pea	KBCompletion>>16		pea	KBCompletion		pea	$02			; register 0 and ADB address of 2		_SRQPoll			; add device to SRQ list;--- now patch BSR vector:		pha		pha		pea	BRAMSetupVec		_GetVector		pla		sta	>BRSVec+1		pla		sta	>BRSVec+3					pea	BRAMSetupVec		pea	_Patch>>16		pea	_Patch		_SetVector; insall VBL task to fix bug:		pea	KMSTATUSTask>>16		pea	KMSTATUSTask		_SetHeartBeat			; install our vbl task		rts;-----------------------------------------------;; We must patch the ToSetBRAM routine since; it is 'bad' and makes an ADB abort ($01) call.; Since the abort call reenables autopoll, this; causes our keyboard "patch" to be undone.  This; patch will fix the problem by disabling autopoll; again after the ToSetBRAM routine is finished.; ;-----------------------------------------------_Patch		LONGA	OFF		LONGI	OFF		jsl	BRSVec			; first call real routine		php				; save carry, M and X flags		rep	#$30			; force 16-bit registers		LONGA	ON		LONGI	ON; disable auto poll again:		ldx	#1			; bytes to send		ldy	#setModes		; command = disable keyboard autopoll		lda	#%00000001		; data (bit 0 = ADB keyboard autopoll)		jsr	SendADBInfo		plp				; resore carry, M and X flags		rtl		ENDP			*===============================================**	Our Keyboard SRQ Completion Routine	**						** This routine is called everytime the keyboard ** has data to process (i.e. keystrokes).	**						** In:	stack = rtlAddr1 (3 bytes)		**		rtlAddr2 (3 bytes)		**		dataPtr (4 bytes)		**						** Out:	dataPtr removed from stack		**	carry flag is clear			**===============================================*KBCompletion	PROCdataBank	SET	1			; stack offsetsdirPage		SET	dataBank+1rtlAddr1	SET	dirPage+2rtlAddr2	SET	rtlAddr1+3dataPtr		SET	rtlAddr2+3		LONGA	OFF			; completion uses 8-bit mode		LONGI	OFF		IMPORT	StickyKeys		IMPORT	MouseKeys		IMPORT	PostKey		IMPORT	FreeModifiers		IMPORT	TestForReset		phb		phd		phk		plb		tsc				; make a stack frame		tcd				lda	[<dataPtr]		; is there any data ?		beq	exit			; no, so exit		rep	#$30		LONGA	ON		LONGI	ON				ldy	#1		lda	[<dataPtr],y		; get key data (2 bytes)		sta	>$FF8000		; debug trigger				tay				; save copy of A in Y		and	#kcMask		cmp	#kcReset		beq	reset			; reset key is special case		tya		and	#$FF00		xba		tax				; X <-- key code #2		tya		and	#$00FF			; A <-- key code #1		bra	processreset		tya				; note: reset key code is 2 bytes		ldx	#nullKeyprocess		phx				; save 2nd key stroke		jsr	TestForReset		jsr	StickyKeys		jsr	MouseKeys		; must be checked last		plx				; get 2nd key stroke		pha				; save 1st key result		txa		jsr	StickyKeys		jsr	MouseKeys		plx				; get back 1st key result		pha				; save 2nd key result		txa		jsr	PostKey			; post the 1st key		pla		jsr	PostKey			; post the 2nd key		jsr	FreeModifiers		; release latched modifier keys				sep	#$30		LONGA	OFF		LONGI	OFFexit		pld		plb		clc		rtl		ENDP*===============================================**	Post a key to the ADB micro		**						** This routine will post a key to the ADB micro	** controller via the ADB toolset.  The 'key'	** then appears at the hardware loaction $C000	** (or at $C025 if its a modifier key) as if it	** came stright from the keyboard.		**						** In:	a-reg has raw key code			** Out:	none					**						** trashes Temp					**===============================================*PostKey		PROC		LONGA	ON		LONGI	ON				IMPORT	SendADBInfo		IMPORT	GetKeyModBits				cmp	#nullKey		; null key code?		beq	skip			; yes, so skip		cmp	#$00E0			; is keycode ³ E0 ?		bcs	skip			; yes, so throw it away		cmp	#kcFirstMod		; is it a mod key down code?		bcc	ok		cmp	#kcLastMod+1		bcs	ok		tax				; save key code		sec		sbc	#kcFirstMod		; convert to table index		asl	a		tay		jsr	GetKeyModBits		and	BitMasks,y		bne	skip			; already down, so skip		txa				; restore key code		ok				ldx	#1			; bytes to send		ldy	#keyCode		; command = send key code		jsr	SendADBInfo		; post key code to key microskip		rtsBitMasks		DC.W	kmControl		DC.W	kmApple		DC.W	kmShift		DC.W	kmCapsLock		DC.W	kmOption		ENDP*===============================================**	Send data to ADB micro			**						** In:	a-reg has ADB data			**	x-reg has data count (0,1,or 2)		**	y-reg has ADB command			**						** Out:	none					**						** trashes Temp					**===============================================*SendADBInfo	PROC		LONGA	ON		LONGI	ON				sta	>Temp			; use Temp as buffer				phx				; bytes to send		pea	Temp>>16		; ptr to data		pea	Temp		phy				; command		_SendInfo		rts		ENDP*===============================================** Release some modifier keys			**===============================================*FreeModifiers	PROC		lda	ModsToFree		beq	exit		ldx	#4*2		@loop		and	NumToBitMask,x		beq	@next		txa		lsr	a		clc		adc	#kcFirstMod+kcKeyUp		phx		jsr	PostKey			; post modifier up		plx@next		lda	ModsToFree		dex		dex		bpl	@loop		stz	ModsToFreeexit		rts		ENDP*===============================================**						** IN:	a-reg has ADB key code			**						** OUT:	a-reg has ADB key code			**						** NOTE	This routine will not return if the	**	control-reset sequence has occured!	**===============================================*TestForReset	PROC		LONGA	ON		LONGI	ON				IMPORT	GetKeyModBits		IMPORT	SendADBInfo				tay				; save key code in Y		and	#kcMask		cmp	#kcRESET		; is this the reset key?		bne	skip			; no, so skip				tya		and	#kcKeyUp		; is it a reset up		bne	null			; yes, so we don't care		jsr	GetKeyModBits		tax		and	#kmControl		; is control key down?		bne	reset			; yes, so good bye!null		ldy	#nullKey		; throw reset key away		bra	skipreset		ldx	#0			; bytes to send		ldy	#resetSys		; command = reset		lda	#0			; data		jsr	SendADBInfo		; will not return		brk	$db			; should never get here!skip				tya				; restore key code		rts				ENDP*===============================================** StickyKeys:	latch modifier keys		**						** IN:	a-reg has raw key data			**						** OUT:	a-reg has raw key data			**						**===============================================*StickyKeys	PROC		LONGA	ON		LONGI	ON				IMPORT	SetOnImage		IMPORT	SetOffImage		IMPORT	SetStickImage		IMPORT	SetLockImagesBit		equ	$80mBit		equ	$40mMask		equ	$1F				sta	ADBData		cmp	#nullKey		; not a valid if null key		bne	@OK		brl	@Done	@OK		cmp	#$0080			; is it a down key (bit 7 clear)?		bcc	@KeyDown		; yes		and	#$007F		tax				; x <-- raw key code less high bit		brl	@keyUp			; no, skip recording keystroke		@KeyDown		tax		cpx	LastKey			; same as last key typed		bne	@NotSame		lda	>EMXPos			; get mouse coordinates		cmp	TempX			; same as before?		bne	@NotSame		lda	>EMYPos		cmp	TempY		beq	@Same			; key was same and mouse has not moved@NotSame		stx	LastKey			; save the keystroke		lda	#1		sta	KeyCount		; count is 1		lda	>EMXPos			; save the mouse position		sta	TempX		lda	>EMYPos		sta	TempY		bra	@KeyUp	@Same		ldy	KeyCount		; get the count		iny				; increment it		cpy	#5			; have we seen five yet?		bcc	@NotYet		stz	KeyCount		; clear the count		cpx	#kcSHIFT		; was it the shift key?		bne	@NotYet			; no				lda	#sBit		eor	Flag			; invert SBit		sta	Flag		and	#sBit		beq	@StickyOff		; skip if we just turned it off		bra	@Show		@StickyOff		stz	Flag			; clear the flags		lda	SBits		ora	LBits		tsb	ModsToFree		; to be released later...		stz	SBits		stz	LBits		jsr	SetOffImage		; no bitmap for no icon		bra	@Done	@NotYet		sty	KeyCount@KeyUp		lda	Flag		and	#sBit			; are sticky keys on?		beq	@Done			; if not, skip				cpx	#kcFirstMod		; is it a modifier key?		bcc	@RealKey		; no, skip		cpx	#kcLastMod+1		; is it a modifier?		bcc	@Modifier		; yes, skip	@RealKey		lda	Flag		and	#mBit			; is a modifier down?		beq	@continue		; no, so contiue	@2KeyExit		lda	Flag			; get which modifier		and	#mMask		trb	SBits			; remember which modifier was down		bra	@StickyOff	@Continue		ldy	ADBData			; is it a key up?		cpy	#$80		bcc	@Done			; skip if not		; It is an up-stroke on a non-modifier key.; Release all unlocked sticky keys.		lda	LBits		eor	SBits			; turn off the ones that are locked		tsb	ModsToFree		; release any stuck modifier keys		lda	LBits		sta	SBits			; if, locked then its also sticky	@Show		lda	LBits			; skip if there are locked mods		bne	@Done		jsr	SetOnImage@Done		lda	ADBData		rts@Modifier		cpx	#kcCAPSLOCK		; caps lock?		beq	@Done			; yes, so we're done		txa		sec		sbc	#kcFirstMod		asl	a			; y <-- index to bit mask		tay		ldx	NumToBitMask,y		; x <-- NumToBitMask(key)		ldy	ADBData			; is it a key down?		cpy	#$80		bcs	@ModUp			; no, skip				lda	#mBit		tsb	Flag			; set the modifier down bit; *** omit for compatibility with ROM 03 version ***;		bne	@2KeyExit		; if already set before, turn off sticky keys				lda	Flag			; mask out the modifier number		and	#Å(mMask)		sta	Flag		txa		tsb	Flag			; replace it with the current one				and	LBits			; is it locked?		bne	@Unlock			; yes, unlock it		txa		and	SBits			; is it sticky?		bne	@lock			; yes, lock it; it's neither sticky or locked, make it sticky		txa		tsb	SBits			; stick		lda	NewImage		cmp	#LockImage		beq	@Done				jsr	SetStickImage		bra	@Done		@Unlock		txa		trb	LBits			; unlock		trb	SBits			; unstick		tsb	ModsToFree		; release it later		bra	@show		@Lock		txa		tsb	LBits			; lock		lda	#nullKey		sta	ADBData			; discard the keystroke				jsr	SetLockImage		bra	@done	@ModUp		lda	#mBit		trb	Flag			; clear "modifier down flag"		txa		and	SBits			; if it's locked it's sticky		beq	@done			; skip if not		lda	#nullKey		sta	ADBData			; discard the keystroke		bra	@done				ENDP*===============================================** _GetNextEvent Patch Routine			**						**===============================================*MyGetNextEvent	PROC		LONGA	ON		LONGI	ON		IMPORT	ShowState		IMPORT	CheckADBMicro		IMPORT	CheckMKeyParams								phb		phk				; local addressing		plb				pha				; save registers		phx		phy;--- should we monitor ?		pha		pha		_GetTick		pla		plx				tax		sec		sbc	LastTick		cmp	#30			; 1/2 second		bcc	skip				stx	LastTick				lda	ADBVersion		cmp	#adbNewVersion		; is this new micro ?		bcc	@old				jsr	CheckADBMicro		; monitor ADB micro if new		bra	skip		@old		lda	MouseKeysOn		beq	skip				jsr	CheckMKeyParamsskip		lda	NewImage		cmp	PicImage		beq	@exit				pea	0		_MenuStatus			; is Menu manager started?		pla		beq	@exit			; no so skip		jsr	ShowState		; undraw current image		lda	NewImage		sta	PicImage		lda	NewImage+2		sta	PicImage+2		jsr	ShowState		; draw new image@exit		ply				; restore registers		plx		pla		plb		jmp	GetNextEventVec		; go to REAL GetNextEvent				ENDP		*===============================================** _*BootInit Patch Routine			**						**===============================================*MyBootInit	PROC		LONGA	ON		LONGI	ON		rtl				; just return				ENDP*===============================================** _DrawMenuBar Patch Routine			**						**===============================================*MyDrawMenuBar	PROC		LONGA	ON		LONGI	ON		IMPORT	ShowState						jsl	DrawMenuBarVec		; go visit DrawMenuBar()		pha				; save A-reg		jsr	ShowState		; draw new image		pla				; restore A-reg		cmp	#1			; adjust carry based on a-reg		rtl				ENDP		*===============================================**						** In:	none					** Out:	none					**===============================================*		ShowState	PROC		LONGA	ON		LONGI	ON		lda	>PicImage		; an image to draw?		ora	>PicImage+2		beq	@skip				pha		pha		_GetPort		pha		pha		_GetMenuMgrPort		_SetPort				lda	#picX			; 640 mode values		sta	>PicPt+2		lda	#picDH		sta	>PicRect+6		pha				_GetMasterSCB			; 640 or 320 mode?		pla		and	#$00FF		sta	>PicLocInfo		and	#$0080			; is it 640 ?		bne	@pp			; yes		lda	#picX/2			; 320 mode values		sta	>PicPt+2		lda	#picDH/2		sta	>PicRect+6@pp				pea	PicLocInfo>>16		pea	PicLocInfo		pea	PicRect>>16		pea	PicRect		lda	>PicPt+2		pha		lda	>PicPt		pha		pea	2			; 2 = modeXOR		_PPToPort				_SetPort		@skip		rts						ENDP		*===============================================**						** Input:	*** Stack ***			**		result - LONG			**		trapNum - WORD			**		newFuncPtr - LONG		**		rtlAddr - 3 BYTES		**	sp --->					**						** Output:	*** Stack ***			**		result - LONG			**		rtlAddr - 3 BYTES		**	sp --->					**===============================================*NewTSFuncPtr	PROC		IMPORT	MyBootInitfirstLocal	set	1			; local variablestsNum		set	firstLocal	tsFunc		set	tsNum+2tsPtr		set	tsFunc+2fptPtr		set	tsPtr+4	tblSize		set	fptPtr+4handle		set	tblSize+4lastLocal	set	handle+4rtlAddr		set	lastLocal		; input parameters (reverse order)lastParam	set	rtlAddr+3newFuncPtr	set	lastParamtrapNum		set	newFuncPtr+4	firstParam	set	trapNum+2oldFuncPtr	set	firstParam		; resultlocalSize	set	lastLocal-firstLocalparamSize	set	firstParam-lastParam				tsc				; make a stack frame		sec		sbc	#localSize		tcs		phd				; save current dp		tcd; begin				lda	<trapNum		and	#$00FF		sta	<tsNum		lda	<trapNum		xba		and	#$00FF		sta	<tsFunc				pea	0			; space for result		lda	<tsNum		ora	#$0600			; _xxxxStatus Function		tax		jsl	>$E10000		; is the tool even loaded?		pla		bne	@ok				pei	<tsNum			; tool number		pea	0			; min version		_LoadOneTool			; load it		bcc	@ok@bad		brk	$db		brl	end			; give up@ok		pha				; space for pointer (long)		pha		pea	0			; 0 = system tool set		pei	<tsNum			; tool set number		_GetTSPtr		pla		plx		sta	<tsPtr		stx	<tsPtr+2		lda	[<tsPtr]		; is the tool there?		beq	@bad		pha				; space for result (long)		pha		pea	0			; 0 = system tool set		pei	<trapNum		_GetFuncPtr		pla		plx		sta	<oldFuncPtr		stx	<oldFuncPtr+2				lda	[<tsPtr]		; calculate the size of the table		asl	a		asl	a			; size is count * 4		sta	<tblSize		stz	<tblSize+2		pha				; space for handle (long)		pha				pei	<tblSize+2		; size		pei	<tblSize		lda	UserID		pha				; user id		pea	%0100000000011000	; fixed, no bank cross, no special		pea	0			; address (long), not used		pea	0		_NewHandle		pla		plx		sta	<handle		stx	<handle+2				ldy	#2		lda	[<handle],y		tax		lda	[<handle]		sta	<fptPtr		stx	<fptPtr+2				lda	#0			; zero out new table		ldy	<tblSize		dey		dey@loop		sta	[<fptPtr],y		dey		dey		bpl	@loop				lda	<tblSize		lsr	a		lsr	a		sta	[<fptPtr]		; set function table count		lda	<tsFunc		asl	a		asl	a		tay		lda	<newFuncPtr		sta	[<fptPtr],y		; set new function pointer		iny		iny		lda	<newFuncPtr+2		sta	[<fptPtr],y; always patch bootinit:		ldy	#4		lda	#MyBootInit-1		sta	[<fptPtr],y		; set new BootInit function pointer		iny		iny		lda	#MyBootInit>>16		sta	[<fptPtr],y		pea	0			; 0 = system tool set		pei	<tsNum			; tool set number		pei	<fptPtr+2		; pointer to new function pointer table		pei	<fptPtr		_SetTSPtrend				lda	<rtlAddr		; clean up stack		sta	<rtlAddr+paramSize		lda	<rtlAddr+1		sta	<rtlAddr+paramSize+1		pld				; restore dp		tsc		clc		adc	#paramSize+localsize		tcs				rtl				ENDP		*===============================================**						** In:	none					** Out:	none					**===============================================*CheckMKeyParams	PROC		LONGA	ON		LONGI	ON		pha		pea	bpMKeysDelay		_ReadBParam		pla		cmp	#$FF			; uninitialized?		bne	@ok1		lda	#2			; yes so use default			@ok1		and	#$07		asl	a		tay		lda	MKDelayData,y		sta	MKDelayTicks		pha		pea	bpMKeysAccel		_ReadBParam		pla		cmp	#$FF			; uninitialized?		bne	@ok2		lda	#2			; yes so use default			@ok2		and	#$07		asl	a		tay		lda	MKAccelData,y		sta	MKAccelTicks		pha		pea	bpMKeysSpeed		_ReadBParam		pla		cmp	#$FF			; uninitialized?		bne	@ok3		lda	#6			; yes so use default			@ok3		and	#$0F		asl	a		tay		lda	MKSpeedData,y		sta	SubPixMax;--- calculate acceleration sub pixels:		lda	MKAccelTicks		; is there an acceleration period?		beq	done			; no				pha				; space for remainder		pha				; space for quotient		lda	SubPixMax		pha		lda	MKAccelTicks		lsr	a			; MKAccelTicks/8		lsr	a		lsr	a		pha		_UDivide			; (SubPixMax/(MKAccelTicks/8)		pla		bne	@ok		lda	#1			; must be at least 1@ok		plx		sta	SubPixAcceldone		rts		ENDP		*===============================================**						** In:	none					** Out:	none					**===============================================*CheckADBMicro	PROC		LONGA	ON		LONGI	ON				IMPORT	SetOnImage		IMPORT	SetOffImage		IMPORT	SetStickImage		IMPORT	SetLockImage; first check for change in sticky keys on/off state:		lda	#mcMicroStatus		jsr	ReadMicroByte		and	#mcStickyKeysOn		cmp	LastState		beq	stickCheck		; no change, check stick/lock bits		sta	LastState		tax		beq	offon						; sticky keys was turned on		jsr	SetOnImage		bra	exitoff						; sticky keys was turned off		jsr	SetOffImage		bra	exit			; all done; now check for stuck mod keys:stickCheck		lda	LastState		beq	exit			; all done		lda	#mcStickyBits		jsr	ReadMicroByte		cmp	LastBits		beq	exit			; no change		sta	LastBits		and	#mcStuckMask		tax		beq	@here		lda	#1@here		cmp	LastStuckState		beq	lockCheck		; no change		sta	LastStuckState		txa		beq	stuckOffstuckOn						; a mod key was stuck		jsr	SetStickImage		bra	lockCheckstuckOff					; a mod key was un-stuck		jsr	SetOnImage; now check for locked mod keys:lockCheck		lda	LastBits		and	#mcLockMask		tax		beq	@here		lda	#1@here		cmp	LastLockState		beq	exit			; no change		sta	LastLockState		txa		beq	lockOfflockOn						; a mod key was locked		jsr	SetLockImage		bra	exitlockOff						; a mod key was unlocked		jsr	SetOnImageexit		rts;-----------------------------------------------ReadMicroByte		sta	Temp+2			; address of byte to read				pea	Temp>>16		; location of result		pea	Temp		pea	Temp>>16		; ptr to address of byte to read		pea	Temp+2		pea	readMicroMem		; command		_ReadKeyMicroMemory		lda	Temp		and	#$00FF		rts				ENDP		*===============================================**						** In:	none					** Out:	none					**===============================================*SetOnImage	PROC		lda	#OnImage		sta	>NewImage		lda	#OnImage>>16		sta	>NewImage+2		rts			ENDP*===============================================**						** In:	none					** Out:	none					**===============================================*SetOffImage	PROC		lda	#0		sta	>NewImage		sta	>NewImage+2		rts			ENDP*===============================================**						** In:	none					** Out:	none					**===============================================*SetStickImage	PROC		lda	#StickImage		sta	>NewImage		lda	#StickImage>>16		sta	>NewImage+2		rts			ENDP*===============================================**						** In:	none					** Out:	none					**===============================================*SetLockImage	PROC		lda	#LockImage		sta	>NewImage		lda	#LockImage>>16		sta	>NewImage+2		rts			ENDP		*===============================================** MouseKeys:	control mouse from keypad	**						** IN:	a-reg = ADB key code			**						** OUT:	a-reg = ADB key code			**===============================================*MouseKeys	PROC		LONGA	ON		LONGI	ON		IMPORT	MouseVBLTask		IMPORT	GetKeyModBits		IMPORT	KeypadFilter				ldy	ADBVersion; 12/5/90 Mensch; same change as above goes here!; another Don ooops		cpy	#adbVerROM03		; only need MouseKeys for ROM 01		bge	skip		ldy	MouseKeysOn		; is mousekeys active		bne	active			; yes		cmp	#kcPAD_CLEAR		; is it the clear key down?		bne	skip			; no				jsr	GetKeyModBits		and	#kmMask		cmp	#kmShift+kmApple	; are Apple & Shift down?		beq	turnOn			; yes		lda	#kcPAD_CLEAR		; no, so skip		bra	skip;--- turn on mouse keys:turnOn		lda	#1		sta	MouseKeysOn		stz	MKLastTick		stz	MKLastTick+2		stz	MKMultOn		stz	ButtonState		; turn off button		lda	#1		sta	PixelsPerPress		; set default pixel increment		pea	MouseVBLTask>>16		pea	MouseVBLTask		_SetHeartBeat			; install our vbl task		bra	nullactive		cmp	#kcPAD_CLEAR		; is the clear key down?		beq	turnOff			; yes		jsr	KeypadFilter		; handle keypad keys		bra	skip;--- turn off mouse keys:turnOff		pea	MouseVBLTask>>16		pea	MouseVBLTask		_DelHeartBeat			; remove our vbl task		stz	MouseKeysOnnull		lda	#nullKey		; eat the keyskip		rts				ENDP		*===============================================**						** IN:	A = ADB key code			**						** OUT:	A = ADB key code			**						**===============================================*KeypadFilter	PROC		LONGA	ON		LONGI	ON		IMPORT	UpdateMouse		IMPORT	BumpMouse		sta	Temp		tay		and	#kcMask		tax				; x <-- keycode minus key up bit		tya		and	#kcKeyUp		tay				; y = 0 if down key, ­ 0 if up key		cpx	#kcPAD_PERIOD		; is it '.'?		beq	period		bcc	skip		cpx	#kcPAD_9+1		; is it ² 9?		bcs	skip		cpx	#kcPAD_0		; is it ³ 0?		bcs	number		cpx	#kcPAD_MULTIPLY		; is it '*'?		beq	multskip		lda	Temp		brl	exit;--- process keypad '*' key:mult		tya				; was it key down (y=0)?		bne	eatKey			; no		lda	MKMultOn		; is this the second '*'?		bne	multOff			; yes, so reset pixel increment		inc	a		sta	MKMultOn		; just set the flag		bra	eatKeymultOff				stz	MKMultOn		lda	#1		sta	PixelsPerPress		bra	eatKey;--- process keypad button keys (0, 5, '.'):period		tya				; was it key down (y=0)?		bne	eatKey			; no		bra	mbUpzero		tya				; was it key down (y=0)?		bne	eatKey			; no		bra	mbDownbutton		tyx				; was it a key down (y=0)?		bne	mbUp			; nombDown		lda	#mbNewButton0		; set button 0		tsb	ButtonState		bra	sendmbUp				lda	#mbNewButton0		; clear button 0		trb	ButtonStatesend		lda	>EMXPos			; get global mouse position		tax		lda	>EMYPos		tay		lda	#newButton		; button state has changed		jsr	UpdateMouseeatKey		brl	null;--- process keypad keys (1-9):number		lda	MKMultOn		; are we looking for a pixel multiplier?		beq	number2			; no		tya				; is it a key down?		bne	eatKey			; no, so eat key up		txa		cmp	#kcPAD_8		; adjust for non-sequential keycodes		bcc	@sub		dec	a@sub		sec		sbc	#kcPAD_0		; convert to an integer		bne	@set		lda	#10			; 0 maps to 10@set		sta	PixelsPerPress		; our new pixel increment		stz	MKMultOn		bra	nullnumber2				cpx	#kcPAD_0		; is it keypad 0 (lock button)?		beq	zero		cpx	#kcPAD_5		; is it keypad 5 (mouse button)?		beq	button			; yes		stz	MouseDirection		; clear direction bits		tya				; is it a key down?		bne	null			; no, so eat key up		cpx	#kcPAD_4		; keypad 4		bcc	vPlus			; must be 1-3		beq	hMinus				cpx	#kcPAD_6		; keypad 6		beq	hPlusvMinus						; 7, 8, & 9		lda	#mdVMinus		tsb	MouseDirection		cpx	#kcPAD_8		; keypad 8		beq	movement		bcs	hPlushMinus						; 1, 4, & 7		lda	#mdHMinus		tsb	MouseDirection		bra	movement		vPlus						; 1, 2, & 3		lda	#mdVPlus		tsb	MouseDirection		cpx	#kcPAD_2		; keypad 2		bcc	hMinus		beq	movementhPlus						; 3,6, & 9		lda	#mdHPlus		tsb	MouseDirectionmovement		lda	>TickCnt		sta	MKLastTick		; start timing delay		stz	MKDelayPassed		stz	MKAccelPassed		stz	SubPixTotal		stz	SubPixDelta		lda	PixelsPerPress		; pixels count		jsr	BumpMousenull		lda	#nullKeyexit		rts		ENDP*===============================================** 	Update system mouse status		**						** IN:	X = mouse x position (unclamped)	** 	Y = mouse y position (unclamped)	**	A = change flag				**	uses ButtonState			**						** OUT:	none					**						**===============================================*UpdateMouse	PROC		LONGA	ON		LONGI	ON				IMPORT	GetKeyModBits		pha				; put changed flag on stack		jsr	ClampXY			jsr	GetKeyModBits*** added 6-Jun-91 DAL		xba*** end of 6-Jun-91 DAL		pha				; mod keys (bits 0-7)		phx				; clamped x position		phy				; clamped y position		lda	ButtonState		pha				; button status (bits 8-15)		_FakeMouse		lda	ButtonState		; update button state		and	#mbNewButton0		beq	@clr@set		lda	#mbOldButton0				tsb	ButtonState		bra	exit@clr		lda	#mbOldButton0				trb	ButtonStateexit		rts;------------------------------------------------; In:	x, y reg;; Out:	x, y reg;------------------------------------------------ClampXYclamp		set	1			; direct page offsets (local variables)xVal		set	clamp+4yVal		set	xVal+2		phd				; save direct page		phy				; copy x & y to stack frame		phx				lda	ClampAddr+2		; copy clamp addr to stack frame		pha		lda	ClampAddr		pha		tsc				; make a stack frame		tcd				ldx	#0		jsr	ClampIt			; clamp X		ldx	#2		jsr	ClampIt			; clamp Y				pla				; remove clamp addr		pla		plx				; get results		ply		pld				; restore direct page		rts;------------------------------------------------ClampIt				txy		lda	[<clamp],y		; is Val ³ clampLow ?		sec		sbc	<xVal,x		beq	done		bvs	invert1		bmi	checkHighclampLow					; no, so clamp it		lda	[<clamp],y		sta	<xval,x		bra	doneinvert1		bmi	clampLowcheckHigh		iny		iny		iny		iny		lda	[<clamp],y		; is Val ² clampHigh ?		sec		sbc	<xVal,x		beq	done		bvs	invert2		bpl	doneclampHigh					; no, so clamp it		lda	[<clamp],y		sta	<xval,x		bra	doneinvert2		bpl	clampHighdone		rts		ENDP*===============================================**						** IN:	none					**						** OUT:	A has KEYMODREG in low byte		**	X & Y preserved				**===============================================*GetKeyModBits	PROC		LONGA	ON		LONGI	ON		sep	#$20		lda	>KEYMODREG		rep	#$20				and	#$00FF		rts				ENDP*===============================================**						** In:	a-reg has number of pixels to bump	** Out:	none					**===============================================*BumpMouse	PROC		LONGA	ON		LONGI	ON		IMPORT	UpdateMouse				sta	Temp		lda	>EMYPos		tay		lda	>EMXPos		taxvPlus		lda	MouseDirection		and	#mdVPlus		beq	vMinus		tya		clc		adc	Temp		tay				; y :=  y + delta		bra	hplusvMinus		lda	MouseDirection		and	#mdVMinus		beq	hPlus		tya		sec		sbc	Temp		tay				; y :=  y - deltahPlus		lda	MouseDirection		and	#mdHPlus		beq	hMinus		txa		clc		adc	Temp		tax				; x :=  x + delta		bra	movementhMinus		lda	MouseDirection		and	#mdHMinus		beq	movement		txa		sec		sbc	Temp		tax				; x :=  x - deltamovement				lda	#newPosition		jsr	UpdateMousedone		rts		ENDP		*===============================================**						** In:	none					** Out:	none					**===============================================*CheckMouse	PROC		LONGA	ON		LONGI	ON				IMPORT	BumpMouse		lda	MouseDirection		; any movement keys down?		beq	exit			; no;--- check delay-to-start time:		lda	MKDelayPassed		; has the delay period passed?		bne	accelerate		; yes		lda	>TickCnt		; check timer		sec		sbc	MKLastTick		cmp	MKDelayTicks		; has min delay elasped?		bcc	exit			; no, so skip		inc	MKDelayPassed		; yes, so ok to move mouse				lda	>TickCnt		sta	MKLastTick		; start timing acceleration		bra	exit;--- check acceleration time:accelerate		lda	MKAccelPassed		; has the accelaration period passed?		bne	speed			; yes			lda	MKAccelTicks		; is acceleration = 0		beq	passed			; yes		lda	>TickCnt		; check timer		sec		sbc	MKLastTick		cmp	MKAccelTicks		; has acceleration period elasped?		bcs	passed			; yes		lda	>TickCnt		; check timer		and	#$0007			; every 8 ticks increase speed		bne	speed				lda	SubPixDelta		clc		adc	SubPixAccel		cmp	SubPixMax		bcs	passed		sta	SubPixDelta				bcc	speed			; no, so skippassed		inc	MKAccelPassed		; yes, so set max speed				lda	SubPixMax		sta	SubPixDelta;--- check speed (pixels):speed		lda	SubPixTotal		clc		adc	SubPixDelta		sta	SubPixTotal		cmp	#256			; is SubPixTotal ³ 1 pixel		bcc	exit			; no, too small		tax				; save a copy		and	#$00FF		sta	SubPixTotal		; keep remainder		txa		and	#$FF00		xba				; convert to pixelsbump				jsr	BumpMouseexit		rts		ENDP*===============================================** VBL task to monitor MouseKeys mouse movement.	**						** IN:	none					** OUT:	none					**===============================================*MouseVBLTask	PROC		LONGA	OFF		LONGI	OFF				IMPORT	CheckMousetaskTicks	set	1			; 60 ticks = 1 second*-----------------------------------------------TaskHeader		dc.L	0			; task pointerTaskCount	dc.W	taskTicks		; tick count		dc.W	$A55A			; signature*-----------------------------------------------		phk		plb		lda	MouseKeysOn		; is mousekeys active		beq	exit			; no		rep	#$30		LONGA	ON		LONGI	ON				jsr	CheckMouse		sep	#$30		LONGA	OFF		LONGI	OFFexit		lda	#taskTicks		sta	TaskCount		; reset our task counter		rtl				ENDP*=======================================================================** VBL task to monitor KMSTATUS.** The purpose of this task is to fix a bug in the key micro/system.** When the ADB mouse is moved, the ADB glue sets the "mouse register full"* flag (bit 7) of KMSTATUS ($C027).  This normally causes an interrupt,* which when processed, will read MOUSEDATA ($C024) and cause the "mouse* register full" flag to be reset (cleared).** When mouse interrupts are disabled (bit 6 of KMSTATUS clear) the* "mouse register full" flag is ignored, MOUSEDATA in never read, and* therefore the "mouse register full" flag remains on.  The ADB micro won't* update KMSTATUS unless the old status changes, so when bit 7 is set, SRQ* interrupts can't happen (until someone reads MOUSEDATA).** Since our ADB completion routine depends on SRQ interrupts, the system* will "hang" if the mouse is moved while mouse interrupts are disabled.* This task will read MOUSEDATA if the mouse register is full but mouse* interrupts are disabled to prevent the system from "hanging".*=======================================================================*KMSTATUSTask	PROC		LONGA	OFF		LONGI	OFFtaskTicks	set	30			; 30 ticks = about 1/2 second*-----------------------------------------------TaskHeader		dc.L	0			; task pointerTaskCount	dc.W	taskTicks		; tick count		dc.W	$A55A			; signature*-----------------------------------------------		sta	>$FFDBAB		; debug trigger		lda	>KMSTATUS		; test if mouse data available		bpl	exit			; no, so skip				and	#$7F			; is mouse interrupt enabled (bit 6)?		cmp	#$40		bcs	exit			; yes, so skip; read 	MOUSEDATA to reset KMSTATUS:			ror	a			; set 'c'=0, if data ok bit1=0		ror	a			; i.e. data not contaminated		lda	>MOUSEDATA		; read in mouse data register		tax		bcs	exit			; c=1 if data is contaminated		lda	>KMSTATUS		; verify Y hardware has X data ready		and	#$02			; bit1=1, Y pos data available		beq	exit		lda	>MOUSEDATA		; read in Y position data		tayexit		lda	#taskTicks		sta	>TaskCount		; reset our task counter		rtl				ENDP*-----------------------------------------------		END		