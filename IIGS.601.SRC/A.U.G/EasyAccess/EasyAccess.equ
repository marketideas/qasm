cStickyBits	equ	$11mcStickyKeysOn	equ	%00010000		; microStatus bitsmcMouseKeysOn	equ	%00001000mcLockedApple	equ	%10000000		; sticky bitsmcLockedOption	equ	%01000000mcLockedControl	equ	%00100000mcLockedShift	equ	%00010000mcStuckApple	equ	%00001000mcStuckOption	equ	%00000100mcStuckControl	equ	%00000010mcStuckShift	equ	%00000001mcStuckMask	equ	%00001111mcLockMask	equ	%11110000;--- MouseKeys constants:	mbNewButton0	equ	$8000mbOldButton0	equ	$4000mbNewButton1	equ	$1000mbOldButton1	equ	$0100newButton	equ	%00000100		newPosition	equ	%00000010		mdVPlus		equ	%000000001		; used by MouseDirectionmdVMinus	equ	%000000010mdHPlus		equ	%000000100mdHMinus	equ	%000001000;--- BRAM parameter offsets:bpMKeysDelay	equ	$55bpMKeysAccel	equ	$56bpMKeysSpeed	equ	$57;--- toolbox routine numbers:EMStatus	equ	$0606GetNextEvent	equ	$0A06DrawMenuBar	equ	$2A0FmouseClamps	equ	$000C			; GetAddr Param Ref No -  Point		RECORD	0			; QuickDrawII point record;-----------------------------------------------v		ds.W	1h		ds.W	1 ;-----------------------------------------------		ENDR BRAMSetupVec	equ	$25			; for patching $E10094 vector