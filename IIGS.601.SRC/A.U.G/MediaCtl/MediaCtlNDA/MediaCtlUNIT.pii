unit MCUnit;{$LongGlobals+}INTERFACEUSES	QDIntf,ConsoleIO,GSIntf,FontMgr,MiscTools;CONST	mcInChapters	=1;	mcInFrames	=2;	mcInTimes	=3;	mcCEject	=2;	mcCVideoOn	=3;	mcCVideoOff	=4;	mcFTypes	=0;	mcFStep		=1;	mcFRecord	=2;	mcFVideo	=3;	mcFEject	=4;	mcFLock		=5;	mcFVDisplay	=6;	mcFVolume	=9;	AudioOff	=0;	AudioLeft	=8;	AudioRight	=1;	AudioStereo	=9;		DAWTop		=0;	DAWLeft		=0;	DAWBottom 	=160;	DAWRight	=238;	RBRow0		=12;	RBRow1		=24;	RBCol1		=10;	RBCol2		=50;	RBCol3		=90;	RBCol4		=130;		Row1		=142;	Row2		=116;	Row3		=90;	Row4		=59;	Row5		=35;	Row6		=11;	Row7		=20;	Row8		=4;	Row9		=12;		Cdisp		=50;	Column1		=5;	Column2		=51;	Column3		=97;	Column4		=143;	Column5		=189;	ColumnZ		=181;	ColumnX		=49;	ColumnXX	=8;	ColumnXXX	=86;	ColumnY0	=13;	ColumnY1	=35;	ButtonW01	=20;	ButtonWidth	=44;	RowHeigth	=15;	NoLButtons	=17;	NoM2BStart	=18;	NoM2BEnd	=20;	NoM3BStart	=21;	NoM3BEnd	=24;	NoButtons	=NoM3BEnd;	RadioCS		=25;	RadioCE		=32;	LineEditCS	=33;	LineEditCE	=34;	ScrollCS	=35;	ScrollCE	=36;	NoControls	=ScrollCE;	BetweenDelay	=2;	wInControl	=$21;TYPEMyIcon=	RECORD		iconType:	Integer;		iconSize:	Integer;		iconHeight:	Integer;		iconWidth:	Integer;		Image:		Packed Array[1..35] of Byte;		Mask:		Packed Array[1..35] of Byte;	end;	MyIconCtrl=	RECORD		pcount:		integer;		UserAsgID:	longint;		LERectTop:	integer;		LERectLeft:	integer;		LERectBot:	integer;		LERectRight:	integer;		ProcRef:	longint;		Flag:		integer;		MoreFlags:	integer;		refcon:		longint;		iconref:	ptr;		titleref:	ptr;		colorref:	ptr;	end;	AlertTemplate=	RECORD		atBoundsRect:	rect;		atAlertID:	Integer;		atStage12:	Integer;		atStage34:	Integer;		atItem1:	ptr;		atItem2:	ptr;		atItem3:	ptr;		atItem4:	ptr;		atItem5:	ptr;		end;ItemTemplate=	RECORD		itemID:		integer;		itemRect:	Rect;		itemType:	integer;		itemDescr:	Ptr;		itemValue:	Integer;		itemFlag:	Integer;		itemColor:	Ptr;		end;MyLEControl=	RECORD		pcount:		integer;		UserAsgID:	longint;		LERectTop:	integer;		LERectLeft:	integer;		LERectBot:	integer;		LERectRight:	integer;		ProcRef:	longint;		Flag:		integer;		MoreFlags:	integer;		refcon:		longint;		maxsize:	integer;		defaultref:	ptr;		colortbl:	ptr;	end;	ExtTaskRec=	RECORD		wmWhat:		integer;		wmMessage:	longint;		wmWhen:		longint;		wmWhere:	point;		wmModifiers:	integer;		wmTaskData:	longint;		wmTaskMask:	longint;		wmLaskClick:	longint;		wmClickCount:	integer;		wmTaskData2:	longint;		wmTaskData3:	longint;		wmTaskData4:	longint;		wmLastClickPt:	point;	end;VAR	NDAMode:	integer;	NDAModeFlag:	boolean;	myWindOpen:  boolean;	myWind:	     NewWindowParamBlk;	myWindPtr:   WindowPtr;	RectPtrX:	rect;	Chandle:	array[0..NoControls] of Controlhandle;	CActive:	array[0..NoControls] of boolean;	RunLoaded:	integer;	KeepTools:	boolean;	MyToolsActive:	boolean;	IloadedMCT:	boolean;	IStartedMCT:	boolean;	ILoadedFonts:	boolean;	IStartedFonts:	boolean;	IloadedQDAux:	boolean;	IStartedQDAux:	boolean;	HaveLoadErrors:	boolean;	MyLoadErrMC:	integer;	MyLoadErrFM:	integer;	MyID:		integer;	ToolZP2:	handle;	CurrentRadio:	integer;	McChannel:	integer;	MyLong:		longint;	MyWord:		integer;	MyBool:		boolean;	MyString:	str255;	XMyString:	str255;	MyOldString1:	str255;	MyOldChapter:	longint;	I:		integer;	J:		integer;	WantDisplay:	array [1..8] of integer;	RadioCtrlColor:	ControlColorTbl;	ButtonCtrlColor: ControlColorTbl;	BtnCtrlColor:	ControlColorTbl;	ScrollColor:	ControlColorTbl;	IBtnCtrlColor:	ControlColorTbl;	myOldLong:	longint;	myrect:		rect;	DisplayTog:	array [1..8] of integer;	XXLong:		longint;	VideoTog:	integer;	JustOpened:	boolean;	AreActive:	boolean;	ActiveCtr:	integer;	MyToolError:	integer;	MyLETemple:	MyLEControl;	MyIconTemp:	MyIconCtrl;	MyIconTemp2:	MyIconCtrl;	IconL:		MyIcon;	IconR:		MyIcon;	MyLEDefault:	str255;	MyExtTaskRec:	ExtTaskRec;	MyInPoint:	array [1..8] of longint;	MyOutPoint:	array [1..8] of longint;	AudioS:		array [1..8] of integer;	CurrSpeed:	array [1..8] of integer;	MyNameStr:	str255;	CurVol:		integer;	TheAErrNum:	integer;	ourAlert:	AlertTemplate;	itemClicked:	integer;	WantCancel:	boolean;	IconDraw:	boolean;	ForceDsply:	boolean;	V320Mode:	boolean;Procedure Abort; inline $00;Procedure Abort1; inline $01;Procedure Abort2; inline $02;procedure MyInt2Hex(wordval:integer;strPtr:Ptr;length:Integer); Tool 11,34;	function MyTaskMstrDA(EventMask:integer;ExtTaskPtr:ptr):integer; Tool 14,95;function MyNewCtrl2(Owner:WindowPtr;RefDesc:integer;Ref:Ptr):Controlhandle;Tool 16,49;	procedure MakeCtrls;forward;procedure DoAbout;forward;procedure DrawTime;forward;procedure MyDrawChar(xx:integer);Tool 4,164;procedure MCStartup(UserID:integer);Tool 38,2;procedure MCShutdown;Tool 38,3;function MCStatus:boolean;Tool 38,6;procedure MCGetErrorMsg(TheError:integer;TheString:ptr); Tool 38,9;function MCCvtTime2Bin(TimeVal:longint):longint; Tool 38,12;function MCCvtBin2Time(BinVal:Longint):longint; Tool 38,13;procedure MCGetName(McChann:integer;FeatStrPtr:ptr); Tool 38,45;function MCGetFeatures(McChann,McSel:integer):Longint; Tool 38,22;procedure MCPlay(McChann:integer);Tool 38,23;procedure McPause(McChann:integer);Tool 38,24;procedure McSendRawData(McChann:integer;TheData:string); Tool 38,25;function McGetStatus(McChann,McSel:integer):integer; Tool 38,26;procedure McControl(McChann,McCtlCommand:integer); Tool 38,27;procedure McScan(McChann,McScanDir:integer); Tool 38,28;procedure McSpeed(McChann,McSpeedVal:integer); Tool 38,30;procedure MCStopAt(Channel,UnitType:integer;StopAt:longint); Tool 38,31;procedure McJogN(McChann,MCUnitType:integer;N:longint;mcRepeat:integer); Tool 38,32;procedure MCSearchTo(Channel,UnitType:integer;SearchLoc:LongInt); Tool 38,33;procedure MCSearchWait(Channel:integer); Tool 38,35;function McReadPos(McChann,MCUnitType:integer):longint; Tool 38,36;procedure McSetAudio(McChann,McAudioVal:integer); Tool 38,37;procedure McRecord(Chann:integer); Tool 38,42;procedure McStop(Chann:integer); Tool 38,43;procedure McSetVolume(Chann,leftvol,rightvol:integer); Tool 38,46;procedure XInstallFont(ID:LongInt;SW:integer); Tool 27,14;procedure NewNDAMode(OldMode:integer);forward;procedure DrawInName;	forward;procedure DrawInDMode;	forward;procedure CloadTools;	forward;procedure CUnloadTools;	forward;function AddColons(TString:string;MCUnitType:integer):string; forward;function ValidPoint(TString:string):boolean; forward;function StripColons(TString:string):string; forward;procedure SetHilites; forward;procedure DoDisplayTog; forward;procedure SwitchChann(i:integer); forward;procedure MyPutLEText(Point:longint;HdlIndex:integer); forward;procedure SetCtlMoreFlags(F:integer;H:Controlhandle); Tool 16,47;function GetCtlMoreFlags(H:Controlhandle):integer; Tool 16,46;IMPLEMENTATIONprocedure NewNDAMode(OldMode:integer);var	III:	integer;begin{First erase old modes controls}Case OldMode of	1:begin {case first (default startup)}		for III:=RadioCS to RadioCE do begin			EraseControl(Chandle[III]);		end;{of for III}		NDAMode:=2;	end;{of 1:}	2:begin		for III:=NoM2BStart to NoM2BEnd do begin			EraseControl(Chandle[III]);		end;{of for III}		for III:=LineEditCS to LineEditCE do begin			EraseControl(Chandle[III]);		end; {of for III}		LEDeactivate(Pointer(GetCtlTitle(chandle[LineEditCS])));		SetCtlMoreFlags(bitand($7fff,GetCtlMoreFlags(chandle[LineEditCS])),chandle[LineEditCS]);		LEDeactivate(Pointer(GetCtlTitle(chandle[LineEditCS+1])));		SetCtlMoreFlags(bitand($7fff,GetCtlMoreFlags(chandle[LineEditCS+1])),chandle[LineEditCS+1]);		NDAMode:=3;	end;{of 2}	3:begin		for III:=NoM3BStart to NoM3BEnd do begin			EraseControl(Chandle[III]);		end;{of for III}		NDAMode:=4;	end;{of case 3}		4:begin {Volume mode}		EraseControl(Chandle[ScrollCS]);		EraseControl(Chandle[ScrollCE]);		NDAMode:=1;	end;{of case 4}end;{of case NDAmode}end;{of NewNDAMode}procedure DrawTime;var   	III: 		integer;	LeftVol:	integer;	RightVol:	integer;begin{paint window black}if NDAModeFlag then begin	with myrect do begin		top:= 0; left:=0; bottom:=37; right:=DAWRight-69;		end;end else begin	with myrect do begin		top:= 0; left:=0; bottom:=DAWBottom; right:=DAWRight;		end;	end;{of else}	setdithcolor(00);	paintrect(myrect);{Now do outline window with white}	setdithcolor(15);	with myrect do begin		top:= 0; left:=1; bottom:=DAWBottom-1; right:=DAWRight-1;		end;	framerect(myrect);	with myrect do begin		top:= 0; left:=2; bottom:=DAWBottom-1; right:=DAWRight-2;		end;	framerect(myrect);	setTextMode($0004);	setforecolor($000f);	moveto(DAWRight-12,10);	DrawChar(chr(17)); {apple character}	moveto(ColumnZ+6,Row6-1);	drawstring('MORE');		moveto(DAWLeft+2,Row3-14);	line(DAWRight-4,0);{Now frame around radio buttons}	with myrect do begin		top:= 0; left:=2; bottom:=Row3-13; right:=rbcol4+40;;		end;	framerect(myrect);	with myrect do begin		top:= 0; left:=2; bottom:=Row3-13; right:=rbcol4+41;;		end;	framerect(myrect);	{do display window}	with myrect do begin		top:= rbRow1+13; left:=12; bottom:=Row3-18; right:=rbcol4+30;;		end;	frameRrect(myrect,30,15);		moveto(ColumnZ-5,Row4-1);	drawstring('DISPLAY');	moveto(ColumnZ+3,Row5-1);	drawstring('VIDEO');	DrawInName;	DrawInDMode;	MyOldString1:='XXXXXXXXXX';	ForceDsply:=true;Case NDAMode of1:begin	moveto(RBCol1,RBRow0-2);	drawstring('CHANNEL');	if NDAModeFlag then begin		for III:=RadioCS to RadioCE do begin			ShowControl(Chandle[III]);		end;{of for III}	end else begin		for III:=RadioCS to RadioCE do begin			DrawOneCtl(Chandle[III]);		end;{of for III}		end;{of else}end;{of NDAmode=1}2:begin	MyString:=LongIntToString(MyInPoint[MCChannel]);	MyString:=AddColons(MyString,displaytog[McChannel]);	LESetText(Pointer(@MyString[1]),Ord(MyString[0]),Pointer(GetCtlTitle(chandle[LineEditCS])));	MyString:=LongIntToString(MyOutPoint[MCChannel]);	MyString:=AddColons(MyString,displaytog[McChannel]);	LESetText(Pointer(@MyString[1]),Ord(MyString[0]),Pointer(GetCtlTitle(chandle[LineEditCS+1])));	if NDAModeFlag then begin		for III:=LineEditCS to LineEditCE do begin			ShowControl(Chandle[III]);		end;{of for III}		for III:=NoM2BStart to NoM2BEnd do begin			ShowControl(Chandle[III]);		end;{of for III}	end else begin		for III:=LineEditCS to LineEditCE do begin			DrawOneCtl(Chandle[III]);		end;{of for III}		for III:=NoM2BStart to NoM2BEnd do begin			DrawOneCtl(Chandle[III]);		end;{of for III}		end;{of else}end;{of NDAMode=2}3: begin	moveto(ColumnY1+27,Row8+10);	drawstring('Access Lock');	moveto(ColumnY1+27,Row7+10);	drawstring('Video Display');		if NDAModeFlag then begin		for III:=NoM3BStart to NoM3BEnd do begin			ShowControl(Chandle[III]);		end;{of for III}	end else begin		for III:=NoM3BStart to NoM3BEnd do begin			DrawOneCtl(Chandle[III]);		end;{of for III}		end;{of else}end;{of NDAMode=3}4:begin {volume mode}	moveto(RBCol1,RBRow0-2);	drawstring('VOLUME');	moveto(145,20);	drawstring('L');	moveto(145,32);	drawstring('R');	LeftVol:=MCGetStatus(McChannel,6);	RightVol:=MCGetStatus(McChannel,7);	for III:=1 to 8 do begin		RightVol:=BitSR(RightVol);		LeftVol:=BitSR(LeftVol);		end; {of for II}	if CActive[ScrollCS] then SetCtlValue(LeftVol,Chandle[ScrollCS])		else SetCtlValue(0,CHandle[ScrollCS]);	if CActive[ScrollCE] then SetCtlValue(RightVol,Chandle[ScrollCE])		else SetCtlValue(0,CHandle[ScrollCE]);			if NDAModeFlag then begin		ShowControl(Chandle[ScrollCS]);		ShowControl(Chandle[ScrollCE]);		end else begin			DrawOneCtl(Chandle[ScrollCS]);			DrawOneCtl(Chandle[ScrollCE]);		end;{of else}end;{of NDAMode=4}end;{of case NDAmode}{Do lower part}if NDAModeFlag=false then begin	moveto(Column1+9,Row3-1);	drawstring('REC.');	moveto(Column2+3,Row3-1);	drawstring('EJECT');	moveto(Column3+6,Row3-1);	drawstring('STOP');	moveto(Column5-24,Row3-1);	drawstring('AUDIO');	moveto(Column1+2,Row2-1);	drawstring('SPEED');	moveto(Column2+6,Row2-1);	drawstring('STEP');	moveto(Column3+6,Row2-1);	drawstring('PLAY');	moveto(Column4+6,Row2-1);	drawstring('STEP');	moveto(Column5+2,Row2-1);	drawstring('SPEED');	moveto(Column1+1,Row1-1);	drawstring('TRACK');	moveto(Column2+6,Row1-1);	drawstring('SCAN');	moveto(Column3+3,Row1-1);	drawstring('PAUSE');	moveto(Column4+6,Row1-1);	drawstring('SCAN');	moveto(Column5+1,Row1-1);	drawstring('TRACK');	SetHilites;end;{of NDAModeFlag}		setforecolor($0000);	setTextMode($0000);end; { of DrawTime }procedure MakeCtrls;var 	ll:	integer;	kk:	ptr;	MyLong:	longint;begin{Do Buttons}ButtonCtrlColor.SimpOutline:=$00f0;ButtonCtrlColor.SimpNorBack:=$0000;ButtonCtrlColor.SimpSelBack:=$00f0;ButtonCtrlColor.SimpNorText:=$000f;ButtonCtrlColor.SimpSelText:=$00f0;BtnCtrlColor.SimpOutline:=$00f0;BtnCtrlColor.SimpNorBack:=$0000;BtnCtrlColor.SimpSelBack:=$00f0;BtnCtrlColor.SimpNorText:=$000f;BtnCtrlColor.SimpSelText:=$00f0;IBtnCtrlColor.SimpOutline:=$00f0;IBtnCtrlColor.SimpNorBack:=$0000;IBtnCtrlColor.SimpSelBack:=$00ff;IBtnCtrlColor.SimpNorText:=$000f;IBtnCtrlColor.SimpSelText:=$00f0;kk:=Pointer($00000000); {Button type control}SetRect(RectPtrX,Column1,Row1,Column1+ButtonWidth,Row1+RowHeigth);Chandle[0]:=NewControl(myWindPtr,RectPtrX,'|<<',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column2,Row1,Column2+ButtonWidth,Row1+RowHeigth);Chandle[1]:=NewControl(myWindPtr,RectPtrX,'<<',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column3,Row1,Column3+ButtonWidth,Row1+RowHeigth);Chandle[2]:=NewControl(myWindPtr,RectPtrX,'||',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column4,Row1,Column4+ButtonWidth,Row1+RowHeigth);Chandle[3]:=NewControl(myWindPtr,RectPtrX,'>>',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column5,Row1,Column5+ButtonWidth,Row1+RowHeigth);Chandle[4]:=NewControl(myWindPtr,RectPtrX,'>>|',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column1,Row2,Column1+ButtonWidth,Row2+RowHeigth);Chandle[5]:=NewControl(myWindPtr,RectPtrX,'<n||',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column2,Row2,Column2+ButtonWidth,Row2+RowHeigth);Chandle[6]:=NewControl(myWindPtr,RectPtrX,'<||',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column3,Row2,Column3+ButtonWidth,Row2+RowHeigth);Chandle[7]:=NewControl(myWindPtr,RectPtrX,'>',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column4,Row2,Column4+ButtonWidth,Row2+RowHeigth);Chandle[8]:=NewControl(myWindPtr,RectPtrX,'||>',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column5,Row2,Column5+ButtonWidth,Row2+RowHeigth);Chandle[9]:=NewControl(myWindPtr,RectPtrX,'||n>',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column1,Row3,Column1+ButtonWidth,Row3+RowHeigth);Chandle[10]:=NewControl(myWindPtr,RectPtrX,'×',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column2,Row3,Column2+ButtonWidth,Row3+RowHeigth);Chandle[11]:=NewControl(myWindPtr,RectPtrX,'Æ',2,0,0,100,kk,ll,@BtnCtrlColor);SetRect(RectPtrX,Column3,Row3,Column3+ButtonWidth,Row3+RowHeigth);Chandle[12]:=NewControl(myWindPtr,RectPtrX,'[]',2,0,0,100,kk,ll,@BtnCtrlColor);{ICON Buttons}IconL.IconType:=0;IconL.IconSize:=35;IconL.IconHeight:=7;IconL.IconWidth:=10;StuffHex(@IconL.Image[1],'0F000F0000');StuffHex(@IconL.Image[6],'f00f0ff000');StuffHex(@IconL.Image[11],'f0f00ffff0');StuffHex(@IconL.Image[16],'f0f00ffff0');StuffHex(@IconL.Image[21],'f0f00ffff0');StuffHex(@IconL.Image[26],'f00f0ff000');StuffHex(@IconL.Image[31],'0f000f0000');StuffHex(@IconL.Mask[1],'ffffffffff');StuffHex(@IconL.Mask[6],'ffffffffff');StuffHex(@IconL.Mask[11],'ffffffffff');StuffHex(@IconL.Mask[16],'ffffffffff');StuffHex(@IconL.Mask[21],'ffffffffff');StuffHex(@IconL.Mask[26],'ffffffffff');StuffHex(@IconL.Mask[31],'ffffffffff');MyIconTemp.pcount:=9;MyIconTemp.UserAsgID:=260;MyIconTemp.LERectTop:=Row3-2;MyIconTemp.LERectBot:=Row3+RowHeigth+2;V320Mode:=(BitAnd(GetMasterSCB,$0080)=0);{0=320}if V320Mode then MyIconTemp.LERectLeft:=Column4-3 else MyIconTemp.LERectLeft:=Column4-4;if V320Mode then MyIconTemp.LERectRight:=Column4+ButtonWidth+3 else MyIconTemp.LERectRight:=Column4+ButtonWidth+4;MyIconTemp.ProcRef:=$07ff0001;MyIconTemp.Flag:=$0002;MyIconTemp.MoreFlags:=$1000;MyIconTemp.refcon:=0;MyIconTemp.IconRef:=pointer(@IconL);MyIconTemp.TitleRef:=nil;MyIconTemp.ColorRef:=pointer(@IBtnCtrlColor);Chandle[13]:=MyNewCtrl2(myWindPtr,0,@MyIconTemp);MyIconTemp2:=MyIconTemp;IconR.IconType:=0;IconR.IconSize:=35;IconR.IconHeight:=7;IconR.IconWidth:=10;StuffHex(@IconR.Image[1],'000f000f00');StuffHex(@IconR.Image[6],'00ff0f00f0');StuffHex(@IconR.Image[11],'ffff00f0f0');StuffHex(@IconR.Image[16],'ffff00f0f0');StuffHex(@IconR.Image[21],'ffff00f0f0');StuffHex(@IconR.Image[26],'00ff0f00f0');StuffHex(@IconR.Image[31],'000f000f00');StuffHex(@IconR.Mask[1],'ffffffffff');StuffHex(@IconR.Mask[6],'ffffffffff');StuffHex(@IconR.Mask[11],'ffffffffff');StuffHex(@IconR.Mask[16],'ffffffffff');StuffHex(@IconR.Mask[21],'ffffffffff');StuffHex(@IconR.Mask[26],'ffffffffff');StuffHex(@IconR.Mask[31],'ffffffffff');MyIconTemp2.UserAsgID:=261;MyIconTemp2.IconRef:=pointer(@IconR);if V320Mode then MyIconTemp2.LERectLeft:=Column5-3 else MyIconTemp2.LERectLeft:=Column5-4;if V320Mode then MyIconTemp2.LERectRight:=Column5+ButtonWidth+3 else MyIconTemp2.LERectRight:=Column5+ButtonWidth+4;Chandle[14]:=MyNewCtrl2(myWindPtr,0,@MyIconTemp2);{Column buttons}SetRect(RectPtrX,ColumnZ,Row4+1,ColumnZ+ButtonWidth,Row4+RowHeigth-3);Chandle[15]:=NewControl(myWindPtr,RectPtrX,'#',0,0,0,100,kk,ll,@ButtonCtrlColor);SetRect(RectPtrX,ColumnZ,Row5+1,ColumnZ+ButtonWidth,Row5+RowHeigth-3);Chandle[16]:=NewControl(myWindPtr,RectPtrX,'V',0,0,0,100,kk,ll,@ButtonCtrlColor);SetRect(RectPtrX,ColumnZ,Row6+1,ColumnZ+ButtonWidth,Row6+RowHeigth-3);Chandle[17]:=NewControl(myWindPtr,RectPtrX,'...',0,0,0,100,kk,ll,@ButtonCtrlColor);{Mode buttons2}SetRect(RectPtrX,ColumnX,Row8+1,ColumnX+ButtonWidth-10,Row8+RowHeigth-3);Chandle[18]:=NewControl(myWindPtr,RectPtrX,'IN',$0082,0,0,100,kk,ll,@ButtonCtrlColor);SetRect(RectPtrX,ColumnX,Row7+1,ColumnX+ButtonWidth-10,Row7+RowHeigth-3);Chandle[19]:=NewControl(myWindPtr,RectPtrX,'OUT',$0082,0,0,100,kk,ll,@ButtonCtrlColor);SetRect(RectPtrX,ColumnXX,Row8+1,ColumnXX+ButtonWidth-7,Row7+RowHeigth-3);Chandle[20]:=NewControl(myWindPtr,RectPtrX,'Run',$0080,0,0,100,kk,ll,@ButtonCtrlColor);{Mode buttons3}SetRect(RectPtrX,ColumnY0,Row8+1,ColumnY0+ButtonW01,Row8+RowHeigth-3);Chandle[21]:=NewControl(myWindPtr,RectPtrX,'-',$0082,0,0,100,kk,ll,@ButtonCtrlColor);SetRect(RectPtrX,ColumnY1,Row8+1,ColumnY1+ButtonW01,Row8+RowHeigth-3);Chandle[22]:=NewControl(myWindPtr,RectPtrX,'+',$0082,0,0,100,kk,ll,@ButtonCtrlColor);SetRect(RectPtrX,ColumnY0,Row7+1,ColumnY0+ButtonW01,Row7+RowHeigth-3);Chandle[23]:=NewControl(myWindPtr,RectPtrX,'-',$0082,0,0,100,kk,ll,@ButtonCtrlColor);SetRect(RectPtrX,ColumnY1,Row7+1,ColumnY1+ButtonW01,Row7+RowHeigth-3);Chandle[24]:=NewControl(myWindPtr,RectPtrX,'+',$0082,0,0,100,kk,ll,@ButtonCtrlColor);{Radio Buttons}RadioCtrlColor.RadioResv:=0;RadioCtrlColor.RadioNorColor:=$000f;RadioCtrlColor.RadioSelColor:=$000f;RadioCtrlColor.RadioTitleColor:=$000f;kk:=Pointer($04000000); {Button type control}SetRect(RectPtrX,RBCol1,RBRow0,0,0);CHandle[RadioCS]:=NewControl(myWindPtr,RectPtrX,'1',1,1,0,0,kk,ll,@RadioCtrlColor);SetRect(RectPtrX,RBCol2,RBRow0,0,0);CHandle[RadioCS+1]:=NewControl(myWindPtr,RectPtrX,'2',1,0,0,0,kk,ll,@RadioCtrlColor);SetRect(RectPtrX,RBCol3,RBRow0,0,0);CHandle[RadioCS+2]:=NewControl(myWindPtr,RectPtrX,'3',1,0,0,0,kk,ll,@RadioCtrlColor);SetRect(RectPtrX,RBCol4,RBRow0,0,0);CHandle[RadioCS+3]:=NewControl(myWindPtr,RectPtrX,'4',1,0,0,0,kk,ll,@RadioCtrlColor);SetRect(RectPtrX,RBCol1,RBRow1,0,0);CHandle[RadioCS+4]:=NewControl(myWindPtr,RectPtrX,'5',1,0,0,0,kk,ll,@RadioCtrlColor);SetRect(RectPtrX,RBCol2,RBRow1,0,0);CHandle[RadioCS+5]:=NewControl(myWindPtr,RectPtrX,'6',1,0,0,0,kk,ll,@RadioCtrlColor);SetRect(RectPtrX,RBCol3,RBRow1,0,0);CHandle[RadioCS+6]:=NewControl(myWindPtr,RectPtrX,'7',1,0,0,0,kk,ll,@RadioCtrlColor);SetRect(RectPtrX,RBCol4,RBRow1,0,0);CHandle[RadioCS+7]:=NewControl(myWindPtr,RectPtrX,'8',1,0,0,0,kk,ll,@RadioCtrlColor);MyLEDefault:='0';MyLeTemple.pcount:=8;MyLeTemple.UserAsgID:=256;MyLeTemple.LERectTop:=4;MyLeTemple.LERectLeft:=ColumnXXX;MyLeTemple.LERectBot:=17;MyLeTemple.LERectRight:=ColumnXXX+80;MyLeTemple.ProcRef:=$83000000;MyLeTemple.Flag:=$0080;MyLeTemple.MoreFlags:=$7000;MyLeTemple.refcon:=0;MyLeTemple.maxsize:=10;MyLeTemple.defaultref:=pointer(@myLEDefault);chandle[LineEditCS]:=MyNewCtrl2(myWindPtr,0,@MyLETemple);MyLeTemple.UserAsgID:=257;MyLeTemple.LERectTop:=20;MyLeTemple.LERectBot:=33;chandle[LineEditCS+1]:=MyNewCtrl2(myWindPtr,0,@MyLETemple);{Scroll bar Control}With ScrollColor do begin	ScrollOutLine:=$00f0;	ArrowNorColor:=$000F;	ArrowSelcolor:=$00F0;	ArrowBackColor:=$0000;	ThumbNorColor:=$0000;	ScrollResv:=$0000;	PageRgnColor:=$01f0;	InactiveColor:=$0000;	end;MyLeTemple.pcount:=10;MyLeTemple.UserAsgID:=258;MyLeTemple.LERectTop:=11;MyLeTemple.LERectLeft:=10;MyLeTemple.LERectBot:=22;MyLeTemple.LERectRight:=ColumnXXX+50;MyLeTemple.ProcRef:=$86000000;MyLeTemple.Flag:=$009c;MyLeTemple.MoreFlags:=$1000;MyLeTemple.refcon:=0;MyLeTemple.maxsize:=256;MyLeTemple.defaultref:=Pointer($00ff0019);MyLeTemple.colortbl:=@ScrollColor;chandle[ScrollCS]:=MyNewCtrl2(myWindPtr,0,@MyLETemple);MyLeTemple.UserAsgID:=259;MyLeTemple.LERectTop:=23;MyLeTemple.LERectLeft:=10;MyLeTemple.LERectBot:=34;MyLeTemple.LERectRight:=ColumnXXX+50;chandle[ScrollCE]:=MyNewCtrl2(myWindPtr,0,@MyLETemple);end;{of MakeCtrls}procedure myTextItem(theDialog:ptr; theItem: integer);begin   SetForeColor(0);   SetBackColor(15);   MoveTo(10,14);  DrawString('Media Controller          v1.1');   MoveTo(10,16);  LineTo(225,16);   MoveTo(10,26);  DrawString('Programmed by Dan Hitchens');     MoveTo(10,37);  DrawString('Tested by Margarita, Anil, Jan');   MoveTo(10,39);  LineTo(225,39);      MoveTo(10,50);  DrawString('Copyright 1989-1992');   MoveTo(10,60);  DrawString('Apple Computer, Inc.');   MoveTo(10,62);  LineTo(225,62);   MoveTo(10,73);  DrawString('Copyright (c) 1987');   MoveTo(10,83);  DrawString('TML Systems, Inc.');   MoveTo(10,93);  DrawString('Certain portions of');   MoveTo(10,103); DrawString('this software are');   MoveTo(10,113); DrawString('copyrighted by');   MoveTo(10,123); DrawString('TML Systems, Inc.');   MoveTo(10,133); DrawString('All Rights Reserved.');end;procedure DoAbout;var	aboutDlog: DialogPtr;	r:	   Rect;	r2:    Rect;	itemHit:   Integer;begin   if BitAnd(GetMasterSCB,$0080)=$0080 then   SetRect(r,180,30,420,170) else SetRect(r,40,30,280,170);{   r2:=r; removed 22-Jan-92 DAL }   aboutDlog :=	NewModalDialog(r,true,0);   SetPort(aboutDlog);   SetRect(r,175,120,0,0);   NewDItem(aboutDlog,1,r,10,@'OK',0,0,nil);   SetRect(r2,0,0,1000,1000); { added 22-Jan-92 DAL }   NewDItem(aboutDlog,2,r2,$8014{userItem},@myTextItem,0,0,nil);   itemHit := ModalDialog(nil);   CloseDialog(aboutDlog);end; { of DoAbout }procedure DrawInName;var III: integer;begin	MCGetName(McChannel,@MyNameStr);	if ToolErrorNum=0 then begin		For III:=1 to 50 do begin			if MynameStr[III+10]=chr(32) then leave;			MyNameStr[III+2]:=MyNameStr[III+10];			end;		MyNameStr[0]:=chr(III+1);		end else begin			MyNameStr:='#-No Connection!';			if ToolErrorNum=$260B then MyNameStr:='#-Invalid Port!';			end;{of if else}	MyNameStr[1]:=chr(McChannel+48);{put in channel no.}	MyNameStr[2]:=chr(45);{put in -}	moveto(Column1+20,Row3-43);	drawstring(MyNameStr);end;{of DrawInName}procedure DrawInDMode;var MyDrect: rect;begin;	case displaytog[McChannel] of		McInFrames:MyNameStr:='F';		McInTimes:MyNameStr:='T';		end;{of case}	setdithcolor(0);	SetRect(myDrect,Column4,Row3-33,Column4+10,Row3-23);	paintrect(myDrect);	moveto(Column4,Row3-23);	drawstring(MyNameStr);end;{of DrawInDMode}procedure CLoadTools; var 	statustool:boolean; 	IStatusTool:integer;beginMyToolsActive:=true;HaveLoadErrors:=false;MyLoadErrMC:=0;MyLoadErrFM:=0;if IloadedMCT=false then begin	StatusTool:=MCStatus;	if ISToolError then begin		loadonetool(38,0);		if IsToolError then begin			HaveLoadErrors:=true;			MyLoadErrMC:=ToolErrorNum;			end else ILoadedMCT:=true;		end;{of toolerrornum<>0}	end;{of IloadedMCT=false}	if IStartedMCT=false then begin	if ((IloadedMCT=true) or (MyLoadErrMC=0)) then begin		StatusTool:=MCStatus;		if IsToolError=false then begin			if StatusTool=false then begin				MyLoadErrMC:=0;				MCStartup(MyID);				if IsToolError then begin					HaveLoadErrors:=true;					MyLoadErrMC:=ToolErrorNum;					end;				IStartedMCT:=true;				end;{of statustool=false}			end;{ofIsToolError=false}		end;{of compound if}				end;{of if IStartedMCT}if IloadedFonts=false then begin	IStatusTool:=FMStatus;	if IsToolError then begin		loadonetool(27,0);		if IsToolError then begin			HaveLoadErrors:=true;			MyLoadErrFM:=ToolErrorNum;			end else ILoadedFonts:=true;		end;	end;{of Iloadedfonts=false}	if IStartedFonts=false then begin	if ((IloadedFonts=true) or (MyLoadErrFM=0)) then begin		IStatusTool:=FMStatus;		if IsToolError=false then begin			if IStatusTool=0 then begin				MyLoadErrFM:=0;				ToolZP2:=NewHandle(512,MyID,fixedBank+fixedblk+locked,ptr(0));				MyLong:=Ord4(ToolZP2^);				IStatusTool:=LoWord(MyLong);				FMStartup(MyID,IStatusTool);				if IsToolError then begin					HaveLoadErrors:=true;					MyLoadErrFM:=ToolErrorNum;					end;				IStartedFonts:=true;				end;{of statustool=false}			end;{of IsToolError=false}		end;{of compound if}				end;{of if IStartedFonts}if IloadedQDAux=false then begin		IStatusTool:=QDAuxStatus;	if ISToolError then begin		loadonetool(18,0);		if IsToolError then begin			HaveLoadErrors:=true;			MyLoadErrMC:=ToolErrorNum;			end else ILoadedQDAux:=true;		end;{of toolerrornum<>0}	end;{of IloadedQDAux=false}	if IStartedQDAux=false then begin	if ((IloadedQDAux=true) or (MyLoadErrMC=0)) then begin		IStatusTool:=QDAuxStatus;		if IsToolError=false then begin			if IStatusTool=0 then begin				MyLoadErrMC:=0;				QDAuxStartup;				if IsToolError then begin					HaveLoadErrors:=true;					MyLoadErrMC:=ToolErrorNum;					end;				IStartedQDAux:=true;				end;{of statustool=false}			end;{ofIsToolError=false}		end;{of compound if}			end;{of if IStartedMCT}end;{of CLoadTools}procedure CUnloadTools; var 	statustool:boolean; 	IStatusTool:integer;beginif KeepTools=false then beginMyToolsActive:=false;	if IStartedMCT then begin		MCShutdown;		IStartedMCT:=false;		end;	if ILoadedMCT then begin		statustool:=MCStatus;		if IsToolError=false then Unloadonetool(38);		ILoadedMCT:=false;		end;{of if}	if IStartedFonts then begin		FMShutdown;		DisposeHandle(ToolZP2);		IStartedFonts:=false;		end;	if ILoadedFonts then begin		Istatustool:=FMStatus;		if IsToolError=false then Unloadonetool(27);		ILoadedFonts:=false;		end;{of sane}	if IStartedQDAux then begin		QDAuxShutdown;		IStartedQDAux:=false;		end;	if ILoadedQDAux then begin		Istatustool:=QDAuxStatus;		if IsToolError=false then Unloadonetool(18);		ILoadedQDAux:=false;		end;{of if}end;{of KeepTools=false}end;{of CUnloadTools}function AddColons(TString:string;MCUnitType:integer):string;var x,y:integer;	TempStr:str255;begin	TempStr:=TString;	if MCUnitType=MCInTimes then begin		TempStr:='0:00:00.00';		x:=ord(TString[0]);		y:=10;		repeat			begin				TempStr[y]:=Tstring[x];				x:=x-1;				y:=y-1;				if ((y=8) or (y=5) or (y=2)) then y:=y-1;			end;		until x=0;		end;{of if}	AddColons:=TempStr;end;{of AddColons}function ValidPoint(TString:string):boolean;var i:integer;begin	ValidPoint:=false;	i:=ord(TString[0]);	if i=0 then Exit;	for j:=1 to i do		if ((TString[j]<chr(48))or (TString[j]>chr(57)))			then Exit;	ValidPoint:=true;end;{of ValidPoint}function StripColons(TString:string):string;var i,x,y:integer;	SString:string;begin		i:=ord(TString[0]);		if i=0 then begin			StripColons:='';			EXIT;			end;		x:=1;		y:=0;		repeat			begin				if ((Tstring[x]=chr(58)) or (Tstring[x]=chr(46)) or (Tstring[x]=chr(59))) then 					 x:=x+1					 else				begin					y:=y+1;					SString[y]:=Tstring[x];					x:=x+1;					end;			end;		until x=(i+1);		SString[0]:=chr(y);		StripColons:=SString;	end;{of StripColons}procedure SetHilites;var CABool: boolean;III: integer; ll: longint; AWord: integer;Label 100;begin	MCGetName(MCChannel,@MyString);{check for error, no driver}	if IsToolError then begin {force all buttons inactive}		for III:=0 to NoControls do begin			if III=13 then begin				V320Mode:=(BitAnd(GetMasterSCB,$0080)=0);{0=320}				if V320Mode then AWord:=$1000 else AWord:=$3000;				IconDraw:=true;				DisposeControl(Chandle[14]); DisposeControl(Chandle[13]);				SetRect(RectPtrX,Column4,Row3,Column4+ButtonWidth,Row3+RowHeigth);				Chandle[13]:=NewControl(myWindPtr,RectPtrX,'',2,0,0,100,Pointer($00000000),ll,@BtnCtrlColor);				SetRect(RectPtrX,Column5,Row3,Column5+ButtonWidth,Row3+RowHeigth);				Chandle[14]:=NewControl(myWindPtr,RectPtrX,'',2,0,0,100,Pointer($00000000),ll,@BtnCtrlColor);			end;			if ((III=17) or ((III>=RadioCS) and (III<=RadioCE)))  then CActive[III]:=true			else begin				if III < ScrollCS then HiliteControl(255,CHandle[III])					else Begin						SetCtlParams(0,0,Chandle[III]);						SetCtlValue(0,CHandle[III]);						end;				CActive[III]:=false;				end;{of if else}			DrawOneCtl(Chandle[III]);			end;{of do}		end else {set buttons as needed by driver}		for III:=0 to NoControls do  begin					CABool:=true;			case III of						5,6,8,9: begin if MCGetFeatures(MCChannel,mcFStep)=0 then 					CABool:=false; end;				10: begin if MCGetFeatures(MCChannel,mcFRecord)=0 then 		 			CABool:=false; end;				13: begin if IconDraw then begin					DisposeControl(Chandle[13]);					Chandle[13]:=MyNewCtrl2(myWindPtr,0,@MyIconTemp);					end; end;				14: begin if IconDraw then begin					IconDraw:=false;					DisposeControl(Chandle[14]);					Chandle[14]:=MyNewCtrl2(myWindPtr,0,@MyIconTemp2);					end; end;				16: begin if MCGetFeatures(MCChannel,mcFVideo)=0 then					CABool:=false; end;				21,22: begin if MCGetFeatures(MCChannel,mcFLock)=0 then					CABool:=false; end;				23,24: begin if MCGetFeatures(MCChannel,mcFVDisplay)=0 then					CABool:=false; end;				ScrollCS,ScrollCE: begin 					if MCGetFeatures(MCChannel,mcFVolume)=0 then begin						SetCtlParams(0,0,Chandle[III]);						SetCtlValue(0,Chandle[III]);						CABool:=false;					end else SetCtlParams(255,25,Chandle[III]);						HiliteControl(0,Chandle[III]);					Goto 100;					end;				end;{of case}			if CABool=false then begin		 			HiliteControl(255,Chandle[III]);		 			end		 		else begin		 			HiliteControl(0,Chandle[III]);		 			end;			100:CActive[III]:=CABool;			DrawOneCtl(Chandle[III]);		end;{of do}		if IconDraw then beginif V320Mode then begin DrawIcon(@IconL,AWord,Column4+17,Row3+4);DrawIcon(@IconR,AWord,Column5+17,Row3+4);end elsebegin DrawIcon(@IconL,AWord,Column4+12,Row3+4);DrawIcon(@IconR,AWord,Column5+12,Row3+4);end; end;end;{of SetHilites}procedure DoDisplayTog;Var AWord: integer;beginCase displaytog[McChannel] of		McInFrames:begin			displaytog[McChannel]:=McInTimes;			end;		McInTimes:begin			displaytog[McChannel]:=McInFrames;			end;	end;{of case displaytog[McChannel]}	setDithColor(0);	setTextMode($0004);	setforecolor($000f);	with myrect do begin top:= rbRow1+28; left:=16; bottom:=Row3-20; right:=rbcol4+26; end;	PaintRrect(myrect,30,15);	DrawInDMode;	setTextMode($0000);	setforecolor($0000);	setDithColor(15);	MyOldString1:='XXXXXXXXXX';	AWord:=MCGetStatus(MCChannel,1);		if toolerrornum<>0 then WantDisplay[McChannel]:=0;	MyOldChapter:=99;end;{of DoDisplayTog}procedure SwitchChann(i:integer);var III:integer;begin	    MyOldString1:='XXXXXXXXXX';	    ForceDsply:=true;	    SetCtlValue(0,CHandle[CurrentRadio]);	    CurrentRadio:=i;	    MCChannel:=1+(CurrentRadio-RadioCS);	    SetCtlValue(1,CHandle[CurrentRadio]);	    SetHilites;	    {Now clear display window}	    	setdithcolor(0);		with myrect do begin			top:= rbRow1+13; left:=12; bottom:=Row3-18; right:=rbcol4+30;;			end;		PaintRrect(myrect,30,15);		setTextMode($0004);		setforecolor($000f);		DrawInName;		DrawInDMode;				setTextMode(0);		setforecolor(0);		setdithcolor(15);		frameRrect(myrect,30,15);		MyPutLEText(MyInPoint[McChannel],LineEditCS);		MyPutLEText(MyOutPoint[MCChannel],LineEditCS+1);end;{of SwitchChann}procedure MyPutLEText(Point:Longint;HdlIndex:integer);begin	MyString:=LongIntToString(Point);	MyString:=AddColons(MyString,displaytog[McChannel]);	LESetText(Pointer(@MyString[1]),Ord(MyString[0]),Pointer(GetCtlTitle(chandle[HdlIndex])));	DrawOneCtl(chandle[HdlIndex]);end;{of MyPutLEText1}end.