*********************************************************************************			Media Control CDEV***		Copyright 1988,1989,1990 Apple Computer, Inc.*			All rights reserved***		Written by :	Dan Hitchens**				with code from:*				Tim Harrington*				     and*				Scott Kuechle*********************************************************************************** Revision History** 1.0dx     9/1/89   DDH	-Took directconnect CDEV and started modifying** 1.0d8	    3/15/90  DDH	-Fixed so that Modem and Printer ports show up*				 correctly even if ports are configured *				 differently (i.e. modem as printer port)*				-Added code for SCSI port to show up if any SCSI*				 device is in system.** 1.0d9	    3/20/90  DDH	-Changed so that CDEV will only display media*				 control file aux type devices $04xx.*				-We now on closeCDev, shutdown and unload drivers* 1.0d11    4/26/90  DDH	-Finally should build on the build system* 1.0d12    5/23/90  DDH	-Modified so will only unload changed drivers on*				 specific channels instead of all drivers each time*				 CDev was terminated.* 1.0d13	6/5/90		-Cleaned up some source code names and documentation* 1.0d17	10/8/90		-Added "Media.Control" subdirectory level* 1.0d20	11/25/90	-Changed "NONE" to "GAME PORT"* 				-Added checking for only selecting driver or port error*				 and putting up alert window when occurs.* 1.0d21	11/30/90	-Added colored radio buttons indicating connection made*				-Changed alert messages on only selecting a driver or port*				-Added code for appleshare networked booting (looks in users file)*				-Added alert indicating media.setup was locked whenever the*				 user trys to change something.* 1.0d28	3/5/91		-Added CLEAR button to clear colored radio button*				-Added any selection will color the radio button* 1.1		7/26/91		-Fixed problem of channel turning red with using tab on*				port or drive list.*******************************************************************************		msb	off		string	asis		INCLUDE	'M16.UTIL'		INCLUDE	'M16.GSOS'		INCLUDE	'M16.CONTROL'		INCLUDE	'M16.MISCTOOL'		INCLUDE	'M16.MEMORY'		INCLUDE	'M16.INTMATH'		INCLUDE	'M16.PRINT'		INCLUDE	'M16.LIST'		INCLUDE 'M16.Quickdraw'		INCLUDE 'M16.Locator'		INCLUDE 'M16.Dialog'		INCLUDE	'M16.Window'		ENTRY	bogusCDEV,\			InitCDEV,\			CloseCDEV,\			CreateCDEV,\			MyHitCDEV,\			AboutCDEV,\			SetupChann,\			SaveChann,\			FromListD,\			FindSelected,\			FromListP		ENTRY	FindSelected2		ENTRY	MyRectCDEV		ENTRY	AlertConns		ENTRY	C2Device,CPort		ENTRY	OldDriversName		ENTRY	OldPortsName		ENTRY	WriteData				ENTRY	MMDriver		ENTRY	MMPort		ENTRY	MMChannel		ENTRY	XSetupTable		ENTRY	MMCmpDriver		ENTRY	MMCmpPort		ENTRY	TheWindPtr		ENTRY	MyCtrlListH1		ENTRY	MyCtrlListH2		ENTRY	List1Control		ENTRY	List2Control		ENTRY	SetupErr		ENTRY	MSCreateErr		ENTRY	AddColor		ENTRY	TheHandle		ENTRY	ForceColorzp0		equ	0		;Zero page usezp1		equ	zp0+4zpsize		equ	zp1+4		;Length of zero page.MemRecSize	equ	5		;Size of each member record.*##############################################################################** Below is the main entry point for this CDEV.  All messages (commands)* passed to the CDEV by the Control Panel go through this point.  This CDEV* handles only 5 of the standard CDEV calls.  These are listed below:**	Call Name	Call Number*	---------	-----------*	INIT		4*	CLOSE		5*	CREATE		7*	ABOUT		8** ON ENTRY:	C,X,Y =	Unknown*		Stack =	Result Space (Long)*			Message (Word)*			Data1 (Long)*			Data2 (Long)*			Return Address (3 Bytes)**			Message = Call Number*			Data1 = Window Grafport*			Data2 = Unused** ON EXIT	C,X,Y =	Changed*		Stack =	Result (Long)**			Result = 0 (always)**##############################################################################main		PROC		ENTRY	Data1,Data2		ENTRY	List1Control		ENTRY	List2Control		ENTRY	ControlList		ENTRY	MyRect		ENTRY	AboutList		ENTRY	MErrorList		ENTRY	Mem1RecH,Mem2RecH		ENTRY	MyID		ENTRY	List1Count,List2Count		ENTRY	List1ID,List2ID		ENTRY	CreateError		phb			;Save old data reg		phk			;Set data reg = prog reg		plb		lda	5,s		;Load DATA2 off the stack		sta	Data2		;and store it locally.		lda	7,s		sta	Data2+2		lda	9,s		;Load DATA1 off the stack		sta	Data1		;and store it locally.		lda	11,s		sta	Data1+2		lda	13,s		;Load MESSAGE off the		sta	Message		;stack and store it locally.		lda	1,s		;Bump the stack up to prepare		sta	11,s		;to take off the 3 parameters		lda	3,s		;that we stored about.		sta	13,s		PullWord		;Get rid of MESSAGE space		PullLong		;Get rid of DATA1 space		PullLong		;Get rid of DATA2 space		lda	Message		;Load the call number		cmp	#12		;Compare againts max+1		bcs	ret_addr	;If >= max+1, just leave.		pea	ret_addr-1	;Push our return address		asl	a		;Times 2 into word table		tax			;Move into index reg		lda	cdev_calls,x	;Load the address of call handler		pha			;Push the address of routine on the stack		rts			;Jump to the call handlerret_addr	lda	#0		;Make sure we return zeros.		sta	5,s		sta	7,s		plb			;Restore NDAs data bank register		rtl			;Return to Control Panel NDA.Message		dc.w	0		;Local storage for MESSAGEData1		dc.l	0		;Local storage for DATA1Data2		dc.l	0		;Local storage for DATA2MyID		dc.w	0CreateError	dc.w	0		;0 = no error, 1 = error;-------------------------------------------------------------------------;; CDEV Vectors;;-------------------------------------------------------------------------cdev_calls	dc.w	bogusCDEV-1	;0	;Null		dc.w	bogusCDEV-1	;1	;MachineCDEV		dc.w	bogusCDEV-1	;2	;BootCDEV		dc.w	bogusCDEV-1	;3	;ShutdownCDEV		dc.w	InitCDEV-1	;4		dc.w	CloseCDEV-1	;5		dc.w	bogusCDEV-1	;6	;EventsCDEV		dc.w	CreateCDEV-1	;7		dc.w	AboutCDEV-1	;8		dc.w	bogusCDEV-1	;9	;RectCDEV		dc.w	myHitCDEV-1	;10	;HitCDEV		dc.w	bogusCDEV-1	;11	;RunCDEV		;---------------------------------------------------------------------------;; Control Definitions;;---------------------------------------------------------------------------ControlList		dc.l	Radio1Control	;Radio button1		dc.l	Radio2Control	;Radio button2		dc.l	Radio3Control	;Radio button3		dc.l	Radio4Control	;Radio button4		dc.l	Radio5Control	;Radio button5		dc.l	Radio6Control	;Radio button6		dc.l	Radio7Control	;Radio button7		dc.l	Radio8Control	;Radio button8		dc.l	SText1Control	;Port:		dc.l	SText2Control	;Printer:		dc.l	SText3Control	;'Select a Media Channel' text		dc.l	SimpButton	;Simple "Clear Channel" button		dc.l	0LeftEdge	equ	10RightEdge	equ	190TL1Vert		equ	18+35BR1Vert		equ	60+35TL2Vert		equ	79+30BR2Vert		equ	121+30TL3Vert		equ	8+35BR3Vert		equ	18+35TL4Vert		equ	69+30BR4Vert		equ	79+30List1Control	dc.w	14		;PCountList1ID		dc.l	1		;ID number		dc.w	TL2Vert		dc.w	LeftEdge		dc.w	BR2Vert		dc.w	RightEdge		dc.l	$89000000	;listcontrol ID		dc.w	0		;Flag		dc.w	$7401		;More Flags		dc.l	0		;Ref conList1Count	dc.w	0		dc.w	0		;Number seen		dc.w	6		;Single selection Pascal stringsList1Start	dc.w	1		;1st member seen		dc.l	0		;Draw routine		dc.w	10		;Height		dc.w	5		;List record sizeMem1RecH	dc.l	0List2Control	dc.w	14		;PCountList2ID		dc.l	2		;ID number		dc.w	TL1Vert		dc.w	LeftEdge		dc.w	BR1Vert		dc.w	RightEdge		dc.l	$89000000	;listcontrol ID		dc.w	0		;Flag		dc.w	$7401		;More Flags		dc.l	0		;Ref conList2Count	dc.w	0		dc.w	0		;Number seen		dc.w	6		;Single selection Pascal stringsList2Start	dc.w	1		;1st member seen		dc.l	0		;Draw routine		dc.w	10		;Height		dc.w	5		;List record sizeMem2RecH	dc.l	0SText1Control	dc.w	8		;PCount		dc.l	3		;ID number		dc.w	TL4Vert		dc.w	LeftEdge		dc.w	BR4Vert		dc.w	RightEdge		dc.l	$81000000	;Static text		dc.w	1		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SText1		dc.w	SText1LenSText2Control	dc.w	8		;PCount		dc.l	4		;ID number		dc.w	TL3Vert		dc.w	LeftEdge		dc.w	BR3Vert		dc.w	RightEdge		dc.l	$81000000	;Static text		dc.w	1		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SText2		dc.w	SText2LenSText1		dc.b	'Select a Port:'SText1Len	equ	*-SText1SText2		dc.b	'Select a Media Device:'SText2Len	equ	*-SText2radiocontrol	equ	$84000000FctlProcRefNotPtr equ	$1000rc1h		equ	15rc2h		equ	28rc1v		equ	25rc2v		equ	65rc3v		equ	105rc4v		equ	145RadioTitle1	str	'1'Radio1Control	dc.w	8		dc.l	5		dc.w	rc1h,rc1v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle1		dc.w	1		EXPORT MyRadio1ColorMyRadio1Color		dc.w	0			;reserved		dc.w	$00f0			;radNOR		dc.w	$00f0			;radSel		dc.w	$00f4			;radTitle		EXPORT MyColorAddrMyColorAddr	dc.l	MyRadio1ColorDefaultClr		dc.w	0			;reserved		dc.w	$00f0			;radNOR		dc.w	$00f0			;radSel		dc.w	$00f0			;radTitle		EXPORT MyDColorAddrMyDColorAddr	dc.l	DefaultClr				RadioTitle2	str	'2'Radio2Control	dc.w	8		dc.l	6		dc.w	rc1h,rc2v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle2		dc.w	0		RadioTitle3	str	'3'Radio3Control	dc.w	8		dc.l	7		dc.w	rc1h,rc3v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle3		dc.w	0		RadioTitle4	str	'4'Radio4Control	dc.w	8		dc.l	8		dc.w	rc1h,rc4v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle4		dc.w	0RadioTitle5	str	'5'Radio5Control	dc.w	8		dc.l	9		dc.w	rc2h,rc1v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle5		dc.w	0		RadioTitle6	str	'6'Radio6Control	dc.w	8		dc.l	10		dc.w	rc2h,rc2v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle6		dc.w	0		RadioTitle7	str	'7'Radio7Control	dc.w	8		dc.l	11		dc.w	rc2h,rc3v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle7		dc.w	0		RadioTitle8	str	'8'Radio8Control	dc.w	8		dc.l	12		dc.w	rc2h,rc4v,0,0		dc.l	radiocontrol		dc.w	1		dc.w	FctlProcRefNotPtr		dc.l	0		dc.l	RadioTitle8		dc.w	0				SText3Control	dc.w	8		;PCount		dc.l	13		;ID number		dc.w	3		dc.w	LeftEdge		dc.w	13		dc.w	RightEdge		dc.l	$81000000	;Static text		dc.w	1		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SText3		dc.w	SText3LenSText3		dc.b	'Select a Media Channel:'SText3Len	equ	*-SText3SimpButton	dc.w	7		;PCount		dc.l	14		;ID number		dc.w	157		dc.w	LeftEdge+23		dc.w	0		dc.w	0		dc.l	$80000000	;Static text		dc.w	0		;Flag		dc.w	$1000		;More flag		dc.l	0		dc.l	SButtonText		SButtonText	str	'Clear Channel'MyRect		dc.w	15,leftedge,50,rightedgeAboutList	dc.w	8		;Pcount		dc.l	1		;ID		dc.w	38,5,138,280		dc.l	$81000000		dc.w	1		dc.w	$1000		dc.l	0		dc.l	AboutText		dc.w	AboutTextLenAboutText	dc.b	'The Media Control''s control panel '		dc.b	'allows you to specify a media control channel for '		dc.b	'controlling multimedia devices. '		dc.b	'Only those media device drivers and '		dc.b	'their associated port drivers present '		dc.b	'in your system are listed.'AboutTextLen	equ	*-AboutTextMErrorList	dc.w	8		;Pcount		dc.l	1		;ID		dc.w	TL1Vert		dc.w	LeftEdge		dc.w	BR2Vert		dc.w	RightEdge		dc.l	$81000000		dc.w	1		dc.w	$1000		dc.l	0		dc.l	MErrorText		dc.w	MErrorTextLenMErrorText	dc.b	'An error occured while trying to allocate '		dc.b	'memory.  This CDEV requires some free '		dc.b	'memory in order to operate.'MErrorTextLen	equ	*-MErrorText		ENDP*##############################################################################*			Below are the CDEV handler routines		      **##############################################################################bogusCDEV	PROC		rts		ENDP;##############################################################################		InitCDEV	PROC		lda	data1		sta	TheWindPtr		lda	data1+2		sta	TheWindPtr+2							rts		ENDP;##############################################################################		MyRectCDEV	PROC		rts		ENDP;##############################################################################		MyHitCDEV	PROC		lda data1		ora data1+2		beq @AllDone		lda data2		;get button id		cmp #3			;see if hit in one of the lists		bcs NotLst		;branch if not		;We arrive here if we have an event in one of the lists;Check to see if we want an alert because unable to create media.setup		lda MSCreateErr		beq @NoAlert		;branch if no alert needed		ldx #4			;want unalbe to create alert		bra @ForceBack;Check to see if we want an alert dialog because media.setup was locked@NoAlert		lda SetupErr		;get read media.setup file error if any		cmp #$004e		;was it access denyed (file was locked?)		bne @AllDone		;branch if not		ldx #0@ForceBack		jsr AlertConns		;send up an alert message;Now force back to the current channel so it will redraw without the item selected		lda MMChannel		;get current channel		jmp GoodSel		;go redo the channel selection in the list		@AllDone	;Now set the radio button color;		jsr SaveChann;		lda MMDriver;		ora MMPort;		beq NothinSel		;branch if nothing selected		ldx	List1ID		;Look at list #1		jsr	FindSelected2	;Find selected member			bne	@FoundIt	;Branch if we found one!		ldx	List2ID		;Look at list #2		jsr	FindSelected2	;Find selected member					beq	NothinSel	;branch if nothing selected@FoundIt		inc ForceColor		;indicate to force colorNothinSel		jmp SetTheColorNotLst		cmp #5		bcc exit		;branch if less than 5		cmp #13		bcc ValidRB		;branch if 12 or less		cmp #14		bne exit		;branch if not clear channel button		;We arrive here if its the "Clear Channel" simple button that was hitClearChanX;Now check to see if the media.setup file was locked and display dialog if it was.		lda SetupErr		;get read media.setup file error		cmp #$004e		;see if access denyed error		bne ClearOK		;branch if not 		ldx #0		jsr AlertConns		;put up alert		bra exit		;exit without clearingClearOK				lda	MMChannel	;get channel were working with		asl	a		;time 2 (two bytes per entry in table)		tax			;use as index into table		lda	XSetuptable,x	;get offset		tax		lda #0			;clear out device and port names		sta C2Device,x		sta CPort,x		jsr SetupChann		;go setup channel selection list as not sel.		bra SetTheColor		;We arrive here with a valid radio button hitValidRB		sec		sbc #5			pha			;save the new selected channel on stack		jsr SaveChann		;Save the channel from list		pla			;get new selected channel		bcc GoodSel		;branch if a good selection made		ldx #20			;normal alert		jsr AlertConns		;put up the alert		lda MMChannel		;use current channel		clc		adc #5			;calculate controls ID no.		tay		pha			;space for long result		pha		pushlong #0		;top window		pushWord #0		;high word of desired control ID		phy			;ID of desired control		_GetCtlHandleFromID	;get the controls handle				ply			;get low word of handle		plx			;get high word of handle		pushword #1		;want radio selected		phx			;push controls handle back on		phy		_SetCtlValue		;set back to the old control value		lda MMChannelGoodSel				sta MMChannel				jsr SetupChann		;setup new channel selection in list  		exit		rtsSetTheColor;Now set the radio button color		lda MMChannel		;get channel were working with		jsr AddColor		;add color to radio button		stz ForceColor		;turn off force color if was on		PushLong TheHandle			_EraseControl		;make the radio button invisible		PushLong TheHandle		_ShowControl		;redraw with color the new radio button		bra exit						ENDP*##############################################################################******************************************************************************** AddColor** This routine will set the color of the radio button to red if the channel* has something selected or black if not.********************************************************************************AddColor	PROC		;First lets get the handle to the control		sta TheRButton		;save the radio button were working with		clc		adc #5			;calculate controls ID no.		tay		pha			;space for long result		pha		ldx CZFlag		bne UseZero		PushLong Data1		;use passed window pointer		bra OverZeroUseZero		pushlong #0		;want top windowOverZero		pushWord #0		;high word of desired control ID		phy			;ID of desired control		_GetCtlHandleFromID	;get the controls handle		PullLong TheHandle	;retrieve the handle to the control;Now lets see which mode were in and set the color correctly		pha			;space for result		_GetMasterSCB		;get the master SCB		pla		ldx #$00f4		;assume 640 red		and #$0080		bne Its640		;branch if its 640 mode		ldx #$00f7		;for 320 mode redIts640		stx MyRadio1Color+6	;set the color table to red;Now lets look and see if there was anything set for this channel		lda ForceColor		;see if force color flag is set		bne JustForceIt		stz TheColorAdr		;assume nothing setup		stz TheColorAdr+2		lda TheRButton		asl a			;time two		tax		lda XSetupTable,x	;get offset into tables		tax		lda C2Device,x		ora CPort,x		and #$00ff		;only look at byte lengthJustForceIt		beq JustBW		;branch if assumption correct;here we get the address setup to the color table ready		ldx MyColorAddr		ldy MyColorAddr+2		bra OverBWJustBW		ldx MyDColorAddr		ldy MyDColorAddr+2OverBW		stx TheColorAdr		sty TheColorAdr+2;;Now create some zero page to dereference the handle;		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 12 bytes		sbc	#zpsize			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage				lda TheHandle		;copy the handle to zero page		sta zp0		lda TheHandle+2		sta zp0+2		ldy #0;Now get the pointer to the record		lda [zp0],y		;now get the pointer to control record		sta ThePtr		iny		iny		lda [zp0],y		sta ThePtr+2;Now setup the pointer in zp0		lda ThePtr		sta zp0		lda ThePtr+2		sta zp0+2;Now set the pointer to the color table or nill		lda TheColorAdr		ldy #$24		sta [zp0],y		iny		iny		lda TheColorAdr+2		sta [zp0],y;Now get rid of the zero page bytes from stack		tsc				;*Stack -> C reg.		clc				;Subtract 12 bytes.		adc	#zpsize			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.		rtsTheRButton	ds.w	1		;the controls id no.		EXPORT TheHandleThehandle	ds.l	1		;the handle to the controlThePtr		ds.l	1		;pointer to the control recordTheColorAdr	ds.l	1		;pointer to color table or nil		EXPORT CZFlagCZFlag		dc.w	1		;create zero flag		EXPORT ForceColorForceColor	dc.w	0		;force 		ENDP******************************************************************************** AlertConns** This routine will send up an alert indicating that the channel needs a port* and a driver selected or that the channel needs to be cleared.* (X-reg.)=0	;Locked alert with changes cannot be made*         =4	;Unable to create media.setup alert*	  =8	;I/O error alert*	  =12	;Insert startup volume disk alert*	  =16	;Locked alert with no changes made*	  =20 	;For normal switching between media channel alert*         =28	;For when leaving this cdev (goawaybox or another CDev selected.)*******************************************************************************AlertConns	PROC;First lets set the type of message we want to convey.		cpx #20			;see if want modified alert		bcc WasDrvr		;branch if just want normal alert		lda MMPort		;get port selection		beq wasDrvr		;branch if something selected		inx			;inc. index to next long table (dev. problem)		inx		inx		inxWasDrvr		lda TheErrTable2,x		sta TheErrPtr2		;stuff the pointer		lda TheErrTable2+2,x		sta TheErrPtr2+2		lda TheErrTable3,x		sta TheErrPtr3		;stuff the pointer		lda TheErrTable3+2,x		sta TheErrPtr3+2;Now lets see which video mode we are in		pha			;space for result		_GetMasterSCB		;get the master SCB		pla		ldx #0		and #$0080		bne Its640		;branch if its 640 mode		inx			;its 320 mode		inxIts640;Now stuff the correct left and right coordinates for the alert depending on mode		lda Alert640L,x		sta MyAlertTemp+2		lda Alert640R,x		sta MyAlertTemp+6		lda OK640,x		sta Item1Rec+2		lda AText640L,x		sta Item2Rec+2		sta Item3Rec+2		lda AText640R,x		sta Item2Rec+6		sta Item3Rec+6		pha			;space for result		pha		_GetCursorAdr		PullLong OldCursor	;save the old cursor addr		_InitCursor		;Init the cursor back to the arrow				PushWord #0		;space for result		PushLong #MyAlertTemp		PushLong #0		;nil filter proc		_CautionAlert		pla				PushLong OldCursor	;get the old cursor value		_SetCursor		rtsOldCursor	dc.l 1			;old cursor save areaAlert640L	dc.w 130		dc.w 5Alert640R	dc.w 510		dc.w 315OK640		dc.w 320		dc.w 210AText640L	dc.w 72		dc.w 48AText640R	dc.w 639		dc.w 319		MYAlertTemp		dc.w 30			;alert rectangle		dc.w 120		;alert rectangle		dc.w 85		dc.w 520		dc.w 1500		;alerts id		dc.b $85		;stage byte (1st)		dc.b $85		;stage byte (2nd)		dc.b $85		;stage byte (3rd)		dc.b $85		;stage byte (4th)		dc.l Item1Temp		dc.l Item2Temp		dc.l Item3Temp		dc.l 0		Item1Temp		dc.w 1			;item IDItem1Rec	dc.w 36			;items rectangel		dc.w 335		dc.w 0		dc.w 0		dc.w 10			;type of item (simple button)		dc.l OKString		;pointer to item description		dc.w 0			;item value		dc.w 0			;bit flag		dc.l 0			;color table (nil)OKString	str 'OK'Item2Temp		dc.w 2			;item IDItem2Rec	dc.w 11			;items rectangel		dc.w 72		dc.w 21		dc.w 639		dc.w $800f		;type of item TheErrPtr2		dc.l ErrString2		;pointer to item description		dc.w 0			;item value		dc.w 0			;bit flag		dc.l 0			;color table (nil)ErrString2	str 'No Port was selected!'ErrString2X	str 'No Media Device was selected!'ErrString2y	str 'The media channel has been cleared!'LockedStr2	str 'The Media.Setup file is Locked!'NoSpace2	str 'The disk is full!'IOError2	str 'I/O error!'ReInsert2	str 'Please insert your startup disk.'Item3Temp		dc.w 3			;item IDItem3Rec	dc.w 22			;items rectangel		dc.w 72		dc.w 32		dc.w 639		dc.w $800f		;type of item TheErrPtr3		dc.l ErrString3		;Stuffed pointer to item description		dc.w 0			;item value		dc.w 0			;bit flag		dc.l 0			;color table (nil)ErrString3	str 'Select a port or clear channel.'ErrString3X	str 'Select a device or clear channel.'LockedStr3	str 'Changes cannot be made.'IOError3	str 'Changes cannot be saved.'Noth3		str ' 'NoChngs3	str 'No changes were made.'TheErrTable2	dc.l	LockedStr2		dc.l	NoSpace2		dc.l	IOError2		dc.l	ReInsert2		dc.l	LockedStr2		dc.l	ErrString2		dc.l	ErrString2X		dc.l	ErrString2Y		dc.l	Errstring2YTheErrTable3	dc.l	LockedStr3		dc.l	IOError3		dc.l	IOError3		dc.l	Noth3		dc.l	NoChngs3		dc.l	ErrString3		dc.l	ErrString3X		dc.l	ErrString2		dc.l	ErrString2X		ENDP****************************************************************************************************** MySetPrefix - This sets the prefix 8 correctly to support booting on a local volume* or over the network.** This routine save the old prefix 8 but doesn't restore it ( you need to restore when done.)*****************************************************************************************************MySetPrefix	Proc	Export;First lets get the old prefix 8 and save it for restoring later.		_GetPrefixGS OldPfixParms	;get the old prefix 8 		bcs	oops		_DInfoGS infoParms		;get the device name for the boot device		bcs	oops		_VolumeGS volParms		;now do a Volume call to get the ID of the boot FST		bcs	oops		lda	fst_id			;get the ID number of the boot FST		cmp	#$000D			;is it AppleShare?		bne	local_boot		;no, must have been a local bootaShare_boot		_FSTSpecific fstParms		;do an FSTSpecific GetUserPath call		bcs	oops			;punt if we can't determine the pathname of the user's folder		ldx	userPfx			;get the pointer to the prefix		ldy	userPfx+2		bra	do_setPfx		;go set the prefixlocal_boot		ldx	#localPfx		;get the pointer to the local prefix		ldy	#localPfx>>16do_setPfx		stx	prefix			;store the pointer to the prefix to use		sty	prefix+2		_SetPrefixGS pfxParms		;set the prefix to the correct locationoops		rts				;return to caller, carry set if an error occurredinfoParms	dc.w	2			;pCount		dc.w	1			;device number (boot device is ALWAYS device 1)		dc.l	devName			;pointer to result buffer for device namedevName		dc.w	36			;buffer lengthdevName2	dc.w	0			;string length		ds.b	32			;buffer for device namevolParms	dc.w	5			;pCount		dc.l	devName2		;pointer to device name		dc.l	volname			;pointer to volume name buffer		dc.l	0			;total blocks		dc.l	0			;free blocksfst_id		dc.w	0			;FST ID numbervolname		dc.w	36			;buffer lengthvolname2	dc.w	0			;string length		ds.b	32			;string bufferfstParms	dc.w	3			;pCount		dc.w	$000d			;FST ID number (AppleShare)		dc.w	8			;command number (GetUserPath)userPfx		ds.l	1			;space for the prefix pointerpfxParms	dc.w	2			;pCount		dc.w	8			;prefix numberprefix		ds.l	1			;space for the prefix pointerlocalPfx	dc.w	31		dc.b	'*:System:Drivers:Media.Control:'OldPfixParms	dc.w	2			;pCount		dc.w	8			;prefix number (8)		dc.l	OldPrefixS		;ptr to prefix output string areaOldPrefixS	dc.w	84			;buffer length		EXPORT OldPrefixOldPrefix	dc.w	0			;length of prefix		ds.b	80			;prefix buffer		EXPORT RestorePFixRestorePFix	dc.w	2			;pcount		dc.w	8			;prefix number (8)		dc.l	OldPrefix		;saved prefix buffer		ENDP******************************************************************************** Times5** This routine will multiply the number in X with 5 and return the result* in the variable AddIndex.** Inputs: X = Number to mulitiply** Outputs: AddIndex = Result (long)*******************************************************************************Times5		PROC		ENTRY	AddIndex		PushLong #0		;Result space		phx			;Item number		PushWord #5		;Item length		_Multiply		PullLong AddIndex	;Offset into member list		rtsAddIndex	dc.l	0		ENDP;##############################################################################		CloseCDEV	PROC		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 4 bytes		sbc	#4			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage		jsr SaveChann			;Save the channel from list if changed		bcc GoodSel			;branch if good selection;We arrive here with a bad selection (only port or driver selected.)		ldx #28			;want alert with clearing message		jsr AlertConns		;put up the alert;Now lets clear the channel		lda	MMChannel	;get channel were working with		asl	a		;time 2 (two bytes per entry in table)		tax			;use as index into table		lda	XSetuptable,x	;get offset		tax		lda #0			;clear out device and port names		sta C2Device,x		sta CPort,x		jsr SetupChann		;go setup channel selection list as not sel.		GoodSel		lda	CreateError		beq	@CloseIt		jmp	Exit@CloseIt		jsr	WriteData	;write data to Media.setup		bcc	@MSOK		;branch if created media.setup ok		cmp	#$002e		;see if got disk switched error		beq	@CloseIt	;retry if got disk switched error		ldx	#16		;assume write-protected disk		cmp	#$002B		;see if write protected disk		beq	@DoAlert	;do the write-protect alert		cmp	#$004e		;see if invalid access		beq	@DoAlert	;branch use write-protected if invalid access		ldx 	#4		;assume volume full alert		cmp	#$0048		;see if volume full error trying to write		beq	@DoAlert	;do the disk full alert		cmp	#$0046		;see if file not found error		beq	@DoAlert	;use volume full error (was unable to create)		ldx	#8		;assume I/O error		cmp	#$0027		;see if it was an I/O error		beq	@DoAlert	;do the I/O error alert		cmp	#$0045		;see if it was a volume not found error		bne	@DoAlert		ldx	#12		;volume not found error		jsr	AlertConns	;put up the insert startup volume disk		bra	@CloseIt	;go try again@DoAlert		jsr AlertConns		;put up the alert dialog@MSOK		stz WeLoadedTool	;init indicating we didnt load tool		stz WeStartedTool	;init indicating we didnt start tool				PushWord #0		;Result space		ldx #$0626		jsl >$E10000;		_MCStatus		;Is the media ctrl tool running?		pla			;0=no		bcs	ItsNotLoaded	;branch if we have an error		beq	ItsLoaded	;branch if its loaded but not started		bra	ItsReady	;branch if loaded and started;We arrive here when we have an error doing MCStatus (we must load and startup tool)ItsNotLoaded		PushWord #38		;pass tool number		PushWord #0		;pass minimum tool version		_LoadOneTool		;load it up		bcc LOK			;branch if no error		jmp Exit		;jump if go an errorLOK		inc WeLoadedTool	;flag that we loaded tool;We arrive here when the tool is loaded but not startedItsLoaded		PushWord MyID		;pass my user id		ldx #$0226		jsl >$E10000;		_MCStartUp		bcs CheckOut		;branch if we got an error		inc WeStartedTool	;flag that we started up tool;Its loaded and started, Now we need to shutdown and unload all media ctrl drivers;that have changedItsReady				lda #8		sta UnLoadChan		;init unload channel no.UnloadLoop;First we need to see if the drivers name has changed				lda UnLoadChan		dec a			;because we want to be zero based here		asl a			;times 2		tax			;use as index		lda XSetuptable,x	;get index into tables		tax		lda #0			;so b-reg. will be zero				sep 	#$20		;short a-reg.		longa 	off				lda OldDriversName,x	;get length of old driver name		cmp C2Device,x		;compare with new length		bne UnLoadDriver	;unload if not same		cmp #0			;are they both zero?		beq UnloadDriver	;unload if they are;Both names have the same length; now compare strings chars.		tay			;remember b-reg. was cleared above		inxCmpLoop		lda OldDriversName,x		cmp C2Device,x		bne UnLoadDriver	;branch if they are different		inx		dey		bne CmpLoop		;loop through all of string		rep #$20		;back to 16-bit a-reg.		longa on;Now we need to see if the Ports name has changed				lda UnLoadChan		dec a			;because we want to be zero based here		asl a			;times 2		tax			;use as index		lda XSetuptable,x	;get index into tables		tax		lda #0			;so b-reg. will be zero				sep 	#$20		;short a-reg.		longa 	off				lda OldPortsName,x	;get length of old ports name		cmp CPort,x		;compare with new length		bne UnLoadDriver	;unload if not same		cmp #0			;are they both zero?		beq UnloadDriver	;unload if they are;Both names have the same length; now compare strings chars.		tay			;remember b-reg. was cleared above		inxPCmpLoop		lda OldPortsName,x		cmp CPort,x		bne UnLoadDriver	;branch if they are different		inx		dey		bne PCmpLoop		;loop through all of string		rep #$20		;back to 16-bit a-reg.		longa on		bra NextChann		;branch if same string (dont unload)UnLoadDriver				rep #$20		;back to 16-bit a-reg.		longa on		PushWord UnLoadChan	;pass channel no. 		ldx #$0b26		jsl >$E10000;		_MCUnloadDriver		;Shutdown and unload driverNextChann		dec UnLoadChan		;dec. channel		bne UnLoadLoop		;loop through all channels (8 to 0)		;Here we check to see if we started up the toolCheckOut		lda WeStartedTool		beq CheckUnload		;branch if we didnt startup the tool		ldx #$0326		jsl >$E10000;		_MCShutdown		;shutdown the tool since we started it;Here we check to see if we loaded the toolCheckUnLoad		lda WeloadedTool		beq Exit		;branch if we didnt load it		PushWord #38		_UnloadOneTool		;unload the tool since we loaded it;Now we just exit out of hereExit				_SetPrefixGS RestorePFix	;restore the prefix-8				tsc				;*Stack -> C reg.		clc				;Subtract 4 bytes.		adc	#4			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.		lda	MyID		beq	@NoID		PushWord MyID			;Dispose of all our memory		_DisposeAll		PushWord MyID			;Dispose of our		_DeleteID			;memory ID.@NoID		rtsUnLoadChan	dc.w	8WeLoadedTool	dc.w	0		;flag indicating we loaded toolWeStartedTool	dc.w	0		;flag indicating we started tool******************************************************************************** FindSelected** This routine will call the list manager tool to find the selected member* of the specified list and return it in X.** Inputs: X = List number** Outputs: X = Item number ( 0 = no item selected)*******************************************************************************		ENTRY	FindSelectedFindSelected	PushWord #0		;Result space (for _ResetMember2);------------------------------------------------------------------------------; Below we get the control handle for list #n and put it on the stack; for the _ResetMember2 call.;------------------------------------------------------------------------------		PushLong #0		;Result space		PushLong TheWindPtr	;Window pointer		PushWord #0		;Push high word of list #		phx			;Push low word of list #		_GetCtlHandleFromID		bcs	@BadExit;------------------------------------------------------------------------------; After the above code, the control handle is on the stack for use in the; next call.;------------------------------------------------------------------------------		ldx	#$131C		jsl	>$E10000	;_ResetMember2		plx			;Pull item number		bcs	@BadExit		rts@BadExit	lda	#0		rts******************************************************************************** FindSelected** This routine will call the list manager tool to find the selected member* of the specified list and return it in X.** Inputs: X = List number** Outputs: X = Item number ( 0 = no item selected)*******************************************************************************		ENTRY	FindSelected2FindSelected2	PushWord #0		;Result space (for _ResetMember2)		PushWord #0		;item no. for _NextMemeber2;------------------------------------------------------------------------------; Below we get the control handle for list #n and put it on the stack; for the _ResetMember2 call.;------------------------------------------------------------------------------		PushLong #0		;Result space		PushLong TheWindPtr	;Window pointer		PushWord #0		;Push high word of list #		phx			;Push low word of list #		_GetCtlHandleFromID		bcs	@BadExit;------------------------------------------------------------------------------; After the above code, the control handle is on the stack for use in the; next call.;------------------------------------------------------------------------------		ldx	#$121C		jsl	>$E10000	;_NextMember2		plx			;Pull item number		bcs	@BadExit		rts@BadExit	lda	#0		rts		ENDP*##############################################################################AboutCDEV	PROC		PushLong #0			;Space for result		PushLong Data1			;Grafport		PushWord #0			;Ptr to single		PushLong #AboutList		_NewControl2		PullLong		rts		ENDP		*##############################################################################SetupChann	PROC;first get 4 bytes of stack space for Dpage		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 4 bytes		sbc	#4			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage;First copy the current Driver and Port strings to MMCmpDriver and MMCmpPort		lda	MMChannel	;get channel were working with		asl	a		;times 2 (two bytes per entry in table)		tax			;use as index into table		lda	XSetuptable,x	;get offset		tax				sep 	#$20		;short a-reg.		longa 	off				ldy 	#0transloop	lda 	C2Device,x		sta 	MMCmpDriver,y		lda 	CPort,x		sta 	MMCmpPort,y		lda 	#0		sta 	MMDriver,y	;zero out incase no driver		sta 	MMPort,y	;zero out incase no port (will be written out)		inx		iny		cpy 	#33		bne 	transloop				rep 	#$30		;long everything		longa	on;;First do the Driver Selection;;Now check to see if there really is a previously picked driver and port in the file		jmp	OKn		;--------------------&&&****((((*&*&		ExitJ1		jmp	ExitOKn				ldx	List2Count		beq	ExitJ1		;exit if no drivers in list		stx 	CurrInList	;set current entry in list;Now get the drivers string at MMDriver and compare with MMCmpDriver for a matchCheckLoop1	ldx 	CurrInList	;get current list entry to look at		jsr	FromListD	;copy list item over to MMDriver		sep 	#$30		;short a-reg. and index regs.		longa 	off		longi	off												ldx	MMCmpDriver	;get length of string		cpx	MMDriver		bne	notsamecpdrvrloop		lda	MMDriver,x		cmp	MMCmpDriver,x		bne	notsame		dex		bne	cpdrvrloop		jmp	SameNamenotsame		rep	#$30		longa	on		longi	on		dec	CurrInList	;goto next item in loop		bne	CheckLoop1;We arrive here when the driver name from Media.Setup is not found in the list		sep	#$30		longa	off		longi	off		ldx	#33nfloop		lda	MMCmpDriver,x	;copy chars.		sta	MMDriver,x		dex		bpl	nfloop		rep	#$30		longa	on		longi	on				PushWord #0		;space for result		PushLong MyCtrlListH2		ldx	#$131c		jsl	>$e10000;		_resetmemeber2		;deselect if something already selected		PullWord		;get returned number		PushWord #0		;redraw all in list		PushLong MyCtrlListH2		Ldx	#$111c		jsl	>$e10000;		_drawmember2		;redraw list		jmp	PortSelStuff	;go do the port stuff;We arrive here when we have a match of the Drivers namesSameName				rep	#$30		longa	on		longi	on		PushWord CurrInList		PushLong MyCtrlListH2		ldx	#$141c		jsl	>$e10000;		_SelectMember2			;select the found driver name in list;;Now do the Port Selection;PortSelStuff;Now check to see if there really is a previously picked in the file		jmp	OKn2ExitJ2		jmp	ExitOKn2		ldx	List1Count		beq	ExitJ2		;exit if no Ports in list		stx 	CurrInList	;set current entry in list;Now get the Ports string at MMPort and compare with MMCmpPort for a matchCheckLoop2	ldx 	CurrInList	;get current list entry to look at		jsr	FromListP	;copy list item over to MMPort						sep 	#$30		;short a-reg. and index regs.		longa 	off		longi	off		ldx	MMCmpPort	;get length of string		cpx	MMPort		bne	notsame2cpdrvrloop2		lda	MMPort,x		cmp	MMCmpPort,x		bne	notsame2		dex		bne	cpdrvrloop2		jmp	SameName2notsame2	rep	#$30		longa	on		longi	on		dec	CurrInList	;goto next item in loop		bne	CheckLoop2;We arrive here when the driver name from Media.Setup is not found in the list		sep	#$30		longa	off		longi	off		ldx	#33		;get length bytenfloop2		lda	MMCmpPort,x	;copy chars.		sta	MMPort,x		dex		bpl	nfloop2		rep	#$30		longa	on		longi	on				PushWord #0		;space for result		PushLong MyCtrlListH1		ldx	#$131c		jsl	>$e10000;		_resetmemeber2		;deselect if something already selected		PullWord		;get returned number		PushWord #0		;redraw all in list		PushLong MyCtrlListH1		Ldx	#$111c		jsl	>$e10000;		_drawmember2		;redraw list		jmp	Exit;We arrive here when we have a match of the Drivers namesSameName2		rep	#$30		longa	on		longi	on		PushWord CurrInList		PushLong MyCtrlListH1		ldx	#$141c		jsl	>$e10000;		_SelectMember2			;select the found driver name in list				Exit		tsc				;*Stack -> C reg.		clc				;Subtract 4 bytes.		adc	#4			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.		rtsCurrInList	dc.w	1		ENDP	*##############################################################################SaveChann	PROC		longa on		longi on		rep #$30;first get 4 bytes of stack space for Dpage		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 4 bytes		sbc	#4			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage;first default MMDriver and MMPort to null (incase nothing was selected)		stz	MMDriver		stz	MMPort		;Now look for selections		ldx	List2ID		;Look at list #1		jsr	FindSelected	;Find selected member			bne	@FoundOne	;Branch if we found one!		stz	MMDriver		bra	TryPortSl	;try a port selection;		jmp	Exit0		;No member selected! (just leave)@FoundOne		jsr	FromListD	;get driver name from list	;------------------------------------------------------------------------------; Now we do the same thing to list #2 that we did for list #1;------------------------------------------------------------------------------TryPortSl		ldx	List1ID		jsr	FindSelected		beq	Exit0		jsr	FromListP	;get port name from list		;------------------------------------------------------------------------------;Now copy MMPort to file record;------------------------------------------------------------------------------Exit0				lda	MMChannel	;get channel were working with		asl	a		;time 2 (two bytes per entry in table)		tax			;use as index into table		lda	XSetuptable,x	;get offset		tax				sep 	#$20		;short a-reg.		longa 	off				ldy 	#0transloop	lda 	MMDriver,y		sta 	C2Device,x		lda 	MMPort,y		sta 	CPort,x		inx		iny		cpy 	#33		bne 	transloop				rep	#$30		;long everything		longa	on		Exit		PushWord #0		PushLong MyCtrlListH1		ldx #$111c		jsl >$e10000;		_DrawMember2		Pushword #0		PushLong MyCtrlListH2		ldx #$111c		jsl >$e10000;		_DrawMember2		tsc				;*Stack -> C reg.		clc				;Subtract 4 bytes.		adc	#4			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.;Now set the color of the radio button to indicate whether we have something selected		lda MMChannel		;get channel were working with		jsr AddColor		;add color to radio button		PushLong TheHandle			_EraseControl		;make the radio button invisible		PushLong TheHandle		_ShowControl		;redraw with color the new radio button;Now clear the carry indicating that both a port and a driver were selected or nothing was.				lda MMDriver		ora MMPort		beq OKSelect		;branch if nothing selected		lda MMDriver		beq BadSelect		;branch if not selected		lda MMPort		beq BadSelect		;branch if not selectedOKSelect	clc			;we arrive here with a good selection		rtsBadSelect	sec			;we arrive here with a bad selection		rts		ENDP*##############################################################################FromListD	PROC		dex			;Minus 1 for multiply		jsr	Times5		;Times 5 for each record.;------------------------------------------------------------------------------; Below we add the offset for this record number (# times 5) to the; base location to the member pointer list.;------------------------------------------------------------------------------		PushLong Mem2RecH		_HLock		lda	Mem2RecH		sta	zp0		lda	Mem2RecH+2		sta	zp0+2		ldy	#2		lda	[zp0]		tax		lda	[zp0],y		sta	zp0+2		stx	zp0		clc		lda	AddIndex	;Load low word of offset		adc	zp0		;Add it to low word of base		sta	zp0		;Store on zero page.		lda	AddIndex+2	;Now do the same for the		adc	zp0+2		;high word.		sta	zp0+2		ldy	#2		;Zero page location 00-03 now		lda	[zp0]		;points to a value that is a		tax			;pointer to the string to move.		lda	[zp0],y		;Get this pointer and hold it		pha			;in the X and Y registers.					;Pushlong pointer to string.		phx			;Must go onto the stack high-low!;------------------------------------------------------------------------------; Below we move the name of the file from our member list into the; Media.SETUP file buffer for writting out.  We're falling through here; with the source address pointer on the stack.;------------------------------------------------------------------------------		PushLong #MMDriver		PushLong #33		_BlockMove		PushLong Mem2RecH		_HUnlock		rts*##############################################################################FromListP	PROC		dex		jsr	Times5;------------------------------------------------------------------------------; Below we add the offset for this record number (# times 5) to the; base location to the member pointer list.;------------------------------------------------------------------------------		PushLong Mem1RecH		_HLock		lda	Mem1RecH		sta	zp0		lda	Mem1RecH+2		sta	zp0+2		ldy	#2		lda	[zp0]		tax		lda	[zp0],y		sta	zp0+2		stx	zp0		clc		lda	AddIndex	;Load low word of offset		adc	zp0		;Add it to low word of base		sta	zp0		;Store on zero page.		lda	AddIndex+2	;Now do the same for the		adc	zp0+2		;high word.		sta	zp0+2		ldy	#2		;Zero page location 00-03 now		lda	[zp0]		;points to a value that is a		tax			;pointer to the string to move.		lda	[zp0],y		;Get this pointer and hold it		pha			;in the X and Y registers.					;Pushlong pointer to string.		phx			;Must go onto the stack high-low!;------------------------------------------------------------------------------; Below we move the name of the file from our member list into the; Media.SETUP file buffer for writting out.  We're falling through here; with the source address pointer on the stack.;------------------------------------------------------------------------------		PushLong #MMPort		PushLong #33		_BlockMove		PushLong Mem1RecH		_HUnlock		rts		ENDP*##############################################################################CreateCDEV	PROC;First lets set the prefix		jsr MySetPrefix			;go set prefix depending on;						;local or network booted volume.		PushWord #0			;Result space		PushWord #$5000			;DA type		_GetNewID		PullWord MyID		bcc	@GotID		jmp	@MemoryError1@ME2Jmp		jmp	@MemoryError2@GotID		PushLong #0			;Result space		PushLong #1			;Size of block		PushWord MyID			;User ID		PushWord #$8018			;Attributes		PushLong #0			;Pointer to mem		_NewHandle		PullLong Mem1RecH		bcs	@ME2Jmp		PushLong #0			;Result space		PushLong #1			;Size of block		PushWord MyID			;User ID		PushWord #$8018			;Attributes		PushLong #0			;Pointer to mem		_NewHandle		PullLong Mem2RecH		bcs	@ME2Jmp		stz	List1Count		stz	List2Count		stz	PrePickFlag		;0 = don't pre-pick		jsr	ReadMSetup		bcs	@L1		lda	CFlag					bne	@L1			;pick, don't search.		inc	PrePickFlag		;Try to pre-pick selections.;------------------------------------------------------------------------------; Below we add zpsize bytes to the stack and point the direct page register; there.  We need zpsize bytes of zero page in SCAN4DRIVERS.;------------------------------------------------------------------------------@L1		phd				;Save the old D reg.		tsc				;*Stack -> C reg.		sec				;Add 12 bytes		sbc	#zpsize			; (actually minus)		tcs				;C reg. -> *Stack		ina		tcd				;C reg. -> *DPage		jsr	Scan4Drivers		tsc				;*Stack -> C reg.		clc				;Subtract 12 bytes.		adc	#zpsize			; (actually plus)		tcs				;C reg. -> *Stack		pld				;Restore old D reg.				PushLong #0			;Space for result		PushLong Data1			;WindPort		PushWord #0			;Ptr to Ptrs		PushLong #List1Control		;Ptr to control list		_NewControl2		PullLong MyCtrlListH1						PushLong #0			;Space for result		PushLong Data1			;WindPort		PushWord #0			;Ptr to Ptrs		PushLong #List2Control		;Ptr to control list		_NewControl2		PullLong MyCtrlListH2				PushLong #0			;Space for result		PushLong Data1			;WindPort		PushWord #3			;Ptr to Ptrs		PushLong #ControlList		;Ptr to control list		_NewControl2		PullLong			;Discard zeros		stz	CreateError		;Flag no error!;Now sort the lists		Pushlong #0		PushLong MyCtrlListH1		_SortList2			;sort the list				PushLong #0		PushLong MyCtrlListH2		_SortList2;Now change the color of the radio buttons depending if something was previously selected		stz CZFlag		lda #7			;set button no. (7-0)@RBCLoop			pha			;save button no. on stack		jsr AddColor		;go add the color to the radio button		pla			;restore button no.		dec a			;dec. button no.		bpl @RBCLoop		;loop through all radio buttons		lda #1		sta CZFlag		rts;We arrive here with and error condition occuring@MemoryError1	stz	MyID		;Flag no ID@MemoryError2	lda	#0001		;Flag error!		sta	CreateError		PushLong #0		;Space for result		PushLong Data1		;WindPort		PushWord #0		;Ptr to single		PushLong #MErrorList	;Ptr to control		_NewControl2		PullLong		;Discard		rts;------------------------------------------------------------------------------; ReadMSetup;; This routine reads in the Media.SETUP file in the system folder.  If it; doesn't exist, it will create one.;; Inputs: NONE; Outputs: NONT - Global data only;------------------------------------------------------------------------------		ENTRY	WriteDataReadMSetup	stz 	SetupErr	;init with no setup errors		stz	MSCreateErr	;init with no crete setup errorOpenAgain	_OpenGS OpenMBlock	;Open the file. 		bcs	@L2		;Branch if error.		lda	OPRef		;Transfer reference number		sta	RPRef		;to the read and close call		sta	CRef		;blocks.		_ReadGS ReadMBlock	;Read the file.@L00		php			;Save the read/write error if any;Now copy the media.setup drivers names and port names for comparing to;see if they changed when we close the CDev.		PushLong #C2Device	;source		PushLong #OldDriversName ;Destination		PushLong #528		;No. of bytes to move		_BlockMove		_CloseGS CloseBlock	;Close the file		plp			;Restore read error flag@L1		ldx #3		stx MOpenReq		;Restore read/write flag		rts@L2;We arrive here if we get an error trying to open the media.setup file		ldx	SetupErr	;get old setup error		sta 	SetupErr	;save new error		bne	@ErrOut		;branch out with error if second time;Now see if it was an access-not-allowed error		cmp	#$004e		;was it access not allowed		bne	@NotANA		;branch if not;We arrive here with an access-not-allowed error (try reopening with read only access)		ldx	#$0001		;set access to read only then		stx	MOpenReq	;set open request		bra	OpenAgain	;go retry this time with read only access@NotANA;Now see if file-not-found error (so we can go and create one if not there)		cmp	#$0046		;File not found error?		@ErrOut		sec			;Assume branch condition		bne	@L1		;Branch if not		_CreateGS CreateMBlock	;Try to create the file		bcs	@CErr		;Branch on error		jsr	WriteData		bcc	@L1@CErr		ldx	#1		stx	MSCreateErr	;set flag indicating create setup error		bra @L1		EXPORT MSCreateErrMSCreateErr	ds.w	1		EXPORT SetupErrSetupErr	ds.w	1;------------------------------------------------------------------------------; WriteData;; This routine writes the Media.SETUP file to the Drivers file in the system; system folder.;------------------------------------------------------------------------------WriteData	_OpenGS OpenMBlock	;Open the file.		bcs	@L1		;Branch on error		lda	OPRef		;Transfer reference number		sta	RPRef		;to the write and close call		sta	CRef		;blocks.		stz	CFlag		;Zero DC/ATALK flag in write buffer		_WriteGS ReadMBlock	;Write the file.		php			;Save the read/write error if any		pha		_CloseGS CloseBlock	;Close the file		pla		plp			;Restore write error flag@L1		rts;------------------------------------------------------------------------------; SCAN4DRIVERS;; This routine will scan the DRIVERS directory on the system disk in order; to find all the media control device drivers.  It will include the file names; into the appropriate list.  This routine will also scan the GS/OS devices in order; to find all the applicable ports and put them into their appropriate list.;; Inputs: NONE - Global data only; Outputs: NONE - Global data only;------------------------------------------------------------------------------Scan4Drivers	_OpenGS OpenDBlock		bcc	@L1		rts@L1		lda	ODRef		sta	GDERef		sta	CRefScanLoop	_GetDirEntryGS GetDirEntryBlock		bcc	@L00		cmp	#$004F		;Is the name just too big?		beq	ScanLoop	;Branch if yes.		jmp	ScanExit	;Else, error out.@L00		lda	FPath+2		;Load length of string		cmp	#0033		;Is the file name too large?		bcs	ScanLoop	;Branch if file name too large		xba			;Turn string into Pascal type		sta	FPath+2		;string.		lda	GDEFileType	;Is the file a driver?		cmp	#$00BB		;$BB = driver		bne	ScanLoop	;Branch if not.		lda	GDEAUXType	;Is it a media control driver?		and	#$ff00		;look only at media control major part		cmp	#$0400		bne	Back2Scan	;Branch if not.		jsr	MoveDevice	;move the name		bcs	Back2Scan	;branch if unsuccessful adding name		inc	List2Count	;Bump our valid driver counter.Back2Scan	jmp	ScanLoop	;Go back for more!TryPortType	ScanExit	_CloseGS CloseBlock;Now add 'NONE' to port list		pushlong #NoneString		pushlong #FPath+3		Pushlong #10		_BlockMove;Now move it into the list		jsr MovePort		;move port name into port list		inc List1Count		;inc. item count in list;----------------------------------------------------------------------------------;Now do the GS/OS ports lists;----------------------------------------------------------------------------------		lda #0			;init. device number to zero		sta DIDevNum			FindDevNum	inc DIDevNum		;inc. to next device no.		lda #36		sta DIDevName		;reset max. buffer size for try		_DInfoGS DInfoBlock		bcc GotOne		;branch if found some kind of device at number		rts;We arrive here with the InfoBlock filled with data about a deviceGotOne		lda DIDevID		;get returned Device ID		cmp #$0020		;see if greater than currently defined ID's		bcs UseGSString		;go ahead and put into list (for future devices);Now scan checking to see if its a valid multimedia type deviceScanMMTbl	ldx #GSMMLength+2CKDevIDLoop		dex		dex		bmi FindDevNum		;branch if not a valid media device		cmp GSMMIDTable,x	;check table for valid media device		bne CKDevIDLoop		;branch if not a match;We arrive here with a valid media device;Now see if its a 'Modem'		cmp #9			;see if its the modem port		bne tryPrinter		;branch if not;;Now see if its really the modem port and not the printer port as a modem;		lda DISlotNo		;get the slot number		and #$0007		cmp #2		bne WasPrinter		;branch if was really the printer portWasModem	PushLong #ModemString	;use 'Modem' string		bra MoveString;;Now see if its a 'Printer';tryPrinter	cmp #$000B		;now see if its a printer port		bne UseGSString		;branch if not (just use GS/OS retruned string);Now see if its really the printer port and not the modem port as a printer		lda DISlotNo		and #$0007		cmp #1			;see if printer port		bne WasModem		;branch if wasnt in printer port slotWasPrinter	PushLong #PrinterString		bra MoveString;If not modem or printer, turn GS/OS returned string to P-string starting at DIDevNameUseGSString		lda	DIDevName+2	;Load length of string		cmp	#0033		;Is the file name too large?		bcs	FindDevNum	;Branch if file name too large		xba			;Turn string into Pascal type		sta	DIDevName+2	;string.		PushLong #DIDevName+3;Now move the string to FPath+3 for everything to workMoveString		PushLong #FPath+3	;destination addr		PushLong #33		;length of string		_BlockMove;Now move it into the list		jsr MovePort		;move port name into port list		inc List1Count		;inc. item count in list		bcs notfound		;branch if nothing found		brl FindDevNum		;go look for more devicesnotfound		rts;=====================================================================DInfoBlock	dc.w	8			;Passed parameter count (PCount)DIDevNum	dc.w	0			;Passed Device Number		dc.l	DIDevName		;Passed Addr. of returned device nameDIstics		dc.w	0			;returned characteristicsDITotalBlks	dc.l	0			;returned total no. of blocksDISlotNo	dc.w	0			;returned slot no.DIUnitNo	dc.w	0			;returned unit no.DIVersion	dc.w	0			;returned version no.DIDevID		dc.w	0			;returned device IDDIDevName	dc.w	36			dcb.b	38,0;Valid GS/OS media device ID numbersGSMMIDTable		dc.w	$0004		;SCSI device (generic)		dc.w	$0006		;SCSI tape drive???		dc.w	$0007		;CD-SC		dc.w	$0009		;Modem		dc.w	$000B		;Printer		dc.w	$0015		;Tape drive (generic)??		dc.w	$0016		;Character device (generic)		dc.w	$0019		;Sequential access device (generic)GSMMLength	equ *-GSMMIDTable-2NoneString	str	'GAME PORT'ModemString	str	'MODEM'PrinterString	str	'PRINTER'SCSIString	str	'SCSI'******************************************************************************** MoveDevice** Adds the name to the list record and copies into a new memory segment* and returns with the carry clear.** Inputs:	None** Outputs:	Carry -clear if successfull; -set it unsuccessfull********************************************************************************MoveDevice	php		sep	#$30		longa	off		longi	off		rep	#$30		longa	on		longi	on		lda	List2Count		ldx	Mem2RecH		ldy	Mem2RecH+2		jsr	BumpMemRec		bcs	DeviceBExit		longa	off		longi	off		lda	PrePickFlag		beq	DeviceGExit		ldy	FPath+3@L1		lda	FPath+3,y		cmp	C2Device,y		bne	DeviceGExit		dey		bpl	@L1		ldy	#4		lda	#$80		sta	[zp1],yDeviceGExit	plp		clc		rtsDeviceBExit	plp		sec		rts		longa	on		longi	on******************************************************************************** MovePort** This routine will add the name at DIDevName* to the list record and copies into a new memory segment* and returns with the carry clear.** Inputs:	None** Outputs:	Carry:	Clear = String copied and valid********************************************************************************MovePort	php		lda	List1Count		ldx	Mem1RecH		ldy	Mem1RecH+2		jsr	BumpMemRec		bcs	PortBExit	;Branch on error		longa	off		longi	off		ldy	FPath+3@L1		lda	FPath+3,y		cmp	CPort,y		bne	PortGExit		dey		bpl	@L1		ldy	#4		lda	#$80		sta	[zp1],yPortGExit	plp		clc		rtsPortBExit	plp		sec		rts		longa	on		longi	on******************************************************************************** BumbMemRec** This routine will bump the member record list, move the file name pointed* to by FPATH+3 into a new memory handle, update the new member record to* point to the new memory handle containing the file name and zero the* selection byte for the new member record..** Inputs:	A:	ListCount for this record*		X:	Low word of MemberList handle*		Y:	High word of MemberList handle** Outputs:	Carry:	Clear = String copied*	  		Set   = Memory allocation error*		Long C,X,Y if error*		Short C,X,Y if no error********************************************************************************BumpMemRec	sta	zp0		;Store the ListCount		stx	zp1		;Store the handle (low word)		sty	zp1+2		;Store the handle (high word);-----------------------------------------------------------------------------; Below we first try to unlock the handle of the member record list.  Then; get the old size, add the length of a new record, and the re-size the; handle.  After that, we just lock it down.  If we get any errors, we leave; the BUMPMEMREC routine with the carry set.;-----------------------------------------------------------------------------		PushLong zp1		;Push handle		_HUnlock		;Unlock the handle		bcc	@OKUnlock	;Branch if no error@ShortExit	jmp	@Exit		;Else we exit with carry set.@OKUnlock	PushLong #0		;Result space		PushLong zp1		;Push handle		_GetHandleSize		;Get the current handle size		tay			;Save the error state for now					;We fall through with the current					;size of the handle on the stack.		clc			;Add in the length of the new		pla			;member record item so we can		adc	#MemRecSize	;re-size the member record list.		tax		pla		adc	#0		phy			;Save the error state on the stack.		pha			;Push the new length of the		phx			;handle onto the stack.		PushLong zp1		;Push the handle		_SetHandleSize		;Set the new size		pha			;Save the error state on the stack.		PushLong zp1		;Push the handle		_HLock			;Lock the sucker.		plx			;Pull error on SetHandleSize		ply			;Pull error on GetHandleSize		bcs	@ShortExit	;Branch if error on _HLock		sec			;Assume error		bne	@ShortExit	;Branch if error on GetHandleSize		cpx	#0		;Error on SetHandleSize?		bne	@ShortExit	;Branch if yes.;-----------------------------------------------------------------------------; Below we ask for a segment of memory that will hold the file name in; FPATH+3.;-----------------------------------------------------------------------------		PushLong #0		;Result space		PushWord #0		;High word of size of block		lda	FPath+3		and	#$00FF		ina		pha			;Low word of size of block		PushWord MyID		;User ID		PushWord #$C018		;Attributes		PushLong #0		;Pointer to mem		_NewHandle		plx			;Pull the result off the stack		ply			;and hold it in X and Y regs.		bcs	@Exit		;Branch if we didn't get the memory.		pei	zp0		;Push the ListCount for later use.		stx	zp0		;Store handle to file name		sty	zp0+2		;buffer on zero page.		ldy	#2		;De-reference the handle		lda	[zp0]		;and store it back on to		tax			;the zero page at ZP0.		lda	[zp0],y		sta	zp0+2		stx	zp0		ldy	#2		;Dereference handle that		lda	[zp1]		;points to the beginning of		tax			;the member record list and		lda	[zp1],y		;put the result back into the		sta	zp1+2		;zero page location ZP1.		stx	zp1		plx			;Pull the ListCount back off		jsr	Times5		;and multiply it by 5.		clc			;Add the offset to the address		lda	AddIndex	;of the beginning of the buffer		adc	zp1		;to get new pointer to member		sta	zp1		;record and put it back into		lda	AddIndex+2	;the zero page location ZP1.		adc	zp1+2		sta	zp1+2		ldy	#2		;Dereference handle that points		lda	zp0		;to the location to put the		sta	[zp1]		;file name into and put it back		lda	zp0+2		;into the zero page location ZP0.		sta	[zp1],y		sep	#$30		;Short everything		longa	off		longi	off		ldy	#4		;Force the selection byte to		lda	#0		;force not selected		sta	[zp1],y		ldy	FPath+3		;Load the length byte@CopyLoop	lda	FPath+3,y	;Move the entire string including		sta	[zp0],y		;the length byte into buffer pointed		dey			;to by ZPO		bpl	@CopyLoop		clc			;No error!@Exit		rts			;RETURN;----------------------------------------------------------------------		longa	on		longi	on		ENTRY	C2Device		ENTRY	CPort		ENTRY	MMDriver		ENTRY	MMPort		ENTRY	MMChannel		ENTRY	XSetupTable		ENTRY	MMCmpDriver		ENTRY	MMCmpPort		ENTRY	TheWindPtr		ENTRY	MyCtrlListH1		ENTRY	MyCtrlListH2		ENTRY	OldDriversName		ENTRY	OldPortsNamePrePickFlag	dc.w	0OpenDBlock	dc.w	3		;PCountODRef		dc.w	0		dc.l	DPath		;Pathname pointer		dc.w	0001		;Request accessDPath		dc.w	DPathLen		dc.b	'*:System:Drivers:Media.Control:'DPathLen	equ	*-DPath-2GetDirEntryBlock dc.w	13		;PCountGDERef		dc.w	0		dc.w	0		;Flags		dc.w	1		;Base		dc.w	1		;Displacement		dc.l	FPath		dc.w	0		;Entry numberGDEFileType	dc.w	0		;FileType		dc.l	0		;EOF		dc.l	0		;Block count		dc.l	0,0		;Create date/time		dc.l	0,0		;Mod date/time		dc.w	0		;AccessGDEAUXType	dc.l	0		;AUX typeFPath		dc.w	FPathLen		dc.w	0		ds.b	32FPathLen	equ	*-FPathCreateMBlock	dc.w	4		;PCount		dc.l	MPath		;Pathname pointer		dc.w	$C3		;Access byte		dc.w	$005c		;File type		dc.l	$00000100	;AUX typeOpenMBlock	dc.w	3		;PCountOPRef		dc.w	0		dc.l	MPath		;Pathname pointerMOpenReq	dc.w	0003		;Request access (R/W)MPath		dc.w	MPathLen		dc.b	'8:Media.Setup'MPathLen	equ	*-MPath-2ReadMBlock	dc.w	4		;PCountRPRef		dc.w	0		dc.l	ReadMBuffer		dc.l	RBufferLength	;Request count		dc.l	0		;Transfer countCloseBlock	dc.w	1		;PCountCRef		dc.w	0;----------------------------------------------------------------------;File format for MEDIA.SETUP;----------------------------------------------------------------------ReadMBufferCFlag		dcb.b	2,0C2Device	dcb.b	33,0		;Device name1		dcb.b	231,0		;Device name2-name8CPort		dcb.b	33,0		dcb.b	231,0RBufferLength	equ	*-ReadMBufferMMDriver	dcb.b	33,0		;intermediate storage for media driver nameMMPort		dcb.b	33,0		;intermediate storage for media port nameMMCmpDriver	dcb.b	33,0		;compare driver string storageMMCmpPort	dcb.b	33,0		;compare port string storageMMChannel	dc.w	0		;current media channel were working withOldDriversName	dcb.b	264,0		;Old drivers name from read in Media.setup fileOldPortsName	dcb.b	264,0		;Old ports names from read in Media.setup fileXSetupTable	dc.w	0		dc.w	33		dc.w	66		dc.w	99		dc.w	132		dc.w	165		dc.w	198		dc.w	231TheWindPtr	dc.l	0		;the window pointerMyCtrlListH1	dc.l	0		;list control handle1MyCtrlListH2	dc.l	0		;list control handle2		ENDP		END