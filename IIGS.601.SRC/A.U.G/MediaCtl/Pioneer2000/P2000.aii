******************************************************************	This is the Pioneer 2000 Driver (CLD-3030) ******************************************************************	Copyright Apple Computer, Inc. 1989, 1990*	All rights reserved.**	Programmed by: Dan Hitchens Aug.1989  *****************************************************************;; REVISION HISTORY; ; 8/21/90	-Took Pioneer 4200 as basis for this driver;***************************************************************;; Pioneer 2000 particulars;; -Pioneer 2000 players are passive (only determinable status is whether;  the command has completed or not.; -A multi-format disc player such as the CLD-3030 has the following differences:;	-CD's don't step, must do a pause then step to handle (for MCPause command);	-CD's don't have an absolute time search value (value is offset from;    start of current track.;	-CD's don't have the ability to do a stop at location (MCStopAt is useless); -This video display is weird on this device;	-The Display command toggles on/off the display;	-There is a Display-Squelch and a Display-Normal commands;	-There is no way to effectively handle the mcCDispalyOn and mcCDisplayOff;    commands  (We just toggle the dispaly on and off (may seem unpredictable;	 to the user because it may go off when we want it to go on, and on when;	 we want it to go off.); 10/23/90 DDH D18;	-Changed MCStop to do a reject instead of a pause command.; D19 (DDH);	-Changed MCGetName, MCGetSpeeds to pass pointer to returned string buffer instead;    of using TML Pascal's string function routine method.; D20 (DDH);	-Fixed bug with MCJogN where it would crash because it was jumping to EXIT12;	 instead of EXIT10.;	-Fixed strange error return from MCJogN (did clc, lda #0 in SendCmd to fix it.);;; D21 (DDH);			-Fixed MCGetname to be restartable.;; D23 (DDH);			-Fixed bug where it wasn't checking for "GAME PORT" on startup.;; D24 (DDH);			-Added jsl DecBusyFlg routine to dynamic exits because were not reenterant.;			-Fixed bug where MCJog was returning $2612 for min., sec. equal zero;			 (was only checking low 16-bits for zero, should have check all 32 bits.);			-Fixed bug with MCGetPos where it wasn't returning zero result (was storing;			 who knows where in direct page.); D26 (DDH);			-Fixed mcCInit MCControl call to do one reject command to reset the disc.;;	  (DDH)	12/9/91;			-Fixed busyflag problem (added IncBusyFlg to correct stack stuff.);;---------------------------------------------------------------			include 'all.macros'						Entry	EntryStuff			Entry	MCGetName			Entry	MCDStartUp			Entry	MCGetFeatures			Entry	MCDShutDown			Entry	MCPlay			Entry	MCPause			Entry	MCSendRawData			Entry	MCWritePStr			Entry	CvtTime2ASCII			Entry	MCGetStatus			Entry	MCControl			Entry	MCScan			Entry	MCGetSpeeds			Entry	MCSpeed			Entry	MCStopAt			Entry	MCJogN			Entry	McSearchTo			Entry	McSearchDone			Entry	McSearchWait			Entry	McGetPosition			Entry	McSetAudio			Entry	McGetTimes			Entry	McGetNoTracks			Entry	McGetDiscTOC			Entry	McGetDiscID			Entry	McRecord			Entry	MCStop			Entry	MCWaitRawData			Entry	McSetVolume						Entry	CR			Entry	ScratchStr			Entry	SetFrame			Entry	SetChapter			Entry	SetTime			Entry	MyBCDTime			Entry	CurrSpeed			Entry	BlankNextVideo						Entry	EndVector			Entry	DriverVtrs			Entry	P2000Steps			Entry	ConnectPort             	***************************************************************** Direct page equates****************************************************************DirectStack	equ 10DS3			equ	DirectStack+3	;direct stack plus phd and phbDirectPage	equ 0DP0			equ 0DP1			equ 1DP2			equ 2DP3			equ 3DP4			equ 4DP5			equ 5DP6			equ 6DP7			equ 7DP8			equ 8DP9			equ 9***************************************************************** Equates****************************************************************IncBusyFlg	equ $e10064				;Inc. busy flag routineDecBusyFlg 	equ $e10068				;Dec. busy flag routineDriverID	equ $3883				;Media Control Driver IDVersionNo	equ $0100				;version no. 1.00InChapters	equ 1					;Selector value for ChaptersInFrames	equ 2					;Selector value for FramesInTimes		equ 3					;Selector value for Times;------------------------------;Control values for MCControl;------------------------------mcCInit			equ 1				;initilize playermcCEject		equ 2				;eject discmcCVideoOn		equ 3				;turn video onmcCVideoOff		equ 4				;turn video offmcCDisplayOn 	equ 5				;turn video position display offmcCDisplayOff 	equ 6				;turn vidoe position display onmcCBlankVideo 	equ 7				;blank video for next MCSearchTomcCDefaultCom 	equ 8				;set default communicationsmcCLockDev 		equ 9				;set the device to lockedmcCUnLockDev	equ 10				;unlock the devicemcC8Data1Stop equ 40				;set 8-data 1-stop bitmcC7Data1Stop equ 41				;set 7-data 1-stop bitmcC6Data1Stop equ 42				;set 6-data 1-stop bitmcC5Data1Stop equ 43				;set 5-data 1-stop bitmcC8Data2Stop equ 44				;set 8-data 2-stop bitmcC7Data2Stop equ 45				;set 7-data 2-stop bitmcC6Data2Stop equ 46				;set 6-data 2-stop bitmcC5Data2Stop equ 47				;set 5-data 2-stop bitmcCBaudDflt	equ 50					;set baud rate to control panel settingmcCBaud50	equ 51					;set 50 baudmcCBaud75	equ 52					;set 75 baudmcCBaud110	equ 53					;set 110 baudmcCBaud134	equ 54					;set 134.5 baudmcCBaud150	equ 55					;set 150 baudmcCBaud300	equ 56					;set 300 baudmcCBaud600	equ 57					;set 600 baudmcCBaud1200	equ 58					;set 1200 baudmcCBaud1800	equ 59					;set 1800 baudmcCBaud2400 equ 60					;set 2400 baudmcCBaud3600	equ 61					;set 3600 baudmcCBaud4800 equ 62					;set 4800 baudmcCBaud7200	equ 63					;set 7200 baudmcCBaud9600 equ	64					;set 9600 baudmcCBaud19200 equ 65					;set 19200 baudmcCModem	equ 100					;set to modem portmcCPrinter	equ 101					;set to printer portmcCIgnoreDS	equ 200					;Ignore disk switched errors (dont report them to user)mcCReportDS	equ 201					;Report disk switched errors to user;------------------------------;Status values for MCGetStatus;------------------------------mcSUnknown		equ 0				;player unable to determine this statusmcSDeviceType	equ $0000			;device type selectormcSLaserDisc	equ 1mcSCDAudio		equ 2mcSLaserCD		equ 3mcSVCR			equ 4mcSCamCorder	equ 5mcSPlayStatus	equ $0001			;play status selector valuemcSPlaying		equ 1mcSStill		equ 2mcSParked		equ 3mcSDoorStatus	equ $0002			;players door statusmcSDoorOpen		equ 1mcSDoorClosed	equ 2mcSDiscType		equ	$0003			;disc type selector valuemcS_CLV			equ 1mcS_CAV			equ	2mcS_CDV			equ 3mcS_CD			equ 4mcSDiscSize		equ $0004			;disc size selector valuemcSDisc3inch	equ 3mcSDisc5inch	equ 5mcSDisc8inch	equ 8mcSDisc12inch	equ 12mcSDiscSide		equ $0005			;disc side selector valuemcSSideOne		equ 1mcSSideTwo		equ 2mcSVolumeL		equ $0006			;left volume valuemcSVolumeR		equ $0007			;right volume value;------------------------------;Audio values;------------------------------AudioOff	equ 0		;Audio OffAudioRight	equ 1		;Audio Right channel onlyAudioLinR	equ 2		;Audio left in right onlyAudioMinR	equ 3		;Audio mixed in right onlyAudioRinL	equ 4		;Audio right in left onlyAudioRinLR	equ 5		;Audio right in left and rightAudioReverse equ 6		;Audio right in left, left in rightAudioRinLMR	equ 7		;Audio right in left, mixed in rightAudioLeft	equ 8		;Audio left channel onlyAudioStereo	equ 9		;Audio Both Channels (Stereo)AudioLinLR	equ 10		;Audio left in left and rightAudioLinLMR	equ 11		;Audio left in left, mixed in rightAudioMinL	equ 12		;Audio mixed in left onlyAudioMinLRinR equ 13	;Audio mixed in left, right in rightAudioMinLLinR equ 14	;Audio mixed in left, left in rightAudioMonaural equ 15	;Audio mixed in left and right (monaural)***************************************************************** Error Equates****************************************************************UnImp		equ $2601			;Unimplemented for this deviceNotApplic	equ UnImpBadSpeed	equ $2602			;Invalid speed specifiedBadUnitType	equ $2603			;Invalid unit type specifiedTimeOutErr	equ $2604			;Timed out during device readNotLoaded	equ $2605			;No Driver is currently loadedBadAudio	equ $2606			;Invalid Audio ValueDevRtnError	equ $2607			;Device returned error (unable to perform)UnRecStatus	equ $2608			;Unrecognizable status from deviceBadSelector	equ $2609			;Invalid selector value specifiedFunnyData	equ	$260a			;funny data receive (retry again)InvalidPort	equ $260b			;invalid port specifiedOnlyOnce	equ $260c			;Scans only onceNoResMgr	equ $260d			;Resource manager not activeItemNotThere equ $260e			;Item Not found in databaseWasShutdown equ $260f			;tool was already shutdownWasStarted	equ $2610			;tool was already startedBadChannel	equ $2611			;invalid channel numberInvalidParam equ $2612			;Invalid ParameterCallNotSupported equ $2613		;call not supported error***************************************************************** CLD303 Specific Equates****************************************************************CYAReg		equ $00C036				;has speed bitAnnLow		equ $00C058				;annuciator offAnnHigh		equ	$00C059				;annuciator onBUTN0		equ $00C061BUTN1		equ $00C062BUTN2		equ $00C063				;button-2 input switch addr.BUTN3		equ $00C060***************************************************************** Driver Header and Vectors Routine****************************************************************P2000Drvr PROC			longi on			longa on			DC.W	DriverID			;Drivers ID Marker (Media Ctrl driver)			DC.W	(EndVector-DriverVtrs)/4	;count of calls supported			jmp		EntryStuff			DC.W	VersionNo			;Drivers version number (version 1.0)			str 'PIONEER2000'			;Drivers name;-------------------------------------------------------------------; WARNING:  This code is located here so we are certain that it doesn't;           cross over a page boundary causing extra cycles.;-------------------------------------------------------------------;;  NAME:		Delay;;  PURPOSE:		To delay x*.5ms;;  PASSED:		(X-reg.)= no. of .5ms to delay;;  RETURNED:	None;;-------------------------------------------------------------------Delay	PROC		longa off		longi off;This loop is .5ms (1 cycle is 1.023us)		nop@2		ldy #101 					;2@1		dey							;2		bne @1						;3 or 2		dex 						;2		bne @2		rts		longa on		longi on		ENDP;-------------------------------------------------------------------; WARNING:  This code is located here so we are certain that it doesn't;           cross over a page boundary causing extra cycles.;-------------------------------------------------------------------;;  NAME:		Delay5;;  PURPOSE:		To delay .5ms;;  PASSED:		None;;  RETURNED:	None;;-------------------------------------------------------------------Delay5	PROC		longa off		longi off		nop;This loop is .5ms @2		ldy #99 					;2@1		dey							;2		bne @1						;3 or 2		rts		longa on		longi on		ENDP;-------------------------------------------------------------------;;  NAME:		SendCmd;;  PURPOSE:		To set things up and send one command to the device.;;  PASSED:		(A-reg.)= character to send;;  RETURNED:	None;;-------------------------------------------------------------------SendCmd	PROC;and delay long enough to force new command (delay-B)				ldx #140					;delay for atleast 60ms (70ms)		EXPORT SendCmd2SendCmd2;This entry point is used for when you want to specify in the X-reg. the;delay count before a command (needed to continously hold a command like the;search fwd or rev. commands.)  Normally you would pass a value of 60 for a ;delay-A value of 30.)		longi off        longa off		sep #$30					;put into 8-bit mode				sta SaveCmd					;save the command;********Force into slow speed, so we know speed.		lda >CYAReg					;get speed bit soft switch		and #$80					;first look only a speed bit		pha							;save speed bit soft switch value		lda >CYAReg					;get it again		and #$7f					;force slow		sta >CYAReg					;store so to take effect;first make sure the pulse is high		lda >AnnHigh;Note: X-reg. holds repeat delay count		jsr	Delay		;Now send commands		ldx SaveCmd					;get saved command		jsr SendIt					;send command and wait Delay-A		lda >CYAReg					;get speed byte register		and #$7f		sta SaveCmd					;save it temporarilly		pla		ora SaveCmd		sta >CYAReg					;restore CYAReg		rep #$30					;back to 16-bit		longa on		longi on		clc							;return no errors		lda #0				rts;-------------------------------------------------------------------;;  NAME:		SendIt;;  PURPOSE:		To send one command out to the device.;;  PASSED:		(X-reg.)= character to send;;  RETURNED:	None;;-------------------------------------------------------------------		longa off		longi offSendIt		stx SaveCmd					;save the command				php							;save processor status		sei							;*****disable interrupts***;send leader		lda >AnnLow					;perform leader down		ldx #16						;delay for 8ms		jsr Delay		lda >AnnHigh					;perform leader high for 4ms		ldx #8		jsr Delay;Now send $A8		ldx #$A8		jsr SendByte;Now send $57		ldx #$57		jsr SendByte;Now send command		ldx SaveCmd		jsr SendByte;Now send complement of command		lda SaveCmd		eor #$ff					;complement bits		tax		jsr SendByte		;Now send Delay-A		lda >AnnLow					;pulse down for .5ms		jsr Delay5		lda >AnnHigh					;pulse up for 19.5				plp							;****restore interrupts****		ldx #39		jsr Delay				rts;-------------------------------------------------------------------;;  NAME:		SendByte;;  PURPOSE:		To send one byte out to the device.;;  PASSED:		(X-reg.)= byte to send;;  RETURNED:	None;;  NOTE:		The low order bits are always transferred first;-------------------------------------------------------------------SendByte		stx ByteSave		ldy #8		sty BitCtr					;init bit counter@8;send down pulse (both 0 and 1 have same down pulse length)		lda >AnnLow					;force low ***MM change		jsr Delay5					;delay .5ms		lda >AnnHigh				;force high ***MM change		lsr ByteSave				;get bit to send in carry		bcc @0						;branch if one bit		jsr Delay5		jsr Delay5;We arrive here with a 0 bit@0		jsr Delay5		dec BitCtr		bne @8						;loop for all 8 bits		rts;-------------------------------------------------------------------;; DATA AREA;;-------------------------------------------------------------------		STRING PASCAL			;we want pascal stringsSaveCmd	ds.b 1					;space to save command byteByteSave ds.b 1					;space to save byteBitCtr	ds.b 1					;bit counter storage         ENDP;-------------------------------------------------------------------;;  NAME:		CheckDone;;  PURPOSE:		To check to see if the last command has completed;;  PASSED:		None;;  RETURNED:	(Carry) =  0 if not done;						=  1 if done;;-------------------------------------------------------------------CheckDone	PROC			sep #$30			;8-bit mode			longa off			longi off			clc					;assume off			lda >BUTN0			lda >BUTN1			lda >BUTN3			lda >BUTN2			;get switch value  						bpl IsOff			;branch if off			sec					;else it was onIsOff			rep #$30			;back to 16-bit mode			longa on			longi on			rts			ENDP;-------------------------------------------------------------------;; Command Vectors AREA;;-------------------------------------------------------------------JustVectors PROC						Export DriverVtrsDriverVtrs			DC.L	MCGetName			;0 Gets the drivers name and version			DC.L	MCDStartUp			;1 Starts up the driver			DC.L	MCDShutDown			;2 Shuts down the driver			DC.L	MCGetFeatures		;3 Gets features			DC.L	MCPlay				;4 Play the device			DC.L	MCPause				;5 Pause device			DC.L	MCSendRawData		;6 Send raw data to the device			DC.L	MCGetStatus			;7 Return device status info			DC.L	MCControl			;8 Sets device control info			DC.L	MCScan				;9 Scan forward or reverse			DC.L	MCGetSpeeds			;10 Returns Valid Speeds			DC.L	MCSpeed  			;11  Sets Speed for MCPlay			DC.L	MCStopAt			;12  Sets stopping point			DC.L	MCJogN				;13  Jog device n units			DC.L	MCSearchTo			;14  Search to location			DC.L	MCSearchDone		;15  Status of if done			DC.L	MCSearchWait		;16  Waits for search to finish			DC.L	MCGetPosition		;17  Returns current position			DC.L	MCSetAudio			;18  Controls audio			DC.L	MCGetTimes			;19  Gets disc times			DC.L	MCGetDiscTOC		;20  Gets discs table of contents			DC.L	MCGetDiscID			;21  Gets discs ID			DC.L	MCGetNoTracks		;22	 Gets discs no. of tracks			DC.L	MCRecord			;23	 Puts device into record mode			DC.L	MCStop				;24  Stops the device			DC.L	MCWaitRawData		;25  Waits for raw data from device			DC.L	MCSetVolume			;26	 Set Volume			EXPORT EndVectorEndVector			ENDP			longi on			longa on			;-------------------------------------------------------------------;;  NAME:		EntryStuff;;  PURPOSE:		To save registers and setup direct page on stack space;;  PASSED:		(X-reg.)= offset into "GPortVtrs" to called routine;;  RETURNED:	None (vectors directly to called routine);;-------------------------------------------------------------------EntryStuff	PROC			Definestack			phd							;save direct page			phb							;save bank register;set bank register (B-reg.) to programs bank (K-register)			phk			plb;reserve 10 bytes from stack for direct page			tsc							;get stack value			sec			sbc #DirectStack			;reserve 10 bytes for d-page			tcs			inc a						;inc. by one for d-page start			tcd							;set direct page address			jmp (DriverVtrs,x)			;vector to called routine			ENDP;------------------------------------------------------------------------------;------------------------------------------------------------------------------;; Dynamic Exits;;; Each dynamic exit	takes 2 RTL's and moves them some number of bytes up the; stack.;;------------------------------------------------------------------------------;-----------------------------------------------------------------------------DynamicExits	PROC EXPORT	EXPORT exit20exit20	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+25,s	lda DS3+3,s	sta DS3+23,s	lda DS3+1,s	sta DS3+21,s	tsc	clc	adc #20	tcs	brl exit0x	EXPORT Exit16Exit16	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+21,s	lda DS3+3,s	sta DS3+19,s	lda DS3+1,s	sta DS3+17,s	tsc	clc	adc #16	tcs	brl Exit0x	EXPORT Exit14Exit14	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+19,s	lda DS3+3,s	sta DS3+17,s	lda DS3+1,s	sta DS3+15,s	tsc	clc	adc #14	tcs	brl Exit0x	EXPORT Exit12Exit12	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+17,s	lda DS3+3,s	sta DS3+15,s	lda DS3+1,s	sta DS3+13,s	tsc	clc	adc #12	tcs	brl Exit0x	EXPORT Exit10Exit10	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+15,s	lda DS3+3,s	sta DS3+13,s	lda DS3+1,s	sta DS3+11,s	pla	pla	pla	pla	pla	brl exit0x	EXPORT Exit8Exit8	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+13,s	lda DS3+3,s	sta DS3+11,s	lda DS3+1,s	sta DS3+9,s	pla	pla	pla	pla	brl Exit0x	EXPORT Exit6Exit6	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+11,s	lda DS3+3,s	sta DS3+9,s	lda DS3+1,s	sta DS3+7,s	pla	pla	pla	brl Exit0x	EXPORT Exit4Exit4	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+9,s	lda DS3+3,s	sta DS3+7,s	lda DS3+1,s	sta DS3+5,s	pla	pla	bra Exit0x	EXPORT Exit2Exit2	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+7,s	lda DS3+3,s	sta DS3+5,s	lda DS3+1,s	sta DS3+3,s	pla	bra Exit0x;;This clears up the stack and restores registers;	EXPORT Exit0Exit0	tax						;save A-reg in X-reg;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcdExit0x;Get rid of direct page from stack	tsc						;get stack pointer	clc	adc #DS3				;take out direct page area and D & B reg. saves	tcs		txa						;restore A-reg.;Dec. busy flag because were not reentereant	pha						;save error for return	jsl DecBusyFlg			;dec. busy flag	pla						;restore error	cmp #1					;sets carry if A-reg. not zero	rtl	ENDP;-------------------------------------------------------------------;;  NAME:		MCGetName;;  PURPOSE:		Returns the drivers name and version number.;;  PASSED:		McChannelNo		WORD	;channel number;				NameStrPtr		LONG	;string ptr to buffer for returned;										;driver name & version no.;;  RETURNED:	NONE;;-------------------------------------------------------------------MCGetName 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3RetName 	longChannelNo	word;Copy over the name and version of the driver			PushLong #DriverNamStr;Get the destiniation from the passed RetName			lda RetName+6,s			pha			lda RetName+6,s			pha;Now get the no. of bytes from the string			lda #0			pha			lda DriverNamStr	;get length of string			and #$00ff			;mask only length			inc a				;for strings length byte			pha			_blockmove			;move it			lda #0			jmp Exit6;NOTE: ConnectPort must follow DriverNamStr (dont add anything between.)			EXPORT DriverNamStrDriverNamStr str 'MCToolkit PIONEER2000 1.0' ;NOTE: leave no trailing blank			EXPORT ConnectPortConnectPort	dcb.b 36,0			;Connected ports name(stuffed by MCDStartUp)			EXPORT DriverNLenDriverNLen	dc.w ConnectPort-DriverNamStr-1			ENDP;-------------------------------------------------------------------;;  NAME:		MCDStartUp & MCDShutdown;;  PURPOSE:		Initializes and starts up the media device driver;;  PASSED:		McChannelNo		WORD	;channel number;				PortNamePtr		LONG	;pointer to port name string;				UserID			WORD	;drivers userid;;  RETURNED:	None;;-------------------------------------------------------------------MCDStartUp 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3UserID		wordPortNamePtr	longChannelNo	word;First lets see if its already been opened			lda BeenOpen			beq NotOpened		;branch if not open			brl AlreadyOpen		;jmp if already opened			;Now init. a few thingsNotOpened			lda UserID,s			sta DUserID			;save the drivers userid;First copy over the selected ports name for MCGetName			lda PortNamePtr+2,s	;get the high bytes of pointer			pha			lda PortNamePtr+2,s	;get the low bytes of pointer			pha			pushlong #ConnectPort	;destination			pushlong #36		;no. of bytes to move			_blockmove			;move it;Now adjust the string length bytes and put a blank in the ports length			lda ConnectPort		;get port name length			and #$00ff			;only want length			sec					;because we want one more (for blank)			adc DriverNLen		;add to drivers name			sep #$30			;8-bit mode			sta DriverNamStr			rep #$30			;back to 16-bit mode			lda ConnectPort			and #$ff00			;and out ports length byte			ora #$0020			;or in a blank char.			sta ConnectPort;Now copy over the selected ports name for opening			lda PortNamePtr+2,s	;get the high bytes of pointer			pha			lda PortNamePtr+2,s	;get the low bytes of pointer			pha			pushlong #DIDevName+3	;destination			pushlong #36		;no. of bytes to move			_blockmove			;move it;Now see that "Game Port" was specified.			sep #$30			longa off			longi off			ldx GamePortStr		;get length of stringChkPortLoop			lda GamePortStr,x			cmp DIDevName+3,x			bne InValErr			dex			bpl ChkPortLoop						longa on			longi on			rep #$30;Correct port was selected for this driver, Now finish up			lda DIDevName+3		;now convert from P-string to GS/OS string			and #$00ff			sta DIDevName+2			beq InvalErr		;branch if null name specified			bra SelGSOSDev		;branch 			InvalErr			rep #$30			;make sure 16-bit mode			lda #InvalidPorterrOutjmp	bra NotFound		;else return with invalid port errorSelGSOSDev;Now we have opened the device			inc BeenOpenAlreadyOpen			lda #0NotFound        	jmp Exit8						EXPORT CtrlERRORCtrlERROR	dc.W	0			;*******************************GamePortStr	str 'GAME PORT'			;--------------------------------------------------------------------; MCDShutDown Code;--------------------------------------------------------------------			EXPORT MCDShutDownMCDShutDown			stz BeenOpen		;clear flag so we know its closed			jmp Exit2			;--------------------------------------------------------------------; MCReadPStr Code;; P-2000 NOTE: A bunch of this isn't needed, all we really want to do is; return with carry clear if command is completed within TimeOut value; and carry set and (A-reg.)=error value if not completed in time.;--------------------------------------------------------------------			EXPORT MCReadPStrMCReadPStr			lda #255			sta Max_Chars		;set max. no. of chars. to 255			lda #1			sta Buff_Index		;want chars. starting at offset of one			stz GSOS_Str		;indicate p-string			lda #ReceiveStr			sta DP0			lda #^ReceiveStr			sta DP2				;set pointer to where to store received chars.			ldx #$007f			;default mask to $7f			lda #13				;default term. char. to CR			ldy #60				;default timeout to 60/60ths (1 sec.);First init. a few things			sta TermChar			stx TermMask			sty TimeOut;--------------------------------------------------------------------;MCReadPStr2:This is another entry point used by MCGetRawData routine;--------------------------------------------------------------------			EXPORT MCReadPStr2MCReadPStr2			stz Chars_Read		;init. no. of chars. readGetAnother;Now get start tick value			pha			pha					;space for result			_GetTick			;get current tick value			PullLong Test_Tick			stz over_flag		;init over flag			lda TimeOut			;get specified no of ticks wait period			clc			adc Test_Tick			sta Test_Tick		;add to tick for termination tick value			lda Test_Tick+2			adc #0			sta Test_Tick+2			bcc Try_Read			inc over_flagTry_Read;Now see if the command has completed			jsr CheckDone		;see if command was done			bcs GotAChar		;branch if command is done;We didn't completed the command, so check for timeout			pha			pha			_GetTick			;get current tick count			PullLong Curr_Tick;Now compare tick values			lda over_flag		;get overflow flag			beq notov			;branch if not			lda Curr_Tick+2		;look at high word			cmp #$ffff			beq Try_Read		;go try reading again notov			lda Curr_Tick+2			cmp Test_Tick+2			beq KeepTrying			bcs Time_overKeepTrying			lda Curr_Tick			cmp Test_Tick			bcs Time_over		;branch if exceeded time			jmp Try_Read			;We arrive here when the command has completedGotAChar			clcReadErrorX	rtsTime_over	sec			lda #TimeOutErr			rts			Chars_Read	ds.w	1			;indicates no. of chars. read			EXPORT GSOS_StrGSOS_Str	ds.w	1			;gs/os string flag (0=p-str, not zero=GS/OS)			EXPORT Buff_IndexBuff_Index	ds.w	1			;buffer index			EXPORT Max_CharsMax_Chars	ds.w	1			;max. chars. want to read			EXPORT TermCharTermChar	dc.w 	13			;termination characterTermMask	dc.w	$007f		;termination mask value			EXPORT ErrorChrErrorChr	dc.w	69			;Devices Error characterover_flag	dc.w	0			;over flag			EXPORT ReceiveStrReceiveStr	ds.b	256			;received string bufferTest_Tick	ds.l	1Curr_Tick	ds.l	1			EXPORT TimeOutTimeOut		dc.w	60			;stuffed timeout tick count			EXPORT ScratchStrScratchStr	ds.b	255			;scracth string buffer area;--------------------------------------------------------------------; MCWritePStr Code;--------------------------------------------------------------------			EXPORT MCWritePStrMCWritePStr			DefineStack			block	DirectStack			block	1			block	2			block	3			block	3PStringPtr	long							EXPORT MCWritePStr2MCWritePStr2;All this funky code sets up the stack to look like it was a tool entry;so we can call this routine from either assembly or Pascal.;First put an extra RTL onto stack (that when RTL'd to will just RTL to;where we want to actually return to)			jsl ExtraRTl			rtlExtraRTL;;Now save the direct page, bank and setup stack frame (like tool entry would);			jsl IncBusyFlg				;inc. busy flag			phd							;save direct page			phb							;save bank register;set bank register (B-reg.) to programs bank (K-register)			phk			plb;reserve 10 bytes from stack for direct page			tsc							;get stack value			sec			sbc #DirectStack			;reserve 10 bytes for d-page			tcs			inc a						;inc. by one for d-page start			tcd							;set direct page address			lda GSOSFlag		;Is this a GS/OS or P_String?			beq WantPStr		;branch if want P_String;We arrive here if we are passing a GSOS string			lda PStringPtr,s			sta DP0			clc			adc #2				;inc. past length word			sta WBuffAddr			lda PStringPtr+2,s			sta DP0+2			adc #0			sta WBuffAddr+2			lda [DP0]			;get length count			sta WreqCount		;set request count			bra go_on;We arrive here if we are passing a P_string.;Now get passed Pstring pointer off stack and set buffer addr and countWantPStr			lda PStringPtr,s			sta DP0			inc a				;inc. past byte count			sta WBuffAddr			lda PStringPtr+2,s			sta DP0+2			sta WBuffAddr+2			lda [DP0]			;get byte count			and #$00ff			sta WreqCount		;set request count			go_on;Here is where we output each character to the device			sep #$30			;want 8-bit mode			longa off			longi off			ldy #1Out_loop			lda [DP0],y			;get character			phy					;save location						rep #$30			;want 16-bit mode for this call			jsr SendCmd			;send it to the device			sep #$30			;back to 8-bit mode						ply					;restore location index			iny					;inc. to next byte			tya			cmp [DP0]			;see if at the end			beq Out_loop		;loop for last char.			bcc Out_loop		;loop for all chars. in string			rep #$30			longa on			longi on						lda NeedWait			beq nwError			;branch if not looking for response			jsr MCReadPStr		;wait for command to complete or timeout			bcs WriteErrornwError		lda #0				;not an error return			clcWriteError			stz NeedWait		;default back to not waiting			stz GSOSFlag		;default back to p_strings			jmp Exit4;--------------------------------------------------------------------; Subroutine WaitResponse;--------------------------------------------------------------------			EXPORT WaitResponseWaitResponse			jsr MCReadPStr		;wait for response			bcc noWRError			rtsnoWRError	lda #0				;not an error return			rts						EXPORT NeedWaitNeedWait	dc.w	0			;if set will cause wait for response			EXPORT GSOSFlagGSOSFlag	dc.w	0			;if set, will assume GSOS passed string;=====================================================================BeenOpen	dc.w	0			;flag to determine if this driver is open (0=closed)			EXPORT DUserIDDUserID		dc.w	0			;saved drivers useridMyError		dc.w	0WantGSID	dc.w	0			;wanted GSOS device IDDIDevName	ds.w	36			;GSOS returned device name string			EXPORT WBuffAddrWBuffAddr	dc.l	0			;passed buffer address			EXPORT WreqCountWreqCount	dc.l	0			;Passed no. of bytes to write			ENDP;-------------------------------------------------------------------;;  NAME:		WriteWaitPStr;;  PURPOSE:		Write a P-String and wait for response from device;;  PASSED:		P-String		Pointer	;pointer to p-string for output;;  RETURNED:	carry=clear if no errors (device responded OK);;-------------------------------------------------------------------WriteWaitPStr  	PROC			DefineStackRTL1		block	3PStringPtr 	long			lda #1			sta NeedWait		;flag need to wait for response			jmp MCWritePStr 			ENDP;-------------------------------------------------------------------;;  NAME:		CvtTime2ASCII;;  PURPOSE:		To convert a BCD time value to an ASCII string.;				Long of HHMMSS00 BCD to HMMSS ASCII string;;  PASSED:		Stuff MyBCDTime (LONG) with BCD time value to convert;;  RETURNED:	ScratchStr will have the resultant ASCII P-string;;-------------------------------------------------------------------CvtTime2ASCII PROC			;Now do the real work in 8-bit mode			sep #$30				;set to 8-bit mode			longa off			longi off			lda #5			sta ScratchStr			;init byte count;First do hours			lda MyBCDTime+3			and #$0f				;this player can only do max 9 hours			ora #$30				;make ascii			sta ScratchStr+1;Now do minutes (tens position)			lda MyBCDTime+2			lsr A			lsr A			lsr A			lsr A			ora #$30				;make ascii			sta ScratchStr+2;Now do minutes (ones position)			lda MyBCDTime+2			and #$0f			ora #$30			sta ScratchStr+3;Now do Seconds (tens position)			lda MyBCDTime+1			lsr A			lsr A			lsr A			lsr A			ora #$30			sta ScratchStr+4;Now do Seconds (ones position)			lda MyBCDTime+1			and #$0f			ora #$30			sta ScratchStr+5			longa on			longi on			rep #$30				;set 16-bit mode			rts						EXPORT MyBCDTimeMyBCDTime	dc.l	0				;storage space for BCD Time			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetFeatures;;  PURPOSE:		Returns the drivers features;;  PASSED:		Result			LONG	;space for result;				Channel			WORD	;channel no.;				Selector		WORD	;feature selector value;;  RETURNED:	FeatureVal		LONG	;returned driver feature value;;-------------------------------------------------------------------MCGetFeatures 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3Selector	wordChannelNo	wordFeatureVal 	long					lda Selector,s			;get feature selector value			asl a					;times 4 for longs			asl a			tax						;use as index into table			lda #BadSelector		;assume selector value is bad			cpx #MaxFeature			;is it beyond max value?			bcs OutOfHere			;branch if bad						lda FeatureTbl,x		;get return value			sta FeatureVal,s			lda FeatureTbl+2,x			sta FeatureVal+2,s			lda #0OutOfHere	jmp Exit4FeatureTbl			dc.l	7				;mcFTypes -does frames, times and chapters			dc.l	90				;mcFStep -Max. step value			dc.l	0				;mcFRecord -record			dc.l	1				;mcFVideo -does video function			dc.l	1				;mcFEject -does eject function			dc.l	0				;mcFLock -doesnt do user key lock			dc.l	1				;mcFVDisplay -does video location display			dc.l	0				;mcFVOverlay -No. of lines of char. video overlay			dc.l	0				;mcFVOChars -Video overlay no. of chars. per line			dc.l	0				;mcFVolume -doesn't support volumeMaxFeature	equ *-FeatureTbl			ENDP;-------------------------------------------------------------------;;  NAME:		MCPlay;;  PURPOSE:		To put the device in play mode;;  PASSED:		McChannelNo		WORD	;channel number;;  RETURNED:	None;;-------------------------------------------------------------------MCPlay  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	word			lda CurrSpeed				;get current speed			cmp #30			bne NotNormal;We arrive here if its just a normal speed play forward			lda #$0017					;get play commandFinishUp			jsr SendCmd					;set play command			lda #30			sta CurrSpeed				;default current speed back to normal			lda #0			jmp	Exit2NotNormal;We arrive here when we have done an MCSpeed previously;First we need to put the p2000 into step mode so the speed wont change;while we calibrate where we are.			lda #$0054			jsr SendCmd			lda LastStep				;get last step value;			bpl NoCalNeeded				;branch if no calibration needed;Now, we need to calibrate to the highest speed X3			lda #9			sta CalCtrCalLoop			lda #$47					;do a speed up			jsr SendCmd			dec CalCtr			bne CalLoop			stz LastStep				;now set last step to where we are;Now we know we are at the highest speed X3, so now we can;set the device to the correct speedNoCalNeeded			lda LastStep				;get last step value			sec			sbc P2000Steps				;subtract where we want to go			sta CalCtr					;set counter			beq Finish					;branch if already there			bmi GoDown			SetLoopD			lda #$0047					;speed up			jsr SendCmd			dec CalCtr			bne SetLoopD				;loop for no. of times need to change;Now we are at the correct speed, now just do a mulit speed fwd. or rev.Finish			lda P2000Steps			sta LastStep				;set last step to where we are			lda #$0058					;default multi fwd.			ldx CurrSpeed			bpl FinishUp			lda #$0055					;else multi rev.			bra FinishUp;Here we need to speed things downGoDown			lda #$0046					;speed down			jsr SendCmd			inc CalCtr			bpl Finish					;branch when done			bra GoDown						CalCtr		ds.w	1					;calibtration counter area			EXPORT LastStepLastStep	dc.w	-1					;default for when just loaded			ENDP;-------------------------------------------------------------------;;  NAME:		MCPause;;  PURPOSE:		To put the device in "pause" mode;;  PASSED:		McChannelNo		WORD	;channel number		;;  RETURNED:	None;;-------------------------------------------------------------------MCPause  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	word;First we do a pause command and then a still;(This pause is for CD's, they'll ignore the step command)			lda #$0018			;pause command			jsr SendCmd;Now we do the step command (because video doesn't go to blue screen)			lda #$0054			;get still command			jsr SendCmd			;set pause command			lda #0			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCSendRawData;;  PURPOSE:		To send raw data commands to the device;;  PASSED:		mcChannelNo		WORD	;channel number;				NativePtr		LONG	;pointer to string to send;;  RETURNED:	None;;-------------------------------------------------------------------MCSendRawData  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3RawData		LONGChannelNo	word;Just get the Raw Data GSOS-string pointer from stack to pass on			lda RawData+2,s			pha			lda RawData+2,s			;plus 2 because we just pushed 2			pha			lda #1			sta GSOSFlag			;set flag indicating gsos string			jsl MCWritePStr						jmp	Exit6						ENDP;-------------------------------------------------------------------;;  NAME:		MCGetStatus;;  PURPOSE:		To return status about the device;;  PASSED:		returned		WORD	;space for returned word;				McChannelNo		WORD	;channel number;				MCStatusSel		WORD	;Status Selector value;;  RETURNED:	StatusInfo		WORD	;Status information;;-------------------------------------------------------------------MCGetStatus PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3StatusSel	wordChannelNo	wordReturned	word			ldx #mcSUnknown			;This device doesn't return any status			lda StatusSel,s			;get status selector value;------------------------------------------; mcSDeviceType: This determines the device type ;------------------------------------------			cmp #mcSDeviceType			bne TryNext0			lda #mcSLaserCD			;return combination type player			sta Returned,s			lda #0			bra ExitOutXTryNext0						cmp #mcSPlayStatus			bne TryNext1;------------------------------------------; mcSPlayStatus: This determines the devices play status;------------------------------------------;We arrive here x-reg. equal to returned valueExitOut			txa			sta Returned,s			;set returned value			lda #UnImp				;return unimplemented errorExitOutX			jmp Exit4				;return;------------------------------------------; mcSDoorStatus: This does the door status (this device doesnt return such status);------------------------------------------TryNext1			cmp #mcSDoorStatus			beq ExitOut;------------------------------------------; mcSDiscType: This determines the discs status selected commands;------------------------------------------			cmp #mcSDiscType		;is it a disc type selector value			bne TryNext2			bra ExitOutTryNext2			cmp #mcSDiscSize			bne TryNext3;------------------------------------------; mcSDiscSize: We now do the Disc Size;------------------------------------------			bra ExitOut			TryNext3			cmp #mcSDiscSide			bne TryNext4			;branch, must be an invalid selector;------------------------------------------; mcSDiscSide: We now do the Disc Side;------------------------------------------			bra ExitOutTryNext4			cmp #mcSVolumeL			bne TryNext5			;branch, try right volume;------------------------------------------; mcSVolumeL: We now do the left volume value;------------------------------------------			jmp ExitOutTryNext5			cmp #mcSVolumeR			bne InvalidSel			;branch, invalid selector;------------------------------------------; mcSVolumeR: We now do the right volume value;------------------------------------------			jmp ExitOut;We arrive here with an invalid selector valueInvalidSel			lda #BadSelector			jmp Exit4						ENDP;-------------------------------------------------------------------;;  NAME:		MCControl;;  PURPOSE:		To issue information to control the device;;  PASSED:		McChannelNo		WORD	;channel number;				CtlCommand		WORD	;control command value;;  RETURNED:	None;;-------------------------------------------------------------------MCControl 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3CtlCommand	wordChannelNo	word			lda CtlCommand,s			cmp #mcCInit			;see if its an init			bne Try2;;mcCInit - Its Init time;			lda #0			sta BlankNextVideo		;set not to blank next video search			lda #30 			sta CurrSpeed			;set current speed to 30 fps (normal)			bra OneRejCmd			;do just one reject command						Try2		cmp #mcCEject			;see if its an eject command			bne Try3;;mcCEject - Its Eject time;			lda #$0016				;do a reject command			jsr SendCmdOneRejCmd			lda #$0016				;do it twice to eject discFinishOut			jsr SendCmd				;do commandNoErrors			lda #0			ExitOutJ	jmp	Exit4Try3		cmp #mcCVideoOn			bne Try4;;mcCVideoOn - Turn video On time;			lda #$005f				;do ESC			jsr SendCmd			lda #$0003				;Video Normal			bra FinishOut			Try4		cmp #mcCVideoOFF			bne Try5;;mcCVideoOff - Turn video Off time;			lda #$005f				;do ESC			jsr SendCmd			lda #$0002				;Video Squelch			bra FinishOut			Try5		cmp #mcCDisplayOn			bne Try6;;mcCDisplayOn - Turn location video display On;			lda #$005f				;do ESC			jsr SendCmd			lda #$0007				;Display Normal (un-squelched)			jsr SendCmd			lda #$0043				;toggle display (hopefully on)			jmp FinishOut			Try6		cmp #mcCDisplayOff			bne Try7;;mcCDisplayOff - Turn location video display Off;			lda #$005f				;do ESC			jsr SendCmd			lda #$0006				;Display Squelched			jsr SendCmd			lda #$0043				;toggle display (should be off)			jmp FinishOutTry7		cmp #mcCBlankVideo			bne Try8;;mcCBlankVideo - Turn display off on next search command;			lda #1			sta BlankNextVideo		;turn blank video on			jmp NoErrors			;exit with no errors			Try8			cmp #mcCDefaultCom			bne Try9;;mcCDefalultCom - Do default communications here;;Note: No default comm stuff required			jmp ErrorOutTry9		cmp #mcCBaudDflt			bcc TryDSBits			cmp #mcCBaud19200+1			bcs TryDSBits;;mcCBaud... - Change baud rate;TryDSBits	cmp #mcC8Data1Stop		;see if withing range of data stop selector			bcc Try10			cmp #mcC5Data2Stop+1			bcs Try10			bra ErrorOutTry10		cmp #mcCModem			;see if modem port selection			bne Try11				;branch if not;;mcCPrinter - switch to printer port;			bra ErrorOutTry11		cmp #mcCPrinter			;see if printer port selection			bne Try12				;branch if not;;mcCPrinter - switch to printer port;			bra ErrorOutTry12		cmp #mcCLockDev			bne Try13;;mcCLockDev - Lock device from user control;			bra ErrorOut			Try13		cmp #mcCUnLockDev			beq ErrorOut;;mcCUnLockDev - UnLock device for user control;;;mcCIgnoreDS;			cmp #mcCIgnoreDS			beq ErrorOut;;mcCReportDS;			cmp #mcCReportDS			beq ErrorOut;;We arrive here with an invalid command;TryX		lda #BadSelectorExitJ		jmp Exit4ErrorOut	lda #Unimp			bra ExitJ						EXPORT BlankNextVideoBlankNextVideo dc.w	0				;blank next video flag (0=no, 1=yes)			ENDP;-------------------------------------------------------------------;;  NAME:		MCScan;;  PURPOSE:		To scan forward or reverse.;;  PASSED:		McChannelNo		WORD	;channel number;				ScanDir			WORD	;scan direction (Pos fwd, neg. rev.);;  RETURNED:	None;;-------------------------------------------------------------------MCScan  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ScanDir 	WordChannelNo	word						ldx #20			stx RepeatCtr			;init. repeat counterLoop			lda ScanDir,s			;get direction of scan			bmi	GoReverse			;branch if reverse						lda #$0010				;get scan fwd commandCont1;We need to continously assert this command for a few times so we;must use a delay-A value between commands.  (This tells the device;that we like holding down the button and want to skip fwd. or rev. until;we let up.)			ldx #40					;for a delay of 20 ms (delay-A)			jsr SendCmd2			;do scan fwd command			dec RepeatCtr			;dec. counter			bne Loop				;loop until zero			lda #0			jmp	Exit4GoReverse			lda #$0011				;get scan rev. command			bra Cont1			RepeatCtr	dc.w	1				;repeat counter						ENDP;-------------------------------------------------------------------;;  NAME:		MCGetSpeeds;;  PURPOSE:		To return a list of available speeds that can be played;;  PASSED:		mcChannelNo		WORD	;channel number;				PStringPtr		LONG	;P string pointer to returned speeds;;  RETURNED:	NONE;;-------------------------------------------------------------------MCGetSpeeds PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3PStringPtr	LongChannelNo	word;Copy over the available speeds			PushLong #SpeedStr;Get the destiniation from the passed PStringPtr			lda PStringPtr+6,s			pha			lda PStringPtr+6,s			pha;Now get the no. of bytes from the string			lda #0			pha			lda SpeedStr		;get length of string			and #$00ff			;mask only length			inc a				;for strings length byte			pha			_blockmove			;move it			jmp	Exit6			;exit			SpeedStr	str	'1,2,4,8,15,30,60,90'			ENDP;-------------------------------------------------------------------;;  NAME:		MCSpeed;;  PURPOSE:		To set the speed for the next mcPlay command;;  PASSED:		mcChannelNo		WORD	;channel number;				Speed			WORD	;speed value(+ or -);;  RETURNED:	none;;  NOTE:*****	Could add stopping address to this command?;-------------------------------------------------------------------MCSpeed PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3Speedval	wordChannelNo	word						lda Speedval,s			;get the speed value			bpl IsPlus				;branch if forward			eor #$ffff				;minus, make plus			inc aIsPlus;Now check to see if its a vaild speed			ldx #VSpeedsEnd-ValidSpeeds-2ChkLoop		cmp ValidSpeeds,x			beq SpeedOK				;branch if valid speed			dex			dex			bpl ChkLoop			lda #BadSpeed			;speed not valid error			jmp Exit4SpeedOK			lda P2000Trans,x			sta P2000Steps			;set no. of steps						lda Speedval,s			sta CurrSpeed			;save as current speed setting			lda #0			jmp Exit4ValidSpeeds			dc.w	1			dc.w	2			dc.w	4			dc.w	8			dc.w	15			dc.w	30			dc.w	60			dc.w	90VSpeedsEndP2000Trans			dc.w	7			dc.w	6			dc.w	5			dc.w	4			dc.w	3			dc.w	2			dc.w	1			dc.w	0						EXPORT P2000StepsP2000Steps	dc.w	2			;assume 30 fps (normal)			EXPORT CurrSpeedCurrSpeed	dc.w	30			;current speed setting			ENDP;-------------------------------------------------------------------;;  NAME:		MCStopAt;;  PURPOSE:		To set the point the device is to stop at;;  PASSED:		McChannelNo		WORD	;channel number;				McUnitType		WORD	;unit type;				StopLoc			Long	;stop location;;  RETURNED:	None;;-------------------------------------------------------------------MCStopAt  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3StopLoc		LongmcUnitType	wordChannelNo	word			;To set an auto stop location on the Pioneer-2000 player we;need to send the following command sequence;		$5f $00 $digits $54 $42 {ESC 00 digits step_fwd search} for frames;		$5f $01 $digits $54 $42 {ESC 01 digits step_fwd search} for chapters;First lets do the ESC command			lda #$005f				;esc			jsr SendCmd				;do esc command			lda mcUnitType,s		;get unit type			cmp #InFrames			bne TryChap				;branch if not chapters;;We arrive here if its specified as a FRAME location;			lda #0					;esc 0 means auto stop on frameGoOn			jsr SendCmd				;do command;Now do the step fwd command			;NOTE: The returned integer string isn't a p-string (string length;is returned, right justified with leading blanks);We use 5 as the normal and max. value: HMMSS and FFFFF for frame values			lda #5			sta ScratchStr			;so set the length to the max.						lda StopLoc+2,s			;get high word			pha						;push value to be converted			lda StopLoc+2,s			pha			PushLong #ScratchStr+1			PushWord #5			PushWord #0			_Long2Dec				;convert to ASCI decimal string;Now we have a real p-string a ScratchStr			bcs ErrorOut			FinishOut;Now we need to change from ascii to hex digits by anding out high bits			sep #$30			longa off			longi off			ldx ScratchStr				;get length byteCHexLoop			lda ScratchStr,x			and #$0f					;make hex			sta ScratchStr,x			dex			bne CHexLoop			rep #$30			longa on			longi on;This sends the address value to the device			PushLong #ScratchStr			jsl MCWritePStr			;write the stop address			;And this finishes off with the step fwd and search command to make it happen			lda #$0054				;now do the stepfwd command			jsr SendCmd				;set step fwd command			lda #$0042			jsr SendCmd				;do a search command			lda #0					;return no errors			ErrorOut	jmp	Exit8TryChap			cmp #InChapters			bne TryTimes			;branch if not in time;;We arrive here if its specified as CHAPTERS;			lda #1					;for chapters			bra GoOnTryTimes	cmp #InTimes			bne InError				;branch if not one of the above;;We arrive here if its specified as TIME;			lda StopLoc,s			;get stop location (ffss)			sta MyBCDTime			;stuff for routine			lda StopLoc+2,s			;get stop location (mmhh)			sta MyBCDTime+2			;stuff for routine			jsr CvtTime2ASCII		;convert BCD time to ASCII string at ScratchStr			lda #0					;esc 0 means auto stop on frame/time			jsr SendCmd				;do command			bra FinishOut			;finish up;;We arrive here with an invalid unit specified type;InError			lda #BadUnitType			jmp Exit8						ENDP;-------------------------------------------------------------------;;  NAME:		MCJogN;;  PURPOSE:		To jog njog units forward or backwards.;;  PASSED:		McChannelNo		WORD	;channel number;				mcUnitType		Word	;unit type;				nJog			Long	;units to jog;										; for InFrames, no. of frames to jog;										; for InChapters, no. of chapters to jog;										; for InTimes, (HHMMSSxx) jog distance;				jogrepeat		WORD	;repeat counter;										;(if negative value, jog reverse nJog units);;  RETURNED:	None;;-------------------------------------------------------------------MCJogN  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3JogRepeat	wordnJog		LongmcUnitType	wordChannelNo	word;This checks that the nJog value and JogRepeat aren't zero			lda nJog,s			ora nJog+2,s			beq ValuesBad			;branch if njog is zero			lda JogRepeat,s			bne ValuesOK			;branch out if jogrepeat not zeroValuesBad			lda #InvalidParam		;return with invalid parameter error			jmp Exit10ValuesOK			lda JogRepeat,s			sta RCounter			;init repeat counter						lda mcUnitType,s		;get unit type			cmp #InFrames			beq ItsFrames			jmp NotFrames;---------------------------------------;;We do FRAME jog here;;---------------------------------------ItsFramesFrameLoop			lda nJog,s				;get jog word			sta XCounter			lda JogRepeat,s			bmi RevDir				;branch if reverse direction;Going forwardFwdFrames	lda #$0054				;do a step forward command			jsr SendCmd				;send it			dec XCounter			;dec. njog counter			bne FwdFrames			dec RCounter			;dec. repeat counter			bne FrameLoop			;do anotherOutJmp		jmp Exit10;Going Reverse (Frames)RevDir		lda #$0050				;do a step rev. command						jsr SendCmd				;send it			bcs OutJmp			dec XCounter			;dec. njog counter			bne RevDir			inc RCounter			;dec repeat counter			bne FrameLoop			;do another			jmp Exit10NotFrames			cmp #InTimes			beq DoTimeMode			;branch if time mode selected			jmp NotTime;---------------------------------------;;We do TIME mode jog here;;---------------------------------------DoTimeMode			jmp ItsFrames			;do same as framesNotTime			cmp #InChapters			beq DoDaChapter;---------------------------------------;;We do Chapter mode jog here;;---------------------------------------;; We arrive here with an invalid unit specified type;InError		lda #BadUnitType			jmp Exit10DoDaChapterChapterLoop			lda nJog,s				;get jog word			sta XCounter			lda JogRepeat,s			bmi RevDirChp			;branch if reverse direction;Going forward (Chapters)FwdChpts				lda #$0052				;do a chapt skip fwd			jsr SendCmd				;send it						dec XCounter			bne FwdChpts			dec RCounter			;dec. repeat counter			bne ChapterLoopOutJmpC		jmp Exit10;Going Reverse (Chapters)RevDirChp				lda #$0053				;do a chapter skip rev.			jsr SendCmd				;send it			dec XCounter			bne RevDirChp			inc RCounter			;dec. repeat counter			bne ChapterLoop			lda #0ExitOut		jmp Exit10			EXPORT CRCR			dc.b	2,13,10			;string composed of 1 byteXCounter	dc.w	0				;intermediate counterRCounter	dc.w	0				;repeat counter			ENDP;-------------------------------------------------------------------;;  NAME:		MCSearchTo;;  PURPOSE:		To start a search to searchloc.;;  PASSED:		McChannelNo		WORD	;channel number;				mcUnitType		Word	;unit type;				SearchLoc		Long	;units to jog;;  RETURNED:	None;;-------------------------------------------------------------------MCSearchTo  PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3SearchLoc	LongmcUnitType	wordChannelNo	word			lda mcUnitType,s		;get unit type			cmp #InFrames			beq ItsFrames			jmp NotFrames;---------------------------------------;We do frame search here;---------------------------------------ItsFrames			lda #$0041					;set to frame/time mode			jsr SendCmd					;do commandGoOn;NOTE: The returned integer string isn't a p-string (string length;is returned, right justified with leading blanks);We use 5 as the normal and max. value: HMMSS and FFFFF for frame values			lda #5			sta ScratchStr				;so set the length to the max.						lda SearchLoc,s				;get location			tax			lda SearchLoc+2,s			pha			txa			pha			PushLong #ScratchStr+1		;where to put string			PushWord #5					;max. no of chars			PushWord #0			_Long2Dec;So now we have a real p-string at ScratchStr			bcs OutJmp			GoOn2;now we need to change from ascii to hex digits			sep #$30			longa off			longi off			ldx ScratchStr				;get length byteCHexLoop			lda ScratchStr,x			and #$0f					;make hex			sta ScratchStr,x			dex			bne CHexLoop			rep #$30			longa on			longi on;Now output the location string			PushLong #ScratchStr			jsl MCWritePStr;Finish up by outputing a search command			lda #$0042					;for serach command			jsr SendCmd					;do command			lda #$00					;return no errorsOutJmp		jmp Exit8NotFrames			cmp #InTimes			bne NotTime;---------------------------------------;We do time search here;---------------------------------------			lda #$0041					;set to frame/time mode			jsr SendCmd					;do command;Now convert BCD time to ASCII time for device			lda SearchLoc,s			sta MyBCDTime			lda SearchLoc+2,s			sta MyBCDTime+2			jsr CvtTime2ASCII			;convert BCD time to ASCII string			bra GoOn2NotTime			cmp #InChapters			bne InError;---------------------------------------;We do Chapter search here;---------------------------------------			lda #$0040					;set to chapter mode			jsr SendCmd					;do command			jmp GoOn;; We arrive here with an invalid unit specified type;InError		lda #BadUnitType			jmp Exit8			EXPORT SetFrameSetFrame	str		'FR'			EXPORT SetTimeSetTime		str		'TM'			EXPORT SetChapterSetChapter 	str		'CH'SearchCmd	str		'SE'			ENDP;-------------------------------------------------------------------;;  NAME:		MCSearchDone;;  PURPOSE:		To return status if search command is completed;;  PASSED:		returned		WORD	;space for result;				McChannelNo		WORD	;channel number;;  RETURNED:	DoneStatus		WORD	;status if done (not zero;										; indicates done);;-------------------------------------------------------------------MCSearchDone PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordDoneStatus	word		;returned done status						jsr CheckDone		;see if done			lda #1				;assume done			bcs IsDone			;branch if done			lda #0				;else it wasnt doneIsDone					sta DoneStatus,s	;set return status			lda #0				;cant return any errors			jmp Exit2			ENDP			;-------------------------------------------------------------------;;  NAME:		MCSearchWait;;  PURPOSE:		To wait until device has completed search command.;;  PASSED:		McChannelNo		WORD	;channel number;;  RETURNED:	None;;-------------------------------------------------------------------MCSearchWait  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordNotDone			jsr CheckDone		;see if done			bcc NotDone			;loop until done			lda #0			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetPosition;;  PURPOSE:		To return current position of device;;  PASSED:		returned		LONG	;space for result;				McChannelNo		WORD	;channel number;				mcUnitType		WORD	;passed unit type;;  RETURNED:	CurrPos			LONG	;Current Position;;-------------------------------------------------------------------MCGetPosition PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3mcUnitType	wordChannelNo	wordCurrPos		long		;returned current position									lda #0			sta CurrPos,s				;init. returned curr. position			sta CurrPos+2,s						lda mcUnitType,s			cmp #InFrames			;want frames?			bne TryTime;-------------------------------------------------;;We return the Frame position here;;-------------------------------------------------NoError		lda #UnImpOutErr1		jmp Exit4TryTime			cmp #InTimes			bne TryChapters;--------------------------------------------------;;We get the time position here;;--------------------------------------------------			bra NoError			TryChapters			cmp #InChapters			bne WrongSpec;--------------------------------------------------;;We get the chapter position here;;--------------------------------------------------			bra NoErrorWrongSpec			lda #BadUnitTypeOutErrC1	jmp Exit4						ENDP;-------------------------------------------------------------------;;  NAME:		MCSetAudio;;  PURPOSE:		To control the audio portion;;  PASSED:		McChannelNo		WORD	;channel number;				AudioCtrl		WORD	;audio control command no.;;  RETURNED:	None;;-------------------------------------------------------------------MCSetAudio 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3AudioCtrl	wordChannelNo	word			lda AudioCtrl,s			;get audio control value			cmp #AudioOff			bne NotOff			lda #$005f				;set ESC			jsr SendCmd				;send command			lda #$0004				;set audio squelch			bra FinAudio			NotOff			cmp #AudioLeft			beq WantLeft			cmp #AudioLinLR			bne Not1OnWantLeft;First un-squelch (incase it was squelched before)			lda #$005f				;set ESC			jsr SendCmd				;send command			lda #$0005				;set normal (not squelched)			jsr SendCmd				;send command			lda #$004b				;set Audio 1/left			bra FinAudioNot1On			cmp #AudioRight			beq WantRight			cmp #AudioRinLR			bne Not2OnWantRight;First un-squelch (incase it was squelched before)			lda #$005f				;set ESC			jsr SendCmd				;send command			lda #$0005				;set normal (not squelched)			jsr SendCmd				;send command			lda #$0049				;set Audio 2/right			bra FinAudioNot2On			cmp #AudioStereo			bne NotAudioDefaultSt;First un-squelch (incase it was squelched before)			lda #$005f				;set ESC			jsr SendCmd				;send command			lda #$0005				;set normal (not squelched)			jsr SendCmd				;send command			lda #$004a				;set stereoFinAudio			jsr SendCmd				;send the command			lda #0					;return no errors			jmp	Exit4;Now see if its a valid audio commandNotAudio	cmp #AudioMonaural+1			ldx #BadAudio			;assume bad audio value			bcs ExitOut				;branch if bad audio value selected			ldx #UnImp				;else return unimplemented for this deviceExitOut		txa						;put error into a-reg.			jmp Exit4			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetTimes;;  PURPOSE:		To return time value;;  PASSED:		returned		LONG	;space for result;				McChannelNo		WORD	;channel number;				mcTimeSelect	WORD	;passed time info selector;;  RETURNED:	TimeInfo		LONG	;Time information;;-------------------------------------------------------------------MCGetTimes	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3mcTimeSelect wordChannelNo	wordTimeInfo	long		;returned time			lda #UnImp			;This routine is unimplemented in this driver			jmp Exit4			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetNoTracks;;  PURPOSE:		To return no. of tracks/chapters on the disc.;;  PASSED:		returned		WORD	;space for result;				McChannelNo		WORD	;channel number;;  RETURNED:	Tracks			WORD	;Tracks/Chapters on the disc;;-------------------------------------------------------------------MCGetNoTracks PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordTracks		word		;result no. of tracks/chapters						lda #UnImp			;This routine is unimplemented in this driver			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetDiscTOC;;  PURPOSE:		To get a discs TOC (Table of Contents);;  PASSED:		returned		LONG	;resultant BCD start of track value;				McChannelNo		WORD	;channel number;				TrackNo			WORD	;track no.;;  RETURNED:	DiscTOC			LONG	;BCD start of track value;;-------------------------------------------------------------------MCGetDiscTOC PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3TrackNo		wordChannelNo	wordDiscTOC		long				;resultant BCD start of track value						lda #UnImp			;This routine is unimplemented in this driver			jmp	Exit4			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetDiscID;;  PURPOSE:		To get a discs unique ID;;  PASSED:		returned		LONG	;space for result;				McChannelNo		WORD	;channel number;;  RETURNED:	DiscTOC			LONG	;Discs ID;;-------------------------------------------------------------------MCGetDiscID PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordDiscID		long		;returned discs ID						lda #UnImp			;This routine is unimplemented in this driver			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCRecord;;  PURPOSE:		To put the device in record mode;;  PASSED:		McChannelNo		WORD	;channel number;;  RETURNED:	None;;-------------------------------------------------------------------MCRecord  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	word			lda #UnImp			;This routine is unimplemented in this driver			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCStop;;  PURPOSE:		To stop the device;;  PASSED:		McChannelNo		WORD	;channel number;;  RETURNED:	None;;-------------------------------------------------------------------MCStop      PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	word			lda #$0016			jsr SendCmd			;now do a reject command			lda #0			jmp Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCWaitRawData;;  PURPOSE:		To wait for raw data from the device;;  PASSED:		McChannelNo		WORD	;channel number;				GSOSStringPtr	LONG	;pointer to gs/os resultant string tr.;				TickWait		Word	;no. of ticks before timeout error;				Term_Mask		Word	;terminal char. and mask char.;;  RETURNED:	None;;-------------------------------------------------------------------MCWaitRawData PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3Term_Mask	wordTickWait	wordGSOSString	long				;pointer to resultChannelNo	word			lda GSOSString,s			sta DP0			lda GSOSString+2,s			sta DP2			lda #0				;set transfer count to zero			ldy #2			sta [DP0],y			;set transfer count into GS/OS string			lda #UnImp			;return unimplemented error status			jmp Exit8			ENDP;-------------------------------------------------------------------;;  NAME:		MCSetVolume;;  PURPOSE:		To set the volume on the device;;  PASSED:		McChannelNo		WORD	;channel number;				LeftVolume		WORD	;Left volume value;				RightVolume		WORD	;Right volume value;;  RETURNED:	None;;-------------------------------------------------------------------MCSetVolume PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3RightVolume wordLeftVolume	wordChannelNo	word			lda #UnImp			;retun unimplemented			jmp Exit6			ENDP		END