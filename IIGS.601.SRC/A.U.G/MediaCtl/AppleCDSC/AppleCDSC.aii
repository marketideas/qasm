******************************************************************	This is the Apple CD-SC Multi Media Driver ******************************************************************	Copyright Apple Computer, Inc. 1989,1990*	All rights reserved.**	Programmed by: Dan Hitchens, Feb. 1990************************************************************************************************************************************************** Revision History** 1.0d9	4/4/90*DDH		-Changed aux type to media control driver aux type $0420 (the $20 part*			 reflects SCSI device.)*			-Just more development.** 1.0d11 4/26/90*DDH		-McSetAudio now works.*			-Changed the way McPlay works.** 1.0d12 5/24/90*DDH		-Added code to support time searches (not yet finished)*			-Fixed so MCDShutDown shuts down correctly without errors*        7/9/90;			-Added MCGetFeatures routine* 1.0d15 8/23/90*DDH		-Added code to set to end of disc when stop is set for play type commands*           -Added more code to MCGetFeatures*           -MCStop command to tables* 1.0d16 9/13/90*DDH		-Took out MCGetDiscTitle, MCSetDiscTitle,MCGetTrackTitle, MCSetTrackTitle,*			 MCGetProgram, and MCSetProgram.*           -McGetDiscID now works*           -McGetDiscTOC has changed and now works*			_McSearchTo now works correctly for track searches (pass track as binary)*			-Driver should now be alpha* 1.0d19 (DDH)*			-Changed MCGetName, MCGetSpeeds to pass the string pointer to*			 where you want the resutant string to go instead of using TML*			 pascal's string function method.** 1.0d20 (DDH)*			-Fixed MCControl where mcCUnLockDev and mcCLockDev didn't work.*			-Changed MCPlay command to always check for playing before start of*			 audio part of disc (searchs are not accurate and can place head*			 before start of audio portion +-75 frames. If before audio portion we now*			 set it to the start of the audio portion.*			-Fixed MCJogN bug where it was crashing because it did an EXIT12*			 instead of an EXIT10.*			-Rewrote MCJogN inTimes to work correctly (was giving strange errors.)** D21 (DDH)*			-Fixed MCGetname to be restartable.** D23 (DDH)*			-Added MCWaitRawData call (was left out for some reason.)*			-Added MCSetVolume call*			-Fixed so will default to not report disk switched errors.*			-MCGetFeatures (mcFVolume will return 0=old CD drive, 1=new CD drive)** D24 (DDH)*			-Added jsl DecBusyFlg routine to dynamic exits because were not reenterant.*			-Fixed bugs in MCJog where it would only allow jogging max of seven*			 tracks (took out and #0007?)*			-Fixed bug where MCJog was returning $2612 for min., sec. equal zero*			 (was only checking low 16-bits for zero, should have check all 32 bits.)** D28 (DDH)*			-Fixed MCGetStatus where it wasn't able to determine the play status*			 when it played to the end of the disc.  (we now returned still)** D31 (DDH)*			-Fixed mixed mode CD problems with $FE02, $7E02, and $00f1 errors.** D35 (DDH)*			-Fixed MCGetTimes, remaining disk returning incorrect values.*			-McGetStatus calls will now return offline, diskswitched etc. errors.** F3 (DDH)*			-Fixed McJogN with chapters not joging correctly backwards** F4 (DDH*			-Fixed McJogN when at the last track problem.********************************************************************************			include 'all.macros'			include 'E16.GSOS'						Entry	EntryStuff			Entry	MCGetName			Entry	MCDStartUp			Entry	MCDShutDown			Entry	MCGetFeatures			Entry	MCPlay			Entry	MCPause			Entry	MCSendRawData			Entry	CvtTime2ASCII			Entry	MCGetStatus			Entry	MCControl			Entry	MCScan			Entry	MCGetSpeeds			Entry	MCSpeed			Entry	MCStopAt			Entry	MCJogN			Entry	McSearchTo			Entry	McSearchDone			Entry	McSearchWait			Entry	MCGetPosition			Entry	McSetAudio			Entry	McGetTimes			Entry	McGetNoTracks			Entry	McGetDiscTOC			Entry	McGetDiscID			Entry	McRecord			Entry	McStop			Entry	McWaitRawData			Entry	McSetVolume						Entry	CR			Entry	ScratchStr			Entry	MyBCDTime			Entry	CurrSpeed			Entry	BlankNextVideo			Entry	AudioMode			Entry	AudioSField			Entry	GetAudioStat			Entry	PlayAtCurr			Entry	DoPause			Entry	StopFlag			Entry	TOCData			Entry	StopType			Entry	StopAddr			Entry	StopDNum			Entry	StopDCtrlBlk			Entry	DSFlag             	***************************************************************** Direct page equates****************************************************************DirectStack	equ 10DS3			equ	DirectStack+3	;direct stack plus phd and phbDirectPage	equ 0DP0			equ 0DP1			equ 1DP2			equ 2DP3			equ 3DP4			equ 4DP5			equ 5DP6			equ 6DP7			equ 7DP8			equ 8DP9			equ 9DataTrack	equ $00f1DataTrack2	equ $fe02DataTrack3	equ $7e02***************************************************************** Equates****************************************************************DecBusyFlg 	equ $e10068				;Dec. busy flag routineVersionNo	equ $0100	;version no. 1.00InChapters	equ 1InFrames	equ 2InTimes		equ 3;------------------------------;Control values for MCControl;------------------------------mcCInit		equ 1					;initilize playermcCEject	equ 2					;eject discmcCVideoOn	equ 3					;turn video onmcCVideoOff	equ 4					;turn video offmcCDisplayOn equ 5					;turn video position display offmcCDisplayOff equ 6					;turn vidoe position display onmcCBlankVideo equ 7					;blank video for next MCSearchTomcCDefaultCom equ 8					;set default communicationsmcCLockDev 	equ 9		 			;set the device to lockedmcCUnLockDev equ 10					;unlock the devicemcC8Data1Stop equ 40				;set 8-data 1-stop bitmcC7Data1Stop equ 41				;set 7-data 1-stop bitmcC6Data1Stop equ 42				;set 6-data 1-stop bitmcC5Data1Stop equ 43				;set 5-data 1-stop bitmcC8Data2Stop equ 44				;set 8-data 2-stop bitmcC7Data2Stop equ 45				;set 7-data 2-stop bitmcC6Data2Stop equ 46				;set 6-data 2-stop bitmcC5Data2Stop equ 47				;set 5-data 2-stop bitmcCBaudDflt	equ 50					;set baud rate to control panel settingmcCBaud50	equ 51					;set 50 baudmcCBaud75	equ 52					;set 75 baudmcCBaud110	equ 53					;set 110 baudmcCBaud134	equ 54					;set 134.5 baudmcCBaud150	equ 55					;set 150 baudmcCBaud300	equ 56					;set 300 baudmcCBaud600	equ 57					;set 600 baudmcCBaud1200	equ 58					;set 1200 baudmcCBaud1800	equ 59					;set 1800 baudmcCBaud2400 equ 60					;set 2400 baudmcCBaud3600	equ 61					;set 3600 baudmcCBaud4800 equ 62					;set 4800 baudmcCBaud7200	equ 63					;set 7200 baudmcCBaud9600 equ	64					;set 9600 baudmcCBaud19200 equ 65					;set 19200 baudmcCModem	equ 100					;set to modem portmcCPrinter	equ 101					;set to printer portmcCIgnoreDS	equ 200					;Ignore disk switched errors (dont report them to user)mcCReportDS	equ 201					;Report disk switched errors to user;------------------------------;Status values for MCGetStatus;------------------------------mcSUnknown		equ 0				;player unable to determine this statusmcSDeviceType	equ $0000			;device type selectormcSLaserDisc	equ 1mcSCDAudio		equ 2mcSLaserCD		equ 3mcSVCR			equ 4mcSCamCorder	equ 5mcSPlayStatus	equ $0001			;play status selector valuemcSPlaying		equ 1mcSStill		equ 2mcSParked		equ 3mcSDoorStatus	equ $0002			;players door statusmcSDoorOpen		equ 1mcSDoorClosed	equ 2mcSDiscType		equ	$0003			;disc type selector valuemcS_CLV			equ 1mcS_CAV			equ	2mcS_CDV			equ 3mcS_CD			equ 4mcSDiscSize		equ $0004			;disc size selector valuemcSDisc3inch	equ 3mcSDisc5inch	equ 5mcSDisc8inch	equ 8mcSDisc12inch	equ 12mcSDiscSide		equ $0005			;disc side selector valuemcSSideOne		equ 1mcSSideTwo		equ 2mcSVolumeL		equ $0006			;left volume valuemcSVolumeR		equ $0007			;right volume value;------------------------------;Audio values;------------------------------AudioOff	equ 0		;Audio OffAudioRight	equ 1		;Audio Right channel onlyAudioLinR	equ 2		;Audio left in right onlyAudioMinR	equ 3		;Audio mixed in right onlyAudioRinL	equ 4		;Audio right in left onlyAudioRinLR	equ 5		;Audio right in left and rightAudioReverse equ 6		;Audio right in left, left in rightAudioRinLMR	equ 7		;Audio right in left, mixed in rightAudioLeft	equ 8		;Audio left channel onlyAudioStereo	equ 9		;Audio Both Channels (Stereo)AudioLinLR	equ 10		;Audio left in left and rightAudioLinLMR	equ 11		;Audio left in left, mixed in rightAudioMinL	equ 12		;Audio mixed in left onlyAudioMinLRinR equ 13	;Audio mixed in left, right in rightAudioMinLLinR equ 14	;Audio mixed in left, left in rightAudioMonaural equ 15	;Audio mixed in left and right (monaural);------------------------------;McGetTimes values;------------------------------mcElapsedTrack equ 0	;Elapsed time on current track/chaptermcRemainTrack equ 1		;Remaining time on curr. track/chaptermcElapsedDisc equ 2		;Elapsed time on discmcRemainDisc equ 3		;Remaining time on discmcTotalDisc	equ 4		;Total run time on discmcTotalFrames equ 5		;Returns total no. of frames on discmcTracks	equ 6		;Returns the first and last track numbersmcDiscID	equ 7		;Returns a disc identifier***************************************************************** Error Equates****************************************************************UnImp		equ $2601			;Unimplemented for this deviceNotApplic	equ UnImp			;Not applicable to this deviceBadSpeed	equ $2602			;Invalid speed specifiedBadUnitType	equ $2603			;Invalid unit type specifiedTimeOutErr	equ $2604			;Timed out during device readNotLoaded	equ $2605			;Driver was not loaded?BadAudio	equ $2606			;Invalid Audio ValueDevRtnError	equ $2607			;Device returned error (unable to perform)UnRecStatus	equ $2608			;Unrecognizable status from deviceBadSelector	equ $2609			;Invalid selector value specifiedFunnyData	equ	$260a			;funny data receive (retry again)InvalidPort	equ $260b			;invalid port specifiedOnlyOnce	equ $260c			;scans only onceNoResMgr	equ $260d			;Resource manager not activeItemNotFound equ $260e			;Item Not found in databaseWasShutdown equ $260f			;tool was already shutdownWasStarted	equ $2610			;tool was already startedBadChannel	equ $2611			;invalid channel numberInvalidParam equ $2612			;Invalid ParameterCallNotSupported equ $2613		;call not supported error***************************************************************** Driver Header and Vectors Routine****************************************************************AppleCDSCDrvr PROC			longi on			longa on			DC.W	0				;Driver Marker			DC.W	(EndVector-DriverVtrs)/4	;count of calls supported			jmp		EntryStuff			DC.W	VersionNo			;Drivers version number (version 1.0)			str 'AppleCDSC'				;Drivers name						Export DriverVtrsDriverVtrs			DC.L	MCGetName			;0 Gets the drivers name and version			DC.L	MCDStartUp			;1 Starts up the driver			DC.L	MCDShutDown			;2 Shuts down the driver			DC.L	MCGetFeatures		;3 Gets features			DC.L	MCPlay				;4 Play the device			DC.L	MCPause				;5 Pause device			DC.L	MCSendRawData		;6 Send raw data to the device			DC.L	MCGetStatus			;7 Return device status info			DC.L	MCControl			;8 Sets device control info			DC.L	MCScan				;9 Scan forward or reverse			DC.L	MCGetSpeeds			;10 Returns Valid Speeds			DC.L	MCSpeed  			;11  Sets Speed for MCPlay			DC.L	MCStopAt			;12  Sets stopping point			DC.L	MCJogN				;13  Jog device n units			DC.L	MCSearchTo			;14  Search to location			DC.L	MCSearchDone		;15  Status of if done			DC.L	MCSearchWait		;16  Waits for search to finish			DC.L	MCGetPosition		;17  Returns current position			DC.L	MCSetAudio			;18  Controls audio			DC.L	MCGetTimes			;19  Gets disc times			DC.L	MCGetDiscTOC		;20  Gets discs table of contents			DC.L	MCGetDiscID			;21  Gets discs ID			DC.L	MCGetNoTracks		;22	 Gets discs no. of tracks			DC.L	MCRecord			;23	 Puts device into record mode			DC.L	MCStop				;24  Stops the device			DC.L	MCWaitRawData		;25  Waits for raw data			DC.L	MCSetVolume			;26  Sets the volumeEndVector			ENDP			longi on			longa on;-------------------------------------------------------------------;;  NAME:		EntryStuff;;  PURPOSE:		To save registers and setup direct page on stack space;;  PASSED:		(X-reg.)= offset into "GPortVtrs" to called routine;;  RETURNED:	None (vectors directly to called routine);;-------------------------------------------------------------------EntryStuff	PROC			Definestack			phd							;save direct page			phb							;save bank register;set bank register (B-reg.) to programs bank (K-register)			phk			plb;reserve 10 bytes from stack for direct page			tsc							;get stack value			sec			sbc #DirectStack			;reserve 10 bytes for d-page			tcs			inc a						;inc. by one for d-page start			tcd							;set direct page address			jmp (DriverVtrs,x)			;vector to called routine			ENDP;------------------------------------------------------------------------------;------------------------------------------------------------------------------;; Dynamic Exits;;; Each dynamic exit	takes 2 RTL's and moves them some number of bytes up the; stack.;;------------------------------------------------------------------------------;-----------------------------------------------------------------------------DynamicExits	PROC EXPORT	EXPORT exit20exit20	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+25,s	lda DS3+3,s	sta DS3+23,s	lda DS3+1,s	sta DS3+21,s	tsc	clc	adc #20	tcs	brl exit0x	EXPORT Exit16Exit16	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+21,s	lda DS3+3,s	sta DS3+19,s	lda DS3+1,s	sta DS3+17,s	tsc	clc	adc #16	tcs	brl Exit0x	EXPORT Exit14Exit14	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+19,s	lda DS3+3,s	sta DS3+17,s	lda DS3+1,s	sta DS3+15,s	tsc	clc	adc #14	tcs	brl Exit0x	EXPORT Exit12Exit12	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+17,s	lda DS3+3,s	sta DS3+15,s	lda DS3+1,s	sta DS3+13,s	tsc	clc	adc #12	tcs	brl Exit0x	EXPORT Exit10Exit10	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+15,s	lda DS3+3,s	sta DS3+13,s	lda DS3+1,s	sta DS3+11,s	pla	pla	pla	pla	pla	brl exit0x	EXPORT Exit8Exit8	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+13,s	lda DS3+3,s	sta DS3+11,s	lda DS3+1,s	sta DS3+9,s	pla	pla	pla	pla	brl Exit0x	EXPORT Exit6Exit6	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+11,s	lda DS3+3,s	sta DS3+9,s	lda DS3+1,s	sta DS3+7,s	pla	pla	pla	brl Exit0x	EXPORT Exit4Exit4	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+9,s	lda DS3+3,s	sta DS3+7,s	lda DS3+1,s	sta DS3+5,s	pla	pla	bra Exit0x	EXPORT Exit2Exit2	tax;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcd	lda DS3+5,s	sta DS3+7,s	lda DS3+3,s	sta DS3+5,s	lda DS3+1,s	sta DS3+3,s	pla	bra Exit0x;;This clears up the stack and restores registers;	EXPORT Exit0Exit0	tax						;save A-reg in X-reg;Restore B-reg.	lda DirectStack,s		;get saved B-reg. into bits 7-4	pha						;save onto stack	plb						;get rid of 8-bits	plb						;now restore the b-register	;Restore D-reg.	lda DirectStack+2,s	tcdExit0x;Get rid of direct page from stack	tsc						;get stack pointer	clc	adc #DS3				;take out direct page area and D & B reg. saves	tcs		txa						;restore A-reg.;Dec. busy flag because were not reentereant	pha						;save error for return	jsl DecBusyFlg			;dec. busy flag	pla						;restore error	cmp #1					;sets carry if A-reg. not zero	rtl	ENDP;-------------------------------------------------------------------;;  NAME:		MCGetName;;  PURPOSE:		Returns the drivers name and version number.;;  PASSED:		McChannelNo		WORD	;channel number;				NameStrPtr		LONG	;string buffer ptr to returned driver name & version no.;;;  RETURNED:	NONE;-------------------------------------------------------------------MCGetName 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3RetName 	longChannelNo	word;Copy over the name and version of the driver			PushLong #DriverNamStr;Get the destiniation from the passed RetName			lda RetName+6,s			pha			lda RetName+6,s			pha;Now get the no. of bytes from the string			lda #0			pha			lda DriverNamStr	;get length of string			and #$00ff			;mask only length			inc a				;for length byte			pha			_blockmove			;move it			lda #0			jmp Exit6			;NOTE: ConnectPort must follow DriverNamStr (dont add anything between.)			EXPORT DriverNamStrDriverNamStr str 'MCToolkit AppleCDSC 1.0'			EXPORT ConnectPortConnectPort	dcb.b 36,0			;Connected ports name(stuffed by MCDStartUp)			EXPORT DriverNLenDriverNLen	dc.w ConnectPort-DriverNamStr-1			ENDP;-------------------------------------------------------------------;;  NAME:		MCDStartUp & MCDShutdown;;  PURPOSE:		Initializes and starts up the media device driver;;  PASSED:		McChannelNo		WORD	;channel number;				PortNamePtr		LONG	;pointer to port name string;				UserID			WORD	;drivers userid;;  RETURNED:	None;;-------------------------------------------------------------------MCDStartUp 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3USERID		wordPortNamePtr	longChannelNo	word;First lets see if its already been opened			lda BeenOpen			beq NotOpened		;branch if not open			brl AlreadyOpen		;jmp if already opened			;Now init. a few thingsNotOpened			lda USERID,s			sta DUserID			;save drivers userid						lda #0				;init. device number to zero			sta DIDevNum			sta CloseRefNum		;init to zero incase we dont open ok;First copy over the selected ports name for MCGetName			lda PortNamePtr+2,s	;get the high bytes of pointer			pha			lda PortNamePtr+2,s	;get the low bytes of pointer			pha			pushlong #ConnectPort	;destination			pushlong #36		;no. of bytes to move			_blockmove			;move it;Now adjust the string length bytes and put a blank in the ports length			lda ConnectPort		;get port name length			and #$00ff			;only want length			sec					;because we want one more (for blank)			adc DriverNLen		;add to drivers name length			sep #$30			;8-bit mode			sta DriverNamStr			rep #$30			;back to 16-bit mode			lda ConnectPort			and #$ff00			;and out ports length byte			ora #$0020			;or in a blank char.			sta ConnectPort;Now copy over the selected ports name for opening.			lda PortNamePtr+2,s	;get the high bytes of pointer			pha			lda PortNamePtr+2,s	;get the low bytes of pointer			pha			pushlong #DIDevName+3	;destination			pushlong #36		;no. of bytes to move			_blockmove			;move it						lda DIDevName+3		;now convert from P-string to GS/OS string			and #$00ff			sta DIDevName+2			beq InvalErr		;branch if null name specified;Now see what was specified (GS/OS device name starts with period) or (M) or (P)			lda DIDevName+4			and #$007f			cmp #46				;see if its a period			bne InvalErr		;error if not;We arrive here if it starts with a period (GS/OS device);Now we need to determine the device number from its device name			_GetDevNumberGS MyDevNumBlk			bcs errOutjmp		;branch if error			lda MyGetDevID		;get the returned device ID			bra SelGSOSDev		;branch if selected a gsos device			InvalErr	lda #InvalidPorterrOutjmp	jmp NotFound		;else return with invalid port error;We arrive here when we have found the ports device IDSelGSOSDev			sta MyDevID			;save it for now			inc BeenOpen;Now that its opened			lda DIDevNum			sta CtrlDevNum		;stuff device numberAlreadyOpen			lda #0NotFound        	jmp Exit8			;--------------------------------------------------------------------; MCDShutDown Code;--------------------------------------------------------------------			EXPORT MCDShutDownMCDShutDown			lda #0;			ldx CloseRefNum		;get the opened files ref. no.;			beq DidntOpen		;branch if never opened			sta BeenOpen		;clear flag so we know its closed			;			_CloseGS MyCloseBlk	;close the opened fileDidntOpen			jmp Exit2			;=====================================================================BeenOpen	dc.w	0			;flag to determine if this driver is open (0=closed)			EXPORT DUserIDDUserID		dc.w	0			;saved drivers userid			EXPORT MyDevIDMyDevID		dc.w	0			;saved opened device IDMyError		dc.w	0WantGSID	dc.w	0			;wanted GSOS device ID;=====================================================================DInfoBlock	dc.w	8			;Passed parameter count (PCount)DIDevNum	dc.w	0			;Passed Device Number			dc.l	DIDevName	;Passed Addr. of returned device nameDIstics		dc.w	0			;returned characteristicsDITotalBlks	dc.l	0			;returned total no. of blocksDISlotNo	dc.w	0			;returned slot no.DIUnitNo	dc.w	0			;returned unit no.DIVersion	dc.w	0			;returned version no.DIDevID		dc.w	0			;returned device IDDIDevName	dc.w	36			;GSOS returned device name string			dcb.b	38,0;-------------------------MyDevNumBlk	dc.w	2			;Passed PCount			dc.l	DIDevName+2	;passed addr. of device nameMyGetDevID	dc.w	0			;returned device ID;-------------------------			EXPORT MyOpenBlkMyOpenBlk	dc.w	3			;Passed PCountMyRefNum	dc.w	0			;Returned File reference number			dc.l	DIDevName+2	;Address of device name			dc.w	3			;Passed requestAccess (Read, Write);-------------------------MyCloseBlk	dc.w	1			;Passed PCountCloseRefNum	dc.w	0			;Stuffed opened file ref. number;-------------------------MyCtrlBlk	dc.w	5			;Passed PCountCtrlDevNum	dc.w	0			;Stuffed device control numberCtrlCode	dc.w	$0004		;SetWaitStatusCtrlList	dc.l	MyCtrlList	;Control list addr.				dc.l	2			;request count			dc.l	0			;Returned transfer countMyCtrlList	dc.w	$8000		;Set to No Wait Mode;-------------------------MyReadBlk	dc.w	4			;Passed PCountReadRefNum	dc.w	0			;Stuffed Ref. number			dc.l	RBuffer 	;Read Buffer Address			dc.l	1			;Read Request countReadXCount	dc.l	0			;Returned transfer countRBuffer 	dc.w	0			;Read buffer area (room for one byte);-------------------------			ENDP;-------------------------------------------------------------------;;  NAME:		MovePString;;  PURPOSE:		To Move a P-String indirectly from DP0 to DP2;;  PASSED:		DP4			;pointer to p-string destination area;				DP0			;pointer to p-string source area;;  RETURNED:	None;;-------------------------------------------------------------------MovePString PROC			;Now Send the Data back			sep #$30				;set to 8-bit mode			longa off			longi off			lda [DP0]				;get source strings length			tay			iny			CopyLoop	dey			lda [DP0],y			sta [DP4],y			cpy #0			bne CopyLoop			longa on			longi on			rep #$30			rts			ENDP;-------------------------------------------------------------------;;  NAME:		CvtTime2ASCII;;  PURPOSE:		To convert a BCD time value to an ASCII string.;				Long of MMSSFF00 BCD to MMSSFF ASCII string;;  PASSED:		Stuffed MyBCDTime (LONG) with BCD time value to convert;;  RETURNED:	ScratchStr will have the resultant ASCII P-string;;-------------------------------------------------------------------CvtTime2ASCII PROC			;Now do the real work in 8-bit mode			sep #$30				;set to 8-bit mode			longa off			longi off			lda #6			sta ScratchStr			;init byte count;First do minutes (tens position)			lda MyBCDTime			lsr A			lsr A			lsr A			lsr A			ora #$30				;make ascii			sta ScratchStr+1;Now do minutes (ones position)			lda MyBCDTime			and #$0f			ora #$30			sta ScratchStr+2;Now do Seconds (tens position)			lda MyBCDTime+1			lsr A			lsr A			lsr A			lsr A			ora #$30			sta ScratchStr+3;Now do Seconds (ones position)			lda MyBCDTime+1			and #$0f			ora #$30			sta ScratchStr+4;Now do frames (tens position)			lda MyBCDTime+2			lsr A			lsr A			lsr A			lsr A			ora #$30			sta ScratchStr+5;Now do frames (ones position)			lda MyBCDTime+2			and #$0f			ora #$30			sta ScratchStr+6			longa on			longi on			rep #$30				;set 16-bit mode			rts						EXPORT MyBCDTimeMyBCDTime	dc.l	0				;storage space for BCD Time			EXPORT ScratchStrScratchStr	ds.b	256				;scratch string space area			ENDP;-------------------------------------------------------------------;;  NAME:		GetLocation;;  PURPOSE:		To get the current Q-Subcode location from the disc;;  PASSED:		None;;  RETURNED:	Carry=set if error; (A-reg.)=error number;;-------------------------------------------------------------------GetLocation PROC			lda MyDevID			sta QSubDNum		;set device number						_DStatusGS QSubDStatBlk ;perform an ReadQSubcode call			rts;=====================================================================;This is the DControl data blockQSubDStatBlk dc.w	5			;Passed parameter count (PCount)QSubDNum	dc.w	0			;Passed device number (Stuffed)QSubCode	dc.w	$80C2		;Passed code (ReadQSubcode)			dc.l	QSubList	;Passed list pointer			dc.l	9			;Passed request count			dc.l	0			;Returned transfer count;This is the status control listQSubList	dc.w	0			;Passed zeros (reserved)			dc.b	$C2			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$00			; 2 			dc.b	$00			; 3 			dc.l	0			; 4 			dc.b	0			; 8 			dc.b	0			; 9 			dc.w	0			; 10 			dc.l	QSubData	;Buffer Pointer			QSubData			EXPORT QCtrlField		QCtrlField	dc.b	0			EXPORT QTrackQTrack		dc.b	0			EXPORT QIndexQIndex		dc.b	0			EXPORT QMinQMin		dc.b	0			EXPORT QSecQSec		dc.b	0			EXPORT QFrameQFrame		dc.b	0			EXPORT QAMinQAMin		dc.b	0			EXPORT QASecQASec		dc.b	0			EXPORT QAFrameQAFrame		dc.b	0			ENDP;-------------------------------------------------------------------;;  NAME:		GetTOC;;  PURPOSE:		To get the table of contents from the disc;;  PASSED:		(A-reg.)= TOCType byte;;  RETURNED:	Carry=set if error; (A-reg.)=error number;;-------------------------------------------------------------------GetTOC PROC			sta TOCType			;save type						lda MyDevID			sta TOCDNum			;set device number						_DStatusGS ReadTOCBlk ;perform a ReadTOC call			rts;=====================================================================;This is the DControl data blockReadTOCBlk 	dc.w	5			;Passed parameter count (PCount)TOCDNum		dc.w	0			;Passed device number (Stuffed)TOCCode		dc.w	$80C1		;Passed code (ReadQSubcode)			dc.l	TOCList		;Passed list pointer			dc.l	4			;Passed request count			dc.l	0			;Returned transfer count;This is the status control listTOCList		dc.w	0			;Passed zeros (reserved)			dc.b	$C1			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			EXPORT TOCTrackTOCTrack	dc.b	$00			; 2 Track number			EXPORT TOCByte3TOCByte3	dc.b	$00			; 3 			dc.b	0			; 4TOCType		dc.b	$40			; 5 TOC type byte			dc.b	0			; 6			EXPORT TOCByte7TOCByte7	dc.b	0			; 7			dc.b	0			; 8 			dc.b	0			; 9 			dc.w	0			; 10 			dc.l	TOCData		;Buffer Pointer						EXPORT TOCDataTOCData			dc.l	0			;table of contents data area			ENDP;-------------------------------------------------------------------;;  NAME:		GetAudioStat;;  PURPOSE:		To get the current audio status;;  PASSED:		(A-reg.)= Status Type, (0=regular, 1=audio volume);;  RETURNED:	Carry=set if error; (A-reg.)=error number;;-------------------------------------------------------------------GetAudioStat PROC			sta StatusType			lda MyDevID			sta AudioDNum		;set device number						_DStatusGS AudioStatBlk ;perform an AudioStatus call			rts;=====================================================================;This is the DControl data blockAudioStatBlk dc.w	5			;Passed parameter count (PCount)AudioDNum	dc.w	0			;Passed device number (Stuffed)AudioSCode	dc.w	$80CC		;Passed code (AudioStatus)			dc.l	AudioList	;Passed list pointer			dc.l	6			;Passed request count			dc.l	0			;Returned transfer count;This is the status control listAudioList	dc.w	0			;Passed zeros (reserved)			dc.b	$CC			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$00			; 2 StatusType	dc.b	$00			; 3 			dc.l	0			; 4 			dc.b	0			; 8 			dc.b	0			; 9 			dc.w	0			; 10 			dc.l	AudioSData	;Buffer Pointer			AudioSData			EXPORT AudioSFieldAudioSField	dc.b	0			;Audio Status Field			dc.b	0			;Audio Play Mode			dc.b	0			;Audio Control Field of next track			dc.b	0			;Current Q-subcode (AMIN)			dc.b	0			;Current Q-subcode (ASEC)			dc.b	0			;Current Q-subcode (AFRAME)						ENDP;-------------------------------------------------------------------;;  NAME:		BCD2Dec;;  PURPOSE:		To convert a BCD to binary;;  PASSED:		(A)=word of BCD value to convert;;  RETURNED:	(A)=binary value;;-------------------------------------------------------------------BCD2Dec 	PROC			sta SaveIt;First do ones digit			and #$000f			sta MyDecVal	;init and set to ones digit;Now tens digit			lsr SaveIt		;only rotate 3 bits (because word table)			lsr SaveIt			lsr SaveIt			lda SaveIt			and #$001E			tax				;use as index			lda X10,x		;get binary value			clc			adc MyDecVal	;add it in			sta MyDecVal;Now hundreds digit			lsr SaveIt		;rotate 4-bits			lsr SaveIt			lsr SaveIt			lsr SaveIt			lda SaveIt			and #$001E			tax				;use as index			lda X100,x		;get binary value			clc			adc MyDecVal	;add it in			sta MyDecVal			;Now thousands digit			lsr SaveIt		;rotate 4-bits			lsr SaveIt			lsr SaveIt			lsr SaveIt			lda SaveIt			and #$001E			tax				;use as index			lda X1000,x		;get binary value			clc			adc MyDecVal	;add it in			sta MyDecVal						rts			SaveIt		dc.w	0		;save area for BCD valueMyDecVal	dc.w	0		;converted decimal valueX10			dc.w	0			dc.w	10			dc.w	20			dc.w	30			dc.w	40			dc.w	50			dc.w	60			dc.w	70			dc.w	80			dc.w	90X100		dc.w	0			dc.w	100			dc.w	200			dc.w	300			dc.w	400			dc.w	500			dc.w	600			dc.w	700			dc.w	800			dc.w	900x1000		dc.w	0			dc.w	1000			dc.w	2000			dc.w	3000			dc.w	4000			dc.w	5000			dc.w	6000			dc.w	7000			dc.w	8000			dc.w	9000			ENDP;-------------------------------------------------;;	Name:		AddTime;;	Purpose:	To add passed value to AddData;;	Passed:		(X,A-reg.) BCD Value (HHMMSSFF);				stuff AddData with value to add (HHMMSSFF);;	Returned:	(X,A-reg.) BCD Value (HHMMSSFF);-------------------------------------------------AddTime	PROC;Do this because 65816 stores low then high		xba		sta AddData2+2		txa		xba		sta AddData2;Now do the add		sep #$38			;put into BCD 8-bit mode		longa off		longi off;;First do the Frames (0-74);		lda AddData+3		clc		adc AddData2+3		bcs CT1;If no carry thru, then check to see if over 74		cmp #$75		bcc NCT1			;branch if less than		sec		sbc #$75			;if over, subtract out diff.		sec					;make sure carry is set		bra NCT1;If we have a carry thru then we need to add 25CT1		adc #$24			;remember carry is set		sec		NCT1	sta AddData2+3	;;Now do the Seconds (0-59);		lda AddData+2		adc AddData2+2		bcs CT2;If no carry thru, then check to see if over 59		cmp #$60		bcc NCT2			;branch if less than		sec		sbc #$60			;if over, subtract out diff.		sec					;make sure carry is set		bra NCT2;If we have a carry thru then we need to add 40CT2		adc #$39			;remember carry is set		sec		NCT2	sta AddData2+2;;Now do the Minutes (0-99);		lda AddData+1		adc AddData2+1NCT3	sta AddData2+1		rep #$38			;back to 16-bits and binary mode		longa on		longi on		lda AddData2		xba		tax		lda AddData2+2		xba		rts		EXPORT AddData		AddData	ds.l	1			;The add data area		EXPORT AddData2AddData2 ds.l	1			;The other add data area		ENDP		;-------------------------------------------------;;	Name:		SubTime;;	Purpose:	To subtract passed value from AddData;;	Passed:		(X,A-reg.) BCD Value (HHMMSSFF);				stuff AddData with value to add (HHMMSSFF);;	Returned:	(X,A-reg.) BCD Value (HHMMSSFF);-------------------------------------------------SubTime	PROC;Do this because 65816 stores low then high		xba		sta AddData2+2		txa		xba		sta AddData2;Now do the add		sep #$38			;put into BCD 8-bit mode		longa off		longi off;;First do the Frames (0-74);		lda AddData+3		sec		sbc AddData2+3		bcs NCT1;If carry=0 then subtract 75		sec		sbc #$25		clcNCT1	php					;save carry;if greater than 75 then we must subtract out 25		cmp #$75		bcc XT1		sec		sbc #$25XT1		plp		sta AddData2+3	;;Now do the Seconds (0-59);		lda AddData+2		sbc AddData2+2		bcs NCT2;If carry=0 then subtract 40		sec		sbc #$40		clcNCT2	php					;save carry;if greater than 60 then we must subtract out 40		cmp #$60		bcc XT2		sec		sbc $40XT2		plp		sta AddData2+2	;;Now do the Minutes (0-99);		lda AddData+1		sbc AddData2+1		bcs NCT3;If carry=0 then subtract 40		sec		sbc #$40		clcNCT3XT3				sta AddData2+1			rep #$38			;back to 16-bits and binary mode		longa on		longi on		lda AddData2		xba		tax		lda AddData2+2		xba		rts		ENDP		;-------------------------------------------------------------------;;  NAME:		RidStop;;  PURPOSE:		To get rid of stop location;;  PASSED:		(A-reg.)			WORD	;media channel no.;;  RETURNED:	Carry=set if error; (A-reg.)=error number;;-------------------------------------------------------------------RidStop		PROC;We now check to see if we've set a stop condition just before this command;If we have, Inc. stop flag one so we will know that the next time we do a;play type command that we need to reset the stop condition to the end of the;disk.			sta ChannelNo			;save passed channel no.			lda stopflag			;get stop flag			beq noprev				;branch if no previous stop (return no errors);There has been a previous stop condition			cmp #1			bne notfirst			;branch if more than first one			inc stopflag			;inc. so we will know we've done one			bra noprev;We arrive here when we have done more than one play type command, we need to reset;stop condition to the end of the discnotfirst			lda #$0040				;for absolute BCD Min-Sec-Frame			jsr GetTOC				;go get end of audio portion			bcs goterrx				;branch if errors;Now dec. by one the TOC lead out area number;Remeber: The BCD digits are stored high to low at TOCData,+1,+2 only.			sep #$38				;to 8-bit mode with decimal mode			longa off			longi off			sec			lda TOCData+2			sbc #1					;subtract one			sta TOCData+2			lda TOCData+1			sbc #0			sta TOCData+1			lda TOCData			sbc #0			sta TOCData;Now go through and fix time borrow problems			lda TOCData+2			cmp #$75			bcc Ok1			sbc #$25				;we know carry is set from branch			sta TOCData+2Ok1			lda TOCData+1			cmp #$60			bcc Ok2			sbc #$40				;we know carry is set from branch			sta TOCData+1Ok2			rep #$38				;back to 16-bit and binary mode			longa on			longi on						lda #$0040				;set for absolute time stop			sta StopType			lda MyDevID				;set the device ID			sta StopDNum			lda TOCData-1			;minus one for min. in high byte (so stores zero)			and #$FF00				;only want minutes (high byte)			sta StopAddr			lda TOCData+1			sta StopAddr+2			_DControlGS StopDCtrlBlk ;perform a stoplocation 			bcs goterrX				;branch if got error (so will try again)			stz StopFlaggoterrX			rtsnoprev			lda #0			clc			rts		ChannelNo	ds.w	1				;space for pased MCChannel number			ENDP;;-------------------------------------------------------------------;;  NAME:		PlayAtCurr;;  PURPOSE:		To start playing at current location;;  PASSED:		None;;  RETURNED:	Carry=set if error; (A-reg.)=error number;;-------------------------------------------------------------------PlayAtCurr 	PROC						lda #3			sta RetryIt				;set retry counter to 3PlayAgain						lda AudioMode			;get audio mode			sta PlayAudioM			;set the audio mode here			lda MyDevID			sta PlayDNum			;set device number			jsr GetLocation			;go get current location			bcs XOut2				;branch if error occured			lda QAMin-1				;get absolute location			and #$ff00			sta PlayBackAdr			;stuff for play command			lda QAMin+1			sta PlayBackAdr+2;First check to see if we are before the first track of the disc			lda #1TryFirst			sta TOCTrack			;set the track no.			lda #$0004			sta TOCByte7			;set size of buffer to long (4 bytes)			lda #$0080				;for track starting address			jsr GetTOC				;go get track start			ldx TOCTrack			;get current track			stz TOCTrack			;zero out track no.			stz TOCByte7			;zero out length words			bcs XOutOfPlayC			;branch if error occured			lda TOCData			and #$000D				;only want control field			cmp #$0004				;see if data track			bne IsAudio				;branch if audio track;We arrive here with a digital track for the first track;So inc. by one until we hit an error or an audio track			sep #$38				;to 8-bit mode with decimal mode			longa off			longi off			txa						;get current track no.			clc			adc #1			sta TOCTrack			rep #$38				;back to 16-bit binary mode			longa on			longi on						bne TryFirst			;loop unless carry through			lda #DataTrackXout2		bra XOutOfPlayC			;branch if error occured			IsAudio			lda TOCData+2			;get BCD sec, frame			xba			sta XXX			lda TOCData				;get BCD minutes			xba			and #$00ff				;because CD's dont have hours			sta XXX+2;Now do the compare			lda PlayBackAdr+1			;first minutes,sec			xba			cmp XXX+1			bcc WasLess				;branch if less than			beq ChkFrames			;branch if same, need to check frames			bcs CheckEnd			;not before start, go check for past endChkFrames	lda PlayBackAdr+2		;get sec., frames			xba			cmp XXX					;compare sec., frames			bcs GoOn				;branch if same are greater (should be ok);We arrive here if we are less than the first track, so set it to the first trackWasLess			lda XXX					;get frames, sec			xba			sta PlayBackAdr+2		;store frames, sec			lda XXX+1				;get sec, min			xba			sta PlayBackAdr+1			;store sec. frames;Now see if we are at the end of the discCheckEnd			lda #$0040				;for absolute BCD Min-Sec-Frame			jsr GetTOC				;get the table of contents (max. audio loc.)XOutOfPlayC	bcs OutOfPlayC			;branch if error						lda TOCData				;get Min, sec.			xba						;fix byte sex			sta XXX					;save for comparing			lda PlayBackAdr+1		;get current Min, sec.			xba						;fix byte sex			cmp XXX					;now do compare			bcc GoOn				;branch if less than;We arrive here if we are at the leadout area of the disc (so we set to start of disc)			lda #0			jsr GetTOC				;get table of contents (first user track no.)			bcs OutOfPlayC			;branch if error occured			lda #$0080			sta PlayAdrType			;set address type to Track No. format			lda TOCData			and #$00ff				;only want first track no.			xba						;want in high byte location			sta PlayBackAdr+2					stz PlayBackAdr			lda #$0080				;we want track no. format			bra GoOn2			GoOn			lda #$0040GoOn2			sta PlayAdrType			;set address type for absolute positioning						_DControlGS PlayDCtrlBlk ;perform an audio play command			bcs OutOfPlayC			;branch if errorOutOK			lda #0					;return no errors			clc			rtsOutOfPlayC			cmp #drvrDiskSwitch			beq JustOut			dec RetryIt				;do retrys unless disk switched error			bmi JustOut			jmp PlayAgain			;go retry itJustOut			sec			rts			XXX			ds.l	1				;place to store for compareRetryIt		ds.w	1				;retry counter area;=====================================================================;This is the DControl data block for a Play CommandPlayDCtrlBlk dc.w	5			;Passed parameter count (PCount)PlayDNum	dc.w	0			;Passed device number (Stuffed)PlayCode	dc.w	$80C8		;Passed code (Audio Search Play)PlayListPtr	dc.l	PlayList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the control listPlayList	dc.w	0			;Passed zeros (reserved)			dc.b	$C8			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$10			; 2 Stop flag (playbackadr is start addr)PlayAudioM	dc.b	$09			; 3 Play mode (stereo)			EXPORT PlayBackAdrPlayBackAdr	dc.l	0			; 4 Playback addressPlayAdrType	dc.b	$40			; 8 Address type (specified in AMin, ASec, AFrame)			dc.b	0			; 9 Reserved			dc.w	0			; 10 Reserved			dc.l	0			;Buffer Pointer (reserved)			ENDP			;-------------------------------------------------------------------;;  NAME:		DoPause;;  PURPOSE:		To do an AudioPause command ;;  PASSED:		(X)=pause flag;;  RETURNED:	Carry=set if error; (A-reg.)=error number;;-------------------------------------------------------------------DoPause 	PROC			lda MyDevID			sta PauseDNum		;set device number			stx PauseFlag		;set pause flag						_DControlGS PauseDCtrlBk ;perform an audio play command			rts;=====================================================================;This is the DControl data blockPauseDCtrlBk dc.w	5			;Passed parameter count (PCount)PauseDNum	dc.w	0			;Passed device number (Stuffed)PauseCode	dc.w	$80CA		;Passed code (Audio Pause)PauseListPtr dc.l	PauseList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the Pause control listPauseList	dc.w	0			;Passed zeros (reserved)			dc.b	$CA			; 0 SCSI command			dc.b	$00			; 1 SCSI flagsPauseFlag	dc.b	$00			; 2 Pause flag (start/release pause)			dc.b	0			; 3			dc.l	0			; 4			dc.l	0			; 8						ENDP;-------------------------------------------------------------------;;  NAME:		MCGetFeatures;;  PURPOSE:		Returns the drivers features;;  PASSED:		Result			LONG	;space for result;				Selector		WORD	;feature selector value;;  RETURNED:	FeatureVal		LONG	;returned driver feature value;;-------------------------------------------------------------------MCGetFeatures 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3Selector	wordChannelNo	wordFeatureVal 	long					lda Selector,s			;get feature selector value			asl a					;times 4 for longs			asl a			tax						;use as index into table			cmp #36					;see if volume feature wanted			bne notvolume			;branch if not;This special cases the mcFVolume feature;Because this driver will work with the old and new CD player,;we need to determine if volume control is supported.			lda MyDevID			sta InqDNum				;set device number						_DStatusGS InqDataBlk 	;perform an inquiry data call;Now compare to see if its the new CD+ player			sep #$30				;8-bit mode for compare			longa off			longi off			ldx #1					;index into InqIDString			ldy #16					;start of ID			IDCmpLoop	lda InqIDString,x			cmp InqDataData,y			clc						;assume not same (carry clear for exit)			bne OutID				;branch with carry set when not equal			inx			iny			cpy #31			bcc IDCmpLoop			;we fall thru with carry set when equalOutID									rep #$30				;16-bit mode now			longa on			longi on			lda #1			bcs HaveFeature			;branch if no errors (have feature)			lda #0HaveFeature				sta FeatureVal,s			lda #0			bra FinishUp			notvolume			lda #BadSelector		;assume selector value is bad			cpx #MaxFeature			;is it beyond max value?			bcs OutOfHere			;branch if bad					lda FeatureTbl,x		;get return value			sta FeatureVal,s			lda FeatureTbl+2,xFinishUp			sta FeatureVal+2,s			lda #0OutOfHere	jmp Exit4FeatureTbl			dc.l	5				;mcFTypes -does frames, times and chapters			dc.l	0				;mcFStep -Max. step value			dc.l	0				;mcFRecord -record			dc.l	0				;mcFVideo -does video function			dc.l	1				;mcFEject -does eject function			dc.l	1				;mcFLock -does user key lock			dc.l	0				;mcFVDisplay -does video location display			dc.l	0				;mcFVOverlay -No. of lines of char. video overlay			dc.l	0				;mcFVOChars -Video overlay no. of chars. per line			dc.l	1				;mcFVolume -Supports volumeMaxFeature	equ *-FeatureTbl;=====================================================================;This is the DControl data blockInqDataBlk 	dc.w	5			;Passed parameter count (PCount)InqDNum		dc.w	0			;Passed device number (Stuffed)			dc.w	$8012		;Passed code (AudioStatus)			dc.l	InqList		;Passed list pointer			dc.l	36			;Passed request count			dc.l	0			;Returned transfer count;This is the status control listInqList		dc.w	0			;Passed zeros (reserved)			dc.b	$12			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$00			; 2 			dc.b	$00			; 3 			dc.l	0			; 4 			dc.b	0			; 8 			dc.b	0			; 9 			dc.w	0			; 10 			dc.l	InqDataData	;Buffer Pointer			InqDataData			ds.b	36InqIDString	str 'CD-ROM CDU-8002'			ENDP			;-------------------------------------------------------------------;;  NAME:		MCPlay;;  PURPOSE:		To put the device in play mode;;  PASSED:		McChannelNo		WORD	;channel number;;  RETURNED:	None;;-------------------------------------------------------------------MCPlay  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	word			lda #2			sta RetryCntrDSRedo;First see if we need to clear out a previous stop location			lda ChannelNo,s			;pass channel no.			jsr RidStop				;get rid of current stop if need to			bcs ErrorOut			;branch if error			lda #0					;want regular audio status			jsr GetAudioStat		;get current audio status			bcc ASGood				;branch if no error			cmp #DataTrack			;see if fe02 error (data area)			beq JustPlay			;if in data area, just play			cmp #DataTrack2			beq JustPlay			cmp #DataTrack3			beq JustPlay			bra ErrorOutASGood			lda AudioSField			and #$0007			cmp #5				;see if error			bne JustPlay;We arrive here when the unit is paused			ldx  #0				;release pause			jsr DoPause			bra ErrorOut;Now we know we are in play mode (so issue a play command with audio new audio)JustPlay			jsr	PlayAtCurr			;Start playing at current location			bcs ErrorOutOutOK			lda #0ErrorOut;Now check for being on data track errors			cmp #DataTrack			;see if fe02 error (data area)			beq TryStop				;if in data area, just play			cmp #DataTrack2			beq TryStop			cmp #DataTrack3			beq TryStop			bra SeeDS;if we arrive here, we have a $fe02, $7e02, or $00f1 error (beyond audio portion)TryStop			dec RetryCntr			beq SeeDS;Now just try a stop to force the heads back to an audio portion			lda ChannelNo,s			;get channel no.			pha						;pass as parameter			ldx #$2b26			jsl >$E10000;			_MCStop					;convert binary value to time BCD			bcc ReDoJmp				;redo command if no error;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.SeeDS			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errorsReDoJmp		jmp DSReDo				;go redo the commandDSExit			jmp Exit2RetryCntr	ds.w	1			ENDP;-------------------------------------------------------------------;;  NAME:		MCPause;;  PURPOSE:		To put the device in "pause" mode;;  PASSED:		McChannelNo		WORD	;channel number		;;  RETURNED:	None;;-------------------------------------------------------------------MCPause  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordDSReDo			;First see if we need to clear out a previous stop location			lda ChannelNo,s			;pass channel no.			jsr RidStop				;get rid of current stop if need to			bcs ErrorOut			;branch if error			ldx #$0010				;set pause									jsr DoPause				;do a pause command			ErrorOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp	Exit2						ENDP;-------------------------------------------------------------------;;  NAME:		MCSendRawData;;  PURPOSE:		To send raw data commands to the device;;  PASSED:		mcChannelNo		WORD	;channel number;				NativePtr		LONG	;pointer to string to send;;  RETURNED:	None;;-------------------------------------------------------------------MCSendRawData  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3RawData		LONGChannelNo	word			lda #UnImp			;unimplemented for this device			jmp	Exit6						ENDP;-------------------------------------------------------------------;;  NAME:		MCGetStatus;;  PURPOSE:		To return status about the device;;  PASSED:		returned		WORD	;space for returned word;				McChannelNo		WORD	;channel number;				MCStatusSel		WORD	;Status Selector value;;  RETURNED:	StatusInfo		WORD	;Status information;;-------------------------------------------------------------------MCGetStatus PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3StatusSel	wordChannelNo	wordReturned	wordDSReDo			lda StatusSel,s			;get status selector value			cmp #mcSDeviceType			bne TryNext0;------------------------------------------; mcSDeviceType: This determines the device type (CD audio);------------------------------------------			ldx #mcSCDAudio			;return CD audio device			bra ExitOutTryNext0						cmp #mcSPlayStatus			bne TryNext1;------------------------------------------; mcSPlayStatus: This determines the devices play status;------------------------------------------			lda #0					;want regular aduio status			jsr GetAudioStat		;get the status of the player			bcc NoRegErr			;branch if no errors			cmp #$002f				;look for offline error			bne ExitOutX			;exit out if error reading;We arrive here with an offline error			ldx #mcSParked			;lets return saying its parked then			bra ExitOutNoRegErr			lda AudioSField			;get status field						and #$000f;Now see if its playing			ldx #mcSPlaying			;assume its playing			cmp #0			beq ExitOut			cmp #2			beq ExitOut;Now see if its still			ldx #mcSStill			;assume it still			cmp #1			beq ExitOut			cmp #3			beq ExitOut				;its at the end of the play, so its still			ldx #mcSUnKnown			;we dont know what its doing;We arrive here x-reg. equal to returned valueExitOut			txa			sta Returned,s			;set returned value			lda #0ExitOutX			jmp ErrorOutX				;return;------------------------------------------; mcSDoorStatus: This does the door status (this device doesnt return such status);------------------------------------------TryNext1			ldx #mcSUnknown			;assume mcDoorStatus selected			cmp #mcSDoorStatus			beq ExitOut;------------------------------------------; mcSDiscType: This determines the discs status selected commands;------------------------------------------			lda StatusSel,s			;get status selector value again			cmp #mcSDiscType		;is it a disc type selector value			bne TryNext2;We now do the Disc type			lda #0					;want regular aduio status			jsr GetAudioStat		;get the status of the player			bcs ExitOutX			;branch if errors			ldx #mcS_CD				;Its a CDExitOutJ	jmp ExitOutTryNext2			cmp #mcSDiscSize			bne TryNext3;------------------------------------------; mcSDiscSize: We now do the Disc Size;------------------------------------------			lda #0					;want regular aduio status			jsr GetAudioStat		;get the status of the player			bcs ExitOutX			;branch if errors			ldx #mcSDisc5inch		;assume 5 inch disc			bra ExitOutJ			TryNext3			cmp #mcSDiscSide			bne TryNext4			;branch, try volume;------------------------------------------; mcSDiscSide: We now do the Disc Side;------------------------------------------			lda #0					;want regular aduio status			jsr GetAudioStat		;get the status of the player			bcs ExitOutX			;branch if errors			ldx #mcSSideOne			;assume side one (only one side on CD)			bra ExitOutJTryNext4			cmp #mcSVolumeL			bne TryNext5			;branch, try right volume;------------------------------------------; mcSVolumeL: We now do the left volume value;------------------------------------------			lda #1					;Want volume audio values			jsr GetAudioStat		;get current audio status			pha						;save status			lda AudioSField-1		;get left volume level in high nibbleVolStuff			and #$ff00				;because its only 8-bits on this device			plx						;get status back			sta Returned,s			;set return value			txa			bra DSExitTryNext5			cmp #mcSVolumeR			bne InvalidSel			;branch, invalid selector;------------------------------------------; mcSVolumeR: We now do the right volume value;------------------------------------------			lda #1					;Want volume audio values			jsr GetAudioStat		;get current audio status			pha						;save status from call			lda AudioSField			;get right volume level in high nibble			bra VolStuff			;finish up;We arrive here with an invalid selector valueInvalidSel			lda #BadSelectorErrorOutX;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit4						ENDP;-------------------------------------------------------------------;;  NAME:		MCControl;;  PURPOSE:		To issue information to control the device;;  PASSED:		McChannelNo		WORD	;channel number;				CtlCommand		WORD	;control command value;;  RETURNED:	None;;-------------------------------------------------------------------MCControl 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3CtlCommand	wordChannelNo	wordDSReDo			lda CtlCommand,s			cmp #mcCInit			;see if its an init			bne Try2;Its Init time			lda #0			sta BlankNextVideo		;set not to blank next video search			lda #30 			sta CurrSpeed			;set current speed to 30 fps (normal)			bra NoErrors						Try2		cmp #mcCEject			;see if its an eject command			bne Try3;Its Eject time;First make sure were unlocked			ldx #0			stx PAllowFlag			;clear lock flag on DCtrlBlk			lda MyDevID			sta PRemDNum			;set device number						_DControlGS PRemDCtrlBlk ;perform a prevent removal command			bcs ExitOutJ			;branch if error occured			lda MyDevID			sta EjectDNum			;set device number						_DControlGS EjectDCtrlBlk ;perform an audio play command			bra ExitOutJNoErrors			lda #0			ExitOutJ	jmp	DoneNotThisDev	lda #NotApplic			;get error (not applicable to this device)			bra ExitOutj			Try3					cmp #mcCDefaultCom+1			bcs Try9X			jmp NotThisDevTry9X			cmp #mcC8Data1Stop			bcc Try9			cmp #mcC5Data2Stop+1			bcs Try9			jmp NotThisDevTry9		cmp #mcCBaudDflt			bcc Try10			cmp #mcCBaud19200+1			bcs Try10			jmp NotThisDev	Try10		cmp #mcCLockDev			bne Try11;Lock user access button			ldx #$0001				;set lock user access buttonFinishLock			stx PAllowFlag			;set lock flag on DCtrlBlk			lda MyDevID			sta PRemDNum			;set device number						_DControlGS PRemDCtrlBlk ;perform a prevent removal command			bra DoneTry11		cmp #mcCUnLockDev			bne Try12;UnLock user access button			ldx #0					;set for unlock			bra FinishLock;Now check modem and printer specifiedTry12			cmp #mcCModem			bne Try13			jmp NotThisDevTry13			cmp #mcCPrinter			bne Try14			jmp NotThisDev;This checks for the mcCIgnoreDS and mcCReportDS commandsTry14			cmp #mcCIgnoreDS			bne Try15			stz DSFlag				;clear disk switched wanted flagExitNE			lda #0			bra DoneTry15			cmp #mcCReportDS			bne TryX			sta DSFlag				;set the disk switched wanted flag			bra ExitNE			;We arrive here with an invalid commandTryX		lda #BadSelectorDone;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit4						EXPORT DSFlagDSFlag		dc.w 0					;Want disk switched error reported flag						EXPORT BlankNextVideoBlankNextVideo dc.w	0				;blank next video flag (0=no, 1=yes);=====================================================================;This is the DControl data block ejecting the disc;EjectDCtrlBlk dc.w	5			;Passed parameter count (PCount);EjectDNum	dc.w	0			;Passed device number (Stuffed);EjectCode	dc.w	$00C0		;Passed code (Eject) was 0002;			dc.l	0			;Passed list pointer;			dc.l	0			;Passed request count;			dc.l	0			;Returned transfer count;=====================================================================;This is the DControl data blockEjectDCtrlBlk dc.w	5			;Passed parameter count (PCount)EjectDNum	dc.w	0			;Passed device number (Stuffed)EjectCode	dc.w	$80C0		;Passed code (Eject Disc)			dc.l	EjectList	;Passed list pointer			dc.l	14			;Passed request count			dc.l	0			;Returned transfer count;This is the Eject control listEjectList	dc.w	0			;Passed zeros (reserved)			dc.b	$C0			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$00			; 2 X			dc.b	0			; 3			dc.l	0			; 4			dc.l	0			; 8;=====================================================================;This is the DControl data block for a Prevent Removal CommandPRemDCtrlBlk dc.w	5			;Passed parameter count (PCount)PRemDNum	dc.w	0			;Passed device number (Stuffed)			dc.w	$801E		;Passed code (Prevent Removal)			dc.l	PRemList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the control listPRemList	dc.w	0			;Passed zeros (reserved)			dc.b	$1E			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.w	0			; 2-3 ReservedPAllowFlag	dc.b	$00			; 4 Reserved			dc.b	$00			; 5 Reserved			dc.l	0			; 6-9 Reserved			dc.w	0			; 10 Reserved			dc.l	0			;Buffer Pointer (reserved)			ENDP;-------------------------------------------------------------------;;  NAME:		MCScan;;  PURPOSE:		To scan forward or reverse.;;  PASSED:		McChannelNo		WORD	;channel number;				ScanDir			WORD	;scan direction (Pos fwd, neg. rev.);;  RETURNED:	None;;-------------------------------------------------------------------MCScan  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ScanDir 	WordChannelNo	word;First see if we need to clear out a previous stop location			lda #1			sta ScanCntr		;init scan counterDSReDo						lda ChannelNo,s		;pass channel no.						jsr RidStop			;get rid of current stop if need to			bcs ErrorOut		;branch if error			lda MyDevID			sta ScanDNum		;set device number						ldx #0				;assume scan forward			lda ScanDir,s		;get direction of scan			bpl	GoForward		;branch if forward			ldx #$0010			;else set to reverse			GoForward			stx XScanDir		;set scan direction			jsr GetLocation		;go get current location			bcs OutOfScan		;branch if error occured				lda QAMin-1			;get absolute location			and #$ff00			sta ScanStrtAdr			lda QAMin+1			sta ScanStrtAdr+2ScanLoop			_DControlGS ScanDCtrlBlk ;perform an audio scan command			bcc ErrorOut		;branch if no errors;This fixes the problem of if MCScan is the first command to be executed;on the disc (the location is bogus.)  What we do is first issue a play,;then do the scan using addr. from play(this makes sure the address is within bounds.)			cmp #DataTrack			beq GOn			cmp #DataTrack2			beq GOn			cmp #DataTrack3			bne ErrorOutGOn			dec ScanCntr		;dec. scan counter			bmi ErrorOut		;bail out if second time			jsr PlayAtCurr		;this will set the good start address			lda PlaybackAdr		;now get play start addr and addr. type			sta ScanStrtAdr			lda PlaybackAdr+2			sta ScanStrtAdr+2			lda PlaybackAdr+3	;this picks up the addr. type			sta ScanStrtAdr+3			bra ScanLoop		;now go do the scan command						OutOfScanErrorOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit4			ScanCntr	ds.w	1			;repeat on error counter;=====================================================================;This is the DControl data block			EXPORT ScanDCtrlBlkScanDCtrlBlk dc.w	5			;Passed parameter count (PCount)ScanDNum	dc.w	0			;Passed device number (Stuffed)ScanCode	dc.w	$80CD		;Passed code (Audio Scan)			dc.l	ScanList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the control listScanList	dc.w	0			;Passed zeros (reserved)			dc.b	$CD			; 0 SCSI command			dc.b	$00			; 1 SCSI flagsXScanDir	dc.b	$00			; 2 Scan direction ($00 ffwd, $10 frev) 			dc.b	$00			; 3 ScanStrtAdr dc.l	0			; 4 Scan starting address 			dc.b	$40			; 8 Address type (specified in AMin, ASec, AFrame)			dc.b	0			; 9 Reserved			dc.w	0			; 10 Reserved			dc.l	0			;Buffer Pointer (reserved)			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetSpeeds;;  PURPOSE:		To return a list of available speeds that can be played;;  PASSED:		mcChannelNo		WORD	;channel number;				PStringPtr		LONG	;P string pointer to buffer for returned speeds;;  RETURNED:	NONE;;-------------------------------------------------------------------MCGetSpeeds PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3PStringPtr	LongChannelNo	word			lda #UnImp			;return unimplemented for this device			jmp	Exit6			ENDP;-------------------------------------------------------------------;;  NAME:		MCSpeed;;  PURPOSE:		To set the speed for the next mcPlay command;;  PASSED:		mcChannelNo		WORD	;channel number;				Speed			WORD	;speed value(+ or -);;  RETURNED:	none;;-------------------------------------------------------------------MCSpeed PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3Speedval	wordChannelNo	word			lda #UnImp			;return unimplemented for this device						jmp Exit4			EXPORT CurrSpeedCurrSpeed	dc.w	30			;current speed setting			ENDP;-------------------------------------------------------------------;;  NAME:		MCStopAt;;  PURPOSE:		To set the point the device is to stop at;;  PASSED:		McChannelNo		WORD	;channel number;				McUnitType		WORD	;unit type;				StopLoc			Long	;stop location;;  RETURNED:	None;;-------------------------------------------------------------------MCStopAt  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3StopLoc		LongmcUnitType	wordChannelNo	word			DSReDo						lda mcUnitType,s		;get unit type			cmp #InFrames			bne TryChap				;branch if not chapters;We arrive here if its specified as a frame location			lda #UnImp				;this device doesn't do framesOutJmp;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			bra DSReDo				;go redo the commandDSExit			jmp Exit8;--------------------------------------------------------------			TryChap			cmp #InChapters			bne TryTimes			;branch if not in time;We arrive here if its specified as chapters			lda #$0080				;set for chapter stop			sta StopType			lda #1			sta Stopflag			;set stop flag;This checks first to see if we are at chapter 1 or zero			lda StopLoc,s			cmp #2			bcs OkNormal			;branch if normal;We arrive here if chapter 1 or zero was specified;First set the stop type to absolute time because we want to set the;stop at to the beginning of the disc			lda #$0040				;set for absolute time stop			sta StopType			lda #1			sta TOCTrack			;set the track no.			lda #$0004			sta TOCByte7			;set size of buffer to long (4 bytes)			lda #$0080				;for track starting address			jsr GetTOC				;go get track start			stz TOCTrack			;zero out track no.			stz TOCByte7			;zero out length words			bcs OutJmp				;branch if error occured			lda TOCData+2			;get BCD sec, frame			sta StopAddr+2			lda TOCData				;get BCD minutes			and #$00ff				;because CD's dont have hours			bra GoOn4			OkNormal;First we need to convert the binary chapter no. to BCD;and decrement by one to be compatible with other devices			pha						;space for result long			pha			lda StopLoc+6,s			pha						;push high word			lda StopLoc+6,s			;now dec. low word and push			dec a			pha			ldx #$0d26			jsl >$E10000;			_MCCvtgBin2Time			;convert binary value to time BCD			pla						;get low word			plx						;get high word			xba			sta StopAddr+2			txa			bra GoOn3;--------------------------------------------------------------TryTimes	cmp #InTimes			bne InError				;branch if not one of the above;We arrive here if its specified as time			lda #$0040				;set for absolute time stop			sta StopTypeGoOn			lda #1					;flag			sta StopFlag			;set stop flag (we now know we've done a stop)GoOn2			lda StopLoc,s			;set search address			xba						;need motorola format msb:lsb stored			sta StopAddr+2			lda StopLoc+2,sGoOn3			xbaGoOn4			sta StopAddr						lda MyDevID			sta StopDNum			;set device number						_DControlGS StopDCtrlBlk ;perform an audio play command			jmp OutJmp;=====================================================================;This is the DControl data block for a Play Command			EXPORT StopDCtrlBlkStopDCtrlBlk dc.w	5			;Passed parameter count (PCount)			EXPORT StopDNumStopDNum	dc.w	0			;Passed device number (Stuffed)StopCode	dc.w	$80CB		;Passed code (Audio Search Play)StopListPtr	dc.l	StopList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the control listStopList	dc.w	0			;Passed zeros (reserved)			dc.b	$CB			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			EXPORT StopAddrStopAddr	dc.l	0			; 2-5 Stop Addr. (MSB first)			EXPORT StopTypeStopType	dc.b	$40			; 6 Address type (specified in AMin, ASec, AFrame)			dc.w	0			; 7-8 Reserved			dc.b	0			; 9 Reserved			dc.w	0			; 10 Reserved			dc.l	0			;Buffer Pointer (reserved);We arrive here with an invalid unit specified typeInError			lda #BadUnitType			jmp OutJmp						EXPORT StopFlagStopFlag	dc.w	0			;stop flag (0, no stop before play commands);=====================================================================;This is the DControl data block for a Play Command;StopDCtrlBlk dc.w	5			;Passed parameter count (PCount);StopDNum	dc.w	0			;Passed device number (Stuffed);PlayCode	dc.w	$80C8		;Passed code (Audio Search Play);PlayListPtr dc.l	PlayList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the control list;PlayList	dc.w	0			;Passed zeros (reserved)			dc.b	$C8			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$40			; 2 Stop flag (playbackadr is stop addr);PlayAudioM	dc.b	$09			; 3 Play mode (stereo);StopAddr	dc.l	0			; 4 Playback address;StopType	dc.b	$40			; 8 Address type (specified in AMin, ASec, AFrame)			dc.b	0			; 9 Reserved			dc.w	0			; 10 Reserved			dc.l	0			;Buffer Pointer (reserved)			ENDP;-------------------------------------------------------------------;;  NAME:		MCJogN;;  PURPOSE:		To jog njog units forward or backwards.;;  PASSED:		McChannelNo		WORD	;channel number;				mcUnitType		Word	;unit type;				nJog			Long	;units to jog;				jogrepeat		WORD	;repeat counter (+=fwd., -=rev.);;  RETURNED:	None;;-------------------------------------------------------------------MCJogN  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3JogRepeat	wordnJog		LongmcUnitType	wordChannelNo	wordDSReDo			;This checks that the nJog value and JogRepeat aren't zero;			lda nJog,s;			ora nJog+2,s;			beq ValuesBad			;branch if njog is zero			lda JogRepeat,s			bne ValuesOK			;branch out if jogrepeat not zeroValuesBad			lda #InvalidParam		;return with invalid parameter error			jmp ExitOutValuesOK			lda MyDevID			sta JogDNum				;set device number			;Remember JogAudio is only a byte long			lda AudioMode			;get the current audio mode setting			sta JogAudio			;set the audio mode for search;First see if we need to clear out a previous stop location			lda ChannelNo,s			;pass channel no.			jsr RidStop				;get rid of current stop if need to			bcc GoOn				;branch if no errors			jmp ExitOut				;else return with error valueGoOn			lda mcUnitType,s		;get unit type			cmp #InFrames			beq ItsFrames			jmp NotFrames;---------------------------------------;We do frame jog here;---------------------------------------ItsFrames			lda #DevRtnError		;we dont understand frames on CD's			jmp ExitOut				;dont do anythingNotFrames			cmp #InTimes			beq DoDaTimes			;branch if times			jmp NotTime;---------------------------------------;We do time mode here;---------------------------------------DoDaTimes			lda #$0040				;jog absolute time			sta JogType				;set for jog time			lda JogRepeat,s			;get repeat value			sta XCounter			bmi RevDirTime			;branch if reverse direction;Going forward (Time)FwdTime			lda #$0040				;for absolute BCD Min-Sec-Frame			jsr GetTOC				;get lead out time value			bcs OutJmpC2			jsr GetLocation			;get current location			bcs OutJmpC2			;branch if error			stz JogAddrBlk			stz JogAddrBlk+2;Now we add the values together			lda nJog,s				;get jog value and store at AddData			xba			sta AddData+2			lda NJog+2,s			xba			sta AddData			lda QAMin				;get current location in (X,A-regs.)			and #$00ff			tax			lda QASec			xba			jsr AddTime				;add jog value to current location			;--------			xba			sta JogAddrBlk+2		;save for jog			txa			xba			sta JogAddrBlk			txa			and #$ff00			bne OutRangeVal5		;branch if any hours (CD's dont do hours);Now comapre to see if went beyond lead out area of disc			sep #$30				;set 8-bit mode (for compare)			longa off			longi off			ldx #0TimeILoop			lda JogAddrBlk+1,x		;now compare against lead out time			cmp TOCData,x			beq OKITry				;continue compare if equal			bcc FineTimeI			;if less than, then ok value			bcs OutRangeVal5		;if greater, then out of rangeOKITry			inx			cpx #3			bne TimeILoop			bra FineTimeIOutRangeVal5			rep #$38				;back to 16-bit binary			jmp OutRangeVal			FineTimeI			rep #$38				;back to 16-bit binary			longa on			longi on			_DControlGS JogDCtrlBlk ;perform an audio play command			bcs OutJmpC2				;branch if error			dec XCounter			;dec. counter			bne FwdTime				;loop until done			lda #0OutJmpC2	jmp	ExitOut;Going Reverse (Time)RevDirTime	;First we need to determine the start of the disc by looking at the start;of the first track.			lda #0					;for first last track no.			sta TOCTrack			;make sure track was cleared			jsr GetTOC				;get first track no.			bcs OutJmpC2			lda TOCData				;get first track no.			and #$00ff			sta TOCTrack			;get start of very first track			lda #$0080				;for start of track			jsr GetTOC				;get tracks abusolute time start vale			stz TOCTrack			bcs OutJmpC2RevDirLoop			jsr GetLocation			;get current location			bcs OutJmpC2			;branch if error			stz JogAddrBlk			stz JogAddrBlk+2;Now we subtract the values			lda QASec				;first set current location at AddData			sta AddData+2			lda QAMin			and #$00ff			xba			sta AddData			lda Njog+2,s				;now get value to subtract in (X,A-reg.)			tax			lda NJog,s			jsr SubTime				;subtract njog value from current time;-------------			xba			sta JogAddrBlk+2		;save for jog			txa			xba			sta JogAddrBlk			txa			and #$ff00			bne OutTimeVal2		;branch if any hours (CD's dont do hours);Now see if went beyond first track location			sep #$38				;set 8-bit mode (for compare)			longa off			longi off			ldx #0TimeDLoop			lda JogAddrBlk+1,x		;now compare to see if before start of disc			cmp TOCData,x			;comapre against 1st track start			beq OKDTry				;equal, keep looking			bcc OutTimeVal2			;less than, error out			bcs FineTime			;grater than, then ok valueOKDTry			inx			cpx #3			bne TimeDLoop			bra FineTimeOutTimeVal2			rep #$38				;back to 16-bit binary			jmp OutRangeVal			FineTime			rep #$38				;back to 16-bit binary			longa on			longi on			_DControlGS JogDCtrlBlk ;perform an audio play command			bcs ExitOut4			inc XCounter			beq FinNoErr			;branch when done			jmp RevDirLoop			;else loop againFinNoErr			lda #0					;return no errorsExitOut4	jmp ExitOutNotTime			cmp #InChapters			beq DoDaChapter;---------------------------------------;We do Chapter mode here;---------------------------------------;; We arrive here with an invalid unit specified type;InError		lda #BadUnitType			jmp ExitOut			DoDaChapter			lda #$0080				;for tracks			sta JogType				;set for jog tracks			lda JogRepeat,s			;get low word			sta XCounter			bmi RevDirChp			;branch if reverse direction;Going forward (Chapters)			lda #0			jsr GetTOC				;get table of contents (first & last track)			bcs OutJmpC			jsr GetLocation			;get current location			bcs OutJmpC				;branch if error			stz JogAddrBlk			stz JogAddrBlk+2;First check to see if nJog is zero (we want to go to start of current track)			lda nJog,s				;get jog value			beq FwdChpts;First check to see if on the last track, if we are just return with error			sep #$38				;8-bit			lda QTrack			cmp TOCData+1			rep #$38				;back to 16-bit			beq FErrorJFwdChpts			sep #$38				;set decimal adj. mode			longa off			longi off			lda nJog,s				;get jog value			clc			adc QTrack				;add to next value			sta QTrack				;save for next add...						bcs OutRangeVal			;branch if carry through (out of range)			sta JogAddrBlk+3		;save new track no.			cmp TOCData+1			;compare to last track on disc						rep #$38				;back to binary mode			longa on			longi on			beq OKTrackVal			;branch ok if last track			bcc OKTrackVal			;branch if less than last trackOutRangeVal			sep #$38			lda TOCData+1			sta JogAddrBlk+3		;set to last track			rep #$38			_DControlGS JogDCtrlBlk ;perform an audio play command			bcs OutJmpC				;branch if errorFErrorJ			lda #DevRtnError		;return error value			bra OutJmpCOKTrackVal			dec XCounter			;dec. counter			bne FwdChpts			;loop until doneDoLastT			_DControlGS JogDCtrlBlk ;perform an audio play command			bcs OutJmpC				;branch if errorOutJmpC		jmp	ExitDOut;Going Reverse (Chapters)RevDirChp				lda #0			jsr GetTOC				;get table of contents (first & last track)			bcs OutJmpC			jsr GetLocation			;get current location			bcs OutJmpC				;branch if error			stz JogAddrBlk			stz JogAddrBlk+2RevChp			sep #$38				;set decimal adj. mode			longa off			longi off			lda QTrack				;get current track			sec			sbc nJog,s				;subtract down to next value			sta QTrack			bcc OutRangeVal2		;branch if no carry through (out of range)			sta JogAddrBlk+3		;save new track no.			cmp TOCData				;compare with first track on disc						rep #$38				;back to binary mode			longa on			longi on			beq OKTrackVal2			;branch ok if first track			bcs OKTrackVal2			;branch if greater than first trackOutRangeVal2			sep #$38			lda TOCData				;get first track no.			sta JogAddrBlk+3		;set to first track			rep #$38			_DControlGS JogDCtrlBlk ;perform an audio play command			bcs ExitDOut			lda #DevRtnError		;return error value			bra ExitDOut			OKTrackVal2			inc XCounter			bne RevChpDoLastT2			_DControlGS JogDCtrlBlk ;perform an audio play commandExitDOut;This is a delay loop to cause things to settle down when joging by track.;This is needed to insure we are indeed to the track (not on the raw edge, where;sometimes we are in the wanted track and sometimes not.);			ldx #$4fff;DLoop;			nop;			nop;			dex;			bne DLoopExitOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit10;=====================================================================;This is the DControl data blockJogDCtrlBlk dc.w	5			;Passed parameter count (PCount)JogDNum		dc.w	0			;Passed device number (Stuffed)PlayCode	dc.w	$80C8		;Passed code (Audio Search)PlayListPtr	dc.l	PlayList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the control listPlayList	dc.w	0			;Passed zeros (reserved)			dc.b	$C8			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$10			; 2 Stop flag (playbackadr is start addr)JogAudio	dc.b	$09			; 3 Play mode (stereo)JogAddrBlk	dc.l	0			; 4 Playback addressJogType		dc.b	$80			; 8 Address type (specified in tracks)			dc.b	0			; 9 Reserved			dc.w	0			; 10 Reserved			dc.l	0			;Buffer Pointer (reserved)			EXPORT CRCR			dc.b	2,13,10			;string composed of 1 byteXCounter	dc.w	0MyLongTemp	ds.l	1				;just a long temporary area			ENDP;-------------------------------------------------------------------;;  NAME:		MCSearchTo;;  PURPOSE:		To start a search to searchloc.;;  PASSED:		McChannelNo		WORD	;channel number;				mcUnitType		Word	;unit type;				SearchLoc		Long	;units to jog;;  RETURNED:	None;;-------------------------------------------------------------------MCSearchTo  PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3SearchLoc	LongmcUnitType	wordChannelNo	wordDSReDo;First see if we need to clear out a previous stop location			lda ChannelNo,s			;pass channel no.			jsr RidStop				;get rid of current stop if need to			bcs OutOK				;branch if error;First lets set the audio mode			lda AudioMode			;get audio mode			sta SrchAudioM			;set the audio mode here			lda mcUnitType,s		;get unit type			cmp #InFrames			bne NotFrames			;branch if not frames;---------------------------------------;We do frame search here;---------------------------------------ItsFrames			lda #UnImp				;this device doesn't do frames			jmp OutOKNotFrames			cmp #InTimes			bne NotTime;---------------------------------------;We do time search here;---------------------------------------			lda #$0040				;set for absolute time search			sta SearchType			jmp GoSearchNotTime			cmp #InChapters			bne InError;---------------------------------------;We do Chapter search here;---------------------------------------			lda #$0080				;set for track/chapter search			sta SearchType;We first must convert the Chapter/track no. to BCD for the search			lda SearchLoc,s			;push high word			tax			lda SearchLoc+2,s		;get high word			tay			pha						;space for result			pha						;space for result			phy						;push high word			phx						;push low word			ldx #$0d26			jsl >$E10000;			_MCCvtgBin2Time			;convert binary value to time BCD			pla						;get low word			plx						;get high word			xba			sta SearchAdr+2			;store ss:ff			txa			xba			sta SearchAdr			;store xx:mm			bra GoSearch2;; We arrive here with an invalid unit specified type;InError		lda #BadUnitType			jmp OutOK;---------------------------------------; This is where we do the actual search command;---------------------------------------GoSearch			lda SearchLoc,s			;set search address			xba						;need motorola format msb:lsb stored			sta SearchAdr+2			lda SearchLoc+2,s			xba			sta SearchAdr			GoSearch2			lda MyDevID			sta SrchDNum			;set device number						_DControlGS SrchDCtrlBlk ;perform an audio play commandOutOK;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit						jmp Exit8;=====================================================================;This is the DControl data block for a Play CommandSrchDCtrlBlk dc.w	5			;Passed parameter count (PCount)SrchDNum	dc.w	0			;Passed device number (Stuffed)PlayCode	dc.w	$80C8		;Passed code (Audio Search then pause)PlayListPtr	dc.l	SrchList	;Passed list pointer			dc.l	18			;Passed request count			dc.l	0			;Returned transfer count;This is the control listSrchList	dc.w	0			;Passed zeros (reserved)			dc.b	$C8			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$00			; 2 Stop flag (playbackadr is start addr)SrchAudioM	dc.b	$09			; 3 Play mode (stuffed, default stereo)SearchAdr	dc.l	0			; 4 Search addressSearchType	dc.b	$40			; 8 Address type (specified in AMin, ASec, AFrame)			dc.b	0			; 9 Reserved			dc.w	0			; 10 Reserved			dc.l	0			;Buffer Pointer (reserved)			ENDP;-------------------------------------------------------------------;;  NAME:		MCSearchDone;;  PURPOSE:		To return status if search command is completed;;  PASSED:		returned		WORD	;space for result;				McChannelNo		WORD	;channel number;;  RETURNED:	DoneStatus		WORD	;status if done (not zero;										; inficates done);;-------------------------------------------------------------------MCSearchDone PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordDoneStatus	word		;returned done status						lda #1			sta DoneStatus,s	;always report done			lda #0			jmp	Exit2			ENDP			;-------------------------------------------------------------------;;  NAME:		MCSearchWait;;  PURPOSE:		To wait until device has completed search command.;;  PASSED:		McChannelNo		WORD	;channel number;;  RETURNED:	None;;-------------------------------------------------------------------MCSearchWait  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	word			lda #0			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetPosition;;  PURPOSE:		To return current position of device;;  PASSED:		returned		LONG	;space for result;				McChannelNo		WORD	;channel number;				mcUnitType		WORD	;passed unit type;;  RETURNED:	CurrPos			LONG	;Current Position;;-------------------------------------------------------------------MCGetPosition	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3mcUnitType	wordChannelNo	wordCurrPos		long		;returned current position			lda #1			sta RetryCntr			;init retry counterDSReDo						jsr GetLocation			;go get location			sta TheError							lda mcUnitType,s			cmp #InFrames			;want frames?			bne TryTime;-------------------------------------------------;We return the Frame position here;-------------------------------------------------			lda #UnImp				;we dont do frame stuff			bra GotError									DoRest			jsr CvtTime2ASCII		;convert bcd to ascii			pha						;space for result			pha			PushLong #ScratchStr+1			lda ScratchStr			and #$00ff			pha			PushWord #0				;because it needs a long			_Dec2Long				;convert to decimal			bcs GotErrISOK			pla			sta CurrPos+2,sISOK2			pla			sta CurrPos+2,s			lda #0					;no error exitGotError	jmp JustExit;We arrive here if we receive some type of error trying to convert value?GotErr		pla			plaGotErr2		lda #FunnyData			cpx TheError			;get location error			beq GotErrX				;branch if no error			txa						;else use that oneGotErrX			jmp JustExitTryTime			cmp #InTimes			bne TryChapters;--------------------------------------------------;We get the time position here;--------------------------------------------------				lda QAMin			and #$00ff			;there are no hours			sta CurrPos+2,s			lda QASec			xba			sta CurrPos,sNoErrs			lda #0			jmp	JustExit			TryChapters			cmp #InChapters			bne WrongSpec;--------------------------------------------------;We get the track position here;--------------------------------------------------			lda QTrack			and #$00ff			sta MyBCDTime+2			lda #0			sta MyBCDTime					jmp DoRestWrongSpec			lda #BadUnitTypeOutErrC1	JustExit		;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errorsReDoJmp		jmp DSReDo				;go redo the commandDSExit			cmp #DataTrack			;see if fe02 error (data area)			beq TryStop				;if in data area, just play			cmp #DataTrack2			beq TryStop			cmp #DataTrack3			beq TryStopJustOut		jmp Exit4;if we arrive here, we have a $fe02, $7e02, or $00f1 error (beyond audio portion)TryStop			dec RetryCntr			beq JustOut;Now just try a stop to force the heads back to an audio portion			lda ChannelNo,s			;get channel no.			pha						;pass as parameter			ldx #$2b26			jsl >$E10000;			_MCStop					;convert binary value to time BCD			bcc ReDoJmp				;redo command if no error			bra JustOut				;else just return with the errorRetryCntr	ds.w	1TheError	ds.w	1				;save error no.			ENDP;-------------------------------------------------------------------;;  NAME:		MCSetAudio;;  PURPOSE:		To control the audio portion;;  PASSED:		McChannelNo		WORD	;channel number;				AudioCtrl		WORD	;audio control command no.;;  RETURNED:	None;;-------------------------------------------------------------------MCSetAudio 	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3AudioCtrl	wordChannelNo	wordDSReDo			lda AudioCtrl,s			;get audio control value			;First see if its a valid audio commandNotAudio	cmp #AudioMonaural+1			bcc ValidAudio			;branch if valid			lda #BadAudio			;else invalid audio value error			bra JustExit;We arrive here with a valid audio valueValidAudio			sta AudioMode			;set the audio mode for next command			lda #0					;Want regular audio values			jsr GetAudioStat		;get current audio status			bcs JustExit			;branch if go error			lda AudioSField			;get audio status field			and #$0007			beq InPlayMode			;branch if currently playing			cmp #2					;branch if playing but muted			bne OutOK				;branch if not currently playing;Now we know we are in play mode (so issue a play command with audio new audio)InPlayMode			jsr	PlayAtCurr			;Start playing at current location			bcs JustExit			;branch if errorOutOK			lda #0JustExit;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit4						EXPORT AudioModeAudioMode	dc.w	AudioStereo		;audio mode (startup default stereo)			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetTimes;;  PURPOSE:		To return time value;;  PASSED:		returned		LONG	;space for result;				McChannelNo		WORD	;channel number;				mcTimeSelect	WORD	;passed time info selector;;  RETURNED:	TimeInfo		LONG	;Time information;;-------------------------------------------------------------------MCGetTimes	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3mcTimeSelect wordChannelNo	wordTimeInfo	long		;returned timeDSReDo			lda mcTimeSelect,s	;get time selector value;-----------------------------------------; McElapsedTrack 0;-----------------------------------------			cmp #mcElapsedTrack			bne Try1			jsr GetLocation		;get the current location			bcs ErrorOutJ		;branch if error			lda QSec			;get seconds and frame no.			xba			sta TimeInfo,s			lda QMin			and #$00ff			;only want minutes (no hours)			sta TimeInfo+2,s						jmp DoneErrorOutJ	jmp ErrorOut;-----------------------------------------; McRemainTrack 1;-----------------------------------------Try1			cmp #mcRemainTrack			beq OK1			jmp Try2			;jmp if not mcRemainTrackOK1			jsr GetLocation		;get the current location			bcs ErrorOutJ		;branch if error			lda #0				;get first and last track numbers			jsr GetToc			;get toc			bcs ErrorOutJ		;branch if error			lda TOCData+1		;get last track no.			and #$00ff			sta TimeInfo,s		;save for compare			lda QTrack			and #$00ff;Now we get the starting address of the next track for the calculation			cmp TimeInfo,s		;see if on last track			bne NotLastTrk		;branch if not on last track;We arrive here if we are on the last track, use end of disc for calculationOnLastTrk			lda #$0040			;get lead out area addr (end of disc)			jsr GetToc			;get TOC			stz TOCTrack		;zero the track			bcs ErrorOutJ		;branch if error occured			lda TocData			;remember min=tocdata			and #$00ff			;and out unwanted byte			xba			sta AddData			lda TocData+1			sta AddData+2			bra ContXNotLastTrk			sep #$38			;8-bit and decimal moce			longa off			longi off			clc			adc #1			sta TOCTrack		;set track number			rep #$38			;back to 16-bits and binary mode			longa on			longi on			lda #$0080			jsr GetToc			;get TOC			stz TOCTrack		;zero the track			bcs ErrorOutJ		;branch if error occured;Now we do the subtractionNowDoSub			lda TocData			;remember min=tocdata+1			and #$ff00			;and out unwanted byte			sta AddData			lda TocData+2			sta AddData+2ContX			lda QAMin			and #$00ff			tax			lda QAMin+1			xba			jsr SubTime			;subtract QAMin from TocData						stx TOCData			;store things for return			xba			sta TOCData+1RetTOCStuff			lda TOCData+1			xba			sta TimeInfo,s			lda TOCData			and #$00ff			sta TimeInfo+2,s			jmp Done;-----------------------------------------; McElapsedDisc 2;-----------------------------------------Try2			cmp #mcElapsedDisc			bne Try3			jsr GetLocation		;get the current location			bcs ErrorOut		;branch if error			lda QASec			;get seconds and frame no.			xba			sta TimeInfo,s			lda QAMin			and #$00ff			;only want minutes (no hours)			sta TimeInfo+2,s			jmp Done;-----------------------------------------; McRemainDisc 3;-----------------------------------------Try3			cmp #mcRemainDisc			bne Try4			jsr GetLocation		;get the current location			bcs ErrorOut		;branch if error			jmp OnLastTrk		;do the rest;-----------------------------------------; McTotalDisc 4;-----------------------------------------Try4			cmp #mcTotalDisc			bne Try5			bra IDStuff			;do the same as the ID routine;-----------------------------------------; McTotalFrames 5;-----------------------------------------Try5			cmp #mcTotalFrames			bne Try6			lda #UnImp			;not implemented for CD-rom drives			jmp ErrorOut;-----------------------------------------; McTracks 6;-----------------------------------------Try6			cmp #mcTracks			bne Try7			lda #0			jsr GetTOC			;get TOC for first and last track numbers			bcs ErrorOut		;branch if error			lda TOCData			and #$00ff			jsr BCD2Dec			sta TimeInfo,s			lda TOCData+1			and #$00ff			jsr BCD2Dec			sta TimeInfo+2,s			jmp Done;-----------------------------------------; McDiscID 7;-----------------------------------------Try7			cmp #mcDiscID			beq IDStuff			lda #BadSelector			bra ErrorOutIDStuff			lda #$0040			;get lead out starting address			jsr GetToc			;get toc			bcs ErrorOut		;branch if error			jmp RetTOCStuff		;go return the infoDone			lda #0ErrorOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit4			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetNoTracks;;  PURPOSE:		To return no. of tracks/chapters on the disc.;;  PASSED:		returned		WORD	;space for result;				McChannelNo		WORD	;channel number;;  RETURNED:	Tracks			WORD	;Tracks/Chapters on the disc;;-------------------------------------------------------------------MCGetNoTracks PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordTracks		word		;result no. of tracks/chaptersDSReDo						lda MyDevID			sta ReadTOCDNum			;set device number						_DStatusGS ReadTOCBlk 	;perform a ReadTOC call			bcs ErrorOut			sep #$38			;8-bit and decimal moce			longa off			longi off			clc			lda TOCLast			sbc TOCFirst		;now we have no. of tracks minus one			adc #1				;add one for true number of tracks			sta TOCLast			;save back to last			rep #$38			;back to 16-bits and binary mode			longa on			longi on			and #$00ff			jsr BCD2Dec			;convert to decimal			sta Tracks,s		;set return value			lda #0ErrorOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit2			;=====================================================================;This is the DControl data blockReadTOCBlk 	dc.w	5			;Passed parameter count (PCount)ReadTOCDNum	dc.w	0			;Passed device number (Stuffed)ReadTOCCode	dc.w	$80C1		;Passed code (ReadQSubcode)			dc.l	ReadTOCList	;Passed list pointer			dc.l	4			;Passed request count			dc.l	0			;Returned transfer count;This is the status control listReadTOCList	dc.w	0			;Passed zeros (reserved)			dc.b	$C1			; 0 SCSI command			dc.b	$00			; 1 SCSI flagsReadTOCTrk	dc.b	$00			; 2			dc.w	0			; 3-4 (reserved)ReadTOCType	dc.b	0			; 5 TOC type			dc.w	0			; 6-7			dc.b	0			; 8 			dc.b	0			; 9 			dc.w	0			; 10 			dc.l	ReadTOCData	;Buffer Pointer			ReadTOCDataTOCFirst	ds.b	1			;First track no. (BCD)TOCLast		ds.b	1			;Last track no. (BCD)			ds.w	1			;reserved			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetDiscTOC;;  PURPOSE:		To get a discs TOC (Table of Contents);;  PASSED:		returned		LONG	;resultant start of track address;				McChannelNo		WORD	;channel number;				TrackNo			WORD	;track no.;;  RETURNED:	DiscTOC			LONG	;Discs TOC info. string;;-------------------------------------------------------------------MCGetDiscTOC PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3TrackNo		wordChannelNo	wordTrackTOC	long			;returned start of trackDSReDo;We first must convert the Chapter/track no. to BCD for the search			lda TrackNo,s			;get track no.			pha						;space for result			pha						;space for result			pea 0					;push high word of zero			pha						;push low word			ldx #$0d26			jsl >$E10000;			_MCCvtgBin2Time			;convert binary value to time BCD			pla						;get low word			plx						;get high word			and #$00ff				;because track max.=99 BCD			sta TOCTrack			;set the track no.			lda #$0004			sta TOCByte7			;set sizer of buffer to long (4 bytes)			lda #$0080				;for track starting address			jsr GetTOC				;go get track start			stz TOCTrack			;zero out track no.			stz TOCByte7			;zero out length words			bcs ErrorOut			;branch if error occured			lda TOCData+2			xba			sta TrackTOC,s			;return the start addr. of track			lda TOCData+1			;get BCD minutes			and #$00ff				;because CD's dont have hours			sta TrackTOC+2,s			lda #0					;return no errors			ErrorOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp	Exit4			ENDP;-------------------------------------------------------------------;;  NAME:		MCGetDiscID;;  PURPOSE:		To get a discs unique ID;;  PASSED:		returned		LONG	;space for result;				McChannelNo		WORD	;channel number;;  RETURNED:	DiscTOC			LONG	;Discs ID;;-------------------------------------------------------------------MCGetDiscID PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordDiscID		long		;returned discs ID			DSReDo			lda #$0040				;for lead out addr. BCD Min-Sec-Frame			jsr GetTOC				;go get end of audio portion			bcs ErrorOut			;branch if error occured			lda TOCData+1			xba			sta DiscID,s			;return the lead out area as unique disc ID			lda TOCData				;get BCD minutes			and #$00ff				;because CD's dont have hours			sta DiscID+2,s			lda #0					;return no errors			ErrorOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCRecord;;  PURPOSE:		To put the device in record mode;;  PASSED:		McChannelNo		WORD	;channel number;;  RETURNED:	None;;-------------------------------------------------------------------MCRecord  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	word			lda #UnImp			;We cant record on a CD			jmp	Exit2			ENDP;-------------------------------------------------------------------;;  NAME:		MCStop;;  PURPOSE:		To put the device in "stop" mode;;  PASSED:		McChannelNo		WORD	;channel number		;;  RETURNED:	None;;-------------------------------------------------------------------MCStop  	PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3ChannelNo	wordDSReDo			;First see if we need to clear out a previous stop location			lda ChannelNo,s			;pass channel no.			jsr RidStop				;get rid of current stop if need to			bcs ErrorOut			;branch if error;Now put the player in pause mode;			ldx #$0010				;set pause						;			jsr DoPause				;do a pause command;			bcs ErrorOut			;branch if error;Now search to track 1;Now determine first audio track no.						lda #0			jsr GetTOC				;get TOC for first and last track numbers			bcs ErrorOut			;branch if error			lda TOCData			and #$00ff				;just want first track no.			jsr BCD2Dec				;convert to decimal			sta StartTrk			;save starting track			FirstAudio			lda ChannelNo,s			pha						;pass channel no.			PushWord #InChapters	;location specified as chapter			PushWord #0				;push high word of track wanted			PushWord StartTrk			ldx #$2126			jsl >$E10000			;perform _MCSearchTo;			_MCSearchTo			cmp #DataTrack			;see if digital data			beq GoOnX			cmp #DataTrack2			;see if digital data			beq GoOnX			cmp #DataTrack3			bne ErrorOutGoOnX			inc StartTrk			lda StartTrk			cmp #$0099				;compare so we wont loop forever			bcc FirstAudio			lda #DataTrack			;restore DataTrack error			ErrorOut;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp	Exit2			StartTrk	ds.w	1				;starting track			ENDP;-------------------------------------------------------------------;;  NAME:		MCWaitRawData;;  PURPOSE:		To wait for raw data from the device;;  PASSED:		McChannelNo		WORD	;channel number;				GSOSStringPtr	LONG	;pointer to gs/os resultant string tr.;				TickWait		Word	;no. of ticks before timeout error;				Term_Mask		Word	;terminal char. and mask char.;;  RETURNED:	None;;-------------------------------------------------------------------MCWaitRawData PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3Term_Mask	wordTickWait	wordGSOSString	long				;pointer to resultChannelNo	word			lda GSOSString,s			sta DP0			lda GSOSString+2,s			sta DP2;Just set the no. of characters read to zero			lda #0			ldy #2			sta [DP0],y			;set transfer count into GS/OS string			lda #Unimp			;return with unimplemented error			jmp Exit8			ENDP;-------------------------------------------------------------------;;  NAME:		MCSetVolume;;  PURPOSE:		To set the volume on the device;;  PASSED:		McChannelNo		WORD	;channel number;				LeftVolume		WORD	;Left volume value;				RightVolume		WORD	;Right volume value;;  RETURNED:	None;;-------------------------------------------------------------------MCSetVolume PROC			DefineStackZPBlock		block	DirectStackOrigB		byteOrigD		wordRTL1		block	3RTL2		block	3RightVolume wordLeftVolume	wordChannelNo	word;Remember the volume values are 16-bit values so all we want are the;top 8-bits for the CD player			lda MyDevID			sta PlayDNum			;set device numberDSReDo			lda RightVolume,s			sta L_volume			;set the right volume value			lda LeftVolume,s			xba						;get high byte into low byte			sep #$30					;8-bit mode			sta L_volume			;set the left volume value			rep #$30					;back to 16-bit mode			_DControlGS AudioDCtlBlk ;perform an audio control commandJustExit;This code checks to see if we want to ignore disk switched errors.;If we want to ignore disk switched errors and one occurs, we redo the command.			cmp #drvrDiskSwitch		;see if disk switche error			bne DSExit				;just exit if not			ldx DSFlag				;get disk switched flag			bne DSExit				;branch if want disk switched errors			jmp DSReDo				;go redo the commandDSExit			jmp Exit6;=====================================================================;This is the DControl data block for a Audio Control CommandAudioDCtlBlk dc.w	5			;Passed parameter count (PCount)PlayDNum	dc.w	0			;Passed device number (Stuffed)PlayCode	dc.w	$80CE		;Passed code (Audio Control)PlayListPtr	dc.l	PlayList	;Passed list pointer			dc.l	4			;Passed request count			dc.l	0			;Returned transfer count;This is the control listPlayList	dc.w	0			;Passed zeros (reserved)			dc.b	$CE			; 0 SCSI command			dc.b	$00			; 1 SCSI flags			dc.b	$00			; 2 Stop flag PlayAudioM	dc.b	$00			; 3 Play modePlayBackAdr	dc.l	0			; 4 Playback address			dc.b	$00			; 8 Address type (specified in AMin, ASec, AFrame)			dc.b	0			; 9 Reserved			dc.w	0			; 10 Reserved			dc.l	VolumeData	;Buffer Pointer (reserved)			VolumeDataL_volume	dc.b	$00			;L-channel volumeR_volume	dc.b	$00			;R-channel volume			dc.w	0			;reserved			ENDP		END