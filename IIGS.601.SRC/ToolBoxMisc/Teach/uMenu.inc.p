Handle));		   end;    {of DoSelectAll}procedure DoShowClipboard;		{ new for 6.0.1, 25-Aug-92 DAL }	function myShowClipboard(flags: integer; theRect:rectPtr): longint;		inline $A2,$1516,$22,$E10000;begin	if myShowClipboard($8000,nil) <> 0 then;end;Function DoFindIt(theText:str255):Boolean;{ 	Given an input string this routine will set the selection of the current text edit record	to the next occurence of the given string. }		var		TheHandle : handle;		thePtr,currPtr,MungePtr1,MungePtr2:Ptr;		MyStrPtr:String255Ptr;		Temp,findStrLen : integer;		CurrentOffset:Longint;		totalSize : LongInt;		theRecord:TERecordHndl;		SelStart,SelEnd:Longint;		Found:Boolean;			begin	{ First allocate a handle to stuff all the text into... }		theRecord:=TERecordHndl(GetCtlHandleFromID(FrontWindow,MainWindowID));		TheHandle := NewHandle(1,MyMemoryID,0,NIL);		totalSize := TEGetText (  							tedataIsTextBlock+refIsHandle*8,			  			{ Text Descriptor }							teTextRef(TheHandle),	 									  	{ Text Ref }							0,											  			{ Text Length }							0,											  			{ Style Descriptor }							teStyleRef(0),													{ Style Ref }							theRecord	   		{ Control Handle }							);		If _ToolErr=$0201 then 		  begin			Temp := MyAlertWindow($34,NIL,ptr(15));			DoFindIt:=false;			Exit(DoFindIt);		  end;					If _ToolErr <>0 then 		  begin			DoFindIt:=false;			Exit(DoFindIt);		  end;			{ Now that we have the handle containing the text we want, lets lock it down and deref it to   speed this process up... }    		hLock(theHandle);		thePtr:=theHandle^;		{ 	Set the current offset into the text edit record to the end of the current selection or if the 	start of file flag is set then just start from the beginning of the file...}		SelStart:=0;		SelEnd:=0;		If (FindRepFlags mod 2)=0 then			TEGetSelection(SelStart,SelEnd,theRecord)		else FindRepFlags:=FindRepFlags-1; {be sure to reset the flag...}				CurrentOffset:=SelEnd;		FindStrLen:=Length(theText);		{ At this point currentOffset should equal the offset into the text to start searching  and thePtr should point to the start of the text. theText is the string to find, its a  pascal string...}{ and now, we actually start looking for the data we want to find. right now we use a simple   loop, but in the future I expect to use the GString toolset.}		Found:=false;		Found:=FindNext(thePtr,theText,(FindRepFlags=2),totalSize,CurrentOffset);		  { Presumably we have either found the string or are ready to throw up our hands.	If we found the string, then set the selection and return }    		If Found then		  begin		    SelStart:=CurrentOffset;			SelEnd:=SelStart+Length(theText);			TESetSelection(SelStart,SelEnd,theRecord);			TEScroll(1,SelStart,0,NIL);		{Put the found selection in the middle of the window}		  end;		  { Now get rid of the allocated handle... }		DisposeHandle(theHandle);		DoFindIt:=Found;	end;		{ Data used by Find/Replace features... 		FindStr		:str255;		RepStr		:str255;		FindRepFlags:Integer; }	   Procedure FancyUpdate(theWindow:GrafPortPtr);{ This procedure fixes specific problems with the updating of text edit records and the selection	of old text edit records. This procedure allows taskmaster to handle any pending activate	events, then it redraws the controls in the front most window.}		var	oldTaskMask:Longint;		theResult:Integer;		counter:integer;		begin		counter:=2;		repeat			theResult:=TaskMaster(activeMask,Event);			counter:=counter-1;		until theResult+counter=0;		beginUpdate(FrontWindow);		drawcontrols(FrontWindow);		EndUpdate(FrontWindow);	end;	Procedure DoFindDLog;	Var		theDLog:GrafPortPtr;			OkFlag:Boolean;			theEditLine:LERecHndl;			theCaseItem,theStartItem, theFindButton:CtlRecHndl;			i:Integer;    		theState:Byte;			theCtlID: LongInt;			dummy: integer;							procedure HitOne(theControlID:LongInt);			var {theControlID:Integer;}			tempStrHand:Handle;			tempStr:Str255;			tempSize,j:Integer;				begin			{theControlID:=Event.wmTaskData4;}			case theControlID of				$2006:Begin						OKFlag:=true;						CloseWindow(theDLog);					  End;				$2005:begin						okFlag:=true;						tempStrHand:=Handle(leGetTextHand(theEditLine));						tempSize:=LEGetTextLen(theEditLine);						tempStr[0]:=chr(tempSize);						for j:=1 to tempSize do	  						tempStr[j]:=Chr(tempStrHand^^[j]);						FindRepFlags:=0;						If GetCtlValue(theStartItem)<>0 then FindRepFlags:=FindRepFlags+1;						If GetCtlValue(theCaseItem)=0 then FindRepFlags:=FindRepFlags+2;												CloseWindow(theDLog);						FindStr:=tempStr; {Save the find string for later...}						If Length(tempStr)=0 then Exit(HitOne);{	Now get the text edit activate message for the window  to prevent "Funny updating" }						WaitCursor;						FancyUpdate(FrontWindow);						If Not(DoFindIt(tempStr)) then sysBeep;						InitCursor;					  End;			End;		end;					begin   	If Not(ValidFront) then exit(DoFindDLog);		InitCursor;		dummy := WindowGlobal(1);		theDLog:=NewWindow2(NIL,0,							NIL,NIL,							$0002, Ref($2000),							$800E);		dummy := WindowGlobal($fffe);		theCaseItem:=GetCtlHandleFromID(theDLog,$2003);		theStartItem:=GetCtlHandleFromID(theDLog,$2004);		theFindButton:=GetCtlHandleFromID(theDLog,$2005);				theEditLine:=LERecHndl(GetCtlTitle(GetCtlHandleFromID(theDLog,$2002)));		If length(FindStr)>0 then		  begin		    LESetText(ptr(ord4(@FindStr)+1),length(FindStr),theEditLine);			LESetSelect(0,255,theEditLine);		  end;		Event.wmTaskMask := $001F3007;  					OkFlag := false;      			{ Done flag will be set by Quit item. }		repeat			i:=LEGetTextLen(theEditLine);			theState:=theFindButton^^.ctlHilite;			If (theState=noHilite) and (i=0) then		  		HiliteControl(inactiveHilite,theFindButton);			If (theState=inactiveHilite) and (i<>0) then		 		HiliteControl(noHilite,theFindButton);			theCtlID := MyDoModalWindow(Event,Nil,VoidProcPtr($80000000),Nil,$4008);			HitOne(theCtlID);		until OkFlag;		Event.wmTaskMask := $001FFFFF;	end;		Procedure DoFindNext;	begin	  If Not(ValidFront) then Exit(DoFindNext);		WaitCursor;		If length(FindStr)>0 then			If Not(DoFindIt(FindStr)) then sysBeep;		InitCursor;	end;	Procedure DoRepNext;	var 	theRecord:TERecordHndl;		begin	  If Not(ValidFront) then Exit(DoRepNext);		WaitCursor;		If length(FindStr)>0 then			If Not(DoFindIt(FindStr)) then sysBeep			else			  begin				theRecord:=TERecordHndl(GetCtlHandleFromID(FrontWindow,MainWindowID));				TEReplace(0,TETextRef(@RepStr),0,0,TEStyleRef(0),theRecord);			  end;		InitCursor;	end;		Procedure DoReplaceDLog;	Var		theDLog:GrafPortPtr;			OkFlag:Boolean;			theEditLine,theRepLine:LERecHndl;			theCaseItem,theStartItem, theRepButton, theRepAllButton:CtlRecHndl;			i:Integer;			theState:Byte;			theCtlID: Longint;			dummy: integer;				procedure HitOne(theControlID:LongInt);			var {theControlID:Integer;}			tempStrHand:Handle;			tempStr:Str255;			tempSize,j:Integer;			theRecord:TERecordHndl;		begin			{theControlID:=Event.wmTaskData4;}			case theControlID of				$3009:Begin						OKFlag:=true;						CloseWindow(theDLog);					  End;				$3007,$3008:begin						okFlag:=true;						tempStrHand:=Handle(leGetTextHand(theEditLine));						tempSize:=LEGetTextLen(theEditLine);						tempStr[0]:=chr(tempSize);						for j:=1 to tempSize do	  						tempStr[j]:=Chr(tempStrHand^^[j]);						FindStr:=tempStr; {Save the find string for later...}						tempStrHand:=Handle(leGetTextHand(theRepLine));						tempSize:=LEGetTextLen(theRepLine);						tempStr[0]:=chr(tempSize);						for j:=1 to tempSize do	  						tempStr[j]:=Chr(tempStrHand^^[j]);						RepStr:=tempStr; {Save the find string for later...}						FindRepFlags:=0;						If GetCtlValue(theStartItem)<>0 then FindRepFlags:=FindRepFlags+1;						If GetCtlValue(theCaseItem)=0 then FindRepFlags:=FindRepFlags+2;												CloseWindow(theDLog);						If Length(FindStr)=0 then exit(HitOne);{	Now get the text edit activate message for the window  to prevent "Funny updating" }						WaitCursor;						FancyUpdate(FrontWindow);								theRecord:=TERecordHndl(GetCtlHandleFromID(FrontWindow,MainWindowID));						If Not(DoFindIt(FindStr)) then sysBeep						else TEReplace(0,TETextRef(@RepStr),0,0,TEStyleRef(0),theRecord);						If theControlID=$3008 then {Replace all} 						  While DoFindIt(FindStr) do						    TEReplace(0,TETextRef(@RepStr),0,0,TEStyleRef(0),theRecord);						InitCursor;					  End;			End;		end;					begin	  If Not(ValidFront) then Exit(DoReplaceDLog);		dummy := WindowGlobal(1);		theDLog:=NewWindow2(NIL,0,							NIL,NIL,							$0002, Ref($3000),							$800E);		dummy := WindowGlobal($fffe);		InitCursor;		theCaseItem:=GetCtlHandleFromID(theDLog,$2003);		theStartItem:=GetCtlHandleFromID(theDLog,$2004);		theRepButton:=GetCtlHandleFromID(theDLog,$3007);		theRepAllButton:=GetCtlHandleFromID(theDLog,$3008);		theRepLine:=LERecHndl(GetCtlTitle(GetCtlHandleFromID(theDLog,$3006)));		If length(RepStr)>0 then		  begin		    LESetText(ptr(ord4(@RepStr)+1),length(RepStr),theRepLine);			LESetSelect(0,255,theRepLine);		  end;		theEditLine:=LERecHndl(GetCtlTitle(GetCtlHandleFromID(theDLog,$2002)));		If length(FindStr)>0 then		  begin		    LESetText(ptr(ord4(@FindStr)+1),length(FindStr),theEditLine);			LESetSelect(0,255,theEditLine);		  end;		Event.wmTaskMask := $001F3007;  					OkFlag := false;      			{ Done flag will be set by Quit item. }		repeat			i:=LEGetTextLen(theEditLine);			theState:=theRepButton^^.ctlHilite;			If (theState=noHilite) and (i=0) then		  		HiliteControl(inactiveHilite,theRepButton);			If (theState=inactiveHilite) and (i<>0) then		 		HiliteControl(noHilite,theRepButton);			theState:=theRepAllButton^^.ctlHilite;			If (theState=noHilite) and (i=0) then		  		HiliteControl(inactiveHilite,theRepAllButton);			If (theState=inactiveHilite) and (i<>0) then		 		HiliteControl(noHilite,theRepAllButton);			theCtlID := MyDoModalWindow(Event,Nil,VoidProcPtr($80000000),Nil,$4008);			HitOne(theCtlID);		until OkFlag;		Event.wmTaskMask := $001FFFFF;	end;			procedure DoChooseFont;	var		ignore : integer;		ThisStyle : TEStyle;		TempHandle : handle;				ThisHandle : ctlRecHndl;				TheFontGlobals : FontGlobalsRecord;				TempID : FontID;		   begin   {of ChooseFont}	  If Not(ValidFront) then Exit(DoChooseFont);   		{ Create a Temporary handle for GetSelection Style }		TempHandle := NewHandle (20,MyMemoryID,0,NIL);				{ Get the handle to the TE control for the top window }		ThisHandle := GetCtlHandleFromID(FrontWindow,MainWindowID);		   		{ Get the current font of the selection }   		ignore := TEGetSelectionStyle(ThisStyle,TEStyleGroupHndl(TempHandle),TERecordHndl(thisHandle));				{ Use it as the default for ChooseFont }   		ThisStyle.styleFontID := ChooseFont(ThisStyle.styleFontID,0);		{ Only change the selection if a fontID is returned... }		If Longint(ThisStyle.styleFontID)<>0 then		  begin		{ Set font to user's choice }		    TEStyleChange(teReplaceFont+teReplaceSize+teReplaceAttributes,ThisStyle,TERecordHndl(thisHandle));						    ignore := GetFontLore(TheFontGlobals,sizeof(FontGlobalsRecord));				    TempID.famNum := TheFontGlobals.fgFontID;		    TempID.fontStyle := TheFontGlobals.fgStyle;		    TempID.fontSize := TheFontGlobals.fgSize;				    SetPurgeStat(TempID,$0010);		  end;		DisposeHandle (TempHandle);   end;    {of ChooseFont}procedure DoSetFont   (TheFam : integer);	var		ThisStyle : TEStyle;				ThisHandle : ctlRecHndl;		   begin   {of DoSetFont}	  If Not(ValidFront) then Exit(DoSetFont);		{ Get the handle to the TE control for the top window }		ThisHandle := GetCtlHandleFromID(FrontWindow,MainWindowID);				ThisStyle.styleFontID.FamNum := TheFam;				{ Set font to user's choice }		TEStyleChange(teReplaceFont,ThisStyle,TERecordHndl(thisHandle));   end;    {of DoSetFont}procedure DoSetSize   (TheSize : integer);	var		ThisStyle : TEStyle;				ThisHandle : ctlRecHndl;		   begin   {of DoSetSize}	  If Not(ValidFront) then Exit(DoSetSize);		{ Get the handle to the TE control for the top window }		ThisHandle := GetCtlHandleFromID(FrontWindow,MainWindowID);						ThisStyle.styleFontID.fontSize := TheSize;				{ Set font to user's choice }		TEStyleChange(teReplaceSize,ThisStyle,TERecordHndl(thisHandle));   end;    {of DoSetSize}procedure DoSetStyle   (TheStyle : integer);	var		ThisStyle : TEStyle;				ThisHandle : ctlRecHndl;		   begin   {of DoSetStyle}	  If Not(ValidFront) then Exit(DoSetStyle);		{ Get the handle to the TE control for the top window }		ThisHandle := GetCtlHandleFromID(FrontWindow,MainWindowID);						ThisStyle.styleFontID.fontStyle := TheStyle;				{ Set font to user's choice }		if TheStyle = 0 			then TEStyleChange(teReplaceAttributes,ThisStyle,TERecordHndl(thisHandle))			else TEStyleChange(teSwitchAttributes,ThisStyle,TERecordHndl(thisHandle));   end;    {of DoSetStyle}procedure DoMenu;   {Procedure to handle all menu selections.  Examines the Event.TaskData    menu item ID word from TaskMaster (from Event Manager) and calls the    appropriate routine.  While the routine is running the menu title is    still highlighted.  After the routine returns, we unhilight the    menu title.}   var menuNum : integer;       itemNum : integer;   begin   {of DoMenu}       menuNum := HiWord (Event.wmTaskData);       itemNum := LoWord (Event.wmTaskData);          case itemNum of           AboutItem    	:  begin								DoAboutItem;							   end;           CloseItem    	:  DoCloseTop;           QuitItem     	:  DoQuitItem;           UndoItem     	:  { Handled by taskmaster };           CutItem      	:  { Handled by taskmaster };           CopyItem     	:  { Handled by taskmaster };           PasteItem    	:  { Handled by taskmaster };           ClearItem    	:  { Handled by taskmaster };		   SelectAllItem	:  DoSelectAll;		   ShowClipItem		:  DoShowClipboard;		   FindItem			:  DoFindDLog;		   FindSameItem		:  DoFindNext;		   ReplaceItem		:  DoReplaceDLog;		   RepSameItem		:  DoRepNext;		   NewItem			:  DoNewWindow;		   OpenItem			:  DoOpenWindow;		   ImportItem		:  DoImportFile;		   SaveItem			:  DoSave;		   SaveAsItem		:  DoSaveAs;		   SaveCopyAsItem	:  DoSaveCopyAs(TeachFType);		   PageSetupItem 	:  DoPageSetupItem;		   PrintItem		:  DoPrintItem;		   PlainItem 		:  DoSetStyle(0);		   BoldItem 		:  DoSetStyle(boldMask);		   ItalicItem 		:  DoSetStyle(italicMask);		   UnderlineItem 	:  DoSetStyle(underlineMask);		   ShadowItem 		:  DoSetStyle(shadowMask);		   OutlineItem 		:  DoSetStyle(outlineMask);		   Size8Item		:  DoSetSize(8);		   Size10Item		:  DoSetSize(10);		   Size12Item		:  DoSetSize(12);		   Size16Item		:  DoSetSize(16);		   Size20Item		:  DoSetSize(20);		   Size24Item		:  DoSetSize(24);		   ChooseFontItem 	:  DoChooseFont;       otherwise           if ItemNum >= FirstFontItem then DoSetFont(ItemID2FamNum(ItemNum));       end;       HiliteMenu (false,menuNum);     {Unhighlight the menu title}   end;    {of DoMenu}procedure SetUpMenus;   {Procedure to install our menu titles and their items in the system menu    bar and to redraw it so we can see them.}   var height : integer;   begin   {of SetUpMenus}		SetSysBar(NewMenubar2(RefIsResource,ref(1),NIL));		SetMenuBar(NIL);				FixAppleMenu (AppleMenuID);               {Add DAs to apple menu    }						FixFontMenu(FontMenuID,FirstFontItem,0);				height := FixMenuBar;                     {Set sizes of menus       }		DrawMenuBar;  { 8-Dec-91 DAL }   end;    {of SetUpMenus}