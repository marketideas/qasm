PROCEDURE aboutme;      TYPE        twopoint = RECORD                     pt1: point;                     pt2: point;                   END;      VAR        tempdialog: GrafPortPtr;        temphandle: handle;        temprect: rect;        tempinteger: integer;        tempStr: str255;        templong: longint;        tempevent, wallyevent: eventrecord;        ok: boolean;        {Vars for zoom...}        r: rect;        ok2: boolean;        p1, p2: integer;        d1, d2: point;        history: ARRAY [1..50] OF twopoint;        historyindex: integer;        i: integer;        oldport: GrafPortPtr;{ Call with something like:  Zoom(WindowPtr(theDialog),15);}      FUNCTION frandv: integer;        BEGIN          frandv := abs(random MOD 10) + 1;        END;      FUNCTION frandh: integer;        BEGIN          frandh := abs(random MOD 15) + 1;        END;      PROCEDURE zoom(mywindow: windowptr;                     historymax: integer);        VAR          walter: integer;          oldrgn, clprgn, workrgn: RegionHndl;        PROCEDURE drawsomething(t: twopoint;                                erase: boolean);          BEGIN		  	If erase then			  SetSolidPenPat(White)			else			  SetSolidPenPat(Black);            WITH t DO              BEGIN                moveto(pt1.h, pt1.v);                lineto(pt2.h, pt2.v);              END;          END;        BEGIN {main program}          oldPort:=getport;          setport(grafportptr(mywindow));		  PenNormal;          clprgn := newrgn;          oldrgn := newrgn;          workrgn := newrgn;          copyrgn(mywindow^.cliprgn, oldrgn);          setrectrgn(clprgn, 0, 0, 400, 340);          setrectrgn(workrgn, 160, 54, 254, 69);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 93, 108, 277, 124);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 6, 130, 110, 147);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 93, 91, 208, 106);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 93, 39, 253, 52);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 93, 12, 295, 29);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 260, 127, 320, 147);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 188, 127, 248, 147);          diffrgn(clprgn, workrgn, clprgn);          setrectrgn(workrgn, 8, 8, 90, 90);          diffrgn(clprgn, workrgn, clprgn);          setclip(clprgn);          { Setpenmode(ModeXor); }          REPEAT {call Desk Manager to perform any periodic}            drawsomething(history[historyindex], false);            IF historyindex = historymax THEN              BEGIN                drawsomething(history[1], true);              END;            IF historyindex <> historymax THEN              BEGIN                historyindex := historyindex + 1;              END            ELSE              BEGIN                FOR walter := 2 TO historymax DO                  BEGIN                    history[walter - 1].pt1 := history[walter].pt1;                    history[walter - 1].pt2 := history[walter].pt2;                  END;              END;            WITH history[historyindex] DO              BEGIN                pt1.h := history[historyindex - 1].pt1.h + d1.h;                pt1.v := history[historyindex - 1].pt1.v + d1.v;                pt2.h := history[historyindex - 1].pt2.h + d2.h;                pt2.v := history[historyindex - 1].pt2.v + d2.v;              END;            WITH history[historyindex] DO              BEGIN                WITH r DO                  BEGIN                    IF (pt1.h < 0) THEN                      BEGIN                        d1.h := frandh;                        pt1.h := 0;                      END;                    IF (pt1.h > right) THEN                      BEGIN                        d1.h := frandh * ( - 1);                        pt1.h := right;                      END;                    IF (pt1.v < 0) THEN                      BEGIN                        d1.v := frandv;                        pt1.v := 0;                      END;                    IF (pt1.v > bottom) THEN                      BEGIN                        d1.v := frandv * ( - 1);                        pt1.v := bottom;                      END;                    IF (pt2.h < 0) THEN                      BEGIN                        d2.h := frandh;                        pt2.h := 0;                      END;                    IF (pt2.h > right) THEN                      BEGIN                        d2.h := frandh * ( - 1);                        pt2.h := right;                      END;                    IF (pt2.v < 0) THEN                      BEGIN                        d2.v := frandv;                        pt2.v := 0;                      END;                    IF (pt2.v > bottom) THEN                      BEGIN                        d2.v := frandv * ( - 1);                        pt2.v := bottom;                      END;                  END;              END;          UNTIL Button(0);          showcursor;          setclip(oldrgn);          disposergn(workrgn);          disposergn(clprgn);          disposergn(oldrgn);           setport(oldport);        END;      {End Zoom...}      BEGIN		TempStr := 'Untitled';		TempDialog := NewWindow2	(@TempStr,			{ Title reference}							 0,						{ Ref con }							 @DrawThisWindow,		{ Draw routine }							 NIL,					{ DefProc pointer }							 RefIsResource,			{ Param Table Descriptor }							 ref(127),			{ Param Table Reference }							 rWindParam1);			{ Param Table Type }          {Zoom init code...}		  SetPort(TempDialog);          r := windowptr(tempdialog)^.portrect;          p1 := abs(random MOD r.right);          p2 := abs(random MOD r.bottom);          setpt(history[1].pt1, p1, p2);          p1 := abs(random MOD r.right);          p2 := abs(random MOD r.bottom);          setpt(history[1].pt2, p1, p2);          d1.h := frandh;          d1.v := frandv;          d2.h := frandh;          d2.v := frandv;          historyindex := 1;          Setpensize(1, 1);          REPEAT            zoom(windowptr(tempdialog), 15);          UNTIL Button(0);          CloseWindow(tempdialog);      END;