tHandle  = ^IntPointer;	var				TheNewHandle : IntHandle;		Size : integer;begin	Size := length(PStringPtr^);	TheNewHandle := IntHandle(NewHandle(2+size,MyMemoryID,0,NIL));		BlockMove(@PStringPtr^[1],ptr(2+LongInt(TheNewHandle^)),size);		TheNewHandle^^ := size;		PStringToNewC1String := handle(TheNewHandle);end;procedure	C1OutputToC1Input (TheHandle : handle);	var MyPointer:ptr;		begin		{MoveLeft(TheHandle^^[2],TheHandle^^[0],GetHandleSize(TheHandle)-2);}				{BlockMove(@TheHandle^^[2],@TheHandle^^[0],GetHandleSize(TheHandle)-2);}				MyPointer:=theHandle^;		BlockMove(ptr(ord4(MyPointer)+2),MyPointer,GetHandleSize(TheHandle)-2);	end;{Function ScanDown(var theStr:str255):str255;		var	i,j:integer;		begin		  j:=0;		  ScanDown:='';		  i:=length(theStr);		  If i<2 then exit(ScanDown);		  repeat		    if (thestr[i]='/') or (thestr[i]=':') then			  begin			    j:=i;				i:=1;			  end			else i:=i-1;		  until (i=1);		  If j<>0 then		    begin			  ScanDown:=copy(theStr,0,j);		      theStr:=copy(theStr,j+1,length(theStr)-j);			end;	end;}procedure ExtractFilename(thePath: Handle; theTitle: String255Ptr);type	pathArrayType = packed array[0..65535] of char;	pathPtrType = ^pathArrayType;	WordPtr = ^integer;var	len, i, newLen: integer;	pathPtr: pathPtrType;begin{	debugstr('ExtractFilename'); }	theTitle^ := '';	pathPtr := pathPtrType(thePath^);	len := WordPtr(pathPtr)^;	i := len - 2;	while (i>1) and (pathPtr^[i+2] <> ':') do		i := i - 1;	if i>1 then begin		newLen := len - i - 1;		BlockMove(Ptr(longint(pathPtr)+i+3),Ptr(@theTitle^[1]),newLen);		theTitle^[0] := chr(newLen);	end;end;procedure	C1OutputToPString (TheHandle : handle);	var MyPointer: String255Ptr;		begin		MyPointer := String255Ptr(theHandle^);		MyPointer^[0] := MyPointer^[2];		BlockMove(ptr(ord4(MyPointer)+4),ptr(ord4(MyPointer)+1),ord(MyPointer^[2]));	end;FUNCTION MyErrorWindow ( i:Integer; j:Ptr; k:Integer) : Integer ;begin	InitCursor;	MyErrorWindow:=ErrorWindow(i,j,k);End;FUNCTION MyAlertWindow ( i:Integer; j:Ptr; k:UNIV ptr) : Integer ;begin	InitCursor;	MyAlertWindow:=AlertWindow(i,j,Ref(k));End;Procedure MyOOMRtn; External;Procedure InitMemWatcher;begin	ReserveHndl := NewHandle($4000,MyMemoryID,0,Nil);	OOMFlag := (_toolErr<>0);	OOMFlagChanged := FALSE;	AddToOOMQueue(Ptr(@MyOOMRtn));end;Procedure WatchMemory;var	temp: Integer;begin	{ added 25-Aug-92 DAL }	if OOMFlag then begin		ReserveHndl := NewHandle($4000,MyMemoryID,0,nil);		OOMFlag := (_toolErr<>0);	end;	if OOMFlag then	  begin		if not OOMFlagChanged then			temp:=MyAlertWindow($34,NIL,ptr(18));		OOMFlagChanged := TRUE;		PurgeAll(0);		CompactMem;		ReserveHndl := NewHandle($4000,MyMemoryID,0,Nil);		OOMFlag := (_toolErr<>0);	  end	else		OOMFlagChanged := FALSE;end;Procedure CloseMemWatcher;begin	if not OOMFlag then DisposeHandle(ReserveHndl);	RemoveFromOOMQueue(Ptr(@MyOOMRtn));end;