{**********************************************************************{*{* Teach uEvent (implemenation){*{* Copyright (c){* Apple Computer, Inc.  1986-1993{* All Rights Reserved.{*{* This file contains the code which implements the {* main event loop used by the Teach program.{*{**********************************************************************}{$R-}var	LastID		 : FontID;				{ Private global used to determine if the style menus}	LastCommon	 : Integer;								{ need changing... }											LastWindow   : GrafPortPtr;			{ This private global is used in CheckFrontW.										{ to prevent extra work when the windows										{ have not changed.  It is initialized										{ at the beginning of MainEvent. }PROCEDURE Debug;  INLINE $0000;{*******************************************************************}{{ CheckFrontW{{ This routine checks the front window to see if any changes need{ to be made to the menu items.{{ We do this so that the edit items are only active when a desk{ accessory is active.{{ This also will idle the cursor when needed{{*******************************************************************}procedure CheckFrontW;var 	theWindow    : GrafPortPtr;	procedure   EnableDAItems;		begin			EnableMItem(UndoItem);			EnableMItem(CloseItem);			EnableMItem(CutItem);			EnableMItem(CopyItem);			EnableMItem(ClearItem);			EnableMItem(PasteItem);		end;	procedure   EnableAppItems;		begin			EnableMItem(SelectAllItem);			EnableMItem(CloseItem);			EnableMItem(SaveItem);			EnableMItem(SaveAsItem);			EnableMItem(SaveCopyAsItem);			EnableMItem(PageSetupItem);			EnableMItem(PrintItem);			EnableMItem(FindItem);			EnableMItem(ReplaceItem);			EnableMItem(FindSameItem);			EnableMItem(RepSameItem);			SetMenuFlag ($FF7F,SizeMenuID);   { enable the size menu }			SetMenuFlag ($FF7F,StyleMenuID);  { enable the style menu }			SetMenuFlag ($FF7F,FontMenuID);   { enable the font menu }		end;	procedure   DisableDAItems;		begin			DisableMItem(UndoItem);			DisableMItem(CutItem);			DisableMItem(CopyItem);			DisableMItem(ClearItem);			DisableMItem(PasteItem);		end;	procedure	DisableAppItems;		begin			SetMenuFlag ($0080,FontMenuID);   { disable the font menu }			SetMenuFlag ($0080,StyleMenuID);   { disable the style menu }			SetMenuFlag ($0080,SizeMenuID);   { disable the size menu }			DisableMItem(SaveItem);			DisableMItem(SaveAsItem);			DisableMItem(SaveCopyAsItem);			DisableMItem(PageSetupItem);			DisableMItem(PrintItem);			DisableMItem(SelectAllItem);			DisableMItem(FindItem);			DisableMItem(ReplaceItem);			DisableMItem(FindSameItem);			DisableMItem(RepSameItem);		end;	procedure FixStyleMenus;		var		ignore, tempItemID : integer;		ThisStyle : TEStyle;		TempHandle : handle;		ThisHandle : ctlRecHndl;		TempID : FontID;		CommonStuff:Integer;			  begin	  	If Not(ValidFront) then exit(FixStyleMenus);   		{ Create a Temporary handle for GetSelection Style }		TempHandle := NewHandle (20,MyMemoryID,0,NIL);		ThisHandle := GetCtlHandleFromID(FrontWindow,MainWindowID);   		CommonStuff := TEGetSelectionStyle(ThisStyle,TEStyleGroupHndl(TempHandle),TERecordHndl(thisHandle));		TempID := ThisStyle.StyleFontID;		If 	(TempID.famnum=LastID.FamNum) and			(TempID.fontSize=LastID.fontSize) and			(TempID.fontStyle=LastID.fontStyle) and			(LastCommon=CommonStuff) then 			  begin			    DisposeHandle(TempHandle);				Exit(FixStyleMenus);			  end;					LastCommon:=CommonStuff;{ handle case of font change... }		If BAND(CommonStuff,$0020)=0 then		  begin			CheckMItem(false,FamNum2ItemID(LastID.Famnum));			LastID.FamNum:=0;		  end		else		 If TempID.famnum<>LastID.FamNum then		  begin{ Must change the font menu... }			If LastID.FamNum<>0 then				CheckMItem(false,FamNum2ItemID(LastID.Famnum));			If BAND(CommonStuff,$0020)<>0 then				begin				tempItemID := FamNum2ItemID(TempID.famNum);				if _toolErr = 0 then					CheckMItem(true,tempItemID);				end;			LastID.FamNum:=tempID.FamNum;		  end;		  		If BAND(CommonStuff,$0010)=0 then TempID.fontSize:=0;	    If TempID.fontSize<>LastID.fontSize then		  begin{ must change the font menu... }			case LastID.fontSize of				 8:CheckMItem(false,Size8Item);				10:CheckMItem(false,Size10Item);				12:CheckMItem(false,Size12Item);				16:CheckMItem(false,Size16Item);				20:CheckMItem(false,Size20Item);				24:CheckMItem(false,Size24Item);			 end;			case TempID.fontSize of				 8:CheckMItem(true,Size8Item);				10:CheckMItem(true,Size10Item);				12:CheckMItem(true,Size12Item);				16:CheckMItem(true,Size16Item);				20:CheckMItem(true,Size20Item);				24:CheckMItem(true,Size24Item);			 end;			 lastID.fontSize:=tempID.FontSize;		  end;			 		If BAND(CommonStuff,$0001)=0 then		  begin			  CheckMItem(false,plainItem);			  CheckMItem(false,BoldItem);			  CheckMItem(false,italicItem);			  CheckMItem(false,underlineItem);			  CheckMItem(false,OutlineItem);			  CheckMItem(false,ShadowItem);		  end		else		  begin{ Must change the style menu ... }		  	lastID.fontStyle:=TempID.fontStyle;			If TempID.fontStyle=0 then				CheckMItem(true,PlainItem)			else			  CheckMItem(false,plainItem);			  			If (BAND(TempID.fontStyle,BoldMask)<>0)then 			  CheckMItem(true,BoldItem)			else			  CheckMItem(false,BoldItem);			  			If (BAND(TempID.fontStyle,italicMask)<>0)then 			  CheckMItem(true,italicItem)			else			  CheckMItem(false,italicItem);			  			If (BAND(TempID.fontStyle,underlineMask)<>0)then 			  CheckMItem(true,underlineItem)			else			  CheckMItem(false,underlineItem);			  			If (BAND(TempID.fontStyle,outlineMask)<>0)then 			  CheckMItem(true,OutlineItem)			else			  CheckMItem(false,OutlineItem);			  			If (BAND(TempID.fontStyle,ShadowMask)<>0)then 			  CheckMItem(true,ShadowItem)			else			  CheckMItem(false,ShadowItem);		  end;		DisposeHandle(TempHandle);	  end;	  	  	procedure testCursorType;		var	CurrentCursor:Boolean;		thePoint:Point;		tempRect:Rect;			begin{ First determine if the IBeam is up or not...}		CurrentCursor:= (ArrowCursor=GetCursorAdr);		{ Next check to see if the window is NIL or a system window }		If theWindow = nil then		  begin		    if NOT(CurrentCursor) then initCursor;			Exit(testCursortype);		  end;		if GetSysWFlag (theWindow) then 		  begin   {Set up for da windows}		    if NOT(CurrentCursor) then initCursor;			Exit(testCursortype);		  end;		  { If we get here then the front window is a doc window }		SetPort(theWindow);		getMouse(thePoint);		tempRect:=theWindow^.portRect;		tempRect.h2:=tempRect.h2-24;		if PtInRect(thePoint,tempRect) then		  begin		    if not(GetCursorAdr=IBeamPtr) then SetCursor(IBeamPtr^);		  end		else		  if Not(CurrentCursor) then initCursor;		  { Now the cursor is properly idled... }	end; { testCursorType }	Procedure FixEditMenu;		var	selectBegin, selectEnd: Longint;		begin	If Not(ValidFront) then exit(FixEditMenu);		TEGetSelection(selectBegin,selectEnd,nil);	if selectEnd = selectBegin then		begin		DisableMItem(CutItem);		DisableMItem(CopyItem);		DisableMItem(ClearItem);		end	else		begin		EnableMItem(CutItem);		EnableMItem(CopyItem);		EnableMItem(ClearItem);		end;		if GetScrapSize(textScrap) > 0 then		EnableMItem(PasteItem)	else		DisableMItem(PasteItem);			end;	procedure HiliteDynamicMenus; { added 8-Dec-91 DAL -- reduce flicker }	begin		HiliteMenu(false,$904); { Font menu }		HiliteMenu(false,$905); { Style menu }		HiliteMenu(false,$906); { Size menu }	end;begin   {of CheckFrontW}	{ Get the front window into local storage.}	theWindow := FrontWindow;		{ If the LastWindow is this window, we are all set. }	if theWindow = lastWindow then	  begin	  	  testCursorType; {See if the cursor needs changing}		  FixStyleMenus; {See if the style menus need changing}		  FixEditMenu;	  	  Exit(CheckFrontW);	  end;		{ If there are no windows, everything should be disabled }	if theWindow = nil then 		begin			DisableDAItems;			DisableAppItems;			DisableMItem(CloseItem);			HiliteDynamicMenus; { 8-Dec-91 DAL }		end 	else		begin			{ Now look at what kind of window we have...}			if GetSysWFlag (theWindow) then 				begin   {Set up for da windows}					DisableAppItems;					EnableDAItems;					HiliteDynamicMenus; { 8-Dec-91 DAL }				end	   		else				begin   {Set up for our windows}					DisableDAItems;					EnableAppItems;					FixEditMenu;					HiliteDynamicMenus; { 8-Dec-91 DAL }				end;		end;		{ Remember this for next time. }	lastWindow := theWindow;end;    {of CheckFrontW}{************************************************************************{{ MainEvent{{ This is the main part of the program.  The program cycles in this{ loop until the user choose select.{{************************************************************************}procedure MainEvent;var    	code, lastTEError, Temp: integer;	ignore: Longint;begin   {of MainEvent}	InitCursor;	ArrowCursor := GetCursorAdr;	HideCursor;	IBeamCursor;	iBeamPtr := GetCursorAdr;	ShowCursor;	LastID.FontSize:=123;	LastID.fontStyle:=127;			Event.wmTaskMask := $001FFFFF;  	{ Allow TaskMaster to do everything. }	Done             := false;      	{ Done flag will be set by Quit item. }	LastWindow 		:= GrafPortPtr(-1);	{ Init this for CheckFrontW, forces it to run first time}	CheckFrontW;	InitCursor;		{ Make cursor show ready }	repeat		WatchMemory;		ignore := HandleDiskInsert($C000,0);		if srqQuitFlag<>0 then begin	{ 19-Jan-93 DAL }			srqQuitFlag := 0;			DoQuitItem;		end;		code := TaskMaster ($FFFF,Event);		case code of		   wInGoAway	: DoCloseTop;		   wInSpecial,		   wInMenuBar	: DoMenu;		end;		if not Done then CheckFrontW;		{ Make sure there aren't any TextEdit errors that weren't caught. }		lastTEError := TEGetLastError(fClearError,Nil);		if lastTEError<>0 then			Temp := MyErrorWindow(0,NIL,lastTEError);	until Done;end; { of MainEvent }