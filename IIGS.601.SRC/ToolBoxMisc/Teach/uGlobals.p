t is pointed to by the	handle stored in a windows refcon. }		theWindowData = Record							theWindName:str32;   {Name of the window in question}							thePathName:str255;	 {Full Pathname of the file it came from}							FileFlags:packed array[0..15] of boolean;						end;								var		{$Z+}   { export names }		MyMemoryID    : integer;      { Application ID assigned by Memory Mgr}		srqQuitFlag   : integer;	  { nonzero if we received an srqQuit request }	   	{$Z-}		Done          : boolean;      { True when quitting}		StaggerCount  : integer;		 { used to stagger windows as they open }		Event         : WmTaskRec;    { All events are returned here}		   		printHndl : prRecHndl;		 { Handle to print record }		WindArray	: Array[1..MaxWinds] of GrafPortPtr;	   { Data used by Find/Replace features... }		FindStr		:str255;		RepStr		:str255;		FindRepFlags:Integer;		{ Used for cursor idling }		iBeamPtr	:CursorPtr;		ArrowCursor	:CursorPtr;	   procedure InitGlobals;IMPLEMENTATION{$i uGlobals.inc.p}END.