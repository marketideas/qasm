unction adds a style change to the style record parameter.*********************************************************************}Function AddStyle(	theFontID: FontID;					theStyles:MWriteStyleRechand;					totalText: Longint): Boolean;	var	howManyStyles, temp: Integer;	theHndlSize: Longint;	begin	AddStyle := FALSE;	howManyStyles := theStyles^^.StyleArraySize + 1;	theHndlSize := GetHandleSize(Handle(theStyles));	if (34+howManyStyles*8) > theHndlSize then		begin		SetHandleSize(theHndlSize+256,Handle(theStyles));		if _toolErr <> 0 then			begin			temp := MyErrorWindow(0,NIL,_ToolErr);			exit (AddStyle);			end;		end;	HLock(Handle(theStyles));	with theStyles^^ do		begin		StyleArraySize := howManyStyles;		StyleArray[howManyStyles].theOffset := totalText - 1;		StyleArray[howManyStyles].theFontID := theFontID;		end;	HUnlock(Handle(theStyles));	AddStyle := TRUE;	end; { AddStyle }{****************************************************************************}{{ Function ReadAWorksGS{{ This routine reads the pertinent data from an AppleWorks GS file.{ It then returns the text as the returned handle and the styling in theStyles{ parameter.{{****************************************************************************}function ReadAWorksGS(	theStyles:MWriteStyleRechand;					theFileName:GSString255Ptr):handle;	type	BlockList = array [0..0] of Handle;	BlockListPtr = ^BlockList;	BlockListHndl = ^BlockListPtr;	var	OpenBlock : OpenRecGS;	ReadBlock : ioRecGS;	MarkBlock : SetPositionRecGS;	CloseBlock: RefNumRecGS;	infoArrayLength, whichBlock,	count, count2, maxRuler, maxTextBlock, temp: Integer;	theInfoArray: AWorksGSArrayHndl;	theBlockListHndl: BlockListHndl;	theBlockListPtr: BlockListPtr;	textBlockSize, textInParagraph, totalText: Longint;	resultText: Handle;	{ ScanParagraph adds the text to the text handle }	Procedure ScanParagraph(srcPtr:ParagraphPtr);		const		EndOfParagraph = 13;			var		inCounter: Integer;		currentFontID: FontID;		theChar: char;		outTextPtr: Ptr;		tempLong: Longint;			begin	{ ScanParagraph }			with currentFontID do			begin			famNum := srcPtr^.fontFamNum;			fontStyle := srcPtr^.fontStyle;			fontSize := srcPtr^.fontSize;			end;		if AddStyle(currentFontID,theStyles,totalText) = false then { error recovery? };		HLock(resultText);		outTextPtr := resultText^;		inCounter := 1;		repeat			theChar := srcPtr^.theText[inCounter];			inCounter := inCounter + 1;			case ord(theChar) of				1:	begin					currentFontID.famNum := ord(srcPtr^.theText[inCounter]) +										256*ord(srcPtr^.theText[inCounter+1]);					inCounter := inCounter + 2;					if AddStyle(currentFontID,theStyles,totalText) 								= false then { error recovery? };					end;				2:	begin					currentFontID.fontStyle := BAND($001F,ord(srcPtr^.theText[inCounter]));					inCounter := inCounter + 1;					if AddStyle(currentFontID,theStyles,totalText) = false then { error recovery? };					end;				3:	begin					currentFontID.fontSize := Byte(srcPtr^.theText[inCounter]);					inCounter := inCounter + 1;					if AddStyle(currentFontID,theStyles,totalText) = false then { error recovery? };					end;				4:	inCounter := inCounter + 1;	{ do not currently support colored text }				5..7:	;	{ ignore these special characters }				otherwise					begin					tempLong := Longint(outTextPtr) + totalText -1;					Ptr(tempLong)^[1] := Byte(theChar);					totalText := totalText + 1;					end;				end;		until theChar = chr(EndOfParagraph);		HUnlock(resultText);		end;		Function HowBigParagraph(whichParagraph: Integer): Integer;		var		count, theBlock, theOffset, nextOffset: Integer;		arrayPtr: AWorksGSArrayPtr;		paragraphFound: Boolean;		tempPtr: Ptr;		grossEstimate: Longint;				begin		HLock(Handle(theInfoArray));		arrayPtr := theInfoArray^;		theBlock := arrayPtr^[whichParagraph].textBlock;		theOffset := arrayPtr^[whichParagraph].offset;		grossEstimate := GetHandleSize(theBlockListPtr^[theBlock]) - theOffset;		if grossEstimate > 1024 then			begin			tempPtr := theBlockListPtr^[theBlock]^;			nextOffset := tempPtr^[1] + tempPtr^[2] * 256;			paragraphFound := FALSE;			for count := 1 to infoArrayLength do				with theInfoArray^^[count] do				if (textBlock = theBlock) and (offset > theOffset) then					begin					if offset < nextOffset then						nextOffset := offset;					end;							HUnlock(Handle(theInfoArray));			HowBigParagraph := nextOffset;			end		else			HowBigParagraph := grossEstimate;		end;	begin	ReadAWorksGS := Nil;	totalText := 1;	theStyles^^.StyleArraySize := 0;	{ open the file }	with OpenBlock do begin		pCount := 15;		pathname := GSString255Ptr(theFileName);		requestAccess := 0;		resourceNumber := 0;		optionList := NIL;	end;		OpenGS (OpenBlock);		if _toolErr <> 0 then		begin		temp := MyErrorWindow(0,NIL,_ToolErr);		exit(ReadAWorksGS);		end;		with CloseBlock do begin		pCount := 1;		refNum := OpenBlock.refNum;		end;		with ReadBlock do begin		pCount := 4;		refNum := OpenBlock.refNum;	end;		{ Read first 4 bytes, to make sure it is Applworks GS format. }	with ReadBlock do begin		DataBuffer := @count2;		requestCount := 2;	end;	ReadGS (ReadBlock);		{ ignore the first word }	ReadGS (ReadBlock);		if _toolErr <> 0 then		begin		temp := MyErrorWindow(0,NIL,_ToolErr);		CloseGS(CloseBlock);		exit(ReadAWorksGS);		end;	if count2 <> 282 then		begin		temp := MyAlertWindow($34,NIL,ptr(19));		CloseGS(CloseBlock);		exit(ReadAWorksGS);		end;		{read in document structure - info array.}	with MarkBlock do begin		pCount := 3;		refNum := OpenBlock.refNum;		base := 0;		displacement := $029C;	end;	SetMarkGS(markBlock);		with ReadBlock do begin		DataBuffer := @infoArrayLength;		requestCount := 2;	end;	ReadGS (ReadBlock);		if _toolErr <> 0 then		begin		temp := MyErrorWindow(0,NIL,_ToolErr);		CloseGS(CloseBlock);		exit(ReadAWorksGS);		end;		theInfoArray := AWorksGSArrayHndl(NewHandle(infoArrayLength*12,										MyMemoryID,$c000,Nil));		if _toolErr <> 0 then		begin		temp := MyErrorWindow(0,NIL,_ToolErr);		CloseGS(CloseBlock);		exit(ReadAWorksGS);		end;		with ReadBlock do begin		DataBuffer := Ptr(theInfoArray^);		requestCount := infoArrayLength*12;	end;	ReadGS (ReadBlock);		if _toolErr <> 0 then		begin		temp := MyErrorWindow(0,NIL,_ToolErr);		CloseGS(CloseBlock);		DisposeHandle(Handle(theInfoArray));		exit(ReadAWorksGS);		end;		{find the text blocks and read them in }		{ How many ruler's must we skip over? And how many text blocks are there? }	maxRuler := 0;	maxTextBlock := 0;	for count := 1 to infoArrayLength do		begin		if theInfoArray^^[count].rulerNumber > maxRuler then			maxRuler := theInfoArray^^[count].rulerNumber;		if theInfoArray^^[count].textBlock > maxTextBlock then			maxTextBlock := theInfoArray^^[count].textBlock;		end;	maxRuler := maxRuler + 1;	maxTextBlock := maxTextBlock + 1;		theBlockListHndl := BlockListHndl(NewHandle(maxTextBlock*sizeof(Handle),									MyMemoryID,attrFixed,Nil));	if _toolErr <> 0 then		begin		temp := MyErrorWindow(0,NIL,_ToolErr);		CloseGS(CloseBlock);		DisposeHandle(Handle(theInfoArray));		exit(ReadAWorksGS);		end;		theBlockListPtr := theBlockListHndl^;		{ Skip over the rulers.  They can be used, perhaps, in the future. }	MarkBlock.base := 2;	MarkBlock.displacement := maxRuler * 52;	SetMarkGS(MarkBlock);		if _toolErr <> 0 then		begin		temp := MyErrorWindow(0,NIL,_ToolErr);		CloseGS(CloseBlock);		DisposeHandle(Handle(theInfoArray));		DisposeHandle(Handle(theBlockListHndl));		exit(ReadAWorksGS);		end;		{glom up the text and styling using the info array as a guide}		for count := 0 to maxTextBlock - 1 do		begin		{ read the block size }				with ReadBlock do begin			DataBuffer := @textBlockSize;			requestCount := 4;		end;		ReadGS (ReadBlock);			if _toolErr <> 0 then			begin			temp := MyErrorWindow(0,NIL,_ToolErr);			CloseGS(CloseBlock);			DisposeHandle(Handle(theInfoArray));			for count2 := 0 to count - 1 do				DisposeHandle(theBlockListPtr^[count2]);			DisposeHandle(Handle(theBlockListHndl));			exit(ReadAWorksGS);			end;				{ allocate memory }		theBlockListPtr^[count] := NewHandle(textBlockSize,MyMemoryID,0,Nil);			if _toolErr <> 0 then			begin			temp := MyErrorWindow(0,NIL,_ToolErr);			CloseGS(CloseBlock);			DisposeHandle(Handle(theInfoArray));			for count2 := 0 to count - 1 do				DisposeHandle(theBlockListPtr^[count2]);			DisposeHandle(Handle(theBlockListHndl));			exit(ReadAWorksGS);			end;				{ read the next text block }				HLock(theBlockListPtr^[count]);		with ReadBlock do begin			DataBuffer := theBlockListPtr^[count]^;			requestCount := textBlockSize;		end;		ReadGS (ReadBlock);			if _toolErr <> 0 then			begin			temp := MyErrorWindow(0,NIL,_ToolErr);			CloseGS(CloseBlock);			DisposeHandle(Handle(theInfoArray));			for count2 := 0 to count do				DisposeHandle(theBlockListPtr^[count2]);			DisposeHandle(Handle(theBlockListHndl));			exit(ReadAWorksGS);			end;		HUnlock(theBlockListPtr^[count]);				end;		{ At this point, I can close the file.  I have the data I need. }	CloseGS(CloseBlock);		{ Now, let's do the translation. }		resultText := NewHandle(0,MyMemoryID,0,Nil);	for count := 1 to infoArrayLength do		begin		whichBlock := theInfoArray^^[count].textBlock;		textInParagraph := HowBigParagraph(count);		{ resize the output handle to accomodate this paragraph }		SetHandleSize(textInParagraph+totalText,resultText);		if _toolErr <> 0 then			begin			temp := MyErrorWindow(0,NIL,_ToolErr);			DisposeHandle(Handle(theInfoArray));			for count := 0 to maxTextBlock - 1 do				DisposeHandle(theBlockListPtr^[count2]);			DisposeHandle(Handle(theBlockListHndl));			exit(ReadAWorksGS);			end;		HLock(theBlockListPtr^[whichBlock]);		ScanParagraph(ParagraphPtr(Longint(theBlockListPtr^[whichBlock]^)+						theInfoArray^^[count].offset));		HUnlock(theBlockListPtr^[whichBlock]);		end;	totalText := totalText - 1;			  { subtract the extra <return> }	SetHandleSize(totalText,resultText);  { chop off any excess memory }	DisposeHandle(Handle(theInfoArray));  { eliminate data read in }	for count := 0 to maxTextBlock - 1 do		DisposeHandle(theBlockListPtr^[count]);	DisposeHandle(Handle(theBlockListHndl));	ReadAWorksGS := resultText;			  { return handle to the text }	end;{****************************************************************************}{{ Function ReadAppleWorks{{ This routine reads the pertinent data from an AppleWorks  file.  It then { returns the text as the returned handle and the styling in theStyles{ parameter.{{****************************************************************************}function ReadAppleWorks(theStyles:MWriteStyleRechand;					theFileName:GSString255Ptr):handle;	var	OpenBlock : OpenRecGS;	ReadBlock : ioRecGS;	MarkBlock : SetPositionRecGS;	CloseBlock: RefNumRecGS;	lineHndl, theText: Handle;	lineSize, ignore: Integer;	outTextLength: Longint;	currentFontID, newFontID: FontID;		Function CheckHeader: Boolean; { returns TRUE if the header is valid }		var		theByte: Byte;				begin		theByte := 0;	{ just to make sure that some thing gets read. }		MarkBlock.displacement := 4;		SetMarkGS(markBlock);		ReadBlock.dataBuffer := @theByte;		ReadBlock.requestCount := 1;		theByte := 0;		ReadGS(ReadBlock);		if theByte <> 79 then			CheckHeader := FALSE		else			CheckHeader := TRUE;		MarkBlock.displacement := 295;		SetMarkGS(markBlock);		end;		Function GetNextLine(buffHndl: Handle): Integer;	{	This wonderful function skips over non-text records.  When it finds		a text record, it loads it into the passed handle and returns the		number of bytes in it.  If there is an error it will return -1. }				type		TwoBytes = packed record			lowByte, highByte: Byte;			end;				var		recordID: TwoBytes;		found: boolean;				begin		GetNextLine := -1;	{ default to failure }		found := FALSE;				while not found do			begin						ReadBlock.dataBuffer := @recordID;			ReadBlock.requestCount := 2;			ReadGS(ReadBlock);						if _toolErr <> 0 then				begin				ignore := MyErrorWindow(0,NIL,_ToolErr);				exit(GetNextLine);				end;						if recordID.highByte = 0 then	{ text line }				begin				ReadBlock.dataBuffer := buffHndl^;				ReadBlock.requestCount := recordID.lowByte;				ReadGS(ReadBlock);								if _toolErr <> 0 then					begin					ignore := MyErrorWindow(0,NIL,_ToolErr);					exit(GetNextLine);					end;								GetNextLine := recordID.lowByte;				found := TRUE;				end			else if recordID.highByte = $d0 then	{ carriage return }				begin				buffHndl^^[2] := $01;				buffHndl^^[3] := $0d;				GetNextLine := 3;				found := TRUE;				end			else if recordID.highByte = $ff then	{ end of file }				begin				GetNextLine := 0;				found := TRUE;				end			else if recordID.highByte > $d0 then	{ formatting info }				begin				{ do nothing }				end			else	{ undefined commands }				begin				{ do nothing }				end;			end;		end;		Procedure ScanTheLine(buffHndl: Handle; length: Integer);		var		index, lineTextSize: Integer;		headerByte: Byte;		theChar: Byte;		nextAddress: Longint;				begin		if buffHndl^^[1] <> $0ff then { ignore this line if it is a ruler }			begin			headerByte := buffHndl^^[2];			lineTextSize := BAND(headerByte,$07f);			if BAND(headerByte,$080) <> 0 then				lineTextSize := lineTextSize + 1;			SetHandleSize(outTextLength+lineTextSize,theText);			if _toolErr <> 0 then				begin				ThisError := _toolErr;				exit(ScanTheLine);				end;			HLock(theText);			for index := 3 to length do				begin				theChar := buffHndl^^[index];				if (theChar > Byte($0C)) then					begin					if (theChar = Byte($16)) or 							(theChar = Byte($17)) then						theChar := Byte($20);					nextAddress := Longint(theText^) + outTextLength;					Ptr(nextAddress)^[1] := theChar;					outTextLength := outTextLength + 1;					end				else					{ handle styling information }					begin					newFontID := currentFontID;					with newFontID do						case theChar of							1: fontStyle := BOR(fontStyle,boldMask);							2: fontStyle := BAND(fontStyle,BNOT(boldMask));							7: fontStyle := BOR(fontStyle,underlineMask);							8: fontStyle := BAND(fontStyle,BNOT(underlineMask));							end;					if newFontID.fidLong <> currentFontID.fidLong then						begin						if not AddStyle(newFontID,theStyles,outTextLength+1) then							{ error recovery } ;						currentFontID := newFontID;						end;					end;				end;			if BAND(headerByte,$080) <> 0 then				begin				nextAddress := Longint(theText^) + outTextLength;				Ptr(nextAddress)^[1] := $0D;				outTextLength := outTextLength + 1;				end;			HUnlock(theText);			if outTextLength > GetHandleSize(theText) then				ThisError := -1;			end;		end;		begin { ReadAppleWorks }		theStyles^^.StyleArraySize := 0;	with currentFontID do		begin		famNum := shaston;		fontSize := 8;		fontStyle := 0;		end;	if AddStyle(currentFontID,theStyles,1) = false then		{ error recovery? };		theText := NewHandle(0,MyMemoryID,0,Nil);	ReadAppleWorks := theText;		{ open the file }	with OpenBlock do 		begin		pCount := 15;		pathname := GSString255Ptr(theFileName);		requestAccess := 0;		resourceNumber := 0;		optionList := NIL;		end;		OpenGS (OpenBlock);		if _toolErr <> 0 then		begin		ignore := MyErrorWindow(0,NIL,_ToolErr);		exit(ReadAppleWorks);		end;		with CloseBlock do		begin		pCount := 1;		refNum := OpenBlock.refNum;		end;		with ReadBlock do		begin		pCount := 4;		refNum := OpenBlock.refNum;		end;		with MarkBlock do		begin		pCount := 3;		refNum := OpenBlock.refNum;		base := 2;		{ old mark plus displacement }		end;		if CheckHeader then		begin		outTextLength := 0;		lineHndl := NewHandle(256,MyMemoryID,attrFixed,Nil);				ThisError := 0;		lineSize := GetNextLine(lineHndl);		while (lineSize > 0) and (ThisError = 0) do			begin			ScanTheLine(lineHndl,lineSize);			if ThisError = 0 then 				lineSize := GetNextLine(lineHndl);			end;		DisposeHandle(lineHndl);		SetHandleSize(outTextLength,theText);		if lineSize < 0 then			ThisError := 1;		end	else		ThisError := 1;		CloseGS(CloseBlock);	end;{****************************************************************************}{{ MyFilterProc{{ This routine is a filter procedure for the SFGetFile2 call in DoImportFile.{ It assumes that any file passed is either valid or is type 0.  If it is{ type 0, it checks the optionlist of the file to be sure it is MacWrite.{{****************************************************************************}Function MyFilterProc(var inputDirEntry: DirEntryRecGS): Integer;	type	OptionListRec = PACKED RECORD		fileSysID: Integer;		typeCreatorStr: PACKED ARRAY[1..8] OF char;		finderFlags: Integer;		location: Point;		windowID: Integer;		iconID: Integer;		reserved: PACKED ARRAY[1..8] OF char;		commentID: Integer;		homeDirID: Longint;		parentDirID: Longint;		end;	OptionListBuf = RECORD		case Boolean  of			false:				( unused: ResultBuf255 );			true:				(				bufSize: Integer;				length: Integer;				theData: OptionListRec;				)		end;	OptionListBufPtr = ^OptionListBuf;	begin	MyFilterProc := displaySelect;	with inputDirEntry do		begin		if fileType <> 0 then			exit (MyFilterProc);		if (fileSysID = hfsFSID) or (fileSysID = appleShareFSID) or				(fileSysID = proDOSFSID) then			begin			if OptionListBuf(optionList^).theData.typeCreatorStr <> 'WORDMACA' then				MyFilterProc := noDisplay;			end		else			MyFilterProc := noDisplay;		end;	end;{****************************************************************************}{{ MyDialogHook{{ This procedure is a parameter to SFPGetFile2.  It responds to the clicks{ in the radio buttons.{{****************************************************************************}{ this variable is used in MyDialogHook and DoImportFile }var	MyTypeList : SFTypeList2; {$J+}	GetDialog640: DialogTemplate;{$J-}Procedure MyDialogHook(theDialogPort: GrafPortPtr; var itemHit: Integer);	const	AllTypes = 101;	Appleworks = 102;	AppleworksGS = 103;	MacWrite = 104;		var	savedDB: Integer;		begin	savedDB := saveDB;		if itemHit > 100 then		begin		SetDItemValue(1,theDialogPort,itemHit);		case itemHit of			AllTypes: 				begin				MyTypeList.NumEntries:=3;				MyTypeList.filetypeentries[1].flags:=0;				MyTypeList.filetypeEntries[1].filetype:=$0050;				MyTypeList.filetypeEntries[1].AuxType:=$008010;				MyTypeList.filetypeentries[2].flags:=0;				MyTypeList.filetypeEntries[2].filetype:=0;				MyTypeList.filetypeEntries[2].AuxType:=0;				MyTypeList.filetypeentries[3].flags:=sfMatchFileType;				MyTypeList.filetypeEntries[3].filetype:=$1A;				MyTypeList.filetypeEntries[3].AuxType:=0;				end;			AppleworksGS:				begin				MyTypeList.NumEntries:=1;				MyTypeList.filetypeentries[1].flags:=0;				MyTypeList.filetypeEntries[1].filetype:=$0050;				MyTypeList.filetypeEntries[1].AuxType:=$008010;				end;			MacWrite:				begin				MyTypeList.NumEntries:=1;				MyTypeList.filetypeentries[1].flags:=0;				MyTypeList.filetypeEntries[1].filetype:=0;				MyTypeList.filetypeEntries[1].AuxType:=0;				end;			Appleworks:				begin				MyTypeList.NumEntries:=1;				MyTypeList.filetypeentries[1].flags:=sfMatchFileType;				MyTypeList.filetypeEntries[1].filetype:=$1A;				MyTypeList.filetypeEntries[1].AuxType:=0;				end;			end;		SFRescan(Nil,@MyTypeList);		end;	RestoreDB(savedDB);	end;{****************************************************************************}{{ DoImportFile{{ This routine asks the user what file to open and opens it.{{****************************************************************************}procedure DoImportFile;	var		MyFileInfoRec:FileInfoRecGS;		WindNum	: Integer;		i, ignore:Integer;		theTEHandle:TERecordHndl;		StyleHandle:MWriteStyleRechand;		tempPort : GrafPortPtr;		DecriptKey:handle;		theData:handle;		tempStyle:TEStyle;		MyReply : SFReplyRec2;		MyPrompt : string;		{		ConvertStyleHndl converts the handle that it receives from the 		MWriteStyleRechand format to the TEFormat format that is an input		to TESetText.  	}	PROCEDURE ConvertStyleHndl(styleHandle: Handle);			const		{ 		Here are some field offsets for the TEFormat record.  They will		be used by some very nasty machine dependent code that must be		used because the TEFormat record is defined in a way that 		Pascal cannot access it.		}		TEFversion = 0;		TEFrulerListLength = TEFversion + 2;		TEFtheRulerList = TEFrulerListLength + 4;		TEFRulerSize = 20;				type		TEStyleList = ARRAY [0..0] of TEStyle;		TEStyleListPtr = ^TEStyleList;		TEStyleListHndl = ^TEStyleListPtr;				TEStyleItemList = ARRAY [0..0] of StyleItem;		TEStyleItemListPtr = ^TEStyleItemList;		TEStyleItemListHndl = ^TEStyleItemListPtr;				LongPointer = ^Longint;		IntPointer = ^Integer;				var		theStyleList: TEStyleListHndl;		theStyleItemList: TEStyleItemListHndl;		styleListLength, itemListLength, ignore: LongInt;		i, styleIndex: Integer;		found: Boolean;		formatPtr: LongPointer;				begin		theStyleList := TEStyleListHndl(NewHandle(0,MyMemoryID,0,Nil));		theStyleItemList := TEStyleItemListHndl(NewHandle(0,MyMemoryID,0,Nil));		styleListLength := 0;		itemListLength := 0;		HLock(styleHandle);				With MWriteStyleRechand(styleHandle)^^ do			for i:=1 to StyleArraySize do				if StyleArray[i+1].theOffset <> StyleArray[i].theOffset then					begin					itemListLength := itemListLength + 1;					SetHandleSize(itemListLength*sizeof(StyleItem),Handle(theStyleItemList));					if i = StyleArraySize then						theStyleItemList^^[itemListLength-1].dataLength := $7fffffff - StyleArray[i].theOffset					else						theStyleItemList^^[itemListLength-1].dataLength := StyleArray[i+1].theOffset - StyleArray[i].theOffset;					styleIndex := 0;					found := FALSE;					while (styleIndex < styleListLength) and (not found) do						begin						if Longint(StyleArray[i].theFontID) = Longint(theStyleList^^[styleIndex].styleFontID) then							found := TRUE;						if not found then							styleIndex := styleIndex + 1;						end;					if not found then						begin						styleListLength := styleListLength + 1;						SetHandleSize(styleListLength*sizeof(TEStyle),Handle(theStyleList));						styleIndex := styleListLength - 1;						with theStyleList^^[styleIndex] do							begin							styleFontID := StyleArray[i].theFontID;							foreColor := 0;							backColor := -1;							userData := 0;							end;						end;					theStyleItemList^^[itemListLength-1].dataOffset := styleIndex*sizeof(TEStyle);					end;				HUnlock(styleHandle);			{		Here is some fun code.  It gets a ruler from the current TextEdit record and		modifies the style list and style item list info in it.  It uses the ruler		from the record.	}		ignore := TEGetText(0,teTextRef(0),0,refIsHandle,TEStyleRef(styleHandle),theTEHandle);		SetHandleSize(	GetHandleSize(styleHandle) +						(itemListLength-1) * sizeof(styleItem) +						(styleListLength-1) * sizeof(TEStyle),						styleHandle);								HLock(styleHandle);		formatPtr := LongPointer(styleHandle^);		formatPtr := LongPointer(Longint(formatPtr) + TEFtheRulerList + TEFormatPtr(formatPtr)^.rulerListLength);		formatPtr^ := styleListLength * sizeof(TEStyle);				{ fill in theStyleList }		formatPtr := LongPointer(Longint(formatPtr)+sizeof(Longint));		HandToPtr(	Handle(theStyleList),					Ptr(formatPtr),					styleListLength * sizeof(TEStyle));		DisposeHandle(Handle(theStyleList));				{ fill in numberOfStyles }		formatPtr := LongPointer(Longint(formatPtr)+styleListLength * sizeof(TEStyle));		formatPtr^ := itemListLength;				{ fill in theStyles }		formatPtr := LongPointer(Longint(formatPtr)+sizeof(Longint));		HandToPtr(	Handle(theStyleItemList),					Ptr(formatPtr),					itemListLength * sizeof(styleItem));		DisposeHandle(Handle(theStyleItemList));				HUnlock(styleHandle);				end;		begin	WindNum:=NextWindow;	If WindNum=0 then exit(DoImportFile);		MyPrompt := 'Select file to Import.';		SFAllCaps (true);		MyTypeList.NumEntries:=3;	MyTypeList.filetypeentries[1].flags:=0;	MyTypeList.filetypeEntries[1].filetype:=$0050;	MyTypeList.filetypeEntries[1].AuxType:=$008010;	MyTypeList.filetypeentries[2].flags:=0;	MyTypeList.filetypeEntries[2].filetype:=0;	MyTypeList.filetypeEntries[2].AuxType:=0;	MyTypeList.filetypeentries[3].flags:=sfMatchFileType;	MyTypeList.filetypeEntries[3].filetype:=$1A;	MyTypeList.filetypeEntries[3].AuxType:=0;			MyReply.NameRefDesc := refIsNewHandle;	MyReply.PathRefDesc := refIsNewHandle;	SFPGetFile2 (120,35,				Nil,			{item draw routine}				RefIsPointer,				ref(@MyPrompt),				@MyFilterProc,	{filter proc}				@MyTypeList,	{type list}				GetDialog640,	{dialog template}				@MyDialogHook,	{dialog hook}				MyReply );		if MyReply.good  then		begin		WaitCursor;		StyleHandle:=MWriteStyleRechand(NewHandle(34,MyMemoryID,0,NIL));		{ Convert the C1Output string into a C1Input string for the resource mangager }		C1OutputToC1Input(MyReply.PathRef.RefIsHandle);		hLock(handle(MyReply.PathRef.RefIsHandle));		MyFileInfoRec.pCount:=5;		MyFileInfoRec.pathname := GSString255Ptr(MyReply.PathRef.RefIsHandle^);		GetFileInfoGS(MyFileInfoRec);		if (MyFileInfoRec.FileType = 0) and (MyFileInfoRec.AuxType = 0) then			begin			DecriptKey:=ReadResource('STR ',700,MyReply.PathRef.RefIsHandle^);			if DecriptKey <> Nil then				begin				hlock(decriptKey);				theData:=ReadMACAWORD(DecriptKey^,StyleHandle,MyReply.PathRef.RefIsHandle^);				DisposeHandle(DecriptKey);				end			else				begin				if ThisError = 0 then					ignore := MyAlertWindow($34,NIL,ptr(19))				else					ignore := MyErrorWindow(0,NIL,ThisError);				DisposeHandle(Handle(StyleHandle));				exit(DoImportFile);				end;			end		else if (MyFileInfoRec.FileType = $50) and (MyFileInfoRec.AuxType = $08010) then			theData := ReadAWorksGS(StyleHandle,GSString255Ptr(MyReply.PathRef.RefIsHandle^))		else if MyFileInfoRec.FileType = $1A then			begin			theData := ReadAppleWorks(StyleHandle,GSString255Ptr(MyReply.PathRef.RefIsHandle^))			end		else			begin			ignore := MyAlertWindow($34,NIL,ptr(19));			DisposeHandle(Handle(StyleHandle));			exit(DoImportFile);			end;					if ThisError <> 0 then			begin			ignore := MyErrorWindow(0,NIL,ThisError);			DisposeHandle(theData);			DisposeHandle(Handle(StyleHandle));			exit(DoImportFile);			end;				if theData = Nil then			begin			DisposeHandle(theData);			DisposeHandle(Handle(StyleHandle));			exit(DoImportFile);			end;		{ reduce the size of the text to fit into the record }{ Removed 128K limit for 1.1, 17-Mar-92 DAL }{		if GetHandleSize(theData) > (128*1024) then			begin			ignore := MyAlertWindow($34,NIL,ptr(17));			exit(DoImportFile);			end;}		C1OutputToPString(MyReply.NameRef.RefIsHandle);				HLock(MyReply.NameRef.RefIsHandle);								tempPort := NewWindow2	(StringPtr(MyReply.NameRef.RefIsHandle^),			{ Title reference}							{ longint(MyReply.PathRef.RefIsHandle),	}							 0,											{ Ref con }							 ptr($C0000000+longint(@DrawThisWindow)),	{ Draw routine }							 NIL,										{ DefProc pointer }							 RefIsResource,								{ Param Table Descriptor }							 ref(MainWindowID),							{ Param Table Reference }							 rWindParam1);								{ Param Table Type }						If _toolErr<>0 then			begin			If _toolErr=volNotFound then exit(DoImportFile);			WindNum:= MyErrorWindow(0,NIL,_ToolErr);			exit(DoImportFile);			end;		WindArray[WindNum]:=tempPort;		DisposeHandle(MyReply.NameRef.RefIsHandle);		theTEHandle:=TERecordHndl(GetCtlHandleFromID(tempPort,MainWindowID));				ConvertStyleHndl(Handle(StyleHandle));				TESetText ( teDataIsTextBlock+refIsHandle*8,	{ Text Descriptor }			teTextRef(theData),	 						{ Text Ref }			0,											{ Text Length }			refIsHandle,								{ Style Descriptor }			TEStyleRef(StyleHandle),					{ Style Ref }			theTEHandle	   								{ Control Handle }			);		{ Set the dirty bit for the TE record }		theTEHandle^^.ctrlFlag := bOR(theTEHandle^^.ctrlFlag,fRecordDirty);				PlaceAndShowWindow(tempPort,WindNum,true);		InitCursor;		DisposeHandle(theData);		DisposeHandle(handle(StyleHandle));		end;	end;