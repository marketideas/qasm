{**********************************************************************{*{* Teach uWindow.inc.p (implementation){*{* Copyright (c){* Apple Computer, Inc.  1986-1993{* All Rights Reserved.{*{* This file contains the code which implements  {* windows in the Teach program.{*{**********************************************************************}{$R-}const	MyWindowSize=$7001;		{Resource ID for the window size}type	MyWindSizeRec = record					 theHeight:Integer;					 theWidth:Integer;					 theTop:Integer;					 theLeft:Integer;					 theVersion:Longint;					end;		MyWindSizePtr=^MyWindSizeRec;		MyWindSizeHand=^MyWindSizePtr;		var		CancelFlag: Boolean;		gFileType: Integer;{$J+}		PutDialog640: DialogTemplate;{$J-}PROCEDURE Debug;  INLINE $0000;{ These routines are used by custom routines that are called by the toolbox. }Function SaveDB: Integer; External;Procedure RestoreDB(theSavedDB: Integer); External;{**********************************************************************}{{ DrawThisWindow{{ This routine draws the contents of all the windows.{{*{* Warning:  Do not make any calls that use the libraies or use{* short addressing without setting the dbr to ~globals.{*{**********************************************************************}procedure DrawThisWindow;	begin		DrawControls(GetPort);	END;	{**********************************************************************}{{ NextWindow{{ This routine goes thru the list of available windows and tries to find an{ empty slot. If it can not find one it returns zero and informs the user.  {{**********************************************************************}Function NextWindow:Integer;	var i:Integer;		begin	  i:=0;	  repeat	    i:=i+1;	  until (WindArray[i]=NIL) or (i=MaxWinds);	  If WindArray[i]<>NIL then  		begin		  i:=0;   		  If MyAlertWindow($0034,NIL,ptr(3))=0 then;		end;	  NextWindow:=i;	end;	{**********************************************************************}{{ FreeWindow{{ This routine goes thru the list of windows and tries to find an entry{ for the passed window. If it does it will NIL out that entry.  {{**********************************************************************}procedure FreeWindow(theWind:GrafPortPtr);	var i:Integer;		begin	  for i:=1 to MaxWinds do	    If WindArray[i]=theWind then WindArray[i]:=NIL;	end;	{**********************************************************************}{{ FindWindNum{{ This routine goes thru the list of windows and tries to find an entry{ that matches the passed entry.  {{**********************************************************************}Function FindWindNum(theWind:GrafPortPtr):Integer;	var i:Integer;		begin	  FindWindNum:=0;	  If theWind=NIL then Exit(FindWindNum);	  for i:=1 to MaxWinds do	    If WindArray[i]=theWind then		  begin		    FindWindNum:=i;			Exit(FindWindNum);		  end;		FindWindNum:=0;	end;	{**********************************************************************}{{ ValidFront{{ Returns whether the front window is {{**********************************************************************}Function ValidFront:Boolean;	var i:Integer;		begin		i:=FindWindNum(FrontWindow);		ValidFront:=(i<>0);	end;		{**********************************************************************}{{ AlreadyOpen(thePathName:Handle):Boolean;{{ Returns whether the front window is {{**********************************************************************}Function AlreadyOpen(thePathName:Handle):Integer;	var i:Integer;	begin	  AlreadyOpen:=0;	  for i:=1 to 4 do	    If  WindArray[i]<>NIL then		  begin		  	If CompareC1In(handle(GetWRefCon(WindArray[i]))^,thePathName^) then			  AlreadyOpen:=i;		  end;	end;	{**********************************************************************}{{ ResetChangeFlag{{ This routine Resets our changed flag for our text edit record. {{**********************************************************************}procedure ResetChangeFlag(theWindow:GrafPortPtr);	External;	{**********************************************************************}{{ TestChangeFlag{{ This routine Resets our changed flag for our text edit record. {{**********************************************************************}Function TestChangeFlag(theWindow:GrafPortPtr):Boolean;    External;	{**********************************************************************}{{ PutFileIntoWindow{{ This routine opens the specified file, reads its contents in and{ sets the text of the text edit control of the top window to that text{{**********************************************************************}Procedure	PutFileIntoWindow (C1Handle : handle; theWindow:WindowPtr; windNum:integer);	var		TheHandle, temphandle : handle;		NoResFile:Boolean;		theResFileID:Integer;		Temp : integer;		theType: Integer;		OpenBlock : OpenRecGS;		CloseBlock : RefNumRecGS;		ReadBlock : ioRecGS;		MyFileInfoRec:FileInfoRecGS;		tempSize:MyWindSizeHand;			begin{ First determine if the file already exists and if its write protected by opening it for  writing...and Now do the proper file type stuff... }				MyFileInfoRec.pCount:=4;		MyFileInfoRec.pathname := GSString255Ptr(C1Handle^);		GetFileInfoGS(MyFileInfoRec);		theType:=MyFileInfoRec.FileType;		with OpenBlock do begin			pCount := 15;			pathname := GSString255Ptr(C1Handle^);			requestAccess := 0;			resourceNumber := 0;			optionList := NIL;		end;				OpenGS (OpenBlock);		If _ToolErr=VolNotFound then		  begin		  	temp:=MyAlertWindow($0034,NIL,ptr(11));			FreeWindow(theWindow);			CloseWindow(theWindow);		  	Exit(PutfileIntoWindow);		  end;		  		if _ToolErr <> 0 then 			begin				Temp := MyErrorWindow(0,NIL,_ToolErr);				FreeWindow(theWindow);				CloseWindow(theWindow);				exit(PutfileIntoWindow);			end;		with CloseBlock do begin			pCount := 1;			refNum := OpenBlock.refNum;		end;		If OpenBlock.EOF > $01FFFF then		  begin		  	If MyAlertWindow($0034,NIL,ptr(7))=0 then;			CloseGS(CloseBlock);			FreeWindow(theWindow);			CloseWindow(theWindow);			exit(PutfileIntoWindow);		  		  end;		  		TheHandle := NewHandle (OpenBlock.eof,MyMemoryID,0,NIL);		if _ToolErr <> 0 then 			begin				Temp := MyErrorWindow(0,NIL,_ToolErr);				CloseGS(CloseBlock);				FreeWindow(theWindow);				CloseWindow(theWindow);				exit(PutfileIntoWindow);		  			end;						hLock (theHandle);		if OpenBlock.eof <> 0 then			begin			with ReadBlock do 				begin				pCount := 4;				refNum := OpenBlock.refNum;				DataBuffer := TheHandle^;				requestCount := OpenBlock.eof;				end;			ReadGS (ReadBlock);			if _ToolErr <> 0 then 				begin				Temp := MyErrorWindow(0,NIL,_ToolErr);				DisposeHandle(TheHandle);				CloseGS(CloseBlock);				FreeWindow(theWindow);				CloseWindow(theWindow);				exit(PutfileIntoWindow);		  				end;			end;		CloseGS (CloseBlock);		if _ToolErr <> 0 then 			begin				Temp := MyErrorWindow(0,NIL,_ToolErr);				DisposeHandle(TheHandle);				FreeWindow(theWindow);				CloseWindow(theWindow);				exit(PutfileIntoWindow);		  			end;{ attempt to open the resource fork of this file! }		hLock(handle(C1Handle));		{	First open the resource file for reading... }		If theType=TeachFType then		  begin		  	NoResFile:=false;			theResFileID:=OpenResourceFile($0000,NIL,GSString255Ptr(C1Handle^));			If _ToolErr=0 then 				tempHandle:=LoadResource(rStyleBlock,1);			If _ToolErr<>0 then NoResFile:=true;			  end		 else		   	NoResFile:=true;				If NoResFile then			TESetText ( teDataIsTextBlock+refIsHandle*8,	{ Text Descriptor }					teTextRef(TheHandle),	 				{ Text Ref }					0,										{ Text Length }					0,										{ Style Descriptor }					teStyleRef(0),							{ Style Ref }					TERecordHndl(GetCtlHandleFromID(theWindow,MainWindowID))	{ Control Handle }					)				else		  begin	{ try and get the windows last size and position information... }			tempSize:=MyWindSizeHand(LoadResource(MyWindowSize,1));			If _ToolErr=0 then			  begin			  	SizeWindow(tempSize^^.theWidth,tempSize^^.theHeight,theWindow);				MoveWindow(tempSize^^.theLeft,tempSize^^.theTop,theWindow);			    ReleaseResource(3,MyWindowSize,1);			  end;			TESetText ( teDataIsTextBlock+refIsHandle*8,	{ Text Descriptor }					teTextRef(TheHandle),	 				{ Text Ref }					0,										{ Text Length }					$0002,									{ Style Descriptor }					teStyleRef(1),							{ Style Ref }					TERecordHndl(GetCtlHandleFromID(theWindow,MainWindowID))	{ Control Handle }					);			temp:=_ToolErr;			CloseResourceFile(theResFileID);			If _ToolErr=0 then _ToolErr:=temp;		  end;		If _ToolErr <> 0		  Then Begin		 	Temp := MyAlertWindow($0034,NIL,ptr(8));			DisposeHandle(TheHandle);			FreeWindow(theWindow);			CloseWindow(theWindow);			exit(PutfileIntoWindow);		      	  End;		If noResFile and (theType=TeachFType) then			begin			CloseResourceFile(theResFileID);		    Temp := MyAlertWindow($0034,NIL,ptr(9));			end;		DisposeHandle(TheHandle);		ResetChangeFlag(theWindow);		PlaceAndShowWindow(theWindow,WindNum,(theType<>TeachFType));	end;{**********************************************************************}{{ PutWindowIntoFile{{ This routine opens the specified file, writes the window contents.{{**********************************************************************}procedure	PutWindowIntoFile (C1Handle : handle; theType:Integer);	var	TheHandle : handle;	theTERec: TERecordHndl;	Temp : integer;	theResFileID:Integer;	WindNum:Integer;	totalSize : LongInt;	DestroyBlock : NameRecGS;	CreateBlock : CreateRecGS;	OpenBlock : OpenRecGS;	CloseBlock : RefNumRecGS;	WriteBlock : ioRecGS;	MyFileInfoRec:FileInfoRecGS;	myEOFRec: SetPositionRecGS;	Exists : Boolean;	tempSize:MyWindSizeHand;	tempWindow:WindowPtr;		Function WriteText(	refNum: Integer;						theTERec: TERecordHndl): Integer;		var		WriteBlock : ioRecGS;		theInfoRec: TEInfoRec;		theHandle: Handle;		temp, textDescriptor: Integer;		bufferSize, textSize, totalWritten,		selectStart, selectEnd: Longint;				begin				WriteText := 0;		WriteBlock.pCount := 4;		WriteBlock.refNum := refNum;	{ determine optimal text buffer size }		TEGetTextInfo(theInfoRec,1,theTERec);		if theInfoRec.charCount = 0 then			exit(WriteText);		bufferSize := MaxBlock;		if theInfoRec.charCount < bufferSize then			bufferSize := theInfoRec.charCount;				theHandle := NewHandle (bufferSize,MyMemoryID,0,NIL);		if _toolErr <> 0 then			begin			WriteText := _toolErr;			exit(WriteText);			end;				totalWritten := 0;		if bufferSize < theInfoRec.charCount then			begin			theTERec^^.ctrlFlag := bXOR(theTERec^^.ctrlFlag,ctlInVis);			TEGetSelection(selectStart,selectEnd,theTERec);			textDescriptor := tedataIsTextBlock+refIsHandle*8 + $0020;			end		else			textDescriptor := tedataIsTextBlock+refIsHandle*8;		repeat			if bufferSize < theInfoRec.charCount then				TESetSelection(totalWritten,								totalWritten+bufferSize-1,								theTERec);			textSize := TEGetText (  								textDescriptor,			{ Text Descriptor }								teTextRef(theHandle),	{ Text Ref }								0,						{ Text Length }								0,						{ Style Descriptor }								teStyleRef(0),			{ Style Ref }								theTERec				{ TE record handle }								);			HLock(theHandle);			WriteBlock.DataBuffer := theHandle^;			WriteBlock.requestCount := textSize;			WriteGS (WriteBlock);			if _toolErr <> 0 then				begin				WriteText := _toolErr;				DisposeHandle(theHandle);				exit(WriteText);				end;			HUnlock(theHandle);			totalWritten := totalWritten + textSize;		until totalWritten = theInfoRec.charCount;				if bufferSize < theInfoRec.charCount then			begin			theTERec^^.ctrlFlag := bXOR(theTERec^^.ctrlFlag,ctlInVis);			TESetSelection(selectStart,selectEnd,theTERec);			end;		end;			begin{	first get the text from the text edit record to insure that we 	have enough room in memory to perform the save... }	If CancelFlag then exit(PutWindowIntoFile);		CancelFlag:=true;		{Default this to true to save space}	tempWindow:=FrontWindow;	theTERec := TERecordHndl(GetCtlHandleFromID(tempWindow,MainWindowID));	{ First determine if the file already exists and if its write protected	by opening it for writing...and Now do the proper file type stuff... }		MyFileInfoRec.pCount:=6;	{ up to and including Create DateTime }	MyFileInfoRec.pathname := GSString255Ptr(C1Handle^);	GetFileInfoGS(MyFileInfoRec);	If (_toolErr<>0) and (theType=trollType) then theType:=TeachFType;	If theType=trollType then theType:=MyFileInfoRec.FileType;	Exists:= (_ToolErr=0);				{ continue with the operation... }	with DestroyBlock do begin		pCount := 1;		pathname := GSString255Ptr(C1Handle^);	end;		if Exists then		begin		DestroyGS(DestroyBlock);			if _toolErr <> 0 then			begin			If _toolErr = invalidAccess then				Temp := MyAlertWindow($0034,NIL,ptr(14))			else If _ToolErr = volNotFound then				temp:=MyAlertWindow($0034,NIL,ptr(11))			else if _toolErr <> fileNotFound then				Temp := MyErrorWindow(0,NIL,_ToolErr);			exit(PutWindowIntoFile);			end;		end;	{ Create the file all over again }	with CreateBlock do 		Begin		pCount := 4;		pathname := GSString255Ptr(C1Handle^);		access := $C3;		fileType := theType;		If theType= TeachFType then			AuxType := teachAuxType		else if theType = APWSource then			if Exists and (MyFileInfoRec.fileType=APWSource) then { added "and..." 12-Nov-91 DAL }				AuxType := MyFileInfoRec.auxType			else				AuxType := ScriptAuxType		else			AuxType := 0;		end;		CreateGS (CreateBlock);	if _ToolErr <> 0 then 		begin		Temp := MyErrorWindow(0,NIL,_ToolErr);		exit(PutWindowIntoFile);		end;		if Exists then		Begin		MyFileInfoRec.fileType := theType;		MyFileInfoRec.AuxType := CreateBlock.AuxType;		SetFileInfoGS(MyFileInfoRec);	{ reset creation date back to original value}		end;	{ Open the file's data fork }	with OpenBlock do		begin		pCount := 15;		pathname := GSString255Ptr(C1Handle^);		requestAccess := 0;		resourceNumber := 0;		optionList := NIL;		end;		OpenGS (OpenBlock);	if _ToolErr <> 0 then 		begin		Temp := MyErrorWindow(0,NIL,_ToolErr);		exit(PutWindowIntoFile);		end;	with CloseBlock do 		begin		pCount := 1;		refNum := OpenBlock.refNum;		end;		with DestroyBlock do		begin		pCount := 1;		pathname := GSString255Ptr(C1Handle^);		end;		with myEOFRec do		begin		pCount := 3;		refNum := OpenBlock.refNum;		base := 0;		displacement := 0;		end;	temp := WriteText(OpenBlock.refNum,theTERec);	if temp <> 0 then		begin		Temp := MyErrorWindow(0,NIL,temp);		SetEOFGS(myEOFRec);		CloseGS(CloseBlock);		DestroyGS(DestroyBlock);		exit(PutWindowIntoFile);		end;		{ Close the data fork }	CloseGS (CloseBlock);	if _toolErr = volumeFull then		begin		Temp := MyAlertWindow($0034,NIL,ptr(20));		SetEOFGS(myEOFRec);		CloseGS (CloseBlock);		DestroyGS(DestroyBlock);		exit(PutWindowIntoFile);		end;		{ attempt to save the resources to the files resource fork now! }		If theType=TeachFType then		begin	{	First open the resource file for writing... }			CreateResourceFile(0,$0004,$0003,GSString255Ptr(C1Handle^));		if _ToolErr <> 0 then 			begin			if _toolErr = volumeFull then				Temp := MyAlertWindow($0034,NIL,ptr(20))			else				Temp := MyErrorWindow(0,NIL,_ToolErr);			DestroyGS(DestroyBlock);			exit(PutWindowIntoFile);			end;		theResFileID:=OpenResourceFile($0000,NIL,GSString255Ptr(C1Handle^));		if _ToolErr <> 0 then 			begin			Temp := MyErrorWindow(0,NIL,_ToolErr);			DestroyGS(DestroyBlock);			exit(PutWindowIntoFile);			end;			{ Add the window size resource }		tempSize := MyWindSizeHand(NewHandle (12,MyMemoryID,0,NIL)); { size was 16, 18-Jun-92 DAL }		tempSize^^.theWidth:=tempWindow^.portrect.h2-tempWindow^.portrect.h1;		tempSize^^.theHeight:=tempWindow^.portrect.v2-tempWindow^.portrect.v1;				tempSize^^.theTop:= -tempWindow^.portInfo.boundsRect.v1;		tempSize^^.theLeft:= -tempWindow^.portInfo.boundsRect.h1;		tempSize^^.theVersion:=0;				AddResource(Handle(tempSize),0,MyWindowSize,1);		if _toolErr <> 0 then			begin			if _toolErr = volumeFull then				Temp := MyAlertWindow($0034,NIL,ptr(20))			else				temp := MyErrorWindow(0,NIL,_ToolErr);			CloseResourceFile(BOR($8000,theResFileID));			DestroyGS(DestroyBlock);			exit(PutWindowIntoFile);			end;				{ 	Now call text edit to create the style resource... }			{ Dave says that this puts the data into my resource file! }			totalSize := TEGetText (  							tedataIsTextBlock+refIsPointer*8,  	{ Text Descriptor }							teTextRef(Nil),	 					{ Text Ref }							0,									{ Text Length }							refIsResource,								{ Style Descriptor }							teStyleRef(1),						{ Style Ref }							TERecordHndl(GetCtlHandleFromID(tempWindow,MainWindowID))	{ Control Handle }							);		if TEGetLastError(fClearError,				TERecordHndl(GetCtlHandleFromID(tempWindow,MainWindowID))) <> 0 then			begin			temp := MyErrorWindow(0,NIL,_ToolErr);			CloseResourceFile(BOR($8000,theResFileID));			DestroyGS(DestroyBlock);			exit(PutWindowIntoFile);			end;			UpdateResourceFile(theResFileID);		if _toolErr <> 0 then			begin			if _toolErr = volumeFull then				Temp := MyAlertWindow($0034,NIL,ptr(20))			else				temp := MyErrorWindow(0,NIL,_ToolErr);			CloseResourceFile(BOR($8000,theResFileID));			DestroyGS(DestroyBlock);			exit(PutWindowIntoFile);			end;				CloseResourceFile(theResFileID);		if _toolErr <> 0 then			begin			CloseResourceFile(BOR($8000,theResFileID));			DestroyGS(DestroyBlock);			exit(PutWindowIntoFile);			end;		End;		CancelFlag:=false;		{if we get here then all must be groovy}	ResetChangeFlag(FrontWindow);		end;{**********************************************************************}{{ PlaceAndShowWindow{{ This routine moves the specified window based on stagger count{ and shows it.{{**********************************************************************}procedure PlaceAndShowWindow (TheWindow : GrafPortPtr; WindNum:Integer;								isNewWindow: Boolean);	begin		if isNewWindow or (theWindow^.portInfo.boundsRect.v1 > -26) then			MoveWindow (8+8*WindNum,28+8*WindNum,TheWindow);		ShowWindow(TheWindow);		SelectWindow(TheWindow);		end;{****************************************************************************}{{ MyFilterProc{{ This routine is a filter procedure for the SFGetFile2 call in DoImportFile.{{****************************************************************************}type	OptionListRec = PACKED RECORD		fileSysID: Integer;		typeCreatorStr: PACKED ARRAY[1..8] OF char;		finderFlags: Integer;		location: Point;		windowID: Integer;		iconID: Integer;		reserved: PACKED ARRAY[1..8] OF char;		commentID: Integer;		homeDirID: Longint;		parentDirID: Longint;		accessRights: Longint;		end;	OptionListBuf = RECORD		bufSize: Integer;		length: Integer;		theData: OptionListRec;		end;Function MyFilterProc(var inputDirEntry: DirEntryRecGS): Integer;	var	theOptionList: OptionListBuf;	myDirEntry:DirEntryRecGS;		begin	MyFilterProc := displaySelect;	if inputDirEntry.fileType <> 0 then		exit (MyFilterProc);	theOptionList.bufSize := sizeof(OptionListBuf);	with myDirEntry do		begin		pCount := 15;		refNum := inputDirEntry.refNum;		base := 1;		displacement := 0;		name := inputDirEntry.name;		optionList := ResultBuf255Ptr(@theOptionList);		end;	GetDirEntryGS(myDirEntry);	if (myDirEntry.fileSysID = hfsFSID) or (myDirEntry.fileSysID = appleShareFSID) then		begin		if theOptionList.theData.typeCreatorStr <> 'ttrottxt' then			MyFilterProc := noDisplay;		end	else		MyFilterProc := noDisplay;	end;{****************************************************************************}{{ DoOpenWindow{{ This routine asks the user what file to open and opens it.{{****************************************************************************}procedure DoOpenWindow;	var		WindNum	: Integer;		Temp : GrafPortPtr;		MyPrompt : string;		MyReply : SFReplyRec2;		MyTypeList : SFTypeList2;			begin	WindNum:=NextWindow;	If WindNum=0 then exit(DoOpenWindow);		MyPrompt := 'Please select file to open.';		SFAllCaps (true);		MyTypeList.NumEntries:=4;	MyTypeList.filetypeentries[1].flags:=sfMatchFileType;	MyTypeList.filetypeEntries[1].filetype:=TextOnly;	MyTypeList.filetypeEntries[1].AuxType:=0;	MyTypeList.filetypeentries[2].flags:=0;	MyTypeList.filetypeEntries[2].filetype:=TeachFType;	MyTypeList.filetypeEntries[2].AuxType:=TeachAuxType;	MyTypeList.filetypeentries[3].flags:=sfMatchFileType;	MyTypeList.filetypeEntries[3].filetype:=APWSource;	MyTypeList.filetypeEntries[3].AuxType:=0;			MyTypeList.filetypeentries[4].flags:=0;	MyTypeList.filetypeEntries[4].filetype:=0;	MyTypeList.filetypeEntries[4].AuxType:=0;		MyReply.NameRefDesc := refIsNewHandle;	MyReply.PathRefDesc := refIsNewHandle;	SFGetFile2 (120,35,				RefIsPointer,				ref(@MyPrompt),				@MyFilterProc,				@MyTypeList,				MyReply );						if MyReply.good  then		begin		{ Convert the C1Output string into a C1Input string for the resource mangager }		C1OutputToC1Input(MyReply.PathRef.RefIsHandle);				windNum:=AlreadyOpen(handle(MyReply.PathRef.RefIsHandle));		If Windnum<>0 then			begin			SelectWindow(WindArray[WindNum]);			DisposeHandle(MyReply.NameRef.RefIsHandle);			DisposeHandle(MyReply.PathRef.RefIsHandle);			Exit(DoOpenWindow);			end		else			WindNum:=NextWindow;		  		C1OutputToPString(MyReply.NameRef.RefIsHandle);				HLock(MyReply.NameRef.RefIsHandle);								Temp := NewWindow2	(StringPtr(MyReply.NameRef.RefIsHandle^),			{ Title reference}							 longint(MyReply.PathRef.RefIsHandle),		{ Ref con }							 ptr($C0000000+longint(@DrawThisWindow)),	{ Draw routine }							 NIL,										{ DefProc pointer }							 RefIsResource,								{ Param Table Descriptor }							 ref(MainWindowID),							{ Param Table Reference }							 rWindParam1);								{ Param Table Type }						If _toolErr<>0 then			begin			If _toolErr=volNotFound then exit(DoOpenWindow);			WindNum:= MyErrorWindow(0,NIL,_ToolErr);			exit(DoOpenWindow);			end;		WindArray[WindNum]:=temp;		{ Get rid of this handle }		DisposeHandle(MyReply.NameRef.RefIsHandle);				WaitCursor;		PutFileIntoWindow(MyReply.PathRef.RefIsHandle,temp,windNum);		InitCursor;		end;	end;{****************************************************************************}{{ MyDialogHook{{ This routine is a std. file dialog hook routine.{{****************************************************************************}procedure MyDialogHook(theWindow: GrafPortPtr; var itemHit: Integer);	var	savedDB: Integer;		begin	savedDB := saveDB;		if itemHit > 100 then		begin		SetDItemValue(1,theWindow,itemHit);		case itemHit of			101: gFileType := TeachFType;			102: gFileType := TextOnly;			103: gFileType := APWSource;			end;		itemHit := 0;		end;	RestoreDB(savedDB);	end;{****************************************************************************}{{ DoSaveAs;{{ This routine either saves the file  in the place indicated by the user.{{****************************************************************************}procedure DoSaveAs;	var		MyPrompt : string;		MyReply : SFReplyRec2;		OrigWinTitle : StringHandle;		NewWinTitle : handle;		Temp : LongInt;		WindNum:Integer;		theTEHandle:TERecordHndl;		recordIsDirty: Boolean;			begin;		theTEHandle:=TERecordHndl(GetCtlHandleFromID(FrontWindow,MainWindowID));		recordIsDirty := (bAND(theTEHandle^^.ctrlFlag,fRecordDirty) = fRecordDirty);			    MyPrompt := 'Save the file as:';		SFAllCaps (true);		MyReply.NameRefDesc := refIsNewHandle;		MyReply.PathRefDesc := refIsNewHandle;		{ The current window title is the default name }		OrigWinTitle := StringHandle(bAND4($FFFFFF,longint(GetWTitle(FrontWindow))));				{ Lock so it won't move when newhandle is called }		HLock(handle(OrigWinTitle));		{ Get a C1String in  a new handle }		NewWinTitle := PStringToNewC1String(OrigWinTitle^);				{ unlock the thing now }		hUnLock(handle(OrigWinTitle));				hLock(NewWinTitle);				SFPutFile2 (170,35,					RefIsPointer,					ref(@MyPrompt),					RefIsPointer,					ref(NewWinTitle^),					MyReply );				{ Don't need this default name any more }		DisposeHandle(NewWinTitle);		CancelFlag:=False;			if MyReply.good  then			begin			{ Convert the C1Output string into a C1Input string for the resource mangager }			C1OutputToC1Input(MyReply.PathRef.RefIsHandle);						{ Convert this C1 Output string into a pString for the window manager }			C1OutputToPString(MyReply.NameRef.RefIsHandle);			{ Write the file out to disk }			WaitCursor;			PutWindowIntoFile(MyReply.PathRef.RefIsHandle,TeachFType);						if not cancelFlag then				begin				{ Get rid of old path name handle in RefCon and the old title }				DisposeHandle(handle (GetWRefCon(FrontWindow)));				DisposeHandle(handle (OrigWinTitle) );				{ Set the window title correctly }				Temp := longint(MyReply.NameRef.RefIsHandle);				Temp := bOR4($80000000,Temp);				SetWTitle (string255Ptr(Temp)^,FrontWindow);								{ Save the path name in the refcon of the window }				SetWRefCon(LongInt(MyReply.PathRef.RefIsHandle),FrontWindow);				end			else				begin				{ Set the dirty bit for the TE record }				if recordIsDirty then					theTEHandle^^.ctrlFlag := bOR(theTEHandle^^.ctrlFlag,fRecordDirty);				DisposeHandle(MyReply.PathRef.RefIsHandle);				DisposeHandle(MyReply.NameRef.RefIsHandle);				end;						InitCursor;			end		else			CancelFlag:=true;  	end;	{****************************************************************************}{{ DoSaveCopyAs(theType:Integer);{{ This routine either saves the file  in the place indicated by the user.{{****************************************************************************}procedure DoSaveCopyAs;	var		MyPrompt : string;		MyReply : SFReplyRec2;		theTEHandle:TERecordHndl;		recordIsDirty: Boolean;			begin;	theTEHandle:=TERecordHndl(GetCtlHandleFromID(FrontWindow,MainWindowID));	recordIsDirty := (bAND(theTEHandle^^.ctrlFlag,fRecordDirty) = fRecordDirty);			MyPrompt := 'Save the file as:';	SFAllCaps (true);		MyReply.NameRefDesc := refIsNewHandle;	MyReply.PathRefDesc := refIsNewHandle;	gFileType := TeachFType;	{ set the default type for the Std. File hook }		SFPPutFile2 (170,35,				Nil,				RefIsPointer,				ref(@MyPrompt),				RefIsPointer,				ref(0),				PutDialog640,				@MyDialogHook,				MyReply );		CancelFlag:=False;	theType := gFileType;	{ get the type from Std. File hook }	if MyReply.good  then		begin		{ Write the file out to disk }		WaitCursor;		{ Convert the C1Output string into a C1Input string for opening the file }		C1OutputToC1Input(MyReply.PathRef.RefIsHandle);					PutWindowIntoFile(MyReply.PathRef.RefIsHandle,theType);				DisposeHandle(MyReply.PathRef.RefIsHandle);		DisposeHandle(MyReply.NameRef.RefIsHandle);				{ Set the dirty bit for the TE record }		if recordIsDirty then			theTEHandle^^.ctrlFlag := bOR(theTEHandle^^.ctrlFlag,fRecordDirty);		InitCursor;		end	else		CancelFlag:=true;	end;	{****************************************************************************}{{ DoSave{{ This routine either saves the file (unless it is new then it does a save { as).  What if it is an imported file?{{****************************************************************************}procedure DoSave;	var		TheWindow : GrafPortPtr;		TheRefCon : LongInt;		theTEHandle:TERecordHndl;		recordIsDirty: Boolean;			begin		CancelFlag:=false;				TheWindow := FrontWindow;		TheRefCon := GetWRefCon(TheWindow);				if TheRefCon = 0 then			DoSaveAs		else 			begin			WaitCursor;			theTEHandle:=TERecordHndl(GetCtlHandleFromID(TheWindow,MainWindowID));			recordIsDirty := (bAND(theTEHandle^^.ctrlFlag,fRecordDirty) = fRecordDirty);							PutWindowIntoFile(handle(TheRefCon),TrollType); {Decide what type to use}						if cancelFlag then				{ Set the dirty bit for the TE record }				if recordIsDirty then					theTEHandle^^.ctrlFlag := bOR(theTEHandle^^.ctrlFlag,fRecordDirty);				InitCursor;			end;	end;		{**********************************************************************}{{ DoCloseOne{{ This routine closes the specified window. If the window is closed it returns{ true, otherwise it returns false{{**********************************************************************}Function DoCloseOne(theWindow:GrafPortPtr):Boolean;	var		k : integer;		TempWin : GrafPortPtr;		OrigWinTitle:StringHandle;			begin		InitCursor;		{ 1-Jul-92 DAL }		{ Before we close the window, see if we should save its contents}		If TestChangeFlag(theWindow) then 		  begin			OrigWinTitle := StringHandle(bAND4($FFFFFF,longint(GetWTitle(theWindow))));			HLock(handle(OrigWinTitle));		  	k:=MyAlertWindow($0035,ptr(OrigWinTitle),ptr(4));			If K=1 then 			  begin			    DoCloseOne:=false;			    Exit(DoCloseOne);			  end;			If k=2 then 			  begin			    bringtoFront(theWindow);				CancelFlag:=false;				DoSave;				If CancelFlag then Exit(DoCLoseOne);			  end;		  end;		{ Get rid of the path name handle that we keep in the refcon. }		{ Note that it is zero if the window is untitled }		DisposeHandle(handle(GetWRefCon(theWindow)));		{ Close the window.  (This kills the window title handle.) }		FreeWindow(theWindow);		if theWindow = GetPort then			SetPort(GetWMgrPort);		CloseWindow(theWindow);		DoCloseOne:=true;	end;{**********************************************************************}{{ DoCloseTop{{ This routine closes the topmost window.  {{**********************************************************************}procedure DoCloseTop;	var		k : integer;		TempWin : GrafPortPtr;			begin		If DoCloseOne(FrontWindow) then;	end;{****************************************************************************}{{ NewWindow{{ This routine opens a new untitled window.{{****************************************************************************}procedure	DoNewWindow;	var		windNum	:Integer;		Temp : GrafPortPtr;		TempStr : Str255;		thePString:STR255;			begin		TempStr := 'untitled';{ First find a window to put this in... }		WindNum:=NextWindow;		If WindNum=0 then exit(DoNewWindow);				Temp := NewWindow2	(@TempStr,			{ Title reference}							 0,						{ Ref con }							 ptr($C0000000+longint(@DrawThisWindow)),  { Draw routine }							 NIL,					{ DefProc pointer }							 RefIsResource,			{ Param Table Descriptor }							 ref(MainWindowID),		{ Param Table Reference }							 rWindParam1);			{ Param Table Type }		If _toolErr<>0 then		  begin		  	If _toolErr=volNotFound then exit(DoNewWindow);		 	WindNum:= MyErrorWindow(0,NIL,_ToolErr);			exit(DoNewWindow);		  end;		WindArray[WindNum]:=temp;		PlaceAndShowWindow(Temp,WindNum,true);		{ To try and fix a bug in the initial text of the control being crap, I will now	attempt to fix the incomming record up! }			thePString:=''; {Initial window text is a space!}				TESetText ( teDataIsPString,	    { Text Descriptor }					teTextRef(@thePString),	{ Text Ref }					0,			            { Text Length }					0,											  			{ Style Descriptor }					teStyleRef(0),          { Style Ref }					TERecordHndl(GetCtlHandleFromID(FrontWindow,MainWindowID))	   		{ Control Handle }					);	end;	(********************************************************************************************)(*		LaunchDoc																			*)(********************************************************************************************)type	MyMessageData = record		verb: integer;		fileNames : PACKED ARRAY[1..1] OF char;		end;	MyMessageRecHndl = ^MyMessageRecPtr;	MyMessageRecPtr = ^MyMessageRec;	MyMessageRec = RECORD		messageNext : MessageRecHndl;		messageType : Integer;		messageData : MyMessageData;		END;		CharPtr = ^char;	WordPtr = ^integer;Function LaunchDoc:Boolean;{  This procedure checks the message center to determine if a document was  double clicked on when the application was launched. If so, this will open that  document for use.}  var	GotMessage: Boolean;		aC1String: Handle;		Temp : GrafPortPtr;		done: boolean;		ignore, WindNum, fNameOffset, len: Integer;  		theMessage:MyMessageRecHndl;		theTitle: str255;{		whatsLeft: str255; }		myFileInfo: FileInfoRecGS;		 	begin	theMessage := MyMessageRecHndl(NewHandle(10,MyMemoryID,0,NIL));	MessageCenter(getMessage,$0011,MessageRecHndl(theMessage));	GotMessage := (_ToolErr=0);		If GotMessage then		begin		{ If a message exists make sure it's the open message! If not tell the user		  no printing from Finder! }		If theMessage^^.messageData.verb<>0 then			ignore := MyAlertWindow($0034,NIL,ptr(2));		fNameOffset := 0;		done := false;				while not done do			begin{			if BAnd($ff,ord(CharPtr(ord4(@theMessage^^.messageData.filenames) + fNameOffset)^)) = 0 then }			if WordPtr(ord4(@theMessage^^.messageData.filenames) + fNameOffset)^ = 0 then				done := true;			if not done then				begin				WindNum := NextWindow;				if WindNum = 0 then					done := true;				end;			if not done then				begin{				theTitle := String255Ptr(ord4(@theMessage^^.messageData.filenames) + fNameOffset)^; }{				fNameOffset := fNameOffset + ord(theTitle[0]) + 1; }{				aC1String := PStringToNewC1String(@theTitle); }{				whatsleft := ScanDown(theTitle); }				len := WordPtr(ord4(@theMessage^^.messageData.filenames)+fNameOffset)^;				aC1String := NewHandle(len+2,MMStartUp,0,nil);				PtrtoHand(Ptr(ord4(@theMessage^^.messageData.filenames)+fNameOffset),aC1String,len+2);				fNameOffset := fNameOffset + len + 2;				ExtractFilename(aC1String,@theTitle);				{ make sure it is a Teach file that is being launched }				myFileInfo.pCount := 4;				HLock(aC1String);				myFileInfo.pathname := GSString255Ptr(aC1String^);				GetFileInfoGS(myFileInfo);				HUnlock(aC1String);				if not (((myFileInfo.fileType = TeachFType) 							and (myFileInfo.auxType = teachAuxType))						or (myFileInfo.fileType = TextOnly) 						or (myFileInfo.fileType = APWSource)) then					begin						ignore := MyAlertWindow($0034,NIL,ptr(21));						DisposeHandle(aC1String);					end				else					begin					{ first create a new window... }					Temp := NewWindow2	(StringPtr(@theTitle),		{ Title reference}										 longint(aC1String),		{ Ref con }										 ptr($C0000000+longint(@DrawThisWindow)),  { Draw routine }										 NIL,						{ DefProc pointer }										 RefIsResource,				{ Param Table Descriptor }										 ref(MainWindowID),			{ Param Table Reference }										 rWindParam1);				{ Param Table Type }							{ and load the document into it to be shown... }					WindArray[WindNum]:=temp;										WaitCursor;					PutFileIntoWindow(aC1String,temp,windNum);					InitCursor;					end;				end;			end;{ Now get rid of the message so no one else uses it! }		MessageCenter(deleteMessage,fileInfoType,NIL);		MessageCenter(deleteMessage,$0011,NIL); { 25-Nov-91 DAL }		end;	DisposeHandle(Handle(theMessage));	LaunchDoc := GotMessage;	end;{*****************************************************************************}{{ SetUpWindows{{ Opens the default window.{{*****************************************************************************}procedure SetUpWindows;var	thePString:str255;begin	if Not(LaunchDoc) then begin		DoNewWindow;	end;end;