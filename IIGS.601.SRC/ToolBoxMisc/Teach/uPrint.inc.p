little smaller than the page rect }				OurRect := printHndl^^.prInfo.rPage;				OurRect.Top := OurRect.Top+16;				OurRect.Bottom := OurRect.Bottom - 16;				OurRect.Left := OurRect.Left + 16;				OurRect.Right := OurRect.Right - 16;								prPort := PrOpenDoc (printHndl,nil);				termError:=_ToolErr;				If PrError=$0080 then			      begin					PrCloseDoc(PrPort);					SetPort(TempPort);					Exit(DoPrintItem);				  end;				If termError<>0 then				  begin					InitCursor;					If AlertWindow($34,NIL,Ref(5))=0 then;	                PrCloseDoc(prPort);					SetPort(TempPort);					Exit(DoPrintItem);				  end;			   				ThisLine := 0;				repeat					PrOpenPage          (prPort,nil);					termError:=_ToolErr;					If PrError=$0080 then					  begin					    prClosePage(prPort);						prCloseDoc(prPort);						SetPort(TempPort);					    Exit(DoPrintItem);				   	  end;					If TermError<>0 then					  begin						InitCursor;						If AlertWindow($34,NIL,Ref(5))=0 then;						prClosePage(prPort);						prCloseDoc(prPort);						SetPort(TempPort);						Exit(DoPrintItem);					  end;					ThisLine := TEPaintText(	prPort,												ThisLine,												OurRect,												0,												TERecordHndl(TheControl));					DocDone := (_ToolErr <> 0) or (ThisLine < 0);					if DocDone then TermError := _ToolErr;										PrClosePage         (prPort);					If PrError=$0080 then					  begin					    prCloseDoc(prPort);						SetPort(TempPort);						Exit(DoPrintItem);					  end;			   until DocDone;               PrCloseDoc          (prPort);               PrPicFile           (printHndl,nil,nil);               InitCursor;           end;		   		SetPort(TempPort);   end;    {of DoPrintItem}{--------------------------------------------------------------}{{ StartupPrinting{{ Gets a print record and sets it to the default values{ for the current printer.{{--------------------------------------------------------------}procedure	StartupPrinting;begin	printHndl := PrRecHndl (NewHandle (140,						   myMemoryID,						   attrNoCross + attrLocked,						   Ptr (0)));	PrDefault (printHndl);end;