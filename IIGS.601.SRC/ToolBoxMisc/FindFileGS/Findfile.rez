t+RefIsResource,		0,		31,		1108}	  };	};// Files-found listresource rControlTemplate (1009 + 640) {	1009 + 640,	{48,-1,98,298},	listControl{	 {	0,		FctlProcNotPtr+FctlIsMultiPart,		0,		0,		0,		2,		1,		10,		20,		0}	  };	};resource rControlTemplate (1009 + 320) {	1009 + 320,	{48,-1,98,304},	listControl{	 {	0,		FctlProcNotPtr+FctlIsMultiPart,		0,		0,		0,		2,		1,		10,		20,		0}	  };	};// Path-to-a-found-file listresource rControlTemplate (1015 + 640) {	1015 + 640,	{99,-1,149,298},	listControl{	 {	0x0080+0x0040 /* testMemNever */,		FctlProcNotPtr+FctlIsMultiPart,		0,		0,		0,		2,		1,		10,		20,		0}	  };	};	resource rControlTemplate (1015 + 320) {	1015 + 320,	{99,-1,149,304},	listControl{	 {	0x0080+0x0040 /* testMemNever */,		FctlProcNotPtr+FctlIsMultiPart,		0,		0,		0,		2,		1,		10,		20,		0}	  };	};	resource rMenu (1006) {	1006,	0xA000,	1006,	{ 1604,	  1601,	  1602,	  1603}	  };	  resource rMenuItem (1601) {	1601,	"","",	0,	0x8000,	1003};resource rMenuItem (1602) {	1602,	"","",	0,	0x8000,	1004};resource rMenuItem (1603) {	1603,	"","",	0,	0x8000,	1005};resource rMenuItem (1604) {	1604,	"","",	0,	0x8000,	1006};resource rMenuItem (1605) {	1605,	"","",	0,	0x8000,	1007};resource rPString (1)    { "FindFile" };resource rPString (1001) { "Find File" };resource rPString (1002) { "Stop" };resource rPString (1003) { "Matches" };resource rPString (1004) { "Starts With" };resource rPString (1005) { "Ends With" };resource rPString (1006) { "Contains" };resource rTextForLETextBox2 (1007) { "File to search for:" };resource rPString (1108) { "" };