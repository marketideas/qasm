#   File:       Makefile#   Target:     'FindFIle'App      = FindFile		   # make findfile desk accessory{App}	ÄÄ	:Obj:FindFileDA.Code :Obj:FindFile.Rez.Out	Duplicate -y :obj:FindFileDA.Code FindFile	Duplicate -r -y :obj:FindFile.Rez.Out FindFile#	duplicateIIgs -mac -y FindFile :	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac FindFile :	End:Obj:FindFileDA.Code	Ä	makefile ¶							:obj:DAInterface.asm.obj ¶							:obj:ProcessLevel.asm.obj¶							:obj:FindFileDA.p.obj	LinkIIGS -t NDA ¶		:obj:DAInterface.asm.obj ¶		:obj:ProcessLevel.asm.obj¶		:obj:FindFileDA.p.obj ¶		-a period=20 ¶		-a mask=$0FF7 ¶		-lib "{PIIGSlibraries}"PLib ¶		-o :obj:FindFileDA.Code:obj:DAInterface.asm.obj Ä DAInterface.asm	ASMIIgs  DAInterface.asm -o :obj:DAInterface.asm.obj:obj:ProcessLevel.asm.obj Ä ProcessLevel.asm	ASMIIgs  ProcessLevel.asm -o :obj:ProcessLevel.asm.obj:obj:FindFileDA.p.obj Ä FindFileDA.p 	#Always use the -r option when creating a desk accessory	PascalIIGS  -r FindFileDA.p -o :obj:FindFileDA.p.obj	:obj:FindFile.Rez.Out Ä FindFile.Rez	RezIIgs FindFile.Rez -o :obj:FindFile.Rez.Out