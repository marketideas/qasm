## Target is "ReadMeFiles", which depends on everything.## 21-Oct-91 DAL## 31-Mar-93 SS -- Added Whats.New (for 6.0.1)#ReadMeFiles 컴 Shortcuts Read.Me Whats.NewShortcuts 컴 Shortcuts.r Shortcuts.text makefile	duplicate -y Shortcuts.text Shortcuts	reziigs Shortcuts.r -o Shortcuts -t $70505445	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac Shortcuts :	EndRead.Me 컴 Read.Me.r Read.Me.text makefile	duplicate -y Read.Me.text Read.Me	reziigs Read.Me.r -o Read.Me -t $70505445	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac Read.Me :	EndWhats.New 컴 Whats.New.r Whats.New.text makefile	duplicate -y Whats.New.text Whats.New	reziigs Whats.New.r -o Whats.New -t $70505445	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac Whats.New :	End