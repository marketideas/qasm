############################################################################### synthLABToDiskImage## This script copies the synthLAB files to the indicated disk images.## 11/07/90	GAB	Brand new for the 6.0 project######################################################################################################################## Set the destination#########################################IF "{2}" == ""	set Dest "A2CE_Sources:System Disk 6.0"	set DestSD "A2CE_Sources:System Disk 6.0:Install:"	set DestST1 "A2CE_Sources:System Disk 6.0:Sys.Tools1:"	set DestST2 "A2CE_Sources:System Disk 6.0:Sys.Tools2:"	set synthLab "A2CE_Sources:System Disk 6.0:synthLAB:"ELSE	# First we make sure the directory name ends in a colon.	IF "{2}" !~ /Å[:]/		set 2 "{2}"¶:	END	set Dest "{2}"	set DestSD "{2}"Install:	set DestST1 "{2}"Sys.Tools1:	set DestST2 "{2}"Sys.Tools2:	set synthLab "{2}"synthLAB:END########################################## Set the source#########################################IF "{1}" == ""	set Src "bugs:synthLab:"ELSE	# First we make sure the directory name ends in a colon.	IF "{1}" !~ /Å[:]/		set 1 {1}¶:	END	SET Src {1}END########################################## Now do the copying.#########################################echo "# Copying synthLab from {Src} to {Dest}."set echo onduplicate -d  -y	"{Src}"synthLAB						"{synthLab}"duplicate -d  -y	"{Src}"Icons:SL.Icons				"{synthLab}"Icons:duplicate -d  -y	"{Src}"Synth.seq ¶					"{Src}"Synth.wav ¶					"{Src}"Synth.bnk					"{synthLab}"Seq.and.InstrDuplicate -d  -y	"{Src}"Seq.and.Instr:Bee.seq ¶					"{Src}"Seq.and.Instr:Combo.bnk ¶					"{Src}"Seq.and.Instr:Combo.wav ¶					"{Src}"Seq.and.Instr:Demo.bnk ¶					"{Src}"Seq.and.Instr:Demo.wav ¶					"{Src}"Seq.and.Instr:Fugue.seq ¶					"{Src}"Seq.and.Instr:Midsummer.seq ¶					"{Src}"Seq.and.Instr:Orch.bnk ¶					"{Src}"Seq.and.Instr:Orch.wav ¶					"{Src}"Seq.and.Instr:Piano.bnk ¶					"{Src}"Seq.and.Instr:Piano.wav ¶#					"{Src}"Seq.and.Instr:ShortDemo.seq ¶					"{Src}"Seq.and.Instr:Capri.seq ¶#					"{Src}"Seq.and.Instr:FullDemo.seq ¶					"{Src}"Seq.and.Instr:Rhythm.seq ¶					"{Src}"Seq.and.Instr:Sonata.seq		"{synthLab}"Seq.and.InstrDuplicate -y		"{Src}"Reference					"{synthLab}"Reference#Duplicate -d -y		"{Src}"Seq.and.Instr:A1.wav ¶#					"{Src}"Seq.and.Instr:B2.wav ¶#					"{Src}"Seq.and.Instr:InstA.bnk ¶#					"{Src}"Seq.and.Instr:InstF.bnk		"{DestST1}"Seq.and.Instrunset echo