### CheckOutAll  {-a | Name | -newer | other checkout options }## Makes the checkout command for each of the six projects necessary to # build system disk 4.1.### At least one parameter must be given.  Either a -a for  all or a # name to check out.## All parameters are passed directly to checkout.## The -r and -p options are always given.###########################################################################for proj in `MountProject -pp -s`	# for all mounted projects	CheckOut -r -p {parameters} -project "{proj}"end