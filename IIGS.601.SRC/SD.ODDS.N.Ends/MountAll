## MountAll {Dest for CheckOutDir}## This script mounts the following projects and set their checkout dirs# to the specified destination.##		A.U.G.#		GS.OS#		BASIC.SYSTEM#		GSToolbox#		SD.ODDS.N.ENDS### If no destination is specified, then the checkout directory is set to# {Boot}##################################################################################################################### Set the Checkout Dir Destination#########################################IF "{1}" == ""	set Dest "{Boot}"ELSE	# First we make sure the directory name ends in a colon.	IF "{1}" !~ /Å[:]/		set 1 "{1}"¶:	END	SET Dest "{1}"ENDbegin	unset exit	NewFolder "{Dest}"A.U.G.	NewFolder "{Dest}"GS.OS	NewFolder "{Dest}"BASIC.SYSTEM	NewFolder "{Dest}"GSToolbox	NewFolder "{Dest}"SD.Odds.N.Ends	set exit 1end >>dev:null ³³dev:nullMountProject A2CE_Sources:gsprojects:a.u.g.checkoutdir -project a.u.g. "{Dest}"a.u.g. -rMountProject A2CE_Sources:gsprojects:gs.oscheckoutdir -project gs.os "{Dest}"gs.os -rMountProject A2CE_Sources:gsprojects:basic.systemcheckoutdir -project basic.system "{Dest}"basic.system -rMountProject A2CE_Sources:gsprojects:gstoolboxcheckoutdir -project gstoolbox "{Dest}"gstoolbox -rMountProject A2CE_Sources:gsprojects:sd.odds.n.endscheckoutdir -project sd.odds.n.ends "{Dest}"sd.odds.n.ends -rMountProject A2CE_Sources:gsprojects:Fontscheckoutdir -project fonts "{Dest}"Fonts -rMountProject A2CE_Sources:gsprojects:ArchiverGScheckoutdir -project ArchiverGS "{Dest}"ArchiverGS -rMountProject A2CE_Sources:gsprojects:toolboxMIsccheckoutdir -project toolboxMIsc "{Dest}"toolboxMIsc -r