* Remove the following line if you don't want to see the progress of the* file transferSet Echo On* Modify the following line so that the Source variable is set to the* location of the SpongeBoy filesset Source ":A2CE_Sources:System Disk 6.0:"* The following lines duplicate the SpongeBoy files to the :System.Disk disk.Duplicate "{Source}Install:ProDOS"                                  ":System.Disk:ProDOS"MkDir :System.Disk:System  Duplicate "{Source}Install:System:Start.GS.OS"                    ":System.Disk:System:Start.GS.OS"  Duplicate "{Source}Install:System:GS.OS"                          ":System.Disk:System:GS.OS"  Duplicate "{Source}Install:System:Error.Msg"                      ":System.Disk:System:Error.Msg"  Duplicate "{Source}Install:System:GS.OS.Dev"                      ":System.Disk:System:GS.OS.Dev"  MkDir :System.Disk:System:FSTs    Duplicate "{Source}Install:System:FSTs:Pro.FST"                 ":System.Disk:System:FSTs:Pro.FST"  MkDir :System.Disk:System:Drivers    Duplicate "{Source}Install:System:Drivers:AppleDisk3.5"         ":System.Disk:System:Drivers:AppleDisk3.5"    Duplicate "{Source}Install:System:Drivers:AppleDisk5.25"        ":System.Disk:System:Drivers:AppleDisk5.25"    Duplicate "{Source}Install:System:Drivers:Console.Driver"       ":System.Disk:System:Drivers:Console.Driver"    Duplicate "{Source}Install:System:FSTs:Char.FST"                ":System.Disk:System:FSTs:Char.FST"  MkDir :System.Disk:System:System.Setup:    Duplicate "{Source}Install:System:System.Setup:Tool.Setup"      ":System.Disk:System:System.Setup:Tool.Setup"    Duplicate "{Source}Install:System:System.Setup:TS2"             ":System.Disk:System:System.Setup:TS2"    Duplicate "{Source}Install:System:System.Setup:TS3"             ":System.Disk:System:System.Setup:TS3"    Duplicate "{Source}Install:System:System.Setup:Resource.Mgr"    ":System.Disk:System:System.Setup:Resource.Mgr"    Duplicate "{Source}Install:System:System.Setup:Sys.Resources"   ":System.Disk:System:System.Setup:Sys.Resources"  MkDir :System.Disk:System:Desk.Accs:    Duplicate "{Source}Install:System:Desk.Accs:ControlPanel"       ":System.Disk:System:Desk.Accs:ControlPanel"  MkDir :System.Disk:System:CDevs:    Duplicate "{Source}SystemTools1:System:CDevs:Printer"           ":System.Disk:System:CDevs:Printer"    Duplicate "{Source}SystemTools1:System:CDevs:Time"              ":System.Disk:System:CDevs:Time"  Duplicate "{Source}SystemTools1:System:Finder"                    ":System.Disk:System:Start"  MkDir :System.Disk:System:Tools    Duplicate "{Source}Install:System:Tools:Tool014"                ":System.Disk:System:Tools:Tool014"    Duplicate "{Source}Install:System:Tools:Tool015"                ":System.Disk:System:Tools:Tool015"    Duplicate "{Source}Install:System:Tools:Tool016"                ":System.Disk:System:Tools:Tool016"    Duplicate "{Source}Install:System:Tools:Tool018"                ":System.Disk:System:Tools:Tool018"    Duplicate "{Source}Install:System:Tools:Tool019"                ":System.Disk:System:Tools:Tool019"    Duplicate "{Source}Install:System:Tools:Tool020"                ":System.Disk:System:Tools:Tool020"    Duplicate "{Source}Install:System:Tools:Tool021"                ":System.Disk:System:Tools:Tool021"    Duplicate "{Source}Install:System:Tools:Tool022"                ":System.Disk:System:Tools:Tool022"    Duplicate "{Source}Install:System:Tools:Tool023"                ":System.Disk:System:Tools:Tool023"    Duplicate "{Source}SystemTools1:System:Tools:Tool025"           ":System.Disk:System:Tools:Tool025"    Duplicate "{Source}Install:System:Tools:Tool027"                ":System.Disk:System:Tools:Tool027"    Duplicate "{Source}Install:System:Tools:Tool028"                ":System.Disk:System:Tools:Tool028"    Duplicate "{Source}Install:System:Tools:Tool034"                ":System.Disk:System:Tools:Tool034"  MkDir :System.Disk:System:Fonts  Duplicate "{Source}Install:System:P8"                             ":System.Disk:System:P8"  MkDir :System.Disk:Icons:    Duplicate "{Source}Install:Icons:FType.Apple"                   ":System.Disk:Icons:FType.Apple"  Duplicate "{Source}SystemTools1:BASIC.System"                     ":System.Disk:BASIC.System"Eject :System.Disk: