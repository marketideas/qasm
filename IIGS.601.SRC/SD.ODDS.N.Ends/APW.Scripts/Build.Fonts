* Remove the following line if you don't want to see the progress of the* file transferSet Echo On* Modify the following line so that the Source variable is set to the* location of the SpongeBoy filesset Source ":A2CE_Sources:System Disk 6.0:"* The following lines duplicate the SpongeBoy files to the :Fonts disk.MkDir :Fonts:System:  MkDir :Fonts:System:Fonts:    Duplicate "{Source}Fonts:System:Fonts:Courier.27" ":Fonts:System:Fonts:Courier.27"    Duplicate "{Source}Fonts:System:Fonts:Courier.28" ":Fonts:System:Fonts:Courier.28"    Duplicate "{Source}Fonts:System:Fonts:Courier.30" ":Fonts:System:Fonts:Courier.30"    Duplicate "{Source}Fonts:System:Fonts:Courier.36" ":Fonts:System:Fonts:Courier.36"    Duplicate "{Source}Fonts:System:Fonts:Courier.42" ":Fonts:System:Fonts:Courier.42"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.27" ":Fonts:System:Fonts:Helvetica.27"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.28" ":Fonts:System:Fonts:Helvetica.28"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.30" ":Fonts:System:Fonts:Helvetica.30"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.36" ":Fonts:System:Fonts:Helvetica.36"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.42" ":Fonts:System:Fonts:Helvetica.42"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.48" ":Fonts:System:Fonts:Helvetica.48"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.60" ":Fonts:System:Fonts:Helvetica.60"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.72" ":Fonts:System:Fonts:Helvetica.72"    Duplicate "{Source}Fonts:System:Fonts:Helvetica.96" ":Fonts:System:Fonts:Helvetica.96"    Duplicate "{Source}Fonts:System:Fonts:Times.27" ":Fonts:System:Fonts:Times.27"    Duplicate "{Source}Fonts:System:Fonts:Times.28" ":Fonts:System:Fonts:Times.28"    Duplicate "{Source}Fonts:System:Fonts:Times.30" ":Fonts:System:Fonts:Times.30"    Duplicate "{Source}Fonts:System:Fonts:Times.36" ":Fonts:System:Fonts:Times.36"    Duplicate "{Source}Fonts:System:Fonts:Times.42" ":Fonts:System:Fonts:Times.42"    Duplicate "{Source}Fonts:System:Fonts:Times.48" ":Fonts:System:Fonts:Times.48"    Duplicate "{Source}Fonts:System:Fonts:Times.60" ":Fonts:System:Fonts:Times.60"    Duplicate "{Source}Fonts:System:Fonts:Times.72" ":Fonts:System:Fonts:Times.72"    Duplicate "{Source}Fonts:System:Fonts:Times.96" ":Fonts:System:Fonts:Times.96"MkDir ":Fonts:Goodies"  Duplicate "{Source}Fonts:Goodies:Apple.Bowl"    ":Fonts:Goodies:Apple.Bowl"  Duplicate "{Source}Fonts:Goodies:Read.Me"       ":Fonts:Goodies:Read.Me"MkDir ":Fonts:Icons"  Duplicate "{Source}Fonts:Icons:AppleBowl.Icon"  ":Fonts:Icons:AppleBowl.Icon"