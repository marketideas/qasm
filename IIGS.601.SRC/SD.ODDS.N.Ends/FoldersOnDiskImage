# FoldersOnDiskImage## This script creates empty folders in the specified location in the form# of the system disk and system tools disk.## 15 Jan 89		Steven Glass## Also delete the original image before starting.### 10 Mar 89		Steven Glass## Changed names to 5.0## 11/27/89	Mensch# Added third disk stuff and changed names...##################################################################################################################### Set the destination#########################################IF "{1}" == ""	set Dest "A2CE_Sources:"	set DestSD "A2CE_Sources:System Disk 6.0:Install:"	set DestST1 "A2CE_Sources:System Disk 6.0:SystemTools1:"	set DestST2 "A2CE_Sources:System Disk 6.0:SystemTools2:"	set DestST3 "A2CE_Sources:System Disk 6.0:Fonts:"	set SynthLab "A2CE_Sources:System Disk 6.0:SynthLab:"ELSE	# First we make sure the directory name ends in a colon.	IF "{1}" !~ /Å[:]/		set 1 "{1}"¶:	END	set Dest "{1}"	set DestSD "{1}"Install:	set DestST1 "{1}"SystemTools1:	set DestST2 "{1}"SystemTools2:	set DestST3 "{1}"Fonts:	set SynthLab "{1}"SynthLab:ENDecho "# Deleting old image on {Dest}"delete -y -i "{DestSD}"delete -y -i "{DestST1}"delete -y -i "{DestST2}"delete -y -i "{DestST3}"delete -y -i "{SynthLab}"delete -y -i "{Fonts}"echo "# Making folders on {Dest} for 6.0 project"set echo onnewfolder "{DestSD}"newfolder "{DestSD}"Systemnewfolder "{DestSD}"System:System.Setupnewfolder "{DestSD}"System:Desk.Accsnewfolder "{DestSD}"System:CDevsnewfolder "{DestSD}"System:FSTsnewfolder "{DestSD}"System:Driversnewfolder "{DestSD}"System:Toolsnewfolder "{DestSD}"System:Fontsnewfolder "{DestSD}"Iconsnewfolder "{DestSD}"Scriptsnewfolder "{DestST1}"newfolder "{DestST1}"Systemnewfolder "{DestST1}"System:Desk.Accsnewfolder "{DestST1}"System:CDevsnewfolder "{DestST1}"System:FSTsnewfolder "{DestST1}"System:Driversnewfolder "{DestST1}"System:Toolsnewfolder "{DestST1}"System:Fontsnewfolder "{DestST1}"Icons#newfolder "{DestST1}"Seq.and.Instr	# for extra SynthLab samplesnewfolder "{DestST2}"newfolder "{DestST2}"Systemnewfolder "{DestST2}"System:System.Setupnewfolder "{DestST2}"System:Desk.Accsnewfolder "{DestST2}"System:CDevsnewfolder "{DestST2}"System:FSTsnewfolder "{DestST2}"System:Driversnewfolder "{DestST2}"System:Drivers:Media.Controlnewfolder "{DestST2}"System:Toolsnewfolder "{DestST2}"System:Fontsnewfolder "{DestST2}"System:Soundsnewfolder "{DestST2}"AppleTalknewfolder "{DestST2}"Iconsnewfolder "{DestST3}"newfolder "{DestST3}"Systemnewfolder "{DestST3}"System:Fontsnewfolder "{DestST3}"Goodiesnewfolder "{DestST3}"Iconsnewfolder "{SynthLab}"newfolder "{SynthLab}"Iconsnewfolder "{SynthLab}"Seq.and.Instrunset echo