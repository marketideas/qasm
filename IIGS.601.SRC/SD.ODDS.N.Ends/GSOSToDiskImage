# GSOSToDiskImage## This script copies the local copy of the OS objects to the indicated # destination. If no destination is indicated, we assume A2CE_Sources.### 10 Mar 89		Steven Glass## Changed names to 5.0## [Who? When?]## Changed names to 6.0 and added the third disk. Also re-arranged quite a bit of stuff## 8-Feb-93 DAL for 6.0.1#   Added RAM5 driver.## 6-May-93 DAL for 6.0.1d17#   Removed ETalk driver.############################################################################################################################ Set the destination#########################################IF "{2}" == ""	set Dest "A2CE_Sources:System Disk 6.0"	set DestSD "A2CE_Sources:System Disk 6.0:Install:"	set DestST1 "A2CE_Sources:System Disk 6.0:SystemTools1:"	set DestST2 "A2CE_Sources:System Disk 6.0:SystemTools2:"ELSE	# First we make sure the directory name ends in a colon.	IF "{2}" !~ /Å[:]/		set 2 "{2}"¶:	END	set Dest "{2}"	set DestSD "{2}"Install:	set DestST1 "{2}"SystemTools1:	set DestST2 "{2}"SystemTools2:END########################################## Set the source#########################################IF "{1}" == ""	set Src "bugs:GS.OS:SystemDisk:"ELSE	# First we make sure the directory name ends in a colon.	IF "{1}" !~ /Å[:]/		set 1 {1}¶:	END	SET Src {1}END########################################## Now do the copying.#########################################echo "# Copying GS.OS objects from {Src} to {Dest}."set echo onduplicate -d -y	"{Src}"prodos							"{DestSD}"ProDOSduplicate -d -y "{Src}"system:gs.os						"{DestSD}"system:GS.OSduplicate -d -y "{Src}"system:p8						"{DestSD}"system:P8duplicate -d -y "{Src}"system:start.gs.os				"{DestSD}"system:Start.GS.OSduplicate -d -y "{Src}"system:gs.os.dev					"{DestSD}"system:GS.OS.Devduplicate -d -y "{Src}"system:error.msg					"{DestSD}"system:Error.Msg#duplicate -d -y "{Src}"system:expressload				"{DestSD}"system:ExpressLoadduplicate -d -Y	"{Src}"system:fsts:pro.fst				"{DestSD}"system:fsts:Pro.FSTduplicate -d -Y	"{Src}"system:fsts:char.fst				"{DestSD}"system:fsts:Char.FSTduplicate -d -Y	"{Src}"system:fsts:hs.fst				"{DestST1}"system:fsts:HS.FSTduplicate -d -Y	"{Src}"system:fsts:DOS3.3.fst			"{DestST1}"system:fsts:DOS3.3.FSTduplicate -d -Y	"{Src}"system:fsts:Pascal.fst			"{DestST1}"system:fsts:Pascal.FSTduplicate -d -Y	"{Src}"system:fsts:hfs.fst				"{DestST1}"system:fsts:HFS.FSTduplicate -d -Y "{Src}"system:fsts:MSDOS.FST			"{DestST1}"system:fsts:MSDOS.FSTduplicate -d -Y	"{Src}"system:fsts:AppleShare.fst		"{DestST2}"system:fsts:AppleShare.FSTduplicate -d -Y	"{Src}"system:drivers:appledisk3.5		"{DestSD}"system:drivers:AppleDisk3.5duplicate -d -Y	"{Src}"system:drivers:console.Driver	"{DestSD}"system:drivers:Console.Driverduplicate -d -Y	"{Src}"system:drivers:scsihd.Driver		"{DestSD}"system:drivers:SCSIHD.Driverduplicate -d -Y	"{Src}"system:drivers:scsiTape.Driver	"{DestST1}"system:drivers:SCSITape.Driverduplicate -d -Y	"{Src}"system:drivers:scsiScan.Driver	"{DestST1}"system:drivers:SCSIScan.Driverduplicate -d -Y	"{Src}"system:drivers:scsicd.Driver		"{DestST1}"system:drivers:SCSICD.Driverduplicate -d -Y	"{Src}"system:drivers:scsi.manager		"{DestSD}"system:drivers:SCSI.Managerduplicate -d -Y	"{Src}"system:drivers:scsi.manager		"{DestST1}"system:drivers:SCSI.Managerduplicate -d -Y	"{Src}"system:drivers:unidisk3.5		"{DestSD}"system:drivers:UniDisk3.5duplicate -d -Y	"{Src}"system:drivers:appledisk5.25		"{DestSD}"system:drivers:AppleDisk5.25duplicate -d -Y	"{Src}"system:drivers:Slinky			"{DestST1}"system:drivers:A2.RAMCardduplicate -d -Y	"{Src}"system:drivers:RAM5				"{DestST1}"system:drivers:RAM5duplicate -d -Y	"{Src}"system:drivers:ATP1.ATROM		"{DestST2}"system:drivers:ATP1.ATROMduplicate -d -Y	"{Src}"system:drivers:ATP2.ATRAM		"{DestST2}"system:drivers:ATP2.ATRAMduplicate -d -Y	"{Src}"system:drivers:ATALK				"{DestST2}"system:drivers:ATalk#duplicate -d -Y "{Src}"system:drivers:ETALK				"{DestST2}"system:drivers:ETalkduplicate -d -Y	"{Src}"system:drivers:SCC.MANAGER		"{DestST2}"system:drivers:SCC.Managerduplicate -d -Y	"{Src}"system:SYSTEM.SETUP:ATRESPONDER	"{DestST2}"system:SYSTEM.SETUP:ATResponderduplicate -d -y "{Src}"system:SYSTEM.SETUP:ATINIT		"{DestST2}"system:SYSTEM.SETUP:ATInitduplicate -d -y "{Src}"appletalk:DISPLAY.0				"{DestST2}"APPLETALK:Display.0duplicate -d -Y	"{Src}"appletalk:QUICKLOGOFF			"{DestST2}"APPLETALK:QuickLogoffduplicate -d -Y	"{Src}"appletalk:START					"{DestST2}"APPLETALK:Startduplicate -d -Y	"{Src}"appletalk:BOOT.Driver			"{DestST2}"APPLETALK:Boot.Driverunset echo