echo "Mounting necessary projects..."# Mount the projects if they are not mountedunset exitproject a.u.g. ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:a.u.g.	checkoutdir -project a.u.g. {GSProjects}a.u.g. -r# unmount any unnecessary projects	UnMountProject ¶		A.U.G.ºCtlPanelºLogonCDevº			# replaced by AppleShareCDev	ENDProject gs.os ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:gs.os	checkoutdir -project gs.os {GSProjects}gs.os -r	UnMountProject ¶		GS.OSºDeskAccessoriesº				# not used for a System Disk build ¶		GS.OSºSetupFilesºQuickConsoleº			# not used for a System Disk build ¶		GS.OSºSupervisoryDriversºSCSIManagerº		# superceded by the Cocoon SCSI Manager ¶		GS.OSºLoaderºExpressLoadº			# superceded by the System Loader 4.0	ENDProject basic.system  ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:basic.system	checkoutdir -project basic.system {GSProjects}basic.system -r	ENDProject gstoolbox  ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:gstoolbox	checkoutdir -project gstoolbox {GSProjects}gstoolbox -r	UnMountProject ¶###		GSToolboxºFredWorldº			# animation toolkit ¶		GSToolboxºKiddingº			# only used when building ROM ¶		GSToolboxºPrinterDriversºIWº		# superceded by New Imagewriter driver ¶		GSToolBoxºPrinterDriversºHP.DeskJetº	# Marketing get's upset with this one! ¶		GSToolboxºROMº				# only used when building ROM	ENDProject ToolboxMisc  ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:ToolboxMisc	checkoutdir -project ToolboxMisc {GSProjects}ToolboxMisc -r	END	Project ArchiverGS  ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:ArchiverGS	checkoutdir -project ArchiverGS {GSProjects}ArchiverGS -r	END	Project synthLAB  ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:synthLAB	checkoutdir -project synthLAB {GSProjects}synthLAB -r	END	Project sd.odds.n.ends  ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:sd.odds.n.ends	checkoutdir -project sd.odds.n.ends {GSProjects}sd.odds.n.ends -r	ENDProject Fonts  ··dev:nullif {status}­0	MountProject A2CE_Sources:gsprojects:Fonts	checkoutdir -project Fonts {GSProjects}Fonts -r		END