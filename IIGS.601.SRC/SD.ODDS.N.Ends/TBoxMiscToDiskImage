## ToolboxMiscToDiskImage## This script copies the toolbox misc files to the indicated disk images.## 11/27/89	Mensch# Changed names and added 3rd disk...######################################################################################################################## Set the destination#########################################IF "{2}" == ""	set Dest "A2CE_Sources:System Disk 6.0"	set DestSD "A2CE_Sources:System Disk 6.0:Install:"	set DestST1 "A2CE_Sources:System Disk 6.0:SystemTools1:"	set DestST2 "A2CE_Sources:System Disk 6.0:SystemTools2:"#	set SynthLab "A2CE_Sources:System Disk 6.0:SynthLab:"ELSE	# First we make sure the directory name ends in a colon.	IF "{2}" !~ /Å[:]/		set 2 "{2}"¶:	END	set Dest "{2}"	set DestSD "{2}"Install:	set DestST1 "{2}"SystemTools1:	set DestST2 "{2}"SystemTools2:#	set SynthLab "{2}"SynthLab:END########################################## Set the source#########################################IF "{1}" == ""	set Src "work:gstoolboxMisc:"ELSE	# First we make sure the directory name ends in a colon.	IF "{1}" !~ /Å[:]/		set 1 {1}¶:	END	SET Src {1}END########################################## Now do the copying.#########################################echo "# Copying Toolbox Misc objects from {Src} to {Dest}."unset exitset echo on# Copies the appropriate files to A2CE_Sources#duplicate -Y	"{Src}"FindFilegs:FindFile		"{DestST1}"system:Desk.Accs:FindFileduplicate -Y	"{Src}"Teach:Teach				"{DestST2}"Teach duplicate -Y	"{Src}":ArchiverGS:Archiver.app	"{DestST2}"ArchiverDuplicate -y	"{Src}"ReadMeFiles:Read.Me		"{DestST2}"Read.MeDuplicate -y	"{Src}"ReadMeFiles:Shortcuts	"{DestST2}"ShortcutsDuplicate -y	"{Src}"ReadMeFiles:Whats.New	"{DestST2}"Whats.Newunset echoset exit 1