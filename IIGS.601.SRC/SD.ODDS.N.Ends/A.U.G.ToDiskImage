# A.U.G.ToDiskImage## This script copies the local image of a.u.g. files to the designated# destination images.##################################################################################################################### Set the destination#########################################IF "{2}" == ""	set Dest "A2CE_Sources:System Disk 6.0:"	set DestSD "A2CE_Sources:System Disk 6.0:Install:"	set DestST1 "A2CE_Sources:System Disk 6.0:SystemTools1:"	set DestST2 "A2CE_Sources:System Disk 6.0:SystemTools2:"	set SynthLab "A2CE_Sources:System Disk 6.0:SynthLab:"	set Fonts "A2CE_Sources:System Disk 6.0:Fonts:"ELSE	# First we make sure the directory name ends in a colon.	IF "{2}" !~ /Å[:]/		set 2 "{2}"¶:	END	set Dest "{2}"	set DestSD "{2}"Install:	set DestST1 "{2}"SystemTools1:	set DestST2 "{2}"SystemTools2:	set SynthLab "{2}"SynthLab:	set Fonts "{2}"Fonts:END########################################## Set the source#########################################IF "{1}" == ""	set AUG "{GSProjects}A.U.G.:"ELSE	# First we make sure the directory name ends in a colon.	IF "{1}" !~ /Å[:]/		set 1 {1}¶:	END	SET AUG {1}END########################################## Now do the copying.#########################################echo "# Copying AUG objects from {AUG} to {Dest}."set echo onunset exitduplicate -Y "{AUG}"CtlPanel:SetStartCDEV:Start		"{DestSD}"system:StartSetLoadName "{DestSD}"System:Start -n SetStartduplicate -Y "{AUG}"finder:finder					"{DestST1}"system:FinderSetLoadName "{DestST1}"System:Finder -n Finderduplicate -Y "{AUG}"installer:installer				"{DestSD}"Installer#Duplicate -y -d "{AUG}"Installer:Installer.Icons	"{DestSD}"Icons:Installer.Iconsduplicate -Y "{AUG}"ADU:Adv.Disk.Util				"{DestST1}"Adv.Disk.Utilbegin	delete -i "{DestSD}"Scripts:Å  end >>dev:null ³³dev:nullduplicate -d -y "{AUG}"installerscripts:Å			"{DestSD}"Scripts:## Now kill any scripts that were copied that should not have beenFor File in "{DestSD}"Scripts:All.Drivers ¶			"{DestSD}"Scripts:CD.Driver ¶			"{DestSD}"Scripts:HD.Driver ¶			"{DestSD}"Scripts:Scanner.Driver ¶			"{DestSD}"Scripts:Tape.Driver ¶			"{DestSD}"Scripts:Stuff ¶			"{DestSD}"Scripts:Animation.Tool ¶			"{DestSD}"Scripts:QuickerGraph	¶			"{DestSD}"Scripts:EtherTalk	Delete -i "{File}"end# Now correct the character case of the script namesfor f in ¶	Adv.Disk.Util ¶	Apple.MIDI ¶	AppleDisk5.25 ¶	AppleShare ¶	ATImageWriter ¶	ATImageWriterLQ ¶	Card6850.MIDI ¶	CDROM ¶	DCImageWriter ¶	DCImageWriterLQ ¶	DOS3.3.FST ¶	Epson ¶	Fonts ¶	HFS.FST ¶	Inst.Sys.Min ¶	Inst.SysF.NoFin ¶	Instal.Sys.File ¶	LaserWriter ¶	Local.Net.Boot ¶	Namer ¶	Pascal.FST ¶	Quick.Logoff ¶	SCSI.Hard.Disk ¶	Server.Sys.File ¶	StyleWriter ¶	synthLAB ¶	UniDisk3.5 ¶	VideoMix		Rename "{DestSD}"Scripts:{f} "{DestSD}"Scripts:{f}end# the following scripts should have the "GS" removed from their names	Rename "{DestSD}"Scripts:ArchiverGS	"{DestSD}"Scripts:ArchiverRename "{DestSD}"Scripts:GSCalc.NDA	"{DestSD}"Scripts:CalculatorRename "{DestSD}"Scripts:TeachGS	"{DestSD}"Scripts:Teach# the following scripts must be renamed to follow the new conventionsRename "{DestSD}"Scripts:MediaCtrl		"{DestSD}"Scripts:MediaControlRename "{DestSD}"Scripts:CloseView.Init	"{DestSD}"Scripts:CloseViewRename "{DestSD}"Scripts:Find.File.NDA	"{DestSD}"Scripts:FindFileRename "{DestSD}"Scripts:Tape6.0		"{DestSD}"Scripts:SCSI.TapeRename "{DestSD}"Scripts:Scan6.0		"{DestSD}"Scripts:SCSI.Scanner# and to prevent any legal hassles...Rename "{DestSD}"Scripts:Slinky			"{DestSD}"Scripts:A2.RAMCard# now we set the proper filetype and auxtype on all scriptsfor file in `files -f "{DestSD}"Scripts`	Echo "FOO" | Rez -o "{file}" -m -c pdos -t $70B00017 ³ DEV:NULL	SetFile -m . "{file}"end# Kill the cdevs in case any extra are in place.begin	delete -i -y "{DestSD}"system:cdevs:Å	delete -i -y "{DestST1}"system:cdevs:Å	delete -i -y "{DestST2}"system:cdevs:Åend  >>dev:null ³³dev:nullduplicate -Y	"{AUG}"CDRemote:CDRemote						"{DestST1}"system:desk.accs:CDRemoteduplicate -Y	"{AUG}"GSCalcNDA:GSCalc.NDA						"{DestST1}"system:desk.accs:Calculator#duplicate -Y	"{AUG}"ctlpanel:cdev.init:cdev.init				"{DestSD}"system:system.setup:CDev.Initduplicate -Y	"{AUG}"ctlpanel:ctlpanelnda:ctlpanel.nda		"{DestSD}"system:desk.accs:ControlPanelduplicate -Y	"{AUG}"ctlpanel:GeneralCDEV:General				"{DestSD}"system:CDEVS:Generalduplicate -Y	"{AUG}"ctlpanel:KeyboardCDEV:Keyboard			"{DestST1}"system:CDEVS:Keyboardduplicate -Y	"{AUG}"ctlpanel:ModemCDEV:Modem					"{DestST1}"system:CDEVS:Modemduplicate -Y	"{AUG}"ctlpanel:MonitorCDEV:Monitor				"{DestST1}"system:CDEVS:Monitorduplicate -Y	"{AUG}"ctlpanel:NetPrinterCDEV:NetPrinter		"{DestST2}"system:CDEVS:NetPrinterduplicate -Y	"{AUG}"ctlpanel:NetworkCDEV:Network				"{DestST2}"system:CDEVS:Networkduplicate -Y	"{AUG}"ctlpanel:PrinterCDEV:PRINTER				"{DestST1}"system:CDEVS:Printerduplicate -Y	"{AUG}"ctlpanel:RAMDiskCDEV:RAMDisk				"{DestSD}"system:CDEVS:RAMduplicate -Y	"{AUG}"ctlpanel:SlotsCDEV:Slots					"{DestST1}"system:CDEVS:Slotsduplicate -Y	"{AUG}"ctlpanel:SoundCDEV:Sound					"{DestST1}"system:CDEVS:Soundduplicate -Y	"{AUG}"ctlpanel:TimeCDEV:Time					"{DestST1}"system:CDEVS:Timeduplicate -Y	"{AUG}"ctlpanel:NamerCDEV:Namer					"{DestST2}"system:CDEVS:Namerduplicate -Y	"{AUG}"ctlpanel:DirectConnectCDEV:DIRECTCONNECT	"{DestST1}"system:CDEVS:DirectConnectduplicate -Y	"{AUG}"ctlpanel:AppleShareCDEV:Appleshare		"{DestST2}"system:CDEVS:AppleShareduplicate -Y	"{AUG}"ctlpanel:FolderPrivCDEV:FolderPriv		"{DestST2}"system:CDEVS:FolderPrivduplicate -Y	"{AUG}"CtlPanel:SetStartCDEV:SetStart			"{DestSD}"system:CDevs:SetStartduplicate -Y	"{AUG}"CtlPanel:MidiCDev:MIDI					"{SynthLab}"MIDIduplicate -Y	"{AUG}"videomix:VideoMix.NDA:VideoMix.NDA		"{DestST2}"system:desk.accs:VideoMixduplicate -Y	"{AUG}"videomix:VideoMix.INIT:AppleIIVOC.INIT	"{DestST2}"system:system.setup:AppleIIVOCduplicate -Y	"{AUG}"CloseView:Closeview						"{DestST2}"system:system.setup:CloseViewduplicate -Y -d	"{AUG}"VideoKeyboard:VideoKeyboard				"{DestST2}"system:Desk.Accs:VideoKeyboardduplicate -Y	"{AUG}"MediaCtl:AppleCDSC:AppleCDSC				"{DestST2}"system:drivers:Media.Control:AppleCDSCduplicate -Y	"{AUG}"MediaCtl:MediaCtlCDEV:MediaCtrl			"{DestST2}"system:CDevs:MediaControlduplicate -Y	"{AUG}"MediaCtl:MediaCtlNDA:MediaCtlNDA			"{DestST2}"system:Desk.accs:MediaControlduplicate -Y	"{AUG}"MediaCtl:P4200:P4200						"{DestST2}"system:drivers:Media.Control:Pioneer4200duplicate -Y	"{AUG}"MediaCtl:Pioneer2000:P2000				"{DestST2}"system:drivers:Media.Control:Pioneer2000duplicate -Y	"{AUG}"EasyAccess:EasyAccess					"{DestST2}"system:system.setup:EasyAccessduplicate -y	"{AUG}"Finder:EasyMount:EasyMount				"{DestST2}"System:System.Setup:EasyMountduplicate -y	"{AUG}"Apple.Bowl:Apple.Bowl					"{Fonts}"Goodies:Apple.Bowlduplicate -y	"{AUG}"Apple.Bowl:Read.Me						"{Fonts}"Goodies:Read.Meduplicate -y -d	"{AUG}"Apple.Bowl:AppleBowl.Icon				"{Fonts}"Icons:AppleBowl.IconFor F in Ahh Doorbell Droplet Eastern Frog PipeOrgan Quack SimpleBeep Sosumi Swish Trumpets Whoosh	Duplicate -y "{AUG}"CtlPanel:SoundCDev:Sounds:{f}			"{DestST2}"System:Soundsend# Reset the create dates on all CDevs so that the Control.Panel will rebuild it's# CDev.Data fileSetFile -d . "{DestSD}"System:CDevs:Å "{DestST1}"System:CDevs:Å "{DestST2}"System:CDevs:Åset exit 1unset echo