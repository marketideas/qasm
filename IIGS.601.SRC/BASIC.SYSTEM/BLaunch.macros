;-----------------------------------------------;;   ProDOS 8 Macros;;-----------------------------------------------		MACRO&LAB	SETPREFIX &DCB&LAB 	JSR		$BF00		DC.B	$C6		DC.W	&DCB 		MEND				MACRO&LAB	GETPREFIX &DCB&LAB	JSR		$BF00		DC.B	$C7		DC.W	&DCB		MEND				MACRO&LAB	GETFILEINFO &DCB&LAB	JSR		$BF00		DC.B	$C4		DC.W	&DCB 		MEND				MACRO&LAB 	OPEN	&DCB&LAB	JSR		$BF00		DC.B	$C8		DC.W	&DCB		MEND				MACRO&LAB	READ	&DCB&LAB	JSR		$BF00		DC.B	$CA		DC.W	&DCB		MEND				MACRO&LAB	CLOSE 	&DCB&LAB	JSR		$BF00		DC.B	$CC		DC.W	&DCB		MEND		;-----------------------------------------------;;   General Purpose Macros;;-----------------------------------------------		MACRO		str		&string		lclc	&sset&sset	SETC 	&SETTING('STRING')		STRING 	PASCAL		dc.B 	&string		STRING 	&sset		MEND				MACRO		pushword &addr,&reg	IF &addr[1:1]='#' AND &SETTING('LONGA')='ON' THEN		pea		|&addr[2:255]	ELSE		IF &addr­'' THEN			IF &reg­'' THEN 				lda		&addr,&reg			ELSE				lda		&addr			ENDIF		ENDIF		pha	ENDIF		MEND			MACRO	pushlong &addr,&offset	IF &addr[1:1]='#' THEN		pea		&addr[2:255]>>16		pea		|&addr[2:255]	ELSEIF &addr[1:1]='[' THEN		ldy		#&offset+2		pushword &addr,y		ldy		#&offset		pushword &addr,y	ELSEIF &offset='s' THEN		pushword &addr+2,s		pushword &addr+2,s	ELSEIF &offset='' THEN		pushword  &addr+2		pushword  &addr	ELSE		pushword &addr+2,&offset		pushword &addr,&offset	ENDIF	MEND			MACRO	pulllong &addr1,&addr2	IF &addr1='' THEN	IF &addr2­'' THEN 		AERROR 'Illegal 2nd parameter'	ENDIF		pullword		pullword	ELSEIF &addr2='' THEN		pullword  &addr1		pullword  &addr1+2	ELSEIF &addr1[1:1]='[' THEN		ldy   #&addr2		pullword  &addr1,y		ldy   #&addr2+2		pullword  &addr1,y	ELSE		pullword  &addr1		sta   &addr2		pullword  &addr1+2		sta   &addr2+2	ENDIF	MEND	MACRO	pullword &addr,&reg		pla	IF &addr­'' THEN		IF &reg­'' THEN			sta		&addr,&reg		ELSE			sta		&addr		ENDIF	ELSEIF &reg­'' THEN 		AERROR 'Illegal 2nd parameter'	ENDIF	MEND	MACRO	native &mode		clc		xce	IF &mode­'' THEN		&mode	ELSE		long	ENDIF	MEND	MACRO	emulation		sec		xce		longa	off		longi	off	MEND	MACRO	long		rep		#%00110000		longa	on		longi	on	MEND	MACRO	short		sep		#%00110000		longa	off		longi	off	MEND;-----------------------------------------------;;   Toolbox Macros;;-----------------------------------------------		MACRO &lab 	_TLStartUp &lab 	ldx		#$0201      	jsl 	$E10000 		MEND 		MACRO &lab	_TLShutDown &lab	ldx		#$0301 		jsl		$E10000 		MEND 		MACRO&lab	_TLTextMountVolume&lab	ldx		#$1201		jsl		$E10000		MEND				MACRO&lab	_MessageCenter&lab	ldx		#$1501		jsl		$E10000		MEND				MACRO&lab	_MMStartUp&lab	ldx		#$0202		jsl		$E10000		MEND		MACRO &lab	_MMShutDown &lab	ldx		#$0302 		jsl		$E10000 		MEND 		MACRO&lab	_NewHandle&lab	ldx		#$0902		jsl		$E10000		MEND		MACRO&lab	_DisposeHandle&lab	ldx		#$1002		jsl		$E10000		MEND