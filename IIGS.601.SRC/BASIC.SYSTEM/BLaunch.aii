**************************************************************************************************                                                                                               ** NOTE: As of System Software 6.0, BASIC.LAUNCHER is obsolete & not shipped.   28-Oct-92 DAL    **                                                                                               ***************************************************************************************************************************************************************************************************** Apple IIgs BASIC LAUNCHER** by Steven Glass** modifications by Greg Branche** Copyright (C)* Apple Computer Inc., 1986-1988* All Rights Reserved** Version 2.1*** Change History** Version 1.0		First Release** Version 2.0		7 July 1987			SEG** Version 2.1		22 December 1988	GAB*				Converted source code from APW to MPW MAX*				Optimized code wherever possible*				Removed support for Program Launcher (old way)*					(Launcher now only supports the Finder*					 and the message center.)* Version 2.1		23 May 1989			GAB		(for real, this time)*				Rearranged program's data so that the name of the interpreter to load*				is in a static location within the file.  This makes it possible to*				patch the name so that this can support more than just BASIC.SYSTEM.*				This is also the first official "projectorized" version.**	Basic.Launcher receives control from a launching program, such as the Finder.*	It checks the message center for a filename passed from the launcher.  If a filename*	is found, the interpreter (Basic.System) is loaded, the filename is copied to the*	interpreter, and then the interpreter is loaded.  If no filename is found in the message*	center, or if the loaded interpreter does not support the passing of a startup filename,*	an appropriate message is displayed on the screen, and then a P8 QUIT is performed to*	return control back to the launching program.***************************************************************************************************************************************************************************************************** BASIC.LAUNCHER** This is a program which runs BASIC.SYSTEM on the boot volume* and puts the name of a BASIC program to be run at $2006.* This works because long ago, Dale Arends and I worked out* this scheme for telling interpreters to run programs.  It* works as follows.**	   1) An interpreter that follows these rules starts*		  with a jmp instruction (opcode $4C).*	   2) An interpreter that follows these rules has*		  $EE at $2003 and $2004.*	   3) An interpreter that follows these rules has*		  a size byte at $2005.  This size byte describes*		  how many of the following bytes can be used*		  to hold a pathname.  (For BASIC.SYSTEM version 1.1*		  this number is $41.)** BASIC.LAUNCHER works closly with the Finder to* get information about the program to be run.	The finder uses the message* center.** The BASIC.LAUNCHER first checks the message center.  If the* file name is there we go on.	If the file name is not in the* message center, we quit.** Going On.** Once deciding that we have a file, BASIC.LAUNCHER loads BASIC.SYSTEM* from the boot volume and puts the pathname of the BASIC program to run* at $2006.  It then jumps to $2000.** Twice it makes sure that the correct disk is on line.  First,* before loading BASIC.SYSTEM it makes sure the boot volume* is on line.  If it is not on line, the insert disk message* will appear.	This is unlikely since BASIC.LAUNCHER must be* run from the system disk.** Finally, just before jumping to $2000, we make sure the volume* containing the BASIC program to be run is on line.  The insert* disk message is more likely to be shown here.**************************************************************************************************;-----------------------------------------------;;	Forward addresses and entries;;-----------------------------------------------				Entry	Launcher				ENTRY	DoIt				entry	proglen				;------------------------------------------;; Equates from procedure BLaunch;;------------------------------------------True			equ	$8000False			equ	$0000Signature		equ	$010104BootVolume		equ	$010108BasicPath		equ	$010126MsgHandle		equ	$0MsgPtr			equ	$4UserID			equ	$8MyPath			equ	$0280InterpStart		equ	$2000InterpSig		equ	$2003InterpMaxLen	equ	$2005InterpName		equ	$2006;------------------------------------------;; Equates from procedure GlobalData;;------------------------------------------VolNotFound		equ $45	;------------------------------------------;absaddr on			PRINT	NOGEN			PRINT	NOSYM			INCLUDE 'BLaunch.macros'			longa off			longi off; org		$2000BLaunch 	PROC	org $2000;using GlobalData			;-----------------------------------------------------;; Switch to 16 bit mode and move everything to $900;						native						lda		#proglen-Launcher-1			ldx		#endmove			;address of DOIT in memory			ldy		#Launcher			;execution address			mvn		0,0					;move main routines down in memory			jmp		DoIt				;then go do it!			org		$2020-BLaunch		;offset to $2020 for .SYSTEM filenameendmove		equ		*			ENDP****************************************************************** Launcher - code module that does all the actual work*		This gets moved to $803 in memory and is executed there*****************************************************************; org		$900			EXPORT	Launcher		Launcher	PROC	temporg $0900		;this get's moved to $900****************************************************************** GlobalDATA*****************************************************************GlobalDataBasicName	str		'BASIC.SYSTEM'	; By placing this here, it's possible to patch the name;									; so that this code can be used for other .SYSTEM programs;									; that adhere to the pathname passing conventions			ds.b	3				; (allow enough space for a complete filename)BVolume 	DS.B 	18 				; volume name for disk containing;									; basic.systemBPath		DS.B 	65 				; Name of basic program to run;BSPath		DS.B 	36 				; path name of BASIC.SYSTEM on;									; boot volume.PVolume 	DS.B 	18OpenParams	DC.B	3			DC.W	BSPath			DC.W	$2000-$400OpenID		DS.B 	1ReadParams	DC.B	4ReadID		DS.B 	1			DC.W	$2000			DC.W	$BEFF-$2000			DS.B 	2CloseParams DC.B	1CloseID 	DS.B 	1GFIParams	DC.B	10			DC.W	PVolume			DS.B	1					; access			DS.B	1					; file type			DS.B	2					; aux type			DS.B	1					; storage type			DS.B	2					; blocks used			DS.B	2					; mod date			DS.B	2					; mod time			DS.B	2					; cre date			DS.B	2					; cre timePrefixParams			DC.B	1			DC.W	BPath;					 123456789012345678901234567 	; 27Sorry1		str		'You cannot run this program'Sorry2		str		'directly.'Sorry3		str		'App. does not support'Sorry4		str		'passing of second filename.'But1		str		'Press RETURN'But2		str		' 'MsgLine 	str		'Insert the disk:'OKBut		str		'RETURN to accept'CancelBut	str		'ESC to cancel'			Entry	DoItDoIt						jsr		CheckForMsg			; check for a message in the message center			bcc		GotAMessage			; got one!			BadSig			ldx		#Sorry1				; get addresses of strings into X and Y			ldy		#Sorry2			jmp		CannotDoIt			; else display error message			GotAMessage			jsr		CreateMsgNames		; go get the program name from the message center;-----------------------------------------------------;; Now create the path name for BASIC.SYSTEM.;			emulation			ldx		BSPath			lda		#'/'			cmp		BSPath,x			beq		LastIsSlash			inx			sta		BSPath,x			stx		BSPathLastIsSlash			lda		BasicName		; get the length of the SYS filename			tay						; save as index to end of name			clc			adc		BSPath			; add to length of volume name			sta		BSPath			; and set it			tax						; use this as index to full pathnameNameLoop			lda		BasicName,y		; get a character			sta		BSPath,x		; and copy to full pathname			dex						; fix indexes			dey			bne		NameLoop		; loop until name is copiedNameMoved;--------------------------------------------------------;; Now we have constructed the path name for BASIC.SYSTEM; So we open the file and read it in. ;			OPEN	OpenParams			bcs		leapFrog		; this "leapfrogs" to GiveUp			lda		OpenID			sta		ReadID			sta		CloseID			READ	ReadParams		; read			php						; save error state			pha			CLOSE	CloseParams			pla			plp						; don't care about error state ofleapFrog			bcs		GiveUp			; close so look at read error;-----------------------------------------------------;; Now lets look at the interpreter we just loaded.;			lda		InterpStart			cmp		#$4C			bne		BadInterp			lda		#$ee			; $EE = signature byte			cmp		InterpSig		; compare to first byte			bne		BadInterp		; oops!			cmp		InterpSig+1			bne		BadInterp			lda		InterpMaxLen			cmp		BPath			bcs		PathOKBadInterp			native			ldx		#Sorry3					;get addresses of strings			ldy		#Sorry4			jmp		CannotDoIt			longa	off			longi	offPathOK;---------------------------------------------------------;; Everything is ok so put the path name into interpreter;			ldx		BPathBNameLoop	lda		BPath,x			sta		InterpName,x			dex			bpl		BNameLoop;-----------------------------------------------------;; Finally, we have to make sure that the volume; containing the BASIC program is on line.;			jsr		CheckForDrive			bcs		GiveUp;----------------------------------------------------;; Now I have to set the prefix to the directory in; question.			ldx		BPathSlashLoop	lda		BPath,x			cmp		#'/'			beq		FoundSlash			dex			bne		SlashLoop			bra		GiveUpFoundSlash	dex			stx		BPath; must shut down the tool sets that we started			native						;into native mode for tool calls			pei		UserID				;shut down the memory manager			_MMShutDown						_TLShutDown					;then shut down the tool locator						emulation					;insure emulation mode			SetPrefix PrefixParams			bcs		GiveUp			jmp		InterpStartGiveUP			jsr		$BF00			DC.B	$65			DC.W	QParamsQParams		DC.B	4			DS.B	8;---------------------------------------------------------; CannotDoIt - displays pseudo dialog box with error message;	Entry is in full native mode, The addresses of the;	error message strings are passed in X (string 1) and;	Y (string 2).;;	The subroutine does not return;CannotDoIt			longa	on			longi	on			pha							;space for returned value			pea		0			phx							;push address of first string			pea		0			phy							;push address of second string			PushLong #But1			PushLong #But2			_TLTextMountVolume			pla			emulation			bra		GiveUp****************************************************************** CheckForDrive** This routine is entered and exited in emulation mode.** The carry flag is used to signal if the disk can be found.*****************************************************************CheckForDrive;using GlobalData			lda		BPath			sta		PVolume			lda		BPath+1			sta		PVolume+1			lda		BPath+2			sta		PVolume+2						ldx		#3MoreLetters lda		BPath,x			cmp		#'/'			beq		LastSlash			sta		PVolume,x			inx			bra		MoreLettersLastSlash	sta		PVolume,x			stx		PVolumeLookForDisk			emulation			GetFileInfo GFIParams			bcc		DoIt1			cmp		#VolNotFound			bne		GiveUp1			native							;switch to native mode			PushWord #0			PushLong #MsgLine			PushLong #PVolume			PushLong #OKBut			PushLong #CancelBut			_TLTextMountVolume			pla			cmp		#1			beq		LookForDiskGiveUp1		sec						; return with errorDoIt1			php			emulation			plp			rts******************************************************************* CheckForMsg** Finds out if there is a finder message in the message* center.** Returns carry set if there is not, clear if there is.** Handle to message is in MsgHandle.** Mode:  Entry--Full Native*		 Exit --Full Native******************************************************************CheckForMsg;using GlobalData			longa	on			longi	on						_TLStartUp				;start up the tool locator						pha						; get our user id			_MMStartup			pla			sta		UserID; get a new handle for use with; message center			pha						;make space on stack for handle address			pha									pea		|0				;request 8 bytes of memory			pea		|8			pha						; Push UserID			pea		|0				;attributes = totally unrestricted			pha						;location pointer (not used)			pha			_NewHandle			pla						; PullLong MsgHandle			plx			sta		MsgHandle			stx		MsgHandle+2			pea		|2				;getMessage			pea		|1				; type 1 (filename message)			phx						; into this handle			pha			_MessageCenter			bcc		GotMessage			jsr		DispHandle			secGotMessage	rts******************************************************************* CreateMsgNames** Using the data in MsgHandle, I fill in BPath, the pathname* of the basic program that I want to run.** Using the data at $280 I fill in BVolume, the volume to* look for BASIC.SYSTEM on.  I also put a copy of BVolume* into BSPath.** This routine also disposes of the MsgHandle when it is no* longer needed.** Mode:  Entry--Full Native*		 Exit --Full Native******************************************************************CreateMsgNames;using GlobalData			lda		[MsgHandle]			;de-reference handle			clc							; add 8 to msgptr so it points to			adc		#8					; file name			sta		MsgPtr			ldy		#2			lda		[MsgHandle],y			adc		#0					;propogate possible carry			sta		MsgPtr+2			short 						; copy pathname to BPath			lda		[MsgPtr]			; get length			tayNameLoop1	lda		[MsgPtr],y			sta		BPath,y			dey			bpl		NameLoop1			long						; back to native mode so can dispose of handle & message			pea		3					; 3 = delete message			pea		1					; 1 = filename type			pei		MsgHandle+2			; message handle is not used (for now)			pei		MsgHandle			_MessageCenter				; go delete the filename message						jsr		DispHandle			; get rid of the handle;--------------------------------------------------;; Now try and figure out what the boot volume is.;			short						; 8 bit mode to look at chars			lda		MyPath+1			cmp		#'/'			beq		PathIsFull			sec							; emulation mode for ProDOS call			xce			GetPrefix GPParams			clc							; back to native (8-bit) mode			xce			PathIsFull			ldx		#1					; start looking at first char that			lda		#'/'				; can be second slash (after increment)LookLoop			inx							; point to next character			cpx		MyPath				; at end of string?			beq		Found2ndSlash		; yes...			cmp		MyPath+1,x			; is there a slash here?			bne		LookLoop			; no, keep looking			Found2ndSlash			stx		MyPath				; store the length of the volume nameMoveVolLoop lda		MyPath,x 			; put volume name in BVolume			sta		BVolume,x			; and in BSPath			sta		BSPath,x			dex			bpl		MoveVolLoop			long						; back to full native mode			rtsGPParams			DC.B	1			DC.W	MyPath******************************************************************* DispHandle** Disposes of MsgHandle.** Mode:  Entry--Full Native*		 Exit --Full Native******************************************************************DispHandle			pei		MsgHandle+2			pei		MsgHandle			_DisposeHandle			rts			entry	proglenproglen									;this allows the assembler to calculate how big the module is			ENDP			END