		eject* "CNxx	HOST FIRMWARE"*#####################	START UP  ###########################*## These routines are the ones	first jumped into by the   ##*## dos	when it	wants the card to do something to the disk ##*############################################################		machine	M6502Host_CnXX_Code	PROC	ENTRY		WITH	zero_page_template		WITH	host_zp_template		IMPORT	iorts		IMPORT	N0_index		IMPORT	Bootcode		IMPORT	CheckRE		IMPORT	CheckGS		IMPORT	MvPCparms		IMPORT	PDparms		IMPORT	execute		IMPORT	isIIgs:data		IMPORT	SndUserTest		IMPORT	factory_sig_h:data				ENTRY	Fact_sig_copy		ENTRY	UserPatch		ENTRY	Bootptch1		ENTRY	Bootptch2		ENTRY	GOEntryCNxx		LDX	#$20		;ID marks for card		LDX	#$00		;so its	a disk device		LDY	#$03		LDA	#$00		sec		adc	#$7F		;set the overflow flag to make the next	branch always happenBootptch1	BVS	*		;'*' replaced by GoEntry offset, remember +1 for the branch addr byteUserTestEntry	php			;save interrupt state for //gs		sei		bit	$CFFF		jsr	SndUserTestDoUserTests	plp			;restore interrupts in case its a GS		tax			; so control panel and such still works?UserPatch	beq	UserPatch		jmp	$CC00		;jump into the test code that should now be therePDIentry	clc			;Prodos	called		bcc	PDIbranch	; skip the following SECPCIentry	sec			;Protocol converter called (SmartPort)PDIbranch	CLV			;PDIentry branches to here skipping the	above secBootptch2	BVC	*		;'*' replaced by GoEntry offset, remember +1 for the branch addr byteGOEntry		php			;save V,I, and C status	bits		sei			;turn off interrupts*   the	$CFFF turn off must be done with interrupts off*   since the interrupt	service	routine	might restore some*   other card's $C8xx rom space from MSLOT in interrupt restore		lda	$CFFF		;reset all other I/O Select spaces		jsr	iorts		;call my own c800 space		tsx		lda	$100,x		sta	mslot_h		;save my $Cn into the proper system byte, for interrupts		tay			; Y= $CN		LDX	N0_index-$C1,Y	;X = $N0		LDA	$C080+02,X	;select	Bank 2 in $C8..CB		jsr	CheckRE		;check for re entry during command via Interrupt;save the zero page values into	the hidden, from card, RAM at latch bank $2 		ldx	#zpgsav@zsav		lda	g_zpage-1,X		sta	zsave-1,X		dex		bne	@zsav		plp			;restore interrupts and	V and C	bits 		LDX	N0_index-$C1,Y	;X = $N0		LDA	$C080+00,X	;select	Bank 0 in $C8..CB		BVC	@10		;V bit set is boot flag		jsr	Bootcode	;if we are, then boot***>>>> NOTE: this jsr only returns if user Diagnostics are invoked		beq	DoUserTests	;ALWAYS TAKEN@10		bit	isIIgs		;is machine type known?		bpl	@20		;yep. once is enough		jsr	CheckGS		;preserves carry status		ldy	mslot_h		;restore Y with	$CN@20		equ	*		bcc	PDentry;*************************************************; PCentry;	 This routine finds the	location of the	PC parameters; and puts the base address for	them in	T1 ;;  Destorys: A,X,Y;;*************************************************PCentry		equ	*		pla			;find calling address		sta	g_DPtr		; and put it in	T0		pla			;		sta	g_DPtr+1	;		ldy	#1		;offset	to command		lda	(g_DPtr),y	;load command		sta	g_error		;  store here for awhile		iny			;move on to command list address		lda	(g_DPtr),y	;load it and		sta	g_PPtr		; store	it in g_PPtr		iny			;get high byte of address		lda	(g_DPtr),y	;		sta	g_PPtr+1	;		iny			;assume	extended SmartPort 		lda	(g_DPtr),y	; get bank byte	of command list	address		dey			;y now = 3		BIT	g_error		;extended SmartPort?		BVC	@20		;no. bank byte must = zero		ldy	#05		;Extended SmartPort stack offset 		BIT	isIIgs		;extended SmartPort in IIgs?		BVS	@30		;yes. use the bank byte	 @20		LDA	#00		;force a zero@30		sta	g_PPtr+2	;  and put it in bank byte of g_PPtr		tya			;get stack adjust 		clc			;add to	return address that		adc	g_DPtr		; was taken off	of stack		tax			; and put it back on stack		lda	#0		;		adc	g_DPtr+1	;		pha			;		txa		pha			;adjust	rtn adrs before	I step on it		JSR	MvPCparms	;move parms to zero page		lda	g_cmdnum	;get command again		and	#$BF		;get rid of extended bit		cmp	#SPCnt		;see if	it's a legal command		bcc	docmdcn_cmderr	lda	#badcmd		bne	g_aexitcn_unterr	lda	#badunit		bne	g_aexit;********************************************************; PDentry:;	 This routine looks at the prodos command and calls; the appropriate routine for handling it.;;	 in: command <-	zero page location where prodos	command	resides.;;    destorys: all;;*******************************************************PDentry		equ	*		lda	command		;get prodos command		cmp	#PDCnt		;see if	command	is legal		bcs	cn_cmderr	;otherwise, indicate bad command		jsr	PDparms		;Convert ProDOS	parms to SP		LDA	g_cmdnum		CLC		ADC	#SPCnt+$80	;shift set b7 out as carry* Now fall into	do the command*  |		|	    |*  v		v	    v****************************************************   INPUT : A =	dispatch #  0..SPCnt+3*		SmartPort = 00..SPcnt-1*	       XSmartPort = 00..SPcnt-1*	    ProDOS BlkDev = SPCnt..SPCnt+3**************************************************docmd		equ	*		jsr	execute		;A-reg = command number*********************************************************************g_exit		EQU	*		lda	g_error		;get error result from zpageg_aexit		equ	*		pha		lda	xrtn		pha		lda	yrtn		pha		ldy	mslot_h		;get $Cn		LDX	N0_index-$C1,Y	;X = $N0		LDA	$C080+02,X	;select	Bank 2 in $C8..CB		ldx	#00@10		ldy	zsave,X		;get saved zero	page byte		sty	g_zpage,X	;put original zpage back		inx		cpx	#zpgsav		blt	@10		lda	#00		sta	reEntryFlag	;reentry now legal again* setup	register results for caller		pla		tay		pla		tax		pla		cmp	#01		;set carry if any error		ora	#00		;set z & n as needed		rts*********************************************************************************************************************************************Fact_sig_copy	ldy	#15@lp		lda	$C100,y		bit	$CFFF		sta	factory_sig_h,y		dey		bpl	@lp		rts*************************************************** ProDOS Block Device and Protocol Converter*    Interface signature & info	bytes**************************************************endNspc		EQU	*		DCB.B	256-5-(endNspc-Host_CnXX_Code),$00 ;fill almost	to end of the page		DC.B	SmartSig	;$CnFB,	smartport type is Xtended + additionals		DC.W	$0000		;use status call to get	block size		DC.B	%10111111	;ProDOS	Block Device signature (type)			;||||||||___bit 0 device's status can be read (must be on)			;|||||||____bit 1 device can be read from (must be on)			;||||||_____bit 2 device can be written to			;|||||______bit 3 device supports formatting			;||\|_______bit 5-4 number of volumes on the device (0-3),2 for us			;||_________bit 6 device is interruptable			;|__________bit 7 Medium is removable		DC.B	PDIentry-Host_CnXX_Code	;offset	of PDIentry in CNxx firmwareCnXX_length	EQU	*-Host_CnXX_Code ;generate the length of this proc		if	(CnXX_length	<> 256)	then		aerror	'!!! Host_CnXX_Code segment is not equal to 256 bytes !!!'		endif		ENDPHost_ROM_code	PROC	ENTRY,TEMPORG	Host_CA00_code_start ;host $C800 'ROM' space 		WITH	zero_page_template		WITH	host_zp_template		ENTRY	iorts		ENTRY	N0_index		ENTRY	Bootcode		ENTRY	CheckGS		ENTRY	MvPCparms		ENTRY	PDparms		ENTRY	execute		ENTRY	isIIgs		ENTRY	SndUserTest		ENTRY	CheckRE* $C8..$CB code	must NOT switch	banks since it resides only in RAM bank 0 ;Page2tablesCARomAdrs	equ	*;******************************************; CheckGS;	 This routine attempts to determine; whether or not the machine is	a //GS.;;	 in: none;	 out: isIIgs = $40 if is a IIgs;	      isIIgs = 0 if not	a IIgs;    Destorys: A,X;   Preserves: Carry status;;****************************************CheckGS		php		sei		lda	StateReg	;save state register in	case it	is		pha		ldx	#10@chkstate	eor	#$0E		;toggle	bits		sta	StateReg	; and try to save them		cmp	StateReg	;see if	they were saved		bne	@nostate	;if not, this can't be a GS		dex		bne	@chkstate	;check 10 times		pla			;restore state register		sta	StateReg	;		lda	IDByte1		;is it GS or Enhanced //e		cmp	#$06		;		bne	@notGS		;if not, then not a GS		lda	IDByte2		;try another ID	byte		cmp	#$E0		;		bne	@notGS		;		sec			;call machine ID routine		jsr	MachineID	;		bcs	@notGS		;it was	an Enhanced //e			lda	#$7F		;indicate a IIgs		bne	@setflag@noState	pla@notGS		lda	#$7E@setflag	bit	h_msg		bpl	@setflag	;wait for card to be ready for cmds		sta	h_msg		;tell card CPU to set the isIIgs flag for me@waitforclr	bit	h_msg		;wait for acknowledge from card		bpl	@waitforclr		plp			; restore carry	status		rts************************************ Move SmartPort Parameters to * zero page**********************************MvPCParms	bit	g_error		;extended SmartPort?		bvs	@50		;yes.* Now do split block move of Std SP parms to zero page		ldy	#08		;no. Std SmartPort@10		tax			;save prior store 		lda	(g_PPtr),Y		dey		bmi	@40		cpy	#4-1		;y is now 1 less than lda index		bcc	@20		sta	g_DPtr+2+1,Y	;parm(8,7,6,5,4) -> zpage(10,9..6)		bcs	@10		;ALWAYS	TAKEN@20		sta	g_DPtr+1,Y	;parm(3,2,1) ->	zpage(3,2,1)		bcc	@10		;ALWAYS	TAKEN@40		iny			;y now = 0		sty	g_DPtr+1+3	;zero 3rd Ptr byte for 816		sty	g_DPtr+11	;zero 4th adrs byte		beq	@90		;ALWAYS	TAKEN. all done* Now copy Extended SmartPort Parms (11..1)@50		ldy	#11@55		TAX			;save prior store		bit	isIIgs		;do I have an 816?		bvs	@70		;yes do	LDA [g_PPtr]@60		lda	(g_PPtr),Y	;no. Extended SP in IIe/II+		bvc	@75@70		DC.B	$B7		; LDA [g_PPtr],Y		DC.B	g_PPtr@75		dey		bmi	@90		sta	g_DPtr+1,Y		bpl	@55		;always	taken* Now A-reg = ParmCount	& X-reg	= unitnum* and g_error =	cmdnum@90		ldy	g_error		;get g_cmdnum 		sta	g_error		;save the parm count		lda	g_DPtr+2		sta	g_DPtr		lda	g_DPtr+3		sta	g_DPtr+1		lda	g_DPtr+4		sta	g_DPtr+2		stx	g_unitnum		sty	g_cmdnum		rts* "Command Dispatch Tables*********************************************** Protocol Converter & ProDOS Block Device*	  Command Address Tables**********************************************cmdadrL		EQU	*		DC.B	PCStatus-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	ReadBlk-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	WriteBLk-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	FormatVol-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	PCCtrl-Host_ROM_code-1+Host_CA00_code_start and	$FF		DC.B	PCInit-Host_ROM_code-1+Host_CA00_code_start and	$FF		DC.B	Open-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	Close-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	ReadBytes-Host_ROM_code-1+Host_CA00_code_start and $FF ;read bytes		DC.B	WriteBytes-Host_ROM_code-1+Host_CA00_code_start	and $FF	;write bytes		DC.B	SetFmtOpt-Host_ROM_code-1+Host_CA00_code_start and $FF ;set format option		DC.B	GetFmtOpt-Host_ROM_code-1+Host_CA00_code_start and $FF ;get format option		DC.B	PDstatus-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	ReadBlk-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	WriteBlk-Host_ROM_code-1+Host_CA00_code_start and $FF		DC.B	FormatVol-Host_ROM_code-1+Host_CA00_code_start and $FFcmdadrH		EQU	*		DC.B	((PCStatus-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((ReadBlk-Host_ROM_code-1+Host_CA00_code_start)	È 8)		DC.B	((WriteBLk-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((FormatVol-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((PCCtrl-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((PCInit-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((Open-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((Close-1-Host_ROM_code-1+Host_CA00_code_start)	È 8)		DC.B	((ReadBytes-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((WriteBytes-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((SetFmtOpt-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((GetFmtOpt-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((PDstatus-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((ReadBlk-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((WriteBlk-1-Host_ROM_code-1+Host_CA00_code_start) È 8)		DC.B	((FormatVol-1-Host_ROM_code-1+Host_CA00_code_start) È 8)parmtbl		equ	*		DC.B	$03,$03,$03,$01		DC.B	$03,$01,$01,$01		DC.B	$04,$04,$03,$03		DC.B	$FF,$FF,$FF,$FF* SBTL "PR#n BOOT ROUTINE"****************************************************** BOOT ROUTINE*****************************************************Bootcode	stx	g_devndx	;must be setup for WtRdData		jsr	CheckGS		;set isIIgs flag		lda	#0		sta	$4E		;zero the timeout counter		sta	$4F				ldx	#03		;need 3 Control-D's 		stx	$3C		ldy	$FBB3		;do cpu have AKD flag? (= $06 if any IIe/IIgs)		cpy	#$06		beq	@03* for a II+ just check the key latch		lda	$C000		;is there a Control-D at beginning		ora	#$80		;since monitor clears the keystrobe before boot'n me		bmi	@gotakey	;ALWAYS TAKEN* any cpu with ADK flag must have some key down to qualify for these checks@03		bit 	$C010		;any key down? two plus doesn't have this flag!		bpl	@09		;no		bmi	@waitautorep@05		sta	$C010		;clear the a Control-D keypress@waitautorep	lda	$c000		bmi	@gotakey			cpy	#06		bne	@07		bit	$C010		bpl	@09		;any-key-down went up! so forget this noise@07		inc	$4E		bne	@waitautorep		inc	$4F		bne	@waitautorep		dec	$3C		bne	@waitautorep		beq	@09		;didnt find enought Control-D's to do it@gotakey	cmp	#$84		;is it a Control-D?		bne	@09		;nope. so forget it		dex		bne	@05		;yep. have I found enough of em yet?* NOW I have seen enough Control-D's to invoke userTest diagnostics		php		sei		;interrupts now disabled		pla		tay		;save pre SEI interrupt state in Y		pla		sta	$4e	;get rtn low off		pla		sta	$4f	;get rtn hi off		tya		pha		;put P on behind rtn adrs (only use N6502 opcodes!!)		lda	$4f		pha		lda	$4e		pha		jmp	SndUserTest	;which will return to CNxx and branch		@09		ldx	#03		;wait 3	s in //e; 1 sec	in //gs@10		lda	h_msg		bmi	@20		;no waiting to boot: card ready		inc	$4E		bne	@10		;(14 cyc * 256		inc	$4F		;+4		bne	@10		;+7) * 256 = 919xxx cycles		DEX			;* 3 = about 3 secs in //e: 1 in IIgs 		bne	@10		;'card never came ready' boot failure		lda	#$30		;device	didn't respond		sta	g_error		bne	@30********************************@20		lda	#$FF		sta	h_reply		;insure	handshake starts ok		lda	#00		sta	h_parms+1	;set unit 0 for	boot		lda	#$81		sta	g_cmdnum	;look like a read cmd		lda	#ldblk0		;try to	get blk	0000 from boot device		sta	h_msg		;if we got it, try to run it		lda	#8		;set up	read buffer		sta	g_DPtr+1	;		lda	#0		;		sta	g_DPtr		;		sta	g_DPtr+2	;incase	I am in	a IIgs		jsr	WtRdData	; wait for Read	Data		ldx	g_devndx	;get $N0 into x for bootstrap block code		cmp	#01		;any error?		bcs	@30		;if block was good, use	it*********************************************************************** This routine makes zero page look like a ProDOS Block Device Protocol* Read of drive zero into $800 for block zero** A compatability fix for third party hack version of DOS 3.3**********************************************************************		lda	#01		sta	command		stx	unitnum		lda	#$08		sta	buffaddr+1		lda 	#00		sta	buffaddr		sta	dskblk		sta	dskblk+1**********************************************************************		lda	$800		;do some additional checks on the block		cmp	#01		;see if	first byte is a	1		bne	@30		;if not, can't boot		lda	$801		beq	@30		;it can't be a break opcode!		lda	#00		bit	isIIgs		bvc	@25		;leave IIgs register alone		sta	Shadow@25		jmp	$801		;with $N0 in X@30		equ	*		stx	g_devndx		jmp	BootFail******************************************************* ReMapErr**  This	routine	remaps errors from slave firmware*  into	those acceptable to the	calling	protocol**  INPUT A = error code	to map*	 cmdmode_b7b6 =	$8x=ProDOS,$4x=ExtSP,$0x=SP*  OUTPUT A = new error	code* * ProDOS only wants to see* $27 IOerror* $28 NoDrive* $2B NoWrite* $2F Offline* All other hard errors	are mapped to IOerror******************************************ReMapErr	equ	*		bit	g_cmdnum	;is it ProDOS call?		bpl	@90		;no.	leave em alone for SP calls		cmp	#00		beq	@90		;no error to fix		cmp	#NoWrite	;is it musketeer # 1?		beq	@90		cmp	#NoDrive	;#2 perhaps?		beq	@90		cmp	#Offline	;mabye its #3??		beq	@90		cmp	#BadUnit		bne	@10		lda	#NoDrive		rts@10		lda	#IOerror	;remap all (Gross me completely	out)@90		rts*********************************************************************************************************************************************FixPDStsErr	cpy	#%10000		;is it Online and Not Write Protected?		beq	@20		;yes. error already is zero		lda	#$2B		cpy	#%10100		;is it online and WP?		beq	@10		;yes. return WP error		lda	#$2F		;else return offline error@10		sta	h_error		;change the a-reg returned to user@20		rts********************************************* fill up to end of $CB	page* so Execute is	justified to end of page********************************************		DCB.B	Host_CC00_code_start-Host_CA00_code_start-$2C-(*-Host_ROM_code),$00 ;EProm fill	pleasepar_err		lda	#badPCnt		sta	g_error		rts******************************************** Command Dispatcher* *   INPUT : A-reg = command # (0..14)*	    Y-reg = $CN*	    X-reg = $N0+$88*******************************************execute				ldy	mslot_h		;Y = $CN		ldx	N0_index-$C1,Y	;X=$N0		stx	g_devndx	;save device index		tax			;cmd index to X		lda	parmtbl,X	;need to check parm cnt?		bmi	@10		;no		cmp	g_error		;does it match saved parm_cnt?		bne	par_err@10		lda	cmdadrh,X		pha		lda	cmdadrl,X		pha		LDA	#00		STA	g_error		STA	yrtn		STA	xrtn		ldx	g_devndx		jsr	Notifier	;call the GS/OS notifier "user" routines* Now fall across the boundary to non bank switched* firmware to do a bank	switch		if	((*-Host_ROM_code) <> Host_CC00_code_start-Host_CA00_code_start) THEN 		aerror	'!! ERROR - Host $CC00 code is not positioned correctly !!'		endif		lda	$C080+00,X	;switch	in bank 0. NEXT instr opcode must be at $CC00!@wait		lda	h_msg		;is card CPU ready for cmd?		bpl	@wait		;no. wait till it isIORTS		rts			;go execute commandisIIgs		dc.b	$80		;this is changed to $40 for IIgs and $00 otherwise* 'ProDOS/SmartPort Routines'  ;**************************************************; Formatvol ;	 This routine sends the	format command and the;	 unit number to	the card  stalls until cmd done;*************************************************Formatvol	equ	*Open		equ	*		;send it thru in case Remote unitClose		equ	*		;send it thru in case remote unit		jsr	SndCmd		;and send cmd to card		CLC			;wait for error	code return		jmp	retrn;***************************************************; PDstatus;	 This routine sends the	status command and the; unit number to the 65c02 card	and then waits for a reply.;;	 out: A	<- status;	      X <- length of status data (low);	      Y <- length of status data (hi);;****************************************************PDstatus	equ	*		lda	#00		;do a PC status	code zero call		sta	g_code		;can't use stz cuz its C02		jsr	SndCmd		; and send it to the card@wait1		lda	h_reply		;load the reply		bmi	@wait1		;if isn't in yet, wait		beq	@90		;invalid reply so exit (no wait)		jsr	GetCDAdr	;get address of	status result		ldy	#2		;offset	to byte count		lda	(g_PPtr),y	;get byte count hi		sta	yrtn		dey		lda	(g_PPtr),Y	;get byte count lo		sta	xrtn		dey		lda	(g_PPtr),Y	;get status byte		and	#%10100		;preserve Online and WP bits only		tay		ldx	g_devndx		lda	$C080+00,x	;switch in Bank zero		jsr	FixPDStsErr	;Y = status [$10 / $14 / $0X]@90		jmp	return		;no wait exit;****************************************************; PCStatus ;;	 This routines ask card	for a status report;	 and move the resulting	data to	users buffer;**************************************************PCStatus	equ	*ReadBytes	equ	*GetFmtOpt	equ	*		lda	g_xfrcnt		sta	h_xfrcnt		lda	g_xfrcnt+1		sta	h_xfrcnt+1		JSR	SndCmd		;send command@10		lda	h_reply		;load reply		bmi	@10		;if negative, then no reply at all		beq	@90		;zero means error in parms		ldx	h_xfrcnt		stx	xrtn		;return	the length in x,y		ldx	h_xfrcnt+1		stx	yrtn		jsr	GetCdAdr	;switch	bank, and put addr   ;			  $C800/CA00 of	ram block in g_PPtr		ldx	yrtn		;any full pages	to move?		beq	@30		;nope.		sec			;move x	pages		jsr	ReadXBP@30		ldx	xrtn		;any bytes left	to move?		beq	@90		;no.		clc		jsr	ReadXBP		;move x	bytes@90		jmp	return		;no wait return************************************************* MoveXBP*  INPUT : X = byte or page count*	   C = 1 for page move*	   C = 0 for byte move** No instruction in the	loop may change	the Carry!************************************************ReadXBP		EQU	*		ldy	#00@30		lda	(g_PPtr),Y	;get data from card ram		bit	isIIgs		;is 816	available		bvc	@40		;no. do	6502 sta		DC.B	$97		; sta [g_DPtr],Y		DC.B	g_DPtr		bvs	@50		;(can't use bra)@40		equ	*		sta	(g_DPtr),y	;and store it in callers buffer@50		iny			;increment pointer to next byte		bcc	@60		;C=1 means pages C=0 means bytes		bne	@30		;loop until page done		inc	g_PPtr+1	;move src ptr up a page		inc	g_DPtr+1	;move Dst ptr up a page		bne	@60		;		inc	g_DPtr+2	;move Dst ptr up a bank	IFF@60		dex			;decrement buffer size counter		bne	@30		;if buffer no empty, get some more		rts************************************************* PCWriteBytes************************************************WriteBytes	equ	** parameters have the length for slave to check		lda	g_xfrcnt		sta	h_xfrcnt		pha			;push low 1st		lda	g_xfrcnt+1		sta	h_xfrcnt+1		pha			;push hi 2nd (pull 1st)		jmp	WaitXYWrit************************************************* PCCtrl************************************************PCCtrl		equ	** Now extract the length from CTRL data	list		ldy	#00		bit	isIIgs@15		bvc	@20		DC.B	$B7		;lda [g_DPtr],Y	;get length		DC.B	g_DPtr		bvs	@25@20		lda	(g_DPtr),Y@25		sta	h_xfrcnt,y	;tell slave how	much		pha			;save on stack		iny		cpy	#01		;low 1st Then hi		beq	@15		;branch	once		lda	g_Dptr		clc		adc	#02		sta	g_Dptr		bcc	@30		inc	g_Dptr+1		bne	@30		inc	g_Dptr+2@30		equ	*		;fall into WaitXYWrit****************************************************** WaitXYWrit *****************************************************WaitXYWrit	equ	*		Jsr	SndCmd		;send the CTRL/WriteBytes cmd over@10		lda	h_reply		;load reply		bmi	@10		;if negative, then no reply at all		beq	@95		;bad cmd/parms so clr stack & exit		jsr	GetCdAdr	;switch	bank, and put addr   ;			  $C800/CA00 of	ram block in g_PPtr		pla			;(pull hi 1st) any full	pages to move?		tax			;can't use plx cuz its C02 opcode		beq	@30		;nope.		sec			;move x	pages		jsr	WritXBP@30		pla			;(pull lo 2nd) any bytes left to move?		tax			;can't use plx cuz its C02 opcode		beq	@90		;no.		clc		jsr	WritXBP		;move x	bytes@90		clc		jmp	retrn		;wait for error	code @95		pla		pla			;clear lgth from stack		jmp	Return		;no wait. error	code already stored************************************************* WritXBP*  INPUT : X = byte or page count*	   C = 1 for page move*	   C = 0 for byte move** No instruction in the	loop may change	the Carry!************************************************WritXBP		EQU	*		ldy	#00@30		bit	isIIgs		;is 816	available		bvc	@40		;no. do	6502 lda		DC.B	$B7		; lda [g_DPtr],Y		DC.B	g_DPtr		bvs	@50		;(can't use bra cus of II+'s)@40		lda	(g_DPtr),Y	;get C02 data@50		sta	(g_PPtr),y	;and store it in slave ram		iny			;increment pointer to next byte		bcc	@60		;C=1 means pages C=0 means bytes		bne	@30		;loop until page done		inc	g_PPtr+1	;move dst ptr up a page		inc	g_DPtr+1	;move src ptr up a page		bne	@60		;		inc	g_DPtr+2	;move src ptr up a bank	IFF@60		dex			;decrement buffer size counter		bne	@30		;if buffer no empty, get some more		rts***********************************************************************	SetFmtOptions**	INPUT	:g_DPtr points to one or two words**********************************************************************SetFmtOpt	equ	** Now extract the length from CTRL data	list		lda	#00		ldx	g_XfrCnt	;sets the Z flag for beq below!		sta	g_Code		sta	g_Code+1		sta	g_Code+2		sta	g_Code+3	;tell slave to select the defaults		beq	@90		;no parameters given so send all zeros		cpx	#05		bcc	@10		ldx	#04		;transfer max of 4 bytes@10		ldy	#00@15		bit	isIIgs		bvc	@20		DC.B	$B7		;lda [g_DPtr],y		DC.B	g_DPtr		bvs	@25@20		lda	(g_DPtr),y@25		sta	g_Code,y		iny		dex		bne	@15@90*		FALL THRU to SndCmd to slave*		|	|*		v	v************************************************* PCInit************************************************PCInit		equ	*		Jsr	SndCmd		;send the INIT/SetFmtOpt cmd to card		clc		jmp	retrn		;and wait for error code* "HOST	SERVICE	& SUPPORT ROUTINES"     ;***************************************************; GetCdAdr;;	 This routine selects the input	Card RAM buffer; into the host	$C8xx..$CBFF window and ; creates the address for the buffer ($C800/$CA00) in g_PPtr;;   INPUT :  A <- ram buffer number (0..31) ;; Destorys:  X,	Y regs;;  OUTPUT :  RAM buffer	selected and pointer in	g_PPtr;	     g_PPtr <- addr of ram buffer in window;;***************************************************GetCdAdr	equ	*		and	#$1F		;insure that address in in range for my slot		lsr	a		;drop buffer in	bank bit (0..$1F in A)		php			;save buffer posn bit		clc		adc	g_devndx		tax		LDA	$C080,X		;select	bank without false read		lda	#$00		;clear other bytes of address		sta	g_PPtr+0	;		plp			;recover lsbit		rol	a		;shift carry into b0		asl	a		;make it 0 or 2	(also does CLC)		adc	#$C8		;result	is $C8 or $CA		sta	g_PPtr+1	;save page adrs	of buffer		rts;************************************************; Read a block for ProDOS/SmartPort/XSmartPort;;*************************************************ReadBlk		equ	*		jsr	SndCmd		; send g_cmdnum,g_dskblk,g_unitnum;**************************************************; WtRdData:;	 This routine waits for	a h_reply from the card.;  The reply indicates which ram block the requested data;  has been put	into.  This routine calculates where that;  ram block is, and then move the data	from that block	into;  the dos buffer.;;	 in:  g_DPtr <-	address	of dos buffer;;	 eats: A,X,Y;;**************************************************WtRdData	equ	*@wait		lda	h_reply		;see if	65c02 card has replied		bmi	@wait		;if not, keep waiting		bne	@05		;no wait error in cmd/parms		lda	h_error		jmp	@90		;		@05		jsr	GetCdAdr	;use block number to move us into the;			  correct bank with g_PPtr = addr of blk		ldx	#2		;number	of pages to load		ldy	#0		;offset	into page of buffers		BIT	isIIgs		;see if	this is	a IIgs		bvs	@IIgsLoop	;if is,	do 65816 fast stuff@shrtmove	lda	(g_PPtr),y	;get next byte from card ram		sta	(g_DPtr),y	; and store it into prodos buffer		iny			;increment offset		bne	@shrtmove	;if not	on a page boundary, continue		inc	g_PPtr+1	;move to next page		inc	g_DPtr+1	;		dex			;decrement page	counter		bne	@shrtmove	;if another page, load it in@90		sec		jmp	rtn512		;go finish up before returning				machine M65816		longa	off		longi	off@IIgsLoop:				clc					xce			;switch to native		php			;save emulation state		lda	cyareg		pha		ora	#$80		sta	cyareg		;switch to fast speed		lda	#$02		bit	g_PPtr+1	;is it $C8 bufr or $CA bufr		rep	#$20	longa	on			;16 bit accum Mode		bne	@doCAbufr	; it the upper half		@10		lda	$C800,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					lda	$C800,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					bne	@10		;if not	on page	boundary, continue		inc	g_DPtr+1	;increment high	2 bytes of g_DPtr@20		lda	$C900,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					lda	$C900,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					bne	@20		;if not	on page	boundary, continue		beq	@done		;can't use BRA cuz its C02@doCAbufr:@30		lda	$CA00,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					lda	$CA00,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					bne	@30		;if not	on page	boundary, continue		inc	g_DPtr+1	;increment high	2 bytes of g_DPtr@40		lda	$CB00,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					lda	$CB00,y		;get data from card		sta	[g_DPtr],y	; and put it in	the GS buffer		iny					iny					bne	@40		;if not	on page	boundary, continue		@done		sep	#$30	longa	off		pla		sta	cyareg		;switch speed back		plp		xce			;restore emulation mode		machine M6502		sec			;no wait return		jmp	rtn512;***************************************************; Write	Block for ProDOS/SmartPort/XSmartPort;***************************************************WriteBlk	equ	*		jsr	SndCmd		; pass g_cmdnum,g_dskblk,g_unitnum;*******************************************************;  LdWrBlk;	 This routine claims the oldest	ram block and then; moves	the data to be written to the disk from	the dos	buffer; into this ram	block.;    **	this routine must reside in every bank	**;;	 in: g_DPtr <- dos buffer address;;	 out: ramblk <-	ram block number of data to be written;;	 eats: A,X,Y;;*******************************************************@10		ldx	h_reply		;wait til card gives us	the ram	block #		bmi	@10		;if FF,	then it	hasn't been sent yet		bne	@15		jmp	return		;cmd/parms error!@15		lda	h_syncflag	;time to sync?		php		bpl	@20		sei			;turn off interrupts if syncronous WritePrep by slave		lda	#$C0		sta	h_syncflag	;interrupts are now off so delay and go@20		txa		jsr	GetCdAdr	;switch	bank and setup addr of ram blk				ldy	#0		;offset	to position in buffers		BIT	isIIgs		;see if	we're a IIgs		bvs	lwIIgs		;if we are, then do 65816 block	move		plp			;restore interrups now for IIe case		ldx	#2		;number	of pages to load@shrtmove	lda	(g_DPtr),y	;get byte from prodos buffer		sta	(g_PPtr),y	; and put it in	card ram		iny			;increment offset		bne	@shrtmove	;if not	at a page boundary, continue		inc	g_DPtr+1	;move to next page (4 byte problem?)		inc	g_PPtr+1	; in both buffers		dex			;decrement page	counter		bne	@shrtmove	;if another page, do it	up		jmp	Wrtn512		;finish	up (no bra allowed)lwIIgs:		machine	M65816		longa	off		longi	off				clc					xce			;switch to native		php			;save emulation state		lda	cyareg		pha		ora	#$80		sta	cyareg		;switch to fast speed		phx			;save buffer's bank on stack		lda	#$02		bit	g_PPtr+1	;is it $C8 bufr or $CA bufr		rep	#$20		longa	on		;16 bit accum		bne	@doCAbufr	; it the upper half		@10		lda	[g_DPtr],y	;		sta	$C800,y		;  and put it in card buffer		iny		iny			;increment offset 		lda	[g_DPtr],y	;		sta	$C800,y		;  and put it in card buffer		iny		iny			;increment offset		bne	@10		;if not	on page	boundary, continue		inc	g_DPtr+1	;increment high	2 bytes of g_DPtr				sep	#$20		longa	off		ldx	g_devndx		lda	$C080+0,x	;switch back to bank zero		inc	h_syncflag		plx			;816 has this opcode		lda	$C080+0,x	;switch back to buffer's bank		rep	#$20		longa	on@20		lda	[g_DPtr],y		sta	$C900,y		iny		iny		lda	[g_DPtr],y		sta	$C900,y		iny		iny		bne	@20		beq	@done		;NO BRA's allowed cuz its C02@doCAbufr:@30		lda	[g_DPtr],y	;		sta	$CA00,y		;  and put it in card buffer		iny		iny			;increment offset 		lda	[g_DPtr],y	;		sta	$CA00,y		;  and put it in card buffer		iny		iny			;increment offset		bne	@30		;if not	on page	boundary, continue		inc	g_DPtr+1	;increment high	2 bytes of g_DPtr				sep	#$20		longa	off		ldx	g_devndx		lda	$C080+0,x	;switch back to bank zero		inc	h_syncflag	;tell host 1st half is done		plx			;816 has this opcode		lda	$C080+0,x	;switch back to buffer's bank		rep	#$20		longa	on@40		lda	[g_DPtr],y		sta	$CB00,y		iny		iny 		lda	[g_DPtr],y		sta	$CB00,y		iny		iny		bne	@40@done		sep	#$30		longa	off		pla		sta	cyareg		;switch speed back		plp		xce			;restore emulation mode		ldx	g_devndx		lda	$C080+00,X	;switch back to bank zero		lda	#$D0		sta	h_syncflag	;tell CPU 2nd 256 bytes are done		plp		;restore interrupts if syncrounous WritePrep was going				machine	M6502***********************************WRtn512		equ	*		CLC			;wait for complete b4 returning***********************************rtn512		equ	*		lda	#>512		sta	yrtn		;hi byte of xfer size		bne	retrn		;always	taken;*************************************************; return:;	 This routine is the last thing	executed before; returning control to dos.  It	checks to see if there has; been an error	lately on the card.  **	note **	 If a large; number of writes are being done, there is no way to know which; one generated	the error.;;*************************************************return		equ	*		SEC			;no wait returnretrn		equ	*		ldx	g_devndx		lda	$C080+00,X		lda	h_reply		ora	#$F0		;host side is done (sav	reply)		sta	h_reply		BCS	@20		;if Set	don't stall after reads@wait		lda	h_msg		bpl	@wait		;stall until cmd done@20		equ	*		if	trace		THEN		lda	#'r'		jsr	TraceChr		lda	h_dbug		jsr	TraceHex		endif		lda	h_error		;check error message semaphore		if	trace		THEN		lda	#':'		jsr	TraceChr		lda	h_dbug		jsr	TraceHex		lda	#$8D		jsr	TraceChr		lda	h_dbug		endif		jsr	ReMapErr	;map errors IFF		sta	g_error		ldx	#0		;clear error for next time		stx	h_error		;		rts;************************************************; SndCmd:;	 This is the general purpose command routine;	 that sends a command to the slave processor  ;	 after passing the parameters from g_xxxxxx  ;    INPUT : g_cmdnum ... g_adrs ;	   : X = devndx	 ($n0);;  Destorys : A;; Preserves : X,Y;;************************************************SndCmd		equ	*@wait		lda	h_msg		;is prior cmd finished?		bpl	@wait		;no. wait until	it is		lda	#$FF		sta	h_reply		;force this off		txa		pha		;Can't use PHX cuz its C02 		ldx	#9-1		;pass 9	bytes to UC/IC@10		lda	g_cmdnum,x		sta	h_parms,x		dex		bpl	@10	if trace	THEN		lda	#'c'		jsr	traceChr		lda	#'='		jsr	traceChr		lda	h_parms+0		jsr	traceHex		lda	#$20		jsr	traceChr		lda	h_parms+1		jsr	traceHex		lda	#$20		jsr	TraceChr	;make it 8 char	sequence		lda	#'$'		jsr	TraceChr		bit	h_parms+0		bvc	@991		lda	h_parms+5		jsr	TraceHex@991		equ	*		lda	h_parms+4		jsr	TraceHex		lda	h_parms+3		jsr	tracehex	endif		pla		tax			;Can't use PLX cuz its C02		lda	h_parms+0	;get g_cmdnum back		and	#$1F		;make it 0..B		sta	h_msg		;send command last		rts***************************************** convert $CN into $N0+$88****************************************N0_index	DC.B	$10,$20,$30,$40		DC.B	$50,$60,$70***************************************** PDparms** COnvert ProDOS block device Protocol* parameter into standard SmartPort * ****************************************PDparms		ORA	#$80		;looks like SmartPort with $80 bit on		LDX	unitnum		;get unitnum before sta	g_cmdnum		STA	g_cmdnum	;save it for now		LDA	buffaddr		STA	g_DPtr		LDA	buffaddr+1		STA	g_DPtr+1		IF	((g_zpage-$40)	<> 0) THEN ;only needed	if moved for debug		lda	dskblk		sta	g_dskblk		lda	dskblk+1		sta	g_dskblk+1		endif		LDA	#00		sta	g_Dptr+2		sta	g_dskblk+2		sta	g_dskblk+3*************************************** Convert ProDOS BlkDev	Protocol* Drv+Slot into	a SmartPort Unit #**   INPUT : X-reg = Drv+Slot*	    Y-reg = $CN	= slot # of card*   OUTPUT: A-reg = S.P. Unit#*	    X-reg = unchanged*	    Y-reg = unchanged*	    g_unitnum =	S.P. Unit #** FUNCTION : if	card in	slot 4,5,6,7 *	     Then unit # =(~b6*2+b7)+1*	     if	card in	slot 1,2,3 *	     Then unit # =(b6*2+b7)+1**************************************		txa			; dsss xxxx 		and	#$70		beq	@30		;unit 0	if slot	0		lsr	a		lsr	a		lsr	a		lsr	a		ora	#$C0		sta	g_unitnum	;req slot = $CN 		lda	#00		cpy	g_unitnum	;is req	for my slot?		beq	@20		;yes (units 1,2)		lda	#$C0		eor	g_unitnum		cmp	#02		;'other' req for slot 2?		beq	@20		;yes. return unit 3,4		lda	#04		;'other' req for not slot 2 =5,6@20		cpx	#$80		;factor	in drive		ADC	#01		;return	unit # 1,2,3,4@30		STA	g_unitnum	;set unit number		RTS*********************************************************************** SndUserTest**********************************************************************SndUserTest:		tsx		lda	$102,x		sta	mslot_h		tay		ldx	N0_index-$C1,y		lda	$C080,x		;switch in bank zero of card's RAM@waitready	bit	h_msg		bpl	@waitready		lda	#usertestcmd		sta	h_msg		;tell host to do the diagnostics		lda	#00		rts********************************************* Boot Failure exit routine* resets the host state	and* issues an error message* to be	polite to the user*******************************************bootfail	equ	*		bit	$C082		;switch	in the ROM for sure		lda	loc0		;see if	card called by Monitor autoscan		bne	@noauto		lda	loc1		;		cmp	mslot_h		;		bne	@noauto		;		jmp	autoscan	;if so,	jump back in@noauto		jsr	setvid_h	;		jsr	setkbd_h	;		jsr	text_h		;		jsr	home_h		;		ldy	#bfstr1-bfstr1		lda	g_error		;never ready msg?		cmp	#$30		bne	@20		;no.		ldy	#bfstr2-bfstr1	;yes.@20		ldx	#0@25		lda	bfstr1,Y		beq	@30		sta	$488,X		;on 2nd	line of	screen		iny		inx		bne	@25@30				jmp	Basic		;restore for beta		msb	onbfstr1		DC.B	'UNABLE TO BOOT'		DC.B	0bfstr2		DC.B	'CONTROLLER NEVER READY'		DC.B	0		msb	off***********************************************************************	Firmware "access" detector logic for GS/OS driver to use**********************************************************************Notifier	lda	g_unitnum		beq	@notZero		cmp	#maxUnits+1		bcs	@notZero	;only notify if unitnum = 1..4		tya		pha		txa		pha		lda	$C080+2,x	;switch in Bank2 of RAM ($800-$BFF of slave RAM)		jsr	Caller		pla		tax		lda	$C080+0,x	;switch Bank0 back in for execute		pla		tay			;restore Y@notZero	rtsCaller		lda	#$CB		;high address byte of "user" routines		pha		ldx	g_unitnum		lda	CBentry-1,x		pha		rts			;dispatch to "user" routine notify routine		CBentry		dc.b	$80-1		;=$CB80 for unit #1		dc.b	$A0-1		;=$CBA0		dc.b	$C0-1		;=$CBC0		dc.b	$E0-1		;=$CBE0 for unit #4*********************************************************************** Check the re Entry Flag to prevent reentrant call to my firmware* * Assumes RAM bank 02 has been selected before calling ** Assumes isIIgs is reset to "unknown" on every reset Warm/Cold** Must preserve Y reg **********************************************************************CheckRE:		bvs	@boot		;reset flag on a boot entry		bit	isIIgs		;has flag been cleared since RESET?		bpl	@10		;yep@boot		lda	#00		sta	reEntryFlag	;	1st call after reset!		rts@10		bit	reEntryFlag		bmi	@NOTREENTRANT		lda	#$80		sta	reEntryFlag	;set the "I am BUSY flag"		rts@NOTREENTRANT	pla		pla			;discard return address of my JSR		LDA	#$01		;BAD COMMAND ERROR FOR EVERYTHING NOW		plp		sec		rts	;return for entire call to firmware				Host_ROM_length	equ	*-Host_ROM_code		if	(Host_ROM_length > 1536) then		aerror	'!! Host_ROM_code length is longer than 1.5K !!'		else		DCB.B	1536-Host_ROM_length,$00 ;fill the remaining bytes with	zero's		endif		ENDP