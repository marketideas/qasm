Card_isIIgs	equ	Host_CC00_pseudoROM+09SmartSig	equ	%11000000	;$CnFB,	smartport type is Xtended + additionals			;||||||||___bit 0 RAM card			;|||||||____bit 1 SCSI			;||\|||			;|| \||			;||  \|_____bits 2-5 Reserved			;||_________bit 6 Additional Commands 			;|__________bit 7 Extended Commands 			VersionHi	equ	$01VersionLo	equ	$00		ejectzero_page_template RECORD 0***************************************************    UC/IC 65c02 zero page equates**************************************************msg		DS.B	1		;$FF ;A//e -> 65c02 message portreply		DS.B	1		;$FF ;65c02 -> A//e  message portparms:					;the group of the next 9 bytescmdmode		DS.B	1		;$00 ;$0x=SP, $4x=XSP, $8x= ProDOSunitno		DS.B	1		;$FF ;unit number of requestsyncflag	DS.B	1		;$00 ;filler for copy of g.devndxCmdpkt6		equ	*		;contents for SmartPort	Cmd Packetcmdcode		equ	*		;code for SP Status and	Ctrl requestsbytecnt		equ	*		;Read Bytes size (in & out)blocknum	DS.W	1		;$FFFF ;logical	block RD/WR Blk	requestsintrlv		DS.W	1		;$0000 ;address	of RD/WR byte requestsblockcnt	DS.W	1		;$0000 ;address	of RD/WR byte requestsxfrcnt		DS.W	1		;$0000 ;size of	Status & ReadBytes xfercurcyl		DS.B	2		;$FF,$FF ;current cyl posns (2 local units)twosided	DS.B	2		;$80,$80 ;SS=$00 DS =$80 (local	units only)VolIntrlv	DS.B	2		;$00,$00 ;FmtFnd from RdAddr of	local unitsdrive		DS.B	1		;$00 ;LIRON EMULATION 'drive' (always zero)cyl		DS.B	1		;$FF ;cylinder being looked forsector		DS.B	1		;$FF ;sector for Rdadr/Rdata to	findside		DS.B	1		;$FF ;side to look ontopbits		DS.B	1		;$FF ;for CBUS driver &	LIRON EMULATIONtopbits1	equ	*		;for CBUS drivergrp7ctr		DS.B	1		;$FF ;for LIRON	EMULATIONWPacketType	DS.B	1		;$FF ;for CBUS driver &	LIRON EMULATIONcurNsect	DS.B	1		;$00trk		DS.B	1		;$FF ;request cyl+side to findsectcnt		DS.B	1		;$FF ;number of	sectors	which have been	read		DS.B	1		;$00 ;LIRON EMULATION 'xtions'csum		DS.B	1		;$FF ;LIRON Emulation csumc		DS.B	1		;$00 ;used to store check sumscsumb		DS.B	1		;$00csuma		DS.B	1		;$00wcsum		DS.B	1		;$00exindex		DS.B	1		;$00 exindex2	DS.B	1		;$00pointerl	DS.W	1		;$0000pointerh	equ	pointerl+1sectinfo	equ	*		;data from addr	header of sectorCSFnd		DS.B	1		;$00 ;CheckSum FoundFmtFnd		DS.B	1		;$00 ;sector format foundSideFnd		DS.B	1		;$00 ;side + trkb7 foundSectFnd		DS.B	1		;$00 ;sector foundCylFnd		DS.B	1		;$00 ;Cylinder found (6	bits)fmtsect		EQU	SectFnd		;used during mfm formattrktemp		DS.B	1		;$00 ;LIRON EMULATION 'oddbytes'ramblk		DS.B	1		;$00 ;buffr bank-switch	select addresscachndx		DS.B	1		;$00 ;buffr index number (1..12) unit_num	DS.B	1		;0 ;unitno -1 for cur requstdelayctr	DS.B	1		;0 ;time delay counterCurIWMode	DS.B	1		;0 ;last value set into	IWM mode regsmartdev	DS.B	1		;0 ;first SmartPort device (zero if none)numdevs		DS.B	1		;0 ;number of devices on chain;	dumb+smart*********************unittype	DS.B	4		;0,0,0,0,0,0 ;CBUS,,Liron,,SUPER,A3.5* UnitType bit masksUTremote	equ	$80		;Remote	CBUS deviceUTliron		equ	$08		;UniDisk 3.5 device on CBUSUTfdhd		equ	$02		;UTa35 also set	when this setUTa35		equ	$01		;AppleDisk3.5 (unified drive)begsect		ds.b	1		;for readNblksbegtrack	ds.b	1		;for readNblksunitmode	DS.B	4		;0,0,0,0 ;UDE,ISM/iwm,14/7m,DSW,F/s,HD/sd,GCR/mfm* UnitMode bit MasksUMudemul	equ	$80		;UniDisk Emulation (LIRON EMULATION)UMmfmHD		equ	$40		;volume is MFM HDUMmfmDD		equ	$20		;volume is MFM DDUMdsw		equ	$10		;Unit Supports disk switched statusUMfast		equ	$08		;IWM speed modeUMnotmr		equ	$04		;No Timer mode for IWM 		ds.b	1		;unusedpriorsts	ds.b	1voltype		DS.B	2		;0,0 ;400k,800K,720K,1200K,1440K,2000K*;		    0 =	volume not logically mounted yetAD400K		equ	02		; 400K 8-12s/trk SS 80 Trk GCR 6:8AD800K		equ	04		; 800K 8-12s/trk DS 80 Trk GCR 6:8  4:1 interleaveAD800K2		equ	06		; 800K 8-12s/trk DS 80 Trk GCR 6:8  2:1 interleaveDD720K		equ	08		; 720K	 9s/trk	DS 80 Trk MFM 500khzHD1440K2	equ	10		;1440K	18s/trk	DS 80 Trk MFM 2:1 interleaveHD1440K1	equ	12		;1440K	18s/trk	DS 80 Trk MFM 1:1 interleaveTotblksl	DS.B	2		;0,0 ;total blk	count low byteTotblksh	DS.B	2		;0,0 ;total blk	count hi bytevolsts		DS.B	2		;0,0 ;Swapped,Offline,WrProt,1sided,,Chukwait* VolStat bit masksVSswaped	equ	$80		;vol swaped as of last senseVSoffline	equ	$40		;vol offline as	of last	senseVSwrprot	equ	$20		;vol is	WritProt as of last senseVSsingle	equ	$10		;single	sided volume if	onlineVSchukwait	equ	$01		;500MS MotorONwait on nxt R/W access FmtOption	DS.B	2		;0,0 ;saved by SetFmtOpt (by unit)FmtIntrlv	DS.B	2		;0,0 ;saved by SetFmtOpt (by unit)* The CBUS Command Packet*CBcmdpkt	equ	*CBCmd		DS.B	1		;0CBPCount	DS.B	1		;0CBpktjunk	DS.B	1		;0CBpktguts	DS.B	6		;0,0,0,0,0,0,0		DS.B	1		;0 ;fillererror		DS.B	1		;$00 ;errors returned to a//e via this porterror2		DS.B	1		;$00 ;soft error bits* error2 bits defsadrerror	equ	$20		;adrs mark chksum/bitslip errordcserror	equ	$10		;data field check sum errordbserror	equ	$08		;data field bitslip errorsiderror	equ	$08		;ended up on wrong side	(head)cylerror	equ	$04		;ended up on wrong trackrcalerror	equ	$02		;unable	to detect trk 0nomkerror	equ	$01		;adrs/data mark	timeout	errorerrcnt		DS.B	1		;0 ;error3 , retry execregs	equ	*		;reg save after	executenumerrs		DS.B	1		;0 ;error4	   (A)		DS.B	1		;0 ;error5, numerrsh, (X)Cerrcnt		DS.B	1		;0 ;error6, Cache err cnt  (Y)reseekcnt	DS.B	1		;0 ;error7	   (P)adrerrcnt	DS.B	1		;0 ;error8	   statbyte	DS.B	1		;0Cachlock	DS.B	1		;$00 ;set to $80 to lockout cachingCstate		DS.B	1		;$00 ;Caching state ($80=locked, $40=after)tagsflag	DS.B	1		;0 ;set	to zero	for 512, -1 for	524interleave	DS.B	1		;$00 ;last Set interleave Ctrl cmd valueFormSides	DS.B	1		;$80 ;$80 = two	sided (only used by GCR)dwnldaddr	DS.W	1		;$0000byte0		DS.B	1		;$00 ;must end up at $66byte1		DS.B	1		;$00 ;used to store bytes whenbyte2		DS.B	1		;$00 ; deniblyzing them	during read/writebyte3		DS.B	1		;$00CurISMsu	DS.B	1		;0 ;current ISM	SetUp registerDrvrFlag	DS.B	1		;flag for GS/OS driver interfaceBytecountl	DS.W	1		;$0000ByteCounth	equ	Bytecountl+1rePrepCnt	DS.B	1		;$00mideject	DS.B	1		;$80Hooks		DS.B	2		;0,0RdAddrHook	DS.B	3		;0,0,0ReadDataHook	DS.B	3		;0,0,0WritDataHook	DS.B	3		;0,0,0SeekHook	DS.B	3		;0,0,0FormatHook	DS.B	3		;0,0,0WritTrkHook	DS.B	3		;0,0,0VerifyHook	DS.B	3		;0,0,0VectorHook	DS.B	3		;0,0,0ResetHook	DS.B	3		;0,0,0* Mark TAB*afdmtab		DS.B	1		;$FF ;after DataMark tabdatamarks	DS.B	4		;$AD,$AA,$D5,$FFsynctab		DS.B	5		;$FC,$F3,$CF,$3F,$FFbsmarks		DS.B	1		;$FFbslip2		DS.B	1		;$AAbslip1		DS.B	1		;$DEadrguts		DS.B	5		;$FF,$FF,$FF,$FF,$FFadrmarks	DS.B	4		;$96,$AA,$D5,$FFresult		DS.B	1		;$00 ;CBUS driverrecvBuff	DS.B	7		;0,0,0,0,0 ;CBUS drivergrp7cnt		equ	recvBuff	;CBUS driveroddbytes	equ	recvBuff+1	;CBUS driverdatastat	equ	recvBuff+2	;CBUS driverauxtype		equ	recvBuff+3	;CBUS driver (sense extended)pkttype		equ	recvBuff+4	;CBUS driverr0		DS.W	1		;$0000 ;general	purpose	registersr0L		equ	r0r0H		equ	r0+1r1		DS.W	1		;$0000r1L		equ	r1r1H		equ	r1+1r2		DS.W	1		;$0000r2L		equ	r2r2H		equ	r2+1minCsect	DS.B	1		;0 ;DoRead min Cache sect #maxCsect	DS.B	1		;0 ;DoRead temp	max+1 Cache sect #z_debug		DS.B	1		;0MFMflag		DS.B	1DDflag		DS.B	1		;$80 = DD mfm formatGap3Size	DS.B	1		;mfm intersector gap size		DS.B	1		ds.b	1TESTWRITE	DS.B	1		;always a zero except when UserTest is writingMediaChkVect	DS.W	1		;vector setup during any reset* pwrcon must be last item in zero pagepwrcon		DS.B	4		;$4A,$CF,$41,$55zp_init_lgth	equ	*		ENDRhost_zp_template RECORD	$40		g_zpage		equ	*g_DPtr		DS.B	3		;$40 = global Data Pointer g_cmdnum	DS.B	1		;$43 = global cmdnumg_unitnum	DS.B	1		;$44 = global unitnum		DS.B	1		;$45 = unusedg_Code		equ	*		;$46 = Status/Control code (1 byte)g_DskBlk	equ	*		;$46 = disk logical block# (2/4	byts) g_XfrCnt	DS.B	2		;$46 = Byte Xfer Count (2 bytes)g_Addrs		DS.B	4		;$48 = Byte xfer Address g_PPtr		DS.B	2		;$4C = global Param Ptr	(2/3 byts)xrtn		DS.B	1		;x rtn value	  (3rd byte overlap!)yrtn		DS.B	1		;y rtn valueg_error		DS.B	1		;a rtn value (error flag)g_devndx	DS.B	1		; $N0 after call to "execute" subrzpgsav		equ	*-g_zpage		ENDR********************************************************************************** EQUATES FOR BOTH HOST and CARD	*************************************************************************************** disk command equates (global)status		equ	0		;same command #'s used for ProDOS read		equ	1		;and SmartPort (nee Protocol Converter)write		equ	2format		equ	3ctrl		equ	4init		equ	5readbyts	equ	8writbyts	equ	9*usertestcmd	equ	$3D		;this must be < $7F*** ProDOS Blk Dev & SmartPort error codes*BadCmd		equ	$01BadPCnt		equ	$04BusErr		equ	$06BadUnit		equ	$11BadCtrl		equ	$21BadParm		equ	$22IOError		equ	$27NoDrive		equ	$28NoWrite		equ	$2BBadBlk		equ	$2DDswError	equ	$2EOffLine		equ	$2F**  "EQUATES and	ALLOCATIONS"Hedsel_zero	equ	$0A40		;makes the HEDSEL line lowHedsel_one	equ	$0A41		;makes the HEDSEL line highIWM		equ	$0A00		;actually this is the decode for the SWIMSnapBank	equ	IWM+$10		;ref this to latch RdBank0..2RdBank0		equ	IWM+$11		;b7 (Read Only)	= host bank bit	0RdBank1		equ	IWM+$12		;b7 (Read Only)	= host bank bit	1RdBank2		equ	IWM+$13		;b7 (Read Only)	= host bank bit	2ClkSwtch	equ	IWM+$14		;b7 = 1	FCLK = 14.318; 0 = 7.159MhzLEDon		equ	$0A80LEDoff		equ	$0A81CCmdCnt		equ	13maxSmarts	equ	02		;maximum of Smart units (UniDisk 3.5's)maxUnits	equ	maxSmarts+2	;maximum total units (2 dumb + smarts)nybblkndx	equ	12wrblkndx	equ	11		;logical buffer	number of wrblkwrblk2ndx	equ	09		;logical buffer	number of wrblk2wrblk		equ	06		;must be lower blk of 2	block groupwrblk2		equ	wrblk+1		;for CBUS/unified 524 byte readwrblkadd	equ	$0C00		;so CBUSdvr won't access IWM when lookinnumtracks	equ	80		;number	of tracks on 1 side of diskmaxcache	equ	18;** Phase Control Lines	**ca0off		equ	IWM+0ca0on		equ	IWM+1ca1off		equ	IWM+2ca1on		equ	IWM+3ca2off		equ	IWM+4ca2on		equ	IWM+5pulseoff	equ	IWM+6pulseon		equ	IWM+7****************************************************** the bits of the following equates correspond to * 	CA1 CA0 HdSel CA2*        b3  b2   b1   b0****************************************************** Cmd equatesdirout		equ	$01		;towards outside edge (trk0)dirin		equ	$00		;towards center	of diskrunmotor	equ	$08offmotor	equ	$09onestep		equ	$04eject		equ	$0Drdejctd		equ	$0C		;this reads the	ejected	latchejct_reset	equ	$03		;write this to reset ejected latch* Sense equates* 	CA1 CA0 HdSel CA2*        b3  b2   b1   b0istrack0	equ	$0A		;SelSide1instep		equ	$04		;SelSide0ready		equ	$0B		;SelSide1dskin		equ	$02		;SelSide1rddir		equ	$00		;SelSide0rdhd0		equ	$01		;SelSide0wrprt		equ	$06		;SelSide1is35HD		equ	$05		;SelSide0drivMFMadr	equ	$06		drivGCRadr	equ	$07mfmmodeadr	equ	$07mediaadr	equ	$0FFDHDadr		equ	$05******************************************************;** IWM	read and write lines **DeSelect	equ	IWM+8Select		equ	IWM+9enable1		equ	IWM+10enable2		equ	IWM+11Q6l		equ	IWM+12Q6h		equ	IWM+13Q7l		equ	IWM+14Q7h		equ	IWM+15*********************************************************  MFM constants and such********************************************************gapByte		EQU	$4E		;Inter/intra sector gap	bytetheSync		EQU	$00		;Sync byte preceeding each markfmtFillByte	EQU	$FA-256		;Format	byte to	fill sectors with; SpliceCnt must be tuned to put MFM slice 22 bytes after end of the address markSpliceCnt	EQU	36		;36 * 17  .5us cycles + overhead between ;  end of GetAddr (mfm) and mfmWriteData must total very close to 366 usAD1440KSectors	EQU	18DD720KSectors	EQU	09;Field sizes:gap4aSize	EQU	80		;Gap between index and index mark   gap1Size	EQU	50		;Gap between index mark	and sector 1gap2Size	EQU	22		;Gap between address and data fieldsgap3Sz1440K	EQU	101		;Gap between adjacent sectors (1440K)   gap3Sz720K	EQU	80		;Gap between adjacent sectors (720K)gap4bSize	EQU	1024		;Gap from end of last sector to	index (max) syncSize	EQU	12		;Sync field size************************************ ISM register equates**********************************IsmDataW	equ	IWM+0IsmMarkW	equ	IWM+1IsmCRCW		equ	IWM+2		;action	= 1IsmConfgW	equ	IWM+2		;action	= 0IsmParmsW	equ	IWM+3IsmPhaseW	equ	IWM+4IsmSetupW	equ	IWM+5IsmMode0W	equ	IWM+6IsmMode1W	equ	IWM+7IsmDataR	equ	IWM+8		;action	= 1IsmCorrR	equ	IWM+8		;action	= 0IsmMarkR	equ	IWM+9IsmErrorR	equ	IWM+10IsmParmsR	equ	IWM+11IsmPhaseR	equ	IWM+12IsmSetupR	equ	IWM+13IsmStatsR	equ	IWM+14IsmHndShR	equ	IWM+15***********************************GCRmode		equ	%00011111*			    IWM	mode = IWM,notst,8M,Fast,NoTimr,async,latchStat_disk	equ	$E8		;Block dev,Write,Read,x,Format,x,0,xStat_onl	equ	$10stat_wp		equ	$04stat_dsw	equ	$01		;PC general stat byte masksStat_char	equ	$60		;Char dev,Write,Read,x,NoFmt,x,0,xstat_open	equ	$01		;character device openadrmTO		equ	8*256		;byte count to find GCR	adrmarkcachtrk		equ	$0B00cachsect	equ	cachtrk+$20cachunit	equ	cachtrk+$40intlvtab	equ	$600		;max 32	bytesrcount		equ	$600		;result count for readNblksrtable		equ	$602		;result table for readNblkssectrtbl	equ	$620		;max 32	bytesnybl12buf	equ	$1C0		;16 nybles rwbuf12		equ	$1B2		;12 bytesnyblbufa	equ	$100		;thru $1B0nyblbufb	equ	$640		;thru $6F0nyblbufc	equ	$740		;thru $7F0* * *******************	CBUS Equates ********************* * *CBusSlow	equ	%0010111	;IWM mode for slow CBUS	conversations*     IWM mode = IWM,notst,8M,slow,off,async,latch*CBusFast	equ	%0011111	;IWM mode for fast CBUS	conversations*     IWM mode = IWM,notst,8M,fast,off,async,latchcmdmark		equ	$80datamark	equ	$82cmdlength	equ	9packetbeg	equ	$C3packetend	equ	$C8* CBUS error codes (stored in error2) **nomarkerr	equ	$80noenderr	equ	$81noanswer	equ	$82badcsum		equ	$83busyerr		equ	$84* timeouts **statmTO		equ	$20		;timeout if no mark found by this timebsyTO1		equ	250		;timeout for BSY to go lowbsyTO2		equ	250		;timeout for ACK to go low* "HOST	FIRMWARE EQUATES"*######### global equates and ram allocation  #################reEntryFlag	EQU	$CA00zsave		EQU	$CA02		;256 bytes of RAM in bank2 "behind" card I/O pageRAM_base_h	equ	$C800		;the base of the 1K RAM 'window';** for	message	sending	to 65c02 card **h_msg		equ	RAM_base_h+Zero_Page_template.msg	;A//e -> UC/IC 65c02 message semaphoreh_reply		equ	RAM_base_h+Zero_Page_template.reply	;65c02 -> A//e	reply semaphoreh_syncflag	equ	RAM_base_h+Zero_Page_template.syncflag	;65c02 -> A//gs	syncronuous writePrep flagh_parms		equ	RAM_base_h+Zero_Page_template.parms	;A//e parms -> UC/IC 65c02 (9 bytes)h_xfrcnt	equ	RAM_base_h+Zero_Page_template.xfrcnt	;a word	transfer count h_error		equ	RAM_base_h+Zero_Page_template.error	;UC/IC error return semaphore ;** for	determining machine type **StateReg	equ	$C068		;state register	on GSMachineID	equ	$FE1F		;ID routine on GS and Enhanced //eIDbyte1		equ	$FBB3		;ID bytesIDbyte2		equ	$FBC0		;PDflag		equ	0		;PD status code;** ProDOS Block Device	Interface EquatesPDCnt		equ	4		;ProDOS	BLock Device Protocol has 4 cmdscommand		equ	$42		;prodos	positions for passing theseunitnum		equ	$43		; parametersbuffaddr	equ	$44		;2 bytesdskblk		equ	$46		;3 bytesSPCnt		equ	12		;My SmartPort has 12 commands (0..11)ldblk0		equ	spcnt		;slave cmds => 0..SPCnt-1***************	boot stuff ********************loc0		equ	$00		;autoscan boot entry vectorloc1		equ	$01ptemp		equ	$478		;used only when	interrupts offmslot_h		equ	$7F8		;$Cn stored here*** Slot TEMPSscrn1		equ	$478-$C0scrn2		equ	$4F8-$C0scrn3		equ	$578-$C0scrn4		equ	$5F8-$C0scrn5		equ	$678-$C0scrn6		equ	$6F8-$C0scrn7		equ	$778-$C0scrn8		equ	$7F8-$C0power_up_byte_h	equ	$3F4		;power up byte used to see if warmstartreset_vector_h	equ	$3F2		;reset vector addresssetvid_h	equ	$FE93		;set video hooks backsetkbd_h	equ	$FE89		;set keyboard hooks backtext_h		equ	$FB39		;set text modehome_h		equ	$FC58		;clear scrncr_h		equ	$FC62		;begin a new linecout_h		equ	$FDED		;output a characterkbd_h		equ	$C000		;bit 7=1 if keystroke, bits 6-0=key pressedkbdstrb_h	equ	$C010		;turn off keystroke flag ($C000 bit 7)prbyte_h	equ	$FDDA		;output a hex byteprhex_h		equ	$FDE3		;output a hex nibbleBasic		equ	$E000		;basic entry pointautoscan	equ	$FABA		;autoscan loopshadow		equ	$C035		;Apple//GS shadow registercyareg		equ	$C036		;msb controls sytem speed************* test stuff ****************zp1		equ	Zero_Page_template.msgzp2		equ	Zero_Page_template.msg+1zp3		equ	Zero_Page_template.msg+2zp4		equ	Zero_Page_template.msg+3z_addr		equ	Zero_Page_template.msg+4;NOTE: zp1-zp4 and z_addr must be together and they must be in locations 0-5!;There should be no conflict with the regular variable usageclear_code	equ	$00pass_code	equ	$A1fail_code	equ	$4Fdisk_fail_code	equ	$4Ereboot_code	equ	$55zp_addr_h	equ	$3E	;these are temp. monitor zero page locationszp_addr1_h	equ	$40zp_byte_h	equ	$42zp_byte1_h	equ	$43zp_byte2_h	equ	$44zp_byte3_h	equ	$45