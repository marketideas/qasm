		eject*	    'Nibble Table'nibtab		EQU	*		DC.B	$96,$97,$9A,$9B,$9D,$9E,$9F,$A6,$A7		DC.B	$AB,$AC,$AD,$AE,$AF,$B2,$B3,$B4,$B5		DC.B	$B6,$B7,$B9,$BA,$BB,$BC,$BD,$BE,$BF		DC.B	$CB,$CD,$CE,$CF,$D3,$D6,$D7,$D9,$DA		DC.B	$DB,$DC,$DD,$DE,$DF,$E5,$E6,$E7,$E9		DC.B	$EA,$EB,$EC,$ED,$EE,$EF,$F2,$F3,$F4		DC.B	$F5,$F6,$F7,$F9,$FA,$FB,$FC,$FD,$FE,$FF		DC.B	$96,$97,$9A,$9B,$9D,$9E,$9F,$A6,$A7		DC.B	$AB,$AC,$AD,$AE,$AF,$B2,$B3,$B4,$B5		DC.B	$B6,$B7,$B9,$BA,$BB,$BC,$BD,$BE,$BF		DC.B	$CB,$CD,$CE,$CF,$D3,$D6,$D7,$D9,$DA		DC.B	$DB,$DC,$DD,$DE,$DF,$E5,$E6,$E7,$E9		DC.B	$EA,$EB,$EC,$ED,$EE,$EF,$F2,$F3,$F4		DC.B	$F5,$F6,$F7,$F9,$FA,$FB,$FC,$FD,$FE,$FF		DC.B	$96,$97,$9A,$9B,$9D,$9E,$9F,$A6,$A7		DC.B	$AB,$AC,$AD,$AE,$AF,$B2,$B3,$B4,$B5		DC.B	$B6,$B7,$B9,$BA,$BB,$BC,$BD,$BE,$BF		DC.B	$CB,$CD,$CE,$CF,$D3,$D6,$D7,$D9,$DA		DC.B	$DB,$DC,$DD,$DE,$DF,$E5,$E6,$E7,$E9		DC.B	$EA,$EB,$EC,$ED,$EE,$EF,$F2,$F3,$F4		DC.B	$F5,$F6,$F7,$F9,$FA,$FB,$FC,$FD,$FE,$FF		DC.B	$96,$97,$9A,$9B,$9D,$9E,$9F,$A6,$A7		DC.B	$AB,$AC,$AD,$AE,$AF,$B2,$B3,$B4,$B5		DC.B	$B6,$B7,$B9,$BA,$BB,$BC,$BD,$BE,$BF		DC.B	$CB,$CD,$CE,$CF,$D3,$D6,$D7,$D9,$DA		DC.B	$DB,$DC,$DD,$DE,$DF,$E5,$E6,$E7,$E9		DC.B	$EA,$EB,$EC,$ED,$EE,$EF,$F2,$F3,$F4		DC.B	$F5,$F6,$F7,$F9,$FA,$FB,$FC,$FD,$FE,$FF* Jmp table for HDMediaChk douwn load routine for GS/OS driver		jmp	U35MtrOn		jmp	Recal		jmp	Seek		jmp	WaitRdyTO		jmp	rdmode		jmp	DoEject		Title	'INITIALIZE AND DISPATCH'******************************************************* DoInit******************************************************DoInit		jsr	disabl35	;do this first to cancel timer		jsr	Wait1Ms		bit	DeSelect	;turn the drive	enable off		stz	reply		;tell host 'done'		*************************************** RESET	AND NMI	ENTRY POINT FOR	CPU**************************************InitCard	CLD		SEI			;turn interrupts off		ldx	#$FF		;set stack to ff		txs		stz	msg		;lockout host if Warm Reset		lda	mideject		jmp	pwrondiag	;do pwron testsBegin		lda	mideject		jsr	CopyRom2Ram	;setup the host	firmware image		* * Now determine	if Cold	or Warm	Start		ldx	#4@pwrChk		dex		bmi	@WarmReset	;a CTRL-RESET key restart		lda	pwrcon+ROM_start,x		cmp	pwrcon,x 		beq	@pwrchk		;		* Do everything to power on startup this mess		jsr	ColdStartup				bra	@60@warmReset	jsr	ZapCache	;clear the cache** Reset forced the SWIM back into IWM mode so reset variable and re-init ISM side		ldx	#-1		stx	unit_num		jsr	StartupISM	;restart ISM and it flags and De-asserts EN3.5		jsr	EnableGCR	;set clk switch to known state				ldx	smartdev	; X=1st unit to re-assign		beq	@45		lda	#$80		;warm restart flag		jsr	AssignID	;init any CBUS devices on the chain 		lda	#GCRmode		jsr	SetIWMmode	;reset to GCR mode in IWM* A CTRL-RESET may have	interrupted a long eject operation* and may not have been	completed properly@45		** If only UniDisk or Smart units don't assert Enable35 signal at all		lda	smartdev	;		cmp	#01		;are there any dumb drives to enable?		beq	@60		;no local units!*		ldx	numdevs@50		dex		bmi	@55		bit	unittype,x		bmi	@50		stx	drive		stx	unit_num	;set this too for subrs 		jsr	Enable35	;		ldx	drive		jsr	EnblnChk	;clear DSW if set		phx		clc		jsr	MountVol		jsr	EnableGCR	;reset to GCR mode for next drive		ldx	drive		jsr	DTCancel		plx		bra	@50@55		jsr	Enable35					@60				bit	mideject	;was eject in progress?		bmi	@70		;no.* enable the drive and retry the eject		ldx	#-1		;make Enable35 leave the drives alone		stx	unit_num		jsr	Enable35		ldx	mideject		lda	Enable1,x		bit	Select		jsr	EjectLcl	;eject a local drive if	I can@70		equ	*		lda	#$FF		sta	reply		;insure	that its off		sta	msg		;Finally look ready to the host firmware		ldx	#03* Now fall into	process	wait for cmd idle loop* "CARD	CMD PROCESSOR";*****************************************************; IdleLoop;	 This is the infinite loop that	the 65c02 sits in while; waiting for the next command.	 When it gets a	command, it loads; the address of the routine that will process that command and; then jumps to	it.;;*****************************************************IdleLoop	equ	*		dec	r1L		;decrement counter  (just for debugging)		bne	@wtmsg		;if not	0 see if cmd requested yet		dec	r1H		;decrement high	byte of	counter ( it indicates CPU is in the idle loop)			bne	@wtmsg		;if not	0 see if cmd requstd		dex			;		bne	@wtmsg			if 1	then 		jsr	ChkEject	;14*65536*.5 = .45 sec poll interval	else		nop		nop		nop	endif		ldx	#03@wtmsg		lda	msg		;see if	command	requested ?		bmi	IdleLoop	; if not, wait for one		sta	$E0		lda	cmdmode		sta	$E1		lda	unitno		sta	$E2		lda	blocknum		sta	$E3		lda	blocknum+1		sta	$E4@go		jsr	VectorHook	;vector	to the cmd routine		bcs	@10		;caller	reset msg so just poll it		lda	#$FF		;indicate that we're ready		sta	msg		; for another command@10		stz	r1h		;insure	the timeout is long 		stz	drive		;reset for Liron Emulation mode* * Besure to always put SWIM back into IWM mode on completion of each command		jsr	EnableGCR	;only switches if MFM mode was used by the prior call		lda	msg		;is cmd	already	pending?		bpl	@go		;yep. don't deselect		bit	DeSelect	;turn the drive	enable off					; thus starting	drive timeout		ldx	#03		;3 causes 1.5 sec before 1st poll		bra	IdleLoop	;infinite loop******************************************************** CallCmd	 Mainline msg and unit_num validation*      *    This routine verifies the command code and *  then	clears the error result **  (if DiskII support included later Timeout waiting *  (will occur here if switching from diskII to	3.5's)**   Input : msg	 (0..C)*    Regs : Destorys A,X,Y**  Output :*******************************************************CallCmd		stz	error		stz	errcnt		;set to	6 if DoRead reads media		stz	tagsflag	;assume	512 byte blocks	 (changed for Read/Write Bytes Cmd)		stz	MFMflag		;assume GCR I/O (set if MFM vol in FDHD)		lda	#$FF		sta	sector		sta	trk		sta	cyl		lda	msg		cmp	#CCmdcnt+2		bcc	@10		;cmd is	ok* CMD = $7E means clear the isIIgs flag  $7F means set the isIIgs flag		cmp	#$7E		bcc	@CheckDiag	;		eor	#$7E		;makes a zero or a one		beq	@notIIgs		lda	#$40@notIIgs	sta	Card_isIIgs	;set the flag in "host" ROM image		clc			rts@checkDiag	equ	*		cmp	#usertestcmd	;go do User Diagnostics		bne	@30		jmp	UserTest@10		equ	*		stz	DDflag		;so DevStat will cancel Drive enable@15		lda	numdevs		;		cmp	unitno		;is numdevs >= unitno?		bcs	@20		;yes.		lda	msg		;if its a Status call		ora	cmdcode		;status code zero?		bne	@badUnit			bit	cmdmode		bvc	@badunit	;and Extended Sp call?		lda	unitno		bpl	@badunit	;is it negative unit#?		sta	DDflag		;so DevStat will enable Drive & LED		and	#$7F		sta	unitno		bne	@15		;try again for $81..84		@badunit	lda	#BadUnit		bra	DoErr@20		ldx	unitno		dex		stx	unit_num	;unit_num = unitno - 1		bmi	CallLocal	;unit zero is done by local		lda	unittype,x	;local or remote unit?		bpl	CallLocal		lda	msg		cmp	#CCmdcnt	;valid cmd for cbus devices?		bcc	CallRemote	;remote	unit!@30		bra	DoBadCmd@doUnitZero	equ	** Now call the AppleDisk driverCallLocal	lda	#GCRmode			jsr	SetIWMMode	;set IWM mode register for GCR		jsr	Enable35	;enable 35 iff not enabled now		lda	msg		asl	a		tax		JMP	(lclcmds,x)	;enter the AD3.5 driver* Now call the CBUS driver CallRemote	EQU	*		ldx	#-1		stx	unit_num		jsr	Disabl35	;turn local units off		jsr	EnableGCR	;inusre it 7.83Mhz clock		ldx	unitno		stx	unit_num	;CBUSDVR wants 1 based unit_num		jsr	DoRemote	;enter Remote unit driver				lda	smartdev	;is smartdev the first device?		cmp	#01		beq	KnownRTS	;yep so don't switch back to 3.5 mode		lda	#-1		sta	unit_num		jsr	Enable35	;re-assert /EN35 signalKnownRTS	clc		rts********************************** Command dispatch table*********************************Lclcmds		equ	*		DC.W	DoStatus	;00 read status	(unit)		DC.W	DoRead		;01 read blk	(unit)		DC.W	DoWrite		;02 write blk	(unit)		DC.W	DoFormat	;03 format vol	(unit)		DC.W	DoCtrl		;04 write Ctrl	(unit)		DC.W	DoInit		;05 init SmartPort (card)		DC.W	DoBadCmd	;06 not	for local drives		DC.W	DoBadCmd	;07 not	for local drives		DC.W	DoRWByts	;08 read bytes	(unit)		DC.W	DoRWByts	;09 write bytes	(unit)		DC.W	DoSetFmt	;0A Set	Format Opts (unit)		DC.W	DoGetFmt	;0B Get	Format Optn (unit)		DC.W	DoBoot		;0C Boot (Init & read blk0)		DC.W	DoBlkCalcN	;0D Compute blks on track		DC.W	DoReadNBlks	;0E Read n blocks on trackDoBadCmd	equ	*		lda	#BadCmdDoErr		clc			;normal	err returnDoErrC		sta	error		stz	reply		;indicate err reply		rtsBadParmErr	lda	#BadParm		bra	Doerr		***********************************************************************  Cold Startup Code**********************************************************************ColdStartup:* This code is executed	only at	pwrup		jsr	InitZeroPag	;copy zero page	image NOT including pwrcon*		lda	#>KnownRTS		sta	MediaChkVect+1		lda	#<KnownRTS		sta	MediaChkVect	;setup for the format call addition				lda	#-1		sta	unit_num	;indicate no drive to enable or select		jsr	StartupISM	;setup ISM side and De-asserts EN3.5* Now init the device chain		lda	#150		;150x2 = 300 Ms		jsr	wait2Ms		;delay for drive pwron reset		lda	#GCRmode	;init CurIWMode	before any uses	 		jsr	SetIWMMode		jsr	Disabl35	;set /Enbl35 high to set 'LAST'		jsr	resetchain	;perform CBUS reset for	LIRON's etc		jsr	Enable35	;low again to block daisy chns		jsr	Wait1Ms		jsr	Disabl35	;pulse ENBL35 to set drive modes		jsr	ConfigLcl	;configure any local drives		stz	smartdev	;assume no smartdevs out there		ldx	numdevs		inx			;X = 1st smart unit number to assign (if possible)		lda	#00		;cold reset for	CBUSdvr		jsr	AssignID	;		beq	@40		;didn't find an smart units !		ldx	numdevs		inx		stx	smartdev	;remember 1st smartunit num for Com/Warm reset		clc		adc	numdevs		sta	numdevs		;add the smart unit count to the total@40		stz	unit_num	;don't leave unit_num with 2/3 or such		jsr	InitPwrCon	;init the power-up constant*	|	|	|*	v	v	v	Fall thru into ZapCache*********************************************************************************************************************************************ZapCache	equ	** Clear the cache control tables on a Warm/Cold reset		ldx	#32-1		lda	#$40@zapctbls	stz	cachtrk,x	;reset all cache vars on reset		stz	cachsect,x		sta	cachunit,x	;mark extra buffers as not available		cpx	#maxcache		bne	@10		lda	#$80		;mark as available bufs maxcache-1 thru zero@10		dex		bpl	@zapctbls		rts* "CARD	RESET ROUTINES"****************************************************** InitZeroPag****************************************************InitZeroPag	equ	*		ldx	#zp_init_lgth-5	;offset	into page@ldzpg		lda	Zero_Page_Init_Data,x ;get the initial data from the ROM		sta	$00,x		;copy it into card zero	page		dex		bne	@ldzpg		;except	for first byte (msg)		rts********************************************************** InitPwrCon ** Power-up Constant is 4 bytes long*********************************************************InitPwrCon	equ	*		ldx	#zp_init_lgth-1@copypwrcon	lda	Zero_Page_Init_data,x		sta	$00,x		dex		cpx	#zp_init_lgth-5		bne	@copypwrcon		rts;*****************************************************; CopyRom2Ram;	 This routine puts all the firmware that the Apple //e; uses to run card in the ram and also initializes z-page for; the 65c02.;;*****************************************************CopyRom2Ram	equ	*		ldy	#0		;offset	into page@ldcn		lda	Host_CnXX_Code,y ;get the $CnXX	ROM image		sta	Host_CnXX_pseudoROM,y ;and put it into the pseudoROM area		iny		bne	@ldcn@ldram		lda	Host_CA00_physical,y ;get next byte of firmware		sta	Host_CA00_pseudoROM,y ;	and put	it in host CAxx		lda	Host_CA00_physical+$100,y ;		sta	Host_CA00_pseudoROM+$100,y ;	 put in	host CBxx		lda	Host_CA00_physical+$200,y ;		sta	Host_CC00_pseudoROM,y ;	    put	in host	CCxx		lda	Host_CA00_physical+$300,y ;put some code in bank 0		sta	Host_CC00_pseudoROM+$100,y ;  put in host $CDxx	page		lda	Host_CA00_physical+$400,y ;		sta	Host_CC00_pseudoROM+$200,y ; put in  host CExx page		lda	Host_CA00_physical+$500,y ;		sta	Host_CC00_pseudoROM+$300,y ; put in  host CFxx page		iny			;increment page	offset		bne	@ldram		;continue if page not finished* Now release the infinite loop	in Host_CnXX_Code code		lda	#GOEntry-Bootptch1-2 ;relative offset from Bootpatch1 to GOEntry		sta	|Bootptch1-Host_CnXX_Code+Host_CnXX_pseudoROM+1	;force branch to GOEntry		stz	|Bootptch2-Host_CnXX_Code+Host_CnXX_pseudoROM+1	;force branch to next opcode** Now setup the null "user" routines for the Notifer (see Host code)		lda	#$60		;rts opcode for null "user" routines		sta	$B80		sta	$B80+32		sta	$B80+64		sta	$B80+96		;at 32 byte intervals from $B80		rts************************************** ConfigLcl Drives **  Function: Determine number of local drives*	     and setup unittype	for each**************************************ConfigLcl	equ	*		jsr	EnableGCR	;insure clk speed set right at start		ldx	#0@gd35		stx	drive		stx	unit_num** Enable drive select and look for a disk device		jsr	Is35		;see if	disk is	a unified/Super	drv		bcs	@nope		;if not, look for CBUS devices* Is35 returns drive type in A if drive found		ora	#UTa35		;if unit is a A35 or FDHD set A35 bit		sta	unittype,x	;ID the	unittype as AD35 and/or FDHD				lda	#ejct_reset		JSR	WriteBit	;clear dsw on Cold Reset!				jsr	SensX		;set the volsts bits from drive		bvc	@10		;something is online		jsr	UnMountX	;nothing online so set states 		bra	@20@10		clc		jsr	MountVol	;see if voltyp can be determined		bcc	@20		;vol type now known* Disk in place	sensed but no adrs mark	in any mode so eject* on the assumption its	empty drive or dummy ship disk		ldx	drive		jsr	EjectLcl	;eject non-volume in local unit in 'drive'@20		jsr	EnableGCR	;reset ISM side to GCR mode		ldx	drive		inx			;look at next local drive		cpx	#2		;if 2, can't be a unified drive		blt	@gd35		;@nope		stx	numdevs		;save #	of local units		txa		beq	@30		dex			;get drive # of last unit		jsr	DTCancel	; cancel timer@30		rts************************************ Is35***********************************Is35		equ	*		jsr	Enable35	;enable	any 3.5's out there		lda	enable1,x	;now try to enable the one in y		bit	Q6L		;don't accidentally write to disk		bit	Q7L		;		bit	Select		;activate the drive enable		lda	#dirout		;point head out		jsr	WriteBit	;		lda	#rddir		;see if	it's going the right way		jsr	ReadBit		;		bcc	@nope		;nothing's out there		lda	#dirin		;point head in		jsr	WriteBit	;		lda	#rddir		;see if	it's going the right way		jsr	ReadBit		;		bcs	@nope		;nothing's out there		lda	#dirout		;point head out		jsr	WriteBit	;		lda	#rddir		;see if	it's going the right way		jsr	ReadBit		;		bcc	@nope		;nothing's out there		lda	#is35HD		;is it a A35HD Drive 		jsr	ReadBit		;returns A = $00		bcc	@exit		;A35		lda	#UTfdhd		;A35HD		clc			;indicate a drive exists		rts@nope		sec			;indicate no Apple drive found@exit		rts******************************************************* SurveyLcl** Determine what volume	type is	mounted	in* a local drive.* AppleDisk 3.5s can have AD400K,AD800K* AppleDisk 3.5HD can have AD400K,AD800K,SD720K,HD1440K** set UnitMode,	VolType, and VolStat per type found**  Assumed: drive has been selected and	motorOn	started**   Input : X =	unit_num of local drive	to check (0/1)**   Output: c =	0 voltype determined *	    A =	unitmode*	    Y =	voltype*	    X =	input unitnum *      *	    c =	1 no readable address mark in any mode** Destorys: A,Y	  Preserves X*	    X ->  drive	(zeropage var)*******************************************************SurveyLcl	equ	*		stx	drive		lda	#4		sta	errcnt		;retry count for each mode to try		jsr	WaitReady	;be sure drive is ready@searchlp	stz	side		;always	try side 0		jsr	GetAddr		;for now its simple		bcc	@found		lda	error2		bit	#adrerror	;bit slip/check	sum error?		bne	@GCRretry	;yes. so try again		bit	#cylerror	;not on	the right track?		beq	@nomrk		lda	CylFnd		sta	cyl		;make where I am where I want to be@GCRretry	dec	errcnt		bne	@searchlp		bra	tryMFM		@nomrk		bit	#nomkerror			bne	tryMFM@errxit		sec		rts** Found	a valid	GCR adrs mark*@found		ldx	drive		jsr	EnblnSens		ldy	#AD800K		;assume	2 sided	GCR 4:1 		lda	VolIntrlv,x		and	#$1F		;drop 2 sided bit		cmp	#02		;is it 2:1 interleave?		bne	@05		ldy	#AD800K2@05		bit	twosided,x		bmi	@10		;double sided!		lda	volsts,x		ora	#VSsingle		sta	volsts,x		ldy	#AD400K		;2:1 only@10		lda	TotBlks,y	;set data for Status calls		sta	TotBlksl,x		lda	TotBlks+1,y	;to return to SmartPort		sta	Totblksh,x	;etc		lda	volsts,x		and	#-1-VSoffline	;cancel	offline	state		sta	volsts,x				lda	unitmode,x		and	#%10010100		ora	DfltMode,y		sta	UnitMode,x		sty	VolType,x	;save the volume type		clc		rts* now setup and	try the	MFM mode for IBM 720K tryMFM		equ	*		ldx	drive		lda	#UTfdhd		;can drive do MFM?		bit	UnitType,x			beq	@notFDHD	;Not with an Apple 3.5" drive				lda	#DrivMFMadr	;switch Drive to MFM mode		JSR	WriteBit	;send cmd to set FDHD mode		lda	#11		jsr	Wait2Ms		;delay at least 20 ms before sampling Ready		jsr	EnableMFM	;switch to ISM and enable 16M clock etc		LDA	#MFMmodeAdr		jsr	ReadBit		;read back the drive mode		bcc	tryMFM		;try again		jsr	WaitReady	;be sure drive is ready		stz	cyl		lda	#4		sta	errcnt		;retry count for each mode to try@searchlp	stz	side		;always	try side 0		jsr	GetAddr		;for now its simple		bcc	@foundMFM		lda	error2		bit	#adrerror	;bit slip/check	sum error?		bne	@retry		;yes. so try again		bit	#cylerror	;not on	the right track?		beq	@retry		lda	CylFnd		sta	cyl		;make where I am where I want to be@retry		dec	errcnt		bne	@searchlp		* Following a mode change with motor already running@noMFM				lda	#DrivGCRadr		jsr	WriteBit		lda	#11		jsr	Wait2Ms		;enforce delay for bad Ready sense line@notFDHD	jsr	EnableGCR		ldx	drive		lda	unitmode,x		and	#%10011111		sta	unitmode,x	;zap mfm media bits just to be sure		sec		rts** Found valid MFM adrs mark*@foundMFM	jsr	DeSelectISM	;switch back to IWM side		ldx	drive		jsr	EnblnSens	;sense drive state and set volsts		ldy	#DD720K		;		lda	TotBlks,y	;set data for Status calls		sta	TotBlksl,x		lda	TotBlks+1,y	;to return to SmartPort		sta	Totblksh,x	;etc		lda	volsts,x		and	#-1-VSoffline	;cancel	offline	state		sta	volsts,x					lda	DfltMode,y		sta	UnitMode,x		sty	VolType,x	;save the volume type		clc		rts******************************************* Data Tables for SURVEY******************************************DfltMode	equ	*		DC.B	$00		;null		DC.B	00		;zero blks/trk		DC.B	%00010001	;AD400K		DC.B	$80+8		;var blks/trk min =8		DC.B	%00010001	;AD800K (4:1)		DC.B	$80+8		;var blks/trk min = 8		DC.B	%00010001	 ;AD800K  (2:1)		DC.B	$80+8		;var blks/trk min = 8		DC.B	%00110010	;DD720K		DC.B	9		;9 blks/trk		DC.B	%01010010	;HD1400K		DC.B	18		;18 blks/trk		DC.B	%01010010	;HD1400K		DC.B	18		;18 blks/trk