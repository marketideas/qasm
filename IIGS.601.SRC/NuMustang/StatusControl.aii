		eject*	    'SmartPort Control Command'************************************************************** DoCtrl**  Local driver	 Control command processing routine**************************************************************DoCtrl		equ	*		ldx	cmdcode		cpx	#maxcode		bcs	badcode		lda	unit_num		bpl	@normunit* now check if unit zero ctrl cmd allowed		bit	uzctable,x	;unit zero allowed?		bmi	Badcode		;no		bvc	@normunit	;use the normal	ones* later	add any	unit zero ctrl cmds@uzCtrls	equ	*		;any unit zero only ctrls go here		bra	badcode@normUnit	* Now be sure the control list will fit	in my buffer		ldx	xfrcnt+1	;get page of ctrllist size		cpx	#04		bge	PCntErr		lda	#wrblk		sta	reply		;cmd list is <=	767 bytes*@wait		lda	reply		;wait until command list is loaded		bpl	@wait* now decide what to do	for local units		lda	cmdcode		asl	a		tax		jmp	(cctable,x)badCode		lda	#BadCtrl	;bad ctrl code		bra	DoErr3PCntErr		lda	#BadParmDoErr3		jmp	DoErr************************************ Unit Zero Code table* $80 indicates	not allowed* $40 indicates	unit zero special code* $00 indicates	use normal ctrl	routine***********************************uzctable	equ	*		DC.B	$80		;00		DC.B	$80		;01		DC.B	$80		;02		DC.B	$80		;03		DC.B	$80		;04		DC.B	$80		;05 		DC.B	$80		;06		DC.B	$80		;07		DC.B	$80		;08		DC.B	$80		;09		DC.B	$80		;10		DC.B	$80		;11		DC.B	$00		;12		DC.B	$80		;13		DC.B	$00		;14		DC.B	$00		;15		DC.B	$00		;16		DC.B	$00		;17		DC.B	$00		;18		DC.B	$00		;19********************************************* Control Code Dispatch	Table********************************************cctable		DC.W	DoReset		;00		DC.W	BadCode		;01		DC.W	BadCode		;02		DC.W	BadCode		;03		DC.W	DoEject		;04		DC.W	BadCode		;05	= GS setHook		DC.W	BadCode		;06	= GS resetHook		DC.W	BadCode		;07	= GS setMark		DC.W	BadCode		;08	= GS resetMark		DC.W	DoSetSides	;09		DC.W	DoSetIntrlv	;10		DC.W	BadCode		;11		DC.W	DoPoke		;12		DC.W	DoResetMarks	;13		DC.W	DoResetHooks	;14		DC.W	DoSetCachLk	;15		DC.W	DoSetAddr	;16 		DC.W	DoDwnLoad	;17		DC.W	DoExec		;18		DC.W	DoPeek		;19maxcode		equ	(*-cctable)/2********************************************** Do the reset of all GCR marks*********************************************DoResetMarks	equ	*		ldx	#$16@copymarks	lda	MarkInitTbl-1,x		sta	afdmtab-1,x		dex		bne	@copymarks		bra	goolxit		;good exit********************************************** Do the reset of all hooks*********************************************DoResetHooks	equ	*		ldx	HookInitTbl-2@copyhooks	lda	HookInitTbl-1,x		sta	RdAddrHook-1,x		dex		bne	@copyhooks		bra	goolxit		;good exit*************************************************************************************DoSetCachLk	equ	*		lda	#01		jsr	ChkXfrcnt		lda	wrblkadd		and	#$80		sta	Cachlock		jsr	ClearCache	;clear all cached blocks		bra	goolxit*************************************************************************************DoSetIntrlv	equ	*		lda	#01		jsr	ChkXfrcnt		bne	PCntErr		lda	#$32		;bad interleave		ldy	wrblkadd		cpy	#12+1		bcs	DoErr3		sty	interleave		ldx	unit_num		sty	FmtIntrlv,x		bra	goolxit		;exit with no error*************************************************************************************DoSetSides	equ	*		lda	#01		jsr	ChkXfrcnt		bne	PCntErr1		lda	wrblkadd		and	#$80		sta	FormSides	;set for GCR formatgoolxit		lda	#00		jmp	Doerr3*************************************************************** RESET	a drive *************************************************************DoReset		equ	*		ldx	unit_num		jsr	UnMountX	; make no assumptions		jsr	EnblnChk	;go see	what I find		bpl	@10		;		jsr	MountVol	;aha, a	volume is there @10		bcc	@20		jmp	Doerr@20		rts***************************************************************************************************************************DoEject		equ	*		ldx	unit_num		jsr	EnblnSens	;enable	the drive and sense		jsr	EjectLcl	;eject local unit in X-reg		ldx	unit_num		jsr	ClrCacheX	;clears	cache		clc		rts***************************************************************************************************************************DoExec		equ	*		jsr	callrout	;call the routine		sta	execregs	;save registers	after execute command		stx	execregs+1	;		sty	execregs+2	;		php			;		pla			;		sta	execregs+3	;* is there any convention about	error reporting	here?		clc			;normal	return		rts*************************************************************** DoPeek**************************************************************DoPeek		equ	*		jsr	DoSetAddr		lda	(dwnldaddr)		sta	errcnt		;put result in convienent place		clc		rts*************************************************************** DoPoke**************************************************************DoPoke		equ	*		lda	#03		jsr	DoSetAddrA	;		lda	wrblkadd+4	;get value to poke		sta	(dwnldaddr)		clc		rts***************************************************************************************************************************DoSetAddr	equ	*		lda	#02DoSetAddrA	equ	*		jsr	ChkXfrCnt	;count is two?		bne	pcnterr1		lda	wrblkadd	;get download addr		sta	dwnldaddr	;		lda	wrblkadd+1	;		sta	dwnldaddr+1	;		clc		rtspcnterr1	jmp	PCntErr***************************************************************************************************************************DoDwnLoad	equ	*		ldx	dwnldaddr+1	;save high byte of download addr		ldy	#0		;zero offset		lda	#<wrblkadd		sta	r1L		lda	#>wrblkadd		sta	r1H@lp		lda	(r1),y		;get byte from cmdlist		sta	(dwnldaddr),y	;  and store it	at dnload address		iny		bne	@noinc		;		inc	r1H		;increment at 256 byte boundary		inc	dwnldaddr+1	;@noinc		dec	xfrcnt		;decrement counter		bne	@lp		dec	xfrcnt+1		bpl	@lp		stx	dwnldaddr+1	;restore high byte of download addr		clc		rts************************************************************** dispatch to user speced routine (only	called by DoExec)*************************************************************CallROut	EQU	*		lda	wrblkadd+4	;get address of	routine		sta	r1L		;   and	put it in zero page		lda	wrblkadd+5	;      register		sta	r1H		;		lda	wrblkadd+3	;get status byte		pha			;  and save it on stack		ldx	wrblkadd+1	;load up registers		ldy	wrblkadd+2	;		lda	wrblkadd+0	;		plp			;pull status byte off of stack		jmp	(r1)		;jump into the routine************************************** Check	xfrcnt for a 0001*************************************ChkXfrcnt	equ	*		ldy	xfrcnt+1		bne	@10		cmp	xfrcnt@10		rts* "Eject Local Unit"**************************************************** * EjectLcl*	     Eject the enabled,	and selected unit* given	by the input parameter.	Support	the 'reset'* before completion problem with the mid-eject flag**    Input : X reg = unitnum to	eject (0/1)*   Destorys: A,Y   Preserves X****************************************************EjectLcl	equ	*		stx	mideject	;set the flag for CTRL-RESET		lda	#dskin		jsr	Readbit		bcs	@90		;nothing to eject!		lda	#runmotor	;/motoron sense		jsr	ReadBit		;is the	motor on?		bcs	@10		;no. so	don't turn it off		lda	#offmotor		jsr	WriteBit		lda	#200		jsr	WaitaMs		;delay until stopped@10		lda	#03		sta	errcnt		;eject retries = 3@20		lda	#eject		jsr	WriteBit	;send eject cmd	to drive		ldy	#195@30		lda	#10		jsr	WaitaMS		lda	#dskin		;see if	its out	yet		jsr	ReadBit		bcs	@40		;its out. now		dey		bne	@30		;keep trying		lda	#ioerror		sta	error		bra	@90@40		jsr	UnMountX	;logical unmount volume@90		lda	#$80		sta	mideject	;clear flag		clc			;normal	return		rts		eject		msb	OFFUCICmsg		dc.b	'APPLE UNIVERSAL 3.5 CONTROLLER'DCBmsglen	equ	*-UCICmsg**************************************************************  Do SmartPort Status Requests*************************************************************DoStatus	equ	*		stz	xfrcnt		stz	xfrcnt+1	;assume	nothing	to return		ldx	unit_num	;see if	it's for a Liron		bpl	@normunit	;bmi only if unit was zero@UnitZero	lda	cmdcode		;cmdcode must be 0 to use unit 0		beq	@U0Stat		;if it is, then	do that	status call		cmp	#01		;get DCB for unit0 means zeropage		bne	@BadCode* DCB for unit zero is UC/IC identification string* 			ldx	#DCBmsglen		stx	wrblkadd	;save msg length@copyidstring	lda	UCICmsg-1,x		sta	wrblkadd,x		dex		bne	@copyidstring		ldx	#DCBmsglen		inx		bra	@done		@normunit	ldx	cmdcode		;check for other status	calls		beq	@devstat	;short status		cpx	#3		;DIB status (long)		beq	@devstat	;yes.		cpx	#5		;check if it's an extended status call		bne	@try06		;if not	try get	media format		jmp	@ExtStat	;extended status call@try06		cpx	#06		;get media status?		bne	@badcode* call survey routine and then analyze the interleave* and return results like GetFormatOptions@badCode	lda	#BadCtrl@somerr		jmp	DoErr@done		stx	xfrcnt		;store number of bytes returned		lda	#wrblk		;indicate info is in block 6		sta	reply		;		ldx	unit_num	;tell dt cancel	which drive		bit	DDflag		;phantom unit # status request?		bmi	@fini		jsr	DTCancel	;cancel	the drive timer 		clc			;normal	return		rts@fini		clc			;normal	return		rts@U0Stat		lda	numdevs		;number	of units 		sta	wrblkadd		ldx	#1		;start at 1		lda	#0		;fill rest with	0's@lp1		sta	wrblkadd,x		inx		cpx	#8		bne	@lp1* Put out a visible Firmware version		lda	#01		sta	wrblkadd+2	;Vendor ID = Apple Computer Inc.		lda	#VersionLo		sta	wrblkadd+4		lda	#VersionHi		sta	wrblkadd+5@done1		bra	@done		;X = 8 result count@ExtStat	ldx	#0@exstlp		lda	error,x		sta	wrblkadd,x		inx		cpx	#08		blt	@exstlp		bra	@done************************************ Device status	routine***********************************@devStat	equ	*		ldx	unit_num		jsr	EnblnSens	;Enable	& sense	the drive 		php		and	volsts,x	;extract VSwrprot bit		lsr	a		lsr	a		lsr	a		;move WP to $04		ora	#stat_disk	;add Blkdev,Wok,Rok,,FMTok,x,x,x		bvs	@offline	;its offline		ora	#stat_onl	;assert	the online status bit @offline	plp		bmi	@15		;drive had ejected latch set		bvs	@savstat	;offline so this can't be off->online transisiton		bit	priorsts	;was prior status offline?		bvc	@savstat	;no. so not the case to fake a dsw;	now its the offline -> online transition without dsw true@15		bit	cmdmode		;extended call		bvc	@savstat	;no. don't return dsw status		ora	#stat_dsw	;return	dsw status@savstat	sta	wrblkadd	;first byte of devstat* X-reg	still has unit_num		jsr	EnblnChk	;now determine if I should mount first		bpl	@20		;volume	online and known type		jsr	mountvol	;mount new unknown volume & set	type@20		equ	*		ldx	#$04		;start at beginning		ldy	unit_num		lda	TotBlksl,y	;number	of blocks		sta	wrblkadd+1		lda	TotBlksh,y		sta	wrblkadd+2		stz	wrblkadd+3		bit	cmdmode		;need an extra byte if extended	SP		bvc	@chkDIB		stz	wrblkadd+4	;save extra byte		inx			;5 bytes in message@chkDIB		lda	cmdcode		;see if	it wants more info		beq	@done1		; if not we're done		ldy	unit_num		lda	unittype,y		ldy	#00		;assume	AD35		bit	#UTfdhd		;AD35 or SD35		beq	@loop		ldy	#DIBHD-DIBtable@loop		lda	DIBtable,y	;get byte		sta	wrblkadd,x	;  and save as status info		inx			;increment pointers		iny		cmp	#$FF		;end of	entry?		bne	@loop		;otherwise, ke	ON		dex		jmp	@done****************************DIBtable	equ	*		DC.B	d1Strl		DC.B	'DISK 3.5'	;16 char stringd1strl		equ	*-DIBtable-1		DCB.B	16-d1strl,$20	;space filler		DC.B	$01,$C0		;TYPE,SUBTYPE		DC.W	$1010		;version word		DC.B	$FFDIBHD		DC.B	D2Strl		DC.B	'DISK 3.5'	;removed the 'HD' 12/11/91 JOAd2strl		equ	*-DIBhd-1		DC.B	'HD'		DCB.B	14-d2strl,$20	;space filler		DC.B	$01,$C1		;TYPE,SUBTYPE		DC.W	$1010		;version word		DC.B	$FF