		machine	M65C02		longa	off		longi	off*** Conditional	Assembly Switches ********************************************trace		set	0*** global assembly equatesRAM_start		equ	$0000		;start of the physical RAMROM_start		equ	$8000		;start of physical ROMHost_CA00_code_start 	equ	$CA00		;start of the $CA00 bank switched spaceHost_CA00_physical 	equ	ROM_start+$200	;the physical Host_ROM_code locationHost_CA00_test_physical	equ	ROM_start+$800	;the physical Host test ROM $CA00 image locationHost_CC00_test_physical	equ	ROM_start+$A00	;the physical Host test ROM $CC00 image locationHost_CC00_code_start	equ	$CC00		;start of host $CC00 'ROM' ($C800 'ROM'	space)Host_CnXX_pseudoROM	equ	$7B00		;start of cards	RAM area that appears at the host $CnXX	areaHost_CA00_pseudoROM	equ	$0200		;start of cards	RAM area that is host 'ROM' at $CA00-$CBFFHost_CC00_pseudoROM	equ	$7C00		;start of cards	RAM area that appears at host $CC00-$CFFECard_code_start		equ	$D000		;this will place the card's code in the top half of the 32K ROM		include	'Equates.aii'		include	'ZPageInit.aii'		include	'Host.aii'		include	'SelfTest.aii'	;fills up to Card_code_startCard_Code	PROC	ORG		Card_code_start		WITH	zero_page_template		IMPORT	CARomAdrs		IMPORT	Bootoffst		IMPORT	bootptch1		IMPORT	bootptch2		IMPORT	GOEntry		IMPORT	PDSPoffst		IMPORT	z_initlen				IMPORT	PwrONDiag		IMPORT	UserTest				ENTRY	InitCard		ENTRY	ColdStartup		ENTRY	CallCmd		ENTRY	SetCBPtrs		ENTRY	EnableGCR		ENTRY	Begin		ENTRY	Wait1MS		ENTRY	CRC_checkwords		ENTRY	Checksum_word				ENTRY	GetGCRAddr		ENTRY	ReadGCRData		ENTRY	WriteGCRData		ENTRY	SeekToCyl		ENTRY	TheFormat		ENTRY	FmtGCRTrk		ENTRY	TheVerify		ENTRY	CallCmd		ENTRY	DoInit				include	'Reset.Init.Idle.aii'		include	'DrivSubrs.aii'		include	'CalcSubrs.aii'		include	'ReadWriteBoot.aii'		include	'ReadWriteData.aii'		include	'StatusControl.aii'		include	'Format.aii'		include	'SmartBuss.aii'BRKSTALL	;if the code hits a BRK the light will flash with short flashes@00		LDX	#-1@01		INX@02		BIT	LEDon,x		LDY	#00@05		LDA	#00@10		DEC	A		BNE	@20@20		BNE	@10		DEY		BNE	@05		TXA		BEQ	@01		BRA	@00				DCB.B	($FFDA-Card_code_start)-(*-Card_code),$00 ;fill to endCRC_checkwords	DC.W	$0000		;check word for first 2K bytes of ROM		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next 2K		DC.W	$0000		; ..next to last 2K (30K bytes)Checksum_word	DC.W	$0000		;checksum word, use 16 bit add* vectors follow		DC.W	InitCard		DC.W	initcard		DC.W	BRKSTALL	print	Nowarn		ENDP	print	warn********************************** END OF SOURCE *********************************		END