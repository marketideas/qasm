		ejectalignpg3	EQU	(*-Card_code)	and $FF		DCB.B	$100-alignpg3,$00 ;align to next page* "SmartPort Communication Routines"************************************************** Divide7	   Do DIV and MOD 7 and	set auxptr**   This routine divides the bytecount by 7. The* quotient gives the number of groups of 7 bytes to* be sent, and the remainder gives the number of "odd"* bytes.  (Yee old long	division: shift	* sbc)**   Input: r1l,r1h <- #	of bytes to write*   Output:oddbytes	<- bytecount MOD 7*	   grp7cnt	<- bytecount DIV 7**************************************************Divide7		equ	*		stz	grp7cnt		ldx	#8		;8 bits	to shift		lda	r1H@loop		asl	r1L		;shift dividend	1 bit		rol	a		cmp	#07		;see if	high byte >= 7		bcc	@10		;if not	enough shift in	a zero		sbc	#07		;subtract a 7 and shift	in a one@10		rol	grp7cnt		;move carry into low bit		dex		bne	@loop		sta	oddbytes		rts*************************************************** RecvOnePckt	     Get a packet from bus resident*	      ______________________*  REQ ______|2			   5|__________*	 _________________________* /BSY _|1	     3		 4|___________**	 1) Drive signals ready	to send	packet*	 2) Host signals ready to receive data*	 3) Packet is transmitted (sync, mark, IDs, data, csum)*	 4) Drive signals packet dispatched*	 5) Host acknowledge receipt of	packet**	 The bytes are sent in slow mode (64 cycles/byte) and*  the timing is critical.  Branches which should not cross*  page	boundaries are marked.**	 Input:	buffer <- address where	packet guts left**	 Output: carry = 1 - handshake error*		 carry = 0 - bytes received*		 A <- error code if carry is set**     Preserves: none*****************************************************RecvOnePckt	equ	*		ldx	#7@01		stz	recvbuff-1,x	;clr recvbuff before read		dex		bne	@01		stz	csum		stz	error2		;clear error mask		jsr	enablechain	;enable	proper phases for rcv		tsx@03		stz	$100,x		;clear stack below here	as debg	assist		dex		cpx	#$E1		bcs	@03		bit	Q6H		;Prep for sense	mode* wait for BSY to go hi, signalling 'ready with packet & status'*		ldx	30		;wait max of 3 seconds for packet start@rdh0a		lda	#100		;100 Ms	= .1 seconds@rdh0b		ldy	#205		;205*10/2=1.00 Ms@rdh0c		bit	Q7l		;+04		bmi	@rdh1		;+06		dey			;+08		bne	@rdh0c		;+10 loop until	timeout		dec	a		bne	@rdh0b		dex		bne	@rdh0a		bra	@mke1@rdh1		lda	CA0on		;reply with request line hi* wait for a byte from Remote device or	timeout*		ldy	#00		;256*13/2 = 1.6	Ms for packet mark@rdh2		lda	Q6L		;+04 read sent byte		dey			;+06 decrement timeout counter@mke1		beq	@markerr	;+08 if	we timed out, indicate an error		cmp	#packetbeg	;+10 see if it's the begnin of a pkt		bne	@rdh2		;+13 if	not, keep looking		ldy	#7		;seven bytes of	packet header@rdh3		lda	Q6L		;if byte ready,	grab it		bpl	@rdh3		;ohterwise, wait til it	is		and	#$7f		;strip off MSB		sta	recvBuff-1,y	;  and save result IN REVERSE ORDER!		ora	#$80		;return	MSB for	csum		eor	csum		;calculate csum		sta	csum		dey			;decrement count		bne	@rdh3		;if not	done w/	info bytes, loop		lda	grp7cnt		bmi	@errG7		sta	grp7ctr		;leave grp7cnt unchanged* read in packet data**    Y = zero from above loop		ldx	oddbytes	;use oddbyte count for first pass		beq	@rd7grp@rdtop		lda	Q6l		;try to	read topbits		bpl	@rdtop		;if not	there, wait for	it		asl	a		;get rid of MSB		sta	topbits		;  and save result@rddata		lda	Q6l		;try to	read next byte of data		bpl	@rddata		;if not	there, wait for	it		asl	topbits		;get MSB		bcs	@save		;is msb	should be 1 then leave it		and	#$7F		;otherwise, clear it@save		sta	(r0),y		;store data in buffer		eor	csum		;calculate checksum		sta	csum		;		iny			;increment offset		bne	@noinc		;branch	if not a page boundary		inc	r0H		;if is a page boundary,	inc high byte@noinc		dex			;decrement 7 byte counter		bne	@rddata		;if not	7 bytes, keep going@rd7grp		ldx	#07		dec	grp7ctr		;decrement number of groups of 7		bpl	@rdtop		;keep going if not zero@docsum		lda	Q6l		;try to	read check sum		bpl	@docsum		;if not	there, wait for	it		sta	temp		;1st checksum byte  1 c6 1 c4 1	c2 1 c0@docsum2	lda	Q6l		;try to	read next csum byte		bpl	@docsum2	;if not	there, wait for	it		sec			;create	csum byte		rol	a		;c7 1 c5 1 c3 1	c1 1		and	temp		;c7 c6 c5 c4 c3	c2 c1 c0		eor	csum		;see if	it is the same as calulated one		bne	@csumerr	;if not, indicate an error* Get the packet end mark*@rdend		lda	Q6l		;read end mark		bpl	@rdend		;if not	there, wait for	it		cmp	#packetend	;is it the right byte		bne	@enderr		;if not, indicate an error* Wait for /BSY	to go low*		lda	Q6h		;@wtBSY		lda	Q7L		;read the sense	line		bmi	@wtBSY		;if hi,	wait for it to go low		lda	ca0off		;lower REQ		clc		rts@errG7		lda	#$8A		bra	@errxit@markerr	lda	#nomarkerr		bra	@errxit@enderr		lda	#noenderr		bra	@errxit@csumerr	lda	#badcsum@errxit		sta	error2		sec		rts***************************************************** SendOnePckt	      Send a CBUS packet***	 This routine sends a packet of	data across* the bus.  The	protocol is as follows:*	       ____________________* REQ ________|2		  5|_________*	  _______________________*/BSY ___|1	    3		4|__________**	 1) Device signals ready for data*	 2) Host signals data iminent*	 3) Packet is transmitted (sync, cmd mark, ids,	contents, csum)*	 4) Device signals packet received*	 5) Host finishes send data cycle**	 The bytes are sent in slow mode (64 cycles/byte)****************************************************SendOnePckt	equ	*		bit	Q7L		;insure	IWM read mode		bit	Q6L		;just to be sure* prep for the transmission		jsr	WritePrep	;primes	the pump for a write* enable PC chain		jsr	enablechain	;get Lirons listening* turn on the IWM		lda	enable1		;CBUS devices which enable?		lda	Select		;activate the drive enable* loop until the chain becomes unbusy		bit	Q6H		;set up	IWM to read sense (x11)		ldy	#bsyTO1		;each loop is 5	usec@ubsy1		lda	Q7L		;test if /BSY is hi		bmi	@chainunbsy	;if it is, then	we're ready		dey			;decrement timeout counter		bne	@ubsy1		;if we haven't timed out, keep trying		lda	#Busyerr		jmp	@errxit@chainunbsy	lda	CA0on		;raise REQ		ldy	#5		;sync +	packetbegin mark		lda	#$FF		;write anything	to prevent underrun		sta	Q7h		; (111)@lp1		lda	preamble,y	;get next sync byte@lp2		bit	Q6l		;see if	we're ready to write		bpl	@lp2		;if not, wait for it		sta	Q6h		;write the next	byte		dey			;decrement number in preamble		bpl	@lp1		;if there are more, keep going		lda	#0		sta	csum		;init checksum to 0* send destination ID		lda	unit_num	;get the unit number		ora	#$80		;set MSB		jsr	SendXByte	;* send source ID  (that's us ... we're an $80)		jsr	Send80		;* send over packet type	(command or data)		lda	Wpackettype	;		jsr	SendXByte	;* send the auxillary type byte (an $80 from this rec PC)		jsr	Send80* send status byte (null for us), and length bytes		jsr	Send80* send number of bytes in the packet		lda	oddbytes		ora	#$80		;set MSB		jsr	SendXByte		lda	grp7cnt		ora	#$80		;set MSB		jsr	SendXByte		ldy	#0		;set index into	buffer to 0		ldx	oddbytes	;load number of	oddbytes we have		beq	@dogrp7		;if no oddbytes, skip this part* now send the "oddbyte" part of the packet		lda	topbits		;topbits for oddbytes was done by prep		jsr	SendByte@lp3		lda	(r0),y		;get next byte of data		jsr	SendXByte	;  and send it across CBUS		iny			;increment offset into the buffer		dex			;decrement number of oddbytes left		bne	@lp3		;if not	done, continue@dogrp7		dec	grp7cnt		;decrement number of groups of 7		bmi	@sendcsum	;if done, go send checksum		lda	topbits1	;get precalculated topbits value		jsr	SendByte	;  and send it across CBUS		lda	#1		;start topbits of next 7 bytes		sta	topbits1		ldx	#7		;7 bytes / group@lp4		lda	(r0),y		;get next byte from buffer		jsr	SendXByte	; and send it across CBUS		lda	(r1),y		;look 7	bytes ahead		asl	a		; and put MSB into the carry		rol	topbits1	;  and put carry into LSB of topbits		iny			;increment buffer offset		bne	@noinc		;see if	we're on a page boundary		inc	r0H		;if end	of page, increment high	bytes		inc	r1H@noinc		dex			;see if	we're done with this 7		bne	@lp4		;if not, keep working on it		beq	@dogrp7		;if so,	see if there is	another	group* send the checksum@sendcsum	lda	csum		;create	1st checksum byte		ora	#$AA		; 1 c6 1 c4 1 c2 1 c0		jsr	SendByte	; and send it across CBUS		lda	csum		;create	2nd checksum byte		lsr	a		; move bits 1 to the right		ora	#$AA		; 1 c7 1 c5 1 c3 1 c1		jsr	SendByte	; and send it across CBUS		lda	#packetend	;send the end of packet	mark		jsr	SendByte	;* wait until write underflow@lp5		bit	Q6L		;wait for underflow		bvs	@lp5		;if hasn't occurred, wait for it		sta	Q6H		;back to sense mode*now wait til drive acknowledges receipt of the	packet or timeout		ldy	#bsyTO2		;load in timeout count@wtack		dey			;decrement timeout counter		bne	@chkline	;		lda	#noanswer@errxit		sec		bra	@done@chkline	lda	Q7L		;read sense line		bmi	@wtack		;if still hi, wait some	more		lda	#00		clc@done		bit	ca0off		;shut down		bit	Q6L		sta	error2		rts************************************ RcvCount***********************************RcvCount	equ	*		stz	temp		;clear temp		lda	grp7cnt		;get number of groups of 7		asl	a		;mult by 8 (temp = hi byte of result)		rol	temp		asl	a		rol	temp		asl	a		rol	temp		sec			;now subtract original value		sbc	grp7cnt		; to get original value	* 7		bcs	@nodec		dec	temp@nodec		clc			;now add number	of odd bytes		adc	oddbytes	;A <-  lobyte(grp7cnt*7	+ oddbytes)		bcc	@noinc		inc	temp		;temp <- hibyte(grp7cnt*7 + oddbytes)@noinc		ldy	temp		rtsSend80		equ	*		lda	#$80SendXByte	equ	*		pha			;save value		eor	csum		;add byte to checksum		sta	csum		pla			;restore value		ora	#$80		;set top bitSendByte	equ	*		bit	Q6l		;see if	IWM's ready for data		bpl	sendByte	;if not, wait til it is		sta	Q6h		;send the byte		rts************************************ WritePrep ** prepares data	for SendOnePack************************************WritePrep	equ	*		lda	bytecountL	;get number of groups of 7		sta	r1L		;  and number of oddbytes		lda	bytecountH	;		sta	r1H		jsr	Divide7		lda	r0L		;create	another	address		clc			; which	points		adc	#7		;  7 bytes ahead of		sta	r1L		;   buffer pointer		lda	r0H		;		adc	#0		sta	r1H		ldy	#0		;create	a byte of MSB's of the		jsr	CalcTopBits	; oddbytes to prime pump for write		lda	topbits1	;get the MSB's		sta	topbits		;  and save in another place		ldy	oddbytes	;now do	the same, for the 1st group		jsr	CalcTopBits	; of 7		rtsCalcTopBits	equ	*		ldx	#7		;repeat	for 7 bytes		lda	#1		;set first bit (becomes	bit 8 (MSB))		sta	topbits1	;@lp		lda	(r0),y		;get next byte from buffer		asl	a		;put its MSB in	the carry		rol	topbits1	;now rotate it into topbits		iny			;get offset to next position in	buffer		dex			;decrement our 7 byte counter		bne	@lp		;if not	done, keep going		rtsenablechain	equ	*		jsr	ClrPhases		lda	CA1on		lda	pulseon		rtsresetchain	equ	*		jsr	ClrPhases		lda	CA0on		lda	CA2on		lda	#80		;hard reset for	80 ms		jsr	WaitaMs		jsr	ClrPhases	;		lda	#05		;about 10 ms reset timeWait2Ms		equ	*		pha		jsr	WaitaMs		plaWaitaMs		equ	*		;+06 for jsr @lp		jsr	wait1MS		;+2043		dec	a		;+05		bne	@lp		;+08 =A*2052		rts			;+11 = A*2052+11Wait1MS:		pha			;jsr=6+3=09		lda	#203		;+02 (-02 on EQ	fall thru)@delay		dec	A		;(2)		BNE	*+2		;(3)		nop			;(2)		bne	@delay		;(3) = 10 * 203	= 2030		pla			;+13		rts			;+19 = 2049 cycles*     ;=(2049)/2.046 Mhz =1.0015 MsClrPhases	equ	*		bit	CA0off		bit	CA1off		bit	CA2off		bit	pulseoff		rtspreamble	equ	*		DC.B	packetbeg		DC.B	$FF,$FC,$F3,$CF,$3F*************************************** BldCmdPkt** Function : Build the CBcmdpkt	from the*	     input parameters and sets up*	     for call to SendOnePack**	    Translates extended	calls to*	    standard CBUS cmds	and ProDOS calls*	    into standard CBUS cmds*	     Translates	the parms into proper*	     positions for standard CBUS cmd**   Input : cmd	parameters*  Oubput : SPCmdPkt built*	  : R0 points at CBcmdpkt in zeropage*	  : bytecount contains an 0009***************************************BldCmdPkt	equ	*		lda	#cmdmark		sta	WpacketType	;setup for cmd pkt		lda	cmdmode		;with PD and XSP bits		and	#$0F		;		sta	CBcmd		;make calls Std CBUS cmds		ldy	msg		lda	paramcnt,y		and	#$0F		sta	CBPCount		stz	CBpktjunk		stz	CBpktjunk+1			ldx	#06@mvlp		lda	Cmdpkt6-1,x		sta	CBpktguts,x	;standard parms			dex		bne	@mvlp		;copy the stuff	from parm listSetCPlgth	equ	*		lda	#cmdlength		sta	bytecountl		stz	bytecounth		lda	#CBcmdpkt		sta	r0l		stz	r0h		rts************************************** SendDataPkt**************************************SendDataPkt	equ	*		jsr	SendnPkts		bcs	ComReset		rts************************************** ComReset** Builds an 'init' cmd packet and sends	to each	smartport device*************************************ComReset	EQU	*		lda	unit_num		pha		ldx	smartdev		lda	#$80		;warm reset please		jsr	AssignID	;reAssign CBUS ids (clobbers CBcmdpkt)		pla		sta	unit_num		sec		rts************************************************* SendCmdPkt**	Send a packet with retry and reset**********************************************SendCmdPkt	equ	*		lda	#01		;try just once incase it got reset by FDHD sense		jsr	SendaPkts		bcc	@ok		jsr	ComReset		jsr	BldCmdPkt	;rebuild cmd packet		lda	#100		jsr	SendaPkts			bcc	@ok		jsr	ComReset	;reset the buss		jsr	BldCmdPkt	;rebuild cmd packet		lda	#100		jsr	SendaPkts	;and try again@ok		rts*********************************************** SendnPkts** Send n packets ( short ones sent every 5 ms)**********************************************SendnPkts	equ	*		lda	#32		;short pkt retriesSendAPkts	equ	*		ldx	bytecounth		beq	@20@10		lsr	a		;256..511 = 127; 512-767= 63; etc		dex			;big packts retry fewer	times so		bne	@10		;that max time here is about 1 second@20		sta	errcnt@resend		jsr	SendOnePckt	;cmd pkts =.7 MS data pkts = 19	Ms		bcc	@exit		dec	errcnt		beq	@exit		;carry Still set		ldx	bytecounth	;short packet?		bne	@resend		;nope.		lda	#05		;delay 5 MS between small pkts		jsr	WaitaMs		;wait a	while before trying again		bra	@resend@exit		rts************************************************* RecvPacket**	Recv a packet with retry and reset**********************************************RecvPacket	equ	*		lda	#05		sta	errcnt		;set retry at 5	(unless	formatting)		lda	msg		; get the command we are waiting for		cmp	#format		;is it a format?		bne	@reread		;-no, 5	is enough		lda	#60		;-yes		sta	errcnt		;set retry while formatting to 60 (approx. 3 minutes)@reread		jsr	RecvOnePckt		bcc	@ok		jsr	Wait1MS		sec		bit	ca0off		;reset REQ (handshake) to low		bit	Q6L		;back into read	mode		dec	errcnt		;rereads exhausted?		bne	@reread@ok		rts************************************************************************ FixStatus**	This routine adds 1 zero byte in the middle of the Stardard*	Smartport status call result data for an Extended status call**	INPUT:	status data resides at wrblkadd*		X must be preserved***********************************************************************FixStatus	ldy	#25@loop		lda	wrblkadd-1,y	;24,23,22,...05,04 = y-1		sta	wrblkadd,y	;25,24,23,...06,05 = y		dey		cpy	#04		bne	@loop		stz	wrblkadd+4	;put in the Ray Montagne memorial zero 		inc	xfrcnt		;add 1 to the result length		rts				eject*************************************** DoRemote is the CBUS driver entry**  Only	called for Remote units ***************************************DoRemote	equ	*		lda	#CBusSlow		jsr	SetIWMMode	;set IWM mode to slow (250Khz I/O)		stz	datastat	;zero the error	flag		jsr	BldCmdpkt	;do all	the stuff		jsr	ClrPhases	;get ready to send		jsr	SendCmdPkt	;send the CMD packet (255 times)		bcs	@buserr1		ldx	msg		;get flags again		bit	paramcnt,x	;		bpl	@getstat	;if no data to send, read data or status		cpx	#write		;need to check xfrcnt?		beq	@senddata	;no.		lda	xfrcnt+1	;byte cnt < $500		cmp	#$05		bcc	@senddata	;yes. ctrl/Writebytes lgth ok		bit	paramcnt	;sev (status entry has $40 bit on)		ldy	#00		;null reply		lda	#BadParm	;tell em its junk		bra	@errxit		;set error then	reply@senddata			lda	#wrblk		sta	reply		; to get data from host@wtld1		lda	reply		;wait til write	block is loaded		bpl	@wtld1		;		ldx	xfrcnt		;input for CTRL	or WriteBytes!		ldy	xfrcnt+1		lda	msg		;WriteBlk		cmp	#write		;?		bne	@setcnt		;no. Ctrl or WriteBytes!		ldy	#>512		;otherwise, 512	bytes /	block		ldx	#<512@setcnt		sty	bytecounth	;		stx	bytecountl	;@dosend2	lda	#datamark	;indicate a data packet		sta	WpacketType	;		jsr	ClrPhases	;prepare to send		stz	r0L		;get address of	buffer in r0		lda	#>wrblkadd		sta	r0H		jsr	SendDataPkt	;send the data packet (63 times)@buserr1	bcs	@buserr@getstat	equ	*		stz	r0L		;get address of	buffer in r0		lda	#>wrblkadd		sta	r0H		;		jsr	RecvPacket	;try recv 5 times		bcs	@anerr		jsr	RcvCount	;convert rcv pkt size		sta	xfrcnt		sty	xfrcnt+1@rout		ldy	#00		ldx	msg		bne	@noFixup		bit	cmdmode		;was this extended Status call?		bvc	@noFixup		jsr	FixStatus	;add the stupid 4th byte to block count@noFixup	cpx	#10		clv		bcs	@errxit		bit	paramcnt,x	;reply needed?		bvc	@rdone		;nope		ldy	#wrblk@rdone		lda	datastat	;from recvd packet hdr status@errxit		sta	error		;gotta set error before	reply!		bvc	@rtn		sty	reply		;reply if status,read,readbyts @rtn		jsr	ClrPhases	;leave em all off 		clc			;normal	return		rts@anerr		equ	*		cmp	#nomarkerr	;no response error?		beq	@buserr		;yes.		lda	#ioerror		bra	@zerr@buserr		lda	#BusErr		;indicate bus error in data stat byte@zerr		sta	datastat		bra	@routparamcnt	equ	*		;msb set for WritBlk,Ctrl,WritByt 		DC.B	$43,$43,$83,$01,$83		DC.B	$01,$01,$01,$44,$84*********************************************************************** * AssignID** Assigns the CBUS ID numbers to the remote* units	attached (if any ) ** Returns in A the number of drive found** Called from InitCard (cold and warm) and ComReset** INPUT	:	A = 00 (cold) / $80 (warm) reset flag*		X = first unit number to assign if units exist** OUTPUT:	A = number of units assigned (0/1/2)*		flags set per contents of A ***********************************************************************AssignID	equ	*		sta	CBpktguts+1	;standard cmds shifted 1 later		phx				lda	#00@zapoldones	sta	unittype-1,x	;zero remaining unittype		inx		cpx	#maxUnits	;		bcc	@zapoldones	;Smart Units might have thier only power switches!!!				bit	DeSelect	;remove drive enables so ISM switching leaves em off		lda	#-1		sta	unit_num		jsr	Disabl35	;remove	ENBL35 to enable A35 daisychains		jsr	EnableGCR	;make sure the clock is 7.83Mhz		lda	#CBusSlow	;set IWM for CBUS communication		jsr	SetIWMMode		plx		stx	unit_num	;set unit num for SendOnePckt		jsr	resetchain	;				jsr	ClrPhases				stz	drive		; counter for smart drives* send an ID for the next device in the	chain@moreunits	lda	#cmdmark		sta	WpacketType	;std init's only		lda	#init		;send init command to set unit numbers		sta	CBcmd		lda	#02		sta	CBPcount	;send a	'init' pcount on Reset Init		stz	CBpktguts		stz	CBpktguts+2		jsr	SetCPlgth	;setup bytecount,a ptr and drive		jsr	SendOnePckt	;send INIT command pkt (without	retry)		bcs	@exit		;branch	if some error (no ACK)		stz	r0L		lda	#>wrblkadd		sta	r0H		jsr	RecvOnePckt	;get return status (without retry)		bcs	@exit		;assume	nomarkerr due to bad datastat		ldy	unit_num	;add SmartPort devices to list of units		cpy	#maxUnits+1		bge	@norecord	;unit table is of limited size		lda	#UTremote	;Remote	CBUS device 		sta	unittype-1,y	;		lda	#00		sta	unitmode-1,y	;-1 cuz unit numbers are 1 based@norecord	equ	*		inc	drive		;count number of SmartDevs 		inc	unit_num	;tell SendOnePckt next unit to init					lda	datastat	;see if	'last device' status		beq	@moreunits	;no. assign ID to all of em 		lda	drive		cmp	#MaxSmarts+1	;is this the third UniDisk3.5 or other Smart unit?		bcc	@exit		;nope.		lda	#02		;yep.  only get two of these!		sta	drive				@exit		jsr	ClrPhases	;reset all for A35 operns		bit	DeSelect	* load result for caller and set status flags		lda	drive		;return number of smart devs inited (0/1/2)		rts