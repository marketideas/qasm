		eject*	'Drive Control Subrtns'*********************************************** MountVol** Assumes unit x is enabled and	vol online***********************************************MountVol	equ	*		php			;save callers n,v,z,c status		pha			;save callers error code 		stx	drive		;save which drive		jsr	UnkVolX		;clear it state	to Online unknown volume type		lda	#DskIn		jsr	ReadBit		;make sure he didn't lie 		bcc	@isOnline		pla		lda	#Offline		bra	@errexit	;you can't trust everyone@isOnline	lda	#UTfdhd		bit	UnitType,x		beq	@90			lda	#MediaAdr	;Since unit is FDHD		jsr	ReadBit		;  sens the media type		bcs	@90		;not HD media so must read 1Meg media		lda	#$80		sta	twosided,x		lda	#UMmfmHD+UMdsw+UMnotmr		ora	UnitMode,x	;incase liron emulation bit is set		sta	UnitMode,x					lda	volsts,x		and	#-1-VSoffline	;cancel	offline	state		sta	volsts,x		jsr	Recal		jsr	EnableMFM	;enable MFM FClk etc		jsr	U35MtrOn		stz	side		stz	cyl		jsr	WaitReady	;be sure drive is ready		lda	#4		sta	errcnt		;retry count for each mode to try@searchlp	stz	side		;always	try side 0		jsr	GetAddr		;for now its simple		bcc	@foundHDvol		lda	error2		bit	#adrerror	;bit slip/check	sum error?		bne	@retry		;yes. so try again		bit	#cylerror	;not on	the right track?		beq	@retry		lda	CylFnd		sta	cyl		;make where I am where I want to be@retry		dec	errcnt		bne	@searchlp		bra	@errxit		;return an ioerror if media not readable		@foundHDvol	jsr	DeSelectISM	;switch back to IWM side after mounting		ldx	drive		jsr	EnblnSens	;set volsts when found		ldy	#HD1440K2		lda	TotBlks,y		sta	TotBlksL,x		lda	TotBlks+1,y		sta	TotBlksH,x	;setup block count for status etc		sty	voltype,x	;record the voltype		clc@80		pla		plp		rts* now have 1Meg media to read and survery for 1meg volume type@90		jsr	Recal		;recal to trk0		jsr	U35MtrOn	;enable	units motor (wait iff)		stz	side		ldx	drive		;go find an address mark in some mode		jsr	SurveyLcl	;& IFF set voltype,volmode,Totblks,etc		bcc	@80		;I found something@errxit		pla		lda	#ioerror	;Mounted but can't read => ioerror @errexit	plp		sec		rts************************************************************************ Unmount Volume *	INPUT	X = drive (0,1)** Must preserve	X & Y**********************************************************************UnMountX	equ	*		lda	#VSoffline	;assume	nothing	else (re next DIP Chuck)		sta	volsts,x		UnkVolX		stz	totblksl,x	;unknown blkl		stz	totblksh,x	;unknown blksh		lda	unitmode,x		and	#UMudemul		sta	unitmode,x		lda	#$FF		sta	curcyl,x	;zap the cur track		stz	voltype,x	;unknown voltype		phx		phy		jsr	ClrCacheX			ply		plx		rts******************************************************** U35MtrOn*******************************************************U35MtrOn	equ	** First	check if the motor is on already		lda	#runmotor		jsr	ReadBit		bcc	@20		;motor still/already on** Now the drive mode must be checked and set if its wrong*			JSR	SetDrivMode** It wasn't.  Turn it on now.  Control lines are already set.*		LDA	#runmotor		JSR	WriteBit* Has the 1st MotorON chucking time been insured?		ldx	unit_num	;by now	this can only be 0/1		lda	#VSchukwait		bit	volsts,x	;has this been done?		bne	@10		;yes		ora	volsts,x		sta	volsts,x		lda	#200		;400+100=500 		jsr	Wait2Ms		;wait 500 ms the first time@10		lda	#100		;delay 100 ms so I don't		jsr	WaitaMs		;seek during motorON inrush@20		rts***********************************************************************	SetDrivMode** Only called from MotorOn if motor is off ***********************************************************************SetDrivMode	equ	*		ldx	unit_num		lda	#UTfdhd		bit	unittype,X	;is this an FDHD unit?		beq	@doNothing	;nope so it can't do MFM 		LDY	#DrivMFMadr	;assume MFM mode set (6)		lda	#UMmfmHD+UMmfmDD ;is volume either HD or DD		BIT	unitmode,X	;is volume MFM HD media?		BNE	@itsMFM		;YES!		INY			; GCR Mode (7)@itsMFM		LDA	#MFMmodeAdr	;should do this in SensNChk for FDHD's		jsr	ReadBit		;read the drive's current mode		bcs	@drivIsMFM	;sense drive Mode (1 = mfm mode)@drivIsGCR	CPY	#DrivGCRadr	;is it in the right mode?		BEQ	@doNothing	;yep		BRA	@setMode@drivIsMFM	CPY	#DrivMFMadr	;is it in the right mode?		BEQ	@doNothing	;yep.@setMode	TYA			JSR	WriteBit	;send cmd to set FDHD mode		LDA	#MFMmodeAdr@doNothing	RTS********************************************************;; SendSteps;	 Steps the head	the given number of tracks;	 Then wait 155 usecs after last	step ;	      until /READY status becomes valid;;	 x - number of tracks to step;********************************************************SendSteps	equ	*		lda	#onestep	;values	to cause a one track step		jsr	WriteBit	;send values to	Sony		lda	#instep		;see if	still in step		jsr	WaitHi		;wait until sense bit is hi		dex			;decrement track counter		bne	SendSteps	;if more, step to next track* Now delay 155	usecs until Ready becomes valid		ldx	#62@20		dex			;(2)		bne	@20		;(3) 5*62/2= 155 usecs after seek		rts**********************************************************;; Seek;	 This routine tries to get to the cylinder in (cyl) on; the drive in (drive).	 If current cylinder for that drive is negative; then the current cylinder is not known and we	must recalibrate; to track 0.  The number of tracks to travel and the direction	are then; calculated and the head is then moved	to cyl by calling SendSteps;* This routine may be called with or without the motor running!;;	 input:;	   cyl - cylinder to find;	   curcyl - current cylinder where head	resides;	   drive - drive we shold be seeking on;;     OUTPUT : Carry Set if Unable to seek / recal;;	       Carry Clr if OK then;		EQ set if no seek required;		NE set if seek was done	and WaitRdy is needed****************************************************************Seek		jmp	SeekHookSeekToCyl	ldx	unit_num	;use drive as an offset	to curcyl		lda	curcyl,x	;get current cylinder for this drive		bpl	@10		;if positive, then believe it		jsr	recal		;otherwise, reset head to track	0		bcs	@90		;recal didn't find TK0 sense@10		equ	*		ldx	unit_num	;get drive number again		lda	curcyl,x	;get current cylinder again		sec			;set carry for subtraction		sbc	cyl		;subtract desired cylinder		beq	@30		;already on the	right cylinder		ldy	#dirout		;assume	dir0 will be the direction		bcs	@20		;we did	want 'out' direction 		ldy	#dirin		;no, we	want 'in' direction		eor	#$ff		;negate	a to make it positive		adc	#1		;carry always clear@20		tax			;save #	of tracks to move in x		tya			;get desired direction in a		jsr	WriteBit	; and send it to Sony		jsr	SendSteps	;now step # of tracks in x		ldx	unit_num	;get offset to current cylinder		lda	cyl		;we should be on this cylinder		sta	curcyl,x	;  so save it for future reference		lda	#01		;set NE	status true; need WaitRdy@30		clc			;indicate no error@90		rts********************************************************;; Recal:;	 This routine moves the	head to	track 0	by; sending several clumps of steps to the SendStep routine; and then checking if track 0 has yet been reached. If; we have stepped as many times	as there are tracks then; something is wrong and we indicate an	error.;* This routine may be called with or without the motor running!;;	 destroys:;	    x,y, and a;	 output:;	    c =	1 - *error* could not sense track 0;********************************************************Recal		equ	*		stz	error2		;clear error mask		lda	#dirout		;point in direction of track 0		jsr	WriteBit	;and send to Sony		lda	#istrack0	;already on trk0?		jsr	ReadBit		;ask the drive		bcc	@done		;yep. don't step it		ldy	#5		;5*16 =	80 tracks@loop		ldx	#16		;number	of tracks to step each try		jsr	SendSteps	; do steps* Can't have jsr WaitReady here since motor may not be running!!!		ldx	#16@wloop		equ	*		lda	#07		jsr	WaitaMS		;wait 7	ms for each try	 		lda	#istrack0	;are we	on track 0		jsr	ReadBit		;...ask drive		bcc	@done		;if c=0	then we've reached trk zero		dex		bne	@wloop		dey			;otherwise, step a little more		bne	@loop		lda	#rcalerror		tsb	error2		;remember why		lda	#-1		sec			;set carry indicating an error		bra	@exit		;mark unk cyl for unit@done		lda	#00		clc@exit		ldx	unit_num	;set current cylinder to 0		sta	curcyl,x	;		rts;***********************************************; SelHd:;	 Select	the head using variable	'side';;***********************************************SelHd		equ	*		lda	side		;get side number		beq	SelSide0	;if not side 1, go get side 0************************************************ SelSide1************************************************SelSide1	sta	Hedsel_one	;it's now side 1		rts************************************************** SelSide0 **************************************************SelSide0	sta	Hedsel_zero	;it's now side 0		rts		eject	if 0	then***********************************************************************	DeBug SWIM State for analyzer tracing**********************************************************************DeBugSWIM	equ	*		lda	#$38		;turn off action and write in case ISM side		sta	IsmMode0W	; also is an IWM CA3off		lda	#$F5-256		sta	IsmPhaseW	; also is an IWM CA2off (but as a Write)		cmp	IsmPhaseR	; also is an IWM Q6L ref		bne	@IWM		lda	#$F4-256		sta	IsmPhaseW		cmp	IsmPhaseR		bne	@IWM		lda	IsmStatsR		sta	temp		lda	IsmSetupR		sta	CurISMsu		rts@IWM		bit	q7l		bit	q6l		bit	DeSelect		bit	q6h		lda	q7l		;read IWM status register		sta	CurIWMode	;save it		rts	endif*	    'MFM Mode control Routines'**************************************************************** Enter	setIWMmode with	A set to the IWM mode desired**     INPUT :	A = needed IWM mode*    OUTPUT :	Y = input A reg*    Destorys	A*    Preserves	X***************************************************************SetIWMMode	EQU	*		BIT	Q7L		; belt and suspenders 		TAY			;Preserve the mode byte 		BIT	DeSelect	;deactivate the	enables		BIT	Q6H		;setup for StatusRd and	ModeWr@05		LDA	Q7L		; get the status reg		AND	#$20		BNE	@05		;wait for enable's to drop		BRA	@20@10		STY	Q7H		;write the mode	register@20		TYA		EOR	Q7L		;compare with low 5 bits of status reg		AND	#$1F		;mask off upper	3 bits		BNE	@10		;try again if it doesn't match		LDA	#$40		TRB	MFMflag		;mark ISM off		LDA	Q6L		;return	to read	state		RTS***********************************************************************   Setup MFM Decoding parameters**   Assumes that CYL has been determined from blocknum***********************************************************************SetMFMParms	EQU	*		LDA	CYL		;(in the range 0..79)		CMP	#80		BCC	@ok		LDA	#00		;higher	is unknown so assume a RECAL will occur@ok		LDX	#-2@loop		INX		INX		CMP	mfmCylZones,X		BCS	@loop		LDA	mfmCylZones+1,X ;get the parmamter group offset		TAX		LDY	#5		;retry count@1		LDA	#$18		STA	ISMMode0W	;clear 0->WRITE	& ACTION (reset	parm adrs to zero)		PHX			;save starting parameter offset@rLoop		DEX		LDA	mfmParams,X	; x starts at parameter	zero		BEQ	@done		CMP	ISMParmsR	; must read parameters in sequence		BNE	@Wparms		BRA	@rLoop@done		PLX		CLC		RTS			;Parameters all	matched	so It worked@Wparms		LDA	#$18		STA	ISMMode0W	;reset param auto inc ctr to zero		PLX		PHX@wLoop		PHA		PLA		DEX			;delay a few cycles		LDA	mfmParams,X		BEQ	@Wdone		STA	ISMParmsW	;have to write all 16 parms in sequence		BRA	@wloop		;nope@wDone		PLX			;get index back	for retry &/ exit		DEY		BNE	@1		;so go back and	read em	all again or retry		SEC		RTSmfmCylZones	DC.B	40,17		DC.B	80,34		DC.B	80,00		DC.B	80,00mfmParams	DC.B	0		DC.B	(31-2)*2+1	;[F] Time1 = 31.5		DC.B	$57		;[E] Early/Norm	= $57		DC.B	(15-2)*2+1	;[D] Time0 = 15.5		DC.B	$97		;[C] Late/Norm = $97		DC.B	(14-2)*2+1	;[B] LLS = 14.5		DC.B	(14-2)*2+1	;[A] LLL = 14.5		DC.B	(25-2)*2+1	;[9] LSS = 25.5		DC.B	(25-2)*2+1	;[8] LSL = 25.5		DC.B	(15-2)*2+1	;[7] CSLS = 15.5		DC.B	(15-2)*2+1	;[6] RPT = 15.5		DC.B	(14-2)*2+0	;[5] SLS = 14.0		DC.B	(14-2)*2+0	;[4] SLL = 14.0		DC.B	(25-2)*2+0	;[3] SSS = 25.0		DC.B	(25-2)*2+0	;[2] SSL = 25.0		DC.B	65		;[1] Mult = 65		DC.B	(15-3)*2	;[0] Min = 15.0		DC.B	00		DC.B	(31-2)*2+1	;[F] Time1 = 31.5		DC.B	$57		;[E] Early/Norm	= $57		DC.B	(15-2)*2+1	;[D] Time0 = 15.5		DC.B	$97		;[C] Late/Norm = $97		DC.B	(14-2)*2+1	;[B] LLS = 14.5		DC.B	(14-2)*2+1	;[A] LLL = 14.5		DC.B	(25-2)*2+1	;[9] LSS = 25.5		DC.B	(25-2)*2+1	;[8] LSL = 25.5		DC.B	(15-2)*2+1	;[7] CSLS = 15.5		DC.B	(15-2)*2+1	;[6] RPT = 15.5		DC.B	(14-2)*2+0	;[5] SLS = 14.0		DC.B	(14-2)*2+0	;[4] SLL = 14.0		DC.B	(25-2)*2+0	;[3] SSS = 25.0		DC.B	(25-2)*2+0	;[2] SSL = 25.0		DC.B	65		;[1] Mult = 65		DC.B	(15-3)*2	;[0] Min = 15.0************************************************************************ Startup ISM side of SWIM*   *   Assumes that SWIM is in IWM mode when called***********************************************************************StartupISM	EQU	*		stz	MFMflag		stz	CurISMsu		JSR	SelectISM				LDA	#%00000000	;		sta	IsmSetupW	;de-assert EN3.5 at reset or pwron		sta	CurISMsu	;record ISM setup reg value				LDA	IsmSetupR		LDA	#$38		STA	IsmMode0W	;0-> WRITE & ACTION bits and 8M FCLK (HDSEL=0)		LDA	#$00		STA	IsmConfgW	;config	timer for 8Mhz	FCLK				LDA	IsmStatsR			lda	IsmPhaseR		ora	#$F0		sta	IsmPhaseW	;make sure the phases are enabled as outputs		JSR	SetMFMParms	;do this at pwron/Reset once		jmp	DeSelectISM	;switch back to IWM mode************************************************************************ Select ISM mode of SWIM*   *   Assumes that SWIM in in IWM mode when called *   It preserves ***********************************************************************SelectISM	EQU	*		phx		BIT	MFMflag		BVS	@alreadyISM		bit	q7l		;insure read mode		bit	q6H		;setup for write to IWM	mode Reg		lda	q7l		;read the status register first		pha			;save it for drive enable restore		BIT	DeSelect	;disable the IWM drive enable (may starts 3.5 Drive's Timer!)		and	#$1F		ora	#$40		;add the ISM bit to IWM mode reg value		STA	Q7H		EOR	#$40		;turn the bit off		STA	Q7H		; continue the tap dance		EOR	#$40		STA	Q7H		STA	Q7H		; finish the fast slow fast fast dance steps		LDA	#$40		TSB	MFMflag		pla		bit	#$20		;was drive enabled at entry?		beq	@no@alreadyISM	lda	IsmStatsR		and	#%110		cmp	#%110		bne	@10		lda	#%110		sta	IsmMode0W	;clear both if both enables are on@10		LDX	unit_num		cpx	#02		bcs	@no		lda	#%00000110		sta	IsmMode0W	;clear both drive bits from prior use		LDA	DrivSelBit,X		STA	IsmMode1W	;select	the ONE proper drive		LDA	#$80		STA	IsmMode1W	;Select the proper drive so it can't timeout@no		plx		LDA	IsmStatsR	;re read for debugging analyzer		RTSDrivSelBit	DC.B	02		;enable	for drive 1 ( x = 0)		DC.B	04		;enable	for drive 2 ( x = 1)************************************************************************ DeSelect the ISM mode	of SWIM**   Assumes that SelectISM above has been called and that SWIM*   is still in	ISM mode***********************************************************************DeSelectISM	EQU	*		LDA	ISMStatsR	;get status 		PHA		LDA	#%10011110	;reset DrvEnable,Write,Action bits		STA	ISMmode0W		LDA	#$40		STA	ISMmode0W	;disable ISM side with this write		pha		pla			;delay a few cycles		BIT	Q7L		BIT	Q6L		;insure IWM back into read mode		LDA	#$40		TRB	MFMflag		;mark ISM off		PLA		BMI	@20		;Drive enable was asserted so restore it		phx		ldx	unit_num		cpx	#02		bcs	@10		bit	enable1,x	;select the proper drive even if not enabled@10		plx		rts		@20		phx		ldx	#00		bit	#$04		;is it drive 2 that was enabled?		beq	@30		ldx	#01		;yep@30		bit	enable1,x	; enable proper drive ;		plx		bit	Select		; activate the enable line		rts***********************************************************************   Select IWM mode if ISM is enabled**********************************************************************SelectIWM	BIT	MFMflag		;is ISM	enabled?		BVC	@exit		JSR	DeSelectISM@exit		RTS***************************************************** Enable35** Enable35 and Disabl35	need to	keep a history bit* and only switch to ISM mode when /ENBL35 is * not in the desired state.*****************************************************Enable35	equ	*		pha		lda	#%00000010		bit	CurISMsu	;is EN35 already asserted?		bne	@90 		;yep. so do nothing		jsr	SelectISM	;switch	to ISM side		lda	#%00000010	;set bit 1 for /ENBL35 low		ora	IsmSetupR	;note: pin level is opposite of	bit		sta	IsmSetupW		sta	CurISMsu		cmp	IsmSetupR		jsr	DeSelectISM	;deselect ISM mode@90		pla		rts******************************************************* Disabl35* Enable35 and Disabl35	need to	keep a history bit* and only switch to ISM mode when /ENBL35 is * not in the desired state. *******************************************************Disabl35	equ	*		pha		lda	#%00000010		bit	CurISMsu	;is EN35 de-asserted already?		beq	@90		;yep so exit		jsr	SelectISM	;switch	to ISM side		lda	#%11111101	;note: reg bit is opposite of pin		and	IsmSetupR		sta	IsmSetupW	;set bit 1 for /ENBL35 high		sta	CurISMsu	;save for history		cmp	IsmSetupR		jsr	DeSelectISM	;deselect ISM side@90		pla		rts*********************************************************************** ENABLE MFM modes on ISM side**********************************************************************EnableMFM	equ	*		lda	#$80		tsb	MFMflag		;b7 = mfm  		lda	#$20		;test the drive type bit (set if in MFM mode)		bit	CurISMsu		bne	@90		;already did this		jsr	SelectISM		lda	#$20		sta	IsmMode1W	;switch to 15.6M FClk (sets just 1 bit!)		ora	IsmSetupR				sta	IsmSetupW	;switch to IBM drive type for MFM I/O		sta	CurISMsu		lda	#$40		sta	IsmConfgW	;set timer for 15.6M FCLK				jsr	DeSelectISM@90		rts		*********************************************************************** ENABLE GCR modes on ISM side (drive type and clk switch to GCR states)**********************************************************************EnableGCR	lda	#$80		trb	MFMflag		;b7 = mfm 		lda	#$20		bit	CurISMsu	; is drive type set for GCR I/O?		beq	@90		;yep. don't need to do this		jsr	SelectISM		lda	#$20		sta	IsmMode0W	;switch to 7.8M FClk (clrs just 1 bit!)		lda	IsmSetupR		and	#%11011111		sta	IsmSetupW	;switch to Apple drive type for GCR I/O		sta	CurISMsu		lda	#$00		sta	IsmConfgW	;set timer for 7.8M FCLK				jsr	DeSelectISM	;switch back to IWM mode@90		lda	#GCRmode		jsr	SetIWMMode		rts****************************************************** DTCancel* * Drive	Timer Cancel** This routine performs	the reset of /ENBL35 before* removal of Drive enable to cancel the drive timer**    INPUT :  x	= drive	to cancel (0,1)******************************************************DTCancel	equ	*		cpx	#02		bcs	@90		;invalid or unknown drive		stx	unit_num		jsr	SelectISM	;switch	to ISM side		lda	DrivSelBit,x			ora	#$80		sta	IsmMode1W	;assert the proper drive enable		lda	#50@20		dec	a		bne	@20		;delay a while				lda	IsmSetupR		and	#%11111101	;bit is	0 for /ENBL35 high		sta	IsmSetupW	;de-assert /ENBL35		sta	CurISMsu		lda	#25@30		dec	a		bpl	@30		;delay a bit for drive gate array to act		jsr	DeSelectISM	;switch back to IWM side@90		rts********************************************************;; sdclines;	 This routine sets corresponding pulse bits as defined; by parameter in reg a.;	  A - 4	bits indicate how to set ca1,ca0,sel,ca2;					 b3  b2	 b1  b0;********************************************************sdclines	equ	*** MUST clr CA0 and Set CA1 before HDSEL changes 1->0* THIS ORDER IN WHICH THIS CODE CHANGES THE PHASE LINES*	IS REQUIRED BY THE DRIVE DON'T REORDER IT!				bit	ca0off		bit	ca1on		bit	pulseoff				bit	ca2off		;assume	lsb clear		lsr	a		;put lsb in carry bit		bcc	@10		;if it was clear, do nothing		bit	ca2on		;otherwise, turn it on@10		lsr	a		;put head number in carry		bcc	@20		;if carry clear, select side 0		bit	Hedsel_one	;otherwise select side 1		bra	@30@20		bit	Hedsel_zero	;select side 0@30		lsr	a		;should	ca0 remain set		bcc	@40		;if lsb	is clr,	it stays off		bit	ca0on		;otherwise, turn it on@40		lsr	a		;should	ca1 remain set		bcs	@50		;if lsb	is set,	it stays on too		bit	ca1off		;otherwise turn	it off@50		rts********************************************************;; WriteBit ;	 This routine writes commands to;	 the Apple 3.5 and Apple 3.5HD drives;	 input:;	  A - 4	bits indicate how to set ca1,ca0,sel,ca2;					 b3  b2	 b1  b0;	 preserves : x********************************************************WriteBit	equ	*		jsr	sdclines	;set the lines for command in a		bit	pulseon		;turn on pulse to send command		bit	pulseoff	;turn off pulse	(2usec later)		rts*********************************************************;; ReadBit ;	 This routine reads one	of 16 status bits from;	 the Apple 3.5 and Apple 3.5HD drives;	 input:;	  A - 4	bits indicate status to	read ca1,ca0,sel,ca2;					      b3  b2  b1  b0;;	returns	the status bit in the carry;	    carry set if bit = 1;	    carry clear	if bit = 0;;	 preserves : x********************************************************ReadBit		equ	*		jsr	sdclines	;set up	lines for command in a		bit	Q6h		;read status register (x1x)		lda	Q7l		; (01x)		and	#$80		;keep only the data bit		asl	a		;b7 (where the data bit	is) to carry		rts********************************************* WaitRdyTO*      This routine waits unit an Apple	3.5* drive	/READY sense bit indicate the drive * is ready or until the	timeout	expires**     Input: proper drive selected and enabled*	     and motorON and/or	seek cmd sent**    Output: Carry clr if ready*	     Carry Set if Timeout*********************************************WaitRdyTO	equ	*		lda	#ready		jsr	Readbit		bcc	@itis		ldx	#>1000		;1000*.001=1 second		ldy	#<1000@10		lda	#146		;146*14=2046 = 1Ms		sta	delayctr@20		bit	Q7L		;+04		bpl	@30		;+06		dec	delayctr	;+11		bne	@20		;+14		dey		bne	@10		;		dex		bne	@10		sec			;a timeout!		rts@30		clc@itis		rts;**********************************************; WaitReady;	 This routine waits until an Apple 3.5 drive ;	 ready line indicates that the drive is	ready.;;**********************************************WaitReady	equ	*		lda	#ready		;now wait til disk is readyWaitLow		equ	*		jsr	ReadBit		;		bcc	@20		;it is low@10		lda	Q7L		and	#$80		bmi	@10		asl	a		;result	is alway clr@20		rts* WaitHiWaitHi		equ	*		jsr	ReadBit@10		lda	Q7L		and	#$80		bpl	@10		asl	a		;result	is always set		rts;******************************************************; ChkEject:;	 ChkEject is called at about .45 sec rate in the ;	 command wait loop to check to see if local A3.5 ;	 disk drives have been ejected.;;	 eats :	A,X,Y;   ;******************************************************ChkEject	equ	*		ldx	#$00		;start with disk 0		lda	unittype,x	;are there any local A3.5 drives?		bmi	@30		;no local drives!		beq	@30		;no units at all!!		jsr	Enable35	;assert /EN35 if needed@nxtdrv		ldy	#10@dly		dey		bne	@dly		;25us delay		jsr	EnblnSens	;enable drive and see if disk is in		bvc	@dskok		;if online then	do nothing		jsr	UnMountX	;unmount volume	in that drive@dskok		inx		cpx	#01		;		bne	@20		;max of	2 locals		lda	unittype,x	;is 2nd	unit local/remote		bmi	@20		;remote		bne	@nxtdrv		;local@20		dex		jsr	DTCancel	;cancel	the drive timer@30		rts* "Enable & Check Drive	state"****************************************************** EnblnChk  (Enable and	Check local drive)**      This routine checks the sense status of the * drive	and returns priority encoded errors as follows:** If vol offline * Then unit unmounted and Offline error	returned.* If online but	not after eject * Then IF voltype is UNKNOWN *      Then return WP error iff	but fake 'swapped' status.* If vol swapped * Then clear eject latch : IF Extended SP cmd *			   Then	return Disk Switched error.* Else return no error with WritProt status in A-reg.**   Input : X -	unit to	be enabled  (X = 0/1) * Preserved: X	  Destoryed :A,Y**  Output : case description c	 v   n	  A*	    vol	is offline   1	 1   x	 $2F (eject latch left alone)*	    vol	is switched  1	 0   1	 $2E (XSP cmd :ejct ltch clr)*	    vol	is online    0	 0   1	 $00 (StdSP : ejct ltch	clrd)*	    vol	is online    0	 0   0	 $00  (everything is ok!)*	    vol	is writ	Prot 0	 0   1	 $2B (swaped WP	vol: ejct clr)*	    vol	is writ	Prot 0	 0   0	 $2B (known WP volume)*	    volstat,x is set per drive status**	    ! the N bit	used by	caller to force	mountvol*	    ! the C bit	used by	caller after mountvol to report	err*	    *	  voltype,x & volstat,x	& TotBlksl/h,x &*	  unitmode,x are all reset if disk Offline*******************************************************EnblnChk	equ	*		jsr	EnblnSens	;Enable drive X	and sense em		bvc	@online		php		jsr	UnmountX	;clear drive state to unknown		plp		bpl	@05		;offline and not dsw		jsr	ClearDSW		bcs	chkexit@05		lda	#Offline	;record	offline	(leave dsw)@err		sec		bra	chkexit@online		bmi	@10		;online	after eject so clr latch*   online but not after eject but do I	know its volume	type?*    (somehow an ejected latch got reset behind	my back)		lda	voltype,x	;has volume been logically 'mounted'		bne	chkwp		;yes. exit normally		jsr	chkwp		;no. So	don't return an error		bit	fakebit		;set n (keep z)	so mountvol will happen		rts* online after eject so	reset the drive	ejected	latch@10		jsr	UnkVolX		;mark volume as Online and Unknown type		jsr	ClearDSW	;reset ejected latch on drive		bcs	Chkexit		;yes. IF DSW_ERROR report it back* (Status Call doesn't use this routine)* Now set NE status in OK result if its	WritProtedchkwp		equ	*		lda	#VSwrprot	;is it writprotected?		and	volsts,x	;this will set A = 00		beq	@10		lda	#noWrite	;return	error code in a@10		clc			;tell caller no	errorChkexit		bit	volsts,x	;setup n,v result bits 		rts*fakebit		DC.B	VSswaped+VSwrprot************************************************************************ Clear Drive Disk Ejected Latch**	INPUT	X = drive number (0,1)*	OUTPUT	A = ) or $2E***********************************************************************ClearDSW	equ	*		lda	#ejct_reset		jsr	Writebit	;reset ejected latch on drive		lda	#dswerror	;assume	its reportable		sec		bit	cmdmode		;is this extended cmd?		bvs	@10		;yes. 		lda	#00			clc@10		rts************************************************* EnblnSens   (used by DoStatus	and EnblnChk)**     Enable the drive and sense three status* bits and save	them is	volstat,x**    Input : X = unit to enable	and sense (0/1)**   Output : volstat,x bits set	per drive*	     A = $00 or	$20 if WP*  *  Destorys: Y,A   X unchanged************************************************EnblnSens	equ	*		lda	enable1,x		bit	select		;turn on the drive selectSensX		lda	volsts,x			sta	priorsts	;save for status history compare		and	#$1F		;preserve other	bits		ora	#VSwrprot	;preset	so eor resets		sta	volsts,x	;preset	all three bits (b7..b5)		ldy	#3		;3 bits	to sense@loop		lda	SensBit-1,y		jsr	readbit		bcc	@10		;leave bit as preset		lda	StatBit-1,Y		eor	volsts,x	;invert	bit		sta	volsts,x@10		dey		bne	@loop		lda	#VSwrprot		bit	volsts,x	;return	BMI,BVS,BNE per	sense		rtsSensBit		DC.B	Wrprt,dskin,RdejctdStatBit		DC.B	VSwrprot,VSoffline,VSswaped