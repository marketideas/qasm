		ejectalignpg2	EQU	(*-Card_code)	and $FF		DCB.B	$100-alignpg2,$00 ;align to next page* "ReadAddrs Mark Routine";************************************************; GetAddr;	 This routine finds the	next address and loads; it in.;;    Destroys: A,X,Y;;************************************************DeNibTab	equ	*GetAddr		bit	mfmFlag		bpl	@10			jmp	GetMFMAddr@10		jmp	RdAddrHook**********************************************************************GetGCRAddr:		jsr	rdmode		;select read mode and select head				stz	error2		;clear error mask		lda	Q6l		lda	Q7l		;insure	read mode		lda	#>adrmTO	;adrs Mark TimeOut		sta	r1l		; and save for counting		ldy	#<adrmTO	;let y be low byte of time out counter@stover		ldx	#3-1		;nybles	in an address mark@chktime	dey			;service time out counter		bne	@wtbyte		;jump if hasn't run out		dec	r1l		;decrement high	byte of	counter		beq	@errto		;if times out, the there's an error@wtbyte		lda	q6l		;see if	there's a byte		bpl	@wtbyte		;  if not, wait	for one		cmp	adrmarks,x	;see if	it's next address mark		bne	@stover		;if not, start from beginning		dex			;if found one, decrement number	left		bpl	@chktime	;if any	left, look for them		ldx	#5-1		;number	of bytes in address header		stz	csum		;@wtbyte1	ldy	q6l		;see if	there is data		bpl	@wtbyte1	; if not, wait until there is		lda	denibtab,y	;get 6 bit info	from 8 bit code		sta	sectinfo,x	;save this info	for later		eor	csum		;xor it	with the check sum		sta	csum		; and save new check sum value		dex			;decrement data	counter		bpl	@wtbyte1	;if more info, go get it		tay			;last byte was check sum so set	flags		bne	@errCS		; if it	wasn't zero, there was an erro@wtbyte2	ldx	q6l		;see if	there's any data		bpl	@wtbyte2	; if not, wait for some		cpx	bslip1		;byte should be	a bit slip mark		bne	@errCS		;if not, we got	an error@wtbyte3	ldx	q6l		;see if	there's any data		bpl	@wtbyte3	;  if not wait for some		cpx	bslip2		;byte should be	2nd bit	slip mark		bne	@errCS		;if not, we've got an error		ldx	unit_num		lda	FmtFnd		sta	VolIntrlv,x	;save interleave found		and	#$20		asl	a		;set the twosided flag per volume		asl	a		;so survey can recognize 400K gcr		sta	twosided,x	;disks.	(Liron Emulatn wants this)		lda	SideFnd		eor	Side		lsr	a		bne	@sideErr		lda	CylFnd		;make sure we're on the right track		bcc	@chkcyl		ora	#$40@chkcyl		cmp	cyl		beq	@done		ldx	unit_num	;		sta	curcyl,x	;		lda	#cylerror	;indicate we're on the wrong cylinder		bra	@err@done		clc			;address info is right		rts@sideErr	equ	*		lda	#siderror+adrerror		bra	@err@errTO		equ	*		lda	#nomkerror	; mark timeout error		bra	@err@errCS		lda	#adrerror	;Chksum/bitslip@err		tsb	error2		;		sec			;set error flag		rts**************************************************** DeNibTab***************************************************		DCB.B	DeNibTab+$96-*,$FF ;align table	to $96 + tag (on page boundry)		DC.B	$00,$01,$98,$99,$02,$03,$9C,$04,$05,$06,$A0,$A1		DC.B	$A2,$A3,$A4,$A5,$07,$08,$A8,$A9,$AA,$09,$0A,$0B		DC.B	$0C,$0D,$B0,$B1,$0E,$0F,$10,$11,$12,$13,$B8,$14		DC.B	$15,$16,$17,$18,$19,$1A,$C0,$C1,$C2,$C3,$C4,$C5		DC.B	$C6,$C7,$C8,$C9,$CA,$1B,$CC,$1C,$1D,$1E,$D0,$D1		DC.B	$D2,$1F,$D4,$D5,$20,$21,$D8,$22,$23,$24,$25,$26		DC.B	$27,$28,$E0,$E1,$E2,$E3,$E4,$29,$2A,$2B,$E8,$2C		DC.B	$2D,$2E,$2F,$30,$31,$32,$F0,$F1,$33,$34,$35,$36		DC.B	$37,$38,$f8,$39,$3A,$3b,$3C,$3D,$3E,$3FRdMode		lda	#rdhd0		;put unit in read mode		jsr	ReadBit		;		jsr	SelHd		; select the head per side variable		bit	q6l		bit	q7l		rts***********************************************************************	ReadData field of sector**********************************************************************ReadData	bit	mfmFlag		bpl	@10		jmp	ReadMFMData@10		jmp	ReadDataHook* "GCR READ DISK SECTOR	"***************************************************************** * READDSK*****************************************************************ReadGCRData:		stz	csuma		;clear check sums		stz	csumb		;		stz	csumc		stz	error2		;clear the error mask* read data marks *		ldy	#25		;short timeout counter@tryagain	ldx	#2		;number	of data	marks to look for@goodmark	dey			;decrement timeout counter		beq	@err1@wtbyte		lda	Q6l		;try to	read next byte		bpl	@wtbyte		;  if it's not there, wait for it		cmp	datamarks,x	;see if	it's the right mark		bne	@tryagain	;if not, start from beginning		dex			;if found next mark,		bpl	@goodmark	;  look	for next if any	left* read sector number *		ldy	#12		;preload y now @wtsect		ldx	Q6l		;try to	read sector mark		bpl	@wtsect		; if not there,	wait for it		lda	denibtab,x	;denibblize sector number		eor	SectFnd		;should	be same	as in addr field		beq	@hdrok		;if it is, begin with csumc=zero@err1		lda	#nomkerror	;mark timeout error		jmp	@erra* read data *@hdrok		clc			;clear carry for 1st adc csumc @wtjnk0		ldx	Q6l		;+31 try to read next byte		bpl	@wtjnk0		;+02		adc	csumc		;+05		cmp	#$80		;+07  (copies b7 into carry!)		rol	a		;+09  rotate but not thru carry		sta	csumc		;+12		lda	denibtab,x	;+16 denibblize	data		sta	exindex		;+19 save index	4 topbits of nxt 3 @wtjnkA		ldx	Q6l		;+23 try to read next byte		bpl	@wtjnkA		;+02  if it's not there wait for it		lda	denibtab,x	;+06 denibblize	data		ldx	exindex		;+09 get index to top 2	bits		ora	ashift,x	;+13 add on top	2 bits		eor	csumc		;+16 decode data		sta	rwbuf12-1,y	;+21 save data		dey			;+23  		adc	csuma		;+26 follow algorithm for check	sum		sta	csuma		;+29 save check	sum value@wtjnkB		ldx	Q6l		;+33 blind read	next byte		bpl	@wtjnkb		;+02		lda	denibtab,x	;+06 denibblize	data		ldx	exindex		;+09 get index to top 2	bits		ora	bshift,x	;+13 add on top	2 bits		eor	csuma		;+16 decode data		sta	rwbuf12-1,Y	;+21		dey			;+23  		adc	csumb		;+26 follow algorithm for check	sum		sta	csumb		;+29	and save it's new value@wtjnkC		ldx	Q6l		;+33 read next byte		bpl	@wtjnkc		;+02		lda	denibtab,x	;+06 denibblize	data		ldx	exindex		;+09 get index to top 2	bits		ora	cshift,x	;+13 add on top	2 bits		eor	csumb		;+17 decode data		sta	rwbuf12-1,y	;+22		dey			;+24 get next junk byte		bne	@wtjnk0		;+27		bra	@wtbyte0	;+29************************************************************ The following	4 nybl loop must total not more	than* 124 cycles to	allow for 2.5% fast drives (128	- 2.5%)***********************************************************@wtbyteB	ldx	Q6l		;+36 blind read	'B' byte		lda	denibtab,x	;+04 denibblize	data		ora	bshift,Y	;+08 add on top	2 bits		eor	csuma		;+11 decode data		sta	(r0)		;+16 save data		inc	r0		;+21 next position		adc	csumb		;+24 follow algorithm for check	sum		sta	csumb		;+27	and save it's new value@wtbyteC	ldx	Q6l		;+31 read 'C' byte		bpl	@wtbytec	;+02		lda	denibtab,x	;+06 denibblize	data		ora	cshift,Y	;+10 add on top	2 bits		eor	csumb		;+13 decode data		sta	(r0)		;+18 save data		inc	r0		;+23@wtbyte0	ldx	Q6l		;+27 try to read 'T' byte		bpl	@wtbyte0	;+02  if it's not there, wait for it		adc	csumc		;+05 		cmp	#$80		;+07 (copies b7	into carry		rol	a		;+09 Rotate csumc but not thru carry		sta	csumc		;+12		ldy	denibtab,x	;+16 denibblize	Topbits	into Y-reg@wtbyteA	ldx	Q6l		;+20 try to read 'A' byte		bpl	@wtbyteA	;+02  if it's not there wait for it		lda	denibtab,x	;+06 denibblize	data		ora	ashift,Y	;+10 add on top	2 bits		eor	csumc		;+13 decode data		sta	(r0)		;+18 save data		adc	csuma		;+21 follow algorithm for check	sum		sta	csuma		;+24 save check	sum value		inc	r0		;+29 decrement counter		bne	@wtbyteB	;+32 if	more sets of data, continue* Cross	over nybl to 2nd loop and 2nd PAGE!		ldx	Q6l		;+36 blind read	'B' byte		lda	denibtab,x	;+04 denibblize	data		ora	bshift,Y	;+08 add on top	2 bits		eor	csuma		;+11 decode data		sta	(r2)		;+16 save data		adc	csumb		;+19 follow algorithm for check	sum		sta	csumb		;+22	and save it's new value		inc	r2		;+27 increment counter 		nop			;+29 can't blind read to early!@wtbyteF	ldx	Q6l		;+36 blind read	'C' byte		lda	denibtab,x	;+04 denibblize	data		ora	cshift,Y	;+08 add on top	2 bits		eor	csumb		;+11 decode data		sta	(r2)		;+16 save data		inc	r2		;+21 @wtbyte1	ldx	Q6l		;+25 read 'T' byte		bpl	@wtbyte1	;+02		adc	csumc		;+05		cmp	#$80		;+07 (copies b7	into carry!)		rol	a		;+09 Rotate csumc but not thru carry		sta	csumc		;+12		ldy	denibtab,x	;+16 denibblize	data@wtbyteD	ldx	Q6l		;+20 try to read 'A' byte		bpl	@wtbyteD	;+02  if it's not there wait for it		lda	denibtab,x	;+06 denibblize	data		ora	ashift,Y	;+10 add on top	2 bits		eor	csumc		;+13 decode data		sta	(r2)		;+18 save data		inc	r2		;+23 		adc	csuma		;+26 follow algorithm for check	sum		sta	csuma		;+29@wtbyteE	ldx	Q6l		;+33 read 'B' byte		bpl	@wtbyteE	;+02		lda	denibtab,x	;+06 denibblize	data		ora	bshift,Y	;+10 add on top	2 bits		eor	csuma		;+13 decode data		sta	(r2)		;+18 save data		adc	csumb		;+21 follow algorithm for check	sum		sta	csumb		;+24	and save it's new value		inc	r2		;+29 increment counter		bne	@wtbyteF	;+32 if	more sets of data, continue* Read CheckSum @wtchkt		ldx	Q6L		;+36 blind read	checksum Top bits		ldy	denibtab,x	;+04 denibblize	high bits		lda	cshift,y	;+08 get high bits of third checksum		sta	exindex		;+11 save for later		lda	bshift,y	;+15 get high bits of second checksum		sta	exindex+1	;+18 save for later		lda	ashift,y	;+22 get high bits of first checksum		ldx	#2		;+24 for ABC check sums	(+4=28)@wtchk		ldy	Q6l		;+27 wait for check sum		bpl	@wtchk		;+02 if	not there, wait	some more		ora	denibtab,y	;+06 add high bits to denibblized data		eor	csumc,x		;+10 should generate a zero		sta	csumc,x		;+14 save for check later		lda	exindex-1,x	;+18 get high bits of next checksum		dex			;+20 decrement checksum	count		bpl	@wtchk		;+23 if	more, process them* read slip bits before	they disappear		ldx	#2		;check 2 slip bits@wtslip		lda	Q6l		;try to	load slip bit		bpl	@wtslip		;if not	there, wait some more		cmp	bsmarks,x	;compare to what we expect		bne	@errbs		;if it's not, indicate error		dex			;decrement slip	bit counter		bne	@wtslip		;if another one, go check it		bra	@vercsum	;now verify csum* mark the bit slip error@errbs		lda	#dbserror		tsb	error2		;record	the error* Now test for check sum ok@vercsum	lda	csuma		ora	csumb		ora	csumc		;all three should be zero		bne	@chkerr* Checksum OK return Bitslip error (if any)		lda	error2		cmp	#01		;set carry if any error		rts* Checksum was not the same as diskCsum@chkerr		lda	#dcserror	;check sum error@erra		tsb	error2		;set soft error	mask		sec		rts* "WRITE PRE NYBLIZE ROUTINE";*********************************************************; WrtPrep512; WrtPrep524;	 This routine calculates the check sums	and puts; the data or'ed with the appropriate check sum values into; the write buffer.;;	 in : r0 - address of 512 or 524 byte buffer;;********************************************************WrtPrep524	equ	*		ldx	#175		;write prep a 524 byte buffer		bra	WrtPrepXWrtPrep512	equ	*		ldx	#4		;4 * 3 = 12 lead null bytes@wp12		stz	nyblbufa+171,x	;12 bytes of zeros does		stz	nyblbufb+171,x	;nothing to change the 		stz	nyblbufc+171,x	;checksum or the nybles		dex		bne	@wp12		ldx	#171		;writeprep a 512 byte bufferWrtPrepX	equ	*		bit	mfmFlag		bpl	@10* mfm prep just sets up R2 from R0		lda	r0+1		inc 	a		sta	r2+1		lda	r0		sta	r2		rts@10		stx	rePrepCnt	;save this for retrying		lda	r0+1		sta	r2+1		;save for retry@15		lda	syncflag			bpl	@nosync		cmp	#$D0		;is host already done anyway?		beq	@nodelay	;yep. 		cmp	#$C1		;are 1st 256 bytes available yet?		beq	@nosync		;yep. so sync at mid point 		cmp	#$C0		bne	@15		;no. so wait until host has started 1st page* now delay 500us so host can finish 115us before I end the 1st half* and check for host completion** DON'T MESS WITH THE ldy #CONSTANT BELOW* IT CONTROLS HOW MUCH Host margin there is relative to Slave headstart* Slave headstart = 385 us and host margin should be no more than half * the slave head start		ldy	#200@18		dey		bne	@18		;2.5us * 200 ?= 500 us		bra	@nosync		@nodelay	stz	syncflag	; forget the check up at the end@nosync		stz	csuma		;		stz	csumb		;		stz	csumc		;		clc			;initial adc carry status		ldy	#0		;		bra	@chk1@chk0				lda	(r0),y		;get data byte		eor	csumb		; and xor it with checksum b		sta	nyblbufc+1,x	;save as data to be nibblized		eor	csumb		;get data BACK again		adc	csumc		;add to	checksum c		cmp	#$80		;copies	b7 to carry		rol	a		;rotate	csumc but not thru carry		sta	csumc		;save new checksum value		iny			;increment offset		bne	@chk1		inc	r0H		;increment hi pointer ** Dont cross page until its all there		lda	syncflag		bpl	@chk1		eor	#$D0		;DONT CHANGE THE CARRY BOYS!		bne	@restart	;host didn't make it all in time@chk1				lda	(r0),y		;get next data byte		eor	csumc		;xor it	with checksum c		sta	nyblbufa,x	; and save it as data to be nibblized		eor	csumc		;get data BACK again		adc	csuma		; add to checksum a		sta	csuma		;save as new value of checksum a		iny			;increment offset		bne	@chk2		; if no	wrap, don't inc buffer address		inc	r0H		;increment buffer address** Dont cross page until its all there		lda	syncflag		bpl	@chk2		eor	#$D0		;DONT CHANGE THE CARRY BOYS!		bne	@restart	;host didn't make it all in time@chk2				lda	(r0),y		;get next data byte		eor	csuma		; xor it with check sum	a		sta	nyblbufb,x	;  save	it as data to be nibblized		eor	csuma		;get data BACK byte		adc	csumb		; add to checksum b		sta	csumb		; save as new value of check sum b		iny		bne	@30		inc	r0h		;for 524 byte case** Dont cross page until its all there		lda	syncflag		bpl	@30		eor	#$D0		;DONT CHANGE THE CARRY BOYS!		beq	@30@restart	cmp	#$11		;is 1st half done now?		beq	@reDo		;yes. don't wait for finish		lda	#$D0@waitend	cmp	syncflag	;something weird happening in host land		bne	@waitend	;so wait for the host to finish		stz	syncflag	;and don't check it again@reDo		lda	r2+1		sta	r0+1		;restore hi byte of buffer pointer		ldx	rePrepCnt	;get original x back		bra	@nosync@30		dex			;decrement counter group counter		bne	@chk0		;branch	up if we're not done* Calculate the	Checksum Topbits byte (afap)		lda	csumc		lsr	a		lsr	a		;00ccxxxx		eor	csumb		and	#%00110000		eor	csumb		;bbccxxxx		lsr	a		lsr	a		;00bbccxx		eor	csuma		and	#%00111100		eor	csuma		;aabbccxx		lsr	a		lsr	a		sta	wcsum		;00aabbcc		lda	nyblbufa+175	;get first data	byte		sta	byte1		; and save as byte 1		asl	a		;move 2	high bits into byte 0		rol	byte0		;xxxxxxxA		asl	a		;		rol	byte0		;xxxxxxAA		lda	nyblbufb+175	;get next data byte		sta	byte2		; and save as byte 2		asl	a		;move 2	high bits into byte 0		rol	byte0		;xxxxxAAB		asl	a		;		rol	byte0		;xxxxAABB		lda	nyblbufc+175	;get next data byte		sta	byte3		;save as byte 3		asl	a		;move hi 2 bits	into byte 0		rol	byte0		; xxxAABBC		asl	a		rol	byte0		;xxAABBCC	if 0	then	endif@90		rts***********************************************************************	WriteData**********************************************************************WriteData	bit	mfmFlag		bpl	@10 		jmp	WriteMFMData@10		jmp	WritDataHook* "GCR WRITE BLOCK ROUTINE"******************************************************************** WRITEDSK*******************************************************************WriteGCRData:		bit	Q6h		;set up	IWM lines (011)		lda	#$FF		;write anything	to prevent underrun		sta	Q7h		; (111)	WRITE ENABLED FROM HERE	ON!		stz	error2		;clear the error mask		ldx	#08-1		;number	of sync	bytes and data marks@nxtmrk		lda	datamarks,x	;(4) get next data mark	or sync	bytes@wtwrt		bit	Q6l		;(4) see if ready to write		bpl	@wtwrt		;(2) if	not, wait until	it is		sta	Q6h		;(4) write mark	to disk		dex			;(2) decrement mark counter		bpl	@nxtmrk		;(2/3) if still	more, go get 'em		ldy	SectFnd		;(4) get sector	number		lda	nibtab,y	;(4)  and nibblize it@wrsect		bit	Q6l		;(4) wait til read to write		bpl	@wrsect		;(2)		sta	Q6h		;(4)   and write it to disk		ldx	#175-1		;start 1 back since pump primed		bra	@snd0		; begin	with topbits @snd3		ldy	byte3		;+10 put byte 3	in x		lda	nyblbufc+1,x	;+14 get next byte c		sta	byte3		;+17 and save as byte 3		asl	a		;+19 save top 2	bits of	next byte 3		rol	byte0		;+24		asl	a		;+26		lda	nibtab,y	;+30 nibblize current byte 3		sta	Q6h		;+34 and write it to disk		rol	byte0		;+05 finish the	last shift@snd0		ldy	byte0		;+08 get high bits		lda	nibtab,y	;+13 get nibblized data@wtwrt1		bit	Q6l		;+17 see if disk is ready for write		bpl	@wtwrt1		;+20 if	not, wait until	it is		sta	Q6h		;+23,+30,+37 write high	bits to	disk@snd1		ldy	byte1		;+03 get byte 1	in x		lda	nyblbufa,x	;+07 get next byte 1		sta	byte1		;+10  and save as such		asl	a		;+12 put high to bits in byte 0		rol	byte0		;+17		asl	a		;+19		rol	byte0		;+24		lda	nibtab,y	;+28 nibblize current byte 1		sta	Q6h		;+32 write byte	1 to disk@snd2		ldy	byte2		;+03 get byte 2	in x		lda	nyblbufb,x	;+07 get next byte 2		sta	byte2		;+10 and save as such		asl	a		;+12 put high to bits in byte 0		rol	byte0		;+17		asl	a		;+19		rol	byte0		;+24		lda	nibtab,y	;+28 nibblize current byte 2		sta	Q6h		;+32 write byte	2 to disk		dex			;+02 decrement byte counter		cpx	#-1		;+04		bne	@snd3		;+07 if	not, branch up and continue		ldx	#4-1		;+09 4 checksum	bytes to write@wrcslp		ldy	csumc,x		;+13 get csum (with topbits intact)		lda	nibtab,y	;+17 (dropout the topbits here)@wtcsum		bit	Q6l		;+21 wait till fifo avail		bpl	@wtcsum		;+24		sta	Q6h		;+27,+34 and write it to disk		dex			;+02		bpl	@wrcslp		;+05		ldx	#3-1		; 3 bit	slip marks to write@wrslip		lda	bsmarks,x	;get next bit slip mark@wtslip		bit	Q6l		;see if	ready to write		bpl	@wtslip		;if not, wait		sta	Q6h		;  and write it	to the disk		dex		bpl	@wrslip		lda	#$40		;get the underrun bit		and	Q6l		;all by	itself		eor	#$40		;invert	to true	if underrun		tsb	error2		;record	it just	in case@80		bit	Q6l		;wait for write	underrun		bvs	@80		;of the	turn-off nyble 		bit	Q7l		;before	turning	OFF WRITE mode		lda	error2		cmp	#01		;return	carry set if underrun error		rts		eject*	    'MFM RdAddr Routine'************************************************************************   MFM	Read Address Field**   The	timeout	process	must be	absolute timing	since the ISM*   doesn't return any data until a mark byte appears and blank*   media doesn't have any marks so MFM rdaddr can't count "bytes"*   the	way GCR-IWM RdAddrs routine does.**   The	logic polls for	mark bytes for 65535 times around the polling*   loop (5us each at 2.8Mhz) for a total of .327 seconds and then*   aborts ***********************************************************************GetMFMAddr	equ	*		JSR	rdmode		;select	rdmode & proper head (before ISM switch)		stz	error2				JSR	SelectISM	;reselect ISM side of SWIM		LDY	#-1		;65535 * 5us/poll = .36 seconds at 2 Mhz		sty	r1l		;init hi byte for timeout counter		BRA	@reAction@Indexmark	LDX	#03-1		;three mark bytes after	initial	$C2		LDY	#-1@05		BIT	IsmHndShR		BMI	@08		DEY			BMI	@05		bra	@reAction@08		LDA	IsmMarkR		CMP	mfmIndexMarks,X		BNE	@reAction	;restart the Read Action after $C2		DEX			;found all 4 yet?		BPL	@05		;no.@reAction	BIT	IsmErrorR	;clear the error register		LDA	#$18		STA	IsmMode0W	;clear write and action	bits		LDA	#$01		STA	IsmMode1W		STA	IsmMode0W	;toggle	the FIFO bit to	clear the fifo		BIT	IsmErrorR	;again for grins (per mac mRdAddr)		LDA	#$08		STA	IsmMode1W	;start the Read	ACTION going@20		BIT	IsmHndShR	;4	anything available yet		BMI	@25		;6	Yes.		DEY			;8		BNE	@20		;11	/2 = 5.5us		DEC	r1l		BNE	@20@neveraMark	lda	#nomkerror		jmp	@E2exit@25		LDA	IsmMarkR		CMP	#$A1		;adrs/data mark?		BEQ	@a1Mark		;yep.		CMP	#$C2		;index mark?		BEQ	@IndexMark	;yep		BRA	@reAction	;nope. start over again@a1Mark		LDY	#-1		;128 * 11 cycles = 688 usecs		LDX	#03-1		;three mark bytes after	initial	#$A1@35		BIT	IsmHndShR		BMI	@37		DEY		BMI	@35				BRA	@reAction@37		LDA	IsmMarkR		CMP	mfmAddrMarks,X		BNE	@reAction	;restart the fifo etc		DEX			;found all 4 yet?		BPL	@35		;no.@40		BIT	IsmHndShR	;is a data byte	available		BPL	@40		LDA	IsmDataR	;field order =>	cyl,head,sect,size		STA	cylfnd@50		BIT	IsmHndShR	;is a data byte	available		BPL	@50		LDA	#00		LDY	IsmDataR	;get mfm "head"	= 0/1		BEQ	@55		LDA	#$20@55		STA	sidefnd		;look like GCR sidefnd@60		BIT	IsmHndShR	;is a data byte	available		BPL	@60		LDA	IsmDataR	;almost	same as	GCR sectfnd		DEC	A		;mfm sectors start at 1		STA	sectfnd		;but we	want zero based	ones@70		BIT	IsmHndShR	;is a data byte	available		BPL	@70		LDA	#$20		;look like GCR "fmt" bytes		ORA	IsmDataR		STA	fmtfnd@80		BIT	IsmHndShR		BPL	@80		LDA	IsmDataR		STA	csum		;1st byte of CRC@90		LDA	IsmHndShR		BPL	@90		LDY	IsmDataR		STY	csum+1		;2nd byte of CRC		LDY	IsmErrorR		STY	csum+2		STA	csum+3		AND	#%00100010	;save CRC error	and 		BNE	@CRCerr		LDA	#$18		STA	IsmMode0W	;zero ACTION and WRITE bits; behave like GCR dblsided bit that is extracted from GCR "format" byte		ldx	unit_num		LDA	#$80		STA	twoSided,x	;mfm is	always dbl sided				lda	SideFnd		;this should be 00 or 01		beq	@95		lda	#$20		;convert $01 to $20@95		eor	Side		;side is set to 00 or $20		bne	@sideErr	;		lda	CylFnd		cmp	Cyl		;am I on the right cylinder?		beq	@done		;yes.		sta	curcyl,x	;save where I am for reseek		lda	#cylerror		bra	@E2exit		@CRCerr		LDA	#adrerror@E2exit		TSB	error2		LDA	#$18		STA	IsmMode0W	;zero ACTION and WRITE bits		LDA	IsmErrorR		JSR	DeSelectISM		SEC		RTS		@done		CLC		RTS			;Leave ISM mode	selected for ReadData?@sideErr	lda	#siderror+adrerror		bra	@E2exitmfmIndexMarks	DC.B	$FC,$C2,$C2mfmAddrMarks	DC.B	$FE,$A1,$A1mfmDataMarks	DC.B	$FB,$A1,$A1,$A1************************************************************************   MFM	Read Sector Routine***********************************************************************ReadMFMData	EQU	*		BIT	IsmErrorR	;clear the error register		LDA	#$18		STA	IsmMode0W	;clear write and action	bits		LDA	#$01		STA	IsmMode1W		STA	IsmMode0W	;toggle	the FIFO bit to	clear the fifo		BIT	IsmErrorR	;again for grins (per mac mRdAddr)		LDA	#$08		STA	IsmMode1W	;start the Read	ACTION going		LDY	#128		; 127 * 12 cycles = 745 us to 1st A1 mark@20		DEY			;+9		BNE	@25		;+12	@err		LDA	#$18		STA	IsmMode0W		JSR	DeSelectISM	;back into IWM mode on exit		SEC		RTS@25		BIT	IsmHndShR	;+4		BPL	@20		;+7		LDA	IsmMarkR		CMP	#$A1		;a mark	byte?		BNE	@20		LDX	#03		;last mark bytes		LDY	#20		; 20 * 11 cycles = 100+ usecs for 3 more marks@30		BIT	IsmHndShR	;anything available yet		BMI	@35		DEY		BPL	@30		BRA	@err		@35		LDA	IsmMarkR		CMP	mfmDataMarks-1,X		BNE	@err		;not the right mark so forget it		DEX			;found all 3 yet?		BNE	@30		;no.*@40		bit	IsmHndShR	;+4		bvc	*-3		;+6		lda	IsmDataR	;+10			ldx	IsmDataR	;+14		sta	(r0)		;+19		inc	r0		;+24	r0 mod 2 = 1		txa			;+26			sta	(r0)		;+31		inc	r0		;+36	r0 mod 2 = 0		bne	@40		;+39@50		bit	IsmHndShR	;+4		bvc	*-3		;+2		lda	IsmDataR	;+4			ldx	IsmDataR	;+4		sta	(r2)		;+5		inc	r2		;+5	r2 mod 8 = 1		txa			;+2			sta	(r2)		;+5		inc	r2		;+5	r2 mod 8 = 0		bne	@50		;+3 @80		BIT	IsmHndShR		BPL	@80		LDA	IsmDataR		STA	csum		;1st byte of CRC@90		LDA	IsmHndShR		BPL	@90		LDY	IsmDataR		STY	csum+1		;2nd byte of CRC		LDY	IsmErrorR		STY	csum+2		STA	csum+3		AND	#%00100010	;save CRC error	and 		BNE	@errxit		LDA	#$18		STA	IsmMode0W	;zero ACTION and WRITE bits		STZ	error2		JSR	DeSelectISM	;put it	back into IWM mode		CLC		RTS@errxit		LDA	#$18		STA	IsmMode0W	;zero ACTION and WRITE bits		JSR	DeSelectISM		LDA	#dcserror		ORA	error2		STA	error2		SEC		RTS************************************************************************ WriteMFMData Field***********************************************************************WriteMFMData	EQU	*; first insure that the Index/Tach adrs is not the lingering phase line setting; to prevent the Index Pulse cross talk problem** WARNING: Adding any code between here and the splice timing loop* 	   MAY effect the SpliceCnt equate (minor changes allowed +/- a few us)*		LDA	#%11110000	;CA [3210] = 0000		STA	IsmPhaseW	; select the /DIRTN Drive sense adrs			BIT	IsmErrorR		LDA	#$18		STA	IsmMode0W		LDA	#$10		STA	IsmMode1W	;enable Write with action OFF		LDA	#$01		STA	IsmMode1W		STA	IsmMode0W	;2+ us clear FIFO toggle		BIT	IsmErrorR		LDY	#SpliceCnt	; this has been tuned to get splice timing right* Measured overhead from last byte of Adrs field to this point is * (The envelope please)  60.3 us* Write Splice timing must be 22 gap bytes from end of address mark* or 366 us after read of 2nd CRC byte of address field@20		LDA	IsmHndShR	;4  cycles		LDA	IsmHndShR	;4  cycles		LDA	IsmHndShR	;4  cycles		DEY			;2  cycles		BNE	@20		;3  cycles = 17 cycles = 1/2 byte time * Twice thru the above loop is 16.65 us		STZ	IsmDataW	;preload FIFO with 1st two bytes		STZ	IsmDataW	;preload FIFO with 1st two bytes		LDA	#$08				STA	IsmMode1W	;Write Current on NOW		LDX	#syncSize-2	;adjust for preloaded two@30		BIT	IsmHndShR		BPL	@30		;wait for FIFO empty		STZ	IsmDataW		DEX		BNE	@30				LDX	#03		; three bytes of $A1 mark Writes@40		BIT	IsmHndShR		BPL	@40		LDA	#$A1		STA	IsmMarkW		DEX		BNE	@40		@50		BIT	IsmHndShR		BPL	@50		LDA	#$FB		STA	IsmDataW	;4th byte of mark is just data write		LDY	#00@60		LDA	(r0),Y@61		BIT	IsmHndShR		BPL	@61		STA	IsmDataW		INY		BNE	@60		@66		LDA	(r2),Y@67		BIT	IsmHndShR		BPL	@67		STA	IsmDataW		INY		BNE	@66		@70		BIT	IsmHndShR		BPL	@70		STZ	IsmCRCW		;This dummy store writes 2 CRC bytes!!!		LDX	#04		LDA	#gapByte		@80		LDY	IsmHndShR		BPL	@80		STA	IsmDataW		DEX		BNE	@80		;write enough of the gap to force CRC +1 gap to write		@85		BIT	IsmHndShR		BVC	@85		;wait til fifo says 2 are empty				LDA	#$18		STA	IsmMode0W	;turn off Write mode and action				TYA			;get trailing handshake		AND	#$20		;any errors (underrun is it?)		CLC		BEQ	@90		LDA	IsmErrorR	;clear the error register		STA	csum+2		;save it for analyzer@90		php		ldx	#120@wait		bne	*+2		;+3		nop			;+5		dex			;+7		bne	@wait		;+10	5us * 120 = 600 usec delay				jsr	DeSelectISM	;before switching back to IWM side		plp		rts