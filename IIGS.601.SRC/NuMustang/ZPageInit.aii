		ejectZero_Page_Init_Data PROC ENTRY,ORG	ROM_start		IMPORT	GetGCRAddr		IMPORT	ReadGCRData		IMPORT	WriteGCRData		IMPORT	SeekToCyl		IMPORT	TheFormat		IMPORT	FmtGCRTrk		IMPORT	TheVerify		IMPORT	CallCmd		IMPORT	DoInit		ENTRY	HookInitTbl		ENTRY	MarkInitTbl		DC.B	$FF		;msg		DC.B	$FF		;reply		DC.B	00		;cmdmode		DC.B	$FF		;unitno	of request		DC.B	00		;filler	for copy of g.devndx in	parms		DC.W	$FFFF		;blocknum, bytecount, code		DC.W	0000		;address		DC.W	0000		;address		DC.W	0		;xfercnt (Status, ReadBytes)		DCB.B	2,$FF		;curcyl	table (2 local units only)		DCB.B	2,$80		;twosided (2 local units only)		DCB.B	2,00		;VolIntrlv		DC.B	$00		;LIRON EMULATION 'drive' (always zero)		DC.B	$FF		;cyl 		DC.B	$FF		;sector	(for Rdadr to find)		DC.B	$FF		;side  (for ReadData to	find)		DC.B	$FF		;topbits  (CBUS driver & EMULATION)		DC.B	$FF		;topbits1,grp7ctr (CBUS driver * EMULATION)		DC.B	$FF		;WpacketType (CBUS driver & EMULAT)		DC.B	$00		;curNsect (current sectors / cyl)		DC.B	$FF		;rsector (requested sector to r/w)		DC.B	$FF		;sectcnt (READ sector retry cnt)		DC.B	$00		;LIRON EMULATION 'xtions'		DC.B	$FF		;csum  		DC.B	$00		;csumc		DC.B	$00		;csumb		DC.B	$00		;csuma		DC.B	$00		;wcsum (write routine)		DC.B	$00		;exindex		DC.B	$00		;exindex2		DC.W	0000		;pointerl (LIRON EMULATION)*				;sectinfo		DC.B	$00		;CSFnd	 (RdAdrs Chksum	found)		DC.B	$00		;FmtFnd	 (" format found )		DC.B	$00		;SideFnd (" side + cyl b6 found	)		DC.B	$00		;SectFnd (" sector found )		DC.B	$00		;CylFnd	 ("Cylinder found b0..b5)		DC.B	$00		;temp (CBUS driver & EMULATION)		DC.B	$00		;ramblk		DC.B	$00		;cachndx		DC.B	00		;unit_num		DC.B	00		;delayctr		DC.B	00		;CurIWMode (ram	copy of	IWM mode reg)		DC.B	00		;Smartdev (1st smartport device)		DC.B	00		;numdevs (number of devices on chain)		DCB.B	6,0		;UnitType (CBUS,LIRON,,,SUPER,UNIFIED)		DCB.B	6,0		;UnitMode (UDE,ISM,14M,DSW,FST,NT,HD,GCR		DCB.B	2,0		;VolType (400K,800K,1200K,720K,1440K,etc		DCB.B	4,0		;TotBlksl & h		DCB.B	2,0		;VolSts	(Swaped,Offlin,WrProt,,,,,chukw)		DCB.B	2,0		;FmtOption (0 =	use default for	media)		DCB.B	2,0		;FmtIntrlv (0 =	use default for	media)*		The CBUS Command Packet*					;CBcmdpkt		DC.B	00		;CBCmd		DC.B	00		;CBPCount		DC.B	0		;CBpktjunk		DCB.B	6,0		;CBpktguts		DC.B	0		;filler		DC.B	00		;error	(return	to host)		DC.B	$00		;error2	(detailed error	info) *				;execute registers also		DC.B	00		;errcnt	(error3) retry counter		DC.B	00		;numerrs (error4)		DC.B	00		;found	 (error5)		DC.B	00		;error6		DC.B	00		;error7		DC.B	00		;error8		DC.B	00		;statbyte (LIRON EMULATION)		DC.B	0		;cachlock ($80 = lockout caching)		DC.B	0		;Cstate	($40 = post reqst caching)		DC.B	0		;tagsflag		DC.B	04		;Interleave (last Ctrl cmd value)		DC.B	$80		;FormSides ($80	= two sided,$00= one)		DC.W	$0500		;dwnldaddr		DC.B	$00		;byte0 (LIRON EMULATE adrs =$66	)		DC.B	$00		;byte1	  used to store	bytes when		DC.B	$00		;byte2	deniblyzing them during	r/w		DC.B	$00		;byte3		DC.B	0		;CurISMsu		DC.B	0		;DrvrFlag for GS/OS driver interface		DC.W	0		;ByteCountl,h (LIRON EMULATION)		DC.B	0		;filler		DC.B	$80		;mideject ($80=eject NOT in progress)*		       Hooks 		DC.W	HooksTabLen	;lengthHookInitTbl	DC.B	$4C		;RdAddrHook		DC.W	GetGCRAddr			DC.B	$4C		;ReadDataHook		DC.W	ReadGCRData		DC.B	$4C		;WriteDataHook		DC.W	WriteGCRData		DC.B	$4C		;SeekHook		DC.W	SeekToCyl		DC.B	$4C		;FormatHook		DC.W	TheFormat		DC.B	$4C		;WriteTrackHook		DC.W	FmtGCRTrk		DC.B	$4C		;VerifyHook		DC.W	TheVerify		DC.B	$4C		;VectorHook		DC.W	CallCmd		DC.B	$4C				DC.W	DoInitHooksTabLen	equ	*-HookInitTbl*		    Mark TAB*MarkInitTbl	DC.B	$FF		; afdmtab (after DataMark tab)		DC.B	$AD,$AA,$D5,$FF	;datamarks		DC.B	$FC,$F3,$CF,$3F,$FF ;syncmarks		DC.B	$FF		;bsmarks		DC.B	$AA		;bslip2		DC.B	$DE		;bslip1		DCB.B	5,$FF		;adrguts = adrs	mark data		DC.B	$96,$AA,$D5,$FF	;adrmarks*		DC.B	$00		;result	(CBUS driver)		DCB.B	7,0		;RecvBuff,grp7cnt,oddbytes,datastat*		DC.W	0000		;r0		DC.W	0000		;r1		DC.W	0000		;r2*		DC.B	0		;minCsect		DC.B	0		;maxCsect		DC.B	0		;z_debug		DC.B	00		;mfmFlag		DC.B	00		;DDflag		DC.B	0		;Gap3Size		DC.B	0		;spare		DC.B	0		;spare		DC.B	0		;TESTWRITE		DC.W	0		;formatter HDmediaCk vector		DC.B	$4A,$CF,$41,$55z_initlen	equ	*-Zero_Page_Init_Data		if	(z_initlen	<> zero_page_template.zp_init_lgth) then		aerror	'!!! Zero_Page_Init_Data and zero_page_template are NOT EQUAL length !!!'		endif		if	(z_initlen	> 256) then		aerror	'!!! The zero page data is longer than 256 bytes !!!'		else		DCB.B	256-z_initlen,$00 ;fill the remaining bytes to make init rec 256 bytes		endif		ENDP