		machine M6502	;the following code runs on the host processor********************************************************** Host_test_code					** 							** This code segment will be moved to			** Host bank #0 upper 512 bytes and the			** Host_CC00_pseudoROM by the card 			**							** perform a sequence of tests of the RAM and		** ROM areas the host can access on the card 		**							** 1. Do a checksum on the ROM/RAM areas.		**	Read and write all memory spaces checking	**	for data, address and changing 'ROM'		**	errors.  The host display will be used to	**	monitor the progress of the operations.		**							** 2. (future)						**							**							**********************************************************Host_test_code	PROC ENTRY,TEMPORG $CA00 ;appearently at the host location		WITH zero_page_template ;allows zero page variables to be used simply		ENTRY	factory_sig_h		IMPORT	fact_sig_copy;the card has just attempted to see what drives are out there;inform the user as to what we seeDisk_info_user	jsr	cr_h			;** put out the info to the screen **		lda	#>disk_read_title		sta	zp_addr_h+1		lda	#<disk_read_title		jsr	string_out		lda	RAM_base_h+numdevs	;get the number of devices		tax				;save it for later		jsr	prhex_h			;put it out		jsr	cr_h		txa				;set the flags		bne	@Disk			;we have at least one drive		jmp	@Disk_info_end		;there are no drives so we're done		@Disk		lda	#1			;start with the first drive		pha				;put the drive # on the stack@Disk1		pla				;get the drive number		pha				;save it back		tay				;Y is the index		jsr	prhex_h			;tell the user which drive		lda	RAM_base_h+unittype-1,y	;get the unit type		cmp	#UTa35			;is it an apple 3.5 drive?		bne	@Disk2			;no***** AD35_out****		lda	#<AD35_msg		jsr	string_out		jmp	@Disk_volume		;go to volume type@Disk2		cmp	#UTfdhd	or UTa35	;is it a FDHD?		bne	@Disk3			;no***** FDHD_out****		lda	#<FDHD_msg		jsr	string_out		jmp	@Disk_volume		;go to volume type@Disk3		cmp	#UTremote		;is it a UniDisk 3.5?		bne	@Disk_volume		;no***** UD35_out****		lda	#<UD35_msg		jsr	string_out		jmp	@Disk_end_test		;skip volume type and write protect for unidisk@Disk4		jsr	unk_out		jmp	@Disk_end_test		;this will skip the rest of the line@Disk_volume	pla				;get the drive number		pha				;save it back		tay				;Y is the index		lda	RAM_base_h+voltype-1,y	;get the volume type		cmp	#AD400K			;is it a 400k?		bne	@Disk5			;no***** v400K_out****		lda	#<v400K_msg		jsr	string_out		jmp	@Disk_wrt_pro		;go to prite protect?@disk5		cmp	#DD720K			;is it a 720K?		bne	@disk6			;no***** v720K_out****		lda	#<v720K_msg		jsr	string_out		jmp	@Disk_wrt_pro		;go to prite protect?@disk6		cmp	#AD800K			;is it a 800K?		bne	@disk7			;maybe...		jsr	v800K_out		;yes		jmp	@Disk_wrt_pro		;go to prite protect?@disk7		cmp	#AD800K2		;is it a 800K?		bne	@disk8			;no		jsr	v800K_out		;yes		jmp	@Disk_wrt_pro		;go to prite protect?@disk8		cmp	#HD1440K2		;is it a 1440K?		bne	@disk9			;maybe...		jsr	v1440K_out		;yes		jmp	@Disk_wrt_pro		;go to prite protect?@disk9		cmp	#HD1440K1		;is it a 1440K?		bne	@Disk10			;no		jsr	v1440K_out		;yes		jmp	@Disk_wrt_pro		;go to prite protect?@disk10		jsr	unk_out		jmp	@Disk_end_test		;this will skip the rest of the line@Disk_wrt_pro	pla				;get the drive number		pha				;save it back		cmp	#3			;is the drive number less than 3?		bcs	@Disk_end_test		;no, skip the write protect		tay				;Y is the index		lda	RAM_base_h+volsts-1,y	;get the volume status		and	#VSwrprot		;is it write protected?		beq	@Disk11			;no***** yes_out****		lda	#<yes_msg		jsr	string_out		jmp	@Disk_end_test		;go check if we are done@Disk11***** no_out****		lda	#<no_msg		jsr	string_out@Disk_end_test	pla				;get the drive number		tay				;put it in y		cmp	RAM_base_h+numdevs	;did we do the last drive?		beq	@Disk_info_end		;yes, go on to next section		iny				;no, do the next drive		tya		pha				;save the new drive number		jsr	cr_h		jmp	@disk1			;again...@Disk_info_end	jsr	cr_h		jsr	cr_h		jsr	Host_pass_disk		;wait for the card to determine if write needed;if we returned then we must be at the factory and we are passed the first drive write test		lda	#<disk_pass_msg		jsr	string_out		lda	#1			;disk 1		jsr	prhex_h		jsr	cr_h		jsr	Host_pass_disk		;wait for the second drive write test;if we returned then we must have passed the second drive write test		lda	#<disk_pass_msg		jsr	string_out		lda	#2			;disk 2		jsr	prhex_h		jsr	cr_h		jsr	Host_pass_disk		;wait for the host to handshake the exit*******************************		***!!!*** END of CODE ***!!!*************************************** v1440K_out****v1440K_out	lda	#<v1440K_msg		jsr	string_out		rts***** v800K_out****v800K_out	lda	#<v800K_msg		jsr	string_out		rts***** unk_out****unk_out		lda	#<unk_msg		jsr	string_out		rts*********************** Host Disk test data***********************;fill the gap with zeroes		DCB.B	512-193-(*-Host_test_code),$00		STRING C	;make the following 'C' strings, terminated with a $00 byte		MSB ONdisk_pass_msg	DC.B	'Passed R/W for Unit 'disk_fail_msg	DC.B	'R/W Failure on block $'disk_fail_msg2	DC.B	'  Err=$'disk_read_title	DC.B	'# Unit        Volume  W/P   Drives='UD35_msg	DC.B	' UniDisk 3.5'AD35_msg	DC.B	' Apple 3.5  'FDHD_msg	DC.B	' Apple FDHD 'v400K_msg	DC.B	' 400K 'v720K_msg	DC.B	' 720K 'v800K_msg	DC.B	' 800K 'v1440K_msg	DC.B	' 1440K'unk_msg		DC.B	'  ??? 'yes_msg		DC.B	'   YES'no_msg		DC.B	'   NO'		STRING ASIS	;return to the default string setting		MSB OFF		;these locations will be at the top of the bank switched host codefactory_sig_h	DCB.B	16,0	;Factory signature will be placed herernd_h		DC.B	0	;host will place the random number herehndsk_h		DC.B	0	;handshake byte durring disk tests and exiting***** This is the point where the initial $CnXX code jumps to after being released *****;The first thing to do is clear the host's screen and put out a messageCC00_test_code	sei			;disable interrupts (when we force coldstart they will be fixed)		jsr	setvid_h	;make sure that the screen is the output device		jsr	setkbd_h	;and that the keyboard is the input device		jsr	text_h		;put the host into text mode		jsr	home_h		;clear the scren and put the cursor at the top left		lda	#%11111111		sta	zp_byte1_h	;assume we can display lowere case		lda	#$06		;this is the ID of //e or later systems		cmp	IDbyte1		;does the system support lower case characters		beq	@message_out	;yes		lda	#%11011111	;no, this will force bit 5 off		sta	zp_byte1_h	;put it in a safe place@message_out	lda	#>Sign_on_msg1		sta	zp_addr_h+1	;store the high address byte		lda	#<Sign_on_msg1	;low byte of the strings addr		jsr	String_out	;go display the string		jsr	cr_h		;go to next line		lda	#<Sign_on_msg2		jsr	String_out	;go display the string		jsr	cr_h		;go to next line		lda	#<copywrt_msg		jsr	String_out	;go display the string		jsr	cr_h		;go to next line		jsr	cr_h		;go to next line		lda	#<test_title		jsr	String_out	;go display the string		jsr	cr_h		;go to next line		lda	#<test_1		jsr	String_out	;go display the string;find out what slot we're in and tell the user		lda	mslot_h		;get the $Cn from where it was stored (which slot we're in)		jsr	prhex_h		;output lower nibble to the screen, A is scrambled		lda	mslot_h		;get the $Cn from where it was stored (which slot we're in)		asl	A		asl	A		asl	A		asl	A		;A=$n0		ora	#$80		;$n0 or'd w/ $80 will give low byte of I/O base address		sta	zp_addr1_h	;place it in the low byte		lda	#$C0		sta	zp_addr1_h+1	;high byte, indirect address to our slot I/O space		jsr	cr_h		;go to next line;PseudoROM test		lda	#<test_2		jsr	String_out	;go display the string		jsr	host_idle	;wait for the test to complete;Card ROM CRC		lda	#<test_3		jsr	String_out	;go display the string		jsr	host_idle	;wait for the test to complete;Card ROM Checksum		lda	#<test_4		jsr	String_out	;go display the string		jsr	host_idle	;wait for the test to complete;SWIM		lda	#<test_5		jsr	String_out	;go display the string		jsr	host_idle	;wait for the test to complete;Card RAM		lda	#<test_6		jsr	String_out	;go display the string		jsr	host_idle	;wait for the test to complete;Host/Card shared data		lda	#<test_7		jsr	String_out	;go display the string;Perform a checksum on the host RAM/ROM; The host can check the entire 'ROM' and RAM space, less the cards I/O bank ($0AXX); which corresponds to the host latch bank $2 $CAXX, for reading all the data correctly.;; the order in which the memory is to be added is:;	(1)  latch bank $0, $C806-$CBFF;	(2)  latch bank $1, $C800-$CBFF;	(3)  latch bank $3, $C800-$CBFF;	(4)  latch bank $4, $C800-$CBFF;	(5)  latch bank $5, $C800-$CBFF;	(6)  latch bank $6, $C800-$CBFF;	(7)  latch bank $7, $C800-$CBFF;	(8)  latch bank $8, $C800-$CBFF;	(9)  latch bank $9, $C800-$CBFF;	(10) latch bank $A, $C800-$CBFF;	(11) latch bank $B, $C800-$CBFF;	(12) latch bank $C, $C800-$CBFF;	(13) latch bank $D, $C800-$CBFF;	(14) latch bank $E, $C800-$CBFF;	(15) latch bank $F, $C800-$CBFF;	(16) $CC00-$CFFE;	(17) latch bank $2, $CB00-$CBFF;	(18) $Cn00-$CnFF;	(19) latch bank $2, $C800-$C9FF;; when the sum of the data is complete if it is incremented the result; should be $00, if it is not then inform both the card and the user;; A destroyed; X destroyed; Y destroyedh_add1		lda	#0		tax			;zero the x index reg		ldy	#6		;put 6 into the y index reg		stx	zp_addr_h	;zero into the low byte of the address@h_add2		stx	zp_byte_h	;save the latch bank #		sty	zp_byte2_h	;save the Y		ldy	zp_byte_h	;bank # in Y		sta	(zp_addr1_h),y	;this will switch in the correct latch bank		ldy	zp_byte2_h	;restore Y		ldx	#$C8		;the page address		stx	zp_addr_h+1	;set the high address byte		ldx	#$CC		;this is the compare value for the page to stop at@h_add3		clc			;get ready to add		adc	(zp_addr_h),y	;do the add		iny			;point to the next byte		bne	@h_add3		;no need to do anything to the bank byte		inc	zp_addr_h+1	;the page needs to change		cpx	zp_addr_h+1	;are we done with this section (?)?		bne	@h_add3		;no		ldx	zp_byte_h	;get the just completed bank latch #		cpx	#$01		; have we just completed the first two latch banks?		bne	@h_add4		;no; continue on		inx			;skip latch bank #2@h_add4		cpx	#$0F		;have we just completed the last latch bank?		beq	@h_add5		;yes, we are done with sections (1) through (15)		inx			;no, point to the next latch bank #		jmp	@h_add2		;go add the next latch bank #@h_add5		ldx	#$CC		stx	zp_addr_h+1	;set high address byte to starting page of section (16)		ldx	#$CF		;this is the compare value for the page to stop at@h_add6		clc			;get ready to add		adc	(zp_addr_h),y	;do the add		iny			;point to the next byte		bne	@h_add6		;no need to do anything to the bank address		inc	zp_addr_h+1	;the page needs to change		cpx	zp_addr_h+1	;are we done with  the first part of section (16)?		bne	@h_add6		;no@h_add6b	clc			;get ready to add		adc	(zp_addr_h),y	;do the add		iny			;point to the next byte		cpy	#$FF		;are we done with the rest of section (16)?		bne	@h_add6b	;no		ldy	#2		;bank #2		sta	(zp_addr1_h),y	;switch in latch bank $2		ldy	#0		;the next routine assumes Y is equal to zero		ldx	#$CB		stx	zp_addr_h+1	;set the address to proper page for section (17)@h_add7		clc			;get ready to add		adc	(zp_addr_h),y	;do the add		iny			;point to the next byte		bne	@h_add7		;we are not done yet		ldx	mslot_h		;get the cards $Cn page location		stx	zp_addr_h+1	;set the correct page address for section (18)@h_add8		clc			;get ready to add		adc	(zp_addr_h),y	;do the add		iny			;point to the next byte		bne	@h_add8		;we are not done yet		ldx	#$C8		stx	zp_addr_h+1	;set high address byte to starting page of section (19)		ldx	#$CA		;this is the compare value for the page to stop at@h_add9		clc			;get ready to add		adc	(zp_addr_h),y	;do the add		iny			;point to the next byte		bne	@h_add9		;no need to do anything to the bank address		inc	zp_addr_h+1	;the page needs to change		cpx	zp_addr_h+1	;are we done with section (19)?		bne	@h_add9		;no		cmp	#$FF		;the accumulator should equal $FF if all is ok		beq	add_pass_h	;the checksum is good go report the newsadd_fail_h	jsr	test_fail_sub	;the test failed tell the user		jmp	Ask_exit	;does the user want to exit			add_pass_h	jsr	test_pass_sub	;passed the test tell the user;perform the host RAM test through all banks execpt #0host_RAM_test	lda	#<test_8		jsr	String_out	;go display the string		ldx	#0		;zero the x index reg		stx	zp_addr_h	;zero into the low byte of the address		inx			;skip bank #0@h_write1	stx	zp_byte_h	;save the latch bank #		jsr	Live_indicator	;update the live indicator		ldy	zp_byte_h	;Y = bank #		sta	(zp_addr1_h),y	;this will switch in the correct latch bank		ldy	#0		;zero the y index reg		ldx	#$C8		;the page address		stx	zp_addr_h+1	;set the high address byte		ldx	#$CC		;this is the compare value for the page to stop at@h_write2	tya			;get the page offset		clc			;get ready to add		adc	zp_byte_h	;add the bank latch #		adc	zp_addr_h+1	;and add the page		sta	(zp_addr_h),y	;write the data		iny			;point to the next byte		bne	@h_write2	;no need to do anything to the bank byte		inc	zp_addr_h+1	;the page needs to change		cpx	zp_addr_h+1	;are we done with this latch bank?		bne	@h_write2	;no		ldx	zp_byte_h	;get the just completed bank latch #		cpx	#$0F		;have we just completed the last latch bank?		beq	@h_read1	;yes, we are done with the writing of the paged RAM		inx			;no, point to the next latch bank #		jmp	@h_write1	;go add the next latch bank #@h_read1	ldx	#0		;zero the x index reg		stx	zp_addr_h	;zero into the low byte of the address		inx			;skip bank #0@h_read2	stx	zp_byte_h	;save the latch bank #		jsr	Live_indicator	;update the live indicator		ldy	zp_byte_h	;Y = bank #		sta	(zp_addr1_h),y	;this will switch in the correct latch bank		ldy	#0		;zero the y index reg		ldx	#$C8		;the page address		stx	zp_addr_h+1	;set the high address byte		ldx	#$CC		;this is the compare value for the page to stop at@h_read3	tya			;get the page offset		clc			;get ready to add		adc	zp_byte_h	;add the bank latch #		adc	zp_addr_h+1	;and add the page		cmp	(zp_addr_h),y	;compare the data		beq	@h_read4	;the data is good; if we fail jump to the host checksum fail routine to save some bytes		jmp	add_fail_h	;the test failed@h_read4	iny			;point to the next byte		bne	@h_read3	;no need to do anything to the bank byte		inc	zp_addr_h+1	;the page needs to change		cpx	zp_addr_h+1	;are we done with this latch bank?		bne	@h_read3	;no		ldx	zp_byte_h	;get the just completed bank latch #		cpx	#$0F		;have we just completed the last latch bank?		beq	@h_read_pass	;yes, we are done with the compare of the paged RAM		inx			;no, point to the next latch bank #		jmp	@h_read2	;go add the next latch bank #@h_read_pass	jsr	test_pass_sub	;passed the test tell the user;Done with all the host tests so before we let the card do a disc read;we need to copy the factory ID bytes and a random # into card RAM		ldy	#0		;bank 0		sta	(zp_addr1_h),y	;this will switch in the correct latch bank		lda	#>(@copy_rtn-1)		pha		lda	#<(@copy_rtn-1)		pha			;we have put the proper return address on the stack		lda	mslot_h		pha		lda	#<fact_sig_copy-1		pha		rts			;this jumps to the $CnXX routiene@copy_rtn	lda	$C02F		;get a rnd number		sta	rnd_h		;store it in common RAM		jsr	Host_pass_disk	;wait for the card to read the drive info		jmp	Disk_info_user	;the bank is 0, go jump into the RAM;ask the user to exitAsk_exit	lda	#$A6		;this is an '&'		sta	$48D		;fix the screen		ldy	#0		;bank 0		sta	(zp_addr1_h),y	;this will switch in the latch bank 0		lda	#fail_code		sta	hndsk_h		;inform the card the host failed a test		jsr	cr_h		;go to next line		lda	#>test_ask1		sta	zp_addr_h+1	;store the high address byte		lda	#<test_ask1		jsr	String_out	;go display the string		jsr	cr_h		;go to next line;watch the keyboard for the user input and then act on it; Also: read through all areas just to exercise the logic;	(1) all latch banks $0-$F;	(2) $CnXX host 'ROM';	(3) $CC00-$CFFE		lda	kbdstrb_h	;clear the keystroke flag@Keybord_h	ldx	#0		;zero the x index reg		stx	zp_addr_h	;zero into the low byte of the address@h_read1	stx	zp_byte_h	;save the latch bank #		ldy	zp_byte_h	;Y = bank #		sta	(zp_addr1_h),y	;this will switch in the correct latch bank		ldy	#0		;zero the y index reg		ldx	#$C8		;the page address		stx	zp_addr_h+1	;set the high address byte		ldx	#$CC		;this is the compare value for the page to stop at@h_read2	lda	(zp_addr_h),y	;read the data		iny			;point to the next byte		bne	@h_read2	;no need to do anything to the bank byte		inc	zp_addr_h+1	;the page needs to change		cpx	zp_addr_h+1	;are we done with this latch bank?		bne	@h_read2	;no		ldx	zp_byte_h	;get the just completed bank latch #@h_read3	cpx	#$0F		;have we just completed the last latch bank?		beq	@h_read4	;yes, we are done with the reads of this section (1)		inx			;no, point to the next latch bank #		jmp	@h_read1	;go add the next latch bank #@h_read4	ldx	mslot_h		;get the cards $Cn page location		stx	zp_addr_h+1	;set the correct page address for section (2)@h_read5	lda	(zp_addr_h),y	;read the byte		iny			;point to the next byte		bne	@h_read5	;we are not done yet		ldx	#$CC		stx	zp_addr_h+1	;set high address byte to starting page of section (3)		ldx	#$CF		;this is the compare value for the page to stop at@h_read6	lda	(zp_addr_h),y	;read the byte		iny			;point to the next byte		bne	@h_read6	;no need to do anything to the bank address		inc	zp_addr_h+1	;the page needs to change		cpx	zp_addr_h+1	;are we done with  the first part of section (3)?		bne	@h_read6	;no@h_read7	lda	(zp_addr_h),y	;read the byte		iny			;point to the next byte		cpy	#$FF		;are we done with the rest of section (3)?		bne	@h_read7	;no		lda	kbd_h		;get the keyboard data?		bpl	@Keybord_h	;nothing yet, so we'll try again		sta	kbdstrb_h	;clear the key		cmp	#$C5		;E?		beq	Exit_h		cmp	#$E5		;e?		beq	Exit_h		bne	@Keybord_h	;go look for another character;guess the user wants outExit_h		lda	reset_vector_h+1	;get the high byte of the reset vector		sta	power_up_byte_h		;store it in the power-up byte, this will force cold start		lda	$FFFD			;get the high byte of the system reset vector		pha				;put it on the stack		lda	$FFFC			;get the low byte of the system reset vector		pha				;finish building a 'rts' address to cold start		ldy	#0			;bank 0		sta	(zp_addr1_h),y		;flip in the bank		lda	#reboot_code		;reboot code		sta	hndsk_h			;tell the Card we are about to reboot@exit_wait	lda	hndsk_h			;look for handshake		bne	@exit_wait		;Card's not ready to re-copy the pseudoROM area (re-Init)		rts				;cold start the host***** host_idle** This is where We'll sit waiting for the Card*  to finish the current test.* While waiting, the 'Hidden' RAM area will*  be tested and if an error is found will*  inform the user.* The 'live' indicator will be made active* The pass or fail message will be put out*  then We're done and will return.** Y destroyed* A destroyed****host_idle	jsr	Live_indicator	;update the live indicator; write and then read back a page af RAM latch bank #2, $CA00-$CAFF ($0AXX on Card)		ldy	#2		;Y = bank #2		sta	(zp_addr1_h),y	;flip in the correct bank, #2		ldy	#0		lda	$CA00		;get a value		tax			;put it in x@s_write_h	inx			;change the data		txa			;need to have it in A		sta	$CA00,y		;write the data to the SRAM		iny			;point to the next location		bne	@s_write_h	;not done with the page@s_read_h	inx			;next data		txa			;put the compare value in A		cmp	$CA00,y		;is the data good?		bne	@s_read_err	;no		iny			;point to the next byte		bne	@s_read_h	;not done with the page		jmp	@ck_card	;we pased this time so go check if the card is waiting@s_read_err	lda	#$C5		;'E' go tell the user		sta	$606		;put the 'E' on the screen; check to see if the card has completed its test and report the results@ck_card	ldy	#0		;Y = bank #0		sta	(zp_addr1_h),y	;flip in the correct bank, #0		lda	RAM_base_h+zp3	;check to see if the Card has responded?		beq	host_idle	;not yet, so idle some more		cmp	#pass_code	;did the Card's test pass?		beq	@passed		;yes, passed; if the value is non-zero and is not the pass code then assume it's a failure		jsr	test_fail_sub	;the test failed tell the user		jmp	Ask_exit	;wait for the user to Exit@passed		sty	RAM_base_h+zp3	;pass  handshake the Card (Y = 0)		jmp	test_pass_sub	;passed the test tell the user, rts in other sub***** Live_indicator** this will place the next character on the screen* at the 'live' indicator location** A destroyed* Y destroyed****Live_indicator	lda	$48D		;this is the 'live' indicator location		ldy	#4		;offset into data@live1		cmp	live_data,y	;does it match?		beq	@live2		;yes		dey			;no, point to the previous character		bne	@live1		;if we are not done then continue check		iny			;no matches, must be some other characer so this will force a '-'@live2		lda	live_data-1,y	;get the next character in the sequence		sta	$48D		;change the live indicator		rts***** test_pass_sub** this will put the test_pass message out to the screen****test_pass_sub	lda	#>test_pass		sta	zp_addr_h+1		lda	#<test_pass		jsr	String_out	;go display the string		jsr	cr_h		;go to next line		rts***** test_fail_sub** this will put the test_fail message out to the screen****test_fail_sub	lda	#>test_fail		sta	zp_addr_h+1		lda	#<test_fail	;Failed the checksum tell the user		jsr	String_out	;go display the string		jsr	cr_h		;go to next line		rts***** String_out** This subroutine will output a 'C' string, the last character is* followed by a $00 byte, to the monitor. 256 char Max. limit.** The A should have the low byte of the address of the string* and the high byte should be in zp_addr_h+1** A destroyed* Y destroyed****String_out	sta	zp_addr_h	;store the low byte of the address		ldy	#0		;set the index to zero@string1	lda	(zp_addr_h),y	;get the string data		bne	@string2	;this must be data to be put out		rts			;we hit an end of string@string2	cmp	#$C0		;is it a special character?		bcc	@string3	;yes, don't do any thing		and	zp_byte1_h	;make it upper case if we have to@string3	jsr	cout_h		;put the character out to the screen		iny			;point to the next location		bne	@string1		rts			;we have put out the maximum number of characters***** Host_pass_disk** This is where we'll tell the Card that* we passed a test or completed an operation* and then wait for a reply either a zero to* indicate continue, the fail_code if we* need to exit or the disk_fail_code if* we need to tell the user we failed then* exit.** We will also update the 'live' inicator** card bank #0 will be flipped in* the byte used for the hand shake is in bank 0** Y destroyed* A destroyed****Host_pass_disk	ldy	#0		;Y = bank #0		sta	(zp_addr1_h),y	;flip in the correct bank, #0		lda	#pass_code		sta	hndsk_h		;tell the card we can continue@wait1		jsr	Live_indicator	;update the live indicator		lda	hndsk_h		cmp	#fail_code	;does the card want out?		bne	@wait2		;no		jmp	Ask_exit	;wait for the user to Exit@wait2		cmp	#disk_fail_code	;did the disk write fail?		bne	@wait3		;no		lda	#<disk_fail_msg		jsr	String_out		lda	RAM_base_h+blocknum+3	;get the high byte of the block we failed on		jsr	prbyte_h		;put it out to the screen		lda	RAM_base_h+blocknum+2	;get the low byte of the block we failed on		jsr	prbyte_h		;put it out to the screen		lda	#<disk_fail_msg2		jsr	String_out		lda	RAM_base_h+error	;get the error code		jsr	prbyte_h		;put it out to the screen		jsr	cr_h		jmp	Ask_exit		;wait for the user to exit@wait3		cmp	#clear_code	;is the card ready to continue?		bne	@wait1		;no		rts******************** Host DATA ********************		DCB.B 1536-223-(*-Host_test_code),$00 ;push the data up to the end of the page		STRING C	;make the following 'C' strings, terminated with a $00 byte		MSB ONSign_on_msg1	DC.B	' 3.5" Disk Controller Test'Sign_on_msg2	DC.B	'    J.Arkley & T.Rudin'copywrt_msg	DC.B	'(C)Apple Computer Inc.,1991'test_title	DC.B	'Tests:'test_1		DC.B	'Slot #'test_2		DC.B	'Card pseudoROM'test_3		DC.B	'Card ROM CRC'test_4		DC.B	'Card ROM Checksum'test_5		DC.B	'SWIM Regs.'test_6		DC.B	'Card RAM'test_7		DC.B	'Host/Card shared data'test_8		DC.B	'Host RAM'test_pass	DC.B	'-PASS'test_fail	DC.B	'-FAIL'test_ask1	DC.B	'Press E to Exit'		STRING ASIS	;return to the default string settinglive_data	DC.B	'-/|\-'		MSB OFFHost_test_length EQU *-Host_test_code ;generate the length of this proc	if (Host_test_length > 1535) then		aerror '!!! CC00_test_code segment larger than 1023 bytes !!!'	else		DCB.B 1536-Host_test_length,$00 ;fill the remaining bytes with $00's	endif		ENDP		MACHINE M65C02	;this next code runs on the NuMustang card w/65C02Self_Test	PROC	ENTRY		WITH	zero_page_template		IMPORT	InitCard		IMPORT	Begin		IMPORT	UserPatch		IMPORT	CRC_checkwords		IMPORT	Checksum_word		IMPORT	Bootptch1		IMPORT	Bootptch2		IMPORT	ColdStartup		IMPORT	CallCmd		IMPORT	SetCBptrs		IMPORT	EnableGCR		ENTRY	PwrONDiag		ENTRY	UserTest****************** DIAGNOSTICS ******************** There are three Diagnostics that are supported.*  1.The Power-on quick check*  2.The User diagnostic*  3.The Factory diagnostic (future)** The card's red LED is used to give an*  indication of its status.**   CARD STATE		   	     INDICATION* ------------------		-------------------------* Card code BRK			LED Flashes short...* Card failed Power-UP test	LED Flashes long-short...* Card failed User/Factory test	LED Flashes long-short-short...* Card is DEAD			LED is ON* Card is OK			LED is OFF** If the Card is waiting for the Host to reply during User/Factory diagnostics*  the LED will be dimmed.** When the User or Factory diagnostics are*  executed the screen should give detailed*  informaton back to the user, if possible.************** Invoking Diagnostics **************** The Power-up quick check is executed every time*  the system is powered up or reset.** The User diagnostic can be invoked by two*  methods.  The first way is to power up the*  system while holding down the Control*  and D keys simultaneously, the card must*  be the boot device.  The second method is*  to jump into the User diagnostic entry point in*  the card's CnXX space.  This can be done easily*  from the monitor by typing Cn0DG at the monitor*  prompt (*).  Where n = slot# of the card.*  For example if the card is in slot 5 then from*  the monitor type C50DG then press return.** The Factory diagnostic is invoked by a signature*  in the $C100 firmware space of another mustang * located in slot 1************* Diagnostic Coverage ***************** The scope and thus the exhaustiveness of the*  tests are basically two levels, limited vs*  good coverage.  The Power-on quick check is*  a fast hardware sanity check.  The Host side*  is not checked.  Both the User and Factory*  diagnostics perform a longer and more detailed*  test suite, with more helpful error feedback*  displayed on the screen.  The Host side is checked.*  The major difference between the User and the*  Factory diagnostics are the automation of the*  Factory diagnostics as compared to the user*  interactivity needed to run the User diagostics.zero_page_test_data:		;this must be on a page boundry		DC.B	$55	;zp1  some initial data values, no significance		DC.B	$0F	;zp2		DC.B	$00	;zp3		DC.B	$00	;zp4		DC.W	$0000	;z_addr !!NOTE zp1-zp4 and z_addr must be togetherzptd_length	EQU	*-zero_page_test_data ;generate the length of the data (for a check)	if (zptd_length > 256) then		aerror '!!! The zero page test data is longer than 256 bytes !!!'	else		DCB.B 256-zptd_length,$00 ;fill the remaining bytes with $00's	endifUserTest:		;Entry points can't be equated************************************************** UserTest-Self_Test				**						** will do the following things:			**						** Initialize the card environment		** move CC00_test_code to Host_CC00_pseudoROM	**	make sure that all the			**	data was correectly moved		**   by comparing the it with			**	the ROM data - the host			**	needs to see the $CnXX and $CC00 present**	and this code will keep the host	**	looping until the card diagnostics	**	are completed				** do a ROM checksum				** finish the RAM test by more exhaustive	**	testing of the remaining RAM space	** calculate a checksum for the host to check    ** dim the LED if these checks pass and waiting	** for the host to respond			**	else flash an error code?		** move zero_page_test_data to $0000		** allow the host to continue			** turn light off if host responds with 'good'	**  any other responce will flash LED		** find out if the host wants to Exercise	**  or perform SRAM test				**Exercise:					** send a reply to the host			** exersise the i/o locations			** loop through i/o and memory r/w's		** support host Command mode (future)		**SRAM test:					** send a reply to the host			** write then read back the data in a page	**  of the SRAM ($6000-$60FF)			** if all is ok, change the data and do it again	** if an error happens flash the LED		**						** Also, last little things to do, like...	** fill the gap in the ROM with $FF's		** set up the interrupt vectors			**************************************************Card_test_code:**some test equates**factory_sig	equ	$3EE	;Factory signature will be placed herernd		equ	$3FE	;host will place the random number herehndsk		equ	$3FF	;handshake byte durring disk tests and exiting; initialize the processor; This may be redundant but the test code is a world to itself		sei				;disable interrupts, the hardware interrupts are tied inactive (to +5V)		cld				;binary mode, just to be sure		ldx	#$FF		txs				;init the stack pointer to $01FF;test the first few SRAM locations 'cos their used ALL the time and need to workzp_memory_test	ldx	#5		;set index for data offset and count of six@loop1		lda	MT_data1,x	;get some data		sta	zp1,x		;write it to zero page		dex			;done		bpl	@loop1		;no		ldx	#5		;yes, check the data@loop2		lda	MT_data1,x		cmp	zp1,x		;does the data check?		beq	@ok1		;yes		jmp	Card_error	;no@ok1		dex			;done		bpl	@loop2		;no		ldx	#5		;yes, do the inverse data now@loop3		lda	MT_data2,x	;get some inverted data		sta	zp1,x		;write it to zero page		dex			;done?		bpl	@loop3		;no		ldx	#5		;yes, check the data@loop4		lda	MT_data2,x		cmp	zp1,x		;does the data check?		beq	@ok2		;yes		jmp	Card_error	;no@ok2		dex			;done?		bpl	@loop4		;no; move the zero page data into the RAM (this will overwrite any previously used bytes)		jsr	Memory_move_zero_page_test	;move the zero page data from ROM to RAM; did it get there?		jsr	Memory_compare_zero_page		bcc	flip_in_host		;the compare was ok		jmp	Card_error		;the compare failed, let user know; move the host  $CC00 test codeflip_in_host	jsr	Memory_move_CC00_test	;move the host $CC00 code to the correct place;before we unlock the host make sure the Host will wait for test results; The Convention is:;	Host prints test message then waits.... (for non zero);	Card finishes puts out pass or fail code;	then waits for Host to return the value to zero before going to next test (or time out);;	The Card after its last test waits for the reboot code from host to re-init the card		stz	zp3			;Host should wait;unlock the host (assume the code is there)		stz	|UserPatch-Host_CnXX_Code+Host_CnXX_pseudoROM+1 ;relaese the Host;restore the infinite loops in Host_CnXX_Code code, for comparison purpose		lda	#$FE			;relative offset for infinite lockup loops		sta	|Bootptch1-Host_CnXX_Code+Host_CnXX_pseudoROM+1	;force branch to itself (restore)		sta	|Bootptch2-Host_CnXX_Code+Host_CnXX_pseudoROM+1	;force branch to itself	(restore); compare the host $CnXX and $CC00 code in ROM with RAM see if it got there		jsr	Memory_compare_CnXX	;do a simple check to make sure it is still there		bcc	@ok1			;the compare was ok		jmp	Card_error		;the compare failed, let user know@ok1		jsr	Memory_compare_CC00_test;do a simple check to make sure it got there		bcc	@ok2			;the compare was ok		jmp	Card_error		;the compare failed, let user know@ok2		jsr	Pass_handshake		;the test passed; perform a CRC on the ROM		jsr	CRC_ROM		bcc	@ok3			;passed the test		jmp	Card_error		;the compare failed, let user know@ok3		jsr	Pass_handshake		;the test passed		; perform a checksum on the ROM areas					jsr	Checksum_ROM		bcc	@ok4		jmp	Card_error@ok4		jsr	Pass_handshake		;the test passed; perform a SWIM test		jsr	SWIM_user_test		bcc	@ok5		jmp	Card_error@ok5		jsr	Pass_handshake		;the test passed; Perform a test on the remaining (unused) areas of RAM.;  This will test the cards 32K static RAM.;  Since the host's code has already been loaded;  and the host is running out of it these areas;  will not be disturbed, they have been checked;  once anyway. The stack now has nothing on it;  so it is ok to check it. The I/O page must also;  be skipped. So pages $0A, $7B through $7F;  ($7B and above, RAM only goes to $7FFF) must be skipped.;;  The RAM test performed will be to store a sequence;  of 16 bit pseudorandom numbers generated from the;  primitive polynomial into memory as words (two bytes per;  random number). Then the sequence will be regenerated;  and compared to the stored values, they should match.;  One more test sequence will be done this time the ;  sequence will be inverted to check the opposite states;  of the bits.;;  The generator polynomial, P(X)=X^16 + X^12 + X^3 + X + 1, will;  generate GF(2^16). The Galois field will be a 16 bit sequence;  of length (2^16 - 1), the only value skipped will be $0000, if;  the entire sequence is generated.;;  But, first check the two zero page locations that are used;  in the generation of the pseudorandom number sequence.;; zero page locations: zp1, zp2 and z_addr destroyed; A destroyed; X destroyedMemory_test	lda	#6		;the address of the byte following the zero page variables		sta	z_addr		;put it in the low byte of the address to start checking from here		stz	z_addr+1	;zero the high address byte, the data is in zero page		lda	#1		sta	zp1		stz	zp2 		;the pseudorandom seed value is $0001		;now it's time to write and generate the data@MT1		lda	#$0A		;I/O page		cmp	z_addr+1	;have we gotten to the first 'hole'?		bne	@MT2		;no		lda	#$0B		;yes, this is the next place to test		sta	z_addr+1	;change the page address@MT2		lda	#$7B		;page to stop at		cmp	z_addr+1	;are we done filling RAM?		beq	@MTC1		;yes, go do the compare		lda	zp1		;no, get the low random byte		sta	(z_addr)	;place it in RAM		inc	z_addr		;point to the next byte, never a carry must be an odd address		lda	zp2		;get the high random byte		sta	(z_addr)	;place it in RAM		inc	z_addr		;point to the next byte		bne	@MT3		;are we into a new page? branch if no		inc	z_addr+1	;yes, increment the page address@MT3		clc			;prepare to generate the next random number		rol	zp1		rol	zp2		;new 16 bit random number if no carry shifted out		bcc	@MT1		;no carry, continue filling RAM		lda	#$0B		eor	zp1		sta	zp1		;new random low byte		lda	#$10		eor	zp2		sta	zp2		;new random high byte		bra	@MT1		;continue filling RAM		@MTC1		lda	#6		;the address of the byte following the zero page variables		sta	z_addr		;put it in the low byte of the address to start checking from here		stz	z_addr+1	;zero the high address byte, the data is in zero page		lda	#1		sta	zp1		stz	zp2		;the pseudorandom seed value is $0001		;now it's time to re-generate the data and compare it to RAM@MTC2		lda	#$0A		;I/O page		cmp	z_addr+1	;have we gotten to the first 'hole'?		bne	@MTC3		;no		lda	#$0B		;yes, this is the next place to test		sta	z_addr+1	;change the page address@MTC3		lda	#$7B		;page to stop at		cmp	z_addr+1	;are we done checking RAM?		beq	@MT4		;yes, go test the inverse random data		lda	zp1		;no, get the low random byte		cmp	(z_addr)	;compare it to RAM, is it the same?		beq	@MTC4		;yes		jmp	Card_error	;no, the RAM's bad@MTC4		inc	z_addr		;point to the next byte, never a carry must be an odd address		lda	zp2		;get the high random byte		cmp	(z_addr)	;compare it to RAM, is it the same?		beq	@MTC5		;yes		jmp	Card_error	;no, the RAM's bad@MTC5		inc	z_addr		;point to the next byte		bne	@MTC6		;are we into a new page? branch if no		inc	z_addr+1	;yes, increment the page address@MTC6		clc			;prepare to generate the next random number		rol	zp1		rol	zp2		;new 16 bit random number if no carry shifted out		bcc	@MTC2		;no carry, continue filling RAM		lda	#$0B		eor	zp1		sta	zp1		;new random low byte		lda	#$10		eor	zp2		sta	zp2		;new random high byte		bra	@MTC2		;continue checking RAM		;so far so good now do the same test but this time invert the data@MT4		lda	#6		;the address of the byte following the zero page variables		sta	z_addr		;put it in the low byte of the address to start checking from here		stz	z_addr+1	;zero the high address byte, the data is in zero page		lda	#1		sta	zp1		stz	zp2		;the pseudorandom seed value is $0001		;now it's time to write and generate the data@MT5		lda	#$0A		;I/O page		cmp	z_addr+1	;have we gotten to the first 'hole'?		bne	@MT6		;no		lda	#$0B		;yes, this is the next place to test		sta	z_addr+1	;change the page address@MT6		lda	#$7B		;page to stop at		cmp	z_addr+1	;are we done filling RAM?		beq	@MTC7		;yes, go do the compare		lda	zp1		;no, get the low random byte		eor	#$FF		;invert it		sta	(z_addr)	;place it in RAM		inc	z_addr		;point to the next byte, never a carry must be an odd address		lda	zp2		;get the high random byte		eor	#$FF		;invert it		sta	(z_addr)	;place it in RAM		inc	z_addr		;point to the next byte		bne	@MT7		;are we into a new page? branch if no		inc	z_addr+1	;yes, increment the page address@MT7		clc			;prepare to generate the next random number		rol	zp1		rol	zp2		;new 16 bit random number if no carry shifted out		bcc	@MT5		;no carry, continue filling RAM		lda	#$0B		eor	zp1		sta	zp1		;new random low byte		lda	#$10		eor	zp2		sta	zp2		;new random high byte		bra	@MT5		;continue filling RAM		@MTC7		lda	#6		;the address of the byte following the zero page variables		sta	z_addr		;put it in the low byte of the address to start checking from here		stz	z_addr+1	;zero the high address byte, the data is in zero page		lda	#1		sta	zp1		stz	zp2		;the pseudorandom seed value is $0001		;now it's time to re-generate the data and compare it to RAM@MTC8		lda	#$0A		;I/O page		cmp	z_addr+1	;have we gotten to the first 'hole'?		bne	@MTC9		;no		lda	#$0B		;yes, this is the next place to test		sta	z_addr+1	;change the page address@MTC9		lda	#$7B		;page to stop at		cmp	z_addr+1	;are we done checking RAM?		beq	Verify_Host	;yes, the RAM test is completed go to the next section		lda	zp1		;no, get the low random byte		eor	#$FF		;invert it		cmp	(z_addr)	;compare it to RAM, is it the same?		beq	@MTC10		;yes		jmp	Card_error	;no, the RAM's bad@MTC10		inc	z_addr		;point to the next byte, never a carry must be an odd address		lda	zp2		;get the high random byte		eor	#$FF		;invert it		cmp	(z_addr)	;compare it to RAM, is it the same?		beq	@MTC11		;yes		jmp	Card_error	;no, the RAM's bad@MTC11		inc	z_addr		;point to the next byte		bne	@MTC12		;are we into a new page? branch if no		inc	z_addr+1	;yes, increment the page address@MTC12		clc			;prepare to generate the next random number		rol	zp1		rol	zp2		;new 16 bit random number if no carry shifted out		bcc	@MTC8		;no carry, continue filling RAM		lda	#$0B		eor	zp1		sta	zp1		;new random low byte		lda	#$10		eor	zp2		sta	zp2		;new random high byte		bra	@MTC8		;continue checking RAM;all the card tests have been performed.  Before we tell the host we passed the Card RAM test;we will copy the host test $CA00 code into $0200-$03FF, this will also set the NEW HANDSHAKE;location to zero.  Then its ok to fix the checksum byte.;Then wait for the Host to do it's thing and tell us to start the Disk tests or Exit.Verify_Host:;copy the Host bank #0 $CA00-$CBFF code segment into corresponding card area;do this before the checksum is generated		ldy	#0				;set the offsetcopy_test_CA00	lda	Host_CA00_test_physical,y	;get the data		sta	Host_CA00_pseudoROM,y		;put it in the RAM		lda	Host_CA00_test_physical+256,y	;get the data in the next page		sta	Host_CA00_pseudoROM+256,y	;put it in the RAM		dey					;point to another location		bne	copy_test_CA00			;not done;because we do a jsr instruction after the checksum is generated and before the host reads memory;we need to put on the stack the data the host will read		lda	#>jsr_label+2			;the future jsr high byte put on stack		pha					;put it on the stack		lda	#<jsr_label+2			;the future low byte put on stack		pha					;put it on the stack		pla		pla					;restore the stack pointer		; Put a complemented checksum in the top byte of host RAM for the host to check.;  The previous RAM test has left the RAM filled with random numbers.;  So if a checksum is generated and placed at the top of the host '$F' bank the;  the host can check its entire 'ROM' and RAM space,less the cards I/O bank ($0AXX),;  for reading all the data correctly.;;  the order in which the memory is to be added is:;	(1) $0006-$07FF;	(2) $0C00-$3FFF;	(3) $7C00-$7FFE 'hROM';	(4) $0B00-$0BFF;	(5) $7B00-$7BFF 'hROM';	(6) $0800-$09FE;  the complemented checksum will then be put into $09FF;;  the host will scan its memory in a corresponding order (see host code section);;  the stack area can't be changed until the host has verified the checksum;; A destroyed; X destroyed; Y destroyedck_add1		stz	zp1		;this is being used as the low byte of the indirect address		stz	zp2		;this is the high byte		lda	#0		;start the A at zero		ldy	#6		;start the offset at 6, the first six bytes will be skipped		stz	$09FF		;make sure that the last byte doesn't change the checksum@add2		clc			;get ready to do an add		adc	(zp1),y		;add the byte		iny			;point to the next byte		bne	@add2		;no need to inc the high byte of the adddress		inc	zp2		;the page needs to change		ldx	#$08		cpx	zp2		;are we done with range (1)?		bne	@add2		;no		ldx	#$0C		;starting page of next range		stx	zp2		;set the address pointer to range (2)@add3		clc			;bit bucket the carry		adc	(zp1),y		;add the byte		iny			;point to the next byte		bne	@add3		;no carry to worry about		inc	zp2		;the page must change		ldx	#$40		cpx	 zp2		;are we done with range (3)?		bne	@add3		;no		ldx	#$7C		;starting page of next range		stx	zp2		;set the address pointer to range (3)@add4		clc		adc	(zp1),y		;add the byte		iny			;point to the next byte		bne	@add4		;no carry to worry about		inc	zp2		;the page must change		ldx	#$7F		cpx	zp2		;are we done with the first part of range (3)?		bne	@add4		;no@add4b		clc		adc	(zp1),y		;add the byte		iny			;point to the next byte		cpy	#$FF		;are we done with rang (3)?		bne	@add4b		;no		iny			;yes, and the next section assumes Y is equal to zero					ldx	#$0B		;starting page of next range		stx	zp2		;set the address pointer to range (4)@add5		clc		adc	(zp1),y		;add the byte		iny			;point to the next location		bne	@add5		;still more					ldx	#$7B		;this is where the host $CnXX 'rom' space is		stx	zp2		;set the address pointer to range (5)@add6		clc		adc	(zp1),y		;add the byte		iny			;point to the next location		bne	@add6		;still more		ldx	#$08		;starting page of last range		stx	zp2		;set the address pointer to range (6)@add7		clc		adc	(zp1),y		;add the byte		iny			;point to the next byte		bne	@add7		;no carry to worry about		inc	zp2		;the page must change		ldx	#$0A		cpx	zp2		;are we done with range (6)?		bne	@add7		;no		eor	#$FF		;complement the checksum		sta	$09FF		;put the byte at the end of the hosts scan		lda	#pass_code	;passed the last card test		sta	zp3		;let the Host know and GO (last time we use OLD Handshake);wait for the host to do its tests and set up some locations before we read, or exit if host failsjsr_label	jsr	card_idle_disk	;wait... (or exit);lets go ahead and read		jsr	ColdStartup	;see what we have out there		lda	#$FF		sta	msg		;put the proper handshake data in zero page		stz	hndsk		;let the host inform the user about drive info		jsr	card_idle_disk	;wait for host.. to tell the user what we found;now we need to check to see if we are at the factoryfactory_id_ck	ldy	#15		;there are 16 bytes in the ID@factory	lda	factory_sig,y	;get the slot #1 data		cmp	factory_data,y	;is it a match		bne	@not_factory	;no		dey		bpl	@factory	;not done yet		jmp	@factory_pass	;we are at the factory@not_factory	lda	#fail_code		sta	hndsk		;tell the host to exit		jmp	Restart_loop	;wait for the user to exit;we are at the factory!;we need to write a sector read and check it then do it again w/ new data;but only if there is a drive@factory_pass	lda	numdevs		;are there any drives out there?		bne	factory_write	;yes, we can try writing		jmp	@not_factory	;no drives, wait for the user to exit		factory_write****************************************************************************************** init zero page for the write		lda	#01		sta	unitno		jsr	WrRdWrRd				lda	numdevs		cmp	#02		bcc	@only1Unit				lda	#02		sta	unitno		;set unit number for WrRdWrRd		jsr	WrRdWrRd		@only1Unit	lda	#fail_code		sta	hndsk		;tell the host to exit		jmp	Restart_loop	;wait for the user to exit*********************************************************************************************************************************************WrRdWrRd	jsr	@FillAllP1		jsr	@TstWrite		bcs	@exit		jsr	@TstRdBack		bcs	@exit		jsr	@FillAllP2		jsr	@TstWrite		bcs	@exit		jsr	@TstRdBack		stz	hndsk		;passed Wr Rd Wr Rd		lda	DeSelect	;deselet the drive		jsr	card_idle_disk	;wait for the host...		rts@exit		lda	blocknum		sta	blocknum+2		lda	blocknum+1		sta	blocknum+3		lda	#disk_fail_code	;failed let the user know then exit		sta	hndsk		lda	DeSelect	;deselet the drive		jmp	Restart_loop	;wait for the user to exit		@TstWrite	jsr	EnableGCR	;force SWIM back to GCR mode		lda	#02		sta	cmdmode		;suppress disk switched errors				lda	rnd		lsr	a		lda	rnd		stz	blocknum+1		rol	a		;rnd * 2 + lsb of rnd		sta	blocknum		rol	blocknum+1	;shift the carry into hi byte = 0..$1ff		lda	#$FF		sta	reply		;make reply negative like host would have		sta	TESTWRITE				lda	#02		sta	msg		;setup for a fake write block						jsr	CallCmd		;DoWrite will set reply = buffer number		stz	TESTWRITE		bcs	@skip1		lda	#$FF		sta	msg@skip1		lda	error		;did write work?		beq	@goodWr		sec		rts		@goodWr		lda	ramblk		jsr	SetCBptrs	;setup R0 and R2				ldy	#00@saveWrData	lda	(r0),y		sta	$400,y		lda	(r2),y		sta	$500,y		iny		bne	@saveWrData		clc		rts*********************************************************************************************************************************************@TstRdBack	jsr	EnableGCR	;always reset to GCR mode		lda	#01		sta	cmdmode		;now read it back		lda	rnd		lsr	a		lda	rnd		stz	blocknum+1		rol	a		;rnd * 2 + lsb of rnd		sta	blocknum		rol	blocknum+1	;shift the carry into hi byte = 0..$1ff		lda	#$FF		sta	reply			sta	CachLock				lda	#01		sta	msg		jsr	CallCmd		;do the read of the block (sets reply = buffer again)		lda	#$FE		sta	msg		lda	ramblk		jsr	SetCBptrs	;setup pointers again				lda	#$FF		sta	reply		lda	error		beq	@doVerify@RdBackFail	sec		rts		@doVerify	ldy	#00@verifyRdData	lda	(r0),y		cmp	$400,y		bne	@RdBackFail				lda	(r2),y		cmp	$500,y		bne	@RdBackFail		iny		bne	@verifyRdData		clc		rts@fillAllP2	ldy	#$C3		bra	@fillAll@FillAllP1	ldy	#$A5@fillAll	lda	#08@fillnext	jsr	@FillBufr		inc	a		cmp	#28		bcc	@Fillnext		rts@FillBufr	pha		jsr	SetCBptrs		tya		sec		phy		ldy	#00@fillLp		sta	(r0),y		sta	(r2),y		rol	A		iny		bne	@fillLp		ply		pla		rts*********************************************************;this is where the card synchronizes the coldstartRestart_loop	; read and write most RAM and ROM locations, this will also check the I/O decodes;;  the section for reading is:;	(R) $0000-$FFFF read the entire memory space;;  the sectons for writing are:;	(1) $0200-$0AFF skip zero page, the stack page and the host $CnXX area;	(2) $0C00-$7BFF skip skip the host $CC00-$CFFF area;	(3) $8000-$FFFF just to make sure the control lines are behaving ok;Test_loop	ldy	#0		sty	z_addr		sty	z_addr+1	;start the address and index at zero@loop1		lda	#$0A		;where the I/O (swim) might be		cmp	z_addr+1	;are we in the I/O page?		bne	@loop2		;no continue		tya			;get the low byte of the address		and	#%11000000	;is it I/O other than the swim?		bne	@loop2		;yes, continue		bra	@loop3		;its in the swim area so skip reading it@loop2		lda	(z_addr),y	;read the location@loop3		iny			;point to the next byte		bne	@loop1		;no need to do anything to the page		inc	z_addr+1	;point to the next page		bne	@loop1		;still more to read@restart	lda	hndsk		cmp	#reboot_code		;should we reboot?		bne	Restart_loop		;not yet waitRestart_loop1	lda	#clear_code		sta	hndsk			;tell the card to coldstart		sta	LEDon			;put the light back on for the power-up diags. to turn off		nop		nop		nop		nop				;pause a bit so the Host can begin the coldstart		jmp	InitCard		;START AGAIN*		v*v*v*v*> subroutines <*v*v*v*v***** card_idle_disk** wait for the host to tell us what happened*  if it is a pass then continue*  if it is a fail then coldstart*****card_idle_disk	lda	hndsk			;read the NEW handshake byte		cmp	#pass_code		;did it pass?		bne	@idle1			;no		rts				;yes, let the card continue@idle1		cmp	#fail_code		;did it fail?		bne	card_idle_disk		;no, continue...		pla				;yes, fix the stack		pla		jmp	Restart_loop		;go wait for the reboot***** Pass_handshake** tells the Host the test passed* and waits for a reply****Pass_handshake	lda	#pass_code		;passed this test		sta	zp3			;let the Host know@pass_loop	lda	zp3			;check for Host handshake		bne	@pass_loop		;not yet wait		rts***** SWIM_user_test** this will test* the SWIM****SWIM_user_test	bit	Q7L		;L7=0		bit	Q6L		;L6=0		bit	ca0off		;Phase0=0		bit	ca1off		;Phase1=0		bit	ca2off		;Phase2=0		bit	pulseoff	;Phase3=0		bit	Deselect	;Motor-on=0, the state register is now 0000	0x00		lda	Q7L		;read all ones register		cmp	#$FF		;did we read all ones?		beq	@all_ones_ok	;yes		sec			;error, set the carry		rts@all_ones_ok	lda	#%00011111	;ck 4 mode reg bit stuck at zero		bit	Q6H		sta	Q7H		;now in	mode set (write	mode register)		eor	Q7L		;verify	mode reg write (read status register), flip bits 0-4 to	0's		and	#%00011111	;are any of bits 0-4 not the same as written?		beq	@ok1		;no mode regs bits stuck at zero		sec			;error, set the carry		rts* now test for stuck at	1 bits@ok1		lda	#%00000000		sta	Q7H		;mode set (write mode register)		eor	Q7L		;verify	mode reg write (read status register), keep bits 0-4 as	0's		and	#%11111		;are any of bits 0-4 not the same as written?		beq	@moderegok	;no mode regs bits stuck at one		sec			;error, set the carry		rts@moderegok	lda	#%00001111		bit	Q6H		sta	Q7H		;mode set (write mode reg)		eor	Q7L		;read status reg		and	#%00011111	;are any of bits 0-4 not the same as written, is it in 7MHz?		beq	@ok2		sec			;error, set the carry		rts@ok2		lda	#%01001111		bit	Q6H		sta	Q7H		;mode set (write mode reg) :bit	6=1		eor	#%01000000	;A=$00001111		sta	Q7H		;mode set (write mode reg) :bit	6=0		eor	#%01000000	;A=$01001111		sta	Q7H		;mode set (write mode reg) :bit	6=1		sta	Q7H		;mode set (write mode reg) :bit	6=1 ISM	should be switched in		lda	#5@dly1		dec	a		bne	@dly1		;wait a	bit after mode switch		lda	ISMPhaseR		cmp	#$F0		;if it aint $F0	Not in ISM mode!		bne	@badISM		lda	IsmStatsR		and	#%11000000	;mask all but the two upper bits		cmp	#%01000000	;motor-on=0 and in ISM mode		bne	@badISM		stz	IsmMode0W	;don't change any bits but reset the p-RAM counter		lda	#1		;get ready to march 1's@walk1		sta	IsmParmsW	;store data in the parameter RAM		asl	A		;walk the 1		bcc	@walk1		;if not done with the 1's continue		lda	#%11111110	;get ready to walk 0's@walk0		sta	IsmParmsW	;store data in the parameter RAM		rol	A		;walk the 0		bcs	@walk0		;if not done with the 0's continue		stz	IsmMode0W	;don't change any bits but reset the p-RAM counter		lda	#1		;get ready to march 1's@walk3		cmp	IsmParmsR	;compare the data in the parameter RAM		bne	@badISM		;if it's not the same then error		asl	A		;walk the 1		bcc	@walk3		;if not done with the 1's continue		lda	#%11111110	;get ready to walk 0's@walk2		cmp	IsmParmsR	;compare data in the parameter RAM		bne	@badISM		;if it's not the same then error		sec			;reset the carry that was cleared during the compare		rol	A		;walk the 0		bcs	@walk2		;if not done with the 0's continue		bra	@ok3		;we must have passed the ISM tests@badISM		sec			;error, set the carry		rts@ok3		lda	#%11111000		sta	IsmMode0W	;reset to IWM mode please		bit	Q7L		bit	Q6L		;reset to read mode		bit	ca0off		bit	ca1off		bit	ca2off		bit	pulseoff		bit	Deselect	;the state register is now 0000	0x00		lda	Q7L		;read all ones register		cmp	#$FF		;did we read all ones?		beq	@all_ones_ok1	;yes		sec			;error, set the carry		rts@all_ones_ok1	lda	#%00011111	;ck 4 mode reg bit stuck at zero		bit	Q6H		sta	Q7H		;now in	mode set (write	mode register)		eor	Q7L		;verify	mode reg write (read status register), flip bits 0-4 to	0's		and	#%00011111	;are any of bits 0-4 not the same as written?		beq	@ok4		;no mode regs bits stuck at zero		sec			;error, set the carry		rts* now test for stuck at	1 bits@ok4		lda	#%00000000		sta	Q7H		;mode set (write mode register)		eor	Q7L		;verify	mode reg write (read status register), keep bits 0-4 as	0's		and	#%11111		;are any of bits 0-4 not the same as written?		beq	@ok5		;no mode regs bits stuck at one		sec			;error, set the carry		rts@ok5		lda	#%00001111		bit	Q6H		sta	Q7H		;mode set (write mode reg)		eor	Q7L		;read status reg		and	#%00011111	;are any of bits 0-4 not the same as written, is it in 7MHz?		bne	@swim_fail	;yes, failed the test		clc			;passed, clear the carry		rts@swim_fail	sec			;error, set the carry		rts***** Checksum_ROM** This  will sum all but one* byte in the ROM into a 16 bit* checksum.  The one byte left,* Checksum_word+1, is added to* the high byte of the checksum.* The result should be $0000***** The following zero_page locations are used (changed) BEWARE!ROM_adr		equ	$FE		;low byte of the ROM address pointerROM_adr_high	equ	$FF		;high byte of the ROM address pointerChecksum_ROM	stz	ROM_adr		;init the ROM_adr pointer to the start of ROM		lda	#>ROM_start	; assume the ROM is on a page boundry		sta	ROM_adr_high		lda	#0		;clear the low and		tax			; the high bytes of the checksum		tay			;start the offset at 0@add_0		clc		adc	(ROM_adr),y	;add the byte into the checksum		bcc	@add_1		;no carry, so high byte is ok		inx			;add the carry into the high byte@add_1		iny			;point to the next byte		bne	@add_0		;not done with page		inc	ROM_adr_high	;point to the next page		tay			;save the low checksum byte		lda	ROM_adr_high	;get the new page		inc	A		;is it the last page ($FF)?  Note:This is hard coded		beq	@add_2		;-yes, special case it		tya			;restore the low checksum byte		ldy	#0		;set the offset back to zero		bra	@add_0		;continue...@add_2		tya			;restore the low checksum byte		ldy	#0		;set the offset back to zero@add_3		clc		adc	(ROM_adr),y	;add the byte into the checksum		bcc	@add_4		;no carry, so high byte is ok		inx			;add the carry into the high byte@add_4		iny			;point to the next byte		beq	@add_5		;we are almost done		cpy	#<Checksum_word+1 ;are we about to add the high byte of the Checksum_word?		bne	@add_3		  ;-no, continue...		iny			  ;-yes, skip it (it will never be at locaton $XXFF)		bra	@add_3@add_5		tay			;set the flags		beq	@add_6		;the low checksum byte is zero, its ok		jmp	Error_found	;the low checksum byte is wrong, failed the test@add_6		txa			;get the high byte		clc		adc	Checksum_word+1	;add the high byte of the Checksum_word		beq	@add_7		;it's ok		sec			;failed, so set the carry		rts@add_7		clc			;passed, clear carry		rts***** CRC_ROM** This  will perform a 16 bit CRC* on all the bits in the ROM (except the last 2K bytes), in* groups of 16384 bits (2K bytes)* using the CRC-CCITT Code polynomial* g(x)=X^16 + X^12 + X^5 + 1,* then compare the results with* the precalculated CRCs.***** The following zero_page locations are used (changed) BEWARE!;ROM_adr	equ	$FE		;low byte of the ROM address pointer;ROM_adr_high	equ	$FF		;high byte of the ROM address pointerCRC_low		equ	$FC		;low byte of the 16 bit CRCCRC_high	equ	$FD		;high byte of the 16 bit CRC		MACRO		CRC_feedback		lda	#$21		eor	CRC_low		sta	CRC_low		;save low CRC byte		lda	#$10		eor	CRC_high	;xor completed and bit zero set to a 1		sta	CRC_high	;save high CRC byte		ENDM		MACRO		CRC_shift		clc		rol	CRC_low		;start the CRC shift assuming zero shifted it		rol	CRC_high	;finish the shift		ENDMCRC_ROM		stz	ROM_adr		;init the ROM_adr pointer to the start of ROM		lda	#>ROM_start	; assume the ROM is on a page boundry		sta	ROM_adr_high@CRC_ROM1	stz	CRC_low		;init the CRC to $0000		stz	CRC_high*bit 0@CRC0		CRC_shift		bcs	@carry0_1	;there was a carry		lda	(ROM_adr)	;there is no CRC carry, get the ROM data byte		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcc	@CRC1		;if bit 0 is zero then no feedback, check the next bit@carry0		CRC_feedback		;there is feedback		bra	@CRC1		;go and check next bit@carry0_1	lda	(ROM_adr)	;there is a CRC carry, get the ROM data byte		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC1		;if bit 0 is one then no feedback, check the next bit		bra	@carry0		;there is feedback go do it*bit 1@CRC1		CRC_shift		bcs	@carry1_1	;there was a carry		tya			;get the once shifted data		ror	A		;get bit 1 into the carry		tay			;save it		bcc	@CRC2		;if bit 1 is zero then no feedback, check the next bit@carry1		CRC_feedback		;there is feedback		bra	@CRC2		;go and check next bit@carry1_1	tya			;there is a CRC carry, get the once shifted data		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC2		;if bit 0 is one then no feedback, check the next bit		bra	@carry1		;there is feedback go do it*bit 2@CRC2		CRC_shift		bcs	@carry2_1	;there was a carry		tya			;get the twice shifted data		ror	A		;get bit 1 into the carry		tay			;save it		bcc	@CRC3		;if bit 1 is zero then no feedback, check the next bit@carry2		CRC_feedback		;there is feedback		bra	@CRC3		;go and check next bit@carry2_1	tya			;there is a CRC carry, get the twice shifted data		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC3		;if bit 0 is one then no feedback, check the next bit		bra	@carry2		;there is feedback go do it*bit 3@CRC3		CRC_shift		bcs	@carry3_1	;there was a carry		tya			;get the three times shifted data		ror	A		;get bit 1 into the carry		tay			;save it		bcc	@CRC4		;if bit 1 is zero then no feedback, check the next bit@carry3		CRC_feedback		;there is feedback		bra	@CRC4		;go and check next bit@carry3_1	tya			;there is a CRC carry, get the three times shifted data		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC4		;if bit 0 is one then no feedback, check the next bit		bra	@carry3		;there is feedback go do it*bit 4@CRC4		CRC_shift		bcs	@carry4_1	;there was a carry		tya			;get the four times shifted data		ror	A		;get bit 1 into the carry		tay			;save it		bcc	@CRC5		;if bit 1 is zero then no feedback, check the next bit@carry4		CRC_feedback		;there is feedback		bra	@CRC5		;go and check next bit@carry4_1	tya			;there is a CRC carry, get the four times shifted data		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC5		;if bit 0 is one then no feedback, check the next bit		bra	@carry4		;there is feedback go do it*bit 5@CRC5		CRC_shift		bcs	@carry5_1	;there was a carry		tya			;get the five times shifted data		ror	A		;get bit 1 into the carry		tay			;save it		bcc	@CRC6		;if bit 1 is zero then no feedback, check the next bit@carry5		CRC_feedback		;there is feedback		bra	@CRC6		;go and check next bit@carry5_1	tya			;there is a CRC carry, get the five times shifted data		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC6		;if bit 0 is one then no feedback, check the next bit		bra	@carry5		;there is feedback go do it*bit 6@CRC6		CRC_shift		bcs	@carry6_1	;there was a carry		tya			;get the six times shifted data		ror	A		;get bit 1 into the carry		tay			;save it		bcc	@CRC7		;if bit 1 is zero then no feedback, check the next bit@carry6		CRC_feedback		;there is feedback		bra	@CRC7		;go and check next bit@carry6_1	tya			;there is a CRC carry, get the six times shifted data		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC7		;if bit 0 is one then no feedback, check the next bit		bra	@carry6		;there is feedback go do it*bit 7@CRC7		CRC_shift		bcs	@carry7_1	;there was a carry		tya			;get the once shifted data		ror	A		;get bit 1 into the carry		tay			;save it		bcc	@CRC_next	;if bit 1 is zero then no feedback, done with this byte@carry7		CRC_feedback		;there is feedback		bra	@CRC_next	;done with this byte@carry7_1	tya			;there is a CRC carry, get the once shifted data		ror	A		;get bit 0 into the carry		tay			;save the shifted data in Y		bcs	@CRC_next	;if bit 0 is one then no feedback, done with this byte		bra	@carry7		;there is feedback go do it@CRC_next	inc	ROM_adr		;point to the next ROM byte		beq	@next_page	;we are in the next page		jmp	@CRC0		;-still in the same page continue@next_page	inc	ROM_adr_high	;change to the next page		lda	ROM_adr_high		sec		sbc	#>ROM_start	;subtract the start of rom from where we are		tax			;save it, we might need it		and	#%00000111	;are we at the next 2K chunk?		beq	@CRC_check	;-yes, check the results		jmp	@CRC0		;-no, contine...@CRC_check	txa			;get the next page location back		clc		ror	A		ror	A		ror	A		;divide by 8		dec	A		;and subtract one (this should give a range 0-14)		asl	A		;mutiply by two (two bytes per CRC)		tax			;put it in the X for an offset		lda	CRC_checkwords,x ;get the low byte of the expected CRC		cmp	CRC_low		;is it the same?		beq	@CRC_check1	;-yes, check the high byte@CRC_check0	sec			;-no, there is an ERROR		rts@CRC_check1	lda	CRC_checkwords+1,x ;get the high byte of the expected CRC		cmp	CRC_high	;is it the same?		bne	@CRC_check0	;-no, there is an ERROR		cpx	#$1C		;no error but are we done?		beq	@CRC_check2	;-yes, go on to next test		jmp	@CRC_ROM1	;-no, go check the next 2K chunk@CRC_check2	clc			;passed, clear carry		rts***** Memory_compare_CnXX** This subroutine will compare the $CnXX images in* ROM and RAM.  If they are the same then the carry* is cleared.  If they are different then the carry* is set.** A destroyed* X destroyed****Memory_compare_CnXX:		ldx	#0			;this will give a 256 byte move@comp_loop 	cpx	#<UserPatch-Host_CnXX_Code+1	;are we at the changed byte?							; remember when the card reads the next byte it will							; have been changed to a zero, this is the 'self							; modifying code byte', so use the correct data		bne	@compare		;no		lda	#0			;this is the changed data		bra	@compare1@compare	lda	Host_CnXX_Code,x	;get a byte of data from ROM@compare1	cmp	Host_CnXX_pseudoROM,x	;compare it with the RAM equivalent byte		bne	@comp_fail		;failed the compare		dex				;are we done?		bne	@comp_loop		;not done, continue the compare		clc				;successful compare clear the carry before returning		rts@comp_fail	sec				;compare error set the carry before returning		rts***** Memory_move_CC00_test** This subroutine will move the host test $CC00 code* from CC00_test_code to Host_CC00_pseudoROM for a length of 1024 bytes** A destroyed* X destroyed****Memory_move_CC00_test:		ldx	#0				;this will move 256 bytes@move_loop1	lda	Host_CC00_test_physical,x 	;get a byte of data		sta	Host_CC00_pseudoROM,x		;store it		dex					;are we done with the first loop?		bne	@move_loop1			;no@move_loop2	lda	Host_CC00_test_physical+256,x	;get a byte of data		sta	Host_CC00_pseudoROM+256,x	;store it		dex					;are we done with the second loop?		bne	@move_loop2			;no@move_loop3	lda	Host_CC00_test_physical+512,x	;get a byte of data		sta	Host_CC00_pseudoROM+512,x	;store it		dex					;are we done with the third loop?		bne	@move_loop3			;no@move_loop4	lda	Host_CC00_test_physical+768,x	;get a byte of data		sta	Host_CC00_pseudoROM+768,x	;store it		dex					;are we done with the fourth loop?		bne	@move_loop4			;no		rts***** Memory_compare_CC00_test** This subroutine will compare the $CC00 images in* ROM and RAM.  If they are the same then the carry* is cleared.  If they are different then the carry* is set.** A destroyed* X destroyed* Y destroyed****Memory_compare_CC00_test:		ldx	#0				;this will give a 256 byte compare@comp_loop1	lda	Host_CC00_test_physical,x	;get a byte of data from ROM		cmp	Host_CC00_pseudoROM,x		;compare it with the RAM equivalent byte		bne	@comp_fail			;failed the compare		dex					;are we done?		bne	@comp_loop1			;not done, continue the compare@comp_loop2	lda	Host_CC00_test_physical+256,x	;get a byte of data from ROM		cmp	Host_CC00_pseudoROM+256,x	;compare it with the RAM equivalent byte		bne	@comp_fail			;failed the compare		dex					;are we done?		bne	@comp_loop2			;not done, continue the compare@comp_loop3	lda	Host_CC00_test_physical+512,x	;get a byte of data from ROM		cmp	Host_CC00_pseudoROM+512,x	;compare it with the RAM equivalent byte		bne	@comp_fail			;failed the compare		dex					;are we done?		bne	@comp_loop3			;not done, continue the compare@comp_loop4	lda	Host_CC00_test_physical+768,x	;get a byte of data from ROM		cmp	Host_CC00_pseudoROM+768,x	;compare it with the RAM equivalent byte		bne	@comp_fail			;failed the compare		dex					;are we done?		bne	@comp_loop4			;not done, continue the compare		clc					;successful compare, clear the carry before returning		rts@comp_fail	sec					;compare error set the carry before returning		rts***** Memory_move_zero_page_test** This subroutine will move the zero page data* from zero_page_test_data to RAM_start for a length* of 256 bytes**	A destroyed*	X destroyed****Memory_move_zero_page_test:		ldx	#0			;this will give a 256 byte move@move_loop	lda	zero_page_test_data,x	;get a byte of data		sta	RAM_start,x		;store it		dex				;are we done?		bne	@move_loop		;not done, continue the move		rts***** Memory_compare_zero_page** This subroutine will compare the zero page images in* ROM and RAM.  If they are the same then the carry* is cleared.  If they are different then the carry* is set.** A destroyed* X destroyed****Memory_compare_zero_page:		ldx	#0			;this will give a 256 byte move@comp_loop 	lda	zero_page_test_data,x	;get a byte of data from ROM		cmp	0,x			;compare it with the RAM equivalent byte		bne	@comp_fail		;failed the compare		dex				;are we done?		bne	@comp_loop		;not done, continue the compare		clc				;successful compare clear the carry before returning		rts@comp_fail	sec				;compare error set the carry before returning		rts***** Card_error** Any card diagnostic that fails will jump into here so that* the user can be informed that all is not well.  The LED will* be flashed One long Two short, to differentiate it from other* places where errors are generated.*** Will send the fail_code to the host ** Will wait for the host to send the Reboot command, then * it will jump to its reset vector. If the first RAM test* fails then we will be stuck here (the host is still locked).****Card_error	lda	#fail_code	;we failed a test		sta	zp3		;tell the Host@card_err_loop	sta	LEDoff		ldx	#$0		;this will make the total time about .5 seconds@delay_st	lda	#$0		;this will wait approx 1ms, without using the stack.@delay		dec	A		;(2)		bne	@delay1		;(3)@delay1		nop			;(2)		nop		bne	@delay		;(3) = 10 * 203	= 2030		dex		bne	@delay_st		sta	LEDon		ldx	#$0		;this will make the total time about .9 seconds@delay_st1	lda	#$0		;this will wait approx 1ms, without using the stack.@delay2		dec	A		;(2)		bne	@delay3		;(3)@delay3		bne	@delay3_1	;(3)@delay3_1	bne	@delay3_2	;(3)@delay3_2	bne	@delay3_3	;(3)@delay3_3	bne	@delay3_4	;(3)@delay3_4	bne	@delay3_5	;(3)@delay3_5	nop			;(2)		bne	@delay2		;(3) = 10 * 203	= 2030		dex		bne	@delay_st1		sta	LEDoff		ldx	#$FF		;this will make the total time about .25 seconds@delay_st2	lda	#203		;this will wait approx 1ms, without using the stack.@delay4		dec	A		;(2)		bne	@delay5		;(3)@delay5		nop			;(2)		bne	@delay4		;(3) = 10 * 203	= 2030		dex		bne	@delay_st2		sta	LEDon		ldx	#150		;this will make the total time about .15 seconds@delay_st3	lda	#203		;this will wait approx 1ms, without using the stack.@delay6		dec	A		;(2)		bne	@delay7		;(3)@delay7		nop			;(2)		bne	@delay6		;(3) = 10 * 203	= 2030		dex		bne	@delay_st3		sta	LEDoff		ldx	#$FF		;this will make the total time about .25 seconds@delay_st4	lda	#203		;this will wait approx 1ms, without using the stack.@delay8		dec	A		;(2)		bne	@delay9		;(3)@delay9		nop			;(2)		bne	@delay8		;(3) = 10 * 203	= 2030		dex		bne	@delay_st4		sta	LEDon		ldx	#150		;this will make the total time about .15 seconds@delay_st5	lda	#203		;this will wait approx 1ms, without using the stack.@delay10	dec	A		;(2)		bne	@delay11	;(3)@delay11	nop			;(2)		bne	@delay10	;(3) = 10 * 203	= 2030		dex		bne	@delay_st5		sta	LEDoff;check for user ending the test here, rebooting		lda	hndsk		cmp	#reboot_code	;should we reboot		bne	@card_err_loop	;no, loop		jmp	Restart_loop1	;yes, go do it!PwrONDiag:*********************************************** Power	up diagnostics for NuMustang hardware************************************************ Assume, for now, ROM and RAM work and setup * critical host CnXX firmware space immediately!* This must be done before anything else* because this card must be recognized* as a disk card by the	Apple II monitor* cold start slot scan if card is boot device** Copy only the	bytes necessary	to look* like a disk card for slot scan purposes* with a lockup	infinite loop that will* hold host 'boot' until the hardware* diagnostics can be completed.***********************************************;only copy enough of the $CnXX code to halt the	host processor,; and do it backwords so that if all the disk ID bytes are seen	by the host; the infinite lockup loop must	already	be present		ldy	#Bootptch2+1-Host_CnXX_Code	;byte count through the 'hold loop'@wrcn		lda	Host_CnXX_Code,y		;get the code out of ROM		sta	Host_CnXX_pseudoROM,y		;put it into the host $CnXX pseudoROM area		dey		bpl	@wrcn** Simply reaching this point during pwron/reset* Necessarily implies that the CPU, ROM and the GAL* logic (selects and decoding) all function sufficiently* to execute Card code. This means we can properly* enable the ROM on the	data bus to fetch the reset* vector and execute instructions.*** The quick pwron checks include:* (if any of the tests fail the*  uncompleted tests are skipped)** 1. Checksum of the ROM contents** 2. Check the SWIM*    a. Check of the IWM registers*    b. Check switching into the ISM side*    c. Check ISM side registers*    d. Check switching back to the IWM side* * 3. Some checks of the	SRAM, without*    disturbing areas necessary for*    warmstart.****** Checksum_ROM_P (Power-up)** This  will sum all but one* byte in the ROM into a 16 bit* checksum.  The one byte left,* Checksum_word+1, is added to* the high byte of the checksum.* The result should be $0000***** The following zero_page locations are used (changed) BEWARE!;ROM_adr ($FE);ROM_adr_high ($FF)Checksum_ROM_P	stz	ROM_adr		;init the ROM_adr pointer to the start of ROM		lda	#>ROM_start	; assume the ROM is on a page boundry		sta	ROM_adr_high		lda	#0		;clear the low and		tax			; the high bytes of the checksum		tay			;start the offset at 0@add_0		clc		adc	(ROM_adr),y	;add the byte into the checksum		bcc	@add_1		;no carry, so high byte is ok		inx			;add the carry into the high byte@add_1		iny			;point to the next byte		bne	@add_0		;not done with page		inc	ROM_adr_high	;point to the next page		tay			;save the low checksum byte		lda	ROM_adr_high	;get the new page		inc	A		;is it the last page ($FF)?  Note:This is hard coded		beq	@add_2		;-yes, special case it		tya			;restore the low checksum byte		ldy	#0		;set the offset back to zero		bra	@add_0		;continue...@add_2		tya			;restore the low checksum byte		ldy	#0		;set the offset back to zero@add_3		clc		adc	(ROM_adr),y	;add the byte into the checksum		bcc	@add_4		;no carry, so high byte is ok		inx			;add the carry into the high byte@add_4		iny			;point to the next byte		beq	@add_5		;we are almost done		cpy	#<Checksum_word+1 ;are we about to add the high byte of the Checksum_word?		bne	@add_3		  ;-no, continue...		iny			  ;-yes, skip it (it will never be at locaton $XXFF)		bra	@add_3@add_5		tay			;set the flags		beq	@add_6		;the low checksum byte is zero, its ok		jmp	Error_found	;the low checksum byte is wrong, failed the test@add_6		txa			;get the high byte		clc		adc	Checksum_word+1	;add the high byte of the Checksum_word		beq	SWIM_test	;it's ok go on to next test		jmp	Error_found	;failed the test***** SWIM_test** this will test* the SWIM****SWIM_test	bit	Q7L		;L7=0		bit	Q6L		;L6=0		bit	ca0off		;Phase0=0		bit	ca1off		;Phase1=0		bit	ca2off		;Phase2=0		bit	pulseoff	;Phase3=0		bit	Deselect	;Motor-on=0, the state register is now 0000	0x00		lda	Q7L		;read all ones register		cmp	#$FF		;did we read all ones?		beq	@all_ones_ok	;yes		jmp	Error_found	;no failed the test@all_ones_ok	lda	#%00011111	;ck 4 mode reg bit stuck at zero		bit	Q6H		sta	Q7H		;now in	mode set (write	mode register)		eor	Q7L		;verify	mode reg write (read status register), flip bits 0-4 to	0's		and	#%00011111	;are any of bits 0-4 not the same as written?		beq	@ok1		;no mode regs bits stuck at zero		jmp	Error_found	;failed the test* now test for stuck at	1 bits@ok1		lda	#%00000000		sta	Q7H		;mode set (write mode register)		eor	Q7L		;verify	mode reg write (read status register), keep bits 0-4 as	0's		and	#%11111		;are any of bits 0-4 not the same as written?		beq	@moderegok	;no mode regs bits stuck at one		jmp	Error_found	;failed the test@moderegok	lda	#%00001111		bit	Q6H		sta	Q7H		;mode set (write mode reg)		eor	Q7L		;read status reg		and	#%00011111	;are any of bits 0-4 not the same as written, is it in 7MHz?		beq	@ok2		jmp	Error_found	;failed the test@ok2		lda	#%01001111		bit	Q6H		sta	Q7H		;mode set (write mode reg) :bit	6=1		eor	#%01000000	;A=$00001111		sta	Q7H		;mode set (write mode reg) :bit	6=0		eor	#%01000000	;A=$01001111		sta	Q7H		;mode set (write mode reg) :bit	6=1		sta	Q7H		;mode set (write mode reg) :bit	6=1 ISM	should be switched in		lda	#5@dly1		dec	a		bne	@dly1		;wait a	bit after mode switch		lda	ISMPhaseR		cmp	#$F0		;if it aint $F0	Not in ISM mode!		bne	@badISM		lda	IsmStatsR		and	#%11000000	;mask all but the two upper bits		cmp	#%01000000	;motor-on=0 and in ISM mode		bne	@badISM		stz	IsmMode0W	;don't change any bits but reset the p-RAM counter		lda	#1		;get ready to march 1's@walk1		sta	IsmParmsW	;store data in the parameter RAM		asl	A		;walk the 1		bcc	@walk1		;if not done with the 1's continue		lda	#%11111110	;get ready to walk 0's@walk0		sta	IsmParmsW	;store data in the parameter RAM		rol	A		;walk the 0		bcs	@walk0		;if not done with the 0's continue		stz	IsmMode0W	;don't change any bits but reset the p-RAM counter		lda	#1		;get ready to march 1's@walk3		cmp	IsmParmsR	;compare the data in the parameter RAM		bne	@badISM		;if it's not the same then error		asl	A		;walk the 1		bcc	@walk3		;if not done with the 1's continue		lda	#%11111110	;get ready to walk 0's@walk2		cmp	IsmParmsR	;compare data in the parameter RAM		bne	@badISM		;if it's not the same then error		sec			;reset the carry that was cleared during the compare		rol	A		;walk the 0		bcs	@walk2		;if not done with the 0's continue		bra	@ok3		;we must have passed the ISM tests@badISM		jmp	Error_found	;failed the test@ok3		lda	#%11111000		sta	IsmMode0W	;reset to IWM mode please		bit	Q7L		bit	Q6L		;reset to read mode		bit	ca0off		bit	ca1off		bit	ca2off		bit	pulseoff		bit	Deselect	;the state register is now 0000	0x00		lda	Q7L		;read all ones register		cmp	#$FF		;did we read all ones?		beq	@all_ones_ok1	;yes		jmp	Error_found	;no failed the test@all_ones_ok1	lda	#%00011111	;ck 4 mode reg bit stuck at zero		bit	Q6H		sta	Q7H		;now in	mode set (write	mode register)		eor	Q7L		;verify	mode reg write (read status register), flip bits 0-4 to	0's		and	#%00011111	;are any of bits 0-4 not the same as written?		beq	@ok4		;no mode regs bits stuck at zero		jmp	Error_found	;failed the test* now test for stuck at	1 bits@ok4		lda	#%00000000		sta	Q7H		;mode set (write mode register)		eor	Q7L		;verify	mode reg write (read status register), keep bits 0-4 as	0's		and	#%11111		;are any of bits 0-4 not the same as written?		beq	@ok5		;no mode regs bits stuck at one		jmp	Error_found	;failed the test@ok5		lda	#%00001111		bit	Q6H		sta	Q7H		;mode set (write mode reg)		eor	Q7L		;read status reg		and	#%00011111	;are any of bits 0-4 not the same as written, is it in 7MHz?		beq	SRAM_test		jmp	Error_found	;failed the test***** SRAM_test** this will test* selective ram locations****SRAM_test	lda	#0		;start with locaton and data of zero		tax@bank01		sta 	$0100,x		;fill the bank with data		inc	A				inx		bne	@bank01		lda	#1		sta	$0403		asl	A		;change the data		sta	$0503		asl	A		;change the data		sta	$0603		asl	A		;change the data		sta	$0803		asl	A		;change the data		sta	$1003		asl	A		;change the data		sta	$1203		asl	A		;change the data		sta	$2003		asl	A		;change the data		sta	$4003;check the data just written		lda	#1		cmp	$0403		beq	@bank05		jmp	Error_found	;failed the test@bank05		asl	A		;change the compare data		cmp	$0503		beq	@bank06		jmp	Error_found	;failed the test@bank06		asl	A		;change the compare data		cmp	$0603		beq	@bank08		jmp	Error_found	;failed the test@bank08		asl	A		;change the compare data		cmp	$0803		beq	@bank10		jmp	Error_found	;failed the test@bank10		asl	A		;change the compare data		cmp	$1003		beq	@bank12		jmp	Error_found	;failed the test@bank12		asl	A		;change the compare data		cmp	$1203		beq	@bank20		jmp	Error_found	;failed the test@bank20		asl	A		;change the compare data		cmp	$2003		beq	@bank40		jmp	Error_found	;failed the test@bank40		asl	A		;change the compare data		cmp	$4003		beq	@bank01ck		jmp	Error_found	;failed the test@bank01ck	lda	#0		tax@bank01ck1	cmp	$0100,x	;is it ok?		bne	@bank01err		inc	A		inx		bne	@bank01ck1		bra	@bank01_inv@bank01err	jmp	Error_found	;failed the test@bank01_inv	lda	#$FF		;start with inverse of $00		ldx	#0		;at location $00@bank01_inv1	sta	$0100,x		;fill the bank with inverse data		dec	A		inx		bne	@bank01_inv1		lda	#$FF		ldx	#0@bank01_inv_ck	cmp	$0100,x		;is it ok?		bne	@bank01_inv_err		dec	A		inx		bne	@bank01_inv_ck		bra	@ckeck_again@bank01_inv_err	jmp	Error_found	;failed the test@ckeck_again	lda	#1		cmp	$0403		beq	@bank05_		jmp	Error_found	;failed the test@bank05_	asl	A		;change the compare data		cmp	$0503		beq	@bank06_		jmp	Error_found	;failed the test@bank06_	asl	A		;change the compare data		cmp	$0603		beq	@bank08_		jmp	Error_found	;failed the test@bank08_	asl	A		;change the compare data		cmp	$0803		beq	@bank10_		jmp	Error_found	;failed the test@bank10_	asl	A		;change the compare data		cmp	$1003		beq	@bank12_		jmp	Error_found	;failed the test@bank12_	asl	A		;change the compare data		cmp	$1203		beq	@bank20_		jmp	Error_found	;failed the test@bank20_	asl	A		;change the compare data		cmp	$2003		beq	@bank40_		jmp	Error_found	;failed the test@bank40_	asl	A		;change the compare data		cmp	$4003		bne	Error_found	;failed the test		sta	LEDoff		;passed the tests so turn the light off		jmp	Begin		;return	without	using stackError_found	stz	Host_CnXX_pseudoROM+5	;change the third ProDOS signature byte					     	; the host may not have tried to boot us yet.		lda	#$4C			;JMP instruction to be place in the pseudoROM		sta	Host_CnXX_pseudoROM		sta	|Bootptch1-Host_CnXX_Code+Host_CnXX_pseudoROM+2		sta	|Bootptch2-Host_CnXX_Code+Host_CnXX_pseudoROM+2		lda	#$59						;low byte of OLD-MONitor entry point		sta	Host_CnXX_pseudoROM+1		sta	|Bootptch1-Host_CnXX_Code+Host_CnXX_pseudoROM+3		sta	|Bootptch2-Host_CnXX_Code+Host_CnXX_pseudoROM+3		lda	#$FF						;high byte of OLD-MONitor entry point		sta	Host_CnXX_pseudoROM+2		sta	|Bootptch1-Host_CnXX_Code+Host_CnXX_pseudoROM+4		sta	|Bootptch2-Host_CnXX_Code+Host_CnXX_pseudoROM+4		stz	|Bootptch1-Host_CnXX_Code+Host_CnXX_pseudoROM+1	;force branch to JMP		stz	|Bootptch2-Host_CnXX_Code+Host_CnXX_pseudoROM+1	;force branch to JMP		ldx	#Bootptch2-Host_CnXX_Code+Host_CnXX_pseudoROM+5@10		stz	Host_CnXX_pseudoROM,x	;zero out all the remaining $CnXX space, this should cause a BRK		inx		bne	@10		;not done with the page		Flash_error	sta	LEDoff		ldx	#$0		;this will make the total time about .5 seconds@delay_st	lda	#$0		;this will wait approx 1ms, without using the stack.@delay		dec	A		;(2)		bne	@delay1		;(3)@delay1		nop			;(2)		nop		bne	@delay		;(3) = 10 * 203	= 2030		dex		bne	@delay_st		sta	LEDon		ldx	#$0		;this will make the total time about .9 seconds@delay_st1	lda	#$0		;this will wait approx 1ms, without using the stack.@delay2		dec	A		;(2)		bne	@delay3		;(3)@delay3		bne	@delay3_1	;(3)@delay3_1	bne	@delay3_2	;(3)@delay3_2	bne	@delay3_3	;(3)@delay3_3	bne	@delay3_4	;(3)@delay3_4	bne	@delay3_5	;(3)@delay3_5	nop			;(2)		bne	@delay2		;(3) = 10 * 203	= 2030		dex		bne	@delay_st1		sta	LEDoff		ldx	#$FF		;this will make the total time about .25 seconds@delay_st2	lda	#203		;this will wait approx 1ms, without using the stack.@delay4		dec	A		;(2)		bne	@delay5		;(3)@delay5		nop			;(2)		bne	@delay4		;(3) = 10 * 203	= 2030		dex		bne	@delay_st2		sta	LEDon		ldx	#150		;this will make the total time about .15 seconds@delay_st3	lda	#203		;this will wait approx 1ms, without using the stack.@delay6		dec	A		;(2)		bne	@delay7		;(3)@delay7		nop			;(2)		bne	@delay6		;(3) = 10 * 203	= 2030		dex		bne	@delay_st3		sta	LEDoff		jmp	Flash_error	;loop forvever***** Data for user/factory diagnostics RAM test****MT_data1	DC.B $00, $FF, $55, $AA, $CC, $33 ;Data for testing the four locations used inMT_data2	DC.B $FF, $00, $AA, $55, $33, $CC ; the begining of Memory_test.factory_data	DC.B $4C, $59, $FF, 'AVEX Manufact'************************************************** Fill_ROM_gap					**						** this will fill the gap between the end of 	** the Self_Test code and the start of		** the Card_code	with $00's 			**************************************************fill_length	equ	Card_code_start-(*-UserTest+256+256+512+1024+256+512+1024+ROM_start)		DCB.B	fill_length,$00  ;causes BRK if PC goes wild 		ENDP