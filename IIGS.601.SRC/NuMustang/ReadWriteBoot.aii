		eject*	Read_Write Block and Boot Commands******************************************************** DoRWByts** See if the Read/WriteBytes cmd could apply to	the * local	unit and its current volume.*******************************************************DoRWByts	equ	*		lda	#BadUnit		ldx	unit_num		bpl	@05@DoErr		jmp	DoErr@05		jsr	EnblnChk	;check drive and vol status		bpl	@10		jsr	mountVol	;gotta do this now@10		bcs	@DoErr		;volume	offline/Disk Switch error* need to know voltype for this	call		lda	voltype,y		cmp	#AD800K		beq	@20		cmp	#AD400K		beq	@20		lda	#IOError		jmp	DoErr@20		lda	xfrcnt+1		cmp	#>524		beq	@30@25		jmp	BadParmErr@30		lda	xfrcnt		cmp	#<524		bne	@25* now do 524 byte block	read and write on local	unit		lda	Blocknum+2		sta	blocknum		lda	blocknum+3		sta	blocknum+1		stz	blocknum+2		stz	blocknum+3	;shift 'address' to blocknum		dec	tagsflag	;tell em 524 byte 				lda	#wrblk		sta	ramblk		lda	msg		cmp	#read		beq	@readbyts		jmp	DoWrite		;go duddly go@readbyts	equ	*		jsr	Aread		bcs	@bye* Now the 12 tag bytes must be merged with the 512 byte	block* which	was read into the upper	buffer 		ldy	#12-1@movthe12	lda	rwbuf12,y		sta	wrblkadd,y		dey		bpl	@movthe12		ldy	#0@mv512		lda	wrblkadd+512,y		sta	wrblkadd+12,y		lda	wrblkadd+512+256,y		sta	wrblkadd+12+256,y		iny			;must inc cuz of mov down overlap		bne	@mv512* now that all the data	is available tell host firmware		lda	ramblk		;tell em which block (more or less)		stz	error		sta	reply@bye		clc			;normal	return		rts************************************ Aread***********************************Aread		equ	*		jsr	ChkBlk		bcs	@errexit	;bad blocknum* Now read a sector and	patch pieces together afterwards		lda	#6		sta	errcnt		stz	MFMflag		;make its a GCR read		jsr	U35MtrOn	;turn motor and	IFF chuckwait(500ms)		jsr	Blk2SCS		;convert blocknum to side,cyl,sector		bcs	@errexit	;bad blk xlate?		asl	a		;Blk2SCS returns sects/track in	A-reg		asl	a		asl	a		;allow Sect/trk	* 8 AdrsMarks to pass		sta	sectcnt		;by the	head before 'nosect found' err@doseek		jsr	Seek		;Seek to cyl IFF  (recal IFF also)		bcs	@IOerr		;recal error so	return IOERROR@erretry	lda	ramblk		;(set by caller)		jsr	SetCBptrs	;setup R0&R2 for the buffer		jsr	WaitReady	;wait for drive	/READY status@lookagn	jsr	GetAddr		;get address of	current	sector		bcc	@rddsk		;if no error, keep going		jsr	DoErr2		;update	error counters		bcs	@IOerr		;if too	many, give it up		bit	#cylerror	;if wrong track, retry seek		bne	@doseek		;retry seek		bit	#nomkerror	;no adrs mark		beq	@80		jsr	recal		;recal it 		bcc	@doseek		;recal ok @80		bit	#adrerror	;bad adrs mark?		beq	@IOerr@itsnot		dec	sectcnt		bne	@lookagn@IOerr		lda	#IOError	;couldn't read@errexit	jsr	DoErr		sec		rts@rddsk		lda	SectFnd		;check if its the sector I want		cmp	sector		bne	@itsnot		;keep waiting		jsr	ReadData	;read only the right one		bcc	@ok		;if good, keep going		jsr	DoErr2		;update	error counters		bcc	@erretry	;if not	too many, try another block		bra	@IOerr		;if too	many, it's all over@ok		equ	*		clc			;normal	return		rts****************************************************************** DoRead*	 This routine first checks to see if the requested unit * still	has a volume mounted that has not been switched. If so,* the cache is examined	to see if the block can	be returned* without reading the volume. * If the block is not in the cache then	the block and possibly the * adjacent ones	on the same cylinder are read into the cache* *	 eats: A,X,Y******************************************************************DoRead		equ	*		lda	#BadUnit		ldx	unit_num		bpl	@01@err1		jmp	Doerr@01		jsr	EnblnChk	;enable	and check errors		bpl	@10		;got a known volume		jsr	mountvol	;gotta do the logical volume mount@10		bcs	@err1		;offline or IFF	disk switched error* Can't check blknum until voltype known		jsr	ChkBlk		;see if	block is a legal value		bcs	@err1		;badblk	error		lda	#$80		sta	DrvrFlag	;indicate that sector not yet found		* Now setup the ISM with 16M clk and params if this is MFM volume		ldx	unit_num		lda	#UMmfmHD+UMmfmDD	;fdhd bit mask		bit	unitmode,x		;is this MFM volume 		beq	@notMFMvol		bit	tagsflag		;is this a read/write bytes CMD?		bpl	@mfmok		;no* later this should generate 12 fake tag bytes and add 12 to the buffer pointer * fake tag bytes to read "John Arkley!"		lda	#badctrl		;WRONG MEDIA TYPE for now		sta	statbyte		rts@mfmok		jsr	EnableMFM	;enable MFM mode and switch to 16M FCLK@notMFMvol	EQU	*		jsr	Blk2SCS		;convert blocknum to side,cyl,sector		bcs	@err1		;bad blk xlate?		sta	curNsect	;save sects/track		and	#%10000		asl	a		adc	#96		sta	adrerrcnt	;allow  lots of adrs mark errors		jsr	InCache		;see if	SCS is already in ramcache		bcc	@nohit		; enable cache		sta	reply		;if it is, put ram blk number in reply		clc			;normal	return		rts@nohit		equ	*		lda	#6		sta	errcnt		;6 retries on the reqsted sector		lda	#4		sta	reseekcnt	;3 reseeks to the cyl		lda	#20		sta	Cerrcnt		;20 I/O	errors on cache	sectors		jsr	U35MtrOn	;turn motor and	IFF chuckwait(500ms)				lda	#00		sta	minCsect				lda	curNsect		sta	maxCsect	;= largest sector number + 1		dec	a		;don't include the target sector in the cache count		sta	sectcnt		; max cache count*		lda	#$C0		ldx	curNsect@zlp		sta	sectrtbl,x	;mark sector as	"don't cache"		cpx	minCsect		bcc	@z10		cpx	maxCsect		bcs	@z10		stz	sectrtbl,x	;mark sector as	not yet	cached@z10		dex		bpl	@zlp		lda	cachlock		sta	Cstate		;setup caching state control		bra	@reseek		;and begin@recal		jsr	recal		bcs	@IOerr		;recal error!@reseek		dec	reseekcnt		bmi	@IOerr		jsr	Seek		;Seek to cyl IFF  (recal IFF also)		bcs	@IOerr		;recal error so	return IOERROR		jsr	WaitRdyTO	;wait /READY or	timeout		bcc	@findadrs	;it ready now!@offl		lda	#Offline		bra	@errxit		;if never ready	report offline err@findadrs	stz	error2		;clear error result		jsr	GetAddr		;find the next adrs mark on track		bcc	@rddsk		;if no error, keep going* GetAddr checks for side and cylinder match		lda	error2		bit	#cylerror	;if wrong track, retry seek		bne	@reseek		;retry seek		bit	#adrerror	;bad adrs mark?		beq	@20		;no.* adrs mark checksum, bit-slip or wrong side error		dec	adrerrcnt		beq	@IOerr		lda	adrerrcnt		and	#%00111111	;allow recal at least twice		lsr	a		;drop lsb and check against curNsect		cmp	curNsect		beq	@chkrecal		bit	#siderror		beq	@findadrs	; if not wrong side error		bra	@reseek		; if Wrong Side error the reseek@chkrecal	bit	Cstate		bvc	@recal		;ok to recal before rqst done** exit after Reply already given so don't set msg or reply again@postReplyexit	jsr	SelectIWM	;switch to IWM iff mfm mode		sec			;no recal during post rqst caching		rts			;cuz it	takes too much time* here if couldn't find any address marks at all@20		bit	#nomkerror	;can't find anything on track?		beq	@IOerr		;bail out if other (assumed fatal) err		bit	Cstate		;request done?		bvs	@postReplyexit	;yep. ignore after rqst	done.		lda	#dskin		;have I	still got media?		jsr	ReadBit		bcs	@offl		;nope. kiss it off		dec	reseekcnt		bmi	@IOerr		;too many		jsr	recal		;move back to trk 00		stz	error2		jsr	GetAddr		;can I read adrsmrk on trk00		bcc	@reseek		;yes. re seek to track* Disk-In-Place	is True	but can't read any * address marks	in the current mode! 		ldx	unit_num	;can't read adrsmrks on Trk00 so		jsr	UnMountX	;so zap	voltype,mode,stat,blks,curcyl@IOerr		lda	#IOError	;couldn't read@errxit		bit	Cstate		;post rqst error?		bvs	@postReplyexit	;yes. can't clear msg again		jmp	DoErr		;no. so	return normal@rddsk		ldx	SectFnd		;get the sector number found (0..n-1)		cpx	sector		;is this the reqsted sector?		bne	@cachread	;go do a caching read		bit	Cstate		;already returned the request?		bvs	@postReplyexit	;yes. stop caching and just poll rtrn		jsr	AllocCbuf	;get adrs of buffr for read (sets ramblk for GS/OS driver)		stz	DrvrFlag	; tell GS/OS driver sector coming NOW		jsr	ReadData	;read the requested sector		bcc	@reply		jsr	DoErr2		;count retires on the rqsted sect only		bcs	@IOerr		;bail out if too many retries		bra	@finda1@reply		lda	ramblk		sta	reply		lda	sectcnt		ora	#$80		;tell host how much caching left to do		sta	msg		;reset msg so next req may happen		lda	#$40		tsb	Cstate		;set the reqst done bit		bra	@nextsect* Now have a sector other than requested one@cachread	bit	Cstate		;caching allowed?		bmi	@finda1		;no. just get next adrsmark		bit	sectrtbl,x	;already or not-to-be cached?		bvs	@noncache	;yes. just idle	for a while		ldy	sect2Cndx,x		lda	cachunit-1,y		bmi	@doit		;empty slot		cmp	unit_num		bne	@doit		;some other unit has this one		lda	cachtrk-1,y		cmp	trk		;same cyl+side?		bne	@doit		;no. so	go cache it		lda	cachsect-1,y		cmp	SectFnd		;is the	one here same sect#		bne	@doit		;no. so	cache it		lda	#$40		sta	sectrtbl,x	;mark it as done if already cached		bra	@70@noncache	bit	Cstate		;is reqst done yet?		bvc	@finda1		;no. just keep looking* during a sector I am not caching look	for user reqst		ldx	#8		;spend next 8 ms looking for cmd@waitc		lda	#204@waitcmd	bit	msg		;+03		bpl	@done		;+05 return and	process	cmd		dec	a		;+07		bne	@waitcmd	;+10		dex		bne	@waitc		bra	@finda1		;ok now	find next adrsmark@doit		jsr	AllocCbuf	;setup adrses for sector in X		jsr	ReadData	; cache	a sector in its	buffer		bcc	@nextsect	;read it ok so remember	it		dec	Cerrcnt		;count caching errors		bpl	@70		;go see if rqst done yet?		lda	#$80		tsb	Cstate		;turn caching off if too many errors		bra	@70		;go see if request done@nextsect	ldx	SectFnd		;same as sector	for rqsted one		lda	#$40		sta	sectrtbl,x	;mark is as cached		lda	SectFnd		;sectFnd in A		jsr	CacheSCA	;mark it as in the cache		bcc	@70@IOErr1		jmp	@IOerr@70		bit	Cstate		;is the	request	done yet?		bvc	@finda1		;continue until	rqstd found		bmi	@done		;caching not allowed or terminated. so quit		dec	sectcnt		;all the sectors in the cache?		beq	@done		;yep.		lda	msg		;has a 2nd request arrived after 1st reply?		bpl	@done		@finda1		jsr	SelectIWM	;switch back to IWM if in mfm mode		dec	adrerrcnt	;count down good sectors I don't want too		beq	@IOErr1			jmp	@Findadrs	;no so keep caching until rqst@done		jsr	SelectIWM	;switch back to IWM iff mfm mode		bit	Cstate		bvs	@99		clc		rts@99		sec		rts		eject;******************************************************; DoWrite;	 This routine waits til	it finds the right block on the; disk and then	writes the data	in the given ram block to that; block	on the disk.;;	 eats: A,X,Y;;*****************************************************DoWrite		equ	*		lda	#BadUnit		ldx	unit_num		bmi	@err1		;can't write unit zero		jsr	EnblnChk	;sense and check for errors		bpl	@10		jsr	MountVol	;gotta do the logical mount @10		bcc	@noerr		;no offline/switched error@err1		jmp	Doerr@noerr		bne	@err1		;if NE Then disk is write protected		jsr	ChkBlk		;see if	block is a legal value		bcs	@err1		;badblk	error		* Now setup the ISM with 16M clk and params if this is MFM volume		ldx	unit_num		lda	#UMmfmHD+UMmfmDD	;fdhd bit mask		bit	unitmode,x		;is this MFM volume 		beq	@notMFMvol		bit	tagsflag		;is this a read/write bytes CMD?		bpl	@mfmok		;no* later this should generate 12 fake tag bytes and add 12 to the buffer pointer * fake tag bytes to read "John Arkley!"		lda	#badctrl		;WRONG MEDIA TYPE for now		sta	statbyte		rts@mfmok		jsr	EnableMFM	;enable MFM modes and switch on 16M FCLK@notMFMvol	EQU	*		lda	#6		;number	of errors that we'll allow		sta	errcnt		;		lda	#3		sta	reseekcnt		jsr	Blk2SCS		;convert blocknum to side,cyl,sector		bcs	@err1		;bad blk xlate?		sta	curNsect			and	#%11000		asl	a		adc	#96		sta	adrerrcnt	; allow lots of adrs marks				ldx	sector		;get sector number to be written		jsr	AllocCBuf	;use the same buffer used for read caching		stz	syncflag		bit	TESTWRITE	;is this a testWrite for diagnostics?		bmi	@nosync		bit	Card_isIIgs	;is host a IIgs?		bvc	@nosync		;nope		bit	tagsflag	;524 case?		bmi	@nosync		bit	mfmflag			bmi	@nosync		dec	syncflag	;tell host if write xfer is to be syncronous@nosync		lda	ramblk		sta	reply		;tell host to fill the buffer with the new data		jsr	U35MtrON	;enable	the motor if blknum is ok			jsr	Seek		;Seek to the cyl IFF (and recal	IFF)		bcs	@IOerr		;recal error (no track zero)		bit	TESTWRITE	;UserTest doing a Write to disk in factory diag mode?		bmi	@do512		;YES. (Factory test doesn't call WriteBytes cmd)		bit	syncflag	;should I wait for reply?		bmi	@overlapWP	;no overlap xfer and WritePrep		@wtld		lda	reply		;see if	data has been loaded		bpl	@wtld		;if not, wait until it is all there		@overlapWP	bit	tagsflag		bpl	@do512		jsr	WrtPrep524	;write prep with tags		bra	@wrdy@do512		jsr	WrtPrep512	;calc check sums and code data@wrdy		jsr	WaitRdyTO	;It should be ready by now		bcc	@findadrs@offline	lda	#Offline	;didn't become ready within 3 seconds?		bra	@errAxit************************************************************************ WARNING:  Changing the "sucessful" code path between the "jsr GetAddr"* 	    and the @Write Label below may effect the MFM "SpliceCnt" delay *	    equate that is selected to put the mfm Write Splice as close* 	    as possible to the end of the Gap after the address field*		(see equates file and WriteMFMData routine for more specifics)***********************************************************************@findadrs	jsr	GetAddr		;get address of	current	sector		bcc	@chkaddr	;if no error, keep going* here if wrong	cylinder/ wrong side/ no Mark found / chksum-bitslip error		lda	error2		bit	#cylerror	;if bad	track, need to seek again		bne	@reseek		;retry seek		bit	#adrerror	;bad adrs mark?		beq	@20		;nope		dec	adrerrcnt	;count down bad adrs marks		beq	@IOerr		lda	adrerrcnt		and	#%00111111	;allow recal at least twice		lsr	a		;drop lsb and check against curNsect		cmp	curNsect		beq	@recal		bit	#siderror		beq	@findadrs	; if not wrong side error		bra	@reseek		; if Wrong Side error the reseek@recal		jsr	Recal		bcs	@IOerr@reseek		dec	reseekcnt		bmi	@IOerr		jsr	Seek		;reSeek 		bcc	@wrdy		bra	@IOerr@20		bit	#nomkerror	;can't find anything?		beq	@IOerr		;bail out for any other error		lda	#dskin		jsr	ReadBit		;is media still there?		bcs	@offline	;nope. so kiss it off		bra	@recal		;do my best to find the track@chkaddr	lda	SectFnd		;get the sector	number from adrsmrk		cmp	sector		;compare to the	one we're looking for		beq	@Write		;if its	the one, go write it		dec	adrerrcnt	;count off the good but not requested sectors		beq	@IOerr		jsr	SelectIWM	;switch back to ISM side		bra	@findadrs@Write		jsr	WriteData	;write the data	to the disk		bcs	@IOerr		;no Write Underrun error		bit	TESTWRITE		bmi	@nocache		lda	sector		jsr	CacheSCA	;mark the cache entry as valid@nocache	clc		rts@IOerr		lda	#IOError@errAxit	sta	error@writDone	clc			;normal	return		rts* "BOOT	'command' ROUTINE"****************************************************************** BOOT requested of unit zero	 * DoBoot will boot from	unit 1 ** (unless DiskII support included and then will	  * only boot if unit 1 is NOT a disk II drive)*****************************************************************DoBoot		equ	*		stz	error		stz	side		;block 0 is on side 0		stz	cyl		;  on track 0		stz	trk		jsr	ClearCache	;clear the cache all units!		lda	#read		;show as a BlkDev protocol read	cmd		sta	msg		;		ora	#$80		sta	cmdmode		;		stz	blocknum	;we want block 0		stz	blocknum+1	;		stz	blocknum+2	;		stz	unit_num	;set unit_num for Local device boot		lda	#01		sta	unitno		;set unitno for CBUS unit #1 boot		stz	drive		ldx	drive		lda	unittype,x		beq	@NoDrives		bmi	@remboot	;A = unitmode byte* Boot from local unit		jsr	UnMountX	;make it remount the volume for read		jmp	CallLocal	;read block 0* Boot from remote unit@remboot	lda	#255		jsr	Wait2Ms		jmp	CallRemote	;call the CBUS driver@NoDrives	equ	*		lda	#NoDrive	;return a Device Not Conntected Error		sta	error		stz	reply		clc			;normal	return		rtsalignpg1	EQU	(*-Card_code)	and $FF		DCB.B	$100-alignpg1,$00 ;align to next page* 		"GCR LookUp Tables "ashift		EQU	*		DCB.B	16,$00		DCB.B	16,$40		DCB.B	16,$80		DCB.B	16,$C0bshift		EQU	*		DC.W	$0000,$0000,$4040,$4040,$8080,$8080,$C0C0,$C0C0		DC.W	$0000,$0000,$4040,$4040,$8080,$8080,$C0C0,$C0C0		DC.W	$0000,$0000,$4040,$4040,$8080,$8080,$C0C0,$C0C0		DC.W	$0000,$0000,$4040,$4040,$8080,$8080,$C0C0,$C0C0cshift		equ	*		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0		DC.B	$00,$40,$80,$C0,$00,$40,$80,$C0***********************************************************************	Do Block Calc "N"**	Computes how many logical blocks are on the track *	that contains the input block number and blockcnt**  INPUT	: blocknum (4 bytes; 2 used)*		: blockcnt (2 bytes)*  OUTPUT	: xfrcnt   (2 bytes) ***********************************************************************		ejectDoBlkCalcN	equ	*		lda	#BadUnit		ldx	unit_num		bpl	@01@err1		jmp	Doerr@01		jsr	EnblnChk	;enable	and check errors		bpl	@10		;got a known volume		jsr	mountvol	;gotta do the logical volume mount@10		bcs	@err1		;offline or IFF	disk switched error* Can't check blknum until voltype known		jsr	ChkBlk		;see if	block is a legal value		bcs	@err1		;badblk	error		lda	#$80		sta	DrvrFlag	;indicate that sector not yet found		* Now setup the ISM with 16M clk and params if this is MFM volume		ldx	unit_num		lda	#UMmfmHD+UMmfmDD	;fdhd bit mask		bit	unitmode,x		;is this MFM volume 		beq	@notMFMvol@mfmok		jsr	EnableMFM	;enable MFM mode and switch to 16M FCLK@notMFMvol	EQU	*		lda	blocknum+1		pha		lda	blocknum		pha		clc		adc	blockcnt		sta 	blocknum		lda	blocknum+1		adc	blockcnt+1		sta	blocknum		jsr	ChkBlk		;is the implied ending blocknum vaild?		bcs	@err1		;nope. give error now so driver knows up front		pla		sta	blocknum		pla		sta	blocknum+1	;restore starting blocknum		jsr	Blk2SCS		;convert blocknum to side,cyl,sector		bcs	@err1		;bad blk xlate?		sta	curNsect	;save sects/track		stz	xfrcnt+1	;zero the upper byte		lda	curNsect	;    8/9/10/11/12/18/9 		sec			; less		sbc	sector		;(0..7/8/9/10/11/17/8)		sta	sectcnt		;this is max number of sects I can get on this trk		ldy	blockcnt+1	;is blockcnt > 255		bne	@20		;yep. so all of em count		cmp	blockcnt	;is availcnt <= blockcnt?		beq	@20		bcc	@20		; yep. so all of em count		lda	blockcnt	;nope. return blockcnt since its smaller@20		sta	xfrcnt		;return the resulting block count on this track		stz	reply		;indicate result now in zero page		lda	#$FF		sta	msg		;make ready for next cmd** Delay a while looking for ReadNBlks cmd before giving up and deSelecting the drive		lda	#05		sta	r1h		stz	r1l@wait		dec	r1l		bne	@wtmsg		dec	r1h		bmi	@quit@wtmsg		lda	msg		;has the next cmd arrived yet?		bmi	@wait		;nope. keep waiting a while for GS/OS driver@quit		sec		rts		eject***********************************************************************		Reads N block all on same track for any volume type**  INPUT	: blocknum	first desired block*		: blockcnt	number of desired blocks*  OUTPUT	: Trkvector[blockcnt]*			each entry contains zero until that block is read*			contains buffer number when block in the buffer*			set to $FF when buffer emptied by GS/OS driver*			set to $80..AF if I/O error for that block*		: xfrcnt := count of requested block that have been read*		: reply contains error code if all blocks are not on same track*	***********************************************************************DoReadNBlks	equ	*		lda	#BadUnit		ldx	unit_num		bpl	@01@err1		jmp	Doerr@01		jsr	EnblnChk	;enable	and check errors		bpl	@10		;got a known volume		jsr	mountvol	;gotta do the logical volume mount@10		bcs	@err1		;offline or IFF	disk switched error* Can't check blknum until voltype known		jsr	ChkBlk		;see if	begin block is a legal value		bcs	@err1		;badblk	error		lda	#$80		sta	DrvrFlag	;indicate that sector not yet found		* Now setup the ISM with 16M clk and params if this is MFM volume		ldx	unit_num		lda	#UMmfmHD+UMmfmDD	;fdhd bit mask		bit	unitmode,x		;is this MFM volume 		beq	@notMFMvol@mfmok		jsr	EnableMFM	;enable MFM mode and switch to 16M FCLK@notMFMvol	EQU	*		jsr	Blk2SCS		;convert begin blocknum to side,cyl,sector		bcs	@err1		;bad blk xlate?		sta	curNsect	;save sects/track		lda	sector		sta	begsect		lda	trk		sta	begtrack	;save sector and track		lda	blockcnt		clc		adc	blocknum		sta	blocknum		lda	blockcnt+1		adc	blocknum+1		sta	blocknum+1	;blocknum = beginblk + blockcnt		lda	blocknum		bne	@05		dec	blocknum+1@05		dec	blocknum	;first + count - 1 = last blocknum				jsr	ChkBlk		;must be a valid blknum for the volume!		bcs	@err1		jsr	Blk2SCS		;convert end blocknum to side,cyl,sector		bcs	@err1		;why me boss?		lda	trk		;is the ending block on same track as begin		cmp	begtrack	;		beq	sametrk		lda	#BadBlk		jmp	DoErr		;exit with bad block error** Now have side,cyl, "last" sector plus begsect and begtracksametrk	equ	*** Now create the rtable and rcount		stz	rcount		stz	rcount+1		ldx	curNsect@10		dex		stz	rtable,x	;		bne	@10				lda	begsect		;(zero based)		sta	minCsect		lda	sector		;ending sector number (zero based)		inc	a		sta	maxCsect		sec		sbc	begsect		;compute the sector count		sta	sectcnt		asl	a		asl	a		sta	errcnt	 				lda	#$40		ldx	curNsect		stx	SectFnd		;in case @IOErr exit taken@zlp		sta	sectrtbl,x	;mark sector as	"not needed"		cpx	minCsect		bcc	@z10		cpx	maxCsect		bcs	@z10		stz	sectrtbl,x	;mark sector as	not yet	found@z10		dex		bpl	@zlp** Now return a reply of three indicating that the $600 page is setup 		lda	#03		sta	reply		;** Now turn on the motor and seek etc		lda	curNsect		asl	a		asl	a		inc	a		sta	adrerrcnt		lda	#02		sta	reseekcnt				jsr	U35MtrOn	;turn on the motor if it aint		bra	@reseek		@recal		jsr	recal		bcs	@IOerror@reseek		dec	reseekcnt		bmi	@IOerror		jsr	Seek		bcs	@IOerror		jsr	WaitRdyTO		bcc	@findadrs@offl		lda	#Offline		bra	@MyDoErr	** Now find an address mark@findA1		jsr	SelectIWM@findadrs	stz	error2		jsr	GetAddr		;find an address mark on media		bcc	@rddsk		lda	error2		bit	#cylerror		bne	@reseek		bit	#adrerror		bne	@20		bit	#nomkerror		bne	@offl@IOerror	bra	@IOerr@20		dec	adrerrcnt		beq	@IOerr		lda	adrerrcnt		cmp	curNsect		bne	@30		bra	@recal@30		bit	#siderror		beq	@findadrs		bra	@reseek** now read it into it buffer@rddsk		ldx	SectFnd		bit	sectrtbl,x	;do I need this one?		bvs	@dontneed	;no. or already read it before		jsr	AllocCbuf	;"empty" the cache too!		jsr	ReadData		bcs	@rderror		ldx	SectFnd		lda	#$40		sta	sectrtbl,x	;mark it as found		txa			;get sector number		sec		sbc	begsect		;subtract the sector number of first sector		tax			; x = offset of this block in group of N		lda	ramblk		sta	rtable,x	;mark the result table for GS/OS driver				inc	rcount		;tell driver another famous sector is available		dec 	sectcnt		beq	@done		bra	@cntAdrs		@dontneed	stz	temp		ldx	#8		;spend next 8 ms doing nothing@waits		lda	#204@wait10		bit	temp		;+03		bpl	@wait20		;+05 @wait20		dec	a		;+07		bne	@wait10		;+10		dex		bne	@waits@cntAdrs	dec	adrerrcnt		bne	@FindA1		bra	@IOerr		@rderror	dec	errcnt		;too many read errors on requested sectors?		bpl	@findA1		;nope. keep going		lda	SectFnd		sec		sbc	begsect		tax		lda	#IOError+$80		sta	rtable,x	;mark the result vector with the error code @IOerr		lda	#IOError@myDoErr	sta	error			lda	#01		sta	rcount+1	;make rcount much too big		clc		rts@done		equ	*		lda	#$FF		sta	msg		;make ready for next cmd** Delay a while looking for a cmd before giving up and deSelecting the drive		lda	#05		sta	r1h		stz	r1l@wait		dec	r1l		bne	@wtmsg		dec	r1h		bmi	@quit@wtmsg		lda	msg		;has the next cmd arrived yet?		bmi	@wait		;nope. keep waiting a while for the GS/OS driver@quit		sec		rts