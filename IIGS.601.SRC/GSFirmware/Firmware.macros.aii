		PRINT	PUSH		PRINT	OFF;; EQUSect Macros;; By John Arkley; 08 May 91;; A few macros to help in making equates.  This is; useful when you want to define a series of equates that; relate to each other.  ;; Normally you would do something like;;     lab1 equ  0;     lab2 equ  lab1+4;     lab3 equ  lab2+2;     etc.;; These macros let you do the  following;;          DSect 0;     lab1 equds.b  1;     lab2 equds.w  1;     lab3 equds.l  1;     lab4 equds.a  1;; The macro does the equating and addition for you.  ; It also improves the readability of the code.;;;;  	EQUSect &Value;;  	Begin local equate section. This defines a  dummy PC;  	set variable which can be used in equates to avoid error-;  	prone linked equates for setting up direct page or;  	stack offsets. The dummy PC begins at &Value and;  	is updated by the appropriate amount by the EQUDS macro;		MACRO&sectname		EQUSECT 	&Value,&propt		IF &FINDSYM(&SYSGLOBAL,'EQUSECTPC') = 0 THEN		GBLA 	&EQUSECTPC		LCLC	&pr		ENDIF&EQUSECTPC	SETA 	&EVAL(&Value)		IF &sectname <> '' THEN&sectname		EQU	&EVAL(&Value)		ENDIF		PRINT	PUSH		IF &propt = '' THEN		PRINT	GEN,NOMDIR,NOMCALL		ELSE		PRINT	NOMDIR,&propt		ENDIF		MEND;; 	EQUORG &value;;	Assigns a new value to the EQUSECT program counter;	(relative assignment is NOT supported;				MACRO		EQUORG	&Value		GBLA	&EQUSECTPC&EQUSECTPC	SETA	&EVAL(&Value);--->		equorg	&CONCAT('$',&TRIM(&I2S(&EQUSECTPC,6,1)))		ENDM;;  &lab EQUDS.len count;;  Equate the given label with the current dummy;  PC (defined  by DSect, GlobalDSect, or;  DefineStack), and update the dummy PC by the;  appropriate  amount.;		MACRO&lab		EQUDS.&siz	&count		GBLA	&EQUSECTPC		LCLA	&cnt	 	IF &TRIM(&COUNT) = '*' THEN	 	 IF  &lab <> '' THEN		  IF &len(&lab) < 10 THEN&lab		equ 	&CONCAT('$',&TRIM(&I2S(&EQUSECTPC,6,1)))		  ELSE&lab	equ	&CONCAT('$',&TRIM(&I2S(&EQUSECTPC,6,1)))		  ENDIF	 	 ELSE	 	 WRITELN	'### Error: EQUDS * found without a label.')	  	 ENDIF	 	ELSE&cnt		SETA	&EVAL(&count)		IF &cnt > 0 THEN		 IF &lab <> '' THEN		  IF &len(&lab) < 10 THEN&lab		equ 	&CONCAT('$',&TRIM(&I2S(&EQUSECTPC,6,1)))		  ELSE&lab	equ	&CONCAT('$',&TRIM(&I2S(&EQUSECTPC,6,1)))		  ENDIF	 	 ENDIF	  	 IF &UC(&siz) = 'B' THEN&EQUSECTPC	SETA 	&EQUSECTPC+&cnt	  	 ELSEIF &UC(&siz) = 'W' THEN&EQUSECTPC	SETA 	&EQUSECTPC+(2*&cnt)	  	 ELSEIF &UC(&siz) = 'A' THEN&EQUSECTPC	SETA 	&EQUSECTPC+(3*&cnt)	  	 ELSEIF &UC(&siz) = 'L' THEN&EQUSECTPC	SETA 	&EQUSECTPC+(4*&cnt)	  	 ENDIF		ELSE	 	WRITELN	'### Error: EQUDS found with invalid operand =>',&count		ENDIF		ENDIF		MEND			MACRO		ENDSECT		PRINT	POP		MEND			MACRO		STR	&string		LCLC	&sset&sset		SETC	&SETTING('STRING')		STRING	PASCAL		DC.B	&string		STRING	&sset		MEND				MACRO		DCI	&string		LCLA	&slen		LCLC	&msbset		LCLC	&sset&sset		SETC	&SETTING('STRING')&msbset		SETC	&SETTING('MSB')&slen		SETA	&LEN(&string)		STRING	ASIS	IF &slen > 3	THEN		MSB	OFF		DC.B	&CONCAT(&string[1:&slen-2],'''')		MSB	ON		DC.B	&CONCAT('''',&string[&slen-1:2])	ELSEIF &slen = 3	THEN		MSB	ON		DC.B	&string		; 1 byte string + 2 delimiters	ELSE		WRITELN	'### DCI string argument too short: string =>',&string	ENDIF		MSB	&msbset		STRING	&sset		MEND		MACRO			FillTo	&Addr,&Value		LCLA	&PCadrs		LCLC	&Here		LCLC	&expr		LCLC	&val		IF &TRIM(&Value) = '' THEN&val		SETC	'0'		ELSE&Val		SETC	&Value		ENDIF&PCadrs		SETA	*-Rel~Org+Bnk~Org&Here		SETC	&I2S(&PCAdrs)&expr		SETC	&CONCAT('(',&Addr,')','-',&Here)&PCadrs		SETA	&EVAL(&expr)	IF &PCadrs < 0 THEN		WRITELN	'### WARNING: FILLTO parameter resulted in a negative length'	ELSEIF &PCadrs > 32767 THEN		WRITELN	'### WARNING: FILLTO parameter resulted in a fill size > 32767'	ELSEIF  &PCadrs > 0 THEN		DCB.B	&PCadrs,&val	ENDIF		MEND				MACRO		OPCODE.&mod &opc		LCLC	&opcode&opcode		SETC	&UC(&TRIM(&opc))		IF &opcode = 'BCC' THEN		DC.B	$90		ELSEIF &opcode = 'BCS' THEN		DC.B	$B0		ELSEIF &opcode = 'BVS' THEN		DC.B	$70		ELSEIF &opcode = 'BVC' THEN		DC.B	$50		ELSEIF &opcode = 'LDA' THEN		 IF &UC(&mod) = 'ZPG' THEN		 DC.B	$A5		 ELSE		WRITELN	'### ERROR: OPCODE macro needs to have this adrs mode added for=>',&opcode,',',&mod		 ENDIF		ELSE		WRITELN	'### ERROR: OPCODE macro needs to have this opcode added =>',&opcode		ENDIF		ENDM				MACRO&lbl		PgAdrEqu	&adrs		LCLA	&absadrs		LCLA	&pgadrs&absadrs		SETA	&EVAL(&adrs)-Rel~Org+Bnk~Org&pgadrs		SETA	(&absadrs**$FF00)>>8&lbl		EQU	&pgadrs		ENDM				PRINT POP