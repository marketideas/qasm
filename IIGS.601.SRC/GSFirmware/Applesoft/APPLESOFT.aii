;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d2 on 5/4/91 at 6:36:21 PM				MACHINE	M65816				MSB	OFF		LONGA	OFF		LONGI	OFF		PRINT	NOGEN,DATA		PRINT	PUSH		PRINT	OFF		INCLUDE	'::Firmware.macros.aii'				PRINT	POP		PLIST		EQU	0A2E		EQU	0	;1= Do Apple //e enhanced fixesLOLLY		EQU	1	;1= Do //c fixesCORTLAND		EQU	1	;1= Do Cortland fixes		IF CORTLAND <> 0 THEN		TITLE	'Cortland AppleSoft BASIC'		ELSE		TITLE	'APPLESOFT BASIC'		ENDIF********************************   REAL APPLESOFT II SOURCE *    CONVERTED TO EDASM II *      ON JUNE 26, 1981*   RESURECTED  BY  J ARKLEY*      ON  MAY 1, 1980*  MODIFICATIONS FOR LOLLY BY*   J.R HUSTON, AUGUST 1983** Modifications for Cortland by* R. Williams / F. Bachman 1986**************************************************************                           **       APPLESOFT:          ** FLOATING POINT BASIC FOR  **      THE APPLE-][         **                           **  COPYRIGHT 1978, 1983 by  **  APPLE COMPUTER INC.      **   ALL RIGHTS RESERVED     **                           **  WRITTEN BY MICROSOFT     **                           ** EXTENDED BY R. WIGGINTON  **                           ******************************		EJECT		TITLE	'PRELIMINARY EQUATES'CLMWID		EQU	14STKEND		EQU	507BUFPAG		EQU	2TRMPOS:		EQU	$24FIRST		EQU	$F0H2		EQU	$2CV2		EQU	$2DROMLOC		EQU	$D000RAMLOC		EQU	$800C_INLN		EQU	$FD6AC_PRMP		EQU	$33C_INCH		EQU	$FD0CC_COUT		EQU	$FECDC_CSIN		EQU	$FEFDBUF		EQU	$0200OUTCH		EQU	$FDEDC_GETL		EQU	$FD0CSPDBYT		EQU	$F1WAITNOW		EQU	$FCA8CLRSCR		EQU	$FC58TRFLAG		EQU	$F2	;TRACE ON/OFFORMASK		EQU	$F3	;FOR FLASH, NORMAL, INVERSEINVFLG		EQU	$32	;DISPLAY MODES.ERRTO		EQU	$F4ERRFLG		EQU	$D8ERRLIN		EQU	$DAERRPOS		EQU	$DCERRNUM		EQU	$DE	;PLACE FOR ERROR .ERRSTK		EQU	$DF	;SAVE STACK POINTER DURING ERROR.REMSTK		EQU	$F8	;FOR EVERY TIME.RNONLY		EQU	$D6	;RUN-ONLY PROGRAM?		EJECT		TITLE	'INTR AND COMP PARAMETERS.'; --------- ---- -- ---------; COPYRIGHT 1976 BY MICROSOFT; --------- ---- -- ---------; *NUMLEV		EQU	19	;NUMBER OF STACK LEVELS RESERVED				;BY AN EXPLICIT CALL TO 'GETSTK'.LINLEN		EQU	40BUFLEN		EQU	240	;INPUT BUFFER SIZE.				;FOR COMMODORE.STRSIZ		EQU	3	;# OF LOCS PER STRING DESCRIPTOR.NUMTMP		EQU	3	;NUMBER OF STRING TEMPORARIES.CONTW		EQU	15	;CHARACTER TO SUPPRESS OUTPUT.		; DSECTZPage		RECORD	0START:		DS.b	3	;JMP INIT	;INITIALIZE - SETUP CERTAIN LOCATIONS				;AND DELETE FUNCTIONS IF NOT NEEDED,				;AND CHANGE THIS TO 'JMP READY'				;IN CASE USER RESTARTS AT LOC ZERO.RDYJSR:		DS.b	3	;JMP INIT	;CHANGED TO 'JMP STROUT' BY 'INIT'				;TO HANDLE ERRORS.ADRAYI:		DS.W	1	;was DW AYINT ;STORE HERE THE ADDR OF THE				;ROUTINE TO TURN THE FAC INTO A 				;TWO BYTE SIGNED INTEGER IN Y,AADRGAY:		DS.W	1	;was DW GIVAYF ;STORE HERE THE ADDR OF THE				;ROUTINE TO CONVERT Y,A TO A FLOATING				;POINT NUMBER IN THE FAC.USRPOK:		DS.b	3	;JMP FCERR ;SET UP ORIG BY INIT.				; THIS IS THE 'VOLATILE' STORAGE AREA AND NONE OF IT				; CAN BE KEPT IN ROM. ANY CONSTANTS IN THIS AREA CANNOT				; BE KEPT IN A ROM, BUT MUST BE LOADED IN BY THE 				; PROGRAM INSTRUCTIONS IN ROM.; --- GENERAL RAM ---:CHARAC:		DS.B	1	;A DELIMITING CHARACTER.INTEGR		EQU	CHARAC	;A ONE-BYTE INTEGER FROM 'QINT'.ENDCHR:		DS.B	1	;THE OTHER DELIMITING CHARACTER.COUNT:		DS.B	1	;A GENERAL COUNTER.; --- FLAGS ---:DIMFLG:		DS.B	1	;IN GETTING A PNTER TO A VARIABLE				;IT IS IMPORTANT TO REMEMBER WHETHER IT				;IS BEING DONE FOR 'DIM' OR NOT.				;DIMFLG AND VALTYP MUST BE				;CONSECUTIVE LOCATIONS.KIMY		EQU	DIMFLG	;PLACE TO PRESERVE Y DURING OUT.VALTYP:		DS.B	1	;THE TYPE INDICATOR.				;0=NUMERIC 1=STRING.INTFLG:		DS.B	1	;TELLS IF INTEGER.DORES:		DS.B	1	;WHETHER CAN OR CAN'T CRUNCH RES'D WORDS.				;TURNED ON WHEN 'DATA'				;BEING SCANNED BY CRUNCH SO UNQUOTED				;STRINGS WON'T BE CRUNCHED.GARBFL		EQU	DORES	;WHETHER TO DO GARBAGE COLLECTN.SUBFLG:		DS.B	1	;FLAG WHETHER SUB'D VARIABLE ALLOWED.				;'FOR' AND USER-DEFINED FUNCTION				;POINTER FETCHING TURN				;THIS ON BEFORE CALLING 'PTRGET'				;SO ARRAYS WON'T BE DETECTED.				;'STKINI' AND 'PTRGET' CLEAR IT.				;ALSO DISALLOWS INTEGERS THERE.INPFLG:		DS.B	1	;FLAGS WHETHER WE ARE DOING 'INPUT'				;OR 'READ'.TANSGN:		DS.B	1	;USED IN DETERMINING SIGN OF TANGENT.				;****** DSECT		ORG	$50	;ROOM FOR APPLE PAGE 0 STUFF.; --- RAM DEALING WITH TERMINAL HANDLING ---:				;NUMBER OF NULLS TO PRINT.LINNUM:		DS.B	01	;LOCATION TO STORE LINE NUMBER BEFORE BUF				;SO THAT 'BLTUC' CAN STORE IT ALL AWAY AT ONCE.		DS.B	1 	;A COMMA (PROAD OR FROM ROM)				;USED BY INPUT STATEMENT SINCE THE				;DATA POINTER ALWAYS STARTS ON A				;COMMA OR TERMINATOR.				;TYPE IN STORED HERE.				;DIRECT STATEMENTS EXECUTE OUT OF				;HERE. REMEMBER 'INPUT' SMASHES BUF.				;MUST BE ON PAGE ZERO				;OR ASSIGNMENT OF STRING				;VALUES IN DIRECT STATEMENTS WON'T COPY				;INTO STRING SPACE -- WHICH IT MUST.				;N.B. TWO NONZERO BYTES MUST PRECEDE 'BUFLNM'.				; --- STORAGE FOR TEMPORARY THINGS ---:TEMPPT:		DS.B	1	;POINTER AT FIRST FREE TEMP DESCRIPTOR.				;INITIALIZ TO POINT TO TEMPST.LASTPT:		DS.B	2	;POINTER TO LAST-USED STRING TEMPORARY.TEMPST:		DS.B	STRSIZ*NUMTMP	;STORAGE FOR NUMTMP TEMP DESCRPTINDEX1:		DS.B	2	;INDEXES.INDEX		EQU	INDEX1INDEX2:		DS.B	2RESHO:		DS.B	1	;RESULT OF MULTIPLIER AND DIVIDER.RESMOH:		DS.B	1	;ONE MORE BYTE.RESMO:		DS.B	1RESLO:		DS.B	1ADDEND		EQU	RESMO	;TEMPORARY USED BY 'UMULT'.		DS.B	1	;OVERFLOW FOR RES.; --- POINTERS INTO DYNAMIC DATA STRUCTURES ---;TXTTAB:		DS.B	2	;POINTER TO BEGINNING OF TEXT.				;DOE'T CHANGE AFTER BEING				;SETUP BY 'INIT'.VARTAB:		DS.B	2	;POINTER TO START OF SIMPLE				;VARIABLE SPACE.				;UPDATED WHENEVER THE SIZE OF THE				;PROGRAM CHANGES, SET TO TXTTAB				;BY 'SCRATCH' ('NEW').ARYTAB:		DS.B	2	;POINTER TO BEGINNING OF ARRAY				;TABLE.				;INCREMENTED BY 6 WHENEVER				;A NEW SIMPLE VARIABLE IS FOUND, AND				;SET TO VARTAB BY 'CLEARC'.STREND:		DS.B	2	;END OF STORAGE IN USE.				;INCREASED WHENEVER A NEW ARRAY				;OR SIMPLE VARIABLE IS ENCOUNTERED.				;SET TO VARTAB BY 'CLEARC'.FRETOP:		DS.B	2	;TOP OF STRING FREE SPACE.FRESPC:		DS.B	2	;POINTER TO NEW STRING.MEMSIZ:		DS.B	2	;HIGHEST LOCATION IN MEMORY.; --- LINE NUMBERS AND TEXTUAL POINTERS ---:CURLIN:		DS.B	2	;CURRENT LINE .				;SET TO 0,255 FOR DIRECT STATEMENTS.OLDLIN:		DS.B	2	;OLD LINE NUMBER (SETUP BY C,'STOP'				;OR 'END' IN A PROGRAM).POKER		EQU	LINNUM	;SET UP LOCATION USED BY POKE.				;TEMPORARY FOR INPUT AND READ CODEOLDTXT:		DS.B	2	;OLD TEXT POINTER.				;POINTS AT STATEMENT TO BE EXEC'D NEXT.DATLIN:		DS.B	2	;DATA LINE  -- REMEMBER FOR ERRORS.DATPTR:		DS.B	2	;POINTER TO DATA. INITIALIZED TO POINT				;AT THE ZERO IN FRONT OF TXTTAB				;BY 'RESTORE' WHICH IS CALLED BY 'CLEARC'.				;UPDATED BY EXECUTION OF A 'READ'.INPPTR:		DS.B	2	;THIS REMEMBERS WHERE INPUT IS COMING FROM.; --- STUFF USED IN EVALUATIONS ---:VARNAM:		DS.B	2	;VARIABLE'S NAME IS STORED HERE.VARPNT:		DS.B	2	;POINTER TO VARIABLE IN MEMORY.FDECPT		EQU	VARPNT	;POINTER INTO POWERF TENS OF 'FOUT'.FORPNT:		DS.B	2	;A VARIABLE'S POINTER FOR 'FOR' LOOPS				;AND 'LET' STATEMENTS.LSTPNT		EQU	FORPNT	;PNTR TO LIST STRING.ANDMSK		EQU	FORPNT	;THE MASK USED BY WAIT FOR ANDING.EORMSK		EQU	FORPNT+1	;THE MASK FOR EORING IN WAIT.OPPTR:		DS.B	2	;POINTER TO CURRENT OP'S ENTRY IN 'OPTAB'.VARTXT		EQU	OPPTR	;POINTER INTO LIST OF VARIABLESOPMASK:		DS.B	1	;MASK CREATED BY CURRENT OPERATOR.DOMASK		EQU	TANSGN	;MASK IN USE BY RELATION OPERATIONS.DEFPNT:		DS.B	2	;POINTER USED IN FUNCTION DEFINITION.GRBPNT		EQU	DEFPNT	;ANOTHER US IN GARBAGE COLLECTION.DSCPNT:		DS.B	2	;POINTER TO A STRING DESCRIPTOR.		DS.B	1	;FOR TEMPF3.FOUR6:		DS.B	1	;VARIABLE CONSTANT USED BY GARB COLECT; --- ET CETERA ---:JMPER:		DS.b	3	;was JMP 60000SIZE		EQU	JMPER+1OLDOV		EQU	JMPER+2	;THE OLD OVERFLOW.TEMPF3		EQU	DEFPNT	;A THIRD FAC TEMPORARY (4 BYTES).TEMPF1:		DS.B	1	;FOR TEMPF1S EXTRA BYTE.HIGHDS:		DS.B	2	;DESINATION OF HIGHEST ELEMENT IN BLT.HIGHTR:		DS.B	2	;SOURCE OF HIGHEST ELEMENT TO MOVE.TEMPF2:		DS.B	1	;FOREMPF2S EXTRA BYTE.LOWDS:		DS.B	2	;LOCATION OF LAST BYTE TRANSFERRED INTO.LOWTR:		DS.B	2	;LAST THING TO MOVE IN BLT.ARYPNT		EQU	HIGHDS	;A POINTER USED IN ARRAY BUILDING.GRBTOP		EQU	LOWTR	;A POINTER USED IN GARBAGE COLLECTION.DECCNT		EQU	LOWDS	;NUMBER OF PLACES BEFORE DECIMAL POINT.TENEXP		EQU	LOWDS+1	;HAS A DPT BEEN INPUT?DPTFLG		EQU	LOWTR	;BASE TEN EXPONENT.EXPSGN		EQU	LOWTR+1	;SIGN OF BASE TEN EXPONENT.; --- THE FLOATING ACCUMULATOR ---:FAC:		EQU	*FACEXP:		DS.B	01FACHO:		DS.B	01	;MOST SIGNIFICANT BYTE OF MANTISSA.FACMOH:		DS.B	01	;ONE MORE.FACMO:		DS.B	01	;MIDDLE ORDER OF MANTISSA.FACLO:		DS.B	01	;LEAST SIG BYTE OF MANTISSA.FACSGN:		DS.B	01	;SIGN OF FAC (0 OR -1) WHEN UNPACKED.SGNFLG:		DS.B	01	;SIGN OF FAC IS PRESERVED BERE BY 'FIN'.DEGREE		EQU	SGNFLG	;A COUNT USED BY POLYNOMIALS.DSCTMP		EQU	FAC	;THIS IS WHERE TEMP DESCS ARE BUILT.INDICE		EQU	FACMO	;INDICE IS SET UP HERE BY 'QINT'.BITS:		DS.B	01	;SOMETHING FOR 'SHIFTR' TO USE.; --- THE FLOING ARGUMENT (UNPACKED) ---:ARGEXP:		DS.B	01ARGHO:		DS.B	01ARGMOH:		DS.B	01ARGMO:		DS.B	01ARGLO:		DS.B	01ARGSGN:		DS.B	01ARISGN:		DS.B	01	;A SIGN REFLECTING THE RESULT.FACOV:		DS.B	01	;OVERFLOW BYTE OF THE FAC.STRNG1		EQU	ARISGN	;POINTER TO A STRING OR DESCRIPTOR.FBUFPT:		DS.B	2	;POINTER INTO FBUFFR USED BY FOUT.BUFPTR		EQU	FBUFPT	;POINTER TO BUF USED BY 'CRUNCH'.STRNG2		EQU	FBUFPT	;POINTER TO STRING OR DESC.POLYPT		EQU	FBUFPT	;POINTER INTO POLYNOMIAL COEFFICIENTS.CURTOL		EQU	FBUFPT	;ABSOLUTE LINEAR INDEX IS FORMED HERE.PRGEND:		DS.B	2		EJECT		TITLE	'RAM CODE.'; THIS CODE GETS CHANGED THROUGHOUT EXECUTION.; IT IS MADE TO BE FAST THIS WAY.; ALSO, X AND Y ARE NOT DISTURBED; 'CHRGET' USING TXTPTR AS THE CURRENT TEXT PNTR; FETCHES NEW CHARACTER INTO ACCA AFTER INCREMENTING TXTPT; AND SETS CONDITION CODES ACCORDING TO WHAT'S IN ACCA.; NOT C= NUMERIC   ('0' THRU '9'); Z= ':' OR END-OF-LINE (A NULL); ACCA = NEW CHAR.; TXTPTR=TXTPTR+1; THE FOLLOWING EXISTS IN ROM IF ROM EXISTS AND IS LOADED; DOWN HERE BY INIT. OTHERWISE IT IS JUST LOADED INTO THIS; RAM LIKE ALL THE REST OF RAM IS LOADED.CHRGET:		DS.b	2	;INC CHRGET+7 ;INCREMENT THE WHOLE TXTPTR.		DS.b	2	;BNE CHRGOT		DS.b	2	;INC CHRGET+8CHRGOT:		DS.b	3	;LDA 60000 ;A LOAD WITH AN EXT ADDR.TXTPTR		EQU	CHRGOT+1		DS.b	2	;CMP $20 ;SKIP SPACES.		DS.b	2	;BEQ CHRGETQNUM:		DS.b	2	;CMP ':' ;IS IT A ':'?		DS.b	2	;BCS CHRRTS ;IT IS .GE. ':'		DS.b	1	;SEC		DS.b	2	;SBC '0' ;ALL CHARS .GT. '9' HAVE RET'D SO		DS.b	1	;SEC		DS.b	2	;SBC $100-'0' ;SEE INUMERIC.				;TURN CARRY ON IF NUMERIC.				;ALSO, SETZ IF NULL.CHRRTS:		DS.b	1	;RTS ;RETURN TO CALLER. RNDX:		DS.b	1	;was DB 128 ;LOADED OR FROM ROM.		DS.b	1	;was DB 79 ;THE INITIAL RANDOM NUMBER.		DS.b	1	;was DB 199		DS.b	1	;was DB 82		DS.b	1	;was DB 89 ;ONE MORE BYTE.		ORG	255	;PAGE 1 STUFF COMING UP.LOFBUF:		DS.B	1	;THE LOW FAC BUFFER. COPYABLE.;---  PAGE ZERO/ONE BOUNDARY ---.;MUST HAVE 13 CONTIGUOUS BYTES.FBUFFR:		DS.B	3*1+13	;BUFFER FOR 'FOUT'.;ON PAGE 1 SO THAT STRING IS NOT COPIED.;STACK IS LOCATED HERE. IE FROTHE END OF FBUFFR TO STKEND.		ENDR		EJECT		TITLE	'DISPATCH TABLES, RESERVED WORDS, AND ERROR TEXTS.'ROMASOFT		PROC	ORG ROMLOC		WITH	ZPageAPPLESOFT:		STMDSP:		DC.W	END-1		DC.W	FOR-1		DC.W	NEXT-1		DC.W	DATA-1		DC.W	INPUT-1		DC.W	DELETE-1		DC.W	DIM-1		DC.W	READ-1		DC.W	MSETGR-1		DC.W	MSETTXT-1		DC.W	PRNUMB-1		DC.W	INNUMB-1		DC.W	CALL-1		DC.W	PLOT-1		DC.W	HLIN-1		DC.W	VLIN-1		DC.W	SETHRH-1		DC.W	SETHRL-1		DC.W	SETHCOL-1		DC.W	LINE-1		DC.W	DODRAW-1		DC.W	DOXDRAW-1		DC.W	HTAB-1		DC.W	CLRSCR-1		DC.W	SETROT-1		DC.W	SETSCALE-1		IF PLIST <> 0 THEN		PRINT	ON		ELSE		ENDIF		IF LOLLY <> 0 THEN		DC.W	$3F4	;UNSUPPORTED IN LOLLY, GO & HOOK		ELSE		DC.W	SHLOAD-1		ENDIF		DC.W	SETTRACE-1		DC.W	TRACEOFF-1		DC.W	SETNORM-1		DC.W	INVERSE-1		DC.W	FLASH-1		DC.W	COLORE-1		DC.W	RETURN-1		DC.W	VTAB-1		DC.W	HIMEMSET-1		DC.W	LOMEMSET-1		DC.W	ONERR-1		DC.W	RESUME-1		IF LOLLY <> 0 THEN		DC.W	$3F4	;UNSUPPORTED IN LOLLY, DO & HOOK		DC.W	$3F4		ELSE		DC.W	RECALL-1		DC.W	STORE-1		ENDIF		DC.W	SETSPD-1		DC.W	LET-1		DC.W	GOTO-1		DC.W	RUN-1		DC.W	IF-1		DC.W	RESTOR-1		DC.W	$3F4	;WHY THE HELL NOT		DC.W	GOSUB-1		DC.W	RETURN-1		DC.W	REM-1		DC.W	STOP-1		DC.W	ONGOTO-1		DC.W	FNWAIT-1		IF LOLLY <> 0 THEN		DC.W	$3F4	;UNSUPPORTED IN LOLLY, DO & HOOK		DC.W	$3F4		ELSE		DC.W	LOAD-1		DC.W	SAVE-1		ENDIF		IF PLIST <> 0 THEN		PRINT	OFF		ELSE		ENDIF		DC.W	DEF-1		DC.W	POKE-1		DC.W	PRINT-1		DC.W	CONT-1		DC.W	LIST-1		DC.W	CLEAR-1		DC.W	GET-1	;FILL W/ GET ADDR.		DC.W	SCRATH-1FUNDSP:		DC.W	SGN		DC.W	INT		DC.W	ABSUSRLOC:		DC.W	USRPOK		DC.W	FRE		DC.W	ERROR	;DUMMY FILL FOR SCRN().		DC.W	PDLHNDL		DC.W	POS		DC.W	SQR		DC.W	RND		DC.W	LOG		DC.W	EXPCOSFIX:		DC.W	COSSINFIX:		DC.W	SINTANFIX:		DC.W	TANATNFIX:		DC.W	ATN		DC.W	PEEK		DC.W	LEN		DC.W	STRS		DC.W	VAL		DC.W	ASC		DC.W	CHRS		DC.W	LEFTS		DC.W	RIGHTS		DC.W	MIDSOPTAB:		DC.B	121		DC.W	FADDT-1		DC.B	121		DC.W	FSUBT-1		DC.B	123		DC.W	FMULTT-1		DC.B	123		DC.W	FDIVT-1		DC.B	125		DC.W	FPWRT-1		DC.B	80		DC.W	ANDOP-1		DC.B	70		DC.W	OROP-1NEGTAB:		DC.B	127		DC.W	NEGOP-1NOTTAB:		DC.B	127		DC.W	NOTOP-1PTDORL:		DC.B	100	;PRECEDENCE.		DC.W	DOREL-1	;OPERATOR ADDRESS.; TOKENS FOR RESERVED WORDS ALWAYS HAVE THE MOST; SIGNIFICANT BIT ON.; THE LIST OF RESERVED WORDS:;Q EQU 128-1; DCI MACRO A;Q EQU Q+1; DC A; ENDMRESLST:		DCI	'END'ENDTK		EQU	$80		DCI	'FOR'FORTK		EQU	ENDTK+1		DCI	'NEXT'		DCI	'DATA'DATATK		EQU	FORTK+2		DCI	'INPUT'		DCI	'DEL'		DCI	'DIM'		DCI	'READ'		DCI	'GR'		DCI	'TEXT'		DCI	'PR#'		DCI	'IN#'		DCI	'CALL'		DCI	'PLOT'		DCI	'HLIN'		DCI	'VLIN'		DCI	'HGR2'		DCI	'HGR'		DCI	'HCOLOR='		DCI	'HPLOT'		DCI	'DRAW'		DCI	'XDRAW'		DCI	'HTAB'		DCI	'HOME'		DCI	'ROT='		DCI	'SCALE='		DCI	'SHLOAD'		DCI	'TRACE'		DCI	'NOTRACE'		DCI	'NORMAL'		DCI	'INVERSE'		DCI	'FLASH'		DCI	'COLOR='		DCI	'POP'POPTKN		EQU	DATATK+30		DCI	'VTAB'		DCI	'HIMEM:'		DCI	'LOMEM:'		DCI	'ONERR'		DCI	'RESUME'		DCI	'RECALL'		DCI	'STORE'		DCI	'SPEED='		DCI	'LET'		DCI	'GOTO'GOTOTK		EQU	POPTKN+10		DCI	'RUN'		DCI	'IF'		DCI	'RESTORE'		DC.b	$26+$80	;'&' FOR DISK HOOKS.		DCI	'GOSUB'GOSUTK		EQU	GOTOTK+5		DCI	'RETURN'		DCI	'REM'REMTK		EQU	GOSUTK+2		DCI	'STOP'		DCI	'ON'		DCI	'WAIT'		DCI	'LOAD'		DCI	'SAVE'		DCI	'DEF'		DCI	'POKE'		DCI	'PRINT'PRINTK		EQU	REMTK+8		DCI	'CONT'		DCI	'LIST'		DCI	'CLEAR'		DCI	'GET'		DCI	'NEW'SCRATK		EQU	PRINTK+5; END OF COMMAND LIST.		DCI	'TAB('TABTK		EQU	SCRATK+1		DCI	'TO'TOTK		EQU	TABTK+1		DCI	'FN'FNTK		EQU	TOTK+1		DCI	'SPC('SPCTK		EQU	FNTK+1		DCI	'THEN'THENTK		EQU	SPCTK+1		DCI	'AT'ATTKN		EQU	THENTK+1		DCI	'NOT'NOTTK		EQU	ATTKN+1		DCI	'STEP'STEPTK		EQU	NOTTK+1		DCI	'+'PLUSTK		EQU	STEPTK+1		DCI	'-'MINUTK		EQU	PLUSTK+1		DCI	'*'		DCI	'/'		DC.B	$DE	;THE EXPONENTIATION SIGN		DCI	'AND'		DCI	'OR'		DCI	'>'GREATK		EQU	MINUTK+6		DCI	'='EQULTK		EQU	GREATK+1		DCI	'<'LESSTK		EQU	EQULTK+1; ANOTHER EXAMPLE: IF T OR Q THEN ... 'TO' IS CNCHED		DCI	'SGN'ONEFUN		EQU	LESSTK+1		DCI	'INT'		DCI	'ABS'		DCI	'USR'		DCI	'FRE'		DCI	'SCRN('SCRNFN		EQU	ONEFUN+5		DCI	'PDL'		DCI	'POS'		DCI	'SQR'		DCI	'RND'		DCI	'LOG'		DCI	'EXP'		DCI	'COS'		DCI	'SIN'		DCI	'TAN'		DCI	'ATN'		DCI	'PEEK'		DCI	'LEN'		DCI	'STR$'		DCI	'VAL'		DCI	'ASC'		DCI	'CHR$'LASNUM		EQU	SCRNFN+16	;NUMBER OF LAST FUNCTION;THAT TAKES ONE ARG		DCI	'LEFT$'		DCI	'RIGHT$'		DCI	'MID$'		DC.B	0	;MARKS END OF RESERVED WORD LIST; NOTE: THIS ERROR COUNT TECHNIQUE WILL NOT WORK IF THERE; ARE THAN 256 CHARACTERS OF ERROR MESSAGESERRTAB:		DCI	'NEXT WITHOUT FOR'ERRNF		EQU	0		DCI	'SYNTAX'ERRSN		EQU	ERRNF+16		DCI	'RETURN WITHOUT GOSUB'ERRRG		EQU	ERRSN+6		DCI	'OUT OF DATA'ERROD		EQU	ERRRG+20		DCI	'ILLEGAL QUANTITY'ERRFC		EQU	ERROD+11		DCI	'OVERFLOW'ERROV		EQU	ERRFC+16		DCI	'OUT OF MEMORY'ERROM		EQU	ERROV+8		DCI	'UNDEF''D STATEMENT'ERRUS		EQU	ERROM+13		DCI	'BAD SUBSCRIPT'ERRBS		EQU	ERRUS+17		DCI	'REDIM''D ARRAY'ERRDD		EQU	ERRBS+13		DCI	'DIVISION BY ZERO'ERRDV0		EQU	ERRDD+13		DCI	'ILLEGAL DIRECT'ERRID		EQU	ERRDV0+16		DCI	'TYPE MISMATCH'ERRTM		EQU	ERRID+14		DCI	'STRING TOO LONG'ERRLS		EQU	ERRTM+13		DCI	'FORMULA TOO COMPLEX'ERRST		EQU	ERRLS+15		DCI	'CAN''T CONTINUE'ERRCN		EQU	ERRST+19		DCI	'UNDEF''D FUNCTION'ERRUF		EQU	ERRCN+14; NEEDED FOR MESSAGES IN ALL VERSIONS.ERR:		DC.B	' ERROR'		DC.B	7,0INTXT:		DC.B	' IN '		DC.B	0BRKTXT:		DC.B	13		DC.B	'BREAK'		DC.B	7,0		EJECT		TITLE	'GENERAL STORAGE ROUTINES.'; FIND A 'FOR' ENTRY ON THE STACK VIA 'VARPNT'.FORSIZ		EQU	$12FNDFOR:		TSX		;LOAD XREG WITH STK PNTR.		INX		INX		INX		INX		;IGNORE ADR(NEWSTT) AND RTS ADDR.FFLOOP:		LDA	257,X	;GET STACK ENTRY.		CMP	#FORTK	;IS IT A 'FOR' TOKEN?		BNE	FFRTS	;NO, NO 'FOR' LOOPS TH THIS PNTR.		LDA	FORPNT+1	;GET HIGH.		BNE	CMPFOR		LDA	258,X	;PNTR IS ZERO, SO ASSUME THIS ONE.		STA	FORPNT		LDA	259,X		STA	FORPNT+1CMPFOR:		CMP	259,X		BNE	ADDFRS	;NOT THIS ONE.		LDA	FORPNT	;GET DOWN.		CMP	258,X		BEQ	FFRTS	;WE GOT IT! WE GOT IT!ADDFRS:		TXA		CLC		;ADD 16 TO X.		ADC	#FORSIZ		TAX		;RESULT BACK INTO X.		BNE	FFLOOPFFRTS:		RTS		;RETURN TO CALLER.; THIS IS THE BLOCK TRANSFER ROUTINE.; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.; ON ENTRY:; Y,A=HIGHDS    (FOR REASON).; HIGHDS= DESTINATION OF HIGH ADDRESS.; LOWTR= LOWEST ADDR TO BE TRANSFERRED.; HIGHTR= HIGHEST ADDR TO BE TRANSFERRED.; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO; ON EXIT:; LOWTR ARE UNCHANGED.; HIGHTR=LOWTR-200 OCTAL.; HIGHDS=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.BLTU:		JSR	REASON	;CERTAIN THAT STRING SPACE WON'T;BE OVERRUN.		STA	STREND		STY	STREND+1BLTUC:		SEC		;PREPARE TO SUBTRACT.		LDA	HIGHTR		SBC	LOWTR	;COMPUTE NUMBER OF THINGS TO MOVE.		STA	INDEX	;SAVE FOR LATER.		TAY		LDA	HIGHTR+1		SBC	LOWTR+1		TAX		;PUT IT IN A COUNTER REGISTER.		INX		;SO THAT COUNTER ALGORITHM WORKS.		TYA		;SEE IF LOW PART OF COUNT IS ZERO.		BEQ	DECBLT	;YES, GO START MOVING BLOCKS.		LDA	HIGHTR	;NO, MUST MODIFY BASE ADDR.		SEC		SBC	INDEX	;BORROW IS OFF SCE HIGHTR.GT.LOWTR.		STA	HIGHTR	;SAVE MODIFIED BASE ADDR.		BCS	BLT1	;IF NO BORROW, GO SHOVE IT.		DEC	HIGHTR+1	;BORROW IMPLIES SUB 1 FROM HIGH ORDER.		SECBLT1:		LDA	HIGHDS	;MOD BASE OF DEST ADDR.		SBC	INDEX		STA	HIGHDS		BCS	MOREN1	;NO BORROW.		DEC	HIGHDS+1	;DECREMENT HIGH ORDER BYTE.		BCC	MOREN1	;ALWAYS SKIP.BLTLP:		LDA	(HIGHTR),Y	;FETCH BYTE TO MOVE		STA	(HIGHDS),Y	;MOVE IT IN, MOVE IT OUT.MOREN1:		DEY		BNE	BLTLP		LDA	(HIGHTR),Y	;MOVE LAST OF THE BLOCK.		STA	(HIGHDS),YDECBLT:		DEC	HIGHTR+1		DEC	HIGHDS+1	;START ON NEW BLOCKS.		DEX		BNE	MOREN1		RTS		;RETURN TO CALLER.; THIS ROUTINE IS USED TO ASCERTAIN THAT A GIVEN; NUMBER OF LOCS REMAIN AVAILABLE FOR THE STACK.;    THE CALL IS:; LDAI NUMBER OF 2-BYTE ENTRIES NEEDED.; JSR GETSTK; THIS ROUTINE MUST BE CALLED BY ANY ROUTINE WHICH PUTS; AN ARBITRARY AMOUNT OF STUFF ON THE STACK,; I.E., ANY RECURSIVE ROUTINE LIKE 'FRMEVL'.; IT IS ALSO CALLED BY ROUTINES SUCH A'GOSUB' AND 'FOR'; WHICH MAKE PERMANENT ENTRIES ON THE STACK.; ROUTINES WHICH MERELY USE AND FREE UP THE GUARANTEED; NUMLEV LOCATIONS NEED NOT CALL THIS.; ON EXIT:;    A AND X HAVE BEEN MODIFIED.GETSTK:		ASL	A	;MULT A BY 2. NB, CLEARS C BIT.		ADC	#2*NUMLEV+3+13	;MAKE SURE 2*NUMLEV+13 LOCS;(13 BECAUSE OF FBUFFR)		BCS	OMERR	;WILL REMAIN IN STACK.		STA	INDEX		TSX		;GET STACKED.		CPX	INDEX	;COMPARE.		BCC	OMERR	;IF STACK.LE.INDEX1, OM.		RTS; Y,A IS A CERTAIN ADDRESS. 'REASON' MAKES SURE; IT IS LESS THAN FRETOP.REASON:		CPY	FRETOP+1		BCC	REARTS		BNE	TRYMOR	;GO GARB COLLECT.		CMP	FRETOP		BCC	REARTSTRYMOR:		PHA		LDX	#8+1	;IF TEMPF2 HAS ZERO IN BETWEEN.		TYAREASAV:		PHA		LDA	HIGHDS-1,X	;SAVE HIGHDS ON STACK.		DEX		BPL	REASAV	;PUT 8 OF THEM ON STK.		JSR	GARBA2	;GO GARB COLLECT.		LDX	#$F7REASTO:		PLA		STA	HIGHDS+8+1,X	;RESTORE AFTER GARB COLLECT.		INX		BMI	REASTO		PLA		TAY		PLA		;RESTORE A AND Y.		CPY	FRETOP+1	;COMPARE HIGHS		BCC	REARTS		BNE	OMERR	;HIGHER IS BAD.		CMP	FRETOP	;AND THE LOWS.		BCS	OMERRREARTS:		RTS		EJECT		TITLE	'ERR HAND, READY, TERM INPUT'OMERR:		LDX	#ERROMERROR:		EQU	*ERRCRD:		BIT	ERRFLG		BPL	*+5		JMP	HNDLERR		JSR	CRDO	;OUTPUT CRLF.		JSR	OUTQST	;PRINT A QUESTI MARK;OUTPUT IT.GETERR:		LDA	ERRTAB,X		PHA		JSR	OUTDO	;OUTPUT IT.		INX		PLA		;LAST CHAR OF MESSAGE?		BPL	GETERR	;NO. GO GET NEXT AND OUTPUT IT.TYPERR:		JSR	STKINI	;RESET THE STACK AND FLAGS.		LDA	#ERR		LDY	#>ERR	;GET PNTR TO ' ERROR'.ERRFIN:		JSR	STROUT	;OUTPUT IT.		LDY	CURLIN+1		INY		;WAS NUMBER 64000?		BEQ	READY	;YES, DON'T TYPE LINE NUMBER.		JSR	INPRTREADY		EQU	*;NO INIT ERRORS POSSIBLE.MAIN:		JSR	CRDO	;NEXT LINE		LDX	#$DD	;BACK BRACKET FOR PROMPT		JSR	INLIN+2		STX	TXTPTR		STY	TXTPTR+1		LSR	ERRFLG	;CLEAR 'ONERR' FLAG.		JSR	CHRGET		TAX		;SET ZERO FLAG BASED ON A;THIS DISTINGUISHES ':' AND 0		BEQ	MAIN	;IF BLANK LINE, GET ANOTHER.		LDX	#255	;SET DIRECT LINE NUMBER.		STX	CURLIN+1		BCC	MAIN1	;IS A LINE NUMBER. NOT DIRECT.		JSR	CRUNCH	;COMPACTIFY.		JMP	GONE	;EXECUTE IT.MAIN1:		LDX	PRGEND		STX	VARTAB		LDX	PRGEND+1		STX	VARTAB+1		JSR	LINGET	;READ LINE NUMBER INTO 'LINNUM'		JSR	CRUNCH		STY	COUNT	;RETAIN CHARACTER COUNT.		JSR	FNDLIN		BCC	NODEL	;NO MATCH, SO DON'T DELETE.		LDY	#1		LDA	(LOWTR),Y		STA	INDEX1+1		LDA	VARTAB		STA	INDEX1		LDA	LOWTR+1	;SET TRANSFER TO.		STA	INDEX2+1		LDA	LOWTR		DEY		SBC	(LOWTR),Y	;COMPUTE NEGATIVE LENGTH.		CLC		ADC	VARTAB	;COMPUTE NEW VARTAB.		STA	VARTAB		STA	INDEX2	;SET LOW OF TRANS TO.		LDA	VARTAB+1		ADC	#255		STA	VARTAB+1	;COMPUTE HIGH OF VARTAB.		SBC	LOWTR+1	;COUTE NUMBER OF BLOCKS TO MOVE.		TAX		SEC		LDA	LOWTR		SBC	VARTAB	;COMPUTE OFFSET.		TAY		BCS	QDECT1	;IF VARTAB.LE.LOWTR,		INX		;DECR DUE TO CARRY, AND		DEC	INDEX2+1	;DECREMENT STORE SO CARRY WORKS.QDECT1:		CLC		ADC	INDEX1		BCC	MLOOP		DEC	INDEX1+1		CLC		;FOR LATER ADC.MLOOP:		LDA	(INDEX1),Y		STA	(INDEX2),Y		INY		BNE	MLOOP	;BLOCK DONE?		INC	INDEX1+1		INC	INDEX2+1		DEX		BNE	MLOOP	;DO ANOTHER BLOCK. ALWAYS.NODEL:		LDA	BUF	;SEE IF LINE HAD ANY CONTES.		BEQ	FINI	;IF NOT, DON'T INSERT.		LDA	MEMSIZ		LDY	MEMSIZ+1		STA	FRETOP		STY	FRETOP+1		LDA	VARTAB		STA	HIGHTR	;SETUP HIGHTR.		ADC	COUNT	;ADD LENGTH OF LINE TO INSERT.		STA	HIGHDS	;THIS GIVES DEST ADDR.		LDY	VARTAB+1		STY	HIGHTR+1	;SAME FOR HIGH ORDERS.		BCC	NODELC		INYNODELC:		STY	HIGHDS+1		JSR	BLTU		LDA	LINNUM		LDY	LINNUM+1	;POSITION THE BINARY LINE NUMBER		STA	BUF-2		STY	BUF-2+1	;IN FRONT OF BUF		LDA	STREND		LDY	STREND+1		STA	VARTAB		STY	VARTAB+1		LDY	COUNTSTOLOP:		LDA	BUF-5,Y		DEY		STA	(LOWTR),Y		BNE	STOLOPFINI:		JSR	RUNC	;DO CLEAR & SET UP STACK.;AND SET TXTPTR TO TXTTAB-1.		LDA	TXTTAB		LDY	TXTTAB+1	;SET INDEX TO TXTTAB.		STA	INDEX		STY	INDEX+1		CLC; CHEAD GOES THROUGH PROGRAM STORAGE AND FIXES; UP ALL THE LINKS. THE END OF EACH LINE IS FOUND; BY SEARCHING FOR THE ZERO AT THE END.; THE DOUBLE ZERO LINK IS USED TO DETECT THE END OF PROGCHEAD:		LDY	#1		LDA	(INDEX),Y	;ARRIVED AT DOUBLE ZEROES?		BNE	CCHEADSAVMEM:		LDA	VARTAB		STA	PRGEND		LDA	VARTAB+1		STA	PRGEND+1		JMP	MAIN	;YES, CHEAD HAS FINISHED.CCHEAD:		LDY	#4CZLOOP:		INY		;THERE IS AT LEAST ONE BYTE.		LDA	(INDEX),Y		BNE	CZLOOP	;NO, CONTINUE SEARCHING.		INY		;GO ONE BEYOND.		TYA		ADC	INDEX		TAX		LDY	#0		STA	(INDEX),Y		LDA	INDEX+1		ADC	#0		INY		STA	(INDEX),Y		STX	INDEX		STA	INDEX+1		BCC	CHEAD	;ALWAYS BRANCHES.INLIN:		LDX	#$80	;NO PROMPT CHARACTER		STX	C_PRMP		JSR	C_INLN	;GET A LINE ONTO PAGE 2		CPX	#BUFLEN-1		BCC	GDBUFS	;NOT TOO MANY CHARACTERS		LDX	#BUFLEN-1GDBUFS:		LDA	#0	;PUT A ZERO AT THE END		STA	BUF,X		TXA		BEQ	NOCHRLOPBHT:		LDA	BUF-1,X		AND	#127		STA	BUF-1,X		DEX		BNE	LOPBHTNOCHR:		LDA	#0		LDX	#<BUF-1		LDY	#>BUF-1	;POINT AT THE BEGINNING		RTS;GO TO FININL FAR, FAR AWAY.INCHR:		JSR	C_INCH		AND	#127INCRTS:		RTS		;END OF INCHR.;OF THE TEXT POINTER TO GET TO BUF;AFTER TXTPTR HAS BEEN SETUP TO POINT INTO BUFBUFOFS		EQU	BUF/256*256		IF PLIST <> 0 THEN		PRINT	ON		ELSE		ENDIFCRUNCH:		LDX	TXTPTR	;SETOURCE POINTER.		DEX		LDY	#4	;SET DESTINATION OFFSET.		STY	DORES	;ALLOW CRUNCHING.		BIT	RNONLY	;RUN ONLY?		BPL	SLOOP		PLA		;NO SUBROUTINES IN		PLA		JSR	RUNC	;GO TO IT!		JMP	NEWSTT	;AND RUN!!SLOOP:		INXKLOOP		EQU	*		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //c		JSR	UPSHFT2	;UPSHIFT CHARACTERS FOR TOKEN SEARCH		ELSE		LDA	BUFOFS,X		ENDIF		BIT	DORES		BVS	NOSPCSCMPSPC:		CMP	#$20	;IS IT A SPACE TO SAVE?		BEQ	SLOOP	;YES,IGNORE IT.NOSPCS:		STA	ENDCHR	;IF IT'S A QUOTE, THIS WILL;STOP LOOP WHEN OTHER QUOTE APPEARS.		CMP	#34	;QUOTE SIGN?		BEQ	STRNG	;YES, DO SPECIAL STRING HANDLING.		BVS	STUFFH	;NO CRUNCH, JUST STORE.		CMP	#'?'	;A QMARK?		BNE	KLOOP1		LDA	#PRINTK	;YES, STUFF A 'PRINT' TOKE		BNE	STUFFH	;ALWAYS GO TO STUFFH.KLOOP1:		CMP	#'0'	;SKIP NUMERICS.		BCC	MUSTCR		CMP	#60	;':' AND ';' ARE ENTERED STRAIGHTAWAY.		BCC	STUFFHMUSTCR:		STY	BUFPTR	;SAVE BUFFER POINTER.		LDA	#RESLST	;FOR INDIRECT.		STA	FAC		LDA	#>RESLST-$100	;HI BYTE		STA	FAC+1		LDY	#0	;LOAD RESLST POINTER.		STY	COUNT	;ALSO CLEAR COUNT.		DEY		STX	TXTPTR	;SAVE TEXT POINTER FOR LATER USE.		DEXRESER:		INY		BNE	RESPUL		INC	FAC+1RESPUL:		INXRESCON:		EQU	*		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //c		JSR	UPSHFT2		ELSE		LDA	BUFOFS,X		ENDIF		CMP	#$20	;IS IT A SPACE TO CRUNCH?		BEQ	RESPUL	;SKIP IT.		SEC		;PREPARE TO SUBSTARCT.		SBC	(FAC),Y	;CHARACTERS EQUAL?		BEQ	RESER	;YES, CONTINUE SEARCH.		CMP	#128	;NO BUT MAYBE THE END IS HERE.		BNE	NTHIS	;NO, TRULY UNEQUAL.		ORA	COUNT		CMP	#ATTKN	;AT PROBLEM?		BNE	GETBPT	;NAW, FANCY FREE...		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //c		JSR	UPSHFT1		ELSE		LDA	BUFOFS+1,X	;GET NEXT CHAR.		ENDIF		CMP	#'N'	;IS IT A 'N' (ATN)		BEQ	NTHIS	;IF SO, NO 'AT' FUNCTION		CMP	#'O'	;IS IT A 'O'   (A TO...)		BEQ	NTHIS		LDA	#ATTKN	;NOTHING SPECIAL, GIVE HIM 'AT'GETBPT:		LDY	BUFPTR	;GET BUFFER PNTR.STUFFH:		INX		INY		STA	BUF-5,Y		LDA	BUF-5,Y		BEQ	CRDONE	;NULL IMPLIES END OF LINE.		SEC		;PREPARE TO SUBSTARCT.		SBC	#':'	;IS IT A ':'?		BEQ	COLIS	;YES, ALLOW CRUNCHING AGAIN.		CMP	#DATATK-':'	;IS IT A DATATK?		BNE	NODATT	;NO, SEE IF IT IS REM TOKEN.COLIS:		STA	DORES	;SETUP FLAG.NODATT:		SEC		;PREP TO SBC.		SBC	#REMTK-':'	;REM ONLY STOPS ON NULL.		BNE	KLOOP	;NO, CONTINUE CRUNCHING.		STA	ENDCHR	;REM STOPS ONLY ON NULL, NOT : OR '.STR1:		EQU	*		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //c		JSR	UPSHFT2		ELSE		LDA	BUFOFS,X		ENDIF		BEQ	STUFFH	;YES, END OF LINE, SO DONE.		CMP	ENDCHR	;END OF GOBBLE?		BEQ	STUFFH	;YES, DONE WITH STRING.STRNG:		INY		;INCREMENT BUFFER POINTER.		STA	BUF-5,Y		INX		BNE	STR1	;PROCESS NEXT CHARACTER.NTHIS:		LDX	TXTPTR	;RESTORE TEXT POINTER.		INC	COUNT	;INCREMENT RES WORD COUNT.NTHIS1:		LDA	(FAC),Y	;NEXT WORD TIME...		INY		BNE	*+4		INC	FAC+1		ASL	A		BCC	NTHIS1		LDA	(FAC),Y	;END OF TABLE?		BNE	RESCON		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //c		JSR	UPSHFT3		ELSE		LDA	BUFOFS,X	;YES, END OF TABLE. GET 1ST CHR.		ENDIF		BPL	GETBPT	;STORE IT AWAY (ALWAYS BRANCHES).CRDONE:		STA	BUF-3,Y	;SO THAT IF THIS IS A DIR STATEMENT;ITS END WILL LOOK LIKE END OF PROGRAM.		DEC	TXTPTR+1		LDA	#<BUF-1	;MAKE TXTPTR POINT TO		STA	TXTPTR	;CRUNCHED LINE.LISTRT:		RTS		;RETURN TOALLER.		IF PLIST <> 0 THEN		PRINT	OFF		ELSE		ENDIF; FNDLIN SEARCHES THE PROGRAM TEXT FOR THE LINE; WHOSE NUMBER IS PASSED IN 'LINNUM'.; THERE ARE TWO POSSIBLE RETURNS:; 1) CARRY SET.;    LOWTR POINTS TO THE LINK FIELD IN THE LINE;    WHICH IS THE ONE SEARCHED FOR.; 2) CARRY NOT SET.;    LINE NOT FOUND. LOWTR POINTS TO THE LINE IN THE;    PROGRAM GREATER THAN THE ONE SOUGHT AFTER.FNDLIN:		LDA	TXTTAB		LDX	TXTTAB+1	;LOAD X,A WITH TXTTABFNDLNC:		LDY	#1		STA	LOWTR		STX	LOWTR+1	;STORE X,ANTO LOWTR		LDA	(LOWTR),Y	;SEE IF LINK IS 0		BEQ	FLINRT		INY		INY		LDA	LINNUM+1	;COMP HIGH ORDERS OF LINE NUMBERS.		CMP	(LOWTR),Y		BCC	FLNRTS	;NO SUCH LINE NUMBER.		BEQ	FNDLO1		DEY		BNE	AFFRTS	;ALWAYS BRANCH.FNDLO1:		LDA	LINNUM		DEY		CMP	(LOWTR),Y	;COMPARE LOW ORDERS.		BCC	FLNRTS	;NO SUCH NUMBER.		BEQ	FLNRTS	;GO TIT.AFFRTS:		DEY		LDA	(LOWTR),Y	;FETCH LINK.		TAX		DEY		LDA	(LOWTR),Y		BCS	FNDLNC	;ALWAYS BRANCHES.FLINRT:		CLC		;C MAY BE HIGH.FLNRTS:		RTS		;RETURN TO CALLER.; THE 'NEW' COMMAND CLEARS THE PROGRAM TEXT AS WELL; AS VARIABLE SPACE.SCRATH:		BNE	FLNRTS	;MAKE SURE THERE IS A TERMINATOR.SCRTCH:		LDA	#0	;GET A CLEARER.		STA	RNONLY	;OUT OF RRUN-ONLY MODE.		TAY		;SET UP INDEX.		STA	(TXTTAB),Y	;CLEAR FIRST LINK.		INY		STA	(TXTTAB),Y		LDA	TXTTAB		ADC	#2		STA	VARTAB	;SETUP VARTAB.		STA	PRGEND		LDA	TXTTAB+1		ADC	#0		STA	VARTAB+1		STA	PRGEND+1RUNC:		JSR	STXTPT		LDA	#0	;SET ZERO FLAG; THIS CODE IS FOR THE CLEAR COMMAND.CLEAR:		BNE	STKRTS	;SYNTAX ERROR IF NO TERMINATOR.; CLEARC IS SUBROUTINE WHICH INITIALIZES THE VARIABLE AND; ARRAY SPACE BY RESETING ARYTAB (END OF SIMPLE VARIABLE); AND STREND (END OF ARRAY STORAGE). IT FALLS INTO; 'STKINI' WHICH RESETS THE STACK. CLEARC:		LDA	MEMSIZ		LDY	MEMSIZ+1	;FREE UP STRING SPACE.		STA	FRETOP		STY	FRETOP+1		LDA	VARTAB		LDY	VARTAB+1	;LIBERATE THE		STA	ARYTAB		STY	ARYTAB+1	;VARIABLESND		STA	STREND		STY	STREND+1	;ARRAYS.FLOAD:		JSR	RESTOR	;RESTORE DATA.; STKINI RESETS THE STACK POINTER ELIMINATING; GOSUB AND FOR CONTEXT. STRING TEMPORARIES ARE FREED; UP, SUBFLG IS RESET. CONTINUING IS PROHIBITED.; AND A DUMMY ENTRY IS LEFT AT THE BOTTOM OF THE STACK; FIND A NON-'FOR' ENTRY AT THE BOTTOM OF THE STACK.STKINI:		LDX	#TEMPST	;INITIALIZE STRING TEMPORARIES.		STX	TEMPPT		PLA		;SETUP RETURN ADDRESS.		TAY		PLA		LDX	#STKEND-259	;HAVE STACK POINT TO RETURN ADDRESS.		TXS		PHA		TYA		PHA		LDA	#0		STA	OLDTXT+1	;DISALLOWING CONTINUING		STA	SUBFLG	;ALLOW SUBSCRIPTS.STKRTS:		RTSSTXTPT:		CLC		LDA	TXTTAB		ADC	#255		STA	TXTPTR		LDA	TXTTAB+1		ADC	#255		STA	TXTPTR+1	;SETUP TEXT POINTER.		RTS		IF PLIST <> 0 THEN		PRINT	ON		ELSE		ENDIF		EJECT		TITLE	'THE LIST COMMAND.'LIST:		BCC	GOLST	;IT IS A DIGIT.		BEQ	GOLST	;IT IS A TERMINATOR.		CMP	#MINUTK	;DASH PRECEDING?		BEQ	GOLST		CMP	#$2C		BNE	STKRTSGOLST:		JSR	LINGET	;GET LINE NUMBER INTO NUMLIN.		JSR	FNDLIN	;FIND LINE .GE. NUMLIN.		JSR	CHRGOT	;GET LAST CHARACTER.		BEQ	LSTEND	;IF END OF LINE, # IS THE END.		CMP	#MINUTK	;DASH?		BEQ	*+6		CMP	#$2C		BNE	FLNRTS	;IF NOT, SYNTAX ERROR.		JSR	CHRGET	;GET NEXT CHAR.		JSR	LINGET	;GET END #.		BNE	STKRTS	;IF NOT TERMINATOR, ERROR.LSTEND:		PLA		PLA		;GET RID OF 'NEWSTT' RTS ADDR.		LDA	LINNUM	;SEE IF IT WAS EXISTENT.		ORA	LINNUM+1		BNE	LIST4	;IT WAS TYPED.		LDA	#255		STA	LINNUM		STA	LINNUM+1	;MAKE IT HUGE.LIST4:		LDY	#1		LDA	(LOWTR),Y	;IS LINK ZERO?		BEQ	GRODY	;YES, GO TO READY.		JSR	ISCNTC	;LISTEN FOR CONT-C.		JSR	CRDO	;PRINT CRLF TO START WITH.		INY		LDA	(LOWTR),Y		TAX		INY		LDA	(LOWTR),Y	;GET LINE NUMBER.		CMP	LINNUM+1	;SEE IF BEYOND LAST.		BNE	TSTDUN	;GO DETERMINE RELATION.		CPX	LINNUM	;WAS EQUAL SO TEST LOW ORDER.		BEQ	TYPLIN	;EQUAL, SO LIST IT.TSTDUN:		BCS	GRODY	;IF LINE IS GR THAN LAST, THEN DUNE.TYPLIN:		STY	LSTPNT		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //c		JSR	LDSPCE	;OUTPUT SPACE BEFORE LINE NUMBER		ELSE		JSR	LINPRT	;PRINT AS INT WITHOUT LEADING SPACE.		ENDIF		LDA	#$20	;ALWAYS PRINT SPACE AFTER NUMBER.PRIT4:		LDY	LSTPNT	;GET POINTER TO LINE BACK.		AND	#127PLOOP:		JSR	OUTDO	;PRINT CHAR.		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //c		JSR	LSTFMAT		NOP		ELSE		LDA	$24	;WINDOW WIDTH EXCEEDED?		CMP	#33		ENDIF		BCC	PLOOP1		JSR	CRDO	;GO TO NEXT LINE,		LDA	#$05	;AND FAKE A TAB.		STA	$24PLOOP1:		INY;THE PROGRAM MUST BE MISFORMATED IN;MEMORY DUE TO A BAD LOAD OR BAD;HARDWARE. LET THE GUY RECOVER		LDA	(LOWTR),Y	;GET NEXT CHAR. IS IT ZERO?		BNE	QPLOP	;YES. END OF LINE.		TAY		LDA	(LOWTR),Y		TAX		INY		LDA	(LOWTR),Y		STX	LOWTR		STA	LOWTR+1		BNE	LIST4	;BRANCH IF SOMETHING TO LIST.GRODY:		LDA	#$0D	;PRINT EXTRA CRLF		JSR	OUTDO		JMP	NEWSTT	;THEN GO BACK TONEWSTT FOR NXTLIN.GETNXTW:		INY		;NEXT CHAR IN		BNE	*+4	;RESLST		INC	FAC+1		LDA	(FAC),Y		RTS		IF PLIST <> 0 THEN		PRINT	OFF		ELSE		ENDIF;IS IT A TOKEN?QPLOP:		BPL	PLOOP	;NO, HEAD FOR PRINTER.;YES, JUST TYPE THE CHARACTER.		SEC		SBC	#127	;GET RID OF SIGN BIT AND ADD 1.		TAX		;MAKE IT A COUNTER.		STY	LSTPNT	;SAVE POINTER TO LINE.		LDY	#RESLST		STY	FAC		LDY	#>RESLST-$100		STY	FAC+1		LDY	#255	;LOOK AT RES'D WORD LIST.RESRCH:		DEX		;IS THIS THE RES'D WORD?		BEQ	PRIT25	;YES, GO TOSS IT UPRESCR1:		JSR	GETNXTW		BPL	RESCR1	;NO, CONTINUE PASSING.		BMI	RESRCHPRIT25:		LDA	#$20	;SPACE AROUND RESERVED WORDS.		JSR	OUTDOPRIT3:		JSR	GETNXTW		BMI	PRFINIS	;END OF RESERVED WORD.		JSR	OUTDO	;PRINT IT.		BNE	PRIT3	;END OF ENTRY? NO, TYPE REST.PRFINIS:		JSR	OUTDO		LDA	#$20		BNE	PRIT4		EJECT		TITLE	'THE FOR STATEMENT.'; A 'FOR' ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:; LOW ADDRESS; TOKEN (FORTK) 1 BYTE; A POINTER TO THE LOOP VARIABLE 2 BYTES; THE STEP 4+ADDPRC BYTES; A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE; THE UPPER VALUE 4+ADDPRC BYTE ; LINE NUMBER OF THE 'FOR'; A TEXT POINTER INTO THE 'FOR' STATEMENT 2 BYTES; HIGH ADDRESS; TOTAL 16+2*ADDPRC BYTES.FOR:		LDA	#128	;DON'T RECOGNIZE		STA	SUBFLG	;SUBSCRIPTED VARIABLES.		JSR	LET	;READ THE VARIABLE AND ASSIGN IT;THE CORRECT INITIAL VALUE AND STORE;A POINTER TO THE VARIABLE IN VARPNT.		JSR	FNDFOR	;PNTR IS IN VARPNT, AND FORPNT.		BNE	NOTOL	;IF NO MATCH, DON'T ELIMINATE ANYTHING.		TXA		;MAKE IT ARITHMETICAL.		ADC	#FORSIZ-3	;ELIMINATE ALMOST ALL.		TAX		;NOTE C=1, THEN PLA, PLA.		TXS		;MANIFEST.NOTOL:		PLA		;GET RID OF NEWSTT RETURN ADDRESS		PLA		;IN CASE THIS IS A TOTALLY NEW ENTRY.		LDA	#9		JSR	GETSTK	;MAKE SURE 16 BYTES ARE AVAILABLE.		JSR	DATAN	;GET A COUNT IN Y OF THE NUMBER OF;CHACRACTERS LEFT IN THE 'FOR' STATEMENT;TXTPTR IS UNAFFECTED.		CLC		;PREP TO ADD.		TYA		;SAVE IT FOR PUSHING.		ADC	TXTPTR		PHA		LDA	TXTPTR+1		ADC	#0		PHA		LDA	CURLIN+1		PHA		LDA	CURLIN		PHA		;PUT LINE NUMBER ON STACK.		LDA	#TOTK		JSR	SYNCHR	;'TO' IS NECESSARY.		JSR	CHKNUM	;VALUE MUST BE A NUMBER.		JSR	FRMNUM	;GET UPPER VALUE INTO FAC.		LDA	FACSGN	;PACK FAC.		ORA	#127		AND	FACHO		STA	FACHO	;SET PACKED SIGN BIT.		LDA	#LDFONE		LDY	#>LDFONE		STA	INDEX1		STY	INDEX1+1		JMP	FORPSH	;PUT FAC ONTO STACK, PACKED.LDFONE:		LDA	#FONE		LDY	#>FONE	;PUT 1.0 INTO FAC.		JSR	MOVFM		JSR	CHRGOT		CMP	#STEPTK	;A STEP IS GIVEN?		BNE	ONEON	;NO. AUME 1.0.		JSR	CHRGET	;YES. ADVANCE POINTER.		JSR	FRMNUM	;READ THE STEP.ONEON:		JSR	SIGN	;GET SIGN IN ACCA.		JSR	PUSHF	;PUSH FAC ONTO STACK (THRU A).		LDA	FORPNT+1		PHA		LDA	FORPNT		PHA		;PUT PNTR TO VARIABLE ON STACK.NXTCON:		LDA	#FORTK	;PUT A FORTK ONTO STACK.		PHA; BNEA NEWSTT   ;SIMULATE BNE TO NEWSTT. JUST FALL IN.		EJECT		TITLE	'NEW STATEMENT FETCHER.'; BACK HERE FOR NEW STATEMENT. CHAR POINTED TO BY TXTPT; IS ':' OR END-OF-LINE. THE ADDRESS OF TS LOC IS LEFT; ON THE STACK WHEN A STATEMENT IS EXECUTED SO THAT; IT CAN MERELY DO A RTS WHEN IT IS DONE.NEWSTT:		EQU	*		TSX		;IN CASE OF ERROR.		STX	REMSTK		JSR	ISCNTC	;LISTEN FOR CONTROL-C.		LDA	TXTPTR		LDY	TXTPTR+1	;LOOK AT CURRENT CHARACTER.		LDX	CURLIN+1		INX		BEQ	DIRCON		STA	OLDTXT		STY	OLDTXT+1	;SAVE IN CASE OF RESTART BY INPUT.DIRCON:		LDY	#0		LDA	(TXTPTR),Y		BNE	MORSTS	;NOT NULL -- CHECK WHAT IT IS		LDY	#2	;LOOK AT LINK.		LDA	(TXTPTR),Y	;IS LINK 0?		CLC		BEQ	INTERM	;YES - RAN OFF THE END.		INY		;PUT LINE NUMB IN CURLIN.		LDA	(TXTPTR),Y		STA	CURLIN		INY		LDA	(TXTPTR),Y		STA	CURLIN+1		TYA		ADC	TXTPTR		STA	TXTPTR		BCC	GONE		INC	TXTPTR+1GONE:		BIT	TRFLAG	;IN TRACE MODE?		BPL	GOFORIT	;IF NOT, DO LINE		LDX	CURLIN+1	;IN DIRECT MODE?		INX		BEQ	GOFORIT	;IF SO, DON'T TRACE		LDA	#'#'		JSR	OUTDO	;FOR TRACE FORMAT		LDX	CURLIN		LDA	CURLIN+1		JSR	LINPRT		JSR	OUTSPC	;TRAILING BLANK.GOFORIT:		JSR	CHRGET		JSR	GONE3		JMP	NEWSTTINTERM:		BEQ	ENDCON	;GO ALL THE WAYGONE3:		BEQ	ISCRTS	;IF TERMINATOR, TRY AGAIN.;NO NEED TO SET UP CARRY SINCE IT WILL;BE ON IF NON-NUMERIC AND NUMERICS;WILL CAUSE A SYNTAX ERROR LIKE THEY SHOULDGONE2:		SBC	#ENDTK	;' ON ... GOTO AND GOSUB' COME HERE.		BCC	GLET		CMP	#SCRATK-ENDTK+1		BCS	SNERR1	;SOMRES'D WORD BUT NOT;A STATEMENT RES'D WORD.		ASL	A	;MULTIPLY BY TWO.		TAY		;MAKE AN INDEX.		LDA	STMDSP+1,Y		PHA		LDA	STMDSP,Y		PHA		;PUT DISP ADDR ONTO STACK.		JMP	CHRGETGLET:		JMP	LET	;MUST BE A LETMORSTS:		CMP	#':'		BEQ	GONE	;IF A ':' CONTINUE STATEMENTSNERR1:		JMP	SNERR	;NEITHER 0 OR ':' SO SYNTAX ERROR		EJECT		TITLE	'REST,STOP,END,CONT,NULL,CLEAR.'RESTOR:		SEC		LDA	TXTTAB		SBC	#1		LDY	TXTTAB+1		BCS	RESFIN		DEYRESFIN:		STA	DATPTR		STY	DATPTR+1	;READ FINISHES COME TO 'RESFIN'.ISCRTS:		RTS;WAS IT A CONTROL-C??ISCNTC:		LDA	$C000	;CHECK THE CHARACTER		CMP	#$83		BEQ	ISCCAP		RTSISCCAP:		JSR	INCHR		LDX	#$FF	;FOR BREAK ERROR NUMBER.		BIT	ERRFLG	;IN ONERR MODE?		BPL	*+5	;IF SO, JUMP TO 'HNDLERR'		JMP	HNDLERR		CMP	#$03STOP:		BCS	STOPC	;MAKE C NONZERO AS A FLAG.END:		CLCSTOPC:		BNE	CONTRT	;RETURN IF NOT CONT-C OR;IF NO TERMINATOR FOR STOP OR END.;C=0 SO WILL NOT PRINT 'BREAK'.		LDA	TXTPTR		LDY	TXTPTR+1		LDX	CURLIN+1		INX		BEQ	DIRIS		STA	OLDTXT		STY	OLDTXT+1STPEND:		LDA	CURLIN		LDY	CURLIN+1		STA	OLDLIN		STY	OLDLIN+1DIRIS:		PLA		;POP OFF NEWSTT ADDR.		PLAENDCON:		LDA	#BRKTXT		LDY	#>BRKTXT		BCC	GORDY	;CARRY CLEAR SO DON'T PRINT 'BREAK'.		JMP	ERRFINGORDY:		JMP	READY	;TYPE 'READY'.CONT:		BNE	CONTRT	;MAKE SURE THERE IS A TERMINATOR.		LDX	#ERRCN	;CONTINUE ERROR.		LDY	OLDTXT+1	;A STORED TXTPTR OF ZERO IS SETUP;BY STKINI AND INDICATES THERE IS;NOTHING TO CTINUE.		BNE	*+5		JMP	ERROR	;'STOP', 'END', TYPING CRLF TO ;'INPUT' AND  C SETUP OLDTXT.		LDA	OLDTXT		STA	TXTPTR		STY	TXTPTR+1		LDA	OLDLIN		LDY	OLDLIN+1		STA	CURLIN		STY	CURLIN+1CONTRT:		RTS		;RETURN TO CALLER.		IF PLIST <> 0 THEN		PRINT	ON		ELSE		ENDIF		EJECT		TITLE	'LOAD AND SAVE SUBROUTINES.';FOR APPLE COMPUTERS.		IF LOLLY <> 0 THENUPSHFT1		LDA	BUFOFS+1,X		BPL	UPSHFT4	;BRANCH ALWAYSUPSHFT2		LDA	ENDCHR	;TESTS FOR NO UPSHIFT DESIRED		BEQ	NOSHFT		CMP	#$22	;INSIDE A QUOTED STRING?		BEQ	NOSHFT		LDA	DORES	;TEST FOR DATA STATEMENT		CMP	#$49		BEQ	NOSHFT	;BRANCH IF DATAUPSHFT3		LDA	BUFOFS,X	;GET CHARACTER FROM INPUT BUFFERUPSHFT4		PHP		;SAVE STATUS		CMP	#$61	;IS IT LOWER CASE?		BCC	UPSHFT5		AND	#$5F	;MAKE IT UPPER CASE!UPSHFT5		PLP		;RESTORE STATUS		RTSNOSHFT		LDA	BUFOFS,X	;RETURN ORIGINAL STUFF		RTSLDSPCE		PHA		;SAVE ACC 		LDA	#$20	;OUTPUT A SPACE CHARACTER IN FRONT OF LINE NUMBER		JSR	OUTDO		PLA		JMP	LINPRT	;NOW OUTPUT LINE # LSTFMAT		LDA	$24		CMP	#33	;REGULAR WIDTH		BIT	$C01F		BPL	FMAT40		LDA	$57B	;IF 80-COL ENABLED, COMPARE WITH 73		CMP	#73FMAT40		RTSROMPLOT		EQU	$F80ECOLOR		EQU	$30GBASL		EQU	$26GBASCALC		EQU	$F847MASK		EQU	$2ESETWND		EQU	$FB4BSETGR		EQU	*		LDA	TXTCLR		JSR	CLRTOP		LDA	#$14	;SET WINDOW TOP TO LINE 20		JMP	SETWND	; IN MONITOR *CLRTOP		LDY	#$27	;GET GRAPHICS VERTICAL IN Y REGISTER		STY	V2		JSR	VIDSTATE	;GET VIDEO STATE (DOUBLE GR?)		LDA	#$27		BCC	GRIS40	;BRANCH IF 40 BY 48 (NORMAL)		ROL	AGRIS40		TAY		;WIDTH IN A... PUT IN Y.CLRSC3		LDA	#0		STA	COLOR		JSR	VLINE		DEY		BPL	CLRSC3		RTS*FILL_SIZE01	EQU	APPLESOFT+$912-*	IF FILL_SIZE01 > 0	THEN		DCB.B	FILL_SIZE01,0	;FILL REMAINDER WITH BREAKS FOR LOLLY	ENDIF		ELSESAVE:		SEC		;CALCLUATE PROGRAM SIZE IN POKER		LDA	PRGEND	;GET ACTUAL END OF PROGRAM		SBC	TXTTAB		STA	POKER		LDA	PRGEND+1		SBC	TXTTAB+1		STA	POKER+1		JSR	VARTIO		JSR	C_COUT	;WRITE PROGRAM SIZE POK		JSR	PROGIO		JMP	C_COUT	;WRITE PROGRAM.LOAD:		JSR	VARTIO		JSR	C.CSIN	;READ SIZE OF PROGRAM INTO POKER		CLC		LDA	TXTTAB	;CALCULATE VARTAB FROM SIZE AND		ADC	POKER	;TXTTAB		STA	VARTAB		LDA	TXTTAB+1		ADC	POKER+1		STA	VARTAB+1		LDA	POKER+2		STA	RNONLY	;HAHA!! FUCKED HIM OVER!		JSR	PROGIO		JSR	C_CSIN	;READ PROGRAM.		BIT	RNONLY	;IS THIS A SPECIAL PROGRAM?		BPL	DOTHEREST		JMP	RUNCDOTHEREST:	JMP	FINIVARTIO:		LDA	#POKER		LDY	#>POKER		STA	$3C		STY	$3C+1		LDA	#POKER+2		STA	$3E		STY	$3E+1		STY	RNONLY	;REGULAR SAVE...		RTSPROGIO:		LDA	TXTTAB		LDY	TXTTAB+1		STA	$3C		STY	$3C+1		LDA	VARTAB		LDY	VARTAB+1		STA	$3E		STY	$3E+1		RTS		ENDIF		IF PLIST <> 0 THEN		PRINT	OFF		ELSE		ENDIF		EJECT		TITLE	'RUN,GOTO,GOSUB,RETURN.'RUN:		PHP		DEC	CURLIN+1	;RUN NOT DIRECT!		PLP		BNE	*+5		JMP	RUNC	;IF NO LINE # ARGUMENT.		JSR	CLEARC	;CLEAN UP -- RESET THE STACK.		JMP	RUNC2	;MUST REPLACE RTS ADDR.; A GOSUB ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:; LOW ADDRESS:; THE GOSUTK ONE BYTE; THE LINE NUMBER OF THE GOSUB STATEMENT TWO BYTES; A POINTER INTO THE TEXT OF THE GOSUB TWO BYS; HIGH ADDRESS.; TOTAL FIVE BYTES.GOSUB:		LDA	#3		JSR	GETSTK	;MAKE SURE THERE IS ROOM.		LDA	TXTPTR+1		PHA		LDA	TXTPTR		PHA		;PUSH ON THE TEXT POINTER.		LDA	CURLIN+1		PHA		LDA	CURLIN		PHA		;PUSH ON THE CURRENT LINE NUMBER.		LDA	#GOSUTK		PHA		;PUSH ON A GOSUB TOKEN.RUNC2:		JSR	CHRGOT	;GET CHARACTER & SET CODES FOR LINGET.		JSR	GOTO	;USE RTS SCHEME TO 'NEWSTT'.		JMP	NEWSTTGOTO:		JSR	LINGET	;PICK UP THE LINE NUMBER IN 'LINNUM'.		JSR	REMN	;SKIP TO END OF LINE.		LDA	CURLIN+1		CMP	LINNUM+1		BCS	LUK4IT		TYA		SEC		ADC	TXTPTR		LDX	TXTPTR+1		BCC	LUKALL		INX		BCS	LUKALL	;ALWAYS GOES.LUK4IT:		LDA	TXTTAB		LDX	TXTTAB+1LUKALL:		JSR	FNDLNC	;X,A ARE ALL SET UP.QFOUND:		BCC	USERR	;GOTO LINE IS NONEXISTANT.		LDA	LOWTR		SBC	#1		STA	TXTPTR		LDA	LOWTR+1		SBC	#0		STA	TXTPTR+1GORTS:		RTS		;PROCESS THE STATEMENT.; 'RETURN' RESTORES LINE NUMBER AND TEXT PNTR FROM STACK; AND ELIMINATES ALL E 'FOR' ENTRIES IN FRONT OF 'GOSUB'RETURN:		BNE	GORTS	;NO TERMINATOR=BLOW HIM UP.		LDA	#255		STA	FORPNT	;MAKE SURE THE VARIABLE'S PNTR;NEVER GETS MATCHED.		JSR	FNDFOR	;GO PAST ALL THE 'FOR' ENTRIES.		TXS		CMP	#GOSUTK	;RETURN WITHOUT GOSUB?		BEQ	RETU1		LDX	#ERRRG		DC.B	44USERR:		LDX	#ERRUS	;NO MATCH SO 'US' ERROR.		JMP	ERROR	;YES.SNERR2:		JMP	SNERRRETU1:		PLA		;REMOVE GOSUTK.		PLA		CPY	#<POPTKN*2	;POP STATEMENT		BEQ	DOPOP		STA	CURLIN		PLA		STA	CURLIN+1	;GET LINE NUMBER 'GOSUB' WAS OM.		PLA		STA	TXTPTR		PLA		STA	TXTPTR+1	;GET TEXT PNTR FROM 'GOSUB'.DATA:		JSR	DATAN	;SKIP TO END OF STATEMENT, ;SINCE WHEN 'GOSUB' STUCK THE TEXT  PNTR;ONTO THE STACK, THE LINE NUMBER ARG;HADN'T BEEN READ YET.ADDON:		TYA		CLC		ADC	TXTPTR		STA	TXTPTR		BCC	REMRTS		INC	TXTPTR+1REMRTS:		RTS		;'NEWSTT' RTS ADDR IS STILL THERE.DATAN:		LDX	#':'	;'DATA' TERMINATES ON ':' AND NULL.		DC.B	44REMN:		LDX	#0	;THE ONLY TERMINATOR IS NULL.		STX	CHARAC	;PRESERVE IT.		LDY	#0	;THIS MAKES CHARAC=0 AFTER SWAP.		STY	ENDCHREXCHQT:		LDA	ENDCHR		LDX	CHARAC		STA	CHARAC		STX	ENDCHRREMER:		LDA	(TXTPTR),Y		BEQ	REMRTS	;NULL ALWAYS TERMINATES.		CMP	ENDCHR	;IS IT THE OTHER TERMINATOR?		BEQ	REMRTS	;YES, IT'S FINISHED.		INY		;PROGRESS TO NEXT CHARACTER.		CMP	#34	;IS IT A QUOTE?		BNE	REMER	;NO, JUST CONTINUE.		BEQ	EXCHQT	;YES, TIME TO TRADE.DOPOP:		PLA		;GET OTHER STUFF OFF STACK		PLA		PLA		;NEWSTT ADDR STILL THERE		RTS		;SO GO BACK.....		EJECT		TITLE	'IF ... THEN CODE.'IF:		JSR	FRMEVL	;EVALUATE A FORMULA.		JSR	CHRGOT	;GET CURNT CHARACTER.		CMP	#GOTOTK	;IS TERMINATING CHARACTER A GOTOTK?		BEQ	OKGOTO	;YES.		LDA	#THENTK		JSR	SYNCHR	;NO, IT MUST BE 'THEN'.OKGOTO:		LDA	FACEXP	;0=FALSE. ALL OTHERS TRUE.		BNE	DOCOND	;TRUE !REM:		JSR	REMN	;SKIP REST OF STATEMENT.		BEQ	ADDON	;WILL ALWAYS BRANCH.DOCOND:		JSR	CHRGOT	;TEST CURRENT CHARACTER.		BCS	DOCO	;IF A NUMBER, GOTO IT.		JMP	GOTODOCO:		JMP	GONE3	;INTERPRET NEW STATEMENT.		EJECT		TITLE	'ON ... GO TO ... CODE.'ONGOTO:		JSR	GETBYT	;GEVALUE IN FACLO.		PHA		;SAVE FOR LATER.		CMP	#GOSUTK	;AN 'ON ... GOSUB' PERHAPS?		BEQ	ONGLOP	;YES.SNERR3:		CMP	#GOTOTK	;MUST BE 'GOTOTK'.		BNE	SNERR2ONGLOP:		DEC	FACLO		BNE	ONGLP1	;SKIP ANOTHER LINE NUMBER.		PLA		;GET DISPATCH CHARACTER.		JMP	GONE2ONGLP1:		JSR	CHRGET	;ADVANCE AND SET CODES.		JSR	LINGET		CMP	#44	;IS IT A COMMA?		BEQ	ONGLOP		PLA		;REMOVE STACK ENTRY (TOKEN).ONGRTS:		RTS		;EITHER END-OF-LINE OR SYNTAX ERROR.		EJECT		TITLE	'LINGET -- READ A LINE NUMBER'; 'LINGET' READS A LINE NUMBER FROM CURRENT TEXT POSITION; LINE NUMBERS RANGE FROM 0 TO 64000-1.; THE ANSWER IS RETURNED IN 'LINNUM'.; 'TXTPTR' IS UPDATED TO POINT TO THE TERMINATING CHARCTER; AND A = THE TERMINATING CHARACTER WITH CONDITION; CODES SET UP TO REFLECT ITS VALUE.LINGET:		LDX	#0		STX	LINNUM	;INITIALIZE LINE NUMBER TO ZERO.		STX	LINNUM+1MORLIN:		BCS	ONGRTS	;IT IS NOT A DIGIT.		SBC	#'0'-1	;-1 SINCE C=0.		STA	CHARAC	;SAVE CHARACTER.		LDA	LINNUM+1		STA	INDEX		CMP	#25	;LINE NUMBER WILL BE .LT. 64000?		BCS	SNERR3		LDA	LINNUM		ASL	A	;MULTIPLY BY 10.		ROL	INDEX		ASL	A		ROL	INDEX		ADC	LINNUM		STA	LINNUM		LDA	INDEX		ADC	LINNUM+1		STA	LINNUM+1		ASL	LINNUM		ROL	LINNUM+1		LDA	LINNUM		ADC	CHARAC	;ADD IN DIGIT.		STA	LINNUM		BCC	NXTLGC		INC	LINNUM+1NXTLGC:		JSR	CHRGET		JMP	MORLIN		EJECT		TITLE	'LET CODE.'LET:		JSR	PTRGET	;GET PNTR TO VARIABLE INTO 'VARPNT'.		STA	FORPNT		STY	FORPNT+1	;PRESERVE POINTER.		LDA	#EQULTK		JSR	SYNCHR	;'=' IS NECESSARY.		LDA	INTFLG	;SAVE FOR LATER.		PHA		LDA	VALTYP	;RETAIN THE VARIABLE'S VALUE TYPE.		PHA		JSR	FRMEVL	;GET VALUE OF FORMULA INTO 'FAC'.		PLA		ROL	A	;CARRY SET FOR STRING, OFF FOR;NUMERIC.		JSR	CHKVAL	;MAKE SURE 'VALTYP' MATCHES CARRY.;AND SET ZERO FLAG FOR NUMERIC.		BNE	COPSTR	;IF NUMERIC, COPY IT.COPNUM:		PLA		;GET NUMBER TYPE.QINTGR:		BPL	COPFLT	;STORE A FLTING NUMR.		JSR	ROUND	;ROUND INTEGER.		JSR	AYINT	;MAKE 2-BYTE NUMBER.		LDY	#0		LDA	FACMO	;GET HIGH.		STA	(FORPNT),Y	;STORE IT.		INY		LDA	FACLO	;GET LOW.		STA	(FORPNT),Y		RTSCOPFLT:		JMP	MOVVF	;PUT NUMBER @FORPNT.COPSTR:		EQU	*		PLA		;IF STRING, NO INTFLG.INPCOM:		EQU	*;ADD IN DIGIT TO FAC.GETSPT:		LDY	#2	;GET PNTR TO DESCRIPTOR.		LDA	(FACMO),Y		CMP	FRETOP+1	;SEE IF IT POINTS INTO STRING SPACE.		BCC	DNTCPY	;IF FRETOP,GT.2&3,FACMO, DON'T COPY.		BNE	QVARIA	;IT IS LESS.		DEY		LDA	(FACMO),Y		CMP	FRETOP	;COMPARE LOW ORDERS.		BCC	DNTCPYQVARIA:		LDY	FACLO		CPY	VARTAB+1	;IF VARTAB.GT.FACMO, DON'T COPY.		BCC	DNTCPY		BNE	COPY	;IT IS LESS.		LDA	FACMO		CMP	VARTAB	;COMPARE LOW ORDERS.		BCS	COPYDNTCPY:		LDA	FACMO		LDY	FACMO+1		JMP	COPY_CCOPY:		LDY	#0		LDA	(FACMO),Y		JSR	STRINI	;GET ROOM TO COPY STRING INTO.		LDA	DSCPNT		LDY	DSCPNT+1	;GET POINTER TO OLD DESCRIPTOR, SO 		STA	STRNG1		STY	STRNG1+1	;MOVINS CAN FINSTRING.		JSR	MOVINS	;COPY IT.		LDA	#DSCTMP		LDY	#>DSCTMP	;GET POINTER TO OLD DESCRIPTOR.COPY_C:		STA	DSCPNT		STY	DSCPNT+1	;REMEMBER POINTER TO DESCRIPTOR.		JSR	FRETMS	;FREE UP THE TEMPORARY WITHOUT;FREEING UP ANY STRING SPACE.		LDY	#0		LDA	(DSCPNT),Y		STA	(FORPNT),Y		INY		;POINT TO STRING PNTR.		LDA	(DSCPNT),Y		STA	(FORPNT),Y		INY		LDA	(DSCPNT),Y		STA	(FORPNT),Y		RTS		EJECT		TITLE	'PRINT CODE.'STRDON:		JSR	STRPRTNEWCHR:		JSR	CHRGOT	;REGET LAST CHARACTER.PRINT:		BEQ	CRDO	;TERMINATOR SO TYPE CRLF.PRINTC:		BEQ	PRTRTS	;HERE AFTER SEEING TAB(X) OR , OR ;;IN WHICH CASE A TERMINATOR DOES NOT;MEAN TYPE A CRLF BUT JUST RTS.		CMP	#TABTK	;TAB FUNCTION?		BEQ	TABER	;YES.		CMP	#SPCTK	;SPACE FUNCTION?		CLC		;REMEMBER IF IT IS.		BEQ	TABER		CMP	#44	;A COMMA?		CLC		BEQ	COMPRT	;YES.		CMP	#59	;A SEMICOLON?		BEQ	NOTABR	;YES.		JSR	FRMEVL	;EVALUATE THE FORMULA.		BIT	VALTYP	;A STRING?		BMI	STRDON	;YES.		JSR	FOUT		JSR	STRLIT		JMP	STRDON		IF PLIST <> 0 THEN		PRINT	ON		ENDIFCRDO:		EQU	*		LDA	#13	;MAKE TRMPOS LESS THAN LINE LENGTH.		JSR	OUTDOCRFIN:		EQU	*		EOR	#255PRTRTS:		RTS		IF A2E+LOLLY <> 0 THEN		;Do for enhanced //e and //cCOMPRT		JSR	LSTFMAT		BMI	MORCOM	;PAST LAST COMMA POSITION		CMP	#$18		BCC	MORCOM		JSR	CRDO		BNE	NOTABR	;FINISH UPMORCOM:		ADC	#$10	;DO COMMA FOR PRINTER CARD		AND	#$F0	;THE RIGHT WAY SO IT WILL WORK!		TAX		SEC		BCS	TABR1A	;FINISH UP BY PRINTING SPACES TO NEXT TAB. TABER:		PHP		;REMEMBER IF SPC OR TAB FUNCTION.		JSR	GTBYTC	;GET VALUE INTO ACCX.		CMP	#41		BNE	SNERR4* 		PLP		BCC	XSPAC	;PRINT X SPACES.TABER1		DEX		;COLUMN 1 ISFIRSTTABR1A		JSR	TABER2		BCC	NOTABR	;NEGATIVE, DON'T PRINT ANY.		ELSECOMPRT		LDA	TRMPOS		CMP	#$18	;PAST LAST COMMA POSITION		BCC	MORCOM		JSR	CRDO		BNE	NOTABR	;FINISH UPMORCOM:		ADC	#$10	;DO COMMA FOR PRINTER CARD		AND	#$F0	;THE WRONG WAY SO IT WILL WORK!		STA	TRMPOS		BCC	NOTABR	;FINISH UP.TABER:		PHP		;REMEMBER IF SPC OR TAB FUNCTION.		JSR	GTBYTC	;GET VALUE INTO ACCX.		CMP	#41		BEQ	*+5		JMP	SNERR		PLP		BCC	XSPAC	;PRINT X SPACES.		DEX		;COLUMN 1 IS FIRST		TXA		SBC	TRMPOS		BCC	NOTABR	;NEGATIVE, DON'T PRINT ANY.		ENDIFASPAC:		TAXXSPAC:		INXXSPAC2:		DEX		;DECREMENT THE COUNT.		BNE	XSPAC1NOTABR:		JSR	CHRGET	;REGET LAST CHARACTER.		JMP	PRINTC	;DON'T CALL CRDO.XSPAC1:		JSR	OUTSPC		BNE	XSPAC2; PRINT STRING POINTED TO BY Y,A WHICH ENDS WITH A ZERO.; IF STRING IS BELOW DSCTMP IT WILL BE COPIED INTO STRINGSTROUT:		JSR	STRLIT	;GET A STRING LITERAL.; PRINT THE STRING WHOSE DESCRIPTOR IS POINTED TO BY FACMOSTRPRT:		JSR	FREFAC	;RETURN TEMP POINTER.		TAX		;PUT COUNT INTO COUNTER.		LDY	#0		INX		;MOVE ONE AHEAD.STRPR2:		DEX		BEQ	PRTRTS	;ALL DONE.		LDA	(INDEX),Y	;PNTR TO ACT STRNG SET BY FREFAC.		JSR	OUTDO		INY		CMP	#13		BNE	STRPR2		JSR	CRFIN	;TYPE REST OF CARRIAGE RETURN.		JMP	STRPR2	;AND ON AND ON.		IF PLIST <> 0 THEN		PRINT	OFF		ENDIF; OUTDO OUTPUTS THE CHARACTER IN ACCA, USING CNTWFL; (SUPPSS OR NOT), TRMPOS (PRINT HEAD POSITION),; TIMING, ETC.. NO REGISTERS ARE CHANGED.OUTSPC:		EQU	*		LDA	#$20		DC.B	44OUTQST:		LDA	#'?'OUTDO:		EQU	*		ORA	#$80	;TURN ON B7 FOR APPLE.		CMP	#$A0	;CONTROL CHARACTER?		BCC	OUTLOC		ORA	ORMASKOUTLOC:		JSR	OUTCH	;OUTPUT THE CHARACTER.		AND	#$7F	;GET A BACK FROM APPLE.		PHA		;NOW DELAY FOR SPEED=		LDA	SPDBYT		JSR	WAITNOW		PLAGETRTS:		RTS		EJECT		TITLE	'INPUT AND READ CODE'; HERE WHEN DATA THAT WAS TYPED IN OR IN 'DATA' STATEMENT; IS IMPROPERLY FORMATTED. FOR 'INPUT' WE START AGAIN.; FOR 'READ' WE GIVE A SYNTAX ERROR AT THE DATA LINE.TRMNOK:		LDA	INPFLG		BEQ	TRMNO1	;IFNPUT TRY AGAIN.		BMI	GETDTL		LDY	#255	;MAKE IT LOOK DIRECT.		BNE	STCURL	;ALWAYS GOES.GETDTL:		EQU	*		LDA	DATLIN		LDY	DATLIN+1	;GET DATA LINE NUMBER.STCURL:		STA	CURLIN		STY	CURLIN+1	;MAKE IT CURRENT LINE.SNERR4:		JMP	SNERR		PLATRMNO1:		EQU	*		BIT	ERRFLG	;ON ERR IN EFFECT?		BPL	DOAGIN	;NO.		LDX	#254	;ERROR CODE IS 254 FOR BAD INPUT.		JMP	HNDLERRDOAGIN:		LDA	#TRYAGN		LDY	#>TRYAGN		JSR	STROUT	;PRINT '?REDO FROM START'.		LDA	OLDTXT		LDY	OLDTXT+1	;POINT AT START		STA	TXTPTR		STY	TXTPTR+1	;OF THIS CURRENT LINE.		RTS		;GO TO 'NEWSTT'.GET:		JSR	ERRDIR	;DIRECT IS NOT OK.GETTTY:		LDX	#<BUF+1		LDY	#>BUF+1	;POINT TO 0.		LDA	#0	;TO STUFF AND TO POINT.		STA	BUF+1		LDA	#64	;TURN ON V-BIT.		JSR	INPCO1	;DO THE GET.		RTSINPUT:		EQU	*		CMP	#34	;A QUOTE?		BNE	NOTQTI	;NO MESSA.		JSR	STRTXT	;LITERALIZE THE STRING IN TEXT		LDA	#59		JSR	SYNCHR	;MUST END WITH SEMICOLON.		JSR	STRPRT	;PRINT IT OUT.		JMP	NOTQTII	;DON'T PRIN OUT QUESTION MARKNOTQTI:		JSR	OUTQST	;PRINT A ? FOR INPUTNOTQTII:		JSR	ERRDIR	;USE COMMON ROUTINE SINCE DEF DIRECT		LDA	#44	;GET COMMA.		STA	BUF-1;IS ALSO ILLEGAL.GETAGN:		JSR	INLIN	;INPUT A LINE OF TEXT.		LDA	BUF	;ANYTHING INPUT?		CMP	#$03	;CONTROL-C AT FRONT OF LINE?		BNE	INPCON	;YES, CONTINUE		JMP	ISCCAP+3	;NO, STOP.QINLIN:		EQU	*		JSR	OUTQSTGINLIN:		JMP	INLINREAD:		LDX	DATPTR		LDY	DATPTR+1	;GET LAST DATA LOCATION.		LDA	#$98	;FOR STUFF..		DC.B	44	;SKIP OVER LDA #0 OPERATION.INPCON:		LDA	#0INPCO1:		STA	INPFLG	;STORE THE FLAG.; IN THE PROCESSING OF DATA AND READ STATEMENTS:; ONE POINTER POINTS TO DATA (THE NUMBERS BEING FETCHED); AND ANOTHER POINTS TO THE LIST OF VARIABLES.; THE POINTER INTO THE DATA ALWAYS STARTS POINTING TO A; TERMINATOR -- A , : OR END-OF-LINE.; AT THIS POINT TXTPTR POINTS TO LIST OF VARIABLES AND; Y,X POINTS TO DATA OR INPUT LINE.		STX	INPPTR		STY	INPPTR+1INLOOP:		JSR	PTRGET	;READ VARIABLE LIST.		STA	FORPNT		STY	FORPNT+1	;SAVE POINTER FOR 'LET' STRING UFFING.;RETURNS PNTR TOP VAR IN VARPNT.		LDA	TXTPTR		LDY	TXTPTR+1	;SAVE TEXT PNTR.		STA	VARTXT		STY	VARTXT+1		LDX	INPPTR		LDY	INPPTR+1		STX	TXTPTR		STY	TXTPTR+1		JSR	CHRGOT	;GET IT AND SET Z IF TERM.		BNE	DATBK1		BIT	INPFLG		BVC	QDATA		JSR	C_GETL	;DON'T WANT INCHR. JUST ONE.		AND	#127		STA	BUF	;MAKE IT FIRST CHARACTER.		LDX	#<BUF-1		LDY	#>BUF-1	;POINT JUST BEFORE IT.		BNE	DATBK	;GO PROCESS.QDATA:		BMI	DATLOP	;SEARCH FOR ANOTHER DATA STATEMENT.		JSR	OUTQSTGETNTH:		JSR	QINLIN	;GET ANOTHER LINE.DATBK:		STX	TXTPTR		STY	TXTPTR+1	;SET FOR 'CHRGET'.DATBK1:		JSR	CHRGET		BIT	VALTYP	;GET VALUE TYPE.		BPL	NUMINS	;INPUT A NUMBER IF NUMERIC.		BIT	INPFLG	;GET?		BVC	SETQUT	;NO, GO SET QUOTE.		INX		STX	TXTPTR		LDA	#0	;ZERO TERMINATORS.		STA	CHARAC		BEQ	RESETCSETQUT:		STA	CHARAC	;ASSUME QUOTED STRING.		CMP	#34	;TERMINATORS OK?		BEQ	NOWGET	;YES.		LDA	#':'	;SET TERMINATORS TO ':' AND		STA	CHARAC		LDA	#44	;COMMA.RESETC:		CLCNOWGET:		STA	ENDCHR		LDA	TXTPTR		LDY	TXTPTR+1		ADC	#0	;C IS SET PROPERLY ABOVE.		BCC	NOWGE1		INYNOWGE1:		JSR	STRLT2	;MAKE A STRING DESCRIPTOR FOR VALUE;AND COPY IF NECESSARY.		JSR	ST2TXT	;SET TEXT POINTER.		JSR	INPCOM	;DO ASSIGNMENT.		JMP	STRDN2NUMINS:		PHA		LDA	BUF	;BLANK INPUT?		BEQ	MAYBADNUMINS2:		PLA		JSR	FIN	;GET VALUE.		LDA	INTFLG	;SET CODES ON FLAG.		JSR	QINTGR	;GO DECIDE ON FLOAT.STRDN2:		JSR	CHRGOT	;READ LAST CHARACTER.		BEQ	TRMOK	;':' OR EOL IS OK.		CMP	#44	;A COMMA?		BEQ	*+5		JMP	TRMNOKTRMOK:		LDA	TXTPTR		LDY	TXTPTR+1		STA	INPPTR		STY	INPPTR+1	;SAVE FOR MORE READS.		LDA	VARTXT		LDY	VARTXT+1		STA	TXTPTR		STY	TXTPTR+1	;POINT TO VARIABLE LIST.		JSR	CHRGOT	;LOOK AT LAST VARIABLE LIST CHARACTER.		BEQ	VAREND	;THAT'S THE END OF THE LIST.		JSR	CHKCOM	;NOT END. CHECK FOR COMMA.		JMP	INLOOPMAYBAD:		LDA	INPFLG		BNE	NUMINS2		JMP	TRMNO1-1; SUBROUTINE TO FIND DATA; SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO; SKIP OR STATEMENTS. THE START WORD OF EACH STATEMENT; IS COMPARED WITH 'DATATK'. EACH NEW LINE NUMBER; IS STORED IN 'DATLIN' SO THAT IF AN ERROR OCCURS; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE; NUMBER OF THE ILL-FORMATTED DATA.DATLOP:		JSR	DATAN	;SKIP SOME TEXT.		INY		TAX		;END OF LINE?		BNE	NOWLIN	;SHO AIN'T.		LDX	#ERROD	;YES = 'NO DATA' ERROR.		INY		LDA	(TXTPTR),Y		BEQ	ERRGO5		INY		LDA	(TXTPTR),Y	;GET HIGH BYTE OF LINE NUMBER.		STA	DATLIN		INY		LDA	(TXTPTR),Y	;GET LOW BYTE.		INY		STA	DATLIN+1NOWLIN:		LDA	(TXTPTR),Y	;HOW IS IT?		TAX		JSR	ADDON	;ADD Y TO TXTPTR.		CPX	#DATATK	;IS IT A 'DATA' STATEMENT.		BNE	DATLOP	;NOT QUITE RIGHT. KEEP LOOKING.		JMP	DATBK1	;THIS IS THE ONE !VAREND:		LDA	INPPTR		LDY	INPPTR+1	;PUT AWAY A NEW DATA PNTR MAYBE.		LDX	INPFLG		BPL	VARY0		JMP	RESFINVARY0:		LDY	#0		LDA	(INPPTR),Y	;LAST DATA CHR COULD HAVE BEEN;COMMA OR COLON BUT SHOULD BE NULL.		BEQ	INPRTS	;IT IS NUL		LDA	#EXIGNT		LDY	#>EXIGNT		JMP	STROUT	;TYPE '?EXTRA IGNORED'INPRTS:		RTS		;DO NEXT STATEMENT.EXIGNT:		DC.B	'?EXTRA IGNORED'		DC.B	13		DC.B	0TRYAGN:		DC.B	'?REENTER'		DC.B	13		DC.B	0		EJECT		TITLE	'THE NEXT CODE IS THE NEXT CODE'; A 'FOR' ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:; LOW ADDRESS; TOKEN (FORTK) 1 BYTE; A POINTER TO THE LOOP VARIABLE 2 BYTES; T STEP 4+ADDPRC BYTES; A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE; THE UPPER VALUE (PACKED) 4+ADDPRC BYTES; THE LINE NUMBER OF THE 'FOR' STATEMENT 2 BYTES; A TEXT POINTER INTO THE 'FOR' STATEMENT 2 BYTES; HIGH ADDRESS; TOTAL 16+2*ADDPRC BYTES.NEXT:		BNE	GETFOR		LDY	#0	;WITHOUT ARG CALL 'FNDFOR' WITH		BEQ	STXFOR	;FORPNT=0.GETFOR:		JSR	PTRGET	;GET A POINTER TO LOOP VARIABLESTXFOR:		STA	FORPNT		STY	FORPNT+1	;INTO 'FORPNT'.		JSR	FNDFOR	;FIND THE MATCHI ENTRY IF ANY.		BEQ	HAVFOR		LDX	#ERRNF	;'NEXT WITHOUT FOR'.ERRGO5:		BEQ	ERRGO4HAVFOR:		TXS		;SETUP STACK. CHOP FIRST.		INX		INX		INX		INX		;POINT TO INCREMENT.		TXA		;SET LO ADDR OF THING TO MOVE.		INX		INX		INX		INX		INX		INX		;POINT TO UPPER LIMIT.		STX	INDEX2		LDY	#1	;SET HI ADDR OF THING TO MOVE.		JSR	MOVFM	;GET QUANTITY INTO THE FAC.		TSX		LDA	257+7+1,X	;SET SIGN CORRECTLY.		STA	FACSGN		LDA	FORPNT		LDY	FORPNT+1		JSR	FADD	;ADD INC TO LO VARIABLE.		JSR	MOVVF	;PACK THE FAC INTO MEMORY.		LDY	#1		JSR	FCOMPN	;COMPARE FAC WITH UPPER VALUE.		TSX		SEC		SBC	257+7+1,X	;SUBTRACT SIGN OF INC FROM SIGN OF;OF (CURRENT VALUE-FINAL VALUE).		BEQ	LOOPDN	;IF SIGN (FINAL-CURRENT)-SIGN STEP=0;THEN LOOP IS DONE.		LDA	257+12+2,X		STA	CURLIN	;STORE LINE NUMBER OF 'FOR' STATEMENT.		LDA	257+13+2,X		STA	CURLIN+1		LDA	257+15+2,X		STA	TXTPTR	;STORE TEXT PNTR INTO 'FOR' STATEMENT.		LDA	257+14+2,X		STA	TXTPTR+1NEWSGO:		JMP	NEWSTT	;PROCESS NEXT STATEMENT.LOOPDN:		TXA		ADC	#15+2	;ADDS 16 WITH CARRY.		TAX		TXS		;NEW STACK PNTR.		JSR	CHRGOT		CMP	#44	;COMMA AT END?		BNE	NEWSGO		JSR	CHRGET		JSR	GETFOR	;DO NEXT BUT DON'T ALLOW BLANK VARIABLE;PNTR. VARPNT IS THE STK PNTR WHICH;NEVER MATCHES ANY POINTER.;JSR TO PUT ON DUMMY NEWSTT ADDR.		EJECT		TITLE	'FORMULA EVALUATION CODE.'; THESE ROUTINES CHECK FOR CERTAIN 'VALTYP'.; C IS NOT PRESERVED.FRMNUM:		JSR	FRMEVLCHKNUM:		CLC		DC.B	36CHKSTR:		SEC		;SET CARRY.CHKVAL:		BIT	VALTYP	;WILL NOT F UP 'VALTYP'.		BMI	DOCSTR		BCS	CHKERRCHKOK:		RTSDOCSTR:		BCS	CHKOKCHKERR:		LDX	#ERRTMERRGO4:		JMP	ERROR; THE FORMULA EVALUATOR STARTS WITH; TXTPTR POINTING TO THE FIRST CHARACTER OF THE FORMULA.; AT THE END TXTPTR POINTS TO THE TERMINATOR.; THE RESULT IS LEFT IN THE FAC.; ON RETURN A DOES NOT REFLECT THE TERMINATOR.; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB); TO DETERMINE PCEDENCE AND DISPATCH ADDRESSES FOR ; EACH OPERATOR.; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT; THE ADDRESS OF THE OPERATOR ROUTINE.; THE FLOATING POINT TEMPORARY RESULT.; THE PRECEDENCE OF THE OPERATOR.FRMEVL:		LDX	TXTPTR		BNE	FRMEV1		DEC	TXTPTR+1FRMEV1:		DEC	TXTPTR		LDX	#0	;INITIAL DUMMY PRECEDENCE IS 0.		DC.B	36LPOPER:		PHA		;SAVE LOW PRECEDENCE. (MASK.)		TXA		PHA		;SAVE HIGH PRECEDENCE.		LDA	#1		JSR	GETSTK	;MAKE SURE THERE IS ROOM FOR;RECURSIVE CALLS.		JSR	EVAL	;EVALUATE SOMETHING.		LDA	#$00		STA	OPMASK	;PREPARE TO BUILD MASK MAYBE.TSTOP:		JSR	CHRGOT	;REGET LAST CHARACTER.LOPREL:		SEC		;PREP TO SUBTRACT.		SBC	#GREATK	;IS CURRENT CHARACTER A RELATION?		BCC	ENDREL	;NO. RELATIONS ALL THROUGH.		CMP	#LESSTK-GREATK+1	;REALLY RELATIONAL?		BCS	ENDREL	;NO -- JUST BIG.		CMP	#1	;RESET CARRY FOR ZERO ONLY.		ROL	A	;0 TO 1, 1 TO 2, 2 TO 4.		EOR	#1		EOR	OPMASK	;BRING IN THE OLD BITS.		CMP	OPMASK	;MAKE SUREHE NEW MASK IS BIGGER.		BCC	SNERR5	;SYNTAX ERROR. BECAUSE TWO OF THE SAME.		STA	OPMASK	;SAVE MASK.		JSR	CHRGET		JMP	LOPREL	;GET THE NEXT CANDIDATE.ENDREL:		LDX	OPMASK	;WERE THERE ANY?		BNE	FINREL	;YES, HANDLE AS SPECIAL OP.		BCS	QOP	;NOT AN OPERATOR.		ADC	#GREATK-PLUSTK		BCC	QOP	;NOT AN OPERATOR.		ADC	VALTYP	;C=1.		BNE	*+5		JMP	CAT	;ONLY IF A=0 AND VALTYP=-1 (A STR).		ADC	#$100-1	;GET BACK ORIGINAL A.		STA	INDEX1		ASL	A	;MULTIPLY BY 2.		ADC	INDEX1	;BY THREE.		TAY		;SET UP FOR LATER.QPREC:		PLA		;GET PREVIOUS PRECEDENCE.		CMP	OPTAB,Y	;IS OLD PRECEDENCE GREATER OR EQUAL?		BCS	QCHNUM	;YES, GO OPERATE.		JSR	CHKNUM	;CAN'T BE STRING HERE.DOPREC:		PHA		;SAVE OLD PRECEDENCE.NEGPRC:		JSR	DOPRE1	;SET A RETURN ADDRESS FOR OP.		PLA		;PULL OFF PREVIOUS PRECEDENCE.		LDY	OPPTR	;GET POINTER TO OP.		BPL	QPREC1	;THAT'S A REAL OPERATOR.		TAX		;DONE ?		BEQ	QOPGO	;DONE !		BNE	PULSTKFINREL:		LSR	VALTYP	;GET VALUE TYPINTO 'C'.		TXA		ROL	A	;PUT VALTYP INTO LOW ORDER BIT OF MASK.		LDX	TXTPTR	;DECREMENT TEXT POINTER.		BNE	FINRE2		DEC	TXTPTR+1FINRE2:		DEC	TXTPTR		LDY	#PTDORL-OPTAB	;MAKE YREG POINT AT OPERATOR ENTRY.		STA	OPMASK	;SAVE THE OPERATION MASK.		BNE	QPREC	;SAVE IT ALL. BR ALWAYS.;NOTE B7(VALTYP)=0 SO CHKNUM CALL IS OK.QPREC1:		CMP	OPTAB,Y	;LAST PRECEDENCE IS GREATER?		BCS	PULSTK	;YES, GO OPERATE.		BCC	DOPREC	;NO SAVE ARGUMENT AND GET OTHER OPERAND.DOPRE1:		LDA	OPTAB+2,Y		PHA		;DISP ADDR GOES ONTO STACK.		LDA	OPTAB+1,Y		PHA		JSR	PUSHF1	;SAVE FAC ON STACK UNPACKED.		LDA	OPMASK	;ACCA MAY BE MASK FOR REL.		JMP	LPOPERSNERR5:		JMP	SNERR	;GO TO AN ERROR.PUSHF1:		LDA	FACSGN		LDX	OPTAB,Y	;GET HIGH PRECEDENCE.PUSHF:		TAY		;GET POINTER INTO STACK.		PLA		STA	INDEX1		INC	INDEX1		PLA		STA	INDEX1+1		TYA;STORE FAC ON STACK UNPACKED.		PHA		;START WITH SIGN SET UP.FORPSH:		JSR	ROUND	;PUT ROUNDED FAC ON STACK.		LDA	FACLO	;ENY POINT TO SKIP STORING SIGN.		PHA		LDA	FACMO		PHA		LDA	FACMOH		PHA		LDA	FACHO		PHA		LDA	FACEXP		PHA		IF LOLLY <> 0 THEN		DC.B	$6C	;JMP (INDIRECT)		DC.W	INDEX1		ELSE		JMP	(INDEX1)	;RETURN.		ENDIFQOP:		LDY	#255		PLA		;GET HIGH PRECEDENCE OF LAST OP.QOPGO:		BEQ	QOPRTS	;DONE !QCHNUM:		CMP	#100	;RELATIONAL OPERATOR?		BEQ	UNPSTK	;YES, DON'T CHECK OPERAND.		JSR	CHKNUM	;MUST BE NUMBER.UNPSTK:		STY	OPPTR	;SAVE OPERATOR'S POINTER FOR NEXT TIMEPULSTK:		PLA		;GET MASK FOR REL OP IF IT IS ONE.		LSR	A	;SETUP C FOR DOREL 'CHKVAL'.		STA	DOMASK	;SAVE FOR 'DOCMP'.		PLA		;UNPACK STACK INTO ARG.		STA	ARGEXP		PLA		STA	ARGHO		PLA		STA	ARGMOH		PLA		STA	ARGMO		PLA		STA	ARGLO		PLA		STA	ARGSGN		EOR	FACSGN	;GET PROBABLE RESULT SIGN.		STA	ARISGN	;ARITHMETIC SIGN. USED BY;ADD, SUB, MULT, DIV.QOPRTS:		LDA	FACEXP	;GET IT AND SET CODES.UNPRTS:		RTS		;RETURN.EVAL:		LDA	#$00		STA	VALTYP	;ASSUME VALUE WILL BE NUMERIC.EVAL0:		JSR	CHRGET	;GET A CHARACTER.		BCS	EVAL2EVAL1:		JMP	FIN	;IT IS A NUMBER.EVAL2:		JSR	ISLETC	;VARIABLE NAME?		BCS	ISVAR	;YES.QDOT:		CMP	#'.'	;LEADING CHARACTER OF CONSTANT?		BEQ	EVAL1		CMP	#MINUTK	;NEGATION?		BEQ	DOMIN	;SHO IS.		CMP	#PLUSTK		BEQ	EVAL0		CMP	#34	;A QUOTE? A STRING?		BNE	EVAL3STRTXT:		LDA	TXTPTR		LDY	TXTPTR+1		ADC	#0	;TO INC, ADD C=1.		BCC	STRTX2		INYSTRTX2:		JSR	STRLIT	;YES. GO PROCESS IT.		JMP	ST2TXTEVAL3:		CMP	#NOTTK	;CHECK FOR 'NOT' OPERATOR.		BNE	EVAL4		LDY	#NOTTAB-OPTAB	;NOT' HAS PRECEDENCE 90.		BNE	GONPRC	;GO DO ITS EVALUATION.NOTOP:		LDA	FACEXP		BNE	TOZER		LDY	#1		DC.B	44	;SKIP 2 INSTRUCTIONTOZER:		LDY	#0		JMP	SNGFLTEVAL4:		CMP	#FNTK	;USER-DEFINED FUNCTION?		BNE	*+5		JMP	FNDOER		CMP	#ONEFUN	;A FUNCTION NAME?		BCC	PARCHK	;FUNCTIONS ARE THE HIGHEST NUMBERED		JMP	ISFUN	;CHARACTERS SO NO NEED TO CHECK;AN UPPER-BOUND.PARCHK:		JSR	CHKOPN	;ONLY POSSIBILITY LEFT IS		JSR	FRMEVL	;A FORMULA IN PARENTHESIS.;RECURSIVELY EVALUATE THE FORMULA.CHKCLS:		LDA	#41	;CHECK FOR A RIGHT PARENTHESE		DC.B	44CHKOPN:		LDA	#40		DC.B	44CHKCOM:		LDA	#44; 'SYNCHK' LOOKS AT THE CURRENT CHARACTER TO MAKE SURE IT; IS THE SPECIFIC THING LOADED INTO ACCA JUST BEFORE CALL; 'SYNCHK'. IF NOT, IT CALLS THE 'SYNTAX ERROR' ROUTINE.; OTHERWISE IT GOBBLES THE NEXT CHAR AND RETURNS,; A=NEW CHAR AND TXTPTR IS ADVANCED BY 'CHRGET'.SYNCHR:		LDY	#0		CMP	(TXTPTR),Y	;CHARACTERS EQUAL?		BNE	SNERRCHRGO5:		JMP	CHRGETSNERR:		LDX	#ERRSN	;'SYNTAX ERROR'		JMP	ERRORDOMIN:		LDY	#NEGTAB-OPTAB	;A PRECEDENCE BELOW ''.GONPRC:		PLA		;GET RID OF RTS ADDR.		PLA		JMP	NEGPRC	;EVALUTE FOR NEGATION.ISVAR:		JSR	PTRGET	;GET A PNTR TO VARIABLE.ISVRET:		STA	FACMO		STY	FACMO+1		LDX	VALTYP		BEQ	GOOO	;THE STRING IS SET UP.		LDX	#0		STX	FACOVSTRRTS:		RTSGOOO:		EQU	*		LDX	INTFLG		BPL	GOOOOO		LDY	#0		LDA	(FACMO),Y	;FETCH HIGH.		TAX		INY		LDA	(FACMO),Y		TAY		;PUT LOW IN Y.		TXA		;GET HIGH IN A.		JMP	GIVAYF	;FLOAT AND RETURN.GOOOOO:		EQU	*QSTATV:		EQU	*		JMP	MOVFM	;MOVE ACTUAL VALUE IN.DOSCRN:		JSR	CHRGET	;WITH TWO ARGS.		JSR	PLOTFNS	;CALC X & Y		TXA		LDY	FIRST		JSR	RDSCRN		IF LOLLY <> 0 THEN		ELSERDSCRN:		EQU	$F871		ENDIF		TAY		JSR	SNGFLT		JMP	CHKCLSISFUN:		CMP	#SCRNFN	;MULTIPLY BY TWO.		BEQ	DOSCRN		ASL	A		PHA		TAX		JSR	CHRGET	;SET UP FORYNCHK.		CPX	#2*LASNUM-256+1	;IS IT PAST 'LASNUM'?		BCC	OKNORM	;NO, MUST BE NORMAL FUNCTION.; MOST FUNCTIONS TAKE A SINGLE ARGUMENT.; THE RETURN ADDRESS OF THESE FUNCTIONS IS 'CHKNUM'; WHICH ASCERTAINS THAT VALTYP=0  (NUMERIC).; NORMAL FUNCTIONS THAT RETURN STRING RESULTS; (E.G., CHR$) MUST POP OFF THAT RETURN ADDR AND; RETURN DIRECTLY TO 'FRMEVL'.; SO-CALLED 'FUNNY' FUNCTIONS CAN TAKE MORE THAN ONE ARG; THE FIRST OF WHICH MUST BE STRING AND THE SECOND OF ICH; MUST BE A NUMBER BETWEEN 0 AND 255.; CLOSED PARENTHESIS MUST BE CHECKED AND RETURN IS DIRECT; TO 'FRMEVL' WITH THE TEXT PNTR POINTING BEYOND THE ')'.; THE POINTER TO THE DESCRIPTOR OF THE STRING ARGUMENT; IS STORED ON THE STACK UNDERNEATH THE VALUE OF THE; INTEGER ARGUMENT.		JSR	CHKOPN	;CHECK FOR AN OPEN PARENTHESE		JSR	FRMEVL	;EAT OPEN PAREN AND FIRST ARG.		JSR	CHKCOM	;TWO ARGS SO COMMA MUST DELIMIT.		JSR	CHKSTR	;MAKE SURE FIRST WAS STRING.		PLA		;GET NCTION NUMBER.		TAX		LDA	FACMO+1		PHA		LDA	FACMO		PHA		;SAVE POINTER AT STRING DESCRIPTOR		TXA		PHA		;RESAVE FUNCTION NUMBER.;THIS MUST BE ON STACK SINCE RECURSIVE.		JSR	GETBYT	;X=VALUE OF FORMULA.		PLA		;GET FUNCTION NUMBER.		TAY		TXA		PHA		JMP	FINGO	;DISPATCH TO FUNCTION.OKNORM:		JSR	PARCHK	;READ A FORMULA SURROUNDED BY PARENS.		PLA		;GET DISPATCH FUNCTION.		TAYFINGO:		LDA	FUNDSP-ONEFUN-ONEFUN+256,Y	;MODIFY DISPATCH ADR		STA	JMPER+1		LDA	FUNDSP-ONEFUN-ONEFUN+257,Y		STA	JMPER+2		JSR	JMPER	;DISPATCH!;STRING FUNCTIONS REMOVE THIS RET ADDR.		JMP	CHKNUM	;CHECK IT FOR NUMERICNESS AND RETURN.OROP:		LDA	ARGEXP		ORA	FACEXP		BNE	GIVE1ANDOP:		LDA	ARGEXP		BEQ	GIVE0		LDA	FACEXP		BNE	GIVE1GIVE0:		LDY	#0		DC.B	44GIVE1:		LDY	#1		JMP	SNGFLT; TIME TO PERFORM A RELATIONAL OPERATOR.; DOMASK CONTAINS THE BITS AS TO WHICH RELATIONAL; OPERATOR IT WAS. CARRY BIT ON=STRING COMPARE.DOREL:		JSR	CHKVAL	;CHECK FOR MATCH.		BCS	STRCMP	;IT IS A STRING.		LDA	ARGSGN	;PACK ARG FOR FCOMP.		ORA	#127		AND	ARGHO		STA	ARGHO		LDA	#ARGEXP		LDY	#>ARGEXP		JSR	FCOMP		TAX		JMP	QCOMPSTRCMP:		LDA	#$00		STA	VALTYP	;RESULT WILL BE NUMERIC.		DEC	OPMASK	;TURN OFF VALTYP WHICH WAS STRING.		JSR	FREFAC	;FREE THE FACLO STRING.		STA	DSCTMP	;SAVE FOR LATER.		STX	DSCTMP+1		STY	DSCTMP+1+1		LDA	ARGMO		LDY	ARGMO+1	;GET POINTER TO OTHER STRING.		JSR	FRETMP	;FREES FIRST DESC POINTER.		STX	ARGMO		STY	ARGMO+1		TAX		;COPY COUNT INTO X.		SEC		SBC	DSCTMP	;WHICH IS GREATER. IF 0, ALL SET UP.		BEQ	STASGN	;JUST PUT SIGN OF DIFFEREE AWAY.		LDA	#1		BCC	STASGN	;SIGN IS POSITIVE.		LDX	DSCTMP	;LENGTH OF FAC IS SHORTER.		LDA	#$100-1	;GET A MINUS 1 FOR NEGATIVES.STASGN:		STA	FACSGN	;KEEP FOR LATER.		LDY	#255	;SET POINTER TO FIRST STRING. (ARG.)		INX		;TO LOOP PROPERLY.NXTCMP:		INY		DEX		;ANY CHARACTERS LEFT TO COMPARE?		BNE	GETCMP	;NOT DONE YET.		LDX	FACSGN	;USE SIGN OF LENGTH DIFFERENCE;SINCE ALL CHARACTERS ARE THE SAME.QCOMP:		BMI	DOCMP	;C IS ALWAYS SET THEN.		CLC		BCC	DOCMP	;ALWAYS BRCH.GETCMP:		LDA	(ARGMO),Y	;GET NEXT CHAR TO COMPARE.		CMP	(DSCTMP+1),Y	;SAME?		BEQ	NXTCMP	;YEP. TRY FURTHER.		LDX	#$100-1	;SET A POSITIVE DIFFERENCE.		BCS	DOCMP	;PUT STACK BACK TOGETHER.		LDX	#1	;SET A NEGATIVE DIFFERENCE.DOCMP:		INX		;-1 TO 1, 0 TO 2, 1 TO 4.		TXA		ROL	A		AND	DOMASK		BEQ	GOFLOT		LDA	#1	;MAP 0 TO 0. ALL OTHERS TO 1.GOFLOT:		JMP	FLOAT	;FLOAT THE ONE-BYTE RESULT INTO FAC.PDLHNDL:		JSR	CONINT	;GET X= PDL#		JSR	PREAD		JMP	SNGFLTPREAD:		EQU	$FB1E		EJECT		TITLE	'DIMENSION AND VARIABLE SEARCHING.'; THE 'DIM' CODE TS DIMFLG & THEN FALLS INTO THE VARIABLE; ROUTINE, WHICH LOOKS AT DIMFLG AT THREE DIFFERENT POINTS; 1) IF AN ENTRY IS FOUND, 'DIMFLG' BEING ON INDICATES;  A 'DOUBLY' DIMENSIONED VARIABLE.; 2) WHEN A NEW ENTRY IS BEING BUILT 'DIMFLG' BEING ON;  INDICTAES THE INDICES SHOULD BE USED FOR THE;  SIZE OF EACH INDEX. OTHERWISE THE DEFAULT OF TEN;  IS USED.; 3) WHEN BUILD ENTRY CODE FINISHES, ONLY IF 'DIMFLG' IS;  WILL INDEXING BE DONE.DIM3:		JSR	CHKCOM	;MUST  A COMMADIM:		TAX		;SET ACCX NONZERO.;ACCA MUST BE NONZERO TO WORK RIGHT.DIM1:		JSR	PTRGT1DIMCON:		JSR	CHRGOT	;GET LAST CHARACTER.		BNE	DIM3		RTS; ROUTINE TO READ VARIABLE NAME AT CURRENT TEXT POSISION; AND  PUT A POINTER TO ITS VALUE IN VARPNT. TXTPTR; POINTS TO THE TERMINATING CHARCTER. NOT THAT EVALUATING; IN A VARIABLE NAME CAN CAUSE RECURSIVE CALLS TO 'PTRGET'; THAT POINT ALL VALUES MUST BE STORED ON THE STACK.PTRGET:		LDX	#0	;MAKE ACCX=0.		JSR	CHRGOT	;RETRIEVE LAST CHARACTER.PTRGT1:		STX	DIMFLG	;STORE FLAG AWAY.PTRGT2:		STA	VARNAM		JSR	CHRGOT	;GET CURRENT CHARACTER;MAYBE WITH FUNCTION BIT OFF.		JSR	ISLETC	;CHECK FOR LETTER.		BCS	PTRGT3	;MUST HAVE A LETTER.INTERR:		JMP	SNERRPTRGT3:		LDX	#0	;ASSUME NO SECOND CHARACTER.		STX	VALTYP	;DEFAULT IS NUMERIC.		STX	INTFLG	;ASSUME FLOATING.		JMP	ARNDME	;FOR CONTROL-B & CONTROL-C		JMP	INIT		JMP	READY		DC.B	$00	;FILL SPACE SAME AS ROM CHIPSARNDME:		JSR	CHRGET	;GET FOLLOWING CHARACTER.		BCC	ISSEC	;CARRY RESET BY CHRGET IF NUMERIC.		JSR	ISLETC	;SET CARRY IF NOT ALPHABETIC.		BCC	NOSEC	;ALLOW ALPHABETICS.ISSEC:		TAX		;IT IS A NUMBER -- SAVE IN ACCX.EATEM:		JSR	CHRGET	;LOOK AT NEXT CHARACTER.		BCC	EATEM	;SKIP NUMERICS.		JSR	ISLETC		BCS	EATEM	;SKIP ALPHABETICS.NOSEC:		CMP	#'$'	;IS IT A STRING?		BNE	NOTSTR	;IF NOT, VALTYP=0.		LDA	#$100-1	;SET VALTYP=255 (STRING !).		STA	VALTYP		BNE	TURNON	;ALWAYS GOES.NOTSTR:		CMP	#'%'	;INTEGER VARIABLE?		BNE	STRNAM	;NO.		LDA	SUBFLG		BMI	INTERR		LDA	#128		STA	INTFLG	;SET FLAG.		ORA	VARNAM	;TURN ON BOTH HIGH BITS.		STA	VARNAMTURNON:		TXA		ORA	#128	;TURN ON MSB OF SECOND CHARACTER.		TAX		JSR	CHRGET	;GET CHARACTER AFTER $.STRNAM:		STX	VARNAM+1	;STORE AWAY SECOND CHARACTER.		SEC		ORA	SUBFLG	;ADD FLAG WHETHER TO ALLOW ARRAYS.		SBC	#40	;(CHECK FOR '(') WON'T MATCH IF SUBFLG SET. 		BNE	*+5GARRAY:		JMP	ISARY	;IT IS!		BIT	SUBFLG	;IN STORE OR RECALL?		BMI	*+4	;IN CASE OF USER FUNCTIONS		BVS	GARRAY		LDA	#0		STA	SUBFLG	;ALLOW SUBSCRIPTS AGAIN.		LDA	VARTAB	;PLACE TO START SEARCH.		LDX	VARTAB+1		LDY	#0STXFND:		STX	LOWTR+1LOPFND:		STA	LOWTR		CPX	ARYTAB+1	;AT END OF TABLE YET?		BNE	LOPFN		CMP	ARYTAB		BEQ	NOTFNS	;YES. WE COULDN'T FIND IT.LOPFN:		LDA	VARNAM		CMP	(LOWTR),Y	;COMPARE HIGH ORDERS.		BNE	NOTIT	;NO COMPARISON.		LDA	VARNAM+1		INY		CMP	(LOWTR),Y	;AND THE LOW PART?		BEQ	FINPTR	;THAT'S IT ! THAT'S IT !		DEYNOTIT:		CLC		LDA	LOWTR		ADC	#6+1	;MAKES NO DIF AMONG TYPES.		BCC	LOPFND		INX		BNE	STXFND	;ALWAYS BRANCHES.; TEST FOR A LETTER. / CARRY OFF= NOT A LETTER.;     CARRY ON= A LETTER.ISLETC:		CMP	#'A'		BCC	ISLRTS	;IF LESS THAN 'A', RET.		SBC	#'Z'+1		SEC		SBC	#$100-'Z'-1	;RESET CARRY IF A .GT. 'Z'.ISLRTS:		RTS		;RETURN TO CALLER.NOTFNS:		PLA		;CHECK WHO'S CALLING.		PHA		;RESTORE MT.		CMP	#ISVRET-1	;IS EVAL CALLING?		BNE	NOTEVL	;NO, CARRY ON.		TSX		LDA	258,X		CMP	#>ISVRET		BNE	NOTEVLLDZR:		LDA	#ZERO		LDY	#>ZERO	;SET UT PNTR TO SIMULATED ERO.		RTS		;R STRINGS OR NUMERIC.ZERO:		DC.B	0	;AND FOR INTEGERS TOO.		DC.B	0NOTEVL:		EQU	*QSTAVR:		EQU	*VAROK:		LDA	ARYTAB		LDY	ARYTAB+1		STA	LOWTR		STY	LOWTR+1	;LOWEST THING TO MOVE.		LDA	STREND		LDY	STREND+1	;GET HIGHEST ADDR TO MOVE.		STA	HIGHTR		STY	HIGHTR+1		CLC		ADC	#6+1		BCC	NOTEVE		INYNOTEVE:		STA	HIGHDS		STY	HIGHDS+1	;PLACE TO STUFF IT.		JSR	BLTU	;MOVE IT ALL.;NOTE Y,A HAS HIGHDS FOR REASON.		LDA	HIGHDS		LDY	HIGHDS+1	;AND SET UP		INY		STA	ARYTAB		STY	ARYTAB+1	;NEW START OF ARRAY TABLE.		LDY	#0	;GET ADDR OF VARIABLE ENTR.		LDA	VARNAM		STA	(LOWTR),Y		INY		LDA	VARNAM+1		STA	(LOWTR),Y	;STORE NAME OF VARIABLE.		LDA	#0		INY		STA	(LOWTR),Y		INY		STA	(LOWTR),Y		INY		STA	(LOWTR),Y		INY		STA	(LOWTR),Y	;FOURTH ERO FOR DEF FUNG.		INY		STA	(LOWTR),YFINPTR:		LDA	LOWTR		CLC		ADC	#2		LDY	LOWTR+1		BCC	FINNOW		INYFINNOW:		STA	VARPNT		STY	VARPNT+1	;TLIS IS IT.		RTS		EJECT		TITLE	'MULTIPLE DIMENSION CODE.'FMAPTR:		LDA	COUNT		ASL	A		ADC	#5	;POINT TO ENTRMES. G CLR'D BY ASL.		ADC	LOWTR		LDY	LOWTR+1		BCC	JSRGM		INYJSRGM:		STA	ARYPNT		STY	ARYPNT+1		RTSN32768:		DC.B	144,128,0,0	;-32768.; INTIDX READS A FORMULA FROM THE CURRENT POSITION AND; TURNS IT INTO A POSITIVE INTEGER; LEAVING THE RESULIN FACMO&LO. NEGATIVE ARGUMENTS; ARE NOT ALLOWED.INTIDX:		JSR	CHRGET		JSR	FRMNUM	;GET A NUMBERPOSINT:		LDA	FACSGN		BMI	NONONO	;IF NEGATIVE, BLOW HIM OUT.AYINT:		LDA	FACEXP		CMP	#144	;FAC .GT. 32767?		BCC	QINTGO		LDA	#N32768		LDY	#>N32768	;GET ADDR OF -32768.		JSR	FCOMP	;SEE IF FAC=Y,A.NONONO:		BNE	FCERR	;NO, FAC IS TOO BIG.QINTGO:		JMP	QINT	;GO TO QINT AND SHOVE IT.; FORMAT OF ARRAYS IN CORE.; DESCRIPTOR:; LOWBYTE = FIRST CHARACTER.; HHBYTE = SECOND CHARACTER (200 BIT IS STRING FLAG).; LENGTH OF ARRAY IN CORE IN BYTES (INCLUDES EVERYTHING).; NUMBER OF DIMENSIONS.; FOR EACH DIMENSION STARTING WITH THE FIRST A LIST; (2 BYTES EACH) OF THE MAX INDICE+1; THE VALUESISARY:		LDA	SUBFLG		BNE	STRTSRCH	;IF FOR STORE ORRECALL		LDA	DIMFLG		ORA	INTFLG		PHA		;SAVE DIMFLG FOR RECURSION.		LDA	VALTYP		PHA		;SAVE VALTYP FOR RECURSION.		LDY	#0	;SET NUMBER OF DIMENSIONS TO ZERO.INDLOP:		TYA		;SAVE NUMBER OF DIMS.		PHA		LDA	VARNAM+1		PHA		LDA	VARNAM		PHA		;SAVE LOOKS.		JSR	INTIDX	;EVALUATE INDICE INTO FACMO&LO.		PLA		STA	VARNAM		PLA		STA	VARNAM+1	;GET BACK ALL... WE'RE HOME.		PLA		;(# OF DIMS).		TAY		TSX		LDA	258,X		PHA		;PUSH DIMFLG AND VALTYP FURTHER.		LDA	257,X		PHA		LDA	INDICE	;PUT INDICE ONTO STACK.		STA	258,X	;UNDER DIMFLG AND VALTYP.		LDA	INDICE+1		STA	257,X		INY		;INCREMENT # OF DIMS.		JSR	CHRGOT	;GET TERMINATING CHARACTER.		CMP	#44	;A COMMA?		BEQ	INDLOP	;YES.		STY	COUNT	;AVE COUNT OF DIMS.		JSR	CHKCLS	;MUST BE CLOSED PAREN.		PLA		STA	VALTYP	;GET VALTYP AND		PLA		STA	INTFLG		AND	#127		STA	DIMFLG	;DIMFLG OFF STACK.STRTSRCH:		LDX	ARYTAB	;PLACE TO START SEARCH.		LDA	ARYTAB+1LOPFDA:		STX	LOWTR		STA	LOWTR+1		CMP	STREND+1	;END OF ARRAYS?		BNE	LOPFDV		CPX	STREND		BEQ	NOTFDD	;A FINE THING! NO ARRAY!.LOPFDV:		LDY	#0		LDA	(LOWTR),Y		INY		CMP	VARNAM	;COMPARE HIGH ORDERS.		BNE	NMARY1	;NO WAY IS IT THIS. GET OUT OF HERE.		LDA	VARNAM+1		CMP	(LOWTR),Y	;LOW ORDERS?		BEQ	GOTARY	;WELL, HERE IT IS !!NMARY1:		INY		LDA	(LOWTR),Y	;GET LENGTH.		CLC		ADC	LOWTR		TAX		INY		LDA	(LOWTR),Y		ADC	LOWTR+1		BCC	LOPFDA	;ALWAYS BRANCHES.BSERR:		LDX	#ERRBS	;GET BAD SUB ERROR NUMBER.		DC.B	44FCERR:		LDX	#ERRFC	;TOO BIG. 'FUNCTION CALL' ERROR.ERRGO3:		JMP	ERRORGOTARY:		LDX	#ERRDD	;PERHAPS A 'RE-DIMENSION' ERROR		LDA	DIMFLG	;TEST THE DIMFLG		BNE	ERRGO3		LDA	SUBFLG		BEQ	*+4	;RETURN TO DATA SAVE ROUTINES.		SEC		RTS		JSR	FMAPTR		LDA	COUNT	;GET NUMBER OF DIMS INPU		LDY	#4		CMP	(LOWTR),Y	;# OF DIMS THE SAME?		BNE	BSERR	;SAME SO GO GET DEFINITION.		JMP	GETDEF; HERE WHEN VARIABLE IS NOT FOUND IN THE ARRAY TABLE.; BUILDING AN ENTRY.; PUT DOWN THE DESCRIPTOR.; SETUP NUMBER OF DIMENSIONS.; MAKE SURE THERE IS ROOM FOR THE NEW ENTRY.; REMEMBER 'VARPNT'.; TALLY=4.; SKIP 2 LOCS FOR LATER FILL IN OF SIZE.; LOOP: GET AN INDICE; PUT DOWN NUMBER+1 AND INCREMENT VARPTR.; TALLY=TALLY*NUMBER+1.; DECREMENT NUMBER-DIMS.; BNE LOOP; CALL 'REASON' WITH Y,A REFLECTING LAST LOC OF VARIABLE.; UPDATE STREND.; ZERO ALL.; MAKE TALLY INCLUDE MAXDIMS AND DESCRIPTOR.; PUT DOWN TALLY.; IF CALLED BY DIMENSION, RETURN.; OTHERWISE INDEX INTO THE VARIABLE AS IF IT;  WERE FOUND ON THE INITIAL SEARCH.NOTFDD:		LDA	SUBFLG	;DON'T FORM ARRAY FOR STORE		BEQ	*+7		LDX	#ERROD		JMP	ERROR		JSR	FMAPTR	;FORM ARYPNT.		JSR	REASON		LDA	#0		TAY		STA	CURTOL+1		LDX	#5		LDA	VARNAM	;THIS CODE ONLY WORKS FOR INTPRC=1		STA	(LOWTR),Y	;IF ADDPRC=1.		BPL	NOTFLT		DEXNOTFLT:		INY		LDA	VARNAM+1		STA	(LOWTR),Y		BPL	STOMLT		DEX		DEXSTOMLT:		STX	CURTOL		LDA	COUNT		INY		INY		INY		STA	(LOWTR),Y	;SAVE NUMBER OF DIMENSIONS.LOPPTA:		LDX	#11	;DEFAULT SIZE.		LDA	#0		BIT	DIMFLG		BVC	NOTDIM	;NOT IN A DIM STATEMENT.		PLA		;GET LOW ORDER OF INDICE.		CLC		ADC	#1		TAX		PLA		;GET HIGH PART OF INDICE.		ADC	#0NOTDIM:		INY		STA	(LOWTR),Y	;STORE HIGH PART OF INDICE.		INY		TXA		STA	(LOWTR),Y	;STORE LOW ORDER OF INDICE.		JSR	UMULT	;X,A=CURTOL*LOWTR,Y		STX	CURTOL	;SAVE NEW TALLY.		STA	CURTOL+1		LDY	INDEX		DEC	COUNT	;ANY MORE INDICES LEFT?		BNE	LOPPTA	;YES.		ADC	ARYPNT+1		BCS	OMERR1	;OVERFLOW.		STA	ARYPNT+1	;COMPUTE WHERE TO ZERO.		TAY		TXA		ADC	ARYPNT*********		BCC	GREASE		INY		BEQ	OMERR1GREASE:		JSR	REASON	;GET ROOM.		STA	STREND		STY	STREND+1	;NEW END OF STORAGE.		LDA	#0	;STORING ACCA IS FASTER THAN CLEAR.		INC	CURTOL+1		LDY	CURTOL		BEQ	DECCURZERITA:		DEY		STA	(ARYPNT),Y		BNE	ZERITA	;NO. CONTINUE.DECCUR:		DEC	ARYPNT+1		DEC	CURTOL+1		BNE	ZERITA	;DO ANOTHER BLOCK.		INC	ARYPNT+1	;BUMP BACK UP. WILL USE LATER.		SEC		LDA	STREND	;RESTORE ACCA.		SBC	LOWTR	;DETERMINE LENGTH.		LDY	#2		STA	(LOWTR),Y	;LOW.		LDA	STREND+1		INY		SBC	LOWTR+1		STA	(LOWTR),Y	;HIGH.		LDA	DIMFLG		BNE	DIMRTS	;BYE.		INY; AT THIS POINT LOWTR,Y POINTS BEYOND THE SIZE TO NUMBER; DIMENSIONS. STRATEGY:; NUMDIM=NUMBER OF DIMENSIONS.; CURTOL.; INLPNM:GET A NEW INDICE.; MAKE SURE INDICE IS NOT TOO BIG.; MULTIPLY CURTOL BY CURMAX.; ADD INDICE TO CURTOL.; NUMDIM=NUMDIM-1.; BNE INLPNM.; USE CURTOL*4 AS OFFSET.GETDEF:		LDA	(LOWTR),Y		STA	COUNT	;SAVE A COUNTER.		LDA	#0	;ZERO CURTOL.		STA	CURTOLINLPNM:		STA	CURTOL+1		INY		PLA		;GET LOW INDICE.		TAX		STA	INDICE		PLA		;AND THE HIGH PART		STA	INDICE+1		CMP	(LOWTR),Y	;COMPARE WITH MAX INDICE.		BCC	INLPN2		BNE	BSERR7	;IF GREATER, 'BADUBSCRIPT' ERROR.		INY		TXA		CMP	(LOWTR),Y		BCC	INLPN1BSERR7:		JMP	BSERROMERR1:		JMP	OMERRINLPN2:		INYINLPN1:		LDA	CURTOL+1	;DON'T MULTIPLY IF CURTOL=0.		ORA	CURTOL		CLC		;PREPARE TO GET INDICE BACK.		BEQ	ADDIND	;GET HIGH PART OF INDICE BACK.		JSR	UMULT	;MULTIPLY CURTOL BY LOWTR,Y,Y+1.		TXA		ADC	INDICE	;ADD IN INDICE.		TAX		TYA		LDY	INDEX1ADDIND:		ADC	INDICE+1		STX	CURTOL		DEC	COUNT	;ANY MORE?		BNE	INLPNM	;YES.		STA	CURTOL+1	;SET UP HIGH-ORDER OFFSET		LDX	#5	;THIS CO ONLY WORKS FOR INTPRC=1		LDA	VARNAM	;IF ADDPRC=1.		BPL	NOTFL1		DEXNOTFL1:		LDA	VARNAM+1		BPL	STOML1		DEX		DEXSTOML1:		STX	ADDEND		LDA	#0		JSR	UMULTD	;ON RTS, A&Y=HI . X=LO.		TXA		ADC	ARYPNT		STA	VARPNT		TYA		ADC	ARYPNT+1		STA	VARPNT+1		TAY		LDA	VARPNTDIMRTS:		RTS		;RETURN TO CALLER.		EJECT		TITLE	'INTEGER ARITHMETIC ROUTINES.';TWO BYTE UNSIGNED INTEGER MULTIPLY.;THIS IS FOR MULTIPLY DIMENSIONED ARRAYS.; X,Y=X,A=CURTOL*LOWTR,Y,Y+1.UMULT:		STY	INDEX		LDA	(LOWTR),Y		STA	ADDEND	;LOW, THEN HIGH.		DEY		LDA	(LOWTR),Y	;PUT LOWTR,Y,Y+1 IN FASTER MEMORY.UMULTD:		STA	ADDEND+1		LDA	#16		STA	DECCNT		LDX	#0	;CLR THE ACCS.		LDY	#0	;RESULT INITIALLY ZERO.UMULTC:		TXA		ASL	A	;MULTIPLY BY TWO.		TAX		TYA		ROL	A		TAY		BCS	OMERR1	;TWO MUCH !		ASL	CURTOL		ROL	CURTOL+1		BCC	UMLCNT	;NOTHING IN THIS POSITION TO MULTIPLY.		CLC		TXA		ADC	ADDEND		TAX		TYA		ADC	ADDEND+1		TAY		BCS	OMERR1	;MANJUST TOO MUCH !UMLCNT:		DEC	DECCNT	;DONE?		BNE	UMULTC	;KEEP IT UP.UMLRTS:		RTS		;YES, ALL DONE.		EJECT		TITLE	'FRE AND INT TO FLOATING ROUTINES.'FRE:		LDA	VALTYP		BEQ	NOFREF		JSR	FREFACNOFREF:		JSR	GARBA2		SEC		LDA	FRETOP	;WE WANT		SBC	STREND	;FRETOP-STREND.		TAY		LDA	FRETOP+1		SBC	STREND+1GIVAYF:		LDX	#0		STX	VALTYP		STA	FACHO		STY	FACHO+1		LDX	#144	;SET EXPONENT TO 216.		JMP	FLOATS	;TURN IT TO A FLOATING PNT #.POS:		LDY	TRMPOS	;GET POSITION.SNGFLT:		LDA	#0		SEC		BEQ	GIVAYF	;FLOAT IT.		EJECT		TITLE	'SIMPLE-USER-DEFINED-FUNCTION CODE.'; NOTE ONLY SINGLE ARGUMENTS ARE ALLOWED TO FUNCTIONS; AND FUNCTIONS MUST BE OF THE SINGLE LINE FORM:; DEF FNA(X)=X2+X-2; NO STRINGS CAN BE INVOLVED WITH THESE FUNCTIONS.; IDEA: CREATE A SIMPLE VARIABLE ENTRY; WHOSE FIRST CHARACTER HAS THE 200 BIT SET.; THE VALUE WILL BE:; A TEXT PNTR TO THE FORMULA.; A PNTR TO THE ARGUMENT VARIABLE.; FUNCTIONAMES CAN BE LIKE 'FNA4'.; SUBROUTINE TO SEE IF WE ARE IN DIRECT MODE.; AND COMPLAIN IF SO.ERRDIR:		LDX	CURLIN+1	;DIR MODE HAS CURLIN=0,255		INX		;SO NOW, IS RESULT ZERO?		BNE	DIMRTS	;YES.		LDX	#ERRID	;INPUT DIRECT ERROR CODE.		DC.B	44	;SKIP 2 OFFSET.ERRGUF:		LDX	#ERRUFERRGO1:		JMP	ERRORDEF:		JSR	GETFNM	;GET A PNTR TO THE FUNCTION.		JSR	ERRDIR		JSR	CHKOPN	;MUST HAVE '('.		LDA	#128		STA	SUBFLG	;PROHIBIT SUBSCRIPTED VARIABLES.		JSR	PTRGET	;GET PNTR TO ARGUMENT.		JSR	CHKNUM	;IS IT A NUMBER?		JSR	CHKCLS	;MUST HAVE ')'		LDA	#EQULTK		JSR	SYNCHR	;MUST HAVE '='.		PHA		;PUT CRAZY BYTE ON.		LDA	VARPNT+1		PHA		LDA	VARPNT		PHA		LDA	TXTPTR+1		PHA		LDA	TXTPTR		PHA		JSR	DATA		JMP	DEFFIN; SUBROUTINE TO GET A PNTR TO A FUNCTION NAME.GETFNM:		LDA	#FNTK		JSR	SYNCHR	;MUST START WITH FN.		ORA	#128	;PUT FUNCTION BIT ON.		STA	SUBFLG		JSR	PTRGT2	;GET POINTER TO FUNCTION OR CREATE ANEW.		STA	DEFPNT		STY	DEFPNT+1		JMP	CHKNUM	;MAKE SURE IT'S NOA STRING AND RETURN.FNDOER:		JSR	GETFNM	;GET THE FUNCTION'S NAME.		LDA	DEFPNT+1		PHA		LDA	DEFPNT		PHA		JSR	PARCHK	;EVALUATE PARAMETER.		JSR	CHKNUM		PLA		STA	DEFPNT		PLA		STA	DEFPNT+1		LDY	#2		LDA	(DEFPNT),Y	;GET POINTER TO VARIABLE.		STA	VARPNT	;SAVE VARIABLE POINTER.		TAX		INY		LDA	(DEFPNT),Y		BEQ	ERRGUF	;FUNCTION UNDEFINED?		STA	VARPNT+1		INY		;SINCE DEF USES ONLY 4.DEFSTF:		LDA	(VARPNT),Y		PHA		;PUSH IT ALL ON STACK.		DEY		;SINCE WE ARE RECURSING MAYBE.		BPL	DEFSTF		LDY	VARPNT+1		JSR	MOVMF	;PUT CURRENT FAC INTO OUR ARG VARIABLE.		LDA	TXTPTR+1		PHA		LDA	TXTPTR		PHA		;SAVE TEXT POINTER.		LDA	(DEFPNT),Y	;PNTR TO FUNCTION.		STA	TXTPTR		INY		LDA	(DEFPNT),Y		STA	TXTPTR+1		LDA	VARPNT+1		PHA		LDA	VARPNT		PHA		;SAVE VARIABLE POINTER.		JSR	FRMNUM	;EVALUATE FORMULA AND CHECK NUMERIC.		PLA		STA	DEFPNT		PLA		STA	DEFPNT+1		JSR	CHRGOT		BEQ	*+5		JMP	SNERR	;IT DIDN'T TERMINE. HUH?		PLA		STA	TXTPTR		PLA		STA	TXTPTR+1	;RESTORE TEXT PNTR.DEFFIN:		LDY	#0		PLA		;GET OLD ARG VALUE OFF STACK		STA	(DEFPNT),Y	;AND PUT IT BACK IN VARIABLE.		PLA		INY		STA	(DEFPNT),Y		PLA		INY		STA	(DEFPNT),Y		PLA		INY		STA	(DEFPNT),Y		PLA		INY		STA	(DEFPNT),YDEFRTS:		RTS		EJECT		TITLE	'STRING FUNCTIONS.'; THE STR$ FUNCTION TAKES A NUMBER AND GIVES A STRING; WITH THE CHARACTERS THE OUTPUT OF THE NUMBER; WOULD HAVE GIVEN.STRS:		JSR	CHKNUM	;ARG HAS TO BE NUMERIC.		LDY	#0		JSR	FOUTC	;DO ITS OUTPUT.		PLA		PLATIMSTR:		LDA	#LOFBUF		LDY	#>LOFBUF		BEQ	STRLIT	;SCAN IT AND TURN IT INTO A STRING.; 'STRINI' GET STRING SPACE FOR CREATION OF A STRING AND; CREATES A DESCRIPTOR FOR IT IN 'DSCTMP'.STRINI:		LDX	FACMO		LDY	FACMO+1	;GET FACMO TO STORE IN DSCPNT.		STX	DSCPNT		STY	DSCPNT+1	;RETAIN THE DESCRIPTOR POINTER.STRSPA:		JSR	GETSPA	;GET STRING SPACE.		STX	DSCTMP+1		STY	DSCTMP+1+1	;SE LOCATION.		STA	DSCTMP	;SAVE LENGTH.		RTS		;ALL DONE.; 'STRLT2' TAKES THE STRING LITERAL WHOSE FIRST CHARACTER; IS POINTED TO BY Y,A AND BUILDS A DESCRIPTOR FOR IT.; DESCRIPTOR IS INITIALLY BUILT IN 'DSCTMP', BUT 'PUTNEW'; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN; ZERO THAT TERMINATE STRING SHOULD BE SET UP IN 'CHARAC'; AND 'ENDCHR'. IF TERMINATOR IS QUOTE, THE QUOTE IS SAVED; OVER. LEING QUOTES SHOULD BE SKIPPED BEFORE JSR.; ON RETURN THE CHARACTER AFTER THE STRING LITERAL IS; POINTED TO BY STRNG2.STRLIT:		LDX	#34	;ASSUME STRING ENDS ON QUOTE.		STX	CHARAC		STX	ENDCHRSTRLT2:		STA	STRNG1		STY	STRNG1+1	;SAVE POINTER TO STRING.		STA	DSCTMP+1		STY	DSCTMP+1+1	;IN CASE NO STRCPY.		LDY	#255	;INITIALIZE CHARACTER COUNT.STRGET:		INY		LDA	(STRNG1),Y	;GET CHARACTER.		BEQ	STRFI1	;IF ZERO.		CMP	CHARAC	;THIS TERMINATOR?		BEQ	STRFIN	;YES.		CMP	ENDCHR		BNE	STRGET	;LOOK FURTHER.STRFIN:		CMP	#34	;QUOTE?		BEQ	STRFI2STRFI1:		CLC		;NO, BACK UP.STRFI2:		STY	DSCTMP	;RETAIN COUNT.		TYA		ADC	STRNG1	;WISHING TO SET TXTPTR.		STA	STRNG2		LDX	STRNG1+1		BCC	STRST2		INXSTRST2:		STX	STRNG2+1		LDA	STRNG1+1	;IF PAGE 0, COPY SINCE IT IS EITHER;A STRING CONSTANT IN BUF OR A STR$;RESULT IN LOFBUF		BEQ	STRCP		CMP	#2		BNE	PUTNEWSTRCP:		TYA		JSR	STRINI		LDX	STRNG1		LDY	STRNG1+1		JSR	MOVSTR	;MOVE STRING. ;; SOME STRING FUNCTION IS RETURNING A RESULT IN DSCTMP.; SETUP A TEMP DESCRIPTOR WITH DSCTMP IN IT.; PUT A POINTER TO THE DESCRIPTOR IN FACMO&LO AND FLAG THE; RESULT AS TYPE STRING.PUTNEW:		LDX	TEMPPT	;POINTER TO FIRST FREE TEMP.		CPX	#STRSIZ*NUMTMP+TEMPST		BNE	PUTNW1		LDX	#ERRST	;STRING TEMPORARY ERROR.ERRGO2:		JMP	ERROR	;GO TELL HIM.PUTNW1:		LDA	DSCTMP		STA	0,X		LDA	DSCTMP+1		STA	1,X		LDA	DSCTMP+2		STA	2,X		LDY	#0		STX	FACMO		STY	FACMO+1		DEY		STY	VALTYP	;TYPE IS 'STRING'.		STX	LASTPT	;SET POINTER TO LAST-USED TEMP.		INX		INX		INX		;POINT FURTHER.		STX	TEMPPT	;SAVE POINTER TO NEXT TEMP IF ANY.		RTS		;ALL DONE.; GETSPA - GET SPACE FOR CHARACTER STRING.; MAY FORCE GARBAGE COLLECTION.; # OF CHARACTERS (BYTES) IN ACCA.; RETURNS WITH POINTER IN Y,X. OTHERWISE (IF CAN'T GET; SPACE) BLOWS OFF TO 'OUT OF STRING SPACE' TYPE ERROR.; ALSO PRESERVES ACCA AND SETS FRESPC=Y,X=PNTR AT SPACE.GETSPA:		LSR	GARBFL	;SIGNAL NO GARBAGE COLLECTION YET.TRYAG2:		PHA		;SAVE FOR LATER.		EOR	#255		SEC		;ADD ONE TO COMPLETE NEGATION		ADC	FRETOP		LDY	FRETOP+1		BCS	TRYAG3		DEYTRYAG3:		CPY	STREND+1	;COMPARE HIGH ORDERS.		BCC	GARBAG	;MAKE ROOM FOR MORE.		BNE	STRFRE	;SAVE NEW FRETOP.		CMP	STREND	;COMPARE LOW ORDERS.		BCC	GARBAG	;CLEAN UP.STRFRE:		STA	FRETOP		STY	FRETOP+1	;SAVE NEW FRETOP.		STA	FRESPC		STY	FRESPC+1	;PUT IT THERE OLD MAN.		TAX		;PRESERVE A IN X.		PLA		;GET COUNT BACK IN ACCA.		RTS		;ALL DONE.GARBAG:		LDX	#ERROM	;'OUT OF STRING SPACE'		LDA	GARBFL		BMI	ERRGO2		JSR	GARBA2		LDA	#128		STA	GARBFL		PLA		;GET BACK STRING LENGTH.		BNE	TRYAG2	;ALWAYS BRANCHES.GARBA2:		EQU	*	;START FROM TOP DOWN.		LDX	MEMSIZ		LDA	MEMSIZ+1FNDVAR:		STX	FRETOP	;LIKE SO.		STA	FRETOP+1		LDY	#0		STY	GRBPNT+1		LDA	STREND		LDX	STREND+1		STA	GRBTOP		STX	GRBTOP+1		LDA	#TEMPST		LDX	#>TEMPST		STA	INDEX1		STX	INDEX1+1TVAR:		CMP	TEMPPT	;DONE WITH TEMPS?		BEQ	SVARS	;YEP.		JSR	DVAR		BEQ	TVAR	;LOOP.SVARS:		LDA	#6+1		STA	FOUR6		LDA	VARTAB		LDX	VARTAB+1	;GET START OF SIMPLE VARIABLES.		STA	INDEX1		STX	INDEX1+1SVAR:		CPX	ARYTAB+1	;DONE WITH SIMPLE VARIABLES?		BNE	SVARGO	;NO.		CMP	ARYTAB		BEQ	ARYVAR	;YEP.SVARGO:		JSR	DVARS	;DO IT , AGAIN.		BEQ	SVAR	;LOOP.ARYVAR:		STA	ARYPNT		STX	ARYPNT+1	;SAVE FOR ADDITION.		LDA	#STRSIZ		STA	FOUR6ARYVA2:		LDA	ARYPNT		LDX	ARYPNT+1	;G THE POINTER TO VARIABLE.ARYVA3:		CPX	STREND+1	;DONE WITH ARRAYS?		BNE	ARYVGO	;NO.		CMP	STREND		BNE	*+5		JMP	GRBPAS	;YES, GO FINISH UP.ARYVGO:		STA	INDEX1		STX	INDEX1+1		LDY	#1-1		LDA	(INDEX1),Y		TAX		INY		LDA	(INDEX1),Y		PHP		INY		LDA	(INDEX1),Y		ADC	ARYPNT		STA	ARYPNT	;FORM POINTER TO NEXT ARRAY VAR.		INY		LDA	(INDEX1),Y		ADC	ARYPNT+1		STA	ARYPNT+1		PLP		BPL	ARYVA2		TXA		BMI	ARYVA2		INY		LDA	(INDEX1),Y		LDY	#0	;RESET INDEX Y.		ASL	A		ADC	#5	;CARRY IS OFF AND OFF AFTER ADD.		ADC	INDEX1		STA	INDEX1		BCC	ARYGET		INC	INDEX1+1ARYGET:		LDX	INDEX1+1ARYSTR:		CPX	ARYPNT+1	;END OF THE ARRAY?		BNE	GOGO		CMP	ARYPNT		BEQ	ARYVA3	;YES.GOGO:		JSR	DVAR		BEQ	ARYSTR	;CYCLE.DVARS:		EQU	*		LDA	(INDEX1),Y		BMI	DVARTS		INY		LDA	(INDEX1),Y		BPL	DVARTS		INYDVAR:		LDA	(INDEX1),Y	;IS LENGTH=0?		BEQ	DVARTS	;YES, RETURN.		INY		LDA	(INDEX1),Y	;GET LOW(ADR).		TAX		INY		LDA	(INDEX1),Y		CMP	FRETOP+1	;COMPARE HIGHS.		BCC	DVAR2	;IF THIS STRING'S PNTR .GE. FRETOP		BNE	DVARTS	;NO NEED TO MESS WITH IT FURTHER.		CPX	FRETOP	;COMPARE LOWS.		BCS	DVARTSDVAR2:		CMP	GRBTOP+1		BCC	DVARTS	;IF THIS STRING IS BELOW PREVIOUS,;FORGET IT.		BNE	DVAR3		CPX	GRBTOP	;COMPARE LOW ORDERS.		BCC	DVARTS	;X,A .LE. GRBTOP.DVAR3:		STX	GRBTOP		STA	GRBTOP+1		LDA	INDEX1		LDX	INDEX1+1		STA	GRBPNT		STX	GRBPNT+1		LDA	FOUR6		STA	SIZEDVARTS:		LDA	FOUR6		CLC		ADC	INDEX1		STA	INDEX1		BCC	GRBRTS		INC	INDEX1+1GRBRTS:		LDX	INDEX1+1		LDY	#0		RTS		;DONE.; HERE WHEN MADE ONE COMPLETE PASS THRU STRING VARIABLES.GRBPAS:		LDX	GRBPNT+1	;VARIABLE POINTER.		BEQ	GRBRTS	;ALL DONE.		LDA	SIZE		AND	#4	;LEAVES C OFF.		LSR	A		TAY		STA	SIZE		LDA	(GRBPNT),Y;NOTE: GRBTOP=LOWTR SO NO NEED TO SET LOWTR.		ADC	LOWTR		STA	HIGHTR		LDA	LOWTR+1		ADC	#0		STA	HIGHTR+1		LDA	FRETOP		LDX	FRETOP+1		STA	HIGHDS		STX	HIGHDS+1	;WHERE IT ALL GOES.  JSR BLTUC		JSR	BLTUC		LDY	SIZE		INY		LDA	HIGHDS	;GET POSITION OF START OF RESULT.		STA	(GRBPNT),Y		TAX		INC	HIGHDS+1		LDA	HIGHDS+1		INY		STA	(GRBPNT),Y	;CHANGE ADDR OF STRING IN VAR.		JMP	FNDVAR	;GO TO FNDVAR WITH SOMETHING FOR;FRETOP.; THE FOLLOWING ROUTINE CONCATENATES TWO STRINGS.; THE FAC CONTAINS THE FIRST ONE AT THIS POINT.; TXTPTR POINTS TO THE + SIGN.CAT:		LDA	FACLO	;PSH HIGH ORDER ONTO STACK.		PHA		LDA	FACMO	;AND THE LOW.		PHA		JSR	EVAL	;CAN COME BACK HERE SINCE;OPERATOR IS KNOWN.		JSR	CHKSTR	;RESULT MUST BE STRING.		PLA		STA	STRNG1	;GET HIGH ORDER OF OLD DESC.		PLA		STA	STRNG1+1		LDY	#0		LDA	(STRNG1),Y	;GET LENGTH OF OLD STRING.		CLC		ADC	(FACMO),Y		BCC	SIZEOK	;RESULT IS LESS THAN 256.		LDX	#ERRLS	;ERROR 'LONG STRING'.		JMP	ERRORSIZEOK:		JSR	STRINI	;INITIALIZE STRING.		JSR	MOVINS	;MOVE IT.		LDA	DSCPNT		LDY	DSCPNT+1	;GET POINTER TO SECOND.		JSR	FRETMP	;FREE IT.		JSR	MOVDO		LDA	STRNG1		LDY	STRNG1+1		JSR	FRETMP		JSR	PUTNEW		JMP	TSTOP	;'CAT' REENTERS FORM EVAL AT TSTOP.MOVINS:		LDY	#0	;GET ADDR OF STRING.		LDA	(STRNG1),Y		PHA		INY		LDA	(STRNG1),Y		TAX		INY		LDA	(STRNG1),Y		TAY		PLAMOVSTR:		STX	INDEX		STY	INDEX+1MOVDO:		TAY		BEQ	MVDONE		PHAMOVLP:		DEY		LDA	(INDEX),Y		STA	(FRESPC),YQMOVE:		TYA		BNE	MOVLP		PLAMVDONE:		CLC		ADC	FRESPC		STA	FRESPC		BCC	MVSTRT		INC	FRESPC+1MVSTRT:		RTS; 'FRETMP' IS PASS A STRING DESCRIPTOR PNTR IN Y,A.; A CHECK IS MADE TO SEE IF STRING DESCRIPTOR POINTS TO; TEMPORARY DESCRIPTOR ALLOCATED BY PUTNEW.; IF SO, THE TEMPORARY IS FREED UP BY UPDATING TEMPPT; IF A TEMP IS FREED UP, A FURTHER CHECK SEES IF STRING; THAT STRING TEMP PNT'D TO IS THE LOWEST PART OF STRING; IF SO, FRETOP IS UPDATED TO REFLECT THE FACT THAT; IS NO LONGER IN USE.; THE ADDR OF THE ACTUAL STRING IS RETURNED  Y,X AND; ITS LENGTH IN ACCA.FRESTR:		JSR	CHKSTR	;MAKE SURE ITS A STRING.FREFAC:		LDA	FACMO		LDY	FACMO+1	;FREE UP STR PNT'D TO BY FAC.FRETMP:		STA	INDEX		STY	INDEX+1	;GET LENGTH FOR LATER.		JSR	FRETMS	;FREE UP THE TEMPORARY DESC.		PHP		;SAVE CODES.		LDY	#0	;PREP TO GET STUFF.		LDA	(INDEX),Y	;GET COUNT AND		PHA		;SAVE IT.		INY		LDA	(INDEX),Y		TAX		;SAVE LOW ORDER.		INY		LDA	(INDEX),Y		TAY		;SAVE HIGH ORDER.		PLA		PLP		;RETURN STATUS.		BNE	FRETRT		CPY	FRETOP+1	;STRING IS LAST ONE IN?		BNE	FRETRT		CPX	FRETOP		BNE	FRETRT		PHA		CLC		ADC	FRETOP		STA	FRETOP		BCC	FREPLA		INC	FRETOP+1FREPLA:		PLA		;GET COUNT BACK.FRETRT:		STX	INDEX		STY	INDEX+1	;SAVE FOR LATER USE.		RTSFRETMS:		CPY	LASTPT+1	;LAST ENTRY TO TEMP? 		BNE	FRERTS		CMP	LASTPT		BNE	FRERTS		STA	TEMPPT		SBC	#STRSIZ	;POINT TO LAST ONE.		STA	LASTPT	;UPDATE TEMP PNTR.		LDY	#0	;ALSO CLEARS ZFLG SO WE DO REST OF FRETMP.FRERTS:		RTS		;ALL DONE.; CHR$(#) CREATES A STRING WHICH CONTAINS AS ITS ONLY; CHARACTER THE ASCII EQUIVALENT OF INTEGER ARGUMENT (#); WHICH MUST BE .LT. 255.CHRS:		JSR	CONINT	;GET INTEGER IN RANGE.		TXA		PHA		LDA	#1	;ONE-CHARACTER STRING.		JSR	STRSPA	;GET SPACE FOR STRING.		PLA		LDY	#0		STA	(DSCTMP+1),Y		PLA		;GET RID OF 'CHKNUM' RETURN ADDR.		PLARL$RET:		JMP	PUTNEW	;SETUP FAC TO POINT TO DESC.; THE FOLLOWING IS THE LEFT$($,#) FUNCTION.; IT TAKES THE LEMOST # CHARACTERS OF THE STRING.; IF # .GT. THE LEN OF STRING, IT RETURNS THE WHOLE STRINGLEFTS:		JSR	PREAM	;TEST PARAMETERS.		CMP	(DSCPNT),Y		TYARLEFT:		BCC	RLEFT1		LDA	(DSCPNT),Y		TAX		;PUT LENGTH INTO X.		TYA		;ZERO A THE OFFSET.RLEFT1:		PHA		;SAVE OFFSET.RLEFT2:		TXARLEFT3:		PHA		;SAVE LENGTH.		JSR	STRSPA	;GET SPACE.		LDA	DSCPNT		LDY	DSCPNT+1		JSR	FRETMP		PLA		TAY		PLA		CLC		ADC	INDEX	;COMPUTE WHERE TO COPY.		STA	INDEX		BCC	PULMOR		INC	INDEX+1PULMOR:		TYA		JSR	MOVDO	;GO MOVE IT.		JMP	PUTNEWRIGHTS:		JSR	PREAM		CLC		;LENGTH DES'D-LENGTH-1.		SBC	(DSCPNT),Y		EOR	#255	;NEGATE.		JMP	RLEFT; MID ($,#) RETURNS STRING WITH CHARS FROM # POSITION; ONWARD. IF # .GT. LEN ($) THEN RETURN NULL STRING.; MID ($,#,#) RETURNS STRING WITH CHARACTERS FROM; # POSITION FOR #2 CHARS. IF #2 GOES PAST END OF STRING; RETURN AS MUCH AS POSSIBLE.MIDS:		LDA	#255	;DEFAULT.		STA	FACLO	;SAVE FOR LAT COMPARE.		JSR	CHRGOT	;GET CURRENT CHARACTER.		CMP	#41	;IS IT A RIGHT PAREN )?		BEQ	MID2	;NO THIRD PARAM.		JSR	CHKCOM	;MUST HAVE COMMA.		JSR	GETBYT	;GET THE LENGTH INTO 'FACLO'.MID2:		JSR	PREAM	;CHECK IT OUT.		DEX		;COMPUTE OFFSET.		TXA		PHA		;PRSERVE AWHILE.		CLC		LDX	#0		SBC	(DSCPNT),Y	;GET LENGTH OF WHAT'S LEFT.		BCS	RLEFT2	;GIVE NULL STRING.		EOR	#255	;IN SUB C WAS 0 SO JUST COMPLEMENT.		CMP	FACLO	;GREATER THAN WHAT'S DESIRED?		BCC	RLEFT3	;NO,OPY THAT MUCH.		LDA	FACLO	;GET LENGTH OF WHAT'S DESIRED.		BCS	RLEFT3	;COPY IT.; USED BY RIGHT$, LEFT$, MID$ FOR PARAMETER CHECKING & SETPREAM:		JSR	CHKCLS	;PARAM LIST SHOULD END.		PLA		;GET THE RETURN ADDRESS INTO		TAY		;JMPER+1,Y		PLA		STA	JMPER+1		PLA		;GET RID OF FINGO'S JSR RET ADDR.		PLA		PLA		;GET LENGTH.		TAX		PLA		STA	DSCPNT		PLA		STA	DSCPNT+1		LDA	JMPER+1	;PUT RETURN ADDRESS BACK ON		PHA		TYA		PHA		LDY	#0		TXA		BEQ	GOFUC		RTS; THE FUNCTION LEN($) RETURNS THE LENGTH OF THE STRING; PASSED AS AN ARGUMENT.LEN:		JSR	LEN1		JMP	SNGFLTLEN1:		JSR	FRESTR	;FREE UP STRING.		LDX	#0		STX	VALTYP	;FORCE NUMERIC.		TAY		;SET CODES ON LENGTH.		RTS		;DONE.; THE FOLLOWING IS THE ASC($) FUNCTION. IT RETURNS; AN INTEGER WHICH IS THE DECIMAL ASCII EQUIVALENT.ASC:		JSR	LEN1		BEQ	GOFUC	;NULL STRING, BAD ARG.		LDY	#0		LDA	(INDEX1),Y	;GET CHARACTER.		TAY		JMP	SNGFLTGOFUC:		JMP	FCERR	;YES.GTBYTC:		JSR	CHRGETGETBYT:		JSR	FRMNUM	;READ FORMULA INTO FAC.CONINT:		JSR	POSINT	;CONVERT THE FAC TO A SINGLE BYTE INT		LDX	FACMO		BNE	GOFUC	;RESULT MUST BE .LE. 255.		LDX	FACLOCHRGO2:		JMP	CHRGOT	;SET CONDITION CODES ON TERMINATOR.; THE 'VAL' FUNCTION TAKES A STRING AND TURNS IT INTO; A NUMBER BY INTERPRETING THE ASCII DIGITS ETC.; EXCEPT FOR THE PROBLEM THAT TERMINATOR MUST BE SUPPLIED; BY REPLACING THE CHARACTER BEYOND STRING, VAL IS MELY; A CALL TO FLOATING POINT INPUT ('FIN').VAL:		JSR	LEN1	;DO SETUP. SET RESULT=NUMERIC.		BNE	*+5		JMP	ZEROFC	;ZERO THE FAC ON A NULL STRING		LDX	TXTPTR		LDY	TXTPTR+1		STX	STRNG2		STY	STRNG2+1	;SAVE FOR LATER.		LDX	INDEX1		STX	TXTPTR		CLC		ADC	INDEX1		STA	INDEX2		LDX	INDEX1+1		STX	TXTPTR+1		BCC	VAL2	;NO CARRY, NO INC.		INXVAL2:		STX	INDEX2+1		LDY	#0		LDA	(INDEX2),Y	;PRESERVE CHARACTER.		PHA		LDA	#0	;SET A TERMINATOR.		STA	(INDEX2),Y		JSR	CHRGOT	;GET CHARACTER PNT'D TO AND SET FLAGS.		JSR	FIN		PLA		;GET PRES'D CHARACTER.		LDY	#0		STA	(INDEX2),Y	;STUFF IT BACK.ST2TXT:		LDX	STRNG2		LDY	STRNG2+1		STX	TXTPTR		STY	TXTPTR+1VALRTS:		RTS		;ALL DONE WITH STRINGS.		EJECT		TITLE	'PEEK, POKE, AND FNWAIT.'GETNUM:		JSR	FRMNUM	;GET ADDRESS.		JSR	GETADR	;GET THAT LOCATION.COMBYT:		JSR	CHKCOM	;CHECK FOR A COMMA.		JMP	GETBYT	;GET SOMETHING TO STORE AND RETURN.GETADR:		LDA	FACEXP	;EXAMINE EXPONENT.		CMP	#145		BCS	GOFUC	;FUNCTION CALL ERROR.		JSR	QINT	;INTEGERIZE IT.		LDA	FACMO		LDY	FACMO+1		STY	POKER		STA	POKER+1		RTS		;IT'S DONE !.PEEK:		LDA	POKER	;CHEAP ASS FIX.		PHA		LDA	POKER+1		PHA		JSR	GETADR		LDY	#0GETCON:		LDA	(POKER),Y	;GET THAT BYTE.		TAY		PLA		STA	POKER+1		PLA		STA	POKER	;FOR POKE X,PEEK(KKK)DOSGFL:		JMP	SNGFLT	;FLOAT IT.POKE:		JSR	GETNUM		TXA		LDY	#0		STA	(POKER),Y	;STORE VALUE AWAY.		RTS		;SCANNED  EVERYTHING.; THE WAIT LOCATION,MASK1,MASK2 STEMENT WAITS UNTIL CONT; OF LOCATION IS NONZERO WHEN XORED WITH MASK2; AND THEN ANDED WITH MASK1. IF MASK2 IS NOT PRESENT, IT; IS ASSUMED TO BE ZERO.FNWAIT:		JSR	GETNUM		STX	ANDMSK		LDX	#0		JSR	CHRGOT		BEQ	STORDO		JSR	COMBYT	;GET MASK2.STORDO:		STX	EORMSK		LDY	#0WAITER:		LDA	(POKER),Y		EOR	EORMSK		AND	ANDMSK		BEQ	WAITERZERRTS:		RTS		;GOT A NONZERO.		EJECT		TITLE	'FLOATING POINT MATH CONFIG';THROUGHOUT THE MATH PACKAGE.; THE FLTING POINT FORMAT IS AS FOLLOWS:; THE SIGN IS THE FIRST BIT OF THE MANTISSA.; THE MANTISSA IS 24 BITS LONG.; THE BINARY POINT IS TO THE LEFT OF THE MSB.; NUMBER = MANTISSA * 2  EXPONENT.; THE MANTISSA IS POSITIVE WITH A 1 ASSUMED TO BE WHERE; THE SIGN OF THE EXPONENT IS THE 1ST BIT OF THE EXPONENT.; THE EXPONENT IS STORED IN EXCESS 200, IE, WITH A BIAS OF; SO, THE EXPONENT IS A SIGNED 8-BIT NUMBER WITH 200 ADDED; AN EXPONENT OF ZERO MEANSHE NUMBER IS ZERO.; THE OTHER BYTES MAY NOT BE ASSUMED TO BE ZERO.; TO KEEP THE SAME NUMBER IN THE FAC WHILE SHIFTING,;  TO SHIFT RIGHT, EXP:=EXP+1;  TO SHIFT LEFT,  EXP:=EXP-1; IN MEMORY THE NUMBER LOOKS LIKE THIS:;  THE EXPONENT AS A SIGNED NUMBER +200;  THE SIGN BIT IN 7, BITS 2-8 OF MANTISSA IN BITS 6-0.;   (REMEMBER BIT 1 OF MANTISSA IS ALWAYS A ONE.);  BITS 9-16 OF THE MANTISSA;  BITS 17-24 OF THE MANTISSA; ARITHMETIC ROUTINE CALLING CONVENTION; FOR ONE ARGUMENT FUNCTIONS:;  THE ARGUMENT IS IN THE FAC.;  THE RESULT IS LEFT IN THE FAC.; FOR TWO ARGUMENT OPERATIONS:;  THE 1ST ARGUMENT IS IN ARG (ARGEXP,HO,MO,LO AND ARGSGN);  THE SECOND ARGUMENT IS IN THE FAC.;  THE RESULT IS LEFT IN THE FAC.; THE 'T' ENTRY POINTS TO THE 2-ARGUMENT OPERATIONS HAVE B; SETUP IN RESPECTIVE REGISTERS. BEFORE CALLING ARG MAY; POPPED OFF THE STACK AND INTO ARG, FOR EXAMPLE.; THE OTHER ENTRY POINTSSUMES Y,A POINTS TO THE ARGUMENT; SOMEWHERE IN MEMORY. IT IS UNPACKED INTO ARG BY 'CONUPK'; ON THE STACK, THE SGN IS PUSHED ON FIRST, THE LO,MO,HO &; NOTE ALL THINGS ARE KEPT UNPACKED IN ARG, FAC & ON THE S; IT IS ONLY WHEN SOMETHING IS STORED THAT IT IS PACKED; BYTES. UNPACKED FORMAT HAS A SGN BYTE REFLECTING THE S; NUMBER (POSITIVE=0, NEGATIVE=-1) A HO,MO & LO WITH THE H; OF THE HO TURNED ON. THE EXP IS THE SAMES STORED FORMAT.; THIS IS DONE FOR SPEED OF OPERATION.; %		EJECT		TITLE	'FLOATING POINT ADD AND SUB'FADDH:		LDA	#FHALF		LDY	#>FHALF	;ENTRY TO ADD 1/2.		JMP	FADD	;UNPACK AND GO ADD UIT.FSUB:		JSR	CONUPK	;UNPACK ARGUMENT INTO ARG.FSUBT:		LDA	FACSGN		EOR	#$FF	;COMPLEMENT IT.		STA	FACSGN		EOR	ARGSGN	;COMPLEMENT ARISGN.		STA	ARISGN		LDA	FACEXP	;SET CODES ON FACEXP.		JMP	FADDT	;Y=ARGEXP..FADD5:		JSR	SHIFTR	;DO A LONG SHIF		BCC	FADD4	;CONTINUE WITH ADDITION.FADD:		JSR	CONUPKFADDT:		BNE	*+5		JMP	MOVFA	;IF FAC=0, RESULT IS IN ARG.		LDX	FACOV		STX	OLDOV		LDX	#ARGEXP	;DEFAULT IS SHIFT ARGUMENT.		LDA	ARGEXP	;IF ARG=0, FAC IS RESULT.FADDC:		TAY		;ALSO COPY ACCA INTO ACCY.		BEQ	ZERRTS	;RETURN.		SEC		SBC	FACEXP		BEQ	FADD4	;NO SHIFTING.		BCC	FADDA	;BR IF ARGEXP.LT.FACEXP.		STY	FACEXP	;RESULTING EXPONENT.		LDY	ARGSGN	;SINCE ARG IS BIGGER, IT'S		STY	FACSGN	;SIGN IS SIGN OF RESU.		EOR	#$FF	;SHIFT A NEGATIVE NUMBER OF PLACES.		ADC	#0	;COMPLETE NEGATION. W/ C=1.		LDY	#0	;ZERO OLDOV.		STY	OLDOV		LDX	#FAC	;SHIFT THE FAC INSTEAD.		BNE	FADD1FADDA:		LDY	#0		STY	FACOVFADD1:		CMP	#$100-7	;FOR SPEED AND NECESSITY.  GETS;MOST LIKELY CASE TO SHIFTR FASTEST;AND ALLOWS SHIFTING OF NEG NUMS;BY 'QINT'.		BMI	FADD5	;SHIFT BIG.		TAY		LDA	FACOV	;SET FACOV.		LSR	1,X	;GETS 0 IN MOST SIG BIT.		JSR	ROLSHF	;DO THE ROLLING.FADD4:		BIT	ARISGN	;GET SULTING SIGN.		BPL	FADD2	;IF POSITIVE, ADD.;CARRY IS CLEAR.FADD3:		LDY	#FACEXP		CPX	#ARGEXP	;FAC IS BIGGER.		BEQ	SUBIT		LDY	#ARGEXP	;ARG IS BIGGER.SUBIT:		SEC		EOR	#$FF		ADC	OLDOV		STA	FACOV		LDA	|$3+1,Y		SBC	 $3+1,X		STA	FACLO		LDA	|$2+1,Y		SBC	 $2+1,X		STA	FACMO		LDA	|$2,Y		SBC	 $2,X		STA	FACMOH		LDA	|$1,Y		SBC	 $1,X		STA	FACHOFADFLT:		BCS	NORMAL	;HERE IF SIGNS DIFFER. IF CARRY,;FAC IS SET OK.		JSR	NEGFAC	;NEGATE FAC.NORMAL:		LDY	#0		TYA		CLCNORM3:		LDX	FACHO		BNE	NORM1		LDX	FACHO+1	;SHIFT 8 BITS AT A TIME FOR SPEED.		STX	FACHO		LDX	FACMOH+1		STX	FACMOH		LDX	FACMO+1		STX	FACMO		LDX	FACOV		STX	FACLO		STY	FACOV		ADC	#$08		CMP	#$18+$08		BNE	NORM3ZEROFC:		LDA	#0	;NOT NEED BY NORMAL BUT BY OTHERS.ZEROF1:		STA	FACEXP	;NUMBER MUST BE ZERO.ZEROML:		STA	FACSGN	;MAKE SIGN POSITIVE.		RTS		;ALL DONE.FADD2:		ADC	OLDOV		STA	FACOV		LDA	FACLO		ADC	ARGLO		STA	FACLO		LDA	FACMO		ADC	ARGMO		STA	FACMO		LDA	FACMOH		ADC	ARGMOH		STA	FACMOH		LDA	FACHO		ADC	ARGHO		STA	FACHO		JMP	SQUEEZ	;GO ROUND IF SIGNS SAME.NORM2:		ADC	#1	;DECREMENT SHIFT COUNT.		ASL	FACOV	;SHIFT ALL LEFT ONE BIT.		ROL	FACLO		ROL	FACMO		ROL	FACMOH		ROL	FACHONORM1:		BPL	NORM2	;IF MSB=0 SHIFT AGAIN.		SEC		SBC	FACEXP		BCS	ZEROFC		EOR	#$FF		ADC	#1	;COMPLEMENT.		STA	FACEXPSQUEEZ:		BCC	RNDRTS	;BITS TO SHIFT?RNDSHF:		INC	FACEXP		BEQ	OVERR		ROR	FACHO		ROR	FACMOH		ROR	FACMO		ROR	FACLO		ROR	FACOVRNDRTS:		RTS		;ALL DONE ADDING.NEGFAC:		LDA	FACSGN		EOR	#255		STA	FACSGN	;COMPLEMENT FAC  ENTIRELY.NEGFCH:		LDA	FACHO		EOR	#255		STA	FACHO	;COMPLEMENT JUST THE NUMBER.		LDA	FACMOH		EOR	#255		STA	FACMOH		LDA	FACMO		EOR	#255		STA	FACMO		LDA	FACLO		EOR	#255		STA	FACLO		LDA	FACOV		EOR	#255		STA	FACOV		INC	FACOV		BNE	INCFRTINCFAC:		INC	FACLO		BNE	INCFRT		INC	FACMO		BNE	INCFRT	;IF NO CARRY, RETURN.		INC	FACMOH		BNE	INCFRT		INC	FACHO	;CARRY INCREMENT.INCFRT:		RTSOVERR:		LDX	#ERROV		JMP	ERROR	;TELL USER.; 'SHIFTR' SHIFTS X+1:X+3 -ACCA  BITS RIGHT.; SHIFTS BYTES TO START WITH IF POSSIBLE.MULSHF:		LDX	#RESHO-1	;ENTRY POINT FOR MULTIPLIER.SHFTR2:		LDY	3+1,X	;SHIFT BYTES FIRST.		STY	FACOV		LDY	3,X		STY	4,X		LDY	2,X	;GET MO.		STY	3,X	;STORE LO.		LDY	1,X	;GET HO.		STY	2,X	;STORE MO.		LDY	BITS		STY	1,X	;STORE HO.SHIFTR:		ADC	#$08		BMI	SHFTR2		BEQ	SHFTR2		SBC	#$08	;C CAN BE EITHER 1,0 AND IT WORKS.		TAY		LDA	FACOV		BCS	SHFTRT	;EQUIV TO BEQ HERE.SHFTR3:		ASL	1,X		BCC	SHFTR4		INC	1,XSHFTR4:		ROR	1,X		ROR	1,X	;YES, TWO OF THEM.ROLSHF:		EQU	*		ROR	2,X		ROR	3,X		ROR	4,X	;ONE MO TIME.		ROR	A	;ROTATE ARGUMENT 1 BIT RIGHT.SHFTR7:		INY		BNE	SHFTR3	;$$$ ( MOST EXPENSIVE ! )SHFTRT:		CLC		;CLEAR OUTPUT OF FACOV.		RTS		EJECT		TITLE	'NATURAL LOG FUNCTION.'; CALCULATION IS BY:; LN(F*2N)=(N+LOG2(F))*LN(2); AN APPXIMATION POLYNOMIAL IS USED TO CALCULATE LOG2(F).;  CONSTANTS USED BY LOG:FONE:		DC.B	$81	; 1.0		DC.B	$00		DC.B	$00		DC.B	$00		DC.B	$00LOGCN2:		DC.B	$03	;DEGREE-1		DC.B	$7F	;.43425594188		DC.B	$5E		DC.B	$56		DC.B	$CB		DC.B	$79		DC.B	$80	; .57658454134		DC.B	$13		DC.B	$9B		DC.B	$0B		DC.B	$64		DC.B	$80	; .96180075921		DC.B	$76		DC.B	$38		DC.B	$93		DC.B	$16		DC.B	$82		DC.B	$38		DC.B	$AA		DC.B	$3B		DC.B	$20SQR0_5:		DC.B	$80	; S(0.5)		DC.B	$35		DC.B	$04		DC.B	$F3		DC.B	$34SQR2_0:		DC.B	$81	; SQR(2.0)		DC.B	$35		DC.B	$04		DC.B	$F3		DC.B	$34NEGHLF:		DC.B	$80	; -1/2		DC.B	$80		DC.B	$00		DC.B	$00		DC.B	$00LOG2:		DC.B	$80	; LN(2)		DC.B	$31		DC.B	$72		DC.B	$17		DC.B	$F8LOG:		JSR	SIGN	;IS IT POSITIVE?		BEQ	LOGERR		BPL	LOG1LOGERR:		JMP	FCERR	;CAN'T TOLERATE NEG OR ZERO.LOG1:		LDA	FACEXP	;GET EXPONENT INTO ACCA.		SBC	#$7F	;REMOVE BIAS. (CARRY IS OFF)		PHA		;SE AWHILE.		LDA	#$80		STA	FACEXP	;RESULT IS FAC IN RANGE 0.5,1.		LDA	#SQR0_5		LDY	#>SQR0_5	;GET POINTER TO SQR(0.5).; CALCULATE (F-SQR(.5))/(F+SQR(.5))		JSR	FADD	;ADD TO FAC.		LDA	#SQR2_0		LDY	#>SQR2_0	;GET SQR(2.).		JSR	FDIV		LDA	#FONE		LDY	#>FONE		JSR	FSUB		LDA	#LOGCN2		LDY	#>LOGCN2		JSR	POLYX	;EVALUATE APPROXIMATION POLYNOMIAL.		LDA	#NEGHLF		LDY	#>NEGHLF	;ADD IN LAST CONSTANT.		JSR	FADD		PLA		;GET EXPONENT BACK.		JSR	FINLOG	;ADD IT IN.MULLN2:		LDA	#LOG2		LDY	#>LOG2	;MULTIPLY RESULT BY LOG(2.0).; JMP FMULT   ;MULTIPLY TOGETHER.		EJECT		TITLE	'FLOATING MULT AND DIV';MULTIPLICATION  FAC:=ARG*FAC.FMULT:		JSR	CONUPK	;UNPACK THE CONSTANT INTO ARG FOR USE.FMULTT:		BNE	*+5		JMP	MULTRT	;IF FAC=0, RETURN. FAC IS SET.		JSR	MULDIV	;FIX UP THE EXPONENTS.		LDA	#0	;TO CLEAR RESULT.		STA	RESHO		STA	RESMOH		STA	RESMO		STA	RESLO		LDA	FACOV		JSR	MLTPLY		LDA	FACLO	;MLTPLARG BY FACLO.		JSR	MLTPLY		LDA	FACMO	;MLTPLY ARG BY FACMO.		JSR	MLTPLY		LDA	FACMOH		JSR	MLTPLY		LDA	FACHO	;MLTPLY ARG BY FACHO.		JSR	MLTPL1		JMP	MOVFR	;MOVE RESULT INTO FAC,;NORMALIZE RESULT, AND RETURN.MLTPLY:		BNE	*+5		JMP	MULSHF	;SHIFT RESULT RIGHT 1 BYTE.MLTPL1:		LSR	A		ORA	#$80MLTPL2:		TAY		BCC	MLTPL3	;IT MULT BIT=0, JUST SHIFT.		CLC		LDA	RESLO		ADC	ARGLO		STA	RESLO		LDA	RESMO		ADC	ARGMO		STA	RESMO		LDA	RESMOH		ADC	ARGMOH		STA	RESMOH		LDA	RESHO		ADC	ARGHO		STA	RESHOMLTPL3:		ROR	RESHO		ROR	RESMOH		ROR	RESMO		ROR	RESLO		ROR	FACOV	;SAVE FOR ROUNDING.		TYA		LSR	A	;CLEAR MSB SO WE GET A CLOSER TO 0.		BNE	MLTPL2	;SLOW AS A TURTLE !MULTRT:		RTS;ROUTINE TO UNPACK MEMORY INTO ARG.CONUPK:		STA	INDEX1		STY	INDEX1+1		LDY	#3+1		LDA	(INDEX1),Y		STA	ARGLO		DEY		LDA	(INDEX1),Y		STA	ARGMO		DEY		LDA	(INDEX1),Y		STA	ARGMOH		DEY		LDA	(INDEX1),Y		STA	ARGSGN		EOR	FACSGN		STA	ARISGN		LDA	ARGSGN		ORA	#$80		STA	ARGHO		DEY		LDA	(INDEX1),Y		STA	ARGEXP		LDA	FACEXP	;SET CODES OF FACEXP.		RTS;CHECK SPECIAL CASES AND ADD EXPONENTS FOR FMULT, FDIV.MULDIV:		LDA	ARGEXP	;EXP OF ARG=0?MLDEXP:		BEQ	ZEREMV	;SO WE GET ZERO EXPONENT.		CLC		ADC	FACEXP	;RESULT IS IN ACCA.		BCC	TRYOFF	;FIND C XOR N.		BMI	GOOVER	;OVERFLOW IF BITS MATCH.		CLC		DC.B	44TRYOFF:		BPL	ZEREMV	;UNDERFLOW.		ADC	#$80	;ADD BIAS.		STA	FACEXP		BNE	*+5		JMP	ZEROML	;ZE THE REST OF IT.		LDA	ARISGN		STA	FACSGN	;ARISGN IS RESULT'S SIGN.		RTS		;DONE.MLDVEX:		LDA	FACSGN	;GET SIGN.		EOR	#$FF	;COMPLEMENT IT.		BMI	GOOVERZEREMV:		PLA		;GET ADDR OFF STACK.		PLA		JMP	ZEROFC	;UNDERFLOW.GOOVER:		JMP	OVERR	;OVERFLOW.;MULTIPLY FAC BY 10.MUL10:		JSR	MOVAF	;COPY FAC INTO ARG.		TAX		BEQ	MUL10R	;IF FAC=0, GOT ANSWER.		CLC		ADC	#2	;AUGMENT EXP BY 2.		BCS	GOOVER	;OVERFLOW.FINML6:		LDX	#0		STX	ARISGN	;SIGNS ARE SAME.		JSR	FADDC	;ADD TOGETHER.		INC	FACEXP	;MULTIPLY BY TWO.		BEQ	GOOVER	;OVERFLOW.MUL10R:		RTS; DIVIDE FAC BY 10.TEN_C:		DC.B	$84		DC.B	$20		DC.B	$00		DC.B	$00		DC.B	$00DIV10:		JSR	MOVAF	;MOVE FAC TO ARG.		LDA	#TEN_C		LDY	#>TEN_C	;POINT TO CONSTANT OF 10.0		LDX	#0	;SIGNS ARE BOTH POSITIVE.FDIVF:		STX	ARISGN		JSR	MOVFM	;PUT IT INTO FAC.		JMP	FDIVT	;SKIP OVER NEXT TWO BYTES.FDIV:		JSR	CONUPK	;UNPACK CONSTANT.FDIVT:		BEQ	DV0ERR	;CAN'T DIVIDE BY ZERO !;(NOT ENOUGH ROOM TO STORE RESULT.)		JSR	ROUND	;TAKE FACOV INTO ACCT IN FAC.		LDA	#0	;NEGATE FACEXP.		SEC		SBC	FACEXP		STA	FACEXP		JSR	MULDIV	;FIX UP EXPONENTS.		INC	FACEXP	;SCALE IT RIGHT.		BEQ	GOOVER	;OVERFLOW.		LDX	#$100-3-1	;SETUP PROCEDURE.		LDA	#1DIVIDE:		EQU	*	;THIS IS THE BEST CODE IN THE WHOLE PILE		LDY	ARGHO	;SEE WHAT RELATION HOLDS.		CPY	FACHO		BNE	SAVQUO	;C=0,1. N(C=0)=0.		LDY	ARGMOH		CPY	FACMOH		BNE	SAVQUO		LDY	ARGMO		CPY	FACMO		BNE	SAVQUO		LDY	ARGLO		CPY	FACLOSAVQUO:		PHP		ROL	A	;SAVE RESULT.		BCC	QSHFT	;IF NOT DONE, CONTINUE.		INX		STA	RESLO,X		BEQ	LD100		BPL	DIVNRM	;NOTE THIS REQ 1 MO RAM THEN NECESS.		LDA	#1QSHFT:		PLP		;RETURN CONDITION CODES.		BCS	DIVSUB	;FAC .LE. ARG.SHFARG:		ASL	ARGLO	;SHIFT ARG ONE PLACE LEFT.		ROL	ARGMO		ROL	ARGMOH		ROL	ARGHO		BCS	SAVQUO	;SAVE A RESULT OF ONE FOR THIS POSITION;AND DIVIDE.		BMI	DIVIDE	;IF MSB ON, GO DECIDE WHETHER TO SUB.		BPL	SAVQUODIVSUB:		TAY		;NOTICE C MUST BE ON HERE.		LDA	ARGLO		SBC	FACLO		STA	ARGLO		LDA	ARGMO		SBC	FACMO		STA	ARGMO		LDA	ARGMOH		SBC	FACMOH		STA	ARGMOH		LDA	ARGHO		SBC	FACHO		STA	ARGHO		TYA		JMP	SHFARGLD100:		LDA	#$40	;ONLY WANT TWO MORE BITS.		BNE	QSHFT	;ALWAYS BRANCHES.DIVNRM:		EQU	*		ASL	A		ASL	A		ASL	A		ASL	A		ASL	A		ASL	A	;GET LAST TWO BITS INTO MSB AND B6.		STA	FACOV		PLP		;TO GET GARBAGE OFF STACK.		JMP	MOVFR	;MOVE RESULT INTO FAC, THEN;NORMALIZE RESULTND RETURN.DV0ERR:		LDX	#ERRDV0		JMP	ERROR		EJECT		TITLE	'FLOATING POINT MOVEMENT ROUTINES.';MOVE RESULT TO FAC.MOVFR:		LDA	RESHO		STA	FACHO		LDA	RESMOH		STA	FACMOH		LDA	RESMO		STA	FACMO		LDA	RESLO	;MOVE LO AND SGN.		STA	FACLO		JMP	NORMAL	;ALL DONE.;MOVE MEMORY INTO FAC (UNPACKED).MOVFM:		STA	INDEX1		STY	INDEX1+1		LDY	#3+1		LDA	(INDEX1),Y		STA	FACLO		DEY		LDA	(INDEX1),Y		STA	FACMO		DEY		LDA	(INDEX1),Y		STA	FACMOH		DEY		LDA	(INDEX1),Y		STA	FACSGN		ORA	#$80		STA	FACHO		DEY		LDA	(INDEX1),Y		STA	FACEXP	;LEAVE SWITCHES SET ON EXP.		STY	FACOV		RTS;MOVE NUMBER FROM FAC TO MEMORY.MOV2F:		LDX	#TEMPF2		DC.B	44MOV1F:		LDX	#TEMPF1MOVML:		LDY	#0		BEQ	MOVMF	;ALWAYS BRANCHES.MOVVF:		LDX	FORPNT		LDY	FORPNT+1MOVMF:		JSR	ROUND		STX	INDEX1		STY	INDEX1+1		LDY	#3+1		LDA	FACLO		STA	(INDEX),Y		DEY		LDA	FACMO		STA	(INDEX),Y		DEY		LDA	FACMOH		STA	(INDEX),Y		DEY		LDA	FACSGN	;INCLUDE SIGN IN HO.  ORA #$7F		ORA	#$7F		AND	FACHO		STA	(INDEX),Y		DEY		LDA	FACEXP		STA	(INDEX),Y		STY	FACOV	;ZERO IT SINCE ROUNDED.		RTS		;Y=0.;MOVE ARG INTO FAC.MOVFA:		LDA	ARGSGNMOVFA1:		STA	FACSGN		LDX	#4+1MOVFAL:		LDA	ARGEXP-1,X		STA	FACEXP-1,X		DEX		BNE	MOVFAL		STX	FACOV		RTS;MOVE FAC INTO ARG.MOVAF:		JSR	ROUNDMOVEF:		LDX	#5+1MOVAFL:		LDA	FACEXP-1,X		STA	ARGEXP-1,X		DEX		BNE	MOVAFL		STX	FACOV	;ZERO IT SINCE ROUNDED.MOVRTS:		RTSROUND:		LDA	FACEXP	;ZO?		BEQ	MOVRTS	;YES. DONE ROUNDING.		ASL	FACOV	;ROUND?		BCC	MOVRTS	;NO. MSB OFF.INCRND:		JSR	INCFAC	;YES, ADD ONE TO LSB(FAC).		BNE	MOVRTS	;NO CARRY MEANS DONE.		JMP	RNDSHF	;SQUEEZ MSB IN AND RTS.;NOTE C=1 SINCE INCFAC DOESNT TOUCH C.		EJECT		TITLE	'SIGN, SGN, FLOAT, NEG, ABS.';PUT SIGN OF FAC IN ACCA.SIGN:		LDA	FACEXP		BEQ	SIGNRT	;IF NUMBER IS ZERO, SO IS RESULT.FCSIGN:		LDA	FACSGNFCOMPS:		ROL	A		LDA	#$100-1	;ASSUME NEGATIVE.		BCS	SIGNRT		LDA	#1	;GET .SIGNRT:		RTS;SGN FUNCTION.SGN:		JSR	SIGN;FLOAT THE SIGNED INTEGER IN ACCA.FLOAT:		STA	FACHO	;PUT ACCA IN HIGH ORDER.		LDA	#0		STA	FACHO+1		LDX	#$88	;GET THE EXPONENT.;FLOAT THE SIGNED NUMBER IN FAC.FLOATS:		LDA	FACHO		EOR	#$FF		ROL	A	;GET COMP OF SIGN IN CARRY.FLOATC:		LDA	#0	;ZERO ACCA BUT NOT CARRY.		STA	FACLO		STA	FACMOFLOATB:		STX	FACEXP		STA	FACOV		STA	FACSGN		JMP	FADFLT;ABSOLUTE VALUE OF FAC.ABS:		LSR	FACSGN		RTS		EJECT		TITLE	'COMPARE TWO NUMBERS.';A=1 IF ARG .LT. FAC.;A=0 IF ARG=FAC.;A=-1 IF ARG .GT. FAC.FCOMP:		STA	INDEX2FCOMPN:		STY	INDEX2+1		LDY	#0		LDA	(INDEX2),Y	;HAS ARGEXP.		INY		;BUMP PNTR UP.		TAX		;SAVE A IN X AND RESET CODES.		BEQ	SIGN		LDA	(INDEX2),Y		EOR	FACSGN	;SIGNS THE SAME.		BMI	FCSIGN	;SIGNS DIFFER SO RESULT IS;SIGN OF FAC AGAIN.FOUTCP:		CPX	FACEXP		BNE	FCOMPC		LDA	(INDEX2),Y		ORA	#$80		CMP	FACHO		BNE	FCOMPC		INY		LDA	(INDEX2),Y		CMP	FACMOH		BNE	FCOMPC		INY		LDA	(INDEX2),Y		CMP	FACMO		BNE	FCOMPC		INY		LDA	#$7F		CMP	FACOV		LDA	(INDEX2),Y		SBC	FACLO	;GET ZERO IF EQUAL.		BEQ	QINTRTFCOMPC:		LDA	FACSGN		BCC	FCOMPD		EOR	#$FFFCOMPD:		JMP	FCOMPS	;A PART OF SIGN SETS ACCA UP.		EJECT		TITLE	'GREATEST INTEGER FUNCTION.';QUICK GREATEST INTEGER FUNCTION.;LEAVES INT(FAC) IN FACHO&MO&LO SIGNED.;ASSUMES FAC .LT. 223 = 8388608QINT:		LDA	FACEXP		BEQ	CLRFAC	;IF ZERO, GOT IT.		SEC		SBC	#$98+8	;GET NUMBER OF PLACES TO SHIFT.		BIT	FACSGN		BPL	QISHFT		TAX		LDA	#$FF		STA	BITS	;PUT 377 IN WHEN SHFTR SHIFTS BYTES.		JSR	NEGFCH	;TRULY NEGATE QUANTITY IN FAC.		TXAQISHFT:		LDX	#FAC		CMP	#$100-7		BPL	QINT1	;IF NUMBER OF PLACES .GE. 7;SHIFT 1 PLACE @ A TIME		JSR	SHIFTR	;START SHIFTN BYTS, THEN BITS		STY	BITS	;ZERO BITS; ADDER WANTS 0QINTRT:		RTSQINT1:		TAY		;CNT IN CTR		LDA	FACSGN		AND	#$80	;GET SIGN BIT.		LSR	FACHO	;SAVE FIR SHIFTED BYTE.		ORA	FACHO		STA	FACHO		JSR	ROLSHF	;SHIFT THE REST.		STY	BITS	;ZERO BITS.		RTS;GREATEST INTEGER FUNCTION.INT:		LDA	FACEXP		CMP	#$98+8		BCS	INTRTS	;FORGET IT.		JSR	QINT		STY	FACOV	;CLR OVERFLOW BYTE.		LDA	FACSGN		STY	FACSGN	;MAKE FAC POSITIVE		EOR	#$80	;GET COMPLEMENT OF SIGN IN CARRY.		ROL	A		LDA	#$98+8		STA	FACEXP		LDA	FACLO		STA	INTEGR		JMP	FADFLTCLRFAC:		STA	FACHO	;MAKE IT REALLY ZERO.		STA	FACMOH		STA	FACMO		STA	FACLO		TAYINTRTS:		RTS		EJECT		TITLE	'FLOATING POINT INPUT ROUTINE.';NUMBER INPUT IS LEFT IN FAC.;AT ENTRY TXTPTR POINTS TO THE 1ST CHARACTER IN A TEXT BUF;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE;DECIMAL POINT IS. DPTFLG TELL WHETHER A DP HAS BEEN;SEEN. DECCNT IS THE NUMBER OF DIGITS AFTER THE DP.;AT THE END DECCNT AND THE EXPONENT ARE USED TO;DETERMINE HOW MANY TIMES TO MULTIPLY ORIVIDE BY TEN;TO GET THE CORRECT NUMBER.FIN:		LDY	#0	;ZERO FACSGN&SGNFLG.		LDX	#$09+1	;ZERO EXP AND HO (AND MOH).FINZLP:		STY	DECCNT,X	;ZERO MO AND LO.		DEX		;ZERO TENEXP AND EXPSGN		BPL	FINZLP	;ZERO DECCNT, DPTFLG.		BCC	FINDGQ	;FLAGS STILL SET FROM CHRGET.		CMP	#$2D	;A '-' SIGN?		BNE	QPLUS	;NO, TRY +		STX	SGNFLG	;IT'S NEGATIVE. (X=377).		BEQ	FINC	;ALWAYS GOQPLUS:		CMP	#$2B	;PLUS SIGN?		BNE	FIN1	;YES, SKIP IT.FINC:		JSR	CHRGETFINDGQ:		BCC	FINDIGFIN1:		CMP	#'.'	;THE DP?		BEQ	FINDP		CMP	#'E'	;EXPONENT FOLLOWS.		BNE	FINE	;NO.;HERE TO CHECK FOR SIGN OF EXP.		JSR	CHRGET	;YES. GET ANOTHER.		BCC	FNEDG1	;IT IS A DIGIT. (EASIER THAN;BACKING UP POINTER.)		CMP	#MINUTK	;MINUS?		BEQ	FINEC1	;NEGATE.		CMP	#$2D	;MINUS SIGN?		BEQ	FINEC1		CMP	#PLUSTK	;PLUS?		BEQ	FINEC		CMP	#$2B	;PLUS SIGN?		BEQ	FINEC		BNE	FINEC2FINEC1:		ROR	EXPSGN	;TURN IT ON.FINEC:		JSR	CHRGET	;GET ANOTHER.FNEDG1:		BCC	FINEDG	;IT IS A DIGIT.FINEC2:		BIT	EXPSGN		BPL	FINE		LDA	#0		SEC		SBC	TENEXP		JMP	FINE1FINDP:		ROR	DPTFLG		BIT	DPTFLG		BVC	FINCFINE:		LDA	TENEXPFINE1:		SEC		SBC	DECCNT	;# OF PLACES TO SHIFT		STA	TENEXP		BEQ	FINQNG	;NEGATE?		BPL	FINMUL	;POSITIVE SO MULTIPLY.FINDIV:		JSR	DIV10		INC	TENEXP	;DONE?		BNE	FINDIV	;NO.		BEQ	FINQNG	;YES.FINMUL:		JSR	MUL10		DEC	TENEXP	;DONE?		BNE	FINMUL	;NOFINQNG:		LDA	SGNFLG		BMI	NEGXQS	;IF POSITE, RETURN.		RTSNEGXQS:		JMP	NEGOP	;ELSE, NEG AND RTNFINDIG:		PHA		BIT	DPTFLG		BPL	FINDG1		INC	DECCNTFINDG1:		JSR	MUL10		PLA		;GET IT BACK.		SEC		SBC	#'0'		JSR	FINLOG	;ADD IT IN.		JMP	FINCFINLOG:		PHA		JSR	MOVAF	;SAVE FAC FOR LATER.		PLA		JSR	FLOAT	;FLOAT THE A REG		LDA	ARGSGN		EOR	FACSGN		STA	ARISGN	;RESULTANT SIGN.		LDX	FACEXP	;SET SIGNS ON THING TO ADD.		JMP	FADDT	;ADD  AND RETURN;HERE PACK IN THE NEXDIGIT OF THE EXPONENT.;MULTIPLY THE OLD EXP BY 10 AND ADD IN THE NEXT;DIGIT. NOTE: EXP OVERFLOW IS NOT CHECKED FOR.FINEDG:		LDA	TENEXP	;GET EXP SO FAR.		CMP	#$0A	;WILL RESULT BE .GE. 100?		BCC	MLEX10		LDA	#$64	;GET 100.		BIT	EXPSGN		BMI	MLEXMI	;IF NEG EXP, NO CHK FOR OVERR.		JMP	OVERRMLEX10:		ASL	A	;MULT BY 2 TWICE		ASL	A		CLC		;POSSIBLE SHIFT OUT OF HIGH.		ADC	TENEXP	;LIKE MULTIPLYING BY FIVE.		ASL	A	;AND NOW BY TEN.		CLC		LDY	#0		ADC	(TXTPTR),Y		SEC		SBC	#'0'MLEXMI:		STA	TENEXP	;SAVE RESULT.		JMP	FINEC		EJECT		TITLE	'FLOATING POINT OUTPUT ROUTINE.'N_0999:		DC.B	$9B	; 99999999.9499		DC.B	$3E		DC.B	$BC		DC.B	$1F		DC.B	$FDN_9999:		DC.B	$9E	; 999999999.499		DC.B	$6E		DC.B	$6B		DC.B	$27		DC.B	$FDN_MIL:		DC.B	$9E	; 109		DC.B	$6E		DC.B	$6B		DC.B	$28		DC.B	$00;ENTRY TO LINPRT.INPRT:		LDA	#INTXT		LDY	#>INTXT		JSR	STROU2		LDA	CURLIN+1		LDX	CURLINLINPRT:		STA	FACHO		STX	FACHO+1		LDX	#$90	;EXPONENT OF 16.		SEC		;NUMBER IS POSITIVE.		JSR	FLOATC		JSR	FOUTSTROU2:		JMP	STROUT	;PRINT AND RETURN.FOUT:		LDY	#1FOUTC:		LDA	#$2D	;PRINT NULL IF PLUS		DEY		;NEG SIGN IF NEGATIVE		BIT	FACSGN		BPL	FOUT1_1		INYFOUT1:		STA	|FBUFFR-1,Y	;STA THE CHRFOUT1_1:		STA	FACSGN	;MAKE FAC POS FOR QINT.		STY	FBUFPT	;SAVE FOR LATER.		INY		LDA	#'0'	;GET ZERO TO TYPE IF FAC=0.		LDX	FACEXP		BNE	*+5		JMP	FOUT19		LDA	#0		CPX	#$80	;IS NUMBER .LT. 1.0 ?		BEQ	FOUT37	;NO.		BCS	FOUT7FOUT37:		LDA	#N_MIL		LDY	#>N_MIL	;MULTIPLY BY 106.		JSR	FMULT		LDA	#$100-6-3FOUT7:		STA	DECCNT	;SAVE COUNT OR ZERO IT.FOUT4:		LDA	#N_9999		LDY	#>N_9999		JSR	FCOMP	;IS NUMBER .GT. 999999.499 ?;OR 999999999.499?		BEQ	BIGGES		BPL	FOUT9	;YES. MAKE IT SMALLER.FOUT3:		LDA	#N_0999		LDY	#>N_0999		JSR	FCOMP	;IS NUMBER .GT. 99999.9499 ?; OR 99999999.9499?		BEQ	FOUT38		BPL	FOUT5	;YES. DONE MULTIPLYING.FOUT38:		JSR	MUL10	;MAKE IT BIGGER.		DEC	DECCNT		BNE	FOUT3	;SEE IF THAT DOES IT.;THIS ALWAYS GOES.FOUT9:		JSR	DIV10	;MAKE IT SMALLER.		INC	DECCNT		BNE	FOUT4	;SEE IF THAT DOES IT.;THIS ALWAYS GOES.FOUT5:		JSR	FADDH	;ADD A HALF TO ROUND UP.BIGGES:		JSR	QINT		LDX	#1	;DECIMAL POINT COUNT.		LDA	DECCNT		CLC		ADC	#3*1+7	;SHOULD # PRINT IN E FORM?;IE, IS NUMBER .LT. .01 ?		BMI	FOUTPI	;YES.		CMP	#3*1+$08	;IS IT .GT. 999999 (999999999)?		BCS	FOUT6	;YES. USE E NOTATION.		ADC	#$100-1	;# OF PLACES BR DEC PT		TAX		;PUT INTO ACCX.		LDA	#2	;NO E NOTATION.FOUTPI:		SECFOUT6:		SBC	#2	;ADD 5 TO ORIG EXP		STA	TENEXP	;THAT IS THE EXPONENT TO PRINT.		STX	DECCNT	;# OF DEC PLACS		TXA		BEQ	FOUT39		BPL	FOUT8	;SOME PLACES BEFORE DEC PNT.FOUT39:		LDY	FBUFPT	;PTR TO OUTPUT		LDA	#'.'	;PUT IN '.'		INY		STA	|FBUFFR-1,Y		TXA		BEQ	FOUT16		LDA	#'0'	;GET THE ENSUING ZERO.		INY		STA	|FBUFFR-1,YFOUT16:		STY	FBUFPT	;SAVE FOLATER.FOUT8:		LDY	#0FOUTIM:		LDX	#$80	;FIRST PASS THRU, ACCX HAS MSB SET.FOUT2:		LDA	FACLO		CLC		ADC	FOUTBL+2+1,Y		STA	FACLO		LDA	FACMO		ADC	FOUTBL+1+1,Y		STA	FACMO		LDA	FACMOH		ADC	FOUTBL+1,Y		STA	FACMOH		LDA	FACHO		ADC	FOUTBL,Y		STA	FACHO		INX		;IT WAS DONE YET ANOTHER TIME.		BCS	FOUT41		BPL	FOUT2		BMI	FOUT40FOUT41:		BMI	FOUT2FOUT40:		TXA		BCC	FOUTYP	;CAN USE ACCA AS IS.		EOR	#$FF	;FIND 11.-A.		ADC	#$0A	;C IS STILL ON TO COMPLETE NEGAON.;AND WILL ALWAYS BE ON AFTER.FOUTYP:		ADC	#'0'-1	;GET A CHARACTER TO PRINT.		INY		INY		INY		INY		;BUMP POINTER UP.		STY	FDECPT		LDY	FBUFPT		INY		;POINT TO PLACE TO STORE OUTPUT.		TAX		AND	#$7F	;GET RID OF MSB.		STA	|FBUFFR-1,Y		DEC	DECCNT		BNE	STXBUF	;NOT TIME FOR DP YET.		LDA	#'.'		INY		STA	|FBUFFR-1,Y	;STORE DP.STXBUF:		STY	FBUFPT	;STORE PNTR FOR LATER.		LDY	FDECPTFOUTCM:		TXA		;COMPLEMENT ACCX		EOR	#$FF	;COMPLEMENT ACCA.		AND	#$80	;SAVONLY MSB.		TAX		CPY	#FDCEND-FOUTBL		BNE	FOUT2	;CONTINUE WITH OUTPUT.FOULDY:		LDY	FBUFPT	;GET BACK OUTPUT PNTR.FOUT11:		LDA	|FBUFFR-1,Y	;REMOVE TRAIL 0'S		DEY		CMP	#'0'		BEQ	FOUT11		CMP	#'.'		BEQ	FOUT12	;RUN INTO DP. STOP.		INY		;SOMETHING ELSE. SAVE IT.FOUT12:		LDA	#$2B		LDX	TENEXP		BEQ	FOUT17	;NO EXPONENT TO OUTPUT.		BPL	FOUT14		LDA	#0		SEC		SBC	TENEXP		TAX		LDA	#$2D	;EXPONENT IS NEGATIVE.FOUT14:		STA	FBUFFR-1+2,Y	;STORE SIGN OF EXP		LDA	#'E'		STA	FBUFFR-1+1,Y	;STORE THE 'E' CHARACTER.		TXA		LDX	#'0'-1		SECFOUT15:		INX		;MOVE CLOSER TO OUTPUT VALUE.		SBC	#$0A	;SUBTRACT 10.		BCS	FOUT15	;NOT NEGATIVE YET.		ADC	#'0'+$0A	;2ND OUTPUT CHR		STA	FBUFFR-1+4,Y	;STORE HIGH DIGIT.		TXA		STA	FBUFFR-1+3,Y	;STORE  LOW DIGIT.		LDA	#0	;PUT IN TERMINATOR.		STA	FBUFFR-1+5,Y		BEQ	FOUT20	;RETURN. (ALWAYS  GO)FOUT19:		STA	|FBUFFR-1,Y	;STOR CHARFOUT17:		LDA	#0	;A TERMINATOR.		STA	FBUFFR-1+1,YFOUT20:		LDA	#<FBUFFR		LDY	#>FBUFFRFPWRRT:		RTS		;ALL DONE.FHALF:		DC.B	$80	;1/2		DC.B	$00		DC.B	$00		DC.B	$00		DC.B	$00;POWER OF TEN TABLEFOUTBL:		DC.B	$FA	;-100,000,000		DC.B	$0A		DC.B	$1F		DC.B	$00		DC.B	$00	;10,000,000		DC.B	$98		DC.B	$96		DC.B	$80		DC.B	$FF	;-1,000,000		DC.B	$F0		DC.B	$BD		DC.B	$C0		DC.B	$00	;100,000		DC.B	$01		DC.B	$86		DC.B	$A0		DC.B	$FF	;-10,000		DC.B	$FF		DC.B	$D8		DC.B	$F0		DC.B	$00	;00		DC.B	$00		DC.B	$03		DC.B	$E8		DC.B	$FF	;-100		DC.B	$FF		DC.B	$FF		DC.B	$9C		DC.B	$00	;10		DC.B	$00		DC.B	$00		DC.B	$0A		DC.B	$FF	;-1		DC.B	$FF		DC.B	$FF		DC.B	$FFFDCEND:		EQU	*		EJECT		TITLE	'EXP AND SQUARE ROOT';SQUARE ROOT FUNCTION --- SQR(A);USE SQR(X)=X.5SQR:		JSR	MOVAF	;MOVE FAC INTO ARG.		LDA	#FHALF		LDY	#>FHALF		JSR	MOVFM	;PUT MEMORY INTO FAC.;LAST THING FETCHED IS FACEXP. INTO ACCX.; JMP FPWRT   ;FALL INTO FPW.;EXPONENTIATION ---  XY.;N.B.  00=1;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT;RETURNED BY EXP.;TO COMPUTE THE RESULT USE XY=EXP((Y*LOG(X)).FPWRT:		BEQ	EXP	;IF FAC=0, JUST EXPONENTIATE THAT.		LDA	ARGEXP	;IS X=0?		BNE	FPWRT1		JMP	ZEROF1	;ZERO FAC.FPWRT1:		LDX	#TEMPF3		LDY	#>TEMPF3	;SAVE FOR LATER IN A TEMP.		JSR	MOVMF;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.		LDA	ARGSGN		BPL	FPWR1	;NO PROBLEMS IF X.GT.0.		JSR	INT	;INTEGERIZE THE FAC.		LDA	#TEMPF3		LDY	#>TEMPF3	;GET ADDR OF COMPERAND.		JSR	FCOMP	;EQUAL?		BNE	FPWR1	;LEAVE X NEG. LOG WILL BLOW HIM OUT.;A=-1 AND Y IS IRRELEVANT.		TYA		;NEGATE X. MAKE POSITIVE.		LDY	INTEGR	;GET EVENNESS.FPWR1:		JSR	MOVFA1	;ALTERNATE ENTRY POINT.		TYA		PHA		;SAVE EVENNESS FOR TER.		JSR	LOG	;FIND LOG.		LDA	#TEMPF3		LDY	#>TEMPF3	;MULTIPLY FAC TIMES LOG(X).		JSR	FMULT		JSR	EXP	;EXPONENTIATE THE FAC.		PLA		LSR	A	;IS IT EVEN?		BCC	NEGRTS	;YES. OR X.GT.0.;NEGATE THE NUMBER IN FAC.NEGOP:		LDA	FACEXP		BEQ	NEGRTS		LDA	FACSGN		EOR	#255		STA	FACSGNNEGRTS:		RTS		EJECT		TITLE	'EXPONENTIATION FUNCTION.';FIRST SAVE THE ORIGINAL ARGUMENT AND MULTIPLY THE FAC BY;LOG2(E). THE RESULT IS USED TO DETERMINE IF OVERFLOW;WILL OCCUR SINCE EXP)=2(X*LOG2(E)) WHERE;LOG2(E)=LOG(E) BASE 2. THEN SAVE THE INTEGER PART OF;THIS TO SCALE THE ANSWER AT THE END. SINCE;2Y=2INT(Y)*2(Y-INT(Y)) AND 2INT(Y) IS EASY TO COMPUTE.;NOW COMPUTE 2(X*LOG2(E)-INT(X*LOG2(E)) BY;P(LN(2)*(INT(X*LOG2(E))+1)-X) WHERE P IS AN APPROXIMATION;POLYNOMIAL. THE RESULT IS THEN SCALED BY THE POWER OF 2;PREVIOUSLY SAVED.LOGEB2:		DC.B	$81	;LOG(E) BASE 2.		DC.B	$38		DC.B	$AA		DC.B	$3B,$29EXPCON:		DC.B	7	;DEGREE-1		DC.B	$71	; .0000214987636		DC.B	$34		DC.B	$58		DC.B	$3E		DC.B	$56		DC.B	$74	; .00014352314036		DC.B	$16		DC.B	$7E		DC.B	$B3		DC.B	$1B		DC.B	$77	; .0013422634824		DC.B	$2F		DC.B	$EE		DC.B	$E3		DC.B	$85		DC.B	$7A	; .0096140170119		DC.B	$1D		DC.B	$84		DC.B	$1C		DC.B	$2A		DC.B	$7C	; .055505126860		DC.B	$63		DC.B	$59		DC.B	$58		DC.B	$0A		DC.B	$7E	; .24022638462		DC.B	$75		DC.B	$FD		DC.B	$E7		DC.B	$C6		DC.B	$80	; .69314718608		DC.B	$31		DC.B	$72		DC.B	$18		DC.B	$10		DC.B	$81	; 1.0		DC.B	$00		DC.B	$00		DC.B	$00		DC.B	$00EXP:		EQU	*		LDA	#LOGEB2		LDY	#>LOGEB2	;MULTIPLY BY LOG(E) BASE 2.		JSR	FMULT		LDA	FACOV		ADC	#$50		BCC	STOLD		JSR	INCRNDSTOLD:		STA	OLDOV		JSR	MOVEF	;TO SAVE IN ARG WITHOUT ROUND.		LDA	FACEXP		CMP	#$88	;IF ABS(FAC) .GE. 128, TOO BIG.		BCC	EXP1GOMLDV:		JSR	MLDVEX	;OVERFLOW OR OVERFLOW.EXP1:		JSR	INT		LDA	INTEGR	;GET LOW PART.		CLC		ADC	#$81		BEQ	GOMLDV	;OVERFLOW OR OVERFLOW !!		SEC		SBC	#1	;SUBTRACT 1.		PHA		;SAVE A WHILE.		LDX	#4+1	;PREP TO SWAP FAC AND ARG.SWAPLP:		LDA	ARGEXP,X		LDY	FACEXP,X		STA	FACEXP,X		STY	ARGEXP,X		DEX		BPL	SWAPLP		LDA	OLDOV		STA	FACOV		JSR	FSUBT		JSR	NEGOP	;NEGATE FAC.		LDA	#EXPCON		LDY	#>EXPCON		JSR	POLY		LDA	#0		STA	ARISGN	;MULTIPLY BY POSITIVE 1.0.		PLA		;GET SCALE FACTOR.		JSR	MLDEXP	;MODIFY FACEXP AND CHECK FOR OVERFLOW.		RTS		;HAS TO DO JSR DUE TO PULAS IN MULDIV.		EJECT		TITLE	'POLY EVAL & RANDOM NUMBER GEN';EVALUATE P(X2)*X;POINTER TO DEGREE IS IN Y,A.;THE CONSTANTS FOLLOW THE DEGREE.;FOR X=FAC, COMPUTE:; C0*X+C1*X3+C2*X5+C3*X7+...+C(N)*X(2*N+1)POLYX:		STA	POLYPT		STY	POLYPT+1	;RETAIN POLYNOMIAL POINTER FOR LATER.		JSR	MOV1F	;SAVE FAC IN FACTMP.		LDA	#TEMPF1		JSR	FMULT	;COMPUTE X2.		JSR	POLY1	;COMPUTE P(X2).		LDA	#TEMPF1		LDY	#>TEMPF1		JMP	FMULT	;MULTIPLY BY FAC AGAIN.;POLYNOMIAL EVALUATOR.;POINTER TDEGREE IS IN Y,A.;COMPUTE:; C0+C1*X+C2*X2+C3*X3+C4*X4+...+C(N-1)*X(N-1)+C(N)*XN.POLY:		STA	POLYPT		STY	POLYPT+1POLY1:		JSR	MOV2F	;SAVE FAC.		LDA	(POLYPT),Y		STA	DEGREE		LDY	POLYPT		INY		TYA		BNE	POLY3		INC	POLYPT+1POLY3:		STA	POLYPT		LDY	POLYPT+1POLY2:		JSR	FMULT		LDA	POLYPT		LDY	POLYPT+1	;GET CURRENT POINTER.		CLC		ADC	#4+1		BCC	POLY4		INYPOLY4:		STA	POLYPT		STY	POLYPT+1		JSR	FADD	;ADD IN CONSTANT.		LDA	#TEMPF2		LDY	#>TEMPF2	;MULTIY THE ORIGINAL FAC.		DEC	DEGREE	;DONE?		BNE	POLY2RANDRT:		RTS		;YES.;PSUEDO-RANDOM NUMBER GENERATOR.;IF ARG=0, THE LAST RANDOM NUMBER GENERATED IS RETURNED.;IF ARG .LT. 0, A NEW SEQUENCE OF RANDOM NUMBERS IS;STARTED USING THE ARGUMENT.;   TO FORM THE NEXT RANDOM NUMBER IN THE SEQUENCE,;MULTIPLY THE PREVIOUS RANDOM NUMBER BY A RANDOM CONSTANT;AND ADD IN ANOTHER RANDOM CONSTANT. THE THEN HO;AND LO BYTES ARE SWITCHED, THE EXPONENT IS PUT WHERE;IT WILL BE SHIFTED IN BY RMAL, & THE EXPONENT IN THE FAC;IS SET TO 200 SO THE RESULT WILL BE LESS THAN 1. THIS;IS THEN NORMALIZED AND SAVED FOR THE NEXT TIME.;THE HO AND LOW BYTES WERE SWITCHED SO THERE WILL BE A;RANDOM CHANCE OF GETTING A NUMBER LESS THAN OR GREATER;THAN .5 .RMUL_C:		DC.B	$98		DC.B	$35		DC.B	$44		DC.B	$7ARADD_C:		DC.B	$68		DC.B	$28		DC.B	$B1		DC.B	$46RND:		JSR	SIGN	;GET SIGN INTO ACCX.		TAX		;GET INTO ACCX, SINCE 'MOVFM' USES ACCX.		BMI	RND1	;START NEW SEQUENCE  NEGATIVE.QSETNR:		LDA	#RNDX		LDY	#>RNDX	;GET LAST ONE INTO FAC.		JSR	MOVFM		TXA		;FAC WAS ZERO?		BEQ	RANDRT	;RESTORE LAST ONE.		LDA	#RMUL_C		LDY	#>RMUL_C	;MULTIPLY BY RANDOM CONSTANT.		JSR	FMULT		LDA	#RADD_C		LDY	#>RADD_C		JSR	FADD	;ADD RANDOM CONSTANT.RND1:		LDX	FACLO		LDA	FACHO		STA	FACLO		STX	FACHO	;REVERSE HO AND LO.STRNEX:		LDA	#$00		STA	FACSGN	;MAKE NUMBER POSITIVE.		LDA	FACEXP	;PUT EXP WHERE IT WILL		STA	FACOV	;BE SHIFTED IN BY NORMAL.		LDA	#$80		STA	FACEXP	;MAKE RESULT BETWEEN 0 AND 1.		JSR	NORMAL	;NORMALIZE.		LDX	#RNDX		LDY	#>RNDXGMOVMF:		JMP	MOVMF	;PUT NEW ONE INTO MEMORY.		EJECT		TITLE	'SINE, COSINE & TANGENT';COSINE FUNCTION.;USE COS(X)=SIN(X+PI/2)COS:		LDA	#PI2		LDY	#>PI2	;PNTR TO PI/2.		JSR	FADD	;ADD IT IN.;FALL INTO SIN.;SINE FUNCTION.;USE IDENTITIES TO GET FAC IN QUADRANTS I OR IV.;THE FAC IS DIVIDED BY 2*PI & THE INTEGER PART IS IGNORED;BECAUSE SIN(X+PI)=SIN(X). THEN ARGUMENT CAN BE COMPARED;WITH PI/2 BY COMPARING THE RESULT OF THE DIVISION;WITH PI/2/(2*PI)=1/4.;IDENTITIES ARE THEN USED TO GET THE RESULT IN QUADRANTS;I OR IV. AN APPROXIMATION POLYNOMIAL IS THEN USED TO;COMPUTE SIN(X).SIN:		JSR	MOVAF		LDA	#TWOPI		LDY	#>TWOPI	;GET PNTR TO DIVISOR.		LDX	ARGSGN	;GET SIGN OF RESULT.		JSR	FDIVF		JSR	MOVAF	;GET RESULT INTO ARG.		JSR	INT	;INTEGERIZE FAC.		LDA	#0		STA	ARISGN	;ALWAYS HAVE THE SAME SIGN.		JSR	FSUBT	;KEEP ONLY THE FRACTIONAL PART.		LDA	#FR4		LDY	#>FR4	;GET PNTR TO 1/4.		JSR	FSUB	;COMPUTE 1/4-FAC.		LDA	FACSGN	;SAVE SIGN FOR LATER.		PHA		BPL	SIN1	;FIRST QUADRANT.		JSR	FADDH	;ADD 1/2 TO FAC.		LDA	FACSGN	;SIGN IS NEGATIVE?		BMI	SIN2		LDA	TANSGN		EOR	#255		STA	TANSGN	;QUADRANTS II AND III COME HERE.SIN1:		JSR	NEGOP	;IF POSITIVE, NEGATE IT.SIN2:		LDA	#FR4		LDY	#>FR4	;POINTER TO 1/4.		JSR	FADD	;ADD IT IN.		PLA		;GET ORIGINAL QUADRANT.		BPL	SIN3		JSR	NEGOP	;IF NEGATIVE, NEGATE RESULT.SIN3:		LDA	#SINCON		LDY	#>SINCONGPOLYX:		JMP	POLYX	;DO APPROXIMATION POLYNOMIAL.;TANGENT FUNCTION.TAN:		JSR	MOV1F	;MOVE FAC INTO TEMPORARY.		LDA	#0		STA	TANSGN	;REMEMBER WHETHER TO NEGATE.		JSR	SIN	;COMPUTE THE SIN.		LDX	#TEMPF3		LDY	#>TEMPF3		JSR	GMOVMF	;PUT SIGN INTO OTHER TEMP.		LDA	#TEMPF1		LDY	#>TEMPF1		JSR	MOVFM	;PUT THIS MEMORY LOC INTO FAC.		LDA	#0		STA	FACSGN	;START OFF POSITIVE.		LDA	TANSGN		JSR	COSC	;COMPUTE COSINE.		LDA	#TEMPF3		LDY	#>TEMPF3	;ADDRESS OF SINE VALUE.GFDIV:		JMP	FDIV	;DIVIDE SINE BY COSINE AND RETURN.COSC:		PHA		JMP	SIN1PI2:		DC.B	$81	;PI/2		DC.B	$49		DC.B	$0F		DC.B	$DA		DC.B	$A2TWOPI:		DC.B	$83	;2*PI.		DC.B	$49		DC.B	$0F		DC.B	$DA		DC.B	$A2FR4:		DC.B	$7F	;1/4		DC.B	$00		DC.B	$00		DC.B	$00		DC.B	$00SINCON:		DC.B	5	;DEGREE-1.		DC.B	$84	; -14.381383816		DC.B	$E6		DC.B	$1A		DC.B	$2D		DC.B	$1B		DC.B	$86	; 42.07777095		DC.B	$28		DC.B	$07		DC.B	$FB		DC.B	$F8		DC.B	$87	; -76.704133676		DC.B	$99		DC.B	$68		DC.B	$89		DC.B	$01		DC.B	$87	; 81.605223690		DC.B	$23		DC.B	$35		DC.B	$DF		DC.B	$E1		DC.B	$86	; -41.34170209		DC.B	$A5		DC.B	$5D		DC.B	$E7		DC.B	$28		DC.B	$83	; 6.2831853070		DC.B	$49		DC.B	$0F		DC.B	$DA		DC.B	$A2		DC.B	$A6		DC.B	$D3		DC.B	$C1		DC.B	$C8		DC.B	$D4		DC.B	$C8		DC.B	$D5		DC.B	$C4		DC.B	$CE		DC.B	$CA		EJECT		TITLE	'ARCTANGENT FUNCTION.';USE IDENTITIES TO GET ARG BETWEEN 0 AND 1 AND THEN USE AN;APPROXIMATION POLYNOMIAL TO COMPUTE ARCTAN(X).ATN:		LDA	FACSGN	;WHAT IS SIGN?		PHA		;(MEANWHILE SAVE FOR LATER.)		BPL	ATN1		JSR	NEGOP	;IF NEGATIVE, NEGATE FAC.;USE ARCTAN(X)=-ARCTAN(-X) .ATN1:		LDA	FACEXP		PHA		;SAVE THIS TOO FOR LATER.		CMP	#$81	;SEE IF FAC .GE. 1.0 .		BCC	ATN2	;IT IS LESS THAN 1.		LDA	#FONE		LDY	#>FONE	;GET PNTR TO 1.0 .		JSR	FDIV	;COMPUTE RECROCAL.;USE ARCTAN(X)=PI/2-ARCTAN(1/X) .ATN2:		LDA	#ATNCON		LDY	#>ATNCON	;PNTR TO ARCTAN CONSTANTS.		JSR	POLYX		PLA		CMP	#$81	;WAS ORIGINAL ARGUMENT .LT. 1 ?		BCC	ATN3	;YES.		LDA	#PI2		LDY	#>PI2		JSR	FSUB	;SUBTRACT ARCTAGN FROM PI/2.ATN3:		PLA		;WAS ORIGINAL ARGUMENT POSITIVE?		BPL	ATN4	;YES.		JMP	NEGOP	;IF NEGATIVE, NEGATE RESULT.ATN4:		RTS		;ALL DONE.ATNCON:		DC.B	$0B	;DEGREE-1.		DC.B	$76	; -.0006847939119		DC.B	$B3		DC.B	$83		DC.B	$BD		DC.B	$D3		DC.B	$79	; .004850942156		DC.B	$1E		DC.B	$F4		DC.B	$A6		DC.B	$F5		DC.B	$7B	; -.01611170184		DC.B	$83		DC.B	$FC		DC.B	$B0		DC.B	$10		DC.B	$7C	; .03420963805		DC.B	$0C		DC.B	$1F		DC.B	$67		DC.B	$CA		DC.B	$7C	; .-.05427913276		DC.B	$DE		DC.B	$53		DC.B	$CB		DC.B	$C1		DC.B	$7D	; .07245719654		DC.B	$14		DC.B	$64		DC.B	$70		DC.B	$4C		DC.B	$7D	; -.08980239538		DC.B	$B7		DC.B	$EA		DC.B	$51		DC.B	$7A		DC.B	$7D	; .1109324134		DC.B	$63		DC.B	$30		DC.B	$88		DC.B	$7E		DC.B	$7E	; -.1428398077		DC.B	$92		DC.B	$44		DC.B	$99		DC.B	$3A		DC.B	$7E	; .1999991205		DC.B	$4C		DC.B	$CC		DC.B	$91		DC.B	$C7		DC.B	$7F	; -.3333333157		DC.B	$AA		DC.B	$AA		DC.B	$AA		DC.B	$13		DC.B	$81	; 1.000000000		DC.B	$00		DC.B	$00		DC.B	$00		DC.B	$00		EJECT		TITLE	'SYSTEM INITIALIZATION CODE.'; THIS INITIALIZES THE BASIC INTERPRETER FOR THE M6502; LOCATED WHERE IT WIL BE WIPED OUT IN RAM IF CODE IS ALIN ;SO ZEROING AT TXTTAB DOESN'T PREVENT;RESTARTING INITINITAT:		INC	CHRGET+7	;INCREMENT THE WHOLE TXTPTR.		BNE	CHSGOT		INC	CHRGET+8CHSGOT:		LDA	60000	;A LOAD WITH AN EXT ADDR.		CMP	#':'	;IS IT A ':'?		BCS	CHSRTS	;IT IS .GE. ':'		CMP	#' '	;SKIP SPACES.		BEQ	INITAT		SEC		SBC	#'0'	;ALL CHARS .GT. '9' HAVE RET'D SO		SEC		SBC	#$100-'0'	;SEE IF NUMERIC.;TURN CARRY ON IF NUMERIC.;ALSO, SETZ IF NULL.CHSRTS:		RTS		;RETURN TO CALLER.		DC.B	128	;LOADED  FROM ROM.		DC.B	79	;THE INITIAL RANDOM NUMBER.		DC.B	199		DC.B	82		DC.B	88INIT:		LDX	#255	;MAKE IT LOOK DIRECT IN CASE OF		STX	CURLIN+1	;ERROR MESSAGE.		LDX	#STKEND-256		TXS		LDA	#<INIT		LDY	#>INIT	;ALLOW RESTART.		STA	START+1		STY	START+1+1		STA	RDYJSR+1		STY	RDYJSR+1+1	;RTS HERE ON ERRORS.		JSR	SETNORM	;FOR NORMAL VIDEO		LDA	#76	; A JUMP INSTRUCTION		STA	START		STA	RDYJSR		STA	JMPER		STA	USRPOK		LDA	#<FCERR		LDY	#>FCERR		STA	USRPOK+1		STY	USRPOK+1+1;INTO THE PROGRAM		LDX	#RNDX+4-CHRGETMOVCHG:		LDA	INITAT-1,X		STA	CHRGET-1,X	;MOVE TO RAM.		STX	SPDBYT	;FOR FULL SPEED PRINTING		DEX		BNE	MOVCHG		STX	TRFLAG	;TRACE OFF MODE.		TXA		;SET CONST IN RAM.		STA	BITS		STA	LASTPT+1		PHA		;PUT ZERO AT THE END OF THE STACK;SO FNDFOR WILL STOP		LDA	#STRSIZ		STA	FOUR6		JSR	CRDO	;TYPE A CR.		LDA	#1		STA	BUF-3	;SET PRE-BUF BYTES NON-ZERO FOR CHEAD		STA	BUF-4		LDX	#TEMPST		STX	TEMPPT	;SET UP STRING TEMPORARIES.		LDA	#<RAMLOC		LDY	#RAMLOC/256		STA	LINNUM		STY	LINNUM+1		LDY	#0LOOPMM:		INC	LINNUM+1LOOPM1:		LDA	(LINNUM),Y		EOR	#$FF		STA	(LINNUM),Y		CMP	(LINNUM),Y		BNE	USEDEC		EOR	#$FF		STA	(LINNUM),Y		CMP	(LINNUM),Y		BEQ	LOOPMMUSEDEC:		LDY	LINNUM		LDA	LINNUM+1	;GET SIZE OF MEMORY INPUT.USEDEF:		EQU	*	;HIGHEST ADDRESS.		AND	#$F0		STY	MEMSIZ		STA	MEMSIZ+1	;THIS IS THE SIZE OF MEMORY.		STY	FRETOP		STA	FRETOP+1	;TOP OF STRINGS TOO.ASKAGN:		EQU	*		LDX	#<RAMLOC		LDY	#RAMLOC/256FINILOW:		STX	TXTTAB		STY	TXTTAB+1		LDY	#0		STY	RNONLY		TYA		STA	(TXTTAB),Y	;SET UP TEXT TABLE.		INC	TXTTAB		BNE	QROOM		INC	TXTTAB+1QROOM:		LDA	TXTTAB		LDY	TXTTAB+1	;PREPARE TO USE 'REASON'.		JSR	REASON		JSR	SCRTCH	;SET UP EVERYTHING ELSE.		LDA	#<STROUT		LDY	#>STROUT		STA	RDYJSR+1		STY	RDYJSR+1+1		LDA	#<READY		LDY	#>READY		STA	START+1		STY	START+1+1		IF LOLLY <> 0 THEN		DC.B	$6C	;JMP (INDIRECT)		DC.W	START+1		ELSE		JMP	(START+1)		ENDIF		EJECT		TITLE	'APPLESOFT EXTENSIONS'CALL:		JSR	FRMNUM		JSR	GETADR		IF LOLLY <> 0 THEN		DC.B	$6C	;JMP (INDIRECT)		DC.W	POKER		ELSE		JMP	(POKER)	;GO TO USER ROUTINESETGR		EQU	$FB40		ENDIF		IF PLIST <> 0 THEN		PRINT	ON		ELSE		ENDIFSETTXT		EQU	$FB39INPORT		EQU	$FE8BOUTPORT		EQU	$FE95INNUMB:		JSR	GETBYT	;GET PORT NUMBR		TXA		;INTO A		JMP	INPORTPRNUMB:		JSR	GETBYT		TXA		JMP	OUTPORT		IF LOLLY <> 0 THENXMAX		EQU	$50		ELSEXMAX		EQU	$30		ENDIFPLOTFNS:		JSR	GETBYT		CPX	#XMAX		BCS	TOOBIG		STX	FIRST		LDA	#$2C	;ARGS MUST BE SEPERATED BY COMMA		JSR	SYNCHR		JSR	GETBYT	;GET SECOND ARG		IF CORTLAND <> 0 THEN		CPX	#48	;48 is correct for Cortland		ELSE		CPX	#XMAX		ENDIF		BCS	TOOBIG	;BRANCH IF ILLEGAL PLOT 		STX	H2		STX	V2	;BOTH ARGS		RTSTOOBIG:		JMP	FCERRATFNS:		JSR	PLOTFNSATFNS2		EQU	*	;Cortland HLIN return entry point		CPX	FIRST	;ARGS IN RIGHT ORDER?		BCS	RGHTORD		LDA	FIRST		STA	H2		STA	V2		STX	FIRSTRGHTORD:		LDA	#ATTKN		JSR	SYNCHR		JSR	GETBYT		CPX	#XMAX	;LAST COORD OK?		BCS	TOOBIG		RTSPLOT:		JSR	PLOTFNS		IF LOLLY <> 0 THEN		LDY	FIRST	;Y-REG=X-COORDINATE		JSR	XBOUND		TXA		;ACC=Y-COORD		JMP	PLOTDO		ELSEHLINE		EQU	$F819PLOTDO		EQU	$F800		TXA		;ACC=Y-COORD		LDY	FIRST	;Y-REG=X-COORDINATE		CPY	#40	;OUT OF RANGE		BCS	TOOBIG		JMP	PLOTDO		ENDIF	IF LOLLY <> 0  THEN		DC.B	$00	;Was BRKHLIN:		EQU	*	IF CORTLAND <> 0 THENSPATFNS		EQU	$F8D9	;Patches to fix ATFNS for HLIN		JSR	SPATFNS	ELSE		JSR	ATFNS	ENDIF	ENDIF		IF LOLLY <> 0 THEN		LDY	H2	;THIRD ARG IN ACC		JSR	XBOUND		CPX	#48		BCS	TOOBIG		ELSEHLIN:		JSR	ATFNS		TXA		;THIRD ARG IN ACC		LDY	H2		CPY	#40		BCS	TOOBIG		LDY	FIRST		ENDIF		JMP	HLINE		IF LOLLY <> 0 THENVLIN		JSR	ATFNS		TXA		TAY		JSR	XBOUND		LDA	FIRST		JMP	VLINXX		DC.B	$00	;Was BRK		ELSEVLINE		EQU	$F828VLIN:		JSR	ATFNS		TXA		TAY		;THIRD ARG IN Y-REG		CPY	#40		BCS	TOOBIG		LDA	FIRST		JMP	VLINE		ENDIFCOLORE:		JSR	GETBYT		TXA		;COLOR TO A-REG.		JMP	SETCOL		IF PLIST <> 0 THEN		PRINT	OFF		ELSE		ENDIFSETCOL:		EQU	$F864VTAB		JSR	GETBYT		DEX		TXA		;PREPARE FOR TABV SUBR.		CMP	#$18	;OFF OF SCREEN?		BCS	TOOBIG		JMP	TABVTABV		EQU	$FB5BSETSPD:		JSR	GETBYT		TXA		;FOR OUTPUT SPEED		EOR	#$FF		TAX		INX		STX	SPDBYT		RTSSETTRACE:		SEC		DC.B	$90	;was BCC	SETTRACE : ORG *-1TRACEOFF:		CLC		;ADJUST TRFLAG FOR TRACE.		ROR	TRFLAG		RTS		;BACK TO CALLER.*SETNORM:		LDA	#$FF		BNE	SETTYPEINVERSE:		LDA	#$3FSETTYPE:		LDX	#$00SETMODE:		STA	INVFLG		STX	ORMASK		RTSFLASH:		LDA	#$7F		LDX	#$40		BNE	SETMODE	;ALWAYS TAKEN*HIMEMSET:		JSR	FRMNUM	;GET ARG FOR HIMEM:		JSR	GETADR		LDA	POKER	;PROGRAM OVERFLOW?		CMP	STREND		LDA	POKER+1		SBC	STREND+1		BCS	DOSETMEMFULL:		JMP	OMERRDOSET:		LDA	POKER		STA	MEMSIZ		STA	FRETOP		LDA	POKER+1		STA	MEMSIZ+1		STA	FRETOP+1		RTSLOMEMSET:		JSR	FRMNUM		JSR	GETADR		LDA	POKER		CMP	MEMSIZ		LDA	POKER+1		SBC	MEMSIZ+1		BCS	MEMFULL		LDA	POKER		CMP	VARTAB		LDA	POKER+1		SBC	VARTAB+1		BCC	MEMFULL		LDA	POKER		STA	VARTAB		LDA	POKER+1		STA	VARTAB+1		JMP	CLEARCONERR:		LDA	#GOTOTK	;ON ERR GOTO?		JSR	SYNCHR	;IF NOT, BLOW HIM UP		LDA	TXTPTR	;SAVE FOR ERRHNDL		STA	ERRTO		LDA	TXTPTR+1		STA	ERRTO+1		SEC		;ROTATE IN.		ROR	ERRFLG		LDA	CURLIN	;ALL INFO FOR 'GOTO' COMMAND		STA	ERRTO+2		LDA	CURLIN+1		STA	ERRTO+3		JSR	REMN	;SKIP REST OF LINE.		JMP	ADDON	;FINISH.HNDLERR:		STX	ERRNUM		LDX	REMSTK	;PRESERVE STACK POINTER		STX	ERRSTK	;FOR 'RESUME' STATEMENT		LDA	CURLIN	;FOR RESUME		STA	ERRLIN		LDA	CURLIN+1		STA	ERRLIN+1		LDA	OLDTXT		STA	ERRPOS		LDA	OLDTXT+1		STA	ERRPOS+1* ALL USER INFO NOW THERE.		LDA	ERRTO		STA	TXTPTR		LDA	ERRTO+1		STA	TXTPTR+1		LDA	ERRTO+2		STA	CURLIN		LDA	ERRTO+3		STA	CURLIN+1		JSR	CHRGOT	;FOR STATUS		JSR	GOTO	;NOW DISPATCH, THEN		JMP	NEWSTT	;BACK TO NEWSTT.RESUME:		LDA	ERRLIN		STA	CURLIN		LDA	ERRLIN+1		STA	CURLIN+1		LDA	ERRPOS		STA	TXTPTR		LDA	ERRPOS+1		STA	TXTPTR+1		LDX	ERRSTK	;RESTORE STACK POINTER.		TXS		;FOR REST OF BASIC.		JMP	NEWSTT	;BACK TO TRY AGAIN.....BLOWEM:		JMP	SNERRDELETE:		BCS	BLOWEM	;IF NOT A DIGIT.		LDX	PRGEND	;FOR LOMEM:		STX	VARTAB		LDX	PRGEND+1		STX	VARTAB+1		JSR	LINGET	;READ THE LINE NUMBER INTO LINNUM.		JSR	FNDLIN		LDA	LOWTR	;PREPARE FOR MOVE.		STA	INDEX2		LDA	LOWTR+1		STA	INDEX2+1		LDA	#$2C		JSR	SYNCHR		JSR	LINGET	;MUST HAVE TWO ARGS.		INC	LINNUM	;INCLUSIVE DELETE.		BNE	*+4		INC	LINNUM+1		JSR	FNDLIN	;GET THIS LINE.;CHECK FOR BACKWARDS DELETE		LDA	LOWTR	;IS LOWTR>=INDEX2		CMP	INDEX2	;IF SO ;DO NOTHING		LDA	LOWTR+1		SBC	INDEX2+1		BCS	*+3		RTS;NOW MOVE: (INDEX1)<(LOWTR).(VARTAB)M		LDY	#0MOVEDEL:		LDA	(LOWTR),Y	;TRANSFER A BYTE.		STA	(INDEX2),Y		INC	LOWTR	;NEXT LOCATIONS...		BNE	*+4		INC	LOWTR+1		INC	INDEX2		BNE	*+4		INC	INDEX2+1		LDA	VARTAB		CMP	LOWTR	;DONE WITH MOVE?		LDA	VARTAB+1		SBC	LOWTR+1		BCS	MOVEDEL	;IF LESS THAN OR EQUAL, CONT.		LDX	INDEX2+1		LDY	INDEX2		BNE	*+3		DEX		DEY		STX	VARTAB+1	;END OF PROGRAM		STY	VARTAB		JMP	FINI	;FINISH IT OFF.		IF PLIST <> 0 THEN		PRINT	ON		ELSE		ENDIFLORES:		EQU	$C056MSETGR:		LDA	LORES		LDA	MIXSET		JMP	SETGR	;NOW INTO LOW-RESOLUTIONMSETTXT:		LDA	LOPAGE		JMP	SETTXT	IF LOLLY <> 0 THENPLOTDO		LSR	A		PHP		;THIS STUFF STOLEN FROM MONITOR GR ROUTINES		JSR	GBASCALC		PLP		LDA	#$F		BCC	RTMASK		ADC	#$E0	;FORMS $F0 WITH CARRY CLEARRTMASK		STA	MASKPLOT1		PHY		;OTHER ROUTINES ENTER HERE 		JSR	VIDSETY	;TEST FOR DOUBLE GR, SET Y 		BCC	PLOT3	;BRANCH IF REG GR 		PHX		;SAVE X ON TOP OF STACK 		LDA	COLOR	;MUST MUCK WITH COLORS IN ALT BANK 		TAX		;SAVE IN X FOR LATER COLOR RESTORE 		LSR	A		TXA		;ROTATE 8 BITS RIGHT		ROR	A		SEC		;RESET CARRY FOR ALT PAGE INDICATOR		STA	COLORPLOT3		EQU	*		JSR	ROMPLOT	;GO PLOT THE DOT 		BCC	PLOT4	;BRANCH IF NOT SPECIAL HANDLED		LDA	$C054		STX	COLOR	;RESTORE UNTRANSLATED COLOR		PLX		;RESTORE ORIGINAL X		CLC		;PLOT ALWAYS RETURNS CARRY CLEAR.PLOT4		PLY		;RESTORE ORIGINAL Y		RTSVIDSTATE		EQU	*	ENDIF	IF LOLLY <> 0 THEN	IF CORTLAND <> 0 THENGETAN3STATUS	EQU	$F93A	;Let Cortland monitor get AN3		JSR	GETAN3STATUS	;Get AN3 status in bit 7	ELSE		LDA	$C079	;GET STATE OF DOUBLE GR	ENDIF	ENDIF	IF LOLLY <> 0 THEN		EOR	#$80		AND	$C018	;80-STORE MUST ALSO BE ENABLED 		AND	$C01F		ASL	A	;RETURN IN CARRY		RTS*FILL_SIZE02	EQU	APPLESOFT+$23D8-*	IF FILL_SIZE02 > 0	THEN		DCB.B	FILL_SIZE02,0	;MAKE EM BREAKS	ENDIF	ELSE;THIS IS THE 'STORE' ROUTINE.;START=NAME POS.+#DIMS*2+5;END  =NAME POS.+LENGTH -1;;'RECALL' IS SIMILAR. (SHARES ROUTINES);;STORE:		JSR	GETARYPT	;SET UP.		LDY	#3		LDA	(LOWTR),Y	;GET LENGTH		TAX		;X=HIGH		DEY		LDA	(LOWTR),Y		SBC	#01	;SHOULD IT BE A 3 ??		BCS	*+3		DEX		STA	POKER		STX	POKER+1		JSR	C_COUT	;WRITE LEN TO CASSETTE		JSR	DOPTRS		JMP	C_COUT;; NOW I RECALL....;RECALL:		JSR	GETARYPT		JSR	C_CSIN	;GET LEN OF FILE		LDY	#2		LDA	(LOWTR),Y	;TOO BIG?		CMP	POKER		INY		;COMPARE HIGHS.		LDA	(LOWTR),Y		SBC	POKER+1		BCS	*+5	;IF ENOUGH ROOM		JMP	OMERR	;JUST TOO BIG!!		JSR	DOPTRS		JMP	C_CSIN	ENDIF		IF PLIST <> 0 THEN		PRINT	OFF		ELSE		ENDIF;TITLE "APPLE II HI-RES GRAPHICS ROUTINES"***************************                        ** APPLE-II HI-RESOLUTION * *  GRAPHICS SUBROUTINES  * *                        * *    BY WOZ   9/13/77    * *                        **  ALL RIGHTS RESERVED   **                        * **************************		EJECT		TITLE	'HI-RES EQUATES'SHAPEL		EQU	$1A	;POINTER TOSHAPEH		EQU	$1B	;SHAPE LIST HCOLOR1		EQU	$1C	;RUNNING COLOR MASKCOUNTH		EQU	$1DHBASL		EQU	$26	;BASE ADR FOR CURRENTHBASH		EQU	$27	;HI-RES PLOT LINE. AHMASK		EQU	$30A1L		EQU	$3C	;MONITOR A1.A1H		EQU	$3DA2L		EQU	$3E	;MONITOR A2.A2H		EQU	$3FLOMEML		EQU	$4A	;BASIC 'START OF VARS'.LOMEMH		EQU	$4BDXL		EQU	$D0	;DELTA-X FOR HLIN, SHAPE.DXH		EQU	$D1SHAPEX		EQU	$D1	;SHAPE TEMP.DY		EQU	$D2	;DELTA-Y FOR HLIN, SHAPE.QDRNT		EQU	$D3	;ROT QUADRANT (SHAPE).EL		EQU	$D4	;ERROR FOR HLIN.EH		EQU	$D5X0L		EQU	$E0	;PRIOR X-COORD SAVEX0H		EQU	$E1	;AFTER HLIN OR HPLOT.Y0		EQU	$E2	;HLIN, HPLOT Y-COORD SAVE.HCOLOR		EQU	$E4	;COLOR FOR HPLOT, HPOSNHNDX		EQU	$E5	;HORIZ OFFSET SAVE.HPAG		EQU	$E6	;HI-RES PAGE ($20 NORMAL)SCALE		EQU	$E7	;SCALE FOR SHAPE, MOVE.SHAPXL		EQU	$E8	;START OFSHAPXH		EQU	$E9	;SHAPE TABLE.COLLSN		EQU	$EA	;COLLISION COUNT.ROTBYT		EQU	$F9	;HOLD ROTATION FACTOR >>>UNDOCUMENTED ZPG BYTE<<<SHSTRT		EQU	$C00	;START OF SHAPE TABLE.HIRES		EQU	$C057	;SWITCH TO HI-RES VIDEOMIXSET		EQU	$C053	;SELECT TEXT/GRAPHICS TXTCLR		EQU	$C050	;SELECT GRAPHICS MODE.ACADR		EQU	$F11E	;2-BYTE TAPE READ SETUP.	IF A2E+LOLLY+CORTLAND <> 0 THEN		;Do for enhanced //e and //c		ELSERD2BIT		EQU	$FCFA	;TWO-EDGE TAPE SENSE.READX1		EQU	$FF02	;READ WITHOUT HEADER.	ENDIFLOPAGE		EQU	$C054	;FOR PRIMARY PAGE.HIPAGE		EQU	$C055	;FOR SECONDARY PAGE.FULSET		EQU	$C052	;WHOLE SCREEN GRAPHICS		EJECT		TITLE	'HIGH RESOLUTION GRAPHICS INITS'** MICROSOFT VERSION*SETHRH:		BIT	HIPAGE	;DISPLAY SECOND PAGE.		BIT	FULSET		LDA	#$40		BNE	SET	;ALWAYS TAKEN.SETHRL		LDA	#$20	;INIT FOR $2000-3FFF		BIT	LOPAGE		BIT	MIXSETSET:		STA	HPAG	;HI-RES SCREEN MEMORY.		LDA	HIRES	;SET HIRES DISPLAY MODE		LDA	TXTCLR	;SET GRAPHICS DISPLAYHCLR		LDA	#$0BKGNDO		STA	HCOLOR1	;SET FOR BLACK BKGND.BKGND		LDA	HPAG		STA	SHAPEH	;INIT HI-RES SCREEN MEM		LDY	#$0	;FOR CURRENT PAGE, NORMALLY		STY	SHAPEL	;$2000-3FFF OR $4000-5FFFBKGND1		LDA	HCOLOR1		STA	(SHAPEL),Y		JSR	CSHFT2	;(SHAPEL,H) WILL SPECIFY		INY		;32 SEPARATE PAGES.		BNE	BKGND1	;THROUGHOUT THE INIT.		INC	SHAPEH		LDA	SHAPEH		AND	#$1F	;TEST FOR DONE.		BNE	BKGND1		RTS		EJECT		TITLE	'HI-RES POSITION AND PLOT'HPOSN		STA	Y0	;ENTER WITH Y IN A-REG,		STX	X0L	;XL IN X-REG,		STY	X0H	;AND XH IN Y-REG.		PHA		AND	#$C0		STA	HBASL	;FOR Y-COORD = OOABCDEF. 		LSR	A	;CALCULATES BASE ADDRESS.		LSR	A	;IN HBASL, HBASH FOR		ORA	HBASL	;ACCESSING SCREEN MEM		STA	HBASL	;VIA (HBASL),Y ADDRESSING MODE		PLA		STA	HBASH		ASL	A	;CALCULATES		ASL	A	;HBASH = PPPFGHCD,		ASL	A	;HBASL = EABAB000		ROL	HBASH		ASL	A	;WHERE PPP=001 FOR $2000.3FFF		ROL	HBASH	;SCREEN MEM RANGE AND		ASL	A	;PPP=010 FOR $4000-7FFF		ROR	HBASL	;(GIVEN Y-COORD=ABCDEFGH)		LDA	HBASH		AND	#$1F		ORA	HPAG		STA	HBASH		TXA		;DIVIDE X0 BY 7 FOR		CPY	#$0	;INDEX FROM BASE ADR		BEQ	HPOSN2	;(QUOTIENT) AND BIT		LDY	#$23	;WITHIN SCREEN MEM B		ADC	#$4	;(MASK SPEC'D BY REMAINDER) HPOSN1		INYHPOSN2		SBC	#$7	;SUBTRACT OUT SEVENS.		BCS	HPOSN1		STY	HNDX	;WORKS FOR XO FROM		TAX		;0 TO 279, LOW-ORDER		LDA	MSKTBL-$F9,X	;BYTE IN X-REG,		STA	HMASK	;HIGH IN Y-REG ON ENTRY		TYA		LSR	A	;IF ON ODD BYTE (CARRY		LDA	HCOLOR	;THEN ROTATE HCOLORHPOSN3		STA	HCOLOR1	;BIT FOR 180 DEGREE		BCS	CSHFT2	;PRIOR TO COPYING TO		RTSHPLOT		JSR	HPOSNHPLOT1		LDA	HCOLOR1	;CALC BIT POSN IN HBAS		EOR	(HBASL),Y	;HNDX, AND HMASK FROM		AND	HMASK	;Y-COORD IN A-REG,		EOR	(HBASL),Y	;X-COORD IN X,Y-REGS.		STA	(HBASL),Y	;FOR ANY 'L' BITS OF H		RTS		;SUBSTITUTE CORRESPONDING * BIT OF HCOLOR1.		EJECT		TITLE	'HI-RES GRAPHICS L,R,U,D SUBRS'LFTRT		BPL	RIGHT	;USE SIGN FOR LFT/RT SLEFT		LDA	HMASK		LSR	A	;SHIFT LOW-ORDER		BCS	LEFT1	;7 BITS OF HMASK		EOR	#$C0	;ONE BIT TO LSB.LR1		STA	HMASK		RTSLEFT1		DEY		;DECR HORIZ INDEX.		BPL	LEFT2		LDY	#$27	;WRAP AROUND SCREEN.LEFT2		LDA	#$C0	;NEW HMASK, RIGHTMOSTNEWNDX		STA	HMASK	;DOT OF BYTE.		STY	HNDX	;UPDATE HORIZ INDEX.CSHIFT		LDA	HCOLOR1CSHFT2		ASL	A	;ROTATE LOW-ORDER		CMP	#$C0	;7 BITS OF HCOLOR1		BPL	RTS1	;ONE BIT POSN.		LDA	HCOLOR1		EOR	#$7F	;ZXYXYXYX -> ZYXYXYXY		STA	HCOLOR1RTS1		RTSRIGHT		LDA	HMASK		ASL	A	;SHIFT LOW-ORDER		EOR	#$80	;7 BITS OF HMASK		BMI	LR1	;ONE BIT TO MSB.		LDA	#$81		INY		;NEXT BYTE.		CPY	#$28		BCC	NEWNDX		LDY	#$0	;WRAP AROUND SCREEN IF		BCS	NEWNDX	;ALWAYS TAKEN.		EJECT		TITLE	'L,R,U,D, SUBROUTINES.'LRUDX1		CLC		;NO 90 DEG ROT (X-OR).LRUDX2		LDA	SHAPEX		AND	#$4	;IF B2=0 THEN NO PLOT.		BEQ	LRUD4		LDA	#$7F	;FOR EX-OR INTO SCREEN		AND	HMASK		AND	(HBASL),Y	;SCREEN BIT SET?		BNE	LRUD3		INC	COLLSN		LDA	#$7F		AND	HMASK		BPL	LRUD3	;ALWAYS TAKEN.LRUD1		CLC		;NO 90 DEG ROT.LRUD2		LDA	SHAPEX		AND	#$4	;IF B2=0 THEN NO PLOT.		BEQ	LRUD4		LDA	(HBASL),Y		EOR	HCOLOR1	;SET HI-RES SCREEN BIT		AND	HMASK	;TO CORRESPONDING HC		BNE	LRUD3	;IF BIT OF SCREEN CHAN		INC	COLLSN	;THEN INCR COLLSN DELRUD3		EOR	(HBASL),Y		STA	(HBASL),YLRUD4		LDA	SHAPEX	;ADD QDRNT TO		ADC	QDRNT	;SPECIFIED VECTOR		AND	#$3	;AND MOVE LFT, RT,EQ3		EQU	*-1	;UP, OR DWN BASED		CMP	#$2	;ON SIGN AND CARRY.		ROR	ALRUD		BCS	LFTRTUPDWN		BMI	DOWN4	;SIGN FOR UP/DWN SELECTUP		CLC		LDA	HBASH	;CALC BASE ADDRESS		BIT	EQ1C	;(ADR OF LEFTMOST BYTE)		BNE	UP4	;FOR NEXT LINE UP		ASL	HBASL	;IN (HBASL, HBASH)		BCS	UP2	;WITH 192-LINE WRAPA		BIT	EQ3		BEQ	UP1		ADC	#$1F	;**** BIT MAP ****		SEC		BCS	UP3	;FOR ROW = ABCDEFGH,UP1		ADC	#$23		PHA		LDA	HBASL	;HBASL = EABABOOO		ADC	#$B0	;HBASH = PPPFGHCD		BCS	UP5		ADC	#$F0	;WHERE PPP=001 FOR PRIMARYUP5		STA	HBASL	;HI-RES PAGE ($2000-		PLA		BCS	UP3UP2		ADC	#$1FUP3		ROR	HBASLUP4		ADC	#$FCUPDWN1		STA	HBASH		RTSDOWN		CLCDOWN4		LDA	HBASH		ADC	#$4	;CALC BASE ADR FOR NEXEQ4		EQU	*-1	;DOWN TO (HBASL,HBAS		BIT	EQ1C		BNE	UPDWN1		ASL	HBASL	;WITH 192-LINE WRAPA		BCC	DOWN1		ADC	#$E0		CLC		BIT	EQ4		BEQ	DOWN2		LDA	HBASL		ADC	#$50		EOR	#$F0		BEQ	DOWN3		EOR	#$F0DOWN3		STA	HBASL		LDA	HPAG		BCC	DOWN2DOWN1		ADC	#$E0DOWN2		ROR	HBASL		BCC	UPDWN1		EJECT		TITLE	'HI-RES GRAPHICS LINE DRAW SUBRS'HLINRL		PHA		LDA	#$0	;SET (X0L,X0H) AND		STA	X0L	;Y0 TO ZERO FOR		STA	X0H	;REL LINE DRAW		STA	Y0	;(DX, DY).		PLAHILIN		PHA		;ON ENTRY		SEC		;XL: A-REG		SBC	X0L	;XH; X-REG		PHA		;Y: Y-REG		TXA		SBC	X0H		STA	QDRNT	;CALC ABS(X-XO)		BCS	HLIN2	;IN (DXL,DXH)		PLA		EOR	#$FF	;X DIR TO SIGN BIT		ADC	#$1	;OF QDRNT.		PHA		;0=RIGHT (DX POS)		LDA	#$0	;1=LEFT (DX NEG)		SBC	QDRNTHLIN2		STA	DXH		STA	EH	;INIT (EL,EH) TO		PLA		;ABS(X-X0)		STA	DXL		STA	EL		PLA		STA	X0L		STX	X0H		TYA		CLC		SBC	Y0	;CALC -ABS(Y-O)-1		BCC	HLIN3	;IN DY.		EOR	#$FF		ADC	#$FEHLIN3		STA	DY	;ROTATE Y DIR INTO		STY	Y0	;QDRNT SIGN BIT		ROR	QDRNT	;(0=UP, 1=DOWN)		SEC		SBC	DXL	;INIT (COUNTL, COUNTH).		TAX		;TO -(DELTX+DELTY+1)		LDA	#$FF		SBC	DXH		STA	COUNTH		LDY	HNDX	;HORIZ INDEX		BCS	MOVEX2	;ALWAYS TAKEN.MOVEX		ASL	A	;MOVE IN X-DIR. USE		JSR	LFTRT	;QDRNT B6 FOR LFT/RT		SECMOVEX2		LDA	EL	;ASSUME CARRY SET.		ADC	DY	;(EL,EH)-DELTY TO (EL,		STA	EL	;NOTE: DY IS (-DELTY)-1		LDA	EH	;CARRY CLR IF (EL,EH)		SBC	#$0	;GOES NEG.HCOUNT		STA	EH		LDA	(HBASL),Y	;SCREEN BYTE.		EOR	HCOLOR1	;PLOT DOT OF HCOLOR1.		AND	HMASK	;CURRENT BIT MASK.		EOR	(HBASL),Y		STA	(HBASL),Y		INX		;DONE (DELTX+DELTY)		BNE	HLIN4	;DOTS?		INC	COUNTH		BEQ	RTS2	;YES, RETURN.HLIN4		LDA	QDRNT	;FOR DIRECTION TEST		BCS	MOVEX	;IF CAR SET, (EL, EH) P		JSR	UPDWN	;IF CLR, NEG, MOVE Y		CLC		LDA	EL	;(EL,EH)+DELTX		ADC	DXL	;TO (EL,EH).		STA	EL		LDA	EH	;CAR SET IF (EL,EH) GO		ADC	DXH		BVC	HCOUNT	;ALWAYS TAKEN.MSKTBL		DC.B	$81	;LEFTMOST BIT OF BYTE.		DC.B	$82,$84,$88		DC.B	$90,$A0		DC.B	$C0	;RIGHTMOST BIT OF BYTE.EQ1C		DC.B	$1CCOSTABL		DC.B	$FF,$FE,$FA,$F4		DC.B	$EC,$E1,$D4,$C5		DC.B	$B4		DC.B	$A1,$8D,$78,$61		DC.B	$49,$31,$18,$FF		EJECT		TITLE	'HI-RES GRAPHICS COORD RESTORE'HFIND		LDA	HBASL		ASL	A	;CONVERTS BASE ADR		LDA	HBASH	;TO Y-COORD.		AND	#$3		ROL	A	;FOR HBASL = EABABOOO		ORA	HBASL	;HBASH = PPPFGHCD		ASL	A		ASL	A	;GENERATE		ASL	A	;Y-COORD = ABCDEFGH		STA	Y0		LDA	HBASH	;(PPP=SCREEN PAFE,		LSR	A	;NORMALLY 001 FOR		LSR	A	;$2000-$3FFF		AND	#$7	;HI-RES SCREEN)		ORA	Y0		STA	Y0	;CONVERTS HNDX (INDEX		LDA	HNDX	;FROM BASE ADR)		ASL	A	;AND HMASK (BIT		ADC	HNDX	;MASK) TO X-COORD		ASL	A	;IN (XOL,XOH)		TAX		;(RANGE $0-$133)		DEX		LDA	HMASK		AND	#$7FHFIND1		INX		LSR	A		BNE	HFIND1		STA	X0H		TXA		CLC		;CALC HNDX*7 +		ADC	HNDX	;LOG (BASE 2) HMASK.		BCC	HFIND2		INC	X0HHFIND2		STA	X0LRTS2		RTS		EJECT		TITLE	'HI-RES GRAPHICS SHAPE DRAW SUBR'** SHAPE DRAW* R = O TO 63* SCALE FACTOR USED (1=NORMAL)*DRAW		STX	SHAPEL	;DRAW DEFINITION		STY	SHAPEH	;POINTER.DRAW1		TAX		LSR	A	;ROT ($0-$3F)		LSR	A		LSR	A	;QDRNT 0=UP, 1=RT,		LSR	A	;2=DWN, 3=LFT.		STA	QDRNT		TXA		AND	#$F		TAX		LDY	COSTABL,X	;SAVE COS AND SIN		STY	DXL	;VALS IN DXL AND DY.		EOR	#$F		TAX		LDY	COSTABL+1,X		INY		STY	DYDRAW2		LDY	HNDX	;BYTE INDEX FROM		LDX	#$0	;HI-RES BASE ADR.		STX	COLLSN	;CLEAR COLLISION COUNT.		LDA	(SHAPEL,X)	;1ST SHAPE DEF BYTE.DRAW3		STA	SHAPEX		LDX	#$80		STX	EL	;EL,EH FOR FRACTIONAL		STX	EH	;L,R,U,D VECTORS.		LDX	SCALE	;SCALE FACTOR.DRAW4		LDA	EL		SEC		;IF FRAC COS OVFL		ADC	DXL	;THEN MOVE IN		STA	EL	;SPECIFIED VECTOR		BCC	DRAW5	;DIRECTION.		JSR	LRUD1		CLCDRAW5		LDA	EH	;IF FRAC SIN OVFL		ADC	DY	;THEN MOVE IN		STA	EH	;SPECIFIED VECTOR		BCC	DRAW6	;DIRECTION +90 DEG.		JSR	LRUD2DRAW6		DEX		;LOOP ON SCALE		BNE	DRAW4	;FACTOR.		LDA	SHAPEX		LSR	A	;NEXT 3-BIT VECTOR		LSR	A	;OF SHAPE DEF.		LSR	A		BNE	DRAW3	;NOT DONE THIS BYTE.		INC	SHAPEL		BNE	DRAW7	;NEXT BYTE OF		INC	SHAPEH	;SHAPE DEFINITION.DRAW7		LDA	(SHAPEL,X)		BNE	DRAW3	;DONE IF ZERO.		RTS		EJECT		TITLE	'HI-RES GRAPHICS SHAPE EX-OR SUBR'** EX-OR SHAPE INTO SCREEN. ** ROT = 0 TO 3 (QUADRANT ONLY)* SCALE IS USED*XDRAW		STX	SHAPEL	;SHAPE DEFINITION		STY	SHAPEH	;POINTER.XDRAW1		TAX		LSR	A	;ROT ($0-$3F)		LSR	A		LSR	A	;QDRNT 0=UP, 1=RT,		LSR	A	;2=DWN, 3=LFT.		STA	QDRNT		TXA		AND	#$F		TAX		LDY	COSTABL,X	;SAVE COS AND SIN		STY	DXL	;VALS IN DXL AND DY,		EOR	#$F		TAX		LDY	COSTABL+1,X		INY		STY	DYXDRAW2		LDY	HNDX	;INDEX FROM HI-RES		LDX	#$0	;BASE ADR.		STX	COLLSN	;CLEAR COLLISION DETECT		LDA	(SHAPEL,X)	;1ST SHAPE DEF BYTE.XDRAW3		STA	SHAPEX		LDX	#$80		STX	EL	;EL,EH FOR FRACTIONAL 		STX	EH	;L,R,U,D, VECTORS.		LDX	SCALE	;SCALE FACTOR.XDRAW4		LDA	EL		SEC		;IF FRAC COS OVFL		ADC	DXL	;THEN MOVE IN		STA	EL	;SPECIFIED VECTOR		BCC	XDRAW5	;DIRECTION		JSR	LRUDX1		CLCXDRAW5		LDA	EH	;IF FRAC SIN OVFL		ADC	DY	;THEN MOVE IN		STA	EH	;SPECIFIED VECTOR		BCC	XDRAW6	;DIRECTION +90 DEG.		JSR	LRUDX2XDRAW6		DEX		;LOOP ON SCALE		BNE	XDRAW4	;FACTOR.		LDA	SHAPEX		LSR	A	;NEXT 3-BIT VECTOR		LSR	A	;OF SHAPE DEF.		LSR	A		BNE	XDRAW3		INC	SHAPEL		BNE	XDRAW7	;NEXT BYTE OF		INC	SHAPEH	;SHAPE DEF.XDRAW7		LDA	(SHAPEL,X)		BNE	XDRAW3	;DONE IF ZERO.		RTSHFNS:		JSR	FRMNUM	;GET X-ARG		JSR	GETADR		LDY	POKER+1		LDX	POKER		CPY	#1	;X<280		BCC	HOK	;IF LESS THAN 256, FINE		BNE	HTOOBIG		CPX	#24		BCS	HTOOBIGHOK:		TXA		;SAVE COORDS.		PHA		TYA		PHA		LDA	#$2C	;COMMA MUST SEPERATE ARGS.		JSR	SYNCHR		JSR	GETBYT	;GET Y-ARG.		CPX	#192		BCS	HTOOBIG		STX	FAC	;ALL REGS. CORRECT		PLA		TAY		PLA		TAX		LDA	FAC		RTSHTOOBIG:		JMP	TOOBIG	;ERROR.SETHCOL:		JSR	GETBYT		CPX	#8	;COLOR=0 TO 7		BCS	HTOOBIG	;BLOW UP!		LDA	COLRTAB,X		STA	HCOLORMINERTS:		RTSCOLRTAB:		DC.B	0,42,85,127		DC.B	128,170,213,255LINE:		CMP	#TOTK	;LINE TO X,Y?		BEQ	LINETO		JSR	HFNS		JSR	HPLOTLINEAGAIN:	JSR	CHRGOT	;IS IT FOR A LINE?		CMP	#TOTK		BNE	MINERTSLINETO:		JSR	SYNCHR		JSR	HFNS		STY	FAC	;REARRANGE REGISTERS FOR LINE DRAW		TAY		TXA		LDX	FAC		JSR	HILIN	;GO THROUGH WOZ'S ROUTINE		JMP	LINEAGAIN	;CHECK FOR AN EXTRA 'TO'SETROT:		JSR	GETBYT	;SET HI-RES ROTATION		STX	ROTBYT		RTSSETSCALE:		JSR	GETBYT		STX	SCALESCALRTS:		RTSPREDRAW:		JSR	GETBYT	;GET SHAPE# INTO X		LDA	SHAPXL	;PRSERVE SHAPE POINTER		STA	SHAPEL		LDA	SHAPXH		STA	SHAPEH		TXA		;ACC=SHAPE NUMBER		LDX	#0	;ZERO INDEX		CMP	(SHAPEL,X)		BEQ	DRAWOK		IF LOLLY <> 0 THENXBND3		EQU	*		ENDIF		BCS	HTOOBIGDRAWOK:		ASL	A	;SHAPE # *2		BCC	PREDRAW2	;IF OVEFLOW		INC	SHAPEH		CLCPREDRAW2:		TAY		;INDX INTO TABLE		LDA	(SHAPEL),Y		ADC	SHAPEL	;RELATIVE TABLE.		TAX		;PRESERVE		INY		;ADD 2-BYTE INDEX TO SHAPE		LDA	(SHAPEL),Y	;START ADDRESS		ADC	SHAPXH		STA	SHAPEH		STX	SHAPEL		JSR	CHRGOT	;OPTIONALLY FOLLOWED BY X,Y ARGS.		CMP	#ATTKN	;IS IT THERE?		BNE	SHFINI	;IF NOT, FINISH UP.		JSR	SYNCHR		JSR	HFNS		JSR	HPOSN	;POSITION TO X,YSHFINI:		LDA	ROTBYT		RTSDODRAW:		JSR	PREDRAW	;SET UP,		JMP	DRAW1	;THEN DRAW IT.DOXDRAW:		JSR	PREDRAW		JMP	XDRAW1		IF LOLLY <> 0 THENXBOUND		JSR	VIDSTATE	;DETERMINE IF DOUBLE GR		BCS	XBND2		CPY	#40		BCS	XBND3* IF LESS THAN 40 THEN SURELY LESS THAN 80 XBND2		CPY	#80		BCS	XBND3		RTSVLINXX		PHA		LDA	V2		CMP	#48		PLA		BCS	XBND3VLINE		PHA		JSR	PLOTDO		PLA		CMP	V2		INC	A		BCC	VLINERTSQQ		RTS*HLINE		TXA		LDY	FIRST		JSR	PLOTDOHLINE1		CPY	H2		BCS	RTSQQ	;BRANCH IF DONE WITH PLOT		INY		JSR	PLOT1		BRA	HLINE1	;BRANCH ALWAYS TAKENRDSCRN		EQU	*		PHA		JSR	VIDSETY	;ADJUST Y AS NECESSARY, CARRY SET=PG2GR 		PLA		PHP		JSR	$F871	;ROM RDSCRN		PLP		BCC	RDSCRN41		STA	$C054		CMP	#8		ASL	A	;EFFECTIVE 4 BIT ROTATE LEFT 		AND	#$F	; FOR ALT MEM COLORSRDSCRN41		EQU	*		RTS*VIDSETY		JSR	VIDSTATE	;TEST 40/80 GRAFIX		BCC	XQXRTS		TYA		EOR	#1		LSR	A		TAY		BCC	XQXRTS		LDA	$C055XQXRTS		RTS*TABER2		TXA		;CALC SPACES TO NEXT COMMA		BIT	$C01F	; TAB POSITION IN EITHER 40 OR 80 COLUMNS		BMI	TABER3		DC.B	$2C	;SKIP THE NEXT 2 BYTESHTAB3		STA	$24		SEC		TXA		SBC	$24HTDONE		RTSGETARYPT		LDA	#$40		STA	SUBFLG		JSR	PTRGET		STZ	SUBFLG		RTS*TABER3		SBC	$57B		RTS*HTAB:		JSR	GETBYT	;GET ARG OF STATEMENT		DEXHTAB1:		LDA	#40		CMP	$21		BCS	HTAB2		LDA	$21HTAB2:		JSR	HTAB3		STX	$24		BCC	HTDONE		TAX		JSR	CRDO		BRA	HTAB1		ELSE		ENDIF		IF A2E <> 0 THENINTCXROM		EQU	$C007EXTCXROM		EQU	$C006SHLOAD		SEC		DC.B	$90	;SKIP 1 BYTE (BCC OPCODE) DOPTRS		CLC		STA	INTCXROM		JSR	SHLOAD1		STA	EXTCXROM		BCS	SHLERR		RTSSHLERR		JMP	OMERR*UPSHFT1		LDA	BUFOFS+1,X		BPL	UPSHFT4	;BRANCH ALWAYS*UPSHFT2		LDA	ENDCHR	;TESTS FOR NO UPSHIFT DESIRED		BEQ	NOSHFT		CMP	#$22	;INSIDE A QUOTED STRING?		BEQ	NOSHFT		LDA	DORES	;TEST FOR DATA STATEMENT		CMP	#$49		BEQ	NOSHFT	;BRANCH IF DATA*UPSHFT3		LDA	BUFOFS,X	;GET CHARACTER FROM INPUT BUFFER*UPSHFT4		PHP		;SAVE STATUS		CMP	#$61	;IS IT LOWER CASE?		BCC	UPSHFT5		AND	#$5F	;MAKE IT UPPER CASE!*UPSHFT5		PLP		;RESTORE STATUS		RTS*NOSHFT		LDA	BUFOFS,X	;RETURN ORIGINAL STUFF		RTS*LDSPCE		PHA		;SAVE ACC 		LDA	#$20	;OUTPUT A SPACE CHARACTER IN FRONT OF LINE NUMBER		JSR	OUTDO		PLA		JMP	LINPRT	;NOW OUTPUT LINE # *LSTFMAT		LDA	$24		CMP	#33	;REGULAR WIDTH		BIT	$C01F		BPL	FMAT40		LDA	$57B	;IF 80-COL ENABLED, COMPARE WITH 73		CMP	#73FMAT40		RTS**TABER2		TXA		;CALC SPACES TO NEXT COMMA		BIT	$C01F	; TAB POSITION IN EITHER 40 OR 80 COLUMNS		BMI	TABER3		DC.B	$2C	;SKIP THE NEXT 2 BYTESHTAB3		STA	$24		SEC		TXA		SBC	$24HTDONE		RTS*TABER3		SBC	$57B		RTS*FILL_SIZE03	EQU	APPLESOFT-$27D9-*	IF FILL_SIZE03 > 0	THEN		DS.B	FILL_SIZE03,0	ENDIFGETARYPT		LDA	#$40		STA	SUBFLG		JSR	PTRGET		LDA	#0		STA	SUBFLG		JMP	VARTIO**HTAB:		JSR	GETBYT	;GET ARG OF STATEMENT		DEXHTAB1:		LDA	#40		CMP	$21		BCS	HTAB2		LDA	$21HTAB2:		JSR	HTAB3		STX	$24		BCC	HTDONE		TAX		JSR	CRDO		BNE	HTAB1	;BRANCH ALWAYS TAKEN 		ELSE		ENDIF		IF A2E+LOLLY+CORTLAND <> 0 THEN		ELSESHLOAD:		LDA	#0		STA	A1H	;READ LENGTH INTO		STA	A2H	;POKER		LDY	#POKER		STY	A1L		INY		;AND POKER+1		STY	A2L		JSR	C.CSIN	;GET TABLE LENGTH IN POKER		CLC		;PREP FOR SUBTRACT(MEMSIZ-LEN-1)		LDA	MEMSIZ	;PUT TABLE AT END OF MEMORY		TAX		;-1 FROM MEMSIZ.		DEX		STX	A2L		SBC	POKER		PHA		LDA	MEMSIZ+1		TAY		INX		BNE	*+3		DEY		STY	A2H		SBC	POKER+1		CMP	STREND+1		BCC	MFULL		BNE	*+5	;ENOUGH ROOM FOR TABLE?MFULL:		JMP	OMERR		STA	MEMSIZ+1		STA	FRETOP+1		STA	A1H		STA	SHAPXH		PLA		STA	SHAPXL		STA	MEMSIZ		STA	FRETOP	;END OF STRING SPACE.		STA	A1L		JSR	RD2BIT	;NOW GET IT FINALLY.		LDA	#3		JMP	READX1DOPTRS:		CLC		LDA	LOWTR	;CALCULATE END POSITION		ADC	POKER		STA	A2L	;INTO CASSETTE POINTERS		LDA	LOWTR+1		ADC	POKER+1		STA	A2H		LDY	#4	;CALC. BEGIN POSITION		LDA	(LOWTR),Y	;GET # OF DIMENSIONS.		JSR	FMAPTR+2		LDA	ARYPNT		STA	A1L	;INTO (A1)		LDA	ARYPNT+1		STA	A1H		RTS;; THIS ROUTINE FAKES OUT PTRGET INTO FINDING ME AN; ARRAY BY ONLY IT'S NAME.;GETARYPT:		LDA	#$40	;MAKE SURE BIT 6 SET.		STA	SUBFLG		JSR	PTRGET	;GO FIND ARRAY.		LDA	#$00	;MAKE NORMAL FOR NEXT TIME		STA	SUBFLG	;TO ALLOW SUBSCRIPTING!		JMP	VARTIOHTAB:		JSR	GETBYT	;GET ARG OF STATEMENT		DEX		TXAHTAB1:		CMP	#40		BCC	HTDONE		SBC	#40		PHA		JSR	CRDO		PLA		JMP	HTAB1HTDONE:		STA	$24	;CURSOR HORIZONTAL.		RTS		MSB	ON		DC.B	'KR'	;Matches ROM Junk		MSB	OFF		DC.B	$78	;Matches ROM junk		ENDIF		ENDP		END