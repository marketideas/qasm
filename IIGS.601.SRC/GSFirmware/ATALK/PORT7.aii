		TITLE	'C700 Space';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/15/91 at 8:28:4 PM**		PRINT	NOGEN		MACHINE	M65816		LONGA	OFF		LONGI	OFF*		INCLUDE	'::Monitor:Monitor.macros.aii'*VERSION		EQU	$1020	;Same as serial codePASSIG		EQU	$01DEVSIG		EQU	$31SLOT		EQU	$C7ID		EQU	$0IERRORCODE	EQU	$FF*XQSETUP		EQU	$FF0000XQPASCAL		EQU	$FF0003*SERBASPATCH	EQU	$E1020CSERPASPATCH	EQU	$E10210SEREXTPATCH	EQU	$E10214*ASEXT		EQU	$E11000ASBAS		EQU	$E11004ASPAS		EQU	$E11008RAMDISPATCH	EQU	$E11014RAMFORBID		EQU	$E11018RAMPERMIT		EQU	$E1101CPRODOS		EQU	$E11022PROENTRY		EQU	$E11020*MBIT		EQU	$20XBIT		EQU	$10EXECADDR		EQU	$84*STATEREG		EQU	$C068CYAREG		EQU	$C036**Bnk~Org		EQU	$C700		SEG	'C7SEG'C7XXCODE		PROC	ORG $C700**Rel~Org:				FillTo	$C796C7XXSEG		EQU	*		JSL	>ramforbid		RTS		JSL	>rampermit		RTS*C7XX		EQU	*		XCE		PEI	execaddr+1		PLB		PLBC7XXGO		EQU	*		JML	[execaddr]C7XXRET		EQU	*		CLC		XCE		RTL**C7ERROR		EQU	*		LDX	#ierrorcode		RTLC7PRODOS		EQU	*		CLC		XCE		JSL	>prodos		PHP		SEC		XCE		PLP		BVC	noerr1		LDA	proentry+1		PHA		LDA	proentry		PHANOERR1		EQU	*		RTS**		FillTo	$C7D8*QSETVECTOR1	EQU	*		JMP	>xqsetupQPASVECTOR1	EQU	*		JMP	>xqpascal**		FillTo	$C7F9		DC.B	'ATLK'	;Signature for a network card		DC.B	ID		DC.W	VERSION**		ENDP** AppleShare Patch**  The older GS roms had an AppleTalk routine in bank $FF which*   'initialized' AppleTalk.  The AppleTalk code is no longer in*   the same place... This jump supports calls to that old routine,*   jumping off into the real AppleTalk code in bank $FE.*		SEG	'ATSEG'ATPATCH		PROC	ORG $FF1C06		JMP	>$FE000C		ENDP		END