		TITLE	'Write prep routine';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d8 on 5/16/91 at 9:23:56 PM*********************************************************** * Writerprep: This routine will the users data, split it into three*             segments and generate the checksum.  Once the data has*             been split the fourth byte of the checksum is generated,*             then the first three data bytes are nibblized.  The *             nibblizing of the data bytes creates a fourth byte which*             contains the upper two bits from each of the data bytes.*             This fourth byte will be kept in the upper half to the*             accumulator.**     Import: [cmdbuffl] = pointer to users data buffer*             Y = number of groups of three bytes to move.*                 The Y register is set up in the routine for the*                 protocol converter write call routine.*                 Y = 171 for Apple //e blocks*                 Y = 175 for Macintosh blocks**     Export: Cbyte0 = 1st nibblized data byte*             Cbyte1 = 2nd nibblized data byte*             Cbyte2 = 3rd nibblized data byte*            B accum = extra bits from first three data bytes.**********************************************************WRITEPREP		EQU	*	;		LONGI	ON		;		REP	#$10	;		STZ	csuma		STZ	csumb		STZ	csumc		BRA	wp4*WPTOP		EQU	*		LDA	[cmdbuffl],y		ADC	csumc		STA	csumc		LDA	[cmdbuffl],y		EOR	csumb		STA	buf3+1,x		INY*WP4		EQU	*		ASL	csumc		BCC	wp1		INC	csumcWP1		EQU	*		LDA	[cmdbuffl],y		ADC	csuma		STA	csuma		LDA	[cmdbuffl],y		EOR	csumc		STA	buf1,x		INY*WP2		EQU	*		LDA	[cmdbuffl],y		ADC	csumb		STA	csumb		LDA	[cmdbuffl],y		EOR	csuma		STA	buf2,x		INY*WP3		EQU	*		DEX		BNE	wptop		LONGI	OFF		;		SEP	#$10	;** And also figure the 'fourth' checksum byte*		LDA	csumc	;CCCCCCCC		LSR	a	;0CCCCCCC		LSR	a	;00CCCCCC		EOR	csumb	;00CCCCCC+BBBBBBBB		AND	#%00111111		EOR	csumb	;BBCCCCCC		LSR	a	;0BBCCCCC		LSR	a	;00BBCCCC		EOR	csuma		AND	#%00111111		EOR	csuma	;AABBCCCC		LSR	a	;0AABBCCC		LSR	a	;00AABBCC		STA	wcsum** Okay, now prime the write pump with the first three data Cbytes.*		LDA	#$00	; clear upper half of accumulator		XBA		;		LDA	buf1+175		STA	Cbyte1		REP	#$20	; 16 bit accmulator		ASL	A	;		ASL	A	;		SEP	#$20	; 8 bit accumulator*		LDA	buf2+175		STA	Cbyte2		REP	#$20	; 16 bit accmulator		ASL	A	;		ASL	A	;		SEP	#$20	; 8 bit accumulator*		LDA	buf3+175		STA	Cbyte3		REP	#$20	; 16 bit accmulator		ASL	A	;		ASL	A	;		SEP	#$20	; 8 bit accumulator		RTS		TITLE	'Write Routines'***********************************************************************	General Write Data Field Routine* *  Selects between MFM and GCR Write Routines**********************************************************************WRITEDATA		EQU	*		BIT	MFMflag		;mfm Write		BPL	@GCR		JMP	mfmWriteData@GCR		JMP	WriteDataHook** Okay, into write mode and write sync bytes*WriteData~GCR	BIT	l6set	;Write prep		LDA	#$FF	;First sync byte		STA	l7set*		LDY	#7WD00		LDA	datamarks,yWD0		BIT	l6clr	;Wait for buffer ready		BPL	wd0		STA	l6set		DEY		BPL	wd00*		LDX	sectfnd	;Send sector number		LDA	>nibtab,x		ORA	#$80SNDB1		BIT	l6clr		BPL	sndb1		STA	l6set** Okay, start sending the data.*		LDY	#174	;Write 174*3+2 nibbles		BRA	wdb*WDC		EQU	*		LDX	Cbyte3		LDA	buf3+1,y		STA	Cbyte3		REP	#$20	; 16 bit accmulator		ASL	A	;		ASL	A	;		SEP	#$20	; 8 bit accumulator		LDA	>nibtab,x	; kill timeWDL		BIT	l6clr	; wait for IWM ready		BPL	wdl	;		STA	l6set	;Output previous Cbyte 3*WDB		EQU	*		XBA		;		TAX		; get extra bits		LDA	>nibtab,x	;NibblizeWDA		BIT	l6clr		BPL	wda		STA	l6set*		LDX	Cbyte1		LDA	buf1,y		STA	Cbyte1		REP	#$20	; 16 bit accmulator		ASL	A	;		ASL	A	;		SEP	#$20	; 8 bit accumulator		LDA	>nibtab,xWDM		BIT	l6clr	; wait for IWM ready		BPL	wdm	;		STA	l6set	;Send previous byte 1*		LDX	Cbyte2		LDA	buf2,y		STA	Cbyte2		REP	#$20	; 16 bit accmulator		ASL	A	;		ASL	A	;		SEP	#$20	; 8 bit accumulator		LDA	>nibtab,xWDK		BIT	l6clr	; wait for buffer empty		BPL	wdk	;		STA	l6set*		DEY		CPY	#$FF		BNE	wdc** Now send the checksum as four encoded nibbles*		LDY	#3WDG		EQU	*		TYX		; form index		LDA	csumc,x		AND	#$3F		TAX		LDA	>nibtab,xWDD		BIT	l6clr		BPL	wdd		STA	l6set		DEY		BPL	wdg** Now send the data bitslip marks*		LDY	#2WDF		LDA	bsmarks,yWDE		BIT	l6clr		BPL	wde		STA	l6set		DEY		BPL	wdf** Wait til write underrun*WDH		BIT	l6clr		BVS	wdh		BIT	l7clr	;Back into read mode		RTS************************************************************************ mfmWriteData***********************************************************************mfmWriteData	EQU	*; first insure that the Index/Tach adrs is not the lingering phase line setting; to prevent the Index Pulse cross talk problem		LDA	#%11110101	;CA [3210] = 0101		STA	IsmPhaseW		; select the 2Meg Drive sense adrs			BIT	IsmErrorR		LDA	#$18		STA	IsmMode0W		LDA	#$10		STA	IsmMode1W		;enable Write with action OFF		LDA	#$01		STA	IsmMode1W		STA	IsmMode0W		;2+ us clear FIFO toggle		BIT	IsmErrorR		LDA	cyareg		TAX			;save for restore below		AND	#$7F		STA	cyareg		;switch to 1 Mhz to count cycles accurately		LONGI	ON		REP	#$10		LDY	#SpliceCnt	; this must be tuned to get splice timing right@20		LDA	IsmHndShR		;4 slow cycles		LDA	IsmHndShr		;4 slow cycles		LDA	IsmHndShr		;4 slow cycles		DEY			;2 slow cycles		BNE	@20		;3 slow cycles = 17 slow cycles* exit with Y = $0000 for later write loop		STZ	IsmDataW		;preload FIFO with 1st two bytes		STZ	IsmDataW		;preload FIFO with 1st two bytes		TXA		STA	cyareg		;switch back to fast		LDA	#$08		;(measured overhead = 90 us)		STA	IsmMode1W		;Write Current on NOW		LDX	#syncSize-2	;adjust for preloaded two@30		BIT	IsmHndShR		BPL	@30		;wait for FIFO empty		STZ	IsmDataW		DEX		BNE	@30				LDX	#0003		; three bytes of $A1 mark Writes@40		BIT	IsmHndShR		BPL	@40		LDA	#$A1		STA	IsmMarkW		DEX		BNE	@40		@50		BIT	IsmHndShR		BPL	@50		LDA	#$FB		STA	IsmDataW		;4th byte of mark is just data write		LDX	#0512@60		LDA	[cmdbuffl],Y@61		BIT	IsmHndShR		BPL	@61		INY		STA	IsmDataW		DEX		BNE	@60				LONGI 	OFF		SEP	#$10		@70		BIT	IsmHndShR		BPL	@70		STZ	IsmCRCW		;This dummy store writes 2 CRC bytes!!!		LDX	#04		LDA	#gapByte		@80		LDY	IsmHndShR		BPL	@80		STA	IsmDataW		DEX		BNE	@80		;write enough of the gap to force CRC +1 gap to write		@85		BIT	IsmHndShR		BVC	@85		;wait til fifo says 2 are empty				LDA	#$18		STA	IsmMode0W		;turn off Write mode and action				TYA			;get trailing handshake		AND	#$20		;any errors (underrun is it?)		CLC		BEQ	@90		LDA	IsmErrorR		;clear the error register		STA	csum+2		;save it for analyzer		BRK	$DE		;this should not happen@90		RTS		eject*********************************************************************** Merge It combines the triple read buffer into 1 512 byte user buffer**********************************************************************MERGEIT		EQU	*** Merge data from read into a contiguous block*		PHP		; save processor state		XCE		;		PHP		;		CLC		; native, m=1, x=0		XCE		LONGA	OFF		;		LONGI	ON		;		REP	#$10	;		SEP	#$20	;		LDX	#0001		LDY	#0511		PHY		LDA	mac_flag	; check for mac read or write		BEQ	@512	; if clear merge 512 bytes***********************************		PLY		LDY	#523		PHY		BRA	@524@10		EQU	*		LDA	buf3,x		STA	[cmdbuffl],y		DEY		BMI	@90	; are we done?*@524		LDA	buf2,x		STA	[cmdbuffl],y		DEY		;		BMI	@90*		LDA	buf1,x		STA	[cmdbuffl],y		INX		; point to next src byte		DEY		; bump dest index		BPL	@10	;		BRA	@90****************************************** This is coded for maximum performance * for the normal 512 byte case*****************************************@50		EQU	*		LDA	buf3,x		STA	[cmdbuffl],y		DEY*@512		LDA	buf2,x		STA	[cmdbuffl],y		DEY		;*		LDA	buf1,x		STA	[cmdbuffl],y		INX		; point to next src byte		DEY		; bump dest index		BPL	@50	;************************************@90		EQU	*		PLA		; restore low byte of count		XBA		;		PLA		; restore high byte of count		PLP		; restore processor state		XCE		;		PLP		;		LONGA	OFF		;		LONGI	OFF		;		TAY		; y = high byte of byte count		XBA		;		TAX		; x = low byte of byte count		RTS		TITLE	'RawRead'************************************************************* RawRead **    INPUT : cmdbuffl   pointer to output buffer*          : cmdcount   size of of output buffer*          : cmdadrs    pointer to following ctrl list*      * ctrl list: list size in bytes*          : track number (lsb is side bit)*          : Sector number (0,1..n)*          : Read count*          : Search count*          : Search pattern (0..16 bytes)************************************************************RAWREAD		EQU	*		BIT	ext_flag		BVS	@01		LDA	#cmderror		BRA	@err@01		EQU	*		LDA	[cmdadrs]	;get list length		BEQ	@bcerr		CMP	#08		BCC	@bcerr		CMP	#19		BCC	@10	;max is 18@BCERR		LDA	#bcparmcnt		BRA	@err@10		CLC		JSR	SensnChk	;enable, sense and chk		BCS	@err	;bailout if any err		LDA	#3		STA	readret	;set read retry maximum		JSR	MotorOn	;enable motor on drive		LDY	#02		LDA	[cmdadrs],y		LSR	a	;side bit to carry		STZ	side		ROR	side	;set side as $00/$80		CMP	#80		BCC	@24		LDA	#79@24		EQU	*		STA	cyl		JSR	Seek	;this only gets 1 chance**  wait for Ready from drive (but not forever)		JSR	WaitRdyTO		BCC	@30		LDA	#offline@ERR		BRL	set_err@30		JSR	Rdmode	;select side and rdmode** Now select which RawRead routine to call		LDY	#04	;get offset to sector parm		LDA	[cmdadrs],y		BNE	@50	;sector non zero case		LDA	[cmdadrs]	;get length		CMP	#11		BCC	@bcerr@40		JSR	PatrnRawRd	;call the pattern match case		BRA	@60@50		JSR	SectRawRd	;call the sector match case@60		BCC	@80		LDA	#ioerror		BRA	@err@80		STZ	statbyte		CLC		RTS***************************************************                                                **             C <- clr:all okay, set:field error **   Destroys: A, X, Y, temp                      **   Assumes: caller did WaitRdyTO and Rdmode     **                                                ***************************************************PATRNRAWRD	EQU	*		LDY	#08		LDA	[cmdadrs],y	;get pattrn length		TAX		CLC		ADC	#11		STA	csum		TXA		BEQ	@01		LDA	#$80@01		STA	csumc	;00= no pattern $80 = pattern to match** Setup ReadCnt in a zpg temp		LDY	#07		LDA	[cmdadrs],y		STA	csuma	;csuma immediately follows csumb !!		DEY		LDA	[cmdadrs],y		STA	csumb	;csumb immediately preceeds csmua !!** Set up the timeout*		LDA	#>2000		STA	temp		LDX	#<2000		BIT	csumc		BPL	@rawrd@RB		LDY	#10	;offset to 1st pattern byte@RC		DEX		;Maintain double byte t.o. ctr		BNE	@Ra	;=> no timeout		DEC	temp		BMI	@Rerr	;Oops, timeout error* @RA		LDA	l6clr	;Look for a byte		BPL	@Ra	;Branch if no byte ready		CMP	[cmdadrs],y	;pattern match? 		BNE	@Rb	;No, start all over 		INY		;Yes, found a matching byte		CPY	csum	;whole pattern matched?		BCC	@Rc** Now copy the next csumb (ReadCnt) nybbles to user buffer@RAWRD		REP	#$10		LONGI	ON		LDX	csumb	; 16 bit ldx		LDY	#0000@40		LDA	l6clr		BPL	@40		STA	[cmdbuffl],y		INY		DEX		BNE	@40		SEP	#$10		LONGI	OFF*		CLC		;Ok there's the stuff		RTS@RERR		LDA	#adrerror+$01	;adrs + timeout bits		TSB	error2		SEC		RTS		EJECT***************************************************                                                **             C <- clr:all okay, set:field error **   Destroys: A, X, Y, temp                      **   Assumes: caller did WaitRdyTO and Rdmode     **                                                ***************************************************SECTRAWRD		EQU	*** Setup ReadCnt-5 in a zpg temp		LDY	#06		REP	#$20		LONGA	ON		LDA	[cmdadrs],y		SEC		SBC	#0005		STA	csumb	;csumb immediately preceeds csmua !!		SEP	#$20		LONGA	OFF		BPL	@00		LDA	#bcparmcnt		BRL	set_err** Set up the timeout*@00		STZ	temp2	;zero the sector retry counter@R0		LDA	#>10000		STA	temp		LDY	#<10000@RB		LDX	#3-1	;@RC		DEY		;Maintain double byte t.o. ctr		BNE	@Ra	;=> no timeout		DEC	temp		BMI	@Rerr	;Oops, timeout error* @RA		LDA	l6clr	;Look for a byte		BPL	@Ra	;Branch if no byte ready		CMP	adrmarks,x	;is it D5,AA,96?		BNE	@Rb	;No, start all over * I have now found an address mark@RD		LDY	#03@RE		LDA	l6clr		BPL	@Re		STA	[cmdbuffl],y	;save the cyl nybble@RF		LDX	l6clr	;read the sector nybble		BPL	@rf		LDA	>dnibtab,x	;get sector as data (0..63)		INY		;y=04		INC	a	;convert sector to 1 based		CMP	[cmdadrs],y	;is this the requested sector?		BEQ	@30	;yes. so copy count bytes-3		INC	temp2		LDA	temp2		CMP	adrsret	;enough adrs mark retries?		BCC	@R0	;no. try again** ERROR Exit: couldn't find the sector's adrs mark@RERR		LDA	#adrerror		TSB	error2		SEC		RTS** Now copy next ReadCnt nybbles to user buffer@30		EQU	*		TXA		STA	[cmdbuffl],y	;save the sector nybble		REP	#$10		LONGI	ON		LDX	csumb	;get read length (16 bits)@40		LDA	l6clr		BPL	@40		INY		STA	[cmdbuffl],y		DEX		BNE	@40		SEP	#$10		LONGI	OFF** Now reconstruct the 3 mark bytes in user's buffer		LDX	#3-1		TXY@80		LDA	adrmarks,x		STA	[cmdbuffl],y		DEY		DEX		BPL	@80*		CLC		;Ok there's the stuff		RTS