;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 7:30:6 PM				PRINT	NOGEN		MACHINE	M65816;		INCLUDE	'ad35.rev.hist.aii'	; revision history;VERSION		EQU	$3000	;CYAREG		EQU	$C036	;CODE		EQU	$FF	; Rom in bank $FFCODE_BANK		EQU	$FF0000FAKE_IT		EQU	$00	; make it think we are in bank $00DATA_BANK		EQU	$E1	; data bank registerPOWER1		EQU	$0FB6	; powerup byte (defined in SmartPort)POWER2		EQU	$0FB7	; powerup ok byte*OPEN_WNDW		EQU	$5603	; Rev 01 ROm at $6543 irq window rtnA35DRIVER		EQU	$3400		;was $3C00 for Ver 03 rom A35LGTH		EQU	$5600-A35DRIVER	;was $1A00 for Ver 03 rom ;		INCLUDE	'::Firmware.macros.aii'		INCLUDE	'equates.aii'Bnk~Org		EQU	A35DRIVERAD35DRIVER	PROC	ORG CODE_BANK+A35DRIVER		WITH	AD35_ZPAGE		WITH	E1_AD35VARS		LONGA	OFF		LONGI	OFF*;***********************************************************              **** WARNING **** WARNING **** WARNING ******      1. The order of the include file list is crytical to the*         generation of the object file.  The files; Disk.main*         and Tables  must be included in sequential order*         or the positions of the nyble tables etc will be*         wrong.  ***      2. On Write block and Write calls the upper half of the*         accumulator contains the extra bits for three data*         bytes which have been nibblized.**********************************************************Rel~Org:		INCLUDE	'mainline.aii'	;		INCLUDE	'subroutines.aii'		INCLUDE	'read.aii'		INCLUDE	'write.aii';P_SIZE		EQU	*-DSONY_ENTRY	; number of bytes used by code  		FillTo	A35DRIVER+A35LGTH	; fill allotted space;		ENDP				END