		TITLE	'Reset Service';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d8 on 5/16/91 at 9:21:58 PM******************************************************************                                                               **       This is the main entry point for the Phoenix sony       **       driver. It expects to finds call parameters in page     **       0, starting at address $42.  The number of parameters   **       will vary depending on the type of call.                **                                                               **       ON ENTRY : X-reg = unitno from SmartPort firmware       **                                                               ******************************************************************DSONY_ENTRY	EQU	*	;		JSR	regs_setup	; set up DBR,CYA,/ENBL35, & save X		STZ	mac_flag	; reset mac command marker		LDA	#$A5		CMP	power1		BEQ	warmstart	; drives ready go to it		STA	power1	;set power1 for next InitCmd ** Now, initialize the formatter values and clr the timeout counters;		JSR	InitFormat*		JSR	InitHooks	;Set the hooks		JSR	initmarks	; set up mark tables** Now initialize stuff and locate the drives (eject blanks)		JSR	configure	; assign drives which need IDs** There is the possibility that a reset occurred while an eject was*  in progress.  Some drives will fail in this case.  In an attempt*  to minimize the risk, we retry the eject if it was interrupted.*WARMSTART		EQU	*		BIT	MidEject	;The flag is now in N bit		BMI	reset1	;If hi, forget it		LDX	mideject	;This has the drive number		STX	drive	;this occurs before Vector sets drive		JSR	EnblDrivX		JSR	Eject	;Try againRESET1		EQU	**************************************************************                                                          ** mainline                                 Top level loop  **                                                          **   This is the driving force behind the operation of the  ** firmware.  It does three things- gets a command from     ** the host, services the command, and returns the status.  **                                                          *************************************************************MAINLINE		EQU	*** Jump to the appropriate service routine.  Set status bytes.		JSR	vector* * Besure to always put SWIM back into IWM mode on exit		BIT	MFMflag	;was ISM used		BPL	@noISMuse		JSR	SelectISM		JSR	DisableISM@noISMuse		EQU	*** return to caller with a status		BIT	DeSelect	; start drive's timer		STZ	diskreg	; remove /ENBL3.5		CLC		LDA	statbyte	;		STA	stssav-2	;save error status for dbug		BEQ	all_done	; go home		SEC		; something wrong, flag it.ALL_DONE		RTS*		TITLE	'ColdStart Initializations'****************************************************INITFORMAT	EQU	*		LDA	#XLeaveDef		STA	Interleave		LDA	#$80	;Double sided drives default		STA	formsides		STZ	FmtOption		STZ	FmtOption+1		RTS**INITHOOKS		EQU	*		LDX	#HookTabLen+1RST2		LDA	>HookTab,x		STA	Hooks,x		DEX		BPL	rst2		RTS		; >>>--- exit Inithooks --->>>;*INITMARKS		EQU	*	;		LDX	#MarkTabLen-1RST3		LDA	>MarkTabVals,x		STA	MarkTab,x		DEX		BPL	rst3		RTS**NO_DRIVES		LDA	#nodrverr	; no drive connectedSET_ERR		SEC		; return with error status		STA	statbyte	; save the status		RTS;;		TITLE	'wait table for timers'	; SEG	code	;FMTWTAB		DC.B	25,25,25,25,150*VOLSIZETBL	EQU	*		DC.W	0000	;0 = unknown		DC.W	0800	;2 = 400K 		DC.W	1600	;4 = 800K 4:1		DC.W	2880	;6 = 1400K MFM 		DC.W	1440	;8 = 720K 		DC.W	2880	;A = 1440K MFM 2:1		DC.W	1600	;C = 800K 2:1 	; SEG	fake_it*		TITLE	'Denibbilizing Table'*******************************************************                                                    **          7 bit to 6 bit 'Deniblize' Table          **                                                    **          Valid codes are $96 to $FF only           **     Codes with more than one pair of adjacent      **      zeroes or with no adjacent ones (except       **               bit 7) are excluded.                 **                                                    **      This table *must* be aligned at the end       **               of a page in memory.                 **                                                    *******************************************************	; SEG	code	; rom bankXB		EQU	(*-Rel~Org+Bnk~Org)**$00FF	;*		DCB.B	$96-XB,0		;Pad up to $XX96 DNIBTAB		EQU	*-$96*		DC.B	$00,$01,$98		DC.B	$99,$02,$03		DC.B	$9C,$04,$05		DC.B	$06,$A0,$A1		DC.B	$A2,$A3,$A4		DC.B	$A5,$07,$08		DC.B	$A8,$A9,$AA		DC.B	$09,$0A,$0B		DC.B	$0C,$0D,$B0		DC.B	$B1,$0E,$0F		DC.B	$10,$11,$12		DC.B	$13,$B8,$14		DC.B	$15,$16,$17		DC.B	$18,$19,$1A		DC.B	$C0,$C1,$C2		DC.B	$C3,$C4,$C5		DC.B	$C6,$C7,$C8		DC.B	$C9,$CA,$1B		DC.B	$CC,$1C,$1D		DC.B	$1E,$D0,$D1		DC.B	$D2,$1F,$D4		DC.B	$D5,$20,$21		DC.B	$D8,$22,$23		DC.B	$24,$25,$26		DC.B	$27,$28,$E0		DC.B	$E1,$E2,$E3		DC.B	$E4,$29,$2A		DC.B	$2B,$E8,$2C		DC.B	$2D,$2E,$2F		DC.B	$30,$31,$32		DC.B	$F0,$F1,$33		DC.B	$34,$35,$36		DC.B	$37,$38,$F8		DC.B	$39,$3A,$3B		DC.B	$3C,$3D,$3E		DC.B	$3F;;	; SEG	fake_it	; make code run in bank $00		TITLE	'Nibble Table'*******************************************************                                                    **           6 bit to 7 bit 'Niblize' Table           **                                                    **          Valid codes are $96 to $FF only           **     Codes with more than one pair of adjacent      **      zeroes or with no adjacent ones (except       **               bit 7) are excluded.                 **                                                    *******************************************************	; SEG	codeNIBTAB		EQU	*		DC.B	$96,$97,$9A		DC.B	$9B,$9D,$9E		DC.B	$9F,$A6,$A7		DC.B	$AB,$AC,$AD		DC.B	$AE,$AF,$B2		DC.B	$B3,$B4,$B5		DC.B	$B6,$B7,$B9		DC.B	$BA,$BB,$BC		DC.B	$BD,$BE,$BF		DC.B	$CB,$CD,$CE		DC.B	$CF,$D3,$D6		DC.B	$D7,$D9,$DA		DC.B	$DB,$DC,$DD		DC.B	$DE,$DF,$E5		DC.B	$E6,$E7,$E9		DC.B	$EA,$EB,$EC		DC.B	$ED,$EE,$EF		DC.B	$F2,$F3,$F4		DC.B	$F5,$F6,$F7		DC.B	$F9,$FA,$FB		DC.B	$FC,$FD,$FE		DC.B	$FF*		DC.B	$96,$97,$9A		DC.B	$9B,$9D,$9E		DC.B	$9F,$A6,$A7		DC.B	$AB,$AC,$AD		DC.B	$AE,$AF,$B2		DC.B	$B3,$B4,$B5		DC.B	$B6,$B7,$B9		DC.B	$BA,$BB,$BC		DC.B	$BD,$BE,$BF		DC.B	$CB,$CD,$CE		DC.B	$CF,$D3,$D6		DC.B	$D7,$D9,$DA		DC.B	$DB,$DC,$DD		DC.B	$DE,$DF,$E5		DC.B	$E6,$E7,$E9		DC.B	$EA,$EB,$EC		DC.B	$ED,$EE,$EF		DC.B	$F2,$F3,$F4		DC.B	$F5,$F6,$F7		DC.B	$F9,$FA,$FB		DC.B	$FC,$FD,$FE		DC.B	$FF*		DC.B	$96,$97,$9A		DC.B	$9B,$9D,$9E		DC.B	$9F,$A6,$A7		DC.B	$AB,$AC,$AD		DC.B	$AE,$AF,$B2		DC.B	$B3,$B4,$B5		DC.B	$B6,$B7,$B9		DC.B	$BA,$BB,$BC		DC.B	$BD,$BE,$BF		DC.B	$CB,$CD,$CE		DC.B	$CF,$D3,$D6		DC.B	$D7,$D9,$DA		DC.B	$DB,$DC,$DD		DC.B	$DE,$DF,$E5		DC.B	$E6,$E7,$E9		DC.B	$EA,$EB,$EC		DC.B	$ED,$EE,$EF		DC.B	$F2,$F3,$F4		DC.B	$F5,$F6,$F7		DC.B	$F9,$FA,$FB		DC.B	$FC,$FD,$FE		DC.B	$FF*		DC.B	$96,$97,$9A		DC.B	$9B,$9D,$9E		DC.B	$9F,$A6,$A7		DC.B	$AB,$AC,$AD		DC.B	$AE,$AF,$B2		DC.B	$B3,$B4,$B5		DC.B	$B6,$B7,$B9		DC.B	$BA,$BB,$BC		DC.B	$BD,$BE,$BF		DC.B	$CB,$CD,$CE		DC.B	$CF,$D3,$D6		DC.B	$D7,$D9,$DA		DC.B	$DB,$DC,$DD		DC.B	$DE,$DF,$E5		DC.B	$E6,$E7,$E9		DC.B	$EA,$EB,$EC		DC.B	$ED,$EE,$EF		DC.B	$F2,$F3,$F4		DC.B	$F5,$F6,$F7		DC.B	$F9,$FA,$FB		DC.B	$FC,$FD,$FE		DC.B	$FF	; SEG	fake_it;		TITLE	' Hook & Mark tables'** Hook Table Initial Values*	; SEG	code	; force bank		DC.B	$AB,$6BHOOKTAB		EQU	*		DC.W	HOOKTABLEN	;There are this many bytes		JMP	>RdAddr~GCR		JMP	>RdAddr~GCR		JMP	>ReadData~GCR		JMP	>ReadData~GCR		JMP	>WriteData~GCR		JMP	>WriteData~GCR		JMP	>Seek+4		JMP	>Seek+4		JMP	>Format~Vol		JMP	>Format~Vol		JMP	>WriteTrk~GCR		JMP	>WriteTrk~GCR		JMP	>Verify~GCR		JMP	>Verify~GCR		JMP	>Vector+4		JMP	>Vector+4*MARKTABVALS	EQU	*	;Address, data mark table		DC.B	$FF	;Data sector nibble		DC.B	$AD,$AA,$D5,$FF		DC.B	$FC,$F3,$CF,$3F,$FF		DC.B	$FF		DC.B	$AA		DC.B	$DE		DC.B	$FF,$FF,$FF,$FF,$FF		DC.B	$96,$AA,$D5,$FF*	; SEG	fake_it*		TITLE	'Command Code Vector Routine'*************************************************************                                                          **  vector                 Multi-way branch on the cmdcode  **                                                          **   This routine looks at the command type byte in the     **  command table and if it is not a legal code sets the    **  illegal command status bit.  Otherwise control is       **  transferred to the routine which supports the command.  **  Just before vectoring, this routine clears the status.  **                                                          **  Input:   cmdcode                                        **  Regs:    A,X destroyed                                  **           Y   preserved                                  **           error1 altered if cmdcode error                **  Time:    166 microseconds (maximum)                     **                                                          *************************************************************	; SEG	codeVECTOR		EQU	*	; SEG	fake_it	;		JMP	VectorHook** If there are drive IDs to assign, skip the drive selection*		LDA	Cmdcode		CMP	#cmdDefID	;init command?		BEQ	@10	;yes. don;t check unit number** Decide which drive is meant*		LDX	#00		LDA	cmdUnit@01		CMP	UnitId,x		BEQ	@03		INX		CPX	#maxdrivs		BCC	@01*		LDA	#$11	;bad unit error		STA	statbyte		RTS@03		STX	drive	;define drive to use** Clear out the status area if NOT a status call*@10		LDA	CMDCode		BEQ	skipclrsb		LDX	#6VEC1		STZ	statustab,x		DEX		BPL	vec1** Set up the length of the default status string (=0) and statbyte*SKIPCLRSB		EQU	*		STZ	statbyte	; clear status byte** Okay, now multi-way branch*		LDA	CMDCode		CMP	#ncommands		BLT	cmdokay** Command code was not within legal bounds. Flag as an error*ILLCMDCODE	EQU	*		LDA	#cmderror		BRL	set_err	; mark an error*CMDOKAY		EQU	*		TAX		LDA	>parmctab,x		AND	#%01111111	;Strip Top bit		CMP	CMDPCount		BEQ	goforit*FLAGPCERR		EQU	*		LDA	#PCountErr		BRL	set_err	; mark an error*GOFORIT		EQU	*		TXA		;CMDCode is still in X		ASL	a	;Convert to word index 		TAX		JMP	(fntable,x)	; Vector to the routineCLOSERTS		EQU	*	;		RTS		; Vector to the routine*	; SEG	code	;FNTABLE		DC.W	STATUS		DC.W	READBLK		DC.W	WRITEBLK		DC.W	FORMATVOL		DC.W	CONTROL		DC.W	INITCMD		DC.W	ILLCMDCODE	;No opens		DC.W	ILLCMDCODE	;No Closes		DC.W	MACREAD	;Read nnnn bytes		DC.W	MACWRITE	;Write nnnn bytes		DC.W	SETFMTOPT	;Set Format Options		DC.W	GETFMTOPT	;Get Format Options		DC.W	RAWREAD	;Raw Track Read*NCOMMANDS		EQU	(*-FNTABLE)/2*PARMCTAB		EQU	*		DC.B	%00000011	;Status:  3 parms/no data send		DC.B	%00000011	;Read:    3 parms/no data send		DC.B	%10000011	;Write:   3 parms/data send		DC.B	%00000001	;Format:  1 parm /no data send		DC.B	%10000011	;Control: 3 parms/data send		DC.B	%00000010	;Init:    2 parm /no data send		DC.B	%00000001	;Open: not used		DC.B	%00000001	;Close: not used		DC.B	%00000100	;CharRead: 4 parms/data send		DC.B	%10000100	;CharWrite: 4 parms/data send		DC.B	%00000011	;SetFmtOpt		DC.B	%00000011	;GetFmtOpt		DC.B	%00000100	;RawRead		DC.B	%00000010	;filler for t&rf	; SEG	fake_it	;		TITLE	'Status Request Handler'*****************************************************************                                                              **  Status                        Handles a status request      **                                                              *****************************************************************STATUS		EQU	*		LDA	CMDSCode	;Get the control code		CMP	#nscodes	;Check for boundary		BLT	statokay	;It's within range*		BRL	IllCode** Code is okay... do the multi-way branch*STATOKAY		EQU	*		ASL	a		TAX		LDA	>sctable+1,x		PHA		LDA	>sctable,x		PHA		LDX	drive		STZ	stsmotor	;assume timer cancel mode		RTS		; go to the routine called*	; SEG	code	;SCTABLE		EQU	*		DC.W	BASICSTAT-1		DC.W	ILLCODE-1		DC.W	ILLCODE-1	;Char dev only		DC.W	STATDIB-1		DC.W	ILLCODE-1		DC.W	STATDEV-1		DC.W	GET_VARS-1	; variable area dump		DC.W	GET_BUFF_ADDR-1	; buffers address dump*STATTEND		EQU	*NSCODES		EQU	(STATTEND-SCTABLE)/2	; SEG	fake_it	;**STATDIB		EQU	*		JSR	BasicStat	;Sets first four bytes*		TXY		; get current number of bytes		LDX	#00	;Get length of additional dataSDMORE		EQU	*		LDA	>DIBString,x		STA	[cmdbuffl],y	; save device name		INY		;		INX		; bump index		CPX	#DIBSLen	; moved all bytes		BCC	sdmore	; keep going until all bytes moved		TYX		; save byte count transfered		BIT	ext_flag		BPL	@10		DEY		DEY		DEY		;bak up to devsubtype offset		LDA	[cmdbuffl],y		ORA	#01		STA	[cmdbuffl],y	;set the SuperCmds bit @10		LDY	#00		RTS*	; SEG	code	;DIBSTRING		EQU	*		DC.B	IDSLIDSTRING		DC.B	'DISK 3.5'*IDSL		EQU	*-IDSTRING	;ID string length*		DCB.B	16-IDSL,$20	;Pad with spaces		DC.B	DEVTYPE		DC.B	DEVSUBTYPE		DC.W	VERSION*DIBSLEN		EQU	*-DIBSTRING	;This is the entire DIB length	; SEG	fake_it	;**STATDEV		EQU	*		LDY	#nsbytes	; copy status table to users bufferSDLOOP		LDA	statustab,y	;		STA	[cmdbuffl],y	;		DEY		;		BPL	sdloop	;		STZ	statbyte		LDX	#09		BRL	stat_exit*************************************************************************************************************BASICSTAT		EQU	*		STZ	statbyte	;clear error code		JSR	EnblnSens	;enable drive and sense status		IF 0	THEN	;remove it for now		PHP		;returns v=1 if offline n=1 if dsw* Now record the MotorOn state of the drive		BIT	ext_flag	;extended status call?		BVC	@05	;nothing doing		LDA	cmdscode	;statcode = 00?		BEQ	@05	;yes.		LDA	#mtronadr		JSR	ReadBit	;get motorON state 		BMI	@05	;Motor if off. (a good guess)		DEC	stsmotor	;select leave timer ON mode@05		PLP		ENDIF		PHP		LDA	#VSwrprot		AND	volsts,x		LSR	a		LSR	a		LSR	a		ORA	#$E8		BVS	@10		ORA	#svmask1	;assert online@10		PLP		PHP		BMI	@15	;disk was ejected		BVS	@20	;offline so skip this		BIT	priorsts	;is this an offline/online transition?		BVC	@20	;no. otherwise signal 'switched'@15		BIT	ext_flag		BVC	@20		ORA	#svmask3	;add in dsw@20		EQU	*		STA	stssav-1	;save where analyzer can see it		STA	[cmdbuffl]	;Store the device status byte** Now I may need to process a volume type change before* I can know how many block are on the new volume		PLP		;do I have a volume		BVC	@30	;online volume present		JSR	OfflineX	;set volsts to offline&unknown		JSR	ClearDSW		BRA	@50	;return zero block count@30		BPL	@40	;DIP true and DSW false! 		JSR	UnkVolx	;mark voltype unknown		JSR	ClearDSW@40		LDA	volsts,x		AND	#$1F	;is voltyp known?		BNE	@60	;yes. so I am all setup@45		JSR	mountvol	;set VOLTYP if I can @50		EQU	*		LDX	drive	;Whichever drive...		LDA	volsts,x	;a=zero if voltype is unknown		AND	#$1F	;extract voltype index@60		TAX		LDA	>volsizetbl,x	;return volsize zero		LDY	#01		STA	[cmdbuffl],y	;		INY		;		LDA	>volsizetbl+1,x	;		STA	[cmdbuffl],y	;		INY		;		LDA	#$00	;		STA	[cmdbuffl],y	;Hi- we're always zero here		INY		;		BIT	ext_flag	; bit 6 set if extended		BVC	@90	; otherwise go away		STA	[cmdbuffl],y	; the volume size is four bytes		INY		; if extended command@90		TYX		; save byte countSTAT_EXIT		LDY	#$00	; reset high byte of byte count		BIT	stsmotor	;should I reset drive timer?		BMI	@100	;no		STZ	diskreg	; disable drive timer by DEasserting /ENBL35 @100		RTS		;before Deselect in mainline;;	; SEG	codeSTATMASKS		EQU	*	; status bits for wrprot, dip, swap	; SEG	fake_it		DC.B	SVMASK3,SVMASK1,SVMASK2;;		TITLE	'Read or Write a Block'*************************************************************                                                          ** readBlk, writeBlk           Block read and write         **                                                          **   This is the top level read/write routine.  It maps     **  the block number to cyl, sect, side, and proceeds to    **  attempt to read or write the requested block.  Up to 4  **  reseeks and 200 retries on address and data errors are  **  performed.  A recal and reseek is done after the 100th  **  retry.                                                  **                                                          **   Uses:    blkmap, rdaddr, read, write, seek, & recal    **   Input:   blocknol, blocknoh, cmdcode, drive            **   Output:  C <- set if a fatal error                     **                 clr ow                                   **            error2 <- bits set if error (soft or hard)    **                                                          *************************************************************READBLK		EQU	*		STZ	UNITID+3		CLC		BRA	RdWr*WRITEBLK		EQU	*** do the checksum prepass on the data*		LDX	#175	;		LDY	#$00	; assume a mac write call		LDA	mac_flag	; check for mac write cmd		BNE	write_entry	;		LDY	#$04	; Can't be right all the time!ZAP_LOOP		EQU	*	;		STZ	buf1,x	; 4 bytes each buffer		STZ	buf2,x	;		STZ	buf3,x	;		DEX		;		DEY		; decrement count		BNE	zap_loop	; when all done, then prepare the dataWRITE_ENTRY	EQU	*	;		JSR	writeprep	; split data & generate cksum** Check for DIP, DSW and WRPROT *    		SECRDWR		EQU	*		JSR	SensnChk	;enable,Sense, and chk volsts		BCS	@05	; some error: Offline,DSWerr,WPerr		BPL	@CHK_BLK	;no need to mount volume		JSR	MountVol	;online after switch or unknown voltyp		BCC	@CHK_BLK	;mount worked!@05		STA	statbyte	;record error code@rtn		RTS		; something happened go away** Check block number; map to side, cylinder, sector*@CHK_BLK		JSR	blockchk		BCS	@rtn	;* Now setup the ISM with 16M clk and params if this is MFM volume		LDX	drive		LDA	#UFmfm		;fdhd bit mask		BIT	unitflags,x	;is this MFM volume 		BEQ	@notMFMvol		BIT	mac_flag		;is this a read/write bytes CMD?		BPL	@mfmok		;no* later this should generate 12 fake tag bytes and add 12 to the buffer pointer * fake tag bytes to read "John Arkley!"		LDA	#coderror		;WRONG MEDIA TYPE for now		STA	statbyte		RTS@mfmok		LDA	#$80		TSB	MFMflag		;b7 = mfm  b6 = ISM enabled		JSR	EnableISM		;enable ISM and 16M FCLK		JSR	SetMFMParms	;set the timing params for 15.6672 Mhz		JSR	DeSelectISM	;back to IWM until I/O (for now)@notMFMvol	EQU	*** Now translate the blocknum into cyl, side, sect		JSR	blkmap** Now determine if direct read can be used		LDA	cmdcode		CMP	#cmdread		BNE	@10 		JSR	FastBufr	;determine if buffer is in fast memory		LDX	drive@10		EQU	*** Set up the maximum number of retries and reseeks*		LDA	#maxseeks		STA	seekret*		LDA	#maxret		STA	readret	;Set sector counter** Now turn on the drive motor BUT set FDHD MFM/GCR mode before a motor turn-on		JSR	MotorOn	;** Check if we have reseeked enough to recal...*MORESEEK		EQU	*		LDA	seekret		CMP	#skrclthrsh		BNE	aseek	;If not two reseeks, no recal ** Do a recal before seeking*ARECAL		EQU	*		JSR	recal** Seek to the cylinder in cyl*ASEEK		EQU	*		JSR	seek		BCC	grabheadr	;If no error, get an adr field OOPSEEK		EQU	*		JSR	SelectIWM** There was a seek error ("hard" or "soft"). Maintain seek counter*		DEC	seekret		BNE	moreseek	;Maybe try a reseek 		BEQ	rdwrerr	;OW give up ** Maintain the retry counter.  Quit if too many errors*TRYMORE		EQU	*		JSR	SelectIWM		INC	retry	;Keep status table informed		DEC	readret		BNE	rwckrc** Set the fatal error flag*RDWRERR		EQU	*		LDA	#ioerrorGOSETERR		BRL	set_err	;** If the recal threshold is reached, recal the drive.*RWCKRC		LDA	readret		CMP	#rclthresh		BEQ	arecal** Okay, read an address field*GRABHEADR		EQU	*		JSR	rdaddr		BCC	sidesokay		BIT	temp	;read adrs get CS/BS error?		BPL	trymore	;yes.		BVC	goseterr	;offline ?!!? error in RdAddrs		DEC	readret	;timeout err uses 		BNE	trymore	;double the retries		BRA	rdwrerr** Now, see if this is the cylinder we expected *SIDESOKAY		EQU	*		BIT	MFMflag		BPL	@GCRCYL		LDA	trkfnd	;mfm track byte is 0ccccccc		BRA	@cmpCYL@GCRcyl		LDA	sidefnd		LSR	A	;msb of track to Carry 		LDA	trkfnd	;XXcccccc		AND	#$3F	;00cccccc		BCC	@cmpCyl	;00cccccc		ORA	#$40	;01cccccc @cmpCYL		CMP	cyl		BEQ	rightcyl** Well, we seeked (sucked?) to the wrong cylinder.  Use the cylinder*  number found to define our current position. *		LDX	drive		STA	curcyl,x	;Use cyl found as reference		LDA	#sftskerror	;Flip on seek error bit		TSB	error2		BRA	oopseek	;One more seek error and retry** Is side found what we thought?*RIGHTCYL		EQU	*		LDA	sidefnd	;XXS00000		ASL	a	;XS000000		ASL	a	;S0000000		EOR	side	;0&0,1&1 leaves 0		BMI	trymore	;Treat as a soft error** If this is the right sector, we win!*RIGHTSIDE		EQU	*		LDA	sectfnd		CMP	sector		BNE	trymore	;Keep looking** Found the target, now do whatever we came to do (read or write)*		LDA	cmdcode		CMP	#cmdwrite		BEQ	dowrite	;Assume write if not read** Try to read the data field*@33		JSR	ReadData	;read direct/indirect 		BCS	trymore		BIT	DRswtch	;was a Direct Read done?		BMI	sbset	;yep. don't need MergeIt** Got the data - send it over*		JSR	MergeIt	;Move data to user buffer*SBSET		EQU	*		CLC		; assume no errors		LDA	error2		BEQ	skipstow		LDA	#SoftError		BRL	set_err	; mark an errorSKIPSTOW		EQU	*		CLC		; no errors		RTS** Write out a data field*DOWRITE		EQU	*		JSR	WriteData		CLC		RTS		EJECT*************************************************** FastBufr** FastBufr determines if the user buffer address* is in fast memory or if the 512 bytes spans a* bank boundary**    INPUT :  cmdbuffl+1,+2 is user buffer adrs*    OUTPUT: DRswtch =  00 if bk spanned or slow (shadowed)*            DRswtch = $FF if fast and not bk spanned ****************************************************FASTBUFR		EQU	*		STZ	DRswtch	;assume slow &/ bk spanned		BIT	MFMflag	;is this MFM read?		BMI	@FAST	;yes. set DR flag to skip MergeIt		BIT	mac_flag	;524 rd? 		BMI	@slow	;must use slow		LDY	cmdbuffl+2		CPY	#$E0		BCC	@10		CPY	#$E1+1		BCC	@slow@10		CPY	#02		BCC	@15		LDX	cmdbuffl+1		CPX	#$FF		BNE	@fast		BRA	@slow@15		LDA	shadow		AND	#$1E		CMP	#$1E	;all fast?		BEQ	@fast		LDX	cmdbuffl+1		JSR	chkpgslow		BCS	@slow		LDX	cmdbuffl+1		INX		INX		JSR	chkpgslow		BCS	@slow@FAST		DEC	DRswtch@SLOW		RTS*************************************** ChkpgSlow checks the page address* of a page in bank 0/1 to see* if it is shadowed and therefore slow** INPUTS :  X = page address to check*           A = shadow Reg shadow bits*               (Shadow AND $1E)*           Y = Bank address (00/01)* OUTPUT :  C = 1 if slow*           C = 0 if fast    ** PRESERVES : A-reg, X-reg, Y-reg* DESTROYS  : carry  (and P)***************************************CHKPGSLOW		EQU	*		CPX	#$FF	;do bufr pags span bank boundary?		BEQ	@slow	;yes. so do block indirect!		CPX	#$D0		BCS	@fast		CPX	#$C0		BCS	@slow		CPX	#$A0		BCS	@fast		CPX	#$0C	;foget the txtpg2 buffer too!		BCC	@slow		CPY	#01	;bank 1 only check?		BNE	@20		CPX	#$60		BCC	@20	;adrs not in range		BIT	%00001000	;is $6000..$9FFF fast RAM		BNE	@fast	;yep		BRA	@slow@20		CPX	#$20	;in hires 1/2 range?		BCC	@fast	;no.		CPX	#$40	;hires 1 or 2?		BCS	@30		BIT	#%00000010	;are HiRes1,1X both fast?		BRA	@35@30		BIT	#%00000100	;is HiRes2,2x both fast?@35		BNE	@fast		CPY	#00		BEQ	@slow	;		BIT	#%00010000	;is HiRes1x or 2x fast 		BEQ	@slow	;no.@FAST		CLC		RTS@SLOW		SEC		RTS