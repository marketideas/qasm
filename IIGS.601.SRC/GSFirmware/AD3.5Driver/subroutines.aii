		TITLE	'Format Volume';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d8 on 5/16/91 at 9:22:43 PM***************************************************                                               *  Format Volume    Format an diskette based on*		the media type 800K for DD*		or 1440K for HD media**	Don't allow formatting 800K on 1440 media*                                               **************************************************FORMATVOL		EQU	*		JMP	FormatHookFormat~VOL:		LDA	#ejct_reset	; reset ejected bit		JSR	writebit	;to supress DSWerr from SensnChk		SEC		;need the WP error here		JSR	SensnChk	;enable,Sense, and chk volsts		BCC	@10	;media is online		STA	statbyte	;offline or WritProt 		RTS		@10		LDA	#UFfdhd		BIT	UnitFlags,X	;is this a FDHD drive?		BEQ	@20		;NO. so can't determine media type		LDA	#MediaAdr		JSR	ReadBit		BMI	@20		;not HD media so only do GCR format		LDA	#$80		STA	DblSided* Now setup the ISM with 16M clk and params since this is MFM media		LDA	#$80		TSB	MFMflag		;b7 = mfm  b6 = ISM enabled		JSR	EnableISM		;enable ISM and 16M FCLK		JSR	SetMFMParms	;set the timing params for 15.6672 Mhz		JSR	DeSelectISM	;back to IWM until I/O (for now)				lda	#AD1440KSectors		sta	curnsect		;1440 has 18 sectors / track		lda	#02		sta	Interleave	;set the default mfm interleave		LDX	drive		LDA	FmtOption,X	;default format or specific format?		BNE	@ck1440K		LDA	#AD1440K		STA	FmtOption,X		BRA	@20		;default it to do 1440K with 2:1 interleave@ck1440K		CMP	#AD1440K		BEQ	@20		CMP	#AD1440K1		;other interleave factor?		BEQ	@20		;yep.		LDA	#coderror		;wrong media type error 		sta	statbyte		SEC		RTS*** Prep to start the track loop@20		JSR	MotorOn	;enable motor (SEEK doesn't doit now)		JSR	recal	;Start out on the right foot		BCS	fmterr*		STZ	cyl		STZ	side	;Start on side 0 *@TRKLP		EQU	*		LDA	#fmtretry		STA	fmtTrkretry	;Set retry count** Write out an entire track@RTRY		JSR	writetrk		BCS	fmterr	;If there was any problem, escape** Now verify that we wrote it correctly		JSR	verify		BCC	@30	;Skip retries if verify okay *		DEC	fmtTrkretry		BEQ	fmterr	;I/O error if verify fails rptdly		LDA	statbyte	;rdadrs return offline?		CMP	#offline		BNE	@rtry	;no. so try again		BRA	fmterror	;return offline!!!** Flip the side if it's a double sided disk@30		EQU	*		JSR	open_wndw	; open an interrupt window		BIT	formsides	;Set N flag to double sided		BPL	@40	;If 1 sided, leave side alone 		LDA	#$80	;2 sided: Flip side 		EOR	side		STA	side		BNE	@trklp	;If side 1 now, back to write it** Advance to the next cylinder @40		INC	cyl		LDA	cyl		CMP	#totcyls		BLT	@trklp	;If more cyls, do 'em*		LDX	drive		JSR	ResetFmt	;return Format Option to default		CLC		;no prior error		JSR	MountVol	;determine volume type		BCS	fmterror	;can't read adrs after format?????		CLC		RTS		;Return- everything AOK*FMTERR		LDA	#ioerror		STA	statbyteFMTERROR		JSR	eject		SECRTS33		RTS		;Return w/ carry set		TITLE	'Write out a Track'***************************************************                                                **  writetrk       Write an entire track to disk  * *                                                **   Input:    cyl, side                          **   Uses:     seek, initwtrk                     **   Destroys: A,X,Y, temp                        **                                                ***************************************************WRITETRK		EQU	*		BIT	MFMflag		BPL	@doGCR		JMP	mfmWriteTrk@doGCR		JMP	WriteTrkHook*WriteTrk~GCR	JSR	seek		JSR	makesect	;Generate a sector image in RAM 		JSR	initwtrk		JSR	WaitRdyTO			BCS	rts33	;return an error** To meet the Sony formatting spec, one must wait extra time*  on track 0 and others that are the first of a speed class.*		LDA	side		BNE	wtnowait*		LDA	cyl		AND	#$0F		BNE	wtnowait	;If not 1st of speed class*		LDA	cyl	;Get back again		LSR	a		LSR	a		LSR	a		LSR	a		TAX		LDA	>fmtwtab,x		JSR	wait2ms*WTNOWAIT		EQU	*		JSR	rdmode	;Set the head correctly		STZ	temp		LDA	#$FF		BIT	l6set	;Prep to write		STA	l7set		LDA	#>itssize		LDX	#<itssize		STA	temp2** Write out 20 microsec sync marks (pre-track)*WSYNB		LDY	#4	;(2)WSYND		LDA	synctab,y	;(4)WSYNA		BIT	l6clr		BPL	wsyna		STA	l6set	;(4)		DEY		;(2)		BPL	wsynd	;(3,2)		DEX		;(2) 		BNE	wsynb	;(3,2)		DEC	temp2	;(5)		BPL	wsynb	;(3,2)** Copy out the header and marks to the disk*FMTSLOOP		EQU	*		REP	#$10	;(2) 16 bit indexes		SEP	#$20	;(2)		LONGA	OFF		; 8 bit accumulator		LONGI	ON		; 16 bit indexes		LDY	#0000	;(3) Get count from buffer		LDX	sectbuf	;(5) get header field length@20		LDA	sectbuf+2,y	;(6..9) Get a byte in the sector@30		BIT	l6clr	;(6-9,11)		BPL	@30	;(3)		STA	l6set	;(3) Start it writing out		INY		;(2) Next byte		DEX		;(2) 		BNE	@20	;(3) Waste more time if not		LONGA	ON		REP	#$20		LDA	sectbuf+2,y	;get 16 bit repeat count		TAX		;    repeat count is 1 based		LONGA	OFF		SEP	#$20*		LDA	sectbuf+4,y	;get repeat byte@40		BIT	l6clr		BPL	@40		STA	l6set		DEX		BNE	@40*		LONGA	ON		REP	#$20		LDA	sectbuf+5,y	;get 2nd field length		TAX		LONGA	OFF		SEP	#$20@50		LDA	sectbuf+7,y@60		BIT	l6clr		BPL	@60		STA	l6set		INY		;(2)		DEX		;(2)		BNE	@50	;(2)*		SEP	#$10	;(2) 8 bit indexes		LONGI	OFF		; 8 bit accumulator** More sectors this track?*		INC	temp	;(5)		LDY	temp	;(3) Sectors out so far		CPY	curnsect	;(9)		BGE	donetrk	;(2) If done, skip out** Now, in order to keep the IWM in write mode, must write*  a byte to keep from underflow.  Remember, the inner write*  loop above is small (<32 cyc), so the IWM would not underflow*  until well into the SECOND byte time.*		LDA	#$FF	;(2)@70		BIT	l6clr	;(9) wait for buffer empty		BPL	@70	;(3)		STA	l6set	;(9) Pop out an $FF** Need another sector... update the sector number*		LDX	xlvtab,y	;(9) Translate to logical sect#		LDA	>nibtab,x	;(5) Nibbilize it		STA	volasect	;(9) Place in address field		STA	voldsect	;(9) and in the data field;		LDY	#$FF	;(2) keep on writing....@80		BIT	l6clr	;(6,9) wait for buffer empty		BPL	@80	;(3)		STY	l6set	;(9)** Now update the checksum*		TXA		;(2) Move the current log sect#		EOR	csum	;(3)		TAX		;(2) min of 40 fast cycles per nyble		LDA	>nibtab,x	;Nibbilize the new sum		STA	volcsum	;Into the sector image*@90		BIT	l6clr		BPL	@90		STY	l6set	;out with another sync byte ;		BRL	fmtSloop	;Back for more sectors *DONETRK		EQU	*		BIT	l6clr	; wait for underrun		PHP		;retain /underrun in v bit@100		BIT	l6clr	;wait for last byte to underrun		BVS	@100	;		LDA	l7clr	;Back into read mode		LDA	l6clr		PLP		SEC		LDA	#$34	;write underrun error for debug		BVC	wtrkerr	;return an error		LDA	#00		CLCWTRKERR		STA	error1	;save where debug is easy		RTS***************************************************                                                **  makesect      Generate a sector image in RAM  **                                                ** As follows: Length word of header field        **             header field bytes                 **             count word of repeat field         **             repeat byte   (exactly one byte!)  * *             length word of trailer field       **             trailer field bytes                **                                                **   Destroys: A, X, Y                            **                                                ***************************************************MAKESECT		EQU	*** Generate intersector gap		LDA	#65+22		STA	sectbuf	;init header field length		STZ	sectbuf+1*		LDX	#00@10		LDY	#4@20		LDA	synctab,y		STA	sectbuf+2,x		INX		CPX	#65		BCS	@30		DEY		BPL	@20		BRA	@10** the data to sectbuf is reverse order from afdmtab* Copy the address field 'skeleton' and data marks@30		LDX	#22-1		LDY	#00@40		LDA	afdmtab,x	;src from hi adrs		STA	sectbuf+2+65,y	;dest to low adrs		INY		DEX		BPL	@40** repeat field is 703 $96 nybles		LDA	#<703		STA	sectbuf+2+65+22		LDA	#>703		STA	sectbuf+3+65+22		LDA	#$96		STA	sectbuf+4+65+22	;repeat byte** Trailer field is just the bit slip marks		LDA	#<02	;old formatter didn't write the		STA	sectbuf+5+65+22		LDA	#>03	;last byt of the 793 byte buffer cuz		STA	sectbuf+6+65+22		LDX	#3-1	;of the 3 $FF written btween sects		LDY	#00	;@50		LDA	bsmarks,x		STA	sectbuf+7+65+22,y		INY		DEX		BPL	@50		RTS		TITLE	'Write Track Support'***************************************************                                                **  initwtrk      Set interleave table, and init  **                 the RAM sect image for sect 0  **                                                **                                                ***************************************************INITWTRK		EQU	*** Generate interleave table*		LDA	#$FF		LDX	#11CLEARXTAB		EQU	*		STA	xlvtab,x		DEX		BPL	clearxtab*		INX		;X=0		LDY	#0ALLOCSPOT		TYA		STA	xlvtab,x		INY		;Physical Sector number		CPY	curnsect	;If all sectors placed, we're done		BGE	xlvdone		TXA		;Move index to A to add		CLC		ADC	Interleave		TAXCHECKBOUND	EQU	*		CPX	curnsect		BLT	checkspot		TXA		;We wrapped (C=1)		SBC	curnsect		TAXCHECKSPOT		EQU	*		BIT	xlvtab,x		BMI	allocspot		INX		BRA	checkbound** Put track into sector image*XLVDONE		EQU	*		LDA	cyl		AND	#$3F	;Only lower six bits		STA	csum	;Start checksum calc		TAX		LDA	>nibtab,x	;Nibbilize the track		STA	voltrk	;Save it** Put side byte into sector image*		LDA	cyl	;track[6] goes into side 		ASL	a		ASL	a		LDA	#0		ROL	a	;A[0] has track[6] 		BIT	side		BPL	iwtb		EOR	#$20IWTB		TAX		EOR	csum	;Maintain the checksum		STA	csum		LDA	>nibtab,x		STA	volside** Now set the fmt byte*		LDA	Interleave	;Whatever it may be		BIT	formsides	;Single or double desired?		BPL	iwtc	;If one sided, skip down		ORA	#$20	;Two sides - flip fmt[5]IWTC		TAX		EOR	csum		STA	csum	;Add into checksum		PHA		;Save for a jiffy		LDA	>nibtab,x	;Nibbilize the fmt byte		STA	volfmt** Store sector0 and checksum		PLA		;Get back csum		TAX		LDA	>nibtab,x	;Nibbilize		STA	volcsum		LDA	#$96		STA	volasect	;Save sector 0 in add field		STA	voldsect	; and in data field		RTS		eject***************************************************                                                **  verify             Verify the current track   **                                                **                                                ***************************************************VERIFY		EQU	*		JMP	VerifyHook** Wait out the write recovery timeVerify~GCR	LDA	#2		JSR	waitms*		LDA	curnsect	;Set up a counter		STA	temp2** Find and interpret an address fieldVFYA		JSR	rdaddr	;this could destory temp2 if drive not Ready!!!!		BCS	@vererr1	;If cs/bs/TO/Offline error** Have we already seen this sector?		LDX	sectfnd	;Which one is this		CPX	curnsect	;Is it too big?		BGE	@vererr4	;Yes- some problem*		LDA	xlvtab,x	;See if we've marked it before		BMI	@vererr3	;If so, blew it** Mark this sector as having been seen		LDA	#$FF		STA	xlvtab,x** Now check the data field		BIT	MFMflag		BPL	@GCR		LDA	#<BUF1		STA	cmdbuffl		LDA	#>BUF1		STA	cmdbuffl+1		LDA	#Data_Bank		STA	cmdbuffl+2 ;MFM is always direct SO it needs bufr ptr!!		BRA	@MFM@GCR		STZ	DRswtch	;always verify to indirect buffr@MFM		JSR	readdata		BCS	@vererr2	;Return bad if problem** More to do?		DEC	temp2		BNE	vfya*		CLC		RTS		;Good exit*		NOP@Vererr1		LDA	#01@vererr2		LDA	#02@vererr3		LDA	#03@vererr4		LDA	#04	;debugger junkVERERR		SECrts55		RTS		;Error exit ************************************************************************ MFMWriteTrk***********************************************************************mfmWriteTrk	JSR	seek		JSR	initMFMwtrk	;setup interleave table etc		JSR	WaitRdyTO		BCS	rts55		;return an error** To meet the Sony formatting spec, one must wait extra time on track 0		LDA	cyl		BNE	@wtnowait				LDA	side		BNE	@wtnowait*		LDA	#150		JSR	wait2ms	;wait an extra 300ms before 1st track		LDA	#150		JSR	wait2ms	;wait an extra 300 ms before 1st track*@WTNOWAIT		EQU	*		JSR	rdmode		;Set the head correctly		JSR	SelectISM		;switch modes for formatting* enable write (search for index pulse etc)		BIT	IsmErrorR		LDA	#$18		STA	IsmMode0W		LDA	#$10		STA	IsmMode1W		;enable Write with action OFF		LDA	#$01		STA	IsmMode1W		STA	IsmMode0W		;2+ us clear FIFO toggle		STA	fmtsect		;set start sector is 1 for MFM volumes		STZ	temp		;init the sector counter		BIT	IsmErrorR		SEP	#$20		; 8 bit accumulator		LONGA	OFF		; 8 bit accumulator		REP	#$10		; 16 bit indexes		LONGI	ON		; 16 bit indexes			LDY	#12500+325	;.2 secs / 16 us/byte = 12500 + speed margin		LDA	#GapByte		STA	IsmDataW		;preload FIFO with 1st two gaper's		STA	IsmDataW		;preload FIFO with 1st two 		XBA			;save gapByte for writing		LDA	#$08		;(measured overhead about 90 us)		STA	IsmMode1W		;Write Current on NOW		@waitIndexLo	BIT	IsmHndShR		BPL	@waitIndexLo		BEQ	@20		XBA			;get gapbyte back		STA	IsmDataW		;write a gap byte		XBA			;get BIT mask back		DEY		BNE	@waitIndexLo		BRL	NoFmtIndex	@20		XBA			;get gapbyte back		STA	IsmDataW		;write a gap byte		XBA			;get BIT mask back@waitIndexHi	BIT	IsmHndShR		BPL	@waitIndexHi		BNE	mfmStartFmt		XBA			;get gapbyte back		STA	IsmDataW		;write a gap byte		XBA			;get BIT mask back		DEY		BNE	@waitIndexHi		BRL	NoFmtIndex; first insure that the Index/Tach adrs is not the lingering phase line setting; to prevent the Index Pulse cross talk from RdData line to WriteData line problemmfmStartFmt	XBA		STA	IsmDataW		LDA	#%11110101	;CA [3210] = 0101		STA	IsmPhaseW		; select the 2Meg Drive sense adrs** Write out the index mark ($C2 $C2 $C2 $FC) and following gap*		LDX	#Gap4aSize-1	;		LDA	#gapByte@10		BIT	IsmHndShR		BPL	@10		;wait for FIFO empty		STA	IsmDataW		DEX		BNE	@10** Write out sync (pre-index mark)*		LDX	#syncSize		;@20		BIT	IsmHndShR		BPL	@20		;wait for FIFO empty		STZ	IsmDataW		DEX		BNE	@20				LDX	#03		; three bytes of $C2 Index mark Writes@30		BIT	IsmHndShR		BPL	@30		LDA	#$C2		STA	IsmMarkW		DEX		BNE	@30		@40		BIT	IsmHndShR		BPL	@40		LDA	#$FC		STA	IsmDataW		;4th byte of mark is just data write** Index mark has no field or CRC bytes		LDX	#Gap1Size	;		LDA	#gapByte@50		BIT	IsmHndShR		BPL	@50		;wait for FIFO empty		STA	IsmDataW		DEX		BNE	@50		BRA	mfmAdrsSync		mfmFmtSectLp	EQU	*** Format a sector Address mark*		LDX	#Gap3Sz1440K	;		LDA	#gapByte@20		BIT	IsmHndShR		BPL	@20		;wait for FIFO empty		STA	IsmDataW		DEX		BNE	@20		mfmAdrsSync	LDX	#syncSize		;@30		BIT	IsmHndShR		BPL	@30		;wait for FIFO empty		STZ	IsmDataW		DEX		BNE	@30				LDX	#0003		; three bytes of $A1 mark Writes@40		BIT	IsmHndShR		BPL	@40		LDA	#$A1		STA	IsmMarkW		;write 3 adrs Mark bytes		DEX		BNE	@40		@50		BIT	IsmHndShR		BPL	@50		LDA	#$FE		STA	IsmDataW		; write 4th Adrs Mark byte of $FE		LDA	cyl		@55		BIT	IsmHndShR		BPL	@55		STA	IsmDataW		;write cylinder				LDA	#00		BIT	side		BPL	@60		INC	A@60		BIT	IsmHndShR		BPL	@60		STA	IsmDataW		;write side number				LDA	fmtsect		;@70		BIT	IsmHndShR		BPL	@70		STA	IsmDataW		;write sector		@80		BIT	IsmHndShR		BPL	@80		LDA	#$02		STA	IsmDataW		;format (length in 256's)@90		BIT	IsmHndShR		BPL	@90		STZ	IsmCRCW		;This dummy store writes 2 CRC bytes!** Format a Data Field*fmtmfmData	EQU	*		LDX	#Gap2Size		;		LDA	#gapByte@20		BIT	IsmHndShR		BPL	@20		;wait for FIFO empty		STA	IsmDataW		DEX		BNE	@20				LDX	#syncSize		;@30		BIT	IsmHndShR		BPL	@30		;wait for FIFO empty		STZ	IsmDataW		DEX		BNE	@30				LDX	#0003		; three bytes of $A1 mark Writes@40		BIT	IsmHndShR		BPL	@40		LDA	#$A1		STA	IsmMarkW		DEX		BNE	@40		@50		BIT	IsmHndShR		BPL	@50		LDA	#$FB		STA	IsmDataW		;4th byte of Data mark is just data write		LDX	#0512		LDA	#fmtFillByte	;fill with $FA to id Apple II formatter@60		BIT	IsmHndShR		BPL	@60		STA	IsmDataW		DEX		BNE	@60		@70		BIT	IsmHndShR		BPL	@70		STZ	IsmCRCW		;This dummy store writes 2 CRC bytes!!!** More sectors this track?*		INC	temp		; count physical sectors		LDA	#00		XBA			;force B = 00 for TYA below!!!		LDA	temp		; Sectors out so far		CMP	curnsect		;		BGE	@lastsect		;If that was last sector** Need another sector... update the sector number*		TAY			;this does a 16 transfer to Y		LDA	xlvtab,y		; Translate physical to logical sect#		INC	A		; mfm sectors start at 1 instead of 0		STA	fmtsect		;		BRL	mfmFmtSectLp	;Back for next sectors ** Done with last sector*@lastsect		EQU	*		LDX	#0005		LDY	#gap4bSize		BRA	@80		@turnIndexOn	LDA	#%11110100		STA	IsmPhaseW		@80		LDA	IsmHndShR		BPL	@80		XBA		LDA	#gapByte		STA	IsmDataW		DEX		BEQ	@turnIndexOn		BPL	@88		XBA		BIT	#%00001000	;found index high yet?		BNE	@fmtdone		;yep@88		DEY		BNE	@80		BRA	noFmtIndex		LONGI 	OFF@fmtdone		SEP	#$10				AND	#$20	;		BEQ	@nounder		LDA	#$34	;write underrun error for debug		SEC		BRA	mfmwtexit@nounder		LDA	#00		CLCmfmwtexit		STA	error1	;save where debug is easy** now Back into read mode		LDA	#$08		STA	IsmMode0W	;turn off write mode		JSR	DeSelectISM		RTS** Exit when can't find the Index pulsenoFmtIndex	SEP	#$10		LDA	#$35		SEC		BRA	mfmwtexit		************************************************************************	InitMFMwTrk***********************************************************************InitMFMWTrk	EQU	*		lda	#AD1440KSectors		sta	curnsect	;force this for 1440K** Generate interleave table*		LDA	#$FF		LDX	#AD1440KSectors-1@CLEARXTAB	EQU	*		STA	xlvtab,x		DEX		BPL	@clearxtab*		INX		;X=0		LDY	#0@ALLOCSPOT	TYA		STA	xlvtab,x		INY		;Physical Sector number		CPY	curnsect	;If all sectors placed, we're done		BGE	@xlvdone		TXA		;Move index to A to add		CLC		ADC	Interleave		TAX@CHKBOUND		EQU	*		CPX	curnsect		BLT	@checkspot		TXA		;We wrapped (C=1)		SBC	curnsect		TAX@CHECKSPOT		EQU	*		BIT	xlvtab,x		BMI	@allocspot		INX		BRA	@chkbound@XLVDONE		EQU	*		RTS				TITLE	'GETFORMAT OPTIONS'***************************************************** DoGetFmt   (local 3.5" units)**  Return a list of format options or Offline err**  input : xfrcnt says how big is output buffr is**  Output: like a status command (a buffer of data)****************************************************GETFMTOPT		EQU	*		CLC		;no wp errs please		JSR	SensnChk	;do I have a media online?		BCC	@20	;no 'error' 		BVC	@20	;ignore dsw error@ERR1		BRL	set_err	;return Offline error@20		BPL	@30	;online known volume		JSR	MountVol	;re-mount volume if possible!		BCC	@30	;vol was known type (reformating!)		CMP	#offline	;it went offline between Sens & mount??		BEQ	@err1	;yep. boy that was funny		BRA	@30	;it was I/O error after DIP@PCERR		SEP	#$30		LDA	#bcparmcnt		BRA	@err1*@30		EQU	*		LONGI	ON		REP	#$10		LDY	cmdcount		DEY		BMI	@pcerr	;zero or neg is bad count		CPY	#0768		BCC	@33		LDY	#0512@33		CPY	#0057	;min is 56 bytes		BCC	@pcerr		LDA	#00@35		STA	[cmdbuffl],y	;pre fill user buffer with zero		DEY		BNE	@35	;all but last byte		LONGI	OFF		SEP	#$10				LDX	drive		BIT	UnitFlags,X	;is it a FDHD with MFM media		BVC	StdMedia		;nope!		LDA	#01		STA	[cmdbuffl],y	;entry count is 1		INY		INY		STA	[cmdbuffl],y	;display count = 1		INY		INY		LDA	#AD1440K1		STA	[cmdbuffl],y	;default refnum		LDX	drive		LDA	volsts,x		;current refnum		AND	#$1F		;extract cur voltype		INY		INY		STA	[cmdbuffl],y	;current refnum		REP	#$20		;a = 16 bits		LONGA	ON** Now create a pointer of build entry		LDA	#0008		CLC		ADC	cmdbuffl		STA	csum	;use csum as zpg pointer		SEP	#$20		LONGA	OFF		LDA	cmdbuffl+2		BCC	@36		INC	a@36		STA	csum+2** Now put some entries		LDA	#AD1440K1		JSR	BldFMTentry	;two entries		LDX	#2*16+8		LDY	#00		CLC		RTS		** now fake GetFmt for 400 & 800 K onlyStdMedia		LDA	#02		STA	[cmdbuffl],y	;entry count is 2		INY		INY		LDA	#02		STA	[cmdbuffl],y	;display count = 2		INY		INY		LDA	#AD800K2		STA	[cmdbuffl],y	;default refnum		LDX	drive		LDA	volsts,x	;current refnum		AND	#$1F	;extract cur voltype		INY		INY		STA	[cmdbuffl],y		REP	#$20	;a = 16 bits		LONGA	ON** Now create a pointer of build entry		LDA	#0008		CLC		ADC	cmdbuffl		STA	csum	;use csum as zpg pointer		SEP	#$20		LONGA	OFF		LDA	cmdbuffl+2		BCC	@38		INC	a@38		STA	csum+2** Now put some entries		LDA	#AD800K2		JSR	BldFMTentry	;two entries		LDA	#AD400K		JSR	BldFMTentry	;one entry		LDX	#3*16+8		LDY	#00		CLC		RTS		EJECT**************************************************** BldFMTentry**    Create an entry in the GETFMTOPTS list for the* Format option given in the A-reg* and increment the entry pointer by 16 **    Input : A = format option to create*           csum = pointer to where to put the data**   Output : csum = csum+16****************************************************BLDFMTENTRY	EQU	*		LDY	#00@01		STA	[csum]	;set fmtoption		TAX		LDA	>FmtFlags,x		AND	#$0F	;just flags bits please		LDY	#4		STA	[csum],y		LDA	>FmtFlags,x		LSR	a		LSR	a		LSR	a		LSR	a	;discard the flag bits		LDY	#12		STA	[csum],y;		LDA	>VolSizeTbl,x		LDY	#06		STA	[csum],y		INY		LDA	>VolSizeTbl+1,x		STA	[csum],y		LDY	#10+1		LDA	#>512		STA	[csum],y		LDA	>VolSizeTbl+1,x		LSR	a		LDY	#14+1	;hi byte first		STA	[csum],y		LDA	>VolSizeTbl,x		ROR	a	;shift in bit from hi byte		DEY		STA	[csum],y	;size in Kbytes = blks/2*		LDA	csum		CLC		ADC	#16	;= length of 1 entry		STA	csum		BCC	@30		REP	#$20	;a = 16		INC	csum+1		SEP	#$20@30		EQU	*		LDA	>FmtFlags+1,x	;related entries to do?		BEQ	@90	;no.		TAX		LDY	#02		LDA	[cmdbuffl],y		INC	a		STA	[cmdbuffl],y		LDY	#00		LDA	[cmdbuffl],y		INC	a		STA	[cmdbuffl],y		TXA		BRA	@01	;stick another entry in@90		RTS		EJECT********************************************* Format option tables** This table contains 3 items in low byte* Low Byte  b7..b4  = interleave factor n:1*           b3,b2   = Kbytes format size *           b1,b0   = format flags Univ,Appl,NonAppl* Hi Byte  refnum of related format *     0x is alternate interleave format*********************************************KB		EQU	$04UNIV		EQU	$00APPL		EQU	$01NONAPPL		EQU	$02	; SEG	codeFMTFLAGS		EQU	*	; SEG	fake_itFMTOPT1		DC.B	0,0	;  0 null		DC.B	$20+KB+APPL,0	;  2 AD400K    2:1		DC.B	$40+KB+APPL,$00	;  4 AD800K    4:1		DC.B	$20+KB+UNIV,00	;  6 SD1440K   2:1		DC.B	$10+KB+NONAPPL,00	;  8 AD720K    1:1  		DC.B	$10+KB+UNIV,$06	;  A SD1440K   1:1		DC.B	$20+KB+APPL,$04	;  C AD800K2   2:1FOPTMAX		EQU	*-FMTOPT1-1		DC.W	0000		EJECT***************************************************** DoSetFmt**  Set the format option for the next Format command**  INPUT a format option number (0..maxfopt)**  OUTPUT : Error messages for conflicts between the*           selected option and media density****************************************************SETFMTOPT		EQU	*		LDA	cmdcount+1	;hi byte of clist lgth zero?		BEQ	@10	;yep.@BPCERR		LDA	#bcparmcnt		BRL	set_err@BCERR		LDA	#coderror		BRL	set_err@10		LDA	cmdcount	;get clist byte length		BEQ	@13	;zero parms is default set		CMP	#05		BCS	@bpcerr	;too much data		LSR	a		BCS	@bpcerr		LDA	[cmdbuffl]	;get fmt option		CMP	#foptmax	;check parm range		BCS	@bcerr	;its bad.		AND	#01	;is it odd?		BNE	@bcerr	;bad also.		LDX	drive	;parm in range		LDA	[cmdbuffl]	;get the option again		BNE	@15	;specific fmt requested@13		JSR	Set800KFmt ;reset to defaults		BRA	@20	;and reply 'ok'@15		LDY	#$80		STY	formsides	;assume double sided		CMP	#AD400K	;is it single sided?		BNE	@17		STZ	formsides@17		EQU	*		STA	FmtOption,x		TAX		LDA	>FmtFlags,x	;get interleave from table		LSR	a		LSR	a		LSR	a		LSR	a		STA	Interleave	;set interleave from tbl		LDA	cmdcount	;does clist include 2nd parm?		CMP	#04		BCC	@20	;nope. 		LDY	#02	;offset to interleave		LDA	[cmdbuffl],y	;get interleave override		BEQ	@20	;nope.		CMP	#8+1		BCS	@bpcerr		STA	Interleave	;use callers override interleave@20		EQU	*** For MFM types we must now verify that the drive * is capable of formatting the selected option* NOTE: SetFmt Options doesn't check the current media type * against the selected format since the Format Command will do that		LDA	FmtOption,x		BEQ	@30		;not specific fmt so media type during Format cmd controls 		CMP	#AD1440K		BCC	@30		;not MFM fmt so either drive type is ok		CMP	#AD1440K1+1	;		BCS	@30		;not MFM fmt so either drive type is ok		LDA	#UFfdhd		;can the drive do MFM?		BIT	UnitFlags,x		BNE	@30		;yes drive is an FDHD so mfm is ok		JSR	Set800KFmt	;reset to this unit to default		JMP	@BCERR		;exit with a Code Error (Wrong drive type)@30		CLC		RTS************************************************* ResetFmt************************************************SET800KFMT	LDA	#AD800K		STA	FmtOption,xRESETFMT		EQU	*		LDA	FmtOption,x	;was SetFmt option used?		BEQ	@10		;no. leave interleave,sides alone		LDA	#$80		STA	Formsides		;default GCR is DS & 4:1		LDA	#04		STA	Interleave		STZ	FmtOption,x	;zero means use default@10		RTS		TITLE	'Control Request Handler'*****************************************************************                                                              **  Control                       Handles a control request     **                                                              ******************************************************************CONTROL		EQU	*		LDA	CMDSCode	;Get the control code		CMP	#nccodes	;Check for boundary		BLT	ctrlokay	;It's within range*ILLCODE		EQU	*		LDA	#coderror	;Bad control code		BRL	set_err	; mark an error** Code is okay... do the multi-way branch*CTRLOKAY		EQU	*		ASL	a		TAX		LDA	>cctable+1,x		PHA		LDA	>cctable,x		PHA		RTS*	; SEG	code	;CCTABLE		EQU	*		DC.W	CTRLRESET-1		DC.W	ILLCTRL-1		DC.W	ILLCTRL-1	;Char dev only		DC.W	ILLCTRL-1	;Not interrupt driven		DC.W	CTRLEJECT-1	;Drive eject		DC.W	HOOKSET-1	; set hook address		DC.W	HOOKRES-1	; reset hook address to default		DC.W	MARKSET-1	; Set mark table bytes		DC.W	MARKRES-1	; reset mark table bytes		DC.W	SETSIDES-1	; set single or double sided		DC.W	SETXLV-1	; set interleave	; SEG	fake_it	;*CTRLTEND		EQU	*NCCODES		EQU	(CTRLTEND-CCTABLE)/2**ILLCTRL		EQU	*		JMP	IllCode**CTRLRESET		EQU	*		JSR	initformat	; make it double sided, interleave 4:1		JSR	InitHooks		JMP	Initmarks	; set up mark tables*CTRLSETDCB	EQU	*		JMP	illcode	; not good		RTS		;Pull the command packet* CTRLEJECT		EQU	*		LDX	drive		JSR	EnblnSens	;enable the drive and set sense bits		JSR	Eject	;Do the eject* stz diskreg ;remove /ENBL35		RTS		TITLE	'Define the Device ID'******************************************************************                                                               **  Init                             Define the device UnitID    **                                                               **   Assign the UnitNo in CmdId to the next available drive      **   If all Devices are assigned the return a soft error for     **   SmartPort initialization processing                         **                                                               ******************************************************************INITCMD		EQU	*		LDA	DrvToAssign	;If all assigned return error		BEQ	@30	;yep already done.*		LDY	#00@10		LDA	UnitId,y		BEQ	@20	; no drive 		CMP	#$40	; is this drive assigned?		BCS	@40	;no so assign it and exit@20		INY		CPY	#maxdrivs		BCC	@10	;try next drive*@30		EQU	*		LDA	#lasterror	;thisis a 'soft' error to SmartPort		STA	statbyte		RTS*@40		LDA	cmdUnit		STA	UnitID,y		DEC	DrvToAssign	;count this one		RTS		;		TITLE	'Miscellaneous Commands'******************************************************************* Macread: This will map a protocol converter read call into a*          a 524 byte block read call.******************************************************************MACREAD		EQU	*		JSR	MovBlkNo	;Blknum not quite where we want		BCS	return	;count not = 524		LDA	#CMDRead	;Make it look like a reg'ler read		STA	CMDCode		LDA	#$FF	; mark a mac command		STA	mac_flag	; (doesn't work for MFM disks)		JMP	ReadBlk	;Do a read of the block in question******************************************************************* Macwrite: This routine will  map a protocol converter write call*           into a 524 byte block write call.  ******************************************************************MACWRITE		EQU	*		JSR	MovBlkNo	;Move blknum to the regular place		BCS	return	;count not = 524!!		LDA	#CMDWrite		STA	CMDCode	;This is really a write		LDA	#$FF	; mark a Mac write command		STA	mac_flag	; (doesn't work for MFM disks)		JMP	WriteBlk	;Do a write of the block in question******************************************************************* Movblkno: This routine will discard the two byte count parameter*           associated with the read or write call.  The block number*           will be shifted up two byte and overwrite the count.******************************************************************MOVBLKNO		EQU	*		LDA	cmdcount+1		CMP	#>524		BNE	bhpcount		LDA	cmdcount		CMP	#<524		BNE	bhpcount		LDX	#$00	; reset counterMBN1		EQU	*		LDA	cmdadrs,x	; throw away byte count		STA	cmdblockl,x		INX		; next byte		CPX	#$04	; 4 bytes moved		BLT	mbn1	;		CLCRETURN		EQU	*	;		RTS		TITLE	'Hook set/reset routines'******************************************************************* Hook.set: This routine will set the address field corresponding to a*           hook  number in the firmware of the Dsony drive to a specific*           value.  The contents of the control call parameter list is*           as follows:**                $XXYY +-------------+        Control call # = $05*                      |  count.low  |*                      +- - - - - - -+*                      |  count.high |*                      +-------------+*                      | Hook number |*                      +-------------+*                      |   addr.low  |*                      +- - - - - - -+*                      |   addr.med. |*                      +- - - - - - -+*                      |  addr.high  |*                      +-------------+******************************************************************HOOKSET		EQU	*	;		LDA	#$04	; 4 bytes of parameter		JSR	chk_hpbounds	;		BCS	exit_chk_hpbound	; something went wrong go away		LDA	[cmdbuffl],y	; get the hook #		PHA		; save it		AND	#$7F	; mask off upper bit		BEQ	bad_hook	; 0 < hook < maxhook+1		DEC	A	; point to beginning of ram		CMP	#maxhook	; and make sure it is in range		BGE	bad_hook	; if not, let world know		ASL	A	; hook number times 8 points		ASL	A	; to start area of hook+1		ASL	A	;		TAX		; point to the hook table entry		LDA	#$22	; replace jmp long with jsl		STA	hooks+2,x	; put it in the table		BRA	seth_loop_1	; put it in the tableSETH_LOOP		EQU	*		LDA	[cmdbuffl],y	; get the byte		STA	hooks+2,x	; and put it in the tableSETH_LOOP_1	INX		; point to next hook table byte		INY		; point to next parameter byte		CPY	#$06	; all bytes moved?		BLT	seth_loop	; move three bytes		PLA		; restore hook number		BPL	exit_hook_setup	; all done he wants to fall into my code		LDA	#^return	; force a return		STA	hooks+5,x	; point to bank $FF		LDA	#<return	; low byte of return address		STA	hooks+3,x	;		LDA	#>return	; high byte of return address		STA	hooks+4,x	;EXIT_HOOK_SETUP	BRL	good_exit	; mark success;BAD_HOOK		EQU	*		PLA		; discard hook number		LDA	#bhook_err	; bad hook number error		BRL	set_err	; tell the world		TITLE	'Check set.res.hook param count'**************************************************** Chk.hpbounds: This routine will check the parameter count for*             the set hook and reset hook calls.**     Import: A = compare value*     Export: (Y) points to hook number in [cmdbuffl]****************************************************CHK_HPBOUNDS	EQU	*	;		LDY	#$00	; point to low byte of count		CMP	[cmdbuffl],y	;		BNE	bhpcount	; bad parameter count		INY		; bump to high byte of count		LDA	[cmdbuffl],y	; must be zero		BNE	bhpcount	; non zero = bad news		INY		; point to hook numberGOOD_EXIT:	CLC		; mark success		STZ	statbyte	;EXIT_CHK_HPBOUND	RTS		; >>>--- exit chk.hpbounds --->>>BHPCOUNT		LDA	#bcparmcnt	; bad control param count		BRL	set_err	;***************************************************** Hook.res: This routine will restore a firmware hook to its firmware*            default.**     Import: parameter list*             *             +-------------+        Control call # = $06*             | Hook number |*             +-------------+****************************************************HOOKRES		EQU	*	;		LDA	#$04	; 4 bytes of parameter		JSR	chk_hpbounds	;		BCS	exit_chk_hpbound	; something went wrong go away		LDA	[cmdbuffl],y	; get the hook #		BEQ	res_hooks	; hook #0 resets all hooks		CMP	#maxhook+1	; and make sure it is in range		BGE	bad_hook	; if not, let world know		ASL	A	; times 8 points		ASL	A	; to table entry		ASL	A	;		INC	A	; point to end of hook		TAX		; point to start of address		LDY	#$08RESETH_LOOP	LDA	>hooktab,x	; get the byte		STA	hooks,x	; and put it in the table		DEX		; decrement count		DEY		; decrement count		BNE	reseth_loop	; move three bytes		BRA	exit_hook_setup	; >>>>---- exit resethook ---->>>>;RES_HOOKS		EQU	*	; hook # = 0 reset all hooks		JSR	inithooks	;		BRA	exit_hook_setup	;		TITLE	'Hook set/reset routines'**************************************************** Mark.set: This routine will allow the caller to set a specific*           number of bytes in the mark tables to specific values.*           The count field will be used to determine how many*           bytes need to be moved to the mark tables. The count*           field is required by the protocol converter.  The count*           minus one will equal the number of bytes to move.**     Import:*              (Temp) = byte count, from chk.bounds subroutine*            Ctrllist: +----------+        Control call # = $07*                      | count lo | = $XX*                      +----------+*                      | count hi | = $00*                      +----------+*                      |start byte|*                      +----------+*                      |   data   |*                      +----------+*                      |   data   |*                      +----------+*                      |   data   |*                      +----------+*                        . . . .*                        . . . .**     Export:*             A, X, Y = trash*             (Temp) = $00****************************************************MARKSET		EQU	*	;		JSR	chk_bounds	; make sure starting location ok & size ok		BCS	exit_Mset	; something wrong, go away		LDA	[cmdbuffl],y	; get start pointer		TAX		; point to mark table location		INY		; point to 1st data byteSM_LOOP		LDA	[cmdbuffl],y	; get data byte		STA	marktab,x	;		INY		; bump source pointer		INX		; bump destination		DEC	temp	; decrement count		BNE	sm_loop	;EXIT_MSET		BRL	good_exit	; everybody happy		EJECT***************************************************** Mark.res: This routine will reset a specified number of bytes in*           the mark tables to their rom default values.***     Import:*               (Temp) = byte count, from Chk.bounds subroutine*            Ctrllist: +----------+        Control call # = $08 *                      | count lo | = $XX*                      +----------+*                      | count hi | = $00*                      +----------+*                      |start byte|*                      +----------+**     Export:*             A, X, Y = trash*             (Temp) = $00****************************************************MARKRES		EQU	*	;		JSR	chk_bounds	; make sure starting location ok & size ok		BCS	exit_mres	; something wrong, go away		LDA	[cmdbuffl],y	; get pointer to first byte to change		TAX		;RM_LOOP		LDA	>Marktabvals,x	; get mark table byte		STA	Marktab,x	; place it in ram based table		INX		; point to next lower byte		DEC	temp	; decrement byte count		BNE	rm_loop	;EXIT_MRES		BRL	good_exit	;		TITLE	'Bounds check for set & reset mark'***************************************************** Chk.bounds: This routine will check the starting location against*             number of bytes to be moved into the mark table to*             make sure that we are within range.**     Import: None*     Export: A = index to last byte to be accessed*     Export: C = 0, statbyte = 0 for success*             C = 1, statbyte = $31 for range error*             (Temp) = byte count****************************************************CHK_BOUNDS	EQU	*	;		LDY	#$01	; point to beginning of parameter list		LDA	[cmdbuffl],y	; upper byte must be zero		BNE	invbcount	; too many bytes		DEY		; point to low byte of count		LDA	[cmdbuffl],y	;		DEC	A	; byte count to move = count - 1		STA	temp	; save the count		LDY	#$02	; point past the count		CLC		;		ADC	[cmdbuffl],y	; add starting byte		CMP	#marktablen+1	; and messed up if greater than		BLT	mbok	; mark bounds okINVBCOUNT		LDA	#bcparmcnt	; mark a parameter count error		BRL	set_err	;;MBOK		EQU	*	;		STZ	statbyte	; everybody happy		RTS		; >>>--- exit check bounds --->>>***************************************************** Set.sides: This routine will allow the caller to set the type*            of media inserted into the drive.  By being able to*            change, one can format single sided disks in a double*            sided drive.**     Import: +---------+          Control call # = $09*             | countl  | = $01*             +---------+*             | counth  | = $00*             +---------+*             |  sides  | single = %0xxxxxxx, double = %1xxxxxxx*             +---------+**    Export: C = 0, statbyte = 0*             A,X,Y trashed ****************************************************SETSIDES		EQU	*	;		LDA	#$01	; 1 parameter byte		JSR	chk_hpbounds	; check for 1 byte		BCS	invbcount	; invalid count		LDA	[cmdbuffl],y	; get the number of sides		AND	#$80	; bit 7 = sides bit		STA	formsides	; save number of sides		BRL	good_exit	; mark success		EJECT***************************************************** Setxlv: This routine will allow the caller to change the interleave*         between 1 & 12 inclusive.***     Import:*            Ctrllist: +----------+        Control call # = $0A*                      | count lo |*                      +----------+*                      | count hi |*                      +----------+*                      |Interleave|*                      +----------+****************************************************SETXLV		EQU	*		LDA	#$01	; 1 byte of parameter		JSR	chk_hpbounds	; check bounds		BCS	invbcount	; error if more than one byte		LDA	[cmdbuffl],y	; get the interleave		BEQ	xlverror	; 0< xlv <13		CMP	#maxxlv+1	; check for the max interleave		BGE	xlverror	; greater than 12, something is wrong		STA	interleave	; set new interleave		BRL	good_exit	; everybody happy;XLVERROR		EQU	*	;		LDA	#xlv_err	; mark an interleave error		BRL	set_err	;		TITLE	'Get variable area pointer'***************************************************** Get.vars: This routine will return the start of the variable*           area for the unified drive.  This routine is called*           as a user defined control call in smartport.   ****************************************************GET_VARS		EQU	*	;		CLC		; native mode		XCE		;		PHP		; save e, m, x 		LONGA	ON		LONGI	ON		REP	#$30	;		LDY	#$0000	; destination index		LDA	#vars_area	; return the variables		STA	[cmdbuffl],y	; save it away		INY		; bump index		INY		;		LDA	#data_bank	; save the variables data bank		STA	[cmdbuffl],y	;		LONGA	OFF		;		LONGI	OFF		;EXIT_GV		EQU	*	; Get.buff.addr exits here		PLP		; restore e, m, x		INY		; byte count returned		INY		;		TYX		; x = low count		LDY	#$00	; y = high count		STZ	statbyte	; mark success		XCE		;		CLC		; mark success		RTS***************************************************** Get.buff.addr: This routine will return the address of the*                unified firmware data buffers.****************************************************GET_BUFF_ADDR	EQU	*	;		CLC		; native mode		XCE		;		PHP		; save e, m, x 		LONGA	ON		LONGI	ON		REP	#$30	;		LDY	#$0000	; destination index		LDA	#sectbuf	; buffer start address		STA	[cmdbuffl],y	; save it away		INY		; bump index		INY		;		LDA	#data_bank	; save the variables data bank		STA	[cmdbuffl],y	;		BRA	exit_gv		LONGA	OFF		LONGI	OFF*		TITLE	'Hardware registers setup routine'********************************************************************* Regs.setup: This routine sets up the data bank register, the disk*             register, the CYA register and the command byte will*             be checked for a possible extended command.  If the*             command is an extended command then a flag will be*             set and the extended command bit in the command byte*             will be cleared.**     Import: None*     Export: D = $E1 data bank*             Disk reg = $40 (enable 3.5 asserted)*              CYA reg = 10XXXXXX (fast, NO motor slowdown)********************************************************************REGS_SETUP	EQU	*	;		LDA	#data_bank	; point to my data bank		PHA		;		PLB		;		LDA	cyareg	; must be preserved by caller (SmartPort Mgr)		AND	#$FB	; no motor detect		ORA	#$80	; and fast		STA	cyareg	; put it back		STX	cmdUnit	; save destination unitno		LDA	#$40	; enable sony 3.5 drives		STA	diskreg	; asserts EN3.5 to active (low state)		LDA	cmdcode	; get the command		AND	#ext_cmd	; save possible extended bit		STA	ext_flag	;		LDA	cmdcode	; clear extended command bit		AND	#$BF	;		STA	cmdcode	;		STZ	MFMflag	;MUST start out in GCR/IWM mode every time		IF 1	THEN		LDX	#11@CPYCT		LDA	cmdtab,x		STA	stssav,x		DEX		BPL	@cpyct	;sav a copy for debugging		LDA	cmdUnit		STA	stssav+5	;save unit in the 12 bytes		ENDIF		LDA	#$0F	;7 Mhz no timer fast asynch latch *  fall thru to SetIWMmode **************************************************************** Enter setIWMmode with A set to the IWM mode desired**     INPUT :   A = needed IWM mode*    OUTPUT :   Y = input A reg*    Destorys   A*    Preserves  X***************************************************************SETIWMMODE	EQU	*		TAY		;Preserve the mode byte 		BIT	DeSelect	;deactivate the enables		BIT	l6set	;setup for StatusRd and ModeWr@05		LDA	l7clr	; get the status reg		AND	#$20		BNE	@05	;wait for enable's to drop		BRA	@20@10		STY	l7set	;write the mode register@20		TYA		EOR	l7clr	;compare with low 5 bits of status reg		AND	#$1F	;mask off upper 3 bits		BNE	@10	;try again if it doesn't match		LDA	#$40		TRB	MFMflag	;mark ISM off		LDA	l6clr	;return to read state		RTS***********************************************************************	Setup MFM Decoding parameters**	Assumes that CYL has been determined from blocknum***********************************************************************SetMFMParms	EQU	*		LDA	CYL	;(in the range 0..79)		CMP	#80		BCC	@ok		LDA	#00	;higher is unknown so assume a RECAL will occur@ok		LDX	#-2@loop		INX		INX		CMP	>mfmCylZones,X		BCS	@loop		LDA	>mfmCylZones+1,X	;get the parmamter group offset		TAX		LDY	#5		;retry count@1		LDA	#$18		STA	ISMMode0W		;clear 0->WRITE & ACTION (reset parm adrs to zero)		PHX			;save starting parameter offset@rLoop		DEX		LDA	>mfmParams,X	; x starts at parameter zero		BEQ	@done		CMP	ISMParmsR		; must read parameters in sequence		BNE	@Wparms		BRA	@rLoop@done		PLX		CLC		RTS			;Parameters all matched so It worked@Wparms		LDA	#$18		STA	ISMMode0W		;reset param auto inc ctr to zero		PLX		PHX@wLoop		PHA		PLA		DEX			;delay a few cycles		LDA	>mfmParams,X		BEQ	@Wdone		STA	ISMParmsW		;have to write all 16 parms in sequence		BRA	@wloop		;nope@wDone		PLX			;get index back for retry &/ exit		DEY			BNE	@1		;so go back and read em all again or retry		SEC		RTSmfmCylZones	DC.B	40,17		DC.B	80,34		DC.B	80,00		DC.B	80,00		mfmParams		DC.B	0		DC.B	(31-2)*2+1	;[F] Time1 = 31.5		DC.B	$57		;[E] Early/Norm = $57		DC.B	(15-2)*2+1	;[D] Time0 = 15.5		DC.B	$97		;[C] Late/Norm = $97		DC.B	(14-2)*2+1	;[B] LLS = 14.5		DC.B	(14-2)*2+1	;[A] LLL = 14.5		DC.B	(25-2)*2+1	;[9] LSS = 25.5		DC.B	(25-2)*2+1	;[8] LSL = 25.5		DC.B	(15-2)*2+1	;[7] CSLS = 15.5		DC.B	(15-2)*2+1	;[6] RPT = 15.5		DC.B	(14-2)*2+0	;[5] SLS = 14.0		DC.B	(14-2)*2+0	;[4] SLL = 14.0		DC.B	(25-2)*2+0	;[3] SSS = 25.0		DC.B	(25-2)*2+0	;[2] SSL = 25.0		DC.B	65		;[1] Mult = 65		DC.B	(15-3)*2		;[0] Min = 15.0			DC.B	00				DC.B	(31-2)*2+1	;[F] Time1 = 31.5		DC.B	$57		;[E] Early/Norm = $57		DC.B	(15-2)*2+1	;[D] Time0 = 15.5		DC.B	$97		;[C] Late/Norm = $97		DC.B	(14-2)*2+1	;[B] LLS = 14.5		DC.B	(14-2)*2+1	;[A] LLL = 14.5		DC.B	(25-2)*2+1	;[9] LSS = 25.5		DC.B	(25-2)*2+1	;[8] LSL = 25.5		DC.B	(15-2)*2+1	;[7] CSLS = 15.5		DC.B	(15-2)*2+1	;[6] RPT = 15.5		DC.B	(14-2)*2+0	;[5] SLS = 14.0		DC.B	(14-2)*2+0	;[4] SLL = 14.0		DC.B	(25-2)*2+0	;[3] SSS = 25.0		DC.B	(25-2)*2+0	;[2] SSL = 25.0		DC.B	65		;[1] Mult = 65		DC.B	(15-3)*2		;[0] Min = 15.0		************************************************************************ Select ISM mode of SWIM*	*	Assumes that SETIWMMODE above has been called first*	and that the currently in IWM mode fast mode***********************************************************************EnableISM		EQU	*		JSR	SelectISM			LDA	IsmSetupR		LDA	#%00100010		STA	IsmSetupW	;assert EN3.5 (make it low for 15.6672 Mhz FCLK)		LDA	IsmSetupR		LDA	#$18		STA	IsmMode0W	; 0-> WRITE & ACTION bits		LDA	#$40		STA	IsmConfigW ;config timer for 15Mhz FCLK		LDA	#$20		STA	IsmMode1W ; 1-> HDSEL (ISM MODE INDICATOR for debug!)		LDA	IsmModeR		RTS**********************************************************************SelectISM		EQU	*		BIT	MFMflag		BVS	@alreadyISM		BIT	DeSelect	;disable the IWM drive enable (starts Drive's Timer!)		LDA	#$4F		BIT	l7clr	;make sure were not in write		STA	l6set	;setup for write to IWM mode Reg		STA	l7set		EOR	#$40	;turn the bit off		STA	l7set	; continue the tap dance		EOR	#$40		STA	l7set		STA	l7set	; finish the fast slow fast fast dance steps		LDA	#$40		TSB	MFMflag@alreadyISM	LDA	IsmModeR		LDX	drive		LDA	>DrivSelBit,X		STA	IsmMode1W	;select the proper drive		LDA	#$80		STA	IsmMode1W	;Re-enable the selected drive (so it can't timeout)		LDA	IsmPhaseR		LDA	IsmModeR		RTSDrivSelBit	DC.B	02	;enable for drive 1		DC.B	04	;enable for drive 2************************************************************************ DeSelect the ISM mode of SWIM**	Assumes that SelectISM above has been called and that SWIM*	is still in ISM mode***********************************************************************DisableISM	EQU	*		LDA	#$18		STA	IsmMode0W	;insure action and write are OFF!		LDA	IsmSetupR		AND	#00	;reset all bits in setup register		STA	IsmSetupW	;reset FCLK to 7.159 Mhz 		STZ	ISMConfigW ;config for 8Mhz clock		LDA	#$20		STA	IsmMode0W	; (HDSEL = 0 means ISM mode off for degug)		JSR	DeSelectISM		LDX	drive		JMP	EnblDrivX	;reSelect drive before timer drops it		DeSelectISM	EQU	*		LDA	#$B8	;reset DrvEnable,HDSEL,Write,Action bits		STA	ISMmode0W			LDA	 #$40		STA	ISMmode0W		LDA	#$40		TRB	MFMflag	;mark ISM off		BIT	l7clr		BIT	l6clr	;put IWM back into read mode		LDX	drive		JMP	EnblDrivX	;reselect drive via IWM switches***********************************************************************	Select IWM mode if ISM is enabled**********************************************************************SelectIWM		BIT	MFMflag	;is ISM enabled?		BVC	@exit		JSR	DeSelectISM@exit		RTS		TITLE	'Survey GCR Volume Type'********************************************************************* Determine the type of volume in drive** complex for SWIM and FDHD's*  06 =720 08 =1440 and 00 = unknown*********************************************************************ID1MEGVOL		EQU	*; To add support for 720K the IDGCRVol routine must Ident MFM volumes if GCR ID fails		LDA	#3	;three non timeout retries		STA	readret@60		JSR	rdaddr	;find an adrsmark		BCC	@70	;found a good one no errors		DEC	readret		BEQ	@err		BIT	temp	;if temp is positive		BPL	@60	;mark was found but CS/BS error@ERR		SEC		RTS@70		LDX	drive		LDA	volsts,x		AND	#%00100000 ;preserve only WP status		STA	volsts,x				LDA	DblSided	;get DS flag from rdaddrs		ORA	unitflags,x		STA	unitflags,x		BMI	@80	;its a dbl sided vol type		LDA	#AD400K	;02 = 400K SS 		BRA	@90@80		LDA	#AD800K	;800K = 04@90		ORA	VolSts,x		STA	Volsts,x		CLC		RTS********************************************************************* * MountVol**	Assumes the proper drive has been selected*********************************************************************MOUNTVOL		EQU	*		PHP		PHA		STX	drive		JSR	UnkVolx	;assume failure: unktyp to volsts** take no prisoners and verify /DIP		LDA	#dipadr		JSR	ReadBit	;		SEC		;assume its offline		BPL	@10	;some people never lie		PLA		;discard input A-reg		LDA	#offline	;return OFFLINE error		BRA	@errxit*@10		LDA	#UFfdhd		BIT	UnitFlags,X	;is this a FDHD drive?		BEQ	@20		;NO. so must read media to get type; To add support for 720K the IDGCRVol routine must Ident MFM volumes if GCR ID fails		LDA	#MediaAdr		JSR	ReadBit		BMI	@20		;not HD media so read media to get type		LDA	#$80		STA	DblSided		ORA	#UFmfm		;add the is MFM bit to unitflags (should be in volsts!)		ORA	unitflags,x		STA	unitflags,x	;make it dbl sided				LDA	volsts,x		AND	#%00100000	;preserve only WP bit		ORA	#AD1440K		;and volume type (assumes its formatted)		STA	volsts,x		JSR	RDMODE		;leave drive as if it rdaddr was called		CLC		PLA		BRA	@90	;exit with mounted and 1440K type** now have DIP to read and survey for voltype@20		JSR	MotorON	;turn motor on		JSR	Recal	;recal to zero for Survey		STZ	side	;force 0 for single sided		LDX	drive		JSR	ID1MegVol	;determine the volume type please		PLA		BCC	@90	;voltype identified!		LDA	#ioerror	;DIP but unreadable is blank media!!@ERRXIT		PLP		SEC		;return an error instead of voltype		RTS@90		PLP		RTS***********************************************************************	SetDrivMode** Only called from MotorOn if motor is off ***********************************************************************SetDrivMode	EQU	*		LDX	drive		LDA	#UFfdhd		BIT	unitflags,X	;is this an FDHD unit?		BEQ	@doNothing	;nope so it can't change modes		LDY	#DrivMFMadr	;assume MFM mode set (6)		BIT	UnitFlags,X	;is volume MFM HD media?		BVS	@itsMFM		;YES!		INY			; GCR Mode (7)@itsMFM		LDA	#MFMmodeAdr	;should do this in SensNChk for FDHD's		JSR	ReadBit		;read the drive's current mode		BMI	@drivIsMFM	;sense drive Mode (1 = mfm mode)@drivIsGCR	CPY	#DrivGCRadr	;is it in the right mode?		BEQ	@doNothing	;yep		BRA	@setMode@drivIsMFM	CPY	#DrivMFMadr	;is it in the right mode?		BEQ	@doNothing	;yep.@setMode		TYA			JSR	WriteBit		;send cmd to set FDHD mode		LDA	#MFMmodeAdr		JSR	ReadBit		BMI	@ckMFM		CPY	#DrivGCRadr		BEQ	@doNothing@bad		BRK	$d3@ckMFM		CPY	#DrivMFMadr		BNE	@bad@doNothing	RTS		TITLE	'Configure the Drive(s)'********************************************************************                                                                 **  Configure                   Look for drives and set those fnd  **                                                                 **    This clears the drive parameters UnitFlag & UnitID & looks   **   at each drive to see if there is a drive there.  If a         **   drive is present, it stores a value in the ID byte.  The ID   **   byte values are as follows:                                   **             ID              Meaning                             **          00000000           No drive connected                  **          01000000           Drive connected needing ID assign   **          1xxxxxxx           Drive connected with ID             **   This routine also sets the DrvToAssign byte to the number of  **   drives that need IDs.                                         **                                                                 **   Values set:                                                   **     twosided  <-  $80 Double sided default                   **     UnitID    <-  $00 No Drive, $40 Drive needing ID         **     DrvCnt       <-  number of drives connected                 **                                                                 ********************************************************************CONFIGURE		EQU	*		LDA	#VSoffline		LDX	#maxdrivs-1@10		STA	volsts,x	;reset volume status to offline		STZ	UnitID,x		STZ	UnitFlags,x	;clear unitmode bits		DEX		BPL	@10		STZ	DrvToAssign		STZ	UnitCnt		LDA	#$A0	;constant for BIT		STA	fakebit		SEC		ROR	mideject** Do this for maxdrivs drives         *		LDX	#maxdrivs		BRA	@40*@20		EQU	*** Turn on the right drive*		JSR	EnblDrivX	;Drive enabled  *		JSR	IS35drive	; look for the drive		BCS	@40	; nothing present so skip it** There's a drive here		LDA	#ejct_reset		JSR	WriteBit	;clear dsw on Cold or Appl-Ctrl-Reset** Now mark the drive stuff		INC	DrvToAssign		INC	UnitCnt	;save a unit count too		LDA	#$40		STA	Unitid,x*		LDA	#FDHDAdr	;see if its an Apple FDHD		JSR	ReadBit		BPL	@30	;nope		LDA	#UFfdhd		ORA	UnitFlags,x		STA	UnitFlags,x	;set the driv type bit*@30		EQU	*		LDA	cmdcode		AND	#%10111111		CMP	#cmddefid		;fixed 5/29/91 JOA (was initcmd!)		BNE	@35		BIT	cmdscode	; allows special INIT command to skip Sens & MountVol!!		BVS	@40	;don't do this now@35		JSR	SensX	;set volsts per sense bits		CLC		; MountVol preserves carry		JSR	MountVol	;identify volume type if possible		BCC	@40	;vol type now known** No address field was found.  This could be because:*  1)  A dummy disk is in place*  2)  The cassette compartment is down but no disk is in place*  3)  There is a blank piece of media or plastic shipdisk*   -> Eject the media in all cases.*		JSR	eject*@40		EQU	*		DEX		;Maybe a next drive		STX	drive		BPL	@20	;Maybe another drive*		BIT	DeSelect		RTS************************************************************************ IS35drive    This routine will check a Dsony drive present on a*              previously specified enable line.  The routine tries*              to set the direction on the drive and then check if the*              direction has changed.  The direction gets set in, out*              and in again.  If it passes all three checks then we*              assume that a drive is present.  On exit carry will be*              cleared if a drive is found and set otherwise.**     Import: The specific enable set prior to calling the routine*     Export: C = 0 if drive found*             C = 1 if drive not found*******************************************************************IS35DRIVE		LDA	#dirinadr	; point the drive head in		JSR	writebit	;		JSR	readbit	; get the status		BMI	@10	; can not see it		LDA	#diroutadr	; point towards edge of disk		JSR	writebit	;		JSR	readbit	; get the status		BPL	@10	; something wrong		LDA	#dirinadr	; point in again		JSR	writebit	; set direction in		JSR	readbit	;		CLC		; assume drive found		BPL	@20	; and go away@10		SEC		; no drive@20		RTS		TITLE	'Seek Routine'***************************************************                                                **  seek                     Seek to a cylinder   **                     Assume curcyl is correct   **                                                **   Input:    cyl <- cylinder to seek to         **             drive <- drive on which to seek    **             curcyl <- head rests here          **   Output:   C <- set if seek error occurred    **             curnsect <- # sectors this cyl     **   Uses:     recal, sendsteps, WriteBit         **   Regs:     A <- error2 (if carry set)         **   Destroys: X, Y                               **                                                ***************************************************	; SEG	fake_it	;SEEKA		EQU	*		STA	cyl	; SEG	code	;SEEK		EQU	*	; SEG	fake_it	;		JMP	SeekHook** If drive is offline (cyl unknown), do a recal		LDX	drive		BIT	curcyl,x	;Set N to online		BPL	@05	;If cyl known, skip recal		JSR	recal		BCS	seekerr@05		EQU	*** Determine # of steps to take, and direction		SEC		LDX	drive		LDA	curcyl,x		SBC	cyl	;Calculate delta 		BEQ	seekdone	;If on track, skip down** At this point, C clear means inward seek, ow out		LDY	#diroutadr	;Assume outward seek 		BCS	@10	;Branch on outward seek*		LDY	#dirinadr	;Setnasrt value for inward seek		EOR	#$FF	;Gotta convert the negative delta		ADC	#1	;Carry was already clear *@10		EQU	*		TAX		;Move delta to X reg		TYA		;Set up to set the direction		JSR	WriteBit** Now do the stepping; delta in X		JSR	sendsteps	;Send the step pulses *SEEKDONE		EQU	** * Update the current cylinder byte and exit error free 		LDX	drive		LDA	cyl		STA	curcyl,x*		JSR	cylsect	;Map to sectors this cylinder		STA	curnsect	;Update # sectors this cyl*		CLC		;Return Good!		RTS** Flip the seek error bit on (carry set previously) SEEKERR		EQU	*		LDA	#seekerror		ORA	error2		STA	error2SKERR		EQU	*		RTS		TITLE	'Track Stepping Routine'***************************************************                                                **  sendsteps           Steps a number of tracks  * *                        assume IWMDIR to drive  **                                   and dir set  * *                                                **   Input:    X <- number of tracks to step      **   Destroys: A, Y                               **             X cleared                          **                                                **  (Delays after stepping until /READY is valid) **                                                ***************************************************SENDSTEPS		EQU	*** Take a step*		LDA	#step0adr		JSR	WriteBit** Wait for handshake from drive*SS1		JSR	IWMsense		BPL	ss1** See if more steps to do*		DEX		BNE	sendsteps** The current Sony /READY is not valid for 150 microseconds after a*  step pulse.*		LDX	#$4F	; constant for 150 usec delayWAIT150M		DEX		BNE	wait150m		RTS		TITLE	'Recalibrate'***************************************************                                                **  recal                       Seek to track 0   **                                                **   Input:    drive <- current drive             **   Output:   curcyl <- 0                        **             C <- clr:okay, ow step/sensor err  **             X <- drive                         **   Destroys: A, X, Y                            **                                                ***************************************************RECAL		EQU	*** Set the step direction to out*		LDA	#diroutadr		JSR	WriteBit*		LDA	#tk0adr		JSR	ReadBit	;is is already at trk0?		CLC		BPL	@30	;yes. so alldone** Send a whole bunch of step pulses*		LDX	#recaltrks		JSR	sendsteps** Now wait for /TK0 with timeout*		LDX	#recaltrks+5	;head settling = 5 trk seeks@10		LDA	#tk0wait	;Gonna wait a few ms		JSR	waitms*		LDA	#tk0adr		JSR	ReadBit		CLC		BPL	@30	;=> Saw track 0 *		DEX		BNE	@10** Never saw /TK0*@20		EQU	*		SEC@30		EQU	*		LDX	drive		STZ	curcyl,x		RTS		TITLE	'Eject the Diskette'***************************************************                                                **  eject                   Ejects the diskette   **                                                **   Output:   C <- set if eject fails            **   Destroys: A,X,Y                              **                                                ***************************************************EJECT		EQU	*** Make sure there is a disk in there		LDA	#dipadr		JSR	ReadBit		BMI	@90	;no. so insure it unmounted!*		LDX	drive		LDA	curcyl,x	;save current posn		BPL	@01		LDA	#00	;if cyl unknown Seek does a Recal@01		PHA		;save it for later		LDA	#79	;pull head inward  BUT don't verify		JSR	SeekA	;arrival since RdAdrs is the only means** Must first turn off the motor		LDA	#mtroffadr		JSR	WriteBit** And you gotta wait minimum of 200 milliseconds (Kamoto says)		PLA		STA	cyl		LDA	#80		SBC	cyl	;calc length of seek  		CMP	#34	;33 is to few		BCS	@03		LDA	#34	;at minimum wait is 200 ms@03		STA	cyl	;eg IF A = 80		ASL	a	; THEN A =160 		CLC		; PLUS     80 = 240 * 2 = 480 Ms		ADC	cyl	; EQUALS  6ms / 80trks = 480 ms		JSR	Wait2Ms	;wait 6ms / trk (min 200)*		LDA	#EjectRetries	;# of attempts to eject		STA	seekret** Now set a flag that says we're in the middle of an eject this drive*  This is important in case we're reset while ejecting		LDX	drive		STX	MidEject@10		EQU	*		LDA	#eject1adr		JSR	WriteBit;		LDA	#EjectTimeOut		STA	readret	;This many groups of 10 ms timeout@20		EQU	*		LDA	#10		JSR	waitms	;Wait a while** Now see if the cassette actually out *		LDA	#dipadr		JSR	ReadBit		BMI	@40		DEC	readret		BNE	@20	;Maybe next time** Failed an attempt.  Maybe send the command again.*		DEC	seekret		BNE	@10** Disk was NOT ejected.  Set carry and return.		LDA	#ioerror	;Set up error byte		BRL	set_err	; mark an error** The disk was ejected. UnMount volume  (clear state vars)@40		EQU	**		LDA	#1		JSR	waitms		SEC		ROR	MidEject	;Clear the mideject flag*@90		LDX	drive		JSR	OfflineX	;clear volsts and set offline (X)		CLC		RTS*******************************************************************                                                               **  WaitRdyTO   Waits for /READY for 1.5 seconds                 * *                                                               ******************************************************************WAITRDYTO		EQU	*** Set up to read the /READY line*		LDA	#readyadr		JSR	ReadBit	;Set the control lines		BIT	l7clr		BMI	@10	;its not ready on 1st try@RDY		CLC		RTS** Now Poll for /Ready for 1.5 seconds max@10		LDX	#>15000		LDY	#<15000@20		LDA	#01		JSR	wait100us	;waste about .1 ms		BIT	l7clr	;and test again		BPL	@rdy		DEY		BNE	@20		DEX		BNE	@20		SEC		RTS		EJECT************************************************************* MotorOn************************************************************MOTORON		EQU	*** First check if the motor is on already*		LDA	#mtronadr		JSR	ReadBit		BPL	@90** Now the drive mode must be checked and set if its wrong*			JSR	SetDrivMode** It wasn't.  Turn it on now.  Control lines are already set.*		LDA	#mtronadr		JSR	WriteBit** Have to wait either 50 or 500 milliseconds before proceeding*		LDX	drive		LDA	#UFchukwait	;		BIT	UnitFlags,x		BNE	@10		ORA	UnitFlags,x		STA	Unitflags,x	;set the chuckwait done bit		LDA	#InMupWait	;500 		BRA	@20@10		LDA	#StdMupWait	;100@20		JSR	wait2ms	;Wait some time@90		RTS		TITLE	'Low Level Drive Control Routines'***************************************************** SetHead***************************************************SETHEAD		EQU	*		LDA	diskreg	; get disk/hdsel register		AND	#$7F	; mask off head select bit		BIT	side	; check which side		BPL	shead0	; set head 0		ORA	#$80	; else set head 1SHEAD0		STA	diskreg	; set it		RTS****************************************************                                                **  ReadBit                Control routines for   **  WriteBit       reading/writing signals from   **                               the SONY drive   **                                                **                                                **   Input:    A <-  X X X X CA1 CA0 SEL CA2      **   Regs:     A cleared (ReadBit: IWM status)    **             X preserved                        **             Y destroyed                        **   Time:     72 microsecs (inc JSR)             **                                                ***************************************************READBIT		EQU	*** Set up the control lines*		JSR	sdclines** Now read the sense line from the IWM into the N flag*IWMSENSE		BIT	l6set	;Set L6 		LDA	l7clr	;Read the status		RTS**********************************************************   WriteBit***********************************************************WRITEBIT		EQU	*** Set up the lines, then 'LSTRB' Acc's lsb over*		JSR	sdclines*PULSELSTB		BIT	lstrbset	;Raise LSTRB		BIT	lstrbclr	;Lower it after 2 micros (twice spec)		RTS		EJECT************************************************************* SDCLINES***********************************************************SDCLINES		EQU	*** Must set CA0, CA1 before changing HDSEL 1->0*		BIT	ca0clr		BIT	ca1set		BIT	lstrbclr	;** Set CA2 per Acc lsb*		BIT	ca2clr	;Assume lsb clear		LSR	a	;lsb -> C; Acc has 0XXXX CA1 CA0 SEL		BCC	sdcla	;=> We were right		BIT	ca2set	;We were wrong, set CA2** Deal with SEL setting*SDCLA		EQU	*		LSR	a	;SEL -> C; Acc has 00XXXX CA1 CA0		PHA		;Hold that thought		LDA	diskreg	;Assume SEL will be 0		AND	#$7F	; => I'm just psychic		BCC	sdclb	; Luckily HDSEL is lsb		ORA	#$80	; set Hdsel to a oneSDCLB		STA	diskreg	; Finally set SEL correctly		PLA		;Get CA0 & CA1 back** Now for CA0, CA1. CA0 is low, CA1 is high,*  clear them if we were asked to.*		LSR	a	;C has CA0		BCC	sdclc	;If 0, nothing to be done		BIT	ca0set	;Okay, set it*SDCLC		LSR	a	;Get the CA1		BCS	sdcld		BIT	ca1clr	;Clear it*SDCLD		RTS********************************************************************                                                                 **  EnblUnitX      Enable unit given in X-reg if it exists         **                                                                 **    Input   X-reg : 0/1 - Specify the unit to enable             **    Output  A : destroyed                                        **         X &Y : preserved                                        **            C : clr if drive enabled, set if drive non-existant  **                                                                 ********************************************************************* Check if this drive is connectedENBLUNITX		SEC		LDA	UnitId,x	;does unit exits?		BEQ	enexit	;yes***************ENBLDRIVX		BIT	enable1,x	; enable proper drive ;		BIT	Select	; activate the enable line		CLCENEXIT		RTS****************DRIVESOFF		EQU	*		BIT	DeSelect	; deactivate the drive enable		RTS		EJECT************************************************************ EnblnSens****************************************************************ENBLNSENS		EQU	*		BIT	enable1,x	; enable proper drive ;		BIT	Select	; activate the enable lineSENSX		LDA	volsts,x		STA	priorsts	;save for history compares		AND	#$1F	;preserve voltype index		ORA	#VSwrprot	;preset b5 so EOR resets		STA	volsts,x		TXY		LDX	#3@10		LDA	>sensbit-1,x		JSR	readbit		BPL	@20		LDA	>statbit-1,x		EOR	volsts,y		STA	volsts,y@20		DEX		BNE	@10		TYX		LDA	#VSwrprot		BIT	volsts,x		RTS*	; SEG	codeSENSBIT		DC.B	WPROTADR,DIPADR,EJCTADRSTATBIT		DC.B	VSWRPROT,VSOFFLINE,VSEJCTED	; SEG	fake_it************************************************************* SensnChk**   Sense the drive status and return priority encoded errors* as follows:** Enable drive and save 3 Sense bits in volsts* IF media Offline* THEN 'Offline' the volsts :*    : If dsw Then clear dswlatch : EC = 00*                  if ext.cmd then EC = Disk Switched ($2E)*                  else EC = Offline ($2F) *    : Err = 1 : rtn n,v bits  : exit* ELSE Disk-in-Place   *   If dsw Then 'UnMount' volsts : clear dswlatch *        : if ext.cmd then EC = $2E : Err = 1: rtn n,v bits : exit* IF Mode = Write THEN If WritProt Then EC = $2B : Err = 1 : exit* IF voltype = unknown THEN mount =1 * RETURN**  INPUT :   R/W Mode = Carry   Set = Write   Clr = Read** OUTPUT :               Err EC Mnt /DIP*   case description      C   A  N  V (Carry, A-reg, N-flag, V-flag)* -------------------------------------------------------------------* No Media    & DSW set   1  $2E 1  1 Disk Switched (extended cmd)* No Media    & DSW set   1  $2F 1  1 Offline error (std cmd)* No Media    & DSW clr   1  $2F 0  1 Offline after dsw cleared* DiskInPlac & DSW set    1  $2E 1  0 Disk Switched (extended cmd)* DiskInPlac & Wp & DSW   1  $2B 1  0 NoWrite (std cmd & write mode)* DiskInPlac & Wp & noDSW 1  $2B 0  0 NoWrite (std cmd & write mode)* DiskInPlac & DSW set    0  $00 1  0 MountVol   (std cmd)* DiskInPlac & Dsw clr    0  $80 1  0 MountVol unknown voltype * DiskInPlac & Dsw clr    0  $00 0  0 Known online volume (at last)* ************************************************************SENSNCHK		EQU	*		PHP		;save R/W mode		LDX	drive	;enable and check drive		JSR	EnblnSens	;get the drive status bits		BVC	@DIP	;Drive carrier down (and thus media?)** Volume is OFFLINE		PHP		;save n flag		JSR	OfflineX	;clear volume type and set offline		PLP		BPL	@05	;offline and not DSW		JSR	ClearDSW	;clear drive latch and rtn dswerr 		BCS	@10	;have dsw error to return@05		LDA	#offline	;if not dsw then Offline error@10		PLP		;discard R/W mode 		BRA	@chkerr	;exit with WP error** here IF ONLINE true@DIP		BPL	@WPtest	;DIP but not DSW!* OK do DIP true and eject true also		JSR	UnkVolX	;set volsts to online but unknown		JSR	ClearDSW	;clear drive latch 		BCS	@10	;its dswerror!** Now do the Write Protect check@WPTEST		PLP		;carry set say return WP error		BCC	@volchk	;read mode so don't check WP		LDA	#VSwrProt		AND	volsts,x	;NE if Wprot and Write		BEQ	@volchk	;no WP error		LDA	#WPerror@CHKERR		SEC		BRA	@exit** Now have Online, no dswerr, no WP err@VOLCHK		LDA	volsts,x	;volume type is low 5 bits 		AND	#$1F	;drop sense bits		CLC		;return no error!		BNE	@noerr	;yeah. a normal access to known voltype		BIT	volsts,x		LDA	#$80	;force n=1 preserve v and c=0		RTS@NOERR		LDA	#00@EXIT		BIT	volsts,x		RTS******************************************** Clear DSW etc**  INPUT : X = drive number (0,1)**  OUTPUT: A = 00 or $2E *          A = dswerror if extended cmd *          C = 1 if err*          C = 0 if no error********************************************CLEARDSW		EQU	*		LDA	#ejct_reset		JSR	WriteBit	;clear the drive latch		LDA	#00		CLC		BIT	ext_flag		BVC	@10		LDA	#dswerror	;replace callers with mine		SEC@10		RTS		TITLE	'Time Delay Subroutines'***************************************************                                                **  waitms        Wait the specified # millisecs  * *                         assuming a 2MHZ clock  **                   (accurate to roughly +0.7%)  * *                                                **  If code straddles pages, it is less accurate  **                                                **   Input:    A <- milliseconds of delay         **   Destroys: A; temp and temp2 cleared          **   Prserves: X, Y                               **                                                ***************************************************WAIT2MS		EQU	*		PHA		JSR	waitms		PLA*****************WAITMS		EQU	*	;Time= 0.0005*(A*2013+9) *                              ;    = Acc * 1.007 millisecs		STA	temp2	;(3) 		LDA	cyareg	; slow down		PHA		; save old settings		AND	#$7F	;		STA	cyareg	;*WAITB		LDA	#tconstant	;(2) waitb is >1022 slow cycles 		STA	temp	;(3) *WAITA		DEC	temp	;(5) waita is 10 cycles		NOP		;(2) 		BNE	waita	;(3,2) *		DEC	temp2	;(5) 		BNE	waitb	;(3,2) *		PLA		;(4) restore cya register		STA	cyareg	;(4)		RTS		;(2) = 25+20= 45		Wait100us		STA	temp2	;(1)		LDA	CYAreg	;(2) = 3		PHA		;(1) = 4		AND	#$7F	;(1) = 5		STA	cyareg	;(2) = 7		LDA	#7	;(2) = 11	   7*10 + 35 = 105		STA	temp	;(3) = 14		BRA	WAITA	;(3) = 17 + 18 = 35************************************* Offline** Reset all variables for media  Offline*******************************************OFFLINEX		EQU	*		LDA	#%01000000	;set offline bit		ORA	Volsts,x		STA	Volsts,xUNKVOLX		LDA	UnitFlags,x		AND	#%00101111	;enable chukwait next DIP access		STA	UnitFlags,x		LDA	#$FF		STA	curcyl,x	;reset to unknown track ($FF)		LDA	volsts,x		AND	#%11100000	;scratch voltype		STA	Volsts,x	;volume status to unknown		RTS		TITLE	'Block Mapping Routine'***************************************************                                                **  BlkMap           Map the block number to      **                       track, sector, side      **                                                **   Input:    CmdBlockl,h <- block to convert    **             drive <- current device            **             twosided <- for the current dev    **   Output:   cyl, sector, side                  **   Uses:     TrackSect                          **   Regs:     A <- sector                        **             X <- drive                         **   Destroys: Y, temp                            **   Max time: 316 microsec  (2MHZ)               **                                                ***************************************************BLKMAP		EQU	*		LDX	drive		LDA	volsts,x		AND	#$1F		;extract voltype		TAY		LDA	UnitFlags,x		CPY	#02		;single sided?		BNE	@05		AND	#-1-UFdblsided		BRA	@06@05		ORA	#UFdblsided	;set flag for Dblsided vol type@06		STA	UnitFlags,x	;		BIT	MFMflag		;is this MFM volume?		BMI	MFMBlkMap		;yes. has fixed sects/trk** Preserve the low order six bits		LDA	CmdBlockl		AND	#$3F		STA	sector** Obtain a table driven "guess" for the track, sector.*  Get index into table with CmdBlock div 64.		LDA	cmdBlockl	;		STA	temp	;dexxxxxx		LDA	cmdBlockh	;0000 0abc  (max of 06)		ROL	temp		ROL	A	;0000 abcd		ROL	temp		ROL	A	;000abcde = Block DIV 64** If this disk is 800K GCR offset to second half*  of the track and sector tables.* 		BIT	UnitFlags,x	;is this single sided GCR vol?		BPL	@10	;yes.*		CLC		ADC	#13*@10		EQU	*		TAX		; set up table index		LDA	>sectab,x	; sector number		PHA		; save it		LDA	>tracktab,x	; track number		TAY		; save it		PLA		; restore sector number** Y now has the track and A has the sector of the*  requested CmdBlock with the low six bits clear.*  Now we add the low six bits and correct an *  illegal mapping by subtracting off tracks*  of sectors.		LDX	drive	;TrackSect will need this		CLC		ADC	sector@20		PHA		;Preserve the sector number 		JSR	TrackSect	;A <- # sectors on current track 		STA	temp	;Keep A 		PLA		;Pull back sector number 		CMP	temp	;Bigger than # on this track? 		BLT	@30	;No: block's been mapped; branch 		INY		;Next track 		SBC	temp	;Subtract # sectors that track 		BRA	@20	;Try again ** Acc now has the sector, and X now has the track. *  In the case of a two sided disk, the track is*  actually twice the cylinder, so correct for that.**********************************************  Note that the carry is clear here.   ****@30		STY	cyl		STA	sector		BIT	UnitFlags,x		BPL	@40** The track (A) is really the cylinder*2 plus the side.*  -> CCCCCCCS. Div by two puts cyl->A and side->carry.		LSR	cyl@40		ROR	side	;shift in c=0 if 400K		LDA	sector	;recover a reg		RTS		eject************************************************************************  MFM BlkMap is always double sided and 36 sect per cylinder*  since only 1440K is supported (720K is 18 sects per cylinder)**********************************************************************mfmBlkMap		EQU	** How about a segmentation algorithm that converts the block number by* first looking thru a 16 entry table of block numbers that has the* base block number and compute by subtraction the remainder block count * that can have blks/track subtracted repeatedly to determine the final track number.* This divides the block number into 16 groups of 10 tracks (5 cylinders) and leads to* at most 9 subtracts to finish the divide operation;	i = 15 // 15*2 = 30;	if (Blknum >= RangeTbl[i] );	{  remainder = blknum-RangeTbl[i];;	   while (remainder >= trktbl[j];) j++;;	}		LDX	#-2		longa	ON		REP	#$20	;@searchRT		INX		INX		LDA	>BlkRangeTbl+2,X	;get word		BMI	@err		CMP	CmdBlockl		; if tblentry+1 < blocknum?		BCC	@searchRT		; yes. so try next larger entry		LDA	CmdBlockl		SBC	>BlkRangeTbl,X	;rem (0-179) = blknum - tblentry		STA	EXINDEX		;save remainder in a zpg temp(16 bit store)		LDA	>TrkOriginTbl,X	;get starting track value		TAX			; get initial cylinder in X 		LDA	EXINDEX		;get remainder back (16 bit fetch)@div18loop	SEC		SBC	#AD1440KSectors		BMI	@done		INX			;count whole tracks		BRA	@div18loop	; loop max of 10 times@done		CLC			;sectors start from 0 like on GCR disks		ADC	#AD1440KSectors	;add 18 back in		SEP	#$20		longa	OFF		STA	sector		; result is 0..17 (not 1-18)!		STX	cyl		LSR	cyl		; convert track(0-159) into cylinder (0-79)		STZ	side		ROR	side		; side = 00/$80		LDA	sector		LDX	drive		RTS		@err		BRK	$D2		;this should never happenBlkRangeTbl	DC.W	0000		DC.W	180		DC.W	180*2		DC.W	180*3		DC.W	180*4		DC.W	180*5		DC.W	180*6		DC.W	180*7		DC.W	180*8		DC.W	180*9		DC.W	180*10		DC.W	180*11		DC.W	180*12		DC.W	180*13		DC.W	180*14		DC.W	180*15	; BlkNum < 2700		DC.W	180*16	; BlkNum < 2880		DC.W	-1	;end of table flag		TrkOriginTbl	DC.W	0000		DC.W	0010		DC.W	0020		DC.W	0030		DC.W	0040		DC.W	0050		DC.W	0060		DC.W	0070		DC.W	0080		DC.W	0090		DC.W	0100		DC.W	0110		DC.W	0120		DC.W	0130		DC.W	0140		DC.W	0150		DC.W	-1						TITLE	'Track Class & Number of Sectors'***************************************************                                                **  TrackSect        Determine the number of      **                       sectors for a cylinder   **                                                **   Input:    Y <- the track                     **             X <- the drive                     **   Output:   A <- number of sectors this cyl    **             class <- speed group (0-4)         **   Prsrves:  X & Y (carry is set)               **   Max time: 16 microsec  (2MHZ)                **                                                ***************************************************TRACKSECT		EQU	*		TYA		BIT	UnitFlags,x	;is volume 400K gcr format ?		BPL	cylsect	;yes.		LSR	a	;map trk (0..159) to cyl (0..79)*CYLSECT		LSR	a	;Alt entry for A <- cyl 		LSR	a		LSR	a		LSR	a		STA	class		LDA	#12		SEC		SBC	class	; 12-(0,1,2,3,4)=12..8RETURN_3		RTS		;A has # of sectors per track*** This table contains the track number of blocks with*  the low six bits clear.  The first part (13) are the*  tracks for a single sided drive, the second (25) for*  a double sided drive.*	; SEG	codeTRACKTAB		DC.B	0,5,10,16,21,27,33,40,46,53		DC.B	60,68,76		DC.B	0,5,10,16,21,26,32,37,43,49		DC.B	55,61,67,73,80,86,92,99,106,113		DC.B	120,128,136,144,152** This is the sector table.  It has an organization*  just like that of the track table.*SECTAB		DC.B	0,4,8,0,9,7,6,0,4,3,4,0,0		DC.B	0,4,8,0,4,8,0,9,7,5		DC.B	3,1,2,6,0,4,8,5,6,7		DC.B	8,0,0,0,0	; SEG	fake_it**		TITLE	'Convert and Test block number'******************************************************************                                                               **  blockchk                Convert and test the coded block no. **                                                               **    This routine checks the block in the command table to see  **  if it is within the correct bounds for this disk.            **                                                               **   Regs:   A,X  destroyed                                      **           Y    preserved                                      **           C <-- 1 if block out of range; 0 otherwise          **   Time:   40 microseconds (no error)                          **                                                               ******************************************************************BLOCKCHK		EQU	*		LDX	drive		LDA	volsts,x		AND	#$1F	;get voltype		TAX		;=2,4,6,8,10 etc** Got a pointer to the block size for this disk, drive		LDA	CmdBlockl+2		ORA	CmdBlockl+3		BNE	invalid_block		LONGA	ON		REP	#$20		PHA		;preserve B for write 		LDA	CmdBlockl		CMP	>VolSizeTbl,x		PLA		SEP	#$20		LONGA	OFF		BCC	return_3** Lousy block number.  Set statbyte INVALID_BLOCK	EQU	*	;		LDA	#ibnerror	;Flag illegal block number		BRL	set_err	; mark an error*