		TITLE	'Equates';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d8 on 5/16/91 at 9:16:12 PM**MAXDRIVS		EQU	02	;only two drives for nowDEVTYPE		EQU	$01	;We're the first device!DEVSUBTYPE	EQU	$C0	; supports extended calls & swap error checking***  Tuning Constants*TK0WAIT		EQU	7	;Wait per track seeked for /TK0 in recalMOTCNTLO		EQU	255	;Motor timeoutMOTCNTHI		EQU	255*INMUPWAIT		EQU	500/2	;500 ms first access new diskSTDMUPWAIT	EQU	100/2	;100 ms normal motor up wait*gapByte		EQU	$4E	;Inter/intra sector gap bytetheSync		EQU	$00	;Sync byte preceeding each markfmtFillByte	EQU	$FA-256	;Format byte to fill sectors with; SpliceCnt must be tuned to put MFM slice 22 bytes after end of the address markSpliceCnt		EQU	16	;15 * 17 slow cycles + overhead between end of mfmRdAddr and mfmWriteDataAD1440KSectors	EQU	18;Field sizes:gap4aSize		EQU	80	;Gap between index and index mark				<1.8>gap1Size		EQU	50	;Gap between index mark and sector 1			<1.8>gap2Size		EQU	22	;Gap between address and data fieldsgap3Sz1440K	EQU	101	;Gap between adjacent sectors (1440K)			<1.9>gap4bSize		EQU	1000	;Gap from end of last sector to index (max)		<1.8>syncSize		EQU	12	;Sync field size*RECALTRKS		EQU	80	;80 track seek max on recalAMTOUT		EQU	1950	;Byte timeout for rdaddrREADTO		EQU	25	;25 bytes timeout for readITSSIZE		EQU	200	;1000 byte init sync field sizeFMTRETRY		EQU	10	;10 try track format*EJECTRETRIES	EQU	3	;Try to eject up to three timesEJECTTIMEOUT	EQU	195	;Wait 1.5s for disk to be ejected*MOTORTIMEOUT	EQU	$78E6	;About 1 sec delay on motor off*MAXSEEKS		EQU	4	;Maximum of 3 reseeksSKRCLTHRSH	EQU	2	;Point in reseeks where recal occursMAXRET		EQU	150	;Maximum number of sectors to good dataRCLTHRESH		EQU	MAXRET/2	;Point in retries when recal occurs*TOTCYLS		EQU	80	;80 cylinders totalSINGSIZE		EQU	800	;800 blocks on a single sided diskDOUBSIZE		EQU	1600	;1600 on a double sided*DUMMYTO		EQU	200	;One spin at 300 RPM (approx)SONYPWRUP		EQU	230	;Sony powerup=300ms, Liron=70ms*AD400K		EQU	02AD800K		EQU	04	; 800K any interleaveAD1440K		EQU	06	; 1440K 2:1 interleaveAD1440K1		EQU	10	; 1440K 1:1 interleaveAD800K2		EQU	$C	; 800K 2:1 interleaveXLEAVEDEF		EQU	4	;Default format interleave of 4:1MAXXLV		EQU	$08	; max interleave of 08:1BSTAT_SIZE	EQU	$04	; basic status = 4 bytes*CTRLLIST		EQU	$0C00	;Control lists are put hereSTATBUF		EQU	$0C00	;Status lists built here*SECTBUF		EQU	$0C00	;Formatter sector skeleton built hereVOLCSUM		EQU	SECTBUF+2+65+8VOLFMT		EQU	SECTBUF+2+65+7VOLSIDE		EQU	SECTBUF+2+65+6VOLASECT		EQU	SECTBUF+2+65+5VOLTRK		EQU	SECTBUF+2+65+4VOLDSECT		EQU	SECTBUF+2+65+21;BUF1		EQU	$0C00	;R/W nibble bufferBUF2		EQU	$0D00	;R/W nibble bufferBUF3		EQU	$0E00	;R/W nibble bufferBUF_SIZ		EQU	$00B0	; nibble buffer size;VARS_AREA		EQU	SECTBUF+798	; start of variable area**  IWM Locations*IWM		EQU	$C0E0*CA0CLR		EQU	IWM+0CA0SET		EQU	IWM+1CA1CLR		EQU	IWM+2CA1SET		EQU	IWM+3CA2CLR		EQU	IWM+4CA2SET		EQU	IWM+5LSTRBCLR		EQU	IWM+6LSTRBSET		EQU	IWM+7DESELECT		EQU	IWM+8SELECT		EQU	IWM+9ENABLE1		EQU	IWM+10ENABLE2		EQU	IWM+11L6CLR		EQU	IWM+12L6SET		EQU	IWM+13L7CLR		EQU	IWM+14L7SET		EQU	IWM+15** ISM register Equates*IsmDataW		EQU	IWM+0IsmMarkW		EQU	IWM+1IsmCRCW		EQU	IWM+2	;if action = 1IsmConfigW	equ	IWM+2	;if action = 0IsmParmsW		equ	IWM+3IsmPhaseW		equ	IWM+4IsmSetupW		EQU	IWM+5IsmMode0W		EQU	IWM+6IsmMode1W		EQU	IWM+7IsmDataR		equ	IWM+8	; if action = 1IsmCorrR		EQU	IWM+8	; if action = 0IsmMarkR		EQU	IWM+9IsmErrorR		equ	IWM+10IsmParmsR		EQU	IWM+11IsmPhaseR		EQU	IWM+12IsmSetupR		EQU	IWM+13IsmModeR		EQU	IWM+14IsmHndShR		EQU	IWM+15**        Disk control register*DISKREG		EQU	$C031	; enable 3.5 & head selectSHADOW		EQU	$C035	;used in FastBufr routine 7/88 joa** Equates for Host Communication*BSYSET		EQU	CA0SETBSYCLR		EQU	CA0CLR*CMDMARK		EQU	$80	;Command packet typeSTATMARK		EQU	$81	;Status packet typeDATAMARK		EQU	$82	;Data packet type*PACKETBEG		EQU	$C3PACKETEND		EQU	$C8HOSTID		EQU	$80*;;;              Commands;EXT_CMD		EQU	$40	; bit 6 set = extended cmd.CMDREAD		EQU	$1	;Read command from hostCMDWRITE		EQU	$2	;Write command from hostCMDSTATUS		EQU	$0	;Status command from hostCMDFORMAT		EQU	$3	;Format command from hostCMDCONTROL	EQU	$4	;Control command from hostCMDDEFID		EQU	$5	;INIT command from hostMAC_READ		EQU	$08	; Macintosh 524 block readMAC_WRITE		EQU	$09	; Macintosh write call 512 bytesCMDSETFMT		EQU	$0ACMDGETFMT		EQU	$0BCMDRAWRD		EQU	$0CCMDTRFLG		EQU	$0D;*STATVAL		EQU	%11111100	;Basic PC Device Standard StatusSVMASK1		EQU	%00010000	;DIP bit in standard status byteSVMASK2		EQU	%00000100	;WRPROT bit in std stat byteSVMASK3		EQU	%00000001	;swap bit in std stat byte**TCONSTANT		EQU	100	; constant for 2 Mhz clock		TITLE	'I/O Port Equates'*** Drive PAL Control Constants** Command (Write) addressesDIRINADR		EQU	0	;0 -> /DIRTN : set dir inDIROUTADR		EQU	1	;1 -> /DIRTN : set dir outREAD0ADR		EQU	1	;Read data head 0READ1ADR		EQU	3	;Read data head 1EJCT_RESET	EQU	3	; reset disk ejected bitSTEP0ADR		EQU	4	;0 -> /STEP : step a trackSTEP1ADR		EQU	5	;1 -> /STEPDRIVMFMADR	EQU	6	;0 -> Driv mode := MFM modeDRIVGCRADR	EQU	7	;1 -> Driv mode := GCR modeMTRONADR		EQU	8	;/MOTORONMTROFFADR		EQU	9EJECT1ADR		EQU	13	;1 -> /EJECT : eject the disk* Sense (Read) AddressesDIPADR		EQU	2	;/CSTIN : sense disk in placeFDHDADR		EQU	5	; FDHD  : read drive type bitWPROTADR		EQU	6	;/WRTPRT : sense write protectMFMMODEADR	EQU	7	;MFMMODE : sense drive modeSIDESADR		EQU	9	; SIDES : sense single/dual headTK0ADR		EQU	10	;/TK0 : sense recal posnREADYADR		EQU	11	;/READY : ready to read or writeEJCTADR		EQU	12	;0   -> Read disk ejected latch (in gate array)DRVXSTADR		EQU	13	;/DRVIN : sense if a drive is thereTACHADR		EQU	14	;/TACH : sense motor speedMEDIAADR		EQU	15	;/HDMEDIA : sense media type (FDHD only)**  ERROR codes*IOERROR		EQU	$27	;I/O error bit NODRVERR		EQU	$28	; no device connected errorOFFLINE		EQU	$2F	;Disk is offlineWPERROR		EQU	$2B	;Write Protect IBNERROR		EQU	$2D	;Illegal Block Number DSWERROR		EQU	$2E	; disk switched errorCMDERROR		EQU	$01	;Illegal Command Type PCOUNTERR		EQU	$04	;Wrong # of parametersLASTERROR		EQU	$40	;Returned on DEFID callCODERROR		EQU	$21	;Control or status code error (wrong Media Type)BCPARMCNT		EQU	$22	; invalid control parameter countSOFTERROR		EQU	$27+$40	;Soft I/O error**  ERROR2 Byte Masks*S1ERROR		EQU	$40	;spareADRERROR		EQU	$20	;Address Field errorDCSERROR		EQU	$10	;Data Field Checksum errorDBSERROR		EQU	$08	;Data Field Bitslip errorSFTSKERROR	EQU	$04	;An apparent mis-seekSEEKERROR		EQU	$02	;Seeking error**    Sethook, Resethook, setmark, Resetmark error codes*BHOOK_ERR		EQU	$30	; invalid hook numberBMARK_ERR		EQU	$31	; mark table range errorXLV_ERR		EQU	$32	; invalid interleaveSIDE_ERR		EQU	$33	; invalid side value errorUNDERUN_ERR	EQU	$34	;format errorNOINDEX_ERR	EQU	$35	;mfm format error;SWAP		EQU	$20	; swap bit mask for temp;		TITLE	'$E1BANK Variable Storage'E1_AD35VARS	RECORD	0		ORG	VARS_AREA-30	; variable storage area** Permanent Storage*XLVTAB		DS.B	18	;needed later for MFM formattingSTSSAV		DS.B	12	;spare for now 7/88 JOAEXT_FLAG		DS.B	1	; extended command flagUNITCNT		DS.B	1	;number of units attached*UNITID		EQU	*	;SmartPort UnitNo for each driveUNITA		DS.B	1	;accessed via ENABL1UNITB		DS.B	1	;accessed via ENABL2		DS.B	1	;for future expansion		DS.B	1	;for future expansion*UNITFLAGS		EQU	*	;flags for drive unit mode*  b7  = double sided volume flag ($80)*  b6  = MFM mode as of last accesss*  b5  = FDHD drive type (MFM & GCR capable)*  b4  = NO Chuckwait before next access*  b0..b3  reserved for future expansion*UFCHUKWAIT	EQU	$10UFFDHD		EQU	$20UFMFM		EQU	$40UFDBLSIDED	EQU	$80*		DS.B	1	; unit  a		DS.B	1	; unit  b		DS.B	1	;future expansion		DS.B	1	;future expansion** Temporary Storage*DRIVE		DS.B	1CYL		DS.B	1SECTOR		DS.B	1TRACK		EQU	SECTOR	;used by TrkReadSIDE		DS.B	1CURNSECT		DS.B	1CLASS		DS.B	1SENSBITS		DS.B	1DBLSIDED		DS.B	1	;setup by each call to ReadAdrs SECTINFO		EQU	*CSFND		DS.B	1FMTFND		DS.B	1SIDEFND		DS.B	1SECTFND		DS.B	1TRKFND		DS.B	1SEEKRET		DS.B	1ADRSRET		DS.B	1READRET		DS.B	1MFMFLAG		DS.B	1DRVTOASSIGN	DS.B	1	;count of drivs to assign by InitCmd*CURCYL		DS.L	1	;current cylinder *VOLSTS		DS.L	1	;volume status VSEJCTED		EQU	$80VSOFFLINE		EQU	$40VSWRPROT		EQU	$20*   b7  = ejected latch set*   b6  = Offline volume*   b5  = Wr Prot volume* b0..4 = Volume type (400/800/720/1440K )*DRSWTCH		DS.B	1	;Direct Read switch**  Error Byte Storage*STATUSTAB		EQU	*ERROR1		DS.B	1	;UnusedERROR2		DS.B	1	;Error byteRETRY		EQU	*ERROR3		DS.B	1ERROR4		DS.B	1ERROR5		DS.B	1ERROR6		DS.B	1ERROR7		DS.B	1ERROR8		DS.B	1*NSBYTES		EQU	*-STATUSTAB*STATBYTE		DS.B	1	;PC status code (hi bit set)*PRIORSTS		DS.B	1	;saved by EnblnSensFAKEBIT		DS.B	1	;constant in E1 used by EnblnChkTRKCNT		DS.B	1	;used by TrkRead*INTERLEAVE	DS.B	1	;Formatter interleave inputFORMSIDES		DS.B	1	;Formatter # sides input*MAC_FLAG		DS.B	1*FMTOPTION		DS.B	4	;*MIDEJECT		DS.B	1;;MARKTAB		EQU	*	;Address, data mark tableAFDMTAB		DS.B	1	;Data sector nibbleDATAMARKS		DS.B	4SYNCTAB		DS.B	5BSMARKS		DS.B	1BSLIP2		DS.B	1BSLIP1		DS.B	1		DS.B	5	;adrguts (ck,fmt,side,sect,trk)ADRMARKS		DS.B	4MARKTABLEN	EQU	*-MARKTAB		ENDR;	; SEG	Data_bank	; ram vectors		EQUSECT	$E10F6DHOOKS		EQUDS	*	;Copy Protection Vectors		EQUDS.W	1	;LengthRDADDRHOOK	EQUDS.L	1		EQUDS.L	1READDATAHOOK	EQUDS.L	1		EQUDS.L	1WRITEDATAHOOK	EQUDS.L	1		EQUDS.L	1SEEKHOOK		EQUDS.L	1		EQUDS.L	1FORMATHOOK	EQUDS.L	1		EQUDS.L	1WRITETRKHOOK	EQUDS.L	1		EQUDS.L	1VERIFYHOOK	EQUDS.L	1		EQUDS.L	1VECTORHOOK	EQUDS.L	1		EQUDS.L	1HOOKS_END		EQUDS	*	HOOKTABLEN	EQU	(HOOKS_END-HOOKS)-2	;Don't include this word*MAXHOOK		EQU	(HOOKS_END-HOOKS-2)/8	; number of hooks in table		ENDSECT******************************************************            Zero page work areas**                The Command Table*****************************************************AD35_ZPAGE	RECORD	$42CMDTAB		EQU	*	; start of command tableCMDBUFFL		DS.B	1	; lower three bytes of buffer address		DS.B	1	;		DS.B	1	;CMDCODE		DS.B	1	; command numberCMDPCOUNT		DS.B	1	; number of parameters		DS.B	1	; upper byte of buffer bits 24-31CMDBLOCKL		DS.B	1	; bits 0-7 of block numberCMDBLOCKH		DS.B	1	;CMDSCODE		EQU	CMDBLOCKL	; if control call then control numberCMDCOUNT		EQU	CMDBLOCKL	;if GetFmtOpts callCMDBLKEXTL	DS.B	1	;CMDBLKEXTH	DS.B	1	;		DS.B	1	;3rd byte of address parmCMDADRS		EQU	CMDBLKEXTL	;adrs for ReadBytes & WriteBytes		DS.B	1	;4th byte of address parm (unused)**           driver zero page work area*CMDUNIT		DS.B	1	; ;CSUM		DS.B	1CSUMC		DS.B	1CSUMB		DS.B	1CSUMA		DS.B	1WCSUM		DS.B	1;BASEPAGE		DS.B	1	;used by TrkReadFMTSECT		EQU	*	;used by mfmWriteTrkCBYTE1		DS.B	1	;used by WritePrep, WriteCBYTE2		DS.B	1	; "          "        "   CBYTE3		DS.B	1	; "          "        ";EXINDEX		DS.B	1	; extra bitsEXINDEX2		DS.B	1	;;TEMP		DS.B	1	;used by WAITMSTEMP2		DS.B	1	;used by WAITMSfmtTrkretry	DS.B	1;BASESAVE		DS.B	1	;trkread basepage save temp		DS.B	1STSMOTOR		DS.B	1	;status call motorOn state at entry		IF * > $62 THEN		WRITELN 	'TOO MUCH A3.5 ZERO PAGE'		ENDIFZPG_SIZE		EQU	*-CMDTAB	; number of zero page bytes		ENDR;;