;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:23:13 PM		TITLE	'Disk ][ boot code'D2RECAL:		LDA	#$60		TAX		STX	slotz		STA	bootdev		LDA	|$C08E,x	; prepare IWM for read mode		LDA	|$C08C,x		LDA	|$C0EA,y	; select drive		LDA	|$C089,x		LDY	#$50SEEKZERO		LDA	|$C080,x		TYA		AND	#$03		ASL	a		ORA	slotz		TAX		LDA	|$C081,x		LDA	#$56		PHP		; save interrupt state and disable		SEI		JSR	|wait		PLP		DEY		BPL	seekzero		STA	$26		STA	$3D		STA	$41		CLC		;assume no error		LDY	#50DSKCHK0		LDA	|$C08C,x	;read data		BMI	dskchk1	;if got data		DEY		;else maybe timeout		BPL	dskchk0	;maybe not		SEC		;maybe so, oops, errorDSKCHK1		PHPMAKTBL		LDX	#$03		LDY	#0TBLLOOP		STX	boottmp		TXA		ASL	a		BIT	boottmp		BEQ	nopatrn		ORA	boottmp		EOR	#$FF		AND	#$7ETBLLOOP2		BCS	nopatrn		LSR	a		BNE	tblloop2		TYA		STA	dnibl,x		INYNOPATRN		INX		BPL	tblloop		LDA	#$08		STA	$27		LDY	#$7F		PLP		RTL		D2BOOTERR:	LDA	#0		STA	>retry		JMP	|booterr