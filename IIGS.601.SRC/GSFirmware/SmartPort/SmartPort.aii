		PRINT	NOGEN	;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/15/91 at 8:36:44 PM		MACHINE	M65816		LONGI	OFF		LONGA	OFFVERSION		EQU	$0002		;this is version # is not used anywhere*ROMDRIVER		EQU	$F00007		;linkage to expansion ROM driver*Bnk~Org		EQU	$5600SPDRIVER		EQU	$FF0000+Bnk~Org	;will be $5600 for real Rom 03 APPLEDISK		EQU	$FF3400		;will be $3C00 for real Rom 03 SPENDING		EQU	Bnk~Org+$0E00	;will be $5600+$E00 for real Rom 03*		INCLUDE	'SP.REV.HIST.aii'*		INCLUDE	'::Firmware.macros.aii'		INCLUDE	'equates.aii'*		SEG	'C5C6SEG'C5XXCODE		PROC	ORG $C500		WITH	SMART_ZPAGE		ENTRY	C5BOOTM		ENTRY	PARMCTAB		ENTRY	PREAMBLE		ENTRY	SHIFT1		ENTRY	SHIFT2		ENTRY	SHIFT3		ENTRY	SHIFT4				INCLUDE	'C5XXcode.aii'		ENDP				SEG	'C5C6SEG'C6XXCODE		PROC	ORG $C600		WITH	SMART_ZPAGE		IMPORT	D2RECAL		IMPORT	D2BOOTERR		INCLUDE	'C6XXcode.aii'		ENDP*		SEG	'SPSEG'SMARTPORT		PROC	ORG SPDRIVER	; Rev 01 ROM was ORGed at $6540		WITH	SMART_ZPAGE		ENTRY	D2RECAL		ENTRY	D2BOOTERRRel~Org:			JMP	Reset		; PROCINIT called by coldstart monitor		JMP	OpenWndw		;open the interrupt window for AppleDisk		JMP	entry		;called from c5xxcode		INCLUDE	'smartdrvr.aii'*		FillTo	SPENDING	;fill my alloted space*		ENDP				END