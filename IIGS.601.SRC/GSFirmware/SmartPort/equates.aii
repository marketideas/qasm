		TITLE	'Equates';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:20:38 PMPDIDBYTE		EQU	$BF	; ProDOS attributes bytePCID2		EQU	$C0	; Extended & additional SmartPort cmdsTHEOFF		EQU	$60	; slot * 16*****************************************************           Direct Page  (temps)****************************************************SMART_ZPAGE	RECORD	$40*CHECKSUM		DS.B	1TOPBITS		DS.B	1EXTBUFF		EQU	*	;extended buffer		DS.B	3CMDCODE		DS.B	1	;ProDOS parameter passing areaCMDPCOUNT		EQU	*CMDUNIT		DS.B	1CMDBUFFER		EQU	*CMDBUFFERL	DS.B	1EXTBLOCK		EQU	*	;extended blockCMDSCODE		EQU	*CMDBUFFERH	DS.B	1CMDBLOCK		EQU	*CMDBLOCKL		DS.B	1CMDBLOCKH		DS.B	1CMDBLOCKS		DS.B	1CMDSPARE1		DS.B	1CMDSPARE2		DS.B	1RCVBUF		EQU	*GRP7CTR		DS.B	1ODDBYTES		DS.B	1STATBYTE		EQU	*BYTECOUNT		EQU	*BYTECOUNTL	EQU	*NEXT		EQU	*NEXT1		DS.B	1AUXTYPE		EQU	*BYTECOUNTH	EQU	*NEXT2		DS.B	1RPACKETTYPE	EQU	*NEXT3		DS.B	1DEVICEID		EQU	*NEXT4		DS.B	1HOSTID		EQU	*NEXT5		DS.B	1POINTER		EQU	*NEXT6		DS.B	1NEXT7		DS.B	1BUFFER		DS.W	1		DS.W	1AUXPTR		EQU	*BUFFER2		DS.W	1		DS.W	1TEMP		EQU	*TBODD		DS.B	1UNIT		DS.B	1	;Current target unitWPACKETTYPE	DS.B	1	;Packet typePLENGTH		EQU	RCVBUF-CMDCODE	;Max Parameter list lengthEPLENGTH		EQU	PLENGTH+3		;max extended parm list length**  NOTE: //gs Firmware Ref documents $40 thru $62 as saved for*        ROM disk  and RAM disk drivers to use so the DS below*        MUST be retained for all future versions of //gs SmartPort		DS.B	$63-*	;saved zpg for drivers to useZPSIZE		EQU	*-SMART_ZPAGE		ENDR*MSLOT		EQU	$07F8*CLEARIOROMS	EQU	$CFFFSTACK		EQU	$0100		EJECT*********************************************************                                                      **                  Screenhole Storage                  **                                                      *********************************************************** The screenhole layout is as follows:**            //e       //c      //gs       Rev D*  -----------------------------------------------------*  ProFlag  $478+n    $478     $E10FB0*  Retry    $4F8+n    $4F8     $E10FB1*  SHTemp1  $578+n    $578     $E10FB2*  Retry2   $578+n    $578     $E10FB3*  SHTempX  $5F8+n    $5F8     $E10FB4*  SHTempY  $678+n    $678     $E10FB5*  Power1   $6F8+n    ----     $E10FB6*  Power2   $778+n    ----     $E10FB7*  NumDevices $7F8+n  $6FE     $E10FB8*  SvBcL    $6F8      $6F8     $E10FB9*  SvBcH    $778      $778     $E10FBA*  MSlot    $7F8      $7F8     $0007F8*  RamUnit  ----      ----     $E10FBC*  RomUnit  ----      ----     $E10FBD*  DumbUnit ----      ----     $E10FBE*  SmartUnit ---      ----     $E10FBF*  ReMap    ----      ----     $E10FC0*                     thru     $E10FC3*                                          $E10FC4*  remap expansion space                   $E10FC5 *  SavRomSel   ----    ----    $E10FC4     $E10FC6*  IntEnbl     ----    ----    $E10FC5     $E10FC7*  BramFlag    ----    ----    $E10FC6     $E10FC8*  CmdRetry    ----    ----    $E10FC7     $E10FC9*  CyaSave     ----    ----    $E10FC8     $E10FCA*  AccessFlg   ----    ----     ------     $E10FCB.CC*  spares      ----    ----    $E10FC9..F  $E10FCD..F		EQUSECT	$E10FB0	;smart port scratch areaPROFLAG		EQUDS.B	1;  ___ ___ ___ ___ ___ ___ ___ ___; |   |   |   |   |   |   |   |   |; | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |  ProFLAG; |___|___|___|___|___|___|___|___|;   |   |___________________________ 1 = Boot;   |_______________________________ 1 = ProDOS, 0 = MLI;RETRY		EQUDS.B	1SHTEMP1		EQUDS.B	1RETRY2		EQUDS.B	1SHTEMPX		EQUDS.B	1SHTEMPY		EQUDS.B	1POWER1		EQUDS.B	1POWER2		EQUDS.B	1NUMDEVICES	EQUDS.B	1*SVBCL		EQUDS.B	1SVBCH		EQUDS.B	1ASSIGNFLG		EQUDS.B	1	;mode flag for AssigIDRAMUNIT		EQUDS.B	1ROMUNIT		EQUDS.B	1DUMBUNIT		EQUDS.B	1SMARTUNIT		EQUDS.B	1REMAP		EQUDS.L	1		EQUDS.W	1	;for possible ReMap expansionSAVROMSEL		EQUDS.B	1SAVSLTARB		EQUDS.W	1	;save word for Slot Arb config wordINTENBL		EQUDS.B	1	;application interrupt enbl statBRAMFLAG		EQUDS.B	1	;last battery ram valueCMDRETRY		EQUDS.B	1	; Command retry counterCYASAVE		EQUDS.B	1	; save cya reg stateACCESSFLG		EQUDS.W	1		EQUDS.B	1	;spare 		EQUORG	$E114E2SYSSAVRAM		EQUDS.B	$30FWSAVRAM		EQUDS.B	$30ENVSAV		EQUDS.B	8		EQUORG	$E102C0BRAMBUFFER	EQUDS.B	256		ENDSECT		IWML6CLR		EQU	$E1C0EC*CV		EQU	$25CH		EQU	$24BOOTSCRN		EQU	$7DBPRINTMSG		EQU	$C080	;for message display from bank$FFVTAB		EQU	$FC22VTABZ		EQU	$FC24	;A=VtabCOUT		EQU	$FDEDSETVID		EQU	$FE93SETKBD		EQU	$FE89AUTOSCAN		EQU	$FABAHOME		EQU	$FC58	;Home cursor & Clear screenTEXT		EQU	$FB39	;Set Text modeBASIC		EQU	$E000LOC0		EQU	$0	;Boot parmsLOC1		EQU	$1	;BANK00		EQU	$000000BANK1		EQU	$010000BANKE1		EQU	$E10000BANKFF		EQU	$FF0000*		EJECT**************************                       **    General Equates    **                       ***************************PBBVALUE		EQU	$A5	;Powerup Byte Base Value*PWRUPRESET	EQU	$00	;real power on (1st time) ResetCOLDRESET		EQU	$40	;CTRL-Oapple-Reset or INIT cmdCOMMRESET		EQU	$80	;CBuss device only Reset*BSYTO1		EQU	50	;(.55 ms) T/O on /BSY before sendBSYTO2		EQU	10	;(.12 ms) T/O on /BSY after sendSTATMTO		EQU	30	;30 bytes stat mark timeoutCMDLENGTH		EQU	9	;Command packet lengthPACKETBEG		EQU	$C3	;Mark at beginning of packetPACKETEND		EQU	$C8	;End of packet markCMDMARK		EQU	$80	;Command packet identifierSTATMARK		EQU	$81	;Status Packet identifierDATAMARK		EQU	$82	;Data Packet identifier*IWMMODE		EQU	$07	;No timer, asynch, latch*SCDEVICESTAT	EQU	0	;Get Device Specific StatusSCGETDCB		EQU	1	;Get Dev Ctrl Block (modebits)SCRETNLSTAT	EQU	2	;Return Newline Status SCGETDEVINFO	EQU	3	;Get Device Info BlockDISKREG		EQU	$C031CYAREG		EQU	$C036	E1CYAREG		EQU	CYAREG	; this re-equate WAS BOGUS AS HELL JOHN!!;  ___ ___ ___ ___ ___ ___ ___ ___; |   |   |   |   |   |   |   |   |; | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |   CYAREG; |___|___|___|___|___|___|___|___|;   |   |   |   |   |   |   |   |___ Slot 4 motor detect;   |   |   |   |   |   |   |_______ Slot 5 motor detect;   |   |   |   |   |   |___________ Slot 6 motor detect;   |   |   |   |   |_______________ Slot 7 motor detect;   |   |   |   |___________________ Shadow in all ram;   |   |___|_______________________ 0;   |_______________________________ System Speed (1=fast)*SLTROMSEL		EQU	$C02D;  ___ ___ ___ ___ ___ ___ ___ ___; |   |   |   |   |   |   |   |   |; | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |   SLTROMSEL; |___|___|___|___|___|___|___|___|;   |   |   |   |   |   |   |   |___ 0;   |   |   |   |   |   |   |_______ 0 = Slot 1 internal;   |   |   |   |   |   |___________ 0 = Slot 2 internal;   |   |   |   |   |_______________ 0 = Slot 3 internal;   |   |   |   |___________________ 0 = Slot 4 internal;   |   |   |_______________________ 0 = Slot 5 internal;   |   |___________________________ 0 = Slot 6 internal;   |_______________________________ 0 = Slot 7 internal;		EJECTSTATEREG		EQU	$C068;  ___ ___ ___ ___ ___ ___ ___ ___; |   |   |   |   |   |   |   |   |; | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |   STATEREG; |___|___|___|___|___|___|___|___|;   |   |   |   |   |   |   |   |___ INTCXROM;   |   |   |   |   |   |   |_______ ROMBANK;   |   |   |   |   |   |___________ BANK2;   |   |   |   |   |_______________ RDROM;   |   |   |   |___________________ RAMWRT;   |   |   |_______________________ RAMRD;   |   |___________________________ PAGE2;   |_______________________________ ALTZP;SHADOW		EQU	$C035IWM		EQU	$C080*REQCLR		EQU	IWM+0REQSET		EQU	IWM+1CA1CLR		EQU	IWM+2CA1SET		EQU	IWM+3CA2CLR		EQU	IWM+4CA2SET		EQU	IWM+5LSTRBCLR		EQU	IWM+6LSTRBSET		EQU	IWM+7MONCLR		EQU	IWM+8MONSET		EQU	IWM+9ENABLE1		EQU	IWM+10ENABLE2		EQU	IWM+11L6CLR		EQU	IWM+12L6SET		EQU	IWM+13L7CLR		EQU	IWM+14L7SET		EQU	IWM+15*** Error0 codes*NOANSWER		EQU	1NOMARK		EQU	2WASRESET		EQU	4BYTECMP		EQU	8CSUMERR		EQU	$10NOPACKEND		EQU	$20BUSHOG		EQU	$40** Command Codes*STATUSCMD		EQU	$00READCMD		EQU	$01WRITECMD		EQU	$02FORMATCMD		EQU	$03CONTROLCMD	EQU	$04INITCMD		EQU	$05ADDNLCMDS		EQU	$0ASETFMTCMD		EQU	$0AGETFMTCMD		EQU	$0BRAWRDCMD		EQU	$0CTNRFLAGCMD	EQU	$0D**SOFT		EQU	%01000000	;The soft error bit in statbyte*BADCMD		EQU	$01BADPCNT		EQU	$04BUSERR		EQU	$06BADUNIT		EQU	$11NOINT		EQU	$1FBADCTL		EQU	$21BADCTLPARM	EQU	$22IOERROR		EQU	$27NODRIVE		EQU	$28WRITEPROT		EQU	$2BBADBLOCK		EQU	$2DOFFLINE		EQU	$2FLASTONE		EQU	SOFT+NODRIVESOFTERROR		EQU	SOFT+IOERROR*SVMASK1		EQU	$10*RC1		EQU	1000	;Send a command pack 1000 times (1 sec)RC2		EQU	5	;Data Packs (sent/rcd) get tried only 5 times**CR		EQU	$8DBOOTDISK		EQU	$04	;if boot from DiskBOOTRAM		EQU	$01	;if boot from RamDiskBOOTROM		EQU	$00	;if boot from RomDiskCMDXFRDIR		EQU	$1EFC	; Command tranfer directionINCRBUSY		EQU	$E10064	; Increment the Busy FlagDECRBUSY		EQU	$E10068	; Decrement busy flag and dispatchSLOT_ARBITER	EQU	$E10208	;slot arbiter call vectorRDFMTFLAG		EQU	$E1164A	;word flag =$0000/$FFFFFORMSELECT	EQU	$00BF00	;RD format select flagDNIBL		EQU	$356NBUF1		EQU	$300SLOTZ		EQU	$2BBOOTTMP		EQU	$3CBOOTDEV		EQU	$4FS6INTFLAG		EQU	$07FE	; slot 6 interrupt flagWAIT		EQU	$FCA8*SPCMDCNT		EQU	13	