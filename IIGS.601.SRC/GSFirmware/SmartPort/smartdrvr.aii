;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:23:13 PM		TITLE	'Disk ][ boot code'D2RECAL:		LDA	#$60		TAX		STX	slotz		STA	bootdev		LDA	|$C08E,x	; prepare IWM for read mode		LDA	|$C08C,x		LDA	|$C0EA,y	; select drive		LDA	|$C089,x		LDY	#$50SEEKZERO		LDA	|$C080,x		TYA		AND	#$03		ASL	a		ORA	slotz		TAX		LDA	|$C081,x		LDA	#$56		PHP		; save interrupt state and disable		SEI		JSR	|wait		PLP		DEY		BPL	seekzero		STA	$26		STA	$3D		STA	$41		CLC		;assume no error		LDY	#50DSKCHK0		LDA	|$C08C,x	;read data		BMI	dskchk1	;if got data		DEY		;else maybe timeout		BPL	dskchk0	;maybe not		SEC		;maybe so, oops, errorDSKCHK1		PHPMAKTBL		LDX	#$03		LDY	#0TBLLOOP		STX	boottmp		TXA		ASL	a		BIT	boottmp		BEQ	nopatrn		ORA	boottmp		EOR	#$FF		AND	#$7ETBLLOOP2		BCS	nopatrn		LSR	a		BNE	tblloop2		TYA		STA	>dnibl,x		INYNOPATRN		INX		BPL	tblloop		LDA	#$08		STA	$27		LDY	#$7F		PLP		RTL		D2BOOTERR:	LDA	#0		STA	>retry		JMP	|booterr		TITLE	'Send a CBus Packet';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:23:51 PM*********************************************************                                                      **  SendOnePack                   Send a CBus Packet    **                                                      **    This routine sends a packet of data across the    **  bus.  The protocol is as follows:                   **              ____________________________            **  REQ _______|2                          5|_________  **          _______________________________             ** /BSY ___|1               3             4|__________  **                                                      **    1)  Device signals ready for data                 **    2)  Host signals data iminent                     **    3)  Packet is transmitted (sync, command mark,    **         ids, contents, checksum [msb=1])             **    4)  Device signals packet recieved                **    5)  Host finishes send data cycle                 **                                                      **    The bytes are sent in slow mode (32 cycles/byte)  **  and the timing is critical.  Branches which should  **  not cross page boundaries are marked.               **                                                      **   Input:  buffer (2 bytes) <- ptr to data to send    **           bytecount (2)    <- length (bytes) of data **           packettype (1)   <- command or data packet **           CMDUnit (1)      <- # of device to receive **                                                      **   Output: carry set- handshake error                 * *                 clr- bytes sent                      **                                                      *********************************************************SENDONEPACK	EQU	*** Prep for the transmission		JSR	WritePrep	;Does a bunch of stuff** Enable PC chain.		LDX	#$60	;set X = slot * 16           		LDY	#$07	;now set IWM mode before toggle		JSR	SetIWMode	;                   		JSR	SetBankE1	;set bank for I/O access		LDA	|enable1,x	;disable Unified drive		LDA	|monset,x		LDA	|monclr,x		JSR	enablechain	;This sets X reg		JSR	SetBankE1	;set bank for I/O access		LDA	|enable1,x	;smart port is drive 1 on Cortland		LDA	|monset,x** Loop until the chain becomes unbusy		LDA	cyareg		XBA		LDA	cyareg		AND	#$7F		STA	cyareg	;slow down to 1Mhz for busy polling		LDY	#bsyto1	;Timeout = .55 mSecUBSY1		LDA	|l7clr,x	;Test if /BSY is hi or lo		BMI	chainunbsy	;If hi, bus is not busy		DEY		BNE	ubsy1	;Keep trying*		XBA		STA	cyareg	;restore speed		XBA		;get a back		SEC		JMP	sd10** Tell the bus that data is coming and send the sync bytes*  Sync is groups of eight 2's separated by a 6 (micS cell)*  (111111110011111111001111111100 ...)*CHAINUNBSY	EQU	*		XBA		STA	cyareg*		LDA	|reqset,x	;Raise REQ		LDY	#5	;Sync plus packet begin*		LDA	#$FF	;Send out the 1st byte sync		STA	|l7set,x*SSB		EQU	*		LDA	preamble,ySSD		EQU	*		ASL	|l6clr,x	;Wait 'til buffer empty		BCC	ssd*		STA	|l6set,x		DEY		BPL	ssb	;Back for more bytes** Send over the desination ID		LDA	Unit		ORA	#$80	;Make the device ID		JSR	sendbyte** Send the source ID (that's us... we're an $80)		JSR	send80** Send over the packet type (command or data)		LDA	Wpackettype		JSR	sendbyte** Send the Auxilliary Type byte (an $80 from this rev PC)		JSR	Send80** Send the status byte (null for us), and length bytes		JSR	send80		LDA	oddbytes		ORA	#$80		JSR	sendbyte		LDA	grp7ctr		ORA	#$80		JSR	sendbyte** Now send the "oddbytes" part of the packet contents		LDA	oddbytes	;Get # of "odd" bytes		BEQ	sob2	;Skip if no odd bytes*		LDY	#$FF		LDA	tbodd	;Get the odd bytes msb's (A[7]=1)*SOB1		EQU	*		JSR	WritIWM	;When it's time, write it		INY		LDA	[buffer],y	;Get the data byte		ORA	#$80	;Flip on the hi bit		CPY	oddbytes	;Are we done?		BLT	sob1** Now send over the groups of seven contents* Currently assume there must be at least one group of 'emSOB2		EQU	*		LDA	grp7ctr	;Check if there are groups to send		BNE	sob3	;=> At least one group		JMP	datdone	;Skip to send checksum*SOB3		EQU	*		LDY	#0START		LDA	topbits		JSR	WritIWM	;When it's time, write it** Send first byte		LDA	next1		ORA	#$80		JSR	WritIWM	;When it's time, write it** Prep the next "1st" byte for next time		LDA	[buffer2],y		STA	next1		ASL	a		ROL	topbits	;Store the top bit		INY		;Next byte** It's possible that we're at a page boundary now. If so, bump the*  hi order part of the pointer.		BNE	skip1		INC	buffer2+1		BRA	skip2SKIP1		PHA		;Equalize the cases		PLA** Push us ahead by an additional 8 cycles for margin reasons*  Plus I gotta get the topbits MSB set somehow...SKIP2		EQU	*		LDA	#%00000010	;Flip what will be MSB		ORA	topbits		STA	topbits** Send the second byte		LDA	next2		ORA	#$80		JSR	WritIWM	;When it's time, write it		LDA	[buffer2],y		STA	next2		ASL	a		ROL	topbits	;Store the top bit		INY		;Next byte** Send the third byte		LDA	next3		ORA	#$80		JSR	WritIWM	;When it's time, write it		LDA	[buffer2],y		STA	next3		ASL	a		ROL	topbits	;Store the top bit		INY		;Next byte** Send the fourth byte*		LDA	next4		ORA	#$80		JSR	WritIWM	;When it's time, write it		LDA	[buffer2],y		STA	next4		ASL	a		ROL	topbits	;Store the top bit		INY		;Next byte** After the first 256 bytes, we will cross pages here.  If we did*  cross, bump the buffer pointer. If not, equalize the cases with *  seven cycles of time wasting.		BNE	skip3		INC	buffer2+1		BRA	skip4SKIP3		PHA		PLASKIP4		EQU	*** Send the fifth byte		LDA	next5		ORA	#$80		JSR	WritIWM	;When it's time, write it		LDA	[buffer2],y		STA	next5		ASL	a		ROL	topbits	;Store the top bit		INY		;Next byte** Send the sixth byte		LDA	next6		ORA	#$80		JSR	WritIWM	;When it's time, write it		LDA	[buffer2],y		STA	next6		ASL	a		ROL	topbits	;Store the top bit		INY		;Next byte** Send the last byte of the group		LDA	next7		ORA	#$80		JSR	WritIWM	;When it's time, write it		LDA	[buffer2],y		STA	next7		ASL	a		ROL	topbits	;Store the top bit		INY		;Next byte** Now see if we have sent enough groups of seven		DEC	grp7ctr		BEQ	datdone** Otherwise, back to do more.  Note it's too far for a branch.		JMP	start** Whew! Now send the damn checksum as two FM bytesDATDONE		EQU	*		LDA	checksum	;c7 c6 c5 c4 c3 c2 c1 c0		ORA	#$AA	; 1 c6  1 c4  1 c2  1 c0		JSR	WritIWM	;When it's time, write it*		LDA	checksum	;c7 c6 c5 c4 c3 c2 c1 c0		LSR	a	; 0 c7 c6 c5 c4 c3 c2 c1		ORA	#$AA	; 1 c7  1 c5  1 c3  1 c1		JSR	sendbyte** Send the end of packet mark		LDA	#packetend		JSR	sendbyte** Wait until write underflowSD7		EQU	*		LDA	|l6clr,x		AND	#$40		BNE	sd7	;Still writing data*		STA	|l6set,x	;Back to sense mode (dummy write)** Now wait until the drive acknowledges reciept of the*  string or until timeout		LDY	#bsyto2	;Load timeout for bsy low (100uS)		LDA	cyareg		XBA		LDA	cyareg		AND	#$7F		STA	cyareg	;shift down to 1mhz for polling@10		DEY		;A little closer to an error 		BEQ	sd9	;Oops it didn't happen** See if drive has acknowledged the bytes yet		LDA	|l7clr,x	;Wait 'til /BSY lo 		BMI	@10		XBA		STA	cyareg	;restore original speed		BRA	sd10** Too much time has elapsed.  Drive didn't get string.SD9		XBA		STA	cyareg		LDA	#noanswer	;Report error in comm error byte DBERROR		EQU	*		LDX	#$60	;For dberror entry		SEC		;Signal a problem 		BRA	sd11** Finish the sequenceSD10		CLC		;This is a normal exit SD11		LDA	|reqclr,x	;Set REQ lo		LDA	|l6clr,x	;Back into read mode** Pull back the bytecount in all cases		PHK		;data bank to $FF		PLB		RTS		EJECT** These routines are for wasting specific amounts of time*  This code segment should not cross page boundaries.*WASTE32		JSR	waste14WASTE18		NOPWASTE16		NOPWASTE14		NOPWASTE12		RTS*MARKERR		EQU	*		JMP	dberror*WritIWM		EQU	*		BIT	|l6clr,x	;do write handshake		BPL	WritIWM	;if not ready		STA	|l6set,x	;else time to write		RTS		TITLE	'Receive a CBus Packet';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:24:23 PM*********************************************************                                                      **  ReceivePack       Get a packet from bus resident    **                                                      **              ____________________________            **  REQ _______|2                          5|_________  **          _______________________________             ** /BSY ___|1               3             4|__________  **                                                      **    1)  Drive signals ready to send packet            **    2)  Host signals ready to recieve data            **    3)  Packet is transmitted (sync, mark, IDs, data, **         checksum [msb=1])                            **    4)  Drive signals packet dispatched               **    5)  Host acknowledges reciept of packet           **                                                      **    The bytes are sent in slow mode (32 cycles/byte)  **  and the timing is critical.  Branches which should  **  not cross page boundaries are marked.               **                                                      **   Input:  buffer <- address where packet guts left   **                                                      **   Output: carry set- handshake error                 * *                 clr- bytes recieved                  **           A <- error0 if carry set                   **                                                      **********************************************************GRABSTATUS	EQU	*RECEIVEPACK	EQU	*** Init the checksum*		LDA	#$00		STA	checksum** Copy over buffer -> buffer2*		LDA	buffer		STA	buffer2		LDA	buffer+1		STA	buffer2+1		LDA	buffer+2		STA	buffer2+2**		JSR	enablechain	;Set X register to $N0*		JSR	SetBankE1	;data bank to $E1		LDA	|l6set,x	;Prep for sense mode ** Now wait for BSY to go hi, signalling 'ready w/ status' *RDH0		LDA	|l7clr,x	;Read sense		BMI	rdh1	;No window if packet coming		JSR	OpenWndw	;open the interrupt window		LDX	#$60		BRA	rdh0	;then see if packet is coming** Signal Liron we're ready to recieve*RDH1		EQU	*		LDA	|reqset,x	;Raise /REQ 		LDY	#$00	;max left til stat mark** Wait for a byte from Liron or timeout *RDH2		EQU	*		LDA	>IWMl6clr	;wait for valid IWM data, and read it		DEY		BEQ	markerr	;Didn't find a packet in time** Is it the beginning of the packet?*RDH21		EQU	*		CMP	#packetbeg	;Find the packet begin mark		BNE	rdh2	;Back again - no timeout for now** Okay load up the table with this stuff*RDH5		EQU	**		LDY	#6	;Seven bytes of overheadRDH3		EQU	*		JSR	RdIWM	;wait for valid IWM data, and read it		AND	#%01111111	;Strip start bit		PEA	|$0000	;data bank to $00		PLB		PLB		STA	|rcvbuf,y		EOR	#$80	;Pop MSB back on for checksum		EOR	checksum		STA	checksum		DEY		BPL	rdh3** Set groups of seven buffer pointer buffer2*		LDA	oddbytes		BEQ	start25	;Skip alteration if no oddbytes		CLC		ADC	buffer		STA	buffer2		LDA	buffer+1		ADC	#0		STA	buffer2+1*		LDY	#0** Now receive the odd bytes*		JSR	RdIWM	;wait for valid IWM data, and read it		ASL	a	;Pop off the start bit		STA	topbitsSTART1		EQU	*		JSR	RdIWM	;wait for valid IWM data, and read it		ASL	topbits	;Get an MSB		BCS	gob1	;If MSB set, leave start bit		EOR	#$80	;MSB clear- flip start bitGOB1		STA	[buffer],y	;Squirrel it away		EOR	checksum	;add it to the checksum		STA	checksum		INY		;Next spot		CPY	oddbytes	;Are we done?		BLT	start1	;If more, branch**SLOTDEPRD		EQU	*START25		EQU	*		LDY	#0		LDA	grp7ctr		PHA		;Save group counter for later		BNE	start35		JMP	done5	;Go get the checksum** Okay, get the groups of seven*  Start by getting the topbits for this group of seven*START35		EQU	*		JSR	RdIWM	;wait for valid IWM data, and read it		STA	temp	;Just a second** Split up the seven bits into two indices for topbit tables*		LSR	a	;0   1  d1  d2  d3  d4  d5  d6		LSR	a	;0   0   1  d1  d2  d3  d4  d5		LSR	a	;0   0   0   1  d1  d2  d3  d4		AND	#%00001111	;0   0   0   0  d1  d2  d3  d4		TAX		;First index into the tables		LDA	temp	;1  d1  d2  d3  d4  d5  d6  d7		AND	#%00000111	;0   0   0   0   0  d5  d6  d7		STA	temp	;Keep for last three bytes** Now read the first byte, reunite its msb, store it, and checksum it.*		JSR	RdIWM	;wait for valid IWM data, and read it		EOR	>shift1,x	;Recombine the MSB with data		STA	[buffer2],y	;Store it away		EOR	checksum	;Add it to the checksum		STA	checksum		INY** Now, the second Y turn over occurs at this point in the loop.  Update*  the buffer pointer if it occurred.*		BNE	*+4		INC	buffer2+1** Now the second byte*		JSR	RdIWM	;wait for valid IWM data, and read it		EOR	>shift2,x	;Recombine the MSB with data		STA	[buffer2],y	;Store it away		EOR	checksum	;Add it to the checksum		STA	checksum		INY** Now the third byte*		JSR	RdIWM	;wait for valid IWM data, and read it		EOR	>shift3,x	;Recombine the MSB with data		STA	[buffer2],y	;Store it away		EOR	checksum	;Add it to the checksum		STA	checksum		INY** Now the fourth byte*		JSR	RdIWM	;wait for valid IWM data, and read it		EOR	>shift4,x	;Recombine the MSB with data		STA	[buffer2],y	;Store it away		EOR	checksum	;Add it to the checksum		STA	checksum		INY** The first Y turn over occurs at this point in the loop.  Update*  the buffer pointer if it occurred.*		BNE	*+4		INC	buffer2+1*		LDX	temp	;Now we need the other index** Now the fifth byte*		JSR	RdIWM	;wait for valid IWM data, and read it		EOR	>shift2,x	;Recombine the MSB with data		STA	[buffer2],y	;Store it away		EOR	checksum	;Add it to the checksum		STA	checksum		INY** Now the sixth byte*		JSR	RdIWM	;wait for valid IWM data, and read it		EOR	>shift3,x	;Recombine the MSB with data		STA	[buffer2],y	;Store it away		EOR	checksum	;Add it to the checksum		STA	checksum		INY** And, finally, the seventh byte*		JSR	RdIWM	;wait for valid IWM data, and read it		EOR	>shift4,x	;Recombine the MSB with data		STA	[buffer2],y	;Store it away		EOR	checksum	;Add it to the checksum		STA	checksum		INY** Now see if this is the last group of seven to receive*		DEC	grp7ctr		BEQ	done5	;Go to get the checksum etc		JMP	start35	;Another topbits ...** Get and reconstruct the checksum*DONE5		EQU	*		JSR	RdIWM	;wait for valid IWM data, and read it		STA	temp	;1 c6 1 c4 1 c2 1 c0*		PLA		;Get back the groups of 7 ctr		STA	grp7ctr		JSR	RdIWM	;wait for valid IWM data, and read it		SEC		ROL	a	;c7 1 c5 1 c3 1 c1 1		AND	temp	;c7 c6 c5 c4 c3 c2 c1 c0		EOR	checksum	;When we're done, should be zero		TAX		;save checksum** Get the packet end mark. Is it correct?*		JSR	RdIWM	;wait for valid IWM data, and read it*		CMP	#packetend		BNE	npenderr5** Didn't have time before to checksum oddbytes.  Do it now*  A still has the partial checksum*		TXA		;get back checksum** Okay, checksum oughta be zero.  If not, checksum error.*ICBT15		EQU	*		TAX		BNE	cserror5** Wait for /BSY to go low*LSTBSYWAIT5	EQU	*		JSR	SetBankE1		LDA	|l6set+TheOffRDH45		LDA	|l7clr+TheOff		BMI	rdh45** Got the bytes, now acknowledge their reciept*		LDA	|reqclr+TheOff	;Lower REQ *		CLCRDHBYE		PHK		;data bank to $FF		PLB		RTS*NPENDERR5		LDA	#nopackend		BNE	gserror5CSERROR5		LDA	#csumerrGSERROR5		EQU	*		SEC		BRA	rdhbye** This routine reads the data from the* IWM, and returns the data in the A-Reg* with the data bank set to $FF.* Execution time = 25 cycles minimum or* 8.75uS (assuming 350nS/Cycle).*RDIWM		EQU	*		PEA	|$FFE1		PLB		;set bank $E1		LDA	|l6clr+TheOff		BPL	*-3		PLB		;set bank $FF		RTS*** Open Interrupt Window* NOTE: this takes about 800uS*OPENWNDW		EQU	*		LDA	|IntEnbl	;get entry interrupt enbl stat		AND	#%00000100	;check flag		BNE	CloseWndw	;don't do if not needed		JSR	SavFWzp	;Save ours and restore his to		JSR	ResSysZp	;get ready to open IRQ window		LDA	|CyaSave	; restore CYA for IRQ		STA	|CyaReg		CLI		;enable interrupts		NOP		;WARNING-Liron gets sleepy if away to long		SEI		;Close IRQ window		LDA	|CyaReg	; save new CYA state		STA	|CyaSave	; in case control panel changes speed		AND	#%11111011	; fast mode & disable slot 6 motor detect		ORA	#%10000000		STA	|CyaReg		SEP	#$30	;make sure in 8 bit mode		JSR	SavSyszp	;save system before getting FW		JSR	ResFwZp	;and restore firmware environmentCLOSEWNDW		EQU	*		RTS		TITLE	'More Packet Stuff';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:24:55 PM** Data bank must be $E1 before* you get to here !!!*SEND80		EQU	*		LDA	#$80SENDBYTE		EQU	*		LDY	|l6clr,x		BPL	SendByte		STA	|l6set,x		EOR	checksum		STA	checksum		RTS****RESETCHAIN	EQU	*		JSR	ClrPhases		JSR	SetBankE1	;data bank to $E1		LDA	|reqset,x		LDA	|ca2set,x		LDY	#80	;Hard reset for 80 ms		JSR	YMSWait*		JSR	ClrPhases		PHK		;data bank to $FF		PLB*		LDY	#10	;About 10 mS reset time!*YMSWAIT		EQU	*		JSR	OneMS		DEY		BNE	YMSWait		RTS*ONEMS		EQU	*		PHA		LDA	>e1cyareg		PHA		AND	#$7F		STA	>e1cyareg	;shift down to 1Mhz mode*		LDX	#100	;100*10cyc =977 us@10		DEX		;(+2)		NOP		;(+4)		BNE	@15	;(+7)@15		BNE	@10	;(+10)*		PLA		STA	>e1cyareg	;shift back to original speed		PLA		RTS** Drop ENBL1 first to deselect Unified* and then enable UniDisk.*ENABLECHAIN	EQU	*		LDX	#$60		JSR	SetBankE1	;data bank to $E1		LDA	|ca1set,x	;now enable UniDisk		LDA	|lstrbset,x		PHK		;data bank to $FF		PLB		RTS**CLRPHASES		EQU	*		LDX	#$60		JSR	SetBankE1	;data bank to $E1		LDA	|reqclr,x		LDA	|ca1clr,x		LDA	|ca2clr,x		LDA	|lstrbclr,x		PHK		;data bank to $FF		PLB		RTS**		EJECT*SENDDATA		EQU	*		LDA	#<RC2		LDY	#>RC2		JSR	SendPile		BCC	sdoubtCOMRST		EQU	*		LDA	#CommReset		JSR	AssignID	;this restores Cbuss Unit #'sSDOUBT		EQU	*		RTS**SENDPACK		EQU	*		JSR	SendPile	;Try to send a pack		BCC	sdoubt		JSR	ComRst	;Reset to try again		PHK		; bank to FF or WRITEPREP fails		PLB*		LDA	>SvBcL	;Get back the packetlength		STA	bytecountl		LDA	>SvBcH		STA	bytecounth*SENDPILE		EQU	*		LDA	#<RC1	;Retry count (big!) 3000		LDY	#>RC1*ALTSENDPILE	EQU	*		STA	>Retry		TYA		STA	>Retry2** SendPack destroys the bytecount*SPILE1		EQU	*		LDA	bytecountl		STA	>SvBcL		LDA	bytecounth		STA	>SvBcH*		JSR	SendOnePack	;Send the packet*		LDA	>SvBcL		STA	bytecountl		LDA	>SvBcH		STA	bytecounth*		BCC	spilout		PHB		;save data bank		JSR	SetBankE1	;data bank to $E1		DEC	|retry		BNE	spile2		DEC	|retry2		BPL	spile2		PLB		;restore data bankSPILOUT		RTSSPILE2		PLB		;restore data bank		BRA	spile1	;and retry*RECPACK		EQU	*		LDA	#<RC2		STA	>RetryRPK1		EQU	*		JSR	ReceivePack		BCC	rpout		LDY	#1		JSR	YMSWait		JSR	dberror	;Recycle handshake and set carry		LDA	>retry		DEC	a		STA	>retry		BNE	rpk1	;Carry set stillRPOUT		EQU	*		RTS**		TITLE	'Divide by 7 routine'*************************************************************                                                          **  Divide7                Do DIV and MOD 7 and set auxptr  **                                                          **   This routine divides the bytecount by seven.  The      **  quotient gives the number of groups of seven bytes to   **  be sent, and the remainder gives the number of "odd"    **  bytes.                                                  **                                                          **  Input:   bytecountl,h <- # of bytes to write            **           buffer       <- pointer to data                **  Output:  auxptr       <- pointer to speed up csumming   **           oddbytes     <- bytecount MOD 7                **           grp7ctr      <- bytecount DIV 7                **                                                          ***************************************************************PDIV7TAB		DC.B	0,36,73PMOD7TAB		DC.B	0,4,1DIV7TAB		DC.B	0,1,2,4,9,18MOD7TAB		DC.B	0,1,2,4,1,2*AUXPTRINC		DC.B	0,$7F,$FF*WRITEPREP		EQU	*DIVIDE7		EQU	*** Set up auxptr <- buffer+$80   if $0FF < bytecount < $200*     or auxptr <- buffer+$100  if $1FF < bytecount*		LDX	bytecounth	;0, 1 or 2		BEQ	noauxptr	;Auxptr used only for full pages*		LDA	buffer+1		STA	auxptr+1	;Copy over hi order part*		LDA	#$80	;Anticipate smaller bytecount		CPX	#1	;Check bytecount		BEQ	sap1	;=> $0FF < bytecount < $200*		INC	auxptr+1	;Add $100 to bytecount instead		LDA	#0	;Make sure lo order unalteredSAP1		CLC		ADC	buffer		STA	auxptr		BCC	noauxptr		INC	auxptr+1** Now look up the first order guess for DIV and MOD.  X still has*  bytecount DIV 256.*NOAUXPTR		EQU	*		LDA	pdiv7tab,x		STA	grp7ctr		LDA	pmod7tab,x		STA	oddbytes** Now add in the mods and divs for each of the five hi order*  bits in the lo order bytecount, correcting each time MOD becomes*  bigger than 6.*		LDX	#5	;Do for five bits		LDA	bytecountl		STA	temp	;Store lo order for shifting		AND	#%00000111	;Save lo three for later		TAY*DIVIDE3		EQU	*		ASL	temp	;C <- next from bytecountl		BCC	divide2	;If clear, no effect on DIV,MOD		LDA	mod7tab,x	;Get MOD7 for 2^nDIVIDE4		EQU	*		CLC		ADC	oddbytes	;Got new MOD value		CMP	#7	;Is it too big?		BLT	divide1	;=> NO leave MOD - 0->C		SBC	#7	;Bring MOD under 7 - C still setDIVIDE1		EQU	*		STA	oddbytes		LDA	div7tab,x	;Get DIV for this 2^n		ADC	grp7ctr	;Add to DIV along with correction (C)		STA	grp7ctr	;Update the DIVDIVIDE2		EQU	*		DEX		;One less bit to deal with		BMI	divide5	;Escape after 6 times through loop		BNE	divide3	;Take brnch 1st 5 loops*		TYA		;Get back the last three bits		JMP	divide4	;Sixth pass add in remains*DIVIDE5		EQU	***		TITLE	'Checksum Prepass'***************************************************************                                                            **  PreCheck                    Does the checksumming prepass **                                                            **   Input:   bytecount   <- bytes in buffer                  **            buffer      <- pointer to data to send          **            auxptr      <- extra pointer to speed process   **   Output:  checksum    <- 8 bit XOR of data to be sent     **                                                            ****************************************************************PRECHECK		EQU	*** Checksum any full pages*		LDA	buffer+1		PHA		;Preserve buffer pointer		LDA	#0		LDX	bytecounth		BEQ	lastpass	;If no complete pages, skip thisXOR2		EQU	*		LDY	|auxptrinc,x	;Get number of bytes each ptrXOR1		EQU	*		EOR	[buffer],y		EOR	[auxptr],y		DEY		;One less		BNE	xor1		EOR	[buffer],y		EOR	[auxptr],y	;Have to deal with 0 case** Now move the buffer up for next section*		CPX	#1		BEQ	xor5	;If 256 and up bytes, bump x1		INC	buffer+1	; otherwise x2XOR5		INC	buffer+1*LASTPASS		EQU	*** Do the remaining less than a page with a single pointer*		LDY	bytecount		BEQ	xor4		EOR	[buffer],y	;Compensate for nth byteXOR3		EOR	[buffer],y		DEY		BNE	xor3		EOR	[buffer],y	;Last damn (0th) byte** Store result away.  Retrieve old buffer value.*XOR4		EQU	*		STA	checksum		PLA		STA	buffer+1**		TITLE	'Get topbits byte for odds'********************************************************                                                     ** DetTopBits               Get topbits for odd bytes  **                                                     **   Also sets buffer2 pointer to pointer at groups of **  seven bytes.                                       **                                                     **  Input:   oddbytes <- # of "odd" bytes              **           buffer   <- pointer to data               **  Output:  tbodd    <- topbits for odd bytes         **           buffer2  <- buffer+oddbytes               **                                                     *********************************************************DETTOPBITS	EQU	**		LDY	oddbytes		DEY		LDA	#0		STA	tbodd*GTBOB		LDA	[buffer],y		ASL	a		ROR	tbodd		DEY		BPL	gtbob		SEC		ROR	tbodd*		LDA	oddbytes		CLC		ADC	buffer		STA	buffer2		LDA	buffer+1		ADC	#0		STA	buffer2+1		LDA	buffer+2		ADC	#0		STA	buffer2+2		LDA	buffer+3		ADC	#0		STA	buffer2+3**		TITLE	'Prime write pump'***********************************************************                                                        **  Sun                   Set up next buffer and topbits  **                                                        **   Primes the pipe for the group of seven bytes routine **  setting the topbits byte and the "next" buffer.       **  The routine also advances the buffer pointer by 7 to  **  prepare for the groups of seven transfer.             **                                                        **    Input:   buffer2   <- points to groups of 7 data    **    Output:  next1,7   <- first 7 bytes in buffer       **             topbits   <- MSBs of first 7 bytes         **                                                        ************************************************************SUN		EQU	*** Copy first seven bytes into the pipeline*		JSR	setbank0	;data bank to $00		LDY	#6SUN2		SEC		LDA	[buffer2],y		STA	|next,y		BMI	sun1		CLCSUN1		ROR	topbits		DEY		BPL	sun2		PHK		;data bank to $FF		PLB		SEC		ROR	topbits** Advance the pointer*		LDA	buffer2		CLC		ADC	#7		STA	buffer2		BCC	sun3		INC	buffer2+1SUN3		EQU	*		RTS**		TITLE	'Set the IWM mode reg'** X is slot*16, Y is the desired mode** Set up the IWM mode register.  Extreme care should be taken*  here. Setting the mode byte with indexed stores causes a false*  byte to be written a cycle before the real value is written.*  This false value, if it enables the timer, causes the IWM Rev A to*  pop the motor on, inhibiting the setting of the mode until the*  motor times out! We avoid this by setting the mode byte only when*  it is not what we want, and if it's not we stay here until we*  see that it is what we want.*SETIWMODE		EQU	*		JSR	SetBankE1	;data bank to $E1		LDA	|monclr+$60	;Motor must be off		LDA	|l6set+$60	;Set up to access mode register		BRA	careful	;Don't mess unless we gottaBIZ		TYA		STA	|l7set+$60	;Try storing the mode valueCAREFUL		EQU	*		TYA		;Get back the target value		EOR	|l7clr+$60	;Compare with observed value		AND	#$1F	;Can only read low 5 bits		BNE	biz	;If not right, back to try again		PHK		;data bank to $FF		PLB		RTS**WAITIWMOFF	EQU	*** Make sure you're in read mode and wait 'til Disk // motor is off*		LDX	#$60	;Set X		JSR	SetBankE1	;data bank to $E1		LDA	|l7clr,x		LDA	|l6set,xWIWM1		EQU	*		LDA	|l7clr,x		AND	#%00100000		BNE	wiwm1		LDA	|l6clr,x** Wait an additional 700 microseconds to allow 12V on Disk // to decay*		PHY		LDY	#217WIWM2		DEY		BRA	*+2		BRA	*+2		BRA	*+2		BNE	wiwm2		PLY*		PHK		;data bank to $FF		PLB		RTS*** This takes grp7ctr and oddbytes and calculates 7*grp7ctr+oddbytes.*  The results are in Y(hi) and A(lo).  This is the number of bytes*  that were received in the last ReceivePack.*RCVCOUNT		EQU	*		LDA	grp7ctr		TAY		LDX	#0		STX	grp7ctr		LDX	#3TIMES7		ASL	a		ROL	grp7ctr		DEX		BNE	times7		CLC		ADC	oddbytes		BCC	t71		INC	grp7ctrT71		STY	oddbytes		SEC		SBC	oddbytes		BCS	t72		DEC	grp7ctrT72		LDY	grp7ctr		RTS**		TITLE	'SmartPort / SmartPort Bus Driver';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:25:19 PM************************************ SMART PORT ENTRY POINTENTRY		EQU	*		PHK		;set data bank $FF		PLB		BCC	bentry	;If non-boot, skip jump to boot		JMP	bootcode** X is still set to slot number.*BENTRY		EQU	*		CLD		;Don't want decimal mode!!** We can't really tolerate interrupts in most of the code, so disable		PHP		;Save interrupt status		LDA	1,s		STA	>IntEnbl		SEI		;No interrupts please** Preserve the zero page work area*		JSR	SavSysZP	;save zpg & set slot 5/6 internal		PHK		PLB		;restore to code bank** If this is a SP call, then get the address of the parm table* Stack looks like:*      _____________________*  + 9|___PCH-1_____________|--User Call*  + 8|___PCL-1_____________|   ___ ___ ___ ___ ___ ___ ___ ___*  + 7|___ENTRY___FLAG______|--|_7_|_6_|_5_|_4_|_3_|_2_|_1_|_0_|*  + 6|___USER_DATA_BANK____|    |   |    *  + 5|___USER_CYA_REG______|    |   |___ 1 = Boot*  + 4|___PROGRAM_BANK______|    |_______ 1 = ProDOS, 0 = SmartPort*  + 3|___PCH-1_____________|*  + 2|___PCL-1_____________|*  + 1|___Psw_______________|* SP->|_____________________|**		STZ	buffer+2		LDA	>ProFlag	;ProFLAG[7] 1=ProDOS, 0=SmartPort		BMI	noplay	;if ProDOS call*		REP	#$30	;16 bit 'm' and 'x'		LONGI	ON		LONGA	ON		LDA	8,s	;get command addr		STA	>SHTempX	;save it		STA	buffer	;get a pointer to retrieve cmd byte		LDA	[buffer]	;get two bytes (cmd = upper)		LDY	#0003		AND	#$4000	;test for extended SmartPort cmd		BEQ	@10	;its standard SP		LDY	#0005	;its extended (I am so privileged)@10		TYA		CLC		;if nonextended, adjust by 3		ADC	8,s	;adjust return address		STA	8,s	;boy, was that ever wierd!!!		SEP	#$30	;8 bit 'm' and 'x'		LONGI	OFF		LONGA	OFF*NOPLAY		EQU	*** On the //GS, it is important to have the Disk // enable lines* off for as long as possible before using the IWM (phases, /WRREQ* lines).  Wait here 'til the Disk // motors are off.*		JSR	WaitIWMOff	;Must preserve Y!!** Now test for a forced INIT from boot code		LDA	>Power1		EOR	#$FF		CMP	>Power2		BEQ	@05		LDA	#ColdReset		JSR	AssignID	;Reset Device assign before boot** Now map any ProDOS unit references to our sequential ones.* The method is bizzare and magicians never reveal their secrets.*@05		LDA	>ProFlag	;[7]=1 if ProDOS, 0 if SmartPort		BPL	SP1	; If it is a SmartPort call.		LDX	#5@10		EQU	*		LDA	ExtBuff,x	;move ProDOS parameters		STA	CMDCode,x		DEX		BPL	@10		STZ	CMDBlocks		STZ	CMDSpare1		STZ	CMDSpare2		LDA	CMDUnit	;76543210 7&6 specify unit		ROL	a	;6543210X C<-7		PHP		;Save drive num		ROL	a	;543210X7 C<-6		ROL	a	;43210X76 (6 is grp of 2)		PLP		;C<-7		ROL	a	;3210X767		AND	#%00000011	;ProDOS only installs up to 4		EOR	#%00000010	;000000/67; 6 was /grpoftwo		TAX		INX		STX	CMDUnit	;ProDOS unit now a SP unitSKIPC1		BRL	skipcopy** For SmartPort calls* pull out the command code, and the address of the parameters.SP1		EQU	*		LDY	#1	; Stacked address is EA-1		LDA	[buffer],y		STA	cmdcode	; COMMAND after JSR to SP		INY		REP	#$30	; 16 bit 'm' and 'x'		LDA	[buffer],y	; Get parmlist address		TAX		; Save it		SEP	#$20	; 8 bit 'm'		BIT	CMDCode	; is it an extended call?		BVC	NonExtPL	; no		REP	#$20	; 16 bit 'm'		INY		INY		LDA	[buffer],y	; Get hi part		STA	buffer+2NONEXTPL		STX	buffer		SEP	#$30	; 8 bit 'm' and 'x'** Now buffer points to parmlist*  Check command type, and pidgeonhole the parmlist length*		LDA	CMDCode	;check if short list		AND	#%10111111	;but mask extension		TAXERRBADC		LDA	#BadCmd		CPX	#SPcmdcnt	;Only valid codes are 0-D		BLT	noeh	;=> at least he got that rightERRORHITCH	JMP	Error	;Gee, maybe we should promote this guy...NOEH		EQU	*		LDY	#0	;Set for indct compare		LDA	[buffer],y	;Get # of parms?		STA	Unit		INY		LDA	[buffer],y	;get the unit #		STA	CMDUnit** Now copy the bytes*OKAYCNT		EQU	*		REP	#$20	;16 bit 'm'		LDA	CMDCode	;move command/unit until have parms		STA	ExtBuff		SEP	#$20	;8 bit 'm'		LDX	#<EPlength-1	;stuff like an extended		LDY	#<EPlength-1	;assume an extended		BVS	copyloop	;hey, we assumed right!		LDY	#<Plength-1	;Always copy the maximumCOPYLOOP		EQU	*		LDA	[buffer],y	;Pull it out of their hat		STA	ExtBuff,x	;Stuff it into mine		DEX		DEY		CPY	#1	;but the unit # is already done		BNE	copyloop	;Copy 'em all		BVC	NoMash	;don't mash parm if nonext		REP	#$30	;now restore list order		LDX	ExtBuff	;get command/unit		LDA	CMDCode-1	;get ext bufflow		STA	ExtBuff	;set'em up right		LDA	CMDCode		STA	ExtBuff+1		STX	CMDCode	;restore command/unit		SEP	#$30	;8 bit 'm' and 'x'NOMASH		EQU	*		PHK		;data bank to $FF		PLB** Okay.  The caller of the SP could be making one of three calls* with a unit number of $00, Control, Init or Status.  Check for these* and do what is appropriate.*		LDA	CMDCode	;remove ext bit from cmdCode		AND	#%10111111		TAX		;and put it in x reg		LDA	CMDUnit		BEQ	@10	;it is unit zero		CMP	#$7F	;max unit is $7E as per spec's		BCS	@08		CPX	#InitCmd	;INITcmd for non zero unit???		BNE	skipc1@08		BRL	BUnit@10		BIT	CMDCode	; is it an extended command ?		BVS	@20	; yes, then dont restructure		JSR	NONtoEXT	; no, then restructure** Check the parameter count for this call to unit#0*@20		EQU	*		LDA	>parmctab,x	;Get the length this command		AND	#$7F	;Force 0 -> MSB		TAY		;Hang on		LDA	#BadPCnt	;Antic bad count		CPY	Unit	;User's pcount is currently here		BNE	ErrorHitch	;What a baby!** Now service one of the three commands		CPX	#InitCMD		BNE	notinit	;Not an Init call		LDA	#ColdReset	;almost like pwrup		JSR	AssignID	;Do a reset cycleAOKAY		LDA	#0	;No error allowed		JSR	SetBankE1	; data bank to E1 before exit		BRL	sa2*ERRHITCH		EQU	*		BRL	ErrorHitch*NOTINIT		TXA		;Equiv to 'cmp #StatusCMD'		BNE	maybectrl*		LDA	#BadCtl	;Antic a non zero stat code		LDX	CMDSCode	;Stat unit#0 can only be code=0		BNE	ErrHitch*		TXA		;Equiv to 'lda #0'		LDY	#7NIN1		STA	[ExtBuff],y	;Clear some space		DEY		BNE	nin1*		LDA	>NumDevices		STA	[ExtBuff],y	;Stick it where they want it		INY*		LDA	#0	;No interrupts on //GS SmartPort		STA	[ExtBuff],y	;Store SP interrupt status*		LDA	#8		DEY		;A,Y has 0008; # bytes status		JSR	squirrel*		BRA	Aokay	;Skip down (up) with no errorMAYBECTRL		EQU	*		CMP	#ControlCMD		BNE	BUnit	;Unit #0 was a bad one*		LDX	CMDSCode	;We allow two control calls for Unit#0		BEQ	enabint	;0 means enable interrupts		DEX		BEQ	disabint	;1 means disable interrupts		LDA	#badctlERRORHITCH2	EQU	*		BNE	ErrHitch	;No other codes allowed*BUNIT		EQU	*		LDA	#badUnit	;Only certain calls can have Unit#0		BNE	ErrHitch	;Branch always*ENABINT		EQU	*DISABINT		EQU	*		LDA	#NoInt	;No interrupt support		BNE	ErrHitch** Okay, everything's all groovy.  ProDOS re-enters here.*  Check Unit number to be sure there is a corresponding deviceSKIPCOPY		EQU	*		LDA	>NumDevices		TAX		LDA	#NoDrive	;Anticpate bad unit number		CPX	CMDUnit		BLT	ErrorHitch2	;Safe- If C clr then Z is clr** Set buffer and bytecount in anticpation of the inevitable SendPack.RESENDCMD		EQU	*		LDA	#<cmdlength	;Command packets are 9 bytes long		STA	bytecountl		STZ	bytecounth		LDA	#<cmdcode		STA	buffer		STZ	buffer+1		STZ	buffer+2		STZ	buffer+3** If it's a SP call, omit the next two steps		LDA	>ProFlag	;Is it a call from ProDOS?		BPL	notstat	;=> Statcode already set...** Need to generate a parameter count for a ProDOS call		LDX	CMDCode		LDA	>ParmCTab,x		AND	#$7F		STA	Unit** If this is a ProDOS status call, set stat code to zero		LDA	CMDCode	;get command		BNE	notstat	;=> Not status so forget it		STA	CMDSCode	;Store in command table		STA	CMDSCode+1	;Store for RAM DISK/AppleDisk3.5** Okay, finally direct command to proper driverNOTSTAT		EQU	*		LDA	Unit		LDX	CmdPCount	;Swap the Parmcount & unit#		STX	Unit		STA	CMDPCount	;Now they're correct		TXA		CMP	#5	;remap if unit <= 4		BGE	SmartBuss	;if not remap must be smartBuss		DEX		JSR	SetBankE1		LDA	|ReMap,x	;remap unit #		STA	Unit		CMP	|SmartUnit	;dispatch to smartbuss driver?		BGE	SmartBuss	;yes		BIT	CMDCode	;extended command?		BVS	NoRemap	;if it is, leave it alone		JSR	NONtoEXT	; convert nonextended to extendedNOREMAP		EQU	*		LDA	Unit		CMP	|RamUnit	;dispatch to Ram Disk?		BEQ	RamDsptch	;yes		CMP	|RomUnit	;dispatch to Rom Disk?		BEQ	RomDsptch	;yes		JSR	StatSet	; special case prodos status		JSR	|AppleDisk	; must be AppleDisk3.5		STA	StatByte	;save away any error		STX	|SHTempX	;save away xfer count		STY	|SHTempYDEXIT		JMP	SonyRetRAMDSPTCH		EQU	*		JSR	StatSet	; special case prodos status		JSR	RamDisk	;off to the Ram Disk driverRRET		LDA	statbyte+1		STA	>SHTempX	; save away xfer count		LDA	statbyte+2		STA	>SHTempY		BRA	DExitROMDSPTCH		EQU	*		JSR	StatSet	; special case prodos status		JSR	RomDisk	;off to the RomDisk driver		BRA	RRetSMARTBUSS		EQU	*		LDA	CMDCode	;get extended		AND	#%01000000		ORA	#%10000000		STA	WPacketType	;Packet type bit 6 is extended*		JSR	ClrPhases	;Bring all phases off for Quark*		JSR	SendPack		BCS	behitch	;If not okay, skip to bus error** Now copy over the buffer address for any data xfer.		REP	#$20	;16 bit 'm'		LDA	CMDBuffer	;assume non extended		STA	buffer		STZ	Buffer+2		SEP	#$20	;8 bit 'm'		BIT	CMDCode	;extended?		BVC	BuffOK	;no		REP	#$20	;16 bit 'm'		LDA	ExtBuff	;set up extended buffer		STA	Buffer		SEP	#$20	;8 bit 'm'		LDA	CMDBuffer		XBA		LDA	ExtBuff+2		REP	#$20	;16 bit 'm'		STA	Buffer+2		SEP	#$20	;8 bit 'm'BUFFOK		EQU	*** Now for some commands, we have to send over a packet of data, too.*  See if this command is one of THOSE.		LDA	cmdcode		AND	#%10111111	;truncate to non extended		TAX		LDA	|parmctab,x		BPL	noxtrasend	;Encoded in top bit** The buffer address and bytecount depend on the call type.		CPX	#ControlCmd		BNE	NOControl** In the case of control, bytecount:=(buffer) then buffer:=buffer+2		LDY	#1		LDA	[buffer],y	;Get Hi order bytecount		TAX		DEY		LDA	[buffer],y		PHA		;Keep for later		CLC		LDA	#2		ADC	buffer		STA	buffer		PLA		;Get back Lo order bytecount		BCC	secondsend	;Skip hi ord increment		REP	#$20	;'m' = 16 bits 		INC	buffer+1	;adjust both bytes of pointer		SEP	#$20	;'m' = 8 bits		BRA	secondsend	;Skip to store bytecount*NOCONTROL		EQU	*		CPX	#WriteCMD	;Check for a writeblock		BNE	NOWBlock	;Must be control or write** In the case of WriteBlock, the length is 512 and the buffer*  address is at buffer in the command table		LDA	#0		LDX	#2		BNE	secondsend** For FileWrite, the buffer address is at CMDbuffer*  and the length is at CMDblock.NOWBLOCK		EQU	*		LDX	CMDBlockh		LDA	CMDBlockl*SECONDSEND	EQU	*		STX	bytecounth		STA	bytecountl*		LDA	#datamark		STA	WPacketType	;Identify this as a data packet*		JSR	SendData		BCC	noxtrasendBEHITCH		EQU	*		JSR	SetBankE1	;data bank to $E1		LDA	#BusErr	;This is the bus error hitch		BNE	Error** On ProDOS status call, we've got to point the buffer pointer*  correctly to zero page... it's the only case special case*  (on Write, Format and Control no data comes back).*NOXTRASEND	EQU	*		LDA	>ProFlag		BPL	getresults		LDA	cmdcode		BNE	getresults*		LDA	#<CMDBufferh	;Want status in these four		LDX	#>CMDBufferh		STA	buffer		STX	buffer+1** Please to be calling ReceivePack*GETRESULTS	EQU	*		JSR	RecPack	;Get status byte (maybe read data too)		BCC	RxPack1	; if no error		LDA	>CmdRetry	; retry command ?		DEC	a		STA	>CmdRetry		BEQ	behitch	; no		LDA	Unit	; have to swap back the		LDX	CmdPCount	; Unit # and ParmCnt		STX	Unit	; before resending the		STA	CmdPCount	; command packet.		BRL	ReSendCMD	; now go resend entire command** Figure how many bytes were sent and put that in X,Y temps*RXPACK1		EQU	*		JSR	Rcvcount	;Do the times 7...		JSR	squirrel	;Store away count in SHTEMPs** For the ProDOS status call, we've got to look at the status byte*  returned and return a DIP error if appropriate.*  Also overwrite the X,Y temps with # blocks if this is a ProDOS Stat call.*		JSR	SetBankE1	;data bank to $E1SONYRET		EQU	*		LDA	CMDCode	;Is it a ProDOS status call		BNE	noerror		LDA	|ProFlag		BPL	noerror*		LDA	CMDBlockl	;This'll get loaded into the XY regs later		STA	|SHTempX		LDA	CMDBlockh		STA	|SHTempY*		LDA	CMDBufferh	;Check status byte		BIT	#%00010000	;is volume online?		BNE	@10	;yes. go test write protect		LDA	#Offline		BRA	error@10		EQU	*		LSR	a		LSR	a		LSR	a		LDA	#WriteProt		BCS	error**  Now it's time to think about returning to the caller*  Remember that ProDOS doesn't want to know about soft errors,*  only fatal ones.  If this is a ProDOS call, and the soft error*  bit in the statbyte is set, there IS NO error (statbyte is cleared).*  Also, ProDOS wants only I/O, Write Protect, No Device, Offline.*  If any other hard error comes from the device on a ProDOS call,*  map it to an I/O Error.  (Gross me out.)*NOERROR		EQU	*		LDA	statbyteERROR		EQU	*		JSR	SetBankE1	; data bank to $E1		STA	|Retry	;Keep unadulterated error in shole		TAX		;Set the Z flag		BEQ	sa2	;Special case the zero*		PHA		;save error code		LDA	|ProFlag	;ProFLAG[7]=Prodos Call		ROL	a	;C<6 5 4 3 2 1 0 X		PLA		;restore error code		BCC	sa2	;If SP call, no mapping occurs*		LDX	#0	;Assume a soft error		CMP	#%01000000	;Soft error check		BGE	@80	;If $40 or bigger, map to zero*		LDX	#IOError	;Now anticipate ProDOS I/O error		CMP	#WriteProt		BEQ	sa2	;OK to return Write Protect		CMP	#NoDrive		BEQ	sa2	;OK to return Drive disconnected		CMP	#OffLine		BEQ	SA2*@80		EQU	*		TXA		;Use the default valueSA2		EQU	*		STA	|SHTemp1	;Keep in screenhole		PHB		JSR	RestoreIWM	;set for Disk][** Now, restore our zero page area.		JSR	ResSysZP	;restore zero page** We're into the stretch!  Restore interrupt mask, load X, Y, and A*  and set the carry if the error byte is non-zero.		PLB		PLP		;Restore interrupt flag		LDA	|SHTempx	;Get X value		TAX		LDA	|SHTemp1	;Grab the error result code		PHA		LDA	|SHTempy	;Pull out the Y value		TAY		;No more access to screenholes		CLC		;Anticipate zero result code		PLA		;Pull back result code		BEQ	@99	;Return with carry clear		SEC		;Some type of error@99		EQU	*		RTL		;return to $Cn space		EJECT;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:26:51 PM** This routine converts the parameter format in zero* page from a non-extended format to an extended format.** The remapping of parameters is command dependent. Commands* 0 through 7 require different mapping than commands 8 & 9.* Commands 0 through 7 are remapped as follows.....**         $45 = CmdCode -----> $45 = CmdCode*         $46 = ParmCnt -----> $46 = ParmCnt*         $47 = >Buffer -----> $42 = >Buffer*         $48 = <Buffer -----> $43 = <Buffer*         $49 = >Block  -----> $48 = >Block*         $4A = <Block  -----> $49 = <Block*         $4B = ^Block  -----> $4A = ^Block*                              $44 = 00*                              $47 = 00*                              $4B = 00*                              $4C = 00*                              $4D = 00** Commands 8 through 9 are remapped as follows.....**         $45 = CmdCode -----> $45 = CmdCode*         $46 = ParmCnt -----> $46 = ParmCnt*         $47 = >Buffer -----> $42 = >Buffer*         $48 = <Buffer -----> $43 = <Buffer*         $49 = >Count  -----> $48 = >Count*         $4A = <Count  -----> $49 = <Count*         $4B = >Addr   -----> $4A = >Addr *         $4C = <Addr   -----> $4B = <Addr*         $4D = ^Addr   -----> $4C = ^Addr*                              $44 = 00*                              $47 = 00*                              $4D = 00*NONTOEXT		EQU	*		LDA	CmdCode	; is this a read or write call?		CMP	#8		BGE	MapExt	; yes, do 2nd remapping type.		STZ	CmdSpare1	; zero out bytes 10 & 11 if not read or		STZ	CmdSpare2	; write callMAPEXT		EQU	*		REP	#$20	;16 bit 'm'		LONGA	ON		LDA	CMDBuffer	; map non extended call to extended		STA	ExtBuff		LDA	CMDBlock		STA	ExtBlock		LDA	CMDBlocks		STA	CMDBlockh		LDA	CMDSpare1		STA	CMDBlocks		SEP	#$30		LONGA	OFF		STZ	CMDBuffer		STZ	ExtBuff+2		STZ	CMDSpare2		RTS		EJECT**********************************************************************  For the Apple//GS, we need to reset the IWM to its*  former disk // state.  This is done by setting the mode register*  to a little known (and less documented) mode which speeds up the*  internal motor timeout.  When the motor enable has timed out, the*  mode can be set back to zero.  This method is necessary because*  if the timer is enabled within the timeout period, the motor on a*  Rev A IWM pops on for the full timeout period (since mode changes*  are disabled when the motor is on.**********************************************************************RESTOREIWM	EQU	*		JSR	SetBankE1	;data bank to $E1		LDA	|monclr+$60	;Motor off		BIT	|l6set+$60	;Into mode reg access mode		LDA	#$2B	;This is the magic "speed up" value		STA	|l7set+$60	;Throw into mode register		LDY	#5	;wait 8 uSec minimum		DEY		BNE	*-1WAITOFF		EQU	*		LDA	|l7clr+$60	;Wait 'til motor off		AND	#$20		BNE	waitoff		LDY	#0	;Now set the reg back to $00		LDX	#$60	;IWM's in slot 6		JSR	SetIWMode		JSR	SetBankE1	;data bank to $E1		LDA	|l6clr+$60		LDA	|ca1clr+$60		LDA	|lstrbclr+$60		LDA	|MonClr+$60	;MSA Phoenix Mod 7/22/85		PHK		;data bank to $FF		PLB		RTS		TITLE	'ID Assignment Cycle'****************************************************************** Devices are assigned starting with unit #1* in ascending order as follows:**   INPUTS:   A = init code *                 $00 = pwron reset*                 $40 = INIT cmd or Ctrl-Oapple-Reset*                 $80 = Comm Reset (from Cbuss Driver)**          RAM DISK*          ROM DISK*          AppleDisk 3.5*          UniDisk 3.5*****************************************************************ASSIGNID		EQU	*		STA	>assignflg	;save assignID mode** Save the command code, unit, and init code 'cause we'll trample 'em.*		LDA	CMDCode		PHA		LDA	CMDPCount		PHA		LDA	CMDSCode		PHA		LDA	Unit		PHA		LDA	>assignflg		STA	CMDScode	;store away the type of INIT** Set up to send DefID command packets*		LDX	#InitCmd		STX	CMDCode		STZ	Unit		LDX	#2	;# parms in Init call		STX	CMDPCount		CMP	#$80	; is this a logical device init		BLT	NotLDinit	;Logical Device init = $80		LDA	>SmartUnit	; if it is, only init UniDisk3.5		STA	Unit		BRA	SmartTimeNOTLDINIT		EQU	*		LDA	#0		TAXINITMAP		EQU	*		STA	>RamUnit,x		INX		CPX	#4		BNE	InitMapINITMAP0		EQU	*	;init ReMap = 01 02 03 04		TXA		STA	>ReMap-1,x		DEX		BNE	InitMap0** Install any RAM DISKs*		INC	Unit	; start with unit #1		JSR	RamDisk	;init Ram Disk		BCS	RomTime		LDA	Unit		STA	>RamUnit	;Set Ram Disk unit #		INC	Unit** Install any ROM DISKs*ROMTIME		EQU	*		LDX	Unit	;x=unit, a=parm count		LDA	#1		JSR	RomDisk	;initialize Rom Disk		BCS	DoDSony		LDA	Unit		STA	>RomUnit	;set Rom Disk unit #		INC	Unit** Install any Apple3.5 Disks*DODSONY		EQU	*		LDA	#$FF		STA	>power1	;force AppleDisk Configure 		LDA	Unit	; get unit #		STA	>DumbUnit		BRA	@20@10		EQU	*		INC	Unit@20		EQU	*		LDX	unit	;save away unit #		PHX		JSR	|AppleDisk ;Try to init AppleDisk 3.5		PLX		;restore unit #		STX	unit		BCC	@10	;and check for next AppleDisk 3.5@30		EQU	*** Assign ID's to any UniDisk 3.5 - SmartPort devices*SMARTTIME		EQU	* 		LDA	#00 		STA	>diskreg 		JSR	resetchain	;Reset all of those things		LDA	#<CMDCode		STA	buffer		STZ	buffer+1		STZ	buffer+2		LDA	CMDCode	;now build type		AND	#%01000000		ORA	#%10000000		STA	WPacketType	;encode type with extended bit*		JSR	ClrPhases	;Make sure phases are off for Quark** Send an ID for the next device in the chain*		LDA	Unit		STA	SmartUnit		BRA	MorDevicesMDEV0		EQU	*		INC	UnitMORDEVICES	EQU	*		LDA	#<cmdlength		STA	bytecountl	;ReceivePack scrambles count		STZ	bytecounth*		JSR	SendOnePack	;Send the command		BCC	mdev2	;If okay, skip to get response*		DEC	Unit		JMP	mdev1*MDEV2		JSR	ReceivePack	;Get the response		LDA	statbyte		BEQ	mdev0** Okay, we done last device.  Squirrel away the number of devices.*MDEV1		EQU	*		JSR	SetBankE1	;data bank to $E1		LDA	Unit		STA	|NumDevices	;Devices out there** Recover the scrambled ProDOS parms*		PLA		STA	unit		PLA		STA	CMDSCode		PLA		STA	CMDPCount		PLA		STA	CMDCode** Now set the powerup bytes so we'll never have to do this again.*		LDA	#PBBValue		STA	|Power1		EOR	#$FF		STA	|Power2	;set the power up flags		LDA	>assignflg		BMI	DoneIt	;don't remap if it was a CommReset		EJECT***************************************************** Now it's time to do any remapping based on the* control panel selected boot device.** 5 = disk* 8 = Ram Disk* 9 = Rom Disk****************************************************		LDX	#1	; prepare for no disk units		LDA	|NumDevices	; is there really a disk drive?		CMP	|DumbUnit		BGE	GoMap	; yes		STX	|DumbUnit	; fake it outGOMAP		EQU	*		LDA	|BramBuffer+$28	;get startup device		STA	BramFlag	;and save in flag		CMP	#8	;is it the Ram Disk ?		BEQ	RRMap	;yes		CMP	#9	;is it the Rom Disk ?		BEQ	RRMap	;yes		LDA	#1		CMP	|RamUnit	;is ram disk current boot?		BEQ	DiskMap	;yes		CMP	|RomUnit	;is rom disk current boot		BEQ	DiskMap	;yes		RTSRRMAP		TAX		;get 8 for RAM and 9 for ROM into X		LDA	|RamUnit-8,x	;get RAMUnit or ROMUnit		BRA	MapTime	;modify map (put zero if no device!)DISKMAP		LDA	|DumbUnit	;get UniDisk 3.5 unit** A Reg = Boot device unit #*MAPTIME		EQU	*		STA	|ReMap	;Move new Boot unit to boot position		TAX		BEQ	DoneIt	; in case no RAM DISK/ROM DISK		DEX		;now shift the map		BEQ	DoneItDOMAP		TXA		STA	|ReMap,x		DEX		BNE	DoMapDONEIT		EQU	*		RTS**SQUIRREL		EQU	*		STA	>SHTempX		TYA		STA	>SHTempY		RTS******************************************* Routines to set the Data Bank******************************************SETBANK0		PEA	|$0000		BRA	SetBankSETBANKE1		PEA	|$E1E1SETBANK		PLB		PLB		RTS		EJECT********************************************************** Save System Zero Page* * and Select Slot 6 internal**********************************************************SAVSYSZP		EQU	*		PHB		;preserve data bank		REP	#$30	;16 bit m/x		LONGI	ON		LONGA	ON		LDA	#ZPsize-1	;bytes to move		LDY	#SysSavRam		LDX	#SMART_ZPAGE		MVN	Bank00,BankE1		LONGI	OFF		LONGA	OFF		SEP	#$30	;8 bit m/x		JSR	SetBankE1		LDA	|SltRomSel	;get slot configuration		STA	|SavRomSel	;save it		REP	#$30		LONGI	ON		LONGA	ON		LDA	#0006		JSL	Slot_Arbiter	;ask for slot 6		STX	|SavSltArb	;save slot config 		SEP	#$30		LONGI	OFF		LONGA	OFF		LDA	|SavRomSel		AND	#%10111111	;set slots 6 internal		STA	|SltRomSel@10		PLB		RTS********************************************** Restore Zero Page & Environment*********************************************RESSYSZP		EQU	*		PHB		;preserve data bank		REP	#$30	;16 bit m/x		LONGI	ON		LONGA	ON		LDA	#ZPsize-1	;bytes to move		LDX	#SysSavRam		LDY	#SMART_ZPAGE		MVN	BankE1,Bank00;		JSR	SetBankE1		LDX	|SavSltArb	;get original slot config back		LDA	#$0300		JSL	Slot_Arbiter		LONGI	OFF		LONGA	OFF		SEP	#$30	;8 bit m/x		LDA	|SavRomSel	;restore Slot Rom Select		STA	|SltRomSel@10		PLB		RTS******************************************************** Save FW Zero Page*******************************************************SAVFWZP		EQU	*		PHB		;preserve data bank		REP	#$30	;16 bit m/x		LONGI	ON		LONGA	ON		LDA	#ZPsize-1	;bytes to move		LDY	#FWSavRam		LDX	#SMART_ZPAGE		MVN	Bank00,BankE1		LONGI	OFF		LONGA	OFF		SEP	#$30	;8 bit m/x		PLB		;restore data bank		RTS******************************** Restore FW Zero Page*******************************RESFWZP		EQU	*		PHB		;preserve data bank		REP	#$30	;16 bit m/x		LONGI	ON		LONGA	ON		LDA	#ZPsize-1	;bytes to move		LDX	#FWSavRam		LDY	#SMART_ZPAGE		MVN	BankE1,Bank00		SEP	#$30	; 8 bit 'm' and 'x'		LONGI	OFF		LONGA	OFF		PLB		RTSSTATSET		EQU	*		LDA	|ProFlag	;[7] 1=Prodos, 0=MLI		BPL	RDGO	;don't redirect if SmartPort call		LDA	cmdcode	;is this a status call		BNE	RDGO	;don't redirect if not status		LDA	#<ExtBlock	;else redirect buffer output		LDX	#>ExtBlock		STA	ExtBuff		STX	ExtBuff+1RDGO		LDX	Unit	;x=unit, a=ParmCnt		LDA	CmdPCount		RTS		TITLE	'Service Boot Request'*******************************************BOOTCODE		EQU	*********************************************		LDA	>BramBuffer+$28	;check boot device		CMP	>BramFlag		BEQ	@10		LDA	#$EE	;force AssignID in mainline		STA	>Power1	;before the ReadBlock executes*@10		LDX	#5	;Copy a command table@20		LDA	>boottab,x		STA	>ExtBuff,x		DEX		BPL	@20		LDA	>RAMunit	;RamDisk allocated?		BEQ	@30	;no.		CMP	>ReMap	;is it boot device?		BNE	@30	;no.		LDA	>RDFmtFlag	;is RamDisk formatted Yet?		BMI	@30	;yes. leave it alone		LDA	#02	;place a COP opcode at BF00		STA	>FormSelect	;cause a ProDOS format of null RD** Now do the read block $0000 from unit zero to $800@30		JSL	>bentry		BCS	booterr	;If fail, check loc*		LDA	>$800	;If ($800)<>1 this is no A// boot disk		TAX		DEX		BNE	booterr*		LDA	>$801	;If $801 is zero, no boot		BEQ	booterr** It all looks okay.  Jump to the code with N0 in X.*		LDX	#$50	;always slot 5 unit		CLC		;no boot error		RTL		;back to bank 0**BOOTERR		EQU	*		CLC		;set native		XCE		PHP		;save his		SEP	#$30		LDA	loc1	;was this an auto boot ?		CMP	>mslot		BEQ	auto0** The boot failed and the user specifically requested the boot.* Give him a message pinpointing the problem (if possible).*		JSR	SetBank0	;data bank to $00		LDA	|SltRomSel	;enable slots 5 & 6		PHA		;but save it first		AND	#%10011111		STA	|SltRomSel		LDA	|StateReg	;save away the state register		PHA		LDA	#%00001000		STA	|StateReg		SEC		;have to go to emulation mode		XCE		PHP		;but save our mode		JSL	C5Bootm		PLP		;and back to native mode		XCE		LDX	#0	;Antic an I/O error*		LDA	>retry	;get back the unadulterated error		BNE	bend1		LDX	#1	;non bootable disk*BEND1		CMP	#NoDrive		BNE	bend2		LDX	#2	;No drive connected*BEND2		CMP	#Offline		BNE	bend3		LDX	#3BEND3		TXA		JSR	|PrintMsg		PLA		STA	|STateReg		PLA		;restore slot rom selection		STA	|SltRomSelAUTO0		EQU	*		LDA	#$27	;I/O error		PLP		;restore his		XCE		SEC		;set error flag		RTL**BOOTTAB		DC.B	READCMD,$50,0,8,0,0	;Read from 1st; blk0->$801*		TITLE	'Cold RESET Initialization'********************************************************************** Called from monitor via PROCINIT equate** This routine is used to setup the SmartBus driver and reset* the SmartBuss devices, assign their ID's and assign ID's by* making INIT calls to the AppleDisk 3.5 driver routine.********************************************************************RESET		EQU	*		PHP		;save interrupt environment		SEI		;and disable 'til done reset		LDA	1,s		STA	>IntEnbl	; don't forget the flag		PHB		JSR	SetBankE1	;Data Bank = $E1		JSR	SavSysZP		LDA	>cyareg	;save CYA		PHA		AND	#%11111011	;fast mode & disable slot 6 motor detect		ORA	#%10000000		STA	|cyareg		PHB		LDA	#%00000000	;clear the entire access flag		STA	>AccessFlg		STA	>AccessFlg+1** Now determine which type of AssignID to do		LDA	>Power1	;is this a PwrUp or Cold Reset		EOR	#$FF		CMP	>Power2		BNE	@10	;it a PwrUp		LDA	#ColdReset	;this is almost a 'major' reset		BRA	@20@10		LDA	#PwrUpReset	;This is a 'MAJOR' reset@20		JSR	AssignID	;assign SmartBuss and AppleDIsk ID's		JSR	RestoreIWM	;set IWM for Disk][		PLB		PLA		;restore CYA		STA	|cyareg		JSR	ResSysZP		PLB		PLP		;restore interrupt environment		RTS		;*		TITLE	'Calling the RamDisk'***************************************************************** This routine makes a tool call to the ramdisk.* If auxmem is switched in, main memory is selected,* and the buffer address is adjusted as neccessary.****************************************************************RAMDISK		EQU	*		PHB		; save and set to $E1		JSR	SetBankE1		LDA	|StateReg	; save the system state		PHA		LDA	CMDCode	; get the command #		AND	#$3F		TAX** Now check parmcnt for RamDisk toolset		LDA	>parmctab,x		AND	#$7f	;get parm count		CPX	#Initcmd		BNE	@10		INC	a	;add 1 if its an INIT cmd@10		CMP	CMDPcount		BEQ	@20		LDA	#BadPcnt	;($04)		STA	statbyte		BRA	@80@20		REP	#$30	; 16 bit 'm' and 'x'		LONGA	ON		LONGI	ON		LDA	#CmdXfrDir	; determine xfer direction@30		EQU	*		ROR	a		DEX		BPL	@30	; if C = 0, then destination = host		SEP	#$30	; 8 bit 'm' & 'x'		LONGA	OFF		LONGI	OFF		LDA	|StateReg		AND	#%00110000	; RAMRD, RAMWRT ?		BEQ	@60	; no		BCS	@50	; if destination = device@40		EQU	*	; else destination = host		AND	#%00010000	; if RAMWRT is off, no futz		BEQ	@60		JSR	FutzAddr	; well go do it		BRA	@60@50		EQU	*		AND	#%00100000	; if RAMRD is off, no futz		BEQ	@60		JSR	FutzAddr	; well go do it@60		EQU	*** Now call the RAMDISK*		REP	#$30	; 16 bit 'm' and 'x'		LONGA	ON		LONGI	ON		LDX	#$0A0D	; RAMDISK tool call		JSL	>$E10000		SEP	#$30	; 8 bit 'm' and 'x'		LONGA	OFF		LONGI	OFF@80		PLA		; restore state		STA	|StateReg		PLB		CLC		LDA	statbyte	; did ramdisk fail		BEQ	@90	; if no fail		SEC		; else flag error@90		EQU	*		RTS** This routine adjusts the address and* system state if neccessary.*FUTZADDR		EQU	*		LDA	ExtBuff+2	; get the bank address		BEQ	FutzIt	; adjust address if bank 0		CMP	#$E0	; or bank E0		BNE	NoAddFutz	; dont futz if not 0 or E0FUTZIT		EQU	*		LDA	#%00110000	; switch to main		TRB	|StateReg		LDA	ExtBuff+1	; get A8-15		CMP	#$D0	; is it in the LC		BGE	NoAddFutz	; yes		CMP	#$02	; page 0 or 1		BLT	NoAddFutz	; no		INC	ExtBuff+2	; if even, make it oddNOADDFUTZ		EQU	*		RTS		TITLE	'Calling the ROMDISK'********************************************************** This routine will search for the RomDisk* driver on an INIT call only.  All other* calls will dispatch to the RomDisk driver.*********************************************************ROMDISK		EQU	*		LDA	CMDCode	; is it an init call?		AND	#$3F		CMP	#InitCMD		BNE	@20	; no, then dont search		LDX	#5@10		EQU	*		LDA	>$F00000,x	; get romdisk string		CMP	>rdid,x	; and check it		BNE	@40	; if not same, bomb out		DEX		BPL	@10; The following line of code was the last change made to the Tenspeed FF ROM before Final		BRA	@25	; THE VERY COSTLY MISSING BRA INSTRUCTION JOA MAY 89@20		LDA	>ROMUnit	;does a ROMDisk exist?		BEQ	@40	;nope. so return NoDevice Connected!@25		JSL	>RomDriver	; dispatch to romdisk		CLC		LDA	statbyte		BEQ	@30		SEC@30		EQU	*		RTS@40		EQU	*		SEC		; flag error		LDA	#$28		STA	StatByte		RTS		MSB	onRDID		DC.B	'ROMDIS'