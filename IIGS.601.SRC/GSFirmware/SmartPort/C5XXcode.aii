		TITLE	'Slot 5 Boot Code Space';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/16/91 at 1:21:49 PM***************************************************** Auto Boot signature bytes* This is also the boot (auto & PR#5) entry point.** The 65816 processor environment must be in full* emulation mode when using this entry point.**         Data Bank Register   = $00*         Direct Page Register = $0000*         Emulation Flag (e)   = 1****************************************************		LDX	#$20		LDX	#$00		LDX	#$03		CMP	#0	; Flag that this is a boot		BCS	bootcase5	; Skip to prep for $C800 trip***************************************************** ProDOS Block Device Driver entry point** The 65816 processor environment must be in full* emulation mode when using this entry point.**         Data Bank Register   = $00*         Direct Page Register = $0000*         Emulation Flag (e)   = 1** Input parameters are as follows:**         $000042 = ProDOS Block Device command*         $000043 = Unit Number*         $000044 = Buffer Address (low byte)*         $000045 = Buffer Address (high byte)*         $000046 = Block Address (low byte)*         $000047 = Block Address (high byte)****************************************************PRODOSENTRY	EQU	*		SEC		BCS	MakeFlag	; Skip the clear		EJECT***************************************************** This is the SmartPort entry point** The 65816 processor environment must be in full* emulation mode when using this entry point.**         Data Bank Register   = $00*         Direct Page Register = $0000*         Emulation Flag (e)   = 1** Standard SmartPort calls are executed from bank $00* as follows:**         jsr   SPentry       ; Call to SmartPort*         dfb   Command       ; Define SmartPort command*         dw    ParmList      ; Pointer in bank 0 to parameter list*         bcs   error         ; SmartPort returns here** Extended SmartPort calls are executed from bank $00* as follows:**         jsr   SPentry       ; Call to SmartPort*         dfb   Command+$40   ; Define SmartPort command*         dw    ParmList      ; Pointer to parameter list*         dw    ^ParmList     ; *         bcs   error         ; SmartPort returns here****************************************************SPENTRY		EQU	*	; Only in //GS version		CLCMAKEFLAG		EQU	*		ROR	a		AND	#%10000000	; make sure boot flag cleared		STA	>ProFLAG	; Bit [7] = 1 if ProDOS, = 0 if SP		CLC		; This is not a boot entryBOOTCASE5		EQU	*		BCC	bc5	; if not a boot		LDA	#%11000000	; Bit [6] = 1 if boot		STA	>ProFLAGBC5		EQU	*		XCE		; save carry for mode switch		CLC		; going to native mode		XCE		; switch mode & restore carry		SEP	#$30	; 8 bit 'm' & 'x'		LDA	#$C5	; Load value for MSLOT		STA	|MSlot		LDA	#4	; set command retry counter		STA	>CmdRetry		PHP		; save entry flag		PHB		; save last data bank		LDA	#00	;force caller to call from bank 00		PHA		PLB		LDA	|cyareg	; get callers mode		PHA		; and save it		STA	>CyaSave	; save it here !!!		AND	#%11111011	; Fast Mode & disable slot 6 motor detect 		ORA	#%10000000		STA	|cyareg		LDA	3,s	; get entry flag		LSR	a	; restore entry flag		JSL	>SPdriver+6	; off to bank $FF thru jmp table		EJECT** Returns here from bank $FF when done.*		XBA		; save error code		PLA		; restore system speed		LDA	>CyaSave		STA	|cyareg		PHP		; save error flag		SEC		; set emulation mode		XCE		PLP		; restore error flag		PLB		; restore last data bank		PLA		; clean up stack (EntryFlag)		XBA		; restore error code		PHA		; save error code		LDA	>ProFLAG	; return from boot?		AND	#%01000000		BNE	bootcheck	; yes		PLA		; restore error info		RTS*** Do this code if the boot can't be done.*  If this was an autoboot (loc=$CN00), continue the slot scan.*  If not, drop into basic after issuing appropriate message**BOOTCHECK		EQU	*		LDA	#00		PHA		PLB		;force bank 00 just in case		LDA	#%00001000		STA	|shadow	; video shadowing in except SuperHires		PLA		; restore error info		BCS	bootfail		JMP	|$0801	; and away we go!BOOTFAIL		EQU	*		LDX	loc0		BNE	noauto	; if from PR#s		LDA	loc1		CMP	|MSlot		BNE	noauto	; if from PR#s		JMP	autoscan	; continue slot scanNOAUTO		EQU	*		JMP	Basic*C5BOOTM:		JSR	setvid	; set back the hooks		JSR	setkbd		JSR	text		JSR	home		LDA	#$0A		STA	cv		STZ	ch		JSR	vtab		RTL*PARMCTAB:		DC.B	%00000011	;status:  3 parms/no data send		DC.B	%00000011	;read:    3 parms/no data send		DC.B	%10000011	;write:   3 parms/data send		DC.B	%00000001	;format:  1 parm/no data send		DC.B	%10000011	;control: 3 parms/data send		DC.B	%00000001	;init:    1 parm/no data send		DC.B	%00000001	;open:    1 parm/no data send		DC.B	%00000001	;close:   1 parm/no data send		DC.B	%00000100	;charRead:4 params/no data send		DC.B	%10000100	;CharWr:  4 parms/data send		DC.B	%10000011	;SetFmtOpts 3 p/data send 		DC.B	%00000011	;GetFmtOpts 3 p/no data send		DC.B	%10000100	;RawRead    4 p/   data send*** Shift tables for use when reading.  Each table should not* straddle pages.*SHIFT1		DC.B	$80,$80,$80,$80,$80,$80,$80,$80		DC.B	$00,$00,$00,$00,$00,$00,$00,$00SHIFT2		DC.B	$80,$80,$80,$80,$00,$00,$00,$00		DC.B	$80,$80,$80,$80,$00,$00,$00,$00SHIFT3		DC.B	$80,$80,$00,$00,$80,$80,$00,$00		DC.B	$80,$80,$00,$00,$80,$80,$00,$00SHIFT4		DC.B	$80,$00,$80,$00,$80,$00,$80,$00		DC.B	$80,$00,$80,$00,$80,$00,$80,$00**** This table, when sent in reverse order, profides a*  sync pattern used to synchronize the drive IWM with*  the data stream.  The first byte (last sent) is the*  packet begin mark.**PREAMBLE		DC.B	PACKETBEGSYNCTAB		DC.B	$FF,$FC,$F3,$CF,$3F*		DCB.B	13,0*		DC.B	PCID2		DC.W	0	; Total Blocks (force stat call)		DC.B	PDIDBYTE	; ProDOS ID byte		DC.B	PRODOSENTRY	; Low byte of ProDOS entry pt