		TITLE	'Serial & Communications equates';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 11:5:32 PM** Command codes** Default command char is ctrl-A (^A) or ctrl-I**     ^AnnB: Set baud rate to nn*     ^AnnD: Set data format bits to nn*     ^AI:   Enable video echo*     ^AK:   Disable CRLF*     ^AL:   Enable CRLF*     ^AnnN: Disable video echo & set printer width*     ^AnnP: Set parity bits to nn*     ^AQ    Quit terminal mode*     ^AR    Reset the ACIA, IN#0 PR#0*     ^AS    Send a 233 ms break character*     ^AT    Enter terminal mode*     ^AZ:   Zap control commands*     ^Ax:   Set command char to ^x*     ^AnnCR:Set printer width (CR = carriage return)** Enable / Disable commands**     ^AC E/D Column overflow*     ^AL E/D Linefeed same as L & K*     ^AM E/D Mask incoming linefeeds*     ^AX E/D Xon Xoff handshaking*     ^AF E/D Find keyboard*     ^AB E/D Turn on/off buffering*     ^AA E/D Turn on/off Applesoft tabbing mode*     ^AE E/D Turn on/off video echo**SERSLOT		EQU	$C100COMSLOT		EQU	$C200		MSB	ONCMDCUR		EQU	'?'	;Cursor while in command modeTERMCUR		EQU	'_'	;Cursor while in terminal mode		MSB	OFFLFEED		EQU	$8A	;LinefeedXON		EQU	$91	;XON characterXOFF		EQU	$93	;XOFF characterNEWXON		EQU	$11	;XON character without hi bitNEWXOFF		EQU	$13	;XOFF character without hi bit** Screenhole usage**  479,47A      temp          ;Temporary for the command parser*  4F9,4FA      eschar        ;Current escape character*  579,57A      sermode       ;Firmware mode flags*  5F9,5FA      sermode3      ;Firmware mode flags*  679,67A      sermode2      ;Firmware mode flags*  6F9,6FA      pwdth         ;Number of columns on device*  779,77A      col           ;Output device column counter*  7F9,7FA      flags         ;Firmware mode flags*TEMP		EQU	$479-$C1	;Temp for command parserESCHAR		EQU	$4F9-$C1	;Current escape characterSERMODE		EQU	$579-$C1	;Firmware mode flagsSERMODE3		EQU	$5F9-$C1	;SERMODE2		EQU	$679-$C1	;Firmware mode flagsPWDTH		EQU	$6F9-$C1	;Printer widthCOL		EQU	$779-$C1	;Current printer columnFLAGS		EQU	$7F9-$C1	;D7 = Video echo D6 = CRLF*MSLOT		EQU	$07F8	;(slot 0 temp) owner of $C8 space OURCH		EQU	$057B	;Column counter for 80 column firmware** Sermode2 bit position masks*NFLAGMASK		EQU	%10000000BFRNGMASK		EQU	%01000000DCDHSMASK		EQU	%00100000CHRBUFMASK	EQU	%00010000	;Bit says if one byte buf is fullCRSTUFFMASK	EQU	%00001000	;Enable/Disable col overflow cr stuffingINFLOMASK		EQU	%00000100	;Input flow is haltedOUTFLOMASK	EQU	%00000010	;Output flow is haltedBRPMASK		EQU	%00000001** Sermode3 bit position masks*CSDMASK		EQU	%10000000RCVERRMASK	EQU	%01110000BTABMASK		EQU	%00001000BASICMASK		EQU	%00000100EMASK		EQU	%00000010	;Little doc'd error suppression defeat** Flags bit position masks*ECHOMASK		EQU	%10000000GENLFMASK		EQU	%01000000XMASK		EQU	%00100000KEYMASK		EQU	%00010000MASKLFMASK	EQU	%00001000DSRHSMASK		EQU	%00000100	;Enable/Disable DSR Tx handshakeWAITXMASK		EQU	%00000010COMMMASK		EQU	%00000001*** SCC Hardware*SCCCMD		EQU	$BFFD	;For Port 1 add $3C, port 2 add $3BSCCDATA		EQU	$BFFF**********************************                             **       Bank $E1 Storage      **                             *********************************		EQUSECT	$E10FFC*SPEEDSTORE	EQUDS.B	2	;Used to keep speed at entry (1 ea port)FIRSTTIME		EQUDS.B	2	;Indexed with $C1*		EQUORG	$E1158A*NUMBER		EQUDS.B	1OLDCUR		EQUDS.B	1	;Saves cursor while in commandOLDCUR2		EQUDS.B	1	;Saves cursor while in terminal mode** These are storage locations for the SCC registers and are referenced*  with $3C, and $3B as indices.*		EQUORG	$E1158E-$3B*WR3		EQUDS.B	2WR4		EQUDS.B	2WR5		EQUDS.B	2WRCD		EQUDS.B	2*		EQUORG	$E11596-$C1*APTALKFLAG	EQUDS.B	2	;MSB says if Appletalk activeONEBYTEBUF	EQUDS.B	2	;Single char buffer used in XON/XOFFSAVEHEARTBEAT	EQUDS.W	2	;Time last char was receivedUSERINT		EQUDS.B	2	;Interrupt instructions from user (app)OLDRR0		EQUDS.B	2DISHONESTY	EQUDS.B	2*		EQUORG	$E115A4*RCHGADR1		EQUDS.B	3	;BG printing recharge routine addressRCHGADR2		EQUDS.B	3	;Port2*** Buffering Queue Data Structure*  The firmware maintains four of these queues in buffer mode*		EQUORG	$E11DD8*QUEUE		EQUDS	*QBASE		EQUDS.W	1	;Queue buffer space begin		EQUDS.W	1	;Top part of buffer space beginQBLEN		EQUDS.W	1	;Length of buffer spaceQHEAD		EQUDS.W	1	;Pointer to first queue elementQTAIL		EQUDS.W	1	;Pointer to next available buff location*** Serial Interrupt Completion Vectors*		EQUORG	$E115C1*COMPVECT1		EQUDS.W	1		EQUDS.W	1COMPVECT2		EQUDS.W	1		EQUDS.W	1** Place to keep the ID tags for MM buffer allocation*BID		EQUDS.W	1	;Indexed off of port		EQUDS.W	1	;and for port2		ENDSECT** Size of buffer request each port*BUFSIZE		EQU	$1000** Default I/O Buffers*E1BUFFER1		EQU	$E11E00E1BUFFER2		EQU	$E11F00*** System bank $E1 usage**TOOLDISPATCH	EQU	$E10000SERVECT		EQU	$E10024	;Serial interrupt vectorHEARTBEAT		EQU	$E100DC	;Tick counter (30 hz)SERFLAG		EQU	$E10104	;Sys int handler serial interrupt flagCURSOR		EQU	$E10135	;Current cursor character *** TenSpeed MOD ***C1FLAG		EQU	$E10143-$C1	;System clobbered default flag** Battery RAM Buffer equates*BRAMBUFFER	EQU	$E102C0DEFPORT1		EQU	BRAMBUFFERDEFPORT2		EQU	DEFPORT1+12** System Default parameter indices*DEFTYPE		EQU	0	;Printer or modem portDEFLEN		EQU	1	;# chars to forced CRDEFDLF		EQU	2	;Absorb LFs after CRs (bool)DEFALF		EQU	3	;Send LFs after CRs   (bool)DEFECHO		EQU	4	;Echo chars to screen (bool)DEFBUFF		EQU	5	;Enab in/out buffering (bool)DEFBAUD		EQU	6	;Specify baud rateDEFDFORM		EQU	7	;Specify # of data & stop bitsDEFPARITY		EQU	8	;Specify even/odd/no parityDEFDCDHS		EQU	9	;Enab DCD handshake (bool)DEFDSRHS		EQU	10	;Enab DSR output handshake (bool)DEFXONHS		EQU	11	;Enab XON/XOFF handshake (bool)*** ZERO PAGE EQUATES*WNDLFT		EQU	$20	;left edge of text window WNDWDTH		EQU	$21	;width of text window WNDTOP		EQU	$22	;top of text window WNDBTM		EQU	$23	;bottom+1 of text window CH		EQU	$24	;cursor horizontal position CV		EQU	$25	;cursor vertical position BASL		EQU	$28	;CSWL		EQU	$36	;character output hook CSWH		EQU	$37KSWL		EQU	$38	;character input hook KSWH		EQU	$39**ZPAGE		EQU	$0**SETSLOTCXROM	EQU	$C006SETINTCXROM	EQU	$C007RDCXROM		EQU	$C015RD80VID		EQU	$C01FCYAREG		EQU	$C036	;The speed registerSTATEREG		EQU	$C068**COUT		EQU	$FFF894COUT1		EQU	$FFF897*DOFFSVK		EQU	$FFFB2BSTORCH		EQU	$FFCDE7SHOWCUR		EQU	$FFCEC9UPDATE		EQU	$FFCEFCSETHOOKS		EQU	$FFCF59*** Extended Interface related stuff*LASTCALL		EQU	$18	;SendQueue is currently highest # call*BADPCERR		EQU	1	;Param ct does not agree w/ call typeBADCALLERR	EQU	2	;Call out of range error*** AppleTalk hook addresses*ATSTAT		EQU	$E11026ATOUT		EQU	$E1102AATIN		EQU	$E1102EATBRP		EQU	$E11032***PASSIG		EQU	$01DEVSIG		EQU	$31SLOT		EQU	$C7ID		EQU	$0IERRORCODE	EQU	$FF*XQSETUP		EQU	$FF0000XQPASCAL		EQU	$FF0003*SERBASPATCH	EQU	$E1020CSERPASPATCH	EQU	$E10210SEREXTPATCH	EQU	$E10214*ASEXT		EQU	$E11000ASBAS		EQU	$E11004ASPAS		EQU	$E11008RAMDISPATCH	EQU	$E11014RAMFORBID		EQU	$E11018RAMPERMIT		EQU	$E1101CPRODOS		EQU	$E11022PROENTRY		EQU	$E11020*MBIT		EQU	$20XBIT		EQU	$10EXECADDR		EQU	$84*** Baud Rate Constant Table*BD19200		EQU	4BD9600		EQU	10BD7200		EQU	14BD4800		EQU	22BD3600		EQU	30BD2400		EQU	46BD1800		EQU	62BD1200		EQU	94BD600		EQU	190BD300		EQU	382BD150		EQU	766BD134		EQU	855BD109		EQU	1045BD75		EQU	1534BD50		EQU	2302