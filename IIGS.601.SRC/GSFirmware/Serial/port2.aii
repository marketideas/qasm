		TITLE	'C200 Space';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 11:23:7 PM*** Basic Init (PR#n) entry point*Begin_C2:		SEP	#%01000000	;Set V to indicate initial entry		BVS	entr2	;Always taken		NOP** Basic Input Entry Point*		SEC		;Input entry point		OPCODE	BCC	;BCC opcode** Basic Output Entry Point*		CLC		CLV		;V = 0 since not initial entry		BVC	entr2	;Always taken*		DC.B	$01	;pascal signature byte		DC.B	$31	;device signature		DC.B	P2INIT		DC.B	P2READ		DC.B	P2WRITE		DC.B	P2STATUS		DC.B	0	;Optional offsets follow		DC.B	EXTEND2	;Extended interface offset		DC.B	0	;Interrupt offset not used*EXTEND2		EQU	*		PHA		;Push space for STATEREG		PHA		; and for CYAREG		JSR	SetState2		PHP		SEI		XBA		LDA	#$C2		STA	mslot		XBA		JSL	>NewExtVec		ROL	a	;***10spd preserve carry		PLP		LSR	a	;***10spd preserve carry		BRA	RstState2**ENTR2		EQU	*		PHA		;Push space for STATEREG		PHA		; and for CYAREG		JSR	SetState2		PHX		;Save the reg		LDX	#$C2	;X = Cn		JSL	>NewBasVec	;Process the Basic call		PLX*RSTSTATE2		EQU	*		XBA		PLA		;Get back CYAREG		STA	|CYAREG		PLA		; and the STATEREG		STA	|STATEREG		XBA		PHP		;Keep carry in a safe place		SEC		XCE		;Should clear C		PLP		;Get back carry		RTS		;And A is destroyed** These are the Pascal Entry Points.  We rely on the fact that the*  user is required to set Y to $N0 before the call.*P2INIT		INYP2READ		INYP2WRITE		INYP2STATUS		INY** Jack up the speed and get into native mode before jumping to bank $FF.*  Go off and do the stuff, and then return to go back to emulation mode*  and whatever speed was set at entry.*		PHA		;Push space for STATEREG		PHA		; and for CYAREG		JSR	SetState2		JSL	>NewPasVec		BRA	RstState2*** Set native and fast modes*SETSTATE2		EQU	*		PHP		CLC		XCE*		PHA		LDA	|CYAREG		STA	5,s	;Store in reserved space		ORA	#%10000000		STA	|CYAREG		LDA	|STATEREG		STA	6,s	;Store in reserved space		AND	#%10001111		STA	|STATEREG		LDA	#0		STA	>ApTalkFlag+$C2		PLA*		PLP		SEP	#%00110000	;Ensure M,X <- 1		RTS**		DC.B	'MSA'*	; SEG	$FF**INITSERIALPB:** This routine is here for space reasons only.* Put SCC into action with new settings.  Reenable interrupts if*  buffering is enabled.*		PHX		JSR	InitSerial		PLX*		LDA	|sermode2,x		BIT	#BfrngMask		BEQ	inspb1*		JSR	EnableInt*INSPB1		EQU	*		RTS**	; SEG	$00**;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 11:23:20 PM		LONGI	OFF		LONGA	OFF*HEREC2_01		EQU	*-Begin_C2+$C200		DCB.B	$C296-HereC2_01,0		C2XXSEG		EQU	*		JSL	>ramforbid		RTS		JSL	>rampermit		RTS*C2XX		EQU	*		XCE		PEI	execaddr+1		PLB		PLBC2XXGO		EQU	*		JML	[execaddr]C2XXRET		EQU	*		CLC		XCE		RTL*C2ERROR		EQU	*		LDX	#ierrorcode		RTLC2PRODOS		EQU	*		CLC		XCE		JSL	>prodos		PHP		SEC		XCE		PLP		BVC	noerr2		LDA	proentry+1		PHA		LDA	proentry		PHANOERR2		EQU	*		RTS*HEREC2_02		EQU	*-Begin_C2+$C200		DCB.B	$C2D8-HEREC2_02,0*QSETVECTOR2	EQU	*		JMP	>xqsetupQPASVECTOR2	EQU	*		JMP	>xqpascal*HEREC2_03		EQU	*-Begin_C2+$C200	IF HEREC2_03 < $C2E0 THEN		DCB.B	$C2E0-HEREC2_03,0	ENDIF*BOOTSPACE2	EQU	*		LONGI	ON		LONGA	ON		CLC		XCE		REP	#mbit+xbit		LDX	#$1100		LDY	#$00E1		LDA	#$0600		STA	$E11100		JMP	>ramdispatch*HEREC2_04		EQU	*-Begin_C2+$C200		DCB.B	$C2F9-HEREC2_04,0				DC.B	0,0,0,0	;ATLK used to be here		DC.B	ID**		LONGI	OFF		LONGA	OFF