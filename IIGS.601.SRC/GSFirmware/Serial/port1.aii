		TITLE	'C100 Space';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 11:17:21 PM*** Basic Init (PR#n) entry point*Begin_C1:		SEP	#%01000000	;Set V to indicate initial entry		BVS	entr1	;Always taken		NOP** Basic Input Entry Point*		SEC		;Input entry point		OPCODE	BCC	;BCC opcode** Basic Output Entry Point*		CLC		CLV		;V = 0 since not initial entry		BVC	entr1	;Always taken*		DC.B	$01	;pascal signature byte		DC.B	$31	;device signature		DC.B	P1INIT		DC.B	P1READ		DC.B	P1WRITE		DC.B	P1STATUS		DC.B	0	;Optional offsets follow		DC.B	EXTEND	;Extended interface offset		DC.B	0	;Interrupt offset not used*EXTEND		EQU	*		PHA		;Push space for STATEREG		PHA		;...and space for CYAREG		JSR	SetState1		PHP		SEI		XBA		LDA	#$C1		STA	mslot		XBA		JSL	>NewExtVec		ROL	a	;***10spd preserve carry		PLP		LSR	a	;***10spd preserve carry		BRA	RstState1**ENTR1		EQU	*		PHA		;Push space for STATEREG		PHA		;Push space for CYAREG		JSR	SetState1		PHX		;Save the reg		LDX	#$C1	;X = Cn		JSL	>NewBasVec	;Process the Basic call		PLX*RSTSTATE1		EQU	*		XBA		PLA		;Get back CYAREG		STA	|CYAREG		PLA		; and the STATEREG		STA	|STATEREG		XBA		PHP		;Keep carry in a safe place		SEC		XCE		;Should clear C		PLP		;Get back carry		RTS** These are the Pascal Entry Points.  We rely on the fact that the*  user is required to set Y to $N0 before the call.*P1INIT		INYP1READ		INYP1WRITE		INYP1STATUS		INY** Jack up the speed and get into native mode before jumping to bank $FF.*  Go off and do the stuff, and then return to go back to emulation mode*  and whatever speed was set at entry.*		PHA		;Push space for STATEREG		PHA		;...and space for CYAREG		JSR	SetState1		JSL	>NewPasVec		BRA	RstState1*** Set native and fast modes*SETSTATE1		EQU	*		PHP		CLC		XCE*		PHA		LDA	|CYAREG		STA	5,s	;Store in reserved space		ORA	#%10000000		STA	|CYAREG		LDA	|STATEREG		STA	6,s	;Store in reserved space		AND	#%10001111		STA	|STATEREG		LDA	#0		STA	>ApTalkFlag+$C1		PLA*		PLP		SEP	#%00110000	;Ensure M,X <- 1		RTS**		DC.B	'MSA'**	; SEG	$FF** (This routine belongs in IO but didn't fit there.)******************************************* GETSTAT - Gets the status from a acia* inputs: X = Cn* outputs: A = status, X = Cn, Y = devno*****************************************GETSTAT:		LDA	>ffdevlbl-$C1,x	;Get index into hardware		TAY*		LDA	>ApTalkFlag,x		BPL	gstnoat		JSL	>ATStat		RTS*GSTNOAT		EQU	*		LDA	SCCCmd,y		RTS**	; SEG	$00**;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 11:22:10 PM		LONGI	OFF		LONGA	OFFHEREC1_01		EQU	*-Begin_C1+$C100		DCB.B	$C196-HEREC1_01,0		C1XXSEG		EQU	*		JSL	>ramforbid		RTS		JSL	>rampermit		RTS*C1XX		EQU	*		XCE		PEI	execaddr+1		PLB		PLBC1XXGO		EQU	*		JML	[execaddr]C1XXRET		EQU	*		CLC		XCE		RTL*C1ERROR		EQU	*		LDX	#ierrorcode		RTLC1PRODOS		EQU	*		CLC		XCE		JSL	>prodos		PHP		SEC		XCE		PLP		BVC	noerr1		LDA	proentry+1		PHA		LDA	proentry		PHANOERR1		EQU	*		RTS*HEREC1_02		EQU	*-Begin_C1+$C100		DCB.B	$C1D8-HEREC1_02,0*QSETVECTOR1	EQU	*		JMP	>xqsetupQPASVECTOR1	EQU	*		JMP	>xqpascal*HEREC1_03		EQU	*-Begin_C1+$C100	IF HEREC1_03 < $C1E0 THEN		DCB.B	$C1E0-HEREC1_03,0	ENDIF*BOOTSPACE1	EQU	*		LONGI	ON		LONGA	ON		CLC		XCE		REP	#mbit+xbit		LDX	#$1100		LDY	#$00E1		LDA	#$0600		STA	$E11100		JMP	>ramdispatch*HEREC1_04		EQU	*-Begin_C1+$C100		DCB.B	$C1F9-HEREC1_04,0				DC.B	0,0,0,0	;Used to be 'ATLK'		DC.B	ID**		LONGI	OFF		LONGA	OFF