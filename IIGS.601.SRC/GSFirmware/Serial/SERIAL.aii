		PRINT	NODATA,NOGEN	; 		MACHINE	M65816		TITLE	'Apple IIgs Serial Firmware';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 10:54:39 PM;             SSSSS  EEEEEEE RRRRRR   III    A    L    ;            S     S E       R     R   I    A A   L;            S       E       R     R   I   A   A  L;             SSSSS  EEEEE   RRRRRR    I  AAAAAAA L;                  S E       R  R      I  A     A L;            S     S E       R   R     I  A     A L*             SSSSS  EEEEEEE R     R  III A     A LLLLL***          Modified from the //c code by Michael Askins**              Copyright Apple Computer, Inc., 1986*                      All Rights Reserved*VERSION		EQU	$1020**		TITLE	'Firmware History'******************************************************************                                                               **  Modification History:                                        **                                                               ** Rel  Date       Who  Action                                   ** ------------------------------------------------------------- **                      Buffering is not implemented             ** ***  17 Feb 86  MSA  *** Release Alpha 1.00 ***               **      26 Feb 86  MSA  Clean up screen hole usage               **                      Implement buffering                      **                      Fixed XON/XOFF                           **                      Make default wait 'til Tx underrun       **      28 Feb 86  MSA  Incorporate default flag for $CN00 users **                      Clean up BASIC tabbing and CR stuffing   **      06 Mar 86  MSA  Regularize the printer port              **                      Add command disable bit                  **                      Chg buffering hs thresholds to 25 %      **                      Make Pascal status call work w/ buffrng  **                      All interrupts check if it's time to Tx  **                      The zero count interrupt installed       **                      Rx interrupts record heartbeat value     **                      Asking for buffering forces a 'CLI'      **      07 Mar 86  MSA  Made buffering turn on with BE/D         **                      Default now clears sermode3              **                      Buffered handshaking made to work        **                      Moved SCC file forward to make room      ** ***  10 Mar 86  MSA  *** Release Alpha 2.00 ***               **      10 Mar 86  MSA  Extended xface fixed to preserve DBR     **                      Fix XON/XOFF in inthandler and serout    **      12 Mar 86  MSA  Added hardware control calls             **                      Reclaimed extra $CN00 area from Ctl Pnl  **      24 Mar 86  MSA  Added input error checking and reporting **                      Added large buffer allocation            **                      Added interrupt notification             **                      Fix heartbeat subtraction                **      25 Mar 86  MSA  Serint now alters the statereg to        **                       assure that the screenholes are acc-    **                       cessible.  The statereg is preserved.   ** ***  26 Mar 86  MSA  *** RELEASE BETA 1.00 ***                **      01 Apr 86  MSA  Add EE/D, fix BE/D, D cmds in BASIC xfc  **                      Monitor equates corrected                **      04 Apr 86  MSA  AppleTalk hooks installed                **      11 Apr 86  MSA  CN00 spaces now stack CYAREG & STATEREG  **      18 Apr 86  MSA  Fix Basic formatting in BASICIO          **                      Add Basic formatting bit                 **                      Awaiting XON is checked on Pascal Status **      23 Apr 86  MSA  Add AppleTalk BRP call, support ATDeq    **                      Fix DCD option induced handshake bug     **                      Store CX in MSlot in PascalIO            ** ***  23 Apr 86  MSA  *** Release BETA 2.00 ***                **      07 May 86  MSA  Clear column counter on inits            **                      Change IntInfo call                      **                      Fix bugs in interrupt handler            **                      Fixed Basic tabbing (hopefully for good) **                                                               ******************************************************************		EJECT******************************************************************                                                               **  Modification History (continued):                            **                                                               ** Rel  Date       Who  Action                                   ** ------------------------------------------------------------- **      13 May 86  MSA  Moved AppleTalk bit                      **                      Added the A (basic tabbing) command      **                      Moved version number to CNFE,CNFF        ** ***  14 May 86  MSA  *** RELEASE BETA 3.0 ***  (V1.00)        **      19 May 86  MSA  Store of screen loc jst prior to setcur  **      20 May 86  MSA  Fix Basic BD command                     **                      Fix Basic 0B command                     **      27 May 86  MSA  Add buffer deallocation to 'R' command   ** ***  28 May 86  MSA  *** Release 1.00 ***                     **      07 Oct 86  MSA  Fixed the branch in BUFALLOC which       **                       caused a stack screwup in the unlikely  *   *                       event that the Disposhandle call in     * *                       the buffer deallocation routine fails.  **      01 Nov 86  FAB  Fixed Serout3 so that an explicit check  **                       for Zap mode is made and if Zap is on,  **                       LF stuffing is defeated.                **      08 Jan 87  MSA  Fix Status call so that a char does not  **                       appear ready if erroneous               **                      Fix GetData so that error checking is    **                       done before the grabbing of a char to   **                       allow for the lack of error latching of **                       the SCC... the error clear command is   **                       no longer issued.                       **                      Add bit to allow errant data through     ** *** 09-Jan-87  MSA   *** Release Rev 01 Alpha ***             **     13-Jan-87  MSA   Rev the status call to correctly work    **                       with XON/XOFF                           **                      Change colon to equals in XRDSER to fix  **                       data loss while awaiting XON char       ** *** 23-Jan-87  MSA   *** Release Rev 01 Alpha 2 ***           **     28-Jan-87  MSA   Swap pwdth and flags screenholes so old  **                       apps which try to jam pwdth will work.  **                       Revved (bastardized) ModeBits routine   * *                       to accommodate the swap.                **     29-Jan-87  MSA   Change BASICIO so that if asoft tabbing  **                       is on and 80 cols is active OURCH is    **                       updated in addition to CH.  Fixes       **                       erratic operation in 80 col mode.       **     05-Feb-87  MSA   Change InitSerial call in command so     **                       that it includes a call to EnableInt.   **                       Fixes bug with parity, baud and         **                       dataformat settings disabling buffering ** *** 06-Feb-87  MSA   *** Release 01 Beta 1 ***                **     13-Feb-87  MSA   Undo change to Zap mode since programs   **                       broke.  Zap once again does not defeat  **                       linefeed stuffing. (See 11/1/86 entry)  ** *** 20-Feb-87  MSA   *** Release 01 Beta 2 ***                **     24-Feb-87  MSA   Preserve MSlot across Recharge routine   *  * *** 27-Feb-87  MSA   *** Release 02 Beta 3 ***                * *                                                               *********************************************************************		INCLUDE '::Firmware.macros.aii'*** Pass this guy a bank number and he'll preserve the current value*  on the stack before setting it the way you want.  A, X, and Y are un-*  disturbed.  Thank you, Fern.*		MACRO		SETDBR	&NewDBRVal		PHB		PEA	&NewDBRVal		PLB		PLB		ENDM*		INCLUDE	'equates.aii'*		LONGA	OFF		LONGI	OFF		SEG	'C1SEG'C1XX_SERIAL	PROC	ORG $FFC100		IMPORT	NEWEXTVEC		IMPORT	NEWBASVEC		IMPORT	NEWPASVEC		IMPORT	FFDEVLBL		ENTRY	GETSTAT		INCLUDE	'port1.aii'		DC.W	VERSION		ENDP*		LONGA	OFF		LONGI	OFF		SEG	'C2SEG'C2XX_SERIAL	PROC	ORG $FFC200		IMPORT	NEWEXTVEC		IMPORT	NEWBASVEC		IMPORT	NEWPASVEC		IMPORT	ENABLEINT		IMPORT	INITSERIAL		ENTRY	INITSERIALPB		INCLUDE	'port2.aii'		DC.W	VERSION		ENDP*		LONGA	OFF		LONGI	OFF		SEG	'SERIAL'Bnk~Org		EQU	$0000SERIAL_DRVR	PROC	ORG $FF0000		ENTRY	NEWEXTVEC		ENTRY	NEWBASVEC		ENTRY	NEWPASVEC		ENTRY	FFDEVLBL		ENTRY	INITSERIAL		ENTRY	ENABLEINT		IMPORT	GETSTAT		IMPORT	INITSERIALPBRel~Org:** Jump table*QSETUP		JMP	BasicQPASCAL		JMP	PascalQEXTDISPATCH	JMP	ExtDispatchQATDEQ		JMP	ATDeQ*		INCLUDE	'serialdrvr.aii'**		FillTo	$1000		ENDP				END