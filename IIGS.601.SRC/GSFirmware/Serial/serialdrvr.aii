		TITLE	'Basic Support';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 11:36:32 PM**BASIC		EQU	*		PHY		PHA		STX	|mslot		JSR	SetBasicMode** Maintain the defaults flag.  This is trashed whenever anyone resets*  the system or when a user changes a port characteristic in the *  control panel.  We reset it whenever a non-C100 entry is made to us*  to guarantee that subsequent C100s will do a default.*		LDA	>C1Flag,x		PHP		;V is C100, Z is reset flag*		LDA	#$FF		BVS	msup	;Take if we came through CN00		INC	aMSUP		EQU	*		STA	>C1Flag,x	;If CN00, store $FF; $00 otherwise** Now decide whether to initialize (default) the port.  Only do so if*  we came through $CN00 and the CFlag was = $00.*		PLP		;Get back V,Z		BVC	sudone	;Skip if CN05 or CN07 entry		BNE	sunodef	;Skip if CFlag was non zero*SUDODEF		JSR	default	;Set up defaults ** If either hook is partially present, make sure the low part is correct*SUNODEF		EQU	*		CPX	cswh		BNE	fromin	;Maybe it's an IN#...		LDA	#7		CMP	cswl	;Is low part already set?		BEQ	fromin	;If so, no need to set it		STA	cswlFROMOUT		EQU	*		CLC		;We fixed the hook so it		BRA	sudone	;Must have been a PR#FROMIN		EQU	*		CPX	kswh	;Is the input hook half there?		BNE	fromout	;Wasn't an IN#...assume PR#		LDA	#5	;Fill in the other half of hook		STA	kswl*SUDONE		EQU	*		BCS	commport	;If input, branch		JMP	serport*COMMPORT		EQU	*		PLA		;Get the char		BIT	|RD80VID		BMI	omg		LDY	ch		STA	(basl),y	;Store what was beneath the cursor*OMG		EQU	*		XBA		;On hold for a momentito		LDA	|RDCXROM		PHA		STA	|SETINTCXROM		XBA		;Get back the character*		BRA	term1	;Input NOESC		BIT	|sermode,x	;In terminal mode?		BVC	exit1	;If not, return key		JSR	serout2	;Out it goes		BRA	term1TESTKBD		EQU	*		PLA		;Get current char		JSR	|UPDATE	;Update cursor & check keyboard		BPL	serin	;N=0 if no new key		JSR	command	;Test for command		BCS	noesc	;Branch if not		AND	#$5f	;upshift for following tests		CMP	#'Q'	;Quit?		BEQ	exitX		CMP	#'R'	;Reset?		BNE	term1	;Go check serial EXITX		LDA	#$98	;return a CTRL-XEXIT1		PLY*		BMI	exit2		STA	|SETSLOTCXROMEXIT2		EQU	*		PLY		RTL*GOREMOTE		CLC		;Into remote modeGOTERM		JSR	setterm	;Into terminal mode TERM1		EQU	*		JSR	|SHOWCUR	;Get current char on screenSERIN		PHASINOKBD		JSR	xrdser	;Is it ready?		BCS	sidata	;Branch if we got data		LDA	|flags,x	;Is keyboard enabled?		AND	#$10		BEQ	testkbd	;Branch if enabled		BRA	sinokbd	;Go test acia againSIDATA		TAY		;Save new input in y for now 		PLA		PHY		;Save new char on stack		JSR	|STORCH	;Fix the screen		PLA		;Get the new data		LDY	|eschar,x	;If 0, don't modify char		BEQ	sinomod		ORA	#$80	;Apple loves the high bit		CMP	#xon		BEQ	term1	;Ignore ^Q		CMP	#$FF	;Ignore FFs		BEQ	term1		CMP	#$92	;^R for remote?		BEQ	goremote		CMP	#$94	;^T for terminal mode?		BEQ	gotermSINOMOD		BIT	|sermode,x	;In terminal mode?		BVC	exit1	;Return to user if not A = char 		JSR	|COUT	;Onto the screen with it		BRA	term1** Come back here if this is a printer port** Integer and older versions of Applesoft Basic did tabbing by jamming*  CH to the column position where they wished to be.  This works fine*  with video but presents a problem for us.  To convince Basic not to*  to issue a carriage return after 40 or 80 columns when printing, the*  serial firmware jams CH to zero.  We then take the responsibility for*  watching our own column counter, and when we detect that we are near*  our line length, we set CH to a value which Basic will interpret as*  being near the end of the line; then Basic will do its end of line*  chores.**  Tabbing in this environment starts by looking at CH.  If CH is zero *  then there's no tabbing.  If CH is 8 or 16, then we assume that it*  is Integer or Applesoft Basic attempting to do a tab, and we update*  CH to the next tab stop (just as Basic would have if we weren't*  confusing it by setting CH to zero every time).  If CH is a value*  other than 8 or 16 we assume that this is an absolute position*  that someone wishes to tab to, and we keep outputting spaces until*  our column counter = CH.**  CAVEAT:  When Applesoft was revved to work better with 80 column*  video, the tabbing code (both comma tabs and explicit TAB()s) was*  altered so that CH was no longer jammed- instead Applesoft tries*  to figure out the number of spaces to output itself to move to the*  desired location.  Much cleaner, yes, but it bases its space*  calculation on CH, the location that the printer firmware jams to*  zero every character!  Ooops.  Basic never knows where it really*  is and as a result, every comma results in exactly 16 spaces*  regardless of tab position, and every TAB(n) just gives you n*  spaces.  The Super Serial Card has a command 'TE' which defeats*  the CH zero jam, and using this command makes new Applesoft tabbing*  work okay (the //c can't be helped since it does not have this*  command).  The Cortland has this command and it must be issued*  to make Applesoft tabbing work correctly. (The Cortland command*  is 'A E/D' which stands for Applesoft.)**  Amen.*SERPORT		EQU	*		LDA	|flags,x		ASL	A	;A = flags 		PLY		;Get char		PHY** If we are in Zap mode, we want to avoid tabbing, or carriage return*  stuffing, and have exactly what goes in come out and no more.*		LDA	|sermode3,x		BIT	#CSDMask		BNE	prnow** PWIDTH set to zero means 'unlimited line length'.  Therefore any*  comparison to the current column position must special case PWDTH=0.*  In this case, we simulate CH-PWDTH < 0.*		LDA	|pwdth,x		PHP		;Save Z		LDA	ch		PLP		;Pull back Z and C*		BCS	servid	;Branch if video echo 		BEQ	chok		CMP	|pwdth,x	;If CH >= PWIDTH, then CH = COL		BCC	chok		LDA	|col,x*CHOK		CMP	|col,x	;Must be >  for valid tab		BCS	fixch	;Branch if ok*		CMP	#8	;Is it Integer Basic trying to tab?		BEQ	chok1	;Yup, line up to a tab stop		CMP	#16	;Is it Applesoft trying to tab?		BNE	prnt	;Nope, no 'CH stuff' style basic tabbing** Now set CH to the next highest tab stop for Applesoft & Integer Basic*CHOK1		EQU	*		ORA	#$F0	;Create $F0 or $F8 to find tab stop		AND	|col,x	;Find previous tab stop  		CLC		ADC	ch	;Add the tab increment FIXCH		STA	ch	;Save the new position		BRA	prnt*SERVID		CMP	wndwdth	;If ch>= wndwdth go back to start of line		BLT	prnt		STZ	ch	;Go back to left edge ** Do CR stuffing if this was asked for.* There are two conditions under which we do not generate CRs.  One*  is the case where the line width is zero, the other is the case when*  the CR stuff bit is clear.  Check for both cases.*PRNT		EQU	*		LDA	|sermode2,x		BIT	#crstuffmask		BEQ	prnt2	;Skip out if bit off*		LDA	|pwdth,x		BEQ	prnt2	;2nd condition*		LDA	|col,x		CMP	|pwdth,x		BLT	prnt2	;If col<pwdth forget it...*		LDA	#$1A	;CR*2		CPY	#$80	;Set carry if hi bit of chartoprnt=1		ROR	a	;Shift into out CR		JSR	goser3	;Print without echoing** See if we need to do any tabbing.  If CH is bigger than our column*  counter, then someone changed CH, and we compensate by printing*  blanks until their CH is equal to our COL.*PRNT2		EQU	*		PLY		PHY		LDA	|col,x		CMP	ch		BGE	prnow	;If COL>=CH no tabbing required*		LDA	#$40	;Blank*2		CPY	#$80	;Set C to high bit of char to print		ROR	a		JSR	goser3	;Output without echoing		BRA	prnt	;See if that fixed it*PRNOW		TYA		JSR	serout	;Print the actual char*		BIT	|flags,x	;In video all this is done for us		BMI	done*		LDA	|pwdth,x	;Unlimited line length?		BEQ	setch	;Yes- never fool Basic into endoflining** In order to have BASIC tabbing to work correctly, window should* be set to the same length as the column width used for printing.* This must be done from the BASIC program and cannot be done in this* rom space.*		SEC		LDA	|col,x	;Check if within 8 chars of right edge		SBC	|pwdth,x	;So BASIC can format output 		CMP	#$F8		BCC	setch	;If not within 8, we're done		CLC		ADC	wndwdth		BRA	kl1	;Skip the load** Normally, we always jam CH to zero to make printing with*  large line lengths work.  Unfortunately it screws up Applesoft*  tabbing, so if the tabbing bit is set, we set CH not to zero but*  to our real column count.  Then Applesoft tabs wonderfully, and*  output is limited to 40 or 80 columns depending on the video mode.*SETCH		EQU	*		LDA	|sermode3,x		AND	#BTabMask		BEQ	kl1		LDA	|col,xKL1		EQU	*		STA	ch** If 80 cols is active, BASIC depends on OURCH ($57B) to be updated*  to do tabbing right (instead of CH ($24) ).  Slam it if RD80VID*  is active.*		BIT	|RD80VID		BPL	done		STA	|OURCH*DONE		EQU	*		PLA		;Restore regs		PLYSERRTS		RTL**		TITLE	'Pascal Support'**PASCAL		EQU	*** On entry, Y has nx, where x=4 (Init), 3 (Read), 2 (Write),*  or 1 (Status), and n is the slot (1 or 2).  Make sure that*  Y has x stripped off on return, and use x to determine which*  routine we should vector to.*		JSR	SetPascalMode		STX	|MSlot	;Save away the port index		XBA		;Keep A		TYA		;Get nx		PHA		;Keep nx around		AND	#%11110000	;Discard the x part		TAY		;This will get returned later		PLA		;Pull back cx		AND	#%00000111	;Discard the c part		PHY		;Keep to return to caller		XBA		;Get back the original A reg		PHA		;Push that, too		XBA		;Get back the call type*		DEC	a		BNE	notstatus** This is the status routine.  When buffering is not on, a check is*  made by calling HardCheck if it is an Tx inquiry, or GetStat*  if it is an Rx inquiry.  If buffering is on, check the queues.*		PLA		;Get the inquiry type (0 or 1)		PHA		;Return to the user		LSR	a	;C has 0 (Tx) or 1 (Rx)		BNE	perr	;Illegal status code** Find out if we're buffering or not*		LDA	|sermode2,x		BIT	#BfrngMask		BEQ	ps0** We're buffering.  If read inquiry, check length; if write, space left.*		PHB		BCS	psb1	;Make rcv buffer check		SEC		;Tx buffer check		JSR	QSpace		BRA	psb2*PSB1		EQU	*		CLC		;Rcv inquiry		JSR	QLengthPSB2		EQU	*		SEP	#%00110000		SEC		BNE	psb3		CLCPSB3		EQU	*		PLB		;Return DBR to 0		BRA	pread2** Non buffered case*PS0		EQU	*		BCS	pstat1	;This is a Rx inquiry** Return with the carry clear (not ready) if we're awaiting XON*		LDA	|flags,x		BIT	#WaitXMask		BNE	pread2	;If awaiting XON, we're not ready*		JSR	HardCheck	;Check output status		BRA	pread2	;Carry is set if char availPSTAT1		EQU	*** If the one byte buffer is full, there is a character available*		BIT	#ChrBufMask	;Sermode2 already in accumulator		BNE	pread2	;Carry already set		JSR	GetStat	;Check Rx buffer*		LSR	a	;Move Rx char ready to carry		BCC	pread2	;If no char, don't check for error** Check if the character had an error, or if we're doing XON/XOFF*  whether the next character is XON or XOFF... etc.    *		JSR	Potpourri	;Carry set means a char is available		BRA	pread2*NOTSTATUS		EQU	*		DEC	a		BNE	notwrite** This is the Write routine*		PLA		PHA		;Got back original char		JSR	serout		BRA	pread2*NOTWRITE		EQU	*		DEC	a		BNE	notread** This is the Read routine. Wait until we have a character from SCC.*		PLA		;Make room for return of charPWAIT		EQU	*		JSR	xrdser		BCC	pwait		PHAPREAD2		EQU	*		PLA		PLY		LDX	#0		RTL*NOTREAD		EQU	*** It must be the Init routine.  Make sure that we turn off the*  generation of line feeds since Pascal throws them out there.*  Also turn off basic formatting (tabbing).*		JSR	default		LDA	|flags,x		AND	#GenLFMask--$FF		STA	|flags,x		BRA	pread2*PERR		EQU	*		LDX	#$40		PLA		PLY		CLC		RTL**		TITLE	'Serial Output Routines'SEROUT		EQU	*	;Serial output** See if this character is part of a command string*		JSR	command	;Check if command		BCC	serdone	;All done if it is** See if echo is on... don't echo XON character*SEROUT2		EQU	*		BIT	|flags,x	;N=1 iff video on		BPL	goser3		CMP	#xon	;Don't echo ^Q		BEQ	goser3*		LDY	|RDCXROM		PHY		STA	|SETINTCXROM		JSR	|COUT1	;Echo it 		PLY		BMI	goser3		STA	|SETSLOTCXROM*GOSER3		EQU	*	;Go to serout3** Check if buffering is enabled*		TAY		LDA	|sermode2,x		BIT	#BfrngMask		PHP		TYA		;Get back the char		PLP		BEQ	serout3** Handle the buffering case...* If the queue is empty, and we are in "flow" mode, and if the *  transmit buffer is empty, we want to send it out NOW.*		PHP		SEI		;Don't risk reentrancy problems		PHA		;Push the character into saveland		PHB		;DBR is currently =$00*		SEC		JSR	QLength	;Get the length of the output queue		SEP	#%00110000		BNE	mser3	;If Q has chars, q this'un too*		PLB		;Get back DBR=$00		LDA	|sermode2,x		BIT	#OutFloMask	;Are we flowing chars?		BNE	mser2	;Nope, just queue the thing*		LDA	|flags,x	;See if awaiting XOFF		BIT	#WaitXMask		BNE	mser2	;If so, just queue it*		LDA	>FFDEVLBL-$C1,x	;Get the hardware index		TAY		LDA	SCCCmd,y		BIT	#%00000100	;Is transmit buffer available?		BEQ	mser2	;If not, just queue it** Send out this character*		PLA		;What was it again?		PLP		;Restore interrupt state		BRA	nocheck	;Send char and CR check stuff*SERDONE		EQU	*		RTS*MSER3		EQU	*		PLB		;Get back DBR=$00MSER2		EQU	*		PLA		;Get back the character** Keep trying to queue the character until there's room.*  Don't open any interrupt window until after the first try,*  since an interrupt might happen before we get the character into*  the queue, and if the queue was empty we would never get another*  interrupt.*MSER		EQU	*		SEC		;Want to throw in out pile		JSR	EnQueue		BCC	mser4		PLP		;Maybe reenable interrupts		PHP		;Everything in its place...		BRA	mserMSER4		EQU	*		PLP		;Straighten up stack (int state)		PHA		;Keep stack access balanced** Increment the column counter (this code is duplicated in serout3...)*		BIT	#%01100000		BEQ	mser5		INC	|col,xMSER5		EQU	*		BRA	crcheck	;Do crstuffing...*		EJECT****************************************** SEROUT3 - Outputs a character to the SCC*            Use the nocheck entry point*             to avoid the handshake check** Inputs: A = char, X = Cn*****************************************SEROUT3		EQU	*		PHA		;Save the charSORDY		EQU	*** Wait until the hardware we are watching is ready (TxRDY,DSR,DCD)*		JSR	HardCheck		BCC	sordy*		PLA*NOCHECK		EQU	*		PHA		;Save away character** If this is a control character we don't want to inc the column counter* 		BIT	#%01100000	;Control char?		BEQ	sonxt	;Don't inc column if so		INC	|col,x** Check to see if buffering is on*SONXT		EQU	*		LDA	|sermode2,x	;Is port interrupt driven?		BIT	#BfrngMask		BNE	sook	;If buffering, XON/XOFF dealt with** If AppleTalk, don't stop for XON/XOFF*		LDA	>ApTalkFlag,x		BMI	sook** If we're not buffering, see if we're doing XON/XOFF*		LDA	|flags,x		BIT	#XMask		BEQ	sook	;Branch if not** See if there's a receive character (it might be XON...)*		JSR	xrdnobuf	;Get a char from the acia		BCC	sotst	;Branch if no char** We've got to keep this character around. Save in one char buffer.*		JSR	FlagOBB	;A has the character** Are we in the middle of XOFF?  Back to looping if so.*SOTST		LDA	|flags,x	;Check if in xoff		AND	#WaitXMask		BNE	sordy	;Loop if not ready** Everything is totally wonderful. Kiss it goodbye and send it out*  into the cold, serial (cereal?) world.*SOOK		EQU	*		LDA	>FFDEVLBL-$C1,x		TAY** Gotta decide if it goes to AppleTalk or the SCC directly. Call the*  AppleTalk OUT routine if appropriate.  *		LDA	>ApTalkFlag,x		ROL	a	;AppleTalk mode in C		PLA		PHA		;Get char to XMIT		BCC	regler	;If AT bit was clear, go right to SCC		JSL	>ATOut	;Send to AppleTalk land		BRA	crcheck*REGLER		EQU	*		STA	SCCData,y	;Out it goes** Now if that guy was a CR, we may want to send a LF to keep him/her*  company.  Check whether LFs are supposed to be generated after CR.*CRCHECK		EQU	*		BIT	|flags,x	;V=1 if LF after CR		EOR	#$0D	;check for CR. 		ASL	A	;preserve bit 7 		BNE	sodone	;branch if not CR. 		BVC	clrcol	;branch if no LF after CR *skp 2*bit :sermode3,X ;test for ZAP mode*bmi clrcol ;if ZAP mode then NO!!!! line feeds.*skp 2		LDA	#$14	;Get LF*2		ROR	A	;no shift in high bit ** Send out the LF, clear the cursor position and the column counter,*  wrap things up and have a nice day.*		JSR	goser3	;Output the LF but don't echo it CLRCOL		STZ	ch	;0 position & column		STZ	|col,xSODONE		PLA		;Get the char back		RTS*		EJECT*********************************************** HardCheck       Check handshake lines**  This gets the current status, and* returns carry set if all conditions* handshaked on are asserted (DCD,DSR).* Tx ready is always checked.* The outflow bit is NOT changed due to the* Tx ready line.***********************************************HARDCHECK		EQU	*** Get the status, and flip the sense of all bits in question.*		JSR	getstat		CLC		;Anticipate not ready		EOR	#%00101100** Check if we're supposed to handshake on DSR*		XBA		;Keep the status in a safe place		LDA	|flags,x		BIT	#DSRHSMask		BEQ	hc1	;Don't check this line...** This line must be asserted*		XBA		;Get back status byte		BIT	#%00100000		BNE	HCNoGo	;DSR LINE was lo... forget it		XBA		;Stuff back the status byte** Now see if we're to handshake on the DCD line*HC1		EQU	*		LDA	|sermode2,x		BIT	#DCDHSMask		BEQ	hc2	;Don't look... it's okay** Get back the status of the lines and check for DCD*		XBA		BIT	#%00001000		BNE	HCNoGo	;DCD was lo... forget it		XBA		;Hide the status again*HC2		EQU	*		XBA		;Pull out the SCC status		BIT	#%00000100		BNE	HCBye	;Exit if buffer unavailable*HCOKAY		EQU	*		SEC		;It's all wonderful... go for itHCNOGO		EQU	*** Set the OutFloMask appropriately*		LDA	|sermode2,x		AND	#OutFloMask--$FF		BCS	hcout		ORA	#OutFloMaskHCOUT		EQU	*		STA	|sermode2,xHCBYE		EQU	*		RTS**		TITLE	'Serial Input Routines'******************************************   This is the serial input routine.  Carry * flag set indicates that returned data is * valid.*****************************************XRDSER		EQU	*** If buffering is on, get the character from the buffer*		LDA	|sermode2,x		BIT	#BfrngMask		BEQ	xnosbuf	;No serial buffering** Keep trying to get a character from the buffer until you get one.*BUFSORDY		EQU	*		CLC		JSR	DeQueue		BCC	xrddone	;Exit with cc on underflow		BVC	xrddone** We have a "soft" underflow (less than 1/4 of the buffer to go).*  Force ourselves into "in flow" mode.*		PHA		LDA	>FFDEVLBL-$C1,x		TAY		;Get SCC index		CLC		JSR	ChgHS	;Carry was already cleared		PLAXRNOCHR		EQU	*		SEC		BRA	xrddone*XNOSBUF		LDA	|sermode2,x	;Is there a char in the one byte buffer?		BIT	#ChrBufMask		BEQ	xrdnobuf	;Branch if not		AND	#ChrBufMask--$FF	;Clear the bit		STA	|sermode2,x		LDA	>OneByteBuf,x		SEC		BRA	xrddone*XRDNOBUF		JSR	getstat	;Get ACIA status		AND	#$01	;Is there Rx data?		CLC		;indicate no data		BEQ	xrddone	;Branch if no data!		JSR	getdata	;Get data and check xon, etcXRDDONE		EQU	*		RTS*FFCHARPTR		EQU	*-$C1	;Pointer to character buffers		DC.B	$0,$80		EJECT****************************************** GETDATA - Gets data from serial port* and checks for LF, XON, XOFF* inputs: Y = index to SCC, X = Port index* outputs: A = data, Y dest, C = 1 if data ok = 0 if eaten*****************************************GETDATA		EQU	*** If the AppleTalk bit is on, get the data from AppleTalk...*		LDA	>ApTalkFlag,x		BPL	gd1*		JSL	>ATIn		BRA	gdne1*GD1		EQU	*** Check if this character has a framing or parity error*		JSR	CheckError		BCC	gdrts	;If carry clear, the char was errantGDNE		EQU	*		LDA	SCCData,y	;Get the non-errant characterGDNE1		EQU	*** Check for linefeeds and XON,XOFF*		PHA		ORA	#$80	;Set D7 for compares		TAY		LDA	|flags,x	;Get options byte		BIT	#MaskLFMask	;Eat linefeeds?		BNE	gdnolf		CPY	#lfeed	;Is it a LF?		BEQ	gdeat	;Eat it if it isGDNOLF		BIT	#XMask	;Xon/XOFF enabled?		BEQ	gdok		CPY	#xon	;Is it an XON?		BNE	gdnxon		AND	#WaitXMask--$FF	;Clear xoff bit		BRA	gdeat	;And eat itGDNXON		CPY	#xoff		BNE	gdok		ORA	#WaitXMask	;Set xoff bitGDEAT		CLC		OPCODE	BCS	;$90 opcodeGDOK		SEC		STA	|flags,x		PLAGDRTS		EQU	*		RTS**CHECKERROR	EQU	*** See if the next char had an error.  If there was an error, and*  the error mode bit is clear, eat the char and return carry clear.*  Otherwise return carry set.*		SEC		;Default no error condition		LDA	|sermode3,x	;Check the error flag		AND	#EMask		BNE	ceout	;If mode bit set, no char has errors*		LDA	#1		JSR	ReadSCC		AND	#%01010000	;Check for parity or framing error		BEQ	ceout	;If no errors, return carry set*		ORA	|sermode3,x	;Save scoop on this errant data		STA	|sermode3,x		LDA	SCCData,y	;Throw away errant byte		CLC		;Flag what we didCEOUT		EQU	*		RTS**		TITLE	'Command processor for serial & comm ports'*CHARCR		EQU	$0DUCSPACE		EQU	$00	;need an "upper case" space character*COMMAND		EQU	*** Check to see if we're in the middle of a command.  Skip out if so.*		PHA		;shove character on stack		BIT	|sermode,x	;Already in command?		BMI	incmd	;If so, go do it** Get the escape character that we currently recognize and see if*  the current char matches.  If the escape char is null, no commands*  are allowed.  If this isn't a command char, return with carry set.*		LDY	|sermode3,x	;If msb = 1 ignore commands		BMI	nocmd		EOR	|eschar,x	;Is it the command char?		ASL	A	;Ignore high bit		BNE	nocmd	;char not command char** Save away the current cursor character and make it ours '?'*		LDA	>cursor		STA	>oldcur		LDA	#cmdcur	;Set command char		STA	>cursor		JMP	cominit1	;initiate command mode** The following code wraps it up with the Carry Set indicating*  that the character was not interpreted as part of a command.*NOCMD		SEC		;Mark char not handledNOCMD2		PLA		;Restore original char		RTS** We're somewhere in the middle of a command.  Upshift the char.*INCMD		EQU	*	;Command mode		XBA		LDA	>FFDEVLBL-$C1,x		TAY		XBA		AND	#$5F	;High bit doesn't matter, upshift lower case ** See if we're in the middle of a 2 character command.*		PHA		;save character		LDA	|sermode,x	;need to see if in 2-chr command		BIT	#$08	;bit 3 set if so		BNE	incmd2	;branch if so		PLA		;pull char back, not in 2-chr cmd		BRA	incmd1	;go on with regular command mode** Handle the 2nd chr of a 2 chr cmd.  Ignore spaces in 2 char commands.*INCMD2		EQU	*		PLA		;pull char off stack		PHA		; & reshove it to keep stack neat		CMP	#ucspace	;is it a space? (uppercased)		BNE	incmd3	;no, go on with 2-chr cmd handling		CLC		;yes, ignore spaces between chrs of 2-chr cmds		PLA		;pull uppercased char off stack		BRA	nocmd2	;ie mark them "handled" & don't do anything else** Get out the index for which command we're in, then clear it out*INCMD3		LDA	|sermode,x	;get sermode back		PHA		;save sermode for a minit		AND	#7	;throw out all but bits 0-2		STA	|temp,x	;save - this is index of which cmd it is		PLA		;get sermode back		AND	#$F0	;now clear bits 0-3		STA	|sermode,x	;since we're done with them now** Look for an E (enable) or D (disable) and branch appropriately*		PLA		;get character back		PHX		;shove x (Cn) on stack		PHA		LDA	|temp,x	;Get index to command's 1st char		TAX		PLA		CMP	#$45	;is it an E?		BNE	nenable	;yes		JMP	enable	;Couldn't quite reachNENABLE		EQU	*		CMP	#$44	;no, is it a D?		BEQ	disable	;yes** Check if it was really a one char command followed by another command*		PLX		;retrieve X=Cn (old X still hanging around in temp)		PHX		;push it back to keep stack neat		CMP	|eschar,x	;compare to the command character		PHP		;save result of comparison for a bit		PHA		LDA	|temp,x	;Get back command index		TAX		PLA		PLP		;retrieve result of comparison of char to cmd char		BEQ	flagit	;yes tis 1-chr cmd followd by nother cmd** Maybe this char is a carriage return. Then it was really a 1 chr cmd*		CMP	#charCR	;is it a (guess what) CR?		BEQ	oneletter	;yes - a 1-chr command** This is an unimplemented but legal 2-chr command.*  Restore the cursor and clear the 'in-the-middle-of-a-command' bit.*CMD2NULL		EQU	*		PLX		;pull x (Cn) off stack		LDA	>oldcur	;restore non-cmd-mode cursor		STA	>cursor		ASL	|sermode,x	;clear cmd-mode bit (bit 7 of sermode)		LSR	|sermode,x	;by shifting out bit 7 & shifting in a 0		BRA	nocmd	;return marking character not handled** Here we have gotten an an escape char after L, X, F, M, or T.*  This means that we should do the pending command and remain in*  in command mode for the next yet to be received command.*FLAGIT		EQU	*		PLX		;need X=Cn to set bit 0 of sermode		PHX		;but leave Cn on stack too		INC	|sermode,x	;bit 0 was 0, now's 1 - means new cmd mode		LDA	|temp,x	;Reload X index to cmds 1st chr		TAX*ONELETTER		EQU	*	;come here if 2-chr cmd turns out 1 chr		LDA	>cmd2list,x	;get command chr		BRA	backto1	;treat it as if we just got it***INCMD1		EQU	*	;in command mode, not 2-chrs tho		PHX		;Save slot		LDX	#7	;check 8 possible 2-chr cmdsCMD2LOOP		CMP	>cmd2list,x	;is it there?		BEQ	cmd2found	;yes, need to flag it for next time		DEX		;nope		BPL	cmd2loop	;try next if there is one** Check for one character commands*BACKTO1		EQU	*		LDX	#12	;Check 13 commandsCMDLOOP		CMP	>cmdlist,x		BNE	noreach	;Right char?		JMP	cmdfoundNOREACH		EQU	*		DEX		BPL	cmdloop** We haven't found it in the one char table.  If it is a control char*  then we will make it our new escape character.*		PLX		;We didn't find it		PLA		PHA		AND	#$7F	;if char is cntl char 		CMP	#$20	;it can be the new comd char 		BCS	ckdig	;branch if not cntl character CMDZ2		STA	|eschar,x	;Save comd char, drop thru ckdig to cdone ** Maybe it's a number... if so shift the number buffer by 10 and add*  the new digit.*CKDIG		EOR	#$30	;zap it down to 0n if char was a digit		CMP	#$0A	;if not a digit, it is unexpected intruder		BGE	cdone	;If not, branch		LDY	#10	;A = A + 10 * current numberDIGLOOP		ADC	>number	;C=0 on first entry		DEY		BNE	digloop** Now remember that we have seen a number this command.*		PHA		LDA	#nflagmask		ORA	|sermode2,x		STA	|sermode2,x		PLA** The acc now has the new number value.  Branch to save it...*		BRA	cominit	;not starting new cmd mode, just save #** This handles LE and LD... make them look like L and K respectively.*CMD2L		EQU	*	;come here to handle LE & LD		LDA	#$4C	;make LE look like L		PLP		;get P back with carry indicating E or D		BCS	backto1	;carry set means it was an E		LDA	#$4B	;make LD look like K		BRA	backto1** These guys turn on or off one of the mode flags per E/D.*ENABLE		EQU	*	;got a 2-chr command aE		SEC		;set carry		OPCODE	BCC	;bcc to skip next byte (the CLC)DISABLE		EQU	*	;got a 2-chr command aD		CLC		;clear carry		PHP		;push P to save carry		CPX	#0	;if X=0 then command is LE or LD		BEQ	cmd2l	;so just make it act like L or K		CPX	#7		BNE	di3		JMP	cmd_a	;Process the A commandDI3		EQU	*		CPX	#6	;if X=6 then command is CE or CD		BEQ	cmd_c		CPX	#5	;if X=5 then command is BE or BD		BEQ	cmd_b		JMP	xr1	;Deal with the rest** Look at sermode[0] to see if we should set or clear command mode.*CDONE		EQU	*		LDA	|sermode,x	;so get it		LSR	A	;shift bit 0 to carry		BCS	cominit1	;if set, start new cmd mode** Put the cursor back the way we found it*		LDA	>oldcur	;Restore the cursor		STA	>cursor	;& fall through to cmset with carry clear** Set the command mode per the carry*CMSET		PHP		ASL	|sermode,x	;set command mode according to carry 		PLP** Clear the carry (indicating the char was handled), get the char back,*  and return.*		ROR	|sermode,x	;leaves carry clear 		PLA		;character handled 		RTS		;because carry clear... **CMD2FOUND		EQU	*		CMP	#'B'	;This char can be two char cmd		BNE	c2fcont** In the case of encountering the 'B' command, if there was a*  number preceding the 'B', then it's the one character baud rate*  change command.  Otherwise it is likely to be the two character*  buffering enable/disable command.*		TXA		PLX		PHX		PHA		;Save the index		LDA	|sermode2,x		PLX		BIT	#nflagmask		BNE	cmdfound	;It's BAUD: X is 5 already*C2FCONT		EQU	*		TXA		;copy index of cmd to acc		PLX		;restore X to Cn		ORA	|sermode,x	;copy top 2 bits of sermode		ORA	#$08	;& set bit 3 - 2-chr-command-mode flag		STA	|sermode,x	;sermode now holds index to 2-chr command issued		SEC		;set carry so we stay in command mode		BRA	cmset	;for next time**CMDFOUND		EQU	*		LDA	#>cmdcr	;get hi byte of where to go		PHA		;save it on stack		LDA	>cmdtable,x	;get lo byte of where to go		PHA		;save it on stack		RTS		;go there by RTSing** Init command mode by setting sermode, clearing number and exit*COMINIT1		EQU	*	;start new cmd mode here		LDA	|sermode,x	;get sermode		AND	#$C0	;clear bits 0-5 (starting a new cmd seq --		STA	|sermode,x	;they are used for misc during cmd mode)		LDA	|sermode2,x	;Clear out the 'seen a number' bit		AND	#nflagmask--$FF		STA	|sermode2,x		LDA	#0	;load a 0 to stuff in NUMBERCOMINIT		STA	>number		SEC		;Mark in command mode		BRA	cmset** This is the CE/D service*CMD_C		PLP		;restore status to check carry bit		PLX		LDA	#crstuffmask--$FF		AND	|sermode2,x		BCC	cmd_c1		ORA	#crstuffmaskCMD_C1		EQU	*		STA	|sermode2,xCDONE3		JMP	cdone	;we're done here************************************************** for other 2-chr cmds, their FLAGS masks' indexes are 2X+3      * for an E or 2X+4 for a D    ************************************************XR1		EQU	*		TXA		;copy x to acc for arithmetic		CLC		;clear carry for arithmetic		ASL	A	;multiply index by 2		ADC	#3	;add 3 to get mask index		TAX		;put mask index in X		PLP		;get carry back		BCS	xready	;carry set = Enable so X is ready		INX		;cmd was Disable so inc X to next maskXREADY		JMP	cmdi	;go do mask stuff to FLAGS** We have gotten a BE/D command.*CMD_B		EQU	*		PLP		;Get back enable/disable request		PLX		;Get back $CN*		PHP		;Disable int until they're dead		SEI*		LDA	>FFDEVLBL-$C1,x	;Get hardware index		TAY*		LDA	|sermode2,x		AND	#BfrngMask--$FF*		BCC	smc*		ORA	#BfrngMask	;Flip on the buffering bitSMC		EQU	*		STA	|sermode2,x	;Gotta set it before enabling ints*		JSR	IntKill	;Disable and clear pending SCC interrupts		PLP		;Restore interrupt state		BCC	q	;If it was BD, skip the turn on*		PHX		JSR	ResetQs		JSR	EnableInt		PLX*Q		EQU	*		JMP	cdone2*** Make sure the command service routines are in the same page*HEREC_1		EQU	*-Rel~Org+Bnk~Org	IF HEREC_1 < $0518 THEN		DCB.B	$0518-HEREC_1,0	;Keep routines in a single page	ENDIF*CMDZ		PLX		;Zero escape character		STZ	|pwdth,x	;And the width		LDA	#CSDMask		ORA	|sermode3,x		STA	|sermode3,x		BRA	cdone2**CMDCR		EQU	*CMDN		EQU	*		PLY		LDA	>number	;Get number inputted		BEQ	cmdi2	;skip if 0		STA	|pwdth,y	;Update printer width		DC.B	$F0	;BEQ opcode to skip next byte (the PLY)CMDI		EQU	*CMDK		EQU	*CMDL		EQU	*		PLYCMDI2		LDA	|flags,y		AND	>mask1,x	;Mask off bit we'll change		ORA	>mask2,x	;Change it		STA	|flags,y	;Back it goes		TYX		;Put slot back in xCDONE2		JMP	cdone	;Good bye** Process the parity command.*CMDP		EQU	*		LDA	>number	;0,2-no parity, 1-odd, 3-even		TYX		EOR	>WR4,x	;Fold A[1..0] into current value		AND	#%00000011	;Only keep low bits of ACCUPD4		EQU	*		EOR	>WR4,x		STA	>WR4,xISPHITCH		EQU	*		PLX		PHX		;Get X back for InitSerial		JSR	InitSerialPB	;Init Port and maybe reenable bfrngHITCH		EQU	*		PLX		;Get back $CN		BRA	cdone2** Process a Data format change command.*CMDD		EQU	*		LDA	>number		PHA** Do the Receive data bits*		AND	#%00000011	;Use only the low bits		EOR	#%00000011	;Reverse the table for BASIC command		TAX		LDA	>DBitMap,x		TYX		EOR	>WR3,x		AND	#%11000000	;Keep everything else the same		EOR	>WR3,x		STA	>WR3,x** Do the Transmit # data bits*		LSR	a		EOR	>WR5,x		AND	#%01100000	;Everything else is the same		EOR	>WR5,x		STA	>WR5,x*		PLA		;Get Number back		ASL	a	;Move up to where SCC wants it		TYX		;Move the index		EOR	>WR4,x	;Fold the new bit into the current value		AND	#%00001000	;Only keep one bit of ACC*		BRA	upd4** Process the Baud Rate command.*CMDB		EQU	*		LDA	>number		BNE	lmc	;Y has the hardware index		JSR	FigBaud	;Get the default Baud rateLMC		EQU	*		JSR	StoreBaud		BRA	ISPHitch*** Send a 233 ms break character taking into account how fast the*  CPU is currently running.*CMDS		EQU	*** Break is not supported in AppleTalk mode*		PLX		PHX		LDA	>ApTalkFlag,x		BMI	whee*		TYX		LDA	>WR5,x	;Get the current register value		PHA		;Save it		ORA	#$10	;Turn on the break bit		LDX	#5	;Start the break		JSR	WriteSCC*		CLC		;Start carry in known state		LDX	#247	;Now delay about 233 millisecondsBK2		LDA	#243BK1		DEC	a	;Loop here 243 times		BNE	bk1		ROR	a	;Complement the carry...		EOR	#$80		ROL	a		BCS	bk2	;Do the inner loop twice		DEX		;This is the outer loop		BNE	bk2		PLA		;Get old value back*		LDX	#5		JSR	WriteSCCWHEE		EQU	*		PLX		JMP	cdone2*CMDQ		CLC		;Quit terminal mode		DC.B	$B0	;BCS to skip next byteCMDT		SEC		;Into terminal mode		PLX		;Recover X		JSR	setterm		JMP	cdone*CMDR		EQU	*		PLX		PHX** Since we'll make a call to sethooks and doffsvk, we gotta*  make sure that the all the $CX00 rom space is banked in.*  We also must restore it when we're done.*		LDA	|RDCXROM		PHA		STA	|SETINTCXROM*		LDA	|sermode3,x		AND	#BasicMask		BEQ	cmdrgds*		CLC		;Make sure terminal mode is off		JSR	setterm*		LDA	|RD80VID	;Check if video firmware active		ASL	A	;Save it in C		JSR	|SETHOOKS	;assume video firmware active 		BCS	cmdrgds	;branch if good guesser... 		JSR	|DOFFSVK	;Reset the hooks		LDA	#$FF	;Slam old cursor with checkerboard		STA	>oldcur	;So that code at CDONE works okay** Now if buffering's on, turn it off and deallocate the buffer*  First set back the slot rom the way it was*CMDRGDS		EQU	*		PLA		BMI	cmg2		STA	|SETSLOTCXROMCMG2		EQU	*		PLX		PHX		LDA	|sermode2,x		AND	#bfrngmask		BEQ	whee		JSR	IntKill		PLX		PHX		JSR	ReleaseBuf		BRA	whee	;Pull X and back to the grind*		EJECTSETTERM		EQU	*	;set/clear terminal mode** Here the carry is set if we're initiating terminal mode.*		LDA	|sermode,x	;Get terminal mode status		BIT	#$40	;Z=1 if not in terminal mode		BCC	stclr	;Branch if clearing terminal mode		BNE	stwasok	;Was already set** If we're not in the input hooks, don't go to terminal mode*		CPX	kswh	;Are we in the input hooks		BNE	strts	;Leaves C=1 if = ** Flip on the terminal mode bit*		ORA	#$40	;Set term mode bit** Preserve the normal cursor and shove terminal mode cursor*		PHA		LDA	>oldcur	;Save what was in oldcur		STA	>oldcur2		PLA		LDY	#termcur	;Get new cursor value		BRA	stset** Clear terminal mode and restore the old cursor*STCLR		BEQ	stwasok	;Branch if already clear		AND	#$BF	;Clear the bit		PHA		LDA	>oldcur2	;Restore the cursor		TAY		PLASTSET		STA	|sermode,x		TYA		;Gotta do long addressing...		STA	>oldcur	;Save cursor to be restored after command		STA	>cursorSTWASOK		EQU	*** The //c firmware turned on receiver interrupts here.*STRTS		RTS**CMD_A		EQU	*		PLP		PLX		LDA	#BTabMask--$FF		AND	|sermode3,x		BCC	cmd_a1		ORA	#BTabMaskCMD_A1		EQU	*		STA	|sermode3,x		JMP	cdone**		MSB	OFFCMDTABLE		EQU	*	;command routines' lo bytes		DC.B	CMDI-1		DC.B	CMDK-1		DC.B	CMDL-1		DC.B	CMDN-1		DC.B	CMDCR-1		DC.B	CMDB-1		DC.B	CMDD-1		DC.B	CMDP-1		DC.B	CMDQ-1		DC.B	CMDR-1		DC.B	CMDS-1		DC.B	CMDT-1		DC.B	CMDZ-1** Flag byte* masks for:     I   K   L   N   CR  XE  XD  FE  FD  ME  MD  EE  EDMASK1		DC.B	$7F,$BF,$BF,$7F,$FF,$DF,$DF,$EF,$EF,$F7,$F7,$7F,$7FMASK2		DC.B	$80,$00,$40,$00,$00,$20,$00,$00,$10,$00,$08,$80,$00*CMDLIST		EQU	*		DC.B	'IKLN'		DC.B	$0D	;cr (part of cmdlist)		DC.B	'BDPQRSTZ'CMD2LIST		EQU	*		DC.B	'LXFMEBCA'	;2-chr commands' first chrs**FFDEVLBL:		DC.B	$3C,$3B**** Buffer allocation routine*  If no error, carry is clear and buffer address is in A (lo), X (hi)*   Otherwise, carry is set.*		LONGA	ON		LONGI	ON** Must have X set to $CN on entry!*GETBIGBUF		EQU	*		PHX		;Keep port index		PEA	|0	;Push the space for result		PEA	|$8000	;Tag field*		LDX	#$20*256+3	;Get ID tag		JSL	>ToolDispatch	; from misc tools		PLA		;Get the ID		PLX		;And get back the index		PHP		;save the carry		CPX	#$C1	;Tags are two bytes		BEQ	gbb1		INXGBB1		EQU	*		STA	>BID-$C1,x	;Store it away		PLP		;Get back GetID results		BCS	nevermind*		LDX	#0		PHX		;Push space for long result		PHX		PHX		;Hi part of size request		PEA	|bufsize	;Push size request low		PHA		;Push Owner ID we just got		PEA	|$4008	;Attributes: fixed, no spcl mem		PHX		;Location info		PHX		; top part		LDX	#9*256+2	;NewHandle		JSL	>ToolDispatch	;Call the memory manager		PLX		;Pull low part		PLA		;Pull hi part		BCS	nevermind** Dereference the handle and get the buffer address*		PHB		;Save current DBR		XBA		;Swap so bank is pulled last		PHA		;Push bank then $00		PLB		;Pull the $00		PLB		;DBR now set for handle*		LDA	|0,x	;Get low part		PHA		LDA	|2,x	;Get hi part		TAX		PLA		PLB*NEVERMIND		EQU	*		RTS***  This routine releases the buffer secured with the above call.*   It is called when the Reset command is set through the output flow.**RELEASEBUF	EQU	*		SETDBR	$E1E1** Point at the input part of this channel's buffer*		CLC		JSR	SetQueue*		REP	#%00110000	;		PHX		;Keep around a 16 bit X** Do the call to FindHandle since we did not keep around the original*		LDA	#0		PHA		PHA		;Space for result		LDA	QBase+2,y	;Push hi		PHA		LDA	QBase,y	;Push low		PHA		LDX	#$1A*256+2	;FindHandle		JSL	>ToolDispatch		LDA	1,s	;If result = 0, then it's NON MM memory		ORA	3,s	;		SEC		BEQ	rb3	;Can't release what we don't got** Now attempt the disposal. The handle is already on the stack.*		LDX	#$10*256+2		JSL	>ToolDispatch	;DisposHandle*bcs rb1 ;If this failed, skip out		BCS	rb3	;*** Bug Fix 10/7/86 ***** Get back the port index and get back the buffer ID to release it.*		PLX		PHX		CPX	#$C1		BEQ	rb2		INX		;Widen the index for the 2nd portRB2		EQU	*		LDA	>BID-$C1,x		PHA		LDX	#$21*256+3		JSL	>ToolDispatch	;DeleteID		BRA	rb1*RB3		EQU	*		PLX		;Pull off garbage (zeros)		PLA*RB1		EQU	*		PLX		;Pull off the index		SEP	#%00110000	;Back to 8 bit land		BCS	rberror1	;If error, don't clear buffer flag		STZ	|firsttime-$C1,xRBERROR1		EQU	*		PLB		;Back to original bank		RTS**		LONGA	OFF		LONGI	OFF*** Auxilliary routine that wouldn't fit anywhere else...*  Sets a bit which keeps track if you are calling the BASIC or PASCAL*  entry point.*SETBASICMODE	EQU	*		PHP		SEC		BRA	sm2SETPASCALMODE	EQU	*		PHP		CLCSM2		EQU	*		PHA		;Preserve A		LDA	|sermode3,x		AND	#BasicMask--$FF		BCC	sm1		ORA	#BasicMaskSM1		EQU	*		STA	|sermode3,x		PLA		PLP		RTS**		TITLE	'Extended Serial Interface'*EXTDISPATCH	EQU	*** Preserve three locations in zero page and use these to get to the*  call command code and parameter count.*		PHB		XBA		LDA	zpage		PHA		LDA	zpage+1		PHA		LDA	zpage+2		PHA		XBA*		STA	zpage		STX	zpage+1		STY	zpage+2** Check for a legal command code*		LDY	#1		LDA	[zpage],y		CMP	#lastcall+1		BGE	badcall** Check for a valid parameter count... the calls are paired.*		LSR	a		TAX		LDA	>paramct,x		LDY	#0		EOR	[zpage],y		BNE	badpcount** Load up the address-1 to vector to.*		LDA	>callpage,x		PHA		LDA	>calltable,x		PHA** Load up the index registers: X has $C1 or $C2, Y has $3C or $3B.*		LDX	|mslot		LDA	>FFDEVLBL-$C1,x		TAY		RTS**BADPCOUNT		EQU	*		LDA	#BadPCErr		BRA	ErrExit**MODEBITS		EQU	*** I used to have a beautiful, elegant little routine here that*  was thirteen bytes smaller than this 'shotgun' routine, which*  I had to rip out because of the juggling of the screenholes*  which happened because some old applications broke the rules.*  (Management said we had to support them anyway.)  You will*  never be able to experience the simplicity, the ambiance, and*  general hootspa of the original routine, and Mr. L will never*  appreciate the sacrifice.*		LDY	#4*		LDA	|flags,x		BCC	mb1		LDA	[zpage],yMB1		EQU	*		STA	|flags,x		STA	[zpage],y		INY*		LDA	|sermode2,x		BCC	mb2		LDA	[zpage],yMB2		EQU	*		STA	|sermode2,x		STA	[zpage],y		INY*		LDA	|sermode3,x		BCC	mb3		LDA	[zpage],yMB3		EQU	*		STA	|sermode3,x		STA	[zpage],y		INY*		LDA	|sermode,x		BCC	mb4		LDA	[zpage],yMB4		EQU	*		STA	|sermode,x		STA	[zpage],y*OKEXIT		EQU	*		CLC		LDA	#0		BRA	ee1*BADCALL		EQU	*		LDA	#BadCallErr*ERREXIT		EQU	*		SEC*EE1		EQU	*		LDY	#2		STA	[zpage],y		XBA		;10spd acc preserve		INY		LDA	#0		STA	[zpage],y*		PLA		STA	zpage+2		PLA		STA	zpage+1		PLA		STA	zpage		PLB		XBA		;10spd acc preserve		RTL**PARAMCT		EQU	*		DC.B	3,0,0,3,4,3,3,0		DC.B	4,4,2,4,4,0,0,0		DC.B	3,3,3,3,4,0*CALLTABLE		EQU	*		DC.B	MODEBITS-1,BADCALL-1,BADCALL-1,PORT-1		DC.B	SCC-1,DTR-1,INTERRUPT-1,BADCALL-1		DC.B	GETBUFFER-1,SETBUFFER-1,FLUSHQUEUE-1,QUEUESTATUS-1		DC.B	BGPRINT-1*CALLPAGE		EQU	*		DC.B	(MODEBITS-1)>>8,(BADCALL-1)>>8		DC.B	(BADCALL-1)>>8,(PORT-1)>>8		DC.B	(SCC-1)>>8,(DTR-1)>>8		DC.B	(INTERRUPT-1)>>8,(BADCALL-1)>>8		DC.B	(GETBUFFER-1)>>8,(SETBUFFER-1)>>8		DC.B	(FLUSHQUEUE-1)>>8,(QUEUESTATUS-1)>>8		DC.B	(BGPRINT-1)>>8*		EJECT**SETBUFFER		EQU	*** A flush must occur here to reset the head and tail pointers*		JSR	Flush	;Does a SetQueue		SEP	#%01000000	;V set means 'set'		BRA	gb1GETBUFFER		EQU	*		CLV		;V clear means 'get'		JSR	SetQueue** Want to copy over 4+2 bytes of buffer info.*GB1		EQU	*		TYX		LDY	#4GB2		EQU	*		LDA	>queue,x		BVC	gb3		LDA	[zpage],yGB3		EQU	*		STA	>queue,x		STA	[zpage],y		INX		INY		CPY	#10		BLT	gb2		JMP	OKExit**FLUSH		EQU	*** Use X and C to point Y to the queue in question*		JSR	SetQueue** Zero out the head and tail pointers of the queue*		PHX		TYX		REP	#%00100000	;Into 16 bit M		LONGA	ON		LDA	#0		STA	>QHead,x		STA	>QTail,x		SEP	#%00100000	;Into 8 bit M		LONGA	OFF		PLX		RTS**FLUSHQUEUE	EQU	*		JSR	Flush		JMP	OKExit**		LONGA	ON		LONGI	ON*QUEUESTATUS	EQU	*		BCS	outq	;C set means OutQueueStatus		JSR	QLength		BRA	qs1OUTQ		EQU	*		JSR	QSpaceQS1		EQU	*		LDY	#4		STA	[zpage],y** Now give 'em the # of heartbeats since the last char was queued.*  We just assume that the heartbeat counter has been turned on.*		INY		INY		LDA	>HeartBeat		CPX	#$C2		BLT	qs2		INX		;If port 2, stretch a bitQS2		EQU	*		SEC		SBC	>SaveHeartBeat,x		STA	[zpage],y		SEP	#%00110000		JMP	OKExit*		LONGA	OFF		LONGI	OFF**INTERRUPT		EQU	*		PHY		PHX		PHP*		LDY	#8		LDA	#3		CPX	#$C1		BEQ	inta		LDA	#7*INTA		EQU	*		TAXINTB		EQU	*		PLP		PHP		LDA	[zpage],y		BCS	intc		LDA	>CompVect1,xINTC		EQU	*		STA	[zpage],y		STA	>CompVect1,x		DEX		DEY*		CPY	#6		BPL	intb** Put in a JML opcode in case it's not there*		LDA	#$5C		STA	>CompVect1,x*		PLP		PLX		BCS	setint	;Set up the interrupt byte*		PLY		LDA	>Dishonesty,x		JMP	Spit8bits*SETINT		EQU	*		LDY	#4		LDA	[zpage],y		STA	>UserInt,x		AND	#%11101010		PLY		PHA		LDA	#15		TAX		;For the future write		JSR	ReadSCC		ORA	1,s		PLB		JMP	dtr2***		TITLE	'Serial Interrupt Handler'**********************************************************************                                                                  ** Serpint                       SCC Serial Interrupt Handler       **                                                                  **   This routine gains control when the system interrupt dispatch  **  decides that an interrupt which was refused by Appletalk came   **  from the SCC. We first decide which port it's from and return   **  with the carry set if the interrupt status byte is 0, or if our **  buffering mode is not enabled.  Then we look to see if it's an  **  EXSTAT, Tx, or Rx interrupt.  The latter two types are pro-     **  cessed and a character is queued (or dequeued), the interrupt   **  is cleared, the routine is restarted (almost) to guarantee that **  interrupts from multiple sources are appropriately handled. If  **  Each time an interrupt is serviced, the RR0 byte is XORed with  **  the previous value to detect any changes.  When all interrupts  **  have been cleared, the changes are ANDed with a mask from the   **  user, and if any bits are still set, the completion vector is   **  called so that the application is informed of the interrupt.    **                                                                  **    Output:    C <- Cleared if the interrupt was not handled,     **                        set otherwise.                            **                                                                  **********************************************************************SERPINT		EQU	*** Preserve the state register... system don't do it for me*  The DBR is set to $E1 but hardware appears there, too.*		LDA	|StateReg		PHA		AND	#%10001111	;Main memory to access screenholes		STA	|StateReg** DBR is set to $E1 when it gets to me...*		STZ	|Dishonesty+$C1		STZ	|Dishonesty+$C2*		SETDBR	$0000** Determine the channel which has the interrupt*NEXTINT		EQU	*		LDX	#$C1		LDA	>FFDEVLBL-$C1,x		TAY		LDA	#3		JSR	ReadSCC		AND	>serflag	;Only ints were supposed to support		CMP	#%00001000	;Are any of 3..5 set?		BGE	allset1	;If so, it's port 1		INX		DEY		CMP	#0		BNE	allset	;Looks like it's port 2** Get our story straight.  If any of the bits in the dishonesty bytes*  are set, he asked us to pass control to him.  Call the completion*  routine in this case.*LASTWORD		EQU	*		LDA	>Dishonesty+$C1	;Reason to call completion routine		BEQ	si2		JSL	>CompVect1SI2		EQU	*		LDA	>Dishonesty+$C2	;Reason to call other comp routine		BEQ	si3		JSL	>CompVect2SI3		EQU	*		CLCLW1		EQU	*		PLB		;Put $E1 back into DBR		PLA		STA	|StateReg	;Bank reg=$E1- that's okay		RTL** It's a channel B interrupt.  Move the channel B interrupt*  status bits down to where channel A's would be*ALLSET1		EQU	*		LSR	a		LSR	a		LSR	a** If buffering isn't on, we don't handle anything*ALLSET		EQU	*		XBA		LDA	|sermode2,x		BIT	#BfrngMask		SEC		;Anticipate no buffering case		BEQ	lw1** Maintain the 'dishonesty' flag. Use XOR to isolate differences*  in RR0 between now and last time.  Mask and store away.*		LDA	SCCCmd,y	;Get RR0		PHA		;Keep for later		EOR	>OldRR0,x	;Resulting bitset means it changed		AND	>UserInt,x	;Remember only those they asked for		ORA	>Dishonesty,x	;Add to others		STA	>Dishonesty,x	;Keep		PLA		;Back current RR0		AND	#%11111010	;Force off rcv and xmit ready...		STA	>OldRR0,x** Check to see if it is an External/Status interrupt*		XBA		;Get back the interrupt status		LSR	a	;Is it an Ext/Stat?		BCC	mabtx** It is an Ext/Stat interrupt...*  Don't need zero count interrupts at this point*		LDA	#15		JSR	ReadSCC		AND	#%11111101		PHX		LDX	#15		JSR	WriteSCC		PLX** Change the "no flow" bit if necessary.*		JSR	HardCheck	;Set the noflow bit appropriately** Now clear out the interrupt... currently ignore the fact that*  a user may have asked to deal with an interrupt from an external/*  status line that is not handshaked (with buffering on).*		LDA	#%00010000		STA	SCCCmd,y	;Just to speed things up a bit** See if we should start characters flowing out.*TXCHECK		EQU	*		LDA	|flags,x		BIT	#WaitXMask		BNE	nextint	;If still awaiting XON, never mind*		LDA	SCCCmd,y		BIT	#%00000100		BEQ	nihitch		BRA	cleartxint** Check to see whether it is a transmit interrupt*MABTX		EQU	*		LSR	a	;Move Tx bit to carry		BCC	itsrcv	;Gotta be a receive interrupt* * It's a transmit interrupt.  Clear it.*CLEARTXINT	EQU	*		LDA	#%00101000		STA	SCCCmd,y** If we're in "no flow", there's nothing we can do.  Continue*  what we can do... just swallow it (and our pride) and continue.*		LDA	|sermode2,x		BIT	#outflomask		BNE	nihitch** If we're doing XON/XOFF handshake and awaiting XOFF, bail out*		LDA	|flags,x		BIT	#WaitXMask		BNE	nihitch** We're flowing now... pull a char from the queue and shove it*		SEC		;Want to use this channel's outqueue		JSR	DeQueue	;Pull out the next character  		BCS	sendit	;If we got a character send it** If we underflow and we're backgroung printing, we are obliged to*  call the recharge routine.*		LDA	|sermode2,x		BIT	#BRPMask		BEQ	nihitch** Flush the queues, call the recharge routine, and store away the *  newly specified length.*		JSR	FPlusR		BNE	txcheck	;A virtual transmit interruptNIHITCH		EQU	*		JMP	nextintSENDIT		EQU	*		STA	SCCData,y		BRA	nihitch	;Back in case there is more** It's a receive interrupt*ITSRCV		EQU	*		PHY		JSR	GetData	;Get the data		PLY		BCC	readmore	;It was eaten... don't queue it** Put the byte into the receiver queue*		CLC		JSR	Enqueue	;Do it** If the buffer overflowed, there's nothing I can do.  Just clear*  the receiver interrupt and have a nice day.*		BCS	readmore	;Hard buffer overflow** Record the time of the enqueing of the character.*		PHX		CPX	#$C2		BLT	ir1		INXIR1		EQU	*		LDA	>heartbeat		STA	>SaveHeartBeat,x		LDA	>heartbeat+1		STA	>SaveHeartBeat+1,x		PLX** If the buffer is within 1/4 bufsize of overflowing, disassert*  the handshake, however he said.*		BVC	readmore	;There was no overflow		SEC		JSR	chghs	;Flip hs and inflow bit if nec** Is there another character to grab?  Grab if so*READMORE		EQU	*		LDA	SCCCmd,y		LSR	a		BCS	itsrcv		JMP	txcheck**		TITLE	'Interrupt Support'************************************************                                           ** EnableInt     Enable Buffering Interrupts **                                           **   This sets up Rx, Tx and possibly Exstat **  interrupts in the SCC for the port       **  specified in X so that buffering may     **  occur.                                   **                                           **   Input:    X <- $C1, $C2                 **   Output:   Y <- SCC index ($3C,$3B)      **   Destroys: A,X                           **   Assumes:  DBR <- $00                    **                                           ***********************************************ENABLEINT:** Do not do anything to the SCC if we're in AppleTalk mode*		LDA	>ApTalkFlag,x		BPL	ei11		RTS		;NevermindEI11		EQU	*** Get the SCC index*		LDA	>FFDEVLBL-$C1,x		TAY** Disable interrupts generally while fiddling (I hope Rome isn't burning)*		PHX		LDA	#%00000010		LDX	#9		JSR	WriteSCC		PLX** Now set the serial interrupt byte for the system interrupt handler*		LDA	>SERFLAG		CPX	#$C2		BLT	eia		ORA	#$07		BRA	eia1EIA		EQU	*		ORA	#$38EIA1		EQU	*		STA	>SERFLAG** Decide which Ex/Stat interrupts should be enabled*		LDA	|sermode2,x		BIT	#DCDHSMask		PHP		;Keep Z for a minute		LDA	|flags,x		AND	#DSRHSMask	;0 if no DSR handshake		BEQ	ei1		LDA	#%00100000	;DSR (CTS) interrupt enabledEI1		EQU	*		PLP		;Get back /DCDHS in Z		BEQ	ei2	;Z=1 => no DCD handshake		ORA	#%00001000** Now write out the Ex/Stat interrupt enables byte*EI2		EQU	*		ORA	#%00000010	;ZeroCount ints enforces an interrupt		LDX	#15		JSR	WriteSCC** Now set up for Rx, Tx, and Ex/Stat interrupts*		LDA	#%00010011		LDX	#1		JSR	WriteSCC** Disable interrupts while we set up the interrupt vector*		PHP		SEI		LDA	#$FF		STA	>SerVect+3		LDA	#>Serpint		STA	>SerVect+2		LDA	#<Serpint		STA	>SerVect+1		PLP** Now enable interrupts and enjoy your stay here in Serialand.*		CLI		LDA	#%00001010		LDX	#9		JMP	WriteSCC*		EJECT**********************************************                                           ** ChgHS       Assert/Disassert Rx Handshake **                                           **   Changes the DTR and/or sends XON/XOFF   **  characters to assert or disassert the    **  handshake.  Also sets the "in flow" flag **  to reflect the current handshake state.  **                                           **   Input:    X <- $C1, $C2                 **             C <- 1 means input flow halt  **             Y <- SCC index ($3C,$3B)      **   Destroys: A                             **   Presrvs:  X,Y                           **   Assumes:  DBR <- $00                    **                                           ***********************************************CHGHS		EQU	*** If we are flowing (inflow=0) and carry set: inflow=1,(DTR=1),(XOFF)*  If we aren't flowing and carry clear: inflow=0,(DTR=0),(XON)*  Otherwise don't do anything.*		LDA	#0		BCC	ch2		LDA	#InFloMaskCH2		EQU	*		EOR	|sermode2,x		AND	#InFloMask		BEQ	donothin** InFloMask is still in the acc.  Flip it and store*		EOR	|sermode2,x		STA	|sermode2,x** If we're doing hardware handshake, flip it.*		PHX		LDA	|flags,x		PHA		BIT	#DSRHSMask		BEQ	ch1*		TYX		LDA	>WR5,x		EOR	#%10000000		STA	>WR5,x		LDX	#5		JSR	WriteSCC** Now if we're doing XON/XOFF handshake, send either XON or XOFF.*CH1		EQU	*		PLA		BIT	#XMask		BEQ	ch5	;No XON/XOFF*		PHP		SEI		;Don't go to int handler...CH3		EQU	*		LDA	SCCCmd,y		BIT	#%00000100		BEQ	ch3	;Wait around til buffer empty*		LDA	#%00101000		STA	SCCCmd,y	;Clear the newly formed Tx int*		LDA	#NewXOff	;High bit cleared for TenSpeed		BCS	ch4		LDA	#NewXOn	;High bit cleared for TenSpeedCH4		EQU	*		STA	SCCData,y	;Shove it out		PLP		;Reenable interrupts*CH5		EQU	*		PLX		;Need $CN for laterDONOTHIN		EQU	*		RTS***RECHARGE		EQU	*** Calls the callers recharge routine to get more chars in the buffer*  Stored address is one bigger than the one that we want on the stack*  (from which we'll do an RTL to vector control).*		LDY	#2		CPX	#$C2		TYX		BLT	rch1		LDX	#5RCH1		EQU	*		CLCRCH2		EQU	*		LDA	>rchgadr1,x		SBC	#0		PHA		DEX		DEY		BPL	rch2** Unfortunately, they're now on the stack in the wrong order...*		PLX		PLY		PLA		PHX		PHY		PHA		RTL*** Flush the queues, call the recharge routine, and store away the *  newly specified length.*FPLUSR		EQU	*		PHY		PHX*		SEC		;Output queue		JSR	Flush		PLX		PHX		;Resave X** Call the recharge routine and save away the new data length*		PHY** Preserve MSlot across the recharge routine since the app may*  want to make a call to the regular serial code which slams mslot*  to $C1.*		LDA	>mslot		PHA		JSL	>Recharge		PLA		STA	>mslot*		TXA		PLX		STA	>QTail,x		TYA		STA	>QTail+1,x		ORA	>QTail,x*		XBA		PLX		PLY		XBA		;Set zero flag again		BNE	fpr1*		PHP		LDA	|sermode2,x		AND	#BRPMask--$FF		STA	|sermode2,x		PLP*FPR1		EQU	*		RTS*** This routine is called by AppleTalk to get a background character*  to print.*ATDEQ		EQU	*** Figure out what port he wants by looking at Appletalk bit port 1*		LDX	#$C1		LDA	>ApTalkFlag,x		BMI	iwsrite		INX		;I guess it's port 2... no prob*IWSRITE		EQU	*		SEC		;It is the output queue we want		JSR	DeQueue	;Try to get a character		BCS	atbrp1	;Got one...give it to 'em*		JSR	FPlusR	;Flush, Recharge and endcheck		BNE	ATDeQ	;Get the first of the next group*		CLC		;No more background printingATBRP1		EQU	*		RTL		;He JSL'd to us**INTKILL		EQU	*		LDA	>FFDEVLBL-$C1,x		TAY		;We got the port hardware index		PHX		JSR	ClearInt	;Disable ints globally (this chnl)		PLX		LDA	|SCCData,y	;Pull any Rx chars pending		LDA	#%11010000	;Clear any Tx ovrn & Exstat ints		STA	|SCCCmd,y		LDA	#%00101000	;Clear any pending Tx interrupt		STA	|SCCCmd,y		RTS**		TITLE	'Buffering Support'		LONGA	ON		LONGI	ON**********************************************************************                                                                   ** Enqueue                  Place a character in the specified queue **                                                                   **   This routine takes the character passed and places it in the    **  specified queue.  There are two overflow conditions, hard and    **  soft.  Soft overflow indicates that the queue is > 3/4 full,     **  and a hard overflow indicates that the queue is full and that    **  the character was not queued.                                    **                                                                   **   Input:    A <- character to enqueue                             **             X <- Port ($C1, $C2)                                  **             C <- 1=Output Queue, 0=Input Queue                    **   Output:   A,X,Y  <- preserved                                   **             V <- 1 char queued but queue is close to overflow     **             C <- 1 char was not queued due to hard overflow       **   Assumes:  E <- 0 : Native mode                                  **                                                                   ***********************************************************************ENQUEUE		EQU	*		PHX		PHY		PHB		;Keep around the current DBR** Check to see if the queue has space to grow*		PHA		;Twice since we'll be 16 bit on return		PHA		JSR	QSpace		BNE	enq2		PLA		;Get the character back		SEC		BRA	enq4	;Return on overflow*ENQ2		EQU	*		PLX		;Keep the character in X** Set up the soft overflow flag*		SEP	#%01000000	;Set the overflow flag		PHA		LDA	|QBLen,y		LSR	a		LSR	a		CMP	1,s		PLA		BGE	enq3		CLV		;No overlfow- lots of space leftENQ3		EQU	*** Disable interrupts to prevent race conditions*		PHP		SEI		;No interrupts to prevent race conds*		PHY		;Save queue index for later** Now swap the queue base pointer into zero page to do an indirect store*		JSR	SwapQBZP** Insert the character into the tail of the queue.*		LDA	QTail,y		TAY		TXA		;Get the char to enqueue		SEP	#%00100000	;Set 8 bit accumulator		STA	[zpage],y		REP	#%00100000	;Back to the future** Increment tail pointer and swap back zero page*		INY		;QTail:=QTail+1		TYA		PLY		;Get back the Queue index		PHA		;Save QTail		JSR	SwapQBZP		PLA** Now, might need to adjust QTail if it passed out of the buffer*		CMP	QBLen,y		BLT	enq1	;If QTail<QBLen, no need to wrap		LDA	#0ENQ1		EQU	*		STA	qtail,y*		PLP		;Restore interrupt mask		CLC		TXA		;Replace the char in AENQ4		EQU	*		SEP	#%00110000	;Back to 8 bit land		PLB		PLY		PLX		RTS*		EJECT**********************************************************************                                                                   ** Dequeue             Retrieve a character from the specified queue **                                                                   **   This routine gets a character from a queue and returns it in    **  the low 8 bits of the accumulator.  The carry is returned set on **  underflow.  "Soft" underflow is signaled if the queue is filling **  less than 1/4 of the buffer size.                                **                                                                   **   Input:    X <- Port index ($C1, $C2)                            **             C <- 1=Output Queue, 2=Input Queue                    **   Output:   A <- character                                        **             X,Y  Preserved                                        **             V <- 1 "soft" queue underflow                         **             C <- 0 "hard" queue underflow                         **   Assumes:  E <- 0 : Native mode                                  **                                                                   ***********************************************************************DEQUEUE		EQU	*		PHX		PHY		PHB		;Keep around the current DBR** Check if there are any characters to retrieve*		JSR	QLength		BEQ	nochars	;Branch is queue length = 0** Set the "soft" underflow appropriately*		SEP	#%01000000	;Set V		PHA		LDA	|QBLen,y		LSR	a		LSR	a		CMP	1,s		PLA		BGE	deq2		CLV		;Carry will be set at exitDEQ2		EQU	*		SEC		;We're giving back a char		PHP		SEI		;Disable interrupts to avoid race conds** Now swap QBase into zero page*		JSR	SwapQBZP** Remove a character from the head of the queue*		PHY		;Save off the queue index		LDA	QHead,y	;Get the queue head index		TAY		;Move for indirect load		LDA	[zpage],y	;Get the byte		TAX		;And save it in X** Move the head pointer*		TYA		INC	a** Put back zero page and QBase*		PLY		;Get queue index back		PHA		;Save QHead for a sec		JSR	SwapQBZP		PLA** Maybe have to adjust QHead*		CMP	QBLen,y		BLT	deq1		LDA	#0DEQ1		EQU	*		STA	QHead,y*		PLP		;The carry is set here		TXA		;Move the char back to A		BRA	deq3*NOCHARS		EQU	*		CLC		;Return an underflowDEQ3		EQU	*		SEP	#%00110000	;Back to 8 bit M,X		PLB		PLY		PLX		RTS*		EJECT***************************************                                    ** SwapQBZP       Exchange QBase & ZP **                                    **  Moves the QBase pointer to zero   ** page and preserves zero page in    ** QBase.  A is destroyed, assumes    ** 16 bit modes; 4 bytes are swapped. **                                    ****************************************SWAPQBZP		EQU	*		LDA	QBase,y		PHA		LDA	zpage		STA	QBase,y		PLA		STA	zpage*		LDA	QBase+2,y		PHA		LDA	zpage+2		STA	QBase+2,y		PLA		STA	zpage+2*		RTS*****************************************                                    ** QSpace, QLength   Queue count rtns **                                    **  These return a 16 bit value       ** reflecting the amount of space     ** remaining or the amount of chars   ** currently in a queue.  It is       ** passed the queue index in Y.       **                                    ****************************************QLENGTH		EQU	*		LONGA	OFF		LDA	#$E1		LONGA	ON		PHA		PLB		JSR	SetQueue		REP	#%00110000		LDA	QTail,y		SEC		SBC	QHead,y		BGE	ql3		ADC	QBLen,yQL3		EQU	*		RTS**QSPACE		EQU	*		JSR	QLength	;Acc <- chars in queue 		SEC		SBC	QBLen,y	;Acc <- currentlen-maxlen		EOR	#$FFFF		RTS		;Acc <- maxlen-currentlen-1*		LONGA	OFF		LONGI	OFF****************************************                                    ** ResetQs   Set buffers to defaults  **                                    **  This flushes the queues and       ** sets the buffer base and length    ** addresses.  It asks the memory     ** manager for 4K (both buffers) and  ** if this request is refused it uses ** buffer space reserved in bank $E1. **                                    **   Input:    X <- $C1, $C2          **                                    ****************************************		LONGA	ON		LONGI	ONRESETQS		EQU	*		PHX		SETDBR	$E1E1		CLC		JSR	SetQueue** Only do this once after open-apple resets (or powerup).  The firsttime*  byte is smashed to zero on open-apple reset (and powerup).*		LDA	|firsttime-$C1,x		BNE	rq1		INC	|firsttime-$C1,x** Try to get a big buffer from the memory manager.*		REP	#%00110000		PHY		JSR	GetBigBuf		PLY		PHP		;C=0 means we got a big buffer		BCC	rq2	;Skip around the default stuff** We couldn't get a big buffer for some reason.  Luckily we have*  default buffers (they're kinda small) that he can use.*		LDX	#^E1Buffer1	;Top part		LDA	#E1Buffer1	;Low part		CPY	#0	;Check port number ($0 or $20)		BEQ	rq2	;It was port one... use buffer 1		LDA	#E1Buffer2	;It was port two...*RQ2		EQU	*		STA	QBase,y		TXA		STA	QBase+2,y** Now get the correct buffer size.  Pull back the result (in carry)*  that we were returned by GetBigBuf.  If clear, buffer size is*  bufsize/2, otherwise it is 128 bytes.*		PLP		LDA	#128		BCS	rq3		LDA	#bufsize/2RQ3		EQU	*		STA	QBLen,y		STA	QBLen+10,y** Now make the output buffer base pointer...*		CLC		ADC	QBase,y		STA	QBase+10,y		BCC	rq4	;No bank cross		INXRQ4		EQU	*		TXA		STA	QBase+12,y** Now we've got to clean up and flush the buffers.*RQ1		EQU	*		SEP	#%00110000		PLB		PLX*		CLC		JSR	Flush	;Flush input buffer		SEC		JSR	Flush	;Flush output buffer*		RTS		;Flush leaves us in 8 bit M,X*		LONGA	OFF		LONGI	OFF**SETQUEUE		EQU	*		XBA		LDA	#0		BCC	sq1		LDA	#10SQ1		EQU	*		CPX	#$C2		BLT	sqout		ADC	#19	;Carry was setSQOUT		EQU	*		TAY		XBA		RTS**		TITLE	'Set Initial Register Values'*********************************************************************                                                                 **  Default                    Set up the serial port defaults     **                                                                 **   This routine sets up the local storage of the SCC registers   **  and other information needed by the driver.                    **                                                                 **   Input:   X <- $C1-port 1, $C2-port 2                          **   Preserves:   X                                                **                                                                 *********************************************************************DEFAULT		EQU	*	;X enters as $CN** Get devno in Y, Init this port like a serial/comm port (preserve X)*		PHX		LDA	>FFDEVLBL-$C1,x		TAY*		JSR	ResetSCC	;Set up reg 9** If in AppleTalk mode, SCC no touch.*		LDA	>ApTalkFlag,x		BMI	peter** First wait until the Tx is underrun to prevent the inadvertent*  "chopping" of a byte that we are currently sending out.*WAITORCA		EQU	*		LDA	#0		JSR	ReadSCC		CMP	#%01000000		BEQ	waitorca** Arrange for stop bits default*PETER		EQU	*		LDX	#DefDForm	;Load index for stop bit deflt		JSR	GetSysDflt	;0-1 stop, 1-2 stop		AND	#%00000001	;0000000S		SEC		ROL	a	;000000S1** Now fold in the parity bits default. (Do you like merry-go-rounds?)*		XBA		;A=XXXXXXXX B=000000S1		LDX	#DefParity	;Get the index for the parity default		JSR	GetSysDflt	;00-Odd, 01-Even, 10-None		EOR	#%00000010	;A=000000PQ where P=Parity,Q=Even		LSR	a	;A=0000000P B=000000S1 C=Q		XBA		;A=000000S1 B=0000000P C=Q		ROL	a	;A=00000S1Q B=0000000P C=0		XBA		;A=0000000P B=00000S1Q C=0		LSR	a	;A=00000000 B=00000S1Q C=P		XBA		;A=00000S1Q B=00000000 C=P		ROL	a	;A=0000S1QP B=00000000 C=0		TYX		;...I'm kinda dizzy...		ORA	#%01000000	;X16 clock mode		STA	>WR4,x	;Need to preserve register setting** And now with the receive word length...*		LDX	#DefDForm	;Get index for # of data bits		JSR	GetSysDflt	;00X-5,01X-6,10X-7,11X-8 bits		LSR	a	;00-5,01-6,02-7,03-8		AND	#%00000011		TAX		LDA	>DBitMap,x		TYX		STA	>WR3,x** Finally set the transmit word length*		LSR	a	;0nn00000		ORA	#%00001010	;Make sure DTR is hi and RTS is low		STA	>WR5,x** Deal with the baud rate*		JSR	FigBaud** Now set all the registers with these stored values*		PLX		PHX		JSR	InitSerial** Now set other non-SCC stuff- start with the default flags byte*		LDA	#0		LDX	#DefXONHSTL1		EQU	*		XBA		;B has accumulated SCC bits		JSR	GetSysDflt	;Get the next default flag		LSR	a	;Get the boolean out		XBA		;A has accumulated SCC bits		BCC	tl2	;Branch if default was false		ORA	>BitTab,x	;If bit=1 BitTab positions it for SCCTL2		EQU	*		DEX		BPL	tl1	;Back for the next default (5 of 'em)*		PLY		EOR	#%00001000	;Reverse the sense of the LF filter		STA	|flags,y** Set the escape character up*		AND	#%00000001		BNE	defcom		LDA	#9DEFCOM		EQU	*		STA	|eschar,y** Set the 2nd mode byte (contains buffering, and DCD handshake)*		LDX	#DefBuff		JSR	GetSysDflt	;Get boolean buffering default		BEQ	tl3	;=> It's off, so skip turn on		LDA	#BfrngMaskTL3		EQU	*		XBA		LDX	#DefDCDHS		JSR	GetSysDflt	;Get the DCD handshake default		LSR	a		XBA		;Get back A		BCC	tl4	;=> skip turn on if off		ORA	#DCDHSMaskTL4		EQU	*		TYX		STA	|sermode2,x** Set up the printer width*		LDX	#DefLen	;Get index for Printer Width		JSR	GetSysDflt	;0-unlim,1-40,2-72,3-80,4-132		TAX		LDA	>LenTab,x		STA	|pwdth,y** And clear out the port mode byte*		TYX		STZ	|sermode,x		STZ	|col,x	;Just like SSC		LDA	|sermode3,x		AND	#BasicMask		STA	|sermode3,x	;Clear all but the Basic/Pascal bit		LDA	#0		STA	>UserInt,x** If buffering is enabled, set up the queues and enable interrupts*		LDA	|sermode2,x		BIT	#BfrngMask		BEQ	tl5*		PHX		JSR	ResetQs		JSR	EnableInt		PLX** And now, we're defaulted.*TL5		EQU	*		RTS*** Get a default.  Y has which port (table) (lsb=0 means port 1),*  and X is the value within the table.  On output X,Y are preserved*  and A has the value retrieved.*GETSYSDFLT	EQU	*		LDA	|mslot	;Move port index to A		LSR	a	;C <- 0 if this is port 1		BCC	gsd1	;=> branch for port 2		LDA	>DefPort1,x	;Get value for port 1		RTSGSD1		EQU	*		LDA	>DefPort2,x	;Get value for port 2ISOUT		EQU	*		RTS**FIGBAUD		EQU	*		LDX	#DefBaud	;Get index		JSR	GetSysDflt	;0000-50,1110-19200		INC	a	;0001-50,1111-19200STOREBAUD		EQU	*		TYX		STA	>WRCD,x		RTS*** This maps the number of data bits passed in the default table to*  a value directly storable in register 3 (eventually 5).*DBITMAP		DC.B	%00000001,%10000001,%01000001,%11000001** BitTab contains info to remap bits from Control Panel -> flags byte*  The order is Port Mode, Line Length, Delete LF, Add LF, Echo,*  Buffering, Baud, Format, Parity, DCD, DSR, and XON/XOFF.*BITTAB		EQU	*		DC.B	%00000001,%00000000,%00001000,%01000000		DC.B	%10000000,%00000000,%00000000,%00000000		DC.B	%00000000,%00000000,DSRHSMASK,%00100000** LenTab has the different line lengths specified by the defaults*LENTAB		DC.B	0,40,72,80,132**		EJECT*********************************************************************                                                                 **  InitSerial, ResetSCC       Serial Port Initialization Routines **                                                                 **   These routines do the SCC register storage whenever initially **  and whenever a recieve or transmit option is altered.  It sets **  up the registers in the order recommended by Zilog.  ISerCold  **  does a port reset before drifting down into ISerWarm.          **                                                                 **   Input:   Y <- $3C-port 1, $3B-port 2                          **            X <- $C1-port 1, $C2-port 2                          **                                                                 *********************************************************************RESETSCC		EQU	*** No touch if in AppleTalk mode*		LDA	>ApTalkFlag,x		BMI	isout*		TYX		LDA	>ResetTabl,x		LDX	#9		JMP	WriteSCC	;Reset this port*INITSERIAL:** Don't touch that SCC if in AppleTalk mode*		LDA	>ApTalkFlag,x		BMI	isout	;Sneak use of default routine's rts** Do the stop bits and parity setting*		LDA	SCCCmd,y	;Try to force register sync*		TYX		LDA	>WR4,x		LDX	#4		JSR	WriteSCC** Set up the interrupts*		TYX		LDA	#0		LDX	#1		JSR	WriteSCC** Do the Receive and Transmit word lengths*		TYX		LDA	>WR3,x		PHA		;Keep for later		AND	#%11111110	;Don't enable yet		LDX	#3		JSR	WriteSCC*		TYX		LDA	>WR5,x		PHA		;Keep this too		AND	#%11110111	;No enable yet		LDX	#5		JSR	WriteSCC** Set up the clock register*		LDA	#%11010010	;ChB: XTAL,RxCBR,TxCBR,RTxCBR		CPY	#$3C		BEQ	df1		LDA	#%01010010	;ChB: NOXTAL,RxCBR,TxCBR,RTxCBRDF1		EQU	*		LDX	#11		JSR	WriteSCC** Set the baud rate*		TYX		LDA	>WRCD,x		AND	#%00001111		TAX		PHX		;Just a second		LDA	>BaudTabL,x		LDX	#12		JSR	WriteSCC		PLX		;Got it back		LDA	>BaudTabH,x		LDX	#13		JSR	WriteSCC** Try setting baud options before enabling BRG*		LDX	#14		LDA	#0		JSR	WriteSCC** Enable the baud rate generator*		LDX	#14		LDA	#%00000001		JSR	WriteSCC** Turn on the reciever and transmitter*		PLA		;Get back the WR5 value		ORA	#%00001000	;Flip that bit		LDX	#5		JSR	WriteSCC		PLA		; and now the WR3		ORA	#%00000001	;Flip dat bit		LDX	#3		JSR	WriteSCC*		LDA	#0		LDX	#15		JMP	WriteSCC**RESETTABL		EQU	*-$3B		DC.B	%00001010	;ChB NV- reset removed		DC.B	%00001010	;ChA NV- reset removed**CLEARINT		EQU	*** No touch if in AppleTalk mode*		LDA	>ApTalkFlag,x		BMI	ciout*		LDA	#0		LDX	#1		JSR	WriteSCC	;Disable interrupts this port*CIOUT		EQU	*		RTS**		TITLE	'SCC Support Routines'		; SEG	$FF*******************************************************************                                                               **  ReadSCC, WriteSCC                                            **                                                               **   These routines allow read and the write the SCC command     **  register channel A or B.                                     **                                                               **   Input:    A <- $0..$F register number (read)                **             A <- value to store (write)                       **             X <- register to store (write)                    **             Y <- $3C    channel A                             **                  $3B    channel B                             **   Output:   A <- register value (read)                        **             C <- preserved                                    **                                                               *******************************************************************WRITESCC		EQU	*		PHP		;Preserve interrupt status		SEI		;Disable interrupts to maintain synch		PHA		;Save value to write		TXA		;Get the register number		STA	SCCCmd,y	;Set up		PLA		;Get back the value		STA	SCCCmd,y	;Make it real		PLP		;Okay if interrupts happen now.		RTS**READSCC		EQU	*		PHP		SEI		;No interrupts to maintain SCC synch		STA	SCCCmd,y		LDA	SCCCmd,y		XBA		;NZ should be set per A on exit		PLP		;Interrupt all you want now		XBA		RTS**		; SEG	$00** Potpourii** This routine is only here because of space constraints...** Check to see if the receive char has an error.  If so, we want*  to eat it and say there's no char available.  If we're doing*  XON/XOFF and the character IS an XON or XOFF, say no char avail;*  otherwise save the char in the one byte buffer and flag.** The carry is clear if there is no character available, set ow.*POTPOURRI		EQU	*** If this char has an error, and we're filtering errors, eat the*  character and report no char avail.*		JSR	CheckError		BCC	pperr	;This char had an error and was eaten** If we're not doing XON/XOFF protocol, no need to check the char*		LDA	|flags,x		BIT	#XMask		BEQ	pperr	;Carry is still set here*		JSR	GetData	;Pull the char...		BCC	pperr	;If it was XON/XOFF, no char avail*FLAGOBB		EQU	*** Store char (in Acc) in the one byte buffer and flag buffer full.*		STA	>OneByteBuf,x*		LDA	|sermode2,x		ORA	#ChrBufMask		STA	|sermode2,x*PPERR		EQU	*		RTS**		; SEG	$FF**BGPRINT		EQU	*		BCC	bgpokay		JMP	BadCall** Disable SCC interrupts*BGPOKAY		EQU	*		PHX		JSR	ClearInt	;AppleTalk protected		PLX** Force on buffering and background printing bits*		LDA	|sermode2,x		ORA	#BfrngMask+BRPMask		STA	|sermode2,x** Load up the length of data to be sent*		PHY		LDY	#4		REP	#%00110000		LDA	[zpage],y		BNE	bp1** Gave us a data length of zero.  Force off buffering and BP bits.*		SEP	#%00110000		PLY*		LDA	|sermode2,x		AND	#BfrngMask+BRPMask--$FF		STA	|sermode2,x		JMP	OKExit*BP1		EQU	*** Store the length of data as the queue tail value*		PHA		SEC		SEP	#%00110000		JSR	SetQueue		REP	#%00110000		PLA*		PHX		TYX		STA	>QTail,x		LONGA	ON		LDA	#0		LONGA	OFF		STA	>QHead,x		PLX		SEP	#%00110000		PHX** Store the recharge address*		LDY	#8		CPX	#$C2		LDX	#2BP5		EQU	*		LDA	[zpage],y		BCS	bp2		STA	>RchgAdr1,x		BRA	bp3BP2		EQU	*		STA	>RchgAdr2,xBP3		EQU	*		DEY		DEX		BPL	bp5** Start interrupts and exit*BP4		EQU	*		PLX		PLY		JSR	EnableInt	;AppleTalk protected** If the AppleTalk bit is set, call the AppleTalk BRP start routine*		LDA	>ApTalkFlag,x		BPL	bp6		JSL	>ATBRP*BP6		EQU	*		JMP	OKExit*		; SEG	$00		TITLE	'Extended Xface Hardware Calls'**		; SEG	$FF*PORT		EQU	*		BCS	SetPort*		LDA	#3		JSR	ReadSCC		TAX		LDA	SCCCmd,y		BRA	spit16bits*SETPORT		EQU	*		JMP	BadCall**SCC		EQU	*		PHY		LDY	#4		LDA	[zpage],y		TAX		INY		LDA	[zpage],y		PLY		BCS	dtr2		TXA		JSR	ReadSCC		LDY	#5		STA	[zpage],y		BRA	okeh**DTR		EQU	*		TYX		LDA	>WR5,x		BCC	spit8bits		AND	#%01101111		PHY		LDY	#4		ORA	[zpage],y		PLY		STA	>WR5,x		LDX	#5DTR2		EQU	*		JSR	WriteSCC		BRA	okeh**SPIT8BITS		EQU	*		LDX	#0SPIT16BITS	EQU	*		LDY	#4		STA	[zpage],y		INY		TXA		STA	[zpage],yOKEH		EQU	*		JMP	OKExit***		; SEG	$00**		; SEG	$FF**BAUDTABL		EQU	*		DC.B	0,BD50,BD75,BD109,BD134,BD150,BD300		DC.B	BD600,BD1200,BD1800,BD2400,BD3600		DC.B	BD4800,BD7200,BD9600,BD19200*BAUDTABH		EQU	*		DC.B	0,BD50>>8,BD75>>8,BD109>>8,BD134>>8,BD150>>8,BD300>>8		DC.B	BD600>>8,BD1200>>8,BD1800>>8,BD2400>>8,BD3600>>8		DC.B	BD4800>>8,BD7200>>8,BD9600>>8,BD19200>>8*		; SEG	$00*		; SEG	$FF*NEWBASVEC:		PHP		JSR	which		BCS	bpat		PLP		JMP	>SerBasPatchBPAT		PLP		JMP	>ASBas**NEWPASVEC:		PHP		JSR	which		BCS	ppat		PLP		JMP	>SerPasPatchPPAT		PLP		JMP	>ASPas**NEWEXTVEC:; The code that called ASEXT has been removed;  since it's never been used, and would be;  slightly less than trivial to support.  No one;  should be making calls to the extended interface;  when the port is in AppleTalk mode.;;php;jsr which;bcs epat;plp		JMP	>SerExtPatch;epat plp;jmp =ASExt**WHICH		EQU	*		PHA		PHX		TXA		ROR	a		LDX	#$00		BCS	npovr		LDX	#$0CNPOVR		EQU	*		LDA	>DefPort1,x		CMP	#$02		PLX		;Got back CN		BCC	npnas	;If serial, skip AppleShare flagging		LDA	#$80	;This is the AS flag value		STA	>ApTalkFlag,xNPNAS		EQU	*		PLA		RTS**