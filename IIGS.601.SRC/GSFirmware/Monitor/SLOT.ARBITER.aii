		TITLE	'Set System Speed & Slot Arbiter';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 5:3:40 PM*******************************************************                                                    **         Set System Speed & Slot Arbiter            **                                                    **                       by                           **                    Ray Montagne                    **                    Joe  Bo                         **                                                    **       Copyright Apple Computer, Inc. 1987-1989     **                All Rights Reserved.                **                                                    *******************************************************;; This routine sets the system speed in preparation for calling     ; a speed dependent device driver.  Speed settings are in the; least significant two bits of the 'A' defined as follows:; ;    00  1.0 mhz;    01  2.6 mhz;    10  >2.6 mhz;    11  not speed dependent (no change);; Entry: via a 'JSL' and must be in 16 bit m/x;    a = requested speed;    x/y/b/d: undefined;    p = n/v/m/x/d/i/z/c  e;      = x/x/0/0/0/x/x/x  0;; Exit:;    a = speed prior to requested change;    x/y/b/d: undefined;    p = n/v/m/x/d/i/z/c  e;      = x/x/0/0/0/x/x/x  0;	; SEG $FFSETSPEED		EQU	*	; SEG $00		LONGA	ON		LONGI	ON		AND	#$0003	;Mask unwanted bits		LONGA	OFF		SEP	#$20	;8 bit 'm'		TAY		;Save next speed setting		LDA	>CYAREG	;Get current speed setting		AND	#$80	;		CLC		;		ROL	A	;		ROL	A	;		TAX		;X = previous speed		TYA		;		BEQ	SETSLOW	;		CMP	#$01	;Set to fast speed ?		BEQ	SETFAST	;		CMP	#$03	;NO change		BEQ	KEEPPRE	;		DEC	A	; > 2.6 MHZ, can't do that yet !!!SETFAST		EQU	*		LDA	#$80	;Set fast speed		ORA	>CYAREG	;		STA	>CYAREG	;		BRA	KEEPPRE	;bra to keep previous speedSETSLOW		EQU	*		LDA	>CYAREG	;		AND	#$70	;Set slow speed		STA	>CYAREG	;KEEPPRE		EQU	*		TXA		; Keep previous speed		LONGA	ON		REP	#$20	;Set back to 16 bit 'm'SPEEDXIT		EQU	*		AND	#$0003	;		RTL		;;; The following routine checks that a requested slot selection; is valid.  If so, the requested slot is selected and the; appropriate screen holes are copied in prior to passing; control back to the calling routine.;; NOTE: No dynamic slot selection occurs at this time;; Entry: via a 'JSL' through $E1 vector with 16 bit m/x;    a = requested slot;    x/y/b/d: undefined;    p = n/v/m/x/d/i/z/c  e;      = x/x/0/0/0/x/x/0  0;; Exit: via an 'rtl';    a = error code;    x = slot configuration word;    y = unspecified;    b/d: unchanged;    p = n/v/m/x/d/i/z/c  e;        x/x/0/0/0/x/x/0  0   if slot was granted;        x/x/0/0/0/x/x/1  0   if slot was not granted;     	; SEG $FFSLOTARBITER	EQU	*	; SEG $00		LONGA	ON		LONGI	ON		PHB		;Save data bank		CLC		;Assume no error		TAY		;		AND	#$0300		BNE	EXIT		TYA		LONGA	OFF		LONGI	OFF		SEP	#$30	;8 bit m/x		TAX		;Save user's requested slot		AND	#$07	;Strip external bit		BEQ	BADSEL	;		CMP	#$03	;Slot 3 is a special case		BEQ	SLOT3REQ	;		TAY		;Is current slot external ?		LDA	>SLTROMSEL	;LOOP		EQU	*		ROR	A		DEY		;		BPL	LOOP	;C=1 if external on loop exitCHECKSLOT		EQU	*		TXA		;Get back user's slot request		AND	#$08	;		BCS	CHKXIT	;YES		BNE	BADSEL	;If is int but requested extGOODSEL		EQU	*		CLC		;		BRA	EXITCHKXIT		EQU	*		BNE	GOODSEL	;BADSEL		EQU	*		SEC		;EXIT		EQU	*		SEP	#$20	;Get us back into 8 bit mode 3/23/89 MSA		PHP		;Save 'c'		LDA	>SLTROMSEL	;Get slot		PHA		XBA		PLA		PLP		LONGA	ON		LONGI	ON		REP	#$30		EOR	#$00FF	;Create slot configuration word		AND	#$FEFE		TAX		LDA	#$0000	;Assume no error first		BCC	REALEXIT	;		LDA	#$0010	;Error codeREALEXIT		EQU	*		PLB		RTLSLOT3REQ		EQU	*		LONGA	OFF		LONGI	OFF		LDA	>RDC3ROM	;Need slot 3 selection		ROL	A	;		BRA	CHECKSLOT	;C=1 if slot 3 is external** The set_default_slots and restore_system_slots are used in * interrupt codes.  * Not yet implemented in this version.   * 	; SEG $FFSETDEFSLT		EQU	*	; SEG $00	; SEG $FFRSTSYSSLT		EQU	*	; SEG $00		RTL		;		TITLE	'Some Stuff Called/Used by Desk Acc'* TP2TASK is called by the heartbeat task scheduler* to move text page 2 from bank 00 to bank E1.	; SEG $FFTP2TASK		EQU	*	;Task to copy text page 2 to bank E0	; SEG $00		LDA	#$01	;Reset task counter		STA	>TP2TCNT	;Low byte is sufficient		LONGA	ON		LONGI	ON		REP	#$30	;16 bit land required for routine		LDX	#$0800	;Starting address of move in source bank		TXY		;Starting addr of move in destination bank		LDA	#$0400-1	;Number of bytes to move-1		MVN	$000000,$E00000	;Source,destination banks		LONGI	OFF		LONGA	OFF		RTL		;Back to heartbeat handler with task done* ENMONDSKACC is called by the user pressing* '#' as a command in the monitor.  It installs* a desk accessory which allows the user to* enter the monitor from the desk accessories* menu and return to it with a control-Y.* It also installs the memory peeker desk accessory.ENMONDSKACC	EQU	*	;Enable the monitor desk accessory		LDA	>ROMDAACT		ORA	#$80	;		STA	>ROMDAACT	;ENMONDSKACC1	EQU	*		LDA	>ROMDAACT	;Test if already active		PHA		ASL	A	;Bit7=1=install it--Bit6=1=is installed		BMI	ENROMDA	;Already installed if bit is set		REP	#$30	;16 bit land required for call		PEA	PTRDAINFOTBL>>16	;Bank #		PEA	PTRDAINFOTBL	;Address		LONGI	ON		LDX	#INSTALLCDA	;Tool # and function for call		LONGI	OFF		JSL	>DISPATCH1	;Make call to install desk accessory		JSL	>MEMORYPEEKER	;Install memory peeker too		SEP	#$30	;Return in 8 bit modeENROMDA		EQU	*		PLA		;		ORA	#$40	;Say that monitor/memory peeker installed		STA	>ROMDAACT	; and active.		RTS		;Back to caller with desk acc installed	; SEG $FFPTRDAINFOTBL	EQU	*	; SEG $00		DC.W	DAINFOTBL	;		DC.W	DAINFOTBL>>16	;	; SEG $FFDAINFOTBL		EQU	*	; SEG $00		STR	'Visit Monitor'		DC.W	REALCODE	;Address of code		DC.W	REALCODE>>16	;Bank number of code		DC.W	SHUTDOWN	;Address of shutdown routine		DC.W	SHUTDOWN>>16	;Bank number of shutdown routine	; SEG $FFREALCODE		EQU	*	; SEG $00		SEP	#$30	;Switch to 8 bit native mode		SEI		;Kill interrupts in here		PEA	$0000	;Change data bank register to $00		PLB		;		PLB		;		LDX	#$02	;Save 3 bytes@0		EQU	*		LDA	|USRADR,X	;Save CTRL-Y vector information		PHA		;		DEX		;		BPL	@0	;Loop til done		LDA	#$4C	;JMP opcode		STA	|USRADR	;		LDA	#<RETURNFROM	;Put in CTL-Y hook		STA	|USRADR+1	;		STZ	|USRADR+2	;High byte is $00		LDX	#GOINFOLEN-1	;Number of bytes-1 to save@1		EQU	*		LDA	GOTOMON,X	;Save zero page		PHA		;		DEX		;		BPL	@1	;Loop til done		PHB		;		PHK		;		PLB		;		LDX	#GOINFOLEN-1	;Move 9 bytes for hooks@11		EQU	*		LDA	GOINFO,X	;		STA	GOTOMON,X	;		DEX		;		BPL	@11	;Loop til done		PLB		;		PHK		;Set up return bank		PLA		;		STA	RETURNBANK	;		LDA	STATEREG	;Save state register while		PHA		; clearing screen.		JSR	HOMEFF	;Clear screen		LDA	#WELCOME	;		JSR	PRINTMSG	;8 bit entry to print message routine		PLA		;Restore INTCXROM/SLOTCXROM status		STA	STATEREG	; by restoring state register.		SEC		;Must go to monitor in emulation mode		XCE		;Interrupts are off so it's OK here		JMP	>GOTOMON	;Go into monitor (Turns on interrupts)RETURNPOINT	EQU	*	;Interrupts are disabled on entry to here		PLA		;Remove monitor's CTRL-Y return address		PLA		;		PEA	$0000	;Restore data bank register to $00		PLB		;		PLB		;		CLC		;Must return to native mode		XCE		;		CLI		; and reenable interrupts.		LDX	#$00	;Restore zero page@2		EQU	*		PLA		;		STA	GOTOMON,X	;@4		EQU	*		INX		;		CPX	#GOINFOLEN	;If at GOINFOLEN then done		BCC	@2	;Loop til done		PLA		;Recall USRADR (CTRL-Y) information		STA	|USRADR-9,X	; and save it.		CPX	#GOINFOLEN+2	;Done if matches		BCC	@4	;Loop til done		REP	#$30	;MUST return in 16 bit mode	; SEG $FFSHUTDOWN		EQU	*	;No action required for the shutdown rtne	; SEG $00		RTL		;Return to calling programGOINFO		EQU	*		DC.B	$58,$4C	;Enable interrupts before entering monitor		DC.W	MONZ	;		DC.B	$78,$5C	;SEI and JMP abslong		DC.W	RETURNPOINT	;		DC.B	$00	;Return bank number patched in zero pgGOINFOLEN		EQU	*-GOINFO	;Number of bytes to move* A routine to set text page2 shadowing register ($c035, bit5)* probably for original //gs and new machine* For gs, when exit 'c'=0 else 'c'=1	; SEG $FFSETTEXT2REG	EQU	*	; SEG $00		PHB		; Save data bank		JSR	DBTOE1	;Set to $e1 bank		LDA	|KEYUCVER	;Get keyucver #		CMP	#$06	;If > $06, then using new CYA chip		BCC	@2	;Bra if not, old FPI chip		LDA	|TP2MODE	;Chk for already on/off		BNE	@2	;Bra if already off		LDA	#$20	;Else it is on, need to turn off		TSB	SHADOW	;Set off		BRA	@3	;Bra to end @2		EQU	*		LDA	#$20	;Previous on is off, set on now		TRB	SHADOW	;Set on, no effect for gs board@3		PLB		;Restore data bank		RTS		;Return to caller** This routine (placed here due to space constraints) assists*  in the execution of the 'G' & 'X' commands by taking the*  value of the user's M & X bits and folding them into the *  processor status byte so that they will correctly determine*  the state of the M & X bits at the beginning of the execution*  of the user's code.  The DBR must already point to $E1 on*  entry and the environment must be '8 bit native'.** The code was taken from the 01 ROM... {3/31/89 MSA & John A}*;INDEX8;MEMORY8 both not necessaryCOMBINEMX		EQU	*		PHP		SEP	#$30	;Force for this routine... restored at plp!		LDA	|MPVAL	;0000000M Get user desired M state		ASL	a	;000000M0           		ORA	|XPVAL	;000000MX                       		ASL	a	;00000MX0		ASL	a	;0000MX00		ASL	a	;000MX000		ASL	a	;00MX0000 Right where we want it		PHA		LDA	|PVAL	;Get back the other status bits		AND	#$CF	;Clear a hole for the MX bits		ORA	1,s	;Combine		PLY		;Clean up the stack		STA	|PVAL		PLP		;Pull back our execution environment		RTS**		LONGA	OFF		LONGI	OFF;; RESTOREFF: M, Q, e, P, B, D, Y, X AND A;RESTOREFF		EQU	*		PEA	$E1E1		PLB		PLB		;Change data bank to $e1		LDA	|RDPAGE2	;Page2, set/clr by user		BPL	P2OFF	;Bra if p2 off		LDA	|MVAL	;Memory status value		ORA	#$40	;Set p2 on		BRA	SETP2P2OFF		EQU	*		LDA	|MVAL		AND	#$BF	;Set p2 offSETP2		EQU	*		STA	|STATEREG	;Update the STATEREG, $c068		LDA	|QVAL	;bit7=speed, bit6-0, match shadow reg		ASL	A	;Speed to 'c'		PHP		;Temporary save this 'c'=speed		LDA	|CYAREG	;$C036		ASL	A	;Original speed to c		PLP		;Get back new speed in c		ROR	A	;Rotate to $C036 position with new speed 		AND	#$9F	;Bit 6/5 must write 0		STA	|CYAREG	;Update it		LDA	|QVAL		AND	#$5F	;Bit7/5 must write 0		STA	|SHADOW	;Update shadow reg, $c035		LDA	|EPVAL	;Get back e		ROR	A	;'e' into carry		LDA	|PVAL	;Get back user's processor status		ORA	#$04	;Disable interrupts {MSA 4/6/89}		XBA		;High byte = PVAL, low byte = data bank		LDA	|BVAL		REP	#$30	;Off to 16 bit land		LONGA	ON		LONGI	ON		PHA		;Push PVAL and data bank value to stack		LDA	|DVAL	;Restore user's direct register 		TCD		LDY	|YVAL	;Restore user's 'Y'		LDX	|XVAL	;Restore user's 'X'		LDA	|AVAL	;Restore user's 'A'		PLB		;Reset to user's data bank, from BVAL		BCC	USERE0	;Bra for user e=0       		PLP		;Restore user's P status		BCC	USERC0	;Bra for user e=0, c=0		SEC		;User's 'c'=1		BRA	USERC1	;Bra for user e=0, c=1USERC0		EQU	*		SEC		BRA	USERE1USERE0		EQU	*		PLP		BCC	USERC0E0		CLCUSERC1		EQU	*		XCE		SEC		BRA	USERC1E1USERC0E0		EQU	*		CLCUSERE1		EQU	*		XCE		CLCUSERC1E1		EQU	*		RTS		;Return to caller;; STOREFF: e, P, B, D, S, A, X, Y, M AND Q;STOREFF		EQU	*		STA	>AVAL	;Save low A (& high if e,m=0)		PHP		;Save P		LONGA	OFF		SEP	#$20	;Off to 8 bit A		PLA		;'P' in low A** Since we could not let the user have interrupts on during the*  execution of his instruction, we must force them back on here.*  {MSA 4/12/89} *		AND	#$FB	;Force off I bit which enables interrupts*		STA	>PVAL		CLC		XCE		;Native (user e into carry)		CLD		;No decimal mode		LONGA	OFF		SEP	#$20	;8 bit A		XBA		STA	>AVAL+1	;Save high A (if e or m was = 1)		LDA	#$00		ROL	A	;User's e to lsb		STA	>EPVAL	;Store it for display		PHB		;Save user data bank		PLA		STA	>BVAL		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		JSR	DBTOE1	;Change data bank to $e1		TDC		;Get user's direct register		STA	|DVAL	;Store it		STX	|XVAL	;       		STY	|YVAL	;        		LONGA	OFF		LONGI	OFF		SEP	#$30		LDA	|PVAL	;Fix 'm'/'x' for print registers		AND	#$30		LSR	A	;Shift 'x' into 'c' and 'm' into bit0		JSR	SCRN4	;Shift right 4 times, use user stack area		STA	|MPVAL	;Store new 'm' value		LDA	#$00		ROL	A	;		STA	|XPVAL	;Store new 'x' value		LDA	|STATEREG	;Get machine state		STA	|MVAL	;Store to print buffer for display		AND	#$04	;Mask for language card bank for LVAL		LSR	A	;Shift bit2 (LC bank) to bit0		LSR	A	;		STA	|LVAL	;Store for display		LDA	|CYAREG	;Get speed		ASL	A	;Speed to 'c'		PHP		;Save 'c'		LDA	|SHADOW	;		ASL	A		PLP		;Get back speed		ROR	A	;Rotate to MSB		STA	|QVAL		AND	#$5F	;Strip off speed		STA	|SHADOW	;		LDA	|CYAREG		ORA	#$80		STA	|CYAREG	;Go fast		PEA	$0000	;Set monitor direct reg, $0000		PLD		;Reset direct register		PEA	$0000	;Reset monitor data bank, $00  		PLB		;Reset data bank		PLB		RTS		;Back to monitor's for display user's regs***STACKFUTZ		EQU	*** This routine stores the value of the emulation stack pointer PLUS TWO*  at the emulation stack pointer storage location $010100.  The*  plus two covers the rts which is done at the end of the routine.*  This routine is called in four places by routines in MISC.MON.aii*  {MSA 4/28/89}*		LDA	>MNEMSTKPTR	;Get the old value		STA	>KPMNEMSP	; and keep 'til later		TSC		;Get current pointer		INC	a		INC	a		STA	>MNEMSTKPTR		RTS*