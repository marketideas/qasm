;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 3:48:55 PM		TITLE	'Cortland Mouse MISC'*********************************************************                                                      **                    Cortland Mouse                    **                                                      **                    MISC Routines                     **                                                      **                          by                          **                     Fern Bachman                     **                     Joe  Bo                          **                                                      **     Copyright  1984-1989 by Apple Computer, Inc.     **                 All Rights Reserved                  **                                                      *********************************************************	; SEG $FFMOUSE_DISPATCHER	EQU	*	; SEG $00		CLD		;No decimal mode in here		JMP	(MOUSE_RTNES,X)	;Off to routine immediatelyMOUSE_RTNES	EQU	*		DC.W	INITMOUSE		;(0) Initialize mouse routine		DC.W	CLAMPMOUSE	;(2) Set mouse clamps		DC.W	READMOUSE		;(4) Read mouse info and update for user		DC.W	MOUSEBASIC	;(6) Do mouse stuff for BASIC		DC.W	HOMEMOUSE		;(8) Do home mouse stuff		DC.W	SETMOUSE		;(A) Do set mouse stuffSETMOUSE		EQU	*		REP	#$30	;16-bit m/x for tool		LONGA	ON		LONGI	ON		PHA		;Low byte contain mouse mode from user		LDX	#$1903	;Set Mouse mode call		JSL	>DISPATCH1	;DO IT		RTL		;Return to $c4xxMOUSEBASIC	EQU	*		LONGA	OFF		;8-bit m/x entry		LONGI	OFF		TYX		;Restore 'X' value		BCS	@11	;C=1 if BASIC input		LDY	#>OENTBAS	;Y must be current $Cn		CPY	KSWH	;Are input hooks requested?		BNE	@1	;<>= BASIC wants to do output		LDY	KSWL	;Test lo byte of input hook		BEQ	@11	;If so must be IN call@1		EQU	*		PHA		;Save A on stack		PHX		;Save X on stack		AND	#$7F	;No high bits		CMP	#$02	;User must send 0 or 1 only		BCS	@12	;Exit with no changes		PHP		;No interrupts in here		SEI		;		JSR	TSETMOUSE	;Set mouse mode		JSR	TINITMOUSE	;Initialize mouse defaults		PLP		;Restore interrupt status@12		EQU	*		PLX		;Restore X		PLA		;Restore A		BRA	MBASICOUT4	;Back to BASIC@11		EQU	*		XBA		;Recall user 'Y' value from stack		LDA	7,S	;Gets it		TAY		;Move to 'Y'		XBA		;Restore 'A' value now		STA	(BASL),Y	;Replace flashing char		LDY	#<IENTBAS	;Lo byte of input hook		STY	KSWL	;Save in input hook		PHP		;No interrupts in here		SEI		;		JSL	>READMOUSE	;Update position and status		LDA	LO	;Pick up lo X byte		LDX	HI	;Pick up hi X byte		LDY	#$05	;Pstn of last byte of ASCII		JSR	MHEXTODEC	;Make ASCII in buffer		LDA	LO+$80	;Pick up lo Y byte		LDX	HI+$80	;Pick up hi Y byte		LDY	#$0C	;Pstn of last byte of ASCII		JSR	MHEXTODEC	;Make ASCII in buffer		LDA	KBD	;JSR XRDKBD ;Was a key pressed?		ASL	A	;Move bit 7 to C		PHP		;Save status on stack		LDA	BUTTON	;Pick up button status		ROL	A	;Move bits 6/7 to 0/1		ROL	A	;		ROL	A	;		AND	#$03	;Strip off excess bits		EOR	#$03	;Flip bits		INC	A	;Add 1		PLP		;Recall status		LDX	#$00	;Hi byte is always $00		LDY	#$10	;Pstn of last byte of ASCII		JSR	HEXDEC2	;Go place in input buffer		LDA	#$8D	;A must be CR to exit		STA	IN+$11	;Save as last character		LDX	#$11	;Set X to $11		PLP		;Restore interrupt statusMBASICOUT4	EQU	*		RTL		;Back to callerHOMEMOUSE		EQU	*	;User entry point - HOMEMOUSE		LDX	#4	;4 bytes to move@11		EQU	*		LDA	>LOWXCLAMP-1,X	;Get a clamp byte		PHA		;Save on stack		DEX		;Loop til done		BNE	@11	;@12		EQU	*		PLA		;Move clamp data to user absolute position		STA	LO,X	;X=0 for 'X' values - X=$80 for 'Y' values		PLA		;		STA	HI,X	;		TXA		;Test for done		BMI	@13	;- then done		LDX	#$80	;+ then do Y value too		BRA	@12	;@13		EQU	*	;Need to update bank $e1 mouse params		REP	#$30	;16-bit m/x for tool call		LONGA	ON		LONGI	ON		LDX	#$1A03	;HomeMouse Call		JSL	>DISPATCH1	;DO IT		SEP	#$30		LONGA	OFF		LONGI	OFF		RTL		;Return to my world with 8-bit m/x	; SEG $FFREADMOUSE		EQU	*	; SEG $00		PHP		;No interrupts in here		SEI		;		LDA	MOUSMODE	;Update bank $e1 mouse stuff w/ screen 		STA	>MSEMODE	; holes value before the mouse tool call		LDA	BUTTON	;		STA	>MSESTAT	;		LDA	LO+$80	;Low byte of absolute Y		STA	>LOWABSY	;		LDA	HI+$80	;High byte of absolute Y		STA	>HIGHABSY	;		LDA	LO	;Low byte of absolute X		STA	>LOWABSX	;		LDA	HI	;High byte of absolute X		STA	>HIGHABSX	;		REP	#$30	;16-bit m/x for tool call		LONGA	ON		LONGI	ON		PHA		;Space for result		PHA		; "		PHA		; "		LDX	#$1703	;MouseRead call		JSL	>DISPATCH1	;DO IT		SEP	#$30	;Back to 8-bit mode		LONGA	OFF		LONGI	OFF		PLA		;Get mouse mode		STA	MOUSMODE	;Update screen hole, $7fc		PLA		;Get button status		STA	BUTTON	;Update screen hole, $77c		PLA		;Get lo byte of absolute Y pos		STA	LO+$80	;Update screen hole, $4fc        		PLA		;Get hi byte of absolute Y pos		STA	HI+$80	;Update screen hole, $5fc		PLA		;Get lo byte of absolute X pos		STA	LO	;Update screen hole, $47c		PLA		;Get hi byte of absolute X pos		STA	HI	;Update screen hole, $57c		PLP		;Restore interrupt state		CLC		;Must exit with carry clear		RTL		;Back to $c4xxINITMOUSE		EQU	*		REP	#$30	;16-bit m/x for tool call		LONGA	ON		LONGI	ON		LDA	#$0004	;MouseSlot for tool call		PHA		;Push for tool		LDX	#$1803	;InitMouse Call		JSL	>DISPATCH1	;DO IT		SEP	#$30	;Back to 8-bit land		LONGA	OFF		LONGI	OFF		RTL		;Back to $c4xxCLAMPMOUSE	EQU	*		PHA		;Save user's 'A' first		LDA	MOUSMODE	;Get screen hole mouse mode byte		STA	>MSEMODE	;Update for $e1 mouse mode		LDA	INFO	;Get screen hole mouse info byte		STA	>MSEINFO	;Update for $e1 mouse info location		PLA		;Restore user's 'A'		AND	#$01	;Strip off excess bits		TAX		;X=$00 for X clamps - X=$01 for Y clamps]		BNE	@1	;BRA to do Y clamps		LDA	LOWHI	;Doing X clamps            		PHA		;Push user's values for tool 		LDA	LOWLO	;		PHA		;		LDA	HIGHHI	;		PHA		;		LDA	HIGHLO	;		PHA		;		REP	#$30	;Off to 16-bit land		LONGA	ON		LONGI	ON		LDA	>LOWYCLAMP	;When doing X, no change for Y clamps		PHA		;		LDA	>HIYCLAMP	;		PHA		;		BRA	@2	;BRA to ClampMouse call@1		EQU	*		REP	#$30	;Off to 16-bit land		LONGA	ON		LONGI	ON		LDA	>LOWXCLAMP	;When doing Y, no change for X		PHA		;		LDA	>HIXCLAMP	;		PHA		;		SEP	#$30	;Back to 8-bit land		LONGA	OFF		LONGI	OFF		LDA	LOWHI	;Push in user's values for tool		PHA		;		LDA	LOWLO	;		PHA		;		LDA	HIGHHI	;		PHA		;		LDA	HIGHLO	;		PHA		;@2		EQU	*		REP	#$30	;16-bit for tool call		LONGA	ON		LONGI	ON		LDX	#$1C03	;ClampMouse Call		JSL	>DISPATCH1	;DO IT		SEP	#$30	;Back to 8-bit land		LONGA	OFF		LONGI	OFF		LDA	>MSEMODE	;Update screen holes mode and info		STA	MOUSMODE	; byte with new values returned		LDA	>MSEINFO	; by mouse tool call in bank $e1 		STA	INFO	; mouse stuff		RTL		;Back to $c4xx***************************************************                                                **          MHEXTODEC routine written             **                    by                          **               Rich Williams                    **                                                ** Data transferred to the input buffer has the   ** following form.                                **                                                ** s x1 x2 x3 x4 x5, s y1 y2 y3 y4 y5, sb B0 b1 cr*  *                                                **    s = sign and is only placed in buffer if    **        number is negative.                     **    x1...x5 = up to 5 ascii characters          **              giving the decimal value of X.    **    y1...y5 = up to 5 ascii characters          **              giving the decimal value of Y.    **    sb  = - if key pressed // no sign means     **           no key was pressed.                  **    b5 = 1 if button still pressed              **       = 2 if button down but was released      **       = 3 if button released but was down      **       = 4 if button released and was released  **    cr = Carriage return indicated to basic     **         the end has been reached.              **                                                **  Registers must be as follows on entry;        **         A = Low byte of number                 **         X = High byte of number                **         Y = Position of one's digit            **                                                **       Copyright 1983 Apple Computer, Inc.      **                                                ***************************************************MHEXTODEC		EQU	*		CPX	#$80	;Is number -?		BCC	HEXDEC2	;		EOR	#$FF	;Form 2's complement		ADC	#$00	;		PHA		;Save on stack for later		TXA		;		EOR	#$FF	;		ADC	#$00	;		TAX		;		PLA		;Restore A		SEC		;HEXDEC2		EQU	*	;		STA	IN+$21	;Store the number to convert 		STX	IN+$20	;		LDA	#$AB	;Plus char in ASCII		BCC	@1	;		LDA	#$AD	;Minus char in ASCII@1		PHA		;Save the sign		LDA	#$AC	;Store a comma after the number		STA	IN+1,Y	;		JSR	@2	;Convert hex to decimal ASCII		PLA		;Get the sign		STA	IN,Y	;		RTS		;Return to caller@2		EQU	*	;Divide by 10		LDX	#16+1	;16 bits and 1st time do nothing		LDA	#$00	;		CLC		;C=0 so first ROL leaves A=0@3		ROL	A	;		CMP	#10	;A >= 10?		BCC	@4	;Branch if <		SBC	#10	;C=1 frm CMP and is left set@4		ROL	IN+$21	;		ROL	IN+$20	;		DEX		;		BNE	@3	;		ORA	#$B0	;Make an ascii char		STA	IN,Y	;		DEY		;		BEQ	@5	;Stop on 0,7,14		CPY	#7	;		BEQ	@5	;		CPY	#14	;		BNE	@2	;@5		EQU	*	;		RTS		;Return to caller* End of MHEXTODEC routine