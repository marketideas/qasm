		EJECT		TITLE	'Functions and Subroutines';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 6:22:11 PM* BASIC FUNCTION HOOK:** INPUT: Y=FUNCTION AS FOLLOWS:**           1 = KEYIN *           2 = Fix escape char *           3 = BASCALCC *           4 = VTABC or VTABCZ*           5 = HOME*           6 = SCROLL *           7 = CLREOL *           8 = CLREOLZ *           9 = RESET  *           A = CLREOP *           B = RDKEY  *           C = SETWND *           D = Fix pick for monitor*           E = set 40 columns on PR#0/IN#0*F_HOME		LDA	WNDTOP		STA	CV		STZ	CH	;Reset CHF_CLREOP		LDY	CH	; ESC F IS CLR TO END OF PAGE		LDA	CVCLEOP1		PHA		JSR	VTABCZ		JSR	X_CLREOLZ		LDY	#$00		PLA		INC	A	;ADC #$00 ;(carry set)		CMP	WNDBTM		BCC	CLEOP1		BCS	GVTZ	;=>always to VTABCZF_SCROLL		LDA	WNDTOP		PHA		JSR	VTABCZSCRL1		LDA	BASL		STA	BAS2L		LDA	BASH		STA	BAS2H		LDY	WNDWDTH		DEY		PLA		INC	A	;ADC #$01  		CMP	WNDBTM		BCS	@2		PHA		JSR	VTABCZ@1		LDA	(BASL),Y		STA	(BAS2L),Y		DEY		BPL	@1		BMI	SCRL1@2		LDY	#$00		JSR	X_CLREOLZGVTZ		LDA	CVGVTZ2		JMP	VTABCZ	;set vertical baseF_SETWND		EQU	*		LDA	#40		STA	WNDWDTH		LDA	#24		STA	WNDBTM		DEC	A	;LDA #23		STA	CV		BNE	GVTZ2	;=>go do vtab, exit* Load Y from BAS2L and clear lineF_CLREOLZ		LDY	BAS2L	;set up by $F8 ROM		BRA	X_CLREOLZ	;JMP X_CLREOLZ ;and clear line* 80 column routines begin here* Clear to end of line using Y = BAS2L* which was set up by the $F8 ROMB_CLREOLZ		LDY	BAS2L	;get Y		JMP	X_GSEOLZ	;clear to end of lineB_HOME		JSR	X_FF	;HOME & CLEAR		LDA	OURCH		STA	CH	;COPY CH/CV FOR CALLER		STA	OLDCH	;REMEMBER WHAT WE SET		JMP	VTABC	;calc base & return* Complete PR# or IN# call.  Quit video firmware* if PR#0 and it was active (B_QUIT).  Complete call* if inactive (F_QUIT).B_QUIT		EQU	*		LDY	LOC0,X	;was it PR#0/IN#0?		BEQ	NOT0	;=>no, not slot 0		CPY	#KEYIN	;was it IN#0?		BEQ	IS0	;=>yes, update high byte		JSR	QUIT	;quit the firmwareF_QUIT		LDY	LOC0,X	;get low byte into Y		BEQ	NOT0	;not slot 0, firmware inactiveF8HOOK		LDA	#>KEYIN	;set high byte to $FD		STA	LOC1,XNOT0		LDA	LOC1,X	;restore accumulator		RTSIS0		LDA	CSWH	;is $C3 in output hook?		CMP	#>BASICIN		BNE	F8HOOK	;=>no, set to $FD0C		JMP	C3IN	;else set to $C305, exit A=$C3F_RDKEY		LDY	CH	;else do normal 40 cursor		LDA	(BASL),Y	;grab the character		PHA		AND	#$3F	;set screen to flash		ORA	#$40		STA	(BASL),Y	;and display it		PLA		RTS		;return (A=char) F_BASCALCCC	TAY		;restore Y		LDA	BASL	;restore A		JMP	BASCALCC	;calculate base addressB_ESCFIX		EQU	*		JSR	UPSHFT	;upshift lowercase		PHX		;Must use X for this		LDX	#4-1	;SCAN FOR A MATCH@2		EQU	*		CMP	>ESCIN,X	;IS IT?		BNE	@1	;=>NAW		LDA	>ESCOUT,X	;YES, TRANSLATE IT@1		EQU	*		DEX		BPL	@2		PLX		;Restore 'X'		RTS		;RETURN:CHAR IN AC 	; SEG $FFESCOUT		EQU	*	; SEG $00		DC.B	'JKMI'* Pick an 80 column character for the monitorFIXPICK		EQU	*	;get 80 column cursor		JSR	PICKY	;pick the character 		ORA	#$80	;always pick as normal		RTS		;and return* Load CH into Y and clear lineF_CLREOL		EQU	*		LDY	CH	;get horizontal positionX_CLREOLZ		LDA	#$A0	;store a normal blank		BIT	ALTCHARSET	;unless alternate char set		BPL	@1		BIT	INVFLG	;and inverse		BMI	@1		LDA	#$20	;use inverse blank@1		JMP	CLR40	;clear to end of line* Call VTABC or VTABCZ for 40 or 80 columns.  Acc (CV)* is saved in BASL.F_VTABCZ		TAY		;restore Y		LDA	BASL	;and A		JMP	VTABCZ	;do VTABCZ* Do BOUT, ESCFIX, BASCALCCC, and KEYIN immediately* to avoid destroying Accumulator.B_KEYIN		EQU	*		BIT	RD80VID	;80 columns?		BPL	B_KEYIN1	;=>no, flash the cursor		JMP	BIN	;get a keystrokeB_KEYIN1		EQU	*		LDY	CH	;Get cursor position		STA	(BASL),Y	;		JSR	SHOWCUR	;Show current cursor@1		EQU	*		JSR	UPDATE	;		BPL	@1	;Loop til done		RTS		;Done now exitB_SETWNDX		EQU	*		JSR	F_SETWND	;set 40 column width		BIT	RD80VID	;80 columns?		BPL	@1	;=>no, width ok		ASL	WNDWDTH	;make it 80@1		LDA	CV		STA	OURCV	;update OURCV		RTS* HANDLE RESET FOR MONITOR:B_RESETX		EQU	*		LDA	#$FF	;DESTROY MODE BYTE		STA	MODE		LDA	SETAN0	;AN0 = TTL low		LDA	SETAN1	;AN1 = TTL low		LDA	CLRAN2	;SETUP		LDA	CLRAN3	; ANNUNCIATORS		JSR	SETTEXT2REG	;Set textp2 shadowing reg first		LDA	#$08	;Disable super high res shadowing		TSB	SHADOW	;		RTS* READ MEMORY LOCATION AT (PCL),YREADPCY1		EQU	*		INY		;Next byte pleaseREADPCY		EQU	*		PHP		PHY		;Save 'X'/'Y' values		PHX		;		JSR	PCYTOA3	; let A3 = PC + Y		JSR	READBYTE		PLX		; restore value		PLY		;		PLPB_RDKEYXRTS	EQU	*		RTSB_RDKEYX		LDY	CH	;get cursor position		LDA	(BASL),Y	;and character		BIT	RD80VID	;80 columns?		BMI	B_RDKEYXRTS	;=>don't display cursor		JMP	SHOWCUR2	;else display cursor, exit