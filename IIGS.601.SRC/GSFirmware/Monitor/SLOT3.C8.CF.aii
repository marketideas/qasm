		TITLE	'$C800 Video Firmware';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 9:34:13 PM* This entry point is only used by Pascal 1.0* Maintained entry point $C800		JMP	PINIT1_0	;PASCAL 1.0 INIT* BASIC initialization:* This is called by the $C3 space only after a PR#3 or* the equivalent (a JSR $C300).* It causes a copy of the $F8 ROM to be placed in the* language card if the language card is switched in and* the ID byte doesn't match.  It sets up all the  * screenhole variables to support its operation.* Then it clears the screen and prints the character that* was in the accumulator upon entry.BASICINIT		EQU	*		JSR	COPYROM	;If LC in, copy F8 to it		JSR	C3HOOKS	;out=$C307, in=$C305 		JSR	DO40	;set full 40-col window		LDA	#$00	;Set 80 column cursor		STA	>CURSOR	;		LDA	#M_MOUSE	;init with mouse text off		STA	MODE	;Set BASIC video mode 		ASL	WNDWDTH	;Set 80-column window		STA	SET80COL	; and enable 80 store		STA	SET80VID	; and 80 video.* HOME & CLEAR:		STA	SETALTCHAR	;SET NORM/INV LCASE		JSR	X_FF	;CLEAR IT		LDY	OURCH	;set up cursor for store		BRA	BPRINT	;always print a characterC3HOOKS		LDA	#<BASICOUT	;set output hook first		STA	CSWL		LDA	#>C300		STA	CSWH* C3IN is called by IN#0 if CSWH = #$C3C3IN		LDA	#<BASICIN	;set input hook		STA	KSWL		LDA	#>C300		STA	KSWH		RTS		;exit with A=$C3 for IN#0 stuffGETKEY		INC	RNDL	;BUMP RANDOM SEED		BNE	@1		INC	RNDH@1		JSR	XRDKBD	;KEYPRESS?		BPL	GETKEY	;=>NOPE		RTS		DC.B	$C6,$CA,$C2***************************************** PASCAL 1.0 INPUT HOOK:****************************************		FillTo	$C84D	;Pad to next entry point* Maintained entry point $C84D		JMP	JPREAD	;=>GO TO STANDARD READ* BIN and BOUT are used when characters are* input and output by the $F8 ROM while 80VID* is on.  They cannot use the $C3 entry points* because that switches in the $C8 space, causing* possible conflict with other $C8 users.* These routines are only called by the Monitor space.* These entry points will only work if the card was* first initialized using a PR#3.  80 columns will not* work simply by turning on the 80VID flag.BOUT		LDY	YSAV1	;load Y stuffed by $F8 ROM		CLC		;signal an output 		OPCODE	BCS	;skip SECBIN		SEC		;signal an input		STA	CHAR	;save the char		PHY		;save Y		PHX		;save XC8BASIC		EQU	*	;BASIC IN/OUT		BCS	BINPUT	;=>input a character		EJECT* This is the place where characters printed using the* CSW hook are actually printed (or executed if they are* control characters).BPRINT		JSR	CSETUP	;setup user cursor		LDA	CHAR	;GET CHARACTER		CMP	#$8D	;IS IT C/R?		BNE	@2	;=>don't wait, OURCH ok 		LDX	KBD	;IS KEY PRESSED?		BPL	@2	;NO		CPX	#$93	;IS IT CTL-S?		BNE	@2	;NO, IGNORE IT		BIT	KBDSTRB	;CLEAR STROBE@1		EQU	*		LDX	KBD	;WAIT FOR NEXT KEYPRESS		BPL	@1		CPX	#$83	;IF CTL-C, LEAVE IT		BEQ	@2	; IN THE KBD BUFFER		BIT	KBDSTRB	;CLEAR OTHER CHARACTER@2		EQU	*		XBA		;Preserve 'A' during test		LDA	>CHGCURFLG	;'+'/'-' no change / change cursor		BPL	@22	;		XBA		;Recall new cursor character		STA	>CURSOR	;New cursor		LDA	#$01	;Reset flag		STA	>CHGCURFLG	;		CLC		;Save done OK		BRA	@4	;Exit normally@22		EQU	*		XBA		;Restore original 'A' value		AND	#$7F	;drop possible hi bit		CMP	#$20	;IS IT CONTROL CHAR? 		BCS	@3	;=>NOPE		JSR	CTLCHAR0	;execute CTL if M_CTL ok		BRA	@4	;=>enable ctl chrs* NOT A CTL CHAR. PRINT IT.@3		EQU	*		LDA	CHAR	;get char (all 8 bits)		JSR	STORCH	;and display it* BUMP THE CURSOR HORIZONTAL:		INY		;bump it 		STY	OURCH	;are we past the 		CPY	WNDWDTH	; end of the line?		BCC	@4	;=>NO, NO PROBLEM		JSR	X_CR	;YES, DO C/R * M_CTL is set by RDCHAR and cleared here, after each* character is displayed.@4		EQU	*	;enable printing of control chars		LDA	#M_CTL		TRB	MODEBIORET		LDA	OURCH	;get newest cursor position		BIT	RD80VID	;IN 80-MODE?		BPL	@1	;=>no, set other cursors 		LDA	#0	;pin CH to 0 for 80 columns@1		STA	CH		STA	OLDCH	;REMEMBER THE SETTING		PLX		;RESTORE		PLY		;X AND Y		LDA	CHAR		RTS		;RETURN TO BASIC		EJECT* BASIC input entry point called by entry point in the* $C3 space.  This is the way things normally happen.BINPUT		EQU	*		LDY	CH		LDA	CHAR		STA	(BASL),Y		JSR	CSETUP	;get newest cursorBINPUT4		EQU	*		JSR	SHOWCUR	;Show current cursor@1		EQU	*		JSR	UPDATE	;Flash and loop for key		BPL	@1	;		STA	CHAR	;Save character for other routines		TAY		;preserve acc.* On pure input, an uninterpreted character code should* be returned.  If M_CTL is set, however, escape functions* are enabled, and CTL-U causes the character under the* cursor to be picked up from the screen.* M_CTL is set whenever a character is requested using* RDCHAR in the $F8 ROM.		LDA	MODE	;is escape mode enabled?		AND	#M_CTL		BEQ	BIORET	;=>no,return 		CPY	#$8D	;was it a CR		BNE	@2	;=>nope, not a CR		LDA	#M_CTL	;else end of line...  		TRB	MODE	; disable escape @2		EQU	*		CPY	#$9B	;ESCAPE KEY?		BEQ	ESCAPING	;=>YES IT IS* Not an escape sequence.  Check for control-u.		CPY	#$95	;is it control-U?		BNE	BIORET	;no, return to caller		JSR	PICKY	;Pick up the char		ORA	#$80	;always pick as normal		STA	CHAR	;save keystroke		BNE	BIORET	;=>(always) return to caller		EJECT* Start an escape sequence.  If the next character * pressed is one of the following, it is executed. * Otherwise it is ignored.**    @ - home & clear *    E - clear to end of line *    F - clear to end of screen *    I - move cursor up *    J - move cursor left *    K - move cursor right *    M - move cursor down *    4 - enter 40 column mode *    8 - enter 80 column mode * CTL-D- disable the printing of control characters* CTL-E- enable the printing of control characters* CTL-Q- quit (PR#0/IN#0)*   The four arrow keys (as IJKM)ESCAPING		EQU	*		JSR	ESCON	;ESCAPE CURSOR ON		JSR	GETKEY	;GET ESCAPE FUNCTION		JSR	ESCOFF	;REPLACE ORIGINAL CHARACTER		JSR	UPSHFT	;upshift the char		AND	#$7F	;DROP HI BIT		LDY	#ESCNUM-1	;COUNT/INDEX@1		CMP	ESCTAB,Y	;IS IT A VALID ESCAPE?		BEQ	@2	;=>YES		DEY		BPL	@1	;TRY 'EM ALL...		BMI	@3	;=>MAYBE IT'S A SPECIAL ONE@2		EQU	*		LDA	ESCCHAR,Y	;GET CHAR TO "PRINT"		AND	#$7F	;DROP HI BIT (FLAG)		JSR	CTLCHAR	;EXECUTE IT		LDA	ESCCHAR,Y	;GET FLAG		BMI	ESCAPING	;=>STAY IN ESCAPE MODE		BPL	BINPUT4	;=>QUIT ESCAPE MODE@3		EQU	*		TAY		;put char here		LDA	MODE	;so we can put this here		CPY	#$11	;was it Quit?		BNE	@4	;=>no 		JSR	X_NAK	;do the quitting stuff		LDA	#$98	;make it look like		STA	CHAR	;CTL-X was pressed		JMP	BIORET	;=>quit the card forever@4		CPY	#$05	;was it CTL-E for enable		BNE	@5	;=>no		AND	#255-M_CTL2	;yes, enable ctl chars@6		STA	MODE	;save new mode@7		BRA	BINPUT4	;=> exit escape mode@5		CPY	#$04	;was it CTL-D for disable		BNE	@7	;=>no, exit escape mode		ORA	#M_CTL2	;disable ctl chars		BNE	@6	;=> exit escape mode* This table contains the control characters which, * when executed, carry out the escape functions. If* the high bit of the character is set, it means that* escape mode should not be exited after execution of* the character.ESCCHAR		EQU	*		DC.B	$0C	;@: FORMFEED 		DC.B	$1C	;A: FS		DC.B	$08	;B: BS		DC.B	$0A	;C: LF		DC.B	$1F	;D: US		DC.B	$1D	;E: GS 		DC.B	$0B	;F: VT 		DC.B	$1F+$80	;I: US (STAY ESC) 		DC.B	$08+$80	;J: BS (STAY ESC) 		DC.B	$1C+$80	;K: FS (STAY ESC) 		DC.B	$0A+$80	;M: LF (STAY ESC) 		DC.B	$11	;4 :DC1 		DC.B	$12	;8 :DC2 		DC.B	$08+$80	;<-:BS (STAY ESC) 		DC.B	$0A+$80	;DN:LF (STAY ESC) 		DC.B	$1F+$80	;UP:US (STAY ESC) 		DC.B	$1C+$80	;->:FS (STAY ESC)		MSB	OFF	;high bit already maskedESCTAB		EQU	*		DC.B	'@'		DC.B	'A'	;HANDLE OLD ESCAPES		DC.B	'B'		DC.B	'C'		DC.B	'D'		DC.B	'E'		DC.B	'F'		DC.B	'I'		DC.B	'J'		DC.B	'K'		DC.B	'M'		DC.B	'4'		DC.B	'8'		DC.B	$08	;LEFT ARROW		DC.B	$0A	;DOWN ARROW		DC.B	$0B	;UP   ARROW		DC.B	$15	;RIGHT ARROWESCNUM		EQU	*-ESCTAB		MSB	ON* CSETUP compensates for everything that the user * can do to change the cursor status: poke CV, CH,* OURCH, WNDWDTH.  It updates the video firmware's * versions of these values for its own use.* COPY USER'S CURSOR IF IT DIFFERS FROM*  WHAT WE LAST PUT THERE:CSETUP		LDY	CV	;set up OURCV		STY	OURCV* ON CURSORS.  Whenever the horizontal cursor position is* needed, a call to GETCUR is done. This is the equivalent* of a LDY CH.  This returns the current cursor for II and* //e mode, which may have been poked as either CH or OURCH.* It also forces CH and OLDCH to 0 if 80 column mode active.* This prevents LDY CH, STA (BASL),Y from trashing non screen* memory. It works just like the //e. * All routines that update the cursor's horizontal position* are here.  This ensures that the newest value of the cursor* is always used, and that 80 column CH is always 0.* GETCUR only affects the Y registerGETCUR		LDY	CH	;if CH=OLDCH, then		CPY	OLDCH	;OURCH is valid		BNE	@1	;=>else CH must have been changed		LDY	OURCH	;use OURCH@1		CPY	WNDWDTH	;is the value too big 		BCC	GETCUR2	;=>no, fits just fine		LDY	#0	;else force CH to 0* GETCUR2 is commonly used to set the current cursor* position when Y can be used.GETCUR2		EQU	*		STY	OURCH	;update real cursor		BIT	RD80VID	;80 columns?		BPL	@3	;=>no, set all cursors		LDY	#0	;yes, peg CH to 0@3		STY	CH		STY	OLDCH		LDY	OURCH	;get cursor		RTS		;and fly...* DECCHFF decrements the current cursorDECCHFF		EQU	*		JSR	GETCUR	;Get current CH		DEY		;Decrement itDECCHFF2		EQU	*		JSR	GETCUR2	;Save new CH		TYA		; and get new CH into 'A'		RTS		;Back to callerWDTCHFF		EQU	*		DEC	A	;Dec window width		TAY		;'Y' = new cursor position		BRA	DECCHFF2	;Continue this way		EJECT***************************************** PASCAL 1.0 OUTPUT HOOK:****************************************		FillTo	$C9AA	;Pad to next entry point* Maintained entry point $C9AA		LDA	CHAR	;GET OUTPUT CHARACTER		JMP	JPWRITE	;=>USE STANDARD WRITE***************************************** PASCAL INITIALIZATION:* Disable printing of mouse text****************************************PINIT1_0		EQU	*		LDA	#M_PASCAL+M_PAS1_0+M_MOUSE		BNE	PINIT2	;=>alwaysPINIT		EQU	*		LDA	#M_PASCAL+M_MOUSE	;SAY WE'REPINIT2		EQU	*		STA	MODE	; and save it		STA	SET80COL	;ENABLE 80 STORE		STA	SET80VID	; AND 80 VIDEO		STA	SETALTCHAR	;NORM+INV LCASE		LDA	#$00	;Set up inverse cursor		STA	>CURSOR	;		JSR	PSETUP	;set window and cursor 		JSR	X_FF	;HOME & CLEAR IT		BRA	DOBASL	;fix OLDBASL/H, display cursor, exit***************************************** PASCAL INPUT:** Character always returned with high bit clear.*****************************************PASCALREAD	EQU	*		JSR	PSETUP	;SETUP ZP STUFF		JSR	GETKEY	;GET A KEYSTROKE		AND	#$7F	;DROP HI BIT		STA	CHAR	;SAVE THE CHAR		LDX	#0	;IORESULT='GOOD'		LDA	MODE	;ARE WE IN 1.0-MODE?		AND	#M_PAS1_0		BEQ	@1	;=>NOPE		LDX	#>C300	;YES, RETURN CN IN X @1		EQU	*		LDA	CHAR	;RESTORE CHAR		RTS* PASCAL OUTPUT:* Note:  to be executed, control characters must have* their high bits cleared.  All other characters are* displayed regardless of their high bits.PWRITE		EQU	*		AND	#$7F	;clear high bits		TAX		;save character		JSR	PSETUP	;SETUP ZP STUFF, don't set ROM 		LDA	#M_GOXY	;ARE WE DOING GOTOXY?		BIT	MODE		BNE	GETX	;=>Doing X or Y?		TXA		;now check for control char		BIT	PRTS	;is it control?		BEQ	PCTL	;=>yes, do control		LDY	OURCH	;get horizontal position		BIT	INVFLG	;check for inverse		BPL	@1	;inverse, go store it		ORA	#$80@1		JSR	PSTORY	;now store it (erasing cursor)		INY		;INC CH 		STY	OURCH		CPY	WNDWDTH		BCC	DOBASL		STZ	OURCH	;do carriage return		JSR	X_LF	;and linefeed DOBASL		LDA	BASL	;save BASL for pascal		STA	OLDBASL		LDA	BASH		STA	OLDBASHPWRITERET		JSR	PASINV	;display new cursor		LDX	#$0	;return with no errorPRTS		RTS*  HANDLE GOTOXY STUFF:GETX		JSR	PASINV	;turn off cursor		TXA		;get character 		SEC		SBC	#32	;MAKE BINARY		BIT	XCOORD	;doing X?		BMI	PSETX	;=>yes, set it* Set Y and do the GOTOXY 		STA	OURCV	;Do GETY		STA	CV		JSR	BASCALCC	;calc base addr 		LDA	XCOORD		STA	OURCH	;set cursor horizontal		LDA	#255-M_GOXY	;turn off gotoxy 		AND	MODE		STA	MODE		BNE	DOBASL	;=>DONE (ALWAYS TAKEN) PCTL		JSR	PASINV	;turn off cursor		TXA		;get char		CMP	#$1E	;is it gotoXY?		BEQ	STARTXY	;=>yes, start it up		JSR	CTLCHAR	;EXECUTE IT IF POSSIBLE		BRA	DOBASL	;=>update BASL/H, cursor, exit * START THE GOTOXY SEQUENCE: STARTXY		EQU	*		LDA	#M_GOXY		TSB	MODE	;turn on gotoxy		LDA	#$FF	;set XCOORD to -1PSETX		STA	XCOORD	;set X		BRA	PWRITERET	;=>display cursor and exit		EJECT* Do the normal monitor ROM BASCALCCBASCALCC		EQU	*		PHA		LSR	A		AND	#$03		ORA	#$04		STA	BASH		PLA		AND	#$18		BCC	@1		ADC	#$7F@1		STA	BASL		ASL	A		ASL	A		ORA	BASL	;Done this way since some programs		STA	BASL	; depend on BASL on exit.		RTS***************************************** NAME    : CTLCHAR0 * FUNCTION: Execute CTL char if M_CTL=0 * INPUT   : AC=CHAR * OUTPUT  : 'BCS' if not executed *         : 'BCC' if executed* VOLATILE: NOTHING* CALLS   : MANY THINGS ****************************************CTLCHAR0		SEP	#$40	;set V (use M_CTL) 		OPCODE	BVC	;skip CLV ***************************************** NAME    : CTLCHAR* FUNCTION: Always execute CTL char * INPUT   : AC=CHAR* OUTPUT  : 'BCS' if not executed *         : 'BCC' if ctl executed * VOLATILE: NOTHING* CALLS   : MANY THINGS ****************************************CTLCHAR		CLV		;clear V (ignore M_CTL)		STA	TEMP1	;TEMP SAVE OF CHAR		PHA		;SAVE AC		PHY		;SAVE Y		LDY	TEMP1	;GET CHAR IN QUESTION		CPY	#$05	;IS IT NUL..EOT?		BCC	@3	;=>YES, NOT USED		LDA	CTLADH-5,Y	;Get high byte of address 		BEQ	@3	;=>ctl not implemented		BVC	@20	;=> CLTCHAR: always execute		BMI	@20	;=>CR,BEL,LF,BS always done		STA	TEMP1	;save high byte of address		LDA	MODE	;if control chars		AND	#M_CTL+M_CTL2	;are enabled		BEQ	@2	;=>then go do them@3		EQU	*		SEC		;SAY 'NOT CTL'		BCS	@4	;=>DONE@2		LDA	TEMP1	;get address back@20		EQU	*		ORA	#$80	;hi bit always set		JSR	@5	;EXECUTE SUBROUTINE		CLC		;SAY 'CTL CHAR EXECUTED'@4		EQU	*		PLY		;Restore Y		PLA		;  and A		RTS@5		EQU	*		PHA		;PUSH ONTO STACK FOR 		LDA	CTLADL-5,Y	; TRANSFER TRICK		PHA		RTS		;XFER TO ROUTINE* Turn cursor on for Pascal onlyX_CUR_ON		LDA	MODE	;get mode byte		BPL	CURON_X	;=>not pascal, don't do it		AND	#255-M_CURSOR	;clear cursor bitSAVCUR		STA	MODE	;save itCURON_X		RTS		;and exit* Turn cursor off for Pascal only.* Cursor is not displayed during call.X_CUR_OFF		LDA	MODE	;get mode byte		BPL	CURON_X	;=>not pascal, don't do it		ORA	#M_CURSOR	;turn on cursor bit		BNE	SAVCUR	;save and exit* EXECUTE BELLC:X_BELLC		EQU	*		LDA	STATEREG	;Save where we are		PHA		; on stack for later.		ORA	#$08	;Map in monitor ROM		STA	STATEREG	;		JSR	BELL1	;Call monitor regular bell routine		PLA		;Restore memory state of machine		STA	STATEREG	;		RTS		;Back to caller* EXECUTE BACKSPACE:X_BS		EQU	*		DEC	OURCH	;BACK UP CH		BPL	@1	;=>DONE		LDA	WNDWDTH	;BACK UP TO PRIOR LINE		STA	OURCH	;SET CH		DEC	OURCH		JSR	X_US	;NOW DO REV LINEFEED@1		EQU	*		RTS* EXECUTE CARRIAGE RETURN:X_CR		EQU	*		STZ	OURCH	;Back up CH to beginning of line		LDA	MODE	;ARE WE IN BASIC?		BPL	X_LF	;EXECUTE AUTO LF FOR BASIC		RTS		;Fall here if Pascal, avoid auto LF* EXECUTE HOME:X_EM		EQU	*		LDA	WNDTOP		STA	CV		STZ	OURCH	;STUFF CH		JMP	VTABC	;set base for OURCV* EXECUTE FORWARD SPACE:X_FS		EQU	*		INC	OURCH	;BUMP CH		LDA	OURCH	;GET THE POSITION		CMP	WNDWDTH	;OFF THE RIGHT SIDE?		BCC	@1	;=>NO, GOOD		JSR	X_CR	;=>YES, WRAP AROUND@1		EQU	*		RTS* EXECUTE REVERSE LINEFEED:X_US		LDA	WNDTOP	;are we at top?		CMP	CV		BCS	X_USRET	;=>yes, stay there		DEC	CV	;else go up a line		JMP	VTABC	;exit thru VTABC (update OURCV)* EXECUTE "NORMAL VIDEO" X_SO		EQU	*		LDA	MODE	;SET MODE BIT		BPL	@1	;don't set mode for BASIC		AND	#255-M_VMODE	;SET 'NORMAL'@1		LDY	#255		BNE	STUFFINV	;(ALWAYS)* EXECUTE "INVERSE VIDEO" X_SI		EQU	*		LDA	MODE	;SET MODE BIT		BPL	@1	;don't set mode for BASIC		ORA	#M_VMODE	;SET 'INVERSE'@1		LDY	#127STUFFINV		STA	MODE	;SET MODE		STY	INVFLG	;STUFF FLAG TOOX_USRET		RTS* Enable change cursor mode.X_CHCUR		EQU	*		LDA	#$81	;Set change cursor flag '-'		STA	>CHGCURFLG	;		RTS		; and then exit.CTLADL		EQU	*		DC.B	X_CUR_ON-1	;ENQ    (Control-E)		DC.B	X_CUR_OFF-1	;ACK   (Control-F)		DC.B	X_BELLC-1		;BEL    (Control-G)		DC.B	X_BS-1		;BS     (Control-H)		DC.B	0		;HT     (Control-I)		DC.B	X_LF-1		;LF     (Control-J)		DC.B	X_VT-1		;VT     (Control-K)		DC.B	X_FF-1		;FF     (Control-L)		DC.B	X_CR-1		;CR     (Control-M)		DC.B	X_SO-1		;SO     (Control-N)		DC.B	X_SI-1		;SI     (Control-O)		DC.B	0		;DLE    (Control-P)		DC.B	X_DC1-1		;DC1    (Control-Q)		DC.B	X_DC2-1		;DC2    (Control-R)		DC.B	0		;DC3    (Control-S)		DC.B	0		;DC4    (Control-T)		DC.B	X_NAK-1		;NAK    (Control-U)		DC.B	SCROLLDN-1	;SYN    (Control-V)		DC.B	SCROLLUP-1	;ETB    (Control-W)		DC.B	MOUSEOFF-1	;CAN    (Control-X)		DC.B	X_EM-1		;EM     (Control-Y)		DC.B	X_SUB-1		;SUB    (Control-Z)		DC.B	MOUSEON-1		;       (Control-[)		DC.B	X_FS-1		;FS     (Control-\)		DC.B	X_GS-1		;GS     (Control-Shift-M or Control-])		DC.B	X_CHCUR-1		;RS     (Control-^)		DC.B	X_US-1		;US     (Control-_)CTLADH		EQU	*		DC.B	X_CUR_ON-$8001>>8	;ENQ	(Control-E)		DC.B	X_CUR_OFF-$8001>>8	;ACK	(Control-F)		DC.B	X_BELLC-1>>8	;BEL      (Control-G)		DC.B	X_BS-1>>8		;BS       (Control-H)		DC.B	0		;HT       (Control-I)		DC.B	X_LF-1>>8		;LF       (Control-J)		DC.B	X_VT-$8001>>8	;VT       (Control-K)		DC.B	X_FF-$8001>>8	;FF       (Control-L)		DC.B	X_CR-1>>8		;CR	(Control-M)		DC.B	X_SO-$8001>>8	;SO	(Control-N)		DC.B	X_SI-$8001>>8	;SI	(Control-O)		DC.B	0		;DLE	(Control-P)		DC.B	X_DC1-$8001>>8	;DC1	(Control-Q)		DC.B	X_DC2-$8001>>8	;DC2	(Control-R)		DC.B	0		;DC3      (Control-S)		DC.B	0		;DC4      (Control-T)		DC.B	X_NAK-$8001>>8	;NAK	(Control-U)		DC.B	SCROLLDN-$8001>>8	;SYN	(Control-V)		DC.B	SCROLLUP-$8001>>8	;ETB	(Control-W)		DC.B	MOUSEOFF-$8001>>8	;CAN	(Control-X)		DC.B	X_EM-$8001>>8	;EM       (Control-Y)		DC.B	X_SUB-$8001>>8	;SUB	(Control-Z)		DC.B	MOUSEON-$8001>>8	;	(Control-[)		DC.B	X_FS-$8001>>8	;FS       (Control-\)		DC.B	X_GS-$8001>>8	;GS       (Control-Shift-M or Control-])		DC.B	X_CHCUR>>8	;RS       (Control-^)		DC.B	X_US-$8001>>8	;US       (Control-_)		EJECT* SCROLLIT scrolls the screen either up or down, depending* on the value of X.  It scrolls within windows with even * or odd edges for both 40 and 80 columns.  It can scroll* windows down to 1 characters wide.SCROLLDN		LDY	#0	;direction = down		BEQ	SCROLLIT	;=>go do scroll* EXECUTE LINEFEED:X_LF		EQU	*		INC	CV		LDA	CV	;SEE IF OFF BOTTOM		STA	OURCV		CMP	WNDBTM	;OFF THE END?		BCS	@1	;=>yes, scroll screen 		JMP	VTABCZ	;exit thru VTABCZ@1		EQU	*		DEC	OURCV	;back up to bottom		DEC	CV	;and fall into scroll SCROLLUP		LDY	#1	;direction = upSCROLLIT		EQU	*		LDA	CYAREG	;Save system speed		PHA		;		ORA	#$80	; then go to hi speed mode for scroll		STA	CYAREG	;		JSR	@1	;Do regular scroll routines		PLA		; then restore user speed		STA	CYAREG	;		RTS		;Back to caller@1		EQU	*		PHX		;Save 'X'		STY	TEMP1	;save direction		LDA	WNDWDTH	;get width of screen window		PHA		;save original width		BIT	RD80VID	;in 40 or 80 columns?		BPL	@4	;=>40, determine starting line		STA	SET80COL	;make sure this is enabled		LSR	A	;divide by 2 for 80 column index		TAX		;and save		LDA	WNDLFT	;test oddity of right edge		LSR	A	;by rotating low bit into carry		CLV		;V=0 if left edge even		BCC	@2	;=>check right edge		SEP	#$40	;V=1 if left edge odd@2		ROL	A	;restore WNDLFT		EOR	WNDWDTH	;get oddity of right edge		LSR	A	;C=1 if right edge even 		BVS	@3	;if odd left, don't DEY		BCS	@3	;if even right, don't DEY		DEX		;if right edge odd, need one less@3		STX	WNDWDTH	;save window width		LDA	RD80VID	;N=1 if 80 columns@4		PHP		;save N,Z,V		LDX	WNDTOP	;assume scroll from top		TYA		;up or down?		BNE	@5	;=>up		LDX	WNDBTM	;down, start scrolling at bottom		DEX		;really need one less@5		TXA		;get current line		JSR	VTABCZ	;calculate base with window width@6		LDA	BASL	;current line is destination  		STA	BAS2L		LDA	BASH		STA	BAS2H		LDA	TEMP1	;test direction		BEQ	@44	;=>do the downer		INX		;do next line		CPX	WNDBTM	;done yet?		BCS	@55	;=>yup, all done@7		TXA		;set new line		JSR	VTABCZ	;get base for new current line		LDY	WNDWDTH	;get width for scroll 		PLP		;get status for scroll		PHP		;N=1 if 80 columns 		BPL	@8	;=>only do 40 columns		LDA	TXTPAGE2	;scroll aux page first (even bytes)		TYA		;test Y		BEQ	@11	;if Y=0, only scroll one byte@9		LDA	(BASL),Y		STA	(BAS2L),Y		DEY		BNE	@9	;do all but last even byte@11		BVS	@22	;odd left edge, skip this byte 		LDA	(BASL),Y		STA	(BAS2L),Y@22		LDA	TXTPAGE1	;now do main page (odd bytes)		LDY	WNDWDTH	;restore width 		BCS	@8	;even right edge, skip this byte@33		LDA	(BASL),Y		STA	(BAS2L),Y@8		DEY		BPL	@33		BMI	@6	;=> always scroll next line@44		DEX		;do next line		CPX	WNDTOP	;done yet		BPL	@7	;=>nope, not yet@55		PLP		;pull status off stack		PLA		;restore window width		STA	WNDWDTH		JSR	X_SUB	;clear current line		JSR	VTABC	;restore original cursor line		PLX		;and X		RTS		;done!!!* EXECUTE CLR TO EOS:X_VT		JSR	X_GS	;CLEAR TO EOL		LDA	CV	;SAVE CV		PHA		BPL	@1	;DO NEXT LINE (ALWAYS TAKEN) @2		JSR	VTABCZ	;set base address 		JSR	X_SUB	;CLEAR LINE@1		INC	CV		LDA	CV		CMP	WNDBTM	;OFF SCREEN?		BCC	@2	;=>NO, KEEP GOING		PLA		;RESTORE		STA	CV	; CV		JMP	VTABC	;return via VTABC (blech)* EXECUTE CLEAR:X_FF		EQU	*		JSR	X_EM	;HOME THE CURSOR		BRA	X_VT	;RETURN VIA CLREOS (UGH!) * EXECUTE CLEAR LINEX_SUB		LDY	#0	;start at left		BEQ	X_GSEOLZ	;and clear to end of line* EXECUTE CLEAR TO EOL:X_GS		LDY	OURCH	;get CHX_GSEOLZ		LDA	INVFLG	;mask blank		AND	#$80	;with high bit of invflg		ORA	#$20	;make it a blank		BIT	RD80VID	;is it 80 columns?		BMI	CLR80	;=>yes do quick clearCLR40		STA	(BASL),Y		INY		CPY	WNDWDTH		BCC	CLR40		RTS* Clear right half of screen for 40 to 80* screen conversionCLRHALF		PHX		;save X		LDX	#$D8	;set horizontal counter		LDY	#20		LDA	INVFLG	;set (inverse) blank		AND	#$A0		BRA	CLR2* Clear to end of line for 80 columnsCLR80		PHX		;save X		PHA		;and blank		TYA		;get count for CH		PHA		;save for left edge check		SEC		;count=WNDWDTH-Y-1		SBC	WNDWDTH		TAX		;save CH counter		TYA		;div CH by 2 for half pages		LSR	A		TAY		PLA		;restore original ch		EOR	WNDLFT	;get starting page		ROR	A		BCS	@1		BPL	@1		INY		;if WNDLFT odd, starting byte odd@1		PLA		;get blank		BCS	CLR1	;starting page is 1 (default)CLR2		BIT	TXTPAGE2	;else do page 2		STA	(BASL),Y		BIT	TXTPAGE1	;now do page 1		INX		BEQ	CLR3	;all doneCLR1		STA	(BASL),Y		INY		;forward 2 columns		INX		;next ch		BNE	CLR2	;not done yetCLR3		PLX		;restore X		SEC		;good exit condition		RTS		;and return* EXECUTE '40COL MODE':X_DC1		EQU	*		LDA	MODE	;don't convert if Pascal		BMI	X_DC1RTS	;=>it's PascalX_DC1A		JSR	SETTOP	;set top of window (0 or 20)		BIT	RD80VID	;are we in 80 columns?		BPL	X_DC1B	;=>no, no convert needed		JSR	SCRN84	;else convert 80 to 40		BCC	X_DC1B	;=>always set new window* Set 80 column modeX_DC2		EQU	*		BIT	RD80VID	;are we in 40 columns?		BMI	X_DC1B	;=>no, no convert needed		JSR	SCRN48	;else convert 40 to 80X_DC1B		LDA	OURCH	;get cursor		CLC		;since new window left = 0		ADC	WNDLFT	;NEWCH=OLDCH+OLDWNDLFT		BIT	RD80VID	;in 80 columns?		BMI	@2	;=>yes, CH is ok		CMP	#40	;else if CH is too big,		BCC	@2	;set it to 39		LDA	#39@2		STA	OURCH	;save new CH		STA	CH		LDA	CV	;base		JSR	BASCALCC		BIT	RD80VID	;in 80 columns?		BPL	DO40	;=>no, set forty column window		JSR	FULL80	;set 80 column window		BRA	SETTOP	;=>always branchDO40		JSR	FULL40	;set 40 column windowSETTOP		LDA	#0	;assume normal window		BIT	RDTEXT	;text or mixed?		BMI	@1	;=>text, all ok		LDA	#20@1		STA	WNDTOP	;set new topX_DC1RTS		RTS* EXECUTE MOUSE TEXT OFFMOUSEOFF		LDA	#M_MOUSE	;Set mouse bit		TSB	MODE	;		RTS		;to disable mouse chars* EXECUTE MOUSE TEXT ONMOUSEON		LDA	#M_MOUSE	;Reset mouse bit		TRB	MODE	;		RTS		;to enable mouse chars* EXECUTE 'QUIT':X_NAK		EQU	*		LDA	MODE	;ONLY VALID IN BASIC		BMI	SKRTS	;ignore if pascalX_NAK2		EQU	*		JSR	DO40	;force 40 column window		JSR	QUIT	;do stuff used by PR#0		JSR	SETCOUT1	;set output hookSETKEYIN		LDA	#>KEYIN	;set input hook		STA	KSWH		LDA	#<KEYIN		STA	KSWL		RTSSETCOUT1		LDA	#>COUT1	;set output hook		STA	CSWH		LDA	#<COUT1		STA	CSWLSKRTS		RTS***************************************** NAME    : FULL40* FUNCTION: SET FULL 40COL WINDOW* INPUT   : NONE* OUTPUT  : WINDOW PARAMETERS, A=0 * VOLATILE: AC****************************************FULL40		EQU	*		LDA	#40	;set window width to 40		BNE	SAVWDTH	;=>(always taken)***************************************** NAME    : FULL80 * FUNCTION: SET FULL 80COL WINDOW* INPUT   : NONE* OUTPUT  : WINDOW PARAMETERS, A=0 * VOLATILE: AC****************************************FULL80		LDA	#80	;set full 80 column windowSAVWDTH		STA	WNDWDTH		LDA	#24		STA	WNDBTM		STZ	WNDTOP		STZ	WNDLFT		LDA	#$00	;MUST exit with 'A'=0		RTS* QUIT is used by PR#0 to turn off everythingQUIT		EQU	*		BIT	RD80VID	;were we in 80 columns?		BPL	QUIT2	;=> not a chance		JSR	X_DC1A	;switch to 40 columnsQUIT2		STA	CLRALTCHAR	;don't use lower case 		LDA	#$FF	;DESTROY THE		STA	MODE	; MODE BYTE		STA	>CURSOR	;Set checkerboard cursor		RTS* SCRN84 and SCRN48 convert screens between 40 & 80 cols.* WNDTOP must be set up to indicate the last line to* be done.  All registers are trashed.SCRN84		EQU	*		PHX		;Save 'X'		LDX	#23	;start at bottom of screen		STA	SET80COL	;allow page 2 access@1		TXA		;calc base for line		JSR	BASCALCC		LDY	#39	;start at right of screen@2		STY	BAS2L	;save 40 index		TYA		;div by 2 for 80 column index		LSR	A		BCS	@3		BIT	TXTPAGE2	;even column, do page 2@3		TAY		;get 80 index		LDA	(BASL),Y	;get 80 char 		BIT	TXTPAGE1	;restore page1		LDY	BAS2L	;get 40 index		STA	(BASL),Y		DEY		BPL	@2	;do next 40 byte		DEX		;do next line		BMI	@4	;=>done with setup		CPX	WNDTOP	;at top yet? 		BCS	@1@4		STA	CLR80COL	;clear 80STORE for 40 columns		STA	CLR80VID	;clear 80VID for 40 columns		BRA	SCRNRET	;calc base, restore X, exitSCRN48		EQU	*	;		PHX		;Save X		LDX	#23	;start at bottom of screen@5		TXA		;set base for current line		JSR	BASCALCC		LDY	#0	;start at left of screen		STA	SET80COL	;enable page2 store@6		LDA	(BASL),Y	;get 40 column char		STY	BAS2L	;save 40 column index		PHA		;save char		TYA		;div 2 for 80 column index		LSR	A		BCS	@7	;save on page1		STA	TXTPAGE2@7		TAY		;get 80 column index		PLA		;now save character		STA	(BASL),Y		STA	TXTPAGE1	;flip page1		LDY	BAS2L	;restore 40 column index		INY		;move to the right		CPY	#40	;at right yet?		BCC	@6	;=>no, do next column		JSR	CLRHALF	;clear half of screen		DEX		;else do next line of screen		BMI	@9	;=>done with top line		CPX	WNDTOP	;at top yet?		BCS	@5@9		STA	SET80VID	;convert to 80 columnsSCRNRET		JSR	VTABC	;update base		PLX		;restore X		RTSVTABC		LDA	CV	;get 80 column CV		STA	OURCV	;copy to OURCVVTABCZ		JSR	BASCALCC	;calc base address		LDA	WNDLFT	;and add window left to it		BIT	RD80VID	;is it 80 columns?		BPL	@1	;window width ok		LSR	A	;else divide width by 2@1		CLC		;prepare to add		ADC	BASL	;add in window left		STA	BASL	;and update base		RTS		;and exit		EJECTUPSHFT		CMP	#$E1	;is it lowercase?		BCC	@2	;=>nope		CMP	#$FB	;lowercase?		BCS	@2	;=>nope		AND	#$DF	;else upshift@2		RTS***************************************** NAME    : PICKY* FUNCTION: GET A CHAR FROM SCREEN* INPUT   : Y=CH POSITION * OUTPUT  : AC=CHARACTER* VOLATILE: NOTHING* CALLS   : SCREENIT ****************************************PICKY		EQU	*		PHY		;Save 'Y' register value		JSR	GETCUR	;Get newest cursor into 'Y'		OPCODE.zpg LDA	;Skip next PHYPPICKY		EQU	*		PHY		;Save 'Y' register valuePPICKY2		EQU	*		LDA	(BASL),Y	;get 40 column character		BIT	RD80VID	;80 columns?		BPL	@3	;=>no, do text shift 		STA	SET80COL	;force 80STORE for 80 columns 		TYA		;divide CH by two		EOR	WNDLFT	;C=1 if char in main RAM		ROR	A	;get low bit into carry		BCS	@1	;=>store in main memory		LDA	TXTPAGE2	;else switch in page 2		INY		;for odd left, aux bytes@1		TYA		;divide position by 2		LSR	A	;and use carry as		TAY		;page indicator		LDA	(BASL),Y	;get that char		BIT	TXTPAGE1	;flip to page 1@3		BIT	ALTCHARSET	;only allow mouse text		BPL	@4	;if alternate character set		CMP	#$20		BCS	@4		ORA	#$40@4		EQU	*		PLY		;Restore entry 'Y' value		RTS***************************************** NAME    : STORCH* FUNCTION: STORE A CHAR ON SCREEN* INPUT   : AC=CHAR *         :  Y=CH POSITION* OUTPUT  : CHAR ON SCREEN* VOLATILE: NOTHING* CALLS   : Exits into STOR2****************************************STORCH		EQU	*		PHA		;Save 'A'		JSR	@1	;Come back to here to restore 'A'		PLA		;		RTS		; then go back to caller.@1		EQU	*		BIT	INVFLG	;NORMAL OR INVERSE?		BMI	STORY	;=>NORMAL		AND	#$7F	;inverse it***************************************** NAME    : STORY * FUNCTION: STORE CHAR* INPUT   : AC=char for store*         :  Z=high bit of char*         :  Y=CH POSITION* OUTPUT  : AC=CHAR (PICK) * VOLATILE: NOTHING * CALLS   : NOTHING ****************************************STORY		EQU	*		PHA		;Save character		JSR	GETCUR	;Put newest cursor pstn into 'Y'		BRA	PSTORY2	;Skip PHAPSTORY		EQU	*		PHA		;save char PSTORY2		EQU	*		AND	#$FF	;if high bit set... 		BMI	@1	;=>not mouse text		LDA	MODE	;is mouse text enabled?		ROR	A	;use carry as flag		PLA		;and restore char		PHA		;need to save it too		BCC	@1		BIT	ALTCHARSET	;only do mouse text if		BPL	@1	;alt char set switched in		EOR	#$40	;do mouse shift		BIT	#$60	;is it in proper range?		BEQ	@1	;=>yes, leave it 		EOR	#$40	;else shift it back @1		BIT	RD80VID	;80 columns?		BPL	@3	;=>no, 40 columns		STA	SET80COL	;force 80STORE for 80 columns		PHY		;Save 'Y' value		PHA		;save shifted character		TYA		;get position  		EOR	WNDLFT	;C=1 if char in main RAM		LSR	A		BCS	@2	;=>yes, main RAM		LDA	TXTPAGE2	;else flip in main RAM		INY		;do this for odd left bytes@2		TYA		;get position		LSR	A	;and divide it by 2		TAY		PLA		;restore acc		STA	(BASL),Y	;save to screen		LDA	TXTPAGE1	;flip to page 1		PLY		;Restore 'Y' value		PLA		;restore true Acc		RTS		;and exit@3		STA	(BASL),Y	;quick 40 column store		PLA		;restore real char		RTS***************************************** NAME    : ESCON* FUNCTION: TURN ON 'ESCAPE' CURSOR* INPUT   : NONE* OUTPUT  : 'CHAR'=ORIGINAL CHAR * VOLATELE: NOTHING* CALLS   : PICK,STORCHAR****************************************ESCON		EQU	*		PHY		; AND Y		PHA		;SAVE AC		JSR	PICKY	;GET ORIGINAL CHARACTER		STA	CHAR	; AND REMEMBER FOR ESCOFF		AND	#$80	;SAVE NORMAL/INVERSE BIT		EOR	#$AB	;MAKE IT AN INVERSE '+'ESCON2		EQU	*		JSR	STORY	; ONTO SCREENESCON4		EQU	*		PLA		; AND A		PLY		;RESTORE YESCON6		EQU	*		RTS***************************************** NAME    : ESCOFF* FUNCTION: TURN OFF 'ESCAPE' CURSOR* INPUT   : 'CHAR'=ORIGINAL CHAR* OUTPUT  : NONE* VOLATILE: NOTHING* CALLS   : STORCHAR****************************************ESCOFF		EQU	*		PHY		; AND Y		PHA		;SAVE AC		LDY	OURCH	;GET CH 		LDA	CHAR	;GET ORIGINAL CHARACTER		BRA	ESCON2	;Exit this way***************************************** NAME    : INVERT* FUNCTION: INVERT CHAR AT CH/CV*         : Unless Pascal and M_CURSOR=1* INPUT   : NOTHING* OUTPUT  : CHAR AT CH/CV INVERTED* VOLATILE: NOTHING* CALLS   : PICK, STORCHAR ****************************************PASINV		LDA	MODE	;check pascal cursor flag		AND	#M_CURSOR	;before displaying cursor		BNE	ESCON6	;=>cursor off, don't invert		PHY		; AND Y		PHA		;save AC		LDY	OURCH	;Get cursor position to 'pick' from		JSR	PPICKY	;GET CHARACTER		EOR	#$80	;FLIP INVERSE/NORMAL		JSR	PSTORY	; ONTO SCREEN		BRA	ESCON4	;Exit this way to save a byte***************************************** NAME    : PSETUP* FUNCTION: SETUP ZP FOR PASCAL* INPUT   : NONE* OUTPUT  : NONE* VOLATILE: AC* CALLS   : NOTHING****************************************PSETUP		EQU	*		JSR	FULL80	;SET FULL 80COL WINDOW		LDA	#255		STA	INVFLG	;ASSUME NORMAL MODE		LDA	MODE		AND	#M_VMODE		BEQ	@1	;=>IT'S NORMAL		LSR	INVFLG	;MAKE IT INVERSE@1		EQU	*		LDA	OLDBASL	;SET UP BASE ADDRESS		STA	BASL		LDA	OLDBASH		STA	BASH		LDA	OURCV	;get user's cursor vertical		STA	CV	;and set it up		RTS****************************************** COPYROM is called when the video firmware is * initialized.  If the language card is switched* in for reading, it copies the F8 ROM to the * language card and restores the state of the    * language card.*****************************************COPYROM		BIT	RDLCRAM	;is the LC switched in?		BPL	@22	;=>no, do nothing		LDA	#GOODF8	;yes, check $F8 RAM		CMP	F8VERSION	;does it match?		BEQ	@22	;=> assum ROM is there		LDX	#3	;indicate bank 2, RAM write enabled		BIT	RDLCBNK2	;is it bank 2?		BMI	@1	;=>yes, we were right		LDX	#$B	;no, bank 1, RAM write enabled@1		STA	F8VERSION	;write to see if LC is		BIT	$C080	;write protected (read RAM)		LDA	F8VERSION	;did it change?		CMP	#GOODF8		BEQ	@2	;=>yes, write enabled		INX		;else indicate write protect@2		BIT	$C081	;read ROM, write RAM		BIT	$C081	;twice is nice		LDY	#$0	;now copy ROM to RAM		LDA	#$F8		STA	CSWH	;hooks set later 		STY	CSWL@11		LDA	(CSWL),Y	;get a byte		STA	(CSWL),Y	;and move it		INY		BNE	@11		INC	CSWH	;next page		BNE	@11		LDA	$C080,X	;restore language card		LDA	$C080,X	;twice to cover all cases@22		RTS		;and return		EJECT* SHOWCUR displays either a checkerboard cursor, a solid * rectangle, or the current cursor character, depending* on the value of the CURSOR location.  0=inverse cursor,* $FF=checkerboard cursor, anything else is displayed * after being anded with inverse mask.SHOWCUR		EQU	*	;what's my type?		PHA		;Save 'A'		LDA	>CURSOR	;Get type		TAY		;'Y' needs to be cursor value		BNE	SHOWCUR4	;=>not inverse		PLA		;Restore 'A'SHOWCUR2		EQU	*		PHY		;Preserve 'Y' around call		JSR	PICKY	;Get character		PHA		;Save character		EOR	#$80	;Flip inverse/normal		JMP	ESCON2	;Exit via return routine* Exit with char in accumulatorSHOWCUR4		EQU	*		PLA		;Recall 'A'		JSR	PICKY	;get char on screen		PHA		;preserve it		STA	>NXTCUR	;save for update		TYA		;test for checkerboard		INY		BEQ	@2	;=>checkerboard, display it		PLY		;test char		PHY		BMI	@2	;don't need inverse 		LDA	ALTCHARSET	;mask = $7F if alternate		ORA	#$7F	; character set, 		LSR	A	;$3F if normal char set		AND	>CURSOR	;form char to display@2		JSR	STORY	;and display it		PLA		;restore real char		RTS* The UPDATE routine increments the random seed.  * If a certain value is reached and we are in Apple II* mode, the blinking check cursor is updated.  If a* key has been pressed, the old char is replaced on the* screen, and we return with BMI.  UPDATE		EQU	*		XBA		;Save 'A' in 'B'		LDA	CYAREG	;Always flash at 1 megahertz		ORA	#$80	;Shift to high speed		PHA		;Save place for 'P' status on stack		PHA		;Save speed on stack		STA	CYAREG	;		XBA		;Restore 'A' from 'B'		PHA		;save char		INC	RNDL	;update seed		BNE	@1	;check for key		INC	RNDH		LDA	>CURSHIFTER	;Do we or don't we flash cursor		DEC	A	;Shift til = 0 then flash		STA	>CURSHIFTER	;		BPL	@1	;		JSR	FIXCURSHIFTER	;Fix cursor flash rate		LDA	>CURSOR	;what cursor are we using?		BEQ	@1	;=>//e cursor, leave alone		PHY		;+ Save Y		JSR	PICKY	;get the character into A 		PHA		;Save 'A'		LDA	>NXTCUR	;get next character		TAY		;'Y' must contain NXTCUR		PLA		;Restore 'A'		STA	>NXTCUR	;save next character		TYA		JSR	STORY	;and print it 		PLY		;+@1		PLA		;get real char		JSR	XBITKBD	;was a key pressed?		PHP		;Get result status		PHP		;Get result status		XBA		;Save 'A' in 'B'		PLA		;Recall status		STA	3,S	;Put in 'P' position on stack		XBA		;Restore 'A'		PLP		;Restore 'n' status		BPL	@2	;=>no key pressed*  + restore old key look for key and exit		JSR	STORY	;		JSR	XRDKBD	;@2		EQU	*		XBA		;Save 'A' in 'B'		PLA		;Restore system speed		AND	#$7F	;Strip off speed bit		ORA	>SYSTEMSPD	;Or in system speed mask		STA	CYAREG	;		XBA		;Restore keypress to 'A' from 'B'		PLP		;Restore 'n' status		RTS		;Back to caller* This routine is used by communications firmware. SETHOOKS		EQU	*		JSR	C3HOOKS	;Set up $C3xx hooks		LDA	#$00	;set a solid inverse cursor		STA	>CURSOR	;		LDA	#$FF-M_CTL	;preserve M_CTL bit		TRB	MODE	;set mode bits		STA	SETALTCHAR	;and set alternate char set 		RTS		;Back to caller		TITLE	'Keyboard Input'*******************************************************                                                    **          Monitor Keyboard Pickup Routines          **                                                    **                         by                         **                    Fern Bachman                    **                                                    **       Copyright Apple Computer, Inc. 1985-1987     **                All Rights Reserved.                **                                                    ******************************************************** All input is directed through this code.* It is done in case we change the way* keyboard input is done in the future.XRKBD1		EQU	*		LDA	KBD	;test keyboard directly		BPL	XRDKBD	;loop if buffered since test. 		STA	KBDSTRB	;Clear keyboard strobe.XNOKEY		RTS		;Minus flag indicates valid characterXRDKBD		EQU	*		JSR	XBITKBD	;is keyboard input ready? 		BPL	XNOKEY	;Branch if not.		BCC	XRKBD1	;Branch if direct KBD input.		IF IS512 <> 0 THEN		RTS		;Should never be executed		ELSE* If here then event manager has a key for us.* We probably should get it to humor the caller.GETEVMEVENT	EQU	*	;Get event manager key press event		PHA		;Preserve 'A','X','Y'		PHX		;		PHY		;		CLC		;Be sure in native mode		XCE		;		PHP		;Save entry status		SEC		;Indicate from here		JSR	CALLEVM	;Call event manager		BEQ	NOEVMKEYS	;= then no event manager keys pressed		PLP		;Restore entry status		XCE		;		PLY		;Recall 'Y'		PLX		;Recall 'X'		PLA		;Recall entry 'A'		LDA	>EVMKEY	;Get key pressed from buffer		ORA	#$80	;ALWAYS set hi bit for monitor firmware		SEC		;Indicate key in 'A'		RTS		;Back to caller		ENDIFXBITKBD		EQU	*	;This rtne replaces "BIT KBD" instructions		IF IS512 <> 0 THEN		JMP	XBKB2	;Test hardware directly		ELSE		PHA		;MUST save accumulator unless key pressed		PHX		;Preserve 'X'		PHY		;Preserve 'Y'		CLC		;Switch to native mode and save entry mode		XCE		;		PHP		;'c' has entry 'e' value in it		REP	#$30	;16 bit land a must for tool calls		PEA	$0000	;Result byte		LONGI	ON		LDX	#ACTFN*256+EMTN	;Function number*256+tool number		LONGI	OFF		JSL	>DISPATCH1	;Call tool locator		PLA		;Recall active status		BNE	TSTNXTEVENT	;<>= then event manager is active		PLP		;Restore entry status		XCE		;Restore entry stat (native or emulation)		PLY		;Recall 'Y'		PLX		;Recall 'X'		PLA		;Recall entry 'A'		BRA	XBKB2	;Exit this wayTSTNXTEVENT	EQU	*		SEP	#$30	;Fix CURSHIFTER for cursor flashing		LDA	#$00	;		STA	>CURSHIFTER	;		CLC		;Indicate from here		JSR	CALLEVM	;Call event manager		BEQ	NOEVMKEYS	;= then no event manager keys pressed		PLP		;		XCE		;		LDA	>WHATEVENT	;What event now?		CMP	#$0A	;$0A is desk accessory event		BEQ	TSTNXTEVENT2	;= then cause desk acc event to happen		SEC		;Indicate EVM active		PLY		;Recall 'Y'		PLX		;Recall 'X'		PLA		;Recall entry 'A'		SEP	#$80	;'-' if key pressed		RTS		;Back to callerNOEVMKEYS		EQU	*	;Branch here if no event mgr keys pressed		PLP		;Restore entry status		XCE		;NOEVMKEYS4	EQU	*		SEC		;Indicate EVM active		PLY		;Recall 'Y'		PLX		;Recall 'X'		PLA		;Recall entry 'A'		REP	#$80	;'+' if no key pressed		RTS		;Back to caller		ENDIFXBKB2		BIT	KBD	;test KBD Directly		CLC		;indicate direct test		RTS		IF IS512 <> 0 THEN		ELSETSTNXTEVENT2	EQU	*		JSR	GETEVMEVENT	;Always allow desk acc event to work		BRA	NOEVMKEYS4	;CALLEVM		EQU	*	;Call event manager		REP	#$30	;16 bit land a must for tool calls		PEA	$0000	;Result status		PEA	$0428	;Look for dsk acc/auto repeat/key pressed		PEA	EVMKEYBUFF>>16	;Bank number of EVM key buffer		PEA	|EVMKEYBUFF	;Address number of EVM key buffer		LONGI	ON		LDX	#GNEFN*256+EMTN	;Function number*256 + tool number		BCS	@1	;'c'=1 then skip next instruction		LDX	#EAFN*256+EMTN	;Function number+256+tool number		LONGI	OFF@1		EQU	*		JSL	>DISPATCH1	;Call tool locator		PLA		;Was a key pressed?		RTS		;Back to caller with call status in 'A'		ENDIF* WARNING Instuction at $CFFE must NOT be one*         that does false read to $CFFF.  An RTS*         is an instruction which does a false*         read of $CFFF and therefore cannot be*         located at $CFFE.