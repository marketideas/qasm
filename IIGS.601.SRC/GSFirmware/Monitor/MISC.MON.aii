		TITLE	'Misc Monitor Bank FF Rtnes0';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 6:11:57 PM*******************************************************                                                    **        Miscellaneous Monitor Bank FF Routines0     **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************REGSETFF		EQU	*		JSR	REGSETFF1	;Done this way cause USERSETUP calls it		RTS		;DO NOT CHANGE THIS!!!!!!!!!!!!!RESETFF		EQU	*	;Part of reset routine		LDA	#$FF	;Set up checkboard cursor		STA	>CURSOR	; for whomever.		PHB		;Save data bank register		LDA	#$E1	;Change data bank register		PHA		;		PLB		;		LDA	#$40	;Set default screen display restore		STA	|SCRNSTAT	; to be textpage1, used in RESUME		LDA	#$6B	;Set with 'RTL' to tell		STA	|MIDIINPUTPOLL	; MIDI tool that RESET occurred		STZ	|CHGCURFLG	;Disable change cursor flag		STZ	|IRQ_MOUSVBL	;Reset user gets VBL flag		STZ	|IRQ_ACTIVE	;Reset irq active flag		STZ	|SCCSTAT	;Reset SCC interrupt byte		REP	#$20	;16 bit stores to follow		STZ	|SCCFLAG2	;Reset SCCFLAG2/SERFLAG		STZ	|C1FLAG	;Reset C1FLAG/C2FLAG		STZ	|IRQ_INTFLAG	;Reset INTFLAG/DATAREG		STZ	|IRQ_KMSTATUS	;Reset IRQ_KMSTATUS/IRQ_SECFLAG		LONGA	ON		LDA	#$0001	;Set counter for copy each VBL		STA	|TP2TCNT	;Put in task header area		LDA	#$A55A	;Signature word		STA	|TP2TSIG	;Put in task header area		LDA	#>TP2TASK	;Setup pointer to task to execute		STA	|TP2TJMP+2	;		LDA	#TP2TASK*256+$5C	;Low word of pointer and JMP abslong		STA	|TP2TJMP	;		LDA	#>SETDEFSLT	;Set pointer to restore default slots assignment		STA	|DEFAULTSLT+2	;		LDA	#SETDEFSLT*256+$5C	;Low word of pointer and JMP abslong		STA	|DEFAULTSLT	;		LDA	#>RSTSYSSLT	;Set pointer to restore system slots assignment		STA	|RESTORSLT+2	;		LDA	#RSTSYSSLT*256+$5C	;Low word of pointer and JMP abslong		STA	|RESTORSLT	;		LONGA	OFF		SEP	#$30	;8 bit land now		STZ	|TP2MODE	;0/1 text page 2 copier off/on		LONGA	OFF		SEP	#$30	;8 bit land now		PLB		;Restore data bank registerREGSETFF1		EQU	*	;Setup regs for MON entry then beep		PHB		;Save data bank register		PHB		;Save data bank register		JSR	DBTOE1	;Switch data bank register		LDA	|STATEREG	;Get STATEREG val on entry to bnk FF		AND	#$FE	;Enable external CXROM		STA	|MVAL	;Save memory state		LDA	11,S	;Get user CYAREG value		AND	#$80	;Hi bit only important one		ORA	SHADOW	;Or in shadow register		STA	|QVAL	;		PLA		;Recall data bank register		STA	|BVAL	;Save data bank register		STA	|KVAL	;Prog bnk reg same as data bank reg		STA	|DDVAL	;Set disassembly option to zero		STA	|BANKS	;Save also as source bank		STA	|HIGHBANK	;Save high bank of crossing stuff also		REP	#$30	;Go to 16 bit land		TDC		;Save current direct register value		STA	|DVAL	;		TSC		;Get stack pointer		CLC		;Fix for correct value		LONGA	ON		ADC	#$000B	;Stack pointer is 11 bytes off in here		STA	|SVAL	;Save stack pointer		LDA	#$0101	;Set 'm'/'x'/'e' values to emulation		STA	|LVAL	;Set language card bank/'m' value to 1		STA	|XPVAL	;Set 'x'/'e' values to 1		LONGA	OFF		SEP	#$30	;Back to 8 bit land		LDY	#$05	;0 out AVAL/XVAL/YVAL		LDA	#$00	;@1		EQU	*		STA	|AVAL,Y	;		DEY		;		BPL	@1	;Loop til all 0		STA	|PVAL	;'P' value to 0 too		STY	|ASCFILTER	;ASCII filer mask=$FF as default		PLB		;Fix current data bank register		RTS		;Back to callerMAKEMXE0		EQU	*	;Make 'm'/'x'/'e' native mode internally		LDA	#$00	;		LDX	#$02	;Zero out 3 variables@1		EQU	*		STA	>MPVAL,X	;Sets internal 'm'/'x'/'e' = native		DEX		;Next		BPL	@1	;Loop til done		RTS		;Back to callerPREADFF		EQU	*		LDA	CYAREG	;Save user speed bit		PHA		;		AND	#$7F	;Switch to slow speed		PHP		;Preserve interrupt status		SEI		;Now disable interrupts		STA	CYAREG	;		LDA	PTRIG	;Trigger paddles		LDY	#$00	;Init count		NOP		;Compensate for 1st count		NOP		;@1		EQU	*		LDA	PADDL0,X	;Count Y-reg every 12 usec		BPL	@2	;+ THEN DONE		INY		;		BNE	@1	;Exit at 255 maximum		DEY		;@2		EQU	*		PLP		;Restore interrupt modePREADFFRTS	EQU	*		PLA		;Recall user speed byte		STA	CYAREG	;Restore user speed		RTS		;Exit to callerFFBANKRTS		EQU	*	;		SEP	#$30	;Restore monitor mode		XBA		;Save user's 'A' value		LDA	#$80	;Go fast in here		TSB	CYAREG	;		XBA		;		STA	SETINTCXROM	;Restore bank FF operating environment		RTS		;Back to bank $FF caller	; SEG $FFRAMVCTRS2		EQU	*	;Move interrupt vectors to RAM	; SEG $00		PHB		;Save data bank register		JSR	DBTOE1	;Change data bank register		LDX	#INTVTBLLEN2-1	;Table length@1		EQU	*		LDA	>INTVTBL2,X	;		STA	|TOWRITEBR,X	;		LDA	>INTVTBL1,X	;Set up 4 mgr vctrs + 16 bytes		STA	|INTMGRV,X	; which are re-set up shortly.* If the new vectors is not of the same length of INTVTBLLEN* which is $28, then there are some repetition vectors of INTVTBL2* being generated in new vector location which is $e10200.* Add in to avoid repetition vectors stuff.		CPX	#32	;8 new vectors only !!! 		BCS	@3	;BRA if not need to move yet		LDA	>INTVTBL0,X	;New vectors in Gyro		STA	|TOMEMMOVER,X	;@3		EQU	*		DEX		;		BPL	@1	;		LDX	#MSGPOINTER-OSVECTORS-1	;Reset operating system vectors@1234		EQU	*		STZ	|OSVECTORS,X	;Reset all operating system values+8 bytes		DEX		;		BPL	@1234	;Branch til all zeroed out		LDA	#^MSGTBL	;Set up MSGPOINTER		STA	|MSGPOINTER+2	;		LDA	#$4C	;Put JMP opcode in some vectors		STA	>OSWMSTRT	;In operating system warmstart vector		STA	>AMPERV	;In ampersand vector		STA	>USRADR	;Control-Y vector		LONGA	ON		LONGI	ON		REP	#$30	;Use 16 bit 'm'/'x'		LDA	#MON	;Set irq interrupt vector to monitor		STA	>IRQLOC+0	;		STA	>OSWMSTRT+1	;If no OS on warmstart stay in monitor		STA	>USRADR+1	;Control-Y vector		LDA	#$E003	;Warm start AppleSoft Basic		STA	>AMPERV+1	;In ampersand vector		LDA	#MSGTBL	;Move hi and low byte of MSGTBL ptr too		STA	|MSGPOINTER	;		LONGA	ON		LONGI	ON		LDX	#IRQ_LEN-4	;@2		EQU	*		LDY	#>SECRTL	;Bank / hi byte of SECRTL		LDA	#SECRTL*256+$5C	;JMP abs long / lo byte of SECRTL		STA	|IRQ_APTLK,X	;Put JMP abs long in all vctrs as default		TYA		;Address of SEC/RTL		STA	|IRQ_APTLK+2,X	;Addr of SEC/RTL in all vctrs as default		DEX		;		DEX		;		DEX		;		DEX		;		BPL	@2	;Loop til done		LDA	#MICROABORTED	;Move address of MICROABORTED to IRQ_MICRO		STA	|IRQ_MICRO+1	;		LDA	#ROMTOOL*256+$5C	;Jmp abslong and low byte of ROMTOOL		STA	|ROMTOOLHOOK+0	;Save opcode and low byte		LDA	#>ROMTOOL	;Bank number and high byte		STA	|ROMTOOLHOOK+2	;Finish up operand		LONGA	OFF		LONGI	OFF		SEP	#$30	;Bank to normal monitor mode		LDA	#^MICROABORTED	;Move bank of MICROABORTED to IRQ_MICRO		STA	|IRQ_MICRO+3	;* Test for Ensoniq chip here and set ENSONIQFLG appropriately.* It's always here so force status** ENSONIQFLG = 0 if sound chip is installed*            = <>0 if no sound chip is installed		STZ	|ENSONIQFLG	;Indicate always present		PLB		;Restore entry data bank		JMP	SETUPSLOTS	;Set up internal versus external slotsRAMVCTRS		EQU	*	;Move interrupt vectors to RAM* '2' out text page 2.		REP	#$10	;16 bit index needed		LONGI	ON		LDX	#$07FF	;Space out text page 2		LONGI	OFF		LDA	#'2'	;'2'@1		EQU	*		STA	>$E00800,X	;		DEX		;		BPL	@1	;		SEP	#$30	;Back to normal monitor mode* The monitor MUST zero out the mouse mode screen hole* so that the desk accessory manager can tell if the* mouse has ever been turned on or not.		LDA	STATEREG	;Save state		PHA		;		STA	SETSLOTCXROM	;Always look at what's there		LDA	#$C1	;Starting slot is 1		STA	LOC1	;		STZ	LOC0	;@11		EQU	*		LDX	#$03	;Test 4 bytes for mouse card@22		EQU	*		LDA	>MCOFFSET,X	;Get byte to test offset from table		TAY		;Move for proper indexing		LDA	>MIDVALUE,X	;What's correct byte for here??		CMP	(LOC0),Y	;Test against card value		BNE	@33	;Not = then try next card		DEX		;= then test next byte on same card		BPL	@22	;Loop* If here then zero out mouse control byte for this slot.		LDA	LOC1	;What slot we looking at?		AND	#$07	;Make $Cn into $0n for indexing		TAX		;		STZ	MOUSMODE-4,X	;Make DA manager think mouse is off@33		EQU	*		INC	LOC1	;Next slot please		LDA	LOC1	;Done yet?		CMP	#$C8	;Yes if $C8		BCC	@11	;Test new card		PLA		;Restore monitor state		STA	STATEREG	;		IF IS512 <> 0 THEN		LDA	#$18	;Dummy up some vectors		STA	>IRQ_DSKACC	;CLC opcode		LDA	#$6B	;RTL opcode		STA	>IRQ_DSKACC+1	;		ELSE@3		EQU	*	;Restart here if error		JSL	>INITDISMGR	;Init Tool Locator dispatch manager		BCC	@4	;'c'=0 then all's OK		LDA	#$00	;Bad then zero out memory manager pwr byte		STA	>RAMDSKPWRUP	;		BRA	@3	;Loop til all's OK@4		EQU	*		ENDIF		LDA	>USERRSTRAM	;Get the reset ramdisk bram byte		BEQ	@5	;If no reset ramdisk selected, do nothing		LDA	#$00	;Else set no for next round		STA	>USERRSTRAM	;		JSL	>WRITEBR	;Need to write to batteryram@5		EQU	*		LDA	#$00	;Zero out serial prt powerup bytes if here		STA	>SERPWRUP	;		STA	>SERPWRUP+1	;		JSL	>INITCLOCK	;Don't let the clock in test mode		JSR	|PROCONINIT	;Init protocol converter		JSL	>APTALKINIT	;Init AppleTalk (Coldstart)		RTSTSTMONDSKACC	EQU	*		PHP		;Save 'm'/'x' status		SEP	#$30	;Do tests in 8 bit mode		LDA	>ROMDAACT	;		TAX		LDA	>BRAMDAACT	;Test if any application set to activate ROMDA		BEQ	@1	;BRA if NO 		TXA		;Test if we should reactivate ROM dsk accs*                              ;Bit7=1=install it--bit6=1=is installed@2		EQU	*		AND	#$BF	;Reset bit 6		STA	>ROMDAACT	; so the ROM dsk accs will be installed.		JSR	ENMONDSKACC1	;Reenable monitor/memory peeker dsk acc@5		EQU	*		PLP		;Recall 'm'/'x' status		RTL		;Back to caller@1		EQU	*		TXA		BMI	@2		PLP		RTLCONV2ASC		EQU	*		AND	#$0F	;Do low nybble only		ORA	#$B0	;		CMP	#$BA	;Test for number of letter		BCC	@1	;<$BA then it's a number		ADC	#$06	;If here it's a letter@1		EQU	*		RTS		;Back to caller		TITLE	'Misc Monitor Bank FF Rtnes0'*******************************************************                                                    **        Miscellaneous Monitor Bank FF Routines00    **                                                    **                    by                              **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1987-1987     **                All Rights Reserved.                **                                                    ********************************************************* STEP/TRACE stack structure**    ------------*    |  <GOS    | <-- For returning back to monitor      *    |  >GOS    |     when 'esc' key is hit*    | TraceRate| <-- Trace rate value*    |  'P'     | <-- Store 'c'/'v'              *    |Monitor Bk| <-- For returning back to step/tace*    | <STEPSP  |     after finishing each user instruction*    | >STEPSP  |*    |          |*    |    |     | <-- Reserved for monitor step/trace   *    |    |     |     to be used when they are activated*    |    |     |     from $01bf-$01ff*    |          |*    |   SVAL   | <-- User stack space starts from here*    |    |     | <-- If specified >=$0180 then force to $017F*    |    |     |     if < $110 then error and back to*    |    |     |     monitor*    |          | <-- low end for user sp $110 !!*    |    |     | <-- Too low if below here to $100 *    |    |     |*    |          |*    ------------*TRACEFF		EQU	*		JSL	>TRACEVECTOR	;See if anything out there		LDA	#TRACEMSG	;Display 'Trace' messageTRACEFF2		EQU	*		BCS	TRACE1	;'c'=1, trace not done yet !		RTS		;Back to callerTRACE1		EQU	*		JSR	PRINTMSG		SEC		;'c' = 1, trace		BRA	STEP1STEPFF		EQU	*		JSL	>STEPVECTOR	;See if anything out there		LDA	#STEPMSG	;Display 'Step' message		BCS	STEP0	;'c'=1 then step not done yet !		RTS		;Else return back to monitorSTEP0		EQU	*		JSR	PRINTMSG	;Display it		CLC		;'c'=0, stepSTEP1		EQU	*		PHB		;Save original data bank on stack		LDA	STATEREG	;Save state register 		PHA		JSR	FIXE1PCLH	;Move PCL/PCH to bank E1 in case alt zp		LONGA	ON		; Interrupt was disable from 'FIXE1PCLH'		LONGI	ON		;From 'FIXE1PCLH', also data bank = $e1		LDX	SHADOW	;Save SHADOW/CYAREG registers		PHX		TSC		;Save stk reg, for return back to monitor		STA	|GOS	;Save for later restoring		PHP		;Temporary save step/trace 'c'		LDA	|SVAL	;Get usr's stack pointer		CMP	#$0200	;Is it same as monitor stack space		BCS	@1	;If not, leave it alone		CMP	#$0180	;Is it within my monitor ranges		BCC	@0	;BRA if not        		LDA	#$017F	;Else force to this value		STA	|SVAL	;Set to new value		BRA	@1	;Continue on@0		EQU	*		CMP	#$0110	;Is it too low ?		BCS	@1	;BRA if ok, $0110-$01a0 safe area		PHX		;Dummy push for exit		JMP	TOMON1	;Exit to monitor@1		EQU	*		PLP		;Restore step/trace 'c'** The step/trace code sets emulation mode while running*  in bank $FF!  If an interrupt comes under these circumstances*  the machine crashes.  To remedy this problem, interrupts are*  disabled during step and trace operation.  An interrupt window is*  opened right around the call to get keys (in case the event mgr*  is active ... it relies on interrupts to get keystrokes).*  Interrupts are reenabled upon return to monitor mode.*		CLI		;Enable interrupt		LONGA	OFF		;Off to 8 bit land		LONGI	OFF		SEP	#$30		STZ	|JSX	;Set no real time jsx and w/regs display		LDA	#$7F	;Default trace rate		PHA		;Store on stack		CLV		;'c'=1, 'v'=0, normal trace mode		PHP		;Save on stack		PEA	$0000	;Set back monitor data bank $00		PLB		PLBSTEPMORE		EQU	*		JSR	DISASEM	;Display user instruction at its pc** The code above this point has trashed the A1L value so that it*  no longer contains the user's bank.  Restore it here so that the*  'X' command can work on the first instruction in the step. {MSA 4/13/89}*		LDA	>BANKS		STA	A1L	;Should be zero page!*LOOPKBD		EQU	*		JSR	XRKBD1	;Read keyboard input		BPL	@1	;BRA if no key hit		JMP	FUNCTION	;Key hit, what functions ?@1		EQU	*		PLP		;Get the previous mode: step or trace ?		PHP		;Store back for later use		BCC	JUSTTRACE	;Bra if in step mode		BVC	JUSTTRACE	;Bra for normal trace mode		LDY	#$0	;Set y=0 for reading an opcode		JSR	READPCY	;Read it and return in 'A'		CMP	#$60	;RTS ?		BEQ	EXITRTX		CMP	#$40	;RTI ?		BEQ	EXITRTX		CMP	#$6B	;RTL ?		BNE	JUSTTRACE	;Bra if not RTL EXITRTX		EQU	*		PLP		;Get rid of previous c/v		PLA		;Get rid of trace rate count		LDA	#$7F	;Set to normal trace rate		PHA		;Save back to stack		CLV		;Clean off flag to stop at rtx		CLC		;When exit from 'RTx', set to step mode		PHP		;Store back to stack		BRA	LOOPKBD	;Loop for key hitJUSTTRACE		EQU	*		LDA	>JSX	;Is real time execution of JSX active ?		BPL	JUSTTRACE1	;Bra if not activated, BIT7		LDY	#$0	;Else check for JSx opcode		JSR	READPCY	;Read opcode at current PCK/PCH/PCL		CMP	#$20	;Is it 'JSR'		BEQ	@1	;Bra for doing real time JSR		CMP	#$22	;Is it 'JSL'		BNE	JUSTTRACE1	;Bra if not@1		EQU	*		JMP	REALJSX	;Go do JSR OR JSL routine in realJUSTTRACE1	EQU	*		PLP		;Get 'c'		PHP		;Save back		BCC	LOOPKBD	;Bra if in step and not real time JSx		LDA	2,S	;Get trace rate		JSR	WAIT	;Make a delay between each trace		JMP	STEPTR	;Jump to execute user's instructionONOFFREGS		EQU	*		LDA	>JSX		EOR	#$40	;Bit 6		STA	>JSX	;		BRA	LOOPKBD	;GOKEY		EQU	*		PLP		;Clean stack		PLA		;		LDX	#$00	;For A1PC routine call in RESUME		JMP	RESUMEFF	;Continue on with resume routineWAITRTX		EQU	*		PLP		;Clean out the stack		SEP	#$40	;Set v=1 as indicator for waiting rtx		PHP		BRA	LOOPKBD5	;Save c/v and go backCHKJSX		EQU	*		LDA	>JSX	;Prepare to set bit7		ORA	#$80	;		STA	>JSX	;		BRA	LOOPKBD5	;Go backMYTEXT		EQU	*		LDA	#$40	;Set bit6 to turn on text		BRA	SETSCRN	;Do it and exitDOUBLE		EQU	*		LDA	#$80	;Prepare to turn off super hi		TRB	NEWVIDEO	;Do it		LDA	TXTCLR	;Turn on graphic		LDA	CLRAN3	;Turn on double res		BRA	LOOPKBD5	;ExitMYMIXED		EQU	*		LDA	#$20	;Set bit for mixed mode		BRA	SETSCRN	;Do it and exitMYHIRES		EQU	*		LDA	#$10	;Set bit4 for hi-res		BRA	SETSCRN	;Do it and exitMYLORES		EQU	*		LDA	#$00	;Set for low-res		BRA	SETSCRN	;Do it and exitMYSUPER		EQU	*		LDA	#$80	;Set bit7 for super hi-resSETSCRN		EQU	*		STA	>SCRNSTAT	;Store here as new value		LDA	#$80	;Any way turn off super hi-res first		TRB	NEWVIDEO	;		STA	SETAN3	;Double off		JSR	BRKSCRN	;Set to new screen mode		BRA	LOOPKBD5	;Go back and continue in my world !CHARKEYS		EQU	*		AND	#$DF	;Mask off lower case 		CMP	#'O'	;ON/OFF registers display		BEQ	ONOFFREGS	;		CMP	#'J'	;CHK for 'J'		BEQ	GOKEY	;		CMP	#'R'	;Command to stop at rtx		BEQ	WAITRTX	;		CMP	#'X'	;Command to execute JSx subroutine in real		BEQ	CHKJSX	;		CMP	#'T'	;Change the display to text mode		BEQ	MYTEXT	;		CMP	#'D'	;Change the display to graphic mode		BEQ	DOUBLE	;		CMP	#'M'	;To mixed mode		BEQ	MYMIXED	;		CMP	#'H'	;To hi-res     		BEQ	MYHIRES	;		CMP	#'L'	;To low res		BEQ	MYLORES	;		CMP	#'S'	;To super hi res		BEQ	MYSUPER	;NOTCLAIM		EQU	*		JSR	NEWBELL1	;Unrecognized keys, BeepLOOPKBD5		EQU	*		JMP	LOOPKBD	;Go back for more commandsFUNCTION		EQU	*		CMP	#'A'	;Split off from here		BCS	CHARKEYS	;BRA if within char keys range		CMP	#$9B	;Check for 'esc'		BEQ	TOMON	;Back to monitor		CMP	#$A0	;Check for 'space bar'		BEQ	SPACEKEY		CMP	#$8D	;Check for 'CR'		BEQ	CRKEY		CMP	#$88	;'<--', Slow trace rate		BEQ	SLOWRATE		CMP	#$95	;'-->', Fast trace rate		BEQ	FASTRATE	;		CMP	#$8A	;Down arrow key?		BEQ	SKIPONE	;Skip current instruction		JMP	NOTCLAIM	;Not defined keysTOMON		EQU	*	;'ESC' command		CLI		;Make sure interrupt is on when exit		JMP	GO816_EXT	;Exit step/trace and back to monitorSPACEKEY		EQU	*	;'Space' command		PLP		;Get previous 'c', 1 = trace ; 0 = step		BCC	SWITCH	;If in step mode, stay it		CLC		;Else switch from trace to step mode		BRA	SWITCH	;Prepare to execute user instructionCRKEY		EQU	*	;'CR' command		PLP		;Get back previous 'c'		BCS	SWITCH	;If in trace mode, stay it		SEC		;Else switch from step to trace mode		PLA		;Get rid of previous trace rate		LDA	#$7F	;Set to default trace rate		PHA		;Save backSWITCH		EQU	*		PHP		;Save back 'c'/'v'		JMP	STEPTR	;Jmp to execute user's instructionSLOWRATE		EQU	*		PLP		;Temp pull back		PLA		;Get rid of previous trace rate		LDA	#$FF	;Set with low rate		BRA	LOOPKBD4FASTRATE		EQU	*		PLP		;Temp pull back		PLA		;Get rid of previous trace rate		LDA	#$3F	;Set with fast rateLOOPKBD4		EQU	*		PHA		;Save back		PHP		;Save c/v		JMP	LOOPKBD	;Go backSKIPONE		EQU	*		LONGA	ON		REP	#$20	;		PHK		;Set up return address		PEA	STEPMORE-1	;		TSC		;		STA	>STEPSP	;		JMP	XEND1	;Exit in common routineREALJSX		EQU	*		LONGA	OFF		LDA	>JSX		AND	#$7F	;		STA	>JSX	;		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		PHK		;Save monitor bank		PEA	STEPMORE-1	;Save step/trace return address		TSC		;Save monitor stack pointer		STA	>STEPSP	;Save it		CLC		;'c'=0, as indicator for calling from real time JSx		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land		PHP		;Save 'c' and m/x** If the JSx routine is a Prodos8/Prodos16 MLI call,* then special adjustment for user PCH/PCL is needed* so that it would continue in my step/trace world.* For JSR, new PC = current PC + 3 (bank $00 only),* For JSL, new PC = current PC + 6 (any bank).                      ** For JSR call, it starts execution at the current JSR location,* pre-compute and modified the user next opcode (after JSR) with* RTL, $6B is required. Doing this, when hit user RTS, it gets to* the modified RTL and helping to branch back to the monitor step* trace world.* For JSL call, it never execute the JSL itself and therefore the* user RTL is easily dispatched by the monitor step/trace  *NOTREAL		EQU	*	;Entry point for normal JSx call		LDY	LENGTH	;2=JSR, 3=JSL		CPY	#$3	;JSR or JSL ?		BNE	JSRSTUFF	;Bra for JSR		JMP	JSLSTUFFJSRSTUFF		EQU	*		JSR	READPCY	;Tst for PRODOS8 MLIcall,$BF00;tst for $BF		CMP	#>PRO8MLI	;Hi byte of MLI call address		BNE	NOTMLI8	;Bra if high byte not equal $BF		DEY		;Index to read low byte		JSR	READPCY	;Get low byte, test for $00		ORA	>BANKS	;Src bank and low byte both 0 if MLI call		BNE	NOTMLI8	;Bra if not PRODOS8 MLI call		LDA	#$05		STA	LENGTH	;Store back, good for 'FIXPC'		PLA		;Clean stack		BRA	MLICALL	;Bra for real time PRODOS8 MLI callNOTMLI8		EQU	*		PLP		;Get back 'c'		BCS	JSRNOTRL	;Bra if NOT doing real time of any JSRMLICALL		EQU	*JSRREAL		EQU	*		LDA	PCL	;Load original pc where JSx is A1H-A2		STA	A1H	;PCL		LDA	PCH	;		STA	A2L	;PCH		LDA	>KVAL	;		STA	A2H	;** Must preserve the Emulation Stack Pointer in case we are going*  off to a native mode stack.  {MSA 4/28/89}*		JSR	STACKFUTZ	;{MSA 4/28/89}*		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		LDA	>SVAL	;Get user stack pointer		TCS		;Change to user stack space		LONGA	OFF		LONGI	ON		SEP	#$20	;8/16 M/X            		LDA	A2H	;Get bank byte where usr reside		CMP	#$F8	;Is it in ROM bank, $f8-$ff		BCC	NOTROMBK	;BRA if not		STZ	A1H	;Start from $ffff of that bank		STZ	A2L	;  		LDY	#$FFFF	;GOFORRTL		EQU	*		LDA	[A1H],Y	;Read and test for 'rtl'		CMP	#$6B	;Search for 'RTL', $6b		BEQ	GETRTL		DEY		BNE	GOFORRTL	;If there is no 'rtl', force to step mode		LDA	[PCL],Y	;Chk for jsr or jsl calls		CMP	#$22	;		BEQ	JSLNOTRL	;BRA to do jsl routine not in real timeJSRNOTRL		EQU	*		JMP	GOJSRL	;Single step if no rtl foundGETRTL		EQU	*		PHK		;Get an rtl, save my program bank		PEA	JSLRET-1	;Address where rtl returns		DEY		;Adjust the pc for rtl where located		PHY		;Push in as return address for usr's rts		LONGA	OFF		LONGI	OFF		SEP	#$30	;off to 8-bit m/x		LDY	#$00	;Chk for jsr or jsl ?		LDA	[PCL],Y	;Read in the opcode		CMP	#$22	;Chk for jsl ?		BNE	@1	;Bra if NOT prodos mli		JMP	ROMJSL	;Broke the branch {MSA 4/28/89}@1		EQU	*		LDA	A2H	;Else need to push in usr's program bank		PHA		LDY	#$02	;Set proper index for doing jsr		JMP	ROMJSR	;Bra to do real time jsr routineNOTROMBK		EQU	*		LONGA	OFF		LONGI	OFF		SEP	#$30		LDY	LENGTH	;'FIXPC' depends on length to get next pc		JSR	FIXPC	;Pre-cal next pc, take care of bk crossing		LDY	#$00	;Index to pre-read next opcode		JSR	READPCY	;Read it		PHA		;Save to stack for later restoring		LDA	#$6B	;Modified user's next opcode w/ 'RTL'		STA	[PCL],Y	;Store the modified code to user next pc		PHK		;Save monitor program bank		PEA	JSRRET-1	;Save return address** The RESTOREFF scheme for restoring the user's interrupt state has a fundamental*  problem.  You can't just restore the E and I bits when running code in bank <>$00.*  If E=1 and an interrupt comes in, control is lost upon return from the interrupt.*  So we have altered RESTOREFF so that it disables interrupts, and every *  call to RESTOREFF has been modified so that control is transferred with an RTI,*  so that interrupts are not enabled until after control is transferred. {MSA/FAB 4/12/89}*; JSR RESTOREFF ;Restore user's environment stuff; JML [A1H] ;Execute from usr's JSR or JSL itself** Already in 8 bit mode!*		LDA	>EPVAL	;If user in native, RTI will pull 4 bytes		BNE	MF1	;If emulation, RTI pulls 3 bytes		LDA	A2H	;Get the bank part of the address		PHA		; and push it onMF1		EQU	*		LDA	A2L	;Get bits 8..15 of the address		PHA		LDA	A1H	;Get bits 0..7 of the address		PHAMFRTI		EQU	*		LDA	>PVAL	;Get the User's status reg		PHA		; and set up for the RTI		LDA	>EPVAL	;Emulation RTI MUST happen from bank $00		BNE	@1		JSR	RESTOREFF	;Restore everything except the PSReg		RTI@1		EQU	*		JSR	RESTOREFF		JMP	>RTI~Bnk00**JSLSTUFF		EQU	*		JSR	READPCY	;Y=3, get bank byte		CMP	#^PRO16MLI	;Test bank byte for PRODOS16 MLI call		BNE	NOTMLI16	;Bra if not		DEY		;		JSR	READPCY	;Y=2, get high byte		CMP	#>PRO16MLI	;Test high byte for PRODOS16 MLI call		BNE	NOTMLI16		DEY		JSR	READPCY	;Y=1, get low byte		CMP	#<PRO16MLI	;Test low byte for PRODOS16 MLI call		BNE	NOTMLI16	;Bra if not		LDA	#$09		STA	LENGTH	;Store back, good for 'FIXPC' 		PLA		;Clean stack		JMP	MLICALL	;PRODOS16 MLI callNOTMLI16		EQU	*		PLP		;Is it force to do real time for any JSL		BCC	JSLREAL	;BRA if it isJSLNOTRL		EQU	*		LONGA	OFF		LONGI	OFF		SEP	#$30		LDA	>KVAL	;Normal JSL step/trace, push pck to stack		JSR	DECSP	;Do it and adjust user's SVAL		JMP	GOJSRL	;Go for normal JSL stuffJSLREAL		EQU	*** Must preserve the Emulation Stack Pointer in case we are going*  off to a native mode stack.  {MSA 4/28/89}*		JSR	STACKFUTZ	;{MSA 4/28/89}*		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		LDA	>SVAL	;Get user stack pointer		TCS		;Swap to user stack space		PHK		;Save monitor program bank		PEA	JSLRET-1	;Save return address on stack** We'll use an RTI to transfer control and to enable interrupts only upon transfer.*  {MSA/FAB 4/12/89}ROMJSL		EQU	*		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land		LDY	#$3		LDA	>EPVAL	;{MSA 4/12} Will it be a emul or native RTI		BNE	BACKIN	;{MSA 4/12} Emul skip pushing the high byte		JSR	READPCY	;Read bank byte		PHA		;Save on stackBACKIN		EQU	*		DEYROMJSR		EQU	*		JSR	READPCY	;Read high byte		PHA		DEY		JSR	READPCY	;Read low byte		XBA		;Save pcl to high 'a'		PLA		;Get back high byte		XBA		;Make it pch/pcl		LONGA	ON		LONGI	ON		REP	#$30	;16 bit land ;DEC A ;Minus 1, when RTL it plus 1		PHA		;Save forward address on stack		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land; JSR RESTOREFF ;Restore user's environment first; RTL  ;Off to usr's routine		JMP	MFRTI	;{MSA 4/12} Push user's P, restore and RTI*JSRRET		EQU	*	;Return after real time jsr routine		JSR	STOREFF	;Need to store user's new stuff first		LONGA	OFF		LONGI	OFF		SEP	#$30	;Set 8 bit land, in case user change it		PLA		;Restore the pre-get opcode		LDY	#$0	;Prepare index for saving back		STA	[PCL],Y	;Store back to the user original area		JMP	XEND	;Back to step/trace, no need to update PC	; SEG $FFJSLRET		EQU	*	;Get here after usr's real time JSL 	; SEG $00		JSR	STOREFF	;Store user's stuff before anything else		LONGA	OFF		LONGI	OFF		SEP	#$30	;Set to 8 bit land in case user change it		JMP	XEND2	;Back to step/trace, need to update for PCSTEPTR		EQU	*		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		PHK		;Save return info on stack for 'RTL' after a step		PEA	STEPMORE-1	;Step more, back to monitor		TSC		;Save sp where step/trace left off		STA	>STEPSP	;Store for returning after each step/trace		LONGA	OFF		LONGI	OFF		SEP	#$30	;Off to 8 bit land** User's instruction filtering and execution*		SEI		;Disable interrupt		LDY	#$0	;Set index to read opcode at PC		JSR	READPCY	;Read an opcode                  		PHA		;Temp store the opcode		LDX	#$0B	;Init execution areaXQINIT		EQU	*		LDA	>XOPC,X	;Absolute long index		STA	>USEROPC,X	;Save to step/trace execution area		DEX		BPL	XQINIT	;Till done		LDA	>BANKS	;Get usr's bank		STA	A1L	;Store so that pcl/pch/a1l=pcl/pch/pck		STA	>KVAL	;Also update usr's program bank		PLX		;Restore opcode and store in 'x'		BNE	NOTBRK	;If brk, exit to monitor    SPERR		EQU	*		JSR	NEWBELL1	;Beep		LDA	>JSX		AND	#$BF	;Set bit6=0		STA	>JSX		JMP	XEND	;Exit and stay to brkNOTBRK		EQU	*		CPX	#$60	;RTS ?		BEQ	XRTS		CPX	#$6B	;RTL ?		BEQ	XRTS		CPX	#$40	;RTI ?		BNE	XQ1	;Bra if not RTI		JSR	INCSP	;Check user sp and return the value pointed by sp in 'A'		STA	>PVAL	;Simulate rti by getting 'p' from stack  XRTS		EQU	*	;Simulate for rts		JSR	INCSP	;Update new pch/pcl with new values from user's stack		STA	PCL	;Store to pcl		JSR	INCSP	;Read next value in sp+1		STA	PCH	;Store to pch		CPX	#$40*BEQ XRTS1 ;For RTI, there is no plus 1 for value from stack** Fix a bug where a native mode RTI was not pulling the PBR off*  of the stack.  {MSA 4/10/89}*		BNE	MXRTS	;Skip if not an RTI		LDA	>EPVAL	;RTI's behavior depends on E		BEQ	PIARTL	;Native RTI- pretend RTL- PBR on stk		BRA	XRTS1	;Emulation RTI doesn't have PBR on stackMXRTS		EQU	*** End of 4/10/89 patch  {MSA}*		LONGA	ON		LONGI	ON		REP	#$30	;16 bit 'm'/'x'		INC	PCL	;For RTS/RTL, return address in stack + 1 = new PC		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land		CPX	#$6B	;RTL ? 		BNE	XRTS1	;Bra if not               PIARTL		EQU	*	;Pull the PBR off the stack {MSA 4/10/89}		JSR	INCSP	;Else to pull one more for program bank		STA	>KVAL	;Update user's program bank		STA	>BANKS		STA	A1LXRTS1		EQU	*		JMP	XEND	;Regs display and back to next step/traceXQ1		EQU	*		PHX		;Save the user's opcode		LDY	LENGTH	;Get length of opcodeXQ2		EQU	*		JSR	READPCY	;Read usr's opcode & oprnd, preserve x/y		TYX		;Try to do index long w/ 'x'		STA	>USEROPC,X	;Copy to execution area		DEY		BPL	XQ2	;Move until done		PLX		;Restore usr's opcodeXQ3		EQU	*** Add a check for 'CLI' to disable its execution {MSA 3/30/89}*		CPX	#$58	;Defeat CLI emulation...		BNE	noprob		JMP	XEND1NOPROB		EQU	********** END 3/30/89 PATCH **********		CPX	#$4C	;JMP....?		BCS	@3	;Bra if could be a JMP, JMP (), JML		JMP	XJSR1	;Else check for JSR...@3		EQU	*		BEQ	XJMP	;Bra for JMP a		CPX	#$DC		BEQ	XJMP	;JML (a)		BCC	@2	;Bra if could be a JMP, JMP ()@4		EQU	*		JMP	XJSR1	;Else check for JSR..@2		EQU	*		CPX	#$5C		BEQ	XJMP	;JMP al		CPX	#$6C		BEQ	XJMP	;JMP (a)		CPX	#$7C		BNE	@4	;Bra if not JMP (a,x)		LDA	>EPVAL	;Check user's 'e'		BNE	@1	;Bra if e=1, emulation mode		LDA	>PVAL	;If e=0, need to check index 'x' mode		AND	#$10		BEQ	XJMP	;Bra if INDEX16 MODE  @1		EQU	*		LDA	>XVAL+1	;Get user's low byte 'x'		PHA		;Store to stack so XVAL can be manipulated		LDA	#0	;With index8, set high byte of 'x' to 0		STA	>XVAL+1		BRA	XJMPP	;                                      XJMP		EQU	*		LDA	>XVAL+1	;Get user's XVAL+1		PHA		;Store it                               XJMPP		EQU	*		LDA	>USEROPRL	;Get user's operand low		STA	PCL	;Store as new pcl		LDA	>USEROPRH	;Get user's operand high		STA	PCL+1	;Store as new pch		CPX	#$5C	;JMP al ?		BNE	XJMP1	;Bra if not JSL		LDA	>USEROPRK	;Else need to update program bank		STA	>BANKS	;Store it		STA	>KVAL	;Store to user program bank locationXJMP1		EQU	*		CPX	#$4C		BEQ	GOXEND	;JMP A		CPX	#$5C		BEQ	GOXEND	;JMP al		CPX	#$7C		BNE	XJMPai	;Bra for JMP (a) or JMl (a)		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		LDA	>USEROPRL	;Get user's oprh/oprl		CLC		;Set 'c'=0		ADC	>XVAL	;Add in 'x' register offset, (a,x)		STA	PCL	;Store as new pch/pclXJMPAI		EQU	*		LONGA	OFF		LONGI	OFF		SEP	#$30	;Off to 8 bit land		CPX	#$DC	;JML (a) ?		BNE	XJMPai1		LDY	#$2	;Set y=2 to read pck		LDA	(PCL),Y	;Get the new pck        		STA	>BANKS	;Store it		STA	>KVAL	;Store to user's program bank locationXJMPAI1		EQU	*** This code has 6C,7C,DC, and FC opcodes passing thru.  In the case*  of 6C and DC the location where the indirect address lies is in*  bank $00.  In the case of FC and 7C it is in the User's Current*  program bank.  {MSA/FAB 4/26/89}*		CPX	#$FC	;Check for JSR (a,x)		BEQ	@1		CPX	#$7C	;Check for JMP (a,x)		BNE	@2	;Bank defaults to $00*@1		EQU	*		PHB		LDA	>KVAL	;Get user's pgm bank		PHA		;Xfer to our data bank reg for lda below		PLB		LONGA	ON		LONGI	ON		REP	#$30	;Get 16 bits of effective address		LDY	#$0000		LDA	(PCL),Y	;Get effective address		STA	PCL	;Replace pointer		PLB		;Our old program bank		BRA	@3@2		EQU	*		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		LDY	#$0		LDA	(PCL),Y	;Get the new pc with the adjusting offset		STA	PCL	;Store to pch/pcl		LONGA	OFF		LONGI	OFF@3		EQU	*		SEP	#$30	;Back to 8 bit landGOXEND		EQU	*		PLA		;Retrieve user's XVAL+1		STA	>XVAL+1	;Store back 		JMP	XEND	;End of JMP..., back to step/trace worldXJSR1		EQU	*		SEC		;'c'=1, as an indicator		PHP		;Save for later use                      		CPX	#$20	;JSR a ?		BEQ	@1	;          		CPX	#$22	;JSL ?		BNE	@2	;Bra to check others                     @1		EQU	*		JMP	NOTREAL	;Jmp to check for PRODOS MLI call@2		EQU	*		PLP		;Clean stack		CPX	#$FC	;JSR (a,x) ?		BNE	XBRA	;Bra to check for 'BRANCH' instructionGOJSRL		EQU	*		PHX		;Save opcode		DEC	LENGTH	;Make return address = next pc - 1		JSR	PCADJ	;Adjust for new pc-1   		STA	PCL	;User return address after JSx		STY	PCH		PHA		;'A'= new pcl		TYA		;'Y'= new pch		JSR	DECSP	;Save pch/pcl-1 onto stack		PLA		;Get back pcl		JSR	DECSP		LDX	#$4C	;Simulate jsr....by jmp		PLA		;Retrieve opcode		CMP	#$20		BEQ	GOJMP	;$20 -> $4C		LDX	#$5C		CMP	#$22		BEQ	GOJMP	;$22 -> $5C		LDX	#$7C	;$FC -> $7CGOJMP		EQU	*		JMP	XJMP	;Simulate JSx w/ JMx after conversionXBRA		EQU	*		CPX	#$82	;Is it brl ?		BNE	XQ4	;Bra if no		LDA	#$00	;Make 'a'=0		STA	>USEROPRH	;Set to zero		LONGA	OFF		LDA	#XBRANCH-XOPRK	;Get offset for 'BRANCH'		BRA	SETOPRLXQ4		EQU	*		CPX	#$80	;Is it bra ?		BEQ	SETOFFSET	;		TXA		;Get back opcode		AND	#$1F	;Make 'Branch' bra to 'JMP BRANCH'		CMP	#$10		BNE	XQ5	;Bra for inst except RTx, JMx, JSx, BRANCHSETOFFSET		EQU	*		LONGA	OFF		LDA	#XBRANCH-XOPRH	;Calculate offset SETOPRL		EQU	*		STA	>USEROPRL	;Store to useroprlXQ5		EQU	*		CPX	#$62	;Is it 'PER'		BEQ	XQ6		CPX	#$4B	;PHK ?		BNE	USERINST	;Bra for other normal instructions		LDA	>KVAL	;Special PHK, need to save pck to stack		JSR	DECSP	;Do it and adjust sp also		BRA	XEND1	;Bra to end and back to step/trace worldXQ6		EQU	*** Must preserve the Emulation Stack Pointer in case we are going*  off to a native mode stack.  {MSA 4/28/89}*		JSR	STACKFUTZ	;{MSA 4/28/89}*		LONGA	ON		;16-bit m/x		LONGI	ON		REP	#$30		LDA	>SVAL	;Get user sp		TCS		;So simulate of 'PER' is in user stk space		LDA	PCL	;Get current address		INC	A	;Offset by 2		INC	A		SEC		;Make it correct addition    		ADC	>USEROPRL	;Add in offset		PHA		;Save to user stack space		BRA	XEND2	;Jmp to set new SVAL and ret to step/trace		PHAUSERINST		EQU	*** Must preserve the Emulation Stack Pointer in case we are going*  off to a native mode stack.  {MSA 4/28/89}*		JSR	STACKFUTZ	;{MSA 4/28/89}*		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		LDA	>SVAL	;Get back user stack pointer		TCS		;Do it and use usr stk space until restore step/trace sp		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land;; From restore to execute then store back, it would hope the ; user stack pointer and processor status not be changed, but; somehow the stack space has been touched;** Note that interrupts will be forced off by RESTOREFF.  Can't have*  them on because we're going to Bank $E1 and the user might have*  E=1 {MSA 4/12/89}*		JSR	RESTOREFF	;Restore user environment and registers 		JMP	>USEROPC	;Jmp to execute user instruction*	; SEG $FFNOBRANCH		EQU	*	; SEG $00		JSR	STOREFF	;Use usr stk area, return w/ native modeXEND2		EQU	*		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		TSC		;Save user's stack pointer		STA	>SVAL	;Store for displayXEND1		EQU	*		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land		JSR	FIXPC	;After each instruction, adjust pc for nextXEND		EQU	*** Must restore the emulation stack pointer in case we changed it.*  {MSA 4/28/89}*		LDA	>KPMNEMSP	;{MSA 4/28/89} Get saved value		STA	>MNEMSTKPTR	;{MSA 4/28/89}*		LONGA	ON		LONGI	ON		REP	#$30	;Off to 16 bit land		LDA	>STEPSP	;Continue w/ step/trace till 'esc' key		TCS		;Re-enter monitor stack space		LDA	>SVAL	;Check user stack space		CMP	#$0200	;Not in regular stack area then leave it alone		BCS	XEND01	;Bra if OK		CMP	#$010F	;In regular stack, is it end of the stk?		BCS	XEND01	;If not that close, still OK		LONGA	OFF		LONGI	OFFTOMON1		SEP	#$30		JSR	NEWBELL1	;Beep it		JMP	TOMON	;Stack tragedy, exit to monitorXEND01		EQU	*		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land		LDA	>JSX	;Chk regs display on/off options		AND	#$40	;Mask for bit6         		BNE	@2	;BRA if no need to display regs		JSR	REGDSP2	;Make a regs and status display after an instruction@2		EQU	*		CLI		;Enable interrupt		RTL		;Ret to STEPMORE to continue in step mode	; SEG $FFXOPC		EQU	*	; SEG $00		NOP		;XOPC, opcodeXOPRL		EQU	*		NOP		;XOPRL, operand (L) of opcodeXOPRH		EQU	*		NOP		;XOPRH, operand (H) of opcodeXOPRK		EQU	*		NOP		;Bank byte, operand (K) of opcode		JMP	>NOBRANCH	;Jump to handle nobranch instructionXBRANCH		EQU	*		JMP	>BRANCH	;Jump to handle branch instruction	; SEG $FFRETMLI		EQU	*	; SEG $00		JMP	>JSLRET	;Return from MLI16 call*	; SEG $FFBRANCH		EQU	*	; SEG $00		PEA	$0000	;Set back monitor data bank in case user change it		PLB		PLB		PEA	$0000	;Reset direct register also		PLD		CLC		XCE		;Native mode, in case user set to emulation mode		LONGA	OFF		LONGI	OFF		SEP	#$30	;Back to 8 bit land		LDY	LENGTH	;Get 'branch' opcode length, only brl needs 2 bytes		JSR	READPCY	;Read high byte first		DEY		;		BEQ	@1	;Bra if only one byte offset, e.g. bcs, bvs....		PHA		;Save hi byte		JSR	READPCY	;If 2 bytes offset, read in low byte now		SEC		;'c'=1		ADC	PCL	;Adjust PC w/ offset		TAX		;Temp store ocl		PLA		;Get back high byte		ADC	PCH	;Adjust high byte, 'c'=1		TAY		;Temp save		TXA		;Get back low		CLC		;'c'=0		ADC	#2	;Add 2 more for 2 bytes offset		TAX		;pcl to 'x'		BCC	@3	;If 'c'=1, need to adjust high byte by 1		BRA	@2	;Else just store@1		EQU	*	;One byte offset handling		SEC		;'c'=1		JSR	PCADJ3	;One byte length pc adjust		TAX		;PCL,PCH+OFFSET+1 TO A,Y		INX		BNE	@3@2		EQU	*		INY@3		EQU	*		STX	PCL	;Store it as new pcl		STY	PCH	;Store it as new pch		JMP	XEND	;End the 'BRANCH' world and return*** RESTOREFF and STOREFF have been moved to the SLOT.ARBITER file {MSA 4/12/89}*INCSP		EQU	*		PHB		;Save current data bank		JSR	DBTOE1	;Change data bank to $e1		INC	|SVAL	;SP low byte boundary checking, i.e. $xxff		BNE	LDASP	;Bra if not at boundary		LDA	|EPVAL	;Check for emulation/native		BEQ	LDASP	;Bra if in emulation mode		INC	|SVAL	;Else adjust hgh byte of stk ptr by 1LDASP		EQU	*		LDA	|SVAL	;Copy SVAL/SVAL+1 to A1H-A2L for next addressing mode		STA	A1H	;Form an direct indirect long		LDA	|SVAL+1		STA	A2L	;		STZ	A2H	;Force to $00		LDA	[A1H]	;Get the value pointed by usr stk pointer		PLB		;Restore data bank		RTS		;Back to caller, step/trace of monitorDECSP		EQU	*		PHB		PHA		;Save 		JSR	DBTOE1		LDA	|SVAL		STA	A1H	;Copy user stk ptr to monitor direct page		LDA	|SVAL+1	; so that an direct indirect long can be used to store pc		STA	A2L	;		PLA		STZ	A2H	;Force to $00		STA	[A1H]	;Save return address to user stack area		DEC	|SVAL	;Need to adjust stack pointer		LDA	|SVAL	;Check for boundary		CMP	#$FF		BNE	DECSRRTS		LDA	|EPVAL		BNE	DECSRRTS		DEC	|SVAL+1DECSRRTS		EQU	*		PLB		RTS		TITLE	'Misc Monitor Bank FF Rtnes00'*******************************************************                                                    **        Miscellaneous Monitor Bank FF Routines01    **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************EQUALSFF		EQU	*		LDY	YSAV	;Continue where command parser left off@1		EQU	*		LDA	IN,Y	;Ignore spaces and find command		CMP	#$A0	;		BNE	@2	;<> $A0 then may have something		INY		;Keep testing		BNE	@1	;Loop@2		EQU	*		INY		;Must be looking at next char in IN		STY	YSAV	;Save pointer		LDX	#NEWCMDLEN-1	;Maximum number of new commands to check@3		EQU	*		CMP	>NEWCMDSTBL,X	;Check for matches		BEQ	GOODCMD	;		DEX		;		BPL	@3	;Loop to try to find one* Fall to here if all else fails		DEY		;Offset for INY done in NEWCMDTST earlier@4		EQU	*		LDA	IN,Y	;Eat any preceeding spaces		CMP	#SPACE	;		BNE	@5	;<>= then continue normally		INY		;		BRA	@4	;@5		EQU	*		SEP	#$40	;Anticipate unsigned conversion requested		CMP	#'+'	;If '+' or '-' then do signed stuff		BEQ	@6	;		CMP	#'-'	;		BNE	@7	;@6		EQU	*		CLV		;'v'=0 to indicate signed conversion@7		EQU	*		IF IS512 <> 0 THEN		ELSE		JSR	PUSH6	;Push room for result on stack		SEP	#$30	;Undo PUSH setting it in to 16 bit mode		LDA	#>IN	;High byte of low word of ptr to buffer		PHA		;		PHY		;Low byte of word of ptr to buffer		LDX	#$00	;Count bytes@8		EQU	*		INX		;Increment count index		INY		;		LDA	IN,Y	;Test for carriage return		CMP	#$8D	;		BEQ	@9	;= then continue		EOR	#$B0	;Test for valid decimal entry		CMP	#$0A	;0-9 is OK		BCC	@8	;Loop til end is found@9		EQU	*		REP	#$30	;Go to 16 bit land to make call		PHX		;Push number of bytes to convert		BVC	@10	;'v'=0 then signed conversion		PEA	$0000	; else unsigned conversion		BRA	@11	;@10		EQU	*		PEA	$0001	;<>0 for signed conversion@11		EQU	*		LONGI	ON		LDX	#DEC2LONG*256+IMTN	;Function number*256+tool number		LONGI	OFF		JSL	>DISPATCH1	;Call tool locator		SEP	#$30	;Back to monitor mode		LDA	#HEXMSG	;Print 'Hex-> $'		JSR	PRINTMSG	;		LDA	3,S	;Low byte of high word		TAX		;		LDA	4,S	;High byte of high word		JSR	PRNTAXFF	;Print em		PLX		;Low byte of low word		PLA		;High byte of low word		JSR	PRNTAXFF	;Print em		PLA		;Clean up stack		PLA		;		ENDIFDECTOHEX6		EQU	*		JSR	LIST3	;Next line+space please* To return directly to the monitor in the calling* bank we must clean up the stack.* This routine pulls the following info from the stack.*      # of bytes          Type of information*         2                 RTS data from bank FF*         1                 State register data*         3                 RTL data for return to calling bank*         1                 Speed data*         1                 'A' data*         2                 RTS data from calling bankMONZ2RTN		EQU	*		LDX	#$0A	;10 bytes to remove@1		EQU	*		PLA		;Remove 1 byte from stack		DEX		;Decrement counter		BNE	@1	;Loop til done		JMP	MONZ2FF	;Restart monitor command line functionGOODCMD		EQU	*		CPX	#$05	;0-4 for 2 byte data changes		BCC	@3	;		CPX	#$10	;Is it set video screen data ?		BEQ	@0	;BRA if yes		CPX	#$11	;5-$0f for 1 byte data changes		BCS	@1	;		TXA		;Create correct offset for indexing		ADC	#$05	;Add 5 bytes used by 2 byte commands		TAX		;Index now fixed		BRA	@4	;Exit via 2 byte command routines@0		EQU	*		LDA	A2L	;Get the data to write to		STA	>SCRNSTAT	;Store it		RTS		;@1		EQU	*		BNE	@2	;		JMP	TCMD	;=$0F then time command@2		EQU	**  >$0F then assume hextodec command		LDA	#DECMSG	;'Decimal-> ' message		JSR	PRINTMSG	;		IF IS512 <> 0 THEN		ELSE		CLV		;Clear 'v' to print unsigned		JSR	HEXTODEC7	;Print result		JSR	PR1BLNKFF	;Print 1 blank spaces		LDA	#'{'	;Print bracket for signed result		JSR	COUTFF	;		SEP	#$40	;Set 'v' to print '+'		JSR	HEXTODEC7	;Print result		ENDIF		JSR	RELADR2	;Print '}'		BRA	DECTOHEX6	;Next line+space then back to caller@3		EQU	*		TXA		;X * 2 for indexing		ASL	A	;		TAX		;		REP	#$20	;16 bit mode a must@4		EQU	*		LDA	A2L	;Data to write is here		CPX	#$0A+5	;'L' command offset		BCC	@5	;<$0A+5 then not 'L','m','x','e'		CPX	#$0F+5	;		BEQ	@5	;= to 'F' cmd then save whole byte		AND	#$01	;@5		EQU	*		STA	>AVAL,X	;Data goes here		SEP	#$30	;8 bit mode is normal monitor mode		LDA	7,S	;Get current user speed value		AND	#$7F	;Strip off hi bit		PHA		;Save on stack		LDA	>QVAL	;		AND	#$80	;Hi bit only important one		STA	>SYSTEMSPD	;Set system speed mask		ORA	1,S	;Create new speed byte		PLX		;Clean up stack		STA	7,S	;Save new speed byte		RTS		;Back to callerHEXTODEC7		EQU	*		PHP		;Preserve 'v'/'m/'x' status		REP	#$30	;16 bit land required for call		LDA	>EXTENDBNK	;High word to convert		PHA		;		LDA	A2L	;Low word to convert		PHA		;		PEA	$0000	;High word of pointer to buffer		PEA	IN	;Low word of pointer to buffer		PEA	$0010	;Size of buffer		LONGA	ON		LDA	#$0001	;<>0 if signed value requested		LONGA	OFF		BVS	@1	;'v'=1 then print signed value		DEC	A	;=0 for unsigned result requested@1		EQU	*		PHA		;Req data type (signed/unsigned) to stack		LONGI	ON		LDX	#LONG2DEC*256+IMTN	;Function number*256+tool number		LONGI	OFF		JSL	>DISPATCH1	;Call tool locator		PLP		;Recall 'v'/'m'/'x' status		LDX	#$FF	;Start index at 0-1@8		EQU	*		INX		;		CPX	#$10	;Stop at $10 always		BCS	@9	;		LDA	IN,X	;Ignore spaces		CMP	#$20	;		BEQ	@8	;Loop til no spaces		BVC	@8_2	;'v'=0 then no signs		CMP	#$2D	;If not '-' then output '+'		BEQ	@8_2	;		LDA	#'+'	;Plus indicator		PHX		;Preserve 'X'		JSR	COUTFF	;		PLX		;Restore 'X'@8_1		EQU	*		LDA	IN,X	;Recall character to print@8_2		EQU	*		ORA	#$80	;Need high bit on to print		PHX		;Preserve 'X'		JSR	COUTFF	;		PLX		;Recall 'X'		INX		;		CPX	#$10	;Stop at $10 always		BCC	@8_1	;Loop if not done yet@9		EQU	*		RTS		;Back to caller		TITLE	'Misc Monitor Bank FF Rtnes1'*******************************************************                                                    **        Miscellaneous Monitor Bank FF Routines1     **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************DECDISASM		EQU	*	;Dec PCL/PCH-disassemble inst-inc PCL/PCH		LDA	MODE	;'-' if PASCAL '+' if BASIC		BPL	@2	;+ then no changing at all		CMP	#$FF	;$FF=vanilla Apple// mode		BEQ	@2	;Do nothing in this mode		BIT	RD80VID	;In 80 (-) columns or 40 (+) columns?		BPL	@1	;		REP	#$30	;Save the Pascal screen		LONGI	ON		LDX	#SVESCRNFN*256+DSKTN	;'X'=function #*256+tool number		JSL	>DISPATCH1	;Do the call		SEP	#$30	;Back to normal monitor mode		LONGI	OFF		LDA	#$8D	;		JSR	C300FF	;Enable BASIC 80 columns		JSR	SAVESHOLES	;Save slot 0/3 screen holes		REP	#$30	;Restore the Pascal screen		LONGI	ON		LDX	#RSTSCRNFN*256+DSKTN	;'X'=function #*256+tool number		JSL	>DISPATCH1	;Do the call		SEP	#$30	;Back to normal monitor mode		LONGI	OFF		JSR	RSTRSHOLES	;Restore slot 0/3 screen holes		BRA	@2	;@1		EQU	*	;Enable BASIC 40 columns		JSR	X_NAK2	;Set up 40 columns screen / set I/O hooks@2		EQU	*		REP	#$30	;Off to 16 bit land		LDA	>irq_PC	;Interrupt program counter		PHA		;		DEC	A	;Offset program cntr by 2 after saving it		DEC	A	;		STA	PCL	;Save for disassembly		SEP	#$30	;Back to 8 bit land		PHB		;Save data bank register		JSR	DBTOE1	;Change data bank register to E1		LDX	#IRQLEN-1	;# of bytes to move -1@3		EQU	*		LDA	|irq_A,X	;Interrupt data		STA	|AVAL,X	;Register data buffer		DEX		;		BPL	@3	;Loop til done		STX	|ORGMEMORY	;<>0 so BRK/COP mem conf used in monitor		LDA	|irq_state	;Move state register		STA	|MVAL	; to print register buffer.		AND	#$04	;Get language card bank for LVAL		LSR	A	;Shift bit 2 to bit 0		LSR	A	;		STA	|LVAL	;Save in print buffer		LDA	|irq_shadow+1	;Get interrupt CYAREG		AND	#$80	;Speed bit is high bit		PHA		;		LDA	|irq_shadow	;		ORA	1,S	;Combine with speed bit for QVAL		STA	|QVAL	;Save for later		PLA		;Clean up stack		LDA	|irq_K	;Get program bank		STA	|KVAL	;Save in print buffer		STA	|BANKS	; and make disassembly bank.		LDA	|PVAL	;Fix 'm'/'x' print registers		AND	#$30	;		LSR	A	;Shift 'x' into 'c' and 'm' into bit 0		JSR	SCRN4	;Shifts right 4 times		STA	|MPVAL	;Save new 'm' value		LDA	#$00	;		ROL	A	;		STA	|XPVAL	;		LDA	|irq_e	;Move 'e' bit to print buffer		AND	#$01	;'e' is low bit		STA	|EPVAL	;		ROR	A	;e to c		REP	#$30		LDA	|SVAL	;Get real brk irq_stack pointer		INC	A	;Adjust back to usr stack pointer		INC	A		INC	A		BCS	@0	;BRA if emulation mode		INC	A	; else adjust one more@0		EQU	*		STA	|SVAL	;Store back usr's sp before brk		SEP	#$30* When a 'brk' is hit, the screen i/o switch is saved but not the * screen image itself.  Cntl_T is now re-defined as flipping the* textpage1 and the screen display when brk occurred, it is toggled* by the 'Flipscrn' flag.* 'Scrnstat' is used to save the screen i/o switches states:* bit7 = super hi res* bit6 = text not graphic* bit5 = mixed mode* bit4 = hi res* bit3 = textpage2/textpage1* bit2 = x* bit1 = x               * bit0 = x               ** The 'brk' screen states are resumed if the 'Resume' command, 'r'* is executed to continue the program		STZ	|FLIPSCRN	;Set toggle bit to 0, cntl_t		STZ	|SCRNSTAT	;Set to zero first		LDA	#$00	;Assume zero first		LDX	|RDPAGE2	;Get text page bit		BPL	@6	;bra for text page 1		ORA	#$08	;else set the bit for text page 2@6		LDX	|RDHIRES	;Get hires/lores bit		BPL	@7	;bra for lores		ORA	#$10	;set hires bit   @7		LDX	|RDMIX	;Get mixed mode bit		BPL	@8	;bra if not mixed mode		ORA	#$20	;else set mixed mode on@8		LDX	|RDTEXT	;Get text/graphic bit		BPL	@9	;bra for graphic mode		ORA	#$40	;else set text mode@9		LDX	|NEWVIDEO	;Get super hi-res		BPL	@11	;bra if off		ORA	#$80	;else set bit on@11		EQU	*		STA	|SCRNSTAT	;Store the results here		JSR	SETPAG1	;Force to text page 1		PLB		;Get back data bank		JSR	DISASEM		LDA	#$00	;Reset MEMORYMSK for regular disassemblies		STA	>ORGMEMORY	;=0 so monitor use special mem config		PLA		;Restore PCL/PCH		STA	PCL	;		PLA		;		STA	PCH	;Fall to register display routineREGDSP2		EQU	*		JSR	CROUTFF	;Next line please		LDX	#$00	;Start with 1st variable@3		EQU	*		PHX		;MUST save 'X' index		JSR	PR1BLNKFF	;Print one space		LDA	>NEWCMDSTBL,X	;Get variable name		JSR	COUTFF	;Show user		LDA	#'='	;Show required '=' sign		JSR	COUTFF	;		PLX		;Recall index		PHX		;MUST save 'X' index		CPX	#$0A	;1 nybble to show?		BCS	@7	;'c' = 1 then yes		CPX	#$05	;2 byte/1byte to show		BCS	@5	;		TXA		;Real index = actual index * 2		ASL	A	;		TAX		;		LDA	>AVAL+1,X	;Hi byte to show		JSR	PRBYTEFF	;Show to user		LDA	>AVAL,X	;Byte to show		BRA	@5_2	;@5		EQU	*		LDA	>AVAL+5,X	;Byte to show@5_2		EQU	*		JSR	PRBYTEFF	;Show to user@6		EQU	*		PLX		;Increment and test for done		INX		;		CPX	#$0E	;If incremented to $0E then done		BCC	@3	;		RTS		;Back to caller if here@7		EQU	*		LDA	>AVAL+5,X	;Get byte/nybble to show		JSR	PRHEXFF	;Print 1 digit		BRA	@6	;Exit to main loop		EJECT* SYSDEATH is called by the miscellaneous tool* locator in native mode with 16 bit 'm'/'x'* and the following information on the stack.**    9,S  -  Error hi byte*    8,S  -        lo byte*    7,S  -  Null byte of message address*    6,S  -  Bank byte of message address*    5,S  -  Hi byte of message address*    4,S  -  Lo byte of message address*    3,2,1,S -  Unused return address**    'c' = 0 = Use user defined message*        = 1 = Use default message**    User defined system death message is in*    is defined as follows.**    1st byte = length of message*    2nd...xth byte = hi bit off ASCII message**    After the messages (either one) is displayed*    the system death error number is printed and*    the moving apple is displayed on the screen.	; SEG $FFSYSDEATH		EQU	*	; SEG $00		SEI		;No interrupts please		LONGA	ON		LDA	#$0000	;Set direct register		STA	>BUSYFLAG	;Clear out system busy flag		LONGA	OFF		TCD		;		PHA		;Change DBR to 00		PLB		;		PLB		;		LDA	4,S	;Move message address to zero page		STA	$FB	;Hard code		LDA	6,S	;		STA	$FD	;		LDA	8,S	;Get error code in 16 bit 'A'		LONGI	ON		LDX	#$17F	;Force stack		LONGI	OFF		TXS		;Switch stack to safe place		PHA		;Save 16 byte error number on stack		SEP	#$30	;Go to 8 bit land		PHP		;Save 'c' status for correct message		LDA	#$80	;Set system speed mask		STA	>SYSTEMSPD	;		STA	SETINTCXROM	;Enable internal CXROM		LDA	#$08	;Enable ROM		TSB	STATEREG	;;JSR GOTXT1 ;Go to text page 1		JSR	SETPAG1		JSR	X_NAK2	;Set up 40 columns screen / set I/O hooks		JSR	HOMEFF	;Clear the 40 column screen		PLP		;Recall 'c' status		BCS	NODISK3	;'c'=1 then use monitor's sys death msg		LDA	[$FB]	;Set ending index		INC	A	;Add 1 for correct testing		STA	$FF	;		LDY	#$01	;Start with first character to show@1		EQU	*		LDA	[$FB],Y	;Get a byte		ORA	#$80	;Set hi byte before printing		PHY		;Save pointer		JSR	COUTFF	;Print the byte		PLY		;Recall the pointer		INY		;Inc to next byte		CPY	$FF	;Test if done		BCC	@1	;Loop til done		CLI		;Re-enable ints so dsk acc are available		BCS	NODISK7	;Fall into regular loopNODISK2		EQU	*		CLC		;'c'=0 if 'Check startup device!' errorNODISK3		EQU	*		PHP		;Save 'c' status		JSR	SETVIDKBDFF	;Set 40 column video and keyboard		JSR	HOMEFF	;Clear the screen		LDX	#$00	;		LDY	#$05	;Vertical tab		JSR	SETVTAB	;Move to position		PLP		;Recall 'c' status		PHP		; and resave it for later		BCS	@4	;'c'=1 if system death		LDA	#CHKDEVMSG	;'Check startup device!' message		BRA	@6	;@4		EQU	*		LDA	#SYSDMSG	;'Fatal system error -> ' message@6		EQU	*		JSR	PRINTMSG	;		PLP		;Recall 'c' status		BCC	NODISK9	;'c'=0 then no more to printNODISK7		EQU	*		PLX		;Low byte of error number to 'X'		PLY		;High byte of error number to 'Y'		JSR	PRNTYXFF	;NODISK9		EQU	*		STA	SETALTCHAR	;Enable alternate character set		JSR	NEWBELL1	;Ring them chimes		LDA	#$6	;Do message on this line		STA	WNDTOP	;		LDY	#$00	;Starting offset@22		EQU	*		BEQ	@23	;		LDA	#$DF	;Alternate character		STA	$5A9-1,Y	;@23		EQU	*		LDA	#$41	;Open Apple character		STA	$5A9,Y	;Put up new Apple		JSR	@33	;		INY		;		CPY	#$26	;26 last index to use		BCC	@22	;		DEY		;@24		EQU	*		LDA	#$4C	;Alternate character		STA	$5A9,Y	;		LDA	#$40	;Closed Apple character		STA	$5A9-1,Y	;Put up new Apple		JSR	@33	;		DEY		;		BNE	@24	;		BRA	@22	;@33		EQU	*		LDA	KBD	;If ctrl pressed do test		STA	KBDSTRB	;		CMP	#$8E	;Control-'N'		BNE	@34	;		LDA	BUTN1	;If closed apple down test open apple		BPL	@34	;		LDA	BUTN0	;If open apple down too		BPL	@34	;		JSR	@40	;Do tests@34		EQU	*		LDA	RDVBLBAR	;Wait if in VBL		BPL	@34	;@32		EQU	*		LDA	RDVBLBAR	;Wait if not in VBL		BMI	@32	;		RTS		;@40		EQU	*	;Do tests		PHY		;MUST preserve pointer around call		JSR	HOMEFF	;Clear the specific screen first		LDA	#6	;Position for messages		STA	CV	;		STZ	CH	;		JSR	VTABFF	;		JSL	>$FE0018	;{MSA 4/20/89} A touch of audio makes it		LDA	#N1	;Pointer number		JSR	@60	;Make a delay		LDA	#15	;Position the message		STA	CV	;		LDA	#2		STA	CH	;		JSR	VTABFF	;		LDA	#N2	;Pointer number		JSR	@60	;Print / delay /clear		PLY		;Restore y		RTS		;@60		EQU	*		JSL	>TOPRINTMSG8	;Print message		LDA	#$80	;Slow wait		TRB	CYAREG	;		LDX	#$10	;Wait and then clear screen@50		EQU	*		LDA	#$FF	;Wait and then clear screen		JSR	WAIT	;		DEX		;Loop til done		BNE	@50	;		LDA	#$80	;Speed back up		TSB	CYAREG	;		JSR	HOMEFF	;Clear screen and continue		RTS		;Back to caller* ADDSUB add (if 'c'=0) or subtracts (if 'c'=1)*        up to 32 bit numbers the user entered.		LONGA	ONDOADD		EQU	*		CLC		;'c'=0 to addADDSUB		EQU	*		REP	#$30	;16 bit land required		LDA	>EXTENDBNK	;Get high word of user's second number		BCC	@2	;'c'=0 then do not change		EOR	#$FFFF	;Make 2's complement for subtract@2		EQU	*		PHA		;Save on stack for later		LDA	A2L	;Recall low word of 1st number entered		BCC	@4	;'c'=0 then do not change		EOR	#$FFFF	;Make 2's complement for subtract@4		EQU	*		ADC	A1L	;Add low word of 2nd number entered		STA	A2L	;Save in case someone looks here		LDA	>EXTENDBNKS	;Recall 1st number's high word		ADC	1,S	; and add 2nd numbers high word		STA	1,S	;Save result on stack		SEP	#$30	;Back to monitor mode		LONGA	OFF		JSR	PRINTDASHDOL	;Print '-> $'		PLX		;Recall low byte of high word to print		PLA		;Recall high byte of high word to print		JSR	PRNTAXFF	;Print word		LDA	A2H	;Recall high byte of low word to print		LDX	A2L	;Recall low byte of low word to print		JSR	PRNTAXFF	;Print word and exitADDSUB9		EQU	*		JMP	LIST3	;Carriage return followed by spacePRINTDASHDOL	EQU	*		LDA	#ARWDASHDOL	;Print '-> $'		JMP	PRINTMSG	;MATH		EQU	*		CMP	#'-'	;Test for subtraction		BEQ	ADDSUB	;'c'=1 to subtract		CMP	#'+'	;Test for addition		BEQ	DOADD	;		CMP	#'*'	;Test for multiplication		BEQ	@1	;'c'=1 for multiplication		CLC		;'c'=0 for division* @1 multiplies or divides 32 bit numbers*         depending on the setting of 'c'*               'c'=0 if division*               'c'=1 if multiplication@1		EQU	*		PHP		;Preserve entry 'c' status		LDX	#$04	;Push 8 bytes of room on stack		JSR	PUSH	; and switch to 16 bit mode.		LDA	>EXTENDBNKS	;Push hi word of 1st number on stack		PHA		;		LDA	A1L	;Push lo word of 1st number on stack		PHA		;		LDA	>EXTENDBNK	;Push hi word of 2nd number on stack		PHA		;		LDA	A2L	;Push lo word of 2nd number on stack		PHA		;		LONGI	ON		LDX	#LONGMUL*256+IMTN	;Function number*256+tool number		BCS	@12	;'c'=1 then doing multiplication		LDX	#LONGDIV*256+IMTN	;Function number*256+tool number		LONGI	OFF@12		EQU	*		JSL	>DISPATCH1	;Off to tool locator		SEP	#$30	;Back to 16 bit world		LDX	#$00	;Recall 8 bytes from stack@13		EQU	*		PLA		;Recall result from call		STA	A1L,X	;And save in zero page		INX		;		CPX	#$08	;Stop when 'X'=8		BNE	@13	;Loop til done		PLP		;Recall entry 'c' status		PHP		; and resave it.		BCS	@14	;Skip 'R'		LDA	#'R'	;'R' for remainder		JSR	COUTFF	;@14		EQU	*		JSR	PRINTDASHDOL	;Print '-> $' ASCII		LDX	#$07	;Print 8 bytes@18		EQU	*		LDA	A1L,X	;		PHX		;Preserve 'X'		JSR	PRBYTEFF	;Print byte		CPX	#$04	;Print a 'Q-> $' after 4 bytes		BNE	@16	;		LDA	2,S	;Recall multiplication/division indicator		ROR	A	;Shift saved carry bit into 'c'		BCS	@16	;Multiplication then continue normally		JSR	PRBLNKFF	;Print '   '		LDA	#'Q'	;Print quotient indicator		JSR	COUTFF	;		JSR	PRINTDASHDOL	;Print '-> $' ASCII@16		EQU	*		PLX		;Recall 'X'		DEX		;		BPL	@18	;Loop til done		PLP		;Clean up stack		BRA	ADDSUB9	;Carriage return followed by space to end		RTSPUSH6		EQU	*	;Push room for 6 bytes on stack		LDX	#$03	;Push 6 bytes on stackPUSH		EQU	*	;Push room for 'X'*2 bytes on stack		REP	#$30	;16 bit land a must		PLA		;Recall return address from stack@1		EQU	*		PEA	$0000	;Push 2 bytes of space on stack		DEX		;		BNE	@1	;		PHA		;Put RTS address back on stack		RTS		;Back to caller in 16 bit mode		EJECT** This code is called by the tool locator via* vector $E1007C.  It will search for an expansion* rom in bank $F8-$FF according to the following* protocol.** The bank $F8 expansion rom must have the following* information located at the base of the rom.** $F80000-F80007 ... An ASCII string 'ROMTOOLS'* $F80008-F80009 ... Version Number* $F8000A-F8001F ... Pad Area* $F80020 .......... Entry Point** The entry point is called in 16 bit native mode.* (e=0, m=0, x=0) The entry point will execute* code to install any rom based extensions to the* tool set and return with an 'RTL' instruction* with the carry flag cleared.  If the rom is found,* the version number will be returned in the 16 bit* C register after the 'RTL' is executed.** Note that the string at $F80000 must have the* msb set to a '1'.*		MSB	on		LONGI	ON		LONGA	ON	; SEG $ffROMTOOL		EQU	*	; SEG $00		LDX	#$0006	; point at end of string@1		EQU	*		LDA	>ExRomStr,x	; get expansion rom data		CMP	>string,x	; and check against string		BNE	@2	; no rom if miscompare		DEX		DEX		BPL	@1		JSL	>ExRomEntry	; off to the expansion rom		LDA	>ExRomVer	; return version in 'c' register		RTL@2		EQU	*		SEC		; error if no rom		RTL	; SEG $FFSTRING		EQU	*	; SEG $00		DC.B	'ROMTOOLS'		LONGI	OFF		LONGA	OFF		TITLE	'Misc Monitor Bank FF Rtne2'*******************************************************                                                    **        Miscellaneous Monitor Bank FF Routine2      **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ******************************************************** RESUMEFF does and equivalent JMP absolute long*          to the user specified routine with the*          environment set up according to the*          register/memory data stored in bank E1.** X816FF  does an equivalent JSL to the subroutine*         indicated by the user.  Using a JSL equivalent*         means the subroutine can be in any bank.*         X816FF assumes the user's routine ends in an*         RTL which is used to return to the monitor.** GO816FF does an equivalent JSR to the subroutine*         indicated by the user.  Using a JSR equivalent*         means that it can be used in the current*         monitor bank only (normally bank 00). This*         command assumes the user's routine ends in*         an RTS which is used to return to the monitor.**  Note: X816FF/GO816FF will automatically switch to native*        mode if 'e'=0 execute the program and return*        back to emulation mode and the monitor if*        the native mode routine executes an RTS/RTL as*        its last instruction.** RTL/RTS information on stack for the 'X'/'G' command.*       _____________*      |             |*      | Monitor Bnk |  <----- Only put on stack if 'X' command!!!!!!*      |_____________|*      |             |*      |   <GORTL    |  <----- High byte of return address*      |_____________|*      |             |*      |   >GORTL    |  <----- Low byte of return address*      |_____________|*** RTI information on stack for either command ('X'/'G').*       _____________*      |             |*      | Program Bnk |  <----- Only put on stack if native mode 'X'/'G'*      |_____________|*      |             |*      |     PCH     |*      |_____________|*      |             |*      |     PCL     |*      |_____________|*      |             |*      |  'P' status |*      |_____________|RESUMEFF		EQU	*	;Also entry point from step/trace 'G'		PHX		;Preserve 'x', needed in FIXE1PCLH		JSR	BRKSCRN	;Restore the scrn when 'brk' occurred		PLX		;Restore x		JSR	FIXE1PCLH		BRA	GO816_4	;Continue in 'G'o codeX816FF		EQU	*		CLC		;'c'=0 if entered here		LDA	>BANKS	;If <>0 and emulation beep and quit now		BEQ	GO816FF1_0	;In bank 00 then ok		LDA	>EPVAL	;If <> bank 00 + emulation mode then beep		BEQ	GO816FF1_0	;		JMP	NEWBELL1	;Beep and exit via bell routineGO816FF		EQU	*		SEC		;'c'=1 if entered here		LDA	>BANKS	;If <>0 then 'G'o not allowed		BEQ	GO816FF1_0	;In bank 00 then ok		JMP	NEWBELL1	;Beep and exit via bell routineGO816FF1_0	EQU	*		PHB		;Save original data bank register on stack		LDA	STATEREG	;Save state register		PHA		;		JSR	FIXE1PCLH	;Move PCL/PCH to bank E1 in case alt zp		LDX	SHADOW	;Save SHADOW/CYAREG register		PHX		;		TSX		;Save stack pointer		STX	|GOS	;Save for later restoring		PHP		;Save 'c'/'v' status, v from FIXE1PCLH		LONGA	ON		CMP	#$0200	;Not in regular stk area then leave alone		LONGA	OFF		BCS	GO816_0_4	;'c'=1 then stack is not in regular stack		CMP	|GOS	;User stk ptr must be less than monitor's		BVS	GO816_0_4	;Using alternate stack then skip it		BCC	GO816_0_4	;< monitor's then all's OK for now		LDA	|GOS	;Make user stack pointer = monitor'sGO816_0_4		EQU	*		PLP		;Restore 'c'/'v' status		PHA		;Save 16 bit stack pointer		LDA	6,S	;Get monitor data bank register		TAX		;And save for RTL later		PLA		;Recall 16 bit stack pointer		SEP	#$30	;Back to 8 bit land		BVC	GO816_1_2	;'v'= 0 if not alternate stack pointer		STA	SETALTZP	;Now in alternate stackGO816_1_2		EQU	*		TCS		;Now in user stack space		BCS	GO816_2	;'c'=1 for RTS to stack		PHK		;Save return info on stack		PEA	GO816_EXT-1	;		BCC	GO816_3	;'c'=0 then RTL directly back to monitorGO816_2		EQU	*		PHK		;Bank to return to		PEA	GO816_EXT	;Return address		LDX	#$5C	;JMP absolute long opcode		PHX		;Save on stack		PEA	$FB18	;XCE CLC to stack space		REP	#$20	;Do in 16 bit mode		TSC		;Where will the stack routine be?		PHA		;Save RTS information on stackGO816_3		EQU	*		JSR	COMBINEMX	;{MSA & JOA 3/31/89} Put user's MX into PVAL		TSC		;Alter user stk ptr for our RTS/RTL stuffGO816_4		EQU	*	;Resume continuation entry point		SEP	#$30	;8 bit land in here		BVC	GO816_5	;'v'=0 then main stack is one to use		STA	SETALTZP	;Now in alternate stackGO816_5		EQU	*		TCS		;Set proper stack pointer		LDA	|GOS	;Fix stack pointer in case using alt stk		STA	>MNEMSTKPTR	;Put in main stk pointer save address		LDY	|EPVAL	;Native or emulation mode ?		BNE	GO816_6	;'Y' = 1 if emulation mode of execution		LDA	|BANKS	;Native mode, push in program bank		PHAGO816_6		EQU	*		REP	#$20	;16 bit m		LDA	|E1PCLH	;Get user's program counter		PHA		;Create user's pc for 'RTI'		SEP	#$30	;** The commented code is reworked so that the check of mode is done before RESTOREFF,*  and to fix the interrupt window anomaly. {MSA/FAB 4/12/89}*		LDA	>EPVAL	;Check for emul/native return		BNE	GO816_M	;It's emulation: must rti from bank $00		JMP	MFRTI	;Finish up and vector*GO816_M		EQU	*		LDA	>PVAL	;Set to pull the user's psreg		PHA		JSR	RESTOREFF	;Restore regs and set to proper mode also;PHP  ;Push in as dummy for 'RTI';LDA =EPVAL ;Chk for emul/native mode;BNE GO816.7 ;BRA if in emulation mode;RTI  ;Go to user's routine in native modeGO816_7		EQU	*		JMP	>RTI~Bnk00	;Force prog bk=00 and rti to usr's routineGO816_EXT		EQU	*	;Restore normal monitor context		CLD		;NO NO NO decimal mode in here		CLC		;Just in case switch to native mode		XCE		;		SEP	#$30	;Always enters in native mode		STA	SETSTDZP	;Arbitrarily force main stack 		REP	#$30	;Off to 16 bit land		JSR	DBTOE1	;Force data bank register for softswitches		LDA	|GOS	;Recall stack pointer		TCS		;Change to original stack pointer		PLA		;Recall SHADOW/CYAREG		STA	SHADOW	;		SEP	#$30	;Back to 8 bit land to continue* Need to update textp2 shadowing at $c035,  since user can get into * monitor and call the entry point at $f962.                 * The $f962 is a toggling routine for bit5 of $c035 and therefore* need to update that bit for users' preference.		JSR	SETTEXT2REG	;User can execute $f962 with 'G' or 'X'		PEA	$0000	;Reset direct register		PLD		;		PLA		;Recall STATEREG		JSR	MEMEXIT1	;Restore memory state and fix page 1/2		PLB		;Recall data bank register		RTS		;Back to original monitor command lineFIXE1PCLH		EQU	*	;Move PCL/PCH to bank E1 in case alt zp		SEI		;Kill interrupts		JSR	A1PC	;Set up monitor PCL/PCH		JSR	DBTOE1	;Change data bank register to E1		SEP	#$40	;Anticipate alternate stack pointer		LDA	|MVAL	;See if alternate stack or not		BMI	FIXE1PCLH2	;- then alternate stack in use (let 'v'=1)		CLV		; else clear 'v' as indicator.FIXE1PCLH2	EQU	*		REP	#$30	;Off to 16 bit land		LDA	PCL	;PCL/PCH is stored here		STA	|E1PCLH	;Save in bank E1 for later		LDA	|SVAL	;		RTS		;Back to caller in 16 bit 'm'/'x'TEXTPAGE1		EQU	*		LDA	>FLIPSCRN	;Already called before ?		EOR	#$80	;		STA	>FLIPSCRN		BMI	BRKSCRN	;SETPAG1		EQU	*		STZ	WNDTOP	;Reset top of window		LDA	#$80		TRB	NEWVIDEO	;No super hi res scrn		LDA	TXTSET	;Enable text		LDA	MIXCLR	;Clear mixed mode		LDA	TXTPAGE1	;Enable text page1		RTS;JMP GOTXT1 ;BRKSCRN		EQU	*		PHB		JSR	DBTOE1		LONGA	OFF		LONGI	OFF		SEP	#$30		LDA	|SCRNSTAT	;		PHA		AND	#$80		ORA	|NEWVIDEO		STA	|NEWVIDEO		PLA		ASL	A		BPL	@4		STA	|TXTSET		BRA	@5@4		STA	|TXTCLR@5		ASL	A		BPL	@6		STA	|MIXSET		BRA	@7@6		STA	|MIXCLR@7		ASL	A		BPL	@8		STA	|HIRES		BRA	@9@8		STA	|LORES@9		ASL	A		BPL	@10		STA	|TXTPAGE2		BRA	@11@10		STA	|TXTPAGE1@11		PLBUT9		EQU	*		RTS		EJECT* Utility calls to Tools is done in 2 steps.* 1. Set up the information for the tool call JSL in*    the input buffer in this order.* 2. Do the actual utility call after the user types in*    the tool information and a 'U'.** Utility call format is as follows ('_' denotes a required space)* \#bytes to stk_#bytes frm stk_parm1_.._parmz_function#_tool#\U** NOTE: Each byte of each paramter must be separated by a space** '\' starts and '\' terminates tool setup information normally.* $8D terminates the entire line and reenters the monitor.UTILITYFF		EQU	*		IF IS512 <> 0 THEN		RTS		;Call not permitted in 512 kilobit ROM's		ELSE		REP	#$30	;Off to 16 bit land		LDA	IN+1	;# of bytes to push on stack for call		STA	>GOS	; and # of bytes to print after call.		SEP	#$30	;8 bit land now		TAY		;# of bytes for stack-2		INY		;Inc by 2 for function # and tool #		INY		;		LDX	#$00	;Read input buffer indexUT2		EQU	*		LDA	IN+3,X	;Get byte for stack		PHA		; and place it there.		INX		;Next character position in input buffer		DEY		;		BNE	UT2	;Loop til done		REP	#$30	;Must be 16 bit land to call tools		PLX		;'X' has tool# in hi byte func# in lo byte		JSL	>DISPATCH1	;Call tool		PHA		;Save result status for later		PHA		;Save error code on stack		SEP	#$30	;Back to 8 bit land		JSR	CROUTFF	;Next line please		LDA	#TLERRMSG	;'Tool error= ' message		JSR	PRINTMSG	;		PLX		;Recall lo byte of error code to print		PLY		;Recall hi byte of error code to print		JSR	PRNTYXFF	;Print 'Y' 1st then 'X'		JSR	CROUTFF	;Next line please		REP	#$30	;16 bit land to do testing		PLA		;Recall result status lo byte		BEQ	UT4	;=0 then no error clean up		LONGA	ON		CMP	#$0010	;0<Error<10 then dispatcher error		LONGA	OFF		BCS	UT4	;= of >$10 then do not clean up		LDA	>GOS	;Pull old data from stack and display		BRA	UT5	;UT4		EQU	*		LDA	>GOS+1	;Pull resultant data from stack/displayUT5		EQU	*		SEP	#$30	;8 bit land for regular monitor stuff		TAY		;Lo byte is # of bytes pushed earlierUT6		EQU	*		BEQ	UT9	;=0 then no parameters on stack		DEY		;Decrement counter		PLA		;Recall byte to print		PHY		;Save counter		JSR	PRBYTEFF	;Show user byte		JSR	PR1BLNKFF	;Space between data		PLY		;Recall index		BRA	UT6	;Loop til done		ENDIF		EJECT* TCMD has two functions.*    1.  Read and display time*    2.  Set time** Format to read and display time is**     '=T'**  Where 'T' must be upper case.** Display format is* * 'Time-> nn/dd/yy hh:mm:ss am/pm'** Format to set time is**    '=T=nn dd yy hh mm ss**  Where 'T' must be upper case.*  Any valid delimiter except ' and carriage return*    may be used in place of the spaces between*    variables as shown above.*  Value-->>    User Enters   To Routine*  nn = month     (1-12)        (0-11)*  dd = day       (1-31)        (0-30)*  yy = year      (0-99)        (0-99)*  hh = hours     (0-23)        (0-23)*  mm = minutes   (0-59)        (0-59)*  ss = seconds   (0-59)        (0-59)** The line must be terminated with a carriage return.* If the line is terminated without entering all*  the variables, the missing variables will not be*  changed.* The user entered values are converted then placed* on the stack and the Miscellaneous Tools is* called to set the clock chip time.  The calls to* write and read the clock chip via the Miscellaneous* Tools.** ReadAsciiTime -- Function number RATFN*      Input stack:  SP+4 = Null*                    SP+3 = ASCII buffer bank number*                    SP+2 = ASCII buffer hi byte of address*                    SP+1 = ASCII buffer lo byte of address*                          *      PEA $0000+^ASCIITIME ;Null byte + bank number*      PEA ASCIITIME ;Address of buffer*      INDEX16*      LDX #RATFN*256+MTN  ;Function number*256 + Misc Tool number*      INDEX8*      JSL =DISPATCH1  ;Call main Tool Locator**      Return data is in buffer ASCIITIME** ReadTimeHex -- Function number RTHFN*     Input stack:   SP+8 = Push room for day of week 0=Sunday*                    SP+7 = Push room for null byte*                    SP+6 = Push room for month*                    SP+5 = Push room for day*                    SP+4 = Push room for year*                    SP+3 = Push room for hour*                    SP+2 = Push room for minute*                    SP+1 = Push room for second**      Push room for day of week on stack 0=Sunday*      Push room for null byte on stack*      Push room for month on stack*      Push room for day on stack*      Push room for year on stack*      Push room for hour on stack*      Push room for minute on stack*      Push room for second on stack*      INDEX16*      LDX #RTHFN*256+MTN  ;Function number*256 + Misc Tool number*      INDEX8*      JSL =DISPATCH1  ;Call main Tool Locator**      Pull second from stack*      Pull minute from stack*      Pull hour from stack*      Pull year from stack*      Pull day from stack*      Pull month from stack*      Pull null byte from stack*      Pull day of week from stack 0=Sunday** WriteTimeHex -- Function number WTHFN*      Input stack:  SP+6 = Month*                    SP+5 = Day*                    SP+4 = Year*                    SP+3 = Hour*                    SP+2 = Minute*                    SP+1 = Second**      Push month on stack*      Push day on stack*      Push year on stack*      Push hours on stack*      Push minutes on stack*      Push seconds on stack*      INDEX16*      LDX #WTHFN*256+MTN  ;Function number*256 + Misc Tool number*      INDEX8*      JSL =DISPATCH1  ;Call main Tool Locator**             No values are returned from this call.*TCMD		EQU	*	;Display current time command		JSR	PRINTTIME	;Print original time		LDY	YSAV	;Pick up where MONZ left off		LDA	IN,Y	;Test for '=' to see if setting time		CMP	#'='	;'=' required for setting time		BNE	UT9	;<>'=' then done so exit with RTS		INC	YSAV	;Point to next item in input buffer		STZ	IN	;Counter for number of bytes enteredTCMD2		EQU	*	;Display current time command		LDY	YSAV	;Pick up where MONZ left off		JSR	GETNUMFF	;Get next entry		STY	YSAV	;Save pointer for later		CMP	#$C6	;Was it a carriage return?		BEQ	TCMD6	;		JSR	CDECTOHEX	;Clock decimal to hex time conversion		BEQ	TCMD2	;'z'=1 then it's a delimiter to be skipped		PHA		;Save result on stack for tool call		LDA	IN	;Test # of values entered		CMP	#$02	;If 0/1 then decrement entered value by 1		BCS	TCMD5	;		PLX		;Recall value entered and subtract 1		DEX		;		PHX		;Restore value to stackTCMD5		EQU	*		CMP	#$02	;If 2 then it's year so modify if needed		BNE	TCMD5_5	;		PLA		;Recall saved year		CMP	#40	;=<40 the add $64		BCS	@2	;@1		EQU	*		CLC		;Add 100 to get to the year 2000+		ADC	#$64	;@2		EQU	*		PHA		;Restore modified year		LDA	IN	;'A'=# of values enteredTCMD5_5		EQU	*		CMP	#$06	;If 6 entered then we're done		BCS	TCMD9	;		INC	IN	;If not done increment value entry counter		BRA	TCMD2	; and go for another value.TCMD6		EQU	*		JSR	CDECTOHEX	;Clock decimal to hex time conversion		BEQ	TCMD6_2	;'z'=1 then no values entered		PHA		; else save last entered value on stack		INC	IN	; and increment counter.TCMD6_2		EQU	*		LDX	IN	;Put entry counter into 'X'		CPX	#$06	;=6 then all's fine so write it		BCS	TCMD9	;TCMD7		EQU	*		TXA		;Test 'X' for 0 value		BEQ	TCMD8	;Take error exit		PLA		;Clean 1 byte off stack		DEX		;		BRA	TCMD7	;Loop back alwaysTCMD8		EQU	*	;Error exit		JSR	NEWBELL1	;Beep bell and exit		JMP	MONZ2RTN	;Back via new monitor entry lineTCMD9		EQU	*		REP	#$30	;All tool calls are 16 bits		LONGI	ON		LDX	#WTHFN*256+MTN	;Function number/tool number		LONGI	OFF		IF IS512 <> 0 THEN		PLA		;Clean up stack		PLA		;		PLA		;		ELSE		JSL	>DISPATCH1	;Go set time with 16 bit 'm'/'x'		ENDIF		SEP	#$30	;Back to 8 bit 'm'/'x' for monitor		JSR	PRINTTIME	;Print changed time for user		JMP	MONZ2RTN	;Return to monitor command line directlyPRINTTIME		EQU	*		JSR	CROUTFF	;Next line please		LDA	#TIMEMSG	;Number of characters in message		JSR	PRINTMSG	;Print message		PHP		;Disable interrupts for a while		SEI		;		PEA	ASCIITIME>>16	;Null/bank number of buffer		PEA	|ASCIITIME	;Address of buffer		REP	#$30	;All tool calls are 16 bits		LONGI	ON		LDX	#RATFN*256+MTN	;Function number/tool number		LONGI	OFF		IF IS512 <> 0 THEN		PLA		;Clean up stack		PLA		;		ELSE		JSL	>DISPATCH1	;Go set time with 16 bit 'm'/'x'		ENDIF		SEP	#$30	;Back to 8 bit 'm'/'x' for monitor		LDX	#$00	;20 bytes of time to displayPRTIMELP		EQU	*		LDA	>ASCIITIME,X	;		PHX		;Save print index		JSR	COUTFF	;		PLX		;Recall index		INX		;Next character please		CPX	#$14	;Test for done		BCC	PRTIMELP	;Loop til 4 bytes printed		PLP		;Restore interrupt status		JMP	CROUTFF	;Next line pleaseCDECTOHEX		EQU	*		LDA	>DIGITCNT	;=0 if no hex digits entered		PHP		;Sve 'z' to enable delimiter to be skipped		LDA	A2L	;Get low byte of hex value entered		PHA		;Save on stack		AND	#$0F	;Work with low byte 1st		STA	A2L	;Save for SUMEM		PLA		;Recall original entry		JSR	SCRN4	; and move hi nybble to low nybble.		TAX		;Then put result in 'X' for SUMEM		JSR	SUM0A	;Create hex number from decimal number		LDA	A2L	;Sum is placed here in SUMEM		PLP		;'z'=1 then skip delimiter		RTS		;Back to callerSUM0A		EQU	*	;Sum using $0A as summing value		LDA	#$0A	;		STA	A1L	;Save 'A'SUMEM1		EQU	*		LDA	A1L	;Recall number to add		CLC		;Prepare to add		DEX		;Check to see if done		BMI	SUMEMDNE	;'-' when done		ADC	A2L	;Add running total to accumulator		STA	A2L	; and save in total.		BRA	SUMEM1	;Loop to add moreSUMEMDNE		EQU	*		RTS		;Back to caller		TITLE	'Reverse Dispatcher'*******************************************************                                                    **  Reverse Dispatch to Routines in //e Monitor Space **                                                    **               by                                   **          Fern Bachman     1985-1987                **          Joe Bo           1987-1989                **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************UPFF		EQU	*		PEA	UP-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to mainside * print the address in the form bb/aaaa:PRADDR		JSR	PRBANKS		LDX	A1L		LDY	A1HXPRADDRFF		EQU	*		PEA	XPRADDR-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to mainside * print the bank number bbPRBANKS		EQU	*		JSR	CROUTFF	;Output a carriage return		LDA	>BANKS	;Get source bank number		JSR	PRBYTEFF	;Show user bank number		LDA	#$AF	;'/'		BRA	COUTFF	;GETLNZFF		EQU	*		PEA	GETLNZ-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to mainside PRHEXFF		EQU	*		PEA	PRHEX-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to mainside PRNTYXFF		EQU	*		TYA		;Y to A to printPRNTAXFF		EQU	*		JSR	PRBYTEFF	;		TXA		;X to A to printPRBYTEFF		EQU	*		PEA	PRBYTE-1	;Push address of rtne to execute on stackTOMAINSIDE	EQU	*		JMP	>MAINSIDEPATCH	;Make it patchable	; SEG $FFTOMAINSIDE1	EQU	*	; SEG $00		XBA		;Preserve 'A' in 'B'		TXA		;Preserve 'X' in 'A'		REP	#$30	;Off to 16 bit land		PLX		;Recall and save routine address in 'X'		PHK		;Return bank		PEA	FFBANKRTS-1	;Return address in bank FF		PEA	MAINEXIT-1	;Exit point in main monitor ROM		PHX		;Routine to execute back to stack		SEP	#$30	;Back to 8 bit land		TAX		;Restore 'X' from 'A'		XBA		;Restore 'A' from 'B'TOMAINSIDE2	EQU	*	;Special entry point		XBA		;Save 'A' value		JSR	FIXSPEED	;Make non bank FF speed user speed!		XBA		;Restore user 'A' value		PHB		;Data bank register is new program bank		PEA	MAINSIDE-1	;Main ROM area entry point		STA	SETSLOTCXROM	;Disable internal CxROM		RTL		;Go to mainside PRBLNKFF		EQU	*		LDX	#$03	;3 blanks to fall into PRBL2PRBL2FF		EQU	*		PEA	PRBL2-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to mainside CROUTFF		EQU	*	;Output a carriage return		LDA	#$8D	;COUTFF		EQU	*		PEA	COUT-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to mainside COUT1FF		EQU	*		PEA	COUT1-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to mainside MONZ2FF		EQU	*		PEA	MONZ2-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE2	;Go to mainside SETVTAB		EQU	*		STX	CH	;Set cursor horizontal position		STY	CV	;Set cursor vertical positionVTABFF		EQU	*		PEA	VTAB-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to main sideC300FF		EQU	*		PEA	C300-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to main sideHOMEFF		EQU	*		PEA	HOME-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to main sideSETVIDKBDFF	EQU	*		PEA	SETVIDKBD-1	;Push address of rtne to execute on stack		BRA	TOMAINSIDE	;Go to main sideENTER80		EQU	*		LDA	#$98	;Output control-X to cancel line		JSR	C300FF	;Enable 80 columns		LDA	#$00	;Reset flag		STA	>CHGCURFLG	;Reset cursor/80 column change flag		RTS		;Back to caller with 'A'=0		TITLE	'Examine Memory Routines'*******************************************************                                                    **        Examine Any Memory in System Routines       **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************XMEMORY		EQU	*		LDA	>BANKS	;CHK FOR CROSS BANK, get start bank first		CMP	>HIGHBANK	;		BEQ	@00	;NO CROSS BANK		BCC	@01	;BRA TO SET UP FOR CROSSING BANK		STZ	A2L	;Need to fool around for NXTA1		STZ	A2H	;@00		EQU	*		JSR	PRADDR		LDA	A1H		STA	A4H		LDA	A1L		STA	A4L@0		JSR	READBYT1		JSR	PRBYTEFF	;OUTPUT BYTE IN HEX@02		EQU	*		JSR	NXTA1		BCS	@1		JSR	DSPCOUNT		AND	A1L		BEQ	@1		JSR	PR1BLNKFF		BRA	@0	;NOT DONE YET. MORE@01		EQU	*		LDA	A2H	;Temp store A2 and set to $ffff of that bank		PHA		LDA	A2L		PHA		LDA	#$FF		STA	A2H		STA	A2L@100		EQU	*		BRA	@00@1		LDA	A4H		STA	A1H		LDA	A4L		STA	A1L		LDA	#$AD	;Print '-'		JSR	COUTFF	;@2		EQU	*		JSR	READBYTE		ORA	#$80		CMP	#$A0		BCC	@3		CMP	#$FF		BNE	@4@3		EQU	*		LDA	#$AE	;'.'@4		EQU	*		TAY		;Preserve 'A'		LDA	CH	;Test for back up 1 line		BEQ	@5	;=0 then doing 80 column stuff		CMP	#39	;Test for last column		PHP		;Save result status		TYA		;Recall user byte		JSR	COUTFF	;		PLP		;		BCC	@5_2	;C=0 then not on last column		JSR	UPFF		BRA	@5_2	;Skip another output@5		EQU	*		TYA		;Recall 'A' value		JSR	COUTFF@5_2		EQU	*;LDA KBD ;Test for stop list;AND #$7F ;Ignore hi bit;CMP #$18 ;Control-X to stop list;BNE @6 ;<>= then continue list;BIT KBDSTRB ; else clear strobe and quit		JSR	XRDKBD	;Read keyboard		BPL	@6	;BRA if no keyhit		AND	#$7F	;Ignore hi bit		CMP	#$18	;CHK for Control-X to stop list		BEQ	@5_25	;BRA if so		CMP	#$13	;Chk for Ctrl-S to pause		BNE	@6	;Continue list if niether@5_23		JSR	XRDKBD	;See if we can continue		BPL	@5_23	;Keep looping if not		BRA	@6	;Continue with listing@5_25		EQU	*		LDA	>BANKS	;Chk if banks = extendbank		CMP	>HIGHBANK	;		BEQ	@5_3	;BRA if already at the same bank*		STA	>HIGHBANK	;Force high bank = low bank		PLA		;Else cross bank exists and low bank		PLA		; not yet gets to the high bank, cln stk@5_3		EQU	*		RTS		;@6		EQU	*		JSR	NXTA1		BCS	@7	;Bra to adjust bank crossing		JSR	DSPCOUNT		AND	A1L		BNE	@2@8		EQU	*		BRA	@100@7		EQU	*		PHB		JSR	DBTOE1		INC	|BANKS		LDA	|BANKS		BEQ	@10	;CHK if already passes $ff bank		CMP	|HIGHBANK	;		BEQ	@9		BCS	@10	; 		PLB		STZ	A1H	;And set the start address to 0		STZ	A1L		LDA	#$FF		STA	A2H	;And reset end address againg to $ffff		STA	A2L		BRA	@8@9		EQU	*		PLB		PLA		STA	A2L		PLA		STA	A2H		BRA	@8@10		EQU	*		DEC	|BANKS	;Stay to its last bank and exit		LDA	>BANKS		STA	>HIGHBANK	;Force high bank = src bank		PLB		RTSPCYTOA3		EQU	*		REP	#$20		CLC		TYA		ADC	PCL		STA	A3L		SEP	#$20		LDX	#A3L		RTS		TITLE	'6502 Opcode  Lengths'*******************************************************                                                    **           6502 Opcode Lengths Table/Routine        **                  for Compatibility                 **                                                    **                         by                         **                    Fern Bachman                    **                    Joe  Bo                         **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************GET6502LEN	EQU	*	;Get length of 6502 opcodes		PHA		;Save opcode		AND	#$03	;Create shift counter		TAY		;Save shift counter in 'Y'		PLA		;Recall opcode		LSR	A	;Divide by 4		LSR	A	;		TAX		;Index into LEN6502OP table created now		LDA	>LEN6502OP,X	;Pick up 4 opcode lengths@1		EQU	*		DEY		;Decrement shift counter		BMI	@2	;Done when shift counter is '-'		LSR	A	;Do a shift		LSR	A	;Shift 2 bits at a time		BRA	@1	;Always loop@2		EQU	*		AND	#$03	;Only low 2 bits are valid		STA	LENGTH	;Save for application		RTS		;****************************************************                                                 **         6502 Opcodes Instruction Lengths-1      **                                                 ****************************************************	; SEG $FFLEN6502OP		EQU	*	;Length-1 of 6502 opcodes table	; SEG $00* illegal {03} - illegal {02} - ORA (d,X) {01} - BRK i {00}		DC.B	%00000100* illegal {07} - ASL d {06} - ORA d {05} - illegal {04}		DC.B	%00010100* illegal {0B} - ASL  {0A} - ORA # {09} - PHP s {08}		DC.B	%00000100* illegal {0F} - ASL a {0E} - ORA a {0D} - illegal {0C}		DC.B	%00101000* illegal {13} - illegal {12} - ORA (d),Y {11} - BPL r {10}		DC.B	%00000101* illegal {17} - ASL d,X {16} - ORA d,X {15} - illegal {14}		DC.B	%00010100* illegal {1B} - illegal {1A} - ORA a,Y {19} - CLC i {18}		DC.B	%00001000* illegal {1F} - ASL a,X {1E} - ORA a,X {1D} - illegal {1C}		DC.B	%00101000* illegal {23} - illegal {22} - AND (d,X) {21} - JSR a {20}		DC.B	%00000110* illegal {27} - ROL d {26} - AND d {25} - BIT d {24}		DC.B	%00010101* illegal {2B} - ROL Acc {2A} - AND # {29} - PLP s {28}		DC.B	%00000100* illegal {2F} - ROL a {2E} - AND a {2D} - BIT a {2C}		DC.B	%00101010* illegal {33} - illegal {32} - AND (d),Y {31} - BMI r {30}		DC.B	%00000101* illegal {37} - ROL d,X {36} - AND d,X {35} - illegal {34}		DC.B	%00010100* illegal {3B} - illegal {3A} - AND a,Y {39} - SEC i {38}		DC.B	%00001000* illegal {3F} - ROL a,X {3E} - AND a,X {3D} - illegal {3C}		DC.B	%00101000* illegal {43} - illegal {42} - EOR (d,X) {41} - RTI s {40}		DC.B	%00000100* illegal {47} - LSR d {46} - EOR d {45} - illegal {44}		DC.B	%00010100* illegal {4B} - LSR Acc {4A} - EOR # {49} - PHA s {48}		DC.B	%00000100* illegal {07} - LSR a {4E} - EOR a {4D} - JMP a {4C}		DC.B	%00101010* illegal {53} - illegal {52} - EOR (d),Y {51} - BVC r {50}		DC.B	%00000101* illegal {57} - LSR d,X {56} - EOR d,X {55} - illegal {54}		DC.B	%00010100* illegal {5B} - illegal {5A} - EOR a,Y {59} - CLI i {58}		DC.B	%00001000* illegal {5F} - LSR a,X {5E} - EOR a,X {5D} - illegal {5C}		DC.B	%00101000* illegal {63} - illegal {62} - ADC (d,X) {61} - RTS s {60}		DC.B	%00000100* illegal {67} - ROR d {66} - ADC d {65} - illegal {64}		DC.B	%00010100* illegal {6B} - ROR Acc {6A} - ADC # {69} - PLA s {68}		DC.B	%00000100* illegal {6F} - ROR a {6E} - ADC a {6D} - JMP (a) {6C}		DC.B	%00101010* illegal {73} - illegal {72} - ADC (d),Y {71} - BVS r {70}		DC.B	%00000101* illegal {77} - ROR d,X {76} - ADC d,X {75} - illegal {74}		DC.B	%00010100* illegal {7B} - illegal {7A} - ADC a,Y {79} - SEI i {78}		DC.B	%00001000* illegal {7F} - ROR a,X {7E} - ADC a,X {7D} - illegal {7C}		DC.B	%00101000* illegal {83} - illegal {82} - STA (d,X) {81} - illegal {80}		DC.B	%00000100* illegal {87} - STX d {86} - STA d {85} - STY d {84}		DC.B	%00010101* illegal {8B} - TXA i {8A} - illegal {89} - DEY i {88}		DC.B	%00000000* illegal {8F} - STX a {8E} - STA a {8D} - STY a {8C}		DC.B	%00101010* illegal {93} - illegal {91} - STA (d),Y {91} - BCC r {90}		DC.B	%00000101* illegal {97} - STX d,Y {96} - STA d,X {95} - STY d,X {94}		DC.B	%00010101* illegal {9B} - TXS i {9A} - STA a,Y {99} - TYA i {98}		DC.B	%00001000* illegal {9F} - illegal {9E} - STA a,X {9D} - illegal {9C}		DC.B	%00001000* illegal {A3} - LDX # {A2} - LDA (d,X) {A1} - LDY # {A0}		DC.B	%00010101* illegal {A7} - LDX d {A6} - LDA d {A5} - LDY d {A4}		DC.B	%00010101* illegal {AB} - TAX i {AA} - LDA # {A9} - TAY i {A8}		DC.B	%00000100* illegal {AF} - LDX a {AE} - LDA a {AD} - LDY a {AC}		DC.B	%00101010* illegal {B3} - illegal {B2} - LDA (d),Y {B1} - BCS r {B0}		DC.B	%00000101* illegal {B7} - LDX d,Y {B6} - LDA d,X {B5} - LDY d,X {B4}		DC.B	%00010101* illegal {BB} - TSX i {BA} - LDA a,Y {B9} - CLV i {B8}		DC.B	%00001000* illegal {BF} - LDX a,Y {BE} - LDA a,X {BD} - LDY a,X {BC}		DC.B	%00101010* illegal {C3} - illegal {C2} - CMP (d,X) {C1} - CPY # {C0}		DC.B	%00000101* illegal {C7} - DEC d {C6} - CMP d {C5} - CPY d {C4}		DC.B	%00010101* illegal {CB} - DEX i {CA} - CMP # {C9} - INY i {C8}		DC.B	%00000100* illegal {CF} - DEC a {CE} - CMP a {CD} - CPY a {CC}		DC.B	%00101010* illegal {D3} - illegal {D2} - CMP (d),Y {D1} - BNE r {D0}		DC.B	%00000101* illegal {D7} - DEC d,X {D6} - CMP d,X {D5} - illegal {D4}		DC.B	%00010100* illegal {DB} - illegal {DA} - CMP a,Y {D9} - CLD i {D8}		DC.B	%00001000* illegal {DF} - DEC a,X {DE} - CMP a,X {DD} - illegal {DC}		DC.B	%00101000* illegal {E3} - illegal {E2} - SBC (d,X) {E1} - CPX # {E0}		DC.B	%00000101* illegal {E7} - INC d {E6} - SBC d {E5} - CPX d {E4}		DC.B	%00010101* illegal {EB} - NOP i {EA} - SBC # {E9} - INX i {E8}		DC.B	%00000100* illegal {EF} - INC a {EE} - SBC a {ED} - CPX a {EC}		DC.B	%00101010* illegal {F3} - illegal {F2} - SBC (d),Y {F1} - BEQ r {F0}		DC.B	%00000101* illegal {F7} - INC d,X {F6} - SBC d,X {F5} - illegal {F4}		DC.B	%00010100* illegal {FB} - illegal {FA} - SBC a,Y {F9} - SED i {F8}		DC.B	%00001000* illegal {FF} - INC a,X {FE} - SBC a,X {FD} - illegal {FC}		DC.B	%00101000