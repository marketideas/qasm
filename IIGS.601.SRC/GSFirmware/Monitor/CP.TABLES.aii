		TITLE	'Control Panel Int Handler';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 5:21:42 PM*******************************************************                                                    **    Int Handler for Control Panel Desk Accessory    **                                                    **                         by                         **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ******************************************************** CPINTHNDLR handles one second interrupts.* Its purpose is to update the clock box* on screens which require the clock box.* No action is taken on screens which do not* display the clock box.CPINTHNDLR	EQU	*		JSR	SAVESHOLES	;Save screen holes		PEI	BASL	;Save monitor variables		PEI	CH	;		LDX	CURSCRN	;Which screen we on?		BMI	@1	;BRA for special password display 		LDA	>STATTBL,X	;Get status byte		ASL	A	;Bit 5 has data		ASL	A	; so shift it to bit 7 for testing.		BPL	@1	;'+' then no clock box required		STZ	OLDCH	;Force 80 column firmware to use new CH		LDA	INVFLG	;=FF then normal printing		PHA		;Save for later testing		JSR	TURNONMTXT	;Enable normal mouse text printing		JSR	PRINTCLK0	;Change clock box contents		PLA		;Recall state of mouse text printing		BMI	@1	;Continue normally if '-'		JSR	TURNOFFMTXT	;<>= then set inv print + no mouse text@1		EQU	*	;Clear interrupt/clean up/exit		REP	#$30	;16 bit mode to save a few bytes		PLA		;		STA	CH	;Restore monitor variables		PLA		;		STA	BASL	;		SEP	#$30	;Back to monitor world		JSR	RSTRSHOLES	;Restore screen holes		STZ	SCANINT	;Reset bit 6 to clear 1 second interrupt		CLC		;Clear 'c' to indicate serviced		RTL		;Back to interrupt handlerSAVESHOLES	EQU	*	;Enter here to save slt 0/3 scrn holes		SEP	#$40	;'v'=1 if saving screen holes		OPCODE	BVC	;Branch never takenRSTRSHOLES	EQU	*	;Enter here to restore slt 0/3 scrn holes		CLV		;'v'=0 if restoring screen holes		LDX	#$00	;Start with 1st location in buffer		LDY	#$78	;Low byte of screen hole@1		EQU	*		LDA	#$04	;Start with 1st screen hole		STY	ZINT+0	;@2		EQU	*		STA	ZINT+1	;Interrupt pointer		LDY	#$00	;Start with 1st screen hole		BVC	@3	;'v'=0 then restoring screen holes		LDA	(ZINT),Y	;Get screen hole		STA	ZINTSHBUF,X	;Save in zero page int scrn hole buffer		BRA	@4	;@3		EQU	*		LDA	ZINTSHBUF,X	;Get saved screen hole		STA	(ZINT),Y	;Restore screen hole byte@4		EQU	*		INX		;Next location in buffer		LDY	#$80	;Offset to next screen hole byte		BVC	@5	;'v'=0 then restoring screen holes		LDA	(ZINT),Y	;Get screen hole		STA	ZINTSHBUF,X	;Save in zero page int scrn hole buffer		BRA	@6	;@5		EQU	*		LDA	ZINTSHBUF,X	;Get saved screen hole		STA	(ZINT),Y	;Restore screen hole byte@6		EQU	*		INX		;Next location in buffer		LDA	ZINT+1	;Increment hi byte of pointer		INC	A	;Increment then test for done		CMP	#$08	;If 8 then done		BCC	@2	;Loop if < 8		LDY	#$7B	;Done if ZINT=$7B		CPY	ZINT	;= or not		BNE	@1	;Loop til done		RTS		;Back to caller		TITLE	'Control Panel Select Rtnes'*******************************************************                                                    **  Select Routines for Control Panel Desk Accessory  **                                                    **                         by                         **               Fern Bachman    $1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ******************************************************** SELECTLINE does all the work necessary to * move the user's indicator cursor up and down* a menu.  It exits when carriage return/escape/* left or rmght arrow key is pressed indicating* the user wants to open a feature, ignore changes* or make a line option change.** Enter SELECTLINE with CURLINE set to option #* to start indicator on.** Enter SELECTLINE with NUMLINES set to # of* screen lines+1 available.** In the case of printer or modem screen, it skips over    * the 1st line whenever it tries to get to that line.    * To flip to the top or bottom line of the screen has to * be taken care.  Also has a special case for AppleTalk* being selected as the connected device, then the screen* has a maximum of 5 lines only !!!SELECTLINE	EQU	*	;Put up indicator character to start		CLI		;Enable clk ints since scrn is set up now		JSR	PRTMODEM	;CHK for 1st line of printer or modem scrn		BEQ	@01	;BRA to skip 1st line 		JSR	@6	;Get a keypress for main screen		CMP	#UPAKEY	;Up arrow pressed?		BEQ	@1	;Yes, then do it to it.		CMP	#DOWNAKEY	;Down arrow pressed?		BEQ	@3	;Yes, then do it to it.		RTS		;Back to caller with CURLINE updated@1		EQU	*		LDA	CURLINE	;Pick up current indicator pstn		BNE	@2	;<>0 then just dec and exit		LDA	NUMLINES	;# of lines for screen+1		STA	CURLINE	;Save as new position+1@2		EQU	*		DEC	CURLINE	;Decrement position		LDX	CURLINE	;Valid line or not?		LDA	REALLNTBL,X	;Test against table entry		BMI	@1	;'-' then not a valid position		JSR	PRTMODEM	;CHK for 1st line of printer or modem scrn		BNE	@44	;BRA if not		LDA	CURLINE	;Get current line so that to flip to top		BNE	@4	; or bottom of the line of the scrn		JSR	PRTAPTALK	;Chk if current screen prt port for Aptalk		BEQ	@24	;BRA if yes		JSR	MODAPTALK	;CHK if current screen mod port for Aptalk		BEQ	@24	;BRA if yes@23		EQU	*		LDA	#$0B	;Flip to bottom line of the prt/modem scrn		BRA	@02	; and show new at new position.@24		EQU	*		LDA	#$04	;ApTalk maxi has 5 lines only		BRA	@02	;BRA to end@44		EQU	*		JSR	CHKGSC	;Check for GSc and on slot screen		BCS	@4	;BRA if not		LDA	CURLINE	; else what line of slot screen		CMP	#$05	;		BNE	@4		LDA	#$01	;		BRA	@02	;@3		EQU	*		LDA	CURLINE	;Pick up current indicator pstn		INC	A	;Test against number of lines+1 for screen		CMP	NUMLINES	;Number of lines for screen+1		BCC	@22	;<>0 then just dec and exit		LDA	#$FF	;First line for screen-1		STA	CURLINE	;Save as new position/1@22		EQU	*		INC	CURLINE	;Decrement position		LDX	CURLINE	;Valid line or not?		LDA	REALLNTBL,X	;Test against table entry		BMI	@3	;'-' then not a valid position		JSR	PRTMODEM	;CHK for 1st line of printer or modem scrn		BNE	@46	;BRA if not		LDA	CURLINE	;Get current line		BNE	@4	;BRA if not get to 1st line@01		EQU	*		LDA	#$01	; else set to 2nd line@02		EQU	*		STA	CURLINE	;Update as new current line@4		EQU	*	;Check if doing main screen or not		LDA	#$00	;$00 indicates redraw main screen		RTS		;Back to caller@46		EQU	*		JSR	CHKGSC		BCS	@4		LDA	CURLINE		CMP	#$02		BNE	@4		LDA	#$06	;		BRA	@02	;* @6 does the following*         1.  Gets a keypress*         2.  Tests for arrow keys, carriage return and escape.*             If none of these keys it beeps the bell*                and looks for another keypress.*         3.  Returns 'c'=0 if return/escape/(up/down)*                              arrow key pressed*                     'c'=1 if left or right arrow was pressed.*         4.  Exits with key press in 'A'@6		EQU	*		JSR	XRDKBD	;Read keys		BPL	@6	;Loop til key pressed		CMP	#ESCKEY	;ESC key pressed?		BEQ	@5	;= take clear carry exit		CMP	#RETURNKEY	;Carriage return ke} pressed?		BEQ	@5	;= take carry clear exit		CMP	#UPAKEY	;Up arrow key pressed?		BEQ	@5	;= then take clear carry exit		CMP	#DOWNAKEY	;Down arrow key pressed?		BEQ	@5	;= then take clear carry exit		CMP	#LEFTAKEY	;Left arrow key pressed?		BEQ	@52	;= then take left/right arrow key exit		CMP	#RIGHTAKEY	;Right arrow key pressed?		BEQ	@52	;= then take left/right arrow key exit@61		JSR	NEWBELL1	;Beep user for bad key press		BRA	@6	;Loop til good key pressed@5		EQU	*	;Clear carry exit		CLC		;@52		EQU	*	;Left/right arrow key exit		RTS		;Back to caller* Check for GSc and on slot screen: return w/ c=0 then yesCHKGSC		EQU	*		LDA	>KEYUCVER	;Get keyuc version#		CMP	#$06	;>=$06 then TenSpeed or GSc or newer		BCC	@4	;		LDA	>GSC	;		BPL	@4	;BRA if not GSc		LDA	CURSCRN	;What screen ?		CMP	#CPLN6-CPLN1	;CHK for slot screen		BNE	@4	;BRA if not 		CLC		;		RTS@4		EQU	*		SEC		RTS		TITLE	'Control Panel Tables3'*******************************************************                                                    **      Tables3 for Control Panel Desk Accessory      **                                                    **           Fern Bachman       1985-1987             **           Joe Bo             1987-1989             **                                                    **      Copyright Apple Computer, Inc. 1985-1989      **                All Rights Reserved.                **                                                    ******************************************************** OPTPTRTBL holds pointers to the tables containing* the message number for the first option number* message of each submenu screen line.OPTPTRTBL		EQU	*		DC.B	DISPOP	;Points to line number option msg numbers		DC.B	SOUNDOP	;Points to line number option msg numbers		DC.B	SYSSPDOP	;Points to line number option msg numbers		DC.B	CLOCKOP	;Points to line number option msg numbers		DC.B	LANGOP	;Points to line number option msg numbers		DC.B	SLOTSOP	;Points to line number option msg numbers		DC.B	PORTOP	;Points to line number option msg numbers		DC.B	PORTOP	;Points to line number option msg numbers* DFB >RAMDSKOP ;There are no msg numbers for RAMDSKOP		DC.B	$00	;Place holder		DC.B	MOUSEOP	;Points to line number option msg numbers* NOPTPTRTBL holds pointers to the tables containing* the address of the tables containing the number of* options for each submenu screen line.NOPTPTRTBL	EQU	*		DC.B	NDISPOP	;Points to tbl of number of options		DC.B	NSOUNDOP	;Points to tbl of number of options		DC.B	NSYSSPDOP	;Points to tbl of number of options		DC.B	NCLOCKOP	;Points to tbl of number of options		DC.B	NLANGOP	;Points to tbl of number of options		DC.B	NSLOTSOP	;Points to tbl of number of options		DC.B	NPORTOP	;Points to tbl of number of options		DC.B	NPORTOP	;Points to tbl of number of options		DC.B	NRAMDSKOP	;Points to tbl of number of options		DC.B	NMOUSEOP	;Points to tbl of number of options* CPDFPTRTBL holds pointers to the tables containing* the default option numbers for the first option number* message of each submenu screen line.CPDFPTRTBL	EQU	*		DC.B	DISPDFT	;Points to 1st line number default number		DC.B	SOUNDDFT	;Points to 1st line number default number		DC.B	SYSSPDDFT	;Points to 1st line number default number		DC.B	CLOCKDFT	;Points to 1st line number default number		DC.B	LANGDFT	;Points to 1st line number default number		DC.B	SLOTSDFT	;Points to 1st line number default number		DC.B	PORT1DFT	;Points to 1st line number default number		DC.B	PORT2DFT	;Points to 1st line number default number		DC.B	RAMDSKDFT	;Points to 1st line number default number		DC.B	MOUSEDFT	;Points to 1st line number default number* BRAMPTRTBL holds pointers to the tables containing* the current option numbers for the first line number* of each submenu screen.BRAMPTRTBL	EQU	*		DC.B	USERCOLOR	;Ptr to user value as 1st opt of 1st line		DC.B	USERVOL	;Ptr to user value as 1st opt of 1st line		DC.B	USERSPEED	;Ptr to user value as 1st opt of 1st line		DC.B	USERDATE	;Ptr to user value as 1st opt of 1st line		DC.B	USERDISP	;Ptr to user value as 1st opt of 1st line		DC.B	USERSLT1	;Ptr to user value as 1st opt of 1st line		DC.B	USERPORT1	;Ptr to user value as 1st opt of 1st line		DC.B	USERPORT2	;Ptr to user value as 1st opt of 1st line		DC.B	USERMRAM	;Ptr to user value as 1st opt of 1st line		DC.B	USERHMR	;Ptr to user value as 1st opt of 1st line* TRUELNTBL contains a word for each screen* which details whether a line is a selectable* line number or a group delimiter.* Each bit set is a non accessible line.	; SEG $FFTRUELNTBL		EQU	*	; SEG $00		DC.W	$FF84	;Display lines 7-15,2 not accessible		DC.W	$FFF2	;Sound lines 3-15,1 not accessible		DC.W	$FFFE	;System speed lines 1-15 not accessible		DC.W	$FE10	;Clock lines 9-15,4 not accessible		DC.W	$F8C0	;Lang lines 12-15, 6-7 not accessible-"D"		DC.W	$FE80	;Slots lines 9-15,7 not accessible		DC.W	$F000	;Port 1 lines 1,12-15 not accessible		DC.W	$F000	;Port 2 lines 1,12-15 not accessible		DC.W	$FEFE	;Ramdisk lines 1-7,9-15 not accessible		DC.W	$FF8C	;Mouse lines 2-3, 7-15 not accessible		DC.W	$FFFF	;Place holder only		DC.W	$F400	;Main scrn lines 10, 11-15 not accessible		EJECT* W A R N I N G: PORTOP through MOUSEDFT must be*                be on the same page or the tables*                OPTPTRTBL/NOPTPTRTBL/CPDFPTRTBL*                will pick up incorrect addresses.		EJECT* PORTOP holds the message number for the first* option of each line number on the serial ports* submenu screen.PORTOP		EQU	*		DC.B	PORTOP1_0	;1st message number for line #1		DC.B	PORTOP2_0	;1st message number for line #2		DC.B	PORTOP3_0	;1st message number for line #3		DC.B	PORTOP4_0	;1st message number for line #4		DC.B	PORTOP5_0	;1st message number for line #5		DC.B	PORTOP6_0	;1st message number for line #6		DC.B	PORTOP7_0	;1st message number for line #7		DC.B	PORTOP8_0	;1st message number for line #8		DC.B	PORTOP9_0	;1st message number for line #9		DC.B	PORTOP10_0	;1st message number for line #10		DC.B	PORTOP11_0	;1st message number for line #11		DC.B	PORTOP12_0	;1st message number for line #12* DISPOP holds the message number for the first* option of each line number on the display* submenu screen.DISPOP		EQU	*		DC.B	DISPOP1_0	;1st message number for line #1		DC.B	DISPOP2_0	;1st message number for line #2		DC.B	DISPOPC	;1st message number for text line		DC.B	DISPOPC	;1st message number for background line		DC.B	DISPOPC	;1st message number for border line		DC.B	DISPOP3_0	;1st message number for line #3		DC.B	DISPOP4_0	;1st message number for line #4* LANGOP holds the message number for the first* option of each line number on the language* submenu screen.LANGOP		EQU	*		DC.B	LANGOP1_0	;1st message number for line #1		DC.B	LANGOP2_0	;1st message number for line #2		DC.B	LANGOP3_0	;1st message number for line #3		DC.B	LANGOP4_0	;1st message number for line #4		DC.B	LANGOP5_0	;1st message number for line #5;DFB LANGOP6.0 ;1st message number for line #6		DC.B	LANGOP7_0	;1st message number for line #7		DC.B	LANGOP8_0	;1st message number for line #8		DC.B	LANGOP9_0	;1st message number for line #9		DC.B	LANGOP10_0	;1st message number for line #10* SOUNDOP holds the message number for the first* option of each line number on the sound* submenu screen.SOUNDOP		EQU	*		DC.B	SOUNDOP1_0	;1st message number for line #1		DC.B	SOUNDOP2_0	;1st message number for line #2* SLOTSOP holds the message number for the first* option of each line number on the slots* submenu screen.SLOTSOP		EQU	*		DC.B	SLOTSOP1_0	;1st message number for line #1		DC.B	SLOTSOP2_0	;1st message number for line #2		DC.B	SLOTSOP3_0	;1st message number for line #3		DC.B	SLOTSOP4_0	;1st message number for line #4		DC.B	SLOTSOP5_0	;1st message number for line #5		DC.B	SLOTSOP6_0	;1st message number for line #6		DC.B	SLOTSOP7_0	;1st message number for line #7		DC.B	SLOTSOP8_0	;1st message number for line #8* CLOCKOP holds the message number for the first* option of each line number on the clock* submenu screen.CLOCKOP		EQU	*		DC.B	CLOCKOP1_0	;1st message number for line #1		DC.B	CLOCKOP2_0	;1st message number for line #2* SYSSPDOP holds the message number for the first* option of each line number on the system speed* submenu screen.SYSSPDOP		EQU	*		DC.B	SYSSPDOP1_0	;1st message number for line #1* MOUSEOP holds the message number for the first * option of each line number on the mouse       * submenu screen.MOUSEOP		EQU	*		DC.B	MOUSEOP1_0	;1st message number for line #1		DC.B	MOUSEOP2_0	;1st message number for line #2		DC.B	MOUSEOP3_0	;1st message number for line #3		DC.B	MOUSEOP4_0	;1st message number for line #4		DC.B	MOUSEOP5_0	;1st message number for line #5* Start of tables whose order can NEVER be changed	; SEG $FFBRAMLIMITS	EQU	*	;Table of BRAM parameter limits+1	; SEG $00* NPORTOP holds the number of options for each* submenu screen line.NPORTOP		EQU	*		DC.B	NPORTOP1_0	;Number of options for line #1		DC.B	NPORTOP2_0	;Number of options for line #2		DC.B	NPORTOP3_0	;Number of options for line #3		DC.B	NPORTOP4_0	;Number of options for line #4		DC.B	NPORTOP5_0	;Number of options for line #5		DC.B	NPORTOP6_0	;Number of options for line #6		DC.B	NPORTOP7_0	;Number of options for line #7		DC.B	NPORTOP8_0	;Number of options for line #8		DC.B	NPORTOP9_0	;Number of options for line #9		DC.B	NPORTOP10_0	;Number of options for line #10		DC.B	NPORTOP11_0	;Number of options for line #11		DC.B	NPORTOP12_0	;Number of options for line #12		DC.B	NPORTOP1_0	;Number of options for line #1		DC.B	NPORTOP2_0	;Number of options for line #2		DC.B	NPORTOP3_0	;Number of options for line #3		DC.B	NPORTOP4_0	;Number of options for line #4		DC.B	NPORTOP5_0	;Number of options for line #5		DC.B	NPORTOP6_0	;Number of options for line #6		DC.B	NPORTOP7_0	;Number of options for line #7		DC.B	NPORTOP8_0	;Number of options for line #8		DC.B	NPORTOP9_0	;Number of options for line #9		DC.B	NPORTOP10_0	;Number of options for line #10		DC.B	NPORTOP11_0	;Number of options for line #11		DC.B	NPORTOP12_0	;Number of options for line #12* NDISPOP holds the number of options for each* submenu screen line.NDISPOP		EQU	*		DC.B	NDISPOP1_0	;Number of options for line #1		DC.B	NDISPOP2_0	;Number of options for line #2		DC.B	NDISPOPC	;Number of options for line #3		DC.B	NDISPOPC	;Number of options for line #4		DC.B	NDISPOPC	;Number of options for line #5		DC.B	NDISPOP4_0	;Number of options for line #6* NSOUNDOP holds the number of options for each* submenu screen line.NSOUNDOP		EQU	*		DC.B	NSOUNDOP1_0	;Number of options for line #1		DC.B	NSOUNDOP2_0	;Number of options for line #2* NSYSSPDOP holds the number of options for each* submenu screen line.NSYSSPDOP		EQU	*		DC.B	NSYSSPDOP1_0	;Number of options for line #1* NSLOTSOP holds the number of options for each* submenu screen line.NSLOTSOP		EQU	*		DC.B	NSLOTSOP1_0	;Number of options for line #1		DC.B	NSLOTSOP2_0	;Number of options for line #2		DC.B	NSLOTSOP3_0	;Number of options for line #3		DC.B	NSLOTSOP4_0	;Number of options for line #4		DC.B	NSLOTSOP5_0	;Number of options for line #5		DC.B	NSLOTSOP6_0	;Number of options for line #6		DC.B	NSLOTSOP7_0	;Number of options for line #7		DC.B	NSLOTSOP8_0	;Number of options for line #8* NLANGOP holds the number of options for each* submenu screen line.NLANGOP		EQU	*		DC.B	$80	;Indicate special lookup 1st opt req		DC.B	$C0	;Indicate special lookup 2nd opt req		DC.B	NLANGOP3_0	;Number of options for line #3		DC.B	NLANGOP4_0	;Number of options for line #4		DC.B	NLANGOP5_0	;Number of options for line #5;DFB NLANGOP6.0 ;Number of options for line #6, gs only		DC.B	NLANGOP7_0	;Number of options for line #7		DC.B	NLANGOP8_0	;Number of options for line #8		DC.B	NLANGOP9_0	;Number of options for line #9		DC.B	NLANGOP10_0	;Number of options for line #10* The disk ejection option keys have the range value not* equal or greater than $09, but in ten speed the hardware* is not available for the disk ejection keys and the keyuc* code had finalized.  Therefore a special index value is* used to fool around the keyuc and make the range value to * put here as index($2d) + 1 = $2e;DFB $09 ;Number of options for line #11;DFB $09 ;Number of options for line #12		DC.B	$2E	;Need to be changed if disk ejection available		DC.B	$2E	;* NDCLOCKOP is used by the READBR routine to* verify that the 2 clock options in BATTERYRAM* are within range.*NDCLOCKOP EQU *		DC.B	NCLOCKOP1_0	;Number of options+1		DC.B	NCLOCKOP2_0	;Number of options+1* NRAMDSKOP holds the number of options for each* submenu screen line.NRAMDSKOP		EQU	*		DC.B	$80	;Indicate special lookup		DC.B	NRAMDSKOP8_0	;Number of options for line #8		DC.B	$80	;No longer be able to get to this line* NMOUSEOP holds the number of options for each* submenu screen lineNMOUSEOP		EQU	*		DC.B	NMOUSEOP1_0	;Number of options for line #1		DC.B	NMOUSEOP2_0	;Number of options for line #2		DC.B	NMOUSEOP3_0	;Number of options for line #3		DC.B	NMOUSEOP4_0	;Number of options for line #4		DC.B	NMOUSEOP5_0	;Number of options for line #5* End of tables whose order can NEVER be changed.* NCLOCKOP holds the number of options for each* submenu screen line.NCLOCKOP		EQU	*		DC.B	12	;Max month+1=12		DC.B	31	;Max day+1=31		DC.B	100	;Max year+1=100		DC.B	03	;Max date format+1=3		DC.B	24	;Max hour+1=24		DC.B	60	;Max minute+1=60		DC.B	60	;Max second+1=60		DC.B	02	;Max time format+1=2* MONTHLEN holds the number of days for each* month.	; SEG $FFMONTHLEN		EQU	*	; SEG $00		DC.B	31	;Days in January		DC.B	28	;Days in non leap year February		DC.B	31	;Days in March		DC.B	30	;Days in April		DC.B	31	;Days in May		DC.B	30	;Days in June		DC.B	31	;Days in July		DC.B	31	;Days in August		DC.B	30	;Days in September		DC.B	31	;Days in October		DC.B	30	;Days in November		DC.B	31	;Days in December		DC.B	29	;Days in leap year FebruaryNSPCLSLT1		EQU	*		DC.B	$04	;Max allowable new slot1 #, <=$03		TITLE	'BATTERYRAM Default Values'*******************************************************                                                    **  BATTERYRAM Default Values for Ctrl Panel Dsk Acc  **                                                    **                    by                         **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************	; SEG $FFCPDEFTBL		EQU	*	;Control Panel Defaults table* Port 1 selectionsPORT1DFT		EQU	*		DC.B	$00	;Device Connected: Printer		DC.B	$00	;Line Length: Unlimited		DC.B	$00	;Delete First LF after CR: No		DC.B	$01	;Add LF after CR: Yes		DC.B	$00	;Echo: No		DC.B	$00	;Buffering: No		DC.B	$0D	;Baud: 9600		DC.B	$06	;Data/Stop Bits: 8/1		DC.B	$02	;Parity: None		DC.B	$01	;DCD Handshake: Yes		DC.B	$01	;DSR Handshake: Yes		DC.B	$00	;XON/XOFF Handshake: No* Port 2 selectionsPORT2DFT		EQU	*		DC.B	$01	;Device Connected: Modem		DC.B	$00	;Line Length: Unlimited		DC.B	$00	;Delete First LF after CR: No		DC.B	$00	;Add LF after CR: No		DC.B	$00	;Echo: No		DC.B	$00	;Buffering: No		DC.B	$07	;Baud: 1200		DC.B	$06	;Data/Stop Bits: 8/1		DC.B	$02	;Parity: None		DC.B	$01	;DCD Handshake: Yes		DC.B	$01	;DSR Handshake: Yes		DC.B	$00	;XON/XOFF Handshake: No* Display selectionsDISPDFT		EQU	*		DC.B	$00	;Type: Color		DC.B	$00	;Columns: 40DISPDFTT		DC.B	$0F	;Text: (White)DISPDFTBK		DC.B	$06	;Background: (Medium Blue)DISPDFTBD		DC.B	$06	;Border: (Medium Blue)		DC.B	$00	;Hertz: 60* Sound selectionsSOUNDDFT		EQU	*		DC.B	$05	;Volume: |-----*---------|		DC.B	$06	; Pitch: |------*--------|* Speed selectionsSYSSPDDFT		EQU	*		DC.B	$01	;Speed: Fast* Slots' selectionsSLOTSDFT		EQU	*		DC.B	$00	;Slot 1: Port 1		DC.B	$00	;Slot 2: Port 2		DC.B	$00	;Slot 3: Text Display		DC.B	$00	;Slot 4: Mouse     		DC.B	$00	;Slot 5: Smart Port		DC.B	$00	;Slot 6: Disk Port		DC.B	$01	;Slot 7: Your Card		DC.B	$00	;Startup Slot: Scan* Language selectionsLANGDFT		EQU	*		DC.B	$00	;Text Display: English (U.S.)		DC.B	$00	;Keyboard: English (U.S.)		DC.B	$00	;Keyboard Buffering: No		DC.B	$05	;Repeat Speed: |------*--------|		DC.B	$02	;Repeat Delay: |-----*---------|;DFB $02 ;Double Click: |-----*---------|, move out !!   		DC.B	$02	;Cursor Flash: |-----*---------|		DC.B	$00	;Shift Caps/Lower Case: No		DC.B	$00	;Fast Space/Delete Keys: No		DC.B	$00	;Dual Speed Keys: Normal** Disk ejection keys not implemented yet, set this special index* to fool around keyuc not to wipe out any combination keys of* apple-shift-XXX.*		DC.B	$2D	;Disk1 ejection, 0 -> 1, 1->2, ......		DC.B	$2D	;Disk2 ejection, 1 -> 2, 2->3, ......* Clock selectionsCLOCKDFT		EQU	*		DC.B	$00	;Format: MM/DD/YY		DC.B	$00	;Format: AM-PM* Ramdisk selectionsRAMDSKDFT		EQU	*		DC.B	$00	;Minimum RAM for Ramdisk option number		DC.B	$00	;Maximum RAM for Ramdisk option number		DC.B	$00	;Reset RAMdisk during next reset* Mouse defaultsMOUSEDFT		EQU	*		DC.B	$00	;Mouse Tracking: |*--------------|		DC.B	$02	;Double Click:   |-----*---------|		DC.B	$02	;Start Delay:    |-----*---------|		DC.B	$02	;Acceleration:   |-----*---------|		DC.B	$06	;Maximum Speed:  |-----*---------|		DC.B	8	;Number of languages from keyboard micro		DC.B	0	;Option number of language		DC.B	1	;Option number of language		DC.B	2	;Option number of language		DC.B	3	;Option number of language		DC.B	4	;Option number of language		DC.B	5	;Option number of language		DC.B	6	;Option number of language		DC.B	7	;Option number of language		DC.B	10	;Number of layouts from keyboard micro		DC.B	0	;Option number of layout		DC.B	1	;Option number of layout		DC.B	2	;Option number of layout		DC.B	3	;Option number of layout		DC.B	4	;Option number of layout		DC.B	5	;Option number of layout		DC.B	6	;Option number of layout		DC.B	7	;Option number of layout		DC.B	8	;Option number of layout		DC.B	9	;Option number of layout		DC.B	10	;Option number of layout		DC.B	11	;Option number of layout		DC.B	12	;Option number of layout		DC.B	13	;Option number of layout		DC.B	14	;Option number of layout		DC.B	15	;Option number of layout* This byte is newly picked for slot1 configuration, it is       * different from the USERSLT1 that this byte will actually * contain the right value (0,1,2,3) for the selection of * slot1 where as USERSLT1 will only contain (0,1) for   * internal/external selection of the card.  Doing this way* so AppleTalk firmware can survive in either of the system* disk (must be >= 3.2).NEWSLT1		DC.B	$00	;Set new slot1 default to printerROMDADEF		DC.B	$00	;$00 not install monitor/memory peekerSAMEPAGE1		PgAdrEQU	PORTOPSAMEPAGE2		PgAdrEQU	MOUSEDFT		IF (SAMEPAGE1-SAMEPAGE2) THEN		WRITELN	'### ERROR: PORTOP -> MOUSEDFT MUST be in the same page!'		ENDIFCPDTBLLN		EQU	*-CPDEFTBL		EJECT** The following tables moved 6/7/91 by JOA to make room for longer splah screens ** STATTBL is defined as follows*         Bit 7= 0 normal display functions*              = 1 special display functions*         Bit 6= 0 standard change functions*              = 1 special change functions*         Bit 5= 0 for no clock box*              = 1 for clock box*         Bit 4= 0 for 'Open' box only*              = 1 for 'Cancel'/'Save' boxes only*         Bits 3-0 = # of lines/screen+1	; SEG $FFSTATTBL		EQU	*	;Max number of lines/screen+1	; SEG $00		DC.B	$80+$40+$10+DISPLEN	;SpDisp/Spchange/no clk/Cancel-Save		DC.B	$40+$10+SNDLEN	;NMDisp/Spchange/no clk/Cancel-Save		DC.B	$10+SYSSPDLEN	;NMDisp/NMchange/no clk/Cancel-Save		DC.B	$80+$40+$20+$10+CLKLEN	;Spdisp/Spchange/clk/Cancel-Save		DC.B	$10+LANGLEN	;NMDisp/NMchange/no clk/Cancel-Save		DC.B	$10+SLOTSLEN	;NMDisp/NMchange/no clk/Cancel-Save		DC.B	$10+SERIALLEN	;NMDisp/NMchange/no clk/Cancel-Save		DC.B	$10+SERIALLEN	;NMDisp/NMchange/no clk/Cancel-Save		DC.B	$80+$40+$10+RAMDSKLEN	;SpDisp/Spchange/no clk/Cancel-Sve		DC.B	$10+MOUSELEN	;NMDisp/NMchange/no clk/Cancel-save		DC.B	$00	;Required space holder		DC.B	$20+MMLEN	;Normal/TOSEL1/clock/Open* LNNUMTBL holds the starting message number* for the first line number message of each* submenu screen.	; SEG $FFLNNUMTBL		EQU	*	; SEG $00		DC.B	DISPLN1	;1st message number of Display submenu		DC.B	SOUNDLN1	;1st message number of Sound submenu		DC.B	SYSSPDLN1	;1st message number of System Spd submenu		DC.B	CLOCKLN1	;1st message number of Clock submenu		DC.B	LANGLN1	;1st message number of Language submenu		DC.B	SLOTSLN1	;1st message number of Slots submenu		DC.B	SERIALLN1	;1st message number of Port 1 submenu		DC.B	SERIALLN1	;1st message number of Port 2 submenu		DC.B	RAMDSKLN1	;1st message number of Ramdisk submenu		DC.B	MOUSELN1	;1st message number of Mouse submenu		TITLE	'Control Panel Tables2'*******************************************************                                                    **     Tables2 for Control Panel Desk Accessory       **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **      Copyright Apple Computer, Inc. 1985-1989      **                All Rights Reserved.                **                                                    *******************************************************		DC.B	'   March 17, 1987'	;DATE* Miscellaneous messages** WARNING: The 'DW's below MUST be in the same*          order as the previous CP.TABLES or the print*          program will display the wrong messages.	; SEG $FFMSGTBL		EQU	*	; SEG $00		DC.W	BOOTMSGA	;'I/O error!' message address		DC.W	DISKMSGA	;'Not a bootable disk!' message address		DC.W	DEVMSGA	;'No device connected!' message address		DC.W	CHKDEVMSGA	;'Check startup device!' message address		DC.W	TIMEMSGA	;'Time=' message address		DC.W	STEPMSGA	;'Step' message address		DC.W	TRACEMSGA	;'Trace' message address		DC.W	CBANKMSGA	;'Cbank' message address		DC.W	DECMSGA	;'Decimal' message address		DC.W	HEXMSGA	;'Hex' message address		DC.W	ARWDASHDOLA	;'-> $' message address		DC.W	TLERRMSGA	;'Tool error= ' message address		DC.W	SYSDMSGA	;'Fatal system error-> ' message address* Special entry to Control Panel ASCII		DC.W	SPCHOICESA	;Special entry control panel ASCII* Desk Accessory Title		DC.W	CPTITLEA	;' Control Panel' message address * Prompts / Footnotes		DC.W	TOSELUSEA	;'Select:' message address 		DC.W	UDSELA	;' ^ v' message address 		DC.W	LRSELA	;' < >' message address 		DC.W	OPENCRA	;'Open CR' message address		DC.W	SAVECRA	;'Save CR' message address		DC.W	CANCELESCA	;'Cancel ESC' message address		DC.W	SPACEBOXA	;'|              |' message address		DC.W	TOPBOXA	;' ______________ ' message address		DC.W	BOTTOMBOXA	;' -------------- ' message address		DC.W	APS1S2L1A	;'ApTalk/Ser Prt1/Ser Prt2 part 1 msg addr		DC.W	APS1S2L2A	;'ApTalk/Ser Prt1/Ser Prt2 part 2 msg addr		DC.W	TWOAPTALKA	;'AppleTalk already Selected' msg addr* Main Menu		DC.W	CPLN1A	;'Display' message address 		DC.W	CPLN2A	;'Sound' message address 		DC.W	CPLN3A	;'System Speed' message address 		DC.W	CPLN4A	;'Clock' message address 		DC.W	CPLN5A	;'Language' message address 		DC.W	CPLN6A	;'Slots' message address 		DC.W	CPLN7A	;'Port 1' message address 		DC.W	CPLN8A	;'Port 2' message address 		DC.W	CPLN9A	;'Ramdisk' message address 		DC.W	CPLN11A	;'Mouse' message address		DC.W	SPACEA	;'  ' message address		DC.W	CPLN10A	;'Quit' message address * Serial Port		DC.W	SERIALLN1A	;'Device Connected' message address 		DC.W	SERIALLN2A	;'Line Length' message address 		DC.W	SERIALLN3A	;'Delete First LF after CR' message addr		DC.W	SERIALLN4A	;'Add LF after CR' message address 		DC.W	SERIALLN5A	;'Echo' message address 		DC.W	SERIALLN6A	;'Buffering' message address 		DC.W	SERIALLN7A	;'Baud' message address 		DC.W	SERIALLN8A	;'Data/Stop Bits' message address 		DC.W	SERIALLN9A	;'Parity' message address 		DC.W	SERIALLN10A	;'DCD Handshake' message address		DC.W	SERIALLN11A	;'DSR Handshake' message address		DC.W	SERIALLN12A	;'XON/XOFF Handshake' message address* Display		DC.W	DISPLN1A	;'Type' message address 		DC.W	DISPLN2A	;'Columns' message address 		DC.W	COLORSA	;'-Screen Colors-' message address		DC.W	DISPLN3A	;'Text' message address 		DC.W	DISPLN4A	;'Background' message address 		DC.W	DISPLN5A	;'Border' message address 		DC.W	DISPLN6A	;'Standards' message address		DC.W	SPACEA	;'  ' message address		DC.W	DISPLN7A	;'Hertz' message address* System Speed		DC.W	CPLN3A	;'System Speed' message address * Slots		DC.W	SLOTSLN1A	;'Slot 1' message address 		DC.W	SLOTSLN2A	;'Slot 2' message address 		DC.W	SLOTSLN3A	;'Slot 3' message address 		DC.W	SLOTSLN4A	;'Slot 4' message address 		DC.W	SLOTSLN5A	;'Slot 5' message address 		DC.W	SLOTSLN6A	;'Slot 6' message address 		DC.W	SLOTSLN7A	;'Slot 7' message address 		DC.W	SPACEA	;'  ' message address		DC.W	SLOTSLN8A	;'Startup Slot' message address * Options		DC.W	LANGLN1A	;'Language' message address 		DC.W	LANGLN2A	;'Keyboard' message address 		DC.W	LANGLN3A	;'Keyboard Buffering' message address		DC.W	LANGLN4A	;'Repeat Speed' message address 		DC.W	LANGLN5A	;'Delay to Repeat' message address 		DC.W	LANGLN7A	;'Flash Rate of Cursor' message address 		DC.W	SPACEA	;'   ' Message address		DC.W	ADVANCEDA	;'-Advanced Features-' message address 		DC.W	LANGLN8A	;'Shift Caps/Lower Case' message address 		DC.W	LANGLN9A	;'Fast Space/Delete Keys' msg address 		DC.W	LANGLN10A	;'Dual Speed' message address 		IF OPTION4 <> 0 THEN		DC.W	LANGLN11A	;'Disk1 Eject (shift-Cmd-?)' msg address		DC.W	LANGLN12A	;'Disk2 Eject (shift-Cmd-?)' msg address		ENDIF* Clock		DC.W	CLOCKLN1A	;'Month' message address 		DC.W	CLOCKLN2A	;'Day' message address 		DC.W	CLOCKLN3A	;'Year' message address 		DC.W	CLOCKLN4A	;'Format' message address 		DC.W	SPACEA	;'  ' message address		DC.W	CLOCKLN6A	;'Hour' message address 		DC.W	CLOCKLN7A	;'Minute' message address 		DC.W	CLOCKLN8A	;'Second' message address 		DC.W	CLOCKLN4A	;'Format' message address * Ramdisk		DC.W	RAMDSKLN1A	;'Select Ramdisk Size' message address;DW RAMDSKLN2A ;'Maximum Ramdisk Size' message address		DC.W	RAMDSKLN3A	;'-Largest Selectable Size' message addr		DC.W	SPACEA	;'  ' message address		DC.W	STATUSA	;'-RAM Status-' message address		DC.W	RAMDSKLN4A	;'RAM disk Size' message address		DC.W	RAMDSKLN5A	;'Total RAM in Use' message address		DC.W	RAMDSKLN6A	;'Total Free RAM' message address		DC.W	SPACEA	;' ' message address		DC.W	RAMDSKLN7A	;'Re-size during next reset' message #* Sound		DC.W	SOUNDLN1A	;'Volume' message address		DC.W	SPACEA	;'  ' message address		DC.W	SOUNDLN2A	;' Pitch' message address* Mouse		DC.W	MOUSELN1A	;'Mouse Tracking' message address		DC.W	MOUSELN2A	;'Double click' message address		DC.W	SPACEA	;'   ' message address		DC.W	ADVMSEMSGA	;'-Keyboard Mouse-' msg address		DC.W	MOUSELN3A	;'Start Delay' message address		DC.W	MOUSELN4A	;'Acceleration' message address		DC.W	MOUSELN5A	;'Maxm Speed ' message address		EJECT* Serial Port Options		DC.W	PORTOP1_0A	;'Printer' message address		DC.W	PORTOP1_1A	;'Modem' message address		DC.W	PORTOP1_2A	;'AppleTalk' message number		DC.W	PORTOP1_3A	;'Your Card' message address		DC.W	PORTOP2_0A	;'40' message address		DC.W	PORTOP2_1A	;'72' message address		DC.W	PORTOP2_2A	;'80' message address		DC.W	PORTOP2_3A	;'132' message address		DC.W	PORTOP2_4A	;'Unlimited' message address		DC.W	PORTOP3_0A	;'No' message address		DC.W	PORTOP3_1A	;'Yes' message address		DC.W	PORTOP7_0A	;'50' message address		DC.W	PORTOP7_1A	;'75' message address		DC.W	PORTOP7_2A	;'110' message address		DC.W	PORTOP7_3A	;'134.5' message address		DC.W	PORTOP7_4A	;'150' message address		DC.W	PORTOP7_5A	;'300' message address		DC.W	PORTOP7_6A	;'600' message address		DC.W	PORTOP7_7A	;'1200' message address		DC.W	PORTOP7_8A	;'1800' message address		DC.W	PORTOP7_9A	;'2400' message address		DC.W	PORTOP7_10A	;'3600' message address		DC.W	PORTOP7_11A	;'4800' message address		DC.W	PORTOP7_12A	;'7200' message address		DC.W	PORTOP7_13A	;'9600' message address		DC.W	PORTOP7_14A	;'19200' message address		DC.W	PORTOP8_0A	;'5/1' message address		DC.W	PORTOP8_1A	;'5/2' message address		DC.W	PORTOP8_2A	;'6/1' message address		DC.W	PORTOP8_3A	;'6/2' message address		DC.W	PORTOP8_4A	;'7/1' message address		DC.W	PORTOP8_5A	;'7/2' message address		DC.W	PORTOP8_6A	;'8/1' message address		DC.W	PORTOP8_7A	;'8/2' message address		DC.W	PORTOP9_0A	;'Odd' message address		DC.W	PORTOP9_1A	;'Even' message address		DC.W	PORTOP9_2A	;'None' message address* Display Options		DC.W	DISPOP1_0A	;'Color' message address		DC.W	DISPOP1_1A	;'Monochrome' message address		DC.W	PORTOP2_1A	;'40' message address		DC.W	PORTOP2_3A	;'80' message number		DC.W	DISPOPC0A	;'Black' color message address		DC.W	DISPOPC1A	;'Deep Red' color message address		DC.W	DISPOPC2A	;'Dark Blue' color message address		DC.W	DISPOPC3A	;'Purple' color message address		DC.W	DISPOPC4A	;'Dark Green' color message address		DC.W	DISPOPC5A	;'Dark Gray' color message address		DC.W	DISPOPC6A	;'Medium Blue' color message address		DC.W	DISPOPC7A	;'Light Blue' color message address		DC.W	DISPOPC8A	;'Brown' color message address		DC.W	DISPOPC9A	;'Orange' color message address		DC.W	DISPOPC10A	;'Light Gray' color message address		DC.W	DISPOPC11A	;'Pink' color message address		DC.W	DISPOPC12A	;'Light Green' color message address		DC.W	DISPOPC13A	;'Yellow' color message address		DC.W	DISPOPC14A	;'Aquamarine' color message address		DC.W	DISPOPC15A	;'White' color message address		DC.W	DISPOP3_0A	;'60' message number		DC.W	PORTOP7_0A	;'50' message number* Language Options		DC.W	LANGOP1_0A	;'U.S.A' message address		DC.W	LANGOP1_1A	;'U.K.' message address		DC.W	LANGOP1_2A	;'French' message address		DC.W	LANGOP1_3A	;'Danish' message address		DC.W	LANGOP1_4A	;'Spanish' message address		DC.W	LANGOP1_5A	;'Italian' message address		DC.W	LANGOP1_6A	;'German' message address		DC.W	LANGOP1_7A	;'Swedish' message address		DC.W	LANGOP1_8A	;'Dvorak' message address		DC.W	LANGOP1_9A	;'French Canadian' message address		DC.W	LANGOP1_10A	;'Flemish' message address		DC.W	LANGOP1_11A	;'Hebrew' message address		DC.W	LANGOP1_12A	;'Japanese' message address		DC.W	LANGOP1_13A	;'Arabic' message address		DC.W	LANGOP1_14A	;'Greek' message address		DC.W	LANGOP1_15A	;'Turkish' message address		DC.W	LANGOP1_16A	;'Finnish' message address		DC.W	LANGOP1_17A	;'Portuguese' message address		DC.W	LANGOP1_18A	;'Tamil' message address		DC.W	LANGOP1_19A	;'Hindu' message address		DC.W	LANGOP1_20A	;'T1' message address		DC.W	LANGOP1_21A	;'T2' message address		DC.W	LANGOP1_22A	;'T3' message address		DC.W	LANGOP1_23A	;'T4' message address		DC.W	LANGOP1_24A	;'T5' message address		DC.W	LANGOP1_25A	;'T6' message address		DC.W	LANGOP1_26A	;'L1' message address		DC.W	LANGOP1_27A	;'L2' message address		DC.W	LANGOP1_28A	;'L3' message address		DC.W	LANGOP1_29A	;'L4' message address		DC.W	LANGOP1_30A	;'L5' message address		DC.W	LANGOP1_31A	;'L6' message address		DC.W	BAR0A	;'|*--------------|' message address		DC.W	BAR1A	;'|-*-------------|' message address		DC.W	BAR2A	;'|--*------------|' message address		DC.W	BAR3A	;'|---*-----------|' message address		DC.W	BAR4A	;'|----*----------|' message address		DC.W	BAR6A	;'|------*--------|' message address		DC.W	BAR8A	;'|--------*------|' message address		DC.W	BAR10A	;'|----------*----|' message address		DC.W	BAR12A	;'|------------*--|' message address		DC.W	BAR14A	;'|--------------*|' message address		DC.W	BAR0A	;'|*--------------|' message address		DC.W	BAR3A	;'|---*-----------|' message address		DC.W	BAR7A	;'|-------*-------|' message address		DC.W	BAR10A	;'|----------*----|' message address		DC.W	BAR14A	;'|--------------*|' message address		DC.W	LANGOP10_0A	;'Normal' message address		DC.W	LANGOP10_1A	;'Fast' message address* Sound Options		DC.W	BAR0A	;'|*--------------|' message address		DC.W	BAR1A	;'|-*-------------|' message address		DC.W	BAR2A	;'|--*------------|' message address		DC.W	BAR3A	;'|---*-----------|' message address		DC.W	BAR4A	;'|----*----------|' message address		DC.W	BAR5A	;'|-----*---------|' message address		DC.W	BAR6A	;'|------*--------|' message address		DC.W	BAR7A	;'|-------*-------|' message address		DC.W	BAR8A	;'|--------*------|' message address		DC.W	BAR9A	;'|---------*-----|' message address		DC.W	BAR10A	;'|----------*----|' message address		DC.W	BAR11A	;'|-----------*---|' message address		DC.W	BAR12A	;'|------------*--|' message address		DC.W	BAR13A	;'|-------------*-|' message address		DC.W	BAR14A	;'|--------------*|' message address* Clock Options		DC.W	CLOCKOP1_0A	;'MM/DD/YY' message address		DC.W	CLOCKOP1_1A	;'DD/MM/YY' message address		DC.W	CLOCKOP1_2A	;'YY/MM/DD' message address		DC.W	CLOCKOP2_0A	;'AM-PM' message address		DC.W	CLOCKOP2_1A	;'24 Hour' message address		DC.W	TURNA	;'Turn ' message address		DC.W	ALTDSPMODEA	;'Alternate Display Mode' msg addr		DC.W	ONA	;'On' message address		DC.W	OFFA	;'Off' message address		DC.W	ACCEPTA	;'Accept CR' message address		DC.W	WELCOMEA	;'Welcome ...' message address		DC.W	N1A	;Not to be translated test only		DC.W	N2A	;Not to be translated, test2 only		DC.W	SPLASH1	;'Apple IIgs' message address		DC.W	SPLASH2	;'Copyright ...' message address		DC.W	SPLASH3	;Spare splash screen message address		DC.W	SPLASH4	;Spare splash screen message address		DC.W	SPLASH5	;'All rights ...' message address		DC.W	SPLASH6	;'ROM ...' message address; if the 10 in the line below is changed a matching 5 in CP_MsgEquates must be changed alsoSPCLPAD		DCB.B	10,0	;Force to align with cp.tables1     * Slots Options		DC.W	SLOTSOP1_0A	;'Printer Port' message address		DC.W	SLOTSOP0_0A	;'Your Card' message address		DC.W	SLOTSOP1_1A	;'AppleTalk' message address		DC.W	SLOTSOP1_2A	;'Modem Port' message address		DC.W	SLOTSOP2_0A	;'Modem Port' message address		DC.W	SLOTSOP0_0A	;'Your Card' message address		DC.W	SLOTSOP2_1A	;'AppleTalk' message address		DC.W	SLOTSOP2_2A	;'Printer Port' message address		DC.W	SLOTSOP3_0A	;'Built-in Text Display' message address		DC.W	SLOTSOP0_0A	;'Your Card' message address		DC.W	SLOTSOP4_0A	;'Built-in Mouse Port' message address		DC.W	SLOTSOP0_0A	;'Your Card' message address		DC.W	SLOTSOP5_0A	;Built-in Smart Port' message address		DC.W	SLOTSOP0_0A	;'Your Card' message address		DC.W	SLOTSOP6_0A	;Built-in Disk Port' message address		DC.W	SLOTSOP0_0A	;'Your Card' message address		DC.W	SLOTSOP7_0A	;Built-in SCSI Port' message address		DC.W	SLOTSOP0_0A	;'Your Card' message address		DC.W	SLOTSOP8_0A	;'Scan' message address		DC.W	SLOTSOP8_1A	;'Slot 1' message address		DC.W	SLOTSOP8_2A	;'Slot 2' message address		DC.W	SLOTSOP8_3A	;'Slot 3' message address		DC.W	SLOTSOP8_4A	;'Slot 4' message address		DC.W	SLOTSOP8_5A	;'Slot 5' message address		DC.W	SLOTSOP8_6A	;'Slot 6' message address		DC.W	SLOTSOP8_7A	;'Slot 7' message address		DC.W	CPLN9A	;'Ramdisk' message address		DC.W	SLOTSOP8_8A	;'Romdisk' message address		DC.W	SLOTSOP8_9A	;'AppleTalk' message address		TITLE	'Control Panel Messages'*******************************************************                                                    **      Messages for Control Panel Desk Accessory     **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **      Copyright Apple Computer, Inc. 1985-1989      **                All Rights Reserved.                **                                                    ******************************************************** Miscellaneous MessagesTIMEMSGA		EQU	*		DCI	'Time= 'STEPMSGA		EQU	*		DCI	'Step'TRACEMSGA		EQU	*		DCI	'Trace'CBANKMSGA		EQU	*		DCI	'Cbank (0/1)'DECMSGA		EQU	*		DCI	'Decimal-> 'HEXMSGA		EQU	*ARWDASHDOLA	EQU	HEXMSGA+3		DCI	'Hex-> $'TLERRMSGA		EQU	*		DCI	'Tool error-> '* Desk Accessory TitleCPTITLEA		EQU	*		DCI	' Control Panel'TOSELUSEA		EQU	*		DCI	'Select:'BOOTMSGA		EQU	*		DC.B	14,SPACE	;14 spaces to center msg		DC.B	'I/O error!'		DC.B	CRRETURN,TERMINATOR	;Carriage return DISKMSGA		EQU	*		DC.B	10,SPACE	;10 spaces to center msg		DC.B	'Not a startup disk!'		DC.B	CRRETURN,TERMINATOR	;Cavriage return DEVMSGA		EQU	*		DC.B	10,SPACE	;10 spaces to center msg		DC.B	'No device connected!'		DC.B	CRRETURN,TERMINATOR	;Carriage return CHKDEVMSGA	EQU	*		DC.B	10,SPACE	;10 spaces to center msg		DC.B	'Check startup device!'		DC.B	CRRETURN,TERMINATOR	;Carriage return SYSDMSGA		EQU	*		DC.B	8,SPACE	;8 spaces to center msg		DC.B	'Fatal system error-> '* TERMINATOR is MOUSEIND of next messageTOPBOXA		EQU	*		DC.B	MOUSEIND,SPACE		DC.B	13,BOTTOMLINE		DC.B	SPACE* TERMINATOR is MOUSEIND of next messageBOTTOMBOXA	EQU	*		DC.B	MOUSEIND,SPACE		DC.B	13,TOPLINE		DC.B	SPACE	;Space hi bit set* TERMINATOR is MOUSEIND of next messageUDSELA		EQU	*		DC.B	MOUSEIND		DC.B	SPACE,DOWNARROW,SPACE,UPARROW* TERMINATOR is MOUSEIND of next messageLRSELA		EQU	*		DC.B	MOUSEIND		DC.B	SPACE,LEFTARROW,SPACE,RIGHTARROW		DC.B	TERMINATOROPENCRA		EQU	*		DC.B	18,SPACE		DC.B	'Open: '		DC.B	RETURN,TERMINATORSAVECRA		EQU	*		DC.B	2,SPACE		DC.B	'Save: '		DC.B	RETURN,TERMINATORCANCELESCA	EQU	*		DC.B	2,SPACE		DC.B	'Cancel:Esc'* TERMINATOR is MOUSEIND of next messageSPACEBOXA		EQU	*		DC.B	MOUSEIND,RIGHTLINE		DC.B	13,SPACE		DC.B	LEFTLINE* TERMINATOR is MOUSEIND of next messageCOLORSA		EQU	*		DC.B	MOUSEIND		DC.B	CENTERLINE		DC.B	'Screen Colors'		DC.B	CENTERLINE* TERMINATOR is MOUSEIND of next messageAPS1S2L1A		EQU	*		DC.B	MOUSEIND,CENTERLINE;ASC 'WARNING: Printer / Modem / AppleTalk'		DC.B	'  WARNING: Either Slot 1 or Slot 2  '		DC.B	CENTERLINE* TERMINATOR is MOUSEIND of next messageAPS1S2L2A		EQU	*		DC.B	MOUSEIND,CENTERLINE;ASC 'cannot be active at the same time!!!'		DC.B	'  needs to be set to AppleTalk!!!   '		DC.B	CENTERLINE* TERMINATOR is MOUSEIND of next messageTWOAPTALKA	EQU	*		DC.B	MOUSEIND,CENTERLINE		DC.B	'WARNING:  AppleTalk already Selected'		DC.B	CENTERLINE* TERMINATOR IS MOUSEIND of next messageADVANCEDA		EQU	*		DC.B	MOUSEIND,CENTERLINE		DC.B	'Advanced Features'		DC.B	CENTERLINE* TERMINATOR is MOUSEIND of next messageSTATUSA		EQU	*		DC.B	MOUSEIND,CENTERLINE		DC.B	'RAM Status'		DC.B	CENTERLINE* TERMINATOR is MOUSEIND of next messageDISPLN7A		EQU	*		DC.B	MOUSEIND,CENTERLINE		DC.B	'Hertz: '* TERMINATOR is MOUSEIND of next messageRAMDSKLN3A	EQU	*		DC.B	MOUSEIND,CENTERLINE		DC.B	'Largest Selectable:'		DC.B	4,SPACE,TERMINATORSPCHOICESA	EQU	*		DC.B	2,SPACE		DC.B	'1=Enter the Control Panel.'		DCB.B	2,CRRETURN		DC.B	'  2=Set system standards and 60 hertz.'		DCB.B	2,CRRETURN		DC.B	'  3=Set system standards and 50 hertz.'		DC.B	CRRETURN,CRRETURN		DC.B	'  4=Continue restarting the system.'		DC.B	8,CRRETURN		DC.B	5,SPACE		DC.B	'Press 1,2,3 or 4 to continue.'* TERMINATOR is MOUSEIND of next messageBAR0A		EQU	*		DC.B	MOUSEIND,RIGHTLINE		DC.B	'*'		DC.B	14,CENTERLINE		DC.B	LEFTLINE* TERMINATOR is MOUSEIND of next messageBAR1A		EQU	*		DC.B	MOUSEIND,RIGHTLINE		DC.B	CENTERLINE		DC.B	'*'		DC.B	13,CENTERLINE		DC.B	LEFTLINE* TERMINATOR is MOUSEIND of next messageBAR2A		EQU	*		DC.B	MOUSEIND,RIGHTLINE		DCB.B