		EJECT		TITLE	'Text Page 2 Desk Accessory';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 5:22:20 PM*******************************************************                                                    **             Text Page 2 Desk Accessory             **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************	; SEG $FFTEXTPG2DA		EQU	*	; SEG $00		LDA	RDCXROM	;Save/restore INTCXROM/SLOTCXROM		PHA		;		LDA	CYAREG	;Save system speed		PHA		;Save it		JSR	HOMEFF	;Clear screen		JSR	TURNONMTXT	;Enable mouse text character printing		LDX	#CPHPOSITION	;Horizontal position of message		LDY	#CPVPOSITION	;Vertical position of message		LDA	#ALTDSPMODE	;Message number		JSR	PRINTMSGXY	;Show it		JSR	UNDERTITLE	;Underline title		LDX	#CPHPOSITION	;Horizontal position for message		LDY	#CPVPOSITION+10	;Vertical position for message		LDA	#TURN	;Message number		JSR	PRINTMSGXY	;Print 'Turn'		LDA	#ALTDSPMODE	;Message number		JSR	PRINTMSG		LDA	>TP2MODE	;<>= then already active		BNE	@1	;		LDA	#ON	;Give 'On' message if here		BRA	@2	;@1		EQU	*		LDA	#OFF	;'Off' message number@2		EQU	*		JSR	PRINTMSG		LDX	#CPHPOSITION	;Horizontal footnote position		LDY	#FNPOSITION	;Vertical footnote position		LDA	#CANCELESC	;Message		JSR	PRINTMSGXY	;Print it		LDA	#ACCEPT	;Message		JSR	PRINTMSG		JSR	ALLBORDER	;Put up complete border@5		EQU	*		JSR	XRDKBD	;Read keyboard		BPL	@5	;Loop til key pressed		CMP	#RETURNKEY	;Return then do it		BEQ	@3	;		CMP	#ESCKEY	;Escape key then do nothing		BEQ	@4	;		JSR	NEWBELL1	;Unknown key then beep and loop		BRA	@5	;@3		EQU	*		JSR	TEXT2COPYFF	;Toggle it@4		EQU	*		PLA		;Restore system speed		STA	CYAREG	;Set it back		JMP	RDYSBMENU0	;Exit via control panel routine** This routine installs a heartbeat task* that copies text page 2 to bank E0 for* the Mega // to display on every VBL.** This is a toggle (enable/disable) routine.* If auto text copy is on, on entry, it is disabled on exit.* If auto text copy is off, on entry, it is enabled on exit.** For Gyro, no heart beat task is required.* Toggle hardware bit5 of shadow register, $c035 * is equivalent to software copying.** This routine can be invoked from Classic Desk Accessory* or mainside entry point $f962. In the case of CDA, an      * interrupt occurred and the enviroments are stored and restored* during in and out of the CDA, this includes store and restore of* SHADOW reg, therefore it is necessay to update IRQ_SHADOW to   * reflect the most current states of shadowing.  When exits, then* restoring of SHADOW reg from IRQ_SHADOW would show the users'* preference states.TEXT2COPYFF	EQU	*	;Entry from $f962 also !!!   		IF IS512 <> 0 THEN		ELSE		PHB		;Save data bank		JSR	DBTOE1	;Change to $e1		LDA	|TP2MODE	;Toggle the flag		EOR	#$FF	;		STA	|TP2MODE	;Save back, 0/1 = off/on		JSR	SETTEXT2REG	;		BCC	@1	;BRA for //gs		PLB		;Restore data bank		RTS		;@1		EQU	*	;//gs uses software copy !!!		PLB		;Restore its data bank		SEP	#$40	;Set 'v' to indicate enabling routine		CLC		;Make call in full native mode		XCE		;		PHP		;Preserve entry status		REP	#$30	;16 bit land required		OPCODE	BVC	;Do a trick to save a byte@2		EQU	*		CLV		;Skipped first time through this code		PEA	TP2THDR>>16	;High word of routine address		PEA	|TP2THDR	;Low word of routine address		LONGI	ON		LDX	#SETHEART	;Set up heartbeat task		BVS	@14	;'v'=1 then put in heartbeat queue		LDX	#DELHEART	;Remove from heartbeat task		LONGI	OFF@14		EQU	*	;'v'=0=disable 'v'=1=enable routine		JSL	>DISPATCH1	;Off to tool locator		BCS	@2	;Already on then disable txt pg 2 copier		PLP		;Recall entry status (8 bit mode)  		LDA	#$08	;Enable VBL's to start up copier		TSB	INTEN	;		XCE		;Switch back to entry state now		ENDIF		RTS		;Back to caller		TITLE	'Special Entry Routines'*******************************************************                                                    **   Special Entry Rtnes for Control Panel Desk Acc   **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************	; SEG $FFSPEC_PANEL	EQU	*	;Closed Apple reset enters here	; SEG $00		SEI		;Disallow data register interrupts		LDA	#$10	;Bit 4 is data register interrupt enable		TRB	KMSTATUS	;		CLI		;Re-enable interrupts		JSR	T480CARD2	;'z'=0 if 80 cols - 'z'=1 if 40 cols OK		BEQ	@1	;= then 80 columns OK		STA	SETINTC3ROM	;Enable internal $C300 ROM@1		EQU	*		LDA	#$11	;Must set up funny 40 column mode		JSR	C300FF	; this way.		JSR	TURNONMTXT	;Enable mouse text characters		LDA	#$80	;Must run in high speed		STA	CYAREG	;Ignore disk ][ motor on detects		STA	>SYSTEMSPD	;Besure all runs fast		ASL	A	;Zero out bytes to force reboot		STZ	SOFTEV+1	;Be sure vectors cause cold boot		STZ	PWREDUP	;Reset power up byte too.		LDY	#SPECOPV	;Vertical pstn to start on		LDX	#SPECOPH	;Horizontal pstn to start on		LDA	#SPCHOICES	;Show choices		JSR	PRINTMSGXY	; to user here		JSR	ALLBORDER	;Put up complete border		STA	SETSLOTCXROM	;Enable external CX ROM as per entry state@2		EQU	*		LDA	KBD	;Check for what to do		BPL	@2	;Loop til key pressed		STA	KBDSTRB	;Clear key pressed		CMP	#'1'	;1,2,3,4 only keys allowed		BEQ	@6	;Enter Control Panel		CMP	#'2'	;= 2 then do #2		BEQ	@3	;Restore standards and 60 hertz		CMP	#'3'	;= 3 then do #3		BEQ	@4	;Restore standards and 50 hertz		CMP	#'4'	;=4 then do #4		BEQ	@5	;Continue with boot		JSR	NEWBELL1	;Indicate illegal choice		BRA	@2	;Loop for new keypress@3		EQU	*		JMP	>WRITESTD	;Write standards with 60 hertz@4		EQU	*		JSL	>WRITESTD	;Write standards with 60 hertz		LDA	#DISPOP4_0+1-DISPOP4_0	;50 hertz indicator		STA	>USERHERTZ	;Make change		JMP	>WRITEBR	;Write change to BATTERYRAM@5		EQU	*		RTL		;Back to caller@6		EQU	*	;Set screen size before entry		LDA	>USERCOL	;0=40 / 1=80		BEQ	CTRL_PANEL	;= then leave in 40 columns 		LDA	#MTXTON	;Enable Mouse Text and 80 columns		JSR	C300FF	;Enable 80 columns* Fall into control panel from here		TITLE	'Control Panel Main Routines'*******************************************************                                                    **   Main Routines for Control Panel Desk Accessory   **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************	; SEG $FFCTRL_PANEL	EQU	*	;E1 vector enters here	; SEG $00		LDA	RDCXROM	;Save/restore INTCXROM/SLOTCXROM status		PHA		;		PHP		;Disable int while saving/changing vector		SEI		;		LDA	KMSTATUS	;Save keyboard interrupt enable		STA	ZKMSTATUS	;		LDA	VGCINT	;Bit 2 hold 1-sec int enable bit		STA	ZVGCINT	;Save for later		LDA	#$04	;Bit 2 is kbd interrupt enable bit		TRB	KMSTATUS	;Disable keyboard interrupts		TSB	VGCINT	;Enable 1 second interrupt		STZ	SCANINT	;Reset 1 second timer interrupt		REP	#$20	;16 bit world for now		LONGA	ON		LDA	>IRQ_1SEC	;Save 1 second vector		STA	ZIRQ_1SEC	;		LDA	>IRQ_1SEC+2	;		STA	ZIRQ_1SEC+2	;		PHK		;Bank number of interrupt code		LDX	#>CPINTHNDLR	;Hi byte of address		PHX		;		PLA		;Recall 16 bit bank num/hi byte		STA	>IRQ_1SEC+2	;Change vector		LDA	#CPINTHNDLR*256+$5C	;Low byte of addr / JMP abs long		STA	>IRQ_1SEC	;		LONGA	OFF		SEP	#$30	;8 bit world to continue		PLP		;Re-enable ints with new vector installed		JSL	>READBR	;Read in user selections from BATTERYRAM		SEC		;Set up everything EXCEPT slots		JSL	>TOBRAMSETUP	;Setup batteryram choices* Current RAM Disk size		LDX	#$02	;Push 4 bytes on stack for result		JSR	PUSH	;		IF IS512 <> 0 THEN		ELSE		LONGI	ON		LDX	#GRDSZN*256+RDN	;Function number/tool set number		LONGI	OFF		JSL	>DISPATCH1	;Go make total RAM call		ENDIF		LDA	1,S	;Get size from stack		STA	CURRENTRAM	;Save full 32 bits		LDA	3,S	;Save hi word too		STA	CURRENTRAM+2	; and save in zero page for later* Free RAM for RAM Disk = Total system RAM - 256K** NOTE: 4 bytes were left on the stack from Current*       RAM Disk size call.  The space they occupy*       will be used for the total system RAM call.		IF IS512 <> 0 THEN		ELSE		LONGI	ON		LDX	#TMEMN*256+MMN	;Function number/tool set number		LONGI	OFF		JSL	>DISPATCH1	;Go make total RAM call		ENDIF		LDA	1,S	;Save 32 bits		STA	TOTALSRAM	;Save as total system RAM size		STA	FREERAM	;Save as low byte of FREERAM too		LDA	3,S	;Save hi word too		STA	TOTALSRAM+2	;Save as total system RAM size		SEC		;Subtract 256K		LONGA	ON		SBC	#$0004	;256K is for system		STA	FREERAM+2	;Save as Free RAM for RAM disk		LONGA	OFF		BNE	@1	;<>= then there is ram to work with		STA	>USERMRAM	;00 variables because something's wrong!!!		SEP	#$30	;8 bit mode for call		JSL	>TOWRITEBR	;Write new parameter to BATTERYRAM		REP	#$30	;16 bit mode to continue* RAM used for program = Total system RAM - Free system RAM** NOTE: 4 bytes were left on the stack from Total*       system RAM call.  The space they occupy*       will be used for the free RAM call.@1		EQU	*		IF IS512 <> 0 THEN		ELSE		LONGI	ON		LDX	#FMEMN*256+MMN	;Function number/tool set number		LONGI	OFF		JSL	>DISPATCH1	;Go make free RAM call		ENDIF		LDA	1,S	;Save as 32 bits		STA	TOTALFRAM	;Save as Total Free RAM		LDA	3,S	;Save hi word too		STA	TOTALFRAM+2	;Save as Total Free RAM		LDA	TOTALSRAM	;		SEC		;Prepare to subtract		SBC	TOTALFRAM	;Subtract total free RAM low byte		STA	PROGRAMRAM	;Save as RAM used by program size		LDA	TOTALSRAM+2	;Now do high bytes		SBC	TOTALFRAM+2	;		STA	PROGRAMRAM+2	;Save as RAM used by program size		PLA		;Clean 4 bytes off the stack		PLA		;		SEP	#$30	;Back to control panel mode		JSR	TURNONMTXT	;Enable printing of mouse text characters* Clear screen and put line over main title position.		LDY	#CPVPOSITION-1	;Set up total screen clear		JSR	CLRTOBTM	;Clear to bottom of screen		LDX	#CPHPOSITION	;Horizontal position		LDY	#CPVPOSITION-1	;Vertical position		JSR	FIXVTAB	;Move to position		LDA	#BOTTOMLINE	;Output 1 char to set OURCH if in 80 cols		JSR	FILLREST	;Put in underline stuff		LDA	#CPQUIT-CPLN1	;Point to QUIT option		STA	CURSCRN	;Last main screen pointer position* Restart main menu screen hereMAINMENU		EQU	*	;Restart program here from submenus		SEI		;Keep clock off til screen setup		LDA	CURSCRN	;Where should we point to?		STA	CURLINE	;* Change CURSCRN to point to main screen data		LDA	#CPQUIT-CPLN1	;Point to QUIT option		STA	CURSCRN	;Last main screen pointer position* Clear to bottom of screen		LDY	#CPVPOSITION	;Set up partial screen clear		JSR	CLRTOBTM	;Clear to bottom of screen* Put up title		JSR	PRTTITLE	;Print title		JSR	UNDERTITLE	;Fill rest of line and underline it* Set up some zero page parameters for* submenu screens and indicator selection routines.		JSR	GETSTATNUM	;* Put up border/footnotes/prompt boxes.		JSR	PRINTBORDER	;Print border* Put up main menu screenSHWMAINMENU	EQU	*	;Put up main menu		LDA	#MPOSITION-1	;Vertical position -1		STA	CV	;		LDA	#CPLN1	;1st line to print@1		EQU	*		PHA		;Save for testing if done		INC	CV	;Next vertical position		SEC		;Calculate where we are		SBC	#CPLN1	;		CMP	CURLINE	;Inverse if =		BNE	@11	;		JSR	TURNOFFMTXT	;Enable printing inverse characters@11		EQU	*		LDY	CV	;'Y' contains vertical postn for FIXVTAB		LDX	#LNPOSITION	;Horizontal tab		LDA	1,S	;Recall message number to print		JSR	PRINTMSGXY	;		JSR	TURNONMTXT	;Always reenable printing mouse text chars		PLA		;		INC	A	;		CMP	#CPLN1+MMLEN+0	;		BCC	@1	;Loop til done		JSR	SELECTLINE	;Select main menu option		CMP	#RETURNKEY	;If return pressed go to submenu		BEQ	RDYSBMENU	;If return pressed do submenu stuff		CMP	#ESCKEY	;If Esc pressed move arrow to Quit option		BEQ	@16	;<>= then beep the user		CMP	#$00	;=0 then just redisplay screen		BEQ	SHWMAINMENU	;		JSR	NEWBELL1	;Indicate illegal key pressed		BRA	SHWMAINMENU	;Look for another key@16		EQU	*		LDA	#CPQUIT-CPLN1	;Force arrow to move to Quit option		STA	CURLINE	;		BRA	SHWMAINMENU	;Move to Quit* Mark submenu chosen and test for Quit.RDYSBMENU		EQU	*		LDX	CURLINE	;Check for line number chosen		STX	CURSCRN	;Save as screen chosen		CPX	#CPQUIT-CPLN1	;Quit chosen?		BNE	RDYSBMENU1	;<>= then don't quit* Exit Routine for Control PanelNOTPASS		EQU	*		PHP		;Disable int while restoring vector		SEI		;		LDA	ZVGCINT	;Bit 2 hold 1-sec int enable bit		STA	VGCINT	;Save for later		LDA	ZKMSTATUS	;Restore keyboard interrupt status		STA	KMSTATUS	;		REP	#$30	;16 bit world for now		LONGA	ON		LDA	ZIRQ_1SEC	;Restore 1 second vector		STA	>IRQ_1SEC	;		LDA	ZIRQ_1SEC+2	;		STA	>IRQ_1SEC+2	;		LONGA	OFF		SEP	#$30	;8 bit world to continue		PLP		;Re-enable ints with orig vector installed		SEC		;'c'=1 indicates do NOT do slt designation		JSL	>TOBRAMSETUP	;Reset setup parametersRDYSBMENU0	EQU	*	;Called by text page 2 desk accessory		PLA		;Restore INTCXROM/SLOTCXROM		BMI	@1	;'-' then we stay in INTCXROM space		STA	SETSLOTCXROM	;'+' then switch back in SLOTCXROM space@1		EQU	*		RTL		;Back to callerRDYSBMENU1	EQU	*		SEI		;Keep clock off til screen setup* Before get to control panel submenu, update the original gs* maximum ramdisk option with the 're-size ramdisk during next* reset' value so that when changing with cursor, it would* point to the right batteryram buffer location without  * changing all the rest of the reference tables. When exits* from control panel, update it back !!!		LDA	>USERRSTRAM	;Get re-size option		STA	>USERXRAM	; save to maxi ramdisk to fool around  * Also for slot submenu, update USERSLT1 with SPCLSLT1 so that all* printing can use USERSLT1 offset correctly.  When exiting from* slot submenu, then copy USERSLT1 to SPCLSLT1 and then update * USERSLT1 for 0/1 so that AppleTalk can function properly with* System disk <= 4.0 but >= 3.2 !!!		LDA	>SPCLSLT1	;Before enter submenu, update USERSLT1 w/		STA	>USERSLT1	;  this special slot1 byte * Undo main title indicator@1		EQU	*		JSR	PRTTITLE	;Print title		JSR	FILLSPACE	;Fill rest of line with spaces* Underline main title and overline submenu title		LDX	#CPHPOSITION-1	;Put up separater		LDY	#CPVPOSITION+1	;Vertical position		JSR	FIXVTAB	;Move there		JSR	FILLDBLBAR	;Fill rest of line with double bar* Underline submenu title		LDX	#CPHPOSITION	;Horizontal position of overline		LDY	#SPOSITION-1	;Underline submenu title		JSR	FILLTOPLINE	;* Put up submenu title and submenu title indicator		LDX	#CPHPOSITION	;Horizontal position		LDY	#SPOSITION-2	;Vertical position		JSR	FIXVTAB	;Move there		JSR	PR1BLNKFF	;Print a space		CLC		;Calc msg num for title of submenu screen		LDA	CURSCRN	;Screen number chosen is offset		ADC	#CPLN1	;Add starting message number		JSR	PRINTMSG	;Print submenu title		JSR	FILLINVSPACE	;Fill rest of line with inverse space* Clear submenu screen area.RSTPORTMENU	EQU	*		STZ	CURLINE	;Start on 1st line always		LDY	#SPOSITION-1	;Clear from here		JSR	CLRTOBTM	;Clear to end of screen		LDY	#SPOSITION-1	;Vertical position to start submenu screen		JSR	ADDBOTTOM2	;Top line of submenu* Setup submenu zero page variables		JSR	GETSTATNUM	;Set up submenu information* Put up submenu border		JSR	PRINTBORDER	;* Get latest clock values		LDX	#$04	;Push 8 bytes on stack		JSR	PUSH	;		IF IS512 <> 0 THEN		ELSE		LONGI	ON		LDX	#RTHFN*256+MTN	;Function number/Misc Tool number		LONGI	OFF		JSL	>DISPATCH1	;Call main Tool Locator		ENDIF		SEP	#$30	;8 bit land a must now		PLA		;Recall second count		STA	ZSECOND	;Save in zero page		PLA		;Recall minute count		STA	ZMINUTE	;Save in zero page		PLA		;Recall 24 hour time		STA	Z24HOUR	;Save in zero page		PLA		;Recall year count		CMP	#$64	;If >= $64 (100 decimal) then subtract $64		BCC	@123	;< then save without subtracting 100		SBC	#$64	;Offset for years >= the year 2000@123		EQU	*		STA	ZYEAR	;Save in zero page		PLA		;Recall day count		STA	ZDAY	;Save in zero page		PLA		;Recall month count		STA	ZMONTH	;Save in zero page		PLA		;Eat null byte		PLA		;Eat day of week		LDA	>USERDATE	;Move to zero page		STA	ZDATE	;		LDA	>USERAMPM	;		STA	ZAMPM	;* Put up submenu screen chosen		JSR	PRTMODEM	;CHK for printer/modem screen		BNE	@125	;BRA if not 1st line of prt/modem		JSR	SELECTLINE	;Fool to 2nd line 		BRA	RSTSBMENU	;Continue on@125		EQU	*		STZ	NEWLINE	;Be sure to inverse 1st item 1st line		JSR	PRINTSBMENU	;Print submenu		STZ	CURLINE	;Start on 1st submenu line always* Select which line on submenu to act onRSTSBMENU		EQU	*		LDA	CURLINE	;Must preserve around PRINTSBMENU call		STA	NEWLINE	;Save for print routine		PHA		;		JSR	PRINTSBMENU	;Print submenu		PLA		;Recall CURLINE		STA	CURLINE	; and restore.		JSR	SELECTLINE	;Select submenu line number to do		CMP	#$00	;=0 then reshow screen		BEQ	RSTSBMENU	;		CMP	#ESCKEY	;Escape pressed then back to main menu		BNE	NOTESC	;RSTSBMENU2	EQU	*		SEC		;'c'=1 indicates do NOT do slt designation		JSL	>TOBRAMSETUP	;Reset setup parameters		JMP	MAINMENU	;Restart main menuNOTESC		EQU	*		CMP	#RETURNKEY	;If return write data to BATTERYRAM		BEQ	@11	;BRA if CR pressed		JMP	NOTCRETURN	;@11		EQU	*		LDA	CURSCRN	;Which screen were we on?		CMP	#CPLN4-CPLN1	;If it's the time screen reset the clock		BNE	@12	;		IF IS512 <> 0 THEN		ELSE		LDA	ZMONTH	;Push month on stack for WriteTime call		PHA		;		LDA	ZDAY	;Push day on stack for WriteTime call		PHA		;		LDA	ZYEAR	;Push year on stack for WriteTime call		CMP	#40	;If =< then add $64		BCS	@2	;@1		EQU	*	;Add $64 (100 decimal) to the year		CLC		;Clear carry to add		ADC	#$64	;Add offset@2		EQU	*		PHA		;		LDA	Z24HOUR	;Push hour on stack for WriteTime call		PHA		;		LDA	ZMINUTE	;Push minute on stack for WriteTime call		PHA		;		LDA	ZSECOND	;Push second on stack for WriteTime call		PHA		;		REP	#$30	;16 bit land a must for tool calls		LONGI	ON		LDX	#WTHFN*256+MTN	;Function number*256 + Misc Tool number		LONGI	OFF		JSL	>DISPATCH1	;Call main Tool Locator		SEP	#$30	;Back to 8 bit land		ENDIF		BRA	@18	;@12		EQU	*		CMP	#CPLN9-CPLN1	;If it's RAM Disk then send parameters		BNE	@18	;Skip RAM Disk parameter send stuff@13		EQU	*		IF IS512 <> 0 THEN		ELSE		REP	#$30	;16 bit land required for all tool calls		LONGI	ON		LDX	#SRDSZN*256+RDN	;Function num*256 + RAM Disk call num		LONGI	OFF		JSL	>DISPATCH1	;Go through tool locator		SEP	#$30	;Back to 8 bit land		ENDIF@18		EQU	*		JSR	WARNPROMPT	;Maybe put up a warning prompt		BCS	RSTSBMENU	;Restart same screen		LDA	>USERXRAM		STA	>USERRSTRAM		BEQ	@20_1		LDA	#$00		STA	>RAMDSKPWRUP@20_1		EQU	*		LDA	>USERMRAM		STA	>USERXRAM* If slot screen is properly sets up, then need to copy USERSLT1 to* SPCLSLT1 and then play around for USERSLT1 so that AppleTalk can* function properly with System disk <= 4.0 !!!* If slot7 is set to 'Your Card', then USERSLT1 = SPCLSLT1 * Also needs to update 'Device Connected' in Printer Port/Modem* Port respectively since users can't change it.  		LDA	>USERSLT1	;Update SPCLSLT1 w/ USERSLT1		STA	>SPCLSLT1	; 		TAX		;Save 'A'		BEQ	@22	;BRA for 'printer,0' -> 'printer,0'		DEC	A	;		BEQ	@26	;BRA for 'Your Card,1' -> 'Your Card,3'		DEC	A	;		BEQ	@24	;BRA for 'AppleTalk,2' -> 'AppleTalk,2'		DEC	A	;		BEQ	@25	;Should be 'Modem,3' -> 'Modem,1'		DEC	A@26		EQU	*		INC	A@24		EQU	*		INC	A	;@25		EQU	*		INC	A@22		EQU	*		STA	>USERPORT1	;Set proper value for USERPORT1@23		EQU	*		LDA	>USERSLT2	;DO the same for slot2 and Modem Port		BEQ	@31	;BRA for 'Modem, 0 ' -> 'Modem, 1'		DEC	A	;		BEQ	@36	;Bra for 'Your Card, 1' -> 'Your Card,3'		DEC	A	;		BEQ	@32	;BRA for 'AppleTalk, 2' -> 'ApTalk,2'		DEC	A	;		BEQ	@33	;BRA for 'Printer, 3' -> 'Printer,0'		DEC	A@36		EQU	*		INC	A@32		EQU	*		INC	A@31		EQU	*		INC	A@33		EQU	*		STA	>USERPORT2	;Update it@35		EQU	*		LDA	>USERSLT7	;Get slot7 configuration		BNE	@19	;BRA if set to 'Your Card'		TXA		;Get back 'A'		CMP	#$02	;Is slot1 selected for ApTalk		BEQ	@20	;If 2, make it 1 for 'Your Card'		LDA	#$01	;Else make it $00, other than ApTalk@20		EQU	*		DEC	A	;Adjust for old ApTalk Disk to run		STA	>USERSLT1	;Update it@19		EQU	*		JSL	>TOWRITEBR	;Write info from BRAM buff to BATTERYRAM		JMP	RSTSBMENU2	;Restart same menu after setupNOTCRETURN	EQU	*		PHA		;Save key pressed		BIT	STATBYTE	;Bit 6 = normal/special change function		BVS	SPECCHANGE	;'v'=1 then special change functionRDYTSTKEY		EQU	*		JSR	GETUSROPT0	;Get option shown currently on screen		PLX		;Recall keypressed		JSR	TSTKEYNOW	;Now test key pressed		JSR	WARNPROMPT	;Maybe put up a warning prompt		JMP	RSTSBMENU	;Restart submenu screenTSTKEYNOW		EQU	*		CPX	#LEFTAKEY	;Test for left or right arrow		BEQ	DECOPTION	;Decrement option if left arrow		TAX		;Save 'a'		JSR	CHKGSC	;Check for GSc machine		BCS	@1	;BRA if not		LDA	CURLINE	;What line of slot screen ?		BEQ	@2	;		CMP	#$01	;		BNE	@1@2		EQU	*		TXA		;CHK if currently at 'default one'		BNE	@11		INC	A	;Else add one more to skip over		BRA	@11	;@1		EQU	*		TXA@11		EQU	*		INC	A	;Increment to next option		CMP	NUMOPTS	;If at max then wrap to first item		BCC	LRNORMEXIT	;< then no right arrow wrapping		LDA	#$00	;Minimum option number = 0LRNORMEXIT	EQU	*	;Left/right arrow normal exit		STA	[BRAMPTR],Y	;Save back as new user option		CLC		;Clear carry to add		LDA	CURLINE	;Calculate message number of line were on		TAX		;Save in 'X' for PRINTLINE		ADC	NUMFIRSTLN	;Offset + 1st line msg # = correct msg num		JSR	PRINTLINE	;Print line		JMP	PRINTOPTION	;Print line's new optionDECOPTION		EQU	*	;Left arrow was pressed if here		TAX		;Sets 'z'		BNE	@1	;= then left arrow wrap must occur		LDA	NUMOPTS	;Pick up max option number to wrap		BRA	@11@1		EQU	*		JSR	CHKGSC		BCS	@2		LDA	CURLINE		BEQ	@3		CMP	#$01		BNE	@2@3		EQU	*		TXA		CMP	#$02		BNE	@11		DEC	A		BRA	@11@2		EQU	*		TXA@11		EQU	*		DEC	A	;Decrement to next option		BRA	LRNORMEXIT	;Exit through common exit pointSPECCHANGE	EQU	*	;'v'=1 then special change function		JSR	GETUSROPT0	;Get option shown currently on screen		LDX	CURSCRN	;Which screen we on?		BEQ	CHDISP	;=0 then its display screen change		CPX	#CPLN2-CPLN1	;		BEQ	CHSOUND	;= then its sound screen change		CPX	#CPLN4-CPLN1	;		BEQ	@1	;= then its clock screen change		CPX	#CPLN9-CPLN1	;		BEQ	@2	;= then its ramdisk screen change		PLA		;Recall keypress from stack		JMP	MAINMENU	;Return to main menu for now@1		EQU	*		JMP	CHCLOCK	;Off to change clock routine@2		EQU	*		JMP	CHRAMDSK	;Off to change ramdisk routineCHDISP		EQU	*	;Display screen change requested		LDA	CURLINE	;Which line we on?		CMP	#DISPLN7-DISPLN1	;On 'Standards' line?		BNE	@10	;<>= then don't put up standard colors		PLA		;Pull keystroke from stack		LDX	#2	;Move 3 bytes@13		EQU	*		LDA	>DISPDFTT,X	;Default parameters		STA	>USERTEXT,X	;Save as new user parameters		DEX		;		BPL	@13	;Loop til 3 bytes moved		BRA	@12	;@10		EQU	*		CMP	#DISPLN3-DISPLN1	;< then do normally		BCS	@11	;> or = then special stuff		JMP	RDYTSTKEY	;Go to normal loop@11		EQU	*		JSR	GETUSROPT0	;Get option shown currently on screen		PLX		;Recall keypressed		CPX	#LEFTAKEY	;Test for left or right arrow		BEQ	@14	;Decrement option if left arrow@11_1		EQU	*		INC	A	;Increment to next option		CMP	NUMOPTS	;If at max then wrap to first item		BCC	@11_2	;< then no right arrow wrapping		LDA	#$00	;Minimum option number=0@11_2		EQU	*	;Left/right arrow normal exit		JSR	TSTTXTBGD	;Test text color vs background color		BCS	@11_1	;'c'=1 then increment one more time@12		EQU	*	;Left/right arrow normal exit		LDA	CURLINE	;Save line number we're on		PHA		;		LDY	#SPOSITION	;Vertical position for 1st line		STY	CV	;		STZ	CURLINE	;Needed to redraw screen		JSR	DISPSBM	;		BRA	BK2SBMENU	;Restart submenu@14		EQU	*	;Left arrow was pressed if here		TAX		;Sets 'z'		BNE	@16	;= then left arrow wrap must occur		LDA	NUMOPTS	;Pick up max option number to wrap@16		EQU	*		DEC	A	;Decrement to next option		JSR	TSTTXTBGD	;Test text color vs background color		BCS	@14	;'c'=1 then decrement one more time		BRA	@12	;Exit through common exit pointCHSOUND		EQU	*	;Sound screen change requested		PLX		;Recall keypress from stack		JSR	TSTKEYNOW	;Test key end do option change		LDA	SOUNDCTL	;Change low nybble only		AND	#$F0	;		ORA	>USERVOL	;What's user volume?		STA	SOUNDCTL	;Alter user's volume		AND	#$0F	;What's user volume?		STA	>IRQ_VOLUME	;Save as new interrupt manager value		ASL	A	;Shift to hi nybble for Ensoniq routines		ASL	A	;		ASL	A	;		ASL	A	;		STA	>SYSVOLLOC	;Save for Ensoniq sound routines		JSR	NEWBELL1	;Let user hear new volume/chimes		BRA	BK2SBMENU2	;Return to sub menu for nowCHRAMDSK		EQU	*	;Ramdisk screen change		PLX		;Recall ke}pressed		CPX	#LEFTAKEY	;Test for left or right arrow		BEQ	CHRAMDISK6	;Decrement option if left arrow		INC	A	;Increment to next option		LDX	NUMOPTS	;If 0 then wrapping is automatic		BEQ	CHRAMDISK2	;		CMP	NUMOPTS	;If at max then wrap to first item		BCC	CHRAMDISK2	;< then no right arrow wrapping		LDA	#$00	;Minimum option number=0CHRAMDISK2	EQU	*	;Left/right arrow normal exit		STA	[BRAMPTR],Y	;Set maxi option = mini option		LDA	CURLINE	;Remember which line we're on		PHA		;		STZ	CURLINE	;Needed to redraw screen		JSR	RAMDSKSBM	;Reshow sceenBK2SBMENU		EQU	*	;Return to current submenu		PLA		;Recall user's line number		STA	CURLINE	;BK2SBMENU2	EQU	*	;Return to current submenu		JMP	RSTSBMENU	;Restart screenCHRAMDISK6	EQU	*	;Left arrow was pressed if here		TAX		;Sets 'z'		BNE	@18	;= then left arrow wrap must occur		LDX	NUMOPTS	;If 0 then wrapping is automatic		BEQ	@18	;		LDA	NUMOPTS	;Pick up max option number to wrap@18		EQU	*		DEC	A	;Decrement to next option		BRA	CHRAMDISK2	;Exit through common exit pointCHCLOCK		EQU	*	;Clock screen change		JSR	GOCHECKDAY	;Go check day		LDA	|ZMONTH,Y	;Get current option value		PLX		;Recall keypressed		CPX	#LEFTAKEY	;Test for left or right arrow		BEQ	@16	;Decrement option if left arrow		INC	A	;Increment to next option		CMP	NUMOPTS	;If at max then wrap to first item		BCC	@12	;< then no right arrow wrapping		LDA	#$00	;Minimum option number=0@12		EQU	*	;Left/right arrow normal exit		STA	|ZMONTH,Y	;Save back in zero page		LDA	ZDATE	;Move to user save area		STA	>USERDATE	;		LDA	ZAMPM	;		STA	>USERAMPM	; for use by scveen display.		LDA	CURLINE	;Remember which line we're on		PHA		;		STZ	CURLINE	;Needed to redraw screen		JSR	GOCHECKDAY	;Modify day if needed		JSR	RSTCLOCKSBM	;Reshow sceen		BRA	BK2SBMENU	;Restart screen@16		EQU	*	;Left arrow was pressed if here		TAX		;Sets 'z'		BNE	@18	;= then left arrow wrap must occur		LDA	NUMOPTS	;Pick up max option number to wrap@18		EQU	*		DEC	A	;Decrement to next option		BRA	@12	;Exit through common exit pointGOCHECKDAY	EQU	*		CPY	#CLOCKLN4-CLOCKLN1	;On month/day/}ear line?		BCS	@11_8	;If not, use NUMOPTS already calculated		LDX	ZMONTH	;What's the current month?		LDA	ZYEAR	;What's the current year?		AND	#$03	;Leap year?		BNE	@123	; Nope		CPX	#$01	;If yes, is it February		BNE	@123	;Nope		LDX	#$0C	;If February and leap year.@123		EQU	*		LDA	>MONTHLEN,X	;Get maximum days in month		CPY	#CLOCKLN2-CLOCKLN1	;Are we on day line?		BNE	@11_2	;No then don't change NUMOPTS		STA	NUMOPTS	;Save as new number of options@11_2		EQU	*		DEC	A	;'A' contains real day+1 to start		CMP	ZDAY	;?Test current day against maximum		BCS	@11_8	;>= then all's OK		STA	ZDAY	;@11_8		EQU	*		RTS		;Back to caller		TITLE	'Print Subroutines'*******************************************************                                                    ** Print Subroutines for Control Panel Desk Accessory **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************FIXVTAB0X		EQU	*	;Start at left side of screen		LDX	#$00	;To do that 'X' must be $00FIXVTAB		EQU	*		PHA		;Save 'A'		TXA		;Maybe change horizontal offset?		CLC		;		BIT	RD80VID	;Are we using 80 columns?		BPL	@1	;+ then we aren't.		ADC	#20	;Add 20 byte horizontal offset@1		EQU	*		TAX		;Move horizontal position to 'X'		JSR	SETVTAB	;Move there		PLA		;Recall print index		RTS		;Back to callerPRTTOPBOX		EQU	*	;Print top of box		LDA	#TOPBOX	;Top of box message numberPRTMSGXPR		EQU	*	;Print box starting at PRPOSITION		LDX	#PRPOSITION	;Horizontal box positionPRINTMSGXY	EQU	*		JSR	FIXVTAB	;Fix up print positionGOPRINTMSG	EQU	*		JMP	PRINTMSG	;Print approprmate messagePRTTITLE		EQU	*	;Print title		LDX	#CPHPOSITION	;HTAB position		LDY	#CPVPOSITION	;Vertical position		LDA	#CPTITLE	;Print title		BRA	PRINTMSGXY	;Exit via print routinePRTOPT		EQU	*	;Print an option		CLC		;Calculate message number		LDA	[OPTPTR],Y	;Starting option number		ADC	[BRAMPTR],Y	;Add user option as offset to 1st msg num		BRA	GOPRINTMSG	;Print option messagePRINTEDGES	EQU	*	;Print sides of border		LDY	#CPVPOSITION	;Vertical position to start all borders@1		EQU	*		PHY		;Wave vertical position		JSR	FIXVTAB0X	;Left border of screen		LDA	#RIGHTLINE	;Left side border		JSR	COUTFF	;		PLY		;Recall vertical position		PHY		; and resave it.		LDX	#$27	;Right side of screen		JSR	FIXVTAB	;		LDA	#LEFTLINE	;Right side border		JSR	COUTFF	;		PLY		;Recall vertical position		INY		;Next line down		CPY	#FNPOSITION	;Border edges to FNPOSITION		BCC	@1	;		BEQ	@1	;Loop on = too		RTS		;Back to callerPRINTBORDER	EQU	*		JSR	PRINTEDGES	;Print edges of border* Determine which footnote to display and display it		LDX	#CPHPOSITION+1	;Horizontal position		LDY	#FNPOSITION	;Vertical position		LDA	#TOSELUSE	;Always print 'Select:'		JSR	PRINTMSGXY	;Print footnotes		LDA	CURSCRN	;Main screen then print ^ v only		CMP	#CPQUIT-CPLN1	;Same as Quit option then on main screen		BEQ	@1	; if main screen then print$^ v only		LDA	#LRSEL	;Message number		JSR	PRINTMSG	;Print it		LDA	NUMLINES	;Test number of lines to determine prompts		CMP	#$01	;= then < > else < > ^ v		BEQ	@2	;No more footnote if = @1		EQU	*		LDA	#UDSEL	;Message number		JSR	PRINTMSG	;Print it@2		EQU	*		LDA	STATBYTE	;Check which boxes to display		AND	#$30	;Bit4=Open-Cancel/Sve | Bit5=no clk or clk		ASL	A	;Shift into 'c'/bit 7		ASL	A	;		ASL	A	;		PHP		;Save status for clock checking later		BMI	DOCANSVE	;'-' then cancel/save		LDA	#OPENCR	;?Message		BRA	PRINTBORDER4	;DOCANSVE		EQU	*		LDA	#CANCELESC	;Message		JSR	PRINTMSG	;Print message		LDA	#SAVECR	;MessagePRINTBORDER4	EQU	*		JSR	PRINTMSG	;Print message		PLP		;Recall clock status		BCC	ADDBOTTOM	;'c'=0 then no clock		JSR	PRINTCLK	;'c'=1 then print cloco boxADDBOTTOM		EQU	*		LDY	#FNPOSITION+1	;Vertical positionADDBOTTOM2	EQU	*		LDX	#$01	;Start in first column		JSR	FIXVTAB	;		LDA	#TOPLINE	;Bottom line char is TOPLINE		JMP	FILLREST	;Finish bottom in this routine* Print clock box, read time and display time in clock boxPRINTCLK		EQU	*	;Print Clock in box		LDY	#CLKPOSITION	;Vertical position		JSR	PRTTOPBOX	;Print top of box		LDY	#CLKPOSITION+1	;Vertical position		LDA	#SPACEBOX	;Message		JSR	PRTMSGXPR	;Print message at PRPOSITION		LDY	#CLKPOSITION+2	;Vertical position		LDA	#SPACEBOX	;Message		JSR	PRTMSGXPR	;Print message at PRPOSITIONPRINTCLK0		EQU	*	;Interrupt entry point		PHP		;No interrupts in here		SEI		;		IF IS512 <> 0 THEN		BRA	DUMMYTIME	;Skip ASCII message	; SEG $FFDUMMYTASCII	EQU	*	; SEG $00		DC.B	'  ROM!   No Bank FE 'DUMMYTIME		EQU	*		LDX	#$00	;Start with 1st byteDTLOOP		EQU	*		LDA	>DUMMYTASCII,X	;Move ASCII to buffer		STA	CASCIITIME,X	;		INX		;		CPX	#20	;Move 20 characters max		BCC	DTLOOP	;		ELSE		REP	#$30	;16 bit land a must for tool call		PEA	$0000	;Sets up ASCII time (Null byte and bank)		PEA	CASCIITIME	;Address of buffer		LONGI	ON		LDX	#RATFN*256+MTN	;Function number/Misc Tool number		LONGI	OFF		JSL	>DISPATCH1	;Call main Tool Locator		ENDIF		SEP	#$30	;8 bit land a must now		LDX	#PRPOSITION+2	;Horizontal position		LDY	#CLKPOSITION+1	;Time line		JSR	FIXVTAB	;		LDA	>USERAMPM	;0='AM/PM' - 1='24 HR'		BEQ	@2	;=0 then don't change offset		JSR	PR1BLNKFF	;Print a blank to offset by 1@2		EQU	*		LDX	#TIME-CASCIITIME	;Move first byte on first@4		EQU	*		LDA	>CASCIITIME,X	;		PHX		;Preserve 'X' index		JSR	COUTFF	;Print character to screen		PLX		;Recall 'X'		INX		;Decrement counter		CPX	#20	;Stop at 'X'=20		BCC	@4	;Loop til done		LDX	#PRPOSITION+3	;Horizontal position		LDY	#CLKPOSITION+2	;Vertical position		JSR	FIXVTAB	;		LDX	#DATE-CASCIITIME	;Move first byte on first@6		EQU	*		LDA	>CASCIITIME,X	;		PHX		;Preserve 'X' index		JSR	COUTFF	;Print character to screen		PLX		;Recall 'X'		INX		;Decrement counter		CPX	#8	;Stop at 'X'=8		BCC	@6	;		PLP		;Restore interrupt status		LDY	#CLKPOSITION+3	;Vertical position		LDA	#BOTTOMBOX	;Bottom of box		JMP	PRTMSGXPR	;Do it to itFILLDBLBAR	EQU	*		LDA	#DOUBLEBAR	;Fill character is double bar		BRA	FILLREST1	;FILLTOPLINE	EQU	*		LDA	#TOPLINE	;Fill character is top line		BRA	FILLREST3	;FILLINVSPACE	EQU	*		LDA	#INVSPACE	;Fill character is inverse space		BRA	FILLREST1	;FILLSPACE		EQU	*		LDA	#SPACE	;Fill character is space		BRA	FILLREST3	;No right line wanted hereFILLREST		EQU	*	;Fill rest of line with character in 'A'		PHA		;Preserve fill character		BRA	FILLREST2	;Skip RIGHTLINE stuffFILLREST1		EQU	*	;Fill rest of line with character in 'A'		PHA		;Preserve fill character		LDA	#RIGHTLINE	;Right line character neededFILLREST2		EQU	*		JSR	COUTFF	;		PLA		;Restore fill characterFILLREST3		EQU	*		PHA		;Preserve fill character		LDA	CH	;Assume 40 column display		BIT	RD80VID	;If in 80 columns get CH from OURGH		BPL	@5	;'+' use CH		LDA	OURCH	;'-' user OURCH (80 column CH)		SEC		;Prepare to subtract		SBC	#20	;Subtract 80 column offset@5		EQU	*		TAX		;'X' contains counter		PLA		;Restore fill character@7		EQU	*		CPX	#39	;Stop on CV = 39		BCS	FILLREST8	;Exit if here		PHX		;Save horizontal index		PHA		;Save fill character		JSR	COUTFF	;		PLA		;		PLX		;		INX		;Increment to next horizontal position		BRA	@7	;Loop til done* PRINTRAM determines what RAM value should* be converted from Hex to Decimal and prints it* on the RAMDISK screen.PRINTRAM		EQU	*	;Print RAM value for RAMDISK screen		JSR	GETUSROPT	;'A' contains low byte		TAY		; and save as index for later.		TXA		;On first line		BEQ	PRINTRAM0	;Do it		REP	#$20	;16 bit 'm' required here		CPX	#RAMDSKLN3-RAMDSKLN1	;On 3rd line of RAMDISK screen?		BEQ	PRINTRM2	;= then on line 3		CPX	#RAMDSKLN5-RAMDSKLN1	;On 5th line?		BEQ	PRINTRM4	;= then on line 5		CPX	#RAMDSKLN6-RAMDSKLN1	;On 6th (last) line?		BEQ	PRINTRM6	;= then on line 6		CPX	#RAMDSKLN7-RAMDSKLN1	;On 7th (last) line?		BEQ	PRINTRM8	;= then on line 7		SEP	#$30	;Exit in 8 bit landFILLREST8		EQU	*		RTS		;If here then on '  ' linePRINTRM2		EQU	*		LDA	FREERAM+1	;Free RAM for Ramdisk		BRA	PRINTRM9	;PRINTRM4		EQU	*		LDA	CURRENTRAM+1	;Current Ramdisk Size		BRA	PRINTRM9	;PRINTRM6		EQU	*		LDA	PROGRAMRAM+1	;RAM Used for Program		BRA	PRINTRM9	;PRINTRM8		EQU	*		LDA	TOTALFRAM+1	;Total RAM in usePRINTRM9		EQU	*		LSR	A	;Divide by 2 ten times this way		LSR	A	;		BRA	PRINTRAM1_8	;PRINTRAM0		EQU	*	;First line of screen		REP	#$20	;Must do in 16 bit mode		LONGA	ON		LDA	#$8000	;32768 (32K) increments used		LONGA	OFF		STA	SHIFTER	;Save in counter		STZ	SHIFTER+2	;Zero out hi bytes		PEA	$0000	;Make room for sum on stack		PEA	$0000	;		CLC		;Clear carry for 1st add@1		EQU	*		DEY		;Decrement addition counter		CPY	#$FF	;Decremented below $00 then done		BEQ	@1_2	;'-' then use $0000 as value		LDA	1,S	;Summing value		ADC	SHIFTER	;Add 32K to sum		STA	1,S	;Resave on stack		LDA	3,S	;		ADC	SHIFTER+2	;		STA	3,S	;Resave on stack		ADC	1,S	;Else add 32k to sum		BRA	@1	;Loop always@1_2		EQU	*		PLX		;Remove a byte from stack		PLA		;Result to show to user		LSR	A	;Converted to 'K'ilobytes		LSR	A	;		PLX		;Remove last excess byte from stackPRINTRAM1_8	EQU	*		SEP	#$30	;Back to 8 bit land		XBA		;Hi nybble to low nybble		TAX		;Put hi byte in 'X' for printing		XBA		;Lo byte in 'A' for printing		CLC		;'c'= 0 to right justify* Convert hex value to decimal and display* it on the screen at the current CV/CH position.** Hex number to convert to decimal ASCII* is transmitted to this subroutine in 'A' and 'X'.*       'A'=lo byte      'X'=Hi byte**       'c'=0 to right justify decimal ASCII*       'c'=1 to left justify decimal ASCII*MKDECASC		EQU	*		STA	A2L	;Lo byte into A2L		STX	A2H	;Hi byte into A2H		ROR	YSAV	;'+'/'-'=rt/lft justify decimal ASCII		LDY	#$05	;Number of times in loop@1		EQU	*		LDX	#16+1	;16 bits and 1st time do nothing		LDA	#$00	;		CLC		;C=0 so first ROL leaves A=0@2		ROL	A	;		CMP	#10	;A >= 10?		BCC	@4	;Branch if <		SBC	#10	;C=1 frm CMP and is left set@4		ROL	A2L	;		ROL	A2H	;		DEX		;		BNE	@2	;		ORA	#$B0	;Make an ascii char		PHA		;Preserve data on stack		DEY		;		BNE	@1	;		LDY	#$04	;Maximum number of bytes to print-1@6		EQU	*		PLA		;Recall byte to print		CMP	#$B0	;'0' then don't print it		BNE	@9	;		BIT	YSAV	;- then left justify else right justify		BMI	@7	;For left justification only		TYX		;Test for 'Y'=0		BEQ	@7_4	;If 'Y'=0 then do NOT print a ' '		PHY		;Preserve 'Y'		PHA		;Preserve character to print		JSR	PR1BLNKFF	;Put a space on screen		PLA		;Recall character to print		PLY		;Recall 'Y'@7		EQU	*		DEY		;Decrement counter		BPL	@6	;Don't print preceeding '0's@7_4		EQU	*		JMP	COUTFF	;Print only '0'@8		EQU	*		PLA		;Recall converted value to print@9		EQU	*		PHY		;		JSR	COUTFF	;Print value		PLY		;Recall registers		DEY		;		BPL	@8	;		RTS		;Return to caller* If Port 1 / Port 2 are all selected for * AppleTalk at the same time this routine* displeys a prompt on the Printer or Modem    * Port screen.** If they are not all active, this routine* erases the part of the screen where the* prompt would normally appear.WARNPROMPT	EQU	*		LDA	CURSCRN	;Which screen we on?		CMP	#CPLN7-CPLN1	;If Printer Port screen do some stuff		BNE	@1	;BRA if not		LDA	#$00	;Zero out serial port1 indicator flag		STA	>C1FLAG	;		JSR	GETSTATNUM	;Set up submenu information		LDA	>USERPORT1	;If =2 then AppleTalk selected		CMP	#$02	;		BNE	NOSHRINK	;BRA if not		JSR	CHPORTMENU	;Shrink the display for ApTalk @1		EQU	*		CMP	#CPLN8-CPLN1	;Else check for Modem Port screen		BNE	@3	;BRA to check for two ApTalk		LDA	#$00	;Zero out serial port2 indicatior flag		STA	>C2FLAG	;		JSR	GETSTATNUM	;		LDA	>USERPORT2	;		CMP	#$02	;Port1 already ApTalk, chk port2		BNE	NOSHRINK	;Bra if not AppleTalk selected		JSR	CHPORTMENU	;Shrink the display for$ApTalk@3		EQU	*		LDA	CURSCRN	;Get current screen again		CMP	#CPLN6-CPLN1	;Check for slot screen		BNE	NOT2APTALK	;BRA to end if not slot screen		LDA	>USERSLT1	;Get slot1 assignmnet, 2=AppleTalk		CMP	#$02	;Is it assigned for AppleTalk ?		BNE	@4	;BRA if not		EOR	>USERSLT2	;Check with slot2 assignment		BNE	@4	;<>0 then all's fine		LDA	#TWOAPTALK	;Message number		LDY	#WPOSITION	;Vertical position		BRA	@5	;Display warning message@4		EQU	*		LDA	>USERSLT7	;CHK slot7 configuration		BEQ	@6	;BRA if slot7=ApTalk		LDA	>USERSLTST	;CHK 'StartUp' selection		CMP	#$0A	;Is it set to boot from ApTalk		BNE	NOT2APTALK	;BRA if all is fine@6		EQU	*		LDA	#$02	;If slot7=ApTalk, then chk slot1/slot2		CMP	>USERSLT1	; either slot1 or slot2 needs to be 		BEQ	NOT2APTALK	; set to AppleTalk		CMP	>USERSLT2	;If slot1 not ApTalk, chk slot2		BEQ	NOT2APTALK	;BRA if all's fine		LDA	#APS1S2L1	;Message number		LDY	#WPOSITION	;Vertical position		JSR	@5	;Print error message		LDA	#APS1S2L2	;Message number		LDY	#WPOSITION+1	;Vertical position@5		EQU	*		LDX	#$01	;Vertical position		JSR	PRINTMSGXY	;Display warning message		SEC		;'C' = 1 on bad exit		RTS		;Back to caller with prompt on screenNOT2APTALK	EQU	*NOTALLON		EQU	*		LDY	#WPOSITION	;Vertical position		JSR	@1	;Space out rest of line		LDY	#WPOSITION+1	;Continue to clean next line@1		EQU	*		LDX	#$01	;Horizontal position		JSR	FIXVTAB		LDA	#SPACE		JSR	FILLREST	;Space out rest of lineNOSHRINK		EQU	*		CLC		;'C'=0 if ok      		RTS		;Back to callerCHPORTMENU	EQU	*		LDY	#$0A	;		JSR	CLRTOBTM	;		JSR	PRINTBORDER	;		RTSCENTERALINE	EQU	*		LDA	#CENTERLINE	;Print a centerline mouse text character		JMP	COUTFF	;ALLBORDER		EQU	*		LDX	#CPHPOSITION	;Horizontal position of start of border		LDY	#CPVPOSITION-1	;Vertical position of start of border		JSR	FIXVTAB	;Move to position		LDA	#BOTTOMLINE	;Output 1 char to set OURCH if in 80 cols		JSR	FILLREST	;Put in underline stuff		JSR	PRINTEDGES	;Put up edges		JMP	ADDBOTTOM	;Put up bottom of screenUNDERTITLE	EQU	*	;Fill title line and underline it		JSR	FILLINVSPACE	;Fill rest of line with inverse space* Put line under main title		LDX	#CPHPOSITION	;Horizontal position		LDY	#CPVPOSITION+1	;Vertical position		JSR	FIXVTAB	;Move to position		LDA	#TOPLINE	;Output 1 char to set OURCH if in 80 cols		JMP	FILLREST	;Put in top line stuff		TITLE	'Print Sub Menu Screens'*******************************************************                                                    **  Print Sub Menus for Control Panel Desk Accessory  **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************PDISPSBM		EQU	*	;Show display screen		JMP	DISPSBM	;PRSTCLOCKSBM	EQU	*	;Show clock screen		JMP	RSTCLOCKSBM	;PRAMDSKSBM	EQU	*	;Show ramdisk screen		JMP	RAMDSKSBM	;PRINTSBMENU	EQU	*	;Print < >'s and submenu		LDY	#SPOSITION	;Vertical position for 1st line		STY	CV	;Save to use later		LDX	CURSCRN	;Which screen do we display now?		BEQ	PDISPSBM	;Show display screen		CPX	#CPLN4-CPLN1	;Is it clock screen?		BEQ	PRSTCLOCKSBM	;Show clock screen		CPX	#CPLN9-CPLN1	;Is it ramdisk screen?		BEQ	PRAMDSKSBM	;Show ramdisk screen		JSR	GET1STLNUM	;Get 1st line message number* Print a complete submenu screen		LDX	#$00	;Counter@12		EQU	*		JSR	PRINTLINE	;Print an appropriate line		BIT	REALLNTBL,X	;'n'=1 then don't print options		BMI	@13	;		JSR	PRINTOPTION	;Print options@13		EQU	*		INC	CV	;Prepare for the next line		INC	A	;Increment message number of line		INX		;Increment counter		CPX	NUMLINES	; and test to see if done.		BCC	@12	;Loop til done		RTS		;Back to caller* Print a line up to and including ':'.* 'A' and 'X' registers are preserved.PRINTLINE		EQU	*		PHA		;Preserve 'A' and 'X'		PHX		;		LDA	REALLNTBL,X	;'-' then message delimiter line only		PHP		;Save status for later		LDA	2,S	;Recall line number we are on		CMP	NEWLINE	;If 'X' = NEWLINE then inverse		BNE	@4	;<>= then print normally		JSR	TURNOFFMTXT	;Disable mouse text + enable inverse@4		EQU	*		CLC		;Clear carry to ADC to follow		LDA	#SPOSITION	;Calculate where line goes		ADC	2,S	;Add line number		TAY		;Put in 'Y' for PRINTMSGXY		LDX	#LNPOSITION	;Horizontal position for lines		LDA	3,S	;Message number		JSR	PRINTMSGXY	;Go print it		PLP		;Do ': ' or not?		PHP		;Place holder on stack		BMI	@6	;'-' then no ': '		LDA	#':'	;Colon first		JSR	COUTFF	;		JSR	TURNONMTXT	;Always enable mouse text chars here		JSR	PR1BLNKFF	;Print a space		LDA	2,S	;Recall line number to act on		STA	CURLINE	;Save as current line		JSR	SETUPLNSTUF	;Set up zero page stuff for PRINTLINE@6		EQU	*		PLP		;Clear 1 byte off stack		PLX		;Restore 'X'		PLA		;Restore 'A'		RTS		;Back to caller* Print option prints the option corresponding* to the value in CURLINE.  SETUPLNSTUFF must be* called prior to calling PRINTOPTION.** 'A' and 'X' registers are preserved.PRINTOPTION	EQU	*		PHA		;Preserve 'A'		PHX		;Preserve 'X'		LDX	CURLINE	;Current line user is on		LDY	REALOPTTBL,X	;Get real offset into tables		LDA	[BRAMPTR],Y	;Add user option as offset to 1st msg num		LDX	CURSCRN	;Are we on language screen?		CPX	#CPLN5-CPLN1	;		BNE	@7	;If not, continue on      		TYX		;Set/reset 'z' flag		BEQ	@6	;		CPY	#$02	;2 or > then do normally		IF OPTION4 <> 0 THEN		BCS	@0	;If not, check disk1/2 ejection		ELSE		BCS	@7	;Continue on normally		ENDIF		TAX		;Transfer to 'X' index		LDA	>LAYOUTS+1,X	;Get option number offset to display		BRA	@7	;		IF OPTION4 <> 0 THEN@0		EQU	*		CPY	#$09	;$09, disk1 eject/ $0A, disk2 eject		BCC	@7	;If not disk1/2 line, then continue on		ORA	#$B0	;Else form ASCII to display, 0->$31, 1->$32...		INC	A	;Make it to start from 0 instead of 1		PHA		;Temp save		LDA	#$41	;Display Apple indicator first		JSR	COUTFF	;Display it]		LDX	#$FF	;Display '-Shift-' message@1		INX		; 		PHX		;Save index		PHB		;Save data bank		PHK		;Make data bank = current program bank		PLB		;Set it		LDA	SHIFTMSGA,X	;Access message w/ current program bank		PLB		;Restore the original bank		JSR	COUTFF	;Display it		PLX		;Get back index		CPX	#$06	;Check for end		BNE	@1	;Bra if not yet		PLA		;Get back the user selected #		JSR	COUTFF	;Display it]		BRA	COMMON	;Continue on to check for default indicator@2		EQU	*		CPX	#CPLN6-CPLN1	;Are we on slots screen ?		BNE	@7	;If$not, continue normally		PHA		;Save 'A'		LDA	>KEYUCVER	;CHK FOR GYRO or //gs		CMP	#$06	;If >= $06 then Gyro		BCS	@3	;BRA for GYRO,slot3/5 can only be internal 		PLA		;		BRA	@7@3		EQU	*		PLA		;		CPY	#$02	;Is it on slot3? Gyro, internal only		BEQ	@5	;If YES, check for internal only@4		EQU	*		CPY	#$04	;Is it on slot5 line of slots screen ?		BNE	@7	;If not, continue on normally@5		TAX		;If slot5, Is it assigned for external card ?		BEQ	@7	;Bra for OK assignment		DEC	A	;Make a skip		STA	[BRAMPTR],Y	;Update user option also		BRA	@7		ELSE		ENDIF*		IF OPTION4 <> 0 THEN@2		EQU	*		CPX	#CPLN6-CPLN1	;Are we on slot screen ?		BNE	@7	;BRA if not		CPY	#$6	;Is it on slot 7 ? External only		BNE	@7	;BRA if not		TAX		;Else set 'z' flag		BNE	@7	;Already set to external, OK !		INC	A	;Else force to set to external		STA	[BRAMPTR],Y	;Update BRAM location also		BRA	@7		ELSE		ENDIF@6		EQU	*		TAX		;Transfer to 'X' index		LDA	>LANGS+1,X	;Get option number offset to display@7		EQU	*		CLC		;		ADC	[OPTPTR],Y	;		LDX	CURSCRN	;Are we on slots screen ?		CPX	#CPLN6-CPLN1		BNE	GOPRINT	;If not slot screen, then print option msg w/ 8-bit print 		PHA		;Temp save low 'A', adjust for slot option msg to be 16-bit prt		LDA	#$01	;Set high 'A' to 1, the slots 'DS' table must start at page 1		XBA		;exchange high/low		PLA		;Restore low byte 'A'		REP	#$30	;Off to 16-bit printing		JSR	PRINTMSG2	;Execute the 16-bit printing, return w/ 8-bit		BRA	COMMON	;Continue w/ common stuff handlingGOPRINT		EQU	*		JSR	PRINTMSG	;Print message* Test if same as default optionCOMMON		EQU	*		LDX	CURLINE	;Current line user is on		LDY	REALOPTTBL,X	;Get real offset into tablesPRINTOPT2		EQU	*		JSR	FILLSPACE	;Blank out rest of line and exit		JSR	PRINTOPTDEF	;Print opt / default indicator if needed		PLX		;Restore 'X'		PLA		;Restore 'A'		RTS		;Back to callerPRINTOPTDEF	EQU	*		LDA	[BRAMPTR],Y	;Current selection		CMP	[DEFAULTPTR],Y	;Default selectionPRINTOPTDEF2	EQU	*		PHP		;Save 'z' status		LDX	#DEFPOSITION	;Default indicator position		LDY	CV	;		JSR	FIXVTAB	;Move to position		PLP		;Recall 'z' status		BNE	@1	;<>= then its not default		JSR	PRTMODEM	;CHK for 1st line prt/modem scrn		BEQ	@1	;Skip default indicator if it is		LDA	#DINDICATOR	;Print default indicator.		BRA	@2	;Continue on@1		EQU	*		LDA	#SPACE	;Anticipate remove def indicator from scrn@2		JMP	COUTFF	;DISPSBM		EQU	*	;Show display screen		JSR	GET1STLNUM	;Get 1st line message number		LDX	#$00	;Start with 1st line of screen@22		EQU	*		JSR	PRINTLINE	;Print option line		PHA		;Preserve 'A'		PHX		;Preserve 'X'		CPX	#DISPLN9-DISPLN1	;		BNE	@2_7	;<>= then handle normally		LDA	>USERHERTZ	;0=60 hertz 1=50 hertz		BNE	@1	;		LDA	#DISPOP4_0	;60 hertz message number		BRA	@2	;@1		EQU	*		LDA	#PORTOP7_0	;50 hertz message number@2		EQU	*		JSR	PRINTMSG	;Print message and restore 'X' and 'A'		JSR	CENTERALINE	;Put up centerline		BRA	@3	;Continue this way@2_7		EQU	*		PLX		;Restore 'X'		PLA		;Restore 'A'		BIT	REALLNTBL,X	;'n'=1 then don't print options		BMI	@4	;		PHA		;Save 'A'		PHX		;Save 'X'		LDA	REALLNTBL,X	;What's real line number?		CMP	#DISPLN7-DISPLN1	;If on 'Standards' line show 'Yes/No'		BNE	@2_75	;* Now test if standard values being shown.* If not put up 'No', if so put up 'Yes'.		LDX	#DISPLN4-DISPLN1	;'Text' option index		JSR	GETUSROPT	;Get user's choice		CMP	[DEFAULTPTR],Y	;Test against default value		BNE	@123	;<>= then not default color		LDX	#DISPLN5-DISPLN1	;'Background' option index		JSR	GETUSROPT	;		CMP	[DEFAULTPTR],Y	;		BNE	@123	;<>= then not default color		LDX	#DISPLN6-DISPLN1	;'Border' option index		JSR	GETUSROPT	;Get user's ghoice		CMP	[DEFAULTPTR],Y	;Test against default value		BNE	@123	;<>= then not default colors		LDA	#LANGOP3_0+1	;'Yes' message number		SEP	#$02	;Set 'z' flag		BRA	@9	;Print message@123		EQU	*	;Not default colors		LDA	#LANGOP3_0	;'No' message number@9		EQU	*		PHP		;Preserve 'z' status		JSR	PRINTMSG	;Print message		JSR	PR1BLNKFF	;Print a space		PLP		;Restore 'z' status		JSR	PRINTOPTDEF2	;Show/erase default indicator		BRA	@3	;Continue this way@2_75		EQU	*		CMP	#DISPLN3-DISPLN1	;=>3rd line then no options to display		BCC	@2_9	;		CMP	#DISPLN7-DISPLN1	;'Border'		BCS	@3	;@2_9		EQU	*		JSR	PRINTOPTION	;Print option normally@3		EQU	*		PLX		;Restore 'X'		PLA		;Restore 'A'@4		EQU	*		INC	CV	;Print next line on next vertical line		INC	A	;Next line number message		INX		;		CPX	NUMLINES	;Print all screen lines		BCC	@22	;Loop til 3 lines done		JMP	SETCOLORS	;Setup color/hertz stuffPRTOPENAPP	EQU	*	;Print with 'open-apple'		PHX		;Temp save		LDA	#$41	;Open-Apple mouse text		JSR	COUTFF	;Print it		PLX		;Get back index		DEX		BPL	PRTOPENAPP		LDA	CURSCRN	;CHK for valid password screen		BMI	@1		PLP		;Get back 'z' flag		JMP	PRINTOPTDEF2	;Print and exit@1		RTS* Show ramdisk screenRAMDSKSBM		EQU	*	;Show ramdisk screen		LDY	#SPOSITION	;Vertical position for 1st line		STY	CV	;Save to use later		JSR	GET1STLNUM	;Get 1st line message number		LDX	#$00	;Start with 1st line of screen@1		EQU	*		PHX		;Preserve 'X'		PHA		;Preserve 'A'		JSR	PRINTLINE	;Print line up to ASCII value		JSR	PRINTRAM	;Print Minimum RAM available for RAMDISK		LDA	2,S	;Test if on '  ' line or 2nd line or not		CMP	#RAMDSKLN4-RAMDSKLN1	;If on '  ' line then no 'K'		BEQ	@1_4	;'=' then skip 'K'		CMP	#RAMDSKLN4_2-RAMDSKLN1	;'RAM Status' line then no 'K'		BEQ	@1_4	;'=' then skip 'K'		CMP	#RAMDSKLN8-RAMDSKLN1	;If on ' ' line then no 'K'		BEQ	@1_4	;  		CMP	#RAMDSKLN9-RAMDSKLN1	;If on 'Re-size..' line then no 'K'		BEQ	@2_4		LDA	#'K'	;Kilobytes indicator		JSR	COUTFF	;		LDA	2,S	;Test if on 'Largest Selectable Size' line		CMP	#RAMDSKLN3-RAMDSKLN1	;		BNE	@1_4	;If not continue normally		JSR	CENTERALINE	;If so, then print a centerline@1_4		EQU	*		LDA	2,S	;Recover 'X' and 'A'		TAX		;		LDA	1,S	;		CPX	#$00	;		BNE	@2	;@1_6		EQU	*		TXY		;'Y'=line number = 'X'		JSR	PRINTOPTDEF	;Test and maybe print default indicator@2		EQU	*		INC	CV	;Next line please		PLA		;Recall 'A'		INC	A	;Next message number		PLX		;Recall 'X'		INX		;Next please		CPX	NUMLINES	;Reached last line yet?		BCC	@1	;		RTS		;Back to caller@2_4		EQU	*		LDA	>USERXRAM	;In ramdisk scrn USERRSTRAM=USERXRAM		BNE	@3	;BRA if 'Yes'		LDA	#RAMDSKOP8_0	;'No' message number		BRA	@4	;Print it@3		EQU	*		LDA	#RAMDSKOP8_0+1	;'Yes' message number@4		EQU	*		JMP	GOPRINT	;Print it and exit* Show clock screenRSTCLOCKSBM	EQU	*	;Restart clock submenu here* Set up hour format as AM-PM or 24 hour		LDA	>USERAMPM	;AM/PM / 24 hour format		BEQ	@11	;= then AM-PM format		LDY	#SPACE	;' ' ZAMPMASCII for 24 hour time format		TYX		;		LDA	Z24HOUR	;Recall 24 hour time		BRA	@14	;@11		EQU	*		LDX	#'P'	;Anticipate setting up PM		LDA	Z24HOUR	;Recall hour count		CMP	#12	;>= 12 then PM		BCC	@0	;< 12 then it's AM		BEQ	@22	;= then it's 12 PM		SBC	#12	;Subtract 12 hour offset ('c' already =1)		BRA	@22	;@0		EQU	*		TAX		;Set/clear 'z'		BNE	@1	;<>=0 then normal time		LDA	#12	;Convert 0 AM to 12 AM@1		EQU	*		LDX	#'A'	;Set up AM@22		EQU	*		LDY	#'M'	;@14		EQU	*		STX	ZAMPMASCII	;		STY	ZAMPMASCII+1	;		STA	ZHOUR	;Save converted hour value		LDY	#SPOSITION	;Vertical position for 1st line		STY	CV	;Save to use later		LDX	CURSCRN	;Which screen we on?		JSR	GET1STLNUM	;Get 1st line message number		LDX	#$00	;Start on 1st clock line@111		EQU	*	;Loop back to here for each line		PHA		;Preserve line message number currently on		PHX		;Preserve line number		JSR	PRINTLINE	;Print a line		JSR	GETUSROPT	;Sets 'Y'=corrected scrn line num offset		CPX	#CLOCKLN4-CLOCKLN1	;Line 4 gets format option		BEQ	@2	;		CPX	#CLOCKLN5-CLOCKLN1	;Line 5 gets no option		BEQ	@6	;		CPX	#CLOCKLN9-CLOCKLN1	;Line 9 gets format option		BEQ	@4	;		LDX	CURLINE	;If on hour line then get different value		CPX	#CLOCKLN6-CLOCKLN1	;		BNE	@1_1	;<>= then do normally		LDY	#ZHOUR-ZMONTH	;Change offset@1_1		EQU	*		LDA	|ZMONTH,Y	;Get hex value		CPY	#CLOCKLN1-CLOCKLN1	;On 1st line then inc value		BEQ	@1_2	;		CPY	#CLOCKLN2-CLOCKLN1	;On 2nd line then inc value		BNE	@1_4	;@1_2		EQU	*		INC	A	;Increment value@1_4		EQU	*		LDX	#$00	;Hi byte = 0		SEC		;Set left justify mode		JSR	MKDECASC	;Convert hex to decimal ASCII and print		JSR	PR1BLNKFF	;Print a space just in case		BRA	@6	;Skip format option stuff@4		EQU	*		LDY	#$01	;$00=user date fmt - $01=user time fmt		JSR	PRTOPT	;Print option message		LDY	#$01	;$00=user date fmt - $01=user time fmt		JMP	PRINTOPT2	;Enter normal print option subroutine@2		EQU	*		LDY	#$00	;$00=user date fmt - $01=user time fmt		JSR	PRTOPT	;Print option message		LDY	#$00	;$00=user date fmt - $01=user time fmt		JSR	PRINTOPTDEF	;Enter normal print option subroutine@6		EQU	*		PLX		;Recall line number		PHX		;Resave 'X'		CPX	#CLOCKLN6-CLOCKLN1	;If hour line then add AM/PM/'  '		BNE	@8	;		LDA	ZAMPMASCII	;Print 1st character		JSR	COUTFF	;		LDA	ZAMPMASCII+1	;		JSR	COUTFF	;		JSR	PR1BLNKFF	;Print an extra space just in case@8		EQU	*		PLX		;Recall line number		PLA		;Recall line message number currently on		INC	A	;Next message number		INX		;Next line number		INC	CV	;Next line		CPX	NUMLINES	;Are we done yet?		BCC	@111	;Loop til done		RTS		;Back to caller		TITLE	'Control Panel Misc Routines'*******************************************************                                                    **   Misc Routines for Control Panel Desk Accessory   **                                                    **                    by                              **               Fern Bachman   $ 1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************CLRTOBTM		EQU	*	;Clear to bottom off screen		LDA	WNDTOP	;Save original value		PHA		;		STZ	CH	;Always clear from column 0		STY	CV	;		STY	WNDTOP	;Save as new top of window		JSR	VTABFF	;Move to start of clear area		JSR	HOMEFF	;Clear to end of screen		PLA		;Restore window top		STA	WNDTOP	;		RTS		;Back to callerGETSTATNUM	EQU	*		LDX	CURSCRN	;What screen we on?		LDA	>STATTBL,X	;		STA	STATBYTE	;Save status byte for later testing		AND	#$F	;Get number of lines/screen		STA	NUMLINES	; and save for later.		JSR	PRTAPTALK	;CHK if printer port/appletalk		BEQ	@03	;BRA if yes@02		EQU	*		JSR	MODAPTALK	;CHK if modem port/appletalk		BNE	@04	;BRA if AppleTalk not selected@03		EQU	*		SEC		;Set 'c' properly for sbc		LDA	NUMLINES	;Get the NUMLINES               		SBC	#$07	;Get rid of the unwanted for ApTalk		STA	NUMLINES	;Store as new NUMLINES		SEC		;		PHP		;		BRA	@00@04		EQU	*		LDA	>KEYUCVER	;Get keyuc version#		CMP	#$06	;If >= $06, then Gyro or newer machine		PHP		;Save 'c'		BCS	@00	;BRA for Gyro or newer machine		IF OPTION4 <> 0 THEN		CPX	#CPLN5-CPLN1	;Is it language screen?		BNE	@01	;BRA if not		DEC	NUMLINES	;Else dec by 2		DEC	NUMLINES		ELSE		ENDIF@01		EQU	*		CPX	#CPLN10-CPLN1	;Is it mouse screen ? 		BNE	@00	;BRA if not		SEC		;Set 'c' properly for sbc		LDA	NUMLINES	;		SBC	#$05	;Get 5 lines off, gs doesn't have		STA	NUMLINES	;* Determine and setup line access table in zero page@00		EQU	*		TXA		;Which screen we looking at?		ASL	A	;Shift for proper indexing		TAX		;		LDA	>TRUELNTBL+1,X	;Pick up information byte		XBA		;Save in hi byte		LDA	>TRUELNTBL,X	;Pick up lo byte too		PLP		;Get back 'c'		BCS	@22	;BRA for Gyro and newer machine		CPX	#$08	;Is it keyboard screen ?		BNE	@21	;Bra if not		XBA		;Swap 'A'		ORA	#$18	;Mask off Disk2/Disk1 display lines		XBA		;Save back to high byte@21		EQU	*		CPX	#18	;Is it mouse screen ?		BNE	@22	;Bra if not		ORA	#$70	;Mask off the unwanted keyboard mouse@22		EQU	*		CPX	#12	;Is it printer port screen?		BNE	@23	;		PHA		;Save off information in 'A'		LDA	>USERPORT1	;Check for AppleTalk		BRA	@24	;;@23		EQU	*		CPX	#14	;Is it modem screen ?		BNE	@20	;		PHA		;		LDA	>USERPORT2	;@24		EQU	*		CMP	#$02		BEQ	@25		PLA		;Pull back		BRA	@20	;@25		EQU	*		PLA		;Get back information in 'A'		ORA	#$E0	;Mask off unwanted for AppleTalk		XBA		;Swap 'A'		ORA	#$FF	;Mask off some more		XBA		;Swap back to proper position@20		EQU	*		LDX	#$00	;Start with 1st line@11		EQU	*		JSR	@18	;Do some stuff		CPX	#$08	;Stop at 'X'=8		BCC	@11	;Loop if not done		XBA		;Do same to hi byte@12		EQU	*		JSR	@18	;Do some stuff		CPX	#$10	;Stop at 'X'=16		BCC	@12	;Loop if not done		LDX	#$00	;Go through REALLNTBL and make REALOPTTBL		TXY		;'Y' equal real offset counter@14		EQU	*		LDA	REALLNTBL,X	;		CMP	#$80	;'c'=1 then line is a delimiting line		STY	REALOPTTBL,X	;Save real offset in real line number tbl		INX		;Continue til 'X'=16		BCS	@15	;'c'=0 then not a delimiting line		INY		; so increment real offset counter.@15		EQU	*		CPX	#16	;'X'=16 then all done		BCC	@14	;Not done then loop back		RTS		;Back to caller@18		EQU	*		LSR	A	;Shift lo bit into 'c'		PHA		;Save on stack for later		LDY	#$80	;Anticipate skip line		BCS	@19	;'c'=1 then line not OK to acgess		TXY		;Table gets index number@19		EQU	*		STY	REALLNTBL,X	;Save in real line number table		PLA		;Recall 'A' mask		INX		;Try next bit		RTS		;* SETUPLNSTUF sets up zero page pointers for PRINTLINESETUPLNSTUF	EQU	*		PHB		;Save data bank register		PHK		;New data bank = program bank		PLB		;		LDX	CURSCRN	;What screen we on?		LDA	OPTPTRTBL,X	;Set up address of 1st message number		STA	OPTPTR+0	;Save in zero page		LDA	CPDFPTRTBL,X	;Address of defaults		STA	DEFAULTPTR+0	;		LDA	BRAMPTRTBL,X	;Address of current user choices		STA	BRAMPTR+0	;		LDA	NOPTPTRTBL,X	;Set up address of num of options/line		STA	NOPTPTR+0	;Save in zero page		LDA	#^BRAMBUFFER	;Bank number of current user choice tables		STA	BRAMPTR+2	;		PHK		;Get data bank of tables		PLA		;		STA	OPTPTR+2	;		STA	DEFAULTPTR+2	;		STA	NOPTPTR+2	;		LDA	#>DISPOP	;Hi byte of address for tables		STA	OPTPTR+1	;		STA	DEFAULTPTR+1	;		STA	NOPTPTR+1	;		LDA	#>USERCOLOR	;Address of current user choices		STA	BRAMPTR+1	;		TXA		;What screen we on?		ASL	A	;Shift to get correct index		TAX		;Move to index		PLB		;Restore data bank register		RTS		;Back to caller* GET1STLNNUM determines which screen is in use,* calculates what message number the 1st line of* the submenu screen should display, and saves* that value at NUMFIRSTLN.GET1STLNUM	EQU	*		LDX	CURSCRN	;Which screen we on?		LDA	>LNNUMTBL,X	;Recall message number of line		STA	NUMFIRSTLN	;Save as number of first line		RTS		;Back to caller* GETUSROPT gets the user's option number from bank E1.** On Input: 'X' = line number to look option up for** On Output: 'A' contains the user's option number*            Sets up NUMOPTS (maximum option number)*                in zero page.GETUSROPT0	EQU	*		LDX	CURLINE	;Which line we on?GETUSROPT		EQU	*		STX	CURLINE	;Line to access information for		JSR	SETUPLNSTUF	;		LDX	CURLINE	;Line to access information for		LDY	REALOPTTBL,X	;Get real offset into tables		LDA	[NOPTPTR],Y	;Get max number of ottions for this line		BPL	GETUSROPT6	;+ then not a special one		PHA		;Preserve 'A'		LDA	CURSCRN	;Which screen we on?		CMP	#CPLN4-CPLN1	;		BEQ	CLOCKLIM	;= then determine clock limits		CMP	#CPLN5-CPLN1	;		BEQ	LANGLIM	;= then determine language limits		PHY		;MUST preserve 'Y'		LDY	#$FF	;Counter for NUMOPTS		REP	#$20	;Need 16 bit 'm'		PEA	$0000	;Set up subtraction value on stack		PEA	$8000	;32768 is subtraction value		LDA	FREERAM	;Move to safe place		STA	SHIFTER	;		LDA	FREERAM+2	;		STA	SHIFTER+2	;		LONGA	ON		CMP	#$0080	;If 8 megabytes limit it to 8 meg-64K		LONGA	OFF		BCS	@2	;Maximum limit is 8128K not 8192K		INY		;'Y'=$00 to calculate limit normally@1		EQU	*	;Calculate max number of options		SEC		;Set 'c' to subtract		INY		;Increment for each subtract		LDA	SHIFTER	;		SBC	1,S	;Subtract 32768 each time		STA	SHIFTER	;		LDA	SHIFTER+2	;		SBC	3,S	;		STA	SHIFTER+2	;		BCS	@1	;Loop if still 'c'=1@2		EQU	*		STY	NUMOPTS	;Save as number of options for wrapping		PLA		;Clean up stack		PLA		;		SEP	#$30	;Back to monmtor mode		PLY		;Restore 'Y'		PLA		;Clean up stack		BRA	GETUSROPT8	;Exit this wayCLOCKLIM		EQU	*		PLA		;Clean up stack		PHB		;Save data bank register		PHK		;New data bank reg = program bank reg		PLB		;		LDA	NCLOCKOP,Y	;Range for current option value		PLB		;Restore data bank register		BRA	GETUSROPT6	;ExitLANGLIM		EQU	*		PLA		;Recall 'A'		ASL	A	;Shift bit 7 to 'c' and bit 6 to bit 7		BMI	@1	;'+' then language limit requested		LDA	>LANGS	;Pick up # of langs sent by key micro		BRA	GETUSROPT6	;Exit@1		EQU	*		LDA	>LAYOUTS	;Pick up # of layouts sent by key microGETUSROPT6	EQU	*		STA	NUMOPTS	;Save in zero pageGETUSROPT8	EQU	*		LDA	[BRAMPTR],Y	;Get user's choice		RTS		;Back to caller* TSTTXTBGD test which line user is on, on the* Display screen.  If user is on 'Text' or 'Background'* and the colors match the 'c' flag is set to 1.* If the colors do not match the 'c' flag is set to 0.TSTTXTBGD		EQU	*		PHA		;Preserve 'A'		STA	[BRAMPTR],Y	;Save temporary new color value		LDX	CURLINE	;Which line we on?		CPX	#DISPLN4-DISPLN1	;Line 4 is 'Text' line		BEQ	@2	;= then go do test		CPX	#DISPLN5-DISPLN1	;Line 5 is 'Background' line		BEQ	@2	;= then go do test@1		EQU	*	;Clear carry exit for no match		PLA		;Recall 'A'		CLC		;		RTS		;Back to caller@2		EQU	*		LDA	>USERTEXT	;Which color is Text?		CMP	>USERBACK	;Does it = background color?		BNE	@1	;<>= then indicate no match and exit		PLA		;Recall 'A'		SEC		; else indicate a match and exit.		RTS		;Back to callerTURNONMTXT	EQU	*	;Enable mouse text printing		PHA		;Preserve all registers		PHX		;		PHY		;		JSR	SETNORM	;Set output mask for normal characters		LDA	#MTXTON	;Enable mouse text character printingMTXTEXIT		EQU	*		JSR	COUTFF	;		PLY		;Restore registers		PLX		;		PLA		;		RTS		;Back to callerTURNOFFMTXT	EQU	*	;Disable mouse text printing		PHA		;Preserve all registers		PHX		;		PHY		;		LDA	#$7F	;Set output mask for inverse characters		STA	INVFLG	;Set inverse flag		LDA	#MTXTOFF	;Disable mouse text character printing		BRA	MTXTEXIT	;Exit this wayPRTAPTALK		EQU	*	;CHK current screen is printer/aptalk		LDA	CURSCRN	;CHK current screen		CMP	#CPLN7-CPLN1	;Is is printer port screen		BNE	BOTHXIT	;BRA if no		LDA	>USERPORT1	;CHK for appletalk assigned		BRA	TOCHKEND	;MODAPTALK		EQU	*	;CHK current screen is mod/appletalk		LDA	CURSCRN	;CHK current screen		CMP	#CPLN8-CPLN1	;Is it modem port screen		BNE	BOTHXIT	;BRA if no		LDA	>USERPORT2	;CHK appletalk assignedTOCHKEND		EQU	*		CMP	#$02	;BOTHXIT		EQU	*		RTSPRTMODEM		EQU	*	;CHK for 1st line of prt/modem screnn		LDA	CURLINE		BNE	@1		LDA	CURSCRN	;		CMP	#CPLN7-CPLN1	;		BEQ	@1		CMP	#CPLN8-CPLN1	;@1		EQU	*		RTS		EJECT		TITLE	'New BELL1 Routine'*******************************************************                                                    **         New BELL1 Routine for 40/80 Columns        **                                                    **                         by                         **                    Fern Bachman                    **                    Mike Askins                     **                    Joe  Bo*                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************NEWBELL1		EQU	*	;New BELL1 routine		JSL	>BELLVECTOR	;See if user supplied routine installed		BCS	NEWBELL2	;If no routine installed then do this one		RTS		;Exit back to monitorNEWBELL2		EQU	*		PHP		;Preserve interrupt status		SEI		;Make bell sound pretty with no ints		LDA	#$B0	;Delay in case repeated calls to BELL1		JSR	WAIT	;		LDA	CYAREG	;Slow system down		PHA		;		AND	#$7F	;		STA	CYAREG	;		PHX		;MUST preserve 'X' around this call		PHB		;Save data bank register		JSR	DBTOE1	;Data bank register to E1		LDA	|USERBELL	;Get pitch for pattern		EOR	#$0F	;Flip nybble		STA	|PITCH	;		STZ	|PITCH+1	;Be sure hi nybble = 0		REP	#$20	;16 bit land for awhile		LONGA	ON		LDA	#TOGPATTERN	;Now get pattern		STA	|TOGGLEPAT	;Save as toggle pattern		LDA	#DURBELL	;Set up bell duration counter		STA	|DURATION	;		LONGA	OFF		SEP	#$30	;Back to 8 bit land		LDA	|IRQ_VOLUME	;True volume		STA	|VOLUME	;Save as temporary volume		PHA		;Save original user volume		AND	#$0F	;Look at the volume		BNE	@2	;Bell it if not =0                   		LDA	|CLOCKCTL	; Else save original border color		AND	#$0F		PHA		;Temp store		CLI		;Enable interrupts		JSR	WAITFORVBL	;		LDA	#$0F	;Force white 		TSB	|CLOCKCTL		JSR	MYWAIT	;Call wait routine		JSR	WAITFORVBL		LDA	#$0F	;Force black		TRB	|CLOCKCTL	;		JSR	MYWAIT	;		JSR	WAITFORVBL	;		LDA	#$0F	;Force white 		TSB	|CLOCKCTL	;		JSR	MYWAIT	;		JSR	WAITFORVBL	;		LDA	#$0F	;Force black		TRB	|CLOCKCTL	;		JSR	MYWAIT	;		PLX		;Restore original border in x		SEI		;Ints off		LDA	#$0F	;Force black 		TRB	|CLOCKCTL		TXA		TSB	|CLOCKCTL	;Restore original border color		BRA	@8	;BRA to end border flashing@2		EQU	*		CLC		;Clear carry to start		REP	#$30	;16 bit land needed		LONGA	ON		LONGI	ON		LDY	|PITCH	;Pitch		LDX	#DECAY	;Decay rate@3		EQU	*		DEY		;Decrement pitch counter		BNE	@4	;<>= then skip toggle		LDY	|PITCH	;Reset pitch counter		ROL	|TOGGLEPAT	;Shift low byte by 1		BCC	@4	;'c'=0/1 no toggle/toggle speaker		LDA	SPKR	;Toggle speaker@4		EQU	*		DEX		;Decrement decay counter		BNE	@5	;		LDX	#DECAY	;Reset decay counter		SEP	#$20	;Back to 8 bit mode to change volume		LDA	|VOLUME	;What's current volume?		BEQ	@8	;Volume = 0 then quit		DEC	A	;Decrement volume		STA	|VOLUME	;Resave volume counter		STA	|IRQ_VOLUME	;Save for interrupt handler		STA	|SOUNDCTL	;Make hardware volume change		REP	#$20	;Back to 16 bit land		BRA	@6	;Skip delay loop@5		EQU	*		LDA	#0005	;28 cycle delay@5_5		EQU	*		DEC	A	;		BNE	@5_5	;@6		EQU	*		DEC	|DURATION	;Duration made it to 0 yet?		BNE	@3	;If not, then loop some more* Exit new bell routine after fixing up system volume@8		EQU	*		SEP	#$30	;Back to 8 bit land to quit		LONGA	OFF		LONGI	OFF		PLA		;Restore user volume		STA	|IRQ_VOLUME	;		STA	SOUNDCTL	;		PLB		;Restore data bank register		PLX		;Must preserve 'X' around this call		LDY	#$00	;Some users require 'Y'=0 on exit		PLA		;Restore CYAREG		STA	CYAREG	;		PLP		;Restore users interrupt status		RTS		;Back to callerMYWAIT		EQU	*		LDA	#$FF	;Input for 'wait'		JMP	WAIT	;Do wait, appro 160 ms* This small sub-routine would wait forever if a VBL task* kept me from reading the counters in time.  So we add * a timeout counter.** This counter assumes 18 cycles per loop* 2.8 million cycles per second* 60 vbls a second** 2800000/60/18 = 2600 (approx)** (Add 200 more for good luck)*WAITFORVBL	EQU	*		REP	#$10	;		LONGA	OFF		LONGI	ON* * Don't want to use the vertical count here.  Better*  to use the actual VBL signal.  (mensch/askins 3/16/89)*@1		LDA	|RDVBLBAR		BMI	@1@2		LDA	|RDVBLBAR		BPL	@2* ; LDX #2800 ;No more than 2800 times through loop;@WAIT EQU *; LDA :VERTCNT ;Addr for read of video cntr bits v5-vb; AND #$7F; ASL A; CMP #220; BCS @DONE; DEX; BNE @WAIT**@DONE		EQU	*		SEP	#$10		LONGI	OFF		RTSBELLLEN		EQU	*-NEWBELL1	;Length of NEWBELL1 routine