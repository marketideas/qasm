;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 5:28:9 PM************************************************                                             **  ADB Keyuc Code for Reset and Control Panel **                                             **                  by                         **           Peter & Fern     1985-1987        **           Joe Bo           1987-1989        **                                             **  Copyright Apple Computer, Inc. 1985-1989   **           All Rights Reserved.              **                                             **                                             ************************************************* Entry Points:* RESETFDB ---> During RESET* PANELFDB ---> On exit from Control Panel** ASSUMES 8-BIT M,X** During RESET the SYNCH command is called to initialize the uC.* By clearing the data latch while sending the SYNCH command any* pending command or status will be cleared. Since this occurs during* a RESET this data doesn't have to be preserved.* If called from the Control Panel then any pending command or status* should be preserved. This can be accomplished by starting* with an abort call. Any pending command is completed* first. (Abort call is faked by jumping directly to tool set* entry point instead of using tool locator which may not exist yet).* After ABORT command then assumes no more pending commands.* If called during RESET then SYNCH command is implemented following* ABORT command. After the SYNCH command the pending and response* flags are cleared.		LONGA	OFFRESETFDB		EQU	*	;ENTRY POINT FOR RESET		REP	#$10	;8 'm' with 16 bit 'x'		LONGI	ON		LDX	#6000	;TIMEOUT ~30MS.@1		DEX		;CLEAR DATA REG. UNTIL CMD REG. IS FREE		BEQ	@2		LDA	|DATAREG	;Read and ignore anything pending		LDA	|KMSTATUS		ROR	A		BCS	@1	;DATA REG STILL FULL@2		EQU	*		LDA	#$07	;Synch command to keyuc		JSR	CMDSEND	;Send it		LDA	|DATAREG	;Clear out data reg in case previous cmd return data@4		JSR	SETUPMODE	;SEND MODE BYTE		JSR	SETUPCNFG	;SEND CONFIGURATION BYTES, NOT TRUE ONE !!		JSR	SETKBDMSE	;CONTINUE TO SEND KBD MOUSE PARAM		JSR	SETDISKEJ	;CONTINUE TO SEND DISKS EJECT OPTIONS@3		STZ	|STATUSTMP	;Clear characters pending flags		STZ	|FLAGS* Allow a wait state for the key micro to set the buttons* properly or we could drop into diagnostics unexpectedly.** IMPORTANT:  DON'T CHANGE THE DELAY HERE !!!** If the delay is changed, then the delay in the KEYUC needs * to be changed also so that it would match with each other  * for STICKY to work right when invoking diagnostic or warm/* cold start.		LDA	#$FF	;Huge wait time of over .162 seconds		JSR	WAIT	;Call twice in a row                  		LDA	BUTN0	;GET OPEN APPLE KEY AT THIS POINT		STA	|EXTENDBNK	;SAVE FOR LATER		ROL	A	;SAVE IN CARRY		LDA	BUTN1	;GET		STA	|EXTENDBNK+1		BPL	@6	;IF EITHER BUTTON UP THEN		BCC	@6	;SKIP AROUND DIAGNOSTICS@5		EQU	*		SEP	#$30	;8 bit land a must		JSR	RAMVCTRS2	;Setup bank $e1 vectors		JMP	>DIAGS	;BOTH BUTTONS PRESSED DO DIAGNOSTICS@6		EQU	*		LDA	DIAGTYPE	;MSB SET IF BURN IN DIAGNOSTICS		BMI	@5	;JUMP TO DIAGNOSTICS		LDA	|EXTENDBNK	;Test if power up requested by user or not		ORA	|EXTENDBNK+1	;		BPL	@7	;Bra if both Apple keys are not pressed		LDA	#$00	;Else need to reset system power bytes		STA	>PWREDUP	;Reset system powerup bytes		STA	>SOFTEV+1	;		LDA	|KEYMODREG	;CHK if SHIFT pressed also		ROR	A	;STORE TO CARRY 		BCC	@7	;BRA IF SHIFT KEY NOT PRESSED		STZ	|RAMDSKPWRUP	;Force true coldstart, init memory manager@7		EQU	*		LDA	#$73	;Disable mouse SRQ, fix bug in rev2 keyuc		JSR	CMDSEND	;Send command* Now test system for powerup coldstart and* set flags/system powerup bytes/RAM disk powerup* bytes accordingly.		REP	#$30	;16 bit land a must		LONGA	ON		LDA	#>SECRTL	;Set up vectors just in case		STA	|IRQ_FLUSH+2	;		STA	|IRQ_MICRO+2	;		LDA	#SECRTL*256+$5C	;Low byte and JMP abslong		STA	|IRQ_FLUSH+0	;		STA	|IRQ_MICRO+0	;		LONGA	OFF		SEP	#$20	;		LDA	#$0D	;Read keyuc version# command		JSR	CMDSEND	;Send it		JSR	RCVDATA	;Receive the returned ver#		STA	|KEYUCVER	;Store for later		CMP	#$06	;>= $06 for Gyro or newer machine		BCC	@8	;BRA for old gs		BIT	CYAREG	;Check power up bit, bit6		BVC	@10	;BRA if already power up		STZ	|GSC	;Bit7=1, GSc		LDA	#$09	;Read keyuc memory command		JSR	CMDSEND	;		LDA	#$E8	;Port3 of keyuc chip		JSR	SENDDATA	;		LDA	#$00	;Forming $00E8		JSR	SENDDATA	;		JSR	RCVDATA	;Read in keyuc port3 data		AND	#$C0	;Only bit7/6 are needed		STA	|GSC	;		LDA	#$40	;Else reset power up bit for next time		STA	|CYAVER	;Set $40 for CYA chip		TRB	CYAREG	;Reset bit6=0 to show already power up		BRA	@9	;Continue on@8		EQU	*		STZ	|CYAVER	;Set $00 for FPI chip		STZ	|GSC	;Always set to $00 if old gs machine		LDA	#$09	;Read keyuc memory command		JSR	CMDSEND	;Send it		LDA	#$51	;Low byte of memory loc      		JSR	SENDDATA	;		LDA	#$00	;High byte of $0051		JSR	SENDDATA	;		JSR	RCVDATA	;Read power up byte from keyuc at loc $51		STA	|RDMEMDATA	;Store what was read		CMP	#MICROPOWER	;Is it = to power up byte?		BEQ	@10	;If = then let RAM disk alone* If here then the system was first time power up.* We must now set up KEYUC LOCATION ($51) in keyuc* to indicate this fact.		LDA	#$08	;Write to keyuc memory loaction cmd		JSR	CMDSEND	;Send it		LDA	#$51	;keyuc page0 location to write to		JSR	SENDDATA	;Send it		LDA	#$A5	;Send powerup byte to keyuc at $51		JSR	SENDDATA	;Send it@9		EQU	*		STZ	|RAMDSKPWRUP	;Let RAM disk know it's power up		STZ	|CLRHOLES	;		LDA	#$00	;Zero out SOFTEV and PWREDUP		STA	>SOFTEV+1		STA	>PWREDUP* Since the key repeat rate format for the current gs keyuc and* the new keyuc is just opposite and also two more steps in the * new keyuc, therefore it is necessary to send out the configurations* one more time here after the keyuc version has been read in.* It is checked and adjusted in the SETUPCNFG routine !!!@10		EQU	*		LDA	#$06	;Set up configuration command		JSR	CMDSEND	;Send it		JSR	SETUPCNFG	;Send real configurations for keyuc* The following routines (READ LAYOUTS & CHAR SETS) are modified* to reduce the traffic between the KEYUC for the sake of $0911* error.  It is assumed that MEGA II  chip only supports eight* countries character sets in current gs.@100		EQU	*		LDY	#$0000	;Index to batteryram buffer		LDA	#$0A	;Keyboard layout counts@101		STA	|LAYOUTS,Y	;Store to buffer		TYA		;Prepare for next store		CMP	|LAYOUTS	;check for end		INY		;Index to next		BCC	@101	;loop till end		LDY	#$0000	;Set index for char sets buffer		LDA	#$08	;Character sets counts@102		STA	|LANGS,Y	;Store to buffer (1st = count)   		TYA		;Prepare for next store		CMP	|LANGS	;Check for end		INY		;Index to next		BCC	@102	;Loop till end* Enter here if only using control panel:* Before sending the necessary commands and data to the keyuc* It needs to make an abort call to the ADB tool so that any* pending command can be handled first by the ADB tool then* the Abort command can be send out.  It is quite often that* an application is using ADB tool to talk to the ADB devices* and at the mean time tries to get to the control panel, then * if an Abort is not made to the tool, it could occur that a * command is pending and blow up the communication between the * key micro.	; SEG $FFPANELFDB		EQU	*	;ENTRY POINT FOR CONTROL PANEL	; SEG $00	;Call must be made in 8 bit m/x		SEP	#$30	;Call must be made in 8 bit m/x		LONGA	OFF		LONGI	OFF		LDA	#$0F	;Retry counts@0		EQU	*		PHA		;Temp save it		JSR	PUSH6	;Push room for 3 words on stack		LONGA	ON		LONGI	ON		PEA	$0001	;ABORT command		PHK		;Dummy address		PER	@1-1	;Return address		JSL	>ADBSENDTL	;Direct ADB tool call for sending a cmd		RTL		;Removes 3 bytes from stk/go to next instr*@1		EQU	*		SEP	#$30	;8 bit m/x		BCC	@3	;BRA if successful send		PLA		;Get back retry counts		DEC	A	;		BPL	@0	;RETRY !!!!		JMP	ADBERR	;Display $911 error@3		EQU	*		REP	#$10	;8/16 BIT m/x		LONGA	OFF		LONGI	ON		PLA		;Clean stack		LDA	#$B3	;LISTEN R3 ADRS 3 (MOUSE ID)		JSR	CMDSEND	;SEND COMMAND		LDA	#$03	;SEND NEW HANDLER - ADDRESS 3		JSR	SENDDATA	; & DISABLE SRQ		LDA	|USERHMR	;GET MOUSE TICK RESOLUTION		CMP	#$02	;>=2 then ask mouse to change resolution		BCS	HISPEED	;Bra for high resolution 		LDA	#$01	;Else set mouse handler ID=1, low res		BRA	SENDIDHISPEED		EQU	*		LDA	#$02	;Mouse handler ID=2 for high resolutionSENDID		EQU	*		JSR	SENDDATA	;SEND HANDLER 2 (LOW RES) OR 3 (HI RES)		LDA	#$05	;CLEAR MODES		JSR	CMDSEND		LDA	#$FF	;CLEARS ALL MODES		JSR	SENDDATA		LDA	#$04	;SET MODES		JSR	CMDSEND		JSR	SETUPMODE	;GET MODE BYTE		LDA	#$06	;CONFIGURATION COMMAND		JSR	CMDSEND		JSR	SETUPCNFG	;GET CONFIGURATION BYTES		LDA	|KEYUCVER	;Get keyuc version#		CMP	#$06	;		BCC	@1	;BRA for //gs		LDA	#$12	;SET KEYBOARD MOUSE PARAMETERS CMD		JSR	SENDDATA	;AND SEND IT		JSR	SETKBDMSE	;GET INIT STEP, MAX SPEED AND ACC RATE		LDA	#$13	;Send disk1/2 eject option keys		JSR	CMDSEND	;Send command byte first		JSR	SETDISKEJ@1		STZ	|STATUSTMP	;Clear characters pending flags		STZ	|FLAGS		SEP	#$30RETSEC		EQU	*		RTS* <END HERE>* Subroutine used to set up mode byteSETUPMODE		EQU	*		LDA	#0	;BUILD NEW MODES		ORA	|USERCAPS	;XOR CAPS LOCK		ASL	A		ASL	A		ORA	|USERKBUFF	;KEYBOARD BUFFERING		ASL	A		ORA	|USERDUAL	;DUAL SPEED OPTION		ASL	A		ORA	|USERFSPDE	;INCLUDE SPACE, DELETE ON DUAL		ASL	A		ASL	A		JMP	SENDDATA	;AND SEND ITSETUPCNFG		LDA	#$32	;BUILD CONFIGURATION DATA		JSR	SENDDATA0	;If error, need to clean 6 bytes for stack		LDA	|USERDISP	;CHARACTER SET		ASL	A		ASL	A		ASL	A		ASL	A		ORA	|USERLANG	;LAYOUT		JSR	SENDDATA0		LDA	|USERRDLY	;DELAY TO REPEAT		ASL	A		ASL	A		ASL	A		ASL	A		PHA		;Save 'A'		LDA	|KEYUCVER	;Get keyuc version#		CMP	#$06	;Set 'c', >=$06 then new keyuc		LDA	|USERRSPD	;Pre-load auto repeat rate		BCS	@1	;BRA if new keyuc in the system		CMP	#$08	;Else need to check the value		BCC	@2	;BRA if not > 8, old one accepts 0-7 only		LDA	#$07	;If 8, 9 then force to 7@2		EOR	#$07	;Flip low 3 bits for old keyuc@1		EQU	*		ORA	1,S	;Combine with delay to repeat		STA	1,S	;Store back to stack		PLA		;Get back and clean stack		JMP	SENDDATASETKBDMSE		EQU	*		LDA	|USERMDLY	;GET THE MOUSE DELAY-TO-START, 0-4		ASL	A	;SHIFT TO HIGH NIBBLES		ASL	A		ASL	A		ASL	A		ORA	|USERHMR	;ADD IN MOUSE TRACKING, 0-4        		JSR	SENDDATA0	;AND SEND IT		LDA	|USERSPRT	;GET THE ACCELERATION, 0-4		ASL	A		ASL	A		ASL	A		ASL	A		ORA	|USERMAXSP	;ADD IN MAX SPEED TO LOW NIBBLES		EOR	#$70	;Make accelration from 7-3		SEC		;Be careful w/ this 'c'		SBC	#$30	;Adjust acceleration to 4-0		JMP	SENDDATASETDISKEJ		EQU	*		LDA	|USERD1EJ	;Get internal disk1 ejection option key		JSR	SENDDATA0	;Send to keyuc		LDA	|USERD2EJ	;Get internal disk2 ejection option key		JMP	SENDDATA	;Send to keyucSENDDATA0		EQU	*		SEC		;Set as an indicator for error exit		BRA	COMMSEND	;Continue on....CMDSEND		EQU	*	;Send commands and data shareSENDDATA		EQU	*	; same routine		CLC		;An indicator to clean stack during exitsCOMMSEND		EQU	*		LONGA	OFF		LONGI	ON		PHP		;Save 'c' and interrupt status		SEI		;Disable interrrupt		TAX		;Save off command/data		LDY	#10	;Set re-try count to 10TRYMORE		EQU	*		LDA	KMSTATUS	;Get command register full bit --> LSB		ROR	A	;Into carry bit		TXA		;Get data back		BCS	NOTEMPTY0	;BRA if register not empty, RE-TRY!!!		STA	CMDREG	;Else store away new command/data		LDX	#7500	;TIMEOUT 7500*(2+2+4+2+3)/3 = 30 MSGOON0		DEX		BEQ	TIMEOUTERR	;Time out error		LDA	KMSTATUS	;Get command register full bit --> LSB		ROR	A	;Into carry bit		BCS	GOON0	;BRA if full, not yet read by keyuc		PLP		;Restore 'c' and interrupt status		RTSNOTEMPTY0		EQU	*		DEY		;Try one more time		BEQ	NOTEMPTY	;Already re-try 10 times		BRA	TRYMORE	;BRA to try moreRCVDATA		EQU	*		LONGA	OFF		LONGI	ON		CLC		PHP		;Save interrupt status		SEI		;Disable interrupt		LDX	#11500	;approx 50 msGOON1		DEX		BEQ	TIMEOUTERR	;Time out error for reading		LDA	KMSTATUS	;Get data reg full bit, bit5		AND	#DATAFULL	;Test for full		BEQ	GOON1	;Not set (empty), try more !!		LDA	DATAREG	;If set then read in DATA		PLP		;Restore interrupt status		RTSNOTEMPTY		EQU	*	;Error for system writes to keyucTIMEOUTERR	EQU	*	;Error for system <---> keyuc time out		PLP		;Restore 'c' and interrupt status		BCC	CLEAN4	;If 'C' = 0 then clean 4 bytes from stack		PLX		;Else clean 6 bytesCLEAN4		PLX		;16 bit 'x', clean up 4 bytes from stack		PLX		;2 for local jsr, 2 for call to RESETFDB OR PANELFDBADBERR		EQU	*		SEP	#$30	;8 bit m/x a must		LONGA	OFF		LONGI	OFF		JSR	RAMVCTRS2	;Set up bank $e1 vectors first		PEA	ERRCODE	;Error code for tool* Word 1/2 pointer to nowhere* Word 3 = create dummy RTL address		JSR	PUSH6	;Push room for 3 words on stack		PHB		SEC		JMP	>SYSDEATH	;System death, error synch with keyuc