		TITLE	'65SC816 Dissassembler';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 6:19:49 PM*******************************************************                                                    **            Dissassembler for the 65SC816           **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **     Developed from Ed Lai's 65SC816 disassembler   **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ********************************************************* The CHKWAIT Routine was added (2/8/89 MSA) to ensure that*  Control-S keypresses would cause a pause.  Because of the*  implementation of the video firmware, ctrl-s is not always*  seen when the event manager is active.  This routine checks*  to see if the EM is active and if active gets the key from*  there.  If inactive it tries to get one from $C000.*CHKWAIT		EQU	*		PHA		;Preserve		JSR	XRDKBD	;Get a key from EM or $C000		BPL	@1		AND	#$7F		CMP	#$13		BNE	@1@2		EQU	*		JSR	XRDKBD		BPL	@2@1		EQU	*		PLA		RTS**LISTFF		EQU	*		JSR	A1PC		LDA	>MPVAL	;Retrieve 'm' status		LDX	#'m'	;Show user 'm'		JSR	PRAEQX	;Print A (in ASCII) = X (in HEX)		LDA	>XPVAL	;Retrieve 'x' status		LDX	#'x'	;Show user 'x'		JSR	PRAEQX	;Print A (in ASCII) = X (in HEX)		LDA	>DDVAL	;Retrieve 'd' status            		LDX	#'d'	;Show user 'd'		JSR	PRAEQX	;Print A (in ASCII) = X (in HEX)		LDA	>LVAL	;Retrieve LC bank status		LDX	#'L'	;Add 'k' to 'LCban'		JSR	PRAEQX	;Print A (in ASCII) = X (in HEX)		LDA	#CBANKMSG	;Display 'Cbank (0/1)'		JSR	PRINTMSG	;		JSR	LIST3	;Next line please		SEC		;Determine how many lines to display		LDA	WNDBTM	;Bottom-top-4 = number of lines to show		SBC	WNDTOP	;		SEC		;		SBC	#4	;		BPL	@1	;+ then enough lines available		BNE	@1	;<>0 can't quit now		JMP	LIST3	;Prepare to quit@1		EQU	*		JSR	CHKWAIT	;Do a pause if ctrl-s is pressed		PHA		;Save # counter on stack		LDY	#0	;Prepare to look ahead		JSR	READPCY	;Read an opcode		PHA		;Save opcode		LDA	>DDVAL	;CHK for special disassembly required		BNE	@1_0	;BRA for ignoring REP/SEP stuffs		PLA		;Get back opcode		CMP	#$C2	;REP code ?		BEQ	@3	;BRA if yes		CMP	#$E2	;SEP code ?		BNE	@1_01	;BRA if not		JSR	READPCY1	;Read next byte and test for 8 bit m/x		ASL	A	;Shift m/x to 'c'/'n'		ASL	A	;		ASL	A	;		BPL	@4	;BRA if not setting 'x' to 8 bit mode		LDA	#$01	;Set flags for MPVAL/XPVAL probably		STA	>XPVAL	;@4		BCC	@1_22	;		LDA	#$01	;		STA	>MPVAL	;		BRA	@1_22	;@1_0		PLA		;Get back opcode@1_01		CMP	#$22	;JSL opcode		BEQ	@2	;If JSL opcode see if PRODOS16 MLI call		CMP	#$20	;Test for PRODOS8 MLI call		BNE	@1_22	;<>= then no PRODOS call		JSR	READPCY1	;Read next byte		ORA	>BANKS	;Source bank and byte=0 if MLI call		BNE	@1_22	;		JSR	READPCY1	;Read next byte		CMP	#>PRO8MLI	;Hi byte of PRODOS8 MLI call address		BNE	@1_22	;		LDA	1,S	;See if enough room to show MLI code		CMP	#3	;Must have 3 or more lines to do this		BCC	@1_5	;0,1,2 then not enough lines left		JSR	DISASEM	;Disassemble JSR $BF00 instruction		JSR	FIXPC	;Fix PCL/PCH		PLA		;Decrement counter		DEC	A	;		PHA		;Resave on stack		JSR	DO1MLIDATA	;Show line		LDY	#1	;@1_1		EQU	*		JSR	DOMLIDATA	;Show line		PLA		;Fix up counter		DEC	A	;-1 for DFB line		BRA	@1_4	;Done with MLI call so go for next line@3		EQU	*		JSR	READPCY1	;Read next byte and test for REP m/x		ASL	A	;Shift m/x to 'c'/'n'		ASL	A	;		ASL	A	;		BPL	@3_1	;BRA if not set 'x' to 16 bit mode		LDA	#$00	;Else set to 16 bit mode		STA	>XPVAL	;Set it for disassembly@3_1		EQU	*		BCC	@1_2	;BRA if not set 'm' to 16 bit mode		LDA	#$00	;		STA	>MPVAL	;Else set it for disassembly routine@1_22		BRA	@1_2	;Continue to disassembly@2		EQU	*		JSR	READPCY1	;Read next byte and test for PRO16MLI addr		CMP	#<PRO16MLI	;Test low byte for PRO16MLI first		BNE	@1_2	;<>= then not a PRODOS 16 MLI call		JSR	READPCY1	;Read next byte and test for PRO16MLI addr		CMP	#>PRO16MLI	;Test high byte for PRO16MLI call		BNE	@1_2	;<>= then not a PRODOS 16 MLI call		JSR	READPCY1	;Read next byte and test for PRO16MLI addr		CMP	#^PRO16MLI	;Test bank byte for PRO16MLI call		BNE	@1_2	;<>= then not a PRODOS 16 MLI call		LDA	1,S	;Test lines left on scrn to see if enough		CMP	#$03	;Need 3 lines@1_5		BCC	DOMLI2	;0,1,2 then quit out of here		JSR	DISASEM	;Disassemble PRODOS 16 MLI JSL		JSR	FIXPC	;Alter saved program counter		PLA		;Alter stack count		DEC	A	;		PHA		;Resave count for later		LDY	#$01	;Print DW for PRODOS 16 MLI call		JSR	DOMLIDATA	;		LDY	#$03	;Print DDW for PRODOS 16 MLI call		BRA	@1_1	;@1_2		EQU	*		JSR	DISASEM	;Disassemble unknown instruction		JSR	FIXPC		PLA@1_4		EQU	*		DEC	A	;Dec counter		BEQ	LIST3	;=0 then done		BMI	LIST3	;- then done		JMP	@1	;Continue onLIST3		EQU	*		JSR	CHKWAIT	;Pause if ctrl-s is pressed		JSR	CROUTFF	;		BRA	PR1BLNKFF	;Forces a new line with next JSR CROUTFFDOMLI2		EQU	*		PLA		;Quit if here		BRA	LIST3	; after cleaning up stack.DO1MLIDATA	EQU	*		LDY	#$00	;# of bytes to show -1DOMLIDATA		EQU	*		PHY		;Save 'Y' value		JSR	PRPCADDR	;Print program ctr bank number/addr		PLY		;Restore 'Y' value		STY	LENGTH	;Tell disassembler how much data to show		JSR	DISASEM2	;Disassemble line		LDX	#5	;Print 5 blanks		JSR	PRBL2FF	;Print 'X' number of spaces		LDY	LENGTH	;Recall # of bytes-1 for operand@1		EQU	*		JSR	READPCY	;Read byte		PHY		;Save 'Y'		JSR	PRBYTEFF	;Print byte		PLY		;Recall 'Y'		DEY		;Next byte please		BPL	@1	;Loop til all printedFIXPC		EQU	*		JSR	PCADJ	;A3=PC+LENGTH		STA	PCL		STY	PCH		STA	A3L	;		STY	A3H	;		RTS		;Back to callerPRPCADDR		EQU	*		JSR	PRBANKS	;Print bank number		LDX	PCL	;print PCL,H		LDY	PCH		JSR	XPRADDRFF	;PR1BLNKFF		EQU	*	;Print 1 blank routine		LDA	#$A0	;Space ASCII		JMP	COUTFF	;Print ASCII valueXINSDS1		EQU	*		JSR	PRPCADDR	;Print program ctr bank number/addr		JSR	READPCYINSDS3		EQU	*		LSR	A	;EVEN/ODD TEST 		STA	A2H	;Save for immediate opcode testing		TAY		PHP		;save odd even status		PHP		BCC	@1		AND	#$0F	;MASK BITS 		ORA	#$80@1		LSR	A	;LSB INTO CARRY FOR L/R TEST 		TAX		LDA	>FMT1,X	;GET FORMAT INDEX BYTE 		JSR	SCRN2	;R/L H-BYTE ON CARRY 		PLP		;get back odd even status		BCC	@2		ADC	#7	;extra 8 byte disp for odd@2		STA	FORMAT	;save index of the table		TAX		CPX	#8	;If 8 then a 1 or 2 byte # instruction		BNE	@5	;		LDA	A2H	;Recall LSR'ed opcode for testing		AND	#$04	;Test 1 bit only		BEQ	@4_2	;=0 then 'x' type # opcode		LDA	>MPVAL	;Test for 16 or 8 bits for 'A' access		BRA	@4_4	;Branch always@4_2		EQU	*		LDA	>XPVAL	;Test for 16 or 8 bits for 'X/Y' access@4_4		EQU	*		BNE	@5	;Z=1 then only 8 bits in operand		LDA	#2	; else C=0 then 16 bits in operand		BRA	@6	;Skip normal lookup@5		EQU	*		LDA	>FMT3,X	;index into opcode length table* (0=1 byte, 1=2 byte, 2=3 byte, 3=4 byte)		STA	A2H	;Save for miniassembler		AND	#$03@6		EQU	*		STA	LENGTH		TYA		;get back opcode / 2		PLP		;get back odd even status		BCC	@9		AND	#$07		CMP	#$05		BNE	@7		DEY		;nnnn1011 -> 0nnnn011		BRA	@92@7		TYA		;nnnxxxx1 -> 0nnn1001		CMP	#$44	;BIT imm?		BEQ	@8		AND	#$70		ORA	#$09		BRA	@10@8		LDA	#$12	;point to BIT		BRA	@10@9		AND	#03		CMP	#$03		BNE	@91		TYA		;nnnxx110 -> 0nnn0111		CMP	#$4F		BEQ	@92	;convert to STZ		AND	#$70		ORA	#$07		BRA	@10@92		DEY@91		TYA		;nnnnnnn0 -> 0nnnnnnn@10		EQU	*		RTSDISASEM2		EQU	*	;Disassemble 1 inst without operand		LDY	#0@2		JSR	READPCY		INC	A3L		BNE	@1		INC	A3H@1		JSR	PRBYTEFF		LDX	#$01	;PRINT 1 BLANK @3		JSR	PRBL2FF		CPY	LENGTH	;PRINT INST (1-3 BYTES) 		INY		;IN A 12 CHR FIELD 		BCC	@2		LDX	#$03	;CHAR COUNT FOR MNEMONIC INDEX 		CPY	#$04		BCC	@3		RTS		;Back to callerDISASEM		EQU	*		JSR	XINSDS1	;Get format, length bytes		PHA		;SAVE MNEMONIC TABLE INDEX 		JSR	DISASEM2	;Show up to+including opcode (not operand)		PLY		;RECOVER MNEMONIC INDEX 		PHX		;MUST preserve X		TYX		;Need Y index in X		LDA	>MNEML,X		STA	LMNEM	;FETCH 3-CHAR MNEMONIC  		LDA	>MNEMR,X	;  (PACKED INTO 2-BYTES) 		STA	RMNEM		JSR	PR1BLNKFF	;Output 1 space		PLX		;MUST restore X@1		LDA	#$00		LDY	#$05@2		ASL	RMNEM	;SHIFT 5 BITS OF CHARACTER INTO A 		ROL	LMNEM		ROL	A	;  (CLEARS CARRY) 		DEY		BNE	@2		ADC	#$BF	;ADD "?" OFFSET 		JSR	COUTFF	;OUTPUT A CHAR OF MNEM 		DEX		BNE	@1		JSR	PR1BLNKFF	;Output 1 space		LDA	FORMAT		TAX		LDA	>FMT3,X	;Bit6=1 = long addr mode		ASL	A	;- if long addr mode		PHP		;save that status		LDA	>FMT2,X	;get actual format		STA	FORMAT		LDX	#$08	;CNT FOR 8 FORMAT BITS 		LDY	LENGTH@111		CPX	#$05		BEQ	@115	;IF X=5 THEN ADDR. @112		ASL	FORMAT		BCC	@113		LDA	>CHAR1-1,X		PLP		PHP		BPL	@116	;not long addr		LDA	>CHAR3-1,X@116		EQU	*		JSR	COUTFF		LDA	>CHAR2-1,X		BEQ	@113		JSR	COUTFF@113		DEX		BNE	@111		PLP		RTS@114		DEY		BMI	@112		JSR	PRBYTEFF@115		LDA	FORMAT		CMP	#$F8	;Handle relative addr mode		JSR	READPCY	;Special (PRINT target, and offset)		STA	A2H	;Save hi byte of offset		BCC	@114	;		PLX		;get rid of [ flag		DEY		PHY		;MUST save as # bytes offset indicator		BEQ	@22	;one byte offset		PHA		;save high byte		JSR	READPCY	;get low byte		STA	A2L	;Save lo byte of offset		ADC	PCL	;note that carry was set		TAX		PLA		;get back high byte		ADC	PCH		TAY		TXA		CLC		ADC	#2		TAX		BCC	@221		BRA	@220@22		SEC		JSR	PCADJ3		TAX		;PCL,PCH+OFFSET+1 TO A,Y 		INX		BNE	@221	;+1 TO Y,X @220		INY@221		EQU	*		JSR	PRNTYXFF	;Print calculated address		JSR	PR1BLNKFF	;Output 1 space		LDA	#'{'	;Now show offset in braces		JSR	COUTFF	;		LDA	A2H	;Test for + or - move		BPL	@221_2	;+ then show '+'		LDA	#'-'	; else show - number		JSR	COUTFF	;		CLC		;Always clear C to add		PLA		;Test 1 or 2 byte offset		PHA		;Save again		BEQ	@221_0	;Skip low byte if here		LDA	A2L	;Make 2's complement		EOR	#$FF	;		ADC	#$01	;		STA	A2L	;		BRA	@221_1	;Skip setting carry@221_0		EQU	*		SEC		;Force 1 to be added@221_1		EQU	*		LDA	A2H	;Don't forget hi byte too		EOR	#$FF	;		ADC	#$00	;Adds carry		BRA	@221_4	;Exit with hi byte in 'A'@221_2		EQU	*		LDA	#'+'	;		JSR	COUTFF	;		LDA	A2H	;Pick up hi byte to show user@221_4		EQU	*		JSR	PRBYTEFF	;Show to user		PLA		;Recall Y from stack		BEQ	RELADR2	; and if 0 then only 1 byte offset		LDA	A2L	;Pick up lo byte of offset		JSR	PRBYTEFF	; and show to userRELADR2		EQU	*		LDA	#'}'	;Now close and exit		JMP	COUTFF	;PRAEQX		EQU	*	;Print A in ASCII = X in HEX		PHX		;Save X		JSR	PRHEXFF	;Output A in HEX		LDA	#'='	;		JSR	COUTFF	;Output =		PLA		;Recall X		PHA		;Save for testing		JSR	COUTFF	;Output X in ASCII		PLA		;Test for L		CMP	#'L'	;If L do NO spaces		BNE	@1	;		RTS		;Back to caller@1		EQU	*		JMP	PRBLNKFF	;Print 3 spaces now		EJECT** READ MEMORY LOCATION AT (PCL),Y***; FMT1 BYTES:    XXXX XXY0 INSTRS; IF Y=0         THEN RIGHT HALF BYTE; IF Y=1         THEN LEFT HALF BYTE;                  (X=INDEX)* For example PEI xx is opcode $D4 = *    1 1 0 1  0 1 0 0*    X X X X  X X Y 0* To find the PEI in FMT1 table go to FMT1,XXXXX*    = FMT1,$35 and since Y = 0 then the right*    nybble gives the format in FMT2.  The format*    number at FMT1,$35 right nybble is $B so the*    the format looks like nn*	; SEG $FFFMT1		EQU	*		DC.B	$BB,$BB,$CC,$99		DC.B	$52,$DB,$CC,$E9		DC.B	$A9,$BB,$CC,$99		DC.B	$52,$DD,$CC,$EE		DC.B	$BC,$B9,$CC,$99		DC.B	$52,$D9,$CC,$EA		DC.B	$3C,$BB,$CC,$94		DC.B	$52,$DD,$CC,$E6		DC.B	$32,$BB,$CC,$99		DC.B	$52,$1D,$CC,$E9		DC.B	$88,$BB,$CC,$99		DC.B	$52,$1D,$CC,$FE		DC.B	$08,$BB,$CC,$99		DC.B	$52,$DB,$CC,$E4		DC.B	$08,$BB,$CC,$99		DC.B	$52,$D9,$CC,$E6; ZZXXXY01 INSTR'S		DC.B	$B9,$E3,$40,$21		DC.B	$C8,$D5,$47,$A6* FMT2 formats are defined as follows** if format is taken from CHAR1* bit 7  bit 6  bit 5  bit 4  bit 3  bit 2  bit 1  bit 0*   #      (      $      ,      ,      ,      )      ,** if format is taken from CHAR2* bit 7  bit 6  bit 5  bit 4  bit 3  bit 2  bit 1  bit 0*   ^      ^      ^      Y      X      S      ^      Y* ^ = No register indicated for that format selection** if format is taken from CHAR3* bit 7  bit 6  bit 5  bit 4  bit 3  bit 2  bit 1  bit 0*   #      [      $      ,      ,      ,      ]      ,*FMT2		EQU	*		DC.B	$80	; 0 # always 1 byte 		DC.B	$10	; 1 d,Y		DC.B	$1F	; 2 r		DC.B	$1F	; 3 rl		DC.B	$42	; 4 (a)		DC.B	$42	; 5 (d)		DC.B	$4A	; 6 (a,X)		DC.B	$42	; 7 (a)		DC.B	$80	; 8 #d (or #a if in 16 bit mode)		DC.B	$00	; 9 a		DC.B	$00	; A al		DC.B	$00	; B d		DC.B	$00	; C i		DC.B	$08	; D d,X		DC.B	$08	; E a,X		DC.B	$10	; F a,Y		DC.B	$43	;10 (d),Y		DC.B	$4A	;11 (d,X)		DC.B	$08	;12 al,X		DC.B	$04	;13 r,S		DC.B	$47	;14 (r,S),Y		DC.B	$43	;15 [d],Y		DC.B	$42	;16 [d]FMT3		EQU	*		DC.B	$01	; 0 #d always 1 byte 		DC.B	$01	; 1 d,Y		DC.B	$01	; 2 r		DC.B	$02	; 3 rl		DC.B	$02	; 4 (a)		DC.B	$01	; 5 (d)		DC.B	$02	; 6 (a,X)		DC.B	$02	; 7 (a)		DC.B	$01	; 8 #d (or #a if 16 bit mode)		DC.B	$02	; 9 a		DC.B	$03	; A al		DC.B	$01	; B d		DC.B	$00	; C i		DC.B	$01	; D d,X		DC.B	$02	; E a,X		DC.B	$02	; F a,Y		DC.B	$01	;10 (d),Y		DC.B	$01	;11 (d,X)		DC.B	$03	;12 al,X		DC.B	$01	;13 r,S		DC.B	$01	;14 (r,S),Y		DC.B	$41	;15 [d],Y		DC.B	$41	;16 [d]CHAR1		DC.B	','		DC.B	')'		DC.B	','		DC.B	','		DC.B	','		DC.B	'$'		DC.B	'('		DC.B	'#'CHAR2		DC.B	'Y'		DC.B	$00	;		DC.B	'S'		DC.B	'X'		DC.B	'Y'		DC.B	$00		DC.B	$00		DC.B	$00CHAR3		DC.B	','		DC.B	']'		DC.B	','		DC.B	','		DC.B	','		DC.B	'$'		DC.B	'['		DC.B	'#'MNEML		EQU	*		DC.B	$1C,$24,$AD,$8A		DC.B	$8A,$15,$AD,$15		DC.B	$1C,$84,$AC,$A9		DC.B	$23,$53,$AC,$00		DC.B	$5D,$5D,$1A,$8B		DC.B	$8B,$9C,$1A,$9C		DC.B	$1B,$13,$1A,$AD		DC.B	$A1,$29,$1A,$00		DC.B	$9D,$C1,$75,$8A		DC.B	$8A,$6D,$5B,$6D		DC.B	$1D,$34,$75,$A9		DC.B	$23,$8A,$5B,$00		DC.B	$9D,$89,$A5,$9D		DC.B	$8B,$9C,$5B,$9C		DC.B	$1D,$11,$A5,$A9		DC.B	$A1,$8B,$5B,$00		DC.B	$1C,$1C,$A5,$8A		DC.B	$29,$AE,$A5,$A5		DC.B	$19,$A5,$A5,$AE		DC.B	$AE,$AE,$A5,$00		DC.B	$69,$69,$69,$8B		DC.B	$A8,$A8,$69,$69		DC.B	$19,$69,$69,$AE		DC.B	$23,$AD,$69,$00		DC.B	$24,$99,$24,$C0		DC.B	$53,$29,$24,$29		DC.B	$1B,$23,$89,$A5		DC.B	$23,$8A,$5B,$00		DC.B	$24,$A1,$24,$C8		DC.B	$53,$7C,$24,$53		DC.B	$19,$A0,$89,$C9		DC.B	$A1,$8B,$5D,$00MNEMR		EQU	*		DC.B	$D8,$22,$06,$4A		DC.B	$62,$1A,$06,$1A		DC.B	$5A,$C4,$C6,$28		DC.B	$48,$C8,$C6,$00		DC.B	$26,$1A,$AA,$4A		DC.B	$62,$1A,$AA,$1A		DC.B	$94,$CA,$AA,$08		DC.B	$88,$88,$AA,$00		DC.B	$54,$5C,$E2,$58		DC.B	$44,$26,$A2,$26		DC.B	$C8,$26,$DE,$0A		DC.B	$54,$74,$A2,$00		DC.B	$68,$A6,$76,$5A		DC.B	$44,$26,$A2,$26		DC.B	$E8,$48,$76,$48		DC.B	$94,$74,$A2,$00		DC.B	$C4,$DA,$74,$46		DC.B	$B4,$44,$74,$72		DC.B	$08,$44,$74,$74		DC.B	$84,$68,$76,$00		DC.B	$74,$72,$74,$46		DC.B	$B4,$B2,$74,$72		DC.B	$28,$44,$74,$B2		DC.B	$6E,$32,$74,$00		DC.B	$74,$A2,$74,$94		DC.B	$F4,$B2,$74,$88		DC.B	$CC,$A2,$94,$62		DC.B	$4A,$72,$9A,$00		DC.B	$72,$A2,$72,$C4		DC.B	$F2,$22,$72,$C8		DC.B	$A4,$C8,$84,$0C		DC.B	$8A,$72,$26,$00	; SEG $00		EJECT		TITLE	'65SC816 Opcodes/Modes/# of bytes'****************************************************                                                 **      65SC816 Opcodes/Modes/Number of Bytes      **                                                 *****************************************************   Name Mode      Bytes     Opcode #*   ---- --------- -------  ------------------------------*        #                   immediate*        (a)                 absolute indirect*        (a,X)               absolute indexed indirect*        (d)                 direct indirect*        (d),Y               direct indirect indexed*        (d,X)               direct indexed indirect*        (r,S),Y             stack relative indirect indexed*        a                   absolute*        a,X                 absolute indexed (with X)*        a,Y                 absolute indexed (with Y)*        Acc                 Accumulator*        al                  absolute long*        al,X                absolute indexed long*        d                   direct*        d,X                 direct indexed (with X)*        d,Y                 direct indexed (with Y)*        i                   implied*        r                   program counter relative*        r,S                 stack relative*        rl                  program counter relative long*        s                   stack*        XYA                 block move*        [d]                 direct indirect long*        [d],Y               direct indirect indexed long*   ---- --------- --------- -----------------------------*   BRK  i           2       00*   ORA  (d,X)       2       01*   COP  i           2       02*   ORA  r,S         2       03*   TSB  d           2       04*   ORA  d           2       05*   ASL  d           2       06*   ORA  [d]         2       07*   PHP  s           1       08*   ORA  #           2 (3)   09*   ASL  Acc         1       0A*   PHD  s           1       0B*   TSB  a           3       0C*   ORA  a           3       0D*   ASL  a           3       0E*   ORA  al          4       0F*   BPL  r           2       10*   ORA  (d),Y       2       11*   ORA  (d)         2       12*   ORA  (r,S),Y     2       13*   TRB  d           2       14*   ORA  d,X         2       15*   ASL  d,X         2       16*   ORA  [d],Y       2       17*   CLC  i           1       18*   ORA  a,Y         3       19*   INC  Acc         1       1A*   TCS  i           1       1B*   TRB  a           3       1C*   ORA  a,X         3       1D*   ASL  a,X         3       1E*   ORA  al,X        4       1F*   JSR  a           3       20*   AND  (d,X)       2       21*   JSL  al          4       22*   AND  r,S         2       23*   BIT  d           2       24*   AND  d           2       25*   ROL  d           2       26*   AND  [d]         2       27*   PLP  s           1       28*   AND  #           2 (3)   29*   ROL  Acc         1       2A*   PLD  s           1       2B*   BIT  a           3       2C*   AND  a           3       2D*   ROL  a           3       2E*   AND  al          4       2F*   BMI  r           2       30*   AND  (d),Y       2       31*   AND  (d)         2       32*   AND  (r,S),Y     2       33*   BIT  d,X         2       34*   AND  d,X         2       35*   ROL  d,X         2       36*   AND  [d],Y       2       37*   SEC  i           1       38*   AND  a,Y         3       39*   DEC  Acc         1       3A*   TSC  i           1       3B*   BIT  a,X         3       3C*   AND  a,X         3       3D*   ROL  a,X         3       3E*   AND  al,X        4       3F*   RTI  s           1       40*   EOR  (d,X)       2       41*   WDM  i           2       42*   EOR  r,S         2       43*   MVP  XYA         3       44*   EOR  d           2       45*   LSR  d           2       46*   EOR  [d]         2       47*   PHA  s           1       48*   EOR  #           2 (3)   49*   LSR  Acc         1       4A*   PHK  s           1       4B*   JMP  a           3       4C*   EOR  a           3       4D*   LSR  a           3       4E*   EOR  al          4       4F*   BVC  r           2       50*   EOR  (d),Y       2       51*   EOR  (d)         2       52*   EOR  (r,S),Y     2       53*   MVN  XYA         3       54*   EOR  d,X         2       55*   LSR  d,X         2       56*   EOR  [d],Y       2       57*   CLI  i           1       58*   EOR  a,Y         3       59*   PHY  s           1       5A*   TCD  i           1       5B*   JMP  al          4       5C*   EOR  a,X         3       5D*   LSR  a,X         3       5E*   EOR  al,X        4       5F*   RTS  s           1       60*   ADC  (d,X)       2       61*   PER  s           3       62*   ADC  r,S         2       63*   STZ  d           2       64*   ADC  d           2       65*   ROR  d           2       66*   ADC  [d]         2       67*   PLA  s           1       68*   ADC  #           2 (3)   69*   ROR  Acc         1       6A*   RTL  s           1       6B*   JMP  (a)         3       6C*   ADC  a           3       6D*   ROR  a           3       6E*   ADC  al          4       6F*   BVS  r           2       70*   ADC  (d),Y       2       71*   ADC  (d)         2       72*   ADC  (r,S),Y     2       73*   STZ  d,X         2       74*   ADC  d,X         2       75*   ROR  d,X         2       76*   ADC  [d],Y       2       77*   SEI  i           1       78*   ADC  a,Y         3       79*   PLY  s           1       7A*   TDC  i           1       7B*   JMP  (a,X)       3       7C*   ADC  a,X         3       7D*   ROR  a,X         3       7E*   ADC  al,X        4       7F*   BRA  r           2       80*   STA  (d,X)       2       81*   BRL  rl          3       82*   STA  r,S         2       83*   STY  d           2       84*   STA  d           2       85*   STX  d           2       86*   STA  [d]         2       87*   DEY  i           1       88*   BIT  #           2 (3)   89*   TXA  i           1       8A*   PHB  s           1       8B*   STY  a           3       8C*   STA  a           3       8D*   STX  a           3       8E*   STA  al          4       8F*   BCC  r           2       90*   STA  (d),Y       2       91*   STA  (d)         2       92*   STA  (r,S),Y     2       93*   STY  d,X         2       94*   STA  d,X         2       95*   STX  d,Y         2       96*   STA  [d],Y       2       97*   TYA  i           1       98*   STA  a,Y         3       99*   TXS  i           1       9A*   TXY  i           1       9B*   STZ  a           3       9C*   STA  a,X         3       9D*   STZ  a,X         3       9E*   STA  al,X        4       9F*   LDY  #           2 (3)   A0*   LDA  (d,X)       2       A1*   LDX  #           2 (3)   A2*   LDA  r,S         2       A3*   LDY  d           2       A4*   LDA  d           2       A5*   LDX  d           2       A6*   LDA  [d]         2       A7*   TAY  i           1       A8*   LDA  #           2 (3)   A9*   TAX  i           1       AA*   PLB  s           1       AB*   LDY  a           3       AC*   LDA  a           3       AD*   LDX  a           3       AE*   LDA  al          4       AF*   BCS  r           2       B0*   LDA  (d),Y       2       B1*   LDA  (d)         2       B2*   LDA  (r,S),Y     2       B3*   LDY  d,X         2       B4*   LDA  d,X         2       B5*   LDX  d,Y         2       B6*   LDA  [d],Y       2       B7*   CLV  i           1       B8*   LDA  a,Y         3       B9*   TSX  i           1       BA*   TYX  i           1       BB*   LDY  a,X         3       BC*   LDA  a,X         3       BD*   LDX  a,Y         3       BE*   LDA  al,X        4       BF*   CPY  #           2 (3)   C0*   CMP  (d,X)       2       C1*   REP  #           2       C2*   CMP  r,S         2       C3*   CPY  d           2       C4*   CMP  d           2       C5*   DEC  d           2       C6*   CMP  [d]         2       C7*   INY  i           1       C8*   CMP  #           2 (3)   C9*   DEX  i           1       CA*   WAI  i           1       CB*   CPY  a           3       CC*   CMP  a           3       CD*   DEC  a           3       CE*   CMP  al          4       CF*   BNE  r           2       D0*   CMP  (d),Y       2       D1*   CMP  (d)         2       D2*   CMP  (r,S),Y     2       D3*   PEI  s           2       D4*   CMP  d,X         2       D5*   DEC  d,X         2       D6*   CMP  [d],Y       2       D7*   CLD  i           1       D8*   CMP  a,Y         3       D9*   PHX  s           1       DA*   STP  i           1       DB*   JML  (a)         3       DC*   CMP  a,X         3       DD*   DEC  a,X         3       DE*   CMP  al,X        4       DF*   CPX  #           2 (3)   E0*   SBC  (d,X)       2       E1*   SEP  #           2       E2*   SBC  r,S         2       E3*   CPX  d           2       E4*   SBC  d           2       E5*   INC  d           2       E6*   SBC  [d]         2       E7*   INX  i           1       E8*   SBC  #           2 (3)   E9*   NOP  i           1       EA*   XBA  i           1       EB*   CPX  a           3       EC*   SBC  a           3       ED*   INC  a           3       EE*   SBC  al          4       EF*   BEQ  r           2       F0*   SBC  (d),Y       2       F1*   SBC  (d)         2       F2*   SBC  (r,S),Y     2       F3*   PEA  s           3       F4*   SBC  d,X         2       F5*   INC  d,X         2       F6*   SBC  [d],Y       2       F7*   SED  i           1       F8*   SBC  a,Y         3       F9*   PLX  s           1       FA*   XCE  i           1       FB*   JSR  (a,X)       3       FC*   SBC  a,X         3       FD*   INC  a,X         3       FE*   SBC  al,X        4       FF		TITLE	'65SC816 MiniAssembler'*******************************************************                                                    **            MiniAssembler for the 65SC816           **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Developed from the 65C02 MiniAssembler       **                         by                         **                       Ed Lai                       **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ******************************************************** Calculate offset byte for relative addressesREL		EQU	*	;calc relative address		LDA	>DIGITCNT	;Length must be 2 or less or error		CMP	#3	;		BCS	GOERR	;Error exit		LDA	A1H	;Test for BRL/PER or regular 1 byte branch		CMP	#$82	;Is it a BRL?		BEQ	BRANCHLONG	;		CMP	#$62	;Is it a PER?		BEQ	BRANCHLONG	;A 'PER' is processed as a BRL instruction		LDY	A3H	;		LDX	A3L	;		BNE	@1		DEY		;point to offset@1		DEX		;displacement - 1		TXA		CLC		SBC	PCL	;subtract current PCL		STA	A3L	;and save as displacement		BPL	@2	;check page		INY@2		TYA		;get page		SBC	PCH	;check page		BEQ	MOVINSTGOERR		JMP	MINIERR	;display errorBRANCHLONG	EQU	*		REP	#$30	;Go to 16 bit land to do some things		LDA	A3L	;To address		DEC	A	;Offset by 2		DEC	A	;		CLC		;Causes correct subtraction		SBC	PCL	;From address		STA	A3L	;Save offset		SEP	#$30	;Back to 8 bit landMOVINST		EQU	*	;Move byte(s) to memory		JSR	MOVINST1	;* Display instruction		JSR	PRBLNKFF	;print blanks to make ProDOS work		JSR	UPFF	;move up 2 lines		JSR	UPFF		JSR	DISASEM	;disassemble the instruction		JSR	FIXPC	;Calculate new PC and update PCL/PCH		BRA	GETINST	;and go get next instruction* Compare disassembly of all known opcodes with* the one typed in until a match is foundGETOP		LDA	A1H	;get opcode		JSR	INSDS3	;determine mnemonic index		PHX		;Save Offset into length table		PHA		;		LDX	FORMAT	;Convert offset into format		LDA	>FMT2,X	; to a format the miniassembler 		STA	FORMAT	;  understands.		PLA		;		TAX		;X = index		LDA	>MNEMR,X	;get right half of index		CMP	A4L	;does it match entry?		BNE	NXTOP	;=>try next opcode		LDA	>MNEML,X	;get left half of index		CMP	A4H	;does it match entry?		BNE	NXTOP	;=>no, try next opcode		LDY	FORMAT	;get addr. mode format for that opcode		CPY	#$1F	;Is it a relative address?		BNE	TESTLEN	;<> a branch type inst then test others		PLX		;Clean up stack		JMP	REL	;DOINST2		EQU	*		JMP	DOLIN	;Go attempt disassemblyDOINST4		EQU	*		JMP	GETI1	;TESTLEN		EQU	*		PLX		;Did user enter 8/16 bit # instruction?		LDA	LMNEM	;found opcode, check address mode		CMP	FORMAT	;does mode match?		BNE	NXTOP2	;		LDA	>DIGITCNT	;Make sure length is same too		CMP	A2H	;@1		EQU	*		BEQ	MOVINST	;=>yes, move instruction to memory		CPX	#8	;		BNE	NXTOP2	;		CMP	#1	;1 or 2 bytes is OK		BEQ	@1	;		CMP	#2	;		BEQ	@1	;		BNE	NXTOP2	;Try next opcodeNXTOP		EQU	*		PLX		;Clean up stackNXTOP2		EQU	*		DEC	A1H	;else try next opcode		BNE	GETOP	;=>go try it		DEC	YSAV1		BEQ	GETOP	;=>go try next format* Point to the error with a caret, beep, and fall * into the mini-assembler.MINIERR		LDY	YSAV	;get positionMINIERR2		TYA		TAX		JSR	PRBL2FF	;tab to the error		LDA	#$DE	;to print a caret "^"		JSR	COUTFF	;print it		JSR	NEWBELL1	;Ring the dingyGETINST		JSR	GETLNZFF	;and go get next instruction* Read a line of input.  If prefaced with " ", decode* mnemonic. If "$" do monitor command.  Otherwise parse* hex address before decoding mnemonic.DOINST		EQU	*		LDA	#$00	;clear mode		STA	MONMODE	;		TAY		;0 out Y		LDA	IN	;get first char in line		CMP	#$A0	;if blank, 		BEQ	DOINST2	;Go attempt disassembly		CMP	#':'	;Test for data entry mode		BEQ	HEXENTRY	;		CMP	#'"'	;Test for literal ASCII input		BEQ	ASCLITERAL	;ASCII string literal entry if ' entered		CMP	#$8D	;is it return?		BNE	DOINST4	;=>no, continue		REP	#$30	;Off to 16 bit land to save a byte		PLA		;Recall MPVAL/XPVAL		STA	>MPVAL	;Restore said values		SEP	#$30	;Back to normal bank FF monitor mode		JMP	MONZ2RTN	;MINIFF		EQU	*		REP	#$30	;Off to 16 bit land to save a byte		LDA	>MPVAL	;Restore said values		PHA		;Save MPVAL/XPVAL		SEP	#$30	;Back to normal bank FF monitor mode		LDA	#$A1	;get mini-prompt "!"		STA	PROMPT		LDA	IN+1	;Test for CR -- If none assume address		CMP	#$8D	;		BEQ	GETINST	;		LDY	#$00	;Move $20 bytes back to start of line@1		EQU	*		LDA	IN+1,Y	;From		STA	IN,Y	;To		INY		;Next		CPY	#$20	;Test for done		BNE	@1	;		BRA	DOINST	;Do instructionHEXENTRY		EQU	*	;User entering data directly		INY		;Start with 2nd character in input buffer		STY	YSAV	;Save 'Y' index@1		EQU	*	;		LDY	YSAV	;Recall index in line		JSR	GETNUMFF	;Get some data		STY	YSAV	;Save entry into line		JSR	HEXENTRY3	;Move hex data to memory		BNE	@1	;Loop for more entryTOGETINST		EQU	*		BRA	GETINST	;= then last entryLITERALASC	EQU	*		LDA	#$BA	;Stay in store mode		STA	MONMODE	;		LDY	YSAV	;Input buffer location		LDA	A3L	;Move address to PCL/PCH		STA	PCL	;		LDA	A3H	;		STA	PCH	;		DEY		;Offset since YSAV is one to many		JSR	ASCLITERAL1	;Store data		CMP	#$8D	;Carriage return then to MONZRTN else		BEQ	@1	; point to nxt item in buffer+continue.		INY		;'Y' always points to next item in buffer		STY	YSAV	; and is saved in YSAV.		RTS		;Exit back to regular monitor routines@1		EQU	*		JMP	MONZ2RTN	;End rest of line and reenter monitorASCLITERAL	EQU	*	;User entering ASCII string data directly		JSR	ASCLITERAL1	;		BRA	TOGETINST	;Back to miniassembler stuffASCLITERAL1	EQU	*		INY		;Test next char for $8D to terminate entry		LDA	IN,Y	;Get next character		CMP	#$8D	;Carriage return then no more entry		BEQ	@1	;Go for next line		CMP	#'"'	;'"' is line terminator		BEQ	@1	;Exit if terminator found		PHY		;Save input buffer index		AND	>ASCFILTER	;Filter the ASCII entered		PHA		;Save 'A' value		LDY	#$00	;Required for PCYTOA3		JSR	PCYTOA3	;Find location		PLA		;Recall value to print		JSR	STORBYTE	;Store byte in memory		STZ	LENGTH	;Fake out PCADJ		LDA	PCH	;CHK if PCH already at $ff		EOR	#$FF		BNE	@2	;Bra if not		LDA	PCL	;Else need to chk for crossing bank		PHA		;Save as old PCL before PCADJ		JSR	FIXPC	;Update for new PC		PLA		;Get back old PCL		CMP	PCL	;Compare with new PCL		BCC	@3	;Bra if not yet crossing bank		JSR	INCBANKS	;Else need to adjust BANKS		BRA	@3	;Continue but in new bank@2		EQU	*		JSR	FIXPC	;Calls PCADJ@3		EQU	*		PLY		;Recall 'Y' index		BRA	ASCLITERAL1	;Loop til carriage return found@1		EQU	*		RTS		;Back to callerGETI1		JSR	XGETNUMFF	;parse hexadecimal input		CMP	#$93	;look for "ADDR:" GOMINIERR2	BNE	NXTCHR0	;no ":", display error 		JSR	A1PC	;Move address to PCL/PCH		BEQ	NXTCHR0	;no "ADDR", display error		LDA	IN,Y	;Test for literal input modes		CMP	#'"'	;If '"' here then literal ASCII entry		BEQ	ASCLITERAL	;		CMP	#':'	;If : here then literal HEX entry		BNE	DOLIN		JMP	HEXENTRY	;Jump for hex entryDOLIN		EQU	*		LDA	#$03	;get starting opcode		STA	A1H	;and saveNXTCH		JSR	NNBL	;get next non-blank		ASL	A	;validate entry		SBC	#$BE		CMP	#$C2		BCS	NXTCH2	;Continue normally if 'c'=1NXTCHR0		JMP	MINIERR2	;=>flag bad mnemonic* Form mnemonic for later comparisonNXTCH2		EQU	*		ASL	A		ASL	A		LDX	#$04@111		ASL	A		ROL	A4L		ROL	A4H		DEX		BPL	@111		DEC	A1H	;decrement mnemonic count		BEQ	@111		BPL	NXTCH		LDX	#$7	;index into address mode tables		STZ	A2L	;0= not long address@1		EQU	*		JSR	NNBL	;Get next non-blank character		STY	YSAV	;Save position in input buffer		CMP	>CHAR1,X	;		BEQ	@1_2	;		CMP	>CHAR3,X	;Test for long addressing mode		BNE	@2	;		LDA	#$40	;		STA	A2L	;Set bit 6 if long address@1_2		EQU	*		CMP	#'$'	;Ignore '$' if user entered it		BNE	@1_4	;		INY		;		BRA	@2	;@1_4		EQU	*		JSR	NNBL	;Get next non-blank character		CMP	>CHAR2,X	;		BEQ	@3	;		LDA	>CHAR2,X	;=0 then done with checking		BEQ	@4	;		LDY	YSAV	;Recall Y@2		EQU	*		CLC		;@4		EQU	*		DEY		;@3		EQU	*		ROL	LMNEM	;Shift bit into format		CPX	#5	;Assume user's addr next if here		BNE	@6	;<>= then skip GETNUMFF		LDA	A2L	;Save temp in A2L		PHA		;		JSR	GETNUMFF	;		PHB		;Save data bank register		JSR	DBTOE1	;Switch in bank E1		LSR	|DIGITCNT	;# of nybbles/2 = # of bytes		PLB		;Restore data bank register		BCC	@3_5	;Carry clear then even # of digits entered		JSR	INCDIGITCNT	;Compensate if odd # of digits entered@3_5		EQU	*		PLA		;Restore temp in A2L		STA	A2L	;		LDA	>DIGITCNT	;		AND	#1	;		BEQ	@3_6		LDA	#$01	;Set up 8 bit disassembler display mode		BRA	@3_8	;@3_6		EQU	*		LDA	#$00	;Set up 16 bit disassembler display mode@3_8		EQU	*		STA	>MPVAL	;		STA	>XPVAL	;		LDA	A2H	;Test Hi byte of number gotten		BEQ	@5	;		INX		;@5		EQU	*		STX	YSAV1	;Remember X for awhile		LDX	#5	;Restore X to 5		DEY		;@6		EQU	*		STX	A1H	;Preserve 'X' index		DEX		;Test next format		BPL	@1	;Continue til all done		LDA	A2L	;Set bit 6 in length if long addressing		ORA	>DIGITCNT	;Mask into counter		STA	>DIGITCNT	; and save in counter.		STY	YSAV	;update position		LDA	IN,Y	;get next character		CMP	#$BB	;is it a ";"?		BEQ	@8	;=>yes, skip comment		CMP	#$8D	;is it carriage return		BEQ	@8	;Done if carriage return		JMP	GOMINIERR2@8		JMP	GETOP	;get next opcodeLOOKASCFF		EQU	*		BVS	LOOKASCFF4	;V=1 if continuing ASCII input		BCS	DIGFF	;it was a digit		CMP	#$A0	;check for quote (')		BNE	RTS6FF	;nope, return char		SEP	#$40	;Set V as indicator been here beforeLOOKASCFF4	EQU	*		LDA	IN,Y	;Get a character		CMP	#''''	; quote terminates miniassembler ASCII input'		BEQ	@3	; BEQ LOOKASCFF5 ;		CMP	#$8D	;was it CR?		BNE	@2	;<> = then continue		CLV		;MUST clear 'v' on exit		BEQ	NXTCHRFF	;BEQ @3 ;BEQ GETNUMFF ;Go handle CR@2		EQU	*		LDX	#7	;for shifting asc into A2L and A2H		JSR	INCDIGITCNT	;Causes DIGITCNT to be INC'ed 2 times		AND	>ASCFILTER	;Filter the ASCII entered		INY		;advance index		BNE	NXTBITFF	;=>(always) into A2L and A2H		RTS		;@3		EQU	*		LDA	#$99	;Make monitor think we found a space		INY		;RTS6FF		EQU	*		RTS		;Back to caller with char in 'A'DIGFF		LDX	#$03	;Shift through 24 bits		ASL	A	; 		ASL	A	;GOT HEX DIGIT, 		ASL	A	; SHIFT INTO A2 		ASL	A	; NXTBITFF		EQU	*		PHB		;MUST save and restore data bank register		JSR	DBTOE1	;Change data bank register to ROL@1		EQU	*		ASL	A	; 		REP	#$30	; in bank 00 and E1 at same time.		ROL	A2L	;Do it in 16 bit mode		ROL	|EXTENDBNK	;		SEP	#$30	;Back to 8 bit land		DEX		;LEAVE X=$FF IF DIGFF 		BPL	@1	;  		PLB		;Back to original data bank		LDA	MONMODE		BNE	@12	;IF MONMODE IS ZERO, 		LDX	#$01	;Move 2 bytes@11		EQU	*		LDA	A2L,X	; THEN COPY A2 TO A1 AND A3 		STA	A1L,X		STA	A3L,X		LDA	>EXTENDBNK,X	;Copy for later		STA	>EXTENDBNKS,X	;Save in case doing '+' or '-'		DEX		;		BEQ	@11	;Loop if =0@12		EQU	*		INX		BEQ	@12	;Loop til 'X' <>= 0		JSR	INCDIGITCNT	;Increment digit count variable		BVS	LOOKASCFF4	;V=1 then continue ASCII input		BRA	NXTCHRFFGETNUMFF		EQU	*		CLV		;Indicate no ASCII being entered		REP	#$30	;Switch to 16 bit to save bytes		LONGA	ON		LDA	#$0000	;Clear variables to start		LONGA	OFF		STA	A2L	;		STA	>EXTENDBNK	;Zero out extend byte/bank byte		SEP	#$30	;Bank to 8 bit land		STA	>DIGITCNT	;Zero # of digits entered count		TAX		;MUST make X=0 to startNXTCHRFF		EQU	*		JSR	UPMON	;Read/upshift character if necessary		EOR	#$B0		CMP	#$0A		BCC	DIGFF	;BR IF HEX DIGIT 		PHP		;Preserve V status		ADC	#$88		PLP		;Restore V status		CMP	#$FA		JMP	LOOKASCFF	;check for ASCII input* The following routines are used to set up the source bank * and the higher bank (extend) for the command with '.' or ':'.* It searches through for command with syntax '/', if found * for the first time, then treats as source bank and also set* the extend bank equals to the source bank.  Then it countines * searching for another '/', if found then set it for extended* bank byte.  These banks byte setting are mainly used in the* related cross bank stuff.* Example: aa<bb1/xxxx.yyyyz, same bank filling*          aa<bb1/xxxx.bb2/yyyyz, cross bank filling* In any time, if higher address is less than the specified * source bank then handle only the first byte and quit.XGETNUM		EQU	*	;MONZ enters here		LDY	YSAV	;Get where MONZ is in input bufferXGETNUMFF		EQU	*		JSR	GETNUMFF		CMP	#$A8	;If '/' ($A8='/' EOR #$B0+$89)(set bank)?		BNE	RTS6FF	;		LDA	MONMODE	;Leave bank number alone if in a mode		BNE	@1		LDA	A2L		STA	>BANKS	;Make new source bank		STA	>HIGHBANK	;Set higher bank = source bk if no high bank specified		BRA	XGETNUMFF	;Do NOT exit yet@1		EQU	*		CMP	#$AE	;Check for mode '.'		BEQ	@2	;Bra if yes               		CMP	#$BA	;Is it ':' ?		BNE	XGETNUMFF	;Bra if not@2		EQU	*		LDA	A2L	;Store as cross bank usage		STA	>HIGHBANK	;		BRA	XGETNUMFFMOVINST1		EQU	*	;get instruction length		LDA	A3L	;Move address from A3L/H to A2L/H		STA	A2L	; since PCYTOA3 uses A3L/H.		LDA	A3H	;		STA	A2H	;@2		EQU	*		LDY	LENGTH	;How many bytes left to move-1?		CPY	#$03	;Y=3 if bank # entered		BEQ	@4	;		LDA	|A1H,Y	;Get address byte		BRA	@6	;Go deposit it into memory@4		EQU	*		LDA	>EXTENDBNK	;Bank number@6		EQU	*		PHA		JSR	PCYTOA3	;Find location		PLA		JSR	STORBYTE	; store byte.		DEC	LENGTH		BPL	@2	;		RTS		;Back to callerINCDIGITCNT	EQU	*		PHB		;Save data bank register		JSR	DBTOE1	;Change data bank register		INC	|DIGITCNT	;Inc digit counter		PLB		;Restore data bank register		RTS		;Back to callerXSTOR		EQU	*	;Monitor immediate mode store routine		LDX	#$BA	;Stay in store mode		STX	MONMODE	;		LDX	A3L	;Move address to PCL/PCH		STX	PCL	;		LDX	A3H	;		STX	PCH	;HEXENTRY3		EQU	*		XBA		;Save 'A'		LDA	>DIGITCNT	;# of nybbles/2 = # of bytes		LSR	A	;		BCC	@1	;Carry clear then even # of digits entered		INC	A	;Compensate if odd # of digits entered@1		EQU	*		CMP	#$05	;<5 allowed only		BCC	@2	;		LDA	#$04	;Limit to last 4 characters entered@2		EQU	*		DEC	A	;LENGTH=number of bytes-1 for MOVINST1		TAX		;Save length		STA	LENGTH	;Save length for MOVEINST1.		XBA		;Recall 'A'		CMP	#$C6	;Test for return ($8D EOR #$B0 + $89)		PHP		;Save 'z' status		PHX		;Save length+1 on stack		LDA	A2L	;Shift bytes down for MOVINST1		STA	A1H	;Byte 0 location for MOVINST1		LDA	A2H	;Byte 1 location for MOVINST1		STA	A3L	;		LDA	>EXTENDBNK	;Byte 2 location for MOVINST1		STA	A3H	;		LDA	>EXTENDBNK+1	;Byte 3 (extend byte) loc for MOVINST1		STA	>EXTENDBNK	;		REP	#$20		LONGA	ON		LDA	A3L	;Move A3 to A2 (16 bit)		STA	A2L		LDA	LENGTH		AND	#$00FF	;Mask off unwanted high byte 		CLC		ADC	PCL	;16 bit add		BCS	@8	;Bra if bank crossing   		SEP	#$20		LONGA	OFF		JSR	MOVINST1	;Store data@15		EQU	*		PLA		;Get length for FIXPC		STA	LENGTH	;		LDA	PCH	;Get high part of pc		EOR	#$FF	;Already at $ff		BNE	@3	;BRA if not 		LDA	PCL	;Save old PCL               		PHA		JSR	FIXPC	;A3=PC+LENGTH		PLA		;Get back old PCL		CMP	PCL	;Compare with new PCL		BCC	@4	;Bra if old PCL < new PCL, fine		JSR	INCBANKS		BRA	@4@3		EQU	*		JSR	FIXPC	;Update PC@4		EQU	*		PLP		;Test if last entry or not		RTS		;Back to caller@8		EQU	*	;Cross bank processing		SEP	#$20	;Back to 16 bit land		LONGA	OFF@9		EQU	*		LDA	>BANKS	;Need to preserve BANKS          		PHA@99		EQU	*		PLA		;Each loop use its original BANKS		PHA		STA	>BANKS	;Get back 		LDY	LENGTH	;How many bytes left to move-1?		CPY	#$03	;If Y=3 then 4 bytes entered		BEQ	@10	;Bra to get the highest byte		LDA	|A1H,Y	;Else use index to locate byte		BRA	@11	;Go on@10		EQU	*		LDA	>EXTENDBNK	;Get the highest byte      @11		EQU	*		PHA		;Temp save 		JSR	PCYTOA3	;Find location to save to		LDA	A3L	;Chk for crossing bank		AND	#$F0	;If cross bank, then high nibbles of A3L is zero		BNE	@12	;BRA if not yet cross bank		JSR	INCBANKS@12		EQU	*		PLA		;Get back the user's keyin byte		JSR	STORBYTE	;Store it		DEC	LENGTH	;		BPL	@99	;Continue in loop		PLA		;Else get back the preserved BANKS		STA	>BANKS	;Store back		BRA	@15	;Exit to adjust for new PC, FIXPCINCBANKS		EQU	*		LDA	>BANKS		INC	A		STA	>BANKS		RTS