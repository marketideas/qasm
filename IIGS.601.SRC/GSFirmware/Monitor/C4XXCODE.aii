		TITLE	'Phoenix Mouse $Cn00 Space.';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 9:29:34 PM*********************************************************                                                      **                    Phoenix  Mouse                    **                                                      **                      $C400 Space                     **                                                      **                          by                          **                     Fern Bachman                     **                     Joe  Bo                          **                                                      **      Copyright  1984-1989 by Apple Computer, Inc.    **                 All Rights Reserved                  **                                                      ********************************************************** The slot 4 and related bank $ff mouse firmware have been * changed so that it calls mouse tools (in miscellaneous tools)* to set or get the necessary information.* To use slot 4 as an entry (most P8 applications), select slot 4* to be Mouse Port in the control panel.* For new gs applications, it is not necessary to set slot 4 as* Mouse Port and therefore can free up a slot for 'Your Card'.* For slot 4 mouse firmware and mouse tools to work properly, * separate mouse parameters location have been defined in slot 4* screen holes and bank $e1.  When slot 4 mouse firmware gets called* then the related screen holes parameters would show up also in * the bank $e1 mouse locations but not vice versa.  Slot 4 and * bank $ff mouse firmware relies on mouse tools.* * Mouse parameters:*  Descriptions                 slot 4       bank $e1*------------------------------------------------------------* Low byte of abs X             $047c        $e10190* Low byte of abs Y             $04fc        $e10191* High byte of abs X            $057c        $e10192* High byte of abs Y            $05fc        $e10193* Info, bits 6, 7 for Y clamps  $067c        $e10194* Spare, reserved as a temp     $06fc        $e10195* Button                        $077c        $e10196* Mousmode                      $07fc        $e10197*   * BASICSTART EQU *		BRA	OENTBAS	;Branch always		DC.B	$C6,$C1,$C2	;IENTBAS		EQU	*	;Basic input entry point		SEC		;Must=$38 for IN# in Basic		OPCODE	BCC	;Causes skip over CLC instructionOENTBAS		EQU	*	;Basic output entry point		CLC		;Must=$18 for PR# in Basic		BRA	@1	;Go to basic entry point 		NOP		;Required filler		DC.B	$01	;PASCAL generic sig byte		DC.B	$20	;Dev sig//Apple tech supp id		DC.B	PERROR	;Offset to PASCAL PINIT		DC.B	PERROR	;Offset to PASCAL PREAD		DC.B	PERROR	;Offset to PASCAL PWRITE		DC.B	PERROR	;Offset to PASCAL PSTATUS		DC.B	00	;Must be 00		DC.B	TSETMOUSE	;Offset to SETMOUSE		DC.B	SERVEMOUSE	;Offset to SERVEMOUSE		DC.B	TREADMOUSE	;Offset to TREADMOUSE		DC.B	CLEARMOUSE	;Offset to CLEARMOUSE 		DC.B	POSMOUSE	;Offset to POSMOUSE		DC.B	TCLAMPMOUSE	;Offset to TCLAMPMOUSE 		DC.B	THOMEMOUSE	;Offset to THOMEMOUSE		DC.B	TINITMOUSE	;Offset to TINITMOUSE		DC.B	CLRCRTS	;Dummy offset to DIAGMOUSE		DC.B	CLRCRTS	;Dummy offset to COPYRIGHT		DC.B	CLRCRTS	;Dummy offset to TIMEDATA		DC.B	CLRCRTS	;Dummy offset to SETVBLCNTS		DC.B	CLRCRTS	;Dummy offset to OPTMOUSE		DC.B	CLRCRTS	;Dummy offset to STARTTIMER@1		EQU	*		PHY		;Save Y on stack		TXY		;Save 'X' value in 'Y' register		LDX	#$06	;Indicate which mouse routine to do		JSR	GODOMOUSE	;Go do the mouse routine requested		PLY		;Restore former Y		RTS		;Back to BASICSERVEMOUSE	EQU	*	;User entry point - SERVEMOUSE 		LDA	#$0E	;Reset bits 1,2,3		TRB	BUTTON	;Causes reset of bits 1,2,3		LDA	>IRQ_INTFLAG	;Test VBL enabled/active status flag		TAY		;Save temporarily		AND	#$08	;Bit 3 = status		BEQ	@1	;Not VBL int then don't reset it		STA	CLRVBLINT	;Disable VBL interrupt		TYA		;Reset VBL interrupt status bit		AND	#$F7	;Clears bit		STA	>IRQ_INTFLAG	;Save status		LDA	#$08	;Bit to set in BUTTON@1		EQU	*		TAY		;Save status		TSB	BUTTON	;Set VBL bit if active		BIT	KMSTATUS	;Check for mouse info		BVC	@2	;Mouse interrupts not enabled		BPL	@2	;Interrupts enabled but mouse didn't int		LDA	#$E	;What's interrupt status?		TAY		;Set 'Y' non-zero		TSB	BUTTON	;Combine in with button status@2		EQU	*		LDA	BUTTON	;Get mouse button status from screen holes		STA	MSESTAT	;Update related location in bank $e1		TYA		;Test if mousey interrupt or not		BEQ	PERROR2	;'c'=1 exit for not mousey type interrupt		CLC		;<> 0 so RTS with C=0		RTS		;Back to callerTSETMOUSE		EQU	*	;Mode is in A upon entry 		CMP	#$10	;If $10 or > then error		BCS	PERROR2	;Set carry for error exit		LDX	#$0A	;Indicate which mouse routine to do		JSR	GODOMOUSE	;		LDA	>MSEMODE	;Get from bank $e1 mouse mode byte		STA	MOUSMODE	; and update the screen hole also		CLC		;Must exit w/ carry clear		RTS* PASCAL PREAD, PWRITE, PSTATUS, PINIT are not* supportted by the mouse except to generate* an error for the PASCAL programmer.PERROR		EQU	*		LDX	#$03	;Bad mode : illegal operationPERROR2		EQU	*		SEC		;Must set C before exiting		RTS		;Back to callerTINITMOUSE	EQU	*	;User entry point - INITMOUSE 		LDX	#$00	;Indicate which mouse routine to do		JSR	GODOMOUSE	;CLEARMOUSE	EQU	*	;User entry point - CLEARMOUSE		STZ	HI	;Clear screen holes		STZ	LO	;		STZ	HI+$80	;		STZ	LO+$80	;		STZ	BUTTON	;		LDX	#$03	;Also clear related bank $e1 mouse stuff		LDA	#$00	;@1		EQU	*		STA	>LowAbsx,X	;		DEX		;		BPL	@1	;Loop till done		STA	>MseStat	;Clear mouse status byte alsoPOSMOUSE		EQU	*	;User entry point - POSMOUSE		PHP		;No interrupts in GETMDATA		SEI		;		JSR	GETMDATA	;Reset KeyGlu mouse information		PLP		;Restore interrupt statusCLRCRTS		EQU	*		CLC		;Must exit with carry clear		RTS		;Back to callerTCLAMPMOUSE	EQU	*	;User entry point - CLAMPMOUSE		LDX	#$02	;Indicate which mouse routine to do		JSR	GODOMOUSE	;TREADMOUSE	EQU	*	;User entry point - READMOUSE 		LDX	#$04	;Indicate which mouse routine to doGODOMOUSE		EQU	*		PHP		;Must save c/v statuses		CLC		;Off to native mode		XCE		;		PLP		;Restore c/v statuses		XBA		;Don't alter 'A'		LDA	CYAREG	;What's current speed?		PHA		;Save for later restoring		ORA	#$80	;Let's do hi speed		STA	CYAREG	;		XBA		;Don't forget to restore 'A' value		JSL	>MOUSE_DISPATCHER	;Off to bank FF		PHP		;Save c status		SEC		;Back to emulation mode		XCE		;		PLP		;Restore c status		XBA		;Don't loose 'A'		PLA		;Recall user entry speed		STA	CYAREG	; and restore it.		XBA		;Got back 'A'		RTS		;Back to caller of this subroutine** GETMDATA returns three things**   If C=0 then the following is true*      X = X / butn1 information*          bit 7= butn 1 status*          bit 6= sign of delta*          bits 0-5 = actual X delta movement if any*      Y = Y / butn0 information*          bit 7= butn 0 status*          bit 6= sign of delta*          bits 0-5 = actual Y delta movement if any**   If C=0 then the following is true*      Data was either unavailable or contaminated**  In either case, GETMDATA returns with the*  X/Y information register =MOUSEDATA clear and in*  its proper state to receive more information.GETMDATA		EQU	*		LDA	KMSTATUS	;Test if data available		BPL	PERROR2	;If + then no data available		ROR	A	;Clr C if data NOT contaminated		ROR	A	;Bit 1 has info		LDA	MOUSEDATA	;Bit 7=butn1\bit6=direction\bits0-5=delta		TAX		;		BCS	PERROR2	;C=1 if data is contaminated		LDA	KMSTATUS	;Verify hardware has Y data ready		AND	#$02	;'z'=0 if data available		BEQ	PERROR2	;'z'=1 then somethings wrong		LDA	MOUSEDATA	;Bit 7=butn0\bit6=direction\bits0-5=delta		TAY		;		CLC		;Must exit with carry clear		RTS		;Back to callerTHOMEMOUSE	EQU	*	;User entry point - THOMEMOUSE		LDX	#$08	;'X'=8 for home mouse		JSR	GODOMOUSE	;Go to bank FF to execute home mouse		BRA	POSMOUSE	;Exit via position mouse	; SEG $FFPRINTMSG8		EQU	*	;For external print capability	; SEG $00		JSR	PRINTMSG	;Print message normally		RTL		;Back to external caller	; SEG $FFPRINTMSG16	EQU	*	;For external print capability	; SEG $00		JSR	PRINTMSG2	;Print message normally		RTL		;Back to external caller		FillTo	$C4FB	;Fill with $00 		DC.B	$D6,$C6,$C1,$C2	;2nd sig byte at $CnFB * VERSIONNUMBER EQU *		DC.B	$01	;2nd release version#=01