		TITLE	'Monitor Dispatcher';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 3:27:51 PM*******************************************************                                                    **             Monitor Bank $FF Dispatcher            **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************	; SEG $FFSPELRESET		EQU	*	;Special call from NEWRESET, int off here	; SEG $00		STA	>MNEMSTKPTR	;Dummy up int stack pointers		STA	>ALEMSTKPTR	;  in case user forgets too.		REP	#$20	;16 bit 'm'		LONGA	ON		LDA	#>MONPATCH	;Set up monitor dispatcher		STA	>MDISPATCH+2	;		LDA	#MONPATCH*256+$5C	;Low word of dispatcher & Jmp abslong		STA	>MDISPATCH	;		LDA	#>TOMAINSIDE1	;Set up mainside dispatcher		STA	>MAINSIDEPATCH+2	;		LDA	#TOMAINSIDE1*256+$5C	;		STA	>MAINSIDEPATCH	;		SEP	#$20	;Back to 8 bit mode		LONGA	OFF		RTL		;Return to NEWRESET routine	; SEG $FFMONPATCH		EQU	*	; SEG $00		LONGA	OFF		LONGI	OFF		LDA	RDCXROM	;Get current CxROM state		PHA		; and save for exiting.		STA	SETINTCXROM	;MUST enable internal CxROM for routines		PEA	FFEXIT-1	;Assures common exit point from bank FF		TYA		;Make correct index		BMI	@2	;Bit 7=1 for 2nd dispatch table		PHP		;Save c status		CMP	#$05	;0-4 then special entry		BCS	@1	;		ASL	A	;Y * 2 for correct indexing		PLP		;Restore status		BRA	@0	;@1		EQU	*		PLP		;Restore c status* If any of 5 bits in $4FB (MODE) is on, then the mode is not* valid for video firmware.  Use old routines.		LDA	MODE	;no, is mode valid?		AND	#M_PASCAL+M_6+M_4+M_2+M_1		PHP		;Save status of 'AND'		TYA		;80 column routines in 2nd half of table		ASL	A	; Y*2 = correct index		PLP		;Restore status of 'AND'		BNE	@0	;=>no, use 40 column routines		CLC		;		ADC	#TABLEN		PHA		JSR	CSETUP	;set up 80 column cursor		JSR	VTABC	;calc base		PLA@0		EQU	*		TXY		;MUST save and restore X		TAX		;Move index to X		LDA	>DISPATCHTBL+1,X	;Use RTS info to go to subroutine		PHA		;		LDA	>DISPATCHTBL+0,X	;@11		EQU	*		PHA		;		TYX		;Now restore X		LDA	10,S	; and A too!		RTS		;Off to routine@2		EQU	*		PHP		;MUST preserve C/V statuses		ASL	A	; Y*2 = correct index		PLP		;Restore C/V statuses		TXY		;MUST save and restore X		TAX		;Move index to X		LDA	>DISPATCHTBL2+1,X	;Use RTS info to go to subroutine		PHA		;		LDA	>DISPATCHTBL2+0,X	;		BRA	@11	;	; SEG $FFDISPATCHTBL	EQU	*		DC.W	BOUT-1	;(0) 80 column output 		DC.W	B_ESCFIX-1	;(1) ESCFIX		DC.W	F_BASCALCCC-1	;(2) BASCALCCC		DC.W	B_KEYIN-1	;(3) KEYIN		DC.W	F_VTABCZ-1	;(4) VTABCZ 		DC.W	F_HOME-1	;(5) 40 column HOME		DC.W	F_SCROLL-1	;(6) 40 column scroll		DC.W	F_CLREOL-1	;(7) 40 column clear line		DC.W	F_CLREOLZ-1	;(8) 40 column clear with Y set		DC.W	B_RESETX-1	;(9) 40/80 column reset		DC.W	F_CLREOP-1	;(A) 40 column clear end of page		DC.W	F_RDKEY-1	;(B) readkey w/flashing checkerboard		DC.W	F_SETWND-1	;(C) Set 40 column window 		DC.W	FIXPICK-1	;(D) fix pick for 80 columns		DC.W	F_QUIT-1	;(E) quit before IN#0,PR#0TABLEN		EQU	*-DISPATCHTBL	; SEG $00FFEXIT		EQU	*		STA	6,S	;Save 'A' for user's calling routine		PLA		;Recall state of CxROM		BMI	@1	;Bit7=1 if was internal CX space		STA	SETSLOTCXROM	; else enable external CX space@1		EQU	*		RTL		;Back to caller		DC.B	$00	;Make FFEXIT 10 bytes long (A MUST!)	; SEG $FF		DC.W	B_HOME-1	;(5) 80 column HOME		DC.W	SCROLLUP-1	;(6) 80 column scroll		DC.W	X_GS-1	;(7) 80 column clear line		DC.W	B_CLREOLZ-1	;(8) 80 column clear with Y set		DC.W	B_RESETX-1	;(9) 40/80 column reset		DC.W	X_VT-1	;(A) 80 column clear end of page		DC.W	B_RDKEYX-1	;(B) readkey w/inverse cursor		DC.W	B_SETWNDX-1	;(C) 40/80 column VTABC		DC.W	FIXPICK-1	;(D) fix pick for 80 columns		DC.W	B_QUIT-1	;(E) quit before IN#0,PR#0DISPATCHTBL2	EQU	*		DC.W	XMEMORY-1	;(80) Examine memory display		DC.W	XSEARCH-1	;(81) Pattern search		DC.W	XMOVE1-1	;(82) Move data		DC.W	XVFY-1	;(83) Verify data		DC.W	MINIFF-1	;(84) Activate miniassembler		DC.W	XSTOR-1	;(85) Store byte routine		DC.W	TRACEFF-1	;(86) Trace		DC.W	STEPFF-1	;(87) Step		DC.W	RESUMEFF-1	;(88) Resume command		DC.W	EQUALSFF-1	;(89) '=' delimiter		DC.W	LISTFF-1	;(8A) Disassem and show 20 instructions		DC.W	SETPTRN-1	;(8B) Set up pattern for search		DC.W	ZMEMORY-1	;(8C) Zap memory		DC.W	LITERALASC-1	;(8D) Literal ASCII input mode		DC.W	GO816FF-1	;(8E) JSR SUBR and return to monitor		DC.W	X816FF-1	;(8F) JSL SUBR and return to monitor		DC.W	UTILITYFF-1	;(90) Utility call to Tool Locator		DC.W	MAKEMXE0-1	;(91) Switch internal 'm'/'x'/'e' to 0		DC.W	ENMONDSKACC-1	;(92) Enable monitor desk accessory		DC.W	DECDISASM-1	;(93) Disasm break/registers		DC.W	XGETNUM-1	;(94) New GETNUM routine for monitor		DC.W	PREADFF-1	;(95) New monitor PREAD routine		DC.W	REGSETFF-1	;(96) Setup regs for monitor entry at MON		DC.W	XINSDS1-1	;(97) Instruction display 		DC.W	NODISK2-1	;(98) No disk to boot from		DC.W	DISASEM-1	;(99) Disassemble 1 inst (for step/trace)		DC.W	INSDS3-1	;(9A) Get length of 65816 instruction		DC.W	DECCHFF-1	;(9B) Decrement all CH's		DC.W	WDTCHFF-1	;(9C) Width - 1 for all CH's		DC.W	RAMVCTRS-1	;(9D) Some additional coldstart stuff		DC.W	NEWBELL1-1	;(9E) New BELL1 routine for 40/80 columns		DC.W	GET6502LEN-1	;(9F) Get length of 6502 instructions only		DC.W	NEWBELL2-1	;(A0) Use speaker for BELL1 routine		DC.W	MATH-1	;(A1) Do 32 bit math		DC.W	ENTER80-1	;(A2) Enter 80 columns with ctrl-x in 'A'		DC.W	SETUPBR-1	;(A3) Read and setup BATTERYRAM parameters		DC.W	SPLASH-1	;(A4) Display splash screen		DC.W	REGDSP2-1	;(A5) Display registers		DC.W	TEXT2COPYFF-1	;(A6) Text page 2 copy from bank 00 to e1		DC.W	SETTEXT2REG-1	;(A7) Set textp2 shadow bit ($c035, bit5)		DC.W	APPLEIIGSMSG-1	;(A8) Display Apple IIgs as title		DC.W	SETPAG1-1	;(A9) Toggle txtpag1 & the one prior 'BRK'		DC.W	TEXTPAGE1-1	;(AA)	; SEG $00