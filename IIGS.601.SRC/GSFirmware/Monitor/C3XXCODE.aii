		TITLE	'$C3xx Internal ROM Code';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 9:27:10 PM**********************************************                                           **          Apple //e Video Firmware         **                                           **         R. Auricchio      Aug 1981        *       *         E. Beernink           1984        **         F. Bachman         1985-1987      **                                           **       Copyright Apple Computer, Inc.      **                  1981-1987                **            All Rights Reserved            **                                           *************************************************************************************************************                                                            ** THIS IS THE $C3XX ROM SPACE:                               ** Note:  This page must not be used by any routines          ** called by the F8 ROM.  When it is referenced, it claims    ** the C800 space (kicking out anyone who was using it).      ** This also means that peripheral cards cannot use the       ** AUXMOVE and XFER routines from their C800 space.           **                                                            ***************************************************************C300		EQU	*	;Maintained entry point $C300		SEP	#$40	;set vflag (init) 		BVS	BASICENT	;(ALWAYS TAKEN)		NOP		;A filler is required here* BASIC input entry point.  After a PR#3, this is the * address that is called to input each character.BASICIN		EQU	*	;Maintained entry point $C305		SEC		OPCODE	BCC	;(NEVER TAKEN)* BASIC output entry point.  After a PR#3, this is the* address that is called to output each character.BASICOUT		EQU	*	;Maintained entry point $C307		CLC		CLV		;CLEAR VFLAG (NOT INIT)		BVC	BASICENT	;(ALWAYS TAKEN) * Pascal 1.1 Firmware Protocol table:* This tables identifies this as an Apple //e 80 column* card.  It points to the four routines available to * programs doing I/O using the Pascal 1.1 Firmware * Protocol.* The next 6 entry points are maintained entry points		DC.B	$01	;GENERIC SIGNATURE BYTE		DC.B	$88	;DEVICE SIGNATURE BYTE		DC.B	JPINIT	;PASCAL INIT		DC.B	JPREAD	;PASCAL READ		DC.B	JPWRITE	;PASCAL WRITE		DC.B	JPSTAT	;PASCAL STATUS* 128K SUPPORT ROUTINE ENTRIES:* Maintained entry point $C311		JMP	MOVEC	;MEMORY MOVE ACROSS BANKS * Maintained entry point $C314***************************************** NAME    : XFER* FUNCTION: TRANSFER CONTROL CROSSBANK* INPUT   : $03ED=TRANSFER ADDR*         : CARRY SET=XFER TO CARD*                 CLR=XFER TO MAIN*         : VFLAG CLR=USE STD ZP/STK*         :       SET=USE ALT ZP/STK* OUTPUT  : NONE* VOLATILE: $03ED/03EE IN DEST BANK * CALLS   : NOTHING* NOTE    : ENTERED VIA JMP, NOT JSR****************************************XFER		EQU	*		XBA		;Preserve entry 'A'		LDA	$3ED	;What's addr to execute at in other bank		PHA		;Save for later		LDA	$3EE	;		PHA		;		LDA	#$30	;Arbitrarily set read/write alt RAM		TSB	STATEREG	;		BCS	@2	;'c'=1 then stay in alternate memory		TRB	STATEREG	;'c'=0 then set read/write main RAM@2		EQU	*		PLA		;Recall execution address for other bank		STA	$3EE	;		PLA		;		STA	$3ED	;		XBA		;Restore entry 'A'		STA	SETSTDZP	;Arbitrarily set std zeropage/lang card		BVC	@4	;'v'=0 then stay in main zp/lang card		STA	SETALTZP	; else change to alternate zp/lang card@4		EQU	*		JMP	($3ED)	;Go execute code in other bank****************************************BASICENT		STA	CHAR		PHY		;Save registers		PHX		;		PHP		;SAVE CARRY & VFLAG* If escape mode is allowed, the high bit of MSLOT is * clear.  Set M_CTL to flag that 1) escapes are allowed, and* 2) that control characters should not be echoed.* M_CTL is cleared by BPRINT.		BIT	MSLOT	;get MSLOT		BMI	@1	;=>Esc disable, ctl char enable		LDA	#M_CTL		TSB	MODE@1		EQU	*		JSR	SETC8	;SETUP C8 INDICATOR		PLP		;GET VFLAG (INIT)		BVS	JBASINIT	;=>DO THE INIT* If a PR#0 has been done, input should be transferred* from the video firmware to KEYIN.  This is detected* if the high bit of the mode byte is set.		BCC	@2	;=>output, no problem		LDA	MODE	;test mode		BPL	@2	;video firmware is on		JSR	SETKEYIN	;else set FD1B as input		PLX		;restore registers		PLY		LDA	CHAR		JMP	(KSWL)	;go input the character@2		JMP	C8BASIC	;GET OUT OF CN SPACEJBASINIT		JMP	BASICINIT	;=>GOTO C8 SPACEJPINIT		EQU	*		JSR	SETC8	;SETUP C8 INDICATOR		JMP	PINIT	;XFER TO PASCAL INITJPREAD		EQU	*		JSR	SETC8	;SETUP C8 INDICATOR		JMP	PASCALREAD	;XFER TO PASCAL READJPWRITE		EQU	*		JSR	SETC8	;SETUP C8 INDICATOR		JMP	PWRITE	;XFER TO PASCAL WRITEJPSTAT		EQU	*		JSR	SETC8	;Setup C8 indicator		TAX		;is request code = 0?		BEQ	@1	;=>yes, ready for output		DEX		;check for any input		BNE	PSTERR	;=>bad request, return error		JSR	XBITKBD	;look for a key		BPL	PNOTRDY	;=>no keystroked@1		SEC		RTSPSTERR		LDX	#3	;else flag errorPNOTRDY		CLC		RTS		EJECT***************************************** NAME    : SETC8* FUNCTION: SETUP IRQ $C800 PROTOCOL* INPUT   : NONE* OUTPUT  : NONE* VOLATILE: NOTHING* CALLS   : NOTHING****************************************SETC8		EQU	*		LDX	#>C300	;SLOT NUMBER		STX	MSLOT	;STUFF IT		LDX	CLRROM	;kick out other $C8 ROMs		RTS***************************************** NAME    : MOVEC* FUNCTION: PERFORM CROSSBANK MEMORY MOVEC* INPUT   : A1=SOURCE ADDRESS*         : A2=SOURCE END*         : A4=DESTINATION START*         : CARRY SET=MAIN-->CARD*                 CLR=CARD-->MAIN* OUTPUT  : A1=A2+1*         : A4=A4+(A2-A1)+1* VOLATILE: NOTHING* CALLS   : NOTHING****************************************MOVEC		EQU	*		PHB		;Save data bank register before moving		PHA		;Save A		PHY		;Save Y		PHX		;Save X		LDA	STATEREG	;Save user memory configuration		PHA		;		AND	#$CF	;Must enable read/write main memory		STA	STATEREG	;		LDA	CYAREG	;Go to hi speed after saving current speed		PHA		;		ORA	#$80	;Set hi bit		STA	CYAREG	;		PHP		;Save C for a little while		PHP		;Save C for a little while		CLC		;Switch modes		XCE		;Off to native land		REP	#$30	;Off to 16 bit land		SEC		;Calculate length to move		LDA	A2L	;Src ending addr minus src starting addr		PHA		;Save for later		SBC	A1L	; leaves source data length in 'A'		PHA		;Save length of move for later		LDA	5,S	;Get back 'c'		ROR	A	;Set carry as it was before		LDA	1,S	;Get subtraction result back		LDX	A1L	;Source address		LDY	A4L	;Destination address		BCC	@1	;C=0 then aux to main		MVN	$000000,$010000	;Move bank 00 data to bank 01		BRA	@2	;@1		EQU	*		MVN	$010000,$000000	;Move bank 01 to bank 00@2		EQU	*		PLA		;Fix A4 for those who need A4=A4+(A2-A1)+1		SEC		;Cause +1 to be added		ADC	A4L	;		STA	A4L	;A4=(A2-A1)+1		PLA		;Fix A1 for those who need on A1=A2+1		INC	A	;+1		STA	A1L	;A1=A2+1		PLA		;Clean entry status off stack		SEP	#$30	;PUT SEC/XCE BELOW HERE WHEN MEGA// FIXED		PLA		;Restore system speed		STA	CYAREG	;		PLA		;Restore user memory configuration		STA	STATEREG	;		SEC		;Back to emulation mode to exit		XCE		;		PLX		;Restore X		PLY		;Restore Y		PLA		;Restore A		PLB		;MUST restore data bank reg after moving		RTS		;Back to callerFIXCURSHIFTER	EQU	*	;Reset CURSHIFTER		LDA	>USERFLASH	;		EOR	#$07	;Flip lower 3 bits		SEC		;Subtract 3		SBC	#$03	;		ASL	A	;Now times 2		INC	A	;Now add 1		STA	>CURSHIFTER	;Save for later		RTS		;Back to caller	; SEG $FFESCIN		EQU	*		DC.B	$88,$95,$8A,$8B,$86,$82	; SEG $00