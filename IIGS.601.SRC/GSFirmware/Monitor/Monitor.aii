		MACHINE	M65816		LONGA	OFF		LONGI	OFF		PRINT	NOGEN		PRINT	push		PRINT	ON		INCLUDE	'::Firmware.MACROS.aii'; CONDITIONAL COMPILE SWITCHES (by Joe. Bo probably; exact purpose not known)IS512		EQU	0	;0:= 128K ROM's   1:= 64K ROM'sOPTION4		EQU	0	;0 := REV.D ROM / 1 := OPTION4 ROMSETPASSWD	EQU	0	;0/1 := without/with password setting option		INCLUDE	'::Firmware.Equates.aii'		INCLUDE	'CP.EQUATES.aii'		INCLUDE	'MOUSE.VAR.aii'		PRINT	pop		MSB	ONBnk~Org		EQU	$7600		MONITOR		PROC	ORG $FF7600		WITH	CP_MsgEquatesRel~Org:			INCLUDE	'MON.DISPATCHER.aii'		INCLUDE	'MOUSE.MISC.aii'		INCLUDE	'SLOT.ARBITER.aii'		FillTO	$7B70		INCLUDE	'COPYRIGHT.VCTRS.aii'		INCLUDE	'KEYMICRO.CP.RESET.aii'		INCLUDE	'CP.TABLES.aii'		INCLUDE	'CP.MAIN.aii'		INCLUDE	'MISC.MON.aii'		INCLUDE	'DISASM.MINIASM.aii'		INCLUDE 'BFUNC.80COL.aii'		INCLUDE	'DEBUG.aii'		INCLUDE	'BRAM.INTR071.aii'		FillTo	$C300				INCLUDE 'C3XXCODE.aii'		INCLUDE	'C4XXCODE.aii'		FillTO	$C800		INCLUDE 'SLOT3.C8.CF.aii'		FillTo	$CFFE	;fill up to $CFFE		DC.W	0	;zero in cffe & cfff		FillTo	$F800	;filler for AppleSoft's 10K		INCLUDE	'AUTOSTART.aii'		ENDP ; this silly proc is necessary since AsmIIgs won't generate an output file; if the last bytes of the address space at $FF/FFFE.FFFF are assembled ; thus wrapping the program counter around the 24-bit address space !!!^%$#^%$#!!LASTWORD	PROC	org 0		DC.W	$C074	;go to the interrupt ROM's BRK/IRQ entry point		ENDP		END		