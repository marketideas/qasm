		TITLE	'Auto-Start Monitor ROM'		;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d3 on 5/6/91 at 8:29:45 PM******************************************                                       **               APPLE II                **              MONITOR II               **                                       **    Copyright 1978, 1981, 1984-1989    **                   by                  **          Apple Computer, Inc.         **                                       **          All Rights Reserved          **                                       **       S. Wozniak             1977     **       A. Baum                1977     **       John A            Nov  1978     **       R. Auricchio      Sep  1981     **       E. Beernink            1984     **       E.K. Lai          Sep  1984     **       F. Bachman          1985-1987   **       Joe Bo              1988-1989   **                                       ******************************************PLOT		EQU	*	;Maintained entry point $F800		LSR	A	;Y-COORD/2 		PHP		;SAVE LSB IN CARRY 		JSR	GBASCALC	;CALC BASE ADR IN GBASL,H 		PLP		;RESTORE LSB FROM CARRY 		LDA	#$0F	;MASK $0F IF EVEN 		BCC	@1		ADC	#$E0	;MASK $F0 IF ODD @1		STA	MASKPLOT1		EQU	*	;Maintained entry point $F80E		LDA	(GBASL),Y	;DATA 		EOR	COLOR	; XOR COLOR 		AND	MASK	;  AND MASK 		EOR	(GBASL),Y	;   XOR DATA 		STA	(GBASL),Y	;    TO DATA 		RTSHLINE		EQU	*	;Maintained entry point $F819		JSR	PLOT	;PLOT SQUARE @1		CPY	H2	;DONE? 		BCS	RTS1	; YES, RETURN 		INY		; NO, INCR INDEX (X-COORD) 		JSR	PLOT1	;PLOT NEXT SQUARE 		BCC	@1	;ALWAYS TAKEN VLINEZ		ADC	#$01	;NEXT Y-COORD VLINE		EQU	*	;Maintained entry point $F828		PHA		; SAVE ON STACK 		JSR	PLOT	; PLOT SQUARE 		PLA		CMP	V2	;DONE? 		BCC	VLINEZ	; NO, LOOP. RTS1		RTSCLRSCR		EQU	*	;Maintained entry point $F832		LDY	#$2F	;MAX Y, FULL SCRN CLR 		BNE	CLRSC2	;ALWAYS TAKEN CLRTOP		EQU	*	;Maintained entry point $F836		LDY	#$27	;MAX Y, TOP SCRN CLR CLRSC2		STY	V2	;STORE AS BOTTOM COORD FOR VLINE CALLS		LDY	#$27	;RIGHTMOST X-COORD (COLUMN) @1		LDA	#$00	;TOP COORD FOR VLINE CALLS 		STA	COLOR	;CLEAR COLOR (BLACK) 		JSR	VLINE	;DRAW VLINE 		DEY		;NEXT LEFTMOST X-COORD 		BPL	@1	;LOOP UNTIL DONE. 		RTSGBASCALC		EQU	*	;Maintained entry point $F847		PHA		;FOR INPUT  00DEFGH 		LSR	A		AND	#$03		ORA	#$04	;GENERATE GBASH=000001FG 		STA	GBASH		PLA		;AND GBASL=HDEDE000 		AND	#$18		BCC	@1		ADC	#$7F@1		STA	GBASL		ASL	A		ASL	A		ORA	GBASL		STA	GBASL		RTSNXTCOL		EQU	*	;Maintained entry point $F85F		LDA	COLOR	;INCREMENT COLOR BY 3 		CLC		ADC	#$03SETCOL		EQU	*	;Maintained entry point $F864		AND	#$0F	;SETS COLOR=17*A MOD 16 		STA	COLOR		ASL	A	;BOTH HALF BYTES OF COLOR EQUAL 		ASL	A		ASL	A		ASL	A		ORA	COLOR		STA	COLOR		RTSSCRN		EQU	*	;Maintained entry point $F871		LSR	A	;READ SCREEN Y-COORD/2 		PHP		;SAVE LSB (CARRY) 		JSR	GBASCALC	;CALC BASE ADDRESS 		LDA	(GBASL),Y	;GET BYTE 		PLP		;RESTORE LSB FROM CARRY SCRN2		BCC	RTMSKZ	;IF EVEN, USE LO H SCRN4		LSR	A		LSR	A		LSR	A	;SHIFT HIGH HALF BYTE DOWN 		LSR	ARTMSKZ		AND	#$0F	;MASK 4-BITS 		RTSDBTOE1		EQU	*	;Change data bank register to E1		PEA	$E1E1	;Change data bank register to E1		PLB		;Dummy pull		PLB		;Sets data bank register to E1		RTS		;GONEWGETNUM	EQU	*	;Used by monitor		LDY	#$94	;'Y'=$94 for new GETNUM routine		BRA	GOTOBANKFF	;Return to caller via this way		FillTo	$F88C	;PadINSDS1_2		EQU	*	;Maintained entry point $F88C		LDA	(PCL,X)	;Here for user programs only		FillTo	$F88E	;Pad* INSDS2 returns the length of opcodes.  All opcodes* lengths-1 are returned in LENGTH.  On entry the opcode* to determine the length of is in 'A'.** For compatibility reasons with DOS 3.3's relocator* and for historical reasons INSDS2 must return the* length of 6502 instructions and a length of 1* byte for non 6502 instructions.** GET816LEN performs the same function as INSDS2 except* it properly returns the length of all 65816 instructions.INSDS2		EQU	*	;Maintained entry point $F88E		SEC		;Indicate 6502 instruction lens wanted		OPCODE	BCC	;Go do routineGET816LEN		EQU	*	;Maintained entry point $F890		CLC		;Indicate 65816 instructions lens wanted		JMP	GETLENGTH	;Go do routineDOFFCOUT		EQU	*	;Called from bank FF to do COUT		JMP	COUTFF	;Go thru anti dispatcher to output charDOFFCOUT1		EQU	*	;Called from bank FF to do COUT1		JMP	COUT1FF	;Go thru anti dispatcher to output charDONEWBELL2	EQU	*		LDY	#$A0	;'Y'=A0 for new speaker BELL1 routineGOTOBANKFF	EQU	*	;Go execute routine in bank $FF		PHP		;Save user status bits first		CLC		;Now switch to native 65816 mode		XCE		;		PLP		;Restore user interrupt status now		SEP	#$30	;Set m/x to 8 bit mode		PHA		;Save user's 'A'		LDA	CYAREG	;Save speed status		PHA		;		ORA	#$80	; and switch to hi speed		STA	CYAREG	;		JSL	>MDISPATCH	;Off to bank $FF		PLA		;Return here and restore user speed		STA	CYAREG	;		PLA		;Recall new 'A'MAINSIDE		EQU	*	;Called from bank FE/FF ROM space		PHP		;Now switch back to emulation mode		SEC		;		XCE		;		PLP		;Now restore subroutine's status		RTS		;Back to callerSETMEMORY00	EQU	*	;Memory fill routine so DOS will boot		STZ	$800	;Pattern to fill memory with		LONGA	ON		LONGI	ON		CLC		;		XCE		;		REP	#$30	;16 bit mode a must		LDX	#$800	;Starting address		TXY		;Destination address equals starting		INY		; address+1		LDA	#$B7FE	;Number of bytes to move		MVN	0,0	;Source bank,destination bank		BRA	MAINSIDE	;Return to emulation mode and exit		LONGA	OFF		LONGI	OFF		FillTo	$F8D0	;PadINSTDSP		EQU	*	;Maintained entry point $F8D0		LDY	#$99	;'Y'=$99 for DISASEM 		BRA	GOTOBANKFF	;Disassemble 1 instructionMAINEXIT		EQU	*	;Called from bank FE/FF ROM space		PHP		;Save processor status		CLC		;Make shift back to native mode		XCE		;		PLP		;Restore processor status		RTL		;Back to calling bank* SPATFNS is called by Applesoft (with a JSR) and* is an extension of the HLIN routine to fix* horizontal/vertical range checking.SPATFNS		EQU	*	;Maintained entry point $F8D9		JSR	GETBYT	;Get first argument		CPX	#80	;HLIN allows max value here of 79		BCS	@2	;'c'=1 then value entered is too big		STX	FIRST	;Save for Applesoft		JSR	CHKCOM	;Parse check for a ','		JSR	GETBYT	;Get second argument		CPX	#80	;HLIN allows max value here of 79		STX	H2	;Save for Applesoft		STX	V2	; in Applesoft variable space.		JMP	ATFNS2	;Continue in Applesoft@2		EQU	*		JMP	TOOBIG	;Continue with range error in ApplesoftNEWRESET2		EQU	*		JSR	SETMEMORY00	;Fix up memory for DOS		JSR	HOME	;Clear the screen		LDY	#$A4	;Print title and copyright msg		JSR	GOTOBANKFF	;Go to bankff 		LDY	#$9D	;Do some more coldstart stuff		JSR	GOTOBANKFF	;Go to bank FF		JSR	ENBDATAREG	;Enable ints for Desk Accessory Manager		LDA	>EXTENDBNK+1	;BUTN1 ;Get button 1 (Solid-Apple)		BMI	SHOWCP	;=>Up, then user wants normal powerupJUMPERON		EQU	*		RTS		;Back to callerSHOWCP		EQU	*	;=>Down, then user wants control panel*		LDA	>GSC	;Added 2/10/89 MSA to check TS Jumper		ASL	A	;We're interested in bit 6		BMI	JUMPERON	;If TS Jumper, don't allow special CP entry*		CLC		;Switch to native mode		XCE		; with 8 bit 'm'/'x'		JSL	>SPEC_PANEL	;		SEC		;		XCE		;Back to emulation mode to restart system		JMP	RESET	;TRYAPTALK		EQU	*	;Call from 'MAYBEAPTALK' routine		LDA	>APTALKBOOT	;Check AppleTalk boot byte		BEQ	@2	;Slot1/2 none selected for ApTalk		CMP	#$02	;Is it slot2 AppleTalk ?		BNE	@1	;Bra to boot from slot1		JMP	BOOTAPTALK2	;Boot from AppleTalk via slot2@1		EQU	*		JMP	BOOTAPTALK1	;Boot from AppleTalk via slot1@2		EQU	*		JMP	NODISK	;Display 'Check Startup Device' msg;NEWCNTLT EQU *;LDA =FLIPSCRN ;;EOR #$80;STA =FLIPSCRN ;;LDY #$A9;JMP GOTOBANKFF ;		FillTo	$F93A	;PadGETAN3STATUS	EQU	*	;Maintained entry point $F93A		LDA	INTFLAG	;Get AN3 status in bit 5		ASL	A	;Move status to bit 7 for AppleSoft		ASL	A	;		RTS		;Back to callerPRNTYX		EQU	*	;Maintained entry point $F940		TYA		;PRNTAX		EQU	*	;Maintained entry point $F941		JSR	PRBYTE	;OUTPUT TARGET ADR PRNTX		EQU	*	;Maintained entry point $F944		TXA		;  OF BRANCH AND RETURN 		JMP	PRBYTEPRBLNK		EQU	*	;Maintained entry point $F948		LDX	#$03	;BLANK COUNT PRBL2		EQU	*	;Maintained entry point $F94A		LDA	#$A0	;LOAD A SPACE 		JSR	COUT	;OUTPUT A BLANK 		DEX		BNE	PRBL2	;LOOP UNTIL COUNT=0   		RTSPCADJ		EQU	*	;Maintained entry point $F953		SEC		;0=1 BYTE, 1=2 BYTE, 		LDA	LENGTH	;  2=3 BYTE PCADJ3		LDY	PCH		TAX		;TEST DISPLACEMENT SIGN 		BPL	@1	;  (FOR REL BRANCH) 		DEY		;EXTEND NEG BY DECR PCH @1		ADC	PCL		BCC	@2	;PCL+LENGTH(OR DISPL)+1 TO A 		INY		;  CARRY INTO Y (PCH) @2		RTS** Due to limited space, differentiation between Gyro * and gs can't insert here, thus move TEXT2COPY to* TEXT2COPYFF.  Entry point must be maintained.** This routine installs a heartbeat task* that copies text page 2 to bank E0 for* the Mega // to display on every VBL.** This is a toggle (enable/disable) routine.* If auto text copy is on, on entry, it is disabled on exit.* If auto text copy is off, on entry, it is enabled on exit.*		FillTo	$F962	;PadTEXT2COPY		EQU	*	;Maintained entry point $F962		LDY	#$A6	;'Y' = $A6 for TEXT2COPYFF		JMP	GOTOBANKFF	;Go and do it in bank ffSETP2REG		EQU	*	;Set bit5 of $c035 from TP2MODE		LDY	#$A7	;'Y' = $A7 for settext2reg		JMP	GOTOBANKFF	;GETLENGTH1	EQU	*		PHY		;Preserve Y for the user		LDY	#$9A	;'Y'=$9A for INSDS3		BCC	GETLENGTH2	;'c'= 1 for 6502 lengths		LDY	#$9F	;'Y'=$9F for 6502 instruction lengthsGETLENGTH2	EQU	*		JSR	GOTOBANKFF	;Go do routine		PLY		;Restore Y for the user		RTS		;Back to callerNOTCR3		EQU	*		XBA		;Preserve output character or suffer		LDA	>CHGCURFLG	;Test bit 0 for don't count flag		LSR	A	;'c'=0 then continue normally		BCC	@1	;		BNE	@1	;If 'z'=1 then clear CHGCURFLG		STA	>CHGCURFLG	;@1		EQU	*		XBA		;Restore output character or suffer		RTS		;'c'=1 then don't count in input buffer.		TITLE	'Auto-Start Monitor ROM'******************************************                                       **               APPLE II                **              MONITOR II               **                                       **    Copyright 1978, 1981, 1984-1989    **                   by                  **          Apple Computer, Inc.         **                                       **          All Rights Reserved          **                                       **       S. Wozniak             1977     **       A. Baum                1977     **       John A            Nov  1978     **       R. Auricchio      Sep  1981     **       E. Beernink            1984     **       E.K. Lai          Sep  1984     **       F. Bachman          1985-1987   **       Joe Bo              1988-1989   **                                       ******************************************CHRTBL		DC.B	$BC	;'^C' (BASIC warm start) 		DC.B	$B2	;'^Y' (USeR vector) 		DC.B	$BE	;'^E' (Examine registers) 		DC.B	$9A	;'!'  (Enter mini-assembler) 		DC.B	$EF	;'V'  (Memory verify) 		DC.B	$C4	;'^K' (IN#slot) 		DC.B	$E9	;'P'  (Pattern search)		DC.B	$A9	;'^P' (PR#slot) 		DC.B	$BB	;'^B' (BASIC cold start) 		DC.B	$A6	;'-'  (Subtract) 		DC.B	$A4	;'+'  (Add) 		DC.B	$06	;'M'  (Memory move) 		DC.B	$95	;'<'  (Delimiter for move, verify)		DC.B	$07	;'N'  (Set normal video) 		DC.B	$02	;'I'  (Set inverse video) 		DC.B	$05	;'L'  (Disassemble instructions)		DC.B	$00	;'G'  (JSR subroutine and return to mon)		DC.B	$F1	;'X'  (JSL subroutine and return to mon)		DC.B	$EB	;'R'  (JMP subroutine and do not return)		DC.B	$93	;':'  (Memory fill)		DC.B	$A7	;'.'  (Address delimiter) 		DC.B	$C6	;'CR' (End of input) 		DC.B	$99	;' '  (Blank) 		DC.B	$96	;'='  (New commands delimiter)		DC.B	$ED	;'T'  (Trace)		DC.B	$EC	;'S'  (Step)		DC.B	$9B	;'"'  (Literal ASCII input mode)		DC.B	$F5	;'\'  (Start/end of pattern to search for)		DC.B	$F3	;'Z'  (Zap memory)		DC.B	$EA	;'Q'  (Quit monitor via JMP $3D0)		DC.B	$EE	;'U'  (Utility call to Tool Locator)		DC.B	$AB	;'^R' (Restore registers)		DC.B	$AD	;'^T' (Go to Text page 1)		DC.B	$A3	;'*'  (Multiply)		DC.B	$F8	;'_'  (Divide)		DC.B	$9C	;'#'  (Enable monitor desk accessory)		DC.B	$C7	;'^N' (Set internal 'm'/'x'/'e' = 0)CHRTBLLEN		EQU	*-CHRTBL-1	;Length of character table* Table of low order monitor routine dispatch * addresses.  High byte always $FESUBTBL		DC.B	BASCONT-1	;'^C' (BASIC warm start) 		DC.B	USR-1	;'^Y' (USeR vector)		DC.B	NEWREGZ-1	;'^E' (Examine registers) 		DC.B	MINI-1	;'!'  (Enter mini-assembler)		DC.B	XVERIFY-1	;'V'  (Memory verify) 		DC.B	INPRT-1	;'^K' (IN#slot) 		DC.B	SEARCH-1	;'P'  (Pattern search)		DC.B	OUTPRT-1	;'^P' (PR#slot) 		DC.B	XBASIC-1	;'^B' (BASIC cold start) 		DC.B	SETMODE-1	;'-'  (Subtract)		DC.B	SETMODE-1	;'+'  (Add)		DC.B	XMOVE-1	;'M'  (Memory move) 		DC.B	LT-1	;'<'  (Delimiter for move,verify) 		DC.B	SETNORM-1	;'N'  (Set normal video) 		DC.B	SETINV-1	;'I'  (Set inverse video) 		DC.B	LIST-1	;'L'  (Disassemble instructions)		DC.B	GO816-1	;'G'  (JSR subroutine and return to mon)		DC.B	X816-1	;'X'  (JSL subroutine and return to mon)		DC.B	RESUME-1	;'R'  (JMP subroutine and do not return)		DC.B	SETMODE-1	;':'  (Memory fill) 		DC.B	SETMODE-1	;'.'  (Address delimiter) 		DC.B	CRMON-1	;'CR' (End of input) 		DC.B	BLANK-1	;' '  (Blank)		DC.B	EQUALS-1	;'='  (New commands delimiter)		DC.B	TRACE-1	;'T'  (Trace)		DC.B	STEP-1	;'S'  (Step)		DC.B	LITASC-1	;'"'  (Literal ASCII input mode)		DC.B	PTRNSET-1	;'\'  (Start/end of pattern to search for)		DC.B	CMDZAP-1	;'Z'  (Zap memory)		DC.B	QUITMON-1	;'Q'  (Quit monitor via JMP $3D0)		DC.B	UTILITY-1	;'U'  (Utility call to Tool Locator)		DC.B	REGSET-1	;'^R' (Restore registers)		DC.B	GOTXT11-1	;'^T' (Go to Text page 1)		DC.B	SETMODE-1	;'*'  (Multiply)		DC.B	SETMODE-1	;'_'  (Divide)		DC.B	MONDSKACC-1	;'#'  (Enable monitor desk accessory)		DC.B	MAKENATIVE-1	;'^N' (Set internal 'm'/'x'/'e' = 0)WARMUPAPTALK	EQU	*	;Warm start AppleTalk and continue		CLC		;Switch to native mode to do this		XCE		;		PHP		;Be sure to save entry status		JSL	>APTALKRESET	;Warm start AppleTalk		PLP		;Restore entry status		XCE		;ENBDATAREG	EQU	*	;Enable data register ints for DA manager		SEI		;Disable interrupts briefly		LDA	#$10	;Enables data register interrupt		TSB	KMSTATUS	; via key glue.		CLI		;Enable system interruptsD2D		EQU	*	;Disk ][ detect		LDA	>SLOTSFLG	;Setup SLTROMSEL correctly for warm start		STA	SLTROMSEL	;		LDY	LOC0	;Save zero page bytes used on stack		PHY		;		LDY	LOC1	;Save zero page bytes used on stack		PHY		;		LDA	#$00	;Setup byte to map in Disk ][ detects		PHA		;Save for later		LDA	#$C8	;Use zero page for this test		STZ	LOC0	;Lo byte is 0		STA	LOC1	;Hi byte is in 'A'@1		EQU	*		CLC		;Clear a bit@2		EQU	*	;'c'=1 if branch to here		PLA		;		ROL	A	;Shift in a bit		PHA		;Save on stack again		LDY	#$05	;Test starting at 6th byte		DEC	LOC1	;Change slot pointer		LDA	LOC1	;Test if done		CMP	#$C4	;Done if decremented to slot 3		BCC	@5	;@3		EQU	*		LDA	(LOC0),Y	;Test 1st I.D. byte		CMP	DISKID-1,Y	; against disk ][ bytes.		BNE	@1	;<>= then try next slot		DEY		;Try next I.D. byte		DEY		;		BPL	@3	;Loop		LDA	(LOC0),Y	;'Y'=$FF if here		BEQ	@2	;= then it's a disk ][		INC	A	;If value now 0 it's also a disk ][		BNE	@1	;Try next slot		BEQ	@2	;= then it's a disk ][@5		EQU	*		PLA		;Recall status byte		PLY		;Recall zero page bytes used		STY	LOC1	;Restore zero page bytes used		PLY		;Recall zero page bytes used		STY	LOC0	;Restore zero page bytes used		JMP	FIXSPEED2	;Set up CYAREGT480CARD		EQU	*	;Test for possible 80 column card		LDA	>USERCOL	;0=40 columns <>0=80 columns		BNE	T480CARD2	;<>= then test for ROM in slot 3		INC	A	;=0 then make <>0		RTS		;Indicate use 40 columnsT480CARD2		EQU	*		LDX	#$00	;Preset counter to $00@2		EQU	*		LDA	C300+5+0	;Test for match		CMP	#$38	;		BNE	@3	;<>= then no card installed		LDA	C300+7	;Test for another match		CMP	#$18	;		BNE	@3	;<>= then no card installed		INX		;Try many times to be sure		BNE	@2	;Loop for another try@3		EQU	*	;Exit here		RTS		;= then use 80 cols/ <>= then use 40 cols		FillTo	$FA40	;PadOLDIRQ		EQU	*	;Maintained entry point $FA40		JMP	TOEBRKIRQ	;Go to new interrupt handlerOLDBRK2		EQU	*		JSR	BELL	;Ring the bells		JSR	ENBDATAREG	;Turn on ints/switch system to user spd		JMP	MONZ2	;Skip register reset		FillTo	$FA4C	;PadBREAK		EQU	*	;Maintained entry point $FA4C		PLP		;		JSR	SAV1	;SAVE REG'S ON BREAK 		PLA		; INCLUDING PC 		STA	PCL		PLA		STA	PCHGOBRK~Bnk00	EQU	*-Rel~Org+Bnk~Org	;Called by interrupt code		JMP	(BRKV)	;BRKV WRITTEN OVER BY DISK BOOTOLDBRK		EQU	*	;Maintained entry point $FA59		LDY	#$93	;Print user instruction of break		JSR	GOTOBANKFF	; and register display		BRA	OLDBRK2	;Go to pseudo monitor start		FillTo	$FA62	;PadRESET		EQU	*	;Maintained entry point $FA62		LDA	#$01	;Enable read alt mem with long inst		TSB	NEWVIDEO	;		FillTo	$FA67,$EA	;PadFBBYTE		EQU	*+1	;Maintained entry point $FF68		LDA	#$FB	;FBBYTE must be $FB for compatibility		SEI		;In case user calls into here		CLD		;Do this on every reset		TCS		;Must reset the stack		JSR	NEWRESET	;New reset routine		LDA	#$0C	;Set up //e memory state		STA	STATEREG	; or else die later.		LDY	#9	;CODE=INIT		JSR	GOTOBANKFF	;Do new machine init code		LDA	CLRROM	; TURN OFF EXTNSN ROM		BIT	KBDSTRB	; CLEAR KEYBOARD		JSR	T480CARD	;Does user want 40 or 80 columns?		BNE	@1	;		JSR	TSTFORCUR4	;Switch user to 80 column mode@1		EQU	*	;Don't change video output mode		JSR	DONEWBELL2	; CAUSES DELAY IF KEY BOUNCES		LDA	SOFTEV+1	;IS RESET HI		EOR	#$A5	;A FUNNY COMPLEMENT OF THE		CMP	PWREDUP	; PWR UP BYTE ?		BNE	PWRUP	; NO SO PWRUP		LDA	SOFTEV	; YES SEE IF COLD START		BNE	NOFIX	; HAS BEEN DONE YET?		LDA	#$E0	; DOES SOFT ENTRY VECTOR POINT AT BASIC? 		CMP	SOFTEV+1		BNE	NOFIX	; YES SO REENTER SYSTEM		LDY	#3	; NO SO POINT AT WARM START FOR NEXT RESET		JMP	NEWFIXSEV	; DO THE COLD START		FillTo	$FAA6	;PadPWRUP		EQU	*	;Maintained entry point $FAA6		JSR	NEWRESET2	;Clear memory+show 'Apple II' on screen*  Set up page 3 vectors.		LDX	#5@1		LDA	PWRCON-1,X	; WITH CNTRL B ADRS		STA	BRKV-1,X	; OF CURRENT BASIC		DEX		BNE	@1		BRA	WHO2BOOT	;Who to boot?SETPLP2		EQU	*		STA	LOC1	; SET PTR H		STZ	LOC0	;Assure low byte of pointer is 0* Check 3 ID bytes instead of 4.  Allows devices* other than Disk II's to be bootable.SLOOP		EQU	*	;Maintained entry point $FABA		LDY	#5	;Y is byte ptr		DEC	LOC1		LDA	#0	;MUST have 0 at $FABF to match 0 at $FAFF		LDA	LOC1		CMP	#$C0	; AT LAST SLOT YET?		BEQ	NODISK	; YES AND IT CAN'T BE A DISK		STA	MSLOT@1		LDA	(LOC0),Y	; FETCH A SLOT BYTE		CMP	DISKID-1,Y	; IS IT A DISK ??		BNE	SLOOP	; NO, SO NEXT SLOT DOWN		DEY		DEY		; YES, SO CHECK NEXT BYTE		BPL	@1	; UNTIL 3 BYTES CHECKED		JMP	(LOC0)	; GO BOOT... REGDSP		EQU	*	;Maintained entry point $FAD7		LDY	#$A5	;Go do new 65816 register display		BRA	NODISK1	;NOFIX		EQU	*		JSR	WARMUPAPTALK	;Wrmstrt Aptalk/Enable ints for DskAcc Mgr		JMP	(SOFTEV)	;Continue through soft entry vectorWHO2BOOT		EQU	*		LDA	>USERSLTST	;What is user's startup slot preference?		BEQ	SCAN2BOOT	;=0 then scan to boot		CMP	#$8	;8=RAMdisk 9=ROMdisk A=AppleTalk   		BCC	WHO2BOOT2	;<8 then boot from specific slot		BRA	MAYBEAPTALK	;>8 then may be AppleTalk  BOOTSMART		EQU	*		LDA	#$5	;Force smart prt if RAMDISK/ROMDISK pickedWHO2BOOT2		EQU	*		ORA	#$C0	;Make hi byte of jump instruction		INC	A	;Offset for normal monitor search routine		BRA	SETPLP2	;Return to normal boot routineSCAN2BOOT		EQU	*	;Do normal scan to boot.		LDA	#$C8	;For SCAN as choice load hi slot+1		BRA	SETPLP2	;Return to normal boot routineNODISK		EQU	*		LDY	#$98	;'Y'=$98 for no disk on power up msgNODISK1		EQU	*		JMP	GOTOBANKFF	;Go do routine in bank FF		FillTo	$FAFD	;PadPWRCON		DC.W	OLDBRK* Warning: $00 'MUST' appear at $FAFF		DC.B	$00,$E0,$45	;Maintained entry point $FAFFDISKID		DC.B	$20,$FF,$00,$FF		DC.B	$03,$FF,$3CAPPLEMSG		EQU	*	;Maintained entry point $FB09		DC.B	'Apple ]['XLTBL		EQU	*		DC.B	$C4,$C2,$C1	;For 'ESC' keypress conversion		DC.B	$FF,$C3	;		DC.B	$FF,$FF,$CD	;RTBL		EQU	*	;Maintained entry point $FB19		DC.B	$C1,$D8,$D9	;'AXYPS'		DC.B	$D0,$D3	;PREAD		EQU	*	;Maintained entry point $FB1E		JMP	DOPREAD	;Y=$95 for PREAD (Save 'X' through here)PREAD4		EQU	*	;Maintained entry point $FB21		JMP	DOPREAD4	;Timeout then do PREAD		TITLE	'Auto-Start Monitor ROM'******************************************                                       **               APPLE II                **              MONITOR II               **                                       **    Copyright 1978, 1981, 1984-1989    **                   by                  **          Apple Computer, Inc.         **                                       **          All Rights Reserved          **                                       **       S. Wozniak             1977     **       A. Baum                1977     **       John A            Nov  1978     **       R. Auricchio      Sep  1981     **       E. Beernink            1984     **       E.K. Lai          Sep  1984     **       F. Bachman          1985-1987   **       Joe Bo              1988-1989   **                                       ******************************************MAYBEAPTALK	EQU	*		CMP	#$0A	;Check to boot from AppleTalk		BNE	BOOTSMART	;Boot smartport if RAMDISK/ROMDISK picked		JMP	TRYAPTALK	;Try AppleTalkDOFFSVK		EQU	*	;Called from bank FF to set video/keyboard		JMP	SETVIDKBDFF	;Do it via reverse dispatcher		FillTO	$FB2F	;PadINIT		EQU	*	;Maintained entry point $FB2F		LDA	#$00	;		STA	STATUS	;CLR STATUS FOR DEBUG SOFTWARE 		LDA	LORES		LDA	TXTPAGE1	;INIT VIDEO MODE SETTXT		EQU	*	;Maintained entry point $FB39		LDA	TXTSET	;SET FOR TEXT MODE 		LDA	#$00	;FULL SCREEN WINDOW 		BEQ	SETWNDSETGR		EQU	*	;Maintained entry point $FB40		LDA	TXTCLR	;SET FOR GRAPHICS MODE 		LDA	MIXSET	;LOWER 4 LINES AS TEXT WINDOW 		JSR	CLRTOP		LDA	#$14SETWND		EQU	*	;Maintained entry point $FB4B		STA	WNDTOP	;SET FOR 40 COL WINDOW 		LDA	#$00	;Left side of screen starts at $00		STA	WNDLFT	;Top in A-reg, bottom at line $24SETWND2		EQU	*	;Maintained entry point $FB51		LDY	#$C	;CODE=SETWND 		BRA	NODISK1	;* Identification bytes for CORTLAND** REGIDz's are return'ed when the user JSR's to $FE1F.** REGIDA = Bit 15 = reserved*          Bit 14 = reserved*          Bit 13 = reserved*          Bit 12 = reserved*          Bit 11 = reserved*          Bit 10 = reserved*          Bit 09 = reserved*          Bit 08 = reserved*          Bit 07 = reserved*          Bit 06 = 1 if system has a memory expansion slot*          Bit 05 = 1 if system has an IWM port*          Bit 04 = 1 if system has a built in clock*          Bit 03 = 1 if system has front desk bus*          Bit 02 = 1 if system has SCC built in*          Bit 01 = 1 if system has external slots*          Bit 00 = 1 if system has internal slots** REGIDX = Bit 15 = reserved*          Bit 14 = reserved*          Bit 13 = reserved*          Bit 12 = reserved*          Bit 11 = reserved*          Bit 10 = reserved*          Bit 09 = reserved*          Bit 08 = reserved*          Bit 07 = reserved*          Bit 06 = reserved*          Bit 05 = reserved*          Bit 04 = reserved*          Bit 03 = reserved*          Bit 02 = reserved*          Bit 01 = reserved*          Bit 00 = reserved** REGIDY = Bit 15-8 = machine id byte*                  0 = Cortland*                  01-FF = future systems*          Bit 07 = 0*          Bit 06 = 0*          Bit 05 = 0*          Bit 04 = 0         Bits 00-07 = ROM version number*          Bit 03 = 0*          Bit 02 = 0*          Bit 01 = 0*          Bit 00 = 1   REGIDA		DC.W	$007F	;Register identification byteREGIDX		DC.W	$0000	;Register identification byteREGIDY		DC.W	$0003	;Register identification byte 		FillTo	$FB5B	;PadTABV		EQU	*	;Maintained entry point $FB5B		STA	CV	;VTABS TO ROW IN A-REG 		JMP	VTABAPPLEII		EQU	*	;Maintained entry point $FB60		JSR	HOME	;CLEAR THE SCRN 		LDY	#$A8	;'Y'=$A8 for Apple IIgs msg		BRA	NODISK1	;Continue this way	; SEG $FFMCOFFSET		EQU	*	;Mouse card offset to id bytes		DC.B	$05,$07,$0B,$FBMIDVALUE		EQU	*	;Mouse card id bytes		DC.B	$38,$18,$01,$D6	; SEG $00		FillTo	$FB6F	;PadSETPWRC		EQU	*	;Maintained entry point $FB6F		LDA	SOFTEV+1	;ROUTINE TO CALCULATE THE 'FUNNY  		EOR	#$A5	;COMPLEMENT' FOR THE RESET VECTOR 		STA	PWREDUP		RTS* CHECK FOR A PAUSE (CONTROL-S). VIDWAIT		EQU	*	;Maintained entry point $FB78		CMP	#$8D	;ONLY WHEN I HAVE A CR		BNE	NOWAIT	;NOT SO, DO REGULAR		LDY	KBD	;IS KEY PRESSED?		BPL	NOWAIT	;NO. 		CPY	#$93	;YES -- IS IT CTRL-S?		BNE	NOWAIT	;NOPE - IGNORE		BIT	KBDSTRB	;CLEAR STROBEKBDWAIT		EQU	*	;Maintained entry point $FB88		LDY	KBD	;WAIT TILL NEXT KEY TO RESUME		BPL	KBDWAIT	;WAIT FOR KEYPRESS		CPY	#$83	;IS IT CONTROL-C?		BEQ	NOWAIT	;YES, SO LEAVE IT		BIT	KBDSTRB	;CLR STROBENOWAIT		BRA	VIDOUT	;DO AS BEFOREESCNOW		TAY		;USE CHAR AS INDEX		LDA	XLTBL-$C9,Y	;TRANSLATE IJKM TO CBAD		JSR	ESCOLD	;DO THE CURSOR MOTION		JSR	RDESC	;GET IJKM, ijkm, ARROWSESCNEW		CMP	#$CE	;IS THIS AN 'N'? 		BCS	ESCOLD	;'N' OR GREATER - DO IT! 		CMP	#$C9	;LESS THAN 'I'?		BCC	ESCOLD	;YES, SO DO OLD WAY		CMP	#$CC	;IS IT AN 'L'?		BNE	ESCNOW	;GO DO ITESCOLD		EQU	*		CMP	#'8'	;Does user want to go to 80 column mode		SEC		;INSURE CARRY SET		BNE	ESC1_2	;<> = then do regular 'ESC' key tests		BRA	ESC1		FillTo	$FBB3	;PadVERSION		EQU	*	;Maintained entry point $FBB3		DC.B	$06	;FOR IDCHECKESC1		EQU	*		JSR	T480CARD2	;Test for 80 column card before enabling		BNE	ESC1_2	;<>= then do regular 'ESC' key tests		JSR	TSTCTL3	;		JMP	ESC1_1	;Continue this way		FillTo	$FBBF	;PadZIDBYTE2		EQU	*	;Maintained entry point $FBBF		DC.B	$00	;ROM rev ID byteZIDBYTE		EQU	*	;Maintained entry point $FBC0		DC.B	$E0	;//e ROM ID byte - MaintainedBASCALC		EQU	*	;Maintained entry point $FBC1		PHA		;CALC BASE ADDR IN BASL,H		LSR	A	;FOR GIVEN LINE NO.		AND	#$03	; 0<=LINE NO.<=$17		ORA	#$04	;ARG = 000ABCDE, GENERATE		STA	BASH	; BASH = 000001CD		PLA		; AND		AND	#$18	; BASL = EABAB000		BCC	@1		ADC	#$7F@1		STA	BASL		ASL	A		ASL	A		ORA	BASL	;Must do this way since some programs		STA	BASL	; depend on BASL being in 'A' on exit.		RTSCHKBELL		EQU	*		CMP	#$87	;BELL CHAR? (CONTROL-G) 		BNE	RTS3	; NO, RETURN. BELL1		EQU	*	;Maintained entry point $FBDD		LDY	#$9E	;'Y'=$9E for NEWBELL1 routine		BRA	GOTOFF	;Off to bank FF to execute		NOP		;Required for entry point alignmentBELL1_2		EQU	*	;Maintained entry point $FBE2		BRA	BELL1	;Skip behindBELL2		EQU	*	;Maintained entry point $FBE4		BRA	BELL1	;Skip behindDOPREAD4		EQU	*	;Entry here means time out the do PREAD		LDA	PADDL0,X	;Read paddle til value is '-'		BPL	DOPREAD4	;DOPREAD		EQU	*		LDY	#$95	;'Y'=$95 for new paddle read routine		BRA	GOTOFF	;(Save 'X' through PREAD routine)		FillTo	$FBF0	;PadSTORADV		EQU	*	;Maintained entry point $FBF0		LDY	CH	;CURSOR H INDEX TO Y-REG 		STA	(BASL),Y	;STORE CHAR IN LINE ADVANCE		EQU	*	;Maintained entry point $FBF4		INC	CH	;INCREMENT CURSOR H INDEX 		LDA	CH	; (MOVE RIGHT) 		CMP	WNDWDTH	;BEYOND WINDOW WIDTH? 		BCS	CR	; YES, CR TO NEXT LINE. RTS3		RTS		; NO, RETURN. VIDOUT		EQU	*	;Maintained entry point $FBFD		BRA	TSTFORCUR	;Test for new cursorVIDOUT2		EQU	*		BCS	STORADV	; NO, OUTPUT IT. 		TAY		;INVERSE VIDEO? 		BPL	STORADV	; YES, OUTPUT IT. 		CMP	#$8D	;CR? 		BEQ	CR	; YES. 		CMP	#$8A	;LINE FEED? 		BEQ	LF	; IF SO, DO IT. 		CMP	#$88	;BACK SPACE? (CONTROL-H) 		BNE	TSTCTL	;No then test for control-^BS		EQU	*	;Maintained entry point $FC10		PHY		;Save original 'Y'		LDY	#$9B	;Decrement all cursors		JSR	GOTOBANKFF	;Do it in bank FF		BMI	BS2	;Continue with BS this way		PLY		;Restore original 'Y' value		RTS		;Back to original callerUP		EQU	*	;Maintained entry point $FC1A		LDA	WNDTOP	;CURSOR V INDEX 		CMP	CV		BCS	RTS3	;IF TOP LINE THEN RETURN 		DEC	CV	;DECR CURSOR V INDEX VTAB		EQU	*	;Maintained entry point $FC22		LDA	CV	;GET CURSOR V INDEX VTABZ		EQU	*	;Maintained entry point $FC24		STA	BASL	;temporarily save Acc		TYA		;and Y		LDY	#$4	;this is VTABZ callGOTOFF		JMP	GOTOBANKFF	;=> always perform callESC1_2		EOR	#$C0	;ESC '@'? 		BEQ	HOME	; IF SO DO HOME AND CLEAR		ADC	#$FD	;ESC-A OR B CHECK		BCC	ADVANCE	; A, ADVANCE		BEQ	BS	; B, BACKSPACE		ADC	#$FD	;ESC-C OR D CHECK		BCC	LF	; C, DOWN		BEQ	UP	; D, GO UP 		ADC	#$FD	;ESC-E OR F CKECK		BCC	CLREOL	; E, CLEAR TO END OF LINE		BNE	RTS3	; ELSE NOT F,RETURNCLREOP		EQU	*	;Maintained entry point $FC42		LDY	#$A	;CODE=CLREOP		BNE	GOTOFF	;DO 40/80 NEWVW		BIT	RD80VID	;in 80 columns?		BPL	@1	;=>not 80 columns		LDY	#$0	;Print a character		BRA	GOTOFF	;through video firmware@1		TYA		;get masked character		PHA		;and set up for vidwait		JSR	VIDWAIT	;print the character		PLA		;restore Acc		LDY	YSAV1	;and Y		RTSHOME		EQU	*	;Maintained entry point $FC58		LDY	#5	;CODE=HOME		BRA	GOTOFF	;do 40/80TSTFORCUR		EQU	*		XBA		;Save 'A'		JMP	TSTFORCUR2	;Continue this way		FillTo	$FC62	;PadCR		EQU	*	;Maintained entry point $FC62		LDA	#$00	;CURSOR TO LEFT OF INDEX 		STA	CH	;(RET CURSOR H=0) LF		EQU	*	;Maintained entry point $FC66		INC	CV	;INCR CURSOR V. (DOWN 1 LINE) 		LDA	CV		CMP	WNDBTM	;OFF SCREEN? 		BCC	VTABZ	;  NO, SET BASE ADDR 		DEC	CV	;DECR CURSOR V. (BACK TO BOTTOM) SCROLL		EQU	*	;Maintained entry point $FC70		LDY	#6	;CODE=SCROLL		BRA	GOTOFF	;DO 40/80 DOCOUT1		BCC	@1	;don't mask controls		AND	INVFLG	;apply inverse mask@1		JMP	COUTZ1	;go back to COUT1BS2		EQU	*	;Continuation of BS routine		LDA	WNDWDTH	;'A' value for WDTHFF routine		LDY	#$9C	;'Y' = $9C for WDTHFF routine		JSR	GOTOBANKFF	;Go do it		PLY		;Recall original 'Y' value		BRA	UP	;Go to UP routine to continueTSTCTL		EQU	*	;Test for control-^ input		CMP	#$9E	;If control-^ then change cursor		BEQ	@1	;		JMP	CHKBELL	;If not control-^ then maybe bell?@1		EQU	*		LDA	#$81	;Set change cursor flag bit		BRA	TSTCTL4	;TSTCTL3		EQU	*		LDA	#$40	;Set change to 80 columns flagTSTCTL4		EQU	*		STA	>CHGCURFLG	;		RTS		;Back to caller with flag setINSDS1		EQU	*		LDY	#$97	;Y=$97 for XINSDS1 in bank FFGOTOFF2		EQU	*		BRA	GOTOFF	;Go do routine		FillTo	$FC9C	;Pad* Note: bytes CLREOL and CLREOLZ ($38 and $18)* are used by slot test in TSTROM.CLREOL		EQU	*	;Maintained entry point $FC9C		SEC		;say it is EOL		OPCODE	BCC	;CLREOLZ		EQU	*	;Maintained entry point $FC9E		CLC		;say it is EOLZ		STY	BAS2L	;save Y in temp		LDY	#7	;code=CLREOL		BCS	GOTOFF	;do it		INY		;code 8=CLREOLZ		BRA	GOTOFFWAIT		EQU	*	;Maintained entry point $FCA8		PHA		;Save wait value		LDA	CYAREG	;Switch to slow speed		XBA		;Save user speed in 'B'		LDA	#$80	;Reset bit 7 only		TRB	CYAREG	;Force slow speed		BRA	WAITNEW1	;Go do speed sensitive routine		FillTo	$FCB4	;PadNXTA4		EQU	*	;Maintained entry point $FCB4		INC	A4L	;INCR 2-BYTE A4 		BNE	NXTA1	; AND A1 		INC	A4HNXTA1		EQU	*	;Maintained entry point $FCBA		LDA	A1L	;INCR 2-BYTE A1. 		CMP	A2L	; AND COMPARE TO A2 		LDA	A1H	; (CARRY SET IF >=) 		SBC	A2H		INC	A1L		BNE	RTS4B		INC	A1HRTS4B		RTS		TITLE	'Auto-Start Monitor ROM'******************************************                                       **               APPLE II                **              MONITOR II               **                                       **    Copyright 1978, 1981, 1984-1989    **                   by                  **          Apple Computer, Inc.         **                                       **          All Rights Reserved          **                                       **       S. Wozniak             1977     **       A. Baum                1977     **       John A            Nov  1978     **       R. Auricchio      Sep  1981     **       E. Beernink            1984     **       E.K. Lai          Sep  1984     **       F. Bachman          1985-1987   **       Joe Bo              1988-1989   **                                       ******************************************HEADR		EQU	*	;Maintained entry point $FCC9		RTS		;Dummy routineUPMON		LDA	IN,Y	;get character		INY		;point to next char		CMP	#$E1	;is it lowercase?		BCC	@1	;=>nope		CMP	#$FB	;lowercase?		BCS	@1	;=>nope		AND	#$DF	;else upshift@1		RTSWAITNEW1		EQU	*		PLA		;Restore wait value		SEC		;Enter with count in A@1		EQU	*		PHA		;Delay is:@2		EQU	*		SBC	#$01	;		BNE	@2	;13+11*A+5*A*A		PLA		;@ 1.023 usec/cycle		SBC	#$01	;		BNE	@1	;		XBA		;Recall user speed/make 'B'=$00		STA	CYAREG	;Restore user speed		XBA		;WAIT always exits with 'A'=0/'c'=1		RTS		;Exit to callerTSTFORCUR2	EQU	*		LDA	>CHGCURFLG	;'-' then change cursor		ASL	A	;'c'=change cursor 'n'=go to 80 columns		BMI	TSTFORCUR4	;<>= then it's time to go to 80 columns		XBA		;New cursor		BCC	TSTFORCUR6	;		STA	>CURSOR	;TSTFORCUR3	EQU	*		LDA	#$01	;Reset change cursor flag		BRA	TSTCTL4	;Go reset itTSTFORCUR6	EQU	*		CMP	#$A0	;Test against space for control characters		JMP	VIDOUT2	;Back to normal routines		FillTo	$FD02	;PadRDESC		EQU	*		JSR	RDKEY	;GET A KEY		LDY	#1	;CODE=FIXITTOGOTOFF2		EQU	*		BRA	GOTOFF2	;=>always * Flag to the video firmware that escapes are allowed.* This routine is called by RDCHAR which is called by * GETLN.  The high bit of MSLOT is set by all cards  * that use the C800 space.       NEWRDKEY		LSR	MSLOT	;<128 means escape allowedRDKEY		EQU	*	;Maintained entry point $FD0C		LDY	#$B	;Display old Apple ][ inverse cursor		BNE	RDKEY0	;NEVER change this callFD10		EQU	*	;Maintained entry point $FD10		BRA	RDKEY1	;Input via input hooksTSTFORCUR4	EQU	*		LDY	#$A2	;'Y'=$A2 to enter 80 columns		BRA	GOTOFF2	;Do it in bank FF		FillTo	$FD18	;PadRDKEY1		EQU	*	;Maintained entry point $FD18		JMP	(KSWL)	;Input via input hooksKEYIN		EQU	*	;Maintained entry point $FD1B		LDY	#3	;RDKEY 		BRA	TOGOTOFF2	;RDKEY0		EQU	*		JSR	GOTOBANKFF	;Go to it		BRA	FD10	;Continue through input hooksNOTCR2		EQU	*		JSR	NOTCR3	;Go test for ignore character or not		BCS	NXTCHAR	;If 'c'=1 then ignore key pressed		CMP	#$88	;Test for backspace		BRA	NOTCR4	;		FillTo	$FD2F	;PadESC		JSR	RDESC	;		JSR	ESCNEW	;HANDLE ESC FUNCTION. RDCHAR		EQU	*	;Maintained entry point $FD35		JSR	NEWRDKEY	;Flag RDCHAR and read key 		CMP	#$9B	;'ESC'? 		BEQ	ESC	;  YES, DON'T RETURN. 		RTS* Go to user interrupt handler(s).GOIRQ~Bnk00	EQU	*-Rel~Org+Bnk~Org		JMP	(IRQLOC)	;and jump to userPICKFIX		LDY	#$D	;code = fixpick		JSR	GOTOBANKFF	;do 80 column pick		LDY	CH	;restore Y		STA	IN,X	;and save new characterNOTCR		EQU	*		JSR	COUT	;echo typed char		LDA	IN,X		BRA	NOTCR2	;Check for cursor change indicatorNOTCR4		EQU	*		BEQ	BCKSPC	;  - BACKSPACE 		CMP	#$98		BEQ	@2	;  - CONTROL-X 		CPX	#$F8		BCC	@1	;MARGIN? 		JSR	BELL	; YES, SOUND BELL @1		INX		;ADVANCE INPUT INDEX 		BNE	NXTCHAR@2		LDA	#$DC	;BACKSLASH AFTER CANCELLED LINE 		JSR	COUTGETLNZ		EQU	*	;Maintained entry point $FD67		JSR	CROUT	;Output carriage returnGETLN		EQU	*	;Maintained entry point $FD6A		LDA	PROMPT	;Output prompt characterGETLN0		EQU	*	;Maintained entry point $FD6C		JSR	COUT	;Output accumulator contents as prompt chrGETLN1		EQU	*	;Maintained entry point $FD6F		LDX	#$01	;INIT INPUT INDEX BCKSPC		TXA		BEQ	GETLNZ	;WILL BACKSPACE TO 0 		DEXNXTCHAR		JSR	RDCHAR		CMP	#$95	;USE SCREEN CHAR		BNE	@1	; FOR CONTROL-U		LDA	(BASL),Y	;do 40 column pick		BIT	RD80VID	;80 columns?		BMI	PICKFIX	;=>yes, fix it		NOP		;Required filler@1		EQU	*		JSR	TESTDEL	;Test for delete then add to input buffer 		CMP	#$8D		BNE	NOTCRCROUT1		EQU	*	;Maintained entry point $FD8B		JSR	CLREOL	;CLR TO EOL IF CR CROUT		EQU	*	;Maintained entry point $FD8E		LDA	#$8D	;Output a carriage return		BRA	COUT	;PRA1		EQU	*	;Maintained entry point $FD92		LDY	A1H	;PRINT CR,A1 IN HEX 		LDX	A1L		JSR	CROUTXPRADDR		JSR	PRNTYX		LDY	#$00		LDA	#':'	;PRINT ':' 		BRA	COUTXAM8		JSR	DSPCOUNT		ORA	A1L		STA	A2L	; MOD 8=7 		LDA	A1H		STA	A2HXAM		EQU	*		JMP	TONEWRTNS	;Off to new routine entry pointsXAMPM		EQU	*	;DETERMINE IF MONITOR MODE IS 		PHA		;Set/clear 'z'		PLA		;		BEQ	XAM	;= then doing carriage return		CMP	#'.'	;Examine mode?		BEQ	XAM	; EXAMINE, ADD OR SUBTRACT  		PHY		;Preserve 'Y' around call		LDY	#$A1	;'Y'=$A1 for math calls		JMP	GETLENGTH2	;Do routine+restore 'Y' and returnTESTDEL		EQU	*	;Test for delete/backspace key pressed		CMP	#$FF	;$FF= delete/backspace key		BNE	@2	;<>= delete or backspace		XBA		;Save 'A' in case we must use it		LDA	>CHGCURFLG	;If changing cursor do NOT change del char		ASL	A	;Set/clear 'c'		XBA		;Restore 'A'		BCC	@1	;		BIT	RD80VID	;If 80 columns on then convert $FF to $00		BPL	@2	;'+' then 40 columns		INC	A	;Increment $FF to $00 if in 80 columns@1		EQU	*		AND	#$88	;Convert $FF to $88 (delete to left arrow)@2		EQU	*		STA	IN,X	;Save in input buffer		RTS		;Back to callerTONEWVW		JMP	NEWVW	;new entry to vidwait		FillTo	$FDDA	;PadPRBYTE		EQU	*	;Maintained entry point $FDDA		PHA		;PRINT BYTE AS 2 HEX DIGITS 		LSR	A	; (DESTROYS A-REG) 		LSR	A		LSR	A		LSR	A		JSR	PRHEXZ		PLAPRHEX		EQU	*	;Maintained entry point $FDE3		AND	#$0F	;PRINT HEX DIGIT IN A-REG PRHEXZ		ORA	#$B0	;LSBITS ONLY. 		CMP	#$BA		BCC	COUT		ADC	#$06COUT		EQU	*	;Maintained entry point $FDED		JMP	(CSWL)	;Output via output hooksCOUT1		EQU	*	;Maintained entry point $FDF0		PHA		;save original character		CMP	#$A0	;is it a control?		JMP	DOCOUT1	;=>mask if not; return to COUTZ1COUTZ		EQU	*	;Maintained entry point $FDF6		PHA		;save original characterCOUTZ1		STY	YSAV1	;save Y		TAY		;save masked character		PLA		;get original char		BRA	TONEWVW	;new entry to vidwaitBL1		DEC	YSAV		BEQ	XAM8BLANK		DEX		;BLANK TO MON 		BNE	SETMDZ	;AFTER BLANK 		CMP	#':'	;DATA STORE MODE? 		BNE	XAMPM	; NO; XAM, ADD, OR SUBTRACT. 		JMP	STOR	;= then user wants to do a storeSETMODE		LDY	YSAV	;SAVE CONVERTED ':','+','*','_'		LDA	IN-1,Y	; '-', '.' AS MONMODE SETMDZ		STA	MONMODE		RTSUSR		EQU	*		CLC		;Switch to native mode for long jmp		XCE		;		JMP	>CTRLYVECTOR	;If no routine hooked in then returnUSR2~Bnk00	EQU	*-Rel~Org+Bnk~Org	;Returns here if no routine		SEC		;Switch to emulation mode		XCE		;		JMP	USRADR	;JUMP TO CONTROL-Y VECTOR IN RAM 		FillTo	$FE1F	;Pad		TITLE	'Auto-Start Monitor ROM'******************************************                                       **               APPLE II                **              MONITOR II               **                                       **    Copyright 1978, 1981, 1984-1989    **                   by                  **          Apple Computer, Inc.         **                                       **          All Rights Reserved          **                                       **       S. Wozniak             1977     **       A. Baum                1977     **       John A            Nov  1978     **       R. Auricchio      Sep  1981     **       E. Beernink            1984     **       E.K. Lai          Sep  1984     **       F. Bachman          1985-1987   **       Joe Bo              1988-1989   **                                       ******************************************IDROUTINE		EQU	*		LDA	REGIDA	;Register identification for 'A'		LDX	REGIDX	;Register identification for 'X'		LDY	REGIDY	;Register identification for 'Y'		CLC		;'C'=0 means this in not a //e or //c		RTS		;Back to caller		FillTo	$FE2C	;PadMOVE		EQU	*	;Maintained entry point $FE2C		LDA	(A1L),Y	;MOVE (A1) THRU (A2) TO (A4) 		STA	(A4L),Y		JSR	NXTA4		BCC	MOVE		RTSNEWRESET		EQU	*	;Dummy up int stack pointers		CLC		;Switch to native mode for JSL		XCE		;		JSL	>SPELRESET	;Special power up reset		SEC		;Switch back to emulation mode		XCE		;		LDY	#$A3	;'Y'=$A3 for setting up BATTERYRAM stuff		JSR	GOTOBANKFF	;SETVIDKBD		EQU	*	;Set up 40 column video and keyboard		JSR	SETNORM	;Set normal character output		JSR	INIT	;Set up some parameters		JSR	SETVID	;Set video as output		BRA	SETKBD	;Set keyboard as inputGOTXT1		EQU	*	;Go to Text page 1;LDA #$80 ;No super hi res screen;TRB NEWVIDEO ;;LDA TXTSET ;Enable text;LDA MIXCLR ;Clear mixed mode;STZ WNDTOP ;Reset top of window;BRA GOTXT2 ;Continue this way		LDY	#$A9		JMP	GOTOBANKFFGOTXT11		EQU	*		LDY	#$AA		JMP	GOTOBANKFF		FillTo	$FE5E	;PadVFY		EQU	*	;Maintained entry point $FE5E		LDY	#$83	;Do new verify in bank FF		BRA	TONEWRTNS2	;Go to itA1PC		TXA		;IF USER SPECIFIED AN ADDRESS, 		BEQ	@2	; COPY IT FROM A1 TO PC. @1		LDA	A1L,X	;YEP, SO COPY IT. 		STA	PCL,X		DEX		BPL	@1@2		RTSTONEWRTNS		EQU	*		PHA		;Preserve 'A'		TYA		;Convert $0Y to $8Y		ORA	#$80	;		TAY		;		PLA		;Restore 'A'TONEWRTNS2	EQU	*		BRA	IOPRT2	;Off to routine* Determine whether to display 8 or 16 bytesDSPCOUNT		EQU	*		LDA	WNDWDTH	;How many columns?		CMP	#72	;> or = to 72 columns		LDA	#$0F	;Anticipate 16 fields of data to display		BCS	@1	;'c' from CMP above		LDA	#$07	;'c'=0 then display 8 fields of data only@1		EQU	*		RTS		;Back to caller		FillTo	$FE80	;PadSETINV		EQU	*	;Maintained entry point $FE80		LDY	#$3F	;SET FOR INVERSE VID 		BNE	SETIFLG	; VIA COUT1 SETNORM		EQU	*	;Maintained entry point $FE84		LDY	#$FF	;SET FOR NORMAL VID SETIFLG		STY	INVFLG		RTSSETKBD		EQU	*	;Maintained entry point $FE89		LDA	#$00	;DO 'IN#0'INPORT		EQU	*	;Maintained entry point $FE8B		STA	A2L	;DO 'IN#AREG' INPRT		LDX	#KSWL		LDY	#KEYIN		BNE	IOPRTSETVID		EQU	*	;Maintained entry point $FE93		LDA	#$00	;DO 'PR#0' OUTPORT		EQU	*	;Maintained entry point $FE95		STA	A2L	;DO 'PR#AREG' OUTPRT		LDX	#CSWL		LDY	#COUT1IOPRT		LDA	A2L	;SET INPUT/OUTPUT VECTORS		AND	#$0F		BEQ	@1		ORA	#>IOADR		LDY	#$00@1		STY	LOC0,X	;save low byte of hook		STA	LOC1,X	;save acc 		LDY	#$E	;code=PR#/IN#IOPRT2		BRA	GOTOFF4	; branch alwaysBASCONT		JMP	BASIC2	;TO BASIC, WARM START GOTXT2		EQU	*		LDA	TXTPAGE1	;Enable text page 1		RTS		;Back to callerMONDSKACC		EQU	*	;Enable the monitor desk accessory		BRA	MONDSKACC2	;Must have entry point in $FExx 		FillTo	$FEB6	;PadGO		EQU	*	;Maintained entry point $FEB6		JSR	A1PC	;Address to PC if specified		JSR	RESTORE	;Restore fake registers		JMP	(PCL)	; and execute routine.QUITMON		EQU	*		LDA	OSWMSTRT	;Test if JMP opcode installed		CMP	#$4C	;JMP opcode		BEQ	@1	;= then restart operating system		RTS		;Back to monitor@1		EQU	*		JMP	OSWMSTRT	;Warmstart operating systemNEWREGZ		EQU	*		JMP	REGDSP	;Go do new register display		FillTo	$FECD	;PadWRITE		EQU	*	;Maintained entry point $FECD		RTS		;Dummy routineMAKENATIVE	INY		;'Y' = $91 for default 'm'/'x'/'e' = 0UTILITY		INY		;'Y' = $90 for utility call to ToolsX816		INY		;'Y' = $8F for execute JSL subroutineGO816		INY		;'Y' = $8E for go JSR subroutineLITASC		INY		;'Y' = $8D for literal ASCII input modeCMDZAP		INY		;'Y' = $8C for Zap memory commandPTRNSET		INY		;'Y' = $8B for set pattern for searchLIST		INY		;'Y' = $8A for listEQUALS		INY		;'Y' = $89 for equalsRESUME		INY		;'Y' = $88 for new resumeSTEP		INY		;'Y' = $87 for stepTRACE		INY		;'Y' = $86 for traceSTOR		INY		;'Y' = $85 for storeMINI		INY		;'Y' = $84 for miniassemblerXVERIFY		INY		;'Y' = $83 for verifyXMOVE		INY		;'Y' = $82 for moveSEARCH		INY		;'Y' = $81 for pattern search		BRA	TONEWRTNS	;Continue this wayREGSET		EQU	*	;Sets up registers for monitor entry		LDY	#$96	;'Y'=$96 for register setup for monitorGOTOFF4		JMP	GOTOBANKFF	;perform callNEWFIXSEV		EQU	*		STY	SOFTEV		JSR	WARMUPAPTALK	;Enable DATAREG ints for desk acc mgrXBASIC		JMP	BASIC	;TO BASIC, COLD START ESC1_1		EQU	*		PLA		;Remove 1 RTS from stack		PLA		;		LDA	#$98	;Cancel the line with control-X		JMP	COUT	;Causes shift to 80 columnsCRMON		JSR	BL1	;HANDLE CR AS BLANK 		PLA		; THEN POP STACK 		PLA		; AND RETURN TO MON 		BRA	MONZ2	;Exit to monitor		FillTo	$FEFD	;PadREAD		EQU	*	;Maintained entry point $FEFD		RTS		;Dummy routineLT		LDA	>BANKS		STA	>BANKD		LDX	#$01@1		LDA	A2L,X	;COPY A2 (2 BYTES) TO  		STA	A4L,X	; A4 AND A5 		DEX		BPL	@1		RTSMONDSKACC2	EQU	*	;Enable the monitor desk accessory		INY		;'Y' = $92 for install monitor desk acc		BRA	MAKENATIVE	;Continue in regular loop		FillTo	$FF13	;Pad* NNBL gets the next non-blank for the mini-assemblerNNBL		JSR	UPMON	;get char, upshift, INY		CMP	#$A0	;is it blank?		BEQ	NNBL	;yes, keep looking		RTSLOOKASC		BCS	DIG	;it was a digit		CMP	#$A0	;check for quote (')		BNE	RTS6	;nope, return char		LDA	IN,Y	;else get next char		LDX	#7	;for shifting asc into A2L and A2H		CMP	#$8D	;was it CR?		BEQ	GETNUM	;yes, go handle CR		INY		;advance index		BNE	NXTBIT	;=>(always) into A2L and A2H		FillTo	$FF2D	;PadPRERR		EQU	*	;Maintained entry point $FF2D		LDA	#$C5	;Print 'ERR', then fall into beeper.		JSR	COUT	;		LDA	#$D2		JSR	COUT		JSR	COUTBELL		EQU	*	;Maintained entry point $FF3A		LDA	#$87	;MAKE A JOYFUL NOISE, THEN RETURN. 		JMP	COUTRESTORE		EQU	*	;Maintained entry point $FF3F		LDA	STATUS	;RESTORE 6502 REGISTER CONTENTS 		PHA		;		LDA	A5H		LDX	XREG	;Was label RESTR1		LDY	YREG		PLPRTS6		RTSSAVE		EQU	*	;Maintained entry point $FF4A		STA	A5H	;SAVE 6502 REGISTER CONTENTS SAV1		STX	XREG	;		STY	YREG		PHP		PLA		STA	STATUS		TSX		STX	SPNT		CLDIORTS		EQU	*	;Maintained entry point $FF58		RTSOLDRST		EQU	*	;Maintained entry point $FF59		JSR	SETVIDKBD	;Init keyboard and video		BRA	MON	;Skip fill bufferSETPRMPT		EQU	*	;Set up monitor prompt		LDA	#$AA	;'*' PROMPT FOR MONITOR 		STA	PROMPT		JMP	GETLNZ	;Exit by getting a line of input		FillTo	$FF65	;PadMON		EQU	*	;Maintained entry point $FF65		CLD		;MUST SET HEX MODE! 		JMP	OLDBRK2	;Beep the speaker/skip REGSET* Enter here for normal monitor mode.* All registers/modes set up to default on entry here.MONZ		EQU	*	;Maintained entry point $FF69		JSR	REGSET	;Set up registers* Enter here for last monitor mode.* All registers/modes same as last time user exited monitor.MONZ2		EQU	*	;Maintained entry point $FF6C		NOP		;Required filler to make entry pnts match		JSR	SETPRMPT	;Set up prompt char/read an input lineMONZ4		EQU	*	;Maintained entry point $FF70		JSR	ZMODEYSAV	;Clear monitor mode, scan idx, YSAVNXTITM		EQU	*	;Get next item, non-HEX		JSR	GONEWGETNUM	;Use new getnum routine		STY	YSAV		LDY	#CHRTBLLEN+1	; X-REG=0 IF NO HEX INPUT @1		DEY		;Character search loop		BMI	MON	;COMMAND NOT FOUND, BEEP & TRY AGAIN. 		CMP	CHRTBL,Y	;FIND COMMAND CHAR IN TABLE 		BNE	@1	;NOT THIS TIME 		JSR	TOSUB	;GOT IT! CALL CORRESPONDING SUBROUTINE 		LDY	YSAV	;PROCESS NEXT ENTRY ON HIS LINE 		JMP	NXTITM	;JMP for code alignmentDIG		EQU	*	;Maintained entry point $FF8A		LDX	#$03		ASL	A		ASL	A	;GOT HEX DIGIT, 		ASL	A	; SHIFT INTO A2 		ASL	ANXTBIT		ASL	A	;Shift in next bit loop		ROL	A2L		ROL	A2H		DEX		;LEAVE X=$FF IF DIG 		BPL	NXTBIT@2		LDA	MONMODE		BNE	@3	;IF MODE IS ZERO, 		LDA	A2H,X	; THEN COPY A2 TO A1 AND A3 		STA	A1H,X		STA	A3H,X@3		INX		BEQ	@2		BNE	NXTCHRGETNUM		EQU	*	;Maintained entry point $FFA7		LDX	#$00	;CLEAR A2 		STX	A2L		STX	A2HNXTCHR		EQU	*	;Maintained entry point $FFAD		JSR	UPMON	;get char, upshift, INY		NOP		;REQUIRED filler for compatibility		EOR	#$B0		CMP	#$0A		BCC	DIG	;BR IF HEX DIGIT 		ADC	#$88		CMP	#$FA		JMP	LOOKASC	;check for ASCII input		FillTo	$FFBE	;PadTOSUB		EQU	*	;Maintained entry point $FFBE		LDA	#>GO	;DISPATCH TO SUBROUTINE, BY 		PHA		; PUSHING THE HI-ORDER SUBR ADDR, 		LDA	SUBTBL,Y	; THEN THE LO-ORDER SUBR ADDR 		PHA		; ONTO THE STACK, 		LDA	MONMODE	; (CLEARING THE MONMODE, SAVE THE OLD ZMODE		EQU	*	;Maintained entry point $FFC7		LDY	#$00	; MONMODE IN A-REG), 		STY	MONMODEPRODOSRTS		EQU	*	;Maintained entry point $FFCB		RTS		; AND 'RTS' TO THE SUBROUTINE! GETLENGTH		EQU	*	;Preset 'Y' to 00		LDY	#$00		BRA	TOGETLENGTH		FillTo	$FFD0	;PadDOSEF		EQU	*	;Maintained entry point $FFD0		DC.B	$EF	;V   (MEMORY VERIFY) ZMODEYSAV		EQU	*		STZ	YSAV	;Must zero entry point into the input		JSR	ZMODE	; buffer and zero out monitor mode.FIXSPEED		EQU	*		LDA	CYAREG	;Be sure system speed is correct		AND	#$7F	;Reset hi bit in case 'slow' (Yuk!) speedFIXSPEED2		EQU	*		ORA	>SYSTEMSPD	; as per user instructions.		STA	CYAREG	;		RTS		;Back to caller		FillTo	$FFE4	;PadNCOP		EQU	*	;Maintained entry point $FFE4		DC.W	TONCOP	;Native COP interrupt vectorNBREAK		EQU	*	;Maintained entry point $FFE6		DC.W	TONBREAK	;Native break interrupt vectorNABORT		EQU	*	;Maintained entry point $FFE8		DC.W	TONABORT	;Native abort interrupt vectorNNMI		EQU	*	;Maintained entry point $FFEA		DC.W	NMI	;Native non-maskable interrupt vector		DC.B	$E6,$E2	;RequiredNIRQ		EQU	*	;Maintained entry point $FFEE		DC.W	TONIRQ	;Native IRQ interrupt vectorTOGETLENGTH	EQU	*		JMP	GETLENGTH1	;Continue with normal code		DC.B	0	;Required fillerECOP		EQU	*	;Maintained entry point $FFF4		DC.W	TOECOP	;Emulation COP interrupt vectorCHKSUMTWEAK	EQU	*		DC.W	$0000	;Modify to make bank FE/FF checksum=$1234EABORT		EQU	*	;Maintained entry point $FFF8		DC.W	TOEABORT	;Emulation abort interrupt vectorENMI		EQU	*	;Maintained entry point $FFFA		DC.W	NMI	;Emulation non-maskable interrupt vectorERESET		EQU	*	;Maintained entry point $FFFC		DC.W	RESET	;Reset vector  EBRKIRQ		EQU	*	;Maintained entry point $FFFE**********************************************************************; AsmIIgs generates an ERROR if you assemble the last byte of the address space; and thus "wrap" the address space from $FF/FFFF to $00/0000 and this error ; prevents the generation of the output object file!!!! ; THIS IS A BUG!!!!!!**********************************************************************; See the silly 1 word PROC that follows!;		DC.W	TOEBRKIRQ	;Emulation break/IRQ interrupt vector**********************************************************************