		TITLE	'Miscellaneous Tables/Messages';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 5:7:41 PM*******************************************************                                                    **              Copyright Notices + Etc.              **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ******************************************************** Apple Computer, Inc. copyright notice.** Pointers to SPLASHx appear in CP.TABLES1 and CP.TABLES2.* Those files MUST be updated if new lines are added.SPLASH1		EQU	*		DC.B	15,SPACE	;Centers lineNEWTITLE		EQU	*		DC.B	'Twain ->01'*** Restore this later as needed	DC.B	'Apple IIgs'NEWTITLELEN	EQU	*-NEWTITLE	;Length of titleCNEWTITLE		EQU	NEWTITLELEN/2	;Needed for centering		DC.B	TERMINATORSPLASH2		EQU	*		DCI	'Copyright Apple Computer, Inc. 1977-1991'SPLASH3		EQU	*	;Spare position		DC.B	13,SPACE	;Do not show this line		DC.B	'Under struct''n'		DC.B	TERMINATORSPLASH4		EQU	*	;Spare position		DC.B	13,SPACE	;Do not show this line		DC.B	'by John Arkley'		DC.B	TERMINATORSPLASH5		EQU	*		DC.B	10,SPACE	;Centers line		DC.B	'All Rights Reserved.'		DC.B	TERMINATORSPLASH6		EQU	*		DC.B	13,SPACE	;Centers line		DC.B	'ROM Version '		DC.B	TERMINATORSPLASHVERT	EQU	*	;Vertical position of splash screen msgs		DC.B	$00	;'Apple IIgs' vertical position		DC.B	$13	;'Copyright ...' vertical position		DC.B	$15	;Spare vertical position		DC.B	$16	;Spare vertical position		DC.B	$14	;'All Rights...' vertical position		DC.B	$17	;'ROM ...' vertical positionSPLASHCNT		EQU	*-SPLASHVERT	;Number of lines to displaySPLASH		EQU	*		JSR	RAMVCTRS2	;Set up all E1 RAM vectors		LDX	#$00	;Start with first line@1		EQU	*		REP	#$20	;		LONGA	ON		;		CLC		;Clear carry to add		PHB		;Change data bank register to read data		PHK		;		PLB		;		LDY	SPLASHVERT,X	;Get vertical screen postion in 'Y'		PLB		;Restore data bank register		TXA		;Create display message number		ADC	#SPLASHMSG	;Add base number to offset		PHX		;Preserve index around call		PHA		;Save 'A' before switch to 8 bit 'm'		SEP	#$30	;Call requires 8 bit mode		JSR	FIXVTAB0X	;Position on 40/80 columns screen		REP	#$30	;Must be 16 bit 'm'/'x' for next call		PLA		;Recall 'A'		JSR	PRINTMSG2	;Print line via 16 bit entry to PRINTMSG		PLX		;Recall index		INX		;Next message number		CPX	#SPLASHCNT	;Stop when all lines are displayed		BCC	@1	;Loop if not done		SEP	#$30	;Back to monitor mode		JSR	PR1BLNKFF	;Keep as centered as possible {MSA 4/13/89}		LDA	REGIDY	;Get 8 bit version number; 	JMP PRBYTEFF 	;added temporarily 6/7/91 JOA		JMP	PRHEXFF	;Just a single digit {MSA 4/13/89}APPLEIIGSMSG	EQU	*		PHX		;Maintain compatibility from $00fb60 call		LDX	#NEWTITLELEN	;Length of titleSTITLE		EQU	*		LDA	>NEWTITLE-1,X	;Get a character		STA	>LINE1+19-CNEWTITLE,X	;Put it at top center of screen		DEX		BNE	STITLE		PLX		;Restore 'X'		RTS		LONGA	OFF		EJECT	; SEG $FFINTVTBL0		EQU	*		DC.B	$5C	;Long jump		DC.A	MEMMOVER	;Address of memory mover		DC.B	$5C	;Long jump		DC.A	SETSPEED	;Addr of set system speed		DC.B	$5C	;Long jump		DC.A	SLOTARBITER	;Address of slot arbiter		DC.B	$5C	;Long jump		DC.A	SERBASPATCH	;Address of serial code BASIC patch		DC.B	$5C	;Long jump		DC.A	SERPASPATCH	;Address of serial code PASCAL patch		DC.B	$5C	;Long jump		DC.A	SEREXTPATCH	;Address of serial code EXTERNAL patch		DC.B	$5C	;Long jump		DC.A	SECRTL	;Address of hardware independent int, not done !		DC.B	$5C	;Long jump		DC.A	SECRTL	;Address of IRQ_MIDI, default to SEC/RTL* ;; Add new vectors hereINTVTBLEN0	EQU	*-INTVTBL0INTVTBL1		EQU	*		DC.B	$5C	;Long jump		DC.A	INTHNDLR	;Address of interrupt handler		DC.B	$5C	;Long jump		DC.A	UCOPHNDLR	;Address of unknown COP handler		DC.B	$5C	;Long jump		DC.A	UABORTHNDLR	;Address of unknown abort handler		DC.B	$5C	;Long jump		DC.A	SYSDEATH	;Address of system death handlerINTVTBLLEN	EQU	*-INTVTBL1INTVTBL2		EQU	*		DC.B	$5C	;Long jump		DC.A	WRITEBR	;Addr of write BATTERYRAM routine		DC.B	$5C	;Long jump		DC.A	READBR	;Addr of read BATTERYRAM routine		DC.B	$5C	;Long jump		DC.A	WRITETIME	;Addr of write time routine		DC.B	$5C	;Long jump		DC.A	READTIME	;Addr of read time routine		DC.B	$5C	;Long jump		DC.A	CTRL_PANEL	;Addr of Control Panel routine		DC.B	$5C	;Long jump		DC.A	USERSETUP	;Addr of rtne to setup user parameters		DC.B	$5C	;Long jump		DC.A	PRINTMSG8	;Addr of print msg rtn (8 bit) and RTL		DC.B	$5C	;Long jump		DC.A	PRINTMSG16	;Addr of print msg rtn (16 bit) and RTL		DC.B	$5C	;Long jump		DC.A	USR2~Bnk00	;Addr back to monitor from CTRL-Y rtne		DC.B	$5C	;Long jump		DC.A	TEXTPG2DA	;Addr back to text page 2 desk accessoryINTVTBLLEN2	EQU	*-INTVTBL2		LONGA	OFF		EJECT	; SEG $00		PRINT	PUSH		PRINT	OFFN2A		EQU	*		DC.B	0,SPACE		DC.B	'Project Management'		DC.B	2,SPACE		DC.B	'Hardware'		DC.B	CRRETURN	;Next line		DC.B	4,SPACE		DC.B	'Josef Friedman'		DC.B	6,SPACE		DC.B	'Larry Thompson'		DC.B	CRRETURN	;Next line		DC.B	4,SPACE		DC.B	'Fern Bachman,Jr.'		DC.B	4,SPACE		DC.B	'Dan Hillman'		DC.B	CRRETURN	;Next line		DC.B	4,SPACE		DC.B	'Anne Bachtold'		DC.B	7,SPACE		DC.B	'Ray Jaafari'		DC.B	CRRETURN	;Next line		DC.B	4,SPACE		DC.B	'Jane Jacobson'		DC.B	7,SPACE		DC.B	'Gary Knutson'		DC.B	CRRETURN	;Next line		DC.B	4,SPACE		DC.B	'Harvey Lehtman'		DC.B	6,SPACE		DC.B	'John MacPhee'		DC.B	CRRETURN	;Next line		DC.B	4,SPACE		DC.B	'D. Dresbach'		DC.B	9,SPACE		DC.B	'Rob Moore'		DC.B	CRRETURN		DC.B	4,SPACE		DC.B	'L. Kurihara'		DC.B	9,SPACE		DC.B	'Jay Rickard'		DC.B	CRRETURN	;Next line		DC.B	24,SPACE		DC.B	'Todd Rudin'		DC.B	TERMINATORNLN		EQU	*-N2AN1A		EQU	*		DC.B	MOUSEIND	;Start from 1st column		DC.B	'Firmware'		DC.B	8,SPACE		DC.B	'Tools'		DC.B	8,SPACE		DC.B	'Diagnostics'		DC.B	SPACE	;Next line and space in one byte		DC.B	'Michael Askins'		DC.B	2,SPACE		DC.B	'Steven Glass'		DC.B	1,SPACE		DC.B	'B.S. Soh'		DC.B	CRRETURN,SPACE	;Next line and space in one byte		DC.B	'Gus Andrade'		DC.B	5,SPACE		DC.B	'Eagle Berns'		DC.B	2,SPACE		DC.B	'Randy Carr';DFB CRRETURN,SPACE ;Next line and space in one byte		DC.B	SPACE	;Next line and space in one byte		DC.B	'John Arkley'		DC.B	5,SPACE		DC.B	'Art Cabral'		DC.B	3,SPACE		DC.B	'Karl Grabe'		DC.B	SPACE	;Next line and space in one byte		DC.B	'C.K. Bo (Joe)'		DC.B	3,SPACE		DC.B	'Matt Denman'		DC.B	2,SPACE		DC.B	'J Reynolds'		DC.B	SPACE	;Next line and space in one byte		DC.B	'Peter Baum'		DC.B	6,SPACE		DC.B	'Sue Dumont'		DC.B	CRRETURN,SPACE	;Next line and space in one byte		DC.B	'Rob Turner   '		DC.B	3,SPACE		DC.B	'Cheryl Ewy'		DC.B	CRRETURN,SPACE	;next line and space in one byte		DC.B	'Laura Drittler'		DC.B	2,SPACE		DC.B	'Dave Good'		DC.B	CRRETURN,SPACE	;Next line and space in one byte 		DC.B	'Tim Harrington'		DC.B	2,SPACE		DC.B	'Kenton Hanson'		DC.B	CRRETURN,SPACE	;Next line and space in one byte		DC.B	'Ed Lai'		DC.B	10,SPACE		DC.B	'Suki Lee'		DC.B	CRRETURN,SPACE	;Next line and space in one byte		DC.B	'Ray Montagne'		DC.B	4,SPACE		DC.B	'Clayton Lewis'		DC.B	CRRETURN,SPACE	;Next line and space in one byte		DC.B	'Peter Richert'		DC.B	3,SPACE		DC.B	'Bennet Marks'		DC.B	CRRETURN,SPACE	;Next line and space in one byte		DC.B	'Greg Seitz'		DC.B	6,SPACE		DC.B	'Andy Stadler  '		DC.B	CRRETURN,SPACE	;Next line and space in one byte		DC.B	'Rich Williams'		DC.B	3,SPACE		DC.B	'Mensch'		DC.B	CRRETURN	;Next line 		DC.B	17,SPACE		DC.B	'Dan Oliver'		DC.B	CRRETURN	;Next line 		DC.B	17,SPACE		DC.B	'Konstantin Othmer'		DC.B	CRRETURN	;Next line 		DC.B	17,SPACE		DC.B	'Owen Rubin'		DC.B	CRRETURN	;Next line		DC.B	17,SPACE		DC.B	'Harry Yee'		DC.B	TERMINATORNLN2		EQU	*-N1A		PRINT	POP