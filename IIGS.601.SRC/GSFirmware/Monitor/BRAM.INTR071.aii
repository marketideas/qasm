		TITLE	'BATTERYRAM/Clock Chip Rtnes';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 7:18:34 PM*******************************************************                                                    **              BATTERYRAM/Clock Routines             **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ******************************************************** The INITCLOCK code guarantees that the clock* chip is not in test mode and that it is write* enabled.  Doing this does not alter the data* in the clock chip and therefore it is performed* on every coldstart of the system.	; SEG $FFINITCLOCK		EQU	*	; SEG $00		LDA	#$37	;Write protect address		LDY	#$55	;Reset write protect register		JSR	WRITE1BYTE	;Send byte to clock chip		LDA	#$31	;Test mode address		LDY	#$00	;Disable test mode		JSR	WRITE1BYTE	;Send byte to clock chip		RTL		;Make callable from anywhere with JSL* WRITESTD puts Apple standard parameters into* the buffer BRAMBUFFER and then writes this data* to the clock chips memory BATTERYRAM.	; SEG $FFWRITESTD		EQU	*	; SEG $00		PHP		;Preserve interrupt status		SEI		;		PHB		;Save current data bank		JSR	DBTOE1	;Switch to bank $e1		LDX	#$00	;Start with 1st byte to move to buffer@1		EQU	*		LDA	>CPDEFTBL,X	;Default parameter		STA	|BRAMBUFFER,X	;Put in buffer		INX		;Next please		CPX	#CPDTBLLN	;Test against max		BCC	@1	;Loop if not done		LDA	#$FF	;$FF out rest of table@2		EQU	*		CPX	#$A1	;Is it get to the burn-in params ?		BNE	@3	;BRA if not		LDY	DIAGTYPE	;Is burn-in on ?		BPL	@3	;BRA if not		LDX	#$C1	;Else skip over 32 bytes@3		STA	|BRAMBUFFER,X	;Put in buffer		INX		;		BNE	@2	;Loop til all $FF'ed out		PLB		;Recall data bank		PLP		;Recall interrupt status	; SEG $FFWRITEBR		EQU	*	;Write to BATTERYRAM routine	; SEG $00		PHP		;Disable interrupts during write		SEI		;		PHB		;Save current data bank register		JSR	DBTOE1	;Switch to bank E1		JSR	CALCCHKSUM	;Go calculate checksum		STX	|BRAMCHKSUM1	;'X' returns main checksum		STA	|BRAMCHKSUM2	;'A' returns secondary checksum		SEP	#$30	;'m'/'x' back to 8 bit land		LDX	#$00	;Start with 1st byte		TXY		;Start with address 00@1		EQU	*		CLV		;Clear 'v' for write		LDA	|BRAMBUFFER,X	;		JSR	XTNDBRAM	;		INX		;		INY		;Next address		BNE	@1	;		PLB		;Restore data bank register		PLP		;Restore interrupt status		RTL		;Make callable from anywhere with JSL	; SEG $FFREADBR		EQU	*	;Read from BATTERYRAM routine	; SEG $00		PHB		;Save current data bank register		PHP		;Disable interrupts during write		SEI		;		JSR	DBTOE1	;Switch to bank E1		LDX	#$00	;Start with 1st byte		TXY		;Start with address 00@1		EQU	*		SEP	#$40	;Set V for read		JSR	XTNDBRAM	;Read a byte		STA	|BRAMBUFFER,X	;Save for later		CPX	#NLANGOP+0-NPORTOP	;Number of languages available?		BEQ	@16_3	;		CPX	#NLANGOP+1-NPORTOP	;Number of layouts available?		BEQ	@16_5	;		CPX	#NRAMDSKOP+0-NPORTOP	;Is it minimum RAM disk size?		BEQ	@18	;No limit checking needed		CPX	#NRAMDSKOP+1-NPORTOP	;Is it maximum RAM disk size?		BEQ	@18	;No limit checking needed		CPX	#NCLOCKOP-NPORTOP	;Test special if above this value		BCS	@16	;		CMP	>BRAMLIMITS,X	;Test read value against max allowable		BRA	@17	;'c'=0 then it's an OK value@16		EQU	*		BNE	@16_6	;<>=8		CMP	#9	;'c'=0 then all's file		BRA	@17	;Exit routine@16_3		EQU	*		CMP	#8	;		BRA	@17	;Exit routine@16_5		EQU	*		CMP	#17	;0-16 is OK for number of layouts		BRA	@17	;Exit routine@16_6		EQU	*		CPX	#NCLOCKOP-NPORTOP+9+18	;Limit+1 is 16		BCS	@18	;>= 83 then no limit checking is done		CPX	#NCLOCKOP-NPORTOP+9+17	;CHK new slot1 value		BCC	@18_8	;BRA if not		CMP	#$04	;New slot1 value <=$03		BRA	@17	;Exit routine@18_8		EQU	*		CMP	#32	;@17		EQU	*		BCS	READBRBAD	;'c'=1 here then bad BATTERYRAM@18		EQU	*		INX		;Next		INY		;Next address		BNE	@1	;Loop til done		JSR	CALCCHKSUM	;Go calculate checksum		CPX	|BRAMCHKSUM1	;'X' returns main checksum		BNE	READBRBAD	;No match then exit with error		CMP	|BRAMCHKSUM2	;'A' returns secondary checksum		BNE	READBRBAD	;No match then exit with error		PLP		;Restore interrupt status		CLC		;Data intact indicator		SEP	#$30	;'m'/'x' back to 8 bit land		PLB		;Restore data bank register		RTL		;Make callable from anywhere with JSLREADBRBAD		EQU	*	;Set carry if data corrupt		SEP	#$30	;'m'/'x' back to 8 bit land		JSL	>WRITESTD	;Try to write out standards if here		PLP		;Restore interrupt status		SEC		;Data is Apple standards indicator		PLB		;Restore data bank register		RTL		;Make callable from anywhere with JSL	; SEG $FFREADTIME		EQU	*	; SEG $00		PHP		;Disable interrupts during read		SEI		;		PHB		;Save data bank register		JSR	DBTOE1	; and switch it to bank E1		STZ	|TIMEOUT	;Restart time out counter@11		EQU	*		LDY	#$00	;Loop counter@22		EQU	*		INC	|TIMEOUT	;Test if timed out		BEQ	READTIME8	;Quit if can't read clock properly		LDX	#$00	;Read 4 bytes		LDA	#$01-$04	;Starting address-4@33		EQU	*		CLC		;Next address		ADC	#4	;		PHA		;		ORA	#$80	;Set bit 7 for reading command		SEP	#$40	;'v'=1 for reading clock chip		JSR	WRITE1BYTE+1	;Read data and disable transfer		CPY	#$00	;Test if 1st/2nd time through loop here		BNE	@1	;<>0 then 2nd time through loop		STA	|CLKRDATA,X	;Store clock data 1st time through		BRA	@2	;@1		EQU	*		CMP	|CLKRDATA,X	;Test for match		BEQ	@2	;= then continue normally		PLA		;Clean up stack		BRA	@11	;And try again@2		EQU	*		PLA		;Recall 'A'		INX		;		CPX	#$04	;Read 4 bytes then all done		BCC	@33	;Loop til 4 bytes read		TYX		;Test if 1st/2nd time through loop		BNE	READTIME9	;		INY		;Indicate 2nd time through loop		BRA	@22	;READTIME8		EQU	*	;Write exits at READTIME8+1		PLB		;Restore data bank register		PLP		;Restore interrupt status	; SEG $FFSECRTL		EQU	*	; SEG $00		SEC		;Indicate unable to read clock		RTL		;Make callable from anywhere with JSLREADTIME9		EQU	*	;Write exits at READTIME9+1		PLB		;Restore data bank register		PLP		;Restore interrupt status	; SEG $FFCLCRTL		EQU	*	; SEG $00		CLC		;Indicate able to read clock		RTL		;Make callable from anywhere with JSL	; SEG $FFWRITETIME		EQU	*	; SEG $00		PHP		;Disable interrupts during write		SEI		;		LDA	#$00	;Counter on stack@4		EQU	*		PHA		;		LDX	#$00	;Write 4 bytes		LDA	#$01-$04	;Starting address-4@1		EQU	*		CLC		;Next address		ADC	#4	;		PHA		;		LDA	>CLKWDATA,X	;Time to set clock to		TAY		;Data to 'Y' for WRITE1BYTE		LDA	1,S	;'A' = address to write to		JSR	WRITE1BYTE	;Do it		PLA		;Recall 'A'		INX		;		CPX	#$04	;If at 4 then done		BCC	@1	;Loop til 'c'=1		JSL	>READTIME	;Read back/verify data written is correct		LDX	#$03	;Test 4 bytes@2		EQU	*		LDA	>CLKRDATA,X	;Test data read		CMP	>CLKWDATA,X	; against data written		BNE	@3	;<> = then rewrite clock data		DEX		;Try next value		BPL	@2	;		PLA		;All matched if here so exit		BRA	READTIME9+1	;Exit indicating all's fine@3		EQU	*		PLA		;Decrement counter		DEC	A	;		BNE	@4	;Try again if timeout not reached		BRA	READTIME8+1	;Exit indicating error in writeCALCCHKSUM	EQU	*	;Calc checksum of BRAM from $00 to $FB		LDX	#$FA	;Checksum all BRAM except checksum bytes		REP	#$20	;'m'=16 bit -- 'x'=8 bit		LONGA	ON		CLC		;Clear carry to start		LDA	#$0000	;Start with $0000 as checksum@1		EQU	*		ROL	A	;16 bit shift		ADC	|BRAMBUFFER,X	;Add in value from buffer		DEX		;		CPX	#$FF	;Stop on 'X'=$FF		BNE	@1	;Loop til done		REP	#$30	;'m'/'x' = 16 bit mode		TAX		;Save checksum 1 in 'X'		EOR	#CHKSMCNST	;Exclusive OR result with constant		LONGA	OFF		RTS		;Exit 'X'=main chksum - 'A'=2nd chksum* 'A' contains data to to write / from read* 'Y' contains address to read/write data to* BATTERYRAM address is in the form sssaaaaa*            where sss is sector number (0-7)*            and aaaaa is address (0-1F)* 'v' contains read/write status*     1 = read*     0 = write* 'X' is preservedXTNDBRAM		EQU	*	;Set up command and extended address		PHA		;Save data to write to clock data register		TYA		;Create extended address		PHA		;Save for later		AND	#$E0	;Get sector data		LSR	A	;Move to bits 0,1,2		LSR	A	;		LSR	A	;		LSR	A	;		LSR	A	;		ORA	#EXMEMCMD	;Sets command correctly		BVC	@1	;'v' = 0 then writing		ORA	#$80	;Modify command for reading@1		EQU	*		XBA		;Move in hi byte of 'A'		PLA		;Recall address		AND	#$1F	;Strip off sector bits		ASL	A	;Shift bits to 2 to 6		ASL	A	;		XBA		;Save address/do command		PHP		;Save user read/write status		JSR	ACCCLKCLV	;Transfer command to clock chip		XBA		;Send address to write to, to clock chipXTNDBRAM6		EQU	*		JSR	ACCCLKCLV	;Transfer extended address to clock chip		PLP		;Recall what user wants to do		PLA		;Recall user data if writing		JSR	ACCCLOCK	;Read/write a byte of data		PHA		;Save 'A'		LDA	CLOCKCTL	;Reset bit		AND	#$DF	;		STA	CLOCKCTL	;		PLA		;Recall 'A'		RTS		;Back to callerWRITE1BYTE	EQU	*		CLV		;'v'=0 to write data		PHY		;Save data to write on stack		PHP		;Save read/write status on stack		BRA	XTNDBRAM6	;ACCCLKCLV		EQU	*	;Write a byte of data to the clock chip		CLV		;'v'=0 to write dataACCCLOCK		EQU	*	;Send a byte of data to the clock chip		STA	CLOCKDATA	;Data/address/cmd to clock data register		LDA	CLOCKCTL	;Reset read/write bit		AND	#$3F	;Bit 7/6 to 0		BVS	@0	;'v' = 1 if reading instead of writing		ORA	#$A0	;Bit 7/5 to 1 to write transfer		BRA	@1	;@0		EQU	*	;Doing read of BATTERYRAM if here		ORA	#$E0	;Enable transfer for reading@1		EQU	*		STA	CLOCKCTL	;@2		EQU	*	;Wait til transaction is done		LDA	CLOCKCTL	;Wait for transfer to complete		BMI	@2	;Loop til done		LDA	CLOCKDATA	;Put data in 'A' and exit		RTS		;All's fine if here		TITLE	'BATTERYRAM/Clock Chip Rtnes2'*******************************************************                                                    **              BATTERYRAM/Clock Routines2            **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************	; SEG $FFMICROABORTED	EQU	*	;Int handler goes here on micro abort	; SEG $00		LDA	>CURSOR	;Save cursor around JSR SETUPBR		PHA		;		JSR	SETUPBR	;Go resync with keyboard micro		PLA		;Restore CURSOR		STA	>CURSOR	;		CLC		;Back to interrupt handler 'c'=0 if		RTL		; micro is back on line else system death.* SETUPBR does several things for the system.** NOTE: Interrupts are off on entry to here**     1. Read BATTERYRAM*     2. If an error then write default parameters*        to BRAMBUFFER and write that to BATTERYRAM.*     3. Pre-modify APTALKBOOT byte so that 'SLOOP' routine*        can have enough space to handle booting from AppleTalk*     4. Setup system to user preferences except for*        system speed which must be done in Apple//e*        monitor space.*SETUPBR		EQU	*		LDA	#11	;Change register 11 in the SCC		STA	SCCAREG	; to enable the oscillator.		LDA	#$D2	;Monitor is only one allowed to do this		STA	SCCAREG	; of channel B will stop working.		JSR	RESETFF	;Setup some reset stuff		JSL	>READBR	;Move BATTERYRAM params to buffer in E1		PHB		;Save data bank register		JSR	DBTOE1	;Change data bank to E1		STZ	|APTALKPORT	;0=NONE, 1=PORT1, 2=PORT2		STZ	|APTALKBOOT	;0=NONE, 1=$C100, 2=$C200 .....		STZ	|APTALKRPMM	;Remote printing, same as APTALKBOOT		LDA	|USERSLT2	;Is slot 2 for AppleTalk ?		CMP	#$02	;0=Printer, 1=Modem, 2=AppleTalk		BEQ	@2	;Set APTALKBOOT=2, boot from slot2@1		EQU	*		LDA	|SPCLSLT1	;Is slot 1 for AppleTalk? Use real one !!		CMP	#$02	;		BNE	@3	;Bra if both slot1/2 not for ApTalk  		DEC	A	;Make it 1=boot from slot1 AppleTalk@2		EQU	*		STA	|APTALKPORT	;Set up APTALKPORT		STA	|APTALKBOOT	;0=NONE, 1=Slot1 ApTalk, 2=Slot2 ApTalk		STA	|APTALKRPMM	;Set remote printing stuff@3		EQU	*		LDX	#$07	;Save 8 bytes@4		EQU	*	;Save flush/micro abort vectors		LDA	|IRQ_FLUSH,X	;Pick up byte		PHA		;Save on stack		DEX		;		BPL	@4	;Loop til done		JSR	RESETFDB	;Wake up front desk bus		JSR	RESETFDB	;Wake up front desk bus again		LDX	#$00	;Restore 8 bytes@12		EQU	*	;Save flush/micro abort vectors		PLA		;Recall byte		STA	|IRQ_FLUSH,X	;Pick up byte		INX		;		CPX	#$08	;Increment to 8 the quit		BNE	@12	;Loop til done		PLB		;Restore data bank register		LDA	>CLRHOLES	;		BNE	@13	;BRA not to clear		LDA	#$FF	;Set it non-zero		STA	>CLRHOLES	;Set it non zero;REP #$30 ;16-bit mode to clear screen holes;MEMORY16  ; so that slinky ram card would work;INDEX16  ; it can't be clear with $a0 !!!;LDA #$0000 ;Clean all screen holes to zero;LDX #$0006 ;Index to screen holes		LDA	#$00		LDX	#$08@14		EQU	*		DEX		BEQ	@13		STA	$478,X	;DO IT		STA	$4F8,X		STA	$578,X		STA	$5F8,X		STA	$678,X		STA	$6F8,X		STA	$778,X		STA	$7F8,X		BRA	@14;DEX;CPX #$0001;BNE @14;DEX;BPL @14;SEP #$30;MEMORY8;INDEX8@13		EQU	*		JSR	TSTPWRUP	;Test power up bytes		BNE	ITSCLDST	;= then it's warmstart		LDA	>SLOTSFLG	;What was set up before?		JSR	SETUPSLOTS1	;Set up 80 columns correctly NOW!!!!		SEC		;Do NOT setup slots on warmstart		OPCODE	BCCITSCLDST		EQU	*		CLC		;Set up slots if coldstart		JSL	>USERSETUP	;Do rest of setup* Test if warm or cold startup.  If warmstart make* warmstart reset call to tool dispatcher.		JSR	TSTPWRUP	;Test power up bytes		BNE	@4	;<>= then it's coldstart		IF IS512 <> 0 THEN		ELSE		REP	#$30	;Warm start the tool locator/tools		LONGI	ON		LDX	#$0501	;Warmstart/tool locator call		LONGI	OFF		JSL	>DISPATCH1	;Call it		SEP	#$30	;Back to normal monitor mode		ENDIF@4		EQU	*		RTS		;Back to callerTSTPWRUP		EQU	*	;Test for warmstart or coldstart		LDA	SOFTEV+1	;Is reset Hi byte		EOR	#$A5	; a funny complement of the		CMP	PWREDUP	; power up byte?		RTS		;'z'=0 if warmstart else its coldstart* USERSETUP is called via a vector called TOBRAMSETUP* in bank E1.*  Entry requirements:*                      Native mode 8 bit 'm'/'x'*                      'c'=0 for complete setup*                      'c'=1 for setup all except slots	; SEG $FFUSERSETUP		EQU	*	;Setup called by control panel	; SEG $00		PHP		;Save interrupt status		SEI		;NO interrupts in here		LDA	STATEREG	;Save state		PHA		;Save on stack		AND	#$FE	;Enable slotcsrom space		ORA	#$08	;Enable ROM		STA	STATEREG	;		PHP		;'c'=0 then change everything possible		JSR	SETUPBR2	;Set up some BATTERYRAM stuff		PLP		;'c'=1 if do NOT change slots designation		BCS	@1	;		JSR	SETUPSLOTS	;Set up slots stuff (int versus ext)@1		EQU	*		JSR	D2D	;Detect disk ]['s / set up system speed		PLA		;Recall state		STA	STATEREG	; and restore it.		PLP		;Recall interrupt status		CLC		;Needed for keyboard micro abort interrupt		RTL		;Back to external caller	; SEG $FFSETUPSLOTS	EQU	*	;Set up slot designation (int versus ext)	; SEG $00		LDX	#$7	;Shift 7 times		LDA	#$00	;Starting SLTROMSEL value@1		EQU	*		ORA	>USERSLT1-1,X	;Or in next slot		ASL	A	;Shift 1 bit		DEX		;		BNE	@1	;Loop til done		AND	#$F0	;Bits 3,2,1 and 0 MUST be 0		TAX		;Save 'A'		LDA	>USERSLT2	;Whose slot 2 card ?		CMP	#$01	;Is it set to external ?		BNE	@2	;BRA if not		TXA		;Get back 'A'		ORA	#$04	;Set slot 2 to external, bit2		TAX		;Save 'A' again@2		EQU	*		LDA	>SPCLSLT1	;Whose slot 1 card ? Use real one		CMP	#$01	;Is it set to external ?		BNE	@3	;BRA if not 		TXA		;Get back 'A'		ORA	#$02	;Set slot 1 to external, bit0		TAX		;Make it for next instruction@3		EQU	*		TXA		;Get back 'A'		STA	SLTROMSEL	;Now set up slot ROM select switch		STA	>SLOTSFLG	;Used to set up SLTROMSEL on warm reset	; SEG $FFSETUPSLOTS1	EQU	*	;Set up 80 columns correctly	; SEG $00		STA	SETINTC3ROM	;Enable internal slot 3 $Cn00 space		LDA	>USERSLT3	;Whose slot 3 card?		BEQ	@1	;= then internal slot 3 $Cn00 active		STA	SETSLOTC3ROM	;Enable external slot 3 $Cn00 space@1		EQU	*		RTS		;Back to callerSETUPBR2		EQU	*	;Entry point for control panel		JSL	>READBR	;Move BATTERYRAM params to buffer in E1		PHB		;Change data bank register to E1		JSR	DBTOE1	;		STZ	|ORGMEMORY	;Zero out for monitor commands		CLC		;Carry must be clear to start		LDA	|USERSPEED	;		ROR	A	;Shift to hi bit to make mask		ROR	A	;Bit7=1 for hi spd - bit7=0 for slow spd		STA	|SYSTEMSPD	;		JSR	SETCOLORS	;Set up all color related stuff		LDA	SOUNDCTL	;Change low nybble only		AND	#$F0	;		ORA	|USERVOL	;What's user volume?		STA	SOUNDCTL	;Alter user's volume		LDA	|USERVOL	;Set up IRQ volumne		STA	|IRQ_VOLUME	; for interrupt manager		ASL	A	;Move to hi nybble for Ensoniq routines		ASL	A	;		ASL	A	;		ASL	A	;		STA	|SYSVOLLOC	;Save for Ensoniq sound routines		JSR	FIXCURSHIFTER	;Fix up flash rate for cursor* Sync up to the keyboard microprocessor.*    and place them in BRAMBUFFER.* Finally setup all micro parameters including*    1. Keyboard buffering*    2. Shift Caps/Lower Case*    3. Fast Space/Bkspace Keys*    4. Dual Speed*    5. High Mouse Resolution		JSR	|PANELFDB	;Go to front desk bus code to set up stuff		PLB		;Restore data bank register		RTS		;Back to callerSETCOLORS		EQU	*		PHB		;Save data bank register		JSR	DBTOE1	;Switch to bank E1		LDA	|USERTEXT	;Make up text/background as user wants		ASL	A	;Lo byte to hi byte		ASL	A	;		ASL	A	;		ASL	A	;		ORA	|USERBACK	;		STA	TBCOLOR	;Sets text/background bits		LDA	CLOCKCTL	;Mask off lo nybble		AND	#$F0	;		ORA	|USERBORDER	;		STA	CLOCKCTL	;		LDA	#$F0	;Mask out bits 4,5,6,7		TRB	LANGSEL	;		LDA	|USERDISP	;User display language		ASL	A	;Shift left 1 byte to make room for hertz		ORA	|USERHERTZ	;Set up user clock frequency		ASL	A	;Shift to bit4 for masking		ASL	A	;		ASL	A	;		ASL	A	;		ORA	#$08	;Enable character select bit in Mega //		TSB	LANGSEL	;Bit4=0/1 (60hz/50hz)		LDA	#$20	;Reset bit		TRB	NEWVIDEO	; before setting it correctly		CLC		;MUST clear carry or unknown results		LDA	|USERCOLOR	;Make up color/mono for user		ROR	A	;Move to bit 7		ROR	A	;		STA	MONOCOLOR	;Sets up mono/color for user		ROR	A	;Shift to bit 5 for NEWVIDEO mask		ROR	A	;		TSB	NEWVIDEO	;Sets color/mono for double hires		PLB		;Restore data bank register		RTS		;Back to caller		TITLE	'Interrupt Handlers ROM Code'*******************************************************                                                    **    Interrupt Handler/Manager ROM code routines     **                                                    **                    by                              **               Rich Williams     1985-1987          **               Fern Bachman      1985-1987          **               Joe Bo            1987-1989          **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *************************************************************************************************************** CPABRTDISP arbitrates whether the interrupt was* from an ABORT or a COP occurring.*******************************************************	; SEG $FFCPABRTDISP	EQU	*	;COP/ABORT dispatcher	; SEG $00		BCC	@1	;'c'=0 if it's a COP of some kind		JMP	>ABORTMGRV	;'c'=1 it's an abort@1		EQU	*		JMP	>COPMGRV	;'c'=0 it's a COP******************************************************** Here 'v'=? 'b'=? from COP instruction.  In here* dummy up processor status from COP to make it look* like a break (native or emulation) occurred for* display of the COP message.  For emulation mode* this requires clearing 'v' and by pulling the COP* status from the stack, setting the 'b' bit and pushing* the status back on the stack and falling* into Rich's interrupt code.  For native mode this* requires setting 'v'=1 to indicate a native* mode COP.*******************************************************	; SEG $FFUABORTHNDLR	EQU	*	;Unknown aborts come hereUCOPHNDLR		EQU	*	;Unknown aborts come here	; SEG $00		CLC		;Which type of COP (emulation or native)?		XCE		;Switch 'e' and 'c'		BCS	@1	;'c' set then it was emulation mode COP		SEP	#$40	;Set 'v' to simulate native mode break		BRA	INTHNDLR	;Go to normal interrupt handler	; SEG $FF@1		EQU	*	;Unknown emulation mode COP handler	; SEG $00		XCE		;Switch back to emulation mode		CLV		;Indicates not a native break		PLA		;Change COP status to simulate a break		ORA	#$10	;Set break bit		PHA		;************************************************* Here V=1 if break =0 if don't know yet* Save A,X,Y,DB and E bit* and shadow reg and cya register* Set native mode, fast speed, C = E bit************************************************	; SEG $FFINTHNDLR		EQU	*	; SEG $00		CLC		;Into native mode		XCE		REP	#M8+X8	;16 bit regs		LONGA	ON		PHP		;Save emulation status		PHB		;Save data bank		PEA	$E1E1	;Set data bank to E1		PLB		STA	|irq_A	;Save the A reg		LDA	SHADOW	;Get shadow and cya		STA	|irq_shadow	;Save em		ORA	#$8000	;Force fast speed		AND	#$9F3E	;Force I/O and text shadowing		STA	SHADOW		STX	|irq_X	;Save X & Y		STY	|irq_Y		TDC		;Save direct register		STA	|irq_D	;		LDA	#$0000	;Reset direct register to $0000		TCD		;		LONGA	OFF		SEP	#$30** A patch was added here to preserve the alternate pg 1 stack which*  was not preserved in the earlier ROMs.  This patch added too many*  cycles into the path from interrupt to the AppleTalk data stores*  below and so was pulled out.  The load/store is moved to three*  different places that are not in this initial, critical path.*  {MSA/FAB 4/14/89}*;LDA =ALEMSTKPTR ;Store emulation stack pointer;STA irq_EMULSTKPTR ;* Do a quick break test before testing for SCC interrupt.		BCC	@1	;'c'=0 then maybe native mode interrupt		LDA	4,S	;Recall status byte		AND	#$10	;Test emulation mode break bit		ADC	#$70	;Add $10 or $11 to set 'v'@1		EQU	*		BVS	@222	;'v'=1 on breaks* End of quick break test.		LDA	#$03	;Test register 3 for interrupt		STA	SCCAREG	;		LDA	SCCAREG	;=0 then not an SCC interrupt		BIT	|SCCFLAG2	;Interrupt mask for AppleTalk		BEQ	@122	;		PHA		;Save for serial interrupt testing		AND	#$07	;$38=channel A mask - $07=channel B mask		BNE	@2	;Do channel B for AppleTalk* Fall through for channel A AppleTalk interrupt		LDA	SCCADATA	;Read channel A		STA	|SCC1	;Save as data byte 1		LDA	SCCADATA	;Read next byte too		STA	|SCC2	;Save as data byte 2		JSL	>IRQ_APTLK	;Process AppleTalk interrupt		BRA	@121	;Skip channel B read* Branch (BNE) to here for channel B AppleTalk interrupt@2		EQU	*		LDA	SCCBDATA	;Read channel B		STA	|SCC1	;Save as data byte 1		LDA	SCCBDATA	;Read next byte too		STA	|SCC2	;Save as data byte 2		JSL	>IRQ_APTLK	;Process AppleTalk interrupt@121		EQU	*		LDA	>ALEMSTKPTR	;{MSA/FAB 4/14/89} Preserve page 1 stack pointer		STA	|IRQ_EMULSTKPTR	;{MSA/FAB 4/14/89}		LDA	#$00	;Save user gets called or not status		ROR	A	;Move 'c' into status byte		STA	|SCCSTAT	;		PLA		;Recall SCC interrupt status		BRA	@123	;Skip reseting of SCCSTAT@122		EQU	*		PHA		;{MSA/FAB 4/14/89} Keep SCCAREG around		LDA	>ALEMSTKPTR	;{MSA/FAB 4/14/89} Preserve page 1 stack pointer		STA	|IRQ_EMULSTKPTR	;{MSA/FAB 4/14/89}		STZ	|SCCSTAT	;MUST 0 this status byte out here		JSL	>IRQ_MIDI	;Polls for midi input int		PLA		;{MSA/FAB 4/14/89} Recover SCCAREG!		BCC	@123_7	;BRA if Midi claims the int** The following clear carry is inserted to maintain compatibility*  in the case that the MIDI interrupt handler refuses the interrupt.*  The carry was clear at this point in the 01 ROM and some app's*  interrupt handlers depend on the the carry being clear on entry*  to the handler (Master Tracks just does a PHP / PLP in the sound*  handler; it always services the interrupt when installed and*  assumed that what the carry was at entry was okay to return*  on exit...)  3/23/89  MSA*		CLC@123		EQU	*		PHA		;Preserve SCC register 3 interrupt status		AND	|SERFLAG	;Test for serial interrupts		BEQ	@124	;=0 then no serial interrupts		JSL	>IRQ_SERIAL	;Go to serial interrupt handler		ROR	|SCCSTAT	;Save user gets called or not status		PLA		;Clean up stack to exit this way@123_5		EQU	*		LDA	|SCCSTAT	;Test for <>=0		BNE	@125	;ROR yields 'z'<>1 then bug user@123_7		EQU	*		REP	#$30	;16 bit land a must		PLB		;Clean up stack		JMP	IRQDONE4	;Exit quickly@124		EQU	*		PLA		;What was SCC register 3 interrupt status?		BNE	@123_5	;<>=0 then chk to see if user gets called@125		EQU	*		CLV		;		LONGA	ON@222		EQU	*		LDA	>ALEMSTKPTR	;{MSA/FAB 4/14/89} Preserve page 1 stack pointer		STA	|IRQ_EMULSTKPTR	;{MSA/FAB 4/14/89}		REP	#$30	;16 bit land a must		PLB		;Clean up stack		PLA		STA	|irq_DB	;Save data bank and em status		STZ	|IRQ_INTFLAG	;Reset IRQ_INTFLAG/IRQ_DATAREG		STZ	|IRQ_KMSTATUS	;Reset IRQ_KMSTATUS/IRQ_SECFLAG********************************************** Test for break here so stack information* can be saved with the correct stack * in place.********************************************		BVC	@4	;		SEP	#$10	;16 bit 'm' but 8 bit 'x'		PLY		;Recall break processor status		PHY		;Put back on stack for possible restart		STY	|irq_P	;Save for break printout/'R'esume		STY	STATUS	;Save for old break users		LDA	2,S	;Recall PCL/PCH		STA	|irq_PC	;Save for break printout/'R'esume		STA	PCL	;Save for old break users		LDY	#$00	;Anticipate bank 00 is break bank		LDA	|irq_DB+1	;Bit 0=1 if emulation mode break		LSR	A	;Bit 0 to 'c'		BCS	@3	;		LDA	4,S	;Recall break bank		TAY		;Move to 8 bit 'Y' to save bank number@3		EQU	*		STY	|irq_K	;Save for break printout/'R'esume@4		EQU	************************************************** Now fix the stack pointer************************************************		TSC		STA	|irq_S	;Save the stack pointer		SEP	#M8+X8	;8 bit land		LONGA	OFF		XBA		;A = stack hi		EOR	#1	;Page 1?		BNE	@5	;		LDX	rdaltzp	;Alternate stack? (do NOT change 'v')		BPL	@6		XBA		;		STA	>ALEMSTKPTR	;Save the alternate stack pointer@5		EQU	*		LDA	#$01	;		XBA		;		LDA	>MNEMSTKPTR	;Get main stack pointer		TCS		;Into the stack with it************************************************* Now set the state register to the standard state************************************************@6		EQU	*		LDA	statereg		STA	|irq_state	;Save the current value		LDX	rd80col	;If 80store, get page 1 (leave 'v' alone)		BPL	@7		AND	#$BF@7		EQU	*		AND	#$40	;		ORA	#$08	;Enable ROM		STA	STATEREG** At this point we have* A,X,Y,DB saved* State, shadow and CYA registers saved* Standard state and fast speed set* V = 1 if Break*		LDA	>$000000+mslot	;Get mslot		STA	|irq_mslot	;Push on stack?		BVC	@8	;'v'=0 then test for internal interrupt		STZ	|IRQ_SECFLAG	;Be sure it's 0		JMP	irqbrk1	;If BRK, skip internal irq handlers************************************************* Built in interrupt handlers should be put here* All registers are 8 bits on entry to here************************************************@8		EQU	*		INC	|IRQ_ACTIVE	;<>0 then indicate irq's active		LDA	|SCCSTAT	;=0 then not SCC irq		BEQ	@9	;<>0 then it's an SCC problem		STA	|IRQ_SECFLAG	;Causes multiple interrupts to be handled		LDA	#$00	;Change data bank register to $00		PHA		;		PLB		; before quitting.		JMP	IRQDONE1_1	;Exit with SCC interrupt processed@9		EQU	*		LDA	#$00	;Data bank register to 00		PHA		;		PLB		;		LDA	VGCINT	;Test for scan line interrupt		BPL	@22	;+ then not a VGC interrupt		AND	#$22	;Bit 5=status - bit 1=enable		LSR	A	;Shift bit 1 into carry		LSR	A	;		BCC	@22	;'c'=0 then not enabled		BEQ	@22	;'z'=0 then not a scan line interrupt		JSL	>IRQ_SCAN	;<>0 then try to service interrupt		JMP	@77_6	;Exit this way@22		EQU	** Save and restore Ensoniq state		LDA	SOUNDCTL	;Save control state too		AND	#$F0	;Strip off unstable nybble		PHA		;		REP	#$30	;Do this fast to save time		LDA	SOUNDADRL	;		PHA		;Save sound address in use		SEP	#$30	;Back to normal monitor mode		LDA	#$E0	;Oscillator Interrupt Register (OIR)		STA	SOUNDADRL	;Set in address lo byte of sound glu		LDA	SOUNDCTL	;What's current hi nybble?		AND	#$90	;Enable reading Ensoniq DOC / Auto inc off		ORA	>IRQ_VOLUME	;Or in volume nybble		STA	SOUNDCTL	;		LDA	SOUNDDATA	;False read to sound glu		LDA	SOUNDDATA	;Reads OIR		STA	>IRQ_SOUNDDATA	;Save for sound tools		BMI	@33	;'-' then not sound interrupt		JSL	>IRQ_SOUND	;'+' then it's a sound interrupt		REP	#$30	;Do this fast to save time		PLA		;Recall sound address in use		STA	SOUNDADRL	;		SEP	#$30	;Back to normal monitor mode		PLA		;Recall sound control state		ORA	>IRQ_VOLUME	;Or in volume nybble		STA	SOUNDCTL	; and restore it.		JMP	@77_6	;Exit this way@33		EQU	*		REP	#$30	;Do this fast to save time		PLA		;Recall sound address in use		STA	SOUNDADRL	;		SEP	#$30	;Back to normal monitor mode		PLA		;Recall sound control state		ORA	>IRQ_VOLUME	;Or in volume nybble		STA	SOUNDCTL	; and restore it.		LDA	INTFLAG	;Get VBL/qtr sec int status		AND	INTEN	;Only enabled active ints will be 1 now		STA	>IRQ_INTFLAG	;		AND	#$18	;Bit 4=1/4 sec int - -bit 3=VBL		PHA		;Save for qtr sec testing later		AND	#$08	;VBL status is bit 3		BEQ	@33_2	;=0 then not a VBL interrupt		JSL	>IRQ_VBL	;Go to routine to service VBL		LDA	>IRQ_MOUSVBL	;Test if user gets VBLs		BNE	@33_0	;<>= then mouse gets VBLs		BCC	@33_2	;		LDA	#$08	;Reset VBL interrupts if no one wants them		TRB	INTEN	;		STA	CLRVBLINT	;Arbitrarily turn off VBL int		BRA	@33_2	;Skip setting flag@33_0		EQU	*		SEC		;Forces interrupt to user		JSR	TSTSETFLG	;Set flag to guarantee VBL to user@33_2		EQU	*		LDA	KMSTATUS	;Save status for later testing		STA	>IRQ_KMSTATUS	;		ASL	A	;See if mousey type interrupt		BPL	@44	;Mouse interrupts not enabled		BCC	@44	;+ then mouse ints enabled but not active		JSL	>IRQ_MOUSE	;Go try to do mouse interrupt		CLV		;Mouse interrupt		JSR	TSTSETFLG	;Check 'c' and maybe set flag		BRA	@44_1	;Skip setting 'v'@44		EQU	*		SEP	#$40	;'v'=1 if not serviced or not mouse int@44_1		EQU	*		PLA		;Recall INTFLAG status		BNE	@44_2	;<>= then try qtr sec int status flag		BVC	@66_8	;'v'=0 then no more to test for		BVS	@66	;Not VBL/qtr sec or mouse interrupt@44_2		EQU	*		AND	#$10	;Bit 4 is qtr sec int status flag		BEQ	@66_8	;Not a qtr sec interrupt		JSL	>IRQ_QTR	;Go to routine to service interrupt		BRA	@66_6	;Exit this way@66		EQU	*		LDA	>IRQ_KMSTATUS	;Test for data register interrupts		AND	#$30	;Bits 4,5 are status/enable		ASL	A	;Bit 5 to 'c'/bit 4 to bit 7		ASL	A	;		ASL	A	;		BPL	@55	;+ then not enabled		BCC	@55	;'c'=0 then not data reg int		LDA	DATAREG	;Pick up DATAREG for testing now and later		STA	>IRQ_DATAREG	;Save for later		BPL	@66_1	;Not response byte interrupt		JSL	>IRQ_RESPONSE	;Go do interrupt if possible		JSR	TSTSETFLG	;Check 'c' and maybe set flag@66_1		EQU	*		LDA	>IRQ_DATAREG	;Recall status byte		AND	#$08	; and test for SRQ interrupt		BEQ	@66_2	;=0 then not an SRQ		JSL	>IRQ_SRQ	;Go do interrupt if possible		JSR	TSTSETFLG	;Check 'c' and maybe set flag@66_2		EQU	*		LDA	>IRQ_DATAREG	;Recall status byte		AND	#$20	; and test for desktop mgr interrupt		BEQ	@66_3	;=0 then not an desktop mgr interrupt		LDA	KEYMODREG	;Is Shift key pressed also ?		ROR	A	;Rotate bit0 (shift) to 'c'		BCC	@66_2_1	;BRA if not pressed with Shift key		JSL	>TODESKMGR	;Else use private vector to jmp to		BRA	@66_2_3	;Continue on  @66_2_1		EQU	*		JSL	>IRQ_DSKACC	;Go do interrupt if possible@66_2_3		EQU	*		JSR	TSTSETFLG	;Check 'c' and maybe set flag@66_3		EQU	*		LDA	>IRQ_DATAREG	;Recall status byte		AND	#$50	; and test for flush buffer interrupt		ASL	A	;Shift bit 6 to carry		ASL	A	;		BEQ	@66_4	;=0 then not flush buffer interrupt		BCC	@66_2_2	;'c' clear then don't clear KBDSTRB		STA	KBDSTRB	;Remove key in buffer@66_2_2		EQU	*		JSL	>IRQ_FLUSH	;Go do interrupt if possible@66_4		EQU	*		LDA	>IRQ_DATAREG	;Recall status byte		CMP	#$40	; and test for keyboard micro interrupt		BNE	@66_8	;= then abort interrupt		JSL	>IRQ_MICRO	;Go do interrupt if possible@66_6		EQU	*		JSR	TSTSETFLG	;Check 'c' and maybe set flag@66_8		EQU	*		JMP	IRQDONE1_1	;See if we exit or go to OS int handler@55		EQU	*		LDA	>IRQ_KMSTATUS	;Test for keyboard interrupt		TAY		;Save for later		AND	#$0C	;Bit 2= key int enable- bit3=key int		LSR	A	;		LSR	A	;		LSR	A	;'c' = enable - 'z' = key int		BCC	@77_0	;'c' = 0 key ints not enabled		BEQ	@77_0	;Not a keyboard interrupt		JSL	>IRQ_KBD	;Go do interrupt if possible		BRA	@77_6	;Exit this way@77_0		EQU	*		LDA	VGCINT	;Test for 1 second interrupt		BPL	@77	;+ then not a VGC interrupt		AND	#$44	;Bit 6=status - bit2=enable		ASL	A	;Shift status to 'c'		ASL	A	;		BEQ	@77	;=0 then 1 sec int not enabled		BCC	@77	;'c'=0 then not a 1 second interrupt		JSL	>IRQ_1SEC	;Go do interrupt if possible		BRA	@77_6	;Exit this way@77		EQU	*		LDA	VGCINT	;Test for EXT interrupt from VGC		BPL	@88	;+ then not a VGC interrupt		AND	#$11	;Bit 4=status - Bit 0=enable		LSR	A	;		BCC	@88	;EXT interrupts not enabled		BEQ	@88	;=0 then not EXT interrupt		JSL	>IRQ_EXT	;Go do interrupt if possible@77_6		EQU	*		BCC	IRQDONE2	;Exit with interrupt serviced		JMP	IRQBRK0	;Go to operating system to handle int@88		EQU	*		JSL	>DEFAULTSLT	;Let OS patches for set default slot		JSL	>IRQ_OTHER	;Is special interrupt handler installed?		BRA	@77_6	;Test 'c' flag		EJECT************************************************* irqdone1 - This restores the machine after a user's interrupt* Assumes entry in emulation mode from user's interrupt* Sets native mode, fast speed, DB=$E1* Restores mslot, D************************************************	; SEG $FFIRQDONE1		EQU	*	; SEG $00		PLA		;Pull RTL opcode from stackIRQDONE1_2	EQU	*		CLC		;Back to native mode		XCE		JSL	>RESTORSLT	;Restore system slots assignment after user's int		LDA	>IRQ_SECFLAG	;Are we really done?		ASL	A	;Remove 1 status bit		STA	>IRQ_SECFLAG	;Resave status byte		BNE	IRQBRK0	;Back through operating system if <>0@1		EQU	*		LDA	#$80	;Back to fast mode		TSB	cyareg		LDA	>irq_mslot	;Get mslot		STA	mslot	;Assumes data bank reg is $00 on entry		REP	#X8		XBA		;A = Cnxx		LDA	#$00	;A = Cn00		TAX		BIT	CLRROM	;Deselect all C800s		LDA	|0000,x	;Access Cn00 to enable C800 space		SEP	#X8	;Restore 'x' to 8 bit mode************************************************* irqdone2 - Fixes machine after internal interrupt* restores stack, data bank, Y, X ,A & E bit* and state, shadow & cya registers* Assumes 8 bit 'm' and 'x'************************************************IRQDONE2		EQU	*		LDA	#$E1	;Data bank register back to E1		PHA		;		PLB		;		LDA	LCBANK1	;Write enable language card		LDA	LCBANK1	;Write enable language card		LDA	|irq_state	;Fix the state reg		STA	STATEREG	;		DEC	|IRQ_ACTIVE	;Indicate irq's no longer active		REP	#M8+X8	;Go to 16 bit land		STZ	|IRQ_INTFLAG	;Zero out 2 bytes		LDA	|irq_S	;And now the stack		TCS		LDA	|irq_db	;Data bank and E bit		PHAIRQDONE4		EQU	*		LDA	|irq_D	;Restore ZP		TCD		LDY	|irq_Y		LDX	|irq_X		LDA	|irq_shadow	;SHADOW and CYA		STA	SHADOW		SEP	#$20	;8 bit 'm'		LDA	|irq_emulstkptr	;Restore emulation stk ptr		STA	>alemstkptr	;		JSR	SETTEXT2REG	;Add in for protection		REP	#$20	;Back to 16 bit 'm'		LDA	|irq_A	;A reg		PLB		;Data bank		PLP		;'c' = 'e' bit		BCS	@1	;Br if emulation		RTI		;Bye bye@1		EQU	*	;Must rti from bank 0		XCE		;Switch to emulation mode first		JMP	>RTI~Bnk00	;Must rti from bank 0TSTSETFLG		EQU	*		BCC	@1	;No flag change if 'c'=0		LDA	>IRQ_SECFLAG	; else set a bit		ROR	A	;Move 'c' to bit 7 of IRQ_SECFLAG		STA	>IRQ_SECFLAG	;@1		EQU	*		RTS		;************************************************* Not an internal interrupt* Save D and mslot* Set D=0 DB=0 and slow speed* and call user's handler************************************************IRQDONE1_1	EQU	*		LDA	>IRQ_SECFLAG	;Go to operating sys int handler		BNE	IRQBRK0	;If <>0, then not yet done		JMP	IRQDONE1_2	; else end it and exitIRQBRK0		EQU	*		CLV		;'v'=0 to indicate it's an int not breakIRQBRK1		EQU	*		LDA	#$00	;Change data bank		PHA		;Set data bank to 0		PLB* Added for protection		LDA	statereg		LDX	rd80col	;If 80store, get page 1 (leave 'v' alone)		BPL	@1	;		AND	#$BF@1		EQU	*		AND	#$40	;		ORA	#$08	;Enable ROM		STA	STATEREG		LDA	#$80		TRB	cyareg	;Slow speed		BVC	@3	;'v'=0 then it's not a BRK		JSL	>BREAKVECTOR	;If it's a BRK see if something to do		BCC	IRQDONE1_1	;@2		EQU	*		SEP	#$40	;Indicate BRK occurred@3		EQU	*		REP	#$20	;16 bit 'A' register needed		TSC		;Save stack pointer		LDX	#$6B	;'RTL' opcode		PHX		;Put instruction on stack		PHK		;Put bank number of return addr on stack		PEA	|IRQDONE1-1	;Push return address on stack		PHA		;Push RTI return address on stack		SEC		;Into emulation mode		XCE		;		SEP	#$20	;8 bit 'm'		LDA	#$04	;Disable interrupt's for user's RTI		PHA		;		BVS	@5	;Branch if break		JMP	>GOIRQ~Bnk00	;Off to the user's handler@5		EQU	*		LDA	>irq_A	;Move Accumulator		STA	ACC	;		LDA	>irq_X	;Move 'X'		STA	XREG	;		LDA	>irq_Y	;Move 'Y'		STA	YREG	;		LDA	>irq_S	;Move stack pointer		STA	SPNT	;		SEC		;Into emulation mode		XCE		;		JMP	>GOBRK~Bnk00	;Go do a break				FillTo	$C06ETOROMDSKACC	EQU	*		JMP	TSTMONDSKACC						TITLE	'15 Byte Interrupt ROM Code'*******************************************************                                                    **         15 byte interrupt ROM code routines        **                                                    **                         by                         **                    Fern Bachman                    **                    Rich Williams                   **                                                    **       Copyright Apple Computer, Inc. 1985-1987     **                All Rights Reserved.                **                                                    *******************************************************TONBREAK		EQU	*	;Native mode breaks vector hereRTI~Bnk00		EQU	*+1-Rel~Org+Bnk~Org	;RTI ($40) in C07x space		SEP	#$40	;Set 'v' to indicate from here		OPCODE	BVCTONIRQ		EQU	*TOEBRKIRQ		EQU	*		CLV		;Indicate from here		JMP	>INTMGRV	;Enter interrupt handlerTONABORT		EQU	*TOEABORT		EQU	*		SEC		;'c'=1 if it's abort		OPCODE	BCCTONCOP		EQU	*TOECOP		EQU	*		CLC		;'c'=0 if it's COP		JMP	>CPABRTDISP	;Go to COP/ABORT dispatcher		TITLE	'Print Routine + New Cmds Table';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 7:22:19 PM*******************************************************                                                    **           Firmware Print Messages Routines         **                                                    **                         by                         **                    Fern Bachman                    **                                                    **       Copyright Apple Computer, Inc. 1985-1987     **                All Rights Reserved.                **                                                    ******************************************************** PRINTMSG and PRINTMSG2 are used by the monitor,* control panel program, disk routines, and via* hooks the user.** PRINTMSG takes the 8 bit value in the accumulator*          shifts it left by 2 and uses it as an index*          into a messages table of DW's defined by*          MSGPOINTER.** LPRINTMSG takes the 16 bit value in the accumulator*          shifts it left by 2 and uses it as an index*          into a messages table of DW's defined by*          MSGPOINTER.** Both print entry points handle data the same way.** If the 1st byte of ASCII is + (Hi bit=0) then*        the print routines print until an ASCII*        byte with the hi bit - (Hi bit=1) is*        detected.  That ASCII character is printed*        as the last character in the message.** If the 1st byte of ASCII is $00 then the print*        routines increment to the next character*        and prints until $00 is found.  This allows*        strings which begin with MouseText characters*        to be printed.  The $00 is NOT printed.** If the 1st byte of ASCII is <$20 then the print*        routines will take that number as a repeat count*        and repeat the next character that many times.*        It will then increment to the next character*        and print until $00 is found.  This allows*        strings which begin with repeated characters*        to be printed.  The $00 is NOT printed.** Repeat characters are handled as follows:*   If LDA [PRINTTMP] = <$20 then the following is true.*      The byte is the repeat indicator / number of times to repeat.*      The byte after that is the repeat character.*      The repeat character/number of times to repeat*         indicator can appear anywhere in the string.*      The maximum repeat count is $1F (31 decimal).** The message length limit is 65535 characters!!!!** PRINTTMP(+0 +1 +2) then locations used in*       zero page are saved and restored.PRINTMSG		EQU	*		REP	#$30	;Off to 16 bit land		LONGA	ON		AND	#$00FF	;High byte must be 0		LONGA	OFFPRINTMSG2		EQU	*	;Extended print message entry point		LDY	PRINTTMP+0	;Save zero page used on stack		PHY		;		LDY	PRINTTMP+2	;Make room for bank num too!		PHY		;		ASL	A	;Shift through all 16 bits		TAY		;Transfer 16 bit 'A' to 'Y'		LDA	>MSGPOINTER	;Set up pointer to msg tbl in zero page		STA	PRINTTMP+0	;		LDA	>MSGPOINTER+1	;Hi byte and bank of pointer address		STA	PRINTTMP+1	;		LDA	[PRINTTMP],Y	;Set up pointer in zero page		STA	PRINTTMP+0	;Bank num assumed to be same as pointer's 		SEP	#$70	;8 bits+anticipate DCI or MouseText string@2		EQU	*		LDA	[PRINTTMP]	;First byte - then normal 		BEQ	@5_4	;=0 then printing MouseText string		CMP	#INVSPACE	;<$20 then it's a repeat count		BCC	@11	;'c'=0 then it's a repeat count		CLV		;Clear 'v' if mixed ASCII/MouseText@4		EQU	*		LDA	[PRINTTMP]	;Get a message character		BEQ	@7	;0 is terminator		CMP	#INVSPACE	;<$20 then it's a repeat count		BCC	@11	;'c'=0 then it's a repeat count		BVS	@5	;'v'=1 then last byte is 0 (DCI/MouseText)		BMI	@6	;'v'=0 then last byte is -		ORA	#$80	;Set hi bit to 1@5		EQU	*		PHP		;Must save 'v' 		JSR	COUTFF	;Print to screen		PLP		;Must restore 'v'@5_4		EQU	*		INC	PRINTTMP	;Inc to next character		BNE	@4	;If not 0 print more		INC	PRINTTMP+1	;Inc hi byte if here		BRA	@4	;Always go back for more@6		EQU	*	;Exit routine		JSR	COUTFF	;Output last character@7		EQU	*	;Exit routine		REP	#$30	;16 bit land to save time		PLA		;Restore zero page used		STA	PRINTTMP+2	;		PLA		;		STA	PRINTTMP+0	;		SEP	#$30	;8 bit land a must for monitor		RTS		;Back to caller* Repeat characters is handled as follows:*   If LDA [PRINTTMP] = <$20 then the following is true.*      The byte is the repeat indicator / number of times to repeat.*      The byte after that is the repeat character.@11		EQU	*		TAY		;Move to index as counter		INC	PRINTTMP	;Inc to next character		BNE	@112	;If not 0 then let hi byte alone		INC	PRINTTMP+1	;Inc hi byte if here@112		EQU	*		LDA	[PRINTTMP]	;Get repeat character		PHY		;Save 'Y' around print		BVS	@114	;'v'=1 then do not modify character		ORA	#$80	; else set hi bit.@114		EQU	*		PHP		;Preserve 'v' status		JSR	COUTFF	;Print character		PLP		;Restore 'v' status		PLY		;Recall counter		DEY		;		BNE	@112	;Loop til done repeating		BRA	@5_4	;Continue normal printing	; SEG $FFNEWCMDSTBL	EQU	*	; SEG $00		DC.B	'A'	;'A' location change entry		DC.B	'X'	;'X' location change entry		DC.B	'Y'	;'Y' location change entry		DC.B	'S'	;'S' location change entry		DC.B	'D'	;'D' location change entry		DC.B	'P'	;'P' location change entry		DC.B	'B'	;'B' location change entry		DC.B	'K'	;'K' location change entry		DC.B	'M'	;'M' location change entry		DC.B	'Q'	;'Q' Location change entry		DC.B	'L'	;'L' location change entry		DC.B	'm'	;'m' location change entry		DC.B	'x'	;'x' location change entry		DC.B	'e'	;'e' location change entry		DC.B	'd'	;'d' location change entry		DC.B	'F'	;'F' location change entry		DC.B	'V'	;'V' set video mode to resume w/		DC.B	'T'	;Display current time command		DC.B	$8D	;Convert hex input to ASCIINEWCMDLEN		EQU	*-NEWCMDSTBL		DCB.B	3,0	;pad up to $C100