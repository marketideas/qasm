		TITLE	'Control Panel Equates';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d4 on 5/8/91 at 8:41:35 PM*******************************************************                                                    **       Equates for Control Panel Desk Accessory     **                                                    **                         by                         **                    Fern Bachman                    **                                                    **      Copyright Apple Computer, Inc. 1985-1987      **                All Rights Reserved.                **                                                    *******************************************************CP_ZPAGE		EQUSECT	$0CURSCRN		EQUDS.B	1	;Current screen activeCURLINE		EQUDS.B	1	;Current line in active screen in useNEWLINE		EQUDS.B	1	;Line user has moved toCUROPTION		EQUDS.B	1	;Current option active in line in useNUMLINES		EQUDS.B	1	;Number of lines+1 for active screenNUMOPTS		EQUDS.B	1	;Number of options on current line		EQUORG	CP_ZPAGE+$06	Pad to next monitor usage point		EQUDS.A	1	;6-8 are used by print routineZINT		EQUDS.W	1	;Used in interrupt routineZINTSHBUF		EQUDS.B	16	;Save slot0/3 scrn holes here on interruptSHIFTER		EQUDS.L	1	;Used in shifting routinesSTATBYTE		EQUDS.B	1	;Screen information status byte		EQUORG	CP_ZPAGE+$50	Pad to next monitor usage pointTOTALSRAM		EQUDS.L	1	;Total RAM in system in bytesTOTALFRAM		EQUDS.L	1	;Total free RAM in system in bytesFREERAM		EQUDS.L	1	;Free RAM for RAMDISK in bytesCURRENTRAM	EQUDS.L	1	;Current Ramdisk Size in bytesPROGRAMRAM	EQUDS.L	1	;RAM Used for Program in bytesZMONTH		EQUDS.B	1	;Month on screenZDAY		EQUDS.B	1	;Day on screenZYEAR		EQUDS.B	1	;Year on screenZDATE		EQUDS.B	1	;Mirrors USERDATE in bank E1Z24HOUR		EQUDS.B	1	;24 hour timeZMINUTE		EQUDS.B	1	;Minute on screenZSECOND		EQUDS.B	1	;Second on screenZAMPM		EQUDS.B	1	;Mirrors USERAMPM in bank E1ZHOUR		EQUDS.B	1	;12 hour / 24 hour time for screenZAMPMASCII	EQUDS.W	1	;2 bytes of ASCII ('AM' or 'PM' or '  ')* CASCIITIME buffer format is as follows**       'nn/dd/yy hh:mm:ss am/pm'** ReadAsciiTime -- Function number RATFN*      Input stack:  SP+4 = Null*                    SP+3 = ASCII buffer bank number*                    SP+2 = ASCII buffer hi byte of address*                    SP+1 = ASCII buffer lo byte of address*                          *      PEA $0000+^CASCIITIME ;Null byte + bank number*      PEA CASCIITIME ;Address of buffer*      INDEX16*      LDX #RATFN*256+MTN   ;Function number*256 + Misc Tool number*      INDEX8*      JSL =DISPATCH1  ;Call main Tool Locator**      Return data is in buffer CASCIITIME** ReadTimeHex -- Function number RTHFN*     Input stack:   SP+8 = Push room for day of week 0=Sunday*                    SP+7 = Push room for null byte*                    SP+6 = Push room for month*                    SP+5 = Push room for day*                    SP+4 = Push room for year*                    SP+3 = Push room for hour*                    SP+2 = Push room for minute*                    SP+1 = Push room for second**      Push room for day of week on stack 0=Sunday*      Push room for null byte on stack*      Push room for month on stack*      Push room for day on stack*      Push room for year on stack*      Push room for hour on stack*      Push room for minute on stack*      Push room for second on stack*      INDEX16*      LDX #RTHFN*256+MTN  ;Function number*256 + Misc Tool number*      INDEX8*      JSL =DISPATCH1  ;Call main Tool Locator**      Pull second from stack*      Pull minute from stack*      Pull hour from stack*      Pull year from stack*      Pull day from stack*      Pull month from stack*      Pull null byte from stack*      Pull day of week from stack 0=Sunday** WriteTimeHex -- Function number WTHFN*      Input stack:  SP+6 = Month*                    SP+5 = Day*                    SP+4 = Year*                    SP+3 = Hour*                    SP+2 = Minute*                    SP+1 = Second**      Push month on stack*      Push day on stack*      Push year on stack*      Push hours on stack*      Push minutes on stack*      Push seconds on stack*      INDEX16*      LDX #WTHFN*256+MTN  ;Function number*256 + Misc Tool number*      INDEX8*      JSL =DISPATCH1  ;Call main Tool Locator**             No values are returned from this call.*CASCIITIME	EQUDS.B	20	;Time in ASCII 'mm/dd/yy hh:mm:ss am/pm'DATE		EQU	CASCIITIME+0	;Date in whatever format starts hereDATE1		EQU	CASCIITIME+0	;+0/1 = month or day or yearDATE2		EQU	CASCIITIME+3	;+3/4 = month or dayDATE3		EQU	CASCIITIME+6	;+6/7 = year or dayTIME		EQU	CASCIITIME+9	;Time in whatever format starts hereHOUR		EQU	CASCIITIME+9	;+9/10 = hourMINUTE		EQU	CASCIITIME+12	;+12/13 = minuteSECOND		EQU	CASCIITIME+15	;+15/16 = secondsTIMEFMT		EQU	CASCIITIME+18	;+18/19 = AM-PM/24 hour formatREALLNTBL		EQUDS.B	16	;Indicates true offsets/dummy linesREALOPTTBL	EQUDS.B	16	;Indicates true option offset numberNUMFIRSTLN	EQUDS.B	1	;Msg num of first line of submenu screenOPTPTR		EQUDS.A	1	;Pointer to option message number pointersNOPTPTR		EQUDS.A	1	;Ptr to ptr to num of options per line tblDEFAULTPTR	EQUDS.A	1	;Pointer to default table of optionsBRAMPTR		EQUDS.A	1	;Pointer to current user optionsZKMSTATUS		EQUDS.B	1	;Irq enable status of key micro on entryZVGCINT		EQUDS.B	1	;Irq enable status of 1 sec timer on entryZIRQ_1SEC		EQUDS.L	1	;Previous contents of 1 sec int jmp vector		ENDSECT* MouseText characters usedCLAPPLE		EQU	$40	;MouseText close apple characterOPAPPLE		EQU	$41	;MouseText open apple characterCHECK		EQU	$44	;MouseText check characterTITLEBAR		EQU	$47	;MouseText title bar characterLEFTARROW		EQU	$48	;MouseText left arrow characterDOWNARROW		EQU	$4A	;MouseText down arrow characterUPARROW		EQU	$4B	;MouseText up arrow characterTOPLINE		EQU	$4C	;MouseText overline characterRETURN		EQU	$4D	;MouseText return characterCENTERLINE	EQU	$53	;MouseText center line characterRIGHTARROW	EQU	$55	;MouseText right arrow characterRIGHTLINE		EQU	$5A	;MouseText right line characterDIAMOND		EQU	$5B	;MouseText diamond characterDOUBLEBAR		EQU	$5C	;MouseText double bar characterLEFTLINE		EQU	$5F	;MouseText left line character* Miscellaneous characters usedDINDICATOR	EQU	CHECK	;Apple Default indicatorINVSPACE		EQU	$20	;Inverse space characterSPACE		EQU	$A0	;Normal space characterCLOSEPAREN	EQU	$A9	;Normal closed parenthesisLESSTHAN		EQU	$BC	;Normal '<' characterGREATERTHAN	EQU	$BE	;Normal '>' characterBOTTOMLINE	EQU	$DF	;Normal underline character* Misc equates used by Control Panel ProgramMOUSEIND		EQU	$00	;MouseText char is first indicatorTERMINATOR	EQU	$00	;ASCII string terminatorDEFPOSITION	EQU	$02	;Default indicator positionCPHPOSITION	EQU	$01	;Control panel menu horzontal positionCPVPOSITION	EQU	$01	;Control panel menu vertical positionMPOSITION		EQU	$05	;Vertical position to start main screenCLKPOSITION	EQU	$05	;Vertical position of clock boxSPOSITION		EQU	$05	;Vertical position to start submenu scrnLNPOSITION	EQU	$04	;Horizontal position for submenu linesSPECOPV		EQU	$08	;Vertical pstn of ctrl closed Apple startSPECOPH		EQU	$00	;Horizontal pstn of ctrl clsd Apple startWPOSITION		EQU	$10	;Vert position of AppleTalk warning msgFNPOSITION	EQU	$16	;Vertical position for footnotePRPOSITION	EQU	$17	;Horizontal position for boxesMTXTOFF		EQU	$18	;Disables MouseText printingMTXTON		EQU	$1B	;Enables MouseText printingLEFTAKEY		EQU	$88	;Left arrow keyDOWNAKEY		EQU	$8A	;Down arrow keyUPAKEY		EQU	$8B	;Up arrow keyRETURNKEY		EQU	$8D	;Carriage return keyCRRETURN		EQU	$8D	;Carriage return for printingCRRETURNL		EQU	$0D	;Carriage return for printingRIGHTAKEY		EQU	$95	;Right arrow keyESCKEY		EQU	$9B	;Escape key		TITLE	'Control Panel Tables Equates'*******************************************************                                                    **      Tables1 for Control Panel Desk Accessory      **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1985-1989           **                                                    **      Copyright Apple Computer, Inc. 1985-1989      **                All Rights Reserved.                **                                                    *******************************************************CP_MsgEquates	RECORD	0* Miscellaneous MessagesBOOTMSG		DS.B	1	;'I/O error!' message numberDISKMSG		DS.B	1	;'Not a bootable disk!' message numberDEVMSG		DS.B	1	;'No device connected!' message numberCHKDEVMSG		DS.B	1	;'Check startup device!' message numberTIMEMSG		DS.B	1	;'Time=' message numberSTEPMSG		DS.B	1	;'Step' message numberTRACEMSG		DS.B	1	;'Trace' message numberCBANKMSG		DS.B	1	;'Cbank' message numberDECMSG		DS.B	1	;'Decimal' message numberHEXMSG		DS.B	1	;'Hex' message numberARWDASHDOL	DS.B	1	;'-> $' message numberTLERRMSG		DS.B	1	;'Tool error= ' message numberSYSDMSG		DS.B	1	;'Fatal system error-> ' message number* Special entry to Control Panel ASCIISPCHOICES		DS.B	1	;Special entry ASCII* Desk Accessory TitleCPTITLE		DS.B	1	;' Control Panel' message number* Prompts / FootnotesTOSELUSE		DS.B	1	;'Select:' message numberUDSEL		DS.B	1	;' ^ v' message numberLRSEL		DS.B	1	;' < >' message numberOPENCR		DS.B	1	;'Open CR' message numberSAVECR		DS.B	1	;'Save CR' message numberCANCELESC		DS.B	1	;'Cancel ESC' message numberSPACEBOX		DS.B	1	;'|               |' message numberTOPBOX		DS.B	1	;' ______________ ' message numberBOTTOMBOX		DS.B	1	;' -------------- ' message numberAPS1S2L1		DS.B	1	;'ApTalk/Ser Prt1/Ser Prt2' msg # part 1APS1S2L2		DS.B	1	;'ApTalk/Ser Prt1/Ser Prt2' msg # part 2TWOAPTALK		DS.B	1	;'AppleTalk already Selected' message* Main MenuCPLN1		DS.B	1	;'Display' message numberCPLN2		DS.B	1	;'Sound' message numberCPLN3		DS.B	1	;'System Speed' message numberCPLN4		DS.B	1	;'Clock' message numberCPLN5		DS.B	1	;'Options' message numberCPLN6		DS.B	1	;'Slots' message numberCPLN7		DS.B	1	;'Port 1' message numberCPLN8		DS.B	1	;'Port 2' message numberCPLN9		DS.B	1	;'Ramdisk' message numberCPLN10		DS.B	1	;'Mouse' message number		DS.B	1	;'  ' message numberCPQUIT		DS.B	1	;'Quit' message numberMMLEN		EQU	*-CPLN1	;# of lines in main menu screen* Serial PortSERIALLN1		DS.B	1	;'Device Connected' message number		DS.B	1	;'Line Length' message number		DS.B	1	;'Delete First LF after CR' message number		DS.B	1	;'Add LF after CR' message number		DS.B	1	;'Echo' message number		DS.B	1	;'Buffering' message number		DS.B	1	;'Baud' message number		DS.B	1	;'Data/Stop Bits' message number		DS.B	1	;'Parity' message number		DS.B	1	;'DCD Handshake' message number		DS.B	1	;'DSR Handshake' message number		DS.B	1	;'XON/XOFF Handshake' message numberSERIALLEN		EQU	*-SERIALLN1	;# of lines for serial screens* DisplayDISPLN1		DS.B	1	;'Type' message numberDISPLN2		DS.B	1	;'Columns' message numberDISPLN3		DS.B	1	;'-Screen Colors-' message numberDISPLN4		DS.B	1	;'Text' message numberDISPLN5		DS.B	1	;'Background' message numberDISPLN6		DS.B	1	;'Border' message numberDISPLN7		DS.B	1	;'Standards' message numberDISPLN8		DS.B	1	;'  ' message numberDISPLN9		DS.B	1	;'Hertz' message numberDISPLEN		EQU	*-DISPLN1	;# of lines for display screen* System SpeedSYSSPDLN1		DS.B	1	;'System Speed' message numberSYSSPDLEN		EQU	*-SYSSPDLN1	;# of lines for system speed screen* SlotsSLOTSLN1		DS.B	1	;'Slot 1' message numberSLOTSLN2		DS.B	1	;'Slot 2' message numberSLOTSLN3		DS.B	1	;'Slot 3' message numberSLOTSLN4		DS.B	1	;'Slot 4' message numberSLOTSLN5		DS.B	1	;'Slot 5' message numberSLOTSLN6		DS.B	1	;'Slot 6' message numberSLOTSLN7		DS.B	1	;'Slot 7' message numberSLOTSLN8		DS.B	1	;'  ' message numberSLOTSLN9		DS.B	1	;'Startup Slot' message numberSLOTSLEN		EQU	*-SLOTSLN1	;# of lines for display screen* LanguageLANGLN1		DS.B	1	;'Language' message numberLANGLN2		DS.B	1	;'Keyboard' message numberLANGLN3		DS.B	1	;'Keyboard Buffering' message numberLANGLN4		DS.B	1	;'Repeat Speed' message numberLANGLN5		DS.B	1	;'Delay to Repeat' message numberLANGLN7		DS.B	1	;'Flash Rate of Cursor' message number		DS.B	1ADVANCED		DS.B	1	;'-Advanced Features-' message numberLANGLN8		DS.B	1	;'Shift Caps/Lower Case' message numberLANGLN9		DS.B	1	;'Fast Space/Delete Keys' msg numberLANGLN10		DS.B	1	;'Dual Speed Keys' message number		IF OPTION4 <> 0 THENLANGLN11		DS.B	1	;'Disk1 Eject' message numberLANGLN12		DS.B	1	;'Disk2 Eject' message number		ENDIFLANGLEN		EQU	*-LANGLN1	;# of lines for language screen* ClockCLOCKLN1		DS.B	1	;'Month' message numberCLOCKLN2		DS.B	1	;'Day' message numberCLOCKLN3		DS.B	1	;'Year' message numberCLOCKLN4		DS.B	1	;'Format' message numberCLOCKLN5		DS.B	1	;'  ' message numberCLOCKLN6		DS.B	1	;'Hour' message numberCLOCKLN7		DS.B	1	;'Minute' message numberCLOCKLN8		DS.B	1	;'Second' message numberCLOCKLN9		DS.B	1	;'Format' message numberCLKLEN		EQU	*-CLOCKLN1	;# of lines for clock screen* RamdiskRAMDSKLN1		DS.B	1	;'Select Ramdisk Size' message number;RAMDSKLN2 DS 1,0 ;'Maximum Ramdisk Size' message numberRAMDSKLN3		DS.B	1	;'-Largest Selectable Size' message numberRAMDSKLN4		DS.B	1	;'  ' message numberRAMDSKLN4_2	DS.B	1	;'-RAM Status-' message numberRAMDSKLN5		DS.B	1	;'Ramdisk Size' message numberRAMDSKLN6		DS.B	1	;'Total RAM in Use' message numberRAMDSKLN7		DS.B	1	;'Total Free RAM' message numberRAMDSKLN8		DS.B	1	;' ' message numberRAMDSKLN9		DS.B	1	;'Reset Ramdisk during next Cntl-Apple-Reset'RAMDSKLEN		EQU	*-RAMDSKLN1	;# of lines for ramdisk screen* SoundSOUNDLN1		DS.B	1	;'Volume' messag2 numberSOUNDLN2		DS.B	1	;'  ' message numberSOUNDLN3		DS.B	1	;' Pitch' message numberSNDLEN		EQU	*-SOUNDLN1	;# of lines for sound screen* MouseMOUSELN1		DS.B	1	;'Mouse Tracking' message numberMOUSELN2		DS.B	1	;'Double click' message number		DS.B	1	;'   ' message numberADVMSEMSG		DS.B	1	;'Keyboard Mouse' msg number                 MOUSELN3		DS.B	1	;'Start Delay' message numberMOUSELN4		DS.B	1	;'Acceleration' message numberMOUSELN5		DS.B	1	;'Maxm Speed ' message numberMOUSELEN		EQU	*-MOUSELN1		EJECT* Serial Port OptionsPORTOP1_0		DS.B	1	;'Printer' message number		DS.B	1	;'Modem' message number		DS.B	1	;'AppleTalk' message number		DS.B	1	;'Your Card' message numberNPORTOP1_0	EQU	*-PORTOP1_0PORTOP2_0		DS.B	1	;'Unlimited' message number		DS.B	1	;'40' message number		DS.B	1	;'72' message number		DS.B	1	;'80' message number		DS.B	1	;'132' message numberNPORTOP2_0	EQU	*-PORTOP2_0RAMDSKOP8_0	EQU	*LANGOP8_0		EQU	*LANGOP9_0		EQU	*LANGOP3_0		EQU	*DISPOP3_0		EQU	*PORTOP12_0	EQU	*PORTOP11_0	EQU	*PORTOP10_0	EQU	*PORTOP6_0		EQU	*PORTOP5_0		EQU	*PORTOP4_0		EQU	*PORTOP3_0		DS.B	1	;'No' message number		DS.B	1	;'Yes' message numberNPORTOP3_0	EQU	*-PORTOP3_0NPORTOP4_0	EQU	*-PORTOP4_0NPORTOP5_0	EQU	*-PORTOP5_0NPORTOP6_0	EQU	*-PORTOP6_0NPORTOP10_0	EQU	*-PORTOP10_0NPORTOP11_0	EQU	*-PORTOP11_0NPORTOP12_0	EQU	*-PORTOP12_0NDISPOP3_0	EQU	*-DISPOP3_0NLANGOP3_0	EQU	*-LANGOP3_0NLANGOP9_0	EQU	*-LANGOP9_0NLANGOP8_0	EQU	*-LANGOP8_0NRAMDSKOP8_0	EQU	*-RAMDSKOP8_0PORTOP7_0		DS.B	1	;'50' message number		DS.B	1	;'75' message number		DS.B	1	;'110' message number		DS.B	1	;'134.5' message number		DS.B	1	;'150' message number		DS.B	1	;'300' message number		DS.B	1	;'600' message number		DS.B	1	;'1200' message number		DS.B	1	;'1800' message number		DS.B	1	;'2400' message number		DS.B	1	;'3600' message number		DS.B	1	;'4800' message number		DS.B	1	;'7200' message number		DS.B	1	;'9600' message number		DS.B	1	;'19200' message numberNPORTOP7_0	EQU	*-PORTOP7_0PORTOP8_0		DS.B	1	;'5/1' message num