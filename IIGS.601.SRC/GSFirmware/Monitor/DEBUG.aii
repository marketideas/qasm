		TITLE	'Miscellaneous Debug0 Routines';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d5 on 5/9/91 at 6:30:4 PM*******************************************************                                                    **             Miscellaneous Debug0 Routines          **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    ******************************************************** ZMEMORY zaps memory with the contents of A4L.** User entry format is   zz < bb1/addr1.bb2/addr2Z** A4L contains zap data on entry to here* A1L/A1H contains starting address to zap* A2L/A2H contains last address to zap* EXTENDBNKS contains bb1 if specified else is zero, see the*  conditions in XMOVE1 !!!* A4L/A4H is set to starting address+1 to zapZMEMORY		EQU	*	;Zap memory		LDA	>BANKS	;Make source bank = destination bank		STA	>BANKD	;		LDY	A4L	;Get zap character		REP	#$30	;16 bit land please		LDA	A1L	;Make destination address		STA	A4L	; the save as source address.		DEC	A2L	;Fix pointer		SEP	#$30	;Back to 8 bit land		TYA		;Save zap char as 1 byte in destination		LDX	#A4L	;Needed for STORBYTE		JSR	STORBYTE	;		REP	#$30	;Off to 16 bit land		INC	A4L	;Create new destination address		SEP	#$30	;Back to 16 bit land* Fall into to XMOVE1 to do actual zap and exit.* Move a block of memory** User entry format: aa/addr0 < bb1/addr1.bb2/addr2M                   **  if bb2 < bb1 then invalid and move one byte  *  if bb2 is not specified then assume bb2 = bb1 AND*   if addr2 < addr1 then illegal and move one byte*  if bb2 > bb1 then valid and it is crossing bank XMOVE1		EQU	*		LDA	STATEREG	;Save memory state		CMP	LCBANK2	;Write enable language card		CMP	LCBANK2	;Write enable language card		PHA		;		PHB		;		AND	#$F2	;Set slot LCRAM/BANK1/SLOTROMCXROM to read		PHA		;Save for later		LDA	>LVAL	;Check which LC bank to enable		ASL	A	;Bit 2=1 for bank1 else leave bank 0		ASL	A	;		ORA	1,S	;Or in status byte on stack		STA	STATEREG	;		PLA		;Clean up stack*		REP	#$20	;16/8 bit m/x		LONGA	ON		LONGI	OFF		PHB		;Save data bank		JSR	DBTOE1	;Change to $e1 bank		LDX	#$0	;    		PHX		;Make hgh byte of hgh word src ptr = 0		LDY	|BANKS	;Get low byte of high word source pointer'		PHY		;		LDA	A1L	;Get 16 bit low word of source address		PHA		;		PHX		;Make hgh byte of hgh word dest ptr = 0		LDY	|BANKD	;Get low byte of high word dest pointer		PHY		;		LDA	A4L	;Get 16 bit low word of dest address		PHA		;@1		EQU	*		LDA	|BANKS	;Get the source address starting bank		AND	#$00FF	;Mask off high word		PHA		;Save on stack for later		TAX		CPX	|HIGHBANK	;CHK for crossing bank		BEQ	@0	;Bra if no		BCC	@3	;Bra if yes;PHX ;LDX :EXTENDBNKS ;Not cross bank, but could be user;BNE @5.1 ; doesn't specify ending bank;PLX  ;If not specify then make end = start bank;STX :EXTENDBNKS ;BRA @0 ;Continue on;@5.1 EQU *;PLX ;		STX	|HIGHBANK	;@5		EQU	*		LDA	#$0001	;If usr do specify end bank, but end bank		SEC		; less than start bank, illegal !!		BRA	@6	;Just move one byte@0		EQU	*		LDA	A2L	;If same bank, how about start/end address		CMP	A1L	;If start > end, fine		BCC	@5	;Else just move one byte@3		EQU	*		SEC		;Set 'c'=1 for sbc		LDA	A2L	;Get low word of ending address		SBC	A1L	;Low word count, ending - starting		INC	A	;Actual transfer count to MEMMOVER@6		EQU	*		STA	A2L	;Temp store 		BNE	@2	;Is it already at $ffff ?  		INC	|HIGHBANK	;If at $ffff, adjust bank byte by 1 first@2		EQU	*		LDA	|HIGHBANK	;Ending bank of source address		AND	#$00FF	;Mask off unwanted		SBC	1,S	;Calculate for high word of transfer count		AND	#$00FF	;		STA	1,S	;Store result on stack		LDA	A2L	;Restore low word of count		PHA		;Store to stack		LDA	#$0805	;Command word for move_info, use movesincdinc		PHA		;		REP	#$30	;Set to 16 bit 'x' also		JSL	>MEMMOVER	;Jmp to do the move		PLB		;Restore data bank		SEP	#$30	;8 bit land in the monitor		JMP	MEMEXIT		EJECTMOVETABLE		EQU	*		DC.W	MSCONDCON	;0 source constant-destination constant		DC.W	MSINCDCON	;1 source incs - destination constant		DC.W	MSDECDCON	;2 source decs - destination constant		DC.W	MABORTMOVE	;3 illegal move sequence requested		DC.W	MSCONDINC	;4 source constant - destination incs		DC.W	MABORTMOVE	;5 src/dest incs should never gets here		DC.W	MSDECDINC	;6 source decs - destination incs		DC.W	MABORTMOVE	;7 illegal move sequence requested		DC.W	MSCONDDEC	;8 source constant - destination decs		DC.W	MSINCDDEC	;9 source incs - destination decs		DC.W	MABORTMOVE	;a src/dest decs should never gets here		DC.W	MABORTMOVE	;b illegal move sequence requested		DC.W	MABORTMOVE	;c "		DC.W	MABORTMOVE	;d "		DC.W	MABORTMOVE	;e "		DC.W	MABORTMOVE	;f ";; move_info revision history;; the general move routine (m_sinc_dinc) algorithm in this program is based; on the one used by the memory manager. it has been updated for gs/os; purposes and in hopes that new hardware will take over this functionality                ; in the future.;; memory manager move routine is by rich williams in original iigs rom.; later modified for prodos16 by jim jatczynski.;; 1/04/88 fab 1st release as move_info routine by fern bachman jr.; 1/18/88 fab msdecdcon / msconddec needed cpy #$ffff in loop to test for; falling through an address into the next lower bank.; msincddec / msdecdinc fixed counter calculation in to; include count+1 when doing 8 bit increment.; mscondinc changed inc <dest to inc <dest+2 for correct dest; bank increment; performance statistics table added;; installed to monitor by Joe Bo         3/88;;===============================================================================;;===============================================================================;; performance statistics table;; # subroutine time/byte time/$10000 bytes;-------------------------------------------------------; 0 mscondcon 7.36 usec 485.8 msec; 1 msincdcon 9.30 usec 615.6 msec; 2 msdecdcon 10.48 usec 691.9 msec; 4 mscondinc 9.30 usec 615.6 msec; 5 msincdinc  2.78 usec 180.7 msec; 6 msdecdinc 18.20 usec 1209.0 msec; 8 msconddec 10.48 usec 691.9 msec; 9 msincddec 18.20 usec 1209.0 msec; a msdecddec  2.78 usec 180.8 msec;;===============================================================================;		EJECT;;===============================================================================; move_info;; Moves a block of data from a source location to a destination location.;; Calling sequence:; 1. Place machine in full native mode (e=0, m=0, x=0);; 2. Push high order word of source pointer onto stack; 3. Push low order word of source pointer; 4. Push high order word of destination pointer; 5. Push low order word of destination pointer; 6. Push high order word of transfer count; 7. Push low order word of transfer count;; 8. Push command byte; _______________________________________________; |  |  |  |  |  |  |  |  |  |  |  |  |  |  |  |  |; |15|14|13|12|11|10|09|08|07|06|05|04|03|02|01|00|; |__|__|__|__|__|__|__|__|__|__|__|__|__|__|__|__|;; bits 15/14 = reserved; bits 13/12/11 = move mode; = 000 =reserved; = 001 =block move; = 010-111 =reserved; bits 10/9/8/7 = reserved; bits 6/5/4 = reserved; bits 3/2 = destination incrementer; = 00 (+0) =constant destination; = 01 (+1) =increment destination by 1; = 10 (-1) =decrement destination by 1; = 11 =reserved; bits 1/0 = source incrementer; = 00 (+0) =constant source; = 01 (+1) =increment source by 1; = 10 (-1) =decrement source by 1; = 11 =reserved;; 9. jsl move_info;;		EJECT;; Stack on entry; _______________________________________; |                                       |; |- high word of source pointer          |; |_______________________________________| s+$10; |                                       |; |- low word of source pointer           |; |_______________________________________| s+$0e; |                                       |; |- high word of destination pointer     |; |_______________________________________| s+$0c; |                                       |; |- low word of destination pointer      |; |_______________________________________| s+$0a; |                                       |; |- high word of transfer count          |; |_______________________________________| s+$08; |                                       |; |- low word of transfer count           |; |_______________________________________| s+$06; |                                       |; |- command word                         |; |_______________________________________| s+$04; |                                       |; |-                                      |; | return address                        |; |-                                      |; |_______________________________________| s+$01;;; Outputs: if no error then; a= $0000; c= 0; if error then; a= error code; c= 1; data bank and direct register are preserved; a= error code; x,y = scrambled;; Notes: The high byte of source, dest, and Count must be zero; The source and destination blocks must not overlap; This routine executes self modifying code on the stack; and therefore is romable and reentrant;===============================================================================;MMOVEEQU		EQU	*;; zero page locations used on stack;MSOURCE		EQU	$16	; 4-byte source addressMDEST		EQU	$12	; 4-byte destination addressMCOUNT		EQU	$0E	; 4-byte transfer countMMOVECOMMAND	EQU	$0C	; 2-byte command wordMRETURNMOVE	EQU	$09	; 3-byte return addressMTEMPCOUNT	EQU	$07	; 2-byte temporary transfer countMDOMOVE		EQU	$03	; 4-byte mvn 0000 / rtl instructionsMSTACKUSED	EQU	$14	; number of bytes on stack used	; SEG $ffMEMMOVER		EQU	*	; SEG $00		LONGA	ON		LONGI	ON		PHA		; push two bytes on stack for tempcount		PEA	$6b00	;push an rtl instruction onto stack; note the a place holder of $00 was left on the stack when the rtl instrucion; was placed on the stack. that byte will become the high byte of the operand; for the mvn instruction about to be pushed onto the stack;; now put an mvn xxxx instruction on the stack (operand is modified later)		PEA	$0054	;mvn and low byte of mvn operand		PHD		; save user's direct page pointer 'd'		TSC		; make direct page correspond to stack		TCD; zero page is now on stack here;; zero page after pha, phd, push of 'mvn xxxx, rtl' tsc and tcd; _______________________________________; |                                       |; |- high word of source pointer          |; |_______________________________________| $18; |                                       |; |- low word of source pointer           |      ; |_______________________________________| $16; |                                       |; |- high word of destination pointer     |; |_______________________________________| $14; |                                       |; |- low word of destination pointer      |; |_______________________________________| $12; |                                       |; |- high word of transfer count          |; |_______________________________________| $10; |                                       |; |- low word of transfer count           |; |_______________________________________| $0e; |                                       |; |- command word                         |; |_______________________________________| $0c; |                                       |; |-                                      |; | return address                        |; |-                                      |; |_______________________________________| $09; |                                       |; |- temp count word                      |; |_______________________________________| $07; | rtl                                   |; |_______________________________________| $06; |                                       |; |-                                      |; | domove mvn 0000 ;(modified code)      |; |-                                      |; |_______________________________________| $03; |                                       |; |- user's direct page                   |; |_______________________________________| $01;;; stack moves down when phb info, rtl's info, and rts are placed on stack; _______________________________________; | user's data bank register             |; |_______________________________________|; | rts back from jsr domvxonstack        |; |-                                      |; |_______________________________________|; |                                       |; |-                                      |; | rtl which points to continuation addr |; |-                                      |; |_______________________________________|; |                                       |; |-                                      |; | rtl which points to domove            |; |-                                      |; |_______________________________________|;		PHB		; save dbr on stack (mvn trashes it)		LDA	msource+2	;is high byte of dest/src/count = 0 ??		ORA	mdest+2		ORA	mcount+2		AND	#$ff00		BNE	mabortmove	;not = then a high byte <>=0 was found; if the number of bytes to move equals zero we are done before we started		LDA	mcount		ORA	mcount+2		BEQ	mmovefinished	;finished before we started (ha! ha!); to speed up the most common move routine we will check for it now and; not let it go through the normal move dispatcher		LDA	mmovecommand	;test if valid or not		CMP	#movesincdinc	;test for most common mode first		BEQ	msincdinc	;= then do it quickly; to speed up the second most common move routine we will check for it now and; not let it go through the normal move dispatcher		CMP	#movesdecddec	;test for the 2nd most common mode first		BNE	moveinfo4		JMP	msdecddec	;= then do it quickly; the next 'bit' instruction uses a mask to test for invalid commands and; invalid options. this mask (found in equates/common.equ) must change as; other commands become valid.;MOVEINFO4		EQU	*		BIT	#movevaliditymask	;reserved bits set?		BNE	mabortmove		BIT	#moveblkcmd	;if moveblkcmd bit isn't set then error		BEQ	mabortmove; if we fall to here then figure out which move to do		AND	#$000f	;upper 3 nibbles are not important		ASL	a	;set up 'x' to get to rest of moves		TAX; most of the move routines need this function so all routines will incur the; overhead. this is better and shorter than making it a callable subroutine.; make count into 2's complement so we can increment to $00000000 instead of; decrementing to $00000000 since it is faster to increment than decrement; 32 bits worth of data (no compares needed).		LDA	mcount	;low word of count		EOR	#$ffff	;		TAY		;save for later		LDA	mcount+2	;high word of count		EOR	#$ffff	;'a'=high word and 'y'=low word now		INY		;make 2's complement now		BNE	moveinfo8		INC	aMOVEINFO8		EQU	*		STY	mcount	;leave on zero page		STA	mcount+2	;leave on zero page; warning - code that gets jumped to from here assumes count is in 'y'		JMP	(movetable,x)	;off to routine; common exit routine is here. all errors and move routines finish up here.MMOVEFINISHED	EQU	*	;no bytes left to move		CLC		;indicate no error encountered		BCC	NOmabortmoveMABORTMOVE	EQU	*		SEC		;indicate an error was encounteredNOMABORTMOVE	EQU	*		REP	#$30	;must exit in full native mode		PLB		; restore dbr		LDA	mreturnmove	; move return address past parameters		STA	msource+1		LDA	mreturnmove+1	; move return address past parameters		STA	msource+2		PLD		; restore user's direct register		TSC		; set s to proper value		PHP		;save 'c' around addition		CLC		ADC	#mstackused	;number of bytes used on stack		PLP		;restore correct exit 'c'		TCS		;fix up stack; Set 'a' correctly for exit based on 'c'		LDA	#$0000	;assume no errors		BCC	cleanexit	;		LDA	#parmrangeerr	;it's an error if hereCLEANEXIT		EQU	*		RTLMSINCDINC		EQU	*	;5 source incs - destination incs; move with incrementing source address and incrementing destination address; get ready to do the standard move		JSR	setupformvx	;set up for mvn/mvp		BRA	mmdfirst; main move loopMMDMORE		EQU	*		STA	mcount+2	; more bytes to move		LDA	mdomove+1	; a = srcdst banks		CPX	#$0001	; bank cross? if x=0		BCS	mmdxnot0		ADC	#$0100	; add 1 to source bankMMDXNOT0		EQU	*		CPY	#$0000	; did destination cross bank?		BNE	mmdyis0		INC	aMMDYIS0		EQU	*		STA	mdomove+1MMDFIRST		EQU	*		TXA		; if count > -x then bank cross		EOR	#$ffff		CMP	mtempcount		BCS	mmdxok		STA	mtempcount	; only move -x bytesMMDXOK		EQU	*		TYA		; will destination cross bank?		EOR	#$ffff		CMP	mtempcount		BCS	mmdyok		STA	mtempcount	; only move -y bytesMMDYOK		EQU	*		JSR	domvxonstack		BPL	mmdmore		JMP	mmovefinishedMSCONDCON		EQU	*	;0 source constant -destination constant;move with the source = constant address and the dest = constant address; 'y' contains count on entry		LDX	mcount+2	;high byte of count in 'x';; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since mmovefinished does; it for us.		SEP	#$20	;make 'a' register 8 bits;MSCONDCONLP	EQU	*		LDA	[msource]	;indirectly get source information		STA	[mdest]	; and write it to the dest location; decrement counter by incrementing it to $00000000		INY		;increment move counter here		BNE	mscondconlp	;loop if didn't drop to zero yet		INX		;increment high byte of move counter		BNE	mscondconlp	;loop if done		JMP	mmovefinishedMSINCDCON		EQU	*	;1 source incs - destination constant;;move with the source = incrementing address and the dest = constant address; 'y' contains count on entry		TYX		;low word of count is in 'y' on entry		LDY	#$0000	;start at first source byte;; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since mmovefinished does; it for us.		SEP	#$20	;must use 8 bit 'a' registerMSINCDCONLP	EQU	*		LDA	[msource],y	;get value to write		STA	[mdest]	; and write it to constant location; set up for new source address		INY		;go to next source location		BNE	msincdconlp2	;loop if not = 0 yet; the next inc is an eight bit increment but that is ok since the high; byte of the high word is always zero to start anyway		INC	msource+2	;increment bank number; decrement counter by incrementing it to $00000000MSINCDCONLP2	EQU	*		INX		;increment to 0		BNE	msincdconlp	;loop if not done		INC	mcount+2	;increment low byte of count word		BNE	msincdconlp	;not = 0 then just continue		INC	mcount+3	;increment upper byte of word too		BNE	msincdconlp	;loop if not done		JMP	mmovefinished	;all done so exitMSDECDCON		EQU	*	;2 source decs - destination constant;move with the source = decrementing address and the dest = constant address; 'y' contains count on entry		TYX		;low word of count		LDY	msource	;start at first source address		STZ	msource	;reset source pointer; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since mmovefinished does; it for us.		SEP	#$20	;must use 8 bit 'a' registerMSDECDCONLP	EQU	*		LDA	[msource],y	;get next data byte to move		STA	[mdest]	;store at constant destination		DEY		;decrement to next source location		CPY	#$ffff	;dec through 0 then adjust source bank		BNE	msdecdconlp2	;<>= then do some more; the next dec is an eight bit decrement but that is ok since the caller; should never be decrementing in bank $00 and expect to go into bank $ff.;		DEC	msource+2	;decrement source bank;; decrement counter by incrementing it to $00000000MSDECDCONLP2	EQU	*		INX		;adjust counter		BNE	msdecdconlp	;<>= then do some more		INC	mcount+2	;increment low byte of count word		BNE	msdecdconlp	;not = 0 then just continue		INC	mcount+3	;increment upper byte of word too		BNE	msdecdconlp	;<>= then do some more		JMP	mmovefinished	;done when we fall to hereMSCONDINC		EQU	*	;4 source constant - destination incs;move with the source = constant address and the dest = incrementing address; 'y' contains count on entry		TYX		;low word of count		LDY	#$0000	;start at first destination byte; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since mmovefinished does; it for us.		SEP	#$20	;must use 8 bit 'a' register;MSCONDINCLP	EQU	*		LDA	[msource]	;get constant value to write		STA	[mdest],y	; and write it to incrementing location; set up for new source address		INY		;go to next source location		BNE	mscondinclp2	;loop if not = 0 yet; the next inc is an eight bit increment but that is ok since the high; byte of the high word is always zero to start anyway		INC	mdest+2	;increment bank number;; decrement counter by incrementing it to $00000000MSCONDINCLP2	EQU	*		INX		;increment to 0		BNE	mscondinclp	;loop if not done		INC	mcount+2	;increment low byte of count word		BNE	mscondinclp	;not = 0 then just continue		INC	mcount+3	;increment upper byte of word too		BNE	mscondinclp	;loop if not done		JMP	mmovefinished	;all done so exitMSDECDINC		EQU	*	;6 source decs - destination incs;move with the source = decrementing address and the dest = incrementing address		LDY	msource	;decrementing address		STZ	msource	;reset source address		LDX	#$0000	;incrementing address; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since mmovefinished does; it for us.		SEP	#$20	;must use 8 bit 'a' registerMSDECDINCLP	EQU	*		LDA	[msource],y	;get a byte to transfer		PHY		;save 'y'		TXY		;get destination address		STA	[mdest],y	;save the byte		PLY		;restore source index		DEY		;next source index		CPY	#$ffff	;did we fall through 0 ??		BNE	msdecdinclp2	;if not go here; the next dec is an eight bit decrement but that is ok since the caller; should never be decrementing in bank $00 and expect to go into bank $ff.		DEC	msource+2	;back up a bankMSDECDINCLP2	EQU	*		INX		;next destination index		BNE	msdecdinclp4	;loop if no bank cross; the next inc is an eight bit increment but that is ok since the high; byte of the high word is always zero to start anyway		INC	mdest+2	;next bank please; decrement counter by incrementing it to $00000000MSDECDINCLP4	EQU	*		INC	mcount	;increment low word of count		BNE	msdecdinclp		INC	mcount+1		BNE	msdecdinclp		INC	mcount+2	;increment upper word of count		BNE	msdecdinclp		INC	mcount+3		BNE	msdecdinclp	;loop if not done		JMP	mmovefinished	;exit via common routinesMSCONDDEC		EQU	*	;8 source constant - destination decs;move with the source = constant address and the dest = decrementing address; 'y' contains count on entry		TYX		;low word of count		LDY	mdest	;start at first destination address		STZ	mdest	;reset destination pointer; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since mmovefinished does; it for us.		SEP	#$20	;must use 8 bit 'a' registerMSCONDDECLP	EQU	*		LDA	[msource]	;get constant source byte		STA	[mdest],y	;store at decrementing destination		DEY		;decrement to next source location		CPY	#$ffff	;dec through 0 then adjust dest bank		BNE	msconddeclp2	;<>= then do some more; the next dec is an eight bit decrement but that is ok since the caller; should never be decrementing in bank $00 and expect to go into bank $ff.		DEC	mdest+2	;decrement source bank; decrement counter by incrementing it to $00000000MSCONDDECLP2	EQU	*		INX		;adjust counter		BNE	msconddeclp	;<>= then do some more		INC	mcount+2	;increment low byte of count word		BNE	msconddeclp	;not = 0 then just continue		INC	mcount+3	;increment upper byte of word too		BNE	msconddeclp	;<>= then do some more		JMP	mmovefinished	;done when we fall to hereMSINCDDEC		EQU	*	;9 source incs - destination decs;move with the source = incrementing address and the dest = decrementing address		LDY	#$0000	;incrementing address		LDX	mdest	;decrementing address		STZ	mdest	;reset destination address; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since mmovefinished does; it for us.		SEP	#$20	;must use 8 bit 'a' registerMSINCDDECLP	EQU	*		LDA	[msource],y	;get a byte to transfer		PHY		;save 'y'		TXY		;get destination address		STA	[mdest],y	;save the byte		PLY		;restore source index		INY		;next source index		BNE	msincddeclp2	;if not go here; the next inc is an eight bit increment but that is ok since the high; byte of the high word is always zero to start anyway		INC	msource+2	;next bankMSINCDDECLP2	EQU	*		DEX		;next destination index		CPX	#$ffff	;fallen through $0000 yet??		BNE	msincddeclp4	;loop if no bank cross; the next dec is an eight bit decrement but that is ok since the caller; should never be decrementing in bank $00 and expect to go into bank $ff.		DEC	mdest+2	;next bank please; decrement counter by incrementing it to $00000000MSINCDDECLP4	EQU	*		INC	mcount	;increment low word of count		BNE	msincddeclp		INC	mcount+1		BNE	msincddeclp		INC	mcount+2	;increment upper word of count		BNE	msincddeclp		INC	mcount+3		BNE	msincddeclp	;loop if not done		JMP	mmovefinished	;exit via common routinesMSDECDDEC		EQU	*	;a source decs - destination decs; move with decrementing source address and decrementing destination address; set the move instuction in zero page to mvp;		LDA	#$0044	;mvp instruction		STA	mdomove	;upper byte doesn't matter it's modified		JSR	setupformvx	;set up for mvn/mvp		BRA	ddmmdfirst; main move loopDDMMDMORE		EQU	*		STA	mcount+2	; more bytes to move		LDA	mdomove+1	; 'a' = srcdst banks		CPX	#$ffff	; bank cross? if x=0		BNE	ddmmdxnot0		SEC		SBC	#$0100	; subtract 1 to source bankDDMMDXNOT0	EQU	*		CPY	#$ffff	; did destination cross bank?		BNE	ddmmdyis0		DEC	aDDMMDYIS0		EQU	*		STA	mdomove+1DDMMDFIRST	EQU	*		TXA		; if count > source then bank cross		CMP	mtempcount		BCS	ddmmdxok		STA	mtempcount	; only move source bytesDDMMDXOK		EQU	*		TYA		; will destination cross bank?		CMP	mtempcount		BCS	ddmmdyok		STA	mtempcount	; only move dest bytesDDMMDYOK		EQU	*		JSR	domvxonstack		BPL	ddmmdmore		JMP	mmovefinished	;exit via common routinesSETUPFORMVX	EQU	*; set up the self modifying code to contain destination; and source in operand of mvn/mvp instruction constructed on stack.		LDA	msource+2	;get source bank		XBA		ORA	mdest+2	;or in destination bank		STA	mdomove+1	;put bank into mvn/mvp instruction; decrement count because it contains actual transfer count whereas; remainder of routine assumes it contains transfer count - 1		LDA	mcount		BNE	mara1		DEC	mcount+2MARA1		EQU	*		DEC	mcount; a move instuction is already on zero page at this point in the code; initialize registers and tempcount for mvn/mvp on stack		LDX	msource	; X = low word of source		LDY	mdest	; Y = low word of dest		LDA	mcount		STA	mtempcount		RTSDOMVXONSTACK	EQU	*; set up the address to rtl to which does the mvn on stack; this is the equivalent of a self modifying jmp absolute long instruction.		PHK		;push rtl return on stack		PEA	mcontdomove-1	;push rtl return address-1 on stack		PEA	$0000	;we'll leave high byte $00 on stack		PLB		; for setting correct execution bank.		TSC		;where are we now?		CLC		ADC	#$0009	;where are we going?; +2 around user's direct page on stack; +1 around user's data bank on stack; +3 around m_contdomove rtl info on stack; +2 around rts from jsr domvxonstack; +1 around execution bank just put on stk		PHA		;full rtl info on stack		LDA	mtempcount	; get the number of bytes to move		RTL		;execute on stack in case we're in romMCONTDOMOVE	EQU	*	;return here after mvn		LDA	mcount	; count = count - bytes moved		CLC		; actual bytes moved 1 more than count		SBC	mtempcount		STA	mcount		STA	mtempcount		LDA	mcount+2		SBC	#$0000		RTS		TITLE	'Miscellaneous Debug2 Routines'*******************************************************                                                    **             Miscellaneous Debug2 Routines          **                                                    **                    by                              **               Fern Bachman     1985-1987           **               Joe Bo           1987-1989           **                                                    **       Copyright Apple Computer, Inc. 1985-1989     **                All Rights Reserved.                **                                                    *******************************************************XVFY		EQU	*		LONGA	OFF		;8 bit land		LONGI	OFF		LDA	>HIGHBANK	;CHK for crossing bank		CMP	>BANKS	;		BEQ	@0	;Bra if not		BCC	@0	;Bra if EXTENDBNKS < BANKS    		LDA	A2H	;Cross bank, temp store A2 		PHA		; and temp set to $ffff of that bank		PHA		LDA	#$FF		STA	A2H		STA	A2L@0		EQU	*		JSR	READBYT1	;VERIFY (A1) THRU (A2)		PHA		LDX	#A4L		JSR	READBYTE		STA	A3L		PLA		CMP	A3L		BEQ	@1		PHA		JSR	PRADDR		PLA		JSR	PRBYTEFF		JSR	PR1BLNKFF		LDA	#$A8		JSR	COUTFF		LDA	A3L		JSR	PRBYTEFF		LDA	#$A9		JSR	COUTFF@1		EQU	*		JSR	NXTA4		PHP		;Save the returned 'c'		LDA	A4H	;CHK destination bank (A4) at bank boundary or not ?		ORA	A4L		BNE	@00	;Bra if not		LDA	>BANKD	;Else need to increase source bank		INC	A		STA	>BANKD	;?? NO INC =BANKD@00		EQU	*		PLP		;Get 'c'		BCC	@0	;Bra if source address not yet hit its high address@3		EQU	*		LDA	>BANKS	;CHK if source bank already passer bank $ff		INC	A		PHA		;Temp save		BEQ	@4	;Bra if previous one is $ff		CMP	>HIGHBANK	;Compare for source ending bank		BEQ	@5	;Bra if source start bank = end bank, prepare to exit 		BCS	@4	;If already greater than, then exit		PLA		STA	>BANKS	;Store as new source start bank		STZ	A1H	;Set new bank starting address to $0000		STZ	A1L		LDA	#$FF	;And ending address to $ffff		STA	A2H		STA	A2L		BRA	@0	;Bra to continue on@5		EQU	*		PLA		;Get back new bank		STA	>BANKS		PLA		;Get back the user's high address, A2H		STA	A2L		PLA		STA	A2H		BRA	@0	;Bra to continue for partial bank@4		EQU	*		PLA		;Clean stack and exit		RTS*READBYT1		EQU	*		LDX	#A1L	;read from bank 1READBYTE		EQU	*		CLV		;V clear for read		BVC	MEMACC1STORBYTE		EQU	*		SEP	#$40	;V set for writeMEMACC1		EQU	*		XBA		;Save 'A' in 'B'		LDA	STATEREG	;Save memory state		CMP	LCBANK2	;[Write enable the language card always]		CMP	LCBANK2	;[Write enable the language card always]		PHA		;		PHB		;Save data bank register		AND	#$F2	;Enable slot LCRAM/BANK1/SLOTCxROM to read		PHA		;Save 'A'		LDA	>LVAL	;Check which LC bank to enable		ASL	A	;Bit 2=1 for bank1 else leave bank0		ASL	A	;		ORA	1,S	;Or in status byte on stack		STA	1,S	;Save new memory configuration		LDA	>ORGMEMORY	; and test for special mem configuration.		BEQ	@1	;ORGMEMORY=0 then use normal mem config.		LDA	>MVAL	;Special memory configuration is here		STA	1,S	; else use BRK/unknown COP mem config.@1		EQU	*		PLA		;Recall memory configuration to use.		STA	STATEREG	; by changing state reg.		CPX	#A4L	;Use src bnk for A1,A2,A3, dest bnk for A4		BCC	@11	;		LDA	>BANKD	;What's destination bank?		BCS	@2	;@11		EQU	*		LDA	>BANKS	;What's source bank?@2		EQU	*		PHA		;Move Bank to data bank register		PLB		; for reading/writing of data.		XBA		;Recall 'A' in case we're storing it		BVC	@22	;		STA	(0,X)	;Else store to correct bank and address		BRA	MEMEXIT	;Exit by restoring to original state@22		EQU	*		LDA	(0,X)	;Read value for user/keep in 'A' for userMEMEXIT		EQU	*		XBA		;Preserve 'A' in 'B'		PLB		;Restore correct data bank register		PLA		;Restore memory stateMEMEXIT1		EQU	*		AND	#$BF	;Fix page 2 switch in case user changed it		BIT	RDPAGE2	;- if page 2 is on		BPL	@1	;+ if page 1 is on		ORA	#$40	;Page 2 on then set bit@1		EQU	*		STA	STATEREG	;		XBA		;Back to caller with 'A' correct		RTS		;		EJECT* Pattern search is done in 2 steps.* 1. Set up the pattern to search for in the input buffer*    preceeded by the # of bytes in the pattern in location $200.* 2. Do the actual pattern search after the user types in*    the range to search and a 'P'.** Pattern search format is as follows* \ xx yy zz "12345" 'abcd' aa bb cc \<bb1/addr.bb2/addr2P* If high bank is not specified then EQUALS starting bank** '\' starts and '\' terminates set pattern routine normally.* $8D terminates the entire line and reenters the monitor.SETPTRN		EQU	*		LDA	IN	;Test if been here before		BEQ	@1	;If been here before skip setup		LDA	>BANKS	;Save the usr's bank		STA	>STEPSP+1	;Safe to store here		PHB		;Change source bank to data bank register		PLA		;		STA	>BANKS	;		STZ	IN	;Reset # of bytes in pattern to search for		LDA	#$BA	;Get into store mode		STA	MONMODE	;		LDA	#$02	;Set PCL/PCH to $0201		STA	A3H	;Will become new PCH		DEC	A	;		STA	A3L	;Will become new PCL		RTS		;Back to caller@1		EQU	*		LDA	>DIGITCNT	;If anything entered then store it		BEQ	@2	;=0 then just continue normally		JSR	XSTOR	;Store entered HEX value@2		EQU	*		LDA	PCL	;Calculate # of bytes in pattern		DEC	A	;Ending point -1 = # of bytes in pattern		STA	IN	;Save result for later		LDA	>STEPSP+1	;Restore usr's bank		STA	>BANKS	;Used in 'XSEARCH'		RTS		;Back to callerXSEARCH		EQU	*		REP	#$20	;Off to 16 bit land		LONGA	ON		LDA	A2L	;Save high address in case		PHA		; cross bank required		SEP	#$20	;Back to 8 bit land		LONGA	OFF		LDA	>HIGHBANK	;Chk for crossing bank		CMP	>BANKS		BEQ	@00	;Bra if not		BCC	@00	;Bra if not		LDA	#$FF	;Else need to adjust high address 		STA	A2L	; to $ffff of that bank		STA	A2H@00		EQU	*		LDA	A1L	;Save low address (pointer) in case		PHA		; pattern doesn't all match		LDA	A1H		PHA		LDY	#$01	;1st byte to chk is 2nd byte in input buff@1		EQU	*		JSR	READBYT1	;Read byte from memory		CMP	IN,Y	;Test against value in input buffer		BNE	@3	;		JSR	NXTA1	;Inc zero page pointers for next byte		BCS	@4	;'c' = 1 when done@7		EQU	*		INY		;Next byte to test in input buffer		CPY	IN	;Test against max number to test		BCC	@1	;Loop if not all there yet		BEQ	@1	;		PLA		;Clean up stack		PLA		;		LDA	A1H	;Save pointer on stack		PHA		;		LDA	A1L	;Fix zero page pointer for PRADDR		PHA		;		SBC	IN	;Offset by # of bytes tested		STA	A1L	;Save for PRADDR		BCS	@2	;No borrow then continue		DEC	A1H	;Borrow then dec high byte@2		EQU	*		JSR	PRADDR	;Print address		PLA		;Restore pointer		STA	A1L	;		PLA		;		STA	A1H	;@8		BRA	@00	;Go look for another match@3		EQU	*		PLA		;Restore pointers into search range		STA	A1H	;		PLA		;		STA	A1L	;		JSR	NXTA1	;Try next location		BCC	@8	;Bra if not up to high address of the bank		LDA	A1L	;Make as same stack structure		PHA		LDA	A1H		PHA@4		EQU	*		PHB		;Save data bank register		JSR	DBTOE1	;Change to $e1		INC	|BANKS	;INC start bank		LDA	BANKS		BEQ	@5	;BRA if previous is $ff 		CMP	HIGHBANK	;Compare with ending bank		BEQ	@6	;BRA if start bank = end bank		BCS	@5	;BRA if start bank > end bank, exit		PLB		;Restore bank		STZ	A1L	;Reset pointer to $00 for new bank		STZ	A1H	;		LDA	#$FF	;Set to $ffff of that bank  		STA	A2H		STA	A2L		BRA	@1	;Continue on..@6		EQU	*		PLB		;		LDA	4,S	;Get back user's high address		STA	A2H		LDA	3,S		STA	A2L		BRA	@1	;Continue on...@5		EQU	*	;Prepare to end 		DEC	|BANKS	;Stay to its last bank		PLB		REP	#$20		PLA		;Clean stack, A2H/A2L 		PLA		;Clean stack, A1H/A1l		SEP	#$20		RTS