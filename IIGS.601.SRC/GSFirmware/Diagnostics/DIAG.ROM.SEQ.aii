		TITLE	'ROM Diagnostic Test Sequencer';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 7:14:3 PM;...............................................................;; Main entry point to Rom Test Sequencer;; Call:    In native; Return: Not defined;; Created  : 07 Jan 86 Karl Grabe; Alpha 1.0: 17 Feb 86 KRG; Alpha 2.0: 10 Mar 86 KRG; Beta 1.0 : 26 Mar 86 KRG; Beta 2.0 : 23 Apr 86 KRG; Beta 3.0 : 14 May 86; VER 1.0  : 23 May 86;          : 29 Sep 86 FAB Fixed crash in FDB file;          :               (INDEX8 MEMORY8 needed); VER 2.0  : 08 Jan 87;                        Zero out banks $E0/$E1 at end of 'System Good' ;                        On burn-in, diags will run diags continuosly;                        and write to NVR if SW0 = low;                        Will run Burn-in diags only once and not;                        write to NVR if SW0 = high.;                        Added Sound diagnostics.;; VER 2.0  : 05 Feb 87;                        Zeroes out banks $E0/$E1 at start of diags.;                        In routine BI.SELF.TST changed;                           LDA #BI.SELF.MASK to LDA BI.ALT.MASK;                           at the request of Singapore.;;; This code determines whether the UUT is in Burn-In or Self test; and then executes the selected test. See file: DIAG.MACROS.aii; for details.;;;;             Copyright Apple Computer Inc. 1986-1987;                    All Rights Reserved;...............................................................ST_SEQ_B		EQU	*		SEI		;o interrupts		DATA16		;Set 16 bit memory and index* Code added by FAB to reset all bytes in banks* E1/E0 from $800 to $BFFF to zero so that* Control-Open Apple RESET will allow memory* manager to do a coldstart along with all the* other tools.** September 30, 1986 by Bachman		LDX	#$0800	;16 bit index from above@1		EQU	*		STA	>$E00000,X	;Zero out from $800 to $BFFF		STA	>$E10000,X	; in banks E0 and E1.		INX		;;		CPX	#$C000	;Done if at $C000		BCC	@1	;Loop til done		LDA	#TST_DEATH_MGR	;Test death manager ..		STA	>SYSDMGRV+1	; .. replaces system death manager		DATA8		LDA	#^TST_DEATH_MGR	;Bank for test death manager		STA	>SYSDMGRV+3	;Save it		JSR	BANK_0	;Set Data Bank reg = 0		STZ	CLOCKCTL	;Initialise border color		STZ	MONOCOLOR	;Turn on colour		ASL	PWREDUP	;Destroy powerup byte (cold boot if test interrupted)		STZ	SLTROMSEL	;Enable all internal slots (for Port1 & Disk Port)		LDA	#$04	;Not too loud ... for speaker beep at end		STA	SOUNDCTL	;To speaker volume DAC		STZ	FAIL_LED	;Start by assuming the system is bad		STZ	FAIL_LEDD	;Duplicate FAIL.LED in disk port (CORK FST)		STZ	POWER_ON	;Tell BI controller NOT to power off!;                            ;(... so we don't trash NVR)		STZ	POWER_OND	;Disk port (For FST in Cork);                            ;(for self test: test in progress LED);Find out where we are and do relevant tests ...	IF SEQ_DEBUG <> 0 THEN		;For debugging test code use SW2 instead of DIAGTYPE		LDA	BI_FLAG	;In Burn In ?		BMI	SELF_TST	;We're not in Burn In so do self test	ELSE		LDA	DIAGTYPE	;Read Burn In connector if not in debug		BPL	SELF_TST	;We're not in Burn In so do self test	ENDIF		JSR	RD_BI_NVR_88_66	;Restore NVR to bank zero ram		LONGI	ON		;		LONGA	ON		;		LDA	CYCLES_MAX	;Max sequence run per BI power on cycle		STA	CYCLE_COUNT	;BI Cycle counter decrements to 0		DATA8		LDA	SELF	;Self test in Burn In?		BMI	BI_SELF_TST	;Yes .. so self and no wr NVRNXT_BI_CYCLE	EQU	*	;Run BI tests again NTV16;; UUT is in burn in if here.; First check if NVR is correctly set by pre bi tester; up by checking that the check bytes are intact;		DATA16		STZ	BI_FAIL	;Zero the fail flag		LDA	VALID_CHK	;First two (0,1)		CMP	>VALID_MASK	;Check with what we expect		BNE	BAD_NVR	;Not correct - Stop with self test fail. NVR bad?		LDA	VALID_CHK+1	;Last two (1,2)		CMP	>VALID_MASK+1	;What we expect		BNE	BAD_NVR	;Not correct - Stop with self test fail. NVR bad?		LDA	BI_ALT_MASK	;Mask put there by Pre BI tester in NVR		BRA	EXT_SEQ	;Go do the sequenceBAD_NVR		EQU	*	;NVR bad or not set up properly		LDA	#$FFFF	;AA= FF, BB=FF : NVR NOT SETUP		STA	TST_STATUS	;Put bad Battery Ram msg on screen.		DATA8		BRL	FAIL_SELF	;Goto self test fail routine and die.BI_SELF_TST	EQU	*		DATA16		;Tests to run in User/Self test		STZ	BI_FAIL	;Zero fail flag* February 5, 1987    Fern Bachman* Changed LDA #BI.SELF.MASK TO LDA BI.ALT.MASK at Singapore's request		LDA	BI_ALT_MASK	;Tests to run in self test when in BI		BRA	EXT_SEQ	;Goto sequencerSELF_TST		EQU	*		DATA16		LDA	#SELF_MASK;Be of full 16 bit mode if entering here:EXT_SEQ		EQU	*	;Disk s/w can enter here(c=tests to run)		STA	TST_MASK	;Save what tests to run		LDA	#TST_TAB	;Address of top of pointer table		STA	ZP_PNTR	;Use zero page pointer		LDA	>TST_TAB	;No of bytes in table		AND	#$00FF	;Drop hi byte		LSR	A	;Devide by 2 to get number of tests		STA	TST_COUNT	;Save as test counter (decrement)		STA	NO_TESTS	;Save as number of testsNXT_TST		EQU	*	;Do next test		NTV16		;Get back to ntv16 (2nd ..)		LDX	#$01FF		TXS		;et up the stack		STZ	PORT_ON	;Tell ROM.COUT not to write to Port 1		STZ	TST_STATUS	;Zero out all fail status regs		STZ	TST_STATUS+2		INC	ZP_PNTR	;Point to test pointer		PHK		;t Data bank reg to bank code is running in		PLB		LDA	(ZP_PNTR)	;Get test pointer		JSR	BANK_0	;Data Bank reg = 0		STA	TST_PTR	;Save it for JMP (TST.PTR) to test		INC	ZP_PNTR	;Increment for next time round		SEC		;ow get NO.TESTS-TST.COUNT to get test we're on		LDA	NO_TESTS	;Total number of tests n-1		SBC	TST_COUNT	;Current test number		INC	A	;Bring into range 1 ... n		STA	TST_STATUS	;First byte of status is test number		JSL	>DO_TEST	;Do/skip (TST.PTR) test ** NATIVE 16 **		SEI		;ke sure interrupts still off		JSR	BANK_0	;Data Bank reg = 0		BCS	TST_FAIL	;Current test has failed		BRL	TEST_PASS		EJECT** Test fail handler** In Burn-In:*    The NVR fail counter and cycle number are incremented*    A note is made of the test # that failed + errcodes*    The test sequence continues.** Self Test:*    The test number and fail status is printed on screen:*     "AABBCCDD" ( 3 times and staggered ),*      where AA is test no and BBCCDD is fail status.**    "System Bad: AABBCCDD" message is printed*    A high ( 6KHz ) tone is generated.*    "AABBCCDD" is sent to serial port 1 at 9600 baud *    The NVR is NOT updated.*TST_FAIL		EQU	*		NTV		DATA8		LDA	#0		STA	$E0C035	;Real shadow location		DEC	A	;LDA #$FF		STA	BI_FAIL	;Set BI.FAIL flag to non zero		JSR	ROM_HOME_86	;Clr txt page returns in 86		LDX	TST_STATUS+2	;Get detailed fail status		STX	BI_STATUS+2	;Put fail status aside for NVR later (BI only)		LDX	TST_STATUS	;Get the test number that failed		STX	BI_STATUS	;Save for storage in NVR later (BI only)		IND8		MEM16		LDA	#$0000		SECROTATE		ROL	A	;Set '1' at bit where the test failed		DEX		BNE	ROTATE		TSB	BI_FAILMASK	;Update all tests that failed so far		DATA8		JSR	PRINT_STATUS88	;Put fail status on scrn		STZ	FAIL_LED	;Tell outside world there's trouble		STZ	FAIL_LEDD	;Disk port also (Corcaig)	IF SEQ_DEBUG <> 0 THEN		;Use SW2 or DIAGTYPE? (SW2 for debugging)		LDA	BI_FLAG	;We in BI?		BPL	FAIL_BI_CONT	;Yes failed current test but continue .....		ELSE		LDA	DIAGTYPE	;We in BI?		BMI	FAIL_BI_CONT	;Yes failed current test but continue .....	ENDIF;If here then UUT has failed self testFAIL_SELF		LDX	#0		STZ	CUR	;Set curser to zero		STZ	POWER_OFF	;For LED on Game IO or disk port		STZ	POWER_OFFD	;Disk port phase (agus Corcaig)	; SEG	RUNBANK	;Tell assembler bank $FF for bad messageNXT_FAIL_CHAR	LDA	>FAIL_SELF_MSG,X		BEQ	FAIL_SELF_TONE	;Check for end of msg		JSR	ROM_COUT88	;Print "System Bad message"		BRA	NXT_FAIL_CHAR	;For all charactersFAIL_SELF_TONE	EQU	*		LDA	#$FF	;Non zero		STA	|ST_FAIL	;Make a note that a fail occurred.		JSR	PRINT_STATUS88	;Print stagered on screen		JSR	INIT_PORT1	;Setup Port 1 for writing (Cork's process)		LDA	#$FF	;Non zero		STA	|PORT_ON	;Enable port1		JSR	PRINT_STATUS88	;Print to Port 1		LDA	#$8D	;CR		JSR	COUT_PORT1	;Send Carrage Return to port 1		LDA	#$8A	;LF		JSR	COUT_PORT1	;And a line feed		NTV		;Make sure we're still in native mode		DATA8		IND16		LDX	#10000	;No of cycles		LDA	#5	;Period for 6 KHz or so		BRL	TONE86	;Go do tone and die.FAIL_SELF_MSG	EQU	*		DC.B	' System Bad:'		DC.B	$00	; SEG	$00		EJECT*** Test returns here even if test was skipped*         -- OR --* if test failed AND UUT is in BI.** Note: carry is clear ('passed') when test skipped*FAIL_BI_CONT	EQU	*	;Failed test but in BI so continueTEST_PASS		EQU	*	;Passed test in BI or Self Test so continue		NTV		;In case test ended up in emulation mode		DATA8		LDA	#0	;Turn on all shadowing		STA	$E0C035	;Real shadow location		JSR	PRINT_STATUS88	;Show user tests progressing		DEC	TST_COUNT	;Decrement single byte counter		BMI	END_TST_SEQ	;All tests done		BRL	NXT_TST	;Do another test if TST.COUNT not zeroEND_TST_SEQ	EQU	*		IF SEQ_DEBUG <> 0 THEN		;Test SW2 or DIAGTYPE for BI		LDA	BI_FLAG	;In BI?		BMI	PASS_SELF_STOP88	;No so unit has passed self test		ELSE		LDA	DIAGTYPE	;In BI?		BPL	PASS_SELF_STOP88	;No so unit has passed self test		ENDIF		LDA	BI_FAIL	;Check if any test failed		BMI	BI_CYCLE_FAIL	;Yes so handle it		STZ	PASS_LED	;Last cycle passed all tests		STZ	PASS_LEDD	;Disk port also		DATA16		INC	BI_PASSES	;Record as a passed cycleCONT_CYC		EQU	*		INC	BI_COUNTER	;Cumulative counter for ENTIRE time in BI		DEC	CYCLE_COUNT	;Reset to CYCLES.MAX on each BI power up		BEQ	FIN_CYCLES	;All BI test cycles complete		BRL	NXT_BI_CYCLE	;Continue doing BI cycles;Required no of BI cycles complete so stop and waitFIN_CYCLES	EQU	*		JSR	WR_BI_NVR_66_88	;Save counters status to NVR for next time or tester		LONGI	OFF		LONGA	OFF		STZ	POWER_OFF	;Tell BI controller it's ok to power down.		STZ	POWER_OFFD	; .. And Cork FST controller via disk port* Modified by FAB* Singapore requested the burn in self diagnostic* run continuously with no write to batteryram if* SW0 (SELF same as BUTN0) is 1 ('-').* September 30, 1986 by Bachman		LDA	SELF	;If active ('-') then loop continuously		BPL	@1	;If inactive ('+') then stop the processor		BRL	ST_SEQ_B	;Loop and restart diagnostics@1		EQU	*		STP		;Just hang til power offBI_CYCLE_FAIL	EQU	*	;Here if a cycle has failed a test		DATA16;INC BI.FAILS  ;No more, replaced by BI.FIRSTF		LDA	BI_COUNTER		STA	BI_LASTF	;Record what cycle failure occurred		LDX	BI_FIRSTF	;Is this the firt time it fails?		BNE	@2	;No		STA	BI_FIRSTF	;Yes, record the first fail cycle@2		BRA	CONT_CYC	;Go on to next cycle if necessaryTST_RTS		RTL		;ny rts instruction		; SEG	RUNBANK	;All tests are normally in Bank $FFDO_TEST		EQU	*	; ** Native 16 **		; SEG	$00	;Data and softswitches in Bank $00		STZ	ST_FAIL	;Clear test fail status to pass		ROR	TST_MASK	;Put test 0/1 in carry, 16 bit.		BCC	TST_RTS	;Skip this test  *** Note carry CLR => passed ***		DATA8		INC	|CLOCKCTL	;Each test has a new border color		IF SEQ_DEBUG <> 0 THEN		JSR	TEMP_WAIT	;Slow down display while debugging only		ENDIF		JSR	ROM_HOME_86	;Routine sets 86 (8bit memory, 16 bit index)		DATA8		JSR	PRINT_STATUS88	;Prt tst running (useful if test crashes)		FAST		;Hurry things along a little (8 bit macro)		JMP	(TST_PTR)	;Go do test ** MEM8 IND8 ** Return with RTL		EJECT****************************************************************** All following Subroutines are MEMORY8 & INDEX16* (subname)86* KG JAN 86*****************************************************************;...............................................................; PASS.SELF.STOP88; UUT passed self test so put out 1Khz; tone, print message & stop;; MEMX, INDX;...............................................................PASS_SELF_STOP88	EQU	*		JSR	ROM_HOME_86	;Routine sets 86		DATA8		STZ	PASS_LED	;Tell game IO we've passed		STZ	PASS_LEDD	;And disk port		STZ	POWER_OFF	;Tell game IO test finished		STZ	POWER_OFFD	;And disk port		LDX	#0		STZ	CUR	; SEG	RUNBANK	;Tell assembler where code residesNXT_PASS_CHAR	LDA	>SELF_PASS_MSG,X		BEQ	PASS_SELF_TONE	;Check for end of msg		JSR	ROM_COUT88	;Print "System Good message"		BRA	NXT_PASS_CHARSELF_PASS_MSG	EQU	*		DC.B	' System Good'		DC.B	$00VALID_MASK	DC.B	'KRG'	;Do not change - used in NVR by tst s/w	; SEG	$00PASS_SELF_TONE	EQU	*		IND16		LDX	#1000	;Number of speaker clicks		LDA	#17	;Period for 1KHz;...............................................................; TONE86; Generate tone Period: ACC (8);               Cycles: X (16);; Enter MEM8,IND16; Ret :Does not return;...............................................................TONE86		EQU	*		TAYNXT_KICK		TYA		; GET DURATION		JSR	$FCA8	; MONITOR WAIT ROUTINE		BIT	SPKR		DEX		BNE	NXT_KICK		LDA	ST_FAIL	;Has self test failed?		BEQ	END_SELF	;Wait for OA pressed to Repeat Self Test		STP		;Die here with Self Test err msg on screenEND_SELF		EQU	** ASL SELF* BCC END.SELF  ;Wait here 'till Open apple pressed		ASL	DIAGTYPE	;Test if in burn-in or user diags		LDA	SELF	;Get Open-Apple status		BCS	CHKOAONLY	;If in burn-in diags check Open-Apple only		AND	BUTN1	; else both buttons pressed to continue?CHKOAONLY		EQU	*		BPL	END_SELF	;If '+' in any case then keep looping		BRL	ST_SEQ_B	;Go to very beginning of diags again.;...............................................................;;ROM.HOME.86;Clear the text page & set to 40 text;; Enter/RET Native; Exit Mem8 Ind16;...............................................................ROM_HOME_86	EQU	*		IND16		;Index regs 16 bit		MEM8		;For soft switch toggles		STZ	CLR80COL		STZ	CLR80VID	;40 COL		STZ	TXTSET	;Get out of graphics		STZ	TXTPAGE1		LDA	#1		STA	NEWVIDEO	;Make sure not in new video mode		LDY	#LINE1	;The text screen		LDA	#' '	;SpaceROM_NXT_SP	EQU	*	;Write another space		STA	LINE1,Y	;The text screen		DEY		BPL	ROM_NXT_SP		RTS		EJECT****************************************************************** All following subroutines are MEMORY8 & INDEX8* (subname)88*****************************************************************;...............................................................;; ROM.COUT88; Print char on last line of screen. 40 col only.; offset by CUR. (CUR <40 !); The caller must make sure the 'curser' does not; end up outside the text window!;; If ST.FAIL is true then print staggered fail status on scrn; If PORT.ON is true then send fail status to port 1;; Enter/RET: DATA8;...............................................................ROM_COUT88	DATA8		LDX	CUR	;Get curser		STA	LINE1+$3D0,X		LDX	ST_FAIL	;For self test fail only		CPX	#0		BEQ	NOT_FAIL;Fail status so print on screen in different posn;and send to port 1		LDX	CUR	;Restore curser		STA	LINE1-$0F,X	;Top lhs of scrn		STA	LINE1+$81-$0F,X	;Next line shift one to right		STA	LINE1+$102-$0F,X	;Nxt line, one to right		LDX	PORT_ON	;Check do we write to port1 also ?		CPX	#0		BEQ	NOT_FAIL	;No so don' write to port 1		JSR	COUT_PORT1	;Send Acc to port		NTV		;Make sure we're still in native modeNOT_FAIL		EQU	*		LDX	CUR	;		INC	CUR	;Increment curser		RTS;...............................................................; ROM.PRBYTE88    ( Accumulator ); Print a byte on screen at CUR; Enter/Ret DATA8;...............................................................ROM_PRBYTE88	EQU	*		PHA		;ave byte to prt		ROR	A		ROR	A		ROR	A		ROR	A	;Get hi nybble into low nyb posn		JSR	PRNYBBLE	;go prt nybble		PLA		;ow work on low nybblePRNYBBLE		AND	#$0F	;Strip out hi nybble		CMP	#$0A		BLT	PR_NOADD		ADC	#$06PR_NOADD		EQU	*		ADC	#$B0		BRA	ROM_COUT88;...............................................................; PRINT.STATUS88; Print 6 byte status on text scrn.;; Enter/Ret DATA8;...............................................................PRINT_STATUS88	EQU	*		LDA	#15		STA	CUR	;Set up curser		LDY	#0		PHY		;ave Y when using ROM.PRBYTENXT_STAT		EQU	*		LDA	TST_STATUS,Y	;Get the byte		JSR	ROM_PRBYTE88	;Y gets trashed		PLY		;estore byte count		INY		;xt byte		PHY		CPY	#4		BNE	NXT_STAT	;Next status byte		PLY		RTS		EJECT;;...............................................................; RD.BI.NVR.88.66; Read NVR counters to ram for BI cycling;; NTV DATA 8;................................................................RD_BI_NVR_88_66	EQU	*MVN_NVR		EQU	NVR_FREE	;Lower 2 bytes of BRAMBUFFER adr (free bat space)		DATA8		JSL	>TOREADBR	;Read NVR to bank ^BRAMBUFFER (=$E1)		DATA16		LDX	#MVN_NVR	;Source addess		LDY	#BI_STATUS	;Destination address		LDA	#NVR_END-NVR_BEG	;Number of bytes to move		MVN	BRAMBUFFER,$000000		RTS		;;;...............................................................; WR.BI.NVR.66.88; Write BRAMBUFFER to NVR;; NTV DATA 8;................................................................WR_BI_NVR_66_88	EQU	*		LDX	#BI_STATUS	;From (Bank $00)		LDY	#MVN_NVR	;To   (Bank $E1)		LDA	#NVR_END-NVR_BEG	;Number of bytes to move		MVN	$000000,BRAMBUFFER	;Move status bytes to bank $E1		DATA8		LDA	SELF	;Are we in BI but running Self Diags?		BMI	BI_SLF_NVR	;Yes so don't write to NVR		JSL	>TOWRITEBR	;Write stuff permanently to BRAMBI_SLF_NVR	DATA8		RTS		;;;...............................................................; BANK.0   XX/XX; Set Data bank register to zero;;...............................................................BANK_0		EQU	*		PEA	0		PLB		PLB		;et it		RTS;...............................................................; TST.DEATH.MGR; This routine replaces the system death manager during tests.; SYSDMGRV vector points to here.;;...............................................................	; SEG	RUNBANK	;Bank this code is inTST_DEATH_MGR	EQU	*		NTV16		LDX	#$01FF		TXS		;eset stack pointer		JSR	BANK_0	;Make sure Data Bank is zero		LDA	#0		TCD		;irect register		INC	A	;Errcode 01		STA	>TST_STATUS+3	;DD=01: Death manager was called during test		BRL	TST_FAIL	;Print/save test that was running		TITLE	'Setup & write to Port 1';...............................................................; COUT.PORT1  8/8; Output Fail status registers to serial device; using Pascal 1.1 entry points.;; Two entry Points:; INIT.PORT1 -> Initialise port for writing; COUT.PORT1 -> Send 8 bit acc to port1;;; 22 Jan 86:  KG  Created; 20 Mar 86:  KG  Port to Bank $FF ROM;...............................................................	; SEG	RUNBANK	;Bank code resides inINIT_PORT1	EQU	*		LONGA	OFF		LONGI	OFF		LDA	#$04		STA	|STATEREG	;Correct language card setup;; Set up Port 1 Parameters;; Copy PORT.PARMS to BRAMBUFFER ( in bank $E1 ); Then a Pascal Init call will use these parms; instead of those in the Control Panel.;		LDX	#END_PORT_PARMS-PORT_PARMS	;All of port 1 parametersSTO_NXT_PARM	EQU	*	;Store next parameter		LDA	>PORT_PARMS,X	;Get it from table		STA	>BRAMBUFFER,X	;Save it in BRAMBUFFER		DEX		BPL	STO_NXT_PARM	;Do next parameter; Release $C800 space		LDA	#>SLOT_ADDR		STA	|$07F8	;For interrupts 		LDA	|CLRROM	;Disable C800; Setup Init pointer		LDA	|INIT_OFF	;Offset byte for Pascal Init		STA	INIT_JMP	;Points to actual init address		LDA	#>INIT_OFF		STA	INIT_JMP+1	;Contains actual Init address; Setup write pointer		LDA	|WRITE_OFF	;Offset byte for Pascal Write		STA	WRITE_JMP		LDA	#>WRITE_OFF		STA	WRITE_JMP+1	;Contains actual Write address; Relocate section of Bank $FF code to bank zero		LDA	#BANK_ZERO_END-BANK_ZERO_BEG	;No of bytes to transfer		TAX		;se y as byte loop counterNXT_ZBYTE		EQU	*		LDA	>BANK_ZERO_BEG,X	;Load it from bank $ff rom		STA	|SER_ZBANK,X	;Save it in zero bank		DEX		;ove down a byte		BPL	NXT_ZBYTE	;Repeat		LDX	#>SLOT_ADDR	;X & X must have slot related values		LDY	#SLOT*16; Initialise Port 1. Use Pascal 1.1 protocolDO_INIT		EQU	*		JSL	>SER_ZBANK	;Go initialise device for writing		LDA	#'*'		JSR	COUT_PORT1	;Tell tester failcode is sent next		RTS		;o sequencerCOUT_PORT1	EQU	*	; send acc to port		LDX	#>SLOT_ADDR		LDY	#SLOT*16DO_WRITE		EQU	*	;Write Acc to slot		JSL	>SER_ZBANK+ZERO_WRITE-ZERO_INIT	;To bank zero routine		RTS		;;PORT_PARMS	EQU	*	;Port Parms (default values except baud)		DC.B	$00	;This port is a: Printer		DC.B	$00	;Line Length: Unlimited		DC.B	$00	;Delete First LF after CR: No		DC.B	$01	;Add LF after CR: Yes		DC.B	$00	;Echo: No		DC.B	$00	;Buffering: No		DC.B	$07	;Baud: 1200  ** Non Default **		DC.B	$06	;Data/Stop Bits: 8/1		DC.B	$02	;Parity: None		DC.B	$01	;DCD Handshake: Yes		DC.B	$01	;DSR Handshake: Yes		DC.B	$00	;XON/XOFF Handshake: NoEND_PORT_PARMS	EQU	*		EJECT;; The next section of code is downloaded to bank zero RAM; and run from there. (Because we cannot call the Port; firmware with a JSL);	; SEG	RUNBANKBANK_ZERO_BEG	EQU	*	;Beginning of Bank zero image	; SEG	$00ZERO_INIT		EQU	*	;Initialise from bank zero		JSR	SER_ZBANK+IJ-ZERO_INIT	;Go through INIT.JMP vector in bank $00		RTL		;eturn to bank sequencer RUNBANKIJ		JMP	(INIT_JMP)	;Jump to $00/C1XX spaceZERO_WRITE	EQU	*	;Write Acc form bank zero		JSR	SER_ZBANK+WJ-ZERO_INIT	;Go through WRITE.JMP vector		RTL		;eturn to sequencer RUNBANKWJ		JMP	(WRITE_JMP)	;Jump to $00/C1XX spaceBANK_ZERO_END	EQU	*	;End of Bank zero image	IF SEQ_DEBUG <> 0 THEN		EJECT	; SEG	$FF;...............................................................;; Following 'test' for debug only; Test 1 'fails' if a key is pressed;;...............................................................		LONGA	OFF		LONGI	OFF*TEST1		EQU	*		LDA	KBDSTRB	;CHECK IF KEY PRESSED		BPL	TEST1_EXIT		STA	TST_STATUS+1		SEC		;n "Error" occurred		RTLTEST1_EXIT	CLC		;		RTL;...............................................................;; TEMP.WAIT;  DEBUG ONLY;...............................................................TEMP_WAIT		EQU	*		LDA	#254		JSR	WEIGHT		LDA	#254		JSR	WEIGHT		LDA	#254		JSR	WEIGHT		LDA	#254		JSR	WEIGHT		LDA	#254		JSR	WEIGHT		LDA	#254		JSR	WEIGHT		LDA	#254		JSR	WEIGHT		LDA	#254WEIGHT		SEC		;his is monitor wait routine $FCA8TEMP_WAIT2	PHA		;TEMP_WAIT3	SBC	#$01		BNE	TEMP_WAIT3		PLA		SBC	#$01		BNE	TEMP_WAIT2		RTS	ENDIF