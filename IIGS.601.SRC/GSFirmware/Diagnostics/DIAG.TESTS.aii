		TITLE	'Pseudo MovInv Ram Test';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 7:15:58 PM************************************************************************ file: moviram** 16 bit version of popular //e Ramtest of the 80's** Revision History:** 11 sep 85    RCarr    New Today* 16 sep 85    RCarr    Converted to use indirect long addressing* 05 dec 85    RCarr    Added to DVT test, make seg unrelated* XX Jan 86    KG       Added to internal diags...* 20 mar 86    RCarr    Improve Error Reporting and code krunch 1* 06 Apr 88    BS Soh   Expand to 1 M for Rev.D** Data 8 , Data bank =0	; SEG	$00MOVIRAM		EQU	*		DATA8		BIT	TXTCLR		BIT	MIXCLR		BIT	HIRES;stz RamBank;jsr DoZpageInd;bcs RamError2;lda #0;jsr MoviRamTest;bcs RamError2*		LDX	#0		PHX		;save xBT1		EQU	*;LDA #$C0;eor NEWVIDEO  ;Toggle between $01 & $C1;sta NEWVIDEO		PLX		CPX	#4		BEQ	BTEnd	;Completed		INC	CLOCKCTL	;Increment into next border color		LDA	>BANKtbl,x	;Get next Test Bank		INX		PHX		;save x		JSR	MoviRamTest		BCS	BTExit		JSR	DoZpageInd		BCC	BT1	;More bankBTEXIT		PLX		;Throuw away x		BRA	MoviRamExit	;fail, exit*BTEND		EQU	*;; Check key micro version number;		JSR	GETVERSION		BCS	M_FDB_ERR	;Tool had problem reading up		CMP	#$6	;Is version >= 6 ?		BCC	NoMore	;No, it's IIgs		LDA	#$01;sta NEWVIDEO		STA	RamBankEXPBANK		INC	RamBank		LDA	RamBank		CMP	#$10	;Has it exceeded max?		BCS	NoMore	;Yes Exit		JSR	MoviRamTestExp	;Acc still contain RamBank		BCC	ExpBank	;another bank		BRA	MoviRamExitNOMORE		CLC		;to be sureMOVIRAMEXIT	DATA8RAMERROR2		RTL		;M_FDB_ERR		LDA	#$FF		STA	ErrCode1		SEC		RTL*MOVIRAMTEST	EQU	*		STA	RamBank		IND16		MEM8		LDX	#$0400		LDY	#$BFFF		JSR	DoMoviTest		BCS	FoundMoviErr		LDA	lcbank1		LDA	lcbank1		LDX	#$d000		LDY	#$dfff		JSR	DoMoviTest		BCS	FoundMoviErr		LDA	lcbank2		LDA	lcbank2		LDX	#$d000		LDY	#$ffff		JSR	DoMoviTestFOUNDMOVIERR	IND8		RTS*MOVIRAMTESTEXP	EQU	*		IND16		INC	CLOCKCTL	;Change border color		LDX	#0	;memory8, index16		TXY		DEY		;(y=$ffff) test the entire bank		JSR	DoMoviTest		IND8		RTS*		LONGI	ONDOMOVITEST	EQU	*		STY	RamEndAddr		STX	RamBegAddr		LDX	#$0000		STX	loc		LDA	RamBank		STA	loc+2		LDA	#0OUTER16		STA	thedata		LDX	#$0002		STX	mod~STEPP16		LDY	RamBegAddr		LDA	thedata		EOR	#$ff		STA	flipSTUFF16		STA	[loc],y		INY		CPY	RamEndAddr		BCC	stuff16		LDX	mod~		LDY	RamBegAddr		LDA	thedataALT16		DEX		BPL	skip16		LDX	#$0002		STA	[loc],ySKIP16		INY		CPY	RamEndAddr		BCC	alt16		LDA	mod~		BNE	test16		LDA	thedata		CMP	#$FF		BNE	test16		CLC		RTS*TEST16		LDX	mod~		LDY	RamBegAddrINV16		LDA	flip		DEX		BPL	jmp16		LDX	#$02		LDA	thedataJMP16		CMP	[loc],y		BNE	Error16		INY		CPY	RamEndAddr		BCC	inv16		DEC	mod~		BPL	stepp16		LDA	thedata		EOR	#$ff		BRA	outer16**ERROR8		PLA		;Pull away a		EOR	[loc],y		SEP	#$10	;Index 8		LDA	#0		PHA		PHA		PLD		BRA	E2ERROR16		EQU	*		EOR	[loc],yE2		STA	ErrCode2		LDA	RamBank		STA	ErrCode1		SEC		RTS*DOZPAGEIND	EQU	*	;tests zero pages of any bank specified by RamBank		IND16		LDA	RamBank		PEA	$1000	;Change Direct Page Register		PLD		STA	loc+2		LDY	#0		STY	loc	;was stx, but should be styZPIND1		LDA	[loc],y		PHA		LDA	#$fe		LDX	#$0000ZPIND2		STA	[loc],y		CMP	[loc],y		BNE	Error8		SEC		ROL	a		INX		CPX	#$0008		BNE	ZPInd2		DEX		LDA	#$80ZPIND4		STA	[loc],y		CMP	[loc],y		BNE	Error8		LSR	a		DEX		BPL	ZPInd4		PLA		STA	[loc],y		INY		CPY	#$0400		BNE	ZPInd1		IND8		LDA	#0		PHA		;Reset Direct Page Register		PHA		PLD		CLC		RTS		EJECT		TITLE	'Serial Z8530 test.'******************************************************************    File   :  SER.TST***   Serial tests for the SCC (8530)**    14-Nov-85   :  JR    : New Today!*    23-Jan-86   :  JR    : Modified to run in ROM**    See Diagnostics ERS for error codes**    Data8, Data Bank = 0******************************************************************   Calls to the three test routines*SER_TST		EQU	*	; SEG	$00	;Should really be $FF, but program was written for bnk 0		JSR	SCCRegRW		BCS	SCCEnd	IF BAUD_SWITCH <> 0 THEN		;If baud tests included		JSR	BaudIRQ		BCS	SCCEnd	ENDIF		JSR	IntLoopSCCEND		RTL		;		EJECT******************************************************************  SCC register R/W test*****************************************************************SCCREGRW		EQU	*		SEI		;isable interupts		STZ	DATA		STZ	ErrCode1		JSR	ResetSCC	;SCC reset & point to Chn A		LDA	#$FF		STA	SerMask	;BIT mask,for WR15 only		LDA	#2		STA	RegNo	;Write register to test		JSR	RWChA	;Test Wr 2 for ChA only		BMI	FailRW		LDA	#12		STA	RegNo	;Test Wr reg 12		JSR	TstRW		BMI	FailRW		INC	RegNo	;Test Wr reg 13		JSR	TstRW		BMI	FailRW		LDA	#$FA		STA	SerMask	;Mask non R/W bits in Wr 15		LDA	#15		STA	RegNo	;Test Wr reg 15		JSR	TstRW		BMI	FailRW		CLC		RTSFAILRW		LDA	#01		STA	ErrCode1		SEC		RTSTSTRW		LDY	#ChBIndex	;Test Channel A & B		JSR	RegRW		BMI	EndRWtstRWCHA		LDY	#ChAIndex		JSR	RegRW		BMI	EndRWtstZRTS		LDA	#0ENDRWTST		RTS		;REGRW		LDA	RegNo	;Actual R/W test		STA	SCCCmd,Y	;Point to the Wr reg		LDA	DATA	;Initially = 0		AND	SerMask	;Mask out non R/W bits		STA	MaskData	;Store for later comparison		STA	SCCCmd,Y	;Write the register		LDA	RegNo		STA	SCCCmd,Y		LDA	SCCCmd,Y	;Read the register		CMP	MaskData	;Compare		BNE	BadData		DEC	DATA		BNE	RegRW	;Try $0-FF		BEQ	ZRTSBADDATA		LDA	#$80		RTS		EJECT		IF BAUD_SWITCH <> 0 THEN		;Leave out next section***************************************************************** Test for interupt on zero count of the baud rate generator*****************************************************************BAUDIRQ		EQU	*		SEI		;isable interupts		STZ	CNT1		STZ	CNT2		STZ	CNT3		STZ	CNT4		STZ	SerIRQCnt		JSR	ResetSCC**  Local IRQ vector setup for Zero count interupt.*		LDA	>INTMGRV+1	;Interupt manager vector		STA	SerIRQtemp1		LDA	>INTMGRV+2		STA	SerIRQtemp2		LDA	>INTMGRV+3		STA	SerIRQtemp3		LDA	#<ZerIRQHnd		STA	>INTMGRV+1		LDA	#>ZerIRQHnd		STA	>INTMGRV+2		LDA	#^ZerIRQHnd		STA	>INTMGRV+3		LDX	#$00SETENV		EQU	*		LDA	>TBL1,X	;Set up the SCC regs		STA	SCCCmd,Y		INX		LDA	>TBL1,X		STA	SCCCmd,Y		INX		CPX	#14		BNE	SetEnv		CLI		;nable interuptsZE1		EQU	*		LDA	SerIRQCnt	;Wait for 1st interupt		CMP	#1		BEQ	Ze2		DEC	CNT1		BNE	Ze1		DEC	CNT2		BNE	Ze1TIMOUT		EQU	*		LDA	#02	;Timout fail on IRQ one		STA	ErrCode1		BRA	ErrRestoreZE2		EQU	*		LDA	SerIRQCnt	;Wait for 2nd interupt		CMP	#2		BEQ	CheckTime		DEC	CNT3		BNE	Ze2		DEC	CNT4		BNE	Ze2		LDA	#03	;Timout fail on IRQ two		STA	ErrCode1		BRA	ErrRestoreCHECKTIME		EQU	*		LDA	CNT2		CMP	CNT4	;Upper byte compare		BNE	BadXtal		LDA	CNT1		CMP	#Zer1+Limit	;Low byte 1st IRQ		BGE	BadXtal		CMP	#Zer1-Limit		BLT	BadXtal		LDA	CNT3	;Low byte 2nd IRQ		CMP	#Zer2+Limit		BGE	BadXtal		CMP	#Zer2-Limit		BLT	BadXtal		CLC		;		BRA	IRQRestoreBADXTAL		EQU	*		LDA	#04		STA	ErrCode1		BRA	ErrRestoreERRRESTORE	EQU	*		JSR	IRQRestore		SEC		RTS**  Local interupt handler for IRQ on zero count*	; SEG	RUNBANK	;Tell assembler next entry in bank $ffZERIRQHND		EQU	*	; SEG	$00		INC	SerIRQCnt		LDA	SerIRQCnt	;1st or 2nd time here ?		CMP	#2		BEQ	SCNDIRQ		LDA	CNT1		STA	STCNT1		LDA	CNT2		STA	STCNT2		BRA	RtnSCNDIRQ		LDA	CNT3		STA	STCNT3		LDA	CNT4		STA	STCNT4RTN		LDA	#0		STA	SCCCmd,Y		LDA	#$10	;Reset ext int sts		STA	SCCCmd,Y		RTI**  Intrupt manager vector restore*IRQRESTORE	EQU	*		LDY	#ChAIndex		LDA	#9		STA	SCCCmd,Y		LDA	#$00		STA	SCCCmd,Y		LDA	SerIRQtemp1		STA	>INTMGRV+1		LDA	SerIRQTemp2		STA	>INTMGRV+2		LDA	SerIRQtemp3		STA	>INTMGRV+3		CLC		RTS		ENDIF		EJECT*****************************************************************   Internal loopback test****************************************************************INTLOOP		EQU	*		SEI		JSR	ResetSCC	;Reset SCC & point to Ch A		LDY	#ChAIndex	;		JSR	SCCRegSet		JSR	TstCh		BNE	IntLoopErr		LDY	#ChBIndex		JSR	SCCRegSet		JSR	TstCh		BNE	IntLoopErr		CLC		RTSINTLOOPERR	STA	ErrCode1		SEC		RTSTSTCH		STZ	DATACHN1		STZ	CNT1		STZ	CNT2TXCLR		LDA	#0		STA	SCCCmd,Y		LDA	SCCCmd,Y		AND	#$04	;Tx Buffer empty status		BNE	SendData		DEC	CNT1		BNE	TxClr		LDA	#05	;Tx Buffer empty failure		RTSSENDDATA		LDA	DATA		STA	SCCData,Y		STZ	CNT1ALLSENT		LDA	#1		STA	SCCCmd,y		LDA	SCCCmd,Y		AND	#$01	;All Sent status		BNE	ChkRead		DEC	CNT1		BNE	AllSent		DEC	CNT2		BNE	ALLSENT		LDA	#06	;All Sent status fail		RTSCHKREAD		STZ	CNT1		STZ	CNT2CHKRD		LDA	#0		STA	SCCCmd,Y		LDA	SCCCmd,Y		AND	#$01	;Rx charecter available		BNE	ChkData		DEC	CNT1		BNE	ChkRd		LDA	#07	;Rx char available error		RTSCHKDATA		LDA	SCCData,Y		CMP	DATA		BEQ	TxChk		LDA	#08	;Bad Data		RTSTXCHK		LDA	#1		STA	SCCCmd,Y		LDA	SCCCmd,Y		AND	#$70	;Framing, Overrun & Parity errors		BEQ	AGAIN		LDA	#09	;Frame, Overrun or Parirty error		RTSAGAIN		DEC	DATA* BEQ Retrn * BRA Chn1		BNE	CHN1RETRN		LDA	#0		RTSSCCREGSET		LDX	#0SETENV2		LDA	>TBL2,X	;Set up the SCC registers		STA	SCCCmd,Y	;  for internal loopback.		INX		LDA	>TBL2,X		STA	SCCCmd,Y		INX		CPX	#16		BNE	SetEnv2		RTS**   Reset the SCC*RESETSCC		LDY	#ChAIndex	;Channel A		LDA	#$9	;Reg 9		STA	SCCCmd,Y		LDA	#$C0	;Force an SCC reset		STA	SCCCmd,Y		RTS	; SEG	RUNBANK	;Normally bank $FFTBL2		EQU	*		DC.B	9,$00	;Disable interupts		DC.B	4,$4C	;X16 clk 2 Stp bits		DC.B	11,$D0	;Xtal RTxC		DC.B	12,$5E	;Low Byte Time const		DC.B	13,$00	;Hi Byte Time const		DC.B	14,$13	;Loopback BR enable		DC.B	3,$C1	;Rx 8bits		DC.B	5,$6A	;Tx 8bits Tx enable RTS		IF BAUD_SWITCH <> 0 THEN		;Only if baud test assembledTBL1		DC.B	9,$0A	;Enable interupts no vectors		DC.B	12,$FF	;Low byte of time constant		DC.B	13,$FF	;Hi byte       "     "		DC.B	15,$02	;Int on zero count enable		DC.B	0,$10	;Reset ext status interupt		DC.B	1,$01	;Ext int enable		DC.B	14,$03	;BR gen enable & BR source		ENDIF		TITLE	'Cortland softswitch test'************************************************************* MAIN PROG TO test cortland softswitches* 8 BIT ROUTINE* Enter with Data Bank = $00* Returns with RTL and in 8 bit EML mode.** Test returns with carry set if fail, else carry clear* kg 01 OCT 85: Created* KG 03 JAN 86: Modified to run in Bank $FF rom*** Karl Grabe. Apple Computer Inc., Corcaig************************************************************* Now test each softswitch by setting & checking if set,* then clearing and checking if clear.** 8 of the softswitches have equivalent bits in the STATEREG* register and these are tested/set/reset and verified* for correct value and function.** If a fail occurs then:*       1.   The carry flag is set*       2.   A contains the failed STATEREG bit ( if any )*       3.   TST.STATUS+2 +$C000 gives the read softswitch location*            that the fail occurred on*       4.   TST.STATUS+1 contains STATEREG bit in error** NOTE: Call in NTV DATA8, Data Bank =$00*************************************************************SOFT_SW		EQU	*	; SEG	RUNBANK		PHK		PLB		LDA	#$01	;STATEREG bit mask		LDY	#SOFT_TAB_SIZE	;For all softswitchesNEXT_SW		LDX	SOFT_TAB+1,Y	;Get ready to set switch		CPX	#NOT_SW	;Test for skip or not		BEQ	INC_SW_1	;Skip this soft switch* Set switch ...		STA	>IOADR,X	;Set it now		LDX	SOFT_TAB+2,Y	;Get ready to read the switch		JSR	BANK_0	;Set data bank reg to zero		ASL	|IOADR,X	;Put bit 7 into carry		BCC	MEGA_SOFT_ER	;Mega softswitch error* STATEREG ...		CMP	#$00	;More STATEREG bits to test ?		BEQ	CLR_SW	;No ... skip STATEREG test		BIT	#%00001100	;Testing bit 2 ?		BNE	STATE_INV	;Yes ... so test inverted.		JSR	BANK_0	;Set data bank reg to zero		TRB	|STATEREG	;Test/reset using A mask		BEQ	MEGA_SOFT_ER	;State reg does'nt match		ASL	|IOADR,X	;Does STATEREG clr softsw?		BCS	MEGA_SOFT_ER	;No so err		TSB	|STATEREG	;Test/set using A mask		BNE	MEGA_SOFT_ER	;STATEREG did not set, err		ASL	|IOADR,X	;Does STATEREG set softssw ?		BCC	MEGA_SOFT_ER	;No .. er		BRA	CLR_SW	;Jump over inverted bits testSTATE_INV		EQU	*	;Not branched to on new production Mega //		TSB	|STATEREG	;Test/reset using A mask* Clear switch ...CLR_SW		EQU	*		PHK		PLB		LDX	SOFT_TAB,Y	;Get ready to clear		STA	>IOADR,X	;Clear it		LDX	SOFT_TAB+2,Y	;Get ready to read softswitch		JSR	BANK_0	;Set data bank reg to zero		ASL	|IOADR,X	;Put bit 7 into carry		BCS	MEGA_SOFT_ER	;Mega softswitch error		PHK		PLBINC_SW		DEY		;softsw cntr by 3INC_SW_1		DEY		;softsw cntr by 2		ASL	A	;Move to next STATEREG bit		DEY		BPL	NEXT_SW	;Do next soft switchNORMSTATE		LDA	#$0C		STA	|STATEREG	;Restore to 'normal' settingsNORMRTL		CLC		;r carry for test pass		RTLMEGA_SOFT_ER	EQU	*		STA	|TST_STATUS+1	;State register Bit at fault (if any)		STX	|TST_STATUS+2	;>of soft switch at fault		JSL	>NORMSTATE		SEC		;carry as test fails		RTL		;rmine faulty softwsitch from Y		EJECT************************************************************* Softswitches table:* Format: Clear softswitch, Set softswitch, Read softswitch* The last 8 softswitches have a STATEREG bit.************************************************************SOFT_TAB		EQU	*		DC.B	SETINTC3ROM,SETSLOTC3ROM,RDC3ROM		DC.B	CLR80COL,SET80COL,RD80COL		DC.B	TXTCLR,TXTSET,RDTEXT		DC.B	MIXCLR,MIXSET,RDMIX		DC.B	LORES,HIRES,RDHIRES		DC.B	CLRALTCHAR,SETALTCHAR,ALTCHARSET		DC.B	CLR80VID,SET80VID,RD80VID** The following softswitches have an equivalent bit* in the Mega // STATEREG register.*STATE_7		DC.B	SETSTDZP,SETALTZP,RDALTZP	;Bit 7STATE_6		DC.B	TXTPAGE1,TXTPAGE2,RDPAGE2	;Bit 6STATE_5		DC.B	RDMAINRAM,RDCARDRAM,RDRAMRD	;Bit 5STATE_4		DC.B	WRMAINRAM,WRCARDRAM,RDRAMWRT	;Bit 4STATE_3		DC.B	LCBANK1,LCBANK2,RDLCBNK2	;Bit 3STATE_2		DC.B	ROMIN,LCBANK1,RDLCRAM	;Bit 2STATE_1		DC.B	NOT_SW,ROMBANK		;Not soft switch. Bit 1 STATEREGSTATE_0		DC.B	SETSLOTCXROM,SETINTCXROM,RDCXROM	;Bit 0 STATEREGSOFT_TAB_SIZE	EQU	*-SOFT_TAB-3SOFT_END		EQU	*	; SEG	$00		TITLE	'FPI/MEGA SPEED TEST';...............................................................; FPI.SPEED;;; MAIN PROG TO CHECK FAST/SLOW SPEED RATIO OF RAMBO;; K.G. 17 SEP 85;; 17 SEP 85  File Created; 14 FEB 86  Modified to run in Bank $FF rom;; Call in Native mode 8, Data Bank = $00; Returns with RTL in Native Mode, Data8, Data Bank = $00;;  Errors: TST.STATUS+1: 1=>stuck fast, 2=>stuck slow;          TST.STATUS+2: Bad ratio measured;; By Karl Grabe  Apple Computer Ltd. Cork;...............................................................FPI_SPEED		EQU	*	;Sequencer calls with JSL 	; SEG	RUNBANK	;Bank code is running inLBL00		EQU	*	;Check correct Video counter freq in Fast mode		LDA	#%10000000	; SET FPI FAST		STA	|CYAREG		JSR	FIND_SPEED	;Leave result in X		LDY	#1	;Section of the test if it fails =1		CPX	#>FAST_LIM	;Test low value first		BEQ	NOW_SLOW	;Is good so check slow mode		CPX	#<FAST_LIM	;Try high value		BNE	BAD_SPEED	;Bad so errorNOW_SLOW		EQU	*	;Check correct Video counter freq in Slow mode		STZ	|CYAREG	;slow mode		JSR	FIND_SPEED		LDY	#2	;Section of the test if it fails =2		CPX	#>SLOW_LIM	;Test low value		BEQ	NORMRTL		CPX	#<SLOW_LIM	;Try high value		BEQ	NORMRTLBAD_SPEED		EQU	*	;Failed speed test if here		STY	|TST_STATUS+1	;Section of test that failed (1..2)		STX	|TST_STATUS+2	;Wrong value we found		SEC		;d status		RTL		EJECT****************************************************************** Find speed of 816 relative to the Vertical video counter* The X register ends up with a no which is proportional* to the speed of the 816 with respect to the Vertical video* counter which is running at a constant rate.** Call/Ret in NTV8 mode** Return with speed relative speed in X register.*** Note that this test also takes into account the* fact that the FPI should slow down when accessing* the Mega // video counters.*****************************************************************FIND_SPEED	LDX	#0	;Zero counter.		LDA	>VERTCNT	;Get vertical video counterLBL01		CMP	>VERTCNT	;Wait till it changes		BEQ	LBL01	;Loop till new line		LDA	>VERTCNT	;Just begun new value so get itLBL02		INX		;counts occurences of same VERTCNT		CMP	>VERTCNT		BEQ	LBL02	;Repeate till it changes again		RTS		TITLE	'MEGA // Int test.'******************************************************************    File : Custom.IRQ*******************************************************************   MEGA and VGC interupts test.**  Modification history:**  12th-Nov-85   :  JR   : Created*  17th-Feb-86   :  JR   : Modified for Rom** Sequencer calls in NTV8 mode, Data Bank = $00 with JSL.*****************************************************************	; SEG	$00	;Code was written for bank $00CUSTOM_IRQ	EQU	*	;Sequencer entry point 		JSR	MEGATstIRQ	;Test Mega // interupts		BCS	CUS_IRQ_RTL	;Found error so RTL		JSR	VGCTstIRQ	;Now VGCCUS_IRQ_RTL	RTL		;**   VBL interupt*MEGATSTIRQ	EQU	*		SEI		LDA	>INTMGRV+1		STA	IRQTEMP3		LDA	>INTMGRV+2		STA	IRQTemp1		LDA	>INTMGRV+3		STA	IRQTemp2		LDA	#<MEGAIntHnd		STA	>INTMGRV+1		LDA	#>MEGAIntHnd		STA	>INTMGRV+2		LDA	#^MEGAIntHnd		STA	>INTMGRV+3		STZ	INTEN		STZ	CNT1		STZ	CNT2		STZ	CusIRQCnt		CLI		STZ	CLRVBLINT		LDA	#%00001000		STA	INTENLOOP001		LDA	CusIRQCnt		CMP	#1		BEQ	VBLIRQTst		DEC	CNT1	;		BNE	loop001	;		DEC	cnt2	;		BNE	Loop001		LDA	#$01		BRA	MegaErrVBLIRQTST		LDA	CusIRQsts		AND	#%00001000		BNE	QtrIRQ		LDA	#$02		BRA	MegaErr**  1/4 secound interupt*QTRIRQ		STZ	CNT1		STZ	CNT2		STZ	CLRVBLINT		LDA	#%00010000		STA	INTENLOOP002		LDA	CusIRQCNT		CMP	#2		BEQ	TstQtrIRQ		DEC	cnt1	;		BNE	loop002	;		DEC	cnt2	;		BNE	Loop002		LDA	#$03		BRA	MegaErrTSTQTRIRQ		LDA	CusIRQsts		AND	#%00010000		BNE	MegRstre		LDA	#$04MEGAERR		STA	ErrCode1MEGRSTRE		EQU	*	;		SEI		; turn off interrupts		LDA	IRQTEMP3		STA	>INTMGRV+1		LDA	IRQTemp1		STA	>INTMGRV+2		LDA	IRQTemp2		STA	>INTMGRV+3		LDA	ErrCode1		BEQ	MegaPass		SEC		RTSMEGAPASS		CLC		;		RTS	; SEG	RUNBANK	;Rom code bankMEGAINTHND	EQU	*		STZ	|INTEN		LDA	|INTFLAG		STA	|CusIRQsts		INC	|CusIRQCnt		RTI	; SEG	$00		TITLE	'VGC IRQ Test.';*******************************************************************   This is a test of the VGC 1 sec interrupt , and of each of*   the possable scan line interupts .**     13.Nov.85*;*****************************************************************VGCTSTIRQ		EQU	*		DATA8		SEI		LDA	>INTMGRV+1		STA	IRQTEMP3		LDA	>INTMGRV+2		STA	IRQTemp1		LDA	>INTMGRV+3		STA	IRQTemp2		LDA	#<VGCIntHnd		STA	>INTMGRV+1		LDA	#>VGCIntHnd		STA	>INTMGRV+2		LDA	#^VGCIntHnd		STA	>INTMGRV+3		STZ	VGCINT	;VGC Interupts off		STZ	SCANINT	;Clear IRQ flags		STZ	CusIRQSrce	;Point to 1 sec 		STZ	CusIRQCnt		STZ	CNT2		LDA	#$10	;About  4 seconds		STA	CNT3	;Timeout limit for 1 sec IRQ		CLI		LDA	#%00000100		STA	VGCINTLOOP003		LDA	CusIRQCNT		CMP	#1		BEQ	TstSecIRQ		DEC	cnt1	;		BNE	loop003	;		DEC	cnt2	;		BNE	Loop003		DEC	CNT3		BNE	Loop003		LDA	#$05		BRA	ERROR2		EJECTTSTSECIRQ		EQU	*		LDA	CusIRQsts	;Test the IRQ flag		AND	#$C4	;Test bits 2,6,7 only!!!!!!!		CMP	#$C4	;For New VGC's  - 31 MAR 86		IF VGC_SWITCH <> 0 THEN		;For VGC's after about 31 Mar		BEQ	ScanTst	;Scan Line interrupt		ELSE		BEQ	VGCRstre	;( BEQ ScanTst for production VGC's)		ENDIF		LDA	#$06ERROR2		STA	ErrCode1VGCRSTRE		SEI		;		STZ	VGCINT		LDA	#$01		STA	NEWVIDEO		LDA	IRQTEMP3		STA	>INTMGRV+1		LDA	IRQTemp1		STA	>INTMGRV+2		LDA	IRQTemp2		STA	>INTMGRV+3		LDA	ErrCode1		BEQ	VGCPass		SEC		RTSVGCPASS		CLC		;		RTS**  Scan line test*		IF VGC_SWITCH <> 0 THEN		;For new VGC's/room in romSCANTST		SEI		;		LDA	#$FF		STA	CusIRQCnt		STA	CusIRQSrce		STZ	CusLineNo		STZ	VGCINT		STZ	SCANINT		STZ	CNT1		STZ	CNT2		LDA	#$C1		STA	NEWVIDEO	;Enable hiresSCNLINE		LDX	CusLineNo	;One line at a timeSETIRQ		LDA	#%01000000		ORA	$019D00,X		STA	$019D00,X	;Set the IRQ bit		CLI		LDA	#%00000010		STA	VGCINTWAITFIN		LDA	CusIRQCnt		CMP	CusLineNo		BEQ	ScnIRQTst		DEC	CNT1		BNE	WaitFIN		DEC	CNT2		BNE	WaitFIN		LDA	#$07		BRA	ERROR2SCNIRQTST		LDA	CusIRQsts		CMP	#$B2		BNE	FailSts		INC	CusLineNo		LDA	CusLineNo		CMP	#0	;Wrap a round		BNE	ScnLine		BRA	VGCRstreFAILSTS		LDA	#$08		BRL	ERROR2		ENDIF		; SEG	RUNBANKVGCINTHND		EQU	*	;VGC interupt handler		; SEG	$00		LDA	VGCINT		STA	CusIRQsts		LDA	CusIRQSrce		BEQ	IncCnt		LDX	CusLineNo		LDA	#%10111111		AND	$019D00,X		STA	$019D00,XINCCNT		STZ	VGCINT		INC	CusIRQCnt		RTI		EJECT		TITLE	'Vegas ROM test';...............................................................; ROM.CHECKSUM;; Compute Checksum of rom banks $FE, $FF.; and compare with expected value;; Call  :   In Full native mode, Data Bank 0, use JSL; Return:   In Full native mode;; 20 Feb 86: Created; 09 Apr 86: Add register based ram test;; By Karl Grabe, Apple Computer INC., Cork;...............................................................	; SEG	RUNBANKROM_CHECKSUM	EQU	*	;Called from  test sequencer		STZ	RamBank		JSR	DoZPageInd	;Register based ram test first		DATA16		BCS	BAD_RAM	;Ram is bad so report and stop		STZ	CHK_BEG	;Starting address		PEA	|$FCFC	;Firts bank $FC		PLB		PLB		;et data bank register		LDY	#$FFFF	;Entire 64k of rom		JSR	CAL_CHECKSUM	;Go get checksum		PEA	|$FDFD	;Bank $FD		PLB		PLB		DEY		;Entire 64k of rom		JSR	CAL_CHECKSUM2	;Get checksum		PEA	|$FEFE	;Bank $FE		PLB		PLB		DEY		;Entire 64k of rom		JSR	CAL_CHECKSUM2	;Get checksum		PEA	|$FFFF	;Bank $FF		PLB		PLB		DEY		;Entire 64k of rom		JSR	CAL_CHECKSUM2	;Get checksum;; Note that the rom checksum must be adjusted ; to equal $1234;		CMP	#$1234	;Compare with a fixed value; Change CHECKSUM condition in file: MAIN		IF CHECKSUM <> 0 THEN		;Normally do next line		BNE	BAD_ROM	;Bad checksum so fail		ELSE		;Do next line for debugging only		BRA	GOOD_ROM	;Don't fail ROM checkum		ENDIFGOOD_ROM		EQU	*	;Rom ok		CLC		RTLBAD_ROM		EQU	*	;Rom does'nt check out		STA	>TST_STATUS+1	;Save actual checksum for display		LDA	#$CDD2	;"RM" = RoM fail		STA	>LINE1+$100	;Put "RM" msg on screen in case system hangs		SEC		RTL		;ttempt to return to sequencer to put bad message on screenBAD_RAM		EQU	*	;Encountered bad ram during rom test		LDA	#$01	;Bad ram		STA	|TST_STATUS+3	;01-> can't do rom tst because bad ram		STA	|TST_STATUS+1	;Error that occurred (See Test code)		SEC		RTL		EJECT;...............................................................;; Calculate Checksum. 16 Bit ADC;; Call  :   In Full native mode, use JSR; Return:   In Full native mode;; Inputs:;        C: Partially computed checksum, or else 0;  CHK.BEG: Start address to checksum (Zero Page var);        Y: No Bytes  (odd) to checksum;        B: Set data bank reg to required bank.;; Output:;        C: Checksum of C to C+Y inclusive;;; Note:     Have partially computed checksum in C when;           dealing with more than one bank.;; kg nov85;...............................................................CAL_CHECKSUM	EQU	*	;Enter here first bank with C=0, else enter next line+1		LDA	#$0000	;Clear checksum to zero		CLCCAL_CHECKSUM2	EQU	*	;Enter here for remaining banks.		DEY		;rop to low byte of top addressN_NXT_CHK		EQU	*		ADC	(CHK_BEG),Y	;Add to previous value		DEY		;ve to next byte		BEQ	CHK_END	;Fin except for last 2		DEY		;ve to next byte		BNE	N_NXT_CHK	;do next two bytesCHK_END		EQU	*		ADC	(CHK_BEG),Y	;Add last 2 bytes		RTS		;eturn in Native 16 mode		EJECT		TITLE	'Cortland ROM Clock Test';...............................................................; CLOCK; Test each bit in the clock register for R/W; Restore correct time after test.;;; Created :5 Mar 86, KG;; By Karl Grabe, Corcaig.   Apple Computer Ltd.;...............................................................	; SEG	RUNBANKCLOCK		EQU	*		PEA	|$E1E1		PLB		PLB		;ank $E1;; Save time;		JSL	>TOREADTIME	;Cad e an tam?		DATA16		LDA	|CLKRDATA	;Get low binary time word		STA	|BRAM_WORK	;Save it here for retrieval after test		LDA	|CLKRDATA+2	;Get hi time word		STA	|BRAM_WORK+2	;Save it for after test;; Now setup CLKWDATA with 00000000 00000001; and shift thro' each bit;		LDA	#$0001	;LSB		STA	|CLKWDATA	;Lo word		STZ	|CLKWDATA+2	;Hi wordNXT_CLK_BIT	EQU	*	;Check next clock bit		JSR	|WR_RD_CMP_TIME	;Write and see if correctly written		BEQ	CLK_CONT	;Yes, so now check hi word;Doesn't match, so repeat as a second may have incremented ...		JSR	|WR_RD_CMP_TIME	;Write and see if correctly written		BNE	CLK_ERR	;Still doesn't match so we have an errorCLK_CONT		LDA	CLKRDATA+2	;Now check hi word		CMP	|CLKWDATA+2		BNE	CLK_ERR	;No so there's an error		CLC		ROL	|CLKWDATA	;If carry set then bit moves into hi word		ROL	|CLKWDATA+2	;		BCC	NXT_CLK_BIT	;Not finished with 32 bits so continue		LDA	|BRAM_WORK	;Now restore original time		STA	|CLKWDATA		LDA	|BRAM_WORK+2		STA	|CLKWDATA+2	;Restore hi word		DATA8		JSL	>TOWRITETIME		CLC		RTLCLK_ERR		EQU	*	;Fail handler		SEC		RTL		EJECT;...............................................................; WR.RD.CMP.TIME  16/16;; Write, read back and compare write to read data; Z=1 if results equal ( ie good );...............................................................WR_RD_CMP_TIME	EQU	*		DATA8		JSL	>TOWRITETIME	;Write to clock		JSL	>TOREADTIME	;Now read back		DATA16		LDA	|CLKRDATA	;Clock data read back		CMP	|CLKWDATA	;Does it match what was written ?		RTS		TITLE	'Text Pg1 shadow test';*******************************************************************   File  :  SHADOW*;********************************************************************  This test checks shadow reg bit 0 (text page 1) by writing*  a known pattern , then  checking for the presence of this *  pattern depending on the state of the shadow register.***   Modification history  :**   10-Mar-86   :   JR  : Today**   15-Apr-88   : BS Soh: Modify to test the shadowing of text page 2*                         for the Gyro**   06-Feb-89   : MS Askins: Change Shadow.Tst so that it terminates*                         with an RTL (not RTS), fixed a stack problem,*                         code now returns with carry indicating whether*                         the call was successful.*;*****************************************************************	; SEG	$00	;Reflect data bankSHADOW_TST	EQU	*		DATA8		STZ	SHADOW	;Shadow all		LDA	#$09		STA	ShdBit	;Test Shadowing of text page 1 first		DATA16		LDA	#$0400	;1st page starting address		JSR	ShdText	;Test Text Page 1		BCS	Page1_Err;; Text Page 2 shadow test;		DATA8; Check key micro version number;		JSR	GETVERSION		BCS	s_fdb_err	; problem reading up		CMP	#$6	;Is version >= 6 ?		BCS	GYROS	;Yes, is Gyro		BRA	Shd_ret	; No, is gs, skip page 2 test & exitGYROS		STZ	SHADOW	;Shadow all		LDA	#$28		STA	ShdBit	;Test Shadowing of text page 2		DATA16		LDA	#$0800	;2nd page starting address		JSR	ShdText	;go test		BCS	Page2_Err		LONGA	OFF		LONGI	OFF;; Testing CYA register Power-On-Clear bit (Bit 6);		LDA	CYAREG	;Read CYA register		PHA		;ave it		AND	#$BF	;Clear POC bit		STA	CYAREG		LDA	CYAREG	;Read back and check		AND	#$40	;Bit 6 must be resetable		BNE	CYAREG_Err	;Error		LDA	CYAREG		ORA	#$40	;Set Bit 6		STA	CYAREG		LDA	CYAREG	;Read back and check		AND	#$40		BEQ	CYAREG_Err	;Error		PLA		STA	CYAREG	;Restore itSHD_RET		RTL		;eturn to caller (end of shadow test)*PAGE1_ERR		LDA	#$01	;Page 1 error code		BRA	epath*PAGE2_ERR		LDA	#$02	;Page 2 error code		BRA	epath*CYAREG_ERR	PLA		;Fix the stack		STA	CYAREG	;Restore it		LDA	#$04	;CYAREG POC bit error code		BRA	epath*S_FDB_ERR		LDA	#$03	;FDB Call error codeEPATH		EQU	*		STA	Tst_Status+1		SEC		RTL** Test one page of $400 byte beginning with addr specified by acc*SHDTEXT		EQU	*		DATA16		STA	ShdStrt	;Starting address of the page		STZ	ShdStrt+2		LDA	#ShadPatt1		JSR	ShdWrite	;Write patt # 1 to bank $00		INC	ShdStrt+2		JSR	ShdWrite	;Write patt # 1 to bank $01		MEM8		LDA	ShdBit		STA	SHADOW	;Inhibit text shadowing		IND16		LDA	#ShadPatt2		STA	ShdData		JSR	ShdWrite	;Write patt # 2 to bank $01		DEC	ShdStrt+2		JSR	ShdWrite	;Write patt # 2 to bank $00		JSR	ShdVerfy	;Check bank $00		BCS	C035_Bad		INC	ShdStrt+2	;Check bank $01		JSR	ShdVerfy		BCS	C035_Bad		LDA	#ShadPatt1		STA	ShdData		LDA	#$00E0		STA	ShdStrt+2		JSR	ShdVerfy	;Check bank $E0		BCS	C035_Bad		INC	ShdStrt+2		JSR	ShdVerfy	;Check bank $E1C035_BAD		EQU	*		DATA8		STZ	SHADOW		RTS**   'Write' a pattern routine*		LONGA	ON		LONGI	ONSHDWRITE		LDY	#$0000SHDSTORE		STA	[ShdStrt],Y	;Write directly to the bank		INY		INY		CPY	#ShdLenght	;End of page ?		BNE	ShdStore		RTS**  'Verify' the data in any Bank*SHDVERFY		LDY	#$0000SHDFETCH		LDA	[ShdStrt],Y	;Load directly from the bank		CMP	ShdDATA		BNE	ShdFail		INY		INY		CPY	#ShdLENGHT		BNE	ShdFetch		CLC		RTSSHDFAIL		SEC		;		RTS		TITLE	'Vegas Battery Ram test';...............................................................; BAT.RAM  (JSL); ROM based Battery Ram Tests using Cortland tools;;; Errors: Carry Set,;         TST.STATUS+1 :  1=ADDRESS, TST.STATUS+2 = Failed address.;;         TST.STATUS+1 :  2=PATTTERN, TST.STATUS+2 = PATTERN;                                     TST.STATUS+3 = FAILED ADDRESS;;  Created: 04 Mar 86, KG;;  Karl Grabe. Apple Computer Ltd.  Cork.;...............................................................	; SEG	RUNBANKBAT_RAM		EQU	*		DATA16		LDA	#BRAM_TEMP	;Used to hold NVR contents suring test		STA	BAT_RAM_PTR	;READ.NVR routine uses this		STZ	BAT_RAM_PTR+2	;Upper two bytes of pointer		JSR	READ_NVR	;Copy it to BRAM.TEMP;Now do address uniqueness test		LONGI	OFF		LONGA	OFF		LDY	#255	;Entire bufferNXT_BAT_ADR	EQU	*		TYA		STA	|BRAM_WORK-1,Y	;Store unique value in each addr		DEY		BNE	NXT_BAT_ADR	;Do next bat ram address		JSR	WR_RD_CMP	;Write to Bram, read and compare		BCS	BAT_RAM_ER2	;Error so exit		LDX	#5	;6 Patterns		STX	|CUR	;Use as temp storageNXT_BAT_PAT	EQU	*	;Do next battery pattern		LDX	|CUR	;Get counter back		LDA	>BAT_PAT,X;; FILL.BRAM.WORK; Fill BRAM.WORK buffer with accumulator;FILL_BRAM_WORK	EQU	*		LDY	#255	;Entire bufferNXT_FILL_WORK	EQU	*		STA	|BRAM_WORK-1,Y	;Fill byte		DEY		BNE	NXT_FILL_WORK		JSR	WR_RD_CMP	;Write to Bram, read then compare.		BCS	BAT_RAM_ER1	;Er so exit		DEC	|CUR	;Another Pattern ?		BPL	NXT_BAT_PAT	;Try another pattern		BRA	GOOD_BAT_RAM	;Restore Bram and exitBAT_RAM_ER1	INC	|TST_STATUS+1	;Record error codeBAT_RAM_ER2	INC	|TST_STATUS+1	;Rec er cd		STA	|TST_STATUS+2	;Address or pattern that failed		STY	|TST_STATUS+3	;Address of fail if pattern test		SEC		;rror flag		RTL		;ack to sequencerGOOD_BAT_RAM	EQU	*	;Battery ram ok		DATA16		LDX	#BRAM_TEMP	;Where we saved NVR initially		JSR	WRITE_NVR	;Go restore NVR to what was there before test		CLC		;lear error status		RTL		;.to sequencer;...............................................................; WR.RD.CMP  8/8; Write BRAM.WORK to Bram, read Bram to BRAM.WORK1; then copmare BRAM.WORK to BRAM.WORK1 ;; Carry set if error,; A = Pattern that failed; Y = Address fail occurred;...............................................................WR_RD_CMP		EQU	*;; WR.BRAM.WORK;; Write BRAM.WORK to Bram;		DATA16		LDX	#BRAM_WORK	;Save this buffer to bram		JSR	WRITE_NVR	;Go save it;; RD.BRAM.WORK1;; Copy Bram into BRAM.WORK1;RD_BRAM_WORK1	EQU	*		LDA	#BRAM_WORK1	;Now read back NVR into this buffer		STA	BAT_RAM_PTR	;Tell READ.NVR routine where to read to		JSR	READ_NVR;; Now compare BRAM.WORK1 to BRAM.WORK;CMP_BRAM_WORK	EQU	*		LONGA	OFF		LONGI	OFF		LDY	#252	;But not checksum bytes (4)NXT_CMP_WORK	EQU	*		LDA	|BRAM_WORK-1,Y	;Bram		CMP	|BRAM_WORK1-1,Y	;Cortalnd ram		BNE	BRAM_CMP_ER	;No match so error		DEY		BNE	NXT_CMP_WORK		CLC		;ood status		RTSBRAM_CMP_ER	EQU	*	;Bad status		SEC		RTSBAT_PAT		DC.B	$AA,$55,$00,$FF,$CC,$33		EJECT;...............................................................; WRITE.NVR 16/16; Write buffer pointed to by X to NVR;;...............................................................		LONGA	ON		LONGI	ONWRITE_NVR		EQU	*;X already set up		LDY	#BRAMBUFFER	;Normally in bank $e1		LDA	#255	;All of buffer		MVN	$000000,BRAMBUFFER	;Move it into bank $e1		DATA8		JSL	>TOWRITEBR	;Go write it		JSR	BANK_0	;Data bank = 0		DATA16		RTS;...............................................................; READ.NVR XX/8; Copy NVR into a 4 byte buffer ppointed to by BAT.RAM.PTR;;...............................................................READ_NVR		EQU	*		DATA8		PHB		;ave current data bank reg		PHP		;ISABLE INTERRUPTS DURING WRITE		SEI		LDX	#$00	;Start with 1st byte		TXY		;tart with address 00READBRLP		EQU	*		SEP	#$40	;Set v for read		JSR	XTNDBRAM	;Read a byte		PHY		;ave y		TXY		STA	[BAT_RAM_PTR],Y	;Save for later		PLY		;ow restore y		INX		;ext		INY		;ext address		BNE	READBRLP		PLP		;estore interrupt status		CLC		;ata intact indicator		SEP	#$30	;M,X back to 8 bit mode		PLB		;estore data bank register		RTSXTNDBRAM		EQU	*	;Set up command and extended address		PHA		;ave data to wr to clock register		TYA		;reate extended address		PHA		;ave for later		AND	#$E0	;Get sector data		LSR	A	;Move to bits 012		LSR	A		LSR	A		LSR	A		LSR	A		ORA	#EXMEMCMD	;Sets command corerectly ($38)		BVC	XTNDBRAM4	;V=0 then writing		ORA	#$80	;Modify command for readingXTNDBRAM4		EQU	*		XBA		;ove in hi byte of a		PLA		;ecall adr		AND	#$1F	;Strip off sector bits		ASL	A	;Shift bits 2 to 6		ASL	A		XBA		;ave address/do command		PHP		;ave user read/write command		JSR	ACCCLKCLV	;Transfer command to clock chip		XBA		;end address to write to, to clock chipXTNDBRAM6		EQU	*		JSR	ACCCLKCLV	;Transfer extended adr to clk chip		PLP		;ecall what test sequencer wants		PLA		;ecall sequencer data if writing		JSR	ACCCLOCK	;Read/write byte of data		PHA		LDA	|CLOCKCTL	;Reset bit		AND	#$DF		STA	|CLOCKCTL		PLA		RTSACCCLKCLV		EQU	*	;Write a byte of data to clock chip		CLV		;or write dataACCCLOCK		EQU	*	;Send a byte of data to the clock chip		STA	|CLOCKDATA	;Data/address/cmd to clock data register		LDA	|CLOCKCTL	;Reset read/write bit		AND	#$3F	;Bit 7/6 to 0		BVS	ACCCLOCK0	;V=1 IF READING		ORA	#$A0	;Bit 7/5 to 1 to write transfer		BRA	ACCCLOCK1ACCCLOCK0		EQU	*	;Doing a read of battery ram if here		ORA	#$E0	;Enable transfer for readingACCCLOCK1		EQU	*	;		STA	|CLOCKCTL	;ACCCLOCK2		EQU	*	;Wait till transaction is done		LDA	|CLOCKCTL	;Wait for transfer to complete		BMI	ACCCLOCK2	;Loop till done		LDA	|CLOCKDATA	;Data is in a on exit		RTS		TITLE	'Cortland FDB test'		EJECT;...............................................................; FDB; Test the FDB processor rom;;; Created : 27 Feb 86; Modified : 19 Mar 86 for rom; Modified : 10 Apr 86 use FDB tool call; Modified :  5 Apr 88 for Gyro new keybd micro;; Routine to read FDB rom into main ram; starting at FDB.BUF and then do a checksum.;; Call/RET: NTV16;; Output: Carry set if error, TST.STATUS+1,+2 CONTAINS BAD CHECKSUM                 ;; By Karl Grabe Apple Computer Ltd., Cork by the Lee;...............................................................FDB		EQU	*	; SEG	$00		DATA8;; Check key micro version number;		JSR	GETVERSION		BCS	FDB_TOOL_ER	;Tool had problem reading up		DATA16		AND	#$FF	;Take away MS byte		CMP	#$6	;Is version >= 6 ?		BCS	GYRO	;Yes, is Gyro		LDA	#FDB_ROM_B	;Start address		BRA	SKIPNEXTGYRO		LDA	#FDB_ROM_GYRO_ASKIPNEXT		STA	POINTER		LDA	#FDB_BUF	;Where to stash in main mem		STA	BAT_RAM_PTRNXT_FDB_BYTE	DATA8		JSR	R_FDB	;Read a byte		BCS	FDB_TOOL_ER	;Tool had a problem reading up		STA	(BAT_RAM_PTR)	;Save it		DATA16		INC	BAT_RAM_PTR		INC	POINTER	;FDB rom address		LDA	POINTER		CMP	#FDB_ROM_E+1	;Are we at end of rom yet ?		BMI	NXT_FDB_BYTEFDB_CHECK_TST	EQU	*	;Debug entry point (NTV16)		LDA	#FDB_BUF	;Start of address where FDB rom code is		STA	CHK_BEG		LDA	KEY_VERSION	;Get version number		AND	#$FF		CMP	#$6	;Is it >= 6?		BCS	GYRO2	;Yes, Gyro		LDY	#FDB_ROM_E-FDB_ROM_B	;End address		BRA	SKIPNEXT2GYRO2		LDY	#FDB_ROM_E-FDB_ROM_GYRO_A	;End addressSKIPNEXT2		JSR	CAL_CHECKSUM	;Go do checksum (data bank is zero)		CMP	#FDB_REV2		BEQ	FDB_GOOD_CHK	;It's rev 2		CMP	#FDB_REV3	;All other revs must equal this		BNE	FDB_BADFDB_GOOD_CHK	EQU	*		CLC		RTL		;allable from disk diagnostics also		LONGA	OFF		LONGI	OFFFDB_TOOL_ER	EQU	*	;Tool had problem reading uC		LDA	#1	;Tool problem		STA	TST_STATUS+3	;Last byte of statusFDB_BAD		STA	TST_STATUS+1	;The error tool encountered		SEC		;ad status		RTL		EJECT	IF USE_FDB_TOOL <> 0 THEN		;Use following code if FDB tool code is in rom****************************************************************** Read a byte from the FDB Processor Memory (RAM/ROM)*                      .... Using Vegas Tool code** Call: in 8 bit mode* RTN : in 8 bit mode** Inputs:*        (POINTER) is byte to read*        ROM in range $1400-1FFF*        RAM in range $0000-0050** Output:*        ACC containes byte*****************************************************************R_FDB		EQU	*		MEM16		;Into 16 bit memory		LONGI	OFF		LDA	#0	;STZ has no long address mode		STA	>FLAGS	;Set these to zero for tool		STA	>FLAGS+2		STA	>FLAGS+4		PEA	^RESULT		PEA	|RESULT	;Where to stash result		PEA	^POINTER	;And uppr		PEA	|POINTER	;Tell tool wher i/p is		PEA	9	;The command no		PHA		;ush 3 dummy bytes		PHB		;rd byte;; Set up stack to RTL from tool		LDX	#^FDB_TOOL_RTN	;So we get good rtl from tool		PHX		;ank address		PEA	|FDB_TOOL_RTN-1;; Set up stack to RTL to tool instead of JSL		; SEG	$00		LDA	>FDB_TOOL_ADDR+2	;Push 3 bytes RTL address		TAX		PHX		LDA	>FDB_TOOL_ADDR		PHA		;et ready to RTL to tool entry point		DATA16		;Back to index 16 (already in mem16)		RTL		;o Front Desk Bus tool		; SEG	RUNBANKFDB_TOOL_RTN	EQU	*	;Tool will RTL here;Now pull off garbage bytes		DATA8		PLA		PLA		PLA		LDA	|RESULT	;Get rom contents		RTS;****************************************************************** Routine to read the key micro version number*                        .... Using Tools call** Call: in 8 bit mode* RTN : in 8 bit mode** Output:*        KEY.VERSION contains version number*****************************************************************GETVERSION	EQU	*		MEM16		;Into 16 bit memory		IND8		LDA	#0	;STZ has no long address mode		STA	>FLAGS	;Set these to zero for tool		STA	>FLAGS+2		STA	>FLAGS+4		PEA	1	;Data length		PEA	^RESULT		PEA	|RESULT	;Where to stash result		PEA	$000D	;The command no		PHA		;ush 3 dummy bytes		PHB		;rd byte;; Set up stack to RTL from tool		LDX	#^FDB_TOOL_RTN2	;So we get good rtl from tool		PHX		;ank address		PEA	|FDB_TOOL_RTN2-1;; Set up stack to RTL to tool instead of JSL		; SEG	$00		LDA	>RD_KEY_DATA+2	;Push 3 bytes RTL address		TAX		PHX		LDA	>RD_KEY_DATA		PHA		;et ready to RTL to tool entry point		IND16		;Back to index 16 (already in mem16)		RTL		;o Front Desk Bus tool		; SEG	RUNBANKFDB_TOOL_RTN2	EQU	*	;Tool will RTL here;Now pull off garbage bytes		DATA8		PLA		PLA		PLA		LDA	|RESULT	;Get rom contents		STA	KEY_VERSION		RTS		EJECT		ELSE				;****************************************** Read a byte from the FDB Processor Memory (RAM/ROM)*                      ... Don't use FDB Tool code** Call: in 8 bit mode* RTN : in 8 bit mode** Inputs:*        (POINTER) is byte to read*        ROM in range $1400-1FFF*        RAM in range $0000-0050** Output:*        ACC containes byte*				;****************************************		DATA8R_FDB		LDA	#%00001001	;Command byte to read UP memory		JSR	FDB_CMD	;Do a store to FDB micro, rtn when ready		BCS	ERR_RET	;Error sending command		LDA	POINTER	;the low byte of rom start address		JSR	FDB_CMD	;Store lo address		BCS	ERR_RET	;Error sending command		LDA	POINTER+1	;Hi address		JSR	FDB_CMD	;Do hi		BCS	ERR_RET	;Error sending command		JSR	FDB_RDATA	;Read data & wait till rdy		BCS	ERR_RET	;Error sending command		RTS;...............................................................; FDB.CMD; Write a byte to FDB processor;; Store acc in FDB command register and wait; 'till ready for next command/data;; Input Accumulator;; 8 bit mode;...............................................................FDB_CMD		EQU	*		IND16		PHP		;ave interrupt status		SEI		;o interrupts		TAX		;ave the command/data byte;@2 LDA DATAREG  ;DUMMY READ		LDA	KMSTATUS	;Get status for command accept		ROR	A	;Put lsb in carry		TXA		;t data back;BCS @2		BCS	FDB_ERR	;BRA If register not empty, flag error !!		STA	DATAREG	;Else store away new command/data		LDX	#7500	; Timeout 7500*(2+2+4+2+3)/3 = 30 ms@1		DEX		;		BEQ	FDB_ERR	;Timeout error		LDA	KMSTATUS	;Get command reg full bit		ROR	A	;Put lsb in carry		BCS	@1		PLP		;estore interrupt status		IND8		CLC		;'=0, o.k.		RTSFDB_ERR		PLP		;		IND8ERR_RET		SEC		;		RTS		EJECT;...............................................................; FDB.RDATA; Read a byte from FDB processor;; Read DATAREG register ( Wait till data valid );; Output : Accumulator;; 8 bit mode;;...............................................................FDB_RDATA		EQU	*		IND16		PHP		;ave interrupt status		SEI		;o interupts allowed		LDX	#7500@1		DEX		;		BEQ	FDB_ERR	;Timeout error		LDA	KMSTATUS		AND	#$20	;Data full?		BEQ	@1	;No, wait		LDA	DATAREG	;Get the FDB DATA		PLP		IND8		CLC		RTS;...............................................................; Read the version number from key board micro;                        ... Don't use FDB Tools call;; Call: in 8 bit mode; Rtn; in 8 bit mode; Input: None;; Output:;   ACC contain version number;   KEY.VERSION contain version number;...............................................................GETVERSION	EQU	*		LDA	#$0D	;Command to read kbmicro version number		JSR	FDB_CMD	;Send command to kb micro		BCS	ERR_RET	;Error sending command		JSR	FDB_RDATA	;Read back data		BCS	ERR_RET	;Error sending command		STA	KEY_VERSION		RTS		ENDIF		TITLE	'New Ram Address Test';**************************************************** File: RAM.ADDR** Routines to test the addressing of all onboard RAM*  taking care to notice the Bank Address in the test.***  20 Mar 86  R.Carr       New Today!**  11 Nov 86  R.Montagne   Rewritten to fix access of*                          bank0 softswitches when I/O*                          shadowing is turned off.**  18 May 88  BS Soh       Expanded to 1 M Ram for Rev D**;**************************************************	; SEG	RUNBANKRAM_ADDR		EQU	*	; SEG	$00DONEWADDR		EQU	*;pea $00E1 ; data bank to E1 for softsw access;plb		DATA8		JSR	GETVERSION		BCS	A_FDB_err	;Tool had problem reading up		LDA	|shadow	; preserve shadow register		PHA		LDA	#%01111111	; and turn shadowing off		STA	|shadow		LDX	#3	; pointer to bank under testWLP1		LDA	>Banktbl,x		STA	RamBank		STA	loc+2		PHX		; save test bank pointer		REP	#$30	; 16 bit 'm' and 'x'		LONGA	ON		LONGI	ON		STZ	loc	; sets up the indirection		LDY	#$400	; start addr		LDX	#$bffe	; end addr		JSR	writeit	; fill mem with test pattern		SEP	#$20	; 8 bit 'm'		LDA	lcbank1	; R/W ram lc bank 1		LDA	lcbank1		REP	#$20	; 8 bit 'm'		LDY	#$d000	; start address		LDX	#$fffe	; end address		JSR	writeit	; fill mem with test pattern		SEP	#$30	; 8 bit 'm' and 'x'		LONGA	OFF		LONGI	OFF		PLX		; restore test bank pointer		DEX		BPL	wlp1;; Check key micro version number;		LDA	KEY_VERSION		CMP	#$6	;Is version >= 6 ?		BCC	IIGS	;No, it's IIgs		LDA	#$01		STA	RamBankEXPBANK_A		INC	RamBank	; Start with Bank $02		LDA	RamBank		CMP	#$10	;Has it exceeded max?		BCS	IIgs	;Yes Exit		STA	loc+2	; Setup bank number		DATA16		STZ	loc	; Setup the indirection		LDY	#0	; Start from 0		LDX	#$fffe	; End address		JSR	writeit	; Fill memory with test pattern		MEM8		BRA	ExpBank_A	; More Bank;A_FDB_ERR		LDA	#$FF		STA	ErrCode1		SEC		BRA	NewAddrErr;IIGS		IND8		LDX	#3	; pointer to bank under testCLP1		LDA	>BankTbl,x	; get bank under test		STA	Rambank		STA	loc+2		PHX		REP	#$30	; 16 bit 'm' and 'x'		LONGA	ON		LONGI	ON		STZ	loc	; preset address		LDY	#$400	; start of addr check		LDX	#$bffe	; end of addr check		JSR	cmpit		BCS	CmpFail		SEP	#$20	; 8 bit 'm'		LDA	lcbank1	; R/W ram in LC bank 1		LDA	lcbank1		REP	#$20	; 8 bit 'm'		LDY	#$d000	; start address		LDX	#$fffe	; end address		JSR	cmpitCMPFAIL		SEP	#$30	;carry is set on error		LONGA	OFF		LONGI	OFF		PLX		; restore pointer to test bank		BCS	NewAddrErr		DEX		BPL	Clp1;; Check key micro version number;		LDA	KEY_VERSION		CMP	#$6	;Is version >= 6 ?		BCC	NewAddrErr	;No, it's IIgs		LDA	#$01		STA	RamBankEXPBANK_B		DATA8		INC	RamBank	; Start with Bank $02		LDA	#$0F	;Maximum bank number		CMP	RamBank	;Has it exceeded max?		BCC	NewAddrErr	;Yes Exit		LDA	RamBank		STA	loc+2	; Setup bank number		DATA16		STZ	loc	; Setup the indirection		LDY	#0	; Start from 0		LDX	#$fffe	; End address		JSR	cmpit	; Compare it pattern		BCC	ExpBank_B	; More Bank		DATA8NEWADDRERR	EQU	*		PLA		; restore shadow reg		STA	$E0C035	;real shadow location;plb ; set bank back to 0		BIT	|$C081	; turn the rom back on		RTL*WRITEIT		EQU	*		STX	RamEndAddrWRITELP1		TYX		TYA		CLC		ADC	RamBank		TXY		STA	[loc],y		INY		INY		CPY	RamEndAddr		BCC	writelp1		RTS*CMPIT		EQU	*		STX	RamEndAddrCMPLP1		TYX		TYA		CLC		ADC	RamBank		TXY		CMP	[loc],y		BNE	cmperror		INY		INY		CPY	RamEndAddr		BCC	cmplp1		CLC		RTS*CMPERROR		EQU	*		STA	ErrCode1	;16 bit write is ok!		TYA		; as this covers it		XBA		STA	ErrCode2		SEC		RTS**	; SEG	RUNBANK	;Table is in ROMBANKTBL		DC.B	$0,$1,$E0,$E1	;table of banks to check