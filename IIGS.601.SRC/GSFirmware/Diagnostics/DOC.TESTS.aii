		TITLE	'Doc register init routine';	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 7:16:40 PM;********************************************************** Doc.exec: This routine will control the execution of the rom*           based sound diagnostics.  The test will consist of*           a ram test, register test and a limited functional*           test which will generate tones using a sawtooth*           waveform.**     Input: e=0, m=0, x=0 ; full native*            All registers preserved.**     Output: e=0, m=0, x=0 ; full native*             same as entry*;********************************************************DOC_EQU		EQU	*	;;;DOC_EXEC		EQU	*	;		CLC		;		XCE		; native mode		LONGA	ON		LONGI	ON		REP	#$30	; m=0, x=0		PHB		; save data bank		PHD		; save direct reg.		TSC		; form a zero page area		SEC		;		SBC	#$10	; 16 bytes of zero page		TCS		;		INC	A	; point to zero page addr 0		PHA		; set direct register		PLD		;		PEA	$0000	; set data bank		PLB		;		PLB		;		JSR	doc_init	; place doc in a known state;;**************************************************** This set of tests to be integrated into* Apple][GS ROM includes the following* diagnostic functions related to the * Ensoniq DOC.....** (0)   Address Register Test* (1)   RAM data test* (2)   RAM Address test* (3)   Register Data Test* (4)   Control Register Test** Written by Ray Montagne - Oct. 30, 1986*;**************************************************		SEP	#$30	; 8 bit 'm' and 'x'		LONGA	OFF		LONGI	OFFNEXT0		EQU	*		JSR	ram_data	; do ram data test		BCC	next1	; if no error		LDA	#$01	; ram data test		BCS	report	;NEXT1		EQU	*		JSR	doc_ram	; do ram address test		BCC	next2	; if no error		LDA	#$02	;		BCS	report	;NEXT2		EQU	*		JSR	reg_data	; do register data test		BCC	next3	; if no error		LDA	#$03	;		BCS	report	;NEXT3		EQU	*		JSR	ctrl_reg	; do control register test		BCC	next4	; if no error		LDA	#$04	; sound glu control reg error		BCS	report	;NEXT4		EQU	*		JSR	Doc_sound_tst	; run the sound diagnosticsREPORT		EQU	*	;		SEP	#$30	; m,x 8 bits		LONGA	OFF		LONGI	OFF		STZ	|tst_status+1	; clear error field		STZ	|tst_status+2	;		STA	|tst_status+3	; save possible error code		LDA	#$0C	; save test number		STA	|tst_status	;    ;EXIT_DOC_EXEC	EQU	*	; all done go away		PHP		; save carry bit		JSR	doc_init	; shut down the DOC		PLX		; carry status in x for now		TSC		; restore stack space		CLC		;		ADC	#$10	;		TCS		;		PHX		PLP		; restore carry bit		PLD		; restore direct register		PLB		; & data bank		RTL		; >>>--- exit Doc.exec --->>>;;		TITLE	'RAM data test';**************************************************** This test checks the data lines to each* location in DOC ram.*;**************************************************RAM_DATA		EQU	*		LONGA	OFF		;		LONGI	ON		REP	#$10	; 16 bit index registers		STZ	|sgaddrl	; set base address		STZ	|sgaddrh		LDA	#%01000000	; select ram w/o incr		STA	|sgcontrol		LDA	|sgcontrol	; a short delay (I don't know why)		LDA	|sgdata		LDY	#$0000	;RAMDATA0		EQU	*		LDA	#$01		STA	TheData	;Test Pattern		LDX	#$0007	; point top of pattern tableRAMDATA1		EQU	*		LDA	TheData	; get data pattern		STA	|sgdata	; write to sound ram		JSR	ReadData	; read it back		CMP	TheData	; and check it		BNE	RamDatErr	; if ram data error		ASL	TheData	; next pattern		BNE	RamData1	; check all bits		DEY		; next ram location		STY	|sgaddrl	; set address register		BNE	RamData0	; then go test next location		LONGI	OFF		SEP	#$10	; 8 bit index registers		CLC		RTSREADDATA		EQU	*	;		LDA	|sgdata		LDA	|sgdata		RTS		;		TITLE	'RAM address test';**************************************************** This test checks the each of the address* lines to DOC ram for either shorts or * opens.  The test does not distinguish* any difference between a short or open.*;**************************************************DOC_RAM		EQU	*		LDA	#%01100000	; set ram w/incr		STA	|sgcontrol		LDA	|sgcontrol	; a short delay		LDA	|sgdata	; update register data		REP	#$10	; 16 bit 'x'		LONGI	ON		LDX	#$0001	; initial test addressRAMADDR0		EQU	*		JSR	clrram	; clear all ram to zero		STX	|sgaddrl	; set test address		LDA	#$A5	; write unique data to test addr		STA	|sgdata		STZ	|sgaddrl	; set ram base address		STZ	|sgaddrh		LDY	#$0000	; address counter		LDA	|sgdata	; clock in preset addressRAMADDR1		EQU	*		LDA	|sgdata	; read ram and check for data		CMP	#$A5		BEQ	RamAddr2	; if found dataRAMADDR3		EQU	*		DEY		; check all of ram		BNE	RamAddr1		REP	#$20	; 16 bit 'm'		TXA		; get test address		ASL	a	; make next test addr		TAX		SEP	#$20	; 8 bit 'm'		BCC	RamAddr0	; loop till all lines checked		SEP	#$30	; 8 bit 'm' and 'x'		CLC		; return without error		RTSRAMADDR2		EQU	*		INX		; adjust for auto incr		INX		CPX	|sgaddrl	; is addr = test addr?		PHP		DEX		; but put it back		DEX		PLP		BEQ	RamAddr3	; yes, ignore itRAMDATERR		EQU	*	;		SEP	#$31	; 8 bit 'm' & 'x' with carry set		RTS		TITLE	'Clear DOC Ram';**************************************************** This routine must be called in 16 'x' native mode*;**************************************************CLRRAM		EQU	*		PHX		LDX	#0		STZ	|sgaddrl	; set base address		STZ	|sgaddrhCLRRAM0		EQU	*		STZ	|sgdata	; clear the ram		DEX		BNE	clrram0		PLX		RTS		TITLE	'Register data test';**************************************************** This test checks the data lines to each* of the DOC registers.*;**************************************************		LONGA	OFF		LONGI	OFFREG_DATA		EQU	*		STZ	|sgaddrl	; set base address		STZ	|sgcontrol	; select register w/o incr		LDA	|sgdata		LDX	#0	; init mask table pointerREGDATA0		EQU	*		LDA	#$01		STA	TheData	;Test PatternREGDATA1		EQU	*		LDA	TheData	; get data pattern		AND	>DataMask,x	; bits to check		STA	TestData	; save test data for compare		STA	|sgdata	; write to sound register		JSR	ReadData	; read it back		AND	>DataMask,x	; mask off untestable bits		CMP	TestData	; and check data integrity		BNE	RegDatErr	; if register data errorREGDATA2		EQU	*		ASL	TheData	; Next pattern		BNE	RegData1	; check all bitsREGDATA3		EQU	*		INC	|sgaddrl	; increment register address		LDA	|sgaddrl		CMP	#$E0	; done all?		BEQ	RegData4	; yes		ROL	a	; else make mask index		ROL	a		ROL	a		ROL	a		AND	#%00000111		TAX		BRA	RegData0REGDATA4		EQU	*		CLC		RTSREGDATERR		EQU	*		SEC		RTS;;CODE_BANK		EQU	RUNBANK		; SEG	code_bank	; code runs out of bank $FF;DATAMASK		EQU	*		DC.B	%11111111	; bits to test in addr range $00-1F		DC.B	%11111111	; bits to test in addr range $20-3F		DC.B	%11111111	; bits to test in addr range $40-5F		DC.B	%00000000	; bits to test in addr range $60-7F		DC.B	%11111111	; bits to test in addr range $80-9F		DC.B	%11110110	; bits to test in addr range $A0-BF		DC.B	%01111111	; bits to test in addr range $C0-DF		DC.B	%00000000	; bits to test in addr range $E0-FF;	; SEG	$00;		TITLE	'Control Register test';**************************************************** This test checks the operation of bits * 5 and 6 in the sound glu control register.*;**************************************************CTRL_REG		EQU	*		STZ	|sgaddrl	; set address $0000		STZ	|sgaddrh		STZ	|sgcontrol	; set DOC register access w/o incr		LDA	#$A5	; write unique data to DOC register		STA	|sgdata		LDA	#%01000000	; set DOC ram access w/o incr		STA	|sgcontrol		LDA	#$5A	; write unique data to DOC ram		STA	|sgdata		STZ	|sgcontrol	; set DOC register access w/o incr		JSR	ReadData	; read data from DOC register		CMP	#$A5		BNE	CtrlErr	; if data incorrect		STA	|sgdata	; if problems, will induce ram error		LDA	#%01000000	; set DOC ram access w/o incr		STA	|sgcontrol		JSR	ReadData	; read data from DOC ram		CMP	#$5A		BNE	CtrlErr	; if data incorrect		CLC		RTSCTRLERR		EQU	*		SEC		RTS		TITLE	'DOC sound test';********************************************************** Doc.sound.tst: This routine load a waveform into memory and*                play it in interrupt driven mode making sure*                that each oscillator is able to play and*                generate interrupts.**     Input: e=0, m=?, x=?*;********************************************************DOC_SOUND_TST	EQU	*	;		LONGA	OFF		LONGI	OFF		PHP		; save m,x		SEP	#$30	;		JSR	doc_init	; set DOC to known state		JSR	make_waves	; initialize sawtooth waveform		STZ	irq_counter	; reset interrupt counter		STZ	fail_timer	; reset failsafe timer		STZ	fail_timer+1	;		LDA	#$20	; 32 oscillators		STA	osc_busy	;		LONGA	ON		;		REP	#$20	; 16 bit accumulator		LDA	#doc_irq	; set interrupt handler		STA	>irq_vector+1	; set up vector		LDA	#>doc_irq	;		STA	>irq_vector+2	;		LONGA	OFF		;		SEP	#$20	;		CLI		; enable interrupts		LDA	#$80	; volume halfway		LDX	#$40	;		LDY	#$20	; all 32 oscillators		JSR	reg_init	;		LDA	#$08	;		LDX	#$20	;@10		EQU	*	;		JSR	write_reg	; write to the frequency register		INC	A	; bump the 		INX		; bump register number		DEC	osc_busy	; count 32 osillators		BNE	@10	;@6		BIT	osc_busy	; wait for it to finish		BNE	@5	;		LDA	irq_counter	; check the interrupt count		CMP	#$20	; check for 32 irq osc 0-1F		BLT	@1	; all done! 		LDX	#$00	; mark success		PLP		; mark success		CLC		;		BCC	@2	; and go away@1		LDA	irq_counter	; point to next oscillator		CLC		;		ADC	#doc_control	;		TAX		;		LDA	#$08	; remove halt bit and enable irq		JSR	write_reg	;		LDA	#$FFFF	; mark oscillator busy		STA	osc_busy	;@5		EQU	*	;		REP	#$20	; 16 bit accumulator		DEC	fail_timer	;		SEP	#$20	; 8 bit accumulator		BNE	@6	; not exausted		LDX	#$05	; sound irq timeout		PLP		; set failed mark		SEC		; mark an error@2		PHP		; save status		LONGA	OFF		;		SEP	#$20	;		LDA	sgcontrol	; get control bits		AND	#$F0	; mask off sys vol bits		ORA	#$08	; sys. vol. mid. range		STA	sgcontrol	; write it back out		TXA		; restore possible error code		PLP		; restore m,x		RTS		; >>>--- exit doc.sound.tst --->>>		TITLE	'doc init routine';********************************************************** Doc.init: This routine will set all the oscillators to a*           known state, ie; oscillators halted, volume set*           to zero, frequency registers set to zero and*           buffer pointers reset to zero.**     Input: e=0, m=?, x=?**     Output: e=0, m,x same as entry*             A=$01, X=$C0, Y=$00*;********************************************************DOC_INIT		EQU	*	;		PHP		; save m, x		LONGA	OFF		LONGI	OFF		SEP	#$30	; m=1, x=1		LDA	#62	; enable all oscillators.		LDX	#$E1	; oscillator enable register		JSR	write_reg	;		LDA	#$00	; clear frequency registers		TAX		; frequency & volume registers		LDY	#$60	; 96 registers freq. & volume		JSR	reg_init	;		LDA	#$3F	; 32K buffers		LDX	#$C0	; reset size/resolution regs.		LDY	#$20	; 32 registers		JSR	reg_init	;		LDA	#$00	; osc 0-F buffer starts $0000		LDX	#$80	; address pointer registers		LDY	#$10	; 16 oscillators		JSR	reg_init	;		LDA	#$80	; osc 10-1F buffer starts $8000		LDX	#$90	; address pointer registers		LDY	#$10	; 16 oscillators		JSR	reg_init	;		LDA	#$01	; control reg: no irq, halted		LDX	#$A0	;		LDY	#$20	; 32 registers		JSR	reg_init	;;;              Note: The following code is required to flush;                    sound interrupts which are pending as;                    a result of enabling the oscillators.;		LDA	#doc_no_inc	; select doc no auto incr.		STA	|sgcontrol	;		LDA	#doc_irq_reg	; point to Doc irq register		STA	|sgaddrl	;		LDX	#$22	; read the register 34 times@10		EQU	*	;		LDA	|sgdata	; read for possible irq		DEX		;		BPL	@10	;		PLP		; restore m, x		INC	|clockctl	; change the border color		RTS		; >>>--- exit doc.init --->>>		TITLE	'Doc register init routine';********************************************************** Reg.init: This routine will write a value specified by reg A*           into the registers specified by the contents of*           register X for a count of registers specified by*           register Y.**     Input: e=0, m=?, x=?*            (A) = value to write to registers*            (X) = first register to write to*            (Y) = number of consecutive registers to write to.*;********************************************************REG_INIT		EQU	*	;		PHX		; save register number		PHP		; save m,x		LONGA	OFF		LONGI	OFF		SEP	#$30	; make all 8 bits		STX	|sgaddrl	; initialize the start reg.		LDX	#Doc_incr	; select Doc with auto incr.		STX	|sgcontrol	; sound Glu control register@1		EQU	*	;		STA	sgdata	; write to first register		DEY		; decrement register count		BNE	@1	; write until count = $00		PLP		; restore processor		PLX		; restore reg number		RTS		; >>>--- exit Reg.init --->>>		TITLE	'Read Doc register routine';********************************************************** Read.read: This routine will read any doc register specified*            by the accumulator register.**     Input: e=0, m=?, x=?*;********************************************************READ_REG		EQU	*	;		PHP		; save m, x		SEP	#$30	;		STX	|sgaddrl	; set up register to talk to		LDA	#doc_incr	; select the DOC		STA	sgcontrol	;		LDA	|sgdata	; read the register		LDA	|sgdata	;		PLP		; restore m, x		RTS		; >>>--- exit Read.reg --->>>		TITLE	'Write DOC register routine';********************************************************** Write.reg: This routine will write to one register in the DOC.**     Input: e=0, m=?, x=?*            A=data to write to register*            X=register to write to**     Output: e=0, m, x same as entry*             A, X same as entry*             Y = $00*;********************************************************WRITE_REG		EQU	*	;		LONGA	ON		;		LONGI	ON		;		PHP		; save m, x bits		REP	#$30	;		LDY	#$01	; one register		JSR	reg_init	; initialize one register		PLP		; restore m, x		RTS		; >>>--- exit write.reg --->>>		TITLE	'Sawtooth wave maker';********************************************************** Make.waves: This routine will create a sawtooth wave pattern*             throughout the DOC ram ($0000-$FFFF).*             The Data pattern for the ram is as follows:*             $01,$01,$02,$03......$FE,$FF.  The first $01 is*             a replacement for $00 which at this stage of the*             test is not allowed.**     Input: e=0, m=?, x=?*            A,X = don't care (preserved)*      ;********************************************************MAKE_WAVES:	PHA		; save registers		PHX		;		PHP		; save m,x		LONGA	OFF		LONGI	ON		REP	#$10	; x=0		SEP	#$20	; m=1		LDX	#$0000	; set counter/address pointer		STX	|sgaddrl	; write to sgaddrl,sgaddrh		LDA	#ram_incr	; DOC ram with auto incr		STA	sgcontrol	;		LDA	#$00	; setup data pattern@1		EQU	*	;		CMP	#$00	; check for zeroes		BNE	@2	; write it if not zero		INC	A	; make it a one		STA	sgdata	; write to the ram		DEX		; decrement the count@2		STA	sgdata	;		INC	A	; write to the ram		DEX		; decrement count		BNE	@1	; write 65536 patterns		PLP		; restore m,x		PLX		; restore registers		PLA		;		RTS		; >>>--- exit make.waves --->>>		TITLE	'Doc Diags. Sound IRQ vector';********************************************************** DOC.irq: This routine will handle interrupts coming from*          the DOC.  It expects to find 32 different interrupts*            from the chip.*;********************************************************	; SEG	RUNBANKDOC_IRQ		EQU	*	;	; SEG	$00		PHA		; save registers		PHX		;		PHP		; save m, x		LONGA	OFF		;		LONGI	OFF		;		SEP	#$30	;		LDX	#Doc_irq_reg	; read the Doc irq register		JSR	read_reg	; (A)=Doc irq reg		ASL	A	;		BCS	@8	; not sound irq		LSR	A	;		LSR	A	; throw away low bit		AND	#$1F	; keep oscillator number@4		EQU	*	;		STZ	fail_timer	; reset failsafe timer		STZ	fail_timer+1	;		CLC		;		ADC	#doc_control	; point to DOC control registers		TAX		; doc register number		LDA	#$01	; halt without irq.		JSR	write_reg	;		INC	irq_counter	; bump interrupt counter		STZ	osc_busy	; reset busy flag@8		EQU	*	;		PLP		; restore m, x		PLX		; restore register		PLA		;		CLC		; exit clean		RTI		; >>>--- exit Sound.irq --->>>;;