;	This EdAsm/Asm816 source code file was converted to AsmIIGS;	by EdAsmCvtIIGS version 1.2d7 on 5/14/91 at 7:6:34 PM		PRINT	NOGEN		MACHINE	M65816		INCLUDE	'::Firmware.Macros.aii'		PRINT	PUSH		PRINT	OFF		INCLUDE	'::Firmware.Equates.aii'		PRINT	POP		INCLUDE	'DIAG.MACROS.aii'		MSB	ON		TITLE	'Cortland Diagnostics'RUNBANK		EQU	$FF	;Bank code will run inPEA_BANK		EQU	RUNBANK*16*16+RUNBANK	; SEG	RUNBANK	;ROM Bank code resides inBAUD_SWITCH	EQU	0	;0 (No room in rom) See serial testVGC_SWITCH	EQU	0	;0 (No room in rom) See Custom.Irq fileSEQ_DEBUG		EQU	0	;Normally 0 ( Use DIAGTYPE and NOT SW2 )CHECKSUM		EQU	1	;Normally 1, 0 -> skip 128K checksum tstUSE_FDB_TOOL	EQU	0	;Normally 1 to use Bank $FF FDB tool codeBI_MASK		EQU	%1111111111111111	;Tests to run if in BI and BTN0 = 1SELF_MASK		EQU	%1111111111111111	;Tests to run in self testBI_SELF_MASK	EQU	%1111111100111111	;Tests to run in BI and BTN0 =0Bnk~Org		EQU	$6400DIAGNOSTICS	PROC	ORG $FF6400		WITH	DIAG_VARS		Rel~Org		BRA	ST_SEQ_B	;Skip over test pointer table****************************************************************** Test pointer table* Points to tests in Bank $FF* Tests must return with RTL instruction* (This allows disk s/w to look up the pointer table and*  call the tests from any bank).* kg****************************************************************TST_TAB		DC.B	TST_TAB_E-*-3	;Number of pointers times 2		DC.W	ROM_CHECKSUM	;Test 1  128K rom		DC.W	MOVIRAM	;Test 2  Ram: Moving Inversions		DC.W	SOFT_SW	;Test 3  Mega // & Statereg softswitch test		DC.W	RAM_ADDR	;TEST 4  Ram: Addressing		DC.W	FPI_SPEED	;Test 5  Fpi fast/slow mode check		DC.W	SER_TST	;Test 6  Serial Chip		DC.W	CLOCK	;Test 7  Real Time Clock		DC.W	BAT_RAM	;Test 8  Battery ram		DC.W	FDB	;Test 9 Front Desk Bus		DC.W	SHADOW_TST	;Test 0A Shadow	IF SEQ_DEBUG <> 0 THEN		;Do following 'test' for debug only		DC.W	TEST1	;Fails if a key is pressed	ENDIF		DC.W	CUSTOM_IRQ	;Test 0B Interrupts		DC.W	DOC_EXEC	; DOC, Doc ram, sound glu diagnosticsTST_TAB_E		EQU	*	;End of test pointer table		DC.W	EXT_SEQ	;Pointer for Disk s/w		INCLUDE	'DIAG.ROM.SEQ.aii'		INCLUDE	'DIAG.TESTS.aii'		TITLE	'Ensoniq DOC rom diags.'		EJECT***         DDDD   OOOOO  CCCCC   DDDD  IIIII  AAAAA GGGGG  SSSSS*         D   D  O   O  C       D   D  III   A   A G      S    *         D   D  O   O  C       D   D  III   AAAAA GGGGG  SSSSS*         D   D  O   O  C       D   D  III   A   A G   G      S*         DDDD   OOOOO  CCCCC   DDDD  IIIII  A   A GGGGG  SSSSS**                  Copyright Apple Computer, Inc.  1986*                         All Rights Reserved*******************************************************************                                                               ** Modification History:                                         **                                                               ** Rel  Date       Who  Action                                   ** ------------------------------------------------------------- ** 0.1 10-21-86    G.A  Initial release of Ensoniq rom base diag **                                                               ******************************************************************;;DOC_START		EQU	*	; START OF DOC diagnostics		INCLUDE	'DOC.TESTS.aii';		PRINT	ON	; DOC_END		EQU	*	;PROG_SIZE		EQU	DOC_END-DOC_START	;;		FillTo	$7C00-2	;Leave room for pointer		DC.W	TST_TAB	;Tell Singapore/Cork where table is		ENDP				END