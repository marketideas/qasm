#   File:       debug.rom.make#   Target:     debug.rom#   Sources:    debug.aii toolnames.aii dosnames.aii misc.aii history.aii#   Created:    Friday, March 8, 1989Objs =	debug.aii.obj ¶		toolnames.aii.obj ¶		dosnames.aii.obj ¶		history.aii.obj ¶		misc.aii.obj		debug.rom Ä {Objs}		LinkIIGS {Objs} -o debug.rom.temp		makebiniigs debug.rom.temp -o debug.rom -org $F80000		delete debug.rom.temp		.aii.obj Ä .aii		AsmIIGS -d ThisIsRam=0 -l {default}.aii