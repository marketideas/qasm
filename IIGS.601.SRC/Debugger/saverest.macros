;;     SaveReg -- save user registers into table;;      Saves:  e, P, B, D, S, A, X, Y, M and Q;     (uses three bytes of user's stack);	MACRO	SaveReg		phb	;save user data bank	php	;save P	phk	;set to debug bank	plb	;set it	stz InRT	; No longer in real-time.	sta AT	;save low A (and high if e,m=0)	sep #$20	;LONGA OFF (needed if e,m=0)	longa off	pla	;P in low A	sta PT	clc	xce	;native (user e into carry)	cld	cli	;enable interrupts	sep #$20	;LONGA OFF	longa off	xba	sta AT+1	pla	sta BT	rep #$30	;LONGA/I ON	longa on	longi on	stx XT	sty YT	tdc	sta DT	tsc	sta ST	lda xDEBUG_D	tcd	;set D and S	lda xDEBUG_S	; back to	tcs	;  Debug D and S	sep #$30	;LONGA/I OFF	longa off	longi off	lda #0	ror a	;e into MSB	sta eT	lda >ALTCHR	sta CT	sta >SETALTCHR	lda >MSTATE	sta MT	lda >CYA	asl a	;speed in c	php	lda >SHADOW	asl a	plp	ror a	and #$DE	;strip off text shadow bit	ora shadowT	;virtual text shadow	sta QT	;for display	and #$5F	;strip off speed	bit TEXTMODE	bpl *+4	;screen off	ora #1	;screen on -- disable	sta >SHADOW	; text shadowing	lda >CYA	ora #$80	sta >CYA	;go fast		MEND;;  RestoreReg -- restore user registers from table;;    Restored:  e, P, B, D, S, A, X, Y, M and Q;	MACRO	RestoreReg	lda #1	bit eT	bmi @emulation	;emulation	lda ST+1	;native@emulation	xba	lda ST	tcs	;use his stack	lda >P2STATE	;p2 clr/set by trace	bpl *+9	lda MT	;user MSTATE	ora #$40	;setp2	bra *+7	lda MT	and #$BF	sta >MSTATE	lda QT	asl a	;speed in c	php	lda >CYA	asl a	plp	ror a	and #$9F	sta >CYA	lda QT	and #1	sta shadowT	;virtual text shadow	lda QT	and #$5F	;strip off speed	bit TEXTMODE	bpl *+4	;debug screen off	ora #1	;disable text shadowing	sta >SHADOW	bit CT	bmi *+6	sta >CLRALTCHR	lda eT	asl a	;e into carry	lda PT	xba	lda BT	rep #$30	;LONGA/I ON	longa on	longi on	pha	;save PT and BT	lda DT	tcd	ldy YT	ldx XT	lda AT	sei	plb	bcc *+11	;e=0	plp	;restore P	bcc *+5	;c=0	sec	;c=1	bra *+9	sec	bra *+11	plp	bcc *+7	clc	xce	sec	bra *+5	clc	xce	clc		MEND