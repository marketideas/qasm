ter to CString** External Refs:*	none** Entry Points:*	longa on	; mode	longi on*****************************************************************	DefineStackOrigDirect	wordRTLAdr	block 3CallNumber	wordResultPtr	long	phd	; save d-reg	tsc	; stack becomes d-page	tcd	phb	; save dbr	phk	; dbr is code bank	plb	lda CallNumber+1	; look at tool number in call number	and #$00E0	lsr a	lsr a	lsr a	lsr a	lsr a	inc a	asl a	cmp NamePointerTable	bcs NoSuchTool	tax	; use 2 times call number to get pointer	lda NamePointerTable,x ; to table of names for this tool	sta ResultPtr	; put result in ResultPtr	lda CallNumber	; now look at func number in call number	and #$1FFF	beq NoSuchTool	asl a	; use 2 times call number to see if funct	cmp (ResultPtr)	; exists	bcs NoSuchFunction	tay	; use number to get pointer to name	lda (ResultPtr),y	sta ResultPtr	; store in result ptr	phk	; now put bank into result pointer	phk	pla	and #$00FF	sta ResultPtr+2	clc	; Indicate tool name found.AllDone	ldx RTLAdr+1	; move rtl adr up 2 bytes	stx RTLAdr+1+2	ldx RTLAdr	stx RTLAdr+2	plb	; restore dbr	pld	; restore d-reg	plx	; pull off word	rtl	; finiNoSuchTool	NoSuchFunction	lda #UnknownStr	sta ResultPtr;	lda #^UnknownStr	phk	;	phk	;	pla	;	and #$00ff	;made bank-independent 29-Aug-90 DAL	sta ResultPtr+2	sec	;Indicate that no tool name found.	bra AllDone********************************************************************************** GetDOSNumber** Usage:*   pha	;space for result*   pushlong #str	;input string*   jsl GetDOSNumber*   pla	;result (0 if not found)** New routine 11-Oct-90 DAL*********************************************************************************	export GetDOSNumber	import EqualStringGetDOSNumber	DefineStackOrigD	wordSectCounter	wordCallCounter	wordPtr	wordRTLAddress	block 3StringPtr	longResultCallNumber	word	pha	; three words of locals	pha	pha	phd	; save d-reg	tsc	; stack becomes d-page	tcd	phb	; save dbr	phk	; dbr is code bank	plb	stz ResultCallNumber ; assume not found	stz SectCounterSectLoop	inc SectCounter	lda SectCounter	asl a	cmp NamePointerTable	bcs NotFound@ok	tax	lda NamePointerTable,x	sta Ptr	stz CallCounterCallLoop	inc CallCounter		lda CallCounter	asl a	cmp (Ptr)	bcs SectLoop	tay	lda (Ptr),y	phk	phk	pha	lda 3,s	and #$00FF	sta 3,s	pei StringPtr+2	pei StringPtr	jsr EqualString	bcc CallLoop	lda CallCounter	ldx SectCounter	dex	beq @1	ora #$2000	;Class 1@1	sta ResultCallNumberNotFound	ldx RTLAddress+1	; move rtl adr up 4 bytes	stx RTLAddress+1+4	ldx RTLAddress	stx RTLAddress+4	plb	; restore dbr	pld	; restore d-reg	plx	; pull off 3 locals	plx	plx	plx	; pull off long	plx	rtl;-----------------------------------------------------------;; Name Pointer Table;; This table points to the table of pointers to names; of calls in each tool. ; NamePointerTable	dc.w EndNPT-NamePointerTable	dc.w Class0	dc.w Class1EndNPT	ToolCall CREATE,0001	ToolCall DESTROY,0002	ToolCall CHANGE_PATH,0004	ToolCall SET_FILE_INFO,0005	ToolCall GET_FILE_INFO,0006	ToolCall VOLUME,0008	ToolCall SET_PREFIX,0009	ToolCall GET_PREFIX,000A	ToolCall CLEAR_BACKUP_BIT,000B;	ToolCall EXPAND_PATH,000E	;removed 29-Aug-90 DAL (no class 0 version)	ToolCall OPEN,0010	ToolCall NEWLINE,0011	ToolCall READ,0012	ToolCall WRITE,0013	ToolCall CLOSE,0014	ToolCall FLUSH,0015	ToolCall SET_MARK,0016	ToolCall GET_MARK,0017	ToolCall SET_EOF,0018	ToolCall GET_EOF,0019	ToolCall SET_LEVEL,001A	ToolCall GET_LEVEL,001B	ToolCall GET_DIR_ENTRY,001C	ToolCall GET_DEV_NUM,0020	ToolCall GET_LAST_DEV,0021	ToolCall READ_BLOCK,0022	ToolCall WRITE_BLOCK,0023	ToolCall FORMAT,0024	ToolCall ERASE_DISK,0025	ToolCall GET_NAME,0027	ToolCall GET_BOOT_VOL,0028	ToolCall QUIT,0029	ToolCall GET_VERSION,002A	ToolCall D_INFO,002C	ToolCall ALLOC_INTERRUPT,0031	ToolCall DEALLOC_INTERUPT,0032	ToolCall CreateGS,2001	ToolCall DestroyGS,2002	ToolCall OSShutdownGS,2003	ToolCall ChangePathGS,2004	ToolCall SetFileInfoGS,2005	ToolCall GetFileInfoGS,2006	if SpongeBoy then	ToolCall JudgeNameGS,2007	;added 8-Feb-91 DAL	endif	ToolCall VolumeGS,2008	ToolCall SetPrefixGS,2009	ToolCall GetPrefixGS,200A	ToolCall ClearBackupGS,200B	ToolCall SetSysPrefsGS,200C	ToolCall NullGS,200D	ToolCall ExpandPathGS,200E	ToolCall GetSysPrefsGS,200F	ToolCall OpenGS,2010	ToolCall NewLineGS,2011	ToolCall ReadGS,2012	ToolCall WriteGS,2013	ToolCall CloseGS,2014	ToolCall FlushGS,2015	ToolCall SetMarkGS,2016	ToolCall GetMarkGS,2017	ToolCall SetEOFGS,2018	ToolCall GetEOFGS,2019	ToolCall SetLevelGS,201A	ToolCall GetLevelGS,201B	ToolCall GetDirEntryGS,201C	ToolCall BeginSessionGS,201D	ToolCall EndSessionGS,201E	ToolCall SessionStatusGS,201F	ToolCall GetDevNumberGS,2020	ToolCall FormatGS,2024	ToolCall EraseDiskGS,2025	ToolCall ResetCacheGS,2026	ToolCall GetNameGS,2027	ToolCall GetBootVolGS,2028	ToolCall QuitGS,2029	;added 29-Aug-90 DAL	ToolCall GetVersionGS,202A	ToolCall GetFSTInfoGS,202B	ToolCall DInfoGS,202C	ToolCall DStatusGS,202D	ToolCall DControlGS,202E	ToolCall DReadGS,202F	ToolCall DWriteGS,2030	ToolCall BindInitGS,2031	ToolCall UnbindIntGS,2032	ToolCall FSTSpecificGS,2033	;added 29-Aug-90 DAL	ToolCall AddNotifyProcGS,2034	;added 29-Aug-90 DAL	ToolCall DelNotifyProcGS,2035	;added 29-Aug-90 DAL	ToolCall DRenameGS,2036	;added 29-Aug-90 DAL	ToolCall GetStdRefNumGS,2037	;added 29-Aug-90 DAL	ToolCall GetRefNumGS,2038	;added 29-Aug-90 DAL	ToolCall GetRefInfoGS,2039	;added 29-Aug-90 DAL	ToolCall SetStdRefNumGS,203A	;added 3-Sep-91 DAL	if 0 then*** Added - 26-May-93 JCM - Let's be nice and show all of the APW/ORCA shell calls that I can find.	ToolCall Get_LInfo,0101	ToolCall Set_LInfo,0102	ToolCall Get_Lang,0103	ToolCall Set_Lang,0104	ToolCall Error,0105	ToolCall Set,0106	ToolCall Version,0107	ToolCall Read_Indexed,0108	ToolCall Init_Wildcard,0109	ToolCall Next_Wildcard,010A	ToolCall Read_Variable,010B	ToolCall ChangeVector,010C	ToolCall Execute,010D	ToolCall FastFile,010E	ToolCall Direction,010F	ToolCall Redirect,0110	ToolCall Stop,0113	ToolCall ExpandDevices,0114	ToolCall UnsetVariable,0115	ToolCall Export,0116	ToolCall PopVariables,0117	ToolCall PushVariables,0118	ToolCall SetStopFlag,0119	ToolCall ConsoleOut,011A	ToolCall SetIODevices,011B	ToolCall GetIODevices,011C	ToolCall GetCommand,011D		ToolCall GetLInfoGS,0141	ToolCall SetLInfoGS,0142	ToolCall GetLangGS,0143	ToolCall SetLangGS,0144	ToolCall ErrorGS,0145	ToolCall SetGS,0146	ToolCall VersionGS,0147	ToolCall ReadIndexedGS,0148	ToolCall InitWildcardGS,0149	ToolCall NextWildcardGS,014A	ToolCall ReadVariableGS,014B	ToolCall ChangeVectorGS,014C	ToolCall ExecuteGS,014D	ToolCall FastFileGS,014E	ToolCall DirectionGS,014F	ToolCall RedirectGS,0150	ToolCall StopGS,0153	ToolCall ExpandDevicesGS,0154	ToolCall UnsetVariableGS,0155	ToolCall ExportGS,0156	ToolCall PopVariablesGS,0157	ToolCall PushVariablesGS,0158	ToolCall SetStopFlagGS,0159	ToolCall ConsoleOutGS,015A	ToolCall SetIODevicesGS,015B	ToolCall GetIODevicesGS,015C	ToolCall GetCommandGS,015D	endif*** End - 26-May-93 JCMClass0	dc.w Class1-Class0	dc.w c0001	dc.w c0002	dc.w c0003	dc.w c0004	dc.w c0005	dc.w c0006	dc.w c0007	dc.w c0008	dc.w c0009	dc.w c000A	dc.w c000B	dc.w c000C	dc.w c000D	dc.w c000E	dc.w c000F	dc.w c0010	dc.w c0011	dc.w c0012	dc.w c0013	dc.w c0014	dc.w c0015	dc.w c0016	dc.w c0017	dc.w c0018	dc.w c0019	dc.w c001A	dc.w c001B	dc.w c001C	dc.w c001D	dc.w c001E	dc.w c001F	dc.w c0020	dc.w c0021	dc.w c0022	dc.w c0023	dc.w c0024	dc.w c0025	dc.w c0026	dc.w c0027	dc.w c0028	dc.w c0029	dc.w c002A	dc.w c002B	dc.w c002C	dc.w c002D	dc.w c002E	dc.w c002F	dc.w c0030	dc.w c0031		dc.w c0032Class1	dc.w Class2-Class1	dc.w c2001	dc.w c2002	dc.w c2003	dc.w c2004	dc.w c2005	dc.w c2006	dc.w c2007	dc.w c2008	dc.w c2009	dc.w c200A	dc.w c200B	dc.w c200C	dc.w c200D	dc.w c200E	dc.w c200F	dc.w c2010	dc.w c2011	dc.w c2012	dc.w c2013	dc.w c2014	dc.w c2015	dc.w c2016	dc.w c2017	dc.w c2018	dc.w c2019	dc.w c201A	dc.w c201B	dc.w c201C	dc.w c201D	dc.w c201E	dc.w c201F	dc.w c2020	dc.w c2021	dc.w c2022	dc.w c2023	dc.w c2024	dc.w c2025	dc.w c2026	dc.w c2027	dc.w c2028	dc.w c2029	dc.w c202A	dc.w c202B	dc.w c202C	dc.w c202D	dc.w c202E	dc.w c202F	dc.w c2030	dc.w c2031		dc.w c2032	dc.w c2033	;added 29-Aug-90 DAL	dc.w c2034	;added 29-Aug-90 DAL	dc.w c2035	;added 29-Aug-90 DAL	dc.w c2036	;added 29-Aug-90 DAL	dc.w c2037	;added 29-Aug-90 DAL	dc.w c2038	;added 29-Aug-90 DAL	dc.w c2039	;added 29-Aug-90 DAL	dc.w c203A	;added 3-Sep-91 DALClass2c0003c0007c000Cc000Dc000E	; added 29-Aug-90 DAL (no class-0 ExpandPath)c000Fc001Dc001Ec001Fc0026c002Bc002Dc002Ec002Fc0030	if SpongeBoy=0 then		;8-Feb-91 DALc2007	endifc2021c2022c2023UnknownStr	dc.b 'Unknown'	ENDP	END