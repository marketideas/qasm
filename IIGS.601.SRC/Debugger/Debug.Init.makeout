Set Echo 1	set System6Stuff 1	set System61Stuff 1	AsmIIGS -t -d ThisIsRam=1 -d SpongeBoy={System6Stuff} -d SpongeMan={System61Stuff} debug.aii	AsmIIGS -t -d ThisIsRam=1 -d SpongeBoy={System6Stuff} -d SpongeMan={System61Stuff} dosnames.aii	LinkIIGS debug.aii.obj toolnames.aii.obj dosnames.aii.obj requestnames.aii.obj history.aii.obj misc.aii.obj -t $B6 -o debug.init	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac Debug.Init :	End