n,7304   ToolCall XorRgn,7404   ToolCall PtInRgn,7504   ToolCall RectInRgn,7604   ToolCall EqualRgn,7704   ToolCall EmptyRgn,7804   ToolCall FrameRgn,7904   ToolCall PaintRgn,7A04   ToolCall EraseRgn,7B04   ToolCall InvertRgn,7C04   ToolCall FillRgn,7D04   ToolCall ScrollRect,7E04   ToolCall PaintPixels,7F04   ToolCall AddPt,8004   ToolCall SubPt,8104   ToolCall SetPt,8204   ToolCall EqualPt,8304   ToolCall LocalToGlobal,8404   ToolCall GlobalToLocal,8504   ToolCall Random,8604   ToolCall SetRandSeed,8704   ToolCall GetPixel,8804   ToolCall ScalePt,8904   ToolCall MapPt,8A04   ToolCall MapRect,8B04   ToolCall MapRgn,8C04   ToolCall SetStdProcs,8D04   ToolCall SetCursor,8E04   ToolCall GetCursorAdr,8F04   ToolCall HideCursor,9004   ToolCall ShowCursor,9104   ToolCall ObscureCursor,9204;   ToolCall Unknown,9304   ToolCall SetFont,9404   ToolCall GetFont,9504   ToolCall GetFontInfo,9604   ToolCall GetFontGlobals,9704   ToolCall SetFontFlags,9804   ToolCall GetFontFlags,9904   ToolCall SetTextFace,9A04   ToolCall GetTextFace,9B04   ToolCall SetTextMode,9C04   ToolCall GetTextMode,9D04   ToolCall SetSpaceExtra,9E04   ToolCall GetSpaceExtra,9F04   ToolCall SetForeColor,A004   ToolCall GetForeColor,A104   ToolCall SetBackColor,A204   ToolCall GetBackColor,A304   ToolCall DrawChar,A404   ToolCall DrawString,A504   ToolCall DrawCString,A604   ToolCall DrawText,A704   ToolCall CharWidth,A804   ToolCall StringWidth,A904   ToolCall CStringWidth,AA04   ToolCall TextWidth,AB04   ToolCall CharBounds,AC04   ToolCall StringBounds,AD04   ToolCall CStringBounds,AE04   ToolCall TextBounds,AF04   ToolCall SetArcRot,B004   ToolCall GetArcRot,B104   ToolCall SetSysFont,B204   ToolCall GetSysFont,B304   ToolCall SetVisRgn,B404   ToolCall GetVisRgn,B504   ToolCall SetIntUse,B604   ToolCall OpenPicture,B704   ToolCall PicComment,B804   ToolCall ClosePicture,B904   ToolCall DrawPicture,BA04   ToolCall KillPicture,BB04   