********************************************************************************* Copyright Apple Computer, Inc 1990-1993* All Rights Reserved******************************************************************************************************************************************************** ToolNames** This file contains the procedure and data to convert a call number* into a name** There are two procedures that are entry points in this file:**     GetToolName	returns a pointer to a CString that is the *	name of the call specified.**     GetToolNumber returns a word that is the tool number from*   	the name of the tool************************************************************************* REVISION HISTORY** 29-Aug-90 (am) David A. Lyons*   Updating for 5.0.3.  Search for "DAL" comments for changes.*   Commented out all the "unknown" entries & changed their*   pointers to point to a *single* "Unknown" string, instead*   of having a gazillion copies of it (saved 114x8 = 912 bytes).** 29-Aug-90 (pm) David A. Lyons*   Added MidiSynth names and Debugger names.*   Added functions number 0 = names of the tool sets*     (for example, 0002=Memory Manager).*   Added SANE calls (there weren't any here).** 2-Nov-90 Dave Lyons*   Added $0BFF _DebugSetHook and $0CFF DebugGetInfo.** 8-Feb-91 Dave Lyons*   Added SpongeBoy call names, conditional on SpongeBoy variable.** 15-Feb-91 DAL*   Added WhooshRect; removed GetScanlineAddr.** 19-Feb-91 DAL*   Added GetDeskGlobal.** 3-Mar-91 DAL*   Remove NewPort, KillPort from QDAux.*   Add CompareStrings to List Manager.*   Add StringToText to MiscTools.** 12-Apr-91 DAL*   Add ResizeInfoBar and HandleDiskInsert to Window Manager.** 3-Jul-91 DAL*   Add "RM" to resource-name calls.** 1-Dec-91 DAL*   Fixed MIDISynth call names.** 2-Dec-91 DAL*   Fixed name of GetDeskAccInfo.************************************************************************* For GSBug 1.7dx (System 6.0.1)** 9-Mar-92 DAL*   Added DrawStringWidth and UpdateWindow calls.** 20-Mar-92 DAL*   Added IsSpecialLEKey.** 30-Mar-92 DAL*   Change IsSpecialLEKey to LEClassifyKey.** 15-Jul-92 DAL*   Add OpenResFileByID, GetCtlValueByID, SetCtlValueByID,*   InvalOneCtlByID, HiliteCtlByID.** 20-Aug-92 DAL*   Add ShowClipboard, AlertMessage, DoSysPrefs.** 12-Feb-93 DAL*   Add CompactResourceFile.** 28-Mar-93 JCM*   Add UseColorTable, RestoreColorTable** 17-May-93 JCM*   Add DebugControl ($0DFF) and DebugQuery($0EFF).***********************************************************************	include 'dsect.macros'	string C	MACRO	ToolCall &NameStr,&CallNumberc&CallNumber	dc.b '&NameStr'	MEND*****************************************************************GetToolName	PROC EXPORT** Returns a pointer to the specified call name.** The call is made as follows:**	pha*	pha*	PushWord #CallNumber*	jsl GetName*	PullLong ThePointer** Inputs:*	space for long*	CallNumber : word** Outputs:*	carry = 1 iff tool name is unknown*	Pointer to CString** External Refs:*	none** Entry Points:	EXPORT GetToolNumber	export EqualString	;11-Oct-90 DAL*	longa on	; mode	longi on*****************************************************************	DefineStackOrigDirect	wordRTLAdr	block 3CallNumber	wordResultPtr	long	phd	; save d-reg	tsc	; stack becomes d-page	tcd	phb	; save dbr	phk	; dbr is code bank	plb	lda CallNumber	; look at tool number in call number	and #$00FF	beq NoSuchTool	cmp #$00FF	; DAL  Is it the Debugger toolset?	bne @notDebugger	; DAL	lda #EndNPT-NamePointerTable	;DAL use entry past end of table	bra @gotOffset		;DAL@notDebugger	asl a	cmp NamePointerTable	bcs NoSuchTool@gotOffset	tax	; use 2 times call number to get pointer	lda NamePointerTable,x ; to table of names for this tool	sta ResultPtr	; put result in ResultPtr	lda CallNumber+1	; now look at func number in call number	and #$00FF;	beq NoSuchTool	; 29-Aug-90 DAL func 0 now = tool set name	inc a	; 29-Aug-90 DAL	asl a	; use 2 times call number to see if funct	cmp (ResultPtr)	; exists	bcs NoSuchFunction	tay	; use number to get pointer to name	lda (ResultPtr),y	sta ResultPtr	; store in result ptr	phk	; now put bank into result pointer	phk	pla	and #$00FF	sta ResultPtr+2	clc	; Indicate tool name found.AllDone	ldx RTLAdr+1	; move rtl adr up 2 bytes	stx RTLAdr+1+2	ldx RTLAdr	stx RTLAdr+2	plb	; restore dbr	pld	; restore d-reg	plx	; pull off word	rtl	; finiNoSuchTool	NoSuchFunction	lda #UnknownStr	sta ResultPtr;	lda #^UnknownStr	phk	;replaced lda with these 4	phk	;lines to make bank-independent	pla	;DAL 29-Aug-90	and #$00ff	;	sta ResultPtr+2	sec	;Indicate that no tool name found.	bra AllDoneGetToolNumber	DefineStackOrigD	wordToolCounter	wordFuncCounter	wordPtr	wordRTLAddress	block 3StringPtr	longResultCallNumber	word	pha	; three words of locals	pha	pha	phd	; save d-reg	tsc	; stack becomes d-page	tcd	phb	; save dbr	phk	; dbr is code bank	plb	stz ResultCallNumber ; assume not found	stz ToolCounterToolLoop	inc ToolCounter	lda toolCounter	asl a	cmp NamePointerTable	beq @ok		;DAL 29-Aug-90 (for Debugger toolset)	bcs NotFound@ok	tax	lda NamePointerTable,x	sta Ptr	stz FuncCounterFuncLoop	inc FuncCounter		lda FuncCounter	asl a	cmp (Ptr)	bcs ToolLoop	tay	lda (Ptr),y	phk	phk	pha	lda 3,s	and #$00FF	sta 3,s	pei StringPtr+2	pei StringPtr	jsr EqualString	bcc FuncLoop; if the ToolCounter is past the end of the table, make it be $FF (the Debugger tool set)	lda ToolCounter		;DAL 29-Aug-90	cmp #(EndNPT-NamePointerTable)/2	;DAL	bne @noFF		;DAL	lda #$00FF		;DAL	sta ToolCounter		;DAL@noFF			;DAL	lda FuncCounter	dec a		;DAL 29-Aug-90 (zero = tool set name)	xba	ora ToolCounter	sta ResultCallNumberNotFound	ldx RTLAddress+1	; move rtl adr up 4 bytes	stx RTLAddress+1+4	ldx RTLAddress	stx RTLAddress+4	plb	; restore dbr	pld	; restore d-reg	plx	; pull off 3 locals	plx	plx	plx	; pull off long	plx	rtl	; fini;-----------------------------------------------------------;; EqualString;; Inputs ;     PtrStr1;     PtrStr2; Output;     Carry  clear if not equal;     Set if equal.;EqualString	DefineStacktemp	wordTheDReg	wordRTSAdr	wordInputString	longTableString	long	phd	phd	tsc	tcd	sep #$30	longa off	longi off	ldy #0@Loop	lda [TableString],y	cmp #'a'	bcc @NotLower	cmp #'z'+1	bcs @NotLower	and #$df	;DAL 29-Aug-90 (was sec, sbc #$20)@NotLower	sta temp	lda [InputString],y	and #$7F	cmp #'a'	bcc @NotLower2	cmp #'z'+1	bcs @NotLower2	and #$df	;DAL 29-Aug-90 (was sec, sbc #$20)@NotLower2	cmp temp	bne @NotEqual	tax	;DAL 29-Aug-90 (was cmp #0)	beq @Equal	iny	bra @Loop@NotEqual	clc	bra @Done@Equal	sec@Done	rep #$30	longa on	longi on	pld	pld	ply	plx	plx	plx	plx	phy	rts;-----------------------------------------------------------;; Name Pointer Table;; This table points to the table of pointers to names; of calls in each tool. ; NamePointerTable    dc.w EndNPT-NamePointerTable    dc.w Tool01	;Tool Locator    dc.w Tool02	;Memory Manager    dc.w Tool03	;Misc Tools    dc.w Tool04	;QuickDraw II    dc.w Tool05	;Desk Manager    dc.w Tool06	;Event Manager    dc.w Tool07	;Scheduler    dc.w Tool08	;Sound Tools    dc.w Tool09	;ADB    dc.w Tool0A	;SANE    dc.w Tool0B	;Integer Math    dc.w Tool0C	;Text Tools    dc.w Tool0D	;RAMDisk tool    dc.w Tool0E	;Window Mgr    dc.w Tool0F	;Menu Mgr    dc.w Tool10	;Control Mgr    dc.w Tool11	;Loader    dc.w Tool12	;QuickDraw Aux    dc.w Tool13	;Print Manager    dc.w Tool14	;Line Edit    dc.w Tool15	;Dialog Manager    dc.w Tool16	;Scrap Manager    dc.w Tool17	;Standard File    dc.w Tool18	;unused    dc.w Tool19	;Note Synth    dc.w Tool1A	;Note Seq    dc.w Tool1B	;Font Mgr    dc.w Tool1C	;List Mgr    dc.w Tool1D	;ACE    dc.w Tool1E	;Resource Mgr    dc.w Tool1F	;unused    dc.w Tool20	;MIDI    dc.w Tool21	;Video Overlay    dc.w Tool22	;Text Edit    dc.w Tool23	;MIDI Synth    if SpongeBoy then	;added 8-Feb-91 DAL    dc.w Tool24	;unused    dc.w Tool25	;Animation    dc.w Tool26	;Media Control    endifEndNPT	;the pointer to the Debugger tools must come next    dc.w ToolFF	;DAL Special case--tool FF is the debugger   ToolCall Tool Locator,0001	;added DAL 29-Aug-90   ToolCall TLBootInit,0101   ToolCall TLStartUp,0201   ToolCall TLShutDown,0301   ToolCall TLVersion,0401   ToolCall TLReset,0501   ToolCall TLStatus,0601;   ToolCall Unknown,0701;   ToolCall Unknown,0801   ToolCall GetTSPtr,0901   ToolCall SetTSPtr,0A01   ToolCall GetFuncPtr,0B01   ToolCall GetWAP,0C01   ToolCall SetWAP,0D01   ToolCall LoadTools,0E01   ToolCall LoadOneTool,0F01   ToolCall UnloadOneTool,1001   ToolCall TLMountVolume,1101   ToolCall TLTextMountVolume,1201   ToolCall SaveTextState,1301   ToolCall RestoreTextState,1401   ToolCall MessageCenter,1501   ToolCall SetDefaultTPT,1601   ToolCall MessageByName,1701   ToolCall StartUpTools,1801   ToolCall ShutDownTools,1901   if SpongeBoy then	;added 8-Feb-91 DAL   ToolCall GetMsgHandle,1A01   ToolCall AcceptRequests,1B01   ToolCall SendRequest,1C01      endif      ToolCall Memory Manager,0002	;added DAL 29-Aug-90   ToolCall MMBootInit,0102   ToolCall MMStartUp,0202   ToolCall MMShutDown,0302   ToolCall MMVersion,0402   ToolCall MMReset,0502   ToolCall MMStatus,0602;   ToolCall Unknown,0702;   ToolCall Unknown,0802   ToolCall NewHandle,0902   ToolCall ReallocHandle,0A02   ToolCall RestoreHandle,0B02   ToolCall AddToOOMQueue,0C02   ToolCall RemoveFromOOMQueue,0D02	;was "DeleteFromOOMQueue" 29-Aug-90 DAL;   ToolCall Unknown,0E02;   ToolCall Unknown,0F02   ToolCall DisposeHandle,1002   ToolCall DisposeAll,1102   ToolCall PurgeHandle,1202   ToolCall PurgeAll,1302;   ToolCall Unknown,1402;   ToolCall Unknown,1502;   ToolCall Unknown,1602;   ToolCall Unknown,1702   ToolCall GetHandleSize,1802   ToolCall SetHandleSize,1902   ToolCall FindHandle,1A02   ToolCall FreeMem,1B02   ToolCall MaxBlock,1C02   ToolCall TotalMem,1D02   ToolCall CheckHandle,1E02   ToolCall CompactMem,1F02   ToolCall HLock,2002   ToolCall HLockAll,2102   ToolCall HUnlock,2202   ToolCall HUnlockAll,2302   ToolCall SetPurge,2402   ToolCall SetPurgeAll,2502;   ToolCall Unknown,2602;   ToolCall Unknown,2702   ToolCall PtrToHand,2802   ToolCall HandToPtr,2902   ToolCall HandToHand,2A02   ToolCall BlockMove,2B02;   ToolCall Unknown,2C02;   ToolCall Unknown,2D02;   ToolCall Unknown,2E02   ToolCall RealFreeMem,2F02   if SpongeBoy then	;added 8-Feb-91 DAL   ToolCall SetHandleID,3002   endif   ToolCall Misc Tools,0003	;added DAL 29-Aug-90   ToolCall MTBootInit,0103   ToolCall MTStartUp,0203   ToolCall MTShutDown,0303   ToolCall MTVersion,0403   ToolCall MTReset,0503   ToolCall MTStatus,0603;   ToolCall Unknown,0703;   ToolCall Unknown,0803   ToolCall WriteBRam,0903   ToolCall ReadBRam,0A03   ToolCall WriteBParam,0B03   ToolCall ReadBParam,0C03   ToolCall ReadTimeHex,0D03   ToolCall WriteTimeHex,0E03   ToolCall ReadAsciiTime,0F03   ToolCall SetVector,1003   ToolCall GetVector,1103   ToolCall SetHeartBeat,1203   ToolCall DelHeartBeat,1303   ToolCall ClrHeartBeat,1403   ToolCall SysFailMgr,1503   ToolCall GetAddr,1603   ToolCall ReadMouse,1703   ToolCall InitMouse,1803   ToolCall SetMouse,1903   ToolCall HomeMouse,1A03   ToolCall ClearMouse,1B03   ToolCall ClampMouse,1C03   ToolCall GetMouseClamp,1D03   ToolCall PosMouse,1E03   ToolCall ServeMouse,1F03   ToolCall GetNewID,2003   ToolCall DeleteID,2103   ToolCall StatusID,2203   ToolCall IntSource,2303   ToolCall FWEntry,2403   ToolCall GetTick,2503   ToolCall PackBytes,2603   ToolCall UnPackBytes,2703   ToolCall Munger,2803   ToolCall GetIRQEnable,2903   ToolCall SetAbsClamp,2A03   ToolCall GetAbsClamp,2B03   ToolCall SysBeep,2C03;   ToolCall Unknown,2D03   ToolCall AddToQueue,2E03   ToolCall DeleteFromQueue,2F03   ToolCall SetInterruptState,3003   ToolCall GetInterruptState,3103   ToolCall GetIntStateRecSize,3203   ToolCall ReadMouse2,3303   ToolCall GetCodeResConverter,3403   ToolCall GetRomResource,3503   ToolCall ReleaseRomResource,3603	;added 29-Aug-90 DAL   ToolCall ConvSeconds,3703	;added 29-Aug-90 DAL (for 5.0.3)   if SpongeBoy then	;added 8-Feb-91 DAL   ToolCall SysBeep2,3803   ToolCall VersionString,3903   ToolCall WaitUntil,3A03   ToolCall StringToText,3B03	;added 3-Mar-91 DAL   ToolCall ShowBootInfo,3C03	;added 30-Mar-91 DAL   ToolCall ScanDevices,3D03	;added 30-Mar-91 DAL   endif   if SpongeMan then   ToolCall AlertMessage,3E03	;added 20-Aug-92 DAL   ToolCall DoSysPrefs,3F03	;added 20-Aug-92 DAL   endif   ToolCall QuickDraw,0004	;added DAL 29-Aug-90   ToolCall QDBootInit,0104   ToolCall QDStartUp,0204   ToolCall QDShutDown,0304   ToolCall QDVersion,0404   ToolCall QDReset,0504   ToolCall QDStatus,0604;   ToolCall Unknown,0704;   ToolCall Unknown,0804   ToolCall GetAddress,0904   ToolCall GrafOn,0A04   ToolCall GrafOff,0B04   ToolCall GetStandardSCB,0C04   ToolCall InitColorTable,0D04   ToolCall SetColorTable,0E04   ToolCall GetColorTable,0F04   ToolCall SetColorEntry,1004   ToolCall GetColorEntry,1104   ToolCall SetSCB,1204   ToolCall GetSCB,1304   ToolCall SetAllSCBs,1404   ToolCall ClearScreen,1504   ToolCall SetMasterSCB,1604   ToolCall GetMasterSCB,1704   ToolCall OpenPort,1804   ToolCall InitPort,1904   ToolCall ClosePort,1A04   ToolCall SetPort,1B04   ToolCall GetPort,1C04   ToolCall SetPortLoc,1D04   ToolCall GetPortLoc,1E04   ToolCall SetPortRect,1F04   ToolCall GetPortRect,2004   ToolCall SetPortSize,2104   ToolCall MovePortTo,2204   ToolCall SetOrigin,2304   ToolCall SetClip,2404   ToolCall GetClip,2504   ToolCall ClipRect,2604   ToolCall HidePen,2704   ToolCall ShowPen,2804   ToolCall GetPen,2904   ToolCall