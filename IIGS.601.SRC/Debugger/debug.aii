********************************************;                                          ;;             GSBug Debugger               ;;                                          ;;  Copyright 1986-93 Apple Computer, Inc.  ;;          All Rights Reserved             ;;                                          ;;******************************************;;                                          ;;  REVISION HISTORY                        ;;                                          ;;  Pete Rowe             Jan-Dec 1986      ;;    Modified for ROM-Based Debugger v1.1  ;;                                          ;;  Joe Bo                Jan-Feb 1988      ;;                                          ;;  Mensch                1989-1990         ;;                                          ;;  David A. Lyons        August 1990+      ;;                                          ;;  Jim Murphy            Mar-Oct 1993      ;;                                          ;****************************************************************************************************************************************************************************************************;	Rev History;; March 29, 1989	1)  Real time trace windows now work on jsr's as well as;	jsl's.;; March 30, 1989	1)  Presing Ctrl-OA-Esc is now efective in the application;	version of the debugger.  It will interupt real time;	execution of code as well as return the user from the;	monitor.;;	2)  Fixed bug in the real time tool breaks.;; March 31, 1989	1)  Pressing X while tracing when not on a jsr or jsl is now;	the same as pressing space.;;; 9/13/89	Mensch;	Fixed real time tool breaks so that they work properly;	they were not entering the debugger from an interupt, so;	when the debugger exited, it got screwed up.;;	Added GLUE SnYpHer so that Pascal/C glue toolcalls can be;	detected.;; 1/2/90	Mensch;	Fixed glue display so it showed the asterisk properly.;; 2/21/90	Mensch; 	Added Support for toolbreaks in the glue entry.;	Added Support for debug with DAs that accept keystrokes.;	Added annoying keyclick.;; 2/22/90	Mensch;	Added fake tool call $FF09 so that the debugger can better; 	communicate with programmers.;; 3/16/90	Mensch;	Added real time conditional break support. See ERS for details.;	SetIf W A>X.;; 3/26/90	Mensch; 	tried to shrink code a little to fit more in here;; ---------------------------------------------------------------------------------------;; 31-Aug-90         David A. Lyons;                   Resurrecting the following changes from an accidental project fork.;;      29-Aug-90	David A. Lyons;                   Updated toonames and dosnames for 5.0.3.  Bumped version;                   to 1.5b10.  It *said* 1.5b8, which makes me wonder if;                   b9 was really checked in, or what.;;      29-Aug-90	David A. Lyons;                   Changed ShowBrks to go ahead and call GetToolName even if;                   the function number is wild (for ex, $0002 = "Memory Manager");	For ProDOS 8, now tries using 1K at $6000 instead of $0000 for work space.;;      30-Aug-90	Mensch, with Lyons watching;                   Now we store a $80 into $01/0100 so that interrupt routines don't trash;                   your favorite part of the stack while you're stepping 8-bit stuff.;                   Changed CSAVE to create config file with file type $5A, auxtype $0005;                   (DTS-assigned file type, "GSBug configuration").;; 31-Aug-90	David A. Lyons;	Took out code that was checking $C020 (not $C02d!) to see if the;	printer slot was switched in.  Makes no sense anyway, because a;	printer can legitimately be either an internal or external slot.;;	Changed toolbox calls into Macros.;;	Need to fix emulation-stepping problem (interrupts enables outside b0!);	Need to make sure SWAP is always called with B = debugger's bank.;	Need to fix long addressing so the ROM version will work!;; 7-Sep-90 (am)	Dave Lyons;	Added a CR in the main help screen (first line was running off the edge).;	Commented out some dead code, and removed some long-dead code that was;	already commented out.;	Cleaned up some comments.;; 7-Sep-90 (pm)     Dave Lyons;	Experimental fix for 8-bit stepping.  We now simulate SEI and CLI, and;                   instructions are always executed with interrupts disabled.  PLP was;                   already being simulated, as was XCE.;                   Xing a JSR when the user program is in emulation mode is still not;                   reliable (no change there).;                   Forcing $01/0100 to $80 after every instruction execution.  This will;                   help some, but it is not sufficient for code that actually loads from;                   $01/0100 and sets the stack pointer from that!;; 10-Oct-90	Dave Lyons;	Version 1.5b11.  Change 'D' command to 'I' so it doesn't interfere with;	typing a hex number that starts with a D.;	Put MP help back in.;	Changed CURSE to make an inverse character instead of a flashing one,;	so we don't have to turn off ALTCHR.;	Experimentally put e=, m=, and x= commands back in.;	x and X are now different commands.;; 11-Oct-90	Dave Lyons;	Adding experimental "stick" command to make the debugger hang around;	   after a reboot.;	Added pseudo tool call $0BFF=DebugSetHook.  The N ("neat-o") command;	   calls this hook.;	Removed a conditional hard-coded increment of $004002 when X-ing a JSR.;	Changed remaining "EBrk"s into "OSBrk"s to make code readable.;	Removed dead use of "TErrFlag".;	Fixing SetOSBrk so you can set them by name.;	Consolidated number/name parsing code into one routine for SetTBrk,;	   ClrTBrk, SetOSBrk, ClrOSBrk, and Tool.;	Added "GS" to end of class-1 OS names.;; 12-Oct-90	Dave Lyons;	Added REP #$30 on the two tool-dispatcher-intercept routines.  Making;	tool calls in other than full native mode is still not a good idea.;	Changed to use all.macros (saved 7 seconds out of 36 on my system).;	Took e=, m=, and x= back out.  They're kind of annoying (X= vs. x=).;	Fixed real-time breakpoints for 1-byte instructions with count>1;	  (was storing a word-long zero instead of a byte-long zero to restore break).;; 15-Oct-90	Dave Lyons;	Adding code to change the debugger handle's memory ID during a real-time JSL;	to match the code being stepped.  For ex, now you can step over an MMStartUp;	and get the expected ID returned (the application's instead of the debugger's).;; 16-Oct-90	Dave Lyons;	Fixed real-time counted breakpoints.  Everything seems to work now.;	Added "jsr AltLoadTemp" to load */System/System.Setup/GSBug.TMPL;	automatically.;; 17-Oct-90	Dave Lyons;	Removed "jsr AltLoadTemp"--makes it hang.  Investigate later, release 1.5b11 now.;; === 1.5b12 ===;; 23-Oct-90	Dave Lyons;	DebugSetHook(nil) now removes the hook.;	1K bank 0 segment now has our real ID (was always $80xx).;	Fixed OS breaks to work after return from ProDOS 8 (adding Notify Proc).;	N command enables text-page shadowing (during call to hook).;	Separated LoadTempSubr so we can load templates automatically.;	If you don't type a number after a _xxx, it's like _xxx 0.;	DP:xxx command dumps 16 bytes from DP to the command line.;	Tool call $0CFF DebugGetInfo(word):long.  Word=0 returns a default address;	  (useful with N command).;	Real-time counted breakpoints don't work for JMP() ($6C), JMP(,X) ($7C),;	  JML() ($DC), and JSR(,X) ($FC).;; 31-Oct-90	Dave Lyons;	Finished fixing LoadTemp--now it's a subroutine we can call to automatically;	  load a template file.;; 10-Dec-90	Dave Lyons;	The notify proc that re-patches the OS vectors now saves and sets the Bank;	register.  It was trashing memory before.;; 18-Jan-91	Dave Lyons;	With Monte's help, located the misplaced CLI that was causing the X command;	used on a JSR to accidentally return with the Bank register set to the;	debugger's bank, and the Stack set to the Interrupt-time stack.;; 8-Feb-91	Dave Lyons;	Adding SpongeBoy tool/OS calls, bumping version to 1.5b13.;	Need to fix Templates still.;; === 1.5b14 ===;; 30-Mar-91	Dave Lyons;	Added call to ShowBootInfo when we load (need to add an icon).;; === 1.5b15 ===;; 10-Apr-91	Dave Lyons;	¥Tracked down annoying option-space crasher thing.  It was keyboard;	translation, turning option-space into a "J" with the high bit;	turned on!  Added routine UntranslateEventKey to turn it back into;	a blank.;	¥From trace mode, Space and ESC now kill "awaiting RTx" mode.  Label;	"Function" is the command interpreter for trace mode.;	¥Fixed 'n' command so it won't crash if nobody has called DebugSetHook.;	¥Added routines BeforeDebuggerToolCall and AfterDebuggerToolCall to;	let tool breaks avoid triggering on calls made indirectly by tool calls;	the debugger makes.  You can tool-break on NewHandle and GetNextEvent!;	¥In breakpoint screen, Space maps count 0 to 1, nonzero to zero.  Tab;	moves between the address and count fields (easier than hitting arrows).;	¥In memory-protect screen, added Tab to move between columns.;	¥Added $01/FC00.FFFF to the default memory protect list.;	¥Changed default trace-window setting to center-screen (moved up 7 lines).;; 24-Apr-91	Dave Lyons;	¥Changed EmulStackValue to $C0 to avoid spontaneous crashing on AppleShare.;; 13-May-91	Dave Lyons;	¥Now we pad to the end of the bank!  Need to adjust offset at end of file;	all the time, since the assembler doesn't want to do this for me.;; === handed out to a few folks at WWDC, minus the 6.0 calls ===;; === 1.5b16 ===;; 23-May-91	Dave Lyons;	¥Now does a TLTextMountVol call when a toolbox call is made other than in;	full 16-bit mode.  Hitting ESC at that dialog cancels future messages until;	you reboot.;; 30-May-91	Dave Lyons;	¥Changed "A=" to "Addr=" in the 8-bit-registers dialog.;	¥Tool call in Decimal mode now stops cold at a BRK $F8, instead of;	eventually causing a confusing crash.;; 31-May-91	Dave Lyons;	¥Fixed one old reference to $010100 to store EmulStackValue instead;	of hard-coded $80.;; 6-Jun-91	Dave Lyons;	¥Added 5 blanks to end of 'TRACE ' message so it will completely replace;	the 'SINGLE STEP' message.;; === 1.5b17 ===;; 12-Jun-91	Dave Lyons;	¥OSBreaks trigger regardless of call class now.;	¥Added an SEI in CkToolBrk to prevent false triggers if interrupt;	routines are making tool calls.;; 3-Jul-91	Dave Lyons;	¥Changed named-resource call names to begin with RM (RMLoadNamedResource, etc).;; 7-Jul-91	Dave Lyons;	¥Procnames show up inline and as operands of JSR/JSL.;; === 1.5b18 ===;; 1-Aug-91	Dave Lyons;	¥Versions with 6.0 stuff included are now 1.6; without 6.0 stuff is still 1.5.;	¥Fixed Loadtemp to not return a bogus error.;	¥LoadTemp supplies default pathname of */System/System.Setup/GSBug.Templates.;	¥Templates file auto loads when the debugger is installed.;	¥Turned off high bits on the GSBug.Setup file pathname.;; === 1.5b19 / 1.6b19 ===;; 26-Aug-91	Dave Lyons;	¥The auto-load template file is now GSBug.AutoTemp.  The default for LoadTemp;	is still GSBug.Templates.;; === 1.6b20 ===;; 5-Sep-91	Dave Lyons;	¥Added OS call name SetStdRefNum, $203A.;	¥Fixed version string not to say "Apple Confidential".;	¥Fixed up ShowBootInfo version string.;; === 1.6b21 ===;; 24-Sep-91	Dave Lyons;	¥Fixed OSBreaks to work correctly when you set more than one break.;; === 1.6b22 ===;; 21-Nov-91	Dave Lyons;	¥X out the Bug icon if we don't load, either because of Option or;	because we see that we're already installed.;; === 1.6b23 ===;; 11..12-Feb-92	Dave Lyons;	¥Copyright includes 1992.;	¥Down-arrow while stepping correctly skips inline GS/OS calls (JSL $E100A8).;	¥If Quiet mode is on, CapsLock no longer clicks when GSBug intercepts a call;	 to SystemEvent (preventing any DA from getting the keystroke).;	¥OSBrk handling preserves the A register (for shells, where the exit status;	 is in A on a Quit call).;	¥Stack dump displays "??" for bytes in the $C0xx range, to avoid accidentally;	 messing with softswitches.;	¥Added a bunch of shortcut command names:;	sb/sh/show = showbrks, t-/t+ = tbrkout/tbrkin, o-/o+ = osbrkout/osbrkin,;	b-/b+ = out/in, stb = settbrk, ctb = clrtbrk, sob = setosbrk, cob = clrosbrk,;	pfx = prefix.;	¥ClrTBrk and ClrOSBrk (CTB and COB) clear all breaks if no parameter present.;	¥Changed breakpoint display to show tool-breaks, os-breaks, regular breaks.;	¥IN and OUT (and B+ and B-) no longer beep if BPs are already in/out.;	¥CSAVE defaults to *:System:System.Setup:GSBug.Setup if no path is given.;	¥SetOSBrk #0 breaks on all OS calls.;	¥Setting a tool break does a TBrkIn automatically; clearing all TBrks takes;	 does an automatic TBrkOut.;	¥Setting an OS break does an OSBrkIn automatically; clearing all OSBrks does;	 an automatic OSBrkOut.;; 17-Feb-92	Dave Lyons;	¥Changed version to 1.6 release.;	¥DebugVersion returns $16FF to make version comparisons nice.;; 27-Feb-92	Dave Lyons;	¥Clip TLEN to 2 at Branch, so tracing a symbolic name works even if the;	screen is off (if it's on, TLEN is getting updated from XLEN??).;; === Released as 1.6 for 6.0 ===;; 9-Mar-92	Dave Lyons;	¥Version 1.7d1.  Added tool calls for 6.0.1d2.;	¥Added E1/200..240 to the default MP list.;; 30-Mar-92	Dave Lyons;	¥Use GetOSEvent instead of GetNextEvent, OSEventAvail instead of EventAvail.;	Eventually we can kill the CapsLock hack for killing SystemEvent.;; 11-Aug-92	Dave Lyons;	¥Version 1.7d2.;	¥Fixed long mem display page-crossing bug (was wrapping back to same page).;; 20-Aug-92	Dave Lyons;	¥Version 1.7d3.;	¥Added some new tool calls to toolnames.aii.;; 21-Aug-92	DAL;	¥Updated template file from Bryan Pietrzak:;	- updated GS/OS and FST records for System 6.0:;	- added flags to ChangePathRecGS;	- added flags and realVolName to FormatRecGS;	- added levelMode to LevelRecGS;	- added userID to GetNameRecGS;	- added resourceNumber and level to RefInfoRecGS;	- added JudgeNameRecGS; 	- added characteristics and deviceID to VolumeRecGS;	- added DefaultPrivilegesRec to AppleShare FST;	- added DOS 3.3 and Pascal FSTSpecific support: textModeRec;	Also fixed FileInfoRecGS and cleaned out some old comments.;; 21-Sep-92	DAL;	¥Direct-page value in MEM display is really limited to a one-byte;	offset now (if you tried hard enough, you could get a 2-byte offset;	being used while only the low byte was displayed).;; 5-Oct-92	DAL;	¥Version 1.7d4.;	¥Reverted to GetNextEvent/EventAvail, not GetOSEvent/OSEventAvail.;	Using the OS versions was a bad idea--can't get into CDA menu, for;	example.;; 28-Oct-92	DAL;	¥Version 1.7d5.;	¥Made G like R for MacsBug users who can't remember the difference.;; 1-Dec-92	DAL;	¥Fixed Myhandhg logic to dispose of bank-zero memory even under P8.;; 22-Jan-93	DAL;	¥Version 1.7d6;	¥Fix REP and SEP to be emulated, so that we can affect the Interrupt;	bit in the simulated state (see XEQ_REP and XEQ_SEP).;; 12-Feb-93	DAL;	¥Added CompactResourceFile to ToolNames.aii.;; 28-Mar-93	JCM;	¥Version 1.7d7;	¥Added UseColorTable and RestoreColorTable to ToolNames.aii.;	¥Added two new commands SRB (Set Request Break) and CRB (Clear Request Break).;	These commands trap on named or numbered requests as they are sent via;	SendRequest. There's a new break display available via 'SH2' (please, please;	tell me a better way) to show the currently set request breaks. To turn on and;	off request breaking, use 'r+' and 'r-'. 'r' will show up at the top of the;	display, under the 'BRKs' area, just like other break indicators. Everything;	works just like Dave described for 1.6d23;	;	For now, we don't notice the target of the requests (srb _tellFinderOpenWindow;	will break on all $8002 request codes, not just those sent to ~Apple~Finder~).;; 29-Mar-93	JCM;	¥Changed CheckSRQBreak to run in 16-bit mode and actually notice if a SendRequest;	call was being made.;	¥STB (and it's aliases) now cascade to SOB and then SRB if the given name doesn't;	match at each handler. This allows you to stick with STB for everything, rather;	than needing to rememeber to use the others, 'cause Dave and I don't. :-);; 4-Apr-93 	JCM;	¥Stuck little bits of code all over the place to allow JSR (addr,x) to be run in;	real time (you can now X over them, just like other jsr's and jsl's).;; 11-May-93	JCM;	¥Added a new selector to DebugGetInfo, $0001, GetOAESCEntry. This returns the;	address of the code that handles the OA-Option-ESC entry, plus 2 (this accounts;	for the SEP #$30).;	¥CTB (and it's aliases) now cascade to COB and then CRB if the given name doesn't;	match at each handler, just like STB does as of 29-Mar-93.;	¥Fixed TXS in emulation mode to keep stack within $01xx. It used to copy all of;	X which resulted in the stack being set to $00xx.;	¥You can now skip inline names (with down-arrow when stepping) as though they were;	one large instruction.;	¥We now call Nifty List to give us tool call prototypes for display on the;	command line while stepping. If NL doesn't respond the the request, we work;	just like before.;	¥X-ing a tool call or JSL with a toolcall break that is inside the real time;	code now executes correctly, instead of reentrantly crashing GSBug. MPs and;	JSRs to come.;; 12-May-93 	JCM	;	¥Shift-stepping to trace into glue never worked. It does now, except I simplified;	it so that you can trace into it with the option key. Much easier to remember.;; 13-May-93 	JCM;	¥Added a new option to the Set (config) screen. You can now turn the display;	of the Nifty List-provided toolbox prototypes on and off.;; 17-May-93 	JCM;	¥I rearranged all of the Set/Clear/Check/In/Out commands (for tbrks, osbrks, and;	reqbrks) so that they could be called as subroutines. All of the command handler;	entry points are still valid, however, there is a new entry point for each that;	ends in "Core". All this does is allow them to be jsr'ed to, rather than branched;	to as the #@$!(#$!% GSBug code requires.;	¥All of the above work is so I could start adding two new cool debugger tool calls;	which are DebugControl and DebugQuery. This will allow someone to put another;	type of interface on GSBug. For instance, a neat Nifty List command could allow;	you to scan the names in a program and set breaks on them, much like MacsBug.;	There are lots of possibilities.;	¥I changed the CkxxBrk calls so that they now return carry clear if the requested;	break was found, and carry set if they don't. All code that calls them has been;	changed as well.;; 25-May-93	JCM;	¥Implemented two new bits in OS_Public_Flags to indicate if GSBug has been loaded;	($0002) and if we're currently in GSBug ($0001).;; 9-Jun-93	JCM;	¥Fixed bugs in CkTBrk, CkOSBrk, and CheckSRQBreak that if we had a match;	on a call, the status reg was restored from the stack before the carry;	flag was cleared. Since it seems that most of the time it was set before;	our subs were called, we generally returned with it set, which said we ;	didn't have a match and weren't to break. Whoopsee.;	¥DebugQuery still isn't done.;; 17-Oct-93	JCM;	¥Version 1.7d9.;	¥Fixed DebugQuery stub (still not done) so it builds.;**************************************************************************************************;------------------------------------------;; Equates from procedure Debug816;;------------------------------------------ThisIsADA	equ 0ThisIsBinary	equ 0*** ThisIsRAM	equ 1	;2=Application version; 1=Init version; 0=ROM versionThisIsDEV	equ 1	;1=Development version; 0=Non-development version** Error codes from toolset $FF calls*debugUnImpErr	equ $FF01debugBadSelErr	equ $FF02debugDupBreakErr	equ $FF03	;17-May-93 JCMdebugBreakNotSetErr	equ $FF04	;17-May-93 JCMdebugTableFullErr	equ $FF05	;17-May-93 JCMdebugTableEmptyErr	equ $FF06	;17-May-93 JCMdebugBreaksInErr	equ $FF07	;22-May-93 JCM*** Added - 25-May-93 JCM - New bits in OS_Public_Flags for GSBug's use.GSBug_Active	equ $0001	;set to one when the user is in GSBugGSBug_Installed	equ $0002	;set to one when we sucessfully load*** End - 25-May-93 JCM** EmulStackValue gets stored at $010100.  Interrupts work from $0100+EmulStackValue down,* and we can successfully trace code whose stack is greater than this value.*EmulStackValue	equ $c0;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------*** ;	ENTRY da_header	TITLE 'Cortland Debugger v1.1 -DEBUG816.SRC-'	STRING ASIS	BLANKS OFF	include 'all.macros'	include 'equates.i'	include 'SaveRest.macros'	eject	IMPORT GetRequestName	;28-Mar-93 JCM	IMPORT GetRequestNumber	;28-Mar-93 JCM	IMPORT GetToolName	IMPORT GetToolNumber	IMPORT GetDOSName	import GetDOSNumber		;added 11-Oct-90 DAL	IMPORT GetHex32	IMPORT GetDec32	IMPORT HistEntrySize	IMPORT SaveHist	IMPORT Hist	IMPORT OpenHist	IMPORT CloseHist	IMPORT ViewHist	MSB ON	LONGA OFF	LONGI OFF	Macro&Lab	LDWORDA &Arg	lda &Arg+1	xba	lda &Arg	EndMDebug816	PROC EXPORT	EXPORT BufLen	EXPORT InputBuffer	EXPORT DigitCnt	EXPORT HistCount	EXPORT HistStep	EXPORT DoMult	EXPORT TLEN	EXPORT TFMT	EXPORT TOPC	EXPORT DOSErr	EXPORT DOSErr40	EXPORT DOSErr16	EXPORT Debug1	EXPORT ClearDis	EXPORT ErrCmd	EXPORT I_OPC	EXPORT SETBASE	EXPORT OUTPC	EXPORT OUTREG	EXPORT OUTSTACK	EXPORT OUTOPC	EXPORT ILINE	EXPORT GETKEYMOD	EXPORT HEXTODEC	EXPORT OUT	EXPORT SetBase17	EXPORT OUTHEX	EXPORT HistRef	EXPORT GetPath	EXPORT pathname	EXPORT DFUP	EXPORT DFDN	EXPORT ViewHistFlag	EXPORT MPScan	EXPORT MP_H:equ	EXPORT UpShift	Export SaveToolVectors	Export SaveBrkVector*********************************************************;; This is the startup routine for ROM based debugger,; call misc tool for a new ID and call memory manager; for a block of 64k memory and also ask for 1k stack/; direct page.;; When quiting from debugger, the ID and required memory; block are not disposed because it is designed so that; the debugger can resume debugging the user program.;;     Joe Bo          Jan-Feb. 1988;; Copyright 1988 Apple Computer, Inc.;*********************************************************START	If ThisIsRAM = 2 goto .ApplSTARTromstart	If ThisIsRAM = 1 goto .firstart	msb on	DC.B 'ROMTOOLS'	ds.b 24	;DAL 10-Oct-90 (was separate DC.Bs).firstartfirststart*** added 21-Nov-91 DAL	jsr ShowTheBugIcon	jsr CheckForDupDebugger	bcs @byebye*** end 21-Nov-91	sep #$30	;first startup starts here	longa off	longi off	lda >OptionKey	;See if the option key is held down.	asl A	bpl InitIt	;Nope, so go init.; The option key was held down, so we don't want the debugger loaded in.@byebye	rep #$30	longa on	longi on	jsr XOutTheBugIcon	If ThisIsRAM <> 1 goto .DontRemove;; If this is the init version then we need to get the handle of the program; and the dispose of it.;	pha	;allowing space for result	pha	;allowing space for result	pushlong #romstart	_FindHandle	_DisposeHandle	;DAL.DontRemove	rtlInitIt	rep #$30	longa on	longi on*** added 15-Oct-90 DAL	phb	phk	plb	pha	_MMStartUp	pla	sta DebuggerID	pha	pha	;space for result	pea 0	phb	pla	phk	;pushed high word of current address	per @here	;push low word of here@here	_FindHandle	pla	sta FudgeHandle	pla	sta FudgeHandle+2	plb***	ldx #$0008	;save zero page first, 10 bytessavelp	lda <MyID,x	pha	dex	dex	bpl savelp;; Get new ID;	pha	;space for result	pea $8000	;set to firmware attribute	_GetNewID	;DAL	ply	;get the ID returned	sty <MyID	;store it	bcc noerror	;no error, just continue	brl StartupErrornoerror	pha	;get max block size available	pha	_MaxBlock	;DAL	pla	pla	if ThisIsRAM = 0 goto .MoveROM;; Get the handle of our block.;	pea $0000	;allowing space for result	pea $0000	;allowing space for result	pushlong #romstart	_FindHandle	;DAL	plx	;get low word of the handle first	stx <handlelw	ply	;get high word of the handle	sty <handlehg	bcc DontMove	brl error2	if ThisIsRAM <> 0 goto .DontMove.MoveROM;; Call memory manager for a block of 64k;	pha	;allowing space for result	pha	;allowing space for result	pea $0001	;ask for 64k block (was one byte short! 31-Aug-90 DAL)	pea $0000	ldy <MyID	phy	;get my ID	pea $c018	;attributes for the block	pha	;location pointer	pha	;low word of location pointer	_NewHandle	plx	;get low word of new handle first	stx <handlelw	ply	;get high word of new handle	sty <handlehg	bcc noerror2	brl error2;; Make a copy of specified number of bytes from ROM to the new handle;noerror2	pea $00f8	; source = $00f80000 (ROMTOOLS address)	pea $0000	phy	;destination get from above	phx	pea $0001	pea $0000	_PtrToHand	;DAL 31-Aug-90	bcc @1	brl error3@1.DontMoveDontMove	ldy #$0002	;can't use it if you don't set it!!	sep #$30	;unitl I figure this out	longa off	longi off	lda [handlelw],y	;get real bank address for us	phb	pha	plb	;in new data bank; We don't want anybody to call the debugger till we are ready.	sei;; Initialize the variables used in the heartbeat task and start it; pointing in the right direction;	rep #$30	longa on	longi on	lda #$0003	sta jmp_ptr	;init these to reflect we've	lda #$0004	;already put one level on the queue	sta que_ptr; Could be...	lda >CDAVector+2	sta CDA+2	sta queue+1	lda >CDAVector+1	sta CDA+1	sta queue	jsr SaveBrkVector	lda #<BRKSTART	;set the break vector	sta >BRKV	jsr SaveToolVectors	jsr InstallMyNP	;23-Oct-90 DAL	plb	;restore bank address	lda [handlelw],y	;get high word of master pointer	sep #$30	longa off	longi off	phb	pha	plb	;temp set data bank for us to save	sta >DebugB	;save for resuming usage	sta >CDAVector+3	sta >BRKV+2	sta >$E10003	sta >$E10007	sta Create_parm+2	; Init the parameter lists to point	sta Open_parm+4	;  to the right bank.	sta Read_parm+4	sta Write_parm+4	sta Prefix_parm+4	sta LastTemp+2	sta FirstHand+2	rep #$30	longa on	longi on	lda [handlelw]	;get low word	clc	adc #newstart-romstart	pea In_Vector	pla	;start up properly pointing	sta >CDAVector+1	plb	;restore their data bank	brl done; Various routine that are used more than once that restore vectors and suchRestoreCDAVector	php	rep #$20	longa on	lda CDA+2	sta >CDAVector+2	lda CDA+1	sta >CDAVector+1	plp	rtsRestoreBRKVector	php	rep #$20	longa on	lda BRKVector	; Restore the break vector.	sta >BRKV	lda BRKVector+1	sta >BRKV+1	plp	rtsRestoreToolVectors	php	rep #$20	longa on	lda ToolVector	; Restore the tool vector	sta >$E10001	lda ToolVector+1	sta >$E10002	lda OldGlueToolCall+1	sta >$E10005	lda OldGlueToolCall+2	sta >$E10006	lda CallClass0	sta >$E100A8	lda CallClass0+2	sta >$E100AA	lda CallClass1	sta >$E100B0	lda CallClass1+2	sta >$E100B2	plp	rtsSaveToolVectors	php	rep #$20	longa On	lda >$E10001	; Save the old tool vector	sta ToolVector	lda >$E10002	sta ToolVector+1	lda >$E10005	sta OldGlueToolCall+1	lda >$E10006	sta OldGlueToolCall+2; Now set the new values	lda #<ToolTrap	; Set the tool vector.	sta >$E10001	lda #>ToolTrap	sta >$E10002	lda #<GlueToolTrap	sta >$E10005	lda #>GlueToolTrap	sta >$E10006	plp*** fall into SaveOSVectors (separated 23-Oct-90 DAL so the notify proc can call it)SaveOSVectors	php	rep #$20	lda >$E100A8	sta CallClass0	lda >$E100AA	sta CallClass0+2	lda >$E100B0	sta CallClass1	lda >$E100B2	sta CallClass1+2	lda #<OSBrkClass0	sta >$E100A9	lda #>OSBrkClass0	sta >$E100AA	lda #<OSBrkClass1	sta >$E100B1	lda #>OSBrkClass1	sta >$E100B2	plp	rts** InstallMyNP -- install a notify proc so we can re-install the* OS breaks on return from P8** New routine 23-Oct-90 DAL*InstallMyNP	php	rep #$30	pushlong #MyNPParms	pea $2034	;_AddNotifyProc	jsl $e100b0	plp	rtsMyNPParms	dc.w 1	dc.l MyNotifyProcMyNotifyProc	dc.l 0	;reserved	dc.w 0	;reserved	dc.w $A55A	dc.l $00000004	;P8-->GS/OS switch onlyEventCode	dc.l 0ProcEntry	phb	;added 10-Dec-90 DAL	phk	;added 10-Dec-90 DAL	plb	;added 10-Dec-90 DAL	jsr SaveOSVectors	plb	;added 10-Dec-90 DAL	rtl** SaveBRKVector*SaveBRKVector	php	rep #$20	longa on	lda >BRKV	sta BRKVector	lda >BRKV+1	sta BRKVector+1	plp	rts**************************************************************************************************** CheckForDupDebugger** Output: SEC if a copy of us is already installed***************************************************************************************************	longa on	longi onCheckForDupDebugger	phd	pushlong $E10048+1	tsc	tcd	lda [1]	and #$00ff	cmp #$004c	bne @noProblem	ldy #1	lda [1],y	sta 1	lda [1]	cmp #$30E2	;SEP #$30	bne @noProblem	ldy #2	lda [1],y	cmp #$25AD	;LDA $xx25 ($C025)	bne @noProblem@dup	sec	bra @exit@noProblem	clc@exit	ply	ply	pld	rts**************************************************************************************************** ShowTheBugIcon -- use ShowBootInfo to display a cute little Bug icon (System 6.0 and later)***************************************************************************************************ShowTheBugIcon	pushlong #bootString	pushlong #bootIconshowBootInfo	jsr BeforeDebuggerToolCall	ldx #$3c03	jsl $e10000;	_ShowBootInfo	jsr AfterDebuggerToolCall	bcc @ok	cmp #$0010	bcs @ok	pla	pla	pla	pla	;threw out input parameters (call wasn't there)@ok	rts**************************************************************************************************** XOutTheBugIcon -- use ShowBootInfo to display an X on top of the bug icon, showing that we*                   did not load (System 6.0 and later)***************************************************************************************************XOutTheBugIcon	pha	pha	pea $8001	;rIcon	pushlong #$07FF0058	_LoadResource	;from Sys.Resources	plx	pla	bcs @noX	phd	pha	phx	tsc	tcd	ldy #2	lda [1],y	ora #$8000	;set bit 31 to overlay icon	tax	lda [1]	ply	ply	pld	pushlong #0	;no string	phx	pha	;icon ptr	bra showBootInfo@noX	rtsbootIcon	dc.w $8000	;iconType	dc.w 280	;icon size	dc.w 20,28	;height and width	dc.b $FF,$FF,$FF,$FF,$F0,$00,$FF,$F0,$00,$FF,$FF,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$F0,$0F,$FF,$0F,$0F,$FF,$00,$FF,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$0F,$FF,$F0,$00,$00,$FF,$FF,$0F,$FF,$FF,$FF	dc.b $FF,$FF,$F0,$FF,$FF,$F0,$CF,$30,$FF,$FF,$F0,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$FF,$FF,$F0,$FF,$F0,$FF,$FF,$FF,$FF,$FF,$FF	dc.b $FF,$00,$0F,$FF,$FF,$FF,$00,$0F,$FF,$FF,$FF,$00,$0F,$FF	dc.b $FF,$FF,$00,$0F,$FF,$F0,$44,$40,$FF,$FF,$00,$0F,$FF,$FF	dc.b $FF,$FF,$FF,$00,$00,$04,$44,$44,$00,$00,$0F,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$FF,$F0,$FF,$FF,$FF,$F0,$FF,$FF,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$FF,$00,$FF,$FF,$FF,$F0,$0F,$FF,$00,$FF,$FF	dc.b $FF,$FF,$FF,$FF,$04,$44,$44,$44,$44,$0F,$F0,$0F,$FF,$FF	dc.b $FF,$FF,$F0,$00,$04,$44,$44,$44,$44,$00,$00,$FF,$FF,$FF	dc.b $FF,$FF,$00,$FF,$04,$44,$44,$44,$44,$0F,$FF,$FF,$FF,$FF	dc.b $FF,$F0,$0F,$FF,$00,$FF,$FF,$FF,$F0,$0F,$FF,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$FF,$F0,$FF,$FF,$FF,$F0,$FF,$FF,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$FF,$00,$04,$44,$44,$00,$0F,$FF,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$F0,$0F,$F0,$44,$40,$FF,$00,$FF,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$00,$FF,$FF,$00,$0F,$FF,$F0,$0F,$FF,$FF,$FF	dc.b $FF,$FF,$F0,$0F,$FF,$FF,$FF,$FF,$FF,$FF,$00,$FF,$FF,$FF	dc.b $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$0F,$FF,$FF* icon mask	dc.b $00,$00,$00,$00,$0F,$FF,$00,$0F,$FF,$00,$00,$00,$00,$00	dc.b $00,$00,$00,$0F,$F0,$00,$F0,$F0,$00,$FF,$00,$00,$00,$00	dc.b $00,$00,$00,$F0,$00,$0F,$FF,$FF,$00,$00,$F0,$00,$00,$00	dc.b $00,$00,$0F,$00,$00,$0F,$FF,$FF,$00,$00,$0F,$00,$00,$00	dc.b $00,$00,$00,$00,$00,$0F,$FF,$FF,$00,$00,$00,$00,$00,$00	dc.b $00,$FF,$F0,$00,$00,$00,$FF,$F0,$00,$00,$00,$FF,$F0,$00	dc.b $00,$00,$FF,$F0,$00,$0F,$FF,$FF,$00,$00,$FF,$F0,$00,$00	dc.b $00,$00,$00,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$F0,$00,$00,$00	dc.b $00,$00,$00,$00,$0F,$FF,$FF,$FF,$FF,$00,$00,$00,$00,$00	dc.b $00,$00,$00,$00,$FF,$FF,$FF,$FF,$FF,$F0,$00,$FF,$00,$00	dc.b $00,$00,$00,$00,$FF,$FF,$FF,$FF,$FF,$F0,$0F,$F0,$00,$00	dc.b $00,$00,$0F,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$00,$00,$00	dc.b $00,$00,$FF,$00,$FF,$FF,$FF,$FF,$FF,$F0,$00,$00,$00,$00	dc.b $00,$0F,$F0,$00,$FF,$FF,$FF,$FF,$FF,$F0,$00,$00,$00,$00	dc.b $00,$00,$00,$00,$0F,$FF,$FF,$FF,$FF,$00,$00,$00,$00,$00	dc.b $00,$00,$00,$00,$FF,$FF,$FF,$FF,$FF,$F0,$00,$00,$00,$00	dc.b $00,$00,$00,$0F,$F0,$0F,$FF,$FF,$00,$FF,$00,$00,$00,$00	dc.b $00,$00,$00,$FF,$00,$00,$FF,$F0,$00,$0F,$F0,$00,$00,$00	dc.b $00,$00,$0F,$F0,$00,$00,$00,$00,$00,$00,$FF,$00,$00,$00	dc.b $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$0F,$F0,$00,$00**************************************************************************************************** GetGSBugDirectPage - Call Memory Manager for 1K stack/direct page in bank zero since we do not*	   have one. When we exit, the direct page is still set as it was on entry.*	   The new DP pointer is available in xDEBUG_D if there was no error.*GetGSBugDirectPageOldDP	equ $5TempGSBugDPHand	equ $1	phd	pha	pha	tsc	tcd	jsr BeforeDebuggerToolCall	pha	pha	;was PEA, DAL 10-Oct-90	pea $0000	;high part of block size	pea $0400	;low part of block size, 1k***	ldy MyIDBuf	;get my ID***	phy	pha	;** 23-Oct-90 DAL	_MMStartUp	;** (use our real ID, not $80xx)	pea $C015	;locked/fixed/page aligned/no cross bank/fixed bank	lda #0000	pha	pha	_NewHandle	;DAL	plx	;get low word of new handle	stx <TempGSBugDPHand ;store it	stx GSBugDPHand	;store it in my area too	plx	;get high word of new handle	stx <TempGSBugDPHand+2 ;store it	stx GSBugDPHand+2	;store for me later	jsr AfterDebuggerToolCall	bcc @P16_in@checkP8	lda >PFlag	;if 00 then P8	and #$00FF	beq @Is_P8@error	sec	;a real memory alloc problem@exit	pla	pla		pld	rts@Is_P8	;	lda #$0000	;set direct page to 0000	lda #$6000	;29-Aug-90 DAL *** Try using the 1K at $6000 under ProDOS 8	bra @P8_in@P16_in	lda [TempGSBugDPHand] ;get low word of pointer to bank00@P8_in	sta xDEBUG_D	;save debugger direct page	clc	adc #$100	;give user some $100 below mine	sta DT	clc	;prepare to adjust debugger stack	adc #$1F9	;one page for user stack and set to top	sta ST	;store as user stack	adc #$106	;another page for debugger stack	sta xDEBUG_S	;Store as debugger stack	clc	bra @exit**************************************************************************************************** DisposeGSBugDirectPage - *DisposeGSBugDirectPage	lda GSBugDPHand+2	;mother may I give it back?	pha	;dispose the block that we got during entry	lda GSBugDPHand	pha	jsr BeforeDebuggerToolCall	_DisposeHandle	;DAL	jsr AfterDebuggerToolCall*** added 1-Dec-92 DAL	stz GSBugDPHand+2	stz GSBugDPHand*** end 1-Dec-92	rts**************************************************************************************************error3; NOTE: error 3 always entered in 16 bit <A> mode here!	rep #$30	longa On	jsr RestoreCDAVector	jsr RestoreBRKVector	jsr RestoreToolVectors	clierror2	lda <MyID	pha	_DeleteID	;DAL	ldx #$0000	;restore zero page stuffsgetback	pla	sta <MyID,x	inx	inx	cpx #$000a	bne getbackerror1	If ThisIsRAM <> 1 goto .DontRemove2;; If this is the init version then we need to get the handle of the program; and the dispose of it.;	pea $0000	;allowing space for result	pea $0000	;allowing space for result	pushlong #romstart	_FindHandle	_DisposeHandle	;DAL (macrofied).DontRemove2	rtl	;back to desk accessory installment routinedone;; install the ROM based desk accessory;	sep #$30	longa off	longi off	phb	phd	lda >DebugB	pha	plb	rep #$30	longa on	longi on	ldx #$0008	;point to last wordsavemy	lda <MyID,x	;store MyID, handle to my buffer area	sta MyIDBuf,x	;save to my area	dex	dex	bpl savemy	IF ThisISRAM = 0 goto .no_default	sep #$30	longa off	longi off	jsr LoadDefault	; Load the default configuration.;;;	sta >$777777		jsr LoadTempSubr	;23-Oct-90 DAL.no_default	rep #$30	longa on	longi on;; Before exiting, need to start heart beat task;	lda >DebugB	;upper part of my bank]	and #$00FF	;mask off top part	pha	pea My_Task	_SetHeartBeat	;install heart beat task every 10 VBLs	bcc @1	brl error3@1	pea $0002	;enable VBL interrupts	_IntSource	;DAL	bcc @2	brl error3@2;; Restore bank0/zero page, still in stack space;	plb	;restore desk accessory data bank	pld	;restore its direct register also	ldx #$0000restoreLp	pla	;restore bank0/zero page stuffs	sta >MyID,x	;absolute long, already in my bank	inx	inx	cpx #$000a	bne restorelp*** Added - 25-May-93 JCM - New public flag to indicate that GSBug has been loaded.	lda >OS_Public_Flags	ora #GSBug_Installed	sta >OS_Public_Flags*** End - 25-May-93 JCM	cli	rtl*	;*	; desk accessory handle and header*	;*	cda_handle	DC.L da_header	;handle to ROM based cda*		EXPORT da_header*	da_header	DC.B $0c	;length of cda name*		DC.B 'ROM Debugger'*		DC.L da_start	;pointer to start of cda code*		DC.L da_shutdn	;pointer to cda shut down code**	da_shutdn	rtl*newstart	sep #$30	longa off	longi off	lda OptionKey	;see if it is me	asl A	bmi da_start	jmp CDA	;not me go to DAs two jumpsBRKSTART	phk	;a and I are short here	phb	plx	;save orig b in x -- don't mess up stack pointer	plb	bit BRK_STATE	; Are user breaks set?	bpl @BRKSTART1	; Nope.	phx	; Yes, so restore the bank.	plb	sec	rtl	; And return.@BRKStart1;; This routine will handle the 'fake' real time break countdown; It will decrement a counter and then back out on zero.  I hope this works.;	pha	; save <A> on the stack	jsr testRTBreak	; see if the real time break time is up	bcs @BRKStart12	; carry set means do it!	pla	clc	; yes we handled the interupt	RTL	; now return to our regularly scheduled prog@B