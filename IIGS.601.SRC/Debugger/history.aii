	include 'equates.i'	MSB ON	;	EXPORT GetDec32;	EXPORT GetHex32	EXPORT HistEntrySize:equ	PCLength	equ 3InstLength	equ 8RegLength	equ 17HistEntrySize	equ PCLength+InstLength+RegLength	*************************************************************OpenHist	PROC EXPORT** Open a history buffer and skip the first two bytes.** Inputs:	*	InputBuffer	input buffer*	BUFLEN	length of input*	y	current buf position** Outputs:	*	HistRef	reference # of open history file*	HistCount	reset to zero*	y	new buf position** External Refs:	IMPORT DosErr	IMPORT DOSerr40	IMPORT ERRCMD	IMPORT HistRef	IMPORT GetPath	IMPORT pathname	IMPORT DEBUG1	IMPORT HistCount** Entry State:	longa off	longi off*************************************************************	lda HistRef	; Make sure that there isn't already	ora HistRef+1	;  an open history.	beq @ResetHist	jmp ERRCMD	@ResetHist	stz HistCount	; Reset the history count.	stz HistCount+1		phk	; Set all of the addresses to the right	pla	;  bank.	sta @CreateListAddr+2	sta @CreateList+2	sta @OpenListAddr+2	sta @OpenList+4	sta @WriteListAddr+2	sta @WriteList+4		jsr GetPath	; Get the path.	bcc @CreatePath	jmp DOSerr40	@CreatePath	jsl MLI_16	; Remove the file.	dc.w $0001@CreateListAddr	dc.l @CreateList	bcc @OpenPath	cmp #$47	; duplicate?	beq @OpenPath	; If so, ignore.@Error	jmp DOSErr	@OpenPath	jsl MLI_16	; Open the file.	dc.w $0010@OpenListAddr	dc.l @OpenList	bcs @Error		lda @OpenList	; Save the reference number.	sta HistRef	sta @WriteList	lda @OpenList+1	sta HistRef+1	sta @WriteList+1		jsl MLI_16	; Skip the 1st two bytes.	dc.w $0013	; write@WriteListAddr	dc.l @WriteList	bcs @Error		jmp DEBUG1	@CreateList	dc.l pathname	;IN:  pathname	dc.w $00C3	;IN:  access	dc.w $0006	;IN:  filetype = bin	dc.l $00000000	;IN:  auxtype	dc.w $0001	;IN:  storage_type	dc.w $0000	;IN:  create_date	dc.w $0000	;IN:  create_time	@OpenList	dc.w $0000	;OUT: ref_num	dc.l pathname	;IN:  pathname	dc.l $00000000	;OUT: I/O buffer@WriteList	dc.w $0000	;IN:  ref_num	dc.l HistCount	;IN:  data_buffer	dc.l $00000002	;IN:  request_count	dc.l $00000000	;OUT: transfer_count			*************************************************************CloseHist	PROC EXPORT** Call the routine to close a history file.** Inputs:	*	HistRef	open history ref #*	HistCount	# of history steps** Outputs:	*	none** External Refs:	IMPORT DosErr	IMPORT DEBUG1	IMPORT DoCloseHist** Entry State:	longa off	longi off*************************************************************	jsr DoCloseHist	bcs @Error	jmp DEBUG1	@Error	jmp DOSErr*************************************************************DoCloseHist	PROC EXPORT** Write the history length to the open history file and* close the file.** Inputs:	*	HistRef	open history ref #*	HistCount	# of history steps** Outputs:	*	none** External Refs:	IMPORT DosErr	IMPORT ERRCMD	IMPORT HistRef	IMPORT DEBUG1	IMPORT HistCount** Entry State:	longa off	longi off*************************************************************	lda HistRef	ora HistRef+1	beq @Done	phk	; Set all of the addresses to the right	pla	;  bank.	sta @SetListAddr+2	sta @WriteListAddr+2	sta @CloseListAddr+2	sta @WriteList+4		lda HistRef	; Set reference number.	sta @SetMarkList	sta @WriteList	sta @CloseList	lda HistRef+1	sta @SetMarkList+1	sta @WriteList+1	sta @CloseList+1		jsl MLI_16	dc.w $0016	; set_mark@SetListAddr	dc.l @SetMarkList	bcs @Error		jsl MLI_16	dc.w $0013	; write@WriteListAddr	dc.l @WriteList	bcs @Error		jsl MLI_16	dc.w $0014	; close@CloseListAddr	dc.l @CloseList	bcs @Error		stz HistRef	; Reset history reference number.	stz HistRef+1	@Done	clc	rts	@Error	sec	rts@SetMarkList	dc.w $0000	;IN:  ref_num	dc.l $00000000	;IN:  position@WriteList	dc.w $0000	;IN:  ref_num	dc.l HistCount	;IN:  data_buffer	dc.l $00000002	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	@CloseList	dc.w $0000	;IN:  ref_num		*************************************************************SaveHist	PROC EXPORT** Save the current instruction and registers.** Inputs:	*	InputBuffer	input buffer*	BUFLEN	length of input*	y	current buf position** Outputs:	*	AL/AH/AB/T1	number*	y	new buf position** External Refs:	IMPORT TOPC	IMPORT HistRef	IMPORT HistCount	IMPORT DoCloseHist	IMPORT MPSCAN	IMPORT MP_H** Entry State:	longa off	longi off*************************************************************	lda PCH	xba	lda PCL	ldx PCK	ldy #MP_H	jsr MPSCAN	;scan for MP_H (Trace Window)	bcs @SaveHist1	;K/PC in an MP_H range	bvc @SaveHist1		rts@SaveHist1	lda HistRef	; Make sure that there is an open	ora HistRef+1	; history file.	bne @SaveHist2	rts	@SaveHist2	lda HistCount	; See if file is full.	and HistCount+1	cmp #$FF	bne @SaveHist3	brl @Error	@SaveHist3	phk	; Set all of the addresses to the right	pla	;  bank.	sta @WriteList1Addr+2	sta @WriteList2Addr+2	sta @WriteList3Addr+2	sta @WriteList2+4	rep #$30	; Set the direct page addresses.	longa on	longi on	clc	tdc	adc #PCL	sta @WriteList1+2	clc	tdc	adc #AR	sta @WriteList3+2		sep #$30	longa off	longi off	lda HistRef	; Set reference number.	sta @WriteList1	sta @WriteList2	sta @WriteList3	lda HistRef+1	sta @WriteList1+1	sta @WriteList2+1	sta @WriteList3+1	jsl MLI_16	; Write the PC.	dc.w $0013	; write@WriteList1Addr	dc.l @WriteList1	bcs @Error		jsl MLI_16	; Write the instruction.	dc.w $0013	; write@WriteList2Addr	dc.l @WriteList2	bcs @Error		jsl MLI_16	; Write the registers.	dc.w $0013	; write@WriteList3Addr	dc.l @WriteList3	bcs @Error		inc HistCount	bne @Done	inc HistCount+1		@Done	rts	; All done.; If an error occurs, close the file.	@Error	jmp DoCloseHist@WriteList1	dc.w $0000	;IN:  ref_num	dc.l $0000	;IN:  data_buffer	dc.l PCLength	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	@WriteList2	dc.w $0000	;IN:  ref_num	dc.l TOPC	;IN:  data_buffer	dc.l InstLength	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	@WriteList3	dc.w $0000	;IN:  ref_num	dc.l $0000	;IN:  data_buffer	dc.l RegLength	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	*************************************************************ViewHist	PROC EXPORT** View a history file.** Inputs:	*	InputBuffer	input buffer*	BUFLEN	length of input*	y	current buf position** Outputs:	*	AL/AH/AB/T1	number*	y	new buf position** External Refs:	IMPORT HistCount	IMPORT HistStep	IMPORT HistRef	IMPORT TLEN	IMPORT TFMT	IMPORT TOPC	IMPORT DOSERR40	IMPORT DOSERR	IMPORT DEBUG1	IMPORT CLEARDIS	IMPORT ERRCMD	IMPORT I_OPC	IMPORT SETBASE	IMPORT OUTPC	IMPORT OUTREG	IMPORT OUTSTACK	IMPORT OUTOPC	IMPORT ILINE	IMPORT GETKEYMOD	IMPORT SETBASE17	IMPORT OUT	IMPORT HEXTODEC	IMPORT OUTHEX	Import PATHNAME	Import GetPath	Import DoMult	Import DoCloseHist	Import DFDN	Import DFUP	Import ViewHistFlag** Entry State:	longa off	longi off*************************************************************		lda HistRef	; Can't view if history open.	ora HistRef+1	beq @ViewHist1	jmp ERRCMD	@ViewHist1	phk	; Set all of the addresses to the right	pla	;  bank.	sta @OpenListAddr+2	sta OpenList+4	sta @RdCountListAddr+2	sta RdCountList+4		jsr GetPath	; Get the path.	bcc @OpenPath	jmp DOSerr40	@OpenPath	jsl MLI_16	; Open the file.	dc.w $0010@OpenListAddr	dc.l OpenList	bcs @Error		lda OpenList	; Save the reference number.	sta HistRef	sta RdCountList	sta SetMarkList	sta ReadList1	sta ReadList2	sta ReadList3	lda OpenList+1	sta HistRef+1	sta SetMarkList+1	sta RdCountList+1	sta ReadList1+1	sta ReadList2+1	sta ReadList3+1		jsl MLI_16	; Read the count.	dc.w $0012	; read@RdCountListAddr	dc.l RdCountList	bcs @Error		lda HistCount	; Make sure that there is history.	ora HistCount+1	bne @ViewHist2	jsr DoCloseHist	jmp Debug1	@Error	pha	; Save the error number.	jsr DoCloseHist	pla	; Restore the error number.	jmp DOSERR	@ViewHist2	lda PCL	; Save state.	pha	lda PCH	pha	lda PCK	pha	lda AR	pha	lda AR+1	pha	lda XR	pha	lda XR+1	pha	lda YR	pha	lda YR+1	pha	lda PR	pha	lda SR	pha	lda SR+1	pha	lda SR+2	pha	lda eR	pha	lda DR	pha	lda DR+1	pha	lda DR+2	pha	lda BR	pha	lda MR	pha	lda QR	pha		jsr SETBASE17		lda #$A0	; Clear the command line.	ldy #79@ClearLoop	jsr OUT	dey	bpl @ClearLoop		ldy #0@PrintLoop	lda StepMsg,y	jsr OUT	iny	cpy #StepMsgLen	bne @PrintLoop		stz HistStep	stz HistStep+1	NewScreen	jsr CLEARDIS		ldx #R_OPC@ListLoop	jsr ShowLine	inx	cpx #R_OPC+N_OPC	blt @ListLoop@StepLoop	ldx I_OPC	jsr ShowLine	jsr ShowStepNum@KeyWait	jsr GETKEYMOD	; Get a key.	bpl @KeyWait		cmp #$9B	; Check for escape.	beq @GoDone	cmp #$8B	; Check for backwards.	beq @Backward	cmp #$8A	; Check for forwards.	beq @Forward	cmp #$88	; Check for backwards.	beq @Bottom	cmp #$95	; Check for forwards.	beq @GoTop	cmp #'0'	blt @KeyWait	cmp #'9'+1	bge @KeyWait	brl GetStep	@GoTop	brl @Top	@GoDone	brl Done	@Backward	lda >PB1	bpl @Backward2	brl @BackwardPage	@Backward2	lda HistStep	; Can we go backwards?	ora HistStep+1	beq @KeyWait	; Nope.			sec	; Decrement the current step.	lda HistStep	sbc #1	sta HistStep	bcs @ScrollDown	dec HistStep+1@ScrollDown	jsr DFDN	ldx #R_OPC	jsr ShowLine	bra @StepLoop	@Forward	lda >PB1	bmi @ForwardPage		lda HistStep	sta T1	lda HistStep+1	sta T2	inc HistStep	bne @CkStep	inc HistStep+1	@CkStep	lda HistStep	cmp HistCount	bne @ScrollUp	lda HistStep+1	cmp HistCount+1	bne @ScrollUp	lda T1	sta HistStep	lda T2	sta HistStep+1	brl @KeyWait	@ScrollUp	jsr DFUP	ldx #R_OPC+N_OPC-1	jsr ShowLine	brl @StepLoop	@Bottom	stz HistStep	stz HistStep+1	brl NewScreen	@Top	sec	lda HistCount	sbc #1	sta HistStep	bcs @GoNewScreen	dec HistStep+1@GoNewScreen	brl NewScreen	@BackwardPage	sec	lda I_OPC	sbc #R_OPC	sta T1	sec	; Decrement the current step.	lda HistStep	sbc T1	sta HistStep	bcs @BackwardPage2	dec HistStep+1	bcc @Bottom@BackwardPage2	brl NewScreen	@ForwardPage	sec	lda I_OPC	sbc #R_OPC	clc	adc HistStep	sta HistStep	bcc @ForwardPage2	inc HistStep+1	beq @Top	@ForwardPage2	lda HistStep+1	cmp HistCount+1	blt @ForwardPage4	beq @ForwardPage3	bra @Top@ForwardPage3	lda HistStep	cmp HistCount	bge @Top@ForwardPage4	brl NewScreen	Done	pla	; Restore the regs.	sta QR	pla	sta MR	pla	sta BR	pla	sta DR+2	pla	sta DR+1	pla	sta DR	pla	sta eR	pla	sta SR+2	pla	sta SR+1	pla	sta SR	pla	sta PR	pla	sta YR+1	pla	sta YR	pla	sta XR+1	pla	sta XR	pla	sta AR+1	pla	sta AR	pla	sta PCK	pla	sta PCH	pla	sta PCL		jsr DoCloseHist	jmp DEBUG1GetStep	pha	; Save the key press.	lda HistStep	; Save the old step.	sta OldHistStep	lda HistStep+1	sta OldHistStep+1		pla	; Get the keypress	and #$0F	sta HistStep	stz HistStep+1		jsr ShowStepNum@KeyWait	jsr GETKEYMOD	; Get a key.	bpl @KeyWait	cmp #$8D	; Check for backwards.	beq @Done	cmp #$9B	; Check for escape.	beq @Restore	cmp #'0'	blt @KeyWait	cmp #'9'+1	bge @KeyWait		pha	; Save the keypress.	lda HistStep	sta T3	lda HistStep+1	sta T4		asl T3	; Multiply by 10.	rol T4	bcs @Done	asl T3	rol T4	bcs @Done	clc	lda T3	adc HistStep	sta T3	lda T4	adc HistStep+1	sta T4	bcs @Done	asl T3	rol T4	bcs @Done		pla	; Get the keypress back.	and #$0F	; Add the new digit.	clc	adc T3	sta HistStep	lda T4	adc #0	sta HistStep+1		jsr ShowStepNum	bra @KeyWait	@Restore	lda OldHistStep	; Restore the old step.	sta HistStep	lda OldHistStep+1	sta HistStep+1	brl NewScreen		@Done	lda HistStep+1	; Make sure that we have a valid	cmp HistCount+1	;  step.	blt @OK	beq @CkLow	bge @TooHigh	@OK	brl NewScreen	@CkLow	lda HistStep	cmp HistCount	blt @OK	@TooHigh	sec	; Set to last step.	lda HistCount		sbc #1	sta HistStep	lda HistCount+1	sbc #0	sta HistStep+1	brl NewScreenShowStepNum	lda HistStep	; Print the current step number.	sta AL	lda HistStep+1	sta AH	stz AB	stz T1	jsr HEXTODEC	jsr SETBASE17	ldy #5	lda T4	jsr OUTHEX	lda T3	jsr OUTHEX	lda T2	jmp OUTHEXShowLine	phk	; Set all of the addresses to the right	pla	;  bank.	sta @SetMarkListAddr+2	sta @ReadList1Addr+2	sta @ReadList2Addr+2	sta @ReadList3Addr+2	sta ReadList2+4		rep #$30	; Set the direct page addresses.	longa on	longi on	clc	tdc	adc #PCL	sta ReadList1+2	clc	tdc	adc #AR	sta ReadList3+2		sep #$30	longa off	longi off	jsr SETBASE		cpx I_OPC	bge @Below		sec	stx AL	lda I_OPC	sbc AL	sta AL		sec	lda HistStep	sbc AL	sta AL	lda HistStep+1	sbc #0	sta AH	bcc @Done	bra @ShowLine2	@Below	sec	txa	sbc I_OPC	sta AL		clc	lda HistStep	adc AL	sta AL	lda HistStep+1	adc #0	sta AH	bcs @Done	cmp HistCount+1	beq @TestLow		bge @Done	blt @ShowLine2@TestLow	lda AL	cmp HistCount	blt @ShowLine2	@Done	rts		@ShowLine2	stz AB	stz T1		lda #HistEntrySize	sta T3	stz T4	stz T5	stz T6		phx	; save the row		jsr DoMult		clc	lda AL	adc #2	sta SetMarkList+2	lda AH	adc #0	sta SetMarkList+3	lda AB	adc #0	sta SetMarkList+4	lda T1	adc #0	sta SetMarkList+5		jsl MLI_16	dc.w $0016	; set_mark@SetMarkListAddr	dc.l SetMarkList	bcs @Error		jsl MLI_16	; Read the PC.	dc.w $0012	; read@ReadList1Addr	dc.l ReadList1	bcs @Error		jsl MLI_16	; Read the instruction.	dc.w $0012	; read@ReadList2Addr	dc.l ReadList2	bcs @Error		jsl MLI_16	; Read the registers.	dc.w $0012	; read@ReadList3Addr	dc.l ReadList3	bcs @Error			inc ViewHistFlag	jsr OUTOPC	; Print the instruction.	stz ViewHistFlag		plx	; Get the row back.		cpx I_OPC	; Check for current instruction.	bne @NotCurrent	phx	; Save the row.	jsr ILINE		jsr OUTREG	; Print the registers.	jsr OUTPC	; Print the PC.	plx	; Get the row back.	@NotCurrent	rts@Error	pha	jsr DoCloseHist	pla	jmp DOSERR		OpenList	dc.w $0000	;OUT: ref_num	dc.l pathname	;IN:  pathname	dc.l $00000000	;OUT: I/O buffer	RdCountList	dc.w $0000	;IN:  ref_num	dc.l HistCount	;IN:  data_buffer	dc.l $00000002	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	SetMarkList	dc.w $0000	;IN:  ref_num	dc.l $00000000	;IN:  positionReadList1	dc.w $0000	;IN:  ref_num	dc.l $0000	;IN:  data_buffer	dc.l PCLength	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	ReadList2	dc.w $0000	;IN:  ref_num	dc.l TOPC	;IN:  data_buffer	dc.l InstLength	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	ReadList3	dc.w $0000	;IN:  ref_num	dc.l $0000	;IN:  data_buffer	dc.l RegLength	;IN:  request_count	dc.l $00000000	;OUT: transfer_count	OldHistStep	dc.w $0000StepMsg 	dc.b 'STEP'	;step messageStepMsgLen	equ *-StepMsg	END