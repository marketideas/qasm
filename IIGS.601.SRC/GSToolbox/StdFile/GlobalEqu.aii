**************************************************************************     Copyright Apple Computer, Inc. 1989*            All Rights Reserved** Change History:** 8/28/89	Harry* Defined another bit in FGetPutFlag. Bit 3 when set now means that * the "Volume" or "Disk" button is the old style button, not the * new volumes popup. Also when bit 2 is set, this means that the * TAB key was hit. This is a bit for routine DoVolume to check whether* we had a mouse down or a TAB key for the "Disk" button.** 25-Mar-91	Dave Lyons** Removed the GetDirEntry parameter block stuff; I needed to grow it,* and it was too big to fit on direct page.** 7-Apr-91	Dave Lyons** Defined new error $17FF sfNotStarted.** 18-Dec-91	Dave Lyons** Added FunkyPutFile bit (means that this is a PutFile call, but with* the Line Edit field outside the window).  ShrinkIt GS and other* applications do this to get a choose-directory dialog.** 19-Mar-93 	Steve Stephenson** Added TabBackwards bit in FGetPutFlag to allow "PreviousDrive" (reverse* direction of NextDrive.** 22-Mar-93	Steve Stephenson** Added HaveVisibleEdit in FGetPutFlag to allow tabbing around to multiple* editlines in PutFile and skipping Item#10 if outside of the window.**************************************************************************	DSECT 0** global "zero" page variables*** variables which are passed on the stack and moved into direct page*PromptPtr	long	; Pointer to String displayed in dialog.PromptVerb	word	; descriptor of verbFilterProcPtr	long	; Pointer to the filter procedure.OrigNamePtr    	EQU  FilterProcPtr	; Same variable for PutFile.TypeList	long	; Pointer to the Type List.OrigName	EQU  TypeList	; type list not used in PutOrigNameVerb	word	; word for above referenceDilgHook	long	; put's dialog Hook PointerMaxLen	word	; old style max charactersReplyPtr	long	; Pointer to the Reply Record.WhereX	word	; Location on the screenWhereY	word	; of the dialog Box.stackSize	word	; stack correction count**********************************************************************DialogTemplatePtr	long	; Pointer on patched Dialog.DialogTemplateVerb	word	; verb for above reference (future expansion)PrefixPtr	long	; matching pointerDialogPtr	long	; Ptr returned from GetNewModalDialogDinfoPtr	long	;Ptr for DinfoCall memoryListRecPtr	longListRecHandle	long	;ptr & handle for List Record controlSizeInfoPtr	long	;ptr to hold free space, total space and stringstotalSize	equ 00	;total blocks, bytes 0 - 3totalFree	equ 04	;total free block, bytes 4 - 7totalSizeStr	equ 08	;totalblocks string, bytes 8 - 19 (10. digits max, 2 size)totalFreeStr	equ 20	;total free blocks string, bytes 20-31ListControl1	long	;list handleListRefCon	long	;a place to save above when zeroedScrollControl1	long	;List's scroll bar handleScrollrefCon	long	;a place to save the above when zeroedlastSelected	long	;last item clicked on for double click checklastTime	long	;clock when that item was hitopenButStat	word	;status of open button last time throughcloseButStat	word	;status of close button last time throughsaveButStat	word	;status of save button last time throughcurDev	word	;current dev number.selectedptr	long	;ptr to selected itemtopflg	word	;0 if on the root level of the deviceinvisible	word	;non 0 indicates display invsible fileswriteProtect	word	;non 0 if volume is write protected.IconHookPtr	long	;pointer to a custom icon hook routine.MyId	word	;hAllEntry owner ID*------------------------------------------------* temp variables*------------------------------------------------ztemp1	long	;a  direct page tempztemp2	long	;anotherztemp3	long	;and one more!pointer	long	;a temp pointer for indirect callspointer2	long	;another temp pointerhandle	long	;a temp handle for indirect calls*--equates of above for converting time routinepro_time	equ  handle		;usage of tempshours	equ  ztemp1minutes	equ  ztemp1+2year	equ  ztemp2month	equ  ztemp2+2day	equ  ztemp3*------------------------------------------------------------------------* Some of the information returned from an Open call needs to be saved*------------------------------------------------------------------------RefNumber	word	;refNumber returned from openFileType	word	;file type returned from GetDirEntry callAuxType	long	;file Auxtype returned from GetDirEntry callEntryNum	word	;entry enumber returned from GetDirEntry callDirSize	word	;size returned from directory callFileSysID	word	;volume type returned from _Volume Call*------------------------------------------------------------------------* The list manager (and other places) will need to reference these handles* so these are  GLOBAL handle variables*------------------------------------------------------------------------StringsHandle	long	;memory to build class 1 text strings into for list managerStringsLength	long	;fake lengthStringsPtr	long	;the de-refed pointerStringsOffset	word	;next available entry for a string (64K limit)NameHandle	long	;handle to buffer for ReadDirectoryEntryNamePtr	long	;a pointer to the memory for the above handle (if needed)ListPointerHandle	long	;a handle for the list of files names (for list manager)ListPointerPtr	long	;a pointer to the memory of list name pointers (actually offsets)ProDosDirEntry	long	;a pointer to a ProDos record conversion from GetDirEntry*------------------------------------------------------------------------* Parameter Block for passing paramaters to OS calls (except GetDirEntry)*------------------------------------------------------------------------ParBlock	block $22	;max parameter block size used hereParBlock2	block $10	;the remainder*------------------------------------------------------------------------*other memory needed now but seemed to come from somewhere else*in the original SF*------------------------------------------------------------------------** FGetPutFlag*FGetPutFlag	wordPutFlag	equ $8000	; Flag d16 = 1:Put, 0:getSize320Flag	equ $4000	; d15 = 1:320, 0:640PatchedFlag	equ $2000	; d14 = 1:custom dialog, 0:normalPathDrawPatched	equ $1000	; d13 = 1:PathDraw routine patched, 0:not patchedHaveVisibleEdit	equ $0080	; d7 =  1:means we are in a PutFile w/ at least 1 ediline visibleTabBackwards	equ $0040	; d6 =  1:means we are doing Previous Drive (SS)FunkyPutFile	equ $0020	; d5 =  1:means this is PutFile w/ Line Edit #10 outside the window (DAL)PutFileListActive	equ $0010	; d4 =  1:means the List control is active in putfile (DAL)InVolumeList	equ $0008	; d3 =  1:means this is an old style "Disk" button. TABorMouseDown	equ $0004	; d2 =  1:TAB key hitMultiFIleMode	equ $0002	; d1 =  1: multi file modeOldStyleFlag	equ $0001	; d0 =  1:old file call, 0:new file callCurError	word	; Current Error.LastRequest	long	;last amount of memory requestedtempRect	block 8ItemHit	word	;item # returned from ModalDialogSeperator	byte	;current seperator character.FRedraw	word	;redraw flag to modal dialog loop	IF DummyPC³$FE THEN	  AERROR 'WARNING...Direct page is or is getting TOO LARGE'	ENDIF*********************************************************************** Additional information is kept in the DInfo handle area above $40.* There are approx 100 bytes available here and equated use is below.**********************************************************************FileModInfo	equ  $40	;at location 40 in DInfo handle (scratch area) (4 words)										 ; call is made.********************************************************************************************************************************************** Other needed equates that are not ram***********************************************************************True	equ $FFFFFalse	equ $0000Test_mem_never	equ $40		;For list manager to watch Mem_NeverLenEntry	equ  22		; Length of one Entry.RFType	equ  02RfAuxType	equ  04RPartial	equ  06RPathname	equ  22MEM_SEL	equ $0080	TRUE if selected.MEM_DISABLE	equ $0040	TRUE if disabled.NOT_POSSIBLE	equ $0020	TRUE if member can NEVER be selectedHeightFileC	equ  10ProDos_Stack_Entry	EQU  $E100B0AppleShareID	equ  $000D** equates for the use of the parameter block used to make system calls* Format: name_Tool** AddNotifyProcprocPointer	equ  ParBlock+$02* DControldevNum_DControl	equ  ParBlock+$02controlCode	equ  ParBlock+$04controlList	equ  ParBlock+$06requestCount	equ  ParBlock+$0AtransferCount	equ  ParBlock+$0EejectMedium	equ  $0002* DStatus:devNum_DStatus	equ  ParBlock+$02statuscode_DStatus	equ  ParBlock+$04statlist_DStatus	equ  ParBlock+$06		;status list pointerrcount_DStatus	equ  ParBlock+$0Axfercnt_DStatus	equ  ParBlock+$0E*2 bytes returned, second byte status bits equates:writeProtBit	equ  $4		;if 1, write protected* DInfo:devNum_DInfo	equ  ParBlock+$02		;returned RefNumberdevName_DInfo	equ  ParBlock+$04		;namedevCharact_DInfo	equ  ParBlock+$08		;charactisticsdevDeviceID_Dinfo	equ  ParBlock+$14* Volume:devName_Volume	equ  ParBlock+$02volName_Volume	equ  ParBlock+$06ParTotBlks_Volume	equ  ParBlock+$0AParFreeBlks_Volume	equ  ParBlock+$0EParFileSysID_Volume	equ  ParBlock+$12ParBlksSize_Volume	equ  ParBlock+$14* Open and CloseParRefNumber_Open	equ  ParBlock+$02		;returned RefNumberParName_Open	equ  ParBlock+$04RequestAccess_Open	equ  ParBlock+$08;* GetDirEntry:;ParPCount_GDE	equ  ParBlock;ParRefNumber_GDE	equ  ParBlock+$02		;equates for GetDirEntry parameter block;ParFlags_GDE	equ  ParBlock+$04;ParBase_GDE	equ  ParBlock+$06;ParDisplacement_GDE equ  ParBlock+$08;ParName_GDE	equ  ParBlock+$0A;ParEntryNum_GDE	equ  ParBlock+$0E;ParFileType_GDE	equ  ParBlock+$10;ParEOF_GDE	equ  ParBlock+$12;ParBlocks_GDE	equ  ParBlock+$16;ParCreateDT_GDE	equ  ParBlock+$1Ayear_GDE	equ  0		;year BYTE (current year - 1900)hours_GDE	equ  01		;hour BYTE (0-23)minutes_GDE	equ  02		;minute BYTE (0-59)second_GDE	equ  03		;seconds BYTE (0-59)weekDay_GDE	equ  04		;week day BYTE (1 = Sun, 2 = Mon, etc)month_GDE	equ  06		;month BYTE (0 = Jan, 1 = Feb, etc)day_GDE	equ  07		;day # BYTE (0 = 1st, 1 = 2nd, etc);ParModDT_GDE	equ  ParBlock+$22;ParAccess_GDE	equ  ParBlock+$2A;ParauxType_GDE	equ  ParBlock+$2C		;4 bytes. End of block is $30 bytes* GetFileInfoParPath_GFI	equ  ParBlock+$02ParAccess_GFI	equ  ParBlock+$06ParFileType_GFI	equ  ParBlock+$08ParAuxType_GFI	equ  parBlock+$0AParStorage_GFI	equ  ParBlock+$0EParCreateTD_GFI	equ  ParBlock+$10		;creation time and dateParmodTD_GFI	equ  ParBlock+$18		;mod create time and datePareof__GFI	equ  ParBlock+$24ParBlockUsed_GFI	equ  ParBlock+$28* GetPrefix & SetPrefix:ParNumber_GetPrefix	equ  ParBlock+$02		;Prefix NumberParPtr_GetPrefix	equ  ParBlock+$04ParName_Create	equ  ParBlock+$02ParAccess_Create	equ  ParBlock+$06ParType_Create	equ  ParBlock+$08ParAux_Create	equ  ParBlock+$0AParStorage_Create	equ  ParBlock+$0E** define a ProDos File Entry record*	DSect 0PDTypeLen	bytePDName	block 15	;namePDType	bytePDKeyPointer	wordPDBlocksUsed	wordPDEof	block 3PDCreateDate	wordPDCreateTime	wordPDVersion	bytePDMinVersion	bytePDAccess	bytePDAuxType	wordPDModDate	wordPDModTime	wordPDHeadPointer	word************************************************************************ Reply record formats***********************************************************************NewReplyRecord	RECORD 0Ngood	ds.w 1	;boolean return flagNfileType	ds.w 1	;file typeNauxType	ds.l 1	;file aux type infoNnameVerb	ds.w 1	;nameref verbNnameRef	ds.l 1	;name refNpathVerb	ds.w 1	;pathref VerbNpathRef	ds.l 1	;path ref	ENDROldReplyRecord	RECORD 0Ogood	ds.w 1OfileType	ds.w 1			;file typeOauxType	ds.w 1			;file aux type infoOname	ds.b 16			;the nameOPath	ds.b 129		;the full path of file in prefix 0	ENDR** ERRORS*BadVerbPrompt	equ  $1701BadVerbName	equ  $1702BadVerbDialog	equ  $1703BadVerbRRName	equ  $1704BadVerbRRPath	equ  $1705sfNotStarted	equ  $17FF