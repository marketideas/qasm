;=======================================================================;	CustomPopUp Routines for Volumes Popup;;       Copyright Apple Computer, Inc. 1989, 1990;               All Rights Reserved.;; Change History:;; 15 Feb 90	Changed the way I handle disk switch events. I now install;	myself in the GS/OS notification queue for disk switch;	events. ;	Routine PollDevices gets called from GetFilter and all it;	does is a bunch of DStatus calls on all the devices. This;	way we insure triggering a disk switch event if there is one.;	NotificationPROC is the routine that gets installed. All it;	does is set a flag that tells us a disk switch has occurred.;	I also special case the instance where an eject occurred and;	ejected disk is the current volume being displayed.;	ServiceDiskSwitch just keeps checking the disk switch flag;	and if its set handles the disk switch. It is also called ;	from GetFilter.; 07 Aug 90	Routine BuildVolumeList now sorts the volumes list alphabetically;	before calling NewList.; 15-Jan-91 Dave Lyons;	Changed the volume list member record handle to be 64*5 bytes;	instead of 20*5 bytes (fixes bug where >20 volumes hangs).; 19-Feb-91 DAL	Grew the static device table to 256 bytes (128 devices).;	Grew the volume name buffer to 36 bytes (was 35), so we can;	handle 32-character volume names.; 16-Apr-91 DAL	Changed the no-volumes AlertWindow to have sound & do a;	volume scan (push $0110 instead of 0 for flags).; 15-Sep-91 DAL	Moved InsertIntoList call for nonremovable devices to;	before the Volume call, to solve the "infinite please;	format your HFS partition" problem).; 10,13-Oct-91 DAL	Ignore Apple tape drives (device id = $20).; 29-Jan-92 DAL	Added a stz in ServiceDiskSwitch to avoid bogusly switching;	to the next device after ejecting (with HandleDiskInsert) an;	unusable disk.;;=======================================================================		string asis	blanks off			;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\;; 	Equates;;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\;y1	equ 0x1	equ y1+2y2	equ x1+2x2	equ y2+2	;===========================================================;; Global data area.;PopUpGlobals	Record;////////////////////////////////////////////////////////////////////////////////////;; GS/OS parameter blocks;DInfoPBlock	dc.W 8	; pcountDevNum	ds.W 1	; device number 	dc.L DevNameBuffer	; pointer to buffer to store device nameCharacteristics	ds.W 1	; characteristics	ds.L 1	; totalBlocks	ds.W 1	; slotNum	ds.W 1	; unitNum	ds.W 1	; versionDeviceID	ds.W 1	; deviceIDVolumePBlock	dc.W 2	; pcount	dc.L DevName	; device name (GS/OS input string)	dc.L VolNameBuffer	; pointer to buffer to store volume nameDStatusPBlock	dc.W 5	; pCountDStatDevNum	ds.W 1	; device number	dc.W 0	; status code	dc.L StatusList	; status info returned here	dc.L $00000002	; request count, no. of bytes to return	ds.L 1	; amount of info actually returnedStatusList	StatusWord	ds.W 1	; status word returned for deviceDevNameBuffer	dc.W 35	; word length countDevName	ds.B 35	; buffer to store device nameVolNameBuffer	dc.W 36	; word length count (was 35, 19-Feb-91 DAL)VolumeName	ds.B 36	; buffer to store volume nameStaticDeviceTable	ds.B 256	;table of devices not to make DStatus call on (was ds.b 128, 19-Feb-91 DAL)TickCount	ds.L 1		NumVolumes	ds.W 1	; number of volumes on-lineDeviceSwitched	ds.W 1	; Device number of device that was last switchedTypeOfSwitch	ds.W 1	; Flag that tells us whether it was insert or eject.CurrentEjected	ds.W 1	; Flag that indicates currently displayed disk was ejected.ZeroString	str '0'	ENDR		;==============================================================================;;	VolumesOnLine;; This routine just counts the number of volumes on-line. ; NumVolumes contains the number of volumes found.;;==============================================================================VolumesOnLine	PROC EXPORT	with PopUpGlobals	lda #0	First initialize our table that tracks all 	ldx #256	non-removable devices (was 128, DAL)@ZeroLoop	dex	Devices in this table are never polled for disk	dex	ejections/insertions.	bmi @Done	sta StaticDeviceTable,x	bra @ZeroLoop@Done	stz NumVolumes	This keeps track of the number of volumes found	stz DevNum	This keeps track of which device we're currently looking at.@Loop	jsr GetNextVolume	bcs @noMoreVolumes	inc NumVolumes	bra @Loop	@noMoreVolumes	rtl	ENDP	;==============================================================================;;	BuildVolumeList;; This routine goes out and finds all the volumes on-line and then puts them; in a format such that the list mgr can display them.;; Structure of StringPtr; |------------------------------------------------------------------|; |length byte | string..........| DeviceID(word) | Device Num(word) |; |------------------------------------------------------------------|;;==============================================================================BuildVolumeList	PROC EXPORT		with PopUpGlobals	_WaitCursor		;put up the watch cursor		phd		;Save original direct page	pha		;space for result	pha	PushWord #0		;System Toolset	PushWord #$0017		;Standard File Toolset	_GetWAP	pld	pla	; ----- Initialize some variables first ------------------------------------------;	stz NumVolumes		;This keeps track of the number of volumes found.	stz StringsOffset		;Keeps track of where in StringsPtr the next vol name will go.	stz DevNum		;Keeps track of which device we're currently looking at.	stzl selectedptr		;Ptr to item that is to be selected in the list.		lda FGetPutFlag	ora #InVolumeList	sta FGetPutFlag		ldax ListPointerHandle	jsr KillHandle		;Get rid of current list handle.	***	lda #100		;Get enough memory to hold 20 member records initially.*** 15-Jan-91 DAL*** Since there doesn't seem to be any code to resize this member record list beyond its initial size,*** and since Testing says it hangs if you have more than 20 devices, I changed it to handle 64 devices,*** which is all the rest of the code is prepared to deal with anyway.***	lda #64*5		;Get enough memory for 64 member records (15-Jan-91 DAL)	jsr GetZeroHandle		;A-reg contains size of handle we want.   	stax ListPointerHandle	;This routine also zeros the memory we get back.	PushAX	jsr DerefAndLock	stax ListPointerPtr;; ----- Now start building the list of volume names ------------------------------;GetNextLoop	jsr GetNextVolume		;Upon return TheVolName contains ptr volume name (GS/OS output string)	bcs @NoMoreVolumes			inc NumVolumes		;Increment counter that tells us how many volumes there are.		lda StringsOffset		;Get offset of where volume name is in StringsPtr.	sta [ListPointerPtr] 	;Store value in our list record for this member.		lda StringsPtr		;Get address of where to copy the volume name to.	ldx StringsPtr+2	clc	adc StringsOffset	bcc @noCarry1	inx@noCarry1	phx		;Destination of where converted GS/OS output string is to go.	pha	PushZLong StringsLength	;GS/OS output string that is to be converted.	jsl GSOStoPString		lda [StringsLength]		;Get length of volume name just found.	and #$00FF	clc	adc StringsOffset 		;Add to offset of where current volume was just inserted.		inc a		;Increment 1 to account for length byte.	tay	lda DeviceID		;Now store the device's ID along with its volume name.		sta [StringsPtr],y		;This is so we know which icon to draw the volume name with.	iny 	iny	lda DevNum	cmp curDev		;Find which device was last selected.	bne @notThisOne	phy		;Save the current a and y registers	pha	ldy #4	lda [ListPointerPtr],y	ora #$0080	sta [ListPointerPtr],y	pla	ply@notThisOne	sta [StringsPtr],y	iny	iny	tya	sta StringsOffset		;Offset of where to store next volume name		lda ListPointerPtr	ldx ListPointerPtr+2	clc	adc #5		;Update where in member record to store next member.	sta ListPointerPtr	bcc @noCarry2	inc ListPointerPtr+2@noCarry2	brl GetNextLoop	@noMoreVolumes	lda NumVolumes		;Store number of volumes actually found in the list record.	ldy #ListRecord.ListCount	sta [ListRecPtr],y	sta ztemp3		lda ListPointerHandle+2	pha	lda ListPointerHandle	pha	jsr DerefAndLock	stax ListPointerPtr		lda StringsHandle+2	pha	lda StringsHandle	pha	jsr DerefAndLock	stax StringsPtr		ldy #0PtrUpdateLoop	lda ztemp3	beq DoneAddrPatching		dec ztemp3	lda [ListPointerPtr],y	ldx StringsPtr+2	clc	adc StringsPtr	bcc @noCarry1	inx@noCarry1	sta [ListPointerPtr],y	iny	iny	txa	sta [ListPointerPtr],y	iny	iny	iny	brl PtrUpdateLoop	DoneAddrPatching 	ldax ListPointerPtr	stax [ListRecPtr],ListRecord.ListPtr		PushZLong DialogPtr	_SetPort		;restore port!		lda FGetPutFlag		;If not multi then we're already	and #MultiFileMode		;only allowing single selection.	beq NoMulti		PushZLong ListControl1	;Make sure only single selections	jsr DerefandLock		;are allowed when displaying the	sta pointer		;volumes list.	stx pointer+2	ldy #octlflag	lda [pointer],y	ora #$0002	sta [pointer],y	NoMulti	PushLong #CompareRoutine	PushZLong ListRecPtr	;pointer to the list	_SortList		;sort list elements	ldax ListPointerPtr	stax selectedptr	ldx NumVolumes	Loop	ldy #4	lda [selectedptr],y	and #$0080	bne GotSelected	ldy selectedptr+2	lda selectedptr	clc	adc #5	bcc @noCarry	iny@noCarry	sty selectedptr+2	sta selectedptr	dex	bne Loop	stz selectedptr	stz selectedptr+2	GotSelected	PushZLong selectedptr	PushZLong ListRecPtr	_NewList		lda selectedptr	sta lastselected	lda selectedptr+2	sta lastselected+2  	jsr doPathDraw		;Erase current "path" string and 		_InitCursor	pld		rtl		ENDP			;------------------------------------------------------------------;;	GetNextVolume; Called by AddItems until there are no more volumes. At such time; this routine will return with carry set.;;------------------------------------------------------------------GetNextVolume	PROC	with PopUpGlobalsNextDevice	inc DevNum	Bump counter to next check device.		_DInfoGS DInfoPBlock	bcc @NoError		cmp #$11	Check for "invalid device number" error. When we get this	bne @NoError	error there are no more devices to check.	brl NoMoreDevices	No more devices.@NoError	*** added 13-Oct-91 DAL -- 2nd try to ignore Apple tape drives (device id $0020)	lda DeviceID	cmp #$0020	bne @notTape	jsr InsertIntoList	;add to list of non-removable devices	bra NextDevice@notTape*** end 13-Oct-91	lda DeviceID	See if the device found is a 5.25 drive.	bne @MakeVolumeCall	If not proceed as normal.;; ----- We've got a 5.25 drive --------------------------------;*** InsertIntoList moved here from below, 29-Mar-91 DAL	jsr InsertIntoList	;5.25 drives are devices we do not poll for disk insert/eject.	lda DevNum	sta DStatDevNum	_DStatusGS DStatusPBlock		lda StatusWord	and #$0010	Is there a disk in the 5.25 drive?	beq NextDevice	If OS says there is then the drive is really on-line.	ldx #DevName		lda #^DevName	bra exitGetNext@MakeVolumeCall	*** code moved here 15-Sep-91 DAL -- mark nonremovable devices even if Volume will fail ("Infinite-format-HFS" problem)	lda DevNum	sta DStatDevNum	_DStatusGS DStatusPBlock	lda Characteristics	and #$0004	Check if this device contains removable media.	bne @ContainsRemovable			jsr InsertIntoList	Insert device into list of non-removable devices.@ContainsRemovable*** end 15-Sep-91 DAL	_VolumeGS VolumePBlock	bcs NextDevice	Got error from Volume which means there is no disk in drive.		ldx #VolumeName	Store address of volume that that is to be converted	lda #^VolumeNameexitGetNext	stx StringsLength	sta StringsLength+2	clc	rts	NoMoreDevices	sec	;set carry, to signify no more volumes	rts;------------------------------------------------------------------;;	InsertIntoList;; Inserts device into list of non-removable media devices. This is ; the list that is used to determine whether a device should be ; polled for disk switch or not. (i.e. should we make the DStatus; call on the device) Apple 5.25 drives are also included in this; list.;;------------------------------------------------------------------InsertIntoList		lda DevNum	;use device number as index into this list	asl a	tax	lda DeviceID	beq @DumbDrive		lda #$8000	;devices that are not removable have their	bra @StoreIt	;high bit set@DumbDrive	inc a	;5.25 drives are just non-zero positive entries@StoreIt	sta StaticDeviceTable,x 			rts		ENDP	;------------------------------------------------------------------;;	GSOStoPString;; Converts a GS/OS output string to a pstring.;;  IN: ptr to dest pstring:LONG	(Destination);      ptr to GSOS output string:LONG	(Source);      ; OUT: dest has been converted to a pstring;;------------------------------------------------------------------GSOStoPString	PROCi	equ 1oldDPage	equ i+2theRTL	equ oldDPage+2Source	equ theRTL+3Dest	equ Source+4	phd		pha	; make room on the stack for data	tsc	tcd	; make stack our direct page 	;; Start by getting the proper length into i and dest	lda [<source]	; its the first of the source	cmp #$0100	; is it too large?	blt @SizeOK	; size is OK	lda #$00FF	; else make it smaller@SizeOK	sta <i	; save the size...	sta [<dest]	; and save the size in our pstring	; now bump the source pointer by one so we can use the same offset all the time;	inc <source	bne @1	inc <source+2@1; now start the copy	sep #$20	longa off	; do it a byte at a time	ldy <i	; get our index@CopyLoop	lda [<source],y	; get a source byte	sta [<dest],y 	; and save it	dey	; lower the count by 1	bne @CopyLoop	; loop till zero	; Now that we are all copied clean up after ourselves and leave;	plx	; pull off extra word of data space 	pld	; restore original direct page	pla	; save the return address	ply	; NOTE: a still in short mode		plx	; get rid of the input parameters	plx	plx	plx		phy	; put return address back on the stack	pha		rep #$20	; turn a-reg back into 16-bit	longa on	lda #0	clc		rtl	ENDP;==============================================================================;;	PollDevices;; This routine just polls all devices making DStatus calls on them, trying to; trigger a disk switch event. If one occurs then GS/OS calls my routine ; NotificationPROC to handle the event.;;==============================================================================PollDevices	PROC EXPORT	with PopUpGlobals		stz DStatDevNum	;reset the device number so we can search from beginingBigLooper	inc DStatDevNum	;check next device	lda DStatDevNum	;Check our table to see if this device even needs to be 	asl a	;polled. Non-removable devices and 5.25s are not polled.	tax	lda StaticDeviceTable,x	bne BigLooper		_DStatusGS DStatusPBlock	bcc BigLooper		rtl		ENDP	;==============================================================================;;	NotificationPROC;; This is the routine that gets installed into GS/OS's notification queue. ; NumVolumes is incremented or decremented depending on the disk switch. We; save off the device number of the disk that got switched and the flag that ; tells us whether an insertion or ejection occurred.; We pay particular attention to disk ejects that occurred on the currently; displayed volume.;;==============================================================================NotificationPROC	PROC EXPORTReserved1	ds.L 1	;link to next task in queueReserved2	ds.W 1	Signature	dc.W $A55AEvent_flags	dc.L $00000018	;want disk inserts/ejectsEvent_code	ds.L 1	;curent event code will be put here by GS/OS		with PopUpGlobals		phk 	;first set the data bank correctly	plb			tay	asl a	tax	lda StaticDeviceTable,x	bne @Done		sty DeviceSwitched	;coming into this routine GS/OS sets a-reg to		;device number of device that was switched.	PushLongSpace			PushWord  #0	;system tool	PushWord  #$0017	;Standard File tool set	_GetWap	pld	;set DP to StdFile's direct page	pla	;toss upper				lda Event_Code	;save flag that tells us whether an insert or eject happened	sta TypeOfSwitch	and #$0010	bne @DiskEject		inc NumVolumes	;Disk was inserted therefore increment NumVolumes.	bra @Done@DiskEject		dec NumVolumes	;Disk was ejected therefore decrement NumVolumes.	lda DeviceSwitched	;If disk ejection occurred on the currently displayed 	cmp <curdev	;volume then we must set a flag that will force a redraw	bne @Done	;of the file list. The redraw only occurrs if there were	inc CurrentEjected	;no disk insertions after this ejection. Since the file		;list is automatically redrawn on disk insertion.@Done	rtl	ENDP	;==============================================================================;;	ServiceDiskSwitch; ; This routine is called inside GetFilter. It first checks the flag that tells; us whether or not a disk switch event has occurred.;; IN: a-reg contains StdFiles dpage.;;==============================================================================ServiceDiskSwitch	PROC EXPORT	with PopUpGlobals			phd	; save original direct page register	tcd	; a-reg contains StdFile dpage		lda TypeOfSwitch	; See if there was a disk switch event to begin with.	beq exit1		bit #$0010	; check if disk eject occurred	bne DiskEject; ; ----- Disk Insertion has occurred. ----------------------------------------------------------------	stz TypeOfSwitch	lda <curDev	pha	; Save current device on stack.	lda DeviceSwitched	; Get the device number of the disk that got the insertion.	sta <curDev	; Update stdfile's dpage var. curdev. This always contains	jsr DoDInfoCall	; the device number of the currently displayed volume.	jsr DoVolumeCall	; Make sure the disk is of a format we can read.	bcc @volCallOk	pla	sta <curDev	jsr DoDInfoCall	*** added 29-Jan-92 DAL -- avoid bumping to the next device	stz CurrentEjected	;we called DoVolumeCall with a false curDev value above!*** end 29-Jan-92	brl exit1@volCallOk	pla	; Clean up stack, get old curDev off stack.	jsr volumeOK1	; Just rescan the device and get the volume name of disk	bra UpDateList	; inserted. Once we got that redraw the directory.	;; ----- Disk Ejection has occurred. ----------------------------------------------------------------	DiskEject	stz TypeOfSwitch	lda FGetPutFlag	; Check if we're in the displaying volumes mode.	and #InVolumeList	; If we are and a disk ejection occurred just redraw	beq @notInVolList	; the volumes list.	jsl BuildVolumeList	lda NumVolumes	bne exit1	bra doAlert@notInVolList	lda CurrentEjected	; This flag is set by the NotificationPROC routine and if	beq Exit1	; non-zero it signifies that the currently displayed volume;		; just got ejected.UpDateList2	stz CurrentEjected	; Reset this flag for future use.		jsr NextDrive	; NextDrive gets the volume name for device <curDev, if the;		; volume name is the same as that in var prefixptr then we;		; bump <curDev and get the next volume name, else we;		; get redraw the list using <curDev as the device of ;		; "next" drive.	bcc UpDateListdoAlert	jsr PutUpAlert	; NumVolumes could be non-zero and we couldn't find a next;		; volume-- this occurrs if we had a 5.25" drive with no disk;		; in it and there were no other disks in any other drives.	bcc UpDateList	bcs exit	UpDateList	stz ztemp3	jsr ReDoList	; Redraw the files list with using the new volume.	exit1	clcexit	stz DeviceSwitched			pld	; Restore original direct page register.		rtl		ENDP		;================================================;;	PutUpAlert;;================================================PutUpAlert	PROC EXPORT	with PopUpGlobals	AskAgain	_InitCursor	pha	; space for result;;;	PushWord #0	; alert string is a C-String & ref is ptr	pea $0110	; force a disk scan & some sound	PushLong #0	; no substitution strings	PushLong #noVolMessage	_AlertWindow	pla	; If user selects "OK" then we poll to	bne CancelHit	_WaitCursor		ldy #0002	; Poll all devices to see if they're still empty.	lda #0	sta [PrefixPtr],y	jsr NextDrive2	bcs AskAgainReturnOK	_InitCursor	clc	rts		CancelHit	stz NumVolumes	stz curDev	sec	rts		ENDP	