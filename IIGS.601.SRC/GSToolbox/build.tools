## This command file builds all the files associated with the toolbox.# These include the Patch files, the TOOLXXX files and the printer # drivers.## If you execute this file without any parameters, only those files# that need to be re-built will be built.  If you pass the -e command,# all files will be built.## Steven Glass# 15 Oct 88### Patch Files#directory :patch:Build {parameters}Directory ::## Toolbox#directory windmgrBuildProgram {parameters} tool014directory ::menumgrBuildProgram {parameters} tool015directory ::controlmgrBuildProgram {parameters} tool016directory ::qdauxBuildProgram {parameters} tool018directory ::printmgrBuildProgram {parameters} tool019directory ::lineeditBuildProgram {parameters} tool020directory ::dialogmgrBuildProgram {parameters} tool021directory ::scrapBuildProgram {parameters} tool022directory ::stdfileBuildProgram {parameters} tool023directory ::notesynthBuildProgram {parameters} tool025directory ::noteseqBuildProgram {parameters} tool026directory ::fontmgrBuildProgram {parameters} tool027directory ::listmgrBuildProgram {parameters} tool028directory ::aceBuildProgram {parameters} tool029directory ::midi:miditools:BuildProgram {parameters} tool032directory ::drivers:apple.midi:BuildProgram {parameters} apple.mididirectory ::card6850.midiBuildProgram {parameters} card6850.mididirectory ::::resourcemgrBuildProgram {parameters} Resource.Mgrdirectory ::VideoMixBuildProgram {parameters} tool033directory ::texteditBuildProgram {parameters} tool034directory ::midisynthBuildProgram {parameters} tool035directory ::sys.resourcesBuildProgram {parameters} Sys.Resourcesdirectory ::MediaCtlTool:BuildProgram {parameters} tool038#directory ::FredWorld:#BuildProgram {parameters} tool037#directory ::Patch:Patch3:#BuildProgram {parameters} QuickerGraph#directory ::## Printer Drivers#directory ::PrinterDrivers:LWBuildProgram {parameters} LaserWriterdirectory ::New.IWBuildProgram {parameters} ImageWriterdirectory ::LQBuildProgram {parameters} ImageWriter.LQdirectory ::EpsonBuildProgram {parameters} Epsondirectory ::TabascoBuildProgram {parameters} StyleWriter# directory ::HP.DeskJet# BuildProgram {parameters} DeskJet.Plusdirectory ::PrinterBuildProgram {parameters} Printerdirectory ::ModemBuildProgram {parameters} Modemdirectory ::AppleTalkBuildProgram {parameters} AppleTalkdirectory ::GraphiCardBuildProgram {parameters} Parallel.Carddirectory ::IWEMBuildProgram {parameters} IWEMdirectory :::## ToolboxMisc stuff (FindFile, Teach, etc...,)#directory ::ToolboxMisc:FindFileGSbuildProgram {parameters} FindFiledirectory ::Teach:buildProgram {parameters} Teachdirectory ::ReadMeFiles:buildProgram {parameters} ReadMeFilesdirectory :::GSToolbox: