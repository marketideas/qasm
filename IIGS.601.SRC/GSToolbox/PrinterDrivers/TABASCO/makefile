#***********************************************************************************#                                                                                  *#		Apple IIgs Printer Driver                                                  *#                                                                                  *#		File: makefile -- Compilation and linking script                           *#                                                                                  *#		Written by Ben Koning                                                      *#		Copyright (C) 1991 Apple Computer, Inc.                                    *#                                                                                  *#***********************************************************************************#Division of files:#		readme				Delta description of this driver compared to others#		release_notes		Developmental revision history and current issues#		makefile			Compilation and linking script#		equates.h			Header file with equates and direct page definitions#		entry.a				Entry vectors, environment setup/restore, routine dispatch#		printloop.a			High level print model interface#		patchprocs.a		Patches for toolbox calls and quickdraw bottleprocs#		metrics.a			Print record access and	printer dimension calculations#		dialog.a			Dialog box and other user-interface implementation#		dialogdata.a  		Dialog box layout and text#		spool.a				Psuedo-virtual memory for PICT page definition#		imager.a			Converting pixel map to escape codes for printer#		communications.a	Serial interface to stripped-StyleWriter-serial-hardwareNAM =	StyleWriterEQU =	equates.hOBJ =	:obj:entry.o ¶		:obj:printloop.o ¶		:obj:patchprocs.o ¶		:obj:metrics.o ¶		:obj:dialog.o ¶		:obj:dialogdata.o ¶		:obj:spool.o ¶		:obj:imager.o ¶		:obj:communications.oPRN =	print -r -h -hs 12 -hf times -md -f courier -s 9{NAM} Ä {OBJ}		delete -i {NAM}		linkiigs -t $BB -at $0001 {OBJ} -o {NAM}	DEBUG Ä {OBJ}		delete -i {NAM}		linkiigs -t $BB -at $0001 {OBJ} -o {NAM}		files -n -x b {NAM}		beep 2a,4,255		duplicateiigs -m -y {NAM} :	PRINT Ä		{PRN} communications.a		{PRN} imager.a		{PRN} spool.a		{PRN} dialogdata.a		{PRN} dialog.a		{PRN} metrics.a		{PRN} patchprocs.a		{PRN} printloop.a		{PRN} entry.a		{PRN} equates.h		{PRN} makefile		{PRN} readme		{PRN} release_notes		files -l | {PRN}CLEAN Ä		delete -i {OBJ}:obj:entry.o Ä {EQU} entry.a		asmiigs	entry.a -o :obj:entry.o:obj:printloop.o Ä {EQU} printloop.a		asmiigs	printloop.a -o :obj:printloop.o:obj:patchprocs.o Ä {EQU} patchprocs.a		asmiigs	patchprocs.a -o :obj:patchprocs.o:obj:metrics.o Ä {EQU} metrics.a		asmiigs	metrics.a -o :obj:metrics.o:obj:dialog.o Ä {EQU} dialog.a		asmiigs	dialog.a -o :obj:dialog.o:obj:dialogdata.o Ä {EQU} dialogdata.a		asmiigs dialogdata.a -o :obj:dialogdata.o:obj:spool.o Ä {EQU} spool.a		asmiigs	spool.a -o :obj:spool.o:obj:imager.o Ä {EQU} imager.a		asmiigs	imager.a -o :obj:imager.o:obj:communications.o Ä {EQU} communications.a		asmiigs	communications.a -o :obj:communications.o