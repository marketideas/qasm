*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: dialogdata.a -- User-interface text strings and dialog layout              **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1991 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.h'							include		'm16.util'							include		'e16.control'							include		'e16.window'							include		'e16.dialog'DialogDataRec				record		export**STATUSWINDOWTEMP: Window template for status box:*							export		StatusWindowTempStatusWindowTemp			dc.w		StatusWindowTempEnd-StatusWindowTemp	;paramLength Word							dc.w		fAlert+fQContent+fVis					;wFrameBits Word							dc.l		0										;wTitle Pointer							dc.l		0										;wRefCon Long 							dc.w		0,0,0,0									;wZoom	Rect							dc.l		0										;wColor WindColorPtr							dc.w		0										;wYOrigin Integer							dc.w		0										;wXOrigin Integer							dc.w		200										;wDataH Word 							dc.w		640										;wDataW Word 							dc.w		200										;wMaxH Word 							dc.w		640										;wMaxW Word							dc.w		0										;wScrollVer Word							dc.w		0										;wScrollHor Word							dc.w		0										;wPageVer Word							dc.w		0										;wPageHor Word 							dc.l		0										;wInfoRefCon Long							dc.w		0										;wInfoHeight Word							dc.l		0										;wFrameDefProc Ptr							dc.l		0 										;wInfoDefProc Ptr							dc.l		0 										;wContDefProc Ptr							export		StatusWindowRect						;for extern refsStatusWindowRect			dc.w		20										;wPosition Rect Y1							export		StatusWindowCoordX1						;for 320/640 modStatusWindowCoordX1			dc.w		12										;wPosition Rect X1							dc.w		20+25									;wPosition Rect Y2							export		StatusWindowCoordX2						;for 320/640 modStatusWindowCoordX2			dc.w		308										;wPosition Rect X2							dc.l		$FFFFFFFF								;wPlane GrafPortPtr							dc.l		0										;wStorage WindRecPtrStatusWindowTempEnd:							export		StatusWindowTextY						;Y1 local text coordStatusWindowTextY			dc.w		15							export		StatusWindowEraseRect					;to clear contentsStatusWindowEraseRect		dc.w		0,0,25,296**MANFEEDALERTSTR: AlertWindow definition string for manual-feed dialog box:*							export		ManFeedAlertStr							export		ManFeedAlertStrRect							export		ManFeedAlertStrCoordX1							export		ManFeedAlertStrCoordX2ManFeedAlertStr				dc.b		'0'										;size spec: customManFeedAlertStrRect			dc.w		20										;size Y1ManFeedAlertStrCoordX1		dc.w		$FFFF									;size X1: stuffed							dc.w		200-20									;size Y2ManFeedAlertStrCoordX2		dc.w		$FFFF									;size X2: stuffed							dc.b		'3'										;icon: "Note"							dc.b		'/'										;separator							dc.b		'Please insert the next sheet when '							dc.b		'the printer stops running.  Press '							dc.b		'and release the Ready button and '							dc.b		'push the paper into the front or '							dc.b		'back paper feed slot.  Paper will '							dc.b		'feed automatically (rear slot) or '							dc.b		'upon pressing the Form Feed button '							dc.b		'(front slot).  When paper is loaded, '							dc.b		'press the Ready button so that the '							dc.b		'Ready light is on.  Envelopes must '							dc.b		'always be fed from the rear slot.'							dc.b		'/'										;separator							dc.b		'#1'									;btn "Cancel" id=0							dc.b		'/'										;separator							dc.b		'^#6'									;btn "Continue" id=1							dc.b		0										;terminator**DEVSTATALERTSTR: Device error alert box strings:  Used for printer error messages:*							export		DevStatAlertStr							;string access							export		DevStatAlertStrRect						;for set rect							export		DevStatAlertStrCoordX1					;for set rect							export		DevStatAlertStrCoordX2					;for set rect							export		DevStatAlertStrCBtn1					;for early term str							export		DevStatAlertStrCBtn2					;for set cancel<->ok							export		DevStatAlertStrCBtn3					;for set dflt okDevStatAlertStr				dc.b		'0'										;size: customDevStatAlertStrRect			dc.w		20										;size Y1DevStatAlertStrCoordX1		dc.w		$FFFF									;size X1: stuffed							dc.w		20+55									;size Y2DevStatAlertStrCoordX2		dc.w		$FFFF									;size X2: stuffed							dc.b		'2'										;icon: "Stop"							dc.b		'/'										;separator							dc.b		'*0'									;do substitutionDevStatAlertStrCBtn3		dc.b		$FF,$FF									;stuff ' /' or '/^'							dc.b		'#'										;cancel-btn id=0...DevStatAlertStrCBtn2		dc.b		$FF										;stuff '1' or '0'DevStatAlertStrCBtn1		dc.b		$FF										;stuff '/' or $00							dc.b		'^#6'									;dflt "Continue" id=1							dc.b		0										;terminator																					export		DevStatAS_NoReady						;for substitutionDevStatAS_NoReady			dc.b		'The Ready light is off.  Please '							dc.b		'press the Ready button '							dc.b		'on the printer.'							dc.b		0														export		DevStatAS_PaperOut						;for substitutionDevStatAS_PaperOut			dc.b		'The printer is out of paper.  Please '							dc.b		'refill and then press the Ready '							dc.b		'button.'							dc.b		0														export		DevStatAS_Serious						;for substitutionDevStatAS_Serious			dc.b		'A serious problem has '							dc.b		'occurred.  The print job will be '							dc.b		'terminated.'							dc.b		0**Status messages used in the status box during the progress of the printing loop:*							export		StMeMallocMesg							;during bandbuff getStMeMallocMesg				str			'Allocating imaging memory'							export		StMePrinterResetMesg					;during pr reset cmdStMePrinterResetMesg		str			'Setting up printer'							export		StMePrepRxPgDataMesg					;on out of openpageStMePrepRxPgDataMesg		str			'Ready to receive page data'							export		StMeRxCurrentPgMesg						;MUST be 30 chars!StMeRxCurrentPgMesg			str			'Receiving data for page: XXXXX'							export		StMePrCurrentPgMesg						;MUST be 30 chars!StMePrCurrentPgMesg			str			'Printing a copy of page: XXXXX'							export		StMePrCurrentCpMesg						;MUST be 30 chars!StMePrCurrentCpMesg			str			'Printing  copy  number:  XXXXX'							export		StMeRenderingMesg						;during DrawPictureStMeRenderingMesg			str			'Rendering page image'							export		StMeAbortMesg							;abort by user/callerStMeAbortMesg				str			'Cancelling print job'							export		StMeCantOpenMesg						;if can't communicateStMeCantOpenMesg			str			'Unable to establish communication'							export		StMeCantRenderGenMesg					;if DrawPict/etc errStMeCantRenderGenMesg		str			'Rendering error'							export		StMeCantRenderMemMesg					;if DrawPict/etc errStMeCantRenderMemMesg		str			'Insufficient rendering memory'**WINDOWTEMP: Window template for both of our dialogs (we just make the controls fit one size box):*							export		WindowTempWindowTemp					dc.w		WindowTempEnd-WindowTemp				;paramLength Word							dc.w		fAlert+fQContent+fVis					;wFrameBits Word							dc.l		0										;wTitle Pointer							dc.l		0										;wRefCon Long 							dc.w		0,0,0,0									;wZoom Rect							dc.l		0										;wColor WindColorPtr							dc.w		0										;wYOrigin Integer							dc.w		0										;wXOrigin Integer							dc.w		200										;wDataH Word 							dc.w		640										;wDataW Word 							dc.w		200										;wMaxH Word 							dc.w		640										;wMaxW Word							dc.w		0										;wScrollVer Word							dc.w		0										;wScrollHor Word							dc.w		0										;wPageVer Word							dc.w		0										;wPageHor Word 							dc.l		0										;wInfoRefCon Long							dc.w		0										;wInfoHeight Word							dc.l		0										;wFrameDefProc Pointer							dc.l		0 										;wInfoDefProc Pointer							dc.l		0 										;wContDefProc Pointer							dc.w		38										;wPosition Rect Y1							export		WindowCoordX1							;for 320/640 modWindowCoordX1				dc.w		12										;wPosition Rect X1							dc.w		161										;wPosition Rect Y2							export		WindowCoordX2							;for 320/640 modWindowCoordX2				dc.w		308										;wPosition Rect X2							dc.l		$FFFFFFFF								;wPlane GrafPortPtr							dc.l		0										;wStorage WindRecPtrWindowTempEnd:**Coordinates for adornment line separating title/version info from controls in the dialog boxes:*							export		WindowLineY:equ							export		WindowLineX1:equ							export		WindowLineX2:equWindowLineY					equ			14WindowLineX1				equ			7WindowLineX2				equ			287			**STYLECONTROLTEMP/JOBCONTROLTEMP: Control templates for the dialog window:*							export		StyleControlTempStyleControlTemp			dc.l		printQualityItem							dc.l		pageFeedItem							dc.l		heightCondensedItem							dc.l		heightNormalItem							dc.l		heightTitleItem							dc.l		paperTypeItem							dc.l		titleItem							dc.l		versionItem							dc.l		cancelItem							dc.l		okItem							dc.l		0							export		JobControlTempJobControlTemp				dc.l		printQualityItem							dc.l		pageFeedItem							dc.l		pagesToBoxItem							dc.l		pagesFromToSeparatorItem							dc.l		pagesFromBoxItem							dc.l		pagesRangeItem							dc.l		pagesAllItem							dc.l		pagesTitleItem							dc.l		copiesBoxItem							dc.l		copiesTitleItem							dc.l		titleItem							dc.l		versionItem							dc.l		cancelItem							dc.l		okItem							dc.l		0**Control items used by style and job dialogs; some controls are used by both:*							export		PortTitleLen							;"printername/XXX"...							export		PortTitleStr							;... set Len & Str							export		PortTitleLenOrig:equ					;... for informationtitleItem					dc.w		8										;pCount							dc.l		titleItemID								;ID							dc.w		3,6,13,258								;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		TiItStart								;TextRefPortTitleLen				dc.w		PortTitleLenOrig						;space for len byteTiItStart					dc.b		'StyleWriter / 'TiItEnd:PortTitleStr				dc.b		'XXXXXXXXXXXXXXX'						;space for portnamePortTitleLenOrig			equ			TiItEnd-TiItStart						;for computations			versionItem					dc.w		8										;pCount							dc.l		versionItemID							;ID							dc.w		3,258,13,298							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@VeTiStart								;TitleRef							dc.w		@VeTiEnd-@VeTiStart						;Use "VersionID"@VeTiStart					dc.b		'v'										;equate to							dc.b		('0'+(VersionID/256))					;generate code							dc.b		'.'										;for version							dc.b		('0'+(VersionID//256))					;string@VeTiEnd:										export		cancelItemKey1Equiv:equ							export		cancelItemKey2Equiv:equcancelItem					dc.w		9										;pCount							dc.l		cancelItemID							;ID							dc.w		104,124,104+13,124+70					;Rect							dc.l		simpleButtonControl						;ProcRef							dc.w		0										;Flags							dc.w		$3000									;MoreFlags							dc.l		0										;RefCon							dc.l		@Title									;TitleRef							dc.l		0										;ColorTableRef							dc.b		cancelItemKey1Equiv						;KeyEquiv							dc.b		cancelItemKey1Equiv						;both Key1							dc.w		0							dc.w		0@Title						str			'Cancel'cancelItemKey1Equiv			equ			27										;escape key equivcancelItemKey2Equiv			equ			'.'										;cmd-'.' key equiv										export		okItemKeyEquiv:equ							export		okItemTitlePtrLo							export		okItemTitleSetup							export		okItemTitleJobokItem						dc.w		9										;pCount							dc.l		okItemID								;ID							dc.w		104,208,104+13,208+68					;Rect							dc.l		simpleButtonControl						;ProcRef							dc.w		1										;Flags							dc.w		$3000									;MoreFlags							dc.l		0										;RefConokItemTitlePtrLo			dc.w		$FFFF									;TitleRef lookItemTitlePtrHi			dc.w		okItemTitleSetup>>16					;TitleRef hi							dc.l		0										;ColorTableRef							dc.b		okItemKeyEquiv							;KeyEquiv							dc.b		okItemKeyEquiv							dc.w		0							dc.w		0okItemTitleSetup			str			'Setup'									;butt str if PrStlDiokItemTitleJob				str			'Print'									;butt str if PrJobDiokItemKeyEquiv				equ			13										;return key equiv										paperTypeItem				dc.w		9										;pCount							dc.l		paperTypeItemID							;ID							dc.w		23,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		paperTypePopUpMenu						;MenuRef							export		paperTypeInitValuepaperTypeInitValue			dc.w		paperTypeUsaLtrItemID					;InitialValuepaperTypePopUpMenu			dc.b		'$$Paper Type:\H'							dc.w		paperTypeItemID							dc.b		0*														dc.b		'--US Letter.......8.5"x11"\H'							dc.w		paperTypeUsaLtrItemID							dc.b		0*														dc.b		'--US Legal.........8.5"x14"\H'							dc.w		paperTypeUsaLglItemID							dc.b		0*														dc.b		'---\N256D',0*														dc.b		'--European A4.......8"x12"\H'							dc.w		paperTypeEurA4ItemID							dc.b		0*														dc.b		'--European B5.......7"x10"\H'							dc.w		paperTypeEurB5ItemID							dc.b		0*														dc.b		'---\N256D',0*														dc.b		'--Envelope #10......9"x4"\H'							dc.w		paperTypeEnvNo10ItemID							dc.b		0*							dc.b		'.'			printQualityItem			dc.w		9										;pCount							dc.l		printQualityItemID						;ID							dc.w		82,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		printQualityPopUpMenu					;TitleRef							export		printQualityInitValueprintQualityInitValue		dc.w		printQualityMeResItemID					;InitialValueprintQualityPopUpMenu		dc.b		'$$Quality:\H'							dc.w		printQualityItemID							dc.b		0							dc.b		'--180 DPI (2.25x2.50)\H'							dc.w		printQualityMeResItemID							dc.b		0							dc.b		'--360 DPI (4.50x5.00)\H'							dc.w		printQualityHiResItemID							dc.b		0							dc.b		'.'heightTitleItem				dc.w		8										;pCount							dc.l		heightTitleItemID						;ID							dc.w		41,7,41+12,7+60							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize@TitleStart					dc.b		'Height:'@TitleEnd:							export		heightItemKey1Equiv:equ							export		heightItemKey2Equiv:equheightItemKey1Equiv			equ			'H'heightItemKey2Equiv			equ			'h'heightNormalItem			dc.w		8										;pCount							dc.l		heightNormalItemID						;ID							dc.w		41,99,0,0								;Rect							dc.l		radioControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		heightNormalTitle						;TitleRef							export		heightNormalInitValue			heightNormalInitValue		dc.w		0										;InitialValueheightNormalTitle			str			'Normal (Graphics)'heightCondensedItem			dc.w		8										;pCount							dc.l		heightCondensedItemID					;ID							dc.w		52,99,0,0								;Rect							dc.l		radioControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		heightCondensedTitle					;TitleRef							export		heightCondensedInitValue			heightCondensedInitValue	dc.w		0										;InitialValueheightCondensedTitle		str			'Condensed (Text)'							export		pageFeedItemKey1Equiv:equ							export		pageFeedItemKey2Equiv:equpageFeedItem				dc.w		9										;pCount							dc.l		pageFeedItemID							;ID							dc.w		66,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		pageFeedPopUpMenu						;MenuRef							export		pageFeedInitValuepageFeedInitValue			dc.w		pageFeedAutoItemID						;InitialValuepageFeedPopUpMenu			dc.b		'$$Sheet Feed:\H'							dc.w		pageFeedItemID							dc.b		0							dc.b		'--Automatic\H'							dc.w		pageFeedAutoItemID							dc.b		0							dc.b		'--Manual\H'							dc.w		pageFeedManualItemID							dc.b		0							dc.b		'.'pageFeedItemKey1Equiv		equ			'M'pageFeedItemKey2Equiv		equ			'm'pagesTitleItem				dc.w		8										;pCount							dc.l		pagesTitleItemID						;ID							dc.w		39,7,39+12,7+50							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize@TitleStart					dc.b		'Pages:'@TitleEnd:pagesAllItem				dc.w		8										;pCount							dc.l		pagesAllItemID							;ID							dc.w		38,99,38+12,99+70						;Rect							dc.l		radioControl							;ProcRef							dc.w		0										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		pagesAllTitle							;TitleRef							export		pagesAllInitValue			pagesAllInitValue			dc.w		0										;InitialValuepagesAllTitle				str			'All'pagesRangeItem				dc.w		8										;pCount							dc.l		pagesRangeItemID						;ID							dc.w		51,99,51+12,99+36						;Rect							dc.l		radioControl							;ProcRef							dc.w		0										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		pagesRangeTitle							;TitleRef							export		pagesRangeInitValuepagesRangeInitValue			dc.w		0										;InitialValuepagesRangeTitle				str			''							export		pagesFromBoxStringpagesFromBoxItem			dc.w		8										;pCount							dc.l		pagesFromBoxItemID						;ID							dc.w		50,125,50+13,125+52						;Rect							dc.l		$83000000								;PR: lineEditControl							dc.w		0										;Flags							dc.w		$7000									;MoreFlags							dc.l		0										;RefCon							dc.w		5										;MaxSize							dc.l		pagesFromBoxString						;DefaultRefpagesFromBoxString			str			'XXXXX'							export		pagesToBoxStringpagesToBoxItem				dc.w		8										;pCount							dc.l		pagesToBoxItemID						;ID							dc.w		50,205,50+13,205+52						;Rect							dc.l		$83000000								;PR: lineEditControl							dc.w		0										;Flags							dc.w		$7000									;MoreFlags							dc.l		0										;RefCon							dc.w		5										;MaxSize							dc.l		pagesToBoxString						;DefaultRefpagesToBoxString			str			'XXXXX'pagesFromToSeparatorItem	dc.w		8										;pCount							dc.l		pagesFromToSeparatorItemID				;ID							dc.w		52,183,52+12,183+50						;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize@TitleStart					dc.b		'--'@TitleEnd:copiesTitleItem				dc.w		8										;pCount							dc.l		copiesTitleItemID						;ID							dc.w		25,7,25+12,7+60							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize@TitleStart					dc.b		'Copies:'@TitleEnd:										export		copiesBoxStringcopiesBoxItem				dc.w		8										;pCount							dc.l		copiesBoxItemID						