				export		LoMeAlertBoxStringLoMeAlertBoxString			dc.b		'6'										;box size spec							dc.b		'4'										;icon: "Caution"							dc.b		'/'										;separator							dc.b		'Text and bitmapped graphics may not '							dc.b		'be rendered properly due to low '							dc.b		'memory.  Selecting 180 dpi instead '							dc.b		'of 360 dpi may produce better '							dc.b		'results.'							dc.b		'/'										;separator							dc.b		'#1'									;btn "Cancel" id=0							dc.b		'/'										;separator							dc.b		'^#0'									;btn dflt "OK" id=1							dc.b		0										;terminator							**ABBOALERTBOXSTRING: AlertWindow template string for about-box message:*							export		AbBoAlertBoxStringAbBoAlertBoxString			dc.b		'7'										;box size spec							dc.b		'3'										;icon: "Note"							dc.b		'/'										;separator							dc.b		'StyleWriter printer driver '							dc.b		'written by Ben Koning.  Tested '							dc.b		'by Bob Haven.  Thanks to '							dc.b		'Lee Collings, Dave Lyons, and '							dc.b		'Steve Stephenson.  Copyright '							dc.b		'1991 Apple Computer.'							dc.b		'/'										;separator							dc.b		'^#0'									;btn dflt "OK" id=0							dc.b		0										;terminator							endr							end