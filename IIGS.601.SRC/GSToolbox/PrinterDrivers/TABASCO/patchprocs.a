*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: patchprocs.a -- Patches/bottleprocs to enhance rendering performance       **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1991 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.h'							include		'm16.util'							include		'e16.quickdraw'							include		'm16.quickdraw'							include		'm16.qdaux'							include		'm16.font'							include		'm16.intmath'							include		'm16.memory'PatchProcsProc				proc		export**BOTTLEPROC AND TOOL PATCH ROUTINES:**The routines in this module are typically called from within toolbox calls, especially*DrawPicture.  These routines enchance the speed and functionality of the DrawPicture*rendering process.***PUTPICT/GETPICT: QD bottleprocs for spooling, called during DrawPicture:**These routines are patches to replace the standard StdPutPic and StdGetPic bottleprocs.  They*set up the limited "DPSizeParamOnly" stack frame and then call our psuedo-virtual memory*spooling routines.  This ensures that quickdraw's PICT handling routines (OpenPicture/Close-*Picture/DrawPicture/KillPicture) will almost always have enough memory.**PUTPICT: Called by quickdraw as "void PutPict (long ptr,word count)"; error->carry,A:*GETPICT: Called by quickdraw as "void GetPict (long ptr,word count)"; error->carry,A:**PUTPICT: Called with request to save an arbitrary number of bytes for PICT recording:							export		PutPictPutPict							*Save previous environment and set up our own:							phb									;save bank register on stack							phd									;save direct page register on stack							phk									;B=K so we can use abs addressing...							plb							tsc									;allocate space on stack for...							sec									;our direct page...							sbc			#DPSizeParamOnly							tcs							ina							tcd									;set D so we can use dp addressingPtStackParam				equ			1+3+1+2+DPSizeParamOnly	;1 + RTL + B + D + StackFrame							lda			PtStackParam+0,s		;count word -> ParamLongB...							sta			ParamLongB+0							stz			ParamLongB+2							lda			PtStackParam+2,s		;ptr long -> ParamLongC...							sta			ParamLongC+0							lda			PtStackParam+4,s							sta			ParamLongC+2							*Done saving environment; now do the work:							import		SpoolPut				;go spool the given chunk of bytes							jsr			SpoolPut				;leave 0 or error code in A																					*Common code to restore previous environment and exit with status currently in A in A/carry:PtGtExitStatusInA			tax									;save error code for a moment							tsc									;deallocate stack frame...							clc							adc			#DPSizeParamOnly							tcs							pld									;restore direct reg off stack							plb									;restore bank reg off stack							lda			0,s						;move the RTL up, cleaning the...							sta			6,s						;six input param bytes off...							lda			2,s							sta			8,s							tsc									;now add 6 to S to move it up...							clc									;can't do above since B/D on stack							adc			#6							tcs							txa									;get error in ACC/Carry							cmp			#1							rtl									;exit back to caller in QD																					*GETPICT: Called with request to retrieve an arbitrary number of bytes for PICT playback:							export		GetPictGetPict							*Save previous environment and set up our own:							phb									;save bank register on stack							phd									;save direct page register on stack							phk									;B=K so we can use abs addressing...							plb							tsc									;allocate space on stack for...							sec									;our direct page...							sbc			#DPSizeParamOnly							tcs							ina							tcd									;set D so we can use dp addressingGtStackParam				equ			1+3+1+2+DPSizeParamOnly	;1 + RTL + B + D + StackFrame							lda			GtStackParam+0,s		;count word -> ParamLongB...							sta			ParamLongB+0							stz			ParamLongB+2							lda			GtStackParam+2,s		;ptr long -> ParamLongC...							sta			ParamLongC+0							lda			GtStackParam+4,s							sta			ParamLongC+2*Done saving environment; now do the work:							import		SpoolGet				;get data from spool							jsr			SpoolGet							cmp			#$FFFF					;if 0 or error, pass it to QD							bne			PtGtExitStatusInA		;else convert "-1" (end of spool)							lda			#$1210					;to "$1210" (end of PICT)							bra			PtGtExitStatusInA**PUTPIXELS: Patched-in QuickDraw BottleProc, called during DrawPicture:**This routine is patched in a replacement for the QuickDraw StdPixels bottleproc, and*is called by QuickDraw during DrawPicture execution.  This routine makes 640-mode bitmaps*look nonfuzzy even though they are being scaled by 4.5x in the horizontal direction.**If we are in 320-mode, or if we're in low-quality printing mode, or if a bit is set to*disable this routine, or if there we can't get enough memory, or if coordinates are*reversed, then this routine calls the real-StdPixels routine and exits.  This has the*same effect as if this patch didn't exist.**Pixelmaps that are scaled horizontally by StdPixels (CopyPixels, DrawPicture, etc) to*anything other than a 1:1 ratio normally have gray fuzzies around where there used to*be sharp boundaries between black and white.  This is because 640-mode bitmaps are almost*always dithered, and in order to maintain the high frequency dither relationship between*adjacent pixels, groups of two pixels are scaled as a unit (4 bits at a time, which also*makes it convenient for the normal StdPixels since the same code runs unmodified for 320*mode, where it doesn't cause any such artifacts).  Thus if a black pixels is right next*to a white pixel, and the group is scaled by, say, 2x, instead of getting black-black-*white-white, the normal StdPixels produces black-white-black-white.  StdPixels has no*way of knowing if the black pixel next to the white pixels was really fine graphics detail*to be maintained while scaling, or if it was part of a 50% gray pattern.**This routine alleviates this problem, although at the expense of halftone smoothness,*by ensuring that the horizontal part of pixelmap scaling is performed one pixel at a*time, instead of two at a time.  This is done by doing the horizontal scaling here, thus*producing an interim pixelmap, and then calling the real StdPixels to do the vertical*scaling, handling of transfer modes, clipping, etc, and actually drawing the result to*the destination (which is the printer driver's banding buffer).**Since there usually is not enough memory to ask for an entire interim buffer to hold*the pre-horizontally-scaled pixels, we are forced to do it a slice at a time.  This*is referred to as banding.  The banding that is performed here should not be confused*with the banding that is already going on in the higher level of the printer driver.**Since we're banding vertically, a speed improvement is possible where we check the*current StdPixels-band against the current rendering (DrawPicture) - band.  If the*current StdPixels-band does not fall within the current rendering-band, then no*buffer clearing, prescaling, or real-StdPixels calling is done.  This saves time.**In the code comments below, the acronym "src" refers to locinfos, rects, and pixel*buffers related to the source, or input, of the complete StdPixels request.  "Int"*refers to the interim buffer of pre-4.5x-X-scaled pixels that we generate here, and*"dst" refers to the destination, or output, of the complete StdPixels request.**Since we're banding vertically, and since the PICT definition may demand any vertical*scaling factor, we need to know what the Y scaling factor is so that we can correctly*scale slices as we repeatedly call the real StdPixels (If the bitmap would always be*recorded at 1x, so as to be played back by the printer driver's DrawPicture at 5x, we*could have just hardcoded 5x, but that may not always be the case).**Horizontally, we don't need to worry about what the ratio of source to destination delta*X is because we're not banding horizontally, and since we leave the given horizontal*destination coordinates alone but pass horizontal source coordinates which are already*scaled by 4.5x (since they point to the interim buffer), any additional X scaling will*be performed by the real StdPixels.*							export		PutPixelsPutPixels							*Entry point that sets up our B after saving QD's B for later context switching:PuPiEntry					phb											;QD's B setting to our var							phb							pullword	>PuPiQDBank														phk											;point B setting to us							plb							*Set up the call address to the real QD StdPixels routine for later use:							import		OpDoOldPlyQDProcs				;setup JSL address below							lda 		OpDoOldPlyQDProcs+ostdPixels+0							ina							sta			PuPiCallQDStdPixelsJsl+1+0							lda			OpDoOldPlyQDProcs+ostdPixels+2							shortm							sta			PuPiCallQDStdPixelsJsl+1+2							longm							*If (disable flag set) OR (low quality) OR (320 mode), do normal StdPixels execution, else continue:							import		OpDoIs640PixMapDisable							import		OpDoIsQualityHigh							lda			OpDoIs640PixMapDisable			;bypass if disable flag set							bne			PuPiDoBypass							lda			OpDoIsQualityHigh				;bypass if not high quality							beq			PuPiDoBypass							lda			QDDestLocInfoDPLoc+oportSCB							and			#$0080							;bypass if not 640 mode							bne			PuPiDontBypass							*Entry point for doing pixels the normal way using standard QD code and exiting:PuPiDoBypass				jsr			PuPiCallQDStdPixels		;behave just like as if this							brl			PuPiExit				;patch did not occur							*Entry point for if we are really going to attempt to handle the pixels ourselves:PuPiDontBypass							*Get rect info in useful form and copy to our local static variables; we may still give up:							sec									;calc source rect's y length: y2-y1							lda			QDSrcRectDPLoc+ov2							sbc			QDSrcRectDPLoc+ov1							bmi			PuPiDoBypass			;if negative or zero, give up							beq			PuPiDoBypass							sta			PuPiSrcNumLinesY		;store num lines in our static var														sec									;calc source y starting address							lda			QDSrcRectDPLoc+ov1							sbc			QDSrcLocInfoDPLoc+oboundsRect+ov1							phx							phx							pha							pushword	QDSrcLocInfoDPLoc+owidth							_Multiply							clc							pla							adc			QDSrcLocInfoDPLoc+optrToPixImage+0							sta			PuPiSrcPtr+0							pla							adc			QDSrcLocInfoDPLoc+optrToPixImage+2							sta			PuPiSrcPtr+2														sec									;calc source x starting coordinate							lda			QDSrcRectDPLoc+oh1							sbc			QDSrcLocInfoDPLoc+oboundsRect+oh1							sta			PuPiSrcStartingX														sec									;calc source rect's x length: x2-x1							lda			QDSrcRectDPLoc+oh2							sbc			QDSrcRectDPLoc+oh1							bmi			PuPiDoBypass			;if negative or zero, give up							beq			PuPiDoBypass							sta			PuPiSrcNumPixX			;store num pix in static var														lda			QDSrcLocInfoDPLoc+owidth							sta			PuPiSrcLineWidthX		;store bytes/line in static														sec									;calc dest rect's y length: y2-y1							lda			QDDestRectDPLoc+ov2							sbc			QDDestRectDPLoc+ov1							bmi			PuPiDoBypass			;if negative or zero, give up							beq			PuPiDoBypass							sta			PuPiDstNumLinesY		;store num lines in our static var							*Attempt to allocate memory for our intermediate pixel buffer; give up if unable:							pha									;multiply num source bytes/line							pha									;times num source lines to do							pushword	PuPiSrcLineWidthX		;pass space.L + num bytes.W in A							lda			#PixMap640IntBuffTall+1	;pass #lines/band (+1 to leave slack)							ina									;so we can overrun buffer a little							pha							_Multiply							plx									;get result.L lo/hi in X/Y							ply														jsr			PuTeMulLongInXYBy9		;multiply long in X/Y by 4.5							jsr			PuTeDivLongInXYBy2		;now have size of mem needed in X/Y														pha									;pass result space							pha									;pass result space							phy									;pass size of block wanted hi							phx									;pass size of block wanted lo							import		OpDoMemPID				;pass our PID							pushword	OpDoMemPID							pushword	#$C000					;pass attributes: locked/fixed							pha									;pass dummy location							pha							_NewHandle							pla									;get handle, valid only if no error							sta			PuPiIntPixMapHdl+0		;preserving carry flag for a moment							pla							sta			PuPiIntPixMapHdl+2							bcc			PuPiMallocDone							brl			PuPiDoBypass			;didn't get memory, so give upPuPiMallocDone							*Calculate vertical scale (dst/src delta Y) used when calculating coordinates for StdPixels:							pha							pha							pushword	PuPiDstNumLinesY		;pass numerator							pushword	PuPiSrcNumLinesY		;pass denominator							_FixRatio							pulllong	PuPiSrcToDstScaleY		;result as long: mantissa,fraction							*Init "dst" Y1 position which will move down a bit at the completion of each band:							lda			QDDestRectDPLoc+ov1							sta			PuPiDstBandY1							*Save QD direct page for context switching and final restore:							tdc							sta			PuPiQDDirectPage							*Allocate memory for our own direct page on stack, but don't switch direct page context yet:							tsc							sec							sbc			#PuPiOurDPSize							tcs							ina							sta			PuPiOurDirectPage							*Switch in our own direct page; NOTE: now cannot access QD direct page variables:							lda			PuPiOurDirectPage							tcd							*Set up the unpreset fields of our "int" locinfo struct that we will scale into:							lda			PuPiIntPixMapHdl+0		;deref pix memory hdl->ptr and store							sta			<0						;abuse some of our D page for this							lda			PuPiIntPixMapHdl+2							sta			<2							lda			[0]							sta			PuPiIntLocInfoPtr+0							ldy			#2							lda			[0],y							sta			PuPiIntLocInfoPtr+2														ldx			PuPiSrcLineWidthX		;get number of bytes in a src line							ldy			#0							jsr			PuTeMulLongInXYBy9		;multiply long in X/Y by 4.5							jsr			PuTeDivLongInXYBy2							stx			PuPiIntLocInfoWidth														ldx			PuPiSrcNumPixX			;use our calc coord sizes							ldy			#0						;since our interim pixmap will							jsr			PuTeMulLongInXYBy9		;have origin of (0,0)							jsr			PuTeDivLongInXYBy2		;interim X = source X * 4.5							stx			PuPiIntLocInfoRect+oh2							*Set "src" and "int" vertical indexes to initial values:							lda			PuPiSrcPtr+0			;set src line base to initial value							sta			<PuPiDPsrcptr+0							lda			PuPiSrcPtr+2							sta			<PuPiDPsrcptr+2														lda			PuPiIntLocInfoPtr+0		;set int line base to initial value							sta			<PuPiDPintptr+0							lda			PuPiIntLocInfoPtr+2							sta			<PuPiDPintptr+2														lda			PuPiSrcNumLinesY		;set src line count to initial value							sta			<PuPiDPsrclinecount							*Head of loop in which each iteration completes a slice of the entire StdPixels request:PuPiLoop_onemoreband							*Zero the number-of-lines-processed count that tells us when to finish current and start a new band:							stz			PuPiNumLinesInBand							**Decide whether to do time-saving censoring of our-band processing:**This section will set or clear the "PuPiIsCensoring" static local variable, depending on*whether or not the current band-slice of the greater total StdPixels request falls within*the current DrawPicture rendering-band that is being asked for by the printloop code.  If*the variable is set to "1", then the code below will circumvent time-costly operations,*while keeping critical counters running.**We do signed compares to see if any part of the pixel-enclosing rectangle intersects band buffer.*We will censor pixels if this is TRUE: [(py1<by1)  &&  (py2<by1)]  ||  [(py1>by2)  &&  (py2>by2)],*where "py" refers to pixel-enclosing rectangle's Y and "by" refers to printloop-band buffer*rectangle's Y.**Stated differently, we have:  Do censor if [(1) && (2)] || [(3) && (4)], where:**			(1) Is pixel start above top edge of band buffer?*			(2) Is pixel finish (also) above top edge of band buffer?*			(3) Is pixel start below bottom edge of band buffer?*			(4) Is pixel finish (also) below bottom edge of band buffer?**These numbers (1)..(4) are referred to in the labels in the following section.*														import		OpDoLocInfoRect			;need to compare to rendering-band							stz			PuPiIsCensoring			;intially zero this flag														pha									;calculate height of this band as							pha									;vertical scale factor * num lines							pushword	#PixMap640IntBuffTall	;pass hi word num lines X1 as fixed							pushword	#0						;pass lo word num lines X1 as fixed							pushlong	PuPiSrcToDstScaleY		;pass delta y dst/src							_FixMul							plx									;ignore result lo (fraction)							pla									;get result hi (mantissa)							sta			PuPiBandMulScaleY							PuPiCmp1					lda			PuPiDstBandY1			;doing signed compare (1)							sec									;band start above top/render-band?							sbc			OpDoLocInfoRect+ov1							beq			PuPiCmp1IsFalse			;if equal, then result is false							bvs			PuPiCmp1Inv				;if overflow, invert compare result							bmi			PuPiCmp1IsTrue							bra			PuPiCmp1IsFalsePuPiCmp1Inv					bmi			PuPiCmp1IsFalsePuPiCmp1IsTrue							PuPiCmp2					lda			PuPiDstBandY1			;doing signed compare (2)							clc							adc			PuPiBandMulScaleY		;assume band y2 of y1 + height*scale							sec									;band end above top/render-band?							sbc			OpDoLocInfoRect+ov1							beq			PuPiCmp2IsFalse			;if equal, then result is false							bvs			PuPiCmp2Inv				;if overflow, invert compare result							bmi			PuPiCmp2IsTrue							bra			PuPiCmp2IsFalsePuPiCmp2Inv					bmi			PuPiCmp2IsFalsePuPiCmp2IsTrue														bra			PuPiCensor				;both (1) and (2) true, so censor						PuPiCmp1IsFalse													;if either (1) or (2) was false,PuPiCmp2IsFalse													;then go on to compares (3),(4)							PuPiCmp3					lda			PuPiDstBandY1			;doing signed compare (3)							sec									;band start below bottom/render-band?							sbc			OpDoLocInfoRect+ov2							beq			PuPiCmp3IsFalse			;if equal, then result is false							bvs			PuPiCmp3Inv				;if overflow, invert compare result							bpl			PuPiCmp3IsTrue							bra			PuPiCmp3IsFalsePuPiCmp3Inv					bpl			PuPiCmp3IsFalsePuPiCmp3IsTrue							PuPiCmp4					lda			PuPiDstBandY1			;doing signed compare (4)							clc							adc			PuPiBandMulScaleY		;assume band y2 of y1 + height*scale							sec									;band end below bottom/render-band?							sbc			OpDoLocInfoRect+ov2							beq			PuPiCmp4IsFalse			;if equal, then result is false							bvs			PuPiCmp4Inv				;if overflow, invert compare result							bpl			PuPiCmp4IsTrue							bra			PuPiCmp4IsFalsePuPiCmp4Inv					bpl			PuPiCmp4IsFalsePuPiCmp4IsTrue														bra			PuPiCensor				;both (3) and (4) true, so censor							PuPiCmp3IsFalse													;if either (3) or (4) was false,PuPiCmp4IsFalse				bra			PuPiDontCensor			;and we're here, don't censor							PuPiCensor					inc			PuPiIsCensoring			;set flag to "1" if yes, else "0"PuPiDontCensor							*Pre-clear our interim locinfo's pixel buffer to zeros to prepare for drawing into it by OR-ing:							lda			PuPiIsCensoring			;skip if possible							bne			PuPiPreClearDonePuPiPreClearCantCensor							lda			PuPiIntLocInfoPtr+0		;setup our dp loc to be pointer							sta			<PuPiDPclearptr+0							lda			PuPiIntLocInfoPtr+2							sta			<PuPiDPclearptr+2							ldx			#0						;X is vertical line countPuPiPreClearBfLoop			lda			#0						;zero A for storing 2 bytes/iteration							ldy			#0						;Y is horizontal byte countPuPiPreClearLnLoop			sta			[PuPiDPclearptr],y							iny							iny							cpy			PuPiIntLocInfoWidth		;loop until one row is done							bcc			PuPiPreClearLnLoop							clc									;add row size (bytes) to ptr							lda			<PuPiDPclearptr+0							adc			PuPiIntLocInfoWidth							sta			<PuPiDPclearptr+0							lda			<PuPiDPclearptr+2							adc			#0							sta			<PuPiDPclearptr+2							inx							cpx			#PixMap640IntBuffTall	;loop until all lines are done							bne			PuPiPreClearBfLoopPuPiPreClearDone							*Head of loop in which each iteration processes a complete "src" line into an "int" line:PuPiLoop_onemoreline							*Try to skip around line processing code:							lda			PuPiIsCensoring							beq			PuPiSrcToIntCantCensor							brl			PuPiNextYPuPiSrcToIntCantCensor							*Set up byte and twit (640-mode 2-bit pixel) starting positions:							lda			PuPiSrcStartingX		;setup "src" byte/twit posn							tax							lsr a							lsr a							sta			<PuPiDPsrcbyteposn		;byte posn = X div 4							txa							and			#%11							asl a							asl a							asl a							sta			<PuPiDPsrctwitposnX8	;twit posn * 8 = (X mod 4) * 8														stz			<PuPiDPintbyteposn		;setup "int" byte/twit posn to 0							stz			<PuPiDPinttwitposnX16							*Set up src twit countdown to do an entire line of source pixels:							lda			PuPiSrcNumPixX							sta			<PuPiDPsrctwitcount							*Head of loop; each iter copies one source ("src") pixel ("twit") into 4.5 interim ("int") pixelmap:PuPiLoop_doingaline							*Get a word-full of src twits (8 of them) in X:							ldy			<PuPiDPsrcbyteposn							lda			[PuPiDPsrcptr],y							tax							*Get src twit 0..7 * 8 in Y and alternatively branch to 4x or 5x case, thus having effect of 4.5:							ldy			<PuPiDPsrctwitposnX8							tya							and			#%1000							bne			PuPiStretchSrcTwitBy5							*Here if we are about copy a src twit and deposit 4 copies of it in dst pixelmap:PuPiStretchSrcTwitBy4							*Isolate and identify pixel from source word, and branch to the case for that pixel:							txa							and			PuPiSrcLookupMask,y							beq			PuPiIts4x00							cmp			PuPiSrcLookupIs01,y							beq			PuPiIts4x01							cmp			PuPiSrcLookupIs10,y							beq			PuPiIts4x10*Case to store 4 copies of pixel "11" into our interim pixelmap:PuPiIts4x11					ldx			<PuPiDPinttwitposnX16							ldy			<PuPiDPintbyteposn							lda			PuPiH4xLookupIs11,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							inx							inx							iny							iny							lda			PuPiH4xLookupIs11,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							bra			PuPiDoneThe4x							*Case to store 4 copies of pixel "10" into our interim pixelmap:PuPiIts4x10					ldx			<PuPiDPinttwitposnX16							ldy			<PuPiDPintbyteposn							lda			PuPiH4xLookupIs10,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							inx							inx							iny							iny							lda			PuPiH4xLookupIs10,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							bra			PuPiDoneThe4x							*Case to store 4 copies of pixel "01" into our interim pixelmap:PuPiIts4x01					ldx			<PuPiDPinttwitposnX16							ldy			<PuPiDPintbyteposn							lda			PuPiH4xLookupIs01,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							inx							inx							iny							iny							lda			PuPiH4xLookupIs01,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							bra			PuPiDoneThe4x							*Case to store 4 copies of pixel "00" into our interim pixelmap:PuPiIts4x00					ldx			<PuPiDPinttwitposnX16							inx							inx							*Here if done adding 4 twits to int; enter with int-twit-posn + 2 in X:PuPiDoneThe4x							*Advance the int twit position by 4 pixels:							txa									;4 pixels, the posn is maintained							clc									;as 16x, minus 2 because int-twit-							adc			#62						;posn is given as +2: (4*16)-2=62							bra			PuPiAdvanceTwitCounts							*Here if we are about copy a src twit and deposit 5 copies of it in dst pixelmap:PuPiStretchSrcTwitBy5							*Isolate and identify pixel from source word, and branch to the case for that pixel:							txa							and			PuPiSrcLookupMask,y							beq			PuPiIts5x00							cmp			PuPiSrcLookupIs01,y							beq			PuPiIts5x01							cmp			PuPiSrcLookupIs10,y							beq			PuPiIts5x10*Case to store 5 copies of pixel "11" into our interim pixelmap:PuPiIts5x11					ldx			<PuPiDPinttwitposnX16							ldy			<PuPiDPintbyteposn							lda			PuPiH5xLookupIs11,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							inx							inx							iny							iny							lda			PuPiH5xLookupIs11,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							bra			PuPiDoneThe5x							*Case to store 5 copies of pixel "10" into our interim pixelmap:PuPiIts5x10					ldx			<PuPiDPinttwitposnX16							ldy			<PuPiDPintbyteposn							lda			PuPiH5xLookupIs10,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							inx							inx							iny							iny							lda			PuPiH5xLookupIs10,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							bra			PuPiDoneThe5x							*Case to store 5 copies of pixel "01" into our interim pixelmap:PuPiIts5x01					ldx			<PuPiDPinttwitposnX16							ldy			<PuPiDPintbyteposn							lda			PuPiH5xLookupIs01,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							inx							inx							iny							iny							lda			PuPiH5xLookupIs01,x							ora			[PuPiDPintptr],y							sta			[PuPiDPintptr],y							bra			PuPiDoneThe5x							*Case to store 5 copies of pixel "00" into our interim pixelmap:PuPiIts5x00					ldx			<PuPiDPinttwitposnX16							inx							inx							*Here if done adding 5 twits to int; enter with int-twit-posn + 2 in X:PuPiDoneThe5x							*Advance the int twit position by 5 pixels:							txa									;5 pixels, the posn is maintained							clc									;as 16x, minus 2 because int-twit-							adc			#78						;posn is given as +2: (5*16)-2=78							*Here if done adding 4 or 5 pixels to int; enter with advanced int twit posn in A:PuPiAdvanceTwitCounts							*Store advanced int twit position, while handling overflow into int byte position:PuPiAdvanceInt				sta			<PuPiDPinttwitposnX16	;store first, if overflow or not							cmp			#128					;8 twit posns/word * 16x = 128							bcc			PuPiAdvanceIntNoV							and			#%01111111				;if overflow, do mod 128							sta			<PuPiDPinttwitposnX16	;and store again							inc			<PuPiDPintbyteposn		;and increment to next word							inc			<PuPiDPintbyteposnPuPiAdvanceIntNoV							*Advance to next src twit position, while handling overflow into src byte position:PuPiAdvanceSrc				lda			<PuPiDPsrctwitposnX8	;add 1*8 = 8 because position is							clc									;maintained as 8x							adc			#8							cmp			#64						;overflow if 8 twits/word * 8x = 64							bne			PuPiAdvanceSrcNoV							lda			#0						;overflow always aligned							inc			<PuPiDPsrcbyteposn		;increment to next word							inc			<PuPiDPsrcbyteposnPuPiAdvanceSrcNoV			sta			<PuPiDPsrctwitposnX8							*Loop back to handle all src pixels within a line:							dec			<PuPiDPsrctwitcount		;dec countdown counter and loop							beq			PuPiOutOfXLoop							brl			PuPiLoop_doingalinePuPiOutOfXLoop							*Here if done doing an entire line:PuPiNextY							*Advance src and int base addresses to point to their next lines:							clc									;bump src base ptr to next line							lda			<PuPiDPsrcptr+0							adc			PuPiSrcLineWidthX							sta			<PuPiDPsrcptr+0							lda			<PuPiDPsrcptr+2							adc			#0							sta			<PuPiDPsrcptr+2														clc									;bump int base ptr to next line							lda			<PuPiDPintptr+0							adc			PuPiIntLocInfoWidth							sta			<PuPiDPintptr+0							lda			<PuPiDPintptr+2							adc			#0							sta			<PuPiDPintptr+2							*Increment number of lines actually completed into interim pixelmap, used for later StdPixels call:							inc			PuPiNumLinesInBand							*If we are done with all raster lines in src pixelmap, break out of vertical loop:							dec			<PuPiDPsrclinecount		;decrement number of total src							beq			PuPiOutOfYLoop			;lines we have to do, exit if done							*Else, check to see if it's time yet to output a band:							lda			PuPiNumLinesInBand		;time to do a band?							cmp			#PixMap640IntBuffTall	;do one every so many finished lines							beq			PuPiOutputOneBand							*If not time to output a band, loop back to create another line in interim pixelmap:							brl			PuPiLoop_onemoreline							*Here if interim pixelmap full and it's time to draw the band and continue:PuPiOutputOneBand							*Pass the interim pixelmap as input to StdPixels and thus draw a slice of the StdPixels request:							lda			#PixMap640IntBuffTall							jsr			PuPiDrawStdPixelsBand							*Reset interim line base address back to top of band (of course src line base keeps going):							lda			PuPiIntLocInfoPtr+0							sta			<PuPiDPintptr+0							lda			PuPiIntLocInfoPtr+2							sta			<PuPiDPintptr+2							*Loop back to prepare to do another band slice of the entire StdPixels request:							brl			PuPiLoop_onemoreband							*Here if done with all lines; may still have to do a partial band (esp if request < band tallness):PuPiOutOfYLoop							*Do the remaining number of lines left to do, if any:							lda			PuPiNumLinesInBand		;could be zero							jsr			PuPiDrawStdPixelsBand							*Switch in QD's DP again because we're about to exit:							lda			PuPiQDDirectPage							tcd							*Deallocate our direct page space from stack, now we can't switch ours in anymore:							tsc							clc							adc			#PuPiOurDPSize							tcs							*Deallocate the temporary interim pixel map memory which we scaled into and passed to StdPixels:							pushlong	PuPiIntPixMapHdl							_DisposeHandle							*Exclusive exit point from this routine which restores QD bank and exits with no error:PuPiExit					pushword	PuPiQDBank							plb							plb							lda			#0							clc							rtl*Subroutine that calls the real QuickDraw StdPixels code (address must be set up already):PuPiCallQDStdPixels			pushword	PuPiQDBank				;switch in QuickDraw's B setting							plb							plb							lda			#0						;indicate no error status							clcPuPiCallQDStdPixelsJsl		jsl			>$FFFFFF				;NOTE: operand is stuffed							phk									;switch in our B setting again							plb							rts									;return to caller*Subroutine that calls StdPixels to do a certain number of lines: Pass num lines to do -> A:PuPiDrawStdPixelsBand		cmp			#0						;if zero, don't do anything							bne			PuPiDSPBnot0request							rtsPuPiDSPBnot0request							*Put number of lines (still in A) we're advancing in int and src buffers in local static vars:							sta			PuPiDSPBnumlines		;this is how far we move down int														phx							phx							pha									;pass hi num lines X1 as fixed							pushword	#0						;pass lo num lines X1 as fixed							pushlong	PuPiSrcToDstScaleY		;pass vertical scale factor							_FixMul							plx									;ignore lo result (fraction)							pla									;get hi result (mantissa)														sta			PuPiDSPBnumlinesScaled	;this is how far we move down dst							*Switch in QD direct page, now we can use QD dp vars but CANNOT use our direct page vars:							lda			PuPiQDDirectPage							tcd							*Set StdPixels source locinfo input to our interim locinfo (ours will now be the source):							pushlong	#PuPiIntLocInfo			;pass source							pushword	#0						;pass dest hi word: dp, so bank 0							tdc									;pass dest lo word: dp+qd dp loc							clc							adc			#QDSrcLocInfoDPLoc							pha							pushlong	#16						;pass count							_BlockMove							;copy new source locinfo in QD vars							*Leave StdPixels destination locinfo input alone; that's where output of all bands goes:							*Set StdPixels source rect input X to our interim locinfo's X dimensions:							stz			QDSrcRectDPLoc+oh1		;X1 for our int buffer is always 0							lda			PuPiIntLocInfoRect+oh2	;X2 for our int buffer is orig*4.5							sta			QDSrcRectDPLoc+oh2							*Set StdPixels source rect input Y to number of lines we have to do for this band:							stz			QDSrcRectDPLoc+ov1		;Y1 for our int buffer is always 0							lda			PuPiDSPBnumlines		;Y2 is the num lines we're doing							sta			QDSrcRectDPLoc+ov2		;in this particular band							*Leave StdPixels destination rect input X alone:							*Set StdPixels destination rect input Y for the current band slice we're doing:							lda			PuPiDstBandY1			;how far down we're in the banding							sta			QDDestRectDPLoc+ov1		;will be the dest rect Y1, and							clc									;Y2 will be Y1 plus number of Std-							adc			PuPiDSPBnumlinesScaled	;Pixels-source lines times Y scaling							sta			QDDestRectDPLoc+ov2														sta			PuPiDstBandY1			;update band Y1 for next time							*Call the real StdPixels code to do vertical scaling, clipping, transfer modes, etc:							ldx			PuPiIsCensoring			;skip this if we can, since it							bne			PuPiDSPBskipstdpixels	;takes a long time							jsr			PuPiCallQDStdPixelsPuPiDSPBskipstdpixels							*Switch back to our direct page; now ok to use our direct page vars again but can't use QD vars:							lda			PuPiOurDirectPage							tcd							*Exit to caller:							rts							*Static variables used by this subroutine:PuPiDSPBnumlines			dc.w		0PuPiDSPBnumlinesScaled		dc.w		0*Local direct page usage; can ONLY be accessed while in scope of our own direct page:PuPiDPsrcptr				equ			0						;addr of start of a src linePuPiDPintptr				equ			4						;addr of start of a int linePuPiDPsrctwitposnX8			equ			8						;src twit tbl index: 0,8,16,...,56PuPiDPinttwitposnX16		equ			10						;int twit tbl index: 0,16,32,...,112PuPiDPsrcbyteposn			equ			12						;byte within a src linePuPiDPintbyteposn			equ			14						;byte within a int linePuPiDPsrctwitcount			equ			16						;horizontal source pixel counterPuPiDPsrclinecount			equ			18						;vertical source line counterPuPiDPclearptr				equ			20						;addr used to clear pixel bufferPuPiOurDPSize				equ			24						;number of bytes of this DP space*Static variables used; can be accessed while in scope of either our or QD direct page:PuPiQDBank					dc.w		0						;saved B register from QuickDrawPuPiQDDirectPage			dc.w		0						;saved D register from QuickDrawPuPiOurDirectPage			dc.w		0						;our D space allocated on stackPuPiSrcPtr					dc.l		0						;normalized address of first linePuPiSrcNumLinesY			dc.w		0						;number of lines in source rectPuPiSrcStartingX			dc.w		0						;normalized coordinate of first pixPuPiSrcNumPixX				dc.w		0						;number of pix/line in source rectPuPiDstNumLinesY			dc.w		0						;number of lines in dest rectPuPiSrcLineWidthX			dc.w		0						;number of bytes/line in sourcePuPiIntPixMapHdl			dc.l		0						;handle to pixel map memory we needPuPiDstBandY1				dc.w		0						;y1 of dest rect for current bandPuPiNumLinesInBand			dc.w		0						;lines processed into int buff so farPuPiSrcToDstScaleY			dc.l		0						;dst/src delta y in fixed formatPuPiBandMulScaleY			dc.w		0						;band height * (dst/src dy scale)PuPiIsCensoring				dc.w		0						;set if can censor current band*Our LocInfo into which we do our horizontal scaling and becomes the new source for CopyPixels:PuPiIntLocInfoPuPiIntLocInfoSCB			dc.w		$0080					;mode: 640 alwaysPuPiIntLocInfoPtr			dc.l		$FFFFFFFF				;pointer to pixel map: stuffedPuPiIntLocInfoWidth			dc.w		$FFFF					;bytes/horiz line: stuffedPuPiIntLocInfoRect			dc.w		0,0						;ref coords: X1/Y1 both zeros							dc.w		PixMap640IntBuffTall	;Y2: fixed to tallness of buffer							dc.w		$FFFF					;X2: stuffed to 4.5x of src X size*Lookup table for isolating a pixel out of a word of source pixels without masking and shifting:PuPiSrcLookupPuPiSrcLookupMask			equ			*+0PuPiSrcLookupIs01			equ			*+2PuPiSrcLookupIs10			equ			*+4PuPiSrcLookupIs11			equ			*+6							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn0Mask	dc.b		%11000000,%00000000		;source mask to isolate pixelPuPiSrcLookupPixPosn0Is01	dc.b		%01000000,%00000000		;value of source pixel "01"PuPiSrcLookupPixPosn0Is10	dc.b		%10000000,%00000000		;value of source pixel "10"PuPiSrcLookupPixPosn0Is11	dc.b		%11000000,%00000000		;value of source pixel "11"							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn1Mask	dc.b		%00110000,%00000000		;source mask to isolate pixelPuPiSrcLookupPixPosn1Is01	dc.b		%00010000,%00000000		;value of source pixel "01"PuPiSrcLookupPixPosn1Is10	dc.b		%00100000,%00000000		;value of source pixel "10"PuPiSrcLookupPixPosn1Is11	dc.b		%00110000,%00000000		;value of source pixel "11"							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn2Mask	dc.b		%00001100,%00000000		;source mask to isolate pixelPuPiSrcLookupPixPosn2Is01	dc.b		%00000100,%00000000		;value of source pixel "01"PuPiSrcLookupPixPosn2Is10	dc.b		%00001000,%00000000		;value of source pixel "10"PuPiSrcLookupPixPosn2Is11	dc.b		%00001100,%00000000		;value of source pixel "11"							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn3Mask	dc.b		%00000011,%00000000		;source mask to isolate pixelPuPiSrcLookupPixPosn3Is01	dc.b		%00000001,%00000000		;value of source pixel "01"PuPiSrcLookupPixPosn3Is10	dc.b		%00000010,%00000000		;value of source pixel "10"PuPiSrcLookupPixPosn3Is11	dc.b		%00000011,%00000000		;value of source pixel "11"							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn4Mask	dc.b		%00000000,%11000000		;source mask to isolate pixelPuPiSrcLookupPixPosn4Is01	dc.b		%00000000,%01000000		;value of source pixel "01"PuPiSrcLookupPixPosn4Is10	dc.b		%00000000,%10000000		;value of source pixel "10"PuPiSrcLookupPixPosn4Is11	dc.b		%00000000,%11000000		;value of source pixel "11"							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn5Mask	dc.b		%00000000,%00110000		;source mask to isolate pixelPuPiSrcLookupPixPosn5Is01	dc.b		%00000000,%00010000		;value of source pixel "01"PuPiSrcLookupPixPosn5Is10	dc.b		%00000000,%00100000		;value of source pixel "10"PuPiSrcLookupPixPosn5Is11	dc.b		%00000000,%00110000		;value of source pixel "11"							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn6Mask	dc.b		%00000000,%00001100		;source mask to isolate pixelPuPiSrcLookupPixPosn6Is01	dc.b		%00000000,%00000100		;value of source pixel "01"PuPiSrcLookupPixPosn6Is10	dc.b		%00000000,%00001000		;value of source pixel "10"PuPiSrcLookupPixPosn6Is11	dc.b		%00000000,%00001100		;value of source pixel "11"							;pixel posn: 00112233  44556677PuPiSrcLookupPixPosn7Mask	dc.b		%00000000,%00000011		;source mask to isolate pixelPuPiSrcLookupPixPosn7Is01	dc.b		%00000000,%00000001		;value of source pixel "01"PuPiSrcLookupPixPosn7Is10	dc.b		%00000000,%00000010		;value of source pixel "10"PuPiSrcLookupPixPosn7Is11	dc.b		%00000000,%00000011		;value of source pixel "11"							*Lookup table for stretching a pixel 4x horizontally:PuPiH4xLookupPuPiH4xLookupIs00			equ			*+0PuPiH4xLookupIs01			equ			*+4PuPiH4xLookupIs10			equ			*+8PuPiH4xLookupIs11			equ			*+12							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn0Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn0Is01	dc.b		%01010101,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn0Is10	dc.b		%10101010,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn0Is11	dc.b		%11111111,%00000000,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn1Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn1Is01	dc.b		%00010101,%01000000,%00000000,%00000000PuPiH4xLookupPixPosn1Is10	dc.b		%00101010,%10000000,%00000000,%00000000PuPiH4xLookupPixPosn1Is11	dc.b		%00111111,%11000000,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn2Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn2Is01	dc.b		%00000101,%01010000,%00000000,%00000000PuPiH4xLookupPixPosn2Is10	dc.b		%00001010,%10100000,%00000000,%00000000PuPiH4xLookupPixPosn2Is11	dc.b		%00001111,%11110000,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn3Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn3Is01	dc.b		%00000001,%01010100,%00000000,%00000000PuPiH4xLookupPixPosn3Is10	dc.b		%00000010,%10101000,%00000000,%00000000PuPiH4xLookupPixPosn3Is11	dc.b		%00000011,%11111100,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn4Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn4Is01	dc.b		%00000000,%01010101,%00000000,%00000000PuPiH4xLookupPixPosn4Is10	dc.b		%00000000,%10101010,%00000000,%00000000PuPiH4xLookupPixPosn4Is11	dc.b		%00000000,%11111111,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn5Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn5Is01	dc.b		%00000000,%00010101,%01000000,%00000000PuPiH4xLookupPixPosn5Is10	dc.b		%00000000,%00101010,%10000000,%00000000PuPiH4xLookupPixPosn5Is11	dc.b		%00000000,%00111111,%11000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn6Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn6Is01	dc.b		%00000000,%00000101,%01010000,%00000000PuPiH4xLookupPixPosn6Is10	dc.b		%00000000,%00001010,%10100000,%00000000PuPiH4xLookupPixPosn6Is11	dc.b		%00000000,%00001111,%11110000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH4xLookupPixPosn7Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH4xLookupPixPosn7Is01	dc.b		%00000000,%00000001,%01010100,%00000000PuPiH4xLookupPixPosn7Is10	dc.b		%00000000,%00000010,%10101000,%00000000PuPiH4xLookupPixPosn7Is11	dc.b		%00000000,%00000011,%11111100,%00000000*Lookup table for stretching a pixel 5x horizontally:PuPiH5xLookupPuPiH5xLookupIs00			equ			*+0PuPiH5xLookupIs01			equ			*+4PuPiH5xLookupIs10			equ			*+8PuPiH5xLookupIs11			equ			*+12							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn0Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn0Is01	dc.b		%01010101,%01000000,%00000000,%00000000PuPiH5xLookupPixPosn0Is10	dc.b		%10101010,%10000000,%00000000,%00000000PuPiH5xLookupPixPosn0Is11	dc.b		%11111111,%11000000,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn1Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn1Is01	dc.b		%00010101,%01010000,%00000000,%00000000PuPiH5xLookupPixPosn1Is10	dc.b		%00101010,%10100000,%00000000,%00000000PuPiH5xLookupPixPosn1Is11	dc.b		%00111111,%11110000,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn2Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn2Is01	dc.b		%00000101,%01010100,%00000000,%00000000PuPiH5xLookupPixPosn2Is10	dc.b		%00001010,%10101000,%00000000,%00000000PuPiH5xLookupPixPosn2Is11	dc.b		%00001111,%11111100,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn3Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn3Is01	dc.b		%00000001,%01010101,%00000000,%00000000PuPiH5xLookupPixPosn3Is10	dc.b		%00000010,%10101010,%00000000,%00000000PuPiH5xLookupPixPosn3Is11	dc.b		%00000011,%11111111,%00000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn4Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn4Is01	dc.b		%00000000,%01010101,%01000000,%00000000PuPiH5xLookupPixPosn4Is10	dc.b		%00000000,%10101010,%10000000,%00000000PuPiH5xLookupPixPosn4Is11	dc.b		%00000000,%11111111,%11000000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn5Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn5Is01	dc.b		%00000000,%00010101,%01010000,%00000000PuPiH5xLookupPixPosn5Is10	dc.b		%00000000,%00101010,%10100000,%00000000PuPiH5xLookupPixPosn5Is11	dc.b		%00000000,%00111111,%11110000,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn6Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn6Is01	dc.b		%00000000,%00000101,%01010100,%00000000PuPiH5xLookupPixPosn6Is10	dc.b		%00000000,%00001010,%10101000,%00000000PuPiH5xLookupPixPosn6Is11	dc.b		%00000000,%00001111,%11111100,%00000000							;dest pix:   00112233  44556677  88990011  22334455PuPiH5xLookupPixPosn7Is00	dc.b		%00000000,%00000000,%00000000,%00000000PuPiH5xLookupPixPosn7Is01	dc.b		%00000000,%00000001,%01010101,%00000000PuPiH5xLookupPixPosn7Is10	dc.b		%00000000,%00000010,%10101010,%00000000PuPiH5xLookupPixPosn7Is11	dc.b		%00000000,%00000011,%11111111,%00000000**CLIPINSTALLWITHSTATS: Patched-in replacement for InstallWithStats font manager call:**This routine is patched during most of ClosePage's printing loop, and thus is called during*DrawPicture time.  It attempts to speed up the DrawPicture process by censoring unnecessary*InstallWithStats (IWS) font manager calls.  If the current pen vertical coordinate indicates*that the piece of text whose font is being installed by IWS won't affect the band buffer,*then we cause IWS to install the system font, which requires no loading and scaling, and*thus takes up no significant amount of time to install, instead.  Note that this assumes that*IWS is called *after* positioning the pen to the location of the text to be affected by IWS.*							export		ClipInstallWithStatsClipInstallWithStats*Save caller environment (A,X,Y,B) and setup ours: Our data bank, their direct-page:							pha							phx							phy							phb							phk							plb*Get current QD pen position:							pushlong	#IWSPenPos							_GetPen							*Use (requested-font-size * 1.125) minimum distance for censor decision below:							lda			23,s					;stack looks like this:							and			#$00FF					;B YY XX AA RTL RTL pppp pp pppp							sta			IWSIgnoreDistance		;access "font id" param which							lsr a								;is a long of the form $AABBCCCC,							lsr a								;where A=size, B=face, C=font							lsr a							clc							adc			IWSIgnoreDistance							sta			IWSIgnoreDistance*Determine if requested size and current position would cause marking anywhere near band buffer:							import		OpDoLocInfoRectIWSCheckTop					lda			OpDoLocInfoRect+ov1		;get top y coord of band buffer							sec									;subtract current pen Y position							sbc			IWSPenPos+ov1							bvs			IWSCheckTopFail			;fail if invalid sgn num (underflow)							bmi			IWSCheckTopFail			;fail if signed subtract result < 0							cmp			IWSIgnoreDistance		;compare against minimum distance							bcc			IWSCheckFail			;if close, don't censor nor try botm							bra			IWSCensor				;if far enough away, do censorIWSCheckTopFailIWSCheckBot					lda			IWSPenPos+ov1			;get current pen Y position and sub-							sec									;tract bottom y coord of band buff							sbc			OpDoLocInfoRect+ov2							bvs			IWSCheckBotFail			;fail if invalid sgn num (underflow)							bmi			IWSCheckBotFail			;fail if signed subtract result < 0							cmp			IWSIgnoreDistance		;compare against minimum distance							bcc			IWSCheckBotFail			;if close, don't do censor							bra			IWSCensor				;if far enough away, do censorIWSCheckBotFailIWSCheckFail*At this point, resume normal IWS call:							import		ClPaOldIWSAddrIWSGoNormal					lda			ClPaOldIWSAddr+0		;setup address of normal IWS call							sta			IWSGoNormalJmp+1+0							lda			ClPaOldIWSAddr+2							shortm							sta			IWSGoNormalJmp+1+2							longm							plb									;restore caller environment							ply							plx							plaIWSGoNormalJmp				jmp			>$FFFFFF				;NOTE: operand is stuffed*At this point, censor IWS request by setting its "font id" input param to 0L (System Font) first:IWSCensor					lda			#0							sta			20,s							sta			22,s							bra			IWSGoNormal*Variables needed for this routine:IWSPenPos					dc.w		0,0IWSIgnoreDistance			dc.w		0**PUTTEXT: Patched-in QuickDraw BottleProc, called during DrawPicture:**This is the patched text bottleproc, called during picture playback from within DrawPicture.*This routine attempts to censor certain text objects from being drawn, thus speeding up the*DrawPicture call, by preventing the normal text drawing code from executing if a text string*does not intersect with the banding buffer.  Only the vertical coordinates are checked, since*we only implement portrait orientation.  This routine also attempts to adjust the interspacing*of text objects in order to correct for the usage of 5X-sized fonts in a 4.5X-scaled destination*picture rendering coordinate system.**During most of this routine, the bank register is set to us, but the direct page register*stays set to QD, so that QD global variables, as well as static variables maintained by other*printloop routines (such as the band buffer rectangle, the line layout disable flag, etc) may*be accessed.*							export		PutTextPutText*Set up environment: Our data bank, QD's direct page:PuTeSaveQDBSetupOurB		phb									;save QD's bank setting							phk									;we'll have direct-page set to QD's							plb									;and data-bank set to this driver							*Obtain string address and length regardless of single-char, c-string, or p-string status:PuTeObtainString			lda			QDDrawVerbDPLoc							cmp			#QDDrawCharVerbEqu							bne			PuTeNotSingleCharPuTeItsSingleChar			lda			QDCharToDrawDPLoc							sta			PuTeChar							lda			#PuTeChar							sta			PuTeTextPtr+0							lda			#^PuTeChar							sta			PuTeTextPtr+2							lda			#1							sta			PuTeTextLength							bra			PuTeObtainStringDonePuTeNotSingleChar			cmp			#QDDrawCStrVerbEqu							bne			PuTeItsPStringPuTeItsCString				ldy			#0							shortmPuTeCStrLenLoop				lda			[QDTextPtrDPLoc],y							beq			PuTeCStrLenLoopDone							iny							cpy			#256							bne			PuTeCStrLenLoopPuTeCStrLenLoopDone			longm							bra			PuTeFinishItsCOrPStringPuTeItsPString				ldy			QDTextLengthDPLocPuTeFinishItsCOrPString		sty			PuTeTextLength							lda			QDTextPtrDPLoc+0							sta			PuTeTextPtr+0							lda			QDTextPtrDPLoc+2							sta			PuTeTextPtr+2PuTeObtainStringDone							*Obtain rect around string, needed for code below, using reentrant QD call:							jsr			PuTeSaveTxCtl			;save for restore in a moment							pushlong	PuTeTextPtr				;get bounding box around string							pushword	PuTeTextLength							pushlong	#PuTeTextRect							_TextBounds							jsr			PuTeRestoreTxCtl		;recover from reentrant QD call							**Decide whether to do time-saving censoring of text drawing, using rect obtained above:**This routine will exit the StdText routine back to the caller, instead of allowing QuickDraw*to do the drawing, if the string is of zero length or if it lies completely outside of the*current band buffer.  Otherwise, program flow drops through this routine.**We do signed compares to see if any part of the text-enclosing rectangle intersects band buffer.*We will censor text if this is TRUE:   [(ty1<by1)  &&  (ty2<by1)]  ||  [(ty1>by2)  &&  (ty2>by2)],*where "ty" refers to text-enclosing rectangle's Y and "by" refers to band buffer rectangle Y.**Stated differently, we have:  Do censor if null string or [(1) && (2)] || [(3) && (4)], where:**			(1) Is text start above top edge of band buffer?*			(2) Is text finish (also) above top edge of band buffer?*			(3) Is text start below bottom edge of band buffer?*			(4) Is text finish (also) below bottom edge of band buffer?**These numbers (1)..(4) are referred to in the labels in the following section.*							import		OpDoLocInfoRect							PuTeCheckAndDoCensor		lda			PuTeTextLength			;censor if null string							beq			PuTeCensor							PuTeCmp1					lda			PuTeTextRect+ov1		;doing signed compare (1)							sec									;is text start above top of band?							sbc			OpDoLocInfoRect+ov1							beq			PuTeCmp1IsFalse			;if equal, then result is false							bvs			PuTeCmp1Inv				;if overflow, invert compare result							bmi			PuTeCmp1IsTrue							bra			PuTeCmp1IsFalsePuTeCmp1Inv					bmi			PuTeCmp1IsFalsePuTeCmp1IsTrue							PuTeCmp2					lda			PuTeTextRect+ov2		;doing signed compare (2)							sec									;is text end above top of band?							sbc			OpDoLocInfoRect+ov1							beq			PuTeCmp2IsFalse			;if equal, then result is false							bvs			PuTeCmp2Inv				;if overflow, invert compare result							bmi			PuTeCmp2IsTrue							bra			PuTeCmp2IsFalsePuTeCmp2Inv					bmi			PuTeCmp2IsFalsePuTeCmp2IsTrue														bra			PuTeCensor				;both (1) and (2) true, so censor							PuTeCmp1IsFalse													;if either (1) or (2) was false,PuTeCmp2IsFalse													;then go on to compares (3),(4)							PuTeCmp3					lda			PuTeTextRect+ov1		;doing signed compare (3)							sec									;is text start below bottom of band?							sbc			OpDoLocInfoRect+ov2							beq			PuTeCmp3IsFalse			;if equal, then result is false							bvs			PuTeCmp3Inv				;if overflow, invert compare result							bpl			PuTeCmp3IsTrue							bra			PuTeCmp3IsFalsePuTeCmp3Inv					bpl			PuTeCmp3IsFalsePuTeCmp3IsTrue							PuTeCmp4					lda			PuTeTextRect+ov2		;doing signed compare (4)							sec									;is text end below bottom of band?							sbc			OpDoLocInfoRect+ov2							beq			PuTeCmp4IsFalse			;if equal, then result is false							bvs			PuTeCmp4Inv				;if overflow, invert compare result							bpl			PuTeCmp4IsTrue							bra			PuTeCmp4IsFalsePuTeCmp4Inv					bpl			PuTeCmp4IsFalsePuTeCmp4IsTrue														bra			PuTeCensor				;both (3) and (4) true, so censor							PuTeCmp3IsFalse													;if either (3) or (4) was false,PuTeCmp4IsFalse				bra			PuTeDontCensor			;and we're here, don't censor text							*Censor normal text drawing: Restore QD's bank register and exit right now with no-error status:PuTeCensor					plb							lda			#0							clc							rtl							*Don't censor normal text drawing; drop through to section below:PuTeDontCensor							**Do position-managed text drawing (Line Layout):**This routine calls the real QuickDraw text drawing code, but it does so under the context*of a temporary alteration of several grafport settings, most notably CharExtra and SpaceExtra.*This is done in order to adress the following issues:**	(1) The application's requested SpaceExtra/CharExtra values are not scaled up by QuickDraw*		and so we must do it.  Otherwise full justification, etc, would not work.  However,*		we must also correct for the fact that almost all applications programs already scale*		their SpaceExtra/CharExtra values by 2x in order to compensate for this problem for*		the case of an ImageWriter printer.**	(2) The horizontal text spacing needs to be reduced by 10% because of 80->72 dpi.  Applications*		assume a horizontal drawing area of bounds of 80 dpi * 8 inch = 640 sourcepix.  Since the*		StyleWriter has 72 dpi * 8 inch * 5x = 2880 printpix horizontal pixels, the scaling*		factor that this driver employs is 4.5x, not 5x, so that the resulting number of pixels*		that the picture is drawn at is 80 dpi * 8 inch * 4.5x = 2880 printpix, and not erroneously*		80 dpi * 8 inch * 5x = 3200 printpix!  However, the QuickDraw code asks the font manager*		for 5x fonts, even though picture playback is being scaled by 4.5x in the horizontal*		direction (but 5x in the vertical direction).  Thus, we must make strings narrower by a*		factor of 10% (72dpi / 80dpi = 0.9), so that they are reduced in size along with the*		other graphical objects (bitmaps, lines, ovals, etc) that make up the picture.**	(3) Actual horizontal dimensions of two different fonts are not always exact multiples*		of each other even if their point sizes are (ie, if a string of Times 10 is 100 pixels*		wide then that same string in Times 20 is not necessarily 200 pixels wide).  This leads*		to clipping or falling-short with respect to other text or objects to the right.**	(4) QuickDraw's face modifications (underline, bold, italic, outline, shadow) can modify*		the string length (it usually grows significantly wider), leading to clipping against*		other text or objects to the right.**	(5) Vertical clipping of descenders occurs because the vertical sizes of fonts do not*		follow font point size multiples either as stated above.**In addition, if the text transfer mode is $0000 (modeCopy) then it is temporarily modified to*be $0004 (modeForeCopy).  This effectively ORs the text over what is already rendered, so that*the descenders of the line above are not clipped.  This is sometimes necessary because the*height of the scaled-up font may be greater than the original font's height multiplied by the*scaling factor.  However, this will cause a problem for any application that depends on the*text drawing destructively with respect to its background.**Both line layout and text tranfer mode modification may be disabled by setting driver-specific*bits in the wDev field of the print record.**Save format-oriented settings (SpaceExtra/CharExtra/Etc) for restore when we're all done:							jsr			PuTeSaveSpxChxTxm							*Check and disable line layout code if application requests it:							import		OpDoIsLineLayoutDisable							lda			OpDoIsLineLayoutDisable							beq			PuTeDoLLDisableDone							brl			PuTeLineLayoutDonePuTeDoLLDisableDone							*Undo app's spx/chx doubling (bug: QD doesn't scale them with rest of PICT) to get app 1x spx/chx:							import		OpDoIsQualityHigh		;if not high quality, app isn't							lda			OpDoIsQualityHigh		;compensating, so skip this							beq			PuTeUndoubleSpxChxDone														lda			#ospExtra				;get SpaceExtra long in lo/hi->X/Y							jsr			PuTeGetQDPortVarInXY							jsr			PuTeDivLongInXYBy2		;divide by 2							lda			#ospExtra				;store X/Y->lo/hi as new SpaceExtra							jsr			PuTeSetQDPortVarInXY														lda			#ochExtra				;get CharExtra long in lo/hi->X/Y							jsr			PuTeGetQDPortVarInXY							jsr			PuTeDivLongInXYBy2		;divide by 2							lda			#ochExtra				;store X/Y->lo/hi as new CharExtra							jsr			PuTeSetQDPortVarInXYPuTeUndoubleSpxChxDone														*Wanted width is of app font, influenced by app-intended spx/chx, times our printing-scale factor:							jsr			PuTeSaveTxCtl			;for restore after reentrant calls							ldy			#ofontID+2				;push current font on stack and							lda			[QDPortRefDPLoc],y		;store font id in static storage							pha							sta			PuTeAppFontRequest+2							dey							dey							lda			[QDPortRefDPLoc],y							pha							sta			PuTeAppFontRequest+0														lda			PuTeAppFontRequest+2	;find out what app's font size was							xba									;by scaling it back down from what							and			#$00FF					;blown-up DrawPicture has done to it							jsr			PuTeDPScaleDownWordInA							shortm							sta			PuTeAppFontRequest+3							longm														pushlong	PuTeAppFontRequest		;temporarily go back to app's font							pushword	#0							_InstallFont														pha									;recreate app string's width in A							pushlong	PuTeTextPtr				;note that TextWidth is affected by							pushword	PuTeTextLength			;current spx/chx values							_TextWidth							pla														jsr			PuTeScaleUpWordInA		;multiply by printing-scale factor														sta			PuTeWantedWidth			;this is the string width we need														pushword	#0						;restore current font from stack							_InstallFont														jsr			PuTeRestoreTxCtl		;restore after reentrant QD calls							*Reduce wanted width very slightly to work around apparent width call err (can lead to right clip):							pha									;pass result space							pha									;pass result space							pushword	PuTeWantedWidth			;pass wantwidth as fixed: pass int							pushword	#0						;pass wantwidth as fixed: pass frac							pushword	#0						;pass K as fixed: pass int							pushword	#lineLayoutFudgeWidClp	;pass K as fixed: pass frac							_FixMul								;wantwidth = int (wantwidth.0 * 0.K)							pla									;retrieve fixed result: ignore frac							pullword	PuTeWantedWidth			;retrieve fixed result: get int							*Now scale spx/chx up from corrected app's 1x to the printing resolution of 2.25x|4.5x:							lda			#ospExtra							jsr			PuTeGetQDPortVarInXY							jsr			PuTeScaleUpLongInXY							lda			#ospExtra							jsr			PuTeSetQDPortVarInXY														lda			#ochExtra							jsr			PuTeGetQDPortVarInXY							jsr			PuTeScaleUpLongInXY							lda			#ochExtra							jsr			PuTeSetQDPortVarInXY							*If SpaceExtra is too big (may cause bug), then repeatedly halve it and double number of spaces:							lda			#ospExtra				;skip this if abs value small enough							jsr			PuTeGetQDPortVarInXY							cpy			#$8000							bcc			PuTeBigSpxFixCk1PosPuTeBigSpxFixCk1Neg			cpy			#-lineLayoutBgSpFxLim							bcs			PuTeBigSpxFixCk1InRng							bra			PuTeBigSpxFixCk1OutRngPuTeBigSpxFixCk1Pos			cpy			#lineLayoutBgSpFxLim							bcs			PuTeBigSpxFixCk1OutRngPuTeBigSpxFixCk1InRng		brl			PuTeBigSpxFixDonePuTeBigSpxFixCk1OutRng							lda			PuTeTextLength			;be sure it's drawstr, not drawchar							cmp			#2							bcs			PuTeBigSpxFixCk2YesPuTeBigSpxFixCk2No			brl			PuTeBigSpxFixDonePuTeBigSpxFixCk2Yes							phy									;save SpaceExtra value on stack							phx														pushlong	PuTeTextPtr				;make our own copy of the string							pushlong	#PuTeBigSpxFixBuffer							pushword	#0							pushword	PuTeTextLength							_BlockMove														lda			PuTeTextLength			;initialize growable new str length							sta			PuTeBigSpxFixStrLen							PuTeBigSpxFixLoop												;head of halving/adding spaces loop														plx									;restore SpaceExtra value from stack,							ply									;halve it, save new smaller value							jsr			PuTeDivLongInXYBy2							phy							phx														ldx			PuTeBigSpxFixStrLen		;turn every space in string into							lda			#0						;two spaces, but break out of loop							sta			PuTeBigSpxFixBuffer,x	;unsuccessfully with clean stack							ldx			#0						;if not enough room in string bufferPuTeBigSpxFixInsLoop		lda			PuTeBigSpxFixBuffer,x							and			#$00FF					;here with X as index in str							beq			PuTeBigSpxInsDone		;zero marks our end in all c/p str's							cmp			#' '							bne			PuTeBigSpxInsNext							phx									;save current index							push1		#0						;pass source ptr word hi as index							phk									;note buffer can't cross bank bounds							txa									;pass source ptr word lo as index							clc							adc			#PuTeBigSpxFixBuffer							pha							push1		#0						;pass dest ptr word hi as index+1							phk									;note buffer can't cross bank bounds							txa									;pass dest ptr word lo as index+1							sec							adc			#PuTeBigSpxFixBuffer							pha							pushword	#0						;pass len word hi as len-x+1							txa									;pass len word lo as len-x+1							eor			#$FFFF					;eor+1 has effect of inverting sign							ina							clc									;add len to -x							adc			PuTeBigSpxFixStrLen							ina									;plus one for the terminating 0							pha							_BlockMove							plx									;restore current index							inx									;increment over the two spaces							inx									;that now exist here							inc			PuTeBigSpxFixStrLen		;str len++ because of insert							lda			PuTeBigSpxFixStrLen		;make sure we don't overflow buffer							cmp			#lineLayoutBgSpFxBuf-4							bcc			PuTeBigSpxFixInsLoop	;keep going to new str territory							plx									;here if buffer overflow error							ply									;clean up stack and abort							bra			PuTeBigSpxFixDonePuTeBigSpxInsNext			inx									;keep going to new str territory							bra			PuTeBigSpxFixInsLoop							PuTeBigSpxInsDone														plx									;if abs value small enough now, break							ply									;out of loop successfully with clean							cpy			#$8000					;stack and X/Y set with new Spx value							bcc			PuTeBigSpxFixCk3PosPuTeBigSpxFixCk3Neg			cpy			#-lineLayoutBgSpFxLim							bcs			PuTeBigSpxFixCk3InRng							bra			PuTeBigSpxFixCk3OutRngPuTeBigSpxFixCk3Pos			cpy			#lineLayoutBgSpFxLim							bcc			PuTeBigSpxFixCk3InRngPuTeBigSpxFixCk3OutRng							phy									;not ok: do halve/add spaces again							phx							bra			PuTeBigSpxFixLoopPuTeBigSpxFixCk3InRng											;ok: drop thru to finish up							PuTeBigSpxFixAccept												;here if successful only, Spx in X/Y														lda			#ospExtra				;update to new smaller SpExtra in X/Y							jsr			PuTeSetQDPortVarInXY														pha									;multiply ChExtra by (old string							pha									;length divided by new length) to							pushword	QDTextLengthDPLoc		;compensate for the fact that our							pushword	PuTeBigSpxFixStrLen		;added space characters add unwanted							_FixRatio							;ChExtra width to the string							pulllong	PuTeBigSpxFixChxCoeff							lda			#ochExtra							jsr			PuTeGetQDPortVarInXY							pha							pha							phy							phx							pushlong	PuTeBigSpxFixChxCoeff							_FixMul							plx							ply							lda			#ochExtra							jsr			PuTeSetQDPortVarInXY														lda			PuTeBigSpxFixStrLen		;tell us and QD len of our new str							sta			QDTextLengthDPLoc							sta			PuTeTextLength														lda			#PuTeBigSpxFixBuffer	;point us and QD to our new str							sta			QDTextPtrDPLoc+0							sta			PuTeTextPtr+0							lda			#^PuTeBigSpxFixBuffer							sta			QDTextPtrDPLoc+2							sta			PuTeTextPtr+2														PuTeBigSpxFixDone												;here if successful or not							*Get would-be width with _DP, FMGR, and QD error built in but with correct spx/chx influence:							jsr			PuTeSaveTxCtl			;we're about to make reentrant call							pha									;measure string width and store							pushlong	PuTeTextPtr							pushword	PuTeTextLength							_TextWidth							pla							sta			PuTeWouldBeWidth							jsr			PuTeRestoreTxCtl		;recover from reentrant call							*Calculate difference (in pixels) between wanted width and would-be width of the current string:							sec									;delta=wanted-actual, this will							lda			PuTeWantedWidth			;almost always be negative, mostly							sbc			PuTeWouldBeWidth		;caused by 4.5x->5x _DP font select							sta			PuTeSignedDeltaWidth	;err, FM scale err, QD face-mod err							*Count number of spaces in string which we will need shortly:							stz			PuTeTextSpaces							lda			PuTeTextPtr+0							sta			PuTeCountSpcLoopLda+1+0							lda			PuTeTextPtr+2							shortm							sta			PuTeCountSpcLoopLda+1+2							ldx			#0PuTeCountSpcLoopLda			lda			>$FFFFFF,x							cmp			#$20					;($A0 not a space in extended set)							bne			PuTeCountSpcNext							inc			PuTeTextSpacesPuTeCountSpcNext			inx							cpx			PuTeTextLength							bne			PuTeCountSpcLoopLda							longm							*Assign a certain part of the delta to be handled by the spaces if possible:							pha									;pass result space							pha									;pass result space							pushword	PuTeSignedDeltaWidth	;pass signed dividend							pushword	#lineLayoutAmtToSp		;pass divisor							_SDivide							pla									;retrieve quotient, this is num pix							sta			PuTeSignedDeltaWidthSp	;to attempt to spread over spaces							pla									;ignore remainder							*Figure out signed SpaceExtra correction, subject to number of available spaces in string:							lda			PuTeTextSpaces			;take number of desired pixels to							bne			PuTeCalcDeltaSPXNon0	;apply to spaces and the number of							stz			PuTeDeltaSpExtra+0		;spaces to come up with SpaceExtra							stz			PuTeDeltaSpExtra+2		;if 0 spaces available, then zero							stz			PuTeSignedDeltaWidthSp	;the SpaceExtra correction value							bra			PuTeCalcDeltaSPXDone	;and thus don't divide by zeroPuTeCalcDeltaSPXNon0														pha									;pass result space							pha									;pass result space							pushword	PuTeSignedDeltaWidthSp	;pass num delta pix apply to spaces							pushword	PuTeTextSpaces			;pass num spaces available in string							_FixRatio							pulllong	PuTeDeltaSpExtra		;retrieve final spc delta correctionPuTeCalcDeltaSPXDone							*Figure out signed CharExtra correction, picking up what SpaceExtra isn't able to handle:							lda			PuTeSignedDeltaWidth	;figure out number of delta pixels							sec									;still to apply after SpaceExtra							sbc			PuTeSignedDeltaWidthSp	;this may of course be all of them							sta			PuTeSignedDeltaWidthCh	;if there were no spaces in string														pha									;pass result space							pha									;pass result space							pushword	PuTeSignedDeltaWidthCh	;pass num delta pix apply to chars							pushword	PuTeTextLength			;pass num chars in string							_FixRatio							pulllong	PuTeDeltaChExtra		;retrieve final chr delta correction							*Add our final _DP/FMGR/QD error correction deltas to currently correctly scaled spx/chx:							lda			#ospExtra							jsr			PuTeGetQDPortVarInXY							clc							txa							adc			PuTeDeltaSpExtra+0							tax							tya							adc			PuTeDeltaSpExtra+2							tay							lda			#ospExtra							jsr			PuTeSetQDPortVarInXY														lda			#ochExtra							jsr			PuTeGetQDPortVarInXY							clc							txa							adc			PuTeDeltaChExtra+0							tax							tya							adc			PuTeDeltaChExtra+2							tay							lda			#ochExtra							jsr			PuTeSetQDPortVarInXY							*Here if done with line layout calculations or entry point for line layout bypass:PuTeLineLayoutDone							*If not disabled by wDev bit and text mode is 0, force modeForeCopy to avoid descender clipping:							import		OpDoIsForceTxMDisable							lda			OpDoIsForceTxMDisable	;if wDev bit disables this,							bne			PuTeForceTxModeDone		;skip next few lines							ldy			#otxMode				;get current text transfer mode							lda			[QDPortRefDPLoc],y							bne			PuTeForceTxModeDone		;if other than 0 don't modify							lda			#$0004					;else set to modeForeCopy, will not							sta			[QDPortRefDPLoc],y		;always be the right thing to doPuTeForceTxModeDone							*Setup JSL below to the real QD StdText code:							import		OpDoOldPlyQDProcs							lda 		OpDoOldPlyQDProcs+ostdText+0							ina							sta			PuTeGoQDStdTextJsl+1+0							lda			OpDoOldPlyQDProcs+ostdText+2							shortm							sta			PuTeGoQDStdTextJsl+1+2							longm							*Call the real QD StdText code, which draws the string under influence of our spx/chx values:							plb									;switch in QuickDraw's B setting							lda			#0							clcPuTeGoQDStdTextJsl			jsl			>$FFFFFF				;NOTE: operand is stuffed							phb									;switch in our B setting again							phk							plb							*Restore format-oriented settings (spx/chx/etc) that we altered back to previous values:							jsr			PuTeRestoreSpxChxTxm							*However, do not restore control-oriented grafport settings now that we've done real drawing:							*Exit point from this entire routine which restores QD bank and exits with no error:							plb							lda			#0							clc							rtl							*Subroutine that multiplies positive word in A by scaling factor (*2.25|*4.5): Input/Output -> A:PuTeScaleUpWordInA			tax									;make it a long in X/Y							ldy			#0							jsr			PuTeScaleUpLongInXY		;call the long scale routine							txa									;get word back in A							rts									;exit back to caller							*Subroutine that multiplies signed long in X/Y by scaling factor (*2.25|*4.5): Input/Output -> X/Y:PuTeScaleUpLongInXY			jsr			PuTeMulLongInXYBy9		;now it's *9							jsr			PuTeDivLongInXYBy2		;now it's *4.5							import		OpDoIsQualityHigh							lda			OpDoIsQualityHigh		;divide by 2 if lo quality							bne			PuTeScaleUpLongQualExit	;now it's *2.25/*4.5							jsr			PuTeDivLongInXYBy2		;if lo/hi qualPuTeScaleUpLongQualExit		rts									;exit back to caller							*Subroutine that divides positive word in A by DrawPicture factor (/2.5|/5): Input/Output -> A:PuTeDPScaleDownWordInA		tax									;make it a long in X/Y							ldy			#0														jsr			PuTeMulLongInXYBy2		;now it's *2														import		OpDoIsQualityHigh							lda			OpDoIsQualityHigh		;multiply by 2 if lo quality							bne			PuTeDPScaleDownQualDone	;now it's *4/*2 if lo/hi quality							jsr			PuTeMulLongInXYBy2PuTeDPScaleDownQualDone							pha									;pass result space							pha									;pass result space							phx									;pass dividend, lo, hope no overflow							pushword	#10						;pass divisor							_UDivide							;now it's /2.5 | /5 if lo|hi qual							pla									;retrieve quotient word in A							plx									;retrieve remainder and ignore														rts									;exit back to caller							*Subroutine that multiplies long value in X/Y by 9: Input/Output lo/hi -> X/Y:PuTeMulLongInXYBy9			phy									;save original value on stack							phx														jsr			PuTeMulLongInXYBy2		;now it's *2							jsr			PuTeMulLongInXYBy2		;now it's *4							jsr			PuTeMulLongInXYBy2		;now it's *8														clc									;make it *9 by add orig value							txa							adc			1,s							tax							tya							adc			3,s							tay														pla									;remove saved value from stack							pla														rts									;exit back to caller							*Subroutine that multiplies long value in X/Y by 2: Input/Output lo/hi ->X/Y:PuTeMulLongInXYBy2			txa									;times 2 by left shift long							asl a								;start with lo word, shift up							tax									;and then rotate carry with lo							tya									;word's highest bit into hi word							rol a							tay							rts							*Subroutine that divides long value in X/Y by 2: Input/Output lo/hi ->X/Y:PuTeDivLongInXYBy2			tya									;divide by two by right shift long							lsr a								;start with hi word, shift down							tay									;and then rotate carry with hi							txa									;word's lowest bit into lo word							ror a							tax							rts							*Subroutine that saves format-oriented GrafPort text settings (SpaceExtra, CharExtra, TextMode):PuTeSaveSpxChxTxm			lda			#ospExtra							jsr			PuTeGetQDPortVarInXY							stx			PuTeSavedPortSpExtra_l+0							sty			PuTeSavedPortSpExtra_l+2														lda			#ochExtra							jsr			PuTeGetQDPortVarInXY							stx			PuTeSavedPortChExtra_l+0							sty			PuTeSavedPortChExtra_l+2														ldy			#otxMode							lda			[QDPortRefDPLoc],y							sta			PuTeSavedPortTxMode_w														rts							*Subroutine that restores format-oriented GrafPort text settings (SpaceExtra, CharExtra, TextMode):PuTeRestoreSpxChxTxm		ldy			#otxMode							lda			PuTeSavedPortTxMode_w							sta			[QDPortRefDPLoc],y														lda			#ochExtra							ldx			PuTeSavedPortChExtra_l+0							ldy			PuTeSavedPortChExtra_l+2							jsr			PuTeSetQDPortVarInXY														lda			#ospExtra							ldx			PuTeSavedPortSpExtra_l+0							ldy			PuTeSavedPortSpExtra_l+2							jsr			PuTeSetQDPortVarInXY																					rts							*Subroutine that gets long value from current GrafPort: Offset->A, X/Y->lo/hi long value:PuTeGetQDPortVarInXY		tay							lda			[QDPortRefDPLoc],y							tax							iny							iny							lda			[QDPortRefDPLoc],y							tay							rts							*Subroutine that sets long value into current GrafPort: Offset->A, long value to store lo/hi->X/Y:PuTeSetQDPortVarInXY		phy							tay							txa							sta			[QDPortRefDPLoc],y							iny							iny							pla							sta			[QDPortRefDPLoc],y							rts							*Subroutine that saves control-oriented QD-Global text state (DrawVerb, Ptr, Rect, Etc):PuTeSaveTxCtl				lda			QDDrawVerbDPLoc							sta			PuTeSavedGlobDrawVerb_w														lda			QDTextPtrDPLoc+0							sta			PuTeSavedGlobTextPtr_l+0							lda			QDTextPtrDPLoc+2							sta			PuTeSavedGlobTextPtr_l+2														lda			QDTextLengthDPLoc							sta			PuTeSavedGlobTextLength_w														lda			QDCharToDrawDPLoc							sta			PuTeSavedGlobCharToDraw_w														lda			QDRectPtrDPLoc+0							sta			PuTeSavedGlobRectPtr_l+0							lda			QDRectPtrDPLoc+2							sta			PuTeSavedGlobRectPtr_l+2														rts							*Subroutine that restores control-oriented QD-Global text state (DrawVerb, Ptr, Rect, Etc):PuTeRestoreTxCtl			lda			PuTeSavedGlobRectPtr_l+0							sta			QDRectPtrDPLoc+0							lda			PuTeSavedGlobRectPtr_l+2							sta			QDRectPtrDPLoc+2														lda			PuTeSavedGlobCharToDraw_w							sta			QDCharToDrawDPLoc														lda			PuTeSavedGlobTextLength_w							sta			QDTextLengthDPLoc														lda			PuTeSavedGlobTextPtr_l+0							sta			QDTextPtrDPLoc+0							lda			PuTeSavedGlobTextPtr_l+2							sta			QDTextPtrDPLoc+2														lda			PuTeSavedGlobDrawVerb_w							sta			QDDrawVerbDPLoc														rts							*Static variables used by this routine:PuTeTextPtr					dc.l		0						;obtained address of text stringPuTeTextLength				dc.w		0						;obtained length of text stringPuTeTextSpaces				dc.w		0						;obtained num of spaces in stringPuTeChar					dc.w		0						;storage for one-char text if neededPuTeTextRect				dc.w		0,0,0,0					;obtained unmodified rect of stringPuTeAppFontRequest			dc.l		0						;reconstructed original app font idPuTeWantedWidth				dc.w		0						;calculated target string widthPuTeWouldBeWidth			dc.w		0						;actual unmodified string widthPuTeSignedDeltaWidth		dc.w		0						;total signed delta width correctionPuTeSignedDeltaWidthSp		dc.w		0						;signed delta pix applied to spacesPuTeSignedDeltaWidthCh		dc.w		0						;signed delta pix applied to charsPuTeDeltaSpExtra			dc.l		0						;signed correcting space-extra deltaPuTeDeltaChExtra			dc.l		0						;signed correcting char-extra delta							PuTeSavedPortSpExtra_l		dc.l		0						;gport var save/restore storagePuTeSavedPortChExtra_l		dc.l		0PuTeSavedPortTxMode_w		dc.w		0							PuTeSavedGlobDrawVerb_w		dc.w		0						;global var save/restore storagePuTeSavedGlobTextPtr_l		dc.l		0PuTeSavedGlobTextLength_w	dc.w		0PuTeSavedGlobCharToDraw_w	dc.w		0PuTeSavedGlobRectPtr_l		dc.l		0PuTeBigSpxFixStrLen			dc.w		0						;length of new str with more spacesPuTeBigSpxFixBuffer			ds.b		lineLayoutBgSpFxBuf		;for holding str with more spacesPuTeBigSpxFixChxCoeff		dc.l		0						;for compensating chx due to spaces							endproc							end