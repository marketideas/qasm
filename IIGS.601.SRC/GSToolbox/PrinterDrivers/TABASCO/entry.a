*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: entry.a -- Entry Points; environment (D/B) setup; dispatch to routines     **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1991 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.h'							include		'm16.util'							include		'e16.print'EntryProc					proc		export**New (Apple IIgs System Disk 5.0 and later), re-entrant, driver entry point:*Entry						dc.w		0							dc.w		(DispatchEnd-DispatchBegin)/4**Save/Set Bank and Direct registers (D page; B=K), assume no errors, dispatch to routines:*							phb									;Save B byte for later restore							phd									;Save D word for later restore							cpx			#((17-1)*4)+1			;See if call # is in range							bcc			Entry1							brk			#$BB					;Should never happenEntry1						tsc							sec							sbc			#DPSize					;Stack frame for small direct page							tcsStackParam					equ			1+3+3+1+2+DPSize		;1 + RTL1 + RTL2 + B + D + StackFrame							ina							tcd									;Set our D to our stack frame							phk							plb									;Set our B; now can use abs addr							stz			errNo					;Assume no error unless set later on							jmp			(DispatchBegin,x)		;Go do one of our routines**Dispatch table:*DispatchBegin											dc.l		SW_PrDefault			;PrDefault - initialize print record							dc.l		SW_PrValidate			;PrValidate - sanitize print record							dc.l		SW_PrStlDialog			;PrStlDialog - user interface							dc.l		SW_PrJobDialog			;PrJobDialog - user interface							dc.l		SW_PrDriverVer			;PrDriverVer - version number							dc.l		SW_PrOpenDoc			;PrOpenDoc - alloc printing resources							dc.l		SW_PrCloseDoc			;PrCloseDoc - dealloc pr resources							dc.l		SW_PrOpenPage			;PrOpenPage - define start of page							dc.l		SW_PrClosePage			;PrClosePage - causes page to print							dc.l		SW_PrPicFile			;PrPicFile - call after PrCloseDoc							dc.l		SW_Reserved				;Reserved							dc.l		SW_PrError				;PrError - get current print status							dc.l		SW_PrSetError			;PrSetError - set print status/abort							dc.l		SW_PrChanged			;PrChanged - report NBP driver name							dc.l		SW_PrPixelMap			;PrPixelMap - quick bitmap dump							dc.l		SW_PrGetPrinterSpecs	;PrGetPrinterSpecs - get self-id info							dc.l		SW_PrGetPgOrientation	;PrGetPgOrientation - port/land modeDispatchEnd							**EXIT: Jump here when done doing driver call.*After removing direct page stack frame, this routine moves 9 bytes at bottom of stack X number*of bytes up, restores D/B, leaves A and carry with error status, and RTLs.  Note that 2 RTLs are*assumed to be on the stack.*Exit						tsc									;Get rid of our little scratch area							clc							adc			#DPSize							tcs	 						cpx			#0						;Have to do this compare for 0							beq			Exit3							stx			TmpNumMov							tsc							sta			Exit1+1							clc							adc			TmpNumMov							sta			Exit2+1							push1		#0							plb									;Our data bank is 0 at this point							ldy			#8						;9+(0 because we're JMPed-to) - 1Exit1						lda			$FFFF,yExit2						sta			$FFFF,y							dey							dey							bpl			Exit1							phk							plb							lda			Exit2+1							tcs									;S restoredExit3						lda			errNo					;get errNo for use in a sec...							pld									;D restored--no more direct addrs							plb									;B restored--no more absolute addrs							cmp			#1						;ACC has err... set carry if nonzero							rtl									;Exit back to print manager*TmpNumMov					dc.w		0						;Temporary storage used above******************************************************************************************************The following routines do all the work of the printer driver, or at least contain JSRs to*routines in other files.  The following has happened on entry to these routines:**		* The caller's D/B registers have been saved*		* The D register is the same as the K register so absolute adressing can be used*		* The B register points to DPSize free bytes on the stack for scratch usage*		* "errNo" has been set to zero, assuming no errors from the routine*		* Since caller's environment was saved on stack, the driver is re-entrant.**These routines should do their work by:**		* Accessing input/output parameters on the stack by means of LDx/STx StackParam+N,s,*		  where the N refers to the relative offset (ie, 0,2,4 would be 3 words on the stack)*		* Using our small direct page area, JSRing to other assembly files, using the stack*		* Changing "errNo" to be nonzero if error flagging is desired*		* Calling routines in this driver if desired (some port driver calls actually do this)*		* LDX #N, where N is the number of input parameter bytes used by the routine*		* JMP/BRL Exit.**The exit routine will then:**		* Dump our small direct page off of the stack*		* Dump input parameters off of the stack*		* Restore the caller's D/B registers from stack*		* Set the A register with value of "errNo" and set the carry if nonzero*		* Exit via RTL.*****************************************************************************************************SW_Reserved					ldx			#2						;$0002: Tool Locator "call not found"							stx			errNo*							ldx			#0						;assume no bytes to strip off stack							brl			Exit********************************************************************************************************************************************************************************************************SW_PrDefault				lda			StackParam+0,s			;This routine fills in the user's							sta			printRecordHandle+0		;area of memory with a default							lda			StackParam+2,s			;print record with standard options							sta			printRecordHandle+2*							import		InitPrintRecord							jsr			InitPrintRecord			;Metrics routine*							ldx			#4						;# of input param bytes to strip							brl			Exit****************************************************************************************************														****************************************************************************************************SW_PrValidate				lda			StackParam+0,s			;This routine checks to make sure							sta			printRecordHandle+0		;the user's print record is							lda			StackParam+2,s			;self-consistent and up to date,							sta			printRecordHandle+2		;and changes it if necessary*							import		GetOkOurDriver							jsr			GetOkOurDriver			;Metrics: Same driver as last time?							beq			PrVaAllCorrect			;yes, this is our print record							import		InitPrintRecord							jsr			InitPrintRecord			;take over print record for us							lda			#1						;recAdjustFlag will be true							bra			PrVaExit							import		CalcMetricsPrVaAllCorrect				jsr			CalcMetrics				;make sure self-consistent							lda			#0						;recAdjustFlag will be false*PrVaExit					sta			StackParam+4,s			;store recAdjustFlag result							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrJobDialog				lda			#1						;This routine uses data in the							sta			PrDiSDialogType+1		;user's print record to properly							bra			PrDiDoneSettingDiType	;draw a dialog, and allows theSW_PrStlDialog				stz			PrDiSDialogType+1		;user to modify that dataPrDiDoneSettingDiType*							lda			StackParam+0,s			;get handle param from caller							sta			printRecordHandle+0							lda			StackParam+2,s							sta			printRecordHandle+2*							import		GetOkOurDriver			;ensure a valid rec for this driver							jsr			GetOkOurDriver			;Metrics: Same driver as last time?							beq			PrDiAllCorrect			;yes, this print record is ours							import		InitPrintRecord			;not same driver as last time, so							jsr			InitPrintRecord			;take over print record for us							import		CalcMetricsPrDiAllCorrect				jsr			CalcMetrics				;make sure self-consistent, though*							import		CheckAndDoLowMemAlert	;put up warning dialog if neccessary							jsr			CheckAndDoLowMemAlert	;A will have 1/0 if OK/Cancel							cmp			#0						;if cancel, quit now with Cancel hit							beq			PrDiDiDone				;else we go on to display stl/job diPrDiSDialogType				lda			#$FFFF					;NOTE: operand is stuffed							import		ConductStyleJobDialog	;go do stl or job dialog							jsr			ConductStyleJobDialog	;A will have 1/0 if OK/CancelPrDiDiDone*							sta			StackParam+4,s			;return confirmFlag in A to user							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrDriverVer				lda			#VersionID				;This routine returns the version							sta			StackParam+0,s			;number of this particular driver*							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrOpenDoc				lda			StackParam+0,s			;This routine clears error status,							sta			printGrafPortPtr+0		;and initializes and sets a GrafPort							lda			StackParam+2,s			;with boundsrect, etc., configured							sta			printGrafPortPtr+2		;for the resolution of the printer.							lda			StackParam+4,s			;If printGrafPtr is NIL, we allocate							sta			printRecordHandle+0		;our own space, else we use the							lda			StackParam+6,s			;caller's GrafPort and configure it.							sta			printRecordHandle+2*							import		OpenDoc							jsr			OpenDoc					;print loop routine*							lda			printGrafPortPtr+0		;pass GrafPort back to user,							sta			StackParam+8,s			;in case we allocated it here...							lda			printGrafPortPtr+2							sta			StackParam+10,s							ldx			#8						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrCloseDoc				lda			StackParam+0,s			;this routine closes the printing							sta			printGrafPortPtr+0		;grafport, frees its memory if the							lda			StackParam+2,s			;caller passed NIL during OpenDoc,							sta			printGrafPortPtr+2		;restores grafport and stops spooling*							import		CloseDoc							jsr			CloseDoc				;print loop routine*							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrOpenPage				lda			StackParam+0,s			;This routine keeps track of #pages							sta			pageFramePtr+0			;and works only if within page range							lda			StackParam+2,s			;this routine calls OpenPicture with							sta			pageFramePtr+2			;pageframe of rPage or user-select							lda			StackParam+4,s			;the current (print) grafport is							sta			printGrafPortPtr+0		;re-initialized, and SpoolPut is							lda			StackParam+6,s			;called explicitly to store initial							sta			printGrafPortPtr+2		;info PutPic doesn't get called for*							import		OpenPage							jsr			OpenPage				;print loop routine*							ldx			#8						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************							import		ClosePage				;This routine terminates a pageSW_PrClosePage				jsr			ClosePage				;print loop routine*							ldx			#4						;# of input param bytes to strip							brl			Exit					;(we didn't need input parameters)********************************************************************************************************************************************************************************************************SW_PrPicFile				ldx			#12						;Does nothing; we only do imm mode							brl			Exit					;# of input param bytes to strip********************************************************************************************************************************************************************************************************							import		GetPrintLoopErrorSW_PrError					jsr			GetPrintLoopError		;err in acc from print loop routine							sta			StackParam+0,s							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************							import		SetPrintLoopErrorSW_PrSetError				lda			StackParam+0,s			;get in acc							jsr			SetPrintLoopError		;print loop routine							ldx			#2						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrChanged				pushlong	#PrChDevNameStr			;Informs port driver of type of							ldx			#$1913					;device; important for networking							jsl			$E10000					;_PrDevPrChanged							ldx			#0						;# of input param bytes to strip							brl			Exit					;we're donePrChDevNameStr				str			'='						;ID string in appletalk NBP format							str			'IJ10'					;even though appletalk is not							str			'*'						;supported in this driver********************************************************************************************************************************************************************************************************							import		ImagerOpen				;start the imager and communicationSW_PrPixelMap				jsr			ImagerOpen							lda			StackParam+6,s			;get caller's srcLocPtr lo in X							tax							lda			StackParam+8,s			;get caller's srcLocPtr hi in Y							tay							import		ImagerSetLocInfo		;tell imager about caller's locinfo							jsr			ImagerSetLocInfo							import		ImagerSetGrays			;tell imager about current colors							jsr			ImagerSetGrays							lda			#0						;prepare to print							import		ImagerReady							jsr			ImagerReady							import		ImagerPrint				;print the caller's locinfo bitmap							jsr			ImagerPrint							import		ImagerFormfeed			;do form feed							jsr			ImagerFormfeed							import		ImagerClose				;stop the imager and communication							jsr			ImagerClose*							ldx			#10						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrGetPrinterSpecs		lda			#DeviceID		 		;pass our device identification							sta			StackParam+0,s							lda			#1						;pass "1" -- black/white only							sta			StackParam+2,s							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************SW_PrGetPgOrientation		lda			StackParam+0,s			;This routine returns the value							sta			printRecordHandle+0		;of the orientation setting just							lda			StackParam+2,s			;to try to keep the application out							sta			printRecordHandle+2		;of the print record*							lda			#0						;Orientation is always portrait							sta			StackParam+4,s*							ldx			#4						;# of input param bytes to strip							brl			Exit****************************************************************************************************							endproc							end