*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: printloop.a -- High-level sequencer that loops for pages/copies/bands      **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1991 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.h'							include		'm16.util'							include		'e16.quickdraw'							include		'm16.quickdraw'							include		'm16.qdaux'							include		'm16.font'							include		'm16.memory'							include		'e16.print'							include		'm16.intmath'							include		'm16.misctool'							include		'm16.event'							include		'm16.locator'PrintLoopProc				proc		export**HIGH-LEVEL PRINT LOOP CALLS: High-Level printing loop management calls implementing*the old Macintosh Printing Manager print model, but breaking several rules for performance.*The functionality of the calls implemented below can be summarized as follows:**	OpenDoc		Allocates offscreen buffer for DrawPicture, establishes I/O, initializes variables*	OpenPage	Resets variables, begins pict recording*	ClosePage	Stops pict recording; for each copy, redraws and prints a page in slices*	CloseDoc	Deallocates all buffers, resets QD globals, closes I/O**GETPRINTLOOPERROR and SETPRINTLOOPERROR allow access to the global PrError error status.  There*are also a few other routines in this module which are used by the high level routines above.**In this driver, the page definitions of the entire document are not saved during the OpenDoc/*CloseDoc sequence for playback during PicFile; rather, the copy(s) of each page are printed*from inside ClosePage; this is why there is no PicFile call.  If an OpenDoc call follows a*CloseDoc call within a short amount of time, then some of OpenDoc's initialization activities*are not performed, allowing better operation with programs that treat each page as a separate*document.  Draft/Text mode is not supported.  Color is not supported.  The page definition is*pre-clipped to ease the CPU horsepower burden on QuickDraw's DrawPicture call.  Only portrait*orientation is supported; very limited print scaling options are supported.***OPENDOC: Allocates and prepares resources for printing.  Performs the following tasks:**	Set "Is Page As Job" flag if a CloseDoc call just occurred a short time ago*	Save the user's current grafport for later restore*	Clear error status, setup level, and page counter*	Put up box for status messages*	Initialize our global variables using information from print record*	Allocate as much memory as possible for banding buffer and calculate its size in pixels*	Open and setup a grafport to draw the bands, using the memory obtained above*	Set up QuickDraw globals to handle increased drawing size requirements*	Open, setup, and make current the grafport that the app will see for recording pict definition;*	note that this is a different grafport than the one used to manage the banding buffer*	Open communication channel with printer*	Configure the imager/printer with information about our band buffer, resolution settings, etc.*	Show dialog allowing termination if app asks for unsupported driver features; this is done*	last during the setup process so that normal setup and unsetup is done in the cancel case*							export		OpenDocOpenDoc*Set "Is Page As Job" flag only if a CloseDoc call just occurred a few seconds ago:							stz			OpDoIsPgAsJob			;initially assume the answer is no							lda			OpDoIsPgAsJobIsTimeSet	;check to see if time was ever set							beq			OpDoFindOutPgAsJobDone	;no, so we'd better not check time							pha									;get current tick count							pha							_GetTick							plx									;get tick count lo word in X							ply									;get tick count hi word in Y							cpy			OpDoIsPgAsJobTime+2		;compare hi words first							beq			OpDoFindOutPgAsJobCmpLo	;if equal, go compare lo words							bcs			OpDoFindOutPgAsJobDone	;if we're past the time, don't setOpDoFindOutPgAsJobCmpLo		cpx			OpDoIsPgAsJobTime+0		;compare lo words next							bcs			OpDoFindOutPgAsJobDone	;again, if we're greater, don't set							lda			#1						;only if the current time is less							sta			OpDoIsPgAsJob			;than "OpDoIsPgAsJobTime" set flagOpDoFindOutPgAsJobDone*Save current caller's grafport for later restore by CloseDoc routine in all cases:							pha							pha							_GetPort							pulllong	OpDoOldUserGrafPortPtr*Clear error status which can be set to render most of the print loop calls ineffective:							lda			OpDoIsPgAsJob			;don't do this if page-as-job							bne			OpDoDoneClrErrStat							stz			OpDoErrorStatusOpDoDoneClrErrStat							*Make setup level 0.  We increment whenever we start something up, to facilitate legal shutdown:							stz			OpDoSetupLevel*Clear the logical-page counter which is later used to see if we're in page range:							lda			OpDoIsPgAsJob			;don't do this if page-as-job							bne			OpDoDoneClrPgCtr							stz			OpDoPageCounterOpDoDoneClrPgCtr*Put up box for status messages, which also changes to the wait cursor:							import		GetStatMesgDisable		;get A=0/1 if enable/disable							jsr			GetStatMesgDisable							import		StartStatusMessage		;pass 0/1 to open mesg box routine							jsr			StartStatusMessage*Save print record data needed by Open/Close-Page/PutText/Etc, which can't access print record:							import		GetPageRange			;page range (from..to) bounds							jsr			GetPageRange							stx			OpDoPageRange1st							sty			OpDoPageRangeLst*							import		GetCopies				;number of copies of each page							jsr			GetCopies							sta			OpDoTotalCopies*							stz			OpDoIsManFeed			;manual or automatic sheet feed							import		GetFeed							jsr			GetFeed							bne			OpDoDoneSetFeed							inc			OpDoIsManFeedOpDoDoneSetFeed*							import		GetRPageSize			;rPage calculation results							jsr			GetRPageSize							stx			OpDoRPageX2							sty			OpDoRPageY2*							import		GetImagingSize			;scaled-up page size calc results							jsr			GetImagingSize							stx			OpDoImgSzX2							sty			OpDoImgSzY2*							import		Get640PixMapDisable		;PutPixels needs this to disable							jsr			Get640PixMapDisable		;our special 640 pixmap handling							sta			OpDoIs640PixMapDisable	;if app wants it*							import		GetLineLayoutDisable	;PutText needs this to disable							jsr			GetLineLayoutDisable	;line layout if app wants it							sta			OpDoIsLineLayoutDisable*							import		GetForceTxMDisable		;PutText needs this to disable							jsr			GetForceTxMDisable		;forcing text mode if app wants it							sta			OpDoIsForceTxMDisable*							import		GetQuality				;PutText/PutPixels needs this for							jsr			GetQuality				;correct scaling adjustments							sta			OpDoIsQualityHigh							*Put up message to show that we're now going to be allocating banding memory:							import		StMeMallocMesg							lda			#StMeMallocMesg							import		StatusMessage							jsr			StatusMessage							*Ask for memory compaction explicitly at this time:							_CompactMem							*Starting to create locinfo to be used by off-screen banding grafport.  Store band tallness/width:							import		GetImagingSize			;get the scaled-up size of the page							jsr			GetImagingSize			;image, given current quality setting							stx			OpDoLocInfoRect+oh2		;store X2; will be modified							sty			OpDoLocInfoRect+ov2		;store Y2; will be modified*Begin loop to figure out maximum Y size for banding, with many constraints:							bra			OpDoAlignBandSize		;go align first to begin with**Get smaller band by cutting Y size down, and align Y size to an even-imager-multiple:OpDoTrySmallerBand			lda			OpDoLocInfoRect+ov2		;port: try smaller Y band size							asl			OpDoLocInfoRect+ov2		;do Y bandsize *= 3/4 by doing							clc									;*3 followed by /4 and put in place							adc			OpDoLocInfoRect+ov2							lsr a							lsr a							sta			OpDoLocInfoRect+ov2OpDoAlignBandSize			pha									;align to multiple for pr head pins							pha							pushword	OpDoLocInfoRect+ov2							import		ImagerGetVAlignFactor							jsr			ImagerGetVAlignFactor	;obtain vertical align factor in ACC							pha							_UDivide							pla									;ignore quotient from divide							pullword	ParamWordA				;get remainder							lda			OpDoLocInfoRect+ov2		;subtract to align it...							sec							sbc			ParamWordA							bcc			OpDoCantGetBandMem		;can't make it any smaller...							beq			OpDoCantGetBandMem							sta			OpDoLocInfoRect+ov2							bra			OpDoCalcLocInfoWidthOpDoCantGetBandMem			lda			#$0201					;abort with memory full tool err...OpDoExitAbortErrInACC		sta			errNo							sta			OpDoErrorStatus							rts**Figure out loc info width based on mode (320/640) in effect at recording time and loc info X size:							import		GetModeByte				;metrics to obtain 320/640 modeOpDoCalcLocInfoWidth		jsr			GetModeByte				;for finding number pixels per byte							sta			OpDoLocInfoSCB			;also put mode byte in locinfo							and			#$80					;check 320/640 mode bit...							cmp			#1						;...set carry if 640 mode							lda			OpDoLocInfoRect+oh2		;get rPage X2 in ACC							bcc			OpDoIts320				;320, so only divide rPageX2 by 2							lsr	a								;divide by 4 (640 mode), or...OpDoIts320					lsr	a								;by 2 (320 mode) -> # bytes per line							sta			OpDoLocInfoWidth		;store band width in bytes**Figure out how big the band buffer will be, given the above (width still in ACC):							pha									;result space for multiply...							pha							pha									;locinfo.width (bytes) still in acc							lda			OpDoLocInfoRect+ov2		;times number of lines...							ina							pha							_Multiply							pulllong	ParamLongB				;plB now has pix buff size we want							**Check if buffer size would be greater than 1/4 of the amount of free memory:OpDoCmpFreeMem				pha							pha							_RealFreeMem							plx							pla							lsr a							tay							txa							ror	a							tax							tya							lsr a							tay							txa							ror a								;now have free_mem/4 lo->A, hi->Y							cpy			ParamLongB+2			;cmp hi words							beq			OpDoCmpFreeMem1							bcs			OpDoCmpFreeMemOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpFreeMem1				cmp			ParamLongB+0			;cmp lo words							bcs			OpDoCmpFreeMemOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpFreeMemOk**Check if buffer size would be greater than maximum QD-allowed pix buffer size:OpDoCmpMaxPixBuff			lda			ParamLongB+2			;cmp hi words							cmp			#QDMaxPixBuff/65536							beq			OpDoCmpMaxPixBuff1							bcc			OpDoCmpMaxPixBuffOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpMaxPixBuff1			lda			ParamLongB+0			;cmp lo words							cmp			#QDMaxPixBuff//65536							bcc			OpDoCmpMaxPixBuffOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpMaxPixBuffOk**Try asking for the memory for imaging bands and also obtain a PID for later mallocs/deallocs:OpDoDoBandMalloc			pha									;result space							pushword	#UserIDType				;type of process requesting ID							_GetNewID							;obtain PID							pullword	OpDoMemPID				;get it							pha									;result space...							pha							pushlong	ParamLongB				;pass size of block requested							pushword	OpDoMemPID				;pass PID							pushword	#$C000					;pass attr: locked/fixed							pha									;pass dummy location							pha							_NewHandle							pulllong	ParamLongA				;get handle, if we got one							bcc			OpDoOKBandMalloc		;go on if we got one							pushword	OpDoMemPID				;didn't get handle, try again...							_DeleteID							brl			OpDoTrySmallerBandOpDoOKBandMalloc			inc			OpDoSetupLevel			;bump the setup level to "1"*Dereference the handle and put the pointer in our locinfo:							lda			[ParamLongA]							sta			OpDoLocInfoPixPtr+0							ldy			#2							lda			[ParamLongA],y							sta			OpDoLocInfoPixPtr+2*Start banding gport.  This gp is one "band" into which slices of pictures are drawn & printed:							pushlong	#OpDoBandGrafPort		;init fields of grafport, alloc clip							_OpenPort							;and make it the current gp for now							bcc			OpDoOKOpenBandPort		;check for error							brl			OpDoExitAbortErrInACCOpDoOKOpenBandPort*The locinfo was prepared above, so now use it:							pushlong	#OpDoLocInfo			;attach our locinfo to our grafport							_SetPortLoc*Set QuickDraw's global internal clip buffers to handle the bigger size of our offscreen bitmap:							pushlong	#OpDoOldQDBuffRec		;save original buffer widths							_SaveBufDims*							lda			OpDoLocInfoWidth		;buff size for horiz num of bytes...							cmp			OpDoOldQDBuffMWid		;but never ever smaller!							bcs			OpDoSetBufDims1							lda			OpDoOldQDBuffMWidOpDoSetBufDims1				pha									;pass it to SetBufDims*							lda			OpDoOldQDBuffTxHi		;buff size height for font stuff...							lsr a							lsr a							clc							adc			OpDoOldQDBuffTxHi							pha									;pass it to SetBufDims*							lda			OpDoOldQDBuffFBRx		;buff size for font style mods...							pha									;pass it to SetBufDims*							_SetBufDims							;ask QD for bigger buffers							bcc			OpDoOKSetBufDims							brl			OpDoExitAbortErrInACC	;if err, abort pr loop and tool errOpDoOKSetBufDims			inc			OpDoSetupLevel			;if ok, bump setup level to "2"*Set port rect, clip rgn, and vis rgn of band gp to now-known rect instead of screen-sized defaults:							pushlong	#OpDoLocInfoRect		;(1) set main grafport rect							_SetPortRect							pushlong	#OpDoLocInfoRect		;(2) set clip region							_ClipRect							pha									;(3) set vis region							pha							_GetVisHandle						;leave hdl on stack for SetRectRgn							pushword	OpDoLocInfoRect+oh1							pushword	OpDoLocInfoRect+ov1							pushword	OpDoLocInfoRect+oh2							pushword	OpDoLocInfoRect+ov2							_SetRectRgn							*Install our own bottleprocs into the band buffer grafport and save the addresses of real procs:							pushlong	#OpDoOldPlyQDProcs		;save addresses of the real procs							_SetStdProcs						;and also get list for our install							pushlong	#OpDoNewPlyQDProcs		;into our band port; will be called							_SetStdProcs						;from inside DrawPicture														import		GetPict							lda			#(GetPict-1)							sta			OpDoNewPlyQDProcs+ostdGetPic+0							lda			#^(GetPict-1)							sta			OpDoNewPlyQDProcs+ostdGetPic+2														import		PutText							lda			#(PutText-1)							sta			OpDoNewPlyQDProcs+ostdText+0							lda			#^(PutText-1)							sta			OpDoNewPlyQDProcs+ostdText+2														import		PutPixels							lda			#(PutPixels-1)							sta			OpDoNewPlyQDProcs+ostdPixels+0							lda			#^(PutPixels-1)							sta			OpDoNewPlyQDProcs+ostdPixels+2														pushlong	#OpDoNewPlyQDProcs		;install our procs							_SetGrafProcs							*Calculate # of band passes needed: (Imaging Y Size) / Band Y Size, rounded up, with remainder:							import		GetImagingSize			;get size of offscreen buffer we							jsr			GetImagingSize			;would have liked... will compare							tya									;portrait mode: get Y size in acc							ldx			OpDoLocInfoRect+ov2		;now ACC & X valid, go calc							stx			OpDoLastBandHeight		;ACC has imgsize,   ;initialize this							pha									;X has bandsize     ;result space							pha									;result space							pha									;pass tallness of pic to be printed							phx									;pass tallness of our band buffer							_UDivide							pla									;get quotient (# whole bands) in ACC							plx									;get remainder (# lines) in X							beq			OpDoCalcPassesStore		;skip next few lines if no remainder							stx			OpDoLastBandHeight		;if non-0 rem thn its sz of lst band,							ina									;and inc, must do 1 more smaller bandOpDoCalcPassesStore			sta			OpDoTotalBands			;now store number of passes needed*Now that we have a banding buffer and its grafport, set up memory for a 2nd gp for pict recording:							lda			printGrafPortPtr+0		;first copy the user-given parameter							sta			OpDoCalcGrafPortPtr+0	;to our own ptr-storage. if not nil,							lda			printGrafPortPtr+2		;then we'll use it; else, we point							sta			OpDoCalcGrafPortPtr+2	;our pointer at our storage and also							ora			printGrafPortPtr+0		;return the address of our storage							bne			OpDoMallocCalcGPDone	;back to the caller...							lda			#OpDoCalcGrafPort							sta			printGrafPortPtr+0							sta			OpDoCalcGrafPortPtr+0							lda			#^OpDoCalcGrafPort							sta			printGrafPortPtr+2							sta			OpDoCalcGrafPortPtr+2OpDoMallocCalcGPDone*Open the calc/record gp and make *it* the curr gp.  OpenPage will re-init it for each new page:							pushlong	OpDoCalcGrafPortPtr		;now use user's or our memory							_OpenPort							;as a grafport and alloc clip rgns							bcc			OpDoNoPortErr							brl			OpDoExitAbortErrInACC	;if err exit with acc setOpDoNoPortErr				_HidePen							;this port will never draw on screen							*Put up message to show that we're sending setup commands to the printer:							import		StMePrinterResetMesg							lda			#StMePrinterResetMesg							import		StatusMessageWait							jsr			StatusMessageWait							*Init imager and get unique connection with device; if err, show mesg, cause print loop abort, exit:							import		ImagerOpen							jsr			ImagerOpen				;call imager, which calls comm							bcc			OpDoImagerOpenOK		;skip following few lines if ok							import		StMeCantOpenMesg							lda			#StMeCantOpenMesg							import		StatusMessageWait							jsr			StatusMessageWait		;put complaint up in status box							import		DoCantOpenAlert							jsr			DoCantOpenAlert			;conduct error dialog box with userOpDoExitAbortButNoTErr		lda			#prAbort							sta			OpDoErrorStatus			;set PrError status and exit							rtsOpDoImagerOpenOK*Configure the imager with bandbuffer locinfo, quality, mode, idleproc, and other settings:							ldx			#OpDoLocInfo							ldy			#^OpDoLocInfo			;pass pointer to our band buffer							import		ImagerSetLocInfo		;locinfo struct to imager:							jsr			ImagerSetLocInfo		;lo->X, hi->Y*							import		ImagerSetGrays			;allow imager to build grayscales							jsr			ImagerSetGrays			;from current color table settings*							lda			OpDoIsManFeed			;pass 0/1 if auto/man feed to imager							import		ImagerSetFeed							jsr			ImagerSetFeed*							import		GetQuality				;get res setting from quality setting							jsr			GetQuality				;in print record in A and pass to							import		ImagerSetResolution		;imager in A; imgr will print smaller							jsr			ImagerSetResolution		;to compensate for our blown-up image*							import		GetVSize				;get vert 50% reduction setting from							jsr			GetVSize				;print record: A=0/1 if 100%v/50%v							import		ImagerSetVCondense		;pass this information back in A							jsr			ImagerSetVCondense		;to the imager*							import		GetIdleProc				;get idleproc pointer from print							jsr			GetIdleProc				;record: lo->X, hi->Y							import		ImagerSetIdleProc		;pass idleproc pointer to							jsr			ImagerSetIdleProc		;imager: lo->X, hi->Y*							ldx			#OpDoErrorStatus		;provide imager with the address of							ldy			#^OpDoErrorStatus		;the global prError status so that							import		ImagerSetAbortPoll		;it can abort if it ever goes nonzero							jsr			ImagerSetAbortPoll		;lo->X, hi->Y							*Set status proc pointer in communications module so we can deal with recoverable printer problems:							import		CommSetStatusProc							ldx			#PrinterStatusHandler							ldy			#^PrinterStatusHandler							jsr			CommSetStatusProc							*Request that the imager initialize the device for printing:							lda			OpDoIsPgAsJob			;get 0/1 if normal/pg-as-job							import		ImagerReady				;pass it: if pg-as-job condition,							jsr			ImagerReady				;then printer-reset won't be done							*Put up message to show that we're out of opendoc (many apps take quite a while after this):							import		StMePrepRxPgDataMesg							lda			#StMePrepRxPgDataMesg							import		StatusMessageWait							jsr			StatusMessageWait							*Warn user if application is asking for unsupported driver features and allow print loop abort:							import		CheckAndDoFeatureAlert	;check if ok							jsr			CheckAndDoFeatureAlert							cmp			#0							beq			OpDoDoneFeatureCheck	;if ok, just go on							lda			#prAbort				;else set the abort but allow							sta			OpDoErrorStatus			;normal setup/unsetup/abortOpDoDoneFeatureCheck							*Exit from tool call; current grafport is the rec/calc gp; next expected call will be OpenPage:							rts*Static memory for holding QuickDraw's GrafPort drawing-environment-context data structures:OpDoBandGrafPort			ds.b		$AA						;port to manage banding bufferOpDoCalcGrafPort			ds.b		$AA						;port for calc/recording; app seesOpDoOldUserGrafPortPtr		dc.l		0						;user's currnt port before print loopOpDoCalcGrafPortPtr			dc.l		0						;pointer to our or user's calc port*User ID for mallocing memory during this routine for banding buffer, etc:							export		OpDoMemPID				;patches need accessOpDoMemPID					dc.w		0*GrafPort.LocInfo record describing banding buffer (offscreen pixelmap):							export		OpDoLocInfoRect			;patches need accessOpDoLocInfo:													;struct defining pixelmapOpDoLocInfoSCB				dc.w		0						;portSCBOpDoLocInfoPixPtr			dc.l		0						;ptrToPixImage ptr to imaging bufferOpDoLocInfoWidth			dc.w		0						;width of one scan line in bytesOpDoLocInfoRect				dc.w		0,0,0,0					;boundsRect in pixels*Further information about the bands into which the page image will be rendered:OpDoTotalBands				dc.w		0						;number of bands page is split intoOpDoLastBandHeight			dc.w		0						;height of special-case last band*Area for patching our bottleprocs into the banding-buffer-playback grafport and saving old procs:							export		OpDoOldPlyQDProcs		;patches need accessOpDoOldPlyQDProcs			ds.b		$38						;bottleneck proc pointersOpDoNewPlyQDProcs			ds.b		$38						;bottleneck proc pointers*QuickDraw global buffer size information record storage:OpDoOldQDBuffRec:												;to save/alter/restore QD buffersOpDoOldQDBuffMWid			dc.w		0OpDoOldQDBuffTxHi			dc.w		0OpDoOldQDBuffTxWi			dc.w		0OpDoOldQDBuffFBRx			dc.w		0*Setup-status used to shut things down correctly and global print-loop-error ("PrError") status:OpDoErrorStatus				dc.w		0						;our global error statusOpDoSetupLevel				dc.w		0						;0)mesg box 1)band malloc 2)bufdims*Variables to investigate and report if each page is being treated as its own job:OpDoIsPgAsJobIsTimeSet		dc.w		0						;0=init 1=time set at least onceOpDoIsPgAsJobTime			dc.l		0						;time+offset, as set by CloseDocOpDoIsPgAsJob				dc.w		0						;result: 0=normal 1=page-as-job*Information obtained from metrics calls needed later which require print record presence:							export		OpDoIs640PixMapDisable	;patches need access							export		OpDoIsLineLayoutDisable	;patches need access							export		OpDoIsForceTxMDisable	;patches need access							export		OpDoIsQualityHigh		;patches need accessOpDoTotalCopies				dc.w		0						;number of copies requestedOpDoPageRange1st			dc.w		0						;first page number requestedOpDoPageRangeLst			dc.w		0						;last page number requestedOpDoIsManFeed				dc.w		0						;GetFeed call result @ OpenDocOpDoRPageX2					dc.w		0						;from rPage from metricsOpDoRPageY2					dc.w		0						;from rPage from metricsOpDoImgSzX2					dc.w		0						;from get-imaging-size from metricsOpDoImgSzY2					dc.w		0						;from get-imaging-size from metricsOpDoIs640PixMapDisable		dc.w		0						;flag 1=disabling special 640 pixmapOpDoIsLineLayoutDisable		dc.w		0						;flag 1=disabling line layoutOpDoIsForceTxMDisable		dc.w		0						;flag 1=disabling forcing text modeOpDoIsQualityHigh			dc.w		0						;flag shows resolution 0=lo,1=hi*Keeping track of the number of times OpenPage/ClosePage pair is called:OpDoPageCounter				dc.w		0**OPENPAGE: Designates beginning of page definition.  Performs the following tasks:**	Exit if error status*	Ensure that we are using our or the user's grafport memory for the recording grafport*	Init, and make current, the recording grafport to all default penwidth, fonts, colors, etc.*	Inc page count and check to make sure we're inside page range: exit if no, set flag if yes*	Begin picture recording; all subsequent application's QuickDraw commands will be recorded*							export		OpenPageOpenPage*Check to make sure no print error exists; if so, disable this routine:							lda			OpDoErrorStatus							beq			OpPaDontDisableOpPaExit1					rtsOpPaDontDisable*Ensure that our pointer to the calculation/recording grafport is up to date if owned by caller:							lda			printGrafPortPtr+0							tax							ora			printGrafPortPtr+2							beq			OpPaDoneUpdateCalcGPPtr							stx			OpDoCalcGrafPortPtr+0							lda			printGrafPortPtr+2							sta			OpDoCalcGrafPortPtr+2OpPaDoneUpdateCalcGPPtr*Init the recording gp to all-default settings for new page, and set it as the current grafport:							lda			OpDoCalcGrafPortPtr+2	;get a copy of the calc grafport ptr							sta			ParamLongA+2			;and also pass it on the stack...							pha							lda			OpDoCalcGrafPortPtr+0							sta			ParamLongA+0							pha							_InitPort							;init and set as current gp							lda			#0						;zero the bounds rect so that							ldy			#oBoundsRect			;no physical drawing occurs; we doOpPaZeroBoundsRectLoop1		sta			[ParamLongA],y			;this here even if we're not in							iny									;page range							iny							cpy			#oBoundsRect+8							bne			OpPaZeroBoundsRectLoop1*Increment abs pg count so we can compare it against user-selected pg range; first number is 1:							inc			OpDoPageCounter*Show message in box that says we are recording, but not yet printing, the current page number:							import		StMeRxCurrentPgMesg							lda			#StMeRxCurrentPgMesg							ldx			OpDoPageCounter							jsr			ShowStatusWithParam*Assume we're not in page range; this flag may be modified in a moment:							stz			OpPaInPageRange*Check page range, we want no action if this page isn't to be printed, so exit if out of pg range:							lda			OpDoIsPgAsJob			;check if page-as-job							beq			OpPaCheckPgRangeNormal	;if not, check it straightforwardly							OpPaCheckPgRangeForPgAsJob	lda			OpDoPageRange1st		;if page-as-job, we know we're in							cmp			#2						;range if only 1stpage < 2							bcc			OpPaItsInPageRange							bra			OpPaExit1							OpPaCheckPgRangeNormal		ldx			OpDoPageRange1st		;see if we're going to do anything...							ldy			OpDoPageRangeLst		;at all... 1stpage->X Lstpage->Y							cpx			OpDoPageCounter			;cmp current page# with first page#							bcc			OpPaItsInRange1st		;current page# >= first page#...							bne			OpPaExit1				;abort if out of page rangeOpPaItsInRange1st			cpy			OpDoPageCounter			;cmp current page# with last page#							bcc			OpPaExit1				;if not current page# <= last page#OpPaItsInPageRange*Tell ClosePage that we're really going to be recording a page for printing:							lda			#1							sta			OpPaInPageRange*Fill in X2,Y2 in rectangle/data used several times in a few moments:							lda			OpDoRPageX2				;get calculated size							sta			OpPaPicFrameX2			;store into our rect's X2,Y2...							lda			OpDoRPageY2							sta			OpPaPicFrameY2							stz			OpPaPicFrameX1			;also zero X1,Y1 in case it							stz			OpPaPicFrameY1			;was modified last time*But if user passed a non-NIL picture frame (scaling) rectangle, use it instead of ours:							lda			pageFramePtr+0			;check user picture frame for NIL...							ora			pageFramePtr+2							beq			OpPaDoneCpUsrPicFrame	;branch away if user passed NIL							ldy			#0						;else copy their rect...OpPaCpUsrPicFrameLoop1		lda			[pageFramePtr],y							sta			OpPaPicFrame,y							iny							iny							cpy			#8							bne			OpPaCpUsrPicFrameLoop1OpPaDoneCpUsrPicFrame*Set all clipping settings of the recording grafport to rPage rect or user's rect:							pushlong	#OpPaPicFrame			;(1) set main grafport rect							_SetPortRect							pushlong	#OpPaPicFrame			;(2) set clip region							_ClipRect							pha									;(3) set vis region							pha							_GetVisHandle						;leave hdl on stack for SetRectRgn							pushword OpPaPicFrame+oh1							pushword OpPaPicFrame+ov1							pushword OpPaPicFrame+oh2							pushword OpPaPicFrame+ov2							_SetRectRgn*Set some of the bottleprocs in the recording grafport to our patch procs:							pushlong	#OpPaRecQDProcs							_SetStdProcs														import		PutPict							lda			#(PutPict-1)							sta			OpPaRecQDProcs+ostdPutPic+0							lda			#^(PutPict-1)							sta			OpPaRecQDProcs+ostdPutPic+2														pushlong	#OpPaRecQDProcs							_SetGrafProcs							*Tell QuickDraw to start making drawing commands go into picture definition and not to screen:							import		SpoolStartPut			;get our VM routines ready							jsr			SpoolStartPut														pha									;compensate for quirk where we							_GetMasterSCB						;must store the first part of PICT							pullword	OpPaPicSCB				;ourselves if GetPic/PutPic patched							lda			#10						;length: 10 bytes							sta			ParamLongB+0							stz			ParamLongB+2							lda			#OpPaPicSetupHeader		;ptr: our struct							sta			ParamLongC+0							lda			#^OpPaPicSetupHeader							sta			ParamLongC+2							import		SpoolPut				;go store the beginning bytes							jsr			SpoolPut														pha									;result space...							pha							pushlong	#OpPaPicFrame			;user's or our picframe							_OpenPicture						;has effect of a "_HidePen"							pulllong	OpPaUnusedPictHdl		;save this even though spooling*Done; current gp is the rec/calc port; app will do qd commands now which will be recorded:OpPaExit					rts*PICT setup struct and picture frame rectangle for passing to OpenPicture and to ClipRect:OpPaPicSetupHeaderOpPaPicSCB					dc.w		0						;SCBOpPaPicFrameOpPaPicFrameY1				dc.w		0						;Y1OpPaPicFrameX1				dc.w		0						;X1OpPaPicFrameY2				dc.w		0						;Y2OpPaPicFrameX2				dc.w		0						;X2*Handle to the picture containing the definition of the current page:OpPaUnusedPictHdl			dc.l		0						;handle from QD pict calls*Flag to indicate whether we are actually recording and printing the current page:OpPaInPageRange				dc.w		0						;are we really doing a page*Patch area for setting our bottleprocs into recording grafport:OpPaRecQDProcs				ds.b		$38						;bottleneck proc pointers**CLOSEPAGE: Designates end of page definition.  Performs the following tasks:**	Exit if error or abort status, or if we weren't in selected from..to page range*	Finish the picture recording process*	Apply font manager performance patch*	Loop for all copies*	Do manual sheet-feed dialog, if necessary; allow abort request*	Loop for all bands*	Call DrawPicture to render marks within the band for which we have memory, at blown-up size*	Call Imager to cause the printer to mark the paper with the data in banding memory*	Disable the print loop if abort is requested by application or user*	Deallocate recorded page definition storage*	Remove font manager performance patch*							export		ClosePageClosePage*Check print loop status; if set, then disable this routine:							lda			OpDoErrorStatus							beq			ClPaDontDisableClPaExit1					rtsClPaDontDisable*Check if currently in page range, ie, check if OpenPage really recorded a page for us:							lda			OpPaInPageRange							beq			ClPaExit1							*We've obtained a PICT defining current page contents, so stop recording:							_ClosePicture						;tell QD to stop recording														import		SpoolFinishPut			;tell VM routines to stop recording							jsr			SpoolFinishPut							import		SpoolStartGet			;tell VM routines ready for playback							jsr			SpoolStartGet							import		SpoolMarkGet			;tell VM routines where to return to							jsr			SpoolMarkGet							*Now switch from the recording grafport to the playback/banding grafport:							pushlong	#OpDoBandGrafPort							_SetPort*Apply our patch for "InstallWithStats" font manager call which is called during DrawPicture:							import		ClipInstallWithStats							pha							pha							pushword	#0						;system tool set							pushword	#027					;tool set 27: Font Manager							_GetTSPtr							pulllong	ParamLongA							ldy			#4*$1C					;save real "InstallWithStats" adrs							lda			[ParamLongA],y							ina							sta			ClPaOldIWSAddr+0							iny							iny							lda			[ParamLongA],y							sta			ClPaOldIWSAddr+2							ldy			#4*$1C					;patch "InstallWithStats" adrs							lda			#ClipInstallWithStats							dea							sta			[ParamLongA],y							iny							iny							lda			#^ClipInstallWithStats							sta			[ParamLongA],y**Initialize for looping through multiple copies of the current page:							lda			#1						;we'll count real-copy-numbers							sta			ClPaCurrentCopy			;from 1..TotalCopies**Status message: initialize for alternating page/copy display; always show PAGE first:							stz			SpcCounterForCpPgMsg**Head of code to print one copy:ClPaPrintOneMoreCopy		**Do manual-sheet-feed dialog with user if necessary; allow cancel option:							lda			OpDoIsManFeed			;find out if we have to do dialog							beq			ClPaManFeedDiDone		;don't do dialog if auto feed							import		StatusMessageManFeed	;put up the dialog until the user							jsr			StatusMessageManFeed	;hits ok or cancel							bcc			ClPaManFeedDiDone		;if carry set, user hit cancel							brl			ClPaMesgAbortPrintLoop	;in which case go terminateClPaManFeedDiDone**Status message:  show/refresh short-lived page/copy number status:							jsr			ShowPageOrCopyMesg***Initialize for looping through bands to print the picture a slice at a time:							lda			#1						;real-band-numbers starting at 1							sta			ClPaCurrentBand			;we'll stop at OpDoTotalBands***Head of code to print one band:ClPaPrintOneMoreBand***Get the scaled-up picture-playback size:							lda			OpDoImgSzX2				;store as 0,0,Y2,X2...							sta			ClPaDestRect+oh2							lda			OpDoImgSzY2							sta			ClPaDestRect+ov2							stz			ClPaDestRect+oh1							stz			ClPaDestRect+ov1***Calculate offset to play back the next part of picture into the banding buffer:ClPaCalcOffset				ldx			OpDoLocInfoRect+ov2							lda			ClPaCurrentBand			;get current band number index							dea									;minus one to get start index at 0							pha									;result space							pha							pha									;pass current band							phx									;pass band size							_Multiply							;multiply to get destrect offset							pullword	ParamWordA				;save for subtracts in a minute							pla									;ignore result hi word***Subtract the offset obtained above from Y1 & Y2:							lda			ClPaDestRect+ov1		;destrect.y1 -= band height * band#							sec							sbc			ParamWordA							sta			ClPaDestRect+ov1							lda			ClPaDestRect+ov2		;destrect.y2 -= band height * band#							sec							sbc			ParamWordA							sta			ClPaDestRect+ov2***Status message: indicate that DrawPicture is creating image of current page:							import		StMeRenderingMesg							lda			#StMeRenderingMesg							import		StatusMessage							jsr			StatusMessage***Clear the band buffer to white using our (unmodified default white) band grafport background:							pushlong	#OpDoLocInfoRect							_EraseRect***Call DrawPicture to draw upscaled page image, showing only a slice into banding/imaging buffer:							import		SpoolReturnToMarkGet	;recue VM to beginning of PICT							jsr			SpoolReturnToMarkGet														pushlong	OpPaUnusedPictHdl		;unused hdl: *we* saved data (spool)							pushlong	#ClPaDestRect			;translation and scaling rect							_DrawPicture						;OUR BPROCS/PATCHES RUN NOW!							bcc			ClPaNoDPError							sta			errNo					;if DrawPicture tool error, then							sta			OpDoErrorStatus			;pass failure-type error and do mesg							cmp			#$0201					;out of memory error							bne			ClPaDPErrorNotMem							import		StMeCantRenderMemMesgClPaDPErrorYesMem			lda			#StMeCantRenderMemMesg	;special message for low memory							bra			ClPaDPErrorGo							import		StMeCantRenderGenMesgClPaDPErrorNotMem			lda			#StMeCantRenderGenMesg	;generic message otherwiseClPaDPErrorGo				brl			ClPaMesgAbortPrintLoop2ClPaNoDPError***Status message: show long-lasting page/copy status after render mesg and change for next time:							jsr			ShowPageOrCopyMesg		;show message							lda			ClPaCurrentBand			;flip page/copy status message							cmp			OpDoTotalBands			;select, except if on last band							beq			ClPaNoIncSpcCount							inc			SpcCounterForCpPgMsgClPaNoIncSpcCount***Save current band's height because we might modify it next:							ldy			OpDoLocInfoRect+ov2							sty			ClPaCurrBandHeightSave***If last band, adjust bandsize here at the last minute because it might be shorter:ClPaAdjBand					lda			OpDoTotalBands			;get total # of bands to be done							cmp			#1						;no adjust if doing it all in 1 band							beq			ClPaDoneAdjBand			;(because LastBandHeight is 0)							cmp			ClPaCurrentBand			;now compare to curr band we're on							bne			ClPaDoneAdjBand			;no adjust if not last band							ldy			OpDoLastBandHeight							sty			OpDoLocInfoRect+ov2							ldx			#OpDoLocInfo			;make sure that the imager is							ldy			#^OpDoLocInfo			;informed of the new band size							import		ImagerSetLocInfo							jsr			ImagerSetLocInfoClPaDoneAdjBand***Call imager to convert pixelmap in band buffer to pr cmd sequences and transmit; exec idleproc:							import		ImagerPrint							jsr			ImagerPrint				;err status returned in ACC/carry***Check for abort status and check the print loop status; if necessary, arrange to terminate:							ldx			OpDoErrorStatus			;first check if idleproc did							bne			ClPaDoneCheckSkipAbort	;PrSetError and if so, do terminate							bcc			ClPaNoAbort				;now check if imager error or abortClPaDoneCheckSkipAbort***Here if user or imager abort, may also be due to communications abort, drawpicture error, etc:ClPaMesgAbortPrintLoop											;entry pt to abort but with no							ldx			#prAbort				;failure-type-err desired to be set							stx			OpDoErrorStatusClPaMesgAbortPrintLoop1											;entry pt to abort, caller has							import		StMeAbortMesg			;already set a failure-type error							lda			#StMeAbortMesgClPaMesgAbortPrintLoop2											;entry pt to abort, caller has set							pha									;error and has message sptr in A							import		StatusMessage							jsr			StatusMessage							import		ImagerClose				;show message, close imager,							jsr			ImagerClose							import		ImagerOpen				;open imager, maybe new connection,							jsr			ImagerOpen							lda			#0						;try to reset printer,							import		ImagerReady							jsr			ImagerReady							import		ImagerFormfeed			;try to FF to clean out printer,							jsr 		ImagerFormfeed							pla									;leave message up for a while							import		StatusMessageWait							jsr			StatusMessageWait							brl			ClPaAbortAndNormalExit	;continue shutting down							***Continue normally if there is no reason to abort:ClPaNoAbort***Restore bandsize in case it was modified if this was last band:							ldy			ClPaCurrBandHeightSave	;restore band size in struct and							sty			OpDoLocInfoRect+ov2		;make sure the imager is informed							ldx			#OpDoLocInfo							ldy			#^OpDoLocInfo							import		ImagerSetLocInfo							jsr			ImagerSetLocInfo***Tail of do-one-band code.  See if we need to do another band:							lda			ClPaCurrentBand			;get current band number index							cmp			OpDoTotalBands			;compare with total bands needed							bcs			ClPaOutOfBandsLoop		;if we're done, break out of loop							ina									;else increment and store back							sta			ClPaCurrentBand			;store it							brl			ClPaPrintOneMoreBand	;loop backClPaOutOfBandsLoop**Tail of do-one-copy code.  Do form feed to advance to next sheet:							import		ImagerFormfeed							jsr			ImagerFormfeed**Tail of do-one-copy code.  See if we need to print another copy:							lda			ClPaCurrentCopy			;get current copy number index							cmp			OpDoTotalCopies			;compare with total copies needed							bcs			ClPaOutOfCopiesLoop		;if we're done, break out of loop							ina									;else increment and store back							sta			ClPaCurrentCopy			;store it							brl			ClPaPrintOneMoreCopy	;loop backClPaOutOfCopiesLoop*Now done printing copies of current page or we need to abort:ClPaAbortAndNormalExit*Deallocate storage for definition of this page:							pushlong	OpPaUnusedPictHdl		;dealloc QD mem for pict recording							_KillPicture														import		SpoolFinishGet			;dealloc our VM for pict recording							jsr			SpoolFinishGet							*Undo our patch for "InstallWithStats" font manager call:							pha							pha							pushword	#0						;system tool set							pushword	#027					;tool set 27: Font Manager							_GetTSPtr							pulllong	ParamLongA							ldy			#4*$1C					;reset real "InstallWithStats" adrs							lda			ClPaOldIWSAddr+0							dea							sta			[ParamLongA],y							iny							iny							lda			ClPaOldIWSAddr+2							sta			[ParamLongA],y*Exit; next expected print loop call is OpenPage or CloseDoc:							rts*Status variables needed during loop to print copies of the current page:ClPaCurrentBand				dc.w		0ClPaCurrentCopy				dc.w		0*Inflated and translated picture playback rectangle:ClPaDestRect				dc.w		0,0,0,0*Temporary save area for band height for restore after special-case-last-band modification:ClPaCurrBandHeightSave		dc.w		0*Storage for the real "InstallWithStats" tool call address that we patch out:							export		ClPaOldIWSAddrClPaOldIWSAddr				dc.l		0**CLOSEDOC: Designates end of all printing operation.  Performs the following tasks:**	Close communication connection with printer*	Check if we were using our or the user's grafport memory for the recording grafport*	Close recording grafport and banding grafport (releases memory), set old pre-OpenDoc grafport*	Deallocate banding memory*	Restore QuickDraw global clip buffer sizes back to pre-OpenDoc values*	Remove status message box*	Set time value used by OpenDoc to determine if "Page As Job" condition exists*							export		CloseDocCloseDoc*Close port connection to printer as one of the first steps:							import		ImagerClose							jsr			ImagerClose*Ensure that our pointer to the calculation/recording grafport is up to date if owned by caller:							lda			printGrafPortPtr+0							tax							ora			printGrafPortPtr+2							beq			ClDoDoneUpdateCalcGPPtr							stx			OpDoCalcGrafPortPtr+0							lda			printGrafPortPtr+2							sta			OpDoCalcGrafPortPtr+2ClDoDoneUpdateCalcGPPtr*Restore previous grafport and close calculation and banding grafports:							pushlong	OpDoOldUserGrafPortPtr	;restore pre-pr-loop grafport first							_SetPort							lda			OpDoSetupLevel			;make sure we don't deallocate							cmp			#1						;unallocated resources...							bcc			ClDoDontDeallocPorts							pushlong	OpDoCalcGrafPortPtr		;clean up both of our grafports,							_ClosePort							;thus deallocating clip/vis rgn mem							pushlong	#OpDoBandGrafPort							_ClosePort							*Deallocate banding memory attached to our locinfo attached to our grafport:							pha									;dump our band mem	;result space							pha														;result space							pushlong	OpDoLocInfoPixPtr							;didn't keep hdl							_FindHandle												;so find from ptr							_DisposeHandle											;hdl on stack							pushword	OpDoMemPID				;dump our user ID							_DeleteIDClDoDontDeallocPorts*Set QuickDraw global internal clip buffers back to previous size:							lda			OpDoSetupLevel			;make sure we don't deallocate							cmp			#2						;unallocated resources...							bcc			ClDoDontResetBufDims							pushlong	#OpDoOldQDBuffRec							_RestoreBufDimsClDoDontResetBufDims*Finally, remove the status box as one of the last steps, which also removes wait cursor:							import		FinishStatusMessage							jsr			FinishStatusMessage							*Set the few-seconds-into-the-future time value for "Page As Job" determination:							pha									;get the current relative time							pha							_GetTick							clc									;pull from stack while adding							pla									;hardcoded constant to it and							adc			#PgAsJobAssumptionDelay	;storing this time+constant							sta			OpDoIsPgAsJobTime+0		;into static storage							pla							adc			#0							sta			OpDoIsPgAsJobTime+2							lda			#1						;indicate that the time has now							sta			OpDoIsPgAsJobIsTimeSet	;been set and may be used*Get rid of stray keystroke events:							pha									;flush other keyboard events							;			  5432109876543210							pushword	#%0000000000001110							pushword	#0							_FlushEvents							pla							*Exit; we are done with the print job; PrPicFile will be called but it need do nothing:							rts**GETPRINTLOOPERROR: This routine returns the value of the status variable in ACC:*							export		GetPrintLoopErrorGetPrintLoopError							lda			OpDoErrorStatus							rts**SETPRINTLOOPERROR: This routine stores the value of ACC into the status variable:*							export		SetPrintLoopErrorSetPrintLoopError							sta			OpDoErrorStatus							rts**SHOWSTATUSWITHPARAM: Displays string at adrs short ptr in A, with ASCII of word in X at posn 26:*ShowStatusWithParam							pha									;save original string address							phx									;pass number to go in str to Int2Dec							clc									;compute lo word of where number goes							adc			#26							tax							phk									;compute hi word of where number goes							phk							pla							and			#$00FF							pha									;pass hi word where # goes to Int2Dec							phx									;pass lo word where # goes to Int2Dec							pushword	#5						;pass length to Int2Dec							pushword	#0						;pass "unsigned" to Int2Dec							_Int2Dec							pla									;restore original string address							import		StatusMessage							brl			StatusMessage			;exit through StatusMessage**PRINTERSTATUSHANDLER: Called by Comm with err code in A, does U/I, return 0/1 if OK/Cancel in A:*PrinterStatusHandler							import		StatusMessageDevStat	;display alert dialog according to							jsr			StatusMessageDevStat	;err code in A and return ok/cancel														pha									;save 0/1 ok/cancel in A														dec			SpcCounterForCpPgMsg	;back to page or copy number							jsr			ShowPageOrCopyMesg														pla									;restore 0/1 if ok/cancel in A														rtl									;exit back to caller**SHOWPAGEORCOPYMESG: Refreshes status mesg with current page or current copy number status:*ShowPageOrCopyMesg							lda			OpDoTotalCopies			;check if number of copies >= 2							cmp			#2						;don't even consider putting up							bcc			SpcShowPage				;copy number if only 1 copy							lda			SpcCounterForCpPgMsg	;alternate message async with bands							and			#1						;always show PAGE 1st if was zeroed							beq			SpcShowPageSpcShowCopy							import		StMePrCurrentCpMesg		;show COPY number now being printed							lda			#StMePrCurrentCpMesg							ldx			ClPaCurrentCopy							jsr			ShowStatusWithParam							bra			SpcShowCpPgDoneSpcShowPage							import		StMePrCurrentPgMesg		;show PAGE number now being printed							lda			#StMePrCurrentPgMesg							ldx			OpDoPageCounter							jsr			ShowStatusWithParamSpcShowCpPgDone							rts							SpcCounterForCpPgMsg		dc.w		0						;INPUT: bit 0 selects: 0:PAGE 1:COPY							endproc							end