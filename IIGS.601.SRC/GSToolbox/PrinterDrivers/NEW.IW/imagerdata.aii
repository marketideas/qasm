*******************************************************************************************                                                                                        **		Apple IIgs New ImageWriter Printer Driver                                        **                                                                                        **		File: imagerdata.aii -- Density dither patterns applied to printer-pixels        **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        ************************************************************************************************************************************************************************************************                                                                                                  **   IMAGERDATA: 8x8 patterns which render 16 grayscale density levels on an ImageWriter I or II    **                                                                                                  **	The table below consists of 8x8 dither (halftone) patterns, arranged bitwise as eight          **	bytes.  A patterns is scanned such that the each successive byte is used vertically, with      **	the least-significant bit on top.  Thus up->down in the patterns below corresponds to          **	left->right on the printer.                                                                    **                                                                                                  **	The patterns must be regularly repetitive in all directions.  If this is not so, then          **	ugly "macroscopic" artifacts will be visible.  Given the limited resolution of the             **	ImageWriter (80x72 or 160x144 dpi), it is fairly difficult to construct such patterns          **	other than 100%, 75%, 50%, 25%, and 0%.                                                        **                                                                                                  **	The imager is capable of addressing 16 separate density levels; hence there are 16 entries     **	in the table below.  Due to the difficulty of generating so many artifact-fee patterns,        **	however, many of the patterns may be repeated.                                                 **                                                                                                  **	640-mode graphics are almost always dithered, therefore, it is possible for the dither         **	patterns described herein to beat, or interfere, against the quickdraw/etc-generated           **	patterns.  This can lead to "macroscopic" moire artifacts, as well as destructive              **	interference in which a 640-mode pattern is cancelled out to white entirely.  This is          **   especially dangerous for the very light-yellow-standard-640-color which is used as             **   highlighting by some word processors and could show up as nothing (white) while printing       **   in black/white mode, for example!  Of course, the correct ultimate solution to this problem    **   would be for the imager to consider two side-by-side 640-mode pixels at a time when            **   calculating density values.                                                                    **                                                                                                  **	Because the printer pin firing in the horizontal direction and the pin spacing in the          **	vertical direction on the paper overlaps somewhat (so as to create continuous graphics)        **	the printed density (as one might measure with a light meter off the page) does not            **	correspond linearly with the density ("the number of bits set") in the patterns below          **	across the entire 0..15 scale.  For example, a 75% pattern seems to produce a printed          **	density that is higher than 75%, given a fresh ribbon.                                         **                                                                                                  *****************************************************************************************************							macro&label						BitsPercent0Pure&label						dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							mend							macro&label						BitsPercent100Pure&label						dc.b	%11111111							dc.b	%11111111							dc.b	%11111111							dc.b	%11111111							dc.b	%11111111							dc.b	%11111111							dc.b	%11111111							dc.b	%11111111							mend							macro&label						BitsPercent50Pure&label						dc.b	%10101010							dc.b	%01010101							dc.b	%10101010							dc.b	%01010101							dc.b	%10101010							dc.b	%01010101							dc.b	%10101010							dc.b	%01010101							mend							macro&label						BitsPercent25Pure&label						dc.b	%01010101							dc.b	%00000000							dc.b	%10101010							dc.b	%00000000							dc.b	%01010101							dc.b	%00000000							dc.b	%10101010							dc.b	%00000000							mend							macro&label						BitsPercent87Pure&label						dc.b	%01110111							dc.b	%11111111							dc.b	%11011101							dc.b	%11111111							dc.b	%01110111							dc.b	%11111111							dc.b	%11011101							dc.b	%11111111							mend														macro&label						BitsPercent6Checkerboard&label						dc.b	%10001000							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%00100010							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							mend														macro&label						BitsPercent12Checkerboard&label						dc.b	%10001000							dc.b	%00000000							dc.b	%00100010							dc.b	%00000000							dc.b	%10001000							dc.b	%00000000							dc.b	%00100010							dc.b	%00000000							mend														macro&label						BitsPercent12Rectangular&label						dc.b	%10101010							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%10101010							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							mend														macro&label						BitsPercent25Stripe&label						dc.b	%10001000							dc.b	%01000100							dc.b	%00100010							dc.b	%00010001							dc.b	%10001000							dc.b	%01000100							dc.b	%00100010							dc.b	%00010001							mend														macro&label						BitsPercent50Stripe&label						dc.b	%11110000							dc.b	%00111100							dc.b	%00001111							dc.b	%11000011							dc.b	%11110000							dc.b	%00111100							dc.b	%00001111							dc.b	%11000011							mend														macro&label						StraightVerticalGap3&label						dc.b	%11111111							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							dc.b	%11111111							dc.b	%00000000							dc.b	%00000000							dc.b	%00000000							mend														macro&label						WigglyVerticalGap2&label						dc.b	%10101010							dc.b	%01010101							dc.b	%00000000							dc.b	%00000000							dc.b	%10101010							dc.b	%01010101							dc.b	%00000000							dc.b	%00000000							mend														macro&label						StraightVerticalLiteBoxes&label						dc.b	%11111111							dc.b	%10101010							dc.b	%00000000							dc.b	%00000000							dc.b	%11111111							dc.b	%10101010							dc.b	%00000000							dc.b	%00000000							mend														macro&label						StraightVerticalDarkBoxes&label						dc.b	%11111111							dc.b	%11111111							dc.b	%10101010							dc.b	%00000000							dc.b	%11111111							dc.b	%11111111							dc.b	%10101010							dc.b	%00000000							mend														macro&label						BitsPercent62&label						dc.b	%01010101							dc.b	%10111011							dc.b	%01010101							dc.b	%11101110							dc.b	%01010101							dc.b	%10111011							dc.b	%01010101							dc.b	%11101110							mend							ImagerDataRec				record		export							export		Dithmatrix							Dithmatrix:Dithmatrix0					BitsPercent0PureDithmatrix1					BitsPercent6CheckerboardDithmatrix2					BitsPercent12CheckerboardDithmatrix3					BitsPercent12RectangularDithmatrix4					StraightVerticalGap3Dithmatrix5					WigglyVerticalGap2Dithmatrix6					BitsPercent25StripeDithmatrix7					BitsPercent25PureDithmatrix8					BitsPercent25PureDithmatrix9					StraightVerticalLiteBoxesDithmatrix10				BitsPercent50StripeDithmatrix11				StraightVerticalDarkBoxesDithmatrix12				BitsPercent50PureDithmatrix13				BitsPercent62Dithmatrix14				BitsPercent87PureDithmatrix15				BitsPercent100Pure							endr							end