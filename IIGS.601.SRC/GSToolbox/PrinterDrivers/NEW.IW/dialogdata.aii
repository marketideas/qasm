*******************************************************************************************                                                                                        **		Apple IIgs New ImageWriter Printer Driver                                        **                                                                                        **		File: dialogdata.aii -- Dialog box text and layout and all message strings       **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.aii'															include		'm16.util'							include		'e16.control'							include		'e16.window'							include		'e16.dialog'					DialogDataRec				record		export**STATUSWINDOWTEMP: Window template for status box:*							export		StatusWindowTempStatusWindowTemp			dc.w		StatusWindowTempEnd-StatusWindowTemp	;paramLength Word							dc.w		fAlert+fQContent+fVis					;wFrameBits Word							dc.l		0										;wTitle Pointer							dc.l		0										;wRefCon Long 							dc.w		0,0,0,0									;wZoom	Rect							dc.l		0										;wColor WindColorPtr							dc.w		0										;wYOrigin Integer							dc.w		0										;wXOrigin Integer							dc.w		200										;wDataH Word 							dc.w		640										;wDataW Word 							dc.w		200										;wMaxH Word 							dc.w		640										;wMaxW Word							dc.w		0										;wScrollVer Word							dc.w		0										;wScrollHor Word							dc.w		0										;wPageVer Word							dc.w		0										;wPageHor Word 							dc.l		0										;wInfoRefCon Long							dc.w		0										;wInfoHeight Word							dc.l		0										;wFrameDefProc Pointer							dc.l		0 										;wInfoDefProc Pointer							dc.l		0 										;wContDefProc Pointer							dc.w		20										;wPosition Rect Y1							export		StatusWindowCoordX1						;for 320/640 modStatusWindowCoordX1			dc.w		12										;wPosition Rect X1							dc.w		20+25									;wPosition Rect Y2							export		StatusWindowCoordX2						;for 320/640 modStatusWindowCoordX2			dc.w		308										;wPosition Rect X2							dc.l		$FFFFFFFF								;wPlane GrafPortPtr							dc.l		0										;wStorage WindRecPtrStatusWindowTempEnd:							export		StatusWindowTextY						;Y1 local text coordStatusWindowTextY			dc.w		15**MANFEEDALERTTEMP: Alert template for manual feed status dialog:*							export		ManFeedAlertTempManFeedAlertTemp			dc.w		20										;boundsRect Y1							export		ManFeedAlertTempCoordX1ManFeedAlertTempCoordX1		dc.w		12										;boundsRect X1							dc.w		20+50									;boundsRect Y2							export		ManFeedAlertTempCoordX2ManFeedAlertTempCoordX2		dc.w		308										;boundsRect X2							dc.w		mesgFeedPromptID						;alertID							dc.b		$80										;stage 1 - no beep							dc.b		$80										;stage 2 - no beep							dc.b		$80										;stage 3 - no beep							dc.b		$80										;stage 4 - no beep							dc.l		ManFeedAlertTempOKButtItem				;item #1							dc.l		ManFeedAlertTempNGButtItem				;item #2							dc.l		ManFeedAlertTempStringItem				;item #3							dc.l		0										;terminator							ManFeedAlertTempOKButtItem	dc.w		mesgFeedPromptOKButtID					;itemID							dc.w		28,180,0,0								;coords							dc.w		buttonItem								;itemType							dc.l		ManFeedAlertTempOKButtStr				;itemDescriptor							dc.w		0										;itemValue							dc.w		0										;itemFlag							dc.l		0										;itemColorManFeedAlertTempOKButtStr	str			'Continue'ManFeedAlertTempNGButtItem	dc.w		mesgFeedPromptNGButtID					;itemID							dc.w		28,85,0,0								;coords							dc.w		buttonItem								;itemType							dc.l		ManFeedAlertTempNGButtStr				;itemDescriptor							dc.w		0										;itemValue							dc.w		0										;itemFlag							dc.l		0										;itemColorManFeedAlertTempNGButtStr	str			'Cancel'ManFeedAlertTempStringItem	dc.w		mesgFeedPromptStringID					;itemID							dc.w		9,84,200,640							;coords							dc.w		statText+itemDisable					;itemType/disabled							dc.l		ManFeedAlertTempStringStr				;itemDescriptor							dc.w		0										;itemValue							dc.w		0										;itemFlag							dc.l		0										;itemColorManFeedAlertTempStringStr	dc.b		ManFeedAlertTempStrE-ManFeedAlertTempStrBManFeedAlertTempStrB		dc.b		'Insert sheet for page: '							export		ManFeedAlertTempPageNo					;for modificationManFeedAlertTempPageNo		dc.b		'XXXXX'ManFeedAlertTempStrE**DEVALERTSTRING: Alert string for if improper device is connected or device error:*							export		DevAlertStringDevAlertString				dc.b		'3'										;box size spec							dc.b		'3'										;icon spec "note"							dc.b		'/'										;separator							dc.b		'Device is not an ImageWriter, '							dc.b		'not ready, or out of paper.'							dc.b		'/'										;separator							dc.b		'^#1'									;btn dflt "Cancel" 0							dc.b		0										;terminator**Status messages used in the status box during printing:*							export		StMePrinterOpenMesg						;during PrinterOpenStMePrinterOpenMesg			str			'Establishing communication'							export		StMePrinterResetMesg					;during PrinterResetStMePrinterResetMesg		str			'Positioning print head'							export		StMeFirstProgressMesg					;first mesg in boxStMeFirstProgressMesg		str			'Preparing to receive page data'							export		StMeSpoolProgressMesg					;MUST be 30 chars!StMeSpoolProgressMesg		str			'Recording data for page: XXXXX'							export		StMeDraftProgressMesg					;MUST be 30 chars!StMeDraftProgressMesg		str			'Currently printing page: XXXXX'							export		StMeSheetsLeftMesg						;MUST be 30 chars!StMeSheetsLeftMesg			str			'Sheets  left  to  print: XXXXX'							export		StMeMallocMesg							;during bandbuff getStMeMallocMesg				str			'Allocating imaging memory'							export		StMeRenderingMesg						;during DrawPictureStMeRenderingMesg			str			'Rendering page image'							export		StMeCancellingMesg						;during abort opsStMeCancellingMesg			str			'Cancelling'							export		StMeCommunicationMesg					;for if status errorStMeCommunicationMesg		str			'Printer communications error'							export		StMeOutOfPaperMesg						;for if status errorStMeOutOfPaperMesg			str			'Printer is out of paper'							export		StMePaperJamMesg						;for if status errorStMePaperJamMesg			str			'Printer paper is jammed'							export		StMeCoverOpenMesg						;for if status errorStMeCoverOpenMesg			str			'Printer cover is open'							export		StMeSelectOffMesg						;for if status errorStMeSelectOffMesg			str			'Printer select is off'							export		StMeInUseMesg							;for if status errorStMeInUseMesg				str			'Printer is in use'**WINDOWTEMP: Window template for both of our dialogs (we just make the controls fit one size box):*							export		WindowTempWindowTemp					dc.w		WindowTempEnd-WindowTemp				;paramLength Word							dc.w		fAlert+fQContent+fVis					;wFrameBits Word							dc.l		0										;wTitle Pointer							dc.l		0										;wRefCon Long 							dc.w		0,0,0,0									;wZoom	Rect							dc.l		0										;wColor WindColorPtr							dc.w		0										;wYOrigin Integer							dc.w		0										;wXOrigin Integer							dc.w		200										;wDataH Word 							dc.w		640										;wDataW Word 							dc.w		200										;wMaxH Word 							dc.w		640										;wMaxW Word							dc.w		0										;wScrollVer Word							dc.w		0										;wScrollHor Word							dc.w		0										;wPageVer Word							dc.w		0										;wPageHor Word 							dc.l		0										;wInfoRefCon Long							dc.w		0										;wInfoHeight Word							dc.l		0										;wFrameDefProc Pointer							dc.l		0 										;wInfoDefProc Pointer							dc.l		0 										;wContDefProc Pointer							dc.w		20										;wPosition Rect Y1							export		WindowCoordX1							;for 320/640 modWindowCoordX1				dc.w		12										;wPosition Rect X1							dc.w		180										;wPosition Rect Y2							export		WindowCoordX2							;for 320/640 modWindowCoordX2				dc.w		308										;wPosition Rect X2							dc.l		$FFFFFFFF								;wPlane GrafPortPtr							dc.l		0										;wStorage WindRecPtrWindowTempEnd:**Coordinates for adornment line separating title/version info from controls in the dialog boxes:*							export		WindowLineY:equ							export		WindowLineX1:equ							export		WindowLineX2:equWindowLineY					equ			14WindowLineX1				equ			7WindowLineX2				equ			287**STYLECONTROLTEMP: Control templates for the style dialog window for PrStlDialog call:*							export		StyleControlTempStyleControlTemp			dc.l		orientationLandscapeItem							dc.l		orientationPortraitItem							dc.l		orientationTitleItem							dc.l		effectsCondensedItem							dc.l		effectsNoGapsItem							dc.l		effectsTitle1Item							dc.l		reductionItem							dc.l		paperTypeItem							dc.l		titleItem								;these are common							dc.l		versionItem								;items, shared by							dc.l		cancelItem								;the other dialog							dc.l		okItem									;boxes							dc.l		0												export		PortTitleLen							;"IMAGEWRITER/XXX"...							export		PortTitleStr							;... set Len & Str							export		PortTitleLenOrig:equ					;... for informationtitleItem					dc.w		8										;pCount							dc.l		titleItemID								;ID							dc.w		3,6,13,258								;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		TiItStart								;TextRefPortTitleLen				dc.w		PortTitleLenOrig						;space for len byteTiItStart					dc.b		'ImageWriter / 'TiItEnd:PortTitleStr				dc.b		'XXXXXXXXXXXXXXX'						;space for portnamePortTitleLenOrig			equ			TiItEnd-TiItStart						;for computations			versionItem					dc.w		8										;pCount							dc.l		versionItemID							;ID							dc.w		3,258,13,298							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@VeTiStart								;TitleRef							dc.w		@VeTiEnd-@VeTiStart						;Use "VersionID"...@VeTiStart					dc.b		'v'										;...equate to...							dc.b		('0'+(VersionID/256))					;...generate code...							dc.b		'.'										;...for version...							dc.b		('0'+(VersionID//256))					;...string@VeTiEnd:										export		cancelItemKey1Equiv:equ							export		cancelItemKey2Equiv:equcancelItem					dc.w		9										;pCount							dc.l		cancelItemID							;ID							dc.w		128,220,128+11,284						;Rect							dc.l		simpleButtonControl						;ProcRef							dc.w		0										;Flags							dc.w		$3000									;MoreFlags							dc.l		0										;RefCon							dc.l		@Title									;TitleRef							dc.l		0										;ColorTableRef							dc.b		cancelItemKey1Equiv						;KeyEquiv							dc.b		cancelItemKey1Equiv						;both Key1							dc.w		0							dc.w		0@Title						str			'Cancel'cancelItemKey1Equiv			equ			27										;escape key equivcancelItemKey2Equiv			equ			'.'										;cmd-'.' key equiv										export		okItemKeyEquiv:equokItem						dc.w		9										;pCount							dc.l		okItemID								;ID							dc.w		143,220,143+11,284						;Rect							dc.l		simpleButtonControl						;ProcRef							dc.w		1										;Flags							dc.w		$3000									;MoreFlags							dc.l		0										;RefCon							dc.l		@Title									;TitleRef							dc.l		0										;ColorTableRef							dc.b		okItemKeyEquiv							;KeyEquiv							dc.b		okItemKeyEquiv							dc.w		0							dc.w		0@Title						str			'OK'okItemKeyEquiv				equ			13										;return key equiv			paperTypeItem				dc.w		9										;pCount							dc.l		paperTypeItemID							;ID							dc.w		28,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		paperTypePopUpMenu						;MenuRef							export		paperTypeInitValuepaperTypeInitValue			dc.w		paperTypeUsaLtrItemID					;InitialValuepaperTypePopUpMenu			dc.b		'$$Paper Type:\H'							dc.w		paperTypeItemID							dc.b		0*														dc.b		'--US Letter......8.5"x11"\H'							dc.w		paperTypeUsaLtrItemID							dc.b		0*														dc.b		'--US Legal........8.5"x14"\H'							dc.w		paperTypeUsaLglItemID							dc.b		0*														dc.b		'--US Stmnt.......5.5"x8.5"\H'							dc.w		paperTypeUsaStmtItemID							dc.b		0*														dc.b		'---\N256D',0*														dc.b		'--European A4......8"x12"\H'							dc.w		paperTypeEurA4ItemID							dc.b		0*														dc.b		'--European B5......7"x10"\H'							dc.w		paperTypeEurB5ItemID							dc.b		0*														dc.b		'--Intl Fanfold....8"x12"\H'							dc.w		paperTypeEurIntlFFItemID							dc.b		0*							dc.b		'---\N256D',0*														dc.b		'--Envelope (#6)....7"x4"\H'							dc.w		paperTypeEnvNo6ItemID							dc.b		0*														dc.b		'---\N256D',0*							dc.b		'--Label (Small)....3"x1"\H'							dc.w		paperTypeLblSmlItemID							dc.b		0*							dc.b		'--Label (Medium)..4"x1"\H'							dc.w		paperTypeLblMedItemID							dc.b		0*							dc.b		'--Label (Large)....4"x2"\H'							dc.w		paperTypeLblLrgItemID							dc.b		0*							dc.b		'--Label (Pkg)........4"x3"\H'							dc.w		paperTypeLblPackingItemID							dc.b		0*							dc.b		'--Label (3" Dsk)...3"x3"\H'							dc.w		paperTypeLblDisk35ItemID							dc.b		0*							dc.b		'--Label (5" Dsk)...5"x1"\H'							dc.w		paperTypeLblDisk525ItemID							dc.b		0*							dc.b		'.'						reductionItem				dc.w		9										;pCount							dc.l		reductionItemID							;ID							dc.w		53,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags					