*******************************************************************************************                                                                                        **		Apple IIgs New ImageWriter Printer Driver                                        **                                                                                        **		File: printloop.aii -- High-level interactive interface to spooling/imaging      **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.aii'																					include		'm16.util'							include		'e16.quickdraw'							include		'm16.quickdraw'							include		'm16.qdaux'							include		'm16.memory'							include		'e16.print'							include		'm16.intmath'							include		'm16.misctool'							include		'm16.event'PrintLoopProc				proc		export**PRINT LOOP CALLS: High-Level Spool and Draft Mode printing calls implementing the Macintosh*Printing Manager print model, for better and (mainly) for worse.***OPENDOC: Setup vars, init grafport with bottleprocs and boundsrect, start spooling, show status box:*							export		OpenDocOpenDoc*Clear error status; clear setup level until everything has been started up correctly:							stz			PrintLoopErrorStatus	;err stat for our use and user's							stz			PrintLoopSetupLevel		;so we know *what* is started up*Abort if no output port is currently possible:							pha									;Abort if no port. Result space...							ldx			#$3013					;ask currently installed port driver							jsl			$E10000					;_DevIsItSafe							pla							bne			OpDoOkDevice			;true result: no error							lda			#portNotOn				;else: return with tool error							bra			OpDoExitErrOpDoOkDevice*Put up wait cursor and box for status message:							import		GetStatMesgDisable		;get A=0/1 if enable/disable							jsr			GetStatMesgDisable							import		StartStatusMessage		;pass 0/1 to open mesg box routine							jsr			StartStatusMessage							import		StMeFirstProgressMesg	;put up first message to avoid							lda			#StMeFirstProgressMesg	;empty box for a few seconds							sta			ParamLongA+0							lda			#^StMeFirstProgressMesg							sta			ParamLongA+2							import		StatusMessage							jsr			StatusMessage*Check if draft mode, and if so set flag so we'll know later:							stz			PrintLoopIsDraft		;assume not draft mode							import		GetQuality							jsr			GetQuality				;find out print loop mode							cmp			#0						;quality level returned in acc							bne			OpDoInitSpool			;if not zero it's not draft mode							lda			#1						;else, set flag indicating draft							sta			PrintLoopIsDraft*Also if draft mode, setup static var so we know if vert condense is in effect:							stz			PrintLoopIsDraftVC							import		GetVSize							jsr			GetVSize							beq			OpDoNotDraftVC							lda			#1							sta			PrintLoopIsDraftVCOpDoNotDraftVC*Also if draft mode, initialize printer and skip start_spooling part:							jsr			PrinterOpen				;get unique connection to printer							jsr			PrinterReset			;and get it ready for printing							bra			OpDoDoPrGrafPort		;and skip next part*Initialize for spooling here if not draft; abort if error:							import		SpoolStartPut			;Allow app optional spool control:OpDoInitSpool				jsr			SpoolStartPut			;get spooler ready with its defaults							cmp			#0						;check for errors...							beq			OpDoOkSpoolStartOpDoExitErr					sta			errNo					;error exit; doesn't set out params							sta			PrintLoopErrorStatus	;and set our own error status							rtsOpDoOkSpoolStart			lda			#1						;indicate that we got this far...							sta			PrintLoopSetupLevel		;...so CloseDoc can abort correctly							import		GetSpoolFileNamePtr		;metrics call looks at print record							jsr			GetSpoolFileNamePtr		;see if user wants their own filename							bcc			OpDoNoCustFile			;lo->X, hi->Y, carry if not NIL ptr							import		SpoolFileNamePtr		;user does want their own filename							stx			SpoolFileNamePtr							sty			SpoolFileNamePtr+2							import		GetSpoolMemIncOpDoNoCustFile				jsr			GetSpoolMemInc			;see if user wants own spool mem inc							bcc			OpDoNoCustMemInc		;no							import		SpoolMemInc				;yes, change data in spooling land							stx			SpoolMemInc							sty			SpoolMemInc+2							import		GetSpoolMemLeftLimitOpDoNoCustMemInc			jsr			GetSpoolMemLeftLimit	;see if user wants own mem left limit							bcc			OpDoDoPrGrafPort		;no							import		SpoolMemLeftLimit		;yes, change it							stx			SpoolMemLeftLimit							sty			SpoolMemLeftLimit+2*Get memory for printing grafport data structure if needed:OpDoDoPrGrafPort			jsr			OpDoMallocGrafPort							bra			OpDoSetupGrafPort*The following is a very specific "subroutine" which gets print grafport memory space:OpDoMallocGrafPort			lda			printGrafPortPtr		;check to see if this is NIL...							ora			printGrafPortPtr+2		;if so, then user wants us to malloc							bne			OpDoMallocGrafPortDone	;non-NIL: use their memory							lda			#OpDoGrafPortSpace		;NIL: use our memory...							sta			printGrafPortPtr							lda			#^OpDoGrafPortSpace							sta			printGrafPortPtr+2OpDoMallocGrafPortDone		rts									;exit to caller*Save current caller's grafport for restore by closedoc:OpDoSetupGrafPort			pha									;result space...							pha							_GetPort							pulllong	PrintLoopOldGrafPortPtr	;save it*Setup grafport for printing loop, making it current port.  OpenPage will customize it later:							pushlong	printGrafPortPtr		;now setup user's or our grafport							_OpenPort							bcc			OpDoNoPortErr							brl			OpDoExitErr				;if err exit with acc setOpDoNoPortErr				_HidePen							;this port will never draw on screen							lda			#2						;indicate that we got this far...							sta			PrintLoopSetupLevel		;so CloseDoc can abort correctly							*Save value of the user's pr rec hdl so we can access print record during OpenPage/ClosePage:							lda			printRecordHandle+0							sta			PrintLoopPrRecHdl+0							lda			printRecordHandle+2							sta			PrintLoopPrRecHdl+2*Clear actual page counters:							stz			PrintLoopPageCounter	;reset logical page counter							stz			PrintLoopNumActualPages	;reset actual pages stored/spooled							rts									;exit without setting tool error*Static memory for holding GrafPort data structure for interpreting user QD calls:OpDoGrafPortSpace			ds.b		$AA							**CLOSEDOC: Remove status box, stop spooling, restore original grafport, dealloc if our grafport:*							export		CloseDoc*If draft mode, close port connection to printer:CloseDoc					lda			PrintLoopIsDraft							beq			ClDoDontPrClose							jsr			PrinterCloseClDoDontPrClose*Remove waitcursor/status box, no matter what happened:							import		FinishStatusMessage		;StatusMessage routines are...							jsr			FinishStatusMessage		;...un-init proof*Now shut down only the things that were started up:ClDoCheckSetupLevel			lda			PrintLoopSetupLevel		;let's see how far OpenDoc got...							cmp			#1						;1: only spooling started up right							beq			ClDoDumpSpool							cmp			#2						;2: everything + grafport							bne			ClDoExit				;if not 2, then 0: nothing started up*Restore previous grafport:							pushlong	PrintLoopOldGrafPortPtr	;restore pre-print loop grafport...							_SetPort							pushlong	printGrafPortPtr		;clean up stuff used by print port							_ClosePort*Stop the spooling process here if not draft, which could still generate an error:ClDoDumpSpool				lda			PrintLoopIsDraft		;don't do here if draft							bne			ClDoExit														lda			PrintLoopErrorStatus	;nondraft: is error pending?							beq			ClDoNoPrError														import		SpoolFinishPut			;if error, complete the full sequence							jsr			SpoolFinishPut			;of spooler calls to ensure proper							import		SpoolStartGet			;memory/disk resource deallocation							jsr			SpoolStartGet							import		SpoolFinishGet							jsr			SpoolFinishGet							rtsClDoNoPrError														import		SpoolFinishPut			;nondraft+all ok: stop spooling							jsr			SpoolFinishPut							cmp			#1						;error?							bcc			ClDoExit				;if no							lda			#prAbort				;if yes, set err for PicFile later							sta			PrintLoopErrorStatus							ClDoExit					rts**OPENPAGE: If in pg range and no err, start pict recording (spool) or start spooling strings (draft):*							export		OpenPage*Check to make sure no print error exists:OpenPage					lda			PrintLoopErrorStatus							beq			OpPaNoErrStatOpPaExit1					rtsOpPaNoErrStat*Set our pr rec handle to the value that was saved during OpenPage so we can use metrics calls:							lda			PrintLoopPrRecHdl+0							sta			printRecordHandle+0							lda			PrintLoopPrRecHdl+2							sta			printRecordHandle+2*Increment abs pg count so we can compare it against user-selected pg range; first number is 1:							inc			PrintLoopPageCounter*Be sure that even out-of-range pages, where we don't do "OpenPicture", don't show on screen:							pushlong	printGrafPortPtr		;fill defaults and set as current							_InitPort							lda			#0						;zero the boundsrect so nothing							ldy			#oBoundsRect			;will ever be physically drawnOpPaZeroBoundsRectLoop1		sta			[printGrafPortPtr],y							iny							iny							cpy			#oBoundsRect+8							bne			OpPaZeroBoundsRectLoop1*Change the message in the informational status box, slightly different for spool or draft:							lda			PrintLoopIsDraft							beq			OpPaNoDraftMessage							import		StMeDraftProgressMesg							ldx			#StMeDraftProgressMesg							ldy			#^StMeDraftProgressMesg							bra			OpPaShowMessage							import		StMeSpoolProgressMesgOpPaNoDraftMessage			ldx			#StMeSpoolProgressMesg							ldy			#^StMeSpoolProgressMesgOpPaShowMessage				stx			ParamLongA+0							sty			ParamLongA+2							jsr			ShowStatusWithPgNo		;string will be modified*Assume we're not in page range; this flag may be modified if we finish successfully:							stz			PrintLoopInPageRange*Check page range, no draft or spool if this page isn't to be printed, so exit if out of range:							import		GetPageRange			;metrics call that assumes valid							jsr			GetPageRange			;pr rec hdl, returns 1st->X, Lst->Y							cpx			PrintLoopPageCounter	;cmp current page# with first page#							bcc			OpPaInRange1st			;current page# >= first page#...							bne			OpPaExit1				;abort if out of page rangeOpPaInRange1st				cpy			PrintLoopPageCounter	;cmp current page# with last page#							bcc			OpPaExit1				;if not current page# <= last page#*We are in page range, so proceed.  Increment actual-number-of-pages count:							inc			PrintLoopNumActualPages*If draft mode, setup for "spooling" upcoming page text ascii:							lda			PrintLoopIsDraft		;draft mode?							beq			OpPaDoneDraftBWStuff	;no, skip this part							import		SpoolStartPut							jsr			SpoolStartPut			;start string recording process*Fill in X2,Y2 in rectangle/data used several times in a few moments:OpPaDoneDraftBWStuff									import		GetRPageSize			;metrics call assumes valid prrechdl							jsr			GetRPageSize			;returns X2->X, Y2->Y							stx			OpPaPicFrameX2			;store into our rect's X2,Y2...							sty			OpPaPicFrameY2							stz			OpPaPicFrameX1			;also store zero X1,Y1 in case it							stz			OpPaPicFrameY1			;was modified last time*But if user passed a non-NIL picture frame (scaling) rectangle, use it instead of ours:							lda			pageFramePtr+0			;check user picture frame for NIL...							ora			pageFramePtr+2							beq			OpPaSetUpPort			;branch away if user passed NIL							ldy			#0						;else copy their rect...OpPaCpUsrPicFrame			lda			[pageFramePtr],y							sta			OpPaPicFrame,y							iny							iny							cpy			#8							bne			OpPaCpUsrPicFrame*Init grafport for picture recording, setting everything to defaults, and set as current port:OpPaSetUpPort				pushlong	printGrafPortPtr		;reset and set as current port							_InitPort							lda			#0						;zero the bounds rect so that							ldy			#oBoundsRect			;no physical drawing occursOpPaZeroBoundsRectLoop2		sta			[printGrafPortPtr],y							iny							iny							cpy			#oBoundsRect+8							bne			OpPaZeroBoundsRectLoop2*Set all clipping settings to rPage rect or user's rect:							pushlong	#OpPaPicFrame			;(1) set main grafport rect							_SetPortRect							pushlong	#OpPaPicFrame			;(2) set clip region							_ClipRect							pha									;(3) set vis region							pha							_GetVisHandle						;leave hdl on stack for SetRectRgn							pushword OpPaPicFrame+oh1							pushword OpPaPicFrame+ov1							pushword OpPaPicFrame+oh2							pushword OpPaPicFrame+ov2							_SetRectRgn*Prepare to install our own bottleprocs into grafport:							pushlong	#OpPaQDProcs							_SetStdProcs						;fill our QDProcs with defaults*If spool mode, set put-picture bottleproc to our own so we can capture the picture definition:							lda			PrintLoopIsDraft							bne			OpPaSetDraftProc							lda			#PutPic-1				;customize the PutPic bottleproc							sta			OpPaQDProcs+ostdPutPic+0							lda			#^(PutPic-1)							sta			OpPaQDProcs+ostdPutPic+2							bra			OpPaSetProcs*Else, draft mode, so set bottleproc so that we can handle the QD draw-text command ourselves:OpPaSetDraftProc			lda			#PutText-1				;customize the PutText bottleproc							sta			OpPaQDProcs+ostdText+0							lda			#^(PutText-1)							sta			OpPaQDProcs+ostdText+2*Install our bottleprocs into our grafport:OpPaSetProcs				pushlong	#OpPaQDProcs							_SetGrafProcs						;setup with our customized procs							*If draft mode, we are done at this point; don't begin a picture definition, and don't touch screen:							lda			PrintLoopIsDraft							beq			OpPaStartPictInfo							_HidePen							bra			OpPaExitAssertInPgRng							*If not draft, compensate for quirk were we must store first part of bottlepatched-pict explicitly:OpPaStartPictInfo			pha									;result space							_GetMasterSCB						;figure the mode only to...							pullword	OpPaPicSetupStuff		;...store it into picture start stuff							lda			#10						;length: ten bytes in all...							sta			ParamLongB+0							stz			ParamLongB+2							lda			#OpPaPicSetupStuff		;source location: our 10 bytes...							sta			ParamLongC+0							lda			#^OpPaPicSetupStuff							sta			ParamLongC+2							import		SpoolPut				;go store the beginning bytes...							jsr			SpoolPut				;...rest will be stored by our PutPic							cmp			#1						;error?							bcc			OpPaOpenPict			;no							sta			errNo					;we'll return spool err as tool err							lda			#prAbort				;also set abort error...							sta			PrintLoopErrorStatus							bra			OpPaExit				;abort this routine*Tell QuickDraw to start making drawing commands go into picture definition and not to screen:OpPaOpenPict				pha									;result space...							pha							pushlong	#OpPaPicFrame			;user's or our picframe							_OpenPicture						;has effect of a "_HidePen"							pulllong	PrintLoopUnusedPictHdl	;save this even though we do bprocs*Tell ClosePage we're really doing a page:OpPaExitAssertInPgRng		lda			#1							sta			PrintLoopInPageRange	;we got this far we must be in range*Done; app will do drawing commands now which will call bottleprocs:OpPaExit					rts*Start of picture stuff / Picture frame for passing to OpenPicture / Rectangle for ClipRect:OpPaPicSetupStuff			dc.w		0						;SCBOpPaPicFrameOpPaPicFrameY1				dc.w		0						;Y1OpPaPicFrameX1				dc.w		0						;X1OpPaPicFrameY2				dc.w		0						;Y2OpPaPicFrameX2				dc.w		0						;X2*Area for patching in our bottleprocs:OpPaQDProcs					ds.b		$38						;bottleneck proc pointers**CLOSEPAGE: If in page range, put stop-pict mark (spool) or do multicopy text printing (draft):*							export		ClosePage*Check conditions:ClosePage					lda			PrintLoopErrorStatus	;if an error has occurred...							bne			ClPaExit1				;don't do this routine*Continue condition checking:							lda			PrintLoopInPageRange	;if OpenPage didn't say yes...							beq			ClPaExit1				;exit if not doing this page							*Set our pr rec handle to the value that was saved during OpenPage so we can use metrics calls:							lda			PrintLoopPrRecHdl+0							sta			printRecordHandle+0							lda			PrintLoopPrRecHdl+2							sta			printRecordHandle+2							*If draft mode, go to the code that print copy(s) of this current just-recorded entire page:							lda			PrintLoopIsDraft							bne			ClPaItsDraft*If not draft, put mark in pict separating this pict (page) from next and close/dealloc pict mem:							pushword	#EndOfPagePicCommentKind							pushword	#4						;pass length							pushlong	#ClPaEOPFakeHandle		;pass "handle" with comment data							_PicComment							;place marker at end of picture							_ClosePicture						;stop picture recording							pha									;save (undocumented) error, if any							pushlong	PrintLoopUnusedPictHdl	;dealloc QD's mem for pict recording							_KillPicture						;we took care of recording ourselves							pla									;restore error from ClosePicture							beq			ClPaNoClosePictErr		;if error, return as tool-error							sta			errNoClPaNoClosePictErr*Common exit:ClPaExit1					rts*Else, new-style draft mode: print top to bottom (no reverse feed!); print multiple copies (new!):ClPaItsDraft*Save a few values from the current print record that we'll need repeatedly during upcoming loop:							import		GetIdleProc				;metrics routines need valid prrech							jsr			GetIdleProc							stx			ClPaIdleProc+0							sty			ClPaIdleProc+2							import		GetCrWidth							jsr			GetCrWidth							sta			ClPaCrWidth							import		GetCopies							jsr			GetCopies							sta			ClPaNumCopies							*Change the state of the spooler from recording to playback mode:							import		SpoolFinishPut							jsr			SpoolFinishPut			;stop strings recording process							import		SpoolStartGet							jsr			SpoolStartGet			;start strings playback process							import		SpoolMarkGet							jsr			SpoolMarkGet			;arrange to be able to repeat**Loop for number of copies requested; count kept on stack:							ldy			#0						;init, for 0..PrintLoopNumCopies-1ClPaDraftOneMoreCopy		phy**Do start-of-copy (start of paper) printer stuff and dialogs:							lda			PrintLoopPageCounter	;get page # being draft-printed...							sta			ParamWordA				;do manfeed dialog, etc...							jsr			PrinterNewPage							lda			PrintLoopErrorStatus	;arrange to abort if manfeed cancel							beq			ClPaDraftNoManFeedCncl	;or some other reason for err stat							brl			ClPaDraftNextCopyClPaDraftNoManFeedCncl							import		StMeDraftProgressMesg							lda			#StMeDraftProgressMesg	;restore current page message box							sta			ParamLongA							lda			#^StMeDraftProgressMesg							sta			ParamLongA+2							jsr			ShowStatusWithPgNo***Doing one copy. First, find first print line, in preparation for down-the-page draft printing:							import		SpoolReturnToMarkGet	;back to start of string list							jsr			SpoolReturnToMarkGet							lda			#$FFFF					;initialize for least-Y-coord search							sta			ClPaCurrentYClPaDraftFirstYLoop			jsr			ClPaDraftGetSpoolPacket	;get text/position data for a string							bcs			ClPaDraftPrintLoopBegin	;break out if looked at all strings							lda			ClPaPacketHeaderPos+ov1	;look at a string's Y position							cmp			ClPaCurrentY			;cmp against current-smallest Y							bcs			ClPaDraftFirstYLoop		;if greater, ignore, get next string							sta			ClPaCurrentY			;else store newly-found smallest Y							bra			ClPaDraftFirstYLoop	***Specialized routine to get string packet from spool and store in statics. Carry -> End-Of-Data:ClPaDraftGetSpoolPacket		lda			#ClPaPacketHeaderEnd-ClPaPacketHeaderBegin							sta			ParamLongB							stz			ParamLongB+2							lda			#ClPaPacketHeaderBegin	;will store in our data area							sta			ParamLongC							lda			#^ClPaPacketHeaderBegin							sta			ParamLongC+2							import		SpoolGet							jsr			SpoolGet				;(1.1) read header from spool							cmp			#1						;set carry if err or end data							bcs			ClPaDraftEndData							lda			PrintLoopIsDraftVC		;(1.2) *2 Y coord if not vert cond							bne			ClPaDraftGetPackNotVC							asl			ClPaPacketHeaderPos+ov1ClPaDraftGetPackNotVC		lda			ClPaPacketHeaderLen		;(1.3) text len is given in header							sta			ParamLongB							stz			ParamLongB+2							lda			#PrintLoopRoutineData	;will store in our data area							sta			ParamLongC							lda			#^PrintLoopRoutineData							sta			ParamLongC+2							import		SpoolGet							jsr			SpoolGet				;(2) read text from spool							cmp			#1						;set carry if err or end dataClPaDraftEndData			rts***End of specialized routine. Now have CurrentY @ first Y on page. Print down page in one pass:ClPaDraftPrintLoopBegin		stz			ClPaLastVertPaperPos	;init our idea of paper positionClPaDraftPrintLoop			stz			ClPaWePrinted			;set to false, used to detect end							lda			#$FFFF					;init to BIG, for finding next...							sta			ClPaNextCurrentY		;...line while printing strings							import		SpoolReturnToMarkGet	;return to start of strings...							jsr			SpoolReturnToMarkGetClPaDraftGetNextPacket		jsr			ClPaDraftGetSpoolPacket	;get a string candidate							bcc			ClPaDraftGotPacket		;not end of strings yet***End of strings in spool. See if we're done. If not, set new CurrentY and repeat:							lda			ClPaWePrinted			;did we ever print anything this...							bne			ClPaYesWeStillPrinted	;past loop? Yes, so hope for this pg							brl			ClPaDraftPrintLoopDone	;No, so exit THIS loopClPaYesWeStillPrinted		lda			ClPaNextCurrentY		;else, new CurrentY and repeat; maybe							sta			ClPaCurrentY			;there is more left to print on							bra			ClPaDraftPrintLoop		;this current sheet...***Continuation after getting new string packet:ClPaDraftGotPacket			lda			ClPaPacketHeaderPos+ov1	;look at its Y coordinate; we're...							cmp			ClPaCurrentY			;...looking for the next-greater one							bcc			ClPaDraftCheckIfPrint	;it's less than current, ignore							beq			ClPaDraftCheckIfPrint	;it's equal to current, also ignore							cmp			ClPaNextCurrentY		;ok, but is it NEXT(least)-greater?							bcs			ClPaDraftCheckIfPrint	;no, we've seen better							sta			ClPaNextCurrentY		;now have better next Y coordinateClPaDraftCheckIfPrint		cmp			ClPaCurrentY			;string's Y at current level on page?							bne			ClPaDraftGetNextPacket	;no, so go fetch next string***Set still-active-printing-flag:							lda			#1						;set flag so we know that we still							sta			ClPaWePrinted			;found something to print this time***Call imager to send text, not graphics, to printer:ClPaDraftCallImager			pushlong	#PrintLoopRoutineData	;pixel loc info gets ptr to chars							pushword	ClPaPacketHeaderPos+oh1	;pixel rect ptr hi gets abx X coord							lda			ClPaPacketHeaderPos+ov1	;get wanted Y position							sec							sbc			ClPaLastVertPaperPos	;wanted Y - current Y; get delta							pha									;pixel rect ptr lo gets rel Y coord							pushword	#0						;color table ptr gets length: hi word							pushword	ClPaPacketHeaderLen		;color table ptr gets length: lo word							pushlong	ClPaPacketHeaderStyle	;scb list ptr gets style settings							pushword	ClPaCrWidth				;pass crWidth obtained from OpenDoc							pushword	#0 						;pass dummy paper length							;			  5432109876543210							lda			#%0000001101000011		;FF/Init:N, Text:Y Open/Close:N							ora			PrintLoopMaskIsIWOne	;make sure imager knows if old IW I							pha							pushword	#0						;dummy QualityBits (feature select)							pushlong	ClPaIdleProc			;pass idleproc obtained from OpenDoc							import		Imager					;call imager, print string							jsl			Imager							bcs			ClPaDraftPrErr							lda			ClPaPacketHeaderPos+ov1	;success: save wanted Y as new...							sta			ClPaLastVertPaperPos	;...current Y position							brl			ClPaDraftGetNextPacket	;go on if no error nor option-period**Error was reported by the imager. Deal with it if it was user-abort (command-period) or an error:ClPaDraftPrErr				cmp			#$0080					;$80 means imager detected cmd-period							beq			ClPaDraftSetPrErr		;if so, set err which will stop loop							jsr			ShowPrinterErrorStatus	;pass ACC to put stat mesg in box							import		StMeDraftProgressMesg	;restore current page mesg in box...							lda			#StMeDraftProgressMesg							sta			ParamLongA							lda			#^StMeDraftProgressMesg							sta			ParamLongA+2							jsr			ShowStatusWithPgNo							bra			ClPaDraftCallImager		;...and try again...ClPaDraftSetPrErr			lda			#prAbort				;render pr loop inactive...							sta			PrintLoopErrorStatus	;and drop through...**End draft print, because nothing left or user abort.  Do formfeed:ClPaDraftPrintLoopDone		jsr			PrinterFormFeed**End of loop for number of copies requested; count kept on stack:ClPaDraftNextCopy			ply									;inc copy count and check if done yet							iny							cpy			ClPaNumCopies							bcs			ClPaExit							lda			PrintLoopErrorStatus	;don't go on if abort or err happened							bne			ClPaExit							brl			ClPaDraftOneMoreCopy*Done; either OpenPage will be next for another draft run or CloseDoc, which removes dialogs/ports:							import		SpoolFinishGetClPaExit					jsr			SpoolFinishGet			;deallocate resources							rts*"Handle" and PicComment data for if nondraft mode to mark end-of-page:ClPaEOPFakeHandle			dc.l		ClPaEOPCommentData							ds.b		20ClPaEOPCommentData			dc.w		0						;version							dc.w		$A55A					;signature*Data from print record needed during draft loop:ClPaNumCopies				dc.w		0ClPaCrWidth					dc.w		0ClPaIdleProc				dc.l		0*Static variables needed by code which prints draft down the page:ClPaCurrentY				dc.w		0						;where we are down the pageClPaNextCurrentY			dc.w		0						;calc next CurrentY while in loopClPaWePrinted				dc.w		0						;flag to know when to stop loopClPaLastVertPaperPos		dc.w		0						;for calculating delta Y for imager*Space for information header from spool:ClPaPacketHeaderBegin			ClPaPacketHeaderPos			dc.w		0,0ClPaPacketHeaderLen			dc.w		0ClPaPacketHeaderStyle		dc.l		0ClPaPacketHeaderEnd**PICFILE: If spooled, prints mult copies of recorded pages, does gap, status box, manfeed, etc, etc:*							export		PicFile*If draft mode or print loop error status, don't do this routine:PicFile						lda			PrintLoopIsDraft		;nonzero if draft							ora			PrintLoopErrorStatus	;nonzero if error							beq			PiFiGo1					;both zero, so go on							rts									;else, exit but don't return errorPiFiGo1*Prepare to retrieve spooled picture (page) definitions, if error, don't do this routine:							import		SpoolStartGet							jsr			SpoolStartGet			;try to start up spooler							cmp			#1						;accumulator free of errors?							bcc			PiFiGo2					;yes, so go on with this routine							sta			errNo					;no, so set tool error							rts									;and exitPiFiGo2*If there really weren't any pages recorded (maybe we were never in page range), also abort:							lda			PrintLoopNumActualPages							bne			PiFiGo3							import		SpoolFinishGet			;dealloc spool resources							jsr			SpoolFinishGet			;(mostly empty)							rts									;and exitPiFiGo3*Put up dialog box to show status as well as to allow manual page feed alerts:							import		GetStatMesgDisable		;get A=0/1 if enable/disable							jsr			GetStatMesgDisable							import		StartStatusMessage		;pass 0/1 to open mesg box routine							jsr			StartStatusMessage*Put up the first message to show we're allocating memory:							import		StMeMallocMesg							lda			#StMeMallocMesg							sta			ParamLongA+0							lda			#^StMeMallocMesg							sta			ParamLongA+2							import		StatusMessage							jsr			StatusMessage*Allocate memory for struct grafport for imaging (NOT same as for print loop above) or use user's:							jsr			OpDoMallocGrafPort*Start print port. This port is one "band" into which slices of spooled pictures are drawn & printed:							pha									;result space...							pha							_GetPort							pulllong	OldGrafPortPtr			;save current grafport...							pushlong	printGrafPortPtr		;init a new grafport for us...							_OpenPort							;and make it the current grafport*Creating locinfo to be used by off-screen imaging grafport. Setting up band tallness and width:							import		GetImagingSize							jsr			GetImagingSize			;get X & Y dimensions for imaging							stx			PiFiLocInfoRect+oh2		;store X2; will be modified							sty			PiFiLocInfoRect+ov2		;store Y2; will be modified*Do loop to figure out maximum X or Y size for banding, with many constraints:							import		GetOrientation			;decide to work on X or Y size							jsr			GetOrientation			;we go align X or Y to begin with...							cmp			#1							beq			PiFiAlignBandLand		;go align 1st to start land mem alloc							bra			PiFiAlignBandPort		;go align 1st to start port mem alloc**Get smaller band by cutting X or Y size in half, and align X or Y size to an even-imager-multiple:							import		GetOrientationPiFiTrySmallerBand			jsr			GetOrientation			;decide to work on X or Y size							cmp			#1							beq			PiFiTrySmallerBandLandPiFiTrySmallerBandPort		lsr			PiFiLocInfoRect+ov2		;port: try smaller Y band sizePiFiAlignBandPort			pha									;align to multiple for pr head pins							pha							pushword	PiFiLocInfoRect+ov2							pushword	#16							_UDivide							pla									;ignore quotient from divide							pullword	ParamWordA				;get remainder							lda			PiFiLocInfoRect+ov2		;subtract to align it...							sec							sbc			ParamWordA							bcc			PiFiCantGetBandMem		;can't make it any smaller...							beq			PiFiCantGetBandMem							sta			PiFiLocInfoRect+ov2							bra			PiFiCalcLocInfoWidthPiFiCantGetBandMem			lda			#$0201					;abort with memory full tool err...							sta			errNo							brl			PiFiAbortNoBandMemAllocPiFiTrySmallerBandLand		lsr			PiFiLocInfoRect+oh2		;land: try smaller X band sizePiFiAlignBandLand			pha									;align to multiple for pr head pins							pha							pushword	PiFiLocInfoRect+oh2							pushword	#16							_UDivide							pla									;ignore quotient from divide							pullword	ParamWordA				;get remainder							lda			PiFiLocInfoRect+oh2		;subtract to align it...							sec							sbc			ParamWordA							bcc			PiFiCantGetBandMem		;can't make it any smaller...							beq			PiFiCantGetBandMem							sta			PiFiLocInfoRect+oh2**Figure out loc info width based on mode (320/640) in effect at recording time and loc info X size:							import		GetModeByte				;metrics to obtain 320/640 modePiFiCalcLocInfoWidth		jsr			GetModeByte				;for finding number pixels per byte							sta			PiFiLocInfo+0			;also put mode byte in locinfo							and			#$80					;check 320/640 mode bit...							cmp			#1						;...set carry if 640 mode							lda			PiFiLocInfoRect+oh2		;get rPage X2 in ACC							bcc			PiFiIts320				;320, so only divide rPageX2 by 2							lsr	a								;divide by 4 (640 mode), or...PiFiIts320					lsr	a								;by 2 (320 mode) -> # bytes per line							sta			PiFiLocInfoWidth		;store band width in bytes**Figure out how big the band buffer will be, given the above (width still in ACC):							pha									;result space for multiply...							pha							pha									;locinfo.width (bytes) still in acc							lda			PiFiLocInfoRect+ov2		;times number of lines...							ina							pha							_Multiply							pulllong	ParamLongB				;plB now has pix buff size we want							**Check if buffer size would be greater than the amount of free memory:PiFiCmpFreeMem				pha							pha							_RealFreeMem							plx							pla							lsr a							tay							txa							ror	a							tax							tya							lsr a							tay							txa							ror a								;now have free_mem/4 lo->A , hi->Y							cpy			ParamLongB+2			;cmp hi words							beq			PiFiCmpFreeMem1							bcs			PiFiCmpFreeMemOk							brl			PiFiTrySmallerBand		;too big, try smallerPiFiCmpFreeMem1				cmp			ParamLongB+0			;cmp lo words							bcs			PiFiCmpFreeMemOk							brl			PiFiTrySmallerBand		;too big, try smallerPiFiCmpFreeMemOk**Check if buffer size would be greater than maximum QD-allowed pix buffer size:PiFiCmpMaxPixBuff			lda			ParamLongB+2			;cmp hi words							cmp			#QDMaxPixBuff/65536							beq			PiFiCmpMaxPixBuff1							bcc			PiFiCmpMaxPixBuffOk							brl			PiFiTrySmallerBand		;too big, try smallerPiFiCmpMaxPixBuff1			lda			ParamLongB+0			;cmp lo words							cmp			#QDMaxPixBuff//65536							bcc			PiFiCmpMaxPixBuffOk							brl			PiFiTrySmallerBand		;too big, try smallerPiFiCmpMaxPixBuffOk**Try asking for the memory for imaging bands and also obtain a PID for later mallocs/deallocs:PiFiDoBandMalloc			pha									;result space							pushword	#UserIDType				;type of process requesting ID							_GetNewID							;obtain PID							pullword	PiFiMemPID				;get it							pha									;result space...							pha							pushlong	ParamLongB				;pass size of block requested							pushword	PiFiMemPID				;pass PID							pushword	#$C000					;pass attr: locked/fixed							pha									;pass dummy location							pha							_NewHandle							pulllong	ParamLongA				;get handle, if we got one							bcc			PiFiUseBandMem			;go on if we got onePiFiDelIDTrySmallerBand		pushword	PiFiMemPID				;didn't get handle, try again...							_DeleteID							brl			PiFiTrySmallerBand*Dereference the handle and put it in our locinfo:PiFiUseBandMem				lda			[ParamLongA]							sta			PiFiLocInfoPixPtr+0							ldy			#2							lda			[ParamLongA],y							sta			PiFiLocInfoPixPtr+2*Finally, the locinfo is complete, so use it:							pushlong	#PiFiLocInfo			;attach our locinfo to our grafport							_SetPortLoc*Set QuickDraw's global internal clip buffers to handle the bigger size of our offscreen bitmap:							pushlong	#PiFiOldQDBuffRec		;save original buffer widths							_SaveBufDims*							lda			PiFiLocInfoWidth		;buff size for horiz num of bytes...							cmp			PiFiOldQDBuffMaxWidth	;but never smaller (ie, landscape)							bcs			PiFiSetBufDims1							lda			PiFiOldQDBuffMaxWidthPiFiSetBufDims1				pha									;pass it to SetBufDims*							lda			PiFiOldQDBuffTxtHeight	;buff size height for font stuff...							lsr a							lsr a							clc							adc			PiFiOldQDBuffTxtHeight							pha									;pass it to SetBufDims*							lda			PiFiOldQDBuffMFBREx		;buff size for font style mods...							pha									;pass it to SetBufDims*							_SetBufDims							;ask QD for bigger buffers							bcc			PiFiNoBufDimErr			;if error, exit with tool error							sta			errNo							brl			PiFiOutOfPagesLoopNoSCBPiFiNoBufDimErr*Set port rect, clip rgn, and vis rgn to now-known bounds rect instead of screen-sized defaults:							pushlong	#PiFiLocInfoRect		;(1) set main grafport rect							_SetPortRect							pushlong	#PiFiLocInfoRect		;(2) set clip region							_ClipRect							pha									;(3) set vis region							pha							_GetVisHandle						;leave hdl on stack for SetRectRgn							pushword	PiFiLocInfoRect+oh1							pushword	PiFiLocInfoRect+ov1							pushword	PiFiLocInfoRect+oh2							pushword	PiFiLocInfoRect+ov2							_SetRectRgn*Setup our own getpic/piccomment bottleprocs for retrieving the spooled picture definition: 							pushlong	#OpPaQDProcs 							_SetStdProcs							lda			#GetPic-1				;customize GetPic bottleproc							sta			OpPaQDProcs+ostdGetPic							lda			#^(GetPic-1)							sta			OpPaQDProcs+ostdGetPic+2							lda			#PicComment-1			;customize PicComment bottleproc							sta			OpPaQDProcs+ostdComment							lda			#^(PicComment-1)							sta			OpPaQDProcs+ostdComment+2							pushlong	#OpPaQDProcs			;attach our procs to our grafport							_SetGrafProcs*Alloc mem for offscreen SCB list as tall as our banding buffer, one byte for each vertical line:							stz			ParamLongA+2			;request size of hdl is 0..Y2 bytes							lda			PiFiLocInfoRect+ov2							import		ConvertImgToRPageSize	;metrics routine to convert from							jsr			ConvertImgToRPageSize	;scaled-up units to const rPage units							ina							sta			ParamLongA+0							pha									;result space...							pha							pushlong	ParamLongA				;pass request size							pushword	PiFiMemPID				;pass our user id							pushword	#$C000					;request static block of memory							pha									;dummy loc ptr...							pha							_NewHandle							pulllong	ParamLongA				;obtain handle result							bcc			PiFiGotSCBMem							lda			#$0201					;memfull err							sta			errNo					;if problem do exit with tool err							brl			PiFiOutOfPagesLoopNoSCB	;and try to shut down gracefullyPiFiGotSCBMem				lda			[ParamLongA]			;deref static hdl to get ptr...							sta			PiFiSCBListPtr+0							ldy			#2							lda			[ParamLongA],y							sta			PiFiSCBListPtr+2*Init for first time end-of-page flag repeatedly used by our PicComment and GetPic bottleprocs:							stz			PrintLoopEndOfPageDetect*If user passed NIL for statusRecPtr, use our own private memory:							lda			statusRecPtr+0			;check to see if this is NIL...							ora			statusRecPtr+2			;if so, then user wants us to alloc							bne			PiFiFillStatRec			;it's not NIL, so we use user's space							lda			#PiFiStatusRecord		;set statrecptr to our own space...							sta			statusRecPtr+0							lda			#^PiFiStatusRecord							sta			statusRecPtr+2*Fill the "print status record" with values that won't change in the upcoming nested loops:PiFiFillStatRec				lda			PrintLoopNumActualPages	;store actual number of pages...							ldy			#oiTotPages							sta			[statusRecPtr],y							import		GetCopies				;store # of each pg to be printed...							jsr			GetCopies							ldy			#oiTotCopies							sta			[statusRecPtr],y							lda			printRecordHandle		;store handle to print record...							ldy			#ohPrint							sta			[statusRecPtr],y							lda			printRecordHandle+2							ldy			#ohPrint+2							sta			[statusRecPtr],y							lda			printGrafPortPtr		;store ptr to our grafport...							ldy			#opPrPort							sta			[statusRecPtr],y							lda			printGrafPortPtr+2							ldy			#opPrPort+2							sta			[statusRecPtr],y*Initialize the sheets-left-to-print decrementing counter used to show user in status box:							pha							pha							pushword	PrintLoopNumActualPages							import		GetCopies							jsr			GetCopies							pha							_Multiply							pullword	PiFiSheetsLeftToPrint	;init to #pages * #copies							pla*Calculate # of band passes needed: (Imaging[X|Y]Size) / Band[X|Y]Size, rounded up, with remainder:							import		GetImagingSize			;get size of offscreen buffer wePiFiCalcBandPasses			jsr			GetImagingSize			;would have liked... will compare							phx									;to the one we actually got...							phy							import		GetOrientation							jsr			GetOrientation							cmp			#1							beq			PiFiCalcPassesLand		;branch if landscape mode onPiFiCalcPassesPort			pla									;portrait mode: get Y size in acc							plx									;ignore X size here							ldx			PiFiLocInfoRect+ov2		;now ACC & X valid, go calc							bra			PiFiCalcPassesCalcPiFiCalcPassesLand			ply									;landscape mode: ignore Y size							pla									;get X size in acc							ldx			PiFiLocInfoRect+oh2		;now ACC & X valid, go calcPiFiCalcPassesCalc			stx			PiFiLastBandHeight		;ACC has imgsize,   ;initialize this							pha									;X has bandsize     ;result space							pha									;result space							pha									;pass tallness of pic to be printed							phx									;pass tallness of our band buffer							_UDivide							pla									;get quotient (# whole bands) in ACC							plx									;get remainder (# lines) in X							beq			PiFiCalcPassesStore		;skip next few lines if no remainder							stx			PiFiLastBandHeight		;if non-0 rem thn its sz of lst band,							ina									;and inc, must do 1 more smaller bandPiFiCalcPassesStore			ldy			#oiTotBands				;number of bands now in acc							sta			[statusRecPtr],y		;now store number of passes needed*Initialize counter for looping through all pages in document:							lda			#1						;we'll count index to pages in spool							ldy			#oiCurPage				;initialize page counter							sta			[statusRecPtr],y		;we'll stop at "iTotPages" field*Initialize printer communication/mechanics once for this print job:							jsr			PrinterOpen				;open connection (hog the printer)							lda			PrintLoopErrorStatus	;ensure PrinterOpen had no problems							beq			PiFiOpenedConnOk		;if it did (or user abort), exit							brl			PiFiOutOfPagesLoopPiFiOpenedConnOk							jsr			PrinterReset			;else go recalibrate print head, etc.**Head of code to print one page.  Set spool mark for playing same picture during copy/band loops:							import		SpoolMarkGetPiFiPrintOneMorePage		jsr			SpoolMarkGet**Initialize for looping through multiple copies of the current page:							lda			#1						;we'll count real-copy-numbers							ldy			#oiCurCopy				;initialize copy counter							sta			[statusRecPtr],y		;we'll stop at "iTotCopies" field***Head of code to print one copy. Intersheet stuff; manual sheet feed dialog, etc:PiFiPrintOneMoreCopy		ldy			#oiCurPage				;get current page being printed...							lda			[statusRecPtr],y							sta			ParamWordA							jsr			PrinterNewPage			;do inter-sheet activities							***Opportunity to exit if PrError set, by PrinterNewPage (manfeed cancel select), idleproc, etc:							lda			PrintLoopErrorStatus							beq			PiFiNoPrErrStat							brl			PiFiOutOfPagesLoop		;if set, dealloc/shutdown and exitPiFiNoPrErrStat***Display # of SHEETS (Copies and Pages) left to print in status box:							lda			PiFiSheetsLeftToPrint	;"PageCounter" must be valid							sta			PrintLoopPageCounter	;for status print in a sec...							import		StMeSheetsLeftMesg							lda			#StMeSheetsLeftMesg		;use "ParamLongA" var as param...							sta			ParamLongA+0							lda			#^StMeSheetsLeftMesg							sta			ParamLongA+2							jsr			ShowStatusWithPgNo		;print message in the status box***Initialize for looping through bands to print the picture a slice at a time:							lda			#1						;real-band-numbers starting at 1							ldy			#oiCurBand				;initialize band counter							sta			[statusRecPtr],y		;we'll stop at "iTotBands" field***Initialize the page-dirty flag:							lda			#0							ldy			#ofPgDirty							sta			[statusRecPtr],y***Advance paper vertically by GAP_size (if any) to provide top margin:							pushlong	#PiFiSpaceChar			;we do null text output to do posn							pushword	#0						;abs X							import		GetVGapSize							jsr			GetVGapSize				;get GAP size, is 0 if no_gaps is on							pha									;rel Y: move paper GAP size down							pushlong	#1						;text length							pushlong	#0						;text attributes							pushword	#160					;dummy crWidth							pushword	#0						;dummy paper length							;			  5432109876543210							lda			#%0000001101000011		;ActionBits cmd to do text call							ora			PrintLoopMaskIsIWOne	;make sure imager knows if old IW I							pha							pushword	#0						;QualityBits							pushlong	#0						;no IdleProc							import		Imager							jsl			Imager****Head of code to print one band.  Recue spool playback to start of current picture:							import		SpoolReturnToMarkGetPiFiPrintOneMoreBand		jsr			SpoolReturnToMarkGet****Get spool picture-playback size:							import		GetImagingSize			;get pixel size of imaged page							jsr			GetImagingSize							stx			PiFiDestRect+oh2		;store as 0,0,Y2,X2...							sty			PiFiDestRect+ov2							stz			PiFiDestRect+oh1							stz			PiFiDestRect+ov1****Calculate offset to play back the next part of picture into the banding buffer:							import		GetOrientationPiFiCalcOffset				jsr			GetOrientation							cmp			#1							beq			PiFiCalcOffsetLand		;branch if landscape mode onPiFiCalcOffsetPort			ldx			PiFiLocInfoRect+ov2							bra			PiFiCalcOffset1PiFiCalcOffsetLand			ldx			PiFiLocInfoRect+oh2PiFiCalcOffset1				ldy			#oiCurBand				;get current band number index...							lda			[statusRecPtr],y							dea									;minus one to get start index at 0							pha									;result space							pha							pha									;pass current band							phx									;pass band size							_Multiply							;multiply to get destrect offset							pullword	ParamWordE				;save for subtracts in a minute							pla									;ignore result hi word****Subtract the offset obtained above from Y1 & Y2 (portrait) or X1 & X2 (landscape):							import		GetOrientation							jsr			GetOrientation							cmp			#1							beq			PiFiSubOffLand			;if landscape mode onPiFiSubOffPort				lda			PiFiDestRect+ov1		;destrect.y1 -= ParamWordE...							sec							sbc			ParamWordE							sta			PiFiDestRect+ov1							lda			PiFiDestRect+ov2		;destrect.y2 -= ParamWordE...							sec							sbc			ParamWordE							sta			PiFiDestRect+ov2							bra			PiFiDoneSubOffPiFiSubOffLand				lda			PiFiDestRect+oh1		;destrect.x1 -= ParamWordE...							sec							sbc			ParamWordE							sta			PiFiDestRect+oh1							lda			PiFiDestRect+oh2		;destrect.x2 -= ParamWordE...							sec							sbc			ParamWordE							sta			PiFiDestRect+oh2PiFiDoneSubOff****Clear the band buffer to all-white using our (unmodified default white) grafport background:PiFiClearBandBuff			pushlong	#PiFiLocInfoRect		;clear entire band buffer...							_EraseRect****Screen colors -> our color table; may be mod by PicComments during upcoming DrawPicture call:							pushlong	#$E19E00				;screen color table							pushlong	#PrintLoopRoutineData	;fill our data area							pushlong	#512					;16 palettes of 16 2-byte words							_BlockMove****Imaging port's portSCB -> fill our SCB tbl; may be mod by PicComments during DrawPicture call:							lda			PiFiSCBListPtr+0		;setup ParamLongA with address							sta			ParamLongA+0			;of our SCB list...							lda			PiFiSCBListPtr+2							sta			ParamLongA+2							lda			PiFiLocInfoRect+ov2		;setup with length of							import		ConvertImgToRPageSize	;our SCB list...							jsr			ConvertImgToRPageSize							sta			PiFiFillSCBListLimit+1							ldy			#0							lda			PiFiLocInfo+0			;obtain our portSCB							shortm								;store as BYTEsPiFiFillSCBListLoop			sta			[ParamLongA],y							inyPiFiFillSCBListLimit		cpy			#$FFFF					;NOTE: operand is stuffed							beq			PiFiFillSCBListLoop							bcc			PiFiFillSCBListLoop							longm****Display message indicating that DrawPicture is creating image of current page:							import		StMeRenderingMesg							lda			#StMeRenderingMesg							sta			ParamLongA+0							lda			#^StMeRenderingMesg							sta			ParamLongA+2							import		StatusMessage							jsr			StatusMessage****Call DrawPicture to draw entire page image, showing only a slice into banding/imaging buffer:							pushlong	#1						;bogus, unused, non-NIL pichandle							pushlong	#PiFiDestRect			;translation and scaling rect							_DrawPicture						;BOTTLEPROCS/PICCOMMENTS RUN NOW!							bcc			PiFiNoDPError			;if any error occured, terminate							sta			errNo							sta			PrintLoopErrorStatus							brl			PiFiOutOfPagesLoopPiFiNoDPError****Change current message display (back) to the sheets-left-to-print message:							lda			PiFiSheetsLeftToPrint							sta			PrintLoopPageCounter							import		StMeSheetsLeftMesg							lda			#StMeSheetsLeftMesg							sta			ParamLongA+0							lda			#^StMeSheetsLeftMesg							sta			ParamLongA+2							jsr			ShowStatusWithPgNo****Save last band's height because we might modify it next:							import		GetOrientation							jsr			GetOrientation							ldx			PiFiLocInfoRect+oh2							ldy			PiFiLocInfoRect+ov2							cmp			#1							beq			PiFiSaveBandLand							sty			ParamWordE							bra			PiFiAdjBandPiFiSaveBandLand			stx			ParamWordE****If last band, adjust bandsize here at the last minute because it might be shorter:PiFiAdjBand					ldy			#oiTotBands				;get total # of bands to be done							lda			[statusRecPtr],y							cmp			#1						;no adjust if doing it all in 1 band							beq			PiFiDoneAdjBand			;(because PiFiLastBandHeight is 0)							ldy			#oiCurBand				;now compare to curr band we're on							cmp			[statusRecPtr],y							bne			PiFiDoneAdjBand			;no adjust if not last band							import		GetOrientation							jsr			GetOrientation							ldy			PiFiLastBandHeight							cmp			#1							beq			PiFiAdjBandLand			;if landscape mode on							sty			PiFiLocInfoRect+ov2							bra			PiFiDoneAdjBandPiFiAdjBandLand				sty			PiFiLocInfoRect+oh2PiFiDoneAdjBand****Call imager to convert pixelmap in band buffer to escape sequences and send to printer:PiFiImagerCall				pushlong	#PiFiLocInfo			;pass our locinfo with pixmap ptr							pushlong	#PiFiLocInfoRect		;pass clipped rect ptr to band 							import		GetImagerCTable			;get wanted color table, carry...							jsr			GetImagerCTable			;will be set if was nil => default							bcs			PiFiNotDefaultCTable	;branch if user has own color table							ldx			#PrintLoopRoutineData	;else use our color table...							ldy			#^PrintLoopRoutineDataPiFiNotDefaultCTable		phy									;pass hi/lo words of colr tbl ptr...							phx							import		GetImagerSCBList		;get wanted SCB list, carry...							jsr			GetImagerSCBList		;will be set if was nil => default							bcs			PiFiNotDefaultSCBList	;branch if user has own SCB list							ldx			PiFiSCBListPtr+0		;else use our piccomment-modifyable							ldy			PiFiSCBListPtr+2		;...SCB listPiFiNotDefaultSCBList		phy									;pass hi/lo words of scb list ptr...							phx							import		GetCrWidth				;get crWidth from metrics; crWidth							jsr			GetCrWidth				;is super-right-margin; for example,							pha									;it determines landscape rmargin							pushword	#0						;pass dummy paper length							;			  5432109876543210		;pass action bits: FF:N,Init:N,							lda			#%0000001100000011		;Img:Y,Op/Cl:N							ora			PrintLoopMaskIsIWOne	;taking old IW I into consideration							pha							import		GetConvertQualBits		;get wanted feature select for imager							jsr			GetConvertQualBits							pha									;pass image routine feature select							pushlong	#BufferIdleProc			;pass our idle proc which calls user							import		Imager					;transfer control to the low-level							jsl			Imager					;driver, which also does idleproc							bcs			PiFiImagerExitStatusSet	;exit status nonzero, go check it							****Check print loop error status, which the user may have modified during the idleproc:							lda			PrintLoopErrorStatus	;if the PrError status is zero,							beq			PiFiImagedSuccessfully	;then go on, else, assume abort; no							bra			PiFiUserWantsAbort		;other user access to errors allowed****Error or user-abort happened during imaging, so deal with it depending on type of error:PiFiImagerExitStatusSet		cmp			#$0080					;did user type command-period?							beq			PiFiUserWantsAbort		;if so, set error and stop printing							jsr			ShowPrinterErrorStatus	;else, show mesg in ACC for a sec...							lda			PiFiSheetsLeftToPrint	;restore sheets-left message...							sta			PrintLoopPageCounter							import		StMeSheetsLeftMesg							lda			#StMeSheetsLeftMesg							sta			ParamLongA+0							lda			#^StMeSheetsLeftMesg							sta			ParamLongA+2							jsr			ShowStatusWithPgNo							brl			PiFiImagerCall			;...and try again...****If user typed command-period, do FF and exit as if we finished print job:PiFiUserWantsAbort			lda			#prAbort				;user did cmd-'.': set abort flag							sta			PrintLoopErrorStatus	;(but don't set tool exit error)							jsr			PrinterFormfeed			;eject the page always							brl			PiFiOutOfPagesLoop		;clean up and abort****Restore bandsize in case it was modified if this was last band:							import		GetOrientationPiFiImagedSuccessfully		jsr			GetOrientation							ldy			ParamWordE							cmp			#1							beq			PiFiRestBandLand		;landscape mode on							sty			PiFiLocInfoRect+ov2							bra			PiFiRestBandDonePiFiRestBandLand			sty			PiFiLocInfoRect+oh2PiFiRestBandDone****Indicate that we've used ink (even if we haven't).  FYI for whoever's looking at status rec:							lda			#1							ldy			#ofPgDirty							sta			[statusRecPtr],y****Tail of do-one-band code.  See if we need to do another band:							ldy			#oiCurBand				;get current band number index...							tyx									;save this index for use below							lda			[statusRecPtr],y		;get it							ldy			#oiTotBands				;compare with total bands needed...							cmp			[statusRecPtr],y		;compare it							bcs			PiFiOutOfBandsLoop		;if we're done, break out of loop							ina									;else increment and store back...							txy									;restore oiCurBand index							sta			[statusRecPtr],y		;store it							brl			PiFiPrintOneMoreBand	;loop backPiFiOutOfBandsLoop***Tail of do-one-copy code.  1) Do form feed (if not "no gaps") to advance to next sheet:							import		GetPageGap				;if no_gaps, then there is more							jsr			GetPageGap				;imaging area so there is more							bne			PiFiDontFFBetweenSheets	;printed area, and thus no need for							jsr			PrinterFormfeed			;formfeed to skip to next pagePiFiDontFFBetweenSheets***Tail of do-one-copy code.  2) Decrement sheets-left-to-print user display counter:							dec			PiFiSheetsLeftToPrint***Tail of do-one-copy code.  3) See if we need to print another copy:							ldy			#oiCurCopy				;get current copy number index...							tyx									;save this index for use below							lda			[statusRecPtr],y		;get it							ldy			#oiTotCopies			;compare with total copies needed...							cmp			[statusRecPtr],y		;compare it							bcs			PiFiOutOfCopiesLoop		;if we're done, break out of loop							ina									;else increment and store back...							txy									;restore oiCurCopy index							sta			[statusRecPtr],y		;store it							brl			PiFiPrintOneMoreCopy	;loop back**Tail of do-one-page code. See if we need to print another page:PiFiOutOfCopiesLoop			ldy			#oiCurPage				;get current page number index...							tyx									;save this index for use below							lda			[statusRecPtr],y		;get it							ldy			#oiTotPages				;compare with total pages needed...							cmp			[statusRecPtr],y		;compare it							bcs			PiFiOutOfPagesLoop		;if we're done, break out of loop							ina									;else increment and store back...							txy									;restore oiCurPage index							sta			[statusRecPtr],y		;store it							brl			PiFiPrintOneMorePage	;loop back*Done with print job.  Release banding mem attached to our locinfo attached to our grafport.*This is where resources are terminated for graceful exits during error conditions:PiFiOutOfPagesLoop			pha									;dump our SCB mem	;result space							pha														;result space							pushlong	PiFiSCBListPtr								;didn't keep hdl							_FindHandle												;so find from ptr							_DisposeHandle											;hdl on stackPiFiOutOfPagesLoopNoSCB		pha									;dump our band mem	;result space							pha														;result space							pushlong	PiFiLocInfoPixPtr							;didn't keep hdl							_FindHandle												;so find from ptr							_DisposeHandle											;hdl on stack							pushword	PiFiMemPID				;dump our user ID							_DeleteID*Set QuickDraw global internal clip buffers back to previous size:							pushlong	#PiFiOldQDBuffRec							_RestoreBufDims*Restore previous grafport and close our band buffer grafport:PiFiAbortNoBandMemAlloc		pushlong	OldGrafPortPtr			;restore caller's grafport first...							_SetPort							pushlong	printGrafPortPtr		;close our grafport, which also...							_ClosePort							;deallocs clip/vis rgn memory*Terminate the spooling process:							import		SpoolFinishGet							jsr			SpoolFinishGet							cmp			#1						;check for error in acc							bcc			PiFiNoFinishGetErr							sta			errNo					;if nonzero, make *it* the tool errPiFiNoFinishGetErr*Terminate communication with the printer:							jsr			PrinterClose			;stop hogging the printer*Remove the status box in any case:							import		FinishStatusMessage							jsr			FinishStatusMessage							*Get rid of stray keystroke events and exit:							pha									;flush other keyboard events							pushword	#%0000000000001110							pushword	#0							_FlushEvents							pla							rts*During-printing status record space to use if user passed NIL:PiFiStatusRecord			ds.b		$1C*User ID for mallocing memory during this routine for banding buffer, SCB list, etc:PiFiMemPID					dc.w		0*GrafPort.LocInfo record describing banding buffer (offscreen pixelmap):PiFiLocInfo					dc.w		0						;portSCBPiFiLocInfoPixPtr			dc.l		0						;ptrToPixImage ptr to imaging bufferPiFiLocInfoWidth			dc.w		0						;width of one scan line in bytesPiFiLocInfoRect				dc.w		0,0,0,0					;boundsRect in pixels*Destination scaling rectangle for DrawPicture picture playback:PiFiDestRect				dc.w		0,0,0,0*Last band may be smaller than all other bands to print what's left, for bands are Y-size aligned:PiFiLastBandHeight			dc.w		0						;height of special-case last band*Storage for decrementing computed number of sheets left to print (pages*copies):PiFiSheetsLeftToPrint		dc.w		0*QuickDraw buffer size information record storage:PiFiOldQDBuffRec:												;to save/alter/restore QD buffersPiFiOldQDBuffMaxWidth		dc.w		0PiFiOldQDBuffTxtHeight		dc.w		0PiFiOldQDBuffTxtWidth		dc.w		0PiFiOldQDBuffMFBREx			dc.w		0*Dummy character used for imager vertical positioning call:PiFiSpaceChar				dc.b		' '*Ptr to malloced memory holding application-piccomment-modifyable SCB list for curr imager call:PiFiSCBListPtr				dc.l		0**GETPRINTLOOPERROR: This routine returns the value of the status variable in ACC:*							export		GetPrintLoopErrorGetPrintLoopError			lda			PrintLoopErrorStatus							rts																					**SETPRINTLOOPERROR: This routine stores the value of ACC into the status variable:*							export		SetPrintLoopErrorSetPrintLoopError			sta			PrintLoopErrorStatus							rts**PRIVATE ROUTINES: Called by the high-level print model routines above:***BUFFERIDLEPROC: Our idleproc that is passed to imager.  Allows quick abort in middle of imaging:*							import		GetIdleProc				;requires valid pr rec handle on dp!BufferIdleProc				jsr			GetIdleProc				;get lo->X, hi->Y, not NIL->carry							bcc			BuIdDone				;if no idleproc, just exit							stx			BuIdGotoUser+1			;else build JSL to user and go							shortx							sty			BuIdGotoUser+3							longx							phd							phbBuIdGotoUser				jsl			$FFFFFF					;NOTE: operand is stuffed							plb							pld							lda			PrintLoopErrorStatus	;after user call, check PrError							beq			BuIdDone				;if set, then set imager-abort-flag							lda			#$0080							import		PrError							sta			PrErrorBuIdDone					rtl**PRINTERIMAGERSVCCALL: Calls imager with all dummy params except ActionBits -> ACC; ACC/c -> Error:*PrinterImagerSvcCall		ldx			#0						;we'll pass zeroes							phx									;dummy pix loc info ptr hi							phx									;dummy pix loc info ptr lo							phx									;dummy pix pr rect ptr hi							phx									;dummy pix pr rect ptr lo							phx									;dummy color tbl ptr hi							phx									;dummy color tbl ptr lo							phx									;dummy scb list ptr hi							phx									;dummy scb list ptr lo							phx									;dummy carriage width							phx									;dummy paper length							ora			PrintLoopMaskIsIWOne	;pass ActionBits given in ACC							pha									;while considering if on IW I							phx									;dummy quality bits							phx									;dummy idle proc hi							phx									;dummy idle proc lo							import		Imager							jsl			Imager							rts									;exit RTS, leaving ACC/carry set**PRINTEROPEN: Call once/job, before all pr I/O. Opens/hogs connection, may set PrintLoopErrorStatus:*If it returns w/o error, it has an exclusive connection so nobody else can interfere.*PrintRecordHandle on DP must be valid because the IdleProc is called to allow abort.*It does printer self-ID; it sets the "PrintLoopMaskIsIWOne" mask if we're on an ImageWriter I.*PrinterOpenPrOpTryOrExit				jsl			BufferIdleProc			;do usr idleproc, affect err stat							lda			PrintLoopErrorStatus	;if error status was set, bail out							beq			PrOpNoIPAbort			;else iproc didn't set it, so go on							rts							import		StMePrinterOpenMesg		;put up message because it mightPrOpNoIPAbort				lda			#StMePrinterOpenMesg	;take a few seconds							sta			ParamLongA+0							lda			#^StMePrinterOpenMesg							sta			ParamLongA+2							import		StatusMessage							jsr			StatusMessagePrOpCheckIfShouldDoID		lda			PrintLoopCheckedIsIWOne	;only allow the is-iw-one flag to be							bne			PrOpDoTheOpen			;changed (one way or the other) the							lda			#1						;1st time since we're loaded because							sta			PrintLoopCheckedIsIWOne	;if the pr is busy it won't respondPrOpDoTheID					stz			PrintLoopMaskIsIWOne	;assume not old IW I for the moment							;			  5432109876543210							lda			#%0000000010000000							jsr			PrinterImagerSvcCall	;ask imager to do ID only							;			  5432109876543210							bit			#%0000000000001000		;if ID bit 3 is set, then we have							beq			PrOpNotIWOne			;an IW I, so set actionbits mask...							;			  5432109876543210							ldx			#%0000000000000100							stx			PrintLoopMaskIsIWOnePrOpNotIWOne							;			  5432109876543210PrOpDoTheOpen				lda			#%0000001000100011		;FF:N,Init:N,Img:N,ID:N,Op:Y,Cl:N							jsr			PrinterImagerSvcCall							cmp			#0						;did an error occur?							beq			PrOpOk					;open was successful, so continue							cmp			#$0080					;did user hit control-period already?							beq			PrOpSetPrAbort			;if so, set print loop error to abort							jsr			ShowPrinterErrorStatus	;else put message in the box...							bra			PrOpTryOrExit			;...and try againPrOpSetPrAbort				lda			#prAbort							sta			PrintLoopErrorStatusPrOpOk						rts**PRINTERCLOSE: Terminates exclusive connection to printer, freeing it for other users:*							;			  5432109876543210PrinterClose				lda			#%0000000100100011		;FF:N,Init:N,Img:N,Op:N,Cl:Y							brl			PrinterImagerSvcCall	;exit through this routine**PRINTERRESET: Called once/job: Mesg, calibrate, set sheet len.  NOTE: PrRec, Status box assumed.*PrinterReset				lda			PrintLoopErrorStatus	;do only if no pending err already							bne			PrReExit							import		StMePrinterResetMesg	;show message indicating that							lda			#StMePrinterResetMesg	;printer mechanics are happening...							sta			ParamLongA+0			;NOTE: Assumes presence of box!							lda			#^StMePrinterResetMesg							sta			ParamLongA+2							import		StatusMessage							jsr			StatusMessage							pushlong	#0						;dummy pix loc info							pushlong	#0						;dummy pix pr rect ptr							pushlong	#0						;dummy color tbl ptr										pushlong	#0						;dummy scb list ptr							pushword	#0						;dummy carriage width							import		GetPaperLength			;obtain length of current paper type							jsr			GetPaperLength			;NOTE: Assumes PrintRecordHandle!							pha									;pass sheet length to be set...							;			  5432109876543210		;pass action bits:							lda			#%0000001100100001		;FF:N,Init:Y,Img:N,Op/Cl:N							ora			PrintLoopMaskIsIWOne	;and consider if we're on IW I							pha							pushword	#0						;dummy quality bits							pushlong	#0						;dummy idle proc							import		Imager							jsl			ImagerPrReExit					rts**PRINTERFORMFEED: Causes printer to do form feed:*							;			  5432109876543210PrinterFormfeed				lda			#%0000001100100010		;FF:Y,Init:N,Img:N,Opn/Cls:N							brl			PrinterImagerSvcCall	;exit through this routine**PRINTERNEWPAGE: Do beginpage. Man-feed dialog, etc. Pass curr pg -> ParamWordA:*This routine has the side-effect of setting PrintLoopErrorStatus if manfeed with "cancel" selected.*On exit, status box contents are erased, except if manfeed cancel it puts up message.*Valid current print record handle is necessary.*							import		GetFeedPrinterNewPage				jsr			GetFeed					;sets zero flag if manual page feed							bne			NewPgNotManFeed			;don't do dialog if auto feed							_InitCursor							;arrow cursor							import		StatusMesgFeedPrompt	;ParamWordA (page#) already set...							jsr			StatusMesgFeedPrompt	;put up the dialog until select							bcc			NewPgNotCancel							lda			#prAbort				;if manfeed+cancel hit, set PrError							sta			PrintLoopErrorStatus							import		StMeCancellingMesg		;and also show user what's happening							lda			#StMeCancellingMesg							sta			ParamLongA+0							lda			#^StMeCancellingMesg							sta			ParamLongA+2							import		StatusMessage							jsr			StatusMessageNewPgNotCancel				_WaitCursor							;watch cursorNewPgNotManFeed				rts**SHOWPRINTERERRORSTATUS: Displays mesg about pr status code (received from imager) given in ACC:*ShowPrinterErrorStatus		cmp			#$0081							bne			ShPrEr1							import		StMeCommunicationMesg							ldx			#StMeCommunicationMesg							bra			ShPrErDisplayItShPrEr1						cmp			#$0082							bne			ShPrEr2							import		StMeOutOfPaperMesg							ldx			#StMeOutOfPaperMesg							bra			ShPrErDisplayItShPrEr2						cmp			#$0083							bne			ShPrEr3							import		StMePaperJamMesg							ldx			#StMePaperJamMesg							bra			ShPrErDisplayItShPrEr3						cmp			#$0084							bne			ShPrEr4							import		StMeCoverOpenMesg							ldx			#StMeCoverOpenMesg							bra			ShPrErDisplayItShPrEr4						cmp			#$0085							bne			ShPrEr5							import		StMeSelectOffMesg							ldx			#StMeSelectOffMesg							bra			ShPrErDisplayItShPrEr5						cmp			#$008F							bne			ShPrErHuh							import		StMeInUseMesg							ldx			#StMeInUseMesg							ShPrErDisplayIt				stx			ParamLongA							import		StMeCommunicationMesg	;assuming all messages are in							ldx			#^StMeCommunicationMesg	;the same bank...							stx			ParamLongA+2							import		StatusMessage			;show the message							jsr			StatusMessage														pha									;wait a few seconds...							pushword	#0						;anchor value							pushword	#StatusMesgDelay*16		;number of 16ths of ticks to wait							ldx			#$3A03					;_WaitUntil							jsl			$E10000							pla									;ignore new anchor result														ShPrErHuh					rts**SHOWSTATUSWITHPGNO: Displays string at ParamLongA, with ASCII of PrintLoopPageCounter at posn 26:*ShowStatusWithPgNo			pushword	PrintLoopPageCounter	;int to be converted to string							clc							lda			ParamLongA							adc			#26						;this routine always puts number							tax									;at 26th position in the string!							lda			ParamLongA+2							adc			#0							pha									;hi word of where number goes							phx									;lo word of where number goes							pushword	#5						;length							pushword	#0						;unsigned							_Int2Dec							import		StatusMessage							brl			StatusMessage			;exit through StatusMessage**BOTTLEPROCS: Our custom QuickDraw bottle-neck procedures (called by QuickDraw):***PUTPIC: Our PutPic bottleproc called as "void PutPic (ptr,count) word *ptr word count"; err->c,acc:*PutPic						phb									;save bank register on stack							phd									;save direct page register on stack							phk									;B=K so we can use abs addressing...							plb							tsc									;allocate space on stack for...							sec									;our direct page...							sbc			#DPSizeParamOnly							tcs							ina							tcd									;set D so we can use dp addressingPuPiStackParam				equ			1+3+1+2+DPSizeParamOnly	;1 + RTL + B + D + StackFrame							lda			PuPiStackParam+0,s		;count word -> ParamLongB...							sta			ParamLongB+0							stz			ParamLongB+2							lda			PuPiStackParam+2,s		;ptr long -> ParamLongC...							sta			ParamLongC+0							lda			PuPiStackParam+4,s							sta			ParamLongC+2*Done saving environment; now do the work:							import		SpoolPut				;go spool it							jsr			SpoolPut							cmp			#1						;did any error happen?							bcc			PutGetNoErrorPutGetError					sta			PrintLoopErrorStatus	;if error set global static var							tax									;and always tell QD about error							bra			PutGetExitPutGetNoError				ldx			#0						;this is the no-error exit point*Now restore previous environment and exit with status in X in ACC/carry:PutGetExit					tsc									;deallocate stack frame...							clc							adc			#DPSizeParamOnly							tcs							pld									;restore direct reg off stack							plb									;restore bank reg off stack							lda			0,s						;move the RTL up, cleaning the...							sta			6,s						;six input param bytes off...							lda			2,s							sta			8,s							tsc									;now add 6 to S to move it up...							clc									;can't do above since B/D on stack							adc			#6							tcs							txa									;X has err, -> ACC/Carry							cmp			#1							rtl																					**GETPIC: Our GetPic bottleproc called as "void GetPic (ptr,count) word *ptr word count"; err->c,acc:*GetPic						phb									;save bank register on stack							phd									;save direct page register on stack							phk									;B=K so we can use abs addressing...							plb							tsc									;allocate space on stack for...							sec									;our direct page...							sbc			#DPSizeParamOnly							tcs							ina							tcd									;set D so we can use dp addressingGePiStackParam				equ			1+3+1+2+DPSizeParamOnly	;1 + RTL + B + D + StackFrame							lda			GePiStackParam+0,s		;count word -> ParamLongB...							sta			ParamLongB+0							stz			ParamLongB+2							lda			GePiStackParam+2,s		;ptr long -> ParamLongC...							sta			ParamLongC+0							lda			GePiStackParam+4,s							sta			ParamLongC+2*Done saving environment; now do the work:							ldx			PrintLoopEndOfPageDetect							bne			GetPicItsEndOfPage		;our end-of-page PicComment happened							import		SpoolGet				;else get data from spool							jsr			SpoolGet							cmp			#$FFFF					;end of all spool data?							beq			GetPicItsEndOfPage							cmp			#1						;error during spool operation?							bcc			PutGetNoError			;if not, exit clean							bcs			PutGetError				;if yes, set pr err and tell QDGetPicItsEndOfPage			stz			PrintLoopEndOfPageDetect							ldx			#$1210					;clear end-of-page flag and tell QD							bra			PutGetExit				;to stop drawing with "PicEmpty" err**PICCOMMENT: Our bottleproc that informs us of end-of-picture and allows mid-document color changes*This routine is called from inside DrawPicture and thus runs just before each imager call:*PicComment					ldy			#0							;get contents of comment data...							lda			[QDAuxTheHandleDPLoc],y							sta			>PiCoReadComment+1							iny							iny							lda			[QDAuxTheHandleDPLoc],y							shortm							sta			>PiCoReadComment+3							longm							ldx			QDAuxTheSizeDPLoc							cpx			#4							;min size of our comments is 4							bcc			PiCoExit							cpx			#42+1						;max size of our comments is 42							bcs			PiCoExit							shortm									;copy to local static storage...							dexPiCoReadComment				lda			>$FFFFFF,x					;NOTE: stuffed operand							sta			>PiCoCommentData,x							dex							bpl			PiCoReadComment							longm*							lda			>PiCoCommentData+0			;ensure version field is 0							bne			PiCoExit							lda			>PiCoCommentData+2			;ensure sig field is $A55A							cmp			#$A55A							bne			PiCoExit*							lda			QDAuxTheKindDPLoc			;get kind of comment...							cmp			#EndOfPagePicCommentKind	;our end-of-page marker?							beq			PiCoEndOfPage							cmp			#ChangeCTBLPicCommentKind	;app's color tbl change cmd?							beq			PiCoChangeCTBL							cmp			#ChangeSCBPicCommentKind	;app's scb change cmd?							beq			PiCoChangeSCB*PiCoExit					lda			#0							;exit clean, no error status							clc							rtl**End-Of-Page PicComment handler:*PiCoEndOfPage				lda			#1							;set flag so we'll know							sta			>PrintLoopEndOfPageDetect	;about end-of-page/picture							bra			PiCoExit					;done with end-of-page-set-flag**Change-A-Color-Table-Entry PicComment handler:*PiCoChangeCTBL				pushlong	#PiCoCommentData+6			;pass "source" for BlockMove							lda			>PiCoCommentData+4			;get table# field							asl a									;*32 to get index into color tbl							asl a							asl a							asl a							asl a							clc										;+address of our color tbl							adc			#PrintLoopRoutineData							tax							lda			#0							adc			#^PrintLoopRoutineData							pha										;pass "dest" for BlockMove							phx							pushlong	#32							;pass "length" for BlockMove							_BlockMove							bra			PiCoExit					;done with change-color-table**Change-One-Or-More-SCB-Value(s) PicComment handler:*PiCoChangeSCB				phb										;do set our B							phk							plb*							sec										;find out the range of y coords							lda			#0							;that we're imaging currently							sbc			PiFiDestRect+ov1			;these will be in imaging units							sta			PiCoChSCB_curr_img_y1							clc							adc			PiFiLocInfoRect+ov2							sta			PiCoChSCB_curr_img_y2*							lda			PiCoChSCB_curr_img_y1		;convert from imaging units to							import		ConvertImgToRPageSize		;rPage units							jsr			ConvertImgToRPageSize							sta			PiCoChSCB_curr_img_y1							lda			PiCoChSCB_curr_img_y2							import		ConvertImgToRPageSize							jsr			ConvertImgToRPageSize							sta			PiCoChSCB_curr_img_y2*							lda			PiFiSCBListPtr+0			;setup adrs of our-scb-list							sta			PiCoChSCBSto+1				;in preparation for access							lda			PiFiSCBListPtr+2							shortm							sta			PiCoChSCBSto+3							longm*							ldx			PiCoCommentData+4			;get "Y1" from ChSCB piccommentPiCoChSCBLoop				cpx			PiCoChSCB_curr_img_y1		;check to see if this SCB falls							bcc			PiCoChSCBDoNext				;within the limits of the							cpx			PiCoChSCB_curr_img_y2		;current banding/imaging buffer							beq			PiCoChSCBInRange							bcs			PiCoChSCBDoNextPiCoChSCBInRange*							txy										;normalize from rPage-based Y							txa										;coordinate to bandbuff-based Y							sec							sbc			PiCoChSCB_curr_img_y1							tax							lda			PiCoCommentData+8			;get "SCB" from ChSCB piccomment							shortmPiCoChSCBSto				sta			>$FFFFFF,x					;NOTE: operand is stuffed							longm							tyx*PiCoChSCBDoNext				inx										;try to modify another SCB							cpx			PiCoCommentData+6			;until "Y2" from ChSCB piccomment							beq			PiCoChSCBLoop							bcc			PiCoChSCBLoop*							plb										;restore old B							brl			PiCoExit					;done with change-scb(s)*PiCoChSCB_curr_img_y1		dc.w		0							;1st line of current band bufferPiCoChSCB_curr_img_y2		dc.w		0							;lst line of current band buffer*PiCoCommentData				ds.b		44							;buffer holding PicComment data**PUTTEXT: Our Text bottleproc which is used during draft printing using printer's native text mode:*This routine attempts to map a quickdraw screen font/style into a native ascii font/style:*PutText						phb									;save QD bank reg on stack							phd									;save QD direct reg on stack							phk									;set bank reg to our code...							plb							lda			QDDrawVerbDPLoc			;get info off QD direct page							sta			PuTeDrawVerb			;and save them here...							lda			QDTextPtrDPLoc							sta			PuTeTextPtr							lda			QDTextPtrDPLoc+2							sta			PuTeTextPtr+2							lda			QDTextLengthDPLoc							sta			PuTeTextLength							lda			QDCharToDrawDPLoc							sta			PuTeCharToDraw							tsc									;allocate space on stack for...							sec									;our direct page...							sbc			#DPSize							tcs							ina							tcd									;set D so we now have direct page*Done setting up environment; now do work.  Handle case for a single character of text:							lda			PuTeDrawVerb							cmp			#QDDrawCharVerbEqu		;single character?							bne			PuTeItsString			;no, must be a string							lda			#1						;length is one							sta			PuTeStrLen							lda			#PuTeCharToDraw			;location of character							sta			PuTeTextPtr							lda			#^PuTeCharToDraw							sta			PuTeTextPtr+2							bra			PuTeGotString*Handle case for pascal string:PuTeItsString				lda			PuTeDrawVerb							cmp			#QDDrawTextVerbEqu		;pascal string?							bne			PuTeNotPString			;no, not pascal string							lda			PuTeTextLength			;get length 0..255 in word							sta			PuTeStrLen				;store it							bra			PuTeGotString*Handle case for c string:PuTeNotPString				cmp			#QDDrawCStrVerbEqu		;c string?							beq			PuTeItsCString			;yes							brl			PuTeExitErrorInACC		;no, error...PuTeItsCString				lda			PuTeTextPtr				;will need [dp] addressing...							sta			ParamLongA							lda			PuTeTextPtr+2							sta			ParamLongA+2							ldy			#0						;count to get length							shortmPuTeCountCLen				lda			[ParamLongA],y							beq			PuTeGotCLen							iny							bne			PuTeCountCLen							longm							lda			#-1							brl			PuTeExitErrorInACCPuTeGotCLen					longm							sty			PuTeStrLen				;store length*Now text at PuTeTextPtr, len at PuTeStrLen.  Now also get current Y,X coordinates:PuTeGotString				pushlong	#PuTePenPos				;pass ptr where to store coords							_GetPen								;PuTePenPos now has Y,X coords							*Don't continue if the string begins outside of current clipping settings:PuTeClip					pha									;result space for PtInRgn							pushlong	#PuTePenPos				;pass pen posn for PtInRgn							pha									;result space for GetClipHandle							pha									;result space for GetClipHandle							_GetClipHandle						;stack now has space, penpos, cliphdl							_PtInRgn							;note that we had set the grafport's							pla									;clip region in OpenPage, and it							bne			PuTeDontClip			;is also possible that the user has							brl			PuTeExitUpdatePosn		;since modified itPuTeDontClip*Now get current font name/size/style information and arbitrarily map into native text modes:							shortm							stz			PuTeNativeFont			;set defaults...							lda			#2							sta			PuTeNativeSpacing							stz			PuTeNativeAttributes							longm							pha									;get current font ID...							pha							_GetFontID							pla							plx							cmp			#$FFFE					;if not shaston, diff font/spacing...							beq			PuTeLookAtSize							shortx							ldx			#0							stx			PuTeNativeFont							ldx			#4							stx			PuTeNativeSpacing							longx							cmp			#$0016					;if courier, special font/spacing...							bne			PuTeNotCourier							shortx							ldx			#1							stx			PuTeNativeFont							ldx			#2							stx			PuTeNativeSpacing							longx							bra			PuTeLookAtSizePuTeNotCourier				cmp			#$0014					;if times, special font/spacing...							bne			PuTeLookAtSize							shortx							ldx			#2							stx			PuTeNativeFont							ldx			#5							stx			PuTeNativeSpacing							longxPuTeLookAtSize				pha									;get current font size...							_GetTextSize							pla							beq			PuTeNotTinyText			;if 0, leave size alone...							cmp			#8						;if < 8pt, do half-height/pitch...							bcs			PuTeNotTinyText							shortm							lda			#5							sta			PuTeNativeSpacing							longm							lda			#%00001000							bra			PuTeModSizeAttrPuTeNotTinyText				cmp			#14						;if >= 14pt, do double-width...							bcc			PuTeNotBigText							lda			#%00000100PuTeModSizeAttr				shortm							ora			PuTeNativeAttributes							sta			PuTeNativeAttributes							longmPuTeNotBigText				pha									;get current font style...							_GetTextFace							pla							tax							and			#%00000001				;if bold, do boldface...							beq			PuTeNotBold							lda			#%00000001							shortm							ora			PuTeNativeAttributes							sta			PuTeNativeAttributes							longmPuTeNotBold					txa							and			#%00000100				;if underline, do underline...							beq			PuTeNotUnderline							lda			#%00000010							shortm							ora			PuTeNativeAttributes							sta			PuTeNativeAttributes							longmPuTeNotUnderline			txa							and			#%00000010				;if italic, set light font...							beq			PuTeStoreHeader							shortm							lda			#1							sta			PuTeNativeFont							longm*(1): Store above-obtained information for this string in spool, for playing back during ClosePage:PuTeStoreHeader				lda			#PuTeInfoHeaderEnd-PuTeInfoHeaderBegin							sta			ParamLongB+0							stz			ParamLongB+2							lda			#PuTeInfoHeaderBegin							sta			ParamLongC+0							lda			#^PuTeInfoHeaderBegin							sta			ParamLongC+2							import		SpoolPut							jsr			SpoolPut							cmp			#1							bcs			PuTeExitErrorInACC*(2): Store the actual text for current string in spool file, for playing back during ClosePage:PuTeStoreString				lda			PuTeStrLen							sta			ParamLongB+0							stz			ParamLongB+2							lda			PuTeTextPtr+0							sta			ParamLongC+0							lda			PuTeTextPtr+2							sta			ParamLongC+2							import		SpoolPut							jsr			SpoolPut							cmp			#1							bcs			PuTeExitErrorInACC*Do TextWidth and Move calls to update horizontal pen position just like normal StdText bottleproc:PuTeExitUpdatePosn			pha									;result space for horizontal width							pushlong	PuTeTextPtr				;pass ptr to text string							pushword	PuTeStrLen				;pass length of text string							_TextWidth							;calc; now hor displacement on stack							pushword	#0						;no vertical displacement							_Move								;adjust pen position*Now restore previous environment and exit:							lda			#0						;normally no error statusPuTeExitErrorInACC			tax									;save error status for a sec							tsc									;deallocate our stack frame...							clc							adc			#DPSize							tcs							pld									;restore QD direct reg off stack							plb									;restore QD bank reg off stack							txa									;exit with error status in ACC/c...							cmp			#1							rtl*Variables to store values retrieved from QD direct page:PuTeDrawVerb				dc.w		0						;type of stringPuTeCharToDraw				dc.w		0						;character if string type is charPuTeTextPtr					dc.l		0						;where actual text from QD residesPuTeTextLength				dc.w		0						;length of text from QD*Info header packet written to spool before text data, in this order:PuTeInfoHeaderBeginPuTePenPos					dc.w		0,0						;pen position on pagePuTeStrLen					dc.w		0						;our calculated string lengthPuTeNativeFont				dc.b		0						;our mapped font typePuTeNativeSpacing			dc.b		0						;our mapped font sizePuTeNativeAttributes		dc.b		0						;our mapped font face							dc.b		0PuTeInfoHeaderEnd**DATA: Global static variables used by print loop routines that must be kept across driver calls:*PrintLoopErrorStatus		dc.w		0						;our global error statusPrintLoopMaskIsIWOne		dc.w		0						;bit 2 set if old IW I by PrinterOpenPrintLoopCheckedIsIWOne		dc.w		0						;set if we just did IWOne checkPrintLoopSetupLevel			dc.w		0						;err was: 0)usr;1)spool on;2)port onPrintLoopOldGrafPortPtr		dc.l		0						;user's grafport before OpenDocPrintLoopPrRecHdl			dc.l		0						;value of user's pr rec h at OpenDocPrintLoopUnusedPictHdl		dc.l		0						;unused handle from QD pict callsPrintLoopIsDraft			dc.w		0						;indicate print loop methodPrintLoopIsDraftVC			dc.w		0						;for draft, if vert cond selectedPrintLoopPageCounter		dc.w		0						;OpenPage/ClosePage counterPrintLoopNumActualPages		dc.w		0						;number of pages actually spooledPrintLoopInPageRange		dc.w		0						;are we really spooling a pagePrintLoopEndOfPageDetect	dc.w		0						;piccomment->getpic bottleprocs data**DATA: For use during, but not across, print loop routines:*PrintLoopRoutineData		ds.b		512						;used for text, color tables, etc.							endproc							end														