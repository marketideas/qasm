#***********************************************************************************#                                                                                  *#		Apple IIgs New ImageWriter Printer Driver                                  *#                                                                                  *#		File: makefile -- Compilation and linking script                           *#                                                                                  *#		Written by Ben Koning                                                      *#		Copyright (C) 1990 Apple Computer, Inc.                                    *#                                                                                  *#***********************************************************************************#Division of source files:#		equates			Header file with equates and direct page definitions#		entry			Entry vectors, environment setup/restore, routine dispatch#		metrics			Print record access and	printer dimension calculations#		dialog		 	PrStlDialog and PrJobDialog dialog box implementation#		dialogdata  	Dialog box layout and text#		spool	 		Routines to spool data to disk and/or memory#		printloop		High level interface from application to spooler and imager#		imager		 	Converting pixel map to escape codes for printer#		imagerdata 	 	Tables for computing RGB->CMY and density dither patternsEQU =	equates.aiiOBJ =	:obj:entry.aii.obj :obj:printloop.aii.obj :obj:metrics.aii.obj ¶		:obj:dialog.aii.obj :obj:dialogdata.aii.obj :obj:spool.aii.obj ¶		:obj:imager.aii.obj :obj:imagerdata.aii.objNAM =	ImageWriterPRN =	print -r -h -hs 12 -hf times -md -f courier -s 9PRINT Ä		{PRN} imagerdata.aii		{PRN} imager.aii		{PRN} spool.aii		{PRN} dialogdata.aii		{PRN} dialog.aii		{PRN} metrics.aii		{PRN} printloop.aii		{PRN} entry.aii		{PRN} equates.aii		{PRN} makefile		{PRN} README		{PRN} RELEASE.NOTES		files -l | {PRN}					CLEAN Ä		delete -i {OBJ}{NAM} Ä {EQU} {OBJ}		delete -i {NAM}		linkiigs -t $BB -at $0001 {OBJ} -o {NAM}	DEBUG Ä {EQU} {OBJ}		delete -i {NAM}		linkiigs -t $BB -at $0001 {OBJ} -o {NAM}		files -n -x b {NAM}		beep 2a,4,255		duplicateiigs -m -y {NAM} :	:obj:entry.aii.obj Ä {EQU} entry.aii		asmiigs	entry.aii -o :obj:entry.aii.obj:obj:printloop.aii.obj Ä {EQU} printloop.aii		asmiigs	printloop.aii -o :obj:printloop.aii.obj:obj:metrics.aii.obj Ä {EQU} metrics.aii		asmiigs	metrics.aii -o :obj:metrics.aii.obj:obj:dialog.aii.obj Ä {EQU} dialog.aii		asmiigs	dialog.aii -o :obj:dialog.aii.obj:obj:dialogdata.aii.obj Ä {EQU} dialogdata.aii		asmiigs dialogdata.aii -o :obj:dialogdata.aii.obj:obj:spool.aii.obj Ä {EQU} spool.aii		asmiigs	spool.aii -o :obj:spool.aii.obj:obj:imager.aii.obj Ä {EQU} imager.aii		asmiigs	imager.aii -o :obj:imager.aii.obj:obj:imagerdata.aii.obj Ä {EQU} imagerdata.aii		asmiigs	imagerdata.aii -o :obj:imagerdata.aii.obj