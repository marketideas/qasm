*******************************************************************************************                                                                                        **		Apple IIgs New ImageWriter Printer Driver                                        **                                                                                        **		File: imager.aii -- Low Level Driver: Pixmap > RGB->CMY > ESC Codes > Port       **                           All communication with printer port drivers is handled here  **                                                                                        **		Written by Ben Koning based on original design by Jason Harper                   **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.aii'																					include		'm16.util'							include		'm16.intmath'							include		'm16.event'							include		'm16.misctool'							include		'e16.quickdraw'ImagerProc					proc		export**********************************************************************************                                                                               **  ImageWriter I/II imaging routine for the Apple IIgs                          **                                                                               **  Written by Ben Koning                                                        **  Based on the design of the ImageWriter LQ imager by Jason Harper             **                                                                               **  On entry             16-bit full native mode                                 **                       D points to 1 page of Bank 0 for routine's use          **  |previous contents|  B is not assumed to point to any particular bank        **  |-----------------|                                                          **  |                 |                                                          **  |-   SrcLocPtr   -|  LONG: pointer to LocInfo record describing pixelmap     **  |                 |        or pointer to first char in string for text       **  |-----------------|                                                          **  |                 |  LONG: pointer to rectangle to be printed                **  |-  SrcRectPtr   -|        or coordinates for text:                          **  |                 |        +0: Rel Y, down only; +2: Abs X for print head    **  |-----------------|                                                          **  |                 |                                                          **  |-   CTablePtr   -|  LONG: pointer to color tables to be used                **  |                 |        or length of string for text                      **  |-----------------|                                                          **  |                 |  LONG: pointer to list of ScanlineControlBytes to use    **  |-  SCBListPtr   -|        for each line (1 byte each), must NOT be NIL!     **  |                 |        or bit vector giving text mode print options      **  |-----------------|                                                          **  |  CarriageWidth  |  WORD: rightmost pr limit; right margin for landscape    **  |-----------------|                                                          **  |   PaperLength   |  WORD: tallness of paper so formfeed works correctly     **  |-----------------|                                                          **  |   ActionBits    |  WORD: bit vector giving mechanical motion options       **  |-----------------|                                                          **  |   QualityBits   |  WORD: bit vector giving print method/density options    **  |-----------------|                                                          **  |                 |                                                          **  |-  IdleProcPtr  -|  LONG: pointer to idleproc to call or NIL for none       **  |                 |                                                          **  |-----------------|                                                          **  |  RTL3  |  RTL2  |                                                          **  |--------+--------'                                                          **  |  RTL1  |                                                                   **  '--------' <- SP                                                             **                                                                               **  On exit              A norm 0, nonzero if exit status/Option-Period press    **                       Carry set if nonzero A (see above)                      **                       X,Y trashed                                             **                       D unchanged                                             **  |previous contents|  B restored to original value                            **  |-----------------|                                                          **  |  RTL3  |  RTL2  |                                                          **  |--------+--------'                                                          **  |  RTL1  |                                                                   **  '--------' <- SP                                                             **                                                                               **  The static variable PrError is an exported global; setting it to a non-zero  **  value (from inside an idleproc) will cause the imager to abort.              **                                                                               **  Definition of ActionBits (setting to all zero causes default action):        **                                                                               **    Bit 0:  0=Output form feed (FF) when finished; 1=Don't do form feed        **    Bit 1:  0=Init/calibrate head, set paper len/TOF, calc color tbl; 1=Don't  **    Bit 2:  0=Normal, 1=Try to avoid using IW-II-specific commands             **    Bit 3:  Unused                                                             **    Bit 4:  Unused                                                             **    Bit 5:  0=Do imaging (graphics/text); 1=Don't (only init)                  **    Bit 6:  0=Print graphics; 1=Move paper/head and print text string          **            If Bit 6 set, set SrcLocPtr to address of string                   **            If Bit 6 set, set CTablePtr to length of string                    **            If Bit 6 set, set SrcRectPtr+0 delta_Y (down only); +2 to abs_X    **            If Bit 6 set, set SCBListPtr+0 to text font 0..3                   **                 0=NLQ, 1=draft, 2=NLQ, 3=LQ                                   **            If Bit 6 set, set SCBListPtr+1 to text size 0..7                   **                 0=9, 1=10, 2=12, 3=13.4, 4=15, 5=17 cpi, 6=prop1, 7=prop2     **	         If Bit 6 set, set SCBListPtr+2 to text style 0..2                  **	              Bit 0=bold; Bit 1=underline; Bit 2=double-w; Bit 3=half-h     **    Bit 7:  0=Normal; 1=Ask printer to identify itself (+ exit immediately)    **            If Bit 7 set, on exit ACC bit 0 set if device is ImageWriterI/II   **            If Bit 7 set, on exit ACC bit 1 set if device has color ribbon     **            If Bit 7 set, on exit ACC bit 2 set if device has sheet feeder     **            If Bit 7 set, on exit ACC bit 3 set if device is ImageWriter I     **    Bit 8:  0=Open port connection before sending (PrDevOpen); 1=Don't         **    Bit 9:  0=Close port connection after sending (PrDevClose); 1=Don't        **                                                                               **  Definition of QualityBits (equivalent to wDev field in print record):        **                                                                               **    Bit 0:  "Better".  If set, print at 1/2 size using double resolution       **    Bit 1:  0=Portrait orientation; 1=Landscape orientation                    **    Bit 2:  "Condensed".  If set, print 1/2 vertical size                      **    Bit 3:  0=Normal; 1=50% horizonal & vertical reduction                     **    Bit 7:  0=Vertical gap at end of sheet; 1=No gap between sheets            **    Bit 13: 0=Normal 1=Don't set boldface+unidirectional (faster)              **    Bit 14: 0=Do 160hdpi halftone (even if not Better); 1=80hdpi (faster)      **    Bit 15: 0=Grayscale (colors mapped); 1=Color (BCMY process)                **                                                                               **  Definition of exit error code in accumulator:                                **                                                                               **    $0080:  User typed command-period (this err has precedence over others)    **    $008X:  Status err (only works over network) (in certain precedence):      **            $81: Network error  $82: No paper    $83: Paper jam                **            $84: Cover open     $85: Select off  $8F: Printer busy (in use)    **    $000X:  If ActionBits set for self-id, result code (see above)             **                                                                               **  The "Better" bit causes everything to be printed at 1/2 size: the            **  higher-level routines should generate the bitmap at 2x (full size) or        **  1x (50% reduction) magnification to produce a properly sized image.          **                                                                               **  Boldface and unidirectional printing modes are set by default.  If the       **  don't-set-boldface-unidirectional bit is set, however, this won't be done,   **  resulting in speed improvement at the expense of density and registration.   **  Also, boldface (but not unidirect) is internally disabled for modes that     **  require interlaced printing, because interlacing results in darker output.   **                                                                               **  All halftone dither density patterns are printed at 160 horizontal dpi,      **  unless the use-80-dpi-patterns bit is set.  The latter case is faster but    **  results in rather ugly and macroscopic density patterns.                     **                                                                               **  CarriageWidth must be given in units of 160 (port) or 144 (land) horiz dpi;  **  PaperLength should be passed in units of 72 vertical pixels per inch.  The   **  X and Y displacements for printing text strings should be passed in terms    **  of 80 pix/inch horizontal and 72 pix/inch vertical (which coincides with     **  the effective resolution with the Better bit off).                           **                                                                               **  If something other than NIL is passed for IdleProcPtr, that location will    **  be JSL-ed to with our environment saved.  The Command-Period printing        **  interrupt request from the user is checked for even if an IdleProcPtr is     **  given.  (Command-Period causes the imager to abort and return $80 status)    **  An idleproc may set the global PrError to be non-zero to abort the imager.   **                                                                               **  Notes on terminology: In these routines, "band" refers to one scan of the    **  print head.  Do not confuse this with the printing bands into which the      **  high-level driver print loop routines split up each page due to possible     **  memory constraints.  Also, note the distinctions made in the comments        **  between "screen" and "printer" pixels.  "Screen" pixels are the input to     **  the imager (and are in fact usually in an off-screen buffer), and "printer"  **  pixels are the dots which are sent to the printer device.                    **                                                                               **  For modes that require 144 dpi vertical print head resolution, a vertical    **  interlace technique is employed: even vertical dots are printed, the paper   **  is advanced 1/144", and then odd vertical dots are printed.                  **                                                                               **  In portrait mode, a 16-bit-wise white scanning algorithm is employed to      **  improve speed performance.  It is enabled only if a color table entry that   **  is pure white is found.  This algorithm quickly recognizes large areas of    **  white even in between nonwhite areas and saves time by not processing those  **  areas.  A similar but more restricted algorithm exists in landscape mode:    **  the pure-white color table entry must be in a standard location, and any     **  particular column must have the same 320/640 mode bit value.                 **                                                                               **  In portrait/640/hscaling=1 mode only, a special-case imaging algorithm is    **  employed to improve speed performance.  It is enabled only if pure black     **  and pure white colors exist in their standard color table entries.   Like    **  the portrait mode white scanning algorithm, this shortcut is also able to    **  operate on parts of a line.                                                  **                                                                               **  Just before the printer-ready graphics data is output, it is analyzed and    **  broken up into sequences of print-discrete-data, print-repeating-data, and   **  position-print-head packets, so as to send less data to the printer and      **  to improve speed performance.                                                **                                                                               **  Just before any output data/commands are sent back to the print manager en   **  route to a port driver, it is buffered and thus subjected to maximum and     **  minimum flow quanta.                                                         **                                                                               **  To improve disk/memory space efficiency, the RGB to KCMY conversion table    **  is built at runtime, on an as-needed basis based on the number of color      **  tables "needed" by the given SCBs.                                           **                                                                               **  In general, the imager should always be called in an Open/Init/print/Close   **  sequence (as given by ActionBits commands).  This is so that various         **  resources, such as memory for tables, unique network connections, etc, are   **  deallocated properly.                                                        **                                                                               ************************************************************************************Direct-page usage:*IdleProcPtr		equ		ImagerDP+4					;long	;input parameter storageQualBits   		equ 	ImagerDP+8					;wordActionBits 		equ 	ImagerDP+10					;wordPaperLength		equ		ImagerDP+12					;wordCarriageWidth	equ		ImagerDP+14					;wordSCBListPtr 		equ 	ImagerDP+16					;longCTablePtr  		equ 	ImagerDP+20					;longSrcRectPtr 		equ 	ImagerDP+24					;longSrcLocPtr  		equ 	ImagerDP+28					;longSizeInputs      equ 	(ImagerDP+32)-IdleProcPtrPixMapBase		equ		ImagerDP+32					;long	;addr of pixelmap to printPixMapHigh		equ		ImagerDP+36					;word	;height/pixelsPixMapWide		equ		ImagerDP+38					;word	;width/640 mode pixelsPixMapLeft		equ		ImagerDP+40					;word	;pixels to skip at left edgeleftskip		equ		ImagerDP+42					;word	;counter for PixMapLeftSCBTabBase		equ		ImagerDP+44					;word	;offset from SCBListPtr for pixelmapMasterMode		equ		ImagerDP+46					;word	;mode ($00/$80) from SrcLocInfoMasterPal		equ		ImagerDP+48					;word	;palette ($0..$F) from SrcLocInfoLineDirty		equ		ImagerDP+50					;word	;linebuffer contains non-0 valueslineoffset		equ		ImagerDP+52					;word	;offset into linebufferpixelbits		equ		ImagerDP+54					;word	;linebuffer bit mask for curr. pixelThisLMode		equ		ImagerDP+56					;word	;mode ($00/$80) for this lineThisLPal		equ		ImagerDP+58					;word	;palette ($0..$F) for this linehorpcount		equ		ImagerDP+60					;word	;horizontal pixel countDitherH			equ		ImagerDP+62					;word	;horizontal dither matrix indexcolorstr		equ		ImagerDP+64					;word	;word_ptr to setup string for this bandlinebase		equ		ImagerDP+66					;word	;starting offset into linebuffercolortemp		equ		ImagerDP+68					;long	;multipurpose temp for RGB->KCMY convert**Equates defining QualityBits:*;					 5432109876543210qbColor			equ %1000000000000000qbRoughPatt		equ %0100000000000000qbNoUniBo		equ %0010000000000000qbNoGap			equ %0000000010000000qbReduct		equ %0000000000001000qbCndnsd		equ %0000000000000100qbLandMode		equ %0000000000000010qbBetter		equ %0000000000000001;					 5432109876543210**Equates defining ActionBits:*;					 5432109876543210abNoFeed		equ %0000000000000001abNoInit		equ %0000000000000010abIsIWOne		equ %0000000000000100abDoImage		equ %0000000000100000abTextMode		equ %0000000001000000abGetID			equ %0000000010000000abNoOpen		equ %0000000100000000abNoClose		equ %0000001000000000;					 5432109876543210*********************************************************************************IMAGER: Main entry point; copies stack params and calls startup/main/shutdown and returns:*				export Imager		   Imager:				phb							;save orig B				pea $0000					;set B to bank 0 to access stack				plb				plb				tsc							;copy params into D locations				tay				ldx #0copyparms				lda |5,y				sta IdleProcPtr,x				iny				iny				inx				inx				cpx #SizeInputs				blt copyparms				phk							;set B to program bank				plb		   				stz prError					;clear error status before starting				stz wrbuff_enable			;clear output cache enable before starting		   					jsr IWStartUp				;do open/self-id/printer setup/etc				jsr StartWrBuff				;begin caching output				jsr IWPrPixmapOrText		;do either text or graphics, causes much output				jsr FinishWrBuff			;terminate output caching				jsr IWShutDown				;do etc/reset options/formfeed/close				ldx prError					;we'll return this on exit				plb							;restore orig B				lda 1,s				sta SizeInputs+1,s				lda 2,s				sta SizeInputs+2,s				clc				tsc				adc #SizeInputs				tcs				txa							;set ACC and carry if user-abort or error				cmp #1				rtl*********************************************************************************WRITESHORT/WRITELONG/STARTWRBUFF/FINISHWRBUFF:**These are routines to manage printer driver output to the currently selected port driver.*WRITESHORT should be used for short command strings whose length is guaranteed to be below the*flow quantum size; WRITELONG should be used for potentially much larger amounts of data.*Surrounding WRITESHORT and WRITELONG calls with STARTWRBUFF and FINISHWRBUFF will cause the*output to be buffered, thus improving performance, especially with network port drivers,*especially when there are many short paper motion commands, as with interlaced printing.**Two constants are used.  In no case will a WRITELONG call result to more than*"OutputFlowQuantumMax" number of bytes be sent (it will be broken up into chunks); and, if*buffering is enabled, an attempt is made to avoid sending less than "OutputFlowQuantumMin"*number of bytes.  "OutputFlowQuantumMax" must be greater than "OutputFlowQuantumMin".***WRITESHORT: Outputs short string to printer; 16-bit address of pascal-type string -> ACC:*writeshort		tax 				inc a				sta ws_addr+0				;low byte of address				phb				phb 				pla  				and #$00FF 				sta ws_addr+2  				;high byte of address = PBR				lda |0,x      				;get string length				and #$00FF				tax							;now ws_addr & X valid with address and length								lda wrbuff_enable			;check if buffering is enabled				beq ws_write				;if not, proceed to the main write routine				ws_bwrite		txa							;BUFFERED WRITE: Enter w/ ws_addr & X (X must be < buff)				clc							;add buff ptr to request count				adc wrbuff_cptr				cmp #OutputFlowQuantumMin	;check if it would overflow the buffer				bcs ws_bw_flush				;branch if that is the case				sta wrbuff_cptr				;else, update ptr to next unused byte,				dea				tay							;Y now has last-byte-to-add-to-cache				txa							;get write-request length				clc				adc ws_addr+0				;turn it into a 16-bit address to the data				dea				tax							;X now has 16-bit ptr to last byte in caller's string				shortm						;now copy the data from ws_addr address to cachews_bcpy_loop	phk				lda ws_addr+2				pha				plb				lda |0,x				plb				sta wrbuff_cache,y				dey							;dec ptr to caller's data				dex							;dec ptr to our buffer				cpx ws_addr+0				;until we're right at beginning of caller's string				bcs ws_bcpy_loop			;copy back to and including 1st char of caller's string				longm				rts							;exit without having done actual write				ws_bw_flush		phx							;write request would overflow, so flush cache first				lda ws_addr+0				;save X and ws_addr address				pha				lda ws_addr+2				pha				jsr ws_flush				;flush contents of cache				pla							;restore X and ws_addr				sta ws_addr+2				pla				sta ws_addr+0				plx				bra ws_bwrite				;now put write request contents into the cache				ws_flush		lda #wrbuff_cache			;FLUSH SUBR: Flushes entire cache contents				sta ws_addr+0				lda #^wrbuff_cache				sta ws_addr+2				;put address of cache in ws_addr				ldx wrbuff_cptr				;put length of data in cache in X				stz wrbuff_cptr				;reset cache ptr back to beginning, drop into real writews_write		cpx #0						;REAL WRITE: Enter w/ ws_addr & X. Clr compl/err flag				beq ws_exit				stz ws_done					;clear completion flag				pushlong #ws_cmpl			;completion routine to be called when write is done				pushlong ws_addr			;address				phx							;length still in X				ldx #$1E13					;this call will return immediately				jsl $E10000					;_PrDevWrite				bcc ws_wait					;check if no error on immediate return				cmp #$08FF					;make sure we don't count PAP buffer busy as an error				beq ws_waitws_goterr		lda #$0081					;if error, set global flag and exit 				sta prError				jsr IdleProcAbortErrCheck	;try to find out a specific err other than $81  				rtsws_wait			lda ws_done					;wait until done or error 				beq ws_wait				bmi ws_goterrws_exit			rtsws_addr			ds.l 1ws_done			ds.w 1ws_cmpl			ldx #1						;here so we're done.  if no err, done_flag gets set  				cmp #0						;check ACC for error code				beq ws_cmpl1				lda >is_network				;if not on network, done_flag also always gets set				beq ws_cmpl1				ldx #$FFFF					;if err and on network, done_flag gets $FFFFws_cmpl1		txa							;store error code...    			sta >ws_donews_cmpl2		rtl**WRITELONG: Outputs long blocks of data to printer; Ptr.LO -> ACC, Ptr.HI -> X, Count -> Y:*writelong		sta wl_adr+0				;use params to init our running pointers				stx wl_adr+2				;this routine will output long data in pieces				sty wl_len								lda wrbuff_enable			;check if we can buffer this data				beq wl_nobuff				;buff must be enabled and this must be a short request				cpy #OutputFlowQuantumMin-5				bcc wl_yesbuff				wl_cantbuff		jsr ws_flush				;else: buffering on but request too large: flush and				bra wl_nobuff				;then output the data without buffering											wl_yesbuff		tyx							;doing buffered write: setting up X with length and				lda wl_adr+0				;ws_addr with address of write-request				sta ws_addr+0				lda wl_adr+2				sta ws_addr+2				brl ws_bwritewl_nobuffwl_donext		lda wl_len					;if total data is now less than a piece do last chunk				cmp #OutputFlowQuantumMax+1				bcc wl_dolast		   				lda wl_adr					;else, write one chunk at a time...				sta ws_addr					;set up ws_addr and X and go output a chunk				lda wl_adr+2				sta ws_addr+2				ldx #OutputFlowQuantumMax				jsr ws_write		   				clc							;...and advance pointer and decrease length...				lda wl_adr				adc #OutputFlowQuantumMax	;our_address.L += PortDrvrFlowQuantum.W				sta wl_adr				lda wl_adr+2				adc #0				sta wl_adr+2				sec				lda wl_len				sbc #OutputFlowQuantumMax	;our_length.W -= PortDrvrFlowQuantum.W				sta wl_len				bra wl_donext				;...and go send next chunk		   wl_dolast		lda wl_adr					;set up ws_addr and X and go output last chunk and exit 				sta ws_addr				lda wl_adr+2				sta ws_addr+2				ldx wl_len				brl ws_write		   		   wl_adr			ds.l 1						;running pointer to data to be sent for a chunkwl_len			ds.w 1						;running decreasing count of data left to be sent**STARTWRBUFF: Begins buffering of output.  Call before many successive WRITELONG/WRITESHORT calls:*startwrbuff		lda #1						;set flag so the write routines can act accordingly				sta wrbuff_enable				stz wrbuff_cptr				;init the ptr, points to next byte				rts				**FINISHWRBUFF: Terminates buffering and flushes.  Must be called to balance STARTWRBUFF:*finishwrbuff	jsr ws_flush				;flush the cache				stz wrbuff_enable			;clear flag so write routines will work normally again				rtswrbuff_enable	dc.w 0						;buffering-enable flagwrbuff_cptr		dc.w 0						;cache pointer, points to next available bytewrbuff_cache	ds.b OutputFlowQuantumMin	;small hardcoded cache, less than maximum flow quantum*********************************************************************************IWSTARTUP: Gets unique connection, does ID request, resets printer, sets paper length, inits tables:*IWStartUp:						lda #0				pha							;always see if we are on a networked port device, because				pha							;we'll need to know whether we can do asyncronous I/O				ldx #$2B13					;_PMGetNetworkName				jsl $E10000				pla				sta is_network				pla				ora is_network				sta is_network				;anyone in the imager may now check is_network				beq iws_not_netid			;if on network and servicing self-id request, go				lda ActionBits				;to the id-on-network section below, since it is not				and #abGetID				;necessary to open a connection in this case				beq iws_not_netid				do_id_network	stz status_buff+5			;begin of code to obtain self-id if on network				pushlong #status_buff		;we can do self-id without having to open connection				ldx #$2013					;do status inquiry to port driver				jsl $E10000					;_PrDevStatus				lda status_buff+5			;status buff was cleared above in case not supported				tax				;     5432109876543210				ldy #%0000000000000001		;clr bits, and we already know: it's IW + it's not IW_Ido_id_net_0		and #%0000000010000000		;status bit 7 indicates color capability				beq do_id_net_1				tya				;     5432109876543210				ora #%0000000000000010		;indicate color by setting bit 1 in result				taydo_id_net_1		txa				;     5432109876543210				and #%0000000001000000		;status bit 6 indicates sheet feeder presence				beq do_id_net_done				tya				;     5432109876543210				ora #%0000000000000100		;indicate sheet feeder by setting bit 2 in result				taydo_id_net_done	sty PrError					;store result				rts				iws_not_netid				lda ActionBits				;see if execution of open request is desired				and #abNoOpen				bne dont_open		   				jsr IdleProcAbortErrCheck	;check if port driver connection request has any chance				lda prError					;and also allow user to hit command-period...				beq do_open					;abort on cmd-".", DevStatus err, status result buff errabort_open		rtsdo_open			pushlong #0					;request connection from port driver -- hog printer				pushlong #0				ldx #$1C13				jsl $E10000					;_PrDevOpen				lda #1						;set flag indicating that we have an exclusive connection				sta is_our_conn		   dont_open		lda ActionBits				;see if printer/feature identification is desired				and #abGetID				;for the direct-connect case				bne do_id_notnet				brl dont_id		   				do_id_notnet	ldy #6						;begin of code to obtain self-id if not on network				lda #0						;zero out the receive buffer before startingid_clear		sta r_idstring,y				dey				dey				bpl id_clear		   	req_id			lda #s_selfid				;send self-id request				jsr writeshort				;IW II response will be: [garbage_chr] IW10 [C] [F] <cr>								pha							;do sync read (we're not on network)				pushlong #r_idstring				pushword #8				ldx #$1D13				jsl $E10000					;_PrDevRead				pullword r_idlengthana_id			stz PrError					;zero all result output bits before starting				lda r_idlength				;if zero characters were returned from the read,				bne ana_id_go				;assume it's an ImageWriter I with no color/no feeder				;     5432109876543210				lda #%0000000000001001				sta PrError				lda ActionBits				;set this so we don't issue ill commands on the way out				ora #abIsIWOne				sta ActionBits				rtsana_id_go		ldy #0						;we did get some ID chars; init index into string				lda r_idstring,y 			;look at first 2 bytes of string (16-bit LDA) ("IW")				cmp #'I'+('W'*256)				beq id_match				;matches first try; don't adjust Y index, continue				iny							;will try rest of matching offset by one				lda r_idstring,y			;look for those two chars (16-bit LDA) ("IW") AGAIN!				cmp #'I'+('W'*256)				bne id_done					;string is not "IW10____" nor is it "_IW10____"; rejectid_match		lda r_idstring+2,y			;look at next two characters of string ("10")				cmp #'1'+('0'*256)				bne id_done				;     5432109876543210				lda #%0000000000000001		;indicate that it's at least a 10"-carriage IW_II				sta PrError				iny							;now search thru string and set other bits until end...				iny							;set index to next character after "IW10"				iny				inynew_id_chr		cpy r_idlength				;go until end of number of chars we got as id result				bcs id_done				shortm						;get a character out of the id string				lda r_idstring,y				longm				tax				cpx #'F'					;sheet feeder?				bne not_feeder				lda PrError					;indicate sheet feeder				;     5432109876543210				ora #%0000000000000100				sta PrError				bra nxt_id_chrnot_feeder		cpx #'C'					;color ribbon?				bne nxt_id_chr				lda PrError					;indicate color ribbon				ora #%0000000000000010				sta PrErrornxt_id_chr		iny				bra new_id_chrid_done			rtsdont_id			lda ActionBits				;init printer mechanics/recalibrate head, if desired				and #abNoInit				bne init_dont								lda #s_reset				;reset printer (head recalibration and default options)				jsr writeshort										lda ActionBits				;prepare to set v paper length (not supported for IW I)				and #abIsIWOne				bne setpaplen_dont				lda PaperLength				;set vert paper len to PaperLength param (given in 72ths)				asl a				pha				pushlong #n_paperlen				pushword #4				pushword #0				_Int2Dec				lda #s_paperlen				jsr writeshort				;do paper length command in 144thssetpaplen_dontinit_dont				stz prError					;clear any err status now before doing any print output				rtss_reset			dc.b	6					;reset printer to defaults and set american language				dc.b	$1B,$63				dc.b	$1B,$5A,$07,$00			s_paperlen		dc.b	6					;set vertical paper length for formfeed operation				dc.b	$1B,$48n_paperlen		dc.b	'0000'				;units are XXXX/144 inchs_selfid		dc.b	2	  				;request ID string				dc.b	$1B,$3F			is_our_conn		dc.w	0					;static do-we-have-exclusive-connection-to-printer flagis_network		dc.w	0					;on-network/not-on-network statusr_idlength		dc.w	0					;length of returned ID stringr_idstring		ds.b	8					;storage for returned ID string; 8 characters max*********************************************************************************IWSHUTDOWN: Closes unique connection to printer after doing formfeed, etc:*IWShutDown:				lda ActionBits				;do form feed, if desired				and #abNoFeed+abGetID		;don't do if not requested or if doing self-id				bne dont_feed				lda #s_formfeed				jsr writeshortdont_feed				lda ActionBits				;close port connection and reset printer, if desired				and #abNoClose				bne dont_close												lda is_our_conn				;close connection with printer only if we opened it				beq dont_close				ldx #$1F13				jsl $E10000					;_PrDevClose				stz is_our_conn				;clear our flag indicating exclusive connection statusdont_close				rtss_formfeed		dc.b	1					;form feed				dc.b	$0C*********************************************************************************IWMODESET: Sets up printer modes and scaling settings in response to desired output format:*IWModeSet:ms_adj640color	lda QualBits				;if color and 640 and not Better, use rough patterns				bpl ms_notcb640				and #qbBetter				bne ms_notcb640				ldy #oportSCB				;get mode info from SrcLoc to see if 640				lda [SrcLocPtr],y				and #$0080				beq ms_notcb640				lda #qbRoughPatt			;assert the bit inside the QualityBits word				ora QualBits				sta QualBitsms_notcb640				lda CarriageWidth			;get crWidth from input parameter				sta crWidth								lda QualBits                ;get scalings according to QualityBits from lookup table				and #%1111					;use low 4 bits: b0=bett, b1=land, b2=vcond, b3=reduct				tax				ms_setVscale	lda vscaletbl,x				;get # of vertical printer dots to produce for each pix				and #$00FF					;get a byte, not word from one of these byte-wise tables				sta vScaling				ms_setVintlace	lda vintertbl,x				;get yes/no if to do vertical 2x resolution interlace				and #$00FF				sta vInterlace				ms_setHscale	lda hscaletbl,x				;get # of hor printer dots to produce for each pix				and #$00FF				sta hScaling				ms_setHpitch	lda QualBits				;check if rough 80hdpi patters desired				and #qbRoughPatt			;if not, go on and use hscale table entries as-is				beq ms_is160				;else, if (hdpi==160 AND hscale>1) then we can do				lda hScaling				;80 hdpi and hScaling/=2 instead for speed but bad patt				lsr a				beq ms_is160ms_is80			sta hScaling				lsr crWidth					;80 hdpi: set pr mode and also do crWidth /= 2 because				lda #s_iw_80dpi				;it's always given in better-resolution-units				bra ms_dosetpitchms_is160		lda #s_iw_160dpi			;160 hdpi: set printer modems_dosetpitch	jsr writeshortms_setBoldUni	lda QualBits				;select pr head scan unidirect/bidirect and bold/no bold				and #qbNoUniBo				;set normal uni+bold unless the do-faster bit is set				beq ms_ubyesms_ubno			lda #s_unibo_no				bra ms_ubselms_ubyes		lda #s_unibo_yesms_ubsel		jsr writeshort				lda vInterlace				;if interlace is enabled, force no boldface; the vertical				beq ms_boldok				;space will be sufficiently close to make the result dark				lda #s_bold_no				jsr writeshortms_boldok				rtss_iw_80dpi		dc.b	2					;"Pica" -- 80 horizontal dpi for graphics				dc.b	$1B,$4E			s_iw_160dpi		dc.b	2					;"Elite Proportional" -- 160 horizontal dpi for graphics				dc.b	$1B,$50			s_unibo_yes		dc.b	4					;unidirectional + boldface				dc.b	$1B,$3E				dc.b	$1B,$21s_unibo_no		dc.b	4					;bidirectional + no boldface				dc.b	$1B,$3C				dc.b	$1B,$22s_bold_no		dc.b	2					;no boldface				dc.b	$1B,$22vscaletbl								;v pr pix per 640 mode scrn pix indexed by low 4 QualityBits* Better ------>	   x   x   x   x	;bit 0 (1=better resolution)* Landscape --->	     x x     x x	;bit 1 (1=landscape orientation)	;table entries are* Condensed ---> 	         x x x x	;bit 2 (1=vertical 50% condensed)	;the number of printer			dc.b	 2,1,1,1,1,1,1,1	;bit 3 cleared (full size)			;pixels vertically			dc.b	 1,1,1,1,1,1,1,1	;bit 3 set (half size)vintertbl								;vertical interlace enable indexed by low 4 QualityBits* Better ------>	   x   x   x   x	;bit 0 (1=better resolution)* Landscape --->	     x x     x x	;bit 1 (1=landscape orientation)	;table entries are* Condensed --->	         x x x x	;bit 2 (1=vertical 50% condensed)	;vertical 2x interlace:			dc.b	 0,0,0,1,0,1,0,1	;bit 3 cleared (full size)			;0=disable, 1=enable			dc.b	 0,0,1,1,1,1,1,1	;bit 3 set (half size)hscaletbl								;h pr pix per 640 mode scrn pix indexed by low 4 QualityBits* Better ------>	   x   x   x   x	;bit 0 (1=better resolution)* Landscape --->	     x x     x x	;bit 1 (1=landscape orientation)	;table entries are* Condensed --->	         x x x x	;bit 2 (1=vertical 50% condensed)	;the number of printer			dc.b	 2,1,4,2,2,1,2,1	;bit 3 cleared (full size)			;pixels horizontally			dc.b	 1,1,2,2,1,1,1,1	;bit 3 set (half size)			*******************************************************************************IWAddrCalc:				ldy #oportSCB				;get mode info from SrcLoc				lda [SrcLocPtr],y				and #$0080				sta MasterMode				lda [SrcLocPtr],y				and #$000F				sta MasterPal								ldy #optrToPixImage			;get pixmap address from SrcLoc				lda [SrcLocPtr],y				sta PixMapBase				iny				iny				lda [SrcLocPtr],y				sta PixMapBase+2								sec							;get offset from top to start printing				ldy #0						;top				lda [SrcRectPtr],y				ldy #oboundsRect+0				sbc [SrcLocPtr],y				bpl gotvskip				lda #0gotvskip		 							;adjust pixmap addr to top print line				sta SCBTabBase				pha				pha				PHA				ldy #owidth				lda [SrcLocPtr],y				pha				_Multiply				clc				pla				adc PixMapBase+0				sta PixMapBase+0				pla				adc PixMapBase+2				sta PixMapBase+2				sec                          ;calculate height of print area				ldy #4				lda [SrcRectPtr],y				ldy #0				sbc [SrcRectPtr],y				sta PixMapHigh				sec				ldy #oboundsRect+4				lda [SrcLocPtr],y				ldy #oboundsRect+0				sbc [SrcLocPtr],y				sec				ldy #0				sbc [SrcRectPtr],y				cmp PixMapHigh				bge clipatbot				sta PixMapHighclipatbot		 					sec                          ;get offset from left edge to print				ldy #2                       ;left				lda [SrcRectPtr],y				ldy #oboundsRect+2				sbc [SrcLocPtr],y				bpl gothskip				lda #0gothskip									;adjust pixmap addr to left edge...				ldx MasterMode				;accurate to 1 byte (max 3 pixels off)				bne gothskip1				asl agothskip1 				tax				and #$03				sta PixMapLeft				txa				lsr a				lsr a				clc				adc PixMapBase+0				sta PixMapBase+0				lda PixMapBase+2				adc #0				sta PixMapBase+2								sec                          ;calculate width of print area				ldy #6				lda [SrcRectPtr],y				ldy #2				sbc [SrcRectPtr],y				sta PixMapWide				sec				ldy #oboundsRect+6				lda [SrcLocPtr],y				ldy #oboundsRect+2				sbc [SrcLocPtr],y				sec				ldy #2				sbc [SrcRectPtr],y				cmp PixMapWide				bge clipright				sta PixMapWideclipright 				ldx MasterMode				;double if 320 because 2 prpix/scrnpix done below if 320				bne gotwide				asl PixMapWidegotwide 				rts*********************************************************************************CLEARLINE: Zeroes the printer-ready-pixel linebuffer if dirty flag set:*ClearLine:				lda LineDirty				;don't bother to clear the line...				bne cl_go					;unless there's already some data in it				rts				cl_go			ldx #(LineBufferEnd-LineBuffer)-2	;linebuffer length must be even!				lda #0cl_loop			sta LineBuffer,x				dex				dex				bpl cl_loop				stz LineDirty				;after clearing reset dirty flag				rts**********************************************************************************FILLRGBTOKCMY: Fills-in only those color convert tables that are needed by the given SCB list.**There are 16 color conversion tables; only those which are referenced by an SCB in the given*SCB list are made valid by this routine.  Table entries are of the form $KCMY with 4-bit nibbles*for each color, and should be indexed by (SCB# 0..15) * 32 + (pixel 0..15) * 2.**Entries are calculated as follows: C=15-R; M=15-G; Y=15-B; K=min(C,M,Y); C=C-K; M=M-K; Y=Y-K;*and finally M=M*(1-(C/g)).  The last step compensates for incorrect cyan ribbon color.*FILLRGBTOKCMY:				ldy #0						;zero all 16 is-valid-conversion-table flags				tya							;these flags will be used during the upcoming				shortm						;conversion-table-fill loop to see if a coloricmy_zloop		sta KCMY_valid,y			;table has alreay been computed				iny				cpy #15+1				bne icmy_zloop				longm				ldy PixMapHigh				;prepare for outer loop for all SCB values given by user				lda QualBits				;find out how tall (how many entries long) the list is				and #qbBetter				;infer SCB list size from tallness of pixmap				beq icmy_nothalfscb			;and scale tallness down (/2) if Better+100% modes				lda QualBits				;to compensate for scaled-up pixmap				and #qbReduct				bne icmy_nothalfscb				tya				lsr a				tayicmy_nothalfscb*icmy_DoAllSCBs								;do outer loop for all SCB's given by user				phy							;Y has SCB # index that we're doing, save for looping				lda [SCBListPtr],y			;obtain an SCB value				and #$000F					;only get color table select part of the SCB *byte*				tay							;Y now has # of one of the tables that will be needed				lda KCMY_valid,y			;have we already computed entries for this table?				and #$00FF					;(the KCMY-valid table is a table of bytes)				bne icmy_next1scb			;yes, we already did this table, so go on								lda #1						;else: we didn't compute this table yet, so mark it				shortm						;as computed and drop into the compute code below				sta KCMY_valid,y			;Y still has the table #				longm								tya							;ready to compute: construct start adrs of RGB colr tbl				asl a						;each table is 32 bytes long, so do table # * 32				asl a						;this computed start address will point to the beginning				asl a						;of the current color table that we're converting, and				asl a						;is valid for both the user's list of (RGB) tables and				asl a						;our in-progress list of (KCMY) tables				sta icmy_ctblbase***				lda #30						;compute KCMY entries for all 16 RGB words in this tableicmy_fill1tbl	pha							;save loop counter/index within this table				clc							;add to base address of this SCB's table				adc icmy_ctblbase				tay				phy							;save base address+color entry index of this SCB's table				lda [CTablePtr],y			;access user's RGB value within user's table				jsr icmy_ConvertOne			;convert $0RGB nibbles in A to $KCMY nibbles in A				ply							;restore saved base address+color entry index				sta KCMY_lookup,y			;use it to store KCMY into our parallel table				pla							;restore loop counter/index				dea							;going backwards from end to beginning				dea				bpl icmy_fill1tbl***				icmy_next1scb	ply							;bottom of loop for all SCBs, restore SCB # index				dey							;we're going backwards up to and including 0				cpy #$FFFF					;exit back to caller when done				bne icmy_DoAllSCBs				rts				icmy_ConvertOne:							;subr to calc KCMY from RGB nibbles (input/output in ACC)				eor #$0FFF					;subtract R,G,B values from 15 each in place											;$0RGB   ->   $ [0] [$F-R] [$F-G] [$F-B]				tax				and #$000F					;normalize values in the nibbles into static vars				sta icmy_valueY				;so we can do manipulations on them				txa				lsr a				lsr a				lsr a				lsr a				and #$000F				sta icmy_valueM				txa				xba				and #$000F				sta icmy_valueC								lda icmy_valueC				;do K = min (C,M,Y)				sta icmy_valueKicmy_min1		cmp icmy_valueM				bcc icmy_min2				lda icmy_valueM				sta icmy_valueKicmy_min2		cmp icmy_valueY				bcc icmy_min3				lda icmy_valueY				sta icmy_valueKicmy_min3				sec							;subtract K value from each of C,M,Y values				lda icmy_valueC				sbc icmy_valueK				sta icmy_valueC				sec				lda icmy_valueM				sbc icmy_valueK				sta icmy_valueM				sec				lda icmy_valueY				sbc icmy_valueK				sta icmy_valueYicmy_g			equ 20						;M density reduction factor: bigger =>> more magenta				lda #icmy_g					;do fudge factor to M				sec							;M = M * (1 - (C/g)), done as gM=M(g-C) in int math				sbc icmy_valueC				;this has the effect of reducing the value for M by				pha							;0..(15/g)*100% for C values of 0..100%				pha				pha				pushword icmy_valueM				_Multiply				pla				plx				phx				phx				pha				pushword #icmy_g				_UDivide				pla				plx				sta icmy_valueM								lda icmy_valueM				;assemble nibble values into $KCMY word				asl a				asl a				asl a				asl a				ora icmy_valueY				sta colortemp				lda icmy_valueC				xba				ora colortemp				sta colortemp				lda icmy_valueK				xba				asl a				asl a				asl a				asl a				ora colortemp								rts							;exit this subroutine with $KCMY-word in ACC								icmy_valueK		dc.w 0						;normalized value for black print intensity 0..15icmy_valueC		dc.w 0						;normalized value for cyan print intensity 0..15icmy_valueM		dc.w 0						;normalized value for magenta print intensity 0..15icmy_valueY		dc.w 0						;normalized value for yellow print intensity 0..15icmy_ctblbase	dc.w 0						;start offset of a single 16-entry, 32-byte color tableKCMY_valid		ds.b 16						;is-valid indicator flags for each color convert tableKCMY_lookup		ds.w 16*16					;16 convert tables of 16 $KCMY-word entries each*******************************************************************************IWPrPixMapOrText:				lda ActionBits				;see if want to print graphics or text at all				and #abDoImage+abGetID				beq goPrint				rts		   goPrint			lda ActionBits				;see if want to print native text instead of graphics				and #abTextMode				bne goPrintText				brl goPrintPix		   **Start of code to print string using printer's native text mode (for "Draft Printing"):*goPrintText:				jsr IdleProcAbortErrCheck	;call once before sending string				lda prError					;give user chance to exit before even printing anything				beq prtext_ln				;if user exit, don't go on				rts		   prtext_ln		lda CTablePtr				;check length: if null string, don't go on				bne prtext_ok				rts		   prtext_ok		pha							;div delta y to do 1)coarse, then 2)fine y posn/save time				pha				pushword SrcRectPtr+0				pushword #18/2				;number of y positions to do at a time to save time				_UDivide				pullword coarse_num_lf				pullword fine_num_lf								ldy coarse_num_lf			;do coarse delta y (move down only)				beq done_ypos1loop_ypos1		phy				lda #s_movedown_c				jsr writeshort				ply				dey				bne loop_ypos1done_ypos1				ldy fine_num_lf				;do fine delta y (move down only)				beq done_ypos2loop_ypos2		phy				lda #s_movedown_f				jsr writeshort				ply				dey				bne loop_ypos2done_ypos2				lda SrcRectPtr+2			;do absolute x (printer pix position to move head to)				pha				pushlong #n_moveacross				pushword #4				pushword #0				_Int2Dec				lda #s_moveacross				jsr writeshort								lda ActionBits				;selecting one of the printer's built-in text fonts				and #abIsIWOne				;don't select a font not supported on the IW I				bne textfont_no				lda #$30					;else select one of the printer's built-in fonts				shortm				ora SCBListPtr+0				sta n_textfont				longm				lda #s_textfont				jsr writeshorttextfont_no								shortm						;select one of the printer's built-in text sizes				lda SCBListPtr+1				longm				and #%111				asl a				asl a				clc				adc #s_textsize_tbl				jsr writeshort		   				lda #s_textstlreset			;select one of the printer's built-in text styles				jsr writeshort				shortm				lda SCBListPtr+2				longm				pha				and #%00000001				beq textstl_1				lda #s_boldface				jsr writeshorttextstl_1		pla				pha				and #%00000010				beq textstl_2				lda #s_underline				jsr writeshorttextstl_2		pla				pha				and #%00000100				beq textstl_3				lda #s_doublewidth				jsr writeshorttextstl_3		pla				and #%00001000				beq textstl_4				lda #s_halfheight				jsr writeshorttextstl_4				ldy #0						;String output loop.  get ready to loop through string		   loop_char		sty curr_posn				;get an ascii character from caller...				lda [SrcLocPtr],y				and #$00FF				sta stor_char								cmp #$20					;skip if control character...				bcc next_char				sec							;check if the char is international while normalizing				sbc #$80					;from $80..$FF to $00..$7F; branch based on if intl...				bpl its_intl								lda #stor_char				;output this printable std ascii character and loop...				ldx #^stor_char				ldy #1				jsr writelongnext_char		ldy curr_posn				;increment current position within string...				iny				cpy CTablePtr+0				;length was passed in lo word of CTablePtr				bne loop_char				;not done, get another one				lda #s_textstlreset			;done, always reset printer setup				jsr writeshort				lda #s_cr					;do carriage return so next string can be to the left				brl writeshort				;and exitits_intl		asl a						;current char is international normalized to $00..$7F				tax							;form index into intl char translation table				shortm						;intl_tbl entries: {byte new_char; byte lang_tbl_offset}				lda intl_tbl+0,x				sta stor_char				;overwrite our idea of the character code				lda intl_tbl+1,x			;now get the language it's in from language table				longm				and #$FF				clc							;lang tbl entries consist of writeshort command strings				adc #lang_tbl				;add base address of table				jsr writeshort				;set printer to the language		   				lda #stor_char				;output the character...				ldx #^stor_char				ldy #1				jsr writelong								lda #lang_tbl				;set language back to american and loop...				jsr writeshort				bra next_char				curr_posn		dc.w 0						;saved current position within stringstor_char		dc.w 0						;char storage required by our output routinescoarse_num_lf	dc.w 0						;number of computed big line feeds to get rough posnfine_num_lf		dc.w 0						;number of little line feeds to then get precise posns_newln			dc.b 2						;output line feed and carriage return				dc.b $0A,$0D		   s_textfont		dc.b 3						;select built-in fonts				dc.b $1B,$61n_textfont		dc.b $30					;$3N, where N=0..3s_textsize_tbl	dc.b 2						;select built-in font sizes				dc.b $1B,$6E,0				dc.b 2				dc.b $1B,$4E,0				dc.b 2				dc.b $1B,$45,0				dc.b 2				dc.b $1B,$65,0				dc.b 2				dc.b $1B,$71,0				dc.b 2				dc.b $1B,$51,0				dc.b 2				dc.b $1B,$70,0				dc.b 2				dc.b $1B,$50,0s_textstlreset	dc.b 7						;turn off bold, underline, doublewidth, halfheight				dc.b $1B,$22				dc.b $1B,$59				dc.b $0F				dc.b $1B,$57			   s_boldface		dc.b 2						;turn on boldface text mode				dc.b $1B,$21s_underline		dc.b 2						;turn on underline text mode				dc.b $1B,$58			   s_doublewidth	dc.b 1						;turn on doublewidth text mode				dc.b $0Es_halfheight	dc.b 2						;turn on halfheight text mode				dc.b $1B,$77			   s_movedown_c	dc.b 5						;coarse y posn: LF=18/144", do LF				dc.b $1B,$54				dc.b '18'				dc.b $0As_movedown_f	dc.b 5						;fine y posn: LF=2/144" (=1/72 match low-qual gr print)				dc.b $1B,$54				dc.b '02'				dc.b $0As_moveacross	dc.b 8						;move head N_MOVEACROSS ascii # of std res units				dc.b $1B,$4E				;set hor resolution to 80 dpi				dc.b $1B,$46				;set positionn_moveacross	dc.b '0000'lang_tbl		dc.b 4					;American - offset=00	;lang sel cmds for intl chars...				dc.b $1B,$5A,$07,$00							;indexed by offsets from intl_tbl				dc.b 8					;British  - offset=05	;table entries: writeshort strings				dc.b $1B,$5A,$04,$00				dc.b $1B,$44,$03,$00				dc.b 8					;Danish   - offset=14				dc.b $1B,$5A,$05,$00				dc.b $1B,$44,$02,$00				dc.b 8					;French   - offset=23				dc.b $1B,$5A,$01,$00				dc.b $1B,$44,$06,$00				dc.b 8					;German   - offset=32				dc.b $1B,$5A,$03,$00				dc.b $1B,$44,$04,$00				dc.b 8					;Italian  - offset=41				dc.b $1B,$5A,$06,$00				dc.b $1B,$44,$01,$00				dc.b 8					;Swedish  - offset=50				dc.b $1B,$5A,$02,$00				dc.b $1B,$44,$05,$00				dc.b 4					;Spanish  - offset=59				dc.b $1B,$44,$07,$00intl_tbl		dc.b $5B,50 , $5D,50 , $43,00 , $45,00			;mapping intl chars to chars+cmds...				dc.b $5C,59 , $5C,50 , $5D,32 , $61,00			;indexed by ascii $80..$FF				dc.b $7B,41 , $61,00 , $7B,50 , $61,00			;table entries: new_ascii,offset				dc.b $7D,50 , $5C,23 , $7B,23 , $7D,23			;into the language table above				dc.b $65,00 , $65,00 , $69,00 , $7E,41				dc.b $69,00 , $69,00 , $7C,59 , $6F,00				dc.b $7C,41 , $6F,00 , $7C,50 , $6F,00				dc.b $75,00 , $7C,23 , $75,00 , $7D,32				dc.b $2A,00 , $7B,59 , $63,00 , $23,05				dc.b $40,59 , $7B,59 , $50,00 , $7E,32				dc.b $20,00 , $20,00 , $20,00 , $27,00				dc.b $7E,23 , $23,00 , $5B,14 , $5C,14				dc.b $7E,00 , $7E,00 , $20,00 , $20,00				dc.b $59,00 , $75,00 , $64,00 , $45,00				dc.b $50,00 , $70,00 , $40,59 , $61,00				dc.b $6F,00 , $5A,00 , $7B,14 , $7C,14				dc.b $5D,59 , $5B,59 , $7E,00 , $20,00				dc.b $66,00 , $7E,00 , $64,00 , $22,00				dc.b $22,00 , $2E,00 , $41,00 , $41,00				dc.b $4F,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $22,00 , $22,00 , $27,00				dc.b $27,00 , $2F,00 , $20,00 , $79,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00**Start of code to print pixel map using printer's graphics mode (for non-draft printing):*goPrintPix:				jsr IdleProcAbortErrCheck	;allow at least one full error/cmd-period check				lda PrError				beq goPrintPixOk				rtsgoPrintPixOk					jsr IWModeSet				;set printer modes; boldface, character pitch, etc								lda #1						;make sure linebuffer gets cleared				sta LineDirty								jsr IWAddrCalc				;calculate scrn-pix increment values for looping								jsr FillRGBtoKCMY			;calculate color system conversion tables				doBandLoop		lda QualBits				;go do one of the two imaging loops				and #qbLandMode				beq Pbandloop				brl Lbandloop********************************************************************************allPbands		rts							;portrait print loop exit point		   Pbandloop									;********** PORTRAIT MODE PRINTING LOOP **********				lda PixMapHigh				;see if any more to print				beq allPbands				jsr IdleProcAbortCheck		;do idle procedure/option-period abort/status check				lda prError					;if abort or error, exit				bne allPbands				lda QualBits				;branch color/grayscale mode				bmi Pcband				Pbwband			lda vInterlace				;branch interlace/no interlace				beq Pbwband_noint		   Pbwband_int									;printing an interlaced grayscale band...				jsr saveinfo				;save pointer information so we can rewind back				lda #s_printBW				;go image and print one grayscale band				jsr onePband				lda #s_lf_1					;advance paper 1/144"				jsr writeshort				jsr restinfo				;rewind pointers				jsr nextPline				;but also advance one (off-) screen pixel line down				lda #s_printBW				;go image and print the interlaced grayscale band				jsr onePband				bra nextPbandI				;advance paper 15/144" and loop						   Pbwband_noint								;printing a non-interlaced grayscale band...				lda #s_printBW				jsr onePband				nextPbandN									;advance paper 16/144" (one full head height)				lda #s_lf_16				jsr writeshort				bra PbandloopPcband										;printing four color bands...				jsr saveinfo				;save values for pointer rewinds				jsr Pcband_do4				lda vInterlace				;if no vertical interlace, then advance paper and loop				beq nextPbandNPcband_isint	jsr restinfo				;printing 2nd pass of four color bands...				lda #s_lf_1					;rewind ptrs, adv paper 1/144", select odd lines, print				jsr writeshort				jsr nextPline				jsr saveinfo				;save for ptr rew after "nextPline" to keep its effect				jsr Pcband_do4				nextPbandI									;advance paper 15/144" (head height minus 1/144"				lda #s_lf_15				;because we advanced 1/144" for the 2nd interlace pass)				jsr writeshort				bra PbandloopPcband_do4		lda #s_printyel				;subroutine to print 4 color bands, doing a "restinfo"				jsr onePband				;after each color band except the last				jsr restinfo				lda #s_printmag				jsr onePband				jsr restinfo				lda #s_printcyn				jsr onePband				jsr restinfo				lda #s_printblk				brl onePband**********saveinfo		 							;save all variables modified by				lda PixMapBase+0			;the band print routine				sta savearea+0				lda PixMapBase+2				sta savearea+2				lda PixMapHigh				sta savearea+4				lda SCBTabBase				sta savearea+6				lda PixMapWide				sta savearea+8				rtssavearea		ds.b 10restinfo									;restore variables modified by				lda savearea+0				;the band print routine				sta PixMapBase+0				lda savearea+2				sta PixMapBase+2				lda savearea+4				sta PixMapHigh				lda savearea+6				sta SCBTabBase				lda savearea+8				sta PixMapWide				rts**********onePband									;image one portrait mode band...				sta colorstr				;remember what color it is				jsr clearline				;clear the line buffer				stz linebase				;zero pix line base								ldx #7						;the following assumes that vScaling is either 1 or 2				ldy #%00000001				;if vScaling==1, then do 8 scrn pix lines of 1 bit each,				lda vScaling				;if vScaling==2, then do 4 scrn pix lines of 2 bits each,				cmp #2						;where "bit" refers to a vertical head striker wire				bne opb_setup				ldx #3				ldy #%00000011opb_setup				stx opb_count				sty opb_vbitsopb_loop 				lda opb_vbits				;bitmask indicates number/posn of striker wires to fire				jsr onePline				;generate line(s) of pr pixels from 1 line of scrn pix				jsr nextPline				;advance pointers to next screen line								lda vInterlace				;if vertical interlace enabled,				beq opb_nointr				lda opb_count				;and if not at bottom print head wire,				beq opb_nointr				jsr nextPline				;adv one more so every-other scrn line used for each wireopb_nointr				asl opb_vbits				;advance bitmask to next group of striker wire(s) down				lda vScaling				;if vertical scaling is 2 then advance again because				cmp #2						;the striker pattern is two wires tall				bne opb_novbt2				asl opb_vbitsopb_novbt2				dec opb_count				;go all the way down the print head, then done with band				bpl opb_loop				bra PbanddonePbandexit									;here if nextPline has aborted this band				pla							;do print command and abort by return to caller's caller				bra Pbanddone_goPbanddone									;one band (head scan) of printer-pixels is now ready				jsr IdleProcAbortCheck		;check abort, exec idleproc, etc.				lda prError				beq Pbanddone_go				pla							;if error status, abort by return to caller's caller				rts				Pbanddone_go								;a line of printer-ready pixels has now been generated				lda colorstr				;go send it, unless we are in the following situation:				cmp #s_printblk				;blackband+better+color+640+~notunibo+~vinterlace,				bne Pbanddone_go2			;in which case, turn boldface off temporarily so that				lda QualBits				;640's black dithering does not make the colors muddy				bit #qbNoUniBo				bne Pbanddone_go2				and #qbBetter+qbColor				cmp #qbBetter+qbColor				bne Pbanddone_go2				lda MasterMode				beq Pbanddone_go2				lda vInterlace				bne Pbanddone_go2				Pbanddone_go1	lda #s_bold_no				jsr writeshort				jsr SendBuff				lda #s_boldface				brl writeshort				Pbanddone_go2	brl SendBuffnextPline									;common routine to advance to next pixel line...				clc							;works by doing PixMapBase += pixmapwidth (bytes)				ldy #owidth				lda [SrcLocPtr],y				adc PixMapBase+0				sta PixMapBase+0				lda PixMapBase+2				adc #0				sta PixMapBase+2				inc SCBTabBase				;also inc the part of the SCB table we're looking at				dec PixMapHigh				;if at bottom of pixelmap, pull RTS				beq Pbandexit				;...addr from stack and abort onePline				rtsopb_count		dc.w 0						;# of groups counter variable for onePband loop aboveopb_vbits		dc.w 0						;changing bit mask variable for onePband loop above**********onePline									;generate band data for one pixel line				sta pixelbits				;A=bit mask for this line				lda linebase				sta lineoffset				stz DitherH				lda PixMapLeft				sta leftskip				lda MasterMode				sta ThisLMode				lda MasterPal				sta ThisLPal				lda SCBListPtr+0			;if a SCBList was specified, as always, get				ora SCBListPtr+2			;the mode/palette for this line from it				beq gothePmode				ldy SCBTabBase				lda QualBits				;if in Better Text mode, must scale the scb list index				and #qbBetter				;down by same amount the driver scaled the pixmap up				beq gotPindex				;if not better, we don't have to scale scb list				lda QualBits				and #qbReduct				;if better+reduction, we don't have to scale scb list				bne gotPindexPscbdiv2		tya							;better+full size: divide scb index by 2				lsr a				taygotPindex	 				lda [SCBListPtr],y				and #$0080				sta ThisLMode				lda [SCBListPtr],y				and #$000F				sta ThisLPalgothePmode	 				lda ThisLPal				;shift color table select value to transform 0..15				asl a						;into start address of 16-word (32-byte) color table				asl a				asl a				asl a				asl a				sta ThisLPal				;it's now offset of the colortable for this line		   				stz Pbw6_enabl				;see if we can enable std-black/white-pixel-value imaging				lda ThisLMode				;mode must be 640				cmp #$0080				bne Pnot_bw6				lda hscaling				;hscaling must be 1				cmp #1				bne Pnot_bw6				lda leftskip				;leftskip must be 0				bne Pnot_bw6				ldy ThisLPal				;check all first minipallette entries for pure black...				ldx #4Pch1_bw6		lda [CTablePtr],y				bne Pnot_bw6				tya				clc				adc #8				tay				dex				bne Pch1_bw6				lda ThisLPal				;check all fourth minipallette entries for pure white...				clc				adc #6				tay				ldx #4Pch2_bw6		lda [CTablePtr],y				cmp #$0FFF				bne Pnot_bw6				tya				clc				adc #8				tay				dex				bne Pch2_bw6				lda #1						;enable only if above requirements are all met				sta Pbw6_enablPnot_bw6		   				ldy #owidth					;obtain byte-width of scanlines for white-scan loop				lda [SrcLocPtr],y				sta Pwht_btend+1								stz Pwht_enabl				;see if we have a white color table entry; we'll				lda ThisLPal				;figure out what a word full of white pixels looks like				clc				adc #$1E				tayPfndwhite		lda [CTablePtr],y			;look for first pure white color table entry				cmp #$0FFF				beq Ppalwhite				dey				dey				tya				cmp ThisLPal				;loop for all 32 bytes in this color table				bpl Pfndwhite				brl Pdonwhite		   Ppalwhite		tya				sec				sbc ThisLPal				tay				lda ThisLMode				and #$0080				bne Ppalwh640		   Ppalwh320		lda #1						;found white color entry and we're in 320 mode				sta Pwht_enabl				;enable white-scanning				tya				lsr a				and #$F				sta Pwht_model+1			;build white model word -- what 2 bytes of white in 320				asl a						;mode (4 pixels) would look like in memory				asl a				asl a				asl a				ora Pwht_model+1				sta Pwht_model+1				xba				ora Pwht_model+1				sta Pwht_model+1				bra Pdonwhite		   Ppalwh640		cpy #$18					;in 640 mode -- all other 3 minipall must also be white,				bcc Pdonwhite				;else don't enable white scanning				tyx				lda #$0FFF				dey				dey				dey				dey				dey				dey				dey				dey				cmp [CTablePtr],y				bne Pdonwhite				dey				dey				dey				dey				dey				dey				dey				dey				cmp [CTablePtr],y				bne Pdonwhite				dey				dey				dey				dey				dey				dey				dey				dey				cmp [CTablePtr],y				bne Pdonwhite				lda #1						;yes we're ok to enable white-scanning				sta Pwht_enabl				txa							;build a white model word -- what 2 bytes of white in 640				lsr a						;mode (8 pixels) would look like in memory				and #%11				sta Pwht_model+1				asl a				asl a				ora Pwht_model+1				sta Pwht_model+1				asl a				asl a				asl a				asl a				ora Pwht_model+1				sta Pwht_model+1				xba				ora Pwht_model+1				sta Pwht_model+1Pdonwhite  									;finished with search for white pixel values				lda PixMapWide				;initialize for horizontal pixel countdown				sta horPcount								lda #8						;initialize line buffer offset increment factor				sta Pwht_lbinc+1			;set to 8 if hor scaling is 1, set to 16 if hor				lda hScaling				;scaling is 2; this is the amount by which the				dea							;printer-ready-pixel buffer pointer is advanced for				beq Pdonelbisetup			;every whole word full of white pixels scanned				asl Pwht_lbinc+1Pdonelbisetup				ldy #0						;initialize screen-byte counterPbyteloop									;head of loop for bytes in this pixel line				lda Pwht_enabl				;see if we can do white pixel word elimination				beq Pbytepxls				sty Pwht_oldbp				;save old line byte position		   PwhtScan		lda [PixMapBase],y			;try to eliminate whole words of white pixels at timePwht_model		cmp #$0000					;NOTE: operand for this instruction is stuffed				bne PwhtNonWht				lda lineoffset				;increment printer-pixel-line-buffer offset always by				clc							;8|16: hscale always 1|2, and == # pr pix for 320/640Pwht_lbinc		adc #$0000					;NOTE: operand for this instruction is stuffed				sta lineoffset				;so that we're elim 8 scrn pix -> 8|16 pr pix at a time				iny				inyPwht_btend		cpy #$0000					;NOTE: operand for this instruction is stuffed				bcc PwhtScanPwhtExit		rts							;exit here if we ran out of bytes in current line		   PwhtNonWht		cpy Pwht_oldbp				;skip this part quick if we couldn't do any white words				beq Pbytepxls		   				tya							;here we are if a word is found to be nonwhite				sec							;figure out how many pixels we skipped, leaving Y intact				sbc Pwht_oldbp				;now have number of bytes we skipped				asl a						;4 pix/byte if 640 mode; also for 320 b/c prpix doubled				asl a				tax							;faking changes that would occur if we did pixels				lda horPcount				;horPcount -= num_pix_skipped				stx horPcount				sec				sbc horPcount				sta horPcount				beq PwhtExit				;exit here if horPcount <= 0				bcc PwhtExit				stz leftskip				;leftskip=0 since guaranteed to be byte-aligned nowPbytepxls		lda ThisLMode				;here we start picking pixels out of an (off)-screen byte				bne Pbyte640Pbyte320									;320 mode generates pairs of identical				lda [PixMapBase],y			;...pixels, for compatibility with 640				lsr a				lsr a				lsr a				lsr a				jsr onePpixel				;left pixel in byte				lda [PixMapBase],y				lsr a				lsr a				lsr a				lsr a				jsr onePpixel				;left pixel in byte, again				lda [PixMapBase],y				jsr onePpixel				;right pixel in byte				lda [PixMapBase],y				jsr onePpixel				;right pixel in byte, again				iny							;do next byte full of pixmap pixels				bra PbyteloopPbyte640				lda Pbw6_enabl				;see if ok to do std-black/white-quick-imaging shortcut				bne Pbw6_ok1				brl Pbw6_genPbw6_ok1		lda colorstr				;see if on the b/w band, else don't do quick-imaging				cmp #s_printBW				beq Pbw6_ok2				brl Pbw6_genPbw6_ok2		lda [PixMapBase],y				cmp #%11111111				beq Pbw6_ndty				;should we set dirty flag? no, this byte is all white				ldx #1						;not all-white: set dirty flag				stx LineDirtyPbw6_ndty		phy							;prepare for quick, unwound, in-line imaging of one byte				pha							;the code groups that follow do a byte full of screen				ldy lineoffset				;pixels directly to printer pixels, providing they have				ldx pixelbits				;no colors other than black and white		   				and #%11000000				;leftmost pixel in 640 mode byte				beq Pbw6_B0				cmp #%11000000				bne Pbw6_cant				bra Pbw6_W0Pbw6_B0			txa				ora LineBuffer,y				sta LineBuffer,yPbw6_W0			iny		   				lda 1,s						;second pixel in 640 mode byte				and #%00110000				beq Pbw6_B1				cmp #%00110000				bne Pbw6_cant				bra Pbw6_W1Pbw6_B1			txa				ora LineBuffer,y				sta LineBuffer,yPbw6_W1			iny		   				lda 1,s						;third pixel in 640 mode byte				and #%00001100				beq Pbw6_B2				cmp #%00001100				bne Pbw6_cant				bra Pbw6_W2Pbw6_B2			txa				ora LineBuffer,y				sta LineBuffer,yPbw6_W2			iny		   				lda 1,s						;rightmost pixel in 640 mode byte				and #%00000011				beq Pbw6_B3				cmp #%00000011				bne Pbw6_cant				bra Pbw6_W3Pbw6_B3			txa				ora LineBuffer,y				sta LineBuffer,yPbw6_W3			iny		   				lda horPcount				;decrement/exit-on-zero horizontal pixelmap pixel count				sec							;we did four pixels in this byte				sbc #4				sta horPcount				beq Pbw6_exit				bcc Pbw6_exit		   Pbw6_next		sty lineoffset				;we're not exitting because of horPcount, update counters				pla							;clean up stack which had saved pixmap byte				ply							;restore pixelmap byte index				iny							;do next pixmap byte full of pixels now				brl Pbyteloop		   Pbw6_exit		pla							;end of horPcount, clean stack and exit this prpix line				ply				rtsPbw6_cant		pla							;turned out byte wasn't all-B/W, clean up stack, restore				ply							;pixmap byte index and drop into general-case code	Pbw6_gen		lda [PixMapBase],y				asl a				asl a				xba				and #%0011				jsr onePpixel				;first pixel in byte				lda [PixMapBase],y				lsr a				lsr a				lsr a				lsr a				and #%0011				ora #%0100				jsr onePpixel				;second pixel in byte				lda [PixMapBase],y				lsr a				lsr a				and #%0011				ora #%1000				jsr onePpixel				;third pixel in byte				lda [PixMapBase],y				ora #%1100				jsr onePpixel				;last pixel in byte				iny							;do next byte full of pixmap pixels				brl Pbyteloop**********onePpixel									;do stack pointer -2 to exit current line				dec leftskip				;do nothing if we are skipping pixels				bmi rightonP				;...at the left edge (max 3)				rtsrightonP						phy							;save index into pixel line				and #$000F					;pixel value is given in ACC				asl a						;convert pixel into colortable index				ora ThisLPal				;and add SCB palette-select-value for this line				tay							;Y now has offset into color table for current pixel								ldx colorstr				;branch based on color/grayscale mode				cpx #s_printBW				bne colorPpix				bwPpix										;convert RGB to grayscale:				lda [CTablePtr],y			;obtain RGB value from colortable				and #$0FFF					;if it's white, save some work				cmp #$0FFF				bne bwPpix_nwht				brl isPzerobwPpix_nwht		xba				and #$000F					;R				sta colortemp				asl a				asl a						;4R				adc colortemp				sta colortemp				;5R				lda [CTablePtr],y				lsr a				and #%01111000				;8G				clc				adc colortemp				;5R+8G				tax				lda [CTablePtr],y				and #$000F					;B				sta colortemp				txa				eor #$FF					;255-5R-8G				sec				sbc colortemp				;255-5R-8G-B				sbc colortemp				;255-5R-8G-2B				sbc colortemp				;255-5R-8G-3B				and #%11110000				lsr a						;set A bits 3..6 to density value of 0..15 for patt plot				beq bwPpix_finish			;if zero, don't do 640-adjust below				ldx thisLmode				;check if 640 mode, if 640 (and black/white), use only				beq bwPpix_finish			;few of the levels to avoid beating with 640's dithering				cmp #%01111000				;if full density, don't do 640-adjust				beq bwPpix_finish				cmp #%00011000				;compare for light yellow				beq bwPpix_adj				cmp #%01101000				;compare for std screen light blue				bne bwPpix_finishbwPpix_adj		lda #%00101000				;substitute density for better				ldx hScaling				dex				beq bwPpix_finish1				lda #%00111000				;substitute density for standardbwPpix_finish	ldx #0						;set X to 0 for pattern plotbwPpix_finish1	brl gotPvaluecolorPpix						lda KCMY_lookup,y			;convert $0RGB to $KCMY with table				ldy colorstr				;branch on the color being printed and				cpy #s_printyel				;extract proper K, C, M, or Y nibble				beq yelPpix				cpy #s_printmag				beq magPpix				cpy #s_printcyn				beq cynPpixblkPpix							xba				lsr a						;set A bits 3..6 to density value				ldx #0						;set X for pattern plot routine				bra gotPvaluecynPpix							xba				asl a				asl a				asl a						;set A bits 3..6 to density value				ldx #3						;set X for pattern plot routine				bra gotPvalue				magPpix							lsr a						;set A bits 3..6 to density value				ldx #3						;set X for pattern plot routine				bra gotPvalueyelPpix							asl a				asl a				asl a						;set A bits 3..6 to density value				ldx #3						;set X for pattern plot routine				gotPvalue									;A=print density, 0..15 * 8 (in bits %.XXXX...)				and #%01111000				;X=dither pattern offset, 0=blk 3=CMY				sta colortemp				;(keeps black from overprinting color)				bne isPnonzeroisPzero										;save some work if density is 0				clc							;fake the changes that would be made				lda DitherH					;if we continued with this pixel				adc hScaling				sta DitherH				lda lineoffset				clc				adc hScaling				sta lineoffset				bra PpixeldoneisPnonzero									;nonzero density, so "print" it into linebuffer...				lda #1						;prep to write piece of density patt into linebuffer...				sta LineDirty				txa							;calculate dithmatrix offset based on				clc							;density and offset				adc DitherH					;add DitherH value, which just increases all the time				and #%111					;take only least 3 significant bits to make 0..7 index				ora colortemp				;select density level; now have offset into dithmatrix				tax							;have density level in X for pr patt pix plot routine				lda hScaling				dea				beq PpixelX1PpixelX2		jsr onePpixel1PpixelX1		jsr onePpixel1				;call plotter; hor scale always 1 for IW portrait modesPpixeldone				dec horPcount				;see if more pixels to print				bne stillonP				;if not, stop caller (onePline) by pulling				ply							;...RTS address from stackstillonP				ply							;restore index into pixel line				rts**********onePpixel1									;do stack pointer -6 to exit current line				inc DitherH					;entered with X=dithmatrix offset				import Dithmatrix				lda Dithmatrix,x			;get dither pattern				inx							;advance to next byte of dither pattern				and pixelbits				;apply mask for this pixel line				ldy lineoffset				;get offset into linebuffer				cpy crWidth					;make sure we're not at end				bge offPend				ora LineBuffer,y			;OR masked pattern into buffer				sta LineBuffer,y				iny							;increase line buffer position by 1 for IW 8-pin				sty lineoffset				txa							;move to next byte of pattern				and #%111				bne Pxisok					;see if we need to wrap to next dither level				sec							;if so, go back to beginning of this				txa							;dither density level				sbc #8				taxPxisok			 				rtsoffPend										;at end of linebuffer: stop caller's caller (onePline)				pla							;by pulling 2 RTS addresses and a				pla							;pushed Y from the stack				pla				rtss_printyel		dc.b	3	                ;select yellow ribbon band				dc.b	$1B,$4B,$31			s_printmag		dc.b	3					;select magenta ("red") ribbon band				dc.b	$1B,$4B,$32			s_printcyn		dc.b	3					;select cyan ("blue") ribbon band				dc.b	$1B,$4B,$33			s_printblk		dc.b	3					;select black ribbon band				dc.b	$1B,$4B,$30			s_printBW		dc.b	1	                ;nothing to do in grayscale printing				dc.b	$00	s_lf_16			dc.b	5	                ;LF=16/144", do LF (for advancing one vert head scan)	   			dc.b	$1B,$54	   			dc.b	'16'	   			dc.b	$0A						s_lf_15			dc.b	5					;LF=15/144", do LF (adv vert head scan - interlace dist)	   			dc.b	$1B,$54	   			dc.b	'15'	   			dc.b	$0A			s_lf_1			dc.b	5	                ;LF=1/144", do LF (for advancing during vert interlace)	   			dc.b	$1B,$54	   			dc.b	'01'	   			dc.b	$0A			Pwht_enabl		dc.w	0					;white-eliminate: enable scan (ie, pure white is present)Pwht_oldbp		dc.w	0					;white-eliminate: old byte position before scanPbw6_enabl		dc.w	0					;b/w-imaging: enable (ie, pure b/w in std locations)********************************************************************************Lbandloop		 							;********** LANDSCAPE MODE PRINTING LOOP **********LwhtQualfy		stz Lwht_enabl				;see if conditions permit white-elim shortcut...				stz Lwht_maxce				;clear enable and init maximum color table entry used		   				lda SCBListPtr+0				ora SCBListPtr+2				bne LwhtCkSCB				;if SCB list was specified, as it must be, go check it				lda MasterMode				;else skip SCB list test - use master mode and 0 maxce				sta Lwht_mode				bra LwhtFndWht		   LwhtCkSCB		lda [SCBListPtr]			;all SCB list entries must be the same mode				and #$0080					;find out which mode				sta Lwht_mode								ldy PixMapHigh				;get ready to search the rest of SCB list...				lda QualBits				;infer SCB list size from tallness of pixmap				and #qbBetter				;and scale its tallness down if Better+100% modes				beq LwhtCkNoDiv				;to compensate for scaled-up pixmap				lda QualBits				and #qbReduct				bne LwhtCkNoDiv				tya							;do SCB list size /2 if Better+100%				lsr a				tayLwhtCkNoDiv		   LwhtCkSCBs		dey							;do search SCB list, y has length of list, from y-1 to 0				cpy #$FFFF				beq LwhtCkSCBxLwhtCkSCBa		lda [SCBListPtr],y				tax				and #$0080					;each line must be same mode				cmp Lwht_mode				bne LwhtCant				txa				and #$000F					;find out maximum color table entry used				cmp Lwht_maxce				bcc LwhtCkSCBs				sta Lwht_maxce				bra LwhtCkSCBsLwhtCkSCBxLwhtFndWht		lda Lwht_maxce				;check for pure white in standard color table entries...				asl a						;set white-checking-loops range-limits to lastmost item				asl a						;in the last color table used by any of the lines/SCBs				asl a						;(max_color_entry_used_0_to_15 * 32) + 30				asl a				asl a				clc				adc #30				sta LwhtFndW6l+1				sta LwhtFndW3l+1				lda Lwht_mode				;go do appropriate white-checker...				beq LwhtFndW3LwhtFndW6		ldy #3*2					;640-mode pure-std-white testLwhtFndW6s		lda [CTablePtr],y			;test last of all 4 minipallettes of all 16 ctbl entries				cmp #$FFF				bne LwhtCantLwhtFndW6l		cpy #$0000					;NOTE: this operand is stuffed				beq LwhtItsOk				tya				clc				adc #8				tay				bra LwhtFndW6s		   LwhtFndW3		ldy #15*2					;320-mode pure-std-white testLwhtFndW3s		lda [CTablePtr],y			;test last palette of all 16 ctbl entries				cmp #$FFF				bne LwhtCantLwhtFndW3l		cpy #$0000					;NOTE: this operand is stuffed				beq LwhtItsOk				tya				clc				adc #32				tay				bra LwhtFndW3s		   LwhtItsOk		lda #1						;here if all tests passed and it's ok to take shortcut				sta Lwht_enabl		   LwhtCant									;here if any Lwht test failed, not ok to take shortcut***********				bra LbandloopS		   allLbands		rts							;landscape print loop exit pointLbandloopS 				lda PixMapWide				;check if more columns to print				beq allLbands				jsr IdleProcAbortCheck		;idle procedure/option-period abort/error check				lda prError				bne allLbands				stz Lint_ispass2			;reset pixel rotation flag for intlaced "oneLline" calls				lda QualBits				;branch color/grayscale				bmi Lcband		   Lbwband										;grayscale: branch interlace/no interlace				lda vInterlace				beq Lbwband_noint		   Lbwband_int									;printing an interlaced grayscale band...				jsr saveinfo				;save pointer info for rewind				lda #s_printBW				;print one band, with even source lines				jsr oneLband				lda #s_lf_1					;advance paper 1/144"				jsr writeshort				jsr restinfo				;rewind pointers				lda #1						;arrange to use odd source lines				sta Lint_ispass2				lda #s_printBW				;print second pass interlaced band				jsr oneLband				bra nextLbandI				;advance paper 15/144" and loop						   Lbwband_noint								;printing a non-interlaced grayscale band...				lda #s_printBW				jsr oneLband				nextLbandN									;advance paper 16/144" (one full head height) and loop				lda #s_lf_16				jsr writeshort				bra LbandloopSLcband										;printing the four color bands...				jsr saveinfo				;save pointer info for rewinds				stz Lcb_ispass2				;ensure handling of pass one/no interlace				jsr Lcband_do4				;print four color bands				lda vInterlace				;if not interlaced, then advance paper and loop				beq nextLbandN				jsr restinfo				;else, rewind ptrs, advance paper 1/144",				lda #s_lf_1					;arrange to assert is-pass-2 setting, and print the				jsr writeshort				;interlaced part of the four color bands				lda #1				sta Lcb_ispass2				jsr Lcband_do4								nextLbandI									;advance paper 15/144" (head height minus 1/144"				lda #s_lf_15				;because we advanced 1/144" to do 2nd interlace pass)				jsr writeshort				;and loop				bra LbandloopSLcband_do4		lda Lcb_ispass2				;subroutine to print the four color bands, doing				sta Lint_ispass2			;"restinfo" to rewind pointers each time except the				lda #s_printyel				;last time and communicating the is-pass-2 status				jsr oneLband				jsr restinfo				lda Lcb_ispass2				sta Lint_ispass2				lda #s_printmag				jsr oneLband				jsr restinfo				lda Lcb_ispass2				sta Lint_ispass2				lda #s_printcyn				jsr oneLband				jsr restinfo				lda Lcb_ispass2				sta Lint_ispass2				lda #s_printblk				brl oneLband				Lcb_ispass2		dc.w 0**********oneLband									;print one landscape mode band				sta colorstr				;remember what color it is				jsr clearline				lda crWidth				sta linebase				lda vInterlace				;branch based on vertical interlace setting				bne LlineX1IntLlineX1										;vScaling==1, vInterlace==0 (not interlaced)				lda #%00000001				;2 h bytes of (off-) scrn pix per 8-vert pin head scan				sta Lpixmask1				;1 printer dot per 640 mode pixel				lda #%00000010				ldx #%00000100				ldy #%00001000				jsr oneLline				;calc contents from 4 h screen pixels into linebuffer				jsr nextLline				;print head pins 1,2,3,4 and go to next scrn byte column				lda #%00010000				sta Lpixmask1				lda #%00100000				ldx #%01000000				ldy #%10000000				jsr oneLline				;calc contents from next 4 h scrn pixels into linebuffer				jsr nextLline				;print head pins 5,6,7,8 and go to next scrn byte column				bra Lbanddone		   LlineX1Int									;vScaling==1, vInterlace==1 (interlaced)				ldx #4						;4 h bytes (320 or 640) of (off-) scrn pix/8-pin head				stx Lln_count				;doing a set of every-other h scrn pix into all 8 pins				ldx #%00000001				;640 mode: one print head pin per scrn pixel				lda MasterMode				bne LlX1i_smod				ldx #%00000011				;320 mode: two print head pins per scrn pixelLlX1i_smod		stx Lln_mask				;init mask which indicates which head pins to affectLlX1i_loop		lda MasterMode				beq LlX1i_320LlX1i_640		lda Lln_mask				;640: initial values: Lpixmask1 = %00000001				sta Lpixmask1				;                     Lpixmask2 = 0 (skip scrn pix)				asl Lln_mask				;                     Lpixmask3 = %00000010				lda #0						;                     Lpixmask4 = 0 (skip scrn pix)				ldx Lln_mask				;then next 2 bits are done, etc, etc; 4 times until				ldy #0						;data for all pr head pins has been put into linebuffer				bra LlX1i_doLlX1i_320		lda Lln_mask				;320: initial values: Lpixmask1 = %00000011				sta Lpixmask1				;                     Lpixmask2 = %00000011				asl Lln_mask				;                     Lpixmask3 = 0 (skip scrn pix)				ldx #0						;                     Lpixmask4 = 0 (skip scrn pix)				ldy #0						;then next 2 bits are done, etc, etc; 4 times untilLlX1i_do		jsr oneLline				;data for all pr head pins has been put into linebuffer				jsr nextLline				asl Lln_mask				dec Lln_count				;"oneLline" fills-in linebuff, "nextLline" bumps scrn pix				bne LlX1i_loop				;counter; we then bump the mask and loop for 4 times				inc DitherH					;done, bump dither offset for next intlaced line				bra LbanddoneLbandexit		 							;nextLline has aborted this band				pla							;do print commands and abort by return to caller's caller				bra Lbanddone_go		   Lbanddone									;one band (head scan) of printer-pixels is now ready				jsr IdleProcAbortCheck		;check abort, exec idleproc, etc.				lda prError				beq Lbanddone_go				pla							;if error status, abort by return to caller's caller				rts				Lbanddone_go	jsr SendBuff				;send graphics printing commands				stz Lint_ispass2			;reset this flag now for next time				rtsnextLline									;common routine to advance to next				inc PixMapBase+0			;column of pixmap bytes				bne noinchiL				inc PixMapBase+2noinchiL						dec PixMapWide				;abort oneLband if at right edge				beq Lbandexit				dec PixMapWide				beq Lbandexit				dec PixMapWide				beq Lbandexit				dec PixMapWide				beq Lbandexit				rts**********Lpixmask1		dc.w 0						;masks for the 4 pixels per (off-) screen byte, whereLpixmask2		dc.w 0						;in "Lpixmask#" the # refers to the screen pixel and theLpixmask3		dc.w 0						;bits within the mask are the posns within a linebufferLpixmask4		dc.w 0						;byte where the dither pattern is appliedLwht_enabl		dc.w 0						;flag if conditions permit white-elim shortcutLwht_mode		dc.w 0						;320/640-mode indicator for white-elim shortcutLwht_maxce		dc.w 0						;max-found ctbl-select among SCBs for white-elim shortcutLint_ispass2	dc.w 0						;flag if we're inside 2nd pass of interlaced bandLln_count		dc.w 0 						;# times through "LlineX1Int" (one-intlace-band) loopLln_mask		dc.w 0 						;current linebuffer affect mask during "LlineX1Int" loop**********oneLline		 							;generate data for one column of bytes				sta Lpixmask2				;Lpixmask1 already been set; A,X,Y contain values for				stx Lpixmask3				;Lpixmask2, Lpixmask3, and Lpixmask4.  There are 4 masks				sty Lpixmask4				;for the 4 pixels per 640 (off-) screen byte								lda Lint_ispass2			;if we're doing 2nd pass of an intlaced band, rotate the				beq LlnDonRot				;values in pix masks so alternate set of scrn pix is used				jsr LlnDoRotat				;rotate once to obtain 1,2,3,4 -> 4,1,2,3				lda MasterMode				;if 320 mode, rotate again to obtain 1,2,3,4 -> 3,4,1,2				bne LlnDonRot				jsr LlnDoRotat				bra LlnDonRot		   LlnDoRotat		ldx Lpixmask1				;rotate order 1,2,3,4 -> 4,1,2,3				lda Lpixmask4				sta Lpixmask1				lda Lpixmask3				sta Lpixmask4				lda Lpixmask2				sta Lpixmask3				stx Lpixmask2				rts		   LlnDonRot				lda linebase				;reset line buffer offset back to right-hand-side				sta lineoffset				;we will go backwards (to printer left) in this routine								stz DitherH					;init dither pattern offset				stz horPcount				;init counter used for scb indexing		 				ldy #oWidth					;set up byte-increment-factor for code below which				lda [SrcLocPtr],y			;attempts to avoid imaging parts of this column if white				sta Lwht_btinc+1				pha							;result space				pha							;result space				pha							;pass pixmap width				pushword PixMapHigh			;pass pixmap tallness				_Multiply				pla							;set up byte-end-value with lo word of width*tall				sta Lwht_btend+1				pla				lda hScaling				;set up horizontal scaling factors for code below				sta Lwht_lodec+1			;for updating "lineoffset" value				sta Lwht_dhinc+1			;for updating "DitherH" value				ldy #0						;init byte counter at top of (off-) screen columnLbyteloop									;looping verically down for bytes within column; Y valid				lda Lwht_enabl				;see if conditions permit quick white-checking				beq LwhtDoImgLwhtScan		lda [PixMapBase],y			;try to quickly eliminate bytes as all-std white				and #$00FF				cmp #%11111111				;320 (2 pix) or 640 (4 pix) all-std-white check				bne LwhtDoImg				;break off search as soon as we get nonwhite				lda lineoffset				;update counter used for linebuffer indexingLwht_lodec		sbc #$0000					;NOTE: carry always set here, NOTE: operand is stuffed				sta lineoffset				lda DitherH					;update dith value so as not to interrupt patterns				clcLwht_dhinc		adc #$0000					;NOTE: this operand is stuffed				sta DitherH				inc horPcount				;update counter used for scb indexing				tya							;update Y-reg counter used for scrn pix byte access				clcLwht_btinc		adc #$0000					;NOTE: this operand is stuffed				tayLwht_btend		cpy #$0000					;NOTE: this operand is stuffed				bne LwhtScanLwhtExit		rts							;if we got this far, exit without having done imagingLwhtDoImg						lda MasterMode				;goes top to bottom				sta ThisLMode				;(right to left in linebuffer)				lda MasterPal				sta ThisLPal				lda SCBListPtr+0			;if SCBList specified, get mode/palette number from it,				ora SCBListPtr+2			;otherwise, skip next section. must always be specified				beq gotLmode		   				phy							;prep to obtain mode/palette for line; save byte index				clc				lda SCBTabBase				adc horPcount				tay				lda QualBits                 ;if Better+100% modes, we must scale the SCBList index				and #qbBetter                ;down to compensate for scaled-up pixmap				beq gotLindex				lda QualBits				and #qbReduct				bne gotLindex				tya							;do SCBList index /2 if Better+100%				lsr a				taygotLindex				lda [SCBListPtr],y			;get mode/palette for this current (off-) screen line				and #$0080				sta ThisLMode				lda [SCBListPtr],y				and #$000F				sta ThisLPal				ply							;done obtaining mode/palette; restore byte index		   gotLmode						lda ThisLPal				asl a				asl a				asl a				asl a				asl a				sta ThisLPal				lda lineoffset				sta saveoffset				lda DitherH				sta savedither				lda ThisLMode				;branch based on pixel line's mode				bne Lbyte640Lbyte320		 				lda Lpixmask1				;OR together masks for two 640 pixels				ora Lpixmask2				;to get mask for one 320 pixel				tax				lda [PixMapBase],y				lsr a				lsr a				lsr a				lsr a				jsr oneLpixel				;left pixel				lda PixMapWide				;abort if right edge of pixmap is in				cmp #3						;the middle of a byte				blt goLbdonelt				jsr restpixel				lda Lpixmask3				;OR together other two 640 mode masks				ora Lpixmask4				tax				lda [PixMapBase],y				jsr oneLpixel				;right pixel				bra nextLbyteLbyte640		 				lda [PixMapBase],y				asl a				asl a				xba				and #%0011				ldx Lpixmask1				jsr oneLpixel				;first 640 mode pixel				lda PixMapWide				;abort if at pixmap right edge				cmp #2goLbdonelt		blt Lbytedone				jsr restpixel				lda [PixMapBase],y				lsr a				lsr a				lsr a				lsr a				and #%0011				ora #%0100				ldx Lpixmask2				jsr oneLpixel				;second pixel				lda PixMapWide				;abort if at right edge				cmp #3				blt Lbytedone				jsr restpixel				lda [PixMapBase],y				lsr a				lsr a				and #%0011				ora #%1000				ldx Lpixmask3				jsr oneLpixel				;third pixel				lda PixMapWide				;abort if at right edge				cmp #4				blt Lbytedone				jsr restpixel				lda [PixMapBase],y				ora #%1100				ldx Lpixmask4				jsr oneLpixel				;last pixelnextLbyte									;advance to next byte in column				tya				ldy #owidth				clc				adc [SrcLocPtr],y				tay				inc horPcount				lda horPcount				;see if at bottom of column				cmp PixMapHigh				bge Lbytedone				lda lineoffset				;or at left end of linebuffer				bmi Lbytedone				brl LbyteloopLbytedone						rtssaveoffset		ds.b 2savedither		ds.b 2restpixel		 							;undo variable changes made by all pixels				lda saveoffset				;within a byte except the last				sta lineoffset				lda savedither				sta DitherH				rtsoneLpixel		 							;generating data for one pixel				phy							;save offset into pixelmap				stx pixelbits				;X=mask for this pixel within buffer				and #$000F					;A=pixel value				asl a						;convert into colortable index				ora ThisLPal				;add SCB palette-select-value				tay							;Y now has offset into color table for current pixel								ldx colorstr				;branch based on color/grayscale mode				cpx #s_printBW				bne colorLpix				bwLpix										;convert RGB to grayscale:				lda [CTablePtr],y			;obtain RGB value				and #$0FFF				xba				and #$000F					;R				sta colortemp				asl a				asl a						;4R				adc colortemp				sta colortemp				;5R				lda [CTablePtr],y				lsr a				and #%01111000				;8G				clc				adc colortemp				;5R+8G				tax				lda [CTablePtr],y				and #$000F					;B				sta colortemp				txa				eor #$FF					;255-5R-8G				sec				sbc colortemp				;255-5R-8G-B				sbc colortemp				;255-5R-8G-2B				sbc colortemp				;255-5R-8G-3B				and #%11110000				lsr a						;set A bits 3..6 to density value of 0..15 for patt plot				beq bwLpix_finish			;if zero, don't do 640-adjust below				ldx thisLmode				;check if 640 mode, if 640 (and black/white), use only				beq bwLpix_finish			;few of the levels to avoid beating with 640's dithering				cmp #%01111000				;if full density, don't do 640-adjust				beq bwLpix_finish				cmp #%00011000				;compare for light yellow				beq bwLpix_adj				cmp #%01101000				;compare for std screen light blue				bne bwLpix_finishbwLpix_adj		lda #%00101000				;substitute density for better				ldx hScaling				dex				beq bwLpix_finish1				lda #%00111000				;substitute density for standardbwLpix_finish	ldx #0						;set X to 0 for pattern plot routinebwLpix_finish1	brl gotLvaluecolorLpix						lda KCMY_lookup,y			;convert $0RGB to $KCMY with table				ldy colorstr				;branch based on color being printed				cpy #s_printyel				;and get proper K, C, M, or Y nibble				beq yelLpix				cpy #s_printmag				beq magLpix				cpy #s_printcyn				beq cynLpix				blkLpix							xba				lsr a						;set A bits 3..6 to density value				ldx #0						;set X for pattern plot routine				bra gotLvaluecynLpix							xba				asl a				asl a				asl a						;set A bits 3..6 to density value				ldx #3						;set X for pattern plot routine				bra gotLvaluemagLpix							lsr a						;set A bits 3..6 to density value				ldx #3						;set X for pattern plot routine				bra gotLvalueyelLpix			 				asl a				asl a				asl a						;set A bits 3..6 to density value				ldx #3						;set X for pattern plot routinegotLvalue		 							;A=print density, 0..15 * 8 (in bits %.XXXX...)				and #%01111000				;X=dither matrix offset, blk=0 CMY=3				sta colortemp				;(keeps black from overprinting color)				bne isLnonzeroisLzero										;save some work if density is zero				clc							;fake changes that would have been				lda DitherH					;made if this pixel printed				adc hScaling				sta DitherH				lda lineoffset				sec				sbc hScaling				sta lineoffset				bra LpixeldoneisLnonzero									;nonzero density, so "print" it into linebuffer...				lda #1						;prepare to store into pr pix linebuffer				sta LineDirty				txa							;calculate index into dither matrix				clc				adc DitherH					;"DitherH" increases with every printer pixel				and #%111					;use only low 3 bits to generate 0..7 index into matrix				ora colortemp				;make matrix offset (colortemp has select offset)				tax							;and put it in X for "oneLpixel1" pr pix plot routine				ldy hScaling				;branch based on horizonal printer-pix scaling				cpy #1				beq LpixelX1				cpy #2				beq LpixelX2LpixelX4		jsr oneLpixel1				;hScaling==4: four h printer dots per screen pixel				jsr oneLpixel1LpixelX2		jsr oneLpixel1				;hScaling==2: two h printer dots per screen pixelLpixelX1		jsr oneLpixel1				;hScaling==1: one h printer dot per screen pixelLpixeldone						ply				rtsoneLpixel1									;do stack pointer -6 to exit current line				inc DitherH					;X=dithmatrix offset				import Dithmatrix				lda Dithmatrix,x			;get dither pattern based on desired density and offset				inx							;advance to next byte of dither pattern				and pixelbits				;apply mask for this pixel				ldy lineoffset				;get offset into linebuffer				dey				bmi oneLp1done				;make sure we're still within buffer				ora LineBuffer,y			;OR masked pattern into buffer				sta LineBuffer,y				sty lineoffset				txa							;see if we need to wrap back to beginning of				and #%111					;current dither level				bne oneLp1done				sec							;do wrap to beginning of pattern for current dither level				txa				sbc #8				taxoneLp1done		rts*********************************************************************************SENDBUFF/IWCOMPRESSSEND:**The following routine sends data in line buffer to printer appropriately for IW 8-pin model.*The print-graphics commands are interspersed with positioning and/or run-length-encoding commands:*if a run of N or more identical groups of byte(s) is detected, then the print-multiple-graphics-*columns command is used for nonzero data, while the position-print-head command is used for a run*of zero data.*SendBuff:				lda LineDirty				;if no data, don't bother printing				beq noline				stz LineDirty				;initialize did-we-use-ink-yet flag				jsr IWCompressSend				lda LineDirty				;if no data was found, don't do CR				beq noline				lda #s_cr					;return to left margin for next band				jsr writeshortnoline			rtsIWCompressSend:cs_init			stz cs_curr_pos				;initialize logical head positions for scan...				stz cs_nor_start				stz cs_nor_end				stz cs_rle_start				stz cs_curr_stat			;init state: 0=normal, 1=maybe rle, 2=definetely rle				stz cs_rept_ctr				;init repeat counter for going from state 1 to state 2				lda LineBuffer+0			;init "last group" to be always different from 1st group				ina				sta cs_last_group+0		   cs_test			ldy cs_curr_pos				;do 1-BYTE compare...				shortm				lda LineBuffer,y				cmp cs_last_group				longm				bne cs_diff		   cs_same			lda cs_curr_stat			;current group is equal to group from last time...				cmp #2						;if state=2, do nothing				beq cs_next				cmp #1						;if state=1, see if time to go state 2 and do norm output				bne cs_same_0		   cs_same_1		inc cs_rept_ctr				;inc repeat count; if less than thresh, get next group				lda cs_rept_ctr				cmp #RunLenEncodeThreshIW-2				bcc cs_next				lda #2						;else, go to state 2 and do normal output				sta cs_curr_stat				ldx cs_nor_start			;do normal output from nor_start to nor_end-1...				ldy cs_nor_end				jsr cs_do_output_nor				bra cs_next		   cs_same_0		lda #1						;go to state 1, clr repeat ctr, set possible rept start				sta cs_curr_stat				stz cs_rept_ctr				lda cs_curr_pos				dea				sta cs_rle_start				bra cs_next		   cs_diff			lda cs_curr_stat			;current group is not equal to group from last time...				bne cs_diff_12				;we handle state 0 first since it's most common:		   cs_diff_0		lda cs_curr_pos				;diff/state 0: state stays 0, track nor_end with curr_pos				sta cs_nor_end				bra cs_next		   cs_diff_12		cmp #1				bne cs_diff_2		   cs_diff_1		stz cs_rept_ctr				;diff/state 1: state=0, clr ctr, track nor_end as above				stz cs_curr_stat				lda cs_curr_pos				sta cs_nor_end				bra cs_next		   cs_diff_2		stz cs_curr_stat			;diff/state 2: state=0, reset nor start/end, do rle out				lda cs_curr_pos				sta cs_nor_start				sta cs_nor_end				ldx cs_rle_start			;do rle output from rle_start to curr_pos-1...				ldy cs_curr_pos				jsr cs_do_output_rle		;do it, then drop thru to cs_nextcs_next			ldy cs_curr_pos				;next position: set last_group, increment, see if done...				shortm						;copy 1 BYTE from line buffer				lda LineBuffer,y				sta cs_last_group				longm		   cs_next_in		inc cs_curr_pos				;increment current position, loop until == crWidth...				lda cs_curr_pos				cmp crWidth				bcs cs_flush				brl cs_testcs_flush		lda cs_curr_stat			;final flush: check status...				cmp #2				beq cs_flush2		   cs_flush01		ldx cs_nor_start			;flush/stat=0 or 1: do nor out fr nor_start to curr_pos-1				ldy cs_curr_pos				jsr cs_do_output_nor				rts							;and exitcs_flush2		ldx cs_rle_start			;flush/stat=2: do rle output from rle_start to curr_pos-1				ldy cs_curr_pos				jsr cs_do_output_rle				rts							;and exit**Normal printer output command subroutine for IWCompressSend (from -> X, to -> Y):*cs_do_output_nor:							;from -> X, to -> Y				stx cs_num_output			;1) to=to-1   2) cs_num_output=to-from   3) if -1 exit				stx cs_frm_output				dey				tya				sec				sbc cs_num_output				cmp #$FFFF				beq cs_nor_xit				ina				sta cs_num_output		   				lda LineDirty				;have we ever pr yet on this IWCompressSend (head scan)?				bne cs_nor_ddone			;yes we have printed, so skip next few lines				lda #1						;else, mark for next time because we're about to use ink				sta LineDirty				lda ActionBits				;don't do color selection if on IW-One				and #abIsIWOne				bne cs_nor_ddone				lda colorstr				;select proper color ribbon before print first time				jsr writeshortcs_nor_ddone		   				pushword cs_num_output		;convert cs_num_output (the length) to ascii for command				pushlong #grstr				pushword #4				pushword #0				_Int2Dec		   				lda #s_graphics				;send command to print nonrepeating graphics				jsr writeshort		   		   cs_nor_blt		lda #LineBuffer				;send gr data, from=LB+cs_frm_output; len=cs_num_output				ldx #^LineBuffer				clc				adc cs_frm_output			;assuming no bank cross here				ldy cs_num_output				jsr writelong		   cs_nor_xit		rts**Run-length-encoding-posn pr output cmd subroutine for IWCompressSend (from -> X, to -> Y):*cs_do_output_rle:							;from -> X, to -> Y				stx cs_num_output			;1)to=to-1   2)cs_num_output=to-from   3)if 0 or -1 exit				stx cs_frm_output				dey				tya				sec				sbc cs_num_output				beq cs_rle_xit				cmp #$FFFF				beq cs_rle_xit				ina				sta cs_num_output		   		   				shortm						;check to see if first BYTE of the start group is zero				lda LineBuffer,x				longm				beq cs_rle_psn				;zero, so do positioning instead of graphics output		   cs_rle_rpt		lda LineBuffer+0,x			;store repeat group byte in cmd seq				shortm				sta rptdata+0				longm								lda LineDirty				;have we ever pr yet on this IWCompressSend (head scan)?				bne cs_rle_ddone			;yes we have printed, so skip next few lines				lda #1						;else, mark for next time because we're about to use ink				sta LineDirty				lda ActionBits				;don't do color selection if on IW-One				and #abIsIWOne				bne cs_rle_ddone				lda colorstr				;select proper color ribbon before print first time				jsr writeshortcs_rle_ddone		   				pushword cs_num_output		;convert number of prpix to print to ascii...				pushlong #rptstr				pushword #4				pushword #0				_Int2Dec		   				lda #s_repeating			;send command to print repeating graphics				jsr writeshort		   cs_rle_xit		rtscs_rle_psn		iny							;move print head to "to" prpix posn still in Y:				cpy crWidth					;if about to do posn to crWidth-1, don't do it; it is				beq cs_rle_xit				;inefficient and it doesn't like posn followed by nothing				phy							;convert to ascii; doing posn to "to"+1...				pushlong #posstr				pushword #4				pushword #0				_Int2Dec		   				lda #s_position				;send command to do head position				jsr writeshort				rts**Variables for IWCompressSend:*cs_curr_pos		dc.w	0					;curr headscan posn (logical posn; NOT LineBuffer index)cs_curr_stat	dc.w	0					;curr state: 0=normal; 1=rle candidate; 2=confirmed rlecs_nor_start	dc.w	0					;headscan logical posn of start of normal (non-rle) datacs_nor_end		dc.w	0					;headscan logical posn of end of normal datacs_rle_start	dc.w	0					;headscan logical posn of start of run for run-len-encodecs_rept_ctr		dc.w	0					;repeat count for run-length-encoding candidatecs_num_output	dc.w	0					;number of prpix to output, used by output subroutinescs_frm_output	dc.w	0					;value of "from" parameter, used by output subroutinescs_last_group	ds.b	3					;last group representing last logical head pin fire**Printer command sequences for CompressSend:*s_position		dc.b	6					;position-print-head command sequence				dc.b	$1B				dc.b	$46					;IW_II positioning commandposstr			dc.b	'0000's_repeating 	dc.b	7					;print-repeat-graphics command sequence				dc.b    $1B				dc.b	$56					;IW_II repeating-graphics commandrptstr			dc.b	'0000'rptdata			dc.b	0s_graphics		dc.b	6					;print-graphics command sequence (is followed by data)				dc.b	$1B				dc.b	$47					;IW_II graphics commandgrstr			dc.b	'0000's_cr			dc.b	1					;output-carriage-return command sequence				dc.b	$0D*********************************************************************************IDLEPROCABORTCHECK/IDLEPROCABORTERRCHECK:**Printer status, user abort, and idleproc callers. Should be called before any long data blast, after*unsuccessful I/O, or any request for change in connection status (such as PrDevOpen/Close calls).*The difference between the two calls is that IDLEPROCABORTCHECK does not include printer port*driver status call inquiry.**1. Does PrDevStatus call, and if (network) port driver error condition, sets prError and exits.*2. If the imager was passed a non-NIL idleproc, then save enviroment and execute it.  Note*   that the Option-Period-check will still execute after the idleproc finishes.*3. Check for Option-Period; if pressed, set prError and exit.  Note that this kind of exit*   code has precedence over (will override) any errors from the PrDevStatus call.*IdleProcAbortErrCheck:				stz status_buff+5			;clear status buff, for not all port drivers support it								pushlong #status_buff		;(*) do status call, which works best on networks...				ldx #$2013				jsl $E10000					;_PrDevStatus				bcc e_notdstat								pushlong #status_buff		;if error, try status call one more time				ldx #$2013				jsl $E10000					;_PrDevStatus				bcc e_notdstat								lda #$0081					;if err, exit with our communications-err result code				bra e_strerre_notdstat		   				lda status_buff+5			;get status word, if any, from bytes 5,6... this info				tax							;is from appletalk board in the printer, else it's zero								txa							;*** Printer Busy? ***				;     5432109876543210				and #%1000000000000000		;printer-busy flag				beq e_notbusy				lda is_our_conn				;printer busy AND we're not connected yet?				bne e_notbusy				;if so then someone else is using it				lda #$008F				bra e_strerr				;if so then exit with our printer-is-busy result codee_notbusy				txa							;*** Out Of Paper? ***				;     5432109876543210				and #%0000000000100000		;out-of-paper flag				beq e_notpapr				txa				;     5432109876543210				and #%0000000001000000		;has-feeder flag: if no paper b/c sheet feeder, no err				bne e_notpapr				lda #$0082				bra e_strerre_notpapr		   				txa							;*** Paper Jammed? ***				;     5432109876543210				and #%0000000000000100		;paper-jam flag				beq e_notjam				lda #$0083				bra e_strerre_notjam		   				txa							;*** Cover Open? ***				;     5432109876543210				and #%0000000000010000		;cover-open flag				beq e_notcvr				lda #$0084				bra e_strerre_notcvr		   				txa							;*** Select Switch Off? ***				;     5432109876543210				and #%0000000000001000		;select-off flag				beq e_continue				lda #$0085		   e_strerr		sta prErrore_continue		IdleProcAbortCheck:				lda IdleProcPtr+0			;(*) if NIL, user didn't specify idleproc				ora IdleProcPtr+2				beq no_iproc								lda IdleProcPtr+0			;else build JSL instruction to user...				sta goto_user+1				lda IdleProcPtr+2				shortm				sta goto_user+3				longm								phb							;save environment				phd		   goto_user		jsl $FFFFFF					;goto user procedure; I can't believe I'm doing this...				pld							;restore env; drop through to our command-period check				plb		   no_iproc		pha							;(*) now check if command-period was pressed				pushword #$0008				;keyDownMask				pushlong #eventrec				_GetNextEvent				pla				beq no_event								lda eventmsg				and #$00FF				cmp #'.'					;period				bne no_event								lda eventmod				and #$0100					;appleKey				beq no_event								lda #$0080					;this will overwrite/override any error obtained above				sta prErrorno_event				rtseventrec:eventwhat		ds.b 2eventmsg		ds.b 4eventwhen		ds.b 4eventwhere		ds.b 4eventmod		ds.b 2status_buff		ds.b 256					;yes, it has to be this big (we only get 2 bytes from it)											;status_buff+5 contains the following bits:											;0=head moving, 1=fault, 2=jam, 3=off line,											;4=cover open, 5=out of paper, 6=has feeder, 7=has color											;15=printer busy*******************************************************************************crWidth			ds.b 2						;carr width h pr pix; used for linebuff right justvScaling		ds.b 2						;printer dots per vertical pixelvInterlace		ds.b 2						;enable flag for vertical interlacehScaling		ds.b 2						;printer dots per horizontal pixel				export PrError				;allow high-level routines to abort imager from idleprocprError			ds.b 2						;error status ($80=abort; other codes possible)LineBuffer		ds.b 1*1280+2+24			;max 8.0", 160 dpi, 1 byte/column + BW6 alg overrunLineBufferEnd								;linebuffer length MUST be even!*******************************************************************************							endproc							end