*******************************************************************************************                                                                                        **		Apple IIgs New ImageWriter Printer Driver                                        **                                                                                        **		File: equates.aii -- Common direct page labels and equates for all to use        **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *********************************************************************************************Device and configuration information:*DeviceID					equ			1							;Device type (2=LQ, 1=IW, 3=LW)VersionID					equ			$0402						;Version ID word: $XXYY ==> X.Y**Human interface potentiometers:*StatusMesgDelay				equ			150							;Time of err status mesg (ticks)**Memory allocation performance potentiometers:*UserIDType					equ			$1000						;UID for mem alloc calls, etc.SpoolMemIncDefault			equ			2*1024						;Spool granularity of mallocsSpoolMemLeftLimitDefault	equ			135*1024					;Spool->Mem or Disk threshold**Communication performance potentiometers:*OutputFlowQuantumMin 		equ			25							;imager min # data to PrDevWriteOutputFlowQuantumMax 		equ			510							;imager max # data to PrDevWriteRunLenEncodeThreshIW		equ			8							;# groups at which rle is advant**QuickDraw-dependent equates:*QDMaxPixBuff				equ			$FFFF						;Maximum LocInfo.PtrToPixImageQDAuxTheKindDPLoc			equ			$A6							;contains kind of PicCommentQDAuxTheSizeDPLoc			equ			$A8							;contains size of PicCommentQDAuxTheHandleDPLoc			equ			$AA							;contains hdl to PicComment dataQDDrawVerbDPLoc				equ			$38							;"DrawVerb" quickdraw equateQDTextPtrDPLoc				equ			$DA							;"TextPtr" quickdraw equateQDTextLengthDPLoc			equ			$D8							;"TextLength" quickdraw equateQDCharToDrawDPLoc			equ			$D6							;"CharToDraw" quickdraw equateQDDrawCharVerbEqu			equ			0							;"DrawCharVerb" quickdraw equateQDDrawTextVerbEqu			equ			1							;"DrawTextVerb" quickdraw equateQDDrawCStrVerbEqu			equ			2							;"DrawCStrVerb" quickdraw equateov1							equ			0							;Point data structure elementoh1							equ			2							;Point data structure elementov2							equ			4							;Point data structure elementoh2							equ			6							;Point data structure element**QuickDraw PicComments that this driver listens to:*EndOfPagePicCommentKind		equ			250							;For marking next pic in spoolChangeCTBLPicCommentKind	equ			251							;For if app wants new color tblChangeSCBPicCommentKind		equ			252							;For if app wants new SCB(s)**Imagewriter metrics and low-level driver features:*Note that the wDev definition below is somewhat different from "QualBits" in the imager routine.*This was done to maintain some bit-compatibility with the old ImageWriter driver:*										;5432109876543210wDevNoStatusBox				equ			%1000000000000000			;15 1=no stat mesg box 0=normalwDevGap						equ 		%0000000001000000			;6	1=normal 0=no vert gapwDevColor					equ			%0000000000100000			;5	1=color 0=grayscalewDevReduction				equ			%0000000000001000			;3	1=normal 0=50% reductionwDevVSize					equ			%0000000000000100			;2	1=normal 0=vert condensewDevOrientation				equ			%0000000000000010			;1	1=portrait 0=landscapewDevBetterText				equ			%0000000000000001			;0	1=high resolution printing**New print record definitions for this driver, placed where "oprintX" used to be:*opFileBlockSize				equ			$64+0						;Granularity of spool mallocsopFileMemLimit				equ			$64+4						;When to start spooling to diskopCTable					equ			$64+8						;Color table for imagingopSCBList					equ			$64+12						;SCB list for imagingowQuality					equ			$64+16						;New print quality definitionsowPaperCrWidth				equ			$64+18						;Variable internal crWidth valueowResScaling				equ			$64+20						;Better-quality scaling value**Imaging routine/printer maximum resolutions.  These are starting points for metrics calculations:*maxResPortraitX				equ			160							;Printer pixels per inch (dpi)maxResPortraitY				equ			144maxResLandscapeX			equ			144maxResLandscapeY			equ			160printLineMargin				equ			4							;Left line margin in 1/16" unitspixMapCallCrWidth			equ			8*maxResPortraitX			;Carriage width for PrPixMap callpixMapCallPaperLength		equ			11*maxResPortraitY/2		;Paper tallness for PrPixMap callprRecCrWidth				equ			960							;historical value apps expect**The following paper dimensions are in 1/16th inch units--they are 16 times too big (for accuracy):*paperTypeUsaLetter			equ			0							;8.5 x 11"		1/4" gappaperSizeUsaLetterX			equ			136							;US Letter MUST be type 0paperSizeUsaLetterY			equ			176paperSizeUsaLetterGap		equ			4paperTypeUsaLegal			equ			1							;8.5 x 14"		1/4" gappaperSizeUsaLegalX			equ			136							;US Legal MUST be type 1paperSizeUsaLegalY			equ			224paperSizeUsaLegalGap		equ			4paperTypeEurA4				equ			2							;210 x 197mm	1/4" gappaperSizeEurA4X				equ			136							;Eur A4 MUST be type 2paperSizeEurA4Y				equ			187paperSizeEurA4Gap			equ			4paperTypeEurIntlFanfold		equ			3							;210 mm x 12"	1/4" gappaperSizeEurIntlFanfoldX	equ			136							;Intl FF MUST be type 3paperSizeEurIntlFanfoldY	equ			192paperSizeEurIntlFanfoldGap	equ			4paperTypeEurB5				equ			4							;176 x 250mm	1/4" gappaperSizeEurB5X				equ			110paperSizeEurB5Y				equ			157paperSizeEurB5Gap			equ			4paperTypeUsaStatement		equ			5							;5.5 x 8.5"		1/4" gappaperSizeUsaStatementX		equ			88paperSizeUsaStatementY		equ			136paperSizeUsaStatementGap	equ			4paperTypeEnvNo6				equ			6							;6.5 x 3.625"	1/4" gappaperSizeEnvNo6X			equ			104paperSizeEnvNo6Y			equ			58paperSizeEnvNo6Gap			equ			4paperTypeLblSml				equ			7							;3 x 0.9375"	1/4" gappaperSizeLblSmlX			equ			48paperSizeLblSmlY			equ			15+1						;+1/16" space b/w labelspaperSizeLblSmlGap			equ			4paperTypeLblMed				equ			8							;3.5 x 0.9375"	1/4" gappaperSizeLblMedX			equ			56paperSizeLblMedY			equ			15+1						;+1/16" space b/w labelspaperSizeLblMedGap			equ			4paperTypeLblLrg				equ			9							;4 x 1.4375"	1/4" gappaperSizeLblLrgX			equ			64paperSizeLblLrgY			equ			23+1						;+1/16" space b/w labelspaperSizeLblLrgGap			equ			4paperTypeLblPacking			equ			10							;4 x 2.9375"	1/4" gappaperSizeLblPackingX		equ			64paperSizeLblPackingY		equ			47+1						;+1/16" space b/w labelspaperSizeLblPackingGap		equ			4paperTypeLblDisk35			equ			11							;2.75 x 2.75"	1/4" gappaperSizeLblDisk35X			equ			44paperSizeLblDisk35Y			equ			44+4						;+1/4" space b/w labelspaperSizeLblDisk35Gap		equ			4paperTypeLblDisk525			equ			12							;4.75 x 1.25"	1/4" gappaperSizeLblDisk525X		equ			76paperSizeLblDisk525Y		equ			20+4						;+1/4" space b/w labelspaperSizeLblDisk525Gap		equ			4maxPaperTypeID				equ			paperTypeLblDisk525			;NOTE: LENGTH OF THIS LIST!**Dialog boxes' item ID numbers... MUST be consecutive within groupings:*mesgFeedPromptID			equ			10000						;for status message alertmesgFeedPromptOKButtID		equ			1							;for default <CR> actionmesgFeedPromptNGButtID		equ			10001mesgFeedPromptStringID		equ			10002titleItemID					equ			10100						;for both Job and Style dialogsversionItemID				equ			10101cancelItemID				equ			10102okItemID					equ			10103paperTypeItemID				equ			11000						;for Style dialogpaperTypeUsaLtrItemID		equ			12000+paperTypeUsaLetterpaperTypeUsaLglItemID		equ			12000+paperTypeUsaLegalpaperTypeEurA4ItemID		equ			12000+paperTypeEurA4paperTypeEurIntlFFItemID	equ			12000+paperTypeEurIntlFanfoldpaperTypeEurB5ItemID		equ			12000+paperTypeEurB5paperTypeUsaStmtItemID		equ			12000+paperTypeUsaStatementpaperTypeEnvNo6ItemID		equ			12000+paperTypeEnvNo6paperTypeLblSmlItemID		equ			12000+paperTypeLblSmlpaperTypeLblMedItemID		equ			12000+paperTypeLblMedpaperTypeLblLrgItemID		equ			12000+paperTypeLblLrgpaperTypeLblPackingItemID	equ			12000+paperTypeLblPackingpaperTypeLblDisk35ItemID	equ			12000+paperTypeLblDisk35paperTypeLblDisk525ItemID	equ			12000+paperTypeLblDisk525reductionItemID				equ			13000						;for Style dialogreductionFullSizeItemID		equ			13001reduction50ItemID			equ			13002effectsNoGapsItemID			equ			13003effectsCondensedItemID		equ			13004orientationTitleItemID		equ			13005orientationPortraitItemID	equ			13006orientationLandscapeItemID	equ			13007effectsTitle1ItemID			equ			13008printQualityItemID			equ			14000						;for Job dialogprintQualityDraftItemID		equ			14001printQualityFasterItemID	equ			14002printQualityStandardItemID	equ			14003printQualityBetterItemID	equ			14004chromaItemID				equ			15000chromaMonochromeItemID		equ			15001chromaColorItemID			equ			15002pageFeedItemID				equ			15003pageFeedManualItemID		equ			15004pageFeedAutoItemID			equ			15005pagesTitleItemID			equ			15006pagesAllItemID				equ			15007pagesRangeItemID			equ			15008pagesFromTitleItemID		equ			15009pagesToTitleItemID			equ			15010copiesTitleItemID			equ			15011pagesFromBoxItemID			equ			15012pagesToBoxItemID			equ			15013copiesBoxItemID				equ			15014**Temporary zero page storage which is NOT maintained across driver calls or driver re-entries:*ParamWordA					equ			0					;general purpose and parameter passingParamWordB					equ			2ParamWordC					equ			4ParamWordD					equ			6ParamWordE					equ			8ParamLongA					equ			10ParamLongB					equ			14ParamLongC					equ			18DialogWindowPtr				equ			22					;grafport pointer for job/style dialogsOldGrafPortPtr				equ			26					;saving grafport behind job/style dialogserrNo						equ			30					;tool err returned from our driver callsprintRecordHandle			equ			32					;must be valid for calling metrics codeprintGrafPortPtr			equ			36					;paper-sized grafport used for printingpageFramePtr				equ			40					;page frame passed by user for scalingstatusRecPtr				equ			44					;status rec updated during PrPicfileOptionA						equ			48					;for passing options to metrics routinesOptionB						equ			50ImagerDP					equ			52					;Imager routine needs 74 bytes dpage															;Total DP Size: 74+52=126 < 128DPSize						equ			127+1				;DP size on stack; <256 b/c stack params!DPSizeParamOnly				equ			DialogWindowPtr+1	;DP size for just using some params only