*******************************************************************************************                                                                                        **		Apple IIgs ImageWriter LQ Printer Driver                                         **                                                                                        **		File: entry.aii -- Entry Points; environment (D/B) setup; dispatch to routines   **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1989 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.aii'																					include		'm16.util'							include		'm16.memory'							include		'e16.print'														EntryProc					proc		export**New (Apple IIgs System Disk 5.0 and later), re-entrant, driver entry point:*Entry						dc.w		0							dc.w		(DispatchEnd-DispatchBegin)/4**Save/Set Bank and Direct registers (D page; B=K), assume no errors, dispatch to routines:*							phb									;Save B byte for later restore							phd									;Save D word for later restore							cpx			#((17-1)*4)+1			;See if call # is in range							bcc			Entry1							brk			#$BB					;Should never happenEntry1						tsc							sec							sbc			#DPSize					;Stack frame for small direct page							tcsStackParam					equ			1+3+3+1+2+DPSize		;1 + RTL1 + RTL2 + B + D + StackFrame							ina							tcd									;Set our D to our stack frame							phk							plb									;Set our B; now can use abs addr							stz			errNo					;Assume no error unless set later on							jmp			(DispatchBegin,x)		;Go do one of our routines														**Dispatch table:*DispatchBegin											dc.l		LQ_PrDefault							dc.l		LQ_PrValidate							dc.l		LQ_PrStlDialog							dc.l		LQ_PrJobDialog							dc.l		LQ_PrDriverVer							dc.l		LQ_PrOpenDoc							dc.l		LQ_PrCloseDoc							dc.l		LQ_PrOpenPage							dc.l		LQ_PrClosePage							dc.l		LQ_PrPicFile							dc.l		LQ_Reserved				;Reserved							dc.l		LQ_PrError							dc.l		LQ_PrSetError							dc.l		LQ_PrChanged			;Internal call (not from app)							dc.l		LQ_PrPixelMap							dc.l		LQ_PrGetPrinterSpecs							dc.l		LQ_PrGetPgOrientationDispatchEnd**EXIT: Jump here when done doing driver call.*After removing direct page stack frame, this routine moves 9 bytes at bottom of stack X number*of bytes up, restores D/B, leaves A and carry with error status, and RTLs.  Note that 2 RTLs are*assumed to be on the stack.*Exit						tsc									;Get rid of our little scratch area							clc							adc			#DPSize							tcs	 						cpx			#0						;Have to do this compare for 0							beq			Exit3							stx			TmpNumMov							tsc							sta			Exit1+1							clc							adc			TmpNumMov							sta			Exit2+1							push1		#0							plb									;Our data bank is 0 at this point							ldy			#8						;9+(0 because we're JMPed-to) - 1Exit1						lda			$FFFF,yExit2						sta			$FFFF,y							dey							dey							bpl			Exit1							phk							plb							lda			Exit2+1							tcs									;S restoredExit3						lda			errNo					;get errNo for use in a sec...							pld									;D restored--no more direct addrs							plb									;B restored--no more absolute addrs							cmp			#1						;ACC has err... set carry if nonzero							rtl									;Exit back to print manager*TmpNumMov					dc.w		0						;Temporary storage used above******************************************************************************************************The following routines do all the work of the printer driver, or at least contain JSRs to*routines in other files.  The following has happened on entry to these routines:**		* The caller's D/B registers have been saved*		* The D register is the same as the K register so absolute adressing can be used*		* The B register points to DPSize free bytes on the stack for scratch usage*		* "errNo" has been set to zero, assuming no errors from the routine*		* Since caller's environment was saved on stack, the driver is re-entrant.**These routines should do their work by:**		* Accessing input/output parameters on the stack by means of LDx/STx StackParam+N,s,*		  where the N refers to the relative offset (ie, 0,2,4 would be 3 words on the stack)*		* Using our small direct page area, JSRing to other assembly files, using the stack*		* Changing "errNo" to be nonzero if error flagging is desired*		* Calling routines in this driver if desired (some port driver calls actually do this)*		* LDX #N, where N is the number of input parameter bytes used by the routine*		* JMP/BRL Exit.**The exit routine will then:**		* Dump our small direct page off of the stack*		* Dump input parameters off of the stack*		* Restore the caller's D/B registers from stack*		* Set the A register with value of "errNo" and set the carry if nonzero*		* Exit via RTL.*****************************************************************************************************LQ_Reserved					ldx			#2						;$0002 - Tool Locator func not found							stx			errNo*							ldx			#0						;assume no bytes to strip off stack							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrDefault				lda			StackParam+0,s			;This routine fills in the users							sta			printRecordHandle+0		;area of memory with a default							lda			StackParam+2,s			;print record with standard options							sta			printRecordHandle+2*							import		InitPrintRecord							jsr			InitPrintRecord			;Metrics routine*							ldx			#4						;# of input param bytes to strip							brl			Exit****************************************************************************************************																					****************************************************************************************************LQ_PrValidate				lda			StackParam+0,s			;This routine checks to make sure							sta			printRecordHandle+0		;the user's print record is							lda			StackParam+2,s			;self-consistent and up to date,							sta			printRecordHandle+2		;and changes it if necessary*							import		GetOkOurDriver							jsr			GetOkOurDriver			;Metrics: Same driver as last time?							beq			PrVaAllCorrect			;wow, this print record is perfect							import		InitPrintRecord							jsr			InitPrintRecord			;take over print record for us							lda			#1						;recAdjustFlag := true							bra			PrVaExit							import		CalcMetricsPrVaAllCorrect				jsr			CalcMetrics				;make sure self-consistent							lda			#0						;recAdjustFlag := false*PrVaExit					sta			StackParam+4,s			;store recAdjustFlag result							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrStlDialog				lda			StackParam+0,s			;This routine uses data in the							sta			printRecordHandle		;user's print record to properly							lda			StackParam+2,s			;draw a dialog, and allows the							sta			printRecordHandle+2		;user to modify that data*							import		GetOkOurDriver			;ensure a valid rec for this driver							jsr			GetOkOurDriver			;Metrics: Same driver as last time?							beq			PrStAllCorrect			;wow, this print record is perfect							import		InitPrintRecord			;not same driver as last time, so...							jsr			InitPrintRecord			;...take over print record for us							import		CalcMetricsPrStAllCorrect				jsr			CalcMetrics				;make sure self-consistent, though*							import		CheckAndDoAboutBox		;do about box if requested...							jsr			CheckAndDoAboutBox							import		ConductStyleDialog		;go do the dialog, ACC will have...							jsr			ConductStyleDialog		;value for confirmFlag*							sta			StackParam+4,s			;return confirmFlag to user							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrJobDialog				lda			StackParam+0,s			;This routine is like PrStlDialog,							sta			printRecordHandle		;but should be called just before							lda			StackParam+2,s			;doing the print loop.							sta			printRecordHandle+2*							import		GetOkOurDriver			;ensure a valid rec for this driver							jsr			GetOkOurDriver			;Metrics: Same driver as last time?							beq			PrJoAllCorrect			;wow, this print record is perfect							import		InitPrintRecord			;not same driver as last time, so...							jsr			InitPrintRecord			;...take over print record for us							import		CalcMetricsPrJoAllCorrect				jsr			CalcMetrics				;make sure self-consistent, however*							import		CheckAndDoAboutBox		;do about box if requested...							jsr			CheckAndDoAboutBox							import		ConductJobDialog		;do it, ACC will have value...							jsr			ConductJobDialog		;for confirmFlag*							sta			StackParam+4,s			;return confirmFlag to user							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrDriverVer				lda			#VersionID				;This routine returns the version							sta			StackParam+0,s			;number of this particular driver*							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrOpenDoc				lda			StackParam+0,s			;This routine clears error status,							sta			printGrafPortPtr		;and initializes and sets a GrafPort							lda			StackParam+2,s			;with boundsrect, etc., configured							sta			printGrafPortPtr+2		;for the resolution of the printer.							lda			StackParam+4,s			;If printGrafPtr is NIL, we allocate							sta			printRecordHandle		;our own space, else we use the							lda			StackParam+6,s			;caller's GrafPort and configure it.							sta			printRecordHandle+2*							import		OpenDoc							jsr			OpenDoc					;print loop routine*							lda			printGrafPortPtr		;pass GrafPort back to user,							sta			StackParam+8,s			;in case we allocated it here...							lda			printGrafPortPtr+2							sta			StackParam+10,s							ldx			#8						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrCloseDoc				lda			StackParam+0,s			;this routine closes the printing							sta			printGrafPortPtr		;grafport, frees its memory if the							lda			StackParam+2,s			;caller passed NIL during OpenDoc,							sta			printGrafPortPtr+2		;restores grafport and stops spooling*							import		CloseDoc							jsr			CloseDoc				;print loop routine*							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrOpenPage				lda			StackParam+0,s			;this routine keeps track of #pages							sta			pageFramePtr			;and works only if within page range							lda			StackParam+2,s			;this routine calls OpenPicture with							sta			pageFramePtr+2			;pageframe of rPage or user-select							lda			StackParam+4,s			;the current (print) grafport is							sta			printGrafPortPtr		;re-initialized, and SpoolPut is							lda			StackParam+6,s			;called explicitly to store initial							sta			printGrafPortPtr+2		;info PutPic doesn't get called for*							import		OpenPage							jsr			OpenPage				;print loop routine*							ldx			#8						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************							import		ClosePage				;This routine terminates a pageLQ_PrClosePage				jsr			ClosePage				;print loop routine*							ldx			#4						;# of input param bytes to strip							brl			Exit					;(we didn't need input parameters)********************************************************************************************************************************************************************************************************LQ_PrPicFile				lda			StackParam+0,s			;This routine plays back the							sta			statusRecPtr			;spooled QD picture, one page at							lda			StackParam+2,s			;a time (handling all inter-page							sta			statusRecPtr+2			;activities) to the correct bin,							lda			StackParam+4,s			;doing PixelMap.							sta			printGrafPortPtr							lda			StackParam+6,s								sta			printGrafPortPtr+2							lda			StackParam+8,s							sta			printRecordHandle							lda			StackParam+10,s							sta			printRecordHandle+2*							import		PicFile							jsr			PicFile					;print loop routine*							ldx			#12						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************							import		GetPrintLoopErrorLQ_PrError					jsr			GetPrintLoopError		;err in acc from print loop routine							sta			StackParam+0,s							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************							import		SetPrintLoopErrorLQ_PrSetError				lda			StackParam+0,s			;get in acc							jsr			SetPrintLoopError		;print loop routine							ldx			#2						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrChanged				pushlong	#DeviceNameStr			;Informs port driver of type of							ldx			#$1913					;device; important for networking							jsl			$E10000					;_PrDevPrChanged							ldx			#0						;# of input param bytes to strip							brl			Exit					;we're doneDeviceNameStr				str			'='						;ID string in appletalk NBP format							str			'LQ'							str			'*'********************************************************************************************************************************************************************************************************LQ_PrPixelMap				lda			StackParam+0,s			;get...			;This routine calls							sta			ParamWordA				;colorFlag		;the imaging routine							lda			StackParam+2,s			;get...			;without any hi-level							sta			ParamLongA				;srcRectPtr lo	;support of printing							lda			StackParam+4,s			;get...			;loop; just chooses							sta			ParamLongA+2			;srcRectPtr hi	;default options ex-							lda			StackParam+6,s			;get...			;cept color/BW, and							sta			ParamLongB				;srcLocPtr lo	;prints "srcRectPtr"							lda			StackParam+8,s			;get...			;part of the caller's							sta			ParamLongB+2			;srcLocPtr hi	;pxmap in "srcLocPtr"*							pha									;Abort if no port. Result space...							ldx			#$3013					;ask currently installed port driver							jsl			$E10000					;_DevIsItSafe							pla							bne			PiMaOkDevice			;true result: no error							lda			#portNotOn				;else: return with tool error							sta			errNo							bra			PiMaExitPiMaOkDevice				pushlong	ParamLongB				;pass srcLocP							pushlong	ParamLongA				;pass srcRectP							pushlong	#$E19E00				;hardcoded colortbl. better way?!!							pushlong	#$E19D00				;hardcoded scb's. better way?!!							pushword	#pixMapCallCrWidth		;carriage width							pushword	#pixMapCallPaperLength	;paper length							;			  5432109876543210							pushword	#%0000010000000000		;default ActionBits except IW=on							lda			#0						;default QualityBits except...							ldx			ParamWordA				;get color flag							beq			PiMaNoColor				;if zero no color							ora			#%1000000000000000		;set color option in QualityBits	PiMaNoColor					pha									;pass QualityBits							pushlong	#0						;default idleproc							import		Imager							jsl			Imager					;go print							bcc			PiMaExit				;no error happened; exit							sta			errNo					;return error as tool call error*PiMaExit					ldx			#10						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrGetPrinterSpecs		pushlong	#0						;find out   ;dummy pix locinfo ptr							pushlong	#0						;whether we ;dummy pix-pr rect ptr							pushlong	#0						;have       ;dummy color table ptr							pushlong	#0						;color      ;dummy scb list ptr							pushword	#0						;ribbon...  ;dummy carriage width							pushword	#0						;			;dummy paper length							pushword	#%0000000010100001		;ActionBits: ask for ID only							pushword	#0						;dummy QualityBits (feature select)							pushlong	#0						;no idleproc; quit stat ignored here							import		Imager					;call imager, sends command to							jsl			Imager					;printer							tax									;save ID state for a second...							and			#%0000000000000001		;if bit 0 set then it's an LQ							beq			PrSpPassPrType			;if cleared, return zero							lda			#DeviceID		 		;else, our LQ device identificationPrSpPassPrType				sta			StackParam+0,s			;pass printerType to application							txa									;recover ID state again...							and			#%0000000000000010		;if bit 1 set then has color ribbon							bne			PrSpPassColorCap		;if set, return two							lda			#1						;else, return onePrSpPassColorCap			sta			StackParam+2,s			;pass characteristics to application							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************LQ_PrGetPgOrientation		lda			StackParam+0,s			;This routine returns the value							sta			printRecordHandle		;of the orientation setting just							lda			StackParam+2,s			;to try to keep the application out							sta			printRecordHandle+2		;of the print record*							import		GetOrientation							jsr			GetOrientation			;Metrics routine							sta			StackParam+4,s*							ldx			#4						;# of input param bytes to strip							brl			Exit****************************************************************************************************							endproc							end