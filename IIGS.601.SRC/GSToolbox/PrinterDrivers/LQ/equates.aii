*******************************************************************************************                                                                                        **		Apple IIgs ImageWriter LQ Printer Driver                                         **                                                                                        **		File: equates.aii -- Common direct page labels and equates for all to use        **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1989 Apple Computer, Inc.                                          **                                                                                        *********************************************************************************************Device and configuration information:*DeviceID					equ			2							;Device type (2=LQ, 1=IW, 3=LW)VersionID					equ			$0402						;Version ID word: $XXYY ==> X.Y**Human interface potentiometers:*StatusMesgDelay				equ			150							;Time of err status mesg (ticks)**Memory allocation performance potentiometers:*UserIDType					equ			$1000						;UID for mem alloc calls, etc.SpoolMemIncDefault			equ			2*1024						;Spool granularity of mallocsSpoolMemLeftLimitDefault	equ			135*1024					;Spool->Mem or Disk threshold**Communication performance potentiometers:*OutputFlowQuantum			equ			510							;imager max data to PrDevWriteRunLenEncodeThreshIW		equ			8							;# groups at which rle is advantRunLenEncodeThreshLQ		equ			4							;# groups at which rle is advant**QuickDraw-dependent equates:*QDMaxPixBuff				equ			$FFFF						;Maximum LocInfo.PtrToPixImageQDAuxTheKindDPLoc			equ			$A6							;contains kind of PicCommentQDAuxTheSizeDPLoc			equ			$A8							;contains size of PicCommentQDAuxTheHandleDPLoc			equ			$AA							;contains hdl to PicComment dataQDDrawVerbDPLoc				equ			$38							;"DrawVerb" quickdraw equateQDTextPtrDPLoc				equ			$DA							;"TextPtr" quickdraw equateQDTextLengthDPLoc			equ			$D8							;"TextLength" quickdraw equateQDCharToDrawDPLoc			equ			$D6							;"CharToDraw" quickdraw equateQDDrawCharVerbEqu			equ			0							;"DrawCharVerb" quickdraw equateQDDrawTextVerbEqu			equ			1							;"DrawTextVerb" quickdraw equateQDDrawCStrVerbEqu			equ			2							;"DrawCStrVerb" quickdraw equateov1							equ			0							;Point data structure elementoh1							equ			2							;Point data structure elementov2							equ			4							;Point data structure elementoh2							equ			6							;Point data structure element**QuickDraw PicComments that this driver listens to:*EndOfPagePicCommentKind		equ			250							;For marking next pic in spoolChangeCTBLPicCommentKind	equ			251							;For if app wants new color tblChangeSCBPicCommentKind		equ			252							;For if app wants new SCB(s)**Imagewriter LQ metrics and low-level driver features:*Note that the wDev definition below is somewhat different from "QualBits" in the imager routine.*This was done to maintain some bit-compatibility with the ImageWriter:*										;5432109876543210wDevNoStatusBox				equ			%1000000000000000			;15 1=no status mesg 0=normalwDevDarker					equ			%0001000000000000			;12 1=boldface printingwDevFirstBinMsb				equ			%0000100000000000			;11 Cut sheet bin selection for...wDevFirstBinLsb				equ			%0000010000000000			;10 first page printed 0..2wDevNextBinMsb				equ			%0000001000000000			;9  Cut sheet bin selection for...wDevNextBinLsb				equ			%0000000100000000			;8  ...remaining pages 0..2wDevUnidirectional			equ			%0000000010000000			;7  1=unidrectional printingwDevGap						equ 		%0000000001000000			;6	1=normal 0=no vert gapwDevColor					equ			%0000000000100000			;5	1=color 0=grayscalewDevReductionMsb			equ			%0000000000010000			;4	H/V reduction in 1/3 size...wDevReductionLsb			equ			%0000000000001000			;3	...inc, 0=fullsize, 0..2wDevVSize					equ			%0000000000000100			;2	1=normal 0=vert condensewDevOrientation				equ			%0000000000000010			;1	1=portrait 0=landscapewDevBetterText				equ			%0000000000000001			;0	1=high resolution printing**New print record definitions for this driver, placed where "oprintX" used to be:*opFileBlockSize				equ			$64+0						;Granularity of spool mallocsopFileMemLimit				equ			$64+4						;When to start spooling to diskopCTable					equ			$64+8						;Color table for imagingopSCBList					equ			$64+12						;SCB list for imagingowQuality					equ			$64+16						;New print quality definitionsowPaperCrWidth				equ			$64+18						;Variable internal crWidth valueowResScaling				equ			$64+20						;Scaling amount for Bett quality**Imaging routine/printer maximum resolutions.  These are starting points for metrics calculations:*maxResPortraitX				equ			240							;Printer pixels per inch (")maxResPortraitY				equ			216maxResLandscapeX			equ			216maxResLandscapeY			equ			192printLineMargin				equ			4							;Left line margin in 1/16" unitspixMapCallCrWidth			equ			1920						;8.0"*maxResPortraitXpixMapCallPaperLength		equ			792							;11.0"*72(eff.Y.resolution)prRecCrWidth				equ			960							;historical value apps expect**The following paper dimensions are in 1/16th inch units--they are 16 times too big (for accuracy):*paperTypeUsaLetter			equ			0							;8.5 x 11"		1/4" gappaperSizeUsaLetterX			equ			136							;US Letter MUST be type 0paperSizeUsaLetterY			equ			176paperSizeUsaLetterGap		equ			4paperTypeUsaLegal			equ			1							;8.5 x 14"		1/4" gappaperSizeUsaLegalX			equ			136							;US Legal MUST be type 1paperSizeUsaLegalY			equ			224paperSizeUsaLegalGap		equ			4paperTypeEurA4				equ			2							;210 x 197mm	1/4" gappaperSizeEurA4X				equ			136							;Eur A4 MUST be type 2paperSizeEurA4Y				equ			187paperSizeEurA4Gap			equ			4paperTypeEurIntlFanfold		equ			3							;210 mm x 12"	1/4" gappaperSizeEurIntlFanfoldX	equ			136							;Intl FF MUST be type 3paperSizeEurIntlFanfoldY	equ			192paperSizeEurIntlFanfoldGap	equ			4paperTypeEurB5				equ			4							;176 x 250mm	1/4" gappaperSizeEurB5X				equ			110paperSizeEurB5Y				equ			157paperSizeEurB5Gap			equ			4paperTypeBigComputer		equ			5							;14 x 11"		1/4" gappaperSizeBigComputerX		equ			224paperSizeBigComputerY		equ			176paperSizeBigComputerGap		equ			4paperTypeBigLedger			equ			6							;11 x 17"		1/4" gappaperSizeBigLedgerX			equ			176paperSizeBigLedgerY			equ			272paperSizeBigLedgerGap		equ			4paperTypeBigIntlA3			equ			7							;297 x 429mm	1/4" gappaperSizeBigIntlA3X			equ			187paperSizeBigIntlA3Y			equ			264paperSizeBigIntlA3Gap		equ			4paperTypeUsaStatement		equ			8							;5.5 x 8.5"		1/4" gappaperSizeUsaStatementX		equ			88paperSizeUsaStatementY		equ			136paperSizeUsaStatementGap	equ			4paperTypeBigNews			equ			9							;13.75 x 23"	1" gappaperSizeBigNewsX			equ			220paperSizeBigNewsY			equ			368paperSizeBigNewsGap			equ			16paperTypeEnvNo10			equ			10							;9.5 x 4.125"	1/4" gappaperSizeEnvNo10X			equ			152paperSizeEnvNo10Y			equ			66paperSizeEnvNo10Gap			equ			4paperTypeEnvNo9				equ			11							;8.875 x 3.875"	1/4" gappaperSizeEnvNo9X			equ			142paperSizeEnvNo9Y			equ			62paperSizeEnvNo9Gap			equ			4paperTypeEnvNo6				equ			12							;6.5 x 3.625"	1/4" gappaperSizeEnvNo6X			equ			104paperSizeEnvNo6Y			equ			58paperSizeEnvNo6Gap			equ			4paperTypeLblSml				equ			13							;3 x 0.9375"	1/4" gappaperSizeLblSmlX			equ			48paperSizeLblSmlY			equ			15+1						;+1/16" space b/w labelspaperSizeLblSmlGap			equ			4paperTypeLblMed				equ			14							;3.5 x 0.9375"	1/4" gappaperSizeLblMedX			equ			56paperSizeLblMedY			equ			15+1						;+1/16" space b/w labelspaperSizeLblMedGap			equ			4paperTypeLblLrg				equ			15							;4 x 1.4375"	1/4" gappaperSizeLblLrgX			equ			64paperSizeLblLrgY			equ			23+1						;+1/16" space b/w labelspaperSizeLblLrgGap			equ			4paperTypeLblPacking			equ			16							;4 x 2.9375"	1/4" gappaperSizeLblPackingX		equ			64paperSizeLblPackingY		equ			47+1						;+1/16" space b/w labelspaperSizeLblPackingGap		equ			4paperTypeLblDisk35			equ			17							;2.75 x 2.75"	1/4" gappaperSizeLblDisk35X			equ			44paperSizeLblDisk35Y			equ			44+4						;+1/4" space b/w labelspaperSizeLblDisk35Gap		equ			4paperTypeLblDisk525			equ			18							;4.75 x 1.25"	1/4" gappaperSizeLblDisk525X		equ			76paperSizeLblDisk525Y		equ			20+4						;+1/4" space b/w labelspaperSizeLblDisk525Gap		equ			4maxPaperTypeID				equ			paperTypeLblDisk525			;NOTE: LENGTH OF THIS LIST!**Dialog boxes' item ID numbers... MUST be consecutive within groupings:*mesgFeedPromptID			equ			10000						;for status message alertmesgFeedPromptOKButtID		equ			1							;for default <CR> actionmesgFeedPromptNGButtID		equ			10001mesgFeedPromptStringID		equ			10002titleItemID					equ			10100						;for both Job and Style dialogsversionItemID				equ			10101cancelItemID				equ			10102okItemID					equ			10103paperTypeItemID				equ			11000						;for Style dialogpaperTypeUsaLtrItemID		equ			12000+paperTypeUsaLetter	;these are not in num. orderpaperTypeUsaLglItemID		equ			12000+paperTypeUsaLegalpaperTypeUsaStmtItemID		equ			12000+paperTypeUsaStatementpaperTypeEurA4ItemID		equ			12000+paperTypeEurA4paperTypeEurB5ItemID		equ			12000+paperTypeEurB5paperTypeEurIntlFFItemID	equ			12000+paperTypeEurIntlFanfoldpaperTypeBigCompItemID		equ			12000+paperTypeBigComputerpaperTypeBigLgrItemID		equ			12000+paperTypeBigLedgerpaperTypeBigIntlA3ItemID	equ			12000+paperTypeBigIntlA3paperTypeBigNewsItemID		equ			12000+paperTypeBigNewspaperTypeEnvNo10ItemID		equ			12000+paperTypeEnvNo10paperTypeEnvNo9ItemID		equ			12000+paperTypeEnvNo9paperTypeEnvNo6ItemID		equ			12000+paperTypeEnvNo6paperTypeLblSmlItemID		equ			12000+paperTypeLblSmlpaperTypeLblMedItemID		equ			12000+paperTypeLblMedpaperTypeLblLrgItemID		equ			12000+paperTypeLblLrgpaperTypeLblPackingItemID	equ			12000+paperTypeLblPackingpaperTypeLblDisk35ItemID	equ			12000+paperTypeLblDisk35paperTypeLblDisk525ItemID	equ			12000+paperTypeLblDisk525reductionItemID				equ			13000						;for Style dialogreductionFullSizeItemID		equ			13001reduction33ItemID			equ			13002reduction66ItemID			equ			13003effectsNoGapsItemID			equ			13004effectsCondensedItemID		equ			13005effectsDarkerItemID			equ			13006effectsUnidirectItemID		equ			13007orientationTitleItemID		equ			13008orientationPortraitItemID	equ			13009orientationLandscapeItemID	equ			13010effectsTitle1ItemID			equ			13011effectsTitle2ItemID			equ			13012printQualityItemID			equ			14000						;for Job dialog...printQualityDraftItemID		equ			14001printQualityStandardItemID	equ			14002printQualityBetterItemID	equ			14003chromaItemID				equ			15000chromaMonochromeItemID		equ			15001chromaColorItemID			equ			15002pageFeedItemID				equ			15003pageFeedManualItemID		equ			15004pageFeedAutoItemID			equ			15005firstPageItemID				equ			15006firstPageBin1ItemID			equ			15007firstPageBin2ItemID			equ			15008firstPageBin3ItemID			equ			15009otherPagesItemID			equ			15010otherPagesBin1ItemID		equ			15011otherPagesBin2ItemID		equ			15012otherPagesBin3ItemID		equ			15013pagesTitleItemID			equ			15014pagesAllItemID				equ			15015pagesRangeItemID			equ			15016pagesFromTitleItemID		equ			15017pagesToTitleItemID			equ			15018copiesTitleItemID			equ			15019pagesFromBoxItemID			equ			15020pagesToBoxItemID			equ			15021copiesBoxItemID				equ			15022**Temporary zero page storage which is NOT maintained across driver calls or driver re-entries:*ParamWordA					equ			0					;general purpose and parameter passingParamWordB					equ			2ParamWordC					equ			4ParamWordD					equ			6ParamWordE					equ			8ParamLongA					equ			10ParamLongB					equ			14ParamLongC					equ			18DialogWindowPtr				equ			22					;grafport pointer for job/style dialogsOldGrafPortPtr				equ			26					;saving grafport behind job/style dialogserrNo						equ			30					;tool err returned from our driver callsprintRecordHandle			equ			32					;must be valid for calling metrics codeprintGrafPortPtr			equ			36					;paper-sized grafport used for printingpageFramePtr				equ			40					;page frame passed by user for scalingstatusRecPtr				equ			44					;status rec updated during PrPicFileOptionA						equ			48					;for passing options to metrics routinesOptionB						equ			50ImagerDP					equ			52					;Imager routine needs 74b direct page															;Total DP Size: 74+52=126 < 128														DPSize						equ			127+1				;DP size on stack; <256 b/c stack params!DPSizeParamOnly				equ			DialogWindowPtr+1	;DP size for just using some params only