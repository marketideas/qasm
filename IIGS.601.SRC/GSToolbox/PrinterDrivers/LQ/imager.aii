*******************************************************************************************                                                                                        **		Apple IIgs ImageWriter LQ Printer Driver                                         **                                                                                        **		File: imager.aii -- Low Level Driver: Pixmap > RGB->CMY > ESC Codes > Port       **                           All communication with printer port drivers is handled here  **                                                                                        **		Originally written by Jason Harper                                               **		I/O code, text mode, IW mode, speed and memory optimizations by Ben Koning       **		Copyright (C) 1989 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************				include		'equates.aii'																		include		'm16.util'				include		'm16.intmath'				include		'm16.event'				include		'm16.misctool'				include		'e16.quickdraw'ImagerProc		proc		export**********************************************************************************                                                                               **  ImageWriter LQ imaging routine for the Apple IIgs                            **                                                                               **  Written by Jason Harper under contract for Apple Computer, Inc.              **  Modified for use by ImageWriter LQ driver by Ben Koning                      **                                                                               **  On entry             16-bit full native mode                                 **                       DP points to 1 page of Bank 0 for routine's use         **  |previous contents|  DBR is not assumed to point to any particular bank      **  |-----------------|                                                          **  |                 |                                                          **  |-   SrcLocPtr   -|  LONG: pointer to LocInfo record describing pixelmap     **  |                 |        or pointer to first char in string for text       **  |-----------------|                                                          **  |                 |  LONG: pointer to rectangle to be printed                **  |-  SrcRectPtr   -|        or coordinates for text:                          **  |                 |        +0: Rel Y, down only; +2: Abs X for print head    **  |-----------------|                                                          **  |                 |                                                          **  |-   CTablePtr   -|  LONG: pointer to color tables to be used                **  |                 |        or length of string for text                      **  |-----------------|                                                          **  |                 |  LONG: pointer to list of ScanlineControlBytes to use    **  |-  SCBListPtr   -|        for each line (1 byte each), must not be NIL!     **  |                 |        or bit vector giving text mode print options      **  |-----------------|                                                          **  |  CarriageWidth  |  WORD: rightmost pr limit; right margin for landscape    **  |-----------------|                                                          **  |   PaperLength   |  WORD: tallness of paper so formfeed works correctly     **  |-----------------|                                                          **  |   ActionBits    |  WORD: bit vector giving mechanical motion options       **  |-----------------|                                                          **  |   QualityBits   |  WORD: bit vector giving print method/density options    **  |-----------------|                                                          **  |                 |                                                          **  |-  IdleProcPtr  -|  LONG: pointer to idleproc to call or NIL for none       **  |                 |                                                          **  |-----------------|                                                          **  |  RTL3  |  RTL2  |                                                          **  |--------+--------'                                                          **  |  RTL1  |                                                                   **  '--------' <- SP                                                             **                                                                               **  On exit              A norm 0, nonzero if exit status/Option-Period press    **                       Carry set if nonzero A (see above)                      **                       X,Y trashed                                             **                       DP unchanged                                            **  |previous contents|  DBR restored to original value                          **  |-----------------|                                                          **  |  RTL3  |  RTL2  |                                                          **  |--------+--------'                                                          **  |  RTL1  |                                                                   **  '--------' <- SP                                                             **                                                                               **  Definition of ActionBits (setting to all zero causes default action):        **                                                                               **    Bit 0:  0=Output form feed (FF) when finished; 1=Don't do form feed        **    Bit 1:  0=Init, recalibrate head, set paper length, set TOF; 1=Don't       **    Bit 2:  0=Don't do sheet feeder select; 1=Cause sheet feeder selection     **    Bit 3:  Least significant bit of sheet feeder to use, 0..2                 **    Bit 4:  Most significant bit of sheet feeder to use, 0..2                  **    Bit 5:  0=Do imaging (graphics/text); 1=Don't (only init/bin select)       **    Bit 6:  0=Print graphics; 1=Move paper/head and print text string          **            If Bit 6 set, set SrcLocPtr to address of string                   **            If Bit 6 set, set CTablePtr to length of string                    **            If Bit 6 set, set SrcRectPtr+0 delta_Y (down only); +2 to abs_X    **            If Bit 6 set, set SCBListPtr+0 to text font 0..3                   **                 0=NLQ, 1=draft, 2=NLQ, 3=LQ                                   **            If Bit 6 set, set SCBListPtr+1 to text size 0..7                   **                 0=9, 1=10, 2=12, 3=13.4, 4=15, 5=17 cpi, 6=prop1, 7=prop2     **	         If Bit 6 set, set SCBListPtr+2 to text style 0..2                  **	              Bit 0=bold; Bit 1=underline; Bit 2=double-w; Bit 3=half-h     **    Bit 7:  0=Normal; 1=Ask printer to identify itself and installed options   **            If Bit 7 set, on exit ACC bit 0 set if printer is ImageWriter LQ   **            If Bit 7 set, on exit ACC bit 1 set if printer has color ribbon    **            If Bit 7 set, on exit ACC bit 2 set if printer has sheet feeder    **    Bit 8:  0=Open port connection before sending (PrDevOpen); 1=Don't         **    Bit 9:  0=Close port connection after sending (PrDevClose); 1=Don't        **    Bit 10: 0=normal; 1=Try to use IW_II print command (faster) (see below)    **                                                                               **  Definition of QualityBits (equivalent to wDev field in print record):        **                                                                               **    Bit 0:  "Better Text"  If set, print at 1/3 size using LQ resolution       **    Bit 1:  0=Portrait orientation; 1=Landscape orientation                    **    Bit 2:  "Condensed"  If set, print 1/2 vertical size                       **    Bit 3:  Lsb of print output size (horizontal & vertical)                   **    Bit 4:  Msb of print output size (horizontal & vertical)                   **            If Bit 4,3 = 00, print 3/3 life size (no reduction  - 100% size)   **            If Bit 4,3 = 01, print 2/3 life size (33% reduction -  66% size)   **            If Bit 4,3 = 10, print 1/3 life size (66% reduction -  33% size)   **    Bit 7:  0=Vertical gap at end of sheet; 1=No gap between sheets            **    Bit 13: "Darker" If set, boldface mode is selected                         **    Bit 14: 0=Bidirectional; 1=Unidirectional                                  **    Bit 15: 0=Grayscale (colors mapped); 1=Color (CMY process)                 **                                                                               **  Definition of exit error code in accumulator:                                **                                                                               **    $0080:  User typed command-period (this err has precedence over others)    **    $008X:  Status err (only works over network) (in certain precedence):      **            $81: Network error  $82: No paper    $83: Paper jam                **            $84: Cover open     $85: Select off  $8F: Printer busy (in use)    **    $000X:  If ActionBits set for self-id, result code (see above)             **                                                                               **  The Better Text bit causes everything to be printed at 1/3 size: the         **  higher-level routines should generate the bitmap at 3x (full size), 2x       **  (33% reduction), or 1x (66% reduction) magnification to produce a properly   **  sized image.                                                                 **                                                                               **  The "use IW_II print command" bit is a suggestion to the imager to try to    **  use the ImageWriter II compatible graphics printing command if possible.     **  In several cases, printing will be much faster (but also lighter).           **  If the IW mode is not supported for a certain QualityBits setting, then      **  the IW mode bit is internally turned off and printing will be as normal.     **  For example, currently IW mode is only supported if Better=0, Portrait,      **  Fullsize, Darker=0.  Anything else will force IW mode off as if it hadn't    **  been selected in the first place.                                            **                                                                               **  CrWidth should be passed in units of 240 horizontal pixels per inch, and     **  PaperLength should be passed in units of 72 vertical pixels per inch.  The   **  X and Y displacements for printing text strings should be passed in terms    **  of 80 pix/inch horizontal and 72 pix/inch vertical (which coincides with     **  the effective resolution with the Better bit off).                           **                                                                               **  Note on terminology: In these routines, "band" refers to one scan of the     **  print head.  Do not confuse this with the printing bands into which the      **  high-level driver print loop routines split up each page due to possible     **  memory constraints.                                                          **                                                                               **  If something other than NIL is passed for IdleProcPtr, that location will    **  be JSL-ed to with our environment saved.  The Command-Period printing        **  interrupt request from the user is checked for even if an IdleProcPtr is     **  given.  (Command-Period causes the imager to abort and return an error.)     **                                                                               **  In portrait mode, a 16-bit-wise white scanning algorithm is employed to      **  improve speed performance.  It is enabled only if a color table entry that   **  is pure white is found.  This algorithm quickly recognizes large areas of    **  white even in between nonwhite areas and saves time by not processing those  **  areas.  A similar but much more restricted algorithm exists in landscape     **  mode: an entire line (column) must be completely blank and the pure white    **  color must exist in standard color table entries.                            **                                                                               **  In portrait/640/hscaling=1 mode only, a special-case imaging algorithm is    **  employed to improve speed performance.  It is enabled only if pure black     **  and pure white colors exist in their standard color table entries.   Like    **  the portrait mode white scanning algorithm, this shortcut is also able to    **  operate on parts of a line.                                                  **                                                                               **  Just before the printer-ready graphics data is output, it is analyzed and    **  broken up into sequences of print-discrete-data, print-repeating-data, and   **  position-print-head packets, so as to send less data to the printer and      **  to improve speed performance.                                                **                                                                               **  To improve disk/memory space efficiency, the RGB to KCMY conversion table    **  is built at runtime, on an as-needed basis based on the number of color      **  tables "needed" by the given SCBs.                                           **                                                                               **********************************************************************************						IdleProcPtr		equ		ImagerDP+4				;long	;input parameter storageQualBits   		equ 	ImagerDP+8				;wordActionBits 		equ 	ImagerDP+10				;wordPaperLength		equ		ImagerDP+12				;wordCarriageWidth	equ		ImagerDP+14				;wordSCBListPtr 		equ 	ImagerDP+16				;longCTablePtr  		equ 	ImagerDP+20				;longSrcRectPtr 		equ 	ImagerDP+24				;longSrcLocPtr  		equ 	ImagerDP+28				;longSizeInputs      equ 	(ImagerDP+32)-IdleProcPtrPixMapBase		equ		ImagerDP+32				;long	;addr of pixelmap to printPixMapHigh		equ		ImagerDP+36				;word	;height/pixelsPixMapWide		equ		ImagerDP+38				;word	;width/640 mode pixelsPixMapLeft		equ		ImagerDP+40				;word	;pixels to skip at left edgeleftskip		equ		ImagerDP+42				;word	;counter for PixMapLeftSCBTabBase		equ		ImagerDP+44				;word	;offset from SCBListPtr for pixelmapMasterMode		equ		ImagerDP+46				;word	;mode ($00/$80) from SrcLocInfoMasterPal		equ		ImagerDP+48				;word	;palette ($0..$F) from SrcLocInfoLineDirty		equ		ImagerDP+50				;word	;linebuffer contains non-0 valueslineoffset		equ		ImagerDP+52				;word	;offset into linebufferpixelbits		equ		ImagerDP+54				;word	;linebuffer bit mask for curr. pixelThisLMode		equ		ImagerDP+56				;word	;mode ($00/$80) for this lineThisLPal		equ		ImagerDP+58				;word	;palette ($0..$F) for this linehorpcount		equ		ImagerDP+60				;word	;horizontal pixel countDitherH			equ		ImagerDP+62				;word	;horizontal dither matrix indexcolorstr		equ		ImagerDP+64				;word	;word_ptr to setup string for this bandlinebase		equ		ImagerDP+66				;word	;starting offset into linebuffercolortemp		equ		ImagerDP+68				;long	;multiuse temp for RGB/grayscale conversion**Equates defining QualityBits:*;					 5432109876543210qbColor			equ %1000000000000000qbUnidir		equ %0100000000000000qbDarker		equ %0010000000000000qbNoGap			equ %0000000010000000qbCndnsd		equ %0000000000000100qbLandMode		equ %0000000000000010qbBetter		equ %0000000000000001;					 5432109876543210**Equates defining ActionBits:*;					 5432109876543210abNoFeed		equ %0000000000000001abNoInit		equ %0000000000000010abDoBinSel		equ %0000000000000100abBinLsb		equ %0000000000001000abBinMsb		equ %0000000000010000abDoImage		equ %0000000000100000abTextMode		equ %0000000001000000abGetID			equ %0000000010000000abNoOpen		equ %0000000100000000abNoClose		equ %0000001000000000abIWMode		equ %0000010000000000;					 5432109876543210*******************************************************************************				export Imager		   Imager:				phb							;save orig DBR								pea $0000					;set DBR to bank 0 to access stack				plb				plb								tsc							;copy parms into DP locations				tay				ldx #0copyparms 				lda |5,y				sta IdleProcPtr,x				iny				iny				inx				inx				cpx #SizeInputs				blt copyparms								phk							;set DBR to program bank				plb								stz prError					;clear this before starting								jsr LQstartup				jsr LQPrPixmapOrText				jsr LQshutdown				LQexit				ldx prError					;we'll return this on exit				plb							;restore orig DBR				lda 1,s				sta SizeInputs+1,s				lda 2,s				sta SizeInputs+2,s				clc				tsc				adc #SizeInputs				tcs				txa							;set ACC and carry if user-abort or error				cmp #1				rtl*********************************************************************************WRITESHORT: Routine to output string to printer; 16-bit address of pascal-type string -> ACC:*writeshort:				tax				inc a				sta ws_addr					;low byte of address				phb				phb				pla				and #$00FF				sta ws_addr+2				;high byte = PBR				lda |0,x					;get string length				and #$00FF				tax				ws_write		stz ws_done					;clr completion/error flag. Enter here w/ ws_addr & X				pushlong #ws_cmpl			;completion routine to be called when write is done				pushlong ws_addr			;address				phx							;length still in X				ldx #$1E13					;this call will return immediately				jsl $E10000					;_PrDevWrite				bcc ws_wait					;check if no error on immediate return				cmp #$08FF					;make sure we don't count buffer-full as an error				beq ws_waitws_goterr		lda #$0081					;if error, set global flag and exit				sta prError				jsr IdleProcAbortErrCheck	;try to find out a specific err other than $81				rtsws_wait			lda ws_done					;wait until done or error				beq ws_wait				bmi ws_goterr				rtsws_addr			ds.l 1ws_done			ds.w 1ws_cmpl			ldx #$0001					;we're here so done.  if no err, done_flag gets $0001				cmp #0						;check ACC for error code				beq ws_cmpl1				lda >is_network				;if not on network, done_flag also always gets $0001				beq ws_cmpl1				ldx #$FFFF					;if err and on network, done_flag gets $FFFFws_cmpl1		txa							;store error code...				sta >ws_donews_cmpl2		rtl**WRITELONG: Routine to output long blocks of data to printer; Ptr.LO -> ACC, Ptr.HI -> X, Count -> Y:*writelong:				sta wl_adr+0				;use params to init our running pointers				stx wl_adr+2				;we will output long data in flow-quantum pieces				sty wl_len				wl_donext		lda wl_len					;if all data is now less than quantum just do last chunk				cmp #OutputFlowQuantum+1				bcc wl_dolast								lda wl_adr					;else, write one chunk at a time...				sta ws_addr					;set up ws_addr and X and go output a chunk				lda wl_adr+2				sta ws_addr+2				ldx #OutputFlowQuantum				jsr ws_write								clc							;...and advance pointer and decrease length...				lda wl_adr				adc #OutputFlowQuantum		;our_address.L += OutputFlowQuantum.W				sta wl_adr				lda wl_adr+2				adc #0				sta wl_adr+2				sec				lda wl_len				sbc #OutputFlowQuantum		;our_length.W -= OutputFlowQuantum.W				sta wl_len				bra wl_donext				;...and go send next chunk				wl_dolast		lda wl_adr					;set up ws_addr and X and go output last chunk and exit				sta ws_addr				lda wl_adr+2				sta ws_addr+2				ldx wl_len				brl ws_write					   wl_adr			ds.l 1						;running pointer to data to be sent for a chunkwl_len			ds.w 1						;running decreasing count of data left to be sent*******************************************************************************LQStartUp:				lda #0				pha							;always see if on a networked port device, because				pha							;we'll need to know whether we can do asyncronous I/O				ldx #$2B13					;_PMGetNetworkName				jsl $E10000				pla				sta is_network				pla				ora is_network				sta is_network				;anyone in the imager may now check is_network								beq lqs_not_netid			;if on network and servicing self-id request, go				lda ActionBits				;to the id-on-network section below, since its not				and #abGetID				;necessary to open/read/close, which takes time on net				beq lqs_not_netid				do_id_network	stz status_buff+5			;begin of code to obtain self-id info from network				pushlong #status_buff		;do status inquiry with port driver (PAPStatus)				ldx #$2013					;_PrDevStatus				jsl $E10000				lda status_buff+5			;status buff was cleared above in case not supported				tax				;	  5432109876543210				ldy #%0000000000000001		;begin by indicating that it's an LQ (but we're not sure)do_id_net_0		and #%0000000010000000		;status bit 7 indicates color capability				beq do_id_net_1				tya				;	  5432109876543210				ora #%0000000000000010		;indicate color capability by setting bit 1 in result				taydo_id_net_1		txa				;	  5432109876543210				and #%0000000001000000		;status bit 6 indicates sheet feeder presence				beq do_id_net_done				tya				;	  5432109876543210				ora #%0000000000000100		;indicate sheet feeder by setting bit 2 in result				taydo_id_net_done	sty PrError					;store result and exit				rtslqs_not_netid				lda ActionBits				;see if execution of open request is desired				and #abNoOpen				bne dont_open								jsr IdleProcAbortErrCheck	;check if port driver connection request has any chance				lda prError					;and also allow user to hit command-period...				beq do_open					;abort on cmd-".", DevStatus err, status result buff errabort_open		rtsdo_open			pushlong #0					;request connection from port driver -- hog printer				pushlong #0				ldx #$1C13				jsl $E10000					;_PrDevOpen				lda #1						;set flag indicating that we have an exclusive connection				sta is_our_conn				dont_open		lda ActionBits				;see if printer/feature identification is desired				and #abGetID				bne do_id				brl dont_id				do_id			ldy #6						;zero out the receive buffer before starting				lda #0id_clear		sta r_idstring,y				dey				dey				bpl id_clear								lda is_network				;setup async read only if on network				beq req_id				stz is_complete				pha				pushlong #read_cmpl				pushword #8				pushlong #r_idstring				ldx #$2113					;_PrDevAsyncRead				jsl $E10000				pla				req_id			lda #s_selfid				;send self-id request				jsr writeshort				;response will be: [garbage_chr] LQ1 [C] [E] [F] [1|2|3] <cr>								lda is_network				;do sync read if not on network				bne wait_cmpl				pha				pushlong #r_idstring				pushword #8				ldx #$1D13				jsl $E10000					;_PrDevRead				pullword r_idlength				bra ana_id				wait_cmpl		lda is_complete				beq wait_cmplana_id			stz PrError					;init result bits: 0=is_lq, 1=has_color, 2=has_feeder				ldy #0						;init index into string				lda r_idstring,y 			;look at first 2 bytes of string (16-bit LDA) ("LQ")				cmp #'L'+('Q'*256)				beq id_match				;matches first try; don't adjust Y index, continue				iny							;will try rest of matching offset by one				lda r_idstring,y			;look for those two characters (16-bit LDA) ("LQ") AGAIN!				cmp #'L'+('Q'*256)				bne id_done					;string is not "LQ______" nor is it "_LQ______"; rejectid_match		lda r_idstring+1,y			;look at next two characters of string ("Q1")				cmp #'Q'+('1'*256)				bne id_done				lda #%0000000000000001		;indicate it's at least a wide carriage LQ				sta PrError				iny							;now search thru string and set other bits until end...				iny							;set index to next character after "LQ1"				inynew_id_chr		cpy r_idlength				;go until end of number of chars we got as id result				bcs id_done				shortm						;get a character out of the id string				lda r_idstring,y				longm				tax				cpx #'E'					;envelope attachment?				bne no_envits_feeder		lda PrError					;indicate envelope or sheet feeder				ora #%0000000000000100				sta PrError				bra nxt_id_chrno_env			cpx #'F'					;sheet feeder?				beq its_feeder				cpx #'C'					;color ribbon?				bne nxt_id_chr				lda PrError					;indicate color ribbon				ora #%0000000000000010				sta PrErrornxt_id_chr		iny				bra new_id_chrid_done			rtsdont_id			lda ActionBits				;init printer mechanics/recalibrate head, if desired				and #abNoInit				bne LQnoprinit								lda #s_reset				;reset printer (does head recalibration)				jsr writeshort					   				lda PaperLength				;set vert paper len to PaperLength param (given in 72ths)				asl a				pha				pushlong #n_paperlen				pushword #4				pushword #0				_Int2Dec				lda #s_paperlen				jsr writeshort				;do paper length command in 144ths				lda #$FFFF					;ensure sheet-feeder-set-request always done first time				sta last_binLQnoprinit				lda ActionBits				;select cut sheet feeder, if desired				and #abDoBinSel				beq LQnobinselect								lda ActionBits				;get bin number from its field				lsr a				lsr a				lsr a				and #3						;now have bin number: 0..2				cmp last_bin				;do feeder command only if request is for different bin				beq dont_bin				sta last_bin				ora #$30					;now have last part of bin command: $3X, X=0..2				shortm				sta n_binselect				;store the byte into command string				longm				lda #s_binselect			;issue the command				jsr writeshortdont_bin		   		   LQnobinselect				stz prError					;clear any error status now for loop				rtsread_cmpl		txa							;routine called by async read: A->err, X->len, Y->eof				sta >r_idlength				lda #1				sta >is_complete				rtls_reset			dc.b	6					;reset printer to defaults and set language to american				dc.b	$1B,$63				dc.b	$1B,$5A,$07,$00			s_paperlen		dc.b	6					;set vertical paper length for formfeed operation				dc.b	$1B,$48n_paperlen		dc.b	'0000'				;units are XXXX/144 inchs_binselect		dc.b    3  					;select cut sheet feeder bin				dc.b    $1B,$40n_binselect		dc.b	$30			s_selfid 		dc.b	6   				;enable ribbon sensor and request ID string				dc.b	$1B,$5A,$00,$02  				dc.b	$1B,$3F			is_our_conn 	dc.w	0					;static do-we-have-an-exclusive-connection-to-printer flaglast_bin		dc.w	0					;static last-sheet-feeder-bin-selected flagis_network  	dc.w	0					;on-network/not-on-network statusis_complete 	dc.w	0					;async read completion flagr_idlength		dc.w	0					;length of returned ID stringr_idstring		ds.b	8					;storage for returned ID string; 8 characters max*******************************************************************************LQShutDown:				lda ActionBits				;do form feed, if desired				and #abNoFeed+abGetID				bne dont_feed				lda #s_formfeed				jsr writeshortdont_feed				lda ActionBits				;close port connection, if desired				and #abNoClose				bne dont_close								lda is_our_conn				;close coneection with printer only if we opened it				beq dont_close								lda #s_close				;set basic options which were modified back to normal				jsr writeshort				ldx #$1F13					;close connection with printer, freeing it for others				jsl $E10000					;_PrDevClose				stz is_our_conn				;clear our flag indicating exclusive connection statusdont_close				rtss_formfeed		dc.b	1					;form feed				dc.b	$0C			s_close			dc.b	8					;set printer vertical options back to sane values				dc.b	$1B,$48				;...set-page-length command to 1584/144"=11"				dc.b	'1584'				dc.b	$1B,$41				;...set line feed (LF) to default 6 lines/inch*********************************************************************************LQMODESET: Sets up printer modes for graphics printing:*LQModeSet:				lda ActionBits				;if IW mode selected and we can't do it, turn it off:				and #abIWMode				beq iwq_done				lda QualBits				;     5432109876543210				and #%0010000000011011		;check if any of Better,Land,Reduction,Darker are set				beq iwq_yes					;none set, so IW mode is supported for selected QualBitsiwq_no			lda ActionBits				;else, clear IW mode bit at this time!				and #ÅabIWMode				sta ActionBits				bra iwq_doneiwq_yes			lda QualBits				;force boldface on if IW mode is desired and authorized				;     5432109876543210				ora #%0010000000000000				sta QualBitsiwq_done								lda QualBits				;get scalings according to QualityBits from lookup table				and #$1F				tax				lda vscaletab,x				and #$00FF				sta vScaling				lda hscaletab,x				and #$00FF				sta hScaling								lda ActionBits				;check if IW graphics mode				and #abIWMode				beq not_iw_hs				lda #1						;if IW mode, will do 1X6 print pixels for full size				sta hscaling				not_iw_hs		lda QualBits				;set pitch (horiz print pixel size) diff if port/land				and #qbLandMode				bne islandscap				isportrait				lda ActionBits				;check if IW graphics mode				and #abIWMode				beq not_iw_sp				lda #s_iw_port				;if IW/Portrait mode, pick 80 pix/inch pitch				jsr writeshort				bra gotmode				not_iw_sp		lda #s_lq_port				;if LQ/Portrait mode, pick 240 h pix/inch pitch				jsr writeshort				bra gotmode				islandscap				lda #s_lq_land				;if LQ/Landscape mode, pick 192 h pix/inch pitch				jsr writeshort				gotmode				lda CarriageWidth			;get crWidth from input parameter				sta crWidth								lda crWidth					;generate crWidth * 3				asl a				clc				adc crWidth				sta crWidthX3								lda QualBits				;set unidirectional mode if requested				and #qbUnidir				beq notunidir				lda #s_unidir				jsr writeshort				notunidir				lda QualBits				;set darker printing (boldface mode) if requested				and #qbDarker				beq notdarker				lda #s_darker				jsr writeshort				notdarker				rtss_lq_port		dc.b	2					;Condensed (240 dpi)				dc.b	$1B,$71			s_lq_land		dc.b	2					;Elite (192 dpi)				dc.b	$1B,$45			s_iw_port		dc.b	2					;Pica (80 dpi if IW graphics print command used)				dc.b	$1B,$4E			s_unidir		dc.b	2					;unidirectional printing				dc.b	$1B,$3E			s_darker		dc.b	2					;enable boldface mode				dc.b	$1B,$21*********************************************************************************LQADDRCALC: Obtains screen-buffer pixel increment values for imaging loops:*LQAddrCalc:								ldy #oportSCB				;get mode info from SrcLoc				lda [SrcLocPtr],y				and #$0080				sta MasterMode				lda [SrcLocPtr],y				and #$000F				sta MasterPal								ldy #optrToPixImage			;get pixmap address from SrcLoc				lda [SrcLocPtr],y				sta PixMapBase+0				iny				iny				lda [SrcLocPtr],y				sta PixMapBase+2								sec                 		;get offset from top to start printing				ldy #0						;top				lda [SrcRectPtr],y				ldy #oboundsRect+0				sbc [SrcLocPtr],y				bpl gotvskip				lda #0				gotvskip									;adjust pixmap addr to top print line				sta SCBTabBase				pha				pha				PHA				ldy #owidth				lda [SrcLocPtr],y				pha				_Multiply				clc				pla				adc PixMapBase				sta PixMapBase				pla				adc PixMapBase+2				sta PixMapBase+2				sec         				;calculate height of print area				ldy #4				lda [SrcRectPtr],y				ldy #0				sbc [SrcRectPtr],y				sta PixMapHigh				sec				ldy #oboundsRect+4				lda [SrcLocPtr],y				ldy #oboundsRect+0				sbc [SrcLocPtr],y				sec				ldy #0				sbc [SrcRectPtr],y				cmp PixMapHigh				bge clipatbot				sta PixMapHighclipatbot				sec   						;get offset from left edge to print				ldy #2           			;left				lda [SrcRectPtr],y				ldy #oboundsRect+2				sbc [SrcLocPtr],y				bpl gothskip				lda #0gothskip									;adjust pixmap addr to left edge...				ldx MasterMode    			;accurate to 1 byte (max 3 pixels off)				bne gothskip1				asl agothskip1				tax				and #$03				sta PixMapLeft				txa				lsr a				lsr a				clc				adc PixMapBase				sta PixMapBase				lda PixMapBase+2				adc #0				sta PixMapBase+2								sec              			;calculate width of print area				ldy #6				lda [SrcRectPtr],y				ldy #2				sbc [SrcRectPtr],y				sta PixMapWide				sec				ldy #oboundsRect+6				lda [SrcLocPtr],y				ldy #oboundsRect+2				sbc [SrcLocPtr],y				sec				ldy #2				sbc [SrcRectPtr],y				cmp PixMapWide				bge clipright				sta PixMapWideclipright				ldx MasterMode				;double if 320 b/c 2 prpix/scrnpix done below if 320				bne gotwide				asl PixMapWidegotwide				rts*********************************************************************************CLEARLINE: Zeros the buffer which holds the printer-pixels that is built up during imaging loops:*ClearLine:								lda LineDirty    			;don't bother to clear the line				bne cl_enable				;unless there's already some data in it				rts				cl_enable				lda crWidthX3         		;note that this may write one byte				dec a             			;beyond the end of the buffer				and #$FFFE				tax				lda #0				cl_loop			sta linebuffer,x				dex				dex				bpl cl_loop								stz LineDirty				;reset this flag				rts*********************************************************************************FILLRGBTOKCMY: Fills-in only those color convert tables that are needed by the given SCB list.**There are 16 color conversion tables; only those which are referenced by an SCB in the given*SCB list are made valid by this routine.  Table entries are of the form $KCMY with 4-bit nibbles*for each color, and should be indexed by (SCB# 0..15) * 32 + (pixel 0..15) * 2.**Entries are calculated as follows: C=15-R; M=15-G; Y=15-B; K=min(C,M,Y); C=C-K; M=M-K; Y=Y-K;*and finally M=M*(1-(C/60)).  The last step compensates for incorrect cyan ribbon color.*FILLRGBTOKCMY:				ldy #0						;zero all 16 is-valid-conversion-table flags				tya							;these flags will be used during the upcoming				shortm						;conversion-table-fill loop to see if a coloricmy_zloop		sta KCMY_valid,y			;table has alreay been computed				iny				cpy #15+1				bne icmy_zloop				longm				ldy PixMapHigh				;prepare for outer loop for all SCB values given by user				lda QualBits				;find out how tall (how many entries long) the list is				and #qbBetter				;infer SCB list size from tallness of pixmap				beq icmy_adjscbdone			;and scale tallness down if Better modes				lda QualBits				;to compensate for scaled-up pixmap				and #%00011000				beq icmy_adjscbdiv3				cmp #%00001000				bne icmy_adjscbdoneicmy_adjscbdiv2	tya							;/2 if Better & 66%				lsr a				tay				bra icmy_adjscbdoneicmy_adjscbdiv3	pha							;/3 if Better & 100%				pha				phy				pushword #3				_UDivide				ply				plaicmy_adjscbdone*icmy_DoAllSCBs								;do outer loop for all SCB's given by user				phy							;Y has SCB # index that we're doing, save for looping				lda [SCBListPtr],y			;obtain an SCB value				and #$000F					;only get color table select part of the SCB *byte*				tay							;Y now has # of one of the tables that will be needed				lda KCMY_valid,y			;have we already computed entries for this table?				and #$00FF					;(the KCMY-valid table is a table of bytes)				bne icmy_next1scb			;yes, we already did this table, so go on								lda #1						;else: we didn't compute this table yet, so mark it				shortm						;as computed and drop into the compute code below				sta KCMY_valid,y			;Y still has the table #				longm								tya							;ready to compute: construct start adrs of RGB colr tbl				asl a						;each table is 32 bytes long, so do table # * 32				asl a						;this computed start address will point to the beginning				asl a						;of the current color table that we're converting, and				asl a						;is valid for both the user's list of (RGB) tables and				asl a						;our in-progress list of (KCMY) tables				sta icmy_ctblbase***				lda #30						;compute KCMY entries for all 16 RGB words in this tableicmy_fill1tbl	pha							;save loop counter/index within this table				clc							;add to base address of this SCB's table				adc icmy_ctblbase				tay				phy							;save base address+color entry index of this SCB's table				lda [CTablePtr],y			;access user's RGB value within user's table				jsr icmy_ConvertOne			;convert $0RGB nibbles in A to $KCMY nibbles in A				ply							;restore saved base address+color entry index				sta KCMY_lookup,y			;use it to store KCMY into our parallel table				pla							;restore loop counter/index				dea							;going backwards from end to beginning				dea				bpl icmy_fill1tbl***				icmy_next1scb	ply							;bottom of loop for all SCBs, restore SCB # index				dey							;we're going backwards up to and including 0				cpy #$FFFF					;exit back to caller when done				bne icmy_DoAllSCBs				rts				icmy_ConvertOne:							;subr to calc KCMY from RGB nibbles (input/output in ACC)				eor #$0FFF					;subtract R,G,B values from 15 each in place											;$0RGB   ->   $ [0] [$F-R] [$F-G] [$F-B]				tax				and #$000F					;normalize values in the nibbles into static vars				sta icmy_valueY				;so we can do manipulations on them				txa				lsr a				lsr a				lsr a				lsr a				and #$000F				sta icmy_valueM				txa				xba				and #$000F				sta icmy_valueC								lda icmy_valueC				;do K = min (C,M,Y)				sta icmy_valueKicmy_min1		cmp icmy_valueM				bcc icmy_min2				lda icmy_valueM				sta icmy_valueKicmy_min2		cmp icmy_valueY				bcc icmy_min3				lda icmy_valueY				sta icmy_valueKicmy_min3				sec							;subtract K value from each of C,M,Y values				lda icmy_valueC				sbc icmy_valueK				sta icmy_valueC				sec				lda icmy_valueM				sbc icmy_valueK				sta icmy_valueM				sec				lda icmy_valueY				sbc icmy_valueK				sta icmy_valueY				lda #60						;do fudge factor to M				sec							;M = M * (1 - (C/60)), done as 60M=M(60-C) in int math				sbc icmy_valueC				;this has the effect of reducing the value for M by				pha							;0..25% for C values of 0..100%				pha				pha				pushword icmy_valueM				_Multiply				pla				plx				phx				phx				pha				pushword #60				_UDivide				pla				plx				sta icmy_valueM								lda icmy_valueM				;assemble nibble values into $KCMY word				asl a				asl a				asl a				asl a				ora icmy_valueY				sta colortemp				lda icmy_valueC				xba				ora colortemp				sta colortemp				lda icmy_valueK				xba				asl a				asl a				asl a				asl a				ora colortemp								rts							;exit this subroutine with $KCMY-word in ACC								icmy_valueK		dc.w 0						;normalized value for black print intensity 0..15icmy_valueC		dc.w 0						;normalized value for cyan print intensity 0..15icmy_valueM		dc.w 0						;normalized value for magenta print intensity 0..15icmy_valueY		dc.w 0						;normalized value for yellow print intensity 0..15icmy_ctblbase	dc.w 0						;start offset of a single 16-entry, 32-byte color tableKCMY_valid		ds.b 16						;is-valid indicator flags for each color convert tableKCMY_lookup		ds.w 16*16					;16 convert tables of 16 $KCMY-word entries each*******************************************************************************LQPrPixMapOrText:								lda ActionBits				;see if user wants us to print graphics or text at all				and #abDoImage+abGetID				beq goPrint				rts				goPrint			lda ActionBits				;see if want to print native text instead of graphics				and #abTextMode				bne goPrintText				brl goPrintPix		   **Start of code to print string using printer's native text mode (for "Draft Printing"):*goPrintText:								jsr IdleProcAbortErrCheck	;call once before sending string				lda prError					;give user a chance to exit before even printing anything				beq prtext_ln				;if error or user exit, don't go on				rts				prtext_ln		lda CTablePtr				;check length: if null string, don't go on				bne prtext_ok				rts				prtext_ok		pha							;div delta y to do 1)coarse, 2)fine y posn to save time				pha				pushword SrcRectPtr+0				pushword #18/2				;number of y positions to do at a time to save time				_UDivide				pullword coarse_num_lf				pullword fine_num_lf								ldy coarse_num_lf			;do coarse delta y (move down only)				beq done_ypos1loop_ypos1		phy				lda #s_movedown_c				jsr writeshort				ply				dey				bne loop_ypos1done_ypos1				ldy fine_num_lf				;do fine delta y (move down only)				beq done_ypos2loop_ypos2		phy				lda #s_movedown_f				jsr writeshort				ply				dey				bne loop_ypos2done_ypos2								lda SrcRectPtr+2			;do absolute x (printer pix position to move head to)				pha				pushlong #n_moveacross				pushword #4				pushword #0				_Int2Dec				lda #s_moveacross				jsr writeshort								lda #$30					;select one of the printer's built-in fonts				shortm				ora SCBListPtr+0				sta n_textfont				longm				lda #s_textfont				jsr writeshort								shortm						;select one of the printer's built-in text sizes				lda SCBListPtr+1				longm				and #%111				asl a				asl a				clc				adc #s_textsize_tbl				jsr writeshort								lda #s_textstlreset			;select one of the printer's built-in text styles				jsr writeshort				shortm				lda SCBListPtr+2				longm				pha				and #%00000001				beq textstl_1				lda #s_boldface				jsr writeshorttextstl_1		pla				pha				and #%00000010				beq textstl_2				lda #s_underline				jsr writeshorttextstl_2		pla				pha				and #%00000100				beq textstl_3				lda #s_doublewidth				jsr writeshorttextstl_3		pla				and #%00001000				beq textstl_4				lda #s_halfheight				jsr writeshorttextstl_4								ldy #0						;loop through string; will cache until intl char				sty last_intl				sty last_posn				loop_char		sty curr_posn				;get an ascii character...				lda [SrcLocPtr],y				and #$00FF				sta stor_char								cmp #$0020					;convert to space and go on if control character...				bcs not_ctrl				lda #$0020				shortm				sta [SrcLocPtr],y			;current position still in Y				longm				bra next_char				not_ctrl		lda stor_char				;check if the char is international while normalizing...				sec				sbc #$0080				bpl its_intl				;go to next section if intl char with ACC $00..$7F				stz last_intl				;else keep this flag clear and go on...				bra next_char				its_intl		pha							;current char is international; save normalized intl char				lda last_intl				;check if last char was intl...				bne do_conv					;if so then don't flush previous chars				jsr out_flush				;if not then flush				lda #1						;set flag for next time				sta last_intldo_conv			pla							;restore $00..$7F normalized intl char code				asl a						;form index into intl char translation table				tax				shortm						;intl tbl entries: {byte new_char; byte lang_tbl_offset}				lda intl_tbl+0,x				sta stor_char				;overwrite our idea of the character code				lda intl_tbl+1,x			;now get the language it's in from language table				longm				and #$FF				clc							;lang tbl entries consist of writeshort command strings				adc #lang_tbl				;add base address of table				jsr writeshort				;set printer to the language								lda #stor_char				;output character...				ldx #^stor_char				ldy #1				jsr writelong				lda #lang_tbl				;set language back to american...				jsr writeshort				lda curr_posn				;keep last_posn initted in case next char not intl...				ina				sta last_posn				next_char		ldy curr_posn				iny				cpy CTablePtr				;length was passed in lo word of CTablePtr				bne loop_char								lda last_intl				;if last char was output using intl method, no flush...				bne skip_fflsh		   				inc curr_posn				;else make sure our entire string is out...				jsr out_flushskip_fflsh		lda #s_textstlreset			;always reset printer setup				jsr writeshort				lda #s_cr					;do carriage return so next string can be to the left				brl writeshort				;and exit				out_flush		sec							;write source=SrcLoc+last_posn, count=curr_posn-last_posn				lda curr_posn				;note this actually is one char too few				sbc last_posn				beq no_flush				;if count would be zero, don't do this				pha							;save count				clc							;compute SrcLoc.LONG + last_posn.WORD...				lda SrcLocPtr				adc last_posn				tay				lda SrcLocPtr+2				adc #0				tax							;X gets hi word				tya							;A gets lo word				ply							;Y gets count restored from above				jsr writelong				;write from=A,X count=Y				lda curr_posn				;set marker for next time...				sta last_posnno_flush		rtslast_intl		dc.w 0last_posn		dc.w 0curr_posn		dc.w 0stor_char		dc.w 0coarse_num_lf	dc.w 0fine_num_lf		dc.w 0s_newln			dc.b 2						;output line feed and carriage return          		dc.b $0A,$0D		   s_textfont		dc.b 3						;select built-in fonts				dc.b $1B,$61n_textfont  	dc.b $30					;$3N, where N=0..3s_textsize_tbl	dc.b 2						;select built-in font sizes				dc.b $1B,$6E,0				dc.b 2				dc.b $1B,$4E,0				dc.b 2				dc.b $1B,$45,0				dc.b 2				dc.b $1B,$65,0				dc.b 2				dc.b $1B,$71,0				dc.b 2				dc.b $1B,$51,0				dc.b 2				dc.b $1B,$70,0				dc.b 2				dc.b $1B,$50,0												s_textstlreset	dc.b 7						;turn off bold, underline, doublewidth, halfheight				dc.b $1B,$22				dc.b $1B,$59				dc.b $0F				dc.b $1B,$57				s_boldface		dc.b 2						;turn on boldface text mode    			dc.b $1B,$21s_underline		dc.b 2						;turn on underline text mode       			dc.b $1B,$58			   s_doublewidth	dc.b 1						;turn on doublewidth text mode      			dc.b $0Es_halfheight	dc.b 2						;turn on halfheight text mode    			dc.b $1B,$77			   s_movedown_c	dc.b	5					;coarse y posn: LF=18/144", do LF				dc.b	$1B,$54				dc.b	'18'	 			dc.b	$0As_movedown_f	dc.b	5					;fine y posn: LF=2/144" (=1/72 match low-qual gr print)	      		dc.b	$1B,$54				dc.b	'02'	 			dc.b	$0As_moveacross	dc.b 8						;move head N_MOVEACROSS ascii # of std resolution units       			dc.b $1B,$4E				;set hor resolution to 80 dpi    			dc.b $1B,$46				;set positionn_moveacross	dc.b '0000'lang_tbl		dc.b 4					;American - offset=00	;lang sel cmds for intl chars...				dc.b $1B,$5A,$07,$00							;indexed by offsets from intl_tbl				dc.b 8					;British  - offset=05	;table entries: writeshort commands				dc.b $1B,$5A,$04,$00				dc.b $1B,$44,$03,$00				dc.b 8					;Danish   - offset=14				dc.b $1B,$5A,$05,$00				dc.b $1B,$44,$02,$00				dc.b 8					;French   - offset=23				dc.b $1B,$5A,$01,$00				dc.b $1B,$44,$06,$00				dc.b 8					;German   - offset=32				dc.b $1B,$5A,$03,$00				dc.b $1B,$44,$04,$00				dc.b 8					;Italian  - offset=41				dc.b $1B,$5A,$06,$00				dc.b $1B,$44,$01,$00				dc.b 8					;Swedish  - offset=50				dc.b $1B,$5A,$02,$00				dc.b $1B,$44,$05,$00				dc.b 4					;Spanish  - offset=59				dc.b $1B,$44,$07,$00intl_tbl		dc.b $5B,50 , $5D,50 , $43,00 , $45,00			;mapping intl chars to chars+cmds...				dc.b $5C,59 , $5C,50 , $5D,32 , $61,00			;indexed by ascii $80..$FF				dc.b $7B,41 , $61,00 , $7B,50 , $61,00			;table entries: new_ascii,offset				dc.b $7D,50 , $5C,23 , $7B,23 , $7D,23			;into the language table above				dc.b $65,00 , $65,00 , $69,00 , $7E,41				dc.b $69,00 , $69,00 , $7C,59 , $6F,00				dc.b $7C,41 , $6F,00 , $7C,50 , $6F,00				dc.b $75,00 , $7C,23 , $75,00 , $7D,32				dc.b $2A,00 , $7B,59 , $63,00 , $23,05				dc.b $40,59 , $7B,59 , $50,00 , $7E,32				dc.b $20,00 , $20,00 , $20,00 , $27,00				dc.b $7E,23 , $23,00 , $5B,14 , $5C,14				dc.b $7E,00 , $7E,00 , $20,00 , $20,00				dc.b $59,00 , $75,00 , $64,00 , $45,00				dc.b $50,00 , $70,00 , $40,59 , $61,00				dc.b $6F,00 , $5A,00 , $7B,14 , $7C,14				dc.b $5D,59 , $5B,59 , $7E,00 , $20,00				dc.b $66,00 , $7E,00 , $64,00 , $22,00				dc.b $22,00 , $2E,00 , $41,00 , $41,00				dc.b $4F,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $22,00 , $22,00 , $27,00				dc.b $27,00 , $2F,00 , $20,00 , $79,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00				dc.b $20,00 , $20,00 , $20,00 , $20,00**********************************************************************************Start of code to print pixel map using printer's graphics mode (for "Spool Printing"):*goPrintPix:								import Dithmatrix								jsr LQmodeset				;set printer modes; boldface, character pitch, etc								lda #1            			;make sure linebuffer gets cleared				sta LineDirty								jsr LQaddrcalc				;calculate scrn-pix increment values for looping								jsr FillRGBtoKCMY			;calculate color system conversion tables								lda QualBits				;go do one of the two imaging loops				and #qbLandMode				beq Pbandloop				brl Lbandloop																				Pbandloop									;*** PORTRAIT MODE PRINTING LOOP ***								lda PixMapHigh        		;see if any more to print				beq allPbands				jsr IdleProcAbortErrCheck	;caller's idle proc or our option-period abort check				lda prError				bne allPbands				lda QualBits				bmi Pcolorband				Pbwband										;print a grayscale band				lda #s_printBW				jsr onePband				bra nextPband				Pcolorband									;print the color bands				jsr saveinfo     			;the 'restinfo' calls undo the				lda #s_printyel    			;pointer advances done by				jsr onePband         		;onePband, so all the color				jsr restinfo        		;bands print from the same data				lda #s_printmag				jsr onePband				jsr restinfo				lda #s_printcyn				jsr onePband				jsr restinfo				lda #s_printblk				jsr onePband				nextPband				lda #s_lf             		;advance printer 1/9"				jsr writeshort				bra PbandloopallPbands									;portrait mode printing done				rts**********saveinfo									;save all variables modified by				lda PixMapBase+0  			;...the band print routine				sta savearea+0				lda PixMapBase+2				sta savearea+2				lda PixMapHigh				sta savearea+4				lda SCBTabBase				sta savearea+6				lda PixMapWide				sta savearea+8				rts				savearea		ds.b 10restinfo									;restore variables modified by the				lda savearea+0      		;...band print routine				sta PixMapBase				lda savearea+2				sta PixMapBase+2				lda savearea+4				sta PixMapHigh				lda savearea+6				sta SCBTabBase				lda savearea+8				sta PixMapWide				rts				**********onePband									;print one portrait mode band								sta colorstr     			;remember what color it is				jsr clearline  				;clear the line buffer				stz linebase				;zero pix line base								lda ActionBits				;skip next section if not IW graphics mode				and #abIWMode				beq lq_PBand								lda QualBits				and #qbCndnsd				bne iw_PLX1				iw_PLX2			lda #%00000011				;IW mode: 4 rows of scrn pixels per 8-dot IW print band				jsr onePline				jsr nextPline				lda #%00001100				jsr onePline				jsr nextPline				lda #%00110000				jsr onePline				jsr nextPline				lda #%11000000				jsr onePline				jsr nextPline				brl pbanddone				iw_PLX1			lda #%00000001				;IW mode: 8 rows of scrn pixels per 8-dot IW print band				jsr onePline				jsr nextPline				lda #%00000010				jsr onePline				jsr nextPline				lda #%00000100				jsr onePline				jsr nextPline				lda #%00001000				jsr onePline				jsr nextPline				lda #%00010000				jsr onePline				jsr nextPline				lda #%00100000				jsr onePline				jsr nextPline				lda #%01000000				jsr onePline				jsr nextPline				lda #%10000000				jsr onePline				jsr nextPline				brl pbanddone				lq_PBand		lda vScaling   				;branch based on vertical scaling				dec a                 		;each possibility (1,2,3,4,6)				dec a                 		;is done individually				bmi goPlineX1				beq goPlineX2				dec a				dec a				bmi PlineX3				beq PlineX4				PlineX6										;vScaling=6: full size				lda #%0000000000111111   	;1				jsr onePline				jsr nextPline				lda #%0000111111000000    	;2				jsr onePline				jsr nextPline				inc linebase				lda #%0000001111110000     	;3				jsr onePline				jsr nextPline				lda #%1111110000000000    	;4 rows of pixels per 24-dot print head band scan				jsr onePline				jsr nextPline				brl Pbanddone				goPlineX1		brl PlineX1           		;extend out-of-range branchesgoPlineX2		brl PlineX2PlineX4										;vScaling=4: 2/3 size				lda #%00001111          	;6 pixel lines per band				jsr onePline				jsr nextPline				lda #%11110000				jsr onePline				jsr nextPline				inc linebase				lda linebase				cmp #3				blt PlineX4				brl Pbanddone				PlineX3										;vScaling=3: full size condensed				lda #%0000000000000111   	;8 pixel lines per band				jsr onePline				jsr nextPline				lda #%0000000000111000				jsr onePline				jsr nextPline				lda #%0000000111000000				jsr onePline				jsr nextPline				lda #%0000111000000000				jsr onePline				jsr nextPline				lda #%0111000000000000				jsr onePline				inc linebase				jsr nextPline				lda #%0000001110000000				jsr onePline				jsr nextPline				lda #%0001110000000000				jsr onePline				jsr nextPline				lda #%1110000000000000				jsr onePline				jsr nextPline				brl Pbanddone				PlineX2										;vScaling=2: 1/3 size, 2/3 condensed				lda #%00000011       		;12 pixel lines per band				jsr onePline				jsr nextPline				lda #%00001100				jsr onePline				jsr nextPline				lda #%00110000				jsr onePline				jsr nextPline				lda #%11000000				jsr onePline				jsr nextPline				inc linebase				lda linebase				cmp #3				blt PlineX2				brl Pbanddone				PlineX1										;vScaling=1: 1/3 size condensed				lda #%00000001        		;24 pixel lines per bandPlineX1a				jsr onePline				jsr nextPline				lda pixelbits				asl a				sta pixelbits				cmp #$0100				blt PlineX1a				inc linebase				lda linebase				cmp #3				bge Pbanddone				lda #%00000001				bra PlineX1a				Pbandexit									;nextPline has aborted this band				plaPbanddone				jsr LQsendbuff  			;band is generated, now send it to LQ				rtsnextPline									;common routine to advance to next				clc                  		;pixel line				ldy #owidth				lda [SrcLocPtr],y				adc PixMapBase+0				sta PixMapBase+0				lda PixMapBase+2				adc #0				sta PixMapBase+2				inc SCBTabBase				dec PixMapHigh        		;if at bottom of pixelmap, pull RTS				beq Pbandexit      			;addr from stack and abort onePline				rts												**********onePline									;generate band data for one pixel line				sta pixelbits            	;A=bit mask for this line				lda linebase				sta lineoffset				stz DitherH				lda PixMapLeft				sta leftskip				lda MasterMode				sta ThisLMode				lda MasterPal				sta ThisLPal				lda SCBListPtr+0        	;if a SCBList was specified, as it must be, get				ora SCBListPtr+2       		;the mode/palette for this line from it				beq gothePmode				ldy SCBTabBase				lda QualBits         		;if in Better Text mode, we must				and #qbBetter        		;scale the SCBList index down by the				beq gotPindex        		;same amount the printer driver				lda QualBits          		;scaled the pixelmap up				and #%00011000				beq Pdivby3				cmp #%00001000				bne gotPindex   			;1/3 size: no scalingPdivby2										;2/3 size: scaled by a factor of 2				tya				lsr a				tay				bra gotPindex				Pdivby3										;full size: scaled by a factor of 3				pha				pha				phy				pushword #3				_UDivide				ply				pla				gotPindex				lda [SCBListPtr],y				and #$0080				sta ThisLMode				lda [SCBListPtr],y				and #$000F				sta ThisLPal				gothePmode				lda ThisLPal				;shift color table select value to transform 0..15				asl a						;into start address of 16-word (32-byte) color table				asl a				asl a				asl a				asl a				sta ThisLPal       			;it's now offset of the colortable for this line								stz Pbw6_enabl				;see if we can enable std-black/white-pixel-value imaging				lda ThisLMode				;mode must be 640				cmp #$0080				bne Pnot_bw6				lda hscaling				;hscaling must be 1				cmp #1				bne Pnot_bw6				lda leftskip				;leftskip must be 0				bne Pnot_bw6				lda ActionBits				;IW mode must be off				and #abIWmode				bne Pnot_bw6				ldy ThisLPal				;check all first minipallette entries for pure black...				ldx #4Pch1_bw6		lda [CTablePtr],y				bne Pnot_bw6				tya				clc				adc #8				tay				dex				bne Pch1_bw6				lda ThisLPal				;check all fourth minipallette entries for pure white...				clc				adc #6				tay				ldx #4Pch2_bw6		lda [CTablePtr],y				cmp #$0FFF				bne Pnot_bw6				tya				clc				adc #8				tay				dex				bne Pch2_bw6				lda #1						;enable if above requirements are all met				sta Pbw6_enablPnot_bw6								ldy #owidth					;obtain byte-width of scanlines for white-scan loop				lda [SrcLocPtr],y				sta Pwht_btend+1								stz Pwht_enabl				;see if we have a white color table entry; we'll				lda ThisLPal				;figure out what a word full of white pixels looks like				clc				adc #$1E				tayPfndwhite		lda [CTablePtr],y			;look for first pure white color table entry				cmp #$0FFF				beq Ppalwhite				dey				dey				tya				cmp ThisLPal				;loop for all 32 bytes in this color table				bpl Pfndwhite				brl Pdonwhite				Ppalwhite		tya				sec				sbc ThisLPal				tay				lda ThisLMode				and #$0080				bne Ppalwh640				Ppalwh320		lda #1						;found white color entry and we're in 320 mode				sta Pwht_enabl				;enable white-scanning				tya				lsr a				and #$F				sta Pwht_model+1			;build white model word -- what 2 bytes of white in 320				asl a						;mode (4 pixels) would look like in memory				asl a				asl a				asl a				ora Pwht_model+1				sta Pwht_model+1				xba				ora Pwht_model+1				sta Pwht_model+1				bra Pdonwhite				Ppalwh640		cpy #$18					;in 640 mode -- all other 3 minipall must also be white,				bcc Pdonwhite				;else don't enable white scanning				tyx				lda #$0FFF				dey				dey				dey				dey				dey				dey				dey				dey				cmp [CTablePtr],y				bne Pdonwhite				dey				dey				dey				dey				dey				dey				dey				dey				cmp [CTablePtr],y				bne Pdonwhite				dey				dey				dey				dey				dey				dey				dey				dey				cmp [CTablePtr],y				bne Pdonwhite				lda #1						;yes we're ok to enable white-scanning				sta Pwht_enabl				txa							;build a white model word -- what 2 bytes of white in 640				lsr a						;mode (8 pixels) would look like in memory				and #%11				sta Pwht_model+1				asl a				asl a				ora Pwht_model+1				sta Pwht_model+1				asl a				asl a				asl a				asl a				ora Pwht_model+1				sta Pwht_model+1				xba				ora Pwht_model+1				sta Pwht_model+1Pdonwhite  									;finished with search for white pixel values								lda PixMapWide				;initialize for horizontal pixel countdown				sta horPcount								ldx hScaling				;precalculate linebuffer index inc for PwhtNonWht				stx Pwht_lbinc				;Pwht_lbinc = hScaling * [3|1] if [LQ|IW]...				lda ActionBits				and #abIWmode				bne Pnolbinc1				txa				asl a				clc				adc hScaling				sta Pwht_lbincPnolbinc1		lda Pwht_lbinc				;...then Pwht_lbinc *= [8|8] if [320|640] (same because				asl a						;horizontal pairs of prpix are done below if 320 mode)				asl a				asl a										sta Pwht_lbinc				;Pwht_lbinc now has linebuffer_index_inc per screen_word												**********				ldy #0						;initialize byte counterPbyteloop									;head of loop for bytes in this pixel line								lda Pwht_enabl				;see if we can do white pixel word elimination				beq Pbytepxls								sty Pwht_oldbp				;save old line byte positionPwhtScan		lda [PixMapBase],y			;try to eliminate whole words of white pixels at timePwht_model		cmp #$0000					;NOTE: operand for this instruction is stuffed				bne PwhtNonWht				lda lineoffset				;lineoffset += Pwht_lbinc calculated before loop above				clc				adc Pwht_lbinc				sta lineoffset				iny				inyPwht_btend		cpy #$0000					;NOTE: operand for this instruction is stuffed				bcc PwhtScanPwhtExit		rts							;exit here if we ran out of bytes in current line		   		   		   PwhtNonWht		cpy Pwht_oldbp				;skip this part quick if we couldn't scan any white words				beq Pbytepxls								tya							;here we are if a word is found to be nonwhite				sec							;figure out how many pixels we skipped, leaving Y intact				sbc Pwht_oldbp				;now have number of bytes we skipped				asl a						;4 pix/byte if 640 mode; also for 320 b/c prpix doubled				asl a								tax							;faking changes that would have occurred if we did pixels				lda horPcount				;horPcount -= num_pix_skipped				stx horPcount				sec				sbc horPcount				sta horPcount				beq PwhtExit				;exit here if horPcount <= 0				bcc PwhtExit				stz leftskip				;leftskip=0 since we are sure to be byte-aligned now												Pbytepxls		lda ThisLMode				;here we start picking pixels out of an (off)-screen byte				bne Pbyte640		   		   		   Pbyte320									;doing an off-scrn byte full of 320-mode pixels				lda [PixMapBase],y        	;320 mode generates pairs of identical				lsr a						;pixels, for compatibility with 640				lsr a				lsr a				lsr a				jsr onePpixel         		;left pixel in byte				lda [PixMapBase],y				lsr a				lsr a				lsr a				lsr a				js