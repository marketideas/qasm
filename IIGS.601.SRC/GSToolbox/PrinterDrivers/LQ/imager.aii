                 	;4R				adc colortemp				sta colortemp           	;5R				lda [CTablePtr],y				lsr a				and #%01111000        		;8G				clc				adc colortemp          		;5R+8G				tax				lda [CTablePtr],y				and #$000F                 	;B				sta colortemp				txa				eor #$FF               		;255-5R-8G				sec				sbc colortemp          		;255-5R-8G-B				sbc colortemp            	;255-5R-8G-2B				sbc colortemp            	;255-5R-8G-3B				and #%11110000				;do adjustment to avoid destructive interference				beq bwPpix_fin				;between our and 640's dithering				ldx thisLmode				beq bwPpix_fin				cmp #%00110000				bne bwPpix_fin				lda #%10100000bwPpix_fin		ldx #0				brl gotPvaluecolorPpix				lda KCMY_lookup,y			;convert $0RGB to $KCMY with table				ldy colorstr         		;branch on the color being printed and				cpy #s_printyel       		;extract proper K, C, M, or Y nibble				beq yelPpix				cpy #s_printmag				beq magPpix				cpy #s_printcyn				beq cynPpixblkPpix				xba				ldx #0				bra gotPvalue				cynPpix				lsr a				lsr a				lsr a				lsr a				ldx #3				bra gotPvalue				magPpix				ldx #3				bra gotPvalue				yelPpix				asl a				asl a				asl a				asl a				ldx #3												gotPvalue									;A=print density, 0..15 * 16 (in upper nibble)				and #$F0               		;X=dither pattern offset, 0=blk 3=CMY				sta colortemp         		;(keeps black from overprinting color)				bne isPnonzeroisPzero										;save some work if density is 0				clc                    		;fake the changes that would be made				lda DitherH          		;if we continued with this pixel				adc hScaling				sta DitherH				lda lineoffset				clc				adc hScaling				sta lineoffset				lda ActionBits				and #abIWMode				bne Ppixeldone				lda lineoffset				clc				adc hScaling				adc hScaling				sta lineoffset				bra Ppixeldone				isPnonzero									;nonzero density, print it into linebuffer				lda ActionBits				and #abIWMode				;check if IW-mode & 320-mode & color-mode are in effect				beq isPnz_no2i				lda ThisLMode				bne isPnz_no2i				lda QualBits				bpl isPnz_no2i				asl colortemp				;do 2x density, compensate for wider-spread printer dots				lda colortemp				;and pin overflow				and #$FF00				beq isPnz_no2i				lda #$F0				sta colortempisPnz_no2i		lda #1				sta LineDirty				txa                     	;calculate dithmatrix offset based on				clc                 		;...density & offset				adc DitherH					;add DitherH value, which just increases all the time				and #%0111					;take only least significan bits and make into word index				asl a				ora colortemp          		;select density level; now have offset into dithmatrix				tax				ldy hScaling            	;call the pixel plot routine based on				dey                  		;the horizontal scaling				dey				bmi PpixelX1				beq PpixelX2PpixelX3		jsr onePpixel1        		;hScaling=3: full sizePpixelX2		jsr onePpixel1            	;hScaling=2: 2/3 sizePpixelX1		jsr onePpixel1          	;hScaling=1: 1/3 sizePpixeldone				dec horPcount         		;see if more pixels to print				bne stillonP             	;if not, stop caller (onePline) by pulling				ply                     	;RTS address from stackstillonP				ply							;restore index into pixel line				rts**********onePpixel1									;do stack pointer -6 to exit the current line				inc DitherH               	;X=dithmatrix offset				lda dithmatrix,x           	;get dither pattern				inx							;advance to next word of dither pattern				inx				and pixelbits           	;apply mask for this pixel line				ldy lineoffset           	;get offset into linebuffer				cpy crWidthX3             	;make sure we're not at end				bge offPend				ora linebuffer,y      		;OR masked pattern into buffer				sta linebuffer,y				iny							;increase line buffer position by 1 for IW mode				lda ActionBits				and #abIWMode				bne oneppix_iw				iny							;increase line buffer position by 3 for LQ mode				inyoneppix_iw		sty lineoffset				txa                     	;move to next byte of 8x8 pattern				and #$0F				bne Pxisok                	;see if we wrapped to next dith. level				sec                    		;if so, go back to beginning of this				txa                    		;...dither density level				sbc #$10				taxPxisok				rtsoffPend										;at end of linebuffer: stop caller caller (onePline)				pla                    		;by pulling 2 RTS addresses and a				pla                     	;pushed Y from the stack				pla				rts												s_printyel		dc.b	3	           		;select ribbon band				dc.b	$1B,$4B,$31s_printcyn		dc.b	3				dc.b	$1B,$4B,$33s_printmag		dc.b	3				dc.b	$1B,$4B,$32s_printblk		dc.b	3				dc.b	$1B,$4B,$30s_printBW		dc.b	1	         		;nothing to do in grayscale printing				dc.b	$00	s_lf			dc.b	5	                ;LF=16/144", do LF	   			dc.b	$1B,$54	   			dc.b	'16'	   			dc.b	$0A			Pwht_enabl		dc.w	0					;white-elim: enable scan (ie, pure white is present)Pwht_oldbp		dc.w	0					;white-elim: old byte position before scanPwht_lbinc		dc.w	0					;white-elim: linebuffer index increment during scanPbw6_enabl		dc.w	0					;black/white-img: enable (ie, pure b/w in std locations)********************************************************************************Lbandloop									;*** LANDSCAPE MODE PRINTING LOOP ***LwhtQualfy		stz Lwht_enabl				;attempt to see if conditions permit white-elim shortcut				stz Lwht_maxce				;clear enable and init maximum color table entry used								lda SCBListPtr+0				ora SCBListPtr+2				bne LwhtCkSCB				;if SCB list was specified, as it must be, go check it				lda MasterMode				;else skip SCB list test - use master mode and 0 maxce				sta Lwht_mode				bra LwhtFndWht				LwhtCkSCB		lda [SCBListPtr]			;all SCB list entries must be the same mode				and #$0080					;find out which mode				sta Lwht_mode								ldy PixMapHigh				;get ready to search the rest of SCB list...				lda QualBits				;infer SCB list size from tallness of pixmap				and #qbBetter				;and scale tallness down if Better mode				beq LwhtCkSCBs				lda QualBits				and #%00011000				beq LwhtCkDiv3				cmp #%00001000				bne LwhtCkSCBsLwhtCkDiv2		tya							;/2 if Better & 66%				lsr a				tay				bra LwhtCkSCBsLwhtCkDiv3		pha							;/3 if Better & 100%				pha				phy				pushword #3				_UDivide				ply				pla				LwhtCkSCBs		dey							;do search SCB list, y has length of list, from y-1 to 0				cpy #$FFFF				beq LwhtCkSCBxLwhtCkSCBa		lda [SCBListPtr],y				tax				and #$0080					;each line must be same mode				cmp Lwht_mode				bne LwhtCant				txa				and #$000F					;find out maximum color table entry used				cmp Lwht_maxce				bcc LwhtCkSCBs				sta Lwht_maxce				bra LwhtCkSCBsLwhtCkSCBxLwhtFndWht		lda Lwht_maxce				;check for pure white in standard color table entries...				asl a						;set white-checking-loops range-limits to lastmost item				asl a						;in the last color table used by any of the lines/SCBs				asl a						;(max_color_entry_used_0_to_15 * 32) + 30				asl a				asl a				clc				adc #30				sta LwhtFndW6l+1				sta LwhtFndW3l+1				lda Lwht_mode				;go do appropriate white-checker...				beq LwhtFndW3				LwhtFndW6		ldy #3*2					;640-mode pure-std-white testLwhtFndW6s		lda [CTablePtr],y			;test last of all 4 minipallettes of all 16 ctbl entries				cmp #$FFF				bne LwhtCantLwhtFndW6l		cpy #$0000					;NOTE: this operand is stuffed				beq LwhtItsOk				tya				clc				adc #8				tay				bra LwhtFndW6s				LwhtFndW3		ldy #15*2					;320-mode pure-std-white testLwhtFndW3s		lda [CTablePtr],y			;test last palette of all 16 ctbl entries				cmp #$FFF				bne LwhtCantLwhtFndW3l		cpy #$0000					;NOTE: this operand is stuffed				beq LwhtItsOk				tya				clc				adc #32				tay				bra LwhtFndW3s				LwhtItsOk		lda #1						;here if all tests passed and it's ok to take shortcut				sta Lwht_enabl		   LwhtCant									;here if any Lwht test failed**********Lbandloops		lda PixMapWide      		;check if more columns to print				beq allLbands				jsr IdleProcAbortErrCheck 	;caller's idle proc or our option-period abort check				lda prError				bne allLbands				lda QualBits				bmi LcolorbandLbwband				lda #s_printBW         		;print one grayscale band				jsr oneLband				bra nextLband				Lcolorband									;print the color bands				jsr saveinfo				lda #s_printyel				jsr oneLband				jsr restinfo				lda #s_printmag				jsr oneLband				jsr restinfo				lda #s_printcyn				jsr oneLband				jsr restinfo				lda #s_printblk				jsr oneLband				nextLband				lda #s_lf            		;advance printer 1/9"				jsr writeshort				bra Lbandloops				allLbands				rts**********oneLband									;print one landscape mode band				sta colorstr          		;remember what color it is				jsr clearline				lda crWidthX3				sta linebase				lda hScaling         		;branch based on hor. scaling				dec a				dec a				bmi goLlineX1				beq LlineX2				LlineX3										;hScaling=3: full size				lda #%0000000000000111    	;2 bytes of pixel data per 24-dot band				sta Lpixmask1            	;3 dots per 640-mode pixel				lda #%0000000000111000				ldx #%0000000111000000				ldy #%0000111000000000				jsr oneLline				jsr nextLline				inc linebase				lda #%0000000001110000				sta Lpixmask1				lda #%0000001110000000				ldx #%0001110000000000				ldy #%1110000000000000				jsr oneLline				jsr nextLline				brl Lbanddone				goLlineX1		brl LlineX1      			;extend branch rangeLlineX2										;hScaling=2: 2/3 size				lda #%00000011            	;3 bytes of pixel data per band				sta Lpixmask1            	;2 dots per 640 pixel				lda #%00001100				ldx #%00110000				ldy #%11000000				jsr oneLline				jsr nextLline				inc linebase				lda linebase				dec a				dec a				dec a				cmp crWidthX3				blt LlineX2				bra Lbanddone				LlineX1										;hScaling=1: 1/3 size				lda #%00000001        		;6 bytes of pixel data per band				sta Lpixmask1            	;1 dot per 640 pixel				lda #%00000010				ldx #%00000100				ldy #%00001000				jsr oneLline				jsr nextLline				lda #%00010000				sta Lpixmask1				lda #%00100000				ldx #%01000000				ldy #%10000000				jsr oneLline				jsr nextLline				inc linebase				lda linebase				dec a				dec a				dec a				cmp crWidthX3				blt LlineX1				bra Lbanddone				Lbandexit									;nextLline has aborted this band				plaLbanddone				jsr LQsendbuff           	;band generated, send it to the LQ				rtsnextLline									;common routine to advance to next				inc PixMapBase+0      		;...column of pixmap bytes				bne noinchiL				inc PixMapBase+2noinchiL				dec PixMapWide          	;abort oneLband if at right edge				beq Lbandexit				dec PixMapWide				beq Lbandexit				dec PixMapWide				beq Lbandexit				dec PixMapWide				beq Lbandexit				rts**********Lpixmask1		ds.b 2						;masks for the 4 pixels per pixmap byteLpixmask2		ds.b 2Lpixmask3		ds.b 2Lpixmask4		ds.b 2Lwht_enabl		dc.w 0						;flag if conditions permit white-elim shortcutLwht_mode		dc.w 0						;320/640-mode indicator for white-elim shortcutLwht_maxce		dc.w 0						;max-found ctbl-select among SCBs for white-elim shortcut**********oneLline									;generate data for one column of bytes				sta Lpixmask2				stx Lpixmask3				sty Lpixmask4				lda linebase				sta lineoffset				stz DitherH				stz horPcount				ldy #oWidth					;set up byte-increment-factor for code below				lda [SrcLocPtr],y				sta Lwht_btinc+1				pha							;result space				pha							;result space				pha							;pass pixmap width				pushword PixMapHigh			;pass pixmap tallness				_Multiply				pla							;set up byte-end-value with lo word of width*tall				sta Lwht_btend+1				pla				lda vScaling				;set up scaling factors for code below				sta Lwht_dhinc+1			;for updating "DitherH" value				asl a				clc				adc vScaling				sta Lwht_lodec+1			;for updating "lineoffset value"									ldy #0						;init byte counter at top of (off-) screen column**********Lbyteloop 									;looping vert down for bytes within column; Y valid				lda Lwht_enabl				;see if ctbl/scb conditions permit quick-white-checking				beq LwhtDoImg				LwhtScan		lda [PixMapBase],y			;try to quickly eliminate bytes as all-std-white				and #$00FF				cmp #%11111111				;320 (2 pix) or 640 (4 pix) all-std-white check				bne LwhtDoImg				;break off search as soon as we get nonwhite				lda lineoffset				;update counter used for linebuffer indexingLwht_lodec		sbc #$0000					;NOTE: carry always set here, NOTE: operand is stuffed				sta lineoffset				lda DitherH					;update counter so as not to interrupt patterns				clcLwht_dhinc		adc #$0000					;NOTE: this operand is stuffed				sta DitherH				inc horPcount				;update counter used for scb indexing				tya							;update Y-reg counter used for scrn pix byte access				clcLwht_btinc		adc #$0000					;NOTE: this operand is stuffed				tayLwht_btend		cpy #$0000					;NOTE: this operand is stuffed				bne LwhtScan				rts							;if we got this far, exit without having done imagingLwhtDoImg				lda MasterMode         		;goes top to bottom				sta ThisLMode          		;(right to left in linebuffer)				lda MasterPal				sta ThisLPal				lda SCBListPtr+0         	;if SCBList was specified, as it must be, get mode &				ora SCBListPtr+2          	;palette number from it				beq gotheLmode				phy				clc				lda SCBTabBase				adc horPcount				tay				lda QualBits            	;if in Better Text mode, we must				and #qbBetter             	;scale the SCBList index down by the				beq gotLindex            	;same amount the printer driver				lda QualBits            	;scaled the pixelmap up				and #%00011000				beq Ldivby3				cmp #%00001000				bne gotLindex            	;1/3 size: no scalingLdivby2										;2/3 size: scaled by a factor of 2				tya				lsr a				tay				bra gotLindexLdivby3										;full size: scaled by a factor of 3				pha				pha				phy				PushWord #3				_UDivide				ply				plagotLindex				lda [SCBListPtr],y				and #$0080				sta ThisLMode				lda [SCBListPtr],y				and #$000F				sta ThisLPal				plygotheLmode				lda ThisLPal				asl a				asl a				asl a				asl a				asl a				sta ThisLPal				lda lineoffset				sta saveoffset				lda DitherH				sta savedither				lda ThisLMode          		;branch based on pixel line's mode				bne Lbyte640		   Lbyte320				lda Lpixmask1           	;OR together masks for two 640 pixels				ora Lpixmask2            	;to get mask for one 320 pixel				tax				lda [PixMapBase],y				lsr a				lsr a				lsr a				lsr a				jsr oneLpixel           	;left pixel				lda PixMapWide         		;abort if right edge of pixmap is in				cmp #3                    	;the middle of a byte				blt goLbdonelt				jsr restpixel				lda Lpixmask3             	;OR together other two 640 mode masks				ora Lpixmask4				tax				lda [PixMapBase],y				jsr oneLpixel            	;right pixel				bra nextLbyte				Lbyte640				lda [PixMapBase],y				asl a				asl a				xba				and #%0011				ldx Lpixmask1				jsr oneLpixel       		;first 640 mode pixel				lda PixMapWide      		;abort if at pixmap right edge				cmp #2goLbdonelt		blt Lbytedone				jsr restpixel				lda [PixMapBase],y				lsr a				lsr a				lsr a				lsr a				and #%0011				ora #%0100				ldx Lpixmask2				jsr oneLpixel            	;second pixel				lda PixMapWide          	;abort if at right edge				cmp #3				blt Lbytedone				jsr restpixel				lda [PixMapBase],y				lsr a				lsr a				and #%0011				ora #%1000				ldx Lpixmask3				jsr oneLpixel           	;third pixel				lda PixMapWide          	;abort if at right edge				cmp #4				blt Lbytedone				jsr restpixel				lda [PixMapBase],y				ora #%1100				ldx Lpixmask4				jsr oneLpixel           	;last pixel		   nextLbyte									;advance to next byte in column				tya				ldy #owidth				clc				adc [SrcLocPtr],y				tay				inc horPcount				lda horPcount            	;see if at bottom of column				cmp PixMapHigh				bge Lbytedone				lda lineoffset        		;or at bottom of linebuffer				bmi Lbytedone				brl Lbyteloop				Lbytedone				rtssaveoffset		ds.b 2savedither		ds.b 2restpixel									;undo variable changes made by all				lda saveoffset       		;pixels within a byte except the last				sta lineoffset				lda savedither				sta DitherH				rts**********oneLpixel									;generating data for one pixel				phy                      	;save offset into pixelmap				stx pixelbits           	;X=mask for this pixel within buffer				and #$000F					;A=pixel value				asl a                   	;convert into colortable index				ora ThisLPal				;and add SCB palette-select-value				tay							;Y now has offset into color table for current pixel								ldx colorstr            	;branch based on color/grayscale mode				cpx #s_printBW				bne colorLpix				bwLpix										;convert RGB to grayscale:				lda [CTablePtr],y			;obtain RGB value				and #$0FFF				xba				and #$000F                 	;R				sta colortemp				asl a				asl a                   	;4R				adc colortemp				sta colortemp          		;5R				lda [CTablePtr],y				lsr a				and #%01111000            	;8G				clc				adc colortemp            	;5R+8G				tax				lda [CTablePtr],y				and #$000F               	;B				sta colortemp				txa				eor #$FF                 	;255-5R-8G				sec				sbc colortemp             	;255-5R-8G-B				sbc colortemp           	;255-5R-8G-2B				sbc colortemp              	;255-5R-8G-3B				and #%11110000				;do adjustment to avoid destructive interference				beq bwLpix_fin				;between our and 640's dithering				ldx thisLmode				beq bwLpix_fin				cmp #%00110000				bne bwLpix_fin				lda #%10100000bwLpix_fin		ldx #0				brl gotLvaluecolorLpix				lda KCMY_lookup,y			;convert $0RGB to $KCMY with table				ldy colorstr              	;branch based on color being printed				cpy #s_printyel           	;and get proper K, C, M, or Y nibble				beq yelLpix				cpy #s_printmag				beq magLpix				cpy #s_printcyn				beq cynLpix		   blkLpix				xba				ldx #0				bra gotLvalue				cynLpix				lsr a				lsr a				lsr a				lsr a				ldx #3				bra gotLvalue				magLpix				ldx #3				bra gotLvalue				yelLpix				asl a				asl a				asl a				asl a				ldx #3				gotLvalue									;A=print density, 0..15				and #$F0                  	;X=dither matrix offset, blk=0 CMY=3				sta colortemp            	;(keeps black from overprinting color)				bne isLnonzeroisLzero										;save some work if density is zero				clc                       	;fake changes that would have been				lda DitherH                	;made if this pixel printed				adc vScaling				sta DitherH				lda lineoffset				sec				sbc vScaling				sec				sbc vScaling				sec				sbc vScaling				sta lineoffset				bra Lpixeldone				isLnonzero				lda #1				sta LineDirty				txa                    		;calculate index into dither matrix				clc				adc DitherH				and #%0111				asl a				ora colortemp           	;A=offset into dithmatrix				tax				ldy vScaling             	;branch based on vertical scaling				dey				dey				bmi LpixelX1				beq LpixelX2				dey				dey				bmi LpixelX3				beq LpixelX4LpixelX6		jsr oneLpixel1         		;vScaling=6: full size				jsr oneLpixel1LpixelX4		jsr oneLpixel1             	;vScaling=4: 2/3 sizeLpixelX3		jsr oneLpixel1            	;vScaling=3: full size condensedLpixelX2		jsr oneLpixel1            	;vScaling=2: 1/3 size, 2/3 condensedLpixelX1		jsr oneLpixel1       		;vScaling=1: 1/3 size condensedLpixeldone				ply				rtsoneLpixel1									;do stack pointer -6 to exit current line				inc DitherH              	;X=dithmatrix offset				lda dithmatrix,x     		;get dither pattern based on desired				inx                     	;density and offset				inx				and pixelbits        		;apply mask for this pixel				ldy lineoffset          	;get offset into linebuffer				dey				dey				dey				bmi Lxisok            		;make sure we're still within buffer				ora linebuffer,y   			;OR masked pattern into buffer				sta linebuffer,y				sty lineoffset				txa				and #$0F				bne Lxisok          		;see if we wrapped to next dith. level				sec                 		;if so, go back to 1st pattern for				txa                 		;...this dither density level				sbc #$10				taxLxisok				rts*********************************************************************************LQSENDBUFF/COMPRESSEND: Run-length-encoding data compression and transmission:**The following routine sends data in line buffer to printer appropriately whether the IW or*LQ resolution mode is selected.  The IW or LQ print-graphics commands are interspersed with*positioning and/or run-length-encoding commands: if a run of N or more identical groups of*byte(s) is detected, then the print-multiple-graphics-columns command is used for nonzero*data, while the position-print-head command is used for a run of zero data.*LQSendBuff:				lda LineDirty       		;if no data, don't bother printing				beq noline				stz LineDirty				;initialize did-we-use-ink-yet flag				jsr CompressSend				lda LineDirty          		;if no data was found, don't do CR				beq noline				lda #s_cr             		;return to left margin for next band				jsr writeshortnoline			rtsCompressSend:								shortx						;set up printer commands for selected resolution mode				lda ActionBits				and #abIWMode				beq cs_lqmode				ldx #$46					;IW mode command setup...				stx poscommand				ldx #7				stx rptcommand1				ldx #$56				stx rptcommand2				ldx #$47				stx grcommand				ldx #RunLenEncodeThreshIW-2				stx cs_rept_thresh+0				bra cs_fimodecs_lqmode		ldx #$68					;LQ mode command setup...				stx poscommand				ldx #9				stx rptcommand1				ldx #$55				stx rptcommand2				ldx #$43				stx grcommand				ldx #RunLenEncodeThreshLQ-2				stx cs_rept_thresh+0cs_fimode		longxcs_init			stz cs_curr_pos				;initialize logical head positions for scan...				stz cs_nor_start				stz cs_nor_end				stz cs_rle_start				stz cs_curr_stat			;init state: 0=norm data, 1=maybe rle, 2=definetely rle				stz cs_rept_ctr				;init repeat counter for going from state 1 to state 2				lda LineBuffer+0			;init "last group" to be always diff from first group...				ina				sta cs_last_group+0				cs_test			lda ActionBits				;cmp curr group w/ last group, separate for iw/lq modes				and #abIWmode				bne cs_test_iw				cs_test_lq		lda cs_curr_pos				;curr_pos*3 if LQ mode for buff index (3 bytes per group)				asl a				clc				adc cs_curr_pos				tay				lda LineBuffer+0,y			;do 3-BYTE (we're in 16 bit mode right now) compare...				cmp cs_last_group+0				bne cs_diff				shortm				lda LineBuffer+2,y				cmp cs_last_group+2				longm				bne cs_diff				beq cs_same				cs_test_iw		ldy cs_curr_pos				;do 1-BYTE (in 16 bit mode now) compare...				shortm				lda LineBuffer,y				cmp cs_last_group				longm				bne cs_diff				cs_same 		lda cs_curr_stat			;current group is equal to group from last time...				cmp #2						;if state=2, do nothing				beq cs_next				cmp #1						;if state=1, see if time to -> state 2 and do norm output				bne cs_same_0				cs_same_1		inc cs_rept_ctr				;inc repeat counter; if less than thresh, get next group				lda cs_rept_ctr				cmp cs_rept_thresh				bcc cs_next				lda #2						;else, go to state 2 and do normal output				sta cs_curr_stat				ldx cs_nor_start			;do normal output from nor_start to nor_end-1...				ldy cs_nor_end				jsr cs_do_output_nor				bra cs_next				cs_same_0		lda #1						;goto state 1, clr repeat ctr, set possible rept start...				sta cs_curr_stat				stz cs_rept_ctr				lda cs_curr_pos				dea				sta cs_rle_start				bra cs_next				cs_diff			lda cs_curr_stat			;current group is not equal to group from last time...				bne cs_diff_12				;we handle state 0 first since it's most common:		   cs_diff_0		lda cs_curr_pos				;diff/state 0: state stays 0, track nor_end with curr_pos				sta cs_nor_end				bra cs_next				cs_diff_12		cmp #1				bne cs_diff_2		   cs_diff_1		stz cs_rept_ctr				;diff/state 1: state=0, clr ctr, track nor_end as above				stz cs_curr_stat				lda cs_curr_pos				sta cs_nor_end				bra cs_next				cs_diff_2		stz cs_curr_stat			;diff/state 2: state=0, reset nor start/end, do rle out				lda cs_curr_pos				sta cs_nor_start				sta cs_nor_end				ldx cs_rle_start			;do rle output from rle_start to curr_pos-1...				ldy cs_curr_pos				jsr cs_do_output_rle		;do it, then drop thru to cs_next				cs_next			lda ActionBits				;next position: set last_group, increment, see if done...				and #abIWmode				bne cs_next_iw				cs_next_lq		lda cs_curr_pos				;form index into line buffer and copy 3 BYTES...				asl a				clc				adc cs_curr_pos				tay				lda LineBuffer+0,y			;copy first two bytes				sta cs_last_group+0				shortm						;copy third byte				lda LineBuffer+2,y				sta cs_last_group+2				longm				bra cs_next_in				cs_next_iw		ldy cs_curr_pos				;copy 1 BYTE from line buffer...				shortm				lda LineBuffer,y				sta cs_last_group				longm				cs_next_in		inc cs_curr_pos				;increment current position, loop until = crWidth...				lda cs_curr_pos				cmp crWidth				bcs cs_flush				brl cs_test					   cs_flush		lda cs_curr_stat			;final flush: check status...				cmp #2				beq cs_flush2				cs_flush01		ldx cs_nor_start			;flush/status=0 or 1: nor out fr nor_start to curr_pos-1				ldy cs_curr_pos				jsr cs_do_output_nor				rts							;and exit				cs_flush2		ldx cs_rle_start			;flush/status=2: rle output from rle_start to curr_pos-1				ldy cs_curr_pos				jsr cs_do_output_rle				rts							;and exit**Normal printer output command subroutine for CompressSend (from -> X, to -> Y):*cs_do_output_nor:							;from -> X, to -> Y				stx cs_num_output			;1) to=to-1   2) cs_num_output=to-from   3) if -1 exit				stx cs_frm_output				dey				tya				sec				sbc cs_num_output				cmp #$FFFF				beq cs_nor_xit				ina				sta cs_num_output								lda LineDirty				;have we ever printed yet on this head scan?				bne cs_nor_dty				;yes we have, so skip next few lines				lda #1						;else, mark for next time because we're about to use ink				sta LineDirty				lda colorstr				;also, select proper color before printing first time				jsr writeshort				cs_nor_dty		pushword cs_num_output		;convert cs_num_output (the length) to ascii for command				pushlong #grstr				pushword #4				pushword #0				_Int2Dec								lda #s_graphics				;send command to print nonrepeating graphics...				jsr writeshort								lda ActionBits				;if LQ mode, triple cs_num_output so can use it to index				and #abIWmode				bne cs_nor_blt				lda cs_num_output				asl a				clc				adc cs_num_output				sta cs_num_output				lda cs_frm_output			;also triple cs_frm_input so we can use it to index				asl a				clc				adc cs_frm_output				sta cs_frm_output				cs_nor_blt		lda #LineBuffer				;send gr data, from=LB+cs_frm_output; len=cs_num_output				ldx #^LineBuffer				clc				adc cs_frm_output			;assuming no bank cross here				ldy cs_num_output				jsr writelong		   cs_nor_xit		rts**Run-length-encoding-posn pr output cmd subroutine for CompressSend (from -> X, to -> Y):*cs_do_output_rle:							;from -> X, to -> Y				stx cs_num_output			;1) to=to-1   2) num_output=to-from   3) if 0 or -1 exit				stx cs_frm_output				dey				tya				sec				sbc cs_num_output				beq cs_rle_xit				cmp #$FFFF				beq cs_rle_xit				ina				sta cs_num_output								lda ActionBits				;check which mode is in effect				and #abIWmode				bne cs_rle_iw				cs_rle_lq		lda cs_frm_output			;triple "from" value to form index				asl a				clc				adc cs_frm_output				tax				lda LineBuffer+0,x			;check to see if all 3 BYTES of the start group are zero				ora LineBuffer+1,x				beq cs_rle_psn				;all zero, so do positioning instead of graphics output				bra cs_rle_rpt				cs_rle_iw		shortm						;check to see if first BYTE of the start group is zero				lda LineBuffer,x				longm				beq cs_rle_psn				;zero, so do positioning instead of graphics output		   cs_rle_rpt		lda LineBuffer+0,x			;store 3 rept group bytes in cmd seq regardless of mode				sta rptdata+0				shortm				lda LineBuffer+2,x				sta rptdata+2				longm								lda LineDirty				;have we ever printed yet on this head scan?				bne cs_rle_dty				;yes we have, so skip next few lines				lda #1						;else, mark for next time because we're about to use ink				sta LineDirty				lda colorstr				;also, select proper color before printing first time				jsr writeshort				cs_rle_dty		pushword cs_num_output		;convert number of prpix to print to ascii...				pushlong #rptstr				pushword #4				pushword #0				_Int2Dec								lda #s_repeating			;send command to print repeating graphics				jsr writeshort		   cs_rle_xit		rtscs_rle_psn		iny							;move print head to "to" prpix posn still in Y:				cpy crWidth					;if about to do posn to crWidth-1, don't do it; it is				beq cs_rle_xit				;inefficient and it doesn't like posn followed by nothing				phy							;convert to ascii; doing posn to "to"+1...				pushlong #posstr				pushword #4				pushword #0				_Int2Dec								lda #s_position				;send command to do head position				jsr writeshort				rts**Variables for CompressSend:*cs_curr_pos		dc.w	0					;curr headscan posn (logical posn; NOT LineBuffer index)cs_curr_stat	dc.w	0					;curr state: 0=normal; 1=rle candidate; 2=confirmed rlecs_nor_start	dc.w	0					;headscan logical posn of start of normal (non-rle) datacs_nor_end		dc.w	0					;headscan logical posn of end of normal datacs_rle_start	dc.w	0					;headscan logical posn of start of run for run-len-encodecs_rept_ctr		dc.w	0					;repeat count for run-length-encoding candidatecs_rept_thresh	dc.w	0					;threshold of when to start doing a run-len-encodecs_num_output	dc.w	0					;number of prpix to output, used by output subroutinescs_frm_output	dc.w	0					;value of "from" parameter, used by output subroutinescs_last_group	ds.b	3					;last group of 1 or 3 bytes representing last pins fire**Printer command sequences for CompressSend:*s_position		dc.b	6					;position-print-head command sequence				dc.b	$1Bposcommand		dc.b	$68					;$68 for IW_LQ positioning; $46 for IW_II positioningposstr			dc.b	'0000's_repeating 								;print-repeat-graphics command sequencerptcommand1		dc.b	9					;9 for IW_LQ repeating; 7 for IW_II repeating				dc.b    $1Brptcommand2		dc.b	$55					;$55 for IW_LQ repeating; $56 for IW_II repeatingrptstr			dc.b	'0000'rptdata			dc.b	0,0,0s_graphics		dc.b	6					;print-graphics command sequence (is followed by data)				dc.b	$1Bgrcommand		dc.b	$43					;$43 for IW_LQ gr (slow); $47 for IW_II gr (fast)grstr			dc.b	'0000's_cr			dc.b	1					;output-carriage-return command sequence				dc.b	$0D*********************************************************************************IDLEPROCABORTERRCHECK: Periodically-called status checker:**Printer status, user abort, and idleproc caller. Should be called before any long data blast, after*unsuccessful I/O, or any request for change in connection status (such as PrDevOpen/Close calls):**1. Does PrDevStatus call, and if (network) port driver error condition, sets prError and exits.*2. If the imager was passed a non-NIL idleproc, then save enviroment and execute it.  Note*   that the Option-Period-check will still execute after the idleproc finishes.*3. Check for Option-Period; if pressed, set prError and exit.  Note that this kind of exit*   code has precedence over (will override) any errors from the PrDevStatus call.*IdleProcAbortErrCheck:								stz status_buff+5			;clear status buff word which is checked below to be safe								pushlong #status_buff		;(1) do status call, which works best on networks...				ldx #$2013				jsl $E10000					;_PrDevStatus				bcc e_notdstat								pushlong #status_buff		;if error, try status call one more time				ldx #$2013				jsl $E10000					;_PrDevStatus				bcc e_notdstat								lda #$0081					;if err, exit with our communications-err result code				bra e_strerre_notdstat								lda status_buff+5			;get the status word, if any, from bytes 5,6... this info				tax							;comes from atalk board in the printer, else it's zero								txa							;*** Printer Busy? ***				;     5432109876543210				and #%1000000000000000		;printer-busy flag				beq e_notbusy				lda is_our_conn				;printer busy AND we're not connected yet?				bne e_notbusy				;if so then someone else is using it				lda #$008F				bra e_strerr				;if so then exit with our printer-is-busy result codee_notbusy								txa							;*** Out Of Paper? ***				;     5432109876543210				and #%0000000000100000		;out-of-paper flag				beq e_notpapr				txa				;     5432109876543210				and #%0000000001000000		;has-feeder flag: if no paper b/c sheet feeder, no err				bne e_notpapr				lda #$0082				bra e_strerre_notpapr								txa							;*** Paper Jammed? ***				;     5432109876543210				and #%0000000000000100		;paper-jam flag				beq e_notjam				lda #$0083				bra e_strerre_notjam								txa							;*** Cover Open? ***				;     5432109876543210				and #%0000000000010000		;cover-open flag				beq e_notcvr				lda #$0084				bra e_strerre_notcvr								txa							;*** Select Switch Off? ***				;     5432109876543210				and #%0000000000001000		;select-off flag				beq e_ckidle				lda #$0085				e_strerr		sta prError		   e_ckidle		lda IdleProcPtr+0			;(2) if NIL, user didn't specify idleproc				ora IdleProcPtr+2				beq no_iproc								lda IdleProcPtr+0			;else build JSL instruction to user...				sta goto_user+1				lda IdleProcPtr+2				shortm				sta goto_user+3				longm								phb							;save environment				phd				goto_user		jsl $FFFFFF					;goto user procedure; I can't believe I'm doing this...								pld							;restore env; drop through to our command-period check				plb				no_iproc		pha							;(3) now check if command-period was pressed				pushword #$0008           	;keyDownMask				pushlong #eventrec				_GetNextEvent				pla				beq noevent								lda eventmsg				and #$00FF				cmp #'.'					;period				bne noevent								lda eventmod				and #$0100            		;appleKey				beq noevent								lda #$0080					;this will overwrite/override any error obtained above				sta prErrornoevent				rtseventreceventwhat		ds.b 2eventmsg		ds.b 4eventwhen		ds.b 4eventwhere		ds.b 4eventmod		ds.b 2status_buff		ds.b 256					;yes, it has to be this big (we only get 2 bytes from it)											;status_buff+5 contains the following bits:											;0=head moving, 1=fault, 2=jam, 3=off line,											;4=cover open, 5=out of paper, 6=has feeder, 7=has color											;15=printer busy*******************************************************************************crWidth			ds.b 2           			;carriage width in printer dotscrWidthX3		ds.b 2          			;crWidth times 3vScaling		ds.b 2          			;printer dots per vertical pixelhScaling		ds.b 2           			;printer dots per horizontal pixelprError			ds.b 2            			;error status ($80=abort; other codes possible)linebuffer		ds.b 3*3264+2+24    		;max 13.6", 240 DPI, 3 bytes/column + BW6 alg overrun**Printer-pixel scaling lookup tables; entries are printer pixels per 640-mode*off-scrn pixels, indexed by low 5 bits of QualityBits:*vscaletab:* Better ------>       x   x   x   x* Landscape --->         x x     x x* Condensed --->             x x x x			dc.b	 6,2,6,2,3,1,3,1	;full size			dc.b	 4,2,4,2,2,1,2,1	;2/3 size			dc.b	 2,2,2,2,1,1,1,1	;1/3 sizehscaletab:* Better ------>       x   x   x   x* Landscape --->         x x     x x* Condensed --->             x x x x			dc.b	 3,1,3,1,3,1,3,1	;full size			dc.b	 2,1,2,1,2,1,2,1	;2/3 size			dc.b	 1,1,1,1,1,1,1,1	;1/3 size*******************************************************************************				endproc				end