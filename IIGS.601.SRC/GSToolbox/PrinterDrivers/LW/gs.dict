**************************************************************************** Miscellaneous notes and thoughts***************************************************************************; All procedures called from the driver requiring coordinates as input;    parameters accepts them in y x order because that's how QuickDraw II;    specifies them; Advantage of listing all the fonts used at the beginning of the document:;    font coordination only need to happen once for the entire document,;    rather than being done each page it is used due to save and restores.**************************************************************************** Set up stuff***************************************************************************;-------------------------------------------------------------------------; Set the packing capability if it exists on the printer;; is the key setpacking in the system dictionary?; execute the array if packing capability exists; save the current packing mode of the system for restoration when we're;  done with our job; turn on packing;systemdict /setpacking known{/svpack currentpacking def true setpacking}if; ------------------------------------------------------------------------; create our 200 entry dictionary and put all definition into our dict;/GSd 200 dict def GSd begin******************************************************************* Global variables******************************************************************;------------------------------------------------------------------------; temp strings; ; 75 characters long; 40 characters long; 1 character long, initialized with a space;/tstr 75 string def/ct 40 string def/s1( )def;------------------------------------------------------------------------; temp matrices;/mtx matrix def/mx1 matrix def;------------------------------------------------------------------------; temp arrays; ; 16 elements in array;/colorarray 16 array def;------------------------------------------------------------------------;; Initialize flags and other variables;; Encode with Apple Encooding Vector flag, used in font building procedures; screen length, used in line layout; printer length, used in line layout; /Fav T def/snl 0 def/prl 0 def******************************************************************* Redefinition of PostScript operators for faster transmission* or error recovery******************************************************************; ------------------------------------------------------------------------; Booleans;/T true def/F false def; ------------------------------------------------------------------------; Definition procedures;/bdf {      bind def     } bind def/xdf {      exch def     } bdf/ldf {      load def     } bdf; ------------------------------------------------------------------------; Redefine divide to avoid dividing by zero; operands are the same as those for the PostScript div;/dv {      dup 0 ne      {div}{pop}ifelse     } bdf******************************************************************* Status******************************************************************; ------------------------------------------------------------------------; LaserWriter:  -- "LW" T (remainder of string) or F; checks if printer is a member of the LaserWriter family;; save the current state of VM; look in the status dictionary for the printer type; anchorsearch leaves both the remainder of the string and the pattern;  on the stack if matched and the pattern if not matched, ; make a copy of the boolean; if matched, get rid of the pattern, leaving the boolean and remainder ;  of string on the stack and move the savelevel to the top of stack; if not, get rid of the original string and leave the boolean, and;  move the savelevel to the top of stack;/LW {     save     statusdict /product get     (LaserWriter)anchorsearch dup      {exch pop 3 -1 roll}      {exch pop exch}ifelse     restore    } bdf;-----------------------------------------------------------; Classic: -- "CL" boolean; ; return true if printer is a 23.0 ROM LaserWriter Classic;; find out if LaserWriter family; if so, the string returned should be empty if it's classic, and;  not empty if others. Leave this boolean on the stack as the result; if not LaserWriter family, return false;/CL {     LW	  {length 0 eq}	  {F}ifelse	} bdf	 ;-----------------------------------------------------------; Plus: -- "PL" boolean; ; return true if printer is LaserWriter Plus;; find out if LaserWriter family; if so, search the string for Plus; make a copy of the boolean; if it's found, get rid of the substrings that are returned and leave;  true on the stack; if not found, get rid of the original string and leave the false on stack; if not LaserWriter family, return false;/PL {     LW	 {(Plus) search 	  dup	  {4 1 roll pop pop pop}	  {exch pop}ifelse}	 {F}ifelse	} bdf;-----------------------------------------------------------; II family: (type str) "II" boolean; ; return true if printer is a LaserWriter II of the requested type NT or NTX;; find out if LaserWriter family; if so, search for the requested type;  if found, get rid of the pre string and the pattern;  whether the post string is empty gives the real result;  (NOTE: NT is found in NTX, but the post string is not empty, thus false);  if not found, get rid of the original string and leave the false on stack; if not LaserWriter family, return false;/II {     LW	 {exch search	  {pop pop 	   length 0 eq}	  {pop F}ifelse}	 {pop F}ifelse	} bdf; ------------------------------------------------------------------------; FreeVMemoryCheck: -- "vm" --; checks amount of free virtual memory;; save the state of things; get the status of the virtual memory results return are: level of save;  nestings, bytes currently in used, and maximum bytes available; maximum - used = free; is free less than 50000 bytes?; send a warning message if so; get rid of level; put things back the way we found it;/vm {     save     vmstatus     exch sub     50000 lt      {(%%[Warning: The current document may exceed printer memory capacity.]%%)=       flush}if     pop     restore    } bdf;-------------------------------------------------------------------------; SpotFunction: gets the spot function for this printer's implementation;; get information involved with the current screen; defines "spf" as spot function; gets rid of angle and frequency returned from "currentscreen" call;; 7/3/92	MD	"currentscreen" on most level 2 printers returns a;				halftone dictionary, which won't do as a function.;				Instead, if 'currentscreen' returns a dictionary, we;				check the type and extract the spotting function if;				it's type 1.  If not, we use a default spotting function;				we have hard-coded since we don't know where to get;				the printer's.;; 11/13/92	MD  After calling currentscreen, we need a "dup" so the "eq";				test doesn't destroy the function on the stack.  Now we;				have one.;markcurrentscreen dup type /dicttype eq      %% is the current screen a dictionary? { currentscreen begin HalftoneType 1 eq  %% if so, is HalfTone type == 1?   { currentscreen /SpotFunction get end }  %% Yup, so get the spot function and end   { {abs exch abs 2 copy add 1 gt      {1 sub dup mul exch 1 sub dup mul add 1 sub}     {dup mul exch dup mul add 1 exch sub}      ifelse} }                         %% no dict, so use this hard-coded default	                                    %% spotting function from the Personal										%% LaserWriter NTR proto board	ifelse  } if  /spf xdf                                %% store the function in /spfcleartomark                             %% restore the PostScript stack**************************************************************************** Printing loop***************************************************************************;-------------------------------------------------------------------;; OpenDoc: -- "od" --				!!!!!!!!!!!!!!!!!;; calls page setup; and transpose page;; leave these values on the stack for now; get the current matrix; use the values to do a transform; swap x and y and get the arc tangent; define "pa" as the angle; ...;/od {     psu     tx     1 0 mtx defaultmatrix dtransform exch atan     /pa xdf     newpath     clippath     mark     {transform{itransform moveto}}     {transform{itransform lineto}}     {6 -2 roll transform      6 -2 roll transform      6 -2 roll transform      {itransform 6 2 roll       itransform 6 2 roll       itransform 6 2 roll curveto}}     {{closepath}}pathforall     newpath     counttomark array astore     /gc xdf     pop     ct 39 0 put    } bdf;-------------------------------------------------------------------; OpenPage: -- "op" --;; saves the current state of the virtual memory into the variable "ols"; translate the origin to 0 0; set the pen to 1 in vertical and horizontal direction; move current point to 0 0;;/op {     /ols save def     0 0 translate     1 1 pen     0 0 moveto     } bdf;-------------------------------------------------------------------; ClosePage: -- "cp" --;; calls showpage; restores VM to original state saved in "ols";/cp {     showpage     ols restore    } bdf;-------------------------------------------------------------------; CloseDoc - not implemented, since it doesn't do anything at this; time;**************************************************************************** State saving stuff***************************************************************************;-------------------------------------------------------------------; Move Up -- "up" --             !!!!!!!!!!!!; Moves current state up one level, or rather, back one state; ;		/up{currentpoint currentgray currentlinewidth currentlinecap		 currentlinejoin currentdash snl prl pnsv pnsh colorarray		 aload pop mtx currentmatrix aload pop mx1 aload pop fz fs		 ols restore/fs		 xdf/fz xdf mx1 astore pop}bdf	;-------------------------------------------------------------------; Move Down -- "dn" --			!!!!!!!!!!!!!!; Moves current state down one level, or rather, forward one state; ;		/dn{/ols save def mx1 setmatrix newpath 0 0 moveto ct dup 39		 get 0 exch getinterval cvx exec mtx astore setmatrix colorarray		 astore pop/pnsh xdf/pnsv xdf/prl xdf/snl xdf setdash		 setlinejoin setlinecap setlinewidth setgray moveto}bdf**************************************************************************** Page characteristics***************************************************************************; ------------------------------------------------------------------------; PageSetUp: #copies manualFeedFlag smoothFlag portraitFlag paperRect scale;  x&yResolution pageSizeSelection "psu" --; Sets values for number of copies, manual or auto paper feed, smoothing,; portrait or landscape, paper rectangle, x and y scaling, and page size.;; pgs - page selection size, 120th of inch; pys, pxs - scale factors in y and x;  .72 * scale / yRes;  scale / xRes * .72; ppr - paper rectangle, 4 element array; Fpr - portrait flag; Fsm - smoothing flag; if manual feed is requested, turn manual feed on; check if we dealing with an NTX,;  (NOTE: NTX rev 1 boards print garbage if timer is set to anything more ;   than 60 seconds); if not, set the timer to wait 5 minutes; if so, do nothing, leave timer at default of 60 seconds; set the wait timer to 1 hour before giving up on the user; skip all this if auto feed; store the given # of copies in /#copies in the userdict;/psu {      /pgs xdf      2 index .72 mul exch dv /pys xdf      dv .72 mul /pxs xdf      4 array astore /ppr xdf      /Fpr xdf      /Fsm xdf      {statusdict begin	   /manualfeed T def	   (NTX)II not	    {/manualfeedtimeout 300 def}if	   end}if            userdict /#copies 3 -1 roll put     } bdf; ------------------------------------------------------------------------; Transpose: -- "tx" --; Transposes the current page into the correct position and orientation as; defined by the global values set in psu.; These are the various page sizes known.;; check if the paper size "note" is defined; if pgs = 1680 (legal) and "note" is defined, then call PostScript's;  legal paper definition; if pgs = 1212 (B5) and "note" is defined, then call PostScript's note;  paper definition and translate;   otherwise just do the translation; find out if "a4small" is defined; if pgs = 1403 (A4) and "a4small" is defined, then call the a4small paper;  definition; if pgs = 1320 (letter) and "note" is defined, then call PostScript's note;  definition; scale by pxs and pys; put paper rectangle on stack; is portrait flag on?; yep, translate to upper left corner of page, using -left and bottom;  dimension of paper rectangle; otherwise translate to upper right corner and rotate so that corner;  becomes the top left; do a 1 -1 scale so positive y is down the page; put statusdict on dict stack; check if waittimeout is less than 300 seconds; if so, set it to 300 seconds; pop the statusdict off the dict stack;/tx {     userdict /note known     pgs 1680 eq     1 index and     {legal}if     pgs 1212 eq     {dup {note}if      54 32.4 translate}if     pgs 1403 eq     userdict /a4small known and     {a4small}if     pgs 1320 eq and     {note}if     pxs pys scale     ppr aload pop     Fpr     {pop exch neg exch translate pop}     {translate pop pop 270 rotate}ifelse     1 -1 scale     statusdict begin     waittimeout 300 lt     {/waittimeout 300 def}if     end     } bdf;-------------------------------------------------------------------; FramingRect: framingrectangle "fr" --; Takes a framing rectangle and scales the current page into this rectangle; (or vise versa depending on how you think about it).;; move origin to top left; put paper rectangle on stack; T L B R are elements of paper rectangle; T' L' B' R' are elements of framing rectangle; (R + L / (R' - L')) (B + T / (B' - T')) scale;/fr {     3 index 3 index neg exch neg translate     ppr aload pop     3 -1 roll add     3 1 roll     exch add     6 2 roll     3 -1 roll sub     3 1 roll     exch sub     3 1 roll     exch 3 -1 roll dv     3 1 roll     dv     exch     scale    } bdf;-------------------------------------------------------------------; Clip: (string) "kp" --				!!!!!!!!!!!!;; put the temp string ct on the stack; leave the value 0 on the stack also; move a copy of the parameter string to top of stack; get its length; move a copy of ct to top of stack; put 39 on the stack; move a copy of length to top of stack; put the value length into the 39th element of the string ct; get the substring of ct from 0 to the length; copy the parameter string into this substring; convert the string to be executable; and execute it;/kp {     ct     0     2 index     length     2 index     39     2 index     put     getinterval     copy     cvx     exec	 mx1 currentmatrix pop    } bdf/nc{currentpoint initclip newpath gc{dup type dup/arraytype eqexch/packedarraytype eq or{exec}if}forall clip newpath moveto}bdf;-------------------------------------------------------------------; ExchangeTranslate: y x "xl" --;; negate x since the page has been set up with the origin at the top;  left corner; swap it to be the first parameter; negate y; do the translation of the origin;/xl {     neg     exch     neg     translate    } bdf;-------------------------------------------------------------------; MoveTo: y x "mto" --; executes PostScript "moveto" in the correct parameter order;; swap the y and x; do a "moveto";/mto {      exch      moveto     } bdf;-------------------------------------------------------------------; PenMultiplier: =; used to determine linewidth;; set default value to 1;/pnm 1 def;-------------------------------------------------------------------; SetPen: v h "pen" --; sets linewidth as specified by x and pen multiplier;; multiply given x by multiplier; make a copy of the result and use it to set the linewidth; keep it in variable called pnsh (horizontal pen size); multiply given y by multiplier; keep it in variable called pnsv (vertical pen size);/pen {      pnm mul      dup setlinewidth      /pnsh xdf      pnm mul      /pnsv xdf     } bdf******************************************************************* Font stuff******************************************************************; ------------------------------------------------------------------------; redefine for faster transmission;/ff /findfont ldf; ------------------------------------------------------------------------; Apple Encoding Vector:; Font encoding vector for PostScript fonts to match Apple character set;; define the name "blank" as the same character as the Times-Roman "space";  CharStrings is a dictionary in the font dictionary; define AVec as a 256 element array; ???????????; ???????????; stores the previous two lines of stuff into the first 32 elements of array; gets the next 96 elements out of the Times-Roman encoding dictionary of;  the font and puts it in the corresponding spots in AVec; puts quotesingle in 39th element and grave in the 96th; the next 16 lines of 8 characters are the names of characters to go;  into AVec; put these 128 characters into the array starting at the 128th place;/blank /Times-Roman findfont /CharStrings get /space get def/AVec 256 array def/NUL/SOH/STX/ETX/EOT/ENQ/ACK/BEL/BS/HT/LF/VT/FF/CR/SO/SI/DLE/DC1/DC2/DC3/DC4/NAK/SYN/ETB/CAN/EM/SUB/ESC/FS/GS/RS/USAVec 0 32 getinterval astore popAVec 32/Times-Roman findfont/Encoding get32 96 getinterval putintervalAVec dup 39/quotesingle put 96/grave put/Adieresis/Aring/Ccedilla/Eacute/Ntilde/Odieresis/Udieresis/aacute/agrave/acircumflex/adieresis/atilde/aring/ccedilla/eacute/egrave/ecircumflex/edieresis/iacute/igrave/icircumflex/idieresis/ntilde/oacute/ograve/ocircumflex/odieresis/otilde/uacute/ugrave/ucircumflex/udieresis/dagger/degree/cent/sterling/section/bullet/paragraph/germandbls/registered/copyright/trademark/acute/dieresis/notequal/AE/Oslash/infinity/plusminus/lessequal/greaterequal/yen/mu/partialdiff/summation/product/pi/integral/ordfeminine/ordmasculine/Omega/ae/oslash/questiondown/exclamdown/logicalnot/radical/florin/approxequal/Delta/guillemotleft/guillemotright/ellipsis/blank/Agrave/Atilde/Otilde/OE/oe/endash/emdash/quotedblleft/quotedblright/quoteleft/quoteright/divide/lozenge/ydieresis/Ydieresis/fraction/currency/guilsinglleft/guilsinglright/fi/fl/daggerdbl/periodcentered/quotesinglbase/quotedblbase/perthousand/Acircumflex/Ecircumflex/Aacute/Edieresis/Egrave/Iacute/Icircumflex/Idieresis/Igrave/Oacute/Ocircumflex/apple/Ograve/Uacute/Ucircumflex/Ugrave/dotlessi/circumflex/tilde/macron/breve/dotaccent/ring/cedilla/hungarumlaut/ogonek/caronAVec 128 128 getinterval astore pop; ------------------------------------------------------------------------; Re-encodeFont: newFontName oldFont AppleEncodeFlag "rf"; re-encodes and renames a font to the given name; All the fonts will need to be coordinated to have the Apple encoding.;; put bool param in Fav; find the font; is new name already in directory; if so, clean stack and that's it; if not, we've got work to do: find the size of this font's dictionary;  def tmp to be same length as oldfont;  call cf to copy all but /FID into new font dict and put Apple encoding;   vector in;  give the font the new name and put new font into the directory;;  support routines that have been incorporate into rf in line;/du{FontDirectory 2 index known{pop pop F};   {dup length dict /tmp xdf cf T}ifelse}bdf;/nf{{tmp definefont pop}if}bdf;/rf {     /Fav xdf	 ff     FontDirectory 2 index known     {pop pop}     {dup length dict /tmp xdf      cf      tmp definefont pop}ifelse    } bdf; ------------------------------------------------------------------------; CopyFont: fontdict "cf" --; copies everything in the given font except for FontID into tmp;; check each key in the font to see if equal to FID; if not FID, then copy it and its value to tmp; if it is then clean stack; checks to see if we want Apple encoding; do so if true;/cf {    {1 index /FID ne     {tmp 3 1 roll put}     {pop pop}ifelse}forall    Fav    {tmp /Encoding AVec put}if    } bdf; ------------------------------------------------------------------------; GetFont: fontName "gf" --; make a font using the specified font name and current size, sets it; current;; get the font dictionary; call msf (make and set font);/gf {     dup ff     msf    } bdf; ------------------------------------------------------------------------; Make and Set Font: fontName fontDict "msf" --;; convert the font name to a string object; see if this string contains Shaston, i.e., a style of Shaston such as;  bold, italics, etc.; if it is Shaston, then use [1.75 0 "obl" -1 0 0], any other font uses;  [1 0 "obl" -1 0 0]. "obl" is the angle used to create an italics, set ;  at 0.212557. Note: There are three pops if true because "search";  leaves the substring before the matched, the matched substring and the;  substring after the matched on the stack; whereas if no match is found,;  only the original string is left on the stack.; multiply the font size with the appropriate matrix; use the matrix that is on the stack now to make a new font; set this font current;/msf {exch tstr cvs     (Shaston) search     {pop pop pop [1.75} {pop [1} ifelse     fz mul 0 obl fz neg 0 0]     makefont setfont    } bdf; ------------------------------------------------------------------------; SetFontStyle (and size): fontStyle fontSize "sfs";; sets font style and size variables;/sfs {      /fz xdf /fs xdf     } bdf; ------------------------------------------------------------------------; Known (our version): fontName "kwn" fontName (T OR F) {true proc} ; our own implemetation of known to put stuff we need on the stack;; make a copy of the name; check to see if this font is the FontDirectory; leaving the resulting boolean on the stack, put on the stack the proc to;  be excuted if true; the proc gets the font dictionary;/kwn {      dup      FontDirectory exch known      {ff}     } bdf; ------------------------------------------------------------------------; InverseGray: -- "ig" --; Sets the gray level to be the inverse of the current level;; 1 - currentgray --> if black, then white and vice versa; everything in;  between will be in the same proportion but at the oppposite end of the;  scale.; set this level to be the current gray level;/ig {     1 currentgray sub     setgray    } bdf; ------------------------------------------------------------------------; ConvertToString: fontName "cts" string string; converts the given font name to a string object;; converts font name into a string object; make a copy of the object;/cts {      tstr cvs      dup     } bdf; ------------------------------------------------------------------------; ConvertToName: string index char(int) "ctn" fontName; converts the string back into a name object;; put the character into the appropriate spot in the string; convert to name object;/ctn {      put      cvn     } bdf; ------------------------------------------------------------------------; SetxStyle: fontName(in form of /|______name) "sxs" fontName(with style); the following six procs sets the appropriate char in the font name;; converts the name to string; specifies the index into the string and the integer representation of;  the character; convert string back to a name;/scs {cts 3 67 put dup 0 95 ctn}bdf     ; C in 3rd position and replaces                                        ; | with _; for outline Adobe fonts/sbs{cts 1 66 ctn}bdf                   ; B in 1st position -- Bold/sis{cts 2 73 ctn}bdf                   ; I in 2nd position -- Italic/sob{cts 2 79 ctn}bdf                   ; O in 2nd position -- Outline Italic/sos{cts 3 79 ctn}bdf                   ; O in 3rd position -- Outline/sss{cts 4 83 ctn}bdf                   ; S in 4th position -- Shadow; ------------------------------------------------------------------------; StylesMoveandCopy: string x y "smc" string; used by routine which create new font styles;; moveto the specified x and y; make a copy of the string; show the string (actually a char);/smc {      moveto      dup      show     } bdf; ------------------------------------------------------------------------; temporary font dictionaries;/wd 16 dict def/mfont 14 dict def; ------------------------------------------------------------------------; AdobeOutlineShadow: fontName shadowFlag "aos" --; makes an outline, or shadow if shadowFlag is true, font from an Adobe; outlineable font;; store shadowFlag; set the Apple encoding flag true; make another copy of the font name; check if shadow is requested and modified the name with the style;  character accordingly; check to see if we made this font already; if so, find the font and get rid of the extra copy of the name (see "kwn"); if not, make a copy of the unmodified name;  call "ac" to create a copy of the Adobe font with new values for;   PaintType and StrokeWidth;  put the naming procedure: get the Adobe outline font and call in df2;  and the BuildChar proc on the stack and call MakeModified (see "mm"); call msf to get the right size font and set it current;/aos {     /sh xdf     /fav T def     dup     sh {sss} {sos} ifelse     kwn     {1 index dup      ac      {scs ff /df2 xdf}      {aosc} mm     } ifelse     msf    } bdf; ------------------------------------------------------------------------; AdobeCopy: fontName "ac" --; create a font which is a copy of the given Adobe font and modify its;  values for PaintType and StrokeWidth;; make a copy of the font name and modified it with the style character; check to see if it has been defined; if so, find the font and be done with; otherwise, get the old name, get the font dictionary and define "ofd";  as the base font dictionary;  define a temporary dict with the size of the old base font + 1;  copies the old base font into tmp;  put 3 copies of tmp on the stack;  StrokeWidth will be defined as:;   .24 (natural line width) * 1000 / yscale / fontsize;  check to see if the number is less than 12;  if so, use 12 instead;  PaintType will be 2, meaning outline characters;  make this font known to the font machinery and get rid of the resulting;   font;/ac {     dup scs     kwn      {exch /ofd exch ff def       /tmp ofd maxlength 1 add dict def       ofd cf       tmp dup dup       /StrokeWidth       240 pys dv fz dv       dup 12 lt       {pop 12} if put       /PaintType 2 put       definefont pop} ifelse    } bdf; ------------------------------------------------------------------------; AdobeOutlineShadowChar: curFontDict charCode(int) "aosc" --; the heart of BuildChar proc for outline and shadow styles of Adobe fonts;; "fd" is define by the BuildChar in "mm" as the current font dict; get the base font and make it current; within a graphics save and restore, get the width in x and y of the;  character; if shadow, add .05 to the x value; use these values to set the char width, but does not put the character in;  the font cache; if shadow, show the character at .06 units to the right, this is the;  shadow portion of the character;  move the origin up .05 units to draw the main part of the character; set the gray level to the inverse of the current; show the character; this is the part that is inside the outline; make the outline copy of the font current; set the gray level to the way it was; go back to the original spot; and show the outline of the character;/aosc {      fd /df get setfont      gsave cs wi      sh{exch .05 add exch}if grestore      setcharwidth      cs      sh{.06 0 smc         0 .05 translate}if      ig      0 0 smc      ig      fd /df2 get setfont      0 0 moveto      show     } bdf; ------------------------------------------------------------------------; MakeModified: fontName {naming proc} {BuildCharProc} "mm" fontDict; defines a new font for building stylized fonts;; create a temp dictionary; this needs to be done each time since once it;  is used, it becomes read only; make it the current dict; set the FontMatrix to be 1 unit; declare this font user defined; use the Apple encoding vector; define "df" to be the basefont's dictionary; set the font bounding box to 1 unit; define "mbc" as the given BuildChar proc; define a BuildChar in this dictionary to set the condition to use the;  given proc: use the temp dict "wd";  leave the name "cs" around, we'll use it soon;  put the temp string on the stack and make a copy;  put the charCode into the temp string;  define this temp string to be "cs";  make a copy of current font dictionary;  define it as "fd";  get our BuildChar proc and execute it;  and quit using "wd"; execute the naming proc, which is to define a dict named "df2" which is;  a copy of the Adobe font with StrokeWidth and PaintType modified; finish the definitions for "tmf"; make this font legit with definefont;/mm {     /tmf 10 dict def     tmf begin     /FontMatrix [1 0 0 1 0 0] def     /FontType 3 def     /Encoding AVec def     /df 3 index ff def     /FontBBox [0 0 1 1] def     /mbc xdf     /BuildChar      {wd begin      /cs      s1 dup      0 5 -1 roll put      def      dup      /fd xdf      /mbc get exec      end } def     exec     end     tmf definefont    } bdf		/mdf{mfont wcheck not{/mfont 14 dict def}if mfont begin		 xdf end}bdf					/mywidth{bitwidth 3 lt{3}{bitwidth}ifelse}bdf				/bmbc{exch begin wd begin/cr xdf save CharTable cr 6 mul		 6 getinterval{}forall/bitheight xdf/bitwidth xdf .96 div		/width xdf Gkernmax add/XOffset xdf Gdescent add/YOffset		 xdf/rowbytes xdf rowbytes 255 eq{0 0 0 0 0 0 setcachedevice}		{Gnormsize dup scale width 0 XOffset YOffset bitwidth		 XOffset add bitheight YOffset add setcachedevice rowbytes		 0 ne{XOffset YOffset translate newpath 0 0 moveto		 bitwidth bitheight scale rowbytes 3 bitshift bitheight		 true[bitwidth 0 0 bitheight neg 0 bitheight]		{CharData cr get}imagemask}if}ifelse restore end end}bdf			 		/bb{.96 fz div/Gnormsize mdf 2 index/Gkernmax mdf 1		 index/Gdescent mdf 3 index div 4 1 roll 2 index div 1. 5		 2 roll exch div 4 1 roll 4 array astore/FontBBox mdf}bdf				/cdf{mfont/CharData get 3 1 roll put}bdf				/bf{mfont begin/FontType 3 def/FontMatrix[1 0 0 1 0 0]def		/Encoding AVec def/BuildChar/bmbc ldf end mfont		 definefont pop}bdf		 	/si{/obl 0.212557 fz mul def}bdf		/ci{/obl 0 def}bdf			/mb{dup sbs kwn{exch{}{bbc}mm}ifelse msf}bdf	/mo{dup sos kwn{exch{}{boc}mm}ifelse msf}bdf	/ms{dup sss kwn{exch{}{bsc}mm}ifelse msf}bdf	/bbc{/da .03 def 	fd /df get setfont	gsave cs wi exch 	da add exch grestore setcharwidth	cs 	0 0 smc da 0 smc da da smc 0 da 	moveto show}bdf	/boc{/da 1 fz div def	fd /df get setfont	gsave cs wi exch	da add exch grestore setcharwidth	cs 	0 0 smc da 0 smc da da smc 0 da 	smc 1 currentgray sub setgray da 2. div dup 	moveto show}bdf	/bsc{/da 1 fz div def	/ds .05 def /da2 da 2. div def 	fd /df get setfont	gsave cs wi exch 	ds add da2 add exch grestore setcharwidth	cs 	ds da2 add .01 add 0 smc 0 ds da2 sub translate 	0 0 smc da 0 smc da da smc 0 da 	smc 1 currentgray sub setgray da 2. div dup 	moveto show}bdf; ------------------------------------------------------------------------; Underline: desiredlength "ul" --; does the underlining of text; Shadow and outline fonts are special case; to perform the extra work it needs;; Note: Built in Adobe fonts contain additional entries in the font;       dictionary. One of which is a FontInfo dictionary containing;       information such as UnderlinePosition and UnderlineThickness.;; save the graphics state at this time since we want to do the underlining;  independent of the text printing; this 0 is used later as the change in y for "rlineto"; "sif" does a look up of the name given in the current font dictionary.;   See full explanation below.; if UnderlinePosition is found, call "ty" to transform y by the y;  component of the matrix, otherwise div the font size by 10; now go look for the thickness of the underline; if it exists, call "ty" (see above); if not, divide the font size by 15; set the line thickness based on the value from the last calculation; get the current position of the pen; move the underline position up to the top of the stack and add it to;  the y pos of the current position and move the pen to it; check bit 4 of the font style to see if this is a shadow font, make;  copy of the result of the and for use later; if so, save the graphic state (again, this should be independent);  take half the current line width;  make a copy and use these values as the delta for rmoveto, i.e.,;   drop the line by half its width and the same amount to the right;   to create the shadow;  translate the origin to the current point;  make a copy of x (desired length) and y (0) value of the line and;   do a relative move to; the code actually copies 3 elements and;   then get rid of the top one, which is the value left on the stack;   after the checking of font style for shadow; this is done to save;   code and time since this value is used again later;  paint the line; up until now, we were only creating paths, this;   actually draws it;  put the graphics state back to what it was; check bit 3 of the font style to see if this may be an outline font; we have the copy of the result when we looked at bit 4 earlier, or;  these two values; move the result of the or down in the stack; get a copy of if and put it on top of the stack; if either of the styles is chosen (true from the or) then we do the;  customary saving of the graphics state;  set the gray level to its inverse;  get copy of the x y values and do the relative line;  paint the line;  restore the graphic state; create the path of the underline for all font styles; if outline or shadow font then, create an outline around the inverse;  gray line; set the line width to .24 times the y scale factor; paint the line; and finally restore graphics stats back to the way it was before any;  underlining;/ul {     gsave     0     /UnderlinePosition sif     {ty} {fz 10 div} ifelse     /UnderlineThickness sif     {ty} {fz 15 div} ifelse     setlinewidth     currentpoint     3 -1 roll add moveto     fs 16 and dup 0 ne     {gsave      currentlinewidth 2. div      dup rmoveto      currentpoint translate      3 copy pop rlineto      stroke      grestore}if     fs 8 and     or 0 ne     3 1 roll     2 index     {gsave      1 currentgray sub setgray      2 copy rlineto      stroke      grestore}if      rlineto     {strokepath      .24 pys div setlinewidth}if      stroke      grestore    } bdf;------------------------------------------------------------------------; SafeGet: dict /name "sg" [value true] or [false]; does make a get call if the name does not exist in the dictionary;/sg {     2 copy known     {get T} {pop pop F} ifelse    } bdf;-------------------------------------------------------------------------; SpecialIf: /name "sif" [value FontMatrix true] OR [false] ; Finds /name in currentfont and returns its value and FontMatrix otherwise; just returns false;; get the current font and make a copy; get the FontMatrix value and leave it on the stack; swap with the copy of the current font; try to get the FontInfo dictionary; if it exists, leave it and true on the stack for later use; if it doesn't, get the current font;  try to get a dictionary called df;  if df exists, then make a copy and try to get its FontInfo dict;   if FontInfo exists in this dict, then use the copy of df and get;    the FontMatrix from it;    concatenate this matrix with the FontMatrix already on the stack;     to form a FontMatrix;    swap with FontInfo and leave a true on the stack;   if FontInfo doesn't exist here either, pop everything off the stack;    and leave a false;  if df is unknown, then pop previous stuff off the stack and leave a;   false; if the top element on the stack at this point is a true, then FontInfo;  has been found one way or another; use it to get the value of the;  name which was given as a parameter;  swap it and the matrix and leave a true to put the stack in the output;   format we want;  if that name is not found, pop the matrix and leave a false; if the top element is a false, then we just leave a false on the stack;;  the stack at this time should already have been cleaned up;/sif {      currentfont dup      /FontMatrix get      exch      /FontInfo sg      {T}      {currentfont       /df sg       {dup /FontInfo sg        {3 1 roll /FontMatrix get         mtx concatmatrix         exch T}        {pop pop pop F} ifelse       }       {pop pop F} ifelse      } ifelse      {3 -1 roll sg       {exch T}       {pop F} ifelse      } {F} ifelse     } bdf        ; ------------------------------------------------------------------------; TransformY: yVal matrix "ty" yTransformed; transforms y by the y component of the matrix;; put x value of 0 on stack; put this value in the right place on the stack for the correct order of;  parameters for the tranform operator; get rid of x;/ty {     0     3 1 roll transform     exch pop    } bdf**************************************************************************** Text merging***************************************************************************; ------------------------------------------------------------------------; BeginText: -- "bt" [; signals the beginning of a bunch of text that may need justification.;; Initialize printer length; and screen length; leave on the stack a mark;/bt {     /pl 0 def     /sl 0 def     [    } bdf; ------------------------------------------------------------------------; MergeText: (string) screenlength "mt" (string) printerlength {proc}; put the text and its font changes onto the stack to be used by EndText;; increase total screen length of this line by the screen length of this;  fragment; store it back into total screen length variable; make another copy of the string and find out its printer length, the;  "pop" gets rid of the y component of stringwidth; make a copy of the printer length and add it to total printer length,;  note that one copy of the printer length for this fragment is still on;  the stack; store back into total printer length variable; put the text layout procedure on the stack;/mt {     sl add     /sl xdf     dup wi pop     dup pl add     /pl xdf     {lot}    } bdf; ------------------------------------------------------------------------; LayOutText: (string) printerlength "lot" --; this procedure actually sits on the stack on top of its input values; until "et" is called, at that time actual execution occurs.;; multiply the printer length of this fragment by the adj frag length;  to get the desired length; check to see if underlining is requested; if so, make a copy of the desired length and call the underline proc; get the adjustment value: printerlength - desired length; if the absolute value is less than .5; don't bother with any layout; otherwise, the fun begins: move a copy of the string to the top of stack; make a copy of string, get the character count and leave it on the stack; put a counter underneath it on the stack; look at each char of the string and check if it's a space; if so, increment the counter; check if the space count is 0; or if the adjustment is negative; if either, get rid of the count; get the adjustment for each char by dividing adj by the character count; put 0 on stack for y component of value; roll the string to the top of the stack and call ashow to spread the;  adjustment across each character of the string; if the space count is nonzero and the adjustment is positive, then;  spread 50% of the adj across the spaces and 50% across all characters;  for short string fragments and for longer string fragments,;  90% of the adjustment will be spread across the spaces and 10%;  across the remainder of the characters.;  for each char (including spaces): adj / (10 * #spaces) + #chars;  for each space : 10 * adj for each char;  criteria for short fragment: 2 or less spaces, 10 or more characters; is space count 2 or less?; is character count 10 or more?; define a variable "fac" to be the weight factor (# of times more than;  other characters) of spaces: 10 for long strings and 2 for short;  strings and make a copy of this values to be used later; multiply the space count by the weight factor; add the previous two values together; divide adj by that sum and make a copy; multiply by the weight factor for the value to be used on spaces; push 0 for the y component of the value and 32 for the space char; roll the value to be used for all characters on top; push 0 for the y component of that value; roll the string on top and call awidthshow to spread the specified;  amounts over spaces and all the chacracters;/lot {      dup afl mul      fs 4 and 0 ne      {dup ul}if      exch sub      dup abs .5 lt      {pop show}      {1 index       dup length exch       0 exch       {32 eq        {1 add}if       } forall       dup 0 eq       3 index 0 le or       {pop        dv        0        3 -1 roll ashow}       {dup 2 le        2 index 10 ge        and        {2}        {10} ifelse        dup /fac xdf        mul        add        dv dup        fac mul        0 32        4 -1 roll        0        6 -1 roll awidthshow       }ifelse      }ifelse     } bdf; ------------------------------------------------------------------------; EndText: -- "et" --; time to figure out the correct spacing necessary for the entire line of; text to achieve same length as on screen;; get a count of the string fragment stuff on the stack and create an;  array that size; store the stuff into the array; move the mark to the top of the stack and get rid of it; calculate and store away the adjusted fractional length;  adjusted fractional length = total screen length / total printer length; save the state of the virtual memory; anything we do for this line of;  text should be independent of the rest of the page; move the array on top of the stack so we can work on it; for each element of the array, find out its type and make another copy; check if it's an array; or a packedarray; if it is (it's our text layout procedure), execute it; otherwise leave;  it on the stack. We purposely do not pop the elements off after the;  check because the layout procedure needs them there; get the current point, which should be at the end of the line of text; get the save object on top of the stack and restore; move the currentpoint to the end of the text and life goes on;  note: After the restore, the currentpoint is at the place where we;        did the save, i.e. before the text is laid out. That's why the;        "currentpoint" call occurs inside the save/restore to get;        the point at where the text ended and the "moveto" done after;        the restore to put it in respect of the pre-text layout world.;/et {     counttomark array     astore     exch pop     /afl sl pl dv def     save     exch     {dup type dup      /arraytype eq exch      /packedarraytype eq or      {exec} if     } forall     currentpoint     3 -1 roll restore     moveto    } bdf; ------------------------------------------------------------------------; Width: string "wi" width(x) width(y); this procedure is a precaution against a known problem with original; LaserWriters in that "show" is called by some of the fonts' BuildChar ; procs by setting the clippath to 0 and calling stringwidth if it is a ; LaserWriter. If LW+ or LW II, then just stringwidth is called.;; find out if printer is LW classic; if so, save the graphic state;  set a 0 clippath by creating a full path at 0,0 and clip to it; call stringwidth; restore graphic state; if not, then call stringwidth as is; bind for efficiency;/wi   CL   {{gsave     0 0 moveto 0 0 lineto 0 0 lineto 0 0 lineto closepath clip     stringwidth     grestore }     bind } 	 {/stringwidth load}ifelse   def**************************************************************************** QuickDarw II objects:*     Nouns:    Line*               Arc*               Oval*               Rect*               RoundRect**     Verbs:    Frame*               Paint*               Erase*               Invert*               Fill***************************************************************************;-------------------------------------------------------------------; Pop4: -- "pop4" --; pops 4 objects off the stack;/pop4 {       pop       pop       pop       pop      } bdf;-------------------------------------------------------------------; FindPen: -- "fp" T or F; checks if pen size is nonzero in both vertical and horizontal;  components;; check if horizontal component of pen is 0; check if vertical component of pen is 0; are they both nonzero?;/fp {     pnsh 0 ne     pnsv 0 ne     and    } bdf;-------------------------------------------------------------------; Verb:; array of procedures to implement QuickDraw verbs:;  (frame, paint, erase, invert, fill);; frame: ;  find out if pen is visible;  if so, save graphic state;   clip to the existing path, (framing occur within the shape boundary);   set line width to 1;   scale by twice the pen size (PostScript strokes with half the line;    width on each side of the path, the outer half is clipped and the ;    inner half is the original pen size);   stroke the path;   put things back the way we found it;  start a new path; paint:;  fill with pen pattern/color; erase:;  same as paint, fill with background pattern/color; invert:;  not supported; fill:;  same as paint, fill with fill pattern; ?:; clip:;  clip and start new path;/vrb [      {fp	  {gsave 	   clip	   1 setlinewidth 	   pnsh 2 mul pnsv 2 mul scale 	   stroke 	   grestore}if 	   newpath}bind	         /eofill load	  	  dup	        /newpath load	        2 index	        dup	        {clip newpath}bind	        {}bind      dup      2 copy     ] def;-------------------------------------------------------------------; DoOperation: drawverb(int) "doop" --; performs the QuickDraw verbs;; put QD verb array on stack and swap with the drawverb; using drawverb as index, get the appropriate procedure; and executes it;/doop {       vrb exch       get       exec      } bdf;-------------------------------------------------------------------; Line: y x "lin" --; draws a line from the current pen position to the given point,;  making compensations to achieve QuickDraw style lines where the;  pen is to the right and below of the current position as opposed;  to PostScript where pen is half above and half below the current;  position.;; swap coordinates; save current point in temp variables; save graphics state; start a new path; temp variables: @1 -- specified y;                 @2 -- specified x; if the pen is visible, then is current x < specified x;  (line from left to right);  if so, is current y > specified y (line from up to down);   if so, move to current point;    draw a line to the specified point;    draw a line from here to hereX+penWidth and hereY+0;    then a line from here to hereX+0 and hereY+penHeight;    draw a line to curX+penWidth and curY+penHeight;    then a line from here to hereX-penWidth and hereY+0;   if not, (line from down to up) move to current point;    draw a line from here to hereX+penWidth and hereY+0;    draw a line to specifiedX+penWidth and specifiedY;    draw a line from here to hereX+0 and hereY+penHeight;    draw a line from here to hereX-penWidth and hereY+0;    draw a line to curX and curY+penHeight;  if not, (line from right to left), is current y > specified y;    (line from up to down);   if so, move to specified point;    draw a line from here to hereX+penWidth and hereY+0;    draw a line to curX+penWidth and curY;    draw a line from here to hereX+0 and hereY+penHeight;    draw a line from here to hereX-penWidth and hereY+0;    draw a line to specified x and specifiedY+penHeight;   if not, (line from down to up) move to current point;    draw a line from here to hereX+penWidth and hereY+0;    draw a line from here to hereX+0 and hereY+penHeight;    draw a line to specifiedX+penWidth and specifiedY+penHeight;    draw a line from here to hereX-penWidth and hereY+0;    draw a line from here to hereX+0 and hereY-penHeight;  call closepath to finish off any details;  fill with current pattern; put the end points of the line on the stack; restore graphics state; put the point at the end of the drawn QuickDraw line;/lin {      exch      currentpoint /pnlv xdf /pnlh xdf      gsave      newpath      /@1 xdf      /@2 xdf      fp { pnlh @2 lt          { pnlv @1 ge           { pnlh pnlv moveto             @2 @1 lineto             pnsh 0 rlineto             0 pnsv rlineto             pnlh pnsh add pnlv pnsv add lineto             pnsh neg 0 rlineto }           { pnlh pnlv moveto             pnsh 0 rlineto             @2 pnsh add @1 lineto             0 pnsv rlineto             pnsh neg 0 rlineto             pnlh pnlv pnsv add lineto }           ifelse }          { pnlv @1 gt           { @2 @1 moveto             pnsh 0 rlineto             pnlh pnsh add pnlv lineto             0 pnsv rlineto             pnsh neg 0 rlineto             @2 @1 pnsv add lineto }           { pnlh pnlv moveto             pnsh 0 rlineto             0 pnsv rlineto             @2 pnsh add @1 pnsv add lineto             pnsh neg 0 rlineto             0 pnsv neg rlineto }           ifelse          } ifelse          closepath fill         } if      @2 @1      grestore      moveto     } bdf;-------------------------------------------------------------------; BasicArc: top left bottom right startAngle stopAngle drawVerb;  newpathFlag "barc" --; core of the arc drawing routine;; temp variables: @1 -- newpathFlag;                 @2 -- drawVerb;                 @3 -- stopAngle;                 @4 -- startAngle;                 @5 -- right;                 @6 -- bottom;                 @7 -- left;                 @8 -- top; save the graphics state; right + left / 2; top + bottom / 2; move the coordinate system to the middle of the rect specified; start a newpath; set current point at origin; right - left; bottom - top; store current matrix in "mtx" and get rid of copy on stack; scale by rectangle size; call newpath if flag indicates so; call the "arc" operator with x and y of 0, radius of .5 and start;  and start and stop angle as specified; find the difference of the angles; if it is greater than or equal to 360, then call closepath to;  complete a circle or oval; set the current matrix back to the one as saved; call "doop" to perform the verb; restore the graphics state;/barc {       /@1 xdf       /@2 xdf       /@3 xdf       /@4 xdf       /@5 xdf       /@6 xdf       /@7 xdf       /@8 xdf       gsave       @5 @7 add 2 div       @6 @8 add 2 div       translate       newpath       0 0 moveto       @5 @7 sub       @6 @8 sub       mtx currentmatrix pop       scale       @1 {newpath} if       0 0 0.5 @4 @3 arc       @4 @3 sub       abs 360 ge {closepath} if       mtx setmatrix       @2 doop       grestore      } bdf;-------------------------------------------------------------------; Arc: top left bottom right startAngle stopAngle drawVerb "ar" --; draws an arc;; make a copy of the drawverb; check if it's frame?; leave result on the stack as newpathflag and call the basic arc;  procedure;/ar {     dup     0 eq     barc    } bdf;-------------------------------------------------------------------; Oval: top left bottom right drawVerb "ov" --; draws an oval;; use 0 as start angle and switch positions with drawverb; use 360 as stop angle and switch its position with drawverb; use true as newpathflag; call basic are procedure;/ov {     0 exch     360 exch     true     barc    } bdf;-------------------------------------------------------------------; Rectangle: top left bottom right drawVerb "rc" --; draws a rectangle;; save the draw verb in a temp variable; save the current point on the stack; move these two values to the bottom of the stack, after the rect; start a newpath; move top and left points to top of the stack; swap x and y and move the current point to the upper left corner; roll the top point to top of stack, stack now looks like:;    top;    right;    bottom;    right;    bottom;    left; draws a line from the upper left to the upper right corner; then to the lower right; and then to the lower left; call closepath to finish it up; perform the verb; put the current point back where we found it;/rc {     /@t xdf     currentpoint     6 2 roll     newpath     4 copy     4 2 roll     exch moveto     6 -1 roll     lineto     lineto     lineto     closepath     @t doop     moveto    } bdf;-------------------------------------------------------------------; RoundRectangle: top left bottom right ovalHeight ovalWidth drawVerb;  "rr" --; draws a round rectangle;; temp variables: @1 -- drawVerb;                 @2 -- ovalWidth / 2;                 @3 -- ovalHeight / 2;                 @4 -- right;                 @5 -- bottom;                 @6 -- left;                 @7 -- top;                 @8 -- radius of arc;                       = sqrt[(ovalht*ovalht)+(ovalwd*ovalwd)]/2; is top = bottom?; is left = right?; get half of pen's width; less than ovalWidth/2 ?; get half of pen's height; less than ovalHeight/2 ?; in summary, if any of these conditions:;  top = bottom;  left = right;  penWidth/2 < ovalWidth/2;  penHeight/2 < ovalHeight/2; are true, then treat it a regular rectangle; else the fun begins; right - left / 2;  make a copy;  is it less than ovalWidth/2;   if so, redefine @2 as this value;   otherwise get rid of the copy;  bottom - top / 2;  make a copy;  is it less than ovalHeight/2;   if so, redefine @3 as this value;   otherwise get rid of the copy;  is frame the verb?;   if so, leave the "@2" variable name and its value on the stack;   penWidth / 2;   make copy each of ovalWidth/2 and penWidth/2;   is ovalWidth > penWidth?;    if so, redefine @2 to be ovalWidth/2 - penWidth/2;    else clean up stack;   leave the "@3" variable name and its value on the stack;   penHeight / 2;   make copy each of ovalHeight/2 and penHeight/2;   is ovalHeight > penHeight?;    if so, redefine @2 to be ovalHeight/2 - penHeight/2;    else clean up stack;  save the current point on the stack;  start a newpath;  right + left / 2;  move to the top middle of the rect;  calculate radius:;   ovalWidth squared;   ovalHeight squared;   add together;   take the square root;   divide by 2;   define this value to be @8;  call "arcto" with x1 y1 x2 y2 r where:;   currentpoint and x1 y1 forms one tangent line;   x1 y1 and x2 y2 forms the other tangent line;   and r is radius;  right top right bottom ovalWidth/2 and get rid of stuff returned;  right bottom left bottom ovalWidth/2 and get rid of stuff returned;  left bottom left top ovalWidth/2 and get rid of stuff returned;  left top right top ovalWidth/2 and get rid of stuff returned;  call closepath to finish our dirty work;  perform the verb;  and put the point back where we found it;/rr {     /@1 xdf     2. div /@2 xdf     2. div /@3 xdf     /@4 xdf     /@5 xdf     /@6 xdf     /@7 xdf     @7 @5 eq     @6 @4 eq     @2 pnsh 2 div     le     @3 pnsv 2 div     le     or or or     {@7 @6 @5 @4 @1 rc}     {@4 @6 sub 2. div      dup      @2 lt      {/@2 xdf}      {pop} ifelse      @5 @7 sub 2. div      dup	  @3 lt	  {/@3 xdf}	  {pop} ifelse       @1 0 eq      {/@2 @2       pnsh 2 div       2 copy       gt       {sub def}       {0 pop4} ifelse 	   /@3 @3 	   pnsv 2 div 	   2 copy	   gt	   {sub def}	   {0 pop4} ifelse } if      currentpoint      newpath      @4 @6 add 2. div @7 moveto	  @2 @2 mul 	  @3 @3 mul 	  add 	  sqrt 	  2. div	  /@8 xdf      @4 @7 @4 @5 @8 arcto pop4      @4 @5 @6 @5 @8 arcto pop4      @6 @5 @6 @7 @8 arcto pop4      @6 @7 @4 @7 @8 arcto pop4      closepath      @1 doop      moveto } ifelse    } bdf;-------------------------------------------------------------------; StartPolygon: -- "sp" --; signifies the start of a polygon definition, which is to be;  painted or filled;; save the current pen position on the stack, this is done before the;  newpath call because newpath zaps the currentpoint; newpath gets rid any other path currently active and begins a new;  one, namely that of the polygon; moveto to the point specified on the stack (first point of the;  polygon);/sp {     currentpoint     newpath     moveto    } bdf;-------------------------------------------------------------------; PolyLine:  y x "pl" --; generates the path which defines the polygon; different from "lin";  in that this proc does not do any drawing;; swap coordinates; generate a line to this point;/pl {     exch     lineto    } bdf;-------------------------------------------------------------------; EndPolygon: -- "ep" --; signifies the end of the polygon definition and executes the paint;  or fill;; save the current graphics state; do a fill using the current color; "eofill" applies the even-odd;  rule to determine insideness; save the currentpoint (last point of the polygon) on the stack; call "fp" to see if pen is visible; if so, call "pathforall" to do whatever it does;  go back to the original graphics state;  save the currentpoint on the stack;  zap the existing path and start a new one;  set the currentpoint to the old saved one; if not, restore the existing graphics state and start a new path; set the currentpoint at the last point of the polygon;/ep { gsave      gsave eofill grestore      currentpoint      fp      {{moveto}{exch lin}{}       {(%%[Warning: A polygon close path call is issued.]%%)=flush}pathforall       grestore       currentpoint       newpath       moveto}      {grestore newpath} ifelse      moveto    } bdf******************************************************************* Patterns******************************************************************;----------------------------------------------------------------; AddOne;/addone {         dup 0 eq {exit} if         1 sub         exch 1 index dup         mode640{addone640}{addone320}ifelse         colorarray exch get add exch        } bdf;----------------------------------------------------------------; AddOne (320 mode);/addone320 {            2 div cvi xarray exch get            exch cvi 1 and 4 mul cvi 4 sub bitshift 15 and           } bdf;----------------------------------------------------------------; AddOne (640 mode);/addone640 {            cvi 3 and 4 mul exch            dup 4 div cvi            xarray exch get            exch cvi 3 and 2 mul cvi 6 sub            bitshift 3 and add cvi           } bdf;----------------------------------------------------------------; Pixel (320 mode);/pixel320 {           exch dup 3 copy pop exch           1 add 4 mul cvi 4 mul           exch 1 add 2 mul cvi           add xarray exch get           exch 1 add 4 mul cvi 1 and 4 mul cvi 4 sub           bitshift 15 and           colorarray exch get          } bdf;----------------------------------------------------------------; Pixel (640 mode);/pixel640 {           exch 2 copy exch           1 add 4 mul cvi 2 mul           exch 1 add cvi           add xarray exch get           1 index 1 add 2 mul cvi 4 mul exch           2 index 1 add 4 mul           cvi 3 and 2 mul cvi 6 sub           bitshift 3 and add cvi           colorarray exch get          } bdf;----------------------------------------------------------------; Pattern;/pat {      /mode640 xdf      exch /xarray xdf      {15}{9.375}ifelse      pa Fpr not{90 add}if      {mode640{pixel640}{pixel320}ifelse      45 exch sub 45 div /temp xdf      1 add 4 mul dup cvi sub 2 mul 1 sub      exch 1 add 4 mul dup cvi sub 2 mul 1 sub      1 sub temp mul 1 add      exch 1 sub temp mul 1 add spf} setscreen      0 64 {addone} loop pop 45 div 64. div setgray     } bdf**************************************************************************** Clean up stuff***************************************************************************;-------------------------------------------------------------------; End our own dictionary - GSd;end;-------------------------------------------------------------------; Restore packing capability;; if packing is available,; restore to the way it was;systemdict /setpacking known{svpack setpacking}if