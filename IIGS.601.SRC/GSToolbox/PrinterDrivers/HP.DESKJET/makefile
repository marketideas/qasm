#***********************************************************************************#                                                                                  *#		Apple IIgs Printer Driver                                                  *#                                                                                  *#		File: makefile -- Compilation and linking script                           *#                                                                                  *#		Written by Ben Koning                                                      *#		Copyright (C) 1990 Apple Computer, Inc.                                    *#                                                                                  *#***********************************************************************************#Division of files:#		README			Delta description of this driver compared to others#		RELEASE.NOTES	Developmental revision history#		makefile		Compilation and linking script#		equates			Header file with equates and direct page definitions#		entry			Entry vectors, environment setup/restore, routine dispatch#		printloop		High level print model interface#		imager		 	Converting pixel map to escape codes for printer#		metrics			Print record access and	printer dimension calculations#		dialog		 	Dialog box and other user-interface implementation#		dialogdata  	Dialog box layout and textEQU =	equates.aiiOBJ =	:obj:entry.aii.obj :obj:printloop.aii.obj :obj:metrics.aii.obj ¶		:obj:dialog.aii.obj :obj:dialogdata.aii.obj :obj:imager.aii.objNAM =	DeskJet.PlusPRN =	print -r -h -hs 12 -hf times -md -f courier -s 9PRINT Ä		{PRN} imager.aii		{PRN} dialogdata.aii		{PRN} dialog.aii		{PRN} metrics.aii		{PRN} printloop.aii		{PRN} entry.aii		{PRN} equates.aii		{PRN} makefile		{PRN} README		{PRN} RELEASE.NOTES		files -l | {PRN}					CLEAN Ä		delete -i {OBJ}{NAM} Ä {EQU} {OBJ}		delete -i {NAM}		linkiigs -t $BB -at $0001 {OBJ} -o {NAM}	DEBUG Ä {EQU} {OBJ}		delete -i {NAM}		linkiigs -t $BB -at $0001 {OBJ} -o {NAM}		files -n -x b {NAM}		beep 2a,4,255		duplicateiigs -m -y {NAM} :	:obj:entry.aii.obj Ä {EQU} entry.aii		asmiigs	entry.aii -o :obj:entry.aii.obj:obj:printloop.aii.obj Ä {EQU} printloop.aii		asmiigs	printloop.aii -o :obj:printloop.aii.obj:obj:metrics.aii.obj Ä {EQU} metrics.aii		asmiigs	metrics.aii -o :obj:metrics.aii.obj:obj:dialog.aii.obj Ä {EQU} dialog.aii		asmiigs	dialog.aii -o :obj:dialog.aii.obj:obj:dialogdata.aii.obj Ä {EQU} dialogdata.aii		asmiigs dialogdata.aii -o :obj:dialogdata.aii.obj:obj:imager.aii.obj Ä {EQU} imager.aii		asmiigs	imager.aii -o :obj:imager.aii.obj