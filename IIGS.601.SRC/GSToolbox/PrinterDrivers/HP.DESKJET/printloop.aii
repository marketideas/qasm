*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: printloop.aii -- High-level interactive interface for imaging              **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.aii'							include		'm16.util'							include		'e16.quickdraw'							include		'm16.quickdraw'							include		'm16.qdaux'							include		'm16.memory'							include		'e16.print'							include		'm16.intmath'							include		'm16.misctool'							include		'm16.event'PrintLoopProc				proc		export**HIGH-LEVEL PRINT LOOP CALLS: High-Level printing loop management calls implementing*the old Macintosh Printing Manager print model, but breaking several rules for performance.*The functionality of the calls implemented below can be summarized as follows:**	OPENDOC		Allocates offscreen buffer for DrawPicture, establishes I/O, initializes variables*	OPENPAGE	Resets variables, begins pict recording*	CLOSEPAGE	Stops pict recording; for each copy, redraws and prints a page in slices*	CLOSEDOC	Deallocates all buffers, resets QD globals, closes I/O**GETPRINTLOOPERROR and SETPRINTLOOPERROR allow access to the global PrError error status.  There*are also a few other routines in this module which are used by the high level routines above.**In this driver, the page definitions of the entire document are not saved during the OpenDoc/*CloseDoc sequence for playback during PicFile; rather, the copy(s) of each page are printed*from inside ClosePage; this is why there is no PicFile call.  Draft/Text mode is not supported.*Color is not supported.  The page definition is pre-clipped to ease the CPU horsepower burden on*QuickDraw's DrawPicture call.  Only portrait orientation is supported; very limited print scaling*options are supported.***OPENDOC: Allocates and prepares resources for printing.  Performs the following tasks:**	Clear error status*	Put up box for status messages*	Initialize our global variables using information from print record*	Save the user's current grafport for later restore*	Allocate as much memory as possible for banding buffer and calculate its size in pixels*	Open and setup a grafport to draw the bands, using the memory obtained above*	Set up QuickDraw globals to handle increased drawing size requirements*	Open, setup, and make current the grafport that the app will see for recording pict definition;*	note that this is a different grafport than the one used to manage the banding buffer*	Open communication channel with printer*	Confirm the identity of the printer; if incorrect, then set abort status*	Cause the printer to reset*	Configure the imager/printer with information about our band buffer, resolution settings, etc.*							export		OpenDocOpenDoc*Clear error status which can be set to render most of the print loop calls ineffective:							stz			OpDoErrorStatus							*Make setup level 0.  We inc whenever we start something up, to facilitate legal shutdown:							stz			OpDoSetupLevel*Clear the logical-page counter which is later used to see if we're in page range:							stz			OpDoPageCounter*Put up box for status messages, which also changes to the wait cursor:							import		StartStatusMessage							jsr			StartStatusMessage*Save data from print record needed by Open/Close-Page, which can't access print record:							import		GetPageRange			;page range (from..to) bounds							jsr			GetPageRange							stx			OpDoPageRange1st							sty			OpDoPageRangeLst*							import		GetCopies				;number of copies of each page							jsr			GetCopies							sta			OpDoTotalCopies*							stz			OpDoIsManFeed			;manual or automatic sheet feed							import		GetFeed							jsr			GetFeed							bne			OpDoItsAutoFeed							inc			OpDoIsManFeedOpDoItsAutoFeed*							import		GetRPageSize			;rPage calculation results							jsr			GetRPageSize							stx			OpDoRPageX2							sty			OpDoRPageY2*							import		GetImagingSize			;scaled-up page size calc results							jsr			GetImagingSize							stx			OpDoImgSzX2							sty			OpDoImgSzY2*Put up message to show that we're now going to be allocating banding memory:							import		StMeMallocMesg							lda			#StMeMallocMesg							import		StatusMessage							jsr			StatusMessage							*Save current caller's grafport for restore by CloseDoc routine:							pha							pha							_GetPort							pulllong	OpDoOldUserGrafPortPtr*Starting to create locinfo to be used by off-screen banding grafport.  Store band tallness/width:							import		GetImagingSize			;get the scaled-up size of the page							jsr			GetImagingSize			;image, given current quality setting							stx			OpDoLocInfoRect+oh2		;store X2; will be modified							sty			OpDoLocInfoRect+ov2		;store Y2; will be modified*Begin loop to figure out maximum Y size for banding, with many constraints:							bra			OpDoAlignBandSize		;go align first to begin with**Get smaller band by cutting Y size in half, and align Y size to an even-imager-multiple:OpDoTrySmallerBand			lsr			OpDoLocInfoRect+ov2		;port: try smaller Y band sizeOpDoAlignBandSize			pha									;align to multiple for pr head pins							pha							pushword	OpDoLocInfoRect+ov2							import		ImagerGetVAlignFactor							jsr			ImagerGetVAlignFactor	;obtain vertical align factor in ACC							pha							_UDivide							pla									;ignore quotient from divide							pullword	ParamWordA				;get remainder							lda			OpDoLocInfoRect+ov2		;subtract to align it...							sec							sbc			ParamWordA							bcc			OpDoCantGetBandMem		;can't make it any smaller...							beq			OpDoCantGetBandMem							sta			OpDoLocInfoRect+ov2							bra			OpDoCalcLocInfoWidthOpDoCantGetBandMem			lda			#$0201					;abort with memory full tool err...OpDoExitAbortErrInACC		sta			errNo							sta			OpDoErrorStatus							rts**Figure out loc info width based on mode (320/640) in effect at recording time and loc info X size:							import		GetModeByte				;metrics to obtain 320/640 modeOpDoCalcLocInfoWidth		jsr			GetModeByte				;for finding number pixels per byte							sta			OpDoLocInfoSCB			;also put mode byte in locinfo							and			#$80					;check 320/640 mode bit...							cmp			#1						;...set carry if 640 mode							lda			OpDoLocInfoRect+oh2		;get rPage X2 in ACC							bcc			OpDoIts320				;320, so only divide rPageX2 by 2							lsr	a								;divide by 4 (640 mode), or...OpDoIts320					lsr	a								;by 2 (320 mode) -> # bytes per line							sta			OpDoLocInfoWidth		;store band width in bytes**Figure out how big the band buffer will be, given the above (width still in ACC):							pha									;result space for multiply...							pha							pha									;locinfo.width (bytes) still in acc							lda			OpDoLocInfoRect+ov2		;times number of lines...							ina							pha							_Multiply							pulllong	ParamLongB				;plB now has pix buff size we want							**Check if buffer size would be greater than the amount of free memory:OpDoCmpFreeMem				pha							pha							_RealFreeMem							plx							pla							lsr a							tay							txa							ror	a							tax							tya							lsr a							tay							txa							ror a								;now have free_mem/4 lo->A, hi->Y							cpy			ParamLongB+2			;cmp hi words							beq			OpDoCmpFreeMem1							bcs			OpDoCmpFreeMemOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpFreeMem1				cmp			ParamLongB+0			;cmp lo words							bcs			OpDoCmpFreeMemOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpFreeMemOk**Check if buffer size would be greater than maximum QD-allowed pix buffer size:OpDoCmpMaxPixBuff			lda			ParamLongB+2			;cmp hi words							cmp			#QDMaxPixBuff/65536							beq			OpDoCmpMaxPixBuff1							bcc			OpDoCmpMaxPixBuffOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpMaxPixBuff1			lda			ParamLongB+0			;cmp lo words							cmp			#QDMaxPixBuff//65536							bcc			OpDoCmpMaxPixBuffOk							brl			OpDoTrySmallerBand		;too big, try smallerOpDoCmpMaxPixBuffOk**Try asking for the memory for imaging bands and also obtain a PID for later mallocs/deallocs:OpDoDoBandMalloc			pha									;result space							pushword	#UserIDType				;type of process requesting ID							_GetNewID							;obtain PID							pullword	OpDoMemPID				;get it							pha									;result space...							pha							pushlong	ParamLongB				;pass size of block requested							pushword	OpDoMemPID				;pass PID							pushword	#$C000					;pass attr: locked/fixed							pha									;pass dummy location							pha							_NewHandle							pulllong	ParamLongA				;get handle, if we got one							bcc			OpDoOKBandMalloc		;go on if we got one							pushword	OpDoMemPID				;didn't get handle, try again...							_DeleteID							brl			OpDoTrySmallerBandOpDoOKBandMalloc			inc			OpDoSetupLevel			;bump the setup level to "1"*Dereference the handle and put the pointer in our locinfo:							lda			[ParamLongA]							sta			OpDoLocInfoPixPtr+0							ldy			#2							lda			[ParamLongA],y							sta			OpDoLocInfoPixPtr+2*Start banding gport.  This gp is one "band" into which slices of pictures are drawn & printed:							pushlong	#OpDoBandGrafPort		;init fields of grafport, alloc clip							_OpenPort							;and make it the current gp for now							bcc			OpDoOKOpenBandPort		;check for error							brl			OpDoExitAbortErrInACCOpDoOKOpenBandPort*The locinfo was prepared above, so now use it:							pushlong	#OpDoLocInfo			;attach our locinfo to our grafport							_SetPortLoc*Set QuickDraw's global internal clip buffers to handle the bigger size of our offscreen bitmap:							pushlong	#OpDoOldQDBuffRec		;save original buffer widths							_SaveBufDims*							lda			OpDoLocInfoWidth		;buff size for horiz num of bytes...							cmp			OpDoOldQDBuffMWid		;but never ever smaller!							bcs			OpDoSetBufDims1							lda			OpDoOldQDBuffMWidOpDoSetBufDims1				pha									;pass it to SetBufDims*							lda			OpDoOldQDBuffTxHi		;buff size height for font stuff...							lsr a							lsr a							clc							adc			OpDoOldQDBuffTxHi							pha									;pass it to SetBufDims*							lda			OpDoOldQDBuffFBRx		;buff size for font style mods...							pha									;pass it to SetBufDims*							_SetBufDims							;ask QD for bigger buffers							bcc			OpDoOKSetBufDims							brl			OpDoExitAbortErrInACC	;if err, abort pr loop and tool errOpDoOKSetBufDims			inc			OpDoSetupLevel			;if ok, bump setup level to "2"*Set port rect, clip rgn, and vis rgn of band gp to now-known rect instead of screen-sized defaults:							pushlong	#OpDoLocInfoRect		;(1) set main grafport rect							_SetPortRect							pushlong	#OpDoLocInfoRect		;(2) set clip region							_ClipRect							pha									;(3) set vis region							pha							_GetVisHandle						;leave hdl on stack for SetRectRgn							pushword	OpDoLocInfoRect+oh1							pushword	OpDoLocInfoRect+ov1							pushword	OpDoLocInfoRect+oh2							pushword	OpDoLocInfoRect+ov2							_SetRectRgn							*Install our own bottleproc into the band buffer grafport and save the addresses of real procs:							pushlong	#OpDoOldQDProcs			;save addresses of the real procs							_SetStdProcs						;and also get list for our							pushlong	#OpDoNewQDProcs			;modification and then install into							_SetStdProcs						;our band port; will get called							lda			#(PutText-1)			;from inside DrawPicture							sta			OpDoNewQDProcs+ostdText+0							lda			#^(PutText-1)							sta			OpDoNewQDProcs+ostdText+2							pushlong	#OpDoNewQDProcs							_SetGrafProcs														*Calculate # of band passes needed: (Imaging Y Size) / Band Y Size, rounded up, with remainder:							import		GetImagingSize			;get size of offscreen buffer we							jsr			GetImagingSize			;would have liked... will compare							tya									;portrait mode: get Y size in acc							ldx			OpDoLocInfoRect+ov2		;now ACC & X valid, go calc							stx			OpDoLastBandHeight		;ACC has imgsize,   ;initialize this							pha									;X has bandsize     ;result space							pha									;result space							pha									;pass tallness of pic to be printed							phx									;pass tallness of our band buffer							_UDivide							pla									;get quotient (# whole bands) in ACC							plx									;get remainder (# lines) in X							beq			OpDoCalcPassesStore		;skip next few lines if no remainder							stx			OpDoLastBandHeight		;if non-0 rem thn its sz of lst band,							ina									;and inc, must do 1 more smaller bandOpDoCalcPassesStore			sta			OpDoTotalBands			;now store number of passes needed*Now that we have a banding buffer and its grafport, set up memory for a 2nd gp for pict recording:							lda			printGrafPortPtr+0		;first copy the user-given parameter							sta			OpDoCalcGrafPortPtr+0	;to our own ptr-storage. if not nil,							lda			printGrafPortPtr+2		;then we'll use it; else, we point							sta			OpDoCalcGrafPortPtr+2	;our pointer at our storage and also							ora			printGrafPortPtr+0		;return the address of our storage							bne			OpDoMallocCalcGPDone	;back to the caller...							lda			#OpDoCalcGrafPort							sta			printGrafPortPtr+0							sta			OpDoCalcGrafPortPtr+0							lda			#^OpDoCalcGrafPort							sta			printGrafPortPtr+2							sta			OpDoCalcGrafPortPtr+2OpDoMallocCalcGPDone*Open the calc/record gp and make *it* the curr gp.  OpenPage will re-init it for each new page:							pushlong	OpDoCalcGrafPortPtr		;now use user's or our memory							_OpenPort							;as a grafport and alloc clip rgns							bcc			OpDoNoPortErr							brl			OpDoExitAbortErrInACC	;if err exit with acc setOpDoNoPortErr				_HidePen							;this port will never draw on screen							*Put up message to show that we're sending setup commands to the printer:							import		StMePrinterResetMesg							lda			#StMePrinterResetMesg							import		StatusMessage							jsr			StatusMessage							*Initialize the imager and obtain unique communication connection with device:							import		ImagerOpen							jsr			ImagerOpen							*Confirm the identity of the device; if incorrect, then put up message and cause print loop abort:							import		ImagerGetDeviceID							jsr			ImagerGetDeviceID							bcs			OpDoDeviceOK							lda			#prAbort							sta			OpDoErrorStatus							import		StMeWrongDevMesg							lda			#StMeWrongDevMesg							import		StatusMessage							jsr			StatusMessage							rtsOpDoDeviceOK							*Configure the imager with bandbuffer locinfo, quality, mode, idleproc, and other settings:							ldx			#OpDoLocInfo							ldy			#^OpDoLocInfo			;pass pointer to our band buffer							import		ImagerSetLocInfo		;locinfo struct to imager:							jsr			ImagerSetLocInfo		;lo->X, hi->Y*							import		GetPaper				;get 0..3 physical paper size in							jsr			GetPaper				;print record in A and pass to							import		ImagerSetPaperType		;imager in A, so that form feeds							jsr			ImagerSetPaperType		;will work correctly*							import		GetQuality				;get res setting from quality setting							jsr			GetQuality				;in print record in A and pass to							import		ImagerSetResolution		;imager in A; imgr will print smaller							jsr			ImagerSetResolution		;to compensate for our blown-up image*							import		GetVSize				;get vert 50% reduction setting from							jsr			GetVSize				;print record: A=0/1 if 100%v/50%v							import		ImagerSetVCondense		;pass this information back in A							jsr			ImagerSetVCondense		;to the imager*							import		GetIdleProc				;get idleproc pointer from print							jsr			GetIdleProc				;record: lo->X, hi->Y							import		ImagerSetIdleProc		;pass idleproc pointer to							jsr			ImagerSetIdleProc		;imager: lo->X, hi->Y*							ldx			#OpDoErrorStatus		;provide imager with the address of							ldy			#^OpDoErrorStatus		;the global prError status so that							import		ImagerSetAbortPoll		;it can abort if it ever goes nonzero							jsr			ImagerSetAbortPoll		;lo->X, hi->Y							*Request that the imager initialize the device for printing:							import		ImagerReset							jsr			ImagerReset							*Put up message to show that we're out of opendoc (many apps take quite a while after this):							import		StMePrepRxPgDataMesg							lda			#StMePrepRxPgDataMesg							import		StatusMessage							jsr			StatusMessage							*Exit from tool call; current grafport is the rec/calc gp; next expected call will be OpenPage:							rts*Static memory for holding QuickDraw's GrafPort drawing-environment-context data structures:OpDoBandGrafPort			ds.b		$AA						;port to manage banding bufferOpDoCalcGrafPort			ds.b		$AA						;port for calc/recording; app seesOpDoOldUserGrafPortPtr		dc.l		0						;user's currnt port before print loopOpDoCalcGrafPortPtr			dc.l		0						;pointer to our or user's calc port*User ID for mallocing memory during this routine for banding buffer, etc:OpDoMemPID					dc.w		0*GrafPort.LocInfo record describing banding buffer (offscreen pixelmap):OpDoLocInfo:OpDoLocInfoSCB				dc.w		0						;portSCBOpDoLocInfoPixPtr			dc.l		0						;ptrToPixImage ptr to imaging bufferOpDoLocInfoWidth			dc.w		0						;width of one scan line in bytesOpDoLocInfoRect				dc.w		0,0,0,0					;boundsRect in pixels*Further information about the bands into which the page image will be rendered:OpDoTotalBands				dc.w		0						;number of bands page is split intoOpDoLastBandHeight			dc.w		0						;height of special-case last band*Area for patching our bottleprocs into the banding-buffer-playback grafport and saving old procs:OpDoOldQDProcs				ds.b		$38						;bottleneck proc pointersOpDoNewQDProcs				ds.b		$38						;bottleneck proc pointers*QuickDraw global buffer size information record storage:OpDoOldQDBuffRec:												;to save/alter/restore QD buffersOpDoOldQDBuffMWid			dc.w		0OpDoOldQDBuffTxHi			dc.w		0OpDoOldQDBuffTxWi			dc.w		0OpDoOldQDBuffFBRx			dc.w		0*Setup-status used to shut things down correctly and global print-loop-error ("PrError") status:OpDoErrorStatus				dc.w		0						;our global error statusOpDoSetupLevel				dc.w		0						;0)mesg box 1)band malloc 2)bufdims*Information obtained from metrics calls needed later which require print record presence:OpDoTotalCopies				dc.w		0						;number of copies requestedOpDoPageRange1st			dc.w		0						;first page number requestedOpDoPageRangeLst			dc.w		0						;last page number requestedOpDoIsManFeed				dc.w		0						;GetFeed call result @ OpenDocOpDoRPageX2					dc.w		0						;from rPage from metricsOpDoRPageY2					dc.w		0						;from rPage from metricsOpDoImgSzX2					dc.w		0						;from get-imaging-size from metricsOpDoImgSzY2					dc.w		0						;from get-imaging-size from metrics*Keeping track of the number of times OpenPage/ClosePage pair is called:OpDoPageCounter				dc.w		0**OPENPAGE: Designates beginning of page definition.  Performs the following tasks:**	Exit if error status*	Ensure that we are using our or the user's grafport memory for the recording grafport*	Init, and make current, the recording grafport to all default penwidth, fonts, colors, etc.*	Inc page count and check to make sure we're inside page range: exit if no, set flag if yes*	Begin picture recording; all subsequent application's QuickDraw commands will be recorded*							export		OpenPageOpenPage*Check to make sure no print error exists; if so, disable this routine:							lda			OpDoErrorStatus							beq			OpPaDontDisableOpPaExit1					rtsOpPaDontDisable*Ensure that our pointer to the calculation/recording grafport is up to date if owned by caller:							lda			printGrafPortPtr+0							tax							ora			printGrafPortPtr+2							beq			OpPaDoneUpdateCalcGPPtr							stx			OpDoCalcGrafPortPtr+0							lda			printGrafPortPtr+2							sta			OpDoCalcGrafPortPtr+2OpPaDoneUpdateCalcGPPtr*Init the recording gp to all-default settings for new page, and set it as the current grafport:							lda			OpDoCalcGrafPortPtr+2	;get a copy of the calc grafport ptr							sta			ParamLongA+2			;and also pass it on the stack...							pha							lda			OpDoCalcGrafPortPtr+0							sta			ParamLongA+0							pha							_InitPort							;init and set as current gp							lda			#0						;zero the bounds rect so that							ldy			#oBoundsRect			;no physical drawing occurs; we doOpPaZeroBoundsRectLoop1		sta			[ParamLongA],y			;this here even if we're not in							iny									;page range							iny							cpy			#oBoundsRect+8							bne			OpPaZeroBoundsRectLoop1*Increment abs pg count so we can compare it against user-selected pg range; first number is 1:							inc			OpDoPageCounter*Show message in box that says we are dealing with, but not yet printing, the current page number:							import		StMeRxCurrentPgMesg							lda			#StMeRxCurrentPgMesg							jsr			ShowStatusWithPgNo		;string will be modified with page#*Assume we're not in page range; this flag may be modified in a moment:							stz			OpPaInPageRange*Check page range, we want no action if this page isn't to be printed, so exit if out of pg range:							ldx			OpDoPageRange1st		;see if we're going to do anything...							ldy			OpDoPageRangeLst		;at all... 1stpage->X Lstpage->Y							cpx			OpDoPageCounter			;cmp current page# with first page#							bcc			OpPaItsInRange1st		;current page# >= first page#...							bne			OpPaExit1				;abort if out of page rangeOpPaItsInRange1st			cpy			OpDoPageCounter			;cmp current page# with last page#							bcc			OpPaExit1				;if not current page# <= last page#*Tell ClosePage that we're really going to be recording a page for printing:							lda			#1							sta			OpPaInPageRange*Fill in X2,Y2 in rectangle/data used several times in a few moments:							lda			OpDoRPageX2				;get calculated size							sta			OpPaPicFrameX2			;store into our rect's X2,Y2...							lda			OpDoRPageY2							sta			OpPaPicFrameY2*But if user passed a non-NIL picture frame (scaling) rectangle, use it instead of ours:							lda			pageFramePtr+0			;check user picture frame for NIL...							ora			pageFramePtr+2							beq			OpPaDoneCpUsrPicFrame	;branch away if user passed NIL							ldy			#0						;else copy their rect...OpPaCpUsrPicFrameLoop1		lda			[pageFramePtr],y							sta			OpPaPicFrame,y							iny							iny							cpy			#8							bne			OpPaCpUsrPicFrameLoop1OpPaDoneCpUsrPicFrame*Set all clipping settings to rPage rect or user's rect:							pushlong	#OpPaPicFrame			;(1) set main grafport rect							_SetPortRect							pushlong	#OpPaPicFrame			;(2) set clip region							_ClipRect							pha									;(3) set vis region							pha							_GetVisHandle						;leave hdl on stack for SetRectRgn							pushword OpPaPicFrame+oh1							pushword OpPaPicFrame+ov1							pushword OpPaPicFrame+oh2							pushword OpPaPicFrame+ov2							_SetRectRgn*Tell QuickDraw to start making drawing commands go into picture definition and not to screen:							pha									;result space...							pha							pushlong	#OpPaPicFrame			;user's or our picframe							_OpenPicture						;has effect of a "_HidePen"							pulllong	OpPaPictureHdl			;save this even though we do bprocs*Done; current gp is the rec/calc port; app will do qd commands now which will be recorded:OpPaExit					rts*Picture frame rectangle for passing to OpenPicture and to ClipRect:OpPaPicFrame				dc.w		0,0						;Y1,X1OpPaPicFrameY2				dc.w		0						;Y2OpPaPicFrameX2				dc.w		0						;X2*Handle to the picture containing the definition of the current page:OpPaPictureHdl				dc.l		0						;handle from/for QD pict calls*Flag to indicate whether we are actually recording and printing the current page:OpPaInPageRange				dc.w		0						;are we really doing a page**CLOSEPAGE: Designates end of page definition.  Performs the following tasks:**	Exit if error or abort status, or if we weren't in selected from..to page range*	Finish the picture recording process*	Loop for all copies*	Do manual sheet-feed dialog, if necessary; allow abort request*	Loop for all bands*	Call DrawPicture to render marks within the band for which we have memory, at blown-up size*	Call Imager to cause the printer to mark the paper with the data in banding memory*	Disable the print loop if abort is requested by application or user*							export		ClosePageClosePage*Check print loop status; if set, then disable this routine:							lda			OpDoErrorStatus							beq			ClPaDontDisableClPaExit1					rtsClPaDontDisable*Check if currently in page range, ie, check if OpenPage really recorded a page for us:							lda			OpPaInPageRange							beq			ClPaExit1							*We've obtained a pict defining current page contents, so stop recording:							_ClosePicture							*Now switch from the recording grafport to the playback/banding grafport:							pushlong	#OpDoBandGrafPort							_SetPort**Initialize for looping through multiple copies of the current page:							lda			#1						;we'll count real-copy-numbers							sta			ClPaCurrentCopy			;from 1..TotalCopies**Head of code to print one copy:ClPaPrintOneMoreCopy		**Do manual-sheet-feed dialog with user if necessary; allow cancel option:							lda			OpDoIsManFeed			;find out if we have to do dialog							beq			ClPaManFeedDiDone		;don't do dialog if auto feed							_InitCursor							;arrow cursor							lda			OpDoPageCounter			;get curr pg in ACC so that we can							import		StatusMesgFeedPrompt	;put up the dialog until the user							jsr			StatusMesgFeedPrompt	;hits ok or cancel (if carry set)							bcc			ClPaManFeedDiNotCancel							brl			ClPaAbortPrintLoop		;if cancel hit, go terminateClPaManFeedDiNotCancel		_WaitCursor							;back to watch cursorClPaManFeedDiDone							**Display message that we are actually printing the current page number:							import		StMePrCurrentPgMesg							lda			#StMePrCurrentPgMesg							jsr			ShowStatusWithPgNo**Advance paper vertically to provide top margin:							lda			#printTopMargin			;do hardcoded vertical space since							import		ImagerLinefeed			;we don't support gap/no gap option							jsr			ImagerLinefeed***Initialize for looping through bands to print the picture a slice at a time:							lda			#1						;real-band-numbers starting at 1							sta			ClPaCurrentBand			;we'll stop at OpDoTotalBands***Head of code to print one band:ClPaPrintOneMoreBand***Get the scaled-up picture-playback size:							lda			OpDoImgSzX2				;store as 0,0,Y2,X2...							sta			ClPaDestRect+oh2							lda			OpDoImgSzY2							sta			ClPaDestRect+ov2							stz			ClPaDestRect+oh1							stz			ClPaDestRect+ov1***Calculate offset to play back the next part of picture into the banding buffer:ClPaCalcOffset				ldx			OpDoLocInfoRect+ov2							lda			ClPaCurrentBand			;get current band number index							dea									;minus one to get start index at 0							pha									;result space							pha							pha									;pass current band							phx									;pass band size							_Multiply							;multiply to get destrect offset							pullword	ParamWordA				;save for subtracts in a minute							pla									;ignore result hi word***Subtract the offset obtained above from Y1 & Y2:							lda			ClPaDestRect+ov1		;destrect.y1 -= band height * band#							sec							sbc			ParamWordA							sta			ClPaDestRect+ov1							lda			ClPaDestRect+ov2		;destrect.y2 -= band height * band#							sec							sbc			ParamWordA							sta			ClPaDestRect+ov2***Clear the band buffer to white using our (unmodified default white) band grafport background:							pushlong	#OpDoLocInfoRect							_EraseRect***Display message indicating that DrawPicture is creating image of current page:							import		StMeRenderingMesg							lda			#StMeRenderingMesg							import		StatusMessage							jsr			StatusMessage***Call DrawPicture to draw upscaled page image, showing only a slice into banding/imaging buffer:							pushlong	OpPaPictureHdl			;pass handle to page description							pushlong	#ClPaDestRect			;translation and scaling rect							_DrawPicture						;BOTTLEPROCS/PICCOMMENTS RUN NOW!***Change current message display (back) to the current-page message:							import		StMePrCurrentPgMesg							lda			#StMePrCurrentPgMesg							jsr			ShowStatusWithPgNo***Save current band's height because we might modify it next:							ldy			OpDoLocInfoRect+ov2							sty			ClPaCurrBandHeightSave***If last band, adjust bandsize here at the last minute because it might be shorter:ClPaAdjBand					lda			OpDoTotalBands			;get total # of bands to be done							cmp			#1						;no adjust if doing it all in 1 band							beq			ClPaDoneAdjBand			;(because LastBandHeight is 0)							cmp			ClPaCurrentBand			;now compare to curr band we're on							bne			ClPaDoneAdjBand			;no adjust if not last band							ldy			OpDoLastBandHeight							sty			OpDoLocInfoRect+ov2							ldx			#OpDoLocInfo			;make sure that the imager is							ldy			#^OpDoLocInfo			;informed of the new band size							import		ImagerSetLocInfo							jsr			ImagerSetLocInfoClPaDoneAdjBand***Call imager to convert pixelmap in band buffer to pr cmd sequences and transmit; exec idleproc:							import		ImagerPrint							jsr			ImagerPrint				;err status returned in ACC/carry***Check for imager errors and check the print loop status; if so, arrange to terminate:							bcc			ClPaNoAbort				;continue if nothing exceptional							cmp			#$0080					;did the user type command-period?							beq			ClPaAbortPrintLoop		;if so, arrange to terminate							lda			OpDoErrorStatus			;did idleproc do PrSetError?							beq			ClPaNoAbort				;if not, we're ok; else, terminate							***Imager err/command-period.  Do mesg/FF/set error status to render print loop ineffective:ClPaAbortPrintLoop			lda			#prAbort				;ensure that this flag is set so							sta			OpDoErrorStatus			;we will do no further printing							import		StMeCancellingMesg		;put up the cancelling message in							lda			#StMeCancellingMesg		;the box because it will take time							import		StatusMessage			;for the app to continue calling							jsr			StatusMessage			;our high-level print loop calls							import		ImagerFormfeed			;eject the page and exit...							jsr			ImagerFormfeed							brl			ClPaAbortExit							***Continue normally if there is no reason to abort:ClPaNoAbort***Restore bandsize in case it was modified if this was last band:							ldy			ClPaCurrBandHeightSave	;restore band size in struct and							sty			OpDoLocInfoRect+ov2		;make sure the imager is informed							ldx			#OpDoLocInfo							ldy			#^OpDoLocInfo							import		ImagerSetLocInfo							jsr			ImagerSetLocInfo***Tail of do-one-band code.  See if we need to do another band:							lda			ClPaCurrentBand			;get current band number index							cmp			OpDoTotalBands			;compare with total bands needed							bcs			ClPaOutOfBandsLoop		;if we're done, break out of loop							ina									;else increment and store back							sta			ClPaCurrentBand			;store it							brl			ClPaPrintOneMoreBand	;loop backClPaOutOfBandsLoop**Tail of do-one-copy code.  Do form feed to advance to next sheet:							import		ImagerFormfeed							jsr			ImagerFormfeed**Tail of do-one-copy code.  See if we need to print another copy:							lda			ClPaCurrentCopy			;get current copy number index							cmp			OpDoTotalCopies			;compare with total copies needed							bcs			ClPaOutOfCopiesLoop		;if we're done, break out of loop							ina									;else increment and store back							sta			ClPaCurrentCopy			;store it							brl			ClPaPrintOneMoreCopy	;loop backClPaOutOfCopiesLoop*Now done printing copies of current page or we need to abort:ClPaAbortExit*Deallocate storage for definition of this page:							pha									;save (undocumented) error, if any							pushlong	OpPaPictureHdl			;dealloc QD's mem for pict recording							_KillPicture						;we took care of recording ourselves							pla									;restore error from ClosePicture							beq			ClPaNoClosePictErr		;if error, return as tool-error							sta			errNoClPaNoClosePictErr*Exit; next expected print loop call is OpenPage:							rts*Status variables needed during loop to print copies of the current page:ClPaCurrentBand				dc.w		0ClPaCurrentCopy				dc.w		0*Inflated and translated picture playback rectangle:ClPaDestRect				dc.w		0,0,0,0*Temporary save area for band height for restore after special-case-last-band modification:ClPaCurrBandHeightSave		dc.w		0**CLOSEDOC: Designates end of all printing operation.  Performs the following tasks:**	Close communication connection with printer*	Ensure that we are using our or the user's grafport memory for the recording grafport*	Close recording grafport and banding grafport (releases memory), set old pre-OpenDoc grafport*	Deallocate banding memory*	Restore QuickDraw global clip buffer sizes back to pre-OpenDoc values*	Remove status message box*							export		CloseDocCloseDoc*Close port connection to printer as one of the first steps:							import		ImagerClose							jsr			ImagerClose*Ensure that our pointer to the calculation/recording grafport is up to date if owned by caller:							lda			printGrafPortPtr+0							tax							ora			printGrafPortPtr+2							beq			ClDoDoneUpdateCalcGPPtr							stx			OpDoCalcGrafPortPtr+0							lda			printGrafPortPtr+2							sta			OpDoCalcGrafPortPtr+2ClDoDoneUpdateCalcGPPtr*Restore previous grafport and close calculation and banding grafports:							pushlong	OpDoOldUserGrafPortPtr	;restore pre-pr-loop grafport first							_SetPort							lda			OpDoSetupLevel			;make sure we don't deallocate							cmp			#1						;unallocated resources...							bcc			ClDoDontDeallocPorts							pushlong	OpDoCalcGrafPortPtr		;clean up both of our grafports,							_ClosePort							;thus deallocating clip/vis rgn mem							pushlong	#OpDoBandGrafPort							_ClosePort							*Deallocate banding memory attached to our locinfo attached to our grafport:							pha									;dump our band mem	;result space							pha														;result space							pushlong	OpDoLocInfoPixPtr							;didn't keep hdl							_FindHandle												;so find from ptr							_DisposeHandle											;hdl on stack							pushword	OpDoMemPID				;dump our user ID							_DeleteIDClDoDontDeallocPorts*Set QuickDraw global internal clip buffers back to previous size:							lda			OpDoSetupLevel			;make sure we don't deallocate							cmp			#2						;unallocated resources...							bcc			ClDoDontResetBufDims							pushlong	#OpDoOldQDBuffRec							_RestoreBufDimsClDoDontResetBufDims*Finally, remove the status box as one of the last steps:							import		FinishStatusMessage							jsr			FinishStatusMessage							*Get rid of stray keystroke events and exit:							pha									;flush other keyboard events							pushword	#%0000000000001110							pushword	#0							_FlushEvents							pla*Exit; we are done with the print job; PrPicFile will be called but it need do nothing:ClDoExit					rts**GETPRINTLOOPERROR: This routine returns the value of the status variable in ACC:*							export		GetPrintLoopErrorGetPrintLoopError			lda			OpDoErrorStatus							rts**SETPRINTLOOPERROR: This routine stores the value of ACC into the status variable:*							export		SetPrintLoopErrorSetPrintLoopError			sta			OpDoErrorStatus							rts**SHOWSTATUSWITHPGNO: Displays string at adrs in ACC, with ASCII of OpDoPageCounter at posn 26:*ShowStatusWithPgNo			pha									;save original string address							ldx			OpDoPageCounter			;int to be converted to string							phx									;pass value to Int2Dec							clc									;compute lo word of where number goes							adc			#26							tax							phk									;compute hi word of where number goes							phk							pla							and			#$00FF							pha									;pass hi word where # goes to Int2Dec							phx									;pass lo word where # goes to Int2Dec							pushword	#5						;pass length to Int2Dec							pushword	#0						;pass "unsigned" to Int2Dec							_Int2Dec							pla									;restore original string address							import		StatusMessage							brl			StatusMessage			;exit through StatusMessage**PUTTEXT (QuickDraw BottleProc):**This is the patched-in text bottleproc, called during picture playback from within DrawPicture.*This routine attempts to censor certain text objects from being drawn, thus speeding up the*DrawPicture call, by preventing the normal text drawing code from executing if a text string does*not intersect with the banding buffer.  Only the vertical coordinates are checked, since we*only implement portrait orientation.*PutText						phb									;save QD's bank setting							phk									;we'll have direct-page set to QD's							plb									;and data-bank set to this driverPuTeSaveQDVars				pushword	QDDrawVerbDPLoc			;save QD variables because they							pushlong	QDTextPtrDPLoc			;will be altered if we do any							pushword	QDTextLengthDPLoc		;reentrant QD calls here (because							pushword	QDCharToDrawDPLoc		;we *are* inside a QD call now)							pushlong	QDRectPtrDPLoc							PuTeObtainString			lda			QDDrawVerbDPLoc			;obtain pointer and length to							cmp			#QDDrawCharVerbEqu		;current string and pass them on							bne			PuTeNotSingleChar		;stack for TextBounds call, despitePuTeItsSingleChar			lda			QDCharToDrawDPLoc		;the silly way in which the high-							sta			PuTeChar				;level QD routines have neglected							pushlong	#PuTeChar				;to deal with the three different							pushword	#1						;types: char, cstring, pstring							bra			PuTeDoTxBoundsCall1PuTeNotSingleChar			cmp			#QDDrawCStrVerbEqu							bne			PuTeItsPStringPuTeItsCString				ldy			#0							shortmPuTeCStrLenLoop				lda			[QDTextPtrDPLoc],y							beq			PuTeCStrLenLoopDone							iny							cpy			#256							bne			PuTeCStrLenLoopPuTeCStrLenLoopDone			longm							pushlong	QDTextPtrDPLoc							phy							bra			PuTeDoTxBoundsCall1PuTeItsPString				pushlong	QDTextPtrDPLoc							pushword	QDTextLengthDPLoc							PuTeDoTxBoundsCall1			pushlong	#PuTeTextRect			;reentrant QD call to figure out							_TextBounds							;a bounding rect around our string							PuTeRestoreQDVars			pulllong	QDRectPtrDPLoc			;restore QD variables that were							pullword	QDCharToDrawDPLoc		;altered because of the reentrant							pullword	QDTextLengthDPLoc		;TextBounds call above							pulllong	QDTextPtrDPLoc							pullword	QDDrawVerbDPLocPuTeCompareIntersect_y1top	lda			PuTeTextRect+ov1		;see if text.y1 is below top of band							sec									;do signed compare							sbc			OpDoLocInfoRect+ov1		;text may be inside band if true that							beq			PuTeCmpItsIn_y1top		;text.y1 is >= band.y1							bvs			PuTeCmpInv_y1top							bmi			PuTeCmpDone_y1							bra			PuTeCmpItsIn_y1topPuTeCmpInv_y1top			bpl			PuTeCmpDone_y1PuTeCmpItsIn_y1topPuTeCompareIntersect_y1bot	lda			PuTeTextRect+ov1		;see if text.y1 is above botm of band							sec									;do signed compare							sbc			OpDoLocInfoRect+ov2		;text may be inside band if true that							beq			PuTeCmpItsIn_y1bot		;text.y1 is <= band.y2							bvs			PuTeCmpInv_y1bot							bmi			PuTeCmpItsIn_y1bot							bra			PuTeCmpDone_y1PuTeCmpInv_y1bot			bmi			PuTeCmpDone_y1PuTeCmpItsIn_y1bot							bra			PuTeDontCensorText		;text.y1 is inside so don't censorPuTeCmpDone_y1													;text.y1 is not inside, go check y2PuTeCompareIntersect_y2top	lda			PuTeTextRect+ov2		;see if text.y2 is below top of band							sec									;do signed compare							sbc			OpDoLocInfoRect+ov1		;text may be inside band if true that							beq			PuTeCmpItsIn_y2top		;text.y2 is >= band.y1							bvs			PuTeCmpInv_y2top							bmi			PuTeCmpDone_y2							bra			PuTeCmpItsIn_y2topPuTeCmpInv_y2top			bpl			PuTeCmpDone_y2PuTeCmpItsIn_y2topPuTeCompareIntersect_y2bot	lda			PuTeTextRect+ov2		;see if text.y2 is above botm of band							sec									;do signed compare							sbc			OpDoLocInfoRect+ov2		;text may be inside band if true that							beq			PuTeCmpItsIn_y2bot		;text.y2 is <= band.y2							bvs			PuTeCmpInv_y2bot							bmi			PuTeCmpItsIn_y2bot							bra			PuTeCmpDone_y2PuTeCmpInv_y2bot			bmi			PuTeCmpDone_y2PuTeCmpItsIn_y2bot							bra			PuTeDontCensorText		;text.y2 is inside so don't censorPuTeCmpDone_y2													;text.y2 is not inside, go censorPuTeCensorText				plb									;neither text.y1|y2 were inside band							lda			#0						;restore QD's bank and exit no error							clc									;exit with rtl instead of branching							rtl									;to the real text drawing routinesPuTeDontCensorText			lda 		OpDoOldQDProcs+ostdtext+0							ina							sta			PuTeGotoQDStdText+1							lda			OpDoOldQDProcs+ostdtext+2							shortm							sta			PuTeGotoQDStdText+3		;either text.y1|y2 were inside band							longm								;so restore QD's bank and continue							plb									;execution of normal QD code							lda			#0							clcPuTeGotoQDStdText			jmp			>$FFFFFF				;NOTE: operand is stuffed*Variables needed by this routine:PuTeChar					dc.w		0						;storage for one-char text if neededPuTeTextRect				dc.w		0,0,0,0					;calculated bounding rect of string							endproc							end