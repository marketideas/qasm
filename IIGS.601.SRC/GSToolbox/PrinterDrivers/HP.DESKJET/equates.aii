*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: equates.aii -- Common direct page labels and equates for all to use        **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *********************************************************************************************Device and configuration information:*DeviceID					equ			5							;iDev: 1=IW, 2=LQ, 3=LW, 4=EpsonVersionID					equ			$0100						;Version ID word: $XXYY ==> X.Y**Memory allocation performance potentiometers:*UserIDType					equ			$1000						;UID for mem alloc calls, etc.LowMemAlertThresh			equ			(512)/64					;no alert if > (K) RealFreeMem**Imager fine-tuning potentiometers:*ImagerIPAFrequencyMask		equ			$3F							;idleproc/abort every 64 linesImagerRLEThreshold			equ			3							;run-length-encoding thresholdImagerQDPattVAlignFactor	equ			8							;allow for v align of QD patterns**QuickDraw-dependent equates:*QDMaxPixBuff				equ			$FFFF						;Maximum LocInfo.PtrToPixImageQDAuxTheKindDPLoc			equ			$A6							;contains kind of PicCommentQDAuxTheSizeDPLoc			equ			$A8							;contains size of PicCommentQDAuxTheHandleDPLoc			equ			$AA							;contains hdl to PicComment dataQDDrawVerbDPLoc				equ			$38							;"DrawVerb" quickdraw equateQDTextPtrDPLoc				equ			$DA							;"TextPtr" quickdraw equateQDTextLengthDPLoc			equ			$D8							;"TextLength" quickdraw equateQDCharToDrawDPLoc			equ			$D6							;"CharToDraw" quickdraw equateQDRectPtrDPLoc				equ			$D2QDDrawCharVerbEqu			equ			0							;"DrawCharVerb" quickdraw equateQDDrawTextVerbEqu			equ			1							;"DrawTextVerb" quickdraw equateQDDrawCStrVerbEqu			equ			2							;"DrawCStrVerb" quickdraw equateov1							equ			0							;Point data structure elementoh1							equ			2							;Point data structure elementov2							equ			4							;Point data structure elementoh2							equ			6							;Point data structure element**Dumb-printer-driver wDev imaging definition bits:*wDevGap						equ 		%0000000001000000			;6	1=normal 0=no vert gapwDevColor					equ			%0000000000100000			;5	1=color 0=grayscalewDevReduction				equ			%0000000000001000			;3	1=normal 0=50% reductionwDevVSize					equ			%0000000000000100			;2	1=normal 0=vert condensewDevOrientation				equ			%0000000000000010			;1	1=portrait 0=landscapewDevBetterText				equ			%0000000000000001			;0	1=high resolution printing**New print record definitions for new (>4.0) drivers, placed where "oprintX" used to be:*opFileBlockSize				equ			$64+0						;Granularity of spool mallocsopFileMemLimit				equ			$64+4						;When to start spooling to diskopCTable					equ			$64+8						;Color table for imagingopSCBList					equ			$64+12						;SCB list for imagingowQuality					equ			$64+16						;New print quality definitionsowPaperCrWidth				equ			$64+18						;Variable internal crWidth valueowResScaling				equ			$64+20						;Blow-up amount for Bett quality**Imaging routine/printer maximum resolutions.  These are starting points for metrics calculations:*maxResPortraitX				equ			300							;Printer pixels per inch (dpi)maxResPortraitY				equ			300							;in both hor & vert directionsprintTopMargin				equ			9							;Top margin in 1/72" unitsprintLineMargin				equ			4							;Left line margin in 1/16" unitspixMapCallCrWidth			equ			8*maxResPortraitX			;Carriage width for PrPixMap callpixMapCallPaperLength		equ			11*maxResPortraitY/2		;Paper tallness for PrPixMap callprRecCrWidth				equ			960							;Historical value apps expect**The following paper dimensions are in 1/16th inch units--they are 16 times too big (for accuracy):*paperTypeUsaLetter			equ			0							;8.5" 1/4" mrg x 11" 1/4" gappaperSizeUsaLetterX			equ			136							;US Letter MUST be type 0paperSizeUsaLetterY			equ			176paperSizeUsaLetterGap		equ			4paperTypeUsaLegal			equ			1							;8.5" 1/4" mrg x 14" 1/4" gappaperSizeUsaLegalX			equ			136							;US Legal MUST be type 1paperSizeUsaLegalY			equ			224paperSizeUsaLegalGap		equ			4paperTypeEurA4				equ			2							;210mm 1/8" mrg x 297mm 1/4" gappaperSizeEurA4X				equ			136							;Eur A4 MUST be type 2paperSizeEurA4Y				equ			187paperSizeEurA4Gap			equ			4paperTypeEnvNo10			equ			3							;9.5" 1/4" mrg x 4.125" 1/4" gappaperSizeEnvNo10X			equ			152							;Intl FF is supposed topaperSizeEnvNo10Y			equ			66							;be type 3, but this printerpaperSizeEnvNo10Gap			equ			4							;can't support itmaxPaperTypeID				equ			paperTypeEnvNo10			;NOTE: LENGTH OF THIS LIST!**Dialog boxes' item ID numbers... MUST be consecutive within groupings:*mesgFeedPromptID			equ			10000						;for status message alertmesgFeedPromptOKButtID		equ			1							;for default <CR> actionmesgFeedPromptNGButtID		equ			10001mesgFeedPromptStringID		equ			10002titleItemID					equ			10100						;for combo Job/Style dialog...versionItemID				equ			10101cancelItemID				equ			10102okItemID					equ			10103paperTypeItemID				equ			11000paperTypeUsaLtrItemID		equ			12000+paperTypeUsaLetterpaperTypeUsaLglItemID		equ			12000+paperTypeUsaLegalpaperTypeEurA4ItemID		equ			12000+paperTypeEurA4paperTypeEnvNo10ItemID		equ			12000+paperTypeEnvNo10pageFeedItemID				equ			13000pageFeedManualItemID		equ			13001pageFeedAutoItemID			equ			13002pagesTitleItemID			equ			13003pagesAllItemID				equ			13004pagesRangeItemID			equ			13005pagesFromTitleItemID		equ			13006pagesToTitleItemID			equ			13007copiesTitleItemID			equ			13008pagesFromBoxItemID			equ			13009pagesToBoxItemID			equ			13010pagesFromToSeparatorItemID	equ			13011copiesBoxItemID				equ			13012effectsCondensedItemID		equ			13013effectsCondensedNoItemID	equ			13014effectsCondensedYesItemID	equ			13015printQualityItemID			equ			13016printQualityLoResItemID		equ			13017printQualityMeResItemID		equ			13018printQualityHiResItemID		equ			13019**Temporary direct-page storage which is NOT maintained across driver calls or driver re-entries:*ParamWordA					equ			0					;word		;parameter passing betweenParamWordB					equ			2					;word		;subroutines and temporaryParamWordC					equ			4					;word		;storage use...ParamWordD					equ			6					;wordParamWordE					equ			8					;wordParamWordF					equ			10					;wordParamLongA					equ			12					;longParamLongB					equ			16					;longParamLongC					equ			20					;longParamLongD					equ			24					;longOptionA						equ			28					;word		;for passing input paramsOptionB						equ			30					;word		;to metrics routineserrNo						equ			32					;word		;tool error output from usDialogWindowPtr				equ			34					;long		;gp ptr during job/stl dlogOldGrafPortPtr				equ			38					;long		;saving gp behind dlogprintRecordHandle			equ			42					;long		;usr inp; need for metricsprintGrafPortPtr			equ			46					;long		;user inputpageFramePtr				equ			50					;long		;user inputstatusRecPtr				equ			54					;long		;user inputDPSize						equ			58+1				;DP size on stack; <256 b/c stack params!DPSizeParamOnly				equ			28+1				;DP size for just using some params only