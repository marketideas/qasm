*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: dialogdata.aii -- User-interface text strings and dialog layout            **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.aii'							include		'm16.util'							include		'e16.control'							include		'e16.window'							include		'e16.dialog'DialogDataRec				record		export**STATUSWINDOWTEMP: Window template for status box:*							export		StatusWindowTempStatusWindowTemp			dc.w		StatusWindowTempEnd-StatusWindowTemp	;paramLength Word							dc.w		fAlert+fQContent+fVis					;wFrameBits Word							dc.l		0										;wTitle Pointer							dc.l		0										;wRefCon Long 							dc.w		0,0,0,0									;wZoom	Rect							dc.l		0										;wColor WindColorPtr							dc.w		0										;wYOrigin Integer							dc.w		0										;wXOrigin Integer							dc.w		200										;wDataH Word 							dc.w		640										;wDataW Word 							dc.w		200										;wMaxH Word 							dc.w		640										;wMaxW Word							dc.w		0										;wScrollVer Word							dc.w		0										;wScrollHor Word							dc.w		0										;wPageVer Word							dc.w		0										;wPageHor Word 							dc.l		0										;wInfoRefCon Long							dc.w		0										;wInfoHeight Word							dc.l		0										;wFrameDefProc Pointer							dc.l		0 										;wInfoDefProc Pointer							dc.l		0 										;wContDefProc Pointer							dc.w		20										;wPosition Rect Y1							export		StatusWindowCoordX1						;for 320/640 modStatusWindowCoordX1			dc.w		12										;wPosition Rect X1							dc.w		20+25									;wPosition Rect Y2							export		StatusWindowCoordX2						;for 320/640 modStatusWindowCoordX2			dc.w		308										;wPosition Rect X2							dc.l		$FFFFFFFF								;wPlane GrafPortPtr							dc.l		0										;wStorage WindRecPtrStatusWindowTempEnd:							export		StatusWindowTextY						;Y1 local text coordStatusWindowTextY			dc.w		15**MANFEEDALERTTEMP: Alert template for manual feed status dialog:*							export		ManFeedAlertTempManFeedAlertTemp			dc.w		20										;boundsRect Y1							export		ManFeedAlertTempCoordX1ManFeedAlertTempCoordX1		dc.w		12										;boundsRect X1							dc.w		20+50									;boundsRect Y2							export		ManFeedAlertTempCoordX2ManFeedAlertTempCoordX2		dc.w		308										;boundsRect X2							dc.w		mesgFeedPromptID						;alertID							dc.b		$80										;stage 1 - no beep							dc.b		$80										;stage 2 - no beep							dc.b		$80										;stage 3 - no beep							dc.b		$80										;stage 4 - no beep							dc.l		ManFeedAlertTempOKButtItem				;item #1							dc.l		ManFeedAlertTempNGButtItem				;item #2							dc.l		ManFeedAlertTempStringItem				;item #3							dc.l		0										;terminator							ManFeedAlertTempOKButtItem	dc.w		mesgFeedPromptOKButtID					;itemID							dc.w		28,180,0,0								;coords							dc.w		buttonItem								;itemType							dc.l		ManFeedAlertTempOKButtStr				;itemDescriptor							dc.w		0										;itemValue							dc.w		0										;itemFlag							dc.l		0										;itemColorManFeedAlertTempOKButtStr	str			'Continue'ManFeedAlertTempNGButtItem	dc.w		mesgFeedPromptNGButtID					;itemID							dc.w		28,85,0,0								;coords							dc.w		buttonItem								;itemType							dc.l		ManFeedAlertTempNGButtStr				;itemDescriptor							dc.w		0										;itemValue							dc.w		0										;itemFlag							dc.l		0										;itemColorManFeedAlertTempNGButtStr	str			'Cancel'ManFeedAlertTempStringItem	dc.w		mesgFeedPromptStringID					;itemID							dc.w		9,84,200,640							;coords							dc.w		statText+itemDisable					;itemType/disabled							dc.l		ManFeedAlertTempStringStr				;itemDescriptor							dc.w		0										;itemValue							dc.w		0										;itemFlag							dc.l		0										;itemColorManFeedAlertTempStringStr	dc.b		ManFeedAlertTempStrE-ManFeedAlertTempStrBManFeedAlertTempStrB		dc.b		'Insert sheet for page: '							export		ManFeedAlertTempPageNo					;for modificationManFeedAlertTempPageNo		dc.b		'XXXXX'ManFeedAlertTempStrE**Status messages used in the status box during the progress of the printing loop:*							export		StMeMallocMesg							;during bandbuff getStMeMallocMesg				str			'Allocating imaging memory'							export		StMePrinterResetMesg					;during pr reset cmdStMePrinterResetMesg		str			'Setting up printer'							export		StMePrepRxPgDataMesg					;on out of openpageStMePrepRxPgDataMesg		str			'Ready to receive page data'							export		StMeRxCurrentPgMesg						;MUST be 30 chars!StMeRxCurrentPgMesg			str			'Receiving data for page: XXXXX'							export		StMePrCurrentPgMesg						;MUST be 30 chars!StMePrCurrentPgMesg			str			'Printing a copy of page: XXXXX'							export		StMeRenderingMesg						;during DrawPictureStMeRenderingMesg			str			'Rendering page image'							export		StMeCancellingMesg						;during abort opsStMeCancellingMesg			str			'Cancelling'							export		StMeWrongDevMesg						;if not our printerStMeWrongDevMesg			str			'Device not a DeskJet Plus'**WINDOWTEMP: Window template for both of our dialogs (we just make the controls fit one size box):*							export		WindowTempWindowTemp					dc.w		WindowTempEnd-WindowTemp				;paramLength Word							dc.w		fAlert+fQContent+fVis					;wFrameBits Word							dc.l		0										;wTitle Pointer							dc.l		0										;wRefCon Long 							dc.w		0,0,0,0									;wZoom	Rect							dc.l		0										;wColor WindColorPtr							dc.w		0										;wYOrigin Integer							dc.w		0										;wXOrigin Integer							dc.w		200										;wDataH Word 							dc.w		640										;wDataW Word 							dc.w		200										;wMaxH Word 							dc.w		640										;wMaxW Word							dc.w		0										;wScrollVer Word							dc.w		0										;wScrollHor Word							dc.w		0										;wPageVer Word							dc.w		0										;wPageHor Word 							dc.l		0										;wInfoRefCon Long							dc.w		0										;wInfoHeight Word							dc.l		0										;wFrameDefProc Pointer							dc.l		0 										;wInfoDefProc Pointer							dc.l		0 										;wContDefProc Pointer							dc.w		20										;wPosition Rect Y1							export		WindowCoordX1							;for 320/640 modWindowCoordX1				dc.w		12										;wPosition Rect X1							dc.w		180										;wPosition Rect Y2							export		WindowCoordX2							;for 320/640 modWindowCoordX2				dc.w		308										;wPosition Rect X2							dc.l		$FFFFFFFF								;wPlane GrafPortPtr							dc.l		0										;wStorage WindRecPtrWindowTempEnd:**Coordinates for adornment line separating title/version info from controls in the dialog boxes:*							export		WindowLineY:equ							export		WindowLineX1:equ							export		WindowLineX2:equWindowLineY					equ			14WindowLineX1				equ			7WindowLineX2				equ			287			**JOBSTYLECONTROLTEMP: Control templates for the dialog window:*							export		JobStyleControlTempJobStyleControlTemp			dc.l		printQualityItem							dc.l		effectsCondensedItem							dc.l		paperTypeItem							dc.l		pageFeedItem							dc.l		pagesToBoxItem							dc.l		pagesFromToSeparatorItem							dc.l		pagesFromBoxItem							dc.l		pagesRangeItem							dc.l		pagesAllItem							dc.l		pagesTitleItem							dc.l		copiesBoxItem							dc.l		copiesTitleItem							dc.l		titleItem							dc.l		versionItem							dc.l		cancelItem							dc.l		okItem							dc.l		0							export		PortTitleLen							;"printername/XXX"...							export		PortTitleStr							;... set Len & Str							export		PortTitleLenOrig:equ					;... for informationtitleItem					dc.w		8										;pCount							dc.l		titleItemID								;ID							dc.w		3,6,13,258								;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		TiItStart								;TextRefPortTitleLen				dc.w		PortTitleLenOrig						;space for len byteTiItStart					dc.b		'DeskJet PLUS / 'TiItEnd:PortTitleStr				dc.b		'XXXXXXXXXXXXXXX'						;space for portnamePortTitleLenOrig			equ			TiItEnd-TiItStart						;for computations			versionItem					dc.w		8										;pCount							dc.l		versionItemID							;ID							dc.w		3,258,13,298							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@VeTiStart								;TitleRef							dc.w		@VeTiEnd-@VeTiStart						;Use "VersionID"...@VeTiStart					dc.b		'v'										;...equate to...							dc.b		('0'+(VersionID/256))					;...generate code...							dc.b		'.'										;...for version...							dc.b		('0'+(VersionID//256))					;...string@VeTiEnd:										export		cancelItemKeyEquiv:equcancelItem					dc.w		9										;pCount							dc.l		cancelItemID							;ID							dc.w		143,124,143+11,124+70					;Rect							dc.l		simpleButtonControl						;ProcRef							dc.w		0										;Flags							dc.w		$3000									;MoreFlags							dc.l		0										;RefCon							dc.l		@Title									;TitleRef							dc.l		0										;ColorTableRef							dc.b		cancelItemKeyEquiv						;KeyEquiv							dc.b		cancelItemKeyEquiv							dc.w		0							dc.w		0@Title						str			'Cancel'cancelItemKeyEquiv			equ			27										;escape key equiv										export		okItemKeyEquiv:equokItem						dc.w		9										;pCount							dc.l		okItemID								;ID							dc.w		143,208,143+11,208+68					;Rect							dc.l		simpleButtonControl						;ProcRef							dc.w		1										;Flags							dc.w		$3000									;MoreFlags							dc.l		0										;RefCon							dc.l		@Title									;TitleRef							dc.l		0										;ColorTableRef							dc.b		okItemKeyEquiv							;KeyEquiv							dc.b		okItemKeyEquiv							dc.w		0							dc.w		0@Title						str			'OK'okItemKeyEquiv				equ			13										;return key equiv										paperTypeItem				dc.w		9										;pCount							dc.l		paperTypeItemID							;ID							dc.w		88,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		paperTypePopUpMenu						;MenuRef							export		paperTypeInitValuepaperTypeInitValue			dc.w		paperTypeUsaLtrItemID					;InitialValuepaperTypePopUpMenu			dc.b		'$$Paper Type:\H'							dc.w		paperTypeItemID							dc.b		0*														dc.b		'--US Letter.......8.5"x11"\H'							dc.w		paperTypeUsaLtrItemID							dc.b		0*														dc.b		'--US Legal.........8.5"x14"\H'							dc.w		paperTypeUsaLglItemID							dc.b		0*														dc.b		'---\N256D',0*														dc.b		'--European A4.......8"x12"\H'							dc.w		paperTypeEurA4ItemID							dc.b		0*														dc.b		'--Envelope (#10)...9"x4"\H'							dc.w		paperTypeEnvNo10ItemID							dc.b		0*							dc.b		'.'			printQualityItem			dc.w		9										;pCount							dc.l		printQualityItemID						;ID							dc.w		120,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		printQualityPopUpMenu					;TitleRef							export		printQualityInitValueprintQualityInitValue		dc.w		printQualityLoResItemID					;InitialValueprintQualityPopUpMenu		dc.b		'$$Quality:\H'							dc.w		printQualityItemID							dc.b		0							dc.b		'--75 DPI   (1x)\H'							dc.w		printQualityLoResItemID							dc.b		0							dc.b		'--150 DPI (2x)\H'							dc.w		printQualityMeResItemID							dc.b		0							dc.b		'--300 DPI (4x)\H'							dc.w		printQualityHiResItemID							dc.b		0							dc.b		'.'effectsCondensedItem		dc.w		9										;pCount							dc.l		effectsCondensedItemID					;ID							dc.w		104,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		effectsCondensedPopUpMenu				;TitleRef							export		effectsCondensedInitValueeffectsCondensedInitValue	dc.w		effectsCondensedNoItemID				;InitialValueeffectsCondensedPopUpMenu	dc.b		'$$Height:\H'							dc.w		effectsCondensedItemID							dc.b		0							dc.b		'--Normal (Graphics)\H'							dc.w		effectsCondensedNoItemID							dc.b		0							dc.b		'--Condensed (Text)\H'							dc.w		effectsCondensedYesItemID							dc.b		0							dc.b		'.'pageFeedItem				dc.w		9										;pCount							dc.l		pageFeedItemID							;ID							dc.w		67,7,0,0								;Rect							dc.l		popUpControl							;ProcRef							dc.w		32										;Flags							dc.w		$1004									;MoreFlags							dc.l		0										;RefCon							dc.w		92										;TitleWidth							dc.l		pageFeedPopUpMenu						;MenuRef							export		pageFeedInitValuepageFeedInitValue			dc.w		pageFeedAutoItemID						;InitialValuepageFeedPopUpMenu			dc.b		'$$Sheet Feed:\H'							dc.w		pageFeedItemID							dc.b		0							dc.b		'--Automatic\H'							dc.w		pageFeedAutoItemID							dc.b		0							dc.b		'--Manual\H'							dc.w		pageFeedManualItemID							dc.b		0							dc.b		'.'			pagesTitleItem				dc.w		8										;pCount							dc.l		pagesTitleItemID						;ID							dc.w		40,7,40+12,7+50							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize@TitleStart					dc.b		'Pages:'@TitleEnd:pagesAllItem				dc.w		8										;pCount							dc.l		pagesAllItemID							;ID							dc.w		39,99,39+12,99+20						;Rect							dc.l		radioControl							;ProcRef							dc.w		0										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		pagesAllTitle							;TitleRef							export		pagesAllInitValue			pagesAllInitValue			dc.w		0										;InitialValuepagesAllTitle				str			'All'			pagesRangeItem				dc.w		8										;pCount							dc.l		pagesRangeItemID						;ID							dc.w		52,99,52+12,99+36						;Rect							dc.l		radioControl							;ProcRef							dc.w		0										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		pagesRangeTitle							;TitleRef							export		pagesRangeInitValuepagesRangeInitValue			dc.w		0										;InitialValuepagesRangeTitle				str			''							export		pagesFromBoxStringpagesFromBoxItem			dc.w		8										;pCount							dc.l		pagesFromBoxItemID						;ID							dc.w		51,125,51+13,125+57						;Rect							dc.l		$83000000								;"lineEditControl"							dc.w		0										;Flags							dc.w		$7000									;MoreFlags							dc.l		0										;RefCon							dc.w		5										;MaxSize							dc.l		pagesFromBoxString						;DefaultRefpagesFromBoxString			str			'XXXXX'										export		pagesToBoxStringpagesToBoxItem				dc.w		8										;pCount							dc.l		pagesToBoxItemID						;ID							dc.w		51,210,51+13,210+57						;Rect							dc.l		$83000000								;"lineEditControl"							dc.w		0										;Flags							dc.w		$7000									;MoreFlags							dc.l		0										;RefCon							dc.w		5										;MaxSize							dc.l		pagesToBoxString						;DefaultRefpagesToBoxString			str			'XXXXX'pagesFromToSeparatorItem	dc.w		8										;pCount							dc.l		pagesFromToSeparatorItemID				;ID							dc.w		53,188,53+12,188+50						;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize@TitleStart					dc.b		'--'@TitleEnd:copiesTitleItem				dc.w		8										;pCount							dc.l		copiesTitleItemID						;ID							dc.w		26,7,26+12,7+50							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize@TitleStart					dc.b		'Copies:'@TitleEnd:										export		copiesBoxStringcopiesBoxItem				dc.w		8										;pCount							dc.l		copiesBoxItemID							;ID							dc.w		24,99,24+13,99+57						;Rect							dc.l		$83000000								;PR: lineEditControl							dc.w		0										;Flags							dc.w		$7000									;MoreFlags							dc.l		0										;RefCon							dc.w		5										;MaxSize							dc.l		copiesBoxString							;DefaultRefcopiesBoxString				str			'XXXXX'**MEALALERTBOXSTRING: AlertWindow template string for 75 vs 80 dpi horizontal metrics warning:*							export		MeAlAlertBoxStringMeAlAlertBoxString			dc.b		'5'										;box size spec							dc.b		'3'										;icon spec "Note"							dc.b		'/'										;separator							dc.b		'Device and screen resolutions do not'	;message text...							dc.b		' match.  Margin adjustment may be'							dc.b		' required.'							dc.b		'/'										;separator							dc.b		'^#0'									;btn dflt "OK" id=0							dc.b		0										;terminator							**LOMEALERTBOXSTRING: AlertWindow template string for low-memory warning:*							export		LoMeAlertBoxStringLoMeAlertBoxString			dc.b		'5'										;box size spec							dc.b		'3'										;icon spec "Note"							dc.b		'/'										;separator							dc.b		'Text and other objects may not be'		;message text...							dc.b		' rendered properly due to low memory.'							dc.b		'/'										;separator							dc.b		'#1'									;btn "Cancel" id=0							dc.b		'/'										;separator							dc.b		'^#0'									;btn dflt "OK" id=1							dc.b		0										;terminator							**ABOUTCONTROLTEMP: Control template for the about box, using some of the items from dialogs above:*							export		AboutControlTempAboutControlTemp			dc.l		aboutLineItem4							dc.l		aboutLineItem3							dc.l		aboutLineItem2							dc.l		aboutLineItem1							dc.l		versionItem							dc.l		aboutTitleItem							dc.l		0							aboutTitleItem				dc.w		8										;pCount							dc.l		0										;ID							dc.w		3,6,13,258								;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		TiItStart								;TitleRef--use above							dc.w		(TiItEnd-TiItStart)-3					;TextSize--chop " / "aboutLineItem1				dc.w		9										;pCount							dc.l		0										;ID							dc.w		59,0,59+10,296							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize							dc.w		1 										;Justification@TitleStart					dc.b		'Printer Driver'@TitleEnd:aboutLineItem2				dc.w		9										;pCount							dc.l		0										;ID							dc.w		74,0,74+10,296							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags							dc.w		$1000									;MoreFlags							dc.l		0										;RefCon							dc.l		@TitleStart								;TitleRef							dc.w		@TitleEnd-@TitleStart					;TextSize							dc.w		1 										;Justification@TitleStart					dc.b		'by'@TitleEnd:aboutLineItem3				dc.w		9										;pCount							dc.l		0										;ID							dc.w		89,0,89+10,296							;Rect							dc.l		statTextControl							;ProcRef							dc.w		1										;Flags				