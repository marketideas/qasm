*******************************************************************************************                                                                                        **		Apple IIgs Printer Driver                                                        **                                                                                        **		File: entry.aii -- Entry Points; environment (D/B) setup; dispatch to routines   **                                                                                        **		Written by Ben Koning                                                            **		Copyright (C) 1990 Apple Computer, Inc.                                          **                                                                                        *******************************************************************************************							include		'equates.aii'							include		'm16.util'							include		'e16.print'EntryProc					proc		export**New (Apple IIgs System Disk 5.0 and later), re-entrant, driver entry point:*Entry						dc.w		0							dc.w		(DispatchEnd-DispatchBegin)/4**Save/Set Bank and Direct registers (D page; B=K), assume no errors, dispatch to routines:*							phb									;Save B byte for later restore							phd									;Save D word for later restore							cpx			#((17-1)*4)+1			;See if call # is in range							bcc			Entry1							brk			#$BB					;Should never happenEntry1						tsc							sec							sbc			#DPSize					;Stack frame for small direct page							tcsStackParam					equ			1+3+3+1+2+DPSize		;1 + RTL1 + RTL2 + B + D + StackFrame							ina							tcd									;Set our D to our stack frame							phk							plb									;Set our B; now can use abs addr							stz			errNo					;Assume no error unless set later on							jmp			(DispatchBegin,x)		;Go do one of our routines														**Dispatch table:*DispatchBegin											dc.l		BK_PrDefault			;PrDefault - initialize print record							dc.l		BK_PrValidate			;PrValidate - sanitize print record							dc.l		BK_PrJobStlDialog		;PrStlDialog - user interface							dc.l		BK_PrJobStlDialog		;PrJobDialog - user interface							dc.l		BK_PrDriverVer			;PrDriverVer - version number							dc.l		BK_PrOpenDoc			;PrOpenDoc - alloc printing resources							dc.l		BK_PrCloseDoc			;PrCloseDoc - dealloc pr resources							dc.l		BK_PrOpenPage			;PrOpenPage - define start of page							dc.l		BK_PrClosePage			;PrClosePage - causes page to print							dc.l		BK_PrPicFile			;PrPicFile - call after PrCloseDoc							dc.l		BK_Reserved				;Reserved							dc.l		BK_PrError				;PrError - get current print status							dc.l		BK_PrSetError			;PrSetError - set print status/abort							dc.l		BK_PrChanged			;PrChanged - report NBP driver name							dc.l		BK_PrPixelMap			;PrPixelMap - allow full res access							dc.l		BK_PrGetPrinterSpecs	;PrGetPrinterSpecs - get self-id info							dc.l		BK_PrGetPgOrientation	;PrGetPgOrientation - port/land modeDispatchEnd**Embedded credit message:*							dc.b		'HP DESKJET DRIVER - Ben Koning - (C) Apple'							**EXIT: Jump here when done doing driver call.*After removing direct page stack frame, this routine moves 9 bytes at bottom of stack X number*of bytes up, restores D/B, leaves A and carry with error status, and RTLs.  Note that 2 RTLs are*assumed to be on the stack.*Exit						tsc									;Get rid of our little scratch area							clc							adc			#DPSize							tcs	 						cpx			#0						;Have to do this compare for 0							beq			Exit3							stx			TmpNumMov							tsc							sta			Exit1+1							clc							adc			TmpNumMov							sta			Exit2+1							push1		#0							plb									;Our data bank is 0 at this point							ldy			#8						;9+(0 because we're JMPed-to) - 1Exit1						lda			$FFFF,yExit2						sta			$FFFF,y							dey							dey							bpl			Exit1							phk							plb							lda			Exit2+1							tcs									;S restoredExit3						lda			errNo					;get errNo for use in a sec...							pld									;D restored--no more direct addrs							plb									;B restored--no more absolute addrs							cmp			#1						;ACC has err... set carry if nonzero							rtl									;Exit back to print manager*TmpNumMov					dc.w		0						;Temporary storage used above******************************************************************************************************The following routines do all the work of the printer driver, or at least contain JSRs to*routines in other files.  The following has happened on entry to these routines:**		* The caller's D/B registers have been saved*		* The D register is the same as the K register so absolute adressing can be used*		* The B register points to DPSize free bytes on the stack for scratch usage*		* "errNo" has been set to zero, assuming no errors from the routine*		* Since caller's environment was saved on stack, the driver is re-entrant.**These routines should do their work by:**		* Accessing input/output parameters on the stack by means of LDx/STx StackParam+N,s,*		  where the N refers to the relative offset (ie, 0,2,4 would be 3 words on the stack)*		* Using our small direct page area, JSRing to other assembly files, using the stack*		* Changing "errNo" to be nonzero if error flagging is desired*		* Calling routines in this driver if desired (some port driver calls actually do this)*		* LDX #N, where N is the number of input parameter bytes used by the routine*		* JMP/BRL Exit.**The exit routine will then:**		* Dump our small direct page off of the stack*		* Dump input parameters off of the stack*		* Restore the caller's D/B registers from stack*		* Set the A register with value of "errNo" and set the carry if nonzero*		* Exit via RTL.*****************************************************************************************************BK_Reserved					ldx			#2						;$0002 - Tool Locator func not found							stx			errNo*							ldx			#0						;assume no bytes to strip off stack							brl			Exit********************************************************************************************************************************************************************************************************BK_PrDefault				lda			StackParam+0,s			;This routine fills in the user's							sta			printRecordHandle+0		;area of memory with a default							lda			StackParam+2,s			;print record with standard options							sta			printRecordHandle+2*							import		InitPrintRecord							jsr			InitPrintRecord			;Metrics routine*							ldx			#4						;# of input param bytes to strip							brl			Exit****************************************************************************************************														****************************************************************************************************BK_PrValidate				lda			StackParam+0,s			;This routine checks to make sure							sta			printRecordHandle+0		;the user's print record is							lda			StackParam+2,s			;self-consistent and up to date,							sta			printRecordHandle+2		;and changes it if necessary*							import		GetOkOurDriver							jsr			GetOkOurDriver			;Metrics: Same driver as last time?							beq			PrVaAllCorrect			;wow, this print record is perfect							import		InitPrintRecord							jsr			InitPrintRecord			;take over print record for us							lda			#1						;recAdjustFlag := true							bra			PrVaExit							import		CalcMetricsPrVaAllCorrect				jsr			CalcMetrics				;make sure self-consistent							lda			#0						;recAdjustFlag := false*PrVaExit					sta			StackParam+4,s			;store recAdjustFlag result							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrJobStlDialog			lda			StackParam+0,s			;This routine uses data in the							sta			printRecordHandle+0		;user's print record to properly							lda			StackParam+2,s			;draw a dialog, and allows the							sta			printRecordHandle+2		;user to modify that data*							import		GetOkOurDriver			;ensure a valid rec for this driver							jsr			GetOkOurDriver			;Metrics: Same driver as last time?							beq			PrDiAllCorrect			;wow, this print record is perfect							import		InitPrintRecord			;not same driver as last time, so...							jsr			InitPrintRecord			;...take over print record for us							import		CalcMetricsPrDiAllCorrect				jsr			CalcMetrics				;make sure self-consistent, though*							import		CheckAndDoAboutBox		;do about box if requested							jsr			CheckAndDoAboutBox*							import		CheckAndDoMetricsAlert	;do metrics alert box if needed							jsr			CheckAndDoMetricsAlert*							import		ConductJobStyleDialog	;go do the dialog, ACC will have							jsr			ConductJobStyleDialog	;value of T/F if OK/Cancel							cmp			#0						;did user select cancel?							beq			PrDiDone				;if so, return to caller with 0							import		CheckAndDoLowMemAlert	;else, OK selected, so do low-mem							jsr			CheckAndDoLowMemAlert	;alert, ACC will have T/F if OK/Cncl*PrDiDone					sta			StackParam+4,s			;return confirmFlag to user							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrDriverVer				lda			#VersionID				;This routine returns the version							sta			StackParam+0,s			;number of this particular driver*							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrOpenDoc				lda			StackParam+0,s			;This routine clears error status,							sta			printGrafPortPtr+0		;and initializes and sets a GrafPort							lda			StackParam+2,s			;with boundsrect, etc., configured							sta			printGrafPortPtr+2		;for the resolution of the printer.							lda			StackParam+4,s			;If printGrafPtr is NIL, we allocate							sta			printRecordHandle+0		;our own space, else we use the							lda			StackParam+6,s			;caller's GrafPort and configure it.							sta			printRecordHandle+2*							import		OpenDoc							jsr			OpenDoc					;print loop routine*							lda			printGrafPortPtr+0		;pass GrafPort back to user,							sta			StackParam+8,s			;in case we allocated it here...							lda			printGrafPortPtr+2							sta			StackParam+10,s							ldx			#8						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrCloseDoc				lda			StackParam+0,s			;this routine closes the printing							sta			printGrafPortPtr+0		;grafport, frees its memory if the							lda			StackParam+2,s			;caller passed NIL during OpenDoc,							sta			printGrafPortPtr+2		;restores grafport and stops spooling*							import		CloseDoc							jsr			CloseDoc				;print loop routine*							ldx			#4						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrOpenPage				lda			StackParam+0,s			;This routine keeps track of #pages							sta			pageFramePtr+0			;and works only if within page range							lda			StackParam+2,s			;this routine calls OpenPicture with							sta			pageFramePtr+2			;pageframe of rPage or user-select							lda			StackParam+4,s			;the current (print) grafport is							sta			printGrafPortPtr+0		;re-initialized, and SpoolPut is							lda			StackParam+6,s			;called explicitly to store initial							sta			printGrafPortPtr+2		;info PutPic doesn't get called for*							import		OpenPage							jsr			OpenPage				;print loop routine*							ldx			#8						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************							import		ClosePage				;This routine terminates a pageBK_PrClosePage				jsr			ClosePage				;print loop routine*							ldx			#4						;# of input param bytes to strip							brl			Exit					;(we didn't need input parameters)********************************************************************************************************************************************************************************************************BK_PrPicFile				ldx			#12						;Does nothing; we only do imm mode							brl			Exit					;# of input param bytes to strip********************************************************************************************************************************************************************************************************							import		GetPrintLoopErrorBK_PrError					jsr			GetPrintLoopError		;err in acc from print loop routine							sta			StackParam+0,s							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************							import		SetPrintLoopErrorBK_PrSetError				lda			StackParam+0,s			;get in acc							jsr			SetPrintLoopError		;print loop routine							ldx			#2						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrChanged				pushlong	#PrChDevNameStr			;Informs port driver of type of							ldx			#$1913					;device; important for networking							jsl			$E10000					;_PrDevPrChanged							ldx			#0						;# of input param bytes to strip							brl			Exit					;we're donePrChDevNameStr				str			'='						;ID string in appletalk NBP format							str			'HP DeskJet'			;even though appletalk is not							str			'*'						;supported in this driver********************************************************************************************************************************************************************************************************BK_PrPixelMap				pha									;Abort if no port. Result space...							ldx			#$3013					;ask currently installed port driver							jsl			$E10000					;_DevIsItSafe							pla							bne			PiMaOKDevice			;true result: no error							lda			#portNotOn				;else: return with tool error							sta			errNo							bra			PiMaExitPiMaOKDevice*							import		ImagerOpen				;start the imager							jsr			ImagerOpen							lda			StackParam+6,s			;get srcLocPtr lo in X							tax							lda			StackParam+8,s			;get srcLocPtr hi in Y							tay							import		ImagerSetLocInfo		;tell imager about the locinfo							jsr			ImagerSetLocInfo							import		ImagerReset				;prepare to print							jsr			ImagerReset							import		ImagerPrint				;print the bitmap							jsr			ImagerPrint							import		ImagerClose				;stop the imager							jsr			ImagerClose*PiMaExit					ldx			#10						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrGetPrinterSpecs		lda			#DeviceID		 		;pass our device identification							sta			StackParam+0,s							lda			#1						;pass "1" -- black/white only							sta			StackParam+2,s							ldx			#0						;# of input param bytes to strip							brl			Exit********************************************************************************************************************************************************************************************************BK_PrGetPgOrientation		lda			StackParam+0,s			;This routine returns the value							sta			printRecordHandle+0		;of the orientation setting just							lda			StackParam+2,s			;to try to keep the application out							sta			printRecordHandle+2		;of the print record*							lda			#0						;Orientation is always portrait							sta			StackParam+4,s*							ldx			#4						;# of input param bytes to strip							brl			Exit****************************************************************************************************							endproc							end