### Dependencies for building both the imagewriter and imagewriter.lq drivers.all				Ä	imagewriter  imagewriter.lq### Dependancies for IWimagewriter			Ä		iw.asm.obj			¶							dialogdata.asm.obj	LINKIIGS iw.asm.obj dialogdata.asm.obj -o imagewriter -t $BB -at $0001#Commented out since all of we have a real LQ driver now.  Also, all of this code is going away#soon.#imagewriter.lq			Ä		lq.asm.obj			¶#							dialogdata.asm.obj#	LINKIIGS lq.asm.obj dialogdata.asm.obj -o imagewriter.lq -t $BB -at $0001		### Dependancies for iw.asm.obj### Setting the variable lq to 0 will build the regular Imagewriter driveriw.ASM.obj 			Ä 		iw.asm				¶							hld.asm				¶							lld.asm	ASMIIGS -d lq=0 iw.asm		### Dependencies for lq.asm.obj  ### Setting the variable lq to 1 will build the Imagewriter LQ driverlq.asm.obj			Ä		iw.asm				¶							hld.asm				¶							lld.asm	ASMIIGS -d lq=1 iw.asm -o lq.asm.obj### Dependancies for dialogdata.asm.OBJdialogdata.asm.obj	Ä		dialogdata.asm	ASMIIGS dialogdata.asm	