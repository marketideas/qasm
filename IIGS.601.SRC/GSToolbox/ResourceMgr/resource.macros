	PRINT	PUSH	PRINT	OFF			; Apple IIGS Resource Manager Macros;;; © Apple Computer, Inc. 1988; All Rights Reserved;;ResourceToolNum	equ	$001E MACRO&lab _ResourceStartup&lab ldx #$0200+ResourceToolNum     jsl $E10000 MEND MACRO&lab _ResourceShutdown&lab ldx #$0300+ResourceToolNum     jsl $E10000 MEND MACRO&lab _ResourceVersion&lab ldx #$0400+ResourceToolNum     jsl $E10000 MEND MACRO&lab _ResourceReset&lab ldx #$0500+ResourceToolNum     jsl $E10000 MEND MACRO&lab _ResourceStatus&lab ldx #$0600+ResourceToolNum     jsl $E10000 MEND MACRO&lab _CreateResourceFile&lab ldx #$0900+ResourceToolNum     jsl $E10000 MEND MACRO&lab _OpenResourceFile&lab ldx #$0A00+ResourceToolNum     jsl $E10000 MEND MACRO&lab _CloseResourceFile&lab ldx #$0B00+ResourceToolNum     jsl $E10000 MEND MACRO&lab _AddResource&lab ldx #$0C00+ResourceToolNum     jsl $E10000 MEND MACRO&lab _UpdateResourceFile&lab ldx #$0D00+ResourceToolNum     jsl $E10000 MEND MACRO&lab _LoadResource&lab ldx #$0E00+ResourceToolNum     jsl $E10000 MEND MACRO&lab _RemoveResource&lab ldx #$0F00+ResourceToolNum     jsl $E10000 MEND MACRO&lab _MarkResourceChange&lab ldx #$1000+ResourceToolNum     jsl $E10000 MEND MACRO&lab _SetCurResourceFile&lab ldx #$1100+ResourceToolNum     jsl $E10000 MEND MACRO&lab _GetCurResourceFile&lab ldx #$1200+ResourceToolNum     jsl $E10000 MEND MACRO&lab _SetCurResourceApp&lab ldx #$1300+ResourceToolNum     jsl $E10000 MEND MACRO&lab _GetCurResourceApp&lab ldx #$1400+ResourceToolNum     jsl $E10000 MEND MACRO&lab _HomeResourceFile&lab ldx #$1500+ResourceToolNum     jsl $E10000 MEND MACRO&lab _WriteResource&lab ldx #$1600+ResourceToolNum     jsl $E10000 MEND MACRO&lab _ReleaseResource&lab ldx #$1700+ResourceToolNum     jsl $E10000 MEND MACRO&lab _DetachResource&lab ldx #$1800+ResourceToolNum     jsl $E10000 MEND MACRO&lab _UniqueResourceID&lab ldx #$1900+ResourceT