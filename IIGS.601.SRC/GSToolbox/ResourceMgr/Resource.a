	PAGESIZE 82		;Number of lines per page.	PRINT NOGEN		;Do not expand macros in listing.	BLANKS OFF		;No white space in the operand field.DebugSymbols	equ 0Version	equ $0103	;2-Apr-93 SS******************************************************************************* Apple IIGS Resource Manager** Copyright Apple Computer, Inc. 1988-1992* All Rights Reserved** Programmer: Dan Oliver******************************************************************************** Description:** Resource Manager is a tool that reads	and writes data blocks to disk* and keeps track of those data blocks while they are on disk and in * memory.******************************************************************************** Definitions:** NIL: When dealing with handles and pointers I assume that memory* in the first page	of memory ($000000-$0000FF) is not valid.* Therfore, a NIL pointer or handle is one that has bits 8-23* (middle word) as zero.  I do this because it can be done,	a* handle or pointer	can be NIL by one stz, a handle or pointer* can be tested by 2 instructions instead of 3.  However, when* returning or getting NIL handles and pointers from the* application, the entire LONG is zero.********************************************************************************  Files:	INCLUDE 'M16.Memory'	INCLUDE 'M16.Locator'	INCLUDE 'M16.Resources'	include 'M16.Misctool'	include 'M16.Loader'	include 'M16.Debug'	include 'M16.Util2'		include 'E16.GSOS'	include 'E16.Memory'*	Resource.a  		;Source code for all of Resource Manager.********************************************************************************  Modification History             **  Version 0.0*  06/20/88 Dan - Start of project.**  Version 0.1*  07/20/88 Dan - Make committee changes.  Remove names. Change spec from to LONG to *	separate type (WORD), ID (LONG).  Change attributes from byte to WORD.*	Change offset from 3 bytes to LONG.*  09/15/88 Dan - Version $8100 alpha release.*  09/21/88 Dan - EOF was not being set	when file space was	allocated past current EOF.*	An error occurred when tring to write a resource or map past EOF.  Fixed*	by setting EOF each time space is allocated past the current EOF.*  09/27/88 Dan - InsertIndexRef was not computing the correct number of bytes to move*	when inserting an index reference.  It was moving (used+1)records instead*	of (used records)+2 bytes.*  10/04/88 Dan - Added purge level parameter to ReleaseResource.  Allows resource's purge*	level to be set or its handle disposed.*  10/04/88 Dan - Add load resource at absolute address.  Added resAbsLoad flag.*  10/04/88 Dan - Implemented preLoad resources.*  10/07/88 Dan - AddResource was sometime clearing the ID field of the last resource*	in the index.  This fixes a problem introduced on 9/27/88.*  10/10/88 Dan - Changed status version number to 2.*  10/24/88 Dan - Added ResourceConverter call to allow routines to be logged in to*	convert resources on read and writes.*  10/24/88 Dan - WriteResource was not returning errors.*  10/25/88 Dan - Changed error code values and removed error codes not used.*  10/26/88 Dan - Changed the login flag to ResourceConverter.*  10/26/88 Dan - Added error code resDiffConverter.*  10/31/88 Dan - ResourceStatus was not returning NIL in A.*  11/09/88 SEG - LoadRes returned the wrong handle to calling routine if*	   converter had allocated a different handle and disposed of first one.*  11/11/88 Dan - Changed GetIndResource to return resource ID instead of handle.*  11/14/88 Dan - Changed SetResourceLoad and SetResourceFileDepth to return their original*	values.*  11/23/88 Dan - writeRes was not restoring the resource handle's attributes correctly.*  12/05/88 Dan - Changed PreLoad code to load resources as they are ordered on disk rather*	than index order.  Quick tests showed the new way to be about 2.7 times*	faster for the case of 20 resources with mixed locations and 4.2 times*	when another 20 resources were added.  I think at some point it will be*	slower but more testing is needed.*  12/05/88 Dan - Added code to append resource fork to file that is not an extended file.*  12/06/88 Dan - Added code to leave system file open across quits.*  12/07/88 Dan - Change status version number to 5.*  12/07/88 Dan - Resource was not marked as needing update by SetResourceAttr.*  12/14/88 Dan - Changed read flag and file depth values to be part of each application's*	record instead of global flags.  SetResourceLoad and SetResourceFileDepth*	both return errors if there is no current application logged in.*  12/14/88 Dan - UpdateResourceFile was not returning error from resource writes.*  12/16/88 Dan - CloseResourceFile was using file depth when it shouldn't have.*  01/09/89 Dan - Changed copyright date.*  01/09/89 Dan - Changed access in open file block from 3 to 0.*  01/13/89 Dan - At startup I call ResourceStartup to log in the Resource Manager as an*	application.  This is so tools can make calls using the system file*	without having the application log in.  This also means that all *	resNoCurApp errors go away as well as checking to make sure there is*	a current app.  There is always a current app now.*  01/20/89 Dan - Allow NIL to be passed as pathname pointer to OpenResourceFile which *	specifies that the system resource file is to be opened.  The error*	resSysIsOpen is returned if the system file has already been opened as*	the system file.  Changed boot code to use the new parameter.  The opened*	system file's handle is added to every application's file list.*  01/20/89 Dan - Changed CloseResourceFile to zero the sysFile variable when closing the*	system file to show there is no system file.  Also, removed system file*	handle from every application's file list.*  01/20/89 Dan - In trying to handle disk full errors I am now writing allocated disk blocks*	when they are allocated to see if disk space is really there.  The writing*	only happens when the allocated block extends the EOF.  For map resizing*	this proves to be no fun.  The map can grow while in the process of growing*	the map.  To try to stop this from happening I make sure their are a few*	extra free records on AddResource and RemoveResource.  This is so there*	should be enough free records to handle one grow.*  01/20/89 Dan - ResourceShutdown now frees all resources in the system file map that were*	loaded by the application shutting down.*  01/24/89 Dan - Was setting openAccess instead of openRequestAcc when opening system*	resource file.*  02/03/89 Dan - SetResourceID was not marking the map as dirty.  Fixed.*  02/03/89 Dan - PreLoaded resources were always loaded without regard for the SetResourceLoad*	value.  Changed to respect the load status.*  02/08/89 Dan - resProtected was not being used.*  02/08/89 Dan - CloseResouceFile was not returning correct error codes.*  02/13/89 Dan - Change OSEvent.  Told to change current level.*  02/21/89 Dan - Add file access parameter to OpenResourceFile for network.*  02/24/89 Dan - Changed AddResource to store handle's master pointer in resource index*	instead of handle when it is an absolute resource.*  03/06/89 Dan - Change on 2/21/89 created a bug.  Open request access had always been zero,*	but the change changed the requested access to whatever.  CreateResourceFile*	thought it was still zero and ended up using whatever access was left over*	from the last OpenResourceFile call.  Changed so CreateResourceFile always*	opens a file with its given access.*  03/08/89 Dan - SysFileChange was not working at all. Fixed.*  03/16/89 Dan - OpenResourceFile would close any file with a reference number of $0063*	if the file did not have a resource fork.*  04/19/89 Dan - Disposed of allocated resource handle if there isn't a converter for a*	resource that needs a converter.  If LoadResource fails because of no*	converter an error and nil handle will be returned.  If the converter*	fails it must dispose of the resource handle and clear the resHandle*	field and return an error.*  05/12/89 Dan - Unable to grow resource map.  Error showed up when trying to add 11th*	resource.  Must have been introduced 4/19/89.*  05/12/89 Dan - Incorrect GS/OS error code returned from LoadResource if read failed.*  05/12/89 Dan - LoadResource was returning valid handle if read failed.  Change so*	empty handle returned if handle can be purged, else nil returned.*  05/15/89 Dan - LoadResource returned invalid error in some cases, like loading a resource*	that was already loaded.  Introduced 5/12/89.*  05/25/89 Dan - ResourceStartup did not expand application list correctly after 20 startups.*  05/31/89 Dan - Took out prototype bit from version number.*  06/07/89 Dan - Disposed of sysConvertList when going to P8 and on shutdown. There should*	not be any converters logged in at that point and the empty convert list*	was a handle whose position was causing low memory problems.  So it's gone.*  06/07/89 Mensch - zero out the sysConvertList handle in data after its disposed.*  06/08/89 Dan - Added resDiskFull error code comments to AddResource, UpdateResourceFile,*	and RemoveResource.  Also modified Mensch's change, only the middle word*	needed to be zeroed.*  07/26/89 Dan - Added freeAppRes routine to check if resource is owned by application*	before disposing of the resources in the system file on ResourceShutdown.*  08/28/89 Dan - Added setFileRefNum routine.  UpdateResourceFile now calls setFileRefNum.*	WriteResource calls setFileRefNum early than it use to set refNums.*	AddResource calls setFileRefNum now, fixes bug Andy found.  RemoveResource,*	and ReleaseResource calls setFileRefNum, fixes possible bug.*  08/29/89 Dan - AddResource left map locked sometimes.  UpdateResourceFile didn't always*	lock map when needed.  UniqueResourceID left map locked sometimes.*	Changed include file macros from ALL.MACROS to each file.  ALL.MACROS*	seems to have gone away from MPW.**  1/25/90 Mensch - Added some code to the OSRestart routine that allows us to call*	resource startup again. and relog the resource manager. Bump version.*  8/09/90 Harry  - Fix bug where merging two free blocks resulted in a bad resource map.*	In routine "freefileblock" the a reg was getting trashed upon returning*	from "getMapLong".  The a-reg contained the low word of the "next" free *	block and was needed as input to routine "addToMapLong2".** 20-Dec-90	Dave Lyons*	Rolled version to $8102.*	Making *all* resource files get opened at a system level, not just*	Sys.Resources.*	The internal level used is now $0030, just so we can recognize it.** 19-Jan-91	Dave Lyons*	Added $291E LoadResource2 call.  Takes buffer pointer, resource Type,*	resource ID; returns resource handle, status in buffer: -1=not loaded,*	other values = previous handle attributes.** 21-Jan-91	Dave Lyons*	Adding an unused flag word to LoadResource2--this lets me expand the*	buffer later if I want.*	Added FixLockedStatus routine for LoadResource and LoadResource2 so*	that loading an already-loaded resource which has the locked attribute*	re-locks the handle if it hasn't been purged.  In other words, the*	sequence Load, Release to a purge level, HUnlock, and Load again won't*	leave you with a handle that can go away unexpectedly.** 11-Feb-91	Dave Lyons*	On startup and restart-from-P8, now we call openSystemFile *after**	ResourceStartUp($401E); this allows Sys.Resources resources to preload.** 26-Feb-91	Dave Lyons*	Make ResourceShutDown return new error resInvalidShutDown ($1E0F) if the*	current resource app is $401E.  This way $401E will really never get shut*	down.** 8-Mar-91	Dave Lyons*	Now we only shut ourself down on a switch to P8, *not* on an OSShutDown.*	This is important because the OS "okay, you can restart" dialog calls*	AlertWindow, and now AlertWindow calls LoadResource to get a pre-loaded*	icon resource from Sys.Resources.** 10-Mar-91	Dave Lyons*	Added new functions $2A1E FindNamedResource, $2B1E GetResourceName,*	$2C1E LoadNamedResource, $2D1E SetResourceName.  These are closely*	modelled after the HyperCard IIGS functions of the same names, but*	the parameters are slightly different in a couple cases.** 25-Mar-91	Dave Lyons*	Implemented bit 15 of OpenResourceFile reqAccess parameter = don't preload*	any resources from the file being opened.** 27-Mar-91	Dave Lyons*	Fixed bit 15 implementation--we still needed to call @preLoadResources to*	let it zero out the handle fields in the map, even if we don't want to*	actually preload stuff.** 4-Apr-91	Dave Lyons*	Fixed CreateResourceFile to really not use the access, filetype, auxtype*	parameters when the file already exists.  Sometimes it was getting an error*	$53 from Create if the caller knew the file existed and passed garbage for*	the auxtype.** 7-Apr-91	Dave Lyons*	Implemented input parameters $0000 and $FFFF to GetOpenFileRefNum.** 23-Apr-91	Dave Lyons*	CloseResource file input bit 15 forces file closed even if there was*	an error flushing stuff to disk.  File may be corrupted, but at least*	it gets closed!** 24-Apr-91	Dave Lyons*	Fixed bad SetResourceName bugs.  It should actually work now.** 25-Apr-91	Dave Lyons*	If a resource file's free list is corrupted, we try to die with fatal*	error $1E42 rather than trash the file.** 13-May-91	Dave Lyons*	Defined new error codes resDupStartUp ($1E12) for ResourceStartUp,*	resInvalidTypeOrID ($1E13) for rType=0/ID=0.*	Calls returning resInvalidTypeOrID: AddResource, SetResourceID,*	SetResourceName.** 24-Jun-91	Dave Lyons*	Fixed UniqueResourceID($FFFF,x) to never return $07FFxxxx results!** 1-Jul-91	Dave Lyons*	Changed a BNE to BCC in the previous fix, so that having strange-ID*	resources in a file will not mess up UniqueResourceID.  I think this*	is important if anyone ever has a $0FFFxxxx resource to override a*	ROM resource.** 7-Jul-91	Dave Lyons*	Changed named-resource call names to RMFindNamedReosurce, RMGetResourceName,*	RMLoadNamedResource, and RMSetResourceName (to avoid conflict with HCGS*	callback names).** 25-Jul-91	Dave Lyons*	¥In ReadRes while cleaning up after an error, we now dispose the handle if*	*any* error occurs during PurgeHandle, not just $0205.  Fixes problems where*	user hits Cancel on a please-insert-disk and the system returns a handle*	anyway.*	¥The mapNext field on Sys.Resources is now zeroed out, so it doesn't have to*	be NIL on disk.** 10-Oct-91	Dave Lyons*	¥If you set bit 31 of the MatchResourceFile result pointer, there is an extra*	word returned at the end of the structure (offset 6): the resource file id*	in which the handle was found.  This solves the ambiguity and makes this call*	actually useful!** 6-Nov-91	Dave Lyons*	¥Made CloseResFork check for refnum=0; never do a close-all!** 7-Nov-91	Dave Lyons*	¥OpenResource file with a non-nil "map pointer" (really fork pointer)*	preserves the mapFileNum in the passed map, and also preserves the resource*	handles in the passed map.** 9-Dec-91	Dave Lyons*	¥Make LoadResource check return address; if we're being called from the*	ROM 3 Control Manager to load a Control Defproc resource, set the system*	preferences to prompt for the boot disk with no Cancel button.  (NOTE--*	fix is not ROMable.  Could be made ROMable by moving oldSysPrefs word into*	fixed global storage, or doing something more beautiful with it.  My*	attempt to put it on the stack frame failed, and I didn't have time to*	mess with it.)** 5-Feb-92	Dave Lyons*	¥Version $0102 for 6.0 final.*************************************************************************************************** BEGIN 6.0.1** 2-Apr-92	Dave Lyons*	¥Version $8103 for 6.0.1d3.*	¥Fixed bug in CompareNames affecting RMFindNamedResource (and*	RMLoadNamedResource, which calls RMFindNamedResource).** 10-Apr-92	Dave Lyons*	¥CloseResourceFile with a nonzero input now returns resFileNotFound error*	if no files get closed (previously returned no error).** 14-Jul-92	Dave Lyons*	¥Added new call $2E1E OpenResourceFileByID(requestAccess,userID):oldCurApp.*	This calls ResourceStartUp for you (it's okay if you were already started).*	It doesn't tell you the newly-opened file's ID, but you can get that from*	GetCurResourceFile if you care.** 11-Jan-93	Jim Murphy*	¥Added new call $2F1E CompactResourceFile(flag,fileID). This removes all*	free blocks (except the last special EOF free block) from a given file by*	moving chunks around in the file.*	* 12-Jan-93	Jim Murphy*	¥Added some error checking code to OpenResourceFile that absolutely makes sure*	that the map was entirely read. This is only useful to those who pass damaged*	files off to us in the first place, but I'm in a nice mood today. If what is*	read doesn't equal what we asked for, writeRes returns a GS/OS eofEncountered*	error.*	¥Fixed WriteResource to write the size of the resource as it appears on disk,*	rather than the size of the resource's handle in memory. This properly allows*	for converters to write resources that are smaller than their in-memory size*	without destroying the file.*	¥Added a new bit to mapFlag. Bit 0 is now defined as fileReadWrite. When a file*	is opened, it gets set to 1 if the file is opened read/write. If it's only open*	with read access, then it's set to 0.*	¥AddResource now calls a new internal function, 'isFileWriteable' which checks*	the new mapFlag bit. If the function returns an error (y=invalidAccess), then*	the file isn't open for writing, and it makes no sense to allow the Add to*	proceed, so we don't. This lets you know that you can't do the Add now, rather*	than when the file is closed.*	¥MarkResourceChange now does exactly the same thing as described for AddResource*	above.** 13-Jan-93	Jim Murphy*	¥Made a few minor code optimizations to isFileWriteable as suggested by The Dave.*	I also stuck a call to isFileWriteable into CompactResourceFile since that was the*	function I wrote it for in the first place.*	¥Changed OpenResourceFile to clear the new mapFlag bit 0 (fileReadWrite) before*	stuffing in the new value. Someone could give us a file with it set since RezIIgs*	_can_ incorrectly set this bit with a flag. Thanks Dave.*	¥Changed my MarkResourceChange fix from yesterday to only return an invalidAccess*	error if the resource in question is being marked changed. If it's being marked*	unchanged (which won't eventually cause a write), then we allow it.** 25-Jan-93	Jim Murphy*	¥Fixed MarkResourceChange to only bother to check for read/write access if the*	resource in question is being marked changed. I had it only checking when you*	were marking one unchanged, and that's bad. I said that the 1/13/93 fix did this,*	but my logic was backwards. Whoops.** 27-Jan-93	Jim Murphy*	¥Added RemoveResource, WriteResource, SetResourceAttr, and SetResourceID to the group*	of functions which now verify that the target file can be written to before actually*	doing anything. They all now call isFileWriteable before making any changes, and return*	a GS/OS invalidAccess error if the file cannot be written to.** 1-Feb-93	Jim Murphy*	¥MarkResourceChange was allowing the Y-register to be nuked when it could mark the resource*	as changed. Whoops. It doesn't do that any more. This broke Genesys big-time, BTW.** 10-Feb-93	Dave Lyons*	¥Backed off the read-only checks in SetResourceAttr and SetResourceID, for compatibilty*	(with Steve S's System Icons init, for example--he's setting resource attributes to*	absolute-load and taking responsibility for forcing the file closed by setting bit 15*	to CloseResourceFile).** 2-Apr-93	Steve Stephenson**	¥Changed version to $0103 (final)**************************************************************************************************;================================================================================================;=ResourceMgr	PROC;=;= Description:;= This procedure contains all source code for the Resource	Manager.  It is done this ;= way because of the assembler inability to handle forward	references outside of PROCs.;= This means either structuring the code to fit the assembler or doing part of	the ;= assembly manually by using ENTRY statements.  Since ordering code for an assembler ;= and the use of ENTRY statements decreases readability and increases work the	code is;= in one PROC.;=;= However, within this one PROC routines are separated.  Routines start with a	nonlocal;= label with local	labels inside each routine.;=;= Inputs:;= There are no inputs because ResourceMgr is not a callable routine.;=;= Outputs:;= There are no outputs because ResourceMgr is not a callable routine.;=;= External References:;=;=;= Entry Points:	EXPORT ResToolTable		;Test program needs	this to install the	tool.;=   ;This can be removed when this is a loaded tool.;= ;================================================================================================;;;================================================================================================;  Handle record offsets.;================================================================================================;handPointer	equ 0		;Pointer to memory.handAttr	equ handPointer+4handOwner	equ handAttr+2handSize	equ handOwner+2handPrev	equ handSize+4handNext	equ handPrev+4;;;================================================================================================;  GS/OS equates.;================================================================================================;;; --- GS/OS stack entry point.;	IF  deBug THEN	ENTRY debugOScallGS_OS	equ debugOScall		Grab GS/OS calls to	display inputs.	MACRO&lab	_MyBlockMove&lab	jsl checkBlockMove	MEND	ELSEGS_OS	equ $E100B0		GS/OS stack entry point.;	MACRO&lab	_MyBlockMove&lab	ldx #$2B02	jsl $E10000	MEND	ENDIF;; --- Call numbers.;CREATE	equ $2001		Create file.OPEN	equ $2010		Open file.READ	equ $2012		Read from file.WRITE	equ $2013		Write to file.CLOSE	equ $2014		Close file.SET_MARK	equ $2016		Set file position mark.SET_EOF	equ $2018		Set EOF.GetLevel	equ $201BSetLevel	equ $201AAddOSQueue	equ $2034DeleteOSQueue	equ $2035;;; --- Create file parameter block offsets.;crePCount	equ 0		IN  - number of parameters.crePathname	equ crePCount+2		IN  - pointer to class 1 input string.creAccess	equ crePathname+4		IN  - access attribute.creFileType	equ creAccess+2		IN  - file type.creAuxType	equ creFileType+2		IN  - aux type.creStorageType	equ creAuxType+4		IN  - 1=standard, 5=extended, 13=directory.creDataEOF	equ creStorageType+2	IN  - bytes allocated for data fork.creResEOF	equ creDataEOF+4		IN  - bytes allocated for resource fork.creBlockSize	equ creResEOF+4		Size of open parameter block.;;; --- Open file parameter block offsets.;openPCount	equ 0		IN  - number of parameters.openRefNum	equ openPCount+2		OUT - open file reference number.openPathname	equ openRefNum+2		IN  - pointer to class 1 input string.openRequestAcc	equ openPathname+4		IN  - Request access.openForkNum	equ openRequestAcc+2	IN  - 0 to open data, 1 to open resource.openAccess	equ openForkNum+2		OUT - access attribute.openFileType	equ openAccess+2		OUT - file type.openAuxType	equ openFileType+2		OUT - aux type.openStorageType	equ openAuxType+4		OUT - 1=standard, 5=extended, 13=directory.openCreateTime	equ openStorageType+2	OUT - creation time	and date.openModTime	equ openCreateTime+8	OUT - last modified	time and date.openOptions	equ openModTime+8		IN  - pointer to list output buffer.openDataEOF	equ openOptions+4		OUT - bytes in data	fork.openDataBlocks	equ openDataEOF+4		OUT - blocks used in data fork.openResEOF	equ openDataBlocks+4	OUT - bytes in resource fork.openResBlocks	equ openResEOF+4		OUT - blocks used in resource fork.openBlockSize	equ openResBlocks+4		Size of open parameter block.;;; --- Read file parameter block offsets.;readPCount	equ 0		IN  - number of parameters.readRefNum	equ readPCount+2		IN  - open file reference number.readData	equ readRefNum+2		IN  - pointer to data area to read into.readSize	equ readData+4		IN  - number of bytes to read.readTransfer	equ readSize+4		OUT - number of bytes read.readBlockSize	equ readTransfer+4		Size of read parameter block.;;; --- Write file parameter block offsets.;writePCount	equ 0		IN  - number of parameters.writeRefNum	equ writePCount+2		IN  - open file reference number.writeData	equ writeRefNum+2		IN  - pointer to data to write.writeSize	equ writeData+4		IN  - number of bytes to write.writeTransfer	equ writeSize+4		OUT - number of bytes written.writeBlockSize	equ writeTransfer+4		Size of write parameter block.;;; --- Close file parameter block offsets.;closePCount	equ 0		IN  - number of parameters.closeRefNum	equ closePCount+2		IN  - open file reference number.closeBlockSize	equ closeRefNum+2		Size of close parameter block.;;; --- Set file position mark parameter block offsets.;markPCount	equ 0		IN  - number of parameters.markRefNum	equ markPCount+2		IN  - open file reference number.markBase	equ markRefNum+2		IN  - base of position.markPosition	equ markBase+2		IN  - file position.markBlockSize	equ markPosition+4		Size of set mark parameter block.;;; --- Set EOF parameter block offsets.;EOFPCount	equ 0		IN  - number of parameters.EOFRefNum	equ EOFPCount+2		IN  - open file reference number.EOFBase	equ EOFRefNum+2		IN  - base of position.EOFdisplacement	equ EOFBase+2		IN  - new EOF position.EOFBlockSize	equ EOFdisplacement+4	Size of EOF parameter block.;;; --- Get level parameter block offsets, these are guesses because of a lack of	documentation.;getLevelPCount	equ 0		IN  - number of parameters.getLevelCurrent	equ getLevelPCount+2	OUT - current level, $80xx if user, $00xx if system.getLevelMode	equ getLevelCurrent+2	GetLevel level_mode	flaggetLevelBlockSize	equ getLevelMode+2		Size of get level parameter block.;;; --- Set level parameter block offsets, these are guesses because of a lack of	documentation.;setLevelPCount	equ 0		IN  - number of parameters.setLevelCurrent	equ setLevelPCount+2	OUT - current level, $80xx if user, $00xx if system.setLevelMode	equ setLevelCurrent+2	SetLevel level_mode	flagsetLevelBlockSize	equ setLevelMode+2		Size of get level parameter block.;;; --- Add to OS queue parameter block offsets.;addQPCount	equ 0		IN  - number of parameters.addQProc	equ addQPCount+2		IN  - address of procedure to call with	OS events.addQBlockSize	equ addQProc+4		Size of parameter block.;;; --- Delete from OS queue parameter block offsets.;delQPCount	equ 0		IN  - number of parameters.delQProc	equ delQPCount+2		IN  - address of procedure to delete from queue.delQBlockSize	equ delQProc+4		Size of parameter block.;;; --- GS/OS error codes.;GSOS_IOerror	equ $0027GSOS_BadPath	equ $0040GSOS_PathNotFound	equ $0044GSOS_VolNotFound	equ $0045GSOS_FileNotFound	equ $0046GSOS_NoAccess	equ $004EGSOS_FileOpen	equ $0050GSOS_resNotFound	equ $0063	EJECT;================================================================================================; Resource Manager Equates;================================================================================================;;; --- Global Resource Equates.;ResToolNum	equ $001E		Resource Manager tool number.FileFormatVersion	equ 0		Version of file format.sysFileID	equ 1		ID of system file.ResMgrInternalFileLevel equ $30		;for SetLevel(2,...) [DAL];;; --- Resource Manager direct page offsets.;writeEOFflag	equ 1		TRUE if writing needed to allocate disk	space.saveDataAttr	equ writeEOFflag+2		Save handle attributes of data handle.mapHand	equ saveDataAttr+2		General map handle.mapPtr	equ mapHand+4		General map poointer.resPtr	equ mapPtr+4		General resource reference pointer.data	equ resPtr+4		Pointer data area.work	equ data+4		Local direct page work area.dPageSize	equ work+44-1		Size of Resource Manager direct page.;maxLocal	equ dPageSize+1		One greater than local direct page.;dataHand	equ maxLocal		Handle of data area.saveDpage	equ dataHand+4		Caller's direct page pointer.saveDbank	equ saveDpage+2		Caller's data bank.returnAddr1	equ saveDbank+1		Return address to tool locator.returnAddr2	equ returnAddr1+3		Return address to caller.inputs	equ returnAddr2+3		Inputs passed by caller.;;; --- Resource file	header offsets.;rFileVersion	equ 0		Version of resource	file format.rFileToMap	equ rFileVersion+4		Offset to map.rFileMapSize	equ rFileToMap+4		Size of map.rFileMemo	equ rFileMapSize+4		Reserved space for application.;rFileVer	equ 0		!!! Work around !!!FILEMAPSIZE	equ 8		!!! Work around !!!;;; --- Application record offsets.;appFlag	equ 0		0 = avaiable, 1 = used, $FFFF = end of array.appID	equ appFlag+2		User ID of application.appFiles	equ appID+2		Handle of app's first map of linked list, NIL=none.appCur	equ appFiles+4		Handle of app's current map, NIL if none.appConverters	equ appCur+4		Handle of app's converter list, NIL if none.appReadFlag	equ appConverters+4		1 to read, 0 to not	read resources.appFileDepth	equ appReadFlag+2		Number of files to search.appRecSize	equ appFileDepth+2		Size of application	record.;;; --- Converter list offsets.;converterListSize	equ 0convertList	equ converterListSize+2;convertType	equ 0converter	equ convertType+2convertRecSize	equ converter+4;;; --- Resource map record offsets.;mapNext	equ 0		Next resource map, NIL terminates list.mapFlag	equ mapNext+4		Bit flags.mapOffset	equ mapFlag+2		Map's file position.mapSize	equ mapOffset+4		Size of map in file.mapToIndex	equ mapSize+4		Offset to resource index.mapFileNum	equ mapToIndex+2		Open resource file reference number, NIL if ROM file.mapID	equ mapFileNum+2		Map's ID.mapIndexSize	equ mapID+2		Total number of records in index.mapIndexUsed	equ mapIndexSize+4		Number of used records in index.mapFreeListSize	equ mapIndexUsed+4		Number of BLOCK records in mapFree array.mapFreeListUsed	equ mapFreeListSize+2	Number of BLOCK records used in mapFree	array.mapFreeList	equ mapFreeListUsed+2; BYTE[n]  Resource	index.;; ------ mapFlag bits.;*** 12-Jan-93 JCM - New bit def. If this mapFlag bit is set, then the file in question is opened with***	read/write access. Otherwise, it's read-only.fileReadWrite	equ $0001		TRUE if file read/write FALSE if read-only*** end 12-Jan-93 JCMmapChanged	equ $0002		TRUE if map needs to be written to disk.;;;romFile	equ $0004		TRUE if file in ROM. - never supported/removed 12-Jan-93 JCM;;; ------ mapFlag NOT bits.;_fileReadWrite	equ $FFFE_mapChanged	equ $FFFD;;; ------ BLOCK record offsets.;blkOffset	equ 0		Offset, from top of	file, to block.  NIL terminates.blkSize	equ blkOffset+4		Size of block.blkRecSize	equ blkSize+4		Size of BLOCK record.;;; --- Resource index reference record offsets.;resType	equ 0		WORD Type of resource.resID	equ resType+2		LONG ID of resource.resOffset	equ resID+4		LONG Offset to resource in file.resAttr	equ resOffset+4		WORD Attributes of resource.resSize	equ resAttr+2		LONG Size of resource in bytes.resHandle	equ resSize+4		LONG Resource handle, NIL=not in memory, or address.resRecSize	equ resHandle+4;;; ------ resAttr bit equates.;resChanged	equ $0020resPreLoad	equ $0040resProtected	equ $0080resAbsLoad	equ $0400resMemAttr	equ $C31C		Bits passed to allocate memory.resConverter	equ $0800;     $0001  Available.;     $0002  Available.;     $1000  Available.;     $2000  Available.;;; ------ resAttr NOT bit equates.;_resChanged	equ $FFDF_resPreLoad	equ $FFBF_resProtected	equ $FF7F;;; --- Size of UniqueResourceID hash table.;hashSize	equ 512;;; --- Resource Manager data area offsets.;; ------ Part of data area that is initialized to static values.;createBlock	equ 0		Create file parameter block.openBlock	equ createBlock+creBlockSize	Open file parameter	block.readBlock	equ openBlock+openBlockSize	Read file parameter	block.writeBlock	equ readBlock+readBlockSize	Write file parameter block.closeBlock	equ writeBlock+writeBlockSize	Close file parameter block.markBlock	equ closeBlock+closeBlockSize	Set file position mark parameter block.EOFBlock	equ markBlock+markBlockSize	Set EOF parameter block.getLevelBlock	equ EOFBlock+EOFBlockSize	Get file level parameter block.setLevelBlock	equ getLevelBlock+getLevelBlockSize	Set file level parameter block.addQBlock	equ setLevelBlock+setLevelBlockSize	Add proc to OS event queue.delQBlock	equ addQBlock+addQBlockSize	Delete proc from OS	event queue.curApp	equ delQBlock+delQBlockSize	Offset to current application record.;dataInitSize	equ curApp+2		Number of bytes to initialize.;;; ------ Part of data area that is initialized to zero.;hashIDTable	equ dataInitSize		Hash table for UniqueResourceID.fileHeader	equ hashIDTable+hashSize	Resource file header space.sysFile	equ fileHeader+rFileMemo	Handle of system file map, NIL if none.sysConvertList	equ sysFile+4		Handle of system converter list.applist	equ sysConvertList+4	Application list, !!!must be last in list!!!dataSize	equ appList+(appRecSize*20)+2	Size of data area (must be even).;; --- Resource Manager error codes.;resForkUsed	equ 1+(ResToolNum<<8)	;Fork not empty.resBadFormat	equ 2+(ResToolNum<<8)	;Resource fork format is unknown.resNoConverter	equ 3+(ResToolNum<<8)	;No converter for resource.resNoCurFile	equ 4+(ResToolNum<<8)	;No current file.resDupID	equ 5+(ResToolNum<<8)	;ID already used.resNotFound	equ 6+(ResToolNum<<8)	;Resource was not found.resFileNotFound	equ 7+(ResToolNum<<8)	;Resource file was not found.resBadAppID	equ 8+(ResToolNum<<8)	;User ID not found in application list.resNoUniqueID	equ 9+(ResToolNum<<8)	;No unique ID found by UniqueResourceID.resIndexRange	equ 10+(ResToolNum<<8)	;Index out of range.resSysIsOpen	equ 11+(ResToolNum<<8)	;System file is already open.resHasChanged	equ 12+(ResToolNum<<8)	;Resource is marked as changed.resDiffConverter	equ 13+(ResToolNum<<8)	;Different converter logged in for that type.resDiskFull	equ 14+(ResToolNum<<8)	;Disk is too full to complete operation.resInvalidShutDown	equ 15+(ResToolNum<<8)	;Invalid to shut down $401E application (DAL 26-Feb-91)resNameNotFound	equ 16+(ResToolNum<<8)	;No resource found with specified name (DAL 10-Mar-91)resBadNameVers	equ 17+(ResToolNum<<8)	;Unknown format for rResName resourceresDupStartUp	equ 18+(ResToolNum<<8)	;Duplicate ResourceStartUp call with same IDresInvalidTypeOrID	equ 19+(ResToolNum<<8)	;type=0 is illegal, ID=0 is illegal	EJECT;================================================================================================;=;= Description: Install Resource Manager as a permanent tool.;=;= Inputs: None.;=;= Outputs: None.;=;= Errors: None.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;ReInstall;	lda #0		No data area flag.	tay	jsr startCall		Allocate direct page, set <data.;;; --- Allocate a data area.;;; Entry point added	here to cause the toolset to re-install	itself on OSRestart; This should save me a load of code...;	lda #dataSize		Number of bytes to allocate.	jsr allocateHandNoS1	Allocate memory, anywhere.	bcc @ok		Unable to allocate memory?	brl pop0_Err		Strip input, return	error to caller.;@ok	sta <dataHand		Store handle to data area.	stx <dataHand+2;	jsr lockDataHand1		<data = (<dataHand)	locked, <saveDataAttr = saved attr.;;; --- Initialize data area.;	ldy #dataSize-2		Offset to last word	in appList.	lda #$FFFF		Set last spot in appList to 'end of array'.	sta [<data],y;	inc a		A = 0.	dey		Clear remainder of data area.	dey@lop1	sta [<data],y	dey	dey	bpl @lop1;	ldy #dataInitSize-2		Initialize static area.@lop2	tyx	lda staticData,x	sta [<data],y	dey	dey	bpl @lop2;; --- Install Resource Manager as a permanent tool.;	pea 0		System tool.	pea ResToolNum		Resource Manager tool number.	pea ResToolTable>>16	Pass pointer to tool function table.	pea ResToolTable	_SetTSPtr		Install Resource Manager with Tool Locator.;	_SetDefaultTPT		Make Resource Manager a permanent tool.;;; --- Set work area	pointer.;	pea 0		Pass 'system tool' flag.	pea ResToolNum		Pass Resource Manager's tool number.	pei <dataHand+2		Pass handle of data	area.	pei <dataHand	_SetWAP		;Set Resource Manager's work area pointer.;;	jsr pushAddQBlock		Install OS event handler.	pea AddOSQueue	jsl GS_OS;;; --- Open the system resource file.;***	jsr openSystemFile		;try moving below (11-Feb-91 DAL);; --- Log in Resource Manager as an application.;*** @skip1 (label was unused, 11-Feb-91 DAL)	pea $401E		Pass Resource Manager's user ID.	_ResourceStartup*** added 11-Feb-91 DAL -- this should allow Sys.Resources stuff to preload correctly	jsr openSystemFile	pea 1	_SetCurResourceFile*** end of 11-Feb-91 DAL;;; --- Exit.;	brl pop0_NoErr		Fix stack, return no error, exit tool.;;;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\; GS/OS event handler routine.;\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\;toP8	equ $0002toGSOS	equ $0004osShutdown	equ $0020;; !!!! This handler	makes the Resource Manager not ROMABLE (thanks for the design) !!!!!;OSEvent	dc.l 0		Link to next handler.	dc.w 0		Reserved.	dc.w $A55A		Signature.	dc.l toP8+toGSOS+osShutdown	Take switch to P8, GS/OS and shutdown.@osEventIn	dc.l 0		Spot OS event is stored.;;	jsl @fakeToolCall		Make event call look like tool call.	rtl;@fakeToolCall;@cont01	pha		Space for result	pha	pea 0		System tool.	pea ResToolNum		Pass Resource Manager's tool number.	_GetWAP	pla		Pass handle of data area.	ply@Cont05	jsr startCall;;; --- Switching to P8 or shutdown.;	lda |@osEventIn***	and #toP8+osShutdown	and #toP8	;8-Mar-91 DAL: don't shut down on OSShutDown, only on P8 switch!	beq @next1;; ------ Close system file.;	ldy #sysFile+1		Is there a system file?	lda [<data],y	beq @skip1		If not, already closed.;	pea sysFileID		Pass ID of system file.	_CloseResourceFile;;; -- Now that the system resource file is closed, we will shut down the resource manager; so that its application entry is properly removed from the list;; --- Get rid of the system converter list.  Nobody should be logged in there and; --- the handle position is causing some low memory problems. 6/7/89.;@skip1	ldy #sysConvertList+1	Is there a converter list?	lda [<data],y	beq @skip2;	iny	lda [<data],y	pha	dey	dey	lda [<data],y	pha	_DisposeHandle;	ldy #sysConvertList+1	No more handle.	lda #0	sta [<data],y;;; --- Shutdown.;@skip2	lda |@osEventIn	and #osShutdown	beq @exit;	lda #0		Common need.	pha		Pass 'system tool' flag.	pea ResToolNum		Pass Resource Manager's tool number.	pha		Pass NIL data area.	pha	_SetWAP;	pei <dataHand+2		Free data area.	pei <dataHand	_DisposeHandle;	stz <dataHand+1		No more data area.	bra @exit;;; --- Switching back to GS/OS.;@next1	lda |@osEventIn	and #toGSOS	beq @exit;; 1/25/90 Mensch;; Fixed a bug that was causing the system resource file to not show up as part of the ; resource managers	open file list after a restart. The fix	works by resetting the curApp; to the resource manager (first entry in the app list) and	then setting that entries appFlag; to be zero, thus unlogging the resource manager. This will allow us to call resourceStartup; again and re-log the resource manager. (which also fixes its file list);	ldy #curApp		Resource Manager always has first record.	lda #appList		so set the curApp to point to it	sta [<data],y	tay		next zero out the "ID" field of the first app	lda #0		so that ResourceStartup will work	sta [<data],y***	jsr openSystemFile		Try to open system resource file.	pea $401E	_ResourceStartup		and re-login the resource manager into the list*** added 11-Feb-91 DAL	jsr openSystemFile	pea 1	_SetCurResourceFile*** end of 11-Feb-91 addition@exit	brl pop0_NoErr;---------------------------------; Open system file.;---------------------------------openSystemFile*** old ;*** old ; ----- The	getting and setting	of levels is only documented enough to say to do this, way we*** old ; ----- do this no one knows.  Myself, I'm not fond of this type of procedure.  It does have*** old ; ----- something to do with opening a system file.*** old ;*** old ;*** old   jsr pushGetLevelBlock*** old   pea GetLevel*** old   jsl GS_OS*** old ;*** old   lda #0*** old   ldy #setLevelBlock+setLevelCurrent*** old   sta [<data],y*** old   jsr pushSetLevelBlock*** old   pea SetLevel*** old   jsl GS_OS*** old ;*** old ; -------------------------------------- End of unknown crap (for now).*** old ;	pha		Space for result.	pea 1		Pass read only access.	lda #0		Pass NIL for address of map in memory.	pha	pha	pha		Pass NIL pointer to pathname.	pha	_OpenResourceFile	pla	bcc @skip1		File opened?;	ldy #sysFile+2		Zero system map handle area if not opened.	lda #0	sta [<data],y	dey	dey	sta [<data],y@skip1;;  [<data],sysFile = handle of system file map, NIL if none.;  ID of system file is 1.;;*** DAL 20-Dec-90: We're doing the Level stuff for *all* files now.*** old ; ----- Now	putting undocumented stuff back.  Don't worry why, just do it documentation.*** old ;*** old   ldy #getLevelBlock+getLevelCurrent*** old   lda [<data],y*** old   ldy #setLevelBlock+setLevelCurrent*** old   sta [<data],y*** old   jsr pushSetLevelBlock*** old   pea SetLevel*** old   jsl GS_OS	rts;;	EJECT;================================================================================================;=;= Description: Resource Manager Tool Pointer Table;=;= Inputs: None.;=;= Outputs: None.;=;= Errors: None.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;ResToolTable	dc.l (@endTable-ResToolTable)/4	dc.l BootInit-1		$01xx	dc.l ResourceStartup-1	$02xx	dc.l ResourceShutdown-1	$03xx	dc.l ResourceVersion-1	$04xx	dc.l ResourceReset-1	$05xx	dc.l ResourceStatus-1	$06xx	dc.l Reserved-1		$07xx	dc.l Reserved-1		$08xx	dc.l CreateResourceFile-1	$09xx	dc.l OpenResourceFile-1	$0Axx	dc.l CloseResourceFile-1	$0Bxx	dc.l AddResource-1		$0Cxx	dc.l UpdateResourceFile-1	$0Dxx	dc.l LoadResource-1		$0Exx	dc.l RemoveResource-1	$0Fxx	dc.l MarkResourceChange-1	$10xx	dc.l SetCurResourceFile-1	$11xx	dc.l GetCurResourceFile-1	$12xx	dc.l SetCurResourceApp-1	$13xx	dc.l GetCurResourceApp-1	$14xx	dc.l HomeResourceFile-1	$15xx	dc.l WriteResource-1	$16xx	dc.l ReleaseResource-1	$17xx	dc.l DetachResource-1	$18xx	dc.l UniqueResourceID-1	$19xx	dc.l SetResourceID-1	$1Axx	dc.l GetResourceAttr-1	$1Bxx	dc.l SetResourceAttr-1	$1Cxx	dc.l GetResourceSize-1	$1Dxx	dc.l MatchResourceHandle-1	$1Exx	dc.l GetOpenFileRefNum-1	$1Fxx	dc.l CountTypes-1		$20xx	dc.l GetIndType-1		$21xx	dc.l CountResources-1	$22xx	dc.l GetIndResource-1	$23xx	dc.l SetResourceLoad-1	$24xx	dc.l SetResourceFileDepth-1	$25xx	dc.l GetMapHandle-1		$26xx	dc.l LoadAbsResource-1	$27xx	dc.l ResourceConverter-1	$28xx*** 6.0	dc.l LoadResource2-1	$29xx 19-Jan-91 DAL	dc.l RMFindNamedResource-1	$2Axx 10-Mar-91 DAL	dc.l RMGetResourceName-1	$2Bxx 10-Mar-91 DAL	dc.l RMLoadNamedResource-1	$2Cxx 10-Mar-91 DAL	dc.l RMSetResourceName-1	$2Dxx 10-Mar-91 DAL*** 6.0.1	dc.l OpenResourceFileByID-1	$2Exx 14-Jul-92 DAL		IF  JimsExperiment		THEN	dc.l CompactResourceFile-1	$2Fxx 11-Jan-93 JCM	ENDIF		IF  deBug		THEN	dc.l ResourceShowGSOS-1	$30xx 	ENDIF;@endTable;;	EJECT;================================================================================================;=;= Description: Register application with Resource Manager.;=;= Inputs: PUSH:WORD - Application's user ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=  memErr Out of memory.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;ResourceStartup@userID	equ inputs		Input parameter.*** 13-May-91 DAL -- return resDupStartUp if this ID has already started us	pha	phy	;save YA for startCall	pha	;space for old resource app	_GetCurResourceApp	lda 7+6,s	pha	_SetCurResourceApp	bcs @notDuplicate* oops, it's already started up!	_SetCurResourceApp	;restore old resource app	ply	pla	;balance the stack	ldx #resDupStartUp	ldy #2	;strip 2 bytes	jml $e10184	;ToStrip	@notDuplicate	ply	;discard old (still current) res app	ply	;restore YA for startCall	pla*** end of 13-May-91 DAL	jsr startCall		Allocate direct page, set <data.;; --- Find an available spot in the application list.;	ldy #appList		Start with first.@lop1	lda [<data],y		Check appFlag field.	bmi @expandList		End of list?	beq @gotit		Available?	tya	clc	adc #appRecSize		Compute index to next application record.	tay	bra @lop1;;; ------ Application list is full, expand it.;@expandList	ldy #handAttr		Unlock data area for resize.	lda [<dataHand],y	and #$7FFF	sta [<dataHand],y;	pha		Space for result.	pha	pei <dataHand+2		Pass handle to data	area.	pei <dataHand	_GetHandleSize	pla		Save current size.	sta <work;     Size never greater than 64k.;	clc	adc #appRecSize*10		Enough room for 10 more apps.	pha	pei <dataHand+2		Pass handle to data	area.	pei <dataHand	_SetHandleSize	bcc @ok1	tay		Pass error code in Y.	brl pop2_Err		Return to caller.;@ok1	jsr lockDataHand		Relock data handle and dereference.;	ldy <work		Initialize new part	of appList.	ldx #((appRecSize*10)/2)-1	Number of words to write.	lda #0		New records are available.@lop3	sta [<data],y	iny	iny	dex	bne @lop3	dec a		Mark last word as end of list.	sta [<data],y;	ldy <work		First new spot is available.	dey		Back over old end mark.	dey;;; --- Spot in application list found, initialize it.;; y = index to application record in application list.;@gotit	sty <work		Save index to application record.;	lda #1		Mark spot as used in appFlag field.	sta [<data],y;	iny		Store user ID in record in appID field.	iny	lda <@userID	sta [<data],y;	iny	iny	jsr moveSysFile		Move sysFile into appFiles field.;	iny	iny	iny	iny	jsr moveSysFile		Move sysFile into appCur field.;	iny	iny	iny	iny	lda #0		Mark no converter routines.	sta [<data],y	iny	iny	sta [<data],y;;;; --- Application is made the current application.;	ldy #curApp		Store the offset to	the current app record	lda <work		in the app list.	sta [<data],y;	lda #1		Set read flags to on.	jsr setReadFlag;	lda #$FFFF		Set file depth to all.	jsr setFileDepth;	brl pop2_NoErr		Fix stack, return no error, exit tool.;;	EJECT;================================================================================================;=;= Description: Remove current application from application	list.;=;= Inputs: None.;=;= Outputs: None.;=;= Errors: None.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================; ResourceShutdown*** added 26-Feb-91 DAL: return an error if they try to shut down $401E	phy	pha	pea 0	_GetCurResourceApp	pla	cmp #$401E	bne @noProblem	plx	plx	;throw away saved AY value	lda #resInvalidShutDown	sec	rtl@noProblem	pla	ply*** end of 26-Feb-91 DAL	jsr startCall		Allocate direct page, set <data.;;; --- Kill all maps	from current application.;	pea 0		Close all resource files the application opened.	_CloseResourceFile;;; --- Free all system resources loaded by app.;	ldy #curApp		Get user ID of app shutting down.	lda [<data],y	clc	adc #appID	tay	lda [<data],y	sta <work;	ldy #sysFile+2		Get handle of system file map.	lda [<data],y	tax	dey	dey	lda [<data],y	jsr newMap		Lock and dereference map	bcs @skip1		No system file?;	lda #freeAppRes		Pass routine to call.	jsr walkResources	jsr unlockMap		Leave system map unlocked.;;; --- Remove application from application list.;@skip1	ldy #curApp		Get offset to current application record.	lda [<data],y	tay	lda #0		Make this app record available.	sta [<data],y;;; --- Free application's resource converter list.;	tya		Check if application has a converter list.	clc	adc #appConverters+1	tay	lda [<data],y	beq @done1;	iny		Free converter list.	lda [<data],y	pha	dey	dey	lda [<data],y	pha	_DisposeHandle@done1;;; --- Make the Resource Manager the current application.;	ldy #curApp		Resource Manager always has first record.	lda #appList	sta [<data],y;	brl pop0_NoErr		Fix stack, return no error, exit tool.;;	EJECT 30;================================================================================================; Free allocated resource.;================================================================================================;;   IN: <resPtr = pointer to resource reference in index.; <work = user ID of App.;;  OUT: If resHandle field is TRUE and owned by App then handle freed, resHandle field set to NIL.;freeAppRes;@owner	equ work@resHand	equ @owner+2@resPtr	equ @resHand+4;	ldy #resHandle+1		Is resource allocated?	lda [<resPtr],y	beq @exit;	sta <@resHand+1		Get handle of resource.	dey	lda [<resPtr],y	sta <@resHand;	ldy #handOwner		Is this resource owned by the App?	lda [<@resHand],y	cmp <@owner	bne @exit;	brl freeRes		Free the App's resource.;@exit	clc		;Continue flag to walkResources.	rts;;	EJECT 30;================================================================================================;=;= Description: Return Resource Manager	external version number.  See ResourceStatus for ;=  internal version number.;=;= Inputs: PUSH:WORD - space for result.;=;= Outputs: WORD on	stack - external version number of Resource Manager.;=;= Errors: None.  Carry clear, a = zero.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;ResourceVersion;@result	equ inputs		Index to input parameter.;;	jsr startCall		Allocate direct page, set <data.;	lda #Version		Return external version number of Resource Manager.	sta <@result		Return result to caller.;	brl pop0_NoErr		Fix stack, return no error, exit tool.;	EJECT 25;================================================================================================;=;= Description: Resource Manager Reset Call and undefined calls.;=;= Inputs: None.;=;= Outputs: None.;=;= Errors: None.  Carry clear, a = zero.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================; BootInitResourceResetReserved	lda #0		;No error code.	clc		;No error flag.	rtl		;Exit tool.;	EJECT 35;================================================================================================;=;= Description: Return Resource Manager's status, TRUE if InitResources called.  A TRUE status ;=  is an internal version number that is incremented each release.;=;= Inputs: PUSH:WORD - space for result.;=  y/a = work area	pointer, NIL if InitResources has not been called.;=;= Outputs: WORD on	stack - TRUE if Resource Manager is active, FALSE if not.;=;= Errors: None. Carry clear, a = zero.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================; ResourceStatus;@ret1	equ 1@ret2	equ @ret1+3@result	equ @ret2+3;	lda #5		If call could be made, I'm active.	sta @result,s		Return result to caller.;	lda #0		Return NIL error code.	clc		Return no error flag.	rtl;	EJECT;================================================================================================;=;= Description: Create a resource fork in a file.;=;=   If the file doesn't exist:;=    File is created with an empty data fork.;=    Resource fork	is initialized with	no resources.;=   If the file exist and has an empty	resource fork:;=    Resource fork	is initialized with	no resources.;=   If the file exist and has data in its resource fork:;=    Returns resForkUsed error.;=;= Inputs: PUSH:LONG - (applied only if	file doesn't exist) aux type to use to create the file.;=  PUSH:WORD - (applied only if file doesn't exist) filetype to use to create the file.;=  PUSH:WORD - (applied only if file doesn't exist) access the new file should have:;=     bit 7 = 1 to	enable file deletion.;=     bit 6 = 1 to	enable file renaming.;=     bit 5 = 1 to	mark as needing backup.;=     bit 2 = 1 to	mark file as invisible.;=     All other bits must be 0, the file will always;=     be read/write enabled.;=  PUSH:LONG - Pointer to GS/OS class 1 input file pathname.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   GS/OS file errors.;=   resForkUsed - resource fork already used.;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================; CreateResourceFile;@pathname	equ inputs@fileAccess	equ @pathname+4@fileType	equ @fileAccess+2@auxType	equ @fileType+2;;	jsr startCall		Allocate direct page, set <data.;;; --- Initialize create file parameters.;	lda <@fileAccess		Make sure file is read/write enabled.	ora #3	sta <@fileAccess;	ldx #(creAuxType+2)-crePathname	ldy #createBlock+creAuxType+2@lop1	lda <@pathname,x	sta [<data],y	dey	dey	dex	dex	bpl @lop1;	ldy #openBlock+openRequestAcc	Open file with its given access.	lda #0	sta [<data],y;;; --- Try to open the file's resource fork.;@openLoop	jsr openResFork		<inputs = pathname pointer.	bcc @alreadyExist	cpy #GSOS_FileNotFound	Does the file exist?	beq @createIt	cpy #GSOS_resNotFound	bne @errorExit		If it does, some other error. y = GS/OS	error.;;; ------ Add a resource fork to an existing file.;	stz <@fileAccess		;4-Apr-91 DAL	stz <@fileType		;4-Apr-91 DAL	stz <@auxType		;4-Apr-91 DAL	stz <@auxType+2		;4-Apr-91 DAL	ldy #createBlock+creStorageType	lda #$8005	sta [<data],y		Set flag to add resource fork.;	jsr pushCreateBlock		Pass pointer to create file parameter block.	pea CREATE		Pass call number.	jsl GS_OS		Create a file.	tay		Return possible GS/OS error in Y.@toErrorExit	bcs @errorExit	bra @openLoop		Try to open the file again, should work.;;; ------ Create the	file because it doesn't exist.;@createIt	ldy #createBlock+creStorageType	lda #$0005	sta [<data],y		Set flag to create file with resource fork.;	jsr pushCreateBlock		Pass pointer to create file parameter block.	pea CREATE		Pass call number.	jsl GS_OS		Create a file.	tay		Return possible GS/OS error in Y.	bcs @errorExit	bra @openLoop		Try to open the file again, should work.;;; --- The open resource fork must be empty to be initiailized.;@alreadyExist	ldy #openBlock+openResEOF	Is the resource fork empty?	lda [<data],y	iny	iny	ora [<data],y	beq @initFork		If empty, initialize it.;	lda #resForkUsed		Return error, fork is used.	bra @errorOut;;; --- Initialize the resource to having	no resources.;@initFork	pea templateSize>>16	Pass size to write.	pea templateSize	pea @resFileTemplate>>16	Pass pointer to data to write.	pea @resFileTemplate	ldy #openBlock+openRefNum	Pass open file reference number to write.	lda [<data],y	jsr fileWrite1		Write template to file.;;; --- Close the file.;@errorOut	pha		Save possible error code.	ldy #openBlock+openRefNum	Pass open file reference number to close.	lda [<data],y	jsr closeResFork	plx		Get possible error.	tay		Return possible close error in Y.	bcs @errorExit	txy		Return possible write error in Y.;@errorExit	brl pop12_Err		Fix stack, return any error, exit tool.;	EJECT 60;; --- Resource file	template with no resources.;@resFileTemplate	dc.l FileFormatVersion	rFileVer - file format version.	dc.l @map-@resFileTemplate	rFileToMap - offset	to map.	dc.l @endMap-@map		rFileMapSize - size	of map.	dcb.b 128,0		rFileMemo - app reserved.;@map	dc.l 0		mapNext - space for	next handle.;;;	dc.w 0		mapFlag - 0=app, 1=system. - never supported/removed 12-Jan-93 JCM	dc.w 0		mapFlag - in-memory flags	dc.l @map-@resFileTemplate	mapOffset - map's file position.	dc.l @endMap-@map		mapSize - size of map in file.	dc.w @index-@map		mapToIndex - offset	to index.	dc.w 0		mapFileNum - space for open ref num.	dc.w 0		mapID	dc.l 10		mapIndexSize - number of index spots.	dc.l 0		mapIndexUsed - number of resources.	dc.w 10		mapFreeListSize - total records.	dc.w 1		mapFreeListUsed - used records.;      mapFreeList:; List of free blocks:;	dc.l templateSize		blkOffset - offset to block.	dc.l $FFFFFFFF-(templateSize)	blkSize - size of block.;	dcb.b 9*blkRecSize,0	9 unused blocks.	dc.l 0		End of blocks.;; Resource Index:;@index	dcb.b 10*resRecSize,0	10 unused index references.	dc.w 0		End of references mark.@endMaptemplateSize	equ @endMap-@resFileTemplate	Size of empty resource file.;	EJECT;================================================================================================;=;= Description: Open a resource fork in	a file.;=;= Inputs: PUSH:WORD - space for result.;=  PUSH:WORD - requested file access (bits 0-1 to GS/OS Open, bit 15 = don't preload);=  PUSH:LONG - address of map in memory, NIL if map on disk.;=               (ACTUALLY, it's the address of a resource fork image in memory.  6-Nov-91 DAL);=  PUSH:LONG - Pointer to GS/OS class 1 input file pathname, NIL for system file.;=;= Outputs: WORD on	stack - open file reference number.;=;= Errors: Carry set if error, a = error code:;=   GS/OS file errors.;=   Memory Manager	errors.;=   resBadFormat -	resource fork format is unknown.;=   resNoUniqueID - too many open resource files ($0FFF limit).;=   resSysIsOpen -	system file is already open.;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;OpenResourceFile;@pathname	equ inputs		Stack offsets.@address	equ @pathname+4@accessRequest	equ @address+4@result	equ @accessRequest+2;@hash	equ work		Local direct page use.@passSizeToRead	equ @hash+4@openNum	equ @passSizeToRead+4@fileHeader	equ @openNum+2@temp	equ @fileHeader+rFileMemo@localSize	equ @temp+4	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;	jsr startCall		Allocate direct page, set <data.;;; --- Set open access request.;	ldy #openBlock+openRequestAcc	Open file as requested.	lda <@accessRequest	and #3		;only bits 0-1 are passed to GS/OS (25-Mar-91 DAL)	sta [<data],y;;; --- Check if opening system file.;	lda <@pathname		Load system file?	ora <@pathname+2	bne @ok8;	ldy #sysFile+1		There can't already be a system file.	lda [<data],y	beq @ok10	ldy #resSysIsOpen		Return error that sys file already open.	brl pop10_Err		Strip input parameters and exit.;@ok10	iny		Set flag to show system file being opened.	dec a	sta [<data],y;	lda #@sysFilename		Set pointer to system file pathname.	sta <@pathname	lda #@sysFilename>>16	sta <@pathname+2;	lda #sysFileID		Use absolute system	file ID.	bra @store1;;; --- Opening non-system resource file.;; --- Find ID for map.;@ok8	lda #hashIDTable		Push address of hash table.	jsr pushDataArea	pla		Keep handy pointer to hash table.	sta <@hash	pla	sta <@hash+2;	ldy #hashSize-2		Clear hash table.	lda #0@lop1	sta [<@hash],y	dey	dey	bpl @lop1;;	lda #@findMapID		Pass routine to call.	jsr walkAllFiles;;	ldy #hashSize-2		Find any ID not used.@lop2	lda [<@hash],y	cmp #$FFFF	bne @ok3	inc a		Clear table while I'm here.	sta [<@hash],y	dey	dey	bpl @lop2;	ldy #resNoUniqueID		Return error code, all file IDs are used.@errorExit3	brl pop10_Err		Strip input parameters and exit.;;@ok3	pha		Save hashed word.;	tya		Convert index into bits 7-11.	asl a	asl a	asl a	sta <@result;	ldx #15		;Bit counter.	pla		;Get hashed word.	xba		;Convert two hashed bytes into a word.@lop4	lsr a		;Look for zero bit.	bcc @ok5	dex	bra @lop4		Has to be a zero bit!;@ok5	txa		Convert bit index into bits 0-3 of ID.	ora <@result		and bits 7-11 to get bits 0-15.	bne @store1	inc a		NIL is not valid.@store1	sta <@result;;; --- Load map from	memory.;	lda <@address		Is the map in memory?	ora <@address+2	beq @ok7;	lda [<@address]		Correct format version number?	cmp #FileFormatVersion	bne @formatError	ldy #rFileVer+2	lda [<@address],y	bne @formatError;	ldy #rFileMapSize+2		Pass number of bytes to allocate	lda [<@address],y	tax	dey	dey	lda [<@address],y	jsr allocateHand2		Allocate memory for	map.	bcc @ok6		Error allocating memory?	brl pop10_Err@ok6	jsr newMap		Lock and dereference <mapHand.  <mapPtr	= pointer.;	lda <@address		Pass source pointer.	ldy #rFileToMap	clc	adc [<@address],y	tax	lda <@address+2	iny	iny	adc [<@address],y	pha	phx	pei <mapPtr+2		Pass destination pointer.	pei <mapPtr	ldy #rFileMapSize+2		Pass number of bytes to move.	lda [<@address],y	pha	dey	dey	lda [<@address],y	pha	_MyBlockMove;	stz <@openNum		No open file reference number.	brl @linkMap;;; --- Try to open the file's resource fork.;@ok7	jsr openResFork		<inputs = pathname pointer.	sta <@openNum		Return file ID.	bcc @ok1		Fork opened OK?	tay		Error code in Y.	brl @errorExit		Return error.;;; --- Read file's header.;@ok1	ldy #readBlock+readRefNum	Pass open file reference number to read.	sta [<data],y;	lda #rFileMemo		Pass number of bytes to read.	sta <@passSizeToRead	(Up to rFileMemo).	stz <@passSizeToRead+2;	lda #@fileHeader		Pass direct page offset.	jsr pushDpage		Compute address of fileHeader space.	pla		Pass address of read buffer.	plx	jsr fileRead1		Read file header.	bcs @errorExit1		Error reading?;;; --- Verify resource fork format.;	lda <@fileHeader+rFileVer	Correct format version number?	cmp #FileFormatVersion	bne @formatError	lda <@fileHeader+rFileVer+2	beq @ok2;@formatError	lda #resBadFormat		Return error code.	bra @errorExit1;;; --- Allocate memory for map.;@ok2	lda <@fileHeader+FILEMAPSIZE	!!! Pass number if bytes to allocate.	ldx <@fileHeader+FILEMAPSIZE+2	!!!	jsr allocateHand2	bcc @ok4		Error allocating memory?	tya	bra @errorExit1@ok4	jsr newMap		Lock and dereference <mapHand.  <mapPtr	= pointer.;;; --- Read map into	memory.;	lda <@fileHeader+rFileToMap	Pass file position.	ldx <@fileHeader+rFileToMap+2	ldy <@openNum		Pass open file reference number.	jsr setFileMark1		Set file mark to start of map.	bcs @errorExit2		GS/OS error?;	lda <@fileHeader+FILEMAPSIZE	Pass number of bytes to read.	sta <work+4	lda <@fileHeader+FILEMAPSIZE+2	sta <work+6	lda <mapPtr		Pass pointer to read buffer.	ldx <mapPtr+2	jsr fileRead1		Read map.*** 12-Jan-93 JCM - Do an extra check to see if we actually read the entire map. This would only be***                 a problem if we were passed a file that's been damaged (the EOF is too small).;	bcc @linkMap		Error reading?	bcs @errorExit2	ldy #readBlock+readTransfer	;low word of transferCount	lda [<data],y	cmp <work+4		;low word of requestCount	bne @errorExit4		iny	iny	lda [<data],y	cmp <work+6	beq @linkMap@errorExit4	lda #eofEncountered		;fake an error, but that's what really happened*** end 12-Jan-93 JCM;;; ------ Error handler area, undo what's been done so far and exit.;@errorExit2	pha		Save error code.	jsr disposeMapHand		Free <mapHand.	pla		Restore error code.;@errorExit1	pha		Save error code.;	lda <@openNum		Close open resource	fork.	jsr closeResFork;	ply		Return error code.@errorExit	brl pop10_Err;;; --- Link map to application's files list.;@linkMap	ldy #sysFile+2		Opening system file?	lda [<data],y	bpl @ok9;*** 25-Jul-91 DAL -- zero out system file's mapNext field, in case it isn't NIL on disk!	lda #0	ldy #mapNext+2	sta [<mapPtr],y	sta [<mapPtr]		;mapNext is 0*** end 25-Jul-91 DAL	ldy #sysFile+2		;Store map's handle in global data area.	lda <mapHand+2	sta [<data],y	dey	dey	lda <mapHand	sta [<data],y;	lda #1		Add system file to end of every app's file list.	jsr sysFileChange	bra @skip1;;@ok9	jsr getFirstMap		x/a = handle first map, y = appFiles.	sta [<mapPtr]		Link first after new.;	lda <mapHand		Set new first map.	sta [<data],y	iny	iny	lda <mapHand+2	sta [<data],y;	ldy #mapNext+2		Finish linking first to new.	txa	sta [<mapPtr],y;;; --- Set current map to new map.;	jsr getCurMapHand		Compute index to current map.	lda <mapHand		Store new map as current.	sta [<data],y	iny	iny	lda <mapHand+2	sta [<data],y;;; --- Initialize map's state to just loaded condition.;@skip1*** added 7-Nov-91 DAL -- if caller passed a res file pointer, keep their map's mapFileNum	lda <@address+1	bne @keepRefnum*** end 7-Nov-91	lda <@openNum		Store open file open reference number in map.	ldy #mapFileNum	sta [<mapPtr],y@keepRefnum	lda <@result		Set ID.	ldy #mapID	sta [<mapPtr],y	jsr markCleanMap		Set mapChanged bit to 'not changed'.*** 12-Jan-93 JCM - This sets a newly defined bit in this file's header mapFlag which indicates***	the read/write status of the file. If the bit is set, then the file is open***	for reading and writing. If it is not set, then the file is read-only.	@setFileAccess	NAME		pha		;space for access to be returned	ldy #mapFileNum	lda [<mapPtr],y	pha		;the GS/OS refNum for this file	pea $0002		;pCount	tsc	inc a	pea 0	pha	pea $2039		;GetRefInfoGS	jsl $E100B0	pla		;pCount is now unneeded	pla		;refNum is also not needed now	pla		;access this file is open with	lsr a		;shift write access to bit 0	and #fileReadWrite		;this is the only bit we need or want	pha		;save the new bit for one sec'		ldy #mapFlag	lda [<mapPtr],y		;make sure the bit is clear before we ORA in our	and #_fileReadWrite		; access - it could be set on disk	ora 1,s		;moosh the write access into bit 0 "fileReadWrite"	sta [<mapPtr],y		;finally save it into the file's map	pla		;we don't need the access bit any more*** end 12-Jan-93 JCM;;; --- Load PreLoad resorces.;	jsr @preLoadResources;	jsr unlockMap		Leave new map unlocked.	brl pop10_NoErr		Fix stack, return no error, exit tool.;	STRING ASIS@sysFilename	dc.w 35	dc.b '*:System:System.Setup:Sys.Resources';;;-----------------------------------------------------; Preload resources	marked as such.;-----------------------------------------------------;@nextOffset	equ work		Local direct page use.@lastOffset	equ @nextOffset+4@resToLoad	equ @lastOffset+4@localSize110	equ @resToLoad+4	IF  (@localSize110>maxLocal) THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;@preLoadResources	stz <@lastOffset		Start with finding the first.	stz <@lastOffset+2;	lda #@firstPassLoad	bra @enter110@lop110	lda #@nextPassLoad@enter110	jsr @load110	bne @lop110	rts;;@load110	stz <@resToLoad+1;	ldx #$FFFF	stx <@nextOffset	stx <@nextOffset+2;	jsr walkResources	lda <@resToLoad+1	beq @exit110;	jsr lockMap		Lock and dereference <mapHand.	lda <@resToLoad	sta <resPtr	lda <@resToLoad+2	sta <resPtr+2;	pei <@nextOffset+2		Save.	pei <@nextOffset;	lda #$FFFF		Pass maximum size to load.	tax	jsr loadRes;	pla		Restore at place to start at next.	sta <@lastOffset	pla	sta <@lastOffset+2;	lda #1		Set not equal flag.@exit110	rts;;;///////////////////////////////////////////////////; Looking for next preLoad on disk.;///////////////////////////////////////////////////;@firstPassLoad	ldy #resAttr		Handle or absolute address in handle field?	lda [<resPtr],y	and #resAbsLoad	bne @nextPassLoad;*** added 7-Nov-91 DAL -- if caller passed in a res fork pointer, keep their map's resource handles!	lda <@address+1	bne @keepResHandle*** end 7-Nov-91	lda #0		Set 'resource not in memory' flag.	ldy #resHandle	sta [<resPtr],y	iny	iny	sta [<resPtr],y@keepResHandle;@nextPassLoad	ldy #resAttr	lda [<resPtr],y	and #resPreLoad	beq @exit100;*** added 27-Mar-91 DAL -- check the no-preload bit here, not outside, so we can still zero the handles	lda <@accessRequest	bmi @exit100*** end of 27-Mar-91 DAL;	ldy #resOffset+2	lda [<resPtr],y	tax	dey	dey	lda [<resPtr],y	cpx <@lastOffset+2	bcc @exit100		Already loaded?	bne @ok100	cmp <@lastOffset	bcc @exit100		Already loaded?	beq @exit100;@ok100	cpx <@nextOffset+2	bcc @ok101	bne @exit100	cmp <@nextOffset	bcc @ok101	bne @exit100;@ok101	sta <@nextOffset	stx <@nextOffset+2;	lda <resPtr	sta <@resToLoad	lda <resPtr+2	sta <@resToLoad+2;@exit100	clc		Continue.	rts;;;================================================================================================; Find new map ID.;================================================================================================;@findMapID	ldy #mapID		Get this map's ID.	lda [<mapPtr],y	lsr a		Compute index to byte in hash table.	lsr a	lsr a	pha	lda [<mapPtr],y		Compute bit index in byte.	and #$0007	tax	ply	sep #$20	LONGA OFF	lda [<@hash],y		Mark this ID as used.	ora hashMask,x	sta [<@hash],y	rep #$20	LONGA ON;@exit200	clc		Continue.	rts;;	EJECT;================================================================================================;=;= Description: Close a resource fork in a file.;=;= Inputs: PUSH:WORD - file ID, NIL to close all files; bit 15 = close even if there's an error;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   UpdateResourceFile errors.;=   GS/OS file errors.;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================; CloseResourceFile;@openFileID	equ inputs		Stack offsets.;@previousFile	equ work@fileID	equ @previousFile+4@temp	equ @fileID+2@forceFlag	equ @temp+4		;23-Apr-91 DAL@numClosed	equ @forceFlag+2		;10-Apr-92 DAL;	jsr startCall		;Allocate direct page, set <data.	stz <@numClosed		;10-Apr-92 DAL*** 23-Apr-91 DAL -- bit 15 of input file number means close file(s) forcibly	stz <@forceFlag	lda <@openFileID	asl a	ror <@forceFlag	lsr a	sta <@openFileID		;stripped off bit 15*** end 23-Apr-91 DAL;	stz <@previousFile+1	Start with no previous file.;	lda #@closeFile		Pass address of routine to call.	jsr walkAllFiles		Call killMap for each map.	bcs @exit2		Was there an error?	ldy #0		No error.*** Added 10-Apr-92 DAL -- If input nonzero & we closed no files, return an error	lda <@openFileID	beq @exit2		;CloseResourceFile(0) --> no error	lda <@numClosed	bne @exit2		;Closed something --> no error	ldy #resFileNotFound*** end 10-Apr-92 DAL@exit2	brl pop2_Err		Fix stack, return any error, exit tool.;;;--------------------------------------------------------------------------------------------; Kill application maps and resources in them.  Called from	walkMaps.;-100----------------------------------------------------------------------------------------;;   IN: <mapHand = handle of locked map.; <mapPtr = pointer	to map.; <@openFileID = ID	of file to close, NIL if all.; <@previousFile = handle of previous map.;; OUT: Carry clear to continue walking map list.; Carry set to stop	walking map list, y	= error code.;@closeFile	ldy #mapID	lda [<mapPtr],y	cmp <@openFileID	beq @store100;	ldx <@openFileID		;Closing all files?	bne @savePrev	cmp #sysFileID		;If closing all, don't close sys file.	bne @store100;@savePrev	lda <mapHand		;Save handle for next pass through.	sta <@previousFile	lda <mapHand+2	sta <@previousFile+2	brl @exit100;@store100	sta <@fileID		;ID of file to close.	inc <@numClosed		;10-Apr-92 DAL;; --- Call UpdateResourceFile for file.;	pei @fileID	_UpdateResourceFile	tay		;Place possible error code in Y.*** 23-Apr-91 DAL -- if forceFlag is set, ignore any error	bit @forceFlag	bpl @noForce	clc@noForce*** end of 23-Apr-91 DAL	bcs @exit101		Error?;	jsr lockMap;;; --- Free allocated resources in map.;	lda #freeRes		Pass routine to call for each resource.	jsr walkResources		Call routine for each resource.;;; --- Unlink map from file list.;	lda <@previousFile+1	Is there a previous	handle?	bne @ok1;	ldy #curApp		Offset to current app record,	lda [<data],y	clc		plus offset to appFiles field,	adc #appFiles		is offset to current file list.	jsr pushDataArea		Compute address of list head.	pla	sta <@temp	pla	sta <@temp+2	bra @enter1		Next file now the first file.;@ok1	ldy #2		Dereference previous map.	lda [<@previousFile],y	sta <@temp+2	lda [<@previousFile]	sta <@temp;@enter1	lda [<mapPtr]		Unlink.	sta [<@temp]	ldy #mapNext+2	lda [<mapPtr],y	sta [<@temp],y	sta <@temp		Save high word.;;; --- Change current map if needed.;	jsr getCurMapHand		x/a = handle current map, y = index current map.	cmp <mapHand		Is the current map being closed?	bne @skip1	cpx <mapHand+2	bne @skip1;	lda [<mapPtr]		Next map is now the	current map.	sta [<data],y	iny	iny	lda <@temp	sta [<data],y@skip1;;; --- Free map.;	ldy #mapFileNum		Save file's open reference number.	lda [<mapPtr],y	pha;	jsr disposeMapHand		Free <mapHand.;; --- Special case if closing system file.;	lda <@fileID		Closing system resource file?	cmp #sysFileID	bne @skip100;;; ------ Set global	handle of system file map to NIL.;	ldy #sysFile		Mark no system file.	lda #0	sta [<data],y	iny	iny	sta [<data],y;;; ------ Remove system file map handle from end of every application's file list.;	lda #0		Remove flag.	jsr sysFileChange@skip100;;; --- Close file.;	pla		Pass open file reference number.	jsr closeResFork		Close the resource fork.;@exit100	clc		Continue down maps.@exit101	rts;;;------------------------------------------------; System file opening or closing.;------------------------------------------------;;   IN: a = FALSE to remove, TRUE to add.;  <mapHand = handle of system file map.;sysFileChange;@flag	equ work@temp	equ @flag+2;;	pei <@temp+2		Save.	pei <@temp	pei <@flag;	sta <@flag;;	ldy #appList+appFlag	Start with first app record.	bra @enter100;@lop100	beq @next100		Available record?  Go to next record then.;	phy	tya;	ldy #2		Common need.;	ldx <data+2		Compute pointer to first map handle. 	clc	adc #appFiles	adc <data	bcc @lop101	inx@lop101	sta <@temp		Pointer to file's mapNext field.	stx <@temp+2;	lda [<@temp],y		Get handle of next map.	tax	lda [<@temp]	bne @ok101		Are there any more files?	cpx #0	beq @next103;@ok101	cmp <mapHand		Is the next file the system map?	bne @next101	cpx <mapHand+2	bne @next101;	lda <@flag		Unlink system file from app's file list.	bne @next102		Am I suppose to remove?	sta [<@temp]	sta [<@temp],y	bra @next102;@next101	sta <@temp		Handle of next file.	stx <@temp+2	lda [<@temp],y		Dereference next file.	tax	lda [<@temp]	bra @lop101;@next103	lda <@flag		Am I suppose to add?	beq @next102;	lda <mapHand		Link system file to	end of app's file list.	sta [<@temp]	lda <mapHand+2	sta [<@temp],y;@next102	ply;@next100	tya		Next app record.	clc	adc #appRecSize	tay@enter100	lda [<data],y		Get appFlag field.	bpl @lop100		End of list?;	pla		Restore.	sta <@flag	pla	sta <@temp	pla	sta <@temp+2	rts;;	EJECT;================================================================================================;=;= Description: Add	a resource to the current resource file.;=;= Inputs: PUSH:LONG - handle of resource in memory.;=  PUSH:WORD - resource attribute.;=  PUSH:WORD - resource type.;=  PUSH:LONG - resource ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   Memory Manager	error.;=   resNoCurFile -	no current resource	file.;=   resDupID - resource ID already used.;=   resDiskFull - Disk is too full to complete operation.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================; AddResource;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4@resAttrIn	equ @resTypeIn+2@resHandIn	equ @resAttrIn+2;;	jsr startCall		Allocate direct page, set <data.;*** added 13-May-91 DAL -- validate type and ID	lda <@resTypeIn	beq @bad	lda <@resIDIn	ora <@resIDIn+2	bne @good@bad	ldy #resInvalidTypeOrID	brl pop12_Err@good*** end of 13-May-91 DAL	jsr getCurMap		<mapHand, <mapPtr =	current map, locked.*** 13-Jan-93 JCM - Make sure that the file can be written to before continuing.;;;	bcc @ok1		Is there a current map?	bcc @ok0		;is there a current map?	@exitNoAdd	brl pop12_Err@ok0	jsr isFileWriteable		;can we eventually write to this file?	bcs @exitNoAdd		; apparently not (returns invalidAccess error)*** end 13-Jan-93 JCM@ok1	jsr setFileRefNum		Put file refNum in GS/OS parameter blocks.	jsr ckFreeRecords		Make sure there are	enough free records	for add.;;; --- Make sure there is at least one available index reference.;	ldy #mapIndexUsed		Subtrack number of used records,	jsr getMapLong		x/a = mapIndexUsed.	ldy #mapIndexSize		from total number of records.	jsr subMapLong2	txy		More than one available?	bne @ok3	tay	bne @ok3;;; ------ Add some reference records to the index.;	ldy #mapIndexSize	jsr getMapLong	jsr computeResOffset	Compute <resPtr.	tay		Pass insertion point in x/y.	lda #resRecSize*20		Pass number of bytes to grow.	jsr growMap		Resize map, insert zeros.	bcs @toExit;	ldy #mapIndexSize		Increment free list	size.	lda [<mapPtr],y	clc	adc #20		Number of records added.	sta [<mapPtr],y;@ok3;;; !*!*!*!*!*!*   --> Map will not have to grow for reminder	of call. <--   !*!*!*!*!*!*;;; --- Find resource	a proper spot in the index.;	ldx <@resIDIn+2		Pass new ID.	ldy <@resIDIn	lda <@resTypeIn		Pass new type.	jsr findResRec		Compute place resource goes (1 file searched).	ldy #resDupID		Error, ID already used, just in case.@toExit	bcs @exit		Duplicate ID?;;; --- Allocate file	block for resource.;; <resPtr = place to insert resource reference.;	ldy #handSize+2		Pass size of resource.	lda [<@resHandIn],y	tax	dey	dey	lda [<@resHandIn],y	sta <work		Save size.	stx <work+2	jsr getFileBlock		Allocate file space	for resource.  Marks map dirty.	phx		Save offset to allocated file block.	pha;;; --- Insert resource reference in proper spot in the index.;	jsr insertIndexRef;;; --- Fix reference	record.;	ldy #resAttr	lda [<resPtr],y	and #resAbsLoad	beq @skip1;	ldy #2		Dereference handle so pointer will be stored instead	lda [<@resHandIn],y		of handle.	tay	lda [<@resHandIn]	sta <@resHandIn	sty <@resHandIn+2;@skip1	lda <@resTypeIn		Store type.	sta [<resPtr];	ldy #resID		Store ID.	lda <@resIDIn	ldx <@resIDIn+2	jsr storeResPtrLong;	pla		Store file offset.	plx	jsr storeResPtrLong;	lda <@resAttrIn		Store attributes.	ora #resChanged		Mark resource as changed.	sta [<resPtr],y	iny	iny;	lda <work		Store size.	ldx <work+2	jsr storeResPtrLong;	lda <@resHandIn		Store resource handle.	ldx <@resHandIn+2	jsr storeResPtrLong;;; --- Fix index reference used records counter.;	lda #1		Number to add.	ldy #mapIndexUsed		Index of field to add to.	jsr addToMapLong1		Increment mapIndexUsed.;;; --- Write the resource if it pushed the EOF mark.;	ldy <writeEOFflag		Did the resource allocate space past EOF?	beq @exit;	pei <@resTypeIn		Pass new type.	pei <@resIDIn+2		Pass new ID.	pei <@resIDIn	_WriteResource	tay;; --- Exit.;@exit	phy	jsr unlockMap	ply@exit2	brl pop12_Err;	EJECT;================================================================================================;=;= Description: Write all changed resources to their file and write the map also;  if needed.;=;= Inputs: PUSH:WORD - file ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   GS/OS file errors.;=   resFileNotFound - invaild file ID.;=   resDiskFull - Disk is too full to complete operation.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================; UpdateResourceFile;@openFileID	equ inputs		Stack offsets.;	jsr startCall		Allocate direct page, set <data.;;; --- Get current map.;	lda <@openFileID		Pass file to find.	jsr findFileID		Find the map that matches the given file ID.	bcs @exit2		Not found?;;; --- Update each resource that needs to be.;	jsr lockMap	jsr setFileRefNum;@moreFreeRecords	jsr ckFreeRecords		Make sure their are	some available free	block records.	bcs @exit		Records not available?;	stz <work		Start with no error.	lda #writeRes		Pass routine to write resources.	jsr walkResources		Call routine for each resource.;	ldy <work		Error from write?	bmi @moreFreeRecords	Does the map need more free records?	bne @exit;;; --- Write map if needed.;	ldy #mapFlag		Has the map changed?	lda [<mapPtr],y	ldy #0		No error, just in case.	and #mapChanged	beq @exit;	jsr writeMap		Write map to disk.;@exit	phy	jsr unlockMap	ply@exit2	brl pop2_Err;	EJECT;================================================================================================;=;= Description: LoadResource2: Load resource into memory if it isn't already, and return;=              the previous attributes word of the handle ($ffff if there was no handle;=              before).  (New call, DAL 19-Jan-91.  Stole LoadResource and added to it.);=;= Inputs: PUSH:LONG - space for result.;=  PUSH:WORD - flags (currently all bits reserved);=  PUSH:LONG - pointer to output buffer;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: LONG - handle of resource in memory, NIL if not	found or loaded.;=          Buffer is filled in with a status word:;=	+000: $ffff = resource was not already loaded;=	      Other values = old handle attributes word;=;= Errors: Carry set if error, a = error code:;=   Memory Manager	errors Returned unchanged.;=   GS/OS errors   Returned unchanged.;=   resNotFound    The resource was not found.;=;================================================================================================LoadResource2@resIDIn	equ inputs		;Stack offsets.@resTypeIn	equ @resIDIn+4@resultBuffer	equ @resTypeIn+2		;pointer to result buffer@flagWord	equ @resultBuffer+4@result	equ @flagWord+2		;result handle;@sizeOfRes	equ work		;!!! @sizeOfRes must = work !!!@openRefNum	equ @sizeOfRes+4@localSize	equ @openRefNum+2		;Size of local direct page.	IF  (@localSize>maxLocal) THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF	jsr startCall		;Allocate direct page, set <data.	lda #$ffff	sta [<@resultBuffer]	;anticipate error (no-handle flag);; --- Find the resource.;	jsr findGivenRes1		;Find resource that was given.	bcs @ok1		;Was the resource found?	stz <@result		;Return NIL handle.	stz <@result+2	bra @exit		;Y = error code, resNotFound.@ok1;; See if the handle already exists.  If it does, return its attributes in the; result buffer and fix up its Locked status.;	ldy #resHandle+1	lda [<resPtr],y	beq @noHandle	iny		;y=#resHandle+2	phd	lda [<resPtr],y		;get high word of handle	pha	dey	dey	lda [<resPtr],y		;get low word of handle	pha	tsc	tcd	ldy #4		;get the handle's attributes field	lda [<1],y	ply	ply	pld	sta [<@resultBuffer]	;return attributes to caller	jsr FixLockedStatus		;added 21-Jan-91 DAL@noHandle;; --- Load the resource.;; <mapHand = handle	of map.; <resPtr = pointer	to resource.;	jsr lockMap		;Lock the map before <resPtr moves.	lda #$FFFF		;No maximum size.	tax	jsr loadRes		;Load the resource	sta <@result		;Return the handle of the resource.	stx <@result+2	phy		;Save error code, Memory and GS/OS errors.	jsr unlockMap		;Leave map unlocked.	ply		;Restore error code.@exit	brl pop12_Err		;Strip input parameters and exit, y = error code.******************************************************************* FixLockedStatus** Inputs: resPtr points to the map entry for this resource.** If the handle already exists, check the resource attributes.* If the locked attribute is set there, but the handle is* unlocked and has not been purged, we will be helpful and* re-lock the handle so it won't go away on somebody.*FixLockedStatus	ldy #resAttr	lda [<resPtr],y	bpl @dontWantToLock	;does the RESOURCE like to be locked?	ldy #resHandle+1	;check middle word	lda [<resPtr],y	beq @noHandle	phd	iny	lda [<resPtr],y	pha	dey	dey	lda [<resPtr],y	pha	tsc	tcd	ldy #1	;offset to middle word of the handle's address field	lda [1],y	;Was the handle purged?	beq @noChange	;Yes, don't mess with it.	ldy #4	lda [1],y	ora #$8000	;force the handle's Locked bit on	sta [1],y@noChange	pla	pla	pld@dontWantToLock@noHandle	rts;================================================================================================;=;= Description: Load resource into memory if it isn't already.;=;= Inputs: PUSH:LONG - space for result.;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: LONG - handle of resource in memory, NIL if not	found or loaded.;=;= Errors: Carry set if error, a = error code:;=   Memory Manager	errors Returned unchanged.;=   GS/OS errors  Returned unchanged.;=   resNotFound  The resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;LoadResource;@resIDIn	equ inputs		;Stack offsets.@resTypeIn	equ @resIDIn+4@result	equ @resTypeIn+2;@sizeOfRes	equ work		;!!! @sizeOfRes must = work !!!@openRefNum	equ @sizeOfRes+4@localSize	equ @openRefNum+2		;Size of local direct page.	IF  (@localSize>maxLocal) THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;	jsr startCall		;Allocate direct page, set <data.*** added 9-Dec-91 DAL -- see if the ROM 3 Ctl Mgr is calling us to load a Code resource	lda #-1	sta >oldSysPrefs	lda <inputs-2	cmp #$fd9d	bne @notCMkludge	lda <inputs-3	cmp #$9dcb+3	;$FD/9DCB is the LoadResource call we special case	bne @notCMKludge	pha	;space for old sys prefs word	pea 1	;pcount	tsc	inc a	pea 0	pha	pea $200F	;GetSysPrefsGS	jsl $e100b0	pla	pla	sta >oldSysPrefs	and #$1fff	ora #$c000	pha	;new sys prefs word	pea 1	;pcount	tsc	inc a	pea 0	pha	pea $200C	;SetSysPrefsGS	jsl $e100b0	pla	pla@notCMkludge*** end 9-Dec-91;;; --- Find the resource.;	jsr findGivenRes1		;Find resource that was given.	bcs @ok1		;Was the resource found?	stz <@result		;Return NIL handle.	stz <@result+2	bra @exit		;Y = error code, resNotFound.;@ok1	jsr FixLockedStatus		;added 21-Jan-91 DAL;; --- Load the resource.;; <mapHand = handle	of map.; <resPtr = pointer	to resource.;	jsr lockMap		;Lock the map before <resPtr moves.;	lda #$FFFF		;No maximum size.	tax	jsr loadRes		;Load the resource	sta <@result		;Return the handle of the resource.	stx <@result+2	phy		;Save error code, Memory and GS/OS errors.	jsr unlockMap		;Leave map unlocked.	ply		;Restore error code.@exit*** added 9-Dec-91 DAL -- restore sys prefs if we changed them	phy	lda >oldSysPrefs	inc a	beq @noRestore	dec a	pha	;previous sys prefs word	pea 1	;pcount	tsc	inc a	pea 0	pha	pea $200C	;SetSysPrefsGS	jsl $e100b0	pla	pla@noRestore	ply*** end 9-Dec-91	brl pop6_Err		;Strip input parameters and exit, y = error code.*** NOT ROMABLE! 9-Dec-91 DALoldSysPrefs	dc.w 0*** end 9-Dec-91 DAL;;	EJECT;================================================================================================;=;= Description: Delete a resource from its file and free memory allocated for the resource.;=;= Inputs: PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resNotFound  Resource was not found.;=   resDiskFull - Disk is too full to complete operation.;=   invalidAccess - file is not open with write access;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;RemoveResource;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4;@endFlag	equ work		Local direct page area.@nextRes	equ @endFlag+2@localSize	equ @nextRes+4		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;	jsr startCall		Allocate direct page, set <data.;;; --- Find resource.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Was the resource found.	brl pop6_Err		y = resNotFound.*** 27-Jan-93 JCM - Make sure that the file can be written to before continuing.@ok1	jsr isFileWriteable		;can we eventually write to this file?	bcc @ok1b		; yup	brl pop6_Err		;y = invalidAccess;;;@ok1	jsr setFileRefNum@ok1b	jsr setFileRefNum	*** End - 27-Jan-93 JCM;;;; --- Make sure there are 6 available spots in the free list.;	jsr ckFreeRecords		Make sure there are	enough free records	for add.	bcc @ok2		Error?	brl pop6_Err;@ok2	tya		Did map grow?	beq @ok3	jsr findGivenRes1		Find resource the given resource again.;;; --- Free space used by the resource.;@ok3	jsr lockMap		Lock the map the resource is in.	jsr freeRes		Free memory allocated to the resource.	jsr freeFileResource	Free the file block	used by resource. Marks map dirty.	jsr removeIndexRef		Remove the resource's index reference.;;; --- Fix index reference counters.;	lda #1		Pass number to subtract.	ldy #mapIndexUsed		Pass field to subtract.	jsr subToMapLong1		Decrement mapIndexUsed field (# of used	records).;;; --- Exit.;	jsr unlockMap		Leave map unlocked.	brl pop6_NoErr		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Mark a resource changed	or unchanged so that it will be written	to disk (or;=  not) the next time the file is updated.;=;= Inputs: PUSH:WORD - TRUE to mark resource as changed, FALSE to mark as unchanged.;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resNotFound  Resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;MarkResourceChange;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4@chgFlag	equ @resTypeIn+2;;	jsr startCall		Allocate direct page, set <data.;;; --- Find resource.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Was the resource found.*** 13-Jan-93 JCM - First make sure that we will be able to write to this file when it's closed.***	%%% When we get here, <mapPtr will be pointing to an unlocked map, but this***	_shouldn't_ be a problem.@exitBadMarkChange	brl pop8_Err		y = error code;; --- Set change state of resource.;@ok1	ldy #resAttr	lda [<resPtr],y	ldx <@chgFlag		Set or clear?	bne @setit		;set it as changed	and #_resChanged*** 25-Jan-93 JCM - Fixed so we only scream about illegalAccess if the resource is being marked changed, not***	unchanged. Pinhead (that's me :-).;;;	;;;	tax		;save the resAttr for this resource;;;;;;	jsr isFileWriteable		;can we eventually write to this file?;;;	bcs @exitBadMarkChange	; apparently not (returns invalidAccess error);;;;;;	txa		;resAttr from above	*** end 13-Jan-93 JCM	bra @store1;@setit	ora #resChanged	tax		;save the resAttr for this resource	jsr isFileWriteable		;can we eventually write to this file?	bcs @exitBadMarkChange	; apparently not (returns invalidAccess error)	txa		;resAttr from above	ldy #resAttr		;1-Feb-93 JCM - got munged on call to isFileWriteable	*** End - 25-Jan-93 JCM	@store1	sta [<resPtr],y;	brl pop8_NoErr		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Set	current resource file for current application.;=;= Inputs: PUSH:WORD - file ID, NIL for	none.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resFileNotFound  File not opened by Resource Manager.;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;SetCurResourceFile;@givenFile	equ inputs		Offset to input parameter.;;	jsr startCall		Allocate direct page, set <data.;;; --- Verify open file reference number	is valid.;	lda <@givenFile		Pass file to find.	jsr findFileID		Find the map that matches the given file ID.	bcs @errorOut		Not found? y = resFileNotFound.;;; --- Set application's current file.;; <mapHand = handle	of matched file (NOT LOCKED).;	jsr getCurMapHand		Compute index to current map.	lda <mapHand		Store new current file.	sta [<data],y		Get application's current file.	iny	iny	lda <mapHand+2	sta [<data],y;	ldy #0		No error.;@errorOut	brl pop2_Err		Strip input parameters and exit.;	EJECT 35;================================================================================================;=;= Description: Return current application's current resource file.;=;= Inputs: PUSH:WORD - Space for result.;=;= Outputs: WORD - Open file reference number current resource file, NIL=no current file.;=;= Errors: Carry set if error, a = error code:;=   resNoCurFile  No current resource file.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;GetCurResourceFile;@result	equ inputs		Offset to input parameter.;;	jsr startCall		Allocate direct page, set <data.;	stz <@result		Just in case there is no current file.;	jsr getCurMap		Get current map, lock and dereference it.	bcs @exit		Is there a current file?  y = resNoCurFile.;	ldy #mapID		Return open file reference number of current file.	lda [<mapPtr],y	sta <@result;	jsr unlockMap		Leave map unlocked.;	ldy #0		No error.;@exit	brl pop0_Err		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Set	the current application.;=;= Inputs: PUSH:WORD - User ID of application, NIL if none.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resBadAppID Application not found (ResourceStartup not	called).;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;SetCurResourceApp;@givenUserID	equ inputs		Offset to input parameter.;;	jsr startCall		Allocate direct page, set <data.;	lda <@givenUserID		No user ID passed?	beq @exit;;; --- Find user ID in the application list.;	ldy #appList		Start with first.@lop1	lda [<data],y		Check appFlag field.	beq @next1		Empty spot?	bmi @userIDNotFound		End of list?;	iny		Increment to appID field.	iny	lda [<data],y		Get this app's user ID.	dey		Put index back.	dey	cmp <@givenUserID		Is this the record?	beq @gotit;@next1	tya	clc	adc #appRecSize		Compute index to next application record.	tay	bra @lop1;@userIDNotFound	ldy #resBadAppID		Return error.	brl pop2_Err;;; --- Set current application to found application record.;; y = index to application record in application list.;@gotit	tya		Index to application record.	ldy #curApp		Store the offset to	the current app record	sta [<data],y		in the app list.;@exit	brl pop2_NoErr		Strip input parameters and exit.;	EJECT 35;================================================================================================;=;= Description: Return user ID of current application.;=;= Inputs: PUSH:WORD - Space for result.;=;= Outputs: WORD - User ID of current application, NIL if none;=;= Errors: Carry set if error, a = error code:;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;GetCurResourceApp;@result	equ inputs		Offset to input parameter.;;	jsr startCall		Allocate direct page, set <data.;	ldy #curApp		Get offset to current application record.	lda [<data],y	tay	iny		Increment to appID field.	iny	lda [<data],y		Get user ID of current application.	sta <@result;	brl pop0_NoErr		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Return open file reference number for a given resource.;=;= Inputs: PUSH:WORD - Space for result;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: WORD - file ID, NIL if not found.;=;= Errors: Carry set if error, a = error code:;=   resNotFound Resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;HomeResourceFile;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4@result	equ @resTypeIn+2;;	jsr startCall		Allocate direct page, set <data.;;; --- Find map resource is in.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Was the resource found.	stz <@result		Do not return a valid open file reference number. 	brl pop6_Err		y = resNotFound.;;; --- Return open file reference number	of file resource is	in.;@ok1	ldy #mapID	lda [<mapPtr],y	sta <@result;	brl pop6_NoErr		Strip input parameters and exit.;;	EJECT;================================================================================================;=;= Description: Writes a resource to its resource file if it is marked as changed.;=;= Inputs: PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   GS/0S errors Errors returned from GS/OS calls.;=   resNotFound  Resource was not found.;=   resDiskFull Unable to write because of full disk.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;WriteResource;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4;;	jsr startCall		Allocate direct page, set <data.;;; --- Find resource.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Was the resource found.@errorOut	brl pop6_Err		y = resNotFound.*** 27-Jan-93 JCM - Make sure that the file can be written to before continuing.@ok1	jsr isFileWriteable		;can we eventually write to this file?	bcc @ok1b		; yup	brl pop6_Err		;y = invalidAccess;;;@ok1	jsr setFileRefNum@ok1b	jsr setFileRefNum	*** End - 27-Jan-93 JCM;;; --- Write the resource to its file.;	jsr ckFreeRecords		Make sure their are	some available free	block records.	bcs @errorOut		Records not available?	tya		Was the map moved?	beq @ok2	jsr findGivenRes1		Find resource again.;@ok2	jsr lockMap		Lock map for write.	jsr writeRes		Write resource to its file if needed.	jsr unlockMap		Leave map unlocked.;	ldy <work		Get error code from	writeRes.	bpl @exit		Did writeRes ask for more free records?	ldy #0		No real error.@exit	brl pop6_Err		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Frees memory allocated for a resource.  Undoes LoadResource.;=;= Inputs: PUSH:WORD - Purge level, 0-3	or negative to dispose of handle.;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resHasChanged Resource is marked as changed but not updated.;=   resNotFound  Resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;ReleaseResource;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4@purgeLevel	equ @resTypeIn+2;;	jsr startCall		Allocate direct page, set <data.;;; --- Find resource.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Was the resource found.;     y = resNotFound.@errorOut	brl pop8_Err;;; --- Write the resource to its file.;@ok1	ldy #resAttr		Has the resource changed?	lda [<resPtr],y	ldy #resHasChanged		Error code, just in	case.	and #resChanged	bne @errorOut;;; --- Dispose of or	set purge level of resource handle.;	ldy #resAttr		Is this an absolute	load resource, can't have handle?	lda [<resPtr],y	and #resAbsLoad	bne @exit;	ldy #resHandle+1		Does the resource have a handle?	lda [<resPtr],y	beq @exit	lda <@purgeLevel		Did caller want the	resource handle disposed.	bmi @dispose;	and #$0003		Memory Manager doesn't like unused bits as 1.	pha		Pass purge level.	iny		Pass resource's handle.	lda [<resPtr],y	pha	dey	dey	lda [<resPtr],y	pha	_SetPurge	bra @exit;@dispose	jsr lockMap		Lock map.	jsr setFileRefNum		Put file refNum in GS/OS parameter blocks.	jsr freeRes		Free memory allocated for resource.	jsr unlockMap		Leave map unlocked.;@exit	brl pop8_NoErr		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Detach resource handle from resource map so	that the Resource Manager will no;=  longer know about the resource in memory.;=;= Inputs: PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resHasChanged Resource is marked as changed but not updated.;=   resNotFound  Resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;DetachResource;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4;;	jsr startCall		Allocate direct page, set <data.;;; --- Find resource.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Was the resource found.;     y = resNotFound.@errorOut	brl pop6_Err;;; --- Detach resource handle from resource.;@ok1	ldy #resAttr		Has the resource changed?	lda [<resPtr],y	and #resAbsLoad	bne @exit		Absolute resource can't be detached.	lda [<resPtr],y	ldy #resHasChanged		Error code, just in	case.	and #resChanged	bne @errorOut;	ldy #resHandle+1		Clear resHandle field so I don't know about the	lda #0		resource handle.	sta [<resPtr],y;@exit	brl pop6_NoErr		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Find a unique ID for a given resource type.	 The search is a two part;=  process.  First	the next highest or	lowest number, then	all numbers are tried ;=  using a hash table.;=;= Inputs: PUSH:LONG - Space for result.;=  PUSH:WORD - ID range.;=  PUSH:WORD - Resource type.;=;= Outputs: LONG - Unique resource ID.;=;= Errors: Carry set if error, a = error code:;=   resNoUniqueID No unique IDs could be found.;=   resNoCurFile No current resource file.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;UniqueResourceID;@type	equ inputs		Stack offsets.@IDrange	equ @type+2@result	equ @IDrange+2;@lowest	equ work		Local direct page area.@highest	equ @lowest+4@highRange	equ @highest+4@lowRange	equ @highRange+4@newLow	equ @lowRange+4@hash	equ @newLow+2@hashBank	equ @hash+4@localSize	equ @hashBank+4		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;	jsr startCall		Allocate direct page, set <data.;	stz <@result	stz <@result+2;	jsr getCurMap		<mapHand = current map, locked.	bcc @ok1	brl pop4_Err		y = resNoCurFile.;@ok1	jsr unlockMap	stz <@lowRange		Set default low range, $00000001.	inc <@lowRange	stz <@lowRange+2;	stz <@highRange		Set default high range, $07FEFFFF.	dec <@highRange	lda #$07FE	sta <@highRange+2;	lda <@IDrange		Did caller want any	application range ID?	cmp #$FFFF	beq @ok3	cmp #$0800		Valid range?	bcc @ok7	brl @noneFound		If invalid range, no unique found.@ok7	tax	beq @skip1		Low range of $0000 range is $00000001.;	stz <@lowRange		Low range is $XXXX0000.	sta <@lowRange+2@skip1	sta <@highRange+2		High range is $XXXXFFFF.;; ---------------------------------------------------------------------------------------------; --- Try next highest or lowest --------------------------------------------------------------; ---------------------------------------------------------------------------------------------;@ok3	ldx <@lowRange+2		Set highest to one less than lowest possible ID.	lda <@lowRange	sec	sbc #1	bcs @store1	dex@store1	sta <@highest	stx <@highest+2;	ldx <@highRange+2		Set lowest to one higher than highest possible ID.	lda <@highRange	inc a	bne @store2	inx@store2	sta <@lowest	stx <@lowest+2;	stz <@newLow		Start with no new low found.;	lda #@ckHighLow		Pass routine to call for each map.	jsr walkMapsCur		Start with current file.;;; --- Try next lowest.;	lda <@lowRange		Use lowest possible	ID if no other low was found.	ldx <@lowRange+2	ldy <@newLow		Was a low ID found?	beq @toGotit;	lda <@lowest		Check if lower ID can be used.	ldx <@lowest+2	cmp <@lowRange		Test if already the	lowest possible.	bne @ok6	cpx <@lowRange+2	beq @tryHigh;@ok6	sec		;Use next lower ID.	sbc #1	bcs @toGotit	dex@toGotit	brl @gotit;;; --- Try next highest.;@tryHigh	lda <@highest		Make ID one higher than the highest.	ldx <@highest+2	cmp <@highRange		Already highest?	bne @ok2	cpx <@highRange+2	beq @searchAll;@ok2	inc a	bne @toGotit	inx	bpl @toGotit		Past max?;;; ---------------------------------------------------------------------------------------------; --- Search every number ---------------------------------------------------------------------; ---------------------------------------------------------------------------------------------;@searchAll	lda #hashIDTable		Push address of hash table.	jsr pushDataArea	pla		Keep handy pointer to hash table.	sta <@hash	pla	sta <@hash+2;	ldy #hashSize-2		Clear hash table.	lda #0@lop1	sta [<@hash],y	dey	dey	bpl @lop1;	lda <@lowRange		First ID bank to search.	and #$F000	sta <@hashBank	lda <@lowRange+2	stz <@hashBank+2;@lop3	lda #@hashIDs		Pass routine to call for every map.	jsr walkMapsCur		Start with current file.;	ldy #hashSize-2		Check for any ID not used in this ID bank.@lop2	lda [<@hash],y	cmp #$FFFF	bne @ok4	inc a		Clear table while I'm here.	sta [<@hash],y	dey	dey	bpl @lop2;	ldx <@hashBank+2		Check next bank.	lda <@hashBank	clc	adc #$1000	bcc @store3	inx@store3	sta <@hashBank	stx <@hashBank+2	cpx <@highRange+2	bcc @lop3	bne @noneFound	cmp <@highRange	bcc @lop3;@noneFound	ldy #resNoUniqueID		Return error code, all IDs for type are	used.	brl pop4_Err		Strip input parameters and exit.;;; ------ Convert zero hash bit into ID.;;  y = index to hashed word.;  a = hashed word.;@ok4	pha		Save hashed word.;	tya		Convert index into ID bits 4-11.	asl a	asl a	asl a	sta <@result;	ldx #15		Bit counter.	pla		Get hashed word.	xba		Convert two hashed bytes into a word.@lop4	lsr a		Look for zero bit.	bcc @ok5	dex	bra @lop4		Has to be a zero bit!;@ok5	txa		Convert bit index into bits 0-3 of ID.	ora <@result		Add bits 4-11 to get bits 0-11.	ora <@hashBank		Add bits 12-15 to get bits 0-16	ldx <@hashBank+2		Bits 16-30.;;; --- Exit.;;  x/a = ID.;@gotit	sta <@result		x/a = ID.	stx <@result+2		Return unique ID.;	brl pop4_NoErr		Strip input parameters and exit.;;;------------------------------------------------------------------------------------------; Get the highest and lowest resource ID used in the undefined range.;-100--------------------------------------------------------------------------------------;;  IN: <mapPtr = pointer to locked resource map.; <@lowest = current lowest ID of the given type.; <@highest = current highest ID of the	given type.; <@type = resource	type to check for.; <@IDrange = range	of IDs to check, negative to check all IDs.;; OUT: <@lowest = the lower of the given lowest or lowest resource ID of the ;            given type in the map.; <@highest = the higher of the given highest or highest resource ID of the ;     given type in	the map.;@ckHighLow	jsr getFirstRes		;x/a = pointer to first resource index.	stx <resPtr+2		;Low word stored later.	bra @enter100;@lop100	cmp <@type		;Is this the type I'm checking?	bne @next100;	ldy #resID+2		;Get ID.	lda [<resPtr],y		;Is it a defined ID?	tax	dey	dey	lda [<resPtr],y		;x/a = ID.;*** 24-Jun-91 DAL -- fix any-range code to disallow $07FFxxxx!;	ldy <@IDrange		;Any ID?;	bmi @ok100	ldy <@IDrange	bpl @notAnyRange	cpx #$07FF		;if any range, ignore all $07FFxxxx resources!	bcc @ok100		;was BNE 1-Jul-91 DAL	bra @next100@notAnyRange*** end 24-Jun-91 DAL	cpx <@IDrange		;Is this ID in range?	bne @next100;@ok100	cpx <@lowest+2		;Is it lower than the current lowest?	bcc @newLow100	bne @ckHigh100	cmp <@lowest	bcs @ckHigh100@newLow100	sta <@lowest		;New lowest ID.	stx <@lowest+2	ldy #1		;Set 'new low found' flag.	sty <@newLow;@ckHigh100	cpx <@highest+2		;Is it higher than the current highest?	bcc @next100	bne @newHigh100	cmp <@highest	bcc @next100@newHigh100	sta <@highest		;New highest ID.	stx <@highest+2;@next100	lda <resPtr		;Compute pointer to next resource record.	clc	adc #resRecSize	bcc @enter100	inc <resPtr+2;@enter100	sta <resPtr	lda [<resPtr]		;Any more resources?	bne @lop100;	clc 		;Continue to walk maps.	rts;;;------------------------------------------------------------------------------------------; Hash ID numbers in a range.;-110--------------------------------------------------------------------------------------;;  IN:  <mapPtr = pointer to locked resource map.;  <@type = resource type to check for.;  <@hashBank = high byte of 20 bit ID to hash.;  <@hash = pointer	to 512 byte hash table.;; OUT:  The lower 12 bits of every resource in the map is put into the hash table if;  the type is the same as the given type and the high byte	of the ID matches the;  given high byte.;@hashIDs	jsr getFirstRes		x/a = pointer to first resource index.	stx <resPtr+2		Low word stored later.	bra @enter110;@lop110	cmp <@type		Is this the type I'm checking?	bne @next110;	ldy #resID+2	lda [<resPtr],y		Check if ID is in the right bank.	cmp <@hashBank+2	bne @next110	dey	dey	lda [<resPtr],y	and #$F000	cmp <@hashBank	bne @next110;	lda [<resPtr],y		Hash the lower 12 bits of this ID.	and #$0FFF	lsr a		Compute index to byte in hash table.	lsr a	lsr a	tay	lda [<resPtr],y		Compute bit index in byte.	and #$0007	tax	sep #$20	LONGA OFF	lda [<@hash],y	ora hashMask,x	sta [<@hash],y	rep #$20	LONGA ON;@next110	lda <resPtr		Compute pointer to next resource record.	clc	adc #resRecSize	bcc @enter110	inc <resPtr+2;@enter110	sta <resPtr	lda [<resPtr]		Any more resources?	bne @lop110;	clc		Continue to walk maps.	rts;	EJECT;================================================================================================;=;= Description: Change a resource's ID.;=;= Inputs: PUSH:LONG - New ID.;=  PUSH:WORD - Type to change.;=  PUSH:LONG - ID to change.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resNotFound  Resource was not found.;=   resDupID  New ID is already used.;=   invalidAccess - if the file is not opened with write access;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;SetResourceID;@resIDIn	equ inputs		Input parameter offsets.@resTypeIn	equ @resIDIn+4@newID	equ @resTypeIn+2;;	jsr startCall		Allocate direct page, set <data.*** added 13-May-91 DAL -- validate ID	lda <@newID	ora <@newID+2	bne @good@bad	ldy #resInvalidTypeOrID	brl pop10_Err@good*** end of 13-May-91 DAL;; --- Make sure new	ID is not already used.;	lda <@resTypeIn		Pass type.	ldy <@newID		Pass ID.	ldx <@newID+2	jsr findGivenRes2		Find resource that was given.	bcc @ok2		Not found?	ldy #resDupID		Return error code, ID already used.@errorOut	brl pop10_Err		Exit.;;; --- Find resource	to be changed.;@ok2	jsr findGivenRes1		Find resource that was given.	bcc @errorOut		y = resNotFound.*** Unchanged 10-Feb-93 DAL;;;*** 27-Jan-93 JCM - Make sure that the file can be written to before continuing.;;;	jsr isFileWriteable		;can we eventually write to this file?;;;	bcs @errorOut		; nope, return y = invalidAccess;;;*** End - 27-Jan-93 JCM;;; --- Remove resource from index.;@saveRes	equ work+24		Local direct page area.@localSize	equ @saveRes+resRecSize	Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;	jsr lockMap		Lock the map (may not be needed, but no	surpises).;	ldy #resRecSize-2		Save the resource index reference.@lop1	lda [<resPtr],y	tyx	sta <@saveRes,x	dey	dey	bpl @lop1;	lda <@newID		Replace type and ID	with new.	sta <@saveRes+resID	lda <@newID+2	sta <@saveRes+resID+2;	jsr removeIndexRef		Remove the resource	index reference.;;; --- Insert resource back into index according to its new ID.;; ------ Find spot for resource.;	lda <@resTypeIn		Pass type.	ldy <@newID		Pass new ID.	ldx <@newID+2	jsr findResRec		Compute place resource goes.;;; ------ Insert resource reference in proper spot in the index.;; <resPtr = place to insert resource reference.;	jsr insertIndexRef		Move references down to make room for new one.;	ldy #resRecSize-2		Restore the resource index reference in	its new@lop2	tyx spot.	lda <@saveRes,x	sta [<resPtr],y	dey	dey	bpl @lop2;	jsr markDirtyMap		Mark map as needing	to be updated.	jsr unlockmap		Leave map unlocked.;	brl pop10_NoErr		Strip input parameters and exit.;;	EJECT;================================================================================================;=;= Description: Return attributes of resource.;=;= Inputs: PUSH:WORD - Space for result.;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: WORD - attributes of resource (see equates for bit definitions).;=;= Errors: Carry set if error, a = error code:;=   resNotFound  Resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;GetResourceAttr;@resIDIn	equ inputs		Input parameter offsets.@resTypeIn	equ @resIDIn+4@result	equ @resTypeIn+2;;	jsr startCall		Allocate direct page, set <data.;;; --- Find the resource.;	jsr findGivenRes1		Find resource that was given.	bcc @errorOut;;; --- Return resource's attributes.;	ldy #resAttr	lda [<resPtr],y	sta <@result;	ldy #0		No error.;@errorOut	brl pop6_Err;	EJECT;================================================================================================;=;= Description: Set	attributes of resource.;=;= Inputs: PUSH:WORD - New attributes.;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resNotFound  Resource was not found.;=   invalidAccess - if the file is not opened with write access;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;SetResourceAttr;@resIDIn	equ inputs		Input parameter offsets.@resTypeIn	equ @resIDIn+4@newAttr	equ @resTypeIn+2;;	jsr startCall		Allocate direct page, set <data.;;; --- Find the resource.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Found?	brl pop8_Err*** 27-Jan-93 JCM - Make sure that the file can be written to before continuing.@ok1	*** Unchanged 10-Feb-93 DAL;;;	jsr isFileWriteable		;can we eventually write to this file?;;;	bcc @ok1b		; yup;;;;;;	brl pop8_Err		;y = invalidAccess;; --- Set resource's new attributes.;;;;@ok1	ldy #resAttr		Store new attributes.@ok1b	ldy #resAttr		Store new attributes.	*** End - 27-Jan-93 JCM	lda <@newAttr	sta [<resPtr],y;	jsr markDirtyMap		Mark map as needing	to be updated.;	brl pop8_NoErr;	EJECT;================================================================================================;=;= Description: Return size of a resource in its file.;=;= Inputs: PUSH:LONG - Space for result.;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: LONG - size of resource, in	bytes, of resource in its file.;=;= Errors: Carry set if error, a = error code:;=   resNotFound  Resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;GetResourceSize;@resIDIn	equ inputs		Input parameter offsets.@resTypeIn	equ @resIDin+4@result	equ @resTypeIn+2;;	jsr startCall		Allocate direct page, set <data.;;; --- Find the resource.;	jsr findGivenRes1		Find resource that was given.	bcc @errorOut		y = resNotFound.;;; --- Return resource's size.;	ldy #resSize	lda [<resPtr],y	sta <@result	iny	iny	lda [<resPtr],y	sta <@result+2;	ldy #0		No error.;@errorOut	brl pop6_Err;;	EJECT;================================================================================================;=;= Description: Find resource that has a given handle.;=;= Inputs: PUSH:LONG - pointer to place	to store type and ID:;=    WORD - space for type.;=    LONG - space for ID.;=    WORD - optional space for resource file number, if pointer bit 31 is set (DAL);=  PUSH:LONG - handle of resource.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   resNotFound  Resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;MatchResourceHandle;@resHandleIn	equ inputs		Input parameter offsets.@storeResult	equ @resHandleIn+4;;	jsr startCall		Allocate direct page, set <data.;;; --- Find the resource.;	lda #@findHandle		Pass routine to call for each map.	jsr walkAllFiles		Walk all open maps.	ldy #resNotFound		Load possible error	code.	bcc @errorOut		Resource not found?;;; --- Return resource's type and ID.;@ok1	lda [<resPtr]		Return type.	sta [<@storeResult]	ldy #resID		Return ID.	lda [<resPtr],y	sta [<@storeResult],y	iny	iny	lda [<resPtr],y	sta [<@storeResult],y*** added 10-Oct-91 DAL -- if requested, return the resource file number	lda <@storeResult+2	bpl @notRequested	ldy #mapID	lda [<mapPtr],y	ldy #6	;offset to res file number in result buffer	sta [<@storeResult],y@notRequested*** end 10-Oct-91	ldy #0		No error.;@errorOut	brl pop8_Err;;;----------------------------------------------------------------------; Search every resource in the map for a given handle.;-100------------------------------------------------------------------;;   IN: <mapPtr = pointer to locked map.; <mapHand = handle	of locked map.;@findHandle	lda #@searchHandle		Pass routine to call.	brl walkResources		Check every resource in the map.;;;----------------------------------------------------------------------; Check if given handle belongs to this	resource.;-110------------------------------------------------------------------;;   IN: <mapPtr = pointer to locked map.; <mapHand = handle	of locked map.; <resPtr = pointer	to resource to check.; <@resHandleIn = handle to check for.;;  OUT: Carry set if match.;@searchHandle	ldy #resHandle	lda [<resPtr],y	cmp <@resHandleIn	bne @continueLooking	iny	iny	lda [<resPtr],y	cmp <@resHandleIn+2	bne @continueLooking	rts		Carry is set if equal.;@continueLooking	clc		No match, continue search.	rts;	EJECT;;================================================================================================;=;= Description: Return number of different types in all open files.;=;= Inputs: PUSH:WORD - space for result.;=;= Outputs: WORD - number of different resources in all open files.;=;= Errors: Carry set if error, a = error code:;=   Memory Manager	errors Returned unchanged.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;CountTypes;@result	equ inputs		Input parameter offsets.;;	jsr startCall		Allocate direct page, set <data.;	jsr countResTypes		<work = number of types.	bcs @exit		y = memory errors.;	lda <work	sta <@result		Return number of types.	jsr freeTypeHash		Free hash table.	ldy #0		No error.;@exit	brl pop0_Err;;	EJECT;================================================================================================;=;= Description: Return type of given index.;=;= Inputs: PUSH:WORD - space for result.;=  PUSH:WORD - index.;=;= Outputs: WORD - type.;=;= Errors: Carry set if error, a = error code:;=   Memory Manager	errors Returned unchanged.;=   resIndexRange	Index was out of range.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;GetIndType;@index	equ inputs		Input parameter offsets.@result	equ @index+2;@numOfTypes	equ work@hashHandle	equ @numOfTypes+2@hashPtr	equ @hashHandle+4;;	jsr startCall		Allocate direct page, set <data.;	stz <@result		Start with no type found.;;	jsr countResTypes		<work = number of types.	bcs @exit		Unable to allocate hash table?;;; --- Count marks in hash table while decrementing given index.;	ldy #0		Search hash table.	sep #$20	LONGA OFF@lop2	lda [<@hashPtr],y	beq @nextByte;	ldx #0		Search bits in byte.@lop3	lda [<@hashPtr],y	and bits,x	beq @next3	rep #$20	dec @index	beq @gotit	sep #$20@next3	inx	cpx #8	bne @lop3@nextByte	iny	cpy #8*1024	bne @lop2	rep #$20	LONGA ON;	ldy #resIndexRange		Return index out of	range error.	bra @exit2;;; --- Convert bit position into type.;@gotit	stx <@result		Convert position of	bit into type.	tya	asl a	asl a	asl a	ora <@result	sta <@result		Return type.;;; --- Free hash table.;	ldy #0		No error.;@exit2	phy		Save error.	jsr freeTypeHash		Free hash table.	ply		Restore error code.;@exit	brl pop2_Err;	EJECT;================================================================================================;=;= Description: Return number of resources of a given type in all files.;=;= Inputs: PUSH:LONG - space for result.;=  PUSH:WORD - type.;=;= Outputs: None.;=;= Errors: None.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;CountResources;@type	equ inputs		Input parameter offsets.@result	equ @type+2;;	jsr startCall		Allocate direct page, set <data.;	stz <@result		Start counter.	stz <@result+2;;; --- Count resources.;	lda #@count1	jsr walkMapsCur		Count starting in current file.;	brl pop2_NoErr;;;================================================================================================; Count resources of a given type.;================================================================================================;@count1	lda #@count2	brl walkResources;@count2	lda [<resPtr]		Get type.	cmp <@type		Counting this type?	bne @exit100	inc <@result		Increment counter.	bne @exit100	inc <@result+2@exit100	clc		Continue walk.	rts;	EJECT;================================================================================================;=;= Description: Load resource of a given index and type.;=;= Inputs: PUSH:LONG - space for result.;=  PUSH:WORD - Type.;=  PUSH:LONG - index of ID.;=;= Outputs: LONG - ID of resource.;=;= Errors: Carry set if error, a = error code:;=   GS/OS errors  Returned unchanged.;=   Memory Manager	errors Returned unchanged.;=   resIndexRange	Index out of range.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;GetIndResource;@index	equ inputs		Input parameter offsets.@type	equ @index+4@result	equ @type+2;;	jsr startCall		Allocate direct page, set <data.;	stz <@result		Start with no ID returned.	stz <@result+2;;; --- Find resource	by index.;	lda #@find1	jsr walkMapsCur		Start search in current file.	ldy #resIndexRange		Error code, just in	case.	bcc @exit		Resource found?;	ldy #resID		Return ID of resource.	lda [<resPtr],y	sta <@result	iny	iny	lda [<resPtr],y	sta <@result+2	ldy #0		No error.;@exit	brl pop6_Err;;;================================================================================================; Find resource by index.;================================================================================================;@find1	lda #@find2	brl walkResources;@find2	lda [<resPtr]		Get type.	cmp <@type		Looking for this type?	bne @exit100	lda <@index	sec	sbc #1	sta <@index	bcs @ok100	dec <@index+2@ok100	ora <@index+2	bne @exit100	sec		;Found it.	rts@exit100	clc		;Continue walk.	rts;	EJECT;================================================================================================;=;= Description: Turns loading of resources on and off.;=;= Inputs: PUSH:WORD - space for result.;=  PUSH:WORD - 0 =	stops resources reading.;=      1 = turnd reading back on.;=     negative = just return current setting.;=;= Outputs: WORD - original read flag.;=;= Errors: None.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;SetResourceLoad;@flagIn	equ inputs		Input parameter offsets.@result	equ @flagIn+2;;	jsr startCall		Allocate direct page, set <data.;	lda <@flagIn	jsr setReadFlag	sta <@result;	brl pop2_NoErr;	EJECT;================================================================================================;=;= Description: Set	number of files to search.;=;= Inputs: PUSH:WORD - space for result.;=  PUSH:WORD - number of files to search, NIL to just return current depth.;=;= Outputs: WORD - original file depth.;=;= Errors: None.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;SetResourceFileDepth;@flagIn	equ inputs		Input parameter offsets.@result	equ @flagIn+2;;	jsr startCall		Allocate direct page, set <data.;	lda <@flagIn		Pass new file depth.	jsr setFileDepth	sta <@result		Return original file depth.;	brl pop2_NoErr		y = error code if any.;	EJECT;================================================================================================;=;= Description: Return open file reference number for file.;=;= Inputs: PUSH:WORD - space for result.;=  PUSH:WORD - file ID.;=;= Outputs: WORD - open file reference number, NIL if ROM file.;=;= Errors: Carry set if error, a = error code:;=   resFileNotFound;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;GetOpenFileRefNum;@fileIn	equ inputs		;Input parameter offsets.@result	equ @fileIn+2*** added 7-Apr-91 DAL****** Volume 3 says input $0000 = current file, $FFFF = system file, but there*** was no code for that.@stackInput	equ 7+4	pha	phy	lda @stackInput,s	;input file ID	beq @currentFile	inc a	bne @notSpecial	lda #1	sta @stackInput,s	bra @continue@currentFile	pha	_GetCurResourceFile	pla	sta @stackInput,s@notSpecial@continue	ply	pla*** end of 7-Apr-91 DAL	jsr startCall		;Allocate direct page, set <data.;	lda #@findMapID		;Pass routine to call.	jsr walkAllFiles	ldy #resFileNotFound	;Error code, just in case.	bcc @exit		;Was map found?;	ldy #mapFileNum		;Return open file reference number.	lda [<mapPtr],y	sta <@result;	ldy #0		;No error.;@exit	brl pop2_Err;;;-------------------------------; Match file ID.;-------------------------------;@findMapID	ldy #mapID	lda [<mapPtr],y	cmp <@fileIn	beq @exit100	clc@exit100	rts;	EJECT;;;================================; Get handle of map.;================================;;   IN: PUSH:LONG -	space for result, map handle.; PUSH:WORD - file ID, NIL for current.;GetMapHandle;@givenFile	equ inputs		Offset to input parameter.@result	equ @givenFile+2;;	jsr startCall		Allocate direct page, set <data.;	stz <@result	stz <@result+2;;; --- Verify open file reference number	is valid.;	lda <@givenFile		Pass file to find.	bne @ok1	jsr getCurMapHand		x/a = handle of current map.	bra @store1;@ok1	jsr findFileID		Find the map that matches the given file ID.	bcs @exit		Not found?;	lda <mapHand		Handle of matched file (NOT LOCKED).	ldx <mapHand+2;@store1	sta <@result	stx <@result+2;	ldy #0		No error.;@exit	brl pop2_Err		Strip input parameters and exit.;	EJECT;================================================================================================;=;= Description: Load resource at an absolute address.;=;= Inputs: PUSH:LONG - space for result.;=  PUSH:LONG - address to load resource at, NIL to load at	preload address.;=  PUSH:LONG - maximum number of bytes	to load.;=  PUSH:WORD - type.;=  PUSH:LONG - ID.;=;= Outputs: LONG - size of resource in file.;=;= Errors: Carry set if error, a = error code:;=   GS/OS errors  Returned unchanged.;=   resNotFound  The resource was not found.;=;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;LoadAbsResource;@resIDIn	equ inputs		Stack offsets.@resTypeIn	equ @resIDIn+4@maxSize	equ @resTypeIn+2@loadAddr	equ @maxSize+4@result	equ @loadAddr+4;@sizeOfRes	equ work		!!! @sizeOfRes must	= work !!!@openRefNum	equ @sizeOfRes+4@localSize	equ @openRefNum+2		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;	jsr startCall		Allocate direct page, set <data.;;; --- Find the resource.;	jsr findGivenRes1		Find resource that was given.	bcs @ok1		Was the resource found?	stz <@result		Return NIL size.	stz <@result+2	bra @exit		Y = error code, resNotFound.;;; --- Load the resource.;; <mapHand = handle	of map.; <resPtr = pointer	to resource.;@ok1	jsr lockMap		Lock the map before	<resPtr moves.;	ldy #resSize		Return size of resource, no matter what	is loaded.	lda [<resPtr],y	sta <@result	iny	iny	lda [<resPtr],y	sta <@result+2;	ldy #resHandle+2		Save current value in handle field.	lda [<resPtr],y	pha	dey	dey	lda [<resPtr],y	pha;	lda <@loadAddr		Was a load address passed?	ora <@loadAddr+2	beq @skip1;	lda <@loadAddr		Replace field with passed address.	sta [<resPtr],y	iny	iny	lda <@loadAddr+2	sta [<resPtr],y;@skip1	lda <@maxSize		Pass max size to load.	ldx <@maxSize+2	jsr loadRes		Load the resource	pla		Get saved handle field.	plx	phy		Save error code, Memory and GS/OS errors.	ldy #resHandle		Restore handle field.	sta [<resPtr],y	iny	iny	txa	sta [<resPtr],y	jsr unlockMap		Leave map unlocked.	ply		Restore error code.@exit	brl pop14_Err		Strip input parameters and exit, y = error code.;	EJECT;================================================================================================;=;= Description: Log	resource converter routine in & out of Resource Manager.;=;= Inputs: PUSH:LONG - address of routine, used only if logging in.;=  PUSH:WORD - type of resource to be converted.;=  PUSH:WORD - bit	0 = 1 to log in, 1 to log out; bit 2 = 1 if system converter.;=;= Outputs: None.;=;= Errors: Carry set if error, a = error code:;=   Memory errors	Returned unchanged.;=   resDiffConverter  Different converter already logged in the type.;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================;ResourceConverter;@logFlag	equ inputs@conType	equ @logFlag+2@conAddr	equ @conType+2;@listHand	equ work@listPtr	equ @listHand+4@find	equ @listPtr+4;@logIn	equ $0001@sysConvert	equ $0002;;	jsr startCall		Allocate direct page, set <data.;	lda <@logFlag		System converter?	and #@sysConvert	beq @ok3;	ldy #sysConvertList+2	Use system converter list.	lda [<data],y	tax	dey	dey	lda [<data],y	bra @store1;;; --- Get current application's converter list.;@ok3	jsr getCurConList		Get handle of application's converter list.@store1	sta <@listHand	stx <@listHand+2;	lda <@listHand+1		Has one been started yet?	bne @ok1;;; ------ Allocate a	converted list.;	lda <@logFlag		Logging out?	and #@logIn	bne @ok5	brl @exit1		Done if logging out.@ok5;	lda #(convertRecSize*10)+2	Number of bytes to allocate.	jsr allocateHand1		Allocate a default list.	bcc @ok4		Error?	brl @exit2@ok4	sta <@listHand	stx <@listHand+2;	jsr getCurConList		y = index to where to store in app record.	lda <@logFlag	and #@sysConvert	beq @ok6	ldy #sysConvertList		Store in global spot.@ok6	lda <@listHand		Store handle of new	converter list.	sta [<data],y	iny	lda <@listHand+1	sta [<data],y;	jsr @derefList		<@listPtr = (<@listHand).;	ldy #convertRecSize*10	Number of bytes allocated.	lda #0		Initialize list to none used.@lop1	sta [<@listPtr],y	dey	dey	bne @lop1;	lda #10		Initialize number of records.	sta [<@listPtr];;; ------ When logging in, first find if	it's already logged in.;@ok1	jsr @derefList		<@listPtr = (<@listHand).;@tryAgain	lda <@logFlag	and #@logIn	beq @findLogOut;	lda [<@listPtr]		Get number of records to search.	tax	ldy #convertList		Start with first record.@lop3	lda <@conType		Spot to find.	cmp [<@listPtr],y	bne @next3		Is the type already	in this spot?;	iny		Is the address of the converter also the same?	iny	lda <@conAddr	cmp [<@listPtr],y	bne @diffConverter	iny	iny	lda <@conAddr+2	cmp [<@listPtr],y	bne @diffConverter		If type and address	same, it's already installed.	brl @exit1;@diffConverter	ldy #resDiffConverter	Return error that a	different convert has the type.	brl @exit2;@next3	tya		Next record.	clc	adc #convertRecSize	tay	dex Any		more records?	bne @lop3;     The type in be installed is not in the list.	stz <@find		Find an empty spot.	bra @ok2;;; --- Find entry to	add or delete.;@findLogOut	lda <@conType		Find the spot to log out.	sta <@find@ok2;	lda [<@listPtr]		Get number of records to search.	tax	ldy #convertList		Start with first record.@lop2	lda <@find		Spot to find.	cmp [<@listPtr],y	beq @gotit	tya		Next record.	clc	adc #convertRecSize	tay	dex		Any more records?	bne @lop2;;; ------ Grow converter list.;	lda <@logFlag		Spot not found.	and #@logIn	beq @exit1		Done if trying to log out.;	ldy #handSize		Get current size of	list.	lda [<@listHand],y	clc	adc #convertRecSize*10;	pea 0		Pass new size.	pha	pei <@listHand+2		Pass handle to change.	pei <@listHand	_SetHandleSize	tay		Possible error code.	bcs @exit2;	jsr @derefList		<@listPtr = (<@listHand).;	ldy #handSize	lda [<@listHand],y	tay	ldx #convertRecSize*10	Number of bytes to initialize.	lda #0	dey	dey@lop4	sta [<@listPtr],y	dey	dey	dex	dex	bne @lop4;	lda [<@listPtr]		Increment number of	records in list.	clc	adc #10	sta [<@listPtr]	brl @tryAgain		Try to find spot again.;;; --- Add or subtract converter.;;  y = index to converter record.;@gotit	lda <@logFlag		Log in or out.	and #@logIn	bne @install;	phy		When logging out, make sure the converters match.	iny	iny	lda [<@listPtr],y	tax	iny	iny	lda [<@listPtr],y	ply;	cpx <@conAddr	bne @toDiff	cmp <@conAddr+2	beq @ok7@toDiff	brl @diffConverter;@ok7	lda #0		Mark record as avaible.	sta [<@listPtr],y	bra @exit1;@install	lda <@conType		Install resource type to convert.	sta [<@listPtr],y	iny	iny	lda <@conAddr		Install address of converter.	sta [<@listPtr],y	iny	iny	lda <@conAddr+2	sta [<@listPtr],y;@exit1	ldy #0		No error.@exit2	brl pop8_Err;------------------------------------------------------; Dereference local	converter list handle.;------------------------------------------------------@derefList	ldy #2	lda [<@listHand],y	sta <@listPtr+2	lda [<@listHand]	sta <@listPtr	rts*********************************************************************************** $2A1E RMFindNamedResource -- new call 10-Mar-91 DAL for 6.0** Inputs:*   LONG  space for resulting resource ID*   WORD  resource type*   LONG  pointer to Pascal name string*   LONG  pointer to storage for file number** Errors:*   resNameNotFound $1E10 -- no resource found with specified name**********************************************************************************RMFindNamedResource@nameIndex	equ 1@nameCount	equ @nameIndex+4@curDepth	equ @nameCount+4@mapHndl	equ @curDepth+2@maxDepth	equ @mapHndl+4@curFile	equ @maxDepth+2@saveCurrent	equ @curFile+2@nameHndl	equ @saveCurrent+2@oldD	equ @nameHndl+4@rtl	equ @oldD+2@theFileNum	equ @rtl+6@theName	equ @theFileNum+4@whichType	equ @theName+4@result	equ @whichType+2	phd	tsc	sec	sbc #@oldD-1	tcs	tcd	pha	_GetCurResourceFile	pla	sta <@saveCurrent	sta <@curFile	pha	pea 1	_SetResourceFileDepth	pla	sta <@maxDepth	lda #1	sta <@curDepth@whileDepth	lda <@curDepth	cmp <@maxDepth	beq @continue	bcc @continue	ldx #resNameNotFound	;error	brl @endWhile@continue	pha	pha	;space for LoadResource result	pea $8014	;rResName	pea $0001	;high word of resource ID	pei <@whichType	_LoadResource	tax	ply	pla	bcs @tryNextFile	sta <@nameHndl+2	sty <@nameHndl	ldy #2	lda [<@nameHndl],y	tax	lda [<@nameHndl]	sta <@nameHndl	stx <@nameHndl+2	lda [<@nameHndl]	;get version number	cmp #1	bne @tryNextFile	;bad format, try next one	ldy #2	;offset to nameCount field	lda [<@nameHndl],y	sta <@nameCount	iny	iny	lda [<@nameHndl],y	sta <@nameCount+2	clc	lda <@nameHndl	adc #6	;point past the version & count fields	sta <@nameHndl	bcc @nhOK	inc <@nameHndl+2@nhOK	stz <@nameIndex	stz <@nameIndex+2@srchName	lda <@nameIndex+2	cmp <@nameCount+2	bne @compared	lda <@nameIndex	cmp <@nameCount@compared	bcs @tryNextFile	pei <@theName+2	pei <@theName	clc	lda <@nameHndl	ldx <@nameHndl+2	adc #4	bcc @x	inx@x	phx	pha	jsr CompareNames	bne @noMatch	brl @FoundMatch@noMatch	ldy #4	;offset to pstring	lda [<@nameHndl],y	and #$00ff	clc	ldx <@nameHndl+2	adc <@nameHndl	bcc @x2	inx@x2	clc	adc #5	;skip past res id and length byte	bcc @x3	inx@x3	stx <@nameHndl+2	sta <@nameHndl	inc @nameIndex	bne @srchName	inc @nameIndex+2	bra @srchName@tryNextFile	lda <@curDepth	cmp <@maxDepth	beq @incDepth	pha	pha	pei <@curFile	_GetMapHandle	tax	ply	pla	bcs @endWhile	sta <@mapHndl+2	sty <@mapHndl	ldx #resNameNotFound	lda <@mapHndl+1	beq @endWhile	;Map handle NIL?  Will this ever happen?	ldy #2	lda [<@mapHndl]	tax	lda [<@mapHndl],y	sta <@mapHndl+2	stx <@mapHndl	ldy #2	;mapHndl <-- mapHndl^.mapNext (mapNext is the first field)	lda [<@mapHndl],y	tax	lda [<@mapHndl]	stx <@mapHndl+2	sta <@mapHndl	ldx #resNameNotFound	lda <@mapHndl+1	beq @endWhile	ldy #2	lda [<@mapHndl]	tax	lda [<@mapHndl],y	sta <@mapHndl+2	stx <@mapHndl	ldy #mapID	lda [<@mapHndl],y	sta <@curFile	pha	_SetCurResourceFile	tax	bcs @endWhile@incDepth	inc <@curDepth	brl @whileDepth@FoundMatch	lda <@curFile	sta [<@theFileNum]	ldy #2	lda [<@nameHndl]	sta <@result	lda [<@nameHndl],y	sta <@result+2	ldx #0	;no error@endWhile	phx	;save error code	pei <@saveCurrent	_SetCurResourceFile	pha	;space for result	pei <@maxDepth	_SetResourceFileDepth	pla	;ignore result	plx	;retrieve error code@exit	clc	tsc	adc #@oldD-1	tcs	pld	ldy #10	;number of bytes to strip	jml $e10184	;ToStripCompareNames	phd	tsc	tcd@oldD	equ 1@rts	equ @oldD+2@str1	equ @rts+2@str2	equ @str1+4	ldx #1	sep #$30	lda [@str1];;;	cmp [@str1]	cmp [@str2]	;fixed 2-Apr-92 DAL for 6.1d3	bne @compared	tay@cmp	lda [@str1],y	cmp [@str2],y	bne @compared	dey	bne @cmp	rep #$30	ldx #0	;equal!@compared	rep #$30	;X=0 if we matched	pld	lda 1,s	sta 1+8,s	pla	pla	pla	pla	txa	;set Z flag from X value	rts*********************************************************************************** $2B1E RMGetResourceName -- new call 10-Mar-91 DAL for 6.0** Inputs:*   WORD  resource type*   LONG  resource ID*   LONG  pointer to 256-byte Pascal string buffer**********************************************************************************RMGetResourceName@nameIndex	equ 1@nameCount	equ @nameIndex+4@curDepth	equ @nameCount+4@mapHndl	equ @curDepth+2@maxDepth	equ @mapHndl+4@curFile	equ @maxDepth+2@saveCurrent	equ @curFile+2@nameHndl	equ @saveCurrent+2@oldD	equ @nameHndl+4@rtl	equ @oldD+2@theName	equ @rtl+6@theResID	equ @theName+4@whichType	equ @theResID+4	phd	tsc	sec	sbc #@oldD-1	tcs	tcd	pha	_GetCurResourceFile	pla	sta <@saveCurrent	sta <@curFile	pha	pea 1	_SetResourceFileDepth	pla	sta <@maxDepth	lda #1	sta <@curDepth@whileDepth	lda <@curDepth	cmp <@maxDepth	beq @continue	bcc @continue	ldx #resNameNotFound	;error	brl @endWhile@continue	pha	pha	;space for LoadResource result	pea $8014	;rResName	pea $0001	;high word of resource ID	pei <@whichType	_LoadResource	tax	ply	pla	bcs @tryNextFile	sta <@nameHndl+2	sty <@nameHndl	ldy #2	lda [<@nameHndl],y	tax	lda [<@nameHndl]	sta <@nameHndl	stx <@nameHndl+2	lda [<@nameHndl]	;get version number	cmp #1	bne @tryNextFile	;bad format, try next one	ldy #2	;offset to nameCount field	lda [<@nameHndl],y	sta <@nameCount	iny	iny	lda [<@nameHndl],y	sta <@nameCount+2	clc	lda <@nameHndl	adc #6	;point past the version & count fields	sta <@nameHndl	bcc @nhOK	inc <@nameHndl+2@nhOK	stz <@nameIndex	stz <@nameIndex+2@srchName	lda <@nameIndex+2	cmp <@nameCount+2	bne @compared	lda <@nameIndex	cmp <@nameCount@compared	bcs @tryNextFile	lda <@theResID	cmp [<@nameHndl]	bne @noMatch	ldy #2	lda <@theResID+2	cmp [<@nameHndl],y	bne @noMatch	brl @FoundMatch@noMatch	ldy #4	;offset to pstring	lda [<@nameHndl],y	and #$00ff	clc	ldx <@nameHndl+2	adc <@nameHndl	bcc @x2	inx@x2	clc	adc #5	;skip past res id and length byte	bcc @x3	inx@x3	stx <@nameHndl+2	sta <@nameHndl	inc @nameIndex	bne @srchName	inc @nameIndex+2	bra @srchName@tryNextFile	lda <@curDepth	cmp <@maxDepth	beq @incDepth	pha	pha	pei <@curFile	_GetMapHandle	tax	ply	pla	bcs @endWhile	sta <@mapHndl+2	sty <@mapHndl	ldx #resNameNotFound	lda <@mapHndl+1	beq @endWhile	;Map handle NIL?  Will this ever happen?	ldy #2	lda [<@mapHndl]	tax	lda [<@mapHndl],y	sta <@mapHndl+2	stx <@mapHndl	ldy #2	;mapHndl <-- mapHndl^.mapNext (mapNext is the first field)	lda [<@mapHndl],y	tax	lda [<@mapHndl]	stx <@mapHndl+2	sta <@mapHndl	ldx #resNameNotFound	lda <@mapHndl+1	beq @endWhile	ldy #2	lda [<@mapHndl]	tax	lda [<@mapHndl],y	sta <@mapHndl+2	stx <@mapHndl	ldy #mapID	lda [<@mapHndl],y	sta <@curFile	pha	_SetCurResourceFile	tax	bcs @endWhile@incDepth	inc <@curDepth	brl @whileDepth@FoundMatch	clc	lda <@nameHndl	adc #4	;point to pstring	sta <@nameHndl	bcc @9	inc <@nameHndl+2@9	lda [<@nameHndl]	and #$00ff	inc a	pei <@nameHndl+2	pei <@nameHndl	pei <@theName+2	pei <@theName	pea 0	pha	_BlockMove	ldx #0	;no error@endWhile	phx	;save error code	pei <@saveCurrent	_SetCurResourceFile	pha	;space for result	pei <@maxDepth	_SetResourceFileDepth	pla	;ignore result	plx	;retrieve error code	tsc	clc	adc #@oldD-1	tcs	pld	ldy #10	;number of bytes to strip	jml $e10184	;ToStrip*********************************************************************************** $2C1E RMLoadNamedResource -- new call 10-Mar-91 DAL for 6.0** Inputs:*   LONG  space for resulting handle*   WORD  resource type*   LONG  pointer to Pascal-string resource name** Errors:*   resNameNotFound $1E10 -- no resource found with specified name*   any LoadResource errors**********************************************************************************RMLoadNamedResource	phd	pha	;space for @oldDepth	pha	;space for @oldFile	pha	;space for @theFile	tsc	tcd@theFile	equ 1@oldFile	equ @theFile+2@oldDepth	equ @oldFile+2@oldD	equ @oldDepth+2@rtl	equ @oldD+2@name	equ @rtl+6@type	equ @name+4@result	equ @type+2	stz <@result+2	stz <@result	pha	pha	;space for resource ID	pei <@type	pei <@name+2	pei <@name	pea 0	tdc	clc	adc #@theFile	pha		_RMFindNamedResource	tax	;keep error code	ply	pla	bcs @exit	pha	pha	;space for LoadResource result	pei <@type	pha	phy	;pushed type and id for LoadResource	pha	;space for GetCurResourceFile result	_GetCurResourceFile	pla	sta <@oldFile	pei <@theFile	_SetCurResourceFile	pha	;space for SetResourceFileDepth result	pea 1	_SetResourceFileDepth	pla	sta <@oldDepth	_LoadResource	;pushed parameters earlier	tax	ply	pla	bcs @skipResult	sta <@result+2	sty <@result@skipResult	phx	;save error code	pei <@oldFile	_SetCurResourceFile	pha	;space for SetResourceFileDepth result	pei <@oldDepth	_SetResourceFileDepth	pla	;ignore result	plx	;retrieve LoadResource error, if any@exit	ply	;remove @theFile	ply	;remove @oldFile	ply	;remove @oldDepth	pld	ldy #6	;number of bytes to strip	jml $e10184	;ToStrip*********************************************************************************** $2D1E RMSetResourceName -- new call 10-Mar-91 DAL for 6.0** Inputs:*   WORD  resource type*   LONG  resource ID*   LONG  pointer to new Pascal-string name**********************************************************************************RMSetResourceName@temp	equ 1@entryLength	equ @temp+4@nameIndex	equ @entryLength+2@nameCount	equ @nameIndex+4@curDepth	equ @nameCount+4@mapHndl	equ @curDepth+2@maxDepth	equ @mapHndl+4@curFile	equ @maxDepth+2@saveCurrent	equ @curFile+2@nameHndl	equ @saveCurrent+2	;this becomes a pointer@realNameHndl	equ @nameHndl+4@nameID	equ @realNameHndl+4@targPtr	equ @nameID+4@nextPtr	equ @targPtr+4@limitPtr	equ @nextPtr+4@oldSize	equ @limitPtr+4@moveCount	equ @oldSize+4@foundFile	equ @moveCount+4@oldD	equ @foundFile+2@rtl	equ @oldD+2@theName	equ @rtl+6@whichID	equ @theName+4@whichType	equ @whichID+4	phd	tsc	sec	sbc #@oldD-1	tcs	tcd*** added 13-May-91 DAL -- validate type and ID	lda <@whichType	beq @bad	lda <@whichID	ora <@whichID+2	bne @good@bad	ldx #resInvalidTypeOrID	brl @exit@good*** end of 13-May-91 DAL	pha	_GetCurResourceFile	pla	sta <@saveCurrent	sta <@curFile	pha	pea 1	_SetResourceFileDepth	pla	sta <@maxDepth	stz <@foundFile	lda #1	sta <@curDepth@whileDepth	lda <@curDepth	cmp <@maxDepth	beq @continue	bcc @continue	ldx #resNameNotFound	;error	brl @endWhile@continue	pha	pha	;space for LoadResource result	pea $8014	;rResName	pea $0001	;high word of resource ID	pei <@whichType	_LoadResource	tax	ply	pla	bcc @tnf3	brl @tryNextFile	;HyperCard checks only for $1E06 here--why??@tnf3	sta <@realNameHndl+2	sty <@realNameHndl	sta <@nameHndl+2	sty <@nameHndl	ldy #2	lda [<@nameHndl],y	tax	lda [<@nameHndl]	sta <@nameHndl	stx <@nameHndl+2	lda [<@nameHndl]	;get version number	cmp #1	beq @tnf2	brl @tryNextFile	;bad format, try next one@tnf2	ldy #2	;offset to nameCount field	lda [<@nameHndl],y	sta <@nameCount	iny	iny	lda [<@nameHndl],y	sta <@nameCount+2	clc	lda <@nameHndl	adc #6	;point past the version & count fields	sta <@nameHndl	bcc @nhOK	inc <@nameHndl+2@nhOK	stz <@nameIndex	stz <@nameIndex+2@srchName	lda <@nameIndex+2	cmp <@nameCount+2	bne @compared	lda <@nameIndex	cmp <@nameCount@compared	bcc @tnf1	brl @tryNextFile@tnf1*** nextPtr := pointer to the next entry	ldy #4	;offset to pstring	lda [<@nameHndl],y	and #$00ff	clc	adc #5	sta <@entryLength	ldx <@nameHndl+2	adc <@nameHndl	bcc @x2	inx@x2	stx <@nextPtr+2	sta <@nextPtr	lda <@whichID	cmp [<@nameHndl]	bne @noMatch	lda <@whichID+2	ldy #2	cmp [<@nameHndl],y	bne @noMatch	beq @FoundMatch@noMatch	lda <@nextPtr+2	sta <@nameHndl+2	lda <@nextPtr	sta <@nameHndl	inc @nameIndex	bne @srchName	inc @nameIndex+2	bra @srchName*** found an entry for the right ID--remove it*** (If there is only one entry in this rResName resource, remove the resource)@FoundMatch	ldy #2	lda [<@realNameHndl],y	sta <@temp+2	lda [<@realNameHndl]	sta <@temp	ldy #4	lda [@temp],y	bne @notJustOne	dey	dey	lda [@temp],y	dec a	;just one?	bne @notJustOne	pea $8014	;rResName	pea $0001	;high word of resource ID	pei <@whichType	_RemoveResource	brl @tryNextFile@notJustOne	sec	;decrement nameCount field in rResName resource	ldy #2	lda [<@temp],y	sbc #1	sta [<@temp],y	bcs @tempOK	iny	iny	lda [<@temp],y	dec a	sta [<@temp],y@tempOK*** remove entry from the rResName handle & mark it changed	pha	pha	;space for GetHandleSize	pei <@realNameHndl+2	pei <@realNameHndl	_GetHandleSize	pla	sta <@oldSize	pla	sta <@oldSize+2*** limitPtr := realNameHndl^ + oldSize;	clc	ldy #2	lda [<@realNameHndl]	adc <@oldSize	sta <@limitPtr	lda [<@realNameHndl],y	adc <@oldSize+2	sta <@limitPtr+2*** moveCount := limitPtr - nextPtr;	sec	lda <@limitPtr	sbc <@nextPtr	sta <@moveCount	lda <@limitPtr+2	sbc <@nextPtr+2	sta <@moveCount+2*** if moveCount<>0 then BlockMove(nextPtr,nameHndl,moveCount)	lda <@moveCount	ora <@moveCount+2	beq @noMove	pei <@nextPtr+2	pei <@nextPtr	pei <@nameHndl+2	pei <@nameHndl	pei <@moveCount+2	pei <@moveCount	_BlockMove@noMove*** SetHandleSize(oldsize-(nextPtr-nameHndl),realNameHndl)*** The delta size is @entryLength	lda <@oldSize	ldx <@oldSize+2	sec	sbc <@entryLength	bcs @xok	dex@xok	phx	pha	pei <@realNameHndl+2	pei <@realNameHndl	_SetHandleSize	pea $ffff	;true	pea $8014	;rResName	pea $0001	;high word of resource ID	pei <@whichType	_MarkResourceChange@tryNextFile	pha	pei <@whichType	pei <@whichID+2	pei <@whichID	_GetResourceAttr	tax	pla	;attributes (ignore)	bcs @notInThisFile	lda <@curFile	sta <@foundFile	bra @InsertNewName@notInThisFile	lda <@curDepth	cmp <@maxDepth	beq @incDepth	pha	pha	pei <@curFile	_GetMapHandle	tax	ply	pla	bcs @endWhile	sta <@mapHndl+2	sty <@mapHndl	lda <@mapHndl+1	beq @endWhile	;Map handle NIL?  Will this ever happen?	ldy #2	lda [<@mapHndl]	tax	lda [<@mapHndl],y	sta <@mapHndl+2	stx <@mapHndl	ldy #2	;mapHndl <-- mapHndl^.mapNext (mapNext is the first field)	lda [<@mapHndl],y	tax	lda [<@mapHndl]	stx <@mapHndl+2	sta <@mapHndl	lda <@mapHndl+1	beq @endWhile	ldy #2	lda [<@mapHndl]	tax	lda [<@mapHndl],y	sta <@mapHndl+2	stx <@mapHndl	ldy #mapID	lda [<@mapHndl],y	sta <@curFile	pha	_SetCurResourceFile	tax	bcs @endWhile@incDepth	inc <@curDepth	brl @whileDepth@endWhile		;this is label "3" in the HCGS source@InsertNewName	lda [<@theName]	and #$00ff	bne @nonNullName	brl @nullName@nonNullName	ldx #resNotFound	;resource doesn't exist ($1E06)	lda <@foundFile	bne @mapOK1	brl @outtaHere@mapOK1	pei <@foundFile	_SetCurResourceFile	tax	bcc @scrfOK	brl @outtaHere@scrfOK*** nameHndl := LoadResource(rResName, ...)	pha	pha	;space for LoadResource result	pea $8014	;rResName	pea $0001	;high word of resource ID	pei <@whichType	_LoadResource	tax	pla	sta <@nameHndl	pla	sta <@nameHndl+2	bcs @doesntExist	brl @exists@doesntExist*** the rResName resource we want doesn't exist, so create it	pha	pha	;space for NewHandle result	lda [<@theName]	and #$00ff	clc	adc #11	pea 0	pha	;handle size	pha	;space for GetCurResourceApp	_GetCurResourceApp	;use this for memory ID of new handle	pea 0	;attributes	pha	pha	;location (ignored)	_NewHandle	tax	ply	pla	bcc @gotNewHndl	brl @outtaHere	;return possible error in X@gotNewHndl	sta <@nameHndl+2	sty <@nameHndl	ldy #2	lda [<@nameHndl]	sta <@temp	lda [<@nameHndl],y	sta <@temp+2	lda #$0001	;rResName format version	sta [<@temp]	ldy #2	sta [<@temp],y	;low word of nameCount field	iny	iny	dec a	sta [<@temp],y	;ZERO--high word of nameCount	iny	iny	lda <@whichID	sta [<@temp],y	iny	iny	lda <@whichID+2	sta [<@temp],y	pei <@theName+2	pei <@theName	;source	clc	lda <@temp	adc #10	tax	lda <@temp+2	adc #0	pha	phx	;dest (offset 10 in new handle)	lda [<@theName]	and #$00ff	inc a	pea 0	pha	;length	_BlockMove	pei <@nameHndl+2	pei <@nameHndl	pea 0	;resource attributes	pea $8014	;rResName	pea $0001	;high word of rResName resource ID	pei <@whichType	_AddResource	tax	;return possible error	bra @outtaHere0*** insert name into existing rResName resource@exists	ldy #2	lda [<@nameHndl]	sta <@temp	lda [<@nameHndl],y	sta <@temp+2	lda [<@temp]	;check rResName format version	ldx #resBadNameVers	;anticipate bad rResName format version	cmp #$0001	bne @outtaHere0*** oldSize := GetHandleSize(nameHndl)	pha	pha	pei <@nameHndl+2	pei <@nameHndl	_GetHandleSize	pla	sta <@oldSize	pla	sta <@oldSize+2*** SetHandleSize -- grow nameHndl by name length + 5	clc	lda [<@theName]	and #$00ff	adc #5	adc <@oldSize	tax	lda <@oldSize+2	adc #0	pha	phx	pei <@nameHndl+2	pei <@nameHndl	_SetHandleSize	tax	bcc @grewHandle	;return possible error@outtaHere0	brl @outtaHere*** Find the right place for the new entry to go (@temp)@grewHandle	stz <@nameIndex	stz <@nameIndex+2	ldy #2	lda [<@nameHndl],y	sta <@temp+2	lda [<@nameHndl]	sta <@temp	;deref nameHndl to temp	lda [<@temp],y	;Y is still 2	sta <@nameCount	iny	iny	lda [<@temp],y	sta <@nameCount+2	clc	;point @temp at the entries	lda <@temp	adc #6	sta <@temp	bcc @t2	inc <@temp+2@t2@searchForEnd	lda <@nameCount	cmp <@nameIndex	bne @notAtEnd	lda <@nameCount+2	cmp <@nameCount+2	beq @foundTheEnd@notAtEnd	ldy #4	;offset to pstring in one entry	lda [<@temp],y	and #$00ff	clc	adc #5	adc <@temp	sta <@temp	bcc @t3	inc <@temp+2@t3	inc <@nameIndex	bne @searchForEnd	inc <@nameIndex+2	bne @searchForEnd@foundTheEnd*** fill in whichID and name	lda <@whichID	sta [<@temp]	ldy #2	lda <@whichID+2	sta [<@temp],y	pei <@theName+2	pei <@theName	;source	clc	ldx <@temp+2	lda <@temp	adc #4	bcc @t1	inx@t1	phx	pha	;dest	lda [<@theName]	and #$00ff	inc a	pea 0	pha	;length	_BlockMove*** increment the name count	ldy #2	lda [<@realNameHndl],y	sta <@temp+2	lda [<@realNameHndl]	sta <@temp	lda [<@temp],y	;low word of name count	inc a	sta [<@temp],y	bne @ncOK	iny	iny	lda [<@temp],y	inc a	sta [<@temp],y@ncOK*** mark the rResName resource changed	pea $ffff	;true	pea $8014	;rResName	pea $0001	;high word of rResName ID	pei <@whichType	_MarkResourceChange	tax	bra @outtaHere@nullName	ldx #0	;no error@outtaHere	phx	;save error code	pei <@saveCurrent	_SetCurResourceFile	pha	;space for result	pei <@maxDepth	_SetResourceFileDepth	pla	;ignore result	plx	;retrieve error code@exit	clc	tsc	adc #@oldD-1	tcs	pld	ldy #10	;number of bytes to strip	jml $e10184	;ToStrip*********************************************************************************** $2E1E OpenResourceFileByID -- new call 14-Jul-92 DAL for 6.0.1** Inputs:*   WORD  Space for old curResourceApp*   WORD  requested access*   WORD  user ID** This call tries to start the Resource Manager for you--if it's a dupStartup,* that's okay, we don't care.  (We still make you the current resource app.)** Then it finds out your pathname using LGetPathname2 and calls OpenResourceFile* for you.** The return value is the old curResourceApp, *not* the fileID we just opened.**********************************************************************************OpenResourceFileByID@oldD	equ 1@rtl	equ @oldD+2@userID	equ @rtl+6@reqAccess	equ @userID+2@oldCurApp	equ @reqAccess+2	phd	tsc;;;	sec;;;	sbc #@oldD-1;;;	tcs	tcd	pea 0	;paranoia	_GetCurResourceApp	pla	sta <@oldCurApp	;always return valid oldCurApp	pei <@userID	_ResourceStartUp	;resDupStartUp error is okay	pei <@userID	_SetCurResourceApp	bcs @error	;error here is not okay	pha	pha	;space for LGetPathname2	pei <@userID	pea 1	;file number	_LGetPathname2	plx	ply	bcs @error	pha	;space for OpenResourceFile	pei <@reqAccess	lda #0	pha	pha	;map pointer = NIL	phy	phx	;name from LGetPathname2	_OpenResourceFile	plx	;discard resulting fileID	bcs @error@noError	lda #0@error	tax;;;	clc	;error code in X;;;	tsc;;;	adc #@oldD-1;;;	tcs	pld	ldy #4	;number of bytes to strip	jml $e10184	;ToStrip;================================================================================================;=;= Description: Walks the specified resource file, removing all free spaces;=              except the last. The last is a special indicator of the maximum;=              size the file can grow to, so it's not actual space on disk.;=;=              For each free block in the file, all resources below it (toward;=              the EOF) until the next free block are moved toward the start of;=              the file. If the file map falls within one of the ranges to be moved,;=              it will be relocated, and the file header will be updated to indicate;=              its new location.;=;=;= Inputs: PUSH:WORD - flags.;=         PUSH:WORD - fileID.;=;=         The parameter 'fileID' is a fileID of an open resource file in the current;=         application's search path. All bits in the flags word are currently reserved and;=         must be set to zero.;=                  ;=         NOTE: In this version, the file must be opened for reading;=               and writing. No checking is made to ensure that it can be;=               written to.;=                  ;=;= Errors: Carry set if error, Accumulator = error code:;=;=       resFileNotFound - the specified resource file was not found;=       invalidAccess - if the file is not opened with write access;=       GS/OS errors - return unchanged;=       Memory Manager errors - return unchanged;=                   ;= Ext. Refer: None.;=;= Entry Points: None.;=;================================================================================================	IF JimsExperiment THENCompactResourceFile	NAMEreadWriteBufSize	equ 16*1024@fileID	equ inputs		;caller inputs on stack@flags	equ @fileID+2@theFileID	equ work		;used by findFileID@recordsToWalk	equ @theFileID+2@bytesThisChunk	equ @recordsToWalk+2	;MUST be here to use fileRead1@blockSize	equ @bytesThisChunk+4@moveRangeStart	equ @blockSize+4		;also used as dest file mark@sourceFileMark	equ @moveRangeStart		;alias used by crunch write code@moveRangeEnd	equ @moveRangeStart+4	;also used as source file mark@destFileMark	equ @moveRangeEnd+4@bufferHand	equ @destFileMark+4@bytesToMove	equ @bufferHand+4@localSize	equ @bytesToMove+4		;size of local direct page	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF		jsr startCall		;allocate direct page, set <data                    stz <@bufferHand+1                    stz <@bytesThisChunk+2	;never larger than 64K	lda <@fileID		;the file to compact is referenced via open file ID	jsr findFileID		;find the map that matches the given file ID (in Acc)	bcc @canWeWrite		;found the file, see if we can write to it@exitCannotWrite	brl @exitWithErrorY		;not found? y = resFileNotFound@canWeWrite	jsr isFileWriteable		;can we eventually write to this file?	bcs @exitCannotWrite	; apparently not (returns invalidAccess error)		jsr lockMap	jsr setFileRefNum		;update PBs refNum for this file	ldy #mapFileNum		;pass the file ref num to the read code	lda [<mapPtr],y	ldy #readBlock+readRefNum	sta [<data],y                           ldy #EOFBlock+EOFRefNum 	;and also to the EOF code                    sta [<data],y* If the number of used entries in the free list is only one, then we assume* that it's the final entry which indicates the maximum EOF. If it is only one,* then we have nothing to do. Actually, we do have something to do. We need to* set the EOF to the offset of this special free block. That way, if a resource* was deleted from the end of the file with RemoveResource, we shrink the EOF* to account for its removal.	ldy #mapFreeListUsed	lda [<mapPtr],y		;how many entries?	dec a		; just one?                    beq @shrinkTheEOF	sta <@recordsToWalk		;number of free records to process* Just so we don't waste any time, let's see if we can get a block for our* read/write buffer. If we can't, then there is no reason to waste time trying* to move the free blocks, because we won't have a transfer buffer anyway.	lda #readWriteBufSize	jsr allocateHand1	bcc @gotBufferOK		brl @exitWithErrorAcc@gotBufferOK	sta <@bufferHand	stx <@bufferHand+2	ldy #handAttr		;lock down our buffer	lda [<@bufferHand],y	ora #attrLocked	sta [<@bufferHand],y* Get the offset (file mark) to the free block we want to remove. Since we* delete the free blocks as we loop through, the current free block is always* the first in the list.@doThisFreeBlock	ldy #mapFreeList+blkOffset 	;start with the first free block	jsr getMapLong	sta <@moveRangeStart	sta <@destFileMark	stx <@moveRangeStart+2	stx <@destFileMark+2* Calculate blockOffset+blockSize. This is the beginning search range for the* resources that we need to move up toward the top of the file (away from the* EOF).	ldy #mapFreeList+blkSize	jsr getMapLong	sta <@blockSize	clc	adc <@moveRangeStart	sta <@moveRangeStart	txa	sta <@blockSize+2	adc <@moveRangeStart+2	sta <@moveRangeStart+2* Now we calculate the end search range. This is the start offset of the next* free block in the list.	ldy #mapFreeList+blkRecSize+blkOffset	jsr getMapLong	sta <@moveRangeEnd	stx <@moveRangeEnd+2* Now that we have the resource move bounds, walk the entire resource reference* list, moving the resources up as necessary. We'll actually move the entire* disk chunk up in one move, but we still need to update the new offsets into* each resource reference record that falls within the range. We need to walk* the entire resource list because resources are ordered by increasing type and* ID, not offset into file. We never can tell when a resource will fall within* our search range unless we actually look at it. After we're done with the* resources, we also do something similar for the map.@findResourceToMove	lda #@moveResInRange	;pass routine to call	jsr WalkResources		;walk every resource in the map	jsr @moveMapInRange	jsr @crunchDiskFreeSpace 	;remove this hole on disk	bcs @exitCompactFile* I need to essentially cascade the newly freed space down the free list so it* will finally be added to the EOF free block. We need to increase its blkSize* by the size of this block, and decrease its blkOffset by the same amount.@crunchWasSuccessful lda <@blockSize	ldx <@blockSize+2	ldy #mapFreeList+blkRecSize+blkOffset	jsr subToMapLong2	lda <@blockSize	ldx <@blockSize+2	ldy #mapFreeList+blkRecSize+blkSize	jsr addToMapLong2	ldy #mapFreeList		;always delete the first block	jsr deleteBlock		;delete the block indexed in Y	dec <@recordsToWalk	bne @doThisFreeBlock	;more blocks to move@fixupHeader	jsr @setNewMapOffset	;write file header to disk	bcs @exitCompactFile	jsr markDirtyMap		;mark map as needing to be updated* Ok. We're done moving the data up and the free blocks out. To finally reclaim* the lost space we need to shrink the EOF by the number of bytes we removed.@shrinkTheEOF	ldy #mapFreeList+blkOffset	jsr getMapLong		;get in x/a	ldy #EOFBlock+EOFDisplacement	sta [<data],y	iny	iny	txa	sta [<data],y	jsr pushEOFBlock	PushWord #SET_EOF	jsl GS_OS@exitCompactFile	pha		;save possible error code	jsr unlockMap		;leave map unlocked                    lda <@bufferHand+1		;did we allocate a file buffer?                    beq @exitCompactFile2	; apparently not, so don't dispose it                    pei <@bufferHand+2		;nuke our read/write buffer block	pei <@bufferHand	_DisposeHandle	@exitCompactFile2	pla		;restore the original error, if any@exitWithErrorAcc	tay@exitWithErrorY	brl pop4_Err		;strip input parameters and exit********************************************************************************** CrunchDiskFreeSpace - NOTE: Although <bytesThisChunk is a long, we never will*                             try to read more than 16K in the current*                             implementation. Since this is less than 64K, we*                             can simplify some math below.*@crunchDiskFreeSpace NAME	lda <@moveRangeEnd	sec	sbc <@moveRangeStart	sta <@bytesToMove	lda <@moveRangeEnd+2	sbc <@moveRangeStart+2	sta <@bytesToMove+2	* First we set the file mark to the beginning of the chunk of data that we need* to start reading at. As we move through this chunk, the mark will move toward* the EOF.@moveNextSubChunk	lda <@sourceFileMark	ldx <@sourceFileMark+2	jsr setFileMark2		;set absolute file mark to source chunk	bcs @exitMoveChunk* Let's see if we can read the entire move range into our buffer. If we can't,* we need to do it in chunks no larger than 16K.	ldx <@bytesToMove+2	bne @useFullBuffer		;we can't read more than 16K	lda <@bytesToMove	cmp #readWriteBufSize+1	blt @setRequestCount@useFullBuffer	lda #readWriteBufSize@setRequestCount	sta <@bytesThisChunk	ldy #2		;give the read code a dest pointer	lda [<@bufferHand],y	tax	lda [<@bufferHand]	jsr fileRead1		;read this part of the chunk	bcs @exitMoveChunk	lda <@destFileMark	ldx <@destFileMark+2	;destination towards the top of the file	jsr setFileMark2		;set absolute file mark to dest chunk	bcs @exitMoveChunk	pha		;if we got no error above, a=0 (saves a byte)	pei <@bytesThisChunk	ldy #2		;give the write code a pointer	lda [<@bufferHand],y	tax	lda [<@bufferHand]	jsr fileWrite2	bcs @exitMoveChunk* Setup the value for the next write displacement.	lda <@destFileMark	clc	adc <@bytesThisChunk	sta <@destFileMark	bcc @calcNextReadMark	inc <@destFileMark+2* Now setup the value for the next read displacement.@calcNextReadMark	lda <@sourceFileMark	clc	adc <@bytesThisChunk	sta <@sourceFileMark	bcc @checkRemainingBytes	inc <@sourceFileMark+2* Now lets figure out if we have any more bytes to read and write.@checkRemainingBytes lda <@bytesToMove	sec	sbc <@bytesThisChunk	sta <@bytesToMove	bcs @checkForZippy	dec <@bytesToMove+2@checkForZippy	ora <@bytesToMove+2	bne @moveNextSubChunk	clc@exitMoveChunk	rts;----------------------------------------------------------------------; Updates resource offsets if the resource is within the specified range.;----------------------------------------------------------------------;;   IN: <mapPtr = pointer to locked map.; <mapHand = handle	of locked map.; <resPtr = pointer	to resource to check.; <moveRangeStart = beginning of search range; <moveRangeEnd = end of range to search;;  OUT: Carry is always clear.;@moveResInRange	NAME	ldy #resOffset+2	lda [<resPtr],y	tax	dey	dey	lda [<resPtr],y	jsr @generalBoundsCompare	bcs @checkNextResource* This resource has fallen within the move range. We need to update its* resOffset field. The new value is: resOffset - blockSize.	lda [<resPtr],y		;resOffset	sec	sbc <@blockSize	sta [<resPtr],y	iny	iny	lda [<resPtr],y		;resOffset+2	sbc <@blockSize+2	sta [<resPtr],y@checkNextResource	clc		;force the entire file to be searched	rts***********************************************************************************@generalBoundsCompare NAME* Check if less than start offset	cpx <@moveRangeStart+2	blt @notInRange	bne @checkRangeLow	cmp <@moveRangeStart	blt @notInRange* Check if greater than the end offset@checkRangeLow	cpx <@moveRangeEnd+2	blt @withinRange	bne @notInRange	cmp <@moveRangeEnd	blt @withinRange	bge @notInRange@withinRange	clc	rts@notInRange	sec	rts***********************************************************************************@moveMapInRange	NAME	ldy #mapOffset	jsr getMapLong		;get in x/acc	jsr @generalBoundsCompare	bcs @mapNotInRange;	ldy #mapOffset		;contains proper val from above	lda [<mapPtr],y		;mapOffset	sec	sbc <@blockSize	sta [<mapPtr],y	iny	iny	lda [<mapPtr],y		;mapOffset+2	sbc <@blockSize+2	sta [<mapPtr],y@mapNotInRange	rts***********************************************************************************@setNewMapOffset	NAME* %%% This code was ripped from allocateFileMap, so it might be able to become a util sub. Or not.	lda #rFileToMap		;mark low	ldx #^rFileToMap		;always zero	phx		;bytes to write high	jsr setFileMark2	PushWord #8		;bytes to write	ldx <mapPtr+2	lda <mapPtr	clc	adc #mapOffset	bcc @noInc	inx@noInc	jsr fileWrite2	rts	ENDIF		;JimsExperiment;********************************************************************************;   Debugging routines.;********************************************************************************	IF  deBug THEN	INCLUDE 'resDebugCode.a'	ENDIF;*******************************************************************************************;**;**   Resource Manager common routines.;**;*******************************************************************************************;=======================================================; Verify that we have read/write access on the current file;=======================================================;;   IN: <mapPtr = pointer to map to be written.;;  OUT: Carry set if we can't write, y = invalidAccess.; Carry clear if file was opened read/write.;; NOTE: The X-Register is preserved across this function; the Accumulator and Y-Registers are destoryed.;isFileWriteable	NAME	ldy #mapFlag		;we'll check bit 0 - fileReadWrite	lda [<mapPtr],y		ldy #invalidAccess		;get an error code ready (only valid if carry is set)		eor #$0001		;its state is opposite that of the carry which 	lsr a		; we return it in	rts;=======================================================; Make sure there are enough free records.;=======================================================;;  OUT: Carry set if error, y = error code.; Carry clear if enough records, y = TRUE if map had to be grown for new records.;ckFreeRecords	ldy #mapFreeListUsed	Are there at least 6 spots available?	lda [<mapPtr],y	clc	adc #5	ldy #mapFreeListSize	cmp [<mapPtr],y	bcs @grow	ldy #0		Map didn't grow.	clc Enough		records.	rts;@grow	jsr growFreeList		Resize map, insert zeros.	bcs @errorExit		Error?	ldy #1		Map had to be grown.@errorExit	rts;=================================; Write map to disk.;=================================;;   IN: <mapPtr = pointer to map to be written.; <mapHand = handle	of map.;writeMap;; ------ Reallocate	map in file if size	changed.;	ldy #mapOffset		;Check if map is currently allocated in file.	lda [<mapPtr],y	iny	iny	ora [<mapPtr],y	bne @ok1	ldy #handSize+2		;Reallocate map in file.	lda [<mapHand],y		;Pass new size.	tax	dey	dey	lda [<mapHand],y	jsr allocateFileMap		;Allocate space in file for map.@ok1;; ------ Set file position mark.;	ldy #mapOffset		;Pass offset of map in file.	jsr getMapLong		;x/a = mapOffset field.	jsr setFileMark2		;Set file mark to write pos (absolute displacement).	bcc @ok2	tay		;Put possible error code in Y for return.	rts;; ------ Do write.;@ok2	ldy #mapSize		;Pass index to field to push.	jsr pushMapLong		;Push mapSize field, number of bytes to write.	ldx <mapPtr+2		;Pass pointer to data to write.	lda <mapPtr	jsr fileWrite2		;Write map to file.	File is dead if this fails.;;; --- FALL THROUGH:	Set mapChanged bit to 'not changed'.;;;---------------------------------------------------------------------------------------------; Clear map dirty bit to show map is unchanged and need not	be written to disk.;---------------------------------------------------------------------------------------------;;   IN: <mapPtr = pointer to dirty map.;;  OUT: None.;markCleanMap	ldy #mapFlag	lda [<mapPtr],y	and #_mapChanged		;Set dirty bit in map's flag.	sta [<mapPtr],y	ldy #0	clc	rts;============================================================; Get index to current converter list handle.;============================================================;;  OUT: y = index to current converter list.; x/a = handle of current converter list.;getCurConList	ldy #curApp		;Compute index to current converter list	handle.	lda [<data],y	clc	adc #appConverters+2	tay	lda [<data],y		;Return handle of current converter list.	tax	dey	dey	lda [<data],y	rts;===============================================================; Walk every open file starting with first file.;===============================================================;;   IN: a = address	of routine to call for each file.;;  OUT: Carry set if walk aborted.;walkAllFiles	pha	lda #$FFFF		;Search all.	jsr setFileDepth	plx	pha		;Save original depth.	txa		;Pass routine to call.	jsr walkMapsFirst	pla		;Restore file depth.	php		;Save carry flag.	phy		;Save Y.	jsr setFileDepth	ply 		;Restore Y.	plp		;Restore carry flag.	rts;;;================================================================================================;  Count number of different types in open files.;================================================================================================;;  OUT: Carry set if error, y = Memory Manager error code.; Carry clear if no	error:;  <work = number of different tyeps.;  <work+2 = handle	of hash table.;  <work+6 = pointer to hash table.;countResTypes;@numOfTypes	equ work@hashHandle	equ @numOfTypes+2@hashPtr	equ @hashHandle+4;;; --- Allocate hash	table.;	lda #8*1024		Allocate 64k bit table.	jsr allocateHand1	bcs @exit	sta <@hashHandle		Store handle of hash table.	stx <@hashHandle+2;	ldy #2		Dereference handle.	lda [<@hashHandle],y	tax	lda [<@hashHandle]	sta <@hashPtr	stx <@hashPtr+2;	ldy #(8*1024)-2		Zero hash table.	lda #0@lop1	sta [<@hashPtr],y	dey	dey	bpl @lop1;	stz <@numOfTypes		Start with no types.;;; --- Build type hash table.;	lda #@count1	jsr walkMapsCur		Count, starting in current file.;     No error, clear carry from walkMapsFirst.@exit	rts;;;-------------------------------------------; Build types hash table.;-------------------------------------------;;   IN: <@hashPtr =	pointer to hash table.;@count1	lda #@count2	brl walkResources;@count2	lda [<resPtr]		Get type.	lsr a		Compute index to byte.	lsr a	lsr a	tay	lda [<resPtr]		Compute index to bit.	and #$0007	tax	sep #$20	LONGA OFF	lda [<@hashPtr],y		Has this type already been counted?	and bits,x	bne @skip100	lda [<@hashPtr],y	ora bits,x	sta [<@hashPtr],y;	ldx <@numOfTypes		Increment number of	different types.	inx	stx <@numOfTypes;@skip100	rep #$20	LONGA ON	clc		;Continue walk.	rts;================================================================================================; Free hash table.;================================================================================================;;   IN: <work+2 = handle of hash table.;freeTypeHash	pei <work+4		Pass handle of hash	table.	pei <work+2	_DisposeHandle	rts;================================================================================================; Get read flag.;================================================================================================;;  OUT: BNE if reading on.; a = original value.;getReadFlag	lda #$FFFF;;;------------------------------------------------------------------------------------------------; Set new read flag.;------------------------------------------------------------------------------------------------;;   IN: a = new flag, negative to just return current value.;;  OUT: a = original value.; BNE if reading on.;setReadFlag	pha		;Save given.;	ldy #curApp		;Save current.	lda [<data],y	clc	adc #appReadFlag	tay	lda [<data],y	tax	pla	bmi @exit		;Just return value?	sta [<data],y		;Store new value.@exit	txa		;Return original value.	rts;;;================================================================================================; Get search file depth.;================================================================================================;;  OUT: a = number of files to search.;getFileDepth	lda #0		Just return value.;;;------------------------------------------------------------------------------------------------; Set new file depth.;------------------------------------------------------------------------------------------------;;   IN: a = new depth, 0 to just return	current value.;;  OUT: a = original depth.;setFileDepth	pha		;Save given.;	ldy #curApp		;Save current.	lda [<data],y	clc	adc #appFileDepth	tay	lda [<data],y	tax	pla	beq @exit		;Just return value?	sta [<data],y		;Store new value.@exit	txa		;Return original value.	rts;================================================================================================; Load a resource.;================================================================================================;;   IN: x/a = max size to load.; <resPtr = pointer	to resource, map must be locked.; <mapPtr = pointer	to resource's locked map.;;  OUT: x/a = handle of loaded resource, NIL if none.; If reading resources is off:;  Resource handle returned if already read into memory.;  Purged handle returned if read into memory but purged.;  Empty handle returned if resource not yet read into memory.; Carry set if error, y = Memory Manager errors, GS/OS errors.;loadRes;@resHand	equ work		Local direct page use.@sizeOfRes	equ @resHand+4		!!!Must be work+4!!!!@openRefNum	equ @sizeOfRes+4@localSize	equ @openRefNum+2		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;	sta <@resHand		Temp save place for	max load size.	stx <@resHand+2;	ldy #resSize+2		Get resource size, common need.	lda [<resPtr],y	sta <@sizeOfRes+2	dey	dey	lda [<resPtr],y	sta <@sizeOfRes;;; --- Check if handle field is an absolute address.;	ldy #resAttr		Does resource have an absolute address?	lda [<resPtr],y	and #resAbsLoad	beq @ok3;	lda <@sizeOfRes+2		If max size is smaller than resource size,	cmp <@resHand+2		only load max size.	bcc @ok5	bne @loadMax	lda <@sizeOfRes	cmp <@resHand	bcc @ok5@loadMax	lda <@resHand	sta <@sizeOfRes	lda <@resHand+2	sta <@sizeOfRes+2;@ok5	ldy #resHandle+2		Pass absolute address of resource.	lda [<resPtr],y	tax	dey	dey	lda [<resPtr],y	brl readRes;;; --- Check if the resource already loaded.;@ok3	ldy #resHandle+1		Does it have a valid handle?	lda [<resPtr],y	beq @allocateIt	iny	lda [<resPtr],y	sta <@resHand+2		Return possible handle.	dey	dey	lda [<resPtr],y	sta <@resHand;	jsr getReadFlag	bne @ok1		Reading off?	brl @exit		Done if reading is off.;;; --- Reallocate the purged handle.;@ok1	ldy #handPointer+1		Has the resource been purged?	lda [<@resHand],y	beq @ok2	brl @exit		If not, resource is	ready.;@ok2	pei <@sizeOfRes+2		Pass number of bytes to allocate.	pei <@sizeOfRes	ldy #curApp		Pass user's ID.	lda [<data],y	clc	adc #appID	tay	lda [<data],y	pha	ldy #resAttr		Pass attributes.	lda [<resPtr],y	and #resMemAttr	pha	pea 0		Pass address to allocate at.	pea 0	pei <@resHand+2		Pass handle to reallocate.	pei <@resHand	_ReAllocHandle	bcc @enter1	tay		Return error in Y.	brl @errExit;  ;; ------ Allocate memory for the resource.;@allocateIt	pha		Space for result.	pha	jsr getReadFlag	bne @ok4		No reading?	pea 0		Allocate an empty handle.	pea 0	bra @skip1@ok4	pei <@sizeOfRes+2		Pass number of bytes to allocate.	pei <@sizeOfRes@skip1	ldy #curApp		Pass user's ID.	lda [<data],y	clc	adc #appID	tay	lda [<data],y	pha	ldy #resAttr		Pass attributes.	lda [<resPtr],y	and #resMemAttr	pha	pea 0		Pass address to allocate at.	pea 0	_NewHandle	ply	sty <@resHand	ply	sty <@resHand+2	tay		Possible error in Y.	bcs @errExit;	ldy #resHandle		Store resource's handle in its index reference.	lda <@resHand	sta [<resPtr],y	iny	iny	lda <@resHand+2	sta [<resPtr],y;;; --- Read the resource.;	jsr getReadFlag		Reading on or off?	beq @exit;@enter1	ldy #4		Lock resource handle.	lda [<@resHand],y	ora #$8000	sta [<@resHand],y;;      Pass #bytes to read in <work+4 (<@sizeOfRes).	ldy #handPointer+2	lda [<@resHand],y	tax	lda [<@resHand]		;Pass pointer to read buffer in x/a	jsr readRes		;Read resource.	tyx		;Save error code.;	ldy #resHandle		copy the handle back from the resrec	lda [<resPtr],y		since it could have	been changed by the	sta <@resHand		read call if the resource was type	iny		that gets converted.	iny	lda [<resPtr],y	sta <@resHand+2;	ldy #resAttr		Is resource to be locked in memory?	lda [<resPtr],y	and #$8000	bne @skip2		Leave locked?;	ldy #4		Leave resource handle unlocked.	lda [<@resHand],y	and #$7FFF	sta [<@resHand],y;@skip2	txy		Restore error code.	beq @exit		Error from read?;	phy		Save read error code.;	pei <@resHand+2		Pass resource handle that I allocated	pei <@resHand		or reallocated.	_PurgeHandle		I'll leave the handle but wipe the data.*** 25-Jul-91 DAL -- if *anything* goes wrong purging the handle, dispose it forcefully; cmp #$0205		No purgable?; bne @skip3	bcc @skip3*** end 25-Jul-91 DAL	jsr freeRes		If cannot purge'em, blow'em away.	stz <@resHand		No resource left.	stz <@resHand+2;@skip3	ply		;Restore read error code.	bra @errExit;@exit	ldy #0		No error.;@errExit	lda <@resHand		Return handle.	ldx <@resHand+2	cpy #1		Set error flag.	rts;;;==========================================; Read resource into memory.;==========================================;;  IN: x/a = address to read resource into.; <work+4 = number of bytes to read.; <mapPtr = pointer	to locked map.; <resPtr = pointer	to resource to load.;;  OUT: Carry set if error, y = error code.;readRes	phx		Save address to read resource into.	pha;;; --- Set file mark	to resource.;	ldy #mapFileNum		Pass open file ref number of file resource is in.	lda [<mapPtr],y	pha		Save.	jsr setMarkBase0		Use absolute displacement.;	ldy #resOffset+2		Get file offset of resource.	lda [<resPtr],y	tax	dey	dey	lda [<resPtr],y		Pass file offset in	x/a.	ply		;Pass open file reference number in Y.	jsr setFileMark1		Set file mark to start of map.	bcc @ok1		GS/OS error?	tay		;Error in Y.	pla	pla	rts;;; --- Set up for file read.;@ok1	ldy #mapFileNum	lda [<mapPtr],y	ldy #readBlock+readRefNum	Pass open file reference number to read.	sta [<data],y;	ldy #readBlock+readData	Pass pointer to read buffer.	pla	sta [<data],y	iny	iny	pla	sta [<data],y;	ldy #readBlock+readSize	Pass number of bytes to read.	lda <work+4	sta [<data],y	iny	iny	lda <work+6	sta [<data],y;*** added 5-Apr-91 DAL -- for zero-length resources, address will be nil; don't try to read	ldy #readBlock+readData+1	lda [<data],y	bne @continue	tay	clc	rts		;return A&Y=0+CLC (no error)@continue*** end of 5-Apr-91 DAL;; ------ Have converter do read.;	ldy #resAttr		Does this resource need a converter?	lda [<resPtr],y	and #resConverter	beq @skip1;	lda #0		Pass read flag.	brl callConverter;;; ------ Read from file, no converter.;@skip1	jsr pushReadBlock		Pass pointer to read file parameter block.	pea READ		Pass call number.	jsl GS_OS		Read file header.	tay		;Error in Y, just in case.	rts;;;=======================================; Call resource converter.;=======================================;;   IN: a = 0 if read, 2 if write.; <resPtr = pointer	to locked resource reference.; |readBlock = parameters for read if reading.; |writeBlock = parameters for write if	writing.;;  OUT: Carry set if error, y = error code.; x/a = result.;callConverter	pha		Flag.	jsr getConverterAddr	ply		;Get flag.	bcc @ok1;	bne @errorOut		Doing read?;	ldy #resHandle+2		Dispose of resource	handle.	lda [<resPtr],y	pha	dey	dey	lda [<resPtr],y	pha	lda #0	sta [<resPtr],y	iny	iny	sta [<resPtr],y	_DisposeHandle;@errorOut	ldy #resNoConverter		;Return error code.	bra @exit;@ok1	phx		;Save address, also space for result.	pha	phy		;Pass flag to converter.	tyx	jsr (@read_write,x)		Pass GS/OS parameter block.	pei <resPtr+2		Pass pointer to resource reference.	pei <resPtr;@resPtr	equ 1@param	equ @resPtr+4@flag	equ @param+4@result	equ @flag+2;	lda @result+2,s		Get converter address.	tax	lda @result,s	jsl longCall		Call converter routine.	tay		;Place error code in y.	pla		Get result.	plx;@exit	cpy #1		Set error flag.	rts;@pushNull	plx		;Push a long just to keep the stack correct.	pha	pha	phx	rts;@read_write	dc.w pushReadBlock	dc.w pushWriteBlock	dc.w @pushNull;;;=====================================; Get converter address.;=====================================;;   IN: <resPtr = pointer to resource record.;;  OUT: Carry set if converter not found.; Carry clear if converter found, x/a =	converter address in longCall format.;getConverterAddr	pei <work+4		Save.	pei <work+2	pei <work;	stz <work+4		Initialize number of times to try.	inc <work+4;	jsr getCurConList		x/a = handle of converter list.@lop2	sta <work	stx <work+2	lda <work+1		Is there a list?	beq @errOut;	ldy #2		Dereference list.	lda [<work],y	tay	lda [<work]	sta <work	sty <work+2;	lda [<work]		Number of records to search.	tax	ldy #convertList@lop1	lda [<resPtr]		Get type to find.	cmp [<work],y		Match?	beq @gotit	tya		;Next record.	clc	adc #convertRecSize	tay	dex		;Any more records	bne @lop1;@errOut	dec <work+4		Have I tried the system converter list?	bmi @notFound;	ldy #sysConvertList+2	Try system converter list.	lda [<data],y	tax	dey	dey	lda [<data],y	bra @lop2;@notFound	sec		;Converter not found flag.	bra @exit;;;  <work = pointer to converter list.;  y = index to convert record.;@gotit	iny	iny	iny	lda [<work],y	tax	dey	lda [<work],y	clc		;Converter found flag.;@exit	ply		;Restore.	sty <work	ply	sty <work+2	ply	sty <work+4	rts;;;===========================;       Long call.;===========================;;   IN:    x = middle WORD (bits 8-23) of address of destination routine.;          a = low WORD of address of destination routine.;;  OUT:    Calling this routine is the same as:;;                jsl   (ax);;          Where the low byte in 'a' is	the low byte of the	destination;          address,	and x = the next 2 bytes of the destination address.;longCall	dec a		Make low word look like a return address.;                 !!! High byte of address is not decremented;	 because the program counter doesn't wrap;	 to the next bank!!!!	phx		Push the high byte.	tsx		Leave only the high byte of the address.	inx	txs;	pha		Push the low word of the address.	rtl Go		to the address.;;  When the routine	called returns, it will return to the routine that called ;  'longCall', not here.;;	EJECT;================================================================================================; Compute pointer to a resource.;================================================================================================;;   IN: <inputs = ID.; <inputs+4 = type.;;  OUT: Carry set if resource found, <resPtr = pointer to resource.; Carry clear if resource not found, y = resNotFound.;findGivenRes1	ldy <inputs		Pass ID.	ldx <inputs+2	lda <inputs+4		Pass type.;findGivenRes2	sty <work		Pass ID.	stx <work+2	sta <work+4		Pass type.;	lda #findResource		Pass address of routine to find.	jsr walkMapsCur		Search maps starting with current map.	bcs @exit		Was the resource found?;	ldy #resNotFound		Return resource not	found error.@exit	rts;;	EJECT;=====================================================================================; Write resource to	disk if changed bit	set. Called from walkResources.;=====================================================================================;;   IN: <mapHand = handle of locked map.; <mapPtr = pointer	to map.; <resPtr = pointer	to resource reference record in resource index.; writeBlock+writeRefNum = open file reference number.; markBlock+markRefNum = open file reference number.; marlBlcok+markBase = 0 (absolute displacement).;;  OUT: Carry clear	if no errors, <work	= NIL.; Carry set if error, <work = GS/OS error code or $FFFF if more free records needed.;	writeRes	NAME;@resHand	equ work		Local direct page use.@sizeOfHand	equ @resHand+4@resAddr	equ @sizeOfHand+4@localSize	equ @resAddr+4		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;; --- Check if resource has changed and	is not protected.;	ldy #resAttr		Get resource flags.	lda [<resPtr],y	and #resChanged+resProtected	Has resource changed or protected?	cmp #resChanged	bne @toClearChg		If unchanged or changed and protected, skip.;;; --- Write resource to disk.;	ldy #resHandle+1		Is the resource in memory?	lda [<resPtr],y	bne @ok5@toClearChg	brl @clearChg		If not, it is already updated.;@ok5	sta <@resHand+1		Handle of resource.	dey	lda [<resPtr],y	sta <@resHand;;; ------ Write resource from absolute address.;	ldy #resAttr		Is handle really an	absolute address?	lda [<resPtr],y	and #resAbsLoad	beq @ok3;	jsr setOffset		Set file offset for	write.	bcs @errorOut		Error? a = error code.;	ldy #resSize+2		Pass number of bytes to write.	lda [<resPtr],y	pha	iny	iny	lda [<resPtr],y	pha	lda <@resHand		Pass pointer to data to write.	ldx <@resHand+2	jsr writeRes2		Write resource to file.	tax		;Save possible error.	brl @exit1;;; --- Write resource from handle.;@ok3	ldy #handSize+2		Get size of handle,	common need.	lda [<@resHand],y	sta <@sizeOfHand+2	dey	dey	lda [<@resHand],y	sta <@sizeOfHand;	ldy #resAttr		Does this resource have a converter?	lda [<resPtr],y	and #resConverter	beq @skip1;	lda #4		Ask converter for destination size.	jsr callConverter	sta <@sizeOfHand		;this is really the on-disk size	stx <@sizeOfHand+2@skip1;;; ------ Resize resource if its size has changed.;	lda <@sizeOfHand+2	ldy #resSize+2		Has the size changed?	cmp [<resPtr],y	bne @resize	dey	dey	lda <@sizeOfHand	cmp [<resPtr],y	beq @ok2;@resize	jsr freeFileResource	Free the block used	by the resource.;	ldx <@sizeOfHand+2		Pass size to allocate.	lda <@sizeOFHand	jsr getFileBlock		Allocate file space	for resource.;	ldy #resOffset		Store new offset.	sta [<resPtr],y	iny	iny	txa	sep #$20	LONGA OFF	sta [<resPtr],y	rep #$20	LONGA ON;	ldy #resSize		Store new size.	lda <@sizeOfHand	sta [<resPtr],y	iny	iny	lda <@sizeOfHand+2	sta [<resPtr],y;;; ------ Set file position mark.;@ok2	jsr setOffset	bcc @ok1		;Error?@errorOut	sta <work		;Return error code in <work.	rts		;Carry set, stop walk.;;; ------ Do write.;@ok1	ldy #handAttr		Save the state of the handle.	lda [<@resHand],y	pha	ora #$8000		Lock the handle.	sta [<@resHand],y;*** 12-Jan-93 JCM - This code doesn't work correctly when used with converters, and especially those***	that make the disk-based resource smaller than in memory. Instead of getting the***	number of bytes to write from the size of the in-memory handle, we should get it***	from resSize in the resource reference record. And that's just what this fix does.;;;	ldy #handSize+2		Pass number of bytes to write.;;;	lda [<@resHand],y;;;	pha;;;	dey;;;	dey;;;	lda [<@resHand],y;;;	pha		pei <@sizeOfHand+2		;this really is the size of the resource when	pei <@sizeOfHand		; it's on-disk (see about 20 lines up)	*** end 12-Jan-93 JCM	ldy #handPointer+2		Pass pointer to data to write.	lda [<@resHand],y	tax	lda [<@resHand]	jsr writeRes2		Write resource to file.	tax		Save possible error.;	ldy #handAttr		Restore the state of the handle.	pla	sta [<@resHand],y;@exit1	stx <work		Return possible error code in <work.	cpx #1	bcs @exit101		Error from write?;;; ------ Clear changed flag.;@clearChg	ldy #resAttr		;Mark resource as unchanged.	lda [<resPtr],y	and #_resChanged	sta [<resPtr],y;;; ------ Check if more free records are	needed.;	ldy #mapFreeListUsed	;Are there at least 6 spots available?	lda [<mapPtr],y	clc	adc #5	ldy #mapFreeListSize	cmp [<mapPtr],y	bcc @exit100;	lda #$FFFF		;Tell call that more free records are needed.	sta <work	sec		;Stop walk.	rts;@exit100	clc		;Return 'continue walking' flag.	stz <work@exit101	rts;--------------------------------------------; Lowest level resource write.;--------------------------------------------;;   IN: x/a = address of data to write.; PUSH:LONG - size of write.; <resPtr = pointer	to resource.;;  OUT: a = error code.;;--------------------------------------------writeRes2	NAME	ldy #writeBlock+writeData	;Pass pointer to data to write.	sta [<data],y	iny	iny	txa	sta [<data],y;	plx		;Get return address.	ldy #writeBlock+writeSize	;Pass number of bytes to write.	pla	sta [<data],y	iny	iny	pla	sta [<data],y	phx 		;Put return address back.;*** added 5-Apr-91 DAL -- for zero-length resources, the address will be 0, so don't try to write	ldy #writeBlock+writeData+1	lda [<data],y	bne @continue	tay		;(paranoia)	clc		;(paranoia)	rts		;return A=0 (no error)@continue*** end of 5-Apr-91 DAL;; ------ Have converter do write.;	ldy #resAttr		Does this resource need a converter?	lda [<resPtr],y	and #resConverter	beq @skip1;	lda #2		Pass write flag.	jsr callConverter	tya		;Return error code in a.	rts;;; --- Write resource to disk.;@skip1	jsr pushWriteBlock		Pass pointer to write file parameter block.	pea WRITE		Pass call number.	jsl GS_OS		Write template to file.	rts;;;============================================; Set file offset of resource.;============================================;;   IN: <resPtr = pointer to resource.;;  OUT: Carry set if error, a = error code.;setOffset	ldy #resOffset+2		Pass offset of resource in file.	lda [<resPtr],y	tax	dey	dey	lda [<resPtr],y	brl setFileMark2		Set file mark to write position.;	EJECT 16;=========================================; Store a long in <resPtr.;=========================================;;   IN: y = offset to field.; x/a = value to store.;;  OUT: y = index to next field (given y + 4).;storeResPtrLong	sta [<resPtr],y	iny	iny	txa	sta [<resPtr],y	iny	iny	rts;	EJECT 14;===================================; Free <mapHand.;===================================;;   IN: <mapHand = handle to free.;disposeMapHand	pei <mapHand+2		Pass map's handle.	pei <mapHand	_DisposeHandle Free		map.	rts;;	EJECT;================================================================================================; Move index references down one record	to make room for another record.;================================================================================================;;   IN: <resPtr = place to insert new record.;;  OUT: <resPtr = same as in.;insertIndexRef	lda [<resPtr]		Is the record being	inserted at the end?	bne @ok3		If not, do move.;	ldy #resRecSize		Mark next record as	end.	sta [<resptr],y	rts;;@ok3	lda <resPtr		Place of insertion.	ldx <resPtr+2	phx		Save.	pha;	phx		Pass source pointer.	pha	clc	adc #resRecSize		Insert one record.	bcc @ok1	inx@ok1	phx		Pass destination pointer.	pha;@destination	equ 1@source	equ @destination+4;	ldy #mapIndexUsed		Pass offset to field.	jsr getMapLong	jsr computeResPtr		<resPtr = pointer to end mark.	lda <resPtr		Also move end mark.	clc	adc #2	bcc @store1	inc <resPtr+2@store1	sta <resPtr;	lda <resPtr	sec	sbc @source,s	tay	lda <resPtr+2	sbc @source+2,s	pha		Pass number of bytes to move.	phy	_MyBlockMove		Move remainder of records down.;	pla		Restore pointer to new record.	sta <resPtr	pla	sta <resPtr+2	rts;	EJECT;================================================================================================; Remove a resource	index reference.;================================================================================================;;   IN: <resPtr = pointer to resource index reference to be	removed.;;  OUT: None.;removeIndexRef;@firstRes	equ work		Local direct page use.@nextRes	equ @firstRes+4@localSize	equ @nextRes+4		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;;; --- Setup pointer	to resource and next resource.;	ldx <resPtr+2		Set pointer to first resource.	lda <resPtr	sta <@firstRes;@lop2	stx <@firstRes+2	lda <@firstRes		Compute index to next index reference record.	clc	adc #resRecSize	bcc @store1	inx@store1	sta <@nextRes	stx <@nextRes+2;;; --- Move resources up and over resource being deleted.;	ldy #resRecSize-2		!!! Don't use X !!!@lop1	lda [<@nextRes],y	sta [<@firstRes],y	dey	dey	bpl @lop1;	lda <@nextRes		Move to next resource.	sta <@firstRes		x still equals <@nextRes.;	lda [@nextRes]		Any more resource index references?	bne @lop2	rts;	EJECT 30;================================================================================================; Free the block used by the resource.;================================================================================================;;   IN: <resPtr = pointer to resource index reference.; <mapPtr = pointer	to locked map of file.;;  OUT: See outputs	of freeFileBlock.;freeFileResource	ldy #resSize+2		Pass current size.	lda [<resPtr],y	pha	dey	dey	lda [<resPtr],y	pha	ldy #resOffset+2		Pass block's offset.	lda [<resPtr],y	pha	dey	dey	lda [<resPtr],y	pha	jsr freeFileBlock		!!! Do not BRL or fall through, stack parameters !!!	rts;;;=================================================================; Free the block in	file.  This is a reentrant call.;=================================================================;;   IN: PUSH:LONG -	block's size.; PUSH:LONG - block's offset.; <mapPtr = pointer	to locked map of file.;;  OUT: None.; freeFileBlock;@merge	equ 1		Stack offsets.@prevBlock	equ @merge+2@nextBlock	equ @prevBlock+2@temp	equ @nextBlock+2@retAddr	equ @temp+4@blockOffset	equ @retAddr+2@blockSize	equ @blockOffset+4@localStackSize	equ @blockSize+4;;	pha		Space for temp.	pha	pha		Space for nextBlock.	pea 0		Space for prevBlock, start with no previous block.	pea 0		Space for merge, set 'no merge' flag to	start.;;; --- Find block's spot in free array.;	lda @blockOffset,s		Compute byte after block being freed.	clc	adc @blockSize,s	sta @temp,s	lda @blockOffset+2,s	adc @blockSize+2,s	sta @temp+2,s;	ldy #mapFreeList+2		Start with first free block.@lop1	lda [<mapPtr],y		Is this block after	block being freed?	dey	dey	cmp @blockOffset+2,s	bcc @next1	beq @ckLowWord	bra @gotit@ckLowWord	lda [<mapPtr],y	cmp @blockOffset,s	bcs @gotit;@next1	tya	sta @prevBlock,s		Save previous block	index.	clc	adc #blkRecSize+2	tay	bra @lop1		No check for end of	blocks because block being ;      freed can't be after last block.  If it does,;      life, as we know it, ends.;; --- Check to merge adjacent blocks.;;  y = index to next block.;  <@prevBlock = index to previous block, NIL if no previous.;@gotit	tya	sta @nextBlock,s		Save index to next block.;;; ------ Try to merge new block to next	block.;	lda @temp,s		Is end of new block	same as top of next	block?	cmp [<mapPtr],y	bne @next2	iny	iny	lda @temp+2,s	cmp [<mapPtr],y	bne @next2;	lda #1	sta @merge,s		Merge new block into next block.;	lda @nextBlock,s	tay	iny	iny	iny	iny		Pass index to blkSize field.	lda @blockSize+2,s		Pass new block size.	tax	lda @blockSize,s	jsr addToMapLong2		Add new block size to next block.;	lda @nextBlock,s		Pass index to blkOffset field.	tay	lda @blockSize+2,s		Pass new block size.	tax	lda @blockSize,s	jsr subToMapLong2		Subtrack new block size from next's offset.	bra @tryDouble		Try to merge previous block to next block.;;; ------ Try to merge new block to previous block.;@next2	lda @prevBlock,s		Compute bottom of previous block.	beq @newBlock		Is there a previous	block?	tay	jsr getPrevAfter		x/a = offset of byte after previous block.;;	cmp @blockOffset,s		Is end of previous block same as top 	bne @newBlock		of new block?	iny	iny	txa	cmp @blockOffset+2,s	bne @newBlock;	lda #1	sta @merge,s		Merge new block into next block.;	lda @prevBlock,s	tay	iny	iny	iny	iny		Pass index to blkSize field of previous block.	lda @blockSize+2,s		Pass new block size.	tax	lda @blockSize,s	jsr addToMapLong2		Add new block size to previous block.;;; ------ Try to merge previous block to	next block.;@tryDouble	lda @prevBlock,s		Compute bottom of previous block.	beq @toExit		Is there a previous	block?	tay	jsr getPrevAfter		x/a = offset of byte after previous block.;	pha	lda @nextBlock+2,s		Is end of previous block same as top	tay	pla	cmp [<mapPtr],y		of next block?	beq @ok2@toExit	brl @exit@ok2	iny	iny	txa	cmp [<mapPtr],y	bne @toExit;	lda @nextBlock,s	tay	iny	iny	iny	iny	jsr getMapLong		Pass size of next block.	pha		Preserve a-reg which contains lowWord of size of next block	lda @prevBlock+2,s	tay	pla	iny	iny	iny	iny		Pass index to blkSize field of previous block.	jsr addToMapLong2		Add next block size	to previous block size.;	lda @nextBlock,s		Pass index to block	to delete.	tay	jsr deleteBlock		Delete next block from array.	bra @exit;;; --- No merge, create new block.;@newBlock	ldy #mapFreeListSize	Are there any available spaces?	lda [<mapPtr],y	iny	iny	cmp [<mapPtr],y	bne @ok1;;; ------ Allocate more BLOCK records.;	jsr growFreeList		Grow the free list.;      Man-O-Man, calling this growFreeList can;      get you into	an infinite loop.  Then again,;      it could work.  Things are setup	so that this;      call should not have to happen.;; ------ Insert next block.;@ok1	ldy #mapFreeListUsed	Compute offset to word after in last used block.	lda [<mapPtr],y	asl a	asl a	asl a	clc	adc #mapFreeList	tay	adc #blkRecSize		Compute index to next block record.	tax@lop2	dey	dey	dex	dex	lda [<mapPtr],y		Move records down to make room for insert.	phy	txy	sta [<mapPtr],y	ply	tya	cmp @nextBlock,s		Done?	bne @lop2;	lda @blockOffset,s		Initialize new block record.	sta [<mapPtr],y	iny	iny	lda @blockOffset+2,s	sta [<mapPtr],y	iny	iny;	lda @blockSize+2,s	tax	lda @blockSize,s	jsr storeMapLong;	ldy #mapFreeListUsed	Increment number of	used allocation blocks.	lda [<mapPtr],y	inc a	sta [<mapPtr],y;;; --- Clean up stack and exit.;@exit	jsr markDirtyMap		Map has change, set	dirty bit so it'll ;   			be written to disk.;	lda @retAddr,s		Get return address.	tax;	tsc	clc	adc #@localStackSize-1	tcs;	phx		Put return address back.	rts;;	EJECT;================================================================================================; Find the map that	matches the given file ID.;================================================================================================;;   IN: a = file ID	to match to a map.;;  OUT: Carry set if not found:;  y = resFileNotFound.; Carry clear if map found:;  <mapPtr = pointer to map.;  <mapHand = handle of map (unlocked).;findFileID	sta <work		Pass file number to	@matchID.;	lda #@matchID		Pass routine to call for application's every map.	jsr walkAllFiles	bcs @exit		Was the map found?;	ldy #resFileNotFound	Return error.	sec		Error flag.	rts;@exit	clc		Match found flag.	rts;;;-------------------------------------------------------------; Match open file reference number.;-100---------------------------------------------------------;;   IN: <mapPtr = pointer to map.; <work = open file	reference number to	match.;;  OUT: Carry set if match.;@matchID	ldy #mapID		Is map's open file reference number the same	lda [<mapPtr],y	cmp <work		as the one passed?	beq @exit100		Carry set if equal.	clc@exit100	rts;	EJECT;================================================================================================; Search a map for a resource.;================================================================================================;;   IN: <mapHand = locked map.; <mapPtr = pointer	to map.; <work = resource ID to find.; <work+4 = type to	find.;;  OUT: See output from fall through code below.;findResource	ldy <work		Pass ID to find.	ldx <work+2	lda <work+4		Pass type.;;;-Fall-through------------------------------------------------------------;  Find a resource in the index.;-------------------------------------------------------------------------;;   IN: x/y = ID to	find.; a = type to find.; <mapPtr = pointer	to map.; <mapHand = handle	of map.;;  OUT: Carry clear	if not found, <resPtr = next higher resource index reference record.; Carry set if found, <resPtr = resource reference.;findResRec;; !!!! Variables cannot be added to work area without changing work areas in callers !!!@temp	equ work+6		Local direct page use.@half	equ @temp+4@num	equ @half+4@matchID	equ @num+4@matchType	equ @matchID+4@localSize	equ @matchType+2		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF; !!!! Variables cannot be added to work area without changing work areas in callers !!!;;	sta <@matchType	sty <@matchID	stx <@matchID+2;;; --- Binary search.;	jsr getFirstRes		x/a = pointer to first resource reference.	sta <resPtr	stx <resPtr+2;	ldy #mapIndexUsed		Get number of references.	jsr getMapLong		x/a = mapIndexUsed. 	sta <@num	stx <@num+2;@lop1	lda <@num		Time for linear search?	ldx <@num+2	bne @skip1	cmp #16		At some point a linear is faster.	bcc @doLinear;@skip1	tay		Find middle of range.	txa		num / 2.	lsr a	tax	tya	ror a	sta <@half		Remember half way number.	stx <@half+2	jsr timesResRecSize		Multiply times record size.	clc	adc <resPtr	sta <@temp	txa	adc <resPtr+2	sta <@temp+2		Pointer to reference in middle.;	lda [<@temp]		Is this reference greater or less	cmp <@matchType		the resource I'm searching for?	bcc @greaterThan	bne @lessThan;	ldy #resID+2	lda [<@temp],y		Check ID.	cmp <@matchID+2	bcc @greaterThan	bne @lessThan;	ldy #resID	lda [<@temp],y	cmp <@matchID	bcc @greaterThan	bne @lessThan;@binaryMatch	lda <@temp		Return pointer to resource reference.	sta <resPtr	lda <@temp+2	sta <resPtr+2	sec		Set 'match found' flag.	rts;;; --- Number being search for is less than the one just checked.;@lessThan	ldx <@half+2		New number is one less than half.	lda <@half	dec a	bne @store2	dex@store2	sta <@num	stx <@num+2	bra @lop1		Keep going.;;; --- Number being search for is greater than the one just checked.;@greaterThan	ldx <@temp+2		One after middle becomes top.	lda <@temp	clc	adc #resRecSize	sta <resPtr	bcc @store1	inx@store1	stx <resPtr+2;	lda <@num		New number is old less half.	sec	sbc <@half	sta <@num	lda <@num+2	sbc <@half+2	sta <@num+2	bra @lop1		Keep going.;;; --- Finish with linear search.;;  <resPtr = starting place.;@doLinear	bra @enter2;@lop2	cmp <@matchType	bcc @next2	bne @noMatch	ldy #resID+2	lda [<resPtr],y	cmp <@matchID+2	bcc @next2	bne @noMatch	ldy #resID	lda [<resPtr],y	cmp <@matchID	beq @match	bcs @noMatch@next2	lda <resPtr		Next reference record.	clc	adc #resRecSize	sta <resPtr	bcc @enter2	inc <resPtr+2@enter2	lda [<resPtr]	bne @lop2		End of index?;;; --- Resource not found exit.;@noMatch	clc		Set 'no match' flag.	rts;;; --- Resource found exit.;@match	sec		Set 'match' flag.	rts;	EJECT 20;;;==============================================================; Set file refNum in GS/OS parameter blocks.;==============================================================;;   IN: <mapPtr = map pointer.;;  OUT: writeBlock,	markBlock parameter	block set with map's file refNum.; Displacement set to absolute.;setFileRefNum	ldy #mapFileNum		Set file to write to.	lda [<mapPtr],y	ldy #writeBlock+writeRefNum	sta [<data],y	ldy #markBlock+markRefNum	sta [<data],y;; !!!! Fall through	to setMarkBase0 !!!!;;-----------------------------------------------------------; Set type of displacement for set file	mark.;-----------------------------------------------------------;;   IN: None.;;  OUT: None.; setMarkBase0	lda #0		Absolute. !!!!Fall through code!!!!	bra setMarkBase; setMarkBase1	lda #1		EOF - displacement.	bra setMarkBase; setMarkBase2	lda #2		Current mark + displacement.; setMarkBase	ldy #markBlock+markBase	sta [<data],y	rts;	EJECT;================================================================================================; Allocate space in	a file.;================================================================================================;;   IN: x/a = number of bytes needed.; <mapPtr = pointer	to locked map.; <mapHand = handle	of map.;;  OUT: x/a = offset to block.; <mapPtr = pointer	to locked map (may have moved).; <mapHand = handle	of map (may have moved).; <writeEOFflag = <writeEOFflag + 1 if EOF extended.;getFileBlock;@bytesNeeded	equ work+18@saveSizeIndex	equ @bytesNeeded+4@saveOffIndex	equ @saveSizeIndex+2@originalOffset	equ @saveOffIndex+2@localSize	equ @originalOffset+4	Size of local direct page.	IF  (@localSize>maxLocal) THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF;	sta <@bytesNeeded		Save number of bytes needed.	stx <@bytesNeeded+2;;; --- Search for free block large enough.;	ldy #mapFreeList+blkSize+2	Start at first free	block.@lop1	lda <@bytesNeeded+2		Check high word.	cmp [<mapPtr],y	bcc @gotit1	bne @next1	dey	dey	lda [<mapPtr],y		Check low word.	cmp <@bytesNeeded	bcs @gotit2		Is this block large	enough?	iny	iny		Put y back.*** added 25-Apr-91 DAL -- Is this a zero-length free entry?  OUCH!  DIE!	ora [<mapPtr],y	bne @okFine	pea $1E42	pea 0	pea 0	_SysFailMgr@okFine*** end 25-Apr-91 DAL;@next1	tya		Increment to next block.	clc	adc #blkRecSize	tay	bra @lop1		Don't check for end, can't happen.*** "Don't check for end, can't happen" -- yeah, right.  25-Apr-91 DAL;;; --- Allocate free	block.;@gotit1	dey		Remember offset of block	dey@gotit2	sty <@saveSizeIndex		Save index to blkSize field.	dey	dey	dey	dey	sty <@saveOffIndex		Save index to blkOffset field.	jsr getMapLong		x/a = blkOffset field.	sta <@originalOffset	Save original block	offset.	stx <@originalOffset+2;;; --- Allocate space from the free block.;	ldy <@saveSizeIndex		Pass index to blkSize field.	lda <@bytesNeeded		Pass number of bytes to use.	ldx <@bytesNeeded+2	jsr subToMapLong2		Subtrack bytes used	from size.	tay		Anything left?	bne @ok1	txy	beq @deleteBlock		If nothing left, delete free block from	free list.;@ok1	ldy <@saveOffIndex		Pass index to blkOffset field.	lda <@bytesNeeded		Pass number of bytes to use.	ldx <@bytesNeeded+2	jsr addToMapLong2		Move offset of free	block past used.	bra @noErrorExit;;; ------ Entire free block allocated, delete block from free list.;;        Move block	records below block	up and over block being deleted.  Blocks are moved;        until a NIL long (end of list mark) is moved.;@deleteBlock	ldx <@saveOffIndex		Get index of block to cut.	ldy <@saveSizeIndex		Get index of next block.	iny	iny	iny	iny;	pha		Space for temp.@lop2	lda [<mapPtr],y		Move rest of blocks	up.	phy	txy	sta [<mapPtr],y	ply	sta 1,s		Space low word of possible end of list mark.	iny	iny	inx	inx	lda [<mapPtr],y	phy	txy	sta [<mapPtr],y	ply	iny	iny	inx	inx	ora 1,s		OR low word with high word, NIL = end of list.	bne @lop2		End of list?	pla		Strip temp.;	ldy #mapFreeListUsed	Decrement number of	uesed blocks.	lda [<mapPtr],y	dec a	sta [<mapPtr],y;	ldy <@saveOffIndex		This is now the index to the next block.	bra @testPushEOF;; --- Exit.;@noErrorExit	ldy <@saveSizeIndex		Was I allocating from the 	iny		last free block (past EOF)?	iny	iny	iny@testPushEOF	lda [<mapPtr],y	iny	iny	ora [<mapPtr],y		If next block is NIL, means I was in the	bne @exit		last block.;;; --- Push out file's EOF mark.;	tya		Get offset of last free block which is new EOF.	sec	sbc #blkRecSize+2	tay	lda [<mapPtr],y	tax	iny	iny	lda [<mapPtr],y		Pass new EOF.	ldy #EOFBlock+EOFdisplacement+2	sta [<data],y	dey	dey	txa	sta [<data],y;	ldy #mapFileNum		Pass file's reference number.	lda [<mapPtr],y	ldy #EOFBlock+EOFRefNum	sta [<data],y;	jsr pushEOFBlock		Pass pointer to parameter block.	pea SET_EOF	jsl GS_OS;	inc <writeEOFflag		Need to write to disk to allocate disk space.;;@exit	jsr markDirtyMap		Map has change, set	dirty bit so it'll be;      written to disk.;	lda <@originalOffset	Return offset to allocated block.	ldx <@originalOffset+2	clc		No error.	rts;	EJECT 20;----------------------------------------------------------------------------------------; Get offset of byte after previous block.;----------------------------------------------------------------------------------------;;   IN: y = index to block.;;  OUT: x/a = offset to byte after block (blkOffset + blkSize).; y = trash.; getPrevAfter	lda [<mapPtr],y	pha	iny	iny	lda [<mapPtr],y	tax	pla		Pass blkOffset in x/a.	iny		Pass index of blkSize in Y.	iny	brl addMapLong2		Add blkOffset to blkSize to get byte after block.;	EJECT 15;================================================================================================; Set map dirty bit	so the map will be written to disk.;================================================================================================;;   IN: <mapPtr = pointer to dirty map.;;  OUT: None.;markDirtyMap	ldy #mapFlag	lda [<mapPtr],y	ora #mapChanged		Set dirty bit in map's flag.	sta [<mapPtr],y	rts;	EJECT;================================================================================================; Delete BLOCK record from mapFreeList;================================================================================================;;   IN: y = index to BLOCK.; <mapPtr = map.;;  OUT: mapFreeListUsed = one less.; BLOCKs after given block are moved up	over deleted block.;deleteBlock	pha		Temp stack space.;	tya		Compute index to next block.	clc	adc #blkRecSize	tax@lop1	phy	txy	lda [<mapPtr],y	ply	sta [<mapPtr],y	sta 1,s		Save low word.	iny	iny	inx	inx	phy	txy	lda [<mapPtr],y	ply	sta [<mapPtr],y	iny	iny	inx	inx	ora 1,s		End of array?	bne @lop1;	pla		Strip temp stack space.;	ldy #mapFreeListUsed	One less record used.	lda [<mapPtr],y	dec a	sta [<mapPtr],y;	rts;	EJECT 30;================================================================================================; Multiple long times size of resource reference record.;================================================================================================;;   IN: x/a = long.;;  OUT: x/a = result.; y = trash.; timesResRecSize	pei <work+2	pei <work;@number1	equ work@number2	equ @number1+2;;	stx <@number2		Multiple number times 4.;	asl a	rol <@number2	asl a	rol <@number2;	sta <@number1	ldy <@number2;	asl a		Multiple number times 16.	rol <@number2	asl a	rol <@number2;	clc Add		the two numbers together to	adc <@number1		get number * 20 (size of record).	pha	tya	adc <@number2	tax		Return result in x/a.	pla;;	ply		Restore.	sty <work	ply	sty <work+2	rts;;	EJECT 20;================================================================================================; Compute resource reference offset.;================================================================================================;;   IN: x/a = reference number.; <mapPtr = map pointer.;;  OUT: x/a = offset to reference.; computeResOffset	jsr timesResRecSize		Multiple reference index times 16.;     x/a = result.	ldy #mapToIndex		Add index offset to	start of index.	clc	adc [<mapPtr],y	bcc @ok1	inx@ok1	rts;	EJECT 30;================================================================================================; Compute resource reference pointer.;================================================================================================;;   IN: x/a = reference number.; <mapPtr = map pointer.;;  OUT: See output from fall through code below.; computeResPtr	jsr computeResOffset	x/a = offset to reference.;;;-Fall-through-------------------------------------------------------;  Add value to <mapPtr.;--------------------------------------------------------------------;;   IN: x/a = amount to add.; <mapPtr = amount to add to.;;  OUT: <resPtr = total.;addToMapPtr	clc Add		offset to map pointer.	adc <mapPtr	sta <resPtr	txa	adc <mapPtr+2	sta <resPtr+2	rts;	EJECT;================================================================================================; Add a word to a long in the map.;================================================================================================;;   IN: a = amount to add.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: See output from fall through code below.; addToMapLong1	ldx #0		Pass high word.;;;-Fall-through------------------------------------------------------;  Add a long to a long in the map.;-------------------------------------------------------------------;;   IN: x/a = amount to add.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: See output from fall through code below.;addToMapLong2	jsr addMapLong2;;;-Fall-through------------------------------------------------------;  Store a long in a map field.;-------------------------------------------------------------------;;   IN: x/a = value	to store.; y = offset to field.; <mapPtr = pointer	to map.;;  OUT: a,y,x = same as in.; Long stored in field.;storeMapLong	phy		Save.	pha	sta [<mapPtr],y		Store result.	iny	iny	txa	sta [<mapPtr],y	pla		Restore.	ply	rts;	EJECT;================================================================================================; Add a word to a long in the map.;================================================================================================;;   IN: a = amount to add.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: See output from fall through code below.;addMapLong1	ldx #0		Pass high word.;;;-Fall-through------------------------------------------------------;  Add a long to a long in the map.;-------------------------------------------------------------------;;   IN: x/a = amount to add.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: x/a = result.; y = same as in.;addMapLong2	clc	adc [<mapPtr],y	pha	txa	iny	iny	adc [<mapPtr],y	tax	pla		Return result in x/a.	dey		Restore Y.	dey	rts;	EJECT 30;================================================================================================; Subtrack a word from a long in the map.;================================================================================================;;   IN: a = amount to subtrack.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: See output from fall through code below.; subToMapLong1	ldx #0		Pass high word.;;;-Fall-through------------------------------------------------------;  Subtrack a long from a long in the map.;-------------------------------------------------------------------;;   IN: x/a = amount to subtrack.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: x/a = result.; y = same as in.; Result stored in field.;subToMapLong2	jsr subMapLong2	brl storeMapLong		Store the result in	the field.;	EJECT;================================================================================================; Subtrack a word from a long in the map.;================================================================================================;;   IN: a = amount to subtrack.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: See output from fall through code below.;subMapLong1	ldx #0		Pass high word.;;;-Fall-through-----------------------------------------------------------;  Subtrack a long from a long in the map.;------------------------------------------------------------------------;;   IN: x/a = amount to subtrack.; y = offset to long field in map.; <mapPtr = pointer	to map.;;  OUT: x/a = result.; y = same as in.;subMapLong2	phx	pha	lda [<mapPtr],y	sec	sbc 1,s	sta 1,s	iny	iny	lda [<mapPtr],y	sbc 3,s	sta 3,s	pla		Return result in x/a.	plx	dey		Restore Y.	dey	rts;	EJECT 35;================================================================================================;  Add records to free list in map.;================================================================================================;;   IN: <mapHand = handle of locked map.; <mapPtr = pointer	to locked map.;;  OUT: Carry set if error, y = error code.; <mapHand = handle	of locked map (map have moved).; <mapPtr = pointer	to locked map (map have moved).; mapFreeListSize is increased.; Empty block records added to end of free list.; growFreeList	ldy #mapToIndex		Compute where to insert in map.	lda [<mapPtr],y		Back up over end of	index mark.	sec	sbc #4	ldx #0	tay		Pass insertion point in x/y	lda #blkRecSize*20		Pass number of bytes to grow.	jsr growMap		Resize map, insert zeros.	bcs @exit;	ldy #mapFreeListSize	Increment free list	size.	lda [<mapPtr],y	clc	adc #20		Number of records added.	sta [<mapPtr],y;	ldy #mapToIndex		Increment offset to	index.	lda [<mapPtr],y	clc	adc #blkRecSize*20	sta [<mapPtr],y;	clc		Set 'no error' flag.@exit	rts;;	EJECT;================================================================================================; Insert a block of	zeros into map.;================================================================================================;;   IN: a = number of bytes to insert.; x/y = insertion offset.; <mapHand = handle	of locked map.; <mapPtr = pointer	to locked map.;;  OUT: Carry set if error, y = error code.; <mapHand = handle	of locked map (map have moved).; <mapPtr = pointer	to locked map (map have moved).;growMap;; !!!!! Changing the size of this work area will affect other routines !!!!!!!!!@growSize	equ work		Local work space.@insertion	equ @growSize+2@oldSize	equ @insertion+4@newSize	equ @oldSize+4@insertPoint	equ @newSize+4@localSize	equ @insertPoint+4		Size of local direct page.	IF  (@localSize>maxLocal)	THEN	AERROR 'DEBUG ERROR - local direct page overflow'	ENDIF; !!!!! Changing the size of this work area will affect other routines !!!!!!!!!;;	sta <@growSize		Save parameters.	sty <@insertion	stx <@insertion+2;	ldy #handSize+2		Compute current size and new size.	lda [<mapHand],y	tax	dey	dey	lda [<mapHand],y	sta <@oldSize		Save current size.	stx <@oldSize+2	clc	adc <@growSize	bcc @store1	inx@store1	sta <@newSize		Save new size.	stx <@newSize+2	jsr resizeMapHandle		Grow map's handle.	bcc @ok1	rts		Return error code in y.;@ok1	jsr freeFileMap		Free space on disk for current map.;	lda <@newSize		New size.	ldx <@newSize+2	jsr allocateFileMap		Allocate new space on disk for new map.	bcc @ok4		Was disk space really allocated?;;; ------ Cannot resize map.  Put it back the way it was.;	jsr freeFileMap		Free map on disk.;	lda <@oldSize		Resize map handle back to old size.	ldx <@oldSize+2	jsr resizeMapHandle		Should not fail going back to old size.;	jsr allocateFileMap		Allocate space for old map, should fit.;	ldy #resDiskFull		Return error code.	sec		Set error flag.	rts;;; --- Move data for	insert.;@ok4	lda <mapPtr		Compute source of move.	clc	adc <@insertion	tay	lda <mapPtr+2	adc <@insertion+2	sty <@insertPoint		Save insertion point.	sta <@insertPoint+2	pha		Pass pointer to source.	phy;	tax	tya	clc		Compute destination of move.	adc <@growSize	bcc @ok2	inx@ok2	phx		Pass pointer to destination.	pha;	lda <@oldSize		Compute number of bytes to move.	sec	sbc <@insertion	tay	lda <@oldSize+2	sbc <@insertion+2	pha		Pass number of bytes to move.	phy	_MyBlockMove		Make room for insertion.;;; --- Insert zeros.;	lda <@growSize	tay	lsr a	lda #0	bcc @wordFill;	sep #$20	LONGA OFF@lop1	dey	sta [<@insertPoint],y	tyx	bne @lop1	rep #$20	LONGA ON	bra @done1;@wordFill@lop2	dey	dey	sta [<@insertPoint],y	tyx	bne @lop2;;@done1	jsr markDirtyMap		Map has change.	clc		Set 'no error' flag.	rts;;;==================================; Grow map's handle.;==================================;;   IN: x/a = new size.; <mapPtr = pointer	to map.; <mapHand = handle	of map.;;  OUT: Carry set if error, y = error code.;resizeMapHandle	pha		Save.;	ldy #4		Save state of handle.	lda [<mapHand],y	pha	and #$7FFF		Unlock map.	sta [<mapHand],y;	lda 3,s		Get saved new size.	phx		Pass new size	pha	pei <mapHand+2		Pass handle.	pei <mapHand	_SetHandleSize	tax		Put error code in x.;	ldy #4		Restore handle's state.	pla	sta [<mapHand],y	dey		Dereference map handle.	dey	lda [<mapHand],y	sta <mapPtr+2	lda [<mapHand]	sta <mapPtr;	pla		Get rid of saved value.;	txy		Return error code in Y.	cpy #1		Setup error flag.	rts;;;===================================================; Free space on disk for current map.;===================================================;;   IN: <mapPtr = pointer to map.;freeFileMap	ldy #mapSize		Pass current size.	jsr pushMapLong	ldy #mapOffset		Pass block's offset.	jsr pushMapLong	jsr freeFileBlock		Free the block used	by the map.;	lda #0		Mark map as not being allocated in file.	ldy #mapOffset	sta [<mapPtr],y	iny	iny	sta [<mapPtr],y	rts;;;=======================================================; Allocate new space on disk for new map.;=======================================================;;   IN: x/a = new size of map.; <mapPtr = pointer	to map.;;  OUT: Carry set if error, y = error code.;allocateFileMap	phx		Save new size.	pha	jsr getFileBlock		Allocate file space	for map, have to be	able to allocate.;     x/a = new offset.;	ldy #mapOffset		Save map's new offset.	jsr storeMapLong;	ldy #mapSize		Pass index to field	to store long into.	pla		New size.	plx	jsr storeMapLong		mapSize field = x/a.;	lda #rFileToMap		File offset.	ldx #rFileToMap>>16	jsr setFileMark2		Set file mark to write pos (absolute displacement).;	pea 0		Pass number of bytes to write.	pea 8	ldx <mapPtr+2		Pass pointer to data to write.	lda <mapPtr	clc	adc #mapOffset	bcc @ok1	inx@ok1	jsr fileWrite2		Write map offset to	header.;;	lda <writeEOFflag		Did the map move past real EOF?	bne @ok2	clc		No error.	rts;@ok2	jsr writeMap		Write map to disk to allocate disk space.	stz <writeEOFflag	rts;;	EJECT;================================================================================================; Get current map.;================================================================================================;;   IN: curApp = current application.;;  OUT: See output from fall through code below.;getCurMap	jsr getCurMapHandnewMap	sta <mapHand	stx <mapHand+2;;;-Fall-through------------------------------------------------------;  Lock and dereference <mapHand.;-100---------------------------------------------------------------;;   IN: <mapHand = handle.;;  OUT: See output from fall through code below.; Carry set if <mapHand+1 = NIL, y = resNoCurFile error code.;lockMap	lda <mapHand+1		Valid handle?	bne @ok100	ldy #resNoCurFile	sec	rts;@ok100	ldy #handAttr		Lock <mapHand.	lda [<mapHand],y	ora #$8000	sta [<mapHand],y;;;-Fall-through------------------------------------------------------;  Dereference <mapHand.;-110---------------------------------------------------------------;;   IN: <mapHand = handle.;;  OUT: <mapHand = locked handle.; <mapPtr = dereferenced <mapHand.;derefMap	ldy #2		Dereference <mapHand.	lda [<mapHand],y	sta <mapPtr+2	lda [<mapHand]	sta <mapPtr	clc		OK flag.	rts;	EJECT 25;================================================================================================; Get handle of current map.;================================================================================================;;   IN: curApp = current application.;;  OUT: x/a = handle of current map, NIL if none.; y = index to current map.;getCurMapHand	ldy #curApp		Offset to current app record.	lda [<data],y	clc	adc #appCur+2		plus offset to appCur field,	tay		is offset to current file.	lda [<data],y		Get application's current file.	tax	dey	dey	lda [<data],y	rts;	EJECT 25;================================================================================================; Match file ID to map.;================================================================================================;;   IN: <inputs = file ID to match.; <mapPtr = pointer	to map.;;  OUT: Carry set if match, clear if no	match.; <work = <mapHand if no match (previous map when using walkMaps).;matchFileID	lda <inputs		File ID to match.	ldy #mapID	cmp [<mapPtr],y		Same as this map's?	beq @exit		Carry set if EQUAL.;	lda <mapHand		Save previous map handle before going on.	sta <work	lda <mapHand+2	sta <work+2	clc		No match.@exit	rts;	EJECT 30;================================================================================================; Free allocated resource.;================================================================================================;;   IN: <resPtr = pointer to resource reference in index.;;  OUT: If resHandle field is TRUE then	handle freed, resHandle field set to NIL.;freeRes	ldy #resAttr		Can't free absolute resources.	lda [<resPtr],y	and #resAbsLoad	bne @exit;	ldy #resHandle+1		Is resource allocated?	lda [<resPtr],y	beq @exit;	iny		Pass handle.	lda [<resPtr],y	pha	dey	dey	lda [<resPtr],y	pha	_DisposeHandle		Free the resource.;	ldy #resHandle+1		Set resHandle to NIL.	lda #0	sta [<resPtr],y;@exit	clc		Continue flag to walkResources.	rts;	EJECT 30;================================================================================================; Open the resource	fork of a file.;================================================================================================;;   IN: <inputs = pointer to pathname (GS/OS class 1 input string).;;  OUT: Carry clear	if file opened, a =	open file reference	number.; Carry set if error, a & y = GS/OS error code.;openResFork	ldy #openBlock+openPathname	Pass pointer to pathname.	lda <inputs	sta [<data],y	iny	iny	lda <inputs+2	sta [<data],y;	jsr SetInternalLevel	;DAL 20-Dec-90	jsr pushOpenBlock		Pass pointer to parameter block.	pea OPEN		Pass call number.	jsl GS_OS		Call GS/OS to open the file.	tay		Return possible error in Y.	bcs @exit		Error?;	ldy #openBlock+openRefNum	Return open file reference number.	lda [<data],y@exit	jsr RestoreTheLevel		;DAL 20-Dec-90	rts** SetInternalLevel, 20-Dec-90 DAL** Does a GetLevel and then a SetLevel with pCount=2 to* grab the current level, whether System or User range,* and then set the level to an internal level.*SetInternalLevel	name	jsr pushGetLevelBlock	pea GetLevel	jsl GS_OS		lda #ResMgrInternalFileLevel	ldy #setLevelBlock+setLevelCurrent	sta [<data],y	jsr pushSetLevelBlock	pea SetLevel	jsl GS_OS	rts** RestoreTheLevel, 20-Dec-90 DAL** Does a SetLevel with pCount=2 to restore the previous* file level, whether in the System or User range.** Preserves A, Y, P.*RestoreTheLevel	name	php	pha	phy	ldy #getLevelBlock+getLevelCurrent	lda [<data],y	ldy #setLevelBlock+setLevelCurrent	sta [<data],y	jsr pushSetLevelBlock	pea SetLevel	jsl GS_OS	ply	pla	plp	rts;	EJECT 35;================================================================================================; Read from a file.;================================================================================================;;   IN: x/a = pointer to data area.; <work+4 = number of bytes to read.; readBlock+readRefNum = open file reference number.;;  OUT: Carry set if error, a = GS/OS error code.;fileRead1	ldy #readBlock+readData	Pass pointer to read buffer.	sta [<data],y	iny	iny	txa	sta [<data],y;	ldy #readBlock+readSize	Pass number of bytes to read.	lda <work+4	sta [<data],y	iny	iny	lda <work+6	sta [<data],y;	jsr pushReadBlock		Pass pointer to read file parameter block.	pea READ		Pass call number.	jsl GS_OS		Read file header.	rts;	EJECT;================================================================================================; Write to file.;================================================================================================;;   IN: PUSH:LONG -	number of bytes to write.; PUSH:LONG - pointer to data buffer.; a - open file reference number.;;  OUT: See output from fall through code below.;fileWrite1	ldy #writeBlock+writeRefNum	Pass file to write to.	sta [<data],y;	ply		Get return address.	pla		Get data pointer.	plx		Pass pointer in x/a.	phy		Put return address back.;;;-Fall-through------------------------------------------------------;  Write to file.;-100---------------------------------------------------------------;;   IN: PUSH:LONG -	number of bytes to write.; x/a = pointer to data buffer.; writeBlock+writeRefNum = open file reference number.;;  OUT: writeBlock+writeTransfer - number of bytes actually	written.; Carry set if error, a = GS/OS error code.;fileWrite2	ldy #writeBlock+writeData	Pass pointer to data to write.	sta [<data],y	iny	iny	txa	sta [<data],y;	plx		Get return address.	ldy #writeBlock+writeSize	Pass number of bytes to write.	pla	sta [<data],y	iny	iny	pla	sta [<data],y	phx		Put return address back.;	jsr pushWriteBlock		Pass pointer to write file parameter block.	pea WRITE		Pass call number.	jsl GS_OS		Write template to file.	rts;	EJECT 20;================================================================================================; Close the resource fork of a file.;================================================================================================;;   IN: a = reference number of open resource fork.;;  OUT: Carry set if error, a = GS/OS error code.;closeResFork	ldy #closeBlock+closeRefNum	Pass file reference	number to close.	sta [<data],y*** added 6-Nov-91 DAL -- never Close(0) here	tay	clc	beq @skipClose*** end 6-Nov-91;	jsr pushCloseBlock		Pass pointer to parameter block.	pea CLOSE		Pass call number.	jsl GS_OS		Call GS/OS to open the file.@skipClose	rts;	EJECT 40;================================================================================================; Set the file position mark.;================================================================================================;;   IN: x/a = file position.; y = open file reference number.;;  OUT: See output from fall through code below.;setFileMark1	pha		Save a.;	tya		Pass file reference number to set mark.	ldy #markBlock+markRefNum	sta [<data],y;	pla		Restore a.;;;-Fall-through------------------------------------------------------;  Set the file position mark.;-------------------------------------------------------------------;;   IN: x/a = file position displacement.; markBlock+markRefNum = open file reference number.; markBlock+markBase = base.;;  OUT: Carry set if error, a = GS/OS error code.;setFileMark2	ldy #markBlock+markPosition	Pass file position.	sta [<data],y	iny	iny	txa	sta [<data],y;	jsr pushMarkBlock		Pass pointer to parameter block.	pea SET_MARK		Pass call number.	jsl GS_OS		Call GS/OS to set the file position.	rts;	EJECT;================================================================================================; Walk resource maps.;================================================================================================;;  Map list is walked starting with first map in application's appFiles field.  Given ;  routine is called for each map in map list with the following parameters set:;;   <mapHand = locked handle of map.;   <mapPtr = pointer to locked map.;;  Routine called should return with carry set to stop walking, or clear to continue.  ;  Also, <mapHand should be NIL if the handle is no longer valid.;;   IN: a = address	of routine to call for each map.; <data.curApp = offset to current application in application list.;;  OUT: Carry clear	if entire map list walked.; Carry set if walk	was aborted by routine called:;  <mapHand = handle of map aborted on (unlocked).;  <mapPtr = pointer to map aborted on (unlocked).; walkMapsFirst	pha		Save routine address.	jsr getFirstMap		x/a = handle of first map.	ply		Get routine address.	bra walkMaps		Is there a current application?; walkMapsCur	pha		Save routine address.	jsr getCurMapHand		x/a = handle of current map.	ply		Get routine address.	bra walkMaps		Is there a current application?;walkMaps	dey		Turn routine address into a RTS address.	phy		Save routine address.;	phx		Save x.	pha		Save a.	jsr getFileDepth		Get number of files	to search.	tay	pla		Restore a.	plx		Restore x.	phy		Save number of files to search.	bra @enter1;;@lop1	lda 1,s		Check file counter.	beq @exit2	dec a	sta 1,s;	jsr lockMap		Lock and dereference <mapHand.;	ldy #mapNext+2		Save handle of next	map.	lda [<mapPtr],y	pha	lda [<mapPtr]	pha;	pea @return-1		Put return address on stack.	lda 9,s		Get routine address,	pha	rts		dispatch to routine.;@return	lda <mapHand+1		Is map handle still	valid?	beq @skip1	phy	jsr unlockMap		Leave map unlocked.	ply;@skip1	pla		Restore handle of next map.	plx	bcs @exit1		Did routine abort?;@enter1	sta <mapHand		Store handle to map.	stx <mapHand+2	lda <mapHand+1		Is there a map?	bne @lop1		If yes, continue. If no then done.;@exit2	clc Return		'entire list walked' flag.@exit1	pla		Get rid of file counter.	pla		Get rid of saved routine address.	rts;	EJECT;================================================================================================; Walk resources in	a map.;================================================================================================;;  Resources are walked starting with first resource reference in index.  Given	routine ;  is called for each resource in the map with the following parameters set:;;   <mapHand = locked handle of map.;   <mapPtr = pointer to locked map.;   <resPtr = pointer to resource reference in the index.;;  Routine should return with carry set	to stop walking, or	clear to continue.;;   IN: a = address	of routine to call for each map.; <mapHand = locked	handle of map.; <mapPtr = pointer	to locked map.;;  OUT: Carry clear	if entire map list walked, <resPtr = end of index mark.; Carry set if walk	was aborted by routine called:;  <mapHand = handle of map aborted on.;  <mapPtr = pointer to map aborted on.;  <resPtr = pointer to resource reference in the index.; walkResources	dec a		Turn routine address into a RTS address.	pha		Save routine address.;	jsr getFirstRes		x/a = pointer to first resource reference.	bra @enter1;@lop1	pea @return-1		Put return address on stack.	lda 3,s		Get routine address,	pha	rts		dispatch to routine.;@return	bcs @exit2		Did routine abort walk?;	ldx <resPtr+2		Compute pointer to next reference.	lda <resPtr	clc	adc #resRecSize	bcc @enter1	inx;@enter1	sta <resPtr		Store pointer to reference.	stx <resPtr+2;	lda [<resPtr]		End of index?	bne @lop1		If end then entire list walked.;@exit1	clc		Return 'entire list walked' flag.@exit2	pla		Get rid of saved routine address.	rts;	EJECT 15;================================================================================================; Unlock <mapHand.;================================================================================================;;   IN: <mapHand = handle.;;  OUT: <mapHand = unlocked handle.; unlockMap	ldy #handAttr		Unlock <mapHand.	lda [<mapHand],y	and #$7FFF	sta [<mapHand],y	rts;	EJECT 25;================================================================================================; Get handle of first map in app's file list.;================================================================================================;;   IN: <data.curApp = offset to current application in application list.;;  OUT: x/a = handle of first file, NIL	if none.; y = index to appFiles field.;getFirstMap	ldy #curApp		Offset to current app record,	lda [<data],y	clc	adc #appFiles+2		plus offset to appFiles field,	tay		is offset to current file list.	lda [<data],y		Get handle of first	map in app's list.	tax	dey	dey	lda [<data],y	rts;	EJECT 20;================================================================================================; Get pointer to first resource reference in index.;================================================================================================;;   IN: <mapPtr = pointer to map.;;  OUT: x/a = pointer to first resource	reference in index (maybe empty).;getFirstRes	ldx <mapPtr+2	lda <mapPtr	ldy #mapToIndex	clc	adc [<mapPtr],y	bcc @exit	inx@exit	rts;	EJECT;================================================================================================; Copy sysFile into	another variable in	data.;================================================================================================;;   IN: y = index to destination in <data.; <data = pointer to data area.;;  OUT: See output from fall through code below.;moveSysFile	ldx #sysFile		Pass source index.;;;-Fall-through------------------------------------------------------------------;  Copy a long from	one variable in <data to another.;-------------------------------------------------------------------------------;;   IN: x = index to source in <data.; y = index to destination in <data.; <data = pointer to data area.;;  OUT: y = same as	in.; x = trash.; a = trash.;moveLongData	phy		Save destination index.;	txy		Get source long.	lda [<data],y	tax	iny	iny	lda [<data],y		a/x = source long.;	ply		Restore destination index.	iny	iny	sta [<data],y		Store source high word.	dey	dey	txa	sta [<data],y		Store source low word.	rts;	EJECT;================================================================================================; Push address of data area variable.;================================================================================================;;   IN: None.;;  OUT: Address of data area variable on stack.;;ENTRY: pushMarkBlock Push address of markBlock variable.; pushReadBlock Push address of readBlock variable.; pushWriteBlock Push address of writeBlock variable.; pushCloseBlock Push address of closeBlock variable.; pushCreateBlock Push address of createBlock variable.; pushOpenBlock Push address of openBlock variable.; pushEOFBlock Push	address of EOFBlock	variable.; pushDataArea a = offset into data area.; pushAddQBlock	lda #addQBlock	bra pushDataArea;pushDelQBlock	lda #delQBlock	bra pushDataArea;pushGetLevelBlock	lda #getLevelBlock	bra pushDataArea;pushSetLevelBlock	lda #setLevelBlock	bra pushDataArea;pushMarkBlock	lda #markBlock		Pass variable offset.	bra pushDataArea;pushReadBlock	lda #readBlock		Pass variable offset.	bra pushDataArea;pushWriteBlock	lda #writeBlock		Pass variable offset.	bra pushDataArea;pushCloseBlock	lda #closeBlock		Pass variable offset.	bra pushDataArea;pushCreateBlock	lda #createBlock		Pass variable offset.	bra pushDataArea;pushEOFBlock	lda #EOFBlock		Pass variable offset.	bra pushDataArea;pushOpenBlock	lda #openBlock		Pass variable offset.;pushDataArea	ldy <data+2		Add variable offset	to data area pointer.	clc	adc <data	bcc @ok1	iny@ok1	plx		Get return address.	phy		Push data area variable address.	pha	phx		Put return address back.	rts;	EJECT 20;================================================================================================; Push address of direct page variable.;================================================================================================;;   IN: a = offset on to direct page.;;  OUT: Address of direct page variable	on stack.;pushDpage	plx		Get return address.	pea 0		Push high word address of direct page.	pha		Push offset,	tdc		and add direct page pointer,	clc	adc 1,s	sta 1,s		that's the low word address.	phx		Put return address back.	rts;;	EJECT 25;================================================================================================; Return long field	in map.;================================================================================================;;   IN: <mapPtr = pointer to map.; y = field index.;;  OUT: Map field is pushed on stack.; y = same as in.; x/a = long field.;getMapLong	iny		Push long field.	iny	lda [<mapPtr],y	tax	dey	dey	lda [<mapPtr],y	rts;	EJECT 20;================================================================================================; Push long field in map.;================================================================================================;;   IN: <mapPtr = pointer to map.; y = field index.;;  OUT: Map field is pushed on stack.; a,y,x = trash.;pushMapLong	jsr getMapLong		Fetch the field.	ply		Get return address.	phx		Push long field.	pha	phy		Put return address back.	rts;	EJECT;================================================================================================; Allocate memory (WORD size number of bytes).;================================================================================================;;   IN: a = number of bytes to allocate.;;  OUT: See output from fall through code below.;;ENTRY: allocateHand1; allocateHand2;allocateHand1	ldx #0		High word number of	bytes to allocate.;;;-Fall-through------------------------------------------------------------;  Allocate memory (LONG size number of	bytes).;-------------------------------------------------------------------------;;   IN: x/a = number of bytes to allocate.;;  OUT: Carry clear	if memory allocated, x/a = handle.; Carry set if error, y = error code.;allocateHand2	pha		Space for result.	pha	phx		Pass number of bytes to allocate.	pha	pea $4000+ResToolNum	Pass user ID.	pea 0		Pass attributes, anywhere, anyhow.	pha		Pass address, not used.	pha	_NewHandle	tay		Return error code in Y.	pla		Return handle in x/a.	plx	rts;;allocateHandNoS1	ldx #0		High word number of	bytes to allocate.;;   IN: x/a = number of bytes to allocate.;;  OUT: Carry clear	if memory allocated, x/a = handle.; Carry set if error, y = error code.;	pha		Space for result.	pha	phx		Pass number of bytes to allocate.	pha	pea $4000+ResToolNum	Pass user ID.	pea $0008		Pass attributes, anywhere, anyhow.	pha		Pass address, not used.	pha	_NewHandle	tay		Return error code in Y.	pla		Return handle in x/a.	plx	rts;;	EJECT;================================================================================================; Setup for call into tool.;================================================================================================;;   IN: y/a = handle of Resource Manager data area.;;  OUT: Caller's direct page and data bank pointers are saved on stack.; Direct page is allocated on the stack	and direct page pointer set to it.; Work area is locked, dereferenced, and its pointer stored	in <data.;;ENTRY: startCall; lockDataHand;startCall	plx		Get return address.;	phb		Save caller's data bank pointer.	phk		Switch data bank into program bank.	plb;	phd		Save caller's direct page pointer.	phy		Save handle of data area.	pha	tsc		Allocate direct page in stack.	sec	sbc #dPageSize	tcs	tcd		Switch direct pointer into stack.;	phx		Put return address back.;	stz <writeEOFflag		Set 'writing not needed' flag.;;lockDataHand1	lda <dataHand+1		Valid data area handle?	bne @ok1	rts;@ok1	ldy #handAttr	lda [<dataHand],y	sta <saveDataAttr;;;-Fall-through------------------------------------------------------;  Lock and dereference <dataHand.;-------------------------------------------------------------------;;   IN: <dataHand =	handle.;;  OUT: <dataHand =	locked.; <data = (<dataHand);lockDataHand	ldy #handAttr		Lock data area.	lda [<dataHand],y	ora #$8000	sta [<dataHand],y;	dey		Dereference data area.	dey	lda [<dataHand],y	sta <data+2	lda [<dataHand]	sta <data	rts;	EJECT;================================================================================================; Strip input parameters from stack and	return from tool call.;================================================================================================;;   IN: None.;;  OUT: None.;;ENTRY: pop0_Err  Strip 0 bytes, y = error code.; pop2_Err  Strip 2	bytes, y = error code.; pop6_Err  Strip 6	bytes, y = error code.; pop8_Err  Strip 8	bytes, y = error code.; pop10_Err Strip 10 bytes, y = error code.;; pop0_NoErr Strip 0 bytes, no error code returned.; pop2_NoErr Strip 2 bytes, no error code returned.; pop6_NoErr Strip 6 bytes, no error code returned.; pop8_NoErr Strip 8 bytes, no error code returned.; pop10_NoErr Strip	10 bytes, no error code returned.; pop14_NoEr Strip 14 bytes, no error code returned.;; pop_NoErr x = bytes to strip, no error code returned.; pop  x = bytes to	strip, y = error code.;;; --- Pop with error code in Y.;pop0_Err	ldx #0		Number of bytes of input to strip.	bra pop;pop2_Err	ldx #2		Number of bytes of input to strip.	bra pop;pop4_Err	ldx #4		Number of bytes of input to strip.	bra pop;pop6_Err	ldx #6		Number of bytes of input to strip.	bra pop;pop8_Err	ldx #8		Number of bytes of input to strip.	bra pop;pop10_Err	ldx #10		Number of bytes of input to strip.	bra pop;pop12_Err	ldx #12		Number of bytes of input to strip.	bra pop;pop14_Err	ldx #14		Number of bytes of input to strip.	bra pop;;;; --- Pop with no error.;pop0_NoErr	ldx #0		Number of bytes of input to strip.	bra pop_NoErr;pop2_NoErr	ldx #2		Number of bytes of input to strip.	bra pop_NoErr;pop4_NoErr	ldx #4		Number of bytes of input to strip.	bra pop_NoErr;pop6_NoErr	ldx #6		Number of bytes of input to strip.	bra pop_NoErr;pop8_NoErr	ldx #8		Number of bytes of input to strip.	bra pop_NoErr;pop10_NoErr	ldx #10		Number of bytes of input to strip.	bra pop_NoErr;pop12_NoErr	ldx #12		Number of bytes of input to strip.;pop_NoErr	ldy #0		No error code.;;; --- Main line pop.;pop	lda <dataHand+1		Is there a data area?	beq @skip1;	phy		Save error code.	ldy #handAttr	lda <saveDataAttr	sta [<dataHand],y	ply		Restore error code.@skip1;	lda <returnAddr2+1		Move return addresses over input parameters.	sta <returnAddr2+1,x	lda <returnAddr1+2	sta <returnAddr1+2,x	lda <returnAddr1	sta <returnAddr1,x;	lda <saveDbank		Move saved pointers	over input parameters also.	sta <saveDbank,x	lda <saveDpage	sta <saveDpage,x;	tsc		Free allocated direct page from stack.	clc	adc #dPageSize+4		(and space used by <dataHand)	phx	adc 1,s		Free space used by input parameters.	tcs;	pld		Restore caller's direct page pointer.	plb		Restore caller's data bank pointer.;	tya		Return error code in A.	cmp #1		Set error flag, carry is A = 0, else set.	rtl		Exit tool.;	EJECT;================================================================================================; Static data used to initialize top of	data area.;================================================================================================;staticData;;; --- Create file parameter block.;	dc.w 7		crePCount IN  - number of parameters.	dc.l 0		crePathname IN  - class 1 input string,	passed by caller.	dc.w 0		creAccess IN  - file access, passed by caller.	dc.w 0		creFileType IN  - filetype, passed by caller.	dc.l 0		creAuxType IN  - aux type, passed by caller.	dc.w 5		creStorageType IN  - 1=standard, 5=extended, 13=directory.	dc.l 0		creDataEOF IN  - bytes allocated for data fork.	dc.l templateSize		creResEOF IN  - bytes allocated for resource fork.;;; --- Open file parameter block.;	dc.w 15		openPCount IN  - number of parameters.	dc.w 0		openRefNum OUT - open file reference number.	dc.l 0		openPathname IN  - pointer to class 1 input string.	dc.w 0		openRequestAcc IN  - Request access is read & write.	dc.w 1		openForkNum IN  - 0	to open data, 1 to open resource.	dc.w 0		openAccess OUT - access attribute.	dc.w 0		openFileType OUT - file type.	dc.l 0		openAuxType OUT - aux type.	dc.w 0		openStorageType OUT	- 1=standard, 5=extended, 13=directory.	dc.l 0,0		openCreateTime OUT - creation time and date.	dc.l 0,0		openModTime OUT - last modified time and date.	dc.l 0		openOptions IN  - pointer to list output buffer.	dc.l 0		openDataEOF OUT - bytes in data fork.	dc.l 0		openDataBlocks OUT - blocks used in data fork.	dc.l 0		openResEOF OUT - bytes in resource fork.	dc.l 0		openResBlocks OUT -	blocks used in resource fork.;; ------ Read file parameter block offsets.;	dc.w 4		readPCount IN  - number of parameters.	dc.w 0		readRefNum IN  - open file reference number.	dc.l 0		readData  IN  - pointer to data area to	read into.	dc.l 0		readSize  IN  - number of bytes to read.	dc.l 0		readTransfer OUT - number of bytes read.;;; --- Write file parameter block.;	dc.w 4		writePCount IN  - number of parameters.	dc.w 0		writeRefNum IN  - open file reference number.	dc.l 0		writeData IN  - pointer to data to write.	dc.l 0		writeSize IN  - number of bytes to write.	dc.l 0		writeTransfer OUT -	number of bytes written.;;; --- Close file parameter block.;	dc.w 1		closePCount IN  - number of parameters.	dc.w 0		closeRefNum IN  - open file reference number.;;; --- Set file position mark parameter block.;	dc.w 3		markPCount IN  - number of parameters.	dc.w 0		markRefNum IN  - open file reference number.	dc.w 0		markBase  IN  - base of position, absolute.	dc.l 0		markPosition IN  - file position.;;; --- Set EOF mark parameter block.;	dc.w 3		EOFPCount IN  - number of parameters.	dc.w 0		EOFRefNum IN  - open file reference number.	dc.w 0		EOFBase  IN  - base	of position, absolute.	dc.l 0		EOFdisplacement IN	- EOF position.;;; --- Get level parameter block.;	dc.w 2		getLevelPCount IN  - number of parameters.	dc.w 0		getLevelCurrent OUT	- current level, $80xx if user, $00xx if system.	dc.w 0		getLevelMode  ??? -	Some kind of flag for masking (no documents).;;; --- Set level parameter block.;	dc.w 2		setLevelPCount IN  - number of parameters.	dc.w 0		setLevelCurrent IN	- new level (no documentation).	dc.w 0		setLevelMode  ??? -	Some kind of flag for masking (no documents).;;; --- Add to OS queue parameter block.;	dc.w 1		addQPCount IN  - number of parameters.	dc.l OSEvent		addQProc  IN  - address of procedure to	add.;;; --- Delete from OS queue parameter block.;	dc.w 1		delQPCount IN  - number of parameters.	dc.l OSEvent		delQProc  IN  - address of procedure to	delete.;;; --- Starting value for curApp.;	dc.w applist;;endStaticData;; --- Make sure init area size matches static data area size.;	IF  ((endStaticData-staticData)-dataInitSize) THEN	AERROR 'DEBUG ERROR - Data area mismatch.'	ENDIF;================================================================================================; Static Data.;================================================================================================;hashMask	dc.b %10000000		Bit 0	dc.b %01000000		Bit 1	dc.b %00100000		Bit 2	dc.b %00010000		Bit 3	dc.b %00001000		Bit 4	dc.b %00000100		Bit 5	dc.b %00000010		Bit 6	dc.b %00000001		Bit 7;bits	dc.b $80,$40,$20,$10,$08,$04,$02,$01;; *** End of Resource Manager Code ********************************;	ENDP	END