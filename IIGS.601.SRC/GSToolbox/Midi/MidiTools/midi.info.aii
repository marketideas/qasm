;-------------------------------------------------------;;  midi.info.aii;;  This module contains routines which return;  information about the state of the MIDI Tool Set.;;  Copyright 1987, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;  23 Nov 87   DM	Split out of mts.control.asm.;					Major reorganization and addition;					of functions to MidiInfo.;;  27 Oct 88   MD	getFreq function now returns TicksPerSec instead;					of DefClkFreq.;;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';-------------------------------------------------------;;  MidiInfo -- call number 12;;  This routine returns various information about the;  status of the MIDI Tool Set.  The information is;  returned in a long on the stack.  A function number;  is passed to MidiInfo which indicates which;  information is required.;;  Information function numbers are as follows:;;		 0 - return number of bytes in next input packet;		 1 - return the number of characters currently;			 in the input buffer;		 2 - return the number of characters currently;			 in the output buffer;		 3 - return max number of characters that were;			 in the input buf since last MidiInfo(3) call,;			 or last flush of buffer;		 4 - return max number of characters that were;			 in the output buf since last MidiInfo(4) call,;			 or last flush of buffer;		 5 - return the address currently being written;			 by MidiRecordFile;		 6 - return the address currently being read;			 by MidiPlayFile;		 7 - return current time stamp clock value;		 8 - return the number of time stamp clock ticks;			 per second;;  Inputs:;		 space for result (long);		 information function number (word);;  Outputs:;		 result (long);;  Registers:;		 not preserved;;-------------------------------------------------------MidiInfo	PROC EXPORT			IMPORT UpdateTimer		; midi.clock.aii;;  stack offsets;			DefineStacks_dirpage   word 					; old direct pages_rtl1		block 3					; first rtl addresss_rtl2		block 3					; second rtl addresss_argstart	DSectSize				; start of argumentss_funcnum	word 					; function numbers_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstarts_result	long 					; result information;;  initialize direct page register;			phd						; save old direct page			tcd						; get our direct page			beq starterr			; MIDI Tool Set not started			;;  call the appropriate function;			lda s_funcnum,s			; get the function number			asl a					; form index to jump table			tax			php						; disable interrupts			sei			jsr (functable,x);;  return (low word in A, high word in Y, error code in X);			plp						; restore interrupts			sta s_result,s			tya			sta s_result+2,sreturnerr	pld						; restore old direct page			PopArgs s_argsize		; move RTL addresses			txa						; restore error code			cmp #1					; set carry for error			rtlstarterr	ldx #miStartUpErr		; MIDI Tool Set not started			bra returnerr;;  function jump table;functable	DC.W inpacketlen		; 0 - length of next input packet			DC.W inbufchars			; 1 - no. of characters in input buf			DC.W outbufchars		; 2 - no. of characters in output buf			DC.W maxinchars			; 3 - max # of chars in input buf			DC.W maxoutchars		; 4 - max # of chars in output buf			DC.W filerecaddr		; 5 - current MidiRecordFile address			DC.W fileplayaddr		; 6 - current MidiPlayFile address			DC.W gettime			; 7 - time stamp clock value			DC.W getfreq			; 8 - number of clock ticks per second			eject;;  return number of bytes in next input packet;inpacketlen	lda InBufSize			; is there an input buffer?			beq nobuf			ldy InBufHead			; any packet available?			iny			cpy InBufEnd 			; wrap if necessary			bcc @1			ldy #0@1		 	ldx #0					; X = 0 (no errors)			txa			cpy PacketIndex			beq @2		 			; no packet			lda [InBufAddr],y		; get packet length			and #$7FFF				; clear possible error flag@2			txy			rtsnobuf		ldx #miNoBufErr			; no buffer error			tay						; result = 0			rts;;  return number of characters in input buffer;inbufchars	lda InBufSize			; is there an input buffer?			beq nobuf			lda InBufHead			; wrap if necessary to avoid inflation			inc a			cmp InBufEnd			lda InBufTail			bcs @1			sbc InBufHead			; note: tail-head-1			bpl @1			adc InBufSize			; head > tail@1			ldx #0					; no errors			txy			rts;;  return number of characters in output buffer;outbufchars	lda OutBufSize			; is there an output buffer?			beq nobuf			lda OutBufHead			; wrap if necessary to avoid inflation			inc a			cmp OutBufEnd			lda OutBufTail			bcs @1			sbc OutBufHead			; note: tail-head-1			bpl @1			adc OutBufSize			; head > tail@1		 	ldx #0					; no errors			txy			rts;;  return maximum number of characters in input buffer;maxinchars	ldx #0					; no errors			txy			lda InBufMaxChars			stz InBufMaxChars		; zero the count			rts;;  return maximum number of characters in output buffer;maxoutchars	ldx #0					; no errors			txy			lda OutBufMaxChars			stz OutBufMaxChars		; zero the count			rts;;  return address currently being recorded by MidiRecordFile;filerecaddr	brk						; more to come...;;  return address currently being played by MidiPlayFile;fileplayaddr			brk						; more to come...;;  return current time stamp clock value;gettime 	ldx TimerEnabled 		; is the clock running?			beq @1					; no			jsr UpdateTimer			; load low byte of clock from DOC			lda Timer			ldy Timer+2			ldx #0					; no errors			rts@1			lda Timer				; low byte is garbage			and #$FF00			ldy Timer+2			rts;;  return number of clock ticks per second;getfreq 	lda TicksPerSec			; default clock frequency			ldx #0					; no errors			txy			rts						ENDP			END			