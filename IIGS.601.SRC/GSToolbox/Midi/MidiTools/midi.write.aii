;-------------------------------------------------------;;  midi.write.aii;;  This module contains routines to write MIDI packets.;;  Copyright 1987, 1988 Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;	2 Sep 87   DM	New today;  13 Jan 88   DM	MidiWritePacket returns number of;					bytes written to output buffer;;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';-------------------------------------------------------;;  MidiWritePacket -- call number 14;;  This function writes one time-stamped MIDI packet;  whose address and length are passed on the stack.;  The length of the packet includes a 2-byte length;  field and a 4-byte time stamp.  MidiWritePacket;  returns within 1/50 of a second, but waits;  asynchronously until the time stamp clock is greater;  than or equal to the packet's time stamp before;  starting transmission.;;  If the given time stamp is negative (most significant;  bit set) the packet is assumed to contain real-time;  data that is placed at the head of the output buffer;  (but behind any previous real-time data).;;  Inputs:;		 space for result (word);		 address of packet (long);;  Outputs:;		 number of bytes written to buffer (word);;  Registers:;		 A contains an error code if the carry is set.;;  If the result word is zero, the packet has;  not been placed in the output buffer.;;-------------------------------------------------------MidiWritePacket PROC EXPORT			IMPORT HalfDelay		; midi.buffer.aii			IMPORT DevPollXmtGlue	; midi.glue.aii			IMPORT MVPGlue;;  stack offsets;			DefineStacks_dirpage   word 					; old direct pages_rtl1		block 3					; first rtl addresss_rtl2		block 3					; second rtl addresss_argstart	DSectSize				; start of argumentss_array 	long 					; address of arrays_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstarts_byteswritten word 				; number of bytes written;;  initialize direct page register;			phd						; save old direct page			tcd						; get our direct page			beq starterr			; MIDI Tool Set not started			lda #0			sta s_byteswritten,s	; no bytes written to output buffer			lda MWactive			; is MidiWritePacket already active?			bne reentry				; yes, this must be reentry via int.			dec a					; mark MidiWritePacket active			sta MWactive			php						; are interrupts disabled?			php			pla			and #$0004			and InputEnabled		; is MIDI input enabled?			bne pollmidi			; yes, poll MIDI with ints. disabled			ldx OutBufSize			; is there an output buffer?			bne bufok			ldx #miNoBufErr			; no buffer error			jmp done1starterr	ldx #miStartUpErr		; MIDI Tool Set not started			jmp reenterdone			reentry		jsl MidiInputPoll		; poll MIDI with ints. disabled			ldx #0@1			jmp reenterdonefullbuf 	plp						; output buffer is fullnobytes 	ldx #0			jmp done1realtimejmp	jmp realtimepollmidi	jsl MidiInputPoll		; poll MIDI input			lda #$FFFF				; remember to poll later			bufok		sta MWpoll			lda s_array,s			sta MWarray			lda s_array+2,s			sta MWarray+2			lda [MWarray]			; get the length field			beq nobytes				; this isn't a real packet!			clc						; add 2 to find length of packet			adc #2					;	including the length field			sta MWlength			php						; calculate number of bytes available			sep #$05 				; sec, sei			lda OutBufHead			sbc OutBufTail			bcs checksize			adc OutBufSize			; adjust for tail > headchecksize	cmp #10					; need min. 10 bytes for word transfers			bcc fullbuf			sbc MWlength			bcc fullbuf				; not enough room			lda OutBufHead			; make sure tail will not lap head			cmp OutBufEnd			bcc storepacket			lda OutBufTail			clc			adc MWlength			cmp OutBufEnd			bcs fullbufstorepacket	ldy #4					; check high word of time stamp			lda [MWarray],y			bmi realtimejmp			; it's a real-time packet			plp			lda OutBufEmpty			; are we writing into an empty buffer?			beq @1 					; no			lda TimerEnabled 		; is the timer running?			bne @1 					; yes			lda OutputDelay			; is delay between output packets needed			beq @1 					; no			jsr HalfDelay			; delay half of the required time here@1  		ldy OutBufTail			sty MWtail			lda MWlength			sta s_byteswritten,s			tax			cpx #11					; is it a large packet?			bcs bigpacket;;  copy short packet into output buffer;			sec			lda MWarray				; adjust array address to use Y index			sbc MWtail			sta MWarray			bcs copyshort			dec MWarray+2copyshort	lda [MWarray],y			; move 10 bytes for speed			sta [OutBufAddr],y			iny			iny			lda [MWarray],y			sta [OutBufAddr],y			iny			iny			lda [MWarray],y			sta [OutBufAddr],y			iny			iny			lda [MWarray],y			sta [OutBufAddr],y			iny			iny			lda [MWarray],y			sta [OutBufAddr],y			clc						; update tail pointer			txa			adc MWtail			jmp checktail;;  set up for block move;bigpacket	sep #$20 				; short accumulator			longa off			phb						; save data bank reg from MVP			pla						; A = data bank register			sta MVPaddr+3			; restore data bank from here after MVPnewbank 	lda MWarray+2			; patch source and destination banks			xba						;	into MVP instruction			lda OutBufAddr+2			rep #$20 				; long accumulator			longa on			ldy #2			sta [MVPaddr],ynextblock	dex						; number of bytes - 1 to move			stz MWlength			; number of bytes to move next time			clc						; does packet wrap in output buffer?			txa			adc MWtail				; add current buffer position			sec			sbc OutBufSize			; are we off the end of the buffer?			bcc @1					; no			inc a					; number of bytes to move next time			sta MWlength			clc@1			txa						; does source cross bank boundary?			adc MWarray			bcc @2					; no			tay						; number of bytes - 1 to move next time			iny						; is bank boundary closer than end			cpy MWlength			;	of buffer?			bcc @2					; no			sty MWlength@2			bit MWpoll				; need to poll MIDI input?			bpl @2b					; no			ldy #60					; transfer max. 60 bytes between polls			cpy MWlength			bcs @2a			sty MWlength@2a			pha						; poll MIDI input			phx			jsl MidiInputPoll			plx			pla			@2b			sec						; calculate end of block move			sbc MWlength			sta MWarray			sec						; calculate number of bytes to move now			txa			sbc MWlength			tax			clc			adc MWtail				; calculate new tail pointer			sta MWtail			adc OutBufAddr			; calculate actual address for MVP			tay						; destination address for MVP			txa						; number of bytes - 1 to move			ldx MWarray				; source address for MVP			jsl MVPGlue				; execute MVP instruction			lda MWtail				; advance tail pointer			inc a			ldx MWlength			; more bytes to move?			beq checktail			; no			cmp OutBufSize			; did output buffer wrap?			bcc @3					; no			lda #0@3		 	sta MWtail			inc MWarray				; did source cross bank boundary?			bne nextblock			; no			sep #$20			inc MWarray+2			; increment source bank			bra newbank				; patch new source bank in MVP;;  check to see if we need to skip the tail pointer to the start of the buffer;checktail	cmp OutBufEnd			bcc @1			lda #0					; skip to start of buffer@1		 	php						; disable interrupts			sei			sta OutBufTail			stz OutBufEmpty			; output buffer is not empty			bit MWpoll				; need to poll MIDI input?			bpl checktime			; no			jsl MidiInputPoll;;  check time stamp at head of buffer;checktime	lda OutputEnabled		; should we call driver output routine?			beq mustwait			lda PacketChars			; are we waiting for a packet?			ora RealTimeChars			bne mustwait 			; we have to wait for these chars			ldy OutBufHead			; advance head pointer			iny			cpy OutBufEnd			bcc @1			tay						; skip to start of buffer@1		 	iny			iny			iny						; compare upper three bytes of clock			iny			lda [OutBufAddr],y			cmp Timer+2			bcc startoutput			; packet is already very old			bne mustwait 			; very long time before packet goes out			dey			lda [OutBufAddr],y			cmp Timer+1			bcc startoutput			; packet is already somewhat old			bne mustwait 			; some time before packet goes outstartoutput	bit MWpoll				; need to poll MIDI input?			bpl @1			jsl MidiInputPoll		; poll MIDI input@1			jsl DevPollXmtGlue		; call output routinemustwait	plp						; restore interrupt statusnoerror 	ldx #0					; no errors			php			sei						; disable interruptsdone		lda OutBufHead			; update max number of chars			cmp OutBufEnd			lda OutBufTail			bcs getmax			sbc OutBufHead			; note: tail-head-1			bpl getmax			adc OutBufSize			; head > tailgetmax		cmp OutBufMaxChars			bcc nomax			sta OutBufMaxCharsnomax		plp			bit MWpoll				; need to poll MIDI input?			bpl done1			phx			jsl MidiInputPoll			plx			done1		stz MWactivereenterdone	pld						; restore old direct page			PopArgs s_argsize		; move RTL addresses			txa						; restore error code			cmp #1					; set carry appropriately			rtl;;  insert real-time data at head of output buffer (but behind;  any previous real-time data);realtime	lda MWlength			; calculate number of data bytes			sec			sbc #6			sta MWlength			ldy OutBufHead			; calculate new head pointer			tya			sec			sbc MWlength			bcs @1			adc OutBufSize@1			sta OutBufHead			sta MWdest			ldx RealTimeChars		; were there previous real-time bytes?			beq insertrealtime		; no			sep #$20 				; move previous bytes down			longa offmoveolddata	iny			cpy OutBufSize			bcc @1			ldy #0@1		 	sty MWsource			lda [OutBufAddr],y		; load previous real-time byte			ldy MWdest			iny			cpy OutBufSize			bcc @2			ldy #0@2			sty MWdest			sta [OutBufAddr],y		; store previous real-time byte			ldy MWsource			dex						; more real-time bytes?			bne moveolddata			rep #$20			longa oninsertrealtime			lda MWlength			; calculate new no. of real-time bytes			tax			clc			adc RealTimeChars			sta RealTimeChars			ldy #6					; where to get bytes in source packet			sty MWsource			sep #$20			longa offinsertloop	ldy MWsource			; get a byte from the source packet			lda [MWarray],y			iny			sty MWsource			ldy MWdest			iny			cpy OutBufSize			bne @1			ldy #0@1		 	sty MWdest			sta [OutBufAddr],y		; store byte in output buffer			dex						; more bytes?			bne insertloop			rep #$20			longa on			jmp startoutput			; call output routine			ENDP			END			