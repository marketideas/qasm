;-------------------------------------------------------;;  midi.device.aii;;  This module contains routines which select and load;  a MIDI device driver.;;  Copyright 1987, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;  19 Nov 87   DM	New today;  28 Jul 88   DM	Fixed bug in installdriver which referred;					to a bogus location on the stack while;					checking slot assignments.;* Bug fix: 5/25/89 Mark Cecys* DP trashed if dirver not found while loading.* loaderr1jmp to loaderror2 since direct page already at DP1;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';-------------------------------------------------------;;  MidiDevice -- call number 10;;  Select and load a MIDI device driver.;;  The routine is passed two arguments: a word;  indicating the control function to perform, and;  a long word pointing to a device driver record.;;  Control function numbers are as follows:;;		 0 - Display a device driver selection dialog.;		 1 - Load the device driver indicated by the;			 device driver record.;		 2 - Shutdown and unload the current device;			 driver.;;  The device driver record contains the following;  information:;;		 offset;		  0-1		  slot number;		  2-3		  external(=1)/internal(=0);		   4		  length of pathname string;		  5-68		  pathname string;;  Inputs:;		 function number (word);		 pointer to device driver record (long);;  Outputs:;		 none;;  Registers:;		 not preserved;;-------------------------------------------------------MidiDevice	PROC EXPORT			import ShutDriver			IMPORT DevInitGlue		; midi.glue.aii			IMPORT ProdosGlue			;;  stack offsets;tempsize	equ $20					; size of temporary space on stack			DefineStacks_temp		block tempsize			; temporary space on stacks_dirpage   word 					; old direct pages_rtl1		block 3					; first rtl addresss_rtl2		block 3					; second rtl addresss_argstart	DSectSize				; start of argumentss_driverrec	long 					; pointer to device driver records_funcnum	word 					; function numbers_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstart;;  initialize direct page register;			phd						; save old direct page			tcd						; get our direct page			beq starterr			; MIDI Tool Set not started			tsc						; reserve temporary space on the stack			sec			sbc #tempsize			tcs;;  call the appropriate function;			lda s_funcnum,s			; get the function number			asl a					; form index to jump table			tax			php						; disable interrupts			sei			jsr (functable,x)			plp;;  return (with error if A is non-zero);			tax						; save error code			tsc			clc			adc #tempsize			; discard temporary space on stack			tcsreturnerr	pld						; restore old direct page			PopArgs s_argsize		; move RTL addresses			txa						; restore error code			cmp #1					; set carry for error			rtlstarterr	ldx #miStartUpErr		; MIDI Tool Set not started			bra returnerr;;  function jump table;functable	DC.W choosedriver		; 0 - choose a device driver			DC.W installdriver		; 1 - load a device driver			DC.W ShutDriver			; 2 - shutdown the device driver			eject;;  Display device driver selection dialog;choosedriver			brk						; more to come...			eject;;  Load a device driver;installdriver			jsr ShutDriver			; shutdown and unload previous driver;;  check existence, file type, and aux type of the given file;			lda DirPage1 			; get direct page 1			tcd			lda s_driverrec+3,s		; calculate address of pathname			clc			adc #4			sta s_temp+3,s			lda s_driverrec+2+3,s			adc #0			sta s_temp+2+3,s			tsc						; calculate address of parameter block			clc			adc #s_temp+3			sta prodosparmaddr		; store it after prodos call			stz prodosparmaddr+2			lda #6					; store GET_FILE_INFO function number			sta prodosfuncnum			jsl ProdosGlue			; get information about this file			tax						; save possible error code			bcs loaderr1jmp			ldx #miDriverErr 		; check file type			lda s_temp+6+3,s			cmp #miDrvrFileType			bne loaderr1jmp			lda s_temp+8+3,s 		; check aux type			cmp #miDrvrAuxType			beq loadfileloaderr1jmp	jmp loaderror2			; Bug fix 5/25/89 mcloaderrjmp	jmp loaderror;;  load the file;loadfile	lda MidiZP2				; restore direct page for variables			tcd			tsc						; reserve space for results			sec			sbc #10			tcs			pea DriverUserId		; user ID for MIDI device drivers			lda s_temp+10+2+2+3,s			pha			lda s_temp+10+2+2+3,s			pha			pea 0			_InitialLoad			bcs loaderrjmp			pla			sta DriverID			; new device driver ID			pla			sta DriverAddr			; where it got loaded			pla			sta DriverAddr+2			pla			pla;;  copy driver table onto direct page;			ldy #dt_size-2dtloop		lda [DriverAddr],y		; copy one word per loop			tyx			sta dt_start,x			dey			dey			bpl dtloop;;  check current internal/external slot settings, and set;  up for the MIDI device;;  11 Aug 88 Don M ;  removed +2 from dpage reference below;			tsc						; make stack direct page			phd						; save direct page			tcd			ldy #2			lda [s_driverrec+3],y	; get internal/external setting			tay			lsr a					; carry set if external			lda [s_driverrec+3]		; get slot number			tax			pld						; get direct page 2			phb						; set data bank to current bank			phk			plb			sep #$20			longa off			lda SltROMSel			; examine current slot settings			and slotmasks,x			rep #$20			longa on			bcs slotextern			; slot must be external			beq slotok				; slot is internalsloterr		plb			lda #miDevSlotBusy		; slot is not available			rtsslotextern	beq sloterrslotok		plb						; restore data bank;;  call the driver initialization code;			pha						; reserve space for old interrupt vector			pha			pea 0					; new interrupt vector			tdc			clc			adc #MidiIntGlue-$100			pha			phx						; pass slot number			phy						; pass internal/external setting			pea DriverUserId		; pass our user ID			jsl DevInitGlue			; initialize device driver			tax			lda DirPage1 			; save old interrupt vector			tcd			pla			sta OldIntVector			pla			sep #$20			longa off			sta OldIntVector+2			rep #$20			longa on			bcs loaderror2 ;;  copy driver table onto direct page;			lda MidiZP2			tcd			ldy #dt_size-2dtloop2		lda [DriverAddr],y		; copy one word per loop			tyx			sta dt_start,x			dey			dey			bpl dtloop2;;  patch the driver interrupt handler in glue code;			pei dt_pollrecv+1		; remember address of routine to			pei dt_pollrecv			;	poll MIDI input			ldx dt_inthandler		; adjust to true address			inx			ldy dt_inthandler+1			lda DirPage1			tcd			sty DriverHandler+1		; order of storage makes a difference!			stx DriverHandler			plx						; restore MIDI input polling address			ply			sty DevPollAddr+1			inx						; adjust to true address			stx DevPollAddr			lda MidiZP2			tcd;;  set up MIDI input polling vector;			lda dt_pollrecv			inc a			sta MidiInputPoll+4			lda dt_pollrecv+2			sta MidiInputPoll+6			lda #0					; no errors			rts;;  some sort of error occurred.;loaderror	tax						; save error code			pla						; discard InitialLoad info			pla			pla			pla			plaloaderror1	lda DirPage1			tcdloaderror2	lda #driverdeath 		; brk if we get a driver interrupt			sta DriverHandler			lda #>driverdeath			sta DriverHandler+1			lda MidiZP2			tcd			stz DriverID	 		; no driver loaded			txa						; put error code in accumulator			rtsdriverdeath	brk						; here on driver interrupt if error									;   during driver loading;;  mask internal/external slot settings;slotmasks			DC.B %00000000			; can't set bit 0			DC.B %00000010			DC.B %00000100			DC.B %00000000			; can't set bit 3			DC.B %00010000			DC.B %00100000			DC.B %01000000			DC.B %10000000			ENDP			EJECT;-------------------------------------------------------;;  ShutDriver;;  This routine shuts down and unloads a device driver;  if one is present.;;  Returns carry set, error code in accumulator if;  there are problems.;;-------------------------------------------------------ShutDriver	PROC EXPORT			import UnloadDriver			IMPORT DevShutGlue		; midi.glue.aii						clc			lda DriverID	 		; is there a device driver?			beq done 				; no;;  shutdown and unload old device driver;			lda DirPage1 			; get direct page 1			tcd			lda OldIntVector+2		; push old interrupt vector			and #$00FF			pha			pei OldIntVector			lda MidiZP2				; restore direct page 2			tcd			jsl DevShutGlue			; shutdown the device driver			bcs done			jsr UnloadDriver 		; unload the driver from memorydone		rts			ENDP			EJECT;-------------------------------------------------------;;  ResetDriver;;  This routine resets and unloads a device driver;  if one is present.;;  Returns carry set, error code in accumulator if;  there are problems.;;-------------------------------------------------------ResetDriver	PROC EXPORT			import UnloadDriver			IMPORT DevResetGlue		; midi.glue.aii						clc			lda DriverID	 		; is there a device driver?			beq done 				; no;;  reset and unload old device driver;			lda DirPage1 			; get direct page 1			tcd			lda OldIntVector+2		; push old interrupt vector			and #$00FF			pha			pei OldIntVector			lda MidiZP2				; restore direct page 2			tcd			jsl DevResetGlue 		; shutdown the device driver			bcs done			jsr UnloadDriver 		; unload the driver from memorydone		rts			ENDP			EJECT;-------------------------------------------------------;;  UnloadDriver;;  Unload a device driver (which must be present) from;  memory.;;-------------------------------------------------------UnloadDriver PROC EXPORT			php						; interrupts better be disabled			sei			pea 0					; make space for extra info			pei DriverID			; device driver memory ID			pea $8000				; purge for quick reload			_UserShutdown			pla						; discard extra info			stz DriverID	 		; mark no driver loaded			stz InputEnabled			stz OutputEnabled			sep #$20			longa off			lda #$6B				; RTL			sta MidiInputPoll		; deactivate MIDI input polling vector			rep #$20			longa on			phd						; save direct page			lda DirPage1 			; modify timer interrupt routine so			tcd						;	that it won't poll MIDI input			lda NoPollBranch			sta TimerIntGlue			pld						; restore direct page			longa off			sep #$20			plp			longa on			lda #0			clc			rts			ENDP			END			