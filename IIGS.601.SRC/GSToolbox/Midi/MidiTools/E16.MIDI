				PRINT PUSH				PRINT OFF;;  File: E16.Midi;;;  Copyright Apple Computer, Inc. 1987;  All Rights Reserved;miToolNum		equ 32					; MIDI Tool Set number;  MIDI Tool Set error codesmiStartUpErr	equ 0+(miToolNum<<8)	; MIDI Tool Set wasn't startedmiPacketErr		equ 1+(miToolNum<<8)	; incorrect MIDI packet length receivedmiArrayErr		equ 2+(miToolNum<<8)	; an array wasn't correct sizemiFullBufErr	equ 3+(miToolNum<<8)	; buffer full errormiToolsErr		equ 4+(miToolNum<<8)	; tools needed inactive or wrong versionmiOutOffErr		equ 5+(miToolNum<<8)	; output must be enabled during flush										; note: no error 6miNoBufErr		equ 7+(miToolNum<<8)	; no buffer allocatedmiDriverErr		equ 8+(miToolNum<<8)	; file was not a MIDI device drivermiBadFreqErr	equ 9+(miToolNum<<8)	; can't set clock to requested frequencymiClockErr		equ 10+(miToolNum<<8)	; clock counter wrapped to zeromiConflictErr	equ 11+(miToolNum<<8)	; processes competing for MIDI inputmiNoDevErr		equ 12+(miToolNum<<8)	; no device driver is currently loaded;  device driver errorsmiDevNotAvail	equ $80+(miToolNum<<8)	; device not availablemiDevSlotBusy	equ $81+(miToolNum<<8)	; given slot is already in usemiDevBusy		equ $82+(miToolNum<<8)	; device is already in usemiDevOverrun	equ $83+(miToolNum<<8)	; device overrun by incoming MIDI datamiDevNoConnect	equ $84+(miToolNum<<8)	; no connection to MIDImiDevReadErr	equ $85+(miToolNum<<8)	; framing error in received datamiDevVersion	equ $86+(miToolNum<<8)	; ROM version or machine type is										;   incompatible with the drivermiDevIntHndlr	equ $87+(miToolNum<<8)	; conflicting interrupt handler has										;   been installed;;  driver error codes $88-$BF reserved for future use;  driver error codes $C0-$FF may be defined by drivers;;  PRODOS definition for MIDI device driversmiDrvrFileType	equ $00BB				; file type for device driversmiDrvrAuxType	equ $0300				; auxilliary type for MIDI device driver;  versions of tools requiredmiSTVer			equ $0101				; sound tool setmiNSVer			equ $0102				; note synthesizer;  MIDI input polling vectorMidiInputPoll	equ $E101B2;  MidiControl function codesmiSetRTVec		equ 0					; set real-time vectormiSetErrVec		equ 1					; set error vectormiSetInBuf		equ 2					; allocate input buffermiSetOutBuf		equ 3					; allocate output buffermiStartInput	equ 4					; initiate MIDI input processmiStartOutput	equ 5					; initiate MIDI output processmiStopInput		equ 6					; terminate MIDI input processmiStopOutput	equ 7					; terminate MIDI output processmiFlushInput	equ 8					; discard contents of input buffermiFlushOutput	equ 9					; discard contents of output buffermiFlushPacket	equ 10					; discard next input packetmiWaitOutput	equ 11					; wait for output buffer to emptymiSetInMode		equ 12					; set input modemiSetOutMode	equ 13					; set output modemiClrNotePad	equ 14					; clear notes on in the note padmiSetDelay		equ 15					; set minimum delay between output pktsmiOutputStat	equ 16					; enable/disable running status outputmiIgnoreSysEx	equ 17					; ignore/buffer system exclusive on inputmiRawMode		equ 0					; raw mode for MIDI input and outputmiPacketMode	equ 1					; packet mode for MIDI input and outputmiStandardMode	equ 2					; standard mode for MIDI input & output;  MidiDevice function codesmiSelectDrvr	equ 0					; display device driver selection dialogmiLoadDrvr		equ 1					; load and initialize a device drivermiUnloadDrvr	equ 2					; shutdown MIDI device;  MidiClock function codesmiSetClock		equ 0					; set time stamp clockmiStartClock	equ 1					; start time stamp clockmiStopClock		equ 2					; stop time stamp clockmiSetFreq		equ 3					; set clock frequency;  MidiInfo function codesmiNextPktLen	equ 0					; return length of next packetmiInputChars	equ 1					; return number of chars in input buffermiOutputChars	equ 2					; return number of chars in output bufmiMaxInChars	equ 3					; return max # of chars in input buffermiMaxOutChars	equ 4					; return max # of chars in output buffermiRecordAddr	equ 5					; return MIDI file recording addressmiPlayAddr		equ 6					; return MIDI file play addressmiClockValue	equ 7					; return current time stamp clock valuemiClockFreq		equ 8					; return no. of clock ticks per second				PRINT POP