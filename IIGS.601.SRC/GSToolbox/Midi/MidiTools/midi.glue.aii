;-------------------------------------------------------;;  midi.glue.aii;;  Miscellaneous glue routines needed to execute various;  routines from the MIDI Tool Set.;;  Copyright 1987, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;  19 Nov 87   DM	New today;;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';;  call a Prodos function;;  NOTE: direct page register must be set to direct;		 page for code;ProdosGlue	PROC EXPORT			pea 0					; push 0 bank			phb			pla			tdc						; calculate low word of address			clc			adc #ProdosCall-1			pha			rtl			ENDP;;  write to the DOC registers;;  This call must preserve A and X;WriteDocGlue PROC EXPORT			pei WriteRegAddr+1			sep #$10 				; short Y			ldy WriteRegAddr			phy			rep #$10 				; long Y			rtl			ENDP;;  call real time vector;;  A word on the stack contains the;  MIDI real-time status byte;RealTimeGlue PROC EXPORT			pei RealTimeVec+1			pei DataBank 			; set data bank for vector code			plb			lda RealTimeVec			sta 1,s			rtl			ENDP;;  call error vector;;  A word on the stack contains the;  real-time error code;ErrorGlue	PROC EXPORT			lda ErrorVec+1			; is there an error vector?			ora ErrorVec			beq return			pei ErrorVec+1			pei DataBank 			; set data bank for vector code			plb			lda ErrorVec			sta 1,sreturn		rtl			ENDP;;  call input ready vector;InputVecGlue PROC EXPORT			pei InputVec+1			pei DataBank 			; set data bank for where we're going			plb			lda InputVec			sta 1,s			rtl			ENDP;;  call output ready vector;OutputVecGlue PROC EXPORT			pei OutputVec+1			pei DataBank 			; set data bank for where we're going			plb			lda OutputVec			sta 1,s			rtl			ENDP;;  call our pre-modified MVP instruction on direct page;MVPGlue 	PROC EXPORT			pei MVPaddr+2			; push address - 1 of mvp instruction			pei MVPaddr				;	and the current data bank register			rtl			ENDP;;  call driver initialization routine;DevInitGlue	PROC EXPORT			pei dt_init+1			phb			lda dt_init			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP;;  call driver shutdown routine;DevShutGlue	PROC EXPORT			pei dt_shutdown+1			phb			lda dt_shutdown			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP;;  call driver reset routine;DevResetGlue PROC EXPORT			pei dt_reset+1			phb			lda dt_reset			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP;;  call driver receiver polling routine;  (NO LONGER NEEDED DUE TO NEW "MIDIINPUTPOLL" VECTOR.);DevPollRcvGlue PROC EXPORT;			pei dt_pollrecv+1;			phb;			lda dt_pollrecv;			sta 1,s;			lda DirPage1 			; point to driver's direct page;			rtl;			ENDP;;  call driver receiver interrupt enable;DevRcvOnGlue PROC EXPORT			pei dt_recvinton+1			phb			lda dt_recvinton			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP;;  call driver receiver interrupt disable;DevRcvOffGlue PROC EXPORT			pei dt_recvintoff+1			phb			lda dt_recvintoff			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP;;  call driver transmitter polling routine;DevPollXmtGlue PROC EXPORT			pei dt_pollxmit+1			phb			lda dt_pollxmit			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP;;  call driver transmitter interrupt enable;DevXmtOnGlue PROC EXPORT			pei dt_xmitinton+1			phb			lda dt_xmitinton			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP;;  call driver transmitter interrupt disable;DevXmtOffGlue PROC EXPORT			pei dt_xmitintoff+1			phb			lda dt_xmitintoff			sta 1,s			lda DirPage1 			; point to driver's direct page			rtl			ENDP			END			