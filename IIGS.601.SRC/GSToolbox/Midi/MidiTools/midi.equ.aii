			PRINT NOGEN,NOHDR,NOSTAT,NOMDIR			PRINT PUSH			PRINT OFF			PAGESIZE 71;-------------------------------------------------------;;  midi.equ.aii;;  Global equates and direct-page assignments used;  by the MIDI Tool Set and device drivers.;;  Copyright 1987-89, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;  27 Aug 87   DM	New today;  20 Nov 87   DM	Split into three direct pages;  27 Oct 88   MD	Added TicksPerSec;;-------------------------------------------------------			INCLUDE 'e16.midi'		; include public definitions;;  Global constants;MidiVerNum		equ $0103			; 5/31/89 take prototype bit out for System Disk 5.0MidiMode		equ 4				; mode for reserving DOC generatorDriverUserId	equ $4100+miToolNum	; user ID for loading MIDI device driversBufferUserId	equ $4200+miToolNum	; user ID for allocating input/output buffers; **** MAXIMUM BUFFER SIZE IS 32767.  This is hard-coded.InBufSizeDflt	equ 8192 			; default input buffer sizeOutBufSizeDflt	equ 8192 			; default output buffer sizeAveDataSize		equ 10				; length of average MIDI record in									;   a buffer (3 bytes MIDI packet +									;	2 bytes length info + 4 bytes									;	time stamp + 1 byte error code);;  Tool set definitions;SoundToolNum	equ 8				; Sound Tool set number;;  MIDI definitions;StartSysExcl	equ $F0				; start of system exclusive dataEndSysExcl		equ $F7				; end of system exclusive data;;  Hardware/firmware definitions;SGctrl			equ $E1C03C			; sound glu stat regSGdata			equ $E1C03D			; sound glu data regSGadrl			equ $E1C03E			; sound glu address-low regIRQ_Volume		equ $E100CA			; to save the DOC volumeSltROMSel		equ $E1C02D			; slot ROM selectCYAREG			equ $E1C036			; for switching processor to 1Mhz speedDefClkFreq		equ 13160			; clock freq. (1 tick / 76 microseconds);;  PRODOS definitions;Prodos			equ $E100A8			; PRODOS entry vector				eject;-------------------------------------------------------;;  Direct Page assignments;;  The MIDI Tool Set uses three direct pages.  The;  first direct page contains small code routines and;  device driver variables.  The second direct page;  contains all variables used by the MIDI Tool Set.;  The third direct page is used to track note on;  commands so that notes can be turned off efficiently.;;-------------------------------------------------------;-------------------------------------------------------;;  Direct page 1;;  The first half of this direct page contains self-;  modified code fragments used by the MIDI Tool Set;  and interrupt handlers.;;  The second half of this direct page is reserved for;  use by device drivers.;;-------------------------------------------------------				DSect 1			  ; start global data section; **** IMPORTANT NOTE:	Yes, we are beginning our direct; ****	  page definition at offset one instead of zero.; ****	  "MidiBufJml" must be defined at offset one in; ****	  order to work correctly.	Do not do anything; ****	  to disturb this fragile arrangement!MidiBufJml		block 4	  ; jml BufDispatcher;;  Midi interrupt glue;;  This small routine is called on a MIDI interrupt.;  It is located on zero page because it is modified;  by the MIDI Tool Set.  It could be done without;  modified code, but it would be slower.;MidiIntGlue		block 2	  ; rep #$30	; long accumulator and index registers				block 1	  ; lda 		; get direct page 1MidiZP1 		block 2	  ; 	#XXXX				block 1	  ; jslDriverHandler	block 3	  ; 	XXXXXX	; call driver interrupt handler				block 2	  ; sep #$30	; short accumulator and index registers				block 2	  ; bcs oldvec	; driver didn't service the interrupt				block 1	  ; rtl				block 1	  ;oldvec jml	; call old interrupt service routineOldIntVector	block 3	  ; 	XXXXXX;;  This routine is called during service of a DOC;  interrupt.  It first calls the device driver to;  poll MIDI input to avoid data lossage, then it;  checks to see if it is our oscillator that;  needs service.  If not, it passes the interrupt;  on to other routines.;TimerIntGlue	block 2	  ; bra XX (NoPoll)  ; modified if MIDI input enabled				block 1	  ; phk 		; push address of polling routine to				block 1	  ; pea 		;	be called again before executionPollInputAddr	block 2	  ; 	XXXX	;	returns to the Sound Tools				block 1	  ; pha 		; save oscillator mode				block 1	  ; jsl 		; call routine to poll MIDI inputPollInputAddr2	block 3	  ; 	XXXXXX				block 1	  ; pla 		; restore which oscillator mode				block 2	  ;NoPoll cmp #MidiMode ; is oscillator our mode?				block 2	  ; beq IncTimer; yes, increment time stamp clock				block 1	  ; jml			; call routine to handle other osc.OtherOscVec		block 3	  ; 	XXXXXX				block 2	  ;IncTimer rep #$30 ; long accumulator and registers				block 1	  ; lda 		; get direct page 2MidiZP2 		block 2	  ; 	#XXXX				block 4	  ; jml ClockHandler;;  poll MIDI input;PollInput		block 2	  ; rep #$30	; long accumulator and registers				block 1	  ; lda 		; get direct page 1MidiZP1b		block 2	  ; 	#XXXX				block 1	  ; jsl 		; call routine to poll MIDI inputDevPollAddr		block 3	  ; 	XXXXXX				block 2	  ; sep #$30	; short accumulator and registers				block 1	  ; rtl;;  This routine implements a MVP instruction in;  which the source and destination banks can be;  modified.;MVPinst 		block 1	  ; mvpMVPdestbank		block 1	  ; 	XX,MVPsourcebank	block 1	  ; 	XX				block 1	  ; plb 		; restore data bank register				block 1	  ; rtl;;  PRODOS call.  This routine allows the MIDI Tool;  Set to make PRODOS calls that unfortunately require;  certain parameters to be imbedded in code instead of;  passed on the stack.;ProdosCall		block 4	  ; jsl Prodos	; call PRODOSprodosfuncnum	block 2					; PRODOS function numberprodosparmaddr	block 4					; PRODOS parameter block address				block 1	  ; rtl;;  These locations contain two different BRA instructions;  that are patched into the "TimerIntGlue" depending on;  whether MIDI input must be polled or not.;PollBranch		block 2					; BRA instruction for pollingNoPollBranch	block 2					; BRA instruction for no polling;;  Make sure that code fragments use less than $80 bytes,;  because offsets $80-$FF are reserved for driver usage.  If;  usage exceeds this limit, an assembly error is generated;  at this time.;enddp1			DSectSize				; end of direct page 1 usage				CheckSize enddp1,$80 	; make sure we are <= $80				eject;-------------------------------------------------------;;  Direct page 2;;  MIDI Tool Set variables;;-------------------------------------------------------				DSect 0UserId			word 					; our ID for memory managerDataBank		byte 					; application's data bank registerDirPage1		word 					; address of direct page 1DirPage3		word 					; address of direct page 3;;  input buffer;InBufHandle		long 					; handle to input bufferInBufAddr		long 					; address of input bufferInBufSize		word 					; size of input bufferInBufHead		word 					; index to head of queueInBufTail		word 					; index to tail of queueInBufEnd		word 					; index at which to wrap to startInBufError		word 					; input error codeInBufMaxChars	word 					; maximum chars in input bufferInBufFull		word					; $FFFF = in buf overflow in raw modeInputEnabled	word 					; 0 = input disabled, $FFFF = enabledInputMode		word 					; raw, packet, or standard input formatLastInTime		long					; time when last character receivedPacketStatus	word 					; MIDI status byte of current packetPacketIndex		word 					; location of start of packet in InBufPacketLength	word 					; length of current packetPacketRemain	word 					; remaining length of current packetIgnoreSysEx		word					; ignore sysex packets (=$00F0) or store										;   them (=$FFFF);;  output buffer;OutBufHandle	long 					; handle to output bufferOutBufAddr		long 					; address of output bufferOutBufSize		word 					; size of output bufferOutBufHead		word 					; index to head of queueOutBufTail		word 					; index to tail of queueOutBufEnd		word 					; index at which to wrap to startOutBufMaxChars	word 					; maximum chars in output bufferOutBufEmpty		word 					; 0 = output buffer contains dataOutputEnabled	word 					; 0 = output disabled, $FFFF = enabledOutputMode		word					; raw, packet, or standard output formatOutputStat		word					; 0 = no running status, $FFFF = enabledOutputDelay		word 					; delay between output packets (76 usec)PacketChars		word 					; # of chars remaining in packet at headRealTimeChars	word 					; # of real time chars at head of bufLastStatus		word 					; status byte of last packet sent;;  vectors to application code;RealTimeVec		block 3					; vector for real-time MIDI dataErrorVec		block 3					; vector for real-time errorsInputVec		block 3					; input packet interrupt vectorOutputVec		block 3					; output packet interrupt vector;;  time stamp clock;MidiGenerator	word 					; our DOC generator for timerMidiOsc 		byte 					; our DOC oscillator for timerTimerData		byte 					; index to DOC waveform sample registerTimer			long 					; time stamp clock valueTimerEnabled	word 					; 0 = clock stopped, $FFFF = startedTimerValid		word 					; non-zero = timer already incrementedLastOutTime		long 					; timer value when last char outputNextOutTime		long 					; valid timer value for next output charTimeStamp		long 					; time stamp indicated by output packetWriteRegAddr	long 					; addr of routine to write DOC registersTicksPerSec		word					; defined as long, but caon only use word.										; The frequncey of the clock in TicksPerSec.										; div by 51.40625 to get value for freq reg.;;  a copy of the driver table;  *** must contain an even number of bytes ***;DriverAddr		long 					; address of device driver in memoryDriverID		word					; ID of device driver segment (0 if none)dt_start		DSectSize				; start of driver tabledt_init 		long 					; addr of initialization routine - 1dt_shutdown		long 					; addr of shutdown routine - 1dt_reset		long 					; addr of reset routine - 1dt_inthandler	long 					; addr of interrupt handler - 1dt_pollrecv		long 					; addr of routine to poll receiver - 1dt_recvinton	long 					; addr of proc to enable recv ints - 1dt_recvintoff	long 					; addr of proc to disable recv ints - 1dt_pollxmit		long 					; addr of proc to poll transmitter - 1dt_xmitinton	long 					; addr of proc to enable xmit ints - 1dt_xmitintoff	long 					; addr of proc to disable xmit ints - 1dt_reserved1	long 					; reserveddt_reserved2	long 					; reserveddt_end			DSectSize				; end of driver tabledt_size 		equ dt_end-dt_start		; size of driver table;;  miscellaneous stuff;MVPaddr 		block 4					; contains absolute address - 1 of										;	the MVP instruction in our first										;	direct page and the current data										;	bank register;;  MidiReadPacket variables;MRactive		word					; MidiReadPacket is currently active (for reentrant test)MRpoll			word					; poll MIDI input at intervalsMRarray			long					; address of array to transfer packet toMRlength		word					; packet lengthMRhead			word					; new input buffer head indexMRerror			word					; error code;;  MidiWritePacket variables;MWactive		word					; MidiWritePacket is currently active (reentrant test)MWpoll			word					; poll MIDI input at intervalsMWarray			long					; address of array to get packet fromMWlength		word					; packet lengthMWtail			word					; new output buffer tail indexMWsource		word					; index for moving real-time charactersMWdest			word					; index for moving real-time characters;;  some temporary variables that routines can use as they please;Temp1			longTemp2			longTemp3			longTemp4			longTemp5			long;;  Make sure that MIDI Tool Set variables require less than $100 bytes,;  because we are limited to one page.	If usage exceeds this limit,;  an assembly error is generated at this time.;enddp2			DSectSize				; end of MIDI Tool direct page 2				CheckSize enddp2,$100	; make sure we are <= $100				eject;-------------------------------------------------------;;  Direct page 3;;  This page is used as a scratchpad in order to mark;  notes that have been turned on using MIDI note on;  commands and have not yet been turned off.  This;  information is needed to generate note off commands;  for all notes currently on when the output buffer;  is flushed.;;-------------------------------------------------------				DSect 0NotePad 		block 256				; note status array;;  Make sure that direct page 3 usage is less than $100 bytes,;  because we are limited to one page.	If usage exceeds this limit,;  an assembly error is generated at this time.;enddp3			DSectSize				; end of MIDI Tool direct page 3				CheckSize enddp3,$100	; make sure we are <= $100				PRINT POP