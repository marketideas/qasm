;-------------------------------------------------------;;  midi.notes.aii;;  This module contains routines which keep track of;  notes currently playing on the external synthesizer.;;  Copyright 1987, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;  11 Nov 87   DM	New today;;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';;  masks used to turn notes on and off in the note array;NoteMasks	PROC			EXPORT noteonmask			EXPORT noteoffmasknoteonmask	DC.B %00000000,%00000001			DC.B %00000000,%00000010			DC.B %00000000,%00000100			DC.B %00000000,%00001000			DC.B %00000000,%00010000			DC.B %00000000,%00100000			DC.B %00000000,%01000000			DC.B %00000000,%10000000			DC.B %00000001,%00000000			DC.B %00000010,%00000000			DC.B %00000100,%00000000			DC.B %00001000,%00000000			DC.B %00010000,%00000000			DC.B %00100000,%00000000			DC.B %01000000,%00000000			DC.B %10000000,%00000000noteoffmask DC.B %11111111,%11111110			DC.B %11111111,%11111101			DC.B %11111111,%11111011			DC.B %11111111,%11110111			DC.B %11111111,%11101111			DC.B %11111111,%11011111			DC.B %11111111,%10111111			DC.B %11111111,%01111111			DC.B %11111110,%11111111			DC.B %11111101,%11111111			DC.B %11111011,%11111111			DC.B %11110111,%11111111			DC.B %11101111,%11111111			DC.B %11011111,%11111111			DC.B %10111111,%11111111			DC.B %01111111,%11111111			ENDP			EJECT;-------------------------------------------------------;;  ClearNotes;;  Clear note array to all notes off.;;-------------------------------------------------------ClearNotes	PROC EXPORT			lda DirPage3 			; note array is on third direct page			tcd			ldx #$3Eclearloop	stz $00,x			stz $40,x			stz $80,x			stz $C0,x			dex			dex			bpl clearloop			sec						; restore direct page			sbc #$100			tcd			rts			ENDP			EJECT;-------------------------------------------------------;;  ClearNotesChannel;;  Clear note array to all notes off in the channel;  number passed in the accumulator.;;-------------------------------------------------------ClearNotesChannel PROC EXPORT			phb						; save data bank register			phk						; set data bank reg. to this bank			plb			asl a					; make channel number index			tay			lda noteoffmask,y			tay						; save note off mask in Y			plb						; restore data bank register			lda DirPage3 			; note array is on third direct page			tcd			ldx #$3Eclearloop	tya						; clear 4 notes per loop for speed			and $00,x			sta $00,x			tya			and $40,x			sta $40,x			tya			and $80,x			sta $80,x			tya			and $C0,x			sta $C0,x			dex			dex			bpl clearloop			tdc			sec			sbc #$100				; restore direct page			tcd			rts			ENDP			EJECT;-------------------------------------------------------;;  NoteOnOff;;  Record a note on or note off event in note array.;;  The following assumptions are made:;		called with short accumulator;		A contains the status byte of the MIDI packet;		Y contains index to status byte in;				the output buffer;;		low byte of A, X, Y are preserved;;-------------------------------------------------------NoteOnOff	PROC EXPORT			longa off				; short accumulator			phb						; save data bank register			phk						; set data bank reg. to this bank			plb			phx						; save X			asl a			cmp #$20 				; is it note on or note off?			rep #$20 				; long accumulator			longa on			and #$001F				; form channel index			tax			iny			lda [OutBufAddr],y		; get pitch and velocity			dey			bcc noteoff			bit #$FF00			beq noteoff				; note on with zero velocity is note off			and #$007F				; form pitch index			asl a			pha			lda DirPage3 			; point direct page to note array			tcd			lda noteonmask,x 		; find the bit to set			plx			ora 0,x					; set the bit corresponding to this note			sta 0,x			tdc						; restore direct page*			clc						; carry clear from ASL above			sbc #$FF			tcd			sep #$20 				; restore accumulator			longa off			lda [OutBufAddr],y			plx						; restore X			plb						; restore data bank			rts			longa onnoteoff 	and #$007F				; form pitch index			asl a			pha			lda DirPage3 			; point direct page to note array			tcd			lda noteoffmask,x		; find the bit to clear			plx			and 0,x					; clr the bit corresponding to this note			sta 0,x			tdc						; restore direct page*			clc						; carry clear from ASL above			sbc #$FF			tcd			sep #$20 				; restore accumulator			longa off			lda [OutBufAddr],y			plx						; restore X			plb						; restore data bank			rts			longa on			ENDP			EJECT;-------------------------------------------------------;;  TurnOffNotes;;  Turn off the notes that we think are on.;  The accumulator indicates which MIDI channel (0-F);  to turn off, or all channels if A >= $10.;;  Output must be turned on and interrupts enabled,;  or this routine will hang.;  The clock should be running in order to detect;  transmission difficulties.;  Does not wait for output buffer to clear after note;  off commands are buffered.;;-------------------------------------------------------TurnOffNotes PROC EXPORT;;  stack offsets;			DefineStacks_firstnote	word 					; first on note in this channels_packet	block 10 				; packet to be sents_databank	byte 					; old data bank register			asl a					; multiply channel by two			tay						; save channel times two			phb						; save data bank register			phk						; set data bank reg. to this bank			plb			lda DirPage3 			; set direct page to note array			tcd			lda #0					; reserve space on stack for packet			pha			pha			pha			pha			pea 7					; length of note off packets			pha						; reserve space for s_firstnote boolean			cpy #$20 				; all channels?			bcc onechannel			ldy #0					; turn off notes, channel 0			jsr channotesoff			ldy #1*2 				; channel 1			jsr channotesoff			ldy #2*2 				; channel 2			jsr channotesoff			ldy #3*2 				; channel 3			jsr channotesoff			ldy #4*2 				; channel 4			jsr channotesoff			ldy #5*2 				; channel 5			jsr channotesoff			ldy #6*2 				; channel 6			jsr channotesoff			ldy #7*2 				; channel 7			jsr channotesoff			ldy #8*2 				; channel 8			jsr channotesoff			ldy #9*2 				; channel 9			jsr channotesoff			ldy #10*2				; channel 10			jsr channotesoff			ldy #11*2				; channel 11			jsr channotesoff			ldy #12*2				; channel 12			jsr channotesoff			ldy #13*2				; channel 13			jsr channotesoff			ldy #14*2				; channel 14			jsr channotesoff			ldy #15*2				; channel 15onechannel	jsr channotesoff			tdc						; restore direct page			sec			sbc #$100			tcd			tsc						; discard info on the stack			adc #11			tcs			plb						; restore data bank register			rts;;  turn off notes in channel Y/2;channotesoff			lda #0					; no on note found yet			sta s_firstnote+2,s			lda noteonmask,y			ldx #254scannotes	bit 0,x					; is this note on in this channel?			bne foundnoteonscannotes1	dex			dex			bpl scannotes			rtsfoundnoteon	lda s_firstnote+2,s		; is this the first note in this channel			bne notfirstnote 		; no			dec a					; now we've seen a note in this channel			sta s_firstnote+2,s			tya						; construct all notes off status byte			lsr a			ora #$7BB0			sta s_packet+6+2,s			phx						; save pitch			phy						; save channelsendalloff	tsc						; calculate address of packet			clc			pha						; space for result			adc #s_packet+4+2			pea 0			pha			_MidiWritePacket			pla			beq sendalloff			; output buffer is full, try again			ply						; restore channel			plx						; restore pitch			tya						; construct note off status byte			lsr a			ora #$0080			sta s_packet+6+2,snotfirstnote			txa						; construct note off pitch			lsr a			sta s_packet+7+2,s			phx						; save pitch			phy						; save channelsendnoteoff	tsc						; calculate address of packet			clc			pha						; space for result			adc #s_packet+4+2			pea 0			pha			_MidiWritePacket			pla			beq sendnoteoff			; output buffer is full, try again			ply						; restore channel			plx						; restore pitch			lda noteonmask,y 		; restore bit mask			jmp scannotes1			; continue			ENDP			EJECT;-------------------------------------------------------;;  PanicNotesOff;;  Turn off all possible notes in the channel given;  by the accumulator.;  The accumulator indicates which MIDI channel (0-F);  to turn off, or all channels if A >= $10.;;  Output must be turned on and interrupts enabled,;  or this routine will hang.;  The clock should be running in order to detect;  transmission difficulties.;  Does not wait for output buffer to clear after note;  off commands are buffered.;;-------------------------------------------------------PanicNotesOff PROC EXPORT;;  stack offsets;s_packet	equ 1					; packet to be sent			tay						; save channel			lda #0					; reserve space on stack for packet			pha			pha			pha			pha			pea 7					; length of note off packets			cpy #$10 				; all channels?			bcc onechannel			ldy #0					; channel 0			jsr chanpanicoff			ldy #1					; channel 1			jsr chanpanicoff			ldy #2					; channel 2			jsr chanpanicoff			ldy #3					; channel 3			jsr chanpanicoff			ldy #4					; channel 4			jsr chanpanicoff			ldy #5					; channel 5			jsr chanpanicoff			ldy #6					; channel 6			jsr chanpanicoff			ldy #7					; channel 7			jsr chanpanicoff			ldy #8					; channel 8			jsr chanpanicoff			ldy #9					; channel 9			jsr chanpanicoff			ldy #10					; channel 10			jsr chanpanicoff			ldy #11					; channel 11			jsr chanpanicoff			ldy #12					; channel 12			jsr chanpanicoff			ldy #13					; channel 13			jsr chanpanicoff			ldy #14					; channel 14			jsr chanpanicoff			ldy #15					; channel 15onechannel	jsr chanpanicoff			tsc						; discard info on the stack			clc			adc #10			tcs			rts;;  turn all notes off on channel Y;chanpanicoff			tya						; construct all notes off status byte			ora #$7BB0			sta s_packet+6+2,s			phy						; save channelsendalloff	tsc						; calculate address of packet			clc			pha						; space for result			adc #s_packet+2+2			pea 0			pha			_MidiWritePacket			pla			beq sendalloff			; output buffer is full, try again			ply						; restore channel;;  send individual note off commands on this channel;			tya						; form note off status byte			ora #$0080			sta s_packet+6+2,s			ldx #127 				; start with pitch 127nextnote	txa						; store pitch for this note			sta s_packet+7+2,s			phx						; save pitch			phy						; save channelsendnoteoff	tsc						; calculate address of packet			clc			pha						; space for result			adc #s_packet+4+2			pea 0			pha			_MidiWritePacket			pla			beq sendnoteoff			; output buffer is full, try again			ply						; restore channel			plx						; restore pitch			dex						; next pitch			bpl nextnote			rts			ENDP			END			