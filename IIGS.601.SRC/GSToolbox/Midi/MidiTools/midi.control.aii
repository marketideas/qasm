;-------------------------------------------------------;;  midi.control.aii;;  This module contains routines which control the;  operation of the MIDI Tool Set.;;  Copyright 1987, 1988 Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;	2 Sep 87   DM	New today;  20 Nov 87   DM	Major reorganization and addition;					of functions to MidiControl.;  23 Nov 87   DM	Split MidiInfo into its own file.;** 3-20-89		Mark Cecys*  Patch in local QD cursor and EM with midi polling*  Affected code:*			begininput*			endinput*			endoutput* 5/25/89	Mark Cecys*  Bug fix in discardoutbuf. EmptyOutBuf returns with 'a' reg*  set to 0001. Function dispatcher interprets this as an error code.;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';-------------------------------------------------------;;  MidiControl -- call number 9;;  This routine controls operation of the MIDI Tool Set.;  The routine is passed two arguments: a word;  indicating the control function to perform, and a;  long argument that is used by the control function.;;  Control function numbers are as follows:;;		 0 - set real-time vector.	The long argument;			 contains the address of a routine;			 the MIDI Tool Set calls when MIDI real-;			 time commands are received.  A value of;			 zero disables the real-time call.;		 1 - set real-time error vector.  The long;			 argument contains the address of a routine;			 the MIDI Tool Set calls when various;			 real-time error conditions are detected;			 (miClockErr, miDevNoConnect).	A value;			 of zero disables the real-time call.;		 2 - set input buffer.	The long argument is;			 a pointer to a 6-byte record containing;			 a word indicating the size of the buffer;			 to allocate, and a long indicating;			 the address of the buffer.;		 3 - set output buffer.  The long argument is;			 a pointer to a 6-byte record containing;			 a word indicating the size of the buffer;			 to allocate, and a long indicating the;			 address of the buffer.;		 4 - start input.  The long argument, if non-zero,;			 specifies the address of a routine to be;			 called when the first packet is available in;			 the input buffer.;		 5 - start output.	The long argument, if;			 non-zero, specifies the address of a;			 routine to be called when the output buffer;			 is empty.;		 6 - stop input.  The long argument is ignored.;		 7 - stop output.  The long argument is ignored.;		 8 - flush input.  The long argument is ignored.;		 9 - flush output.	Waits for the current;			 packet to finish transmission, then clears;			 the output buffer, sends note off commands,;			 and waits for these packets to clear from;			 the output buffer.  Error is returned if;			 output is not enabled.  The clock should be running;			 in order to detect transmission difficulties.;			 The long argument determines how note off;			 commands are generated.  If it is negative,;			 the output buffer is immediately flushed;			 without waiting for a partly-transmitted;			 packet to finish, and no note off commands;			 are generated.  If the long argument is zero,;			 note off commands are sent only for;			 those notes that are marked on in the note;			 array.  If the long argument is positive,;			 all note off and individual note off commands;			 are generated for every possible note on;			 every channel.;		 10 - flush next input packet.	The long argument;			 is ignored.;		 11 - wait for empty output buffer.  The long;			 argument is ignored.;		 12 - set input mode.  Packet/raw mode.  The;			 high word of the long argument contains;			 a mask to indicate which bits of the input;			 mode to set or clear, and the low word;			 contains the values of the corresponding;			 bits.;		 13 - set output mode.	Running status on/off.;			 The high word of the long argument contains;			 a mask to indecate which bits of the output;			 mode to set or clear, and the low word;			 contains the values of the corresponding;			 bits.;		 14 - clear note pad.  If the long argument is;			 less than 16, all notes in the corresponding;			 MIDI channel are marked off.  Otherwise,;			 all notes in all channels are marked off.;		 15 - set minimum delay between output packets.;			 The low word of the long argument specifies;			 the delay in units corresponding to one-half;			 of the time it takes to transmit one MIDI;			 character.;		 16 - enable/disable running status output.;			 The low word of the long argument is 0;			 to disable, 1 to enable.;		 17 - ignore system exclusive packets on input.;			 The low word of the long argument is 1 to;			 ignore system exclusive packets, 0 to buffer;			 them normally.;;  Inputs:;		 function number (word);		 argument used by various functions (long);;  Outputs:;		 none;;  Registers:;		 not preserved;;-------------------------------------------------------MidiControl	PROC EXPORT			PRINT PUSH			PRINT OFF			INCLUDE 'e16.memory' 	; memory manager equates			PRINT POP						import WaitOutput						IMPORT EmptyInBuf		; midi.buffer.aii			IMPORT EmptyOutBuf						IMPORT ClearNotes		; midi.notes.aii			IMPORT ClearNotesChannel			IMPORT PanicNotesOff			IMPORT TurnOffNotes						IMPORT DevPollXmtGlue	; midi.glue.aii			IMPORT DevRcvOffGlue			IMPORT DevRcvOnGlue			IMPORT DevXmtOffGlue			IMPORT InputVecGlue			IMPORT OutputVecGlue			IMPORT Mouse			IMPORT MouseTask			IMPORT iDrawCursor			IMPORT iUndrawCursor						IMPORT GetNextEvent			IMPORT EventAvail			IMPORT GetMouse			IMPORT Button			IMPORT StillDown			IMPORT WaitMouseUp			IMPORT PostEvent			IMPORT FlushEvents			IMPORT GetOSEvent			IMPORT OSEventAvail				IMPORT SetCursor			IMPORT UserInitCursor					EXPORT XSHIFTSTAY:EQUXSHIFTSTAY EQU $E01E84		EXPORT XSHIFTOUT:EQUXSHIFTOUT EQU $E01E8C;;  stack offsets;			DefineStacks_dirpage   word 					; old direct pages_rtl1		block 3					; first rtl addresss_rtl2		block 3					; second rtl addresss_argstart	DSectSize				; start of argumentss_argument	long 					; argument used by functionss_funcnum	word 					; function numbers_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstart;;  temporary variables;arg 		equ Temp1				; the passed argument;;  initialize direct page register;			phd						; save old direct page			tcd						; get our direct page			beq starterr			; MIDI Tool Set not started;;  call the appropriate function;			lda s_funcnum,s			; get the function number			asl a					; form index to jump table			tax			lda s_argument,s 		; put argument on direct page so we			sta arg					;	don't have to do weird stack stuff			lda s_argument+2,s			sta arg+2			php						; disable interrupts			sei			jsr (functable,x);;  return (with error if A is non-zero);			plp						; restore interrupts			tax						; save error codereturnerr	pld						; restore old direct page			PopArgs s_argsize		; move RTL addresses			txa						; restore error code			cmp #1					; set carry for error			rtlstarterr	ldx #miStartUpErr		; MIDI Tool Set not started			bra returnerr;;  function jump table;functable	DC.W initrealtime		; 0 - install real time vector			DC.W initerrvec			; 1 - install error vector			DC.W initinbuffer		; 2 - initialize input buffer			DC.W initoutbuffer		; 3 - initialize output buffer			DC.W begininput			; 4 - begin input			DC.W beginoutput		; 5 - begin output			DC.W endinput			; 6 - terminate input			DC.W endoutput			; 7 - terminate output			DC.W discardinbuf		; 8 - empty input buffer			DC.W discardoutbuf		; 9 - empty output buffer			DC.W discardpacket		; 10 - discard input packet			DC.W WaitOutput			; 11 - wait for output buffer to empty			DC.W setinmode			; 12 - set input mode			DC.W setoutmode			; 13 - set output mode			DC.W marknotesoff		; 14 - clear note pad			DC.W setoutdelay		; 15 - set output packet delay			DC.W runstatout			; 16 - enable/disable running status out			DC.W ignsysexcl			; 17 - ignore/buffer system excl. packets						eject;;  install the address of a routine to be called with;  MIDI real-time commands.  If the argument is zero,;  the real-time call will be disabled.;initrealtime			lda arg					; install real-time vector			sta RealTimeVec			lda arg+1			sta RealTimeVec+1			ora RealTimeVec			beq @1			dec RealTimeVec			; prepare for RTL call@1			lda #0					; no errors			rts;;  install the address of a routine to be called when;  real-time errors are detected.  If the argument is;  zero, the real-time call will be disabled.;initerrvec	lda arg					; install real-time vector			sta ErrorVec			lda arg+1			sta ErrorVec+1			ora ErrorVec			beq @1			dec ErrorVec 			; prepare for RTL call@1			lda #0					; no errors			rts;;  allocate and initialize the input buffer;initinbuffer			lda InBufHandle+2		; did we already allocate a buffer?			ora InBufHandle			beq noinbuf			pei InBufHandle+2		; dispose old input buffer			pei InBufHandle			_DisposeHandle			stz InBufHandle+2		; clear handle (no buffer allocated by			stz InBufHandle			;	MIDI Tool Set yet)noinbuf 	ldy #2					; is address of buffer zero?			lda [arg],y			ldy #4			ora [arg],y			beq allocinbuf			; allocate buffer dynamically			lda [arg]				; buffer size must be < 32768			bmi badinsize			cmp #32					; buffer size must be >= 32			bcc badinsize			sta InBufSize			; save information			ldy #2			lda [arg],y			sta InBufAddr			ldy #4			lda [arg],y			sta InBufAddr+2			bra gotinbufallocinbuf	lda [arg]				; get size of input buffer			bmi done1				; don't allocate a new buffer			bne gotinsize			lda #InBufSizeDflt		; allocate default buffer sizegotinsize	cmp #32					; verify buffer minimum size			bcs inbufokbadinsize   lda #miArrayErr			; buffer is illegal sizebadinmem    stz InBufSize			; no input buffer			rtsinbufok 	sta InBufSize			pea 0					; reserve space for handle			pea 0			pea 0					; size of buffer			pha			pea BufferUserId		; user id			pea attrNoPurge+attrNoCross+attrFixed  ; memory attributes			pea 0					; no special address			pea 0			_NewHandle			plx						; dereference the handle			stx InBufHandle			plx			stx InBufHandle+2			bcs badinmem			lda [InBufHandle]			sta InBufAddr			ldy #2			lda [InBufHandle],y			sta InBufAddr+2gotinbuf	jsr EmptyInBuf			; initialize buffer to empty			sec			lda InBufSize			; determine index so we can store a			sbc #AveDataSize 		;	packet near end without wrapping			sta InBufEnd			stz InputEnabled 		; disable input initiallydone1		lda #0					; no errors			rts;;  allocate and initialize the output buffer;initoutbuffer			lda OutBufHandle+2		; did we already allocate a buffer?			ora OutBufHandle			beq nooutbuf			pei OutBufHandle+2		; dispose old output buffer			pei OutBufHandle			_DisposeHandle			stz OutBufHandle+2		; clear handle (no buffer allocated by			stz OutBufHandle 		;	MIDI Tool Set yet)nooutbuf	ldy #2					; is address of buffer zero?			lda [arg],y			ldy #4			ora [arg],y			beq allocoutbuf			; allocate buffer dynamically			lda [arg]				; buffer size must be < 32768			bmi badoutsize			cmp #32					; buffer size must be >= 32			bcc badoutsize			sta OutBufSize			; save information			ldy #2			lda [arg],y			sta OutBufAddr			ldy #4			lda [arg],y			sta OutBufAddr+2			bra gotoutbufallocoutbuf	lda [arg]				; get size of output buffer			bmi done2				; don't allocate a new buffer			bne gotoutsize			lda #OutBufSizeDflt		; allocate default buffer sizegotoutsize	cmp #32					; verify buffer minimum size			bcs outbufokbadoutsize  lda #miArrayErr			; buffer is illegal sizebadoutmem   stz OutBufSize			; no output buffer			rtsoutbufok	sta OutBufSize			pea 0					; reserve space for handle			pea 0			pea 0					; size of buffer			pha			pea BufferUserId		; user id			pea attrNoPurge+attrNoCross+attrFixed  ; memory attributes			pea 0					; no special address			pea 0			_NewHandle			plx						; dereference the handle			stx OutBufHandle			plx			stx OutBufHandle+2			bcs badoutmem			lda [OutBufHandle]			sta OutBufAddr			ldy #2			lda [OutBufHandle],y			sta OutBufAddr+2gotoutbuf	jsr EmptyOutBuf			; initialize buffer to empty			sec			lda OutBufSize			; determine index so we can store a			sbc #AveDataSize 		;	packet near end without wrapping			sta OutBufEnd			stz OutputEnabled		; disable output initiallydone2		lda #0					; no errors			rts;;  start interrupts that accomplish MIDI input;begininput	lda InBufSize			; is there an input buffer?			bne @1			lda #miNoBufErr			; no input buffer			rts@1			lda DriverID			; is there a device driver?			bne @2			lda #miNoDevErr			; no device driver			rts@2			lda arg					; set address of routine to call when			sta InputVec 			;	first packet is available			lda arg+1				;	(0 disables call)			sta InputVec+1			ora InputVec			beq @3			dec InputVec 			; adjust for RTL use@3			lda #$FFFF				; enable input			sta InputEnabled			stz PacketStatus 		; discard partial packet			stz PacketRemain 		; no data in partial packet			stz InBufError			; no errors			;;  set up MIDI input polling vector;			sep #$20			longa off			lda #$A9				; LDA (with device driver direct page)			sta MidiInputPoll		; set up MIDI input polling vector			rep #$20			longa on;  Swap in our MIDI polled EVENT MANAGER			pha			pha			PushWord #$0D			;mouse			_GetVector			pla			sta >MouseAdrs			pla			sta >MouseAdrs+2			PushWord #$0D			PushPtr Mouse			;MIDI polled mouse			_SetVector			PushLong #00			; room for EM FTP			PushWord #00			; System tool set			PushWord #6				; EVENT MGR			_GetTSPtr						pla			sta >Real_EM_FTP			pla			sta >Real_EM_FTP+2		; save EM FTP for miStopInput						PushWord #00			; System tool set			PushWord #6				;EVENT MGR			PushLong #EMCallTable			_SetTSPtr; Swap in our "DrawCursor" and "UndrawCursor" into QuickDraw jump vectors			lda >$E01FCC			sta >D_Cursor_Save			lda >$E01FCE			sta >D_Cursor_Save+2						lda >JDC			sta >$E01FCC			lda >JDC+2			sta >$E01FCE			lda >$E01FD0			sta >UD_Cursor_Save			lda >$E01FD2			sta >UD_Cursor_Save+2						lda >JUDC			sta >$E01FD0			lda >JUDC+2			sta >$E01FD2	;  Swap in our QD FTP table			PushLong #00			; room for QD FTP			PushWord #00			; System tool set			PushWord #4				; QuickDraw			_GetTSPtr						pla			sta >Real_QD_FTP			pla			sta >Real_QD_FTP+2		; save QD FTP for miStopInput						PushWord #00			; System tool set			PushWord #4				; QuickDraw			PushLong #QDCallTable			_SetTSPtr			ldy InBufHead			; is there something in the buffer?			iny			cpy InBufEnd			bcc @4			ldy #0@4		 	cpy InBufTail			beq @5			lda InputVec 			; something in input buffer, call vec			ora InputVec+1			beq @5			phb			jsl InputVecGlue			plb@5			jsl DevRcvOnGlue 		; enable receiver interrupts			tax						; was there an error?			bne @6					; yes						lda DirPage1 			; set to direct page 1			tcd			lda PollBranch			; modify timer interrupt routine to			sta TimerIntGlue 		;	poll MIDI input to avoid lossage			lda #0					; no errors			rts@6			stz InputEnabled 		; input not enabled			sep #$20			longa off			lda #$6B				; RTL			sta MidiInputPoll		; disable MIDI input polling vector			rep #$20			longa on			txa						; restore error code			rtsJDC			jml >iDrawCursorJUDC		jml >iUndrawCursorReal_EM_FTP		DS.B 4Real_QD_FTP		DS.B 4MouseAdrs		DS.B 4D_Cursor_Save	DS.B 4UD_Cursor_Save	DS.B 4EMCallTable		DC.L (theEnd-EMCallTable)/4 ;num calls + 1		DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L GetNextEvent-1	DC.L EventAvail-1	DC.L GetMouse-1	DC.L Button-1	DC.L StillDown-1	DC.L WaitMouseUp-1	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L PostEvent-1	DC.L FlushEvents-1	DC.L GetOSEvent-1	DC.L OSEventAvail-1	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0		DC.L 0			; Not used	DC.L 0			; Not used	DC.L 0			; Not used	DC.L 0			; Not used	theEndQDCallTable				DC.L  (TheEndQ-QDCallTable)/4	;num calls + 1						DCB.L $8D,00			DC.L  SetCursor-1			DCB.L $3B,0			DC.L  UserInitCursor-1			DCB.L 24,0			TheEndQ;;  start interrupts that accomplish MIDI output;beginoutput	lda OutBufSize			; is there an output buffer?			bne @1			lda #miNoBufErr			; no output buffer			rts@1			lda DriverID			; is there a device driver?			bne @2			lda #miNoDevErr			; no device driver			rts@2			lda arg					; install address of routine to be			sta OutputVec			;	called when output buffer is empty			lda arg+1				;	(0 disables the call)			sta OutputVec+1			ora OutputVec			beq @3			dec OutputVec			; adjust for RTL use@3			lda #$FFFF				; enable output			sta OutputEnabled			stz LastStatus			; no current running status			lda OutBufEmpty			; any chars ready to go out?			beq calldriver			lda OutputVec			; output buffer is empty, call OutputVec			ora OutputVec+1			beq ret			phb			jsl OutputVecGlue			plb			lda #0					; no errorsret	 		rtscalldriver	jsl DevPollXmtGlue		; start output interrupts			tax						; any errors?			bne @6			rts@6			stz OutputEnabled		; output not started			rts;;  stop interrupts that accomplish MIDI input;endinput	lda InputEnabled 		; is input enabled?			beq ret					; no			stz InputEnabled 		; disable input			lda PacketIndex			; discard partial packet			sta InBufTail			sep #$20			longa off			lda #$6B				; RTL			sta MidiInputPoll		; disable MIDI input polling vector			rep #$20			longa on						jsl DevRcvOffGlue		; disable receiver interrupts			tax			lda DirPage1 			; modify timer interrupt routine so			tcd						;	MIDI input is not polled			lda NoPollBranch			sta TimerIntGlue			txa						; restore error code			pha;  Restore system Event Mgr and QuickDraw			PushWord #00			; System tool set			PushWord #6				; EVENT MGR			PushLong >Real_EM_FTP	; Restore EM PTR			_SetTSPtr						PushWord #$0D			PushLong >MouseAdrs	;mouse			_SetVector			PushWord #00			; System tool set			PushWord #4				; QuickDraw			PushLong >Real_QD_FTP	; Restore QD PTR			_SetTSPtr			lda >D_Cursor_Save			sta >$E01FCC			lda >D_Cursor_Save+2			sta >$E01FCE						lda >UD_Cursor_Save			sta >$E01FD0			lda >UD_Cursor_Save+2			sta >$E01FD2			pla			@1			rts;;  stop interrupts that accomplish MIDI output;endoutput	lda OutputEnabled		; is output enabled?			beq @1					; no (***  was "ret" MC)			stz OutputEnabled		; disable output			jsl DevXmtOffGlue		; disable transmitter interrupts@1			rts;;  discard contents of input buffer;discardinbuf			lda InBufSize			; is there an input buffer?			bne @1			lda #miNoBufErr			; no input buffer			rts@1			jsr EmptyInBuf			lda #0					; no errors			rts;;  discard contents of output buffer.;;  Wait for an incomplete packet to finish;  transmission, then flush the remainder;  of the buffer, generate note off commands;  for notes that are on, and wait for these;  packets to clear from the output buffer.;discardoutbuf			lda OutBufSize			; is there an output buffer?			bne @1			lda #miNoBufErr			; no output buffer			rts@1			lda arg+2				; is high word positive?			bpl @2					; yes, turn notes off			jsr EmptyOutBuf			; empty without regard to partial									;   packets or notes off			lda #0000			rts						; Bug fix 5/25/89 mc						@2			lda OutputEnabled		; is output enabled?			bne @3		 			; yes			lda #miOutOffErr 		; output must be enabled			rts@3			lda OutBufHead			; retract tail so that only the current			sec						;	packet will go out			adc RealTimeChars			adc PacketChars			cmp OutBufEnd			bcc @4			lda #0@4			sta OutBufTail			stz OutBufEmpty			; assume there is data left in buffer			lda OutBufHead			; now find out			inc a			cmp OutBufEnd			bcc @5			lda #0@5			cmp OutBufTail			bne @6		 			; yes, there is data left in buffer			dec OutBufEmpty			; output buffer is empty@6			cli						; allow output to continue			lda arg					; which channel			ldx arg+2				; is high word zero?			bne panicoff 			; send all possible notes off			jsr TurnOffNotes 		; send notes off that we know are on			stz OutBufMaxChars		; clear maximum output chars			jmp WaitOutput			; wait for packets to clear output bufpanicoff	jsr PanicNotesOff		; send all possible notes off			stz OutBufMaxChars		; clear maximum output chars			jmp WaitOutput			; wait for packets to clear output buf;;  discard next packet in input buffer;discardpacket			lda InBufSize			; is there an input buffer?			bne @1			lda #miNoBufErr			; no input buffer			rts@1			ldy InBufHead			; any packet available?			iny			cpy InBufEnd			bcc @2			ldy #0@2		 	cpy PacketIndex			beq @5					; no packet			lda [InBufAddr],y		; get packet length			bpl @3			and #$7FFF				; clear error flag			inc a					; add error code byte to length@3			sty InBufHead			; update head pointer by size of packet			sec			adc InBufHead			cmp InBufSize			; did it wrap (sys excl. packet)?			bcc @4			sbc InBufSize@4			sta InBufHead@5			lda #0					; no errors			rts;;  set input mode;setinmode	lda arg			sta InputMode			jsr EmptyInBuf			; discard input buffer, because we can't									;   deal with multiple formats in buffer			lda #0					; no errors			rts;;  set output mode;setoutmode	stz LastStatus			; send out next status byte			lda arg			sta OutputMode			cmp #miRawMode			; if we're switching to raw mode,			bne @1					;   we have to clear the note pad,			jsr ClearNotes			;   because we will stop tracking notes									;   in mid-buffer at an undefined time@1			lda #0					; no errors			rts;;  mark notes off in one or all channels;marknotesoff			lda arg+2				; get high word of argument			bne markalloff			; arg > 16, so clear all channels			lda arg					; get low word of argument			cmp #16			bcs markalloff			jsr ClearNotesChannel	; mark notes off in one channel			lda #0					; no errors			rtsmarkalloff	jsr ClearNotes			; mark notes off in all channels			lda #0					; no errors			rts;;  set delay between output packets in units;  of one-quarter of a MIDI character time;setoutdelay	lda arg			sta OutputDelay			lda #0					; no errors			rts;;  enable/disable running status output;runstatout	stz LastStatus			; send next status byte no matter what			lda arg			beq @1					; disable running status			lda #$FFFF				; enable running status@1			sta OutputStat			lda #0					; no errors			rts;;  ignore/buffer system exclusive packets on input;ignsysexcl	lda arg					; do we ignore or buffer?			bne @1					; ignore			dec a					; buffer			bra @2@1			lda #StartSysExcl		; ignore@2			sta IgnoreSysEx			lda #0					; no errors			rts						ENDP			EJECT;-------------------------------------------------------;;  WaitOutput;;  Wait for MIDI output buffer to be cleared.;;-------------------------------------------------------WaitOutput	PROC EXPORT			lda OutBufSize			; is there an output buffer?			bne @2			lda #miNoBufErr			; no output buffer			rts@1			cli						; enable interrupts to clear output buf@2			lda OutBufEmpty			; is it empty yet?			beq @1					; no			lda #0					; no errors			rts			ENDP			END			