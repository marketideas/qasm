;-------------------------------------------------------;;  midi.main.aii;;  Required tool calls for the MIDI Tool Set.;  The MIDI Tool Set allows device-independent;  input and output of MIDI data.;;  Copyright 1987, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;  25 Aug 87   DM	New today;  20 Nov 87   DM	Major rewrite of MidiStartUp;					Added support for 3 direct pages;					Added many new calls;  19 Jan 88   DM	Deleted AppleTalk check so that;					tool will work (?) with AppleTalk;  25 Jan 88   DM	Added initialization for OutputDelay;  27 Oct 88   MD	Initalize TicksPerSec to default of 13160;;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';;  MIDI Tool Set Function Pointer Table;MidiFPT		PROC			IMPORT MidiBoot			IMPORT MidiStartUp			IMPORT MidiShutDown			IMPORT MidiVersion			IMPORT MidiReset			IMPORT MidiStatus			IMPORT NotImp			IMPORT MidiControl		; midi.control.aii			IMPORT MidiDevice		; midi.device.aii			IMPORT MidiClock		; midi.clock.aii			IMPORT MidiInfo			; midi.info.aii			IMPORT MidiReadPacket	; midi.read.aii			IMPORT MidiWritePacket	; midi.write.aii			IMPORT MidiRecordSeq	; midi.record.aii			IMPORT MidiStopRecord			IMPORT MidiPlaySeq		; midi.play.aii			IMPORT MidiStopPlay			IMPORT MidiConvert		; midi.convert.aii						DC.L (EndFPT-MidiFPT)/4	; number of calls			DC.L MidiBoot-1			;  1 - boot initialization			DC.L MidiStartUp-1		;  2 - application startup			DC.L MidiShutDown-1		;  3 - application shutdown			DC.L MidiVersion-1		;  4 - version number			DC.L MidiReset-1 		;  5 - system reset			DC.L MidiStatus-1		;  6 - tool initialized?			DC.L NotImp-1			;  7 - reserved by system			DC.L NotImp-1			;  8 - reserved by system			DC.L MidiControl-1		;  9 - various control functions			DC.L MidiDevice-1		; 10 - device driver functions			DC.L MidiClock-1 		; 11 - time stamp clock functions			DC.L MidiInfo-1			; 12 - various information			DC.L MidiReadPacket-1	; 13 - read one MIDI packet			DC.L MidiWritePacket-1	; 14 - write one MIDI packet			DC.L MidiRecordSeq-1	; 15 - record a MIDI sequence			DC.L MidiStopRecord-1	; 16 - stop recording a MIDI seq			DC.L MidiPlaySeq-1		; 17 - play a MIDI sequence			DC.L MidiStopPlay-1		; 18 - stop playing a MIDI seq			DC.L MidiConvert-1		; 19 - convert MIDI packets/filesEndFPT		equ *			ENDP			EJECT;-------------------------------------------------------;;  MidiBoot -- call number 1;;  This routine is called when the MIDI Tool Set is;  first loaded into RAM.  Nothing is actually done;  until the MidiStartup call.;;  Inputs:;		  none;;  Outputs:;		  none;;  Registers:;		  not preserved;;-------------------------------------------------------MidiBoot	PROC;;  initialize MIDI input polling vector;			lda #$6B				; RTL			sta MidiInputPoll		; set up MIDI input polling vector			lda #0					; no errors			clc			rtl			ENDP			EJECT			;-------------------------------------------------------;;  MidiStartUp -- call number 2;;  This routine is called by an application that wishes;  to use the MIDI Tool Set.;;  Inputs:;		 user ID for memory manager (word);		 address of 3 consecutive page-aligned;		   direct pages (word);;  Outputs:;		 none;;  Errors:;		 miToolsErr 	  Required tools are not loaded;						  or not correct version.;;;  Registers:;		 not preserved;;-------------------------------------------------------MidiStartUp	PROC			IMPORT BufDispatcher			IMPORT ClearNotes			IMPORT ClockHandler;;  stack offsets;			DefineStacks_databank	byte 					; old data banks_dirpage	word 					; old direct pages_rtl1		block 3					; first rtl addresss_rtl2		block 3					; second rtl addresss_argstart	DSectSize				; start of argumentss_dirpages	word 					; start of direct pagess_userid	word 					; user ID for memory managers_argend	DsectSize				; end of argumentss_argsize	equ s_argend-s_argstart;;  save direct page and data bank registers;			phd						; save old direct page			phb						; save old data bank			phk						; data bank = current program bank			plb;;  check to see if Note Synthesizer and Sound Tools are proper version;  (NOT DONE ANY MORE, BECAUSE MIDI TOOLS CAN RUN WITHOUT THEM EXCEPT FOR MIDI CLOCK);			pha;			_SoundVersion;			pla;			bcs toolerror;			cmp #miSTVer;			bcc toolerror;			pha;			_NSVersion;			pla;			bcs toolerror;			cmp #miNSVer;			bcs initdp1;;toolerror	ldx #miToolsErr;			jmp done			eject;;  initialize code fragments on direct page 1;initdp1 	lda s_dirpages,s 		; get new direct page			tcd			ldx #0codeloop	lda dp_code,x 			; copy one word per loop			sta <0,x			inx			inx			cpx #dp_codesize			bcc codeloop;;  patch into DOC interrupt chain;patchvector pea 0					; set DOC oscillator interrupt to us			pea 0			pea 0			tdc			clc			adc #TimerIntGlue			pha			_SetUserSoundIRQV			bcc	@1					; Report error if there is one.			tax			pla			pla			brl done@1			pla						; Continue if no error.			sta OtherOscVec			pla			sep #$20 				; short accumulator			longa off			sta OtherOscVec+2			rep #$20 				; long accumulator			longa on;;  patch references to direct page;			tdc						; patch direct page location			sta MidiZP1			sta MidiZP1b			tax			lda TimerIntGlue 		; save branch at beginning of interrupt			sta NoPollBranch 		;	routine, which will be patched			and #$00FF				;	depending on whether we need to			sta PollBranch			;	poll MIDI input during DOC interrupt			txa						; calculate address of routine to call			clc						;	to poll MIDI input			adc #PollInput-1			sta PollInputAddr		; this value used to RTL to polling code			stz PollInputAddr2+1			inc a					; this value used to JSL to polling code			sta PollInputAddr2			txa			clc			adc #$100				; point to direct page 2			sta MidiZP2			eject;;  initialize direct page 2;			tcd						; A = direct page 2 (from above)			sec						; calculate address - 1 of MVPinst for			sbc #$100-(MVPinst-1)	;	MidiReadPacket and MidiWritePacket			sta MVPaddr			stz MVPaddr+2			sep #$20 				; short accumulator			longa off			lda s_databank,s		; save application's data bank			sta DataBank			rep #$20 				; long accumulator			longa on			lda s_userid,s			; save our user ID			sta UserId			stx DirPage1 			; address of direct page 1			txa			clc			adc #$200			sta DirPage3 			; address of direct page 3;;  no input or output buffers allocated yet;			stz InBufHandle			; input buffer not allocated			stz InBufHandle+2			stz InBufSize			stz OutBufHandle 		; output buffer not allocated			stz OutBufHandle+2			stz OutBufSize			lda #miPacketMode		; default packet format input and output			sta InputMode			sta OutputMode			lda #$FFFF				; do running status optimization			sta OutputStat			stz OutputDelay			; no delay between output packets			sta IgnoreSysEx			; save system exclusive on input						stz MRactive			; MidiReadPacket not active			stz MWactive			; MidiWritePacket not active;;  clear application vectors;			stz RealTimeVec			; discard MIDI real-time messages			stz RealTimeVec+1			stz ErrorVec 			; ignore real-time errors			stz ErrorVec+1			stz InputVec 			; no interrupt on first input packet			stz InputVec+1			stz OutputVec			; no interrupt on last output packet			stz OutputVec+1;;  clear and disable the clock;			stz Timer				; initialize clock value to zero			stz Timer+2			stz LastOutTime			stz LastOutTime+2			stz TimerEnabled 		; clock disabled			lda #13160				; get default clock frequency			sta TicksPerSec			; initialize TicksPerSec;;  device driver not loaded;			stz DriverID			lda #$6B				; RTL			sta MidiInputPoll		; set up MIDI input polling vector			lda DirPage1			sta MidiInputPoll+1			lda #$5C				; JML			sta MidiInputPoll+3			lda #pollingerr			; point to BRK			sta MidiInputPoll+4			lda #^pollingerr			sta MidiInputPoll+6			eject;;  initialize direct page 3;			jsr ClearNotes			; mark all notes off;;  set our work area pointer;			pea 0					; system tool			pea miToolNum			; tool set number			pha			phd						; our direct page			_SetWAP			ldx #0;;  return with possible error code currently in X;done		plb						; restore old data bank			pld						; restore old direct page			PopArgs s_argsize		; move RTL addresses			txa						; possible error code in A			cmp #1					; set carry appropriately			rtlpollingerr	brk						; somehow someone slipped through the MIDI									;   input polling vector illegally			eject;;  This is an image of the code segments to be moved onto the direct page.;dp_code		DC.B	$00 				; reserved byte at start of direct page;  jump to routine to do I/O buffering - called by driver routines			jml BufDispatcher;  This is a small glue routine installed in the direct page and modified;  there by MidiStartup.  It is called by the //GS interrupt handler to;  service MIDI interrupts.			rep #$30 				; long accumulator			lda #$FFFF				; get new direct page			jsl nullhandler			; call driver int. handler			sep #$30 				; restore 8-bit native mode			bcs oldvec				; driver didn't service interrupt			rtloldvec		jml $FFFFFF				; call old interrupt handler;  This is a small glue routine installed in the direct page and modified;  there by MidiStartup.  It is called to handle DOC interrupts caused by;  our timing oscillator.			longa off				; called in m = 1, x = 1 mode			longi off			bra NoPoll				; don't poll MIDI input (modified if;											polling is needed)			phk						; push address of polling routine to			pea $FFFF				;	be called before rtl to Sound Tools			pha						; save oscillator mode			jsl $FFFFFF				; call routine to poll MIDI input			pla						; restore oscillator modeNoPoll		cmp #MidiMode			; did our oscillator cause interrupt?			beq IncTimer 			; yes, increment time stamp clock			jml $FFFFFF				; call routine to handle other osc.IncTimer	rep #$30 				; long accumulator and registers			longa on			longi on			lda #$FFFF				; get new direct page			jml ClockHandler 		; our oscillator interrupt handler;; poll MIDI input;			rep #$30 				; long accumulator and registers			longa on			longi on			lda #$FFFF				; get direct page 1			jsl $FFFFFF				; poll MIDI input			sep #$30 				; short accumulator and registers			rtl;  The following routine implements a MVP instruction in which the source;  and destination banks can be modified.			mvp $FF,$FF			plb			rtl;  This routine allows PRODOS calls to be made with patched arguments.			jsl Prodos			DS.B 2					; call number			DS.B 4					; address of parameter block			rtldp_codesize	equ *-dp_code;;  null MIDI interrupt handler;nullhandler	sec						; didn't handle the interrupt			rtl			ENDP			EJECT			;-------------------------------------------------------;;  MidiShutDown -- call number 3;;  An application calls this function when it has;  finished using the MIDI Tool Set.;;  Inputs:;		 none;;  Outputs:;		 none;;  Registers:;		 not preserved;;-------------------------------------------------------MidiShutDown	PROC			IMPORT ShutDriver			phd						; save current direct page			tcd			beq done 				; MIDI Tool Set is not initialized			php						; disable interrupts			sei;;  shut down the device driver;			jsr ShutDriver			; shutdown and unload the device driver;;  shutdown timer;			pea miStopClock			pea 0			pea 0			_MidiClock;;  restore timer interrupt vector;nodriver	lda DirPage1			tcd			pea 0			pea 0			lda OtherOscVec+2			and #$00FF			pha			pei OtherOscVec			lda MidiZP2			tcd			_SetUserSoundIRQV			pla			pla			plp						; restore interrupts;;  discard buffers allocated by the MIDI Tool Set;			lda InBufHandle+2		; was the input buffer allocated?			ora InBufHandle			beq checkoutbuf			pei InBufHandle+2			pei InBufHandle			_DisposeHandlecheckoutbuf	lda OutBufHandle+2			ora OutBufHandle			beq disposewapt			pei OutBufHandle+2			pei OutBufHandle			_DisposeHandle;;  clear out WAPT entry;disposewapt	pea 0					; system tool			pea miToolNum			; tool number			pea 0			pea 0			_SetWAPdone		pld						; restore direct page			lda #0			clc			rtl			ENDP			EJECT			;-------------------------------------------------------;;  MidiVersion -- call number 4;;  Returns the version number of the MIDI Tools package.;;  Inputs:;		 none;;  Outputs:;		 version number (word);;  Registers:;		 not preserved;;-------------------------------------------------------MidiVersion	PROC;;  stack offsets;			DefineStacks_rtl1		block 3s_rtl2		block 3s_vernum	word			lda #MidiVerNum			sta s_vernum,s			lda #0			clc			rtl			ENDP			EJECT			;-------------------------------------------------------;;  MidiReset -- call number 5;;  This function is called when the system is reset.;;  Inputs:;		 none;;  Outputs:;		 none;;  Registers:;		 not preserved;;-------------------------------------------------------MidiReset	PROC			IMPORT ResetDriver			phd						; save current direct page			tcd			beq done 				; MIDI Tool Set is not initialized			php						; ignore any last-minute MIDI interrupts			sei;;  reset the device driver;			jsr ResetDriver;;  shutdown timer;			pei miStopClock			pea 0			pea 0			_MidiClock;;  restore timer interrupt vector;nodriver	lda DirPage1			tcd			pea 0			pea 0			lda OtherOscVec+2			and #$00FF			pha			pei OtherOscVec			lda MidiZP2			tcd			_SetUserSoundIRQV			pla			pla			plp						; restore interrupts;;  discard buffers allocated by the MIDI Tool Set;			lda InBufHandle+2		; was the input buffer allocated?			ora InBufHandle			beq checkoutbuf			pei InBufHandle+2			pei InBufHandle			_DisposeHandlecheckoutbuf	lda OutBufHandle+2			ora OutBufHandle			beq disposewapt			pei OutBufHandle+2			pei OutBufHandle			_DisposeHandle;;  clear out WAPT entry;disposewapt	pea 0					; system tool			pea miToolNum			; tool number			pea 0			pea 0			_SetWAPdone		pld						; restore direct page			lda #0			clc			rtl			ENDP			EJECT			;-------------------------------------------------------;;  MidiStatus -- call number 6;;  This function returns a word indicating whether the;  MIDI Tools package is active ($FFFF) or inactive;  ($0000).;;  Inputs:;		 none;;  Outputs:;		 status word ($0000 = inactive, $FFFF = active);;  Registers:;		 not preserved;;-------------------------------------------------------MidiStatus	PROC;;  stack offsets;			DefineStacks_rtl1		block 3s_rtl2		block 3s_status	word			tax						; do we have a non-zero direct page?			beq done			lda #$FFFFdone		sta s_status,s			lda #0			clc			rtl			ENDP			EJECT			;-------------------------------------------------------;;  NotImp;;  Reserved call not implemented.;;  Inputs:;		 none;;  Outputs:;		 none;;  Registers:;		 not preserved;;-------------------------------------------------------NotImp		PROC			lda #0			clc			rtl			ENDP			END			