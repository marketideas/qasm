			PRINT PUSH			PRINT OFF   MACRO&lab PopArgs &num&lab  IF &num='' GOTO .DONE IF &Eval(&num)=0 GOTO .DONE LCLA &popnum&popnum SETA &Eval(&num) IF &popnum>=6 GOTO .DOPULLS lda 5,s sta 5+&popnum,s lda 3,s sta 3+&popnum,s IF &popnum<2 GOTO .MOVEUP1 pla&popnum SETA &popnum-2 sta 1+&popnum,s IF &popnum>0 GOTO .DISCARD MEXIT.MOVEUP1 pla phb sta 1,s MEXIT.DOPULLS pla sta &popnum-1,s pla sta &popnum-1,s pla sta &popnum-1,s&popnum SETA &popnum-6 IF &popnum=0 GOTO .DONE.DISCARD IF &popnum=1 GOTO .DISCARD1 IF &popnum=2 GOTO .DISCARD2 tsc clc adc #&popnum tcs MEXIT.DISCARD1 phb.DISCARD2 pla.DONE MEND	MACRO&lab	PushPtr &addr&lab	dc.B $F4	dc.W (&addr)>>16	dc.B $F4	dc.W &addr	MEND			PRINT POP