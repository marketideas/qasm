;-------------------------------------------------------;;  midi.read.aii;;  This module contains routines to read MIDI packets.;;  Copyright 1987, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);;  Modification History;;	2 Sep 87   DM	New today;;-------------------------------------------------------			INCLUDE 'all.macros'			INCLUDE 'midi.macros'			INCLUDE 'midi.equ.aii';-------------------------------------------------------;;  MidiReadPacket -- call number 13;;  This function reads one MIDI packet (if one is;  available) into an array whose address and length;  are passed on the stack.  It returns the number;  of characters placed in the array (zero if no;  packet is currently available).;;  Inputs:;		 space for number of chars. read (word);		 address of array to hold packet (long);		 length of array (word);;  Outputs:;		 number of chars. read (word);;  Registers:;		 A contains an error code if the carry is set.;;  NOTE: on input errors, MidiReadPacket places;		 one byte which contains error flags into;		 the passed array.	If a zero-length array;		 is passed, this byte will be stored anyway.;;-------------------------------------------------------MidiReadPacket PROC EXPORT			IMPORT MVPGlue			; midi.glue.aii;;  stack offsets;			DefineStacks_dirpage   word 					; old direct pages_rtl1		block 3					; first rtl addresss_rtl2		block 3					; second rtl addresss_argstart	DSectSize				; start of argumentss_arraylen  word 					; length of arrays_array 	long 					; address of arrays_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstarts_charsread	word 					; number of chars. placed in array;;  initialize direct page register;			phd						; save old direct page			tcd						; get our direct page			beq starterr			; MIDI Tool Set not started			lda #0					; assume no packet returned			sta s_charsread,s			lda MRactive			; is MidiReadPacket already active?			bne reentry				; yes, this is reentry via interrupt			dec a					; mark MidiReadPacket active now			sta MRactive			php						; are interrupts enabled?			php			pla			and #$0004			and InputEnabled		; is MIDI input enabled?			bne pollmidi			; poll MIDI input if ints. disabled			ldx InBufSize			; is there an input buffer?			bne bufok			ldx #miNoBufErr			; no input buffer error			jmp done1starterr	ldx #miStartUpErr		; MIDI Tool Set not started			jmp reenterdonereentry		jsl MidiInputPoll		; poll MIDI if necessary			ldx #0			jmp reenterdone			; don't do anything on reentrant callpollmidi	jsl MidiInputPoll		; poll MIDI input			lda #$FFFF				; poll it later, too			bufok		sta MRpoll				; remember if we should poll MIDI in			stz MRerror				; assume no error;;  update maximum number of characters in input buffer;			lda InBufHead			; wrap if necessary to avoid inflation			cmp InBufEnd			lda InBufTail			bcs getmax			sbc InBufHead			; note: tail-head-1			bpl getmax			adc InBufSize			; head > tailgetmax		cmp InBufMaxChars		; is number of chars > max ?			bcc lookforpacket			sta InBufMaxChars;;  is there a complete packet to return?;lookforpacket			ldy InBufHead			; if PacketIndex = InBufHead + 1, no			iny						;	complete packet yet			cpy InBufEnd 			; need to skip?			bcc @1			ldy #0@1			php						; save interrupt status			sei			cpy PacketIndex			bne completepkt			; a complete packet is available			cpy InBufTail			; is incomplete packet available?			beq @2					; no data at all			lda InputMode			; are we in raw mode?			beq @3					; yes, transfer incomplete packet@2			plp						; restore interrupt status			jmp done2				; exit			;;  truncate incomplete packet in raw mode;@3			sec						; calculate packet length			lda #8			sbc PacketRemain			sta [InBufAddr],y			stz PacketRemain		; input routine must start new packet			lda InBufTail			cmp InBufEnd			; skip tail to start if needed			bcc @4			lda #0			sta InBufTail@4			sta PacketIndex			;;  transfer complete packet (with possible error);completepkt	plp						; restore interrupt status			sty MRhead				; save new head pointer			lda [InBufAddr],y		; get length field			bpl noerror			and #$7FFF				; clear error flag			pha						; save length			clc						; retrieve error code at end of packet			adc #2			adc MRhead				; add current head index			cmp InBufSize			bcc @1			sbc InBufSize@1			tay			lda [InBufAddr],y			and #$00FF				; clear extraneous high byte			ora #miToolNum<<8		; set tool number			sta MRerror			ldy MRhead				; restore head index			pla						; restore lengthnoerror 	clc						; add length of two-byte length field			adc #3					;	plus one byte for word transfers			cmp s_arraylen,s		; is array big enough to hold packet?			bcs arrayerror			; array is too small			dec a					; subtract extra added above			sta s_charsread,s		; function result is number of chars.			tax						; save length			cmp #11					; is packet large?			bcs bigpacket			; yes, handle wrapping;;  copy short packet into array;			sec			lda s_array,s			; adjust array address to use Y index			sbc MRhead			sta MRarray			lda s_array+2,s			sbc #0			sta MRarray+2			lda [InBufAddr],y		; move 10 bytes for speed			and #$7FFF				; clear error flag			sta [MRarray],y			iny			iny			lda [InBufAddr],y			sta [MRarray],y			iny			iny			lda [InBufAddr],y			sta [MRarray],y			iny			iny			lda [InBufAddr],y			sta [MRarray],y			iny			iny			lda [InBufAddr],y			sta [MRarray],y			clc						; update head pointer			txa			adc MRhead			dec a					; newhead was already incremented			sta InBufHeaddone		bit MRpoll				; do we need to poll MIDI input?			bpl done2				; no			jsl MidiInputPoll		; poll MIDI inputdone2		ldx MRerror				; any error?			beq done1				; no			inc InBufHead			; discard extra error code bytedone1		stz MRactive			; MidiReadPacket no longer activereenterdone	pld						; restore old direct page			PopArgs s_argsize		; move RTL addresses			txa						; restore error code			cmp #1					; set carry appropriately			rtlarrayerror	stz MRactive			; MidiReadPacket no longer active			pld						; return array size error			PopArgs s_argsize			lda #miArrayErr			sec			rtl;;  copy a large packet (system exclusive or error packet) to array,;  with possible wrapping in the circular buffer;bigpacket	lda s_array,s			; retrieve address of destination array			sta MRarray			sep #$20 				; short accumulator			longa off			lda s_array+2,s			sta MRarray+2			phb						; save data bank reg from MVP			pla						; A = data bank register			sta MVPaddr+3			; restore data bank from here after MVPnewbank 	lda InBufAddr+2			; patch source and destination banks			xba						;	into MVP instruction			lda MRarray+2			rep #$20 				; long accumulator			longa on			ldy #2			sta [MVPaddr],ynextblock	dex						; number of bytes - 1 to move			stz MRlength			; number of bytes to move next time			clc						; does packet wrap in input buffer?			txa			adc MRhead				; add current buffer position			sec			sbc InBufSize			; are we off the end of the buffer?			bcc @1					; no			inc a					; number of bytes to move in next block			sta MRlength			clc@1		 	txa						; does destination cross bank boundary?			adc MRarray			bcc @2					; no			tay						; number of bytes - 1 to move next time			iny						; is bank boundary closer than the			cpy MRlength			;	end of the buffer?			bcc @2					; no			sty MRlength			; number of bytes to move next time@2			bit MRpoll				; do we need to poll MIDI input?			bpl @2b					; no			ldy #60					; transfer 60 bytes max. between polls			cpy MRlength			bcs @2a			sty MRlength@2a			pha						; save registers			phx			jsl MidiInputPoll		; poll MIDI input			plx			pla@2b			sec						; calculate end of block move			sbc MRlength			sta MRarray			sec						; calculate number of bytes to move now			txa			sbc MRlength			tax			clc			adc MRhead				; calculate new head pointer			sta MRhead			adc InBufAddr			; calculate actual address for MVP			txy						; save number of bytes - 1 for this move			tax						; source address for MVP			tya						; number of bytes - 1 to move			ldy MRarray				; destination address for MVP			jsl MVPGlue				; execute MVP instruction			lda MRhead				; advance head pointer to make room			sta InBufHead			;	in input buffer			ldx MRlength			; more bytes to move?			beq done3				; no			inc a					; did input buffer wrap?			cmp InBufSize			bcc @3					; no			lda #0@3 			sta MRhead			inc MRarray				; did destination cross bank boundary?			bne nextblock			; no			sep #$20			inc MRarray+2			; increment destination bank			bra newbank				; patch new destination bank in MVPdone3		bit MRpoll				; do we need to poll MIDI input?			bpl @1					; no			jsl MidiInputPoll		; poll MIDI input@1			ldx MRerror				; any error?			beq @2			inc InBufHead			; discard extra error byte			tsc						; clear error flag in length field			tcd			lda [s_array]			and #$7FFF			sta [s_array]@2			jmp done1			ENDP			END			