SrcDir	=	:ObjDir	=	:obj:LstDir	=	:lst:Sources	=	{SrcDir}card6850.midi.aiiObjects	=	{ObjDir}card6850.midi.aii.objLists	=	{LstDir}card6850.midi.aii.lstcard6850.midi	Ä	{Objects} {SrcDir}makefile				LINKIIGS {Objects} -o card6850.midi -t $BB -at $0300{ObjDir}	Ä	{SrcDir}.aii.obj	Ä	.aii	ASMIIGS -o {ObjDir} {SrcDir}{Default}.aii		listings	Ä	{Sources}	ECHO "Last listings made `Date`" > listings	ASMIIGS -l -lo {LstDir} -o {ObjDir} {NewerDeps}	LINKIIGS {Objects} -o {LstDir}listlink -l > {LstDir}link.lst	DELETE {LstDir}listlink	MAKE listings2 > MAKE.PRINT.CMDS	MAKE.PRINT.CMDS	DELETE MAKE.PRINT.CMDS	listings2	Ä	{Lists} {LstDir}link.lst	ECHO "Last listings made `Date`" > listings2	PRINT -h -r -f monaco -s 6 -hf helvetica -hs 12 {NewerDeps}	backup		Ä	BACKUP -a -t 'TEXT' -e -from {SrcDir} -to 1