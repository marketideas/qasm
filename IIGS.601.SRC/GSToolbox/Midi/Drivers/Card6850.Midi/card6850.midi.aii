;-------------------------------------------------------;;  card6850.midi.aii;;  This is a driver for the MIDI Tool Set and;  a MIDI card based on the 6850 ACIA (i.e., the;  Passport card).;;  Copyright 1988, 1991, Apple Computer Inc.;  Author: Don Marsh (x6739, AppleLink: MARSH1);; Modification History;; 2 Feb 88   DM	New today;; 11-Dec-91  Dave Lyons;; If we fail to start up on ROM 1, and then we get a Shutdown; call, we are "restoring" the main interrupt vector to NIL.; This obviously crashes solid.  Fix SetVector call to check; for NIL value first.;;-------------------------------------------------------;*************************************************************; NOTE: This driver was written for Apple //GS, version 01 ROM;*************************************************************			PRINT NOGEN,NOHDR,NOSTAT,NOMDIR			INCLUDE 'all.macros'			INCLUDE 'e16.midi'		; error code definitions						Entry IntHandler			Entry IRQIntHandler;;  general definitions;MidiZP			equ MidiInputPoll+1	; our direct pageIntManagerID	equ $0004			; Interrupt Manager vector IDTenSpeedRom		equ $0003			; TenSpeed Rom versionIDRoutine		equ $FE1F			; Emulation Rom Entry point.;;  interface definitions;aciastat		equ $E0C088			; ACIA control and status registeraciadata		equ $E0C089			; ACIA data registeraciarecvon		equ $80				; bit to turn on receiver interruptsaciaxmiton		equ $20				; bit to turn on transmitter interrupts;;  entry points into ROM interrupt handler;ROMorig1		equ $FFB7CC			; start of interrupt handlerROMorig2a		equ $FFB800			; check hereROMorig3		equ $FFB802			; start verifying here alsoROMorig5		equ $FFB842			; test for SCC interrupt (label @123)ROMorig6		equ $FFB85F			; handle break (label @222)ROMorig7		equ $FFBA86			; exit int. handler (label irqdone4)IRQMIDI			equ $E1021C			; MIDI Interupt vector.;;  direct page usage;;  Note: a driver interface may use direct page locations;		 $80-$FF only.	If more memory is required, it;		 should be allocated using the memory manager ID;		 passed to the initialization routine.;			DSect $80userID			word 					; user ID for memory managerslot			word 					; which slot to use * $10interruptmask	word 					; recv and xmit interrupt enable byteintserviced		word 					; whether we serviced the interruptRomVers			word					; Rom Version returned from IDRoutine.enddriveruse	DSectSize				; end of our direct page usage				CheckSize enddriveruse,$FF ; generate error if we are > $FF				EJECT				;;  PopArgs1 n;;  The following macro removes "n" bytes of arguments below a 3-byte;  RTL address in a time-efficient manner.;			MACRO&lab		PopArgs1 &num&lab			IF &num='' GOTO .DONE			IF &Eval(&num)=0 GOTO .DONE			LCLA &popnum&popnum		SETA &Eval(&num)			lda 2,s			sta 2+&popnum,s			IF &popnum>=2 GOTO .DOPULLS			pla			phb			sta 1,s			MEXIT.DOPULLS			pla			sta &popnum-1,s&popnum		SETA &popnum-2			IF &popnum=0 GOTO .DONE			IF &popnum=1 GOTO .DISCARD1			IF &popnum=2 GOTO .DISCARD2			tsc			clc			adc #&popnum			tcs			MEXIT.DISCARD1			phb.DISCARD2			pla.DONE			MEND			EJECT;;  the driver table used by the MIDI Tool Set;DriverTable	PROC			Import Init			Import NotImpDriver			Import PollRecv			Import PollXmit			Import RecvIntOff			Import RecvIntOn			Import Reset			Import Shutdown			Import XmitIntOff			Import XmitIntOn			DC.L Init-1				; initialization routine			DC.L Shutdown-1			; shutdown routine			DC.L Reset-1			; reset routine			Export MyIntHandlerMyIntHandler DC.L IRQIntHandler-1	; interrupt handler			DC.L PollRecv-1			; routine to poll receiver			DC.L RecvIntOn-1 		; routine to enable recv interrupts			DC.L RecvIntOff-1		; routine to disable recv interrupts			DC.L PollXmit-1			; routine to poll transmitter			DC.L XmitIntOn-1 		; routine to enable xmit interrupts			DC.L XmitIntOff-1		; routine to disable xmit interrupts			DC.L NotImpDriver-1		; reserved			DC.L NotImpDriver-1		; reserved			DC.L NotImpDriver-1		; reserved			ENDP						EJECT;-------------------------------------------------------;;  Init;;  Initialize the appropriate slot.;;  Inputs:;		space for old interrupt vector (long);		new interrupt vector (long);		slot number (word);		internal(=0)/external(=1) (word);		user id (word);;		the accumulator contains the driver's direct page;		(the current direct page register must be;		preserved);;  Outputs:;		carry set if initialization was unsuccessful,;		error code in low byte of accumulator;;  Registers:;		not preserved;;  Note: called with interrupts disabled;;-------------------------------------------------------Init		PROC			Import ROMcopy1			; entry points into our copy of the			Import ROMcopy2			;   ROM interrupt handler			Import ROMcopy3			Import ROMcopy4			Import MyIntHandler;;  stack offsets;			DefineStacks_oldbank	byte 					; old data bank registers_dirpage   word 					; old direct page registers_rtl		block 3					; rtl addresss_argstart	DSectSize				; start of argumentss_userid	word 					; user ID for memory managers_external	word 					; 0 = internal, 1 = external slots_slot		word 					; which slots_newintvec	long 					; new interrupt vector addresss_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstarts_oldintvec	long 					; return old interrupt vector address;;  this driver works only with external slots;			phd						; save current direct page register			tcd						; get driver's direct page			phb						; set data bank register to this bank			phk			plb			lda s_external,s 		; must be external slot			bne checkROMnotavail	ldx #miDevNotAvail		; device not available on this slot			jmp done;;  check ROM version;; first get the Rom version.checkROM	pha						; space for Y Reg.			pha						; space for X Reg.			pha						; space for Accumulator.			pha						; space for processor status.			pha						; A on input, arbitrary.			pha						; X on input, arbitrary.			pha						; Y on input, arbitrary.			lda	#IDRoutine			; Emulation mode entry point.			pha			_FWEntry				; Call IDRountine.			pla						; Y at exit, Machine and Rom Versions.			sta	RomVers				; save as the Rom Version.			pla						; X at exit, reserved.			pla						; A at exit, System info.			plp						; junk.			plp						; processor status.			bcs versionerr			; if carry, not a GS.			lda	RomVers				; get the version			cmp #TenSpeedRom		; check with tenspeed rom.			bcc checkRevB			; if lt then check if RevB.			brl	InstallIRQ			; if GE then use IRQMIDI vector.			checkRevB	sec									lda #ROMcopy2			sbc #ROMcopy1			tax			sep #$20 				; short accumulator			longa offverify1 	lda ROMcopy1,x			cmp ROMorig1,x			bne versionerr			dex			bpl verify1			rep #$20			longa on			sec			lda #ROMcopy4-1			sbc #ROMcopy3			tax			sep #$20			longa offverify2 	lda ROMcopy3,x			cmp ROMorig3,x			bne versionerr			dex			bpl verify2			rep #$20			longa on			lda ROMorig2a			; where breaks branch			cmp #$5D70			bne versionerr			lda ROMorig5 			; where interrupts go back to ROM			cmp #$2D48			bne versionerr			lda ROMorig6 			; where breaks go back to ROM			cmp #$30C2			bne versionerr			lda ROMorig7 			; where handled interrupt goes back			cmp #$10AD			beq versionokversionerr	rep #$20			ldx #miDevVersion		; driver is not compatible with ROM			jmp doneversionok	lda #^IntHandler		; get the old IntHandler.			sta MyIntHandler+2		; and patch out the call table.			lda #IntHandler-1					sta	MyIntHandler						lda s_userid,s			; save user ID (not used in this driver)			sta userID;;  patch the general interrupt handler vector;			pea 0					; get old vector			pea 0			pea IntManagerID			_GetVector			pla			sta s_oldintvec+2,s			pla			sta s_oldintvec+2,s			lda s_oldintvec+1,s		; is old vector pointing to ROM handler?			cmp #>ROMorig1			bne conflicterr			lda s_oldintvec,s			cmp #<ROMorig1			beq setnewvecconflicterr	ldx #miDevIntHndlr		; someone else must have stolen the vec			bra donesetnewvec	pea IntManagerID 		; set new interrupt vector			lda #^IntHandler			pha			lda #IntHandler			pha			_SetVector			bra	slotOffsetInstallIRQ	lda s_userid,s			; save user ID (not used in this driver)			sta userID			lda >IRQMIDI+2			; get the old vector, mid and bank bytes.			sta	s_oldintvec+1,s		; save, extra is not touched.			lda	>IRQMIDI+1						sta s_oldintvec,s		; we don't return a conflict error any more, who ever grabs last gets it.			lda #>IRQIntHandler		; get bank and high bytes.			sta	>IRQMIDI+2			; set new vector			lda #IRQIntHandler		; get low and mid bytes.			sta >IRQMIDI+1			; and store in vector after jmp.				;;  calculate slot offset;slotOffset	lda s_slot,s 			; slot $000n			asl a			asl a			asl a			asl a			sta slot 				; slot offset $00n0			tax;;  initialize the ACIA;			sep #$20 				; short accumulator			longa off			lda #$03 				; reset ACIA			sta aciastat,x			lda #$11 				; no interrupts for now			sta aciastat,x			sta interruptmask			rep #$20 				; long accumulator			longa on			ldx #0					; no errorsdone		plb						; restore data bank register			pld						; restore direct page register			PopArgs1 s_argsize		; move one RTL address			txa						; restore error code			cmp #1					; set carry on error			rtl			ENDP						EJECT;-------------------------------------------------------;;  Shutdown;;  Shutdown the interface.;;  Inputs:;		old interrupt vector (long);;		the accumulator contains the driver's direct page;		(the current direct page register must be;		preserved);;  Outputs:;		carry set if shutdown was unsuccessful,;		error code in low byte of accumulator;;  Registers:;		not preserved;;  Note: called with interrupts disabled;;-------------------------------------------------------Shutdown	PROC;;  stack offsets;			DefineStacks_dirpage   word 					; old direct page registers_rtl		block 3					; rtl addresss_argstart	DSectSize				; start of argumentss_oldintvec	long 					; return old interrupt vector addresss_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstart			phd						; save old direct page register			tcd						; get driver's direct page*** added 11-Dec-91 DAL -- don't do any damage if we did not start successfully			lda s_oldintvec+1,s	;middle word			beq neverStarted			inc a			beq neverStarted		;$FFFFxx if we never got started*** end 11-Dec-91 DAL;;  reset the ACIA;			sep #$20 				; short accumulator			longa off			ldx slot			lda #$11 				; no more interrupts			sta aciastat,x			rep #$20			longa on;;  restore interrupt manager vector;			lda RomVers				; find out which version.			cmp	#TenSpeedRom		; compare to tenspeed rom.			bge TenSpeed			; if Tenspeed use IRQMIDI			pea IntManagerID		; else patch the inthandler back.			lda s_oldintvec+2+2,s			pha			lda s_oldintvec+2+2,s			pha			_SetVector			bra done			TenSpeed	lda	s_oldintvec,s		; get old vector and patch back in.			sta	>IRQMIDI+1			; patch RTL back in.			lda	s_oldintvec+1,s		; Get high and bank bytes.			sta >IRQMIDI+2			; save in vector.neverStarted			done		pld						; restore direct page			PopArgs1 s_argsize		; move RTL address			lda #0					; no errors			clc			rtl			ENDP			EJECT;-------------------------------------------------------;;  Reset;;  Take care of hardware after system reset (essentially;  a shutdown, but special conditions may arise after;  a system reset).;;  Inputs:;		old interrupt vector (long);;		the accumulator contains the driver's direct page;		(the current direct page register must be;		preserved);;  Outputs:;		carry set if shutdown was unsuccessful,;		error code in low byte of accumulator;;  Registers:;		not preserved;;  Note: called with interrupts disabled;;-------------------------------------------------------Reset		PROC			jmp Shutdown 			; this does everything we need			ENDP						EJECT;-------------------------------------------------------;;  IntHandler;;  Handle receiver and transmitter interrupts.;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		carry set if interrupt was not serviced;;  Registers:;		not preserved;;  Note: called with interrupts disabled, long;		accumulator and index registers;;-------------------------------------------------------IntHandler	PROCsccstat 	equ $0101				; SCC interrupt handledsccflag2	equ $0103				; interrupt mask for AppleTalkscc1		equ $0105				; data byte 1scc2		equ $0106				; data byte 2irq_a		equ $0108				; save A registerirq_x		equ $010A				; save X registerirq_y		equ $010C				; save Y registerirq_d		equ $0110				; save D registerirq_shadow	equ $0119				; save speedirq_aptlk	equ $E10020				; AppleTalk interrupt vectorshadow		equ $C035sccareg 	equ $C039sccadata	equ $C03Bsccbdata	equ $C03A;;  A copy of the start of the general interrupt handler from;  version 01 ROM follows;			ENTRY ROMcopy1			ROMcopy1	clc			xce			rep #$30			longa on			longi on			php			phb			pea $E1E1			plb			sta irq_a			lda shadow			sta irq_shadow			ora #$8000			and #$9F1E			sta shadow			stx irq_x			sty irq_y			tdc			sta irq_d			lda #0			tcd			sep #$30			longa off			longi off			bcc a1			lda 4,s			and #$10			adc #$70							ENTRY ROMcopy2ROMcopy2a1			bvs ROMorig6jml			ENTRY ROMcopy3ROMcopy3	lda #$03			sta sccareg			lda sccareg			bit sccflag2			beq a4			pha			and #$07			bne a2			lda sccadata			sta scc1			lda sccadata			sta scc2			jsl irq_aptlk			bra a3a2			lda sccbdata			sta scc1			lda sccbdata			sta scc2			jsl irq_aptlka3			lda #$00			ror a			sta sccstat			pla			bra a5a4			stz sccstat			ENTRY ROMcopy4ROMcopy4a5			bra check6850cardROMorig6jml	jml ROMorig6;;  Here it is finally, the 6850-based MIDI card interrupt code!;check6850card			php						; save everything important			pha			rep #$30			longa on			longi on			lda MidiZP				; find our direct page			tcd			stz intserviced			; interrupt not serviced yetagain		sep #$20			longa off			ldx slot 				; which slot is card in?			lda aciastat,x			; is it an acia interrupt?			bpl continue 			; no, continue interrupt handler in ROM			bit #$01 				; is it a receiver interrupt?			beq xmitint				; no, must be transmitter interrupt			sta intserviced			; remember that we serviced the int.			bit #$10 				; transmission error?			beq recvint1 			; no			ldy #miDevReadErr			bra deviceerrrecvint1	bit #$20 				; receiver overrun?			beq recvint2 			; no			ldy #miDevOverrun		; indicate overrun errordeviceerr	lda aciadata,x			; read current MIDI data			jsl inbuferrorglue		; call Midi Tool Set to buffer it			bra again				; try to get morerecvint2	lda aciadata,x			; read MIDI byte			jsl inbufglue			; call Midi Tool Set to buffer it			bra againxmitint 	jsl outbufglue			; get next char from Midi Tool Set			sep #$20 				; short accumulator			ldx slot			bcs nochar			sta aciadata,x			; send the char			bra inthandlednochar		lda interruptmask		; turn off transmitter interrupts			and #$FF-aciaxmiton			sta interruptmask			sta aciastat,x			bra inthandledcontinue	lda intserviced			; did we service the interrupt?			beq callROM				; no, continue general int. handlerinthandled	pla						; exit fast			plp			plb			rep #$30			jml ROMorig7callROM 	pla						; continue general interrupt handler			pea $0000			pld			plp			jml ROMorig5inbufglue	pea $0400				; call Midi Tool Set to buffer a char			phd			rtlinbuferrorglue pea $0500			; call Midi Tool Set with input error			phd			rtloutbufglue	pea $8400				; call Midi Tool Set for output char			phd			rtl;; This is the Interupt Handler to be used it TenSpeed Rom or later.;			Entry IRQIntHandlerIRQIntHandler			longa off			longi off			php						; save everything important			pha			phd			rep #$30			longa on			longi on			lda MidiZP				; find our direct page			tcd			stz intserviced			; interrupt not serviced yetIRQagain	sep #$20			longa off			ldx slot 				; which slot is card in?			lda aciastat,x			; is it an acia interrupt?			bpl IRQcontinue 		; no, continue interrupt handler in ROM			bit #$01 				; is it a receiver interrupt?			beq IRQxmitint			; no, must be transmitter interrupt			sta intserviced			; remember that we serviced the int.			bit #$10 				; transmission error?			beq IRQrecvint1 		; no			ldy #miDevReadErr			bra IRQdeviceerrIRQrecvint1	bit #$20 				; receiver overrun?			beq IRQrecvint2 			; no			ldy #miDevOverrun		; indicate overrun errorIRQdeviceerr lda aciadata,x			; read current MIDI data			jsl inbuferrorglue		; call Midi Tool Set to buffer it			brl IRQagain			; try to get moreIRQrecvint2	lda aciadata,x			; read MIDI byte			jsl inbufglue			; call Midi Tool Set to buffer it			bra IRQagainIRQxmitint 	jsl outbufglue			; get next char from Midi Tool Set			sep #$20 				; short accumulator			ldx slot			bcs IRQnochar			sta aciadata,x			; send the char			bra IRQinthandledIRQnochar	lda interruptmask		; turn off transmitter interrupts			and #$FF-aciaxmiton			sta interruptmask			sta aciastat,x			bra IRQinthandledIRQcontinue	lda intserviced			; did we service the interrupt?			beq IRQcallROM			; no, continue general int. handlerIRQinthandled				sep #$20			longa off			pld						; exit fast			pla			plp			clc			rtlIRQcallROM 				sep #$20			longa off			pld						; continue general interrupt handler			pla			plp			sec			rtl			longa on			longi on			ENDP						EJECT;-------------------------------------------------------;;  PollRecv;;  Poll the receiver and process any characters that;  have been received.;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and registers, and;		must return in this state;;-------------------------------------------------------PollRecv	PROC			phd						; save current direct page			tcd						; get our direct page			php						; save interrupt flagagain		sep #$24 				; short accumulator, SEI			longa off			ldx slot			lda aciastat,x			; read recv and xmit status			bit #$01 				; do we have a receive character?			bne recvint				; process received character			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtlrecvint			longa off			bit #$30 				; any errors?			bne recverr			lda aciadata,x			; retrieve character			jsl inbufglue			; call Midi Tool Set to buffer it			bra again				; try to get morerecverr 	bit #$10 				; transmission error?			bne recverr2			ldy #miDevOverrun		; record overrun condition			bra recverr3recverr2	ldy #miDevReadErr		; record framing errorrecverr3	lda aciadata,x			; retrieve character			jsl inbuferrorglue			bra againinbufglue	pea $0400				; call Midi Tool Set to buffer a char			phd			rtlinbuferrorglue pea $0500			; call Midi Tool Set with input error			phd			rtl			longa on			ENDP						EJECT;-------------------------------------------------------;;  RecvIntOn;;  Turn on receiver interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------RecvIntOn	PROC			phd						; save current direct page			tcd						; get our direct page			php			sep #$24 				; short accumulator, SEI			longa off			ldx slot 				; enable receiver interrupts			lda interruptmask			ora #aciarecvon			sta interruptmask			sta aciastat,x			lda aciadata,x			; clear any errors			lda aciadata,x			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtl			ENDP						EJECT;-------------------------------------------------------;;  RecvIntOff;;  Turn off receiver interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------RecvIntOff	PROC			phd						; save current direct page			tcd						; get our direct page			php			sep #$24 				; short accumulator, SEI			longa off			ldx slot 				; disable receiver interrupts			lda interruptmask			and #$FF-aciarecvon			sta interruptmask			sta aciastat,x			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtl			ENDP						EJECT;-------------------------------------------------------;;  PollXmit;;  Poll the transmitter and send the first character;  waiting for output if the transmitter is empty.;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and registers, and;		must return in this state;;-------------------------------------------------------PollXmit	PROC			phd						; save current direct page			tcd						; get our direct page			php			sep #$24 				; short accumulator, SEI			longa off			ldx slot			lda aciastat,x			; read recv and xmit status			bit #$02 				; ready to transmit a character?			beq done 				; no			jsl outbufglue			; get character			bcs done			ldx slot			sep #$20 				; short accumulator			tay						; save character			lda interruptmask		; enable transmitter interrupts			ora #aciaxmiton			sta interruptmask			sta aciastat,x			tya						; restore character			sta aciadata,x			; send the char			lda aciastat,x			; try to do another character			bit #$02			beq done			jsl outbufglue			ldx slot			sep #$20			bcs nochar			sta aciadata,xdone		plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtlnochar			longa off			lda interruptmask		; disable transmitter interrupts			and #$FF-aciaxmiton			sta interruptmask			sta aciastat,x			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtloutbufglue	pea $8400				; call Midi Tool Set for output char			phd			rtl			ENDP						EJECT;-------------------------------------------------------;;  XmitIntOn;;  Turn on transmitter interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------XmitIntOn	PROC			phd						; save current direct page			tcd						; get our direct page			php			sep #$24 				; short accumulator, SEI			longa off			ldx slot 				; enable transmitter interrupts			lda interruptmask			ora #aciaxmiton			sta interruptmask			sta aciastat,x			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtl			ENDP						EJECT;-------------------------------------------------------;;  XmitIntOff;;  Turn off transmitter interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------XmitIntOff	PROC			phd						; save current direct page			tcd						; get our direct page			php			sep #$24 				; short accumulator, SEI			longa off			ldx slot 				; disable transmitter interrupts			lda interruptmask			and #$FF-aciaxmiton			sta interruptmask			sta aciastat,x			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtl			ENDP						EJECT;-------------------------------------------------------;;  NotImpDriver;;  Reserved or unimplemented function.;;-------------------------------------------------------NotImpDriver PROC			lda #0			clc			rtl			ENDP						END