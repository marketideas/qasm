;-------------------------------------------------------;; apple.midi.aii;; This is a  device driver that interfaces a 1Mhz; serial-port device (such as the Apple MIDI Interface); to the Midi Tool Set.;; Copyright 1987, 1988, 1991 Apple Computer Inc.; Author: Don Marsh (x6739, AppleLink: MARSH1);; Modification History;; 13 Oct 87   DM	New today;; 11-Dec-91	Dave Lyons;; Added check in Shutdown to see if old interrupt vector; is $FFFFxx.  If so, we were never started, so we should; not "restore" important things we never messed with.;;-------------------------------------------------------			PRINT NOGEN,NOHDR,NOSTAT,NOMDIR						INCLUDE 'all.macros'			INCLUDE 'e16.midi'			 ; error code definitions;;  hardware definitions;SCCcommand		equ $E0BFFD				; base address of SCC command registerSCCdata			equ $E0BFFF				; base address of SCC data registerport1			equ $3C					; add to SCC base addresses for port 1port2			equ $3B					; add to SCC base addresses for port 2SCCrecvenable	equ $10					; mask to enable receiver interruptsSCCxmitenable	equ $02					; mask to enable transmitter interrupts;;  tool definitions;SerialVecID		equ $0009				; serial int. vector id for misc. tools;;  direct page usage;;  Note: a driver interface may use direct page locations;		 $80-$FF only.	If more memory is required, it;		 should be allocated using the memory manager ID;		 passed to the initialization routine.;				DSect $80userID			word 					; user ID for memory managerport			word 					; which port to useinterruptmask	word 					; recv and xmit interrupt enable byteintserviced		word 					; whether we serviced the interrupt;;  SCC interrupt control;SerFlagAddr		long 					; address of system variable SerFlagSerFlagBits		word 					; bits to turn on and off in SerFlagenddriveruse	DSectSize				; end of our direct page usage				CheckSize enddriveruse,$FF ; generate error if we are > $FF				EJECT				;;  PopArgs1 n;;  The following macro removes "n" bytes of arguments below a 3-byte;  RTL address in a time-efficient manner.;			MACRO&lab		PopArgs1 &num&lab			IF &num='' GOTO .DONE			IF &Eval(&num)=0 GOTO .DONE			LCLA &popnum&popnum		SETA &Eval(&num)			lda 2,s			sta 2+&popnum,s			IF &popnum>=2 GOTO .DOPULLS			pla			phb			sta 1,s			MEXIT.DOPULLS			pla			sta &popnum-1,s&popnum		SETA &popnum-2			IF &popnum=0 GOTO .DONE			IF &popnum=1 GOTO .DISCARD1			IF &popnum=2 GOTO .DISCARD2			tsc			clc			adc #&popnum			tcs			MEXIT.DISCARD1			phb.DISCARD2			pla.DONE			MEND			EJECT			;;  the driver table used by the Midi Tool Set;DriverTable	PROC			Import Init			Import IntHandler			Import NotImpDriver			Import PollRecv			Import PollXmit			Import RecvIntOff			Import RecvIntOn			Import Reset			Import Shutdown			Import XmitIntOff			Import XmitIntOn			DC.L Init-1				; initialization routine			DC.L Shutdown-1			; shutdown routine			DC.L Reset-1			; reset routine			DC.L IntHandler-1		; interrupt handler			DC.L PollRecv-1			; routine to poll receiver			DC.L RecvIntOn-1 		; routine to enable recv interrupts			DC.L RecvIntOff-1		; routine to disable recv interrupts			DC.L PollXmit-1			; routine to poll transmitter			DC.L XmitIntOn-1 		; routine to enable xmit interrupts			DC.L XmitIntOff-1		; routine to disable xmit interrupts			DC.L NotImpDriver-1		; reserved			DC.L NotImpDriver-1		; reserved			DC.L NotImpDriver-1		; reserved			ENDP			EJECT;-------------------------------------------------------;;  Init;;  Initialize the appropriate port.;;  Inputs:;		space for old interrupt vector (long);		new interrupt vector (long);		slot number (word);		internal(=0)/external(=1) (word);		user id (word);;		the accumulator contains the driver's direct page;		 (the current direct page register must be;		 preserved);;  Outputs:;		carry set if initialization was unsuccessful,;		error code in low byte of accumulator;;  Registers:;		not preserved;;  Note: called with interrupts disabled;;-------------------------------------------------------Init		PROC;;  stack offsets;			DefineStacks_dirpage	word 					; old direct page registers_rtl		block 3					; rtl addresss_argstart	DSectSize				; start of argumentss_userid	word 					; user ID for memory managers_external	word 					; 0 = internal, 1 = external slots_slot		word 					; which slots_newintvec	long 					; new interrupt vector addresss_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstarts_oldintvec	long 					; return old interrupt vector address;;  this driver works only with serial ports, slots 1 and 2 internal;			phd						; save current direct page register			tcd						; get driver's direct page			lda s_slot,s 			; must be slot 1 or 2			cmp #1			bcc notavail			cmp #3			bcs notavail			lda s_external,s 		; must be internal			beq slotoknotavail	ldx #miDevNotAvail		; device not available on this slot			jmp doneslotok		lda s_userid,s			; save user ID (not used in this driver)			sta userID;;  set up for initialization of the system variable "SerFlag", and;  make sure that the requested port is available;checkport	pha			_MTVersion				; which version of Miscellaneous Tools			pla			bcs donejmp				; Misc. Tools error			and #$7FFF				; clear prototype bit			cmp #$0200				; is it less than version 2.0?			bcc fixedaddr			; yes, assume fixed address for SerFlag			pea 0					; use Misc. Tools to find address			pea 0			pea $000E			_GetAddr			tax			pla			ply			bcc gotaddrdonejmp 	jmp done 				; Misc. Tools errorfixedaddr	lda #$0104			ldy #$00E1gotaddr 	sta SerFlagAddr			sty SerFlagAddr+2			sep #$20 				; short accumulator			longa off			lda s_slot,s 			; which port do we want?			dec a			beq port1bits			lda #%00000111			; set these bits in SerFlag			bra setserflagport1bits	lda #%00111000setserflag	sta SerFlagBits			lda [SerFlagAddr]		; get current value of SerFlag			and SerFlagBits			; is the port already in use?			rep #$20 				; long accumulator			longa on			beq setbits			ldx #miDevSlotBusy		; port is busy			jmp done;;  set the global SerFlag so that the interrupt handler will call;  our vector;setbits 	lda [SerFlagAddr]		; install our bits in SerFlag variable			ora SerFlagBits			sta [SerFlagAddr];;  patch the serial interrupt vector;			pea 0					; get old serial interrupt vector			pea 0			pea SerialVecID			_GetVector			pla			sta s_oldintvec+2,s			pla			sta s_oldintvec+2,s			pea SerialVecID			; set new serial interrupt vector			lda s_newintvec+2+2,s			pha			lda s_newintvec+4,s			pha			_SetVector;;  initialize SCC;			sep #$20 				; short accumulator			longa off			lda #9					; talk to SCC register 9			sta SCCcommand+port1			lda s_slot,s 			; port 1?			dec a			beq initport1			ldx #port2				; use port2			lda #$42 				; channel B reset			bra initportinitport1	ldx #port1				; use port1			lda #$82 				; channel A resetinitport	stx port 				; which port to use			sta SCCcommand,x			lda #11					; external clocks in and out			sta SCCcommand,x			lda #$28			sta SCCcommand,x			lda #4					; clock divisor for 1Mhz, 1 stop bit			sta SCCcommand,x			lda #$84			sta SCCcommand,x			lda #3					; 8 bits in, receiver disabled			sta SCCcommand,x			lda #$C0			sta SCCcommand,x			lda #5					; 8 bits out, transmitter enabled			sta SCCcommand,x 		;	and power to MIDI box (RTS)			lda #$6A			sta SCCcommand,x			lda #1					; disable recv and xmit interrupts			sta SCCcommand,x			lda #$00			sta SCCcommand,x			sta interruptmask		; remember recv and xmit ints disabled			lda #15					; disable external/status interrupts			sta SCCcommand,x			lda #$00			sta SCCcommand,x			lda #$10 				; reset external/status interrupts			sta SCCcommand,x			lda #9					; enable master interrupt			sta SCCcommand,x			lda #$0A			sta SCCcommand,x			lda #14					; set up DTR (is this necessary?)			sta SCCcommand,x			lda #$04			sta SCCcommand,x			rep #$20 				; long accumulator			longa on			ldx #0					; no errorsdone		pld						; restore direct page register			PopArgs1 s_argsize		; move one RTL address			txa						; restore error code			cmp #1					; set carry on error			rtl			ENDP						EJECT;-------------------------------------------------------;;  Shutdown;;  Shutdown the interface.;;  Inputs:;		old interrupt vector (long);;		the accumulator contains the driver's direct page;		(the current direct page register must be;		preserved);;  Outputs:;		carry set if shutdown was unsuccessful,;		error code in low byte of accumulator;;  Registers:;		not preserved;;  Note: called with interrupts disabled;;-------------------------------------------------------Shutdown	PROC;;  stack offsets;			DefineStacks_dirpage   word 					; old direct page registers_rtl		block 3					; rtl addresss_argstart	DSectSize				; start of argumentss_oldintvec	long 					; return old interrupt vector addresss_argend	DSectSize				; end of argumentss_argsize	equ s_argend-s_argstart			phd						; save old direct page register			tcd						; get driver's direct page*** added 11-Dec-91 DAL -- if we never started, don't fry evertying trying to restore it			lda s_oldintvec+1,s		;middle word			beq neverStarted			inc a			beq neverStarted		;$FFFFxx = never started*** end 11-Dec-91;;  reset the SCC port;			sep #$20 				; short accumulator			longa off			lda #9					; talk to SCC register 9			sta SCCcommand+port1			lda #$8A 				; channel A reset			ldx port 				; port 1?			cpx #port1			beq shutport			lda #$4A 				; channel B resetshutport	sta SCCcommand+port1;;  restore system variable SerFlag so that SCC interrupts on;  this port are not handled;			lda [SerFlagAddr]		; restore system variable SerFlag			eor SerFlagBits			sta [SerFlagAddr];;  restore old serial interrupt vector;			rep #$20			longa on			pea SerialVecID			lda s_oldintvec+2+2,s			pha			lda s_oldintvec+2+2,s			pha			_SetVectorneverStarted			pld						; restore direct page			PopArgs1 s_argsize		; move RTL address			lda #0					; no errors			clc			rtl			ENDP						EJECT;-------------------------------------------------------;;  Reset;;  Take care of hardware after system reset (essentially;  a shutdown, but special conditions may arise after;  a system reset).;;  Inputs:;		old interrupt vector (long);;		the accumulator contains the driver's direct page;		(the current direct page register must be;		preserved);;  Outputs:;		carry set if shutdown was unsuccessful,;		error code in low byte of accumulator;;  Registers:;		not preserved;;  Note: called with interrupts disabled;;-------------------------------------------------------Reset		PROC			jmp Shutdown 			; this does everything we need			ENDP			EJECT;-------------------------------------------------------;;  IntHandler;;  Handle receiver and transmitter interrupts.;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		carry set if interrupt was not serviced;;  Registers:;		not preserved;;  Note: called with interrupts disabled, long;		accumulator and index registers;;-------------------------------------------------------IntHandler	PROC			phd						; save current direct page			tcd						; get our direct page			stz intserviced			; interrupt not serviced yetagain		sep #$20 				; short accumulator			longa off			ldx port			lda SCCcommand,x 		; read recv and xmit status			bit #$01 				; do we have a receive character?			bne recvint				; process received character			and #$04 				; ready to transmit a character?			beq done			lda interruptmask		; are transmitter interrupts enabled?			bit #SCCxmitenable			bne xmitint				; send another characterdone		cmp intserviced			; set carry if we didn't service int.			pld						; restore direct page			rtl						; don't have to return with long acc.recvint 	sta intserviced			; we serviced this interrupt			lda #1					; check for errors			sta SCCcommand,x			lda SCCcommand,x			and #$60			beq @2		 			; data is ok			and #$20				; is it overrun error?			bne @1					; yes						lda SCCdata,x			; must be framing error			ldy #miDevReadErr			jsl inbuferrorglue		; call Midi Tool Set to buffer it			bra again			@1			lda SCCdata,x			; retrieve character			tay						; save it			lda #$30				; reset overrun condition			sta SCCcommand,x			tya						; restore character			ldy #miDevOverrun			jsl inbuferrorglue		; call Midi Tool Set to buffer it			bra again				; try to get more@2			lda SCCdata,x			; retrieve character			jsl inbufglue			; call Midi Tool Set to buffer it			bra again				; try to get morexmitint 	jsl outbufglue			; get next char from Midi Tool Set			sep #$20 				; short accumulator			ldx port			bcs nochar			sta SCCdata,x			; send the char			pld						; restore direct page			rtlnochar		lda #1					; disable transmitter interrupts			sta SCCcommand,x			lda interruptmask			and #$FF-SCCxmitenable			sta interruptmask			sta SCCcommand,x			pld						; restore direct page			clc			rtlinbufglue	pea $0400				; call Midi Tool Set to buffer a char			phd			rtlinbuferrorglue pea $0500			; call Midi Tool Set with input error			phd			rtloutbufglue	pea $8400				; call Midi Tool Set for output char			phd			rtl			longa on							ENDP						EJECT;-------------------------------------------------------;;  PollRecv;;  Poll the receiver and process any characters that;  have been received.;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and registers, and;		must return in this state;;-------------------------------------------------------PollRecv	PROC			phd						; save current direct page			tcd						; get our direct page			php						; save interrupt flagagain		sep #$24 				; short accumulator, SEI			longa off			ldx port			lda SCCcommand,x 		; read recv and xmit status			lsr a					; do we have a receive character?			bcs recvint				; process received character			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtlrecvint			longa off			lda #1					; check for errors			sta SCCcommand,x			lda SCCcommand,x			and #$60			beq @2		 			; data is ok			and #$20				; is it overrun error?			bne @1					; yes						lda SCCdata,x			; must be framing error			ldy #miDevReadErr			jsl inbuferrorglue		; call Midi Tool Set to buffer it			bra again			@1			lda SCCdata,x			; retrieve character			tay						; save it			lda #$30				; reset overrun condition			sta SCCcommand,x			tya						; restore character			ldy #miDevOverrun			jsl inbuferrorglue		; call Midi Tool Set to buffer it			bra again				; try to get more@2			lda SCCdata,x			; retrieve character			jsl inbufglue			; call Midi Tool Set to buffer it			bra again				; try to get moreinbufglue	pea $0400				; call Midi Tool Set to buffer a char			phd			rtlinbuferrorglue pea $0500			; call Midi Tool Set with input error			phd			rtl			longa on			ENDP						EJECT;-------------------------------------------------------;;  RecvIntOn;;  Turn on receiver interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------RecvIntOn	PROC			phd						; save current direct page			tcd						; get our direct page			sep #$20 				; short accumulator			longa off			ldx port			lda #3					; enable the receiver			sta SCCcommand,x			lda #$C1			sta SCCcommand,x			lda #1					; enable receiver interrupts			sta SCCcommand,x			lda interruptmask			ora #SCCrecvenable			sta interruptmask			sta SCCcommand,x			rep #$21 				; long accumulator, CLC			longa on			pld						; restore direct page			lda #0					; no errors			rtl			ENDP						EJECT;-------------------------------------------------------;;  RecvIntOff;;  Turn off receiver interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------RecvIntOff	PROC			phd						; save current direct page			tcd						; get our direct page			sep #$20 				; short accumulator			longa off			ldx port			lda #3					; disable the receiver			sta SCCcommand,x			lda #$C0			sta SCCcommand,x			lda #1					; disable receiver interrupts			sta SCCcommand,x			lda interruptmask			and #$FF-SCCrecvenable			sta interruptmask			sta SCCcommand,x			rep #$21 				; long accumulator, CLC			longa on			pld						; restore direct page			lda #0					; no errors			rtl			ENDP						EJECT;-------------------------------------------------------;;  PollXmit;;  Poll the transmitter and send the first character;  waiting for output if the transmitter is empty.;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and registers, and;		must return in this state;;-------------------------------------------------------PollXmit	PROC			phd						; save current direct page			tcd						; get our direct page			php			sep #$24 				; short accumulator, SEI			longa off			ldx port			lda SCCcommand,x 		; read recv and xmit status			bit #$04 				; ready to transmit a character?			beq done 				; no			jsl outbufglue			; get character			bcs done			ldx port			sep #$20 				; short accumulator			tay						; save character			lda #1					; enable transmitter interrupts			sta SCCcommand,x			lda interruptmask			ora #SCCxmitenable			sta interruptmask			sta SCCcommand,x			tya						; restore character			sta SCCdata,x			; send the char			lda SCCcommand,x 		; try to do another character			bit #$04			beq done			jsl outbufglue			ldx port			sep #$20			bcs nochar			sta SCCdata,xdone		plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtlnochar					longa off			lda #1					; disable transmitter interrupts			sta SCCcommand,x			lda interruptmask			and #$FF-SCCxmitenable			sta interruptmask			sta SCCcommand,x			plp			longa on			pld						; restore direct page			lda #0					; no errors			clc			rtloutbufglue	pea $8400				; call Midi Tool Set for output char			phd			rtl			ENDP			EJECT			;-------------------------------------------------------;;  XmitIntOn;;  Turn on transmitter interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------XmitIntOn	PROC			phd						; save current direct page			tcd						; get our direct page			sep #$20 				; short accumulator			longa off			ldx port			lda #1					; enable transmitter interrupts			sta SCCcommand,x			lda interruptmask			ora #SCCxmitenable			sta interruptmask			sta SCCcommand,x			rep #$21 				; long accumulator, CLC			longa on			pld						; restore direct page			lda #0					; no errors			rtl			ENDP						EJECT;-------------------------------------------------------;;  XmitIntOff;;  Turn off transmitter interrupts;;  Inputs:;		accumulator contains driver's direct page;		(current direct page register must be;		preserved);;  Outputs:;		none;;  Registers:;		not preserved;;  Note: called with long accumulator and index registers,;		and must return in this state;;-------------------------------------------------------XmitIntOff	PROC			phd						; save current direct page			tcd						; get our direct page			sep #$20 				; short accumulator			longa off			ldx port			lda #1					; disable transmitter interrupts			sta SCCcommand,x			lda interruptmask			and #$FF-SCCxmitenable			sta interruptmask			sta SCCcommand,x			rep #$21 				; long accumulator, CLC			longa on			pld						; restore direct page			lda #0					; no errors			rtl			ENDP						EJECT;-------------------------------------------------------;;  NotImpDriver;;  Reserved or unimplemented function.;;-------------------------------------------------------NotImpDriver PROC			lda #0			clc			rtl			ENDP						END