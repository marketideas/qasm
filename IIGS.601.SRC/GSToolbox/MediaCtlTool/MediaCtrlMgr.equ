;------------------------------------------;; Equates from procedure Tool;;------------------------------------------True           equ $0001False          equ $0000MaxChannelNo   equ 8			;max. media channel numberIncBusyFlg	   equ $e10064DecBusyFlg	   equ $e10068***************************************************************** Error Equates****************************************************************UnImp		equ $2601			;Unimplemented for this deviceNotApplic	equ UnImp			;Not applicable to this deviceBadSpeed	equ $2602			;Invalid speed specifiedBadUnitType	equ $2603			;Invalid unit type specifiedTimeOutErr	equ $2604			;Timed out during device readNotLoaded	equ $2605			;Driver was not loaded?BadAudio	equ $2606			;Invalid Audio ValueDevRtnError	equ $2607			;Device returned error (unable to perform)UnRecStatus	equ $2608			;Unrecognizable status from deviceBadSelector	equ $2609			;Invalid selector value specifiedFunnyData	equ	$260a			;funny data receive (retry again)InvalidPort	equ $260b			;invalid port specifiedOnlyOnce	equ $260c			;scans only onceNoResMgr	equ $260d			;Resource manager not activeItemNotThere equ $260e			;Item Not found in databaseWasShutdown equ $260f			;tool was already shutdownWasStarted	equ $2610			;tool was already startedBadChannel	equ $2611			;invalid channel numberInvalidParam equ $2612			;Invalid ParameterCallNotSupported equ $2613		;call not supported errorMissingDriver	equ NotLoadedWriteProtected 	equ $2BInvalidRefNum  	equ $43FileNotFound 	equ $46VolumeNotFound 	equ $45FileLocked	   	equ $4E				; Access: file not write-enabledVersionNb      	equ $0100            	Toolnum        	equ 38DriverID		equ $3883			;Media Control Driver IDAuxTypeMC	   	equ $0400			;media ctrl drivers file aux typeFileTypeMC	   	equ $BB				;drivers file type;------------------------------------------------------;;	Direct page equates ;;**Note: Be sure that DirectStack reflects total direct page bytes;------------------------------------------------------Temp1          equ 0                    ; Temp values to dereference easilyTemp2          equ Temp1+4DP0			   equ Temp1DP2            equ DP0+2DP4            equ DP0+4DP6            equ DP0+6DirectStack	   equ DP0+10				;Total no. of direct page bytes required;------------------------------------------------------;; Media Device Driver calls;;------------------------------------------------------omcGetName		equ 0omcDStartUp		equ 1*4omcDShutDown	equ 2*4omcGetFeatures	equ 3*4omcPlay			equ 4*4omcPause		equ 5*4omcSendRawData	equ	6*4omcGetStatus	equ 7*4omcControl		equ 8*4omcScan			equ 9*4omcGetSpeeds	equ 10*4omcSpeed		equ 11*4omcStopAt		equ 12*4omcJogN			equ 13*4omcSearchTo		equ 14*4omcSearchDone	equ 15*4omcSearchWait	equ 16*4omcGetPosition	equ 17*4omcSetAudio		equ 18*4omcGetTimes		equ 19*4omcGetDiscTOC	equ 20*4omcGetDiscID	equ 21*4omcGetNoTracks	equ 22*4omcRecord		equ 23*4omcStop			equ 24*4omcWaitRawData	equ 25*4omcSetVolume	equ 26*4;------------------------------------------;; Equates from procedure ReadDirData;;------------------------------------------ListEntrySize  equ 38                   ; 33 + 4 + 1