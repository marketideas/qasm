 MACRO&lab moveword &from,&to1,&to2 LCLC &C&C setc &substr(&from,1,1) IF &C='[' GOTO .zeropage&lab lda &from sta &to1 IF &to2='' GOTO .a sta &to2.a MEXIT.zeropage IF &to1='0' GOTO .b&lab ldy #&to1 lda &from,y sta &to2 MEXIT.b&lab lda &from sta &to2 MEND   MACRO&lab movelong &from,&to1,&to2 LCLC &C LCLC &REST&C setc &substr(&from,1,1)&REST setc &substr(&from,2,&LEN(&from)-1) IF &C='[' GOTO .zeropage IF &to2='' GOTO .a&lab moveword &from,&to1,&to2 GOTO .b.a&lab moveword &from,&to1.b IF &C='#' GOTO .immediate IF &to2='' GOTO .c moveword &from+2,&to1+2,&to2+2 MEXIT.c moveword &from+2,&to1+2 MEXIT.immediate IF &to2='' GOTO .d moveword #^&REST,&to1+2,&to2+2 MEXIT.d moveword #^&REST,&to1+2 MEXIT.zeropage&lab moveword &from,&to1,&to2 ldy #&to1+2 lda &from,y sta &to2+2 MEND MACRO&lab _GetDeviceName&lab ldx #$1713 jsl $E10000 MEND MACRO&lab _PrDevStartup&lab ldx #19+256*26 jsl $E10000 MEND MACRO&lab _PrDevShutDown&lab ldx #19+256*27 jsl $E10000 MEND MACRO&lab _GETFILEINFO &params&lab jsl $E100A8	DC.W	6	DC.L	&params MEND MACRO&lab _GETBOOTVOL &params&lab jsl $E100A8	DC.W	$28	DC.L	&params MEND  MACRO&lab _DevIsItSafe&lab ldx #$3013 jsl $E10000 MEND  MACRO&lab _DevPrChanged&lab ldx #$1913 jsl $E10000 MEND