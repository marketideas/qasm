ectDestX	equ 122SectType	equ 124SectAltData	equ 126SectColor	equ 254SectFudgeColor	equ 254SectSize	equ 256;;   Equates into Monster definition;MonsBBank	equ $8	; bank monster bmaps loaded intoMonsName	equ 0	; Pascal string [79]MonsType	equ $50MonsTreasChance	equ $52MonsTreasType	equ $54MonsLevel	equ $5CMonsMoveMeth	equ $5EMonsHoming	equ $60MonsProjectile	equ $62MonsHitPoint	equ $64MonsContactDam	equ $66MonsShotDamage	equ $68MonsSpeed	equ $6AMonsFlags	equ $6CMonsMiscData	equ $6EMonsSize	equ $80;;   File types for the Load file routines;FTMap	equ $00FTPallet	equ $01FTColor	equ $02FTMonster	equ $03FTBitMap	equ $04FTSound	equ $05;;   Monster file offsets;MBMNumChars	equ $0000MBMCharIndex	equ $0002MBMShotIndex	equ $007AMBMObjIndex	equ $00F2; Into each character record offsets areMBMCHeight	equ $00MBMCWidth	equ $02MBMTable	equ $04MBMMaskTable	equ $08MBMCEastst	equ $0CMBMCEastend	equ $0EMBMCWestst	equ $10MBMCWestend	equ $12MBMCNorthst	equ $14MBMCNorthend	equ $16MBMCSouthst	equ $18MBMCSouthend	equ $1AMBMCShootE	equ $1CMBMCShootW	equ $1EMBMCShootN	equ $20MBMCShootS	equ $22MBMMonsSize	equ $24;;   Directional Equates;DIRNorth	equ $1DIRNorthEast	equ $2DIREast	equ $3DIRSouthEast	equ $4DIRSouth	equ $5DIRSouthWest	equ $6DIRWest	equ $7DIRNorthWest	equ $8DIRFade	equ $9;;   Movement equatesWalking	equ $0Flying	equ $1Swimming	equ $2;;   Special Sector command dispatch types;NoAction	equ 0	; no action should be takenNewSector	equ 1	; sped should enter	sector in <X>AddHP	equ 2	; sped gains <X> hit pointsAddHPMax	equ 3	; sped HPMax increases by <X>AddWandPt	equ 4	; Sped gets <X> more wand ptsAddTreasure	equ 5	; sped adds <X> treasureGetMore	equ $8000	; special sector routine needs to be called again!;; Special sector command codesSSectInit	equ 0SSpecShutDown	equ 1SSectCheckForMons	equ 2SSectSpedHit	equ 3SSectShotHit	equ 4SSectMonsDead	equ 5SSectIdle	equ 6SSectMonShotHit	equ 7    SSectMonHit	equ 8;; Parameter offsets into AltData to pass info into special sectors.Param0	equ 0Param1	equ 2Param2	equ 4Param3	equ 6Param4	equ 8;; CColFlags values..StageCollide	equ $8000ActorCollide	equ $4000MyIntVector	equ $000A	; interupt vector to steal...;;   Direct Page equates for the whole program;CXPosOff	equ $0	; Direct page offsetsCYPosOff	equ CXPosOff+2	; 2CCurPOff	equ CYPosOff+2	; 4CMinPOff	equ CCurPOff+2	; 6CMaxPOff	equ CMinPOff+2	; 8CDXOff	equ CMaxPOff+2	; ACDYOff	equ CDXOff+2	; CCIterOff	equ CDYOff+2	; ECCursOff	equ CIterOff+2	; 10 ; doesn't seem to be used in the toolkit yet..; Alternate useage for the  collision info area..cColFlags	equ CCursOff	; 10CXCenter	equ CCursOff+2	; 12CYCenter	equ CXCenter+2	; 14CEndOfVars	equ CYCenter+2	; 16CHeightOff	equ CEndOfVars	; 16CWidthOff	equ CHeightOff+2	; 18CFTabOff	equ CWidthOff+2	; 1ACMTabOff	equ CFTabOff+4	; 1ECharTSize	equ CMTabOff+4	; 22CNorthPhase	equ CharTSize	; 22CEastPhase	equ CNorthPhase+4	; 26CSouthPhase	equ CEastPhase+4	; 2aCWestPhase	equ CSouthPhase+4	; 2cCShootPhase	equ CWestPhase+4	; 30CDirOff	equ CShootPhase+8	; 38CSpeedOff	equ CDirOff+2	; 3aCCoLInfo	equ CSpeedOff+2	; 3CSizeOfAnimRec	equ CCoLInfo+4	; 40;;LinePt	equ $30InvPalArry	equ $34MyBitMap	equ $38CSectPt	equ $3CDeRef	equ $40TheMap	equ $44PalletArry	equ $48ScreenTab	equ $4CPassChar	equ $50	; current character	we workin withtheChar	equ $54CharNum	equ $58AnimState	equ $5AZPHandle	equ $60ZPPointer	equ $64MonsPtr	equ $68theMonNum	equ $70;theMons	equ $72;BackGnd	equ $B0BackPtr	equ $B4MyPointer	equ $BC; General Animation Tool Equates start here:ZPMemID	equ  $E0	; application callers IDAppPatchArea	equ  $E2	; pointer to patch zone inside of the appStageRect	equ  $E4StageRectTop	equ  $E4StageRectLeft	equ  $E6StageRectbottom	equ  $E8StageRectRight	equ  $EACallTemps	equ  $F0	; 16 bytes for any toolkit call to utilize..;; Collision flags area..; Animation toolset script language commands and equatesScriptEnd	equ 0GotoItem	equ 1MoveRel	equ 2MoveAbs	equ 3SetVariable	equ 4IncVariable	equ 5DecVariable	equ 6IfVariable	equ 7KillChar	equ 8; More to come later..;; Animation Toolset ErrorsToolCallHighNum	equ $2500NotSupportedCall	equ $2501	; used when a not yet implemented feature is usedAlreadyStarted	equ $2502	; if starting already started toolBadParm	equ $2503	; if passing a bad parm to the toolToolNotStarted	equ $2504	; if using before startingToolExplosion	equ $2505	; Direct page link error. FATAL!ToolNeeded	equ $2506	; qdnot started (or other tool)TockListOverflow	equ $2510	; exceeded the maximum number of tock tasks.ShadowReg	equ $E0C035	; register that turns on shadowing