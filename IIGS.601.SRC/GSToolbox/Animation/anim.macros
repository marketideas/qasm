************************************************************************** Macros used in Game* ©1989 Two guys and a cabbage software** 2/4/89	Mensch*	Made kill macro stack based...** 3/13/89	Mensch & Williamson*	Merged. Added NewStartChar Macro**************************************************************************	MACRO&Lab	OldStChar &CNum,&MinP,&MaxP,&x,&y&Lab	lda &CNum	sta $80	lda &MinP	sta $82	lda &MaxP	sta $84	lda &x	sta $86	lda &y	sta $88	jsl StartChar	MEND	MACRO&Lab	OldStartCH &CNum,&Dir,&x,&y&Lab	lda &CNum	sta $80	lda &Dir	sta $82	lda #$8000	sta $84	lda &x	sta $86	lda &y	sta $88	jsl StartChar	MEND	MACRO&Lab	NewStartCH &CNum,&MinP,&MaxP,&x,&y&Lab	PushWord &y	PushWord &x	PushWord &MaxP	PushWord &MinP	PushWord &CNum	jsl StartStackChar	MEND	MACRO&Lab	StChar &CNum,&MinP,&MaxP,&x,&y&Lab	PushWord &y	PushWord &x	PushWord &MaxP	PushWord &MinP	PushWord &CNum	jsl StartStackChar	MEND	MACRO&Lab	StartCH &CNum,&Dir,&x,&y&Lab	PushWord &y	PushWord &x	PEA $8000	PushWord &Dir	PushWord &CNum	jsl StartStackChar	MEND	MACRO&Lab	MvChar &CNum,&dx,&dy,&I&Lab	lda &CNum	sta $80	lda &dx	sta $82	lda &dy	sta $84	lda &i	sta $86	jsl MoveChar	MEND	Macro&Lab	OldMoveCH &CNum,&Speed,&I&Lab	lda &CNum	sta $80	lda &Speed	sta $82	lda #$8000	sta $84	lda &i	sta $86	jsl MoveChar	MEnd	MACRO&Lab	MoveCH &CNum,&Speed,&I&Lab	PushWord &I	PEA $8000	PushWord &Speed	PushWord &CNum	jsl MoveStackChar	MEnd		MACRO&Lab	Kill &CNum&Lab	PushWord &CNum	jsl DoKill	MEND	MACRO&Lab	InitChar &CNum,&theChar&Lab	lda &CNum	sta $80	lda &theChar	sta $82	MEND	MACRO&Lab	Stz4 &x&Lab	stz &x	stz &x+2	MEND	MACRO&Lab	LoadActor&Lab	jsl LoadAChar	MEND	MACRO&Lab	Debug &Marker,&x,&y&Lab	pha	pea 0	PushWord &y	PushWord &x	pea &Marker	jsl GameDebug	MEND	MACRO	ProcHdr &ProcName	GBLA &procDebugFlag	IF &ProcDebugFlag THEN	  pha	  pea 0	  pea @2>>16	  pea @2	  pea $7FFF	  jsl GameDebug	  bra @1@2	  dc.B &procName,0@1	ENDIF	MEND	MACRO&Lab	ProcDB &ProcNum,&x,&y	GBLA &procDebugFlag	IF &ProcDebugFlag THEN&Lab	  pha	  pea 0	  PushWord &y	  PushWord &x	  pea &ProcNum	  jsl GameDebug	ENDIF	MEND	MACRO&Lab	DebugL &Marker,&x&Lab	pha	pea 1	PushLong &x	pea &Marker	jsl GameDebug	MEND	MACRO&Lab	DebugStr &Marker,&String&Lab	pha	pea $8000	PushLong #&String	pea &Marker	jsl GameDebug	MEND	MACRO&Lab	BneL &destination&Lab	beq  *+5	brl  &Destination	MEND;	MACRO;&Lab	BeqL &destination;&Lab	bne  *+5;	brl  &Destination;	MEND;	MACRO;&Lab	BplL &destination;&Lab	bmi  *+5;	brl  &Destination;	MEND;	MACRO;&Lab	BmiL &destination;&Lab	bpl  *+5;	brl  &Destination;	MEND;;	MACRO;&Lab	BccL &destination;&Lab	bcs  *+5;	brl  &Destination;	MEND	MACRO&Lab	BcsL &destination&Lab	bcc  *+5	brl  &Destination	MEND	MACRO&Lab	ATimes2&Lab	asl a	MEND	MACRO&Lab	ATimes4&Lab	asl a	asl a	MEND	MACRO&Lab	ATimes8&Lab	asl a	asl a	asl a	MEND	MACRO&Lab	ATimes16&Lab	asl a	asl a	asl a	asl a	MEND	MACRO&Lab	ATimes6&Lab	asl a	pha	asl a	clc	adc 1,s	sta 1,s	pla	MEND	MACRO&Lab	ATimes10&Lab	ATimes2	pha	ATimes4	clc	adc 1,s	sta 1,s	pla	MEND		MACRO&Lab	UnlinkRTL &NumBytes	sep #$20	; now get the return address	Longa Off	pla	; and save it	ply	; pull 3 byte return address	LCLA &cntr	; define a var&cntr	SETA 00	; init to zero	WHILE &cntr<(&NumBytes/2) DO	  plx	  &cntr: SETA &cntr+1	ENDWHILE	phy	pha	rep #$20	LongA On	; stack frame is now adjusted	MEND