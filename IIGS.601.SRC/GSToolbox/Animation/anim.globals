******************************************************************************** Game.Globals** (C)  Copyright Two guys and a cabbage	software 1988* All rights reserved.** by Mensch and Williamson* 7/18/88** This is the record template to be used when dealing with the globals segment*** Files:		print push,off	Include 'AIIGSRecords.AII'	print pop**** Modification History:** Version 1.0   	Mensch** Add Exception flags here...*******************************************************************************MonsRecord	Record 0; This is a template for monster data it reflects the storage format of each; monster record in the gamexxxx.MON file.Type	ds.B 2	; monster type defeined by steve		; Bit 15 = a treasure		; Bit 14 = Special MonsterTreasChance	ds.B 2	; chance this guy will leave one of the treasuresTreasType	ds.B 8	; 4 integers showing which treasures can be leftLevel	ds.B 2	; monsters level, used by random monster generatorMoveMeth	ds.B 2	; 0=Walking 1=flying 2=swimmingHoming	ds.B 2	; Monsters intelligence class, tells how monster movesProjectile	ds.B 2	; 0= no shots 0<> means shootsHP	ds.B 2	; number of HP monsters of this type start withDamage	ds.B 2	; amount of damage done when monster touches spedShotDamage	ds.B 2	; amount of damage done when monster shoots spedSpeed	ds.B 2	; speed to move this monster (!!!!! Not implemented yet !!!!!!)Flags	ds.B 2	; bit 15 = collision flagDontUse	ds.B 2	; room to grow this record	EndRMapMgrRecord	Record 0; used to allocate our table of map handles. Each entry in this table; will corospond to a map number. Currently, we will allow up to 32 maps,; but we may need more in the future.thisMapData	ds.L 1thisMapColor	ds.L 1thisMapPallet	ds.L 1thisMapMons	ds.L 1	EndR	TockTask	Record 0; Used with time manager to pace things that occur in this game. Count	ds.W 1	; countdown to firing this task...ID	ds.W 1	; ID of the task to performData	ds.L 1	; Reference constant for the taskPtr	ds.L 1	; If the task needs to jump somewhereSpare	ds.L 1	; used by Jim in time manager...	ENDR	KillRectRecord	Record 0xPosition	ds.W 1yPosition	ds.W 1width	ds.W 1height	ds.W 1	EndR	AnimRecordTemplate	Record 0; Template for use when importing any of the monster anim record data; Why didn't I think of this sooner????ARTXPosOff	ds.W 1	; Direct page offsetsARTYPosOff	ds.W 1	; 2ARTCurPOff	ds.W 1	; 4ARTMinPOff	ds.W 1	; 6ARTMaxPOff	ds.W 1	; 8ARTDXOff	ds.W 1	; AARTDYOff	ds.W 1	; CARTIterOff	ds.W 1	; EARTCursOff	ds.W 1	; 10ARTXCenter	ds.W 1	; 12ARTYCenter	ds.W 1	; 14ARTHeightOff	ds.W 1	; 16ARTWidthOff	ds.W 1	; 18ARTFTabOff	ds.L 1	; 1AARTMTabOff	ds.L 1	; 1EARTNorthPhase	ds.L 1	; 22ARTEastPhase	ds.L 1	; 26ARTSouthPhase	ds.L 1	; 2aARTWestPhase	ds.L 1	; 2cARTShootPhase	ds.L 2	; 30ARTDirOff	ds.W 1	; 38ARTSpeedOff	ds.W 1	; 3aARTCoLInfo	ds.L 1	; 3C	EndR	; This record is how sectors are stored in the MAPxxxx fileSectRecord	Record 0Terrain	ds.B 100	; array 10x10 of bytes. each byte represents a pallet numberMonLevel	ds.B 2	; level of most common monster in this sectorMonType	ds.B 2	; monster type for this sector 0=randomNumMons	ds.B 2	; number of monster for this sector 0=no monstersLastExit	ds.B 4	; game time when sped last left this sectorDelay	ds.B 4	; tocks before sector regeneratesDestN	ds.B 2	; dest sector when exiting 0= noexit, high byte new map #DestS	ds.B 2	; same as DestN only southDestW	ds.B 2	;   "   "   "     "  westDestE	ds.B 2	;   "   "   "     "  eastDestX	ds.B 2	;   "   "   "     "  going thru the special exit (if exists)Type	ds.B 2	; special sector type.AltData	ds.B 128	; special sector data do not useColor	ds.B 2	; color table to use with this sector	EndR	GlobalsTemplate	Record 0MenuHeight	ds.W 1	; number of pixels above the sector displayWHeight	ds.W 1	; height of the sector displayMHeight	ds.W 1	; Menuheight+wHeightGlobalAZP	DS.W 2	; address of the real direct page (in case we forget)oldIntVector	ds.L 1	; saved by start game stuff and restored at the finishMainSwitch	ds.W 2	; data used by startup selector high bit set means no selection screenMyBackPtr	DS.L 1	; pointer to Background storage areaMyBackHandle	DS.L 1	; handle of background storage areaSavedScrnTab	DS.L 1	; pointer to scan line table from _GetAddr quickdraw functionPalletHandle	ds.B 4	; handle to the current maps pallet array InvPalHandle	ds.B 4	; handle to flipped pallet arrayMapHandle	ds.B 4	; handle to MAPxxxx file dataMonsHandle	ds.B 4	; handle to MAPxxxx.MON file dataDebugPtr	ds.B 4	; used by debugger????DebugFlg	ds.B 2	; used by debugger????CHARTBLHANDLE	ds.B 4	; handle to the characeter table from monsBMap fileTempData	ds.B 2	; temp used ??????????BugFlag	ds.B 2	; used allow/disallow animationMonsDataBegin	ds.B 2	; !!!!!!!WhichShot	ds.B 2	; !!!!!!!;;   Special Sector data used by mainline game code for calling special sectors;SpecX	ds.B 2	; special square x/y locationSpecY	ds.B 2SpecRoutine	ds.B 4	; address of the routine to callSpecFlag	ds.B 2	; flag to indicate that a special sector was entered;cursorFlag	DS.W 1	; NOT USED REMOVE ME????????????ScrollDir	DS.W 1	; direction for special scrolling effect;; Sped global info; Any data that appears between SpedInfoLoc and SpedInfoSize will be saved in the sped; innfo file when the game wants to save that file.SpedInfoLoc	equ *SpedInfo	ds.W 1	; start of SpedInfoDatatheSector	DS.W 1	; current sector sped is inSpedCurMap	ds.B 2	; the current map sped is inSpedDir	ds.B 2	; the direction sped is movingSpedSpd	ds.B 2	; speed table index for spedSpedSpeedMod	ds.W 1	; speed adjustment for SpedSpedMoveMeth	ds.W 1	; Sped's current movement method.SpedLastMoveMeth	ds.W 1	;  Sped's previous movement method (used to see if we		;   we need to change Sped's bitmap)SpedX	ds.B 2	; speds current x square???????SpedY	ds.B 2	; speds current y square ?????SpedLevel	ds.B 4	; experience level of spedSpedHitPt	ds.B 2	; number of hit points sped currently hasAvailWeapons	ds.W 1	; bit flags for speds weaponsSpedCurWeapon	ds.W 1	; current Weapon Sped is usingSpedProtect	ds.W 1	; sped invulnerable counter (TestCollide)SpedHPMax	ds.B 2	; maximum hit points for spedWandPts	ds.W 1	; number of wand pts sped hasTempAnimState	ds.W 1	; used by the animation routinesSpedFlags	ds.W 1	; Flags that we can use as needed, here is the list:		;    Bit 0 = Sped's Speed Mod under external control		;              (Not just hit points);; The following data area is for the use of the BSpell routines;CurBSpell	ds.W 1	; number of the current BSpellBSpellFlags	ds.L 1	; flags showing which bspells sped has.;;;; Info used to start sped off in the right place ...LastSpedDir	ds.W 1	; direction sped was going when the game stoppedLastSpedX	ds.W 1	; pixel x when game stoppedLastSpedY	ds.W 1	; pixel Y when game stoppedMileStones	ds.B 128	; Used to track what Sped has accomplishedSpedInfoSize	equ *-SpedInfoLoc	; SizeOf SpedInfo Data block;;; Sector Monster's information;CurMonType	ds.B 2	; monster type for this sectorCurMoveMeth	ds.B 2	; monsters movement methodCurMonsShot	ds.B 2	; monster shot typeNumMons	ds.B 2	; used in moveaccountingMLvl	ds.B 2	; used in moveaccountingMType	ds.B 2	; used in moveaccountingMoveMeth	ds.B 2	; used in moveaccountingTempValue	ds.B 2	; used in moveaccounting for temp storage		; also used in testcollide for temp workCurMonRec	ds.W 1	; used by routines to store an offset to one		;  of the monsters MonsExtra record		;QuitFlag	ds.W 1	; set $FFFF when you want to quit gameQuitParms	DS.L 1	; used by _quit so go back to finder	DS.W 1	DS.W 1WindPointer	ds.L 1	; my window pointer. NOT USED ?????????Trigger	ds.W 1	; animation trigger used by main loop to know when to drawGameTime	ds.L 1	; MasterGameclock, updated by triggertask right now...TockTasks	ds TockTask	; array of tock task pointers used by the game...	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	ds TockTask	EventRecord		; used by main loop to communicate with spedcmndEventWhat	ds.B 2EventMessage	ds.B 4EventWhen	ds.B 4EventWhere	ds.B 4EventModifiers	ds.B 2TaskData	ds.B 4TaskMask	DS.L 1tRect	ds.B 8	; ????????????????????????????????MyRect	ds.B 8	; ????????????????????????????????SoundFlag	ds.W 1	; Global sound flag, low word- foregroundBKSoundFlag	ds.W 1	; high word, background volumeMyID	ds.W 1	; memory manager ID of this appMyZP	ds.W 1	; My zero page storagetempZP	ds.W 1	; used to store direct page temporarily ???????????????????LPCount	ds.B 2	; temp variable used by jim somehow ???????????hSize	ds.B 4	; ?????????????????????????????????TempMPO	ds.B 6	; Used by MakePalOffset as temp storageTempRect	ds.B 8	; ?????????????????????????????????tempInt	ds.B 2	; ?????????????????????????????????ColorHandle	ds.B 4	; handle of our color table??????????tempCount	ds.B 2	; ?????????????????????????????????tempVert	ds.B 2	; ?????????????????????????????????AvailDirs	ds.b 2	; directions sped/mons can move ?????????????????DestSqType	ds.b 2	; used as destination square type in move accountingDestSqType2	ds.b 2	;  used for X2's destination square type in move accountingTempCnt	ds.B 2	; ?????????????????????????????????StartX	ds.B 2	; where sped will start on new sector ?????????StartY	ds.B 2	; ??????????????????????????????????SqX	ds.B 2	; used by move accounting ?????????????	SqY	ds.B 2	; used by move accounting ?????????????MoveType	ds.B 2	; ?>????????????????????????????????StartDir	ds.B 2	; Starting direction for sped???????PossDirs	ds.B 2	; possible dirs for sped to move ?????????BopFlag	ds.B 2	; are we currently bopping???????????BoxArray	ds.B 130	; array to stuff the boxes in for test collideAltBoxArray	SpecBox	ds.B 16	; alternate objects or special sector doorBopBox	ds.B 16	; collision box for the bopperAltBoxPtr	ds.B 16	; routine ptrs for alt objects ??????????????CurRects	ds Rect	; Containers for current collision rectangles for each char	ds.b 128	; room for 17 rectanglesNextRects	ds Rect	ds.B 128	; container for future collision rectangles.; these next vars are used by test collide when testing collision rectangles; no one else should touch themBv1	ds.B 2	Bh1	ds.B 2Bv2	ds.B 2Bh2	ds.B 2Cv1	ds.B 2Ch1	ds.B 2Cv2	ds.B 2Ch2	ds.B 2;HpDispValue	ds.B 2	; to be used by ShowExpHP ????????MonsHPArray	ds.B 16	; hit points for all the monstersMonsMaxHP	ds.B 2	; maximum hits for curmonsMCTemp	ds.W 1	; ????????????????????????????tempLocInfo	ds LocInfo 	; locinfo record used when calling pptoport everywhereMonsExtra	ds MonsRecord	; storage for extra mons dataMonsExtra1	ds MonsRecord	; see monster record template aboveMonsExtra2	ds MonsRecordMonsExtra3	ds MonsRecordMonsExtra4	ds MonsRecordMonsExtra5	ds MonsRecordMonsExtra6	ds MonsRecordMonsExtra7	ds MonsRecordCurMonsOff	ds.B 2	; Offset to current MonsRecMaphandleTable	ds MapMgrRecord	ds.B 31*16	; the rest of the table!	;; Area for temp storage for BSpells;; Kill rects indicator boxes.; NOTE: these rects do not correspond to any real monster numbers, they are just some dirty;       rectangles.KillState	ds.W 1	; indicates which rects are in use..KillRects	ds KillRectRecord	; rectangles that indicate which area's to erase	ds.W 4*16	; remaining kill rects..; NOTE: This data MUST be at the end of the globals record at all times!; Game.Setup data here. All this data will be contained in the file game.setupGameSetupBlockHisKeyTable	ds.B 64	; area for storage of custom key table...SndPrefix	ds.B 128	; area to hold prefix for sound filesMapPrefix	ds.B 128	; area to hold prefix for map filesOtherData	ds.B 64	; spare file spaceSetupLength	equ *-HisKeyTable	; Size of Game.setup file;;; ANIM Toolset Data area follows:StartMode	ds.L 1AppMemID	ds.W 1AnimDPage	ds.W 1SceneMode	ds.W 1MasterSCB	ds.W 1;; Script StorageAreaScriptPtrs	ds.L 16	; room for all the scripts that are possiblescItemData	equ *	ds.B 16sciNextItem	equ scItemData+2	; For GOTOCMDsciDirection	equ scItemData+2	; For MOVEREL & MOVEABSsciItterations	equ sciDirection+2sciSpeed	equ sciItterations+2sciNextY	equ sciSpeed+2sciNextX	equ sciNextY+2sciExceptionNum	equ scItemData+2	; For SETEXCEPTIONsciExceptionLine	equ sciExceptionNum+2sciRtnAddress	equ scItemData+2	; for CALLBACKsciParameter2	equ sciRtnAddress+4	; Script header dataCurrentScriptLine	equ 0ScriptCFlags	equ CurrentScriptLine+2StageException	equ ScriptCFlags+2	; 4CharException	equ StageException+2 ;6ForeException	equ CharException+2	; 8OffStageExcept	equ ForeException+2	; 10ScriptVar1	equ OffstageExcept+2 ;12ScriptVar2	equ ScriptVar1+2	; 14;; Script Vareable area is here!; Address Table to be copied to the application data area..;; Toolset call temporary areaCTempLong	ds.L 1cTempWord	ds.W 1CTemparray	ds.L 16;	EndRConstTemplate	Record $0theMessage	ds.B 14	; our startup message and also special debug area "you found me"TitleString	DS.B 17	; title of our gameAutString	DS.B 35	; jim and steve's nameMethMasks	ds.b 3	; movement method masksDirMasks	ds.b 9	; directional masks for move accountingCascade	ds.W 16	; the 16 single bit positions waiting to be indexedWandShotCost	ds.W 16	; price of each wand shotWandShotDam	ds.W 16	; amount of damage each wand inflicts	EndRExtraDataTemplate	Record $0MyBackSaveArea	ds.B $8000MyBackGrafPort	ds.B $0100	; area for grafport storage ...StrikeArea	ds.B $1EF0	EndR