******************************************************************************** Animation toolkit:ToolHead** (C)  Copyright Apple Computer, Inc. 1990* All rights reserved.** by Jim Mensch** This file contains the source code to	the higher level toolbox interface for* the animation toolkit** Files:	Include 'All.Macros'	INCLUDE 'Anim.macros'	INclude 'Anim.Equates'	Include 'Anim.globals'*** External Refs:	Import Yank12	Import Yank12Err	Import Yank10	Import Yank10Err	Import Yank8	Import Yank8Err	Import Yank6	Import Yank6Err	Import Yank4	Import Yank4Err	Import Yank2	Import Yank2Err	Import Yank0	Import Yank0Err	Import Globals:GlobalsTemplate	Import ExtraData:ExtraDataTemplate	Import Constants:ConstTemplate	Import SetMyDataBank	Import AnimActive*********************************************************************************DrawBank	equ $01DrawDblBank	equ $0101AbsBank	equ $E1AbsDblBank	equ $E1E1BackBank	equ $0009	GBLA &AnimDebug&AnimDebug	SETA 0	macro	_ShadowOn	sep #$20	longa off	lda >ShadowReg	; load the shadowing register now	and #$F7	; enable super hires shadowing	sta >ShadowReg	; and save the shadowing register	rep #$20	longa on	EndM	macro	_ShadowOff	sep #$20	longa off	lda >ShadowReg	; load the shadowing register now	ora #$08	; disable super hires shadowing	sta >ShadowReg	; and save the shadowing register	rep #$20	longa on	EndMTSNumber	equ 37theVersion	equ $8100TestVersion	equ $22CallTable	Proc Export	Import AnimBootInit	Import AnimAppInit	Import AnimTerminate	Import AnimVersion	Import AnimStatus	Import StartChar	Import StartScene	Import StopScene	Import StartFrameTimer	Import StopFrameTimer	Import SetBackGndPort	Import RefreshBackCall	Import StartCharCall	Import MoveCharCall	Import AnimIdleDebug	Import GetCharRecPtr	Import KillCharCall	Import LoadActor	Import RunAnimScripts	Import SetCharScript	Import FillAddressTbl	Import CreateReblitCode	Import StartTockTask	Import FireTockTask		DC.L (TheEnd-CallTable)/4 ; num calls +	1	DC.L AnimBootInit-1	; 1	DC.L AnimAppInit-1	; 2	DC.L AnimTerminate-1 ; 3	DC.L AnimVersion-1	; 4	DC.L NotSupported-1	; 5  reset function	DC.L AnimStatus-1	; 6  QDstatus	DC.L CleanExit-1	; 7  spare	DC.L AnimIdleDebug-1 ; 8  spare	DC.L StartScene-1	; 9 StartScene	dc.L StopScene-1	dc.L StartFrameTimer-1	dc.L StopFrameTimer-1	dc.L SetBackGndPort-1	dc.L RefreshBackCall-1	dc.L StartCharCall-1	dc.L MoveCharCall-1	dc.L GetCharRecPtr-1	dc.L KillCharCall-1	dc.L LoadActor-1	dc.L SetCharScript-1	dc.L RunAnimScripts-1	dc.L FillAddressTbl-1	dc.L CreateReblitCode-1	dc.L StartTockTask-1	dc.L FireTockTask-1	TheEnd		;CleanExit	rtlNotSupported	sec	ldx #NotSupportedCall	rtl		Export KillCharGlue	Export StartCharGlue	Export MoveCHarGlue	Export LoadCharGlueKillCharGlue	tdc	jsl KillCharCall	rtlStartCharGlue	tdc	jsl StartCharCall	rtlMoveCharGlue	tdc	jsl MoveCharCall	rtlLoadCharGlue	tdc	jsl LoadActor	rtl	EndP		EJECT********************************************************************************AnimBootInit	PROC Export** Description:	This routine is called at tool load time. called once only*** Inputs:	None** Outputs:	None** External Refs:	Export CleanExit** Entry Points:********************************************************************************CleanExit	lda #0	clc	rtl	EndP	EJECT********************************************************************************AnimAppInit	PROC Export** Description:	This routine will be called each time the application wants to*	start up the animation tool. It takes several parameters*	and starts up this fine tool*** Inputs:	MemID:Word*	DirectPage:Word*	ModeFlag:LongInt*	PatchTable:Longint** Outputs:	None** External Refs:	Import StartLib** Entry Points:********************************************************************************	With Globals	With ExtraData; The stack looks like this for this call:;theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3PatchTable	equ RTL1+3ModeFlag	equ PatchTable+4DPage	equ ModeFlag+4MemID	equ DPage+2	cmp  #0	; see if WAP already set up	beq  @StartTheTool		phb	phd	ldx  #AlreadyStarted	brl  Yank12Err@StartTheTool	phb	; save the data bank	jsl  SetMyDataBank	; set the proper animation data bank!	phd	; save the current DPage	lda  DPage,s	beq  @BadParm	tcd	; switch in our good direct page	sta  AnimDPage	sta  MYZP	lda  MemID,s	beq  @BadParm	sta  ZPMemID	sta  AppMemID	lda  ModeFlag,s	sta  StartMode	lda  ModeFlag+2,s	sta  StartMode+2	lda  PatchTable,s	sta  AppPatchArea	lda  PatchTable+2,s	sta  AppPatchArea+2	bra  @Continue@BadParm	ldx  #BadParm	brl  Yank12Err@Continue	lda  AnimDPage	pea  $0	; Not a user call	pea  TSNumber	; Put TSNum on stack	pea  $0	; High word is zero	pha	; low word is in a	_SetWAP		pea  0	; see if quickdraw is already started..	_QDStatus	pla	bne  @QDStarted	; if so, then continue..@NeedQD	ldx  #ToolNeeded	; cause we NEED qd to be started..@OOps	brl  Yank12Err@QDStarted	pha	_GetMasterSCB	; get the master SCB to see if shadow on	pla	bpl  @NeedQD	; didn't start it up right!	sta  MasterSCB; also, just in case, lets test the shadowing bit to see that its on as well	lda  >ShadowReg	and  #$0008	; mask off bit 3	bne  @NeedQD; OK, QD and shadowing are on, lets init whatever data needs it and get out!	jsl  StartLib	bcs  @OOps; Library started, finish the high level inits now!	phb	phb	pla	and #$00FF	pha	Pushword #MyBackGrafPort	_OpenPort	; make it a real grafport	lda #MyBackSaveArea	sta MyBackGrafPort+2	phb	phb	pla	and #$00FF	sta MyBackGrafPort+4 ; dummy up the port pointer so it looks right	brl  Yank12	EndP			EJECT********************************************************************************AnimTerminate	PROC** Description:	ShutDown the animation toolkit for this application*** Inputs:	None** Outputs:	None** External Refs:*	Import AnimStartCall* Entry Points:********************************************************************************	With Globals	jsr  AnimStartCall	; set up an animation call here	bcc  @DoTheShutDown	brl  Yank0Err@DoTheShutDown; Reset the WAP to indicate the animation tool shut down..	pea  $0	; Not a user call	pea  TSNumber	; Put TSNum on stack	pea  $0	; High word is zero	pea  $0	; low word is in a	_SetWAP		brl  Yank0	EndP		EJECT********************************************************************************AnimVersion	PROC** Description:	Returns the version number of the animation tool*	Returns real version info or test version info depending on*	whether the test flag is set..** Inputs:	None** Outputs:	our version number** External Refs:	Import LeaveMe** Entry Points:********************************************************************************rtl1	equ 1rtl2	equ rtl1+3result	equ rtl2+3	lda #theVersion	sta result,s	brl LeaveMe	EndP		EJECT********************************************************************************AnimStatus	PROC** Description:	says whether the animation system thinks its on..*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:	export LeaveMe********************************************************************************rtl1	equ 1rtl2	equ rtl1+3result	equ rtl2+3	cmp #0	; see if the wap is zero..	beq @NotStarted	lda #$FFFF@NotStarted	sta result,sLeaveMe	lda #0	clc	rtl	EndP			EJECT********************************************************************************AnimStartCall	PROC Export** Description:	Set up the stack from for proper animation toolkit use*** Inputs:	just the start of a call thats all..*** Outputs:	carry clear all ok, carry set error in <X>** External Refs:	none..** Entry Points:********************************************************************************	With Globals	ply	; save the return address here..	phb	; save data bank and dpage	phd	jsl  SetMyDataBank	; setup to use proper dpage	cmp  AnimDPage	; see that WAP is proper	bne  @BadDPage	cmp  #0	; see if tool even started	beq  @ToolNotStarted	tcd	; use this as the direct page then	phy	; restore the return address..	clc	rts@BadDPage	ldx  #ToolExplosion	sec	rts@ToolNotStarted	ldx  #ToolNotStarted	sec	rts	EndP		EJECT********************************************************************************GetCharRecPtr	PROC Export** Description:	This call will return a pointer to the desired character*	record that you passed it. *** Inputs:	CharNum:Integer** Outputs:	Longword - pointer to the given character** External Refs:	Import CharTable** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3tCharNum	equ RTL1+3theResult	equ tCharNum+2	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank2Err@StartOK		lda  tCharNum,s	and #$000F	; only 16 chars boys	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta <theResult,s	; store it in the zp pointer	lda >CharTable+2,x	; noe the high byte	sta <theResult+2,s	brl  Yank2	EndP		EJECT********************************************************************************KillCharCall	PROC Export** Description:	This call will kill the desired character so you can do*	do something else..*** Inputs:	CharNum:Integer** Outputs:	None** External Refs:	Import DoKill** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3tCharNum	equ RTL1+3theResult	equ CharNum+2	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank2Err@StartOK		lda  tCharNum,s	and  #$000F	; only 16 chars boys	pha	; save on the stack for a recall!	jsl  DoKill	brl  Yank2	EndP	EJECT********************************************************************************AnimIdleDebug	PROC** Description:	This routine will be called only to debug this stupid toolkit*	Set &AnimDebug flag to 1 to use it!*** Inputs:	None** Outputs:	None** External Refs:	With Globals	import DoAnimate	import FireTockTask** Entry Points:********************************************************************************	jsr  AnimStartCall	; set up an animation call here	bcs @oops	IF &AnimDebug=1 then	  lda >$E0C025	; get the keyboard mods register	  and #$0001	; test for the shift key....	  beq @1	  brk 00@1	  lda >BugFlag	  beq @2	  lda >Trigger	  beq @2	  jsl DoAnimate	; call to see if we	need animation@2	  jsl xFireTockTask	EndIF@oops	ldx #$2601	brl Yank0Err	xFireTickTask	jsl FireTockTask	EndP		EJECT********************************************************************************TrigrTask	Record** Description:	This is the heartbeat task that sets the trigger flag that*	is used by the main event loop to gauge when drawing*	should occur.*** Inputs:	None** Outputs:	None** External Refs:*	Import DoAnimate* Entry Points:	Longa on	LongI on********************************************************************************TrgTask	DC.L 0TrgTaskCnt	DC.W 120	Dc.W $A55A	EndrTriggerP	Proc	With TrigrTask	With Globals	Import DoAnimate	Export theInterval	php	phd	phb	REP #$30	; longa/I on; Now that the trigger task is set, lets turn on the drawing environment	jsl SetMyDataBank		lda MYZP	tcd	; and use the apps dpage...;	lda >$E0C030	; click it!	lda BugFlag	beq EL0020	lda AnimState	; get the current animation state	beq EL0020	; no animation if zero...		lda trigger	bne EL_oops	; called it and the trigger ain't reset yetEL0015	IF &AnimDebug=0 then	  jsl DoAnimate	; call to see if we	need animation	ENDIFEL0020	plb	pld		lda #1	sta >Trigger	lda >theInterval	sta >TrgTaskCnt	lda >GameTime	inc a	sta >GameTime	bne @1	lda >GameTime+2	inc a	sta >GameTime+2@1	plp	RTLEL_oops	plb	pld		lda #1	sta >TrgTaskCnt	plp	RTLtheInterval	ds.W 1	endP		EJECT********************************************************************************StartFrameTimer	PROC** Description:	This routine starts the interupt based frame timer going.*	the parameter it takes is the frame interval between interupts*** Inputs:	FrameInterval:Word** Outputs:	None** External Refs:	Import theInterval	With  TrigrTask** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3FrInterval	equ RTL1+3	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank2Err@StartOK	lda  FrInterval,s	sta  >theInterval	; now that all the data has been inited that needs it; start the trigger heartbeat task running 	PushLong #TrgTask	_SetHeartBeat			brl  Yank2	EndP	EJECT********************************************************************************StopFrameTimer	PROC** Description:	This routine cancels the frame timer*** Inputs:	None** Outputs:	None** External Refs:	With TrigrTask** Entry Points:********************************************************************************	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank0Err@StartOK	; now that all the data has been inited that needs it; start the trigger heartbeat task running 	PushLong #TrgTask	_DelHeartBeat			brl  Yank0	EndP	EJECT********************************************************************************SetBackGndPort	PROC** Description:	Sets the grafport to the background grafport so we can draw*	into the background easier.*** Inputs:	None** Outputs:	None** External Refs:	With Globals	With ExtraData** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3theResult	equ RTL1+3	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank0Err@StartOK	PushLong #MyBackGrafPort	_SetPort	; and do what is expected	brl Yank0	EndP	EJECT********************************************************************************StartScene	PROC** Description:	Called to begin an animation scene. This sets up the stage and*	and background for the scene*** Inputs:	RectPtr:Long Points to the stage we are going to use*	Mode:Integer;** Outputs:	None** External Refs:	With Globals	With ExtraData** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3passMode	equ RTL1+3passRect	equ passMode+2	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank6Err@StartOK	lda  PassMode,s	sta  SceneMode	lda  passRect,s	sta  deref	lda  passRect+2,s	sta  deref+2		lda  [deref]	sta  StageRectTop	ldy  #2	lda  [deref],y	sta  StageRectLeft	iny	iny	lda  [deref],y	sta  StageRectBottom	iny	iny	lda  [deref],y	sta  StageRectRight		PushLong #0	PushWord #1	_GetAddress	pla	sta ScreenTab	sta SavedScrnTab	pla	sta ScreenTab+2	sta SavedScrnTab+2	lda [ScreenTab]	sta MyPointer	lda #AbsBank	sta MyPointer+2	lda #MyBackSaveArea	; set up the back pointer	sta MyBackPtr	lda #MyBackSaveArea>>16	sta MyBackPtr+2		lda #$FFFF	sta BugFlag	; allow animation to occur		stz AnimState	; no one is moving!	pushLong MyPointer	PushLong MyBackPtr	; Now push the ptr to save bkgd	PushLong #$7D00	; length of the block	_BlockMove	; Now move the block	_shadowOff	lda #$2000	; now copy the Background into bank 1 screen memory	sta MyPointer	lda #DrawBank	; 	sta MyPointer+2		PushLong MyBackPtr	PushLong MyPointer	PushLong #$7D00	_BlockMove		_shadowOn		lda #$FFFF	; turn on animation	again!	sta AnimActive	brl Yank6	ENDP	EJECT********************************************************************************StopScene	PROC** Description:	This routine is called prior to a scene ending. It cleans up all*	the animation stuff.*** Inputs:	None** Outputs:	None** External Refs:	With Globals** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3passMode	equ RTL1+3passRect	equ passMode+2	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank0Err@StartOK	stz AnimActive	brl Yank0	EndP		EJECT********************************************************************************RefreshBackCall	PROC** Description:	This routine simply calls refresh back routine..*** Inputs:	None** Outputs:	None** External Refs:	With Globals	Import RefreshBack** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3passMode	equ RTL1+3passRect	equ passMode+2	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank0Err@StartOK	jsl  RefreshBack	brl Yank0	EndP		EJECT********************************************************************************SetCharScript	PROC** Description:	This routine simply calls refresh back routine..*** Inputs:	theScript:Pointer*	CharNum:Word** Outputs:	None** External Refs:	With Globals** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3tCharNum	equ RTL1+3theScriptPtr	equ tCharNum+2	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank6Err@StartOK	lda tCharNum,s	;	and #$000F	; clip it to the proper range	asl a	asl a	; multiply it by 4	tax	; offset into our table	lda theScriptPtr,s	sta ScriptPtrs,x	sta Deref	lda theScriptPtr+2,s	sta ScriptPtrs+2,x	; and copy the pointer over.	sta deref+2;; Now reset our global script area	ldy #14	; we get the first 16 bytes..	lda #1	sta [deref]	lda #0@Loop	sta [deref],y	dey	dey	bne @Loop	brl Yank6	EndP		EJECT********************************************************************************RunAnimScripts	PROC** Description:	This routine will run the list of scripts to see if any *	script needs to be run, and if so, it will handle the next item*	in that script*** Inputs:	none** Outputs:	None** External Refs:	With Globals	Import CharTable** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3tCharNum	equ RTL1+3theScriptPtr	equ tCharNum+2LpassChar	equ $80CurAnimRec	equ CallTemps	; pointer to the currently used animation recordDETempData	equ $9C	; NOTE trashed in blitters/erasersDETemp	equ $9A	; NOTE TRASHED IN BLITTERS	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank0Err@StartOK	lda AnimState	; see if anything is moving..	sta <DETempData	beq @AllDone	; guess not..	ldx #0	; preload <X>@Loop		lsr <DETempData	bcc @NotActive; test some more!	lda >CharTable,x	; copy the character record pointer	sta CurAnimRec	lda >CharTable+2,x	sta CurAnimRec+2		lda |ScriptPtrs,x	; copy the script pointer..	sta deref	lda |ScriptPtrs+2,x	sta deref+2	ora deref	beq @NotActive1	; script pointer=NIL no more worry		ldy #cColFlags	; see if we collided with anything...	lda [<CurAnimRec],y	beq @noException	jmp @Exception	;@noException	ldy #CIterOff	lda [<CurAnimRec],y	; see if we need to do the next thing..	cmp #1	; at fire time?	bne @NotActive1	; no need to get and try something..@RunNextItem	phx	jsr @FireScriptItem	plx@NotActive1	lda #-1	; be sure we are non-zero@NotActive	beq @AllDone	inx	inx	inx	inx	; bump <X> next ptr	bra @Loop@AllDone	brl Yank0; If we get here then some sort of collision occured that is a standard exception; The exception type is in <A>@Exception	ldy #ScriptcFlags	and [deref],y	beq @noException	; no exception set for this script...	ldy #ScriptVar1	sta [deref],y; currently the only exception supported if the Offscreen and stage exceptions	bmi @Offscreen	; high bit set = offscreen	and #$000F	; low 4 bits means stage exception..	beq @NoException	; not an exception that I recognize..; here we fire the Stage exception command..	ldy #StageException@ExceptCont	lda [deref],y@BackToOurShoe	beq @noException	; ooops, bad value better forget this..	sta [deref]	; else its a good exception	bra @RunNextItem@Offscreen	ldy #OffStageExcept	bra @ExceptCont;; Its time for a word about the scripts themselves. The first word in the script is used; to store the item number of the next script item to be fired.; the other words are script exception labels. If a script exception occurs then the; script exception label is run instead of the next script item..; here are the equates for the first script item...; CurrentScriptLine	equ 0; ScriptCFlags	equ CurrentScriptLine+2; StageException	equ ScriptCFlags+2	; 4; CharException	equ StageException+2 ;6; ForeException	equ CharException+2	; 8; OffStageExcept	equ ForException+2	; 10; Var1	equ OffstageExcept+2 ;12; Var2	equ Var1+2	; 14;@FireScriptItem;; At this point it has been determined that it is an apropriate time to do the next; instruction in the script (if a script exists. So with the <X> register containing; the char number *4 we set about to fire the very next script item..	txa	lsr a	lsr a	; divide by 4	sta <LPassChar	; save this as the character to use; the following alternate entry is taken on jumpsFireAgain	lda [deref]	; get the next script item	tay	; save it for a second	inc a	; bump to the next item for now	sta [deref]	; and stow it..	tya	; get the current number back	asl a	; multiply it by 16	asl a	asl a	asl a	tay	; its now the proper offset to get us to our script	lda [deref],y	; item.	sta scItemData	iny	iny	lda [deref],y	sta scItemData+2	iny	iny	lda [deref],y	sta scItemData+4	iny	iny	lda [deref],y	sta scItemData+6	iny	iny	lda [deref],y	sta scItemData+8	iny	iny	lda [deref],y	sta scItemData+10	iny	iny	lda [deref],y	sta scItemData+12	iny	iny	lda [deref],y	sta scItemData+14	lda scItemData		asl a	tax	jsr (cmdTbl,x)	; dispatch this little sucker	rts	; and return we are done..cmdTbl	dc.W DoScriptEnd	dc.W DoGotoItem	; 1	dc.W DoMoveRel	; 2	dc.W DoMoveAbs	; 3	dc.W DoSetException	; 4	dc.W DoCallBack	; 5	;	dc.W DoSetVariable;	dc.W DoAddVariable;	dc.W DoSubVariable;	dc.W DoIfVariable;	dc.W DoKillChar;DoCallBack; This command calls the indicated routine with a JSL. On return if the carry flag; is set the next instruction is executed, if it is clear then the call simply ends	pei DETempData	; we must save this value..	lda sciParameter2+2	; pass the optional parameter data	pha	lda sciParameter2	pha	pei CurAnimRec+2	; pass the actor record pointer to the caller	pei CurAnimRec	; for use with the 	pei LPassChar	; and pass the character number		phk	; first push our return address on the stack..	pea @CalledBack-1	; so the called routine can get hone..	lda sciRtnAddress+1	pha	; now push the address of the calling routine	php	; an extra byte for good measure	lda sciRtnAddress	dec a	; remember that RTL adds one	sta 1,s	; and save the low word on the stack	rtl	; call the indicated routine@CalledBack	pla	; yank off the passed data that we put on the stack	sta LPassChar	; restore the routine data	pla	sta CurAnimRec	pla	sta CurAnimRec+2	pla	; discard this crap...	pla	pla	sta DETempData	; and yes, even this crap..	bcs NextInstruction	; carry set means we want to execute another instruction	rts	; else simply end..;DoSetException; This command sets up the script for exception processing by setting the proper; exception flags at the head and the exception vectors.	ldy sciExceptionNum	lda sciExceptionLine	sta [deref],y	tyx	ldy #ScriptCFlags	lda [deref],y	ora >ExceptionMasks,x	sta [deref],yNextInstruction	plx	brl FireAgainExceptionMasks	dc.W 0	; 0 invalid exception number	dc.W 0	; 2 invalid exception number	dc.W $000F	; 4 Stage exception masks	dc.W $00F0	; 6 Character exception masks	dc.W $0F00	; 8 Forground exception masks	dc.W $F000	; 10 Offstage exception masks	;DoScriptEnd; we get here the script is over, zero out its entry..	lda <LPassChar	asl a	asl a	tax	stz |ScriptPtrs,x	stz |ScriptPtrs+2,x	lda <LPassChar	; now kill this character	pha	Jsl KillCharGlue	; kill the damned thing	rtsDoGotoItem; Go to a script item numbered blah..	lda scItemData+2	sta [deref]	tay	plx	; destroy <X> and zap return address1	brl FireAgainDoMoveRel; execute the next item in the movement script here	lda LPassChar	; get the offset to	the char record	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta theChar	; store it in the zp pointer	lda >CharTable+2,x	; now the high byte	sta theChar+2;	ldy #CXPosOff	lda [theChar],y	sta scItemData+10	ldy #CYPosOff	lda [theChar],y	sta scItemData+8; we now know where we are going..; execute the proper commands..DoMoveAbs	PushWord LPassChar	jsl KillCharGlue		PushWord scItemData+8	PushWord scItemData+10	pea $8000	PushWord scItemData+2	PushWord LPassChar	jsl StartCharGlue		PushWord scItemData+4	pea $8000	pushword scItemData+6	PushWord LPassChar	jsl MoveCharGlue	rts	EndP		EJECT********************************************************************************LoadActor	PROC Export** Description:	This routine is called when you want to specify an actor to be*	used for a particular bitmapped character. It allows you to*	add any actor you want into the animation system*** Inputs:	ActorPtr:Pointer*	CharNum:Word** Outputs:	None** External Refs:	With Globals	Import LoadSpecActor** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3tCharNum	equ RTL1+3ActorPtr	equ tCharNum+2	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank6Err@StartOK	lda ActorPtr+2,s	pha	lda ActorPtr+2,s	pha	lda tCharNum+4,s	and #$000F	pha	jsl LoadSpecActor	brl Yank6	EndP		EJECT********************************************************************************FillAddressTbl	PROC Export** Description:	This routine will copy the local address table to the applications*	address table.*** Inputs:	TablePtr:Pointer** Outputs:	None** External Refs:	With Globals** Entry Points:********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3TablePtr	equ RTL1+3	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK	brl  Yank4Err@StartOK	lda TablePtr+2,s	sta deref+2	lda TablePtr,s	sta deref	ldy #LATableSize-2@Loop	tyx	lda >LocalAddrTbl,x	sta [deref],y	dey	dey	bpl @Loop; the table is transfered	brl Yank4LocalAddrTbl	dc.L Trigger	; address of the trigger for animation	dc.L GameTime	dc.L TockTasksLATableSize	equ *-LocalAddrTbl		EndP	EJECT********************************************************************************CreateReBlitCode	PROC Export** Description:	This routine will create the object code required to reblit the*	given rectangle. If a handle ** Inputs:	RectPtr:Pointer;*	GenerationFlags:Word;** Outputs:	TheCode:Handle;** External Refs:	With Globals** Entry Points:********************************************************************************* Flag Values:SourceCode	equ $8000	; generate source code instead of objectFourceAbsolute	equ $0001	; force the generation of absolute rect reblitFourceAbsIndex	equ $0002	; force generation of |$2000,x reblitFourcePEI	equ $0003	; fource use of pei codeuseBestFit	equ $0000	; create code using best fit reblitReblitWithMask	equ $0100	; use masking to perform the reblit********************************************************************************* CTempArray offsetsHeight	equ 0RowWords	equ Height+2LineOffset	equ RowWords+2RowBytes	equ LineOffset+2CurAddr	equ RowBytes+2********************************************************************************theDPage	equ 1theDBank	equ theDPage+2RTL2	equ theDBank+1RTL1	equ RTL2+3GenFlags	equ RTL1+3RectPtr	equ GenFlags+2theCode	equ RectPtr+4	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK@ErrEnd	brl  Yank6Err@StartOK	tsc	tcd; Calc best fit here if need  be...; Best fit or force fit calculated already, time to create the code asked for...	lda  GenFlags	and  #$0003	asl  a	tax	jsr  (GenTbl,x)	bcs  @ErrEnd	lda  cTempLong	sta  theCode	lda  cTempLong+2	sta  theCode+2	brl  Yank6GenTbl	dc.W MakeAbs	dc.W MakeAbs	dc.W MakeAbs	dc.W MakeAbs;; Absolute Rect reblitting code created hereMakeAbs; The code created should look something like this:; 	phb;	pea  $0101;	plb;	plb;	lda  |$2000;	sta  |$2000;	plb;	RTL;; First create the handle that we will need to complete this operation	lda  #8	; assume object code (source code stuff resizes)	jsr  MyNewHandle	bcc  @1	rts	; error alredy in <X>@1	sta  cTempLong	; save the handle for later	sta  theCode	sty  cTempLong+2	sty  theCode+2	ldy  #2	; now deref the handle so we can use it..	lda  [theCode],y	tax	lda  [theCode]	sta  theCode	stx  theCode+2	ldy  #0	; <Y> is now the code offset..; Now move the header into the the handle the header is 6 bytes long for this stuff	lda  >AbsHeader	sta  [theCode]	lda  >AbsHeader+2	ldy  #2	sta  [theCode],y	lda  >AbsHeader+4	iny	iny	sta  [theCode],y	iny	iny; Now the header is complete create all the instruction data for each screen word reblit	sty  cTempWord	; save the handle offset;; Calculate the height, width and starting word of the rectangle...	jsr  GetRectDimensions	bcsL ExitBadRect; Calculate the size that the handle needs to grow by multiplying the height by the; width in words  and then by 3 (number of bytes of instruction per; screen word...)	pha	pha	lda  cTempArray+Height	pha	lda  cTempArray+RowWords	pha	_Multiply	pla	plx	cpx  #0	bneL ExitBadRect	; if <X> is <>0 then the multiply turned up a rect too big; now to multiply the number of byte by 3..	pha	asl  a	adc  1,s	plx	; we now know how much bigger this thing needs to be	bcsl ExitBadRect	; ooops	adc  #8	; size of the header	bcsl ExitBadRect	; again, can't get too big!		pea  0000	pha	; new size for the handle...	lda  cTempLong+2	sta  theCode+2	; save for dereffing later	pha	lda  CTempLong	sta  theCode	pha	_SetHandleSize	bcsl ExitBadRect		ldy  #2	; now deref the handle so we can use it..	lda  [theCode],y	tax	lda  [theCode]	sta  theCode	stx  theCode+2;; The handle is now big enough, fill it with code and get out...	ldy  cTempWord	; reload the current offset@StartLine	lda  cTempArray+LineOffset	sta  cTempArray+CurAddr	ldx  #0	; number of words done..@NextInst	lda  #$AD	; opcode for LDA |$xxxx	sta  [theCode],y	iny	lda  cTempArray+LineOffset	sta  [theCode],y	iny	iny	lda  #$8D	; opcode for STA |$xxxx	sta  [theCode],y	iny	lda  cTempArray+LineOffset	sta  [theCode],y	iny	iny	inc  cTempArray+LineOffset	inc  cTempArray+LineOffset	inx	cpx  cTempArray+RowWords	blt  @NextInst	lda  cTempArray+LineOffset	clc	adc  #$00A0	sta  cTempArray+LineOffset	dec  cTempArray+Height	bne  @StartLine;; OK, now the handle is full we can simply return the handle and exit!	lda  >ABSFooter	sta  [theCode],y	clc	; report no error	rts	; and leave!ExitBadRect	sec	rts	;; MyNewHandle will return a valid handle in <Y><A> any error returned in <X>MyNewHandle	ldx  #0	phx	phx	; result space	phx	; high word of size..	pha	; low word of block size to create	lda  AppMemID	pha	pea  $0010	; attrNoCross	phx	phx	; location (of no consequence)	_NewHandle	tax	pla	ply	rts;GetRectDimensions; This routine will measure the rectangle and return its proper dimensions in the; cTempArray variables for this routine..	ldy  #4	lda  [RectPtr],y	; start by getting the bottom	sec	sbc  [RectPtr]	sta  cTempArray+Height	bmi  badRect	; negative or zero means the rectangle is poo	beq  badRect;	ldy  #6	lda  [RectPtr],y	sec	ldy  #2	sbc  [RectPtr],y	bmi  badRect	; negative or zero means the rectangle is poo	beq  badRect; adjust the width to measure words instead of pixels..; 320 mode, divide by 4; 640 mode, divide by 8	lsr  a	lsr  a	bit  MasterSCB+1	bpl  @GotWords	lsr  a@GotWords	sta  cTempArray+RowWords	asl  a	sta  cTempArray+RowBytes;; Now to calculate the current line offset into the screen (first scan line of the rect..); Start by calculating the horizontal component..; ASSUMES <Y> is already set to #2; divide by 2 for 320 mode and 4 for 640 mode (need byte address, not word address)	lda  [RectPtr],y	; load in left side...	lsr  a	bit  MasterSCB+1	bpl  @GotWords2	lsr  a@GotWords2	clc	adc  #$2000	; add offset to screen base..	sta  cTempArray+LineOffset;; Now calculate the vertical offset	lda  [RectPtr]	; get the "top"	asl  a	; multiply by $A0 (%1010 0000)	asl  a	asl  a	asl  a	asl  a	pha	asl  a	asl  a	clc	adc  1,s	adc  cTempArray+LineOffset	sta  cTempArray+LineOffset	plx	; recover math poop...; note carry should be clear here for good values, so...	rts	; everything is now calculated..BadRect	sec	; set carry to indicate error	rts	ABSHEADER 	phb	pea  $0101	plb	plbABSFOOTER		plb	RTL	EndP	EJECT********************************************************************************StartTockTask	PROC** Description:	This routine installs the passed tock task into the tock*	table. Funny as it may seem this is right from the "Speds"*	mouth!**	It installs the tock task into any free tock task slot*	that it can find...** Inputs:	theCount - what to set for count*	theID - the task ID to set*	theData - what to put in the data field *	thePtr - what to put in the pointer field*** Outputs:	Carry clear if task installed..** Errors:	$2503 - BadParm*	$2510 - TockListOverflow	* External Refs:** Entry Points:********************************************************************************	With Globals; stack data equatestheRTL	equ 1theNextRTL	equ theRTL+3theCount	equ theNextRTL+3theID	equ theCount+2theData	equ theID+2thePtr	equ theData+4;	PushLong thePtr;	PushLong theData;	PushWord theTaskNum;	PushWord theCount;	jsl SetTockTask; get the task number and set x=num*16	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK@ErrEnd	brl  Yank12Err@StartOK	ldx #0	; zero out a counter	@TockLoop		; get the counter and see if we are done	cpx #16*16	; last task in the list?	bge @NoTocksLeft	; if so then just end...	lda TockTasks,x	; get the counter	beq @FoundAnEmpty	; got an empty task...@NextTock	txa	clc	adc #16	tax	bra @TockLoop@NoTocksLeft	sec	; flag the error	ldx #TockListOverflow	bra @ErrEnd	; we be done with all this!;@FoundAnEmpty; If we get here <X> is the offset to an empty tock task to use...@TockCopyData; now copy the data...	lda theCount,s	sta TockTasks.Count,x	lda theID,s	sta TockTasks.ID,x	lda theData,s	sta TockTasks.Data,x	lda theData+2,s	sta TockTasks.Data+2,x	lda theptr,s	sta TockTasks.ptr,x	lda thePtr+2,s	sta TockTasks.ptr+2,x; Now unlink the stack frame here...@DoTheUnlink	brl Yank12	EndP	EJECT********************************************************************************FireTockTask	PROC** Description:	This routine can be called to fire any tock task that needs*	to run, the basic idea is simple, it runs the list and adjusts*	the counters, and if it needs running, it does it!**	currently the only task ID that is defined is:*	1: call back routine** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	with globalscounter	equ CallTemps	jsr  AnimStartCall	; set up an animation call here	bcc  @StartOK@ErrEnd	brl  Yank0Err@StartOK	stz counter	; zero out a counter	@TockLoop	lda counter	; get the counter and see if we are done	cmp #16	bge @TockDone	; if so then just end...	asl a	; we must multiply this by 16...	asl a	asl a	asl a	; to get the proper offset	tax	lda TockTasks,x	; get the counter	beq @NextTock	dec a	sta TockTasks,x	bne @NextTock	; if non-zero then next one...	jsr FireTock	; we got one to fire!!!@NextTock	inc counter	bra @TockLoop@TockDone	brl Yank0	; we be done with all this!;; This next routine handles a tock task by finding out what it is and running it...; it passes control to the proper routine by first pushing the task*16 on the stack; then jsring the proper routine...FireTock	phx	; save tock*16 on the stack...	lda TockTasks.ID,x	; get the task ID	cmp #1	; is it larger than the biggest task??	blt @IDOk	lda #0	; if not, call routine 0!@IDOk	asl a	; multiply it by 2...	tax	; use as an index into the table	jsr (tockTable,x)	; and dispatch the routine	rts	; and return (Note X pulled off stack...);; Called when a bad task ID is found!BadTask		pla	; remove the <X> while preserving rts value	plx	pha	rts;; This next routine is called when a callback is requested at a proper point in game time.; This can be used to callback special sectors and bspells (or anything else I guess); As a courtesy to the TockTask the offset into the tocktask array will be in <X>; in case said routine wants to be called back again..CallBackTask	pla	; recover <X> without disurbing rts info	plx	pha	jsl @CallIt	; put a fake RTL on the stack	rts@CallIt	pha	; put 3 bytes of poop on the stack to overwrite	phb	lda TockTasks.Ptr+1,x ; get the high word first	sta 2,s	lda TockTasks.Ptr,x	; be sure to decrement by 1 to account for RTL inc	dec a	; good thing we can't cross banks with this!	sta 1,s; at this point the stack has the address-1 of the routine to jump to...	rtl	; now call the routine...	TockTable	dc.W BadTask	dc.W CallBackTask	dc.W BadTask	EndP		End