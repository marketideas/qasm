******************************************************************************** IOLib.aii** (C)  Copyright Two Guys and a Cabbage Software 1988* All rights reserved.** by Jim Mensch* 1/30/89** IORoutines for game.aii** Files:	system equates**** Modification History:** Version 1.3	Mensch**      1/30/89	First time file header added**	Added subdirectory names to all file names.**      4/15/89	Mensch*	Added prefix 4/ for map folder and 5/ for sounds**	Added Load/Save Game setup routines.**	Added Set prefix routines* -------------------------------------------------------------------------* 4/16/90	Mensch* Started 5.0.3 conversion work today in this file********************************************************************************	Seg 'FileIOSeg'	Import GameDebug	PRINT NOHDR,NOGEN	PRINT PUSH,OFF	Include 'All.game.macros'	INCLUDE 'game.macros'	INclude 'Game.Equates'	Include 'Game.Globals'	PRINT POP; Data required by this routine that exists in other routines	Import Globals:GlobalsTemplate	Import Constants:ConstTemplate	Import SetMyDataBank********************************************************** LoadFile		                **               Loads in a Specified File               **		                **   Stack before Call:	                **		                **       | Result Space  |	                **       | Result Space  |	                **       | FileSet #	    |	                **       | File Type	    |	                **       | Ret Addr	    |	                **       | Ret   | <---SP	                **		                **   Stack After Call:	                **		                **       | PalletHandle  |	                **       | PalletHandle  |  <---SP	                **		                **		                **		                **   Valid File Types are:	                **		                **           $00 - Map File	                **           $01 - Pallet File	                **           $02 - Color File	                **           $03 - Monster File	                **           $04 - BitMap file	                **           $05 - Sound File	                **           $06 - SpedData File	                **		                **		                **********************************************************	Export LoadFileLoadFile	proc	With GlobalsLocalFrame	equ $06	; number of bytes of local storageTempDeRef	equ $01	; area for dereferencingSavedDPage	equ LocalFrame+1	; address of our direct pageRetAddr	equ SavedDPage+2	; return addressFileType	equ RetAddr+3	; Number of Pallet to loadPalletNum	equ FileType+2Result	equ PalletNum+2	; space for the return handle;; Set up the stack frame for our routine to use;	phd	; save the direct page	tsc	; get the stack pointer	sec	sbc #LocalFrame	; subtract the local frame size	tcd	; make it the Direct page register	tcs	; also use it as a stack pointer 	lda FileType	; Load in the selected File type	asl a	; Multiply it by 4	asl a	tax	; use it as an Index	lda >NameTab,x	sta >FileName	clc	adc #11	; WE BUMPED THE FILENAMES BY A PREFIX...	sta TempDeRef	lda >NameTab+2,x	sta >FileName+2	adc #0	sta TempDeRef+2	PushWord PalletNum	; get the pallet we	are working with	PushLong TempDeRef	; address of the number inside the string	PushWord #4	_Int2Hex	lda FileType	cmp #FTBitMap	bne LFEOpen	brl LoadBitMaps	; load a bitmap segment from diskLFEOpen	_Open OPPParms	bcc LFE010LFE010	lda >OPPRefNum	sta >RDPRefNum	sta >GEPRefNum	sta >CLPRefNum	bcc LFE020LFE020	_Get_EOF GEPParms	lda >GEPSize	sta >RDPReqCnt	lda >GEPSize+2	sta >RDPReqCnt+2;**BitMap	lda FileType;**BitMap	cmp #FTBitMap;**BitMap	beq LF0010	PushLong #0	PushLong >GEPSize		lda >MyID	sta TempDeRef	lda FileType	xba		; use it as the aux ID of	and #$0F00		; strip off excess	ora TempDeRef		; the handle we create	pha; PushWord >MyID			; this replaced by above	PushWord #%1000000000011100	PushLong #0	_NewHandle	pla	sta TempDeRef	sta Result	pla	sta TempDeRef+2	sta Result+2;**BitMap	bra LF0020LF0010;**BitMap	lda >CharTblHandle;**BitMap	sta TempDeRef;**BitMap	sta Result;**BitMap	lda >CharTblHandle+2;**BitMap	sta TempDeRef+2;**BitMap	sta Result+2LF0020	lda [TempDeRef]	sta >RDPDataBuf	ldy #2	lda [TempDeRef],y	sta >RDPDataBuf+2	_Read RDPParms	bcc LFE040LFE040	_Close CLPParms	bcc LFE050LFE050;;   UnLink the stack frame;	tsc	; get the stack pointer	clc	adc #LocalFrame	; subtract our local frame	tcs	; restore the stack	pointer	pld	; get the old direct page	sep #$20	; now get the return address	Longa Off	pla	ply	; pull 3 byte return address	plx	; pull off the 2 byte passed param	plx	phy	pha	rep #$20	LongA On	; stack frame is now adjusted	rtl; LoadBitMaps uses load seg by name to load a relocatable bitmap segment ; into memory somewhere.LoadBitMaps	Import LoadMonsBMap	jsl LoadMonsBMap	; force the segment to load	sta >CharTblHandle	sta Result	txa	sta >CharTblHandle+2	sta Result+2	brl LFE050	pha	; room for result	pha	pha	pha	pha	PushWord >MyID	PushLong >FileName	PushLong #SegName	_LoadSegName	; load the segment	bcc LBM0010	DEBUG $FFBB,#$DEAD,#0LBM0010	PullLong Result	lda Result	sta >CharTblHandle	lda Result+2	sta >CharTblHandle+2	pla	pla	pla		brl LFE050	SegName	str 'MONSTERS'MapName	str '4/MAPS/Map0000'PalletName	str '4/MAPS/Map0000.Pallet'ColorName	str '4/MAPS/Map0000.Color'MonName	str '4/MAPS/Map0000.Mon'BitMapName	str '4/MAPS/Map0000.MonBMap'SoundName	str '5/SNDS/Snd0000'NameTab	dc.L MapName,PalletName,ColorName,MonName,BitMapName,SoundNameOPPParmsOPPRefNum	dc.W 0FileName	dc.L 0	dc.L 0GEPParmsGEPRefNum	dc.W 0GEPSize	dc.L 0RDPParmsRDPRefNum	dc.W 0RDPDataBuf	dc.L 0RDPReqCnt	dc.L 0	dc.L 0CLPParmsCLPRefNum	dc.W 0	EndP		EJECT********************************************************************************	Export DoFlipDoFlip	PROC** Description:	Horizontally flips a bitmap image in place*** Inputs:	theMap:Ptr; Pointer to Bitmap data** Outputs:	flipped image** External Refs:** Entry Points:********************************************************************************	theData	equ $A0temp1	equ $A4counter	equ $A6tempPt	equ $A8temp2	equ $ACSrcPtr	equ $80	PROCDB 12,#0,#0	lda SrcPtr	sta theData	lda SrcPtr+2	sta theData+2	stz Counter	; current lineCpLine	ldy #$00	; absolute data offset	lda [theData],y	tax	ldy #$0A	lda [theData],y	ldy #$00	sta [theData],y	txa	ldy #$0a	sta [theData],y	ldy #$02	lda [theData],y	tax	ldy #$08	lda [theData],y	ldy #$02	sta [theData],y	txa	ldy #$08	sta [theData],y	ldy #$04	lda [theData],y	tax	ldy #$06	lda [theData],y	ldy #$04	sta [theData],y	txa	ldy #$06	sta [theData],y	inc Counter	lda theData	clc	adc #12	sta theData	lda Counter	cmp #16	bne CpLine	lda SrcPtr	sta theData	lda SrcPtr+2	sta theData+2	ldy #$00SwapEm	lda [theData],y	tax	and #$000F	xba	sta temp1	txa	and #$00F0	ora temp1	asl a	asl a	asl a	asl a	sta temp1	txa	and #$F000	xba	sta temp2	txa	and #$0F00	ora temp2	lsr a	lsr a	lsr a	lsr a	ora temp1	sta [theData],y	iny	iny	cpy #192	blt SwapEm	rtl	ENDP	EJECT********************************************************************************SetPrefixes	PROC Export** Description:	This routine will cause the prefixes stored in globals*	to be set for snd and map file loading.*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With Globals		_Set_Prefix MapPrefixParm	_Set_Prefix SndPrefixParm	rtlMapPrefixParm	dc.W 4	dc.L MapPrefixSndPrefixParm	dc.W 5	dc.L SndPrefix	EndP		EJECT********************************************************************************LoadGameSetup	PROC Export	procHdr 'LoadGameSetup'** Description:	This procedure will load the Game setup block from the disk file*	game.setup.*** Inputs:	None** Outputs:	Error in <A> with carry set if anything is wrong!** External Refs:	Import KeyTable	Import SaveGameSetup** Entry Points:********************************************************************************	With Globals	_Open OPPParms	bcc LFE010	brl BadLoadLFE010	lda >OPPRefNum	sta >RDPRefNum	sta >CLPRefNum		lda #GameSetupBlock	; load the low byte of SpedInfo	sta >RDPDataBuf	lda #GameSetUpBlock>>16	sta >RDPDataBuf+2	_Read RDPParms	bcc LFE040	brl BadLoadLFE040	_Close CLPParms	bcc LFE050	brl BadLoadLFE050	jsr UseData	; if we get here then copy the data up!	rtlBadLoad	; If we get a bad load of this file we must create valid data in our block and then ; create the file with a saveGameSetup call. NOTE: This is a VERY bad thing, and should only; occur once when I create the file to start with!; First, fill the whole block with zero's	ldx #SetupLength-2	; get the length of the datablock to clear@clearLoop	stz GameSetupBlock,x ; clear a word	dex	dex	bpl @ClearLoop	; if not done then do more...	; Now copy the key table from the main line program...	ldx #28	; copy 16 bytes of the key table...@MoveKeyIn	lda >KeyTable,x	; get the word from the key table...	sta HisKeyTable,x	dex	dex	bpl @MoveKeyIn; Now set up the 2 prefixes to the game disk....	_Get_Prefix Block1GPre ; fill sndprefix	_Get_Prefix Block2GPre ; fill sndprefix	; Now that I have the setup data properly created, I will now just fall into the save routine ; to create the file, making sure I closed the existing file if it was opened		lda >OPPRefNum	beq BL0010	sta >CLPRefNum	; save in the close parms ref num	_Close CLPParms	; close whatever may have been openedBL0010		brl SaveGameSetup	; UseData; This routine will copy the data that I just read from the setup file into the ; proper locations  here in the game. That will include setting the prefixes for; maps and sound...UseData	jsl SetPrefixes	; set the prefixes stored in our data area	; Now copy the key table to the main line program...	ldx #28	; copy 16 bytes of the key table...@MoveKeyout	lda HisKeyTable,x	; get the word from the data block...	sta >KeyTable,x	; save into the key table	dex	dex	bpl @MoveKeyout	rts	; and returntheFileName	str '1/Game.setup'Block1GPre	dc.W 1	dc.L SndPrefixBlock2GPre	dc.W 1	dc.L MapPrefixOPPParmsOPPRefNum	dc.W 0FileName	dc.L theFileName	dc.L 0RDPParmsRDPRefNum	dc.W 0RDPDataBuf	dc.L GameSetupBlockRDPReqCnt	dc.L SetupLength	dc.L 0CLPParmsCLPRefNum	dc.W 0	EndP		EJECT********************************************************************************SaveGameSetup	PROC Export	procHdr 'SaveGameSetup'** Description:	This procedure will save the game setup block to the disk file*	game.setup.*** Inputs:	None** Outputs:	Error in <A> with carry set if anything is wrong!** External Refs:** Entry Points:********************************************************************************	With GlobalstempChar	equ $80	Import CharTable	_Open OPPParms	; open the file	bcc LFE010	; no error continue	cmp #$46	; is it file not found error???	beq LFE005	brl BadLoadLFE005	_Create CRParms	; create the file	bcc SavegameSetup	; if create was ok, try openning again	brl BadLoad	LFE010	lda >OPPRefNum	sta >RDPRefNum	sta >CLPRefNum	lda #GameSetupBlock	; load the low byte of SpedInfo	sta >RDPDataBuf	lda #GameSetupBlock>>16	sta >RDPDataBuf+2		_Write RDPParms	; Write the data to the file!	bcc LFE040	brl BadLoadLFE040	_Close CLPParms	bcc LFE050	brl BadLoadLFE050	jsl SetPrefixes	rtl	BadLoad	pha	; save the error!	lda >OPPRefNum	beq BL0010	sta >CLPRefNum	; save in the close parms ref num	_Close CLPParms	; close whatever may have been openedBL0010	lda 1,s	; error code back into <A>	Debug $FF13,#0,#0	; show the error	pla	; get the error code	cmp #0	; set carry if need be	RTL	; and returntheFileName	str '1/Game.Setup'CRParms	dc.L theFileName	; parm block for creating shit	dc.W $C3	; standard access privaledges	dc.W $6F	; stupid file type	dc.L $CABB	; our aux type	dc.W $01	; storage type	dc.W 0	; date	dc.W 0	; and timeOPPParmsOPPRefNum	dc.W 0FileName	dc.L theFileName	dc.L 0RDPParmsRDPRefNum	dc.W 0RDPDataBuf	dc.L GameSetupBlockRDPReqCnt	dc.L SetupLength	dc.L 0CLPParmsCLPRefNum	dc.W 0	EndP			EJECT********************************************************************************	Export LoadSpedInfoLoadSpedInfo	PROC** Description:	This procedure will load the SpedInfoBlock from the disk file*	SpedInfo.*** Inputs:	None** Outputs:	Error in <A> with carry set if anything is wrong!** External Refs:** Entry Points:********************************************************************************	With Globals	_Open OPPParms	bcc LFE010	brl BadLoadLFE010	lda >OPPRefNum	sta >RDPRefNum	sta >CLPRefNum		lda #SpedInfo	; load the low byte of SpedInfo	sta >RDPDataBuf	lda #SpedInfo>>16	sta >RDPDataBuf+2	_Read RDPParms	bcc LFE040	brl BadLoadLFE040	_Close CLPParms	bcc LFE050	brl BadLoadLFE050	rtlBadLoad	pha	; save the error!	lda >OPPRefNum	beq BL0010	sta >CLPRefNum	; save in the close parms ref num	_Close CLPParms	; close whatever may have been openedBL0010	lda 1,s	; error code back into <A>	Debug $FF12,#0,#0	; show the error	pla	; get the error code	cmp #0	; set carry if need be	RTL	; and returntheFileName	str '1/SpedInfo'OPPParmsOPPRefNum	dc.W 0FileName	dc.L theFileName	dc.L 0RDPParmsRDPRefNum	dc.W 0RDPDataBuf	dc.L SpedInfoRDPReqCnt	dc.L SpedInfoSize	dc.L 0CLPParmsCLPRefNum	dc.W 0	EndP		EJECT********************************************************************************	Export SaveSpedInfoSaveSpedInfo	PROC** Description:	This procedure will save the SpedInfoBlock to the disk file*	SpedInfo.*** Inputs:	None** Outputs:	Error in <A> with carry set if anything is wrong!** External Refs:** Entry Points:********************************************************************************	With GlobalstempChar	equ $80	Import CharTable; first transfer the data needed to the Sped data areas	ldx #0	lda >CharTable,x	; get the low byte of the char pointer	sta tempChar	; store it in the zp pointer	lda >CharTable+2,x	; noe the high byte	sta tempChar+2	ldy #CDirOff	; check the direction	lda [tempChar],y	sta LastSpedDir			ldy #CYPosOff	; get offset to chars Y posistion	lda [tempChar],y	; get chars y location	sta LastSpedY	ldy #CXPosOff	lda [tempChar],y	; load in char x location	sta LastSpedX	_Open OPPParms	; open the file	bcc LFE010	; no error continue	cmp #$46	; is it file not found error???	beq LFE005	brl BadLoadLFE005	_Create CRParms	; create the file	bcc SaveSpedInfo	; if create was ok, try openning again	brl BadLoad	LFE010	lda >OPPRefNum	sta >RDPRefNum	sta >CLPRefNum	lda #SpedInfo	; load the low byte of SpedInfo	sta >RDPDataBuf	lda #SpedInfo>>16	sta >RDPDataBuf+2		_Write RDPParms	; Write the data to the file!	bcc LFE040	brl BadLoadLFE040	_Close CLPParms	bcc LFE050	brl BadLoadLFE050	rtlBadLoad	pha	; save the error!	lda >OPPRefNum	beq BL0010	sta >CLPRefNum	; save in the close parms ref num	_Close CLPParms	; close whatever may have been openedBL0010	lda 1,s	; error code back into <A>	Debug $FF13,#0,#0	; show the error	pla	; get the error code	cmp #0	; set carry if need be	RTL	; and returntheFileName	str '1/SpedInfo'CRParms	dc.L theFileName	; parm block for creating shit	dc.W $C3	; standard access privaledges	dc.W $6F	; stupid file type	dc.L $CABB	; our aux type	dc.W $01	; storage type	dc.W 0	; date	dc.W 0	; and timeOPPParmsOPPRefNum	dc.W 0FileName	dc.L theFileName	dc.L 0RDPParmsRDPRefNum	dc.W 0RDPDataBuf	dc.L SpedInfoRDPReqCnt	dc.L SpedInfoSize	dc.L 0CLPParmsCLPRefNum	dc.W 0	EndP			EJECT********************************************************************************	Export LoadMapInfoLoadMapInfo	PROC** Description:	This routine should be called with a sector number and it*	should load all the related files for that sector and make*	sure that they are set to be the current files. This should*	Include Checking the validity table at some point, and it*	Should Also update the SpedCurMap variable.**	| FileSet #	|*	| Ret Addr	|*	| Ret     | <---SP	      ** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With GlobalsRetAddr	equ 1	; return addressSetNumber	equ RetAddr+3	; Number of Pallet to loadPassSrc	equ $80LSMFtemp	equ $82	; temp storage used here!;; First, get the old map handles and make em all purgeable;	brk 00	lda SpedCurMap	; get the current map number	asl a	; multiply it by 16 to get our table offset	asl a	asl a	asl a	tax	; place the offset to our data in <X>	ldy #$0001	; get our purge level in <Y>	; push all the data for all 4 handles on the stack first! for set level and hunlock calls; first the map data	phy	; purge level	lda MaphandleTable.thisMapData+2,x	pha	; and push the handle	lda MaphandleTable.thisMapData,x	pha	; 	lda MaphandleTable.thisMapData+2,x	pha	; and push the handle	lda MaphandleTable.thisMapData,x	pha	; ; now the color table	phy	; purge level	lda MaphandleTable.thisMapColor+2,x	pha	; and push the handle	lda MaphandleTable.thisMapColor,x	pha	; 	lda MaphandleTable.thisMapColor+2,x	pha	; and push the handle	lda MaphandleTable.thisMapColor,x	pha	; ; now the Pallet		phy	; purge level	lda MaphandleTable.thisMapPallet+2,x	pha	; and push the handle	lda MaphandleTable.thisMapPallet,x	pha	; 	lda MaphandleTable.thisMapPallet+2,x	pha	; and push the handle	lda MaphandleTable.thisMapPallet,x	pha	; ; and finally the monsters	phy	; purge level	lda MaphandleTable.thisMapMons+2,x	pha	; and push the handle	lda MaphandleTable.thisMapMons,x	pha	; 	lda MaphandleTable.thisMapMons+2,x	pha	; and push the handle	lda MaphandleTable.thisMapMons,x	pha	; ; now set em all for purging	_hUnLock	; first unlock the handle	_SetPurge	; then set its purge level...	_hUnLock	; first unlock the handle	_SetPurge	; then set its purge level...	_hUnLock	; first unlock the handle	_SetPurge	; then set its purge level...	_hUnLock	; first unlock the handle	_SetPurge	; then set its purge level...	; Now that all the old map is set for purging, lets try and load the new maps!		lda SetNumber,s	; First update the global map set number	sta SpedCurMap	asl a	; multiply it by 4 to get our table offset	asl a	asl a	asl a	sta LSMFTemp	; and save it...	; first, lets try and load the map file!; of course we test first to see if it is already loaded	ldx LSMFTemp	; get the offset to our handles from the data area	lda MaphandleTable.thisMapData+2,x	tay	lda MaphandleTable.thisMapData,x		jsr testHandle	; and test this handle to see if it is valid	bcc LSMFT0010	; carry clear means it is a groovy and on the stack!		PushLong #0	; room for result	PushWord SpedCurMap	; File Number of the set	PushWord #0	; File Type 0:Load a map file	jsl LoadFileLSMFT0010; come here after load or good handle test	ldx LSMFTemp	pla	sta MapHandle	; now update the current map handle and its 	sta DeRef	; pointers	sta MaphandleTable.thisMapData,x	pla	sta MapHandle+2	sta Deref+2	sta MaphandleTable.thisMapData+2,x	lda [DeRef]	sta TheMap	ldy #2	lda [DeRef],y	sta TheMap+2;;   Now Load the Color table; first testing to see if it is already loaded...	ldx LSMFTemp	; get the offset to our handles from the data area	lda MaphandleTable.thisMapColor+2,x	tay	lda MaphandleTable.thisMapColor,x		jsr testHandle	; and test this handle to see if it is valid	bcc LSMFT0020	; carry clear means it is a groovy and on the stack!		PushLong #0	PushWord SpedCurMap	; file number	PushWord #2	; Load the Color table	jsl LoadFileLSMFT0020	ldx LSMFTemp	pla	sta >ColorHandle	sta >MaphandleTable.thisMapColor,x		pla	sta >ColorHandle+2	sta >MaphandleTable.thisMapColor+2,x		PushLong >ColorHandle ; handle of color data	pea $00E1	; move the data to the color table area	pea $9E00	PushLong #512	; move 512 bytes	_HandtoPtr; ; Next load the new Monster data; first be sure to dispose of the current monster data;	ldx LSMFTemp	; get the offset to our handles from the data area	lda MaphandleTable.thisMapMons+2,x	tay	lda MaphandleTable.thisMapMons,x		jsr testHandle	; and test this handle to see if it is valid	bcc LSMFT0030	; carry clear means it is a groovy and on the stack!		PushLong #0	PushWord SpedCurMap	; File Number 1	PushWord #3	; File Type 3	jsl LoadFileLSMFT0030	ldx LSMFTemp	pla	sta MonsHandle	sta DeRef	sta MaphandleTable.thisMapMons,x	pla	sta MonsHandle+2	sta DeRef+2	sta MaphandleTable.thisMapMons+2,x	lda [DeRef]	sta MonsPtr	ldy #2	lda [DeRef],y	sta MonsPtr+2;; Now load the Map Pallet information, and create the flipped bitmap image of the ; map.	PushLong InvPalHandle	_DisposeHandle		ldx LSMFTemp	; get the offset to our handles from the data area	lda MaphandleTable.thisMapPallet+2,x	tay	lda MaphandleTable.thisMapPallet,x		jsr testHandle	; and test this handle to see if it is valid	bcc LSMFT0040	; carry clear means it is a groovy and on the stack!		PushLong #0	; Room for result	PushWord SpedCurMap	; current pallet to	load	PushWord #1	; file type to load	jsl LoadFileLSMFT0040	ldx LSMFTemp	pla	sta PalletHandle 	; This is a handle to the data	sta MapHandleTable.thisMapPallet,x		pla	sta PalletHandle+2	; This is a handle to the data	sta MapHandleTable.thisMapPallet+2,x			lda PalletHandle	; Now save it for dereference save	sta DeRef	lda PalletHandle+2	sta DeRef+2	lda [DeRef]	sta PalletArry	ldy #2	lda [DeRef],y	sta PalletArry+2	PushLong #0	PushLong PalletHandle	_GetHandleSize	PullLong hSize	PushLong #0	PushLong hSize	PushWord MyID	PushWord #%1000000000011100	PushLong #0	_NewHandle	pla	sta DeRef	sta InvPalHandle	pla	sta DeRef+2	sta InvPalHandle+2	lda [DeRef]	sta InvPalArry	ldy #2	lda [DeRef],y	sta InvPalArry+2	PushLong PalletHandle	PushLong InvPalHandle	PushLong hSize	_HandToHand	stz LPCountLP0020	lda LPCount;	jsr MakePalOffset	asl a	; *2	sta TempMPO+4	asl a	; *4	sta TempMPO+2	asl a	; *8	asl a	; *6	asl a	; *32	asl a	; *64	sta TempMPO	; save it for a second	asl a	; *128	clc	adc TempMPO	adc TempMPO+2	adc TempMPO+4	; (a*128)+(a*64)+(a*4)=a*196	clc	adc InvPalArry	sta PassSrc	lda #0	adc InvPalArry+2	sta PassSrc+2	jsl DoFlip	inc LPCount	lda LPCount	cmp #128	blt LP0020;;   UnLink the stack frame;	Longa Off	SEP #$20	pla	; save the return address	ply		plx	; discard the data		phy	pha		REP #$20	Longa On			RTL;testHandle; this routine will check to see if the passed handle is valid, if it is it will ; unprge it and lock it, if not it will set the carry and return	cpy #0	; check to see if the high word is zero,	beq BadHandle	; if so, this isn't a good handle!	sty <deref+2	; save <y> and <A> now	sta <deref		ldy #2	; now test to see if the handle is empty...	lda [<deref],y	; by getting its high byte	ora [<deref]	; and oring it with its low byte	beq BadHandle	; get out if this is a bad handle...		Pea $0000	; lets set the purge level to no-purge again...	PushLong <deref	_SetPurge	; set the purge bits	bcs BadHandle	; if error, then forget it!		PushLong <deref	; now lock the handle down	_hLock	bcs BadHandle	; and branch if no good		ply	; get the return address	PushLong <deref	; now place it on the stack	phy	; replace the return address on the stack	clc	; clear the carry to denote this worked	rts	; and return	BadHandle	; something bad happened and the handle is not valid any longer...; or wasn't loaded...	sec	rts	EndP		End