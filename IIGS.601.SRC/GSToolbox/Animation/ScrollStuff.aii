******************************************************************************** ScrollStuff.aii** (C)  Copyright Two guys and a cabbage software 1988* All rights reserved.** by Mensch and Williamson* 12/3/88** This file contains all of the scroll routines that will enable Sped* to move from sector to sector.** Files:**** Modification History:** Version 1.0	Jim & Steve**      12/15/88    Steve & Jim*             Changed scroll West to be the faster version of the scroll.*             More efficient scroll east modification made**      12/19/88	Jim*	Fixed Scroll North bug that went one line to far.* ** -------------------------------------------------------------------------* 4/16/90	Mensch* Started 5.0.3 conversion work today in this file********************************************************************************		STRING AsIS	PRINT NOGEN,nohdr	SEG 'ScrollSeg'		PRINT PUSH,OFF	Include 'All.game.macros'	INCLUDE 'anim.macros'	INCLUDE 'anim.equates'	INCLUDE 'anim.globals'	PRINT POP; Data required by this routine that exists in other routines	Import Globals:GlobalsTemplate	Import Constants:ConstTemplate	Import SetMyDataBank	Import LoadFile	Import GameDebug	Import MyBackSaveArea	GBLA &procDebugFlag&procDebugFlag	SETA 0	theScreen	equ $012000	; address of the first scan lineScanLineSize	equ $A0	; size in bytes of a scan line 			MACRO	DOHORZLINES; this macro creates a buncha source lines!!!	LCLA &loopCnt,&nxtAddr&loopCnt	SETA 0&nxtAddr	SETA 0	WHILE &loopCnt <160 DO	  lda >$(MyBackSaveArea-$2000)+(&nxtAddr),x	  sta !&nxtAddr,y	  &nxtAddr: SETA &nxtAddr+$A0	  &loopCnt: SETA &loopCnt+1	ENDWHILE	MEND		MACRO	DOtestLINES; this macro creates a buncha source lines!!!	LCLA &loopCnt,&nxtAddr&loopCnt	SETA 0&nxtAddr	SETA 0	WHILE &loopCnt <160 DO	  lda >(MyBackSaveArea-$2000)+(&nxtAddr),x	  sta !&nxtAddr,y	  lda >(MyBackSaveArea-$2000)+(&nxtAddr)+2,x	  sta !&nxtAddr+2,y	  &nxtAddr: SETA &nxtAddr+$A0	  &loopCnt: SETA &loopCnt+1	ENDWHILE	MEND		MACRO	DoEastRazor; this macro creates a buncha source lines!!!	LCLA &nxtAddr&nxtAddr	SETA $74	WHILE &nxtAddr >0 DO	  &nxtAddr: SETA &nxtAddr-4	  lda !&nxtAddr,x	  sta !&nxtAddr+4,x	  lda !&nxtAddr+2,x	  sta !&nxtAddr+6,x	ENDWHILE	MEND		MACRO	DoWestRazor; this macro creates a buncha source lines!!!	LCLA &nxtAddr&nxtAddr	SETA $00	WHILE &nxtAddr <$74 DO	  lda !&nxtAddr+4,x	  sta !&nxtAddr,x	  lda !&nxtAddr+6,x	  sta !&nxtAddr+2,x	  &nxtAddr: SETA &nxtAddr+4	ENDWHILE	MEND;	MACRO;	DoWestRazor; this macro creates a buncha source lines!!!;	LCLA &nxtAddr;&nxtAddr	SETA $00;	WHILE &nxtAddr <$76 DO;	  lda !&nxtAddr+2,x;	  sta !&nxtAddr,x;	  &nxtAddr: SETA &nxtAddr+2;	ENDWHILE;	MEND		EJECT********************************************************************************DoVertRazor	PROC** Description:	This proc will copy the scan line pointed to by <X> to the *	scan line pointed to by <Y>. It uses the enclosed macro.*** Inputs:	Source in <X> and dest in <Y>** Outputs:	scan lines are copied** External Refs:** Entry Points:	** Macros:	MACRO	VertRazor	LCLA &nxtAddr	          ; define a counter to use&nxtAddr	SETA $00	          ; init the counter to zero	WHILE &nxtAddr <$78 DO        ; create lines from $78 to $00	  lda !&nxtAddr,x	          ; load from the source word	  sta !&nxtAddr,y	          ; save into the dest word	  &nxtAddr: SETA &nxtAddr+2   ; bump the address by two	ENDWHILE	          ; continue creating lines till done	MEND********************************************************************************	VertRazor	rts	EndP		EJECT********************************************************************************DoVertLine	PROC** Description:	This routine will copy the scan line pointed to by <X> from*	the background into the forground line at <Y>.*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:** Macros:	MACRO	VertLines	LCLA &nxtAddr		; define a var&nxtAddr	SETA 00		; init to zero	WHILE &nxtAddr<$78 DO	; start the loop	  lda >(MyBackSaveArea-$2000)+&nxtAddr,X	; load src data	  sta !&nxtAddr,Y		; save in dest	  &nxtAddr: SETA &nxtAddr+2	; bump counter by 2	ENDWHILE	MEND********************************************************************************	VertLines	rts	EndP		EJECT********************************************************************************	Export SmoothScrollNorthSmoothScrollNorth	PROC** Description:	This routine will scroll the screen south because you are*	going north*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With GlobalsCurSLine	equ $80	; number of the current lineCurLinePt	equ $82	; pointer to the current lineCurCount	equ $84	; number of the scroll phaseBackPtr	equ $B0	; background pointerLineEnd	equ 160	; number of lines to scrolllastLine	equ 169		phb	; save the current data bank register	php	sei	pea $0101	; now set the current data bank to $01	plb	plb	; now that we are in bank 1, lets do it	lda #LineEnd	sta CurCount	; offset counter;	stz CurSLine	; start on the first lineDoOneScreen	DoALine	lda #lastLine	; actual scan line to be scrollin'	sta CurLinePt	; save itDAL0005	asl a	; multiply line by 2	tay	; use as a table offset	lda [ScreenTab],y	; get its address in bank 1	tax	; this is the source line	clc	; and add 4 scan lines to it...	adc #$A0*4	; size of 4 scan lines	tay	; store it in Y	jsr DoVertRazor	; scroll the can lines!	; that scan line is now done, time to go to the next one...		dec CurLinePt	; decrement line count by 1	lda CurLinePt	; get the line count	cmp #14	; is it the 14th line?	bge DAL0005	; if not, do another line...	; now copy the line of background data into the screen with the next razor;		jsr CpyBack	; copy the background data...			lda CurCount	; reduce curcount	sec	sbc #4	sta CurCount	cmp #4	bge DoOneScreenDone	plp	plb	; restore the old data bank	rtlCpyBack	lda CurCount	; get the number of the line we are on...	clc 	adc #13	; offset it properly	asl a	; multiply it by 2	tay	; use it as an offset to create the src ptr	lda [ScreenTab],y	; get the pointer from screen tab	tax	; save it in X	ldy #34	; now get the dest line (17...)	lda [ScreenTab],y	tay	jsr DoVertLine	; and move the data		txa	; now bump the line down...	sec	sbc #$A0	; by one scan line...	tax	ldy #32	lda [ScreenTab],y	tay	jsr DoVertLine		txa	; now bump the line down...	sec	sbc #$A0	; by one scan line...	tax	ldy #30	lda [ScreenTab],y	tay	jsr DoVertLine		txa	; now bump the line down...	sec	sbc #$A0	; by one scan line...	tax	ldy #28	lda [ScreenTab],y	tay	jmp DoVertLine		rts	EndP	EJECT********************************************************************************	Export SmoothScrollSouthSmoothScrollSouth	PROC** Description:	This routine will scroll the screen south because you are*	going north*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With GlobalsCurSLine	equ $80	; number of the current lineCurLinePt	equ $82	; pointer to the current lineCurCount	equ $84	; number of the scroll phaseBackPtr	equ $B0	; background pointerLineEnd	equ 160	; number of lines to scrolllastLine	equ 169		phb	; save the current data bank register	php	sei	pea $0101	; now set the current data bank to $01	plb	plb	; now that we are in bank 1, lets do it	lda #LineEnd	stz CurCount	; offset counter;	stz CurSLine	; start on the first lineDoOneScreen	DoALine	lda #18	; actual scan line to be scrollin'	sta CurLinePt	; save itDAL0005	asl a	; multiply line by 2	tay	; use as a table offset	lda [ScreenTab],y	; get its address in bank 1	tax	; this is the source line	sec	; and add 4 scan lines to it...	sbc #$A0*4	; size of 4 scan lines	tay	; store it in Y	jsr DoVertRazor	; scroll the can lines!	; that scan line is now done, time to go to the next one...		inc CurLinePt	; decrement line count by 1	lda CurLinePt	; get the line count	cmp #174	; is it the 14th line?	blt DAL0005	; if not, do another line...	; now copy the line of background data into the screen with the next razor;		jsr CpyBack	; copy the background data...			lda CurCount	; reduce curcount	clc	adc #4	sta CurCount	cmp #160	blt DoOneScreenDone	plp	plb	; restore the old data bank	rtlCpyBack	lda CurCount	; get the number of the line we are on...	clc 	adc #17	; offset it properly	asl a	; multiply it by 2	tay	; use it as an offset to create the src ptr	lda [ScreenTab],y	; get the pointer from screen tab	tax	; save it in X	ldy #173*2	; now get the dest line (17...)	lda [ScreenTab],y	tay	jsr DoVertLine	; and move the data		txa	; now bump the line down...;	sec	sbc #$A0	; by one scan line...	tax	ldy #172*2	lda [ScreenTab],y	tay	jsr DoVertLine		txa	; now bump the line down...	sec	sbc #$A0	; by one scan line...	tax	ldy #171*2	lda [ScreenTab],y	tay	jsr DoVertLine		txa	; now bump the line down...	sec	sbc #$A0	; by one scan line...	tax	ldy #170*2	lda [ScreenTab],y	tay	jmp DoVertLine		rts	EndP	EJECT********************************************************************************	Export SmoothScrollWestSmoothScrollWest	PROC** Description:	This procedure will scroll the screen east smoothly*** Inputs:   None** Outputs:  None** External Refs:** Entry Points:********************************************************************************	With GlobalsCurSLine	equ $80	; number of the current lineCurLinePt	equ $82	; pointer to the current lineCurCount	equ $84	; number of the scroll phaseBackPtr	equ $B0	; background pointerLineEnd	equ 119	; number of bytes to scroll per line		phb	; save the current data bank register	php	sei	pea $0101	; now set the current data bank to $01	plb	plb	; now that we are in bank 1, lets do it	lda #LineEnd	sta CurCount	; offset counter	stz CurSLine	lda MyBackPtr	sta BackPtr	lda MyBackPtr+2	sta BackPtr+2DoOneScreen	DoALine	ldy #$1C	; get the current scan lineDAL0005	lda [ScreenTab],y	; get its address in bank 1	tax	jsr theRazor	; scroll the can line!	; that scan line is now done, time to go to the next one...		iny	iny	; bump the line count	cpy #174*2	; are we done???	blt DAL0005	; if not go do the next line!	; now copy the line of background data into the screen with the next razor;	jsr cpyBack		lda CurCount	sec	sbc #4	sta CurCount	bpl DoOneScreenDone	plp	plb	; restore the old data bank	rtl; cpyBack is designed to copy one word width portion of the background into the screen; at the proper location. Note that the Y CurSLine contains the current bkgnd portion to; scroll in.; cpyBack is designed to copy one word width portion of the background into the screen; at the proper location. Note that the Y CurSLine contains the current bkgnd portion to; scroll in.cpyBack	ldy #$1C	; get the current scan line	lda [ScreenTab],y	; get its address in bank 	tay	; save it in <Y>	clc	adc CurSLine	; offset this for the background	tax	; and save it in <X>		tya	; get screen pointer back	clc	adc #$74	; add the proper byte offset	tay	; AND PUT IT BACK INTO Y; now load the data from the background into the screen column!	DOtestLINES	; create all the lines we need	lda CurSLine	; decrement the number of lines	clc	adc #4	sta CurSLine		rts;; The following routine is designed to unwrap a single scroll of a scan line It will consist; of about 60 pairs of load and store instructions to perform the proper scrolling in this dir;theRazor	DoWestRazor	rts	; and go back to where we came from		EndP		EJECT********************************************************************************	Export SmoothScrollEastSmoothScrollEast	PROC** Description:	This procedure will scroll the screen east smoothly*** Inputs:   None** Outputs:  None** External Refs:** Entry Points:********************************************************************************	With GlobalsCurSLine	equ $80	; number of the current lineCurLinePt	equ $82	; pointer to the current lineCurCount	equ $84	; number of the scroll phaseBackPtr	equ $B0	; background pointerLineEnd	equ 119	; number of bytes to scroll per line		phb	; save the current data bank register	php	sei	pea $0101	; now set the current data bank to $01	plb	plb	; now that we are in bank 1, lets do it	lda #LineEnd	sta CurCount	; offset counter	lda #$76-2	; set up CurSLine	sta CurSLine	lda MyBackPtr	sta BackPtr	lda MyBackPtr+2	sta BackPtr+2DoOneScreen	DoALine	ldy #$1C	; get the current scan lineDAL0005	lda [ScreenTab],y	; get its address in bank 1	tax	phy	jsr theRazor	; scroll the can line!	; that scan line is now done, time to go to the next one...	ply	iny	iny	; bump the line count	cpy #174*2	; are we done???	blt DAL0005	; if not go do the next line!	; now copy the line of background data into the screen with the next razor;	jsr cpyBack		lda CurCount	sec	sbc #4	sta CurCount	bpl DoOneScreenDone	plp	plb	; restore the old data bank	rtl; cpyBack is designed to copy one word width portion of the background into the screen; at the proper location. Note that the Y CurSLine contains the current bkgnd portion to; scroll in.cpyBack	ldy #$1C	; get the current scan line	lda [ScreenTab],y	; get its address in bank 	tay	; save it in <Y>	clc	adc CurSLine	; offset this for the background	tax	; and save it in <X>; now load the data from the background into the screen column!	DOtestLINES	; create all the lines we need	lda CurSLine	; decrement the number of lines	sec	sbc #4	sta CurSLine		rts;; The following routine is designed to unwrap a single scroll of a scan line It will consist; of about 60 pairs of load and store instructions to perform the proper scrolling in this dir;theRazor	DoEastRazor	; create the east razor!	rts	; and go back to where we came from		EndP		END	