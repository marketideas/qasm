******************************************************************************** InitSeg.aii** (C)  Copyright two guys and a cabbage software 1988* All rights reserved.** by Jim Mensch* 7/14/88** This init segment will be loaded before the rest of the application and will* place a startup message on the screen after initializing quickdraw. It will* then exit with an RTL and the loader will continue on with the app load.** Files:	System Macros and Equates**** Modification History:** Version Alpha  Mensch**     7/14/88 	First pass at an init segment  **      *----------------------------------------------------------------------------------* 4/16/90	Mensch* Started 5.0.3 conversion today...*********************************************************************************	PRINT NOGEN,NOHDR	SEG 'initseg'	STRING ASIS	PRINT PUSH,OFF	Include '::zzMain Source:All.game.macros'	INCLUDE 'E16.Quickdraw'	INCLUDE 'E16.Memory'	INCLUDE '::zzMain Source:game.macros'	INCLUDE '::zzMain Source:game.equates'	PRINT POP*********************************************************************************    Equates used in this program.********************************************************************************ScreenMode	equ Mode320ScreenWidth	equ 320	EJECT********************************************************************************InitialSeg	PROC** Description:	This seg will start up the memory mgr, tool locator and*	quickdraw. It will then Draw a startup screen and end.*** Inputs:	None** Outputs:	None** External Refs:		Import FatalError	Entry InitTask** Entry Points:	None********************************************************************************		phk	; set the data bank register to our	plb	; current program bank reg.		_TLStartup	; Start Tool Locator	pha	; Space for result	_MMStartup	; Start memory manager	pla	sta >MyID		_MTStartup	; Start up Misc Tools	_IMStartup	; Start integer math toolset; First allocate the shadowed screen space that we need	pha	; Room for result	pha	PushLong #$B000	; Number of bytes needed for screen	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrBank+attrAddr;	pea $0010	; high word of address;	pea $2000	; lowword of address	PushLong #$010800	; Allocate Shadowed screen	_NewHandle	bcc IT0005	; Test carry for errorITNoShadow	lda #$DEAD	; bad shadow handle error	brl FatalError	; If no memory we got a fatal error!IT0005		PullLong Deref	; Retrieve handle to our DPage area	lda [deref]	; now test too see if we have the right	cmp #$0800	; address for this handle	bne ITNoShadow	ldy #2	lda [deref],y	cmp #$01	; see if we in bank 1!	bne ITNoShadow	; if not report it as an error!; Now free up the rest of memory that we can!; First call compact mem to compact what remains of memory	_CompactMem	; this should compact all memory	pha	; Room for result	pha	PushLong #$FFFF	; Number of bytes needed for screen	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrBank	PushLong #$030000	; Allocate this bank screen	_NewHandle	_DisposeHandle	pha	; Room for result	pha	PushLong #$FFFF	; Number of bytes needed for screen	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrBank	PushLong #$040000	; Allocate this bank screen	_NewHandle	_DisposeHandle	pha	; Room for result	pha	PushLong #$FFFF	; Number of bytes needed for screen	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrBank	PushLong #$050000	; Allocate this bank screen	_NewHandle	_DisposeHandle	pha	; Room for result	pha	PushLong #$FFFF	; Number of bytes needed for screen	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrBank	PushLong #$060000	; Allocate this bank screen	_NewHandle	_DisposeHandle	pha	; Room for result	pha	PushLong #$FFFF	; Number of bytes needed for screen	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrBank	PushLong #$070000	; Allocate this bank screen	_NewHandle	_DisposeHandle	pha	; Room for result	pha	PushLong #$FFFF	; Number of bytes needed for screen	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrBank	PushLong #$080000	; Allocate this bank screen	_NewHandle	_DisposeHandle	_CompactMem	; re-compact memory again...	; Get memory for Tool Direct pages	pha	; Room for result	pha	PushLong #$0300	; Number of bytes needed for QD	PushWord >MyID	; ID of this application	PushWord #AttrLocked+attrFixed+attrPage+attrBank	PushLong #0	; Allocate them in bank 0	_NewHandle	bcc IT0010	; Test carry for error	brl FatalError	; If no memory we got a fatal error!IT0010	PullLong ZPHandle	; Retrieve handle to our DPage area	lda [ZPHandle]	; Dereference the handle to get a ptr	sta ZPPointer	; to our direct page area and save it.	PushWord ZPPointer	; QuickDraw uses 3 pages of Dpage	PushWord #ScreenMode; Used to set all master SCB's	PushWord #0	; Zero means use default buf size	PushWord >MyID	; Application ID for allocating data	_QDStartup	; Start QuickDraw, turn on SHR Screen	bcc IT0015	brl FatalError	; If it can't be started then bombIT0015	PushWord #10	; draw our little message	PushWord #30	_MoveTo		PushLong #PleaseWait	_DrawString		PushWord #10	PushWord #40	_MoveTo		PushLong #AutString	_DrawString	; Enable super hi-res shadowing so that I can use bank 1 memory to do my copies!	longa Off	sep #$20	lda >$E0C035	; load the shadowing register now	and #$F7	; enable super hires shadowing	sta >$E0C035	; and save the shadowing register	rep #$20	Longa On	; Now load the startup screen onto the super high res screen; Now that the startup screen is loaded, I will now copy it up to the super hi-res screen;Was:;	ldx #$0000	; copy all the bytes;CpyScrn	;	lda StartupScreen,x	; get the first word;	sta >$012000,x	; and save it to the screen;	inx;	inx;	cpx #32000	; and copy till I am done;	blt CpyScrn; but now its:	lda #$7D00	sta >DestinationSize		lda #$2000	sta >DestinationPtr	lda #$00E1	sta >DestinationPtr+2			pha	; room for result	PushLong #theScreen	; pointer to the screen	lda >theScreenSize	pha		PushLong #DestinationPtr	PushLong #DestinationSize	_UnPackBytes	pla; The following section of code should stay commented as long as shadowing is to; be used. If you want to dispoe of shadowing, simply uncomment lines until the end; of this section...;*******************************************************************;	longa Off;	sep #$20;	lda >$E0C035	; load the shadowing register now;	ora #$08	; enable super hires shadowing;	sta >$E0C035	; and save the shadowing register;	rep #$20;	Longa On;	;;;	PushLong Deref	; deallocate the handle;	_DisposeHandle;*******************************************************************; That section is now over butthead.	; finally install the animation stuff	PushLong #InitTask	_SetHeartBeat	lda >$E0C041	; enable VBL Interupts GGRRRRRRRRRR	ora #$08	sta >$E0C041		RTL	; and return to our callerPleaseWait	str 'Loading the game Please wait'AutString	str 'Game by Mensch and Williamson'MyID	ds.W 1DestinationPtr	ds.L 1DestinationSize	ds.W 1TheScreenSize	dc.W $0B55 TheScreen	dc.L $00FF00FF,$00FF00FF,$00FF00FF,$00FF00FF,$00FF00FF,$00FF00FF,$00FF00FF,$00FF00FF	dc.L $00FF00FF,$00FF00FF,$000300F3,$C2707707,$77070200,$0100C070,$00DF7777,$07000042	dc.L $70007744,$000300C2,$42770777,$77070100,$770600E0,$00707700,$00C27077,$07000003	dc.L $01004277,$00C37707,$DB770001,$00000800,$70770077,$C2707700,$00000300,$00427777	dc.L $C3770701,$77070100,$770B00DC,$70770070,$07007777,$44707777,$07008100,$77077777	dc.L $00770000,$42007007,$77000277,$77778170,$70037700,$81007707,$70777707,$77770702	dc.L $000400D7,$00707700,$000477C0,$70077077,$77420045,$7077000F,$07007707,$77777077	dc.L $77007707,$0D77C007,$00770700,$07707707,$77770077,$77810070,$D7700770,$77000B00	dc.L $77770070,$77007707,$00457770,$0777072B,$70770077,$00007707,$77077077,$70077707	dc.L $07777700,$77070077,$70770000,$07007707,$77000077,$77007770,$4200D770,$70770A00	dc.L $07707700,$77770077,$0000C070,$28774407,$07707700,$77000077,$07700770,$00007777	dc.L $77077077,$00770700,$07707700,$77070077,$77770000,$77070070,$0700D777,$70770000	dc.L $07707700,$000177C0,$20004277,$00770777,$77007707,$07777770,$77707770,$70770700	dc.L $70777007,$07777707,$77700777,$0B774270,$00007707,$77007777,$70770000,$000C00D7	dc.L $77007077,$70770770,$70077077,$770500C0,$77070070,$12774400,$70777700,$00770700	dc.L $70770077,$07707707,$C0007777,$07700C77,$77007077,$77700770,$D7707700,$77770B00	dc.L $70770000,$07007707,$00C07777,$42777701,$77770900,$77077707,$77770070,$77140042	dc.L $77007077,$00770770,$00707707,$77077707,$00770700,$77070081,$FF00FF77,$FF00FF00	dc.L $DF00FF00,$00000400,$E5707707,$81770000,$00007077,$000900E4,$07700700,$77000077	dc.L $0700E570,$77007077,$70770070,$770700E5,$70770070,$E5777707,$70770700,$00707700	dc.L $00E57077,$00707707,$77007077,$0700E570,$77007077,$70770070,$770700E5,$00770070	dc.L $E5707700,$70070700,$00007007,$00E57077,$77770002,$77010042,$0300E670,$70770000	dc.L $000300E6,$E6707700,$00000200,$0300E677,$70770000,$00FF00FF,$00FF00FF,$00E400FF	dc.L $00E6C000,$C00BC002,$004200C4,$C0C0B007,$000C0C0B,$0700DB0B,$0C0BCB00,$C0B000B0	dc.L $0B0800C0,$00000CC0,$BB00CBCB,$0B090044,$C090CC0B,$0B0BCBBC,$090042C0,$0CB0C0B0	dc.L $0B0C0B0C,$00DAC0C0,$0B080042,$C0B00C0C,$B0B000B0,$C0070042,$0BB0BB0C,$46CC0C00	dc.L $99B00700,$C00B0C0B,$0046CCC0,$00DCBB00,$CB0C0008,$B0CCCCBC,$0042CC99,$BCBC0C09	dc.L $99CC6060,$C009B0BB,$960B1700,$6B9976BB,$0BCB9009,$090000B0,$6C6CC9B9,$BC0B990C	dc.L $00DA90C9,$0B030042,$42B00BB6,$0BB00100,$60110042,$BCB0BC0B,$9C7B0000,$0000C0C0	dc.L $BCCC0006,$0800C0C0,$0000C069,$BC00900C,$020042C9,$DAC0000C,$02004200,$C0C6CBCC	dc.L $C0091600,$00C00B00,$C0CC7B00,$CB0B0000,$B000B09B,$69BC0060,$0100C0B0,$00C0C90B	dc.L $BB970602,$7B0200C0,$00DAB0C6,$C6000004,$00420979,$006B6C09,$00CC0900,$C09CCC06	dc.L $B9990900,$C0090090,$70BB0600,$CC0400C1,$C7B60C00,$0B0200C0,$00DAB000,$97000004	dc.L $00426C9C,$4290CB01,$00CC0400,$C0907B06,$677C0900,$C0B00060,$60B96C00,$0C050046	dc.L $B90900CB,$020044BB,$DAC06B6C,$CC001000,$00900BC0,$0070B900,$00990600,$C0BBC70C	dc.L $79960900,$909C0090,$9097C900,$07050046,$BB0700C9,$02004499,$DA60BC9B,$09000400	dc.L $C1C9BBBB,$07000300,$00C09CB9,$70767602,$970200C0,$00C1609C,$06000004,$004479C6	dc.L $C0BB9902,$000500DA,$97C97900,$0200C167,$C096BB0C,$77770200,$0200C060,$C1B0B99B	dc.L $00000400,$44BC7706,$0B960200,$0600DA60,$990B0000,$46609BB6,$96090200,$0200C067	dc.L $C0706777,$69960200,$0400C1C0,$99090000,$02004469,$DA90C69B,$03004200,$BCB97967	dc.L $0B090046,$00609676,$77670700,$0600C010,$7767C9B7,$45709776,$97090200,$02004466	dc.L $DA9099B9,$04004200,$9B979607,$090045B0,$67677906,$67760000,$00C01011,$99699906	dc.L $9079BB69,$07020045,$00446769,$60976702,$670300DB,$456766BB,$97070200,$44114569	dc.L $66760200,$0400C170,$690B0000,$02004466,$DB709766,$76090400,$44709699,$6C090200	dc.L $00114479,$02004410,$C1609799,$00000400,$44967609,$79790200,$0400DB70,$C7777600	dc.L $02004476,$44777609,$02004511,$C1707766,$00000400,$44977707,$97990200,$0900DA60	dc.L $70960000,$69670700,$00C07097,$76690602,$004200C1,$90777702,$000400C1,$76610600	dc.L $79020044,$00DA6097,$79090009,$79000070,$C0706796,$67060200,$4200C176,$67760200	dc.L $0400C170,$77070000,$02004499,$DA706771,$66000900,$00009097,$70979706,$090200C0	dc.L $00C16776,$79020042,$00C17067,$09000004,$00449777,$70697702,$060200DA,$00C07069	dc.L $60777702,$060200C0,$00C17179,$67020042,$00C19097,$07000004,$00446969,$10676702	dc.L $070100DA,$02004476,$C0707676,$71060200,$4200C161,$76770200,$0400C170,$76070000	dc.L $02004476,$DA107167,$77010200,$0200C070,$C0107677,$67070200,$4200C117,$96660200	dc.L $0100C070,$00C01007,$77770702,$77020044,$00DA1011,$67110102,$660200C0,$00C01061	dc.L $61110702,$004200C1,$70167102,$010100C0,$0200C011,$C0677707,$11070200,$0A00DA11	dc.L $11170100,$07000070,$C0101177,$71710200,$4200C111,$11770200,$0100C010,$00C01117	dc.L $11170602,$110200C0,$00DA1011,$11000005,$C0771717,$04004211,$11161701,$0000C110	dc.L $14114200,$77161177,$10711167,$77010000,$17711171,$71117111,$4200DA11,$46010000	dc.L $C0004211,$0100C111,$11C10100,$42111101,$0211C100,$DB101111,$03114500,$01000010	dc.L $00C11142,$C1000001,$11110511,$01000010,$110111C1,$FF00FF11,$FF00FF00,$FF00FF00	dc.L $FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00	dc.L $FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00,$FF00FF00	dc.L $FF00FF00,$FF00FF00,$FF00FF00,$D000FF00,$01004200,$00C1FF0F,$F0000042,$0F070042	dc.L $00F00000,$C1FFFF0F,$FF000200,$0100C3F0,$0044F000,$C0FF0F01,$00F00300,$00C2F000	dc.L $C0F0FF01,$F0F00100,$000A00C2,$FF00000F,$00FF0000,$00CBFF00,$F000F002,$000800C2	dc.L $00000F00,$0F0000F0,$000300C1,$C30F000F,$F0000100,$F0000044,$00F00081,$C1F00000	dc.L $02004200,$420F000F,$000F0200,$0B00C2F0,$0F00FF00,$000FF000,$F0000FF0,$000200CA	dc.L $00C00F00,$0F00FF1D,$00F000FF,$00F00FFF,$0F0FF0FF,$0000FF00,$000F000F,$FF000F00	dc.L $42F00000,$0FF01500,$0F0F000F,$FF0000F0,$00FFF000,$00F0FF00,$0F00F00F,$0F120042	dc.L $F0FF00F0,$00F0FF00,$FF0000FF,$00FF00F0,$00420F00,$0FF00F0E,$000FFFF0,$F00F0F00	dc.L $FF000F0F,$0F0A0042,$F0000F00,$0FF0000F,$00CAF000,$0F000081,$0FF00C00,$00F0F000	dc.L $0FF0F0FF,$420FF000,$00000CF0,$000F000F,$000F0F00,$42F000F0,$0FF01500,$F00F000F	dc.L $000F000F,$F000FFF0,$00F0000F,$0F000FF0,$F0030042,$81F0000F,$0FF0000F,$0FF00026	dc.L $0000F000,$F000F0FF,$F0000F0F,$0F00000F,$F00F0FF0,$00F0000F,$0F000F00,$FF00F000	dc.L $F0000F00,$008100CA,$03000F00,$F0000FF0,$000D0F42,$F0000FF0,$F0F0000F,$000F0000	dc.L $1DF04200,$00F0000F,$00FF0FF0,$F0000FF0,$00F00FF0,$F0F0FF00,$000FF000,$FF0F00F0	dc.L $00420F00,$00FF0F10,$F0000FF0,$F0FF000F,$0FF0000F,$0042F0FF,$F0000F07,$F0000F0F	dc.L $13F04200,$000FFF0F,$00F0FF0F,$00000F00,$000FF0FF,$F0FF00F0,$008100CA,$03000F00	dc.L $F0000FF0,$000D0F42,$F0000FF0,$F0F0000F,$000F0000,$1DF04200,$00F0000F,$000F00F0	dc.L $F0000FF0,$000F00F0,$F0F0000F,$000FF000,$0FF000F0,$00420F00,$000FF003,$000F81F0	dc.L $00020FF0,$00440FF0,$F0000F07,$F0000F0F,$03F0C000,$0F000F0F,$0F0000C0,$F0060042	dc.L $00F0000F,$00CAF000,$F03F0042,$000FF000,$F0000FF0,$000FF000,$F0000FF0,$F0F0000F	dc.L $000F0000,$000F0F00,$00F0000F,$00FF000F,$0F00FFF0,$000FF000,$F0F0000F,$000FF000	dc.L $0FF000F0,$00F00000,$010FF0F0,$0F81F000,$260FF000,$000FF000,$000F00F0,$0FF0000F	dc.L $00F0000F,$F0000F0F,$0F000F0F,$0000F000,$000F000F,$F0000FF0,$CAF0000F,$1E004200	dc.L $0000FF0F,$FF0F00FF,$0FF00000,$FF00F000,$F0000FF0,$0F00000F,$0F0F0000,$42FF0000	dc.L $0FFF2B00,$000F0F00,$F00F000F,$0FFF0000,$00F000F0,$0F00F0FF,$0F00F0F0,$F00F00FF	dc.L $00F0FFF0,$FF00F0FF,$F0FF000F,$0042FF00,$00F0FF11,$000FF00F,$0F0F000F,$FFF00F00	dc.L $42FF0000,$000F0900,$0000FF00,$FF0000FF,$000500CC,$00000F00,$0200C00F,$C4F0000F	dc.L $00004200,$0200C7F0,$D5F0000F,$00000500,$0F00000F,$FF000044,$F00000C5,$000100C7	dc.L $FF00FFFF,$FF00FF00,$FF00FF00,$FF00FF00,$C200FF00,$FFFF0400,$FFFFFFFF,$FFFFFFFF;	Include '::game files:Startscreen.aii'	EndP		EJECT********************************************************************************FatalError	PROC** Description:	Routine that is called whenever a tool sends back an error*	that can not be recovered from. This routine prints the*	error on the screen, waits for a keypress then quits back*	to whoever started this application up!*** Inputs:	A = Error number** Outputs:	NONE (program exits)** External Refs:** Entry Points:	NONE********************************************************************************	pha	; Push the error code	PushLong #errNumStr	; Address of storage area	PushWord #4	; Length of string	_Int2Hex	_GrafOff	; If QD Started, shut off graphics	PushLong #ErrStr	; Write error message to the screen	_WriteCString	pha	; Space for result	PushWord #0	; No echo	_ReadChar	; Wait for a key to be pressed	pla	; Discard the key	_Quit QuitParms	; Quit back to where we came from.	brk $FF	; If the quit fails then just break	ErrStr	dc.B 'A fatal error has occured $'ErrNumStr	dc.B 'xxxx   press any key to exit',0QuitParms	dc.L 0,0,0	ENDP	Export InitTaskInitTask	Proc	DC.L 0InitTaskCnt	DC.W 1	Dc.W $A55A	php	REP #$30	lda >TaskFlag	inc a	cmp #6	; past our limit?	blt @1	lda #0@1	sta >taskFlag	asl a	tax	jsr (Colors,x)			lda #5	sta >InitTaskCnt	plp	RTL; These are the color rotation phases we use.Color1	equ $0BColor2	equ $0CColor3	equ $06Color4	equ $09Red1	equ $D00Red2	equ $600Yellow1	equ $FF0Yellow2	equ $880Orange1	equ $F70Orange2	equ $840	MACRO	Setcolor &Colornum,&Color	pea 0	pea &ColorNum	pea &Color	_SetColorEntry	EndM	Phase0	SetColor Color1,Red1	SetColor Color2,Yellow2	SetColor Color3,Orange2	SetColor Color4,Yellow1	rts	Phase1	SetColor Color1,Red2	SetColor Color2,Orange1	SetColor Color3,Orange2	SetColor Color4,Yellow2	rts	Phase2	SetColor Color1,Yellow1	SetColor Color2,Orange2	SetColor Color3,Orange1	SetColor Color4,Yellow2	rts	Phase3	SetColor Color1,Yellow2	SetColor Color2,Red1	SetColor Color3,Orange1	SetColor Color4,Yellow1	rts	Phase4	SetColor Color1,Orange1	SetColor Color2,Red2	SetColor Color3,Orange2	SetColor Color4,Yellow1	rtsPhase5	SetColor Color1,Orange2	SetColor Color2,Yellow1	SetColor Color3,Orange1	SetColor Color4,Yellow2	rts	;Colors	dc.W phase0	dc.W Phase1	dc.W Phase2	dc.W Phase3	dc.W Phase4	dc.W Phase5	TaskFlag	dc.W 0	endP		END