dc.W 0,0	; east	dc.W 0,0	; south east	dc.W 0,0	; south	dc.W 0,0	; south west	dc.W 0,0	; west	dc.W 0,0	; north west		dc.W 0,-1	; speed 1 north	dc.W 2,-1	; speed 1 north east	dc.W 2,0	; east	dc.W 2,1	; south east	dc.W 0,1	; south	dc.W -2,1	; south west	dc.W -2,0	; west	dc.W -2,-1	; north west	dc.W 0,-2	; speed 2 north	dc.W 4,-2	; speed 1 north east	dc.W 4,0	; east	dc.W 4,2	; south east	dc.W 0,2	; south	dc.W -4,2	; south west	dc.W -4,0	; west	dc.W -4,-2	; north west	dc.W 0,-3	; speed 3 north	dc.W 6,-3	; speed 3 north east	dc.W 6,0	; east	dc.W 6,3	; south east	dc.W 0,3	; south	dc.W -6,3	; south west	dc.W -6,0	; west	dc.W -6,-3	; north west	dc.W 0,-4	; speed 4 north	dc.W 8,-4	; speed 4 north east	dc.W 8,0	; east	dc.W 8,4	; south east	dc.W 0,4	; south	dc.W -8,4	; south west	dc.W -8,0	; west	dc.W -8,-4	; north west	dc.W 0,-5	; speed 5 north	dc.W 10,-5	; speed 5 north east	dc.W 10,0	; east	dc.W 10,5	; south east	dc.W 0,5	; south	dc.W -10,5	; south west	dc.W -10,0	; west	dc.W -10,-5	; north west	dc.W 0,-6	; speed 6 north	dc.W 12,-6	; speed 6 north east	dc.W 12,0	; east	dc.W 12,6	; south east	dc.W 0,6	; south	dc.W -10,6	; south west	dc.W -10,0	; west	dc.W -10,-6	; north west	Export CharTable	;!!!!!CharTable	DC.L Mons0Sped,mons1,mons2,mons3,mons4,mons5,mons6,mons7	dc.L SS0Wand,ss1,ss2,ss3,ss4,ss5,ss6,ss7	Export WandShotWandShot	ds.B CEndOfVars	dc.W $05	; Wand shot height	                    	dc.W $04	dc.L WandTable	dc.L WandMTable	DC.W 0,9	; Phases for East	DC.W 0,9	; Phases for West	DC.W 0,9	; Phases for North	DC.W 0,9	; Phases for South	dc.W 0,9,0,0	; for shots this is	the explosion info	dc.W 0	; Direction	dc.W 0	; Speed 	dc.L 0	; storage for collision rect info		Export SpudDataSpudData	ds.B CEndOfVars	DC.W $0F	; 15 bytes tall	DC.W $08	; 8 bytes wide	dc.L SpedTable	dc.L SpedMTable	DC.W 20,29	; Phases for North 20,29	DC.W 0,9	; Phases for East 0,9	DC.W 30,39	; Phases for South 30,39	DC.