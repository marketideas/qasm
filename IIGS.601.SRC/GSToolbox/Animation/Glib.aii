    dc.W $FFFF,$FFFF,$FFFF,$FFFF        dc.W $FFFF,$00F0,$FF00,$FFFF        dc.W $FFFF,$1101,$0F11,$FFFF        dc.W $F0FF,$1111,$1011,$FFFF        dc.W $F0FF,$1111,$1011,$FFFF        dc.W $F0FF,$1109,$0019,$FFFF        dc.W $F0FF,$9921,$209E,$FFFF        dc.W $F0FF,$97EE,$E09E,$FFFF        dc.W $0EFF,$99EE,$EE9E,$FF0F        dc.W $0EFF,$EEE9,$EE79,$FF0F        dc.W $01FF,$1111,$1111,$FF0F        dc.W $0EFF,$EEEE,$EEEE,$FF0F        dc.W $02FF,$2022,$2222,$FF0FSpedShotN81        dc.W $0000,$0000,$0000,$0000        dc.W $0000,$0000,$0000,$0000        dc.W $0000,$0000,$0000,$0000        dc.W $0000,$FF0F,$00FF,$0000        dc.W $0000,$FFFF,$F0FF,$0000        dc.W $0F00,$FFFF,$FFFF,$0000        dc.W $0F00,$FFFF,$FFFF,$0000        dc.W $0F00,$FFFF,$FFFF,$0000        dc.W $0F00,$FFFF,$FFFF,$0000        dc.W $0F00,$FFFF,$FFFF,$0000        dc.W $FF00,$FFFF,$FFFF,$00F0        dc.W $FF00,$FFFF,$FFFF,$00F0        dc.W $FF00,$FFFF,$FFFF,$00F0        dc.W $FF00,$FFFF,$FFFF,$00F0        dc.W $FF00,$FFFF,$FFFF,$00F0        dc.B 2,6,11,9SpedShotE01        dc.W $FFFF,$FFFF,$FFFF,$FFFF        dc.W $FFFF,$F0FF,$FF0F,$FFFF        dc.W $FFFF,$01F0,$0F10,$FFFF        dc.W $FFFF,$1101,$0F12,$FFFF        dc.W $F0FF,$1211,$0F88,$FFFF        dc.W $01FF,$2811,$0F08,$FFFF        dc.W $01FF,$2812,$8088,$0FF0        dc.W $07FF,$8800,$0088,$9009        dc.W $F0FF,$EEF0,$00EE,$9011        dc.W $FFFF,$EE0E,$E1EE,$9080        dc.W $FFFF,$EE01,$EEEE,$FF0F        dc.W $F0FF,$11EE,$1011,$FFFF        dc.W $F0FF,$EEEE,$EEE1,$FF0F        dc.W $02FF,$E0EE,$EE0E,$FF20        dc.W $02FF,$2F22,$22F2,$FF20SpedShotE81        dc.W $0000,$0000,$0000,$0000        dc.W $0000,$0F00,$00F0,$0000        dc.W $0000,$FF0F,$F0FF,$0000        dc.W $0000,$FFFF,$F0FF,$0000        dc.W $0F00,$FFFF,$F0FF,$0000        dc.W $FF00,$FFFF,$F0FF,$0000        dc.W $FF00,$FFFF,$FFFF,$F00F        dc.W $FF00,$FFFF,$FFFF,$FFFF        dc.W $0F00,$FF0F,$FFFF,$FFFF        dc.W $0000,$FFFF,$FFFF,$FFFF        dc.W $0000,$FFFF,$FFFF,$00F0        dc.W $0F00,$FFFF,$FFFF,$0000        dc.W $0F00,$FFFF,$FFFF,$00F0        dc.W $FF00,$FFFF,$FFFF,$00FF        dc.W $FF00,$F0FF,$FF0F,$00FF        dc.B 2,2,8,14ErrHeader	dc.B 'Character data:',0AddressLine	dc.B '    Address:'ALNumber	dc.B 'xxxxxxxx',0	ENDR	Export GameDebugGameDebug	Proc	With Globals	With ConstantsretAddr	equ 1procNum	equ retAddr+3parm1	equ procNum+2parm2	equ parm1+2parmFlags	equ parm2+2aStack	equ parmFlags+2	txa	sta >xSave	tya	sta >ySave	lda aStack,s	; and save a	sta >aSave		lda parm1,s	lda parm2,s		lda RetAddr,s	lda RetAddr+2,s		lda ProcNum,s	; 	jsr CheckSumRange	; Checksum a range of memory; 	bcs GD0010		lda ProcNum,s	; now see if its an imediate break	bmi GD0010	; if the high bit is set, then do the break		phb	; save the current data bank...	jsl SetMyDataBank	; set the data bank to the current bank..	phb	; and push that data bank..	lda 1,s	; now test to see that this is the proper data bank..	xba	cmp 1,s	bne GD0009	; if they aren't equal then always break here!	pla	lda >$E0C025	and #$0004	bne GD0010	brl DoneDebugGD0009	plaGD0010	_GrafOff	lda ProcNum,s	; get the proc number	cmp #$7FFF	; is it the DebugStrflag?????	bne DebugWord	brl DebugProcDebugWord	PushLong #DebugStr1	_WriteCString	lda ProcNum,s	; process number	jsr ErrorBytes	PushLong #DebugStr2	_WriteCString	lda parm1,s	jsr ErrorBytes	PushWord #$A0	_WriteChar	lda parm2,s	jsr ErrorBytes	PushLong #RegStr	_WriteCString	lda >aSave	jsr ErrorBytes	PushWord #$A0	_WriteChar	lda >xSave	jsr ErrorBytes	PushWord #$A0	_WriteChar	lda >ySave	jsr ErrorBytes		PushWord #$A0	_WriteChar	phb	phk	pla	jsr ErrorBytes			PushLong #retStr	_WriteLine	brl kbdWaitDebugProc	PushLong #DebugStr1	_WriteCString		lda parm1,s	; get the string pointer	tax	; from the paramlist	lda parm2,s	pha	phx	_WriteCString	; and write it to the screen	PushLong #RegStr	_WriteCString	lda >aSave	jsr ErrorBytes	PushWord #$A0	_WriteChar	lda >xSave	jsr ErrorBytes	PushWord #$A0	_WriteChar	lda >ySave	jsr ErrorBytes		PushWord #$A0	_WriteChar	phb	phk	pla	jsr ErrorBytes			PushLong #retStr	_WriteLine	brl kbdWaitkbdwait	lda >$E0C025	and #$00C3	; test for the 4 magic keys	cmp #$00C3	beq DoneDebug	lda >$E0C000	bpl kbdWait	sta >$E0C010	and #$007F	cmp #$001B	; is it eascape?	beq doToggleScreen	cmp #$007F	; is it delete???	beq doSmash	; smash into the monitor	_GrafOn; 	jsr CheckSumRange	; Checksum a range of memoryDoneDebug	sep #$20	Longa Off	pla	ply	plx	; pop off the 4 parms	plx	plx	plx	plx	; pop off asave also	phy	pha	LongA On	Rep #$20	lda >xSave	tax	lda >ySave	tay	lda >aSave	rtl	doSmash	brk 1	bra DoneDebug	; smash into the debugger and exit doToggleScreen	_GrafOnkbdwdts	lda >$E0C000	bpl kbdWdts	sta >$E0C010	_GrafOff	brl kbdWaitxsave	ds.B 2ysave	ds.B 2asave	ds.B 2RetStr	str ' 'ErrorBytes; routine to word in hex to error output	phx	phx	pha	_HexIt	PullLong >EBStuff	lda #0	sta >EBStuff+4	PushLong #EBStuff	_WriteCString	rtsEBStuff	ds.B 6DebugStr1	dc.B 'DB:',0DebugStr2	dc.B ' Parms:',0RegStr	dc.B ' Reg values:(a,x,y,DB/K Reg)',0,0AtString	dc.B ' at:',0CheckSum	ds.B 4	EndP	EJECT********************************************************************************	Export StartLibStartLib	PROC** Description:	Initializes the animation library. Allocate memory for the*	background*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With Constants	stz4 MyBackHandle	; zero out the background handle	stz4 CharTblHandle		stz AnimState	; turn off all animations	Stz AnimActive	;; Now copy spuds data into his data record for the first time...	PushLong #SpudData	pea 0	jsl LoadSpecActor		PushLong #WandShot	pea 8	jsl LoadSpecActor		stz KillState	stz BugFlag	stz AnimState	rtl	EndP		EJECT********************************************************************************SetupEraseZP	PROC Export** Description:	Internal routine that sets us up in preparation for an erase*** Inputs:	None** Outputs:	None** External Refs:	uses NextRects** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsPassData	equ $80	; the number of the	char to copy in...	lda passData	; get the offset to	the char record	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta theChar	; store it in the zp pointer	lda >CharTable+2,x	; now the high byte	sta theChar+2	txa	asl a	tax		lda [TheChar]	sta CXPosOff	sta >NextRects,x		ldy #CYPosOff	lda [TheChar],y	sta CYPosOff	sta >NextRects+2,x		ldy #CHeightOff	lda [TheChar],y	sta >NextRects+4,x	sta CHeightOff		ldy #CWidthOff	lda [TheChar],y	lsr a	; divide it by 2 for ease of use...(#words..)	sta >NextRects+6,x	sta CWidthOff		rts	EndP			EJECT********************************************************************************SetupBlitZP	PROC Export** Description:	sets up direct page for reblitting...*** Inputs:	None** Outputs:	None** External Refs: ** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsPassData	equ $80	; the number of the	char to copy in...	lda passData	; get the offset to	the char record	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta theChar	; store it in the zp pointer	lda >CharTable+2,x	; now the high byte	sta theChar+2	lda [TheChar]	sta CXPosOff	ldy #2	lda [TheChar],y	sta CYPosOff	ldy #CHeightOff	lda [TheChar],y	sta CHeightOff		ldy #CWidthOff	lda [TheChar],y	lsr a	; divide it by 2 for ease of use...(#words..)	sta CWidthOff			rts	EndP	EJECT********************************************************************************	Export SetupZPSetUpZP	Proc** Description:	copy data from specified animation record to ZPage*** Inputs:	passdata contains anim rec number** Outputs:	ZPSet properly** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsPassData	equ $80	; the number of the	char to copy in...	lda passData	; get the offset to	the char record	sta PassChar	; ?????????????????????????????????????????	and #$000F	; only 16 chars boys	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta theChar	; store it in the zp pointer	lda >CharTable+2,x	; now the high byte	sta theChar+2	stx CharNum	; store the char num *4...	ldy #0SUZLoop		; now copy current char data to the ZP	lda [theChar],y	tyx	sta 0,x	iny	iny	cpy #CharTSize	; are we done yet?	blt SUZLoop	rtl	EJECT********************************************************************************MakeMainChar	PROC** Description:	This routine should be called when you want to designate a*	character as a main character. what will happen is that it*	will read the new character tables structure that will be *	stored at the end of actor data and create a separate routine*	that can be called to strike the character onto the screen.*** Inputs:	TheCharPtr:Long	Pointer to the animation record...** Outputs:	None** External Refs:	import BuildStampCode** Entry Points:********************************************************************************	with animRecord;; The first thing that needs to happen is the creation of the new handle	EndP		EJECT********************************************************************************BuildStampCode	PROC Export** Description:	Build code in a handle that strikes a character onto the screen*	*** Inputs:	CodePtr:Long;    	Pointer to where to deposit the code*	ImagePtr:Long;	Pointer to the image data to strike*	MaskPtr:Long;	Pointer to the mask data to strike*	charHeight:Integer;	Height of the characters bitmap*	charWidth:Integer;	width of the characters bitmap** Outputs:	CodePtr:Long;	updated code pointer** External Refs:	none** Entry Points:	none********************************************************************************; local direct page usage...; partially built from a stack frame ...oldDPage	equ 1oldDBank	equ oldDPage+2ScreenOffset	equ oldDBank+1theRTL	equ ScreenOffset+2	; offset to the screen addresstheCharWidth	equ theRTL+3theCharHeight	equ theCharWidth+2MaskPtr	equ theCharHeight+2ImagePtr	equ MaskPtr+4codePtr	equ ImagePtr+4;; First create the direct page frame...	pha	; space for screen offset	pha	phb	phd	; save the data bank and such..	tsc	; get the stack pointer	tcd	; and make it the direct page...; initialize any variables...		stz <ScreenOffset	; this is a 2 byte field..	ldx #$00	; use X as our row counter..;; Now we start our main loop...oLoop	ldy #0iLoop01		; get our loop starting points (column counter..)	lda [MaskPtr],y	; get the next word of the mask...	beq @NoDraw	; if its zero, we do not draw and we fall thru	inc a	; see if its $FFFF	bne @fullmask	jsr StrikeOne	; simply add the code to strike the byte	bra @NoDraw@FullMask	jsr FlowOne	; can't just strike, must flow thru the mask@NoDraw	iny	; bump the column counter..	iny	tya	cmp <theCharWidth	; are we yet wider to the characters width?	blt iLoop01	; if not, then get the next column from the char...; If at the end of a line, we now bump all our counters and test for the end...	lda <ScreenOffset	clc	adc #$00A0	; bump by scan line size...	sta <ScreenOffset	lda <ImagePtr	; bump the image pointer and mask pointer	adc <theCharWidth	sta <imagePtr	bcc @nd0010	inc <ImagePtr+2	clc@nd0010	lda <MaskPtr	adc <theCharWidth	sta <maskPtr	bcc @nd0020	inc <MaskPtr+2@nd0020; now see if we are done...	inx	cpx <theCharHeight	blt oLoop; we are done now robbie!	lda #$0060	; put an RTS in our tank	sta [codeptr]	pld	; restore the old dpage	plb	pla	pla	; recover the crap from the stack...; now move the RTL...	sep #$20	longa off	pla	ply	; discard the stack crap...	plx	plx	plx	plx	plx	plx;; put the return address back on...	phy	pha	rep #$20	longa On; and return to the caller...	rtl	;; StrikeOne; This code creates the commands to strike a word onto the screen; codeptr, screenptr, imageptr, and <Y> must already be set up...;	lda #$data;	sta |$Scrn,x;StrikeOne	lda #$00A9	; lda # opcode...	sta [codePtr]	; save it in the code buffer	inc <codePtr	; bump our counter...	lda [imageptr],y	; now get the byte of the image	sta [codeptr]	; and save it as an operand...	inc <codePtr	; bump our counter...	inc <codePtr	; bump our counter...	slamSTA	lda #$009D	; thats STA |$nnnn,X	sta [codeptr]	inc <codePtr	; bump our counter...;; Now to generate and save the screen address...SlamAddress	tya	; get the column number	clc	adc <ScreenOffset	; add it to the screen pointer	sta [codePtr]	; save it	inc <codePtr	; bump our counter...	inc <codePtr	; bump our counter...	rts	; and return		;; FlowOne; This will generate the code to do everything with masking...; it needs the same stuff set up as strike one	; Now to generate the following code sequence...;;	lda Scrn,X;	and #$not(mask);	ora #$data&mask;	sta scrn,X;*--FlowOne	lda #$00BD	; this is LDA |$nnnn,X	sta [codeptr]	; save it in the proper place..	inc <codeptr	; bump the code pointer	jsr slamAddress	; create the screen address		lda #$0029	; thats AND #$nnnn	sta [codeptr]	inc <codePtr	lda [maskptr],y	; get the proper mask data	eor #$FFFF	; not mask...	sta [codeptr]	inc <codePtr	; bump our counter...	inc <codePtr	; bump our counter...	lda #$0009	; thats ORA #$nnnn	sta [codeptr]	inc <codePtr	; bump our counter...	lda [imageptr],y	; first create the data image	and [maskptr],y	; masking off the bad area's	sta [codeptr]	; and save it...	inc <codePtr	; bump our counter...	inc <codePtr	; bump our counter...	brl slamSTA	; now do the final storeA	EndP		EJECT********************************************************************************SetUpDrawZP	PROC** Description:	Sets up our drawing ZP...*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsPassData	equ $80	; the number of the	char to copy in...	lda passData	; get the offset to	the char record	sta PassChar	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta theChar	; store it in the zp pointer	lda >CharTable+2,x	; now the high byte	sta theChar+2	lda [TheChar]	sta <CXPosOff		ldy #CYPosOff	lda [theChar],y	sta <CYPosOff		ldy #CCurPOff	lda [theChar],y	sta <CCurPOff		ldy #CMinPOff	lda [theChar],y	sta <CMinPOff		ldy #CMaxPOff	lda [theChar],y	sta <CMaxPOff		ldy #CDXOff	lda [theChar],y	sta <CDXOff		ldy #CDYOff	lda [theChar],y	sta <CDYOff		ldy #CIterOff	lda [theChar],y	sta <CIterOff		ldy #CHeightOff	lda [theChar],y	sta <CHeightOff		ldy #CWidthOff	lda [theChar],y	sta <CWidthOff		ldy #CFTabOff	lda [theChar],y	sta <CFTabOff	ldy #CFTabOff+2	lda [theChar],y	sta <CFTabOff+2		ldy #CMTabOff	lda [theChar],y	sta <CMTabOff	ldy #CMTabOff+2	lda [theChar],y	sta <CMTabOff+2	rts	; and return	EndP	EJECT********************************************************************************	Export RestoreZPRestoreZP	proc** Description:	Restore important zero page data!*** Inputs:	theChar must point to animation record to restore** Outputs:	None** External Refs:** Entry Points:********************************************************************************	ldy #0RZLoop	tyx	lda 0,x	sta [theChar],y	iny	iny	cpy #CEndOfVars	; are we done yet?	blt RZLoop	rtl	EndP******************************************************************  StopAnim -  Used	to deallocate the current animation frame*              it also de-allocates the	current background buffer**  Inputs:     None**  Outputs:******************************************************************	EXPORT StopAnimStopAnim	PROC	With AnimRecord	With Globals	With Constants	stz AnimActive	; animation activity flag	RTL	ENDP******************************************************************  StartAnim - Initializes memory for an animated sequence.	Call*              must	be ballanced to a call to stop anim. Start anim*              saves an image of the current background.**  Inputs:     None**  Outputs:    None******************************************************************	EXPORT StartAnimStartAnim	PROC	With AnimRecord	With Globals	With Constants;Height	equ 14	PushLong #0	PushWord #1	_GetAddress	pla	sta ScreenTab	sta SavedScrnTab	pla	sta ScreenTab+2	sta SavedScrnTab+2	lda [ScreenTab]	sta MyPointer	lda #AbsBank	sta MyPointer+2	lda #MyBackSaveArea	; set up the back pointer	sta BackPtr	sta MyBackPtr	lda #MyBackSaveArea>>16	sta BackPtr+2	sta MyBackPtr+2		pushLong MyPointer	PushLong BackPtr	; Now push the ptr to save bkgd	PushLong #$7D00	; length of the block	_BlockMove	; Now move the block	_shadowOff	lda #$2000	; now copy the Background into bank 1 screen memory	sta MyPointer	lda #DrawBank	; 	sta MyPointer+2		PushLong BackPtr	PushLong MyPointer	PushLong #$7D00	_BlockMove		_shadowOn		lda #$FFFF	; turn on animation	again!	sta AnimActive	RTL	ENDP******************************************************************  RefreshBack -	 Redraw the current	screen including background*	 must occur after a	StartAnim call**  Inputs:	 None**  Outputs:	 None******************************************************************	EXPORT RefreshBackRefreshBack	PROC	With Globals	With ConstantsMScreenTab	equ $B4	PROCDB $200,#0,#0		pushLong #MyBackSaveArea	PushLong #$012000	; Now push the ptr to save bkgd	PushLong #$7D00	; length of the block	_BlockMove	; Now move the block	RTL	ENDP	EJECT********************************************************************************FadeInBack	PROC Export** Description:	Like refresh back, only with some special effects thrown in for *	good measure...*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With Globals	With ConstantsMScreenTab	equ $B4	PROCDB $200,#1,#1FadeFactor	equ 73	ldx #0	ldy #FadeFactor+1FadePatchiLoop	lda >MyBackSaveArea,x	sta >$012000,x	txa	clc	adc #FadeFactor	cmp #$7D00	bge @cont	tax	bra iLoop@cont	sec	sbc #$7D00	tax	dey	bpl iLoop		RTL	ENDP	EJECT********************************************************************************	Export GetCharRectsGetCharRects	PROC** Description:	This routine will calculate the contents of the CurRects to*	collision rects. This routine will also test the animflag*	to see if a character is active, if it is not, it will*	simply store 0's into the chars rectangle.*** Inputs:	None** Outputs:	collision rectangle of chars in apropriate array** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsCharPt	equ $80TestPt	equ $84theMons	equ $72	; ;	stz theMons	bra MkBox020MkBox010	lda theMons	; get the monster number	asl a	; multiply by two	tax	lda Cascade,x	and AnimState	; check the monster	for movement	bne MkBox020	brl MkBox030MkBox020	lda theMons	; get the current monsters information	asl a	; 	asl a	tax	phx	; save this for later...	lda >CharTable,x	; 	sta CharPt	inx	inx	lda >CharTable,x	sta CharPt+2	ldy #CXPosOff	; get the characters animation top left corner	lda [CharPt],y	sta BH1	ldy #CYPosOff	lda [CharPt],y	sta BV1	ldy #CCoLInfo	; now get the current phase's offset bytes	lda [CharPt],y	tax	; save em for a sec...	and #$00FF	; get the H offset in pixels	clc	; clear the carry	adc BH1	; add it to the left edge	sta BH1	txa	; get the offset again	xba	; this time we want the veritcal component	and #$00FF	clc	; and add it to the top coordinant	adc BV1	sta BV1	iny	iny	; bump Y to get the width characteristic	lda [CharPt],y	; and get the next bytes...	tax	; save em for a sec...	and #$00FF	; get the H width in pixels	clc	; clear the carry	adc BH1	; add it to the left edge	sta BH2	txa	; get the offset again	xba	; this time we want the height	and #$00FF	clc	; and add it to the top coordinant	adc BV1	sta BV2	pla	; now get the monster num * 4	asl a	; multiply it by 8	tax	; use it as an index	lda Bh1	sta CurRects.h1,x	lda Bv1	sta CurRects.v1,x	lda Bh2	dec a	sta CurRects.h2,x	lda Bv2	sta CurRects.v2,x	bra MkBox040	; now go to the save routine;; This routine is called when we want to store all zeros into an element in the; rect arrays for this character.MkBox030		; X contains the char number times 2	txa	; so make it char * 8	asl a	asl a	; so its the offset into an array of rectangles	tax	stz CurRects,x	stz CurRects+2,x	stz CurRects+4,x	stz CurRects+6,xMkBox040		lda theMons	inc a	sta theMons	cmp #16	bge MkBox050	brl MkBox010MkBox050		RTL	EndP		EJECT********************************************************************************DoErase2	Proc** Description:	Erase the current char with masking...*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsScrnPT	equ $90temp1	equ $94MaskPt	equ $98DETempData	equ $9CBackPt	equ $A0ScrnBase	equ $A4Height	equ 14	lda #MyBackSaveArea	; set up the back pointer	sta >Patch1+1	lda #MyBackSaveArea>>16	sep #$20	Longa off	sta >Patch1+3	rep #$20	longa on	lda CCurPOff	asl A	; Multiply it by 4	asl A	tay	lda [CMTabOff],y	sta MaskPt	iny	iny	lda [CMTabOff],y	sta MaskPt+2	lda [ScreenTab]	sta DETempData	sta ScrnBase	; save it as the base address of the screen	sta >Patch2+1	sta >Patch3+1	lda CYPosOff	; get the screen line	asl a	; multiply by 2	sta temp1	; save it for a sec	asl a	asl a	clc	adc temp1	; scrnline * $A	asl a	asl a	asl a	asl a	; and create scrnline*$A0	sta ScrnPt	; and save it	lda CXPosOff	; Now get the X Offset	lsr A	clc	adc ScrnPT	; and Add it to the	base addr	sta ScrnPT	; and now we have the offset	tax	; and place this in	x	lda CHeightOff	; now reset our line count	sta DETempData	;	phb	; save the current bank register	pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twiceOL001	ldy #0	; now cycle thru the loopIL001	lda [Maskpt],y	; load mask data	beq IL003	; if non-zero then draw it	sta temp1	; save mask byte for a sec...	eor #$FFFF	; NOT(Mask)patch2	and $1234,x	; load the screen byte	sta temp1+2	; save it alsoPatch1	lda >$111111,x	; Now get the back data	and temp1	; and it with the mask	ora temp1+2	; now add in the screen dataIL002Patch3	sta $1234,x	; and save it to the screenIL003	inx	inx	iny	; add 2 ( we save a	word at a time)	iny	cpy CWidthOff	; see if we are done	bne IL001	lda scrnPt	; adjust the pointer	clc	adc #$00A0	; skip to the next line	sta ScrnPt	; and save it back	tax	; and use it as an offset	lda MaskPT	; advance thru the figure	clc	; to the next line	adc CWidthOff	sta MaskPt	dec DETempData	bne OL001	plb	; now restore the bank register	rts	ENDP	EJECT********************************************************************************DoEraseCharSq	PROC** Description:	erase the current character from the screen now buddy!*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:*	MACRO	DoEraseRazor	LCLA &cntr	; define a var&cntr	SETA 100	; init to zero	WHILE &cntr>=0 DO	  lda >(MyBackSaveArea-$2000)+&cntr,x	  sta |&Cntr,x	  &cntr: SETA &cntr-2	ENDWHILE	MEND********************************************************************************	With AnimRecord	With GlobalsScrnPt	equ $90MaskPt	equ $98DETempData	equ $9CHeight	equ 14  	lda CYPosOff	; Get the screen line	asl A	; Multiply by 2	tay	; and use it as offset into	lda CXPosOff	; Now get the X Offset	lsr A	clc	adc [ScreenTab],y	; and Add it to the	base addr	tax	; save the scan line offset into x	lda CHeightOff	; now reset our line count	sta DETempData	;	lda CWidthOff	asl a	pha	asl a	adc CWidthOff	; we now have width *5	adc 1,s	; we now have width *7	ply	eor #$FFFF	; negate it...	adc #RazorsEnd	; get the offset from the back of the razor	tayoL001	pea returnAddr-1	phy	rtsreturnAddr	txa	; adjust the pointer	clc	adc #$00A0	; skip to the next line	tax	; and save it into x	dec DETempData	bne oL001	rts		DoEraseRazorRazorsEnd	rts	ENDP	EJECT********************************************************************************DoBlitCharSq	PROC** Description:	redraw the current character to the screen now buddy!* 11/30/90	Added clipping code for stage clipping of characters.** 12/3/90	Added Stage collision detection here since the data is already available...** Inputs:	AnimationZP must be preset by the caller** Outputs:	<A> contains zero if no stage edge hit, or:*	bit 0 - Top hit*	    1 - Left hit*	    2 - bottom hit*	    3 - right hit*	    15- off stage completely** External Refs:** Entry Points:*	MACRO	DoBlitRazor	LCLA &cntr	; define a var&cntr	SETA 100	; init to zero	WHILE &cntr>=0 DO	  lda |&cntr,x	  sta |&Cntr,x	  &cntr: SETA &cntr-2	ENDWHILE	MEND********************************************************************************	With AnimRecord	With GlobalsDETempData	equ $9C	pea $0000	; set up some temp storage on the stack...	lda CYPosOff	; Get the screen line	cmp StageRectBottom	; see if we are on the stage yet...	bge @Offstage	; if greater than or equal we aren't even on the stage...	cmp StageRectTop	; now see if we are past the top..	bge @cYPosOffOK	lda #$0001	; 12/3/90 signal top hit	sta 1,s	; 12/3/90	lda StageRectTop	; else use the top of the stage..	tay	; since it is invalid to have a char taller than the stage	bra @cHeightOK	; the height must be ok now!@cYPosOffOK	tay	; save it for a second..*** 11/30/90 Added this arithmetic here to adjust for the height monster adj..	sec	; add 1 extra just for snicks here!	adc cHeightOff	cmp StageRectBottom ; see if we are too tall for the stage..	blt @cHeightOK	sty DETempData	; save this for a second in a temp var..	lda 1,s	; 12/3/90 flag that we are off the bottom of the stage..	ora #$0004	sta 1,s		lda StageRectBottom	sec	sbc DETempData	; now adjust the height for the stage	bmi @offStage	bne @stowHeight; this seems like a fine place to put this routine...@offStage		; ooops the rect ain't on the stage so no reblit needed	pla	; discard the flag data	lda #$F000	; signal character is offstage	rts	; so simply return;@cHeightOK	lda CHeightOff	; now reset our line count@stowHeight	sta DETempData	; so we can	tya	; get back the top of the rectangle..	asl A	; Multiply by 2	tay	; and use it as offset into screen tab..; now validate the X data		lda CXPosOff	; Now get the X Offset (in pixels thank god..)	cmp StageRectRight	bge @offstage	; ooops not on stage..	cmp StageRectLeft	; now see if there is a problem with the other side	bge @cXPosOffOK	; ok the left side is just fine..	lda 1,s	; update the stage wall collision flag	ora #$0002	sta 1,s	lda StageRectLeft	; else we just use the stage left..	bra @stowNewxPos	; and the width must also be good..@cXPosOffOK; now we must adjust the width if need be..	lda CWidthOff	; its in bytes right now...	asl a	; make it pixels..	adc cXPosOff	; now test the right side..	cmp StageRectRight	blt @cWidthOffOK	; the width is fine lets do it..	beq @cWidthOffOK; ok.. the width is bad now what do we do? we must adjust it so that its good..; keeping in mind that if we adjust it to an odd number of bytes we then have to; readjust it so its even and push the xpos back..	lda 1,s	; update the stage wall collision flag..	ora #$0008	sta 1,s	lda StageRectRight	sec	sbc cXPosOff	; get the real number of pixels available..	lsr a	; turn it into a number of bytes..	adc #0	; add the carry back in (carry means odd pixels)	dec cXPosOff	; "add" another byte to the left	dec cXPosOff	; a byte is two pixels	lsr a	; shift out the low bit	php	; save its state..	rol a	; shift it back into its proper place..	sta cWidthOff	; save the new width	plp	; and recover the proper carry state of the thing..	bcc @stowNewXPos	; if the carry is clear then we have even bytes		; we can continue on with what we have...; If we make it this far then we have a problem... you see, since the loop stores words; the number of bytes in cWidthoff must be even. At this stage it is odd, so we need; to add another byte to the "left" of cxPosOff and increase the rectangle by a byte	dec cXPosOff	; "add" another byte to the left	dec cXPosOff	; a byte is two pixels	inc CWidthOff	; bump the width in bytes@cWidthOffOK	lda cXPosOff; must have cXPosOff or equivalent in <A> now..@stowNewxPos	lsr A	clc	adc [ScreenTab],y	; and Add it to the	base addr	tax	; save the scan line offset into x	lda CWidthOff	; 	asl a	; we divided ity by 2 when it was copied..	pha	asl a	adc 1,s	; we now have width *6	ply	eor #$FFFF	; negate it...	adc #RazorsEnd	; get the offset from the back of the razor	tayoL001	pea returnAddr-1	phy	rtsreturnAddr	txa	; adjust the pointer	clc	adc #$00A0	; skip to the next line	tax	; and save it into x	dec DETempData	bne oL001	pla	; recover stage collision info	rts	; and return		DoBlitRazorRazorsEnd	rts	ENDP	EJECT********************************************************************************DoDraw1	PROC** Description:	Draw the "current" character indicated by ZPage. NOTE:*	CCurPhase should already be in <A>** This routine trashes:*	CHeightOff* Inputs:	None** Outputs:	<A><X> contain collision rect info...** External Refs:** Entry Points:;	Export MaskPatch1********************************************************************************	With Globals	With ConstantsScrnPT	equ $90temp1	equ $94MaskPt	equ $98DDTempData	equ $9CCharPt	equ $A0Height	equ 14;	lda CCurPOff	; its already here!	asl A	; Multiply it by 4	asl A	tay	lda [CMTabOff],y	sta MaskPt	lda [CFTabOff],y	sta CharPt	iny	iny	lda [CMTabOff],y	sta MaskPt+2	lda [CFTabOff],y	sta CharPt+2	lda CYPosOff	; load the y offset	asl A	; Multiply by 2	tay	; and use it as offset into	lda CXPosOff	; Now get the X Offset	LSR A	; convert bytes to pixels...	clc	adc [ScreenTab],y	; screen pointer table!	sec	sbc #$2000	; offset this from the real screen...	sta ScrnPt	tax 		phb	; save the current bank register	pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twiceOL001	ldy #0	; now cycle thru the loop	lda cWidthOff	sta temp1	IL001	lda [<Maskpt],y	; load from the Mask;MaskPatch1	and >$0A0000,x	; add in the proper mask table offset...	beq IL003	; if non-zero then draw it	sta >maskTemp	; save this as the character mask...	inc a	; if all set then just blit the data	beq IL004		lda [<CharPt],y	;	eor |$2000,x	; 	and >MaskTemp	; add in the character masks...	eor |$2000,x	; 	bra IL002	IL004	lda [<CharPt],yIL002	sta |$2000,x	; 6IL003	;; *** WAS ***;IL001	lda [<Maskpt],y	; load from the Mask;	beq IL003	; if non-zero then draw it;	inc a	; if all set then just blit the data;	beq IL004;	;	lda [<CharPt],y	;;	eor |0,x	; ;	and [<MaskPt],y	; add in the character masks...;	eor |0,x	; ;	bra IL002;	;IL004	lda [<CharPt],y;IL002	sta |0,x	; 6;IL003	; ******	IF &TestVerFlag THEN	  tya	; calculate the actual address offset	  clc	  adc ScrnPt	; by adding the screen pt and y	  bpl IL0FF	; if positive then this address is ok!	  Debug $F0DD,ScrnPt,PassChar	  Debug $F1DD,CXPosOff,CYPosOff	ENDIFIL0FF	inx	inx	iny	; add 2 ( we save a	word at a time)	iny	cpy temp1	; see if we are done	bne IL001	lda temp1	clc	adc CWidthOff	sta temp1	lda scrnPt	; adjust the pointer	clc	adc #$00A0	; skip to the next line	sta ScrnPt	; and save it back	tax 		dec CHeightOff	bne IL001	lda [MaskPt],y	; now get the chars collbox info for later use...	tax	; save it in X	iny	iny	lda [MaskPt],y	; and save it in A	plb	rtsMaskTemp	ds.W 1	ENDP	EJECT********************************************************************************DoAnim1	PROC** Description:	Animate the current character...*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With Constants	jsr SetUpDrawZP	; set up the animation Zero Page!	lda CXPosOff	; test the x coordinant	and #$7FFF	; strip the high bit...	cmp #320	; see if we are outside the normal range of drawing	bge DoBombChar	; whoops off the screen	adc CDXOff	; offset our character to its new bat time...	sta CXPosOff	; and save it...		lda CYPosOff	; test the Y coordinant	sec	sbc MenuHeight	cmp #200	; past the bottom of the screen?	blt DA1003DoBombChar	stz CDXOff	stz CDYOff	stz CIterOff	bra DA1007DA1003	lda CDYOff	adc CYPosOff	; carry clear here if it matters...	sta CYPosOff	dec CIterOff	bne DA1010	; if non-zero then continueDA1007	lda passChar	; if zero turn off animation flag for	        	asl a	tax	lda cascade,x	; the pass char.	eor TempAnimState	sta TempAnimState	; and resave anim state	cpx #16	; now test to see if its a bullet; Was BGE	bra DA1030	; if it is don't bother redrawing itDA1010	lda CCurPOff	; increment the phase	inc a	cmp CMaxPOff	blt @PhaseOK	lda CMinPOff	bra @PhaseOK1@PhaseOK		cmp CMinPOff	; see if we are less than the min Phase	bge @PhaseOK1	; if so then skip the next segment	lda CMinPOff@PhaseOK1	sta CCurPOff@PhaseOK2; call the drawing routine here. NOTE:Phase is in <A>!!!!;	jsr DoDraw1	; draw the character ; since it was handy, do draw now returns the collision rect info for the current; character in <X> and <A> Now we will copy that save info into the characters animation record; for them!	ldy #CCoLInfo+2	; get the location to store it in	sta [theChar],y	; since theChar just happens to already be set up!	dey	dey	txa	sta [theChar],yDA1030	ldy #CXPosOff	lda CXPosOff	sta [theChar],y		ldy #CYPosOff	lda CYPosOff	sta [theChar],y		ldy #CCurPOff	lda CCurPOff	sta [theChar],y		ldy #CIterOff	lda CIterOff	sta [theChar],y		rts	EndP	EJECT********************************************************************************DoEraseAll	PROC** Description:	This proc will erase all of the characters rectangles...*	it calls a small version of SetupZP that only does certain fields**** Inputs:	None** Outputs:	None** External Refs:*	With Globals* Entry Points:********************************************************************************* NOTE: since this routine is called before a routine that calls setupZP, it can trash * a few of our variables...LPassChar	equ $80LAnimState	equ CXCenterDATemp	equ CYCenter	phb		pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twice	lda AnimState	; get the current animation state 	sta LAnimState	; and store it on our temp...	stz LPassChar	; init our counter properly...DA0010	lsr LAnimState	; see if this char is animating...	bcc DA0020	jsr SetupEraseZP	jsr DoEraseCharSq	inc LPassChar	bra DA0010	DA0020	beq Done	inc LPassChar	bra DA0010	Done	plb	rts	EndP		EJECT********************************************************************************DoEraseKilled	PROC** Description:	This proc will erase all of the characters rectangles*	that have been killed since last time**** Inputs:	None** Outputs:	None** External Refs:*	With Globals* Entry Points:********************************************************************************* NOTE: since this routine is called before a routine that calls setupZP, it can trash * a few of our variables...LPassChar	equ $80LAnimState	equ CXCenterDATemp	equ CYCenter	phb		pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twice	lda >KillState	sta LAnimState	stz LPassChar	; init our counter properly...DA0010	lsr LAnimState	; see if this char is animating...	bcc DA0020	jsr SetupKillZP	jsr DoEraseCharSq	inc LPassChar	bra DA0010	DA0020	beq Done	inc LPassChar	bra DA0010	Done	plb	rtsSetUpKillZP; This routine will copy the proper data from the kill rects to our direct page vars for; eraseCharSq.	lda LPassChar	; get the character number	asl a	; multiply it by 8..	asl a	asl a	tax	; use it as an index	lda >KillRects.xPosition,x	sta <CXPosOff	lda >KillRects.yPosition,x	sta <CYPosOff	lda >KillRects.Height,x	sta <CHeightOff	lda >KillRects.Width,x	sta <CWidthOff	rts		EndP	EJECT********************************************************************************DoBlitKilled	PROC** Description:	This proc will erase all of the characters rectangles*	that have been killed since last time**** Inputs:	None** Outputs:	None** External Refs:*	With Globals* Entry Points:********************************************************************************* NOTE: since this routine is called before a routine that calls setupZP, it can trash * a few of our variables...LPassChar	equ $80LAnimState	equ CXCenterDATemp	equ CYCenter	phb		pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twice	lda >KillState	sta LAnimState	lda #0	sta >KillState	stz LPassChar	; init our counter properly...DA0010	lsr LAnimState	; see if this char is animating...	bcc DA0020	jsr SetupKillZP	jsr DoBlitCharSq	inc LPassChar	bra DA0010	DA0020	beq Done	inc LPassChar	bra DA0010	Done	plb	rtsSetUpKillZP; This routine will copy the proper data from the kill rects to our direct page vars for; eraseCharSq.	lda LPassChar	; get the character number	asl a	; multiply it by 8..	asl a	asl a	tax	; use it as an index	lda >KillRects.xPosition,x	sta <CXPosOff	lda >KillRects.yPosition,x	sta <CYPosOff	lda >KillRects.Height,x	sta <CHeightOff	lda >KillRects.Width,x	sta <CWidthOff	rts		EndP	EJECT********************************************************************************DoBlitAll	PROC** Description:	This proc will erase all of the characters rectangles...*	it calls a small version of SetupZP that only does certain fields**** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************* NOTE: sice this routine is called before a routine that calls setupZP, it can trash * a few of our variables...LPassChar	equ $80LAnimState	equ CXCenterDATemp	equ CYCenter	With Globals		phb	pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twice	lda AnimState	; get the current animation state 	sta LAnimState	; and store it on our temp...	lda #$000F	; init our counter properly...	sta DATempDA0010	sta LPassChar	asl LAnimState	; see if this char is animating...	bcc DA0030	jsr SetupBlitZP	jsr DoBlitCharSq	bra DA0020DA0030	asl a	asl a	asl a	tax	lda #0	sta >NextRects,x	sta >NextRects+2,x	sta >NextRects+4,x	sta >NextRects+6,xDA0020	lda DATemp	dec a	sta DATemp	bpl DA0010	plb	rts	EndP	EJECT********************************************************************************TestBlitter	PROC** Description:	This is the screen re-blit test routine, use it well!*** Inputs:	None** Outputs:	None** External Refs:*	MACRO	DoPEIRazor	LCLA &cntr	; define a var&cntr	SETA 158	; init to zero	WHILE &cntr>=0 DO	  pei <&Cntr	  &cntr: SETA &cntr-2	ENDWHILE	MEND* Entry Points:********************************************************************************	sei	phd	; save the current direct page...	tsc	sta >dummyStack	longa off	; to hit switches with..	sep #$20		sta >$E0C003	; write/read Aux RAM	sta >$E0C005	rep #$20	longa On	; TestBlitLoop here	lda #$2000		ldy #199	clc; Now begin the loopiLoop		tcd	adc #$00A0-1	tcs	; NOTE: <A> now contains the address of the next line..	bra doScanLinertnScanLine	dey		bpl  iLoop	cli	longa off	; to hit switches with..	sep #$20		sta >$E0C002	; write/read Aux RAM	sta >$E0C004	rep #$20	longa On		lda >DummyStack	tcs	pld	cli	rtldummyStack	ds.W 1	doScanLine	DoPEIRazor	jmp rtnscanLine	EndP				EJECT********************************************************************************DoBlitGroovy	PROC** Description:	This proc is a special blitter that will do both areas of*	the character at once, the derase and reblitt squares. Note that* 	the nextrects array has already been setup at this point..** 12/3/90	Added support for the stage collision information to go in here** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************* NOTE: sice this routine is called before a routine that calls setupZP, it can trash * a few of our variables...LPassChar	equ $80DETempData	equ $9C	; used in doBlitCharSq as a temp so can weLAnimState	equ CXCenterDATemp	equ CYCenter	With Globals		phb	pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twice	lda AnimState	; get the current animation state 	sta LAnimState	; and store it on our temp...	lda #$000F	; init our counter properly...	sta DATempDA0010	sta LPassChar	; 	asl LAnimState	; see if this char is animating...	bcc DA0030	jsr SetupBlitZP	;; First test to see if we can do the groovy reblit without taking too much time...;	lda LPassChar	; create the character table offset	asl a	; multiply it by 8	asl a	asl a	tax;; Now get the difference in the Y offsets, if they are too much then forget it...; get smaller of the old Y and new Y in <Y> and the larger in <A>;	ldy <CYPosOff	; get the current Y in Y	lda >NextRects+2,x	; get the old ypos offset...	cmp <CYPosOff	; and test against the new location	beq @YPosOK	; if its equal, no y change needed...	bge @FixY010	; else Fix the Y coord.; If here then coords are in reverse order...	tay	; put small Y in Y	lda <CYPosOff	; and get Big Y in <A>	sec	; set the carry for the ensuing subtract...@FixY010	sty <CYPosOff	; save <Y>	sbc <CYPosOff	; subtract the small<Y> and we have the difference; carry clear from the above compare...	clc	adc <cHeightOff	sta <cHeightOff@YPosOK; Now do it up for the X coordinant as well...	ldy <CXPosOff	lda >NextRects,x	cmp <CXPosOff	beq @XPosOK	; if equal no further math needed	bge @FixX010	tay	lda <CXPosOff	sec@FixX010	sty <CXPosOff	sbc <CXPosOff	clc	adc <cWidthOff	sta <cWidthOff@XPosOK; If we get here then dirty the old rectangle...	lda #0	sta >NextRects+4,x	; thats our flag...	jsr DoBlitCharSq	ldy #cColFlags	; now save the collision flag comming out into the record..	sta [theChar],y	; lucky for us this is setup for us at the setupblitZP call		bra DA0020DA0030	asl a	asl a	asl a	tax	lda #0	sta >NextRects+4,xDA0020	lda DATemp	dec a	sta DATemp	bpl DA0010	plb	rts	EndP	EJECT********************************************************************************DoDeraseBlit	PROC** Description:	This proc will erase all of the characters rectangles...*	it calls a small version of SetupZP that only does certain fields**** Inputs:	None** Outputs:	None** External Refs:	with globals** Entry Points:********************************************************************************* NOTE: sice this routine is called before a routine that calls setupZP, it can trash * a few of our variables...LPassChar	equ $80DATemp	equ CYCenter	phb	pea DrawDblBank	; and switch to a new data bank reg	plb	; that happens to contain the screen	plb	; this is only one byte.. so do it twice	lda #$000F	; init our counter properly...	sta DATempDA0010	sta LPassChar;-----------------------------------------------------; was jsr setup derase ZP...	asl a	; multiply it by 4	asl a	asl a	tax	lda >NextRects+4,x	beq @Bad	sta CHeightOff	lda >NextRects,x	sta CXPosOff	lda >NextRects+2,x	sta CYPosOff	lda >NextRects+6,x	sta CWidthOff;----------------------------------------------------	jsr DoBlitCharSq@BadDA0020	lda DATemp	dec a	sta DATemp	bpl DA0010	plb	rts	EndP******************************************************************************** DoAnimate - draws	all the characters*	Export DoAnimateDoAnimate	procLpassChar	equ $80DETempData	equ $9C	; NOTE trashed in blitters/erasersDATemp	equ $9A	; NOTE TRASHED IN BLITTERS	with AnimRecord	With Globals	With Constants		_ShadowOff;; Debug only!	lda >$E12000	inc a	sta >$E12000;; REMOVE ME NOW!	lda KillState	; see if anyone has been killed..	beq @NoDead	; if not, skil the next call..	jsr DoEraseKilled@NoDead	jsr DoEraseAll	; erase everybody here first!	lda AnimState	beq DADone	Sta TempAnimState	; save it in our temp for refreshing later...	sta <DETempData	; save the animation state for a sec...	lda AnimActive	; test if animation	frame already set up	beq DANoAnim	; if not, just end		stz LPassCharDA0010		lsr <DETempData	; see if this char is animating...	bcc @NotActive	jsr DoAnim1	lda #1	; make sure zero is not set here!@NotActive	beq DADone	inc LPassChar	; bump the character number and try again	bra DA0010DADone	_ShadowOn	;; Got the flag here!@SpecialTest1;	jsl TestBlitter;	bra @Done	jsr DoBlitGroovy	; try another feeble attempt to reduce flicker..	lda >KillState	; see if anyone has been killed..	beq @NoDead2	; if not, skil the next call..	jsr DoBlitKilled@NoDead2@Done; ***WAS	jsr DoBlitAll	; reblit the chars to the screen;	jsr DoDeraseBlit	jsl SetMyDataBank	lda TempAnimState	sta AnimStateDANoAnim	rtl	EndP	EJECT********************************************************************************DoKill	Proc Export	procHdr 'DoKill'** Description:	this procedure erases the specified character and then turns*	its animation state off.*** Inputs:	charToKill:Word** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With Constants;; Stack information;SaveDPage	equ 1RTL1	equ SaveDPage+2fredChar	equ RTL1+3;; equate used for setup ZPLPassChar	equ $80	phd	; save the current directpage	lda >MyZP	; get the games global ZP	tcd	; use it as our direct page!		sei	lda fredChar,s	sta LPassChar	cmp #16	; see if its larger	than it shound be	blt @CharNumOK	Debug $FFBB,#$DEAD,#$5678 ; show that it was a bad char	bra LPC0020@CharNumOK	jsl SetUpZP; Replace call to DoErase2 with a setup of the proper kill rect for this here victim!;	jsr DoErase2	lda LPassChar	asl a	tax	lda cascade,x	and KillState	; see if we already killed this guy once...	bne @AlreadyDead	; wouldn't do to kill the same guy twice in a turn!	lda cascade,x	; get the cascade value back again!	ora KillState	sta KillState	; set the proper flag in the kill state record	txa	asl a	; now multiply it by 8.. (its already x2)	asl a	tax	lda <CXPosOff	; update the kill rectangle	sta KillRects.xPosition,x	lda <CYPosOff	sta KillRects.yPosition,x	lda <CHeightOff	sta KillRects.Height,x	lda <CWidthOff	sta KillRects.Width,x@AlreadyDead	; Now turn off the animation record dude..LPC0010	lda LPassChar	asl a	tax	lda cascade,x	; the pass char.	eor #$FFFF	; Not cascade	and animState	sta animState	; and resave anim state	stz CIterOff	jsl RestoreZPLPC0020	cli		pld	; restore the direct page		sep #$20	; unlink our frame	Longa Off	pla	ply		plx	phy	pha	rep #$20	Longa On		rtl	EndP	EJECT********************************************************************************StartCharCall	PROC Export	EXPORT StartStackChar	ProcHdr 'StartStackChar'** Description:  	This routine starts the specified character off in the proper*	direction with the proper phases.. IT DOES NOT START animation*** Inputs:   	On Stack (Pass by phase)*	| PassY    | - WORD*	| PassX    | - WORD*	| PassMaxP | - WORD*	| PassMinP | - WORD*	| LPassChar| - WORD*	| return Address | - 3Byte*    (PassByDirection)*	| PassY    | - WORD*	| PassX    | - WORD*	| PassFlag | - WORD (High bit always set...)*	| PassDir  | - WORD*	| LPassChar| - WORD*	| return Address | - 3Byte** Outputs:  	None** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsLocalFrame	equ $10	; number of bytes of local storage; Local Data storage areas and standard	frame dataTempDeRef	equ $01	; area for dereferencingTempCharPt	equ TempDeRef+4SavedDPage	equ LocalFrame+1	;RetAddr1	equ SavedDPage+2	; return addressRetAddr2	equ RetAddr1+3; Passed parameters	Note Locaframe+1 ref...;LpassChar	equ RetAddr2+3	; Number of Pallet to loadPassDir	equ LPassChar+2	; starting directionPassFlag	equ PassDir+2	; high bit set for pass by directionpassMinP	equ PassDir	; phase specifiers if PassFlagpassMaxP	equ PassFlag	; high bit clearPassX	equ PassFlag+2	; speds starting X and YPassY	equ PassX+2	; Speds Starting X and Y;; Set up the stack frame for our routine to use;	phd	; save the direct page	tsc	; get the stack pointer	sec	sbc #LocalFrame	; subtract the local frame size	tcd	; make it the Direct page register	tcs	; also use it as a stack pointer; code here	lda <LpassChar	; get the offset to	the char record	and #$000F	; only 16 chars boys	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta <TempCharPt	; store it in the zp pointer	lda >CharTable+2,x	; noe the high byte	sta <TempCharPt+2	ldy #CCoLInfo	; preserve last collision info just in case	lda [<TempCharPt],y	pha	iny	iny	lda [<TempCharPt],y	pha		ldy #0	; Remove if we need speed	tyasc0010	sta [<TempCharPt],y	iny	iny	cpy #CEndOfVars	blt SC0010	ldy #CCoLInfo	; preserve last collision info just in case	pla	sta [<TempCharPt],y	iny	iny	pla	sta [<TempCharPt],y	lda <PassFlag	; test to see if this is the new or old	way...	cmp #$8000	beq ByDirection	; he is passing by direction	ldy #CCurPOff	lda <passMinP	sta [<TempCharPt],y	ldy #CMinPOff	sta [<TempCharPt],y	lda <passMaxP	ldy #CMaxPOff	sta [<TempCharPt],y	bra SC0020ByDirection	lda <PassDir	; load the direction	ldy #CDirOff	sta [<TempCharPt],y	and #$0006	; strip off bad data ( and low bit )	asl a	; and multiply by 2	clc	; now create the offset into the record	adc #CNorthPhase	; by adding the north offset            	tay	; use it as an index	lda [<TempCharPt],y	; now load the min phase	tax	; save this for a second	iny	iny	; now bump to get the max phase	lda [<TempCharPt],y	ldy #CMaxPOff	sta [<TempCharPt],y	; and save it in our record	txa	ldy #CCurPOff	sta [<TempCharPt],y	ldy #CMinPOff	sta [<TempCharPt],ySC0020	lda <passX	; save the starting x coord	ldy #CXPosOff	sta [<TempCharPt],y		lda <PassY	; save the starting Y coord		ldy #CYPosOff	sta [<TempCharPt],y			phb	jsl SetMyDataBank	; warning data bank error here!	ldx |MyZP	; get the direct page value apps	lda >AnimState,x	; get Anim state.	bne UpDateIt	; if its not equal,	update it!UpDateIt	lda <LpassChar	; get the character	number	asl a	tay	; use as offset	lda |cascade,y	; a cascade of single bits in a table	ora >AnimState,x	; add it to animation state	sta >AnimState,x	; and save it.	plb;;   UnLink the stack frame;Done	tsc	; get the stack pointer	clc	adc #LocalFrame	; subtract our local frame	tcs	; restore the stack	pointer	pld	; get the old direct page	phb	phd	brl Yank10StartStackChar	jsl StartCharCall	rtl	EndP			EJECT********************************************************************************MoveCharCall	Proc Export	Export MoveStackChar	procHdr 'MoveStackChar'** Description:  	this routine starts a character off moving in the current*	direction at the specified speed*** Inputs:	On stack*	| LPassChar   | - WORD*	| PassSpeed   | - WORD (PassDx)*	| PassFlag    | - WORD (PassDY)*	| PassIter    | - WORD** Outputs:  On Stack as needed** External Refs:** Entry Points:********************************************************************************	With Globals	With Constants	With animrecordLocalFrame	equ $10	; number of bytes of local storage; Local Data storage areas and standard	frame dataTempDeRef	equ $01	; area for dereferencingTempCharPt	equ TempDeRef+4SavedDPage	equ LocalFrame+1	; First parm passedRetAddr1	equ SavedDPage+2	; return addressRetAddr	equ RetAddr1+3; Passed parameters	Note Locaframe+1 ref...LPassChar	equ RetAddr+3	; Number of Pallet to loadPassSpeed	equ LPassChar+2PassFlag	equ PassSpeed+2PassDX	equ PassSpeedPassDY	equ PassFlagPassIter	equ PassFlag+2;; Set up the stack frame for our routine to use;	phd	; save the direct page	tsc	; get the stack pointer	sec	sbc #LocalFrame	; subtract the local frame size	tcd	; make it the Direct page register	tcs	; also use it as a stack pointer; code here	lda <LpassChar	; get the offset to	the char record	and #$000F	; only 16 chars boys	asl a	; multiply it by 4	asl a	tax	lda >CharTable,x	; get the low byte of the char pointer	sta <TempCharPt	; store it in the zp pointer	lda >CharTable+2,x	; noe the high byte	sta <TempCharPt+2	lda <PassFlag	; test for the data	passing method	cmp #$8000	bne NotBySpeed	; passed dx and dy so load it that way and calculate		;   CDir so MoveAccounting knows what to do.	bra BySpeed	NotBySpeed	ldy <PassDX	beq YTest1	bpl YTest2YTest3		; negative dx so directions will be 5,6,7	ldy <PassDY	beq YT3010	bpl YT3020	lda #7	bra NBScontYT3010	lda #6	bra NBScontYT3020	lda #5	bra NBScontYTest1		; no dx so directions will be 0 or 4	ldy <PassDY	bne YT101	lda #8	; not moving at all! so get outta here	bra NBScontYT101	bpl YT110	lda #0	bra NBScontYT110	lda #4	bra NBScontYTest2		; positive dx so directions will be 1,2,3	ldy <PassDY	beq YT210	bpl YT220	lda #1	bra NBScontYT210	lda #2	bra NBScontYT220	lda #3NBScont	inc a	ldy #CDirOff	sta [<TempCharPt],y	; store the calculated direction	ldy #CDXOff	; now to stow this data into our data structure	lda <PassDX	sta [<TempCharPt],y	ldy #CDYOff	lda <PassDY	sta [<TempCharPt],y	bra MC0020BySpeed	lda PassSpeed	; load in the speed	bne BYSpd01	; are we standing still???	tax	; use a zero offset	ldy #CCurPOff	lda [<TempCharPt],y	ldy #CMaxPOff	sta [<TempCharPt],y	ldy #CMinPOff	sta [<TempCharPt],y	txa	bra BySpd02BySpd01	and #$00FF	xba	; multiply by 256	lsr a	; then divide by 8 to get	lsr a	; multiply by 32!	lsr a	sta MCTemp	; save this for a second	ldy #CDirOff	lda [<TempCharPt],y	; add load the direction	dec a	; subtract 1	asl a	; multiply it by 4	asl a	adc MCTemp	tax	; and put it in x!	lda >SpeedOffTable+2,xBySpd02	ldy #CDYOff	sta [<TempCharPt],y	lda >SpeedOffTable,x	ldy #CDXOff	sta [<TempCharPt],y	ldy #cSpeedOff	lda passSpeed	sta [<TempCharPt],yMC0020	ldy #CIterOff	lda passIter	sta [<TempCharPt],y			phb	jsl SetMyDataBank	ldx |MyZP	; get the direct page value apps	lda <LpassChar	; get the character	number	asl a	tay	; use as offset	lda |cascade,y	; a cascade of single bits in a table	ora >AnimState,x	; add it to animation state	sta >AnimState,x	; and save it.	plb;;   UnLink the stack frame;Done	tsc	; get the stack pointer	clc	adc #LocalFrame	; subtract our local frame	tcs	; restore the stack	pointer	pld	; get the old direct page	phb	; set up for the yank!	phd	brl Yank8MoveStackChar	jsl MoveCharCall	rtl	EndP		EJECT********************************************************************************	Export DoBopperDoBopper	PROC** Description:	Called to actually change the sped bit maps so that they*	do the bop stuff. If the passFlag is set, this will unbop*	the character.*** Inputs:	PassFlag on stack** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With AnimRecord	With Globals	With ConstantsRetAddr	equ 1	; return address on the stackPassFlag	equ RetAddr+3	; address of the passed paramLPassChar	equ $80	PROCDB $215,#0,#0	lda >CharTable	; get the low byte of the char pointer	sta theChar	; store it in the zp pointer	lda >CharTable+2	; noe the high byte	sta theChar+2	lda PassFlag,s	; test to see if start or stop bop...	bpl DB0010	brl StopBopDB0010	ldy #CCurPOff	; save all the old data first	lda [theChar],y	sta >SavedData	ldy #CMinPOff	lda [theChar],y	sta >SavedData+2	ldy #CMaxPOff	lda [theChar],y	sta >SavedData+4	ldy #CDXOff	lda [theChar],y	sta >SavedData+6	lda #0	; and take this oportunity to zero the speed	sta [theChar],y	ldy #CDYOff	lda [theChar],y	sta >SavedData+8	lda #0	sta [theChar],y	ldy #CDirOff	; now get the movement direction	lda [theChar],y	and #$0006	; strip off the odd bits	clc	adc #CShootPhase	; add it to the start of the shoot phase	tay	; use as an offset	lda [theChar],y	; and get the current bopping phase	ldy #CMinPOff	; and make it the next phase to use	sta [theChar],y	ldy #CMaxPOff	sta [theChar],y		rtl	; and return for now;; Called to undo all the bad things that bopping did for us!StopBop	lda >SavedData+2	ldy #CMinPOff	sta [theChar],y	lda >SavedData+4	ldy #CMaxPOff	sta [theChar],y		lda >SavedData+6	ldy #CDXOff	sta [theChar],y		lda >SavedData+8	ldy #CDYOff	sta [theChar],y	rtlSavedData	ds.W 8	EndP		EJECT********************************************************** LoadAChar		                **               Loads an AnimRecord with an Actor       **		                **   Stack before Call:	                **		                **       | Actor #	    |	                **       | AnimRec	    |	                **       | Ret Addr	    |	                **       | Ret   | <---SP	                **		                **   Stack After Call:	                **		                **		                **       | prev Cont	    |  <---SP	                **		                **		                **		                **********************************************************	Export LoadACharLoadAChar	Proc	With Globals	With ConstantsLocalFrame	equ $10	; number of bytes of local storageTempDeRef	equ $01	; area for dereferencingActorPtr	equ TempDeRef+4AnimPtr	equ ActorPtr+4TempInt	equ AnimPtr+2SavedDPage	equ LocalFrame+1	; address of our direct pageRetAddr	equ SavedDPage+2	; return addressAnimRec	equ RetAddr+3	; Number of Pallet to loadActorNum	equ AnimRec+2;; Set up the stack frame for our routine to use;	PROCDB $206,#0,#0	phd	; save the direct page	tsc	; get the stack pointer	sec	sbc #LocalFrame	; subtract the local frame size	tcd	; make it the Direct page register	tcs	; also use it as a stack pointer    	lda AnimRec	; set up the pointer to our anim record	asl a	; first multiply by	4	asl a	tax	lda >CharTable,x	sta AnimPtr	lda >CharTable+2,x	sta AnimPtr+2	lda ActorNum	; Now build the actor pointer	bpl LoadReg	; load a regular actor	brl LoadObject	; if high bit set, load an objectLoadReg	dec a	; Decrement cause table offsets are different	asl a	asl a	; multiply it by 4	clc	; Now add in the offset to the table	adc #MBMCharIndex	; in the actor file	jsr SetUpActorPtr	jsr CopyActorToAnim	; Now we load the actors shot!	lda AnimRec	; set up the pointer to our anim record	cmp #8	; is it greater than 8???	blt LoadShot	; if not, then load a shot	brl LoadADone	; if so, then ignoreLoadShot	ora #$08	; set the high bit to indicate the shot!	asl a	; first multiply by	4	asl a	tax	lda >CharTable,x	sta AnimPtr	lda >CharTable+2,x	sta AnimPtr+2	lda ActorNum	; Now build the actor pointer	dec a	; Decrement cause table offsets are different	asl a	asl a	; multiply it by 4	clc	; Now add in the offset to the table	adc #MBMShotIndex	; in the actor file	jsr SetUpActorPtr	jsr CopyActorToAnim	;;   UnLink the stack frame;LoadADone	tsc	; get the stack pointer	clc	adc #LocalFrame	; subtract our local frame	tcs	; restore the stack	pointer	pld	; get the old direct page	UnLinkRTL 4	rtl	LoadObject	and #$007F	; 	dec a	; Decrement cause table offsets are different	asl a	asl a	; multiply it by 4	clc	; Now add in the offset to the table	adc #MBMObjIndex	; in the actor file	jsr SetUpActorPtr	; new code for new glib...		jsr CopyActorToAnim		brl LoadADone;; Fix tempderef so that it points to the beginning of our monster file.; this way we can load the monster file anywhere we want to;FixTempDeref	lda >CharTblHandle	sta <tempDeRef	lda >CharTblHandle+2	sta <tempDeRef+2; NOTE: Since I am calling load segment this is no longer a handle!;	lda [tempDeref];	tax;	ldy #2;	lda [tempDeref],y;	sta <tempDeRef+2;	stx <tempDeref	rts	; Added this routine to make the code a little smaller for us!; since it is called 3 times aboveCopyActorToAnim	ldy #CEndOfVars-1	; Now to copy over the whole damn table!@CopyLoop	lda [ActorPtr],y	; load the data from the actor record	sta [AnimPtr],y	; save it locally	iny	iny	cpy #CColInfo-1 ; are we done yet????	blt @CopyLoop	rts;SetUpActorPtr; Enter this routine with an offset into the monster tables at the head of the monster segment; and it will set ActorPtr to point to the apropriate data for the thing!	pha	; save the actor number	jsr FixTempDeref	; set tempDeref to the head of the monster segment	pla	; recover the offset into <A>	clc	adc <tempDeref	sta TempDeRef	bcc @1	inc TempDeref+2@1	ldy #2	lda [TempDeRef],y	; we hard code the address of this thing!	sta ActorPtr+2	lda [TempDeref]	sta ActorPtr	rts	; and return	EndP	EJECT********************************************************************************LoadSpecActor	Proc Export	ProcHdr 'LoadSpecActor'** Description:	This routine is similar to loadAChar except that instead *	of loading a standard monster record it will load monster*	data directly from a pointer that is passed.*** Inputs:	Passed on Stack*      	| Actor #	|*       	| Actor # >>16	|*       	| AnimRec	|*      	| Ret Addr	|*       	| Ret   | <---SP** Outputs:	None** External Refs:** Entry Points:********************************************************************************	With Globals	With ConstantsLocalFrame	equ $10	; number of bytes of local storageTempDeRef	equ $01	; area for dereferencing@unused1	equ TempDeRef+4AnimPtr	equ @unused1+4TempInt	equ AnimPtr+2SavedDPage	equ LocalFrame+1	; address of our direct pageRetAddr	equ SavedDPage+2	; return addressAnimRec	equ RetAddr+3	; Number of Pallet to loadActorPtr	equ AnimRec+2	; changed to accomodate long sized parm;; Set up the stack frame for our routine to use;		phd	; save the direct page	tsc	; get the stack pointer	sec	sbc #LocalFrame	; subtract the local frame size	tcd	; make it the Direct page register	tcs	; also use it as a stack pointer	lda AnimRec	; set up the pointer to our anim record	asl a	; first multiply by	4	asl a	tax	lda >CharTable,x	sta AnimPtr	lda >CharTable+2,x	sta AnimPtr+2;; 5/5/90	Mensch; Modified to not destroy the final collision rect info in the record!	ldy #CEndOfVars-1	; Now to copy over the whole damn table!LAA0010	lda [ActorPtr],y	; load the data from the actor record	sta [AnimPtr],y	; save it locally	iny	iny	cpy #CCoLInfo-1 	; are we done yet????	blt LAA0010;;   UnLink the stack frame;LoadADone	tsc	; get the stack pointer	clc	adc #LocalFrame	; subtract our local frame	tcs	; restore the stack	pointer	pld	; get the old direct page	UnLinkRTL 6	; yank 6 bytes of passed parameters		rtl	EndP	End