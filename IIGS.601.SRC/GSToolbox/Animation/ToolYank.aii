******************************************************************************** ToolYank.aii** (C)  Copyright Apple Computer, Inc. 1990* All rights reserved.** by Jim Mensch** This file contains all the tool end yanks for the animation tool set** Files:**** Modification History:*********************************************************************************RTLW1	equ 1RTLW2	equ RTLW1+2RTLW3	equ RTLW2+2	MACRO	YankeeMover	pld	plb	; always yank off the proper data stuff		lda RTLW3,s	; now move the return addresses down	sta RTLW3+YankSize,s	lda RTLW2,s	; now move the return addresses down	sta RTLW2+YankSize,s	lda RTLW1,s	; now move the return addresses down	sta RTLW1+YankSize,s	ENDM		MACRO	YankeeAdjuster	tsc	; now adjust the stack pointer..	clc	; its 9 cycles Not effective for less than 6 bytes	adc #YankSize	tcs	ENDM		Macro	YankeeEndr	txa	; move the error code	cmp #1	rtl	ENDM	Yank12	proc Export	Export Yank12ErrYankSize	equ 12	ldx #0	; signal no errorYank12Err	YankeeMover	YankeeAdjuster	YankeeEndr	EndP	Yank10	proc Export	Export Yank10ErrYankSize	equ 10	ldx #0	; signal no errorYank10Err	YankeeMover	YankeeAdjuster	YankeeEndr	EndP	Yank8	proc Export	Export Yank8ErrYankSize	equ $8	ldx #0	; signal no errorYank8Err	YankeeMover	YankeeAdjuster	YankeeEndr	EndP	Yank6	proc Export	Export Yank6ErrYankSize	equ 6	ldx #0	; signal no errorYank6Err	YankeeMover	YankeeAdjuster	YankeeEndr	EndP	Yank4	proc Export	Export Yank4ErrYankSize	equ 4	ldx #0	; signal no errorYank4Err	YankeeMover	pla	pla	YankeeEndr	EndP	Yank2	proc Export	Export Yank2ErrYankSize	equ 2	ldx #0	; signal no errorYank2Err	YankeeMover	pla	YankeeEndr	EndP	Yank0	proc Export	Export Yank0ErrYankSize	equ 0	pld	plb	; always yank off the proper data stuff	lda #0	clc	rtlYank0Err	pld	plb	; always yank off the proper data stuff	YankeeEndr	EndP		END