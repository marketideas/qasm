	title 'Menu Mgr Patch        GS ROM 3 Patch'********************************************************************	Menu manager patches for ROM 3** System Disk 5.0*** 21 May 89	Steven Glass** The picture control defproc was not doing the right thing.* on dispose.  Any picture loaded from a resource was not* released.** 31 May 89	Harry Yee** Take out prototype bit in version number.** 31 Aug 89	Harry Yee** Fix static text control bug (BRC #51450) Init routine was not* copying the justification field into the control record. ** 26-Nov-90	Dave Lyons** Rolled version to $8303.* Changed CMUnloadSegments to BRK (used on ROM 1 only).* NewControl patch: See if CreateList is creating a list control.*   If it is, replace the ROM defproc $FCF0E9 with the real one, as*   returned from GetListDefProc.** 4-Jan-91	Dave Lyons** Removed my obsolete NewControl patch (was used when CreateList* calls NewControl from ROM, but I've discarded the ROM 3 List* Manager).** Patched Draw message to scroll bar defproc (old and extended)* to check for a default color table and change it to my new one,* which gets modified at CtlNewRes time based on the MasterSCB.** Patched CtlNewRes to modify the new default scroll bar color* table.** Patched NewValue message to scroll bar defproc (old and* extended) so it waits until it's been minScrollTicks ticks* since the last time we set a scroll bar value--this maxes* out the scrolling speed at something reasonable, even if* folks have souped-up machines.** 6-Jan-91	Dave Lyons** Changed scroll bar delay thing to use WaitUntil (misc tools).** 9-Jan-91	Dave Lyons** Patched HiliteControl(xxx,0) so unhiliting the most-recently-* hilited control waits until it's been 4 ticks since the hilite,* using WaitUntil.** 19-Jan-91	Dave Lyons** Added three new function (linked in from TOOL016):*   $3903 FindRadioButton*   $3A03 SetLETextByID*   $3B03 GetLETextByID** 5-Apr-91	Dave Lyons** Link in the whole StatTextProc from Control Manager; kill the* weird patching stuff.  (New feature in the RAM-based StatTextProc* is the draw-fast bit.)** 8-Apr-91	Dave Lyons** Added a missing BRA NotThisOne from LLToolboxVector.  Was making* picture controls crash.** 16-Apr-91	Dave Lyons** Patched SendEventToCtl to ignore invisible controls.** 22-Aug-91	Dave Lyons** Patched MakeNextCtlTarget to allow cycling backwards.** 15-Sep-91	Dave Lyons** Pull in new CMLoadResource from ControlMgr.  New version* sets SysPrefs to prompt for disk & never have a cancel button.** 4-Dec-91	Dave Lyons** CMLoadResource now clears the supress-one-button-dialogs SysPrefs* bit, so the OS doesn't infinite-loop looking for the disk (imported* from Tool016).** 8-Dec-91	Dave Lyons** Fixed LLToolboxVector to use linked-in RAM-based scroll_proc for* all scroll bar stuff, instead of special-casing everything...this* was becoming far too much of a pain.** 9-Dec-91	Dave Lyons** CtlNewRes calls ComputeScrollColor in ControlMgr:ControlMgr.asm.* This cool new code calls RefreshDesktop if the scroll pattern* changes.** 15-Jan-92	Dave Lyons** Linked in CtlShutDown from ControlMgr:ControlMgr.asm, so we can* remove the refreshDeskTask from the Run Queue.** 5-Feb-92	Dave Lyons** Version $0303 for 6.0 final.********************************************************************* 3-Jun-92	Dave Lyons** Changed version to $8304 for 6.0.1d5.** Made CtlStartUp remove the RefreshDesktop run queue routine, to* avoid redrawing everything once when starting an application in* a different resolution.** 15-Jul-92	Dave Lyons** Suck in new calls from ControlMgr.asm:*   SetCtlValueByID*   GetCtlValueByID*   InvalOneCtlByID*   HiliteCtlByID** 2-Apr-93 DAL** Version $0304 for 6.0.1****************************************************************************************************************************************			   **              Copyright Apple Computer, Inc. 1989-92	   **                     All Rights Reserved	   **			   *****************************************************************	Blanks off	String asis		include 'all.macros'	include ':::ControlMgr:equates.asm'	include ':::ControlMgr:superEquates.asm'	include ':::sys.equs.asm'CtlVersionNum	equ $0304	;2-Apr-93 DAL;-----------------------------------------------------------;; Stack Fram Equates for control;	DefineStackOrigD	WORD	; caller's saved direct page registerOrigB	byte	; caller's saved data bank registerTheCtlPtr	LONG	; pointer to control recordRtnAddr	block 3	; RTL address back to Control ManagertheCtlHandle	LONG	; handle to control recordCtlParam	LONG	; add'l parameter passed to DefProcCtlCode	WORD	; operation to performReturnValue	LONG	; space for return value to Ctl Mgr.;====================================================================;;          Control Manager Function Table.;;====================================================================ControlCallTable	PROC EXPORT	import CtlVersion	import CtlBootInit	import NewControl2	import CtlNewRes		;4-Jan-91 DAL	import CtlStartUp		;4-Jan-91 DAL	import HiliteControl	;9-Jan-91 DAL	import FindRadioButton	;19-Jan-91 DAL	import SetLETextByID	;19-Jan-91 DAL	import GetLETextByID	;19-Jan-91 DAL	import SendEventToCtl	;16-Apr-91 DAL	import MakeNextControlActive	;22-Aug-91 DAL	import CMLoadResource	;15-Sep-91 DAL	import CtlShutDown		;15-Jan-92 DAL	import SetCtlValueByID	;15-Jul-92 DAL	import GetCtlValueByID	;15-Jul-92 DAL	import InvalOneCtlByID	;15-Jul-92 DAL	import HiliteCtlByID	;15-Jul-92 DALFPT	DC.L (ENDFPT-FPT)/4	DC.L CtlBootInit-1			;1	DC.L CtlStartup-1			;2	DC.L CtlShutDown-1			;3 (patched 15-Jan-92 DAL)	DC.L CtlVersion-1			;4	DC.L 0	; CtlReset-1		;Shutdown, called from WindShutDown.	DC.L 0	; CtlStatus-1		;6	DC.L 0	; Reserved-1		;7	DC.L 0	; Reserved-1		;8	DC.L 0	; NewControl-1		;9	DC.L 0	; DisposeControl-1		;A	DC.L 0	; KillControls-1		;B	DC.L 0	; SetCtlTitle-1		;C	DC.L 0	; GetCtlTitle-1		;D	DC.L 0	; HideControl-1		;E	DC.L 0	; ShowControl-1		;F	DC.L 0	; DrawControls-1		;10	DC.L HiliteControl-1		;11 patched 9-Jan-91 DAL	DC.L CtlNewRes-1			;12	DC.L 0	; FindControl-1		;13	DC.L 0	; TestControl-1		;14	DC.L 0	; TrackControl-1		;15	DC.L 0	; MoveControl-1		;16	DC.L 0	; DragControl-1		;17	DC.L 0	; SetCtlIcons-1		;18	DC.L 0	; SetCtlValue-1		;19	DC.L 0	; GetCtlValue-1		;1A	DC.L 0	; SetCtlParam-1		;1B	DC.L 0	; GetCtlParam-1		;1C	DC.L 0	; WindDragRect-1		;Address may be patched by CtlStartup.	DC.L 0	; GrowSize-1		;1E	DC.L 0	; GetCtlzpage-1		;1F	DC.L 0	; SetCtlAction-1		;20	DC.L 0	; GetCtlAction-1		;21	DC.L 0	; SetCtlRefCon-1		;22	DC.L 0	; GetCtlRefCon-1		;23	DC.L 0	; EraseControl-1		;24	DC.L 0	; DrawOneCtl-1		;25	DC.L 0	; FindActiveControl-1	;$26	DC.L MakeNextControlActive-1		;$27 patched 22-Aug-91 DAL	DC.L 0	; MakeThisCtlActive-1	;$28	DC.L SendEventToCtl-1		;$29 patched 16-Apr-91 DAL	DC.L 0	; GetCtlID-1		;$2A	DC.L 0	; SetCtlID-1		;$2B	DC.L 0	; CallDefProc-1		;$2C  (added oct 3 88)	DC.L 0	; NotifyControls-1		;$2D  (added oct 3 88)	DC.L 0	; GetCtlMoreFlags-1		;$2E	DC.L 0	; SetCtlMoreFlags-1		;$2F	DC.L 0	; GetHandleFromID-1		;$30	DC.L NewControl2-1	;		;$31	DC.L CMLoadResource-1 		;$32 patched 15-Sep-91 DAL	DC.L 0	; CMReleaseResource-1	;$33  (added Oct 12 88)	DC.L 0	; SetCtlParamPtr-1		;$34  (added Oct 21 88)	DC.L 0	; GetCtlParamPtr-1		;$35  (added Oct 21 88)	DC.L 0	; FutzCtls-1		;$36  (added Mar 28 89)	DC.L 0	; InvalCtls-1		;$37  (added Nov 9 88)	DC.L $fc0001-1	; CMUnloadSegments-1	;$38  (unused on ROM 3; make it BRK. DAL)*** 6.0	dc.l FindRadioButton-1		;$39 added 19-Jan-91 DAL for 6.0	dc.l SetLETextByID-1		;$3A added 19-Jan-91 DAL	dc.l GetLETextByID-1		;$3B added 19-Jan-91 DAL*** 6.0.1	dc.l SetCtlValueByID-1	;$3C added 15-Jul-92 DAL	dc.l GetCtlValueByID-1	;$3D added 15-Jul-92 DAL	dc.l InvalOneCtlByID-1	;$3E added 15-Jul-92 DAL	dc.l HiliteCtlByID-1	;$3F added 15-Jul-92 DALENDFPT	ENDPCtlVersion	PROC	lda #CtlVersionNum	sta 7,s	ENTRY QuickExitQuickExit	lda #0	clc	rtl	ENDP********************************************************************************* CtlStartUp patch 4-Jan-91 DAL** Modify the new default scroll bar color table based on the MasterSCB, and* then go to the old CtlStartUp code in ROM.********************************************************************************CtlStartUp	proc export	import ComputeScrollColor,RemoveRefreshTask*** added 9-Dec-91 DAL	pha	phy	jsr ComputeScrollColor	jsl RemoveRefreshTask	;3-Jun-92 DAL	ply	pla*** end 9-Dec-91 DAL@toRom	jml $fd9100	;original CtlStartUp entry point	EndP********************************************************************************* HiliteControl patch 9-Jan-91 DAL** Call WaitUntil to wait 4 ticks since the last hilite, if we're hiliting* the most-recently-hilited control to 0.********************************************************************************HiliteControl	proc export	pha	phycontrol	equ 11newState	equ control+4	ldx #0	;anticipate using 0 for DelayAmount	lda control+2,s	cmp >prevControl+2	bne @different	lda control,s	cmp >prevControl	bne @different	lda newState,s	bne @notZero	ldx #$0040	;delay amount@notZero@different	lda control+2,s	sta >prevControl+2	lda control,s	sta >prevControl	pha	;result space	lda >anchorTime	pha	phx	;delay amount	_WaitUntil	pla	sta >anchorTime@toROM	ply	pla	jml $fd94aa	;HiliteControl entry in ROM 3prevControl	dc.l 0anchorTime	dc.w 1	EndP********************************************************************************* CtlNewRes patch 4-Jan-91 DAL** Modify the new default scroll bar color table based on the MasterSCB, and* then go to the old CtlNewRes code in ROM.********************************************************************************CtlNewRes	proc export	import ComputeScrollColor*** added 9-Dec-91 DAL	phy	pha	jsr ComputeScrollColor	pla	ply*** end 9-Dec-91 DAL@toRom	jml $fd91d6	;original CtlNewRes entry point	EndP*****************************************************************SendEventToCtl	PROC EXPORT** This call is used to send events to the active control and to* any *visible* control including the active control.** If the ActiveOnly flag is TRUE, then only the active control* gets the event.** If the Active flag is FALSE, then the following takes place.* We perform a two part search for a control to take this event.* First, we look for controls that want key strokes that are * not edit fields.  Each control is asked to take the event.* If none of these controls wants hte event, the active* edit field is asked to accept the event.** If no control accepts the event, the output is FALSE.  If * one of the controls accepts the event, the output is TRUE.* The handle of the accepting control is put into TaskDATA2 and* the ItemID is put in TaskDATA3.*** Inputs:*	ActiveOnlyFlag*	WindowPtr*	TaskRecPtr** Outputs:*	BooleanWord** External Refs:	import CMStartup;	import UseThisWindPtr;	import GetFirstSuperControl;	import GetNextSuperControl;	import FindActiveGuts	import CMDispatch** Entry Points:*	none*	longa on	; mode	longi on** Change History** 04 Nov 88	Steven Glass** The control ID was returned in the wrong place and the* result from the DefPRoc was not returned at all.** 17 Nov 88	Steven Glass** Now use the specified window pointer instead of FrontWindow.*****************************************************************	macro&lab	jsrlFD &addr&lab	phk	per @returnHere-1	pea $0392-1	;there is an RTL at $FD/0392 in ROM 3	jml $FD0000+&addr@returnHere	mendTaskRecPtr	equ InputsWindowPtr	equ TaskRecPtr+4ActiveOnlyFlag	equ WindowPtr+4BooleanResult	equ ActiveOnlyFlag+2	jsr CMStartup	stz BooleanResult		; assume the worst	lda WindowPtr	ldx WindowPtr+2;	jsr UseThisWindPtr	jsrlFD $bbbe		;UseThisWindPtr is $FD/BBBE	bcs exit	lda ActiveOnlyFlag	bne TryActive;	jsr GetFirstSuperControl	jsrlFD $BB9C		;GetFirstSuperControl is $FD/BB9C	bcs exitLoop	ldy #NewCtlRecord.CtlMoreFlags	; if this one can be active, skip it for now	lda [<CtlPtr],y	and #FCtlCanBeActive	bne SkipThisOne	lda [<CtlPtr],y	; if the control does not want events, then	and #FCtlWantEvents	; we skip it.	beq SkipThisOne*** 16-Apr-91 DAL -- if the control is invisible, ignore it	ldy #NewCtlRecord.ctlFlag	lda [<CtlPtr],y	and #$0080	bne SkipThisOne*** end of 16-Apr-91 DAL	jsr SendIt	lda BooleanResult	bne FinishUpSkipThisOne;	jsr GetNextSuperControl	jsrlFD $BBA6		;GetNextSuperControl is $FD/BBA6	bcc LoopTryActive;	jsr FindActiveGuts	jsrlFD $BBE3		;FindActiveGuts is $FD/BBE3	bcs Done	jsr SendIt	lda BooleanResult	beq DoneFinishUp	jml $FDBA6C		;FinishUp in ROMDone	jml $FDBA94		;Done in ROMExit	jml $FDBA97		;Exit in ROMSendIt	jsrlFD $BA9A		;SendIt is $FD/BA9A	rts	ENDP	title 'MakeNextControlActive'*****************************************************************MakeNextControlActive PROC EXPORT** This routine returns the handle to the newly activated* super control.  A number of errors can be returned:**   NOWIND_Err*   NoCtlError*   NoSuperCtlError*   NoCtlToBeActiveError** The newly activated control and the newly deactivated* control are both sent activation messages so that* they can change their display.** This routine has the strange ability to return the* same control as was originally active.  When this* happens, no activation messages are sent.** Note:  This call only works on the front window.** Inputs:*	none** Outputs:*	ControlHandle** External Refs:	import CMStartup;	import FindActiveGuts2;	import GetFirstSuperControl;	import GetNextSuperControl;	import CallIt;	import CMDispatch** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************ResultH	equ Inputs	jsr CMStartup		; link things in and start things up.	stz work		; indicate that this is the first time in	stz ResultH	stz ResultH+2;;;	jsr FindActiveGuts2		; get first active control in  	jsrlFD $BBDE		;(ROM 3)	bcc GotActive		; front window.	PushLong #0		; nothing active, put 0 on stack	jml >$fdb965		;TryFirst in ROM 3GotActive	pei CtlHand+2		; this is the control that needs to	pei CtlHand		; be made inactive	ldy #NewCtlRecord.CtlMoreFlags	; Clear current active bit	lda [<CtlPtr],y	and #($FFFF-FCtlActive)	sta [<CtlPtr],y*** added 22-Aug-91 DAL -- check for Command key to cycle backwards	lda >$E0C025	and #$0080	beq @cycleForward; Find previous super control.; <Work is the starting point.  If we get back there we're done.; <Work+4 is the control we visited last, the one we want to make active.	lda <ctlHand+2	ldx <ctlHand	sta <work+2	stx <work@keepAndSearch	lda <ctlHand+2		;this one would be okay, so remember it	ldx <ctlHand	sta <work+6	stx <work+4@search;;;	jsr GetNextSuperControl	jsrlFD $bba6		;FDBBA6 is GetNextSuperControl (ROM 3)	bcc @gotOne;;;	jsr GetFirstSuperControl	jsrlFD $bb9c		;FDBB9C is GetFirstSuperControl (ROM 3)@gotOne	ldy #NewCtlRecord.CtlMoreFlags	; can this be active?	lda [<CtlPtr],y	and #FCtlCanBeActive	beq @search		; no, go on	ldy #NewCtlRecord.CtlFlag	; check if its visible or not	lda [<CtlPtr],y	bit #$0080	bne @search		; no, go on	lda <ctlHand+2		;are we back where we started yet?	ldx <ctlHand	cmp <work+2	bne @keepAndSearch	cpx <work	bne @keepAndSearch	lda <work+6	ldx <work+4	sta <ctlHand+2	stx <ctlHand	ldy #2	lda [<ctlHand],y	sta <ctlPtr+2	lda [<ctlHand]	sta <ctlPtr	jml >$fdb948		;useThisControl@cycleForward	jml >$fdb92f		;ROM 3	EndP	EJECT********************************************************************************NewControl2	PROC** Description:	Patch to set the grafport to the owners port field.*** Inputs:	Same as newcontrol2** Outputs:	exit via ROM** External Refs:	import CMStartup** Entry Points:********************************************************************************** Variables used by NewControl2 and subroutines.***********************************************************************	DSECT InputsInputRef	long		;these are passed to us on the stackInputVerb	wordTheWindow	longResultH	longTemplatePtr	equ yRat	; this is not used at init time.***********************************************************************************BackToROM	equ $FDB62E	jsr  CMStartup		;link things in and start things up.;; Always set port to owner port! Mensch**	lda TheWindow+2**	pha**	lda TheWindow**	pha	pei TheWindow+2	;changed lda/pha to pei  26-Nov-90 DAL	pei TheWindow	;changed lda/pha to pei  26-Nov-90 DAL	_SetPort	jml >BackToROM	EndP;====================================================================;          Do setup	for tool call.;;   IN:    a+y = handle to data area.;;  OUT:    Carry clear if no error.;          Carry set if null data pointer, y = error code.;;150=================================================================CMstartup	proc EXPORT	plx	Get return address.;	phd	Save caller's direct page.	phb	Save caller's data page.;	phy	Save pointer to data area.	pha;	phx;	pha	Space for result.	pha	_GetPort	pla	ply	plx	Get return addess.	phy	Save caller's port on stack.	pha;	tsc	Allocate direct page on stack.	sec	sbc #DIRECTSIZE	tcs	tcd;	phx	Put return address back on stack.;	lda <data	Valid data area pointer passed.	ora <data+2	clc	Clear error flag.	bne exit;	pea $1002	Control Manager not	started.;;;	pea notInit>>16	Pass message.;;;	pea notInit*** 8-Dec-91 DAL	pea $00FD	;$FD/A048 is "Control Manager not initialized, error $"	pea $A048*** end 8-Dec-91	_SysFailMgr*** 8-Dec-91 DAL -- This message is already in ROM, so let's save some bytes;;;notInit	DC.B 40;;;	DC.B 'Control Manager not initialized, error $'*** end 8-Dec-91exit	rts	EndP*****************************************************************CtlBootInit	PROC** This replaces the LLToolboxVector vector with an address of* our own.*** Inputs:*	none** Outputs:*	none** External Refs:	import MyLLToolboxVector	import OrigLLToolboxVector** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	lda >LLToolboxVector	sta >OrigLLToolboxVector	lda >LLToolboxVector+2	sta >OrigLLToolboxVector+2	lda #MyLLToolboxVector	sta >LLToolboxVector+1	lda #>MyLLToolboxVector	sta >LLToolboxVector+2	brl QuickExit	ENDP*****************************************************************MyLLToolboxVector	PROC** This code looks at the message to be sent to the defProc.* if the message is a dispose, we see if it is for a picture control* and route if off differently.** (Actually we check for a bunch of other stuff now, too.  --DAL)*** Inputs:*	a, x and y have sacred values*	code is on top of stack** X = 0 for CMDispatch (dispatching a message to a control)*           (Not everything for old controls goes through here?)* X = 2 for WMActivate* X = 4 for WMDeactivate** Outputs:*	nothing may change unless we handle the*	dispatch.** External Refs:*	none** Entry Points:	ENTRY OrigLLToolboxVector*	longa on	; mode	longi on*****************************************************************	import StatTextProc		;5-Apr-91 DAL	import scroll_task_list	;8-Dec-91 DAL	jmp (LLTable,x)LLTable	dc.w isCMDispatch	dc.w OrigLLToolboxVector	dc.w OrigLLToolboxVectorisCMDispatch;; Now check the message and see if it's the ones we want to trap.;	pha	; save a-reg*** added 5-Apr-91 DAL -- let's use the RAM-based static text control defproc	phy	ldy #NewCtlRecord.ctlProc+2	lda [<ctlPtr],y	cmp #$8100	bne @notStatText	ply	pla	ply	;Y now has the defproc message	lda #StatTextProc	ldx #>StatTextProc;   IN:    y = task	number.;          a = bytes 0 and 1 of defProc	address.;          x = bytes 1 and 2 of defProc	address.;          param = additional parameters.	jml >$fd9c8c	;customDispatch in ROM 3@notStatText	ply*** end of 5-Apr-91 DAL*** added 8-Dec-91 DAL -- use RAM copy of scroll_proc for (nearly) all Scroll Bar operations*** (I believe everything other than the recSize messages vectors through here)	phy	ldy #NewCtlRecord.ctlProc+2	lda [<ctlPtr],y	asl a	lsr a	;clear bit 15	cmp #$0600	;$0600 or $8600 is Scroll Bar	bne @notScrollBar	ply	pla	ply	;Y now has the defproc message	lda #@my_scroll_proc	ldx #>@my_scroll_proc	jml >$fd9c8c	;customDispatch in ROM 3** my_scroll_proc -- gets called just like a custom control** stack:* 14,s = space for result* 12,s = message*  8,s = ctlParam*  4,s = theControlHandle*  1,s = RTL*@my_scroll_proc	lda 12,s	cmp #ctlWinStateChange+1	bcc @goForIt	lda #0	tax	bra @ouch@goForIt	asl a	tax	jsr (scroll_task_list,x)  ;returns value in XA@ouch	sta 14,s	txa	sta 14+2,s	lda 2,s	sta 2+10,s	lda 1,s	sta 1+10,s	;copied RTL address	pla	pla	pla	pla	pla	;stripped 10 bytes of input parameters	rtl@notScrollBar	ply*** end 8-Dec-91*** removed 8-Dec-91 DAL;	lda 3,s	; check message being sent;	bne LLnotDraw;* got Draw message;	phy;	ldy #NewCtlRecord.ctlProc+2;	lda [<ctlPtr],y;	and #$7fff;	cmp #$0600	;scroll bar?;	bne @notScroll;;	ldy #$24	;offset to color table;	lda [<ctlPtr],y;	cmp #$a4a7;	bne @notScroll;	iny;	iny;	lda [<ctlPtr],y;	cmp #$00fd;	bne @notScroll;	lda #^NewScrollColorTable;	sta [<ctlPtr],y;	dey;	dey;	lda #NewScrollColorTable;	sta [<ctlPtr],y;;@notScroll	ply;	brl NotThisOne;;	EXPORT NewScrollColorTable;NewScrollColorTable	DC.W $0000	Outline.;	DC.W $00F0	Arrow when normal.;	DC.W $00F0	Arrow when selected.;	DC.W $00F0	Arrow's box interior.;	DC.W $00F0	Thumber when normal.;	DC.W $0000	Not used and should	never be used.;*****	DC.W $010F	Page region interior.;	dc.w $00C0	Page region interior. (Gets stored over at CtlStartUp/CtlNewRes time);	DC.W $00F0	Interior color of inactive bar.;;;LLnotDraw	cmp #newValue;	bne LLnotNewValue;;;; 4-Jan-91 DAL;;;; Max out the scrolling speed to a fixed amount of time.;; If it hasn't been minScrollTime since the last time we;; moved the thumb, wait until it has.;;;	pha;	phy;	phx;	ldy #NewCtlRecord.ctlProc+2;	lda [<ctlPtr],y;	and #$7fff;	cmp #$0600	;scroll bar?;	bne @notScroll;;	pha	;space for result;	lda >lastScrollTime;	pha;	pea MinScrollDelay;	_WaitUntil;	pla;	sta >lastScrollTime;;@notScroll	plx;	ply;	pla;	brl NotThisOne;;lastScrollTime	dc.w 0*** end of removed 8-Dec-91LLnotNewValue; end of 4-Jan-91 DAL	cmp #dispCntl	; Is it the picture control bug?	beq GotDispMessage	bra NotThisOne	;GAWD, I'M STUPID!  THIS WAS MISSING ON 6.0D31.;;; dead code 5-Apr-91 DAL;	cmp #initCntl	; Is it the StatText bug?;	bne NotThisOne;;* GotInitMessage;	phy;	ldy #NewCtlRecord.ctlProc+2;	lda [ctlPtr],y;	bpl NotRightControl	; not super control, so not static text control;	;	cmp #^StatTextControl;	bne NotRightControl;	dey;	dey;	lda [ctlPtr],y;	bne NotRightControl;	lda #1;	sta 5,s	; this is now our new message code to be used later;	brl GotControl;; This is it.  See if the defProc is the picture defProc.;GotDispMessage	phy	ldy #NewCtlRecord.ctlProc+2	lda [ctlPtr],y	bpl NotRightControl	; not picture control	cmp #^PictureControl	bne NotRightControl	dey	dey	lda [ctlPtr],y	bne NotRightControl	sta 5,s	; this is now our new message code to be used later (zero)	brl GotControlNotRightControl	plyNotThisOne	plaOrigLLToolboxVector	dc.L 0;; It's a control/message that we need to patch;GotControl	ply	pla	plx	pei <Ctlhand+2	Save current handle	of control.	pei <Ctlhand;	pha	Space for return value.	pha;	phx	Pass task number(which has been changed above).;	pei <param+2	Pass additional parameters.	pei <param;	pei <Ctlhand+2	Pass control's handle.	pei <Ctlhand;	jsl DoMoreCommon	jml $FD9C9F	; back into ROM.DoMoreCommon	pha	; push on some room	for 'TheCtlPtr'	pha	phb	; save the Data Bank register	phd	; save the Direct Page register	phk	; switch data bank to program bank	plb	tsc	; switch Direct Page into stack	tcd	lda [<theCtlHandle]	; deref control handle	sta <TheCtlPtr	ldy #2	lda [<theCtlHandle],y	sta <TheCtlPtr+2;; ----- Now the stack is set up just like the defproc like it ---------------;	lda <ctlCode	; the ctlCode now is the offset to the table	asl a	; of the bug we want to fix	tax	jsr (PatchTable,x) 	sta <ReturnValue		; save the return value	stx <ReturnValue+2;; The Return Value has been stored on the stack, and it is time for us to; return back to the Control Manager. Before we do so, however, we must; remove the parameters that were passed to us on the stack. We do this; by moving the RTL address up just below the Return Value, getting the; stack pointer, and adding an amount to it so that we point to where; the RTL address has been moved to. We can then simply RTL back to the; Control Manager, and it will pick up the Return Value right off of the; stack!;	lda <RtnAddr	; move the return address up	sta <ReturnValue-3	lda <RtnAddr+1	sta <ReturnValue-2	tsc	; Get the stack pointer	pld	; restore caller's Data Bank and	plb	; Direct Page registers	clc	; Adjust the stack pointer to point to	adc #ReturnValue-4	; the new location of the RTL address.	tcs	; Put the stack pointer back.	rtl	; back to the callerPatchTable	dc.W PictBug	; picture control bug, not disposes picture resources; dead 5-Apr-91 DAL	dc.W StatTextBug	; static text bug, justification field not looked at;================================================================;; This routine fixes the picture control bug in TenSpeed ROMs.; Any picture loaded from a resource was not being released.;;================================================================PictBug	IMPORT do_dispose	jsr do_dispose	rts;;; dead code 5-Apr-91 DAL;;================================================================;;;; This routine fixes the static text control bug in TenSpeed ROMs.;; The init routine did not copy the justification field into the;; control record. BRC #51450;;;;================================================================;StatTextBug;	IMPORT do_StatInit;;	jsr do_StatInit;;	rts	ENDP*****************************************************************PushCtlData	PROC EXPORT** Utility routine used by do_dispose.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	plx	ldy #NewCtlRecord.ctlData+2	lda [TheCtlPtr],y	pha	dey	dey	lda [TheCtlPtr],y	pha	phx	rts	ENDP	END