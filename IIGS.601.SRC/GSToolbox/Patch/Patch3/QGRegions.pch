******************************************************************************** QGraf Region stuff** (C)  Copyright Apple Computer, Inc. 1991* All rights reserved.** by Jim Mensch* 2/8/91** This here stuff should greatly speed several calls by reducing the time it takes to* Seek regions. The secret is actually simple, all you gotta do is determine if all* 3 regions are rectangular, and if so, if you can get rid of 1 or more by swapping them..* I know that this sounds wierd, but trust me!** Files:**** Modification History:** Version 1.0	_Author_** 3/7/91	Added 2 region region seeking to the test as well...********************************************************************************	blanks off	string asis		include 'all.macros'	include ':::qd:qdequates:qd.data.asm'	INCLUDE ':::qd:QDEquates:CORE.GLOBALS1'	INCLUDE ':::qd:QDEquates:core.globals2'	INCLUDE ':::qd:QDEquates:region.equs'	INCLUDE ':::qd:QDEquates:RECT.EQUS'	INCLUDE ':::qd:QDEquates:SLAB.EQUS'	INCLUDE ':::qd:QDEquates:rgndefs.equs'	MACRO&lab	BumpLongBy2 &adr&lab	lda &adr	ldx &adr+2	inc a	bne @1	inx@1	inc a	bne @2	inx@2	sta &adr	stx &adr+2	MEND	MACRO&lab	MoveLong &From,&To&lab	lda &From	sta &To	lda &From+2	sta &To+2	MEND	MACRO&lab	SwapLong &From,&To&lab	ldx &From	ldy &From+2	lda &To	sta &From	lda &To+2	sta &From+2	stx &To	sty &To+2	MEND	MACRO&lab	IncLong &adr&lab	inc &adr	bne @1	inc &adr+2@1	mend;iFree3Regions	Proc Export;	Import OldFree3Regions;	Import SeekerDispatch;	;	pha;	lda  #$0000;	sta  >SeekerDispatch;	pla;	jml  OldFree3Regions;	EndP;	;iFree2Regions	Proc Export;	Import OldFree2Regions;	Import SeekerDispatch;;	pha;	lda  #$0000;	sta  >SeekerDispatch;	pla;	jml  OldFree2Regions;	EndP		iInit3Regions	PROC Export	Import OldInit2Regions	Import OldInit3Regions	Export iInit2Regions	Export SeekerDispatch		jsl OldInit3Regions	; first, do the setup code here!	stz StatePtr	; first, zero out our "Flag";---------------------------------------------------; see if we "need" to seek all these regions!, for each region we do not need to seek; set the correct bit for that region. Then the seek region code can do the rest...;	MoveLong RgnPtrA,RgnPtr	; set this up for the call	jsr  TestIt	bcc  @TryB	lda  #$0002	sta  StatePtr	@TryB	MoveLong RgnPtrB,RgnPtr	; set this up for the call	jsr  TestIt	bcc  @TryC	lda  #$0004	ora  StatePtr	sta  StatePtr@TryC	MoveLong RgnPtrC,RgnPtr	; set this up for the call	jsr  TestIt	bcc  @GotTheBugger	lda  #$0008	ora  StatePtr	sta  StatePtr@GotTheBugger	lda  StatePtr;; Now that we have our region dispatcher in StatePtr, lets just stow it in our seek3Global; and switch the regions so that they contain the proper values...	sta  >SeekerDispatch	beq  @Done	; all 3 significant, we are finished..	tax  	; table lookup the proper switcher routine	jsr  (Swappers,x)@Done	RTLiInit2Regions; do the same as above but we are only conscerned with regions a and B...	jsl OldInit2Regions	; first, do the setup code here!	lda #0	sta >SeekerDispatch		; zero means seek both regions;---------------------------------------------------; see if we "need" to seek all these regions!, for each region we do not need to seek; set the correct bit for that region. Then the seek region code can do the rest...;	MoveLong RgnPtrA,RgnPtr	; set this up for the call	jsr  TestIt	bcc  @TryB	jsr  SwapAB		; we always will be swapping these two in this case..@BNotNeeded	lda  #$FFFF		; this means seek2regions seeks 1 region	sta  >SeekerDispatch	RTL		; we can just stop here...@TryB	MoveLong RgnPtrB,RgnPtr	; set this up for the call	jsr  TestIt	bcs  @BNotNeeded	RTL		; else, don't swap and forget everything			;; here we have the swapper stuff..Swappers	dc.W NoSwap	;* all 3 regions are needed	dc.W ClipA	;* need rgn B & C	dc.W ClipB	;* need rgn A & C	dc.W ClipAB	;* need rgn C only	dc.W ClipC	;* need rgn A & B	dc.W ClipAC	;* need rgn B Only	dc.W ClipBC	;* need rgn A Only	dc.W ClipABC	;* need none of them ????NoSwap		; none of these routines need any swapping!ClipCClipBCClipABC	RTSClipAB		; we do not need A or B so move C into AClipA		; We do not need region A so swap it with C	SwapLong RgnPtrC,RgnPtrA	SwapLong ScanPtrC,ScanPtrA	SwapLong StatePtrC,StatePtrA	rtsClipB		; no need for rgnB so swap it with C	SwapLong RgnPtrC,RgnPtrB	SwapLong ScanPtrC,ScanPtrB	SwapLong StatePtrC,StatePtrB	rtsClipAC		; no need for rgnA so swap it with BSwapAB	SwapLong RgnPtrB,RgnPtrA	SwapLong ScanPtrB,ScanPtrA	SwapLong StatePtrB,StatePtrA	rtsSeekerDispatch	ds.L 1TestIt; This routine will see if the region that you are looking at is the wide open; region. If so, then set the carry.	lda  [RgnPtrA]	cmp  #$000A	; are we rectangular?	bne  @NotThisOne; so far so good now test the rectangles...	ldy  #0002	lda  [RgnPtrA],y	and  #$FFFE	; account for both wide open regions..	cmp  #$C000	bne  @NotThisOne	ldy  #0004	lda  [RgnPtrA],y	and  #$FFFE	; account for both wide open regions..	cmp  #$C000	bne  @NotThisOne	ldy  #0006	lda  [RgnPtrA],y	cmp  #$3FFF	bne  @NotThisOne	ldy  #0008	lda  [RgnPtrA],y	cmp  #$3FFF	bne  @NotThisOne	sec	rts@NotThisOne	clc	rts			ENDPiSeek3Regions	PROC Export	Export iSeek2Regions; a faster way to seek 3 of em at a time.. This routine will dispatch to the proper "Local"; region seeker...	Import SeekerDispatch	Import OldSeek3Regions	Import OldSeek2Regions		lda >SeekerDispatch	tax	jmp  (seekTable,x)SeekTable	dc.W seekum3	;* all 3 regions are needed	dc.W Seekum2	;* need rgn B & C	dc.W Seekum2	;* need rgn A & C	dc.W Seekum1	;* need rgn C only	dc.W Seekum2	;* need rgn A & B	dc.W Seekum1	;* need rgn B Only	dc.W Seekum1	;* need rgn A Only	dc.W seekum1	;* need none of them so we seek 1 (just to make it happy!)	Seekum1	jml  seek1RegionSeekum2	jml  OldSeek2RegionsSeekum3	jml  OldSeek3RegionsiSeek2Regions; This is the patch for this fine vector..	lda  >SeekerDispatch	beq  Seekum2	; zero means still seek both	jml  Seek1Region	EndP	END