****************************************************************** Patch to SANE for Version 3.0 of ROM** Copyright (C) 1993 Apple Computer, Inc. All Rights Reserved.*** System Disk 6.0.1**  6-May-93 JCM - Version $0301 for 6.0.1 final. Added the Elems patch.*****************************************************************SaneVersionNum	equ $0301ToStrip	equ $E10184	EXPORT Sane2CallTableSane2CallTable	PROC	import SaneBootInit	import SaneVersion	import ElemsPatchTheStart	DC.L (TheEnd-TheStart)/4	DC.L SaneBootInit-1	DC.L 0	; SaneStartup-1'	DC.L 0	; SaneShutdown-1'	DC.L SaneVersion-1	DC.L 0	; SaneReset-1'	DC.L 0	; SaneStatus-1'	DC.L 0	; SaneNotImp-1'	DC.L 0	; SaneNotImp-1'	DC.L 0	; Eight16-1'	DC.L 0	; DecStr-1'	DC.L ElemsPatch-1	; Elems816-1TheEnd	ENDP****************************************************************** ElemsPatch** Change History** 6-May-93 JCM - New for System Disk 6.0.1** Corrects a problem in FXPWRI where <Src_Class was being checked to* see what the integer exponent was classified as without actually having* it classified. This fixes the problem with lockups in the AWGS spreadsheet.*****************************************************************ElemsPatch	PROCElems_Code03	equ $FC375B	;Elem816 entry point in ROM 03 SANEOrigD	equ 1RTL1	equ OrigD+2RTL2	equ RTL1+3OpWord	equ RTL2+3DstArg	equ opword+2SrcArg	equ DstArg+4SourceClass	equ $6A	;on SANE DP	phd		tcd	;swap in SANE's DP		lda OpWord,s	;get opword	and #$1F	;just get the operation	cmp #$10	;is it FXPWRI?	bne @doneElemPatch	; aparently not* Assume that the integer exponent is normalized.	ldy #0	;signal normalized	lda SrcArg,s	;get the integer exponent so we can classify it	bne @saveClass	; it's already classified as normalized		dey	;signal it's zero ($FF)@saveClass	sty <SourceClass	;we overwrite Src_Sign, but it doesn't matter@doneElemPatch	tdc	;let SANE know where its DP is	pld	jmp >Elems_Code03	;let SANE do all of the dirty work	ENDP****************************************************************** SaneVersion*****************************************************************SaneVersion	PROCRTL1	equ 1RTL2	equ RTL1+3Result	equ RTL2+3	lda #SaneVersionNum	; get SANE version #	sta Result,s	; pass to caller***   v v v   fall into SaneBootInit     v v v****************************************************************** SaneBootInit*****************************************************************	entry SaneBootInitSaneBootInit	lda #0	;no error	clc	rtl	ENDP	END