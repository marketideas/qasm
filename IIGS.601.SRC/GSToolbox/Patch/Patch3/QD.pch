	title 'QD Patch        GS ROM 3 Patch'******************************************************************** QD patches for ROM 3** Copyright 1989-1992 Apple Computer, Inc.* All Rights Reserved********************************************************************* System Disk 5.0** 5/18/89	Steven Glass** 31 May 89	Harry Yee** Take prototype bit out of version number. Final version = 3.1  * for System Disk 5.0.** 03/06/90	Harry Yee** Patching SetForeColor to patch the Menu Manager. This patch adds* icon support for menu items. All we are doing is patching the return* address for the call if SetForeColor is being called by the Menu* Manager at the place we want to patch out.** 4/4/90	Mensch** Patched the 4 rgnOp routines so that they will properly unlock the* right region handles. OOOOps, guess I also speeded them up just a little* sorry for that...** 17-Sep-90	Dave Lyons** Harry's FinishSetForeColor and FinishPtInRect pathces had been* commented out.  I'm putting them back in for 6.0, since some other* files are referencing them & preventing me from building TS3.** 24-Sep-90	Dave Lyons** Version $8306.* Adding Get640Colors and Set640Color.** 22-Oct-90	Dave Lyons** Adding $DC04 GetScanlineAddr.* Put all.macros back in.** 24-Nov-90	Dave Lyons** Patched QDStartUp to call FixHandle2 (stolen from TS2 Cursor.Patch.asm)* to make the cursor images handle not cross a bank boundary.** 25-Nov-90	Dave Lyons** Changed version number to $8307, since 5.0.4 is going to be $0306.** 25-Nov-90	Dave Lyons** Changed QDStartUp to set DontClearScrnFlag if MasterSCB bit $0100* is on and the SHR screen is already being displayed.* Changed ClearScreen not to clear the screen if DontClearScrnFlag* is set.** 14-Feb-91	Dave Lyons** Removed GetScanlineAddr because it isn't useful enough.** 18-Feb-91	Dave Lyons** Re-enabled Mensch's MySetCursor patch (had been commented out* for 5.0.3 and 5.0.4).** 19-Feb-91	Dave Lyons** Fixed the ClearScreen patch to jump to ROM with the correct* WAP value in A, instead of $0000.  Oops.** 25-Feb-91	Dave Lyons** QDStartUp now deletes Message #6 (the mouse position message)* from the MessageCenter if the screen was off.  It only makes* sense to preserve the mouse position on a true smooth launch.** 11-Mar-91	Dave Lyons** Removed MySetCursor patch.** 7-Apr-91	Dave Lyons** QDShutDown now shuts down QDAux first if it's started up (this* is necessary because Standard File now starts up QD Aux).** 5-Aug-91	Dave Lyons** Resurrected SetCursor patch again.  This time it looks at bit* 31 of the new cursor pointer; if set, it doesn't undraw the* old cursor.** 26-Aug-91	Dave Lyons** QDStartUp leaves the MasterSCB $0100 (smooth launch) bit set* until the call is done, so that CloseView can see the bit* during its ClearScreen patch.** 6-Sep-91	Dave Lyons** QDShutDown now turns off linearization ($C029 bit 6) even* if it leaves the SHR screen on.  It's evil to leave linear* on, because it screws up double-hires!** 19-Nov-91	Dave Lyons** QDShutDown sets master SCB to $0080, inits color table zero,* and sets all SCBs to $0080.** QDStartUp checks bit 2 of BRAM $5F --> don't use scanline* interrupts (for better compatibility with accelerators and* VOCs).** 27-Nov-91	Dave Lyons** Patched InflateTextBuffer to return errors.** 3-Dec-91	Dave Lyons** Finished fixing above--on failure, it needs to restore a few direct page* locations, so we don't think the buffer has been inflated when it hasn't.* (Since QuickDraw Aux chains in *after* the main QD buffer-resize routines,* QD already decided it was okay to store the new buffer size values when* QD Aux found it could not resize its buffers, so we have to undo the damage.)** 3-Feb-92	Dave Lyons** Fixed QDStartUp patch to destroy message $0023 (FastFont message) if we* fail to get FastFont.  Sometimes a stale message was left around and we* tried to use somebody else's handle for FastFont (the system does not* live very long in that state).** Optimized error-exit for QDStartUp.** Fixed QDStartUp to copy the E1 screen down to the 01 screen if* we got shadowing.** 5-Feb-92	Dave Lyons** Version $0307 for 6.0 final.********************************************************************* 17-Feb-92	Dave Lyons** Version $8308 for 6.0.1d1.** 2-Apr-93 DAL** Version $0308 for 6.0.1.*******************************************************************	Blanks off	String asis	include 'all.macros'	include ':::qd:qdequates:qd.data.asm'	INCLUDE ':::qd:QDEquates:CORE.GLOBALS1'	INCLUDE ':::qd:QDEquates:core.globals2'	INCLUDE ':::qd:QDEquates:region.equs'	INCLUDE ':::qd:QDEquates:RECT.EQUS'	INCLUDE ':::qd:QDEquates:SLAB.EQUS'	INCLUDE ':::qd:QDEquates:rgndefs.equs'	include 'e16.memory'	Import iDrawCursor	Import iunDrawCursor	Entry DoRgnOp*******************************************************************************;; Following are all ROM addresses needed by this file;QDStart	equ $FE0FAARgnBEmpty	equ $FE75FERgnAEmpty	equ $FE75E7RgnSector	equ $FE7615TheROMRTL	equ $FE0125	; address of an RTL in ROM 1BusyErr12	equ $FEFC74BusyEC12	equ $FEFC71ROMNotEasy	equ $FE7766BusyFlag	equ $E100FF	MACRO&lab	ROMCALL &where&lab	phk	pea @1-1	pea |TheROMRTL-1	jml &where@1	MENDSlabCopy	equ $00FE24D0SLABOR	equ $00FE2568SLABXOR	equ $00FE25F6SLABBIC	equ $00FE2684FASTSLABXOR	equ $00FE2721  FASTSLABCOPY	equ $00FE2A26  FASTSLABOR	equ $00FE2C90  FASTSLABBIC	equ $00FE2D09  GOREALLYFASTXOR	EQU $FE2796FastSlabXorAlt	equ $FE2742GOREALLYFASTCOPY	EQU $FE2A9FFastSlabCopyAlt	equ $FE2A47ROMFastBigLoop	equ $FE9171ROMSlowBigLoop	equ $FE9233ROMSetStuffAdr	equ $FE92E0ROMConTable320	equ $FE6372ROMConTable640	equ $FE6772		import iSetStuffAdr	import iBlowItUp***	import DoADirtyDeed		; from FontMgr.Pch** re-enabled these 2 lines 17-Sep-90 DAL	import DoADirtyDeed2	; from MenuMgr.Pch	import DoADirtyDeed3	; from MenuMgr.Pch	MACRO&lab	Patch &name&lab	lda #<i&name	sta |&name+1	lda #>i&name	sta |&name+2	MEND	MACRO&Lab	TablePatch &RtnName,&CallNum&Lab	ldy #&CallNum*4	lda #&RtnName-1	sta [LocalTemp],y	iny	iny	lda #^&RtnName	sta [LocalTemp],y	MEND	macro	SwapMask; This macro will test to see if the mask needs to be swapped and it will do so if ; it needs it. 	lda <StartWord	; get the starting word number	and #$0002	; see if its an odd word or even word	beq @NoSwapNeeded	; if zero, don't swap	ldx <DrawMask	lda <DrawMask+2	sta <DrawMask	stx <DrawMask+2@NoSwapNeeded		; now continue	ENDM		EJECT********************************************************************************MyStartup	PROC Export** Description:	This routine will post patch qdstartup so we can get rid of the*	fastfont if needed...*** Inputs:	same as QDStartup.** Outputs:	None********************************************************************************ROMQDStartup	equ $FE0BB5SystemFont	equ $FCDD1B	Export AnRTLOrigDirect	equ 1RTL1	equ OrigDirect+2RTL2	equ RTL1+3TheUserID	equ RTL2+3TheMaxWidth	equ TheUserID+2TheMasterSCB	equ TheMaxWidth+2PtrToZP	equ TheMasterSCB+2; New MasterSCB Equates we can useUseShadow	equ $8000HiddenSpeed	equ $4000***Avail1	equ $2000NoFastFont	equ $1000dontKillScreen	equ $0100	;25-Nov-90 DAL: Keep screen intact if already on	import DontClearScrnFlag	;from ClearScreen patch	tax	;save old WAP (24-Nov-90 DAL)	phd	; save the dpage from harm	tsc	tcd***	lda TheMasterSCB***	and #NoFastFont***	bne @MustFudgeFastFont***	tdc	; added 24-Nov-90 DAL so we get alreadyStarted error***	pld	; recover old user dpage ***	jml >ROMQDStartup	; and simply jump into ROM****** @MustFudgeFastFont*** ; If we get here then the programmer set bit saying not to load fast font*** ; and we better call qdstartup and then unload the thing...*** added 25-Nov-90 DAL to avoid clearing screen if we can	lda <TheMasterSCB	and #dontKillScreen	sta >DontClearScrnFlag	lda >$E0C029	and #$0080	bne @1	sta >DontClearScrnFlag*** added 25-Feb-91 DAL: If the screen was off, kill the Event Manager mouse pos message	phx	pea 3	;delete message	pea 6	;message type	pha	pha	;handle (ignored)	_MessageCenter	plx*** end of 25-Feb-91 DAL@1;;;	lda #dontKillScreen	;removed 26-Aug-91 DAL;;;	trb <TheMasterSCB	;removed 26-Aug-91 DAL*** end of 25-Nov-90 DAL	pei PtrToZP	pei TheMasterSCB	pei TheMaxWidth	pei TheUserID***	lda #0	txa	;retrieve old WAP (24-Nov-90 DAL)	jsl ROMStartupGlue	; call the real startup routine	bcc @ItsOK	pha	;25-Nov-90 DAL (4 lines)	lda #0	sta >DontClearScrnFlag	pla@QDSTartError	tax	; save the error code..@UnZipThiscall	;	tsc;	tcd	; set up the proper dpage again...;	lda RTL1+4	; move everything down by 8 bytes;	sta RTL1+4+8;	lda RTL1+2	; move everything down by 8 bytes;	sta RTL1+2+8;	lda RTL1	; move everything down by 8 bytes;	sta RTL1+8;	pld	; restore the old dpage..;	pla	; yank off the 8 bytes of parameter;	pla;	pla;	pla;	txa	; recover any error code;	cmp #1	; set the carry if error;	rtl	; and return*** opt 3-Feb-92 DAL -- save bytes by using ToStrip	pld	ldy #8	jml $e10184	;ToStrip*** end 3-Feb-92@CallDone	ldx #0	bra @UnZipThisCall;@ItsOK*** added 3-Feb-92 DAL -- kill the FastFont message if we no longer have FastFont	pha	pha	_GetSysFont	pla	pla	bmi @haveFF	pea 3	;delete	pea $0023	;message type	phx	phx	;ignored	_MessageCenter@haveFF	pha	_GetMasterSCB	pla	bpl @noShadow*** copy E1 screen down to 01 screen if we got shadowing	ldx #$2000	pea $00e1	phx	;src = $e1/2000	pea $0001	phx	;dest = $01/2000	pea 0	pea $7d00	_BlockMove@noShadow*** end 3-Feb-92*** added 26-Aug-91 DAL -- clear MasterSCB $0100 here	pha	_GetMasterSCB	pla	and #$FEFF	pha	_SetMasterSCB*** end 26-Aug-91 DAL*** 24-Nov-90 DAL: call FixHandle2 to make the cursor image handle safe	phd	lda <PtrToZP	tcd	jsl FixHandle2	pld*** end 24-Nov-90*** added 19-Nov-91 DAL -- check BRAM to disable scanline interrupt use	pha	pea $005F	_ReadBParam	pla	and #$0004	;bit 2 = no scanline ints	beq @normal	pea 0	_SetIntUse@normal*** end 19-Nov-91	lda <TheMasterSCB	;added 24-Nov-90 DAL	and #NoFastFont	;added 24-Nov-90 DAL	beq @toCallDone	;added 24-Nov-90 DAL	lda PtrToZP	; use quickdraw's dpage here	tcd	ldx #512	; first see if we have a fast font	lda FastROMFont,x	ora FastRomFont+2,x	beq @toCallDone	; if zero fast font not loaded		pea 2	; now set the fastfont as purgable...	lda FastROMFont+2,x	and #$00FF	; strip any flag data	pha	lda FastRomFont,x	pha	_SetPurge	; this way if by chance it is still needed...		ldx #512	; first see if we have a fast font	lda #0	; now signal that the fast rom font is not here	sta FastROMFont,x	sta FastRomFont+2,x	; reset the current system font so that it does not think it's the fastfont.		pea $00FC	pea $DD1B	pea $00FC	pea $DD1B	_SetSysFont	_SetFont@toCallDone	brl @CallDone	; and end the call with no problemsROMStartupGlue	jsl >ROMQDStartupAnRTL	rtl	***************************************************************** FixHandle2: Stolen from Patch2:Cursor.patch.asm 24-Nov-90 DAL****************************************************************** FixHandle** Added to Patch 22	May 87** The cursor save area is the area of the screen under the* cursor.  It is put into a buffer just	before the cursor* is drawn.** Unfortunately if the save buffer crosses a bank boundry,* the code to write	into does not work and ends up* trashing bytes at	the bottom of the bank the buffer* starts in.** This patch fixes the problem by working after the QDStartup* call is complete.	 It looks on the QD	direct page for the* handle to the save area and replaces it with a new handle* having attributes	which do not allow it to cross a bank.** 26 Feb 89	Steven Glass** PHD at start.  PLD at end.****************************************************************FixHandle2	PROC EXPORTSaveHandle	equ $b0	phd	tdc	; assume we enter with direct page	clc	; set to quickdraw	adc #$100	tcd	pha	; space for new handle below	pha	pha	; get the size of the current	pha	; handle	pei SaveHandle+2	pei SaveHandle	_GetHandleSize	pei SaveHandle+2	; dispose of the current handle	pei SaveHandle	_DisposeHandle	tdc	; at this point the	space for the	sec	; handle and the size of the	sbc #$100	; handle are on the	stack.  Now I	tax	; add the user id and the attributes	lda >UserID,x	pha	PushWord #%1000000000010000 ; locked, no bank cross	pha	; finally the location info which is	pha	; ignored	_NewHandle	pla	sta SaveHandle	pla	sta SaveHandle+2	pha	pha	_GetCursorAdr	_SetCursor	pld	rtl	ENDP******************************************************************* ClearScreen patch 25-Nov-90 DAL** If DontClearScrnFlag is set, clear it and don't do* anything.  Otherwise jump to ROM.******************************************************************MyClearScreen	proc export	tax	;added 19-Feb-91 DAL	lda >DontClearScrnFlag	beq @toROM	lda #0	sta >DontClearScrnFlag	tax	ldy #2	jml $e10184	;ToStrip@toROM	txa	;added 19-Feb-91 DAL	jml $fe16d8	entry DontClearScrnFlagDontClearScrnFlag	dc.w 0	endp******************************************************************* QDShutDown patch 25-Nov-90 DAL** If Master SCB bit $0100 is set, then we leave the screen* turned on.*MyQDShutDown	proc export** Description:	This patch is very much like what ROM 3 already*                   does, except it doesn't always turn off the*                   screen.** Inputs:	None** Outputs:	None** 19-Nov-90 DAL:  Sucked this code into TS2 from QD:Init.asm, routine*                 CoreTerminate.* 25-Nov-90 DAL:  Sucked this code into TS3 from TS2.********************************************************************************DisposeHandleGlue	equ $fe1327	;for ROM 3NewVideo	equ $e0c029LclRTL	equ $fe0080	;for ROM 3	Macro&Lab	JSRL &Addr	GBLA &MacroCnt&MacroCnt	SETA &MacroCnt+1	phk	per theRTL&MacroCnt-1	pea |LclRTL-1	jml >&AddrtheRTL&MacroCnt	MEND* MyQDShutDown	cmp #0	bne @Continue	jml >$fefbdf	;oEndCall0 (ROM 3)@Continue	jsr LOCALQDStart*** added 7-Apr-91 DAL	pea 0	_QDAuxStatus	pla	beq @noQDAux	_QDAuxShutDown@noQDAux*** end of 7-Apr-91 DAL*** added 19-Nov-91 DAL -- fix up the color tables and SCBs	pha	_GetMasterSCB	pla	and #$FFF0	ora #$0080	pha	_SetMasterSCB	pushlong #$E19E00	_InitColorTable	pea $0080	_SetAllSCBs*** end 19-Nov-91	pea #2	; set the purge level to 2	ldx #512	; on the fastfont...	lda FastRomFont+2,x	and #$00FF	pha	lda FastRomFont,x	pha	_SetPurge** Deallocate rgn cache memory*	ldx #$02F4	lda 2,x	pha	lda 0,x	pha	jsl DisposeHandleGlue;-----------------------------------------------;; Close the first port and get rid of the memory; it is in.;	ldx #256	lda FirstPortHandle+2,x	pha	sta temp+2	lda FirstPortHandle,x	pha	sta temp	lda [temp]	tax	ldy #2	lda [temp],y	pha	phx	_ClosePort	jsl DisposeHandleGlue;-----------------------------------------------;; Get rid of text buffer;	pei TextBufHandle+2	pei TextBufHandle	jsl DisposeHandleGlue;-----------------------------------------------;; Get rid of the buffer memory	pei BufferHandle+2	pei BufferHandle	jsl DisposeHandleGlue;-----------------------------------------------; Get rid of shadowed ram here; test for shadowing enabled, if it is, turn it off and ; dispose of the screen...	sep #$20	; turn off long <A>	longA Off	lda >$E0C035	; load the shadow register	and #$08	; set bit 3... (turn screen shadow off)	bne @NotShadowed	longA On	REP #$20	; and turn back on long <A>		pha	pha	pea $0001	; find the shadowed screen memory	pea $2000	; handle, shadowing was on...	_FindHandle	_DisposeHandle	; and throw it the hell away..@NotShadowed	longA On	REP #$20;-----------------------------------------------;; Now get rid of screen memory.  Cannot	do a find; since we could be	called after a startup call; that was aborted because screen was already; owned.  We don't want to release someone; else's memory.;	ldx #256	lda ScreenHandle+2,x	pha	lda ScreenHandle,x	pha	jsl DisposeHandleGlue;-----------------------------------------------;; Get rid of the memory used by cursor save;	jsrl $fe4fb2	;CursorShutDown (ROM 3);----------------------------------------------------;; Turn off graphics	and linearization in bank 1/E1;;	pha	;added 19-Nov-90 DAL;	_GetMasterSCB	;added 19-Nov-90 DAL;	pla	;added 19-Nov-90 DAL;	and #$0100	;added 19-Nov-90 DAL;	bne @1	;added 19-Nov-90 DAL;;	sep #$30	; go to 8 bit mode;	longa off;	longi off;	lda >NewVideo;	and #%00111111	; turn off graphics	and linearization;	sta >NewVideo;	rep #$30	; go back to 16;	longi on;	longa on;@1		;added 19-Nov-90 DAL*** added 6-Sep-91 DAL -- turn off linearization, or SHR+linearization	pha	_GetMasterSCB	pla	ldx #%00111111	and #$0100	;bit 8 = leave SHR screen showing!	beq @1	;turn off both	ldx #%10111111	;turn off linear, leave screen on@1	txa	sep #$30	and >NewVideo	sta >NewVideo	rep #$30*** end of 6-Sep-91 DAL;-----------------------------------------------;; Clear the entry in the WAPT;	lda #0	; not a user call (seed the a-reg	pha	; to save bytes below	PushWord #TSNumber	; Put TSNum on stack	pha	; new value is zero	as set above.	pha	_SetWAP;------------------------------------------------------; Turn off shadowing for the SHR Screen;	sep #$20	; turn off long <A>	longA Off	lda >$E0C035	; load the shadow register	ora #$08	; set bit 3... (turn screen shadow off)	sta >$E0C035	; and resave it!	longA On	REP #$20	; and turn back on long <A>		jml >$fefbea	;ROM 3	EndP*****************************************************************iGimmeVersion	PROC Export** Vectored routine to return QD's version number*** Inputs:*	none** Outputs:*	a-reg** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	lda #$0308	;2-Apr-93 DAL	rtl	ENDP	EJECT********************************************************************************iSetUpScanPtrs	PROC Export** Description:	this is to patch a bug in the firmware that does not properly*	call init3Regions via the vector. This is so quickergraph can work*	Currently the only offender is irgnblt*** Inputs:	This routine should be relatively non destructive, except that *	<A> and <X> can both be trashed if we want.** Outputs:	None** External Refs:** Entry Points:********************************************************************************ROMSetUpScanPtrs	equ $FE5C0AROMRgnBltOffsnder	equ $FE45D3ROMGoodRgnBltRtn	equ $45D7	jsl ROMSetUpScanPtrs	lda 1,s	; look at the return address	cmp #<ROMRgnBltOffsnder	beq @1@GoodCall	RTL	; not rgnblt we can simply return@1	lda 2,s	cmp #ROMRgnBltOffsnder>>8	bne @goodcall	jsl Init3Regions	lda #ROMGoodRgnBltRtn	sta 1,s	RTL	EndP	*****************************************************************iSeekRgn	Proc Export** The state record for the region to seek is passed in StatePtr** 3/19/90	Patched to set up the rgnptr properly from the* 	stateptr data. This Should fix many crash/hang problems*	with copybits and scrollrect*ROMItsRectangular	equ $FE60EAROMGoingDown	equ $FE6013ROMGoingUp	equ $FE6124*****************************************************************	lda [StatePtr]	bpl @TestMore	jml ROMItsRectangular@TestMore	ldy #S_SeekDir	lda [StatePtr],y	bne @MustPatch	jml ROMGoingDown@MustPatch	; If we get here we are going backwards and need to set up 	ldy #s_RgnPtr	; get the pointer to the region	lda [StatePtr],y	; add 10 and put result in the	sta RgnPtr	ldy #s_RgnPtr+2	lda [StatePtr],y	sta RgnPtr+2	jml ROMGoingUp	EndP	EJECT********************************************************************************iSetSliceAdr	PROC Export** Description:	Patch all the backwards slices to properly set the <X>* 	register for xShiftStay.	*** Inputs:	None** Outputs:	None** External Refs:*ROMSetSliceAdr	equ $FE4B0BROMBFCopySLice	equ $FE3B5C	; oops...ROMBFORSlice	equ $FE3BCFROMBFXORSLICE	equ $FE3C3BROMBFBICSlice	equ $FE3CA7XferMode	equ $E4	; equate from ROMHorBackward	equ $CA	; equate from ROM* Entry Points:********************************************************************************	lda XFerMode	; take the tranfer mode	and #$7F	; mask off not bit	asl a	; double	asl a	; and double again	tax	; put in x	lda HowFarToShift	; if i don't have to shift at all	beq ToROM	; then I can use the fast slice routines	bit HorBackward	; oh well so I use the slow ones.	bpl ToROM	lda >BackSliceAdrTable,x	sta >ToSlice	lda >BackSliceAdrTable+2,xStoreIt	sta >ToSlice+2	rtlToROM	JML ROMSetSliceAdrBackSliceAdrTable	jml ROMBFCopySlice	jml BFORSlice	jml BFXORSlice	jml BFBICSliceBFORSlice		ldx HowFarToShift	jml ROMBFORSliceBFXORSlice		ldx HowFarToShift	jml ROMBFXORSliceBFBICSlice		ldx HowFarToShift	jml ROMBFBICSlice	EndP****************************************************************** SetSlabAdr** This routine sets	of the vector "ToSlab" in bank E0.  All* drawing routines use this vector to get to their slab routine.** If the clipping is non-rectangular or	the drawing mask is* not all $FFFF's, then we use the normal slabs.  Otherwise* we use the FAST SLABS.** 2/28/89	Konstantin and Dave* Also, returned in carry whether a fast slab is being used, and* returned in <X> is the offset to the slab table. THIS SHOULD* NOT CHANGE****************************************************************iSetSlabAdr	PROC EXPORT	lda FillMode	and #$7F	asl a	asl a	tax	lda NonRectRegions	bne GoSlow	ldy #o_PnMask	;go fast if there is no mask	lda [PortRef],y	ldy #o_PnMask+2	and [PortRef],y	ldy #o_PnMask+4	and [PortRef],y	ldy #o_PnMask+6	and [PortRef],y	inc a	;are they all $FFFF?	beq  GoFastGoSlow		; 	lda >SlabTable,x	sta >ToSlab	lda >SlabTable+2,x	sta >ToSlab+2	sec	;we must go slow	rtlGoFast	lda >FastSlabTable,x	sta >ToSlab	lda >FastSlabTable+2,x	sta >ToSlab+2	clc	;signals that we can go fast	rtl	ENDP****************************************************************** SlabTable*****************************************************************SlabTable	PROC EXPORT	jml OurSlabCopy	jml OurSlabOR	jml OurSlabXOR	jml OurSlabBIC	ENDP****************************************************************** FastSlabTable*****************************************************************FastSlabTable	PROC EXPORT	jml PatchSlabCopy	jml FastSlabOR	jml PatchSlabXOR	jml FastSlabBIC	ENDP*****************************************************************PatchSlabXOR	PROC EXPORT*** 6/15/89	Mensch** Drastically modified for slab entry for the patch*****************************************************************;---------------------------------------------------------------MaxWordsInRow	equ 80MaxBytesInRow	equ MaxWordsInRow*2;---------------------------------------------------------------;---------------------------------------------------------------	lda Pat	;if the patterns are equal go very fast	cmp Pat+2	beq tryReallyFastexit1	jml FastSlabXOR	; if the pats are not equal use ROMslabstryReallyFast		lda FinishWord	;get the number of bytes to XOR into the	sec	;..A-Reg	sbc StartWord	beq exit1	;if only one word, do a special case	lsr a	dec a	;if only two words,	then do another	beq exit1	;..special case	tax	;otherwise the count goes in X-Reg	cmp #MaxWordsInRow	; do we hit the threshhold?	bge exit2	; if less than max in rom do exit1	jml GoReallyFastXORExit2	jml FastSlabXORAlt	; else do the fast slab xor alt	EndP*****************************************************************PatchSlabCopy	PROC EXPORT** 6/15/89	Mensch** Made entry to fastslabcopy modified version for the patch****************************************************************;---------------------------------------------------------------MaxWordsInRow	equ  80;---------------------------------------------------------------	lda Pat	;if the patterns are equal go very fast	cmp Pat+2	beq tryReallyFastexit1	jml FastSlabCopy	; if the pats are not equal use ROMslabstryReallyFast		lda FinishWord	;get the number of bytes to XOR into the	sec	;..A-Reg	sbc StartWord	beq exit1	;if only one word, do a special case	lsr a	dec a	;if only two words,	then do another	beq exit1	;..special case	tax	;otherwise the count goes in X-Reg	cmp #MaxWordsInRow	; do we hit the threshhold?	bge exit2	; if less than max in rom do exit1	jml GoReallyFastCopyExit2	jml FastSlabCopyAlt	; else do the fast slab xor alt	EndP*****************************************************************OurSlabs	PROC** These are the patched slabs.  The each swap the pen mask, call* the old mask and swap it back.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	ENTRY OurSlabCopyOurSlabCopy	SwapMask	jsl SlabCopyGetOut	SwapMask	rtl	ENTRY OurSlabOROurSlabOR	SwapMask	jsl SlabOR	bra GetOut	ENTRY OurSlabXOROurSlabXOR	SwapMask	jsl SlabXOR	bra GetOut	ENTRY OurSlabBICOurSlabBIC	SwapMask	jsl SlabBIC	bra GetOut	ENDP*****************************************************************iRotateMask	PROC Export** The code in rom does the wrong thing if the arcrot field* has the high bit set.  So we skipp the bad code.**** Inputs:*	a-reg has something important in it** Outputs:*	and its on the stack by the time* 	we get to the new code.** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************BackIntoROM	equ $FE20AD	pha	jml BackIntoROM	ENDP	if 1 then	EJECT********************************************************************************MySetCursor	PROC Export** Description:	This routine does exactly what the very start of*	the real set cursor does except that it also tests the MasterSCB*	to see if the SetCursNoDraw bit is set...*** Inputs:	None** Outputs:	None** External Refs:ROMNotVisible	equ $FE50A4;CursorLevel	equ $CC;ObscureFlag	equ $CE;CursorMode	equ $6A********************************************************************************OrigP	equ 1OrigDirect	equ OrigP+1RTL1	equ OrigDirect+2RTL2	equ RTL1+3TheCursorPtr	equ RTL2+3StartofZP	equ CursorSTARTUseInterrupts	equ StartofZPIntPending	equ UseInterrupts+2MouseY	equ IntPending+2MouseX	equ MouseY+2NextMouseY	equ MouseX+2NextMouseX	equ NextMouseY+2CurHeight	equ NextMouseX+2	; Num scan lines high of cursorCurWidth	equ CurHeight+2	; Num WORDS wide of	cursorCursorRect	equ CurWidth+2CursorY1	equ CursorRectCursorX1	equ CursorY1+2CursorY2	equ CursorX1+2CursorX2	equ CursorY2+2CursorMode	equ CursorX2+2CursorRecPtr	equ CursorMode+2CursorPtr	equ CursorRecPtr+4MaskPtr	equ CursorPtr+4CursorPtr1	equ MaskPtr+4MaskPtr1	equ CursorPtr1+4CursorPtr2	equ MaskPtr1+4MaskPtr2	equ CursorPtr2+4CursorPtr3	equ MaskPtr2+4MaskPtr3	equ CursorPtr3+4CursorPtr4	equ MaskPtr3+4MaskPtr4	equ CursorPtr4+4CursorPtr5	equ MaskPtr4+4MaskPtr5	equ CursorPtr5+4CursorPtr6	equ MaskPtr5+4MaskPtr6	equ CursorPtr6+4CursorPtr7	equ MaskPtr6+4MaskPtr7	equ CursorPtr7+4SaveHandle	equ MaskPtr7+4SavePtr	equ SaveHandle+4SaveSize	equ SavePtr+4CursorRef	equ SaveSize+2MaskRef	equ CursorRef+4HotSpot	equ MaskRef+4SaveRef	equ HotSpot+4ScreenRef	equ SaveRef+4CursorLevel	equ ScreenRef+2ObscureFlag	equ CursorLevel+2	tay	lda 9,s	;high word of cursor ptr	tax	asl a	lsr a	sta 9,s	;cleared bit 31	tya	;A=preserved, X=high word of input	jsr LOCALQDStart	clc	adc #$100	tcd	php	; save processor	sei	; turn off interrupts to do this	bit <CursorLevel	bmi NotVisible	bit <ObscureFlag	bmi NotVisible	txa	bmi NoFlicker	tdc	jsl UnDrawCursor	; restore under cursorNotVisible	jml ROMNotVisibleNoFlicker	lda 10,s	;get pointer to cursor rec	sta CursorRecPtr	lda 10+2,s	;high word of new cursor rec	sta CursorRecPtr+2;	lda [CursorRecPtr]	; I move height and	width;	sta CurHeight	; to zero page;	ldy #2;	lda [CursorRecPtr],y;	sta CurWidth	lda CursorRecPtr	; point to cursor image	clc	adc #4	sta CursorPtr	lda CursorRecPtr+2	sta CursorPtr+2	lda SaveSize	; get savesize in a	sec	; get rid of extra word per line	sbc CurHeight	sec	sbc CurHeight	tay	; put copy in Y too	clc	adc CursorPtr	sta MaskPtr	lda CursorPtr+2	sta MaskPtr+2	lda [MaskPtr],y	; get hot spot	sta HotSpot	iny	iny	lda [MaskPtr],y	sta HotSpot+2;----------------------------------------------;; Update the appropriate pointers.;	lda SavePtr	; the first pointer	is savesize past	clc	; saveptr.	adc SaveSize	sta CursorPtr1	lda SavePtr+2	adc #0	sta CursorPtr1+2	ldx #0SetUpLoop	lda CursorPtr1,x	clc	adc SaveSize	sta CursorPtr1+4,x	lda CursorPtr1+2,x	adc #0	sta CursorPtr1+6,x	inx	inx	inx	inx	cpx #13*4	; 52, 7 sets of two	pointers	bcc SetUpLoop;----------------------------------------------;; Now I must shift the cursor and mask into; the appropriate places.;***	jsr ShiftStuff	;$FE4FE6 in ROM 3	phk	per @cont-1	pea $0080-1	;$FE0080 is an RTL in ROM 3	jml >$fe4fe6@cont;----------------------------------------------;; Now I can show the new cursor;	bit CursorLevel	bmi DoNotShow	bit ObscureFlag	; or should a set cursor unobscure it?	bmi DoNotShow*** This is really ugly and cruel.  Since there's already an old cursor on*** the screen, which I -don't- want to get stuffed into the SaveArea, I*** point SavePtr at the ROM around the call to DrawCursor.	pei <SavePtr+2	pei <SavePtr	lda #$fefe	sta <SavePtr+2	sta <SavePtr	jsl DrawCursor	pla	sta <SavePtr	pla	sta <SavePtr+2DoNotShow	plp	; restore interrupt	status	jmp BusyEC4	EndP	EndIf	*****************************************************************SetPort	PROC Export** If set port is called from a special place in ROM, there* is a region we must dispose of.  This region is the temporary* region allocated to do scrolling in the window manager and* it is accidentily orphaned.  This patch kills it.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*		Export FinishSetPort*	longa on	; mode	longi on*****************************************************************	DefineStackRTL1	block 3TheRTL	block 3ThePortPtr	LONGSpecialAddress	equ $FD4b20*** SpecialAddress2	equ $FCB839TempRgn	equ $19	tax	; save the WAP in x;; Look at the RTL.  If its not the special address, ignore it.;	lda TheRTL,s	cmp #<SpecialAddress-1	bne NothingSpecial	lda TheRTL+1,s	cmp #>SpecialAddress-1	bne NothingSpecial;; this is it, dispose of the region.;	phx	; save the wap on the stack	pei TempRgn+2	pei TempRgn	_DisposeRgn;; Zero the region so it cannot be disposed again if this code ; runs again.;	stz TempRgn+2	stz TempRgn	plx	; get WAP back off the stack	bra FinishSetPortNothingSpecial; (killed, DAL)	lda TheRTL,s;	cmp #<SpecialAddress2-1;	bne FinishSetPort;	lda TheRTL+1,s;	cmp #>SpecialAddress2-1;	bne FinishSetPort;	brl DoADirtyDeed	; if this matches then do the font manager patchFinishSetPort	txa;; Jump back into ROM;	jml $FE1832	ENDP*****************************************************************SetForeColor	PROC Export** If SetForeColor is being called from the Menu Manager at a* specific location then we patch the return address back to* the menu manager with our own address that patches out the* routine text_guts. This is one of the routines that needed* to be changed to support icons in menu items. Since this * routine is buried deep in the menu manager code it is easier* to patch it this way.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*		Export FinishSetForeColor*	longa on	; mode	longi on*****************************************************************	DefineStackRTL1	block 3TheRTL	block 3TheColor	WORDMyAddress1	equ $FD730C	; This is the return address to the next instruction after 		; the SetForeColor call in the MenuMgr code.	tax	; Save the WAP	lda TheRTL,s	cmp #<MyAddress1-1		bne FinishSetForeColor	lda TheRTL+1,s	cmp #>MyAddress1	bne FinishSetForeColor	brl DoADirtyDeed2	; This routine will now patch out the return address		; back to the menu manager and will now return to the menu patch.FinishSetForeColor	txa	; Put WAP back in a-reg.		jml $FE1CB8	; Jump back to start of SetForeColor call.	ENDP*****************************************************************PtInRect	PROC Export** If SetForeColor is being called from the Menu Manager at a* specific location then we patch the return address back to* the menu manager with our own address that patches out the* routine text_guts. This is one of the routines that needed* to be changed to support icons in menu items. Since this * routine is buried deep in the menu manager code it is easier* to patch it this way.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*		Export FinishPtInRect*	longa on	; mode	longi on*****************************************************************	DefineStackRTL1	block 3TheRTL	block 3RectPtr	longpointPtr	longresult	wordTheRTS	wordMyAddress2	equ $FD6CD1	; address of instruction after PtInRect call that we want to checkMyAddress3	equ $FD709C	; address of instruction after jsr to the routine		; that calls PtInRect	tax	; Save the WAP	lda TheRTL,s	cmp #<MyAddress2-1	bne FinishPtInRect	lda TheRTL+1,s	cmp #>MyAddress2	bne FinishPtInRect	lda TheRTS,s	cmp #<MyAddress3-1	bne FinishPtInRect	brl DoADirtyDeed3	; This routine will now patch out the return address		; back to the menu manager.FinishPtInRect	txa	; Put WAP back in a-reg.	jml $FE220C	; Jump back to start of PtInRect call.		ENDP****************************************************************** Procedure SectRgn(*   srcRgnA,srcRgnB,dstRgn:RgnHandle*   )**   Calculate the intersection of two regions.*****************************************************************SectRgn	PROC Export	jsr LOCALQDStart	lda #0	; op := Sect	jmp DoRgnOp	; it does all the work	ENDP****************************************************************** Procedure UnionRgn(*   srcRgnA,srcRgnB,dstRgn:RgnHandle*   )**   Calculate the union of two regions.*****************************************************************UnionRgn	PROC Export	jsr LOCALQDStart	lda #4	; op := Union	jmp DoRgnOp	; it does all the work	ENDP****************************************************************** Procedure DiffRgn(*   srcRgnA,srcRgnB,dstRgn:RgnHandle*   )**   Calculate the difference A-B of two	regions.*****************************************************************DiffRgn	PROC Export	jsr LOCALQDStart	lda #2	; op := Diff	jmp DoRgnOp	; it does all the work	ENDP****************************************************************** Procedure XorRgn(*   srcRgnA,srcRgnB,dstRgn:RgnHandle*   )**   Calculate the exclusive or of two regions.*****************************************************************XorRgn	PROC Export	jsr LOCALQDStart	lda #6	; op := Xor	jmp DoRgnOp	; it does all the work	ENDP****************************************************************** Procedure DoRgnOp;**   Computes the Intersection, Difference, Union, or Xor*   of two regions.	 Enter with Op in A.**    Sect = 0	A-B Diff = 2      Union = 4      Xor = 6*****************************************************************	EXPORT DoRgnOpDoRgnOp	PROC*              using E0VectorsOrigDirect	equ 1RTL1	equ OrigDirect+2RTL2	equ RTL1+3DstRgn	equ RTL2+3SrcRgnB	equ DstRgn+4SrcRgnA	equ SrcRgnB+4	sta Op	; save the operation		lda SrcRgnA,s	; get low word of SrcRgnA	sta RgnHandleA	; save it	lda SrcRgnA+2,s	; get high word of SrcRgnA	sta RgnHandleA+2	; save it	lda SrcRgnB,s	; get low word of SrcRgnB	sta RgnHandleB	; save it	lda SrcRgnB+2,s	; get high word of SrcRgnB	sta RgnHandleB+2	; save it	jsr DerefAB	lda [RgnPtrA]	; get size of one	cmp [RgnPtrB]	; compare to size of other	bne NotSame	; if not the same drop to the new rgnop...	tay	dey	deyLoop	lda [RgnPtrA],y	cmp [RgnPtrB],y	bne NotSame	dey	dey	bne Loop; was this...;	pha	; room for result;	lda SrcRgnA+4,s	; get high word;	pha	; push it;	lda SrcRgnA+4,s	; get low word;	pha	; push it;	lda SrcRgnA+4,s	; get high word;	pha	; push it;	lda SrcRgnA+4,s	; get low word;	pha	; push it;	_EqualRgn	; are they equal?;	pla	; get boolean result;	beq NotSame	; if 0 (false), we have more work; NOTE: If we get here then the regions are the same...	lda Op	; get op	and #2	; and it with 2 (Diff and Xor bit)	bne Zero	; zero it if Sect or UnionCopy	; This routine copies rgn <A> to dest region...	lda SrcRgnA+2,s	; get high word	pha	; push it	lda SrcRgnA+2,s	; get low word	pha	; push it	lda DstRgn+6,s	; get high word	pha	; push it	lda DstRgn+6,s	; get low word	pha	; push it	_CopyRgn	; copy it	bcs T1	brl DoUnlockABNoErrZero	lda DstRgn+2,s	; get high word	pha	; push it	lda DstRgn+2,s	; get low word	pha	; push it	_SetEmptyRgn	; zero the destination	bcs T1	brl DoUnlockABNoErrT1	brl DoUnlockABError* load the handles from the stack onto zero page and dereference themNotSame	; was this...;	lda SrcRgnA,s	; get low word of SrcRgnA;	sta RgnHandleA	; save it;	lda SrcRgnA+2,s	; get high word of SrcRgnA;	sta RgnHandleA+2	; save it;	jsr DerefA;;	lda SrcRgnB,s	; get low word of SrcRgnB;	sta RgnHandleB	; save it;	lda SrcRgnB+2,s	; get high word of SrcRgnB;	sta RgnHandleB+2	; save it;	jsr DerefB* If Op = Diff and RgnB is empty, copy RgnA into DstRgn	lda #2	; get Diff opcode	cmp Op	; is it Diff?	bcc UniXor	; if Op > Diff then	Union or Xor	bne BBoxes	; if Op <> Diff, it's Sect* Op = Diff, so check RgnB for empty	ROMCALL RgnBEmpty	; is RgnB empty	bpl Copy	; if it's empty, CopyRgnA* If Op = Sect or Diff, then intersect the bounding boxes.BBoxes	ROMCALL RgnSector	; RgnY1..RgnX2 := RgnA * RgnB	lda RgnX1	cmp RgnX2	; compare to X2	bpl Empty	; if X1=X2, it's empty	lda RgnY1	; get top	cmp RgnY2	; if Y1 >= Y2, it's empty	bmi NotEmpty	; so do it* The bounding boxes don't intersect.  If Op = Sect, then return empty.* If Op = Diff, then copy RgnA into DstRgnEmpty	lda Op	; get op	beq Zero	; if Sect, return empty	jmp Copy	; no, copy SrcA into DstRgn* If Op = Sect, then check for both inputs rectangularNotEmpty	lda Op	; is op = Sect	bne NotEasy	; no, continue	lda #10	; get rectangular region size	cmp [RgnPtrA]	; compare with RgnA	length	bne NotEasy	; no, continue	cmp [RgnPtrB]	; compare with RgnB	length	bne NotEasy	; no, continue* push dstrgn and address of temprect.	Could be bad news.	lda DstRgn+2,s	; get high word	pha	; push it	lda DstRgn+2,s	; get low word	pha	; push it	clc	lda #0	; it's in bank 0	pha	; push high word	tdc	; get direct register	adc #RgnY1	; add in offset	pha	; push low word	_RectRgn	; RectRgn(dstRgn,tempRect)	bcs T2	brl DoUnlockABNoErrT2	brl DoUnlockABErrorUniXor	ROMCALL RgnBEmpty	; is RgnB empty?	bmi T3	; yes, copy RgnA	brl CopyT3	ROMCALL RgnAEmpty	; is RgnA empty?	bmi NotEasy	; yes, copy RgnB	lda SrcRgnB+2,s	; get high word	pha	; push it	lda SrcRgnB+2,s	; get low word	pha	; push it	lda DstRgn+6,s	; get high word	pha	; push it	lda DstRgn+6,s	; get low word	pha	; push it	_CopyRgn	; copy it	bcs DoUnlockABErrorDoUnlockABNoErr	phx	jsr UnlockAB	plx	JML BusyEC12DoUnlockABError	pha	jsr UnlockAB	plx	JML BusyErr12NotEasy	clc	; clear carry for addition	lda [RgnPtrA]	; get RgnA length	adc [RgnPtrB]	; add RgnB length	asl A	; double (Quickdraw	did ADD D4,D4)	sta PtCount	; save it* We've taken all the shortcuts we can.  Now we pass the buck to RgnOp to do* the real work.  The source regions are still in RgnHandleA and RgnHandleB.* PtCount contains the maximum size we should need.  Load X	with 0 since we* have no horizontal offset to worry about (just for cleanliness).	ldx #0	; unnecessary unless code changes	jsl RgnOp	; do it	bcs RgnOpError	; RgnOp propogates errors	lda DstRgn,s	sta RgnHandleA	lda DstRgn+2,s	sta RgnHandleA+2	jsr DerefA	; nice shortcut...	jsl PackRgn	; call it	PushLong BufHandle	; push handle	_DisposeHandle	; dispose of point buffer handle	bcs DoUnlockABError	brl DoUnlockABNoErrRgnOpError	pha	; save error code	lda BufHandle	ora BufHandle+2	beq DontDispose	PushLong BufHandle	_DisposeHandleDontDispose	jsr UnlockAB	plx	; get error code back	jmp BusyErr12UnlockAB	; modified this routine to unblock the src rgns on the stack instead; first save the direct page...	phd	plx	; in the <X> register...	tsc	; and make the stack a direct page	tcd	ldy #4	; offset to the handle attributes	lda [SrcRgnA+4],y	; unlock A (account for error and jsr)	and #$7FFF	sta [SrcRgnA+4],y	lda [SrcRgnB+4],y	; unlock B	and #$7FFF	sta [SrcRgnB+4],y	phx	; restore direct page	pld	; to what it was before...	rtsDeRefAB		ldy #4	; lock it	lda [RgnHandleB],y	ora #$8000	sta [RgnHandleB],yDerefA	ldy #4	; lock it	lda [RgnHandleA],y	ora #$8000	sta [RgnHandleA],y	lda [RgnHandleA]	; deref it.	sta RgnPtrA	lda [RgnHandleB]	; deref it.	sta RgnPtrB	ldy #2	lda [RgnHandleA],y	sta RgnPtrA+2	lda [RgnHandleB],y	sta RgnPtrB+2	rts	ENDPLOCALQDStart	proc Export	pha	lda >BusyFlag	inc a	sta >BusyFlag	pla	phd	; push d on stack	tcd	; set d	lda 3,s	; getorig rts	pha	; put on stack	lda 3,s	; move orig d to on	top of rts	sta 5,s	pla	; pull rts off stack	sta 1,s	; put over orig d	tdc	; get QD D back in a	rts	; done	EndP********************************************************* InflateTextBuffer (patched 27-Nov-91 DAL)** (Original is in QD:Text.asm.)********************************************************MyInflateTextBuffer	PROC exportOrigDirect	equ 1RTL1	equ OrigDirect+2RTL2	equ RTL1+3newHeight	equ RTL2+3newWidth	equ newHeight+2	jsr LocalQDStart	lda newWidth,s	sta newFontWidth	lda newHeight,s	sta newTBHeight*** added 3-Dec-91 DAL -- preserve old DP values that we may need to restore	ldx #256	lda <fontWidth,x	pha	pei <textBufHeight	pei <textBufRowWords*** end 3-Dec-91	jsl $fe8741	;InflateTB (ROM 3);;;	ldy #4;;;	jmp BusyEC*** added 3-Dec-91 DAL -- honor error code from InflateTB, and restore***  DP values if we had an error (even though QD doesn't mess up the***  values if it can't resize the buffer, we do mess them up if QD Aux***  can't resize -its- buffers).	tay	;error code to Y	pla	bcc @noStore1	sta <textBufRowWords@noStore1	pla	bcc @noStore2	sta <textBufHeight@noStore2	pla	bcc @noStore3	ldx #256	sta <fontWidth,x@noStore3	tyx	;error code to X	pld	ldy #4	jml $e10180	;ToBusyStrip*** end 3-Dec-91********************************************************* $DA04 Get640Colors():PatternTablePtr*                      LONG** Returns a pointer to a table of all the solid 640-* mode dithered patterns (32 bytes of $00, 32 bytes of* $11, ..., 32 bytes of $ff).** New call 24-Sep-90 DAL for System Software 6.0********************************************************Get640Colors	PROC exportSolidColors	equ $fd40f6	lda #^SolidColors	sta 9,s	lda #<SolidColors	sta 7,s	lda #0	clc	rtl	EndP********************************************************* $DB04  Set640Color(color)*                    WORD** New call 24-Sep-90 DAL for System Software 6.0********************************************************Set640Color	PROC exportSolidColors	equ $fd40f6	lda 7,s	;input color number	and #$000f	xba	lsr a	lsr a	lsr a	adc #<SolidColors	;carry is guaranteed clear	pea SolidColors>>16	pha	_SetPenPat	tax	;error code	ldy #2	;strip 2 bytes	jml $e10184	;ToStrip	EndP;*******************************************************;*;* $DC04  GetScanlineAddr(lineNum):@address;*                        WORD     PTR;*;* New call 22-Oct-90 DAL for System Software 6.0;*;*******************************************************;GetScanlineAddr	proc export;;	ldx #$0452	;anticipate badScanLine error;	lda 7,s;	cmp #200;	bcs @error;;	ldx #$00e1	;anticipate bank $E1 (no shadowing);	lda >$E0C035	;shadow;	and #$0008;	bne @bank;	ldx #$0001	;SHR shadowing;@bank	txa;	sta 11,s;;	lda 7,s;	asl a;	tax;	lda >$fe553c,x;	sta 9,s;;	ldx #0;@error	ldy #2	;strip 2 bytes;	jml $e10184	;ToStrip;;	endp	END