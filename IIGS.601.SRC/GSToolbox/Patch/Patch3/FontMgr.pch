	title 'Font Mgr Patch        GS ROM 3 Patch'******************************************************************** Font manager patches for ROM 3** System Disk 5.0** 5/18/89	Steven Glass** 31 May 89	Harry Yee** Take prototype bit out of version number.** 6/12/89	Mensch** fix font purging bug with install and installwithstats** 11/14/89	Mensch* Fix bug in FMStartup. If the font.list file is not properly created * it will npw be deleted. This should fix problems with bad font files* on disk.** 17-Sep-90	Dave Lyons** Removed dependency on all.macros.** 14-Nov-90	Dave Lyons** Added a BEQ in FixFontList to fix the bug where having *only** the ROM font would go toasty.  FixFontList gets called by* InstallFont and InstallWithStats, and it was comparing the ROM* font handle against itself, deciding that it matched, and* removing it, leaving us with zero fonts (treated as 65536 fonts* by most code).  This was a bug only in the ROM 3 patch, and* only when there were *no* RAM-based fonts (FastFont doesn't* count).** Put back all.macros (it assembles faster).** 25-Nov-90 DAL** Made FMStartUp return fmBadParmErr ($1b0d) if you pass zero* for the user id or direct page address parameters.** 17-Feb-91 DAL** ABANDONING THIS PATCH FILE.  Haven't been using it lately, and* it looks like it's going to stay that way.  It's not worth it* to try salvaging the ROM 3 version of the Font Manager, so we're* using it out of RAM instead.*******************************************************************	include 'all.macros'	MACRO	PushZWord &A	pei  &A	MEND	Import FinishSetPort*---------------------------------------------------------------* Constants Coppied from FM.asm directly...*---------------------------------------------------------------FMVerNum	equ $0302	FMTSNum	equ $1B	;tool set num for Font ManagerInitErr	equ $1B01	;duplicate init callResetErr	equ $1B02	;can't reset Font ManagerActiveErr	equ $1B03	;Font Manager not activeNoFamErr	equ $1B04	;family not foundNoFontErr	equ $1B05	;font not foundMemErr	equ $1B06	;font not in memoryPurgeErr	equ $1B07	;system font cannot	be purgeableFamNumErr	equ $1B08	;illegal family numberSizeErr	equ $1B09	;illegal sizeNameErr	equ $1B0A	;illegal name lengthMenuErr	equ $1B0B	;FixFontMenu never called;added 2/10/87 - BHM:scaleSizeErr	equ $1B0C	;font can't be scaled that large;(must match ScaleFont definition)fmBadParmErr	equ $1b0d	;added 25-Nov-90 DAL (from FMStartUp);ProDOS	equ $E100A8	;ProDOS/16 entry vectorStackProDOS	equ $E100B0	;ProDOS/16 stack-based entry vectorOpenCall	equ $10	;ProDOS/16 call numberReadCall	equ $12	;           "CloseCall	equ $14	;           "SetMarkCall	equ $16	;           "GetEOFCall	equ $19	;           "CreateCall	equ $01	;           "WriteCall	equ $13	;           "SetEOFCall	equ $18	;           "GDECall	equ $1C	;           "DestroyCall	equ $02ButtonItem	equ 10	;item type for dialog managerStatTextItem	equ 15+$8000	;           "KeyDownEvt	equ 3	;event codeListPartCode	equ $88	;part code for listMessage	equ 2	;offset into TaskRecWhere	equ 10	;         "Modifiers	equ 14	;         "TaskMask	equ 20	;         "DirNameLen	equ 14	;length of '*/SYSTEM/FONTS'MaxNameLen	equ 25	;max length of font's family nameBlockSize	equ 512Illegal	equ $FFFF	;illegal family numberFontType	equ $C8	;filetype for font filesMemOnlyBit	equ $0001	;FontSpecBitsRealOnlyBit	equ $0002AnyFamBit	equ $0004AnyStyleBit	equ $0008AnySizeBit	equ $0010MemBit	equ $0001	;FontStatBitsUnrealBit	equ $0002ApFamBit	equ $0004ApVarBit	equ $0008PurgeBit	equ $0010NotDiskBit	equ $0020NotFoundBit	equ $8000BaseOnlyBit	equ $0020	;FamSpecBits;ApFamBit      equ $0004	;FamStatBitsNotBaseBit	equ $0020;NotFoundBit   equ $8000NotMemBit	equ $FFFE	;all bits set except MemBitUnPurgeable	equ $FFEF	;all bits set except PurgeBit;;added 2/10/87 - BHM:dontScaleBit	equ $0001	;(see scaleWord input in InstallFont)currFlag	equ $0001	;make font current (see LoadTheFont)notCurrFlag	equ $FFFEnewMemFlag	equ $0002	;(see LoadTheFont)oldMemFlag	equ $0004	;(see LoadTheFont);;                COPY new.cons;*****************************************************************************			               **  file NEW.CONS			               **			               **    started 8/31/87		               **    Bennet Marks  x6245		               **			               **  This file contains some new constants needed by the FMStartUp speed-up  **  experiment.  Also included are offsets used to make ProDOS stack-based  **  calls.			               **			               *****************************************************************************;****************************************	                  **  11/10/87  1:20 pm                  **  BHM  x6245	                  **	                  ****************************************;;FONT.LISTS format version number:;FLVerHi	equ $0000FLVerLo	equ $0001;;offsets to data in	the FONT.LISTS file:;oRomFamNum	equ 4oRomStyle	equ oRomFamNum+2oRomSize	equ oRomStyle+2oIDCount	equ oRomSize+2oFamCount	equ oIDCount+2oIDListSize	equ oFamCount+2oFamListSize	equ oIDListSize+2oNameListSize	equ oFamListSize+2oFileListSize	equ oNameListSize+2oTimeListSize	equ oFileListSize+2;FLFileHeadLen	equ oTimeListSize+2;;and some other constants:;GDENameBufSize	equ 20	;for the name bufferFileNotFound	equ $46EndOfDir	equ $61BinFile	equ $06;;*---------------------------------------------------------------* Font Manager Zero	Page*---------------------------------------------------------------FMZBase	equ 0TempHandle	equ FMZBase	;the following handles must be inFileHandle	equ TempHandle+4	;this orderIDHandle	equ FileHandle+4FamHandle	equ IDHandle+4NameHandle	equ FamHandle+4FontHandle	equ NameHandle+4BlockHandle	equ FontHandle+4MDHandle	equ BlockHandle+4ItemHandle	equ MDHandle+4FMParamHandle	equ ItemHandle+4	;added 11/10/87 - BHM x6245TempPtr	equ FMParamHandle+4	;the following pointers must be inFilePtr	equ TempPtr+4	;this orderIDPtr	equ FilePtr+4FamPtr	equ IDPtr+4NamePtr	equ FamPtr+4FontPtr	equ NamePtr+4BlockPtr	equ FontPtr+4MDPtr	equ BlockPtr+4ItemPtr	equ MDPtr+4FMParamPtr	equ ItemPtr+4	;added 11/10/87 - BHM x6245SavedFilePtr	equ FMParamPtr+4	;the following pointers must be inSavedIDPtr	equ SavedFilePtr+4	;this orderSavedFamPtr	equ SavedIDPtr+4SavedNamePtr	equ SavedFamPtr+4IDListSize	equ SavedNamePtr+4FamListSize	equ IDListSize+2NameListSize	equ FamListSize+2ItemListSize	equ NameListSize+2	;** added 2-25-87 CAE **IDCount	equ ItemListSize+2FamCount	equ IDCount+2;****  CHANGED 11/4/87:;all the Font Manager's ProDOS calls (except GetDirEntry) now share a common;block of 0-page for their parameter blocks.  Note that the	reference numbers;(OpenRef, ReadRef,	etc.) are actually the same 0-page location.  In partic-;ular, after an OpenFile call is done, the new ref number is in the right;position for a subsequent ReadFile call. - BHM  x6245  11/4/87;ProDOSParams	equ FamCount+2;;Open call:OpenRef	equ ProDOSParams	;reference numberOpenPtr	equ OpenRef+2	;ptr to pathnameOpenBuf	equ OpenPtr+4	;unused by Font Manager;Read call:ReadRef	equ ProDOSParams	;reference numberReadPtr	equ ReadRef+2	;ptr to data bufferReadSize	equ ReadPtr+4	;number of bytes to	readReadActual	equ ReadSize+4	;number of bytes actually read;Close call (whew!):CloseRef	equ ProDOSParams	;reference number;GetEOF and SetEOF calls:EOFRef	equ ProDOSParams	;reference numberEOFSize	equ EOFRef+2	;EOF (new or returned result);GetMark and SetMark calls:MarkRef	equ ProDOSParams	;refernce numberMarkLoc	equ MarkRef+2	;mark (new or returned result);Write call:WriteRef	equ ProDOSParamsWriteBuf	equ WriteRef+2WriteReq	equ WriteBuf+4WriteTrans	equ WriteReq+4;Create call:CRNamePtr	equ ProDOSParamsCRAccess	equ CRNamePtr+4CRFileType	equ CRAccess+2CRAuxType	equ CRFileType+2CRStore	equ CRAuxType+4CRDate	equ CRStore+2CRTime	equ CRDate+2;Destroy call:KillNamePtr	equ ProDOSParams;****  end of changes to ProDOS parameter blocks - BHM  x6245  11/4/87;;note that the parameter blocks above all use less than 20 bytes;MenuMade	equ ProDOSParams+20	;so this is safeStartingID	equ MenuMade+2ProgID	equ StartingID+2SysFontID	equ ProgID+2RomFbrExtent	equ SysFontID+4OldStats	equ RomFBRExtent+2	;added 12/16/87 - BHM  x6245;(for use by InstallWithStats);added 1/11/88 - BHM  x6245temp1Ptr	equ OldStats+2temp2Ptr	equ temp1Ptr+4;the following locations are used to hold information that,	in the RAM;of this tool, were	kept in the data segment.  Some also subsume 0-page;locations that used to be private to ChooseFont - BHM  x6245  1/25/88ScreenMode	equ temp2Ptr+4WindPtr	equ ScreenMode+2LineHndl	equ WindPtr+4Temp	equ LineHndl+4;; Equates for ChooseFont item ID'sMDListID	equ 1SizeListID	equ 2SizeEditID	equ 3OKID	equ 4CancelID	equ 5; these next style ID's must be in order...PlainSID	equ 6BoldSID	equ 7ItalicSID	equ 8UnderSID	equ 9OutlineSID	equ 10ShadowSID	equ 11LastSID	equ 12;stat1ID	equ 12stat2ID	equ 13stat3ID	equ 14;; RefCon Equates for ChooseFont controlsuseNILHit	equ 0useFontHit	equ 1useSizeHit	equ 2useOtherHit	equ 3useOKHit	equ 4useCancelHit	equ 5usePlainHit	equ 6useStyleHit	equ 7*******************************************************************			   **              Copyright (C) 1989-90		   **              All Rights Reserved		   **              Apple Computer, Inc.		   **			   *****************************************************************	Blanks off	String asis	****************************************************************** FONT MANAGER CALL	TABLE*****************************************************************FMCallTable	PROC EXPORT	import FMVersion	import InstallFont	import FMStartup	import InstallWithStatsTheStart	DC.L (TheEnd-TheStart)/4 ;num calls + 1	DC.L 0	; FMBootInit-1	DC.L FMStartup-1	; FMStartUp-1	DC.L 0	; FMShutDown-1	DC.L FMVersion-1	DC.L 0	; FMReset-1	DC.L 0	; FMStatus-1	DC.L 0	; oStdEnd0-1	DC.L 0	; oStdEnd0-1	DC.L 0	; CountFamilies-1	DC.L 0	; FindFamily-1	DC.L 0	; GetFamInfo-1	DC.L 0	; GetFamNum-1	DC.L 0	; AddFamily-1	DC.L InstallFont-1	DC.L 0	; SetPurgeStat-1	DC.L 0	; CountFonts-1	DC.L 0	; FindFontStats-1	DC.L 0	; LoadFont-1	DC.L 0	; LoadSysFont-1	DC.L 0	; AddFontVar-1	DC.L 0	; FixFontMenu-1	DC.L 0	; ChooseFont-1	DC.L 0	; ItemID2FamNum-1	DC.L 0	; FMSetSysFont-1	DC.L 0	; FMGetSysFID-1	DC.L 0	; FMGetCurFID-1	DC.L 0	; FamNum2ItemID-1	DC.L InstallWithStats-1TheEnd	ENDP*****************************************************************FMVersion	PROC** Returns version of patched font manager.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	lda #FMVerNum	sta 7,s	lda #0	clc	rtl	ENDP	GBLA &MacroCnt&MacroCnt	Seta 0	Macro&Lab	JSRL &Addr	GBLA &MacroCnt&MacroCnt	SETA &MacroCnt+1	phk	per theRTL&MacroCnt-1	pea |LclRTL-1	;was PEA 24-Sep-90 DAL	jml >&AddrtheRTL&MacroCnt	MEND	EJECT********************************************************************************FMStartup	PROC Export** Description:	This is a patched version of FM startup for the ROM 3 machine*	Note all the really ungroovy JSRL's in the file*** Inputs:	None** Outputs:	None** External Refs:* ROM Entry Points for use during the patching process...*LclRTL	equ $FC01C3ROMFMStartup	equ $FCA094oErrout	equ $FEFCB4*SetUpFMParams	equ $FCA7E3StdErr4	equ $FCC190GetHandle	equ $FCBF49LockBlock	equ $FCC121GetListHandles	equ $FCA527OpenFLFile	equ $FCA841OpenFONTSDir	equ $FCA421CheckFLFile	equ $FCA620GetFileNames	equ $FCA448SetUpFontInfo	equ $FCA1A7UpdateFLFile	equ $FCA960CloseFLFile	equ $FCA958ROMWeAreDone	equ $FCA11AROMFLFileGood	equ $FCA110UnlockFMParams	equ $FCC14BLockFMParams	equ $FCC145STDEnd4	equ $FCC189ROMError4	equ $FCA14FROMError2a	equ $FCA152ROMError2	equ $FCA155ROMError1a	equ $FCA18CROMError1	equ $FCA197CopyFileName	equ $FCBFD9*** Entry Points:********************************************************************************EntryLength	equ TempEntriesInBlock	equ EntryLength+2EntryCount	equ EntriesInBlock+2NumFiles	equ EntryCount+2NumFonts	equ NumFiles+2FileCount	equ NumFonts+2Mult2	equ FileCount+2Mult8	equ Mult2+2Mult16	equ Mult8+2RomInfoRec	equ Mult16+2	;the following items MUST appearRomFamNum	equ RomInfoRec	;in this orderRomStyle	equ RomFamNum+2RomSize	equ RomStyle+2RomFontHndl	equ RomSize+2RomNamePtr	equ RomFontHndl+4RomExtent	equ RomNamePtr+4;;added 8/31/87fNamePtr	equ RomExtent+2currFNamePtr	equ fNamePtr+4;fNameLen	equ currFNamePtr+4currFNameLen	equ fNameLen+2errCode	equ currFNameLen+2FLFileRef	equ errCode+2FONTSDirRef	equ FLFileRef+2FileListSize	equ FONTSDirRef+2NumFontFiles	equ FileListSize+2;added 9/24/87TimeListSize	equ NumFontFiles+2TimeHandle	equ TimeListSize+2TimePtr	equ TimeHandle+4SavedTimePtr	equ TimePtr+4fTimePtr	equ SavedTimePtr+4;end of additions -	BHM  x6245;***	cmp #0	;already initialized?	tax	;optimized 25-Nov-90 DAL	beq @Doit	;no	ldx #InitErr	;yes - so return error@stupidErr	ldy #4	;param size	jml oerrout@Doit*** added 25-Nov-90 DAL*** Return fmBadParmErr if they passed 0 for user id or dp address	ldx #fmBadParmErr	lda 7,s	beq @stupidErr	lda 9,s	beq @stupidErr*** end of 25-Nov-90 DAL	phd	lda 9,s	;get zero page address	tcd	ldx #$FEZPLoop	stz <FMZBase,x	;clear zero page	dex	dex	bpl ZPLoop	lda 11,s	;get program ID	sta <ProgID	;and save;;get RAM space for some mutable FM data, and move them in:	jsr SetUpFMParams	bcc GotFMParams	tax	;error code	jmp StdErr4GotFMParams;get a buffer for block reads:	lda #BlockSize	;512 bytes	JSRL GetHandle	;get space to do block reads into	bcc GotMem	sta <errCode	brl Error1	;return the errorGotMem	sta <BlockHandle	;get handle to block	stx <BlockHandle+2	JSRL LockBlock	JSRL GetListHandles	bcc GotListHandles	sta <errCode	brl Error1aGotListHandles*******************************************************************************  Error-handling changed here and below so that ProDOS errors in handling*  FONT.LISTS do not abort the start-up.  (In particular, trying to create*  and/or update FONT.LISTS when the system disk is write-protected does not*  generate an error; FONT.LISTS is just forgotten about is	those cases.)**  Bennet Marks  x6245  1/7/88******************************************************************************	JSRL OpenFLFile	;will also create it, if need be	bcc GotFLFile;some error condition - treat FONT.LISTS as invalid (i.e., useless)	JSRL OpenFONTSDir	bcc FLFileNotValid	;because it's empty	sta <errCode	brl Error2aGotFLFile		;and it's open, too	JSRL OpenFONTSDir	bcc GotFONTSDir	sta <errCode	brl Error3GotFONTSDir	JSRL CheckFLFile	bcc FLFileGood;some error condition - FONT.LISTS uselessFLFileNotValid;FONTS open, marked	at beginning & FONT.LISTS open, empty;;FONT.LISTS didn't pass its validity test, so we have to make;the lists "the old-fashioned way";	JSRL GetFileNames	bcc GotFileNames	brl Error5GotFileNames	JSRL SetUpFontInfo	bcc FontListsOK	sta <errCode	brl Error6FontListsOK	JSRL UpdateFLFile;ignore any errors - just because we can't;update FONT.LISTS doesn't mean we should quit;; 11/13/89 Mensch; But it does mean that the file that was written out is probably BAD!; Since this could easily be the case, we test for errors here and delete the file; if any errors occured in the process of writing the file.; This should fix bugs where bad font.lists were being created 	bcc FLFileDone	JSR KillBadFLFile	; font list file somehow bad, kill it!FLFileDone		;	bra WeAreDone;;FLFileGood		;	JML ROMFLFileGood	;WeAreDone	JML ROMWeAreDone	;;Error8		;Error7		;Error6		;Error5		;Error4		;	JML ROMError4Error3		;Error2a		;	JML ROMError2aError2		;	JML ROMError2	;Error1a		;	JML ROMError1aError1		;	JML ROMError1KillBadFLFile		;;; First close the file so that it can be destroyed...	jsrL CloseFLFile; Coppied this pre-amble from open file...;	lda <FMParamPtr	clc	adc #$63	sta <FilePtr	lda <FMParamPtr+2	adc #0	sta <FilePtr+2;	JSRL CopyFileName;	lda <FMParamPtr	clc	adc #$44	sta <KillNamePtr	lda <FMParamPtr+2	adc #0	sta <KillNamePtr+2;	jsr DestroyFile	; now call destroy...	rts	; and exit the hell outta here...DestroyFile	pea 0	;high word of parameter block address	tdc	clc	adc #ProDOSParams	;low word	pha	pea DestroyCall	;call number	jsl StackProDOS	;ProDOS/16 stack-based entry vector	tax	;error code (if any)	rts******************************************************************************			                **  subroutine SetUpFMParams		                **			                **    started 8/26/87		                **    Bennet Marks  x6245		                **			                **  This subroutine obtains a block of RAM that the Font Manager can use     **  for parameters that it needs to alter, or may need to alter, such as     **  font file names (for the Open call, for example) and window parameters   **  (which are different in 320 and 640 mode).	                **			                **  When the Font Manager lived in RAM, this information/storage was kept    **  in-line.  We still have the defaults	in-line, but SetUpFMParams copies   **  them over into the RAM space it obtains.	                **			                **  SetUpFMParams has changed so much since its earlier incarnation (when    **  it was mainly used to get ProDOS parameter block space, which is now     **  mainly on 0-page) that we have changed its name from SetUpParams.  Does  **  this make it a born-again subroutine?	                **			                **  If the subroutine succeeds in allocating the space for the parameter     **  blocks, it returns with the carry clear.  Otherwise it returns with the  **  carry set (and the MM error code in the acc.).	                **			                **  As currently written, SetUpParams returns with an RTS and does not have  **  a separate entry	point.  It's just part of FMStartUp.                    **			                ******************************************************************************;****************************************	                  **  11/10/87 3:50 pm	                  **  BHM  x6245	                  **	                  ****************************************;************************************************************		                  **  major re-write, subroutine renamed -	                  **    BHM  x6245  11/10/87	                  **		                  ************************************************************SetUpFMParamsFMParams	equ $FC9E92EndOfFMParams	equ $FC9FFAGDENameBuf	equ $FC9EC2GDENameBufPtr	equ $FC9E9AGDECreateTime	equ $FC9EAA	lda #(EndOfFMParams-FMParams)	JSRL GetHandle	bcc GotFMParamMem	rts;GotFMParamMem	sta <FMParamHandle	stx <FMParamHandle+2	JSRL LockFMParams;;transfer default values (and a lot of needless zeros):;	lda #<FMParams	sta <tempPtr	lda #^FMParams	sta <tempPtr+2;	ldy #(EndOfFMParams-FMParams-2);NextParamWord	lda [<tempPtr],y	sta [<FMParamPtr],y	dey	bmi ParamsMoved	dey	bra NextParamWord;ParamsMoved;;set up a few needed pointers:;GDE name buffer:	lda <FMParamPtr	clc	adc #(GDENameBuf-FMParams)	sta <tempPtr	ldy #(GDENameBufPtr-FMParams)	sta [<FMParamPtr],y	lda <FMParamPtr+2	bcc NoCarryb	inc aNoCarryb	sta <tempPtr+2	iny	iny	sta [<FMParamPtr],y;;we need easy access to the GDE file name string	lda <tempPtr	clc	adc #3;(that's a 3 to access the length byte we swap into place from;the length word provided by GetDirEntry)	sta <fNamePtr	lda <tempPtr+2	bcc NoCarryc	inc aNoCarryc	sta <fNamePtr+2;;we also need a pointer to the times & dates within the GetDirEntry block:	lda <FMParamPtr	clc	adc #(GDECreateTime-FMParams)	sta <fTimePtr	lda <FMParamPtr+2	bcc NoCarryd	inc a	clcNoCarryd	sta <fTimePtr+2	rts	ENDP****************************************************************** Lock & unlock*****************************************************************UnLockIDList	proc	ldy #4	lda [<IDHandle],y	and #$7FFF	;set locked bit in attribute word	sta [<IDHandle],y	rts	Entry LockIDListLockIDList			ldy #4	lda [<IDHandle],y	ora #$8000	;set locked bit in attribute word	sta [<IDHandle],y	lda [<IDHandle]	;dereference handle	into correct ptr	sta <IDPtr	ldy #2	lda [<IDHandle],y	sta <IDPtr+2	rts	ENTRY IncIDPtrIncIDPtr	;Increment IDPtr to	point to the next entry in the ID list.	clc	lda <IDPtr	adc #14	sta <IDPtr	lda <IDPtr+2	adc #0	sta <IDPtr+2	rts	ENDP	EJECT********************************************************************************FixFontList	PROC** Description:	This routine will extract the last entry from the font list*	and see if it is duplicated anywhere else in the list. If*	it is, It will be moved to the lower entry, and the list will be*	shortened*** Inputs:	NONE : Font mgr direct page should be setup...** Outputs:	None** External Refs:** Entry Points:********************************************************************************	jsr LockIDList	; lock the ID List down...;; First create a pointer to the last entry in the list...; and save it in tempPtr	lda <IDCount	; get the number of entries in the ID List	dec a	; subtract 1 from it to get entry number...	beq @Done	; *** added this line 14-Nov-90 DAL	asl a	; A=IDCount*14	pha	asl a	pha	asl a	clc	adc 1,s	adc 3,s	ply 	; resave the data	ply	; discard some crap...;; Now if the carry was set the IDlist is larger than 64k...	bcc @1	jmp @Done	; exit with an error@1	adc <IDPtr	; add to the IDPointer	sta <tempPtr	lda #0	; now do the high word	adc <IDPtr+2	sta <tempPtr+2; Now that we have the two entries set up scan the list for duplicate	ldx #1	ldy #2@Loop	lda [<IDPtr]	; get the current ID	cmp [<tempPtr]	; compare it with the new ID	bne @NextID	lda [<IDPtr],y	; get the style	cmp [<tempPtr],y	beq @FoundMatch	; if equal we found a match@NextID	jsr IncIDPtr	; bump the pointer	inx	cpx <IDCount	; see if we are done	blt @Loop	; be sure to skip the last one...	@Done	jsr UnLockIDList	; unlock the ID List	rts	; and return;; We get tro here if the two ID's matched; If this happens we have a duplicate entry, and the entry at IDPtr is bogus; so replace the entry at IDPtr with the one at tempPtr and discard the handle; of the first.@FoundMatch	ldy #12	; first discard the handle in IDPtr	lda [<IDPtr],y	pha	ldy #10	lda [<IDPtr],y	pha	_DisposeHandle	; throw away the old font handle.;; Now copy the new entry back into the list	ldy #0	; we start at the start@CopyLoop	lda [<tempPtr],y	; copy 14 bytes over...	sta [<IDPtr],y	iny	iny	cpy #14	blt @CopyLoop;; Now cut the list itself back to where it belongs	dec <IDCount	; this should do it!	lda <IDListSize	sec	sbc #14	sta <IDListSize	bra @Done	EndP	EJECT********************************************************************************NewInstallStats	PROC** Description:	This is a new install font call that will be patched to get rid*	of the orphan problem*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************FMDPage	equ 1oldDPage	equ FMDPage+2theRTLs	equ oldDPage+2resultPtr	equ theRTLs+6scaleWord	equ resultPtr+4desiredID	equ scaleWord+2;; Set up the stack for the new call...	phd	; save the current DPage	pha	; save the FMDPage	tsc	; get the stack pointer and make it	tcd	; the current pdage	lda #0	; zero our flag	sta >KludgeFlag; set up the parms for the call@CallItAgainSam	pei desiredID+2	pei desiredID	pei ScaleWord	pei ResultPtr+2	pei ResultPtr	jsl xInstallStat	; call the real install font	tax	bcc @skipKludge	; test if an error occured	lda >KludgeFlag	; see if this is the second time thru	bne @SkipKludge	dec a	; if not set the second time thru flag and	sta >KludgeFlag	; try it again!	bra @CallItAgainSam	; and try it one more time...@SkipKludge	txa	pld	; get the FMDPage back again	bcs @anError	; an error occured so explode...;; No bugs here so lets get on with it....		jsr FixFontList	; repair the font list	lda #0	clc@AnError	pld	; get the apps dpage back...	tay	; save the error code in <Y>	lda 1,s	; move the RTL's down 10 bytes	sta 11,s	lda 3,s	sta 13,s	lda 5,s	sta 15,s	pla	; discard 10 bytes of parms	pla	pla	pla	pla	tya	; place error back into <A>	cmp #1	; set error flag properly	rtl	; and end...xInstallStat	lda <FMDPage	; font manager dpage in <A>	jsl $FCB4D5	; call the real install font	rtl	ENTRY KludgeFlagKludgeFlag	ds.W 1	EndP		EJECT********************************************************************************NewInstallFont	PROC** Description:	This is a new install font call that will be patched to get rid*	of the orphan problem*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************FMDPage	equ 1oldDPage	equ FMDPage+2theRTLs	equ oldDPage+2scaleWord	equ theRTLs+6desiredID	equ scaleWord+2;; Set up the stack for the new call...	phd	; save the current DPage	pha	; save the FMDPage	tsc	; get the stack pointer and make it	tcd	; the current pdage	lda #0	; init flag so only retry once.	sta >KludgeFlag@CallItAgainSam; set up the parms for the call	pei desiredID+2	pei desiredID	pei ScaleWord	jsl xInstallFont	; call the real install font	tax	bcc @skipKludge	; test if an error occured	lda >KludgeFlag	; see if this is the second time thru	bne @SkipKludge	dec a	; if not set the second time thru flag and	sta >KludgeFlag	; try it again!	bra @CallItAgainSam	; and try it one more time...@SkipKludge	txa	pld	; get the FMDPage back again	bcs @anError	; an error occured so explode...;; No bugs here so lets get on with it....		jsr FixFontList	; repair the font list	lda #0	clc@AnError	pld	; get the apps dpage back...	tay	; save the error code in <Y>	lda 1,s	; move the RTL's down 6 bytes	sta 7,s	lda 3,s	sta 9,s	lda 5,s	sta 11,s	pla	; discard 6 bytes of parms	pla	pla	tya	; place error back into <A>	cmp #1	; set error flag properly	rtl	; and end...xInstallFont	lda <FMDPage	; font manager dpage in <A>	jsl $FCAD6F	; call the real install font	rtl	EndP	*****************************************************************FakeErrors	PROC** Returns dispatcher errors for these calls if the * font manager is not active.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:	ENTRY InstallFont	ENTRY InstallWithStats*	longa on	; mode	longi on*****************************************************************InstallFont	cmp #0	bne WereActive	cpy #0	bne WereActiveReturnError	lda #2	sec	rtlWereActive	jml NewInstallFontInstallWithStats	cmp #0	bne WereActive2	cpy #0	beq ReturnErrorWereActive2	jml NewInstallStats	ENDP**********************************************************************************DoADirtyDeed	Proc Export** This procedure is the choosefont patch for ROM 3. It is called when setport detects* a certain return address. This will be the proper place in choosefont to aply a patch* This patch will first test to see if cancel was hit in the choosefont dialog, if so* it will simply exit with no further code, if cancel was not hit, this patch will* replace the second return address on the stack with one from a local end to the * choosefont routine. It will then resume setting the port, and setport will return * to me instead of the ROM.************************************************************************************ The following are the addresses of important routines in ROM that we will be using*LclRTL	equ $FC01C3UnlockFMParams	equ $FCC14BROMSetFontDone	equ $FCB85A************************************************************************************ Choosefont direct page equatesTaskRec	equ Temp	;must be first!TempStyle	equ TaskRec+24CntlHndl	equ TempStyle+2CntlHndls	equ CntlHndl+4	;these 3 items must	be in this orderPlainHndl	equ CntlHndlsStyleHndls	equ PlainHndl+4LinePtr	equ StyleHndls+20Count	equ LinePtr+4Index	equ Count+2CancelFlag	equ Index+2CurNum	equ CancelFlag+2CurStyle	equ CurNum+2CurSize	equ CurStyle+2MDCtlHandle	equ CurSize+2SizeCtlHandle	equ MDCtlHandle+4** STack Equates for the stack of setport...*SPRTL1	equ 1SPRTL2	equ SPRTL1+3thePortPtr	equ SPRTL2+3** The code leading up to this point is...**	PushZLong <WindPtr*	_CloseWindow	;close window**	PushZLong <MDHandle*	_DisposeHandle	;dispose of MD list**	jsr UnLockNameList*	jsr UnlockFMParams**	_SetPort	;restore port** And now for the patch...* Conveniently the direct page is already set up to the font manager dpage...* Note: At this point we must preserve <X> and <Y>*	lda <CancelFlag	; test to see if cancel was hit	beq OKWasHit	; if zero then the OK button was hit	brl FinishSetPort	; at this stage the patch need not be applied so.. just quitOKWasHit; Now we fudge RTL1 to point back to us!	lda >PatchEntry	sta SPRTL2,s		lda >PatchEntry+1	sta SPRTL2+1,s; And we finish the setport call..	brl FinishSetPort*PatchEntry	dc.L theDirtyDeed** Now for the patch itself, it simply idles the cursor and calls choosefont the correct way...* Code taken fron the font manager. Remember we are still in the font manager direct page at this pointtheDirtyDeed	NOP	; added for rtl offsetting	plb	;restore data bank register; Don't have to test cancel any more...;	lda <CancelFlag	;was Cancel hit?;	bne Done	;yes;compare selected fontID against original fontID	lda <CurSize	;create style/size word	xba	ora <CurStyle	tay	;and save	cmp 13,s	;compare with original style/size	bne InstallNew	;different so install new font	lda <CurNum	cmp 11,s	;compare fam #	bne InstallNew	;different so install new font	bra Done	;new font = old font, so no change;new font is different from old font so	install itInstallNew	phy	;style/size	PushZWord <CurNum	;fam #	PushWord #0	;enable scaling	;; 1/5/90 Mensch;; Added code here that idle's the cursor for the instal font call.; this puts up the watch cursor when needed.;	pha	pha	_GetCursorAdr	pla	sta <WindPtr	; use wind pointer to store temp value	pla	sta <WindPtr+2		_WaitCursor	; put up the watch cursor...		_InstallFont	;install font	PushLong <WindPtr	; put the cursor back...	_SetCursor	;return selected fontIDDone	JML ROMSetFontDone	END