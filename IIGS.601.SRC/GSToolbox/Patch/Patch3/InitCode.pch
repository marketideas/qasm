******************************************************************************** InitCode.Pch** (C)  Copyright Apple Computer, Inc. 1990* All rights reserved.** by Jim Mensch* 5/11/90** This file will contain all the 1 time code required for the ts3 patch. This way* It can all be unloaded at the same time.*** Modification History:** Version 1.0	Mensch** 24-Sep-90	Dave Lyons** Added patch entries for new calls:  Get640Colors and Set640Color.** 22-Oct-90	Dave Lyons** Added patch entry for new call GetScanlineAddr ($DC04).** 25-Nov-90	Dave Lyons** Added TablePatch entries for MyClearScreen and MyQDShutDown.** 14-Feb-91	Dave Lyons** Removed GetScanlineAddress.** 18-Feb-91	Dave Lyons** Re-enabled the MySetCursor patch (by Mensch for animated-cursor support).** 11-Mar-91	Dave Lyons** Removed MySetCursor again.  Not that hot, and it seems to cause cursor* wars with Video Keyboard.** 5-Aug-91	Dave Lyons** Patched SetCursor *again*...this time, it looks at bit 31 of the new* cursor pointer.** 27-Nov-91	Dave Lyons** Added tablePatch for InflateTextBuffer.********************************************************************************	include 'all.macros'	include ':::qd:qdequates:qd.data.asm'	INCLUDE ':::qd:QDEquates:CORE.GLOBALS1'	INCLUDE ':::qd:QDEquates:core.globals2'	INCLUDE ':::qd:QDEquates:region.equs'	INCLUDE ':::qd:QDEquates:RECT.EQUS'	INCLUDE ':::qd:QDEquates:SLAB.EQUS'	INCLUDE ':::qd:QDEquates:rgndefs.equs'	include 'e16.memory'	Import iDrawCursor	Import iunDrawCursor	Import AnRTL	import iSetStuffAdr	import iBlowItUp	import DoADirtyDeed		; from FontMgr.Pch* re-enabled these 2 lines 17-Sep-90 DAL	import DoADirtyDeed2	; from MenuMgr.Pch	import DoADirtyDeed3	; from MenuMgr.Pch*	Import iSetUpScanPtrs	import MyClearScreen	; from QD.pch	import MyQDShutDown		; from QD.pch	import MyInflateTextBuffer	; from QD.pch*******************************************************************************	MACRO&lab	Patch &name&lab	lda #<i&name	sta |&name+1	lda #>i&name	sta |&name+2	MEND	MACRO&Lab	TablePatch &RtnName,&CallNum&Lab	ldy #&CallNum*4	lda #&RtnName-1	sta [LocalTemp],y	iny	iny	lda #^&RtnName	sta [LocalTemp],y	MEND*****************************************************************InstallQDPatch	PROC Export** This routine installs the patches to QD's vectors and* returns*** Inputs:*	none** Outputs:*	all registers may be trashed.** External Refs:	import SetPort** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************NumQDCalls	equ $DB		;22-Oct-90 DALCallTableSize	equ 4*(NumQDCalls+1)LocalTemp	equ 0SetPortOffset	equ $1B*4*** re-enabled these 2 lines 17-Sep-90 DALSetForeColorOffset	equ $A0*4		; offset into call table for SetForeColorPtInRectOffset	equ $4F*4		; offset into call table for PtInRect	phb	pea $E0E0	plb	plb	Patch GimmeVersion	Patch SetSlabAdr	Patch SetSliceAdr	Patch RotateMask	Patch SeekRgn	; fix the scan up stuff in seek rgn	Patch SetUpScanPtrs;	patch DrawCursor	; removed for 5.0.3;	patch unDrawCursor		plb;; Get memory for the call table;	pha	pha	PushLong #CallTableSize	pha	_MMStartup	PushWord #attrFixed+attrNoSpec	pha	pha	_NewHandle;; Deref the handle put result in LocalTemp; 	pla	sta LocalTemp	pla	sta LocalTemp+2	ldy #2	lda [LocalTemp],y	tax	lda [LocalTemp]	sta LocalTemp	stx LocalTemp+2;; Zero the call table;	ldy #CallTableSize-2	lda #0@Loop	sta [LocalTemp],y	dey	dey	bpl @Loop;; Put the number of calls into the call table;	lda #NumQDCalls+1	sta [LocalTemp];; Point the boot init to an RTL;	lda #AnRTL-1	ldy #4	sta [LocalTemp],y	iny	iny	lda #^AnRTL	sta [LocalTemp],y;; Point SetPort to the patch;	ldy #SetPortOffset	lda #SetPort-1	sta [LocalTemp],y	iny	iny	lda #^SetPort	sta [LocalTemp],y;; Point SetForeColor to the patch; (re-enabled this patch 17-Sep-90 DAL)	ldy #SetForeColorOffset	;patch out _SetForeColor	lda #SetForeColor-1	sta [LocalTemp],y	iny	iny	lda #^SetForeColor	sta [LocalTemp],y;; Point PtInRect to the patch	; (re-enabled this patch 17-Sep-90 DAL)	ldy #PtInRectOffset		;patch out _PtInRect	lda #PtInRect-1	sta [LocalTemp],y	iny	iny	lda #^PtInRect	sta [LocalTemp],y;; And of course the rest of the patches...		tablePatch SectRgn,$71	tablePatch UnionRgn,$72	tablePatch DiffRgn,$73	tablePatch XorRgn,$74		tablePatch MySetCursor,$8E	;re-enabled 5-Aug-91 DAL	tablePatch MyStartup,$02	tablePatch Get640Colors,$DA	;24-Sep-90 DAL	tablePatch Set640Color,$DB	;24-Sep-90 DAL	tablePatch MyClearScreen,$15	;25-Nov-90 DAL	tablePatch MyQDShutDown,$03	;25-Nov-90 DAL	tablePatch MyInflateTextBuffer,$D7	;27-Nov-91 DAL;; Install the patch;	PushWord #0	PushWord #4	pei LocalTemp+2	pei LocalTemp	_SetTSPtr	RTL	EndP	End