	title 'List Mgr Patch        GS ROM 3 Patch'******************************************************************** List manager patches for ROM 3** System Disk 5.0** 5/18/89	Steven Glass** 31 May 89	Harry Yee** Take prototype bit out of version number. Final version = 3.1* for System Disk 5.0.** 12/19/89	Mensch** Fixed new list II bug for monte.** 26-Sep-90	Dave Lyons** Version $8303.  (The list_disp procedure in ListMgr.asm* has changed.)** 25-Nov-90	Dave Lyons** Add new ListKey function (code in the main ListMgr file).** 4-Dec-90	Dave Lyons** Abandoning the List patch--ROM 3 is going to use TOOL028 now.************************************************************************************************************************************			   **              Copyright (C) 1989-90		   **              All Rights Reserved		   **              Apple Computer, Inc.		   **			   *****************************************************************	Blanks off	String asis		include ':::ListMgr:ListEquates.asm'	MACRO&lab	ROMCALL &where&lab	phk	pea @1-1	pea |TheRTL-1	jml &where@1	MENDListCallTable	PROC EXPORT	import GetListDefProc	import ListVersion	import NewList2	import ListKey	;from ListMgr:ListMgr.asm (25-Nov-90 DAL)FPT	DC.L (ENDFPT-FPT)/4	DC.L 0	; ListBootInit-1	$011C	DC.L 0	; ListStartup-1	$021C	DC.L 0	; ListShutDown-1	$031C	DC.L ListVersion-1		$041C	DC.L 0	; ListReset-1	$051C	DC.L 0	; ListStatus-1	$061C	DC.L 0	; Reserved-1	$071C	DC.L 0	; Reserved-1	$081C	DC.L 0	; CreateList-1	$091C	DC.L 0	; SortList-1	$0A1C	DC.L 0	; NextMember-1	$0B1C	DC.L 0	; DrawMember-1	$0C1C	DC.L 0	; SelectMember-1	$0D1C	DC.L GetListDefProc-1 	$0E1C	DC.L 0	; ResetMember-1	$0F1C	DC.L 0	; NewList-1	$101C;List Manager 2 calls	DC.L 0	; DrawMember2-1	;$111C	DC.L 0	; NextMember2-1	;$121C	DC.L 0	; ResetMember2-1	;$131C	DC.L 0	; SelectMember2-1 	;$141C	DC.L 0	; SortList2-1	;$151C	DC.L NewList2-1		;$161C	dc.l ListKey-1		;$171C  added 25-Nov-90 DALENDFPT		 	ENDPListVersion	PROC	lda #$8303	;26-Sep-90 DAL	sta 7,s	ENTRY QuickReturnQuickReturn	lda #0	clc	rtl	ENDP;==========================================================================;;	GetListDefProc;;         	Return the address of the list definition procedure.;;   IN:    None.;;  OUT:    Address of list definition procedure.;==========================================================================GetListDefProc	PROC	import ListProcTheResult	equ 7	lda #ListProc>>16	Pass pointer to list control defProc.	sta TheResult+2,s	lda #ListProc	sta TheResult,s	bra QuickReturn		ENDP;==========================================================================;;          	ListProc.;;	List DefProc;;   IN:    PUSH:WORD - operation.;          PUSH:LONG - operation parameter.;          PUSH:LONG - handle of control.;;  OUT:    LONG - return operation parameter.;;==========================================================================	ENTRY ListProcListProc	PROC	import list_disp	import list_value	;26-Nov-90 DAL	import getListRect	;26-Nov-90 DALLockNLoad	equ $FCF993TheRTL	equ $FCF195BackIntoROMEarly	equ $FCF0F3BackIntoROMAtEnd	equ $FCF149	phd	Save original direct page.	tsc	Allocate some work space on the stack.	sec	sbc #savezpage-1	tcs	tcd	Switch direct page into stack.;; --- Look at the operation code ---------------------------;	lda <operation	cmp #newValue	;26-Nov-90 DAL	bne @notNewListVal	;26-Nov-90 DAL	brl DoFastListValue	;26-Nov-90 DAL@notNewListVal	cmp #dispCntl	;is it the dispose command?	beq @isListDispose	jml BackIntoROMEarly@isListDispose;; we now move the fields from the control record that are used by list_disp; to direct page.;	ROMCall LockNLoad	Lock and derefence control's handle.	ldy #CtlFlag	; we need the string type and	lda [cptr],y	and #1	sta <strgType	ldy #CtlData+2	; the data size	lda [cptr],y	sta <DataSize	stz <result	stz <result+2	jsr list_disp	jml BackIntoROMAtEndDoFastListValue	ROMCall LockNLoad	Lock and derefence control's handle.	jsr getlistRect	crect = enclosing RECT.	ldy #CtlMemHeight	Break out height of	members.	lda [cptr],y	sta <memHeight	ldy #CtlData	lda [cptr],y	sta <ViewSize	iny	iny	lda [cptr],y	sta <DataSize	ldy #CtlValue	lda [cptr],y	sta <DisplayTop	ldy #CtlFlag	lda [cptr],y	and #1	sta <strgType	stz <result	stz <result+2	jsr list_value	jml $fcf149	;SkipIntMess in ROM 3		ENDP;==========================================================================;	;	NewList2;;         	Put a new list in a list control.;;   IN: 	PUSH:LONG - DrawPtrR;   	PUSH:WORD - ListStartR;	PUSH:LONG - ListRefR;	PUSH:WORD - ListRefDiscriptorR;	PUSH:WORD - ListSizeR;	PUSH:LONG - CtlHandle;;  OUT:    None.;; Change History;; 18 May 89	Steven Glass;; This code added to account for case found by Monte where we call; NewList2 and the new list has fewer members.  So many fewer in; fact that the original first seen is such that we run out of; items before we re run out of space.;; The problem only occurs if we try to change the list and not; the first seen.;;; 12/19/89	Mensch; This fixes the previous patch. Some times when the list grew the data would not; be updated properly. This was causing problems. The solution is to only allow the; fix to apply when the control shrinks.;;==========================================================================	ENTRY NewList2NewList2	PROCCwrkPtr	equ 1CtlPtr	equ CwrkPtr+4dreg	equ CtlPtr+4rtl1	equ dreg+2rtl2	equ rtl1+3CtlHandle	equ rtl2+3ListSizeR	equ CtlHandle+4ListRefDiscriptorR	equ ListSizeR+2ListRefR	equ ListRefDiscriptorR+2ListStartR	equ ListRefR+4DrawPtrR	equ ListStartR+2BackIntoROM	equ $FCEDAC	phd	pha	;space for CtlPtr	pha	pha	;space for CworkPtr	pha		tsc	tcd;; Deref control handle;	ldy #2	lda [CtlHandle],y	sta <CtlPtr+2	lda [CtlHandle]	sta <CtlPtr;; Set the first item viewed in the list control and the ; associated scroll bar.;	lda <ListStartR		cmp #$FFFF	bne NoFutzingNeeded; Monte does not want to change the first shown item.  So lets make; sure that the current first shown item is valid.  If it is not,; we must back it up one.  (This only happens is the new list; is smaller than the old list and the first shown makes the old; last item show.	lda <ListSizeR	; see if the list size has changed...	cmp #$FFFF	beq NoFutzingNeeded	; list size did not change so... don't worry	ldy #CtlData+2	; take the data size of existing list	cmp [CtlPtr],y	; and see if it is larger than the new list size	bge NoFutzingNeeded	; the new list is bigger so quit this..; else... <A> has size from the new list; so futz based on the new lists size...	sec	dey	dey	sbc [CtlPtr],y	; subtract the view size	ldy #CtlValue	cmp [CtlPtr],y	; and compare to the current value	bpl NoFutzingNeeded	lda [CtlPtr],y	dec a	bne @1	lda #1@1	sta <ListStartRNoFutzingNeeded	jml BackIntoROM	ENDP	END