************************************************************************ Patch to Text Tools (ROM 03)** Copyright 1991-1992 Apple Computer, Inc* All Rights Reserved************************************************************************* 5-Nov-91	Dave Lyons** New file (started with skeleton from TS2 Text.Tools.asm).** Patch TextVersion (version $8301).** Patch GetInputDevice, GetOutputDevice, GetErrorDevice to pre-zero* the result space for the device type, so we don't return garbage* for the Set calls to choke on (at -least- for SetInputDevice, it's* a problem to have device type $xx02, for a RAM-based driver).** (By the way, this means that SaveTextState/RestoreTextState breaks* under APW 2.0, since a RAM-based Text Tools driver is active.)** 5-Feb-92	Dave Lyons** Version $0301 for 6.0 final.***********************************************************************	include 'all.macros'	include ':::sys.equs.asm'TextVersionNumber	equ $0301;-----------------------------------------------------------;; Equates for addresses in bank E1.;ANDin	equ $E115AAORin	equ ANDin+1ANDout	equ ORin+1ORout	equ ANDout+1ANDerr	equ ORout+1ORerr	equ ANDerr+1DevType	equ ORerr+1DevPtr	equ DevType+3InDevPtr	equ DevPtrOutDevPt	equ InDevPtr+4ErrDevPt	equ OutDevPt+4ErrHook	equ ErrDevPt+4*****************************************************************TTCallTable	PROC EXPORT** Contains the calls to patch in the text tools tool set.*** Inputs:*	none** Outputs:*	none** External Refs:	import TextVersion	import TextBootInit	import GetInDev	import GetOutDev	import GetErrDev** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************Here	dc.L (TheEnd-Here)/4	; num calls +1	dc.L TextBootInit-1 ;$010C TextBootInit	dc.L 0	;$020C TextStartUp	dc.L 0	;$030C TextShutDown	dc.L TextVersion-1	;$040C TextVersion	dc.L 0 	;$050C TextReset	dc.L 0 	;$060C TextStatus	dc.L 0 	;$070C	dc.L 0 	;$080C	dc.L 0 	;$090C SetInGlobals	dc.L 0 	;$0A0C SetOutGlobals	dc.L 0 	;$0B0C SetErrorGlobals	dc.L 0 	;$0C0C GetInGlobals	dc.L 0 	;$0D0C GetOutGlobals	dc.L 0 	;$0E0C GetErrGlobals	dc.L 0 	;$0F0C SetInputDevice	dc.L 0 	;$100C SetOutputDevice	dc.L 0	;$110C SetErrorDevice	dc.L GetInDev-1	;$120C, patched 4-Nov-91 DAL	dc.L GetOutDev-1	;$130C, patched 4-Nov-91 DAL	dc.L GetErrDev-1	;$140C, patched 4-Nov-91 DAL	dc.L 0	;$150C InitTextDev	dc.L 0	;$160C CtlTextDev	dc.L 0	;$170C StatusTextDev	dc.L 0	;$180C WriteChar	dc.L 0	;$190C ErrWriteChar	dc.L 0	;$1A0C WriteLine	dc.L 0	;$1B0C ErrWriteLine	dc.L 0	;$1C0C WriteString	dc.L 0	;$1D0C ErroWriteString	dc.L 0	;$1E0C TextWriteBlock	dc.L 0	;$1F0C ErrWriteBlock	dc.L 0	;$200C WriteCString	dc.L 0	;$210C ErrWriteCString	dc.L 0	;$220C ReadChar	dc.L 0	;$230C TextReadBlock	dc.L 0	;$240C ReadLineTheEnd	ENDP*****************************************************************StdTextCalls	PROC** Contains the Version call and the boot init call*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:	ENTRY TextVersion	ENTRY TextBootInit*	longa on	; mode	longi on*****************************************************************TextVersion	lda #TextVersionNumber	sta 7,sTextBootInit	lda #0	clc	rtl	ENDP****************************************************************** GetInDev, GetOutDev, GetErrDev** Patched 5-Nov-91 DAL to pre-zero the device-type output word.*****************************************************************GetInDev	proc export	lda #0	sta 11,s	jml >$fec098	EndPGetOutDev	proc export	lda #0	sta 11,s	jml >$fec0cd	EndPGetErrDev	proc export	lda #0	sta 11,s	jml >$fec0d2	EndP	END