******************************************************************************** mystuff...** (C)  Copyright Apple Computer, Inc. 1990* All rights reserved.** by Jim Mensch* _Date_** _Description_** Files:**** Modification History:** Version 1.0	_Author_*********************************************************************************	include 'all.macros'		include ':::qd:qdequates:qd.data.asm'	INCLUDE ':::qd:QDEquates:CORE.GLOBALS1'	INCLUDE ':::qd:QDEquates:core.globals2'	INCLUDE ':::qd:QDEquates:region.equs'	INCLUDE ':::qd:QDEquates:RECT.EQUS'	INCLUDE ':::qd:QDEquates:Slice.EQUS'	INCLUDE ':::qd:QDEquates:rgndefs.equs'		iSetSliceAdr	PROC  Export	Import oldSetSliceAdr	Import FastSlicesLoop	Import ToClipperSlice		lda XFerMode	; take the tranfer mode	and #$7F	; mask off not bit	asl a	; double	asl a	; and double again	tax	; put in x		lda HowFarToShift	; if i don't have to shift at all	beq UseFastSlices	; then I can use the fast slice routines;; At this point it might be nice to determine if we are shifting >8 bits. If so, we; might have a speed up we can do by decrementing the source address by 1..;	sec;	sbc #8;	bmi @NotBy8;	sta HowFarToSHift	; zero out how far to shift...;	bne @ByMoreThan8;	lda SrcRef;	beq @NotBy8	; forget this case completely...;	dec a;	sta SrcRef	; subtract 1 from the source ref;	bra UseFastSlices	; and do it the fast way bub...@ByMorethan8;	lda SrcRef	; bump lower source ref for grins sake..;	beq @NotBy8	; forget this case completely...;	dec a;	sta SrcRef	; subtract 1 from the source ref @NotBy8;; Now see if we are being called  with AllRectRegions..	lda NonRectRegions	; called for non-rectangular dudes?	bne @UseClipping	; now see if we are using the mode copy dudes...	Import ToClipperSlice	bit HorBackward	; oh well so I use the slow ones.	bpl @ClippLessForward	lda >BackClipperTable+2,x	sta >ToClipperSlice+2	lda >BackClipperTable,x	bra @StoreIt@ClippLessForward		; 	lda >SliceClipperTable+2,x	sta >ToClipperSlice+2	lda >SliceClipperTable,x@StoreIt	sta >ToClipperSlice	pla	; now skag off the retufn address	phb	; add a byte that we can skank off 2	pla; now just return to the proper routine! he he he	jmp FastSlicesLoop@UseClipping	bit HorBackward	; oh well so I use the slow ones.	bpl SlowHorIsForward	lda >BackSliceAdrTable,x	sta >ToSlice	lda >BackSliceAdrTable+2,x	bra StoreItSlowHorIsForward		; 	lda >SliceAdrTable,x	sta >ToSlice	lda >SliceAdrTable+2,xStoreIt	sta >ToSlice+2	rtlUseFastSlices		; 	jml OldSetSliceAdr	; jump back to the old routine here!SliceAdrTable	jml FCopySlice	jml FORSlice	jml FXORSlice	jml FBICSliceBackSliceAdrTable	jml BFCopySlice	jml BFORSlice	jml BFXORSlice	jml BFBICSlice;; NOTE:; Removed jsr ability to clipper slices, since we don't want to burn the code to patch all the; existing slices, instead what we will do is continue to jsl them. NOTE: These are NOT to be placed; in toSlice ever!;SliceClipperTable	jsl cFCopySlice	jsl FORSlice	jsl FXORSlice	jsl FBICSliceBackClipperTable	jsl BFCopySlice	jsl BFORSlice	jsl BFXORSlice	jsl BFBICSlice	ENDP		EJECT********************************************************************************FastSlicesLoop	PROC Export** Description:	This is the location we return to when we discover that we can*	call the fast slices from rgnBlt. NOTE that this duplicates a*	portion of the slices code and works with both ROMS...*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************	Export ToClipperSlice	jsl Seek3RegionsPaintLoop	plp	; get v flag back	php	; save for later tooToClipperSlice	jsl ToSLice	lda CurrentY	inc a	cmp DestRect+4	bpl TheEnd	; unsigned compare dummy 28 Mar 86	sta CurrentY	lda SrcWidth	clc	adc SrcRef	sta SrcRef	bcc NoCarrySrc	; must carry accross banks	inc SrcRef+2NoCarrySrc	lda DestWidth	clc	adc DestRef	sta DestRef	bcc NoCarryDest	inc DestRef+2	phb	; must also update the data bank	lda DestRef+1	; register	sta 0,s	plbNoCarryDest		; 	bra PaintLoopTheEnd	jsl UnShieldCursor	plp	; clean up stackAllDone	jsl Free3RegionsNeverMind	plb	lda #0	clc	rtl	EndP	;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT ShiftOut	IMPORT ShiftStay	IMPORT xShiftOut	IMPORT xShiftStay***************************************************************** Clipper slices* These are all the slices that do not require use of clipping* ain't they grand?****************************************************************cFCopySlice	PROC Export	Import OutTable	Import StayTable		stz ShiftTemp	; Zero this for later use	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	bmi Loop	; dec it when it was 0MaskFirstWord	lda [ScanMaskRef],y	cmp #$FFFF	beq Loop	jsr ClipThisWord	bra BumpIndexesLoop		; 	ldy SrcIndex	lda [SrcRef],y	sta ThisWord	iny	iny	sty SrcIndex	ldx HowFarToShift	jsr (OutTable,x)	sta ShiftTemp2	; save it	lda ThisWord	jsr (StayTable,x)	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	sta (DestRef),y	; and store it.BumpIndexes		; 	lda ShiftTemp2	sta ShiftTemp	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	; branch less than we keep...		lda [ScanMaskRef],y	cmp #$FFFF	jsr ClipThisWord	iny	iny	sty DestIndexAllDone	rtlClipThisWord	sta CombinedMask	; put in combined mask	eor #$FFFF	; invert combined mask	and (DestRef),y	sta NotMaskAndDest			ldy SrcIndex	; Get source word	lda [SrcRef],y	sta ThisWord	; save for later	iny	iny	sty SrcIndex	ldx HowFarToShift	jsr (OutTable,x)	sta ShiftTemp2	; save it	lda ThisWord	jsr (StayTable,x)	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ora NotMaskAndDest	; merge with original part that stays	ldy DestIndex	bmi @end	; again if it was neg then special	sta (DestRef),y	; and store it.@end	rts	ENDP;                COPY SLICES/SLICES****************************************************************** Slices** These are the lowest level pixel transfer routines.  They	copy* pixels from one scan line to another using an appropriate* transfer mode.** Parameters are passed on "ZeroPage" and in the overflow*   flag. (The overflow flag is used to	decide whether to*   invert the source--set for invert, clear for leave*   alone.)* A predraw routine	must set up "ZeroPage" and the overflow*   flag.** The routines do not use shift tables.	 Instead I use the two* shift subroutines.  This is faster than using shift tables* and working only a byte at a time.** The routines can handle scan lines as	long as 32K.  They do not* care about scan line width and will overflow into next scan line* if told to.** The routines starting with "F" paint forwards (left to right)* while routines starting with "B" paint backwards (right to left).*****************************************************************	EXPORT FCopySliceFCopySlice	PROC	Import OutTable	Import StayTable		stz ShiftTemp	; Zero this for later use	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	eor #$FFFF	; invert combined mask	and (DestRef),y	sta NotMaskAndDestSkipMask			ldy SrcIndex	; Get source word	lda [SrcRef],y	sta ThisWord	; save for later	iny	iny	sty SrcIndex	ldx HowFarToShift	jsr (OutTable,x)	sta ShiftTemp2	; save it	lda ThisWord	jsr (StayTable,x)	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ora NotMaskAndDest	; merge with original part that stays	ldy DestIndex	bmi BumpIndexes	; again if it was neg then special	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	sta ThisWord	iny	iny	sty SrcIndex	ldx HowFarToShift	jsr (OutTable,x)	sta ShiftTemp2	; save it	lda ThisWord	jsr (StayTable,x)	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	sta (DestRef),y	; and store it.BumpIndexes		; 	lda ShiftTemp2	sta ShiftTemp	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP	EXPORT FOrSliceFOrSlice	PROC*              using CoreDATA	stz ShiftTemp	; Zero this for later use	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	; if dest index is neg then we had to	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined maskSkipMask	ldy SrcIndex	; Get source word	lda [SrcRef],y	sta ThisWord	; save for later	iny	iny	sty SrcIndex	jsl ShiftOut	sta ShiftTemp2	; save it	lda ThisWord	jsl ShiftStay	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	bmi BumpIndexes	; the special case again	ora (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	sta ThisWord	iny	iny	sty SrcIndex	jsl ShiftOut	sta ShiftTemp2	; save it	lda ThisWord	jsl ShiftStay	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	ora (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	lda ShiftTemp2	sta ShiftTemp	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP	EXPORT FXORSliceFXORSlice	PROC*              using CoreDATA	stz ShiftTemp	; Zero this for later use	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	; if dest index is neg then we had to	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined maskSkipMask	ldy SrcIndex	; Get source word	lda [SrcRef],y	sta ThisWord	; save for later	iny	iny	sty SrcIndex	jsl ShiftOut	sta ShiftTemp2	; save it	lda ThisWord	jsl ShiftStay	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	bmi BumpIndexes	; special case	eor (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	sta ThisWord	iny	iny	sty SrcIndex	jsl ShiftOut	sta ShiftTemp2	; save it	lda ThisWord	jsl ShiftStay	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	lda ShiftTemp2	sta ShiftTemp	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP	EXPORT FBICSliceFBICSlice	PROC*              using CoreDATA	stz ShiftTemp	; Zero this for later use	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	; if dest index is neg then we had to	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined maskSkipMask	ldy SrcIndex	; Get source word	lda [SrcRef],y	sta ThisWord	; save for later	iny	iny	sty SrcIndex	jsl ShiftOut	sta ShiftTemp2	; save it	lda ThisWord	jsl ShiftStay	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	bmi BumpIndexes	; special case	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	sta ThisWord	iny	iny	sty SrcIndex	jsl ShiftOut	sta ShiftTemp2	; save it	lda ThisWord	jsl ShiftStay	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	lda ShiftTemp2	sta ShiftTemp	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP;                COPY SLICES/BACK.SLICES****************************************************************** Get Word* ShiftStay and save it** dec SrcIndex* dec SrcIndex** Get Word* ShiftOut* Or with Saved ShiftStay* Save At Dest** Dec DestIndex* Dec DestIndex** Compare DestIndex	with FirstWord*       beq LeftEdge*       bcs Loop**       bra AllDone** Change History* 8/6/87 GCP   Now use x reg to hold HowFarToShift*****************************************************************	EXPORT BFCopySliceBFCopySlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	lda [SrcRef],y	sta ThisWord	dey	dey	sty SrcIndex	; initialize index here	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masks	ldx HowFarToShift	; set up x reg for shift callsLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	eor #$FFFF	; invert combined mask	and (DestRef),y	sta NotMaskAndDest	lda ThisWord	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ora NotMaskAndDest	; merge with original part that stays	ldy DestIndex	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	lda ThisWord	; get from before	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl	ENDP	EXPORT BFORSliceBFORSlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	lda [SrcRef],y	sta ThisWord	dey	dey	sty SrcIndex	; initialize index here	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masksLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	lda ThisWord	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	ora (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	lda ThisWord	; get from before	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	ora (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl	ENDP	EXPORT BFXORSliceBFXORSlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	lda [SrcRef],y	sta ThisWord	dey	dey	sty SrcIndex	; initialize index here	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masksLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	lda ThisWord	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	eor (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	lda ThisWord	; get from before	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl	ENDP	EXPORT BFBICSliceBFBICSlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	lda [SrcRef],y	sta ThisWord	dey	dey	sty SrcIndex	; initialize index here	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masksLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	lda ThisWord	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	lda ThisWord	; get from before	jsl xShiftStay	sta ShiftTemp	; save it	ldy SrcIndex	lda [SrcRef],y	; get prior word	sta ThisWord	; save for later	dey	dey	sty SrcIndex	jsl xShiftOut	ora ShiftTemp	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl	ENDP;                COPY SLICES/FSLICES****************************************************************** fSlices** These are the lowest level pixel transfer routines.  They	copy* pixels from one scan line to another using an appropriate* transfer mode without shifting.  They	are only called if no* shifting is needed.** Parameters are passed on "ZeroPage" and in the overflow*   flag. (The overflow flag is used to	decide whether to*   invert the source--set for invert, clear for leave*   alone.)* A predraw routine	must set up "ZeroPage" and the overflow*   flag.** The routines do not use shift tables.	 Instead I use the two* shift subroutines.  This is faster than using shift tables* and working only a byte at a time.** The routines can handle scan lines as	long as 32K.  They do not* care about scan line width and will overflow into next scan line* if told to.** The routines starting with "F" paint forwards (left to right)* while routines starting with "B" paint backwards (right to left).*****************************************************************	EXPORT fFCopySlicefFCopySlice	PROC*              using CoreDATA	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	; if dest index is neg then we had to	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	eor #$FFFF	; invert combined mask	and (DestRef),y	sta NotMaskAndDestSkipMask	ldy SrcIndex	; Get source word	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ora NotMaskAndDest	; merge with original part that stays	ldy DestIndex	bmi BumpIndexes	; again if it was neg then special	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	sta (DestRef),y	; and store it.BumpIndexes		; 	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP	EXPORT fFOrSlicefFOrSlice	PROC*              using CoreDATA	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	; if dest index is neg then we had to	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined maskSkipMask	ldy SrcIndex	; Get source word	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	bmi BumpIndexes	; the special case again	ora (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	ora (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP	EXPORT fFXORSlicefFXORSlice	PROC*              using CoreDATA	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	; if dest index is neg then we had to	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined maskSkipMask	ldy SrcIndex	; Get source word	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	bmi BumpIndexes	; special case	eor (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP	EXPORT fFBICSlicefFBICSlice	PROC*              using CoreDATA	ldy DestStartWord	; if start = finish	sty DestIndex	; then combine masks	ldx SrcStartWord	; get dest pointer into y	stx SrcIndex	; initialize index here	cpy #0	; if dest index is neg then we had to	bmi SkipMask	; dec it when it was 0Loop	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined maskSkipMask	ldy SrcIndex	; Get source word	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	bmi BumpIndexes	; special case	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	lda [SrcRef],y	iny	iny	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	iny	iny	sty DestIndex	cpy DestFinishWord	bcc Loop	beq LoopAllDone	rtl	ENDP;                COPY SLICES/FBACK.SLICES***************************************************************** FastBackSlices** These routine are	only called when a slice can be copied* from one place to	another without shifting.  Without shifting,* it works much faster since no calls to ShiftOut and ShiftSTay* need to be made.*********************************************************************************************************************************** fBFCOPYSlice** Does a backwards COPY slice without shifting.** Modification History** June 4, 1986	 SEG**     The first four lines were in the wrong order.  The y*     register needs to be left with the dest index in it*     rather than the source index.  Moreover, the Y-reg*     was incorrectly set after the ScanMask word was read.*****************************************************************	EXPORT fBFCopySlicefBFCopySlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	sty SrcIndex	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masksLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	eor #$FFFF	; invert combined mask	and (DestRef),y	sta NotMaskAndDest	ldy SrcIndex	; Get Src Index !!!! SEG 4 Jun 86	lda [SrcRef],y	; get word	dey	dey	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ora NotMaskAndDest	; merge with original part that stays	ldy DestIndex	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	; Get SrcIndex !!! SEG 4 Jun 86	lda [SrcRef],y	; get from before	dey	dey	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl	ENDP****************************************************************** fBFORSlice** Does a backwards OR slice without shifting.** June 4, 1986	 SEG**     The first four lines were in the wrong order.  The y*     register needs to be left with the dest index in it*     rather than the source index.  Moreover, the FastWay*     through this loop did not use the	right value of Y*     for the source index.*****************************************************************	EXPORT fBFORSlicefBFORSlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	sty SrcIndex	; initialize index here	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masksLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	ldy SrcIndex	lda [SrcRef],y	; get prior word	dey	dey	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	ora (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	; Get Src Index !!!! SEG 4 Jun 86	lda [SrcRef],y	; get prior word	dey	dey	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	ora (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl	ENDP****************************************************************** fBFXORSlice** Does a backwards XOR slice without shifting.** June 4, 1986	 SEG**     The first four lines were in the wrong order.  The y*     register needs to be left with the dest index in it*     rather than the source index.  Moreover, the FastWay*     through this loop did not use the	right value of Y*     for the source index.*****************************************************************	EXPORT fBFXORSlicefBFXORSlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	sty SrcIndex	; initialize index here	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masksLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	ldy SrcIndex	lda [SrcRef],y	; get prior word	dey	dey	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	eor (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	; Get Src Index !!!! SEG 4 Jun 86	lda [SrcRef],y	; get prior word	dey	dey	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl	ENDP****************************************************************** fBFBICSlice** Does a backwards BIC slice without shifting.** June 4, 1986	 SEG**     The first four lines were in the wrong order.  The y*     register needs to be left with the dest index in it*     rather than the source index.  Moverover, the FastWay*     through this loop did not use the	right value of Y*     for the source index.*****************************************************************	EXPORT fBFBICSlicefBFBICSlice	PROC*              using CoreDATA	ldy SrcFinishWord	; get dest pointer into y	sty SrcIndex	; initialize index here	ldy DestFinishWord	; if start = finish	sty DestIndex	; then combine masksLoop		; 	lda [ScanMaskRef],y	cmp #$FFFF	beq FastWay	sta CombinedMask	; put in combined mask	ldy SrcIndex	lda [SrcRef],y	; get prior word	dey	dey	sty SrcIndex	bvc NotNot1	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot1	and CombinedMask	; and with combined	mask	ldy DestIndex	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.	bra BumpIndexesFastWay		; 	ldy SrcIndex	; Get Src Index !!!! SEG 4 Jun 86	lda [SrcRef],y	; get prior word	dey	dey	sty SrcIndex	bvc NotNot2	; check to see if should invert source	eor #$FFFF	; invert sourceNotNot2	ldy DestIndex	eor #$FFFF	and (DestRef),y	sta (DestRef),y	; and store it.BumpIndexes		; 	dey	dey	bmi AllDone	; if this is neg then we had to dec*		; start word when it was 0	sty DestIndex	cpy DestStartWord	; we are done if <=	StartWord	bcs LoopAllDone	rtl******************************************************************************** Parameters are passed on "ZeroPage" and in the overflow*   flag. (The overflow flag is used to	decide whether to*   invert the source--set for invert, clear for leave*   alone.)* A predraw routine	must set up "ZeroPage" and the overflow*   flag.** These special routine perform shifting at a geratly increased speed. This allows* for added performance. These routines are used when the slice to copy is <$A0 bytes..*** The routines starting with "F" paint forwards (left to right)* while routines starting with "B" paint backwards (right to left).** SetUp so that*  DestStartWord*  DestFinishWord*  SrcStartWord*  ****************************************************************ShiftyCopySlice	PROC *              using CoreDATA	phb	phk	plb		lda NumSrcWords	sta DestIndex	; use this for the number of word to copy...		jsr CopyEmIn	; read em in and weep brothers..	lda HowFarToShift	; see if we need to shift farther..	lsr a	dec a	dec a	beq @MoveDone	jsr MoveEmOnOver@MoveDone	jsr CopyEmOut		plb	rtlShiftArea	ds.B $0100	; make it 256 bytes, why not?CopyEmIn	ldy DestIndex	; preload the index..@Looping	lda [SrcRef],y	xba	ror a	sta ShiftArea,y	dey	dey	bpl @Looping	rtsMoveEmOnOver	tax 	; save the number of times to shift@OuterLoop	ldy DestIndex@Looping	lda ShiftArea,y	ror a	sta ShiftArea,y	dey	dey	bpl @Looping	dex	bne @OuterLoop	rtsCopyEmOut; NOTE: Gotta fudge for thes source/dest inacuracy crap..	lda DestStartWord	; get the start word of the destination mask and all..;	bpl @ReadyToLoop; Must adjust the pointers that I use		ldy DestIndex	; preload the index again...	php@Looping	lda [ScanMaskRef],y	cmp #$FFFF	beq @FastWay	sta CombinedMask	eor #$FFFF	and [DestRef],y	sta NotMaskAndDest	lda ShiftArea,y	plp	ror a	php	bvc @NotNot1	; check to see if should invert source	eor #$FFFF	; invert source@NotNot1	and CombinedMask	; and with combined	mask	ora NotMaskAndDest	; merge with original part that stays	sta (DestRef),y	; and store it.	bra @LoopCont@FastWay		lda ShiftArea,y	plp	ror a	php	sta [DestRef],y	@LoopCont	dey	dey	bpl @Looping	plp	rts	EndP	StayTable	Proc Export	DC.W Shift0	DC.W Shift1	DC.W Shift2	DC.W Shift3	DC.W Shift4	DC.W Shift5	DC.W Shift6	DC.W Shift7	DC.W Shift8	DC.W Shift9	DC.W Shift10	DC.W Shift11	DC.W Shift12	DC.W Shift13	DC.W Shift14	DC.W Shift15Shift15		; 	rol a	and #%0000000100000000	rtsShift14		; 	rol a	rol a	and #%0000001100000000	rtsShift13		; 	rol a	rol a	rol a	and #%0000011100000000	rtsShift12		; 	rol a	rol a	rol a	rol a	and #%0000111100000000	rtsShift11	xba	lsr a	lsr a	lsr a	and #%0001111100000000	rtsShift10	xba	lsr a	lsr a	and #%0011111100000000	rtsShift9	xba	lsr a	and #%0111111100000000	rtsShift8	xba	and #%1111111100000000	rts; 123456789ooooooo initial bits; 9ooooooo12345678 initial word; 123456789ooooooo swap to get bits in right order for shifting; ooooooo123456789 shift; 23456789ooooooo1 swap to get final word; ooooooo123456789 final bits	GOTO .skipShift7	xba	; 3	lsr a	; 2	lsr a	; 2	lsr a	; 2	lsr a	; 2	lsr a	; 2	lsr a	; 2	lsr a	; 2	xba	; 3	rts.skipShift7	clc	; 2	adc #$8000	; 3 move high bit to carry	rol a	; 2 rotate carry into low end	and #%0000000111111111 ; 3	xba	; 3	rtsShift6	xba	lsr a	lsr a	lsr a	lsr a	lsr a	lsr a	xba	rtsShift5	xba	lsr a	lsr a	lsr a	lsr a	lsr a	xba	rtsShift4	xba	lsr a	lsr a	lsr a	lsr a	xba	rtsShift3	xba	lsr a	lsr a	lsr a	xba	rtsShift2	xba	lsr a	lsr a	xba	rtsShift1	xba	lsr a	xba	rtsShift0	rts	ENDPOutTable	Proc Export	DC.W Shift0	DC.W Shift1	DC.W Shift2	DC.W Shift3	DC.W Shift4	DC.W Shift5	DC.W Shift6	DC.W Shift7	DC.W Shift8	DC.W Shift9	DC.W Shift10	DC.W Shift11	DC.W Shift12	DC.W Shift13	DC.W Shift14	DC.W Shift15Shift0	lda #0	rts;xxxxxxxxxxxxxxx1	  initial bits;xxxxxxx1xxxxxxxx	  initial word;oooooooo1ooooooo	  final word;1xxxxxxxxxxxxxxx	  final bitsShift1	ror a	and #%0000000010000000	rts;xxxxxxxxxxxxxx12	   initial bits;xxxxxx12xxxxxxxx;xxxxxxxx12xxxxxx;12xxxxxxxxxxxxxx	   final bitsShift2	ror a	ror a	and #%0000000011000000	rtsShift3	ror a	ror a	ror a	and #%0000000011100000	rtsShift4	ror a	ror a	ror a	ror a	and #%0000000011110000	rts; xxxxxxxxxxx12345; xxx12345xxxxxxxx; oooooooo12345ooo; 12345xxxxxxxxxxxShift5	xba	rol a	rol a	rol a	and #%0000000011111000	rtsShift6	xba	rol a	rol a	and #%0000000011111100	rtsShift7	xba	rol a	and #%0000000011111110	rtsShift8	xba	and #%0000000011111111	rts; xxxxxxx123456789	  initial bits; 23456789xxxxxxx1	  initial word; 9ooooooo12345678	  final word; 123456789xxxxxxx	  final bitsShift9	xba	; 3	ror a	; 2	php	; 3	asl a	; 2	plp	; 4	ror a	; 2	and #%1000000011111111 ; 3	rtsShift10	xba	asl a	asl a	asl a	asl a	asl a	asl a	xba	rtsShift11	xba	asl a	asl a	asl a	asl a	asl a	xba	rtsShift12	xba	asl a	asl a	asl a	asl a	xba	rtsShift13	xba	asl a	asl a	asl a	xba	rtsShift14	xba	asl a	asl a	xba	rtsShift15	xba	asl a	xba	rts	ENDP	End