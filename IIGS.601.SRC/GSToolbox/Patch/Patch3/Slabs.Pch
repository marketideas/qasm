******************************************************************************** ROM 3 Slab patches** (C)  Copyright Apple Computer, Inc. 1989* All rights reserved.** by Jim Mensch* 6/15/89** Contains all that is needed to patch the ROM3 slabs to work properly** Files:**** Modification History:** Version 1.0	Mensch*********************************************************************************;; ROM Addresses required for this to work; for ROM 3FastSlabOr	equ $FE2C90FastSlabBIC	equ $FE2D09FastSlabXor	equ $FE2721FastSlabCopy	equ $FE2A26ROMSETSLABADR	equ $FE2D92GOREALLYFASTXOR	EQU $FE2796FastSlabXorAlt	equ $FE2742DoSingleWordXor	equ $FE2780DoLastTwoXor	equ $FE2788GOREALLYFASTCOPY	EQU $FE2A9FFastSlabCopyAlt	equ $FE2A47DoSingleWordCopy	equ $FE2A85DoLastTwoCopy	equ $FE2A8F****************************************************************** SetSlabAdr post patch** This routine sets	of the vector "ToSlab" in bank E0.  All* drawing routines use this vector to get to their slab routine.** 6/15/89	Mensch* First post patch goes here...*****************************************************************iSetSlabAdr	PROC EXPORT	jsl ROMSETSLABADR	bcs ItsGroovyGoFast	lda >FastSlabTable,x	sta >ToSlab	lda >FastSlabTable+2,x	sta >ToSlab+2	clc	;signals that we can go fastItsGroovy	rtlFastSlabTable	jml PatchSlabCopy	jml FastSlabOR	jml PatchSlabXOR	jml FastSlabBIC	EndP			title 'PatchSlabXOR'*****************************************************************PatchSlabXOR	PROC EXPORT*** 6/15/89	Mensch** Drastically modified for slab entry for the patch*****************************************************************;---------------------------------------------------------------MaxWordsInRow	equ 80MaxBytesInRow	equ MaxWordsInRow*2;---------------------------------------------------------------;---------------------------------------------------------------	lda Pat	;if the patterns are equal go very fast	cmp Pat+2	beq tryReallyFastexit1	jml FastSlabXOR	; if the pats are not equal use ROMslabstryReallyFast		lda FinishWord	;get the number of bytes to XOR into the	sec	;..A-Reg	sbc StartWord	beq exit1	;if only one word, do a special case	lsr a	dec a	;if only two words,	then do another	beq exit1	;..special case	tax	;otherwise the count goes in X-Reg	cmp #MaxWordsInRow	; do we hit the threshhold?	bge exit2	; if less than max in rom do exit1	jml GoReallyFastXORExit2	jml FastSlabXORAlt	; else do the fast slab xor alt	EndP	title 'PatchSlabCopy'*****************************************************************PatchSlabCopy	PROC EXPORT** 6/15/89	Mensch** Made entry to fastslabcopy modified version for the patch****************************************************************;---------------------------------------------------------------MaxWordsInRow	equ  80;---------------------------------------------------------------	lda Pat	;if the patterns are equal go very fast	cmp Pat+2	beq tryReallyFastexit1	jml ROMSlabFastCopy	; if the pats are not equal use ROMslabstryReallyFast		lda FinishWord	;get the number of bytes to XOR into the	sec	;..A-Reg	sbc StartWord	beq exit1	;if only one word, do a special case	lsr a	dec a	;if only two words,	then do another	beq exit1	;..special case	tax	;otherwise the count goes in X-Reg	cmp #MaxWordsInRow	; do we hit the threshhold?	bge exit2	; if less than max in rom do exit1	jml GoReallyFastCopyExit2	jml FastSlabCopyAlt	; else do the fast slab xor alt	EndP