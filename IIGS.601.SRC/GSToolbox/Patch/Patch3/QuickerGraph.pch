******************************************************************************** Quickergraph init by mensch** (C)  Copyright Apple Computer, Inc. 1991* All rights reserved.** by Jim Mensch* circa 1991** get out of this source code you scum sucking pig.** Files:**** Modification History:** Version 1.0	Mensch********************************************************************************	include 'all.macros'	include ':::qd:qdequates:qd.data.asm'	INCLUDE ':::qd:QDEquates:CORE.GLOBALS1'	INCLUDE ':::qd:QDEquates:core.globals2'	INCLUDE ':::qd:QDEquates:region.equs'	INCLUDE ':::qd:QDEquates:RECT.EQUS'	INCLUDE ':::qd:QDEquates:SLAB.EQUS'	INCLUDE ':::qd:QDEquates:rgndefs.equs'	include 'e16.memory'	import iSetStuffAdr	import iBlowItUp	import iSetSliceAdr	import iInit3Regions	import iSeek3Regions	import iInit2Regions	import iSeek2Regions		entry iGimmeVersion	MACRO&lab	Patch &name&lab		lda |&name	sta >old&Name	lda |&Name+2	sta >old&Name+2	lda #<i&name	sta |&name+1	lda #>i&name	sta |&name+2	MEND	MACRO&Lab	TablePatch &RtnName,&CallNum&Lab	ldy #&CallNum*4	lda #&RtnName-1	sta [LocalTemp],y	iny	iny	lda #^&RtnName	sta [LocalTemp],y	MEND	; This macro will be used to switch in based on the current ROM version.; 	MACRO&Lab	VersPatch &RtnName,&Address&Lab	lda >ROM&Address,x	sta >&RtnName+1	lda >ROM&Address+1,x	sta >&RtnName+2		MEND	MACRO&Lab	VersSPatch &RtnName,&Address&Lab	lda >ROM&Address,x	sta >&RtnName+1	MEND*****************************************************************InstallQDPatch	PROC Export** This routine installs the patches to QD's vectors and* returns*** Inputs:*	none** Outputs:*	all registers may be trashed.** External Refs:	Import Cont16	Import Cont26	Import Cont36	Import oFastBigLoop	Import oSlowBigLoop** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************NumQDCalls	equ $DB		;8-Mar-91 DALCallTableSize	equ 4*(NumQDCalls+1)	;(It should really determine this on the fly)LocalTemp	equ 0SetPortOffset	equ $1B*4	phb	pea $E0E0	plb	plb;; Call FWEntry to get the ROM version. (DAL); Do some patching for ROM 1 and ROM 3, but not for anything else.;	pha	pha	pha	pha	;space for result (P,A,X,Y)	pha	;input A (who cares)	pha	;input X (who cares)	pha	;input Y (who cares)	pea $FE1F	;IDROUTINE	_FWEntry	ply	;returned ROM version (from Y register)	pla	;returned X	pla	;returned A	pla	;returned P	ldx #0	;anticipate ROM 1	cpy #1	beq @patchStuff	ldx #ROMTableSize	;anticipate ROM 3	cpy #3	beq @patchStuff	brl @noPatches@patchStuff;; First do the ROM-independent patches (but only for ROMs that we; know about (1 and 3).;	Patch GimmeVersion			Patch BlowItUp	Patch SetStuffAdr	Patch SetSliceAdr	Patch Seek3Regions	Patch Init3Regions	Patch Seek2Regions	Patch Init2Regions;; Now do the ROM-specific patches;	VersPatch oFastBigLoop,FastBigLoop	VersPatch oSlowBigLoop,SlowBigLoop	VersPatch Cont16,ConTable640	VersSPatch Cont26,ConTable640	VersSPatch Cont36,ConTable640	@noPatches	plb	RTL		Export OldGimmeVersion	Export OldBlowItUp	Export OldSetStuffAdr	Export OldSetSliceAdr	Export OldSeek3Regions	Export OldInit3Regions	Export OldSeek2Regions	Export OldInit2Regions;; Address tables for specific ROM routines that need to be called...; ROM 2 tables first ("ROM 2" means "ROM 01");ROMFastBigLoop	dc.L $FE734A	;searched for "LDA $A4, BNE +4, JSL Seek2Regions", found only oneROMSlowBigLoop	dc.L $FE740C	;searched for "LDA $C6, STA $CC, LDA $BA, STA $2C, LDA $BC, STA $2A, JSL Seek2Regions"ROMConTable320	dc.L $FE4C3B	;from GetAddress(2)ROMConTable640	dc.L $FE503B	;from GetAddress(3)ROMtableSize	equ *-ROMFastBigLoop; ROM 3 tables here..ROM3FastBigLoop	dc.L $FE9171	; ROM3SlowBigLoop	dc.L $FE9233	; ROM3ConTable320	dc.L $FE6372ROM3ConTable640	dc.L $FE6772;; End of version patch data;; Call back table dataOldGimmeVersion	ds.L 1OldBlowItUp	ds.L 1OldSetStuffAdr	ds.L 1OldSetSliceAdr	ds.L 1OldSeek3Regions	ds.L 1OldInit3Regions	ds.L 1OldSeek2Regions	ds.L 1OldInit2Regions	ds.L 1	EndP*****************************************************************iGimmeVersion	PROC Export** Vectored routine to return QD's version number*** Inputs:*	none** Outputs:*	a-reg** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	jsl  OldGimmeVersion	ora  #$4000	RTL	ENDP	END