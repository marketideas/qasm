	title 'Dialog Mgr Patch        GS ROM 3 Patch'******************************************************************** Dialog manager patches for ROM 3** System Disk 5.0** 19 May 89	Steven Glass** Patch to DialogStartup so that we startup anyway if it had* been started before.** 31 May 89	Harry Yee** Take out prototype bit in version number. (Final version = 3.1 * for System Disk 5.0)** 9/7/89	Mensch** Fixed handle allocation bug in startup. Handle was being allocated * as moveable, then derefed and turned into many pointers... it will now* be allocated as locked.** 24-Sep-90	Dave Lyons** Version $8304.** DialogStartup now calls ErrorSound(nil).* ErrorSound(nil) uses new-and-improved standard sound procedure* that calls SysBeep2 (8000=alert stage 0, 1..3 = stage 1..3, and* 4 = clicked outside window).  The Carry flag is set on entry* to the sound proc if the user clicked outside a window.** 18-Feb-91	Dave Lyons** Changed the default sound proc so that it uses bit 14 of SysBeep2* intelligently (for deferring sounds until the next GetNextEvent).** 5-Mar-91	Dave Lyons** First cut at doing I-Beam cursor handling when bit 30 of the* ModalDialog filter proc is set.  Patched ModalDialog.  No need* to patch ModalDialog2, since it calls ModalDialog through the* tool dispatcher.** 7-Mar-91	Dave Lyons** Second try at I-Beam cursor stuff.  It was a bad idea to set an* arrow cursor on the way in and out of every ModalDialog call* when they had the bit set.  Instead, now CloseDialog calls* InitCursor if ModalDialog left the cursor as an I-Beam.** 10-Jun-91 DAL** Removed check for active editLine item from ModalDialogCursorPoll.* Now we use an IBeam cursor over all editLines, even if they are* inactive.** Patched out NoteAlert, CautionAlert, and StopAlert to use some* colorful icons, instead of boring black-and-white ones.  We jump* back into ROM as soon as everything is set up.** 26-Aug-91	Dave Lyons** Added check in CreateIcon for dialog at odd X position.  If odd,* we make the icon position (local coordinates) odd too, so the colors* will be right.** 13-Oct-91	Dave Lyons** In 320 mode, NoteAlert, StopAlert, and CautionAlert were putting* their icons at X=0 instead of X=20.  Oops, fixed.** 5-Feb-92	Dave Lyons** Version $0304 for 6.0 final.********************************************************************* BEGIN 6.0.1** 26-Jan-93	Dave Lyons** Changed version to $8305 to match TOOL021.  No other change;* the TOOL021 bug did not affect us.** 2-Apr-93 DAL** Version $0305 for 6.0.1*******************************************************************	import DialogStartup*****************************************************************			   **              Copyright (C) 1989-93		   **              All Rights Reserved		   **              Apple Computer, Inc.		   **			   *****************************************************************	Blanks off	String asis	***	include 'm16.dialog'	include 'all.macros'	;5-Mar-91 DALDialogCallTable	PROC EXPORT	import DialogVersion	import NewDialogStartup	import ErrorSound	import ModalDialog		;5-Mar-91 DAL	import CloseDialog		;7-Mar-91 DAL	import StopAlert		;10-Jun-91 DAL	import NoteAlert		;10-Jun-91 DAL	import CautionAlert		;10-Jun-91 DALFPT	DC.L (ENDFPT-FPT)/4	DC.L 0	; DialogBootInit-1 	1	DC.L NewDialogStartup-1 	2	DC.L 0	; DialogShutDown-1 	3	DC.L DialogVersion-1 	4	DC.L 0	; DialogReset-1	5	DC.L 0	; DialogStatus-1	6	DC.L 0	; ErrorSound-1	7	DC.L 0	; SetDAFont-1	8	DC.L ErrorSound-1	; 9	DC.L 0	; NewModalDialog-1 10	DC.L 0	; NewModelessDialog-1 11	DC.L CloseDialog-1	;	12 patched 7-Mar-91 DAL	DC.L 0	; NewDItem-1	13	DC.L 0	; RemoveItem-1	14	DC.L ModalDialog-1	;	15 patched 5-Mar-91 DAL	DC.L 0	; IsDialogEvent-1 	16	DC.L 0	; DialogSelect-1	17	DC.L 0	; DlgCut-1	18	DC.L 0	; DlgCopy-1	19	DC.L 0	; DlgPaste-1	20	DC.L 0	; DlgDelete-1	21	DC.L 0	; DrawDialog-1	22	DC.L 0	; Alert-1	23	DC.L StopAlert-1	;	24	DC.L NoteAlert-1	;	25	DC.L CautionAlert-1	;	26	DC.L 0	; ParamText-1	27	DC.L 0	; SetDAFont-1	28	DC.L 0	; SetItemToControl-1 29	DC.L 0	; GetControlDItem-1 30	DC.L 0	; GetIText-1	31	DC.L 0	; SetIText-1	32	DC.L 0	; SelIText-1	33	DC.L 0	; HideDItem-1	34	DC.L 0	; ShowDItem-1	35	DC.L 0	; FindDItem-1	36	DC.L 0	; UpdateDialog-1	37	DC.L 0	; GetItemType-1	38	DC.L 0	; SetItemType-1	39	DC.L 0	; GetItemBox-1	40	DC.L 0	; SetItemBox-1	41	DC.L 0	; GetFirstItem-1	42	DC.L 0	; GetNextItem-1	43	DC.L 0	; ModalDialog2-1	44	DC.L 0	; RESERVED-1	45	DC.L 0	; GetItemValue-1	46	DC.L 0	; SetItemValue-1	47	DC.L 0	; RESERVED-1	48	DC.L 0	; RESERVED-1	49	DC.L 0	; GetNewModalDialog-1 50	DC.L 0	; GetNewDItem-1	51	DC.L 0	; GetAlertStage-1	52	DC.L 0	; ResetAlertStage-1 53	DC.L 0	; DefaultFilter-1	54	DC.L 0	; GetDefButton-1	55	DC.L 0	; SetDefButton-1	56	DC.L 0	; DisableDItem-1	57	DC.L 0	; EnableDItem-1	58ENDFPT	ENDP*************************************************************************** DialogVersion patch**************************************************************************DialogVersion	PROC	lda #$0305	;2-Apr-93 DAL	sta 7,s	lda #0	clc	rtl	ENDP**************************************************************************** 24-Sep-90 DAL** Now calls ErrorSound(nil) after calling the ROM startup function** (The patch to load AY=nil before calling the ROM was already here.)***************************************************************************NewDialogStartup	PROC	lda 7,s	pha	lda #0	tay	jsl @toStartup	;call with WAP=0	bcs @exit	lda #0	pha	pha	_ErrorSound@exit	tax	ldy #2	;strip 2 bytes	jml $e10184	;ToStrip@toStartup	jsl DialogStartup	rtl	ENDP**************************************************************************** ErrorSound patch** New patch 24-Sep-90 DAL** ErrorSound(nil) defaults to nifty-new sound proc.***************************************************************************ErrorSound	PROC	tax	lda 7,s	ora 9,s	bne @toROM	lda #^NewSoundProc	sta 9,s	lda #<NewSoundProc	sta 7,s@toROM	txa	jml $fc67cf*************************************************************************** NewSoundProc--input is one word on stack (needs to be removed).** If the carry is set, the user clicked outside a dialog window,* so we need to call SysBeep2($0004).  If the carry is clear, the* word on the stack is the alert stage (0..3).  Stage 0 makes no* sound by default so we call SysBeep2($C000).  Stages 1..3 map to* SysBeep2(4001..4003).** (Setting bit 14 defers the sound until the next GetNextEvent call.)*NewSoundProc*** Let's try this one more time, using bit 14 of SysBeep2 this time to delay*** the beeps until GetNextEvent gets called.  17-Feb-91 DAL	lda 1,s	cmp #$7fa4	bne @notOutsideWindow	lda 2,s	cmp #$fc7f	bne @notOutsideWindow	lda #$0004	;clicked outside dialog/alert	bra @thisSound@notOutsideWindow	lda 4,s	beq @stage0	ora #$4000	;stage 1..3: $4001..4003 (defer until GetNextEvent)	bra @thisSound@stage0	lda #$C000	;stage 0: no sound by default, defer until GNE@thisSound	pha	_SysBeep2	lda 2,s	sta 4,s	lda 1,s	sta 3,s	pla	rtl	EndP**************************************************************************** CloseDialog patch** New patch 7-Mar-91 DAL** If ModalDialog left the cursor as an I-Beam, call InitCursor.***************************************************************************CloseDialog	proc export	import IBeamFlag	pha	;save WAP	lda >IBeamFlag	beq @notIBeam	lda #0	sta >IBeamFlag	_InitCursor@notIBeam	pla	;get WAP back	jml >$fc6acb	;original ROM 3 CloseDialog	EndP**************************************************************************** ModalDialog patch** New patch 5-Mar-91 DAL** Patch to support I-Beam stuff if they set bit 30 of the filter proc* parameter.** On the way in:	Call InitCursor if they set bit 30.*	Initialize IBeamFlag.** During the call:	Get control when ModalDialog calls GetNextEvent, so we*	can fiddle with the cursor then.** Afterwards:	If the cursor is an I-Beam, make it back into an arrow.** Inputs:*     WORD  space for result*     LONG  filter proc pointer***************************************************************************ModalDialog	PROC	pha	;save the WAP for a second	lda 7+2,s	sta >FilterProcCopy	lda 7+2+2,s	sta >FilterProcCopy+2*** InitCursor on the way in is a bad idea (7-Mar-91 DAL);	and #$4000	;check bit 30;	beq @noInit;	_InitCursor;@noInit	lda #0	sta >IBeamFlag	plx	;old WAP	lda 7+4,s	pha	;push copy of resull space	lda 7+4,s	pha	lda 7+4,s	pha	;pushed copy of filter proc	txa	jsl @toROM	tax	;save error code	pla	;pull result from ROM code	sta 11,s	;stored new result;*** Setting the cursor on the way out of ModalDialog is a bad idea;*** Fix up the cursor if necessary;	phx	;error code;	lda >IBeamFlag;	beq @okay;	_InitCursor;@okay	plx	;restore error code	ldy #4	jml $e10184	;ToStrip@toROM	jsl $fc7d55	;original ROM 3 ModalDialog	rtl	entry IBeamFlagIBeamFlag	dc.w 0	entry FilterProcCopyFilterProcCopy	dc.l 0	EndP**************************************************************************** ModalDialogCursorPoll -- new routine 5-Mar-91 DAL** The GetNextEvent patch calls this routine when it sees it's being* called from ModalDialog.** We check filter proc bit 30 to see if we're supposed to mess with the* cursor.  If we are, we need to get the cursor position and change the* cursor to an arrow or I-Beam appropriately.** Replaced most of this code 7-Mar-91 DAL because we can't call FindDItem;* that makes an item think it's been clicked on.** 22-Mar-91 DAL*   Added missing CLC in ModalDialogCursorPoll.***************************************************************************ModalDialogCursorPoll proc export	import IBeamFlag	import FilterProcCopy@event	equ $0@where	equ 10	;offset into event record	lda >filterProcCopy+2	and #$4000	bne @1***	brl @veryBoring	rtl@1; find the item the cursor is over	pea 0	tdc	clc	;added 22-Mar-91 DAL	adc #@event+@where	pha	_GlobalToLocal	pha	;space for FindCursorCtl	pushlong #theControlH	pei <@event+@where+2	pei <@event+@where	pha	pha	_FrontWindow	_FindCursorCtl	pla	;part code	beq @nonLineEdit	pha	pha	;space for GetCtlRefCon	pushlong >theControlH	_GetCtlRefCon	pla	;dItem number	pla	and #$7fff	;dialog item type	cmp #$0011	;Line Edit item?	bne @nonLineEdit@isLineEdit	lda >IBeamFlag	bne @cursorOkay	;already an I-Beam cursor	lda #1	sta >IBeamFlag	_IBeamCursor	bra @cursorOkay@nonLineEdit	lda >IBeamFlag	beq @cursorOkay	;already an arrow cursor	lda #0	sta >IBeamFlag	_InitCursor@cursorOkay@veryBoring	rtltheControlH	dc.l 0	EndP**************************************************************************** StopAlert patch 10-Jun-91 DAL for colored icons***************************************************************************StopAlert	proc export	ldx #1	bra GeneralAlert**************************************************************************** NoteAlert patch 10-Jun-91 DAL for colored icons***************************************************************************	entry NoteAlertNoteAlert	ldx #2	bra GeneralAlert**************************************************************************** CautionAlert patch 10-Jun-91 DAL for colored icons***************************************************************************	entry CautionAlertCautionAlert	ldx #3GeneralAlert	import Icon320Table	import Icon640Table	MACRO&lab	tlink &SizeInput,&SizeLocals	lclc &SL&SL	setc &DEFAULT(&SizeLocals,'0')input	equ &SizeLocals+6output	equ input+&SizeInput&lab	tsc	if &SL='0' GOTO .DontSubtract	sec	sbc #&SL	tcs.DontSubtract	phd	inc a	tcd	MEND	MACRO&lab	tunlink&lab	pld	tay	lda input-1,s	sta output-1,s	lda input-3,s	sta output-3,s	lda input-5,s	sta output-5,s	tsc	clc	adc #output-6	tcs	tya	cmp #1	MEND	macro&lab	pushworddp &blah&lab	pei &blah	mend	macro&lab	pushlongdp &blah&lab	pei &blah+2	pei &blah	mend	MACRO	PushZPtr &A	pea  $0000	tdc	clc	adc  #&A	pha	MEND;; Zero Page (shared	with Control Manager);Signature	equ 128	; contains DlgSig if Dlg Mgr activemmgrID	equ Signature+2	; ID to use with the Memory ManagerDialogFont	equ mmgrID+2	; handle to dialog font or 0 for systemAlertSoundProc	equ DialogFont+4	; pointer to custom	sound procedureAlertStage	equ AlertSoundProc+4 ; current alert stageLastAlertID	equ AlertStage+2	; ID of last called	alertParamString0	equ LastAlertID+2	; Param strings for	^0 to ^3ParamString1	equ ParamString0+4ParamString2	equ ParamString1+4ParamString3	equ ParamString2+4PartCodeHit	equ ParamString3+4	; Part Code HitMemHandle	equ PartCodeHit+2WindowPointer	equ MemHandle+4HandStruct	equ WindowPointer+4***EndZeroPage	equ HandStruct+4IBeamFlag	equ HandStruct+4	;5-Mar-91 DAL: nonzero = we called IBeamCursorEndZeroPage	equ IBeamFlag+2	;5-Mar-91 DAL;; Alert Template;atBoundsRect	equ 0atalertID	equ atBoundsRect+8atstage1	equ atalertID+2atstage2	equ atstage1+1atstage3	equ atstage2+1atstage4	equ atstage3+1atitemlist	equ atstage4+1** Local direct page stuff*theDialog	equ 0ItemTemplate	equ theDialog+4PortSave	equ ItemTemplate+4Globals	equ PortSave+4StageVector	equ Globals+4IconID	equ StageVector+2IconHandleStruct	equ IconID+2SizeLocals	equ IconHandleStruct+4;; Icon Item Template;IconitemID	equ 0IconitemRect	equ IconitemID+2IconitemType	equ IconitemRect+8IconitemDescr	equ IconitemType+2IconitemValue	equ IconitemDescr+4IconitemFlag	equ IconitemValue+2IconitemColor	equ IconitemFlag+2	tay	; save d-page in y	tlink 8,SizeLocalsfilterProc	equ inputAlertTemplate	equ filterProc+4itemHit	equ output	stx <IconID	; save Icon ID;; Get Dialog Manager Zero Page;	sty <Globals	stz <Globals+2	ldy #HandStruct	lda [<Globals],y	sta <IconHandleStruct	iny	iny	lda [<Globals],y	sta <IconHandleStruct+2;; Is it the same alert as the last alert;	ldy #atalertID	lda [<AlertTemplate],y	ldy #LastAlertID	cmp [<Globals],y	beq GetStage;; If not, set lastalertID to current alert, and reset alert	stage;	sta [<Globals],y	; a = AlertID, y = #LastAlertID	lda #0	ldy #AlertStage	sta [<Globals],y;; Get the current stage of the alert;GetStage		; 	ldy #AlertStage	; calculate offset to current stage	lda [<Globals],y	; in the alert template	clc	adc #atstage1	tay	lda [<AlertTemplate],y	and #$FF	sta <StageVector;; Call the Sound Procedure;	and #%00000011	; get sound number in bits 0-1	pha	ldy #AlertSoundProc+1 ; look if there is a custom sound proc	lda [<Globals],y	; (X = bits 8-23)	dey	; Y = AlertSoundProc	tax*** There will always be a custom sound proc, because of ErrorSound/DialogStartUp*** patches above.  10-Jun-91 DAL;	bne CallCustomSound;;	lda [<Globals],y	; test now low word;	bne CallCustomSound	; (A = bits 0-15);;	clc	;24-Sep-90 DAL;	jsl StdSoundProc	; call standard sound proc;	bra CheckDrawnCallCustomSound	lda [<Globals],y	; X already=bits 8-23, Y=AlertSoundProc	clc	;24-Sep-90 DAL	jsl >$fc8952	;long_call ; and A = low byte of procedure address;; Look if alert box	should be drawn;CheckDrawn	lda <StageVector	and #%10000000	; boxdrawn is bit 7	bne CreateDialog	jml >$fc71f4	;IncAlertStage in ROM 3;; Creates modal dialog for alert by calling DialogFromTemplate;CreateDialog	pushzptr <theDialog	; variable to store	dialog ptr in	pushlongdp <AlertTemplate ; pointer to template	pushword #1	; visible	lda #0	; refcon = 0	pha	pha	lda #atitemlist	; offset to item list	pha	jsl >$FC6B1F	;DialogFromTemplate--create dialog and set error status	bcc AddIcon	; error!, exit	jml >$fc7204	;exit in ROM 3;; Then add the alert icon;AddIcon	lda <IconID	beq SetDef	; no icon	dea	; compute index to icon pointer	asl a	asl a	tax;; Assume we're in 640 mode;	lda >Icon640Table,x	; get icon pointer from 640 table	sta [<IconHandleStruct] ; and store in fake handle	lda >Icon640Table+2,x	ldy #2	sta [<IconHandleStruct],y;; See if we are in 320 or 640;	lda [<theDialog]	; get PortSCB	and #$0080	; 0=320, 1=640	bne CreateIcon	lda >Icon320Table,x	; get icon pointer from 320 table	sta [<IconHandleStruct] ; and store in fake handle	lda >Icon320Table+2,x	ldy #2	sta [<IconHandleStruct],y;;;;;CreateIcon	jml >$FC716E	;CreateIcon in ROM 3CreateIcon	tsc	; make room on the stack for icon template	sec	sbc #24	tcs	inc a	; store starting address of icon template in x	tax	lda #-32768	; store icon ID	sta iconitemID+1,s	lda #5	; store icon boundaries	sta iconitemRect+1,s*** added 26-Aug-91 DAL -- if 640 and dialog is at odd location, compensate	lda [<theDialog]	and #$0080*** added 13-Oct-91 DAL -- A was supposed to be 20 for 320 mode	php	lda #20	plp*** end 13-Oct-91	beq @1	;320 is no problem	ldy #10	;offset into port of boundsRect.x1	lda [<theDialog],y	lsr a	lda #20	;used to always be 20, now can be 19 instead	bcc @1	;it's even, no problem	dec a	;A=19@1*** end 26-Aug-91	jml >$fc7183SetDef	jml >$fc71bf	EndP	END