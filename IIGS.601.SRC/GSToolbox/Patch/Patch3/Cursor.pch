	INCLUDE ':::qd:QDEquates:CORE.GLOBALS1'		title 'Cursor Equates'ScreenStart	equ $2000ScreenHeight	equ 200	; number of scan linesScreenWidth	equ 160	; number of bytesScreenTable	equ $FE553CROMUnDrawCursor	equ $FE54B6MaxWidth	equ 32	; max number of bytes containing*		; single line of cursor image.;-----------------------------------------------;; We start the cursor data on zero page	at the end; of the stuff used	by the rest of quickdraw.;StartofZP	equ CursorSTARTUseInterrupts	equ StartofZPIntPending	equ UseInterrupts+2MouseY	equ IntPending+2MouseX	equ MouseY+2NextMouseY	equ MouseX+2NextMouseX	equ NextMouseY+2CurHeight	equ NextMouseX+2	; Num scan lines high of cursorCurWidth	equ CurHeight+2	; Num WORDS wide of	cursorCursorRect	equ CurWidth+2CursorY1	equ CursorRectCursorX1	equ CursorY1+2CursorY2	equ CursorX1+2CursorX2	equ CursorY2+2CursorMode	equ CursorX2+2CursorRecPtr	equ CursorMode+2CursorPtr	equ CursorRecPtr+4MaskPtr	equ CursorPtr+4CursorPtr1	equ MaskPtr+4MaskPtr1	equ CursorPtr1+4CursorPtr2	equ MaskPtr1+4MaskPtr2	equ CursorPtr2+4CursorPtr3	equ MaskPtr2+4MaskPtr3	equ CursorPtr3+4CursorPtr4	equ MaskPtr3+4MaskPtr4	equ CursorPtr4+4CursorPtr5	equ MaskPtr4+4MaskPtr5	equ CursorPtr5+4CursorPtr6	equ MaskPtr5+4MaskPtr6	equ CursorPtr6+4CursorPtr7	equ MaskPtr6+4MaskPtr7	equ CursorPtr7+4SaveHandle	equ MaskPtr7+4SavePtr	equ SaveHandle+4SaveSize	equ SavePtr+4CursorRef	equ SaveSize+2MaskRef	equ CursorRef+4HotSpot	equ MaskRef+4SaveRef	equ HotSpot+4ScreenRef	equ SaveRef+4CursorLevel	equ ScreenRef+2ObscureFlag	equ CursorLevel+2StartWord	equ ObscureFlag+2ScreenIndex	equ StartWord+2SaveIndex	equ ScreenIndex+2CurrentY	equ SaveIndex+2ThisOut	equ CurrentY+2LastOut	equ ThisOut+2SrcRef	equ LastOut+2DestRef	equ SrcRef+4ThisWord	equ DestRef+4HowManyWords	equ ThisWord+2WordCount	equ HowManyWords+2LineCount	equ WordCount+2HowFarToShift	equ LineCount+2CursorFlags	equ HowFarToShift+2TempRect	equ CursorFlags+2SaveRect	equ TempRect+8ZZEndofCursor	equ SaveRect+8Busy_M	equ $8000Shielded_M	equ $4000ForceU_M	equ $2000***SetCursorFlag	equ $0100	; flag used to say don't refresh backsave..SetCursorFlag	equ $2000	title 'UndrawCursor'****************************************************************** iUndrawCursor*** 4/10/90	Mensch** Added patch to allow for cursor handle being unlocked......******************************************************************iUndrawCursor	PROC EXPORT	jsr ReCalcCursorPtrs	jml ROMUnDrawCursor	; and recall the ROM undraw routine	EndP		title 'DrawCursor'****************************************************************** iDrawCursor** What the hey, this draws the cursor at the position* indicated on zp.** Change History** 21 Aug 86     SEG	     The calculation of the saveRect was*        wrong.  A test for which mode branched*        wrong for the 2 possible cases	making*        the 320 mode save rect too big	and the*        640 mode save rect too small.**        There is a	calculation where I	must add*        8 to a value.  I know the carry is set*        so I saved	a byte and added 7 without*        touching the carry.** 2/1/89    Mensch** Added support for	shadowed bank cursor...** 4/6/90	Mensch* Added support for non-flashing cursors* This entails not redrawing the cursor if a certain bit is set in the cursor mode* word...*****************************************************************iDrawCursor	PROC EXPORT	;-------------------------------------------------;; First we set up the bank.	phb	; save the current bank	sta >$FE1234;; Now unlock the cursor handle...	ldy #4	lda [SaveHandle],y	and #$7FFF	sta [SaveHandle],y	jsr ReCalcCursorPtrs;; Find out if we are shadowed...	lda >$E0C035	; get the shadow register	and #$0008	; test the shadowing flags!	bne @1	; if zero, then shadowing is on	pea $0101	; push on the shadowed bank	bra @2@1	pea $E1E1	; push this on stack@2	plb	; set bank twice to	plb	; clear stack;-------------------------------------------------;; Next we set up the cursor rectangle	lda MouseY	sec	sbc HotSpot	sta CursorY1	sta SaveRect	sta CurrentY	clc	adc CurHeight	sta CursorY2	sta SaveRect+4	lda MouseX	sec	sbc HotSpot+2	sta CursorX1	sta SaveRect+2	lda CurWidth	; get width in words	asl a	; make it  bytes	asl a	; make it pixels for 320 mode	bit CursorMode-1	bpl Width320	; Fixed 21 Aug 86	asl aWidth320	clc	adc CursorX1	sta CursorX2	sta SaveRect+6;-----------------------------------------------;; Now I calculate the real bounds of the ; SaveRect.;  	clc	; clear carry for use later	lda #%1111111111111100 ; load a with mask for 320 mode	bit CursorMode-1	; check real mode	bpl Still320	; if not 320 mode put one more	asl a	; zero at low and and set carry!Still320	tay	; put copy of mask in y	and SaveRect+2	; and with left edge of rect	sta SaveRect+2	; and save it	tya	; get make back	and SaveRect+6	; and with right edge	bcs Still640	; if carry is clear	then we know	adc #4	; that we were in 320 mode	bra SaveRtEdge	; so add 4 and save	rt edgeStill640		; ; otherwise add 8	and save rt edge	adc #7	; note that carry was set to get here;       ; and adding 7 with carry set is like;       ; adding 8.	(sorry to those who	follow);       ; This changed on;       ;    Aug 21, 1986;       ; by SEGSaveRtEdge	sta SaveRect+6;-------------------------------------------------;; Set up the StartWord (we don't use FinishWord) then ; Figure out which preshifted image to use and put; pointer to it in CursorRef and MaskRef.;	bit CursorMode-1	bmi Mode640	lda CursorX1	; make x value into	byte	asl a	; get sign into c	lda CursorX1	ror a	; preserve sign	and #$FFFE	; make even	sta StartWord	lda CursorX1	; which preshifted image do I use?	and #3	bra GetReadyMode640		; 	lda CursorX1	; make x value into	byte	asl a	; get sign into c	php	; and save it	lda CursorX1	ror a	; preserve sign	plp	ror a	; rotate again preserving sign	and #$FFFE	; make even	sta StartWord	lda CursorX1	; determin which of	the preshifted	and #7	; images to useGetReady	asl a	; use number in a as index into	asl a	; pointers on zp	asl a	tax	lda CursorPtr,x	sta CursorRef	lda CursorPtr+1,x	sta CursorRef+1	lda MaskPtr,x	sta MaskRef	lda MaskPtr+1,x	sta MaskRef+1;-------------------------------------------------;; Set up other important vars for looping.;	lda SavePtr	; put the pointer to the beginning	sta SaveRef	; of the save area into SaveRef	lda SavePtr+1	; (which will be bumped for each 	sta SaveRef+1	; scan line)	lda CursorY1	sta CurrentY	lda CursorMode	; see if we should backsave the new data	and #$0100	beq @1		lda CursorMode	; and take this oportunity to turn off this bit	and #$FEFF	; strip just that bit...	sta CursorMode		lda #$FFFF@1	sta HowFarToShift	; we reuse cursor <X> just for grins here;-------------------------------------------------;; The Outer Loop;;    For each scan line (CursorY1 thru CursorY2);OuterLoop		; 	lda CurrentY	bpl NotAbove	jmp BumpVertCountersNotAbove	cmp #ScreenHeight	bmi NotBelow	jmp AllDoneNotBelow	cmp CursorY2	bmi YesDoIt	jmp AllDoneYesDoIt		; ;-------------------------------------------------;; Now I set up the loop to save the screen,; or in the mask and eor in the cursor all in; one loop;	lda CurWidth	; init the word count again (1 more	dec a	sta WordCount	; than before)	lda StartWord	; Screen Index starts at start word	sta ScreenIndex	lda CurrentY	; ScreenRef is created from current	asl a	; Y	tax	lda >ScreenTable,x	sta ScreenRef	stz SaveIndex	; Save index starts	at zeroDrawLoop	ldy ScreenIndex	; get screen index	bmi OffScrnH	; and see if it points ot real	cpy #ScreenWidth	; screen	bpl OffScrnH	lda (ScreenRef),y	; Save under cursor	ldy SaveIndex	; put in save buffer; put in code here to muffle the save if needed...	bit HowFarToShift	; now contains our flag...	bmi @1	sta [SaveRef],y@1	ora [MaskRef],y	; NOTE: save some fancy <Y> shuffling	tyx	; need to have this in <X>	; Was ...	lda [MaskRef],y	; get word from mask;	tyx	; save this here for quick access;	ldy ScreenIndex	; get this back;	ora (ScreenRef),y	; or with screen;	txy		eor [CursorRef],y	; eor with rotated cursor	ldy ScreenIndex	sta (ScreenRef),y	; store in screen	inx	; bump this now that is in a register	inx	; register	stx SaveIndex	iny	; bump this now since it is in a	iny	; register	sty ScreenIndexFinishLoop	dec WordCount	; dec the word count and	bpl DrawLoop	; repeat till done	bra BumpVertCounters ; now bump vert countersOffScrnH	inc ScreenIndex	; These were not bumped	inc ScreenIndex	; in loop since cursor was clipped	inc SaveIndex	inc SaveIndex	bra FinishLoopBumpVertCounters		; 	inc CurrentY	lda CurWidth	; use this to calc width	asl a	tax	; save in x	clc	; add to cursor ref	adc CursorRef	sta CursorRef	txa	; add to mask ref	clc	adc MaskRef	sta MaskRef	txa	; inc once and add to SaveRef	inc a	inc a	clc	adc SaveRef	sta SaveRef	jmp OuterLoopAllDone	plb	; restore stack	rtl	ENDPReCalcCursorPtrs	proc Export;; This routine can be called by the draw or erase routines to determine if the; cursor ptrs are correctly set up, this will allow us to leave the cursor image; unlocked once its created so that it can move whenever needed; NOTE: This relies on savesize being set properly...;; First determine if the handle has moved since the last time...	lda SavePtr	cmp [SaveHandle]	bne @DoRecalc	ldy #2	lda SavePtr+2	cmp [SaveHandle],y	bne @DoRecalc	rts	; else, the pointers are set up just fine@DoRecalc	ldy #2	lda [SaveHandle],y	sta SavePtr+2	lda [SaveHandle]	sta SavePtr		lda SavePtr	; the first pointer	is savesize past	clc	; saveptr.	adc SaveSize	sta CursorPtr1	lda SavePtr+2	adc #0	sta CursorPtr1+2	ldx #0SetUpLoop	lda CursorPtr1,x	clc	adc SaveSize	sta CursorPtr1+4,x	lda CursorPtr1+2,x	adc #0	sta CursorPtr1+6,x	inx	inx	inx	inx	cpx #13*4	; 52, 7 sets of two	pointers	bcc SetUpLoop	rts		END