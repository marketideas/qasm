************************************************************************ Patch to Misc.Tools* For ROM 3.0** Copyright 1985-1992* Apple Computer, Inc.* All Rights Reserved************************************************************************* 17-Sep-90	Dave Lyons** Changed version number to $8302 for 6.0.* Fixed ConvSeconds to return carry clear on no error, and to return*   an error when convVerb is too big by one.* Added SysBeep2 skeleton.** 1-Oct-90	Dave Lyons** Finished SysBeep2.  Added the actual call to _SendRequest.** 16-Oct-90	Dave Lyons** Strip off bit 15 of the SysBeep2 parameter when sending it to* SendRequest.  It's just a flag specifying whether to beep if* nobody accepts the request.** 5-Dec-90	Dave Lyons** Added VersionString call to convert 32-bit version numbers into* strings (12.3.4d56).** 11-Dec-90	Dave Lyons** Changed definition of Stage field in VersionString version number.* "Final" is now distinct from "released."** 6-Jan-91	Dave Lyons** Added WaitUntil call for maxxing out the speed of repeated user-* visible actions (like continuous scrolling, zoom-rect effects,* menu item blinking, and control blinking).** 9-Jan-91	Dave Lyons** Made WaitUntil multiply the delay by BRAM $60 minus 1, unless the* location is $00 or $FF (defaults for ROM 1 and ROM 3).  The wait* maxxes out at $F00 ticks (64 seconds).** 11-Feb-91	Dave Lyons** Implemented bit 14 in SysBeep2 (defers the request until the next* GetNextEvent which allows mouse presses or keypresses).** 14-Feb-91	Dave Lyons** Made bit 14 in SysBeep2 do nothing if the Event Manager isn't started.** 16-Feb-91	Dave Lyons** Patched GetROMResource so I can easily override the ChooseFont* resources.  (I could just put them in Sys.Resources, but this way* I can continue using pointers within the resources.)** 4-Mar-91	Dave Lyons** Added new call StringToText to translate "Shaston 8" style text into* text-display text, with or without mousetext.  Total RAM about 1.25K.** 9-Mar-91	Dave Lyons** A SysBeep2 call with the defer-till-GNE bit set is now ignored if* there is already one pending.** 29-Mar-91	Dave Lyons** Added new calls ScanDevices and ShowBootInfo.** 1-Apr-91	Dave Lyons** Added 2 scanlines to the top of the area that FillScreenBottom* fills with $DDDD when we are about to run off the right edge.** 2-Apr-91	Dave Lyons** Change ShowBootInfo to draw to the Text screen or SHR screen,* but not both.  Fix first-time-here logic accordingly.** 14-Apr-91	Dave Lyons** Change StringToText so that if the source text is contained in* the result buffer, I make a separate copy of the source text* before processing.  This is partly for the benefit of ProDOS* JudgeName.** Added a ResultFlags parameter to StringToText so the caller* can tell if any changes were made to the string.** 6-May-91	Dave Lyons** Added parnoia check to ShowBootInfo so an icon can't get drawn* past the bottom of the screen.** 9-May-91	Dave Lyons** Fixed lots of error handling in ConvSeconds.  Implemented the* cool ProDOS 8 year scheme.** 20-May-91	Dave Lyons** Setting bit 31 of the iconPtr to ShowBootInfo makes it re-use* the previous position (the icon that overprints it ought to be* the same width!).** Patched SysFailMgr to enable text page 1 shadowing.** Changed ConvSeconds FromProDOS (verb 5) so it doesn't trash the* input buffer.  Verb 11 (HC to Seconds) restores the input buffer.** 2-Jul-91	Dave Lyons** In ShowBootInfo, added check for bit 1 of BRAM location $5F.  If* set, we don't draw the icon.** SysBeep2 now sends to Apple~SoundCP~ before broadcasting the request.** 8-Jul-91	Dave Lyons** ShowBootInfo now does nothing if QuickDraw is started (in case some* DA or CDev gets initialized at some time other than boot time).* Also, bit 31 of the string pointer makes ShowBootInfo reinitialize* itself.  (This happens at DeskStartUp time.)** 22-Aug-91	Dave Lyons** ShowBootInfo now prints a CR after printing a text string.** 17-Sep-91	Dave Lyons** Link some stuff into Tool.Setup instead of TS2/3.  Routines moved* are:  UnPackBytes, ConvSeconds, SysBeep2, VersionString, WaitUntil,* StringToText, ShowBootInfo, ScanDevices.** 14-Oct-91	Dave Lyons** Made StringToText return a reasonable length when possible even if* it returns error $034F, buffer too small.** 1-Nov-91	Dave Lyons** Made MTBootInit zap E1/0196 and E1/0197, so that ReadMouse will* return a valid Status byte.** 16-Jan-92	Dave Lyons** StringToText:  Changed translation of German "§" ($A7) to "ss".* Made some optimizations, including making the translate table* entries 5 bytes each instead of 6.  Added 32 new translations* per Yvan Koenig.** 21-Jan-92	Dave Lyons** StringToText:  Fixed flags on the §-->ss translation to show* that it's a lengthening translation.** 27-Jan-92	Dave Lyons** Added ToBramSetupPatch (sets bank to $00 around call).** 30-Jan-92	Dave Lyons** Fixed a problem in UnPackBytes where a %10xxxxxx packet was not* correctly checking the remaining space in the output buffer (it* was off by a factor of two).** 5-Feb-92	Dave Lyons** Version $0302 for 6.0 final.** 6-Feb-92	Dave Lyons** Oops, fixed bad compare in StringToText (introduced 16-Jan).************************************************************************* Begin 6.0.1** 12-Mar-92	Dave Lyons** Version $8303.** Make ShowBootInfo start a new row (higher) if the first one fills up.** 23-Jun-92	Dave Lyons** SysFailMgr now has better default messages for errors $0027 and $0201.** 1-Jul-92	Dave Lyons** Added message for SysFailMgr errors $0308, $0681, $0682.** 18-Jul-92	Dave Lyons** Made SysBeep2 send systemSaysForceUndim ($000D), for all codes except* $006x (screen blanking, screen unblanking).** 20-Aug-92	Dave Lyons** New calls AlertMessage and DoSysPrefs.** 1-Oct-92	Dave Lyons for 6.0.1d11** DoSysPrefs result is the *old* prefs value, not the new one.** 22-Oct-92	Dave Lyons for 6.0.1d12** DoSysPrefs returns error $0301 (and a random result) if GS/OS* is not the active operating system.** 2-Apr-93 DAL** Version $0303 for 6.0.1.***********************************************************************	entry MTInit	entry MTVer	entry GetAddr	entry ConvSeconds	entry SysBeep2	;17-Sep-90 DAL	entry UnPackBytes	;23-Oct-90 DAL	entry VersionString	;5-Dec-90 DAL	entry WaitUntil	;6-Jan-91 DAL	entry GetROMResource ; 16-Feb-91 DAL	entry StringToText	;4-Mar-91 DAL	entry ScanDevices	;29-Mar-91 DAL	entry ShowBootInfo	;29-Mar-91 DAL	entry NewSysFail	;20-May-91 DALMTVersionNumber	equ $0303	;2-Apr-93 DAL	include ':::sys.equs.asm'	include 'all.macros'PendingSysBeep2	equ $E1167EMTCallTable	PROC EXPORT	Here	DC.L (TheEnd-Here)/4 ; num calls +1	DC.L MTInit-1	; PowerUp Initialization	DC.L 0	; application startup	DC.L 0	; application shutdown	DC.L MTVer-1	; version number	DC.L 0	; Misc. Tools Reset	DC.L 0	; MTStatus	DC.L 0	; Reserved	DC.L 0	; Reserved	DC.L 0	; Write battery ram	DC.L 0	; Read battery ram	DC.L 0	; Write battery ram	parameter	DC.L 0	; Read battery ram parameter	DC.L 0	; read clock w/ hex	format	DC.L 0	; write clock w/ hex format	DC.L 0	; read clock w/ ascii format	DC.L 0	; set interrupt vector	DC.L 0	; get interrupt vector	DC.L 0	; insert procedure in Heartbeat chain	DC.L 0	; delete procedure from heartbeat chai	DC.L 0	; clear heartbeat chain	DC.L NewSysFail-1	; system death manager (patched 20-May-91 DAL)	DC.L GetAddr-1	;  ???	DC.L 0	; Read Mouse	DC.L 0	; initialize mouse	DC.L 0	; set mouse mode	DC.L 0	; home mouse position to min. clamp	DC.L 0	; clear mouse position to 0	DC.L 0	; set both X and Y clamps	DC.L 0	; get both X and Y clamps	DC.L 0	; set mouse position	DC.L 0	; service mouse interrupt	DC.L 0	; get ID tag	DC.L 0	; delete ID tag	DC.L 0	; get ID tag status	DC.L 0	; enable interrupt source	DC.L 0	; Firmware entry points	DC.L 0	; get tick counter contents	DC.L 0	; Pack bytes	DC.L 0  ;[ts] UnPackBytes-1	; UnPack dem dere bytes	DC.L 0	; This routine munges strings	DC.L 0	; returns IRQ enble	status	DC.L 0	; set absolute device clamps	DC.L 0	; get absolute device clamps	DC.L 0	; 2C03 system beep	dc.L 0	; 2D03 NewBasicInit	; added 07 sep 88	DC.L 0	; 2E03 AddToQueue	; added 10 sep 88	DC.L 0	; 2F03 RemoveFromQueue ; added 10 sep 88	dc.L 0	; 3003 SetInterruptState added 24 Nov 88	dc.L 0	; 3103 GetInterruptState added 24 Nov 88	dc.L 0	; 3203 GetIntStateRecSize added 24 Nov 88	dc.L 0	; 3303 ReadMouse2 Added 13 Jan 89	dc.L 0	; 3403 GetCodeResConverter added 13 Jan 89 {$3403}	dc.L GetROMResource-1 ; 3503 GetROMResource added 24 Jan 89 ($3503}	dc.L 0	; 3603 ReleaseROMResource added 24 Jan 89 {$3603}*** 5.0.3	dc.L 0  ;[ts] ConvSeconds-1	; 3703 added 3/14/90*** 6.0	dc.L 0  ;[ts] SysBeep2-1	; 3808 added 17-Sep-90 DAL	dc.L 0  ;[ts] VersionString-1 ;3903 added 5-Dec-90 DAL	dc.l 0  ;[ts] WaitUntil-1	; 3A03 added 6-Jan-91 DAL	dc.l 0  ;[ts] StringToText-1	; 3B03 added 3-Mar-91 DAL	dc.l 0  ;[ts] ShowBootInfo-1	; 3C03 added 29-Mar-91 DAL	dc.l 0  ;[ts] ScanDevices-1	; 3D03 added 29-Mar-91 DAL*** 6.0.1	dc.l 0  ;[ts] AlertMessage-1	; 3E03 added 20-Aug-92 DAL	dc.l 0  ;[ts] DoSysPrefs-1	; 3F03 added 20-Aug-92 DALTheEnd	ENDP****************************************************************** ToBramSetupPatch -- new for 6.0d66, DAL** We never documented that you should set the bank to $00 when* calling ToBramSetup ($E10094), so people call it with random* banks, and the firmware trashes memory while trying to fiddle* with softswitches ($C036 and $C02D).** (This patch gets installed by CommonPatches in Tool.Setup.)*****************************************************************ToBramSetupPatch	proc export	export oldToBramSetupCall	phb	pea 0	plb	plboldToBramSetupCall	jsl >$777777	plb	rtl	EndP*****************************************************************MTVer	Proc** Returns new version number*** Inputs:*	none** Outputs:*	VersionNumber : word** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	lda #MTVersionNumber	sta 7,s	lda #0	clc	rtl	ENDP*****************************************************************MTInit	PROC** Dummy Init routine prevents real init routine from being* called twice when this patch is installed.*** Inputs:*	none** Outputs:*	none** External Refs:** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	lda #0*** added 1-Nov-91 DAL -- zero out mouse mode byte, since ReadMouse***  is returning some garbage.	sta >$E10196	;zap MseStat and MseMode*** end 1-Nov-91 DAL		clc	;A is still zero	rtl	ENDP****************************************************************** NewSysFail -- ROM 03 patch for SysFailMgr (20-May-91 DAL)** One fix to the ROM:  Enable text page 1 shadowing.*****************************************************************NewSysFail	proc	import ComputeDefaultFailMsg	jsr ComputeDefaultFailMsg	;23-Jun-92 DAL	lda >$e0c035	and #$fffe	sta >$e0c035	jml >$feb03c	EndP****************************************************************** ComputeDefaultFailMsg -- 23-Jun-92 DAL** Called from SysFailMgr.  If the supplied string pointer is* NIL (for "Fatal System Error " string) then use special* messages for common error codes.** The stack looks like this:** 13-14:  error number*  9-12:  message pointer*   6-8:  RTL*   3-5:  RTL*   1-2:  RTS address*****************************************************************ComputeDefaultFailMsg proc export@msg	equ 9@error	equ 13	lda @msg,s	ora @msg+2,s	bne @cantTouchMe	lda @error,s	sta >codeTable	ldx #msgTable-codeTable@search	dex	dex	cmp >codeTable,x	bne @search	lda >msgTable,x	sta @msg,s	beq @stillNIL	lda #ComputeDefaultFailMsg>>16	sta @msg+2,s@stillNIL@cantTouchMe	rtscodeTable	dc.w $7777,$0027,$0201,$0308,$0681,$0682msgTable	dc.w $0000,ioError,outOfMemory,trashError,trashError,trashErrorioError	dc.b ioErrorEnd-ioError-1	dc.b 'Could not read or write disk.  The disk',13	dc.b 'may be damaged.  Error $'ioErrorEndoutOfMemory	dc.b oomEnd-outOfMemory-1	dc.b 'Out of memory (or required memory area',13	dc.b 'was already in use).  Error $'oomEndtrashError	dc.b trashEnd-trashError-1	dc.b 'Detected trashed memory--software bug',13	dc.b 'or (less likely) bad RAM.  Error $'trashEnd	EndP	title 'GetAddress'****************************************************************** Return Interrupt Status Address** Input     word	     refnum* Input     LongWord     Don't care** Output    LongWord     Pointer** Modification History**    May 6, 1986	See 5 lines changed	below.*****************************************************************GetAddr	PROCROMGetAddr	equ $FEB04BROMoEndCall2	equ $FEFBF7	RTL1	equ 1RTL2	equ RTL1+3RefNum	equ RTL2+3Ptr	equ RefNum+2	lda RefNum,s	; get ref #	cmp #$00FF	; index our special address? ?	beq GetAddrSerial	;	jml ROMGetAddr	; GetAddrSerial		; 	tax	; get param. addr	lda >Ptbl	; abs long,x addressing SEG 6 May 86	sta Ptr,s	lda >Ptbl+2	; abs long,x addressing SEG 6 May 86	sta Ptr+2,s	; missing +2 SEG 6 May 86	jml ROMoEndCall2	; uses oEndCall SEG	6 May 86Ptbl		; 	DC.L $E11dd8	; status of INTFLAG	at IRQPtblEnd		; 	ENDP	eject	title 'Unpack bytes'** Patched 23-Oct-90 DAL for System 6.0** There's a small but deeply-buried bug in the ROM version (01 and 03).**************************************************************************			           **  FUNCTION UnPackBytes(    BufPtr : POINTER;	           **	        BufSize: INTEGER;	           **	    VAR PicPtr : POINTER;	           **	    VAR PicSize: INTEGER) : INTEGER;	           **			           **  Params:  BufPtr - pointer to area containing packed data	           **           BufSize- max size of area containing packed data           **           PicPtr - Pointer to start of area to unpack into           **           PicSize- Maximum space available for unpacked picture      **			           **  Returns: UnPackBytes return Value: Actual number of bytes unpacked  **           PicPtr:	Updated to one past	end of last byte unpacked      **           PicSize: reduced by number of bytes of picture generated   **			           **        ------------------------------------------------------        **			           **  Sample Calls:			           **			           *			           **        OpenFile;			           **        Mark:=StartofFile;		           **        PicSize:=$7d00;		           **        BufSize:=$400;		           **        REPEAT			           **          SetFileMark(Mark);		           **          Read(f,BufPtr,Bufsize);		           **          HowMuch:=UnPackBytes(BufPtr,BufSize,PicPtr,PicSize);        **          Mark:=Mark+HowMuch;		           **        UNTIL ( (PicSize=0) OR EOF(f) );	           **			           **     -----------------------------------------------------------      **			           **    Packed data encryption format:		           **			           **        %00xxxxxx : (xxxxxx : 0->63) =	1 to 64 bytes follow -         **		       All Different           **			           **        %01xxxxxx : (xxxxxx : 1,2,3,5,6,7) = 1,2,3,5,6,7 repeats -    **		       of next byte	           **			           **        %10xxxxxx : (xxxxxx : 0->63) =	1 to 64 repeats -	           **		       of next 4 bytes         **			           **        %11xxxxxx : (xxxxxx : 0->63) =	1 to 64 times 4 repeats -      **		       of next byte	           **			           **    -----------------------------------------------------------       **			           **  Written By: Eagle I. Berns		           **			           **  Modification History:		           **			           **  10-DEC-85   EIB		First coding begun	           **   5-Mar-87   SEG		Error code returned	is now 0   **		in both Pack and Unpack        **  23-Oct-90   DAL		Fixed low-probability compare  **		bug (see comments)             **			           *************************************************************************UnPackBytes	PROC exportfrom	equ 1to	equ from+4endbuf	equ to+4temp	equ endbuf+4count	equ temp+4lf	equ count+2Origdrct	equ lf+2rtl1	equ origdrct+2rtl2	equ rtl1+3PicSizeP	equ rtl2+3PicPtrP	equ PicSizeP+4Bufsize	equ PicPtrP+4BufPtr	equ BufSize+2Result	equ BufPtr+4;	  -> +2	PHD	; SET UP STACK AS ZERO PAGE +PARMS	TSC	SEC	SBC #ORIGDRCT-1	TCS	TCD	LDA [PICPTRP]	; GET THE ARGS.	TAX	; (PicPtrP needs dereference)	LDY #2	LDA [PICPTRP],Y	STA TO+2	STX TO	LDA [PICSIZEP]	STA COUNT	LDA BUFPTR	STA FROM	CLC	ADC BUFSIZE	STA ENDBUF	LDA BUFPTR+2	STA FROM+2	ADC #0	STA ENDBUF+2DoUnpack	LDY #0	LDA [FROM],Y	; GET THE COMMAND	STA TEMP	AND #$3F	TAX	; GET COUNT ONLY INTO X	INC FROM	; BUMP TO FIRST BYTE TO TRANSFER	BNE M1	INC FROM+2M1	BIT TEMP-1	; V & C BITS GIVE COMMAND	BMI REP4	BVS REP1	; 01xxxxxx -> REPEAT NEXT 1 BYTE	BRA DIFF	; 00xxxxxx -> ALL DIFFERENTREP4	BVS REP41	; 11xxxxxx -> REPEAT 4 OF NEXT 1 BYTE	BRA REP44	; 10xxxxxx -> REPEAT OF NEXT 4 BYTESOUTP	PLA	JMP UDONE	; GO FINISH UP******************************************		** DIFF : 0 ->63 IN A MEANS  1->64	**   DIFFERENT BYTES	FOLLOW TO BE MOVED	**		******************************************DIFF	PHA	; WHEN WE GO TO COMMON CODE, WE NEED;		  SOMETHING STACKED	(OTHER CALLS USE IT)	BRA JOIN******************************************		** REP1 : 1,2,3,5,6,7 REPEATS OF FOLLOW-	**        ING BYTE.		**		******************************************REP1	LDA TEMP	; PUT BYTE IF LOW &	HIGH & ON STACK	AND #$FF00	PHA	XBA	ORA 1,S	STA 1,S	BRA JOIN	; JOIN UP, X=LEN IS	CORRECT STILL******************************************		** REP41 : IS SAME AS REP1 ABOVE, EXCEPT	**         COUNT IN X MUST BE 4 TIMES >	**		******************************************REP41	INX	TXA	ASL A	ASL A	TAX	DEX	BRA REP1******************************************		** REP44 : MUST SET UP FOR 2 STORES I.E.	**         4 BYTES WORTH, AND COUNT IS	**         DOUBLED (2 STORES EACH TIME)	**		******************************************REP44	INX	TXA	ASL A*** added 30-Jan-92 DAL	asl a	;actually, quadruple X*** end 30-Jan-92	TAX	; FIRST DOUBLE X	DEX	PHA	; MUST PUT SOMETHING ON STACK FOR;		  OTHER CASES*        BRA   JOIN		; WE FIND 4 BYTES AT [FROM],* (FALL THROUGH TO JOIN)	; SO MUST REMEMBER TO FIND IT THERE******************************************		** JOIN : HERE, THE LOAD STORE SEQUENCE	**        OF DATA TRANSFER TAKES PLACE	**		******************************************JOIN	CPX COUNT	; BE SURE THERE'S ROOM	BGE OUTP	; NO - DONE   (BUT PULL OFF EXTRA PUSH)	LDA #1	; CHECK IF LENGTH WOULD GO OVER	BIT TEMP-1	; DEPENDS ON TYPE OF CMD.	BVS L1	; LEN=1 FOR %01 & %11	BMI L4	; LEN=4 FOR %10	TXA	INC A	; LEN=N+1 FOR %00..N...	BRA L1L4	LDA #4L1	CLC	; FROM+LEN .LT. ENDBUF MEANS NOT DONE	ADC FROM	PHA	; SAVE FOR COMPARE	LDA FROM+2	ADC #0	CMP ENDBUF+2	BCC NOTDONP	bne WeAreDone	;added 23-Oct-90 DAL	PLA	CMP ENDBUF	BLT NOTDON	BEQ NOTDON	BRA OUTPWeAreDone	pla	;added 23-Oct-90 DAL	bra OutP	;added 23-Oct-90 DALNOTDONP	PLANOTDON	CPX #0	; (NEEDED FOR 1ST ENTRY IN LOOP)LOOP	BMI DOUPD	; YES******************************************		** MOVEIT : USED LOCALLY TO FETCH PROPER	**          INPUT, DEPENDING ON TYPE OF	**          CMD. BEING PROCESSED	**  NOTE: X<0 MEANS STORE 1 BYTE ONLY	******************************************	BIT TEMP-1	; THIS HAS THE FLAGS	BMI MREP4	BVS MREP1	CPX #0	; IF NEG. IT'S ONE BYTE ONLY	BEQ MSPEC	LDA [FROM],Y	STA [TO],Y	INY	INY	JMP NDMOVMSPEC	SEP #%00100000	LDA [FROM],Y	STA [TO],Y	REP #%00100000	INY	JMP NDMOVMREP1	CPX #0	BEQ M2SPEC	LDA 1,S	STA [TO],Y	INY	INY	JMP NDMOVM2SPEC	SEP #%00100000	LDA 1,S	STA [TO],Y	REP #%00100000	INY	JMP NDMOVMREP4	BVS MREP1	;REP41 SAME AS REP1	BUT LARGER COUNT	LDA [FROM]	STA [TO],Y	PHY	; HOLD Y A SEC	LDY #2	LDA [FROM],Y	PLY	INY	INY	STA [TO],Y	INY	INY*** added 30-Jan-92 DAL -- corresponds to extra ASL A added above	dex	dex*** end 30-Jan-92******NDMOV	DEX	DEX	BRA LOOP	; GO DO NEXT ONESDOUPD	PLA	; GET RID OF EXTRA PUSH	LDA TEMP	; UPDATE APPROPRIATE POINTERS	AND #$3F	INC A	BIT TEMP-1	BMI XREP4	; FROM DEPENDS ON TYPE	BVC XDIFF	; FOR 00xxxxxx ADD LENGTHFP1	LDA #1	; FOR 01xxxxxx ADD 1XDIFF	CLC	ADC FROM	STA FROM	LDA FROM+2	ADC #0	STA FROM+2	BRA DOTOXREP4	BVS FP1	; FOR 11xxxxxx ALSO	ADD 1	LDA #4	; FOR 10xxxxxx ADD 4	BRA XDIFFDOTO	TYA	; Y IS OUTPUT COUNT	CLC	ADC TO	STA TO	LDA TO+2	ADC #0	STA TO+2	TYA	STA TEMP	LDA COUNT	SEC	SBC TEMP	STA COUNT	JMP DOUNPACKUDONE	LDA FROM	SEC	SBC BUFPTR	DEC A	STA RESULT	; SET RESULT LENGTH	LDA TO	SEC	SBC [PICPTRP]	PHA	; HOLD IT, NEED SIZE - IT	LDA [PICSIZEP]	SEC	SBC 1,S	STA [PICSIZEP]	PLA	LDA TO	STA [PICPTRP]	LDA TO+2	LDY #2	STA [PICPTRP],Y	LDA ORIGDRCT	TCD	LDA RTL1,S	;FIX STACK UP CORRECTLY	STA RESULT-6,S	LDA RTL1+2,S	STA RESULT-4,S	LDA RTL1+4,S	STA RESULT-2,S	TSC	CLC	ADC #RESULT-7	TCS	LDA #0	; fix by SEG 5 March 87	CLC	; fix by SEG 5 March 87	RTL	ENDP	EJECT********************************************************************************* ConvSeconds   $3703** Description:	This routine converts number of seconds from 1904 to date or *	the passed date into seconds since 1904. It does so by cleverly*	patching the toWriteTime and toReadTime vectors...** Inputs:	Direction - Integer	tells whether to convert to or from*	Seconds - Longint	the number of seconds since 1904 (to from)*	Date - ptr	pointer to area to store the date...** Outputs:	seconds - longint	the number of seconds returned (from into)** Direction indicators are:* 	0 - From Seconds to MiscTools hex time format*	1 - From MiscTools hex time to seconds*	2 - From Seconds to ASCII Time *	3 - NOT IMPLEMENTED*	4 - From Seconds to ProDOS DateTime Record*	5 - From ProDOS DateTime to Seconds*	6 - Get Current seconds*	7 - Set Current seconds*	8 - ToMTFromProDOS*	9 - ToProDOSFromMT*	10 - From seconds to IdunaHexTime*	11 - From IdunaHexTime to seconds** Seconds Input - 	LongInteger representing the number of seconds since Jan 1 1904. This is*	used in all From Seconds conversions and in Set Current Seconds.** Date Input -	Pointer to a properly formated date for the direction indicated ASCII time*	should have a 80 byte buffer.  Not used for GetSeconds.** Seconds Output -	Contains the number of seconds since jan 1 1904 for all conversions. for*	from seconds calls, this contains the seconds input. For to seconds calls*	this contains the result of the call.** Formats Used:** ProDOS DateTime	Word	Date*	  Bits 0-4	Day (1-31)*	  Bits 5-8	Month (1-12)*	  Bits 9-15	Year (year-1900)*	Word	Time*	  Bits 0-7	Minute (0-59)*	  Bits 8-15	Hour (0-23)** MTHex Format	Byte	Seconds (0-59)*	Byte	Minute (0-59)*	Byte	hour (0-23)*	Byte	Year (year-1900)*	Byte	day (0-30)*	Byte	month (0-11)*	byte	null (MUST be zero)*	byte	weekday (1-7 1=sunday)** IdunaHexTime	Byte	Seconds (0-59)*	Byte	Minute (0-59)*	Byte	hour (0-23)*	Byte	Year (year-1900)*	Byte	day (1-31)*	Byte	month (1-12)*	byte	null (MUST be zero)*	byte	weekday (1-7 1=sunday)********************************************************************************ConvSeconds	PROC Export; Equates for the stack frame...oldDPage	equ 1oldPStatus	equ oldDPage+2theRTL1	equ oldPStatus+1TheRTL2	equ theRTL1+3theDate	equ theRTL2+3theSecs	equ theDate+4theVerb	equ theSecs+4result	equ theVerb+2BadTimeVerb	equ $0390	; error for a bad time verbBadTimeData	equ $0391	; input data was bad (Bad boy!)	php	phd	; set up our stack frame...	tsc	tcd	lda <theVerb	; call the proper routine...	asl a	cmp #TimeTblSize	; are we out of bounds? (removed "+1" 17-Sep-90 DAL)	bge @BadTime	; if so we have a bad verb	tax	jsr (timetbl,x)	; call the proper routine...	bcs @Endit	;added 9-May-91 DAL -- each routine must return CLC or SEC/X=error	ldx #0	; set the noerrorflag	bra @EndIt@BadTime	ldx #BadTimeVerb@Endit	lda <theRTL1	sta <theSecs	lda <theRTL1+2	sta <theSecs+2	lda <theRTL1+4	sta <theSecs+4		pld	plp		pla	; pull off parameters	pla	pla	pla	pla		txa 	; recover the error code..	cmp #1	; was CMP #0 (17-Sep-90 DAL)	rtl	; return to caller...	TimeTbl	dc.W ToMTHexFormat		;0	dc.W fromMTHexFormat	;1	dc.W ToASCIITimeFormat	;2	dc.W TimeDummy		;3	dc.W ToProDOS		;4  convert to ProDOS Date Time...	dc.W FromProDOS		;5	dc.W JustGetCurrent		;6	dc.W JustSetCurrent		;7	dc.W ToMTFromProDOS		;8	dc.W ToProDOSFromMT		;9	dc.W ToIdHexFormat		;10	dc.W fromIDHexFormat	;11TimeTblSize	equ *-TimeTbl;-----------------------------------------------------------------------;ToIDHexFormat; Special routine that bumps the output from the ToMTHexTime format; routine, this is put in for the convenience of the Iduna guys...;	jsr ToMTHexFormat	; convert to the hex format...	bcs @ErrorBad	; some form of error occured!	ldy #4	lda [theDate],y	; get the day/month word in...	clc	adc #$0101	; don't have to worry about an overflow!	sta [theDate],y; note: carry is clear@ErrorBad	rts	;-----------------------------------------------------------------------;FromIDHexFormat; Special routine that bumps the output from the ToMTHexTime format; routine, this is put in for the convenience of the Iduna guys...;	ldy #4	; perform the necessary subtraction..	lda [theDate],y	sec	sbc #$0101	sta [theDate],y	jsr fromMTHexFormat	; convert to the hex format...*** added 20-May-91 DAL -- put the user's buffer back how it was	ldy #4	lda [theDate],y	clc	adc #$0101	sta [theDate],y*** end of 20-May-91 DAL	rts	;-----------------------------------------------------------------------;JustGetCurrent;; This routine gets the current time in seconds from the internal routine and ; places it in the result...	sep #$30	jsl ToReadTime	rep #$30	bcc @GotTimeOK;;;	ldx #$2403	ldx #$0307	;firmTaskErr (carry is already set) [DAL]	rts@GotTimeOK	lda >ClkRData	sta <Result	lda >ClkRData+2	sta <Result+2;;	ldx #0	; flag no error and return	clc	;DAL	rts;----------------------------------------------------------------------;JustSetCurrent; This routine sets the current time to the seconds you passed;	lda theSecs	sta >ClkWData	lda theSecs+2	sta >ClkWData+2	sep #$30	Longa Off	Longi Off	phb	; save the old data bank	lda #$E1	; and set proper bank for towritetime	pha	plb	jsl ToWriteTime	plb	; restore old data bank	rep #$30	Longa on	LongI on;	ldx #0	clc	;DAL	rts	; and finish	;--------------------------------------------------------------------;ToProDOS; This routine converts seconds to ProDOS8 time format; It leverages off of the MTHex converter for its proper use...;	jsr ToMTHexFormat	; get it in the MTHex format first...; Time is now in misctools hex format, run it through the converter.; its in [theDate] and must end up there...ToProDOSFromMT	ldy #1	lda [theDate],y	; load the minutes/hours and save em	sta <theSecs+2	; save as the high word of the seconds parameter	iny	lda [theDate],y	; get the year back...	and #$FF00	; strip it off by itself*** ProDOS year 40..99 = 1940..1999, 0..39 = 2000..2039 (9-May-91 DAL)*** We have A=$xx00, where XX = year-100.  If this is less than 40, clip to 40.*** If this is more than 99, we need to subtract 100 and max out at 39.	cmp #40*256	bcc @clipTo1940	cmp #100*256	bcc @yearIsFine	sbc #100*256	;carry was already set	cmp #39*256	bcc @yearIsFine	lda #39*256	bra @yearIsFine@clipTo1940	lda #40*256@yearIsFine*** end of 9-May-91 DAL	asl a	; rotate it to the proper bit position	sta <theSecs	; and save it...	ldy #4	lda [theDate],y	; now get the day/month...	tax	; save it for a second..	and #$001F	; strip the day	inc a	; add 1 for good measure	ora <theSecs	; add it to the year	sta <theSecs	; and cache it again	txa	and #$0F00	; strip the month off...	xba	inc a	xba	lsr a	; shift it over 3 bits right	lsr a	; shift it over 3 bits right	lsr a	; shift it over 3 bits right	ora <theSecs	; add it to the rest of the pdos date	sta [theDate]	; and put it in the returned record	ldy #2	lda <theSecs+2	sta [theDate],y	; now store the pdos time in the record	clc	; return no error (DAL)	rts	;--------------------------------------------------------------------;FromProDOS; This routine takes a ProDOS formatted datetime record and converts it; to seconds. To do this it first converts it to MTHex format then it; calls fromMTHexFormat to finish the call...;***	jsr ToMTFromProDOS	; put it in MTHex format first***	bra FromMTHexFormat	; and now convert to to seconds*** rewrite FromProDOS, 20-May-91 DAL	pha	pha	ldy #2	lda [<theDate],y	pha	lda [<theDate]	pha	tsc	inc a	sta <theDate	stz <theDate+2	;point <theDate at 8 bytes on the stack	jsr ToMTFromProDOS	; put it in MTHex format first	jsr FromMTHexFormat	; and now convert to seconds	pla	pla	pla	pla	;got rid of 8 temporary bytes	rts	;return Carry status from FromMTHexFormat*** end of 20-May-91 DALToMTFromProDOS	ldy #2	; first, suck up the timeword	lda [theDate],y	; we now have the time word...	tax	; save it in <X> for now	lda [theDate]	; now get the DateWord	sta <theVerb	; save the verb for a second	lda #0	; be sure to set seconds to zero..	sta [theDate]	dey	; offset for MTHex Minutes/hours	txa	; get the minutes/hours back...	sta [theDate],y	; and save it	lda <theVerb	; now extract the date data from ProDOS...	and #$FE00	; strip the year	lsr a	; make it a proper year	xba;; Clamp for pre 1904 dates here!;	cmp #4;	bge @yrOK;	lda #4;@YrOK*** 9-May-91 DAL -- use new definition of 7-bit ProDOS year number (P8 Technical Note #28)*** 40..99 = 1940..1999, 0..39 = 2000..2039	cmp #40	bcs @yearOK	adc #100@yearOK*** end of 9-May-91 DAL	ldy #3	; offset to the MTHexYear	sta [theDate],y	; and stow the year...	lda <theVerb	and #$001F	; strip the day off...	dec a	; convertit to MTHex base	iny	sta [theDate],y	; and now save the day...	lda <theVerb	and #$01E0	; finally strip the month..	asl a	; rotate it over by 3	asl a	asl a	; (its now in bits 8-11)	xba	; put it in the low word...	dec a	iny	sta [theDate],y	; and stow it..	clc	;return no error (DAL)	rts	; and simply return (Weekday not set by this routine)	;--------------------------------------------------------------------;ToMTHexFormat; This routine converts the seconds to MiscTools HexFormat;	php	sei	; turn off interupts	jsr FudgeTimeVectors	jsr SetupToData	jsr CallReadHex	; call readTimeHex	jsr RestoreTimeVectors	plp	clc	; for now, no errors	rts;--------------------------------------------------------------------;ToASCIITimeFormat; This routine converts the seconds to MiscTools HexFormat;	php	sei	; turn off interupts	jsr FudgeTimeVectors	jsr SetupToData	jsr CallReadASCII	; call readTimeHex	jsr RestoreTimeVectors	plp	clc	;no error (DAL)	rts;---------------------------------------------------------------------;FromMTHexFormat; This routine converts from MTHexFormat to seconds...;	php	sei	jsr FudgeTimeVectors	jsr CallWriteHex	jsr SetUpFromData	jsr RestoreTimeVectors	plp	clc	; for now no errors!	rts	TimeDummy	rtsFudgeTimeVectors;; First we patch both the toReadTime and toWriteTime vectors to do nothing but return;	lda >ToWriteTime	sta >OldWriteTime	lda >ToWriteTime+2	sta >OldWriteTime+2	lda >ToReadTime	sta >OldReadTime	lda >ToReadTime+2	sta >OldReadTime+2	;; and save the old contents of ClockRTime and clockWTime	lda >CLKRDATA	sta >savedRData	lda >CLKRDATA+2	sta >savedRData+2	lda >CLKRDATA+4	sta >savedRData+4	lda >CLKRDATA+6	sta >savedRData+6	;; Now patch in the new vectors, but first disable interupts...		lda >MyDummyRtn	sta >ToWriteTime	sta >ToReadTime	lda >MyDummyRtn+2	sta >ToWriteTime+2	sta >toReadTime+2	rts	SetUpToData	lda <theSecs	sta >CLKRDATA	lda <theSecs+2	sta >CLKRDATA+2	rts;	SetUpFromData	lda >CLKWData	sta <Result	lda >CLKWDATA+2	sta <Result+2	rts	RestoreTimeVectors	lda >SavedRData	sta >CLKRDATA	lda >SavedRData+2	sta >CLKRDATA+2	lda >SavedRData+4	sta >CLKRDATA+4	lda >SavedRData+6	sta >CLKRDATA+6	;; restore the old vectors...	lda >OldWriteTime	sta >ToWriteTime	lda >OldWriteTime+2	sta >ToWriteTime+2	lda >OldReadTime	sta >ToReadTime	lda >OldReadTime+2	sta >ToReadTime+2	rtsMyDummyVector	clc	rtlMyDummyRtn	JML MyDummyVector;; Routine to call read time HEXCallReadHex	pha	; push on room for result	pha	pha	pha	_ReadTimeHex	pla	sta [theDate]	pla	ldy #2	sta [theDate],y	pla	iny	iny	sta [theDate],y	pla	iny	iny	and #$FF00	; make the null byte really zero!	sta [theDate],y	rts	; and end...;; Routine to call read time ASCIICallReadASCII	pei <theDate+2	; push the pointer to our output buffer	pei <theDate	_ReadASCIITime	rts	; and end...; routine to call write time HEXCallWriteHex	ldy #4	lda [theDate],y	pha	dey	dey	lda [theDate],y	cmp #$0400	; is the year less than 1904?	bge @YrOK	; nope, its OK	and #$00FF	ora #$0400@YrOK	pha	lda [theDate]	pha	_WriteTimeHex	rts		oldReadTime	ds.L 1OldWriteTime	ds.L 1SavedRData	ds.L 2	EndP	EJECT********************************************************************************* Description:	SysBeep2(beepType)** New call 17-Sep-90 DAL** Calls SendRequest to let anybody accepting requests decide what kind of sound* to make, if any.** If nobody accepts the request, then we do a regular SysBeep, or nothing,* depending on bit 15 of the beepType.** beepType:  bit 15: 1 = no sound if nobody accepts the request*                    0 = SysBeep if nobody accepts the request*            bit 14: 1 = do the beep on the next GetNextEvent*                    0 = do it now*            bits 13-0 = beep type** Inputs:	beepType (word)** Outputs:	None** NOTE--This is used by the TS2 *and* TS3 files, so don't put any ROM-specific*       stuff in this call!********************************************************************************SysBeep2	PROC EXPORTbeepType	equ 7	lda beepType,s	and #$4000	;the GetNextEvent flag	beq @doItNow	pea 0	_EMStatus	pla	beq @doItNow	lda >PendingSysBeep2	bne @toExit	;already have one pending, ignore	lda beepType,s	and #$BFFF	;mask out the GetNextEvent bit	sta >PendingSysBeep2@toExit	bra exit@doItNow*** added 18-Jul-92 DAL -- Tell screen dimmers to bring back the real screen	lda beepType,s	and #$3ff0	cmp #$0060	;006x = dim screen, undim screen	beq @noUndim	ldx #0	pea $000D	;srqForceUndim	phx	;sendToAll	phx	phx	;target=NIL	phx	phx	;dataIn=NIL	phx	phx	;dataOut=NIL	_SendRequest@noUndim*** end 18-Jul-92*** Before broadcasting request, send to Sound Control Panel	lda beepType,s	and #$3fff	pea 1	;systemSaysBeep	pea $8001	;stop after one, sendToName	pushlong #SoundCPName	ldx #0	phx	;dataIn high word (0)	pha	;dataIn low word (beepType)	phx	phx	;dataOut = 0	_SendRequest	bcc exit	lda beepType,s	and #$3fff	;added 16-Oct-90 DAL	pea 1	;systemSaysBeep	pea $8000	;How = stop after first acceptance	ldx #0	phx	phx	;Target=nil	phx	;Data In high word = 0	pha	;Data In low word = beepType	phx	phx	;nil OutPtr	_SendRequest	bcc exit	lda beepType,s	bmi exit	cmp #2	beq @two	cmp #3	bne @one@three	_SysBeep@two	_SysBeep@one	_SysBeepexit	ldx #0	;error code = 0	ldy #2	;get rid of 2 bytes	jml ToStripSoundCPName	dc.b 14,'Apple~SoundCP~'	EndP******************************************************************* NewSysBeep** The new sysbeep routine.  This routine calls the old sysbeep* routine if the volume is not set to zero and flashes the* border when it is	set to zero.** Inputs:  None* Outputs: CLC if we completely handled the necessary beeping* all registers preserved* Called in any native mode--mode preserved.******************************************************************OrigBellVector	proc Export	dc.L 0	ENDP	EXPORT NewSysBeepNewSysBeep	PROC	phx	; preserve <X> and <Y> & <A> inside this routine	phy	pha	php	; save m and x	sep #$30	; 8 bit mode	longa off	longi off	lda >IRQ_Volume	; look at the volume	and #$0F	beq ExitSEC	;the ROM can handle this already	lda >$e102c0+$5E	lsr a	bcs ExitSEC	;the ROM can handle this too (no special blink)	lda >IRQ_Volume	pha	lda #0	sta >IRQ_Volume	phb	pea $e1e1	plb	plb	phk	per @returnHere-1	pea $0083-1	;there's an RTL at $FF/0083	sep #$30	jml >$ff9a58	;ROM code will blink because volume=0@returnHere	plb	sep #$30	pla	sta >IRQ_Volume	sta >$e1c03cExitSEC	plp	; nonzero so set carry and get out	pla		ply	; restore <X> and <Y> & <A> here	plx	sec	rtl	longa on	longi on	ENDP********************************************************************************* VersionString** New call 5-Dec-90 DAL** Description:	$3903 VersionString(flags,Version/4,@Buffer)** flags = 0 (bits 15-0 reserved)** Version = 32 bits:**         _________________________________________________________________* bit 31  |M|M|M|M|M|M|M|M|m|m|m|m|b|b|b|b|s|s|s|0|0|0|0|0|r|r|r|r|r|r|r|r|  bit 0*         -----------------------------------------------------------------*                         |               |               |**           M = major version (2 digits, BCD)*           m = minor version*           b = bug version*           s = stage (001=development, 010=alpha, 011=beta, 100=final, 101=released)*           r = release (2 digits, BCD)** Buffer points to a 10-character buffer to receive a Pascal string:*   MM.m.bSrr********************************************************************************VersionString	proc exportoldD	equ 1rtl1	equ oldD+2rtl2	equ rtl1+3buffPtr	equ rtl2+3theVersion	equ buffPtr+4theFlags	equ theVersion+4	phd	tsc	tcd	lda #0	sta [buffPtr]	lda theVersion+3	;Major version byte	jsr DoVersByte	jsr AppendDot	lda theVersion+2	;minor version	jsr LSR4	jsr DoVersNibble	lda theVersion+2	;bug version	and #$000f	beq @noBug	jsr AppendDot	lda theVersion+2	jsr DoVersNibble@noBug	lda theVersion	cmp #$A000	;stage = 101	beq @released	lda theVersion+1	and #$001f	;reserved bits	beq @valid	lda #0	bra @WeirdStage@Valid	lda theVersion+1	and #$00e0	jsr LSR4	lsr a@WeirdStage	tax	lda >StageCharacters,x	jsr AppendChar	lda theVersion	jsr DoVersByte@released	pld	ldx #0	;error code = 0	ldy #10	;strip 10 bytes	jml ToStripStageCharacters	dc.b '?dabf???'	LSR4	lsr a	lsr a	lsr a	lsr a	rtsDoVersByte	pha	jsr LSR4	jsr AppendNotZero	plaDoVersNibble	and #$000f	ora #'0'	cmp #'9'+1	bcc AppendChar	lda #'?'	bra AppendCharAppendNotZero	and #$000f	bne DoVersNibble	rtsAppendDot	lda #'.'AppendChar	sep #$30	pha	lda [buffPtr]	inc a	sta [buffPtr]	tay	pla	sta [buffPtr],y	rep #$30	rts	EndP********************************************************************************* WaitUntil** New call 6-Jan-91 DAL** Description:	$3A03  WaitUntil(WaitFromTime,DelayTime) --> returns NewTime** WaitUntil is used for putting a maximum speed on repeated actions that the* user can see.  (For example, menu item blinking, blinking a control in response* to a keypress, continuous scrolling, and zoom-rect effects.)** Time specifies the time to wait *from*.  Zero means to wait from the* current time.  Other values should come from previous calls to WaitUntil.** DelayTime specifies how long to wait from WaitFromTime, in units of approximately* 1/16 of a tick.  Zero means to return right away, giving a valid NewTime value.** WaitUntil multiplies the delay time by BRAM location $60 minus 1, unless the* location is $00 or $FF (defaults for ROM 1 and ROM 3).  The wait maxxes out* at $F00 ticks (64 seconds) to avoid wrap-around problems.********************************************************************************WaitUntil	proc exportoldD	equ 1rtl1	equ oldD+2rtl2	equ rtl1+3DelayTime	equ rtl2+3WaitFromTime	equ DelayTime+2NewTime	equ WaitFromTime+2	phd	tsc	tcd* If interrupts are disabled, get out of here.	stz <NewTime	php	php	pla	and #4	;Interrupts disabled?	bne Exit* Multiply DelayTime based on battery-RAM location	pha	pea $60	_ReadBParam	pla	beq @noMultiply	cmp #$00ff	beq @noMultiply	pha	pha	;result space for _Multiply	dec a	;BRAM value - 1	pha	pei <DelayTime	_Multiply	pla	plx	bne @maxtime	cmp #$f000	bcc @storeTime@maxtime	lda #$f000	;don't get too big, or we'll delay by accident@storeTime	sta <DelayTime@noMultiply* If WaitFromTime is 0, use the current time.	lda <WaitFromTime	bne @haveFromTime	jsr GetTime	sta <WaitFromTime@haveFromTime@wait	jsr GetTime	tay	bne @1	inc a@1	sta <NewTime	;never return NewTime=0	sec	sbc <WaitFromTime	cmp <DelayTime	bcc @waitExit	pld	ldx #0	;error code = 0	ldy #4	;strip 4 bytes of input parameters	jml ToStrip** GetTime--return A = Now in 16ths of a tick** For now, we just use the tick count.  Can be improved later.*GetTime	pha	pha	_GetTick	pla	ply	asl a	asl a	asl a	asl a	rts	EndP********************************************************************************* $3B03 StringToText -- new call 4-Mar-91 DAL** Inputs:  WORD  space for result flags*          WORD  space for result length*          WORD  input flags*          LONG  pointer to input text*          WORD  length of input text*          LONG  pointer to result buffer (GS/OS result buffer)** The output buffer is a GS/OS result buffer:*   +000: buffer size (including the header fields)*   +002: data length*   +004: the actual data (up to buffer-size minus 4 bytes)** The Flags input word:*   bit 15: allow mousetext in result*   bit 14: allow multi-character substitutions into result*   bit 13: force language number (bits 2..0)*   bit 12: translate weird characters to self instead of to null*   bits 11-3: reserved (must be 0)*   bits 2-0: language number*      0=USA, 1=UK, 2=French, 3=Danish, 4=Spanish, 5=Italian,*      6=German, 7=Swedish (just like bits 7-5 of $C02B)** The ResultFlags word:*   bit 15: 1=changes were made to the string, 0=no changes*   bits 14-0: reserved (ignore)********************************************************************************StringToText	proc export	phb	phk	plb	phd	pha	pha	;space for @out	pha	;space for @spaceLeft	pha	;space for @language	lda #0	pha	pha	;space/value for @sourceHandle	tsc	tcd@sourceHandle	equ 1@language	equ @sourceHandle+4@spaceLeft	equ @language+2@out	equ @spaceLeft+2@oldB	equ @out+4@oldD	equ @oldB+1@rtl	equ @oldD+2@OutBuff	equ @rtl+6@inputLen	equ @OutBuff+4@input	equ @inputLen+2@flags	equ @input+4@PrintLength	equ @flags+2@ResultFlags	equ @PrintLength+2	;added 15-Apr-91 DAL	stz @PrintLength	;start with printable length = 0	stz @ResultFlags*** If source is inside output buffer, put it somewhere safe	sec	lda <@input	sbc <@outBuff	tax	lda <@input+2	sbc <@outBuff+2	bcc @alreadySafe	;input<outbuff -- no overlap	bne @alreadySafe	;input-outbuff > 64K -- no overlap	txa	cmp [@outBuff]	;input-outbuff > buffsize -- no overlap	bcs @alreadySafe	pha	pha	;space for NewHandle result	pea 0	pei <@inputLen	;size needed	pea $4003	;memory ID	pea $8000	;attributes (locked)	pha	pha	_NewHandle	tax	ply	pla	bcc @nhOK	brl @exit@nhOK	sta <@sourceHandle+2	sty <@sourceHandle	pei <@input+2	pei <@input	pha	;AY is still <@sourceHandle	phy	pea 0	pei <@inputLen	_PtrToHand	ldy #2	lda [<@sourceHandle],y	sta <@input+2	lda [<@sourceHandle]	sta <@input@alreadySafe	lda [@OutBuff]	sec	sbc #4	sta @spaceLeft	bcc @tooSmall*** Zero out the data size word in the result buffer	ldy #2	lda #0	sta [@outBuff],y*** start by assuming the language we want is what the character generator*** is already using (bits 7-5 of LANGSEL, $C02B)	lda >$E0C02B	and #$00E0	lsr a	lsr a	lsr a	lsr a	lsr a	sta <@language*** Check for pass-through flag	lda <@flags	and #$1000	sta passThruFlag	trb <@flags	;clear bit 12 in <@flags	lda <@flags	and #$2000	;bit 13 forces language number	beq @noForceLang	lda <@flags	and #7	sta <@language@noForceLang*** clear all the unwanted flag bits	lda #$3FFF	trb <@flags*** @out = @OutBuff+4 (point to first result byte in the buffer)	ldx <@OutBuff+2	lda <@OutBuff	clc	adc #4	sta <@out	bcc @1	inx@1	stx <@out+2	lda <@inputLen	beq @storeLengthNoErr@CharLoop	lda [<@input]	and #$00ff	jsr @EmitTranslation	bcs @tooSmall	inc <@input	bne @2	inc <@input+2@2	dec <@inputLen	bne @CharLoop@storeLengthNoErr	ldx #0	bra @storeLength@tooSmall	ldx #$034F@storeLength	sec	;error in X	lda @out	sbc @outBuff	sec	sbc #4	ldy #2	sta [<@outBuff],y@exit*** kill sourceHandle if we allocated one	phx	lda <@sourceHandle+1	beq @noSourceHandle	pei <@sourceHandle+2	pei <@sourceHandle	_DisposeHandle@noSourceHandle	plx	pla	pla	;removed @sourceHandle	pla	;removed @language	pla	;removed @spaceLeft	pla	pla	;removed @out	pld	;error in X	plb	ldy #12	;strip 12 bytes of input parameters	jml $e10184	;ToStrip********************************************************************************* EmitCharacter** Input: Character in A** Output: Decrements @spaceLeft, increments @Out********************************************************************************@EmitCharacter	sec	ldx @spaceLeft	beq @full	dec @spaceLeft	sep #$20	sta [@Out]	rep #$20	inc @Out	bne @ok	inc @Out+2@ok	cmp #$0020	;printable character?	bcc @noPrint	inc @PrintLength@noPrint	clc@full	rts********************************************************************************* EmitTranslation -- translate a single character** Inputs: A = character to translate*         @Language = language number*         @Flags: bit 15 = allow mousetext, 14 = allow expansion** Updates: @Out, @spaceLeft, @PrintLength** Output: Returns SEC if the output buffer is full********************************************************************************@EmitTranslation*** Before we dive into the big table, let's weed out big ranges.*** If bit 7 is on or it's one of the characters that gets remapped*** across display languages or it's a control character, go for the*** table.  Otherwise emit it as-is, as a printable character.	cmp #$007b	bcs @useTable	cmp #$0061	bcs @EmitCharacter	cmp #$005B	bcs @useTable	cmp #$0041	bcs @EmitCharacter	cmp #$0023	beq @useTable	cmp #$0040	beq @useTable	cmp #$20	bcs @EmitCharacter;fall into @useTable********************************************************************************* @useTable -- emit the translation for the character in A********************************************************************************@useTable	sep #$20	;16-Jan-92 DAL	sta XlateTable	rep #$20	;16-Jan-92 DAL	ldx #XlateEnd-XlateTable@resumeSearch	lda XlateTable@search	dex	dex	dex	dex	dex	sep #$20	cmp XlateTable,x	rep #$20	bne @search*** If there are bits set in the translation flags that aren't in the caller's*** flags, then this translation is no good, keep looking (mousetext or expansion)	lda @flags	eor #$C000	;top 2 bits	and XlateTable+1,x	;16-Jan-92 DAL	bne @resumeSearch*** If this translation is for a particular language, make sure it's the one we need	lda XlateTable+1,x	;16-Jan-92 DAL	and #$2000	;one language?	beq @match	lda XlateTable+1,x	;16-Jan-92 DAL	and #7	cmp @language	bne @resumeSearch@match	lda XlateTable+3,x	;translation	;16-Jan-92 DAL	beq @null	inc a	beq @default	dec a	tax*** Set the Changed result-flag bit if it's changing	lda XlateTable	and #$00ff	;16-Jan-92 DAL	xba	inc a	;A = $cc01	cmp |0,x	beq @noChange	;substitution string exactly matches input character!	lda #$8000	tsb <@ResultFlags@noChange	lda |0,x	and #$00ff	tay	;number of characters in translation@emitMultiple	inx	lda |0,x	and #$00ff	phx	jsr @EmitCharacter	plx	bcs @oopsFull	dey	bne @emitMultiple	clc@oopsFull	rts@null*** If passThruFlag is set, emit the character	lda passThruFlag	beq @oldWay	lda XlateTable	and #$00ff	brl @EmitCharacter@oldWay	lda #$8000	;15-Apr-91 DAL	tsb <@resultFlags	clc	rts** @default -- character not in table, so emit it if it's printable*@default	lda XlateTable	;get the character back	and #$00ff	cmp #$0080	bcs @null	cmp #$0020	bcc @null	brl @EmitCharacter********************************************************************************* XlateTable** 5 bytes per translation entry:*   +000: source character (byte)*   +001: flags (15=MouseText, 14=expands, 13=one language only)*   +003: pointer to replacement string (0=replace with null string, $FFFF=not found)** Note that the table is searched from end to beginning, so higher-precedence* translations must come later in the table.********************************************************************************	macro	trans &char,&flags,&ptr	dc.b &char	dc.w &flags,&ptr	mendXlateTable	trans $77,$0000,$FFFF	;character, flags, replace*** generic foreign characters and other*** last-resort things (must be searched after foreign language stuff)	trans $7F,$0000,$0000	;kill DELs	trans $80,$0000,aBigA	;umlat A	trans $81,$0000,aBigA	;angstrom A	trans $82,$0000,aBigC	;cedilla C	trans $83,$0000,aBigE	;accent E	trans $84,$0000,aBigN	;tilde N	trans $85,$0000,aBigO	;umlat O	trans $86,$0000,aBigU	;umlat U	trans $87,$0000,aSmallA	;accent a	trans $88,$0000,aSmallA	;grave a	trans $89,$0000,aSmallA	;hat a	trans $8A,$0000,aSmallA	;umlat a	trans $8B,$0000,aSmallA	;tilde a	trans $8C,$0000,aSmallA	;angstrom a	trans $8D,$0000,asmallC	;cedilla c	trans $8E,$0000,aSmallE	;accent e	trans $8F,$0000,aSmallE	;grave e	trans $90,$0000,aSmallE	;hat e	trans $91,$0000,aSmallE	;umlat e	trans $92,$0000,aSmalli	;accent i	trans $93,$0000,aSmalli	;grave i	trans $94,$0000,aSmalli	;hat i	trans $95,$0000,aSmalli	;umlat i	trans $96,$0000,aSmallN	;tilde n	trans $97,$0000,aSmallO	;accent o	trans $98,$0000,aSmallO	;grave o	trans $99,$0000,aSmallO	;hat o	trans $9A,$0000,aSmallO	;umlat o	trans $9B,$0000,aSmallO	;tilde o	trans $9C,$0000,aSmallU	;accent u	trans $9D,$0000,aSmallU	;grave u	trans $9E,$0000,aSmallU	;hat u	trans $9F,$0000,aSmallU	;umlat u	trans $A7,$4000,aSmallSS	;german "§" --> "ss" (21-Jan-92 DAL)	trans $AE,$4000,aBigAE	;AE	trans $AF,$0000,aZero	;big PHI	trans $BE,$4000,aSmallAE	;ae	trans $BF,$0000,aZero	;small PHI	trans $C0,$0000,aQuestion	;"À"	trans $C1,$0000,aBang	;"Á"	trans $C9,$4000,anEllipsis	;"É"	trans $CB,$0000,aBigA	;grave A	trans $CC,$0000,aBigA	;tilde A	trans $CD,$0000,aBigO	;tilde O	trans $CE,$4000,aBigOE	;OE	trans $CF,$4000,aSmallOE	;oe	trans $D8,$0000,aSmallY	;umlat y*** Translate unclaimed #, @, [, backsl, ], {, |, }, ~ (but not grave accent)	trans $23,$0000,$0000	trans $40,$0000,$0000	trans $5B,$0000,aLeftParen	trans $5C,$0000,$0000	trans $5D,$0000,aRightParen	trans $7B,$0000,aLeftParen	trans $7C,$0000,$0000	trans $7D,$0000,aRightParen	trans $7E,$0000,$0000*** Keep grave accent unless it's stolen by a foreign language	trans $60,$0000,aGraveAccent*** English--keep special characters #, @, [, backsl, ], `, {, |, }, ~	trans $23,$2000,aPoundSign	trans $40,$2000,anAtSign	trans $5B,$2000,aLeftBracket	trans $5C,$2000,aBackslash	trans $5D,$2000,aRightBracket	trans $7B,$2000,aLeftBrace	trans $7C,$2000,aVertBar	trans $7D,$2000,aRightBrace	trans $7E,$2000,aTilde*** U.K. English	trans $A3,$2001,aPoundSign	;£	trans $40,$2001,anAtSign	trans $5B,$2001,aLeftBracket	trans $5C,$2001,aBackslash	trans $5D,$2001,aRightBracket	trans $7B,$2001,aLeftBrace	trans $7C,$2001,aVertBar	trans $7D,$2001,aRightBrace	trans $7E,$2001,aTilde*** French	trans $A3,$2002,aPoundSign	;£	trans $88,$2002,anAtSign	;grave a	trans $A1,$2002,aLeftBracket	;degree symbol	trans $8D,$2002,aBackslash	;cedilla c	trans $A4,$2002,aRightBracket	;paragraph symbol	trans $8E,$2002,aLeftBrace	;accent e	trans $9D,$2002,aVertBar	;grave u	trans $8F,$2002,aRightBrace	;grave e	trans $AC,$2002,aTilde	;umlat*** Danish	trans $23,$2003,aPoundSign	trans $40,$2003,anAtSign	trans $AE,$2003,aLeftBracket	;AE	trans $AF,$2003,aBackslash	;big PHI	trans $81,$2003,aRightBracket	;angstrom A	trans $BE,$2003,aLeftBrace	;ae	trans $BF,$2003,aVertBar	;small PHI	trans $8C,$2003,aRightBrace	;angstrom a	trans $7E,$2003,aTilde*** Spanish	trans $A3,$2004,aPoundSign	;£	trans $A4,$2004,anAtSign	;paragraph	trans $C1,$2004,aLeftBracket	;upside-down bang	trans $84,$2004,aBackslash	;tilde N	trans $C0,$2004,aRightBracket	;upside-down question	trans $A1,$2004,aLeftBrace	;degree symbol	trans $96,$2004,aVertBar	;tilde n	trans $8D,$2004,aRightBrace	;cedilla c	trans $7E,$2004,aTilde*** Italian	trans $A3,$2005,aPoundSign	;£	trans $A4,$2005,anAtSign	;paragraph	trans $A1,$2005,aLeftBracket	;degree symbol	trans $8D,$2005,aBackslash	;cedilla c	trans $8E,$2005,aRightBracket	;accent e	trans $9D,$2005,aGraveAccent	;grave u	trans $88,$2005,aLeftBrace	;grave a	trans $8F,$2005,aVertBar	;grave e	trans $98,$2005,aRightBrace	;grave o	trans $93,$2005,aTilde	;grave i	trans $60,$2005,aSingleQuote	;grave accent --> quote*** German	trans $23,$2006,aPoundSign	trans $A4,$2006,anAtSign	;paragraph	trans $80,$2006,aLeftBracket	;umlat A	trans $85,$2006,aBackslash	;umlat O	trans $86,$2006,aRightBracket	;umlat U	trans $8A,$2006,aLeftBrace	;umlat a	trans $9A,$2006,aVertBar	;umlat o	trans $9F,$2006,aRightBrace	;umlat u	trans $A7,$2006,aTilde	;"B"*** Swedish	trans $23,$2007,aPoundSign	trans $40,$2007,anAtSign	trans $80,$2007,aLeftBracket	;umlat A	trans $85,$2007,aBackslash	;umlat O	trans $81,$2007,aRightBracket	;angstrom A	trans $8A,$2007,aLeftBrace	;umlat a	trans $9A,$2007,aVertBar	;umlat o	trans $8C,$2007,aRightBrace	;angstrom a	trans $7E,$2007,aTilde*** MouseText translations	trans $11,$8000,mtOpenApple	;hollow Apple	trans $12,$8000,mtCheckMark	;check mark	trans $13,$8000,mtDiamont	;solid diamond	trans $14,$8000,mtSolidApple	;solid Apple	trans $7F,$8000,mtCheckerboard	;DEL --> checkerboard	trans $C9,$8000,mtEllipsis	;ellipsis	trans $D7,$8000,mtDiamond	;hollow diamond*** Generic typographical things	trans $A5,$0000,aBullet	;¥	trans $A8,$4000,aRegistered	;¨	trans $A9,$4000,aCopyright	;©	trans $AA,$4000,aTrademark	trans $AB,$0000,aSingleQuote	;forward-slant apostrophe	trans $AD,$4000,aNotEqual	;­	trans $B1,$4000,aPlusMinus	;±	trans $B2,$4000,aLessEqual	;²	trans $B3,$4000,aGreatEqual	;³	trans $B5,$0000,aSmallU	;micro	trans $C4,$0000,aSmallF	;Ä	trans $C7,$4000,aLessLess	;<<	trans $C8,$4000,aGreatGreat	;>>	trans $CA,$0000,aBlank	trans $D0,$0000,aHyphen	;Ð	trans $D1,$0000,aHyphen	;if lengthening not allowed	trans $D1,$4000,aDash	;Ñ	trans $D2,$0000,aDoubleQuote	;Ò	trans $D3,$0000,aDoubleQuote	;Ó	trans $D4,$0000,aSingleQuote	;Ô	trans $D5,$0000,aSingleQuote	;Õ*** Things added at Yvan Koenig's request (characters above $D8 are a mystery to me)	trans $A2,$0000,aSmallC	;cent	trans $B4,$0000,aBigY	;Yen	trans $BB,$0000,aSmallA	;ordFeminine	trans $BC,$0000,aSmallO	;ordMasculine	trans $BD,$0000,aBigO	;Omega	trans $D9,$0000,aBigY	;Y dieresis	trans $DA,$0000,aSlash	;Fraction	trans $DB,$0000,aSmallO	;currency	trans $DC,$0000,aSmaller	;guillsingleLeft	trans $DD,$0000,aGreater	;guillsingleRight	trans $DE,$4000,aFI		;fi	trans $DF,$4000,aFL		;fl	trans $E1,$0000,aPeriod	;periodCentered	trans $E2,$0000,aComma	;quoteSingleBase	trans $E3,$4000,aCommaPair	;quoteDblBase	trans $E5,$0000,aBigA	;Acircumflex	trans $E6,$0000,aBigE	;Ecircumflex	trans $E7,$0000,aBigA	;Aacute	trans $E8,$0000,aBigE	;Ecircumflex	trans $E9,$0000,aBigE	;Egrave	trans $EA,$0000,aBigI	;Iacute	trans $EB,$0000,aBigI	;Icircumflex	trans $EC,$0000,aBigI	;Idieresis	trans $ED,$0000,aBigI	;Igrave	trans $EE,$0000,aBigO	;Oacute	trans $EF,$0000,aBigO	;Ocircumflex	trans $F0,$8000,mtSolidApple	trans $F1,$0000,aBigO	;Ograve	trans $F2,$0000,aBigU	;Uacute	trans $F3,$0000,aBigU	;Ucircumflex	trans $F4,$0000,aBigU	;Ugrave	trans $F5,$0000,aSmallI	;dotless iXlateEnd*** new entries 16-Jan-92 DALaUpperI	dc.b 1,'I'aCommaPair	dc.b 2,',,'aComma	dc.b 1,','aPeriod	dc.b 1,'.'aFL	dc.b 2,'fl'aFI	dc.b 2,'fi'aGreater	dc.b 1,'>'aSmaller	dc.b 1,'<'aSlash	dc.b 1,'/'aBigY	dc.b 1,'Y'aBigI	dc.b 1,'I'*** end 16-Jan-92aPoundSign	dc.b 1,'#'anAtSign	dc.b 1,'@'aLeftBracket	dc.b 1,'['aBackslash	dc.b 1,'\'aRightBracket	dc.b 1,']'aGraveAccent	dc.b 1,'`'aLeftBrace	dc.b 1,'{'aVertBar	dc.b 1,'|'aRightBrace	dc.b 1,'}'aTilde	dc.b 1,'~'aLeftParen	dc.b 1,'('aRightParen	dc.b 1,')'aBlank	dc.b 1,' 'aHyphen	dc.b 1,'-'aDash	dc.b 2,'--'aDoubleQuote	dc.b 1,$22aSingleQuote	dc.b 1,$27aQuestion	dc.b 1,'?'aBang	dc.b 1,'!'aSmallA	dc.b 1,'a'aSmallC	dc.b 1,'c'aSmallE	dc.b 1,'e'aSmallF	dc.b 1,'f'aSmalli	dc.b 1,'i'aSmallN	dc.b 1,'n'aSmallO	dc.b 1,'o'aSmallU	dc.b 1,'u'aSmallY	dc.b 1,'y'aBigA	dc.b 1,'A';;;aBigB	dc.b 1,'B'aSmallSS	dc.b 2,'ss'	;16-Jan-92 DALaBigC	dc.b 1,'C'aBigE	dc.b 1,'E'aBigN	dc.b 1,'N'aBigO	dc.b 1,'O'aBigU	dc.b 1,'U'aSmallAE	dc.b 2,'ae'aBigAE	dc.b 2,'AE'aSmallOE	dc.b 2,'oe'aBigOE	dc.b 2,'OE'anEllipsis	dc.b 3,'...'aLessLess	dc.b 2,'<<'aGreatGreat	dc.b 2,'>>'aPlusMinus	dc.b 2,'+-'aLessEqual	dc.b 2,'<='aGreatEqual	dc.b 2,'>='aBullet	dc.b 1,'*'aRegistered	dc.b 3,'(R)'aCopyright	dc.b 3,'(C)'aTrademark	dc.b 4,'(TM)'aNotEqual	dc.b 2,'<>'aZero	dc.b 1,'0'mtOpenApple	dc.b 3,15,$41,14	;hollow ApplemtCheckMark	dc.b 3,15,$44,14	;check mark (normal)mtDiamont	dc.b 3,15,$5B,14	;solid diamondmtSolidApple	dc.b 3,15,$40,14	;solid ApplemtCheckerboard	dc.b 3,15,$56,14	;DEL --> checkerboardmtEllipsis	dc.b 3,15,$49,14	;ellipsismtDiamond	dc.b 3,15,$5B,14	;hollow diamondpassThruFlag	dc.w 0	;16-Jan-92 DAL	EndP********************************************************************************GetROMResource	PROC EXPORT** Description:	This call will return a 'handle' to the data requested by the*	ROM routine. This will either be a fake handle that exists*	only in ROM, or a real resource loaded from disk. The tool*	should not treat this resouce any different from a handle, *	except that it is always to be treated as read only. The *	parameters of this call are identical to those of the*	real resource manager. Please refer to then for further *	details.*** Inputs:	On Stack*	|  previous contents  |*	+---------------------+*	|                     |*	+--    LongSpace    --+ LONG Room for result*	|                     |*	+---------------------+*	|   resource type     | WORD Type of resource to find*	+---------------------+*	|                     |*	+--   resource ID   --+ LONG ID of resource to load*	|                     |*	+---------------------+*	|  	  | <- SP**	** Outputs:	On Stack*	|  previous contents  |*	+---------------------+*	|                     |*	+--   Data Handle   --+ LONG Handle to data storage*	|                     |*	+---------------------+*	|  	  | <- SP*** Errors:	Memory manager errors*	$0310   Requested data does not exist*	        This can only happen if a ROM version of the data*	        does not already exist.** External Refs:** Entry Points:********************************************************************************** Patched for ROM 3 16-Feb-91 DAL so I can replace the Font Manager resources* but keep using the other ones from ROM.********************************************************************************	import w320start,w640start  ;from ChooseFontStuff in misc tools ROMDataMgr;; Equates for use with our stack frame...SaveDPage	equ 1RetAddr1	equ SaveDPage+2RetAddr2	equ RetAddr1+3resID	equ RetAddr2+3ResType	equ ResID+4result	equ resType+2	phd	; save the current dpage	tsc	; get the stack pointer	tcd	; and make it the direct page...		stz <result	; first zero out the result	stz <result+2	;; Since this tool is going to work with the resource manager, we will first ; test to see if the resource manager is running with the status call	pea $0000	; room for result	_ResourceStatus	pla	beq UseROMData	; if this is false, use the ROM data	;; If the resource manager is running, try to load the resource that we want.	pha	; room for result	pha	lda <ResType	; type of resource to load	pha	lda <ResID+2	; ID of resource to load	pha	lda <ResID	pha	_Loadresource	;attempt to load the resource from the file	pla	; get the result for a second...	plx	bcs UseROMData	; if an error occured, us the ROM resource;; If we get this far then we have loaded the resource from the resource file,; and we should just return its handle to the caller...	sta <result	; store the result in result	stx <result+2	ldy #0	; error code ...	brl GRRDone	; and end the call	;UseROMData; This routine will be called when the apropriate resource is not available, it will; look thru the ROM data tables and pick out the proper handle from the list. If it; can not find a proper resource in the list, it will simply bomb with a data not; found error	ldx #0	; init our counterFindLoop	lda >TypeList,x	; load in the first type	cmp <resType	; does it match our desired id?	bne tryNext	; if not, try the next one	lda >IDList,x	; next try the ID list	cmp <ResID	; see if the ID matches	bne tryNext	; if not try the next one	lda >IDList+2,x	; now the high byte of the ID	cmp <ResID+2	bne tryNext	bra FoundROMData	; if all tests match, then we found the ROM datatryNext	lda >TypeList,x	; test to see if we are at the end of the list	ora >IDList,x	; by finding 0's in the type and ID field	ora >IDList+2,x	beq NoROMData	; if this is zero, then there is no ROM data	txa	; bump our counter	clc	adc #SizeofEntry	; by the size of each entry	tax	; and try the next one...	bra FindLoop	NoROMData;; This routine places an error into Y and ends	ldy #$0310	; data not found error	brl GRRDone	FoundROMData;; This routine sets up the proper result and returns it to the caller.	txa	; put table offset into <A>	clc	; and create a pointer to our pointer	adc #HandleTbl	sta <Result	lda #0	adc #HandleTbl>>16	sta <Result+2	ldy #0;	GRRDone; This routine moves the return address on the stack and then tests <Y> for an; error code, and returns.	jml >$fdd898	;back into ROM;	lda <RetAddr1	; move the return address;	sta <ResID;	lda <RetAddr1+2;	sta <ResID+2;	lda <RetAddr1+4;	sta <ResID+4;	;	pld	; recover the direct page;	plx	; remove 6 bytes of data;	plx;	plx;	;	tya	; put the return address into <A>;	cmp #1	; set the carry;	rtl	; and leaveSizeofEntry 	equ 10TypeList	dc.W $FFFF	; first resource is a sample...IDList	dc.L 1	; please don't remove...HandleTbl	dc.L HandleTbl	; sampleData; Entry for Font Manager ChooseFont templates here!	dc.W $800E	; resource Type	dc.L $0FFF1B01	; font manager window #1	dc.L w320Start	; from misc tools ROMDataMgr ChooseFontStuff		dc.W $800E	; res type	dc.L $0FFF1B02	; font manager window #2	dc.L w640Start	; from misc tools ROMDataMgr ChooseFontStuff	; Entry for Event manager; Default ID is now $FF instead of $01	dc.W $8021	; res Type Ktrans table	dc.L $0FFF06FF	; ID Number	dc.L $00FDD6BB	; default ktrans table in ROM 3;; END OF ID TABLE: DO NOT MODIFY THIS NEXT RECORD	dc.W $0000	dc.L $00000000	dc.L $00000000	EndP************************************************************************ ScanDevices -- new call 29-Mar-91 DAL** Inputs:*   WORD  space for result** Outputs:*   WORD  device number of insertion (zero if none)***********************************************************************ScanDevices	proc exportDO_INSERT_SCAN	equ $01FCDC	sep #$20	longa off	lda >$e0c068	pha	lda >$e0c08b	lda >$e0c08b*** Removed 20-Aug-92 DAL -- not needed;;;	ldx #0	;anticipate OS vector missing;;;	lda >DO_INSERT_SCAN;;;	cmp #$5c;;;	bne @notThere	rep #$20	longa on	jsl DO_INSERT_SCAN	;do_insert_scan	tax@notThere	sep #$20	pla	sta >$e0c068	rep #$20	txa	sta 7,s	lda #0	clc	rtl	EndP************************************************************************ AlertMessage -- new call 20-Aug-92 DAL for 6.0.1** Inputs:*   WORD  space for result*   LONG  pointer to message table (see below)*   WORD  message number (0=first)*   LONG  pointer to substitution table (Pascal strings)** Behavior:*   If GS/OS is not present, return error $0377.*   Call s_toolbox_msg vector in GS/OS.** The message table goes like this:*    dc.w messageZeroText-*,messageZeroGraphics-**    dc.w messageOneText-*,messageOneGraphics-**    ...** Each message is an AlertWindow string plus three characters to* map the buttons into return values.  (The characters should be* '0' to '9', indicating what values to return when the first,* second, and third buttons are chosen.)** Both string offsets can point to the same string if you want, but* the text version does not do word wrapping for you.** The text version does *0..*9 and "^" for default button, but* it does not do the "#" CompileText substitutions like AlertWindow.***********************************************************************AlertMessage	proc exportIncBusy	equ $e10064sys_prefs	equ $00b9f6	;GS/OS system preferencess_toolbox_msg	equ $01fce0	phd	tsc	tcd@oldD	equ 1@rtl	equ @oldD+2@substitutions	equ @rtl+6@msg_number	equ @substitutions+4@table	equ @msg_number+2@result	equ @table+4	jsl IncBusy	lda >sys_prefs	pha	and #$dfff	;don't supress messages!	sta >sys_prefs	lda #$ffff	sta <@result	ldx #$0377	;anticipate no-GS/OS error	lda >OS_Kind	;$00=P8, $01 = GS/OS)	and #$00ff	beq @error	sep #$20	longa off	lda >$e0c068	pha	lda >$e0c08b	lda >$e0c08b	rep #$20	longa on	pei <@msg_number	pei <@substitutions+2	pei <@substitutions	ldx <@table	;set up YX = pointer to error msg table	ldy <@table+2	jsl s_toolbox_msg	sta <@result	sep #$20	pla	sta >$e0c068	rep #$20@exit	ldx #0	;error code@error	pla	sta >sys_prefs	pld	ldy #10	;bytes to strip	jml $e10180	;ToBusyStrip	EndP************************************************************************ DoSysPrefs -- new call 20-Aug-92 DAL for 6.0.1** Inputs:*    WORD  space for result*    WORD  bits to clear*    WORD  bits to set** Behavior:*   Clears the specified GS/OS SysPrefs bits.*   Sets the specified GS/OS SysPrefs bits.*   Returns the new SysPrefs word.***********************************************************************DoSysPrefs	proc exportsys_prefs	equ $00b9f6	;GS/OS system preferences@rtl	equ 1@bitsToSet	equ @rtl+6@bitsToClear	equ @bitsToSet+2@result	equ @bitsToClear+2*** added 22-Oct-92 DAL -- return error $0301 under ProDOS 8	ldx #$0301	;anticipate error	lda >$e100bc	and #$00ff	beq @error*** end 22-Oct-92	lda >sys_prefs	sta @result,s	;1-Oct-92 DAL	lda @bitsToClear,s	eor #$ffff	and >sys_prefs	ora @bitsToSet,s	sta >sys_prefs	ldx #0@error	ldy #4	jml $e10184	;ToStrip	EndP************************************************************************ ShowBootInfo -- new call 29-Mar-91 DAL for 6.0** Inputs:*    LONG  Pascal string pointer or NIL*            (Set bit 31 of string pointer to reinitialize ShowBootInfo)*    LONG  Icon pointer (DrawIcon style) or NIL*            (Set bit 31 of icon pointer to re-use previous location)*** The text-based splash screen has lines in this format:*    "System Dispatch Table v04.00d4"*    "ProDOS FST            v04.00"*    (22 characters before the version)** The input string should be in this format.** Icon format:*   +000: iconType*   +002: icon size*   +004: icon height*   +006: icon width (in 4-bit pixels)***********************************************************************ShowBootInfo	proc export;;;PlasterIconsHere	equ 174*160+$E12000BottomRow	equ 174*160+$2000RowDecrement	equ 26*160TheScreen	equ $e12000FirstIconPosition	equ 2	;horizontal byte offset	phd	pha	pha	;space for @screen	pha	pha	;space for @mask	pha	pha	;space for @ptr	tsc	tcd@ptr	equ 1@mask	equ @ptr+4@screen	equ @mask+4@oldD	equ @screen+4@rtl	equ @oldD+2@icon	equ @rtl+6@string	equ @icon+4*** bit 31 of stringPtr = initialize self!	lda <@string+2	bpl @notInit	lda #$ffff	sta >FirstTextLine	lda #FirstIconPosition	sta >IconXPosition	lda #BottomRow	sta >PlasterIconsHere@notInit*** If QuickDraw is active, don't do anything (in something gets initted at*** other than boot time!)	pea 0	_QDStatus	pla	bne @exit	lda >$e0c029	and #$0080	bne @doTheIcon@doTheString	lda <@string+1	beq @noString	lda >FirstTextLine	bpl @notFirstTime	lda #0	sta >FirstTextLine	ldx #$fd8e	;CROUT	jsr call_fw@notFirstTime	ldy #0	;start at first byte to display@charloop	lda [<@string],y	;pick up a character to display	and #$00ff	beq @done	;$00 is terminator	ora #$0080	;set high bit in case someone forgot!!!	phy	;save Y	jsr call_cout	;output the character	ply	;restore Y	iny	;next character please	bra @charloop	;fall out@done	ldx #$fd8e	;CROUT	jsr call_fw@noString	bra @exit@doTheIcon	lda <@icon+1	beq @noIcon	jsl @DrawTheIcon@noIcon@exit	pla	pla	;pulled @ptr	pla	pla	;pulled @mask	pla	pla	;pulled @screen	pld	ldx #0	ldy #8	jml $e10184	;ToStrip@DrawTheIcon*** If bit 1 of BRAM $5F is set, skip drawing the icon@verifyBRAM	pha	pea $5f	_ReadBParam	pla	tax	and #%11000000	cmp #%10000000	beq @okay	pea $81	;Initialize toolbox location to default value ($81)	pea $5F	_WriteBParam	bra @continueIcon@okay	txa	and #$0002	;bit 1 = disable icon drawing	beq @continueIcon	rtl@continueIcon*** If bit 31 is set, re-use the previous icon position	lda <@icon+2	bpl @nextPosition	lda >oldIconXPosition	sta >IconXPosition@nextPosition	clc	lda <@icon	adc #8	sta <@ptr	lda <@icon+2	adc #0	sta <@ptr+2	ldy #2	;offset to icon size	lda <@ptr	adc [<@icon],y	sta <@mask	lda @ptr+2	adc #0	sta <@mask+2	ldy #6	lda [<@icon],y	;got the width (must be even)	lsr a	;width in bytes	adc >IconXPosition	cmp #160	bcc @ok	jsr BeginNewRow	lda #FirstIconPosition	sta >IconXPosition@ok	lda #^TheScreen	;12-Mar-92 DAL	sta <@screen+2	lda >PlasterIconsHere  ;12-Mar-92 DAL	clc	adc >IconXPosition	sta <@screen	ldy #4	lda [<@icon],y	;got height@doOneLine	pha	ldy #6	lda [<@icon],y	lsr a	tax	;byte count	ldy #0	sep #$30@doOneByte	lda [<@ptr],y	eor [<@screen],y	and [@mask],y	eor [<@screen],y	sta [<@screen],y	iny	dex	bne @doOneByte	rep #$30*** advance to next row	ldy #6	lda [<@icon],y	;width (pixels)	lsr a	tax	adc <@ptr	sta <@ptr	bcc @1	inc <@ptr+2@1	txa	clc	adc <@mask	sta <@mask	bcc @2	inc <@mask+2@2	clc	lda <@screen	adc #160	sta <@screen	tax	;6-May-91 DAL	pla	;row counter*** See if we hit the bottom of the screen yet	cpx #$9d00	bcs @hitBottom	dec a	bne @doOneLine@hitBottom	*** Keep previous icon position for later	lda >IconXPosition	sta >oldIconXPosition	clc	ldy #6	lda [<@icon],y	;width (pixels)	lsr a	adc >IconXPosition	adc #2	sta >IconXPosition	rtlIconXPosition	dc.w FirstIconPositionoldIconXPosition	dc.w FirstIconPosition   ;added 20-May-91 DALFirstTextLine	dc.w $ffffPlasterIconsHere	dc.w BottomRow;; BeginNewRow;BeginNewRow	lda >PlasterIconsHere	sec	sbc #RowDecrement	cmp #$20a0	;off the top?	bcs @okay	lda #BottomRow@okay	sta >PlasterIconsHere	rtscall_cout	ldx #$fdedcall_fw	pha	;push space for result	pha	pha	pha	pha	;push A	phx	;push X	phy	;push Y	phx	;address of routine to call	_FWEntry	pla	;ignore results	pla	pla	pla	rts	EndP	END