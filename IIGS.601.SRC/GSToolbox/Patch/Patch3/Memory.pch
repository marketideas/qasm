******************************************************************************** Memory.pch** (C)  Copyright Apple Computer, Inc. 1989,1991-1992* All rights reserved.** by Jim Mensch* 11/13/89** This file contains patches to the memory manager for ROM 3*** Modification History:** Version 1.0	mensch** 11/13/89	Mensch*	First patch in file for disposehandle, This should fix the* 	memory hinting problem when you dispose a ungroovy handle** 22-Jan-91	Dave Lyons** Add new SetHandleID call (see MM:MM.asm for info and code).* Version $8302.** 12-Jun-91	Dave Lyons** Added check to DisposeHandle to see if we're disposing of the very first* handle.  This now returns error $0206, badHandle, instead of frying the* handle chain.** 14-Sep-91	Dave Lyons** Fixed a bug in CheckRecent (see MM:MM.asm for description and scenario).* Since this is in ROM on ROM 3 and is not vectorized, I have to patch* all affected calls.**   DisposeHandle, PurgeHandle, and SetHandleSize:  Head patch, clear hints*   if they are equal.**   DisposeAll, PurgeAll:  To keep hinting, would need to patch out the*   loops because the hints could become equal at any time during the*   calls.  Instead, I just zero out the hints as a head patch.  This*   is kind of cool anyway, because after a DisposeAll/PurgeAll, there*   are likely to be big area of free memory ready to use.**   (By the way, ROM 1 was already zapping the hints on PurgeAll and*   DisposeAll!)** 21-Nov-91	Dave Lyons** DisposeHandle on first handle now returns error 0 (for compatibility).** 19-Dec-91	Dave Lyons** Patched SearchFail vector ($E1/16A8) to return CLC (don't try again)* when Retry gets out of range.  This fixes a problem where the retry* count would escape & count from 7 to $FFFF (takes several minutes),* and then hit 0 and crash.  (This happened only when an OOMQ routine* freed up memory on the second pass, but the handle still could not* be allocated.)** 20-Dec-91	Dave Lyons** Fixed the above to use MMPatcher to remove the patch on a reboot* (command-control-reset, OSShutDown).** 31-Jan-92	Dave Lyons** Made NewMMPatcher disable interrupts and fix the ToBramSetup vector* ($e10094).** 5-Feb-92	Dave Lyons** Version $0302 for 6.0 final.********************************************************************************	title 'Memory Manager Patches'MMVersionNum	equ $0302	INCLUDE ':::mm:mm.equates.asm'	Title 'Call Table'*****************************************************************MMCallTable	PROC EXPORT** References to all	calls that are patched.*** Inputs:*   none** Outputs:*   none** External Refs:	import DisposeHandle	import MMVersion	import SetHandleID	;22-Jan-91 DAL	import PurgeHandle	;14-Sep-91 DAL	import PurgeAll	;14-Sep-91 DAL	import SetHandleSize ;14-Sep-91 DAL	import DisposeAll	;14-Sep-91 DAL	import MMBootInit	;19-Dec-91 DAL** Entry Points:*   none*	longa on	; mode	longi on*****************************************************************	DC.L (TableEnd-mmCallTable)/4 ; # entries + 1	DC.L MMBootInit-1	;01 Boot time call (patched 19-Dec-91 DAL)	DC.L 0	;02 Application init call	DC.L 0	;03 App quit	DC.L MMVersion-1	;04 Version #	DC.L 0	;05 Reset call	DC.L 0	;               i4'MMStatus-1'         ;06 Active status	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NewHandle-1'        ;09 NewHandle	DC.L 0	;               i4'ReallocHandle-1'    ;0A ReallocHandle	DC.L 0	;               i4'RestoreHandle-1'    ;0B RestoreHandle	DC.L 0	;	DC.L 0	;	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NotImp-1'	DC.L DisposeHandle-1 ;$1002 DisposHandle	DC.L DisposeAll-1	;$1102 patched 14-Sep-91 DAL	DC.L PurgeHandle-1	;$1202 patched 14-Sep-91 DAL	DC.L PurgeAll-1	;$1302 patched 14-Sep-91 DAL	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'GetHandleSize-1'    ;18 GetHandleSize	DC.L SetHandleSize-1 ;$1902 patched 14-Sep-91 DAL	DC.L 0	;               i4'FindHandle-1'       ;1A FindHandle	DC.L 0	;               i4'FreeMem-1'          ;1B FreeMem	DC.L 0	;               i4'MaxBlock-1'         ;1C MaxBlock	DC.L 0	;               i4'TotalMem-1'         ;1D TotalMem	DC.L 0	;               i4'CheckHandle-1'      ;1E CheckHandle	DC.L 0	;               i4'CompactMem-1'       ;1F CompactMem	DC.L 0	;               i4'HLock-1'            ;20 HLock	DC.L 0	;               i4'HLockAll-1'         ;21 HLockAll	DC.L 0	;               i4'HUnlock-1'          ;22 HUnlock	DC.L 0	;               i4'HUnlockAll-1'       ;23 HUnlockAll	DC.L 0	;               i4'SetPurge-1'         ;24 SetPurge	DC.L 0	;               i4'SetPurgeAll-1'      ;25 SetPurgeAll	DC.L 0	;               i4'NotImp-1'           ;26 DeRef	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'PtrToHand-1'        ;28 PtrToHand	DC.L 0	;               i4'HandToPtr-1'        ;29 HandToPtr	DC.L 0	;               i4'HandToHand-1'       ;2A HandToHand	DC.L 0	;               i4'BlockMove-1'        ;2B BlockMove	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NotImp-1'	DC.L 0	;               i4'NotImp-1'	DC.L 0	; 2F RealFreeMem	dc.l SetHandleID-1	; 30 SetHandleID 22-Jan-91 DALTableEnd	ENDP****************************************************************** MMBootInit -- new patch 19-Dec-91 DAL for 6.0d62** Patch the SearchFail vector (E1/16A8) if it isn't already* patched.*****************************************************************MMBootInit	proc export	import mySearchFail*** rewritten 20-Dec-91 DAL for d62+, modeled after Patch2:mm.asm	phb	pea $e1e1	plb	plb	lda |SearchFail+1	cmp #mySearchFail	beq DoNothing	php	sei; Save the MMPatcher vector	lda |MMPatcher	sta >OrigMMPatcher	lda |MMPatcher+2	sta >OrigMMPatcher+2; Set the new MMPatcher vector	lda #NewMMPatcher	sta |MMPatcher+1	lda #>NewMMPatcher	sta |MMPatcher+2; Save the SearchFail vector	lda |SearchFail	sta >OrigSearchFail	lda |SearchFail+2	sta >OrigSearchFail+2; Set the new SearchFail vector	lda #mySearchFail	sta |SearchFail+1	lda #>mySearchFail	sta |SearchFail+2	plpDoNothing	plb	lda #0	clc	rtlOrigMMPatcher	ds.b 4OrigSearchFail	ds.b 4NewMMPatcher	phb	pea $E1E1	plb	plb	php	;added 31-Jan-92 DAL	sei	;added 31-Jan-92 DAL	lda >OrigMMPatcher	sta |MMPatcher	lda >OrigMMPatcher+2	sta |MMPatcher+2	lda >OrigSearchFail	sta |SearchFail	lda >OrigSearchFail+2	sta |SearchFail+2*** added 31-Jan-92 DAL -- fix the ToBramSetup vector ($e10094)	lda #$ffbb	;high word of jmp >$ffbb7a	sta |$0094+2	lda #$7a5c	;low word of jmp >$ffbb7a	sta |$0094	plp*** end 31-Jan-92	plb	rtl*** end 20-Dec-91 DAL	EndP********************************************************************************** SearchFail - Called when unable to find a segment*              This	routine decides what sort of compaction, etc. to do*              If in an interrupt, no compaction or purging	is done.**  So what does it do?**  First, we looke at the IRQActive flag.  If we are inside an interrupt,*  we must not move or dispose of anything.  We can only fail.**  If we can try and make room we look at the retry count:**     1:  Let User try*     2:  Compact*     3:  Purge Level 3's*     4:  Pugee Level 2's*     5:  Purge Level 1's*     6:  Let user try one last time.**** Output:      C = 1 if ok to retry*********************************************************************************** Patched 19-Dec-91 DAL.  Original code is at $FC/1188 in ROM 3.*********************************************************************************mySearchFail	proc export	lda |$00CB	;IrqActive--In an interrupt?	and #$00FF	bne myGiveUp	inc Retry	; bump the retry count and see how many times	lda Retry	; we've been here	cmp #7	bcs myGiveUp	jml >$fc119a	;back to ROM 3!myGiveUp	clc	rtl	EndP*****************************************************************MMVersion	PROC** Returns the version number of the patched memory manager.*** Inputs:*   none** Outputs:*   version number** External Refs:*   none** Entry Points:*   none*	longa on	; mode	longi on*****************************************************************	lda #MMVersionNum	sta 7,s	lda #0	;No error	clc	rtl	ENDP*****************************************************************DisposeHandle	PROC** Patch the rom to make sure that handle being disposed is* not the last one allocated.*****************************************************************RealDisposeHandle	equ $FC062A	import VerifyHandle,CheckForEqualHints	jsr CheckForEqualHints  ;added 14-Sep-91 DAL*** added 12-Jun-91 DAL -- disposing the very first handle is very bad!;;MemList	equ $E11600	;List of used segments	lda 7,s	cmp >MemList	bne @notFirstHandle	lda 9,s	cmp >MemList+2	bne @notFirstHandle;;;	ldx #$0206	;bad handle error	ldx #0	;no error (21-Nov-91 DAL)	ldy #4	jml $e10184	;ToStrip (4 bytes)@notFirstHandle*** end of 12-Jun-91 DAL	jsl Link;; mensch 11/13/89; Fix BRC#53386 Disposehandle bug. Add the call to verifyHandle...;	jsr VerifyHandle	; added to insure that the passed handle is OK.	jml RealDisposeHandle	ENDP****************************************************************** DisposeAll patched 14-Sep-91 DAL to zap the hints.  The* ROM 1 code is already doing this to reduce fragmentation.** Also, I have to either zap the hints here or patch out the* guts of the call, because the ROM 3 CheckRecent does not* realize that the low and high hints can be equal. *****************************************************************DisposeAll	proc	import ClearRecent	jsr ClearRecent	jml >$fc0643	;original DisposeAll entry	EndP****************************************************************** PurgeHandle patched 14-Sep-91 DAL to zap the hints if they* are equal, because ROM 3 CheckRecent does not realize they* can be equal, so it screws up that case (leaves high hint* pointing into the void).*****************************************************************PurgeHandle	proc	import CheckForEqualHints	jsr CheckForEqualHints	jml >$fc0680	;original PurgeHandle entry	endp****************************************************************** PurgeAll patched 14-Sep-91 DAL to zap the hints.  The* ROM 1 code is already doing this to reduce fragmentation.** Also, I have to either zap the hints here or patch out the* guts of the call, because the ROM 3 CheckRecent does not* realize that the low and high hints can be equal. *****************************************************************PurgeAll	proc	import ClearRecent	jsr ClearRecent	jml >$fc068e	;original PurgeAll entry	endp****************************************************************** SetHandleSize patched 14-Sep-91 DAL to zap the hints if they* are equal, because ROM 3 CheckRecent does not realize they* can be equal, so it screws up that case (leaves high hint* pointing into the void).*****************************************************************SetHandleSize	proc	import CheckForEqualHints	jsr CheckForEqualHints	jml >$fc06e3	;original SetHandleSize entry	endp****************************************************************** ClearRecent** Zeros the values in LastLowHandle and LastHighHandle*****************************************************************ClearRecent	PROC	lda #0	sta >LastLowHandle	sta >LastLowHandle+2	sta >LastHighHandle	sta >LastHighHandle+2	rts	EndP****************************************************************** CheckForEqualHints -- 14-Sep-91 DAL** If the high and low hints are equal, zap them.  ROM 3* CheckRecent is not prepared for them being equal.*****************************************************************CheckForEqualHints	PROC	pha	lda >LastHighHandle	cmp >LastLowHandle	bne @exit	lda >LastHighHandle+2	cmp >LastLowHandle+2	bne @exit	jsr ClearRecent@exit	pla	rts	END