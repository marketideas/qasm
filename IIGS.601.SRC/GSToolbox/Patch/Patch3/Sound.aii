*******************************************************************			 ******          Sound Patch		 ******          For Version 2.0 of ROM		 ******          Copyright Apple Computer, Inc. 1985-1989	 ******          All Rights Reserved		 ******			 ******			 ****** Version 2.0 in ROM		 ******			 ****** Version 2.1 for	system.disk version	3.1	 ******    August 27, 1987		 ******    Gus Andrade			 ******			 ****** Version 2.2 for	system.disk 3.1.1		 ******    October 13, 1987		 ******    Steven Glass			 ******			 ******    Installation	code removed and patch linked with	 ******    other system	patches.		 ******			 ******    Dummy BootInit call placed in table so code	 ******    can init properly.		 ******			 ******    Duplicate equate for IRQ_Volume removed in	 ******    favor of value in sysEqus (E1Vectors)	 ******			 ****** Version 2.3 for system disk 3.2 		 ******     May 11, 1988		 ******     Don Marsh			 ******			 ******     Patched Sound Tools' BootInit call to initialize	 ******     the "MidiInputPoll" vector to an RTL.	 ******			 ******     June 15, 1988  Harry Yee		 ******			 ******     Prototype bit taken out of version number.	 ******			 ****** Version 2.4 for system disk 4.0		 ******			 ******     Changed location of midi poll vector.	 ******			 ************ Version 3.1 for system disk 5.0*** 20 May 89	Matt Denman**       Patched out interrupt handler to fix two bugs:**       1.  If used in swap mode and only 2 buffers, 2nd*           was not played.**       2.  If using stero and not balenced the last buffer*           not played on right channel.**       Re-orgainzed patch so that code in ROM is linked*       rather than included.*** 08 Aug 90	Braz** Changed files StartSound.aii and StartPlaying.aii* to fix problems playing sounds two buffers or less in length* using FFSetUpSound and FFStartPlaying** 17-Sep-90	Dave Lyons** Removed all.macros dependency.********************************************************************	Include 'all.macros'	;removed 17-Sep-90 DAL	include 'm16.util2'	Include 'E16.MIDI'	Include ':::Sound:Snd.Equ.aii'****************************************************************;; spatch.equ    This module contains all of the equates used by;               the	routines in the sound tools patch file;****************************************************************		;  MIDI Tool Setsgaddh	equ $C03F	; sound Glu address	high******************************************************************* SoundCallTable******************************************************************	EXPORT SoundCallTableSoundCallTable	PROC	Import SoundBootInit	Import st_versin	Import StartSound	Import SetUpSound	Import SStartup	IMPORT StartPlayingFunct_1	DC.L num_funct/4	; number of functions	DC.L SoundBootInit-1 ; function 1	DC.L SStartup-1	; function 2	DC.L 00000000	; function 3	DC.L st_versin-1	; function 4	DC.L 00000000	; function 5	DC.L 00000000	; function 6	DC.L 00000000	; function 7	DC.L 00000000	; function 8	DC.L 00000000	; function 9	DC.L 00000000	; function A	DC.L 00000000	; function B	DC.L 00000000	; function C	DC.L 00000000	; function D	DC.L StartSound-1	; function E	DC.L 00000000	; function F	DC.L 00000000	; function 10	DC.L 00000000	; function 11	DC.L 00000000	; function 12	DC.L 00000000	; function 13	DC.L 00000000	; function 14	DC.L SetUpSound-1	; function 15 	DC.L StartPlaying-1 ; 16 Start specified generators running.	DC.L 00000000	; function 17	DC.L 00000000	; function 18num_funct	equ *-Funct_1	; number of functions	include ':::Sound:Tables.aii'		ENDP******************************************************************* SoundBootInit** This routine is called by the tool locator when this patch* is installed.** Added 13 Oct 87	 Steven Glass** 13 May 88	Harry Yee and Don Marsh** Added initialization of MidiInputPoll vector.******************************************************************	EXPORT SoundBootInitSoundBootInit	PROC	lda #$6B	; RTL	sta MidiInputPoll		lda #0	clc	rtl	ENDP		EXPORT st_versinst_versin	PROC****************************************************************** Version number tool returns the current Sound Tool* version #.**    Called:  pea 0	; return value placeholder*             Toolcall 8,4** Returns: X,Y unchanged.  Version on stack******************************************************************	longa on	longi on	lda #Version_patch	; get vers#	sta $07,s	; place in stack	Oendc 0		; jump to endcall in rom	ENDP		END