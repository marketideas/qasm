************************************************************************ Event manager patch** Copyright 1989-1992 Apple Computer, Inc.* All Rights Reserved************************************************************************* REVISION HISTORY** 11/16/89	Mensch*	Added this patch file to insure that the event manager*	call table was in RAM. This is so the Dialog manager*	can patch it on the fly...*	Had to change a call so I made the version call patched.** 23-Oct-90	Dave Lyons** This file was not used before.  Changed version to $8301.* Added GetNextEvent patch that checks to see if it was called by* ModalDialog.  If so, we strip off app1-app4 events from the* event mask.** 11-Feb-91	Dave Lyons** Added HandlePendingSysBeep2 routine for SysBeep2 requests that are* deferred until the next GetNextEvent (this is useful for making a* beep happen after a modal dialog is drawn).** HandlePendinsSysBeep2 is exported to TS2.** 25-Feb-91	Dave Lyons** Patched EMStartUp and EMShutDown for preserving cursor position.** 5-Mar-91	Dave Lyons** Added a line in the GetNextEvent patch:  When it detects that the* call is coming from ModalDialog, it now calls ModalDialogCursorPoll* in Patch3:DialogMgr.pch.** 9-Mar-91	Dave Lyons** HandlePendingSysBeep2 now zeroes out the pending flag *before** calling SysBeep2, in case somebody calls GetNextEvent from within* their SysBeep2 handler.** 17-Sep-91	Dave Lyons** Made PendingSysBeep2 a global so it can be shared between TS2/3* and Tool.Setup (SysBeep2 is now in Tool.Setup, so I couldn't link).** 5-Feb-92	Dave Lyons** Version $0301 for 6.0 final.************************************************************************* 3-Jun-92	Dave Lyons** Version $8302 for 6.0.1d5 (changed UseCoolMousePos in em.asm).** 2-Apr-93 DAL** Version $0302 for 6.0.1***********************************************************************EMVerNum	equ $0302	include 'all.macros'PendingSysBeep2	equ $E1167E****************************************************************** CALL TABLE*****************************************************************EMCallTable	PROC Export	import EMVersion	import GetNextEvent	import EMStartUp	;25-Feb-91 DAL	import EMShutDown	;25-Feb-91 DAL	DC.L (TheEnd-EMCallTable)/4 ;num calls + 1	DC.L 0	; EMBootInit-1	DC.L EMStartUp-1	; 25-Feb-91 DAL	DC.L EMShutDown-1	; 25-Feb-91 DAL	DC.L EMVersion-1	DC.L 0	; EMReset-1	DC.L 0	; EMActive-1	DC.L 0	; oEndCall0-1	DC.L 0	; oEndCall0-1	DC.L 0	; DoWindows-1	DC.L GetNextEvent-1		; 23-Oct-90 DAL	DC.L 0	; EventAvail-1	DC.L 0	; GetMouse-1	DC.L 0	; Button-1	DC.L 0	; StillDown-1	DC.L 0	; WaitMouseUp-1	DC.L 0	; TickCount-1	DC.L 0	; GetDblTime-1	DC.L 0	; GetCaretTime-1	DC.L 0	; SetSwitch-1	DC.L 0	; PostEvent-1	DC.L 0	; FlushEvents-1	DC.L 0	; GetOSEvent-1	DC.L 0	; OSEventAvail-1	DC.L 0	; SetEventMask-1	DC.L 0	; FakeMouse-1	; $1906	DC.L 0	; SetAutoKeyLimit-1 ; $1A06	DC.L 0	; GetKeyTranslation-1 ; $1B06	DC.L 0	; SetKeyTranslation-1 ; $1C06TheEnd	ENDP****************************************************************** EMStartUp -- patched 25-Feb-91 DAL** Sets the cursor position based on message #6, if it exists* and QuickDraw is active.******************************************************************EMStartUp	PROC** This routine calls the original EMStartup routine and then* installs the keyboard interrupt handler*** Inputs:*	dPageAddr : word*	queueSize : word*	xMinClamp : word*	xMaxClamp : word*	yMinClamp : word*	yMaxClamp : word*	userID : word** Outputs:*	none*****************************************************************	import UseCoolMousePos	;24-Feb-91 DAL	longa on	longi on****************************************************************	DefineStackRTL1	block 3RTL2	block 3origD	wordUserID	wordyMaxClamp	wordyMinClamp	wordxMaxClamp	wordxMinClamp	wordqueueSize	worddPageAddr	wordRealEMStartup	equ $FEE2A3	;ROM 3 EMStartUp	tax	; save orig value of WAP in x	phd	tsc	tcd		pei dPageAddr	; push all the params again	pei queueSize	pei xMinClamp	pei xMaxClamp	pei yMinClamp	pei yMaxClamp	pei UserID	txa	; get wap value back	jsl ToRealEMStartup ; call the real startup code	pha	; save any error code	bcs AnError*** added 24-Feb-91 DAL	jsl UseCoolMousePos*** end of 24-Feb-91 DALAnError	plx	; pull off the error code returned by orig startup callAnError2	pld	; restore the direct page	ldy #14	; strip the inputs off the stack	jml $e10184	;ToStripToRealEMstartup	jsl RealEMStartup	rtl		ENDP****************************************************************** EMShutDown -- patched 25-Feb-91 DAL** Creates MessageCenter message #6 recording the old cursor* position.*****************************************************************EMShutDown	proc	import CreateMouseMessage	;24-Feb-91 DAL	tax	beq @notStarted	pha	;save WAP for jumping to ROM	jsl CreateMouseMessage	pla@notStarted	jml $fee4b7	;original ROM 3 EMShutDown	EndP****************************************************************** EMVersion*****************************************************************EMVersion	PROC Export	lda #EMVerNum	sta 7,s	lda #0	clc	RTL	ENDP****************************************************************** GetNextEvent patch** 23-Oct-90 DAL** See if ModalDialog called us.  If so, mask off app1-app4* events.*****************************************************************GetNextEvent	PROC Export	import HandlePendingSysBeep2	import ModalDialogCursorPoll	jsr HandlePendingSysBeep2	pha	lda 4+2,s	;called from $fc7dd0?	cmp #$7dd0+3	bne @toROM	lda 5+2,s	cmp #$fc7d	bne @toROM	lda 11+2,s	and #$0fff	;mask off app1-app4 events	sta 11+2,s	jsl ModalDialogCursorPoll  ;in Patch3:DialogMgr.pch (5-Mar-91 DAL)@toROM	pla	jml >$fee5cc	EndP****************************************************************** HandlePendingSysBeep2** 11-Feb-91 DAL** If PendingSysBeep2 is nonzero, do the SysBeep2 call.*****************************************************************HandlePendingSysBeep2 proc export	pha	phy	lda 11+6,s	and #$002A	;keydown, autokey, mousedown?	beq @done	;nope, don't do the SysBeep2	lda >PendingSysBeep2	beq @done	pha	lda #0	sta >PendingSysBeep2	_SysBeep2@done	ply	pla	rts	EndP	end