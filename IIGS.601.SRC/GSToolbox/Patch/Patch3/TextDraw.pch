********************************************************************************* TextDrawPatch** (C)  Copyright Apple Computer, Inc. 1989* All rights reserved.** by Jim Mensch* 11/17/89** Patches to the text routines** Files:**** Modification History:** Version 1.0   	Mensch	11/17/89********************************************************************************	include 'all.macros'	include ':::qd:qdequates:qd.data.asm'	INCLUDE ':::qd:QDEquates:CORE.GLOBALS1'	INCLUDE ':::qd:QDEquates:core.globals2'	INCLUDE ':::qd:QDEquates:region.equs'	Include ':::qd:qdEquates:TextEquates'	Include ':::qd:qdEquates:Fontequs'	Import ExtendColorWord	ROMFastBigLoop	equ $FE9171ROMSlowBigLoop	equ $FE9233ConTable320	equ $FE6372ConTable640	equ $FE6772	****************************************************************** BlowItUp patched version** This is the routine that takes the 1-bit per pixel text* image in the text	buffer and paints it to the destination* bit map as 2 or 4	bits per pixel with	the right* foreground and background color in the right text mode.** Several modes are	supported as follows**        Mode*        Code*         0    Copies foreground and background into destination*         1    OR's foreground and background with destination*         2    XOR's foreground and background with destination*         3    BIC's foreground and background with destination*         4    Copies only the foreground into the destination*	(background is untouched).*         5    OR's foreground into destination (background is*	untouched).*         6    XOR's foreground into destination (background is*	untouched).*         7    BIC's foreground into destination (background is*	untouched).** Each mode is acheived by its own handler.  The first part	of SetItUp* puts the vector to the handler in the	current JMP vector location* in bank E0.** There is no left and right mask as I rely on the MinRect to* be set up correctly.  The right MinRect means that the left* and right mask are already incorporated in the scan line* buffer.** Variables On zero	page that I use are:**     CurPMByte	 ; a pointer in the	inner loop of BlowItUp*     CurTBByte	 ; a pointer in the	inner loop of BlowItUP*     WordCounter	 ; counter in the inner loop of BlowItUp*     FG	 ; local copy of foreground color*     BG	 ; local copy of background color*     TextMode	 ; local copy of text mode** Change History** 18 Feb 87    Steven Glass** Using font flag 2	(counting from zero) we decide if we should* force the text color to be adjusted or not.  When I adjust* the color I call ExtendColorWord which copies the lowest* pixel into the other pixels of the word.  When I don't make* this call, the programmer can have dithered color text in* 640 mode or multi	colored text (a vertical striped pattern)* in any mode.** 11/17/89	Mensch* Created the patched version and applied some speed improvements*****************************************************************	EXPORT iBlowItUpiBlowItUp	PROC;-----------------------------------------------;; First setup the Text mode;	ldy #o_txmode	lda [PortRef],y	sta TextMode;----------------------------------------------------------;; Check font flag 2	(numbered from zero) to see if the; programmer wants me to force the color to be right or if; s/he wants me to use the foreground and background colors; as they are passed in the port.;	stz Temp	ldy #o_FontFlags	lda [PortRef],y	and #%0000000000000100	beq NotSpecial	dec TempNotSpecial	ldy #o_FGColor	lda [PortRef],y	bit Temp	bmi UseAsIs1	tax	lda PortSCB	jsr ExtendColorWordUseAsIs1	sta FG	ldy #o_BGColor	lda [PortRef],y	bit temp	bmi UseAsIs2	tax	lda PortSCB	jsr ExtendColorWordUseAsIs2	sta BG	jsl Init2Regions	lda MinRect	sta CurrentY;--------------------------------------------------------; SetStuffAdr gets moved here so we can take advantage of ; the Init2Regions call and the color smearing...;;	lda <textMode	jsl SetStuffAdr	jsl ShieldCursor	lda NonRectRegions	beq @tryRectLoop@booRect	lda TextMode	and #$7FFF	cmp #4	bcs oFastBigLoop	jmp oSlowBigLoop	@SpecialCase	lda fg	inc a	bne @boorect	lda TextMode	ora #$8000	sta TextMode*** added 8-Mar-91 DAL; 3/11/91 Mensch; nice try dave, but how about...	inc <fg	; was $FFFF (white) we want $0000 Black	dec <bg	; was $0000 (Black) we want $FFFF white*** end DAL	bra @UseRectLoop@tryRectLoop	lda bg	; now test to see if we are drawing black on white..	beq @SpecialCase	; test for white on black...	inc a	bne @booRect	lda fg	bne @booRect	@UseRectLoop	lda TextMode	and #$7FFF	cmp #4	bcs oFastBigLoop	phb	; be sure to set the data bank to bank $FE	pea $FEFE	plb	plb	jmp rSlowBigLoop		Export oFastBigLoop	Export oSlowBigLoopoFastBigLoop	jml >ROMFastBigLoopoSlowBigLoop	jml >ROMSlowBigLoop	ENDP****************************************************************** rSlowBigLoop** SlowBigLoop is used when the foreground and background are* transfered.  The major difference between fast and slow is that* in the fast loop we check each word, if it is zero, we bypass* the stuff big code.  This saves lots of time.  Here we bypass* nothing.** 11/17/89	Mensch* Modified this loop so that we can call it when the region is rectangular* this will help to improve speed of mode copy text drawing...*****************************************************************rSlowBigLoop	PROC Export	jsl Seek2RegionsBigLoop	lda tbStartByte	sta CurTBByte	lda pmStartByte	sta CurPMByte		lda NumOfWords	; set up the counters that the	sta WordCounter	; inner loop uses	lda TextMode	; see if we are mode copy...	and #$7fff	;*** added this line 8-Mar-91 DAL	bne NotCopyLoop	; skip to the faster word loop	brl CopyLoop;------------------------------------------------------;; See which of the two inner loops I should use.;NotCopyLoop	bit TextMode	bmi InvertLoop;Loop		; this loop is for standard xfer modes	ldy CurTBByte	lda [tbRowPtr],y	jsl ToStuffBig	ldy CurTBByte	iny	lda [tbRowPtr],y	iny	sty CurTBByte	jsl ToStuffBig	dec WordCounter	bpl Loop	bra NextRowInvertLoop		;this loop is for the NOT xfer modes	ldy CurTBByte	lda [tbRowPtr],y	eor #$FFFF	jsl ToStuffBig	ldy CurTBByte	iny	lda [tbRowPtr],y	eor #$FFFF	iny	sty CurTBByte	jsl ToStuffBig	dec WordCounter	bpl InvertLoopNextRow	lda tbRowPtr	clc	adc BufRowBytes	sta tbRowPtr	bcc NoCarry1	inc tbRowPtr+2NoCarry1	lda pmRowPtr	clc	adc Width	sta pmRowPtr	bcc NoCarry2	inc pmRowPtr+2NoCarry2	inc CurrentY	dec RowCounter	bpl BigLoopDone	plb	; recover the data bank register..	jsl UnShieldCursor	rtl;;; --- special case loop to be used for mode copy...; This only works if the region is a rectangle...CopyLoop	bit TextMode	bpl CopyCont	brl InvertLoop	CopyOuterLoop	lda tbStartByte	sta CurTBByte	lda pmStartByte	sta CurPMByte		lda NumOfWords	; set up the counters that the	sta WordCounter	; inner loop uses;; First do the very first word...CopyCont	ldy CurTBByte	lda [tbRowPtr],y	pha	jsl StuffBig0640	; call the routine directly...	pla	xba	jsl StuffBig0640	; and do the next byte..	lda WordCounter	; now dec the word counter	dec a	sta WordCounter	bmi RowBump	; if we are done forget incrementing...; If not done, compensate for that last bit of stuff	ldy CurTBByte	iny	iny	sty CurTBByte	lda WordCounter	beq DoLastWord;; This is the fast internal copy loop. it must be entered with word count in <A> and; curTBByte in <Y>FastCopyLoop			lda [tbRowPtr],y	jsr StuffWordNoClip	; and stuff the whole word with no clipping..	ldy CurTBByte	iny	iny	sty CurTBByte	lda WordCounter	; now dec the word counter	dec a	sta WordCounter	beq DoLastWord	; if zero then do the last word...	bpl FastCopyLoopDoLastWord; looks a lot like the code that did the first word ... he he he	ldy CurTBByte	lda [tbRowPtr],y	pha	jsl StuffBig0640	; call the routine directly...	pla	xba	jsl StuffBig0640	; and do the next byte..;; Note, at this point Word counter is RowBump	lda tbRowPtr	clc	adc BufRowBytes	sta tbRowPtr	bcc @NoCarry1	inc tbRowPtr+2@NoCarry1	lda pmRowPtr	clc	adc Width	sta pmRowPtr	bcc @NoCarry2	inc pmRowPtr+2@NoCarry2	dec RowCounter	bpl CopyOuterLoop	brl Done	ENDP****************************************************************** SetStuffAdr*****************************************************************iSetStuffAdr	PROC Export	Import OldSetStuffAdr; My patched setstuff routine...iSetStuff	bit <PortSCB-1	; test for 640 mode	bpl jumptoROM	; if 320 mode, head to the ROM	cmp #$0000	; see if the passed mode is copy...	bne jumptoROM	; if not, just go to ROM...	lda bg	; make sure background and foreground are right	inc a	bne jumpToROM1	; not black on white...	lda fg	bne jumptoROM1	; ... same ...		lda >MyStuffBig0640	sta >toStuffBig	lda >MyStuffBig0640+2	sta >toStuffBig+2	rtljumptoROM1	lda textMode	; recover the text mode...jumptoROM	JML OldSetStuffAdr	MyStuffBig0640	JML >stuffBig0640	ENDPStuffWordNoClip	proc Export	Export cont26	Export Cont36	sta <tempFG	and #$00FF	asl a	taxCont26	lda |ConTable640,x	eor #$FFFF	ldy CurPMByte	sta [pmRowPtr],y	iny	iny	lda <tempFG	xba	and #$00FF	asl a	taxCont36	lda |ConTable640,x	eor #$FFFF	sta [pmRowPtr],y	iny	iny	sty CurPMByte	rts	; and return...	EndP	StuffBig0640	proc Export	Export Cont16	and #$00FF	; deal with only one byte at a time	asl a	; double the value so can index*		; into conversion table	taxCont16	lda >ConTable640,x	eor #$FFFF	sta tempFG	ldy CurPMByte	; get index to dest	lda [ScanMaskRef],y	; get mask for this	scan line	eor #$FFFF	; invert it	beq @SlamFast	and [pmRowPtr],y	; and with orig dest	sta NotMaskAndDest	; save this here	lda [ScanMaskRef],y	; get mask back	and tempFG	; and with rightly colored word	ora NotMaskAndDest	; or with burned out dest	sta [pmRowPtr],y	; and put it back!	iny	iny	sty CurPMByte	rtl	@SlamFast	lda tempFG	sta [pmRowPtr],y	iny	iny	sty CurPMByte	rtl	ENDP;                copy text/stuffbig1****************************************************************** StuffBig1** This is the routine that ORs into the	destination* coloring the forground and background.*****************************************************************;                copy text/stuffbig2****************************************************************** StuffBig2** This is the routine that XORs into the destination with* colored forground	and background.*****************************************************************;                copy text/stuffbig3****************************************************************** StuffBig3** This is the routine that BICs into the destination with* colored forground	and background.*********************************************************************************************************************************** StuffBig4** This is the routine that copies only the foreground* pixels into the destination.*********************************************************************************************************************************** StuffBig5** This is the routine that OR's the foreground into the dest.* It is probably the fastest of the routines.*****************************************************************;                copy text/stuffbig6****************************************************************** StuffBig6** This is the routine that XOR's the foreground into the dest.* It is one of the fastest of the routines.*****************************************************************;                copy text/stuffbig7****************************************************************** StuffBig7** This is the routine that BIC's the foreground into the dest.* It is not as fast	as OR and XOR but is a lot faster than* copy.*****************************************************************	END