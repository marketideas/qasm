	title 'Scrap Manager Patch      GS ROM 3 Patch'*****************************************************************			   **              Copyright (C) 1990		   **              All Rights Reserved		   **              Apple Computer, Inc.		   **			   *********************************************************************************************************************************** Scrap Manager patches for ROM 3** System Software 6.0******************************************************************* 24-Sep-90	Dave Lyons** New file.  Imports routines from the RAM-based scrap manager.* So far we are patching ScrapVersion and UnloadScrap and adding* GetIndScrap.** 18-Nov-90	Dave Lyons** UnloadScrap was a patch stub before.  Now it gets linked in* from TOOL022.** 3-Jan-91	Dave Lyons** Patched ScrapStartUp to zero out Scrap State, because on ROM 3* ScrapBootInit gets called before the OS is around, and it was* deciding that the scrap was in memory when it was really on* disk but inaccessible.** 17-Feb-91 DAL** ABANDONING THIS PATCH FILE.  Haven't been using it lately, and* it looks like it's going to stay that way.  It's not worth it* to try salvaging the ROM 3 version of the Scrap Manager, so we're* using it out of RAM instead.*****************************************************************	Blanks off	String asis		include 'm16.util2'	include 'm16.memory'	include 'm16.scrap'** JSRL macro for calling RTS subroutines in ROM*	GBLA &MacroCnt&MacroCnt	Seta 0	Macro&Lab	JSRL &Addr	GBLA &MacroCnt&MacroCnt	SETA &MacroCnt+1	phk	per theRTL&MacroCnt-1	pea |LclRTL-1	jml >&AddrtheRTL&MacroCnt	MENDLclRTL	equ $FC01C3****************************************************************** ScrapCallTable*****************************************************************	EXPORT ScrapCallTableScrapCallTable	PROC	import ScrapVersion	import UnloadScrap	import GetIndScrap	import ScrapStartUpTheBeginning	DC.L (TheEnd-TheBeginning)/4 	; call count + 1	DC.L 0		;0116 ScrapBootInit	DC.L ScrapStartUp-1		;0216 ScrapStartUp	DC.L 0		;0316 ScrapShutDown	DC.L ScrapVersion-1		;0416 ScrapVersion	DC.L 0		;0516 ScrapReset	DC.L 0		;0616 ScrapStatus	DC.L 0		;0716 reserved	DC.L 0		;0816 reserved	DC.L UnloadScrap-1		;0916 UnloadScrap	DC.L 0		;0A16 LoadScrap	DC.L 0		;0B16 ZeroScrap	DC.L 0		;0C16 PutScrap	DC.L 0		;0D16 GetScrap	DC.L 0		;0E16 GetScrapHandle	DC.L 0		;0F16 GetScrapSize	DC.L 0		;1016 GetScrapPath	DC.L 0		;1116 SetScrapPath	DC.L 0		;1216 GetScrapCount	DC.L 0		;1316 GetScrapState	DC.L GetIndScrap-1		;1416 GetIndScrap (added 24-Sep-90 DAL)TheEnd	EndP;----------------------------------------------------;; Zero page equates.;ScrapTablePtr	equ 1	; offset 1 because the old data bank is	stored at 0 OffsetToThisOne	equ ScrapTablePtr+4PtrToThisOne	equ OffsetToThisOne+4DestHandle	equ PtrToThisOne+4DestPtr	equ DestHandle+4WAPEntry	equ DestPtr+4MemHandle	equ WAPEntry+4MemPtr	equ MemHandle+4OrigDirect	equ MemPtr+4StdZPSize	equ OrigDirect-1;----------------------------------------------------;; Scrap Record;o_ScrapType	equ 0o_ScrapSize	equ 2o_ScrapHandle	equ 6ScrapRecSize	equ 10;----------------------------------------------------;; ScrapAttributes for the memory I getScrapAttributes	equ $0008	; not special memory;----------------------------------------------------;; File type for clipboard file.;ClipFileType	equ 0	; don't know yet*ClipAuxType	equ 0;-----------------------------------------------------------;; Error Codes we need to label.;FileNotFound	equ $46	; ProDOS errorNotImpError	equ $16FFTypeError	equ $1610;-----------------------------------------------------------;; Equates for OS entry points.;OS_ENTRY	equ $E100A8OS_ENTRY2	equ $E100B0OS_Zero	equ $E100BAOS_Kind	equ $E100BCOS_Boot	equ $E100BD;-----------------------------------------------------------;; Memory Manager attributes;Attr_Locked	equ $8000	; 1 = LockedAttr_Fixed	equ $4000	; 1 = Not movableAttr_Purge	equ $0300	; 0 = No purge 1-3 purge levelAttr_NoCross	equ $0010	; 1 = May not cross	banksAttr_NoSpec	equ $0008	; 1 = May not use special memoryAttr_Page	equ $0004	; 1 = Page AlignedAttr_Addr	equ $0002	; 1 = Fixed addressAttr_Bank	equ $0001	; 1 = Fixed address;-----------------------------------------------;;   Equates for Stack based ProDOS calls;   and other memory locations that needed space;   because code is	being made non-self	modifying;CreateCall	equ $01DestroyCall	equ $02GetFileInfo	equ $06OpenCall	equ $10ReadCall	equ $12WriteCall	equ $13CloseCall	equ $14StackProDOS	equ $E100B0;Open Call Parameters:OpenParams	equ 0OpenID	equ 0	; reference number assigned to file by the OPEN callOpenPath	equ OpenID+2	; pointer to pathname of file to openOpenBuf	equ OpenPath+4	; pointer to I/O buffer;Read Call Parameters:ReadParams	equ 0ReadID	equ 0	; reference number assigned to file by the OPEN callReadTo	equ ReadID+2	; pointer to location of buffer where data is read intoReadAmount	equ ReadTo+4	; the number of bytes to be transferred;Write Call Parameters:WriteParams	equ 0WriteID	equ 0	; reference number assigned to file by the OPEN callWriteFrom	equ WriteID+2	; pointer to location of where data is to be written toWriteAmount	equ WriteFrom+4	; number of bytes to write;Close Call Parameters:CloseParams	equ 0CloseRef	equ 0	; reference number assigned to file by the OPEN call;Create Call Parameters:CreateParams	equ ReadAmount+8CreatePath	equ ReadAmount+8	; pointer to pathname of file to createCreateAccess	equ CreatePath+4	; word value, how file may be accessedCreateFileType	equ CreateAccess+2	; file type of fileCreateAuxType	equ CreateFileType+2 ; file's auxiliary typeCreateStType	equ CreateAuxType+4	; logical organization of fileCreateDate	equ CreateStType+2	; date which file was createdCreateTime	equ CreateDate+2	; time at which file was created;Destroy Call Parameters:DestroyParams	equ CreateTime+2DestroyPath	equ CreateTime+2HowMuchToWrite	equ DestroyParams+4HowMuchToRead	equ HowMuchToWrite+4NumEntries	equ HowMuchToRead+4	; used when reading	the clipboard file from diskFirstScrapHandle	equ NumEntries+2ScrapState	equ FirstScrapHandle+4 ; ScrapState indicates whether scrap	is currently in memory or on diskScrapCount	equ ScrapState+2	; ScrapCount is incremented each time zero scrap is calledScrapHandle	equ ScrapCount+2ScrapName	equ ScrapHandle+4	; Pointer to pathname of clipboard file.FIParams	equ ScrapName+4TotalMem	equ FIParams+29;-----------------------------------------------; ;  System Equates;IncBusyFlg	equ $E10064DecBusyFlg	equ $E10068****************************************************************** ScrapStartUP** Zero out the Scrap State so we will look on disk again** Dave Lyons, 3-Jan-91*****************************************************************	ENTRY ScrapStartUp	entry StartScrapCall	entry EndScrapCallScrapStartUp	PROC	phy	pha	jsr StartScrapCall	ldy #ScrapState	lda #0	;scrap is on disk	sta [<MemPtr],y	tax	;error 0	jsr EndScrapCall	pld	ldy #0	;strip 6 bytes of parameters	jml $e10180	;ToBusyStrip	ENDP****************************************************************** ScrapVersion** 24-Sep-90	Dave Lyons*****************************************************************ScrapVersion	procScrapVersionNum	equ $8301	lda #ScrapVersionNum	sta 7,s	lda #0	clc	rtl	EndP****************************************************************** GetIndScrap** New call for 6.0   18-Sep-90 DAL** Description:** GetIndScrap(index,bufferPtr)*              WORD      LONG** Bits 24-31 of bufferPtr are reserved and must currently be 0.** Fills the supplied 10-byte buffer with information on the* Index-th scrap. The format of the buffer is:**   +000 scrap type   (word)*   +002 scrap handle (long)*   +006 scrap size   (long)*****************************************************************	ENTRY GetIndScrap	entry StartScrapCall	entry EndScrapCall	GetIndScrap	PROC exportROMLoadTheScrap	equ $fc9a55ROMDerefFirstHandle	equ $fc9949ROMUnlockFirstHndl	equ $fc996cWAPPointer	equ OrigDirect+2RTL1	equ WAPPointer+4RTL2	equ RTL1+3BuffPtr	equ RTL2+3IndexParm	equ BuffPtr+4	phy	pha	jsr StartScrapCall	ldy #ScrapState	lda [<MemPtr],y	bne @AlreadyInMem	jsrl ROMLoadTheScrap@AlreadyInMem	jsrl ROMDerefFirstHandle	lda IndexParm	beq @notFound	dec a	cmp [<scrapTablePtr]	bcs @notFound	tay	lda #2	iny@loop	dey	beq @multiplied	clc	adc #ScrapRecSize	bra @loop@multiplied	tay	clc	tya	adc <scrapTablePtr	tay	lda <scrapTablePtr+2	adc #0	pha	phy	pei <BuffPtr+2	pei <BuffPtr	pea 0	pea ScrapRecSize	_BlockMove	lda #0	;no error	bra @exit@notFound	lda #typeError* error in A@exit	pha	;save error code	jsrl ROMUnlockFirstHndl	plx	jsr EndScrapCall	pld	ldy #6	;strip 6 bytes of parameters	jml $e10180	;ToBusyStrip	ENDP****************************************************************** StartScrapCall** This routine sets	up direct page, adjusts the stack and* data bank, calls inc busy flag in preparation for the* start of a Scrap Manager call.*****************************************************************	ENTRY StartScrapCallStartScrapCall	PROC	ply	; get rts addr in y	phd	; save direct reg	tsc	; and get my zero page off stack	sec	sbc #StdZPSize	tcs	tcd	phb	; save data bank	phk	; set data bank to	plb	; code bank	lda StdZPSize+4,s	sta <MemHandle	lda StdZPSize+6,s	sta <MemHandle+2	phy	; put rts back on the stack	ldy #4	; deref and lock MemHandle	lda [<MemHandle],y	ora #$8000	sta [<MemHandle],y	dey	dey	lda [<MemHandle],y	tax	lda [<MemHandle]	sta <MemPtr	stx <MemPtr+2	jsl IncBusyFlg	rts	ENDP****************************************************************** EndScrapCall** This routine restores direct page and	data bank, and adjusts* adjusts the stack	to undo everything that startScrapCall* did.** Note:  DecBusyFlg	is done by the end call routine.*****************************************************************	ENTRY EndScrapCallEndScrapCall	PROC	ldy #4	; unlock MemHandle	lda [<MemHandle],y	and #$7FFF	sta [<MemHandle],y	ply	; save rts addr in y	plb	tsc	clc	adc #StdZPSize	tcs	lda 1,s	; save direct page	sta 5,s	; overwrite the high word of WAPEntry on stack	pla	; get rid of direct	page still on stack	                	pla	; get rid of low word of WAPEntry	phy	; put rts back on stack	rts	ENDP	END