************************************************************************************ THIS FILE IS NO LONGER USED.  System 6.0 uses Line Edit from RAM on ROM 3 ************************************************************************************	title 'LineEdit Patch        GS ROM 3 Patch'******************************************************************** LineEdit patches for ROM 3** System Disk 5.0** 12 Jun 89	Steven Glass** Fix bug in LENew.  Wrong sized handle was being allocated for* text buffer.** 01 Sep 89	Yee** Fix bug where LEFromScrap would trash a word of memory if the * desk scrap was empty. The word of memory that was trashed was* located $FFFE from where the  line edit scrap is located.** 17-Sep-90	Dave Lyons** Removed dependency on all.macros.** 22-Sep-90	Dave Lyons** Rolled version to $8303.* Patched LETextBox to clean up stack properly if Length=0.** 24-Sep-90	Dave Lyons** Added LEClick patch so we can do shift-clicking from a* Line Edit Control.** 28-Sep-90	Dave Lyons** Fixed stupid LETextBox patch.  It was storing onto the* wrong direct page (the caller's) instead of LE's.  Duh.* ************************************************************************************************************************************			   **              Copyright (C) 1989-90		   **              All Rights Reserved		   **              Apple Computer, Inc.		   **			   *****************************************************************	Blanks off	String asis		include 'm16.util2'	include 'm16.memory'	include 'm16.scrap'	include 'm16.event'	MACRO	PushZWord &A	pei  &A	MEND	include ':::LineEdit:LineEditEquates.asm'****************************************************************** LINE EDIT CALL TABLE*****************************************************************LECallTable	PROC EXPORT	import LENew	import LEVersion	import LEFromScrap	import LETextBox	import LEClick	;24-Sep-90 DALTheStart	DC.L (TheEnd-TheStart)/4 ;num calls + 1	dc.L 0	; LEBootInit-1	dc.L 0	; LEStartUp-1	dc.L 0	; LEShutDown-1	dc.L LEVersion-1	dc.L 0	; LEReset-1	dc.L 0	; LEActive-1	dc.L 0	; oStdEnd0-1	dc.L 0	; oStdEnd0-1	dc.L LENew-1	dc.L 0	; LEDispose-1	dc.L 0	; LESetText-1	dc.L 0	; LEIdle-1	dc.L LEClick-1	dc.L 0	; LESetSelect-1	dc.L 0	; LEActivate-1	dc.L 0	; LEDeactivate-1	dc.L 0	; LEKey-1	dc.L 0	; LECut-1	dc.L 0	; LECopy-1	dc.L 0	; LEPaste-1	dc.L 0	; LEDelete-1	dc.L 0	; LEInsert-1	dc.L 0	; LEUpdate-1	dc.L LETextBox-1	dc.L LEFromScrap-1	dc.L 0	; LEToScrap-1	dc.L 0	; LEScrapHandle-1	dc.L 0	; LEGetScrapLen-1	dc.L 0	; LESetScrapLen-1	dc.L 0	; LESetHilite-1	dc.L 0	; LESetCaret-1	dc.L 0	; LETextBox2-1	dc.L 0	; LESetJust-1	dc.L 0	; LEGetTextHand-1	dc.L 0	; LEGetTextLen-1	dc.L 0	; FakeGetLEDefProc-1TheEnd	ENDP*****************************************************************LEVersion	PROC** Returns the version number of line edit*** Inputs:*	none** Outputs:*	The patched version number** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	lda #$8303	;22-Sep-90 DAL	sta 7,s	lda #0	clc	RTL	ENDP****************************************************************** LENew*****************************************************************	Export LENewLENew	PROC;		;LENew uses TempPtr1 and TempPtr2	phd	tcd**	PushWord #0	;space for result**	PushWord #0	pha	;22-Sep-90 DAL	pha	;22-Sep-90 DAL	PushWord #0	;hi word of size	PushWord #LERecSize	;lo word of size	PushZWord <ProgID	;prog ID	PushWord #0	;unpurgeable**	PushWord #0**	PushWord #0	pha	;22-Sep-90 DAL (replaced above 2 lines	pha	;22-Sep-90 DAL  with these 2)	_NewHandle	;allocate mem for the edit record	bcc GotMem	tax	;xfer error code to	X	jml $FC492A	; let ROM handle errorGotMem	pla	;get handle to mem	sta <RecHandle	;save it	sta 21,s	;and return it	pla	sta <RecHandle+2	sta 21,s	jsr LockRec	lda #0**	ldy #LERecSize**	dey**	dey	ldy #LERecSize-2	;22-Sep-90 DAL (replaced above 3 lines)ZLoop	sta [<RecPtr],y	;zero out record	dey	dey	bpl ZLoop	ldy #leMaxLength	lda 9,s	;get maxtextlen parameter	and #$7FFF	cmp #MaxChars	;make sure it's not too big	bcc OK	lda #MaxCharsOK	sta [<RecPtr],y	tax	; save in x for use below   FIXED SEG 12 Jun 89	jml $FC4901	; jmp back into rom.	LockRec	ldy #4	lda [<RecHandle],y	ora #$8000	;set locked bit in attribute word	sta [<RecHandle],y	ldy #2	lda [<RecHandle]	;dereference handle	sta <RecPtr	lda [<RecHandle],y	sta <RecPtr+2	rts	ENDP****************************************************************** LEClick(EventRecordPtr,LEHandle)** 24-Sep-90	Dave Lyons** This patch checks to see whether we're being called by the* Line Edit Control defproc in ROM 3.  If we are, we call* GetNextEvent to get some nice keyboard modifiers, since the* ROM always tells us all the interesting modifiers were up.* (We use EventMask = 0, so we aren't actually taking an event.)** The Line Edit Control defproc calls us from $fc62e2, and the* real entry point for LEClick is $fc4a97.*****************************************************************LEClick	PROC EXPORT	tax	;save WAP value	lda 4,s	cmp #$62e2+3	bne @toROM	lda 5,s	cmp #$fc62	bne @toROM** We ARE being called from the defproc, so do a GetNextEvent* on the Event Record being passed.*	phx	pha	;space for result	pea 0	lda 19,s	;high word of event record ptr	pha	lda 19,s	;low word of event record ptr (Yes, 19 again)	pha	_GetNextEvent	pla	plx	phd	tsc	tcd	lda #1	;stuff a mouseDown into the What field	sta [<13]	pld@toROM	txa	;restore WAP value to A	jml $fc4a97	EndP****************************************************************** LETextBox** 22-Sep-90	Dave Lyons** Fixed bug in LETextBox where it would remove a random amount* of stuff from the stack on the short-cut exit when Length=0.* Now it always removes 12 bytes.*****************************************************************LETextBox	PROC EXPORT	phx	pha	tax	lda #12	;number of bytes to strip	sta >$00005E,X	pla	plx	jml $fc4f6d	EndP****************************************************************** LEFromScrap** 01 Sep 89	Yee* Fix bug where LEFromScrap would trash a word of memory if the * desk scrap was empty. The word of memory that was trashed was* located $FFFE from where the  line edit scrap is located.*****************************************************************	Export LEFromScrapLEFromScrap	PROC	phd	tcd	PushLong #0	; space for result	PushWord #ScrapType	; type = text	_GetScrapSize	bcs GotErr	plx	pla	bne TooBig	cpx #0	; make sure the desk scrap is not empty	beq Fini		jml $FC509C	; jmp back into regular code pathGotErr	jml $FC50BB	; return error from GetSrapSizeTooBig	jml $FC50A1	; report Desk Scrap too big errorFini	jml $FC576D	; go to StdEnd0	ENDP	END