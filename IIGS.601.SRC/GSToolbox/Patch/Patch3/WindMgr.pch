	title 'Window Mgr Patch   GS ROM 3 Patch'*********************************************************************	Window manager patches for ROM 3** System Disk 5.0** 11 May 89	Mensch** File first created.  Added call table and patch for GetWRefCon.** 21 May 89	Steven Glass** Added patch to TaskMaster and TaskMasterDA to fix bug* in window DefProc.** 22 May 89	Steven Glass** Made TaskMaster patch work better.** 25 May 89	Steven Glass** Removed TaskMaster patch and put it in QD where it belongs.* This makes it possible for tools like scrambler and callcheck* to keep running.** 31 May 89	Harry Yee** Take prototype bit out of version number. Final version = 3.1* for System Disk 5.0.** 01 Jun 89	Harry Yee** Fix WindStartUp. There are times when trying to grow the handle* that it could fail.  Now we get a new handle before calling the* real WindStartUp and then copy the old Data handle into the new,* dispose of the old data handle and then dereference this new* handle updating the Data ptr in the window mgr.** Made sure to update any pointers in the data segment that* pointed into the data segment.** 19 Sep 89	Harry Yee** Patch for TaskMaster which defines another task bit so that* TaskMaster will not call GetNextEvent uses some equates that* have not been defined. These are the equates used to access* values on the stack frame for NewTaskMaster.** 22-Sep-90	Dave Lyons** Rolled version to $8303.* Fixed ErrorWindow to return CLC on no error.** 24-Sep-90	Dave Lyons** Fixed WindStatus to return SEC/A=0 if it's started up but* there's one or more BeginUpdate pending.  (Changed WindStatus,* BeginUpdate, EndUpdate.)** 17-Nov-90	Dave Lyons** Put back all.macros.* Sucked in new AlertWindow from TOOL014 source.** 14-Feb-91	Dave Lyons** Suck in GetAuxWindInfo, DoModalWindow, MWGetCtlPart, MWSetMenuProc,* MWStdDrawProc, MWSetUpEditMenu, FindCursorCtl.** 7?-Mar-91	Dave Lyons** Added patch entry for ResizeInfoBar.** 9-Mar-91	Dave Lyons** Patch ErrorWindow to call SysBeep2.** 25-Mar-91	Dave Lyons** Brought ErrorWindow SysBeep2 logic up to date with Tool014 (calls* SysBeep2($CEFF) for errors outside the 00..FF range).** Patched FindWindow to return window-pointer = nil if the result* is wInMenu.** 12-Apr-91	Dave Lyons** Sucked in HandleDiskInsert from WindMgr:NewCalls.asm.  Changed* WindStartUp to call HandleDiskInsert(1,0) to initialize it.** 18-Apr-91	Dave Lyons** WindStartUp passes flags of $2000 to HandleDiskInsert instead* of $0001 (devices initialized to current status instead of* offline status).** 15-May-91	Dave Lyons** Fix GetSysWFlag/GetWKind(NIL) to always return False.** 20-May-91	Dave Lyons** Made WindStartUp try to load and start QDAux if it isn't* already started, so that AlertWindow can use DrawIcon.** 21-May-91	Dave Lyons** Patched NewWindow2 for color table resource problem--now it* changes handle- and resource-based color table references* into locked+fixed pointers with bit 30 set.  CloseWindow and* SetFrameColor dispose of the 10-byte color table handle if* a standard window's color table pointer's bit 30 is set.** 16-Sep-91	Dave Lyons** Made WindStartUp prelocate the 320 and 640 disk-swap icons* so AlertWindow can avoid a reentrant call to LoadResource.** 12-Dec-91	Dave Lyons** Post-patch Desktop(8) to call SendRequest systemSaysNewDeskMsg* (8), and to free the WM's copy of the old desk message when* it is no longer current.** 5-Feb-92	Dave Lyons** Version $0303 for 6.0 final.********************************************************************* 17-Feb-92	Dave Lyons** Version $8304 for 6.0.1d1.** Make WindStartUp do a BlockMove of a valid number of bytes* from the old data handle to the new handle (it was moving* garbage, which Big Brother traps on).  Moves $01F2 instead* of $02D1.** 6-Mar-92	Dave Lyons** Add UpdateWindow call.** 1-Dec-92	Dave Lyons** Changed TaskMaster patch to make tmNoGetNextEvent work.  It* jumped back into ROM too early and treated the bit as reserved.* In 5.0.3, 5.0.4, and 6.0 this bit works on ROM 1 only.** 2-Apr-93 DAL** Version $0304 for 6.0.1.************************************************************************************************************************************			   **              Copyright (C) 1989-1992		   **              All Rights Reserved		   **              Apple Computer, Inc.		   **			   *****************************************************************	Blanks off	String asis		include 'all.macros'	include ':::windMgr:WindMgrEquates.asm'WindVersionNum	equ $0304	;2-Apr-93 DALToStrip	equ $E10184	; Jmp vector to 0ErrOut routineSkipNormalStuffROM	equ $FD26BE	; for the taskmaster patch	;----------------------------------------------------------------; Routines needed by the patch file from the main window manager; code	Import GetwRefCon	import AlertWindow	entry WindowUpdateCount	Entry NewTaskMaster	Entry GetFrameColor	Entry NewStartup	ENTRY WindVersion	Entry ErrorWindow	;22-Sep-90 DAL	Entry BeginUpdate	;24-Sep-90 DAL	Entry EndUpdate	;24-Sep-90 DAL	Entry WindStatus	;25-sep-90 DAL	entry GrowWindow	;26-Nov-90 DAL	entry CloseWindow	;28-Feb-91 DAL	import GetAuxWindInfo	;14-Feb-91 DAL	import DoModalWindow	;14-Feb-91 DAL	import MWGetCtlPart		;14-Feb-91 DAL	import MWSetMenuProc	;14-Feb-91 DAL	import MWStdDrawProc	;14-Feb-91 DAL	import MWSetUpEditMenu	;14-Feb-91 DAL	import FindCursorCtl	;14-Feb-91 DAL	import ResizeInfoBar	; 5-Mar-91 DAL	entry FindWindow		;25-Mar-91 DAL	import HandleDiskInsert	;12-Apr-91 DAL	entry GetWKind2		;15-May-91 DAL	entry NewWindow2		;21-May-91 DAL	entry SetFrameColor		;21-May-91 DAL	entry Desktop		;12-Dec-91 DAL	import UpdateWindow		;6-Mar-92 DAL	WMCallTable	PROC EXPORT	EXPORT FPTFPT	DC.W (ENDFPT-FPT)/4	DC.W 0	dc.L 0	; WindBootInit $010E	dc.L NewStartup-1	; WindStartup $020E	dc.L 0	; WindShutDown $030E	dc.L WindVersion-1 	; $040E	dc.L 0	; WindReset $050E	dc.L WindStatus-1	; $060E	dc.L 0	; Reserved $070E	dc.L 0	; Reserved $080E	dc.L 0	; NewWindow $090E	dc.L 0	; CheckUpdate $0A0E	dc.L CloseWindow-1	; $0B0E (patched 28-Feb-91 DAL)	dc.L Desktop-1	; $0C0E (patched 12-Dec-91 DAL)	dc.L 0	; SetWTitle $0D0E	dc.L 0	; GetWTitle $0E0E	dc.L SetFrameColor-1 ; SetFrameColor $0F0E patched 21-May-91 DAL	dc.L GetFrameColor-1 ; GetFrameColor $100E	dc.L 0	; SelectWindow $110E	dc.L 0	; HideWindow $120E	dc.L 0	; ShowWindow $130E	dc.L 0	; SendBehind $140E	dc.L 0	; FrontWindow $150E	dc.L 0	; SetInfoDraw $160E	dc.L FindWindow-1	; $170E (patched 25-Mar-91 DAL)	dc.L 0	; TrackGoAway $180E	dc.L 0	; MoveWindow $190E	dc.L 0	; DragWindow $1A0E	dc.L GrowWindow-1	;            $1B0E	dc.L 0	; SizeWindow $1C0E	dc.L NewTaskMaster-1 ; $1D0E	dc.L BeginUpdate-1	; $1E0E	dc.L EndUpdate-1	; $1F0E	dc.L 0	; GetWMgrPort $200E	dc.L 0	; PinRect $210E	dc.L 0	; HiliteWindow $220E	dc.L 0	; ShowHide $230E	dc.L 0	; BringToFront $240E	dc.L 0	; WNewRes $250E	dc.L 0	; TrackZoom $260E	dc.L 0	; ZoomWindow $270E	dc.L 0	; SetWRefCon $280E	dc.L GetWRefCon-1	; GetWRefCon $290E	dc.L 0	; GetNextWindow $2A0E	dc.L GetWKind2-1	; GetWKind $2B0E patched 15-May-91 DAL	dc.L 0	; GetWFrame $2C0E	dc.L 0	; SetWFrame $2D0E	dc.L 0	; GetStructRgn $2E0E	dc.L 0	; GetContRgn $2F0E	dc.L 0	; GetUpdateRgn $300E	dc.L 0	; GetDefProc $310E	dc.L 0	; SetDefProc $320E	dc.L 0	; GetWControls $330E	dc.L 0	; SetOrgnMask $340E	dc.L 0	; GetInfoRefCon $350E	dc.L 0	; SetInfoRefCon $360E	dc.L 0	; GetZoomRect $370E	dc.L 0	; SetZoomRect $380E	dc.L 0	; Refresh $390E	dc.L 0	; InvalRect $3A0E	dc.L 0	; InvalRgn $3B0E	dc.L 0	; ValidRect $3C0E	dc.L 0	; ValidRgn $3D0E	dc.L 0	; GetCOrigin $3E0E	dc.L 0	; SetCOrigin $3F0E	dc.L 0	; GetDataSize $400E	dc.L 0	; SetDataSize $410E	dc.L 0	; GetMaxGrow $420E	dc.L 0	; SetMaxGrow $430E	dc.L 0	; GetScroll $440E	dc.L 0	; SetScroll $450E	dc.L 0	; GetPage $460E	dc.L 0	; SetPage $470E	dc.L 0	; GetCDraw $480E	dc.L 0	; SetCDraw $490E	dc.L 0	; GetInfoDraw $4A0E	dc.L 0	; SetSysWindow $4B0E	dc.L GetWKind2-1	; GetSysWFlag $4C0E patched 15-May-91 DAL	dc.L 0	; StartDrawing $4D0E	dc.L 0	; SetWMgrIcons $4E0E	dc.L 0	; GetRectInfo $4F0E	dc.L 0	; StartInfoDraw $500E	dc.L 0	; EndInfoDrawing $510E	dc.L 0	; GetFirstWindow $520E added to version $8104	dc.L 0	; WindDragRect $530E	dc.L 0	; GetDragRect $540E not public.	dc.L 0	; DrawInfoBar $550E	dc.L 0	; WindowGlobal $560E added 02/19/87	dc.L 0	; SetCOrigin2 $570E added 04/07/87	dc.L 0	; GetWindowMgrGlobals $580E added 03/08/88	dc.L AlertWindow-1	dc.L 0	; StartFrameDrawing $5A0E added 03/15/88	dc.L 0	; EndFrameDrawing $5B0E added 03/15/88	dc.L 0	; ResizeWindow $5C0E added 03/15/88	dc.L 0	; TaskMasterContent $5D0E  added 22 Sep 88  SEG	dc.L 0	; TaskMasterKey $5E0E  added 28 Sep 88  SEG	dc.L 0	; TaskMasterDA-1	; $5F0E  added 02 Oct 88  SEG	dc.L 0	; CompileString $600E added 10/20/88 Dan O.	dc.L NewWindow2-1	; NewWindow2 $610E patched 21-May-91 DAL	dc.L ErrorWindow-1	; ErrorWindow patch 22-Sep-90 DAL*** 6.0	dc.l GetAuxWindInfo-1	;$630E added 14-Feb-91 DAL	dc.l DoModalWindow-1	;$640E added 14-Feb-91 DAL	dc.l MWGetCtlPart-1		;$650E added 14-Feb-91 DAL	dc.l MWSetMenuProc-1	;$660E added 14-Feb-91 DAL	dc.l MWStdDrawProc-1	;$670E added 14-Feb-91 DAL	dc.l MWSetUpEditMenu-1	;$680E added 14-Feb-91 DAL	dc.l FindCursorCtl-1	;$690E added 14-Feb-91 DAL	dc.l ResizeInfoBar-1	;$6A0E added  5-Mar-91 DAL	dc.l HandleDiskInsert-1	;$6B0E added 12-Apr-91 DAL*** 6.1	dc.l UpdateWindow-1		;$6C0E added 6-Mar-92 DAL	EXPORT ENDFPTENDFPT 	ENDP********************************************************** WindVersion patch*********************************************************WindVersion	PROC	lda #WindVersionNum	sta 7,s	lda #0	clc	rtl		ENDP********************************************************** NewWindow2 patch for ROM 3 -- 21-May-91 DAL** The ROM can't handle window color table handles, so* if the color table is referenced by handle or resource* we need to make a copy of the template and do an* equivalent NewWindow2 call with a by-pointer copy of* the color table.*********************************************************;==================================================================;	Create window from new template.;	it can be fetched from a resource or be passed;	by pointer or handle.;; Modified 12-dec-88 Mensch;    Added support for input verbs so that NewWindow2 can use ptrs;      and handles. Added Input verb to passed parms and template;==================================================================;;   IN:  PUSH:LONG - space for result.;        PUSH:LONG - window title.;        PUSH:LONG - refCon.;        PUSH:LONG - address of content draw routine, NIL if none.;        PUSH:LONG - address of window defProc, NIL for standard.;        PUSH:WORD - input verb defines what next long word is.;        PUSH:LONG - ID of resource that is window parameter table template.;        PUSH:WORD - type of resource that is window parameter table template.;;  OUT:  LONG - pointer to window graphPort, NIL if window not created.;NewWindow2	PROC EXPORT;; --- New window parameter list offsets.;p_length	equ 0	Number of bytes in parameter list.p_wframe	equ p_length+2	Type of window, frame flags.p_wtitle	equ p_wframe+2	Pointer to window's title.p_wrefCon	equ p_wtitle+4	Reserved for application.p_wfull	equ p_wrefCon+4	Size of window, used with ZoomWindow.p_wcolor	equ p_wfull+8	Pointer to window's color table.p_y_origin	equ p_wcolor+4	Content's vertical offset.p_x_origin	equ p_y_origin+2	Content's horizontal offset.p_data_h	equ p_x_origin+2	Height of total data area.p_data_w	equ p_data_h+2	Width of total data	area.p_wmaxheight	equ p_data_w+2p_wmaxwidth	equ p_wmaxheight+2p_vscroll	equ p_wmaxwidth+2	Amount to scroll vertically (arrows).p_hscroll	equ p_vscroll+2	Amount to scroll horizonally (arrows).p_vpage	equ p_hscroll+2	Amount to page vertically (page region).p_hpage	equ p_vpage+2	Amount to page horizontally (page rgn).p_wInfoText	equ p_hpage+2p_wInfoH	equ p_wInfoText+4	Height of infomation bar.p_wdefProc	equ p_wInfoH+2	NOT USED.p_wInfoDraw	equ p_wdefProc+4	Address of routine to draw Info Bar.p_updateDraw	equ p_wInfoDraw+4	Address of routine to draw content region.p_position	equ p_updateDraw+4p_behind	equ p_position+8p_windrec	equ p_behind+4	control template p_wInVerbs	equ p_windrec+4	Input verbs describing title,color tbl, and ctl templatep_size	equ p_wInVerbs+2;;; --- Resource types.;rPString	equ $8006rWindParam1	equ $800ErWindParam2	equ $800FrWindColor	equ $8010;;; --- Input verbEquatesresIDVAsPtr	equ 0resIDVAsHandle	equ 1resIDVAsResource	equ 2;; --- parmameter template verb word equates; the first byte is the same as the verb for NewControl2 calltitleAsPtr	equ $0000titleAsHandle	equ $0100titleAsResource	equ $0200colorAsPtr	equ $0000colorAsHandle	equ $0400colorAsResource	equ $0800;;; --- Direct page offsets.;@ID	equ 1@hand	equ @ID+4@ptr	equ @hand+4@paramPtr	equ @ptr+4@memoryID	equ @paramPtr+4;@saveDbank	equ @memoryID+2@saveDpage	equ @saveDbank+1@retAddrs	equ @saveDpage+2@resType	equ @retAddrs+6@resID	equ @resType+2@resIDVerb	equ @resID+4	; added 12/12/88 Mensch@defProc	equ @resIDVerb+2@contentDraw	equ @defProc+4@refCon	equ @contentDraw+4@title	equ @refCon+4@result	equ @title+4;	jsl IncBusyFlg	phd	;Save caller's direct page pointer.	phb	;Save caller's data bank pointer.;	phk	;Switch data bank to program bank.	plb;	tcd	;Switch to Window Manager's direct page.;	tsc	pei <MyID	;Put memory ID on my page.;	sec	;Switch direct page into stack.	sbc #@saveDbank-1	tcs	tcd;	stz <@result	;Start with no window, just in case.	stz <@result+2;;; --- Test InputVerb to determine the method of parm passing;	lda <@resIDVerb	;get the passed verb	cmp #resIDVAsResource	beq @ResIDIsRes	;If passed as resource, go load it ; if neither of these, then passed by handle or pointer, first allocate temp storage; to copy the users template into	lda #p_size	;template size.	ldy <@memoryID	ldx #$8000	;pass attributes in <X> (Locked)	jsr allocate3	;Allocate memory for template.	sta <@hand	stx <@hand+2	lda [<@hand]	;deref the handle now...	tax	ldy #2	lda [<@hand],y	sta <@ParamPtr+2	stx <@ParamPtr	lda <@resIDVerb	;get the res ID verb again	beq @ResIDIsPtr	;if pointer, then pass it...; if it gets here the user passed us a handle, so copy the data now...	pei <@resID+2	;Pass handle to copy from	pei <@resID	pei <@ParamPtr+2	;pass the handle to copy to	pei <@ParamPtr	pea $0000	;now pass the size	pea p_size	;to copy	_handToPtr	brl @TD0010;; --- New template ref was passed by pointer, so just copy the pointer;@ResIDIsPtr	pei <@ResID+2	;pointer to the source parm block	pei <@ResID	pei <@paramPtr+2	;pointer to destination	pei <@paramPtr	pea $0000	pea p_size	_BlockMove	;copy the data	bra @TD0010	;and continue; ; --- Load new window parameter table resource.;@ResIDIsRes	pha	;Space for result.	pha	pei <@resType	;Pass type.	pei <@resID+2	;Pass ID.	pei <@resID	_LoadResource	tay	;Possible error code in y.	plx	stx <@paramPtr	plx	stx <@paramPtr+2	bcc @ok2	;Error?@toExit2	brl @exit2	;Error.@ok2;; Now, take the handle from resource mgr or passed by app and dereference it.@TemplateDeref	ldy #4	;Lock parameter table.	lda [<@paramPtr],y	ora #$8000	sta [<@paramPtr],y	dey	;Dereference the table.	dey	lda [<@paramPtr],y	tay	lda [<@paramPtr]	sta <@paramPtr	sty <@paramPtr+2@TD0010;;; --- Fix up parameter table.;	lda <@resType	;Which kind of parameter table?	cmp #rWindParam1	beq @doParam1;	jsr @fixParam2	bra @done1;@doParam1	jsr @fixParam1@done1	tya	;Place possible error code in A.	bcs @errOut	;Error?;;; --- Have NewWindow create the window.;; First adjust parameter list count back to new window size...	lda [<@paramPtr]	;remove the input verb from the parm count	dec a	dec a	sta [<@paramPtr]	pha	;Save for result.	pha	pei <@paramPtr+2	;Pass pointer to parameter table.	pei <@paramPtr	_NewWindow	ply	;Return window pointer.	sty <@result	ply	sty <@result+2	bcc @skip1	;Error? a = error code if any.;@errOut	pha	;Save error code.;	lda <@resType	;Free items allocated by me.	cmp #rWindParam1	bne @skip3	;Only for parameter table type 1.;	ldy #p_wtitle+2	;Free title if there is one.	jsr @freeField;	ldy #p_wcolor+2	;Free the color table if there is one.	jsr @freeField;@skip3	pla	;Restore error code.;;; --- Free parameter table.;@skip1	pha	;Save error code.;	lda <@resIDVerb	;get the passed verb	cmp #resIDVAsResource	beq @DumpRes	;If passed as resource, release it...; If not a resource, then I made a copy of the passed param block and I should ; dispose of it right now...	pha	;room for result	pha	pei <@paramPtr+2	;first get the handle back for the temp parm block	pei <@paramPtr	_FindHandle	;get the handle back	_DisposeHandle	;and get rid of it.	bra @MkCtrls;@DumpRes	pea $FFFF	;Pass 'dispose' flag.	pei <@resType	;Pass type.	pei <@resID+2	;Pass ID.	pei <@resID	_ReleaseResource;;; --- Create controls in window. Use the low order byte of the wInVerb as the;     input verb for this call.;@MkCtrls	lda <@ID	;Is there a control list?	ora <@ID+2	beq @skip2;	lda <@result	;Was a window created?	ora <@result+2	beq @skip2;	pha	;Space for result.	pha	pei <@result+2	;Pass window owner.	pei <@result	ldy #p_wInVerbs	;load the offset to the template verbs	lda [<@paramPtr],y	;load in the input verb	and #$00FF	;strip off the high byte, low byte for this call	pha	;and pass it as inputverb for NewControl2	pei <@ID+2	;Pass ID of item list.	pei <@ID	_NewControl2	plx	;Don't need result.	plx	bcc @skip2	;Error?	sta 1,s	;Replace saved error code with error from NewControl2.;@skip2	ply	;Restore error code from NewWindow.;;; --- Clean up stack and exit.;      mod 12/12/88 pull off 24 bytes parameter. Mensch;@exit2	tsc	;Free allocated direct page.	clc	adc #@saveDbank-1	tcs	ldx #24	;Number of bytes to pop.	jml $fd9001	;"shutDown" in ROM 3@desIndex	dc.w p_wrefCon,p_wdefProc,p_updateDraw@srcIndex	dc.w @refCon,@defProc,@contentDraw;-----------------------------------------------;        Free handle in parameter table.;-----------------------------------------------;;   IN: y = index to high word of field.  If highest bit set it is a handle to free.;@freeField	lda [<@paramPtr],y	bpl @exit100;	and #$00FF	pha	dey	dey	lda [<@paramPtr],y	pha	_DisposeHandle@exit100	rts;;;---------------------------------------------------------------------;	Fix up parameter table type 1.;-200-----------------------------------------------------------------;;  OUT:  Carry set if error, y = error code.;        <@ID = ID of control list, NIL if none.;@fixParam1	stz <@ID	;Start with no controls.	stz <@ID+2;;; --- Set window title in table.;	lda <@title	;Was a title passed?	ora <@title+2	beq @loadTitle	;Use the passed title if there is one.;;; ------ Clone the given title.;@Clonetitle	lda [<@title]	;Compute size of string,	and #$00FF	inc a	;including length byte.	pha	;Save size.	ldy <@memoryID	jsr allocate1	;Allocate fixed memory for title.	sta <@hand	stx <@hand+2;	ply	;Restore size of string.;	pei <@title+2	;Pass source pointer.	pei <@title	phx	;Pass destination handle.	pha	pea 0	;Pass number of bytes to move.	phy	_PtrToHand	;Clone title.;	ldy #p_wtitle	;Store handle of title.	lda <@hand	sta [<@paramPtr],y	iny	iny	lda <@hand+2	ora #$8000	;Set bit that states this is a handle.	sta [<@paramPtr],y	brl @noTitle;;; ------ Load title from wherever.;@loadTitle	ldy #p_wtitle+2	;Is there a title in the template?	lda [<@paramPtr],y	tax	dey	dey	ora [<@paramPtr],y	beq @noTitle;	ldy #p_wInVerbs	;get the input verbs	lda [<@paramPtr],y		tay	;and save em for a second	and #titleAsResource	bne @LoadTByRes	;if by resource load it	tya	and #titleAsHandle	bne @LoadTByHandle	ldy #p_wtitle+2	lda [<@paramPtr],y	;load the pointer	sta <@title+2	;save it in the string pointer field	dey	dey	lda [<@paramPtr],y	sta <@title	brl @Clonetitle	;now create a buffer and copy the title@LoadTByHandle	ldy #p_wtitle+2	lda [<@paramPtr],y	;load the pointer	sta <@title+2	;save it in the string pointer field	dey	dey	lda [<@paramPtr],y	sta <@title	ldy #2	lda [<@title],y	tay	lda [<@title]	sta <@title	sty <@title+2	brl @Clonetitle@LoadTByRes	ldy #p_wtitle		pha	;Space for result.	pha	pea rPString	;Pass type.	phx	;Pass ID.	lda [<@paramPtr],y	pha	sta <@ID	;Remember ID.	stx <@ID+2	_LoadResource	tay	;Posible error code.	pla	plx	bcc @ok200	;Error?@errOut200	rts	;Error.@ok200;	ldy #p_wtitle	;Store handle of title.	sta [<@paramPtr],y	iny	iny	txa	ora #$8000	;Set bit that states this is a handle.	sta [<@paramPtr],y;	pea rPString	;Pass type.	pei <@ID+2	;Pass ID.	pei <@ID	_DetachResource	;Unlink the title handle from resource.;@noTitle;;; --- Set window color table pointer in table.;	ldy #p_wcolor+2	;Is there a color table resource?	lda [<@paramPtr],y	tax	dey	dey	ora [<@paramPtr],y	bne @LCT0005	brl @noColor;@LCT0005	ldy #p_wInVerbs	;get the input verbs	lda [<@paramPtr],y		and #colorAsResource	bne @LoadCByRes	;if by resource load it@ColorTableHandle	;come back here when creating by resource;; If not passed by resource ID we will have to make a copy of the color table; so first create a handle	lda #$0000	pha	;room for result	pha	pha	;zero for high word of size	pea $000A	;room for a color table	pei <@memoryID***	pha	;zero for attributes	pea $c000	;locked and fixed! (21-May-91 DAL)	pha	;no specific location	pha	_NewHandle	;allocate the space 	tay	;Possible error code.	pla	sta <@ID	;save the handle for a sec...	pla	sta <@ID+2	bcs @errOut200	;Error?	ldy #p_wcolor+2	;push ref of the color table.	lda [<@paramPtr],y	pha	dey	dey	lda [<@paramPtr],y	pha	pei <@ID+2	;address to copy to	pei <@ID	pea $0000	;size to copy	pea $000A;; Now that the parms are set up properly, let's copy the right way depending on; the input verb;	ldy #p_wInVerbs	;get the input verbs	lda [<@paramPtr],y	***	and #colorAsHandle	and #colorAsHandle+colorAsResource	;21-May-91 DAL	bne @LoadCByHandle	_PtrToHand	;copy the data from ptr to our handle	bra @LCT0020;@LoadCByHandle	_HandToHand	;copy the data from handle to handle@LCT0020*** 21-May-91 DAL -- deref ID into pointer	ldy #2	lda [<@ID],y	tay	lda [<@ID]	sta <@ID	sty <@ID+2*** end of 21-May-91	ldy #p_wcolor+2	;offset to high word of color table	lda <@ID+2	;high byte of our handle***	ora #$8000	;set high bit to indicate by handle	ora #$4000	;set bit 30: ptr that we need to dispose (21-May-91 DAL)	sta [<@paramPtr],y	dey	dey	lda <@ID	sta [<@paramPtr],y	bra @noColor@LoadCByRes	ldy #p_wcolor	pha	;Space for result.	pha	pea rWindColor	;Pass type.	phx	;Pass ID.	lda [<@paramPtr],y	pha	sta <@ID	;Remember ID.	stx <@ID+2	_LoadResource	tay	;Possible error code.	pla	plx	bcc @okByRes	brl @errOut200	;Error.*** added 21-May-91 DAL -- treat color table resource just like handle@okByRes	ldy #p_wcolor	sta [<@paramPtr],y	txa	iny	iny	sta [<@paramPtr],y	brl @ColorTableHandle*** end of 21-May-91 DAL;@LCT0030;	ldy #p_wcolor	;Store handle of the color table.;	sta [<@paramPtr],y;	iny;	iny;	txa;	ora #$8000	;Set bit that states this is a handle.;	sta [<@paramPtr],y;;	pea rWindColor	;Pass type.;	pei <@ID+2	;Pass ID.;	pei <@ID;	_DetachResource	;Unlink color table handle from resource.@noColor;;; --- Store passed values in parameter table.;	ldx #4@lop200	phx	ldy |@desIndex,x	lda |@srcIndex,x	tax	lda <0,x	sta [<@paramPtr],y	iny	iny	lda <2,x	sta [<@paramPtr],y	plx	dex	dex	bpl @lop200;; --- Get ID of control list.;	ldx #0	ldy #p_windrec	lda [<@paramPtr],y	;Get the ID of the window's control list.	sta <@ID	txa	sta [<@paramPtr],y	;Clear the windRec field also, window record to be 	iny	;allocated.	iny	lda [<@paramPtr],y	sta <@ID+2	txa	sta [<@paramPtr],y	clc	;No error.	rts;---------------------------------------------------------------------;	Fix up parameter table type 2.;-300-----------------------------------------------------------------;;  OUT:  Carry set if error, y = error code.;        <@ID = ID of control list, NIL if none.;@fixParam2;; --- New parameter	list offsets -----------------------------;@paramID	equ 0	;ID of parameter list.@newDefProc	equ @paramID+2	;DefProc of window.@newData	equ @newDefProc+4	;Additional data for new window.	stz <@ID	;No control list.	stz <@ID+2	ldy #@newDefProc	;Store address of defProc.	lda <@defProc	sta [<@paramPtr],y	iny	iny	lda <@defProc+2	sta [<@paramPtr],y	clc	;No error.	rts;==========================================================================;;          Allocate	a block of memory.;;   IN:    y = ID number.;          a = number of bytes.;;  OUT:    Carry clear if handle allocated, a+x = handle.;          Carry set if error, y = error returned by Memory	Manager.;;==========================================================================allocate1	ldx #0	Anywhere, anyhow.	bra allocate3	EXPORT allocate2allocate2	ldx #%0100000000010000 Fixed, May not cross bank boundary.; = = = = = = = = =	= = = = = = = = = =	= = = = =;          Allocate	a block of memory.; = = = = = = = = =	= = = = = = = = = =	= = = = =;;   IN:    y = ID number.;          x = attributes.;          a = number of bytes.;;  OUT:    Carry clear if handle allocated, a+x = handle.;          Carry set if error, y = error returned by Memory	Manager.;allocate3	pha	Space for returned handle.	pha	pea 0	High word of size.	pha	Pass low word of size.	phy	Pass ID number.	phx	Pass attributes.	pha	Address doesn't matter.	pha	_NewHandle	tay	Return error code in Y.	pla	Return handle in a+x.	plx		rts	EndP********************************************************** ErrorWindow patch** 22-Sep-90 DAL (new patch)** Just need to make the carry be clear on exit if there* was no error.  (The ROM is doing a CMP #0 when it meant* to CMP #1, so the carry is always being returned set.)*********************************************************ErrorWindow	PROC;; 9-Mar-91 DAL -- call SysBeep2 if the error code is 0..FF; (25-Mar-91 DAL: sucked in the $CEFF thing from WindMgr.asm);errorNum	equ 7	;stack-relative	lda errorNum,s	and #$ff00	beq @inRange	lda #$CEFF	bra @thisBeep@inRange	lda errorNum,s	ora #$CE00	;default silent, defer to GNE, beep $0Exx@thisBeep	pha	_SysBeep2; push a copy of the passed parameters	ldx #5	;5 words to push (including result space)@pushParms	lda 15,s	pha	dex	bne @pushParms		jsl ToROMErrorWindow	tax	;error code	pla	;result: Button number	sta 15,s	ldy #8	;strip 8 bytes	jml $e10184	;ToStrip (error code in X)ToROMErrorWindow	jsl $fd385e	;doesn't need A/X/Y!	rtl	EndP********************************************************** CloseWindow patch** 28-Feb-91 DAL (new patch)** Pre-patch to kill the AuxWindInfo record for this* window, if any.*********************************************************CloseWindow	proc	import KillAuxInfoRecord	import KillColorTable	phd	;save caller's direct page	tcd	;and use ours	lda 11,s	ora 9,s	beq @nil	lda 11,s	pha	lda 11,s	pha	jsl KillAuxInfoRecord*** added 21-May-91 DAL	lda 11,s	pha	lda 11,s	pha	jsr KillColorTable*** end of 21-May-91 DAL@nil	tdc	;get direct page back in A	pld	;restore caller's direct page	jml $fd13ff	;ROM 3 CloseWindow	EndP********************************************************** Desktop patch** 12-Dec-91 DAL (new patch)** Post-patch Desktop(8) (new desk message) to call* SendRequest(systemSaysNewDeskMsg) (reqcode 8).** Also, dispose of old desktop pic/patt handle if* it changes.** Stack:*  1,s = rtl*  4,s = rtl*  7,s = param (long)* 11,s = message (word)* 13,s = result space (long, optional)** The result space is used when message = 2, 3, 4.*********************************************************;deskPatt	equ $92	;on WM direct pageDesktop	proc	tax	bne @started	lda #2	sec	rtl@started	sta >windDirPage	lda >deskPatt+2,x	sta >oldDeskPatt+2	lda >deskPatt,x	sta >oldDeskPatt	ldy #5@copyWord	lda 15,s	pha	dey	bne @copyWord	txa	jsl @toROM	sta >error	plx	;x = result low	ply	;y = result high	lda 11,s	cmp #2	bcc @noResult	cmp #4+1	bcs @noResult	txa	sta 13,s	tya	sta 15,s@noResult*** If old desk patt was a handle & it changed, dispose it.	lda >windDirPage	tax	lda >deskPatt,x	cmp >oldDeskPatt	bne @changed	lda >deskPatt+2,x	cmp >oldDeskPatt+2	beq @noChange@changed	lda >oldDeskPatt+2	and #$ff00	cmp #$0100	bne @notHandle	lda >oldDeskPatt+2	and #$00ff	pha	lda >oldDeskPatt	pha	_DisposeHandle@notHandle@noChange*** If this was a Desktop(8), inform everyone with SendRequest	lda 11,s	cmp #8	bne @notNewMess	pha	;reqCode = 8 = systemSaysNewDeskMsg	ldx #0	phx	;sendToAll	phx	phx	;target=NIL	phx	phx	;dataIn=NIL	phx	phx	;dataOut=NIL	_SendRequest@notNewMess	lda >error	tax	ldy #6	jml $e10184	;ToStrip@toROM	jsl $fd0924	rtlerror	dc.w 0oldDeskPatt	dc.l 0windDirPage	dc.w 0	EndP********************************************************** SetFrameColor patch** 21-May-91 DAL (new patch)** Pre-patch SetFrameColor to kill the old color table,* if it's a standard window and the color table pointer* has bit 30 set.** SetFrameColor(@ColorTable,@Window)** Note: Since we never documented anything about using* SetFrameColor with bit 31 set to indicate a handle,* I'm not going to try to support it, even though it* works on ROM 1.*********************************************************SetFrameColor	proc	import KillColorTable	pha	lda 11,s	pha	lda 11,s	pha	jsr KillColorTable	pla	jml >$fd10e0	;original SetFrameColor in ROM	EndP********************************************************** KillColorTable routine -- used by CloseWindow and*                           SetFrameColor** 21-May-91 DAL** Input: window pointer on stack (removed on exit).* Call by JSR.** If the window is a *standard* window and it has a* color table pointer with bit 30 set, then we must* FindHandle/DisposeHandle it and set the field to 0.*********************************************************KillColorTable	proc	phd	tsc	tcd@wind	equ 5	;direct page	lda <@wind+1	beq @boring	;NIL	ldy #$AA+1	;check middle word of defproc	lda [<@wind],y	cmp #$fd43	;standard = $fd4352 on ROM 3	bne @boring	ldy #$E0+2	lda [<@wind],y	asl a	bpl @boring	;bit 30 was clear	pha	pha	;space for FindHandle	lda [<@wind],y	and #$00ff	pha	dey	dey	lda [<@wind],y	pha	_FindHandle	_DisposeHandle	lda #0	ldy #$E0+2	sta [<@wind],y	dey	dey	sta [<@wind],y@boring	pld	plx	pla	pla	;kill input window pointer	phx	;restore return address	rts	EndP	EJECT********************************************************************************WMgrJsrGlue	PROC** Description:	These glue routines will be used to call window manager routines*	that are in ROM and end in an rts. This can be used for making*	the patch files smaller.*** Inputs:	<A> Address of the routine to jump to in the window manager's*	bank.** Outputs:	None** External Refs:** Entry Points:********************************************************************************aWindowRTL	equ $FD0392	; an RTL in the window manager bankCallProcRtn	equ $FD11C9	; call proc glue routinePop8Bytes	equ $FD8FC3	; pop 8 bytes from the stack		Entry CallProcGlueCallProcGlue	pea <aWindowRTL-1	; push the low word of an RTL on the stack	jml CallProcRtn	; call the setup routine		Entry Pop8BytesGluePop8BytesGlue	jml Pop8Bytes	EndP	EJECT********************************************************************************Setup	PROC** Description:*** Inputs:	None** Outputs:	None** External Refs:** Entry Points:********************************************************************************;;=======================================================;        Switch to Window Manager's zero page,;        and put input parameters into zero page.;=======================================================;;  IN:   a = zero page to switch to.;;	jsl IncBusyFlg	plx	Get return address.	phd	Save current zero page pointer.	phx	Put return address back on stack.	tcd	Switch to Window Manager's zero page.	ENTRY pullparamspullparams	lda 15,s	Pull second to last	input parameter.	sta <workptr	lda 17,s	sta <workptr+2	ENTRY pullparampullparam	lda 13,s	Pull last input parameter.	tax	lda 11,s	ENDP;============================================;          Compute window pointer;          from port pointer.;============================================;;   IN:    a = low word of port pointer.;          x = high	word of port pointer.;;  OUT:    wind = window pointer.;          a = low word of window pointer.;          x = high	word of window pointer.;          y = trashed.;	EXPORT get_wptrget_wptr	PROC	tay	bne ok1	Null pointer?	txy	beq store1ok1	sec	sbc #wport	Compute pointer to window record	bcs store1	from pointer to window's port.	dexstore1	sta <wind	stx <wind+2	rts	ENDP	EJECT********************************************************************************NewStartup	PROC** Description:	This routine will postpatch the window mgr startup call*	so that the window globals area can be grown********************************************************************************;WindStartup StackOldDPage	equ 1NewDataHandle	equ OldDPage+2RTL1	equ NewDataHandle+4RTL2	equ RTL1+3theID	equ RTL2+3pSize	equ 2RomStartup	equ $FD018C	; address of the old startup call	lda #0		;added 24-Sep-90 DAL	sta >WindowUpdateCount	;added 24-Sep-90 DAL*** added 16-Sep-91 DAL -- pre-locate the disk-swap icons	import DiskSwap640Hndl,DiskSwap320Hndl	pha	pha	pea $8001	;rIcon	pea $07ff	pea $0006	;disk-swap 640	_LoadResource	pla	sta >DiskSwap640Hndl	pla	sta >DiskSwap640Hndl+2	pha	pha	pea $8001	;rIcon	pea $07ff	pea $0106	;disk-swap 320	_LoadResource	pla	sta >DiskSwap320Hndl	pla	sta >DiskSwap320Hndl+2*** end 16-Sep-91*** added 12-Apr-91 DAL -- initialize HandleDiskInsert	pha	pha	pea $2000	;18-Apr-91 DAL -- init everything to current status	pea 0	_HandleDiskInsert	pla	pla*** end of 12-Apr-91 DAL*** added 20-May-91 DAL -- try to load and start QDAux if it isn't already here	pea 0	_QDAuxStatus	pla	bne @haveQDAux	pea $0012	;tool set = QDAux	pea $0304	;version = 3.4	_LoadOneTool	_QDAuxStartUp@haveQDAux*** end of 20-May-91 DAL	pha	; make room on the stack for new data handle	pha	phd	; save the users dpage	tsc	tcd	; use the stack as a dpage		pha	; space for result	pha	PushLong #RAMSIZE	pei theID	pea $4010	; Fixed, May not cross bank boundary	pha	; Address doesn't matter	pha	_NewHandle	bcc Ok	plx	plx	brl ErrorOk	pla	sta NewDataHandle	pla 	sta NewDataHandle+2	lda #0	pei theID	jsl StartupGlue	bcs Error		pha	_DoWindows	; get our dpage 	pld	; Now push the handle to our data area on stack	pha	pha	pei <Data+2	pei <Data	_FindHandle	; find handle to window mgr's data area	lda 3,s	; save extra copy of data handle so we can dispose	pha	; of it after making a copy of the data in it	lda 3,s	pha	lda 13,s	; get handle into which data will be copied into	sta <Data+2	; get new handle into Data so we can use it to	pha	; to deref in	lda 13,s	sta <Data	pha*** 17-Feb-92 DAL -- RAMSIZE is too big; only move the amount of data in the old handle.;;;	PushLong #RAMSIZE	pea 0	pea $01F2	;size of old data*** end 17-Feb-92	_HandToHand	_DisposeHandle	; get rid of old Data handle	ldy #2	lda [<Data],y ; dereference new data area and update 	tax	  ; window manager's data ptr	lda [<Data]	sta <Data	stx <Data+2;; Now we must reinitialize some of the data in our new data segment because; they are pointers to within this data segment.; 	lda #scInfo	; address to calculate	ldy #scrn2scrn+PP_SrcInfo ; where to store address	jsr GetAndStoreAddress	lda #scInfo	ldy #scrn2scrn+PP_DesInfo	jsr GetAndStoreAddress	lda #blitsrc	ldy #scrn2scrn+PP_SrcRect	jsr GetAndStoreAddress	lda #blitdes	ldy #scrn2scrn+PP_DesRect	jsr GetAndStoreAddress	lda #fontHandle	ldy #windIconFont	jsr GetAndStoreAddress		lda #0	; no error; Now that we are done, clean up and returnError	tax	; save the error in <X>	lda RTL1+4,s	sta RTL1+4+pSize,s	lda RTL1+2,s	sta RTL1+2+pSize,s	lda RTL1,s	sta RTL1+pSize,s	pld	; recover the direct page	pla	; get rid of space for NewDataHandle	pla	pla	; pull off our parameter	txa	cmp #1	; set carry if error	RTL	StartupGlue	jsl ROMStartup	; call the real startup routine	rtl;----------------------------------------------------------------;;  IN: a-reg contains offset of address we want to calculate;      y-reg contains offset of where to store address;; OUT: nothing;;----------------------------------------------------------------GetAndStoreAddress		clc 	adc <Data	sta [<Data],y	iny	iny	lda <Data+2	sta [<Data],y	rts	EndP		EJECT********************************************************************************GetFrameColor	PROC** Description:	Patched version of the ROM based getframe color routine* 	this routine must call many routines in the firmware, so*	it must be patched in a special way. All jsr's have been *	replaced with JSL's to the proper routine*** Inputs:	Pointer to color table*	Pointer to window** Outputs:	None** External Refs:** Entry Points:********************************************************************************theWind	equ 9desTable	equ theWind+4	jsr setup	lda #wGetColorTable	Ask defProc for color table pointer	jsl callProcGlue	sta <work	Store pointer to color table.	stx <work+2	; Modified 5/10/89 Mensch; Add code here to detect if this is a handle or a pointer.	txa	put high word into <A> to test for handle	bpl @WorkOK	High bit clear, work ok.	ldy #2	else, dereference it in place.	lda [<work],y	tax	lda [<work]	sta <work	stx <work+2@WorkOK	lda desTable,s	Get pointer to destination table.	sta <work+4	lda desTable+2,s	sta <work+6	ldy #8	Clone color table into given table.lop1	lda [<work],y	sta [<work+4],y	dey	dey	bpl lop1	phb	brl pop8bytesGlue	ENDP****************************************************************** FindWindow patch (ROM 3) 25-Mar-91 DAL** Pre-zero the <wind variable, so that if we return wInMenuBar* we make sure to return NIL for the window pointer.  Besides* being clean, this causes ModalDialog to beep if the user clicks* in the menu bar.*****************************************************************FindWindow	proc export	tax	lda #0	sta >$0000A6,x	;zero out <wind	sta >$0000A8,x	;zero out <wind+2	txa	jml >$fd1956	;original ROM 3 FindWindow	EndP****************************************************************** GrowWindow patch (ROM 3) 26-Nov-90 DAL** Patch around GrowWindow to preserve the old ZoomRect and* frame bits (zoom state, at least) in the case that the* window doesn't change size at all.*****************************************************************GrowWindow	proc export	sta >oldAcc	pla	sta >PrivateRTL	pla	sta >PrivateRTL+2	pla	sta >PrivateRTL+4	lda 3,s	sta >gwTheWindow+2	tax	lda 1,s	sta >gwTheWindow	pha	;space for GetWFrame	phx	pha	;window pointer	_GetWFrame	pla	sta >gwTheFrame	pha	pha	;space for GetZoomRect	lda >gwTheWindow+2	pha	lda >gwTheWindow	pha	_GetZoomRect	pushlong #oldZoomRect	pea 0	pea 8	_BlockMove	lda >oldAcc	jsl ToROM	bcs @byebye	lda 1,s	ora 3,s	bne @byeNoErr	pushlong #oldZoomRect	lda >gwTheWindow+2	pha	lda >gwTheWindow	pha	_SetZoomRect	lda >gwTheFrame	pha	lda >gwTheWindow+2	pha	lda >gwTheWindow	pha	_SetWFrame@byeNoErr	lda #0	clc@byebye	tax	lda >PrivateRTL+4	pha	lda >PrivateRTL+2	pha	lda >PrivateRTL	pha	txa	rtlToROM	jsl $fd1800	rtlPrivateRTL	ds.b 6gwTheFrame	dc.w 0gwTheWindow	dc.l 0oldZoomRect	ds.b 8oldAcc	dc.w 0	EndP	title 'TaskMaster'*****************************************************************NewTaskMaster	PROC** 9/7/89	Mensch* Add tmNoGetNextEvent bit.*****************************************************************	DefineStackWindMgrD	wordThisAction	wordTheTaskMask	LONGWindPtr	LONGDataPtr	LONGCallingFlag	WORDOrigB	BYTEOrigD	wordRTL1	block 3RTL2	block 3InputTaskRecPtr	LONGInputEventMask	WORDOutputTaskCode	WORD	phd	Save d-page and dbr on stack	phb	tcd	Switch in wmgr's dPage for a momment	pea $0000	Push CallingFlag of zero to indicate call origin	pei <Data+2	Push pointer to window mgr's globals	pei <Data	pha	Push space for Window Pointer	pha	pha	Push space for the task mask	pha	pea $0000	ThisAction starts as zero	phd	Push window manager's direct page!	tsc	Turn our stack into direct page	tcd	pha	Save the Port on the stack	pha	_GetPort	bit CallingFlag	bpl DoNormalStuff	pei CallingFlag	; push a non-zero value so it looks like there was an event.	bra SkipNormalStuffDoNormalStuff;; Call System Task now and get it over with;; 8/24/89 Mensch; Added code here to skip getNextEvent in the case where the tmNoGetNextEvent bit is set in the; task mask.	ldy #taskMask+2	; get high word of the task mask	lda [InputTaskRecPtr],y	and #tmNoGetNextEvent	beq @getEvent	; if zero, get an event here;; If we get this far, then no call to get next event should be made,; what we will do instead is get the taskwhat field and push it on the stack as the result of ; getnextevent, so that we can proceed;	lda [InputTaskRecPtr] ; event what is first field	pha	bra SkipNormalStuff	  ; and continue with the rest of the call...@getEvent	_SystemTask	;Call Desk Manager so it can pass a tick	pha	pei InputEventMask	pei InputTaskRecPtr+2	pei InputTaskRecPtr	_GetNextEvent;;;; Now get back into the ROM with this here call!;;;;;;SkipNormalStuff	jml SkipNormalStuffROM*** added 1-Dec-92 DAL -- make tmNoGetNextEvent work!SkipNormalStuff	jsl IncBusyFlg		Inc flag so that shared resources are in danger;; Put d-page and dbr in global data for use by w-def Procs.; 13 Apr 89 SEG	ldy #callerDPage	lda OrigD	sta [<dataPtr],y	ldy #callerDataB		high byte must be valid	lda OrigB-1	sta [<DataPtr],y; End Change	lda [<InputTaskRecPtr]	Check this so we don't zero important data	cmp #wInContent		for TaskMasterDA case	beq SkipThisShit		ldy #message		Clone message into TaskData just in case.	lda [<InputTaskRecPtr],y	tax	iny	iny	lda [<InputTaskRecPtr],y	ldy #TaskData+2	sta [<InputTaskRecPtr],y	dey	dey	txa	sta [<InputTaskRecPtr],ySkipThisShit	ldy #TaskMask+2		Get TaskMask into a	zero page location.	lda [<InputTaskRecPtr],y	sta TheTaskMask+2	and #$FF80		Bits 23-31 must be clear.	jmp $fd26f5		;"beq mask_ok" in ROM 3*** end 1-Dec-92	EndP** WindowUpdateCount--used by BeginUpdate, EndUpdate, WindStatus, WindStartUp** 24-Sep-90 DAL*WindowUpdateCount	proc export	dc.w 0	EndP********************************************************** WindStatus patch** 24-Sep-90 DAL (new patch)** Now returns with the carry set if there are any windows* being updated.*********************************************************WindStatus	PROC	sta 7,s	Return status	lda >WindowUpdateCount	cmp #1	lda #0	rtl********************************************************** BeginUpdate patch** 24-Sep-90 DAL (new patch)** Increments WindowUpdateCount and jumps back into ROM.*********************************************************BeginUpdate	PROC	tax	lda >WindowUpdateCount	inc a	sta >WindowUpdateCount	txa	jml $fd0620	EndP********************************************************** EndUpdate patch** 24-Sep-90 DAL (new patch)** Decrements WindowUpdateCount and jumps back into ROM.*********************************************************EndUpdate	PROC	tax	lda >WindowUpdateCount	dec a	sta >WindowUpdateCount	txa	jml $fd0669	EndP********************************************************** GetWKind2 patch** 15-May-91 DAL (new patch)** Checks for the NIL case and then jumps back to ROM.*********************************************************GetWKind2	proc	pha	lda 7+1+2,s	bne @notNIL	sta 11+2,s	;zero out result word	pla	ldx #0	;no error	ldy #4	;pop 4 bytes	jml $e10184	;ToStrip@notNIL	pla	jml >$fd1042	EndP	END