	title 'Desk Mgr Patch        GS ROM 3 Patch'********************************************************************	Desk manager patches for ROM 3** System Disk 5.0*** 01 Jun 89	Steven Glass** We just discovered that the NDA calls are re-entrant and when* this occurs the nda handle list is unlocked by the second call* but the first call doesn't know it.** This leads us to use dangling handles.  To fix this we* save the state of the handle before each call and restore* it at the end.** 28 Aug 89	Harry Yee** Patch calls AddToRunQ and RemoveFromRunQ. These calls were* calling DerefNDAList but never UnlockNDAList. This caused* the NDAList handle to stay locked. BRC #52333.** 17-Sep-90	Dave Lyons** Removed dependency on all.macros.** 19-Sep-90	Dave Lyons** Added GetIndDAInfo and CallDeskAcc skeletons.* Version number is $8304.** 25-Nov-90	Dave Lyons** Changed FixAppleMenu patch to call FixAppleMenu2 in Desk:NDACalls* (this version conditionally sorts the names).** 27-Nov-90	Dave Lyons** Patch ChooseCDA to call SortCDAs.** 3-Jan-91	Dave Lyons** Changed SystemEvent so that Apple-w or Apple-W with a System* window in front calls CloseNDAByWinPtr and returns TRUE, instead* of letting the DA or the application handle the Apple-W.** 12-Feb-91	Dave Lyons** Patched ChooseCDA (into the Desk project) so it supports letter* keys now (and uses a sane Event Mask on the GetNextEvent call).** Made DABootInit store monkeyin in KeyInput for CDA menu.** 19-Feb-91	Dave Lyons** Moved GetIndDAInfo and CallDeskAcc into Desk:NDACalls.* Added new call GetDeskGlobal to the call table.** Killed local patches in favor of Desk:NDACalls for the* following revised calls:  SystemClick, SystemEdit,* SystemEvent, CloseNDAByWinPtr.** Since we're calling stuff directly in NDACalls.asm now, I* made DeskBootInit zero out $E01D6E, and StartUsUp and ShutUsDown* increment and decrement it so that the NDACalls code doesn't* unlock the NDAList handle when it shouldn't.** 4-Mar-91	Dave Lyons** Add SendRequest calls to DeskStartUp and DeskShutDown.** 11-Mar-91	Dave Lyons** Changed name of GetIndDAInfo to GetDeskAccInfo.** 21-Apr-91	Dave Lyons** Changed SystemTask to return with no error if GS/OS is busy.** 2-May-91	Dave Lyons** Patch CloseAllNDAs to close non-NDA system windows (code in* Desk:NDACalls.asm).** 20-May-91	Dave Lyons** Changed to use SystemTask from Desk:NDACalls.asm to be just* like ROM 1.** 5-Aug-91	Dave Lyons** Added paranoia check to DeskStartUp--checks for GS/OS and* several tools; takes no action if they aren't here.** 4-Sep-91	Dave Lyons** Now calls the paranoid OpenNDA in NDACalls.asm (it sets the* port to something safe around opening the NDA).** 16-Sep-91	Dave Lyons** DeskStartUp and DeskShutDown maintain RealDeskStatus, so that* FixAppleMenu can use it.** 17-Sep-91	Dave Lyons** Moved a lot of calls to Tool.Setup.** 5-Feb-92	Dave Lyons** Version $0304 for 6.0 final.  DeskVersion no longer falls* into DeskBootInit!********************************************************************* 7-Jul-92	Dave Lyons for 6.0.1** DeskShutDown zeroes $00/07FC if slot 4 is set to Mouse.* This should stop the mouse from freezing on exiting the* CDA menu in a desktop application, after running an app* (like ProTERM 3.0) that leaves a nonzero value in $07FC.************************************************************************************************************************************			   **              Copyright (C) 1989-1992		   **              All Rights Reserved		   **              Apple Computer, Inc.		   **			   *****************************************************************	Blanks off	String asis		include 'all.macros'	include ':::sys.equs.asm'	include 'e16.memory'	include ':::desk:Desk.Equates.asm'	DefineStackOrigD	wordTheHandle	longRTL1	block 3RTL2	block 3TheInput	long	import RemoveNDA	import ChooseCDA*****************************************************************DeskCallTable	PROC EXPORT** Contains pointers to all the calls we are patching.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************TheBeginning	DC.L (TheEnd-TheBeginning)/4 ; num calls + 1	DC.L DABootInit-1	; 	  0105	DC.L DAStartup-1		; 0205 patched 4-Mar-91 DAL	DC.L DAShutdown-1		; 0305 patched 4-Mar-91 DAL	DC.L DAVersion-1	; 	  0405	DC.L 0	; DAReset-1	; 0505	DC.L 0	; DAStatus-1	; 0605	DC.L 0	; oEndCall0-1	; 0705     reserved	DC.L 0	; oEndCall0-1	; 0805     reserved	DC.L 0	; SaveScreen-1	; 0905	DC.L 0	; RestScreen-1	; 0A05	DC.L 0	; SaveAll-1	; 0B05	DC.L 0	; RestAll-1	; 0C05	DC.L 0	; oEndCall0-1	; 0D05	DC.L InstallNDA-1		; 0E05	DC.L 0	; instcda-1	; 0F05	DC.L 0	; oEndCall0-1	; 1005	DC.L 0	;[ts] ChooseCDA-1		; 1105	DC.L 0	; oEndCall0-1	; 1205	DC.L 0	; setdastrptr-1	; 1305	DC.L 0	; getdastrptr-1	; 1405	DC.L OpenNDAentry-1		; 1505	DC.L CloseNDA-1		; 1605	DC.L 0  ;[ts] SystemClick-1		; 1705	DC.L 0  ;[ts] SystemEdit-1		; 1805	DC.L 0  ;[ts] SystemTask-1		; 1905	DC.L 0  ;[ts] SystemEvent-1	; 1A05	DC.L GetNumNDAs-1		; 1B05	DC.L 0  ;[ts] CloseNDAbyWinPtr-1 	; 1C05	DC.L 0  ;[ts] CloseAllNDAs-1		; 1D05	DC.L 0  ;[ts] FixAppleMenu-1		; 1E05	DC.L AddToRunQ-1		; 1F05	DC.L RemoveFromRunQ-1 	; 2005	DC.L 0	; RemoveCDA-1	; 2105	DC.L 0  ;[ts] RemoveNDA-1		; 2205	dc.L 0  ;[ts] GetDeskAccInfo-1	; 2305  19-Sep-90 DAL	dc.L 0  ;[ts] CallDeskAcc-1	; 2405  19-Sep-90 DAL	dc.l 0  ;[ts] GetDeskGlobal-1	; 2505  19-Feb-91 DALTheEnd	ENDP****************************************************************** DeskStartUp patch -- 4-Mar-91 DAL** Call the ROM and then call SendRequest($0502)*****************************************************************DAStartUp	proc*** added 5-Aug-91 DAL -- if proper environment is not set up, do nothing	pha	phy	lda >$e100bc	;OS_Kind	and #$00ff	dec a	bne @error	;must be $01=GS/OS	ldx #@neededToolsEnd-@neededTools@checkOneTool	dex	bmi @toolsAreHere	phx	lda >@neededTools,x	and #$00FF	ora #$0600	;compute xxxStatus function code	tax	pea 0	jsl $e10000	;make the call	pla	plx	tay	bne @checkOneTool	;nonzero status --> go back for more@error	ply	pla	lda #0	clc	rtl@neededTools	dc.b $0E	;window	dc.b $0F	;menu	dc.b $10	;control	dc.b $14	;line edit	dc.b $15	;dialog;;;	dc.b $16	;scrap (omitted...I'm feeling generous)@neededToolsEnd@toolsAreHere	ply	pla*** end 5-Aug-91 DAL	jsl $fec70e	pha	lda #$ffff	;16-Sep-91 DAL	sta >RealDeskStatus	;16-Sep-91 DAL	pea $0502	;request code	lda #0	pha	;how = everybody	pha	pha	;target = nil	pha	pha	;dataIn = nil	pha	pha	;dataOut = nil	_SendRequest	pla	cmp #1	rtl	EndP****************************************************************** DeskShutDown patch -- 4-Mar-91 DAL** Call the ROM and then call SendRequest($0503)*****************************************************************DAShutDown	proc*** added 7-Jul-92 DAL*** If slot 4 is internal then zap $07FC mouse mode	pha	sep #$20	longa off	lda >$E1C02D	and #$10	bne @external4	lda #0	sta >$0007FC@external4	rep #$20	longa on	pla*** end 7-Jul-92	jsl $fec729	pha	lda #0	;16-Sep-91 DAL	sta >RealDeskStatus	;16-Sep-91 DAL	pea $0503	;request code for DeskShutDown	lda #0	pha	;how = everybody	pha	pha	;target = nil	pha	pha	;dataIn = nil	pha	pha	;dataOut = nil	_SendRequest	pla	cmp #1	rtl;;;	export RealDeskStatus;;;RealDeskStatus	dc.w 0	EndP*****************************************************************DAVersion	PROC** Returns the version number of the desk manager*** Inputs:*	none** Outputs:*	work : The patched version number** External Refs:*	Falls into the boot init code.** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	lda #$0304	;5-Feb-92 DAL	sta 7,s*** added 5-Feb-92 DAL	lda #0	clc	rtl*** end 5-Feb-92	ENDP*****************************************************************DABootInit	PROC** Simple routine to do nothing so when patch is installed,* nothing bad happens.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************;;; Tool.Setup now inits keyinput (17-Sep-91 DAL);;;	import monkeyin;;;;;;	lda #monkeyin;;;	sta >keyinput	;added 12-Feb-91 DAL	lda #0	sta >$e01d6e	;counts number of re-times Desk Mgr is		;re-entrantly active (used in NDACalls)***	lda #0	;already 0	clc	RTL	ENDP*****************************************************************StartUsUp	PROC** This routine is used by all the patched nda calls to * save the lock status on the stack.** It preserves a and y but trashes x.** It also sets the d-page to the stack*** Inputs:*	a & y have the handle to global data** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	plx	; pull off the rts addr into x	phy	; push y and a (the handle to the data area)	pha	phd	; save d-reg	tsc	; turn stack into direct page	tcd	ldy #4	; save the lock status on the stack	lda [TheHandle],y	pha	phx	; put back rts and *** added 19-Feb-91 DAL	lda >$e01d6e	inc a	sta >$e01d6e*** end of 19-Feb-91 DAL	lda TheHandle	; restore the incoming WAP	ldy TheHandle+2	rts	; return.	ENDP*****************************************************************ShutUsDown	PROC** Restores the lock status from the stack.  Cleans up the stack* and calls the strip routine.*** Inputs:*	on stack** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on*****************************************************************	pla	; restore the lock status	phy	; save the strip value	ldy #4	; store the lock status	sta [TheHandle],y	ply	; restore the strip value.*** added 19-Feb-91 DAL	lda >$e01d6e	dec a	sta >$e01d6e*** end of 19-Feb-91 DAL	pld	; restore the d-page	pla	; clean off the handle	pla	jml ToStrip	; use y and x to fall into stripping code	ENDP;****************************************************************;*;* ChooseCDA patch 27-Nov-90 DAL;*;* Call SortCDAs (in Desk:CDACalls.asm) to conditionally sort;* the list before we display it.;*;MyChooseCDA	proc;	import SortCDAs;;	jsr SortCDAs;	jml $fed0cf	;doesn't use A/X/Y;;	EndP*****************************************************************InstallNDA	PROC**	longa on	; mode	longi on*****************************************************************	jsr StartUsUp	pei TheInput+2	; make the call	pei TheInput	jsl ToInstallNDA	tax	; save error code in x	ldy #4	brl ShutUsDownToInstallNDA	jsl $00FEDA5E	rtl	ENDP*****************************************************************OpenNDAentry	PROC**	longa on	; mode	longi on*****************************************************************	import OpenNDA	jsr StartUsUp	pha	; make the call	pei TheInput	jsl ToOpenNDA	tax	pla	sta TheInput+2	ldy #2	brl ShutUsDown;;ToOpenNDA	jsl $00FEDB1C;;	rtlToOpenNDA	jsl OpenNDA	rtl	ENDP*****************************************************************CloseNDA	PROC**	longa on	; mode	longi on*****************************************************************	jsr StartUsUp	pei TheInput	jsl ToCloseNDA	tax	ldy #2	brl ShutUsDownToCloseNDA	jsl $00FEDBB7	rtl	ENDP;****************************************************************;*;SystemClick	PROC;*;*;	longa on	; mode;	longi on;*;****************************************************************;;;	jsr StartUsUp;;	pei TheInput+8;	pei TheInput+6;	pei TheInput+4;	pei TheInput+2;	pei TheInput;	jsl ToSystemClick;	tax;;	ldy #10;	brl ShutUsDown;;ToSystemClick	jsl $00FEDD76;	rtl;;	ENDP;;;****************************************************************;*;SystemEdit	PROC;*;*;	longa on	; mode;	longi on;*;****************************************************************;;;	jsr StartUsUp;;	pha	; make the call;	pei TheInput;	jsl ToSystemEdit;	tax;	pla;	sta TheInput+2;;	ldy #2;	brl ShutUsDown;;ToSystemEdit	jsl $00FEDEAF;	rtl;;	ENDP;****************************************************************;*;SystemTask	PROC;*;*;	longa on	; mode;	longi on;*;****************************************************************;;*** added 21-Apr-91 DAL -- make SystemTask take no action if GS/OS is busy;	tax;	lda >$e100be;	bpl @1;	clc;	lda #0;	rtl;@1	txa;*** end of 21-Apr-91 DAL;;	jsr StartUsUp;;	jsl ToSystemTask;	tax;;	ldy #0;	brl ShutUsDown;;ToSystemTask	jsl $00FEDC61;	rtl;;	ENDP*** old	******************************************************************* old	**** old	SystemEvent	PROC*** old	**** old	**** old		longa on	; mode*** old		longi on*** old	**** old	******************************************************************* old	*** old	*** old		jsr StartUsUp*** old	*** old		pha*** old		pei TheInput+14*** old		pei TheInput+12*** old		pei TheInput+10*** old		pei TheInput+8*** old		pei TheInput+6*** old		pei TheInput+4*** old		pei TheInput+2*** old		pei TheInput*** old		jsl ToSystemEvent*** old		tax*** old		pla*** old		sta TheInput+16*** old	*** old		ldy #16*** old		brl ShutUsDown*** old	*** old	ToSystemEvent	jsl $00FED8A3*** old		rtl*** old	*** old		ENDP;****************************************************************;*;SystemEvent	PROC;*;*;* 12/6/89	Mensch;* Added patch so that menu key equivs can be properly handled by desk accs.;* Since this only affects the menu key stuff it should not change any other;* behavior.;* ;* 3-Jan-91	Dave Lyons;*;* Resurrected this code and change it to only affect Apple-w and;* Apple-W.  It just does a CloseNDAByWinPtr(FrontWindow) and;* returns TRUE.;*;* NOTE: TB Ref Volume 1 has the SystemEvent input parameters listed;* in reverse order.  Oops.;*;	longa on	; mode;	longi on;*;****************************************************************;;	jsr StartUsUp;	sta >deskWAP;	tya;	sta >deskWAP+2;;; Patch goes here...;	lda TheInput+0	;eventWhat;	cmp #$0005	; is it auto key down?;	beq @isKey;	cmp #$0003	; is it a key down?;	bne @DoSysEvent;@isKey	lda TheInput+14	; see if the modifiers key is down;	and #$0100	; see if the apple key is down...;	beq @DoSysEvent;;	lda TheInput+2	;eventMessage;	and #$00ff;	cmp #'w';	beq @DoCloseNDA;	cmp #'W';	bne @DoSysEvent;;@DoCloseNDA	pha;	pha;	_FrontWindow;	ply;	pla;	bne @aWindow;	tyx;	bne @aWindow;	bra @DoSysEvent;;@aWindow	pha;	pha;	phy;	_GetSysWFlag;	pla;	bpl @DoSysEvent;	pha;	pha;	_FrontWindow;	_CloseNDAByWinPtr;;	pea $ffff	;result = TRUE;	lda #0	;error 0;	bra @JustLeave	; and simply exit...;@DoSysEvent;	pha;	pei TheInput+14;	pei TheInput+12;	pei TheInput+10;	pei TheInput+8;	pei TheInput+6;	pei TheInput+4;	pei TheInput+2;	pei TheInput;	lda >deskWAP+2;	tay;	lda >deskWAP;	jsl ToSystemEvent;@JustLeave	tax;	pla;	sta TheInput+16;;	ldy #16;	brl ShutUsDown;;ToSystemEvent	jsl $00FED8A3;	rtl;;deskWAP	dc.l 0;;	ENDP*****************************************************************GetNumNDAs	PROC**	longa on	; mode	longi on*****************************************************************	jsr StartUsUp	pha	jsl ToGetNumNDAs	tax	pla	sta TheInput	ldy #0	brl ShutUsDownToGetNumNDAs	jsl $00FEDF90	rtl	ENDP;****************************************************************;*;CloseNDAByWinPtr	PROC;*;*;	longa on	; mode;	longi on;*;****************************************************************;;;	jsr StartUsUp;;;	pei TheInput+2	; make the call;	pei TheInput;	jsl ToCloseNDAByWinPtr;;	tax	; save error code in x;;	ldy #4;	brl ShutUsDown;;ToCloseNDAByWinPtr	jsl $00FEDBDC;	rtl;;	ENDP;****************************************************************;*;CloseAllNDAs	PROC;*;*;	longa on	; mode;	longi on;*;****************************************************************;;	import CloseAllNDAs2;;	jsr StartUsUp;;	jsl ToCloseAllNDAs;	tax;;	ldy #0;	brl ShutUsDown;;;ToCloseAllNDAs	jsl $00FEDC02;;	rtl;;ToCloseAllNDAs	jsl CloseAllNDAs2;	rtl;;	ENDP;****************************************************************;*;FixAppleMenu	PROC;*;*;	longa on	; mode;	longi on;*;****************************************************************;;;	jsr StartUsUp;;	pei TheInput;	jsl ToFixAppleMenu;	tax;;	ldy #2;	brl ShutUsDown;;*** ToFixAppleMenu	jsl $00FEDEDB;***	rtl;;ToFixAppleMenu	jsl FixAppleMenu2	;in Desk:NDACalls.asm;	rtl;;	ENDP*****************************************************************AddToRunQ	PROC**	longa on	; mode	longi on*****************************************************************	jsr StartUsUp	pei TheInput+2	; make the call	pei TheInput	jsl ToAddToRunQ	tax	; save error code in x	ldy #4	brl ShutUsDownToAddToRunQ	jsl $00FEE0BD	rtl	ENDP*****************************************************************RemoveFromRunQ	PROC**	longa on	; mode	longi on*****************************************************************	jsr StartUsUp	pei TheInput+2	; make the call	pei TheInput	jsl ToRemoveFromRunQ	tax	; save error code in x	ldy #4	brl ShutUsDownToRemoveFromRunQ	jsl $00FEE0E4	rtl	ENDP	END