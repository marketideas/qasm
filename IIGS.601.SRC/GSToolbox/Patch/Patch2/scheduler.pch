************************************************************************ Scheduler Tool Patch** Copyright (C) 1990 Apple Computer, Inc.* All Rights Reserved.************************************************************************* 20-Dec-90	Dave Lyons** Created this file (scheduler was not patched on ROM 1 before).* Changed version to $8300 so it can match ROM 3 for 6.0.** 5-Feb-92	Dave Lyons** Version $0300 for 6.0 final.***********************************************************************SchedulerVersion	equ $0300****************************************************************** CALL TABLE*****************************************************************SchedCallTable	PROC EXPORT	import SchVersionTheStart	DC.L (TheEnd-TheStart)/4	dc.L 0	;SchBootInit-1	; 1	dc.L 0	;SchAppInit-1	; 2	dc.L 0	;SchApTerm-1	; 3	dc.L SchVersion-1		; 4	dc.L 0	;SchReset-1	; 5	dc.L 0	;SchStatus-1	; 6	dc.L 0	;oEndCall0-1	; 7   reserved	dc.L 0	;oEndCall0-1	; 8   reserved	dc.L 0	;SchAddTask-1	; 9	dc.L 0	;SchFlush-1	; 10TheEnd	EndPSchVersion	proc export	lda #SchedulerVersion	sta 7,s	lda #0	clc	rtl	endp	END