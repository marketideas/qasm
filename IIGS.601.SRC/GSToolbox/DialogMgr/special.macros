* modified link and tlink 24-Sep-90 DAL so they won't TSC SEC SBC#0 TCS	MACRO&lab	moveword &from,&to1,&to2	LCLC &C&C	setc &substr(&from,1,1)	IF  &C='['	GOTO .zeropage&lab	lda &from	sta &to1	IF  &to2=''	GOTO .a	sta &to2.a	MEXIT.zeropage	IF  &to1='0'	GOTO .b&lab	ldy #&to1	lda &from,y	sta &to2	MEXIT.b&lab	lda &from	sta &to2	MEND	MACRO&lab	movelong &from,&to1,&to2	LCLC &C	LCLC &REST&C	setc &substr(&from,1,1)&REST	setc &substr(&from,2,&LEN(&from)-1)	IF  &C='['	GOTO .zeropage	IF  &to2=''	GOTO .a&lab	moveword &from,&to1,&to2	GOTO .b.a&lab	moveword &from,&to1.b	IF  &C='#'	GOTO .immediate	IF  &to2=''	GOTO .c	moveword &from+2,&to1+2,&to2+2	MEXIT.c	moveword &from+2,&to1+2	MEXIT.immediate	IF  &to2=''	GOTO .d	moveword #^&REST,&to1+2,&to2+2	MEXIT.d	moveword #^&REST,&to1+2	MEXIT.zeropage&lab	moveword &from,&to1,&to2	ldy #&to1+2	lda &from,y	sta &to2+2	MEND	MACRO&lab	zero &num,&loc&lab	lda #0	LCLC &C&C	setc &substr(&num,1,1)	IF  &C='#'	GOTO .a	ldx &num	dex	GOTO .b.a	ldx &num-1.b&C	setc &substr(&loc,1,1)	IF  &C='['	GOTO .c@1	sta &loc,x	GOTO .d.c	ldy #0@1	sta &loc,y	iny	iny.d	dex	dex	bpl @1	MEND	MACRO&lab	Check_Error &error_jmp&lab	bcc @1	brl &error_jmp@1	MEND	MACRO&lab	link &SizeInput,&SizeLocals	lclc &SL&SL	setc &DEFAULT(&SizeLocals,'0')input	equ &SL+3output	equ input+&SizeInput&lab	tsc	if &SL='0' GOTO .DontSubtract	sec	sbc #&SL	tcs.DontSubtract	phd	inc a	tcd	MEND	MACRO&lab	unlink&lab	pld	tay	lda input-1,s	sta output-1,s	lda input-2,s	sta output-2,s	tsc	clc	adc #output-3	tcs	tya	cmp #1	MEND	MACRO&lab	tlink &SizeInput,&SizeLocals	lclc &SL&SL	setc &DEFAULT(&SizeLocals,'0')input	equ &SizeLocals+6output	equ input+&SizeInput&lab	tsc	if &SL='0' GOTO .DontSubtract	sec	sbc #&SL	tcs.DontSubtract	phd	inc a	tcd	MEND	MACRO&lab	tunlink&lab	pld	tay	lda input-1,s	sta output-1,s	lda input-3,s	sta output-3,s	lda input-5,s	sta output-5,s	tsc	clc	adc #output-6	tcs	tya	cmp #1	MEND	MACRO&lab	pushay&lab	phy	pha	MEND	MACRO&lab	lday &addr,&offset	LCLC &C&C	setc &SUBSTR(&addr,1,1)	IF  &C='#'	GOTO .immediate	IF  &C='['	GOTO .zeropage&lab	lda &addr	ldy &addr+2	MEXIT.immediate&lab	lda &addr	ldy &addr|-16	MEXIT.zeropage&lab	ldy #&offset+2	lda &addr,y	pha	ldy #&offset	lda &addr,y	ply	MEND	MACRO&lab	stay &addr&lab	sta &addr	sty &addr+2	MEND	MACRO&lab	pullay&lab	pla	ply	MEND