********************************************************************************* File: LAP.INCLUDES** This file contains the 65816 implementation of LAP for the Apple IIGS.* Inspiration and guidance derived from Fern Bachman's 65C02 implementation.** Copyright Apple Computer, 1986* Original Author: Peter Richert, Greg Seitz** NOTE:*   If calling internal form you must set the carry otherwise the carry is*   cleared from the dispatcher (long form)********************************************************************************** Notes:** If the ROM version ever changes you must change the following line!RomVer	equ $1020	;Rom version 2.0.*********************************************************************************** Modification History** 8/8/88    TGH	- Started working on RevD ROM 02*	- Added 3 vectors Cnxx, CnxxGo, and CnProdos to bank $E1.*	  These will be patched to jump to either 00C1xx or 00C2xx.** 8/23/88   TGH	- Took out CnProdos vector.  Didn't need it.** 8/24/88   TGH	- Changed MID to load only the low order byte as the*	  high order byte was always being written over.*	- Hard coded ROM version to 1020.  It's too hard to*	  figure out whether I should load C1FE or C2FE.** 10/12/88  TGH  	- Changed AppleTalk slot search method.** 11/9/88   TGH     - Fixed bug where BDS length = 0.** 11/14/88  TGH	- Now verifing LAP type on a LAPWrite call.*	  (didn't work - taken out)** 11/23/88  TGH  	- AppleTalk slot settings are now determined by looking*	  at locations 1C0, 1C1, and 1C2 in bank E1.*	- Now verifing first BDS length on LAPWrite call.** 3/27/89   TGH     - Added OnExitVector vector for QTRIRQ.********************************************************************************	longa off	longi on	msb   on*	org   $ff2A27	IMPORT GoComp	IMPORT QtrSched	IMPORT RestoreE1	IMPORT RestoreZP	IMPORT SaveE1	IMPORT SaveZP	ENTRY BitCount	ENTRY EnterCrit	ENTRY ExitCrit	ENTRY FindProt	ENTRY Forbid	ENTRY FreeBuf	ENTRY NewPacket	ENTRY PacketIRQ	ENTRY Permit	ENTRY QtrSecIRQ	ENTRY RTSAddr	ENTRY Random	ENTRY RecvBytes	ENTRY RecvInit	ENTRY RecvPacket	ENTRY RestorState	ENTRY SaveState	ENTRY TryNode	ENTRY WLineBusy	ENTRY XmitBDS	ENTRY XmitBegin	ENTRY XmitEnd	ENTRY XmitLAP,fXmitLAP	ENTRY XmitOne	ENTRY XmitPacket	ENTRY stackrestore	ENTRY stacksave;-------------------------------------------------------------------------------;	General equates;-------------------------------------------------------------------------------XBit	equ $10MBit	equ $20VBit	equ $40CBit	equ $01IBit	equ $04ZPStart	equ $80E1Start	equ $1000Base	equ $E000	;Base of packet buffer area.MID	equ $0	;ID for Cortland.lapzplen	equ $10e1lapend	equ $001200	;really $e11200atport	equ $E101C0atslot	equ $E101C1pmslot	equ $E101C2incbusyflag	equ $E10064	;scheduler inc routinedecbusyflag	equ $E10068	;Scheduler dec routinerd80col	equ $E1c018	;read 80 column switchaltsp	equ $010101	;alt stack pointermainsp	equ $010100	;main stack pointerrdaltzp	equ $C016	;read alt zero page switch;-------------------------------------------------------------------------------;	SCC register definitions;-------------------------------------------------------------------------------RecvIntsA	equ $20	;Mask to detect channel A recv ints.RecvIntsB	equ $04	;Mask to detect channel B recv ints.AddrReg	equ $06TxEmpty	equ $04RxAvail	equ $01Hunt	equ $10Underrun	equ $40DisRx	equ $D0EnbRTS	equ $E3DisTxRTS	equ $E1EnbTxRTS	equ $EBResTxCRC	equ $80ResetUnd	equ $C0ResetErr	equ $30ReEnbInt	equ $20EnbRxSlv	equ $CDEnterHunt	equ $10EnbRxInt	equ $08SrchMode	equ $21FMMode	equ $C1BaudRate	equ $06ClocksA	equ $F2SetFM0	equ $E0SDLC	equ $7EEnbTx	equ $E9SDLCMode	equ $20DisRxInt	equ $00ResetA	equ $8AResetB	equ $4A;-------------------------------------------------------------------------------;	Time definitions and equates;-------------------------------------------------------------------------------TWLFree	equ 4000T100usec	equ 7T2Flags	equ 28TLastFlag	equ 16TAbort	equ 42TIFGap	equ 100TByte	equ 7;-------------------------------------------------------------------------------;	LAP equates;-------------------------------------------------------------------------------Broadcast	equ $FFLAPEnq	equ $81LAPAck	equ $82LAPRTS	equ $84LAPCTS	equ $85DDPShort	equ 1DDPLong	equ 2MaxData	equ 600	;Maximum amount of data in a LAP pkt.MaxSize	equ MaxData+11	;Data + LAP + len +	cksum + link + CRC.GlobalSize	equ 16MaxColsns	equ 32MaxDefers	equ 32;-------------------------------------------------------------------------------; 	Error equates;;-------------------------------------------------------------------------------ColErr	equ 1DefErr	equ 2Err	equ $80CRCErr	equ $40ORunErr	equ $20TBigErr	equ $10TOutErr	equ $8Lock	equ $1NoErr	equ 0	;Success.BufErr	equ 1	;No packet in buffer.EndErr	equ 2	;End of buffer.SizeErr	equ 3	;LAP data too large.RetryErr	equ 4	;Retry count exhausted.IllProtErr	equ 5	;Illegal protocol number (LAP type).DupProtErr	equ 6	;Duplicate protocol	number.FulProtErr	equ 7	;Protocol list full.MisProtErr	equ 8	;Missing protocol (can't be removed).ShortErr	equ 9	;User's buffer is too short when purgingEnableErr	equ 10	;AppleTalk is not enabled.VBLSize	equ 12	;Size of ROM image of VBL entry.MaxProts	equ 8	;Maximum # of protocols in table.;-------------------------------------------------------------------------------; 	Misc. constants;-------------------------------------------------------------------------------MVNOp	equ $54RTLOp	equ $6BNOPOp	equ $EAtopstack	equ $1a0	;we want the stack this high;-------------------------------------------------------------------------------; 	Character constants;-------------------------------------------------------------------------------CR	equ $8DLF	equ $8Airq_intflag	equ $C3irq_secflag	equ $C6irq_active	equ $CBSCCStat	equ $101SCCFlag	equ $102SCCFlag2	equ $103SerFlag	equ $104scc1	equ $105scc2	equ $106irq_A	equ $108irq_X	equ $10Airq_Y	equ $10Cirq_S	equ $10Eirq_D	equ $110irq_DB	equ $113irq_State	equ $118irq_shadow	equ $119;PORT1	equ $2C0;PORT2	equ $2CC;USERSLT1	equ $2E1	;We don't use these two anymore.;USERSLT7	equ $2E7;-------------------------------------------------------------------------------; 	Hardwired locations;-------------------------------------------------------------------------------LapDest	equ $D000ThisNet	equ $D010ABridge	equ $D013LCBank2	equ $C083RDROM	equ $C082CYAReg	equ $C036StateReg	equ $C068SCCBReg	equ $C038SCCAReg	equ $C039MouseA	equ $C044MouseB	equ $C045mouseMode	equ $C041CLRVBLINT	equ $C047;-------------------------------------------------------------------------------; 	Call block definition equates;-------------------------------------------------------------------------------lp_async	equ 0	;Generallp_command	equ lp_async+1lp_result	equ lp_command+1li_flag	equ lp_result+2	;LAPInitli_entry	equ li_flag+1li_node	equ li_entry+4	;2 for entry, 2 reserved.li_size	equ li_node+1gi_return	equ lp_result+2	;GetInfogi_net	equ gi_return+4gi_bridge	equ gi_net+2gi_mid	equ gi_bridge+1gi_version	equ gi_mid+1gi_size	equ gi_version+1gg_buffer	equ lp_result+2	;GetGlobalggb_length	equ $10lw_dest	equ lp_result+2	;LAPWritelw_lapType	equ lw_dest+1lw_BDS	equ lw_lapType+1lw_size	equ lw_BDS+4lr_count	equ lp_result+2	;LAPReadlr_buffer	equ lr_count+2lr_purge	equ lr_buffer+4lr_actual	equ lr_purge+1lr_size	equ lr_actual+2ap_prot	equ lp_result+2	;AttachProtocolap_handler	equ ap_prot+1ap_size	equ ap_handler+4rm_prot	equ lp_result+2	;RemoveProtocolrm_size	equ rm_prot+1;-------------------------------------------------------------------------------;	Receive buffer data structure offsets:;-------------------------------------------------------------------------------buf_next	equ 0buf_len	equ buf_next+2buf_cksum	equ buf_len+2buf_lap	equ buf_cksum+2buf_dest	equ buf_lapbuf_src	equ buf_dest+1buf_type	equ buf_src+1buf_data	equ buf_type+1;-------------------------------------------------------------------------------;	Zero page usage.;-------------------------------------------------------------------------------cmndList	equ ZPStart	;GeneralzpCurBuf	equ cmndListexecAddr	equ cmndList+4sccReg	equ execAddr+4	;SCC pointerssccDat	equ sccReg+2ptr0	equ sccDat+2ptr1	equ ptr0+3r0	equ ptr1+3r1	equ r0+1r2	equ r1+1r3	equ r2+1ZPEnd	equ r3+1ZPSize	equ ZPEnd-ZPStart;-------------------------------------------------------------------------------;	Bank E1 variables.;-------------------------------------------------------------------------------Extended	equ E1Start	;RAM vectors.  Extended interface entry.Basic	equ Extended+4	;Basic entry.Pascal	equ Basic+4	;Pascal entry.RamGoComp	equ Pascal+4	;users gocomp entry	for completionsSoftReset	equ RamGoComp+4	;Soft reset chain.RamDispatch	equ SoftReset+4	;Command dispatcher.RamForbid	equ RamDispatch+4	;RAM vector to long	entry of forbid.RamPermit	equ RamForbid+4	;For Permit.ProEntry	equ RamPermit+4	;Original ProDOS entry point.Prodos	equ ProEntry+2	;Prodos entry.SerStatus	equ Prodos+4	;Serial interface status hookSerWrite	equ SerStatus+4	;" " write hook.SerRead	equ SerWrite+4	;For Read.SerBackgnd	equ SerRead+4	;For background printing.PDispatch	equ SerBackgnd+4	;For dispatching packets.ExtraVec	equ PDispatch+4	;For more vectors.colHist	equ ExtraVec+20	;These first  variables need to be setdefHist	equ colHist+1	;to zero at initialization, so put themgBackOff	equ defHist+1	;together.needData	equ gBackOff+1addrValid	equ needData+1busyFlag	equ addrValid+1pktError	equ busyFlag+1deltaT	equ pktError+1trailing	equ deltaT+1curPos	equ trailing+1catchProt	equ curPos+2protTable	equ catchProt+4	;This table must be	filled with $ff's.whichMouse	equ protTable+MaxProts*6seed	equ whichMouse+2addrUsed	equ seed+2gotCTS	equ addrUsed+1gotData	equ gotCTS+1dest	equ gotData+1source	equ dest+1lapType	equ source+1lBackOff	equ lapType+1colTries	equ lBackOff+1defTries	equ colTries+1errRec	equ defTries+1txBDS	equ errRec+2whichSCC	equ txBDS+4ckSum	equ whichSCC+2freeProt	equ ckSum+2scc1A	equ freeProt+2scc2A	equ scc1A+1scc3	equ scc2A+1curRBuf	equ scc3+1curLen	equ curRBuf+2curWBuf	equ curLen+2curOffset	equ curWBuf+2curEnd	equ curOffset+2ourstacksave	equ curEnd+3stksaveflag	equ ourstacksave+(topstack-$ff)	;only reserve space to save from $100 up to topstackstretaddr	equ stksaveflag+2lentosave	equ stretaddr+2oldstack	equ lentosave+2stacksavea	equ oldstack+2stacksavex	equ stacksavea+2stacksavey	equ stacksavex+2stacksaveb	equ stacksavey+2stacksavep	equ stacksaveb+2nestedflag	equ stacksavep+2dstack	equ nestedflag+2dstate	equ dstack+2E1End	equ dstate+1zzz	equ E1End	;Note the last byte used should		;not be beyond $e11200	;-------------------------------------------------------------------------------;	Slot 7 equates;-------------------------------------------------------------------------------;C7xx	equ $C7A0	;emulation mode entry;C7xxGo	equ $C7A1	;native mode entry;C7xxRet	equ $C7A8	;return point for routines;C7Error	equ $C7AB	;error point for pascal not installed;C7Prodos	equ $C7AE	;bank 0 entry for prodosOfstCnxx	equ $A0	;emulation mode entryOfstCnxxGo	equ $A1	;native mode entryOfstCnxxRet	equ $A8	;return point for routinesOfstCnError	equ $AB	;error point for pascal not installedOfstCnProdos	equ $AE	;bank 0 entry for prodosCnxx	equ $E11042	;emulation mode entryCnxxGo	equ $E11046	;native mode entryOnExitVector	equ $E1104A	;Exit vector for QTRIRQ;_______________________________________________________________________________LapExit	PROC	plp	;Get back mode (must be full native).	longa on	and #$ff	;Mask off high byte.	beq NolErr	;If successful, leave high byte alone.	ora #$200	;Otherwise, make it	a LAP error.	bra NolErr	entry LAPExit2	; EXPORT -> ENTRY  **TGHLAPExit2		;       	plpNolErr		; 	ldy #lp_result	;Point to the LAP result field.	sta [cmndList],y	;Store result. A MUST contain the	longa off	;result when we exit!!!! Don't change	rtl	;or you will die.		ENDP******************************************************************  'LAPWrite' can be called only with a	parameter list.******************************************************************LAPWrite	PROC EXPORT	jsr EnterCrit	php	ldy #lw_bds	;Get low word of BDS pointer.	lda [cmndList],y	sta txBDS	;Store it for XmitPacket.	iny	;Point to high word.	iny	lda [cmndList],y	;Get high word.	sta txBDS+2	;Store for XmitPacket.	sep #MBit	;8 bit A.	ldy #lw_dest	;Now get the destination for the write.	lda [cmndList],y	sta dest	;Store it.	ldy #lw_lapType	;Get the LAP type.	lda [cmndList],y	beq @L1	;LAPTypes of 0 or	bmi @L1	; > 127 are illegal!	sta lapType	;Store it.	jsr XmitPacket	jsr ExitCrit@L2	jmp LAPExit	;Return, storing A in the result code.@L1	lda #IllProtErr	;Illegal LAP type.	bra @L2	ENDP******************************************************************  'GetInfo' must be called with a parameter list.**  Inputs:**  Outputs:******************************************************************* GWS 2/10/88 - the	paramater list has been expanded to support* the return of the	node number and an extra byte for the romversion*****************************************************************GetInfo	PROC EXPORT	php	longa on	ldy #gi_return	lda Cnxx+1	;Plus 1 to get to bank byte of vector	and #$FF00	ora #OfstCnxxRet	;ORA in the Cnxx offset for addr of	sta [cmndList],y	;socket listeners, protocol handlers,	lda #0	;and completion routines.	iny	;Move to high word of return address.	iny	sta [cmndList],y	;Set to bank zero.	iny	iny	;Move on to network	field.	lda ThisNet	;Get our network #.	sta [cmndList],y	;Store in list (byte reversed...)	iny	iny	;Move to bridge field.	lda ABridge	;Get node # of a bridge, any bridge.	sta [cmndList],y	iny	;Move to machine ID	and ROM version #.	lda #MID	;Get ONE bytes of info!  **TGH*	lda #MID+256*RomVer	;Get two bytes of info.  **TGH	sta [cmndList],y	iny	;now store rom id as a word (GWS 5/20/88)	lda #RomVer	;This used to look at C7FE like it		;should, but I can't tell if it's in		;C1FE or C2FE so I just hard coded what's		;there, figuring CnFE won't change without		;changing RomVer in this code.	sta [cmndlist],y	lda source	;get our node number (GWS 2/10/88)	and #$00ff	;set high byte to zero	iny	iny	;move to high byte of romver field	sep #mbit	;store a byte for node	sta [cmndlist],y	;save it	rep #mbit	lda #0	;No error.	jmp LAPExit	longa off	ENDP******************************************************************  'LAPInit' can be	called with either a parameter list or parameters in*  registers.  If C	is set, registers are used.*  When registers are used, there are no parameters.**  Inputs:  A = starting node number.**  Outputs: A = node number chosen.*****************************************************************LAPInit	PROC EXPORT	php	sep #MBit	;8 bit A.	rep #XBit	;16 bit index.	bcs Direct	;This way if direct	mode.	ldy #li_flag	;See which kind of init to do.	lda [cmndList],y	bpl NotFull	;If bit 7 reset, not a full init.	ldy #li_node	;Get the node number to start with.	phy	;Save pointer to li_node.	lda [cmndList],y	sec	;Now use direct mode.	jsr LAPInit	ora #0	bne OK	lda #EnableErr	;AppleTalk not enabled.	ply	bra ExitOK		; 	ply	sta [cmndList],y	;Store the node actually picked.NotFull		; 	lda #0Exit		; 	jmp LapExit	;Stores result in param list.Direct		;; We no longer check to see if appletalk is in slot 7.  We only check if appletalk; is in slot 1 or slot 2.;;	pha	;Save node number.;	lda USERSLT7	;Check to see if AppleTalk is enabled.;	beq GoAhead	;Yes, it's enabled.;	pla	;Get back node #.;	lda #0	;Error: AppleTalk not enabled.;	plp;	rts	pha	;Save node number.	ldx #SCCBReg	;Assume AppleTalk is port B.	ldy #MouseB	;Get pointer to line activity counter.	lda #RecvIntsB	;Interrupt mask for	port B ATalk.	pha	;Save on stack for later.	lda #ResetB	;Channel B reset code.	pha	;Save on stack.	lda atport	cmp #$02	beq UsePortB	cmp #$01	beq UsePortA	pla	;Oops, AppleTalk not enabled!	pla	;Strip interupt mask, reset code,	pla	;and node number of the stack.	lda #0	plp	rts;GoAhead		; ;	ldx #SCCBReg	;Assume AppleTalk is port B.;	ldy #MouseB	;Get pointer to line activity counter.;	lda #RecvIntsB	;Interrupt mask for	port B ATalk.;	pha	;Save on stack for later.;	lda #ResetB	;Channel B reset code.;	pha	;Save on stack.;	lda USERSLT1	;Which port is AppleTalk in?;	beq UsePortB	;0: A is serial, so	ATalk is B.;	inx	;1: move ahead to serial port A.;	dey	;Move back to channel A activity port.;	lda #RecvIntsA	;Interrupt mask for	port A ATalk.;	sta 2,s	;Replace interrupt mask on stack.;	lda #ResetA	;Channel A reset code.;	sta 1,sUsePortA	inx	;1: move ahead to serial port A.	dey	;Move back to channel A activity port.	lda #RecvIntsA	;Interrupt mask for	port A ATalk.	sta 2,s	;Replace interrupt mask on stack.	lda #ResetA	;Channel A reset code.	sta 1,sUsePortB	stx whichSCC	sty whichMouse	stx sccReg	;Control register pointer.	inx	inx	stx sccDat	;Data register pointer.	php	;Push mode and disable ints.	sei	lda #0	;Send synch byte to	SCC.	sta (sccReg)	lda #9	;Point to reset register.	sta (sccReg)	lda 2,s	;Get back SCC reset	code for our port.	sta (sccReg)	;Reset the port.	plp	;Restore mode and fix stack.	pla* Initialize variables with 0, fill protTable with $ff.	php	;Save mode.	rep #MBit	;16 bit A for MVN.	longa on	stz colHist	;Clear the first byte of vars that	ldx #colHist	;must be zero.  Point to that byte	txy	;and use as source for MVN.	iny	;Use next address as dest for MVN.	lda #14	;Number of bytes to	clear - 1.	mvn $e1e1e1,$e1e1e1	;Clear the bytes.	dec protTable	;Change the first byte of protTable to	lda #MaxProts*6-2	;$ff, and fill the table with that	mvn $e1e1e1,$e1e1e1	;value.* GWS 6/8/88* moved initialzation of variables related* to stack save routines* into the lapresetinit routine, so they* would be set up properly before ever* going through the dispatcher.** Now initialize the SCC for AppleTalk mode.	longa off	longi off	sep #MBit+XBit+IBit	;8 bits and disable	interrupts.	ldx #0	;Point to first byte.	ldy #SCCTabSize	;Get size of table.InitLoop		; 	lda >SCCTable,x	;Get a byte at a time to initialize the	sta (sccReg)	;SCC for AppleTalk mode.	inx	;On to next byte.	dey	bne InitLoop	plp	;Restore mode.	longi on	jsr RecvInit* Now init packet buffer maintenance variables.	ldx #Base+MaxSize	;Set up initial 'curEnd' value to	stx curEnd	;point to the end of the first	lda #$E0	;packet buffer in the bank E1 language	sta curEnd+2	;card space (E0 + offset ---> E1).	ldx #Base	;Set up the pointer	to the beginning of	stx curWBuf	;the first write buffer.	stx curRBuf	;Also the read buffer.	rep #MBit	longa on	stz |buf_next,x	;Clear curRBuf->next.	ldx #-(MaxData+2)	;Set up offset to point to the start of	stx curOffset	;the LAP data field.* Now set up interrupt vectors.	phk	phk	pla	;Get high byte of vector address in A.	and #$ff	;Mask off high byte.	pea 0	;This signals the end of the calls.	pea 4	;Now enable the quarter sec interrupt.	pea $2303	;IntSource tool number.	pea 8	;Install AppleTalk interrupt vector.	pha	;Push bank of vector.	pea PacketIRQ	;Low Word of address.	ldx #$1003	;SetVector tool number.	phx	;Put on stack for below.	pea 14	;Install quarter sec interrupt handler.	pha	;Push bank word of vector.	pea QtrSecIRQ	;Low word of address.ToolLoop		; 	jsl $E10000	;Make a call.	plx	;Get the next tool call number.	bne ToolLoop	;If not zero, do another call.	sep #MBit	;8 bit A.	longa off	pla	;Get back AppleTalk	interrupt mask.	sta SCCFlag2	;Store it in the right spot.	pla	;Get back node number.	beq specialnd	;get workstation random node using battery	cmp #$ff	;see if server random wanted	bne NotZ	;they want to specify start nodespecialnd		; 	pha	;save node mask	rep #MBit+XBit	;from battery RAM. Full native for	pea 0	;tool call.  Space for result.	pea $80	;Parameter value for node #.	ldx #$0C03	;ReadBParam tool call number.	jsl $E10000	;Do the call.	pla	;Get the result.	sep #MBit+xbit	;8 bit A. and X	plx	;get node flag	bmi specialsrv	and #$7f	;put in workstation	range	bra NotZspecialsrv		; 	ora #$80	;must have high bit	onNotZ		; 	rep #xbit	;back to 16 bit x*****************************************************************  'NewNode' tries to find an unclaimed	node number on the network.  If the*  value passed in A is 0, it picks a random non-server node number and*  increments it until it has found an address.  If A holds	$ff, a random*  server node number is picked and incremented until an address has been found.*  Any other number	in A is used as the	first attempt and similarly incremented*  until an address	is found.**  Inputs:  A = 0 for randomly assigned	non-server node (1..127).*           A = 255	for randomly assigned server node (128..254).*           A = n for randomly assigned	node, using 'n' to start the search.**  Outputs: A,X trashed.*           'source' holds the node we picked.******************************************************************NewNode		; 	stz addrValid	ldx #127	;X is the number of	nodes to try.	inc A	;Check for 255.	bne NNNotServer	;If not 255, check for 0.	jsr Random	;Get a random number.	lda seed+1	ora #128	;Make it a server node.	cmp #255	;Illegal?	bne NNTryNode	;No. Try it.	dec A	;Back up to a legal	value.	bra NNTryNode	;Try it.NNNotServer		; 	dec A	;Now check for 0.	bne NNTryNode	;If not 0, use as a	starting node num.	jsr Random	;If 0, get a random	byte	lda seed+1	and #127	;and turn it into a	non-server node.	bne NNTryNode	;If not zero, try it.	inc A	;Otherwise, inc to 1.NNTryNode		; 	phx	pha	jsr TryNode	;See if anyone else	has this node.	pla	plx	bcs NNNextNode	;Carry set -> node taken, try next one.	sta addrValid	;Node unclaimed: set the 'addrValid'	rep #MBit+XBit	;flag, store node #	in battery RAM. Full	pha	;native for tool call. Put node # on	pha	;stack, and again for later.	pea $80	;Parameter value for node #.	ldx #$0B03	;WriteBParam tool call number.	jsl $E10000	;Do the call.	pla	;Get back the node #.	plp	;Restore mode and return with	rts	;the node in A.NNNextNode		; 	inc A	;Try next node number.	cmp #255	;Check for invalid server node number.	bne NNNot255	;Nope.	lda #128	;Restart with the next valid server.	bra NNCheckDone	;See if done yet.NNNot255		; 	cmp #128	;Check for invalid non-server node.	bne NNCheckDone	;Nope.	lda #1	;Restart with the next valid node.NNCheckDone		; 	dex	;See if we've tried all 127 nodes.	bne NNTryNode	;X <> 0 --> not done, try this node.	lda #$FF	;Tried 128 times, but didn't get a	plp	;node.  Return $FF.	rtsSCCTable		; 	DC.B 1,DisRxInt	;Disable receiver interrupts.	DC.B 15,0	;No external interrupts.	DC.B 4,SDLCMode	;Set SDLC mode.	DC.B 3,DisRx	;Disable receiver.	DC.B 5,EnbTx	;Enable transmitter.	DC.B ResetUnd	;Reset underrun latch.	DC.B ResTxCRC	;Reset transmit CRC.	DC.B 5,DisTxRTS	;Disable transmitter.	DC.B 7,SDLC	;Set SDLC flag pattern.	DC.B 10,SetFM0	;Set FM0 transmission.	DC.B 11,ClocksA	;Set clock usage.	DC.B 12,BaudRate	;Low byte of baud rate.	DC.B 13,0	;High byte of baud rate.	DC.B 14,FMMode	;Set FM mode on phase locked loop.	DC.B 14,SrchMode	;Set search mode on	phase locked loop.	DC.B 1,EnbRxInt	;Enable first character interrupts.SCCTabEnd		; SCCTabSize	equ SCCTabEnd-SCCTable* lapresetinit** code to be called	to make sure that we start* off pointing to no packets, so we won't have* to worry about anyone calling the dispatch* routines indirectly before appletalk gets* initialized* this routine is called during either a hard* or soft reset.* we also initialize some variables that are* used by stack saving routines, since these* routines get called by the dispatcher, we* had better make sure they are set up properly*	EXPORT lapresetinitlapresetinit		;* Now init packet buffer maintenance variables.	php	rep #xbit	longi on	sep #mbit	longa off	ldx #Base+MaxSize	;Set up initial 'curEnd' value to	stx curEnd	;point to the end of the first	lda #$E0	;packet buffer in the bank E1 language	sta curEnd+2	;card space (E0 + offset ---> E1).	ldx #Base	;Set up the pointer	to the beginning of	stx curWBuf	;the first write buffer.	stx curRBuf	;Also the read buffer.	rep #MBit	longa on	stz |buf_next,x	;Clear curRBuf->next.	ldx #-(MaxData+2)	;Set up offset to point to the start of	stx curOffset	;the LAP data field.	stz stksaveflag	;Clear the first byte of vars that	ldx #stksaveflag	;must be zero.  Point to that byte	txy	;and use as source for MVN.	iny	;Use next address as dest for MVN.	lda #(E1End-stksaveflag)-1 ;Number of bytes to clear - 1.	mvn $e1e1e1,$e1e1e1	;Clear the bytes.	plp	rts	;and return	ENDP******************************************************************  'TryNode' checks	to see if the node number passed in A is occupied by*  another node on the network.**  Inputs:**  Outputs: A,X trashed.*           C flag cleared for node free, set for node in use.*****************************************************************TryNode	PROC	longa off	longi on	ldx #120	;Assume it's a server: use large	ora #0	;maxtries.  Check it out...	bmi Server	;Yes, it is.	ldx #20	;No, it's not.  Use small maxtries.Server		; 	sta dest	;Use A as our dest address as well as	sta source	;our node address.	php	;Save mode.	pha	;Save node # on stack.	sei	;Turn off ints while accessing SCC.	lda #AddrReg	;Point to the address register.	sta (sccReg)	pla	;Get back node number.	sta (sccReg)	;Use for SCC's address.	plp	;Restore mode.	lda #LAPEnq	;Set LAP type to Enq.	sta lapType	stz addrUsed	;Assume not used.TNLoop		; 	phx	;Save X.	jsr XmitPacket	;Transmit the Enq, detect response.	plx	;Restore X.	lda addrUsed	;See if any packets	came to this	beq NotClaimed	;address.  If so, the address is used.	sec	;Set carry and return, indicating	rts	;that the address is used.NotClaimed		; 	dex	;If not claimed after maxtries,	bne TNLoop	;we believe that this address is truly	clc	;free.  Clear carry	and return.	rts	ENDP******************************************************************  'Random' uses the number in 'seed' as a base for a new random number,*  which replaces 'seed'.**  Inputs:**  Outputs:*****************************************************************Random	PROC	php	;Save mode.	rep #MBit	;16 bit A.	longa on	lda seed-1	;Get seed * 256 + garbage.	and #$ff00	;mask off the garbage.	pha	;Save seed * 256.	asl A	;A = seed * 512.	clc	adc 1,S	;A = seed * 768.	clc	adc seed	;A = seed * 769.	sta 1,S	;Save seed * 769.	lda seed	;A = seed.	asl A	;A = seed * 2.	asl A	;A = seed * 4.	clc	adc 1,S	;A = seed * 773.	inc A	;A = seed * 773 + 1.	sta seed	;Update seed.	pla	;Fix stack.	plp	;Restore mode.	rts	longa off	ENDP******************************************************************  'LAPRead'*  'LAPRead' can be	called with either a parameter list or parameters in*  registers.  If C	is set, registers are used.**  Inputs:  X,Y = pointer to data buffer (Y = high word).*           A = # of bytes to read (16 bit A).  Bit 15 is the purge bit: if set,*           the buffer will be removed from the buffer list.**  Outputs: A = result code, X = number	of bytes actually read.*****************************************************************LAPRead	PROC EXPORT	php	bcs ILAPRead	;Go do direct call.	ldy #lr_buffer	;Get the buffer address.	lda [cmndList],y	tax	;Put low word of address in X.	iny	;Move to high word.	iny	lda [cmndList],y	;Get high word.	pha	;Save on stack.	ldy #lr_count	;Get the requested byte count.	lda [cmndList],y	pha	;Save byte count on	stack.	ldy #lr_purge	;Get purge flag.	lda [cmndList],y	longa on	and #$ff	;Ignore high byte.	beq NotSet	;Flag is not set, A	is 0.	lda #$8000	;Set purge flag.NotSet		; 	ora 1,s	;OR byte count with	purge flag (bit 15).	ply	;Remove byte count from stack.	ply	;Get high word of address in Y.	sec	;Now do direct call.	jsr LAPRead	;Do the call.	pha	;Save the result.	txa	;Get back # of bytes read in A.	ldy #lr_actual	;Get offset to field for number read.	sta [cmndList],y	pla	;Get back result.	jmp LAPExit	;Save the result, return.******************************************************************  'ILAPRead' reads	the number of bytes	specified by A into	the buffer*  pointed to by X and Y (Y = high word).  The result code is returned in A.**  Possible results:*           NoErr: Read successful.*           EndErr:	Reached the end of the buffer before reading the number of*	bytes specified.*           BufErr:	No packet buffer.**  Inputs:  X,Y points to buffer (Y high word), A specifies	# of bytes to read.*           16 bit A, 16 bit X.  Data bank = $E1.**  Outputs: A = result code, X = number	of bytes actually read.******************************************************************ILAPRead		; 	jsr EnterCrit	rep #MBit+XBit	longa onMVNAddr	equ $84	pha	;Store purge bit and count.	lda curPos	;Is there a buffer open?	bne IsBuf	;Yes.	lda #BufErr	;No: report error.	plx	;Remove stuff from stack.	plp	;Get back mode.	jmp ExitCrit	;Return through ExitCrit.IsBuf		; 	pla	;Get back the count.	pea 0	;Assume no error, push error code.	pha	;Save count.	and #$7fff	;Mask off the purge	bit.	pha	;Store the count.	lda curLen	;See if there are enough bytes in the	cmp 1,s	;buffer to satisfy the requested count.	bcs Enough	;Yes.	sta 1,s	;No: use the number	available instead	lda #EndErr	;of that specified and indicate error.	sta 5,s	;Store in error loc.	bra ExactEnough		; 	beq Exact	;Exactly the right length!	lda 3,s	;See if purging.	bpl Exact	;No: ignore if buffer is 'too small.'	lda #ShortErr	;Otherwise, the buffer is too short.	sta 5,sExact		; 	txa	;Move low dest address to a for boundry	check	clc	adc 1,s	;add to count to see if bank wrap would	happen	bcc domvn	;no, so lets use MVN code for speed	lda 1,s	;get count	beq Zero	;nothing to move	stx MVNAddr	;Store low word of destination address	sty MVNAddr+2	;Store high word of	destination address	tay	;use as index and counter	clc	phy	;use to calculate offset	lda curPos	;get start of buffer	adc 1,s	;move to end position	plx	;discard stack stuff	tax	;move index to x register (points to last char)	tya	;get index for odd test	lsr a	;see if number of bytes to move is odd	bcc lapmovelp	;go ahead and move 2 bytes at a pop	dey	;only do one byte to get us on an even keel	dex	sep #mbit	lda |0,x	;get the source byte	sta [mvnaddr],y	;and store the odd byte	rep #mbit	;back to 16 bit accumlapmovelp		; ;should always be	working with even number of bytes	dey	;when we get this far.	dey	;back up counter	bmi Zero	;we are done when this is less than zero	dex	dex	;and source position	lda |0,x	;get 2 source bytes	sta [mvnaddr],y	;and move them	bra lapmovelp	;go do moredomvn		; 	lda #MVNOp	;Set up a move instruction in ZP.	sta MVNAddr	sty MVNAddr+1	;Put dest bank from	Y in ZP, then source	lda #$E1+256*RTLOp	;bank ($e1), then RTL instruction.	sta MVNAddr+2	txy	;Move low dest address to Y for MVN.	ldx curPos	;Move low src address to X for MVN.	lda 1,s	;Get the count.	beq Zero	dec A	;Adjust the count.	phb	;Save bank on stack.	jsl >MVNAddr	;Do the move.	plb	;Get it back.Zero		; 	lda curLen	;Modify the length of the rest of the	sec	;packet.	sbc 1,s	;Subtract the number of bytes read.	sta curLen	;Store it.	lda curPos	;Also modify the current read position.	clc	adc 1,s	;Add the number of bytes read.	sta curPos	plx	;Get back count.	pla	;Get back purge bit.	bpl NoPurge	;Don't purge.	stz curPos	;Purge: no buffer anymore.	phx	;Save count during freebuf.	sep #MBit	;8 bit A for freebuf.	jsr FreeBuf	;Purge the buffer.	rep #MBit	;Back to 16 bits.	plx	;Get back count.NoPurge		; 	pla	;Get back result.	plp	;Restore mode.	jmp ExitCrit	;Return through ExitCrit.	longa off	ENDP******************************************************************  'GetGlobal' must	be called with a parameter list.******************************************************************* GWS 2/10/88 - fixed bug where we would hang if you called	this* before actually receiving any data.*****************************************************************GetGlobal	PROC EXPORT	php	longa on	longi on	lda curpos	;see if anything valid has been received	bne getglobok	;there is something	to read (GWS 2/10/88)	lda #$200+buferr	;we got a buffer error	jmp LapExit2	;get out of heregetglobok		; 	ldy #gg_buffer	;Get the buffer address.	lda [cmndList],y	tax	;Put low word of address in X.	iny	;Move to high word.	iny	lda [cmndList],y	;Get high word.	tay	;Put high word of address in Y.******************************************************************  'IGetGlobal' reads the first 16 bytes of the packet, including the LAP*  header, into the	buffer pointed to by X,Y (Y = high word).  The result code*  is returned in A, and the number of bytes actually read is returned in X.**  Possible results:*           NoErr: Read successful.*           BufErr:	No packet buffer.*           EndErr:	Reached the end of the buffer before reading 16 bytes.**  Inputs:  X,Y points to buffer (Y high word).*           16 bit A, 16 bit X.  Data bank = $E1.**  Outputs: A = result code, X = number	of bytes actually read.******************************************************************IGetGlobal		; 	jsr EnterCrit	longa on	stx execaddr	sty execaddr+2	;set up pointer to users buffer	ldx curRBuf	;Get pointer to the	actual buffer.	lda |buf_len,x	;Get the length of the packet.	adc #3	;Add 3 for the LAP header.	ldy #ggb_length	;offset to length part of users buffer	sta [execaddr],yggmove		; ;needs y to be set to length field offset	dey	dey	bmi ggmovedone	;we are done moving	data	lda |lapdest,y	;get data to move	sta [execaddr],y	;move the data to the users buffer	bra ggmove	;and move some moreggmovedone		; 	lda #0	;no errorNotErr		; 	jsr ExitCrit	jmp LAPExit2	longa off		ENDP	******************************************************************  'AttachProt' can	be called with either a parameter list or parameters in*  registers.  If C	is set, registers are used.**  Inputs:  A = the	protocol number, X,Y = handler address (Y = high word).**  Outputs: A = result.*****************************************************************AttachProt	PROC EXPORT	EXPORT lattachprotlattachprot		;       	php	bcs IAttachProt	;Go do direct call.	ldy #ap_handler	;Get the handler address.	lda [cmndList],y	tax	;X gets low address	word.	iny	;Move to the high word.	iny	lda [cmndList],y	;Get high address word.	pha	;Save on stack.	ldy #ap_prot	;Get the protocol type.	lda [cmndList],y	ply	;Y gets high address word.	sec	;Direct call.	jsr AttachProt	;Do the call.	jmp LAPExit	;Exit, setting result.IAttachProt		; 	sep #MBit	phx	phy	jsr EnterCrit	;Critical code portion.	cmp #$FF	;Is it the catch all protocol handler?	bne NotCatch	ldx catchProt	bne IsDup	;If a catch-all is installed, duplicate	ldx catchProt+2	bne IsDup	;Ditto.	ply	;Otherwise, we can install as catch-all	sty catchProt+2	;handler.	plx	stx catchProt	bra ExitOKNotCatch		;	jsr FindProt	;See if the protocol is already there.	bcs IsDup	;If so, error.	ldx freeProt	;Did FindProt find a free protocol	bpl NotFull	;slot?  If positive, yes.	lda #FulProtErr	;Negative: protocol	list full.	bra ErrorNotFull		; 	ora #0	beq Illegal	;If 0, illegal.	bpl Legal	;If < $80, legal.Illegal		; 	lda #IllProtErr	;Otherwise, illegal	protocol type.	bra ErrorLegal		; 	sta |protTable,X	;Store the prot #.	rep #MBit	;16 bit A.	pla	;Get high word of handler address.	sta |protTable+4*MaxProts,X ;Store in the entry.	pla	;Get low word of address.	sta |protTable+2*MaxProts,X ;Store it.ExitOK		; 	longa on	;Not always true, but we use a NOP to	lda #NOPOp*256	;make things OK.  Clears low byte for	longa off	;successful result code.Exit		; 	plp	jmp ExitCrit	;No longer critical, and return.IsDup		; 	lda #DupProtErr	;Else, return duplicate error.Error		; 	ply	plx	bra Exit	ENDP******************************************************************  'FindProt' sees if the protocol # passed in A has a handler in the table.*  If so, a pointer	to the table entry is in X and C = 1.  If not, 'freeProt'*  is set to point to a free entry in the table (or $ffff if none) and C = 0.**  Inputs:**  Outputs:*****************************************************************FindProt	PROC	ldy #$ffff	;Assume that no free slot can be   	ldx #MaxProts*2	;found.  Point to past end of table.FPLoop2		; 	sty freeProtFPLoop		; 	dex	dex	bpl NotEnd	;If +, not at end of table.	clc	;Otherwise, clear C	to indicate	rts	;entry not found and return.NotEnd		; 	cmp |protTable,x	;See if this is the	protocol.	bne NotThis	sec	;This is the one.  Set C to indicate	rts	;we found it and return.NotThis		; 	ldy |protTable-1,x	;Get entry's prot type in high byte.	bpl FPLoop	;If not minus, it's not free, so loop.	txy	;Else record a free	slot's position.	bra FPLoop2	ENDP******************************************************************  'RemoveProt' can	be called only with	parameter list.*****************************************************************RemoveProt	PROC EXPORT	php	sep #MBit	;8 bit A.	ldy #rm_prot	;Get the protocol to remove.	lda [cmndList],y	jsr EnterCrit	;Enter critical section.	cmp #$FF	;See if it's the catch-all protocol.	bne NotCatch	ldx catchProt	;Is there a catch-all protocol handler	bne OK	;installed? Yes, can remove it.	ldx catchProt+2	beq Missing	;Not installed: can't remove it.OK		; 	ldx #0	;Clear the catch all handler.	stx catchProt	stx catchProt+2	txa	;0 result code for success.	bra ExitNotCatch		; 	cmp #00	;see if illegal type	beq Rillegal	;yes, so report error	bmi Rillegal	;also bad if negative	jsr FindProt	;See if we can find	this protocol.	bcs Found	;Yes: maybe remove it.Missing		; 	lda #MisProtErr	;Protocol is missing, so can't remove	bra Exit	;it. Return.Rillegal	lda #IllProtErr	;illegal protocol type	bra ExitFound		; 	lda #$ff	;If not, it can be removed from the	sta |protTable,x	;table by making its slot empty.	inc A	;Inc to successful result code (0).Exit		; 	jsr ExitCrit	;No more critical code: return.	jmp LAPExit	;Go back.	             	ENDP		Save16	PROC	php	rep #MBit+XBit	longa on	phx	;We save X only.	ldx #cmndList	;Save ZP space.	lda #16	;Save 16 bytes.	jsr SaveZP	plx	;Get back X.	plp	rts	longa off	ENDPRestore16	PROC	php	rep #MBit+XBit	longa on	phx	;We save X only.	ldy #cmndList	;Restore ZP space.	lda #16	;Restore 16 bytes.	jsr RestoreZP	plx	;Get back X.	plp	rts	longa off	ENDPGetBank	PROC	lda StateReg	ply	;Get return address.	pha	;Save memory state.	phy	;Put return address	back.	lda LCBank2	;Read language card	RAM.	lda LCBank2	;Also write it.	rts	ENDPUnGetBank	PROC	ply	;Get return address.	pla	;Get previous memory state.	sta StateReg	phy	rts	ENDP******************************************************************  'PacketIRQ' handles packet interrupts.**  Inputs:**  Outputs:******************************************************************* GWS - 2/10/88 - we no longer accept packets when our buffer* space is full, before we accepted the	packet and threw it	away* this also fixes, by default, the problem we had where we didn't * set the needData flag back to zero in	all cases.*****************************************************************PacketIRQ	PROC	rep #XBit	;16 bit indexes.	ldx whichSCC	;Get pointer to current SCC port.	lda |2,X	;Get the 3rd data byte, which has been	sta scc3	;waiting for us, and save it.	jsr GetBank	;Save StateReg, change to LC bank 2.	jsr Save16	;Save 16 bytes of ZP on private stack.	stx sccReg	;Store address of control register.	inx	inx	stx sccDat	;Store address of data register.	stz pktError	;No receive errors (yet).	lda scc3	;Look at LAP type: if it's not a LAP	bmi LAPPkt	;control packet, ignore it and exit.ExitBranch		; 	jmp ExitPktIRQLAPPkt		; 	sec	;Indicate single byte mode to RecvBytes.	jsr RecvBytes	;Get first byte of CRC.	bcc ExitBranch	;C = 0 means last byte. Error, so exit.	jsr RecvBytes	;Get second byte of	CRC.	bcs ExitBranch	;Not last byte. Error, so exit.	lda pktError	;See if any errors occured during	bmi ExitBranch	;reception.  Yes, exit.	inc scc1	;Look at dest address.	beq BCast	;If it's not broadcast,	sta addrUsed	;show activity on our address.BCast		; 	lda addrValid	;If our address isn't valid,	beq ExitBranch	;exit.	lda scc3	;No errors. Look at	the LAP type.	cmp #LAPRTS	;Is it a request to	send?	bne NotRTS	;No.	ldy curOffset	;Get offset to current buffer (GWS 2/10/88)	beq ExitBranch	;buffer is empty so	don't send CTS	ldx curEnd	;Set ptr0 = curEnd.	stx ptr0	ldx curEnd+2	stx ptr0+2	inc needData	;Indicate that we need a data packet.	stz gotData	;No data yet.	lda scc1	;See if broadcast.	bne DoCTS	;If not, do a CTS.	jsr RecvInit	;Otherwise, init the receiver for the	bra GetData	;data packet and try to receive.DoCTS		; 	ldx scc2	;Get source of the RTS and use it as	lda #LAPCTS	;the dest for a CTS	packet.	jsr fXmitLAP	;Send the CTS (without sync) and init the receiver.GetData		; 	ldy curOffset	;Get offset of current buffer.	jsr RecvPacket	;Try to receive the	data packet.	stz needData	;Back to normal mode. (should always get here after inc above)	lda gotData	;See if we got the data.	beq ExitNoInit	;Nope.	jsr NewPacket	;Yep.  Add the packet to the list.TryDispatch		; 	lda busyFlag	;See if higher level protocols are busy.	bne ExitNoInit	;Busy, so don't try to dispatch a pkt.	jsr dothedispatchNotRTS		; 	cmp #LAPEnq	;Is it an enquiry?	bne ExitPktIRQ	;No.  We don't handle it.	ldx scc2	;Get source of the Enq and use it as	lda #LAPAck	;the dest for an Ack packet.	jsr fXmitLAP	;Send the Ack (without sync) and init the receiver	bra ExitNoInit	;and exit.ExitPktIRQ		; 	jsr RecvInit	;Initialize receiver for other packets.ExitNoInit		; 	jsr Restore16	;Restore 16 bytes of ZP from our stack.	jsr UnGetBank	;Restore memory state.	sep #XBit+MBit	;For returning to interrupt handler.	lda #3	;Point to RR3 (interrupt status reg).	sta sccAReg	lda sccAReg	;Get the latest value of RR3 to replace	ora SCCFlag2	;Fern's byte saved on the stack, and set	sta 4,s	;our bit so he'll know we did something.	clc	;Clear C to indicate we serviced the	rtl	;int.dothedispatch		; * WARNING!!!* we use the overflow flag to indicate whether or not* we need to save the 16 bytes of zero page since the* other zero page was saved on the aux side before we* did a switch...therefore, MAKE SURE ANY CODE ADDED* DOES NOT AFFECT THE OVERFLOW BIT BETWEEN WHERE WE* SET IT AND WHERE WE PUSH A COPY OF IT ONTO THE STACK*	inc busyFlag	;Make it busy for Dispatch.	jsr SaveState	;Save interrupt vars. so interrupts can	occur again	tsx	;get current stack pointer	stx dstack	;save for later	sep #xbit+vbit	;8 bit x, set overflow bit to indicate normal stack	tsc	;get stack in a for	tests	xba	;see what page of memory stack is in	eor #1	;is it page 1	bne notinauxarea	;no, so don't need to worry about stack being in aux	ldx rdaltzp	;see if alt stack is in	bpl notinauxarea	;not in, so use stack as is	xba	;get low word of stack pointer back	sta >altsp	;and save, so we can get it later	lda #1	xba	lda >mainsp	;get main stack pointer	tcs	;and use it	clv	;we had the aux stack in, so must save main zpnotinauxarea		; 	lda statereg	;get state	sta dstate	;save it	ldx |rd80col	;see if 80store set	bpl irno80	;no	and #$bf	;force page 1irno80		; 	and #$40	;put in standard state	ora #$08	sta statereg	;now we are in a known state	lda lcbank2	lda lcbank2	;appletalk needs lcbank2 read/write enabled	rep #xbit	;back to 16 bit x	php	;save a copy of v bit (flag for which zp was in)	bvs @noextrasave	;no need to save zero page, already done	jsr Save16	;save the 16 bytes of zero page on the main side@noextrasave	php	rep #mbit+xbit	jsl incbusyflag	;don't let scheduler come in here (critical code)	plp	cli	;occur again, and turn on ints.	jsl PDispatch+$E10000 ;while (busy == 0) dispatch packets.	sei	;Interrupts off.	lda #$e1	;make sure bank e1 restored	pha	plb	dec busyFlag	;Remove the busy set for Dispatch.	rep #mbit+xbit	lda dstate	pha	;need to use stack,	since	lda dstack	;decbusyflag may re-enable ints	pha	;causing these vars	to get changed	jsl decbusyflag	;let scheduler dispatch now (atalk active again)	plx	;recover the dstack	variable	pla	;get the state variable	plp	;should be 8 bit a,	16 bit x	bvs @noextrarestore	;no need to do the restore	pha	jsr Restore16	;restore the main zero page that was saved above	pla	;recover the state variable@noextrarestore	sta statereg	;and restore it	txs	;restore stack	jsr RestorState	;Get back interrupt	vars.	rts	;and return	ENDP******************************************************************  'QtrSecIRQ' handles quarter second interrupts.**  Inputs:**  Outputs:*****************************************************************QtrSecIRQ	PROC	php	phb	sep #MBit	rep #XBit	;16 bit index.	lda #$E1	;Point to bank E1.	pha	plb	sta CLRVBLINT	;Clear the 1/4 sec interrupt.	inc deltaT	;Time since the dispatcher got called.	lda busyFlag	;Can we call the dispatcher now?	bne NoDispatch	;No.	jsr GetBank	;R/W LC bank 2, save StateReg on stack.	jsr SaveState	;Save state so ints	can occur again.	jsr Save16	;Save some ZP.	lda deltaT	;Tell the dispatcher how long it's been.	stz deltaT	;Clear timer.	inc busyFlag	;We're busy.	rep #MBit	;16 bit A for dispatch.	jsl incbusyflag	;tell scheduler we are critical	cli	;Enable those ints!	jsr stacksave	;save off stack if needed	jsr QtrSched	;Go to the scheduler.	sep #MBit	;8 bit A for PDispatch.	jsl PDispatch+$E10000 ;Dispatch packets.	jsr stackrestore	;restore the stack space	dec busyFlag	;Not busy anymore.	php	rep #mbit+xbit	jsl decbusyflag	;let the scheduler call it's task	jsl OnExitVector	;Call our new vector!	plp	sei	;Disable ints.	jsr Restore16	;Get back ZP.	jsr RestorState	;Get back info.	jsr UnGetBank	;Restore memory state.NoDispatch		; 	plb	plp	clc	rtl	ENDP******************************************************************  'SaveState' puts	interrupt vars on our private stack.**  Inputs:**  Outputs:*****************************************************************SaveState	PROC	php	rep #MBit+XBit	longa on	ldx #irq_intflag	lda #9	;Save 9 bytes.	jsr SaveE1	;Save other interrupt vars on stack.	ldx #irq_A	lda #19	;Save 19 bytes.	jsr SaveE1	;Save interrupt vars on private stack.	sep #MBit	;8 bit A.	stz |irq_active	;Pretend ints are not active.	plp	longa off	rts	ENDP******************************************************************  'RestorState' gets interrupt vars off of our private stack.**  Inputs:**  Outputs:*****************************************************************RestorState	PROC	php	rep #MBit+XBit	longa on	ldy #irq_A	lda #19	;Restore 19 bytes.	jsr RestoreE1	;Restore interrupt vars fromon stack.	ldy #irq_intflag	lda #9	;Restore 9 bytes.	jsr RestoreE1	;Restore other vars	from stack.	plp	longa off	rts	ENDPLongForbid	PROC EXPORT	jsr Forbid	rtl	ENDPLongPermit	PROC EXPORT	jsr Permit	rtl	ENDP******************************************************************  'EnterCrit'**  Inputs:**  Outputs:*****************************************************************EnterCrit	PROC	EXPORT lforbidlforbid		;       	EXPORT ForbidForbid		; 	pha	php	phb	sep #mbit	longa off	lda >statereg	;get state of machine	pha	and #$cf	;bits 4&5 zero force read and write main bank	sta >statereg	rep #mbit+xbit	jsl incbusyflag	;tell scheduler we are busy	sep #MBit	;8 bit A.	lda #$E1	pha	plb	inc busyFlag	pla	;recover state of machine	sta >statereg	;and restore it	plb	plp	;Restore state.	pla	rts	ENDP******************************************************************  'ExitCrit'**  Inputs:**  Outputs:*****************************************************************ExitCrit	PROC	longa off	EXPORT PermitPermit		;       	EXPORT lpermitlpermit		;   	pha	phx	phy	phd	;save off direct page	pea $0000	;prepare to set direct page to zero	pld	;get direct page of	zero	php	sep #MBit	;8 bit A.	longa off	lda >statereg	;get state of machine	pha	and #$cf	;bits 4&5 zero force read and write main bank	sta >statereg	rep #XBit	;16 bit X.	phb	lda #$E1	;Change to bank E1.	pha	plb	jsr GetBank	;Get LC bank 2.	php	;Save mode for later.	sei	;No ints while changing busyFlag.	dec busyFlag	bne Done	;If zero, we can try to dispatch	ldx curRBuf	;packets.  Are packets available?	lda |buf_next+1,x	;Look at high byte of next field:	beq NoPkts	;If zero, no packets.	inc busyFlag	;packets.  Increment busy for Dispatch.	plp	;Get back state of interrupt	php	;enable flag and save again.	jsr Save16	;Save 16 bytes of ZP.	jsl PDispatch+$E10000 ;try to dispatch a packet.	jsr Restore16	;Get back ZP.	sei	;No ints while looking at busy flag.	dec busyFlag	;Undo the busy. If still zero,	bne Done	;check for a pending 1/4 sec interrupt.NoPkts		; 	lda deltaT	;If time > 0, one is waiting.	beq Done	;Zero, none waiting.	stz deltaT	;Clear timer.	inc busyFlag	;Now we're busy.	plp	;Get back int enable state.	php	rep #MBit+XBit	jsr QtrSched	;Dispatch 1/4 sec interrupts.	sei	dec busyFlag	;Undo the busy.Done		; 	plp	jsr UnGetBank	;Restore memory state.	rep #mbit+xbit	jsl decbusyflag	;let scheduler run now if down to zero	plb	sep #mbit	;state is 1 byte	pla	;recover state of machine	sta >statereg	;and restore it	plp	pld	;recover original direct page	ply	plx	pla	rts	ENDP	*****************************************************************  'RecvPacket' should be called to receive a packet from a	non-interrupt*  environment.  The routine will wait a maximum of IFGTime	(200 usec.)*  for a packet before returning with a	time out error.  Only 3 packet classes*  are accepted: LAPAck, LAPCTS, and non LAP-control packets (i.e., data*  packets).  Any directed packet (non broadcast), however,	will set the flag*  'addrUsed'.  LAPCTS packets will set	the flag 'gotCTS', and data packets*  will set the flag 'gotData'.  Data packets will only be accepted if the flag*  'needData' is set.**  Inputs:**  Outputs:*****************************************************************RecvPacket	PROC	stz pktError	;No receive errors (yet).	ldy #0	;Point to scc1 (, 2, 3).	ldx #TIFGap	;Wait max of IFG (200 us) for packet.	clc	;Set up loop info on stack for later.	php	;Push a flag with C=0 to stop the loop.	sec	php	;Push 3 flags with C=1 to get 4 bytes.	php	phpWaitIFG		; 	lda (sccReg)	;Check for data ready.	and #RxAvail	bne DataAvail	dex	;Check for time out.	bne WaitIFG	jmp ErrExit	;Time out, so exit.DataAvail		; 	lda (sccDat)	;Get data.	sta scc1A,y	;Store it.	iny	;Point to the next byte.	ldx #TByte	;Reset time out timer for single byte.	cpy #3	;See if we've gotten all 3 bytes yet.	bne WaitIFG	;Keep looping.	lda scc3	;Look at LAP type.	bmi LAPPkt	;Go handle LAP packet.	lda needData	;Do we need a data packet?	beq Exit	;No: exit.	ldy curOffset	lda scc3	;See if this packet	needs to be check-	cmp #DDPLong	;summed.	bne AfterHeader	;If not, just get data.	sec	;Single byte mode.RLoop		; 	jsr RecvBytes	;Get a byte of DDP header.	sta [ptr0],y	;Store it.	iny	plp	;Get loop control off stack.	bcs RLoop	;If C set, loop.	phx	;Push 4 dummy bytes	on stack.	phxAfterHeader		; 	stz cmndList	;Zero the checksum.	stz cmndList+1	clc	;Indicate multi byte mode.	jsr RecvBytes	;Receive the whole packet.	lda pktError	;See if any errors occured.	bmi Exit	;Yes. Exit.	lda addrValid	;Is our address valid?	beq Exit	;No: exit.	inc gotData	;Indicate that we got a data packet.	ldx cmndList	;Put the checksum in page E1.	stx ckSum	bra Exit	;Return.LAPPkt		; 	sec	;Single byte mode.	jsr RecvBytes	;Get first CRC byte.	bcc ErrExit	;Last byte: error, so exit.	jsr RecvBytes	;Get second CRC byte.	bcs ErrExit	;Not last byte: error, so exit.	lda pktError	;See if any errors.	bmi Exit	;Yep. Exit.	lda scc3	;Look at LAP type.	cmp #LAPCTS	;Is it a CTS?	bne Exit	;No, so don't do anything.	sta gotCTS	;Yes, register it.	bra ExitErrExit		; 	dec pktError	;If get here, pktError was 0. Now $ff.Exit		; 	plx	;Remove loop control bytes from stack.	plx	lda pktError	;Was there an error?	bmi BCST	;Yes, ignore the packet.	lda scc1A	cmp source	;Is it to our address?	bne BCST	;No, must be broadcast.	sta addrUsed	;someone is using this address.BCST		; 	jmp RecvInit	;Init receiver for other packets	ENDP******************************************************************  'RecvBytes' reads bytes into the current receive buffer.	 It has two*  modes of operation, depending on the	setting of the C bit when called.*  If C is cleared when called, bytes will be continuously read until the*  end of the packet or an error occurs, and each byte will	be added to the*  'ckSum'.  If C is set, however, only	one byte will be read and returned*  in A without being buffered or added	to the checksum.  Control will*  be passed immediately back to the caller.**  Inputs:**  Outputs:*****************************************************************Set	PROC	sec	;Shift in 1.	rol A	;Left.	sta cmndList	sep #MBit	;Back to 8 bits.	clc	;Ensure multi-byte mode.		entry RecvBytes	; EXPORT -> ENTRY  **TGHRecvBytes		;       	lda (sccReg)	;Look at the byte available bit.	and #RxAvail	bne Loop2	;Got a byte: continue.	ldx #TByte	;Byte time out.Loop1		; 	lda (sccReg)	;Look at the byte avail bit.	and #RxAvail	bne Loop2	dex	;Check for time out.	bne loop1	lda #TOutErr	;Time out error.	bra DoErrorLoop2		; 	sta (sccReg)	;If we get here, A = 1 (point to	lda (sccReg)	;read register 1). Get error status.	and #$A0	;Check for end of frame or overrun.	bne Special	;Handle special case.	lda (sccDat)	;Get the data byte.	bcc MultiMode	;If C = 0, get multiple bytes.	sec	;Indicate not end of packet.	rts	;Return with the byte in A.MultiMode		; 	sta [ptr0],y	;Store the byte.	iny	;Move to next byte.	beq TooBigErr	;If zero, buffer is	full.	rep #MBit	;16 bit A.	longa on	and #$ff	;Mask off high byte.	adc cmndList	;Add new byte to the checksum.	bmi Set	;Bit 15 = 1: go shift in 1.	clc	;Bit 15 = 0: shift in 0.	rol A	;Shift it left, now	C = 0.	sta cmndList	;Store it.	sep #MBit	;Back to 8 bits.	longa off	bra RecvBytes	;Loop. C = 0 still for multi-byte mode.TooBigErr		; 	lda #tBigErr	;Set the appropriate error bit.	bra DoErrorSpecial		; 	bmi LastByte	;If -, last byte in	packet.  Else;		 overrun bit is set	in A. Record it.DoError		; ;Decide whether or not to record the	ora #$80	;error.  Set the error bit.	tax	;Get pktError and look at the lock bit	lda pktError	;to see whether we should report this	and #1	;new error.  If set, don't record.	clc	;Indicate end of packet (whether or not	bne NoRecord	;it's the end).	txa	;Get back the new error.	tsb pktError	;Record it.NoRecord		; 	rtsLastByte		; 	lda #1	;Get status register again.	sta (sccReg)	lda (sccReg)	and #$60	;Mask all but CRC and overrun errors.	bne DoError	;Use bits in A as error bits.	lda #1	;If not an error, a	packet has been	sta pktError	;successfully received, so set the lock	clc	;bit and clear C to	indicate the end of	rts	;the packet.	ENDP****************************************************************  'XmitPacket' performs CSMA.CA transmission of the packet	in the buffer*  data structure pointed to by 'xmitBDS'.**  Inputs:  'dest',	'lapType', and 'xmitBDS'**  Outputs:*****************************************************************XmitPacket	PROC	php	;Save mode.	sep #MBit	;8 bits.	lda lapType	;Is it an Enq?	cmp #LAPEnq	beq NoCount	;If so, don't count size of BDS.	rep #MBit	longa onCountBDS		; ;First count bytes, see if it's too long	ldx txBDS	;Make temporary copy of the pointer to	stx ptr0	;the BDS.	ldx txBDS+2	stx ptr0+2	lda #MaxData	;Set up to max size	of LAP data.	ldy #0	;Point to first BDS	entry.CountLoop		; 	pha	;Save amount left before too big.	lda [ptr0],y	;Get this count.	inc A	;See if it's $FFFF.	beq Done	;If so, done.	pla	;Get back amount remaining.	sec	sbc [ptr0],y	;Subtract the size of this entry.	bpl OKLength	;If we go -, it's too long.	lda #SizeErr	;Report error.	plp	;Get back mode	rts	;return.OKLength		; 	iny	;Move ahead 6 to the next BDS entry.	iny	iny	iny	iny	iny	bra CountLoop	;Loop.Done		; 	pla	;Get stuff off stack.	sep #MBit	longa offNoCount		; 	ldx whichSCC	;Set up pointers to	SCC.	stx sccReg	inx	inx	stx sccDat	lda #1	;Set this bit to use the Mega II mouse	tsb mouseMode	;counter for line activity detection.	lda colHist	;Look at recent collision history.	jsr BitCount	;Count # of cols. in the last 8.	bcc AdjBk2	;<2 then check defers.	beq AdjBk2	;=2 then check defers.	rol gBackOff	;gBackOff = gBackOff * 2 + 1 (mask bit).	stz colHist	;Clear collision history.	bra AdjBk3AdjBk2		; 	lda defHist	;Look at defer history.	jsr BitCount	;Count defers in past 8.	bcs AdjBk3	;If >= 2, continue.	lsr gBackOff	;gBackOff = gBackOff / 2.	lda #$ff	;Set all def history bits.	sta defHistAdjBk3		; 	lda gBackOff	;Copy gBackOff to	sta lBackOff	;our local copy.	asl defHist	;Throw away the oldest history bit.	asl colHist	;Throw away the oldest history bit.	ldx #$2020	;Max defers, Max collisions.	stx colTries	;Set them up.CDSPktWait		; 	plp	;Get back original setting of interrupt	php	;enable bit.	jsr Random	;Generate random number now for backoff.	ldy #TWLFree	;30 msec. time out for free line.	ldx whichMouse	;Pick which mouse counter to watch.WLFLoop		; 	lda |0,X	;Clear the mouse counter.	jsr RTSAddr	;Wait about a bit time.	lda |0,X	;Get current count:	is anyone on the	beq CDSBkOff	;line?  If not, we got it.	dey	;Check for time out.	bne WLFLoop	;No time out, continue.	jsr RecvInit	;Otherwise, time out: receiver stuck,	bra CDSPktWait	;so reset it.CDSBkOff		; 	ldy #4	;Wait 400 usec. inter dialog gap,	jsr WLineBusy	;checking for line busy.	bcs CDSPktWait	;Line busy: keep waiting.	lda seed+1	;Get a random number.	and lBackOff	;And (effectively multiply) by lBackOff.	rep #MBit	;16 bit A.	longa on	and #$f	;Enforce max wait of 15.	tay	;Set for WLineBusy,	100 usec intervals.	sep #MBit	;Back to 8.	longa off	beq GotLine	;If random backoff time is 0, continue.	jsr WLineBusy	;checking for line busy.	bcs Defer	;Someone on line: defer.GotLine		; 	sei	;No ints from now on.	stz gotCTS	;Clear CTS received	flag.	ldx dest	;Get dest address.	lda #LAPEnq	;See if sending a LAPEnq.	cmp lapType	beq DoEnq	;If so, A already has #LAPEnq.	lda #LAPRTS	;If not, do an RTS instead.DoEnq		; 	jsr XmitLAP	;Send a LAP packet.	lda dest	;Check for broadcast.	inc A	beq JustWait	;If broadcast, don't expect a CTS.	jsr RecvPacket	;Try to receive CTS.	lda lapType	;Was it an enquiry?	cmp #LAPEnq	bne ChkCTS	;If not, see if we got a CTS.	lda addrUsed	;If so, see if anyone used our address.	beq Collision	;No: pretend a collision, keep trying	plp	;enquiries. Yes: return.	rtsChkCTS		; 	lda gotCTS	;See if we got it.	bne TransPkt	;If so, transmit the packet.Collision		; ;Otherwise, probably a collision.	lda #1	;Set the current collision history bit.	tsb colHist	sec	;Multiply lBackOff by 2.	rol lBackOff	lda #RetryErr	dec colTries	;See if too many collisions.	beq Exit	;If so, exit with excess collision err.CDSBranch		; 	brl CDSPktWaitDefer		; 	lda #1	;Set current defer history bit.	tsb defHist	dec defTries	;See if too many defers.	bne CDSBranch	;If not, try again.	lda #RetryErr	;Report excess defers error.	bra ExitJustWait		; 	ldy #1	;Wait 100 usec, checking for line busy.*		;(Hardware SCC delay makes this 200 us.)	jsr WLineBusy	bcs Collision	;If someone on line, record collision.TransPkt		; ;Otherwise, transmit the packet.	jsr XmitBDS	lda #0	;Report successful transmission.Exit		; 	plp	;Restore mode.		entry RTSAddr	; EXPORT -> ENTRY  **TGHRTSAddr		;     	rts	;Return.	ENDP*****************************************************************  'XmitLAP'  sends	a 3 byte lap packet.  A contains the LAP type, X*  contains the destination address.**  Inputs:**  Outputs:*****************************************************************XmitLAP	PROC	pha	;Save the LAP type on the stack.	jsr XmitBegin	;Start the transmission.	lda source	;Get our node number.	tax	jsr XmitOne	;Send it.	pla	;Get LAP type back.	tax	jmp XmitEnd	;Send it and exit through XmitEnd.	ENDP*****************************************************************  'fXmitLAP'  sends a 3 byte lap packet.  A contains the LAP type, X*  contains the destination address. (NOTE: this does not send the*  sync pulse at the beginning, and should only be called when we*  are sending back immediately to someone who sent us an RTS or ENQ**  Inputs:**  Outputs:*****************************************************************fXmitLAP	PROC	pha	;Save the LAP type on the stack.	lda #3	;Start by disabling	the receiver.	sta (sccReg)	;Point to reg 3.	lda #DisRx	sta (sccReg)	lda #5	;Now enable drivers	tay	;Y = 5.	sta (sccReg)	;pulse.	lda #EnbRTS	sta (sccReg)	tya	;Now enable drivers	and transmitter.	sta (sccReg)	lda #EnbTxRTS	sta (sccReg)	lda #ResTxCRC	;Initialize the transmitter's CRC	sta (sccReg)	;generator.	txa	;Get the first character of the packet.	sta (sccDat)	;Send it.	lda #ResetUnd	;Reset transmit underrun error.	sta (sccReg)	lda source	;Get our node number.	tax	jsr XmitOne	;Send it.	pla	;Get LAP type back.	tax	jmp XmitEnd	;Send it and exit through XmitEnd.	ENDP******************************************************************  'XmitBegin' begins a packet transmission by sending the synchronization*  pulse, two flags, and the data byte passed in X.**  Inputs:**  Outputs:*****************************************************************XmitBegin	PROC	lda #3	;Start by disabling	the receiver.	sta (sccReg)	;Point to reg 3.	lda #DisRx	sta (sccReg)	lda #5	;Now enable drivers	for start of sync	tay	;Y = 5.	sta (sccReg)	;pulse.	lda #EnbRTS	sta (sccReg)	tya	;Now disable drivers for end of sync	sta (sccReg)	;pulse	lda #DisTxRTS	sta (sccReg)	tya	;Now enable drivers	and transmitter.	sta (sccReg)	lda #EnbTxRTS	sta (sccReg)	ldy #T2Flags	;Delay long enough for two flagsFlagLoop		; ;to be transmitted. (50 usec)	dey	bne FlagLoop	lda #ResTxCRC	;Initialize the transmitter's CRC	sta (sccReg)	;generator.	txa	;Get the first character of the packet.	sta (sccDat)	;Send it.	lda #ResetUnd	;Reset transmit underrun error.	sta (sccReg)	rts	ENDP******************************************************************  'XmitOne' sends the byte in X to the	SCC as soon as its transmit buffer*  is empty.**  Inputs:**  Outputs:*****************************************************************XmitOne	PROC	lda (sccReg)	;Wait until the transmit buffer is	and #TxEmpty	;empty.	beq XmitOne	txa	;Get char to transmit.	sta (sccDat)	rts	ENDP******************************************************************  'BitCount' counts the set bits in A.**  Inputs:  A: bits	to count.**  Outputs: Y: number of set bits.*           flags: set from comparison of Y with 2.*****************************************************************BitCount	PROC	ldx #7	;Count 8 bits.	ldy #0	;# of set bits found.BCLp		; 	asl A	bcc NotSet	inyNotSet		; 	dex	bpl bclp	cpy #2	rts	ENDP******************************************************************  'WLineBusy' waits either until the line is busy or until	the number of*  100 usec. intervals specified by the	Y register has passed.  If the line*  is busy, C is set on return.  Otherwise, C is reset.**  Inputs:**  Outputs:*****************************************************************WLineBusy	PROC	sty r0	;Save counter in ZP.WLBLp2		; 	ldy #T100usec	;100 usec. timer.	ldx whichMouse	;Get pointer to our	mouse counter.WLBLoop		; 	lda |0,x	;Clear mouse count.	jsr RTSAddr	;Wait about a bit time.	lda |0,x	;See if any activity.	bne Busy	;Yes: exit.	dey	;Check for end of this 100usec period.	bne WLBLoop	;Not the end.	dec r0	;Check for the end of the Y time.	bne WLBLp2	;Not the end.	clc	;Clear C to indicate time out	rts	;and return.Busy		; 	sec	;Set carry to indicate line busy	rts	;and return.	ENDP******************************************************************  'XmitBDS' transmits a data packet using the data from the buffer data*  structure pointed to by 'xmitBDS'.**  Inputs:**  Outputs:*****************************************************************XmitBDS	PROC******************************************************************  This code sets up zero page pointers	and registers X and	Y for efficient*  access of the buffer data structure 'txBDS'.  X contains	the number of*  bytes left in the current buffer, Y contains an offset from [ptr1] to the*  current byte in the buffer,  r0 is an offset from [ptr0]	to the next entry*  in the BDS.*****************************************************************	rep #MBit	;16 bit A.	lda txBDS	;Get low word of BDS pointer.	sta ptr0	;Store in ZP.	lda txBDS+2	;Get high word.	sta ptr0+2	lda [ptr0]	;Get length of the first entry.	pha	;Store length on stack.	ldy #2	;Point to the first	buffer address.	lda [ptr0],y	;Get low word of address.	sta ptr1	;Store in ptr1	iny	;Move on to high word.	iny	lda [ptr0],y	;Get high word of address.	sta ptr1+2	;Store.	iny	;Point to the next entry.	iny	sty r0	;Store pointer.	sep #MBit	;8 bit a.	lda dest	tax	jsr XmitBegin	lda source	tax	jsr XmitOne	lda lapType	sta r2	;r2 is the first byte sent by XmitBDS.	ldy #0	;Point to first byte of BDS data.	plx	;Get back length of	this BDS entry.	beq NextBDS	;Fixes 0 length bug 11/23/88  **TGHXmitBytes		; 	lda (sccReg)	;Wait for the transmit buffer to be	and #TxEmpty	;empty.	beq XmitBytes	lda r2	;Then get the first	byte to send,	sta (sccDat)	;and send it.	lda [ptr1],y	;Get a byte from the BDS.	sta r2	;Store it.	iny	;Point to next byte.	dex	;See if this entry is empty.	bne XmitBytes	;No, keep looping.NextBDS	rep #MBit+CBit	;16 bit A, clear C.	longa on	ldy r0	;Get pointer to next BDS entry.	lda [ptr0],y	;Get length of next	entry.	bne NotZ	;See if length is zero.Again		; 	tya	;It is: move on the	next BDS entry.	adc #6	tay	lda [ptr0],y	;Is it still zero?	beq AgainNotZ		; ;Not zero: send the BDS entry.	tax	;Put the count in X.	inc A	;If $ffff, it's the end.	beq Empty	iny	;Move ahead to the buffer pointer.	iny	lda [ptr0],y	;Get low word of pointer.	sta ptr1	;Store it.	iny	;Move on to high byte.	iny	sep #MBit	;Back to 8 bits.	longa off	lda [ptr0],y	;Get high byte.	sta ptr1+2	;Store it.	iny	;Move on to the next entry.	iny	sty r0	;Save pointer to the next entry.	ldy #0	;Point to the first	byte of the entry.	bra XmitBytes	;Keep sending bytes.Empty		; 	sep #MBit	;Back to 8 bits.	lda r2	;Get the last byte.	tax	;Put in X for XmitEnd.******************************************************************  'XmitEnd' terminates a packet transmission by sending the byte passed in X,*  the trailing flag, and the abort sequence.  It then inits the receiver.**  Inputs:**  Outputs:*****************************************************************	entry XmitEnd	; EXPORT -> ENTRY  **TGHXmitEnd		;       	jsr XmitOne	;Send the byte in X.UndWait		; 	lda (sccReg)	;Then, wait for underrun.	and #Underrun	beq UndWaitCRCWait		; ;Then, wait for CRC to be transmitted.	lda (sccReg)	and #TxEmpty	;(Full while sending CRC bytes).	beq CRCWait	ldx #TLastFlag	;Wait long enough for the terminatingFlagWait		; ;flag to be sent (29 usec).	dex	bne FlagWait	lda #5	;Now disable transmitter but keep	sta (sccReg)	;drivers on for abort sequence.	lda #EnbRTS	sta (sccReg)	ldx #TAbort	;Wait long enough for the abortAbortWait		; ;sequence to happen (75 usec).	dex	bne AbortWait	lda #5	;Now turn off drivers.	sta (sccReg)	lda #DisTxRTS	sta (sccReg)	;Fall into 'RecvInit'.******************************************************************  'RecvInit' initializes the current appletalk SCC channel	for packet*  reception.*****************************************************************	entry RecvInit	; EXPORT -> ENTRY  **TGHRecvInit		;       	php	;Save int mode.	sei	;No interrupts.	pea $00DD	;(EnbRxSlv+EnterHunt) + End flag	pea $2330	;(ResetErr+256*(ReEnbInt+3))	pea $D003	;(3+256*DisRx)RILp		; 	pla	sta (sccReg)	bne RILp	plp	;Get back int mode.	rts* The above code sends out the following sequence of bytes to the control reg.:*           #3		Point to write register 3.*           #DisRx		Disable the receiver.*           #ResetErr	Reset Errors.*           #ReEnbInt+3	Enable 1st char ints, point to reg 3.*           #EnbRxSlv+EnterHunt	Set slave receive mode.	ENDP	******************************************************************  'NewPacket' checks the latest packet	to see if it belongs to an installed*  protocol handler.  If so, it is added to the packet dispatch list.  If not,*  it is discarded.	 LCBank RAM must be	selected before calling.**  Inputs:  ptr0 = curEnd.  16 bit index, 8 bit A.**  Outputs:*****************************************************************NewPacket	PROC	rep #MBit	;16 bit A.	longa on	ldx curWBuf	;X points to the base of the buffer.	dey	;Adjust end of buffer (skip CRC byte).	tya	;(Y points to CRC, 1st byte past data).	sec	sbc curOffset	;Subtract the base of the data to	sta |buf_len,x	;find the length.  Store in buffer.	lda [ptr0],y	;Get that pesky CRC	byte.	and #$ff	;Mask high byte.	pha	;Save on stack.	lda ckSum	;Get the checksum.	ror A	;Look at the low bit.	php	;Save carry bit.	rol A	;Back to the checksum.	plp	;Get the low bit back in C.	ror A	;NOW rotate right.	sec	;Prepare to subtract.	sbc 1,s	;Subtract the CRC: now we have the real	sta |buf_cksum,x	;checksum.  Put it in the buffer.	pla	;Clean up the stack.	lda scc1A	;Get scc bytes and install in buffer.	sta |buf_dest,x	;Store first and second bytes.	sep #MBit	;Back to 8 bit A.	longa off	lda scc3	;Now get third byte.	sta |buf_type,x	rep #MBit	;16 bit A.	longa on	tya	;A = curOffset.	clc	adc curEnd	;Advance the end packet pointer past	clc	;the packet we just	got.	adc #MaxSize	sta curEnd	bmi OK	;If curEnd is still	> $8000, it's OK.	lda #Base+MaxSize	;Otherwise, wrap back to the beginning	sta curEnd	;of the packet buffer area.	sep #MBit	longa off	;Also,	inc trailing	;set the trailing flag to indicate thatOK		; ;write pointers precede read pointers.;		;End by setting up the next write buf.******************************************************************  'SetWNext' sets up 'curOffset', curWBuf->next, and 'curWBuf' to add the most*  recent write buffer to the list.  If	there isn't enough room to allocate the*  next write buffer, 'curOffset' is set to zero to prevent	'RecvPacket' from*  storing packets.*****************************************************************	entry SetWNext	; EXPORT -> ENTRY  **TGHSetWNext		;       	sep #MBit	;8 bit A.	ldx curWBuf	;X points to the current write buffer.	lda trailing	;See if trailing.	rep #MBit+CBit	;16 bit A.	longa on	beq NotTrail	;If trailing, check	for full buffer.	ldy curRBuf	;See if curEnd > curRBuf.	cpy curEnd	bcs NotTrail	;If not, the buffer	isn't full.	lda #0	;If so, the buffer is full.  Indicate	sta |buf_next,x	;full buffer: set curWBuf->next = 0.	sta curOffset	;Also, curOffset = 0.	bra ExitNotTrail		; 	sec	lda curEnd	;set curWBuf->next = curEnd - MaxSize	sbc #MaxSize	;to point to the beginning of the next	sta |buf_next,x	;write buffer.	sta curWBuf	;Now use that buffer as curWBuf.	tax	;Now clear curWBuf->next to indicate	stz |buf_next,x	;empty buffer.	lda #-(MaxData+2)	;Set up curOffset to point to the	sta curOffset	;start of the LAP data field.Exit		; 	sep #MBit	;Back to 8 bit A.	longa off	rts******************************************************************  'FreeBuf' releases the current read buffer for future use.*  LCBank RAM must be selected before calling.******************************************************************	entry FreeBuf	; EXPORT -> ENTRY  **TGHFreeBuf		;       	ldx curRBuf	;Point to the buffer.	ldy |buf_next,x	;Get curRBuf->next.	cpy curRBuf	;If next < curRBuf,	we're wrapping to	bcs NotWrap	;the beginning of the buffer, so we	stz trailing	;reset the trailing	flag.NotWrap		; 	sty curRBuf	;Point curRBuf to the next buffer.	ldy curOffset	;See if curOffset is 0.	beq SetWNext	;If so, try to get a new write buffer.	rts	;Otherwise, return.	ENDP******************************************************************  'Dispatch' dispatches packets from the list until there are none left or*  'busyFlag' is greater than zero.  Control is passed to each packet's*  protocol handler.**  Inputs:  8 bit A, 16 bit index.**  Outputs:*****************************************************************Dispatch	PROC EXPORT	php	lda >$0007f8	;get mslot	pha	;hold till we are ready to exit	jsr predispatch	pla	;recover mslot	sta >$0007f8	;restore it	cmp #$c1	;see if in valid range	bcc notgoodmslot	;no it is not	rep #xbit	xba	;a=$cnXX	lda #00	;a=$cn00	tax	lda >$00cfff	;deselect all $c800's	lda >$000000,x	;access $cn00 to re-enable original $c800notgoodmslot		; 	plp	rtlpredispatch		; 	jsr stacksave	;save stack and move pointer	jsl coredispatch	;dispatch packet	jsr stackrestore	;restore stack pointer	rts* stack saving routines...* these routines will save a portion of	the stack to* allow deeper than	normal nesting of calls on the 256 byte	stack*	EXPORT stacksavestacksave		;       	phb	;save bank	phb	jsl LongForbid	;don't let other ints come in here	pea $e1e1	plb	plb	;must be in bank e1	for vars	sta stacksavea	;save accum	php	;save register modes	php	rep #mbit+xbit	;force full native	longa on	longi on	pla	;recover old mode in accum	sta stacksavep	pla	;get data bank (pushed at entry)	sta stacksaveb	;save the data bank	stx stacksavex	sty stacksavey	;save registers	pla	;get return address	sta stretaddr	;hold onto return address since we change stacks	inc stksaveflag	;bump the flag so nested calls don't save stack	lda stksaveflag	;see if stack already saved	dec a	;see if is now 1	bne stackok	;the stack is already saved or ok since	above 1	tsc	;get real stack pointer	cmp #topstack	;check against our prefferred top of stack	bcc stackswap	;it's lower, do stack stuff	stz oldstack	;zero out pointer so restore knows we did nothing	bra stackokstackswap		; 	sta oldstack	;preserve stack pointer for restore later	sec	lda #topstack	;get value of where	we want stack	sbc oldstack	;see how many bytes	we need to save	cmp #topstack-$100	;see if stack below $100	bcs @dothesave	;no, so save it	lda #topstack-$100	;it was, so only save from $100, not below@dothesave	sta lentosave	;save for later restore	ldx oldstack	;recover stack pointer	ldy #ourstacksave	;destination is ourstacksave memory	mvn $00,$e1e1e1	;move from stack to	our bank	lda #topstack	;get our stack pointer	tcs	;and set itstackok		; 	lda stretaddr	;recover return address	pha	ldx stacksavex	;recover x and y	ldy stacksavey	lda stacksaveb	;get old data bank	pha	;stay in bank $e1 till end	lda stacksavep	;now restore processor state	pha	;push two identical	bytes	plp	plp	;restore original state of processor	lda stacksavea	;and finally restore a	plb	;restore data bank that was pushed above	plb	;now since we don't need to be in bank $e1 now	jsl LongPermit	;allow atalk to dispatch again	rts	;and return	EXPORT stackrestorestackrestore		;       	phb	;save bank	phb	jsl LongForbid	;don't let other ints come in here	pea $e1e1	plb	plb	;must be in bank e1	for vars	sta stacksavea	;save accum	php	;save register modes	php	rep #mbit+xbit	;force full native	longa on	longi on	pla	;recover old mode in accum	sta stacksavep	pla	;get data bank pushed earlier	sta stacksaveb	;save the data bank	stx stacksavex	sty stacksavey	;save registers	pla	sta stretaddr	;save return	dec stksaveflag	;lower level	bne stackok	;we are still nested	lda oldstack	;recover old stack pointer	beq stackok	;nothing ever saved	tcs	;put it back where it was originally	tay	;data will start storing here in mvn	ldx #ourstacksave	;area to restore stack from	lda lentosave	;amount to restore onto stack	mvn $e1e1e1,$00	;move from ourbank to stack bank	pea $e1e1	plb	plb	;set data bank back	to our code bank	bra stackok	;exit this routine** end of stacksave routines and equates*coreDispatch		; 	longa off	longi on	phpLoop		; 	lda busyFlag	;Our ordinary 'non-busy' value is	cmp #1	;actually 1, not zero.  Exit loop if	bne Exit	;not 1 (someone else did 'EnterCrit').	php 	;lets see if any ticks have occurred	sei	;lock out ints, since qtr ints can change deltaT on us	lda deltaT	;get qtr second ticks	stz deltaT	;always zero it out, since we will make use of whats in A	plp	ora #00	;check value of deltaT	rep #MBit	;16 bit A.	longa on	beq @checkpkt	;no ticks to dispatch	jsr QtrSched	;we have ticks, give them a call!@checkpkt		;check to see if we have packets to dispatch	ldx curRBuf	;Get pointer to the	packet.	lda |buf_next,x	;See if next field is 0.	bne IsData	;If not, there is some data.Exit		; ;Otherwise, return.	plp	rtlIsData		; 	stx zpCurBuf	;Store pointer to the buffer in ZP.	lda |buf_dest,x	;get dest node, and	source node	sta |LapDest	;save it	lda |buf_len,x	;Get the length of the packet.	sta curLen	;Store as current length.	txa	;Get pointer to the	buffer.	clc	adc #buf_data	;Point to the LAP data field.	sta curPos	;Set the read position pointer for	sep #MBit	;ReadProt and ReadRest.  8 bit A.	longa off	lda |buf_type,x	;Get the LAP type.	sta |LapDest+2	;and save it for getglobal	jsr FindProt	;Try to find a protocol handler for	bcc NoProt	;the packet.	rep #MBit	;Back to 16 bit A.	ldy |protTable+4*MaxProts,X ;Y = high worrd of handler address.	lda |protTable+2*MaxProts,X ;A = low word of handler address.Callhandler		; 	sta execAddr	sty execAddr+2	;Call the routine, using emulation mode	jsl GoComp	;for bank 0, fixing	stack if needed.	sep #MBit	rep #XBit	bra Loop	;Loop until busy.NoProt		; 	ldy catchProt	;Is there a catch all prot. handler?	bne IsCatch	ldy catchProt+2	bne IsCatch	jsr FreeBuf	;No handler: release the buffer.	bra LoopIsCatch		; 	rep #MBit	;16 bit A.	lda catchProt	;Get low word of handler address.	ldy catchProt+2	;Get high word of handler address.	bra CallHandler	ENDP	END