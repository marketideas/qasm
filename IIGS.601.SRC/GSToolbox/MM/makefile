### Dependencies for building peeker stand alone ###peeker		Ä	peeker.asm.obj		mm.equates.asm	Linkiigs 	peeker.asm.obj	¶	-o peeker		peeker.asm.obj		Ä		peeker.asm		mm.equates.asm	Asmiigs	-d debugversion=1 peeker.asm	mm.in.ram		Ä	mm.in.ram.asm.obj		mm.equates.asm	Linkiigs 	mm.in.ram.asm.obj	¶	-o mm.in.ram  -t $BCmm.in.ram.asm.obj		Ä		mm.asm		mm.equates.asm	Asmiigs	 -d RAMversion=1  mm.asm -o mm.in.ram.asm.objmm.loader		Ä   makefile mm.loader.asm.obj	linkiigs mm.loader.asm.obj		¶	-o mm.loader -t "B3 "	mm.loader.asm.obj 	Ä	makefile mm.loader.asm	asmiigs mm.loader.asm