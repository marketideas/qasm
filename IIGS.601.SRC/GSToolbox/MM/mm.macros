               MACRO&lab           Push_L   &Memory&lab           lda      &Memory+2               pha               lda      &Memory               pha               MEND               macro&lab           pop_l    &Memory&lab           pla               sta      &Memory               pla               sta      &Memory+2               mend               MACRO&lab           Push_W   &Memory&lab           lda      &Memory               pha               MEND               Macro&lab           Pop_W    &Memory&lab           pla               sta      &Memory               mend               macro&lab           cmp_w    &Memory1,&Memory2&lab           lda      &Memory1               cmp      &Memory2               mend               macro&lab           cmp_l    &Memory1,&Memory2&lab           lda      &Memory1               cmp      &Memory2               lda      &Memory1+2               sbc      &Memory2+2               mend               macro&lab           move_w   &Source,&Dest&lab           lda      &Source               sta      &Dest               mend               macro&lab           move_l   &Source,&Dest&lab           lda      &Source               sta      &Dest               lda      &Source+2               sta      &Dest+2               mend               macro&lab           geth_l   &Hndl,&Addr,&Attr&lab                          if       &Attr='' goto .YOK               ldy      #&Attr.YOK               lda      [&Hndl],y               sta      &Addr               iny               iny               lda      [&Hndl],y               sta      &Addr+2               mend               macro&lab           geth_w   &Hndl,&Addr,&Attr&lab                          if       &Attr='' goto .YOK               ldy      #&Attr.YOK               lda      [&Hndl],y               sta      &Addr               mend               macro&lab           seth_l   &Addr,&Hndl,&Attr&lab                          if       &Attr='' goto .YOK               ldy      #&Attr.YOK               lda      &Addr               sta      [&Hndl],y               iny               iny               lda      &Addr+2               sta      [&Hndl],y               mend               macro&lab           seth_w   &Addr,&Hndl,&Attr&lab                          if       &Attr='' goto .YOK               ldy      #&Attr.YOK               lda      &Addr               sta      [&Hndl],y               mend