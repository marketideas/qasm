dk7*19,ndk7*20,ndk7*21,ndk7*22,ndk7*24,ndk7*26,ndk7*28	DC.W ndk7*30,ndk7*32,ndk7*34,ndk7*36,ndk7*38,ndk7*40,ndk7*42,ndk7*44,ndk7*46,ndk7*48	DC.W ndk7*50,ndk7*52,ndk7*54,ndk7*56,ndk7*58,ndk7*60,ndk7*62,ndk7*64,ndk7*66,ndk7*68	DC.W ndk7*70ND8	DC.W ndk8*00,ndk8*00,ndk8*00,ndk8*01,ndk8*01,ndk8*01,ndk8*02,ndk8*02,ndk8*02,ndk8*03	DC.W ndk8*03,ndk8*03,ndk8*04,ndk8*04,ndk8*05,ndk8*05,ndk8*06,ndk8*06,ndk8*07,ndk8*07	DC.W ndk8*08,ndk8*08,ndk8*09,ndk8*09,ndk8*10,ndk8*11,ndk8*12,ndk8*13,ndk8*14,ndk8*15	DC.W ndk8*16,ndk8*17,ndk8*18,ndk8*19,ndk8*20,ndk8*21,ndk8*22,ndk8*24,ndk8*26,ndk8*28	DC.W ndk8*30,ndk8*32,ndk8*34,ndk8*36,ndk8*38,ndk8*40,ndk8*42,ndk8*44,ndk8*46,ndk8*48	DC.W ndk8*50,ndk8*52,ndk8*54,ndk8*56,ndk8*58,ndk8*60,ndk8*62,ndk8*64,ndk8*66,ndk8*68	DC.W ndk8*70ND9	DC.W ndk9*00,ndk9*00,ndk9*00,ndk9*01,ndk9*01,ndk9*01,ndk9*02,ndk9*02,ndk9*02,ndk9*03	DC.W ndk9*03,ndk9*03,ndk9*04,ndk9*04,ndk9*05,ndk9*05,ndk9*06,ndk9*06,ndk9*07,ndk9*07	DC.W ndk9*08,ndk9*08,ndk9*09,ndk9*09,ndk9*10,ndk9*11,ndk9*12,ndk9*13,ndk9*14,ndk9*15	DC.W ndk9*16,ndk9*17,ndk9*18,ndk9*19,ndk9*20,ndk9*21,ndk9*22,ndk9*24,ndk9*26,ndk9*28	DC.W ndk9*30,ndk9*32,ndk9*34,ndk9*36,ndk9*38,ndk9*40,ndk9*42,ndk9*44,ndk9*46,ndk9*48	DC.W ndk9*50,ndk9*52,ndk9*54,ndk9*56,ndk9*58,ndk9*60,ndk9*62,ndk9*64,ndk9*66,ndk9*68	DC.W ndk9*70		ENDP******************************************************************	MIDICmd	Tool Call**	Inputs: Status, Channel, Data 1, Data 2**	Output: none******************************************************************	EXPORT MIDICmd	MIDICmd	PROC	longi on	longa on			IMPORT ChanQueue	IMPORT KeyQueue	IMPORT VolQueue	IMPORT CmdQueue	IMPORT TrackQueue;;  stack offsets;	DefineStacks_status	byte	; caller's status regs_dirpage   word 	; old direct pages_databank	byte	; old data banks_rtl1	block 3	; first rtl addresss_rtl2	block 3	; second rtl addresss_argstart	DSectSize	; start of argumentss_data2	word 	;  (0-127)s_data1	word 	;  (0-127)s_cmd	word 	; MIDI status messages_bytes	word 	; number of data bytes (0-2)s_path	words_argend	DSectSize	; end of argumentss_argsize	equ s_argend-s_argstart* flags** m000 0000 0000 0qs0** m: 1= to MIDI port* q: 1= to seq* s: 1= to synth	phb		; save caller's data bank	phd		; save caller's direct page	lda >myDP	tcd		; set my DP	phk	plb		; set my DB	php		; save caller's IRQ bit	sei		; hold MIDI from using queue		lda #errNotStarted	sta ErrMsg	lda >awake	beq exit 		; not started, report err.	stz ErrMsg	lda s_path,s	cmp #3	bge exit	asl A	tax	jmp (vec1,x)vec1	DC.W Queue_only	DC.W QandBuf	DC.W MIDIOnly* restore the registers, fix the stackexit	ldx ErrMsg	plp	pld	; get old direct reg	plb	; get old data bank	PopArgs s_argsize	txa							; get the error code.	cmp #1	; set the carry bit.	rtlErrMsg	DC.W 0QandBuf	lda <SeqFlags	bit #F_Record	beql Queue_only	; we're not recording	* Put packet into the Queue AND Rec Buffer@1	lda <RecTrack	bpl @2	jmp Queue_only	; no tracks set for recording* make sure there's enough room in Rec buffer for 1 Seq Item@2	lda <RecBufEnd	sec	sbc <RecBufStart	cmp #11		; 8 bytes for Seq Item + EOS	bge GoRec	lda <RecBufEnd+2	sbc <RecBufStart+2	bne GoRec	lda #RecBufFull	sta ErrMsg	jmp Queue_only	; Rec Buffer is FULL!* Record and play the messageGoRec	ldy #00	lda <RecTrack	sta [RecBufStart],y	; Track number	inynoQuant	lda <Timer+2	sta [RecBufStart],y	; hi byte first	iny	lda <Timer		; record time in rec buffer	sta [RecBufStart],ysaveStatus	iny	iny	lda s_bytes,s	sta [RecBufStart],y	; record packet length	iny	ldx <QueuePtr	lda s_cmd,s	sta [RecBufStart],y	; record msg/ch number	and #$00F0	sta CmdQueue,x	; queue status msg	lda s_cmd,s	and #$000F	sta ChanQueue,x	; queue ch number	iny	lda s_data1,s	sta KeyQueue,x	sta [RecBufStart],y	; 1st data byte	iny	lda s_data2,s	sta VolQueue,x	sta [RecBufStart],y	; 2nd data byte	iny		lda #$FFFF	sta [RecBufStart],y	; end of seq		lda #16		; **** no such Track number	sta TrackQueue,x	lda <RecBufStart	clc	adc #ItemSize	; number of bytes per seq item	sta <RecBufStart	lda <RecBufStart+2	adc #00	sta <RecBufStart+2	inx	inx	txa	and #QueueSize-1	cmp <QueueOut	beql Qerror		; Queue is FULL!	sta <QueuePtr	; Queue points to next open slot	jmp exitQueue_only	ldx <QueuePtr	lda <s_cmd,s	and #$00F0	sta CmdQueue,x	lda s_cmd,s	and #$000F	sta ChanQueue,x	lda s_data1,s	sta KeyQueue,x	lda s_data2,s	sta VolQueue,x	lda #16		; **** no such Track number	sta TrackQueue,x	inx	inx	txa	and #QueueSize-1	cmp <QueueOut	beq Qerror		; Queue is FULL!	sta <QueuePtr	; Queue points to next open slot	jmp exitQerror	lda #MQFull	sta ErrMsg	jmp exit	IMPORT FillBuffer1MIDIOnly	lda <OutPortEnable	bne @1	lda #MIDIoutOff	sta ErrMsg	jmp exit		; MIDI out disabled@1	iny	iny	lda s_bytes,s	sta <ByteCount	; save for MIDI out	lda s_cmd,s	sta <SeqItem	lda s_data1,s	sta <SeqItem+1	lda s_data2,s	sta <SeqItem+2	jsr FillBuffer1	; send the packet out (no Call-Back)	bccl exit		; no errors	lda #MIDIBufFull	; MIDI out buffer FULL!	sta ErrMsg	jmp Exit	ENDP	END