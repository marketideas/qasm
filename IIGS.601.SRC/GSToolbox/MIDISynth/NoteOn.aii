;-----------------------------------------------;;	Imported addresses;;-----------------------------------------------	IMPORT compute_envelope	IMPORT LogTbl	IMPORT ExpTbl	IMPORT freqtable	IMPORT Chan		; Note.Exec	IMPORT Priority	IMPORT State	IMPORT Note	IMPORT vcbTbl	IMPORT oscTbl	IMPORT mul320	; check.aii	IMPORT OCB		; check.aii	IMPORT chPBTbl	IMPORT Top_Octave	; tables	IMPORT halt_gen	; update.aii	INCLUDE 'all.macros'	INCLUDE 'Note.Macros'	INCLUDE 'ns.equ'******************************************************************	NoteOn	Tool Call**	Inputs: Semitone, Volume, Instrument ID**	Output: none**	This routine is reentrant*****************************************************************	EXPORT NoteOn	NoteOn	PROC	longi on	longa on			EXPORT VoiceInit	EXPORT Allocate	EXPORT ChanQueue	EXPORT KeyQueue	EXPORT VolQueue	EXPORT CmdQueue	EXPORT TrackQueue	EXPORT Set_Freq	EXPORT PBtbl	EXPORT VGtbl	EXPORT Note_Tbl	EXPORT Note_Tbl_Default	EXPORT Make_F_Tbl	EXPORT ND_Tbl;;  stack offsets;	DefineStacks_status	byte	; caller's status regs_dirpage   word 	; old direct pages_databank	byte	; old data banks_rtl1	block 3	; first rtl addresss_rtl2	block 3	; second rtl addresss_argstart	DSectSize	; start of argumentss_volume	word 	; Key Volume (0-127)s_key	word 	; Key number (0-127)s_channel	word 	; Channel number (0-15)s_argend	DSectSize	; end of argumentss_argsize	equ s_argend-s_argstart	phb		; save caller's data bank	phd		; save caller's direct page	lda >myDP	tcd		; set my DP	phk	plb		; set my DB	php		; save caller's IRQ bit	sei		; hold MIDI from using queue		ldx #errNotStarted	lda >awake	beq exit 		; weren't started, report err.	ldy <QueuePtr	lda #Midi_Note_On	sta CmdQueue,y	ldx #RangeError	lda s_channel,s	cmp #16	bge exit		; chan > 15	sta ChanQueue,y	lda s_key,s	cmp #128	bge exit		; note # > 127	sta KeyQueue,y	lda #16		; **** no such Track number	sta TrackQueue,x	iny	iny	tya	and #QueueSize-1	sta <QueuePtr	; Queue points to next open slot	ldx #0	; no errors* restore the registers, fix the stackexit	plp	pld	; get old direct reg	plb	; get old data bank	PopArgs s_argsize	txa							; get the error code.	cmp #1	; set the carry bit.	rtlChanQueue	DS.W QueueSizeKeyQueue	DS.W QueueSizeVolQueue	DS.W QueueSizeCmdQueue	DS.W QueueSizeTrackQueue	DS.W QueueSize*********************************************  Init a voice**  Input: Vchan, Vkey, Vvol********************************************VoiceInit	jsr Allocate	; get a generator in A and Y	bcc @2* c=1 :  all gens locked with priority > $7FFF	rts		; do nothing until gen is free* mark this gen into note list@2	phx	phy*	jsl >MidiInputPoll	ply	plx		sty <theGen	ldx vcbTbl,y	lda oscTbl,y	sta <theOsc		; 4 osc per gen	cmp #$1d	blt @15	brk $f2@15	sty <genNum,x	; remember the gen number* Now we need to copy the instrument parameters over to the vcb.	lda <Vchan	sta Chan,y********** Channel to Inst Look-up goes here *******************	asl A	sta <vcbCH,x	; save the ch number * 2 in vcb	phx	tax	lda mul320,x	; (0-16) * 320	plx	clc	adc #OCB	sta <inst_ptr	; get all 4 bytes of instrument	sta <I_Ptr,x	; I_Ptr used in Update* Calc the Wave List ptrs			; A wave is easy, its a fixed	clc	adc #_AWavelist	; offset from the beginning.	sta <Awaveptr	lda #_wlSize	; length of Awaves (8 wavelists of 8 bytes)	adc <Awaveptr	sta <Bwaveptr	; and B starts at the end of A.* Now search the wavelists for a topkey higher than our keynum.	lda <Vkey	and #$007f	sta Note,y		; y still has gennum	shortm	ldy #0loopA	cmp (Awaveptr),y	blt gotA	iny	iny	iny	iny	iny	iny	iny	iny	cpy #8*7	bne loopAgotA	longm	tya	clc	adc <Awaveptr	sta <Awaveptr	tya	clc	adc <Bwaveptr	sta <Bwaveptr	phx	phy	jsl >MidiInputPoll	ply	plx***************************************************************** Now we have to distribute the data about these waveforms***************************************************************** The pitch goes to the vcb	lda <Vkey		; get semitone in high byte	asl A		; table is WORD size	tay	lda Note_Tbl,y	; note tunning	sta <Temp	ldy #wp_pitch	; and add the relative pitch offset	clc	adc (Awaveptr),y	and #$7FFF		; wrap to a legal pitch	sta <vfreqA,x	lda <Temp		; retrieve semitone	clc	adc (Bwaveptr),y	and #$7FFF		; wrap to a legal pitch	sta <vfreqB,x	lda <Temp	ldy #wp_pitch+defLen	clc	adc (Awaveptr),y	and #$7FFF		; wrap to a legal pitch	sta <vfreq2A,x	lda <Temp		; retrieve semitone	clc	adc (Bwaveptr),y	and #$7FFF		; wrap to a legal pitch	sta <vfreq2B,x* save DETUNE factor in vcb	ldy #wp_detune	lda (Awaveptr),y	and #$00FF	sta <Detune1,x	ldy #wp_detune+defLen	lda (Awaveptr),y	and #$00FF	sta <Detune2,x* the wave address and size go to the doc	shortm	lda <theOsc	clc	adc #doc_addr	sta >GAdrL	lda >SysVol	ora #GptrInc	; auto-inc	sta >GStatReg	ldy #wp_addr	lda (Awaveptr),y	; transfer both 1 wave adresses	sta >GDataReg	lda (Bwaveptr),y	sta >GDataReg	ldy #wp_addr+defLen	lda (Awaveptr),y	; transfer both 2 wave adresses	sta >GDataReg	lda (Bwaveptr),y	sta >GDataReg	lda <theOsc	adc #doc_size	sta >GAdrL	ldy #wp_size	; now point to 1 wp_size	lda (Awaveptr),y	sta >GDataReg	lda (Bwaveptr),y	sta >GDataReg	ldy #wp_size+defLen	; now point to 2 wp_size	lda (Awaveptr),y	sta >GDataReg	lda (Bwaveptr),y	sta >GDataReg		 	longm	lda Vvol		; key vol 0-127	and #$7F	ldy #_vs	lda (Inst_Ptr),y	; vel gain	sta Vgvec+1		; ***** self modify	lda Vvol		; key vol 0-127	and #$7FVGvec	jmp div0		; **** address gets modifiedvgg	asl A		; since log tbl is in words	tay	lda LogTbl,y	sta <Temp		; log of key vol	ldy #Wvol	lda (Awaveptr),y	asl A		; since Log tbl is in words	and #$00FF	asl A		; make full range	tay	lda <Temp		; log of key vol	clc	adc LogTbl,y	and #$FFFE		; ExpTbl is now in words	tay	lda ExpTbl,y	asl A	tay	lda LogTbl,y	; ???????? find out why I had to do this	sta <volA,x	ldy #Wvol	lda (Bwaveptr),y	asl A	and #$00FF	asl A	tay	lda <Temp		; log of key vol	clc	adc LogTbl,y	and #$FFFE		; ExpTbl is now in words	tay	lda ExpTbl,y	asl A	tay	lda LogTbl,y	; ???????? find out why I had to do this	sta <volB,x* now do pair 2 vol	ldy #Wvol+defLen	lda (Awaveptr),y	asl A		; since Log tbl is in words	and #$00FF	asl A		; make full range	tay	lda <Temp		; log of key vol	clc	adc LogTbl,y	and #$FFFE		; ExpTbl is now in words	tay	lda ExpTbl,y	asl A	tay	lda LogTbl,y	; ???????? find out why I had to do this	sta <vol2A,x	ldy #Wvol+defLen	lda (Bwaveptr),y	asl A	and #$00FF	asl A	tay	lda <Temp		; log of key vol	clc	adc LogTbl,y	and #$FFFE		; ExpTbl is now in words	tay	lda ExpTbl,y	asl A	tay	lda LogTbl,y	; ???????? find out why I had to do this	sta <vol2B,x	phx	phy	jsl >MidiInputPoll	ply	plx	shortm**************************************************************** memory is still short* the vcb has pitch.* I deleted vibrato* Now to start up the envelopes:	ldy #_envelope	lda (inst_ptr),y	; get 1st breakpoint	sta <env_lim+1,x	stz <env_lim,x	; make word ($xx00)	ldy #_envelope+defLen	lda (inst_ptr),y	; get 1st breakpoint	sta <env_lim2+1,x	stz <env_lim2,x	; make word ($xx00)	longm	lda #3		; set pointer to	sta next_seg,x	; next segment is #2	sta next_seg2,x	; next segment is #2	ldy #_envelope+1	lda (inst_ptr),y	; get increment	sta <env_inc,x	ldy #_envelope+1+defLen	lda (inst_ptr),y	; get increment	sta <env_inc2,x		 	lda #min_vol*256	sta <env_cur,x	; offset level to min	sta <env_cur2,x	; offset level to min* Decay gain	ldy #_decaykbd	lda (inst_ptr),y	; get address	sta NDA1+1		; **** Self modify	ldy #_decaykbd+defLen	lda (inst_ptr),y	; get address	sta NDA2+1		; **** Self modify	lda <VKey	cmp #97	blt sub_off	lda #96sub_off	sec	sbc #36		; remove 3 octave offset	asl A	tayNDA1	lda ND0,y		; *** addr gets modified	sta <addDky1,xNDA2	lda ND0,y		; *** addr gets modified	sta <addDky2,x	lda #$FFFF	sta <sus_flag,x	; allow sustain switch	stz <sus_hold,x	; note still pressed* copy pitch bend multiplier addr to VCB	ldy #_pbend	lda (inst_ptr),y	; get address	sta <PBaddr,x	ldy #_pbflag	lda (inst_ptr),y	; get flag	sta <PBflag,x* All thats left is to compute the pitch.	jsr Set_Freq***************************************************************** By the time we get here, everything is ready to go.* just start the oscillators and clean up.	shortm	lda <theOsc	clc	adc #doc_ctrl	sta >GAdrL	lda >SysVol	ora #GptrInc	; auto inc	sta >GStatReg	ldy #wp_ctrl	lda (Awaveptr),y	; now get the 1 mode bytes	sta >GDataReg	lda (Bwaveptr),y	sta >GDataReg	ldy #wp_ctrl+defLen	lda (Awaveptr),y	; now get the 2 mode bytes	sta >GDataReg	lda (Bwaveptr),y	sta >GDataReg	longm* now we are done munging with the hardware and the data structures.* Restore the gen to its start priority.	lda #64		; start priority = 64	ldy <theGen	sta Priority,y	lda #Attack	sta State,y	phx	phy	jsl >MidiInputPoll	ply	plx	rts**************************** Set DOC Freq from vcb** x = vcb offset***************************Set_Freq	lda <PBaddr,x	sta pbvec+1		; *** self modifying	ldy <vcbCH,x	; channel number*2	lda chPBTbl,ypbvec	jmp mul00		; *** addr gets modifiedadd_pb	sta <Temp	lda <vfreqA,x	clc	adc <Temp		; add pitch bend	tay	lda [Freq_Tbl],y	adc <Detune1,x	; add detune to osc A	sta <FreqA	lda <vfreqB,x	clc	adc <Temp		; add pitch bend	tay	lda [Freq_Tbl],y	sec	sbc <Detune1,x	; subtract detune from osc B	sta <FreqB	lda <vfreq2A,x	clc	adc <Temp		; add pitch bend	tay	lda [Freq_Tbl],y	adc <Detune2,x	; add detune to osc A	sta <Freq2A	lda <vfreq2B,x	clc	adc <Temp		; add pitch bend	tay	lda [Freq_Tbl],y	sec	sbc <Detune2,x	; subtract detune from osc B	sta <Freq2B	shortm	lda <theOsc	clc	adc #doc_freqlo	sta >GAdrL		; talking to DOC freq lo reg	lda >SysVol	ora #GptrInc	; with auto inc	sta >GStatReg	lda <FreqA	sta >GDataReg	lda <FreqB	sta >GDataReg	lda <Freq2A	sta >GDataReg	lda <Freq2B	sta >GDataReg	lda <theOsc	adc #doc_freqhi	; now the hi freq	sta >GAdrL	lda <FreqA+1	sta >GDataReg	lda <FreqB+1	sta >GDataReg	lda <Freq2A+1	sta >GDataReg	lda <Freq2B+1	sta >GDataReg	longm	rts****************************** Multiplier for Pitch Bend*****************************PBtbl	DC.W mul00	DC.W mul01	DC.W mul02	DC.W mul03	DC.W mul04	DC.W mul05	DC.W mul06	DC.W mul07	DC.W mul08	DC.W mul09	DC.W mul10	DC.W mul11	DC.W mul12mul00	lda #0	jmp add_pbmul01	jmp add_pbmul02	asl A	; x2	jmp add_pbmul03	sta <Temp	asl A	clc	adc <Temp	; x2 + x1	jmp add_pbmul04	asl A	asl A	; x4	jmp add_pbmul05	sta <Temp	asl A	asl A	; x4 + x1	clc	adc <Temp	jmp add_pbmul06	asl A	sta <Temp	asl A	clc	adc <Temp	; x2 + x4	jmp add_pbmul07	sta <Temp	asl A	asl A	asl A	sec	sbc <Temp	; x8 - x1	jmp add_pbmul08	asl A	asl A	asl A	; x8	jmp add_pbmul09	sta <Temp	asl A	asl A	asl A	clc	adc <Temp	; x8 + x1	jmp add_pbmul10	asl A	sta <Temp	asl A	asl A	clc	adc <Temp	; x8 + x2	jmp add_pbmul11	sta <Temp	asl A	asl A	asl A	clc	adc <Temp	clc	adc <Temp	clc	adc <Temp	; x8 + x3	jmp add_pbmul12	asl A	asl A	sta <Temp	asl A	clc	adc <Temp	; x8 + x4	jmp add_pb************************* Divides for vel gain************************VGtbl	DC.W div112	DC.W div104	DC.W div96	DC.W div88	DC.W div80	DC.W div72	DC.W div64	DC.W div48	DC.W div32	DC.W div16	DC.W div0* 0div112	lsr A	sta <Temp+2	lsr A	sta <Temp	lsr A	clc	adc <Temp	adc <Temp+2	adc #$10	; Ö2 + Ö4 + Ö8 + $10	jmp vgg* 1div104	lsr A	sta <Temp+2	lsr A	sta <Temp	lsr A	lsr A	clc	adc <Temp	adc <Temp+2	adc #$18	; Ö2 + Ö4 + Ö16 + $18	jmp vgg* 2div96	lsr A	sta <Temp	lsr A	clc	adc <Temp	adc #$20	; Ö2 + Ö4 + $20	jmp vgg* 3div88	lsr A	sta <Temp+2	lsr A	lsr A	sta <Temp	lsr A	clc	adc <Temp+2	adc <Temp	adc #$28	; Ö2 + Ö8 + Ö16 + $28	jmp vgg* 4div80	lsr A	sta <Temp	lsr A	lsr A	clc	adc <Temp	adc #$30	; Ö2 + Ö8 + $30	jmp vgg* 5div72	lsr A	sta <Temp	lsr A	lsr A	lsr A	clc	adc <Temp	adc #$38	; Ö2 + Ö16 + $38	jmp vgg* 6div64	lsr A	clc	adc #$40	jmp vgg	; Ö2 + $40* 7div48	lsr A	lsr A	sta <Temp	lsr A	clc	adc <Temp	adc #$50	; Ö4 + Ö8 + $50	jmp vgg* 8div32	lsr A	lsr A	clc	adc #$60	; Ö4 + $60	jmp vgg* 9div16	lsr A	lsr A	lsr A	clc	adc #$70	; Ö8 + $70	jmp vgg* 10div0	lda #$7F	jmp vgg	; ° gain = $7F********************************** Note Tunning Table**********************************   msb			 lsb*    0 0 0 X  X X X X  X X x x  x x x 0*         |		  |__________|-----< Fine 0-31 *         | 	  |*         |_______________|----< Semi-tone 36-91z	equ 64Note_Tbl_Default	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 0	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 12	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 24	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 36	DC.W 48*z,49*z,50*z,51*z,52*z,53*z,54*z,55*z,56*z,57*z,58*z,59*z	; 48	DC.W 60*z,61*z,62*z,63*z,64*z,65*z,66*z,67*z,68*z,69*z,70*z,71*z	; 60	DC.W 72*z,73*z,74*z,75*z,76*z,77*z,78*z,79*z,80*z,81*z,82*z,83*z	; 72	DC.W 84*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z,92*z,93*z,94*z,95*z	; 84	DC.W 96*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z,92*z,93*z,94*z,95*z	; 96	DC.W 96*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z,92*z,93*z,94*z,95*z	; 108	DC.W 96*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z			; 120Note_Tbl	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 0	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 12	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 24	DC.W 36*z,37*z,38*z,39*z,40*z,41*z,42*z,43*z,44*z,45*z,46*z,47*z	; 36	DC.W 48*z,49*z,50*z,51*z,52*z,53*z,54*z,55*z,56*z,57*z,58*z,59*z	; 48	DC.W 60*z,61*z,62*z,63*z,64*z,65*z,66*z,67*z,68*z,69*z,70*z,71*z	; 60	DC.W 72*z,73*z,74*z,75*z,76*z,77*z,78*z,79*z,80*z,81*z,82*z,83*z	; 72	DC.W 84*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z,92*z,93*z,94*z,95*z	; 84	DC.W 96*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z,92*z,93*z,94*z,95*z	; 96	DC.W 96*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z,92*z,93*z,94*z,95*z	; 108	DC.W 96*z,85*z,86*z,87*z,88*z,89*z,90*z,91*z			; 120*************************************************************************** We are looking for a free generator, which* will be flagged by a 0 priority. If there are none of those, then we* want the lowest priority generator. We'll keep a variable, called* min, and keep the min's generator number in x.*************************************************************************Allocate	lda #$FFFF		; initialize min to max	sta <min	sta <min_r	ldy #0* FOR Y = 0 TO 13; 2+look	lda Priority,y 	; Get the Priority of osc	beq found_zero	; got one!*	bmi sacred		; Can't steal a priority of 128 or more.	ldx State,y	cpx #Release	bne Still_Down	; update min for oldest sustained voice* "min_r" holds the oldest released voice	dec a		; make old notes more desirable	bne over1r		; by decrementing their priority	inc a		; down to, but not past 1.over1r	cmp <min_r	bge too_high	; If >= min then continue(save new priority).	sta <min_r		; Else save priority as new min, and	sty <theGen_r	; hold min's gen num	bra too_high* "min" holds the oldest sustained voiceStill_Down	dec a		; make old notes more desirable	bne over1		; by decrementing their priority	inc a		; down to, but not past 1.over1	cmp <min	bge too_high	; If >= min then continue(save new priority).	sta <min		; Else save priority as new min, and	sty <theGen		; hold min's gen numtoo_high	sta Priority,y	; save priority of oscsacred	iny	iny							; NEXT Y	cpy #no_of_gen*2	 	; See If done.		bne look		; If not look again.* if we get here, then there were no free generators. See if there were any* that had a priority low enough to steal.* First, try to steal the oldest released voice.	lda <min_r	bmi try_other	; no released voices	ldy <theGen_r	bra Stole_One* Next, try for the oldest sustained voice.try_other	lda <min	bmi none_avail	; this should never happen!	ldy <theGenStole_One	sty <theGen	lda oscTbl,y	sta <theOsc		; 4 osc per gen	jsr halt_gen* When we get here, then y has the gen num of the one we'll give away.found_zero	tya	clc	rtsnone_avail	sec	rts*****************************************************************	Make_F_Tbl**	Build DOC pitch to freq table**	Inputs:	Freq_Tbl - pointer to 8k mem**	Outputs:	none******************************************************************Shift_Cnt	DC.W 10Semi_Sav	DC.W 32Note_Sav	DC.W 12	Oct_Sav	DC.W 10toSav	DC.W 0ftSav	DC.W 0Make_F_Tbl	lda #10	sta Oct_Sav		; 10 octaves	stz ftSav		; index to result freq tableOct_LP	stz toSav		; index to top oct table	lda #12	sta Note_SavNote_Lp	    lda #32	    sta Semi_SavSemi_Lp	        lda Oct_Sav	        inc A	        sta Shift_Cnt	        ldy toSav	        lda Top_Octave,y	; top octave	        iny	        iny	        sty toSavShift_Lp		dec Shift_Cnt		beq @1		lsr A		bra Shift_Lp@1	        ldy ftSav	        sta [Freq_Tbl],y	; store to freq_Tbl	        iny	        iny	        sty ftSav	        dec Semi_Sav	        bne Semi_Lp	    dec Note_Sav	    bne Note_Lp	dec Oct_Sav	bne Oct_Lp	rts************************** Note - Decay Table*************************ND_Tbl	DC.W ND0	DC.W ND1	DC.W ND2	DC.W ND3	DC.W ND4	DC.W ND5	DC.W ND6	DC.W ND7	DC.W ND8	DC.W ND9ddk	equ 1ndk0	equ 0ndk1	equ ddk+ndk0ndk2	equ ddk+ndk1ndk3	equ ddk+ndk2ndk4	equ ddk+ndk3ndk5	equ ddk+ndk4ndk6	equ ddk+ndk5ndk7	equ ddk+ndk6ndk8	equ ddk+ndk7ndk9	equ ddk+ndk8ND0	DC.W ndk0*00,ndk0*00,ndk0*00,ndk0