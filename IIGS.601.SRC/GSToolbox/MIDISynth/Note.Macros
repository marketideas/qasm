;;  &lab DSectSize;;  This macro equates the given label with the;  current dummy PC defined by the DSect,;  GlobalDSect, or DefineStack macros. This is;  useful for determing the size of data sections;  or parts of data sections.; MACRO&lab PopArgs &num&lab  IF &num='' GOTO .DONE IF &Eval(&num)=0 GOTO .DONE LCLA &popnum&popnum SETA &Eval(&num) IF &popnum>=6 GOTO .DOPULLS lda 5,s sta 5+&popnum,s lda 3,s sta 3+&popnum,s IF &popnum<2 GOTO .MOVEUP1 pla&popnum SETA &popnum-2 sta 1+&popnum,s IF &popnum>0 GOTO .DISCARD MEXIT.MOVEUP1 pla phb sta 1,s MEXIT.DOPULLS pla sta &popnum-1,s pla sta &popnum-1,s pla sta &popnum-1,s&popnum SETA &popnum-6 IF &popnum=0 GOTO .DONE.DISCARD IF &popnum=1 GOTO .DISCARD1 IF &popnum=2 GOTO .DISCARD2 tsc clc adc #&popnum tcs MEXIT.DISCARD1 phb.DISCARD2 pla.DONE MEND	MACRO&lab	IncPtr &amt,&adr&lab	lda &adr	clc	adc #&amt	sta &adr	bcc @a	inc &adr+2@a	MEND	MACRO&lab	IncPtr2 &amt,&adr1,&adr2&lab	lda &adr1	clc	adc #&amt	sta &adr2	lda &adr1+2	adc #0	sta &adr2+2	MEND	MACRO&lab	DecPtr &amt,&adr&lab	lda &adr	sec	sbc #&amt	sta &adr	bcs @a	dec &adr+2@a	MEND	MACRO&lab	DecPtr2 &amt,&adr1,&adr2&lab	lda &adr1	sec	sbc #&amt	sta &adr2	lda &adr1+2	sbc #0	sta &adr2+2	MEND	MACRO	beql &A		bne  @dontTake		brl  &A@dontTake	MEND	MACRO	bccl &A		bcs  @dontTake		brl  &A@dontTake	MEND	MACRO	bgtl &A		blt  @dontTake		beq  @dontTake		brl  &A@dontTake	MEND	MACRO	bnel &A		beq  @dontTake		brl  &A@dontTake	MEND	MACRO	bgt &A		beq  @dontTake		bge  &A@dontTake	MEND	MACRO	ble &A		blt  &A		beq  &A	MEND	MACRO	cmpl &A,&B	IF &B='' THEN		cpx  &A+2		bne  @1		cmp  &A	ELSE		lda  &A+2		cmp  &B+2		bne  @1		lda  &A		cmp  &B	ENDIF@1	MEND	MACRO	bmil &A		bpl  @dontTake		brl  &A@dontTake	MEND	MACRO	bcsl &A		bcc  @dontTake		brl  &A@dontTake	MEND	MACRO	bpll &A		bmi  @dontTake		brl  &A@dontTake	MEND	MACRO&lab	PushPtr &addr&lab	dc.B $F4	dc.W (&addr)>>16	dc.B $F4	dc.W &addr	MEND