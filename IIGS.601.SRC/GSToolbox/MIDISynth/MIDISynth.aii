********************************************************************* Copyright 1990-1991 Apple Computer, Inc* All Rights Reserved********************************************************************** REVISION HISTORY** 24-Oct-91 Dave Lyons** Added a CMP #$F0 to MSStartUp to prevent a bogus generator-* in-use error if the Sound Tools had already been used, leaving* a nonzero value at offset $F0 on Sound direct page.  (This byte* is *not* the status of the reserved generator!)********************************************************************;-----------------------------------------------;;	Imported addresses;;-----------------------------------------------	IMPORT AddMidiHook	IMPORT AllNotesOff	IMPORT update	IMPORT NoteOn	IMPORT NoteOff	IMPORT AllNotesOff	IMPORT Make_F_Tbl	IMPORT EnableMidiIn	; midi.control.aii	IMPORT DisableMidiIn	; midi.control.aii	IMPORT EnableMidiOut	; midi.control.aii	IMPORT DisableMidiOut	; midi.control.aii	IMPORT SetMIDIPort	;       ""	IMPORT SetMidiChan	;       ""	IMPORT SetMidiMode	;       ""	IMPORT StartMIDIDriver	;       ""	IMPORT StopMIDIDriver	;       ""	IMPORT PortShutDown	; midi.Driver.aii	IMPORT DefineInst	; check.aii	IMPORT SynthPlayer	;   "	IMPORT SetTempo	;   "	IMPORT SetUserCallBack	;   "	IMPORT BeatTicks	;   "	IMPORT SetBeat	;   "	IMPORT GetTempo	;   "	IMPORT SetRecTrack	;   "	IMPORT SetPlayTrack	;   "	IMPORT TrackToChannel	;   "	IMPORT Locate	;   "	IMPORT SetVelComp	;   "	IMPORT LocateEnd	;   "	IMPORT Merge	;   "	IMPORT DeleteTrack	;   "	IMPORT SetMetro	;   "	IMPORT GetMSData	;   "	IMPORT CalcTime	;   "	IMPORT CalcMeasure	;   "	IMPORT MSSuspend	;   "	IMPORT MSResume	;   "	IMPORT MSstate	;   "	IMPORT SetTuningTable	;   "	IMPORT GetTuningTable	;   "	IMPORT SeTrackOut	;   "	IMPORT SysExOut	;   "	IMPORT OutBuf	; Midi.Driver.aii	IMPORT ClearNtbl	; NoteOff.aii	IMPORT MIDICmd	; NoteOn.aii	IMPORT PlayTrack	IMPORT SeqOutState	IMPORT TChanList	IMPORT MSstate	IMPORT BufDispatcher;-----------------------------------------------;;	Forward addresses and entries;;-----------------------------------------------	ENTRY NSBoot	ENTRY NSReset	ENTRY NSShutdown	ENTRY NSStartStat	ENTRY NSStartup	ENTRY NSVersion	ENTRY NotImp	MACHINE M65816		INCLUDE 'all.macros'	INCLUDE 'ns.equ'	INCLUDE 'note.macros'	INCLUDE 'E16.Memory'	longa on	longi on*---------------------------------------------------------------** ROUTINE:	FPT ** FUNCTION:	MIDI Synth Function Pointer Table** INPUT:	none** OUTPUT:	none** NOTES:	**---------------------------------------------------------------FPT	PROC	EXPORT MIDISynCallTableMIDISynCallTable	DC.L (EndFPT-MIDISynCallTable)/4	; number of calls	DC.L NSBoot-1	;0123 MSBootInit	DC.L NSStartup-1	;0223 MSStartUp	DC.L NSShutdown-1	;0323 MSShutDown	DC.L NSVersion-1	;0423 MSVersion	DC.L NSReset-1	;0523 MSReset	DC.L NSStartStat-1	;0623 MSStatus	DC.L NotImp-1	;0723	DC.L NotImp-1	;0823	DC.L SetMidiChan-1	; 0923	DC.L SetMidiMode-1	; 0A23	DC.L NoteOn-1	; 0B23	DC.L NoteOff-1	; 0C23	DC.L AllNotesOff-1	; 0D23 	DC.L SetRecTrack-1	; 0E23 	DC.L SetPlayTrack-1	; 0F23	DC.L TrackToChannel-1	; 1023	DC.L Locate-1	; 1123	DC.L SetVelComp-1	; 1223	DC.L SetMIDIPort-1	; 1323	DC.L DefineInst-1	; 1423 - check Inst Rec into synth	DC.L SynthPlayer-1	; 1523 - sequencer control	DC.L SetTempo-1	; 1623 - sequencer Tempo	DC.L SetUserCallBack-1	; 1723 - Set the call back routines	DC.L SysExOut-1	; 1823 - Output SysEx message to MIDI	DC.L SetBeat-1	; 1923 - number of ticks per beat	DC.L MIDICmd-1	; 1A23 - MIDI message to synth	DC.L LocateEnd-1	; 1B23 - End of seq address	DC.L Merge-1	; 1C23 - merge 2 seq buffers	DC.L DeleteTrack-1	; 1D23 - Delete items from buffer with track	DC.L SetMetro-1	; 1E23 - Init metronome	DC.L GetMSData-1	; 1F23 - MS direct page	DC.L CalcTime-1	; 2023 - Calc time from measure,beat	DC.L CalcMeasure-1	; 2123 - Calc measure,beat from time	DC.L MSSuspend-1	; 2223 - stop tick IRQ's	DC.L MSResume-1	; 2323 - continue tick IRQ's	DC.L SetTuningTable-1	; 2423	DC.L GetTuningTable-1	; 2523	DC.L SeTrackOut-1	; 2623 - Seq out, synth or MIDI	DC.L StartMIDIDriver-1	; 2723	DC.L StopMIDIDriver-1	; 2823EndFPT	ENDPFASTTBL	PROC EXPORT	DC.L 0	ENDP*---------------------------------------------------------------** ROUTINE:	NSBoot ** FUNCTION:	Tool Call #1** INPUT:	none** OUTPUT:	none** NOTES:	**---------------------------------------------------------------	EXPORT NSBoot	NSBoot	PROC* clear out my cubbyhole and thereby reset the 'awake' flag	ldx #10	; 12 bytes there	lda #0@clear	sta >cubbyhole,x	dex	dex	bpl @clear	shortm	lda #$6B		; RTL	sta MidiInputPoll	; set up MIDI input polling vector	longm	clc	rtl	ENDP*---------------------------------------------------------------** ROUTINE:	NSStartup ** FUNCTION:	Tool Call #2** INPUT:	none** OUTPUT:	Error Codes:*		NoDPError	- Can't get  Direct Page memory.*		NoMemError	- Can't get memory block.*		MiscToolError - Misc Tools not started.*		SoundError	- Sound Tool Set not started.*		GenError	- Generator in use.*		errstarted	- MIDI Synth already started.** NOTES:	**---------------------------------------------------------------NSStartup	PROC EXPORT	IMPORT SetDefaultNoteTable	IMPORT SetCB	EXPORT Priority	EXPORT Note	EXPORT vcbTbl	EXPORT oscTbl	EXPORT Chan	EXPORT State	EXPORT chVolTbl	EXPORT chSusTbl	EXPORT chPBTbl	EXPORT SetGCB	EXPORT MIDIdp* Start by checking if we're already started.	lda >awake	beq asleep	ldx #errstarted	jmp exitasleep	phb		; save user data bank reg	phk	plb		; my data bank = pc bank	phd		; save user DP; get handle for gcb and vcb_ram.	pha								; space for result.	pha								;	PushLong #DPforNS 	PushWord #NSID	; get the id to use for NS.	lda #attrlocked+attrNoCross+attrfixed+attrPage+attrBank	pha								;	PushLong #0		; zero bank	_NewHandle		; get my memory.	tax								; save the error code, if error.	tsc		; turn stack into direct page	tcd	lda [1]		; deref the pointer	sta >myDP		; we know that high word is 0	tcd		; set my DP	clc	adc #$300	sta MIDIdp		; MIDI Driver's DP	pla	pla	bcc doFT	ldx #noDPError	; can't get Direct Page	jmp exit1; get handle for pitch-to-freq tabledoFT	pha								; space for result.	pha								;	PushLong #12*32*10*2 	PushWord #NSID	; get the id to use for NS.	lda #attrlocked+attrNoCross+attrfixed	pha								;	PushLong #0		; zero bank	_NewHandle		; get my memory.	PullLong <Temp	bcc doFT1	ldx #noMemError	; can't get memory	jmp exit1doFT1	ldy #2	lda [Temp]	sta <Freq_Tbl	lda [Temp],y	sta Freq_Tbl+2	jsr Make_F_Tbl	; make the table; get handle for MIDI note table	pha								; space for result.	pha								;	PushLong #128*16 	PushWord #NSID	; get the id to use for NS.	lda #attrlocked+attrNoCross+attrfixed	pha								;	PushLong #0		; zero bank	_NewHandle		; get my memory.	PullLong <Temp	bcc doFT2	ldx #noMemError	; can't get memory	jmp exit1doFT2	ldy #2	lda [Temp]	sta <NoteList	lda [Temp],y	sta <NoteTracker+2	jsr ClearNtbl	; Mark all notes as off; get handle for MIDI OUT buffer	pha								; space for result.	pha								;	PushLong #BufLen 	PushWord #NSID	; get the id to use for NS.	lda #attrlocked+attrNoCross+attrfixed	pha								;	PushLong #0		; zero bank	_NewHandle		; get my memory.	PullLong <Temp	bcc doFT3	ldx #noMemError	; can't get memory	jmp exit1doFT3	ldy #2	lda [Temp]	sta <OutBuffer	lda [Temp],y	sta <OutBuffer+2; get handle for MIDI IN buffer	pha								; space for result.	pha								;	PushLong #BufLen 	PushWord #NSID	; get the id to use for NS.	lda #attrlocked+attrNoCross+attrfixed	pha								;	PushLong #0		; zero bank	_NewHandle		; get my memory.	PullLong <Temp	bcc doFT4	ldx #noMemError	; can't get memory	jmp exit1doFT4	ldy #2	lda [Temp]	sta <InBuffer	lda [Temp],y	sta <InBuffer+2	jsr SetDriverDP	; move self-modifying code to Driver DP* Stack contents:   2 for DP, 1 for DB, 6 for rtl* rtl* rtl* user Data Bank* user Direct Page* Make sure Sound Tools are started	pha	_SoundToolStatus	pla	bne GetSVec	ldx #SoundError	; Sound Tools not started	jmp exit1* Save the Sound Tool IRQ vectorGetSVec	pha	pha	pea $000B		; sound irq vector	_GetVector	PullLong IRQmaster	; save Sound Tool IRQ vector	bcc doFT5	ldx #MiscToolError	; Misc Tools not started	jmp exit1doFT5	lda IRQmaster	sta SoundIRQ+1	lda IRQmaster+1	sta SoundIRQ+2	; *** Self-modify **** Get Sound Tool's direct page (GCB)	pushlong #0		; room for result	pushword #0		; system tool/ sound tool	pushword #8		; Sound Tools	_GetWAP	PullLong GCBaddr* Make sure all Gens are free	lda GCBaddr	sta <Temp	lda GCBaddr+2	sta <Temp+2	shortmx	lda #0@1	tay	lda [Temp],y	beq @2		; it's free	longmx	ldx #GenError	; Generator in use	jmp exit1	shortmx@2	tya	clc	adc #$10*** added 24-Oct-91 DAL -- prevent bogus generator-in-use error after using***                        sound tools	cmp #$F0		;stop checking after last real generator*** end 24-oct-91	bcc @1	longmx	lda #My_ID	jsr SetGCB		; claim all Osc (except Osc 28,29)* Sound IRQ's will allways come to us.	lda #^Synth_irq	pha 	lda #<Synth_irq	pha 	_SetSoundMIRQV	lda $E10148	sta ApplePatchSav	lda $E10148+2	sta ApplePatchSav+2	lda ApplePatch	sta $E10148	lda ApplePatch+2	sta $E10148+2	; Apple reserved osc (#31) IRQ			; if you use 'FFStartSound' with MIDI Synth* Init MIDI;;  device driver not loaded;	lda #$6B		; RTL	sta MidiInputPoll	; set up MIDI input polling vector	lda MIDIdp	sta MidiInputPoll+1	lda #$5C		; JML	sta MidiInputPoll+3	lda #$FFFF	sta MidiInputPoll+4	lda #$FFFF	sta MidiInputPoll+6	stz <InPortEnable	; Midi IN port is off	stz <OutPortEnable	; Midi OUT port is off	lda #1	stz <QueueOut	; Make QueuePtr = QueueOut	stz <QueuePtr	; no data in Queue	stz <InBufStart	sta <InBufIndex	stz <OutBufIndex	stz <OutStartIndex	stz <SeqFlags	lda #96		; quarter note	sta BeatTicks	lda #110	sta <TempoBPM	; Global BPM 	jsr GetTempo	; 120 BPM	stz <MMode		; Omni mode	stz <BasicCh	; channel zero	lda #MetroDefaultFreq	sta <MetroFreq	lda #MetroDefaultVol	sta <MetroVol	jsr SetDefaultNoteTable	lda #DefaultCB	sta <BufPtr	lda #^DefaultCB	sta <BufPtr+2	jsr SetCB		; init the callbacks	stz MSstate		; we're not suspended	ldx #16	lda #00	tay@11	sta PlayTrack,y	; set all tracks for non-play	sta SeqOutState,y	; all tracks both Q and MIDI	dec A		; = $FFFF	sta TChanList,y	; all track channels "thru"	inc A		; = 0	iny	iny	dex	bne @11	stz <RecTrack	; set track #1 for record	stz <VelOffset	; no velocity offset* initialize the priority and state tables in zero page.	lda #Priority	sta <PStore	lda #^Priority	sta <PStore+2	ldx #no_of_Gen*2	lda #00fill	sta Priority,x	sta State,x	sta Note,x	sta Chan,x	dex	dex	bpl fill* Gen #15 used by synth for timer	ldx #no_of_Gen*2	lda #$FFFF	sta Priority,x	lda #1	sta >awake		; flag that MS is active	shortm	php			; save status	sei			; no interupts while using DOC Glue.		 	lda >SysVol	sta >GStatReg		; no inc, to doc	lda #doc_freqlo+timer_osc	; set frequency of the	sta >GAdrL			; timer osc	lda #<500*2	sta >GDataReg	lda #doc_freqhi+timer_osc	sta >GAdrL	lda #>500*2	sta >GDataReg	lda #doc_vol+timer_osc		; zero volume	sta >GAdrL	lda #$00	sta >GDataReg	lda #doc_size+timer_osc	sta >GAdrL	lda #$00	sta >GDataReg	lda #doc_addr+timer_osc	sta >GAdrL	lda #$00			; page 0	sta >GDataReg	lda #doc_ctrl+timer_osc	sta >GAdrL	lda #doc_irq_bit		; free run, interrupts	sta >GDataReg	plp							; reenable interupts.	longmx	lda #1	sta MSstate		; Tick IRQ's are ON	ldx #0		; no errorexit2	pld		; user DP	plb		; user DBexit	txa	cmp #1	rtlexit1	phx		; save ERROR code	Pushword #NSID	_HUnlockAll	Pushword #NSID	_Disposeall	plx		; restore ERROR code	bra exit2SetDriverDP	phd		; save DP	lda MIDIdp	tcd	ldx #0codeloop	lda dp_code,x 	; copy one word per loop	sta <0,x	inx	inx	cpx #dp_codesize	bcc codeloop	tdc						; patch direct page location	sta MidiZP1	sta MidiZP1b	pld		; restore DP	rtsdp_code	DC.B	$00 	; reserved byte at start of direct page;  jump to routine to do I/O buffering - called by driver routines	jml BufDispatcher;  This is a small glue routine installed in the direct page and modified;  there by MidiStartup.  It is called by the //GS interrupt handler to;  service MIDI interrupts.	rep #$30 		; long accumulator	lda #$FFFF		; get new direct page	jsl $FFFFFF		; call driver int. handler	sep #$30 		; restore 8-bit native mode	bcs oldvec		; driver didn't service interrupt	rtloldvec	jml $FFFFFF		; call old interrupt handler;; poll MIDI input;	rep #$30 		; long accumulator and registers	longa on	longi on	lda #$FFFF		; get direct page 1	jsl $FFFFFF		; poll MIDI input	sep #$30 		; short accumulator and registers	rtldp_codesize	equ *-dp_code	EXPORT IRQmaster	; for shutdownIRQmaster	DC.L 0		; Sound Tool IRQ savePriority	DC.W 0,0,0,0,0,0,0,0State	DC.W 0,0,0,0,0,0,0,0Note	DC.W 0,0,0,0,0,0,0,0Chan	DC.W 0,0,0,0,0,0,0,0chVolTbl	DC.W $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF	DC.W $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FFchSusTbl	DC.W $00,$00,$00,$00,$00,$00,$00,$00	DC.W $00,$00,$00,$00,$00,$00,$00,$00chPBTbl	DC.W $00,$00,$00,$00,$00,$00,$00,$00	DC.W $00,$00,$00,$00,$00,$00,$00,$00vcbTbl	DC.W $100	DC.W $100+(vcbSize*1)	DC.W $100+(vcbSize*2)	DC.W $100+(vcbSize*3)	DC.W $100+(vcbSize*4)	DC.W $100+(vcbSize*5)	DC.W $100+(vcbSize*6)	DC.W $100+(vcbSize*7)oscTbl	DC.W 0	DC.W 4*1	DC.W 4*2	DC.W 4*3	DC.W 4*4	DC.W 4*5	DC.W 4*6	DC.W 4*7DefaultCB	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0MIDIdp	DC.W 0		; MIDI Driver's DP*---------------------------------------------------------------** ROUTINE:	SetGCB ** FUNCTION:	Set Mode byte of all Gens in GCB** INPUT:	A = Mode** OUTPUT:	none** NOTES:	Gen #7 (Osc 28,29) will be marked as free**---------------------------------------------------------------SetGCB	sta GCB_Mode	; save Mode for later	lda GCBaddr	sta <Temp	lda GCBaddr+2	sta <Temp+2	shortmx	lda #0		; start with Gen #0@1	tay	lda GCB_Mode	sta [Temp],y	; write the Mode byte	tya	clc	adc #$10	bcc @1		; get all 16 Gens	ldy #7*16	lda #0	sta [Temp],y	; Gen #7 is FREE	longmx	rtsGCB_Mode	DC.W 0GCBaddr	DC.L 0ApplePatch	jmp >Synth_irq1	EXPORT ApplePatchSav	; for shutdownApplePatchSav	DC.L 0*---------------------------------------------------------------** ROUTINE:	Synth_irq ** FUNCTION:	Service DOC interrupts** INPUT:	$E100CC - Number of Osc causing IRQ** OUTPUT:	none** NOTES:	Osc 31 is the only IRQ active MIDI Synth oscillator.*	Go to Sound Tool's IRQ vector if not Osc 31.*	Sound Tools can use only Gen #7 (Osc 28,29).**---------------------------------------------------------------	LONGA OFF 	LONGI OFF 	Synth_irq	phd 		; save direct register	phb	phk	plb		; get our Data Pointer	lda >myDP+1		; point to our work area	pha 		lda >myDP	pha	pld	lda >$E100CCnxt_osc_irq		sep #$30		; native	lsr A		; put it in workable form	and #$1F		; 32 oscillators	cmp #$1F		; check for oscillator 31	bcc not_apple	; let Sound Tools handle it	php	longmx*	shortm*	lda #$FF*	sta $E1C0F0*	longm	jsr update*	shortm*	lda #$80*	sta $E1C0F0*	longm	plp	bra chk_nxt_osc	; check rest of oscillatorsnot_apple* If its not Osc #31, then it must be Sound Tool Gen #7 (osc 28,29)	lda >$E100CC	plb	pld 		; restore direct registerSoundIRQ	jmp >not_apple	; *** Gets modified *****chk_nxt_osc		shortm	lda >SysVol		; select DOC no auto incr	sta gstatreg	lda #doc_IRQ	; read DOC irq register	sta gadrl	lda GDataReg	; read the DOC irq register	lda GDataReg	bpl nxt_osc_irq	; got a live one!!exit_irq	plb	pld 		; restore direct register	clc 		; flag that we serviced the IRQ	rtl Synth_irq1	phd 		; save direct register	phb	phk	plb		; get our Data Pointer	lda >myDP+1		; point to our work area	pha 		lda >myDP	pha	pld	php	longmx	jsr update	plp	plb	pld 		; restore direct register	clc 		; flag that we serviced the IRQ	rtl 	ENDP*---------------------------------------------------------------** ROUTINE:	NSShutdown ** FUNCTION:	Tool Call #3** INPUT:	none** OUTPUT:	Error Codes:*		errNotStarted - MIDI Synth not started.** NOTES:	**---------------------------------------------------------------	LONGA ON 	LONGI ON 	NSShutdown PROC EXPORT	IMPORT SetGCB	IMPORT ApplePatchSav	IMPORT IRQmaster	phd		; save old direct page	lda >myDP	tcd	phb		; save caller's data bank	phk	plb		; get our data bank	php		; save caller's IRQ bit*	sei	lda >awake	bne proceed* its not started!	ldx #errNotStarted	jmp returnerrproceed	ldx #0		; loop counter	php	sei	shortm	lda #doc_ctrl	sta >GAdrL	lda >SysVol	ora #GptrInc	; auto inc	sta >GStatReg	lda #doc_halt_resetDisableLoop	sta >GDataReg	Inx	cpx #32		; set all 32 osc to 'halt'	bne DisableLoop	plp	longm	jsr DisableMIDIIn	; restore Quickdraw FPT	jsl StopMIDIDriver	; shut down the MIDI driver* clear out my cubbyhole and thereby reset the 'awake' flag	ldx #10		; 12 bytes there	lda #0clear2	sta >cubbyhole,x	dex	dex	bpl clear2* Free all Gens in GCB	lda #0	jsr SetGCB	lda ApplePatchSav	sta $E10148	lda ApplePatchSav+2	sta $E10148+2	; Apple reserved osc (#31) IRQ	PushLong IRQmaster	_SetSoundMIRQV	; restore Sound Tool's IRQ* Dispose of all memory.;;; 20-Oct-91 DAL -- We're already doing a DisposeAll, so there is no;;;                  point in doing HUnlockAll or PurgeAll.  These were;;;                  not working before, because it was trying to dispose;;;                  of itself!;;;	Pushword #NSID;;;	_HUnlockAll	Pushword #NSID	_DisposeAll;;;	Pushword #NSID;;;	_PurgeAll	ldx #0returnerr	plp		; restore interrupts	plb		; restore data bank	pld		; restore old direct page	txa		; restore error code	cmp #1		; set carry for error	rtl	ENDP*---------------------------------------------------------------** ROUTINE:	NSVersion ** FUNCTION:	Tool Call #4** INPUT:	none** OUTPUT:	none** NOTES:	**---------------------------------------------------------------NSVersion PROC EXPORT			lda #version_number	sta 7,s	lda #0	clc	rtl	ENDP*---------------------------------------------------------------** ROUTINE:	NSReset ** FUNCTION:	Tool Call #5** INPUT:	none** OUTPUT:	none** NOTES:	Should never be called!**---------------------------------------------------------------NSReset	PROC EXPORT*	jsl NSShutdown*	jsr StopMIDIDriver	lda #0		;no error, either way...	clc	rtl	ENDP*---------------------------------------------------------------** ROUTINE:	NSStartStat ** FUNCTION:	Tool Call #6** INPUT:	none** OUTPUT:	A = $0000 if MIDI Synth not active** NOTES:	**---------------------------------------------------------------NSStartStat PROC EXPORT			lda >awake	beq notstarted	lda #$FFFF		; yes, we are active	bra exitnotstarted	lda #0		; no we are notexit	sta 7,s	lda #0	clc	rtl	ENDP*---------------------------------------------------------------** ROUTINE:	NotImp ** FUNCTION:	Tool Call** INPUT:	none** OUTPUT:	A = $FFFF and C = 1** NOTES:	**---------------------------------------------------------------NotImp	PROC	lda #-1	sec	rtl	ENDP	END