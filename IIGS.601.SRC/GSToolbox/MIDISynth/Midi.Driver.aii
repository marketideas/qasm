;-------------------------------------------------------;;  midiDriver.asm;;;-------------------------------------------------------	INCLUDE 'all.macros'	INCLUDE 'Note.Macros'	INCLUDE 'ns.equ';-------------------------------------------------------;;  BufDispatcher;;  This routine is called indirectly by driver input;  and output handlers.  When the driver wishes to;  call one of the MIDI Tool Set buffering routines,;  it executes the following code:;;	 PEA $XX00	 ; where XX is a function code.;	 PHD	 ; where D = our direct page;	 RTL;;  This switches execution to the instruction at offset;  one in the direct page. This instruction contains;  a JML to BufDispatcher. On entry, the function;  code XX is still on the stack.  By pulling this;  value into processor status register, various;  branches can be performed depending on the values;  of the flags.;;  Current function codes:;	$04  -  place the value in the low byte of;		the accumulator into the input buffer;	$05  -  the low byte of the accumulator;		contains a code indicating an input;		error;	$84  -  request a byte from the output buffer;;-------------------------------------------------------BufDispatcher  PROC EXPORT	EXPORT MidiInVec1	import BufInput	import BufOutput	plp		; SEI, CLD, long A and index registers	phd		; save driver's direct page	bmi output		; minus for output, carry set on error	bcc input	sta >MidiError	pld		; restore driver's direct page	rtl*	bmi output		; minus for output, carry set on errorinput	clcMidiInVec1	jsl noMerror	; Call-Back	bcs dontUse		; don't buffer it	jsr BufInput	; buffer itdontUse	pld		; restore driver's direct pagenoMerror	rtl	EXPORT MidiErrorMidiError	DC.W 0	shortm	lda >$E1C034	and #$F0		; set border to light gray @@@@	sta >$E1C034	longmoutput	jsr BufOutput	; retrieve next output character*	bcs nochar		; no character availablenochar	pld		; restore driver's direct page	rtl	ENDPBufRtns	PROC	EXPORT BufInput	EXPORT BufOutput	EXPORT FillBuffer	EXPORT FillBuffer1***************************************  Store MIDI byte in "A" to Buffer***************************************	IMPORT ClockSourceBufInput		longmx	tax		; save MIDI char	phd		; save callers Direct Page	lda >MyDP		; get our direct page	tcd	phb		; save callers Data Bank	phk	plb		; set our Data Bank	txa		; MIDI char	and #$00FF		; clear high byte	sta MidiByte	; save input char	ldx SysExFlag	bne SXmode		; special Sys Ex mode	cmp #$FE	bge DontBuf		; Ignore Active Sensing and ResetContinIn	cmp #SysEx	bne StoreIt		; not System Exclusive	sta SysExFlag	; do special until next Status Msg or EOX	bra SXcallbackStoreIt	cmp #MIDITiming	; MIDI Timing?	bne BufByte		; no.	lda ClockSource	beq DontBuf		; No need to buffer it, we're using internal clockBufByte	lda <InBufIndex	tay	inc A		; set-up for next store	and #BufLen-1	; circular buffer	sta <InBufIndex		shortm	lda MidiByte	; get input char	sta [InBuffer],y	longm	DontBuf	plb		; restore Data Bank	pld		; restore Direct Page	rts	EXPORT UserSysExSXmode	cmp #EOX	bne Test4RT		; not end of message	stz SysExFlag	; we're no longer in SysEx	bra SXcallbackTest4RT	cmp #$00F1	bge DontBuf1	; it's a Sys Real-Time Msg	and #$0080	bne EndMsg		; it's a Status Msg	lda MidiByteSXcallback	jsr UserSysExDontBuf1	plb		; restore Data Bank	pld		; restore Direct Page	rtsEndMsg	lda #EOX		; finish current message	jsr UserSysEx	stz SysExFlag	; we're no longer in SysEx	lda MidiByte	bra ContinInUserSysEx	jsl DummyCB		; *** gets modified ***	rtsDummyCB	RTL	EXPORT SysExFlagMidiByte	DC.W 0SysExFlag	DC.W 0		; if ­ 0, we're getting SysEx data	;-------------------------------------------------------;;  BufOutput;;  Request next character from the output buffer.;;  Inputs:;	none;;  Outputs:;	Carry clear if got a character, carry set if;	  output buffer is empty.;	Accumulator (low byte) contains character if;	  the carry is clear, otherwise A is;	  undefined. The high byte is undefined in;	  either case.;;  Registers:;	Not preserved. Accumulator may contain next;	character.;;  NOTE: This routine is not called directly, but;		 entered through the BufDispatcher routine.;;-------------------------------------------------------BufOutput	longmx		phd		; save callers Direct Page	lda >MyDP		; get our direct page	tcd	phb		; save callers Data Bank	phk	plb		; set our Data Bank		ldy <OutStartIndex	cpy <OutBufIndex	beq BufEmpty	shortm	lda [OutBuffer],y	longm	pha	tya	inc A		; set-up for next store	and #BufLen-1	; circular buffer	sta <OutStartIndex	pla	plb		; restore Data Bank	pld		; restore caller's Direct Page	clc		; c=0, there's still data in buffer	rtsBufEmpty	plb		; restore Data Bank	pld		; restore caller's Direct Page	sec		; c=1, buffer is empty	rts	EXPORT SysOutFlagSysOutFlag	DC.W 0* must preserve y	EXPORT UserMoutFillBuffer1	phy	bra FillBuffer2FillBuffer	phyUserMout	jsl DummyCB		; 'PacketOut' call-back *** gets modified ***FillBuffer2	lda <OutPortEnable	beq NoOutBuf	; MIDI out disabled	lda <SeqItem	and #$00FF	jsr FillBufferx	bcs NoOutBuf1	; overflow!	dec <ByteCount	bmi NoOutBuf	; no data bytes	lda <SeqItem+1	and #$00FF	jsr FillBufferx	bcs NoOutBuf1	; overflow!	dec <ByteCount	bmi NoOutBuf	; only one data byte	lda <SeqItem+2	; 2nd data byte	and #$00FF	jsr FillBufferx	bcs NoOutBuf1	; overflow!NoOutBuf	clc		; no errorsNoOutBuf1	ply	rts	EXPORT FillBufferx	IMPORT DevPollXmtGlueFillBufferx	php	sei		; disable IRQ's*	ldy <OutBufIndex*	cpy <OutStartIndex*	bne BuffIt1		; we're playing from buffer	ldy <OutBufIndexBuffIt1	shortm	sta [OutBuffer],y	longm	tya	inc A		; set-up for next store	and #BufLen-1	; circular buffer	cmp <OutStartIndex	beq WrapError	; we wrapped around !!!!!!!	sta <OutBufIndex	jsl DevPollXmtGlue	; call output routine	plp	clc		; no errors	rts	WrapError	plp	sec		; ERROR!	rts	ENDP			END	