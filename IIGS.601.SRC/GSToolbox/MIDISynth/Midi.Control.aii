	INCLUDE 'all.macros'	INCLUDE 'Note.Macros'	INCLUDE 'ns.equ'	PRINT PUSH	PRINT OFF	INCLUDE 'e16.memory' 	; memory manager equates	PRINT POP	IMPORT Mouse	IMPORT MouseTask	IMPORT iDrawCursor	IMPORT iUndrawCursor		IMPORT GetNextEvent	IMPORT EventAvail	IMPORT GetMouse	IMPORT Button	IMPORT StillDown	IMPORT WaitMouseUp	IMPORT PostEvent	IMPORT FlushEvents	IMPORT GetOSEvent	IMPORT OSEventAvail		IMPORT SetCursor	IMPORT UserInitCursor	IMPORT MIDIdp*********************************************************** SetMIDIPort       Tool Call #$13** Set the MIDI Port State** Inputs:	WORD	In port state (0=disable)*	WORD	Out port state (0=disable)** Outputs:	none**********************************************************SetMIDIPort		PROC EXPORT	IMPORT EnableMIDIIn	IMPORT EnableMIDIOut	IMPORT DisableMIDIIn	IMPORT DisableMIDIOut	IMPORT PortOn	;;  stack offsets;	DefineStacks_status	byte		; old status regs_bank	byte		; old data banks_dirpage   word 		; old direct pages_rtl1	block 3		; first rtl addresss_rtl2	block 3		; second rtl addresss_argstart	DSectSize		; start of argumentss_outport	word		; 0 = output disableds_inport	word		; 0 = input disabled*s_port	word		; Midi port (1 or 2) @@@@ NOT USEDs_argend	DSectSize		; end of argumentss_argsize	equ s_argend-s_argstart;  initialize direct page register	phd		; save old direct page	lda >myDP	tcd	phb		; save caller's data bank	phk	plb		; get our data bank	php		; save caller's IRQ bit	sei	lda >awake	bne @12		; Synth is started	ldx #errNotStarted	; Synth not started	jmp returnerr@12	lda PortOn	bne @1	ldx #noMIDIDriver	; Synth not started @@@@	jmp returnerr	; driver never started@1	lda s_inport,s	beq @2	jsr EnableMidiIn	bra @3@2	jsr DisableMIDIIn@3	lda s_outport,s	beq @4		jsr EnableMidiOut	bra @5@4	jsr DisableMIDIOut@5	ldx #0		; no errors*  return (with error if x is non-zero)	returnerr	plp		; restore interrupts	plb		; restore data bank	pld		; restore old direct page	PopArgs s_argsize	; move RTL addresses	txa		; restore error code	cmp #1		; set carry for error	rtl	ENDP***********************************************************  start interrupts that accomplish MIDI input**********************************************************EnableMIDIIn PROC EXPORT		EXPORT XSHIFTSTAY:EQUXSHIFTSTAY EQU $E01E84	EXPORT XSHIFTOUT:EQUXSHIFTOUT EQU $E01E8C	EXPORT Real_EM_FTP	EXPORT Real_QD_FTP	EXPORT MouseAdrs	EXPORT D_Cursor_Save	EXPORT UD_Cursor_Save	EXPORT EMCallTable		EXPORT QDCallTable	IMPORT DevRcvOnGlue		lda <InPortEnable	beq @1	rts		; already enabled	@1	php	sei	lda #$FFFF		; enable input	sta <InPortEnable	stz <PacketStatus 	; discard partial packet	lda #1	sta <PacketRemain 	; no data in partial packet	stz <QueuePtr	; no data in Queue	stz <QueueOut	; no data in Queue	stz <InBufStart	stz <InBufIndex	plp	;  Swap in our MIDI polled EVENT MANAGER		pha	pha	PushWord #$0D	;mouse	_GetVector	pla	sta >MouseAdrs	pla	sta >MouseAdrs+2	PushWord #$0D	PushPtr Mouse	;MIDI polled mouse	_SetVector	PushLong #00	; room for EM FTP	PushWord #00	; System tool set	PushWord #6		; EVENT MGR	_GetTSPtr*** added 10-Oct-91 DAL -- get the true size of the EM call table	phd	tsc	tcd	lda [3]	sta >EMCallTable	pld*** end 10-Oct-91			pla	sta >Real_EM_FTP	pla	sta >Real_EM_FTP+2	; save EM FTP for miStopInput		PushWord #00	; System tool set	PushWord #6		;EVENT MGR	PushLong #EMCallTable	_SetTSPtr; Swap in our "DrawCursor" and "UndrawCursor" into QuickDraw jump vectors	lda >$E01FCC	sta >D_Cursor_Save	lda >$E01FCE	sta >D_Cursor_Save+2		lda >JDC	sta >$E01FCC	lda >JDC+2	sta >$E01FCE	lda >$E01FD0	sta >UD_Cursor_Save	lda >$E01FD2	sta >UD_Cursor_Save+2		lda >JUDC	sta >$E01FD0	lda >JUDC+2	sta >$E01FD2	;  Swap in our QD FTP table	PushLong #00	; room for QD FTP	PushWord #00	; System tool set	PushWord #4		; QuickDraw	_GetTSPtr*** added 10-Oct-91 DAL -- get the true size of the QD call table	phd	tsc	tcd	lda [3]	sta >QDCallTable	pld*** end 10-Oct-91		pla	sta >Real_QD_FTP	pla	sta >Real_QD_FTP+2	; save QD FTP for miStopInput		PushWord #00	; System tool set	PushWord #4		; QuickDraw	PushLong #QDCallTable	_SetTSPtr;  set up MIDI input polling vector	shortm	lda #$A9		; LDA (with device driver direct page)	sta >MidiInputPoll	; set up MIDI input polling vector	longm	jsl DevRcvOnGlue 	; enable receiver interrupts	rtsJDC	jml >iDrawCursorJUDC	jml >iUndrawCursorReal_EM_FTP		DS.B 4Real_QD_FTP		DS.B 4MouseAdrs		DS.B 4D_Cursor_Save	DS.B 4UD_Cursor_Save	DS.B 4EMCallTable		DC.L (theEnd-EMCallTable)/4 ;num calls + 1		DC.L nullBootInit-1	;10-Oct-91 DAL	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L GetNextEvent-1	DC.L EventAvail-1	DC.L GetMouse-1	DC.L Button-1	DC.L StillDown-1	DC.L WaitMouseUp-1	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L PostEvent-1	DC.L FlushEvents-1	DC.L GetOSEvent-1	DC.L OSEventAvail-1	DC.L 0	DC.L 0	DC.L 0	DC.L 0	DC.L 0		DC.L 0	; Not used	DC.L 0	; Not used	DC.L 0	; Not used	DC.L 0	; Not used	dc.l 0,0,0,0 ;more fluff, 10-Oct-91 DAL	theEndQDCallTable		DC.L  (TheEndQ-QDCallTable)/4	;num calls + 1	dc.l nullBootInit-1	;added 10-Oct-91 DAL	DCB.L $8D-1,00	; minus 1	DC.L  SetCursor-1	DCB.L $3B,0	DC.L  UserInitCursor-1	DCB.L 24,0	dcb.l 10,0		;add some extra fluff (DAL)	TheEndQnullBootInit rtl		;added 10-Oct-91 DAL	ENDP**************************************************  stop interrupts that accomplish MIDI input*************************************************DisableMidiIn	PROC EXPORT		IMPORT Real_EM_FTP	IMPORT Real_QD_FTP	IMPORT MouseAdrs	IMPORT D_Cursor_Save	IMPORT UD_Cursor_Save	IMPORT EMCallTable		IMPORT QDCallTable	IMPORT RecvIntOff	IMPORT DevRcvOffGlue	lda <InPortEnable	bne @1	rts		; input not enabled!		@1	shortm	lda #$6B		; RTL	sta >MidiInputPoll	; deactivate MIDI input polling vector	longm	jsl DevRcvOffGlue	; disable receiver interrupts	stz <InPortEnable;  Restore system Event Mgr and QuickDraw	PushWord #00	; System tool set	PushWord #6		; EVENT MGR	PushLong Real_EM_FTP	; Restore EM PTR	_SetTSPtr		PushWord #$0D	PushLong MouseAdrs	;mouse	_SetVector	PushWord #00	; System tool set	PushWord #4		; QuickDraw	PushLong Real_QD_FTP	; Restore QD PTR	_SetTSPtr	lda D_Cursor_Save	sta >$E01FCC	lda D_Cursor_Save+2	sta >$E01FCE		lda UD_Cursor_Save	sta >$E01FD0	lda UD_Cursor_Save+2	sta >$E01FD2	rts	ENDP***********************************************************  start interrupts that accomplish MIDI output**********************************************************EnableMIDIOut		PROC EXPORT	IMPORT DevPollXmtGlue	lda <OutPortEnable	beq @1	rts		; output already enabled@1	lda #$FFFF		; enable output	sta <OutPortEnable	stz <OutBufIndex	stz <OutStartIndex	jsl DevPollXmtGlue	; call output routine	rts			ENDP**************************************************  stop interrupts that accomplish MIDI output*************************************************DisableMidiOut	PROC EXPORT		IMPORT DevXmtOffGlue	lda <OutPortEnable	bne @1		; output is enabled	rts	@1	jsl DevXmtOffGlue	stz <OutPortEnable	rts	ENDP******************************************************************	SetMIDIMode		Tool Call**	Inputs: MIDI Mode  0=Omni, 1=Poly, 2=Multi**	Output: none******************************************************************SetMIDIMode	PROC EXPORT;;  stack offsets;	DefineStacks_dirpage   word 	; old direct pages_databank	byte	; old data banks_rtl1	block 3	; first rtl addresss_rtl2	block 3	; second rtl addresss_argstart	DSectSize	; start of argumentss_mode	word 	; MIDI modes_argend	DSectSize	; end of argumentss_argsize	equ s_argend-s_argstart	phb		; save user data bank	phd		; save user direct page	lda >myDP	tcd		; set my DP	phk	plb		; set my DB	ldx #errNotStarted	lda >awake	beq exit 		; weren't started, report err.	ldx #RangeError	lda s_mode,s	cmp #3	bge exit		; mode > 2	lda s_mode,s	beq @2		; Omni mode	cmp #1	bne @2	lda #$FFFF		; Poly mode@2	sta <MMode		ldx #0exit	pld		; get old direct reg	plb		; get old data bank	PopArgs s_argsize	txa		; restore error code	cmp #1		; set carry on error	rtl	ENDP******************************************************************	SetMIDIChan		Tool Call**	Inputs: MIDI channel (0-15)**	Output: none******************************************************************SetMIDIChan	PROC EXPORT;;  stack offsets;	DefineStacks_dirpage   word 	; old direct pages_databank	byte	; old data banks_rtl1	block 3	; first rtl addresss_rtl2	block 3	; second rtl addresss_argstart	DSectSize	; start of argumentss_mchan	word 	; MIDI channels_argend	DSectSize	; end of argumentss_argsize	equ s_argend-s_argstart	phb		; save user data bank	phd		; save user direct page	lda >myDP	tcd		; set my DP	phk	plb		; set my DB	ldx #errNotStarted	lda >awake	beq exit 		; weren't started, report err.	ldx #RangeError	lda s_mchan,s	cmp #16	bge exit		; chan > 15	sta <BasicCh		ldx #0exit	pld		; get old direct reg	plb		; get old data bank	PopArgs s_argsize	txa		; restore error code	cmp #1		; set carry on error	rtl	ENDP******************************************************************	StartMIDIDriver	Tool Call #$27**	Inputs: WORD	Slot Number (0-7)*	        WORD	Internal/External (0/1)*	        WORD	user ID for memory manager*	        LONG	Pointer to MIDI Driver**	Output: none******************************************************************StartMIDIDriver	PROC EXPORT	IMPORT DevInitGlue	IMPORT SysExFlag;;  stack offsets;	DefineStacks_dirpage   word 	; old direct pages_databank	byte	; old data banks_rtl1	block 3	; first rtl addresss_rtl2	block 3	; second rtl addresss_argstart	DSectSize	; start of argumentss_addr	longs_id	words_ctype	word	; int/exts_slot	words_argend	DSectSize	; end of argumentss_argsize	equ s_argend-s_argstart		phb		; save user data bank	phd		; save user direct page	lda >MIDIdp	tcd		; set my DP	phk	plb		; set my DB	ldx #errNotStarted	lda >awake	beql exit 		; weren't started, report err.	ldx #DriverAlreadySet	lda PortOn	bnel exit 		; there's already a set driver	lda s_addr,s	sta <DriverAddr	lda s_addr+2,s	sta <DriverAddr+2;;  copy driver table onto direct page;	ldy #dt_size-2dtloop	lda [DriverAddr],y	; copy one word per loop	tyx	sta <dt_start,x	dey	dey	bpl dtloop;;  call the driver initialization code	lda s_slot,s	sta slotn	lda s_id,s	sta id	lda s_ctype,s	sta ctype	pha		; reserve space for old interrupt vector	pha	pea 0		; new interrupt vector	lda MIDIdp	clc	adc #MidiIntGlue	pha		; driver's IRQ vector (my DP)	PushWord slotn	; pass slot number	PushWord ctype	; pass int/ext setting	PushWord id		; pass  user ID	jsl DevInitGlue	; initialize device driver	bcc @15	txa	and #$00FF	ora #my_tool_number*256	; set device error msg	tax	pla	pla		; clean-up the stack	jmp exit		; we have an driver init error@15	tax	lda MIDIdp	 	; save old interrupt vector	tcd	pla	sta <OldIntVector	sta OrigIntVec	pla	shortm	sta <OldIntVector+2	sta OrigIntVec+2	longm;  copy driver table onto direct page (2nd time, driver will have modified it)	ldy #dt_size-2dtloop2	lda [DriverAddr],y		; copy one word per loop	tyx	sta dt_start,x	dey	dey	bpl dtloop2;  patch the driver interrupt handler in glue code	ldx <dt_pollrecv	; remember address of routine to	inx	ldy <dt_pollrecv+1	;	poll MIDI input	sty <DevPollAddr+1	stx <DevPollAddr	ldx <dt_inthandler	; adjust to true address	inx	ldy <dt_inthandler+1	sty <DriverHandler+1	; order of storage makes a difference!	stx <DriverHandler;;  set up MIDI input polling vector;	lda <dt_pollrecv	inc a	sta MidiInputPoll+4	lda <dt_pollrecv+2	sta MidiInputPoll+6	lda #$FFFF	sta PortOn		; flag as port enabled	stz SysExFlag	; normal input	ldx #0		; no errorsexit	pld		; get old direct reg	plb		; get old data bank	PopArgs s_argsize	txa		; restore error code	cmp #1		; set carry on error	rtlslotn	DC.W 0id	DC.W 0ctype	DC.W 0	EXPORT PortOnPortOn	DC.W 0		; 0 = Midi port disabled	EXPORT OrigIntVecOrigIntVec	DC.L 0	ENDP;-------------------------------------------------------;;  StopMIDIDriver		Tool Call #$28;;  Shutdown the MIDI Driver.;;  Inputs:	none;;  Outputs:	none;;  Registers:;	not preserved;;;-------------------------------------------------------	EXPORT StopMIDIDriverStopMIDIDriver	PROC	IMPORT PortOn	IMPORT SysExFlag	IMPORT DevShutGlue	IMPORT OrigIntVec	phb		; save user data bank	phd		; save user direct page	lda >myDP	tcd		; set my DP	phk	plb		; set my DB	ldx #errNotStarted	lda >awake	beq exit 		; weren't started, report err.	lda PortOn	beq exit 		; port never started	jsr DisableMidiIn	jsr DisableMidiOut	stz PortOn	PushLong OrigIntVec	jsl DevShutGlue	shortm	lda #$6B		; RTL	sta >MidiInputPoll	; deactivate MIDI input polling vector	longm	stz SysExFlag	; normal input	ldx #0		; no errorsexit	pld		; get old direct reg	plb		; get old data bank	txa		; restore error code	cmp #1		; set carry on error	rtl	ENDP	;;  call driver initialization routine ( -called with Driver DP- )DevInitGlue	PROC EXPORT	pei dt_init+1	phb	lda dt_init	sta 1,s	lda MIDIdp 		; point to driver's direct page	rtl	ENDP;;  call driver shutdown routine;DevShutGlue	PROC EXPORT	ldx #$300		; offset to driver's DP	lda dt_shutdown+1,x	pha	phb	lda dt_shutdown,x	sta 1,s	lda MIDIdp 		; point to driver's direct page	rtl	ENDP;;  call driver reset routine;DevResetGlue PROC EXPORT	ldx #$300		; offset to driver's DP	lda dt_reset+1,x	pha	phb	lda dt_reset,x	sta 1,s	lda MIDIdp 		; point to driver's direct page	rtl	ENDP;;  call driver receiver interrupt enable;DevRcvOnGlue PROC EXPORT	ldx #$300		; offset to driver's DP	lda dt_recvinton+1,x	pha	phb	lda dt_recvinton,x	sta 1,s	lda MIDIdp 		; point to driver's direct page	rtl	ENDP;;  call driver receiver interrupt disable;DevRcvOffGlue PROC EXPORT	ldx #$300		; offset to driver's DP	lda dt_recvintoff+1,x	pha	phb	lda dt_recvintoff,x	sta 1,s	lda MIDIdp 		; point to driver's direct page	rtl	ENDP;;  call driver transmitter polling routine;DevPollXmtGlue PROC EXPORT	ldx #$300		; offset to driver's DP	lda dt_pollxmit+1,x	pha	phb	lda dt_pollxmit,x	sta 1,s	lda MIDIdp 		; point to driver's direct page	rtl	ENDP;;  call driver transmitter interrupt enable;DevXmtOnGlue PROC EXPORT	ldx #$300		; offset to driver's DP	lda dt_xmitinton+1,x	pha	phb	lda dt_xmitinton,x	sta 1,s	lda MIDIdp 		; point to driver's direct page	rtl	ENDP;;  call driver transmitter interrupt disable;DevXmtOffGlue PROC EXPORT	ldx #$300		; offset to driver's DP	lda dt_xmitintoff+1,x	pha	phb	lda dt_xmitintoff,x	sta 1,s	lda MIDIdp	 	; point to driver's direct page	rtl	ENDP	END		END	