	Blanks off;-----------------------------------------------;;	Imported addresses;;-----------------------------------------------	IMPORT LogTbl	IMPORT ExpTbl	IMPORT Priority	IMPORT State	IMPORT Note	IMPORT Chan	IMPORT chVolTbl	IMPORT chSusTbl	IMPORT chPBTbl	IMPORT vcbTbl	IMPORT oscTbl	IMPORT GetPacket	; Midi.Buffer	IMPORT Set_Freq	IMPORT BeatTicks	IMPORT MarkOn	; NoteOff.aii	IMPORT MarkOff	IMPORT ClockSource;-----------------------------------------------;;	Forward addresses and entries;;-----------------------------------------------		INCLUDE 'Note.Macros'	INCLUDE 'all.macros'	INCLUDE 'NS.equ'******************************************************************	update**	Inputs: none**	Outputs: none******************************************************************	EXPORT update	update	PROC	IMPORT VoiceInit	IMPORT Allocate	IMPORT ChanQueue	IMPORT KeyQueue	IMPORT VolQueue	IMPORT CmdQueue	IMPORT TrackQueue	IMPORT VoiceRelease	IMPORT StartRelease	IMPORT NLadr	IMPORT PlaySeq	; Buffer.aii	IMPORT MarkOn	IMPORT MarkOff	IMPORT Vtrack	IMPORT ClockSource	EXPORT halt_gen	EXPORT UserMeter	EXPORT User_Stop	EXPORT User_Start	EXPORT User_Cont	EXPORT User_Pgm	EXPORT ClockMgr	EXPORT StartMgr	EXPORT StopMgr	EXPORT ContMgr* This task is installed as the interrupt handler for the update timer.* The update timer is actually Osc 31.	shortm	lda >busy_flag	beq not_runnin	rts		; dont re-enternot_runnin	lda #$FF	sta >busy_flag	; flag as busy	longmx* Get my DP area and my workarea pointers	phb		; save user data bank	phd		; save user direct page	lda >myDP	tcd		; set my DP	phk	plb* Dump any MIDI messages into the queue	jsr GetPacket* Dump any Seq items into Queue	jsr PlaySeq * Check the Queue for any pending messages	ldx <QueueOutQueueLp0	cpx <QueuePtr	bne chk_the_Q	jmp do_update	; Queue is emptychk_the_Q	lda CmdQueue,x	cmp #Midi_Note_On	beq do_NoteOn	cmp #Midi_Note_Off	beql do_NoteOff	cmp #Pitch_Bend	beql do_PB	cmp #MIDIStart	beql do_Start	cmp #MIDIStop	beql do_Stop	cmp #MIDITiming	beql do_Timing	cmp #MIDICont	beql do_Cont	cmp #Pgm_Change	beql do_PChg	cmp #Ctrl_Change	bne QueueLp1	lda KeyQueue,x	; control type	cmp #Midi_Volume	beq do_Volume	cmp #Sus_Switch	beq do_Sus_SwQueueLp1	lda <QueueOut	inc A	inc A	and #QueueSize-1	sta <QueueOut	; QueueOut points to next item	tax	bra QueueLp0do_Sus_Sw	lda ChanQueue,x	asl A	tay	lda VolQueue,x	; 0 = up, $7F = down	sta chSusTbl,y	bra QueueLp1	do_Volume	lda ChanQueue,x	asl A	pha	lda VolQueue,x	asl A		; full range (0-FF)	asl A		; table is in word size	tay	lda LogTbl,y	; get Log of channel volume	ply	sta chVolTbl,y	bra QueueLp1do_NoteOn		lda ChanQueue,x	sta <Vchan	lda KeyQueue,x	sta <Vkey	lda TrackQueue,x	sta Vtrack		; used in MarkOn	lda VolQueue,x	beq dn1		; vel = 0, note off	sta <Vvol	jsr VoiceInit	jsr MarkOn		; Mark note list	jsl >MidiInputPoll	bra QueueLp1do_NoteOff	lda ChanQueue,x	sta <Vchan	lda KeyQueue,x	sta <Vkeydn1	jsr VoiceRelease	jsr MarkOff		; Mark note list	jsl >MidiInputPoll	bra QueueLp1do_PB	lda ChanQueue,x	asl A	tay	lda VolQueue,x	; 0-7F ( 40 = zero)	and #$007E	sec	sbc #$40		; make it a signed number	sta chPBTbl,y	bra QueueLp1do_Start	jsr StartMgr	jmp QueueLp1do_Cont	jsr ContMgr	jmp QueueLp1do_Stop	jsr StopMgr	jmp QueueLp1do_Timing	jsr ClockMgr	jmp QueueLp1do_PChgUser_Pgm	jsl noUserMeter	; *** gets modified	jmp QueueLp1StopMgr	lda <SeqFlags	and #$FFFF-(F_Record+F_Play)	sta <SeqFlagsUser_Stop	jsl noUserMeter	; *** gets modified	rtsStartMgr	lda #1	sta FAflag		; ignore next F8User_Start	jsl noUserMeter	; *** gets modified	rtsContMgr	lda #1	sta FAflag		; ignore next F8User_Cont	jsl noUserMeter	; *** gets modified	rtsClockMgr	lda FAflag	beq @1		; not after a "start" command	stz FAflag		; reset it	bra @3@1	lda ClockSource	beq @3		; Use internal clock	lda #$0400		; 24 ticks/quarter, quarter=96 ticks (xx.xx)	jsr UpdateTimer@3	rtsdo_update	ldy #00Oloop	lda Priority,y	bne ItsActive	; see if we must update itChk_Next	iny	iny	cpy #no_of_Gen*2	bne Oloop		; check next	lda ClockSource	bne noTimer		; Use MIDI clock* Check timers for update	lda <Tempo		; update with this value	jsr UpdateTimernoTimer	inc <FreeRun	shortm	lda #00	sta >busy_flag	; reset running flag	longm	pld	plb	rts		; this will finally RTIItsActive	bmi Chk_Next	; protected, skip it	sty <theGen		; save for next	ldx vcbTbl,y	lda oscTbl,y	sta <theOsc	ldy <vcbCh,x	lda chVolTbl,y	sta <chVol		; set up channel volume	lda chSusTbl,y	sta <chSus		; set up channel sustain switch state	jsr compute_envelope	cmp #min_vol*256	bge notdone		; env not at min yet* if done, do this:	jsr halt_gen	; kill the osc's* free the gen	ldy <theGen	lda #0000	sta Priority,y	jmp Chk_Next	; and continue with nextnotdone	ldy <theGen	jmp Chk_Next	; and continue with next**********************************  Halt the Oscillators********************************** must not trash x.	EXPORT halt_genhalt_gen	shortm	lda >SysVol	ora #GPtrInc	; auto inc	sta >GStatReg	lda <theOsc	clc	adc #doc_vol	; zap the volume	sta >GAdrL 	lda #00	sta >GDataReg	sta >GDataReg	sta >GDataReg	sta >GDataReg	lda <theOsc	clc 	adc #doc_size	sta >GAdrl	lda #0		; force to 256 bytes	sta >GDataReg	sta >GDataReg	sta >GDataReg	sta >GDataReg	lda <theOsc	clc 	adc #doc_freqhi	sta >GAdrl	lda #$FF	sta >GDataReg	sta >GDataReg	sta >GDataReg	sta >GDataReg	lda <theOsc	clc 	adc #doc_ctrl	sta >GAdrl	lda #$02		; one-shot to reset adr pointer	sta >GDataReg	sta >GDataReg	sta >GDataReg	sta >GDataReg	longm	phx	phy	jsl >MidiInputPoll	ply	plx	rts********************** Update Timers*********************	EXPORT FAflagUpdateTimer	sta ClockTicks	; save for update	lda <SeqFlags	bit #F_Record+F_Play	beq noTUpd		; we're not recording or playing seq	lda <Seq_Status	bmi noTUpd		; we're in 'key wait' so freeze clocks* First, check the meter timer	lda <Meter+1	bmi @1		; underflow	bne IncClock	; not yet	lda <Meter		; check fractional part	bne IncClock	; almost, but not yet	lda <Meter+1	@1	clc	adc BeatTicks	; number of ticks per beat	sta <Meter+1UserMeter	jsl noUserMeter	; SELF MODIFYING	lda <SeqFlags	bit #F_Metro	beq chkSS		; Metro is OFF	jsr Click		; play metronome oncechkSS	lda <Seq_Status	and #SS_CountOff	beq IncClock1	; we're not in 'count off'		  dec <CountDown	  bpl MeterClock	    lda <Seq_Status	    and #$FFFF-SS_CountOff	    sta <Seq_Status	; clear the 'count off' flag	    stz <Meter	; clear fraction	    lda BeatTicks	; number of ticks per beat	    sta <Meter+1	    bra noTUpd	; we'll start the clocks next time	* Increment the Seq timerIncClock	lda <Seq_Status	and #SS_CountOff	bne MeterClock	; we're in 'count off'IncClock1	lda ClockTicks	; add Tempo to Timer	clc	adc <Timer_Frac	; fraction and low integer byte	sta <Timer_Frac	bcc MeterClock	inc <Timer+1	; hi integerMeterClock	lda <Meter	sec	sbc ClockTicks	sta <Meter	bcs noTUpd	dec <Meter+2noTUpd	rtsnoUserMeter	rtlClockTicks	DC.W 0FAflag	DC.W 0		; MIDI "START" cmd**************************** click the metronome***************************Click	shortm	lda >SysVol	sta >GStatReg	; no inc, to doc	lda #doc_freqlo+Metro_Osc	; set frequency of the	sta >GAdrL			; Metro osc	lda <MetroFreq	sta >GDataReg	lda #doc_freqhi+Metro_Osc	sta >GAdrL	lda <MetroFreq+1	sta >GDataReg	lda #doc_vol+Metro_Osc	sta >GAdrL	lda <MetroVol	; Metro volume	sta >GDataReg	lda #doc_ctrl+Metro_Osc	sta >GAdrL	lda #doc_oneshot	; one-shot for 'tick'	sta >GDataReg	longm	rts	******************************************************************	Compute_Envelope**	Inputs: x has vcb offset ; memory and index are long**	Outputs: both long; writes to doc, z set if envelope=0 (done)******************************************************************Compute_Envelope	phx	phy	jsl >MidiInputPoll	ply	plx	lda <sus_flag,x	beq @10		; must be in release stage (ignore sus switch)	lda <ChSus	bne @10		; sustain switch is pressed	lda <sus_hold,x	beq @10		; switch is up, but note still down	jsr StartRelease@10	lda <env_inc,x	bne @1	lda <env_cur,x	; in sustain	bra cont1@1	bmi going_down* going up:	clc	adc <env_cur,x	bvs hit_it		; > $FFFF	cmp <env_lim,x	bcs hit_it		; past breakpoint	bra contingoing_down	clc	adc <env_cur,x	bmi hit_it		; < $0000	cmp <env_lim,x	bmi hit_it		; below breakpointcontin	sta <env_cur,x* Now we have the envelope in the high byte of acc.* "Multiply" it by the Log volumes and put them out to the DOC.cont1	xba		; get hi byte	asl A	and #$00FF	asl A	tay	lda <chVol		; 0-127	clc	adc LogTbl,y	and #$FFFE	tay	lda ExpTbl,y	asl A	tay	sta <Temp	lda <volB,x		; 0-127	clc	adc LogTbl,y	and #$FFFE	tay	lda ExpTbl,y	sta <FvolB	ldy <Temp	lda <volA,x		; 0-127	clc	adc LogTbl,y	and #$FFFE	tay	lda ExpTbl,y	sta <FvolA	bra calc_env_2****************************************************************hit_it	lda <env_lim,x	; start by locking the level	sta <env_cur,x	; to the breakpoint we just hit.	bne @1* stop envelope since level = 0	jmp contin		; now continue with doc output.@1	lda <I_Ptr,x	sta <Inst_Ptr	ldy <next_seg,x	cpy #_sustain	blt do_decay	lda (inst_ptr),y	; points to the breakpoint	xba	and #$7F00		;which was a byte, now a word	cmp <env_lim,x	bge going_up*going down	sta <env_lim,x	iny	lda (inst_ptr),y	;get increment word	eor #$FFFF		; negate it	inc a	bra its_coolgoing_up	sta <env_lim,x	iny	lda (inst_ptr),yits_cool	sta <env_inc,x	iny		; advance cur seg to next one	iny	sty <next_seg,x	lda <env_cur,x	jmp contin		; now continue with doc output.do_decay	lda (inst_ptr),y	; points to the breakpoint	xba	and #$7F00		;which was a byte, now a word	cmp <env_lim,x	bge going_upD*going downD	sta <env_lim,x	iny	lda <addDky1,x	clc	adc (inst_ptr),y	bpl @1	lda #$7FFF@1	eor #$FFFF		; negate it	inc a	bra its_coolgoing_upD	sta <env_lim,x	iny	lda <addDky1,x	clc	adc (inst_ptr),y	bpl @1	lda #$7FFF@1	bra its_cool****************************************************************** calc env 2calc_env_2	lda <env_inc2,x	bne @1	lda <env_cur2,x	; sustain stage	bra cont2@1	bmi going_down2* going up:	clc	adc <env_cur2,x	bvs hit_it2		; > $FFFF	cmp <env_lim2,x	bcs hit_it2		; past breakpoint	bra contin2going_down2	clc	adc <env_cur2,x	bmi hit_it2		; < $0000	cmp <env_lim2,x	bmi hit_it2		; below breakpointcontin2	sta <env_cur2,x* Now we have the envelope in the high byte of acc.* "Multiply" it by the Log volumes and put them out to the DOC.cont2	xba		; get hi byte	asl A	and #$00FF	asl A	tay	lda <chVol		; 0-127	clc	adc LogTbl,y	and #$FFFE	tay	lda ExpTbl,y	asl A	tay	sta <Temp	lda <vol2B,x		; 0-127	clc	adc LogTbl,y	and #$FFFE	tay	lda ExpTbl,y	sta <Fvol2B	ldy <Temp	lda <vol2A,x		; 0-127	clc	adc LogTbl,y	and #$FFFE	tay	lda ExpTbl,y	sta <Fvol2A	bra set_vol****************************************************************hit_it2	lda <env_lim2,x	; start by locking the level	sta <env_cur2,x	; to the breakpoint we just hit.	bne @1		; stop envelope since level = 0	jmp contin2		; now continue with doc output.@1	lda <I_Ptr,x	clc	adc #defLen	sta <Inst_Ptr	ldy <next_seg2,x	cpy #_sustain	blt do_decay2	lda (inst_ptr),y	; points to the breakpoint	xba	and #$7F00		;which was a byte, now a word	cmp <env_lim2,x	bge going_up2*going down	sta <env_lim2,x	iny	lda (inst_ptr),y	;get increment word	bmi its_cool2	eor #$FFFF		; negate it if it isn't negative	inc a	bra its_cool2going_up2	sta <env_lim2,x	iny	lda (inst_ptr),y	bpl its_cool2	; negate it if it isn't positive	dec a	eor #$FFFFits_cool2	sta <env_inc2,x	iny		; advance cur seg to next one	iny	sty <next_seg2,x	lda <env_cur2,x	jmp contin2		; now continue with doc output.do_decay2	lda (inst_ptr),y	; points to the breakpoint	xba	and #$7F00		;which was a byte, now a word	cmp <env_lim2,x	bge going_upD2*going downD2	sta <env_lim2,x	iny	lda <addDky2,x	clc	adc (inst_ptr),y	bpl @1	lda #$7FFF@1	eor #$FFFF		; negate it	inc a	bra its_cool2going_upD2	sta <env_lim2,x	iny	lda <addDky2,x	clc	adc (inst_ptr),y	bpl @1	lda #$7FFF@1	bra its_cool2*****************************************************************set_vol	shortm				lda <theOsc	clc	adc #doc_vol	sta >GAdrL	lda >SysVol	ora #GPtrInc	sta >GStatReg		 	lda <FvolA	sta >GDataReg	; set vol A	lda <FvolB	sta >GDataReg	; set vol B	lda <Fvol2A	sta >GDataReg	; set vol A	lda <Fvol2B	sta >GDataReg	; set vol B	longmsustain	lda <PBflag,x	beq @2		; no pitch bend - skip freq update	jsr Set_Freq@2	lda <env_cur,x	cmp <env_cur2,x	bge @1	lda <env_cur2,x@1	rts		ENDP		END		