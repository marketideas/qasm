	Blanks Off;-----------------------------------------------;;	Imported addresses;;-----------------------------------------------	print off	INCLUDE 'Note.Macros'	INCLUDE 'all.macros'	INCLUDE 'ns.equ'	print on, nogen, nomdir, nohdr	IMPORT Priority	IMPORT State	IMPORT Note	IMPORT Chan	IMPORT halt_gen	IMPORT vcbTbl	IMPORT oscTbl	IMPORT NLadr	IMPORT chSusTbl	IMPORT ChanQueue	IMPORT KeyQueue	IMPORT VolQueue	IMPORT CmdQueue******************************************************************	NoteOff	Tool Call**	Inputs: GenNum, Semitone**	Output: none**	This routine is reentrant: do not use scratch RAM*****************************************************************		EXPORT	NoteOff	NoteOff	PROC	longi on	longa on	EXPORT VoiceRelease	EXPORT StartRelease;;  stack offsets;	DefineStacks_status	byte	; caller's status regs_dirpage   word 	; old direct pages_databank	byte	; old data banks_rtl1	block 3	; first rtl addresss_rtl2	block 3	; second rtl addresss_argstart	DSectSize	; start of argumentss_key	word 	; Key number (0-127)s_channel	word 	; Channel number (0-15)s_argend	DSectSize	; end of argumentss_argsize	equ s_argend-s_argstart	phb		; save caller's data bank	phd		; save caller's direct page	lda >myDP	tcd		; set my DP	phk	plb		; set my DB	php		; save caller's IRQ bit	sei		; hold MIDI from using queue		ldx #errNotStarted	lda >awake	beq exit 		; weren't started, report err.	ldy <QueuePtr	lda #Midi_Note_Off	sta CmdQueue,y	ldx #RangeError	lda s_channel,s	cmp #16	bge exit		; chan > 15	sta ChanQueue,y	lda s_key,s	cmp #128	bge exit		; note # > 127	sta KeyQueue,y	iny	iny	tya	and #QueueSize-1	sta <QueuePtr	; Queue points to next open slot	ldx #0	; no errors* restore the registers, fix the stackexit	plp	pld	; get old direct reg	plb	; get old data bank	PopArgs s_argsize	txa							; get the error code.	cmp #1	; set the carry bit.	rtl********************************************* Force a voice into the release stage** Inputs: Vchan, Vkey*         NoteList should have this key*	marked as used, unless it was*	stolen by Allocate.********************************************VoiceRelease* get the gennum from the note list	phx	phy	jsl >MidiInputPoll	ply	plx	ldy #00CkState	lda Priority,y	bne ItsActiveChk_Next	iny	iny	cpy #no_of_Gen*2	bne CkState		; check next	rts		; voice must have timed outItsActive	lda Note,y	cmp <Vkey	bne Chk_Next	; wrong note	lda Chan,y	cmp <Vchan	bne Chk_Next	; wrong channel	lda State,y	cmp #Release	bge Chk_Next	; already been released	ldx vcbTbl,y	; x = vcb* check if sustain switch is down	ldy <vcbCh,x	lda chSusTbl,y	beq StartRelease	; sustain switch is up	lda <sus_hold,x	beq @1	ldy <genNum,x	bra Chk_Next	; already waiting to be released@1	lda #$FFFF	sta <sus_hold,x	; flag we have a release waiting	rts* If we get here, then we have the gen in question. We now have* to send it into its release stage, which involves the envelope;* and jimmy the priority, to make it more stealable.StartRelease	lda #_rel_seg	; set envelope stage to release	sta <next_seg,x	sta <next_seg2,x	lda <env_cur,x	; this will cause the env	sta <env_lim,x	; to go to the next stage	lda #1	sta <env_inc,x	lda <env_cur2,x	; this will cause the env	sta <env_lim2,x	; to go to the next stage	lda #1	sta <env_inc2,x* Now we have to decrease the priority by half.	ldy <genNum,x	lda Priority,y	; get priority	lsr a	adc #1		; to prevent a zero priority	sta Priority,y	; and stick it in the table* Set voice state to Release	lda #Release	; release state	sta State,y	stz <sus_flag,x	; ignore sustain switch from now on*			  since envelope is in Release	rts		ENDP	******************************************************************	AllNotesOff : Tool Call**	Inputs: none**	Outputs: none*****************************************************************	EXPORT AllNotesOff AllNotesOff PROC	EXPORT AllOff	EXPORT ClearNtbl	EXPORT MarkOn	EXPORT MarkOff	EXPORT Vtrack	EXPORT KillTrack	IMPORT FillBuffer1	lda >awake	bne @1	ldx #errNotStarted	; we weren't started.	jmp error		; return error and exit.* Get my DP area and my workarea pointers@1	longm	phb		; save user data bank	phd		; save user direct page	lda >myDP	tcd		; set my DP	phk	plb		; my data bank	php	sei* Stack is up 4. memory is long. D and b are set.	jsr AllOff	ldx #00	plp	pld	plberror	txa							; get error code.	cmp #1		; set the carry flag.	rtlAllOff* Release all sustain switches	ldy #14	lda #0AllOff3	sta chSusTbl,y	dey	dey	bpl AllOff3	ldy #00AllOff1	lda Priority,y	bne CkRel		; voice is activeAllOff2	iny	iny	cpy #no_of_Gen*2	bne AllOff1		; check next	jsr KillMIDI	; turn all active MIDI notes off	jsr SendAllOff	rtsCkRel	lda State,y	cmp #Release	bge AllOff2		; already been released* Force voice into release	ldx <QueuePtr	lda #Midi_Note_Off	sta CmdQueue,x	lda Chan,y	sta ChanQueue,x	lda Note,y	sta KeyQueue,x	inx	inx	txa	and #QueueSize-1	sta <QueuePtr	; Queue points to next open slot	bra AllOff2* Send "All Notes Off thru MIDISendAllOff	lda #$000F	sta Mchn@1	lda Mchn	ora #$B0	sta <SeqItem	lda #123		; all notes off	sta <SeqItem+1	lda #0	sta <SeqItem+2	lda #2	sta <DataBytes	sta <ByteCount	jsr FillBuffer1@2	lda Mchn	ora #$B0	sta <SeqItem	lda #64		; sustain switch	sta <SeqItem+1	lda #0		; OFF	sta <SeqItem+2	lda #2	sta <DataBytes	sta <ByteCount	jsr FillBuffer1	lda Mchn	ora #$E0		; pitch bend	sta <SeqItem	lda #0	sta <SeqItem+1	lda #64		; center position	sta <SeqItem+2	lda #2	sta <DataBytes	sta <ByteCount	jsr FillBuffer1	lda Mchn	jsr ClearCh		; clear note list	dec Mchn	bpl @1	rtsMchn	DC.W 15ysav	DC.W 0* Clear all notes in note listClearNtbl	lda #$F	sta Mchn@1	lda Mchn	jsr ClearCh	dec Mchn	bpl @1	rts* clear all notes in list for channel* on entry: a = channel numberClearCh	asl A		; table in words	tay	lda Mult128,y	clc	adc <NoteList	sta <NoteTracker	ldy #126	lda #$FFFF		; mark as unused@1	sta [NoteTracker],y	dey	dey	bpl @1	rtsKillMIDI	lda #$F	sta Mchn@1	lda Mchn	asl A		; table in words	tay	lda Mult128,y	clc	adc <NoteList	sta <NoteTracker	shortm	ldy #127@2	lda [NoteTracker],y	bmi @3		; note not on	jsr KillNote	lda #$FF		; mark as off	sta [NoteTracker],y@3	dey	bpl @2		; check all 128 MIDI notes	longm	dec Mchn		; check all 16 MIDI channels	bpl @1	rtsKillNote	longm	sty ysav	lda Mchn	ora #$80		; note off	sta <SeqItem	lda ysav		; note number	sta <SeqItem+1	lda #0	sta <SeqItem+2	lda #2	sta <DataBytes	sta <ByteCount	jsr FillBuffer1	ldy ysav	shortm	rtsMarkOn	lda <Vchan	asl A		; table in words	tay	lda Mult128,y	clc	adc <NoteList	sta <NoteTracker	shortm	ldy <Vkey	lda Vtrack		; mark with track number	sta [NoteTracker],y	longm	rtsVtrack	DC.W 0MarkOff	lda <Vchan	asl A		; table in words	tay	lda Mult128,y	clc	adc <NoteList	sta <NoteTracker	shortm	ldy <Vkey	lda #$FF		; mark as off	sta [NoteTracker],y	longm	rts******************************************** Turn OFF all notes for a specified track* Notes for both MIDI and Synth will be*   affected.**   INPUT:	a = Track number (0-15)*******************************************KillTrack	sta TargetTrack	lda #$F		; check all 16 MIDI channels	sta Mchn@1	lda Mchn	asl A		; table in words	tay	lda Mult128,y	clc	adc <NoteList	sta <NoteTracker	shortm	ldy #127@2	lda [NoteTracker],y	bmi @3		; note not on	cmp TargetTrack	bne @3		; not the specified track number	phy		; save key index	jsr KillNote	; MIDI note OFF@4	longm	jsr ForceRel	; Synth note to Release	shortm	ply	lda #$FF		; mark as off	sta [NoteTracker],y@3	dey	bpl @2		; check all 128 MIDI notes	longm	dec Mchn		; check all 16 MIDI channels	bpl @1	rtsTargetTrack	DC.W 0**************************************  Force note into Release if active**   INPUT:	y = note number*	mchn = channel number*************************************ForceRel	sty KeySav		; save note number for later	ldy #00FR1	lda Priority,y	bne CkFR		; voice is activeFR2	iny	iny	cpy #no_of_Gen*2	bne FR1		; check next voice	rts		; all 7 voices checkedCkFR	lda Note,y	cmp KeySav	bne FR2		; check next voice	lda Chan,y	cmp mchn	bne FR2		; check next voice*	lda State,y*	cmp #Release*	bge FR2		; already been released* First, force sustain to OFF for mchn channel.* This could cause some problems since I'm turning off sustain* for all notes using this channel, not just for one track!* I have no way of knowing if sustain ON was generated on this* track. Otherwise the note will hang.	lda mchn	asl A		; table in WORDs	tax	lda #00	sta chSusTbl,x* Force voice into release	ldx <QueuePtr	lda #Midi_Note_Off	sta CmdQueue,x	lda Chan,y	sta ChanQueue,x	lda Note,y	sta KeyQueue,x	inx	inx	txa	and #QueueSize-1	sta <QueuePtr	; Queue points to next open slot	rtsKeySav	DC.W 0Mult128	DC.W $000,$080,$100,$180,$200,$280,$300,$380	DC.W $400,$480,$500,$580,$600,$680,$700,$780		ENDP		END