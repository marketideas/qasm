************************  Instrument Record  ************************* Envelope RecordVatk	equ 0	; attack level     (0-127)Atk	equ 1	; attack rate      (0-31)Vd1	equ 2	; decay #1 level   (0-127) Dk1	equ 3	; decay #1 rate    (0-31)Vd2	equ 4	; decay #2 level   (0-127) Dk2	equ 5	; decay #2 rate    (0-31)Sus	equ 6	; sustain level    (0-127)Dk3	equ 7	; rate to sustain  (0-31)Vr1	equ 8	; release level #1 (0-127)Rel1	equ 9	; release rate #1  (0-31)Vr2	equ 10	; release level #2 (0-127)Rel2	equ 11	; release rate #2  (0-31)Rel3	equ 12	; release rate #3  (0-31)DecayKbd	equ 13	; key decay gain   (0-9)Vsens	equ 14	; Velocity sensitivity (0-10)PBend	equ 15	; Pitch Bend (0-11)* Oscillator RecordTopKey	equ 16	; Midi note (0-127)Alg	equ 17	; Osc config (0-5);		      Osc A    Osc B;		  0 = loop     loop;		  1 = 1-shot   loop;		  2 = 1-shot   1-shot;		  3 = swap     loop (halted);		  4 = swap     1-shot (halted);		  5 = swap     swap (halted)Channel	equ 18	; output channel (0-7)Detune	equ 19	; Detune (0 - 63)AddrA	equ 20	; Addr in DOC ram ($00 - $FF)SizeA	equ 21	; waveform size (0-7);		  0 = 256;		  1 = 512;		  2 = 1k;		  3 = 2K;		  4 = 4K;		  5 = 8K;		  6 = 16k;		  7 = 32kiVolA	equ 22	; volume of osc (0-127)OctA	equ 23	; Oct tuning (0-6)SemiA	equ 24	; semitone tuning (0-11)FineA	equ 25	; Fine tuning (0-63)AddrB	equ 26	; Addr in DOC ram ($00 - $FF)SizeB	equ 27	; waveform size (0-5)iVolB	equ 28	; volume of osc (0-127)OctB	equ 29	; Oct tuning (0-6)SemiB	equ 30	; semitone tuning (0-11)FineB	equ 31	; Fine tuning (0-63)EnvRecSize	equ 16	; env segmentsOscRecSize	equ 16	; DOC parametersInstRecSize	equ 144	; 1 env record + 8 osc records, 16 + (8 * 16) = 144InstSize	equ 288	; 2 instrument records***************************** Oscillator Control Block *****************************_envelope	equ 0	; 8 volume-stepsize segments_dk1	equ 4_dk2	equ 7_dk3	equ 10_susVol	equ 9_sustain	equ 12_rel_seg	equ 15_vs	equ 24	; velocity gain div address (24-25)_pbend	equ 26	; pitch bend mul address (26-27)_pbflag	equ 28	; 0 = no pitch bend (28-29)_decaykbd	equ 30	; address of DecayNote table* Wave List_topkey	equ 32_addrA	equ 33_sizeA	equ 34_ctrlA	equ 35_pitchA	equ 36_volA	equ 38_detune	equ 39_wlSize	equ 64	; wavelist size 8 * 8 = 64_addrB	equ 33+_wlSize_sizeB	equ 34+_wlSize_ctrlB	equ 35+_wlSize_pitchB	equ 36+_wlSize_volB	equ 38+_wlSize_AWavelist	equ 32	; after env segments_BWaveList	equ 96	; _AWavelist _wlSize, 32 + 64 = 96* Offsets from WaveListwp_topkey	equ 0wp_addr	equ 1wp_size	equ 2wp_ctrl	equ 3wp_pitch	equ 4Wvol	equ 6wp_detune	equ 7OCBsize	equ 160	; env segments + 8 A wavelists + 8 B wavelists, 32 + (8 * 8) + (8 * 8) = 160 * my 12 bytes of reserved ram in bank E1.** It will be set up like this:cubbyhole 	equ $E11DC4		; 12 bytes of my own, foreverawake	equ cubbyhole	; set when Note syn has been initialized.myDP	equ cubbyhole+2	; NoteSynth Direct Pagebusy_Flag 	equ cubbyhole+4	; set when update is running.old_vector	equ cubbyhole+5	; previous IRQ vector stored as 3 bytesuserjump	equ cubbyhole+8	; put jml hereuserUpdate	equ cubbyhole+9	; address of user's routineMy_ID		equ 4	; MIDI Synth IDMy_tool_number 	equ 35version_number	equ $0100	;was $8100 5-Feb-92 DAL;;;NSID		equ $4023	; ID to use for New Handle call.NSID		equ $4523	;ID to use for NewHandle calls (10-Oct-91 DAL)* Tool Call Error CodeserrStarted 		equ my_tool_number*256+$1	; already startederrNotStarted 	equ my_tool_number*256+$2 	; function called before startupNoDPError 		equ my_tool_number*256+$3	; can't get DP memoryNoMemError 		equ my_tool_number*256+$4	; can't get memory blockMiscToolError 	equ my_tool_number*256+$5	; Misc Tools not startedSoundError 		equ my_tool_number*256+$6	; Sound Tool Set not startedGenError 		equ my_tool_number*256+$7	; Generator in useIllegalPort		equ my_tool_number*256+$8	; Invalid MIDI portSlotBusy		equ my_tool_number*256+$9	; Serial port is busyRangeError		equ my_tool_number*256+$A	; Parameter is out of rangeMQFull		equ my_tool_number*256+$B	; MIDI Message Q is fullRecBufFull		equ my_tool_number*256+$C	; Rec Buffer is fullMIDIoutOff		equ my_tool_number*256+$D	; MIDI out not enabledMessageError	equ my_tool_number*256+$E	; SysEx format errorMIDIBufFull		equ my_tool_number*256+$F	; MIDI out buffer fullnoMIDIDriver	equ my_tool_number*256+$10	; MIDI driver never setDriverAlreadySet	equ my_tool_number*256+$11	; MIDI driver is already set;  device driver errorsmiDevNotAvail	equ my_tool_number*256+$80	; device not availablemiDevSlotBusy	equ my_tool_number*256+$81	; given slot is already in usemiDevBusy		equ my_tool_number*256+$82	; device is already in usemiDevNoConnect	equ my_tool_number*256+$84	; no connection to MIDImiDevVersion	equ my_tool_number*256+$86	; ROM version or machine type is					;   incompatible with the drivermiDevIntHndlr	miIRQError		equ my_tool_number*256+$87	; conflicting interrupt handler has					;   been installed;;  driver error codes $88-$BF reserved for future use;  driver error codes $C0-$FF may be defined by drivers* Equates for Sound Glu and DOCGStatReg	equ $E1C03C	; sound glu control/status registerGDataReg	equ $E1C03D	; dataGAdrL	equ $E1C03E	; address lowGAdrH	equ $E1C03F	; address high* Glu status register bitsGvol	equ $0F	; bits 0-3GptrInc	equ $20GptrNoInc	equ $20	; (reset bit 5)GRAMsel	equ $40GRegSel	equ $40	; (reset 6 to talk to DOC)GBusy	equ $80* DOC registersdoc_freqlo	equ 0doc_freqhi	equ $20doc_vol	equ $40doc_addr	equ $80doc_ctrl	equ $A0doc_size	equ $C0doc_IRQ	equ $E0* DOC control register bitsdoc_irq_bit		equ $08doc_halt_bit	equ $01doc_halt_reset 	equ $03	; single cycle mode resets accumdoc_oneshot		equ $02* other goodiesmin_vol		equ $18	; min osc volumeTimer_Osc		equ $1FMetro_Osc		equ $1E	; DOC osc for metronomeno_of_Gen		equ 7defLen		equ 160	; len of inst def (1/2)DPforNS		equ $400	; 8 vcb's and one page for misc (8*64)+256*			  1 page for MIDI DriverBufLen		equ 1024	; Input buffer length (MUST be a multiple power of 2)MidiInputPoll	equ $E101B2	;SysVol		equ $E100CA	; 4 bit volume for everyoneSltRomSel		equ $E1C02D* MIDI MessagesMidi_Note_On	equ $90Midi_Note_Off	equ $80Ctrl_Change		equ $B0Pgm_Change		equ $C0Pitch_Bend		equ $E0MIDIStart		equ $FAMIDIStop		equ $FCMIDICont		equ $FBMIDITiming		equ $F8SysEx		equ $F0EOX		equ $F7Midi_Volume		equ $07Sus_Switch		equ $40QueueSize		equ 128	; must be multiple power of 2!ItemSize		equ 8	; number of bytes in seq itemMetroDefaultFreq	equ $0180MetroDefaultVol	equ $FF* Call Back Table offsetsusend	equ 0	; user seq end addressmupdate	equ 4 	; Meter Update routine addressMstart	equ 8	; MIDI start commandMstop	equ 12	; MIDI stop commandMPin	equ 16	; MIDI packet inSevent	equ 20	; seq item playsx	equ 24	; sys ex inMPout	equ 28	; MIDI packet outPchg	equ 32	; MIDI Pgm ChangeMCont	equ 36	; MIDI continue commandSmark	equ 40	; Seq MarkerRBfull	equ 44	; Rec Buffer Full* Zero Page Addr* MidiInPortEnable	equ $00 	; $0000 = input disabledPacketStatus	equ $02 	; MIDI status byte of current packetPacketLength	equ $04 	; length of current packetPacketRemain	equ $06 	; remaining length of current packetInBufStart		equ $08InBufIndex		equ $0AMpacket		equ $0C	; C,D,E,F,10,11Timer_Frac		equ $12	; fraction byteTimer		equ $13	; 4 bytes integer (hi byte allways zero)*			  xx.xx xx xx 00*			   |  |  |  |*			   |  |__|__|__< Timer = 12 bit integer*			   |*			   |___________< Timer_Frac = 8 bit fractionOutPortEnable	equ $17 	; $0000 = output disabledMMode		equ $19	; 0 = Omni, $FFFF = Poly, 2 = MultiBasicCh		equ $1B	; Omni, Poly channel*port		equ $1D 	; which port to use*interruptmask	equ $1F 	; recv and xmit interrupt enable byte*intserviced	equ $21 	; whether we serviced the interrupt*slot		equ $23*  SCC interrupt control*SerFlagAddr	equ $25 	; address of system variable SerFlag(4 BYTES)*SerFlagBits	equ $29 	; bits to turn on and off in SerFlag*OldIntVec		equ $2B	; old SCC Irq vector*Uport		equ $2F	; Midi Port (1 or 2)SeqItem		equ $31	; current seq item ($31-34)Tempo		equ $35	; inc value for Timer ( xx.xx)Meter		equ $37	; Meter comparator (4 bytes)OutBufIndex		equ $3B	; MIDI out buffer index - requestOutStartIndex	equ $3D	;   "   "    "      "   - to sccMetroVol		equ $3F	; DOC volume (0-$FF)* SynthInst_Ptr	equ $40	; ptr to user inst deftheGen	equ $44	; temp gen numtheOsc	equ $46	; temp osc num (theGen x 4)Awaveptr	equ $48Bwaveptr	equ $4CTemp	equ $50	; 4 bytesFreqA	equ $54	; Osc A freq holdFreqB	equ $56	; Osc B freq holdFreq2A	equ $58	; Osc A freq holdFreq2B	equ $5A	; Osc B freq holdFvolA	equ $5C	; Osc A vol holdFvolB	equ $5E	; Osc B vol holdFvol2A	equ $60	; Osc A vol holdFvol2B	equ $62	; Osc B vol holdmin	equ $64PStore	equ $66	; 4 bytes (ptr to Priority, for debug)theGen_r	equ $6A	; Allocatemin_r	equ $6C	;    "BufPtr	equ $6E	; 6E,6F,70,71Dest	equ BufPtr	; MergeMoveFlag	equ Dest+2	; DeleteTrackVelOffset	equ $72	; MIDI noteOn velocity offsetOldSource	equ $74	; 74,75,76,74 - MergeNewSource	equ $78modeA	equ $7CmodeB	equ $7Emode2A	equ $80mode2B	equ $82UserInst	equ $84	; 84,85,86,87DataPtr	equ UserInstVchan	equ $88Vkey	equ $8AVvol	equ $8C	; for VoiceInit and VoiceReleaseQueuePtr	equ $8E	; Queue IN pointerchVol	equ $90	; save of vcbCHchSus	equ $92QueueOut	equ $94	; Queue OUT pointer* seqRecBufStart	equ $C0RecBufEnd	equ $C4PlayBufStart equ $C8*PlayBufEnd	equ $CC	;@@@@ NOT USEDSeqFlags	equ $D0Freq_Tbl	equ $D2	; pointer to pitch-to-freq tableNoteList	equ $D6	; base address of note listNoteTracker	equ $D8	; final  ""  (temp) 4 bytesInBuffer	equ $DC	; pointer to MIDI IN bufferOutBuffer	equ $E0	; pointer to MIDI OUT bufferMetroFreq	equ $E4	; DOC freq reg (0-$FFFF)Seq_Status	equ $E6CountDown	equ $E8	; beats to count offTrackSav	equ $EA	; Seq Item Track numberDataBytes	equ $EC	; # of Data bytes in <SeqItemByteCount	equ $EE	;        "         "          (used by FillBuffer)RecTrack	equ $F0FreeRun	equ $F2	; 16-bit free-running timerTempoBPM	equ $F4	; Set at startup, changed by SetTempo & SetRelTempo*************** Seq Flags*************** xxxx xxxx xccc ccc* c = count of beats (0-99)F_Play	equ $0100F_Record	equ $0200notF_Play	equ $FEFFnotF_Record	equ $FDFFF_clock	equ $0400F_Metro	equ $0800		; metronomeF_KStart	equ $1000		; key start******************** Seq_Status Flags*******************SS_CountOff	equ $0001SS_KStart	equ $8000******************* VCB structure******************vcbSize	equ 64I_Ptr	equ $00	; ptr to user inst defenv_lim	equ $04	; seg breakpointnext_seg	equ $06	; offset to next segenv_inc	equ $08	; ramp step sizeenv_cur	equ $0A	; ramp accumvolA	equ $0C	; osc A volumevolB	equ $0E	; osc B volumevcbCH	equ $10	; channel number * 2sus_flag	equ $12	; 0 = no sustainenv_lim2	equ $14	; seg breakpointnext_seg2	equ $16	; offset to next segenv_inc2	equ $18	; ramp step sizeenv_cur2	equ $1A	; ramp accumvol2A	equ $1C	; osc A volumevol2B	equ $1E	; osc B volumevfreqA	equ 32	; step - fine formatvfreqB	equ 34vfreq2A	equ 36vfreq2B	equ 38PBaddr	equ 40	; addr of pitch bend mul addr (40-41)PBflag	equ 42	; 0 = no pitch bendaddDky1	equ 44	; note decay value for gen1addDky2	equ 46	; note decay value for gen2Detune1	equ 48	; DOC freq offsetDetune2	equ 50sus_hold	equ 52	; release waiting - sustain sw pressedgenNum	equ 54	; generator number (voice number x 2)* Envelope StatesAttack		equ 0Release		equ 1;-------------------------------------------------------;;  Direct page 4;;  The first half of this direct page contains self-;  modified code fragments used by the MIDI Tool Set;  and interrupt handlers.;;  The second half of this direct page is reserved for;  use by device drivers.;;-------------------------------------------------------	DSect 1		; start global data section; **** IMPORTANT NOTE:	Yes, we are beginning our direct; ****	  page definition at offset one instead of zero.; ****	  "MidiBufJml" must be defined at offset one in; ****	  order to work correctly.	Do not do anything; ****	  to disturb this fragile arrangement!MidiBufJml	block 4	  ; jml BufDispatcher;;  Midi interrupt glue;;  This small routine is called on a MIDI interrupt.;  It is located on zero page because it is modified;  by the MIDI Tool Set.  It could be done without;  modified code, but it would be slower.;MidiIntGlue		block 2	  ; rep #$30   ; long accumulator and index registers		block 1	  ; lda 	   ; get direct page 1MidiZP1 		block 2	  ;  #XXXX		block 1	  ; jslDriverHandler 	block 3	  ;  XXXXXX	   ; call driver interrupt handler		block 2	  ; sep #$30   ; short accumulator and index registers		block 2	  ; bcs oldvec ; driver didn't service the interrupt		block 1	  ; rtl		block 1	  ;oldvec jml  ; call old interrupt service routineOldIntVector	block 3	  ;  XXXXXX;;  poll MIDI input;PollInput		block 2	  ; rep #$30   ; long accumulator and registers		block 1	  ; lda 	   ; get direct page 1MidiZP1b		block 2	  ;  #XXXX		block 1	  ; jsl 	   ; call routine to poll MIDI inputDevPollAddr		block 3	  ;  XXXXXX		block 2	  ; sep #$30   ; short accumulator and registers		block 1	  ; rtl;;  a copy of the driver table;  *** must contain an even number of bytes ***;DriverAddr		long 					; address of device driver in memoryDriverID		word					; ID of device driver segment (0 if none)dt_start		DSectSize		; start of driver tabledt_init 		long 					; addr of initialization routine - 1dt_shutdown		long 					; addr of shutdown routine - 1dt_reset		long 					; addr of reset routine - 1dt_inthandler	long 					; addr of interrupt handler - 1dt_pollrecv		long 					; addr of routine to poll receiver - 1dt_recvinton	long 					; addr of proc to enable recv ints - 1dt_recvintoff	long 					; addr of proc to disable recv ints - 1dt_pollxmit		long 					; addr of proc to poll transmitter - 1dt_xmitinton	long 					; addr of proc to enable xmit ints - 1dt_xmitintoff	long 					; addr of proc to disable xmit ints - 1dt_reserved1	long 					; reserveddt_reserved2	long 					; reserveddt_end		DSectSize		; end of driver tabledt_size 		equ dt_end-dt_start	; size of driver table;;  Make sure that code fragments use less than $80 bytes,;  because offsets $80-$FF are reserved for driver usage.  If;  usage exceeds this limit, an assembly error is generated;  at this time.;enddp1	DSectSize		; end of direct page 1 usage	CheckSize enddp1,$80 	; make sure we are <= $80