## This exec file takes the binary files we have in this directory # and makes new versions of ROM.FC.AND.FD and ROM.FE.AND.FF.### Note that the files rom.FF and rom.FE are put into rom.fe.and.ff# backwards.  This makes it possible to burn the image without flipping# the parts.## After the files are created, all the files are copied to pasta:exp.rom:##############################################################################overlayiigs rom.fc ROM -a $0overlayiigs rom.fd ROM -a $10000overlayiigs rom.ff ROM -a $20000overlayiigs rom.fe ROM -a $30000overlayiigs rom.ff rom.fe.and.ff -a $0overlayiigs rom.fe rom.fe.and.ff -a $10000overlayiigs rom.FC rom.FC.and.FD -a 0overlayiigs rom.FD rom.FC.and.FD -a $10000duplicate ROM pasta:exp.rom: -y						# put the updated stuff back on pastaduplicate rom.FC pasta:exp.rom: -y					# put our latest FC, FD and fe on pasta duplicate rom.FD pasta:exp.rom: -y					# stand aloneduplicate rom.fe pasta:exp.rom: -y					#duplicate rom.fe.and.ff pasta:exp.rom: -yduplicate rom.fc.and.fd pasta:exp.rom: -yduplicate rom.map pasta:exp.rom: -y					# put link map there too.