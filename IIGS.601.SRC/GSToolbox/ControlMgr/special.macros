	print push	print off;---------------------------------------------------------	MACRO	ble &A		blt  &A		beq  &A	MEND;---------------------------------------------------------	MACRO	bgt &A		beq  @1		bge  &A@1	MEND;---------------------------------------------------------	MACRO	bcsl &A		bcc  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	bccl &A		bcs  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	beql &A		bne  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	bnel &A		beq  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	bltl &A		bge  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	bgel &A		blt  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	blel &A		bgt  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	bgtl &A		ble  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	bmil &A		bpl  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	bpll &A		bmi  @1		brl  &A@1	MEND;---------------------------------------------------------	MACRO	PushLongSpace		pha		pha	MEND;---------------------------------------------------------	MACRO	PushWordSpace		pha	MEND;---------------------------------------------------------	MACRO	PushAX		phx		pha	MEND;---------------------------------------------------------	MACRO	PullAX		pla		plx	MEND;---------------------------------------------------------	MACRO	PushZPtr &A		pea  $0000		tdc		clc		adc  #&A		pha	MEND;---------------------------------------------------------	MACRO	PushZWord &A		pei  &A	MEND;---------------------------------------------------------	MACRO	PushZLong &A		PushZWord &A+2		PushZWord &A	MEND;---------------------------------------------------------	MACRO	ldax &addr,&regs	IF &addr[1:1]='#' THEN		lda  #&addr[2:255]>>16		ldx  #|&addr[2:255]	ELSEIF &addr[1:1]='[' THEN		ldy  #&regs+2		lda  &addr,y		tax		ldy  #&regs		lda  &addr,y	ELSEIF &regs='s' THEN		lda  &addr+2,s		tax		lda  &addr,s	ELSEIF &regs='' THEN		lda  &addr		ldx  &addr+2	ELSE		lda  &addr+2,&offset		tax		lda  &addr,&offset	ENDIF	MEND;---------------------------------------------------------	MACRO	stax &addr,&regs	IF &addr[1:1]='[' THEN		ldy  #&regs		sta  &addr,y		txa		ldy  #&regs+2		sta  &addr,y	ELSEIF &regs='s' THEN		sta  &addr,s		txa		sta  &addr+2,s	ELSEIF &regs='' THEN		sta  &addr		stx  &addr+2	ELSE		sta  &addr,&offset		txa		sta  &addr+2,&offset	ENDIF	MEND;---------------------------------------------------------	MACRO	casejmp &A,&B		cmp  #&A		bne  @1		jmp  &B@1	MEND;---------------------------------------------------------	MACRO	cmpl &A,&B	IF &B='' THEN		cpx  &A+2		bne  @1		cmp  &A	ELSE		lda  &A+2		cmp  &B+2		bne  @1		lda  &A		cmp  &B	ENDIF@1	MEND;---------------------------------------------------------	MACRO	incl &A	IF &A='a' THEN		inc  a		bne  @1		inx	ELSE		inc  &A		bne  @1		inc  &A+2	ENDIF@1	MEND;---------------------------------------------------------	MACRO	decl &A	IF &A='a' THEN		cmp  #0		bne  @1		dex@1		dec  a	ELSE		lda  &A		bne  @2		dec  &A+2@2		dec  &A	ENDIF	MEND;---------------------------------------------------------	MACRO	stzl &A		stz  &A		stz  &A+2	MEND;---------------------------------------------------------	MACRO	subl &A,&B,&C		lda  &A		sec		sbc  &B		sta  &C		lda  &A+2		sbc  &B+2		sta  &C+2	MEND;---------------------------------------------------------	MACRO	addl &A,&B,&C	IF &C='' ** &B='' THEN		clc		adc  &A		sta  &A		bcc  @1		inc  &A+2@1	ELSE		lda  &A		clc		adc  &B		sta  &C		lda  &A+2		adc  &B+2		sta  &C+2	ENDIF	MEND;---------------------------------------------------------	MACRO	subw &A,&B,&C		lda  &A		sec		sbc  &B		sta  &C	MEND;---------------------------------------------------------	MACRO	addw &A,&B,&C		lda  &A		clc		adc  &B		sta  &C	MEND;---------------------------------------------------------	MACRO	mov &A,&B		lda  &A		sta  &B	MEND;---------------------------------------------------------	MACRO	swap &A,&B		lda  &A		pha		lda  &B		sta  &A		pla		sta  &B	MEND;---------------------------------------------------------	MACRO	swapl &A,&B		swap &A,&B		swap &A+2,&B+2	MEND;---------------------------------------------------------	MACRO	movl &A,&B		move &A,&B		move &A+2,&B+2	MEND;---------------------------------------------------------	MACRO	move &A,&B		mov  &A,&B	MEND;---------------------------------------------------------	MACRO	movel &A,&B		movl &A,&B	MEND;---------------------------------------------------------	MACRO	moveword &A,&B		move &A,&B	MEND;---------------------------------------------------------	MACRO	movelong &A,&B		movel &A,&B	MEND;---------------------------------------------------------	MACRO	sublong &A,&B,&C		subl &A,&B,&C	MEND;---------------------------------------------------------	MACRO	addlong &A,&B,&C		addl &A,&B,&C	MEND;---------------------------------------------------------	MACRO	PushZeroPtr &A		PushZPtr &A	MEND;---------------------------------------------------------	MACRO	stz4 &A		stzl &A	MEND;---------------------------------------------------------	MACRO	cmp4 &A,&B		cmpl &A,&B	MEND;---------------------------------------------------------	print pop