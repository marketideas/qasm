****************************************************************** Apple	IIgs Program Launcher** by Steven Glass** Copyright (C)* Apple	Computer Inc., 1986-92* All Rights Reserved** Version 6.0*** Release Notes** Version 1.0**   Sep	86    First Release.** Version 1.1**   11 Nov 86	  Now supports launching BASIC programs	with*	      the support of the new BASIC.LAUNCHER*	      The event	manager	is not started until after*	      the first	attempt	is made	to load	the tools.** Version 2.0**     31 Dec 86	  Shuts	down all tools before starting up.*	      Added version check window.** Version 2.1**      4 Jun 87	  SEG**      1.   Bug	in tool	shutdown code fixed.  After finding *	   the number of tools to shut down, I corrupted my*	   call	number for making the calls and	none*	   of the shutdown calls was made.**      2.  The mount boot volume code no longer	uses prefix 7*	   but uses the	GetBootVol call	instead.  This saves*	   a little code and preserves the prefix.** Version 2.2**      7 Jan 88	  Harry	Yee**      1.  Changes made	to dialog.asm to retrieve version numbers for*	   two new tools, Tool029 (Audio Compression and Expansion) and*	   Tool032 (Midi Tools).  Also the tool	numbers	Tool030	and Tool031*	   have	already	been assigned outside of company and therefore are*	   listed as 'not assigned' in the Version Reporter.**      15 Jun 88    Harry Yee**	   Prototype 'P' taken out of VersionStr string.** Version 6.0*      22 Oct 90    Greg Branche**	1.  Converted source to	MPW IIGS.**	2.  Updated to use Class 1 GS/OS calls and new toolset*	    features available in System disk 6.0.**	3.  Removed support for	launching BASIC	programs.**	4.  Converted so that this is a	module of the START program.**	5.  Changed Quit button	to Shutdown button, which now performs*	    an OSShutdown call.**	14 Mar 91   Greg Branche*	1.  Modified initial tool shutdown code	to check the tool*	    status prior to making the shutdown	call to	ensure that*	    the	tool in	question is actually active.**	26 Mar 91   Greg Branche*	1.  Altered to use as an official part of GS/OS.**	10 May 91   Greg Branche*	1.  Added "real" menu bar, so that NDA's are supported.**	27 Aug 91   Greg Branche*	1.  Added FlushEvents call as part of initialization so*	    that pending Command-Q events don't automatically*	    force a ShutDownGS call to occur.**	7 Oct 91    Greg Branche*	1.  Changed version number from 3.0 to 6.0 to match disk.**	5 Dec 91    Greg Branche*	1.  Added Scrap Manager and Font Manager to list of tools*	    to be started up (to better support NDAs)*	2.  Add handler for wInSpecial TaskMaster return code, so*	    the Edit menu title is properly unhighlighted when no*	    DA accepts the menu selection.**	18-Dec-91   Dave Lyons*	1.  Changed right edge of Item6 (path rectangle).**	11-Feb-92   Greg Branche*	1.  Added code to allocate 32K of memory and immediately*	    deallocate it again right after the StartUpTools call.*	    This is done to ensure that there is enough memory*	    for the toolbox to operate properly.  If the memory*	    can't be allocated, we die.******************************************************************* Version 6.1** 25-Mar-92	Dave Lyons** Changed "Volumes" button to read "Disks"** 2-Apr-92	Dave Lyons** Zero the BUSY flag on the way in, since GQuit has left it* at 1.** 17-Jul-92	Dave Lyons** Set the noResourceMgr bit in StartUpTools to avoid a duplicate* startup (which StartUpTools now checks for!).  Saved a few bytes* when pushing result space for tool calls.*****************************************************************;------------------------------------------;; Equates;;------------------------------------------tmpPtr		equ	0stopRef		equ	tmpPtr+4work		equ	stopRef+4lastWindow	equ	work+4dp_size		equ	lastWindow+4True		equ	$8000False		equ	$0000ScreenMode	equ	$80			; 640MaxX		equ	640stack_size	equ	2048			; size of my stack/direct page segmentWhereX		equ	115WhereY		equ	30appleMenuID	equ	$0001fileMenuID	equ	$0002editMenuID	equ	$0003;; Item Types;;; To disable an	item for the dialog manager, add ItemDisable to	the ItemType;ButtonItem	equ	10CheckItem	equ	11RadioItem	equ	12ScrollBarItem	equ	13UserCtlItem	equ	14StatText	equ	15EditText	equ	16EditLine	equ	17IconItem	equ	18PicItem		equ	19UserItem	equ	20UserCtlItem2	equ	21ItemDisable	equ	$8000		print	push		print	off		Include	'Launcher.mac'		print	popStart		Proc		Import	Launcher		jmp	Launcher		EndP*****************************************************************GlobalData	RECORD*****************************************************************MyDirect	DS.B	2dp_handle	ds.b	4userID		ds.b	2save_stack	ds.b	2QuitFlag	ds.b	2		string	PascalPromptLine	dc.b	'Select the application youÕd like to use:'		string	AsIsReplyRecordReplyGood	DS.B	2ReplyFType	DS.B	2ReplyFAuxType	DS.B	4ReplyNameDesc	dc.w	3			;return	a handle to the	filenameReplyName	DS.B	4ReplyPathDesc	dc.w	3			;return	a handle to the	pathnameReplyPath	DS.B	4ToolTable	dc.w	0			;flags		dc.w	ScreenMode+$C000	;videoMode+fUseShadowing+fFastPortAware		dc.w	0			;resFileID		dc.l	0			;dPageHandle		dc.w	(toolcount-*)/4		;numTools		dc.w	2,$0300			;Memory	Manager		dc.w	3,$0300			;Miscellaneous Tools		dc.w	4,$0300			;QuickDraw		DC.W	5,$0300			;desk manager		DC.W	6,$0300			;event manager		dc.w	11,$0200		;IntMath		DC.W	14,$0300		;window	manager		DC.W	15,$0300		;menu manager		DC.W	16,$0300		;control manager		DC.W	18,$0300		;QDAux		DC.W	20,$0300		;line edit		DC.W	21,$0300		;dialog	manager		DC.W	22,$0300		;Scrap Manager		DC.W	23,$0300		;standard file		DC.W	27,$0300		;font manager		DC.W	28,$0300		;list managertoolcountShutdownParms	dc.w	1			;pCount		dc.w	0			;flags (normal shutdown)EventRecordEventWhat	ds.w	1EventMessage	ds.w	2EventWhen	ds.w	2EventWhere	ds.w	2EventModifiers	ds.w	1TaskData	ds.w	2TaskMask	dc.l	$001FFFFF		dc.l	0			;wmLastClickTick		dc.w	0			;wmClickCountTaskData2	dc.l	0			;wmTaskData2		dc.l	0			;wmTaskData3		dc.l	0			;wmTaskData4		dc.l	0			;wmLastClockPt		ENDR*****************************************************************MenuData	RECORD** Will the menu	manager	crash if the menus have	no items?*****************************************************************Return		equ	13AppleMenu	dc.b	'>>@\XH'		dc.w	appleMenuID		dc.b	Return		dc.b	'==About LauncherÉ\H'		dc.w	0256		dc.b	Return		dc.b	'==-\N500D\0'		dc.b	Return		dc.b	'.'FileMenu	dc.b	'>>  File  \H'		dc.w	fileMenuID		dc.b	Return		dc.b	'==LaunchÉ\*LlH'		dc.w	0257		dc.b	Return		dc.b	'==Shut Down\*QqH'		dc.w	0258		dc.b	Return		dc.b	'.'EditMenu	dc.b	'>>  Edit  \DH'		dc.w	editMenuID		dc.b	Return		dc.b	'==Undo\*ZzH'		dc.w	0250		dc.b	Return		dc.b	'==-\N500D'		dc.b	Return		dc.b	'==Cut\*XxH'		dc.w	0251		dc.b	Return		dc.b	'==Copy\*CcH'		dc.w	0252		dc.b	Return		dc.b	'==Paste\*VvH'		dc.w	0253		dc.b	Return		dc.b	'==Clear\H'		dc.w	0254		dc.b	Return		dc.b	'.'		ENDR*****************************************************************DieOnError	PROC** Dies if carry	is set.** Number to display as death number is in x register.* Error	code to	make part of string is in a register.*****************************************************************		bcs	RealDeath		rtsRealDeath		phx		pea	0		pea	0		pha		_Hexit		pla		sta	codes		pla		sta	codes+2		pla		ora	#$FF00		pha		PushLong #DeathMsg		_SysDeathDeathMsg		DC.B	EndMsg-StartMsgStartMsg	DC.B	'Could not handle error $'Codes		DS.B	4		DC.B	' 'EndMsg		ENDP****************************************************************************************************turnOffTools	Proc;-------------------------------------------------;; Turn off everything I	can that may have been left on.		PushWord #$0402			; start	by pushing tool	set 2 call 4 on	stackLoop1		pla				; get num off stack		inc	a			; bump it		pha				; put it back		pha				; make space for result		tax				; put call number on stack		jsl	$E10000			; make version call		plx				; get rid of result		cmp	#$0001			; look for invalid version number call		bne	Loop1			; and keep looking		pla				; this number is one more than last tool		clc				; convert to a Status call		adc	#$0200			; (call	number in high byte)		pha				; put on stackLoop2		pla				; get call number		dec	a			; dec tool number		tax				; put in x for making call		and	#$00FF			; look at tool number		cmp	#2			; if it	is 2, we are done		beq	done		phx				; put back on stack		pea	$0000			; initialize return result		jsl	$E10000			; make the status call		pla				; is the toolset started?		beq	loop2			; no, skip the shutdown		lda	1,s			; get the tool number again		sec		sbc	#$0300			; turn into a shutdown call		tax		and	#$00FF			; check the toolset number		cmp	#$001E			; shutting down the resource manager?		beq	Loop2			; Don't do it!!!		jsl	$E10000			; make the call		bra	Loop2Done		rts		EndP****************************************************************DoMenu		PROC		Import	MyDialogHook,MyDialogTemplate,TheFilterProc		with	menuData,GlobalData		lda	TaskDATA		cmp	#259			; >258 is dummy do nothing - ignore		bge	Unhilite		; do nothing		sec		sbc	#250		asl	a		tax		jsr	(MenuTable,x)Unhilite	PushWord #False			; draw normal		PushWord TaskDATA+2		; which menu		_HiliteMenuIgnore		rtsMenuTable	dc.w	Ignore			; Edit items		dc.w	Ignore		dc.w	Ignore		dc.w	Ignore		dc.w	Ignore		dc.w	Ignore		dc.w	doAbout			; ID 256		dc.w	doStdFile		; ID 257		dc.w	doShutdown		; ID 258doStdFile		PushWord #WhereX		PushWord #WhereY		lda	#0			;NIL item drawing pointer		pha		pha		pha				;promptRefDesc (pointer	to Pascal string)		PushLong #PromptLine		PushLong #TheFilterProc		PushLong #0			; type list pointer		PushLong #MyDialogTemplate		PushLong #MyDialogHook		PushLong #ReplyRecord		_SFPGetFile2		ldx	#8		jsr	DieOnError		lda	ReplyGood		beq	just_cancel		lda	#1		sta	QuitFlagjust_cancel	rtsdoShutdown	lda	#$8000		sta	QuitFlag		rtsdoAbout		lda	#0			; else display the about box		pha				; space	for result		pea	8			; alertFlags (pointer, C-string, use entire width)		pha				; subStrPtr		pha		pea	aboutString>>16		; alertStrRef		pea	aboutString		_AlertWindow			; show the window		pla				; remove result	from stack				rts				; then exit		String	AsIsaboutString		dc.b	'0'			; custom window		dc.w	35			; upper	left Y		dc.w	195			; upper	left X		dc.w	155			; lower	right Y		dc.w	445			; lower	right X		dc.b	'1'			; custom icon		dc.l	iconImage		; pointer to icon image		dc.w	10			; width	of image data		dc.w	16			; height of image data		dc.b	'/'			; separator character		dc.b	1,'S'			; font style		dc.w	%00011			; bold italic		dc.b	1,'J'			; justification		dc.w	1			; centered		dc.b	'Program Launcher'		dc.b	13,13			; carriage return		dc.b	1,'S'			; font style		dc.w	0			; normal		dc.b	'Written by:'		dc.b	13		dc.b	'Steve Glass, Harry Yee,'		dc.b	13		dc.b	'and'		dc.b	13		dc.b	'Greg Branche'		dc.b	13,13		dc.b	'Copyright © 1986-1992'		dc.b	13		dc.b	'Apple Computer, Inc.'		dc.b	13		dc.b	'All Rights Reserved'		dc.b	'/'			; separator		dc.b	'^Nifty!'		dc.b	0iconImage; image	data		hex	FFFFFFFFFFFFFFFFFFFF		hex	FFFFFFFF00FFFF00000F		hex	FFFFFFF03000FF0F0F0F		hex	FFFFFF0030330F00F00F		hex	FFFFFF0030330F0F0F0F		hex	FFFFFF0330330F00F00F		hex	FFFFFF0330330F0F0F0F		hex	FFFFFF0330330F00F00F		hex	FFFFFF0330330F0F0F0F		hex	FFFFFF0330330F00F00F		hex	FFFFF00330330F0F0F0F		hex	FFFF033330330F00F00F		hex	FFF0000000330F0F0F0F		hex	FFFFF0F0FF00FF00F00F		hex	FFFFF00000000000000F		hex	FFFFFFFFFFFFFFFFFFFF;mask data		hex	0000000FFFFFFFFFFFFF		hex	000000FFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	00000FFFFFFFFFFFFFFF		hex	0000FFFFFFFFFFFFFFFF		hex	000FFFFFFFFFFFFFFFFF		hex	00FFFFFFFFFFFFFFFFFF		hex	00FFFFFFFFFFFFFFFFFF		hex	0000FFFFFFFFFFFFFFFF		hex	0000FFFFFFFFFFFFFFFF****************************************************************Launcher	PROC	Export		With	GlobalData		Import	InitStuff,DisplayName*** added 2-Apr-92 DAL -- Zero the BUSY flag (GQuit has left it at 1)		lda #0		sta >$e100ff*** end 2-Apr-92;----------------------------------------------------;; Set the data bank to code bank so I can use absolute; addressing.;		phb				; save caller's DBR		phk		plb		phd				; save caller's direct page		tsc				; get current stack pointer		sta	save_stack		; save it		_TLStartup			; start Tool locator		pha				; space	for returned result		_MMStartup		pla		sta	userID			; get our user ID		ldx	#0		phx				; space for result		phx		phx				; high word of size		pea	stack_size		; get a 2K stack/direct page		pha				; userID		pea	#%1100000000010101	; attributes		phx				; location pointer (bank 0)		phx		ldx	#$0902			; NewHandle		jsl	$E10000		ldx	#1		jsr	DieOnError		plx				; retrieve handle		pla		stx	dp_handle		; save the handle for disposal later		sta	dp_handle+2		phb				; save DBR		xba		pha		plb		plb				; set DBR to bank of Handle		lda	|0,x			; address of Pointer		plb				; restore DBR				tcd				; set our direct page		sta	MyDirect		clc		adc	#stack_size-1		; set new stack pointer		tcs		jsr	turnOffTools;-------------------------------------------------;; Load Tools and initialize them.;		jsr	InitStuff		bcc	@continue		brl	SkipName@continue;-------------------------------------------------;; Flush any pending keyboard events from the queue; just in case there's an extra Command-Q laying; around (we don't want to shut down immediately).;		pha				;space for result		pea	%0000000000101000	;event mask (auto key and key-down)		pea	0			;stop mask (remove ALL events)		_FlushEvents			;flush 'em		pla				;retrieve result;-------------------------------------------------;; Post a Menu event so that the Standard File; window is displayed automatically;		pha				;result space		pea	3			;keyDown event		pea	%0000000111000000	;modifiers (Apple Key down)		pea	'L'			;Apple-L to select menu item		_PostEvent		pla				;remove return value;-------------------------------------------------;; Drop into the event loop;		stz	lastWindow		stz	lastWindow+2Again		lda	QuitFlag		;Has Quit been select?		bne	AllDone			;... if so, stop the loop.		pha		pha				;result space		_FrontWindow			;get the front window		pla				;retrieve pointer		plx				cmp	lastWindow		;have we changed states?		bne	@fix_menu		;yes, must fix the Edit menu		cpx	lastWindow+2		beq	@no_change		;no...@fix_menu		sta	lastWindow		;update the state variable		stx	lastWindow+2		ora	lastWindow+2		;are there any windows?		beq	@disable_menu		;no, disable the edit menu				lda	#254			;enable all edit menu items@loop		pha				;save the item number		pha				;MItem number		_EnableMItem		pla				;retrieve the MItem again		dec	a		cmp	#249			;done all items yet?		bcs	@loop			;no...		pea	$FF7F			;flag		bra	@change_menu@disable_menu		pea	$0080			;flag@change_menu		pea	editMenuID		_SetMenuFlag		pea	0		pea	editMenuID		_HiliteMenu@no_change		pha		PushWord #$FFFF		PushLong #EventRecord		_TaskMaster		pla		beq	Again			;No event? loop.		cmp	#TaskMax		bcs	Again		asl	a			;Multiply by two...		tax				;use for index into...		jsr	(TaskTable,x)		;dispatch table to execute events.		bra	Again			;Loop.AllDone		bmi	just_shutdown		;if negative, shutdown was selected		jsr	DisplayName		;draw the name in the menu bar;--------------------------------------------------;; All is done, let's shut down.;SkipName		pea	$0004			; reference is by pointer		pea	ToolTable>>16		pea	ToolTable		_ShutDownTools		lda	save_stack		; restore original stack pointer		tcs		lda	dp_handle+2		; dispose of the handle		pha		lda	dp_handle		pha		ldx	#$1002			; DisposeHandle		jsl	$E10000noMemory		pld				;restore caller's direct page		_TLShutdown;-----------------------------------------------------;; Now, we look at the file type	in the reply field; if the type is $FF or	B3, we just continue quitting.; If the type is anything else we die cause it should; not happen.;		lda	ReplyFType		cmp	#$FF		beq	OKToQuit		cmp	#$B3		beq	OKToQuit		sec		ldx	#10		jmp	DieOnErrorOKToQuit		ldx	ReplyPath		;return handle in X and Y		ldy	ReplyPath+2		plb				;and DBR		rtl				;back to GQuitjust_shutdown		_OSShutdownGS ShutdownParmsTaskTable	dc.w	ignore			;0 null		dc.w	ignore			;1 mouse down		dc.w	ignore			;2 mouse up		dc.w	ignore			;3 key down		dc.w	ignore			;4 undefined		dc.w	ignore			;5 auto-key down		dc.w	ignore			;6 update event		dc.w	ignore			;7 undefined		dc.w	ignore			;8 activate		dc.w	ignore			;9 switch		dc.w	ignore			;A desk acc		dc.w	ignore			;B device driver		dc.w	ignore			;C ap		dc.w	ignore			;D ap		dc.w	ignore			;E ap		dc.w	ignore			;F ap		dc.w	ignore			;10 in desk		dc.w	DoMenu			;11 in MenuBar		dc.w	ignore			;12 wClickCalled		dc.w	ignore			;13 wInContent		dc.w	ignore			;14 wInDrag		dc.w	ignore			;15 wInGrow		dc.w	ignore			;16 wInGoAway		dc.w	ignore			;17 wInZoom		dc.w	ignore			;18 wInInfo		dc.w	DoMenu			;19 wInSpecial (to handly dummy edit menu)TaskMax		equ	(*-TaskTable)/2Ignore		rts		ENDP*****************************************************************InitStuff	PROC** Gets space in	bank zero for use as zero page by tools	and* then initializes QuickDraw, EventManager, WindowManager* MenuManger.*****************************************************************		With	GlobalData		With	MenuData		Import	MountBootDisk;-----------------------------------------------;; Now we initialize all	the tools we are going; use.;		pha				; space	for returned result		pha		lda	userID		pha				; put userID on stack*** 17-Jul-92 DAL -- set the noResourceMgr bit, because we already started it		pea	$0010			; startStopRefDesc (pointer, noResMgr)*** end 17-Jul-92		pea	ToolTable>>16		; pointer to startup list		pea	ToolTable		_StartUpTools			; use the new callDieNow		ldx	#15		jsr	DieOnError		plx		stx	stopRef		plx		stx	stopRef+2;------------------------------------------------------;; Allocate 32K to ensure that the Toolbox has enough; memory to work properly;		ldx	#0		phx				; space for result		phx		phx				; high word of size		pea	$8000			; get 32K (minimum for toolbox)		lda	userID		pha				; userID		pea	#%0000000000010000	; attributes (no cross bank)		phx				; location pointer (not used)		phx		ldx	#$0902			; NewHandle		jsl	$E10000		ldx	#2		jsr	DieOnError		ldx	#$1002			; now we can dispose of it again		jsl	$E10000			; DisposeHandle;------------------------------------------------------;; Now build the	menu bar by inserting the menus; (back	to front).;		pha		pha				; space	for return		PushLong #EditMenu		_NewMenu		PushWord #0		_InsertMenu		pha		pha				; space	for return		PushLong #FileMenu		_NewMenu		PushWord #0		_InsertMenu		pha		pha				; space	for return		PushLong #AppleMenu		_NewMenu		PushWord #0		_InsertMenu;------------------------------------------------------;; Finish off getting the menu bar ready.;		PushWord #1		_FixAppleMenu		pha		_FixMenuBar		pla				; discard menu bar height		PushWord #10			;Set starting position of menu		_SetMTitleStart		_DrawMenuBar		stz	QuitFlag		_InitCursor		clc				; signal no error		rts		ENDP*****************************************************************************DisplayName	PROC		With	GlobalData		lda	ReplyName		; get handle to	filename		sta	tmpPtr		lda	ReplyName+2		sta	tmpPtr+2		ldy	#2		lda	[tmpPtr],y		; deref		tax		lda	[tmpPtr]		sta	tmpPtr		stx	tmpPtr+2		ldy	#2			; get length word		lda	[tmpPtr],y		xba				; swap bytes		sta	[tmpPtr],y		; and put length byte preceeding string		lda	tmpPtr			; adjust pointer to point to Pascal string		clc		adc	#3		sta	tmpPtr		bcc	@1		inc	tmpPtr+2@1; the following was borrowed from the Finder		pha				;save the current grafPort		pha		_GetPort				pha				;set it to the menu bar		pha		_GetMenuMgrPort		_SetPort				pha		pha		_GetMenuBar		pla		plx		sta	work			;deref the handle to our menu bar		stx	work+2		ldy	#2		lda	[work],y		tax		lda	[work]		sta	work		stx	work+2		ldy	#8		ldx	#0rLoop		lda	[work],y		sta	myzz3rect,x		inx		inx		iny		iny		cpx	#8		blt	rLoop		pushlong #myzz3rect		pea	2		pea	1		_InsetRect		pushlong #myzz3rect		_EraseRect				pha				;find out how long our app's name is		pei	tmpPtr+2		pei	tmpPtr		_StringWidth		pla		lsr	a			;divide by 2 because we're centering it		pha				;then leave on stack				ldy	#10			;add the right edge to the left edge of		lda	[work],y		;our menu bar's rect		clc		ldy	#14		adc	[work],y		lsr	a			;div by 2 because we're centering		sec		sbc	1,s			;the total length - the string length		sta	1,s			;will tell us where to put our text so		pea	10			;that it's centered.		_MoveTo				pei	tmpPtr+2		;draw it up there -- everyone is happy		pei	tmpPtr		_DrawString				_SetPort			;restore the previous grafport		pea	0			;we only do this trick if the desktop is going		pea	0			;to bother to stay on the screen		_RefreshDesktop; end of Finder code		lda	tmpPtr			; fix length word		bne	@1		dec	tmpPtr+2@1		dec	tmpPtr		lda	[tmpPtr]		xba		sta	[tmpPtr]		rtsmyzz3rect	ds.w	4		ENDP*****************************************************************TheFilterProc	PROC**     ResultSpace*     EntryPtr** Called by standard file to decide whether or not to include* this file.*****************************************************************namePtr		equ	1OrigDirect	equ	namePtr+4RTLAdr		equ	OrigDirect+2EntryPtr	equ	RTLAdr+3Result		equ	EntryPtr+4o_name		equ	$0a			; offset to filenameo_FileType	equ	$10			; offset of FileType field in GetDirEntry record		phd		pha				; make space for temp pointer		pha		tsc		tcd		ldx	#1			; assume not selectable		ldy	#o_FileType		lda	[EntryPtr],y		and	#$00FF		cmp	#$FF			; Is it	ProDOS 8 system	file?		beq	Selectable		cmp	#$B3			; GS/OS	application?		bne	ReturnResult		; no...SelectAble	jsr	SpecialCheck		; else check the name of the fileReturnResult	stx	Result		lda	RTLAdr+1		sta	RTLAdr+4+1		lda	RTLAdr		sta	RTLAdr+4		pla				; remove temp pointer		pla		pld				; restore direct register		pla				; remove passed	pointer		pla		rtl				; return;------------------------------------------------------------;; This is a routine that checks	for two special names and; prevents the user from selecting them.;; The names are;;     PRODOS;     P8;; They are special cases because they are launchable files; (given their file types), but	should not be launched from; the launcher.;SpecialCheck		phb		phk		plb		ldy	#o_name+2		;get pointer to	name buffer		lda	[EntryPtr],y		tax		dey		dey		lda	[EntryPtr],y		clc		adc	#2			;bump past buffer length word		bcc	@1			;to get	to string length word		inx@1		sta	namePtr		stx	namePtr+2		lda	[namePtr]		;get the length	of the name		tay				; put it in y for later	too;-----------------------------------------------------------------;; This works because the two names have different lengths.; If we	want to	trap out a file	with the same length a different; method will have to be used.;		cmp	P8Name			; could	it be P8?		beq	CheckP8		cmp	ProdosName		; could	it be PRODOS		beq	CheckProDOSAllsOK		rep	#$20		longa	on		ldx	#2		plb		rtsCheckP8		sep	#$20		longa	offP8Loop		lda	[namePtr],y		and	#%11011111		;shift to upper	case		cmp	P8Name,y		bne	AllsOK		dey		bne	P8LoopDimThisOne	rep	#$20		longa	on		ldx	#1		plb		rts		longa	offCheckProDOS		sep	#$20		longa	offProdosLoop	lda	[namePtr],y		and	#%11011111		;shift to upper	case		cmp	ProDOSName,y		bne	AllsOK		dey		bne	ProdosLoop		bra	DimThisOneP8Name		wstr	'P8'ProDOSName	wstr	'PRODOS'		longa	on		ENDP************************************************************MyDialogTemplate PROC		With	GlobalData		DC.W	0,0,130,400		; Bounds Rect		DC.W	-1			; Visible		DC.L	0			; RefCon		DC.L	Item1		DC.L	Item2		DC.L	Item3		DC.L	Item4		DC.L	Item5		DC.L	Item6		DC.L	Item7		DC.L	Item8		DC.L	Item9		DC.L	00Item1		DC.W	1			; Item id		DC.W	54,265,66,375		; Item Rect.		DC.W	ButtonItem		; Item Type		DC.L	StrBut1			; Item Descriptor.		DC.W	00			; Value		DC.W	0			; Flag		DC.L	00			; ColorItem2		DC.W	2			; Item id		DC.W	72,265,84,375		; Item Rect.		DC.W	ButtonItem		; Item Type		DC.L	StrBut2			; Item Descriptor.		DC.W	00			; Value		DC.W	0			; Flag		DC.L	00			; ColorItem3		DC.W	3			; Item id		DC.W	28,265,40,375		; Item Rect.		DC.W	ButtonItem		; Item Type		DC.L	StrBut3			; Item Descriptor.		DC.W	00			; Value		DC.W	0			; Flag		DC.L	00			; ColorItem4		DC.W	4			; Item id		DC.W	98,265,110,375		; Item Rect.		DC.W	ButtonItem		; Item Type		DC.L	StrBut4			; Item Descriptor.		DC.W	00			; Value		DC.W	0			; Flag		DC.L	00			; ColorItem5		DC.W	5			; Item ID		DC.W	28,214,110,239		; Scroll Bar Rect.		DC.W	ScrollBarItem		; Type		DC.L	00			; Filled by GetFile.		DC.W	00			; Doesn't matter.		DC.W	03			; Flag		DC.L	00			; ColorItem6		DC.W	6		DC.W	12,15,24,376		; Path Rectangle (376 was 215, 18-Dec-91 DAL)		DC.W	UserItem		DC.L	00			; Filled by GetFile.		DC.W	00		DC.W	00		DC.L	0000Item7		DC.W	7		DC.W	28,15,110,215		; Files	Rectangle		DC.W	UserItem		DC.L	00			; Filled by GetFile.		DC.W	00		DC.W	00		DC.L	0000Item8		DC.W	8		DC.W	2,15,14,395		; Prompt Rectangle		DC.W	UserItem		DC.L	00			; Filled by GetFile.		DC.W	00		DC.W	00		DC.L	0000Item9		DC.W	9		DC.W	115,15,127, 202		DC.W	StatText		DC.L	VersionStr		DC.W	00		DC.W	00		DC.L	0000		String	PascalStrBut1		dc.b	'Open'StrBut2		dc.b	'Close'StrBut3		dc.b	'Disks'		;25-Mar-92 DALStrBut4		dc.b	'Cancel'VersionStr	dc.b	'System 6 Program Launcher'		String	AsIs		ENDP*******************************************************************************MyDialogHook	PROC		With	GlobalData		IMPORT	VersionDialog		sep	#$20		lda	>$E0C025		; see if open apple  down		rep	#$20		bit	#$0080			; down?		beq	ButNotDown		; no...showVersions		phd				; save d, b and	port		phb		pha		pha		_GetPortOrigPort	equ	1OrigB		equ	OrigPort+4OrigD		equ	OrigB+1RTLAdr		equ	OrigD+2ItemHitPtr	equ	RTLAdr+3DialogPortPtr	equ	ItemHitPtr+4		tsc		tcd		phk		plb		lda	[ItemHitPtr]		cmp	#9			; is it	the version item?		bne	SkipVersion		lda	MyDirect		tcd		jsr	VersionDialogexit		lda	#0000			; clear ItemHit (we handled it)		sta	[ItemHitPtr]SkipVersion		_SetPort			; restore port,	b and d		plb		pldButNotDown		phb				; put extra byte on stack		ply				; take off extra and low of rtl		plx				; take off middle and hi of rtl		pla				; take off 8 bytes of inputs		pla		pla		pla		phx				; put back middle and hi		phy				; put back low and extra		plb				; pull off extra		rtl				; done.		ENDP		INCLUDE	'dialog.aii'		END