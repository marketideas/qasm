		MACRO		_HexIt		ldx	#$2A0B		jsl	$E10000		MEND		MACRO		pushlong &addr,&offset	IF &addr[1:1]='#' THEN		pea	&addr[2:255]>>16		pea	|&addr[2:255]	ELSEIF &addr[1:1]='[' THEN		ldy	#&offset+2		pushword &addr,y		ldy	#&offset		pushword &addr,y	ELSEIF &offset='s' THEN		pushword &addr+2,s		pushword &addr+2,s	ELSEIF &offset='' THEN		pushword &addr+2		pushword &addr	ELSE		pushword &addr+2,&offset		pushword &addr,&offset	ENDIF		MEND		MACRO		_SysDeath		ldx	#$1503		jsl	$E10000		MEND		MACRO		pushword &addr,&reg	IF &addr[1:1]='#' AND &SETTING('LONGA')='ON' THEN		pea	|&addr[2:255]	ELSE	  IF &addr­'' THEN	    IF &reg­'' THEN 		lda	&addr,&reg	    ELSE		lda	&addr	    ENDIF	  ENDIF		pha	ENDIF		MEND		MACRO		_SFPGetFile2		ldx	#$1017		jsl	$E10000		MEND		MACRO		_ShutDownTools		ldx	#$1901		jsl	$E10000		MEND		MACRO		_StartUpTools		ldx	#$1801		jsl	$E10000		MEND		MACRO		_TLShutdown		ldx	#$0301		jsl	$E10000		MEND		MACRO		_OSShutDownGS &params		jsl	$E100A8		DC.W	$2003		DC.L	&params		MEND		MACRO		_TLStartup		ldx	#$0201		jsl	$E10000		MEND		MACRO		_MMStartup		ldx	#$0202		jsl	$E10000		MEND		MACRO		_NewMenu		ldx	#15+256*45		jsl	$E10000		MEND		MACRO		_InsertMenu		ldx	#15+256*13		jsl	$E10000		MEND		MACRO		_FixMenuBar		ldx	#15+256*19		jsl	$E10000		MEND		MACRO		_DrawMenuBar		ldx	#15+256*42		jsl	$E10000		MEND		MACRO		_GetPort		ldx	#$1C04		jsl	$E10000		MEND		MACRO		_GetMenuMgrPort		ldx	#$1B0F		jsl	$E10000		MEND		MACRO		_SetPort		ldx	#$1B04		jsl	$E10000		MEND		MACRO		_GetMenuBar		ldx	#$0A0F		jsl	$E10000		MEND		MACRO		_InsetRect		ldx	#$4C04		jsl	$E10000		MEND		MACRO		_EraseRect		ldx	#$5504		jsl	$E10000		MEND		MACRO		_StringWidth		ldx	#$A904		jsl	$E10000		MEND		MACRO		_MoveTo		ldx	#4+256*58		jsl	$E10000		MEND		MACRO		_DrawString		ldx	#4+256*165		jsl	$E10000		MEND		MACRO		_RefreshDesktop		ldx	#$390E		jsl	$E10000		MEND		MACRO		wstr	&str		lclc	&sset&sset		setc	&Setting('String')		String	AsIs		dc.w	&len(&str)-2		dc.b	&str		String	&sset		MEND		MACRO		_AlertWindow		ldx	#$590E		jsl	$E10000		MEND		MACRO		hex	&arg		lclc	&bytes,&hexStr&hexStr		setc	&arg	if (&len(&hexStr) AND 1) <> 0 then		aerror	'Odd number of bytes in HEX directive'&hexStr		setc	&concat(&hexStr,'0')	; make it even	endif&bytes		setc	&concat('$',&substr(&hexStr,1,2))&hexStr		setc	&substr(&hexStr,3,	&len(&hexStr)-2)	while &len(&hexStr)>0 do&bytes		setc	&concat(&bytes,',$',&substr(&hexStr,1,2))&hexStr		setc	&substr(&hexStr,3,	&len(&hexStr)-2)	endwhile		dc.b	&bytes		MEND		MACRO		_GetNewModalDialog		ldx	#$3215		jsl	$E10000		MEND		MACRO		_CreateList		ldx	#$091C		jsl	$E10000		MEND		MACRO		_InitCursor		ldx	#$CA04		jsl	$E10000		MEND		MACRO		_ModalDialog		ldx	#$0F15		jsl	$E10000		MEND		MACRO		_DisposeControl		ldx	#$0A10		jsl	$E10000		MEND		MACRO		_CloseDialog		ldx	#$0C15		jsl	$E10000		MEND		MACRO		_GetCtlRefCon		ldx	#$2310		jsl	$E10000		MEND		MACRO		_SetCtlRefCon		ldx	#$2210		jsl	$E10000		MEND		MACRO		_FindControl		ldx	#$1310		jsl	$E10000		MEND		MACRO		_TrackControl		ldx	#$1510		jsl	$E10000		MEND		MACRO		_LoadOneTool		ldx	#$0F01		jsl	$E10000		MEND		MACRO		_UnloadOneTool		ldx	#$1001		jsl	$E10000		MEND		MACRO		_GetVersionGS &params		jsl	$E100A8		dc.w	$202A		dc.l	&params		MEND		MACRO		_Int2Dec		ldx	#$260B		jsl	$E10000		MEND		MACRO		_SetMTitleStart		ldx	#$190F     		jsl	$E10000		MEND		MACRO		_FixAppleMenu		ldx	#$1E05     		jsl	$E10000		MEND		MACRO		_TaskMaster		ldx	#$1D0E		jsl	$E10000		MEND		MACRO		_HiliteMenu		ldx	#$2C0F		jsl	$E10000		MEND		MACRO		_PostEvent		ldx	#$1406		jsl	$E10000		MEND		MACRO		_FrontWindow		ldx	#$150E		jsl	$E10000		MEND		MACRO		_EnableMItem		ldx	#$300F		jsl	$E10000		MEND		MACRO		_SetMenuFlag		ldx	#$1F0F		jsl	$E10000		MEND		MACRO		_FlushEvents		ldx	#$1506		jsl	$E10000		