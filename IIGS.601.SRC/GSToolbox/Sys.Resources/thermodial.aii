****************************************************************** File:	 ThermoDial.aii** Thermometer Dial (a Custom Control)** Date:	02/24/88 (created)* Author:	Don Brady*	(and Monte Benaresh, and Dave Lyons)** Copyright Apple Computer, Inc. 1987-93******************************************************************* Modification History:** 02/24/88  Created today** 03/01/88  first release  (.01)** 03/14/88  second release (.02)** 09/14/89  Crunched & modified for ArchiverGS*           by Monte Benaresh** 09/15/89  Converted to an extended control to*           allow the defProc to be referenced*           as a resource, by Monte Benaresh** 8-Oct-90  Dave Lyons** Put into Sys.Resources as rCtlDefProc $07FF0002.* Restored support for 320 mode.* Needs color table support.* Changed default mercury color from green (8) to red (4).** 7-Apr-91  Dave Lyons** Adding an optional color table parameter, parameter number* 9 (reference by pointer, handle, or resource ID).** pCount must be 8 or 9.  moreFlags bits 0-1 indiciate color* table by pointer (00), handle (01), resource (10).  (Must* be 00 if you have no color table.)** Default color table:**   DC.W $0000	;low nybble = outline color*   dc.w $000F	;low nybble = interior color*   dc.w $0000	;low nybble = foreground mercury color (undefined for solid)*   dc.w $0004	;low nybble = background mercury color, foreground for solid,É*	;Éhigh bit set = dotted pattern******************************************************************* Begin 6.0.1** 24-Mar-93	Dave Lyons** Make the newValue routine not draw anything if the control* is invisible.  Bug found by Steve Stephenson.*****************************************************************	include 'all.macros'jump	PROC		;first bytes of this code image must be the entry point	import ThermoDialProc	brl ThermoDialProc	ENDP	DefineStackctrlPtr	long		;stack & DP offsetscolorPtr	longretAddr	block 3ctrlHandle	longctrlParam	longctrlMessage	wordretValue	longparamSize	SET 10		;bytes used by parametersCtlRec	RECORD  0		;record for the Thermodial controlctlNext	ds.l  1ctlOwner	ds.l  1ctlRect	ds.w  4ctlFlag	ds.b  1ctlHilite	ds.b  1ctlValue	ds.w  1ctlProc	ds.l  1ctlAction	ds.l  1ctlData	ds.l  1ctlRefCon	ds.l  1ctlColor	ds.l  1ctlReserved	ds.b  16ctlID	ds.l  1ctlMoreFlags	ds.w  1ctlVersion	ds.w  1ctlSizectlKey1	equ ctlReservedctlKey2	equ ctlKey1+1ctlKeyMods	equ ctlKey2+1ctlKeyModsCareBits	equ ctlKeyMods+2ctlJust	equ ctlReserved	ENDRctlTemp	RECORD 0		;record for Thermodial Control templatepCount	ds.w 1ID	ds.l 1rect	ds.b 8procRef	ds.l 1flag	ds.w 1moreFlags	ds.w 1refCon	ds.l 1			;control-specific fieldsvalue	ds.w 1		;determines position of mercurydata	ds.w 1		;determines scalecolorTable	ds.l 1	ENDR;numMessages	equ 13		;number of control messages+1numMessages	equ 20		;number of control messages+1, for extended controlpatternMask	equ $0FFC*===============================================**  Data for custom control*===============================================*MyData	RECORD	ENTRY Pixels:DATA	ENTRY Length:DATA	ENTRY SValue:DATA	ENTRY Style:DATA	ENTRY FillRect:DATA	ENTRY RectY1:DATA	ENTRY RectX1:DATA	ENTRY RectY2:DATA	ENTRY RectX2:DATA	ENTRY BPattern:DATA	ENTRY IPattern:DATA	ENTRY Colors:DATA	ENTRY ColorPen:DATA	ENTRY ColorBack:DATA	ENTRY ColorIFore:DATA	ENTRY ColorIBack:DATA	ENTRY OldPenState:DATA	ENTRY NewPenState:DATA	ENTRY PenWidth:DATA	ENTRY PenPattern:DATA	ENTRY MyColorTbl:DATA	entry LocalColorTableCopy:DATAIPattern	DS.B 32		;indicator patternBPattern	DS.B 32		;background (interior) pattern  Pixels	DC.W 0		;number of pixels to drawLength	DC.W 0		;length of rectStyle	DC.W 0		;0 = vertical, 1 = horizontalSValue	DC.W 0		;scaled valueColorsColorPen	DC.W 0		;outlineColorBack	DC.W 0		;interiorColorIFore	DC.W 0		;indicator foregroundColorIBack	DC.W 0		;indicator background (& solid)OldPenState	DS.B 50		;space for PenState recordNewPenState	DC.W 0,0		;pen location	DC.W 1		;pen heightPenWidth	DC.W 1		;pen width	DC.W $0000		;pen modePenPattern	DC.W $0000,$0000,$0000,$0000	;pen pattern	DC.W $0000,$0000,$0000,$0000	DC.W $0000,$0000,$0000,$0000	DC.W $0000,$0000,$0000,$0000	DC.B $FF,$FF,$FF,$FF	;pen mask	DC.B $FF,$FF,$FF,$FFMyColorTbl		;default color table	DC.W $0000	;low nybble = outline color	dc.w $000F	;low nybble = interior color	dc.w $0000	;low nybble = foreground mercury color (undefined for solid)	dc.w $0004	;low nybble = background mercury color, foreground for solid,É		;Éhigh bit set = dotted patternLocalColorTableCopy	ds.b 8	;copy of current control's color tableFillRect		;indicator boundary rectRectY1	DC.W 0RectX1	DC.W 0RectY2	DC.W 0RectX2	DC.W 0	ENDR*===============================================** Setup Data for Custom Control* - Calculates Length* - Scales indicator value (SValue)* - Creates QD Patterns:*	Pen (PenPattern)*	Background (BPattern)*	Indicator (IPattern)** INPUT:	--- In Direct Page ---*	ctrlParam   (Long)*	ctrlHandle  (Long)** OUTPUT:	--- In Direct Page ---*	retValue   (Long)**===============================================*SetUp	PROC	ldy #2		;dereference handle	lda [ctrlHandle],y	sta <ctrlPtr+2	lda [ctrlHandle]	sta <ctrlPtr	ldy #CtlRec.ctlFlag		;get style flag	lda [ctrlPtr],y	and #$0001	sta Style	PushLong #0		;scale current value	ldy #CtlRec.ctlValue	lda [ctrlPtr],y	ldy #CtlRec.ctlData	cmp [ctrlPtr],y		;value < max ?	bcc scale		;yes, use value	lda [ctrlPtr],y		;no, use maxscale	pha	PushWord #100	_Multiply		;value * 100	plx	ply	pha	pha	pha	pha	phy		;dividend	phx	PushWord #0		;divisor (high word)	ldy #CtlRec.ctlData	PushWord [ctrlPtr],y	;divisor (low word)	_LongDivide		;(value * 100) / max	PullWord SValue	pla		;result high-word (ignore)	pla		;remainder (ignore)	pla;	ldy #ctlColor		;get color table ptr;	lda [ctrlPtr],y;	sta colorPtr;	iny;	iny;	lda [ctrlPtr],y;	sta colorPtr+2;	ora colorPtr;	bne setColors;;;	lda #^MyColorTbl		;use default table;;;	sta colorPtr+2;;;	lda #MyColorTbl;;;	sta colorPtr*** added 7-Apr-91 DAL	jsr GetColorTablePtr	sta colorPtr+2	sty colorPtr	ora colorPtr	beq @useDefault	ldy #6@copyCT	lda [colorPtr],y	sta LocalColorTableCopy,y	dey	dey	bpl @copyCT	lda #^LocalColorTableCopy	sta colorPtr+2	lda #LocalColorTableCopy	sta colorPtr	bra @continue@useDefault	lda #^MyColorTbl	sta colorPtr+2	lda #MyColorTbl	sta colorPtr@continue*** end of 7-Apr-91 DAL	ldy #0@loop	lda [colorPtr],y	and #$000F	pha	asl a	asl a	asl a	asl a	ora 1,s	sta 1,s	xba	ora 1,s	sta Colors,y	pla	iny	iny	cpy #4*2	bcc @loop	ldy #6		;check use-pattern flag	lda [colorPtr],y	and #$8000	bne setPattern	lda ColorIBack		;for a solid pattern	sta ColorIForesetPattern			;create indicator pattern	lda #patternMask	and ColorIFore	pha	lda #patternMask	eor #$FFFF	and ColorIBack	ora 1,s	sta IPattern	pla	ldy #30		;create fill patterns@loop	lda ColorPen	sta PenPattern,y	lda ColorBack	sta BPattern,y	dey	dey	bpl @loopsetRect			;calculate fill rect	ldy #CtlRec.ctlRect	lda [ctrlPtr],y		;Y1	inc a	sta RectY1	iny	iny	lda [ctrlPtr],y		;X1	inc a	sta RectX1	iny	iny	lda [ctrlPtr],y		;Y2	dec a	sta RectY2	iny	iny	lda [ctrlPtr],y		;X2	dec a	sta RectX2	lda #1	sta PenWidth	PushWord	_GetMasterSCB		;check for 640 mode	pla	and #$0080	beq pattern320			;							*****	inc RectX1		;640 mode has 2-pixel-wide lines	dec RectX2	inc PenWidthpattern640	lda IPattern	ldx #30		;crunched next section of code --Monte Benaresh 9/14/89@loop	xba	sta IPattern,x	dex	dex	beq done640	xba	sta IPattern,x	dex	dex	bra @looppattern320	lda IPattern	sta IPattern+2		;320 pattern (8x8)	sta IPattern+8	sta IPattern+10	sta IPattern+16	sta IPattern+18	sta IPattern+24	sta IPattern+26	xba		;shift pattern by 2 pixels	sta IPattern+4	sta IPattern+6	sta IPattern+12	sta IPattern+14	sta IPattern+20	sta IPattern+22	sta IPattern+28	sta IPattern+30done640setLength			;calculate length	lda Style	asl a	tay	lda FillRect+4,y	sec	sbc FillRect,y	sta Lengthexit	rts*********************************************************************************** GetColorTablePtr** Input:  ctrlPtr points to control record*         moreFlags bits 0-1 = reference type (00=ptr, 01=handle, 10=resource)* Output: AY = pointer to color table (NIL if there's a problem)**********************************************************************************GetColorTablePtr	ldy #ctlRec.ctlColor+2	lda [ctrlPtr],y	pha	dey	dey	lda [ctrlPtr],y	pha	ldy #ctlRec.ctlMoreFlags	lda [ctrlPtr],y	and #3	beq @isPointer	dec a	beq @isHandle	ply	pla	pha	pha	;space for result	pea $800d	;rCtlColorTbl	pha	phy	_LoadResource	bcc @isHandle	lda #0	sta 3,s	sta 1,s	bra @isPointer	@isHandle	phd	tsc	tcd	ldy #2	lda [3],y	tax	lda [3]	sta 3	stx 5	pld@isPointer	ply	pla	rts	ENDP*===============================================**        Draw Indicator Part** INPUT:	none** OUTPUT:	none**===============================================*DrawIndicator	PROC	IMPORT CalcPixels	jsr CalcPixels	lda Style		;set pixel length	bne hortvert	lda RectY2	sec	sbc Pixels	sta RectY1	bra fillhort	lda RectX1	clc	adc Pixels	sta RectX2fill	PushLong #FillRect	PushLong #IPattern	_FillRect	rts	ENDP*===============================================**      Erase Part of Indicator** INPUT:	none** OUTPUT:	none**===============================================*EraseIndicator	PROC	IMPORT CalcPixels	jsr CalcPixels	lda Style		;set pixel length	bne hortvert	lda RectY2	sec	sbc Pixels	sta RectY2	bra fillhort	lda RectX1	clc	adc Pixels	sta RectX1fill	PushLong #FillRect	PushLong #BPattern	_FillRect	rts	ENDP*===============================================**      Draw the Custom Control** INPUT:	--- In Direct Page ---*	ctrlParam   (Long)*	ctrlHandle  (Long)** OUTPUT:	--- In Direct Page ---*	retValue   (Long)**===============================================*DrawControl	Proc	jsr SetUp	PushLong #0	_GetPort	PushLong [ctrlPtr],CtlRec.ctlOwner	_SetPort	PushLong #OldPenState	;save their settings	_GetPenState	PushLong #NewPenState	;use our settings	_SetPenState	lda <ctrlPtr		;get pointer to rect	clc	adc #CtlRec.ctlRect	;offset	tax	lda <ctrlPtr+2	adc #0	pha	phx	_FrameRect		;draw dial's frame	PushLong #FillRect	PushLong #BPattern	_FillRect		;draw dial's interior	jsr DrawIndicator	PushLong #OldPenState	;restore settings	_SetPenState	_SetPort	stz retValue	stz retValue+2	rts	ENDP*===============================================**        Process a new Value** INPUT:	--- In Direct Page ---*	ctrlParam   (Long)** OUTPUT:	--- In Direct Page ---*	retValue   (Long)**===============================================*DoNewValue	PROC	jsr SetUp*** added 24-Mar-93 DAL -- don't draw if we're invisible	ldy #CtlRec.ctlFlag	lda [<ctrlPtr],y	and #$0080	bne exit		;invisible!*** end 24-Mar-93	lda <ctrlParam		;new value	cmp <ctrlParam+2		;previous value	bcs grow	jsr EraseIndicator	bra exitgrow	jsr DrawIndicator	stz <retValue	stz <retValue+2exit	rts	ENDP*===============================================**     Return Control Record Size** INPUT:	none** OUTPUT:	--- In Direct Page ---*	retValue   (Long)**===============================================*RecordSize	PROC	lda #CtlRec.ctlSize		;record size	sta <retValue	stz <retValue+2	rts	ENDP*===============================================**     Initialize Control** INPUT:	--- In Direct Page ---*	ctrlParam   (Long)** OUTPUT:	--- In Direct Page ---*	retValue   (Long)**===============================================*InitControl	PROC	ldy #2		;dereference handle	lda [ctrlHandle],y	sta <ctrlPtr+2	lda [ctrlHandle]	sta <ctrlPtr	ldy #ctlTemp.value	lda [ctrlParam],y		;get mercury value from template	ldy #CtlRec.ctlValue	sta [ctrlPtr],y		;stuff it into the record	ldy #ctlTemp.data	lda [ctrlParam],y		;get scale value from template	ldy #CtlRec.ctlData	sta [ctrlPtr],y		;stuff it into the record*** added 7-Apr-91 DAL	jsr GetColorFromTemplate	;return	ldy #CtlRec.ctlColor	sta [ctrlPtr],y	iny	iny	txa	sta [ctrlPtr],y*** end of 7-Apr-91 DAL	rts		;retValue is undefined** GetColorFromTemplate -- return XA=NIL or value from template*GetColorFromTemplate	lda [ctrlParam]	cmp #9	;is the color table present?	bcc @default	ldy #CtlTemp.ColorTable+2	lda [ctrlParam],y	tax	dey	dey	lda [ctrlParam],y	rts@default	lda #0	tax	rts	ENDP*===============================================**  The following Routines are not really used.*  In most cases the "default" action is taken.*  They are included for completeness.** INPUT:	none** OUTPUT:	--- In Direct Page ---*	retValue (Long)	<-- 0**===============================================*Default	PROC	ENTRY CalculateRect	ENTRY TestControl	;ENTRY InitControl	ENTRY DisposeControl	ENTRY PostControl	ENTRY ThumbControl	ENTRY DragControl	ENTRY AutoTrk	ENTRY SetParam	ENTRY MoveControlCalculateRect			;use entire control (default rect)TestControl			;this control is always inactiveDisposeControl			;continue disposal (default)PostControl			;not usedThumbControl			;not usedDragControl			;use default draggingAutoTrk			;not usedSetParam			;??? should this be used?MoveControl			;no calculations needed	stz <retValue	stz <retValue+2	rts	ENDP*===============================================**  Thermometer-Dial Custom Control*   Control Definition Procedure** INPUT:	--- On the Stack ---*	longSpace  (Long)*	ctrlMessage (Word)*	ctrlParam   (Long)*	ctrlHandle  (Long)*** OUTPUT:	--- On the Stack ---*	retValue   (Long)**===============================================*	EXPORT ThermoDialProcThermoDialProc	PROC	PushLong #0		;work space	PushLong #0	tsc	phd	phb	phk	plb	tcd		;set DP to stack	lda <ctrlMessage	cmp #numMessages	bcs exit	asl a	tax	jsr (Operation,x)exit	plb	pld	lda retAddr+1,s	sta retAddr+paramSize+1,s	lda retAddr,s	sta retAddr+paramSize,s	tsa		;clean up stack	clc	adc #paramSize+8	tas	rtlOperation	DC.W DrawControl		;0	DC.W CalculateRect		;1	DC.W TestControl		;2	DC.W InitControl		;3	DC.W DisposeControl		;4	DC.W PostControl		;5	DC.W ThumbControl		;6	DC.W DragControl		;7	DC.W AutoTrk		;8	DC.W DoNewValue		;9	DC.W SetParam		;10	DC.W MoveControl		;11	DC.W RecordSize		;12	 	;new extended control messages	dc.w Default		;13 (ctlHandleEvent)	dc.w Default		;14 (ctlChangeTarget)	dc.w Default		;15 (ctlChangeBounds)	dc.w Default		;16 (ctlWindChangeSize)	dc.w Default		;17 (ctlHandleTab)	dc.w Default		;18 (ctlNotifyMultiPart)	dc.w Default		;19 (ctlWinStateChange)	ENDP*===============================================**        Calulate Pixels** Pixels <--- (SValue * Length)/100** INPUT:	none** OUTPUT:	none**===============================================*CalcPixels	PROC	PushLong #0	PushWord SValue		;Note: 0 ² SValue ² 100	PushWord Length		;      0 ² Length ² 640	_Multiply		;SValue * Length	pla		;result	PushWord #0	pha		;dividend	PushWord #100		;divisor	_UDivide		;(SValue * Length) / 100	PullWord Pixels	pla		;remainder (ignore)	rts	ENDP	END