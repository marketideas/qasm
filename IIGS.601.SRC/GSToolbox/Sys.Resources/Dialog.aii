*****************************************************************VersionDialog	PROC*****************************************************************		With	GlobalData		Import	GetVersions,VersionFilterHandle		equ	40Pointer		equ	44		ldx	#$0A12			;WaitCursor		jsl	$E10000		pha				; get the port and leave it on the		pha				; stack		_GetPort		pha		pha		PushLong #Template		_GetNewModalDialog		; leave	pointer	on stack		lda	1,s			; save the pointer and set		sta	VDialogPtr		; the port		lda	3,s		sta	VDialogPtr+2		_SetPort		jsr	GetVersions		pha				; space	for result		pha		PushLong VDialogPtr		PushLong #ListRec		; list record		_CreateList		pla		sta	ListControl		pla		sta	ListControl+2		jsr	SaveAndZeroRefCons		_InitCursor		pha		PushLong #VersionFilter+$80000000		_ModalDialog			; call modal dialog		pla		PushLong ListControl		_DisposeControl		PushLong VDialogPtr		_CloseDialog			; close	the dialog		_SetPort		rtsSaveAndZeroRefCons		pha				; Get the ref con of the list		pha				; control and save it		PushLong ListControl		_GetCtlRefCon		pla		sta	ListRefCon		pla		sta	ListRefCon+2		lda	ListControl		; now find the handle to the		sta	handle			; scroll bar control		lda	ListControl+2		; (its at the end of the record		sta	Handle+2		; used by the list control)		lda	[Handle]		sta	Pointer		ldy	#2		lda	[Handle],y		sta	Pointer+2		ldy	#52		lda	[Pointer],y		sta	ScrollControl		iny		iny		lda	[Pointer],y		sta	ScrollControl+2		pha				; use this to save and zero		pha				; ref con of the Scroll	bar control		PushLong ScrollControl		_GetCtlRefCon		pla		sta	ScrollRefCon		pla		sta	ScrollRefCon+2		Entry	ZeroRefConsZeroRefCons		PushLong #0			; zero the ref con of the list		PushLong ListControl		; control		_SetCtlRefCon		PushLong #0		PushLong ScrollControl		_SetCtlRefCon		rts		Entry	RestoreRefConsRestoreRefCons		PushLong ListRefCon		; zero the ref con of the list		PushLong ListControl		; control		_SetCtlRefCon		PushLong ScrollRefCon		PushLong ScrollControl		_SetCtlRefCon		rts		Import	MyDraw,MyList		Entry	VDialogPtrVDialogPtr		DS.B	4ListControl	DS.B	4ListRefCon	DS.B	4ScrollControl	DS.B	4ScrollRefCon	DS.B	4Template	DC.W	20,30,185,350		; bounds rect		DC.W	TRUE			; visible		DC.L	0			; ref con		DC.L	item1		DC.L	item2		DC.L	0000item1		DC.W	1			; id		DC.W	145,250,00,00		; bounds rect for button		DC.W	ButtonItem		; type		DC.L	But1			; item descreptor		DC.W	00			; item value		DC.W	0			; item flag		DC.L	0			; item coloritem2		DC.W	2			; id		DC.W	05,10,15,280		; bounds rect		DC.W	StatText		; type		DC.L	Msg			; item descreptor		DC.W	00			; item value		DC.W	0			; item flag		DC.L	0			; item colorListRec		DC.W	27,10,109,280		; lists	enclosing rect		DC.W	39			; number of members in the list		DC.W	08			; number seen at once		DC.W	$01			; list type (c strings)		DC.W	1			; list start (first seen)		DC.L	0			; space	for control		DC.L	MyDraw			; list draw (pointer to	draw routine)		DC.W	10			; height of single item		DC.W	6			; size of list record		DC.L	MyList			; pointer to the list itself		DC.L	0			; ref con		DC.L	0			; adr of color table for control		EXPORT	MyListMyList		dc.l	Tool0		dc.b	0,0		DC.L	Tool1			; pointer to string		DC.B	0,1			; memflag byte and index number		DC.L	Tool2		DC.B	0,2		DC.L	Tool3		DC.B	0,3		DC.L	Tool4		DC.B	0,4		DC.L	Tool5		DC.B	0,5		DC.L	Tool6		DC.B	0,6		DC.L	Tool7		DC.B	0,7		DC.L	Tool8		DC.B	0,8		DC.L	Tool9		DC.B	0,9		DC.L	Tool10		DC.B	0,10		DC.L	Tool11		DC.B	0,11		DC.L	Tool12		DC.B	0,12		DC.L	Tool13		DC.B	0,13		DC.L	Tool14		DC.B	0,14		DC.L	Tool15		DC.B	0,15		DC.L	Tool16		DC.B	0,16		DC.L	Tool17		DC.B	0,17		DC.L	Tool18		DC.B	0,18		DC.L	Tool19		DC.B	0,19		DC.L	Tool20		DC.B	0,20		DC.L	Tool21		DC.B	0,21		DC.L	Tool22		DC.B	0,22		DC.L	Tool23		DC.B	0,23		DC.L	Tool24		DC.B	0,24		DC.L	Tool25		DC.B	0,25		DC.L	Tool26		DC.B	0,26		DC.L	Tool27		DC.B	0,27		DC.L	Tool28		DC.B	0,28		DC.L	Tool29		DC.B	0,29		DC.L	Tool30		DC.B	0,30		DC.L	Tool31		DC.B	0,31		DC.L	Tool32		DC.B	0,32		DC.L	Tool33		DC.B	0,33		DC.L	Tool34		DC.B	0,34		DC.L	Tool35		DC.B	0,35		DC.L	Tool36		DC.B	0,36		DC.L	Tool37		DC.B	0,37		DC.L	Tool38		DC.B	0,38		String	PascalBut1		dc.b	'OK'Msg		dc.b	'Version Reporter'Tool0		dc.b	' 0.  GS/OS'Tool1		dc.b	' 1.  Tool Locator'Tool2		dc.b	' 2.  Memory Manager'Tool3		dc.b	' 3.  Miscellaneous Tools'Tool4		dc.b	' 4.  QuickDraw II'Tool5		dc.b	' 5.  Desk Manager'Tool6		dc.b	' 6.  Event Manager'Tool7		dc.b	' 7.  Scheduler'Tool8		dc.b	' 8.  Sound Manager'Tool9		dc.b	' 9.  ADB Tool'Tool10		dc.b	'10.  SANE'Tool11		dc.b	'11.  Integer Math'Tool12		dc.b	'12.  Text Tools'Tool13		dc.b	'13.  Used Internally'Tool14		dc.b	'14.  Window Manager'Tool15		dc.b	'15.  Menu Manager'Tool16		dc.b	'16.  Control Manager'Tool17		dc.b	'17.  System Loader'Tool18		dc.b	'18.  QuickDraw Auxilary'Tool19		dc.b	'19.  Print Manager'Tool20		dc.b	'20.  Line Edit'Tool21		dc.b	'21.  Dialog Manager'Tool22		dc.b	'22.  Scrap Manager'Tool23		dc.b	'23.  Standard File'Tool24		dc.b	'24.  Disk Utilities'Tool25		dc.b	'25.  Note Synthesizer'Tool26		dc.b	'26.  Note Sequencer'Tool27		dc.b	'27.  Font Manager'Tool28		dc.b	'28.  List Manager'Tool29		dc.b	'29.  A.C.E.'Tool30		dc.b	'30.  Resource Manager'Tool31		dc.b	'31.  not assigned'Tool32		dc.b	'32.  Midi Tools'Tool33		dc.b	'33.  Video Overlay'Tool34		dc.b	'34.  TextEdit'Tool35		dc.b	'35.  MidiSynth'Tool36		dc.b	'36.  not assigned'Tool37		dc.b	'37.  Animation Tools'Tool38		dc.b	'38.  Media Control'		String	AsIs		ENDP******************************************************************MyDraw		PROC** This routine draws the list item when	asked by the list mgr**	Ptr to Bounding	Rect*	Ptr to member record*	Handle to list Control record*******************************************************************		Import	DrawVerString,VerTableOrigD		equ	1RTLAdr		equ	OrigD+2CHandle		equ	RTLAdr+3MemberPtr	equ	CHandle+4RectPtr		equ	MemberPtr+4		phd		tsc		tcd		phb		phk		plb		ldy	#2		lda	[RectPtr],y		clc		adc	#10		pha		ldy	#4		lda	[RectPtr],y		dec	a		dec	a		pha		_MoveTo		ldy	#2		lda	[MemberPtr],y		pha		lda	[MemberPtr]		pha		_DrawString		ldy	#6		lda	[RectPtr],y		sec		sbc	#42		pha		ldy	#4		lda	[RectPtr],y		dec	a		dec	a		pha		_MoveTo		ldy	#5		lda	[MemberPtr],y		and	#$00FF		asl	a		tax		lda	VerTable,x		jsr	DrawVerString		plb		pld		lda	1,s		sta	13,s		lda	2,s		sta	14,s		tsc		clc		adc	#12		tcs		rtl		ENDP******************************************************************VersionFilter	PROC*******************************************************************		With	GlobalDataoWhere		equ	10			; offset in event recordOrigD		equ	1OrigB		equ	OrigD+2RTLAdr		equ	OrigB+1ItemHitPtr	equ	RTLAdr+3EventPtr	equ	ItemHitPtr+4DialogPtr	equ	EventPtr+4ReturnFlag	equ	DialogPtr+4		phd				; save d		phb				; save b		phk				; set b	to our bank		plb		tsc				; turn stack into zp		tcd		stz	ReturnFlag		; we always return false		lda	[EventPtr]		cmp	#1			; only care about mouse	down		bne	AllDone		pha		PushLong #FoundControl		ldy	#oWhere+2		lda	[EventPtr],y		pha		dey		dey		lda	[EventPtr],y		pha		PushLong VDialogPtr		_FindControl		pla		beq	AllDone		cmp	#5			; if less than a up arrow then skip it		bcc	AllDone		cmp	#10			; if less than grow then take it		bcc	DoIt		cmp	#$81		bne	AllDoneDoIt		jsr	RestoreRefCons		pha		ldy	#oWhere+2		lda	[EventPtr],y		pha		dey		dey		lda	[EventPtr],y		pha		PushLong #$FFFFFFFF		PushLong FoundControl		_TrackControl		pla		jsr	ZeroRefConsAllDone		plb				; restore b		pld				; restore d		phb				; put extra byte on stack		pla				; pull long into x,a		plx		ply				; strip	6 words		ply		ply		ply		ply		ply		phx		pha		plb				; pull extra byte		rtl				; doneFoundControl	DS.B	4		ENDP******************************************************************GetVersions	PROC** Fills	the version table with the right version numbers.******************************************************************		Import	VerTable		PushWord #$0426			; start	with Media Controller versionLoop		lda	1,s		tax		pea	0000		jsl	$E10000		pla		bcc	VerOK		lda	1,s			; lets try loading the tool from		and	#$00FF			; disk--get ts num in low byte of a		pha				; push it		PushWord #$0000			; no min version		_LoadOneTool			; load it		lda	#$FFFF			; assume fail		bcs	VerOK			; oh-well we failed.		lda	1,s			; it loaded!		tax				; get the version call number again		pea	0000			; and make the call		jsl	$E10000		lda	3,s			; get tool number again	so I can		and	#$00FF			; unload the tool		pha				; twice	for good luck		pha		_UnloadOneTool		pla				; get rid of second		pla				; now get version result off stackVerOK		tay		lda	1,s		and	#$00FF		asl	a		tax		tya		sta	VerTable,x		pla		dec	a		pha		and	#$00FF		bne	Loop		pla				; remove tool number from stack		_GetVersionGS versionParms	; get the OS version number		lda	osVersion		sta	VerTable		; pretend it's tool 0		rtsversionParms	dc.w	1			;pCountosVersion	ds.w	1			;space for returned version #		ENDP******************************************************************VerTable	Record******************************************************************		DS.w	39			;space to hold tool version words		ENDR******************************************************************DrawVerString	PROC** Called when pen is already in	position.  Version number is in* a-reg.******************************************************************		cmp	#$FFFF		bne	continue		PushLong #NAStr		_DrawString		rts		String	PascalNAStr		dc.b	' N/A'		String	AsIscontinue		pha				; save version on stack		lda	#4		sta	StrLen		lda	1,s		xba		and	#$007F			; put high byte	of version number on stack		pha		PushLong #Chars		PushWord #2		PushWord #0			; not signed		_Int2Dec			; convert to ASCII		lda	#'.'		sta	Chars+2		lda	1,s		and	#$00FF			; put low byte of version number on stack		pha		PushLong #Chars+3		ldx	#1			; init index		sep	#$20			; 8-bit	compares, please		longa	off@loop		cmp	magnitude,x		; find out how big to make the number		bcc	@done			; got it		inx		inc	StrLen			; bump string length too		bne	@loop			; branch always@done		rep	#$20			; back to 16-bit mode		longa	on		phx				; put length of	number on stackSizePushed	PushWord #0			; not signed		_Int2Dec			; convert to ASCII		pla				; take version off the stack		bpl	NotProto		sep	#$30		longa	off		longi	off		inc	StrLen			; bump by 1 to include the 'P'		ldx	StrLen			; point	to end of string		lda	#'P'			; put the P there too		sta	Str,x		rep	#$30		longa	on		longi	onNotProto		PushLong #Str		_DrawString		rtsStrStrLen		DS.B	1Chars		DS.B	6			; 'xx.xxP'magnitude	dc.b	0,10,100		ENDP