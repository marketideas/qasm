# Note:  All LinkIIGS commands for code resources should use the -x option# to suppress generation of ExpressLoad format load files.  Since code resources# are relatively small, and don't get processed by ExpressLoad anyway, we might# as well cut down on the ultimate size of the resources.SYS.RESOURCES	Ä		sys.resources.r	¶				Thermodial.Load	¶				IconButton.Load	¶				FrameControl.Load	¶				Launcher.load	¶				makefile	reziigs -rd sys.resources.r -o SYS.RESOURCES -t "F9  "	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac Sys.Resources :	EndIconButton.Load	Ä		IconButton.aii.obj	LinkIIGS -x IconButton.aii.obj -o IconButton.LoadIconButton.aii.obj	Ä		IconButton.aii	asmiigs	IconButton.aii -unsafe -wiThermodial.Load	Ä		Thermodial.aii.obj	LinkIIGS -x Thermodial.aii.obj -o Thermodial.LoadThermodial.aii.obj	Ä		Thermodial.aii	asmiigs	Thermodial.aii -unsafe -wiFrameControl.Load	Ä		FrameControl.aii.obj	LinkIIGS -x FrameControl.aii.obj -o FrameControl.LoadFrameControl.aii.obj Ä		FrameControl.aii	asmiigs	FrameControl.aiiLauncher.Load	Ä	Launcher.aii ¶			Launcher.mac ¶			Dialog.aii	Asmiigs Launcher.aii -o Launcher.Obj	LinkIIGS  -x -t $BC -o Launcher.Load ¶		-lseg:code:nospecial:static Launcher Launcher.obj