	title 'IconButtDefProc'************************************************************************ Icon Button Control Def Proc*** Copyright (C)* Apple Computer, Inc. 1988-91* All Rights Reserved** 14 Nov 88	 Konstantin Othmer** Change History:** 22 Mar 89	Harry Yee** Locked down the control handle passed to the icon button defproc. * WorkSheet #BCOJHS082.** 28 Mar 89	Steven Glass** Added support for the new ctlWinStateChange message.** 06 Apr 89	Yee & Mensch** We now explicitly set the text mode before drawing any text. The text* mode is set to mode copy. Before we used whatever text mode the grafport* happened to be set to. WorkSheet #BCOJHS096.* * Icon buttons were not smearing the color nibble thru the whole word* but now they do.... (that lazy butt head konstantine)** 07 Apr 89	Mensch** We were calling SetSolidPenPat when we should have been calling SetPenPat* and creating the pattern ourselves. Also when drawing any text in an icon* button, we need to call SetFontFlags telling QD to use the whole word of the * background/foreground color instead of just the low nibble. WorkSheet #BCOJHS100.** 13 Apr 89	 Harry Yee** We were not checking to see whether the message was RecSize before trying to * lock and deref the control handle. Now we check before trying to lock the handle* and then again when trying to unlock the handle.** 01 May 89	Harry Yee** We were calling SetSolidPenPat when we should have been calling SetPenPat* and creating the pattern ourselves (this was when we were drawing the icon's * border) BRC #47579.** 6/8/89	Mensch, Glass, Harry, Darryl, and Margarita** Geez, what a silly bug this is. If the control defproc happens to* move (very possible) while an icon button is up then if it uses the* default color table it will be completely screwed up! Well, now that* won't happen cause we leave zero as an indicator now...** 6/9/89	Mensch** That bug last night pointed out another bug. The icon button was preserving* all parts of the grafport that it changed except for the fore and back color.* It now does this.** 29-Nov-90	Dave Lyons** Defined bit 3 of the Flags to make the control inactive except that it* still *looks* active.  It just always returns 0 from the Test routine.** 19-Dec-90	Dave Lyons** If bit 3 of Flags is set, we don't inval the control on the ChangeState* message.** 7-Jul-91	Dave Lyons** Macroized a few tool calls, and changed a couple dozen LDA/PHA into PEI.** 10-Dec-91	Dave Lyons** In UnlockTitle, fixed potentially-random weirdness.  This would have* crashed before, except GetCtlTitle was reliably returning X=$0004.* See full description in source.************************************************************************** BEGIN 6.0.1** 17-Mar-92	Monte Benaresh** Added option and support for "sticky" icon controls.  If bit 4 of the* ctlFlag field is set, then the control registers a track routine to* be called from TrackControl.  This routine keeps control until the* mouse button is released, and leaves the icon drawn in a highlighted* state if the mouse is inside the control at the release time.  At* this point, the ctlValue field is set to 1 if the mouse was in the* control at that time, and is left alone otherwise.  Thus, it is the* responsibility of the owner of the control to "un-select" it if desired* by setting the control value to 0 and redrawing the control. The icon* always draws in the highlighted state if the ctlValue field is not 0.** An extra parameter, #12, has been added to the control template to* allow for an initial value word for this type of control.** 18-Jun-92	Dave Lyons (6.0.1d6)** Added a few lines in ctlHandleEvent to make Monte's Sticky bit work* for key equivalents.  For sticky case, had to skip HiliteControl(0)* and stuff ctlValue=1 and ctlHilite=0.** 15-Jul-92	Dave Lyons (6.0.1d7)** Oops, fix problem I introduced last time, where a non-sticky control* would stay hilited by accident (I typed the wrong label on a branch).***********************************************************************	print off	INCLUDE  'all.macros'	INCLUDE  'E16.EVENT'; private macro definition	MACRO	PushZPtr &A	pea  $0000	tdc	clc	adc  #&A	pha	MEND	print on;-----------------------------------------------------------;; Set up template definitions for custom controls;Rectangle	RECORD $0y1	ds.w 1x1	ds.w 1y2	ds.w 1x2	ds.w 1	ENDR;; New Control record template;Ctl	RECORD $0Next	ds.l 1Owner	ds.l 1Rect	ds RectangleFlag	ds.b 1Hilite	ds.b 1Value	ds.w 1Proc	ds.l 1Action	ds.l 1Data	ds.l 1RefCon	ds.l 1Color	ds.l 1Reserved	ds.b $10ID	ds.l 1MoreFlags	ds.w 1Version	ds.w 1IconRef	ds.l 1DisplayMode	ds.w 1ctlKey1	equ ReservedctlKey2	equ ctlKey1+1ctlKeyMods	equ ctlKey2+1ctlKeyModsCareBits	equ ctlKeyMods+2	ENDR	IconRecSize	equ Ctl.DisplayMode+2		Icon	RECORD 0Type	ds.w 1Size	ds.w 1Height 	ds.w 1Width	ds.w 1Image	ds.l 1	;arbitrarily longMask	ds.l 1	;arbitrarily long	ENDR;-----------------------------------------------------------;; Stack Frame Equates for control;	DefineStackOrigD	wordOrigB	bytemode	word	;tells us whether we're in 640 or 320 modeBoundsTemp	longIconTemp	longCtlPtr	LONG	;pointer to control recordret	block 3theControlHandle	longctlParam	longctlMessage	wordReturnValue	long************************************************************************ All the custom control stuff for iconbutton control begins here************************************************************************	EXPORT CtrlCustomProcCtrlCustomProc	PROC** This is the def_proc for icon button controls.  When this* routine gets control, the stack looks as described below.**** Inputs:	On entry, the parameters are passed to us on the stack.**	|	| Previous Contents*	|-------------------|*	|    ReturnValue	| LONG - Space for return value*	|-------------------|*	|    CtlCode	| WORD - operation to perform*	|-------------------|*	|    CtlParam	| LONG - add'l parameter*	|-------------------|*	|    theCtlHandle	| LONG - Handle to control record*	|-------------------|*	|    RtnAddr	| 3 BYTES - RTL address*	|-------------------|*	|	| <-- Stack pointer** Outputs:	Put something into ReturnValue, pull off the parameters,*	and return to the Control Manager.**	|	| Previous Contents*	|-------------------|*	|    ReturnValue	| LONG - Space for return value*	|-------------------|*	|    RtnAddr	| 3 BYTES - RTL address*	|-------------------|*	|	| <-- Stack pointer** set up direct page	pha	;room for CtlPtr	pha		pha	;room for IconPtr	pha	pha	;room for BoundsTemp	pha	pha	;room for mode		phb	phd	phk	plb	tsc		tcd	lda <ctlMessage	cmp #12	; Is RecSize message being sent?	beq SkipDeref	ldy #4	lda [<theControlHandle],y	ora #$8000	; lock down handle to control first	sta [<theControlHandle],y	 	lda [<theControlHandle]	sta <CtlPtr	ldy #2	lda [<theControlHandle],y	sta <CtlPtr+2	lda <ctlMessage	;dispatch the messageSkipDeref	cmp #19+1	;ignore messages out of range	bcc InRange	lda #1	;Returns a null.	InRange	asl a	tax	jsr (CtrlDispatch,x)		sta <ReturnValue	; save the return value	stx <ReturnValue+2		lda <ctlMessage	cmp #12	; Was the RecSize control message sent?	beq SkipUnlock	ldy #4	lda [<theControlHandle],y	and #$7FFF	; unlock the control handle	sta [<theControlHandle],ySkipUnlock	;; The Return Value has been stored on the stack, and it is time for us to; return back to the Control Manager. Before we do so, however, we must; remove the parameters that were passed to us on the stack. We do this; by moving the RTL address up just below the Return Value, getting the; stack pointer, and adding an amount to it so that we point to where; the RTL address has been moved to. We can then simply RTL back to the; Control Manager, and it will pick up the Return Value right off of the; stack!;	lda <Ret	; move the return address up	sta <ReturnValue-3	lda <Ret+1	sta <ReturnValue-2	tsc	; Get the stack pointer	pld	; restore caller's Data Bank and	plb	; Direct Page registers	clc	; Adjust the stack pointer to point to	adc #ReturnValue-4	; the new location of the RTL address.	tcs	; Put the stack pointer back.	rtl	; back to the caller	CtrlDispatch	dc.w drawCtl	dc.w Ret_Null	;calcCRect	dc.w testCtl	dc.w initCtl	dc.w dispCtl	dc.w Ret_Null	;posCtl	dc.w Ret_Null	;thumbCtl	dc.w Ret_Null	;dragCtl	dc.w autoTrack	;proc added 3/16/92 by Monte	dc.w Ret_Null	;newValue	dc.w Ret_Null	;setParams	dc.w Ret_Null	;moveCtl	dc.w recSize	;12 recSize	dc.w ctlHandleEvent ;13	dc.w Ret_Null	;14 ctlChangeActivity	dc.w Ret_Null	;15 ctlChangeBounds	dc.w Ret_Null	;16 ctlWindChangeSize	dc.w Ret_Null	;17 ctlHandleTabl	dc.w Ret_Null	;18 ctlMultiPart	dc.w ChangeState	;19 ctlChangeWinState	ENDP*****************************************************************autoTrack	PROC** Special mouse track routine for "sticky" icons.** This standard control message handler gets called by the* track loop in TrackControl.  When the current icon is a* sticky icon, we keep control with our own track loop* until the mouse button is released.  If the button is* released while the mouse is in the icon control, the* control stays "highlighted" to show that it is selected.** By Monte Benaresh -- 3/16/92** Inputs:*	none** Outputs:*	none** External Refs:*	calls drawCtl**	longa on	; mode	longi on*****************************************************************	ldy #Ctl.flag	lda [CtlPtr],y	and #$0010	;are we a "sticky" icon?	bne @is_sticky	rts	;do nothing if not sticky@is_sticky	;when we get called from TrackControl, we are	;already in the highlighted statetrack_loop; test for mouse in the icon by calling our testCtl routine; with the current mouse position	pea $0000	;high word of ptr to point	tdc	clc	adc #ctlParam	pha	;low word	_GetMouse	jsr testCtl	;call our test routine with pt in <ctlParam	tax	;save result	ldy #Ctl.Hilite	eor [CtlPtr],y	;compare to current highlighting	and #$00FF	;byte only!	beq no_h_changechange_h	txa	;restore result of point test	sep #$20	LONGA OFF	ldy #Ctl.Hilite	sta [CtlPtr],y	;set new highlighting	rep #$20	LONGA ON	lda #$0000	sta <ctlParam	;set to draw entire control	jsr drawCtlno_h_change; now check for mouse button still down	pha	;space for result	pea $0000	;read mouse button	_WaitMouseUp	pla	;boolean result	bne track_loop	;loop if still downreleased; the mouse button was released; if we were inside the control,; set ctlValue to "selected". in any case, we clear ctlHilite	ldy #Ctl.Hilite	lda [CtlPtr],y	;check where we were on mouseup	tax	;look at result later	and #$FF00	;clear low (hilite) byte	sta [CtlPtr],y	txa	;restore original hilite	and #$00FF	beq @outside@inside	lda #$0001	;value for "selected"	ldy #Ctl.value	sta [CtlPtr],y	;set in record@outside; if mouse was outside, leave value field alone	rts*****************************************************************ChangeState	PROC** Invalidates the controls rectangle so it will be redrawn.*** Inputs:*	none** Outputs:*	none** External Refs:*	none** Entry Points:*	none*	longa on	; mode	longi on******************************************************************** added 19-Dec-90 DAL: don't inval if we're unresponsive to clicks	ldy #Ctl.Flag	lda [<CtlPtr],y	eor #$0008	;flip the bit so I can "beq" with a 0 to exit w/ A=0	and #$0008	beq @1*** end of 19-Dec-90 DAL	lda <ctlPtr	clc	adc #Ctl.Rect	tax	lda <ctlPtr+2	adc #0	pha	phx	_InvalRect@1	tax	rts	ENDP**********************************************************************	EXPORT drawCtldrawCtl	PROC** Draws the control using DrawIcon.*** Inputs:*	theControlHandle*	ctlPtr** Outputs:*	a-reg and x-reg are zero.** External Refs:;	import LoadResource** Entry Points:*	none*;; Bit 7 = 1 => Control is invisible;	ldy #Ctl.Flag	lda [<CtlPtr],y	bit #$0080	;test bit 7	beq DrawIt	rts	;do nothing if control is invisibleDrawIt;; Save current pen state before doing anything.;	PushLong #OrigPenState	;area to save pen parameters	_GetPenState	;; 6/9/89 Mensch; Insert fix here to preserve the text foreground and background colors...	pha	_GetForeColor	pla	sta >OrigFGColor	pha	_GetBackColor	pla	sta >OrigBGColor	lda <CtlPtr	;create pointer to cntrl bounds	clc	adc #8	tax	lda <CtlPtr+2	adc #0	sta <BoundsTemp+2	;temp storage:  keep cntrl bounds ptr	stx <BoundsTemp;; Set up data area for text width and height;	pushlong #FontInfoRec	_GetFontInfo		;gets text height	;if there is no text, set text height to zero.	jsr GetTitlePtr	cpx #0	bne NotNull	cmp #0	bne NotNull;;we have a null string: zero text parameters so their heights are not taken into consideration;when centering icon and text.;	stz ascent	stz descent	stz leadingNotNull	pha	;space for result of string width	jsr GetTitlePtr	pha	phx	_StringWidth	;leaves width in pixels on the stack	pla	sta SWidth;; Set up pointer to color table;	jsr GetColorPtr	;!! uses icontemp for temporary storage !!	stx <ctlParam	sta <ctlParam+2;; Set up icon pointer;	jsr GetIconPtr	sta <IconTemp+2	stx <IconTemp;; Setup width and height;	ldy #Icon.width	lda [<IconTemp],y	pha	;save icon width	pea #0	_GetMasterSCB	pla	;SCB	and #$80	sta <mode	bne Do640Mode	pla	bra SaveWidth	Do640Mode	pla	asl a	;convert it to 640 modeSaveWidth	sta iWidth	ldy #Icon.Height	lda [<IconTemp],y		sta iHeight	;save icon height;; if bottom right corner of boundsTemp = 0,0 then we calculate it;	ldy #CTL.rect.y2	lda [<CtlPtr],y	;bottom of ctrlbounds	ldy #CTL.rect.x2	ora [<CtlPtr],y	;right side of ctrlbounds	bne NoCalc;; Bottom = Top + icon height + text height + 8; Right = Left + MAX (Icon width, text width) + 12;	ldy #CTL.rect.y1	lda [<CtlPtr],y	;top of ctrlbounds	clc	adc iHeight		adc ascent	adc descent	adc leading	;textheight from fontInfo Record	adc #8	ldy #CTL.rect.y2	sta [<CtlPtr],y	;bottom of ctrlbounds	lda iWidth	cmp SWidth	bcs IconWider	lda SWidthIconWider	ldy #CTL.rect.x1	clc	adc [<CtlPtr],y	adc #12	ldy #CTL.rect.x2	sta [<CtlPtr],y	;; Always inset the control rect so that when we draw a round rect with a bold; outline the whole thing fits in the control rect. ;NoCalc	pushlong <BoundsTemp	ldx #4	lda <mode	bne storeit	ldx #3storeit	phx	pea 2	_InsetRect;Now we're set to perform all drawing commands . . .*** added 16-Mar-92 Monte Benaresh***	Check if we're currently "selected", which is***	possible for a "sticky" icon control	ldy #Ctl.value	lda [CtlPtr],y	bne Hilite*** end 16-Mar-92 Monte Benaresh;Set pen pattern to either the background color or the hilite color.;;; Check if we need to hilite;	ldy #Ctl.Hilite	lda [<CtlPtr],y	and #$00FF	;added 3/16/92 by Monte		;we need this now that ctlValue may		;be non-0	bne Hilite;draw_hilite 	ldy #2	;No hilite for interior	lda #6	;no hilite for text	pha	;text hilite location	bra NoHilite;; Set up hilight color, starts at pos 4 in color table;Hilite		lda #8	;index to text color when hilited	pha	ldy #4	;index to interior color;;Set up text color.  Index is on top of the stack;NoHilite		lda [<ctlParam],y	; get the color and shift it thru all the nibbles	and #$00F0	; mask off unneeded bits	pha	; save it on the stack for a sec...	xba	; put nibble 0 into nibble 2	ora 1,s	; we now have $x0x0	sta 1,s	; resave it on the stack	lsr a	; convert the number to $0x0x	lsr a	lsr a	lsr a	; we now have $0x0x	ora 1,s	; create $xxxx	sta 1,s	; resave it on the stack as our param (bgColor)...; Now push it on the stack 15 more times to create a pattern	ldy #14@loopOn	pha	dey	bpl @loopOn	tsc	; now get the stack pointer	inc a	; increment it	pea 0000	; push the address of thepattern on the stack	pha	_SetPenPat	;color to draw box in; now pull the pattern off the stack...	tsc	clc	adc #32	tcs	ply	lda [<ctlParam],y	tax	; save this value for a second; modify to use full colors...; by smearing the nibble across the whole word	and #$000F	; <a>=$000x	pha	; save it on the stack for a sec...	xba	; a=$0x00	ora 1,s	; recover the value (a=$0x0x)	sta 1,s	; resave it in our temp	asl a	; now rotate to create $x0x0	asl a	asl a	asl a	; a=$x0x0	ora 1,s	; a=$xxxx (we have filled the word with the color)	sta 1,s	; resave it on the stack as our param (fgColor)...	txa	; recover the color table word...	and #$00F0	; mask off unneeded bits	pha	; save it on the stack for a sec...	xba	; put nibble 0 into nibble 2	ora 1,s	; we now have $x0x0	sta 1,s	; resave it on the stack	lsr a	; convert the number to $0x0x	lsr a	lsr a	lsr a	; we now have $0x0x	ora 1,s	; create $xxxx	sta 1,s	; resave it on the stack as our param (bgColor)...	_SetBackColor	_SetForeColor	;; Now determine type of rect to draw;;; Bits 0 and 1 of flag determine button type:; 11 => Single-outlined, square-cornered, and drop-shadowed button; 10 => Single-outlined, square-cornered button; 01 => Bold-outlined, round-cornered button; 00 => Single-outlined, round-cornered button	pushlong <BoundsTemp	ldy #Ctl.Flag	lda [<CtlPtr],y	;find type to draw	and #$0002	bne RegularRect;; Here we fill the round cornered rect. ;	ldx #26	lda <mode	bne storeit1	ldx #13storeit1	phx	pea 8	_PaintRRect	bra PaintDone	RegularRect		_PaintRect	PaintDone;;---- Draw the Icon ----------------------------------------;	;;First push pointer to icon.;		pei <IconTemp+2	pei <IconTemp;;Now the icon pointer is on top of the stack. ;;; Calculate position to draw icon.  All coordinates are local to the window.; The x-position for 640 mode is ctrlbound.left + .5*(ctrlwidth - iconwidth*2); The x-position for 3240 mode is ctrlbound.left + .5*(ctrlwidth - iconwidth); Here we use ReturnValue for temporary storage of height and width;	ldy #Ctl.DisplayMode	lda [<CtlPtr],y	pha	;displayMode	;; Check if we need to invert;*** added 16-Mar-92 Monte Benaresh***	Check if we're currently "selected", which is***	possible for a "sticky" icon control	ldy #Ctl.value	lda [CtlPtr],y	bne invert_icon*** end 16-Mar-92 Monte Benaresh	ldy #Ctl.Hilite	lda [<CtlPtr],y	and #$00FF	;added 3/16/92 by Monte		;we need this now that ctlValue may		;be non-0	beq DontInvertIcon	;don't invertinvert_icon	lda #1	eor 1,s	;bit 1 of displayMode tells whether or not	sta 1,s	;to invert image.	DontInvertIcon	ldy #CTL.rect.x2 	lda [<CtlPtr],y	;right side of ctrlbounds	ldy #CTL.rect.x1	sec	sbc [<CtlPtr],y	;this gives Ctrlwidth	sbc iWidth	;icon width	cmp #$8000	;set carry to perform arithmetic shift right	ror a	;*.5	clc	adc [<CtlPtr],y	;left side of ctrlbounds		bpl StoreXPos	lda #0StoreXPos	and #$FFFE	;put on even boundry to preserve icon color	pha	;x-pos to draw at	; The y-position is ctrlbound.top + .5*(ctrlheight - iconheight - textheight)	ldy #CTL.rect.y2	lda [<CtlPtr],y	;bottom of ctrlbounds	sec	ldy #CTL.rect.y1	sbc [<CtlPtr],y	;this gives us ctrlheight	sbc iHeight	;iconheight	sbc ascent	sbc descent	sbc leading	;textheight from fontInfo Record		cmp #$8000	ror a	;*.5	clc	adc [<CtlPtr],y	;top of ctrlbounds	bpl StoreYPos	lda #0StoreYPos	pha	;y-pos to draw at	_DrawIcon;;Draw the text.  The foreground and background colors have been set up.; First decide whether or not there is text to draw;	lda ascent	ora descent	ora leading	bne @skip	brl NoText@skip;	;Determine where to draw the text.;		ldy #CTL.rect.x2	lda [<CtlPtr],y	ldy #CTL.rect.x1	sec	sbc [<CtlPtr],y	;now have cntrl width	sbc SWidth	;subtract width of string	cmp #$8000	ror a	;/2	clc	adc [<CtlPtr],y	pha;	;Calculate vertical position;	ldy #CTL.rect.y2	lda [<CtlPtr],y	sec	ldy #CTL.rect.y1	sbc [<CtlPtr],y	sbc ascent	sbc descent	sbc leading	sbc iHeight	;Icon height	cmp #$8000	ror a	;only half of blank space	clc	adc [<CtlPtr],y	adc iheight	adc ascent	adc descent	adc leading	bpl VDone	lda [<CtlPtr],y	VDone	pha	_MoveTo	pha	; save original pen mode	_GetTextMode	pha	_getFontFlags	pea 4	_SetFontFlags	lda #0	; set pen mode to copy	pha	_SetTextMode	jsr GetTitlePtr	; !! Destroys IconTemp !!	pha	phx	_DrawString	_setFontFlags	_SetTextMode	; restore original pen modeNoText;; If control is dimmed, set the pen to a dimmed pattern;	ldy #Ctl.Hilite	;Is the control active?	lda [<CtlPtr],y	and #$00FF	cmp #$00FF	bne normal;; dim the control;	pea penmask>>16	;space to save pen mask	pea penmask	_GetPenMask		pea dimmed>>16	;Set pen to dim mask.	pea dimmed	_SetPenMask	pushlong <BoundsTemp	_EraseRect		pea penmask>>16	;space to save pen mask	pea penmask	_SetPenMasknormal;; Setup outline color which starts @ position 0 in color table;DoBorder		ldy #Ctl.Flag	;see if we want a border	lda [<CtlPtr],y	;bit 2=1 means no border	and #$04	;save bit 2	beq DoBorder1	brl BorderDoneDoBorder1	lda [<ctlParam]	; get the color and shift it thru all the nibbles	and #$00F0	; mask off unneeded bits	pha	; save it on the stack for a sec...	xba	; put nibble 0 into nibble 2	ora 1,s	; we now have $x0x0	sta 1,s	; resave it on the stack	lsr a	; convert the number to $0x0x	lsr a	lsr a	lsr a	; we now have $0x0x	ora 1,s	; create $xxxx	sta 1,s	; resave it on the stack as our param (bgColor)...; Now push it on the stack 15 more times to create a pattern	ldy #14@loopOn	pha	dey	bpl @loopOn	tsc	; now get the stack pointer	inc a	; increment it	pea 0000	; push the address of thepattern on the stack	pha	_SetPenPat	;color to draw box in; now pull the pattern off the stack...	tsc	clc	adc #32	tcs;; --- Draw the button border ---------------------------------------------;	ldx #3	lda <mode	bne In640	ldx #2In640	phx	pea 1	_SetPenSize;;Round rect or regular rect?  Bit 1 of ctl.flag tells us.  1 => round cornered rect.;	ldy #Ctl.Flag	lda [<CtlPtr],y;; Draw relevent border;		and #$0003	;save only bits 0 and 1	pha	;save flag	lsr a	;put outline width in carry	lsr a	bcs DoRegularOutline; ; Draw Round cornered rect border;		pushlong <BoundsTemp		ldx #26	lda <mode	bne storeit2	ldx #13storeit2	phx	pea 8	_FrameRRect	; regular or bold outline?	pla	;get flag	lsr a	bcs  BoldOutline	brl BorderDone	;Do bold outlined buttonBoldOutline	pushlong <BoundsTemp	ldx #$FFFC	lda <mode	bne storeit3	ldx #$FFFDstoreit3	phx	pea $FFFE	_InsetRect		pushlong <BoundsTemp	ldx #36	lda <mode	bne storeit4	; we're in 640	ldx #18	; we're in 320storeit4	phx	pea 12	_FrameRRect			pushlong <BoundsTemp	ldx #4	lda <mode	bne storeit5	ldx #3storeit5	phx	pea 2	_InsetRect	bra BorderDone;; Draw Regular Rect Border;DoRegularOutline	PushLong <BoundsTemp	_FrameRect	pla	;get flag	lsr a		bcc BorderDone	; Do drop-shadowed button	ldy #Rectangle.x2	lda [<BoundsTemp],y	tax	;final point x-cor	phx	ldy #Rectangle.y1	lda [<BoundsTemp],y	inc a	;final point y-cor	inc a	pha	phx	;set second point x-cor	ldy #Rectangle.y2	lda [<BoundsTemp],y	tax	phx	;second point y-cor		ldy #Rectangle.x1	;first point x-cor	lda [<BoundsTemp],y	clc	adc #4	;slight horizontal offset		pha	phx	;first point-y-cor		ldx #3	;width, height	lda <mode	bne in640Mode1	ldx #2in640Mode1	phx	pea 1	;pen size for horizontal line across bottom	_SetPenSize	_MoveTo	_LineTo		_LineTo	; right sideBorderDone	jsr UnlockIcon	jsr UnlockTitle	jsr UnlockColor;; put the control rect back to its orinal size;	pushlong <BoundsTemp	ldx #$FFFC	lda <mode	bne in640Mode2	ldx #$FFFDin640Mode2	phx	pea $FFFE	_InsetRect	;	; Set pen to its original state;	pushlong #OrigPenState	_SetPenState	;; 6/9/89 Mensch; Insert fix here to preserve the pen forground and background colors	lda >OrigFGColor	pha	_SetForeColor	lda >OrigBGColor	pha	_SetBackColor	rts;; Temporary data storage used by the draw routine;FontInfoRecascent	ds.w 1descent	ds.w 1widMax	ds.w 1leading	ds.w 1SWidth	ds.w 1iWidth	ds.w 1iHeight	ds.w 1origFGColor	ds.W 1origBGColor	ds.W 1OrigPenState	ds.b $32dimmed	DC.B $55,$AA,$55,$AA,$55,$AA,$55,$AA 	;Dithered mask for pen.PenMask	ds.b 8	ENDP	**********************************************************************	EXPORT testCtltestCtl	PROC;; Since we shrink the control rect, we only test for a hit in the interior; region.;*** added 29-Nov-90 DAL*** If bit 3 is set in the flags, then don't respond to clicks	ldy #Ctl.Flag	lda [<CtlPtr],y	eor #$0008	;flip the bit so I can "beq" with a 0 to exit w/ A=0	and #$0008	beq TestDone*** end of 29-Nov-90 DAL	lda <CtlPtr	;create pointer to cntrl bounds	clc	adc #8	tax	lda <CtlPtr+2	adc #0	sta <BoundsTemp+2	;temp storage:  keep cntrl bounds ptr	stx <BoundsTemp	pushlong <BoundsTemp	pea 4	pea 2	_InsetRect	pha	;space for result	pushZptr <ctlParam	pushlong <BoundsTemp	_PtInRect		pushlong <BoundsTemp	;put rect back.	pea $FFFC	pea $FFFE	_InsetRect		pla	;result of ptInRect	beq TestDone	lda #14	;icon part codeTestDone	rts	ENDP***********************************************************************	EXPORT initCtlinitCtl	PROC** For the new control types, param contains a pointer to the control template.* Here we copy the template information into the Ctl Record.* CTLIconTemp	RECORD 0	;icon templatepCount	ds.w 1	;valid values 7..12ID	ds.l 1Rect	ds RectangleProcRef	ds.l 1Flag	ds.w 1MoreFlags	ds.w 1RefCon	ds.l 1IconRef	ds.l 1TitleRef	ds.l 1	;optional title ColorTableRef	ds.l 1	;optional Color Table DisplayMode	ds.w 1	;optional displayModekey1	ds.b 1	;optional key equivalent informationkey2	ds.b 1mods	ds.w 1ModsCharBits	ds.w 1InitVal	ds.w 1	;initial value for "sticky" icon control		;added 3/17/92 by Monte Benaresh	ENDR*** added 16-Mar-92 Monte Benaresh:***	Now check for "sticky" icon button and set***	ctlAction to -1 and ctlValue from template if so	ldy #CTLIconTemp.flag	lda [ctlParam],y	and #$0010	;bit 4 set --> sticky icons	beq @not_sticky@is_sticky	ldy #Ctl.action	lda #$FFFF	sta [ctlPtr],y	;set to -1	iny	iny	sta [ctlPtr],y@not_sticky*** end 16-Mar-92 Monte Benaresh 	ldy #CTLIconTemp.pcount	lda [<ctlParam],y		;get pCount	cmp #9	bcc DefaultColors		;8 or fewer parametersCopyColorsAsIs	ldy #CTLIconTemp.ColorTableRef+2	lda [<ctlParam],y	pha	ldy #CTLIconTemp.ColorTableRef	lda [<ctlParam],y	pha	ora 1,s	bne SetColor	pla	plaDefaultColors;; Here we put the pointer to the default color table in the control record.;  We also zero bits 2 and 3 of moreflags to indicate that it is a pointer;	pea 0	pea 0; was this;	pushLong #DefaultColorTable; but now, we no longer do that cause a zero means to use the default every time 	ldy #CTLIconTemp.MoreFlags	lda [<CtlParam],y	and #$FFF3	;reset bits 2 and 3	sta [<CtlParam],y	SetColor	ldy #Ctl.Color	pla	sta [<ctlPtr],y	ldy #Ctl.Color+2	pla	sta [<ctlPtr],y;; Move MoreFlags, IconRef, TitleRef into control record; 	ldy #CTLIconTemp.MoreFlags	lda [<CtlParam],y	ldy #CTl.MoreFlags	sta [<ctlPtr],y			ldy #CtlIconTemp.IconRef+2	lda [<ctlParam],y	ldy #Ctl.IconRef+2	sta [<ctlPtr],y	ldy #CtlIconTemp.IconRef	lda [<ctlParam],y	ldy #Ctl.IconRef	sta [<ctlPtr],y	;set IconRef	ldy #CTLIconTemp.pcount	lda [<ctlParam],y		;get pCount	cmp #8	;title ref	bcs DoTitle	;8 or more parameters	lda #0	pha	pha	bra SetTitleDoTitle		ldy #CtlIconTemp.TitleRef+2	lda [<ctlParam],y	pha	ldy #CtlIconTemp.TitleRef	lda [<ctlParam],y	phaSetTitle	ldy #Ctl.Data	pla	sta [<ctlPtr],y	ldy #Ctl.Data+2	pla	sta [<ctlPtr],y;; Here we set the icon display mode word.  This is later passed to the  _drawicon call;  	ldy #CTLIconTemp.pcount	lda [<ctlParam],y		;get pCount	cmp #10	bcc DefaultDisplayMode	;9 or fewer parameters	ldy #CtlIconTemp.DisplayMode	lda [<ctlParam],y	bra SetDisplayModeDefaultDisplayMode		lda #0SetDisplayMode	ldy #Ctl.DisplayMode	sta [<ctlPtr],y 	lda [<ctlParam]		;get pCount	cmp #11	bcc DefaultKeyEquiv;; Store away the key equiv data.  Start with the ctlKeyMods;		ldy #CTLIconTemp.Mods	lda [ctlparam],y		; read the mods	tyx		; save y into x	ldy #Ctl.ctlKeyMods		; store away the mods	sta [ctlPtr],y	txy		; get y back from x	iny		; bump twice for care bits	iny	lda [ctlparam],y		; read care bits	ldy #Ctl.ctlKeyModsCareBits	; write into control record	sta [ctlPtr],y	txy		; get y back from x again	dey		; dec twice	dey	lda [ctlparam],y		; read in key1 and key2	ldy #Ctl.ctlKey1		; put into control record.	sta [ctlPtr],y	bra keyDone		;changed 3/17/92 by MonteDefaultKeyEquiv	lda #0	ldy #Ctl.ctlKeyMods		; store away the mods	sta [ctlPtr],y	ldy #Ctl.ctlKeyModsCareBits	; write into control record	sta [ctlPtr],y	ldy #Ctl.ctlKey1		; put into control record.	sta [ctlPtr],ykeyDone*** added 17-Mar-92 Monte Benaresh***	support for inital value parameter for "sticky" icon***	control: 0 --> not selected***	         1 --> selected	lda [ctlParam]		;get pcount	cmp #12	bcc @default_value		;no init value, use default@get_init	ldy #CTLIconTemp.InitVal	lda [ctlParam],y		;initial value in template	bra @store_val@default_value	lda #$0000		;for now, set value to 0@store_val	ldy #Ctl.value	sta [ctlPtr],y*** end 17-Mar-92 Monte BenareshInitDone	rts	export DefaultColorTableDefaultColorTable	dc.w $0000	;black for outline	dc.w $00F0	;white when not hilited	dc.w $0000	;black when hilited	dc.w $00F0	;text color	dc.w $000F	;text color when hilited		ENDP	***********************************************************************	EXPORT UnlockColorUnlockColor	PROC** Unlocks the last item the following routine (GetColorPtr, GetIconPtr, or* GetTitlePtr) locked.*;; If it was a handle or resource ID we need to unlock it.  ;	pha	;space for result	pei <theControlHandle+2	pei <theControlHandle	_GetCtlMoreFlags	pla	and #$000C	lsr a	tax;; put color reference on stack;	ldy #CTL.Color+2	lda [<ctlPtr],y	pha	dey	dey	lda [<ctlPtr],y	pha	jmp (ColorTypeTable,x)ColorTypeTable	dc.w DoPointer	dc.w DoHandle	dc.w DoColorResourceDoPointer	pla	pla	rtsDoColorResource	plx	;get lsw	ply	;get msw	pha	;space for result	pha		pea $800D	;ColorTable resource type	phy	;msw of resource ID	phx	;lsw of resource ID	_LoadResource;	; It's a handle;DoHandle	pla	sta <IconTemp	pla	sta <IconTemp+2;; UnLock it;	ldy #4	lda [<IconTemp],y	and #$7FFF	sta [<IconTemp],y	rts	ENTRY UnlockIconUnlockIcon;; If it was a handle or resource ID we need to unlock it.  ;	pha	;space for result	pei <theControlHandle+2	pei <theControlHandle	_GetCtlMoreFlags	pla	and #$0030	lsr a	lsr a	lsr a	;convert to table index	tax;; put icon reference on stack;	ldy #CTL.IconRef+2	lda [<ctlPtr],y	pha	ldy #CTL.IconRef	lda [<ctlPtr],y	pha	jmp (IconTypeTable,x)	IconTypeTable	dc.w DoPointer	dc.w DoHandle	dc.w DoIconResource	DoIconResource	plx	;get lsw	ply	;get msw	pha	;space for result	pha		pea $8001	;ColorTable resource type	phy	;msw of resource ID	phx	;lsw of resource ID	_LoadResource	brl DoHandle		ENTRY UnlockTitleUnlockTitle;;put title ref on stack;	pha	;space for result	pha	pei <theControlHandle+2	pei <theControlHandle	_GetCtlTitle	lda 1,s	ora 3,s	bne DoTitleJump	pla	;no title: return a and x as zero	plx	rts*** Moved label 10-Dec-91 DAL -- Ouch-o-Rama!  DoTitleJump was down below*** by accident, and it only worked because GetCtlTitle, above, was always*** leaving 4 in the X register (because it cleaned 4 bytes of input parms*** off the stack).  This always made us jump to DoTitleResource, where we*** would interpret a Pointer or Handle title as an rPString resource ID.*** If no such resource was availbable, it unlocked the NIL handle (turned*** off bit 7 of byte $00/0005).  In the unlikely case that there actually*** was an rPString resource with the right ID, it would unlock it.DoTitleJump*** end 10-Dec-91 	pha	;space for result	pei <theControlHandle+2	pei <theControlHandle	_GetCtlMoreFlags		pla	and #3	asl a	tax;;;This label has been in the wrong place, maybe forever!  10-Dec-91 DAL;;;DoTitleJump	jmp (TitleTypeTable,x)	TitleTypeTable	dc.w DoPointer	dc.w DoHandle	dc.w DoTitleResource;; It's a Resource;DoTitleResource	plx	;get lsw	ply	;get msw	pha	;space for result	pha		pea $8006	;Title must be a P-string.	phy	;msw of resource ID	phx	;lsw of resource ID	_LoadResource	brl DoHandle	ENDP	***********************************************************************	EXPORT GetColorPtrGetColorPtr	PROC** Routine returns a pointer to the color table in the x (low word) and * a (high word) registers.  If it is a handle or resourceID we load it,* lock it, and pass back the pointer.*	import DefaultColorTable;; We need to find out if the ColorRef is a pointer, handle, resource, or offset.;; Bits 2 and 3 of MoreFlags indicate what ColorRef is:;	0	Pointer;	1	Handle;	2	resource;DoColors	pha	;space for result	pei <theControlHandle+2	pei <theControlHandle	_GetCtlMoreFlags	pla	and #$000C	lsr a	tax;; put color reference on stack;	ldy #CTL.Color+2	lda [<ctlPtr],y	pha	ldy #CTL.Color	lda [<ctlPtr],y	pha	jmp (ColorTypeTable,x)	ColorTypeTable	dc.w DoPointer	dc.w DoHandle	dc.w DoColorResource;	;Color table is a pointer.  Move it to the control record;DoPointer	bra SetColor;; It's a Resource;DoColorResource	plx	;get lsw	ply	;get msw	pha	;space for result	pha		pea $800D	;ColorTable resource type	phy	;msw of resource ID	phx	;lsw of resource ID	_LoadResource;	; It's a handle;DoHandle	pla	sta <IconTemp	pla	sta <IconTemp+2;; Lock it;	ldy #4	lda [<IconTemp],y	ora #$8000	sta [<IconTemp],y		ldy #2	lda [<IconTemp],y		;get high word of pointer	pha	lda [<IconTemp]	pha	SetColor; fix this for the default color table cause this was wrong before...	clc	plx	pla	bne @NotZero	cpx #0	bne @NotZero	ldx #<DefaultColorTable	lda #^DefaultColorTable@NotZero	rts	**********************************************************************	ENTRY GetIconPtrGetIconPtr** Routine returns a pointer to the icon in the x (low word) and * a (high word) registers.  If it is a handle or resourceID we load it,* lock it, and pass back the pointer.*;; We need to find out if the IconRef is a pointer, handle, resource, or offset.;; Bits 4 and 5 of MoreFlags indicate what IconRef is:;	0	Pointer;	1	Handle;	2	resource;	3	Offset;DoIcon 	pha	;space for result	pei <theControlHandle+2	pei <theControlHandle	_GetCtlMoreFlags	pla	and #$0030	lsr a	lsr a	lsr a	;convert to table index	tax;; Put IconRef on stack;	ldy #Ctl.IconRef+2	lda [<ctlPtr],y	pha	ldy #Ctl.IconRef	lda [<ctlPtr],y	pha	jmp (IconTypeTable,x)	IconTypeTable	dc.w DoPointer	dc.w DoHandle	dc.w DoIconResource;; It's a Resource;DoIconResource	plx	;get lsw	ply	;get msw	pha	;space for result	pha		pea $8001	;rIcon resource type	phy	;msw of resource ID	phx	;lsw of resource ID	_LoadResource	jmp DoHandle	**********************************************************************	ENTRY GetTitlePtrGetTitlePtr** Routine returns a pointer to the controls title in the x (low word) and * a (high word) registers.  If it is a handle or resourceID we load it,* lock it, and pass back the pointer.  If there is no title, a and x * both contain zero.*	;; We need to find out if the title is a pointer, handle, resource, or offset.;; Bits 0 and 1 of MoreFlags indicate what TitleRef is:;	0	Pointer;	1	Handle;	2	resource;	3	Offset;;put title ref on stack;	pha	;space for result	pha	pei <theControlHandle+2	pei <theControlHandle	_GetCtlTitle	lda 1,s	ora 3,s	bne DoTitleJump	pla	;no title: return a and x as zero	plx	rts	DoTitleJump 	pha	;space for result	pei <theControlHandle+2	pei <theControlHandle	_GetCtlMoreFlags		pla	and #3	asl a	tax	jmp (TitleTypeTable,x)	TitleTypeTable	dc.w DoPointer	dc.w DoHandle	dc.w DoTitleResource;; It's a Resource;DoTitleResource	plx	;get lsw	ply	;get msw	pha	;space for result	pha		pea $8006	;Title must be a P-string.	phy	;msw of resource ID	phx	;lsw of resource ID	_LoadResource	jmp DoHandle	ENDP	**********************************************************************	EXPORT recSizerecSize	PROC	ldx #0	lda #IconRecSize	rts	ENDP		**********************************************************************	EXPORT dispCtldispCtl	PROC	lda #0	tax	rts	ENDP**********************************************************************	EXPORT Ret_NullRet_Null	PROC	lda #0	tax	rts	ENDP		**********************************************************************	EXPORT ctlHandleEventctlHandleEvent	PROC 	ldy #Ctl.Hilite	lda [<ctlPtr],y	and #$00FF	cmp #$00FF	beq DontWantIt	ldy #oWhat	lda [ctlParam],y	cmp #keyDownEvt	beq TryThisOne	cmp #autoKeyEvt	bne DontWantItTryThisOne;; Start with the modifiers.;	ldy #oModifiers		; Look at the high byte	lda [ctlParam],y		; of the modifiers	and #$FF00	ldy #Ctl.ctlKeyModsCareBits	; and with the care bits	and [ctlPtr],y	dey		; compare with the desired mods	dey	cmp [ctlPtr],y	bne DontWantIt;; If we get to here, then the mods matched.  So look at the key.;	dey	dey	lda [ctlPtr],y	tax	and #$00FF		; first look at key1	ldy #oMessage	cmp [ctlParam],y	beq WantIt	txa		; now try key2	xba	and #$00FF	cmp [ctlParam],y	bne DontWantItWantIt	PushWord #14	;icon part code	pei theControlHandle+2	pei theControlHandle	_HiliteControl*** added 18-Jun-92 -- Make Monte's Sticky bit work for key equivs.  Don't unhilite.	ldy #Ctl.flag	lda [CtlPtr],y	and #$0010	;are we a "sticky" icon?	beq @not_sticky	;oops, said is_sticky (15-Jul-92 DAL)	lda #1	;value for "selected"	ldy #Ctl.value	sta [CtlPtr],y	;set in record	ldy #Ctl.Hilite	lda [CtlPtr],y	and #$FF00	;clear low (hilite) byte	sta [CtlPtr],y	bra @is_sticky*** end 18-Jun-92@not_sticky	PushWord #0	pei theControlHandle+2	pei theControlHandle	_HiliteControl@is_sticky	lda #$FFFF	;Return true for having handled event	tax	rtsDontWantIt	lda #0	;Return False, don't want event.	tax		rts	ENDP	END