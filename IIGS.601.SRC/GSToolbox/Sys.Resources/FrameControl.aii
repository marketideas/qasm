;---------------------------------------------------------------------;;  file  CustomFrameCtl.a;;  This file contains assembly routines for GrayFrameCtl description;;  created:	13-Dec-89;  modified:	See Mod History Below;  Authors:	Xavier Schott, Dave Lyons;;  Copyright (C) Apple Computer, Inc. 1989-1991;  All Rights Reserved.;;---------------------------------------------------------------------;;  Modification History;;  13-Dec-89	XAS	Created;  10-Jan-90	ADS	Adding "testCtl" handler, so we can call "FindControl";			on these frames.  If the control is not inactive,;			we return a part code of 32.;  18-Jan-90	XAS	Changing the colorFlag and introducing 'invisibleColor', so;			non-visible rectangles can be active and return a part.;  15-Feb-91	DAL	Added this code to Sys.Resources (ID=07ff0003).  This will;			always be used as an extended control.;  16-Feb-91	DAL	Adding new optional parameters in the template: pen;			size, pen mask, pen pattern.  No longer derefs control;			handleon the recSize message.;			Now preserves the pen state completely.;  24-Feb-91	DAL	Changed the pen state buffer to be 50 bytes, not 46.;;---------------------------------------------------------------------		INCLUDE	'new.stack.macros'		include 'all.macros'PartCode	EQU	31	; the part code we use - from the System rangedrawCtl		EQU	$0000	; DefProc - Draw control command.testCtl		EQU	$0002	; DefProc - Test for hit commandinitCtl		EQU	$0003	; Defproc - Initialize command.posCtl		EQU	$0005	; DefProc - Move indicator command.thumbCtl	EQU	$0006	; DefProc - Compute drag parameters command.recSize		EQU	$000C	; DefProc - Return record size command.ctlInVis	EQU	$0080	; CtlFlag - invisible mask for any type of control defaultHeight	equ 1		;default heightdefaultWidth	equ 2		;default width in 640 mode (half in 320);---------------------------------------------------------------------;;  FUNCTION  FrameCtl(	ctlMessage: INTEGER; ctlParam: LongInt;;			ctlHandle: CtlRecHndl): LongInt;;;  Control Definition Procedure for a custom FrameRect control;  ¥ Use it to add Gray or black rectangles,;;                    +-------------------+;                    l                   l;                    l                   l;                    +-------------------+;;  ¥ opened rectangles (to include one or more items in a box, with a title);  (Just be sure that the title text gets drawn after the box.  If it's a control,;  that means the text has to be created *before* the box, since controls are;  drawn in the opposite order than how they were created.);;                    +---- Box Title ----+;                    l                   l;                    l                   l;                    +-------------------+;;  ¥ Vertical or horizontal lines ( just make the rectangle width of height;  small enough) to hilite or separate items;;       l;       l       and  ---------------------;       l;;  ¥ Invisible key areas in a dialog. Make the control active & visible, but set its;  color to transparent (0).;;  Draw either in black or in gray. Resets penPat to black and PenSize to (2, 1);  INPUTS/OUTPUTS standard ctlProc inputs defined page 4-25 of Apple IIGS toolBox reference;; NOTE:		Template format; itemxx	pCount		dc.w	6 or 8 or 9 or 10; 1	+002	ID		dc.l	xx; 2	+006	Rect		dc.w	0, 0, 0+1, 0+1; 3	+014	ProcRef		dc.l	FrameCtl; 4	+018	Flag		dc.w	0		; Bits 0-1: 0=InvisColor  1=Gray  2=Black  3=reserved; 5	+020	MoreFlags	dc.w	0		; ignored; 6	+022	RefCon		dc.l	0;		--- custom fields in the template; 7	+026	PenHeight	dc.w	0; 8	+028	PenWidth	dc.w	0; 9	+030	PenMask		8 bytes; 10	+030	PenPattern	32 bytes;oTmplHeight	equ 26oTmplWidth	equ 28oTmplPenMask	equ 30oTmplPattern	equ 38;; offset constants for CtlRec;octlNext	equ 0octlOwner	equ 4octlRect	equ 8octlFlag	equ 16octlHilite	equ 17octlValue	equ 18octlProc	equ 20octlAction	equ 24octlData	equ 28octlRefCon	equ 32octlColor	equ 36octlReserved	equ 40octlID		equ 56octlMoreFlags	equ 60octlVersion	equ 62;--- custom fields in the Frame Control RecordoctlHeight	equ 64octlWidth	equ 66octlPenMask	equ 68	;8 bytesoctlPattern	equ 76octlRecSize	equ octlPattern+32;---------------------------------------------------------------------;; Control Defproc;FrameCtl	FUNC	EXPORT		InitFrame		FrameType	SaveB		; because it's a toolBox callBackctlPtr		Local	PtrctlHandle	Param	HandlectlParam	Param	LongIntctlMessage	Param	INTEGERtheResult	Result	LongInt		EntryCode; initialize exitResult to nil; dispatch the ctlMessage		stz <theResult		; default return values = 0		stz <theResult+2		phb		phk		plb				; so we can make absolute adressing		lda <ctlMessage		cmp #recSize		; return record size		bne @notCtlSize		lda #octlRecSize		sta <theResult		brl mainExit@notCtlSize;  For every message except recSize, deref the control handle		ldy #2			; deref to get ctl Record		lda [<ctlHandle]		sta <ctlPtr		lda [<ctlHandle],y		sta <ctlPtr+2;  start dispatching the control message		lda <ctlMessage		cmp #initCtl		bne @notInit		jsr InitControl		brl MainExit@notInit	cmp #drawCtl		bne TryTestCtl		jsr PreservePen; draw control, the real stuff; ctlMessage contains the drawCtl code. But before drawing, check that the control; is visible first		ldy #octlFlag		; is control visible ?		lda [<ctlPtr],y		tax		and #ctlInVis		bne jumptoexit		; bit set, not visible; Here we are: the control is visible.; The visual appearance of the rectangle depends on the bits 0 & 1 of ctlFlag; We now change the pen pattern, change the pen size, frame the controlRect,; restore the black pattern, and exit with theResult of nil		txa			; octlFlag still in Xreg		and #$0003		beq jumpToExit		; invisible pattern		clc		lda #octlPattern		adc <ctlPtr		tax		lda <ctlPtr+2		adc #0		pha		phx		_SetPenPat		clc		lda #octlPenMask		adc <ctlPtr		tax		lda <ctlPtr+2		adc #0		pha		phx		_SetPenMask		ldy #octlWidth		lda [<ctlPtr],y		pha		dey		dey		lda [<ctlPtr],y		pha		_SetPenSize		clc				; FrameRect( ctlRect)		lda <ctlptr		adc #octlRect		tax		lda <ctlPtr+2		adc #0		pha		phx		_FrameRect		jsr RestorePenjumptoexit	bra mainExit;------------------------------------------------------------;  TestCtl;;  Returns partID #32 if (1) pt in rect (2) ctl is active;------------------------------------------------------------TryTestCtl	equ	*		cmp	#testCtl		bne	moreCodes				stz	<theResult		; assume no hit				ldy	#oCtlHilite		; are we active?		lda	[<ctlPtr],y		and	#$FF		cmp	#$FF		beq	mainExit		; inactive.  don't return hits.				phy				; call PtInRect		tdc		clc		adc	#ctlParam		; push @ hitPoint		pea	0		pha		lda	<ctlPtr			; push @ ctl Rect		ldx	<ctlPtr+2		clc		adc	#oCtlRect		bcc	@1		inx@1		phx		pha		_PtInRect		pla		beq	mainExit		; not in rect				lda	#PartCode		; hit - return our part code		sta	<theResult		bra	mainExit		;------------------------------------------------------------;; ctlMessage did not contain any interesting code.;; Return correct values anyway, sometimes nil, sometimes one.;moreCodes	cmp #posCtl			; return non zero		beq exitNonZero		cmp #thumbCtl		beq exitNonZero		bra mainExitexitNonZero	inc <theResult		; non zero return valuemainExit	plb				; restore data bank		ExitCode** InitControl** Copy the nonstandard fields from the control template* to the control record, supplying defaults for any parameters* that are omitted from the template.** CtlPtr points to the control record.  ctlParam points to* the template.*InitControl	ldy #octlHeight		lda #defaultHeight		sta [<ctlPtr],y		iny		iny		lda #defaultWidth		sta [<ctlPtr],y		ldy #octlFlag		lda [<ctlPtr],y		and #3			;00=invisible, 01=gray, 10=black, 11=reserved		ldx #$3333		;anticipate gray		cmp #1		beq @fillPattern		ldx #$0000@fillPattern	txa		ldx #16			;16 words		ldy #octlPattern@fill		sta [<ctlPtr],y		iny		iny		dex		bne @fill		ldy #octlPenMask		lda #$ffff		;solid mask default		ldx #4			;4 words@fillmask	sta [<ctlPtr],y		iny		iny		dex		bne @fillmask** Now override the defaults with template values*		lda [<ctlParam]		;pcount (Is the height/width in the template?)		cmp #8		bcc @done		ldy #oTmplHeight		lda [<ctlParam],y		ldy #octlHeight		sta [<ctlPtr],y		ldy #oTmplWidth		lda [<ctlParam],y		ldy #octlWidth		sta [<ctlPtr],y		lda [<ctlParam]		;pcount (Is the pen mask in the template?)		cmp #9		bcc @done		ldy #oTmplPenMask		lda [<ctlParam],y		ldy #octlPenMask		sta [<ctlPtr],y		ldy #oTmplPenMask+2		lda [<ctlParam],y		ldy #octlPenMask+2		sta [<ctlPtr],y		ldy #oTmplPenMask+4		lda [<ctlParam],y		ldy #octlPenMask+4		sta [<ctlPtr],y		ldy #oTmplPenMask+6		lda [<ctlParam],y		ldy #octlPenMask+6		sta [<ctlPtr],y		lda [<ctlParam]		;pcount (Is the pattern in the template?)		cmp #10		bcc @done		clc		lda <ctlParam		adc #oTmplPattern		tax		lda <ctlparam+2		adc #0		pha		phx		clc		lda <ctlPtr		adc #octlPattern		tax		lda <ctlPtr+2		adc #0		pha		phx		pea 0		pea 32			;32-byte pattern		_BlockMove@done** Cut the width in half if we're in 320*		pha		_GetMasterSCB		pla		and #$0080		bne @640		ldy #octlWidth		lda [<ctlPtr],y		lsr a		sta [<ctlPtr],y@640		rts** PreservePen*PreservePen	pushlong #oldPenState		_GetPenState		rts** RestorePen*RestorePen	pushlong #oldPenState		_SetPenState		rtsoldPenState	ds.b 50		;was 46, 24-Feb-91 DAL		ENDFUNC		END