************************************************************************                      GSTextEdit  Version 1.0*                           File: key.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************DoKeystroke	PROCNAME  Export;---------------------------------------------------------------	_ObscureCursor		;obscure the cursor for typing	jsr  ShrinkInputHandle	;size the input handle down to one byte	jsr  DerefInputHandle	;..then deref it into InputTextPtr	ldy  #EventRecord.message	;copy the character into the input text	shortm		;..handle. make sure we are in SHORT mode	lda  [TheEventPtr],y	;..since the input handle could be just	sta  [InputTextPtr]		;..one character	longm	and  #$00FF		;clear the high byte of the character	ldy  #TERecord.theKeyRecord.theChar	;copy the character into the character	sta  [RecordPtr],y		;..field	ldy  #EventRecord.modifiers	;copy the modifiers into the modifiers	lda  [TheEventPtr],y	;..field	ldy  #TERecord.theKeyRecord.theModifiers	sta  [RecordPtr],y	ldy  #TERecord.KeyFilter+1	;check for a filter routine	lda  [RecordPtr],y	beq  noFilter;---------------------------------------------------------------useFilter	tax		;get the filterProcPtr into A-Reg and	dey		;..X-Reg	lda  [RecordPtr],y	PushZLong RecordHandle	;pass the current record handle	PushWord #1		;this tells the filter to accept a single char	jsl  LongCall		;A-Reg and X-Reg contain the filterProcPtr	ldy  #TERecord.theKeyRecord.theOpCode	;get the operation code to execute, put	lda  [RecordPtr],y		;..it in X-Reg and use as an index into	tax		;..the jump table. Note we never come	jmp  (table,x)		;..back here.;---------------------------------------------------------------noFilter	jsr  DerefInputHandle	;deref the handle back into InputTextPtr	ldy  #TERecord.theKeyRecord.theModifiers	lda  [RecordPtr],y		;get the modifiers into the X-Reg	sta  TheModifierWord	tax	lda  [InputTextPtr]		;get the character into the A-Reg and	and  #$00FF		;..check for the arrow keys first	cmp  #$08	beql doLeftArrow	cmp  #$15	beql doRightArrow	cmp  #$0A	beql doDownArrow	cmp  #$0B	beql doUpArrow	cmp  #$7f		;is it the delete key ?	beql doLeftDelete	txa		;get back the modifiers and check for the	and  #appleKey		;..apple key being down. if so, then exit	bne  ignoreIt	txa		;get back the modifiers and check for the	and  #controlKey		;..control key being down	shortm		;switch to short mode for space reasons	bne  controlDown;---------------------------------------------------------------controlUp	lda  [InputTextPtr]		;get the character into the A-Reg	ldx  #opClear		;check for the CLEAR key	cmp  #$18	beq  doTheJump	ldx  #opReplaceText		;check for an insertable character	cmp  #CR		;Carriage return	beq  doTheJump	cmp  #TAB		;TAB	beq  doTheJump	cmp  #' '		;NOT a unknown control key.	bge  doTheJump;---------------------------------------------------------------ignoreIt	rep  #$20		;switch back to long mode, but still	rts		;..assemble in short mode;---------------------------------------------------------------controlDown	lda  [InputTextPtr]		;put the character in A-Reg for now	ldx  #opCut	cmp  #$18		;is it the cut key (Ctrl-X) ?	beq  doTheJump	ldx  #opCopy	cmp  #$03		;is it the copy key (Ctrl-C) ?	beq  doTheJump	ldx  #opPaste	cmp  #$16		;is it the paste key (Ctrl-V) ?	beq  doTheJump	cmp  #$19		;is it the delete to EOL key (Ctrl-Y) ?	beq  doDeleteEOL	cmp  #$06		;is it the delete right key (Ctrl-F) ?	beq  doRightDelete	cmp  #$04		;is it the Ctrl-D key ?	beq  doLeftDelete	bne  ignoreIt		;..if not, then it is unknown, so ignore it;---------------------------------------------------------------doTheJump	longm		;back to long mode	jmp  (table,x)		;execute the right code from the jump table;---------------------------------------------------------------;---------------------------------------------------------------doDeleteEOL	rep  #$20	jsr  GetTEHighFlags		;check to see if the record is editable	and  #fReadOnly		;..or not	bne  @exit	jsr  GetSelectionStart	jsr  IsOffsetAtEnd	bne  @notAtEnd@exit	rts@notAtEnd	jsr  UnhilightSelection	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	decl TextOffset	jsr  FindTextPtr	lda  [TextPtr]	and  #$00FF	cmp  #CR		;don't remove the ending carriage return	beq  @setIt	incl TextOffset@setIt	jsr  SetSelectionEnd	brl  RemoveText;---------------------------------------------------------------;---------------------------------------------------------------table	dc.w  noFilter		;opNormal	dc.w  ignoreIt		;opNothing	dc.w  doReplaceText		;opReplaceText	dc.w  doMoveSelection	;opMoveCursor	dc.w  doExtendLeft		;opExtendLeft	dc.w  doExtendRight		;opExtendRight	dc.w  CutGuts		;opCut	dc.w  CopyGuts		;opCopy	dc.w  PasteGuts		;opPaste	dc.w  ClearGuts		;opClear;---------------------------------------------------------------	ENDP****************************************************************Key1Proc	PROC;---------------------------------------------------------------	ENTRY  doLeftDelete	ENTRY  doRightDelete;---------------------------------------------------------------;---------------------------------------------------------------doRightDelete	jsr  commonSetup	jsr  IsOffsetAtEnd	beq  atEdge	incl TextOffset		;the end is one more than the start	jsr  SetSelectionEnd	decl TextOffset	bra  doIt;---------------------------------------------------------------doLeftDelete	jsr  commonSetup	lda  TextOffset	ora  TextOffset+2	beq  atEdge	decl TextOffset		;the start is one less than the end	jsr  SetSelectionStart;---------------------------------------------------------------doIt	jsr  FindStyleInfo	pea  $0000	lda  SuperLength+2	bne  @removeIt	lda  SuperLength	dec  a		;quick compare with one. If not one then	bne  @removeIt		;..exit	jsr  SetupStylePtr	ldy  #0	lda  #TERecord.NullStyle	clc	adc  RecordPtr	sta  MemoryPtr	tya	adc  RecordPtr+2	sta  MemoryPtr+2@loop	lda  [TempPtr],y	sta  [MemoryPtr],y	iny	iny	cpy  #TEStyle.RecordSize	blt  @loop	lda  #$FFFF	sta  1,s@removeIt	jsr  RemoveText		;this will hilight the new selection	pla	ldy  #TERecord.NullStyleActive	sta  [RecordPtr],y	rts;---------------------------------------------------------------atEdge	brl  HilightSelection;---------------------------------------------------------------;---------------------------------------------------------------commonSetup	rep  #$20		;turn long mode back on	jsr  GetTEHighFlags		;check to see if the record is editable	and  #fReadOnly		;..or not	bne  @exit	jsr  IsTheSelectionACaret	;if the selection is a caret, unhilight	bne  @notACaret		;..it and return	jsr  UnhilightSelection	brl  GetSelectionStart@notACaret	pla		;remove one return address	brl  RemoveText		;remove the selection@exit	pla	rts;---------------------------------------------------------------	ENDP****************************************************************setupAnchorPoint	PROCNAME  Entry;---------------------------------------------------------------	jsr  IsTheSelectionACaret	;if the selection is NOT a caret, then	bne  @notACaret		;..use the saved anchor point@isACaret	ldy  #TERecord.SelectionStart	;it was a caret, so the saved anchor point	jsr  GetRecordLong		;..is invalid. Get the selection start and	stax AnchorPointStart	;..set the anchor point to that. Also save	ldy  #TERecord.AnchorPoint	;..this in the TERecord	brl  SetRecordLong@notACaret	ldy  #TERecord.AnchorPoint	;use the saved anchor point	jsr  GetRecordLong	stax AnchorPointStart	rts;---------------------------------------------------------------	ENDP****************************************************************moveToACaret	PROCNAME  Entry;---------------------------------------------------------------	ldy  #TERecord.SelectionStart	;check to see if the selection changed	jsr  GetRecordLong		;..if it did, then clear the null style	cmp  TextOffset	bne  @clearNull	cpx  TextOffset+2	bne  @clearNull	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  TextOffset	bne  @clearNull	cpx  TextOffset+2		;if the selection did NOT change, then	beq  @skipClear		;..don't clear the null style@clearNull	jsr  ClearNullStyle@skipClear	jsr  UnhilightSelection	;take the old selection off the screen	jsr  SetSelectionStart	;..set the new one, and put it back on	jsr  SetSelectionEnd	;..the screen	jsr  HilightSelection	ldy  #TERecord.SelectionStart	;scroll to the start of the new selection	brl  ScrollToSelection;---------------------------------------------------------------	ENDP****************************************************************removeTheCaret	PROCNAME  Entry;---------------------------------------------------------------	jsr  GetRecordLong		;Y-Reg tells which end of the selection	cmp  TextOffset		;..to check. If this end didn't change	bne  @1		;..then pull off one return address and	cpx  TextOffset+2		;..exit	bne  @1	pla	rts@1	jsr  IsTheSelectionACaret	;if the selection is not a caret, then	bne  @2		;..it is already on the screen	jsr  UnhilightSelection	;take the caret off the screen, but leave	ldy  #TERecord.SelectionState	;..it marked as ON screen, so when we	lda  #$FFFF		;..extend it, the state is correct	sta  [RecordPtr],y@2	rts;---------------------------------------------------------------	ENDP****************************************************************fixTheCaret	PROCNAME  Entry;---------------------------------------------------------------	phy		;save the Y-Reg (the routine preserves Y-Reg)	jsr  IsTheSelectionACaret	;if the selection is not a caret then we	bne  @exit		;..are OK, so exit	ldy  #TERecord.SelectionState	;the selection is a caret, but not visible	lda  #0		;..so mark it off screen	sta  [RecordPtr],y@exit	ply		;restore the Y-Reg	rts;---------------------------------------------------------------	ENDP****************************************************************decTextOffset	PROCNAME  Entry;---------------------------------------------------------------	lda  TextOffset		;if TextOffset is already zero, then pull	bne  @1		;..one set of return addreses and exit	lda  TextOffset+2	beq  @2	dec  TextOffset+2@1	dec  TextOffset	rts@2	pla	rts;---------------------------------------------------------------	ENDP****************************************************************checkAndSwap	PROCNAME  Entry;---------------------------------------------------------------	phy	jsr  GetSelectionStart	;make sure the end is greater than or	ldy  #TERecord.SelectionEnd	;..equal to the source	jsr  GetRecordLong	cmpl TextOffset	bge  @exit@swapThem	ldy  #TERecord.SelectionStart	;if not, then swap the selection start and	jsr  SetRecordLong		;..end	jsr  SetSelectionEnd	lda  #TERecord.SelectionStart	cmp  1,s	bne  @useA	lda  #TERecord.SelectionEnd@useA	sta  1,s@exit	ply	rts;---------------------------------------------------------------	ENDP****************************************************************doLeftArrow	PROCNAME  Entry;---------------------------------------------------------------	jsr  ClearSavedHPos		;clear the saved horizontal position	lda  TheModifierWord	and  #shiftKey	bne  extendIt;---------------------------------------------------------------noExtend	jsr  GetSelectionStart	jsr  adjustTextOffset	brl  moveToACaret;---------------------------------------------------------------extendIt	jsr  ClearNullStyle		;clear the null style active	jsr  setupAnchorPoint	;setup the anchor point	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @extendIt	cpx  AnchorPointStart+2	bne  @extendIt	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @contractIt	cpx  AnchorPointStart+2	beq  @extendIt@contractIt	jsr  GetSelectionEnd	jsr  adjustTextOffset	ldy  #TERecord.SelectionEnd	jsr  removeTheCaret	jsr  SetSelectionStart	jsr  InvertSelection	jsr  GetSelectionStart	jsr  SetSelectionEnd	ldy  #TERecord.SelectionStart	ldax AnchorPointStart	jsr  SetRecordLong	ldy  #TERecord.SelectionEnd	;checkAndSwap will set Y-Reg to the correct	jsr  checkAndSwap		;..end of the selection to scroll to.	jsr  fixTheCaret		;this routine preserves the Y-Reg	brl  ScrollToSelection@extendIt	jsr  GetSelectionStart	jsr  adjustTextOffset	ldy  #TERecord.SelectionStart	jsr  removeTheCaret	ldy  #TERecord.SelectionEnd	jsr  PushRecordLong	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  SetSelectionStart	jsr  InvertSelection	PullAX	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  fixTheCaret	ldy  #TERecord.SelectionStart	brl  ScrollToSelection;---------------------------------------------------------------;---------------------------------------------------------------adjustTextOffset	lda  TheModifierWord	and  #optionKey	bne  @doLineStart	lda  TheModifierWord	and  #appleKey	bne  @doWordLeft@doCharLeft	jsr  decTextOffset	rts@doWordLeft	jsr  decTextOffset	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcs  @doWordLeft	brl  FindWordStart@doLineStart	lda  TheModifierWord	and  #shiftKey	beq  @1	jsr  FindLineInfo	lda  SuperStart	cmp  TextOffset	bne  @1	lda  SuperStart+2	cmp  TextOffset+2	bne  @1	jsr  decTextOffset@1	brl  FindLineStart;---------------------------------------------------------------	ENDP****************************************************************doRightArrow	PROCNAME  Entry;---------------------------------------------------------------	jsr  ClearSavedHPos		;clear the saved horizontal position	lda  TheModifierWord	and  #shiftKey	bne  extendIt;---------------------------------------------------------------noExtend	jsr  GetSelectionEnd	jsr  adjustTextOffset	brl  moveToACaret;---------------------------------------------------------------extendIt	jsr  ClearNullStyle		;clear the null style active	jsr  setupAnchorPoint	;setup the anchor point	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @extendIt	cpx  AnchorPointStart+2	bne  @extendIt	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @contractIt	cpx  AnchorPointStart+2	beq  @extendIt@contractIt	jsr  GetSelectionStart	jsr  adjustTextOffset	ldy  #TERecord.SelectionStart	jsr  removeTheCaret	jsr  SetSelectionEnd	jsr  InvertSelection	jsr  GetSelectionEnd	jsr  SetSelectionStart	ldax AnchorPointStart	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	ldy  #TERecord.SelectionStart	;checkAndSwap will set Y-Reg to the correct	jsr  checkAndSwap		;..end of the selection to scroll to.	jsr  fixTheCaret		;this routine preserves the Y-Reg	brl  ScrollToSelection@extendIt	jsr  GetSelectionEnd	jsr  adjustTextOffset	ldy  #TERecord.SelectionEnd	jsr  removeTheCaret	ldy  #TERecord.SelectionStart	jsr  PushRecordLong	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	jsr  SetSelectionEnd	jsr  InvertSelection	PullAX	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	jsr  fixTheCaret	ldy  #TERecord.SelectionEnd	brl  ScrollToSelection;---------------------------------------------------------------;---------------------------------------------------------------adjustTextOffset	jsr  IsOffsetAtEnd		;if the offset is already at the end, then	beq  @exit		;..exit	lda  TheModifierWord	and  #optionKey	bne  @doLineEnd	lda  TheModifierWord	and  #appleKey	bne  @doWordRight@doCharRight	incl TextOffset@exit	rts@doWordRight	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcc  @nowMove	incl TextOffset	jsr  IsOffsetAtEnd	bne  @doWordRight	rts@nowMove	incl TextOffset	brl  FindWordEnd@doLineEnd	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	lda  TheModifierWord	and  #shiftKey	bne  @exit	jsr  decTextOffset	jsr  FindTextPtr		;the character at the end should be a word	lda  [TextPtr]		;..wrap. If it is not, then move one	jsr  IsItAWordWrap		;..more character	bcs  @exit	bra  @doCharRight;---------------------------------------------------------------	ENDP****************************************************************doUpArrow	PROCNAME  Entry;---------------------------------------------------------------	lda  TheModifierWord	and  #shiftKey	bne  extendIt;---------------------------------------------------------------noExtend	jsr  GetSelectionStart	ldy  #TERecord.SavedHPos	;set the new saved horizontal position	lda  [RecordPtr],y		;..if there isn't one already	bpl  @useSaved	jsr  FindLineInfo		;find the correct line to start with, then	jsr  OffsetToHPos		;..find the hpos on this line	lda  TextHPos	ldy  #TERecord.SavedHPos	sta  [RecordPtr],y@useSaved	sta  TextHPos	jsr  adjustTextOffset	brl  moveToACaret;---------------------------------------------------------------extendIt	jsr  ClearNullStyle		;clear the null style active	jsr  setupAnchorPoint	;setup the anchor point	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @extendIt	cpx  AnchorPointStart+2	bne  @extendIt	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @contractIt	cpx  AnchorPointStart+2	beq  @extendIt@contractIt	jsr  GetSelectionEnd	ldy  #TERecord.SavedHPos	;set the new saved horizontal position	lda  [RecordPtr],y		;..if there isn't one already	bpl  @useSaved1	jsr  FindLineInfo		;find the correct line to start with, then	jsr  OffsetToHPos		;..find the hpos on this line	lda  TextHPos	ldy  #TERecord.SavedHPos	sta  [RecordPtr],y@useSaved1	sta  TextHPos	jsr  adjustTextOffset	ldy  #TERecord.SelectionEnd	jsr  removeTheCaret	jsr  SetSelectionStart	jsr  InvertSelection	jsr  GetSelectionStart	jsr  SetSelectionEnd	ldy  #TERecord.SelectionStart	ldax AnchorPointStart	jsr  SetRecordLong	ldy  #TERecord.SelectionEnd	;checkAndSwap will set Y-Reg to the correct	jsr  checkAndSwap		;..end of the selection to scroll to.	jsr  fixTheCaret		;this routine preserves the Y-Reg	brl  ScrollToSelection@extendIt	jsr  GetSelectionStart	ldy  #TERecord.SavedHPos	;set the new saved horizontal position	lda  [RecordPtr],y		;..if there isn't one already	bpl  @useSaved2	jsr  FindLineInfo		;find the correct line to start with, then	jsr  OffsetToHPos		;..find the hpos on this line	lda  TextHPos	ldy  #TERecord.SavedHPos	sta  [RecordPtr],y@useSaved2	sta  TextHPos	jsr  adjustTextOffset	ldy  #TERecord.SelectionStart	jsr  removeTheCaret	ldy  #TERecord.SelectionEnd	jsr  PushRecordLong	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  SetSelectionStart	jsr  InvertSelection	PullAX	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  fixTheCaret	ldy  #TERecord.SelectionStart	brl  ScrollToSelection;---------------------------------------------------------------;---------------------------------------------------------------adjustTextOffset	lda  TheModifierWord	and  #optionKey	bne  @doTop	lda  TheModifierWord	and  #appleKey	bne  @doPageUp@doLineUp	jsr  IsOffsetAtEnd		;if we are at the very end of the text	bne  @1		;..and if there is a CR at the end, then	ldy  #TERecord.LineAtEndFlag	;.. we move to the last line of text	lda  [RecordPtr],y		;..instead of going back an extra line.	bpl  @1	jsr  FindLineStart	bra  @3@1	jsr  FindLineStart	lda  TextOffset	bne  @2	lda  TextOffset+2	beq  @3	dec  TextOffset+2@2	dec  TextOffset@3	brl  HPosToOffset@doPageUp	jsr  ClearSavedHPos		;clear the saved horizontal position	jsr  FindLineInfo	jsr  GetScreenTopOffset	lda  TextOffset	cmp  SuperStart	bne  @exit	lda  TextOffset+2	cmp  SuperStart+2	bne  @exit	jsr  GetViewRect	lda  TempRect.bottom	sec	sbc  TempRect.top	ldx  #0	jsr  DivideByScrollAmount	bcs  @4	dec  a@4	dec  a	jsr  NegateAX	jsr  ScrollByAmount	brl  GetScreenTopOffset@doTop	jsr  ClearSavedHPos		;clear the saved horizontal position	stzl TextOffset@exit	rts;---------------------------------------------------------------	ENDP****************************************************************doDownArrow	PROCNAME  Entry;---------------------------------------------------------------	lda  TheModifierWord	and  #shiftKey	bne  extendIt;---------------------------------------------------------------noExtend	jsr  GetSelectionEnd	ldy  #TERecord.SavedHPos	;set the new saved horizontal position	lda  [RecordPtr],y		;..if there isn't one already	bpl  @useSaved	jsr  FindLineInfo		;find the correct line to start with, then	jsr  OffsetToHPos		;..find the hpos on this line	lda  TextHPos	ldy  #TERecord.SavedHPos	sta  [RecordPtr],y@useSaved	sta  TextHPos	jsr  adjustTextOffset	brl  moveToACaret;---------------------------------------------------------------extendIt	jsr  ClearNullStyle		;clear the null style active	jsr  setupAnchorPoint	;setup the anchor point	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @extendIt	cpx  AnchorPointStart+2	bne  @extendIt	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @contractIt	cpx  AnchorPointStart+2	beq  @extendIt@contractIt	jsr  GetSelectionStart	ldy  #TERecord.SavedHPos	;set the new saved horizontal position	lda  [RecordPtr],y		;..if there isn't one already	bpl  @useSaved1	jsr  FindLineInfo		;find the correct line to start with, then	jsr  OffsetToHPos		;..find the hpos on this line	lda  TextHPos	ldy  #TERecord.SavedHPos	sta  [RecordPtr],y@useSaved1	sta  TextHPos	jsr  adjustTextOffset	ldy  #TERecord.SelectionStart	jsr  removeTheCaret	jsr  SetSelectionEnd	jsr  InvertSelection	jsr  GetSelectionEnd	jsr  SetSelectionStart	ldax AnchorPointStart	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	ldy  #TERecord.SelectionStart	;checkAndSwap will set Y-Reg to the correct	jsr  checkAndSwap		;..end of the selection to scroll to.	jsr  fixTheCaret		;this routine preserves the Y-Reg	lda  TheModifierWord	and  #appleKey	bne  @exit	brl  ScrollToSelection@extendIt	jsr  GetSelectionEnd	ldy  #TERecord.SavedHPos	;set the new saved horizontal position	lda  [RecordPtr],y		;..if there isn't one already	bpl  @useSaved2	jsr  FindLineInfo		;find the correct line to start with, then	jsr  OffsetToHPos		;..find the hpos on this line	lda  TextHPos	ldy  #TERecord.SavedHPos	sta  [RecordPtr],y@useSaved2	sta  TextHPos	jsr  adjustTextOffset	ldy  #TERecord.SelectionEnd	jsr  removeTheCaret	ldy  #TERecord.SelectionStart	jsr  PushRecordLong	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	jsr  SetSelectionEnd	jsr  InvertSelection	PullAX	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	jsr  fixTheCaret	lda  TheModifierWord	and  #appleKey	bne  @exit	ldy  #TERecord.SelectionEnd	brl  ScrollToSelection@exit	rts;---------------------------------------------------------------;---------------------------------------------------------------adjustTextOffset	jsr  IsOffsetAtEnd		;if the offset is already at the end, then	beq  @exit		;..exit	lda  TheModifierWord	and  #optionKey	bne  @doBottom	lda  TheModifierWord	and  #appleKey	bne  @doPageDown@doLineDown	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	jsr  IsOffsetAtEnd	bne  @useHPos	ldy  #TERecord.LineAtEndFlag	lda  [RecordPtr],y	bmi  @exit@useHPos	brl  HPosToOffset@doPageDown	jsr  ClearSavedHPos		;clear the saved horizontal position	jsr  FindLineInfo	PushZLong SuperStart	jsr  findTheBottom	PullAX	cmpl TextOffset	blt  @checkShift	jsr  GetViewRect	lda  TempRect.bottom	sec	sbc  TempRect.top	ldx  #0	jsr  DivideByScrollAmount	bcs  @1	dec  a@1	dec  a	jsr  ScrollByAmount	jsr  findTheBottom@checkShift	lda  TheModifierWord	;if the shift key is down, then we must	and  #shiftKey		;..extend to the end of the line, other	beq  @exit		;..wise just use the beginning	jsr  FindLineInfo	brl  MoveOffsetToNextItem@doBottom	jsr  ClearSavedHPos		;clear the saved horizontal position	jsr  GetTextLength	stax TextOffset@exit	rts;---------------------------------------------------------------;---------------------------------------------------------------findTheBottom	jsr  GetViewRect	lda  TempRect.top	sec	ldy  #TERecord.TopTextVPos	sbc  [RecordPtr],y	sta  TextVPos	jsr  GetScreenTopOffset	bra  @enter@loop	jsr  FindLineInfo	lda  LineHeight	clc	adc  TextVPos	cmp  TempRect.bottom	beq  @exit	bpl  @foundIt	sta  TextVPos	jsr  MoveOffsetToNextItem@enter	jsr  IsOffsetAtEnd	bne  @loop	ldy  #TERecord.LineAtEndFlag	lda  [RecordPtr],y	beq  @foundIt@exit	rts@foundIt	jsr  decTextOffset	brl  FindLineStart;---------------------------------------------------------------	ENDP****************************************************************doReplaceText	PROCNAME  Entry;---------------------------------------------------------------	ldy  #TERecord.theKeyRecord.theInputHandle	jsr  PushRecordLong		;one copy for the unlock call	jsr  PushRecordLong		;another copy for the GetHandleSize call	jsr  PushRecordLong		;lock down the input handle and put the	jsr  LockHandle		;..pointer in InputTextPtr	stax InputTextPtr	jsr  GetHandleSize		;the size of the handle is the number of	stax InputTextLength	;..characters to insert (actually replace)	stzl InputStyleRef		;no styles	jsr  ReplaceText		;replace the text	jsr  UnlockHandle		;unlock the input text handle	brl  ShrinkInputHandle	;set the size of the handle back to one;---------------------------------------------------------------	ENDP****************************************************************doMoveSelection	PROCNAME  Entry;---------------------------------------------------------------	jsr  ClearSavedHPos		;clear the saved horizontal position	ldy  #TERecord.theKeyRecord.cursorOffset	jsr  GetRecordLong	stax TextOffset	brl  moveToACaret;---------------------------------------------------------------	ENDP****************************************************************doExtendLeft	PROCNAME  Entry;---------------------------------------------------------------	jsr  ClearSavedHPos		;clear the saved horizontal position	jsr  ClearNullStyle		;clear the null style active	jsr  setupAnchorPoint	;setup the anchor point	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @extendIt	cpx  AnchorPointStart+2	bne  @extendIt	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @contractIt	cpx  AnchorPointStart+2	beq  @extendIt@contractIt	jsr  GetSelectionEnd	ldy  #TERecord.theKeyRecord.cursorOffset	jsr  GetRecordLong	stax TextOffset	ldy  #TERecord.SelectionEnd	jsr  removeTheCaret	jsr  SetSelectionStart	jsr  InvertSelection	jsr  GetSelectionStart	jsr  SetSelectionEnd	ldy  #TERecord.SelectionStart	ldax AnchorPointStart	jsr  SetRecordLong	ldy  #TERecord.SelectionEnd	;checkAndSwap will set Y-Reg to the correct	jsr  checkAndSwap		;..end of the selection to scroll to.	jsr  fixTheCaret		;this routine preserves the Y-Reg	brl  ScrollToSelection@extendIt	jsr  GetSelectionStart	ldy  #TERecord.theKeyRecord.cursorOffset	jsr  GetRecordLong	stax TextOffset	ldy  #TERecord.SelectionStart	jsr  removeTheCaret	ldy  #TERecord.SelectionEnd	jsr  PushRecordLong	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  SetSelectionStart	jsr  InvertSelection	PullAX	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  fixTheCaret	ldy  #TERecord.SelectionStart	brl  ScrollToSelection;---------------------------------------------------------------	ENDP****************************************************************doExtendRight	PROCNAME  Entry;---------------------------------------------------------------	jsr  ClearSavedHPos		;clear the saved horizontal position	jsr  ClearNullStyle		;clear the null style active	jsr  setupAnchorPoint	;setup the anchor point	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @extendIt	cpx  AnchorPointStart+2	bne  @extendIt	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @contractIt	cpx  AnchorPointStart+2	beq  @extendIt@contractIt	jsr  GetSelectionStart	ldy  #TERecord.theKeyRecord.cursorOffset	jsr  GetRecordLong	stax TextOffset	ldy  #TERecord.SelectionStart	jsr  removeTheCaret	jsr  SetSelectionEnd	jsr  InvertSelection	jsr  GetSelectionEnd	jsr  SetSelectionStart	ldax AnchorPointStart	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	ldy  #TERecord.SelectionStart	;checkAndSwap will set Y-Reg to the correct	jsr  checkAndSwap		;..end of the selection to scroll to.	jsr  fixTheCaret		;this routine preserves the Y-Reg	brl  ScrollToSelection@extendIt	jsr  GetSelectionEnd	ldy  #TERecord.theKeyRecord.cursorOffset	jsr  GetRecordLong	stax TextOffset	ldy  #TERecord.SelectionEnd	jsr  removeTheCaret	ldy  #TERecord.SelectionStart	jsr  PushRecordLong	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	jsr  SetSelectionEnd	jsr  InvertSelection	PullAX	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	jsr  fixTheCaret	ldy  #TERecord.SelectionEnd	brl  ScrollToSelection;---------------------------------------------------------------	ENDP****************************************************************ClearSavedHPos	PROCNAME  Export	ldy  #TERecord.SavedHPos	;clear the saved horizontal position	lda  #$FFFF	sta  [RecordPtr],y	rts	ENDP****************************************************************ShrinkInputHandle	PROCNAME  Export;---------------------------------------------------------------	ldy  #TERecord.theKeyRecord.theInputHandle	lda  [RecordPtr],y	sta  TempLong	iny	iny	lda  [RecordPtr],y	sta  TempLong+2	ldy  #HandleRecord.length+2	lda  [TempLong],y	bne  @sizeIt	dey	dey	lda  [TempLong],y	dec  a	bne  @sizeIt	rts@sizeIt	PushZLong TempLong	lda  #1		;this loads A-Reg and X-Reg with	tax		;..$00000001	dex	jsr  SetHandleSize		;set the size of the input handle to one	rts;---------------------------------------------------------------	ENDP****************************************************************DerefInputHandle	PROCNAME  Export;---------------------------------------------------------------	ldy  #TERecord.theKeyRecord.theInputHandle	jsr  GetRecordLong	jsr  DerefAX	stax InputTextPtr	rts;---------------------------------------------------------------	ENDP****************************************************************	END