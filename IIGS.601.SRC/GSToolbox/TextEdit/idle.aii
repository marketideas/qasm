************************************************************************                      GSTextEdit  Version 1.0*                           File: idle.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.** 9-Feb-92	Dave Lyons** Fixed don't-blink-the-caret fix so the insertion point shows up* (before you start typing) if the cursor blink is set to 0.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************DoIdleEvent	PROCNAME  Export;---------------------------------------------------------------doFixBlocks	php		;disable interrupts for this	sei	lda  >TickCnt+2	tax	lda  >TickCnt	plp		;restore interrupt status	cmpl BlockListTickCount	;should we call the main split routine ?	blt  @skip	clc	adc  #10		;this goes off every ten ticks	bcc  @1	inx@1	stax BlockListTickCount	jsr  FixBlockList@skip;---------------------------------------------------------------doBlink	jsr  AreWeInvisible		;if we are invisible, then don't blink	bne  @toDone		;..the cursor	jsr  GetTEHighFlags		;should we be selecting text ? If not,	and  #fDisableSelection	;..then we shouldn't idle	bne  done	ldy  #TERecord.CtrlMoreFlags	;if the record is not active then exit	lda  [RecordPtr],y	bpl  done	jsr  IsTheSelectionACaret@toDone	bne  done	PushLongSpace		;get the current flash time	_GetCaretTime;; 2/14/90	Mensch; added a test for zero comming back from this call.;	lda 1,s		; get the long value	ora 3,s		; or it with itself	bne @CaretTimeOK	pla		; discard the data	pla*** added 9-Feb-92 DAL -- If the caret time is zero but there is no caret showing***   yet, then we had better invert the thing for the first time.	ldy #TERecord.SelectionState	lda [RecordPtr],y	beq mustBlink*** end 9-Feb-92	brl done		; and exit@CaretTimeOK	ldy  #TERecord.CaretTime	pla	clc	adc  [RecordPtr],y	sta  TempLong	iny	iny	pla	adc  [RecordPtr],y	sta  TempLong+2	php		;disable interrupts for this	sei	lda  >TickCnt	sta  TempPtr	lda  >TickCnt+2	sta  TempPtr+2	plp		;restore interrupt status	lda  TempPtr+2	cmp  TempLong+2	blt  done	bne  mustBlink	lda  TempPtr	cmp  TempLong	blt  donemustBlink	jsr  InvertSelection	;flip the cursor	ldy  #TERecord.SelectionState	lda  #0	cmp  [RecordPtr],y	bne  @setIt	dec  a@setIt	sta  [RecordPtr],y	php		;save the interrupt state	sei		;disable interrupts for this	lda  >TickCnt		;time stamp the last time the selection	ldy  #TERecord.CaretTime	;..went on.	sta  [RecordPtr],y	iny	iny	lda  >TickCnt+2	sta  [RecordPtr],y	plp		;restore interrupt statusdone	rts;---------------------------------------------------------------;---------------------------------------------------------------BlockListTickCount	dc.l  0;---------------------------------------------------------------	ENDP****************************************************************	END