************************************************************************                      GSTextEdit  Version 1.0*                           File: wrap.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************IncrementalWordWrap	PROCNAME  Export;---------------------------------------------------------------	stzl TextOffset		;see if the record is totally empty	jsr  IsOffsetAtEnd	bne  @notEmpty	ldy  #TERecord.LineSuper	;if it is, then destroy the old line starts	jsr  KillSuperHandle	;..array and create a new one	ldy  #TERecord.LineSuper	jsr  GetNewSuperHandle	jsr  FindStyleInfo		;find the starting height and ascent	jsr  GetTextHeightAndAscent	sta  LineHeight	stx  LineAscent	stzl SuperLength	jsr  SetLineInfo		;set our initial line info	lda  LineHeight		;the total height is the lineHeight	ldx  #0	ldy  #TERecord.TotalHeight	jsr  SetRecordLong	ldy  #TERecord.LineAtEndFlag	;set the line at the end flag	lda  #0	sta  [RecordPtr],y	jsr  GetViewRect	jsr  CopyTempToDrawRect	brl  ResetScrollBar@notEmpty;---------------------------------------------------------------	jsr  GetSelectionStart	jsr  FindStyleInfo		;find the current style and setup the	jsr  SetupWidthTable	;..width table	jsr  OffsetToPoint		;set the super start and the line height	jsr  FindLineInfo		;..correctly	jsr  IsOffsetAtEnd	bne  @skipAtEnd	ldy  #TERecord.LineAtEndFlag	lda  [RecordPtr],y	bpl  @skipAtEnd*###############################################################*# changed this piece of code from an add to a subtract. This*# should fix the redraw bug*###############################################################	lda  TextVPos	sec	sbc  LineHeight	sta  TextVPos*###############################################################@skipAtEnd	lda  SuperStart+2		;start at the beginning of our line	sta  TextOffset+2	lda  SuperStart	sta  TextOffset		;is there a previous line ? If not, then	ora  TextOffset+2		;..don't check to see if it wrapped.	beq  noPrevLine	decl TextOffset	jsr  FindLineStart		;find the previous line's start and see	lda  TextVPos		;move TextVPos back to the previous line	sec	sbc  LineHeight	sta  TextVPos	sta  DrawRect.top	jsr  WrapToLineEnd		;..if the previous line's end changed.	jsr  ShouldWeAdjust		;should we adjust the scroll bar	bcc  @skipAdjust	ldy  #TERecord.ViewRect.top	;save the new top of the draw rect	lda  [RecordPtr],y	pha	sec	sbc  TextVPos	ldx  #0	jsr  DivideByScrollAmount	jsr  NegateAX	jsr  ScrollByAmount	pla		;..drawrect.top	sta  DrawRect.top	jsr  GetScreenTopOffset	jsr  OffsetToPoint	jsr  WrapToLineEnd		;..if the previous line's end changed.@skipAdjust	jsr  InsertALine		;if the end changed, then we don't need	bcc  mainLoop		;..to set the draw top againnoPrevLine	lda  TextVPos	sta  DrawRect.top;---------------------------------------------------------------mainLoop	jsr  WrapToLineEnd	jsr  InsertALine	bcc  mainLoop;---------------------------------------------------------------	jsr  IsOffsetAtEnd	bne  @notAtEnd	jsr  FindTextPtr	decl TextPtr	lda  [TextPtr]	and  #$00FF	cmp  #CR	bne  @clearLineEnd	ldy  #TERecord.LineAtEndFlag	lda  #$FFFF	cmp  [RecordPtr],y	beq  @notAtEnd	sta  [RecordPtr],y	lda  LineHeight	ldy  #TERecord.TotalHeight	jsr  AddWordToRecordLong	bra  @clearCache@clearLineEnd	ldy  #TERecord.LineAtEndFlag	lda  #$0000	cmp  [RecordPtr],y	beq  @notAtEnd	sta  [RecordPtr],y	ldy  #TERecord.TotalHeight	lda  [RecordPtr],y	sec	sbc  LineHeight	sta  [RecordPtr],y	bcs  @clearCache	iny	iny	lda  [RecordPtr],y	dec  a	sta  [RecordPtr],y@clearCache	jsr  ClearOffsetCache@notAtEnd	lda  TextVPos	sta  DrawRect.bottom;---------------------------------------------------------------checkForSingle	ldy  #TERecord.TotalHeight	;subtract the removed height from the	lda  [RecordPtr],y		;..total height	sec	sbc  RemovedHeight	sta  [RecordPtr],y	iny	iny	lda  [RecordPtr],y	sbc  RemovedHeight+2	sta  [RecordPtr],y	lda  RemovedHeight	ora  RemovedHeight+2	bnel notSingleLine	jsr  GetJust	cmp  #leftJust	bnel notSingleLine	jsr  GetSelectionStart	jsr  OffsetToPoint	lda  TextVPos	cmp  DrawRect.top	bnel notSingleLine	jsr  FindLineInfo	lda  TextVPos	clc	adc  LineHeight	cmp  DrawRect.bottom	bnel notSingleLine	lda  InputTextLength+2	bne  @notCached	lda  InputTextLength	dec  a	bne  @notCached	jsr  IsOffsetCached	bne  @notCached	ldy  #TERecord.CachedSelcOffset	lda  [RecordPtr],y	inc  a	sta  [RecordPtr],y	bne  @1	iny	iny	lda  [RecordPtr],y	inc  a	sta  [RecordPtr],y@1	jsr  FindStyleInfo	jsr  FindTextPtr	lda  #0	shortm	lda  [TextPtr]	cmp  #TAB	bne  @notTab@doTab	rep  #$20		;goto long mode for Tab processing	pei  TextHPos	ldy  #TERecord.CachedSelcHPos	lda  [RecordPtr],y	sec	ldy  #TERecord.ViewRect.left	sbc  [RecordPtr],y	sta  TextHPos	jsr  MoveOverTab	clc	ldy  #TERecord.ViewRect.left	adc  [RecordPtr],y	ldy  #TERecord.CachedSelcHPos	plx	stx  TextHPos	bra  @useHPos@notTab	tay	lda  [WidthTablePtr],y	longm	clc	ldy  #TERecord.CachedSelcHPos	adc  [RecordPtr],y@useHPos	sta  [RecordPtr],y	bra  @drawTheLine@notCached	jsr  ClearOffsetCache@drawTheLine	jsr  DrawFromOffset	stz  DrawRect.top	stz  DrawRect.bottom	jsr  FreeWidthTable	brl  ResetScrollBar		;fix the scroll bar view and data size;---------------------------------------------------------------notSingleLine	jsr  ClearOffsetCache	jsr  FreeWidthTable	jsr  GetViewRect	lda  TempRect.left	sta  DrawRect.left	lda  TempRect.right	sta  DrawRect.right	lda  RemovedHeight	ora  RemovedHeight+2	beq  @skipAdjust	lda  TempRect.bottom	cmp  DrawRect.bottom	beq  @skipAdjust	jsr  PushDrawRect	lda  RemovedHeight+2	bmi  @goingDown@goingUp	lda  DrawRect.bottom	sta  TempRect.top	bra  @doTheScroll@goingDown	lda  DrawRect.bottom	clc	adc  RemovedHeight	sta  TempRect.top@doTheScroll	ldx  #0	lda  RemovedHeight	eor  #$FFFF	inc  a	bpl  @plus	dex@plus	jsr  FastScrollRect	lda  DrawRect.top	cmp  3,s	bge  @1	lda  3,s	sta  DrawRect.top@1	lda  DrawRect.bottom	cmp  DrawRect.top	beq  @restoreDraw	bmi  @restoreDraw	jsr  DoDraw@restoreDraw	jsr  PullDrawRect@skipAdjust	brl  ResetScrollBar		;fix the scroll bar view and data size;---------------------------------------------------------------	ENDP****************************************************************ShouldWeAdjust	PROCNAME  Entry;---------------------------------------------------------------	PushZLong TextOffset	lda  TextVPos		;move the vertical position down by this	ldy  #TERecord.ViewRect.top	cmp  [RecordPtr],y	bpl  @noChange	clc		;..line height	adc  LineHeight	ldy  #TERecord.ViewRect.top	cmp  [RecordPtr],y	bmi  @mustAdjust	subl TextOffset,OriginalOffset,NewLineLength	lda  NewLineLength	ora  NewLineLength+2	beq  @noChange	movl OriginalOffset,TextOffset	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	lda  SuperLength+2	cmp  NewLineLength+2	bne  @mustAdjust	lda  SuperLength	cmp  NewLineLength	bne  @mustAdjust@noChange	clc@done	pla	sta  TextOffset	pla	sta  TextOffset+2	rts@mustAdjust	sec	bra  @done;---------------------------------------------------------------	ENDP****************************************************************InsertALine	PROCNAME  Entry;---------------------------------------------------------------	PushZLong TextOffset	lda  LineHeight	clc		;move the vertical position down by this	adc  TextVPos		;..line height	ldy  #TERecord.ViewRect.bottom	cmp  [RecordPtr],y	blt  @1	lda  [RecordPtr],y@1	sta  TextVPos	subl TextOffset,OriginalOffset,NewLineLength	lda  NewLineLength	ora  NewLineLength+2	beq  secAndExit	movl OriginalOffset,TextOffset	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	lda  SuperLength+2	cmp  NewLineLength+2	blt  removeThem	bne  addOne	lda  SuperLength	cmp  NewLineLength	blt  removeThem	bne  addOne;---------------------------------------------------------------alreadyThere	jsr  addTheDifference	;now we must find the difference betweensecAndExit	sec		;..the new line and the old one and sub	bra  exit		;..that amount from the removed height;---------------------------------------------------------------addOne	lda  3,s		;the value on the stack is the original	sta  TextOffset+2		;..offset plus the new line length	lda  1,s	sta  TextOffset	ldy  #TERecord.LineSuper	;insert a new line	jsr  InsertSuperItem	bcs  memoryError	movl OriginalOffset,TextOffset	;go back to the original offset	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	lda  LineHeight	sta  [TempPtr],y	iny	iny	lda  LineAscent	sta  [TempPtr],y	lda  LineHeight	jsr  addHeight	clc;---------------------------------------------------------------exit	pla		;restore the text offset	sta  TextOffset	pla	sta  TextOffset+2	rts;---------------------------------------------------------------memoryError	pla		;clean up the stack	pla	jsr  SetLastErrorCode	;report the last error	pla		;pull off one level of return address	rts		;..and return to ReplaceText;---------------------------------------------------------------removeThem	jsr  GetSuperMaxIndex	ldy  #SuperHandle.cachedIndex	;get the current index for the selection	lda  [SuperRecordPtr],y	;..start into Y-Reg	tay	lda  NewLineLength		;set the new item length and at the same	sta  [TempPtr],y		;..time subtract the old length from the	sec		;..new one	sbc  SuperLength	sta  SuperLength	sta  NewLineLength	iny	iny	lda  NewLineLength+2	sta  [TempPtr],y	sbc  SuperLength+2	sta  SuperLength+2	sta  NewLineLength+2	iny		;now we must find the difference between	iny		;..the new line and the old one and sub	jsr  addTheDifference	;..that amount from the removed height	jsr  AddLengthToBlock	ldy  #SuperHandle.cachedIndex	;get the current index for the selection	lda  [SuperRecordPtr],y	;..start into Y-Reg	inc  a	inc  a	bra  @enterLoop@itemLoop	sty  TempWord	lda  [TempPtr],y	bmi  @deletedItem	sta  SuperLength+2	dey	dey	lda  [TempPtr],y	sta  SuperLength	lda  NewLineLength	sec	sbc  SuperLength	sta  NewLineLength	lda  NewLineLength+2	sbc  SuperLength+2	sta  NewLineLength+2	;carry remains set if we are continuing	bcc  @lastItem	jsr  SubLengthFromBlock	ldy  TempWord	lda  #$FFFF		;mark this item as deleted	sta  [TempPtr],y	dey	dey	sta  [TempPtr],y	iny	iny	iny	iny	lda  [TempPtr],y	sta  LineHeight	addl RemovedHeight	lda  NewLineLength		;if the new length is zero, then exit	ora  NewLineLength+2	bne  @notZero	clc	brl  exit@notZero@deletedItem	lda  TempWord@enterLoop	clc	adc  #SuperItemSize	tay	cpy  SuperMaxIndex	blt  @itemLoop	jsr  MoveToNextHandle	;NOTE: we should never reach the end here	ldy  #SuperBlock.RecordSize+2	;..so we don't check the carry - we assume	bra  @itemLoop		;..that there will always be another handle@lastItem	addl SuperLength,NewLineLength,SuperLength	jsr  SubLengthFromBlock	ldy  TempWord		;set the last item to (SuperLength - 	dey		;..the last valid NewLineLength)	dey	lda  NewLineLength+2	eor  #$FFFF	tax	lda  NewLineLength	eor  #$FFFF	inc  a	bne  @2	inx@2	stax SuperLength		;set the correct super length for later	sta  [TempPtr],y	txa	iny	iny	sta  [TempPtr],y	clc	brl  exit;---------------------------------------------------------------;---------------------------------------------------------------addTheDifference	lda  LineHeight		;subtract the old line height from the	sec		;..the new one to get the amount to add.	sbc  [TempPtr],y	tax	lda  LineHeight	sta  [TempPtr],y	iny	iny	lda  LineAscent	sta  [TempPtr],y	txa		;fall through to add height;---------------------------------------------------------------addHeight	sta  TempLong	stz  TempLong+2	bpl  @plus	dec  TempLong+2@plus	lda  RemovedHeight	sec	sbc  TempLong	sta  RemovedHeight	lda  RemovedHeight+2	sbc  TempLong+2	sta  RemovedHeight+2	rts;---------------------------------------------------------------	ENDP****************************************************************WrapToLineEnd	PROCNAME  Entry;---------------------------------------------------------------	movl TextOffset,OriginalOffset	;save the original text offset	jsr  GetTEHighFlags	and  #fNoWordWrap	beq  wrapIt;---------------------------------------------------------------@mainLoop	jsr  FindTextPtr		;setup the text pointer	jsr  GetTextLength	sec	sbc  TextOffset	tay	txa	sbc  TextOffset+2	beq  @useY	ldy  #$FFFF@useY	tyx	beq  @exit	ldy  #0	shortm@innerLoop	lda  [TextPtr],y	iny	cmp  #CR	beq  @foundCR	dex	bne  @innerLoop	longm	tya	addl TextOffset	bra  @mainLoop@foundCR	longm	tya	addl TextOffset@exit	jsr  SetupWidthTable	brl  allDone;---------------------------------------------------------------wrapIt	jsr  FindLineStart		;find the start of the line	jsr  FindStyleInfo		;find the current style and setup the	jsr  SetupWidthTable	;..width table	jsr  GetRightMargin	sta  OriginalHPos	jsr  GetLeftEdge	sta  TextHPos;---------------------------------------------------------------mainLoop	jsr  FindStyleInfo		;install the style first, so the maximum	jsr  GetSuperCount		;..height gets set properly	sta  TextCount	jsr  IsOffsetAtEnd	beql allDone	jsr  FindTextPtr		;setup the text pointer	ldx  #0		;start our initial index at zerowidthLoop	txy	lda  [TextPtr],y		;get the next character	and  #$00FF	cmp  #TAB		;is it a TAB ?	beq  doTab	cmp  #CR		;is it a carriage return ?	beq  foundCR	tay	lda  [WidthTablePtr],y	;..it from the table	and  #$00FF	clc	adc  TextHPosuseValue	cmp  OriginalHPos	bpl  foundChar	sta  TextHPos	inx		;move to the next character and loop back	cpx  TextCount	blt  widthLoop	lda  TextCount		;move TextOffset past the characters	addl TextOffset		;..we just processed.	bra  mainLoop;---------------------------------------------------------------doTab	jsr  MoveOverTab	bra  useValue;---------------------------------------------------------------foundCR	inx	txa	addl TextOffset	bra  allDonefoundChar	txa	addl TextOffset	txa	addl TextPtr	lda  [TextPtr]	jsr  IsItAWordWrap	bcs  @skipOverSpace	movl TextOffset,TempLong@loop	decl TextPtr	lda  [TextPtr]	jsr  IsItAWordWrap	bcs  allDone	decl TextOffset	lda  TextOffset	cmp  OriginalOffset	bne  @loop	lda  TextOffset+2	cmp  OriginalOffset+2	bne  @loop	movl TempLong,TextOffset	bra  allDone@skipOverSpace	incl TextOffset	jsr  IsOffsetAtEnd	beq  allDone	incl TextPtr	lda  [TextPtr]	and  #$00FF	cmp  #CR	beq  lastCR	jsr  IsItAWordWrap	bcs  @skipOverSpace;---------------------------------------------------------------allDone	movl TextOffset,TempLong	;save text offset in TempLong	movl OriginalOffset,TextOffset	stz  LineHeight	stz  LineAscent@loop	jsr  SetupRulerPtr		;save the extra line spacing on the stack	ldy  #TERuler.extraLS	lda  [TempPtr],y	pha	jsr  FindStyleInfo	ldy  #WidthTable.height	lda  [WidthTablePtr],y	clc	adc  1,s	cmp  LineHeight	blt  @1	sta  LineHeight@1	ldy  #WidthTable.ascent	lda  [WidthTablePtr],y	clc	adc  1,s	cmp  LineAscent	blt  @2	sta  LineAscent@2	pla		;clean off the garbage on the stack	jsr  MoveOffsetToNextItem	cmpl TextOffset,TempLong	blt  @loop	movl TempLong,TextOffset	;restore text offset	brl  FreeWidthTable		;unlock the width table;---------------------------------------------------------------lastCR	incl TextOffset		;skip over the CR	bra  allDone;---------------------------------------------------------------	ENDP****************************************************************InitialWordWrap	PROCNAME  Export;---------------------------------------------------------------	jsr  ClearOffsetCache	;make sure the offset cache is clear	ldy  #TERecord.LineSuper	;destroy the old line starts super and get	jsr  KillSuperHandle	;..a new one	ldy  #TERecord.LineSuper	jsr  GetNewSuperHandle	jsr  GetTextLength		;the new line length is the total text length	stax SuperLength		;if there is no text, we can skip this	ora  SuperLength+2		;..entire routine - (there are no lines)	bne  mustWordWrap;---------------------------------------------------------------noText	ldy  #TERecord.LineAtEndFlag	lda  #0	sta  [RecordPtr],y	stzl TextOffset	jsr  FindStyleInfo	jsr  GetTextHeightAndAscent	sta  LineHeight	stx  LineAscent	stzl SuperLength	jsr  SetLineInfo	lda  LineHeight		;the total height is the lineHeight	ldx  #0	ldy  #TERecord.TotalHeight	jsr  SetRecordLong	brl  exit;---------------------------------------------------------------mustWordWrap	stz  LineHeight	stz  LineAscent	jsr  SetLineInfo	lda  #0	tax	ldy  #TERecord.TotalHeight	;clear the total height field	jsr  SetRecordLong	ldy  #TERecord.LineAtEndFlag	sta  [RecordPtr],y	stzl TextOffset	jsr  FindStyleInfo		;find the current style and setup the	jsr  SetupWidthTable	;..width table	jsr  SetupRulerPtr		;save the original justification of the ruler	ldy  #TERuler.just		;..on the stack, then set the just to	lda  [TempPtr],y		;..leftJust so HPosToOffset will measure	pha		;..correctly	lda  #leftJust	sta  [TempPtr],y;---------------------------------------------------------------lineLoop	jsr  WrapToLineEnd	jsr  IsOffsetAtEnd	beq  lastBreak	jsr  setupNewLine	ldy  #TERecord.LineSuper	jsr  InsertSuperItem	bcs  memoryError	bra  lineLoop;---------------------------------------------------------------lastBreak	jsr  FindTextPtr	decl TextPtr	lda  [TextPtr]	and  #$00FF	cmp  #CR	bne  @noLineAtEnd@lineAtEnd	ldy  #TERecord.LineAtEndFlag	lda  #$FFFF	sta  [RecordPtr],y	lda  LineHeight	ldy  #TERecord.TotalHeight	jsr  AddWordToRecordLong@noLineAtEnd	jsr  setupNewLine;---------------------------------------------------------------allDone	stzl TextOffset	ldy  #TERecord.LineSuper	;make sure the super cache information is	jsr  ClearSuperCache	;..accurate	jsr  SetupRulerPtr		;restore the original just	ldy  #TERuler.just	pla	sta  [TempPtr],y	jsr  FreeWidthTable		;free the width table;---------------------------------------------------------------exit	jsr  RecalcScrollBar	;recalculate the scroll bar values	jsr  ClearOffsetCache	;clear the selection cache	jsr  GetViewRect		;set the DrawRect to the entire view rect	brl  CopyTempToDrawRect;---------------------------------------------------------------memoryError	jsr  SetLastErrorCode	bra  allDone;---------------------------------------------------------------;---------------------------------------------------------------setupNewLine	lda  LineHeight	ldy  #TERecord.TotalHeight	jsr  AddWordToRecordLong	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	lda  LineHeight	sta  [TempPtr],y	iny	iny	lda  LineAscent	sta  [TempPtr],y	rts;---------------------------------------------------------------	ENDP****************************************************************	END