************************************************************************                      GSTextEdit  Version 1.0*                          File: entry.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************Entry1Proc	PROC;---------------------------------------------------------------	EXPORT  QuickEntry	EXPORT  QuickExit	EXPORT  StandardEntry	EXPORT  StandardExit;---------------------------------------------------------------;---------------------------------------------------------------	DefineStackourDirectPage	wordparameterCount	worduserBank	byteuserDirectPage	wordreturnAddr1	word		;return to main routinereturnAddr2	word		;return to quick or standard startuserReturnAddr	block  6userData	word		;these are the parameters;---------------------------------------------------------------;---------------------------------------------------------------MaximumParameters	equ  24;---------------------------------------------------------------	MACRO	CopyMultiple	LCLA  &counter&counter	SETA  MaximumParameters	WHILE  &counter ³ 0  DO	lda  <userData+&counter	sta  |&counter,y&counter	SETA  &counter-2	ENDWHILE	MEND;---------------------------------------------------------------	MACRO&lab	MakeJumpTable	LCLA  &counter&counter	SETA  0&lab	WHILE  &counter < (MaximumParameters/2)  DO	dc.w  EndAddr-(&counter*5)&counter	SETA &counter+1	ENDWHILE	MEND;---------------------------------------------------------------;---------------------------------------------------------------RealEntry	jsl  IncBusyFlg		;increment busy flag (doesn't change ANYTHING)	tax		;check to see if TextEdit is started	beq  notStarted	tyx		;X-Reg now contains the number of parameters	beq  noParameters	phd		;save the user's direct page	phb		;save the user's data bank	phy		;save the number of parameters	pha		;save TextEdit's direct page	clc		;make a pointer to our direct page space	adc  #ParameterSpace	;..and leave it in Y-Reg	tay	tsc		;set direct page to the old stack pointer	tcd	pea  $0000		;set the data bank to $0000 for the copy	plb	plb	jsr  (CopyTable,x)		;X-Reg still contains the number of paramsstripStack	lda  userReturnAddr+4	;X-Reg still contains the number of params	sta  userReturnAddr+4,x	;move the return addresses.	lda  userReturnAddr+2	sta  userReturnAddr+2,x	lda  userReturnAddr	sta  userReturnAddr,x	lda  userDirectPage		;move the user direct page and data bank	sta  userReturnAddr-2,x	lda  userBank		sta  userReturnAddr-3,x	lda  returnAddr2		;move the local return addresses	sta  userReturnAddr-5,x	lda  returnAddr1	sta  userReturnAddr-7,x	tsc		;adjust the stack pointer, but don't set	clc		;..it back yet.	adc  parameterCount	adc  #4	pld		;set TextEdit's direct page	tcs		;NOW adjust the stack	phk		;set our data bank	plb	rts		;return to caller;---------------------------------------------------------------noParameters	plx		;get the two return addresses into	ply		;..registers	phd		;save the user's direct page and the data	phb		;..bank	phy		;put back the two return addresses	phx	tcd		;set our direct page and our data bank	phk	plb	rts		;return to the caller;---------------------------------------------------------------notStarted	tyx		;if there are no parameters, then special	beq  noParamError		;..exit	phd		;save the user's direct page	phb		;save the user's data bank	phy		;save the number of parameters	pha		;save TextEdit's direct page	tsc		;set direct page to the old stack pointer	tcd	lda  #returnHere-1		;X-Reg is already set to the number of	sta  returnAddr1		;..parameters	bra  stripStackreturnHere	ldx  #teNotStarted		;load the not started errorerrorExit	pla		;pull off the return address	bra  QuickExit;---------------------------------------------------------------noParamError	pla		;clean both return addrs off the stack	pla	lda  #teNotStarted		;put the error code into A	sec	jml  DecBusyFlg		;decrement busy flag and return to caller;---------------------------------------------------------------;---------------------------------------------------------------QuickEntry	jsr  RealEntry	rts		;return to caller;---------------------------------------------------------------;---------------------------------------------------------------StandardExit	stx  TempWord		;save the error code in TempWord	jsr  RestoreOriginalPort	;restore the origin and the port	jsr  UnlockRecordHandle	ldx  TempWord		;restore the error code;---------------------------------------------------------------QuickExit	plb		;restore the original data bank	pld		;restore original direct page	txa		;put the error code into A	cmp  #1		;set the carry flag	jml  DecBusyFlg		;decrement busy flag and return to caller;---------------------------------------------------------------;---------------------------------------------------------------StandardEntry	jsr  RealEntry		;call quick entry (effectively)	pla		;pull the return address into TempWord	sta  TempWord	lda  RecordHandle		;check to see if the record handle is	ora  RecordHandle+2		;..NULL (use the current record)	bne  @checkThisHandle@findTheCtrl	PushLongSpace		;it was NULL, so find the current target	_FindTargetCtl		;..control	tax		;put the error code in the X-Reg	pla	sta  RecordHandle	pla	sta  RecordHandle+2	bcs  QuickExit		;if there was an error, then exit@checkThisHandle	ldx  #teInvalidHandle	;load the proper error code	ldy  #HandleRecord.length	lda  [RecordHandle],y	cmp  #TERecord.RecordSize	;if the size of the record handle is not	bne  QuickExit		;..correct, then exit with teInvalidHandle	jsr  DerefRecordHandle	ldx  #teInvalidHandle	;if the record does not have TextEditControl	ldy  #TERecord.CtrlProc	;..as it's CtrlProc field, then return	lda  [RecordPtr],y		;..teInvalidHandle	bne  QuickExit	iny	iny	lda  [RecordPtr],y	cmp  #TextEditControl>>16	bne  QuickExit	jsr  LockRecordHandle	;lock the main record handle	jsr  SetupWindowPort	;setup the origin and the port	pei  TempWord	rts;---------------------------------------------------------------;---------------------------------------------------------------CopyTable	MakeJumpTable;---------------------------------------------------------------	CopyMultipleEndAddr	rts;---------------------------------------------------------------	ENDP****************************************************************SetupWindowPort	PROCNAME  Export;---------------------------------------------------------------returnAddr	equ  0;---------------------------------------------------------------;---------------------------------------------------------------	DefineStackxReturnAddr	wordvOrigin	wordhOrigin	wordorigPort	long;---------------------------------------------------------------;---------------------------------------------------------------	pla		;pull the return address into TempPtr	sta  returnAddr	jsr  GetPort		;save the current port	PushLongSpace		;allocate space for the origin	pei  returnAddr		;put the return address back on the stack	jsr  GetTEHighFlags		;if the record is not a control, then	and  #fNotControl		;..we never need to set the origin	bne  @noBars	jsr  GetWindowPortPtr	ldy  #WindowRecord.wFrame	lda  [TempPtr],y	and  #%0001110000000000	beq  @noBars;---------------------------------------------------------------@hasBars	ldy  #GrafPort.PortRect.top	lda  [TempPtr],y	sta  vOrigin,s	iny	iny	lda  [TempPtr],y	sta  hOrigin,s	PushZLong TempPtr	_StartDrawing	rts;---------------------------------------------------------------@noBars	brl  SetWindowPort;---------------------------------------------------------------	ENDP****************************************************************RestoreOriginalPort	PROCNAME  Export;---------------------------------------------------------------returnAddr	equ  0;---------------------------------------------------------------;---------------------------------------------------------------	pla		;pull the return address into TempWord	sta  returnAddr	jsr  GetTEHighFlags		;if the record is not a control, then	and  #fNotControl		;..we never need to set the origin	bne  @noBars	jsr  GetWindowPortPtr	ldy  #WindowRecord.wFrame	lda  [TempPtr],y	and  #%0001110000000000	beq  @noBars;---------------------------------------------------------------@hasBars	_SetOrigin		;restore the origin	bra  @exit;---------------------------------------------------------------@noBars	PullAX		;restore the stack;---------------------------------------------------------------@exit	pei  returnAddr		;push the address where set port should	brl  SetPort		;..return to and restore the original port;---------------------------------------------------------------	ENDP****************************************************************	END