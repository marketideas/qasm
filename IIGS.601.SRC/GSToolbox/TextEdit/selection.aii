************************************************************************                      GSTextEdit  Version 1.0*                        File: selection.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************DoSelectText	PROCNAME  Export;---------------------------------------------------------------	jsr  GetWindowPortPtr	;get a pointer to the control's port	jsr  ClearNullStyle		;after a click, don't use the null style	jsr  ClearSavedHPos	ldy  #EventRecord.where.v	;get the global coordinates of the point	lda  [TheEventPtr],y	;..that was clicked.	clc	ldy  #GrafPort.BoundsRect.top	adc  [TempPtr],y	sta  TextVPos	ldy  #EventRecord.where.h	lda  [TheEventPtr],y	clc	ldy  #GrafPort.BoundsRect.left	adc  [TempPtr],y	sta  TextHPos	stz  ClickKind		;the click is single until proved otherwise	ldy  #TERecord.MouseRect	;get the rectangle that encloses the last	jsr  CopyIntoTempRect	;..mouse click.	lda  TextHPos		;is the point inside that rectangle ?	cmp  TempRect.left	bmi  notDouble		;less than	lda  TextHPos	cmp  TempRect.right	bpl  notDouble		;greater than or equal	lda  TextVPos	cmp  TempRect.top	bmi  notDouble		;less than	lda  TextVPos	cmp  TempRect.bottom	bpl  notDouble		;greater than or equal	PushLongSpace		;get the amount of time for a double click	_GetDblTime	ldy  #TERecord.MouseTime	;get the ceiling on the tick count for	pla		;..this click to qualify as a double.	clc	adc  [RecordPtr],y	sta  TempLong	iny	iny	pla	adc  [RecordPtr],y	sta  TempLong+2	ldy  #EventRecord.when+2	;compare the click times - do we have a	lda  [TheEventPtr],y	;..double click	cmp  TempLong+2	blt  wasDouble	bne  notDouble	dey	dey	lda  [TheEventPtr],y	cmp  TempLong	bgt  notDouble;---------------------------------------------------------------wasDouble	inc  ClickKind		;indicate double click	ldy  #TERecord.MouseKind	lda  [RecordPtr],y	beq  notDouble	inc  ClickKind		;indicate triple click;---------------------------------------------------------------notDouble	lda  ClickKind	ldy  #TERecord.MouseKind	sta  [RecordPtr],y	lda  TextHPos	sta  SaveForDoubleClick	dec  a	dec  a	sta  TempRect.left	clc	adc  #4	sta  TempRect.right	lda  TextVPos	dec  a	dec  a	sta  TempRect.top	clc	adc  #4	sta  TempRect.bottom	ldy  #TERecord.MouseRect	;set the rectangle that encloses the last	jsr  CopyFromTempRect	;..mouse click.	ldy  #EventRecord.when+2	lda  [TheEventPtr],y	tax	dey	dey	lda  [TheEventPtr],y	ldy  #TERecord.MouseTime	jsr  SetRecordLong	jsr  GetViewRect	lda  TempRect.left	cmp  TextHPos	bmi  @skipLeft		;less than	sta  TextHPos	sta  SaveForDoubleClick@skipLeft	lda  TempRect.right	cmp  TextHPos	bpl  @skipRight		;greater than or equal	sta  TextHPos	sta  SaveForDoubleClick@skipRight	lda  TempRect.top	cmp  TextVPos	bmi  @skipTop		;less than	sta  TextVPos@skipTop	lda  TempRect.bottom	cmp  TextVPos	bpl  @skipBottom		;greater than or equal	sta  TextVPos@skipBottom	ldy  #EventRecord.modifiers	lda  [TheEventPtr],y	and  #shiftKey	beql noExtend;---------------------------------------------------------------extendIt	jsr  PointToOffset	ldax TextOffset		;initialize the anchor points	stax AnchorPointStart	stax AnchorPointEnd	ldy  #TERecord.SelectionStart	;check to see if we are still at one of	jsr  GetRecordLong		;..the edges	cmpl TextOffset	beq  @takeItOut	bgtl @beforeSelection	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl TextOffset	beq  @takeItOut	bltl @afterSelection	bra  @insideSelection;---------------------------------------------------------------@takeItOut	jsr  removeCaret	brl  enterLoop;---------------------------------------------------------------@insideSelection	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	sec	sbc  TextOffset	sta  TempLong	txa	sbc  TextOffset+2	sta  TempLong+2	ldy  #TERecord.SelectionStart	lda  TextOffset	sec	sbc  [RecordPtr],y	sta  TempWord	iny	iny	lda  TextOffset+2	sbc  [RecordPtr],y	cmp  TempLong+2	blt  @closerStart	bne  @closerEnd	lda  TempWord	cmp  TempLong	blt  @closerStart;---------------------------------------------------------------@closerEnd	ldy  #TERecord.SelectionStart	;save the original start	jsr  PushRecordLong	PushZLong TextOffset	;save, so we can set the new end to TextOffset	jsr  SetSelectionStart	;set the new start to TextOffset	jsr  InvertSelection	;invert the difference	PullAX		;restore the new end	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	PullAX		;restore the original start	stax AnchorPointStart	;set the anchor points	stax AnchorPointEnd	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	brl  enterLoop;---------------------------------------------------------------@closerStart	ldy  #TERecord.SelectionEnd	;save the original end	jsr  PushRecordLong	PushZLong TextOffset	;save, so we can set the new start to TextOffset	jsr  SetSelectionEnd	;set the new end to TextOffset	jsr  InvertSelection	;invert the difference	PullAX		;restore the new start	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	PullAX		;restore the original end	stax AnchorPointStart	;set the anchor points	stax AnchorPointEnd	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	brl  enterLoop;---------------------------------------------------------------@afterSelection	jsr  removeCaret	lda  ClickKind	beq  @notDouble1	dec  a	beq  @notTriple1	jsr  FindLineStart	jsr  MoveOffsetToNextItem	bra  @notDouble1@notTriple1	jsr  FindWordEnd@notDouble1	ldy  #TERecord.SelectionStart	;save the original start	jsr  PushRecordLong	ldy  #TERecord.SelectionEnd	;set the new start to the old end, so we	jsr  GetRecordLong		;..can invert the difference between the	ldy  #TERecord.SelectionStart	;..old and new selections	jsr  SetRecordLong	jsr  SetSelectionEnd	;set the new end from TextOffset	jsr  InvertSelection	;invert the difference	PullAX		;restore the original start	stax AnchorPointStart	;set the anchor points	stax AnchorPointEnd	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	brl  enterLoop;---------------------------------------------------------------@beforeSelection	jsr  removeCaret	lda  ClickKind	beq  @notDouble2	dec  a	beq  @notTriple2	jsr  FindLineStart	bra  @notDouble2@notTriple2	jsr  FindWordStart@notDouble2	ldy  #TERecord.SelectionEnd	;save the original end	jsr  PushRecordLong	ldy  #TERecord.SelectionStart	;set the new end to the old start, so we	jsr  GetRecordLong		;..can invert the difference between the	ldy  #TERecord.SelectionEnd	;..old and new selections	jsr  SetRecordLong	jsr  SetSelectionStart	;set the new start from TextOffset	jsr  InvertSelection	;invert the difference	PullAX		;restore the original end	stax AnchorPointStart	;set the anchor points	stax AnchorPointEnd	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	brl  enterLoop;---------------------------------------------------------------noExtend	jsr  UnhilightSelection	;unhilight the current selection	jsr  PointToOffset	ldax TextOffset	stax AnchorPointStart	stax AnchorPointEnd	lda  ClickKind	beql initSingle	dec  a	beq  initDoubleinitTriple	jsr  FindLineStart	movl TextOffset,AnchorPointStart	jsr  SetSelectionStart	jsr  MoveOffsetToNextItem	movl TextOffset,AnchorPointEnd	jsr  SetSelectionEnd	brl  hilightItinitDouble	PushZLong TextOffset	jsr  IsOffsetAtEnd	beq  @foundIt	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcc  @search	incl TextOffset	bra  @foundIt@search	jsr  FindWordEnd@foundIt	movl TextOffset,AnchorPointEnd	jsr  SetSelectionEnd	PullLong TextOffset	jsr  FindWordStart	movl TextOffset,AnchorPointStart	jsr  SetSelectionStart	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl TextOffset	bne  hilightIt	lda  SaveForDoubleClick	cmp  TextHPos	blt  @goBack	jsr  IsOffsetAtEnd	beq  hilightIt	incl TextOffset	movl TextOffset,AnchorPointEnd	jsr  SetSelectionEnd	bra  hilightIt@goBack	lda  TextOffset	ora  TextOffset+2	beq  hilightIt	decl TextOffset	movl TextOffset,AnchorPointStart	jsr  SetSelectionStarthilightIt	jsr  InvertSelection	bra  enterLoopinitSingle	jsr  SetSelectionStart	jsr  SetSelectionEnd;---------------------------------------------------------------enterLoop	ldy  #TERecord.SelectionState	;force the selection to be on-screen	lda  #$FFFF	sta  [RecordPtr],ymainLoop	PushWordSpace	PushWord #0	_WaitMouseUp	pla	beql done	PushZPtr TextVPos	_GetMouse	mov  FixedHPos,TextHPos	jsr  GetViewRect	lda  TempRect.left	cmp  TextHPos	bmi  @skipLeft		;less than	sta  TextHPos	bra  @skipRight@skipLeft	lda  TempRect.right	cmp  TextHPos	bpl  @skipRight		;greater than or equal	sta  TextHPos@skipRight	lda  TempRect.top	cmp  TextVPos	bmi  @skipTop		;less than	pha		;save the top of the viewRect	ldax #-1	jsr  callScroll	ldy  #TERecord.ViewRect.left	lda  [RecordPtr],y	sta  TextHPos	PullWord TextVPos	bra  @doTheExtend@skipTop	lda  TempRect.bottom	cmp  TextVPos	bpl  @skipBottom		;greater than or equal	pha		;save the bottom of the viewRect	PushZWord TextHPos	ldax #1	jsr  callScroll	PullWord TextHPos	PullWord TextVPos	bra  @doTheExtend@skipBottom@doTheExtend	jsr  PointToOffset	jsr  ExtendToOffset	brl  mainLoop;---------------------------------------------------------------done	jsr  GetSelectionStart	lda  TextOffset	cmp  AnchorPointStart	bne  @isEnd	lda  TextOffset+2	cmp  AnchorPointStart+2	bne  @isEnd@isStart	ldax AnchorPointStart	;save the anchor point	bra  @setIt@isEnd	ldax AnchorPointEnd@setIt	ldy  #TERecord.AnchorPoint	jsr  SetRecordLong	jsr  IsTheSelectionACaret	bne  exit	ldy  #TERecord.SelectionState	;force the selection to be off screen	lda  #$0000	sta  [RecordPtr],y	brl  HilightSelection;---------------------------------------------------------------exit	rts;---------------------------------------------------------------;---------------------------------------------------------------removeCaret	jsr  IsTheSelectionACaret	bne  exit	brl  UnhilightSelection;---------------------------------------------------------------;---------------------------------------------------------------callScroll	PushZLong AnchorPointStart	;save the variables that the scroll code	PushZLong AnchorPointEnd	;..is going to trash	PushZWord ClickKind	PushZWord SaveForDoubleClick	PushAX		;save the amount to scroll	jsr  IsTheSelectionACaret	;if the selection is a caret, then make	bne  @1		;..sure it is marked as offscreen	ldy  #TERecord.SelectionState	lda  #$0000	sta  [RecordPtr],y@1	PullAX		;restore the amount to scroll	jsr  ScrollByAmount	jsr  IsTheSelectionACaret	;if the selection was a caret then mark	bne  @2		;..it as being on screen again	ldy  #TERecord.SelectionState	lda  #$FFFF	sta  [RecordPtr],y@2	PullWord SaveForDoubleClick	;restore the variables that the scroll	PullWord ClickKind		;..code trashed	PullLong AnchorPointEnd	PullLong AnchorPointStart	rts;---------------------------------------------------------------	ENDP****************************************************************ExtendToOffset	PROCNAME  Export;---------------------------------------------------------------	ldy  #TERecord.SelectionStart	;check to see if we are still at one of	jsr  GetRecordLong		;..the edges	cmp  TextOffset	bne  checkEnd	cpx  TextOffset+2	bne  checkEnd	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointEnd	bne  @setIt	cpx  AnchorPointEnd+2	bne  @setIt	rts@setIt	ldy  #TERecord.SelectionStart	jsr  PushRecordLong	ldax AnchorPointEnd	jsr  SetRecordLong	jsr  InvertSelection	ldy  #TERecord.SelectionEnd	ldax AnchorPointEnd	jsr  SetRecordLong	ldy  #TERecord.SelectionStart	bra  setAndExit;---------------------------------------------------------------checkEnd	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  TextOffset	bne  notEdge	cpx  TextOffset+2	bne  notEdge	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @setIt	cpx  AnchorPointStart+2	bne  @setIt	rts@setIt	ldy  #TERecord.SelectionEnd	jsr  PushRecordLong	ldax AnchorPointStart	jsr  SetRecordLong	jsr  InvertSelection	ldy  #TERecord.SelectionStart	ldax AnchorPointStart	jsr  SetRecordLong	ldy  #TERecord.SelectionEndsetAndExit	PullAX	brl  SetRecordLong;---------------------------------------------------------------notEdge	cmpl TextOffset,AnchorPointStart	bltl lessThanAnchor	cmpl TextOffset,AnchorPointEnd	bge  greaterThanAnchor;---------------------------------------------------------------	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @doStart	cpx  AnchorPointStart+2	bne  @doStart	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointEnd	bne  @doEnd	cpx  AnchorPointEnd+2	bne  @doEnd	rts@doEnd	movl AnchorPointEnd,TextOffset	jsr  SetSelectionStart	jsr  InvertSelection	movl AnchorPointEnd,TextOffset	jsr  SetSelectionEnd	movl AnchorPointStart,TextOffset	brl  SetSelectionStart@doStart	movl AnchorPointStart,TextOffset	jsr  SetSelectionEnd	jsr  InvertSelection	movl AnchorPointStart,TextOffset	jsr  SetSelectionStart	movl AnchorPointEnd,TextOffset	brl  SetSelectionEnd;---------------------------------------------------------------greaterThanAnchor	lda  ClickKind	beq  @notDouble	dec  a	beq  @notTriple	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	bra  @checkIt@notTriple	jsr  FindWordEnd@checkIt	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  TextOffset	bne  @notDouble	cpx  TextOffset+2	bne  @notDouble	rts@notDouble	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  AnchorPointStart	bne  @setAnchor	cpx  AnchorPointStart+2	beq  @skipSet@setAnchor	PushZLong TextOffset	jsr  GetSelectionEnd	PushZLong TextOffset	movl AnchorPointStart,TextOffset	jsr  SetSelectionEnd	jsr  InvertSelection	movl AnchorPointStart,TextOffset	jsr  SetSelectionStart	PullLong TextOffset	jsr  SetSelectionEnd	PullLong TextOffset@skipSet	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl TextOffset	blt  extendEnd;---------------------------------------------------------------contractEnd	movl TextOffset,TempLong	PushZLong TextOffset	jsr  GetSelectionStart	PushZLong TextOffset	movl TempLong,TextOffset	jsr  SetSelectionStart	jsr  InvertSelection	PullLong TextOffset	jsr  SetSelectionStart	PullLong TextOffset	brl  SetSelectionEnd;---------------------------------------------------------------extendEnd	stax TempLong	jsr  SetSelectionEnd;---------------------------------------------------------------moveEnd	jsr  GetSelectionStart	PushZLong TextOffset	movl TempLong,TextOffset	jsr  SetSelectionStart	jsr  InvertSelection	PullLong TextOffset	brl  SetSelectionStart;---------------------------------------------------------------;---------------------------------------------------------------lessThanAnchor	lda  ClickKind	beq  @notDouble	dec  a	beq  @notTriple	jsr  FindLineStart	bra  @checkIt@notTriple	jsr  FindWordStart@checkIt	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  TextOffset	bne  @notDouble	cpx  TextOffset+2	bne  @notDouble	rts@notDouble	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmp  AnchorPointEnd	bne  @setAnchor	cpx  AnchorPointEnd+2	beq  @skipSet@setAnchor	PushZLong TextOffset	jsr  GetSelectionStart	PushZLong TextOffset	movl AnchorPointEnd,TextOffset	jsr  SetSelectionStart	jsr  InvertSelection	movl AnchorPointEnd,TextOffset	jsr  SetSelectionEnd	PullLong TextOffset	jsr  SetSelectionStart	PullLong TextOffset@skipSet	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmpl TextOffset	bge  extendStart;---------------------------------------------------------------contractStart	movl TextOffset,TempLong	PushZLong TextOffset	jsr  GetSelectionEnd	PushZLong TextOffset	movl TempLong,TextOffset	jsr  SetSelectionEnd	jsr  InvertSelection	PullLong TextOffset	jsr  SetSelectionEnd	PullLong TextOffset	brl  SetSelectionStart;---------------------------------------------------------------extendStart	stax TempLong	jsr  SetSelectionStart;---------------------------------------------------------------moveStart	jsr  GetSelectionEnd	PushZLong TextOffset	movl TempLong,TextOffset	jsr  SetSelectionEnd	jsr  InvertSelection	PullLong TextOffset	brl  SetSelectionEnd;---------------------------------------------------------------	ENDP****************************************************************Selection1Proc	PROC	EXPORT UnhilightSelection	EXPORT HilightSelection	EXPORT InvertSelection	EXPORT ActivateSelection	EXPORT DeactivateSelection	EXPORT DoInvertInactive;---------------------------------------------------------------ActivateSelection	jsr  DoInvertInactive	ldy  #TERecord.SelectionState	lda  #0	sta  [RecordPtr],y	bra  HilightSelection;---------------------------------------------------------------DeactivateSelection	jsr  UnhilightSelection	bra  DoInvertInactive;---------------------------------------------------------------UnhilightSelection	ldy  #TERecord.SelectionState	lda  [RecordPtr],y	bpl  allDone	lda  #0	sta  [RecordPtr],y		;mark us as off screen	bra  InvertSelection;---------------------------------------------------------------HilightSelection	ldy  #TERecord.SelectionState	lda  [RecordPtr],y	bmi  allDone	lda  #$FFFF	sta  [RecordPtr],y		;mark us as on screen	php		;save the interrupt state	sei		;disable interrupts for this	lda  >TickCnt		;time stamp the last time the selection	ldy  #TERecord.CaretTime	;..went on.	sta  [RecordPtr],y	iny	iny	lda  >TickCnt+2	sta  [RecordPtr],y	plp		;restore interrupt status;---------------------------------------------------------------InvertSelection	NAME	PushZWord TextVPos	PushZWord TextHPos	PushZLong TextOffset	jsr  IsTheSelectionACaret	beq  @doCaret	lda  #ClipAndInvertRect-1	jsr  CreateSelectionRgn	bra  cleanup@doCaret	jsr  makeCaretRect	bcs  cleanup	jsr  ClipAndInvertRect;---------------------------------------------------------------cleanup	PullLong TextOffset		;restore TextOffset	PullWord TextHPos		;restore TextHPos and TextVPos	PullWord TextVPos;---------------------------------------------------------------allDone	rts;---------------------------------------------------------------DoInvertInactive	jsr  GetTEHighFlags		;check to see if we are drawing an	and  #fDrawInactiveSelc	;..inactive selection. If not, then exit	beq  allDone	PushZWord TextVPos	PushZWord TextHPos	PushZLong TextOffset	jsr  IsTheSelectionACaret	beq  @doCaret	jsr  FrameSelectionRgn	bra  cleanup@doCaret	jsr  makeCaretRect	bcs  cleanup	lda  #$FFFF		;pen pattern	ldx  #$AA55		;the mask is all $AA55	jsr  SetupPenState	jsr  ClipAndInvertRect	jsr  RestorePenState	bra  cleanup;---------------------------------------------------------------;---------------------------------------------------------------makeCaretRect	jsr  GetSelectionStart	jsr  CachedOffsetToPoint	bcs  @done	jsr  FindLineInfo	lda  TextVPos	sta  TempRect.top	clc	adc  LineHeight	sta  TempRect.bottom	lda  TextHPos	sta  TempRect.left	inc  a	sta  TempRect.right	clc@done	rts;---------------------------------------------------------------	ENDP****************************************************************FrameSelectionRgn	PROC  ENTRY;---------------------------------------------------------------	DSECT  $00TempRgn1	longTempRgn2	long;---------------------------------------------------------------;---------------------------------------------------------------	PushZLong TempRgn1	PushZLong TempRgn2	jsr  GetNewRgn	stax TempRgn1	jsr  GetNewRgn	stax TempRgn2	lda  #doTheRect-1	jsr  CreateSelectionRgn	PushWordSpace	PushZLong TempRgn2	_EmptyRgn	pla	bne  @skip; 1/11/90 Mensch; Add the following test to see if the control is visible before performing the following; operations. This will prevent the controls from being drawn when the TERecord is invisible;	ldy  #TERecord.CtrlFlag	; 	lda [RecordPtr],y	and #fInvisible	bne @skip		lda  #$FFFF		;pen pattern	ldx  #$FFFF		;pen mask	jsr  SetupPenState	jsr  GetWindowPortPtr	ldy  #GrafPort.PnMode	lda  #modeXOR	sta  [TempPtr],y	PushZLong TempRgn2	_FrameRgn	jsr  RestorePenState@skip	PushZLong TempRgn2	jsr  KillRgn	PushZLong TempRgn1	jsr  KillRgn	PullLong TempRgn2	PullLong TempRgn1	rts;---------------------------------------------------------------;---------------------------------------------------------------doTheRect	jsr  ClipTempRect	PushZLong TempRgn1	PushZPtr TempRect	_RectRgn	PushZLong TempRgn1	PushZLong TempRgn2	PushZLong TempRgn2	_UnionRgn	rts;---------------------------------------------------------------	ENDP****************************************************************CreateSelectionRgn	PROC  ENTRY;---------------------------------------------------------------	pha		;save the routine to call	jsr  GetSelectionStart@loop	jsr  OffsetToPoint	bcc  onTheScreen	ldy  #TERecord.ViewRect.bottom	lda  TextVPos	cmp  [RecordPtr],y	beq  @exit	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	jsr  CompareOffsetWithSelcEnd	blt  @loop@exit	pla		;clean off the stack	rts;---------------------------------------------------------------onTheScreen	jsr  GetLeftEdge		;text edit is always at a line start	clc		;..unless it is at the selection start	ldy  #TERecord.ViewRect.left	;..in which case we will ignore the	adc  [RecordPtr],y		;..incorrect left edge	tax	ldy  #TERecord.SelectionStart	lda  TextOffset	cmp  [RecordPtr],y	bne  @useLeft	iny	iny	lda  TextOffset+2	cmp  [RecordPtr],y	bne  @useLeft	ldx  TextHPos@useLeft	stx  TempRect.left	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	sta  TempRect.right	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	lda  TextVPos	bra  enterLoop;---------------------------------------------------------------mainLoop	jsr  GetLeftEdge		;TextOffset is always at a line start	clc	ldy  #TERecord.ViewRect.left	adc  [RecordPtr],y	sta  TempRect.left	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	lda  TempRect.bottomenterLoop	sta  TempRect.top	clc	adc  LineHeight	sta  TempRect.bottom	jsr  CompareOffsetWithSelcEnd	blt  @1	bne  lastLine	jsr  IsOffsetAtEnd	beq  lastLine@1	pea  @return-1	lda  3,s		;call the line subroutine	pha	rts@return	lda  TempRect.bottom	ldy  #TERecord.ViewRect.bottom	cmp  [RecordPtr],y	blt  mainLoop	pla		;clean off the stack	rts;---------------------------------------------------------------lastLine	bne  @useHPos		;if NE then we are not at the end	ldy  #TERecord.LineAtEndFlag	lda  [RecordPtr],y	bne  @useRightEdge@useHPos	jsr  GetSelectionEnd	jsr  OffsetToHPos	mov  TextHPos,TempRect.right@useRightEdge	rts		;return through the line subroutine;---------------------------------------------------------------	ENDP****************************************************************GetSelectionLength	PROCNAME  Export	jsr  GetSelectionStart	ldy  #TERecord.SelectionEnd	lda  [RecordPtr],y	sec	sbc  TextOffset	sta  SelectionLength	ldy  #TERecord.SelectionEnd+2	lda  [RecordPtr],y	sbc  TextOffset+2	sta  SelectionLength+2	tax	bne  @large	lda  SelectionLength	rts@large	lda  SelectionLength	rep  #%00000010		;clear the zero bit	rts	ENDP****************************************************************IsTheSelectionACaret PROCNAME  Export	ldy  #TERecord.SelectionStart	lda  [RecordPtr],y	ldy  #TERecord.SelectionEnd	cmp  [RecordPtr],y	bne  @done	ldy  #TERecord.SelectionStart+2	lda  [RecordPtr],y	ldy  #TERecord.SelectionEnd+2	cmp  [RecordPtr],y@done	rts	ENDP****************************************************************FindWordEnd	PROCNAME  Export	jsr  IsOffsetAtEnd	beq  @done	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcs  @done@loop	incl TextOffset	jsr  IsOffsetAtEnd	beq  @done	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcc  @loop@done	rts	ENDP****************************************************************FindWordStart	PROCNAME  Export	jsr  IsOffsetAtEnd	bne  @notAtEnd	lda  TextOffset	ora  TextOffset+2	beq  @done	decl TextOffset@notAtEnd	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcs  @done@loop	lda  TextOffset	ora  TextOffset+2	beq  @done	decl TextOffset	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcc  @loop	incl TextOffset@done	rts	ENDP****************************************************************IsItAWordBreak	PROCNAME  Export;---------------------------------------------------------------	and  #$00FF	pha	ldy  #TERecord.WordBreakHook+1	lda  [RecordPtr],y	beq  noHook;---------------------------------------------------------------useHook	tax	PushZLong RecordHandle	lda  5,s		;one word is space for result and the	pha		;..other one is the passed character	dey	lda  [RecordPtr],y	jsl  LongCall	pla	beq  notWordBreak	bra  isWordBreak;---------------------------------------------------------------noHook	pla	cmp  #' '+1	blt  isWordBreak;---------------------------------------------------------------notWordBreak	clc	rts;---------------------------------------------------------------isWordBreak	sec	rts;---------------------------------------------------------------	ENDP****************************************************************	END