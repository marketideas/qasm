************************************************************************                      GSTextEdit  Version 1.0*                           File: text.aii**               Copyright Apple Computer, Inc. 1988-92*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.** 26 July 89	Dave Good** Fixed bug in extracting styles where the refIsPointer and refIsHandle* verbs were reversed and the other two didn't work. Also fixed bug* where PStrings, C1InputStrings, C1OutputStrings and TextBox2 strings* were not being clipped to the buffer properly.** 27 August 89	Dave Good** Fixed bug in deleting text. If the selection started exactly at the* start of a block and continued for more than one block, TextEdit* would leave a zero length block in the block list! This would make* TextEdit hang the next time the block list was searched. I fixed the* bug by checking the first block i modified, to see if it is zero* length. If it is, then i remove it from the list, making sure to* modify the cache in the process.***  5 January 90	Dave Good** Fixed bug in deleting text. If the selection started somewhere in* a block and continued through the next block, the end of the text* would look garbaged. What was happening was the ReplaceBlocks routine* was not updating the BlockLength when it moved to the second block.* This meant that the new length for the second block was derived from* the first block's length instead of it's own length. I fixed this in* two spots by reloading BlockLength directly from the block list structure.** 2/7/90	Mensch** Fixed bug relating to retrieving text into a pascal string in a handle.* seems the handle was always overwritten by $0100 bytes because of improper* use of shortm and longm. This has been fixed.** 2/22/90	Mensch & Stadman** Fixed bug in SetInitialText. When the new text length was zero, the textlength* field of the record was not being updated. It is now updated properly.** 3/2/90	Mensch** Fixed several bugs relating to LETextBox2 output. See code for more info** 4/13/90	Mensch** Added New feature for extract text, it now also allows extraction of the current selection* as an arbitrary block of text. This was added to make life groovy for Iduna and maybe someone* else might like to use it, at any rate... its here... This requires the prepatching of gettextlength* So that it can be modified to support the current selection length.** 8/1/90 - 8/15/90	Mensch* Many changes to the replace text engine. See code for specific comments. Should make input much* smoother and increase reliability.** 17-Nov-92	Dave Lyons** Changed IsAtWordWrap routine to only treat Space specially, not all control characters.* Fixes problem where typing lots of Tabs eventually draws garbage.** 24-Mar-93 JCM** Removed the fix to IsAtWordWrap because it screws up option-arrowing to move to the ends of lines.***********************************************************************	INCLUDE  'GlobalIncludes'	INCLUDE  'E16.Font'****************************************************************ExtractText	PROCNAME  Export;---------------------------------------------------------------	lda  BufferRef		;are we supposed to return text ?	ora  BufferRef+2	bne  @extractIt	ldx  #0		;if not, then return no error	clc	rts;---------------------------------------------------------------@extractIt	lda  BufferVerb		;check the buffer verb for illegal bits	and  #Å(textIsMask+dataIsMask+OnlyGetSelection)	bne  verbError	stz  BufferErrorFlag	;assume the buffer is large enough	lda  BufferVerb		;the buffer length parameter is only	and  #textIsMask		;..significant for textIsPointer;	cmp  #textIsPointer		;..descripters. Otherwise set it to	beq  @skipMaxSet		;.. $FFFF FFFF	lda  #$FFFF	sta  BufferLength	sta  BufferLength+2@skipMaxSet	lda  BufferVerb	and  #dataIsMask	asl  a	tax	jmp  (table,x);---------------------------------------------------------------verbError	ldx  #teInvalidVerb		;return the invalid verb error	sec	rts;---------------------------------------------------------------doPascal	lda  #maxPascalSize		;clip the buffer length to 255 characters	jsr  clipBufferLength	;..and get the total text length in A,X-Reg	incl a		;we need an extra byte for the length	jsr  checkAndSetLength	;check this size against bufferLength	jsr  findBufferPtr		;make a pointer into the buffer;; The following code was changed to fix a handle overwritting bug; length used to be dec'd in short leaving it at $01ff instead of $00ff (handle size -1);; 2/7/90	Mensch;	dec  BufferLength	shortm		;set the text length field in the buffer	lda  BufferLength	sta  [DestPtr]	longm	incl DestPtr		;skip over the length byte	brl  copyTheText;---------------------------------------------------------------doCString	jsr  MyGetTextLength		;get the length of the text and add one	incl a		;..for the terminator	jsr  checkAndSetLength	;check the size against bufferLength	jsr  findBufferPtr		;make a pointer into the buffer	decl BufferLength		;the text length does not include the	addl DestPtr,BufferLength,TempPtr	;..terminator	shortm		;put the terminator byte in the buffer	lda  #0	sta  [TempPtr]	longm	brl  copyTheText;---------------------------------------------------------------doC1Input	lda  #maxC1InputSize	jsr  clipBufferLength	incl a	incl a	jsr  checkAndSetLength	jsr  findBufferPtr	dec  BufferLength	dec  BufferLength	lda  BufferLength	sta  [DestPtr]	lda  #2	addl DestPtr	brl  copyTheText;---------------------------------------------------------------doC1Output	lda  #maxC1OutputSize	jsr  clipBufferLength	clc	adc  #4	bcc  @1	inx@1	jsr  checkAndSetLength	jsr  findBufferPtr	lda  BufferLength	sta  [DestPtr]	sec	sbc  #4	sta  BufferLength	ldy  #2	sta  [DestPtr],y	jsr  AddFourToDestPtr	brl  copyTheText;---------------------------------------------------------------doTextBox2	;; 4/13/90	Mensch; Added test here for the selection only flag. TextBox2 Output will NOT support; this feature no matter what those whiners in DTS say!;	lda  BufferVerb			and  #OnlyGetSelection		beq  @DTB2010	brl  VerbError		; seems I can still call this at this point.@DTB2010	jsr  SetupRulerPtr		;check to see if we need to allocate	ldx  #12		;..space for the extra line space field	ldy  #TERuler.extraLS	lda  [TempPtr],y	beq  @skipLS		;nope, we don't need the extra space field	ldx  #16@skipLS	phx		;save this minimum style size on the stack	ldy  #TERecord.StyleSuper	;get the number of styles items in the	jsr  CountSuperItems	;..record. Multiply this by 14 (16 - 2)	stx  StyleItemCount+2	;..to find the extra number of bytes we	asl  a		;..need for the style information	rol  StyleItemCount+2	pei  StyleItemCount+2	pha	asl  a	rol  StyleItemCount+2	asl  a	rol  StyleItemCount+2	asl  a	rol  StyleItemCount+2	sec	sbc  1,s	sta  StyleItemCount	plx	lda  StyleItemCount+2	sec	sbc  1,s	sta  StyleItemCount+2	plx	pla		;get back the minimum size and add it to	addl StyleItemCount		;..the count for the items to get the total size	lda  #maxTextBox2Size	;clip the buffer length to our maximum	jsr  clipBufferLength	;..size;; 3/1/90	Mensch; Fixed bug here where it was clipping the buffer size to only house the style information; This was causing a hang. Now I get the text length and add it to the style first.; of course this screws up the StyleItemCount information, but... I guess its better than; crashing. ; 	jsr GetTextLength	addl StyleItemCount		;make sure we have this many bytes in the	ldax StyleItemCount	jsr  checkAndSetLength	;..buffer	jsr  findBufferPtr		;lock down ouur buffer;---------------------------------------------------------------	lda  BufferLength		;pre-check for enough space to store the	cmp  #12		;..initial ruler information	bltl @allDone	jsr  SetupRulerPtr	lda  #$4A01		;'J'	sta  [DestPtr]	ldy  #TERuler.Just	lda  [TempPtr],y	ldy  #2	sta  [DestPtr],y	jsr  AddFourToDestPtr	lda  #$4C01		;'L'	sta  [DestPtr]	ldy  #TERuler.LeftMargin	lda  [TempPtr],y	ldy  #2	sta  [DestPtr],y	jsr  AddFourToDestPtr	lda  #$5201		;'R'	sta  [DestPtr]	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	sec	ldy  #TERuler.RightMargin	sbc  [TempPtr],y	ldy  #2	sta  [DestPtr],y	jsr  AddFourToDestPtr	lda  BufferLength	sec	sbc  #12	sta  BufferLength	ldy  #TERuler.extraLS	;add the extra line space information if	lda  [TempPtr],y		;..we need it	beq  @skipExtra	tax	lda  BufferLength	cmp  #4	bltl @allDone	lda  #$5801		;'X'	sta  [DestPtr]	txa	ldy  #2	sta  [DestPtr],y	jsr  AddFourToDestPtr	lda  BufferLength	sec	sbc  #4	sta  BufferLength@skipExtra;---------------------------------------------------------------	stzl TextOffset		;start at the beginning of the text@styleLoop	lda  BufferLength		;do we have enough space for the style	cmp  #14		;..information ? Nope = exit	bltl @allDone	jsr  FindStyleInfo	jsr  SetupStylePtr	lda  #$4601		;'F'	sta  [DestPtr];; 3/2/90	Mensch;; Added +2 here so that the proper high and low words will be in <A><X> when we save to destptr;	ldy  #TEStyle.fontID+2	lda  [TempPtr],y	tax	dey	dey	lda  [TempPtr],y	ldy  #2	sta  [DestPtr],y	iny	iny	txa	sta  [DestPtr],y	iny	iny	lda  #$4301		;'C'	sta  [DestPtr],y	ldy  #TEStyle.foreColor	lda  [TempPtr],y	ldy  #8	sta  [DestPtr],y	iny	iny	lda  #$4201		;'B'	sta  [DestPtr],y	ldy  #TEStyle.backColor	lda  [TempPtr],y	ldy  #12	sta  [DestPtr],y	iny	iny	lda  #14		;move past the style information and	addl DestPtr		;..update our buffer length variable	lda  BufferLength	sec	sbc  #14	sta  BufferLength	jsr  GetSuperCount		;get the number of bytes of text that are	sta  TextCount		;..in this style	lda  BufferLength	sec	sbc  TextCount	sta  BufferLength	bcs  @stillinBuffer	lda  BufferLength	sta  TextCount	lda  #0@stillinBuffer	sta  BufferLength	stz  MoveLength+2		;all our moves are less than 64K@textLoop	jsr  FindTextPtr		;move all the text in this item	movl TextPtr,SourcePtr	lda  BlockCount	cmp  TextCount	blt  @1	lda  TextCount@1	sta  MoveLength	addl TextOffset	jsr  BlockMove	lda  MoveLength	addl DestPtr	lda  TextCount	sec	sbc  MoveLength	sta  TextCount	bne  @textLoop	brl  @styleLoop@allDone	stzl OutputStyleRef		;don't return any style information	brl  releaseBuffer		;release the buffer ref;---------------------------------------------------------------doSelectBlock	; Added routine 4/13/90	Mensch; Added this routine that gets the text contained in the current selection into a text block; This will be similar to the doTextBlock code except that I will extract the starting and ending ; selection. NOTE At this time the stack is set such that ReturnSpace+2 points to the result; from this call... (Which MUST be updated for this output format...)	jsr  GetSelectionLength	; put length of current selection into <X><A>	tay		; save the low word for now...	sta ReturnSpace+2,s	txa	sta ReturnSpace+2+2,s	; and save the high word	tya		; recover low word.	bne @SelectionNotEmpty	cpx #0	bne @SelectionNotEmpty; NOTE: if we are here the selection is empty so return an empty block of text	brl releaseBuffer@SelectionNotEmpty	jsr  checkAndSetLength	jsr  findBufferPtr	jsr  GetSelectionStart	; and set textOffset to start of current selecion	bra  CopyTheText2;---------------------------------------------------------------doTextBlock	jsr  MyGetTextLength	jsr  checkAndSetLength	jsr  findBufferPtr;---------------------------------------------------------------copyTheText	;; 4/13/90	Mensch; Added code at the top here to support the OnlyGetSelection bit; This code will decide how to set the text offset parameter; NOTE At this time the stack is set such that ReturnSpace+2 points to the result; from this call... (Which MUST be updated for this output format...)	lda  BufferVerb			and  #OnlyGetSelection		beq  @NormalCTT		;If flag not set do the normal stuff	lda  BufferLength		; see if there is any text to copy	sta  ReturnSpace+2,s	;	lda  BufferLength+2	sta  ReturnSpace+2+2,s	ora  BufferLength	beq  @SelectionEmpty	jsr  GetSelectionStart	; and set textOffset to start of current selecion	bra  CopyTheText2@SelectionEmpty	brl releaseBuffer @NormalCTT	stzl TextOffset		;start at the beginning of the textCopyTheText2	stz  MoveLength+2		;MoveLength is always less than 64K@loop	jsr  FindTextPtr	movl TextPtr,SourcePtr	lda  BlockCount	ldx  BufferLength+2	bne  @1	cmp  BufferLength	blt  @1	lda  BufferLength@1	sta  MoveLength	addl TextOffset	jsr  BlockMove	lda  MoveLength	addl DestPtr	lda  BufferLength	sec	sbc  MoveLength	sta  BufferLength	bcs  @2	dec  BufferLength+2@2	bne  @loop	ora  BufferLength+2	bne  @loop;---------------------------------------------------------------releaseBuffer	lda  BufferVerb		;release the buffer reference	and  #textIsMask;	cmp  #textIsPointer		;this is zero, so don't need to compare	beq  allDone	cmp  #textIsHandle	beq  @doHandle	cmp  #textIsResource	beq  @doResource@doNewHandle	ldy  #2	lda  NewBufferHandle+2	sta  [BufferRef],y	pha	lda  NewBufferHandle	sta  [BufferRef]	pha	bra  @unlockIt@doResource	PushZLong NewBufferHandle	jsr  UnlockHandle	lda  MustAddResFlag	bmi  @addTheRes@changeTheRes	PushWord #$FFFF	lda  BufferVerb	jsr  VerbToResourceType	phy	PushZLong BufferRef	_MarkResourceChange	bcc  allDone	tax		;return the error code in X-Reg	rts		;the carry is already set@addTheRes	PushZLong NewBufferHandle	PushWord #$0300	lda  BufferVerb	jsr  VerbToResourceType	phy	PushZLong BufferRef	_AddResource	bcc  allDone	tax		;return the error code in X-Reg	rts		;the carry is already set@doHandle	PushZLong BufferRef@unlockIt	jsr  UnlockHandle;---------------------------------------------------------------allDone	ldx  BufferErrorFlag	;if the buffer was full, return buffer	cpx  #1		;..full error	rts;---------------------------------------------------------------table	dc.w  doPascal	dc.w  doCString	dc.w  doC1Input	dc.w  doC1Output	dc.w  doTextBox2	dc.w  doTextBlock	dc.w  verbError		; added 4/13/90 Mensch	dc.w  verbError;---------------------------------------------------------------;---------------------------------------------------------------findBufferPtr	lda  BufferVerb	and  #textIsMask;	cmp  #textIsPointer		;this is zero, so don't need to compare	beq  @doPointer	cmp  #textIsHandle	beq  @doHandle	cmp  #textIsNewHandle	beq  @doNewHandle@doResource	stz  MustAddResFlag	PushLongSpace		;try to load the given resource	lda  BufferVerb	jsr  VerbToResourceType	phy	PushZLong BufferRef	_LoadResource	tax	pla	sta  NewBufferHandle	pla	sta  NewBufferHandle+2	bcs  @makeNewRes@useThisRes	PushZLong NewBufferHandle	ldax BufferLength	jsr  SetHandleSize	bcs  @memoryError	PushZLong NewBufferHandle	bra  @lockIt@makeNewRes	cpx  #$1E06		;if the resource does not exist, then fall	bne  @memoryError		;..thru to @doNewHandle, otherwise exit	dec  MustAddResFlag		;set the must add flag to minus one@doNewHandle	ldax BufferLength		;this works for both textIsResource and	jsr  GetLargeHandle		;..textIsNewHandle	bcs  @memoryError	stax NewBufferHandle	PushAX	bra  @lockIt@doPointer	ldax BufferRef	bra  @setPtr@doHandle	PushZLong BufferRef		;set the user's handle to the correct size	ldax BufferLength	jsr  SetHandleSize	bcs  @memoryError	PushZLong BufferRef@lockIt	jsr  LockHandle@setPtr	stax DestPtr	rts@memoryError	pla		;pull off one return address	rts;---------------------------------------------------------------;MyGetTextLength;; 4/16/90	Mensch; Added code to clip the buffer length to the current selection if the OnlyGetSelection bit; is set in text edit. Also, I will be calling getSelStart to set the text offset properly; if said bit is set!	; First test the verb to see if we want to modify contents of <A><X>; Also note that this routine relies on us being inside of 2 jsr's so we can modify; return space properly...	lda  BufferVerb			and  #OnlyGetSelection		beq  @NormalGTL		;If flag not set do the normal stuff	brl  GetSelectionLength	; put length of current selection into <X><A>@NormalGTL	brl  GetTextLength;---------------------------------------------------------------checkAndSetLength	cpx  BufferLength+2	blt  @bufferOK	bne  @bufferTooSmall	cmp  BufferLength	bgt  @bufferTooSmall@bufferOK	stax BufferLength	rts@bufferTooSmall	lda  #teBufferOverflow	sta  BufferErrorFlag	rts;---------------------------------------------------------------;---------------------------------------------------------------clipBufferLength	ldx  BufferLength+2	bne  @1	cmp  BufferLength	bge  @2@1	sta  BufferLength	stz  BufferLength+2@2	brl  MyGetTextLength;---------------------------------------------------------------	ENDP****************************************************************VerbToResourceType	PROCNAME  Entry	and  #dataIsMask	cmp  #dataIsPString	bne  @1	ldy  #rPString	rts@1	cmp  #dataIsCString	bne  @2	ldy  #rCString	rts@2	cmp  #dataIsC1Input	bne  @3	ldy  #rC1InputString	rts@3	cmp  #dataIsC1Output	bne  @4	ldy  #rC1OutputString	rts@4		cmp  #dataIsTextBox2	bne  @5	ldy  #rTextBox2	rts@5	ldy  #rTextBlock	;must be textBlock	rts	ENDP****************************************************************ExtractStyles	PROCNAME  Export;---------------------------------------------------------------	lda  OutputStyleRef		;are we returning styles ?	ora  OutputStyleRef+2	bne  extractIt	ldx  #0		;if not, then return no error	clc	rts;---------------------------------------------------------------extractIt	lda  OutputStyleVerb	;check for a verb error	and  #ÅrefIsMask	bnel verbError	jsr  GetStyleRecordSize	stax TempLong	lda  OutputStyleVerb;	cmp  #refIsPointer		;since refIsPointer is $0000 we don't	beq  @doPointer		;..need this	cmp  #refIsHandle	beq  @doHandle	cmp  #refIsNewHandle	beq  @doNewHandle@doResource	stz  MustAddResFlag	PushLongSpace		;try to load the given resource	PushWord #rStyleBlock	PushZLong OutputStyleRef	;the resource ID	_LoadResource	tax	pla	sta  NewBufferHandle	pla	sta  NewBufferHandle+2	bcs  @makeNewRes@useThisRes	PushZLong NewBufferHandle	ldax TempLong	jsr  SetHandleSize	bcsl memoryError	PushZLong NewBufferHandle	bra  @lockIt@makeNewRes	cpx  #$1E06		;if the resource does not exist, then fall	bnel memoryError		;..thru to @doNewHandle, otherwise exit	dec  MustAddResFlag		;set the must add flag to minus one@doNewHandle	ldax TempLong	jsr  GetLargeHandle	bcsl memoryError	stax NewBufferHandle	PushAX	bra  @lockIt@doPointer	ldax OutputStyleRef	bra  @setPtr@doHandle	PushZLong OutputStyleRef	ldax TempLong	jsr  SetHandleSize	bcsl memoryError	PushZLong OutputStyleRef@lockIt	jsr  LockHandle@setPtr	stax DestPtr;---------------------------------------------------------------	lda  #StyleRecordVersion	;the version is the first word.	sta  [DestPtr]	incl DestPtr	incl DestPtr	ldy  #TERecord.RulerList	;add the ruler list to the style record.	jsr  addTheListToDestPtr	ldy  #TERecord.StyleList	jsr  addTheListToDestPtr	lda  StyleItemCount		;set the style item count field in the	sta  [DestPtr]		;..style record	ldy  #2	lda  StyleItemCount+2	sta  [DestPtr],y	jsr  AddFourToDestPtr;---------------------------------------------------------------copyItems	ldy  #TERecord.StyleSuper	jsr  GetSuperRecordPtr	jsr  MoveToFirstSuperHandle          IF SuperItemSize <> 8 THEN              AERROR 'WARNING... This code relies on the SuperItemSize equate being eight'          ENDIFmainLoop	ldy  #SuperHandle.itemsPerBlock	;get the number of items per block	lda  [SuperRecordPtr],y	tax		;use X-Reg as our item counter	lda  TempPtr		;get a pointer to the beginning of the	clc		;..style items	adc  #SuperBlock.RecordSize	sta  SourcePtr	lda  TempPtr+2	adc  #0	sta  SourcePtr+2	ldy  #2@loop	lda  [SourcePtr],y		;check for a deleted entry	bmi  @skipEntry	ldy  #6		;it is not deleted, so copy it	lda  [SourcePtr],y	sta  [DestPtr],y	ldy  #4	lda  [SourcePtr],y	sta  [DestPtr],y	ldy  #2	lda  [SourcePtr],y	sta  [DestPtr],y	lda  [SourcePtr]	sta  [DestPtr]	jsr  AddEightToDestPtr@skipEntry	jsr  AddEightToSourcePtr	dex	bne  @loop	jsr  MoveToNextHandle	bcc  mainLoop;---------------------------------------------------------------cleanup	lda  OutputStyleVerb;	cmp  #refIsPointer		;since refIsPointer is $0000 we don't	beq  noError		;..need this	cmp  #refIsHandle	beq  @doHandle	cmp  #refIsResource	beq  @doResource@doNewHandle	ldy  #2	lda  NewBufferHandle+2	sta  [OutputStyleRef],y	pha	lda  NewBufferHandle	sta  [OutputStyleRef]	pha	bra  @unlockIt@doResource	PushZLong NewBufferHandle	jsr  UnlockHandle	lda  MustAddResFlag	bmi  @addTheRes@changeTheRes	PushWord #$FFFF	PushWord #rStyleBlock	PushZLong OutputStyleRef	;the resource ID	_MarkResourceChange	tax	bra  allDone@addTheRes	PushZLong NewBufferHandle	PushWord #$0300	PushWord #rStyleBlock	PushZLong OutputStyleRef	;the resource ID	_AddResource	tax	bra  allDone@doHandle	PushZLong OutputStyleRef@unlockIt	jsr  UnlockHandle;---------------------------------------------------------------noError	ldx  #0allDone	clc	rts;---------------------------------------------------------------verbError	ldx  #teInvalidVerb	secmemoryError	rts		;the carry is already set;---------------------------------------------------------------;---------------------------------------------------------------addTheListToDestPtr	jsr  PushRecordLong	jsr  PushRecordLong	jsr  DerefHandle	stax SourcePtr	jsr  GetHandleSize	sec	sbc  #4	bcs  @1	dex@1	stax MoveLength	ldy  #2	sta  [DestPtr]	txa	sta  [DestPtr],y	jsr  AddFourToDestPtr	jsr  BlockMove	addl DestPtr,MoveLength,DestPtr	rts;---------------------------------------------------------------	ENDP****************************************************************GetStyleRecordSize	PROCNAME  Export;---------------------------------------------------------------          IF SuperItemSize <> 8 THEN              AERROR 'WARNING... This code relies on the SuperItemSize equate being eight'          ENDIF;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #TERecord.StyleSuper	;find the total size of the style handle	jsr  CountSuperItems	;..to return.	stax StyleItemCount	stx  TempLong+2	asl  a		;multiply by eight	rol  TempLong+2	asl  a	rol  TempLong+2	asl  a	rol  TempLong+2	clc	adc  #14	sta  TempLong	bcc  @1	inc  TempLong+2@1	ldy  #TERecord.RulerList	;add the size of the ruler list to the	jsr  addListSize		;..size of the style items	ldy  #TERecord.StyleList	;add the size of the style list and exit	jsr  addListSize	ldax TempLong	rts;---------------------------------------------------------------addListSize	jsr  PushRecordLong	jsr  GetHandleSize	sec	sbc  #4	bcs  @1	dex@1	clc	adc  TempLong	sta  TempLong	txa	adc  TempLong+2	sta  TempLong+2	rts;---------------------------------------------------------------	ENDP****************************************************************SetInitialText	PROCNAME  Export;---------------------------------------------------------------	lda  InputTextLength	ora  InputTextLength+2	beq  SetTextLength;---------------------------------------------------------------doIt	ldy  #TERecord.MaximumChars	;clip the text length to the maximum	jsr  GetRecordLong		;..number of characters	cmpl InputTextLength	bge  @noClip	stax InputTextLength@noClip	movl InputTextLength,BlockLength	;set the block size	jsr  CachedBlockToPtr	jsr  SetBlockSize	bcs  memoryError	ldy  #2		;get a pointer to the block that will	lda  [BlockHandle]		;..contain the text.	clc	adc  #TextBlock.textStart	sta  DestPtr	lda  [BlockHandle],y	adc  #0	sta  DestPtr+2	movl InputTextPtr,SourcePtr	movl InputTextLength,MoveLength	jsr  BlockMove		;block move it all in.SetTextLength	ldy  #TERecord.TextLength	;set the length field in the TERecord	ldax InputTextLength	clc	brl  SetRecordLong		;this preserves the carry flag;---------------------------------------------------------------memoryError	rts		;the carry is already set;---------------------------------------------------------------	ENDP****************************************************************SetInitialStyle	PROCNAME  Export;---------------------------------------------------------------	lda  InputStyleRef	ora  InputStyleRef+2	bne  doStylesskipStyles	ldy  #TERecord.StyleList	;crunch the style list handle down to one	jsr  PushRecordLong		;..item.	jsr  PushRecordLong	ldax #TEStyle.RecordSize+4	jsr  SetHandleSize	jsr  DerefHandle	stax TempPtr	ldy  #TEStyle.RecordSize	jsr  TerminateTempPtr	movl InputTextLength,SuperLength	stzl TextStyleOffset	jsr  SetStyleInfo	clc	rts;---------------------------------------------------------------doStyles	movl InputStylePtr,SourcePtr	lda  [SourcePtr]		;check the style record version	cmp  #StyleRecordVersion	bne  skipStyles	incl SourcePtr	incl SourcePtr	ldy  #TERecord.RulerList	;copy the ruler list	jsr  copyToList	ldy  #TERecord.StyleList	;copy the style list	jsr  copyToList	jsr  GetTEHighFlags		;if the record is single style, go back and	and  #fSingleStyle		;..use just the first style	bne  skipStyles	lda  [SourcePtr]		;get the number of items in the style	sta  StyleItemCount		;..super array	ldy  #2	lda  [SourcePtr],y	sta  StyleItemCount+2	jsr  AddFourToSourcePtr	ldy  #TERecord.StyleSuper	;setup the style record pointer	jsr  GetSuperRecordPtr	lda  StyleItemCount+2	;check to see how many items we have - do	bne  @doLarge		;..we need a small, medium, or large super	lda  StyleItemCount	cmp  #ItemsInSmallBlock+1	blt  @doSmall	cmp  #ItemsInMediumBlock+1	blt  @doMedium@doLarge	lda  #ItemsInLargeBlock	bra  allocIt@doMedium	lda  #ItemsInMediumBlock	bra  allocIt@doSmall	lda  #ItemsInSmallBlockallocIt	ldy  #SuperHandle.itemsPerBlock	;set the items per block field	sta  [SuperRecordPtr],y	ldy  #SuperHandle.cachedHandle+2	;save the cached super handle on the	lda  [SuperRecordPtr],y	;..stack	pha	dey	dey	lda  [SuperRecordPtr],y	pha	jsr  GetSuperMaxIndex	;find the correct size	lda  SuperMaxIndex	dec  a	dec  a	ldx  #0	jsr  SetHandleSize	bcc  @ok	ldy  #SuperHandle.itemsPerBlock	;we got an error, so reset the items per	lda  #ItemsInSmallBlock	;..block field and exit	sta  [SuperRecordPtr],y	rts		;the X-Reg and carry are still set here@ok	jsr  ClearSuperCachedHandle	movl InputTextLength,TempLong	;this is the total length of the text;---------------------------------------------------------------mainLoop	ldy  #SuperHandle.itemsPerBlock	;get the number of items per block	lda  [SuperRecordPtr],y	tax	lda  StyleItemCount+2	bne  @tooBig	cpx  StyleItemCount	blt  @tooBig	ldx  StyleItemCount	stz  StyleItemCount	bra  @doIt@tooBig	stx  TempWord	lda  StyleItemCount	sec	sbc  TempWord	sta  StyleItemCount	bcs  @doIt	dec  StyleItemCount+2@doIt	lda  #SuperBlock.RecordSize	clc	adc  TempPtr	sta  DestPtr	lda  TempPtr+2	adc  #0	sta  DestPtr+2	stzl MoveLength	txa		;see if there are any items at all. If	bne  @loop		;..there are, then copy them@noItems	ldy  #6		;A-Reg is zero here	sta  [DestPtr],y	dey	dey	sta  [DestPtr],y	dey	dey	lda  InputTextLength+2	;set the length of both the item and	sta  [DestPtr],y		;..the text length to the total text length	ldy  #SuperBlock.textLength	sta  [TempPtr],y	dey	dey	lda  InputTextLength	sta  [DestPtr]	sta  [TempPtr],y	brl  allDone          IF SuperItemSize <> 8 THEN              AERROR 'WARNING... This code relies on the SuperItemSize equate being eight'          ENDIF@loop	lda  [SourcePtr]	sta  [DestPtr]	sta  SuperLength	clc	adc  MoveLength	sta  MoveLength	ldy  #2	lda  [SourcePtr],y	sta  [DestPtr],y	sta  SuperLength+2	adc  MoveLength+2	sta  MoveLength+2	ldy  #4	lda  [SourcePtr],y	sta  [DestPtr],y	ldy  #6	lda  [SourcePtr],y	sta  [DestPtr],y	lda  SuperLength	ora  SuperLength+2	beq  @atTheEnd	lda  TempLong		;subtract the item length from the	sec		;..remaining total length	sbc  SuperLength	sta  TempLong	lda  TempLong+2	sbc  SuperLength+2	sta  TempLong+2	bcc  @atTheEnd	jsr  AddEightToSourcePtr	jsr  AddEightToDestPtr	dex	bne  @loop	ldy  #SuperBlock.textLength	lda  MoveLength	sta  [TempPtr],y	iny	iny	lda  MoveLength+2	sta  [TempPtr],y	lda  StyleItemCount	ora  StyleItemCount+2	beq  allDone	PushZLong TempLong	ldy  #TERecord.StyleSuper	jsr  AddANewSuperHandle	PullLong TempLong	bccl mainLoop@memoryError	phx		;save the error code	ldy  #TERecord.StyleSuper	;if there was an error, then kill the old	jsr  KillSuperHandle	;.. style super array and get a new one	ldy  #TERecord.StyleSuper	jsr  GetNewSuperHandle	plx		;restore the error code and set the carry	sec		;..flag. Then exit	rts@atTheEnd	lda  TempLong		;make the length of the item be the remaining	clc		;..length of the text (we must add super	adc  SuperLength		;..length since it has been subtracted	sta  [DestPtr]		;..from the remaining length)	ldy  #2	lda  TempLong+2	adc  SuperLength+2	sta  [DestPtr],y	ldy  #SuperBlock.textLength	;the length of this block is (MoveLength	lda  MoveLength		;..- SuperLength + (TempLong + SuperLength))	clc		;..which is just (MoveLength + TempLong)	adc  TempLong	sta  [TempPtr],y	iny	iny	lda  MoveLength+2	adc  TempLong+2	sta  [TempPtr],y		;fall thru into all done;---------------------------------------------------------------allDone	clc	rts;---------------------------------------------------------------;---------------------------------------------------------------copyToList	jsr  PushRecordLong		;save the list handle twice	jsr  PushRecordLong	ldy  #2		;get the list length into MoveLength and	lda  [SourcePtr],y		;..A,X-Reg	sta  MoveLength+2	tax	lda  [SourcePtr]		;get the length of the list into MoveLength	sta  MoveLength	clc		;add four to the list size	adc  #4	bcc  @1	inx@1	jsr  SetHandleSize		;set the new list size	bcs  @memoryError	jsr  DerefHandle	stax DestPtr	jsr  AddFourToSourcePtr	;move the sourcePtr past the length field	jsr  BlockMove	addl SourcePtr,MoveLength,SourcePtr	addl DestPtr,MoveLength,TempPtr	ldy  #0	brl  TerminateTempPtr@memoryError	tsc		;pull off one copy of the list handle and	clc		;..the return address	adc  #6	tcs	sec	rts;---------------------------------------------------------------	ENDP****************************************************************SetInitialTextAndStyle PROCNAME  Export;---------------------------------------------------------------	jsr  TranslateInputVerbs	bcs  error	jsr  SetInitialText		;set the initial text	bcs  memoryError1	jsr  SetInitialStyle	;set the initial style information	bcs  memoryError2	jsr  ReleaseInputVerbs	jsr  InitialWordWrap	;wrap the text.	jsr  GetVertScrollBar	;set the scroll bar and all associated	beq  @skipSet		;..fields to the top	PushWord #0	PushAX	_SetCtlValue@skipSet	ldy  #TERecord.TopTextVPos	lda  #0	sta  [RecordPtr],y	tax	ldy  #TERecord.VertScrollPos	jsr  SetRecordLong	stzl TextOffset	jsr  SetScreenTopOffset	jsr  SetSelectionStart	;set the current selection to the top.	jsr  SetSelectionEnd	jsr  ClearSavedHPos	ldx  #0	clc	rts;---------------------------------------------------------------memoryError2	phx	jsr  KillBlockList		;destroy the block list and get a fresh	jsr  NewBlockList		;..one	plx;---------------------------------------------------------------memoryError1	phx		;if we got an error, then release the	jsr  ReleaseInputVerbs	;..input verbs	plx;---------------------------------------------------------------error	brl  SetLastErrorCode	;notify the filter: we're out of memory;---------------------------------------------------------------	ENDP****************************************************************TranslateInputVerbs	PROCNAME  Export;---------------------------------------------------------------	lda  InputTextVerb	and  #Å(textIsMask+dataIsMask)	bne  verbError	lda  InputStyleVerb	cmp  #refIsNewHandle	beq  verbError	and  #ÅrefIsMask	bne  verbError	lda  InputTextRef		;if the text ref is NULL, then just	ora  InputTextRef+2		;..destroy all the old text, but don't	bne  @doIt		;..move any new stuff in.	stzl InputTextLength	lda  #textIsPointer	sta  InputTextVerb	brl  TranslateInputStyle@doIt	lda  InputTextVerb	and  #dataIsMask	asl  a	tax	jmp  (theTable,x);---------------------------------------------------------------doPascal	jsr  GetInputTextPtr	lda  [InputTextPtr]	and  #$00FF	sta  InputTextLength	stz  InputTextLength+2	lda  #1	bra  addToInputPtr;---------------------------------------------------------------doCString	jsr  GetInputTextPtr	stz  InputTextLength+2	ldy  #0	shortm@loop	lda  [InputTextPtr],y	beq  @done	iny	bne  @loop	inc  InputTextLength+2	inc  InputTextPtr+2	bra  @loop@done	longm	sty  InputTextLength	lda  InputTextPtr+2	sec	sbc  InputTextLength+2	sta  InputTextPtr+2	bra  TranslateInputStyle;---------------------------------------------------------------verbError	ldx  #teInvalidVerb	sec	rts;---------------------------------------------------------------doC1Input	jsr  GetInputTextPtr	lda  [InputTextPtr]	sta  InputTextLength	stz  InputTextLength+2	lda  #2	bra  addToInputPtr;---------------------------------------------------------------doC1Output	jsr  GetInputTextPtr	ldy  #2	lda  [InputTextPtr],y	sta  InputTextLength	stz  InputTextLength+2	lda  #4;---------------------------------------------------------------addToInputPtr	addl InputTextPtr	bra  TranslateInputStyle;---------------------------------------------------------------doTextBlock	jsr  GetInputTextPtr	lda  InputTextVerb	and  #textIsMask;	cmp  #textIsPointer		;this is zero, so don't need to compare	beq  TranslateInputStyle	PushZLong TempLong	jsr  GetHandleSize	stax InputTextLength	;fall through into translate input style;---------------------------------------------------------------;---------------------------------------------------------------TranslateInputStyle	lda  InputStyleRef	ora  InputStyleRef+2	bne  @doIt	lda  #refIsPointer	sta  InputStyleVerb	bra  allDone@doIt	lda  InputStyleVerb;	cmp  #refIsPointer		;since refIsPointer is $0000 we don't	beq  @doPointer		;..need this	cmp  #refIsHandle	beq  @doHandle@doResource	ldy  #rStyleBlock		;loads the resource into memory. NOTE: we	ldax InputStyleRef		;..never release this resource	jsr  LoadResource	PushAX	bra  @lockIt@doHandle	PushZLong InputStyleRef@lockIt	jsr  LockHandle	bra  @setPtr@doPointer	ldax InputStyleRef@setPtr	stax InputStylePtr;---------------------------------------------------------------allDone	ldx  #0	clc	rts;---------------------------------------------------------------;---------------------------------------------------------------theTable	dc.w  doPascal	dc.w  doCString	dc.w  doC1Input	dc.w  doC1Output	dc.w  TranslateTextBox2	dc.w  doTextBlock	dc.w  verbError	dc.w  verbError;---------------------------------------------------------------	ENDP****************************************************************GetInputTextPtr	PROCNAME  Entry;---------------------------------------------------------------	lda  InputTextVerb	and  #textIsMask;	cmp  #textIsPointer		;this is zero, so don't need to compare	beq  @doPointer	cmp  #textIsHandle	beq  @doHandle	cmp  #textIsNewHandle	beq  verbError@doResource	lda  InputTextVerb	jsr  VerbToResourceType	;this returns the type in the Y-Reg	ldax InputTextRef	jsr  LoadResource	bra  @lockIt@doHandle	ldax InputTextRef@lockIt	stax TempLong	PushAX	jsr  LockHandle	bra  @setPtr@doPointer	ldax InputTextRef@setPtr	stax InputTextPtr	rts;---------------------------------------------------------------verbError	ldx  #teInvalidVerb	pla		;pull off the return address so we return	sec		;..one level upwards	rts;---------------------------------------------------------------	ENDP****************************************************************TranslateTextBox2	PROCNAME  Export;---------------------------------------------------------------;	jsr  GetInputTextPtr	;must take out the GetInputTextPtr right;	lda  InputTextVerb		;..after setupInitialStyle, when this code;	and  #textIsMask		;..gets uncommented;	cmp  #textIsPointer		;this is zero, so don't need to compare;	beq  @skipGetLength;	PushZLong TempLong;	jsr  GetHandleSize;	stax InputTextLength	;fall through into translate input style@skipGetLength	lda  InputTextLength+2	bne  formatError	lda  InputTextLength	cmp  #maxTextBox2Size+1	blt  lengthOK;---------------------------------------------------------------formatError	ldx  #teInvalidTextBox2	sec	rts;---------------------------------------------------------------lengthOK	lda  #TEStyleRecord.RecordSize+4	;get a new handle of the minimum size	jsr  GetClearHandle	bcc  @gotTheMemory	rts@gotTheMemory	stax InputStyleRef	PushAX	jsr  LockHandle	stax InputStylePtr	ldy  #TEStyleRecord.rulerListLength	lda  #TERuler.RecordSize	sta  [InputStylePtr],y	ldy  #TEStyleRecord.rulerList.tabType	lda  #DefaultTabType	sta  [InputStylePtr],y	ldy  #TEStyleRecord.rulerList.numberOfTabs	lda  #DefaultTabValue	sta  [InputStylePtr],y	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	sec	ldy  #TERecord.ViewRect.left	sbc  [RecordPtr],y	ldy  #TEStyleRecord.rulerList.rightMargin	sta  [InputStylePtr],y	jsr  GetWindowPortPtr	ldy  #GrafPort.FontID+2	;re-install the current font, in case	lda  [TempPtr],y		;..we are using the system font	pha	dey	dey	lda  [TempPtr],y	pha	PushWord #$0000	PushZPtr TempWord		;push a pointer to the FntStatRec	_InstallWithStats	ldy  #GrafPort.FontID	;re-install the current font, in case	lda  [TempPtr],y		;..we are using the system font	sta  TempStyle.fontID	iny	iny	lda  [TempPtr],y	sta  TempStyle.fontID+2	lda  TempLong+2	and  #purgeBit	beq  @skipPurge	PushZLong TempStyle.fontID	pei  TempLong+2	_SetPurgeStat@skipPurge	ldy  #GrafPort.FGColor	lda  [TempPtr],y	sta  TempStyle.foreColor	ldy  #GrafPort.BGColor	lda  [TempPtr],y	sta  TempStyle.backColor	stzl TempStyle.userData;---------------------------------------------------------------setupInitialStyle	jsr  GetInputTextPtr	ldy  #0@loop	lda  [InputTextPtr],y	and  #$00FF	cmp  #$01	bnel doTheText	iny	lda  [InputTextPtr],y	and  #$00FF	cmp  #'J'	beq  @doJust	cmp  #'L'	beq  @doLeft	cmp  #'M'	beq  @doRight	cmp  #'X'	beq  @doExtra	cmp  #'S'	beq  @doStyle	cmp  #'C'	beq  @doForeColor	cmp  #'B'	beq  @doBackColor	cmp  #'F'	beq  @doFont@skipChange	iny@skipWord	iny	iny	cpy  InputTextLength	blt  @loop	bnel formatError	brl  noText@doJust	phy	iny	lda  [InputTextPtr],y	ldy  #TEStyleRecord.rulerList.just	sta  [InputStylePtr],y	ply	bra  @skipChange@doLeft	phy	iny	lda  [InputTextPtr],y	ldy  #TEStyleRecord.rulerList.leftMargin	sta  [InputStylePtr],y	ldy  #TEStyleRecord.rulerList.leftIndent	sta  [InputStylePtr],y	ply	bra  @skipChange@doRight	phy	iny	lda  [InputTextPtr],y	sta  TempWord	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	sec	sbc  TempWord	ldy  #TEStyleRecord.rulerList.rightMargin	sta  [InputStylePtr],y	ply	bra  @skipChange@doExtra	phy	iny	lda  [InputTextPtr],y	ldy  #TEStyleRecord.rulerList.extraLS	sta  [InputStylePtr],y	ply	bra  @skipChange@doStyle	iny	shortm	lda  [InputTextPtr],y	sta  TempStyle.fontAttr	longm	bra  @skipWord@doForeColor	iny	lda  [InputTextPtr],y	sta  TempStyle.foreColor	bra  @skipWord@doBackColor	iny	lda  [InputTextPtr],y	sta  TempStyle.backColor	bra  @skipWord@doFont	iny	lda  [InputTextPtr],y	sta  TempStyle.fontID	iny	iny	lda  [InputTextPtr],y	sta  TempStyle.fontID+2	bra  @skipWord;---------------------------------------------------------------doTheText	sty  FirstTextIndex	lda  InputTextLength	sta  MoveLength		;get a new handle that is the total size	jsr  GetSmallHandle		;..of the text and style (we will cut it	bcc  @memoryOK		;..down later)	phx		;save the error code	ldax InputStyleRef		;kill the style handle	jsr  KillHandle	stzl InputStyleRef		;zero out the styles and text	stzl InputTextRef	plx		;restore the error code and set the carry	sec	rts@memoryOK	stax NewBufferHandle	jsr  DerefAX	decl a	stax DestPtr	ldy  #0	shortm@loop	lda  [InputTextPtr],y	iny	cmp  #$01		;this is the change flag	beq  @change	sta  [DestPtr],y	cpy  InputTextLength	blt  @loop	rep  #$20		;back to long mode	bra  @textDone@change	ldx  #-4	lda  [InputTextPtr],y	cmp  #'F'	bne  @skipWord	ldx  #-6	iny	iny@skipWord	iny	iny	iny	longm	txa	clc	adc  DestPtr	sta  DestPtr	bcs  @1	dec  DestPtr+2@1	shortm	cpy  InputTextLength	blt  @loop	longm		;back to long mode	bnel formatError;---------------------------------------------------------------@textDone	PushZLong NewBufferHandle	PushZLong NewBufferHandle	jsr  GetHandleSize	sec		;add an extra one for the one that we	adc  DestPtr		;..subtracted earlier to make the ptrs	sta  DestPtr		;..come out	txa	adc  DestPtr+2	sta  DestPtr+2	ldy  #2	lda  DestPtr	sec	sbc  [NewBufferHandle]	pha	lda  DestPtr+2	sec	sbc  [NewBufferHandle],y	tax	pla		;this is always smaller, so we don't need	jsr  SetHandleSize		;..to check for memory errors;---------------------------------------------------------------doTheStyles	PushZLong InputStyleRef	jsr  UnlockHandle	ldy  #TERecord.StyleList	jsr  PushRecordLong	stzl TextStyleOffset	jsr  GetTerminatedHandle	ldy  #TERecord.StyleList	jsr  SetRecordLong	tdc		;add the first style to the list	clc	adc  #TempStyle	ldx  #0	jsr  AddToStyleList;---------------------------------------------------------------	ldy  FirstTextIndexmainStyleLoop	stz  NewStyleLength@loop	lda  [InputTextPtr],y	and  #$00FF	cmp  #$01	beq  @doChange	inc  NewStyleLength	iny	cpy  InputTextLength	blt  @loop	brl  @addTheLastOne@doChange	iny	lda  [InputTextPtr],y	and  #$00FF	cmp  #'S'	beq  @doStyle	cmp  #'C'	beq  @doForeColor	cmp  #'B'	beq  @doBackColor	cmp  #'F'	beq  @doFont	iny@skipWord	iny	iny	cpy  InputTextLength	beq  @addTheLastOne	blt  @1	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  KillHandle	PullAX	ldy  #TERecord.StyleList	jsr  SetRecordLong	brl  formatError@1	lda  [InputTextPtr],y	and  #$00FF	cmp  #$01	beq  @doChange	bra  @addTheStyle@doStyle	iny	shortm	lda  [InputTextPtr],y	sta  TempStyle.fontAttr	longm	bra  @skipWord@doForeColor	iny	lda  [InputTextPtr],y	sta  TempStyle.foreColor	bra  @skipWord@doBackColor	iny	lda  [InputTextPtr],y	sta  TempStyle.backColor	bra  @skipWord@doFont	iny	lda  [InputTextPtr],y	sta  TempStyle.fontID	iny	iny	lda  [InputTextPtr],y	sta  TempStyle.fontID+2	bra  @skipWord@addTheStyle	phy		;save the current index	PushZLong TextStyleOffset	tdc	clc	adc  #TempStyle	ldx  #0	jsr  AddToStyleList	PullAX	stax TempLong	ply		;restore the current index	cmpl TextStyleOffset	beql @loop	phy		;save the current index	jsr  addStyleItem	ply		;restore the current index	brl  mainStyleLoop@addTheLastOne	movl TextStyleOffset,TempLong	jsr  addStyleItem;---------------------------------------------------------------combineTheStyle	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  PushRecordLong	jsr  GetHandleSize	stax TempLong	PushZLong InputStyleRef	PushZLong InputStyleRef	jsr  GetHandleSize	stax MoveLength	clc	adc  TempLong	pha	txa	adc  TempLong+2	tax	pla	jsr  SetHandleSize	lda  MoveLength	sec	sbc  #TEStyleRecord.RecordSize+4	sta  MoveLength	bcs  @1	dec  MoveLength+2@1	PushZLong InputStyleRef	jsr  DerefHandle		;use the saved style list handle	clc	adc  #TEStyleRecord.RecordSize+4	bcc  @2	inx@2	stax SourcePtr	addl SourcePtr,TempLong,DestPtr	jsr  BlockMove	lda  DestPtr	sec	sbc  #4	sta  DestPtr	bcs  @3	dec  DestPtr+2@3	ldy  #2	lda  StyleItemCount	sta  [DestPtr]	lda  StyleItemCount+2	sta  [DestPtr],y	lda  TempLong		;subtract four from the style list length	sec		;..for the terminator	sbc  #4	sta  TempLong	bcs  @4	dec  TempLong+2@4	movl SourcePtr,DestPtr	lda  SourcePtr	sec	sbc  #4	sta  SourcePtr	bcs  @5	dec  SourcePtr+2@5	ldy  #2	lda  TempLong	sta  MoveLength	sta  [SourcePtr]	lda  TempLong+2	sta  MoveLength+2	sta  [SourcePtr],y	jsr  DerefHandle	stax SourcePtr	jsr  BlockMove	ldy  #TERecord.StyleList	jsr  GetRecordLong	jsr  KillHandle	PullAX	ldy  #TERecord.StyleList	jsr  SetRecordLong	PushZLong InputStyleRef	jsr  LockHandle	stax InputStylePtr	jsr  ReleaseTextVerb	lda  #textIsHandle+dataIsTextBox2	sta  InputTextVerb	ldax NewBufferHandle	stax InputTextRef	PushAX	PushAX	jsr  GetHandleSize	stax InputTextLength	jsr  LockHandle	stax InputTextPtr	clc	rts;---------------------------------------------------------------noText	PushZLong InputStyleRef	jsr  UnlockHandle	PushZLong InputStyleRef	ldax #TEStyleRecord.RecordSize+4+TEStyle.RecordSize+4+8	jsr  SetHandleSize	PushZLong InputStyleRef	jsr  LockHandle	stax InputStylePtr	ldy  #TEStyleRecord.RecordSize	lda  #TEStyle.RecordSize	sta  [InputStylePtr],y	iny	iny	lda  #0	sta  [InputStylePtr],y	iny	iny	ldx  #0@noTextLoop1	lda  TempStyle,x	sta  [InputStylePtr],y	iny	iny	inx	inx	cpx  #TEStyle.RecordSize	blt  @noTextLoop1	lda  #1	sta  [InputStylePtr],y	iny	iny	dec  a	ldx  #5@noTextLoop2	sta  [InputStylePtr],y	iny	iny	dex	bne  @noTextLoop2	jsr  ReleaseTextVerb	lda  #textIsHandle+dataIsTextBox2	sta  InputTextVerb	lda  #1	jsr  GetSmallHandle	stax InputTextRef	stzl InputTextLength	clc	rts;---------------------------------------------------------------;---------------------------------------------------------------addStyleItem	incl StyleItemCount	PushZLong InputStyleRef	PushZLong InputStyleRef	PushZLong InputStyleRef	jsr  GetHandleSize	stax MoveLength	clc	adc  #SuperItemSize	bcc  @1	inx@1	jsr  SetHandleSize	jsr  DerefHandle	clc	adc  MoveLength	sta  TempPtr	txa	adc  MoveLength+2	sta  TempPtr+2	ldy  #2	lda  NewStyleLength	sta  [TempPtr]	lda  #0	sta  [TempPtr],y	iny	iny	lda  TempLong	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y	rts;---------------------------------------------------------------	ENDP****************************************************************ReleaseInputVerbs	PROCNAME  Export;---------------------------------------------------------------	lda  InputTextVerb		;unlock the passed text handle	and  #dataIsMask	cmp  #dataIsTextBox2	bne  @notTextBox2	ldax InputTextRef	jsr  KillHandle	ldax InputStyleRef	brl  KillHandle@notTextBox2	jsr  ReleaseTextVerb;---------------------------------------------------------------	lda  InputStyleVerb;	cmp  #refIsPointer		;since refIsPointer is $0000 we don't	beq  @exit		;..need this	cmp  #refIsHandle	beq  @doHandle@doResource	ldy  #rStyleBlock		;get the handle to the resource again	ldax InputStyleRef	jsr  LoadResource	PushAX	bra  @unlockIt@doHandle	PushZLong InputStyleRef@unlockIt	jsr  UnlockHandle@exit	rts;---------------------------------------------------------------	ENDP****************************************************************ReleaseTextVerb	PROCNAME  Export;---------------------------------------------------------------	lda  InputTextVerb		;unlock the passed text handle	and  #textIsMask;	cmp  #textIsPointer		;this is zero, so don't need to compare	beq  done	cmp  #textIsHandle	beq  @doHandle@doResource	lda  InputTextVerb	jsr  VerbToResourceType	;this returns the type in the Y-Reg	ldax InputTextRef	jsr  LoadResource	PushAX	bra  @unlockIt@doHandle	PushZLong InputTextRef@unlockIt	jsr  UnlockHandledone	rts;---------------------------------------------------------------	ENDP****************************************************************Text1Proc	PROC;---------------------------------------------------------------	EXPORT RemoveText	EXPORT ReplaceText;---------------------------------------------------------------;---------------------------------------------------------------RemoveText	stzl InputTextLength	stzl InputStyleRef;---------------------------------------------------------------ReplaceText	jsr  GetTEHighFlags		;check to see if the record is editable	and  #fReadOnly		;..or not	bne  @exit	jsr  GetSelectionLength	;check to see if the record has exceded its	jsr  GetTextLength		;..bounds	clc	adc  InputTextLength	sta  TempLong	txa	adc  InputTextLength+2	sta  TempLong+2	subl TempLong,SelectionLength,TempLong	ldy  #TERecord.MaximumChars	jsr  GetRecordLong	cmpl TempLong	bge  doIt@exit	clc	rts;---------------------------------------------------------------doIt	jsr  TakeCareOfUpdate	;make sure any update event is handled first	jsr  SetDirtyFlag	jsr  ClearSavedHPos	jsr  CenterTheSelection	;make sure the selection is on the screen	jsr  UnhilightSelection	;remove the selection hilighting	jsr  GetViewRect		;assume we are going to draw the entire 	jsr  CopyTempToDrawRect	;..viewRect	jsr  ReplaceBlocks	bcs  memoryError 	jsr  ReplaceStyles	bcs  @skipRewrap	jsr  ReplaceLines		;this routine will never generate any errors	jsr  IncrementalWordWrap@skipRewrap	jsr  GetSelectionStart	;set the selection just past what we inserted	addl TextOffset,InputTextLength,TextOffset	jsr  SetSelectionStart	jsr  SetSelectionEnd	lda  DrawRect.top	cmp  DrawRect.bottom	beq  @skipDraw	jsr  DoDraw@skipDraw	jsr  HilightSelection	ldy  #TERecord.SelectionStart	jsr  ScrollToSelection	ldx  #0	clc	rts;---------------------------------------------------------------memoryError	phx	jsr  HilightSelection	plx	brl  SetLastErrorCode	;report the last error;---------------------------------------------------------------	ENDP****************************************************************ReplaceBlocks	PROCNAME  Export;---------------------------------------------------------------;; 4/24/90	Mensch; Added this blockendkludgeflag stuff so that I could fix the block break; bug in a reasonable manner.;; brk 0	lda #0	sta >BlockEndKludgeFlag	jsr  GetSelectionStart	;move to the current selection start	jsr  FindBlockInfo	subl TextOffset,BlockStart,SourcePtr	;SourcePtr is the index of TextOffset	subl BlockLength,SourcePtr,MoveLength	;MoveLength is the number of bytes left	jsr  GetSelectionLength	;..in the block	PushAX		;save the selection length on the stack	cpx  MoveLength+2		;if the selection length is greater than	blt  @1		;..the number of bytes left in the block	bne  removeBlocks		;..then goto removeBlocks. Otherwise	cmp  MoveLength		;..branch to insideBlock	beq  @1	bge  removeBlocks@1	brl  insideBlock;---------------------------------------------------------------removeBlocks		subl SelectionLength,MoveLength,SelectionLength	movl SourcePtr,BlockLength	jsr  SetBlockSize		;the block is getting smaller, so no errors	PushZLong BlockHandle	;save the original block handle;; 8/9/90	Mensch; Moved this fix here to always cause a join after this operation is completed. This should take care; of more block list bugs.  	lda #$FFF1	sta >BlockEndKludgeFlag	ldax BlockHandle	sta  >BlockEndKludgeBlock	txa	sta  >BlockEndKludgeBlock+2; 8/9/90 END	jsr  BlockHandleToPtr	jsr  MoveToNextBlock@loop	ldy  #TextBlock.textLength	lda  SelectionLength	; subtract length of current block	sec		; from the length of our deletion	sbc  [TempPtr],y	tax	iny	iny	lda  SelectionLength+2	; if this value turns up negative then	sbc  [TempPtr],y		; we must stop since the selection	bmi  @done		; ends in this block!	stx  SelectionLength	sta  SelectionLength+2	PushZLong BlockHandle	jsr  MoveToNextBlock	PullAX	php		;save the state of the carry	jsr  KillHandle	jsr  BlockHandleToPtr	plp	bcc  @loop	pla	sta  BlockHandle	pla	sta  BlockHandle+2	jsr  BlockHandleToPtr	ldy  #TextBlock.nextHandle	lda  #0	sta  [TempPtr],y	iny	iny	sta  [TempPtr],y;###############################################################;# This was added 1/5/89 by DDG;###############################################################	lda  InputTextLength	;check for there being no insertion of	ora  InputTextLength+2	;..text. If that's so, then we are done,	beql allDone		;.. so exit.	ldy  #TextBlock.textLength	;load the latest block length from the	lda  [TempPtr],y		;..current block into BlockLength	sta  BlockLength	iny	iny	lda  [TempPtr],y	sta  BlockLength+2	stzl MoveLength		;indicate that there are no bytes left in	lda  #0		;..the block. Then load the selection	tax		;..length (always zero) and jump to	brl  insideBlock		;..insideBlock to do the insert.;###############################################################;# End of the 1/5/89 addition.;###############################################################;; The following code is executed when the remove is across super blocks and ; the selection ends in the middle of the super block list;; NOTE: On entry BlockHandle contains the selection end super block; and the top of the stack has the new previos super block. And TempPtr points to; the selection end super block..;@done	movl BlockHandle,TempLong	ldy  #TextBlock.prevHandle	pla	sta  BlockHandle	sta  [TempPtr],y	iny	iny	pla	sta  BlockHandle+2	sta  [TempPtr],y	jsr  BlockHandleToPtr	ldy  #TextBlock.nextHandle	lda  TempLong	sta  BlockHandle	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  BlockHandle+2	sta  [TempPtr],y;###############################################################;# This was added 8/27/89 by DDG;###############################################################	ldy  #TextBlock.textLength+2	;check the length of the first block we	lda  [TempPtr],y		;..deleted. If it not zero, then skip the	tax		; save this in the high word for now..	dey		;..cleanup.	dey	ora  [TempPtr],y	beq  @ThisBlockZero		; length of this block is zero so leave it alone;; 8/9/90	MENSCH; DUE TO ANOTHER BUG WHICH CAUSED ME TO HAVE TO USE FLAG $FFF0 HERE INSTEAD OF $FFFF I HAVE DECIDED; TO REMOVE THE TEST FOR SPLIT FROM THIS SEGMENT ALL TOGETHER, INSTEAD I NOW WILL SIMPLY ALWAYS; CAUSE THE SUPER BLOCK THAT CONTAINS SELECTION START TO JOIN, MOVING A PORTION OF THIS CODE ABOVE; AND SIMPLY NOT USING THE REST.;; 4/17/90	Mensch; Code added here to fix the situation when the removed text will create a super block that; does not have a carrige return at its end, This should fix a number of display and crashing; problems associated with cutting across super blocks.. Note that tempPtr contains a pointer; to the selstart block and block handle contains the handle of the next block.;; First and formost, test to see if this block ends in a carrige return;	lda [tempPtr],y;	sta tempLong;	stx tempLong+2;	addl tempLong,tempPtr,tempPtr	; make tempptr point to the last character in this block;	lda  #TextBlock.textStart-1	; off by one to get last character;	addl tempPtr;	lda [tempPtr];	and #$00FF;	cmp #$0D		; is it a carrige return?;	beq  @SkipCleanup		; it sure is, must not be a problem!;  	lda #$FFF0;	sta >BlockEndKludgeFlag; 8/9/90	Mensch; REMOVED SAME DAY! THIS FIX NOT NEEDED HERE YET, BUT I LEAVE THE CODE FOR YOU TO USE IN CASE; YOU DECIDE THAT YOU NEED IT LATER!; 8/9/90	Mensch Re-ADDED SAME DAY! Found a case where we need to cache the super block; here as well!; Due to the nature of the block end kludge fix, this routine will now save the handle to the block; that needs joining, thus avoid confusion and squash several bugs!;	ldax BlockHandle;	sta  >BlockEndKludgeBlock;	txa;	sta  >BlockEndKludgeBlock+2	bra  @SkipCleanup@ThisBlockZero; 8/15/90	Mensch; Simply adding a comment here to describe what this routine does.; This routine is called when the block containing the selection start ends up with a zero length; this routine will remove it from our block list. 	ldy  #TERecord.BlockList.cachedHandle	;we are going to kill the cached block	lda  BlockHandle		;..handle. Therefore we must fix the cache.	sta  [RecordPtr],y		;..Since the length of the block we are	iny		;..destroying is zero, we should set the	iny		;..cache to the handle after the empty one	lda  BlockHandle+2		;..which happens to be stored in BlockHandle	sta  [RecordPtr],y	ldy  #TextBlock.prevHandle	;save the handle just before the empty	lda  [TempPtr],y		;..one in TempLong.	sta  TempLong	iny	iny	lda  [TempPtr],y	sta  TempLong+2	jsr  BlockHandleToPtr	;BlockHandle "points" to the block just	ldy  #TextBlock.prevHandle+2	;..after the empty one. Deref BlockHandle	lda  [TempPtr],y		;..into TempPtr and using the prevHandle	tax		;..field, kill the empty block.	dey	dey	lda  [TempPtr],y	jsr  KillHandle;; 8/15/90	Mensch; NOTE, since this routine is called after multi block delete and the BlockEndKludgeBlock would then; be set to the block that I just deleted (It is the first block in the selection) I must now turn off; the block end kludge flag because joining now would be very bad!	lda  #$0000	sta  >BlockEndKludgeFlag	; zero flag, no need to join a deleted block	ldy  #TextBlock.prevHandle	;link the "before" block to the "after"	lda  TempLong		;..block in the prevHandle field.	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y	ora  TempLong		;if there is no "before" block, then skip	beq  @skipCleanup		;..setting it's link field.	Deref TempLong,TempPtr	;link the next field of the "before" block	ldy  #TextBlock.nextHandle	;..to the "after" block.	lda  BlockHandle	sta  [TempPtr],y	iny	iny	lda  BlockHandle+2	sta  [TempPtr],y@skipCleanup;###############################################################;# End of the 8/27/89 addition.;###############################################################;###############################################################;# This was added 1/5/89 by DDG;###############################################################	jsr  BlockHandleToPtr	ldy  #TextBlock.textLength	;copy the latest block length into	lda  [TempPtr],y		;..BlockLength	sta  BlockLength	iny	iny	lda  [TempPtr],y	sta  BlockLength+2;###############################################################;# End of the 1/5/89 addition.;###############################################################	stzl SourcePtr	movl BlockLength,MoveLength	ldax SelectionLength;---------------------------------------------------------------insideBlock	cpx  InputTextLength+2	blt  @expandIt	bne  @crunchIt	cmp  InputTextLength	blt  @expandIt	bne  @crunchIt	movl SourcePtr,DestPtr	brl  @derefIt@expandIt	jsr  subSelcLength	addl SourcePtr,TempLong,DestPtr	jsr  addTempLong	jsr  SetBlockSize	bcsl exit	jsr  setupSrcAndDest	jsr  BlockMove	movl SourcePtr,DestPtr	brl  @moveIt@crunchIt	jsr  subSelcLength	addl SourcePtr,InputTextLength,DestPtr	subl DestPtr,TempLong,SourcePtr	subl BlockLength,SourcePtr,MoveLength	jsr  setupSrcAndDest	jsr  BlockMove	jsr  addTempLong	jsr  SetBlockSize		;the block is getting smaller, so no errors;; 8/14/90-03	Mensch; seems to be a bug here! Later in this routine I found a problem where when text was being removed; from across various super blocks that this inside routine didn't seem to be setting up the destPtr; properly. I believe that this is due to the fact that at this moment in time BlockStart is still; set for the first block in the selection. What I propose to do instead is to ignore block start; at this time if the kludge flag is set to $FFF1 (indicating multiblock remove) and to simply; zero out the dest Ptr. This should fix them bugs!	lda  >BlockEndKludgeFlag	cmp  #$FFF1	bne  @OK081490	stzL DestPtr	bra  @Skip081490@ok081490	subl TextOffset,BlockStart,DestPtr;; 8/8/90	Mensch 	Enabled 7/31/90; Fix bug here where the final carrige return of a block is deleted while deleting; inside of a block (sheesh!) This should test the end of the text block and determine if; we have no CR at the end.. If we don't then we set the BlockEndKludgeFlag so that this; block will get joined to the next one (I could kill dave for this!); 4/17/90	Mensch; Code added here to fix the situation when the removed text will create a super block that; does not have a carrige return at its end, This should fix a number of display and crashing; problems associated with cutting across super blocks.. Note that tempPtr contains a pointer; to the selstart block and block handle contains the handle of the next block.;; First and formost, test to see if this block ends in a carrige return;; 8/14/90	Mensch; OOOps, new block end kludge above conflicts with this test right here! If the current block; happens to be the last one in the list and not end in a return we have a problem (Prior cached; block will be forgoten!). Instead since we know that if we saved that last block already then; we also know that we are deleting over supers and that this block happens to be the selection; end block. Hence, we can't hurt it any more than it is, so no need to test here!; so, add kludge flag test.	lda  >BlockEndKludgeFlag	cmp  #$FFF1		; is this set from removeBlocks?	beq  @derefIt		; if so we don't need to test here!; FUTURE NOTE: No time to get it tested for 5.0.3 but Why not test the recordPtr.nextblock field; to see if this is the last super, if it is, forget the rest of the tests since it will quite often; require joining! and this might pick up some lost speed	ldy  #TextBlock.textLength+2	;check the length of the first block we	lda  [TempPtr],y		;..deleted. If it not zero, then skip the	tax		; save this in the high word for now..	dey		;..cleanup.	dey	lda [tempPtr],y	sta tempLong	stx tempLong+2	addl tempLong,tempPtr,tempPtr	; make tempptr point to the last character in this block	lda  #TextBlock.textStart-1	; off by one to get last character	addl tempPtr	lda [tempPtr]	and #$00FF	cmp #$0D		; is it a carrige return?	beq  @derefIt		; it sure is, must not be a problem!  	lda #$FFF0	sta >BlockEndKludgeFlag;; 8/9/90	Mensch; Due to the nature of the block end kludge fix, this routine will now save the handle to the block; that needs joining, thus avoid confusion and squash several bugs!	ldax BlockHandle	sta  >BlockEndKludgeBlock	txa	sta  >BlockEndKludgeBlock+2;; 8/14/90-03	Mensch; HEY! Something is wrong with sourcePtr and Dest ptr here when falling into the inside block routine; from removeBlocks! SourcePtr already seems to be set up and dest ptr seems to be set wrong!; of course, we don't really need sourceptr, but dest ptr might be a nice thing to have setup!; REFER TO ABOVE FIX #8/14/90-03@Skip081490@derefIt	jsr  setupSrcAndDest	;we don't really need the SourcePtr@moveIt	lda  InputTextLength	;check for nothing to insert	ora  InputTextLength+2	beq  allDone	movl InputTextPtr,SourcePtr	movl InputTextLength,MoveLength	jsr  QuickMove;---------------------------------------------------------------allDone	lda  InputTextLength	sec	sbc  1,s	tax	lda  InputTextLength+2	sbc  3,s	sta  TempLong	txa	ldy  #TERecord.TextLength	clc	adc  [RecordPtr],y	sta  [RecordPtr],y	iny	iny	lda  TempLong	adc  [RecordPtr],y	sta  [RecordPtr],y;; 4/24/90	Mensch; Added this kludge here to clean un the block list if the flag is set telling us; that we have screwed up the block list somehow.;	clc	lda >BlockEndKludgeFlag	beq Exit	inc  a	; determine if the flag <>$FFFF	bne  @DoKludgeBlock	; if not, then join from the saved block handle	jsr  BlockHandleToPtr	jsr  MoveToPrevBlock	; set the current block as the broken one	bra  @DoJoin@DoKludgeBlock	lda  >BlockEndKludgeBlock+2	tax	lda  >BlockEndKludgeBlock	stax BlockHandle		; use the saved handle	jsr  BlockHandleToPtr	; and be sure to set a pointer to it@DoJoin	jsr  joinTheBlock	clcexit	pla		;cleanup the stack	pla	rts;---------------------------------------------------------------BlockEndKludgeFlag	ds.W 1	; tell whether the blocks need joining..BlockEndKludgeBlock	ds.L 1	; if Flag<>$FFFF then Join this block;---------------------------------------------------------------subSelcLength	subl InputTextLength,SelectionLength,TempLong	rts;---------------------------------------------------------------addTempLong	addl BlockLength,TempLong,BlockLength	rts;---------------------------------------------------------------;---------------------------------------------------------------setupSrcAndDest	ldy  #2	lda  [BlockHandle]	clc	adc  #TextBlock.textStart	sta  TempWord	lda  [BlockHandle],y	adc  #0	tax	lda  SourcePtr	clc	adc  TempWord	sta  SourcePtr	txa	adc  SourcePtr+2	sta  SourcePtr+2	lda  DestPtr	clc	adc  TempWord	sta  DestPtr	txa	adc  DestPtr+2	sta  DestPtr+2	rts;---------------------------------------------------------------	ENDP****************************************************************ReplaceStyles	PROCNAME  Export;---------------------------------------------------------------	jsr  GetTEHighFlags		;if the record is single style, then don't	and  #fSingleStyle		;..set the null style	bne  skipNull	jsr  IsTheSelectionACaret	beq  skipNull;---------------------------------------------------------------	jsr  FindStyleInfo		;get the current style	jsr  SetupStylePtr	ldy  #TERecord.NullStyle	ldx  #0@loop	phy	txy	lda  [TempPtr],y	ply	sta  [RecordPtr],y	iny	iny	inx	inx	cpx  #TEStyle.RecordSize	blt  @loop	ldy  #TERecord.NullStyleActive	lda  #$FFFF	sta  [RecordPtr],y;---------------------------------------------------------------skipNull	ldy  #TERecord.StyleSuper	;remove the style super items	jsr  RemoveSuperSelection	jsr  GetSelectionStart	ldy  #TERecord.StyleSuper	jsr  FindSuperInfo	lda  TextOffset	cmp  SuperStart	bne  @notAtStart	lda  TextOffset+2	cmp  SuperStart+2	bne  @notAtStart	ora  TextOffset	beq  @notAtStart	decl TextOffset	ldy  #TERecord.StyleSuper	jsr  FindSuperInfo	incl TextOffset@notAtStart	dey	dey	dey	dey	jsr  AddInputToTempPtr	ldy  #SuperBlock.textLength	jsr  AddInputToTempPtr	jsr  GetTEHighFlags		;if the record is single style, then clear	and  #fSingleStyle		;..the null style and exit	bne  @clearNull	lda  InputStyleRef	ora  InputStyleRef+2	bne  doStyles	lda  InputTextLength	ora  InputTextLength+2	beq  exit	ldy  #TERecord.NullStyleActive	lda  [RecordPtr],y	bmi  useNullStyle	clc@clearNull	brl  ClearNullStyle		;after an edit then clear the null style;---------------------------------------------------------------useNullStyle	movl InputTextLength,SuperLength	ldax RecordPtr	clc	adc  #TERecord.NullStyle	bcc  @1	inx@1	jsr  AddToStyleList	bcs  memoryError	jsr  ChangeStyleItem	;this updates TextOffset also.	bcs  memoryError	brl  ClearNullStyle		;after an edit then clear the null style;---------------------------------------------------------------exit	clc	rts;---------------------------------------------------------------memoryError	jsr  SetLastErrorCode	;report the last error	brl  ClearNullStyle		;the carry remains set here;---------------------------------------------------------------doStyles	lda  [InputStylePtr]	;check the style record version. NOTE: on	cmp  #StyleRecordVersion	;..a version error, we just ignore this	bne  exit		;..style information.	ldy  #4		;get the length of the ruler list	lda  [InputStylePtr],y	tax	dey	dey	lda  [InputStylePtr],y	clc		;add four bytes for the length itself and	adc  #6		;..two byte for the version number	bcc  @1	inx	clc@1	adc  InputStylePtr		;add to the input style pointer to skip	sta  InputStylePtr		;..over the ruler list	sta  StyleListPtr		;save another copy in style list pointer	txa	adc  InputStylePtr+2	sta  InputStylePtr+2	sta  StyleListPtr+2	lda  #4		;move the style list pointer over the	addl StyleListPtr		;..style list length	ldy  #2		;skip over the style list	lda  [InputStylePtr],y	tax	lda  [InputStylePtr]	clc	adc  #4	bcc  @2	inx	clc@2	adc  InputStylePtr	sta  InputStylePtr	txa	adc  InputStylePtr+2	sta  InputStylePtr+2	lda  [InputStylePtr]	;get the number of items in the style	sta  StyleItemCount		;..super array	lda  [InputStylePtr],y	;Y-Reg is already two	sta  StyleItemCount+2	lda  #4	addl InputStylePtr;---------------------------------------------------------------styleLoop	lda  StyleItemCount	ora  StyleItemCount+2	beq  done	ldy  #2	lda  [InputStylePtr]	sta  SuperLength	lda  [InputStylePtr],y	sta  SuperLength+2	iny	iny	lda  [InputStylePtr],y	clc	adc  StyleListPtr	pha	iny	iny	lda  [InputStylePtr],y	adc  StyleListPtr+2	tax	pla	jsr  AddToStyleList	bcsl memoryError	jsr  ChangeStyleItem	;this updates TextOffset also.	bcsl memoryError	lda  #SuperItemSize	addl InputStylePtr	decl StyleItemCount	bra  styleLoop;---------------------------------------------------------------done	clc	brl  ClearNullStyle		;after an edit then clear the null style;---------------------------------------------------------------	ENDP****************************************************************ReplaceLines	PROCNAME  Export;---------------------------------------------------------------	ENTRY  AddInputToTempPtr;---------------------------------------------------------------;---------------------------------------------------------------	jsr  RemoveLineStarts	;this leaves TextOffset set to SelcStart	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	dey	dey	dey	dey	lda  InputTextLength	ora  InputTextLength+2	beq  checkForZero	jsr  AddInputToTempPtr	ldy  #SuperBlock.textLength;---------------------------------------------------------------AddInputToTempPtr	lda  [TempPtr],y	clc	adc  InputTextLength	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	adc  InputTextLength+2	sta  [TempPtr],y	rts;---------------------------------------------------------------checkForZero	lda  [TempPtr],y	bne  @exit	iny	iny	lda  [TempPtr],y	bne  @exit	cpy  #SuperBlock.RecordSize+2	;see if we are the first item in the block	bne  @clear		;..if not, then clear it	jsr  MovetoPrevHandle	;if there is no previous handle, then we	bcs  @exit		;..are on the first item, so DON'T clear it	jsr  MoveToNextHandle	ldy  #SuperBlock.RecordSize+2@clear	iny		;get the height of the item we are	iny		;..deleting	lda  [TempPtr],y		;add this height to the removed height	addl RemovedHeight	dey		;move the index back to the high word	dey	lda  #$FFFF		;this makes A-Reg minus one	sta  [TempPtr],y	dey	dey	sta  [TempPtr],y@exit	rts;---------------------------------------------------------------	ENDP****************************************************************RemoveLineStarts	PROCNAME  Entry;---------------------------------------------------------------	stzl RemovedHeight		;start with removing zero pixels	jsr  GetSelectionLength	;get the selection length and test to	bne  doIt		;..see if there is a selection. If there	rts		;..isn't then exit;---------------------------------------------------------------doIt	ldy  #TERecord.LineSuper	;find the line info for the selection	jsr  FindSuperInfo		;..start	jsr  GetSuperMaxIndex	;get the size of each super handle	ldy  #SuperHandle.cachedIndex	;start at the high word of the current	lda  [SuperRecordPtr],y	;..index into the line starts. Put this	inc  a		;..in both Y-Reg and TempWord	inc  a	sta  TempWord	tay	lda  TextOffset		;check to see if we are starting on the	cmp  SuperStart		;..first item	bne  @notAtStart	lda  TextOffset+2	cmp  SuperStart+2	bne  @notAtStart	ldax SelectionLength	;check to see if the selection is contained	cpx  SuperLength+2		;..by the current line. If it is, then	blt  @adjustAndExit		;..adjust the line length and exit.	bne  itemLoop	cmp  SuperLength	bge  itemLoop@adjustAndExit	stax SuperLength		;the line length gets adjusted by SuperLength	brl  subtractFromItem@notAtStart	jsr  GetLongSuperCount	;we aren't at the start so find out how	stax SuperLength		;..many chars are left on the line and	jsr  adjustSelection	;..subtract that from the selection length	bcs  @keepGoing		;If there is more selection, then keep going	addl SuperLength,SelectionLength,SuperLength	brl  subtractFromItem	;we are wholly contained, so exit here@keepGoing	jsr  subtractFromItem	bra  nextItem;---------------------------------------------------------------itemLoop	sty  TempWord		;use TempWord to store our index	lda  [TempPtr],y		;is the current item deleted ? If so, then	bmi  nextItem		;..skip it.	sta  SuperLength+2		;store the high word of the length and	lda  #$FFFF		;..then delete this item	sta  [TempPtr],y	dey	dey	lda  [TempPtr],y		;store the low word of the length	sta  SuperLength	lda  #$FFFF	sta  [TempPtr],y	iny	iny	iny	iny	lda  [TempPtr],y		;add the current line height to Removed	sta  LineHeight		;..Height. Also cache the last used line	addl RemovedHeight		;..height	jsr  SubLengthFromBlock	;subtract the length we just removed from	jsr  adjustSelection	;..the cached length	bcc  lastItem		;If there is no more selection, then we're donenextItem	lda  TempWord		;move to the next item	clc	adc  #SuperItemSize	tay	cpy  SuperMaxIndex	blt  itemLoop	jsr  MoveToNextHandle	;move to the next handle and start at the	ldy  #SuperBlock.RecordSize+2	;..beginning of it. If we are not on the	bcc  itemLoop		;..last handle, then loop back;---------------------------------------------------------------	bra  lastitem	jsr  MoveToFirstSuperHandle	;we are really at the end here, so check	ldy  #SuperBlock.RecordSize+2	;..to see if we removed the first item.	lda  [TempPtr],y	bpl  removeHandles	iny		;If we did, then set the length to zero	iny		;..as the first item CANNOT be deleted.	lda  RemovedHeight		;..Also subtract the first line's length	sec		;..back from the removed height to make	sbc  [TempPtr],y		;..it consistant	sta  RemovedHeight	bcs  @1	dec  Removedheight+2@1	dey	dey	lda  #0	sta  [TempPtr],y	dey	dey	sta  [TempPtr],y	bra  removeHandles;---------------------------------------------------------------lastItem	jsr  GetSuperCachedPtr	;go back to the item we started on	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	tax		;save the index to the low word in X-Reg	inc  a	inc  a	tay		;save the index to the high word in Y-Reg	lda  [TempPtr],y		;if the item is not deleted, then just	bpl  @notDeleted		;..add the remaining length	lda  RemovedHeight		;the first item was deleted, so the	sec		;..RemovedHeight is too big. Subtract	sbc  LineHeight		;..the height of the line we last added	sta  RemovedHeight		;..from removed height to get back the	bcs  @1		;..correct amount	dec  RemovedHeight+2@1	lda  #0	sta  [TempPtr],y	iny		;set the line height of the original line	iny		;..to the line we are concatinating	lda  LineHeight	sta  [TempPtr],y	txy	lda  #0	sta  [TempPtr],y@notDeleted	txy		;add the remaining length to the original	lda  [TempPtr],y		;..line. SelectionLength is the negative	sec		;..of the remaining length	sbc  SelectionLength	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	sbc  SelectionLength+2	sta  [TempPtr],y	movl SelectionLength,SuperLength	;adjust the cache by the correct amount	jsr  SubLengthFromBlock;---------------------------------------------------------------removeHandles	jsr  GetSuperCachedPtr	;start with the handle that contains	jsr  MoveToNextHandle	;..selection start. If there are no more	bcs  @exit		;..handles, then exit@loop	ldy  #SuperBlock.textLength	;as long as we are finding handles with	lda  [TempPtr],y		;..no text, then we keep killing. As soon	iny		;..as we find a handle that contains text	iny		;..we are done	ora  [TempPtr],y	bne  @done	movl TheSuperHandle,TempLong	jsr  MoveToNextHandle	php	ldax TempLong	jsr  KillHandle	plp	bcc  @loop		;if we are at the very end, then zero out	stzl TheSuperHandle		;..the super handle to update the list rightt@done	PushZLong TheSuperHandle	;save the handle we stopped on	jsr  GetSuperCachedPtr	;switch back to the first handle and set	ldy  #SuperBlock.nextHandle	;..the next field to the handle we	pla		;..stopped on.	sta  [TempPtr],y	sta  TempLong		;save the handle we stopped on in TempLong	iny	iny	pla	sta  [TempPtr],y	sta  TempLong+2	ora  TempLong		;if the handle we stopped on is NULL, then	beq  @exit		;..don't update it's previous field	Deref TempLong,TempPtr	;make TempPtr point to the handle we	ldy  #SuperBlock.prevHandle	;..stopped on.	lda  TheSuperHandle		;set the previous handle field to the	sta  [TempPtr],y		;..last valid handle	iny	iny	lda  TheSuperHandle+2	sta  [TempPtr],y	jsr  SuperHandleToPtr	;make TempPtr point to the cached super@exit	rts		;..handle again;---------------------------------------------------------------;---------------------------------------------------------------adjustSelection	lda  SelectionLength	sec	sbc  SuperLength	sta  SelectionLength	lda  SelectionLength+2	sbc  SuperLength+2	sta  SelectionLength+2	rts		;carry is clear if we are done;---------------------------------------------------------------;---------------------------------------------------------------subtractFromItem	ldy  TempWord	dey	dey	lda  [TempPtr],y	sec	sbc  SuperLength	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	sbc  SuperLength+2	sta  [TempPtr],y	brl  SubLengthFromBlock;---------------------------------------------------------------	ENDP****************************************************************IsItAWordWrap	PROCNAME  Export;---------------------------------------------------------------	and  #$00FF	pha	ldy  #TERecord.WordWrapHook+1	lda  [RecordPtr],y	beq  noHook;---------------------------------------------------------------useHook	tax	PushZLong RecordHandle	lda  5,s		;one word is space for result and the	pha		;..other one is the passed character	dey	lda  [RecordPtr],y	jsl  LongCall	pla	beq  notWordWrap	bra  isWordWrap;---------------------------------------------------------------noHook	pla*** changed 17-Nov-92 DAL, as suggested by Jim Murphy*** Now only Space is allowed trail a word without making that word*** wrap to the next line.	cmp  #' '+1	;24-Mar-93 JCM old code is back for now	blt  isWordWrap;;;	cmp  #' ';;;	beq  isWordWrap*** end 17-Nov-92;---------------------------------------------------------------notWordWrap	clc	rts;---------------------------------------------------------------isWordWrap	sec	rts;---------------------------------------------------------------	ENDP****************************************************************	END