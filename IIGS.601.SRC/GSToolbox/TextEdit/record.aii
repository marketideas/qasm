************************************************************************                      GSTextEdit  Version 1.0*                          File: record.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************GetPortLong	PROCNAME  Export	iny	iny	lda  [DrawPortPtr],y	tax	dey	dey	lda  [DrawPortPtr],y	rts	ENDP****************************************************************SetPortLong	PROCNAME  Export	sta  [DrawPortPtr],y	iny	iny	txa	sta  [DrawPortPtr],y	rts	ENDP****************************************************************GetRecordLong	PROCNAME  Export	iny	iny	lda  [RecordPtr],y	tax	dey	dey	lda  [RecordPtr],y	rts	ENDP****************************************************************PushRecordLong	PROCNAME  Export	lda  1,s	pha	pha	lda  [RecordPtr],y	sta  3,s	iny	iny	lda  [RecordPtr],y	sta  5,s	dey	dey	rts	ENDP****************************************************************SetRecordLong	PROCNAME  Export	sta  [RecordPtr],y	iny	iny	txa	sta  [RecordPtr],y	rts	ENDP****************************************************************AddWordToRecordLong	PROCNAME  Export	clc	adc  [RecordPtr],y	sta  [RecordPtr],y	bcc  skipHigh	iny	iny	lda  [RecordPtr],y	inc  a	sta  [RecordPtr],yskipHigh	rts	ENDP****************************************************************Record1Proc	PROC	EXPORT GetSelectionStart	EXPORT GetSelectionEnd	EXPORT GetScreenTopOffset;---------------------------------------------------------------GetScreenTopOffset	ldy  #TERecord.TopTextOffset+2	bra  getIt;---------------------------------------------------------------GetSelectionEnd	ldy  #TERecord.SelectionEnd+2	bra  getIt;---------------------------------------------------------------GetSelectionStart	ldy  #TERecord.SelectionStart+2;---------------------------------------------------------------getIt	lda  [RecordPtr],y	sta  TextOffset+2	dey	dey	lda  [RecordPtr],y	sta  TextOffset	rts;---------------------------------------------------------------	ENDP****************************************************************Record2Proc	PROC	EXPORT SetSelectionStart	EXPORT SetSelectionEnd	EXPORT SetScreenTopOffset;---------------------------------------------------------------SetScreenTopOffset	ldy  #TERecord.TopTextOffset	bra  setIt;---------------------------------------------------------------SetSelectionEnd	ldy  #TERecord.SelectionEnd	bra  setIt;---------------------------------------------------------------SetSelectionStart	ldy  #TERecord.SelectionStart;---------------------------------------------------------------setIt	lda  TextOffset	sta  [RecordPtr],y	iny	iny	lda  TextOffset+2	sta  [RecordPtr],y	rts;---------------------------------------------------------------	ENDP****************************************************************GetTextLength	PROCNAME  Export	ldy  #TERecord.TextLength	brl  GetRecordLong		ENDP****************************************************************GetTEHighFlags	PROCNAME  Export	ldy  #TERecord.TextFlags+2	lda  [RecordPtr],y	rts	ENDP****************************************************************Record3Proc	PROC;---------------------------------------------------------------	EXPORT  GetVertScrollBar	EXPORT  GetGrowBoxHandle;---------------------------------------------------------------;---------------------------------------------------------------GetGrowBoxHandle	ldy  #TERecord.GrowBoxHandle+2	;get the grow box handle	bra  getTheHandle;---------------------------------------------------------------GetVertScrollBar	ldy  #TERecord.VertScrollBar+2	;get the scroll bar handle;---------------------------------------------------------------getTheHandle	lda  [RecordPtr],y		;now get the handle into the A and X regs	tax	dey	dey	lda  [RecordPtr],y	bne  @done	inx		;this compares X-Reg with zero in only	dex		;..two bytes@done	rts;---------------------------------------------------------------	ENDP****************************************************************IsOffsetAtEnd	PROCNAME  Export	ldy  #TERecord.TextLength	;compare the low word	lda  [RecordPtr],y	cmp  TextOffset	bne  @done	ldy  #TERecord.TextLength+2	;compare the high word	lda  [RecordPtr],y	cmp  TextOffset+2@done	rts	ENDP****************************************************************Record4Proc	PROC;---------------------------------------------------------------	EXPORT  GetViewRect	EXPORT  CopyIntoTempRect;---------------------------------------------------------------;---------------------------------------------------------------GetViewRect	ldy  #TERecord.ViewRect;---------------------------------------------------------------CopyIntoTempRect	lda  [RecordPtr],y	sta  TempRect.top	iny	iny	lda  [RecordPtr],y	sta  TempRect.left	iny	iny	lda  [RecordPtr],y	sta  TempRect.bottom	iny	iny	lda  [RecordPtr],y	sta  TempRect.right	rts;---------------------------------------------------------------	ENDP****************************************************************CopyFromTempRect	PROCNAME  Export	lda  TempRect.top	sta  [RecordPtr],y	iny	iny	lda  TempRect.left	sta  [RecordPtr],y	iny	iny	lda  TempRect.bottom	sta  [RecordPtr],y	iny	iny	lda  TempRect.right	sta  [RecordPtr],y	rts	ENDP****************************************************************CopyTempToDrawRect	PROCNAME  Export	mov  TempRect.top,DrawRect.top	mov  TempRect.left,DrawRect.left	mov  TempRect.bottom,DrawRect.bottom	mov  TempRect.right,DrawRect.right	rts	ENDP****************************************************************Record5Proc	PROC;---------------------------------------------------------------	EXPORT  SetWindowPort	EXPORT  SetDrawPort;---------------------------------------------------------------;---------------------------------------------------------------SetWindowPort	ldy  #TERecord.inPort	jsr  PushRecordLong	bra  doIt;---------------------------------------------------------------SetDrawPort	PushZLong DrawPortPtr;---------------------------------------------------------------doIt	jsr  SetPort		;we must jsr to this routine since it	rts		;..uses the stack;---------------------------------------------------------------	ENDP****************************************************************GetWindowPortPtr	PROCNAME  Export	ldy  #TERecord.inPort	jsr  GetRecordLong	stax TempPtr	rts	ENDP****************************************************************AreWeInvisible	PROCNAME  Export	ldy  #TERecord.CtrlFlag	;returns zero if visible and not zero	lda  [RecordPtr],y		;..if invisible	and  #fInvisible	rts	ENDP****************************************************************SetDirtyFlag	PROCNAME  Export	ldy  #TERecord.CtrlFlag	lda  [RecordPtr],y	ora  #$0040	sta  [RecordPtr],y	rts	ENDP****************************************************************ClearNullStyle	PROCNAME  Export	ldy  #TERecord.NullStyleActive	;this MUST NOT change the state of the	lda  #0		;..carry flag !!!	sta  [RecordPtr],y	rts	ENDP****************************************************************CompareOffsetWithSelcEnd PROCNAME  Export	ldy  #TERecord.SelectionEnd+2	lda  TextOffset+2	cmp  [RecordPtr],y	bne  @done	dey	dey	lda  TextOffset	cmp  [RecordPtr],y@done	rts	ENDP****************************************************************NegateTempLong	PROCNAME  Export	lda  TempLong	eor  #$FFFF	tax	lda  TempLong+2	eor  #$FFFF	inx	bne  @1	inc  a@1	stx  TempLong	sta  TempLong+2	rts	ENDP****************************************************************NegateAX	PROCNAME  Export	eor  #$FFFF	tay	txa	eor  #$FFFF	tax	tya	incl a	rts	ENDP****************************************************************PushDrawRect	PROCNAME  Export	ply	PushZWord DrawRect.top	PushZWord DrawRect.left	PushZWord DrawRect.bottom	PushZWord DrawRect.right	phy	rts	ENDP****************************************************************PullDrawRect	PROCNAME  Export	lda  9,s	sta  DrawRect.top	pla	sta  7,s	pla	sta  DrawRect.right	pla	sta  DrawRect.bottom	pla	sta  DrawRect.left	rts	ENDP****************************************************************CallFilterProc	PROCNAME  Export	PushWordSpace		;leave space for the filter result	PushZLong RecordHandle	;pass the current record handle	pha		;the message to pass is in the A-Reg	ldy  #TERecord.FilterProc+1	lda  [RecordPtr],y	tax	dey	lda  [RecordPtr],y	jsl  LongCall	pla		;return the filter result in A-Reg	rts	ENDP****************************************************************PassTempRect	PROCNAME  Export	ldy  #TERecord.theFilterRect	lda  TempRect.top	sta  [RecordPtr],y	iny	iny	lda  TempRect.left	sta  [RecordPtr],y	iny	iny	lda  TempRect.bottom	sta  [RecordPtr],y	iny	iny	lda  TempRect.right	sta  [RecordPtr],y	rts	ENDP****************************************************************SetLastErrorCode	PROCNAME  Export;---------------------------------------------------------------	txa	beq  exit2	ldy  #TERecord.LastErrorCode	sta  [RecordPtr],y	cpx  #$0201		;is the error out of memory ?	bne  exit1	phx		;save the error code	nop	plx		;restore the error code;---------------------------------------------------------------exit1	secexit2	rts;---------------------------------------------------------------	ENDP****************************************************************LongCall	PROCNAME  Export	dec  a		;the low word is in A-Reg. Make it look	phx		;..like a return address. Push the high	tsx		;..and middle bytes. Now adjust the stack	inx		;..to leave only the high byte of the	txs		;.address	pha		;push the low word of the address	rtl		;go to the address.	ENDP****************************************************************AddFourToDestPtr	PROCNAME  Export	lda  #4	clc	adc  DestPtr	sta  DestPtr	bcc  @1	inc  DestPtr+2@1	rts	ENDP****************************************************************AddEightToDestPtr	PROCNAME  Export	lda  #8	clc	adc  DestPtr	sta  DestPtr	bcc  @1	inc  DestPtr+2@1	rts	ENDP****************************************************************AddFourToSourcePtr	PROCNAME  Export	lda  #4	clc	adc  SourcePtr	sta  SourcePtr	bcc  @1	inc  SourcePtr+2@1	rts	ENDP****************************************************************AddEightToSourcePtr	PROCNAME  Export	lda  #8	clc	adc  SourcePtr	sta  SourcePtr	bcc  @1	inc  SourcePtr+2@1	rts	ENDP****************************************************************LoadResource	PROCNAME  Export	PushLongSpace		;push space for the result, then the type	phy		;..(the Y-Reg), then the resource ID (the	PushAX		;..A and X-Regs).	_CMLoadResource		;this tool call will check for errors and	PullAX		;..call system death if any occur	rts		;return the handle in the A and X-Regs	ENDP****************************************************************	END