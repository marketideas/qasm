************************************************************************                      GSTextEdit  Version 1.0*                         File: fastdraw.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************FastPPToPort	PROCNAME  Export;---------------------------------------------------------------	lda  TextVPos		;copy the top coordinate	sta  dstRect.top	lda  TempRect.bottom	;copy the bottom coordinate	sec	sbc  TempRect.top	clc	adc  dstRect.top	sta  dstRect.bottom	ldy  #TERecord.ViewRect.left	;copy the left coordinate	lda  [RecordPtr],y	clc	adc  TextHPos	sta  dstRect.left	ldy  #GrafPort.PortRect.right	;copy the right coordinate	lda  [DrawPortPtr],y	sec	sbc  TextHPos	clc	adc  dstRect.left	sta  dstRect.right;---------------------------------------------------------------	jsr  SetupDstPtr		;find the destination pointer	bcs  doSlow	jsr  SetupSrcPtr		;find the source pointer	bcs  doSlow	jsr  SetupPPToPortCode	;setup our code buffer	bcs  doSlowdoFast	jsr  CallMemoryCode;---------------------------------------------------------------allDone	brl  TellAboutDstRect;---------------------------------------------------------------doSlow	PushZLong DrawPortPtr	;source port pointer	PushZPtr dstRect		;source rect	pei  dstRect.left		;horizontal destination position	pei  dstRect.top		;vertcial destination position	PushWord #0		;mode copy	ldy  #TERecord.ViewRect.left	;offset the left and right edges of the	lda  dstRect.left		;..dest rect back to being a source rect	sec	sbc  [RecordPtr],y	sta  dstRect.left	lda  dstRect.right	sec	sbc  [RecordPtr],y	sta  dstRect.right	lda  TempRect.top		;offset the top and bottom edges of the	sec		;..dest rect back to being a source rect	sbc  TextVPos	tax	clc	adc  dstRect.top	sta  dstRect.top	txa	clc	adc  dstRect.bottom	sta  dstRect.bottom	_PPToPort	bra  allDone;---------------------------------------------------------------	ENDP****************************************************************SetupPPToPortCode	PROCNAME  Entry;---------------------------------------------------------------MinWordsInHandle	equ  20;---------------------------------------------------------------;---------------------------------------------------------------	phb		;save the data bank	jsr  derefCodeHandle	;this also sets the data bank and Y-Reg	lda  |2,y		;check the maximum number of bytes that	cmp  numberOfWords		;..this handle can move	bge  SizeOK	PushZLong PPToPortCodeHandle	;set the handle size to the proper amount	lda  numberOfWords		;when we build the handle it must be a	cmp  #MinWordsInHandle	;..certain minimum size	bge  @ok	lda  #MinWordsInHandle@ok	dec  a		;the first and last words are treated	dec  a		;..specially	sta  TempWord	asl  a	asl  a	asl  a		;we are multiplying the count by seven	sbc  TempWord		;..and skipping over the PROCNAME  Export to find	adc  #EndOfCode-StartOfCode+5+2	;..our total variable offset	ldx  #0	jsr  SetHandleSize		;if we got a memory error then exit	bcs  exit	jsr  fillTheHandle		;deref and fill the handle	ldy  theCodePtr		;reload Y-Reg with the correct offset;---------------------------------------------------------------sizeOK	shortm		;check to see if the bank in the code	lda  |10,y		;..handle is the same as the destination	cmp  dstPtr+2		;..bank. If not, then reset the bank	longm		;..bytes.	beq  bankOK	jsl  ResetPPToPortBank	;this routine saves the Y-Reg;---------------------------------------------------------------bankOK	lda  |0,y		;this is the size of the variable field	clc		;we want to skip over that, so we can	adc  theCodePtr		;..patch the items we want to.	tay		;Y-Reg is now our pointer	lda  numberOfWords		;here we find the amount to branch back	dec  a		;..by	tax		;save the number of words minus one	bne  @notSingle	lda  #StartOfCode-singleStart	bra  @subtractIt@notSingle	dec  a	bne  @notDouble	lda  >patch5+1	bra  @setJumpAddr@notDouble	sta  TempWord	asl  a	asl  a	asl  a	sec	sbc  TempWord@subtractIt	sta  TempWord	lda  >patch5+1	sec	sbc  TempWord@setJumpAddr	sta  |patch5-StartOfCode+1,y	txa		;get back the number of words minus one	asl  a		;..and multiply by two	sta  |patch1-StartOfCode+1,y	;patch all the spots that need to be	sta  |patch2-StartOfCode+1,y	sta  |patch3-StartOfCode+1,y	sta  |patch4-StartOfCode+1,y	ldy  theCodePtr		;here we calculate the code pointer which	lda  |2,y		;..is the address, we must jsl to in order	sec		;..to start this entire process	sbc  numberOfWords	sta  TempWord	asl  a	asl  a	asl  a		;the carry is always CLEAR here, so we	sbc  TempWord		;..must add an extra one in addition to	clc		;..the four to skip the PROCNAME  Export, minus one	adc  #4+1-1		;..to make it into a return addr.	clc		;ensure the carry is CLEAR here	ldx  numberOfWords		;if we are moving one word, then we need	dex		;..a further adjustment of 10	bne  @notOne	adc  #10		;the carry is always clear here@notOne	adc  theCodePtr		;add to the original starting address of	sta  theCodePtr		;..of codePtr. (carry is always CLR);---------------------------------------------------------------exit	plb	rts;---------------------------------------------------------------;---------------------------------------------------------------ResetPPToPortBank	phb		;save the bank byte and the X and Y	phx		;..registers	phy	ldy  #1		;deref the handle, but don't save the	lda  [PPToPortCodeHandle],y	;..result. Instead use B-Reg and Y-Reg	pha		;..to hold our pointer into the code	plb		;..handle	plb	lda  [PPToPortCodeHandle]	tay	lda  |2,y		;get the number of words minus one for	dec  a		;..a counter	tax	shortm		;switch to short mode for safety	lda  dstPtr+2		;this is the new bank byte@loop	sta  |10,y	iny	iny	iny	iny	iny	iny	iny	dex	bne  @loop	sta  |9,y		;there are five copies of the bank byte	sta  |13,y		;..outside the loop	sta  |20,y	sta  |26,y	sta  |30,y	longm		;back to long mode	ply		;restore the X and Y registers and the	plx		;..bank byte	plb	clc		;clear the carry. This routine MUST return	rtl		;..carry clear.;---------------------------------------------------------------;---------------------------------------------------------------fillTheHandle	jsr  derefCodeHandle	;this also sets the data bank and Y-Reg	lda  numberOfWords		;when we build the handle it must be a	cmp  #MinWordsInHandle	;..certain minimum size	bge  @ok	lda  #MinWordsInHandle@ok	sta  |2,y	dec  a		;the first and last words are treated	dec  a		;..specially	sta  TempWord	asl  a	tax		;this is our index and count register	asl  a	asl  a		;we are multiplying the count by seven	sbc  TempWord		;..and skipping over the PROCNAME  Export to find	adc  #4		;..our total variable offset	sta  |0,y		;The carry gets set by the subtract	iny		;skip over the buffer PROCNAME  Export	iny	iny	iny	clc		;the carry will be CLEAR throughout the@loop	lda  #$B9		;..entire loop	sta  |0,y		;these first two should really be in	lda  #$9F		;..short mode, but it doesn't save us	sta  |3,y		;..anything	txa		;use the index	sta  |1,y	sta  |4,y	tya	adc  #7		;the carry is always CLEAR here	tay	dex	dex	bne  @loop	PushLong #StartOfCode	;this is the source pointer	shortm		;this is the destination pointer	lda  #0	pha	phb	longm	phy	PushLong #EndOfCode-StartOfCode	;the amount of memory to move	PushWord #%0000100000000101	;flags for moving forward	jsl  $E10200		;memory mover entry point	jsl  ResetPPToPortBank	;the bank bytes are wrong	rts;---------------------------------------------------------------;---------------------------------------------------------------StartOfCodepatch1	lda  |$BBBB,y		;*** this must be patched ***patch2	eor  >$EEBBBB,x		;*** this must be patched ***	and  rightMaskpatch3	eor  >$EEBBBB,x		;*** this must be patched ***patch4	sta  >$EEBBBB,x		;*** this must be patched ***singleStart	lda  |0,y	eor  >$EE0000,x	and  leftMask	eor  >$EE0000,x	sta  >$EE0000,x	dec  numberOfLines	beq  codeDone	txa	adc  dstWidth	tax	bcs  dstWrapdoSrc	tya	adc  srcWidth	tay	bcs  srcWrappatch5	brl  StartOfCode		;*** this must be patched ***srcWrap	phb	pla	inc  a	pha	plb	clc	bra  patch5dstWrap	inc  dstPtr+2	jsl  ResetPPToPortBank	bra  doSrccodeDone	rtlEndOfCode;---------------------------------------------------------------;---------------------------------------------------------------derefCodeHandle	ldy  #2		;deref the code handle and make the data	lda  [PPToPortCodeHandle],y	;..bank and the Y-Reg a pointer into it	sta  theCodePtr+2		;..at the same time	pei  theCodePtr+1	plb	plb	lda  [PPToPortCodeHandle]	sta  theCodePtr	tay	rts;---------------------------------------------------------------	ENDP****************************************************************FastScrollRect	PROCNAME  Export;---------------------------------------------------------------	stax ScrollDelta		;save the amount to scroll	lda  TempRect.top		;copy the top coordinate	sta  dstRect.top	lda  TempRect.left		;copy the left coordinate	sta  dstRect.left	lda  TempRect.bottom	;copy the bottom coordinate	sta  dstRect.bottom	lda  TempRect.right		;copy the right coordinate	sta  dstRect.right;---------------------------------------------------------------	jsr  SetupDstPtr		;find the destination pointer	bcc  @1	jsr  CopyTempToDrawRect	brl  allDone@1	lda  dstRect.top		;copy the dest rect into draw rect	sta  DrawRect.top	lda  dstRect.left	sta  DrawRect.left	lda  dstRect.bottom	sta  DrawRect.bottom	lda  dstRect.right	sta  DrawRect.right	ldx  ScrollDelta+2		;find out which way we are scrolling	bmi  goingUp	beq  goingDown	brl  allDone;---------------------------------------------------------------goingDown	lda  ScrollDelta	beq  allDone	bmi  allDone	clc	adc  DrawRect.top	cmp  DrawRect.bottom	bpl  allDone	sta  DrawRect.bottom	lda  NumberOfLines	dec  a	sec	sbc  ScrollDelta	ldx  dstWidth	jsr  WordMultiply	adc  dstPtr		;carry is clear here	sta  srcPtr	lda  dstPtr+2	adc  #0	sta  srcPtr+2	lda  NumberOfLines	dec  a	ldx  dstWidth	jsr  WordMultiply	adc  dstPtr		;carry is clear here	sta  dstPtr	bcs  @1	inc  dstPtr+2@1	lda  NumberOfLines	sec	sbc  ScrollDelta	beq  allDone	sta  NumberOfLines	lda  dstWidth	eor  #$FFFF	inc  a	sta  dstWidth	bra  setItUp;---------------------------------------------------------------goingUp	inx	bne  allDone	lda  ScrollDelta	bpl  allDone	clc	adc  DrawRect.bottom	cmp  DrawRect.top	bmi  allDone	sta  DrawRect.top	lda  ScrollDelta	clc	adc  NumberOfLines	beq  allDone	sta  NumberOfLines	lda  ScrollDelta	eor  #$FFFF	inc  a	ldx  dstWidth	jsr  WordMultiply	adc  dstPtr		;carry is clear here	sta  srcPtr	lda  dstPtr+2	adc  #0	sta  srcPtr+2;---------------------------------------------------------------setItUp	jsr  SetupScrollCode	;setup our code buffer	bcs  allDone	jsr  CallMemoryCodeallDone	brl  TellAboutDstRect;---------------------------------------------------------------	ENDP****************************************************************SetupScrollCode	PROCNAME  Entry;---------------------------------------------------------------MinWordsInHandle	equ  20;---------------------------------------------------------------;---------------------------------------------------------------	phb		;save the data bank	jsr  derefCodeHandle	;this also sets the data bank and Y-Reg	lda  |2,y		;check the maximum number of bytes that	cmp  numberOfWords		;..this handle can move	bge  SizeOK	PushZLong ScrollCodeHandle	;set the handle size to the proper amount	lda  numberOfWords		;when we build the handle it must be a	cmp  #MinWordsInHandle	;..certain minimum size	bge  @ok	lda  #MinWordsInHandle@ok	dec  a		;the first and last words are treated	dec  a		;..specially	asl  a		;this multiplies by six	sta  TempWord	asl  a	adc  TempWord	adc  #EndOfCode-StartOfCode+5+1	ldx  #0	jsr  SetHandleSize		;if we got a memory error then exit	bcs  exit	jsr  fillTheHandle		;deref and fill the handle	ldy  theCodePtr		;reload Y-Reg with the correct offset;---------------------------------------------------------------sizeOK	lda  |0,y		;this is the size of the variable field	clc		;we want to skip over that, so we can	adc  theCodePtr		;..patch the items we want to.	tay		;Y-Reg is now our pointer	lda  numberOfWords		;here we find the amount to branch back	dec  a		;..by	tax		;save the number of words minus one	bne  @notSingle	lda  #StartOfCode-singleStart	bra  @subtractIt@notSingle	dec  a	bne  @notDouble	lda  >patch5+1	bra  @setJumpAddr@notDouble	asl  a	sta  TempWord	asl  a	adc  TempWord@subtractIt	sta  TempWord	lda  >patch5+1	sec	sbc  TempWord@setJumpAddr	sta  |patch5-StartOfCode+1,y	txa		;get back the number of words minus one	asl  a		;..and multiply by two	sta  |patch1-StartOfCode+1,y	;patch all the spots that need to be	sta  |patch2-StartOfCode+1,y	sta  |patch3-StartOfCode+1,y	sta  |patch4-StartOfCode+1,y	ldy  theCodePtr		;here we calculate the code pointer which	lda  |2,y		;..is the address, we must jsl to in order	sec		;..to start this entire process	sbc  numberOfWords	asl  a	sta  TempWord	asl  a	adc  TempWord	adc  #4-1	ldx  numberOfWords		;if we are moving one word, then we need	dex		;..a further adjustment of 8	bne  @notOne	adc  #8		;the carry is always clear here@notOne	adc  theCodePtr		;add to the original starting address of	sta  theCodePtr		;..of codePtr. (carry is always CLR);---------------------------------------------------------------exit	plb	rts;---------------------------------------------------------------;---------------------------------------------------------------fillTheHandle	jsr  derefCodeHandle	;this also sets the data bank and Y-Reg	lda  numberOfWords		;when we build the handle it must be a	cmp  #MinWordsInHandle	;..certain minimum size	bge  @ok	lda  #MinWordsInHandle@ok	sta  |2,y	dec  a		;the first and last words are treated	dec  a		;..specially	asl  a	sta  TempWord	tax		;this is our index and count register	asl  a	adc  TempWord	adc  #4	sta  |0,y	iny	iny	iny	iny	clc		;the carry will be CLEAR throughout the@loop	lda  #$B9		;..entire loop	sta  |0,y		;these first two should really be in	lda  #$9D		;..short mode, but it doesn't save us	sta  |3,y		;..anything	txa		;use the index	sta  |1,y	sta  |4,y	tya	adc  #6		;the carry is always CLEAR here	tay	dex	dex	bne  @loop	PushLong #StartOfCode	;this is the source pointer	shortm		;this is the destination pointer	lda  #0	pha	phb	longm	phy	PushLong #EndOfCode-StartOfCode	;the amount of memory to move	PushWord #%0000100000000101	;flags for moving forward	jsl  $E10200		;memory mover entry point	rts;---------------------------------------------------------------;---------------------------------------------------------------StartOfCodepatch1	lda  |$BBBB,y		;*** this must be patched ***patch2	eor  |$BBBB,x		;*** this must be patched ***	and  rightMaskpatch3	eor  |$BBBB,x		;*** this must be patched ***patch4	sta  |$BBBB,x		;*** this must be patched ***singleStart	lda  |0,y	eor  |$0000,x	and  leftMask	eor  |$0000,x	sta  |$0000,x	dec  numberOfLines	beq  codeDone		;NOTE: the pixel map must not cross a	txa		;..bank !!!	clc	adc  dstWidth	tax	tya	clc	adc  dstWidth	taypatch5	brl  StartOfCode		;*** this must be patched ***codeDone	rtlEndOfCode;---------------------------------------------------------------;---------------------------------------------------------------derefCodeHandle	ldy  #2		;deref the code handle and make the data	lda  [ScrollCodeHandle],y	;..bank and the Y-Reg a pointer into it	sta  theCodePtr+2		;..at the same time	pei  theCodePtr+1	plb	plb	lda  [ScrollCodeHandle]	sta  theCodePtr	tay	rts;---------------------------------------------------------------	ENDP****************************************************************CallMemoryCode	PROCNAME  Entry;---------------------------------------------------------------	phb		;save the bank register	jsr  ShieldTheCursor	ldx  dstPtr		;the X-reg is the destination ptr	ldy  srcPtr		;..and the Y-Reg is the source ptr	pei  srcPtr+1		;set the bank to the source bank	plb	plb	pea  |(returnHere-1)>>8	;push the return address combined with	lda  #(returnHere-1)<<8	;..the pointer to jump to.	ora  theCodePtr+2	pha	pei  theCodePtr	clc		;the carry should be clear for the code	rtl		;..handlereturnHere	jsr  UnshieldTheCursor	plb		;restore the bank register	rts;---------------------------------------------------------------	ENDP****************************************************************TellAboutDstRect	PROCNAME  Entry;---------------------------------------------------------------	ldy  #TERecord.FilterProc+1	;is there a filter procedure ? If not then	lda  [RecordPtr],y		;..just exit	beq  @noFilter	ldy  #TERecord.theFilterRect.top	;copy the dest rect to the record handle	lda  dstRect.top	sta  [RecordPtr],y	iny	iny	lda  dstRect.left	sta  [RecordPtr],y	iny	iny	lda  dstRect.bottom	sta  [RecordPtr],y	iny	iny	lda  dstRect.right	sta  [RecordPtr],y	lda  #doRectChanged		;call the filter proc	brl  CallFilterProc@noFilter	rts;---------------------------------------------------------------	ENDP****************************************************************SetupSrcPtr	PROCNAME  Entry;---------------------------------------------------------------	ldy  #GrafPort.ImageRef	;get the starting source pointer	lda  [DrawPortPtr],y	sta  srcPtr	ldy  #GrafPort.ImageRef+2	lda  [DrawPortPtr],y	sta  srcPtr+2	ldy  #GrafPort.Width	lda  [DrawPortPtr],y	sta  srcWidth	lda  dstRect.top	sec	sbc  TextVPos	clc	adc  TempRect.top	tax	beq  @skipMult	lda  srcWidth	jsr  WordMultiply	bcs  @goSlow	adc  srcPtr	sta  srcPtr	bcc  @skipMult	inc  srcPtr+2@skipMult	ldy  #GrafPort.PortSCB	;get which mode we are into X-Reg	lda  [DrawPortPtr],y	tax	lda  dstRect.left	sec	ldy  #TERecord.ViewRect.left	sbc  [RecordPtr],y	sec	ldy  #GrafPort.BoundsRect.left	sbc  [DrawPortPtr],y	beq  @skipLeft	lsr  a	lsr  a	cpx  #0	beq  @1	lsr  a@1	asl  a	adc  srcPtr	sta  srcPtr	bcc  @skipLeft	inc  srcPtr+2	clc@skipLeft	rts@goSlow	sec	rts;---------------------------------------------------------------	ENDP****************************************************************SetupDstPtr	PROCNAME  Entry;---------------------------------------------------------------	jsr  GetWindowPortPtr	;TempPtr = the window's port ptr	ldy  #GrafPort.BoundsRect.bottom	;clip the dstRect to the bottom of the	lda  [TempPtr],y		;..boundsRect	cmp  dstRect.bottom	bpl  @1	sta  dstRect.bottom@1	ldy  #GrafPort.BoundsRect.right	;clip the dstRect to the right of the	lda  [TempPtr],y		;..boundsRect	cmp  dstRect.right	bpl  @2	sta  dstRect.right@2	stz  TempWord		;this will be the combined sizes of the	ldy  #GrafPort.ClipRgn	;..clipRgn and the visRgn. Also clip the	jsr  clipToRgn		;..dstRect to both regions	ldy  #GrafPort.VisRgn	jsr  clipToRgn	lda  dstRect.top		;check to see if we still have a non zero	cmp  dstRect.bottom		;..rectangle.	bpl  @quickExit	lda  dstRect.left	cmp  dstRect.right	bmi  @continue@quickExit	pla		;if we don't, then pull off one return	rts		;..addr and exit@continue	lda  TempWord	cmp  #10	bne  doSlow;---------------------------------------------------------------doFast	ldy  #GrafPort.ImageRef	;initialize dstPtr and dstWidth	lda  [TempPtr],y	sta  dstPtr	ldy  #GrafPort.ImageRef+2	lda  [TempPtr],y	sta  dstPtr+2	ldy  #GrafPort.Width	lda  [TempPtr],y	sta  dstWidth	lda  dstRect.top		;offset dstPtr to get to the beginning	sec		;..of our scan line.	ldy  #GrafPort.BoundsRect.top	sbc  [TempPtr],y	tax	lda  dstWidth	jsr  WordMultiply	bcs  doSlow	adc  dstPtr	sta  dstPtr	bcc  @1	inc  dstPtr+2@1	lda  dstRect.bottom		;initialize the number of lines	sec	sbc  dstRect.top	sta  numberOfLines	ldy  #GrafPort.PortSCB	lda  [TempPtr],y	bne  do640	bra  do320;---------------------------------------------------------------doSlow	sec	rts;---------------------------------------------------------------do320	lda  dstRect.left		;convert the local coordinates to "semi-	sec		;..global" coordinates	ldy  #GrafPort.BoundsRect.left	sbc  [TempPtr],y	tax	lsr  a		;divide by four to get the number of	lsr  a		;..words and save this value.	sta  numberOfWords		;then multiply by two to get the number		asl  a		;..of bytes. (this leaves the carry CLR)	adc  dstPtr		;make dstPtr point to the first word in	sta  dstPtr		;..the line	bcc  @2	inc  dstPtr+2@2	txa		;get back the original semi-global HPos	and  #$0003		;find the number of pixels left in this	asl  a		;..word. Use that as an index into the	tax		;..left mask table	lda  >LeftMaskTable320,x	sta  leftMask	lda  dstRect.right		;the two grafPorts are word aligned so we	sec		;..can use the source grafPort to find	sbc  [TempPtr],y		;..the right mask. (Y-Reg hasn't changed)	tax	lsr  a	lsr  a	inc  a	sec	sbc  numberOfWords	sta  numberOfWords	txa	and  #$0003	beq  exactEdge	asl  a		;this clears the carry	tax	lda  >RightMaskTable320,x	bra  setTheMasks;---------------------------------------------------------------do640	lda  dstRect.left		;convert the local coordinates to "semi-	sec		;..global" coordinates	ldy  #GrafPort.BoundsRect.left	sbc  [TempPtr],y	tax	lsr  a		;divide by eight to get the number of	lsr  a		;..words and save this value.	lsr  a	sta  numberOfWords		;then multiply by two to get the number		asl  a		;..of bytes. (this leaves the carry CLR)	adc  dstPtr		;make dstPtr point to the first word in	sta  dstPtr		;..the line	bcc  @1	inc  dstPtr+2@1	txa		;get back the original semi-global HPos	and  #$0007		;find the number of pixels left in this	asl  a		;..word. Use that as an index into the	tax		;..left mask table	lda  >LeftMaskTable640,x	sta  leftMask	lda  dstRect.right		;the two grafPorts are word aligned so we	sec		;..can use the source grafPort to find	sbc  [TempPtr],y		;..the right mask. (Y-Reg hasn't changed)	tax	lsr  a	lsr  a	lsr  a	inc  a	sec	sbc  numberOfWords	sta  numberOfWords	txa	and  #$0007	beq  exactEdge	asl  a		;this clears the carry	tax	lda  >RightMaskTable640,x;---------------------------------------------------------------setTheMasks	sta  rightMask	ldx  numberOfWords	dex	bne  @2	and  leftMask	sta  leftMask@2	rts		;the carry is still clear here;---------------------------------------------------------------exactEdge	dec  numberOfWords	lda  #$FFFF	sta  rightMask	clc	rts;---------------------------------------------------------------;---------------------------------------------------------------RightMaskTable640	dc.w  %0000000000000000	dc.w  %0000000011000000	dc.w  %0000000011110000	dc.w  %0000000011111100	dc.w  %0000000011111111	dc.w  %1100000011111111	dc.w  %1111000011111111	dc.w  %1111110011111111;---------------------------------------------------------------LeftMaskTable640	dc.w  %1111111111111111	dc.w  %1111111100111111	dc.w  %1111111100001111	dc.w  %1111111100000011	dc.w  %1111111100000000	dc.w  %0011111100000000	dc.w  %0000111100000000	dc.w  %0000001100000000;---------------------------------------------------------------RightMaskTable320	dc.w  %0000000000000000	dc.w  %0000000011110000	dc.w  %0000000011111111	dc.w  %1111000011111111;---------------------------------------------------------------LeftMaskTable320	dc.w  %1111111111111111	dc.w  %1111111100001111	dc.w  %1111111100000000	dc.w  %0000111100000000;---------------------------------------------------------------;---------------------------------------------------------------clipToRgn	lda  [TempPtr],y		;copy the region handle into our temporary	sta  theCodePtr		;..pointer	iny	iny	lda  [TempPtr],y	sta  theCodePtr+2	Deref theCodePtr,theCodePtr	;this leaves Y-Reg equal to two	lda  [theCodePtr]		;or the size field into TempWord. If the	ora  TempWord		;..combined value is 10, both sizes must	sta  TempWord		;..be either 10 or 0 (which is illegal).	lda  [theCodePtr],y		;Y-Reg is still 2 here (boundsRect.top)	cmp  dstRect.top	bmi  @1	sta  dstRect.top@1	ldy  #4	lda  [theCodePtr],y	cmp  dstRect.left	bmi  @2	sta  dstRect.left@2	ldy  #6	lda  [theCodePtr],y	cmp  dstRect.bottom	bpl  @3	sta  dstRect.bottom@3	ldy  #8	lda  [theCodePtr],y	cmp  dstRect.right	bpl  @4	sta  dstRect.right@4	rts;---------------------------------------------------------------	ENDP****************************************************************Fast1Proc	PROC	ENTRY  ShieldTheCursor	ENTRY  UnshieldTheCursor;---------------------------------------------------------------MinRect	RECORD 0top	ds.w  1left	ds.w  1bottom	ds.w  1right	ds.w  1	ENDRImageRef	equ  14BoundsRect	RECORD 20top	ds.w  1left	ds.w  1bottom	ds.w  1right	ds.w  1	ENDR;---------------------------------------------------------------;---------------------------------------------------------------ShieldTheCursor	phb		;save the data bank	phd		;save our direct page	ldy  #TERecord.inPort+1	;make the data bank and Y-Reg into a	lda  [RecordPtr],y		;..pointer to our grafPort	pha	plb	plb	dey	lda  [RecordPtr],y	tay	ldx  QDDirectPage		;make X-Reg into a pointer to quickdraw's	lda  dstRect.top		;..direct page	sta  >MinRect.top,x	lda  dstRect.bottom	sta  >MinRect.bottom,x	lda  dstRect.left	sta  >MinRect.left,x	lda  dstRect.right	sta  >MinRect.right,x	txa		;set quickdraw's direct page	tcd	lda  |GrafPort.BoundsRect.top,y	;copy the bounds rect to QD's direct page	sta  BoundsRect.top	lda  |GrafPort.BoundsRect.left,y	sta  BoundsRect.left	lda  |GrafPort.BoundsRect.bottom,y	sta  BoundsRect.bottom	lda  |GrafPort.BoundsRect.right,y	sta  BoundsRect.right	lda  |GrafPort.ImageRef,y	;copy the image ref to QD's direct page	sta  ImageRef	lda  |GrafPort.ImageRef+2,y	sta  ImageRef+2	jsl  $E01E98		;this is the shield cursor vector	pld		;restore our direct page	plb		;restore our data bank	rts;---------------------------------------------------------------UnshieldTheCursor	phd		;save our direct page	lda  QDDirectPage		;set quickdraw's	tcd	jsl  $E01E9C		;this is the unshield cursor vector	pld	rts;---------------------------------------------------------------	ENDP****************************************************************InvertTempRect	PROCNAME  Export;---------------------------------------------------------------	lda  TempRect.right	sec	sbc  TempRect.left	cmp  #3	blt  tryFast;---------------------------------------------------------------doSlow	PushZPtr TempRect	_InvertRect	brl  allDone;---------------------------------------------------------------tryFast	lda  TempRect.top		;copy the top coordinate	sta  dstRect.top	lda  TempRect.bottom	;copy the bottom coordinate	sta  dstRect.bottom	lda  TempRect.left		;copy the left coordinate	sta  dstRect.left	lda  TempRect.right		;copy the right coordinate	sta  dstRect.right	jsr  GetWindowPortPtr	ldy  #GrafPort.PnMask@loop	lda  [TempPtr],y	cmp  #$FFFF	bne  doSlow	iny	iny	cpy  #GrafPort.PnMask+8	blt  @loop	jsr  SetupDstPtr		;find the destination pointer	bvc  @mustDraw	rts		;return here if nothing more to draw@mustDraw	bcs  doSlow	lda  numberOfWords	dec  a	beq  doSingle	dec  a	bne  doSlow;---------------------------------------------------------------doEdges	phb		;save the bank register	jsr  ShieldTheCursor	ldx  #$FFFF	ldy  #2@slowLoop	clc		;the carry must remain clear throughout@fastLoop	txa		;..the loop	and  leftMask	eor  [dstPtr]	sta  [dstPtr]	txa	and  rightMask	eor  [dstPtr],y	sta  [dstPtr],y	dec  numberOfLines	beq  fastDone	lda  dstPtr	adc  dstWidth	sta  dstPtr	bcc  @fastLoop	inc  dstPtr+2	bra  @slowLoop;---------------------------------------------------------------doSingle	phb		;save the bank register	jsr  ShieldTheCursor	lda  leftMask	and  rightMask	sta  leftMask	ldx  #$FFFF@slowLoop	clc		;the carry must remain clear throughout@fastLoop	txa		;..the loop	and  leftMask	eor  [dstPtr]	sta  [dstPtr]	dec  numberOfLines	beq  fastDone	lda  dstPtr	adc  dstWidth		;carry is already clear	sta  dstPtr	bcc  @fastLoop	inc  dstPtr+2	bra  @slowLoop;---------------------------------------------------------------fastDone	jsr  UnshieldTheCursor	plb		;restore the bank register;---------------------------------------------------------------allDone	ldy  #TERecord.FilterProc+1	lda  [RecordPtr],y	beq  @noFilter	jsr  PassTempRect		;pass the TempRect in the TERecord	lda  #doRectChanged		;call the filter proc	brl  CallFilterProc@noFilter	rts;---------------------------------------------------------------	ENDP****************************************************************SetupAndClearBuffer	PROCNAME  Export;---------------------------------------------------------------	phb		;save the original data bank;---------------------------------------------------------------	jsr  GetWindowPortPtr	;get a pointer to the control's port	ldy  #GrafPort.BoundsRect.left	;save the boundsRect.left of the window's	lda  [TempPtr],y		;..port in TempWord	sta  TempWord	ldy  #GrafPort.PortSCB	;copy the 320/640 flag into the X-Reg	lda  [TempPtr],y	tax	ldy  #TERecord.ViewRect.left	;copy the parts of the viewRect that we	lda  [RecordPtr],y		;..need into TempRect	sta  TempRect.left	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	sta  TempRect.right;---------------------------------------------------------------	pei  DrawPortPtr+1		;set the new data bank to the drawing port	plb	plb	ldy  DrawPortPtr	txa		;copy the 320/640 flag into the new	sta  |GrafPort.PortSCB,y	;..grafPort	lda  #0		;clear the top of the boundsRect and the	sta  |GrafPort.BoundsRect.top,y	;..top and left of the port rect	sta  |GrafPort.PortRect.top,y	sta  |GrafPort.PortRect.left,y	lda  LineHeight		;set the bounds and port rect bottom to	sta  |GrafPort.BoundsRect.bottom,y	;..the line height	sta  |GrafPort.PortRect.bottom,y	sta  |GrafPort.UserField,y	;save the line height in the userField	lda  TempRect.right		;set the right coordinate of the port	sec		;..rect	sbc  TempRect.left	sta  |GrafPort.PortRect.right,y	ldy  #TERecord.TextDrawMode	;copy the text drawing mode	lda  [RecordPtr],y	ldy  DrawPortPtr	sta  |GrafPort.TxMode,y;---------------------------------------------------------------	cpx  #$0080	beq  do640Modedo320Mode	lda  TempWord		;newBounds.left =	sec		;..[ -1 * [(view.left - oldBounds.left)	sbc  TempRect.left		;.. mod 4] ]. which is the same as	ora  #$FFFC		;..[(oldBounds.left - view.left) mod 4]	cmp  #$FFFC	bne  @1	lda  #0@1	sta  |GrafPort.BoundsRect.left,y	lda  |GrafPort.PortRect.right,y	sec	sbc  |GrafPort.BoundsRect.left,y	clc	adc  #15+4	and  #$FFF0	lsr  a	sta  |GrafPort.Width,y	bra  commondo640Mode	lda  TempWord		;newBounds.left =	sec		;..[ -1 * [(view.left - oldBounds.left)	sbc  TempRect.left		;.. mod 8] ]. which is the same as	ora  #$FFF8		;..[(oldBounds.left - view.left) mod 8]	cmp  #$FFF8	bne  @1	lda  #0@1	sta  |GrafPort.BoundsRect.left,y	lda  |GrafPort.PortRect.right,y	sec	sbc  |GrafPort.BoundsRect.left,y	clc	adc  #31+4	and  #$FFE0	lsr  a	lsr  a	sta  |GrafPort.Width,y	asl  acommon	asl  a		;this clears the carry	adc  |GrafPort.BoundsRect.left,y	sta  |GrafPort.BoundsRect.right,y;---------------------------------------------------------------	lda  |GrafPort.Width,y	;multiply the width by the height and	ldx  LineHeight		;..round up to the nearest multiple of	jsr  WordMultiply		;..32 bytes to get the total size	adc  #31	and  #$FFE0	sta  DataBufferSize	ldy  #HandleRecord.length	lda  [DataBufferHandle],y	cmp  DataBufferSize	bge  @bufferOK	PushZLong DataBufferHandle	lda  DataBufferSize	ldx  #0	jsr  SetHandleSize	bcc  @bufferOK	plb		;restore the original data bank and	sec		;..return the carry set to indicate an	rts		;..error@bufferOK	PushZLong DataBufferHandle	jsr  LockHandle	ldy  DrawPortPtr	sta  |GrafPort.ImageRef,y	txa	sta  |GrafPort.ImageRef+2,y	jsr  SetDrawPort;---------------------------------------------------------------	ldy  #TERecord.FilterProc+1	lda  [RecordPtr],y	beq  noFilter;---------------------------------------------------------------	ldy  #TERecord.theFilterRect	ldx  DrawPortPtr@loop	lda  |GrafPort.PortRect,x	sta  [RecordPtr],y	iny	iny	inx	inx	cpy  #TERecord.theFilterRect+8	blt  @loop	ldy  #TERecord.theFilterRect.left	;cut down the size of the filter rect	lda  TextHPos		;..to just what we need to draw	sta  [RecordPtr],y	ldy  #TERecord.ViewRect.left	;set the buffer horizontal and vertical	lda  [RecordPtr],y		;..positions	ldy  #TERecord.theBufferHPos	sta  [RecordPtr],y	lda  TextVPos	ldy  #TERecord.theBufferVPos	sta  [RecordPtr],y	lda  #doEraseBuffer		;call the filter erase	jsr  CallFilterProc	beq  noFilter	bra  done;---------------------------------------------------------------noFilter	jsr  SetupColorPtr		;set the background pattern for the text	ldy  #TEColorTable.content	lda  [TempPtr],y	sta  TempWord		;save the color to clear to	ldy  DrawPortPtr	ldx  |GrafPort.ImageRef,y	lda  |GrafPort.ImageRef+1,y	pha	plb	plb	lda  DataBufferSize	lsr  a	lsr  a	lsr  a	lsr  a	lsr  a		;carry is always clear here because the	tay		;..size is a multiple of 32;---------------------------------------------------------------loop	lda  TempWord	sta  |30,x	sta  |28,x	sta  |26,x	sta  |24,x	sta  |22,x	sta  |20,x	sta  |18,x	sta  |16,x	sta  |14,x	sta  |12,x	sta  |10,x	sta  |8,x	sta  |6,x	sta  |4,x	sta  |2,x	sta  |0,x	txa	adc  #32	tax	bcs  bumpBanknextBlock	dey	bne  loop;---------------------------------------------------------------done	clc	plb	rts;---------------------------------------------------------------bumpBank	phb	pla		;the high byte will never be changed	inc  a		;..so it is safe to pull and push it	pha	plb	clc	bra  nextBlock;---------------------------------------------------------------	ENDP****************************************************************SaveBackground	PROCNAME  Export;---------------------------------------------------------------portPtr	equ  6saveBuffer	equ  9;---------------------------------------------------------------;---------------------------------------------------------------	jsr  MakeQDDirty		;make sure QD knows we are changing the port	tsc		;adjust the stack to allow for 32 + 4	sec		;..bytes of space if we write over the	sbc  #34		;..two byte return address	tcs;---------------------------------------------------------------	_GetPort	lda  35,s		;copy the return address down the stack	pha	phb		;save the bank register;---------------------------------------------------------------	jsr  SetupColorPtr		;save the background pattern for the text	ldy  #TEColorTable.content	lda  [TempPtr],y	pha	tsx		;(9,x) is now a pointer to the save buffer	lda  portPtr+1,s		;set the bank to the high byte of the	pha		;..port pointer	plb	plb	lda  portPtr,s		;Y-Reg is the low word of the port ptr	tay;---------------------------------------------------------------	lda  |GrafPort.BkPat,y	;save the background pattern	sta  >saveBuffer,x	lda  |GrafPort.BkPat+2,y	sta  >saveBuffer+2,x	lda  |GrafPort.BkPat+4,y	sta  >saveBuffer+4,x	lda  |GrafPort.BkPat+6,y	sta  >saveBuffer+6,x	lda  |GrafPort.BkPat+8,y	sta  >saveBuffer+8,x	lda  |GrafPort.BkPat+10,y	sta  >saveBuffer+10,x	lda  |GrafPort.BkPat+12,y	sta  >saveBuffer+12,x	lda  |GrafPort.BkPat+14,y	sta  >saveBuffer+14,x	lda  |GrafPort.BkPat+16,y	sta  >saveBuffer+16,x	lda  |GrafPort.BkPat+18,y	sta  >saveBuffer+18,x	lda  |GrafPort.BkPat+20,y	sta  >saveBuffer+20,x	lda  |GrafPort.BkPat+22,y	sta  >saveBuffer+22,x	lda  |GrafPort.BkPat+24,y	sta  >saveBuffer+24,x	lda  |GrafPort.BkPat+26,y	sta  >saveBuffer+26,x	lda  |GrafPort.BkPat+28,y	sta  >saveBuffer+28,x	lda  |GrafPort.BkPat+30,y	sta  >saveBuffer+30,x;---------------------------------------------------------------	pla	sta  |GrafPort.BkPat,y	sta  |GrafPort.BkPat+2,y	sta  |GrafPort.BkPat+4,y	sta  |GrafPort.BkPat+6,y	sta  |GrafPort.BkPat+8,y	sta  |GrafPort.BkPat+10,y	sta  |GrafPort.BkPat+12,y	sta  |GrafPort.BkPat+14,y	sta  |GrafPort.BkPat+16,y	sta  |GrafPort.BkPat+18,y	sta  |GrafPort.BkPat+20,y	sta  |GrafPort.BkPat+22,y	sta  |GrafPort.BkPat+24,y	sta  |GrafPort.BkPat+26,y	sta  |GrafPort.BkPat+28,y	sta  |GrafPort.BkPat+30,y	plb	rts;---------------------------------------------------------------	ENDP****************************************************************RestoreBackground	PROCNAME  Export;---------------------------------------------------------------portPtr	equ  4saveBuffer	equ  7;---------------------------------------------------------------;---------------------------------------------------------------	jsr  MakeQDDirty		;make sure QD knows we are changing the port	phb	tsx		;(9,x) is now a pointer to the save buffer	lda  portPtr+1,s		;set the bank to the high byte of the	pha		;..port pointer	plb	plb	lda  portPtr,s		;Y-Reg is the low word of the port ptr	tay;---------------------------------------------------------------	lda  >saveBuffer,x	sta  |GrafPort.BkPat,y	;save the background pattern	lda  >saveBuffer+2,x	sta  |GrafPort.BkPat+2,y	lda  >saveBuffer+4,x	sta  |GrafPort.BkPat+4,y	lda  >saveBuffer+6,x	sta  |GrafPort.BkPat+6,y	lda  >saveBuffer+8,x	sta  |GrafPort.BkPat+8,y	lda  >saveBuffer+10,x	sta  |GrafPort.BkPat+10,y	lda  >saveBuffer+12,x	sta  |GrafPort.BkPat+12,y	lda  >saveBuffer+14,x	sta  |GrafPort.BkPat+14,y	lda  >saveBuffer+16,x	sta  |GrafPort.BkPat+16,y	lda  >saveBuffer+18,x	sta  |GrafPort.BkPat+18,y	lda  >saveBuffer+20,x	sta  |GrafPort.BkPat+20,y	lda  >saveBuffer+22,x	sta  |GrafPort.BkPat+22,y	lda  >saveBuffer+24,x	sta  |GrafPort.BkPat+24,y	lda  >saveBuffer+26,x	sta  |GrafPort.BkPat+26,y	lda  >saveBuffer+28,x	sta  |GrafPort.BkPat+28,y	lda  >saveBuffer+30,x	sta  |GrafPort.BkPat+30,y;---------------------------------------------------------------	plb	lda  1,s	sta  37,s	tsc	clc	adc  #36	tcs	rts;---------------------------------------------------------------	ENDP****************************************************************SetupPenState	PROCNAME  Export;---------------------------------------------------------------newPattern	equ  TempLongnewMask	equ  TempLong+2;---------------------------------------------------------------;---------------------------------------------------------------	sta  newPattern	stx  newMask	jsr  MakeQDDirty		;make sure QD knows we are changing the port	jsr  GetWindowPortPtr	plx;---------------------------------------------------------------	ldy  #GrafPort.PnSize@loop	lda  [TempPtr],y	pha	iny	iny	cpy  #GrafPort.PnVis+2	blt  @loop;---------------------------------------------------------------	phb	pei  TempPtr+1	plb	plb	ldy  TempPtr	lda  #1	sta  |GrafPort.PnSize.v,y	sta  |GrafPort.PnSize.h,y	lda  #modeCopy	sta  |GrafPort.PnMode,y	lda  #0	sta  |GrafPort.PnVis,y	lda  newPattern	sta  |GrafPort.PnPat,y	sta  |GrafPort.PnPat+2,y	sta  |GrafPort.PnPat+4,y	sta  |GrafPort.PnPat+6,y	sta  |GrafPort.PnPat+8,y	sta  |GrafPort.PnPat+10,y	sta  |GrafPort.PnPat+12,y	sta  |GrafPort.PnPat+14,y	sta  |GrafPort.PnPat+16,y	sta  |GrafPort.PnPat+18,y	sta  |GrafPort.PnPat+20,y	sta  |GrafPort.PnPat+22,y	sta  |GrafPort.PnPat+24,y	sta  |GrafPort.PnPat+26,y	sta  |GrafPort.PnPat+28,y	sta  |GrafPort.PnPat+30,y	sta  |GrafPort.PnPat+32,y	lda  newMask	sta  |GrafPort.PnMask,y	sta  |GrafPort.PnMask+2,y	sta  |GrafPort.PnMask+4,y	sta  |GrafPort.PnMask+6,y	plb;---------------------------------------------------------------	phx	rts;---------------------------------------------------------------	ENDP****************************************************************RestorePenState	PROCNAME  Export	jsr  MakeQDDirty		;make sure QD knows we are changing the port	jsr  GetWindowPortPtr	plx	ldy  #GrafPort.PnVis@loop	pla	sta  [TempPtr],y	dey	dey	cpy  #GrafPort.PnSize	bge  @loop	phx	rts	ENDP****************************************************************WordMultiply	PROCNAME  Export;---------------------------------------------------------------	cmp  #160	bne  realMult;---------------------------------------------------------------	cpx  #409	bge  @done	txa	asl  a	asl  a	asl  a	asl  a	asl  a	sta  TempWord	asl  a	asl  a	adc  TempWord@done	rts;---------------------------------------------------------------realMult	stax TempLong	lda  #0		;NOTE: this won't work if TempLong is@loop	ldx  TempLong		;..zero to start with	beq  @done	lsr  TempLong	bcc  @noAdd	clc	adc  TempLong+2	bcs  @done@noAdd	asl  TempLong+2	bcc  @loop@done	rts;---------------------------------------------------------------	ENDP****************************************************************MakeQDDirty	PROCNAME  Export;---------------------------------------------------------------DirtyFlags	equ  $2EC;---------------------------------------------------------------;---------------------------------------------------------------	ldx  QDDirectPage		;use the X-Reg as an offset to quickdraw's	lda  >DirtyFlags,x		;..direct page	and  #$8000		;clear all the bits in the dirty flags	sta  >DirtyFlags,x		;..to tell quickdraw to rebuild everything	rts;---------------------------------------------------------------	ENDP****************************************************************	END