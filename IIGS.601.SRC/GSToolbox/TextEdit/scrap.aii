************************************************************************                      GSTextEdit  Version 1.0*                          File: scrap.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'	INCLUDE  'E16.Scrap'****************************************************************CutGuts	PROCNAME  Export;---------------------------------------------------------------	jsr  ReturnIfCaret	jsr  CopyGuts	bcc  @1	rts@1	jsr  GetTEHighFlags	and  #fSmartCutPaste	beql skipSmart;---------------------------------------------------------------	jsr  UnhilightSelection	lda  #$FFFF	sta  SmartExtendFlag;---------------------------------------------------------------extendTheStart	jsr  GetSelectionStart	lda  TextOffset	ora  TextOffset+2	beq  extendTheEnd@startLoop	decl TextOffset	jsr  FindTextPtr	lda  [TextPtr]	and  #$00FF	cmp  #' '	beq  @startLoop	incl TextOffset	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmp  TextOffset	bne  @setStart	cpx  TextOffset+2	beq  extendTheEnd@setStart	jsr  SetSelectionStart	stz  SmartExtendFlag;---------------------------------------------------------------extendTheEnd	jsr  GetSelectionEnd@endLoop	jsr  IsOffsetAtEnd	beq  @setEnd	jsr  FindTextPtr	lda  [TextPtr]	and  #$00FF	cmp  #' '	bne  @setEnd	stz  SmartExtendFlag	incl TextOffset	bra  @endLoop@setEnd	jsr  SetSelectionEnd;---------------------------------------------------------------addASpace	lda  SmartExtendFlag	bmi  @notEnd	jsr  GetSelectionStart	jsr  FindTextPtr	lda  [TextPtr]	and  #$00FF	cmp  #' '	bne  @notStart	incl TextOffset	jsr  SetSelectionStart	bra  @notEnd@notStart	jsr  GetSelectionEnd	decl TextOffset	jsr  SetSelectionEnd@notEnd	jsr  HilightSelection;---------------------------------------------------------------skipSmart	brl  ClearGuts;---------------------------------------------------------------	ENDP****************************************************************ClearGuts	PROCNAME  Export;---------------------------------------------------------------	jsr  ReturnIfCaret	brl  RemoveText;---------------------------------------------------------------	ENDP****************************************************************CopyGuts	PROCNAME  Export;---------------------------------------------------------------	jsr  ReturnIfCaret	jsr  GetSelectionLength	_ZeroScrap@loop	jsr  FindTextPtr	PushZLong BlockHandle	;lock the block handle	jsr  LockHandle	lda  SelectionLength+2	bne  @1	lda  SelectionLength	cmp  BlockCount	bge  @1	sta  BlockCount@1	pea  $0000		;push the length	pei  BlockCount	PushWord #textScrap	PushZLong TextPtr	_PutScrap	php	phx	PushZLong BlockHandle	;unlock the block handle	jsr  UnlockHandle	plx	plp	bcsl memoryError	lda  BlockCount	addl TextOffset	lda  SelectionLength	sec	sbc  BlockCount	sta  SelectionLength	bcs  @2	dec  SelectionLength+2@2	ora  SelectionLength+2	bne  @loop;---------------------------------------------------------------copyStyles	lda  #StyleRecordVersion	;start the style record with the version	sta  TempWord		;..number	ldy  #TERecord.RulerList	;follow this by the length of the ruler	jsr  PushRecordLong		;..list	jsr  GetHandleSize	stax MoveLength	sec	sbc  #4	bcs  @1	dex@1	stax TempLong	PushLong #6	PushWord #styleScrap	PushZPtr TempWord	_PutScrap	bcsl memoryError	ldy  #TERecord.RulerList	;next put the ruler list on the end of the	jsr  PushRecordLong		;..scrap	jsr  LockHandle	PushZLong MoveLength	PushWord #styleScrap	PushAX	_PutScrap	php	phx	ldy  #TERecord.RulerList	jsr  PushRecordLong	jsr  UnlockHandle	plx	plp	bcsl memoryError;---------------------------------------------------------------countItems	stzl StyleItemCount		;count the number of items in the selection	jsr  GetSelectionStart@loop	jsr  FindStyleInfo	jsr  MoveOffsetToNextItem	incl StyleItemCount	jsr  CompareOffsetWithSelcEnd	blt  @loop	ldax StyleItemCount		;find the number of bytes that this many	stx  TempLong+2		;..items will take up	asl  a		;multiply by eight	rol  TempLong+2	asl  a	rol  TempLong+2	asl  a	rol  TempLong+2	clc	adc  #4	bcc  @1	inc  TempLong+2@1	ldx  TempLong+2	jsr  GetLargeHandle		;get a new handle to contain the new items	bcsl memoryError	stax NewBufferHandle	PushAX		;lock the handle down and leave the	jsr  LockHandle		;..pointer in DestPtr	stax DestPtr	ldy  #2		;store the item count in the first four	lda  StyleItemCount		;..bytes of the buffer	sta  [DestPtr]	lda  StyleItemCount+2	sta  [DestPtr],y	jsr  AddFourToDestPtr	;skip over this count;---------------------------------------------------------------copyItems	ldy  #TERecord.StyleList	jsr  PushRecordLong		;save a copy of the old style list on the	jsr  PushRecordLong		;..stack. Also lock the list down and put	jsr  LockHandle		;..the pointer in SourcePtr	stax SourcePtr	jsr  GetTerminatedHandle	;get a four byte terminated handle for the	ldy  #TERecord.StyleList	;..selection's style list and put this in	jsr  SetRecordLong		;..the control record !?!	jsr  GetSelectionStart@loop	movl TextOffset,OriginalOffset	jsr  FindStyleInfo	jsr  GetLongSuperCount	clc	adc  TextOffset	sta  TextOffset	txa	adc  TextOffset+2	sta  TextOffset+2	jsr  CompareOffsetWithSelcEnd	blt  @ok	jsr  GetSelectionEnd@ok	ldy  #2	lda  TextOffset	sec	sbc  OriginalOffset	sta  [DestPtr]	lda  TextOffset+2	sbc  OriginalOffset+2	sta  [DestPtr],y	PushZLong SourcePtr	PushZLong DestPtr	lda  SourcePtr	clc	adc  TextStyleOffset	pha	lda  SourcePtr+2	adc  TextStyleOffset+2	tax	pla	jsr  AddToStyleList	bcsl memoryError3	PullLong DestPtr	PullLong SourcePtr	ldy  #4	lda  TextStyleOffset	sta  [DestPtr],y	iny	iny	lda  TextStyleOffset+2	sta  [DestPtr],y	jsr  AddEightToDestPtr	jsr  CompareOffsetWithSelcEnd	blt  @loop;---------------------------------------------------------------cleanup	jsr  getScrapEndPtr	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  GetHandleSize	sec	sbc  #4	bcs  @1	dex@1	stax TempLong	ldy  #2	sta  [TempPtr]	txa	sta  [TempPtr],y	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  LockHandle	PushZLong TempLong	PushWord #styleScrap	PushAX	_PutScrap	bcs  memoryError2	ldy  #TERecord.StyleList	;kill the newly allocated style list	jsr  GetRecordLong	jsr  KillHandle	PushZLong NewBufferHandle	jsr  GetHandleSize	PushAX	PushWord #styleScrap	PushZLong NewBufferHandle	jsr  LockHandle	PushAX	_PutScrap	bcs  memoryError1	ldax NewBufferHandle	jsr  KillHandle	lda  3,s		;get the original style list into A,X	tax	lda  1,s	ldy  #TERecord.StyleList	jsr  SetRecordLong	jsr  UnlockHandle	ldx  #0	clc	rts;---------------------------------------------------------------;---------------------------------------------------------------memoryError3	pla		;cleanup the stack	pla	pla	pla;---------------------------------------------------------------memoryError2	phx	ldy  #TERecord.StyleList	;kill the newly allocated style list	jsr  GetRecordLong	jsr  KillHandle	plx;---------------------------------------------------------------memoryError1	phx	ldax NewBufferHandle	jsr  KillHandle	lda  3,s		;get the original style list into A,X	tax	lda  1,s	ldy  #TERecord.StyleList	jsr  SetRecordLong	jsr  UnlockHandle	plx;---------------------------------------------------------------memoryError	phx		;save the error code	_ZeroScrap		;clear the scrap, so we don't leave any	plx		;..bogus data. Restore the error code	brl  SetLastErrorCode	;report the last error;---------------------------------------------------------------;---------------------------------------------------------------getScrapEndPtr	PushLongSpace	PushWord #styleScrap	_GetScrapHandle	lda  3,s	sta  TempPtr+2	lda  1,s	sta  TempPtr	jsr  DerefTempPtr	jsr  GetHandleSize	sec	sbc  #4	bcs  @2	dex@2	clc	adc  TempPtr	sta  TempPtr	txa	adc  TempPtr+2	sta  TempPtr+2	rts;---------------------------------------------------------------	ENDP****************************************************************PasteGuts	PROCNAME  Export;---------------------------------------------------------------	PushLongSpace	PushWord #textScrap	_GetScrapHandle	tax	pla	sta  InputTextRef	pla	sta  InputTextRef+2	bcc  @weHaveText	cpx  #$1610	beql noError	brl  errorInX@weHaveText;---------------------------------------------------------------doSmart1	jsr  GetTEHighFlags	and  #fSmartCutPaste	beq  @skip	jsr  GetSelectionStart	lda  TextOffset	ora  TextOffset+2	beq  @skip	decl TextOffset		;check the character just before the	jsr  FindTextPtr		;..selection	lda  [TextPtr]	jsr  IsItAWordBreak		;if it is already a word break, then don't	bcs  @skip		;..insert a space	Deref InputTextRef,TextPtr	;now check the first character in the	lda  [TextPtr]		;..scrap	jsr  IsItAWordBreak		;if it is already a word break, then we	bcs  @skip		;..also don't need a space	jsr  insertSpace	bcs  errorInX@skip;---------------------------------------------------------------doThePaste	PushLongSpace	PushWord #styleScrap	_GetScrapHandle	tay	PullAX	bcc  @1	cpy  #$1610		;type not found	bne  errorInY	lda  #0	tax@1	stax InputStyleRef	lda  #dataIsTextBlock+textIsHandle	sta  InputTextVerb	lda  #refIsHandle	sta  InputStyleVerb	jsr  TranslateInputVerbs	jsr  ReplaceText	php	phx	jsr  ReleaseInputVerbs	plx	plp	bcs  errorInX;---------------------------------------------------------------doSmart2	jsr  GetTEHighFlags	and  #fSmartCutPaste	beq  @skip	jsr  GetSelectionStart	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordBreak	bcs  @skip		;TextOffset MUST be > 0, since we just	decl TextOffset		;..pasted something	jsr  FindTextPtr		;check the character just before the	lda  [TextPtr]		;..selection	jsr  IsItAWordBreak		;if it is already a word break, then don't	bcs  @skip		;..insert a space	brl  insertSpace@skip;---------------------------------------------------------------noError	ldx  #0	clc	rts;---------------------------------------------------------------errorInY	tyxerrorInX	sec	rts;---------------------------------------------------------------;---------------------------------------------------------------insertSpace	jsr  GetTEHighFlags		;check to see if the record is editable	and  #fReadOnly		;..or not	beq  @insertIt	ldx  #0	clc	rts@insertIt	lda  #' '		;we are inserting a space	ldy  #TERecord.theKeyRecord.theChar	sta  [RecordPtr],y	tya		;make a pointer into the TERecord	clc	adc  RecordPtr	sta  InputTextPtr	lda  RecordPtr+2	adc  #0	sta  InputTextPtr+2	lda  #1		;length of one	sta  InputTextLength	stz  InputTextLength+2	stzl InputStyleRef		;no styles	brl  ReplaceText		;replace the text;---------------------------------------------------------------	ENDP****************************************************************ReturnIfCaret	PROCNAME  Entry;---------------------------------------------------------------	jsr  IsTheSelectionACaret	beq  @exit	rts@exit	pla		;pull off one set of return addresses	ldx  #0	clc	rts;---------------------------------------------------------------	ENDP****************************************************************	END