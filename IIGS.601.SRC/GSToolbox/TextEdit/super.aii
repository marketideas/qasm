************************************************************************                      GSTextEdit  Version 1.0*                          File: super.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************FindStyleInfo	PROCNAME  Export	ldy  #TERecord.StyleSuper	jsr  FindSuperInfo	lda  [TempPtr],y	sta  TextStyleOffset	iny	iny	lda  [TempPtr],y	sta  TextStyleOffset+2	brl  ChangeWidthTable	ENDP****************************************************************SetStyleInfo	PROCNAME  Export	ldy  #TERecord.StyleSuper	jsr  SetSuperInfo	lda  TextStyleOffset	sta  [TempPtr],y	iny	iny	lda  TextStyleOffset+2	sta  [TempPtr],y	rts	ENDP****************************************************************FindLineInfo	PROCNAME  Export	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	lda  [TempPtr],y	sta  LineHeight	iny	iny	lda  [TempPtr],y	sta  LineAscent	rts	ENDP****************************************************************FindLineStart	PROCNAME  Export	jsr  FindLineInfo	movl SuperStart,TextOffset	rts	ENDP****************************************************************SetLineInfo	PROCNAME  Export	ldy  #TERecord.LineSuper	jsr  SetSuperInfo	lda  LineHeight	sta  [TempPtr],y	iny	iny	lda  LineAscent	sta  [TempPtr],y	rts	ENDP****************************************************************GetNewSuperHandle	PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperRecordPtr	ldy  #SuperHandle.itemsPerBlock	;set the initial items per block	lda  #ItemsInSmallBlock	sta  [SuperRecordPtr],y	lda  #SizeOfSmallBlock	;get a handle of the starting block size	jsr  GetHandleFromSuper	bcs  memoryError	stax TheSuperHandle	jsr  SetSuperCachedHandle	jsr  SuperHandleToPtr	;get a pointer to our newly allocated handle	lda  #0		;fill the links and the text length fields	tay		;..with zeros. Also fill the first item@loop1	sta  [TempPtr],y		;..with zeros.	iny	iny	cpy  #SuperBlock.RecordSize+SuperItemSize	blt  @loop1@loop2	lda  #$FFFF	sta  [TempPtr],y		;..deleted item marker (highest bit set)	iny	iny	sta  [TempPtr],y	tya	clc	adc  #SuperItemSize-2	tay	cpy  #SizeOfSmallBlock	blt  @loop2	ldy  #SuperHandle.cachedIndex	lda  #SuperBlock.RecordSize	sta  [SuperRecordPtr],y	ldy  #SuperHandle.cachedTextOffset	lda  #0	sta  [SuperRecordPtr],y	iny	iny	sta  [SuperRecordPtr],y	clcmemoryError	rts;---------------------------------------------------------------	ENDP****************************************************************KillSuperHandle	PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperRecordPtr	ldy  #2		;check to see if the cached super handle	lda  [SuperRecordPtr],y	;..is clear. If it is, then this super	ora  [SuperRecordPtr]	;..handle has already been killed.	beq  @exit	jsr  MoveToFirstSuperHandle@loop	PushZLong TheSuperHandle	jsr  SuperHandleToPtr	jsr  MoveToNextHandle	PullAX	php	jsr  KillHandle	plp	bcc  @loop@exit	ldy  #2		;clear the super cache handle to indicate	lda  #0		;..that we have killed this super handle	sta  [SuperRecordPtr],y	sta  [SuperRecordPtr]	rts;---------------------------------------------------------------	ENDP****************************************************************FindSuperInfo	PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperRecordPtr	;get a pointer to the super record	jsr  GetSuperCachedPtr	;get a pointer into the cached handle	jsr  GetSuperMaxIndex	ldy  #SuperHandle.cachedTextOffset+2	lda  [SuperRecordPtr],y	sta  SuperStart+2	tax	dey	dey	lda  [SuperRecordPtr],y	sta  SuperStart	cpx  TextOffset+2	blt  checkForward	bne  doBackward	cmp  TextOffset	bgt  doBackward;---------------------------------------------------------------checkForward	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	tay	lda  [TempPtr],y	sta  SuperLength	iny	iny	clc	adc  SuperStart	tax	lda  [TempPtr],y	sta  SuperLength+2	iny	iny	adc  SuperStart+2	cmp  TextOffset+2	blt  doForward	bne  alreadyThere	cpx  TextOffset	blt  doForward	bne  alreadyThere	lda  SuperStart	cmp  TextOffset	bne  doForward	lda  SuperStart+2	cmp  TextOffset+2	bne  doForward;---------------------------------------------------------------alreadyThere	rts;---------------------------------------------------------------doBackward	brl  FindSuperBackwarddoForward	brl  FindSuperForward;---------------------------------------------------------------	ENDP****************************************************************FindSuperBackward	PROCNAME  Entry;---------------------------------------------------------------	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	tay;---------------------------------------------------------------mainLoop	iny	inyinnerLoop	tya		;move the index back an item	cmp  #SuperBlock.RecordSize+2	beq  prevBlockinBlock	sec	sbc  #SuperItemSize	tay	lda  [TempPtr],y	bmi  innerLoop	sta  SuperLength+2	dey	dey	lda  SuperStart		;subtract the length of the item from	sec		;..SuperStart.	sbc  [TempPtr],y	sta  SuperStart	tax	lda  SuperStart+2	sbc  SuperLength+2	sta  SuperStart+2	cmp  TextOffset+2		;is SuperStart < TextOffset ?	blt  @foundIt	bne  mainLoop	cpx  TextOffset	bgt  mainLoop@foundIt	brl  ExitFindSuper;---------------------------------------------------------------prevBlock	jsr  MoveToPrevHandle	ldy  #SuperBlock.textLength	lda  SuperStart	sec	sbc  [TempPtr],y	tax	iny	iny	lda  SuperStart+2	sbc  [TempPtr],y	cmp  TextOffset+2	blt  @foundBlock	bne  @notFound	cpx  TextOffset	ble  @foundBlock@notFound	stx  SuperStart	sta  SuperStart+2	bra  prevBlock@foundBlock	jsr  SetSuperCachedHandle	lda  SuperMaxIndex	bra  inBlock;---------------------------------------------------------------	ENDP****************************************************************FindSuperForward	PROCNAME  Entry;---------------------------------------------------------------	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	sec	sbc  #SuperItemSize	tay;---------------------------------------------------------------mainLoop	iny	iny@loop	tya	clc	adc  #SuperItemSize	cmp  SuperMaxIndex	beq  nextBlock	tay	lda  [TempPtr],y	bmi  @loop	sta  SuperLength+2	dey	dey	lda  [TempPtr],y	clc	adc  SuperStart		;and add it to the current start	tax		;save the low word in X	lda  SuperLength+2	adc  SuperStart+2	cmp  TextOffset+2	blt  @notFound	bne  @foundIt	cpx  TextOffset	bgt  @foundIt@notFound	sta  SuperStart+2		;this is the reverse of the normal order	stx  SuperStart		;..(remember the LOW word is in X-Reg)	bra  mainLoop@foundIt	brl  ExitFindSuper;---------------------------------------------------------------nextBlock	jsr  MoveToNextHandle	bcs  atEnd	ldy  #SuperBlock.textLength	lda  SuperStart	clc	adc  [TempPtr],y	tax	iny	iny	lda  SuperStart+2	adc  [TempPtr],y	cmp  TextOffset+2	blt  @notFound	bne  @foundBlock	cpx  TextOffset	bgt  @foundBlock@notFound	stx  SuperStart	sta  SuperStart+2	bra  nextBlock@foundBlock	jsr  SetSuperCachedHandle	ldy  #SuperBlock.RecordSize-SuperItemSize	bra  mainLoop;---------------------------------------------------------------atEnd	ldy  SuperMaxIndex@loop2	tya	cmp  #SuperBlock.RecordSize+2	beq  @movePrev	sec	sbc  #SuperItemSize	tay	lda  [TempPtr],y	bmi  @loop2	phy	jsr  SetSuperCachedHandle	ply	lda  [TempPtr],y	sta  SuperLength+2	dey	dey	lda  SuperStart	sec	sbc  [TempPtr],y	sta  SuperStart	lda  SuperStart+2	sbc  SuperLength+2	sta  SuperStart+2	brl  ExitFindSuper@movePrev	jsr  MoveToPrevHandle	bra  atEnd;---------------------------------------------------------------	ENDP****************************************************************ExitFindSuper	PROCNAME  Entry;---------------------------------------------------------------	lda  [TempPtr],y		;save the low word of the length	sta  SuperLength	tya	ldy  #SuperHandle.cachedIndex	sta  [SuperRecordPtr],y	clc		;skip over the length and save this index	adc  #4		;..for later	tax	ldy  #SuperHandle.cachedTextOffset	lda  SuperStart	sta  [SuperRecordPtr],y	iny	iny	lda  SuperStart+2	sta  [SuperRecordPtr],y	txy		;restore the index	rts;---------------------------------------------------------------	ENDP****************************************************************ClearSuperCachedHandle PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperCachedPtr	ldy  #SuperHandle.itemsPerBlock	;use X-Reg as a counter to count all	lda  [SuperRecordPtr],y	;..the items in the super handle	tax	ldy  #SuperBlock.textLength	;clear the textLength field	lda  #0	sta  [TempPtr],y	iny	iny	sta  [TempPtr],y	ldy  #SuperBlock.RecordSize	clc@loop	lda  #$FFFF	sta  [TempPtr],y	iny	iny	sta  [TempPtr],y	tya	adc  #SuperItemSize-2	;carry is always clear here	tay	dex	bne  @loop	rts;---------------------------------------------------------------	ENDP****************************************************************SetSuperInfo	PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperRecordPtr	;setup the pointers to access the cached	jsr  GetSuperCachedPtr	;..handle in the passed super (in Y-Reg)	ldy  #SuperHandle.cachedIndex	;get the current index into the cached	lda  [SuperRecordPtr],y	;..handle	tay	lda  SuperLength		;subtract the old value from the new one	sec	sbc  [TempPtr],y	pha		;save the low word on the stack	lda  SuperLength		;copy the new length into the super array	sta  [TempPtr],y	iny		;NOTE: the carry hasn't changed from the	iny		;..subtract	lda  SuperLength+2		;subtract the high word of the old value	sbc  [TempPtr],y		;..from the new one	tax		;save the high word in the X-Reg	lda  SuperLength+2		;copy the high word of the new length into	sta  [TempPtr],y		;..the super array	iny		;leave the index pointing to the SuperData	iny	pla		;get the low word of the diff back into A-Reg	phy		;save the final index to the SuperData	ldy  #SuperBlock.textLength	;add the difference to the textLength for	clc		;..the entire block. This will update the	adc  [TempPtr],y		;..block length field.	sta  [TempPtr],y	iny	iny	txa	adc  [TempPtr],y	sta  [TempPtr],y	ply		;restore index to the SuperData	rts;---------------------------------------------------------------	ENDP****************************************************************AddANewSuperHandle	PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperRecordPtr	jsr  GetSuperCachedPtr	PushZLong TheSuperHandle	lda  #SizeOfLargeBlock	jsr  GetHandleFromSuper	bcs  memoryError	PushAX	jsr  SuperHandleToPtr	;re-dereference the super handle	ldy  #SuperBlock.nextHandle	;set the next handle link in the previous	pla		;..handle to the new handle	sta  TheSuperHandle	sta  [TempPtr],y	iny	iny	pla	sta  TheSuperHandle+2	sta  [TempPtr],y	jsr  SetSuperCachedHandle	jsr  SuperHandleToPtr	ldy  #SuperBlock.prevHandle	;set the prev handle link in the new	pla		;..handle to the previous handle	sta  [TempPtr],y	iny	iny	pla	sta  [TempPtr],y	ldy  #SuperBlock.nextHandle	;clear the next handle field in the new	lda  #0		;..super handle	sta  [TempPtr],y	iny	iny	sta  [TempPtr],y	jsr  ClearSuperCachedHandle	ldy  #SuperHandle.cachedIndex	;set the current index to the start of the	lda  #SuperBlock.RecordSize	;..new handle	sta  [SuperRecordPtr],y	clc	rts;---------------------------------------------------------------memoryError	pla		;pull off the garbage	pla		;the carry is alreay SET and the X-Reg	rts		;..already contains the error;---------------------------------------------------------------	ENDP***************************************************************** this inserts a new super item at the current text offset* the new super data is a copy of the old one****************************************************************InsertSuperItem	PROCNAME  Export;---------------------------------------------------------------          IF SuperItemSize <> 8 THEN              AERROR 'WARNING... This routine relies on the SuperItemSize equate being eight'          ENDIF;---------------------------------------------------------------;---------------------------------------------------------------	jsr  FindSuperInfo		;find the item at the current TextOffset	subl TextOffset,SuperStart,SuperLength	ldy  #SuperHandle.cachedTextOffset	;update the cached SuperStart field	lda  [SuperRecordPtr],y	clc	adc  SuperLength	sta  [SuperRecordPtr],y	iny	iny	lda  [SuperRecordPtr],y	adc  SuperLength+2	sta  [SuperRecordPtr],y	ldy  #SuperHandle.cachedIndex	;check to see if we are at the end of the	lda  [SuperRecordPtr],y	;..current super block	clc	adc  #SuperItemSize+2	tay	cpy  SuperMaxIndex	beq  mustSearch		;yes, so we must search for a deleted item	lda  [TempPtr],y		;nope, are we alreay on a deleted item ?	bpl  mustSearch		;..nope = must search;---------------------------------------------------------------insertIt	lda  TempPtr		;make a pointer to the next item in	clc		;..MemoryPtr	adc  #SuperItemSize	sta  MemoryPtr	lda  TempPtr+2	adc  #0	sta  MemoryPtr+2	ldy  #SuperHandle.cachedIndex	;get an index to the current item	lda  [SuperRecordPtr],y	tay	lda  [TempPtr],y		;subtract the new length from the old one	sec		;..to get the length of the new item	sbc  SuperLength	sta  [MemoryPtr],y	tax	lda  SuperLength		;also, set the old length to SuperLength	sta  [TempPtr],y	stx  SuperLength		;set SuperLength to the new length	iny	iny	lda  [TempPtr],y	sbc  SuperLength+2	sta  [MemoryPtr],y	tax	lda  SuperLength+2	sta  [TempPtr],y	stx  SuperLength+2	iny		;copy the remaining super data into the	iny		;..next item. Rely on SuperData being	lda  [TempPtr],y		;..four bytes	sta  [MemoryPtr],y	iny	iny	lda  [TempPtr],y	sta  [MemoryPtr],y	ldy  #SuperHandle.cachedIndex	;move the index on to the next item	lda  [SuperRecordPtr],y	clc	adc  #SuperItemSize	sta  [SuperRecordPtr],y	clc	rts;---------------------------------------------------------------mustSearch	sty  TempWord		;save the index to the next item	ldy  #SuperBlock.RecordSize+2@loop	lda  [TempPtr],y	bmi  @foundIt	tya	clc	adc  #SuperItemSize	tay	cpy  TempWord	bne  @loop	bra  searchAfter@foundIt	tya	eor  #$FFFF	sec		;add one to make a full negate	adc  TempWord	lsr  a	lsr  a	lsr  a	tax	jsr  makeJustPointers	ldy  #2@copyLoop	lda  [SourcePtr],y	bmi  @skipCopy	jsr  copyAndFreeItem	jsr  AddEightToDestPtr@skipCopy	jsr  AddEightToSourcePtr	dex	bne  @copyLoop	lda  DestPtr	sec	sbc  TempPtr	sbc  #SuperItemSize	ldy  #SuperHandle.cachedIndex	sta  [SuperRecordPtr],y	brl  insertIt;---------------------------------------------------------------searchAfter	cpy  SuperMaxIndex	beq  mustExtend	ldy  SuperMaxIndex@loop	tya	sec	sbc  #SuperItemSize	tay	cmp  TempWord	beq  mustExtend	lda  [TempPtr],y	bpl  @loop@foundIt	jsr  makePointers	inx	ldy  #2@copyLoop	lda  [SourcePtr],y	bmi  @skipCopy	jsr  copyAndFreeItem	lda  DestPtr	sec	sbc  #8	sta  DestPtr	bcs  @skipCopy	dec  DestPtr+2@skipCopy	lda  SourcePtr	sec	sbc  #8	sta  SourcePtr	bcs  @1	dec  SourcePtr+2@1	dex	bne  @copyLoop	brl  insertIt;---------------------------------------------------------------mustExtend	ldy  #SuperHandle.itemsPerBlock	;we must extend the super array here, so	lda  [SuperRecordPtr],y	;..check to see if we can just extend the	cmp  #ItemsInSmallBlock	;..handle or whether we need to make a new	beql doSmallToMedium	;..one	cmp  #ItemsInMediumBlock	beql doMediumToLarge;---------------------------------------------------------------addNewHandle	ldy  #SuperHandle.cachedIndex	;subtract SuperLength from the old item	lda  [SuperRecordPtr],y	;..length, then set the old item length	tay		;..to SuperLength. Finally put the result	lda  [TempPtr],y		;..of the subtraction into SuperLength	sec	sbc  SuperLength	tax	lda  SuperLength	sta  [TempPtr],y	stx  SuperLength	iny	iny	lda  [TempPtr],y	sbc  SuperLength+2	tax	lda  SuperLength+2	sta  [TempPtr],y	stx  SuperLength+2	iny	iny	lda  [TempPtr],y		;save the original item's super data on	pha		;..the stack.	iny	iny	lda  [TempPtr],y	pha	jsr  SubLengthFromBlock	;subtract super length from the block length	jsr  InsertSuperHandle	;add a new super handle	bcc  @noError1	jsr  SuperHandleToPtr	;redereference the pointer	pla		;pull the saved data off the stack	pla	phx		;save the error code on the stack	jsr  AddLengthToBlock	;add super length to the block	ldy  #SuperHandle.cachedIndex	;add super length to the current item	lda  [SuperRecordPtr],y	tay	lda  [TempPtr],y	tax	clc	adc  SuperLength	sta  [TempPtr],y	stx  SuperLength	iny	iny	lda  [TempPtr],y	tax	adc  SuperLength+2	sta  [TempPtr],y	stx  SuperLength+2	plx	brl  memoryError@noError1	ldy  #SuperHandle.cachedIndex	;get the old cache index and see if we	lda  [SuperRecordPtr],y	;..were at the end of the block.	clc	adc  #SuperItemSize+2	;add an extra two so we can compare against	cmp  SuperMaxIndex		;..SuperMaxIndex. If we weren't at the end	bne  @moveIt		;..of the block then move the items@setFirstItem	ldy  #SuperHandle.cachedIndex	lda  #SuperBlock.RecordSize	;set the cache index for the new block	sta  [SuperRecordPtr],y	tay		;Y-Reg now points to the first item. Set	lda  SuperLength		;..this item to the remaining length	sta  [TempPtr],y	iny	iny	lda  SuperLength+2	sta  [TempPtr],y	iny	iny	plx		;copy the old super data into the new	pla		;..item	sta  [TempPtr],y	iny	iny	txa	sta  [TempPtr],y	jsr  AddLengthToBlock	;set the total block length field	clc	rts@moveIt	PushZLong SuperLength	;save the super length for the new item	sta  TempWord	dec  a	dec  a	sta  SourcePtr	stz  SourcePtr+2	lda  SuperMaxIndex		;make a pointer to the end of the new	dec  a		;..super block	dec  a	clc	adc  TempPtr	sta  DestPtr	lda  TempPtr+2	adc  #0	sta  DestPtr+2	jsr  MoveToPrevHandle	addl TempPtr,SourcePtr,SourcePtr	lda  SuperMaxIndex	sec	sbc  TempWord	sta  MoveLength	stz  MoveLength+2	lda  DestPtr	sec	sbc  MoveLength	sta  DestPtr	bcs  @1	dec  DestPtr+2@1	jsr  BlockMove	stzl SuperLength	lda  MoveLength	lsr  a	lsr  a	lsr  a	tax	ldy  #0	clc		;clear the carry for the duration of the@loop	lda  [SourcePtr],y		;..loop	adc  SuperLength	sta  SuperLength	lda  #$FFFF	sta  [SourcePtr],y	iny	iny	lda  [SourcePtr],y	adc  SuperLength+2		;this always clears the carry again	sta  SuperLength+2	lda  #$FFFF	sta  [SourcePtr],y	tya	adc  #SuperItemSize-2	;the carry is always clear here	tay	dex	bne  @loop	jsr  SubLengthFromBlock	jsr  MoveToNextHandle	jsr  AddLengthToBlock	PullLong SuperLength	lda  MoveLength	asl  a	cmp  SuperMaxIndex	bltl @setFirstItem@putInOldBlock	jsr  MoveToPrevHandle	jsr  SetSuperCachedHandle	lda  SuperLength	sta  [SourcePtr]	ldy  #2	lda  SuperLength+2	sta  [SourcePtr],y	iny	iny	plx		;copy the old super data into the new	pla		;..item	sta  [SourcePtr],y	iny	iny	txa	sta  [SourcePtr],y	jsr  AddLengthToBlock	;set the total block length field	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	clc	adc  #SuperItemSize	sta  [SuperRecordPtr],y	;carry is always CLR here	rts;---------------------------------------------------------------doSmallToMedium	lda  #ItemsInMediumBlock	;resize the super handle to medium	bra  resizeItdoMediumToLarge	lda  #ItemsInLargeBlock	;resize the super handle to largeresizeIt	PushZWord SuperMaxIndex	ldy  #SuperHandle.itemsPerBlock	sta  [SuperRecordPtr],y	lda  SuperRecordPtr		;mark this super array as in use	sec	sbc  RecordPtr	sta  SuperInUse	PushZLong TheSuperHandle	jsr  GetSuperMaxIndex	;find the correct size for the new handle	dec  a	dec  a	ldx  #0	jsr  SetHandleSize	stz  SuperInUse	bcc  @noError1	pla		;pull the saved data off the stack	phx	jsr  SuperHandleToPtr	plx	bra  memoryError@noError1	jsr  SuperHandleToPtr	ply	sty  TempWord@loop1	lda  #$FFFF	sta  [TempPtr],y	dey	dey	sta  [TempPtr],y	tya	clc	adc  #SuperItemSize+2	tay	cpy  SuperMaxIndex	blt  @loop1	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	clc	adc  #SuperItemSize	tay	sta  MoveLength	lda  TempWord	dec  a	dec  a	sec	sbc  MoveLength	sta  MoveLength	beq  @skipMove	stz  MoveLength+2	tya	clc	adc  TempPtr	sta  SourcePtr	lda  TempPtr+2	adc  #0	sta  SourcePtr+2	lda  SuperMaxIndex	dec  a	dec  a	clc	adc  TempPtr	sta  DestPtr	lda  TempPtr+2	adc  #0	sta  DestPtr+2	subl DestPtr,MoveLength,DestPtr	jsr  BlockMove	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	clc	adc  #SuperItemSize+2	tay@loop2	lda  #$FFFF	sta  [TempPtr],y	dey	dey	sta  [TempPtr],y	tya	clc	adc  #SuperItemSize+2	tay	cpy  TempWord	blt  @loop2@skipMove	brl  insertIt;---------------------------------------------------------------memoryError	ldy  #SuperHandle.cachedTextOffset	;update the cached SuperStart field	lda  [SuperRecordPtr],y	sec	sbc  SuperLength	sta  [SuperRecordPtr],y	iny	iny	lda  [SuperRecordPtr],y	sbc  SuperLength+2	sta  [SuperRecordPtr],y	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	tay	lda  [TempPtr],y	sta  SuperLength	iny	iny	lda  [TempPtr],y	sta  SuperLength+2	sec		;the error code is still in X-Reg	rts;---------------------------------------------------------------;---------------------------------------------------------------copyAndFreeItem	lda  [SourcePtr]	sta  [DestPtr]	lda  [SourcePtr],y	sta  [DestPtr],y	lda  #$FFFF		;clear the source	sta  [SourcePtr]	sta  [SourcePtr],y	iny	iny	lda  [SourcePtr],y	sta  [DestPtr],y	iny	iny	lda  [SourcePtr],y	sta  [DestPtr],y	ldy  #2	rts;---------------------------------------------------------------makePointers	tya	sec	sbc  TempWord	lsr  a	lsr  a	lsr  a	tax		;this is our item countermakeJustPointers	dey	dey	tya	clc	adc  TempPtr	sta  DestPtr	sta  SourcePtr	lda  TempPtr+2	adc  #0	sta  DestPtr+2	sta  SourcePtr+2	rts;---------------------------------------------------------------	ENDP****************************************************************ChangeStyleItem	PROCNAME  Export;---------------------------------------------------------------	movl SuperLength,NewSuperLength	ldy  #TERecord.StyleSuper	jsr  FindSuperInfo	lda  [TempPtr],y	iny	iny	cmp  TextStyleOffset	bne  doIt	lda  [TempPtr],y	cmp  TextStyleOffset+2	bne  doIt	brl  allDone;---------------------------------------------------------------doIt	lda  SuperStart	cmp  TextOffset	bne  @addBefore	lda  SuperStart+2	cmp  TextOffset+2	beq  @skip1@addBefore	ldy  #TERecord.StyleSuper	;make a new item at the current text offset	jsr  InsertSuperItem	bcc  @noError1		;if we get a memory error, then return	rts@noError1@skip1	lda  SuperLength	cmp  NewSuperLength	bne  @addAfter	lda  SuperLength+2	cmp  NewSuperLength+2	beq  @skip2@addAfter	addl TextOffset,NewSuperLength,TextOffset	ldy  #TERecord.StyleSuper	;make a new item at the current text offset	jsr  InsertSuperItem	php		;save the state of the carry	subl TextOffset,NewSuperLength,TextOffset	plp		;restore the carry	bcc  @noError2	rts		;if we get a memory error, then return@noError2@skip2	ldy  #TERecord.StyleSuper	jsr  FindSuperInfo	lda  TextStyleOffset	sta  [TempPtr],y	iny	iny	lda  TextStyleOffset+2	sta  [TempPtr],y;---------------------------------------------------------------checkPrev	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	inc  a	inc  a	tay@loop1	tya	cmp  #SuperBlock.RecordSize+2	bne  @1	jsr  MoveToPrevHandle	bcs  checkNext	lda  SuperMaxIndex@1	sec	sbc  #SuperItemSize	tay	lda  [TempPtr],y	bmi  @loop1@foundIt	iny	iny	lda  [TempPtr],y	cmp  TextStyleOffset	bne  checkNext	iny	iny	lda  [TempPtr],y	cmp  TextStyleOffset+2	bne  checkNext	movl NewSuperLength,SuperLength	PushZLong TheSuperHandle	dey	dey	dey	dey	lda  [TempPtr],y		;copy the original length to a scratch	sta  SuperStart+2		;..variable. (we can overwrite SuperStart	dey		;..here since we are going to reset it	dey		;..later)	lda  [TempPtr],y	sta  SuperStart	phy		;save this index for later	jsr  addLength	jsr  AddLengthToBlock	ldy  #SuperHandle.cachedTextOffset	;update the cached starting offset field	lda  [SuperRecordPtr],y	sec	sbc  SuperStart	sta  SuperStart	sta  [SuperRecordPtr],y	iny	iny	lda  [SuperRecordPtr],y	sbc  SuperStart+2	sta  SuperStart+2	sta  [SuperRecordPtr],y	jsr  GetSuperCachedPtr	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	tay	lda  #$FFFF	sta  [TempPtr],y	iny	iny	sta  [TempPtr],y	jsr  SubLengthFromBlock	ldy  #SuperHandle.cachedIndex	pla	sta  [SuperRecordPtr],y	ldy  #SuperHandle.cachedHandle	pla	sta  [SuperRecordPtr],y	iny	iny	pla	sta  [SuperRecordPtr],y;---------------------------------------------------------------checkNext	jsr  GetSuperCachedPtr	;get the cached handle back	jsr  GetSuperMaxIndex	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	inc  a	inc  a	tay@loop1	tya	clc	adc  #SuperItemSize	cmp  SuperMaxIndex	bne  @1	jsr  MoveToNextHandle	bcs  allDone	lda  #SuperBlock.RecordSize+2@1	tay	lda  [TempPtr],y	bmi  @loop1@foundIt	iny	iny	lda  [TempPtr],y	cmp  TextStyleOffset	bne  allDone	iny	iny	lda  [TempPtr],y	cmp  TextStyleOffset+2	bne  allDone	tya	sec	sbc  #6	tay	lda  [TempPtr],y	sta  SuperLength	lda  #$FFFF	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	sta  SuperLength+2	lda  #$FFFF	sta  [TempPtr],y	jsr  SubLengthFromBlock	jsr  GetSuperCachedPtr	ldy  #SuperHandle.cachedIndex	lda  [SuperRecordPtr],y	tay	jsr  addLength	jsr  AddLengthToBlock;---------------------------------------------------------------allDone	addl TextOffset,NewSuperLength,TextOffset	;carry is always	rts			;..clear at the end;---------------------------------------------------------------;---------------------------------------------------------------addLength	lda  [TempPtr],y	clc	adc  SuperLength	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	adc  SuperLength+2	sta  [TempPtr],y	rts;---------------------------------------------------------------	ENDP****************************************************************RemoveSuperSelection PROCNAME  Export;---------------------------------------------------------------          IF SuperItemSize <> 8 THEN              AERROR 'WARNING... This routine relies on the SuperItemSize equate being eight'          ENDIF;---------------------------------------------------------------;---------------------------------------------------------------	phy		;save the index into the TERecord	jsr  IsTheSelectionACaret	;if there is a selection, then we need	bne  doIt		;..to do something	ply		;cleanup the stack	rts;---------------------------------------------------------------doIt	jsr  GetSelectionLength	;this sets TextOffset to SelectionStart	ply		;get back the index into the TERecord and	jsr  FindSuperInfo		;..find the correct super info	jsr  GetSuperMaxIndex	ldy  #SuperHandle.cachedIndex	;get the current index for the selection	lda  [SuperRecordPtr],y	;..start into Y-Reg	inc  a		;start with the high word	inc  a	tay	lda  TextOffset		;check to see if we are starting on the	cmp  SuperStart		;..first item	bne  @notAtStart	lda  TextOffset+2	cmp  SuperStart+2	beq  itemLoop@notAtStart	sty  TempWord	jsr  GetLongSuperCount	stax SuperLength	jsr  adjustSelection	bccl lastItem	jsr  subtractFromItem	bra  itemLoopEnd;---------------------------------------------------------------ItemLoop	sty  TempWord	lda  [TempPtr],y	bmi  itemLoopEnd	dey	dey	jsr  adjustFromTempPtr	bccl lastItem	jsr  SubLengthFromBlock	ldy  TempWord	lda  #$FFFF		;mark this item as deleted	sta  [TempPtr],y	dey	dey	sta  [TempPtr],yitemLoopEnd	lda  TempWord	clc	adc  #SuperItemSize	tay	cpy  SuperMaxIndex	blt  ItemLoop;---------------------------------------------------------------	jsr  MoveToNextHandle	bcs  atEnd2blockLoop	movl TheSuperHandle,TempLong	;save the original super handle in TempLon	ldy  #SuperBlock.textLength	jsr  adjustFromTempPtr	;if we cannot remove this block wholesale	bcc  @backToItems		;..then go back to items	ldy  #SuperBlock.prevHandle+2	;save the previous handle on the stack	lda  [TempPtr],y	pha	dey	dey	lda  [TempPtr],y	pha	jsr  MoveToNextHandle	;move on to the next handle	bcs  atEnd1	ldax TempLong		;dispose of the original super handle	jsr  KillHandle	pla		;get back the original handle's previous	sta  TempLong		;..handle into TempLong	pla	sta  TempLong+2	ldy  #SuperBlock.prevHandle	;fix the previous handle field of the	lda  TempLong		;..new current handle	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y	Deref TempLong,TempPtr	;deref the previous handle	ldy  #SuperBlock.nextHandle	;fix the next handle field of the	lda  TheSuperHandle		;..previous handle	sta  [TempPtr],y	iny	iny	lda  TheSuperHandle+2	sta  [TempPtr],y	jsr  SuperHandleToPtr	;make TempPtr point to the current block	bra  blockLoop		;..again@backToItems	ldy  #SuperBlock.RecordSize+2	brl  ItemLoop;---------------------------------------------------------------atEnd1	pla		;get back the previous handle	sta  TheSuperHandle	pla	sta  TheSuperHandle+2	ldax TempLong		;kill the last handle	jsr  KillHandle	jsr  SuperHandleToPtr	;dereference the second to last handle	ldy  #SuperBlock.nextHandle	;clear it's next handle field to indicate	lda  #0		;..that it is the end of the list	sta  [TempPtr],y	iny	iny	sta  [TempPtr],yatEnd2	jsr  MoveToFirstSuperHandle	ldy  #SuperBlock.RecordSize+2	lda  [TempPtr],y	bpl  allDone	lda  #0	sta  [TempPtr],y	dey	dey	sta  [TempPtr],y	bra  allDone;---------------------------------------------------------------lastItem	movl SelectionLength,SuperLengthsubtractFromItem	jsr  SubLengthFromBlock	ldy  TempWord	dey	dey	lda  [TempPtr],y	sec	sbc  SuperLength	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	sbc  SuperLength+2	sta  [TempPtr],y;---------------------------------------------------------------allDone	jsr  GetSuperCachedPtr	ldy  #SuperHandle.cachedTextOffset	lda  [SuperRecordPtr],y	sta  SuperStart	iny	iny	lda  [SuperRecordPtr],y	sta  SuperStart+2	ldy  #SuperHandle.cachedIndex	;get the current index for the selection	lda  [SuperRecordPtr],y	;..start into Y-Reg	inc  a		;start with the high word	inc  a	tay	lda  [TempPtr],y	bpl  exit@loop1	cpy  #SuperBlock.RecordSize+2	bne  @notPrevBlock	jsr  MoveToPrevHandle	bcs  @atTheEnd	ldy  SuperMaxIndex@notPrevBlock	tya	sec	sbc  #SuperItemSize	tay	lda  [TempPtr],y	bmi  @loop1	dey	dey	lda  SuperStart	sec	sbc  [TempPtr],y	sta  SuperStart	iny	iny	lda  SuperStart+2	sbc  [TempPtr],y	sta  SuperStart+2	bra  exit@atTheEnd	stzl SuperStart@outerLoop	ldy  #SuperBlock.RecordSize+2@firstLoop	lda  [TempPtr],y	bpl  @foundFirst	tya	clc	adc  #SuperItemSize	tay	cpy  SuperMaxIndex	blt  @firstLoop	jsr  MoveToNextHandle	bra  @outerLoop@foundFirst	phy	jsr  SetSuperCachedHandle	ply;---------------------------------------------------------------exit	dey	dey	tya	ldy  #SuperHandle.cachedIndex	sta  [SuperRecordPtr],y	ldy  #SuperHandle.cachedTextOffset	lda  SuperStart	sta  [SuperRecordPtr],y	iny	iny	lda  SuperStart+2	sta  [SuperRecordPtr],y	brl  SetSuperCachedHandle;---------------------------------------------------------------;---------------------------------------------------------------adjustFromTempPtr	lda  [TempPtr],y	sta  SuperLength	iny	iny	lda  [TempPtr],y	sta  SuperLength+2adjustSelection	ldax SelectionLength	cpx  SuperLength+2	blt  @done	bne  @adjustIt	cmp  SuperLength	blt  @done@adjustIt	sec	sbc  SuperLength	sta  SelectionLength	txa	sbc  SuperLength+2	sta  SelectionLength+2	;carry remains set if we are continuing@done	rts		;carry is clear if we are done;---------------------------------------------------------------	ENDP****************************************************************CountSuperItems	PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperRecordPtr	jsr  MoveToFirstSuperHandle	jsr  GetSuperMaxIndex	stzl TempLong	clc		;clear the carry for the ENTIRE loop@loop1	ldy  #SuperBlock.RecordSize+2@loop2	lda  [TempPtr],y	bmi  @skip	inc  TempLong	bne  @skip	inc  TempLong+2@skip	tya		;move to the next item.	adc  #SuperItemSize		;the carry is alreay clear here	tay	cpy  SuperMaxIndex	blt  @loop2	jsr  MoveToNextHandle	bcc  @loop1	ldax TempLong	rts;---------------------------------------------------------------	ENDP****************************************************************CalculateSuperSize	PROCNAME  Export;---------------------------------------------------------------	jsr  GetSuperRecordPtr	;setup the pointers to access the cached	jsr  MoveToFirstSuperHandle	stzl TempLong@loop2	PushZLong TheSuperHandle	jsr  GetHandleSize	clc	adc  TempLong	sta  TempLong	txa	adc  TempLong+2	sta  TempLong+2	jsr  MoveToNextHandle	bcc  @loop2@done	ldax TempLong	rts;---------------------------------------------------------------	ENDP****************************************************************ClearSuperCache	PROCNAME  Export	jsr  GetSuperRecordPtr	ldy  #SuperHandle.cachedIndex	lda  #SuperBlock.RecordSize	sta  [SuperRecordPtr],y	ldy  #SuperHandle.cachedTextOffset	lda  #0	sta  [SuperRecordPtr],y	iny	iny	sta  [SuperRecordPtr],y	jsr  MoveToFirstSuperHandle	brl  SetSuperCachedHandle	ENDP********************************************************************************************************************************************************************************************************************************************************************************************************************************GetSuperRecordPtr	PROCNAME  Export	tya		;get pointer into the control record where	clc		;..we want the super handle to be stored.	adc  RecordPtr	sta  SuperRecordPtr	lda  RecordPtr+2	adc  #0	sta  SuperRecordPtr+2	rts	ENDP****************************************************************InsertSuperHandle	PROCNAME  Entry;---------------------------------------------------------------	lda  #SizeOfLargeBlock	;get a large super block and save the	jsr  GetHandleFromSuper	;..handle on the stack	bcs  exit	PushAX	jsr  DerefAX		;get a pointer for this new handle	stax MemoryPtr	ldy  #SuperBlock.prevHandle	;set the prevHandle field in the new super	lda  TheSuperHandle		;..handle to the current SuperHandle	sta  [MemoryPtr],y	iny	iny	lda  TheSuperHandle+2	sta  [MemoryPtr],y	jsr  SuperHandleToPtr	;re-dereference the super handle	ldy  #SuperBlock.nextHandle	;set the nextHandle field of the newly	lda  [TempPtr],y		;..allocated super handle to whatever	sta  [MemoryPtr],y		;..was in this same field in the current	pla		;..super handle. At the same time set the	sta  TheSuperHandle		;..nextHandle field of the current super	sta  [TempPtr],y		;..handle to the newly allocated handle.	iny		;Finally set the current handle to the	iny		;..newly allocated handlle.	lda  [TempPtr],y	sta  [MemoryPtr],y	pla	sta  TheSuperHandle+2	sta  [TempPtr],y	jsr  SetSuperCachedHandle	;set the cached handle to our new handle	jsr  ClearSuperCachedHandle	;clear the newly allocated handle	ldy  #SuperBlock.nextHandle+1	;is there another handle after the new one	lda  [TempPtr],y	beq  atEdge		;nope, then exit	iny	lda  [TempPtr],y		;get a pointer from the next handle.	tax	dey	dey	lda  [TempPtr],y	jsr  DerefAX	stax MemoryPtr	ldy  #SuperBlock.prevHandle	;set this super block's prevHandle field	lda  TheSuperHandle		;..to the newly allocated handle	sta  [MemoryPtr],y	iny	iny	lda  TheSuperHandle+2	sta  [MemoryPtr],yatEdge	clc;---------------------------------------------------------------exit	rts;---------------------------------------------------------------	ENDP****************************************************************Super5Proc	PROC;---------------------------------------------------------------	EXPORT GetSuperCachedPtr	EXPORT MoveToNextHandle	EXPORT MoveToPrevHandle	EXPORT SuperHandleToPtr;---------------------------------------------------------------;---------------------------------------------------------------GetSuperCachedPtr          IF SuperHandle.cachedHandle = 0 THEN	ldy  #2	lda  [SuperRecordPtr],y	sta  TheSuperHandle+2	lda  [SuperRecordPtr]	sta  TheSuperHandle	bra  quickDeref          ELSE	ldy  #SuperHandle.cachedHandle+2	lda  [SuperRecordPtr],y	sta  TheSuperHandle+2	dey	dey	lda  [SuperRecordPtr],y          ENDIF	bra  storeLow;---------------------------------------------------------------MoveToNextHandle	ldy  #SuperBlock.nextHandle+1	bra  checkHandle;---------------------------------------------------------------MoveToPrevHandle	ldy  #SuperBlock.prevHandle+1;---------------------------------------------------------------checkHandle	lda  [TempPtr],y	beq  atEdge	iny	clc		;the carry must stay clear through all	lda  [TempPtr],y		;..the following  code	sta  TheSuperHandle+2	dey	dey	lda  [TempPtr],ystoreLow	sta  TheSuperHandle;---------------------------------------------------------------SuperHandleToPtr	ldy  #2quickDeref	lda  [TheSuperHandle]	sta  TempPtr	lda  [TheSuperHandle],y	sta  TempPtr+2	rts;---------------------------------------------------------------atEdge	sec	rts;---------------------------------------------------------------	ENDP****************************************************************MoveToFirstSuperHandle PROCNAME  Export	jsr  GetSuperCachedPtr@loop	jsr  MoveToPrevHandle	bcc  @loop	rts	ENDP****************************************************************SetSuperCachedHandle PROCNAME  Entry	ldy  #SuperHandle.cachedHandle+2	lda  TheSuperHandle+2	sta  [SuperRecordPtr],y          IF SuperHandle.cachedHandle = 0 THEN	lda  TheSuperHandle	sta  [SuperRecordPtr]          ELSE	dey	dey	lda  TheSuperHandle	sta  [SuperRecordPtr],y          ENDIF	rts	ENDP****************************************************************GetSuperMaxIndex	PROCNAME  Export;---------------------------------------------------------------          IF SuperItemSize <> 8 THEN              AERROR 'WARNING... This routine relies on the SuperItemSize equate being eight'          ENDIF;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #SuperHandle.itemsPerBlock	lda  [SuperRecordPtr],y	asl  a	asl  a	inc  a		;this adds two	asl  a	adc  #SuperBlock.RecordSize	;carry is already clear	sta  SuperMaxIndex	rts;---------------------------------------------------------------	ENDP****************************************************************SubLengthFromBlock	PROCNAME  Export	ldy  #SuperBlock.textLength	lda  [TempPtr],y	sec	sbc  SuperLength	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	sbc  SuperLength+2	sta  [TempPtr],y	rts	ENDP****************************************************************AddLengthToBlock	PROCNAME  Export	ldy  #SuperBlock.textLength	lda  [TempPtr],y	clc	adc  SuperLength	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y	adc  SuperLength+2	sta  [TempPtr],y	rts	ENDP****************************************************************CompactSuperHandle	PROCNAME  Export;---------------------------------------------------------------	DSECT WorkAreasourceHandle	longdestHandle	longsourceCount	worddestCount	word;---------------------------------------------------------------;---------------------------------------------------------------	lda  RecordInUse	cmp  RecordHandle	bne  doIt	lda  RecordInUse+2	cmp  RecordHandle+2	bne  doIt	cpy  SuperInUse	bne  doIt	rts;---------------------------------------------------------------doIt	PushZLong WorkArea		;save the variables we are going to use	PushZLong WorkArea+4	PushZLong WorkArea+8	PushZLong SuperRecordPtr	;save all the local variables also	PushZLong TheSuperHandle	PushZLong TempPtr	PushZLong TempLong	PushZLong SourcePtr	PushZLong DestPtr	jsr  ClearSuperCache	;this moves to the first handle and clears	ldax TheSuperHandle		;..the cache	stax sourceHandle		;copy the super handle into both source	stax destHandle		;..and dest handles	ldax TempPtr		;make both the source and the dest pointers	clc		;..point to the beginning of the handle	adc  #SuperBlock.RecordSize	bcc  @1	inx@1	stax SourcePtr	stax DestPtr	ldy  #SuperHandle.itemsPerBlock	;set both the source and dest count fields	lda  [SuperRecordPtr],y	;..to the number of items in the block	sta  sourceCount	sta  destCount	stzl TempLong		;this is the total length of the new block;---------------------------------------------------------------mainLoop	ldy  #2	lda  [SourcePtr],y		;copy the high word of the length	bmi  @skipDest	sta  [DestPtr],y	tax	lda  [SourcePtr]		;copy the low word of the length	sta  [DestPtr]	clc		;update the total length of the new block	adc  TempLong	sta  TempLong	txa	adc  TempLong+2	sta  TempLong+2	iny	iny	lda  [SourcePtr],y		;copy the low word of the data	sta  [DestPtr],y	iny	iny	lda  [SourcePtr],y		;copy the high word of the data	sta  [DestPtr],y	jsr  AddEightToDestPtr	dec  destCount	bne  @skipDest	movl destHandle,TheSuperHandle	jsr  SuperHandleToPtr	ldy  #SuperBlock.textLength	;set the length field in the old block	lda  TempLong	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y	stzl TempLong		;clear TempLong for the next block	jsr  MoveToNextHandle	bcsl allDone	movl TheSuperHandle,destHandle	ldy  #SuperHandle.itemsPerBlock	lda  [SuperRecordPtr],y	sta  destCount	ldy  #2	lda  [destHandle]	clc	adc  #SuperBlock.RecordSize	sta  DestPtr	lda  [destHandle],y	adc  #0	sta  DestPtr+2@skipDest	jsr  AddEightToSourcePtr	dec  sourceCount	bne  mainLoop	movl sourceHandle,TheSuperHandle	jsr  SuperHandleToPtr	jsr  MoveToNextHandle	bcs  lastLoop	movl TheSuperHandle,sourceHandle	ldy  #SuperHandle.itemsPerBlock	lda  [SuperRecordPtr],y	sta  sourceCount	ldy  #2	lda  [sourceHandle]	clc	adc  #SuperBlock.RecordSize	sta  SourcePtr	lda  [sourceHandle],y	adc  #0	sta  SourcePtr+2	brl  mainLoop;---------------------------------------------------------------lastLoop	ldy  #2		;clear the remaining items in the last	lda  #$FFFF		;..block	sta  [DestPtr]	sta  [DestPtr],y	jsr  AddEightToDestPtr	dec  destCount	bne  lastLoop;---------------------------------------------------------------	movl destHandle,TheSuperHandle	jsr  SuperHandleToPtr	ldy  #SuperBlock.textLength	;set the length field in the old block	lda  TempLong	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y	movl TempPtr,DestPtr	;save the original block pointer	jsr  MoveToNextHandle	;is there another block ? If not, then	bcs  allDone		;..allDone	ldy  #SuperBlock.nextHandle	;there was another block, so set the next	lda  #0		;..handle field of the last dest handle	sta  [DestPtr],y		;..to NULL to terminate the super list	iny		;..there	iny	sta  [DestPtr],y@loop	PushZLong TheSuperHandle	;kill all the remaining handles	jsr  MoveToNextHandle	PullAX	php	jsr  KillHandle	plp	bcc  @loop;---------------------------------------------------------------allDone	jsr  GetSuperCachedPtr	;get a pointer to the first block	ldy  #SuperBlock.nextHandle+1	;if there is another handle, then exit	lda  [TempPtr],y	bne  exit	ldy  #SuperHandle.itemsPerBlock	;if the block is already small, then exit	lda  [SuperRecordPtr],y	cmp  #ItemsInSmallBlock	beq  exit	ldx  #ItemsInMediumBlock+1	clc	ldy  #SuperBlock.RecordSize+2@loop	lda  [TempPtr],y	bmi  @foundTheEnd	tya	adc  #SuperItemSize		;the carry is always clear here	tay	dex	bne  @loop	bra  exit@foundTheEnd	cpx  #ItemsInMediumBlock-ItemsInSmallBlock+1	bge  @makeItSmall@makeItMedium	lda  #ItemsInMediumBlock	bra  @sizeIt@makeItSmall	lda  #ItemsInSmallBlock@sizeIt	PushZLong TheSuperHandle	ldy  #SuperHandle.itemsPerBlock	sta  [SuperRecordPtr],y	asl  a	asl  a	asl  a	adc  #SuperBlock.RecordSize	;carry is already clear	ldx  #0		;we are getting smaller, so don't check	jsr  SetHandleSize		;..for errors;---------------------------------------------------------------exit	PullLong DestPtr		;restore all the local variables	PullLong SourcePtr	PullLong TempLong	PullLong TempPtr	PullLong TheSuperHandle	PullLong SuperRecordPtr	PullLong WorkArea+8		;restore the work area	PullLong WorkArea+4	PullLong WorkArea	rts;---------------------------------------------------------------	ENDP****************************************************************MoveOffsetToNextItem PROCNAME  Export	addl SuperStart,SuperLength,TextOffset	rts	ENDP****************************************************************GetSuperCount	PROCNAME  Export	lda  SuperLength+2	bne  slow	lda  SuperStart	clc	adc  SuperLength	sec	sbc  TextOffset	rtsslow	jsr  GetLongSuperCount	cpx  #0	bne  tooLarge	sec	rtstooLarge	lda  #$FFFF	clc	rts	ENDP****************************************************************GetLongSuperCount	PROCNAME  Export	lda  SuperStart	clc	adc  SuperLength	tax	lda  SuperStart+2	adc  SuperLength+2	tay	txa	sec	sbc  TextOffset	pha	tya	sbc  TextOffset+2	tax	pla	rts	ENDP****************************************************************GetHandleFromSuper	PROCNAME  Entry	tax		;save the size of the handle to create	lda  SuperRecordPtr		;mark this super array as in use	sec	sbc  RecordPtr	sta  SuperInUse	txa		;get back the size of the handle	jsr  GetSmallHandle	stz  SuperInUse	rts	ENDP****************************************************************	END