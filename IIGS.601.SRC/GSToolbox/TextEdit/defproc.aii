************************************************************************                      GSTextEdit  Version 1.0*                         File: defproc.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.************************************************************************* Change History** 30 May 89	Dave Good** Cleaned up comments for final release.** 2/28/90	Mensch** Fixe a bug in the Init routine that caused the sub-controls (grow box and scroll bar)* to be created as visible even if the TEControl was created invisible. This should* fix that right up!** 8-Dec-91	Dave Lyons** When NewVertScrollBar creates a scroll bar that reaches the top of the window, the* top is now -1 instead of 0, so it's visually flush.  (The Scroll Bar bug that made* this undesirable is now finally fixed.)************************************************************************* Begin 6.0.1** 15-Oct-92	Dave Lyons for 6.0.1d12** MakeTarget now activates non-target controls if they can never be the target,* instead of activating if-and-only-if it's the target.***********************************************************************	INCLUDE  'GlobalIncludes'	INCLUDE  'E16.Font'****************************************************************TEDefProc	PROCNAME  Export;---------------------------------------------------------------	DefineStackOrigOrigin	longOrigPort	longOrigB	byteOrigD	wordRTL	block 3theCtrlHandle	longctrlParam	longctrlMessage	wordresult	long;---------------------------------------------------------------;---------------------------------------------------------------	DefineStackRTL_Size	block 3theCtrlHandle_Size	longctrlParam_Size	longctrlMessage_Size	wordresult_Size	long;---------------------------------------------------------------;---------------------------------------------------------------	lda  ctrlMessage_Size,s	;the entry code takes Å 875 microseconds	cmp  #19+1		;if the message is too large, then just	bge  quick_exit		;..cleanup the stack and exit	cmp  #12		;precheck for the record size message	bne  notRecordSizedo_recordSize	lda  #TERecord.RecordSize	;return the record size using the special	sta  result_Size,s		;..stack fram	lda  #0	sta  result_Size+2,squick_exit	lda  RTL_Size+1,s		;move the return address down	sta  result_Size-2,s	lda  RTL_Size,s	sta  result_Size-3,s	bra  exit		;cleanup the stack and exit;---------------------------------------------------------------notRecordSize	phd		;save the direct page and the data bank	phb	phk		;set the data bank to the PC	plb	jsr  GetDirectPage		;switch to TextEdit's direct page	tcd	lda  theCtrlHandle-8,s	;setup the record handle. Our stack equates	sta  RecordHandle		;..are not correct, because we haven't	lda  theCtrlHandle-6,s	;..pushed the port yet	sta  RecordHandle+2	jsr  LockRecordHandle	lda  ctrlMessage_Size+3,s	;check for the init message	cmp  #3	bne  @skipTextFlags	lda  ctrlParam_Size+3,s	;make sure the parameter pointer is set	sta  ParameterPtr		;..correctly.	lda  ctrlParam_Size+5,s	sta  ParameterPtr+2	ldy  #TEParam.textFlags+2	;copy the high word of the flags parameter	lda  [ParameterPtr],y	ldy  #TERecord.TextFlags+2	sta  [RecordPtr],y@skipTextFlags	jsr  SetupWindowPort	;save the origin and the port	lda  ctrlParam,s		;pass the parameters in ParameterPtr	sta  ParameterPtr		;NOTE: do this AFTER my direct page has	lda  ctrlParam+2,s		;..been set	sta  ParameterPtr+2	lda  ctrlMessage,s		;dispatch to the right routine;---------------------------------------------------------------dispatch	asl  a	tax	jsr  (MessageTable,x);---------------------------------------------------------------	sta  result,s		;the exit code takes Å 359 microseconds	txa		;return the result	sta  result+2,s	lda  RTL+1,s		;move the return address down	sta  result-2,s	lda  RTL,s	sta  result-3,s	jsr  RestoreOriginalPort	;restore the original port and origin	jsr  UnlockRecordHandle	;unlock the record handle	plb		;restore the original bank	pld		;..and direct pageexit	tsc		;adjust the stack	clc	adc  #10	tcs	rtl		;..and return.;---------------------------------------------------------------;---------------------------------------------------------------return_FFFF	lda  #$FFFF	tax	rts;---------------------------------------------------------------return_0000	lda  #$0000	tax	rts;---------------------------------------------------------------;---------------------------------------------------------------MessageTable	dc.w  do_draw		;0	dc.w  return_0000		;1	dc.w  do_test		;2	dc.w  do_init		;3	dc.w  do_dispose		;4	dc.w  return_FFFF		;5	dc.w  return_FFFF		;6	dc.w  do_track		;7	dc.w  return_0000		;8	dc.w  return_0000		;9	dc.w  return_0000		;10	dc.w  do_move		;11	dc.w  return_0000		;12	dc.w  do_event		;13	dc.w  do_target		;14	dc.w  do_changeBounds	;15	dc.w  do_growwindow		;16	dc.w  do_handletab		;17	dc.w  do_multiPart		;18	dc.w  do_activate		;19;---------------------------------------------------------------	ENDP****************************************************************do_init	PROC;---------------------------------------------------------------	ldx  #teInvalidPCount	lda  [ParameterPtr]		;this is always the count field	cmp  #7		;these are the values that are invalid	blt  errorExit		;..for the count field	cmp  #23+1	bge  errorExit	cmp  #14	beq  errorExit	cmp  #15	beq  errorExit	lda  #4*1024		;make sure there is at least 4K free. If	jsr  GetSmallHandle		;..there is, we don't need to check for	bcc  enoughMemory		;..any memory errors after this;---------------------------------------------------------------errorExit	jsr  SetLastErrorCode	;this notifies the filter proc that			;..TextEdit is out of memory	lda  #0	tax	rts;---------------------------------------------------------------enoughMemory	jsr  KillHandle		;kill the 4K handle to leave space	stzl TextOffset	stzl TextStyleOffset	lda  #$FFFF	tax	ldy  #TERecord.CtrlAction	;set the track routine to -1	jsr  SetRecordLong	ldy  #TERecord.MaximumChars	;set the max chars field to $FFFF FFFF	jsr  SetRecordLong	ldy  #TERecord.MaximumLines	;set the max lines field to $FFFF FFFF	jsr  SetRecordLong	jsr  ClearOffsetCache	;mark the offset cache as empty	lda  #DefaultVertScrollAmount	;set the default vertical scroll amount	ldy  #TERecord.VertScrollAmount	sta  [RecordPtr],y	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	ora  #$7400		;fCtlCanBeTarget, fCtlWantEvents, fCtlProcRefNotPtr, fCtlIsMultiPart	and  #$7FFF		;bit 15 must be clear	sta  [RecordPtr],y	ldy  #TEParam.textFlags	;copy the flags parameters	jsr  GetParamLong	ldy  #TERecord.TextFlags	jsr  SetRecordLong	txa		;the high word of the flags is still in	and  #fDisableSelection	;..X-Reg. Should we be selecting text ?	beq  @1	ldy  #TERecord.CtrlMoreFlags	;if not, then clear the fCtlCanBeTarget	lda  [RecordPtr],y		;..and the fCtlWantEvents bits in the	and  #$9FFF		;..more flags field	sta  [RecordPtr],y@1;---------------------------------------------------------------allocateHandles	ldy  #TERecord.LineSuper	;get the line starts super-array	jsr  GetNewSuperHandle	ldy  #TERecord.StyleSuper	;get the style runs super-array	jsr  GetNewSuperHandle	jsr  NewBlockList		;get a new block list	lda  #1		;get a handle of the one byte to start	jsr  GetSmallHandle		;..with	ldy  #TERecord.theKeyRecord.theInputHandle	jsr  SetRecordLong;---------------------------------------------------------------setBoundsRect	ldy  #TERecord.CtrlMoreFlags	;check to see if the record has a grow box	lda  [RecordPtr],y	and  #FCtlTellAboutSize	pha		;save this information on the stack	beq  @noGrowBox	jsr  NewGrowBox@noGrowBox	jsr  GetWindowPortPtr	ldy  #TERecord.BoundsRect	;get the bounds rect into TempRect	jsr  CopyIntoTempRect	pla		;get back whether the record has a grow	bne  @useWindowEdge		;..box. If so, use the portRect	lda  TempRect.bottom	bne  @continue	lda  TempRect.right	bne  @continue@useWindowEdge	ldy  #GrafPort.portRect.bottom	lda  [TempPtr],y	inc  a	ldy  #TERecord.BoundsRect.bottom	sta  [RecordPtr],y	ldy  #GrafPort.portRect.right	lda  [TempPtr],y	inc  a	ldy  #TERecord.BoundsRect.right	sta  [RecordPtr],y@continue;---------------------------------------------------------------copyIndentRect	ldy  #TERecord.BoundsRect	;get the bounds rect into TempRect	jsr  CopyIntoTempRect	lda  [ParameterPtr]	cmp  #8	blt  @useDefaults	ldy  #TEParam.indentRect.left	lda  [ParameterPtr],y	cmp  #$FFFF	bne  @1	lda  #IndentLeftDefault@1	clc	adc  TempRect.left	sta  TempRect.left	ldy  #TEParam.indentRect.right	lda  [ParameterPtr],y	cmp  #$FFFF	bne  @2	lda  #IndentRightDefault@2	eor  #$FFFF	sec	adc  TempRect.right	sta  TempRect.right	ldy  #TEParam.indentRect.top	lda  [ParameterPtr],y	cmp  #$FFFF	bne  @3	lda  #IndentTopDefault@3	clc	adc  TempRect.top	sta  TempRect.top	ldy  #TEParam.indentRect.bottom	lda  [ParameterPtr],y	cmp  #$FFFF	bne  @4	lda  #IndentBottomDefault@4	eor  #$FFFF	sec	adc  TempRect.bottom	sta  TempRect.bottom	bra  @setView		;then set the view rectangle@useDefaults	lda  #IndentTopDefault	;use the default indent values	clc	adc  TempRect.top	sta  TempRect.top	lda  #IndentLeftDefault	clc	adc  TempRect.left	sta  TempRect.left	lda  #ÅIndentBottomDefault+1	clc	adc  TempRect.bottom	sta  TempRect.bottom	lda  #ÅIndentRightDefault+1	clc	adc  TempRect.right	sta  TempRect.right@setView	ldy  #TERecord.ViewRect	;set the text rectangle	jsr  CopyFromTempRect;---------------------------------------------------------------copyScrollBars	lda  [ParameterPtr]	cmp  #9	blt  @useDefault1	ldy  #TEParam.vertBar	jsr  GetParamLong	jsr  NewVertScrollBar@useDefault1	lda  [ParameterPtr]	cmp  #10	blt  @useDefault2	ldy  #TEParam.vertAmount	lda  [ParameterPtr],y	beq  @useDefault2	ldy  #TERecord.VertScrollAmount	sta  [RecordPtr],y@useDefault2;---------------------------------------------------------------copyInitialStyle	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	and  #refIsMask	sta  InputStyleVerb	lda  [ParameterPtr]	cmp  #13	blt  @useDefaults	ldy  #TEParam.styleRef	jsr  GetParamLong	stax InputStyleRef	ora  InputStyleRef+2	;if the styleRef is zero, use defaults	beq  @useDefaults@useParamBlock	jsr  GetTerminatedHandle	;get a four byte terminated handle	ldy  #TERecord.StyleList	;put the handle in the TE record	jsr  SetRecordLong	jsr  GetTerminatedHandle	;get the ruler list offset table.	ldy  #TERecord.RulerList	;put the handle in the TE record	jsr  SetRecordLong	brl  @continue@useDefaults	; 12/20/89 Mensch; Fix bug where style info would be bogus if it was not passed;	stz  InputStyleVerb	stzL InputStyleRef		; zero the initial style ref cause of Bug		jsr  GetWindowPortPtr	stax MemoryPtr	lda  #TEStyle.RecordSize+4	;get a new clear handle of the proper size	jsr  GetClearHandle	stax TempPtr	ldy  #TERecord.StyleList	;put the handle in the TE record	jsr  SetRecordLong	jsr  DerefTempPtr	ldy  #GrafPort.FontID	;copy the fontID into the TEStyle	lda  [MemoryPtr],y	ldy  #TEStyle.fontID	sta  [TempPtr],y	dec  a		;force an install font	ldy  #GrafPort.FontID	sta  [DrawPortPtr],y	ldy  #GrafPort.FontID+2	lda  [MemoryPtr],y	ldy  #TEStyle.fontID+2	sta  [TempPtr],y	ldy  #GrafPort.FGColor	lda  [MemoryPtr],y	ldy  #TEStyle.foreColor	sta  [TempPtr],y	ldy  #GrafPort.BGColor	lda  [MemoryPtr],y	ldy  #TEStyle.backColor	sta  [TempPtr],y	ldy  #TEStyle.RecordSize	jsr  TerminateTempPtr	jsr  GetPort		;save the current port on the stack	jsr  SetDrawPort		;switch to the offscreen drawing port	jsr  InstallFontAndColor	;install the new font and correct the	jsr  ReleaseFont		;..style list. Then release the font	jsr  SetPort		;restore the original port	lda  #TERuler.RecordSize+4	;get a ruler that has default tabs and	jsr  GetClearHandle		;..four more bytes for the terminator	stax TempPtr	ldy  #TERecord.RulerList	;put the handle in the TE record	jsr  SetRecordLong	jsr  DerefTempPtr	ldy  #TERuler.tabType	lda  #DefaultTabType	sta  [TempPtr],y	ldy  #TERuler.numberOfTabs	lda  #DefaultTabValue	sta  [TempPtr],y	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	sec	ldy  #TERecord.ViewRect.left	sbc  [RecordPtr],y	ldy  #TERuler.rightMargin	sta  [TempPtr],y	ldy  #TERuler.RecordSize	jsr  TerminateTempPtr@continue;---------------------------------------------------------------copyInitialText	lda  [ParameterPtr]	cmp  #16	blt  @useDefaults	ldy  #TEParam.textVerb	lda  [ParameterPtr],y	sta  InputTextVerb	ldy  #TEParam.textRef	jsr  GetParamLong	stax InputTextRef	ldy  #TEParam.textLength	jsr  GetParamLong	stax InputTextLength	bra  @continue@useDefaults	stz  InputTextVerb	stzl InputTextRef	stzl InputTextLength@continue;---------------------------------------------------------------copyMaxFields	lda  [ParameterPtr]	cmp  #17	blt  @useDefault1	ldy  #TEParam.maxChars	;copy the max chars field. If it is zero	jsr  GetParamLong		;..then use $FFFF FFFF	stx  TempWord	tsb  TempWord	ldy  TempWord	beq  @useDefault1	ldy  #TERecord.MaximumChars	jsr  SetRecordLong@useDefault1	lda  [ParameterPtr]	cmp  #18	blt  @useDefault2	ldy  #TEParam.maxLines	;copy the max lines field. If it is zero	jsr  GetParamLong		;..then use $FFFF FFFF	stx  TempWord	tsb  TempWord	ldy  TempWord	beq  @useDefault2	ldy  #TERecord.MaximumLines	jsr  SetRecordLong@useDefault2	lda  [ParameterPtr]	cmp  #19	blt  @useDefault3	ldy  #TEParam.maxHeight	lda  [ParameterPtr],y	ldy  #TERecord.MaximumHeight	sta  [RecordPtr],y@useDefault3	lda  [ParameterPtr]	cmp  #20	blt  @useDefault4	ldy  #TEParam.maxCharsPerLine	lda  [ParameterPtr],y	ldy  #TERecord.MaximumCharsPerLine	sta  [RecordPtr],y@useDefault4;---------------------------------------------------------------copyColorRef	lda  [ParameterPtr]	cmp  #21	blt  @useDefault	ldy  #TEParam.colorRef	;copy the color table parameter	jsr  GetParamLong	ldy  #TERecord.ColorRef	jsr  SetRecordLong@useDefault;---------------------------------------------------------------copyDrawMode	lda  [ParameterPtr]	cmp  #22	blt  @useDefault	ldy  #TEParam.textDrawMode	;copy the draw mode parameter	lda  [ParameterPtr],y	ldy  #TERecord.TextDrawMode	sta  [RecordPtr],y@useDefault;---------------------------------------------------------------copyFilterProc	lda  [ParameterPtr]	cmp  #23	blt  @useDefault	ldy  #TEParam.filterProc	;copy the filter proc parameter	jsr  GetParamLong	ldy  #TERecord.FilterProc	jsr  SetRecordLong@useDefault;---------------------------------------------------------------	jsr  SetInitialTextAndStyle	;this will set the LastErrorCode field if	bcc  @makeItActive		;..there is an error. If there is an error 	jsr  do_dispose		;..then, kill all the fields that we	bra  @exit		;..allocated@makeItActive	jsr  MakeControlActive@exit	lda  #0	tax	rts;---------------------------------------------------------------	ENDP****************************************************************do_dispose	PROC;---------------------------------------------------------------	ldy  #TERecord.LineSuper	jsr  KillSuperHandle	ldy  #TERecord.StyleSuper	jsr  KillSuperHandle	jsr  KillBlockList	ldy  #TERecord.StyleList	jsr  checkAndKill	ldy  #TERecord.RulerList	jsr  checkAndKill	jsr  GetVertScrollBar	jsr  KillControl	jsr  GetGrowBoxHandle	jsr  KillControl	ldy  #TERecord.theKeyRecord.theInputHandle	jsr  checkAndKill	jsr  KillHandle	lda  #0	tax	rts;---------------------------------------------------------------checkAndKill	phy	jsr  GetRecordLong	inc  a	dec  a	bne  @kill	inx	dex	beq  @skip@kill	jsr  KillHandle@skip	ply	lda  #0	tax	brl  SetRecordLong;---------------------------------------------------------------	ENDP****************************************************************do_draw	PROC;---------------------------------------------------------------	jsr  AreWeInvisible	bne  allDone;---------------------------------------------------------------	jsr  GetTEHighFlags	and  #fDrawBounds	beq  skipRect	jsr  SetupColorPtr		;the pattern to use is the outline color	ldy  #TEColorTable.outline	;..in the color table	lda  [TempPtr],y	ldx  #$FFFF		;the mask is all $FFFF	jsr  SetupPenState	ldy  #TERecord.BoundsRect	;copy the boundary rectangle into TempRect	jsr  CopyIntoTempRect	PushZPtr TempRect		;frame it.	_FrameRect	jsr  RestorePenState;---------------------------------------------------------------skipRect	jsr  EraseFrame	jsr  GetDrawRect	lda  DrawRect.left	cmp  DrawRect.right	beq  allDone	jsr  DoDraw;---------------------------------------------------------------allDone	lda  #0		;return zero	tax	rts;---------------------------------------------------------------	ENDP****************************************************************do_test	PROC;---------------------------------------------------------------	PushWordSpace		;push space for result	PushZPtr ParameterPtr	;push pointer to the point	lda  RecordPtr	clc	adc  #TERecord.BoundsRect	tax	lda  RecordPtr+2	adc  #0	pha		;push pointer to the rect	phx	_PtInRect  	pla	beql done		;return zero if not in the entire box;---------------------------------------------------------------	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	and  #fCtlTarget	bne  @isActive	jsr  GetTEHighFlags		;check to see if we are drawing an	and  #fDrawInactiveSelc	;..inactive selection. If so, then don't	bne  @skipNoFlicker		;..change the old selection	jsr  GetVertScrollBar	;if the point is in either the scroll bar	jsr  ptInControl		;..or the grow box, then don't change the	bne  @skipNoFlicker		;..selection	jsr  GetGrowBoxHandle	jsr  ptInControl	bne  @skipNoFlicker	lda  #0		;indicate that we have a single click	ldy  #TERecord.MouseKind	sta  [RecordPtr],y	tax	ldy  #TERecord.MouseTime	;..and clear the double click time	jsr  SetRecordLong	lda  ParameterPtr		;copy the point into our variables and	sta  TextVPos		;..convert this to an offset	lda  ParameterPtr+2	sta  TextHPos	jsr  PointToOffset	jsr  SetSelectionStart	;set the selection start and end to this	jsr  SetSelectionEnd	;..offset@skipNoFlicker	PushZLong ParameterPtr	;save the point we are testing	jsr  MakeControlActive	;if the record wasn't active, then activate it	jsr  SetWindowPort		;re-set the window port in case it changed	PullLong ParameterPtr	;restore the point we are testing@isActive;---------------------------------------------------------------	jsr  GetVertScrollBar	;check to see if the point is in the	jsr  ptInControl		;..control. If it is we exit with Scroll	beq  @notInScroll		;..Bar_Part	lda  #ScrollBar_Part	bra  done@notInScroll	jsr  GetGrowBoxHandle	;check to see if the point is in the	jsr  ptInControl		;..control. If it is we exit with GrowBox	beq  @notInGrow		;.._Part	lda  #GrowBox_Part	bra  done@notInGrow	PushZPtr ParameterPtr	;convert the point to global coordinates	_LocalToGlobal	ldy  #TERecord.LastClick	lda  ParameterPtr		;this is the vertical coordinate of the point	sta  [RecordPtr],y	iny	iny	lda  ParameterPtr+2		;this is the horizontal coordinate of the point	sta  [RecordPtr],y	lda  #Text_Part		;if neither of these, we are in the text;---------------------------------------------------------------done	ldx  #0	rts;---------------------------------------------------------------;---------------------------------------------------------------ptInControl	beq  @done	jsr  DerefAX	clc	adc  #CtrlRecord.ctlRect	bcc  @1	inx@1	stax TempLong	PushWordSpace		;push space for result	PushZPtr ParameterPtr	;push pointer to the point	PushZLong TempLong	_PtInRect	pla		;if the Z-Flag is set we are not in the@done	rts		;..control, if clear we are in the ;---------------------------------------------------------------	ENDP****************************************************************do_track	PROC;---------------------------------------------------------------	lda  ParameterPtr	pha		;save the part code	bne  @checkForTrack	pla		;cleanup the stack	lda  #0		;return zero if the entire control is to	tax		;..be dragged	rts@checkForTrack	ldy  #TERecord.SelectionActive	;if the record is not active, then don't	lda  [RecordPtr],y		;..track it	bmi  @exit	plx		;get back the part code	cpx  #Text_Part	beq  doText	cpx  #ScrollBar_Part	bne  @doGrow	jsr  TakeCareOfUpdate	;make sure any update event is handled first	jsr  GetVertScrollBar	bra  @trackIt@doGrow	jsr  GetGrowBoxHandle@trackIt	beq  allDone	stax TempPtr	PushWordSpace	PushZPtr TempLong		;get the current mouse position	_GetMouse	PushZPtr TempLong	_LocalToGlobal	PushZLong TempLong		;push it for the scroll bar	PushLong #$FFFFFFFF	PushZLong TempPtr	_TrackControl@exit	pla		;discard the part code	bra  allDone;---------------------------------------------------------------doText	jsr  GetTEHighFlags		;should we be selecting text ? If not,	and  #fDisableSelection	;..then exit	bne  allDone	jsr  TakeCareOfUpdate	;make sure any update event is handled first	lda  RecordPtr		;set the event record pointer to our	clc		;..spot in the Text Edit record.	adc  #TERecord.theEvent	sta  TheEventPtr	lda  RecordPtr+2	adc  #0	sta  TheEventPtr+2	PushWordSpace	PushWord #0	PushZLong TheEventPtr	_GetNextEvent	pla		;discard the result	ldy  #TERecord.LastClick+2	;copy the last clicked point to the event	lda  [RecordPtr],y		;..where section	tax	dey	dey	lda  [RecordPtr],y	ldy  #TERecord.theEvent.where	sta  [RecordPtr],y	iny	iny	txa	sta  [RecordPtr],y	jsr  DoSelectText;---------------------------------------------------------------allDone	lda  #$FFFF	tax	rts;---------------------------------------------------------------	ENDP****************************************************************do_event	PROC;---------------------------------------------------------------	jsr  AreWeInvisible	bne  notHandled	movl ParameterPtr,TheEventPtr	ldy  #EventRecord.what	lda  [TheEventPtr],y	cmp  #nullEvt	beq  doIdle	cmp  #keyDownEvt	beq  doKey	cmp  #autoKeyEvt	beq  doKey	cmp  #wInSpecial	beq  doMenu;---------------------------------------------------------------notHandled	lda  #0		;didn't handle the event	tax	rts;---------------------------------------------------------------doMenu	ldy  #TaskRecord.taskData	lda  [TheEventPtr],y	sec	sbc  #UndoItemID	beq  notHandled	cmp  #5	bge  notHandled	asl  a	tax	jsr  (MenuTable,x)	bra  gotTheEvent;---------------------------------------------------------------doIdle	jsr  DoIdleEvent	bra  notHandled;---------------------------------------------------------------doKey	ldy  #EventRecord.message	lda  [TheEventPtr],y	and  #$00FF	cmp  #TAB	bne  @checkCommandKey	jsr  GetTEHighFlags	and  #fTabSwitch	beq  insertKey	PushZLong RecordHandle	PushLongSpace	_MakeNextCtlTarget	PullAX	ply	sty  TempLong	ply	sty  TempLong+2	cmp  TempLong	bne  @notSame	cpx  TempLong+2	beq  gotTheEvent@notSame	PushLongSpace	PushAX	PushWord #CtlHandleTab	PushLong #0	_CallCtlDefProc	pla	pla	bra  gotTheEvent*** added 20-Sep-91 DAL -- don't claim Command-key events that we won't use@checkCommandKey	tax		;keep character in X	ldy  #EventRecord.message	lda  [TheEventPtr],y	and  #$0100	beq  @goAhead	cpx  #$0008	;left arrow	beq  @goAhead	cpx  #$0015	;right arrow	beq  @goAhead	cpx  #$000A	;down arrow	beq  @goAhead	cpx  #$000B	;up arrow	beq  @goAhead	cpx  #$007F	;delete key	bnel notHandled@goAhead	txa*** end 20-Sep-91insertKey	jsr  DoKeystroke;---------------------------------------------------------------gotTheEvent	lda  #$FFFF		;handled the event	tax	rts;---------------------------------------------------------------;---------------------------------------------------------------MenuTable	dc.w  notHandled		;0	dc.w  CutGuts		;1	dc.w  CopyGuts		;2	dc.w  PasteGuts		;3	dc.w  ClearGuts		;4;---------------------------------------------------------------	ENDP****************************************************************do_move	PROC;---------------------------------------------------------------	DSECT ParameterPtrvertChange	wordhorzChange	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #TERecord.ViewRect.top	lda  [RecordPtr],y	clc	adc  vertChange	sta  [RecordPtr],y	ldy  #TERecord.ViewRect.bottom	lda  [RecordPtr],y	clc	adc  vertChange	sta  [RecordPtr],y	ldy  #TERecord.ViewRect.left	lda  [RecordPtr],y	clc	adc  horzChange	sta  [RecordPtr],y	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	clc	adc  horzChange	sta  [RecordPtr],y;---------------------------------------------------------------	ldy  #TERecord.MouseRect.top	lda  [RecordPtr],y	clc	adc  vertChange	sta  [RecordPtr],y	ldy  #TERecord.MouseRect.bottom	lda  [RecordPtr],y	clc	adc  vertChange	sta  [RecordPtr],y	ldy  #TERecord.MouseRect.left	lda  [RecordPtr],y	clc	adc  horzChange	sta  [RecordPtr],y	ldy  #TERecord.MouseRect.right	lda  [RecordPtr],y	clc	adc  horzChange	sta  [RecordPtr],y;---------------------------------------------------------------	jsr  GetVertScrollBar	jsr  moveTheCtrl	jsr  GetGrowBoxHandle	jsr  moveTheCtrl	rts;---------------------------------------------------------------;---------------------------------------------------------------moveTheCtrl	beq  @skip	PushLongSpace	PushAX	jsr  DerefAX	stax TempPtr	ldy  #CtrlRecord.ctlRect.top	lda  [TempPtr],y	clc	adc  vertChange	sta  5,s	ldy  #CtrlRecord.ctlRect.left	lda  [TempPtr],y	clc	adc  horzChange	sta  7,s	_MoveControl@skip	rts;---------------------------------------------------------------	ENDP****************************************************************DefProc1Proc	PROC;---------------------------------------------------------------	ENTRY  do_target	ENTRY  do_activate;---------------------------------------------------------------;---------------------------------------------------------------do_target	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	bmi  makeTarget	bra  unmakeTarget;---------------------------------------------------------------do_activate	lda  ParameterPtr	bne  makeTarget;---------------------------------------------------------------unmakeTarget	ldy  #TERecord.SelectionActive	lda  [RecordPtr],y	bmi  exit	jsr  DeactivateSelection	lda  #$FFFF	bra  setTheState;---------------------------------------------------------------makeTarget	ldy  #TERecord.SelectionActive	lda  [RecordPtr],y	bpl  exit;;;	ldy  #TERecord.CtrlMoreFlags	;if the record is not the target control;;;	lda  [RecordPtr],y		;..then don't activate it;;;	bpl  exit*** 15-Oct-92 DAL -- make makeTarget activate non-target controls if they can never be the target	ldy  #TERecord.CtrlMoreFlags	;if the record is not the target control	lda  [RecordPtr],y		;..but it *could* be then don't activate it	and  #fCtlCanBeTarget+fCtlTarget	cmp  #fCtlCanBeTarget	beq  exit*** end 15-Oct-92	jsr  ActivateSelection	lda  #$0000;---------------------------------------------------------------setTheState	ldy  #TERecord.SelectionActive	sta  [RecordPtr],y	and  #$00FF		;mask off the high byte of the hilight	sta  TempWord		;..code and save it in TempWord	; 1/11/90 Mensch; Add the following test to see if the control is visible before performing the following; operations. This will prevent the controls from being drawn when the TERecord is invisible;	ldy  #TERecord.CtrlFlag	; 	lda [RecordPtr],y	and #fInvisible	bne @DontBother	jsr  GetVertScrollBar	jsr  hiliteTheControl	jsr  GetGrowBoxHandle	jsr  hiliteTheControl@DontBother;; End of change...exit	lda  #0	tax	rts;---------------------------------------------------------------;---------------------------------------------------------------hiliteTheControl	beq  @skip		;if the control doesn't exist, then exit	stax TempLong	jsr  DerefAX	stax TempPtr	ldy  #CtrlRecord.ctlHilite	lda  [TempPtr],y	cmp  TempWord	beq  @skip	jsr  GetPort		;save the original port	ldy  #CtrlRecord.ctlOwner+2	;set the port to the control's port	lda  [TempPtr],y	pha	dey	dey	lda  [TempPtr],y	pha	jsr  SetPort	ldy  #CtrlRecord.ctlRect	;copy the control rect into TempRect	lda  [TempPtr],y	sta  TempRect.top	iny	iny	lda  [TempPtr],y	sta  TempRect.left	iny	iny	lda  [TempPtr],y	sta  TempRect.bottom	iny	iny	lda  [TempPtr],y	sta  TempRect.right	PushZPtr TempRect		;validate the control rect, so we don't	_ValidRect		;..draw twice	PushZWord TempWord		;push the hilight code, then the control	PushZLong TempLong		;..handle	_HiliteControl	jsr  SetPort		;restore the original port@skip	rts;---------------------------------------------------------------	ENDP****************************************************************do_changeBounds	PROC; ###################################################################################; ##############################  insert routine here  ##############################; ###################################################################################	rts	ENDP****************************************************************do_growwindow	PROC;---------------------------------------------------------------calcNewBounds	jsr  GetWindowPortPtr	;get the old bounds rect into TempRect	ldy  #TERecord.BoundsRect	jsr  CopyIntoTempRect	ldy  #GrafPort.portRect.bottom	;set the new bottom coordinate of the	lda  [TempPtr],y		;..boundsRect	inc  a	sta  TempRect.bottom	ldy  #GrafPort.portRect.right	;set the new right coordinate of the	lda  [TempPtr],y		;..boundsRect	inc  a	sta  TempRect.right	lda  TempRect.top		;make sure the boundsRect is a certain	clc		;..minimum size.	adc  #MinBoundsDeltaV	cmp  TempRect.bottom	blt  @1	sta  TempRect.bottom@1	lda  TempRect.left	clc	adc  #MinBoundsDeltaH	cmp  TempRect.right	blt  @2	sta  TempRect.right@2;---------------------------------------------------------------calcNewView	lda  TempRect.right		;calculate the new view right and bottom	sec		;..and set them in the record.	ldy  #TERecord.BoundsRect.right	sbc  [RecordPtr],y	pha		;save the horizontal difference for adjust	clc		;..ruler	ldy  #TERecord.ViewRect.right	adc  [RecordPtr],y		;also save the new view rect values on the	sta  [RecordPtr],y		;..stack, since NewVertScrollBar will	pha		;..trash the view rect.	lda  TempRect.bottom	sec	ldy  #TERecord.BoundsRect.bottom	sbc  [RecordPtr],y	clc	ldy  #TERecord.ViewRect.bottom	adc  [RecordPtr],y	sta  [RecordPtr],y	pha;---------------------------------------------------------------setNewBounds	ldy  #TERecord.BoundsRect	;set the new boundsRect properly	jsr  CopyFromTempRect	PushZPtr TempRect		;invalidate the new boundsRect	_InvalRect;---------------------------------------------------------------moveGrowBox	jsr  GetGrowBoxHandle	;kill the old grow box and get a new one	jsr  KillControl	jsr  NewGrowBox	jsr  GetScrollBarPtr	;save the data, view and value for	ldy  #CtrlRecord.ctlRect.right	;..the old scroll bar	lda  [TempPtr],y	sec	ldy  #CtrlRecord.ctlRect.left	sbc  [TempPtr],y	pha	ldy  #CtrlRecord.ctlValue	lda  [TempPtr],y	pha	ldy  #CtrlRecord.dataSize	lda  [TempPtr],y	pha	ldy  #CtrlRecord.viewSize	lda  [TempPtr],y	pha	jsr  GetVertScrollBar	;kill the old scroll bar and get a new	jsr  KillControl		;..one	lda  #$FFFF	tax	jsr  NewVertScrollBar	jsr  flipScrollBarVis	;make the scroll bar invisible	jsr  GetVertScrollBar	;restore the data and view size	PushAX	_SetCtlParams	jsr  GetVertScrollBar	;restore the value	PushAX	_SetCtlValue	jsr  GetScrollBarPtr	;save the data, view and value for	ldy  #CtrlRecord.ctlRect.right	;..the old scroll bar	lda  [TempPtr],y	sec	ldy  #CtrlRecord.ctlRect.left	sbc  [TempPtr],y	eor  #$FFFF	sec	adc  1,s	tax	clc		;adjust the view rect by the difference	adc  5,s		;..in the scroll bars	sta  5,s	txa	clc		;adjust the right margin amount by the	adc  7,s		;..difference in the scroll bars	sta  7,s	plx;---------------------------------------------------------------restoreNewView	ldy  #TERecord.ViewRect.bottom	;restore the new view rect	pla	sta  [RecordPtr],y	ldy  #TERecord.ViewRect.right	pla	sta  [RecordPtr],y;---------------------------------------------------------------adjustRuler	jsr  GetTEHighFlags	and  #fGrowRuler	beq  @justReset	jsr  GetRightMargin		;adjust the right margin by the difference	clc		;..(still on the stack)	adc  1,s	sta  [TempPtr],y		;Y-Reg is still set here	jsr  InitialWordWrap	;rewrap the text	bra  @cleanup@justReset	jsr  ResetScrollBar		;reset the new scroll bar@cleanup	pla		;cleanup the stack	jsr  flipScrollBarVis	;make the scroll bar visible again	lda  #0	tax	rts;---------------------------------------------------------------;---------------------------------------------------------------flipScrollBarVis	jsr  GetScrollBarPtr	ldy  #CtrlRecord.ctlFlag	lda  [TempPtr],y	eor  #$80	sta  [TempPtr],y	rts;---------------------------------------------------------------GetScrollBarPtr	jsr  GetVertScrollBar	jsr  DerefAX		stax TempPtr	rts;---------------------------------------------------------------	ENDP****************************************************************do_handletab	PROC;---------------------------------------------------------------	jsr  IsTheSelectionACaret	bne  @1	jsr  UnhilightSelection@1	jsr  GetSelectionStart	lda  TextOffset	ora  TextOffset+2	beq  skipStart	ldy  #TERecord.SelectionEnd	jsr  PushRecordLong	jsr  SetSelectionEnd	stzl TextOffset	jsr  SetSelectionStart	jsr  InvertSelection	PullLong TextOffset	jsr  SetSelectionEnd;---------------------------------------------------------------skipStart	jsr  GetSelectionEnd	jsr  IsOffsetAtEnd	beq  skipEnd	jsr  SetSelectionStart	jsr  GetTextLength	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  InvertSelection	stzl TextOffset	jsr  SetSelectionStart;---------------------------------------------------------------skipEnd	ldy  #TERecord.SelectionState	lda  #$FFFF	sta  [RecordPtr],y;---------------------------------------------------------------	lda  #0	tax	rts;---------------------------------------------------------------	ENDP****************************************************************do_multiPart	PROC;---------------------------------------------------------------	lda  ParameterPtr	cmp  #2	blt  hideIt	cmp  #3	beq  drawIt;---------------------------------------------------------------showIt	jsr  GetVertScrollBar	jsr  showTheCtrl	jsr  GetGrowBoxHandle	jsr  showTheCtrl		;fall straight thru into draw it;---------------------------------------------------------------drawIt	jsr  GetVertScrollBar	;draw each one of the sub controls	jsr  drawTheCtrl	jsr  GetGrowBoxHandle	jsr  drawTheCtrl	bra  allDone;---------------------------------------------------------------hideIt	jsr  GetVertScrollBar	jsr  hideTheCtrl	jsr  GetGrowBoxHandle	jsr  hideTheCtrl;---------------------------------------------------------------allDone	lda  #0	tax	rts;---------------------------------------------------------------;---------------------------------------------------------------drawTheCtrl	beq  @done		;if the control handle is NULL, then skip	PushAX	_DrawOneCtl@done	rts;---------------------------------------------------------------;---------------------------------------------------------------showTheCtrl	beq  @done		;if the control handle is NULL, then skip	jsr  DerefAX		;..this routine	stax TempPtr	ldy  #CtrlRecord.ctlFlag	lda  [TempPtr],y	and  #$FF7F	sta  [TempPtr],y@done	rts;---------------------------------------------------------------;---------------------------------------------------------------hideTheCtrl	beq  @done		;if the control handle is NULL, then skip	jsr  DerefAX		;..this routine	stax TempPtr	ldy  #CtrlRecord.ctlFlag	lda  [TempPtr],y	ora  #$0080	sta  [TempPtr],y	ldy  #CtrlRecord.ctlRect.right	ldx  #6@loop	lda  [TempPtr],y	sta  TempRect.top,x	dey	dey	dex	dex	bpl  @loop	PushZPtr TempRect	_EraseRect	lda  ParameterPtr	dec  a	beq  @done	PushZPtr TempRect	_InvalRect@done	rts;---------------------------------------------------------------	ENDP****************************************************************MakeControlActive	PROCNAME  Export;---------------------------------------------------------------	jsr  GetTEHighFlags		;check to see if the record is a control	and  #fNotControl		;..or not	bne  @notAControl;---------------------------------------------------------------	ldy  #TERecord.CtrlMoreFlags	;if the control can't be a target, then	lda  [RecordPtr],y		;..skip	and  #fCtlCanBeTarget	beq  @exit	PushZLong RecordHandle	;save variables against recursion	PushZLong RecordHandle	_MakeThisCtlTarget	PullLong RecordHandle	bra  @exit;---------------------------------------------------------------@notAControl	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	ora  #fCtlTarget	sta  [RecordPtr],y	lda  #0		;pass zero for the parameters	tax	ldy  #ctlChangeActivity	;the message is change activity	jsr  CallDefProc;---------------------------------------------------------------@exit	brl  LockRecordHandle;---------------------------------------------------------------	ENDP****************************************************************FakeNewControl	PROCNAME  Export;---------------------------------------------------------------	ldax #TERecord.RecordSize	;don't bother calling the defproc. Just	jsr  GetClearHandle		;..get a clear handle of the correct size	bcc  @noError	txa		;put the error code in A-Reg. The carry	rts		;..is already set, so exit@noError	stax RecordHandle	jsr  LockRecordHandle;---------------------------------------------------------------	jsr  GetPort	PullAX	ldy  #TERecord.inPort	jsr  SetRecordLong	ldy  #TEParam.ID	jsr  GetParamLong	ldy  #TERecord.CtrlID	jsr  SetRecordLong	ldy  #TEParam.boundsRect	jsr  GetParamLong	ldy  #TERecord.BoundsRect	jsr  SetRecordLong	ldy  #TEParam.boundsRect+4	jsr  GetParamLong	ldy  #TERecord.BoundsRect+4	jsr  SetRecordLong	ldy  #TEParam.ctlFlags	lda  [ParameterPtr],y	ldy  #TERecord.CtrlFlag	sta  [RecordPtr],y	ldy  #TEParam.ctlMoreFlags	lda  [ParameterPtr],y	ldy  #TERecord.CtrlMoreFlags	sta  [RecordPtr],y	ldy  #TEParam.refCon	jsr  GetParamLong	ldy  #TERecord.CtrlRefCon	jsr  SetRecordLong	lda  #TextEditControl>>16	;set the high word of the control proc 	ldy  #TERecord.CtrlProc+2	;..field	sta  [RecordPtr],y;---------------------------------------------------------------	jsr  UnlockRecordHandle	PushLongSpace		;result	PushWord #3		;message	PushLong ParameterPtr	;parameters	PushZLong RecordHandle	;control handle	jsl  TEDefProc	lda  5,s		;move the return address	sta  1,s	lda  RecordHandle		;return the record handle	sta  3,s	lda  RecordHandle+2	sta  5,s	lda  #0		;return no error	clc	rts;---------------------------------------------------------------	ENDP****************************************************************NewGrowBox	PROCNAME  Entry;---------------------------------------------------------------	jsr  GetWindowPortPtr	PushLongSpace		;the width of the scroll bar is the size	_GrowSize		;..of the grow icon	ldy  #GrafPort.portRect.bottom	lda  [TempPtr],y	inc  a	sta  TempRect.bottom	sec	sbc  1,s	sta  TempRect.top	pla	ldy  #GrafPort.portRect.right	lda  [TempPtr],y	inc  a	sta  TempRect.right	sec	sbc  1,s	sta  TempRect.left	pla;; 2/28/90	Mensch;; Fix bug in the visibility of the scroll bar. Seems that we never took the TERecords visibility; into account when we created the scroll bar. This should fix that...;	ldy #TERecord.CtrlFlag	lda [RecordPtr],y		; get the TERecords ctlFlag field	and #fInVisible		; strip off the visible bit..	pha	lda >MyTempFlags		; get the template value...	and #$FF7F		; strip the old visible setting	ora 1,s	sta >MyTempFlags	pla	ldy  #GrowTemplate.RecordSize	;create a new handle and copy this	ldax #myTemplate		;..template into it. The size is in Y-Reg	jsr  CopyTemplateToHand	ldy  #TEColorTable.growVerb	ldx  #GrowTemplate.ColorRef+2	jsr  MakeTheControl		;this creates the control	ldy  #TERecord.GrowBoxHandle	brl  SetRecordLong;---------------------------------------------------------------;---------------------------------------------------------------myTemplate	dc.w  7		;parameter count	dc.l  0		;ID number	ds.w  4		;space for the bounding rectangle	dc.l  $88000000		;procRefMyTempFlags	dc.w  $0001		;flags - indicates vertical scroll bar	dc.w  $1000		;initial more flags	dc.l  0		;refCon	ds.l  1		;space for the color table ref;---------------------------------------------------------------	ENDP****************************************************************NewVertScrollBar	PROCNAME  Entry;---------------------------------------------------------------	stax TempLong		;A and X contain the scroll bar 'handle'	lda  TempLong+1		;..from the parameter block. If the hand	bne  @notNull		;..is NULL, then exit	rts@notNull	cpx  #$FFFF	beq  makeOne	lda  TempLong	stax TempPtr	jsr  DerefTempPtr	ldy  #CtrlRecord.ctlRefCon	lda  RecordHandle	sta  [TempPtr],y	iny	iny	lda  RecordHandle+2	sta  [TempPtr],y	ldax TempLong	bra  setAction;---------------------------------------------------------------makeOne	ldy  #TERecord.BoundsRect	;the initial bounding rectangle for the	jsr  CopyIntoTempRect	;..scroll bar is the boundRect for the TERecord	PushLongSpace		;the width of the scroll bar is the size	_GrowSize		;..of the grow icon	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	and  #FCtlTellAboutSize	beq  @1	lda  TempRect.bottom	sec	sbc  1,s	inc  a	sta  TempRect.bottom@1	plx		;pull garbage	lda  TempRect.right		;the left edge of the scroll bars bounds	sec		;..rect is the right edge minus the width	sbc  1,s	sta  TempRect.left	ldy  #TERecord.ViewRect.right	;change the text rectangle too.	lda  [RecordPtr],y	sec	sbc  1,s	sta  [RecordPtr],y	pla		;restore the stack;; 2/28/90	Mensch;; Fix bug in the visibility of the scroll bar. Seems that we never took the TERecords visibility; into account when we created the scroll bar. This should fix that...;	ldy #TERecord.CtrlFlag	lda [RecordPtr],y		; get the TERecords ctlFlag field	and #fInVisible		; strip off the visible bit..	pha	lda >MyTempFlags		; get the template value...	and #$FF7F		; strip the old visible setting	ora 1,s	sta >MyTempFlags	pla		ldy  #ScrollTemplate.RecordSize	;create a new handle and copy this	ldax #myTemplate		;..template into it. The size is in Y-Reg	jsr  CopyTemplateToHand*** added 8-Dec-91 DAL -- If vertical scroll bar comes to top of window, make the top -1 instead of 0*** (The Scroll Bar bug is finally fixed, so this won't make the up-arrow ugly)	lda  TempRect.top	bne  @notZero	dec  TempRect.top@notZero*** end 8-Dec-91	ldy  #TEColorTable.vertBarVerb	ldx  #ScrollTemplate.ColorRef+2	jsr  MakeTheControl;---------------------------------------------------------------setAction	PushLong #ScrollActionProc	;set the action procedure	PushAX	ldy  #TERecord.VertScrollBar	jsr  SetRecordLong	_SetCtlAction	rts;---------------------------------------------------------------;---------------------------------------------------------------myTemplate	dc.w  10		;parameter count	dc.l  0		;ID number	ds.w  4		;space for the bounding rectangle	dc.l  $86000000		;procRefMyTempFlags	dc.w  $0003		;flags - indicates vertical scroll bar	dc.w  $1000		;initial more flags	dc.l  0		;refCon	dc.w  0		;initial value	dc.w  0		;view size	dc.w  0		;data size	ds.l  1		;space for the color table ref;---------------------------------------------------------------	ENDP****************************************************************CopyTemplateToHand	PROCNAME  Entry;---------------------------------------------------------------	sty  MoveLength		;save the size of the template	stz  MoveLength+2	stax SourcePtr		;save the pointer to copy from	tya	jsr  GetSmallHandle	stax TempLong	jsr  DerefAX	stax DestPtr	brl  BlockMove;---------------------------------------------------------------	ENDP****************************************************************MakeTheControl	PROCNAME  Entry;---------------------------------------------------------------	phx		;save the color ref index into the template	phy		;save the index into the color table	jsr  SetupColorPtr		;find a pointer to our color table	Deref TempLong,DestPtr	;deref our scroll template again in case	lda  1,s		;..it moved.	tay		;get the color table index back into Y-Reg	lda  [TempPtr],y		;the index points to the color verb bits	ldy  #ScrollTemplate.MoreFlags	;..put these bits into the template	ora  [DestPtr],y	sta  [DestPtr],y	ply		;get back the index into the color table	iny		;..and skip over the verb to get to the	iny		;..actual color ref for this control	lda  [TempPtr],y		;get the ref itself into X-Reg and A-Reg	tax		;..(the opposite of the normal low/high	iny		;..order)	iny	lda  [TempPtr],y	ply		;get back the index into the template's	sta  [DestPtr],y		;..color table. This points to the high	dey		;..word	dey	txa	sta  [DestPtr],y;---------------------------------------------------------------	ldy  #TemplateRecord.Rect	;copy TempRect into the bounding rect	lda  TempRect.top		;..field of the template	sta  [DestPtr],y	iny	iny	lda  TempRect.left	sta  [DestPtr],y	iny	iny	lda  TempRect.bottom	sta  [DestPtr],y	iny	iny	lda  TempRect.right	sta  [DestPtr],y	ldy  #TemplateRecord.RefCon	;copy the RecordHandle to the refcon of	lda  RecordHandle		;..the control	sta  [DestPtr],y	iny	iny	lda  RecordHandle+2	sta  [DestPtr],y;---------------------------------------------------------------	PushLongSpace	ldy  #TERecord.inPort	;window pointer (space is already on the stack)	jsr  PushRecordLong	PushWord #1		;single handle to the template	PushZLong TempLong	_NewControl2	ldax TempLong		;kill the handle we created for the 	jsr  KillHandle		;..template	PullAX	rts;---------------------------------------------------------------	ENDP****************************************************************KillControl	PROCNAME  Export	beq  @1	stax TempPtr	ldy  #1	lda  [TempPtr],y	beq  @1	phx	pei  TempPtr	_DisposeControl@1	rts	ENDP****************************************************************GetParamLong	PROCNAME  Export	lda  [ParameterPtr],y	pha	iny	iny	lda  [ParameterPtr],y	tax	pla	rts	ENDP****************************************************************	END