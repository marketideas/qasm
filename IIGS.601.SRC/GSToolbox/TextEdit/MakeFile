#---------------------------------------------------------------##	this file is the make file for GSTextEdit. The two main#	targets are 'Tool034' and 'TextEdit'##---------------------------------------------------------------ToolIncludes =	"{AIIGSIncludes}all.macros"		¶				TextEdit.macros					¶				Tool.Records					¶				GlobalRecords					¶				GlobalEquates					¶				GlobalVars						¶				::sys.equs.asmToolObjects =	:obj:highlevel.aii.obj			¶				:obj:block.aii.obj				¶				:obj:defproc.aii.obj			¶				:obj:draw.aii.obj				¶				:obj:entry.aii.obj				¶				:obj:fastdraw.aii.obj			¶				:obj:format.aii.obj				¶				:obj:idle.aii.obj				¶				:obj:key.aii.obj				¶				:obj:measure.aii.obj			¶				:obj:memory.aii.obj				¶				:obj:record.aii.obj				¶				:obj:scrap.aii.obj				¶				:obj:scroll.aii.obj				¶				:obj:selection.aii.obj			¶				:obj:super.aii.obj				¶				:obj:text.aii.obj				¶				:obj:width.aii.obj				¶				:obj:wrap.aii.obj## add the following line to the list of objects to add debugging code##				:obj:debug.aii.obj				¶##---------------------------------------------------------------TextEdit  ÄÄ  Tool034#---------------------------------------------------------------Tool034  Ä  MakeFile {ToolObjects}	Echo "# `date -t` ----- Linking object modules."	Echo "	LinkIIGS {ToolObjects} -t TOL -o Tool034"	LinkIIGS {ToolObjects} -t TOL -o Tool034	If {DaveSys} == 1		Echo "# `date -t` ----- Copying files to a ProDOS disk."		Echo "	DuplicateIIGS -y -mac Tool034 Tool034"		DuplicateIIGS -y -mac Tool034 Tool034	End	if {AutoDuplicate} == 1		DuplicateIIGS -y -mac Tool034 :	End#---------------------------------------------------------------{ToolObjects}  Ä  MakeFile Include.Symbols GlobalIncludesInclude.Symbols  Ä  MakeFile GenerateDump {ToolIncludes}	Set Echo 0	Echo "	AsmIIGS -c GenerateDump"	AsmIIGS -c GenerateDump#---------------------------------------------------------------.aii.obj  Ä  .aii		Set Echo 0		Set DebugSymbols 0		Echo "	AsmIIGS -d DebugSymbols=`if {DebugSymbols};echo '1';else;echo '0';end` -wi -unsafe {DepDir}{Default}.aii -o {TargDir}{Default}.aii.obj"		AsmIIGS -d DebugSymbols=`if {DebugSymbols};echo '1';else;echo '0';end` -wi -unsafe {DepDir}{Default}.aii -o {TargDir}{Default}.aii.obj:obj:  Ä  :#---------------------------------------------------------------