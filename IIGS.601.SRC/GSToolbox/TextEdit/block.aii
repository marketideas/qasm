************************************************************************                      GSTextEdit  Version 1.0*                          File: block.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***  5 January 90	Dave Good** Changed KillBlockList so that it zeros the cached block handle after* it disposed of the block list.** 2/23/90	Mensch** Fixed the join routine in fixBlockList. It was off by $10 (size of the block header) when it* copied the data AND it called derefAX right after a TAX (obviously bad handle...)** 8/8/90	Mensch** Fixed more stuff in the join routine. Seems that If you joined the second to last* super block to the last super block, 4 bytes of random memory would get trashed* Also, Cached block could be still set to a deleted block of memory* oooops that would be too bad. We had to reset that also***********************************************************************	INCLUDE  'GlobalIncludes'TextPrevLinkDB	equ $FE1200TextNextLinkDB	equ $FE1210****************************************************************** Description** This routine allocates memory for a new block list and sets* the BlockList field in the TERecord to the newly created handle**** Inputs:	none** Outputs:	TERecord.BlockList (the cache is filled)*** Change History** 30 May 89	Dave Good** Initial Release.*****************************************************************NewBlockList	PROCNAME  Export;---------------------------------------------------------------	lda  #0		;zero out the cached block start field	tax	ldy  #TERecord.BlockList.cachedTextOffset	jsr  SetRecordLong	lda  #256+TextBlock.textStart	;get a new,clear handle of the initial	jsr  GetClearHandle		;..size	ldy  #TERecord.BlockList.cachedHandle	brl  SetRecordLong;---------------------------------------------------------------	ENDP****************************************************************** Description** This routine kills all the blocks in the block list.**** Inputs:	TERecord.BlockList** Outputs:	none*** Change History** 30 May 89	Dave Good** Initial Release.*****************************************************************KillBlockList	PROCNAME  Export;---------------------------------------------------------------	jsr  CachedBlockToPtr	;set TempPtr to our current block	lda  BlockHandle+1		;..if there is no block list, then just	beq  @exit		;..exit@loop1	jsr  MoveToPrevBlock	;move back to the first block	bcc  @loop1	@loop2	PushZLong BlockHandle	;save the current block handle, then	jsr  BlockHandleToPtr	;..dereference it, in case it moved	jsr  MoveToNextBlock	;find the next block	PullAX		;get the current handle back into A,X	php		;save the carry flag	jsr  KillHandle		;kill the current handle	plp		;if the carry is CLEAR, there was a next	bcc  @loop2		;..handle, so loop back to kill it@exit	ldy  #TERecord.BlockList.cachedHandle	;zero out the cached handle for the	lda  #0		;..block list	tax	brl  SetRecordLong;---------------------------------------------------------------	ENDP****************************************************************** Description** This routine finds the block corresponding to TextOffset. It* then returns the block handle in BlockHandle, the length in* BlockLength, and finally it sets the cache fields in the* TERecord.**** Inputs:	TextOffset** Outputs:	BlockHandle*	BlockLength*	TERecord.BlockList (the cache is filled)*** Change History** 30 May 89	Dave Good** Initial Release.*****************************************************************FindBlockInfo	PROCNAME  Export;---------------------------------------------------------------	jsr  CachedBlockToPtr	;set TempPtr to our current block	ldy  #TERecord.BlockList.cachedTextOffset+2	lda  [RecordPtr],y		;get the cached block start into the	sta  BlockStart+2		;..direct page variable	tax	dey	dey	lda  [RecordPtr],y	sta  BlockStart	cpx  TextOffset+2		;see which direction we should search	blt  doForward	bne  doBackward	cmp  TextOffset	blt  doForward	bne  doBackward;---------------------------------------------------------------doForward	ldy  #TextBlock.textLength+2	;if we are going forward, we could already	lda  [TempPtr],y		;..be in the correct block, so make sure	sta  BlockLength+2		;..the BlockLength variable is set, then	dey		;..check to see if we are already on the	dey		;..current block. If we are then just	lda  [TempPtr],y		;..exit	sta  BlockLength	clc	adc  BlockStart	tax	lda  BlockLength+2	adc  BlockStart+2	cmp  TextOffset+2	blt  @keepGoing	bne  @alreadyThere	cpx  TextOffset	ble  @keepGoing@alreadyThere	rts@loop	ldy  #TextBlock.textLength	;add the current block's length to the	lda  [TempPtr],y		;..block start and leave in X and A	clc	adc  BlockStart	tax	iny	iny	lda  [TempPtr],y	adc  BlockStart+2	cmp  TextOffset+2		;have we found the correct block ? If so	blt  @keepGoing		;..then goto foundIt	bne  foundIt	cpx  TextOffset	bgt  foundIt@keepGoing	stx  BlockStart		;nope, so store the new BlockStart and	sta  BlockStart+2		;..move to the next block	jsr  MoveToNextBlock	bcc  @loop	ldy  #TextBlock.textLength	;we are at the very end here, so move	lda  BlockStart		;..block start back over the last block	sec		;..and exit	sbc  [TempPtr],y	sta  BlockStart	iny	iny	lda  BlockStart+2	sbc  [TempPtr],y	sta  BlockStart+2	bra  foundIt;---------------------------------------------------------------doBackward	jsr  MoveToPrevBlock	;move to the previous block	ldy  #TextBlock.textLength	;subtract the new length from the block	lda  BlockStart		;..start to find the new block start	sec	sbc  [TempPtr],y	sta  BlockStart	tax	iny	iny	lda  BlockStart+2	sbc  [TempPtr],y	sta  BlockStart+2	cmp  TextOffset+2		;have we found our TextOffset ? If not	blt  foundIt		;..then loop back to doBackward	bne  doBackward	cpx  TextOffset	bgt  doBackward;---------------------------------------------------------------foundIt	lda  [TempPtr],y		;set the direct page variable to the	sta  BlockLength+2		;..length of the current block	dey	dey	lda  [TempPtr],y	sta  BlockLength	ldy  #TERecord.BlockList.cachedHandle	;set the cached fields in the main record	lda  BlockHandle		;..to point to the block we just found	sta  [RecordPtr],y	iny	iny	lda  BlockHandle+2	sta  [RecordPtr],y	ldy  #TERecord.BlockList.cachedTextOffset	lda  BlockStart	sta  [RecordPtr],y	iny	iny	lda  BlockStart+2	sta  [RecordPtr],y	rts;---------------------------------------------------------------	ENDP****************************************************************** Description** This routine sets the size of BlockHandle to the length specified* by BlockLength. NOTE: this is NOT necessarily the same as* TERecord.BlockList.cachedHandle. Finally this routine marks the* block as dirty**** Inputs:	BlockHandle*	BlockLength** Outputs:	none*** Change History** 30 May 89	Dave Good** Initial Release.*****************************************************************SetBlockSize	PROCNAME  Export;---------------------------------------------------------------	jsr  BlockHandleToPtr	;set TempPtr to the current block	shortm		;switch into short mode	ldy  #TextBlock.textLength+1	;compare the middle byte of the length	lda  [TempPtr],y		;..(xxxxFFxx) with the middle of the	cmp  BlockLength+1		;..block length. This is the same as	longm		;..comparing the old and new lengths	bne  resizeIt		;..rounded down to the nearest $100 bytes	iny		;If the 'rounded' lengths are NOT equal	lda  [TempPtr],y		;..then we need to resize this block	cmp  BlockLength+2	beq  skipResize;---------------------------------------------------------------resizeIt	PushZLong BlockHandle	;SetHandleSize needs the handle on the	ldax BlockLength		;..stack	and  #$FF00		;round off the length and add the header	clc		;..length to get the real handle size	adc  #256+TextBlock.textStart	bcc  @1	inx@1	jsr  SetHandleSize		;if we get an error, then just exit	bcs  exit	jsr  BlockHandleToPtr	;re-dereference the block handle;---------------------------------------------------------------skipResize	ldy  #TextBlock.flags	;since we changed this block, mark it as	lda  [TempPtr],y		;..dirty	ora  #fBlockIsDirty	sta  [TempPtr],y	ldy  #TextBlock.textLength+2	;set the new length field in the block	lda  BlockLength+2	sta  [TempPtr],y	dey	dey	lda  BlockLength	sta  [TempPtr],y	clc		;indicate no error and exit;---------------------------------------------------------------exit	rts;---------------------------------------------------------------	ENDP****************************************************************** Description** This routine makes TextPtr a pointer to the text specified by* TextOffset. NOTE: this routine does NOT rely on the block* already being "found"**** Inputs:	TextOffset** Outputs:	TextPtr*** Change History** 30 May 89	Dave Good** Initial Release.*****************************************************************FindTextPtr	PROCNAME  Export;---------------------------------------------------------------	jsr  FindBlockInfo	lda  TextOffset		;find the difference between the current	sec		;..offset and the block start. Leave it	sbc  BlockStart		;..in TextPtr	sta  TextPtr	lda  TextOffset+2	sbc  BlockStart+2	sta  TextPtr+2	lda  BlockLength		;find the number of characters left in	sec		;..the block (BlockCount). The max is	sbc  TextPtr		;..$FFFF	sta  BlockCount	lda  BlockLength+2	sbc  TextPtr+2	beq  @1	lda  #$FFFF	sta  BlockCount@1	lda  TempPtr		;add the starting pointer for the block	clc		;..handle to the difference that we	adc  TextPtr		;..found earlier.	sta  TextPtr	lda  TempPtr+2	adc  TextPtr+2	sta  TextPtr+2	lda  #TextBlock.textStart	;finally, adjust TextPtr past the header	adc  TextPtr		;..of the text block. NOTE: the carry is	sta  TextPtr		;..always clear for the ADC	bcc  @2	inc  TextPtr+2@2	rts;---------------------------------------------------------------	ENDP****************************************************************** Description** This routine scans through the entire block list looking for* blocks that are either too small or too big. If it finds a* block that is too big, it will split it and then mark the split* off block as clean. If it finds a block that is too small it* will join it to the next block, then mark the combined block as* clean. This routine is called at idle time every 10 ticks, but* if every block in the block list is clean it will take less* than 25 ms per megabyte of text.**** Inputs:	none** Outputs:	none*** Change History** 30 May 89	Dave Good** Initial Release.*****************************************************************FixBlockList	PROCNAME  Export	Import CacheBlockFix;---------------------------------------------------------------	jsr  CachedBlockToPtr	;find the first block in the list@loop1	jsr  MoveToPrevBlock	bcc  @loop1@loop2	ldy  #TextBlock.flags	;loop through all the blocks in the list	lda  [TempPtr],y		;..looking for dirty ones	bmi  @foundDirty@next	jsr  MoveToNextBlock	bcc  @loop2	rts		;nothing was dirty, so exit@foundDirty	ldy  #TextBlock.textLength+2	;we found a dirty block, so check to see	lda  [TempPtr],y		;..if it is too big.	bne  checkForSplit	dey	dey	lda  [TempPtr],y	cmp  #MaxBlockSize	bge  checkForSplit		;if the block is too big, then split it	cmp  #MinBlockSize		;if the block is too small, then join it	bge  @clearDirty	brl  joinTheBlock@clearDirty	jsr  clearBlockFlags	;since the block shouldn't be split or	bra  @next		;..joined, then clear the dirty flag;---------------------------------------------------------------checkForSplit		ldy  #TextBlock.textLength+2	;get the size of the entire block and	lda  [TempPtr],y		;..subtract (SplitBlockSize - textStart)	tax	dey	dey	lda  [TempPtr],y	sec	sbc  #SplitBlockSize-TextBlock.textStart	bcs  @1	dex@1	clc		;Then add this to the starting pointer to	adc  TempPtr		;..make a pointer to where to start searching	sta  MemoryPtr		;..backwards from.	txa	adc  TempPtr+2	sta  MemoryPtr+2	ldy  #TextBlock.textLength+2	;Y-Reg is the maximum number of characters	lda  [TempPtr],y		;..to look through	beq  @useLength	lda  #$FFFF	bra  @useAReg@useLength	dey	dey	lda  [TempPtr],y@useAReg	sec	sbc  #SplitBlockSize	tay	sty  TempWord		;subtract the maximum number of characters	lda  MemoryPtr		;..from MemoryPtr to find a pointer to the	sec		;..beginning of the split area	sbc  TempWord	sta  MemoryPtr	bcs  @2	dec  MemoryPtr+2@2	shortm		;look for a CR (in short mode for speed)@loop	lda  [MemoryPtr],y	cmp  #CR	beq  doTheSplit	dey	bne  @loop	longm;---------------------------------------------------------------clearBlockFlags	ldy  #TextBlock.flags	;since we can't split this block, mark it	lda  [TempPtr],y		;..as clean.	and  #ÅfBlockIsDirty	sta  [TempPtr],y	rts;---------------------------------------------------------------doTheSplit	rep  #$20		;back to long mode here	tya	sec		;this skips over the CR, so memoryPtr	adc  MemoryPtr		;..points just past it	sta  MemoryPtr	bcc  @11	inc  MemoryPtr+2@11	subl MemoryPtr,TempPtr,BlockLength	;find the new length of the original	lda  BlockLength		;..block	sec	sbc  #TextBlock.textStart	sta  BlockLength	bcs  @1	dec  BlockLength+2@1	ldx  BlockLength+2		;check for the resulting block being	bne  @2		;..smaller than the minimum block size	cmp  #MinBlockSize		;..if it is, then just clear the dirty	blt  clearBlockFlags	;..flags and exit@2	ldy  #TextBlock.textLength	;now find the length of the new block	lda  [TempPtr],y	sec	sbc  BlockLength	sta  MoveLength	iny	iny	lda  [TempPtr],y	sbc  BlockLength+2	sta  MoveLength+2	tax	lda  MoveLength		;round off and adjust the new length. Then	and  #$FF00		;..get a handle of the proper size	clc	adc  #256+TextBlock.textStart	bcc  @3	inx@3	jsr  GetLargeHandle		;if we get a memory error, then abort the	bcc  @weHaveMemory		;..split and clear the dirty flags	bra  clearBlockFlags@weHaveMemory	stax TempLong		;save the new handle in TempLong and	jsr  DerefAX		;..deref it into MemoryPtr	stax MemoryPtr	jsr  BlockHandleToPtr	;reset TempPtr in case the block moved	ldy  #TextBlock.nextHandle	;set the next handle field for both the	lda  [TempPtr],y		;..new block and the old block	sta  [MemoryPtr],y	lda  TempLong	sta  [TempPtr],y	iny	iny	lda  [TempPtr],y  sta >TextNextLinkDB+2	sta  [MemoryPtr],y	lda  TempLong+2  sta >TextNextLinkDB+2	sta  [TempPtr],y	ldy  #TextBlock.prevHandle	;set the previous handle of the new block	lda  BlockHandle	sta  [MemoryPtr],y	iny	iny	lda  BlockHandle+2	sta  [MemoryPtr],y  sta >TextPrevLinkDB+2	ldy  #TextBlock.textLength	;set the length of the new block	lda  MoveLength	sta  [MemoryPtr],y	iny	iny	lda  MoveLength+2	sta  [MemoryPtr],y	ldy  #TextBlock.flags	;clear the flags for the new block	lda  #0	sta  [MemoryPtr],y	ldax BlockLength		;find the source pointer for moving the	clc		;..text from the old block to the new one	adc  #TextBlock.textStart	bcc  @4	inx	clc@4	adc  TempPtr	sta  SourcePtr	txa	adc  TempPtr+2	sta  SourcePtr+2	lda  #TextBlock.textStart	;the dest pointer is the pointer to the	clc		;..start of the new block adjusted for	adc  MemoryPtr		;..the header	sta  DestPtr	lda  MemoryPtr+2	adc  #0	sta  DestPtr+2	jsr  BlockMove		;move the text	jsr  SetBlockSize		;set the old handle size to free memory	Deref TempLong,TempPtr	;make TempPtr point to the newly created	jsr  MoveToNextBlock	;..block. Then find the next block and	bcs  allDone		;..if there is one, set the prev handle	ldy  #TextBlock.prevHandle	;..field to the new block	lda  TempLong	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y  sta >TextPrevLinkDB+2;---------------------------------------------------------------allDone	rts;---------------------------------------------------------------	Export joinTheBlock;---------------------------------------------------------------joinTheBlock		jsr  clearBlockFlags	;clear the dirty flag for this block	ldy  #TextBlock.textLength	;save the length of the block in OldBlockSize	lda  [TempPtr],y	sta  OldBlockSize	movl BlockHandle,TempLong	;save the current block handle	jsr  MoveToNextBlock	;make sure there is another block. If	bcs  allDone		;..there isn't then exit	ldy  #TextBlock.textLength	lda  [TempPtr],y	sta  MoveLength	clc	adc  OldBlockSize	sta  BlockLength	iny	iny	lda  [TempPtr],y	sta  MoveLength+2	adc  #0	sta  BlockLength+2	ldy  #TextBlock.nextHandle+2	;save the next block's handle on the stack	lda  [TempPtr],y		;..so we can link it in properly	pha	dey	dey	lda  [TempPtr],y	pha	PushZLong BlockHandle	;one copy for KillHandle	PushZLong BlockHandle	;..and another for DerefHandle;; 8/8/90	Mensch; Bad News Chappey, you say above PushZLong BlockHandle ; one copy for KillHandle!; While thats all well and good, you also do not test the cached handle to determine; if you need to set a new cached block. Since this seems to crash the system when you; join with the first super block, we will take this oportunity to reset the cached textblock; handle to the BlockHandle that we are growing (In this case, tempLong)	ldax TempLong	jsr  CacheBlockFix;	movl TempLong,BlockHandle	;resize the original block so it is big	jsr  SetBlockSize		;..enough to contain them both	bcs  memoryError	jsr  clearBlockFlags	;clear the dirty flag for this block	jsr  BlockHandleToPtr	;redereference the original block handle	lda  TempPtr		;make destptr be a pointer to the end	clc		;..of the old block	adc  OldBlockSize	sta  DestPtr	lda  TempPtr+2	adc  #0	sta  DestPtr+2;; 2/23/90	Mensch; Forgot to bump the destination pointer by the size of the start of the textblock header; This takes care of a goofy word wrapping nightmare...;	lda DestPtr	clc	adc #TextBlock.textStart	sta DestPtr	bcc @mensch	inc DestPtr+2@mensch	jsr  DerefHandle		;dereference the next handle and skip	clc		;..over the header to get SourcePtr	adc  #TextBlock.textStart	bcc  @1	inx@1	stax SourcePtr	jsr  BlockMove	PullAX		;get back the next block handle and kill	jsr  KillHandle		;..it	ldy  #TextBlock.nextHandle	;reset the next handle link in the chain	pla	sta  [TempPtr],y	iny	iny	pla	sta  [TempPtr],y	tax; 2/23/90	Mensch;; Fixed bug here where he called DerefAX right after a TAX (don't see right to me either...); this seems to fix the random crashing bug during idle...;	ldy #TextBlock.NextHandle	; get the low word of the next hndl;; 8/8/90	Mensch; What happens here when the NextHandle field was set to zero? Seems to me that we would simply; crash memory! So, we must first test to be sure next handle is zero here!;	ora [TempPtr],y	; fortunately here we have the high word of next in <A>	beq @Skip080890	; if this is zero then we can skip the rest of the cleanup	lda [TempPtr],y		; back into <A>; end of fix...			jsr  DerefAX		;set TempPtr to the next handle so we	stax TempPtr		;..can reset the prev link	ldy  #TextBlock.prevHandle	lda  BlockHandle	sta  [TempPtr],y	iny	iny	lda  BlockHandle+2	sta  [TempPtr],y@Skip080890	rts;---------------------------------------------------------------memoryError	pla		;pull the garbage off the stack	pla	pla	pla	rts		;the carry is already SET here;---------------------------------------------------------------	ENDP	EJECT********************************************************************************CacheBlockFix	PROC Export** Description:	*** Inputs:	<A><X> Contain some valid handle from the text block list*	since this routine assumes that the Super block list is in fact*	invalid!** Outputs:	None** External Refs:** Entry Points:********************************************************************************		ldy  #TERecord.BlockList.cachedHandle	;copy handle into the	sta  [RecordPtr],y		;..record variable CachedHandle	iny	iny	txa	sta  [RecordPtr],y; Now move to the head of the super block list!	jsr  CachedBlockToPtr	;set TempPtr to our current block@loop1	jsr  MoveToPrevBlock	;move back to the first block	bcc  @loop1			ldy  #TERecord.BlockList.cachedHandle	;copy handle into the Cached block	lda  BlockHandle		; field again	sta  [RecordPtr],y	iny	iny	lda  BlockHandle+2	sta  [RecordPtr],y		ldy  #TERecord.BlockList.cachedTextOffset ; now since the cached handle contains	lda  #0		; the fir block, zero the offset	sta  [RecordPtr],y	iny	iny	sta  [RecordPtr],y	rts		; and exit!	EndP****************************************************************** Description** This set of utility routines allow one to scan forwards and* backwards within the block list, dereference the current* BlockHandle, and access the cached block handle.**** Change History** 30 May 89	Dave Good** Initial Release.*****************************************************************Block1Proc	PROC;---------------------------------------------------------------	EXPORT  CachedBlockToPtr	EXPORT  BlockHandleToPtr	EXPORT  MoveToNextBlock	EXPORT  MoveToPrevBlock;---------------------------------------------------------------;---------------------------------------------------------------CachedBlockToPtr	ldy  #TERecord.BlockList.cachedHandle	;copy the cached block handle into the	lda  [RecordPtr],y		;..global variable BlockHandle	sta  BlockHandle	iny	iny	lda  [RecordPtr],y	sta  BlockHandle+2	bra  BlockHandleToPtr	;now dereference it;---------------------------------------------------------------MoveToPrevBlock	ldy  #TextBlock.prevHandle+1	bra  commonCode;---------------------------------------------------------------MoveToNextBlock	ldy  #TextBlock.nextHandle+1;---------------------------------------------------------------commonCode	lda  [TempPtr],y		;check for the next (or prev) handle being	beq  atTheEnd		;..$0000 0000, which indicates the end of	stz  BlockHandle+2		;..the list. Here we make sure the highest	sta  BlockHandle+1		;..byte of the handle is zero	dey	lda  [TempPtr],y		;copy the low word of the new handle	sta  BlockHandle	clc		;indicate NOT at the end of the list;---------------------------------------------------------------BlockHandleToPtr	Deref BlockHandle,TempPtr	;deref the block handle into TempPtr	rts;---------------------------------------------------------------atTheEnd	sec		;indicate at the end (or the beginning)	rts		;..of the block list;---------------------------------------------------------------	ENDP****************************************************************	END