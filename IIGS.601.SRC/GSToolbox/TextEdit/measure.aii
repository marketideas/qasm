************************************************************************                      GSTextEdit  Version 1.0*                         File: measure.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************ClearOffsetCache	PROCNAME  Export;---------------------------------------------------------------	ldy  #TERecord.CachedSelcOffset	lda  #$FFFF	sta  [RecordPtr],y	iny	iny	sta  [RecordPtr],y	rts;---------------------------------------------------------------	ENDP****************************************************************IsOffsetCached	PROCNAME  Export;---------------------------------------------------------------	ldy  #TERecord.CachedSelcOffset	lda  TextOffset	cmp  [RecordPtr],y	bne  @done	iny	iny	lda  TextOffset+2	cmp  [RecordPtr],y@done	rts;---------------------------------------------------------------	ENDP****************************************************************; this routine returns the screen point TextVPos and TextHPos; associated with TextOffset. It returns carry set (TRUE) if the; offset is not on the screen.****************************************************************CachedOffsetToPoint	PROCNAME  Export;---------------------------------------------------------------	jsr  OffsetToVPos	bcs  @done	jsr  OffsetToHPos	ldy  #TERecord.CachedSelcOffset	lda  TextOffset	sta  [RecordPtr],y	iny	iny	lda  TextOffset+2	sta  [RecordPtr],y	iny	iny	lda  TextVPos	sta  [RecordPtr],y	iny	iny	lda  TextHPos	sta  [RecordPtr],y	clc@done	rts;---------------------------------------------------------------	ENDP****************************************************************; this routine returns the screen point TextVPos and TextHPos; associated with TextOffset. It returns carry set (TRUE) if the; offset is not on the screen.****************************************************************OffsetToPoint	PROCNAME  Export;---------------------------------------------------------------	jsr  OffsetToVPos	bcc  @continue	rts@continue	brl  OffsetToHPos;---------------------------------------------------------------	ENDP****************************************************************; this routine returns the vertical position of the current TextOffset; associated with TextOffset. It returns carry set (TRUE) if the; offset is not on the screen. In this case TextVPos is the top; or bottom of the viewRect depending on how it is off the screen****************************************************************OffsetToVPos	PROCNAME  Export;---------------------------------------------------------------	jsr  IsOffsetCached	bne  @notCached	ldy  #TERecord.CachedSelcVPos	lda  [RecordPtr],y	sta  TextVPos	clc	rts;---------------------------------------------------------------@notCached	ldy  #TERecord.ViewRect.top	;start TextVPos at the top of the	lda  [RecordPtr],y		;..viewRect	sec	ldy  #TERecord.TopTextVPos	sbc  [RecordPtr],y	sta  TextVPos	ldy  #TERecord.TopTextOffset	jsr  GetRecordLong	cmpl TextOffset	beq  @quickExit	blt  findIt	ldy  #TERecord.ViewRect.top	lda  [RecordPtr],y	sta  TextVPos	sec		;set the carry to indicate the text is	rts		;..off the screen. Then return@quickExit	clc	rts;---------------------------------------------------------------findIt	ldy  TextOffset	sty  OriginalOffset	ldy  TextOffset+2	sty  OriginalOffset+2	stax TextOffset		;this is now the TopTextOffset	jsr  GetTextLength	stax TempLong	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	dey	dey;---------------------------------------------------------------@loop	sty  TempWord	lda  [TempPtr],y	bmi  @deleted	tax	dey	dey	lda  [TempPtr],y	clc	adc  TextOffset	sta  TextOffset	txa	adc  TextOffset+2	sta  TextOffset+2	iny	iny	iny	iny	lda  [TempPtr],y	sta  LineHeight	ldax TextOffset	cmp  TempLong	bne  @notAtEnd	cpx  TempLong+2	beq  atTheEnd@notAtEnd	cpx  OriginalOffset+2	blt  @continue	bne  foundIt	cmp  OriginalOffset	bgt  foundIt@continue	lda  LineHeight	clc	adc  TextVPos	ldy  #TERecord.ViewRect.bottom	;are we still in the viewRect ?	cmp  [RecordPtr],y	bpl  abortIt	sta  TextVPos@deleted	lda  TempWord	clc	adc  #SuperItemSize	tay	cpy  SuperMaxIndex	blt  @loop	jsr  MoveToNextHandle	;NOTE: we should never reach the end	ldy  #SuperBlock.RecordSize+2	;..here	bra  @loop;---------------------------------------------------------------atTheEnd	movl OriginalOffset,TextOffset	jsr  IsOffsetAtEnd	bne  @exit	ldy  #TERecord.LineAtEndFlag	lda  [RecordPtr],y	beq  foundIt	lda  TextVPos	clc	adc  LineHeight	sta  TextVPos@exit	clc	rts;---------------------------------------------------------------foundIt	clcexit	movl OriginalOffset,TextOffset	rts;---------------------------------------------------------------abortIt	lda  [RecordPtr],y	sta  TextVPos	sec		;the text is off the screen	bra  exit;---------------------------------------------------------------	ENDP****************************************************************OffsetToHPos	PROCNAME  Export;---------------------------------------------------------------	jsr  IsOffsetCached	bne  @notCached	ldy  #TERecord.CachedSelcHPos	lda  [RecordPtr],y	sta  TextHPos	clc	rts;---------------------------------------------------------------@notCached	jsr  IsOffsetAtEnd		;if the offset is not at the end then	bne  findIt		;..find the horizontal position	ldy  #TERecord.LineAtEndFlag	;if there is not a line at the end then	lda  [RecordPtr],y		;..we must also find the horizontal pos	beq  findIt	jsr  GetLeftIndent		;return the left indent adjusted by the	sta  TextHPos		;..justification	jsr  AdjustForJust	clc	adc  TextHPos	brl  addViewLeft;---------------------------------------------------------------findIt	jsr  setupLineStart		;set the line start and get the amount left	jsr  GetLeftEdge		;start at the left edge of the rectangle	sta  TextHPos	jsr  FindStyleInfo		;find the current style and setup the	jsr  SetupWidthTable	;..width table	bra  loopEnd;---------------------------------------------------------------mainLoop	jsr  FindStyleInfo		;find and install the current style info	jsr  GetSuperCount		;count how many characters are in the	cmp  AmountLeft		;..current style. If this is > 64k, $FFFF	bge  useLeft		;..will be returned.	sta  TextCount		;the amount left is greater than the count	lda  AmountLeft		;..in the current style, so reduce the amount	sec		;..left and use the current style count.	sbc  TextCount		;In this case we will need to loop back to	sta  AmountLeft		;..mainLoop eventually.	bra  widthStartuseLeft	lda  AmountLeft		;the current style extends at least to the offset	sta  TextCount		;..we are looking for.	stz  AmountLeft		;zero out our outer text counter;---------------------------------------------------------------widthStart	jsr  FindTextPtr		;setup the text pointer	lda  #0		;set the high word of A to zero	tax		;also clear the index (X-Reg)	shortm		;short mode for speedwidthLoop	txy	lda  [TextPtr],y		;get the character	cmp  #TAB		;is it a TAB ?	beq  doTab	tay		;nope, so use the char as an index into	lda  [WidthTablePtr],y	;..the width table. Add the width of the	clc		;..character to the current horz position	adc  TextHPos	sta  TextHPos	bcc  nextChar	inc  TextHPos+1		;we are in short mode, so take care of thenextChar	inx		;..high BYTE !	cpx  TextCount	blt  widthLoop	longm		;back to long mode	lda  TextCount		;move TextOffset past the characters	addl TextOffset		;..we just processed.loopEnd	lda  AmountLeft		;are there any more "parts" to process ?	bne  mainLoop		;..yep = go back to the main loop	bra  foundChar		;Nope, we found our character - goto foundChar;---------------------------------------------------------------doTab	rep  #$20		;goto long mode for Tab processing	jsr  MoveOverTab	sta  TextHPos		;store the new HPos	lda  #0		;clear the high word of the A-Reg again	sep  #$20		;set the processor to short mode	bra  nextChar		;back to short mode and off to the next char;---------------------------------------------------------------foundChar	jsr  AdjustForJust	clc	adc  TextHPos	sta  TextHPos	lda  FixExtraSpace		;if no fractional adjustment then we are	ora  FixExtraSpace+2	;..done	beq  skipAdjust	jsr  setupLineStart		;set the line start and get the amount left	jsr  FindTextPtr	ldx  #0	ldy  AmountLeft	beq  skipAdjust	shortm@loop	dey	beq  @done	lda  [TextPtr],y	cmp  #' '	bne  @nope	inx@nope	cmp  #TAB	bne  @loop@done	longm	PushLongSpace		;space for the multiply	PushZLong FixExtraSpace	;the fractional pixel amount for spaces	phx		;the number of spaces	pea  $0000	_FixMul	plx		;discard the fraction	pla		;the carry will be set if X > $8000 and	cpx  #$8000		;..clr if less than $8000. This rounds	adc  TextHPos		;..the fraction into the nearest integer	sta  TextHPos	lda  AmountLeft		;restore TextOffset	addl TextOffsetskipAdjust	jsr  FreeWidthTable	lda  TextHPosaddViewLeft	clc	ldy  #TERecord.ViewRect.left	adc  [RecordPtr],y	sta  TextHPos	clc		;%%% Test	rts;---------------------------------------------------------------;---------------------------------------------------------------setupLineStart	jsr  FindLineInfo	lda  TextOffset	sec	sbc  SuperStart	sta  AmountLeft		;this is our outer text counter	movl SuperStart,TextOffset	rts;---------------------------------------------------------------	ENDP***************************************************************** This routine takes TextVPos and TextHPos as a point and it* returns the corresponding TextOffset. The point must be in the* view rect. on exit TextHPos and TextVPos are at the begining* of the character that the point was on.****************************************************************PointToOffset	PROCNAME  Export;---------------------------------------------------------------	jsr  VPosToOffset	bcs  done	jsr  HPosToOffset	clcdone	rts;---------------------------------------------------------------	ENDP****************************************************************VPosToOffset	PROCNAME  Export;---------------------------------------------------------------	mov  TextVPos,OriginalVPos	ldy  #TERecord.ViewRect.top	;start TextVPos at the top of the	lda  [RecordPtr],y		;..viewRect	sec	ldy  #TERecord.TopTextVPos	sbc  [RecordPtr],y	sta  TextVPos	jsr  GetScreenTopOffset	bra  loopEnd;---------------------------------------------------------------mainLoop	jsr  FindLineInfo	lda  LineHeight	clc	adc  TextVPos	cmp  OriginalVPos	beq  @1	bpl  foundIt@1	sta  TextVPos	jsr  MoveOffsetToNextItemloopEnd	jsr  IsOffsetAtEnd	bne  mainLoop;---------------------------------------------------------------atTheEnd	sec	rtsfoundIt	clc	rts;---------------------------------------------------------------	ENDP****************************************************************HPosToOffset	PROCNAME  Export;---------------------------------------------------------------	jsr  FindLineStart	jsr  GetSuperCount		;find the length of the line ($FFFF max)	sta  AmountLeft	jsr  FindStyleInfo		;find the current style and setup the	jsr  SetupWidthTable	;..width table	ldy  #TERecord.ViewRect.left	;save the original HPos and set the new	lda  TextHPos		;..one to the left edge of the line.	sec	sbc  [RecordPtr],y	sta  OriginalHPos	jsr  GetLeftEdge	sta  FixedHPos+2		;Note: the HPos is beging kept track of	stz  FixedHPos		;..as a fixed value, for full just.	stzl FixExtraSpace		;the extra amount for each space under full just	jsr  AdjustForJust		;if the just is not left, then adjust	clc		;..HPos for it.	adc  FixedHPos+2	sta  FixedHPos+2;---------------------------------------------------------------mainLoop	jsr  FindStyleInfo		;find and install the current style info	jsr  GetSuperCount		;count how many characters are in the	cmp  AmountLeft		;..current style. If this is > 64k, $FFFF	bge  useLeft		;..will be returned.	sta  TextCount		;the amount left is greater than the count	lda  AmountLeft		;..in the current style, so reduce the amount	sec		;..left and use the current style count.	sbc  TextCount		;In this case we will need to loop back to	sta  AmountLeft		;..mainLoop eventually.	bra  widthStartuseLeft	lda  AmountLeft		;the current style extends at least to the offset	sta  TextCount		;..we are looking for.	stz  AmountLeft		;zero out our outer text counter;---------------------------------------------------------------widthStart	jsr  FindTextPtr		;setup the text pointer	ldx  #0		;set the index to zerowidthLoop	txy	lda  [TextPtr],y		;get the next character	and  #$00FF	cmp  #TAB		;is it a TAB ?	beql doTab	cmp  #CR		;is it a carriage return ?	beql foundChar2backToLoop	cmp  #' '		;is it a space ?	beq  doSpace	tay		;it's something else so find the width of	lda  [WidthTablePtr],y	;..it from the table	and  #$00FFuseWidth	pha		;save the width of the character	lsr  a		;see if the point is within the first half	clc		;..of the character. If it is then we	adc  FixedHPos+2		;..have found the offset.	cmp  OriginalHPos	bpll foundChar	pla		;get back the entire width.	clc		;add it to the current Horz Position	adc  FixedHPos+2	sta  FixedHPos+2nextChar	inx		;move to the next character and loop back	cpx  TextCount	blt  widthLoop	lda  TextCount		;move TextOffset past the characters	addl TextOffset		;..we just processed.	lda  AmountLeft		;are there any more "parts" to process ?	bne  mainLoop		;..yep = go back to the main loop	lda  TextOffset		;move back before the last character on	ora  TextOffset+2		;..the line, unless the last character	beq  @1		;..is not a word wrap	decl TextOffset	jsr  FindTextPtr	lda  [TextPtr]	jsr  IsItAWordWrap	bcs  @1	incl TextOffset@1	brl  foundChar3;---------------------------------------------------------------doSpace	tay		;get the space into the Y-Reg	lda  [WidthTablePtr],y	;get the standard width of the space	and  #$00FF		;..add to the extra amount for full just.	clc		;..this will be zero if we are not full	adc  FixExtraSpace+2	;..justifaction.	pha	lsr  a		;take half of this and see if we are in	sta  TempWord		;..the current char,	lda  FixExtraSpace		;the width is being added as a fixed point	ror  a		;..number	clc	adc  FixedHPos	bcc  @noInc	inc  TempWord@noInc	lda  TempWord	adc  FixedHPos+2	cmp  OriginalHPos		;are we within the current char ? Yes = 	bpl  foundChar		;..we have found the char.	lda  FixExtraSpace		;nope, so add the full width of the space	clc		;..as a fixed point value to the current	adc  FixedHPos		;..HPos.	sta  FixedHPos	pla	adc  FixedHPos+2	sta  FixedHPos+2	bra  nextChar		;loop back to the next char.;---------------------------------------------------------------doTab	PushZLong TextOffset	;save text offset	txa	inc  a	addl TextOffset	jsr  MoveOverTab	sec	sbc  FixedHPos+2	phx		;save our index	pha	jsr  AdjustForJust	clc	adc  1,s	plx		;pull off garbage	plx		;restore our index	ply		;restore text offset	sty  TextOffset	ply	sty  TextOffset+2	brl  useWidth;---------------------------------------------------------------foundChar	plafoundChar2	txa	addl TextOffsetfoundChar3	ldy  #TERecord.ViewRect.left	lda  [RecordPtr],y	clc	adc  FixedHPos+2	ldx  FixedHPos		;round the fixed part off into a whole	bpl  @skipInc		;..number	inc  a@skipInc	sta  TextHPos		;same as FixedHPos	brl  FreeWidthTable		;unlock the width table;---------------------------------------------------------------	ENDP****************************************************************AdjustForJust	PROCNAME  Export;---------------------------------------------------------------	stzl FixExtraSpace		;clear the extra space field	lda  #0	tax	ldy  #GrafPort.SpExtra	jsr  SetPortLong	jsr  GetJust		;if the justifaction is left, then skip	cmp  #leftJust		;..this call	beq  @quickExit	jsr  IsThereAnotherTab	;if there are more tabs on the line, then	bcc  mustAdjust		;..this field is leftJust. Otherwise, adjust@quickExit	lda  #0	rts;---------------------------------------------------------------mustAdjust	PushZWord LineLength	;save the line length, the text offset,	PushZLong TextOffset	;..the horizontal position, the text	PushZWord TextCount		;..count and the text pointer	PushZLong TextPtr	PushZWord LineHeight	PushZWord LineAscent	PushZWord TextHPos	jsr  IsOffsetAtEnd		;if the offset is not at the end then	bne  @notAtEnd		;..find the horizontal position	ldy  #TERecord.LineAtEndFlag	;if there is not a line at the end then	lda  [RecordPtr],y		;..we must also find the horizontal pos	beq  @notAtEnd	stz  LineLength	bra  @skipLength@notAtEnd	jsr  FindLineStart		;start at the beginning of the line	mov  SuperLength,LineLength	;save the line length@skipLength	jsr  GetLeftEdge		;start measuring from the left edge of the	sta  TextHPos		;..text rectangle	PushZLong TextOffset	;save the new text offset	lda  LineLength		;are there any characters on this line ?	beq  @done		;..if not, then we are thru	dec  a		;there are so find the end of the line	addl TextOffset		;..and get a pointer to there	jsr  FindTextPtr	lda  [TextPtr]		;is the last character a CR ? If not,	and  #$00FF		;..then strip off white space	cmp  #CR	bne  @loop	dec  LineLength		;it was a CR, so make sure we skip the	bra  @done		;..CR and we are done@loop	lda  [TextPtr]		;decrement LineLength so it doesn't reflect	jsr  IsItAWordWrap		;..any of the extra whitespace on the line	bcc  @done	decl TextPtr	dec  LineLength	bne  @loop@done	PullLong TextOffset		;restore TextOffset	mov  LineLength,LastLineLength	jsr  FindStyleInfo		;find the current style and setup the	jsr  SetupWidthTable	;..width table;---------------------------------------------------------------mainLoop	lda  LineLength		;if there are zero chars left to measure	beq  foundEnd		;..we are done	jsr  FindStyleInfo	jsr  GetSuperCount	cmp  LineLength	blt  @1	lda  LineLength@1	sta  TextCount	jsr  FindTextPtr	lda  #0		;clear the high byte of A	tax		;clear X (out index) also	shortm		;go into short mode for speedwidthLoop	txy	lda  [TextPtr],y	cmp  #TAB	beq  @foundTab	tay	lda  [WidthTablePtr],y	clc	adc  TextHPos	sta  TextHPos	bcc  @1	inc  TextHPos+1@1	inx	cpx  TextCount	blt  widthLoop	longm		;back to long mode here	txa	addl TextOffset	lda  LineLength	sec	sbc  TextCount	sta  LineLength	bra  mainLoop@foundTab	longm		;back to long mode.	inx	stx  TextCount	txa	addl TextOffset	lda  LineLength	sec	sbc  TextCount	sta  LineLength	sta  LastLineLength	jsr  MoveOverTab		;move TextHPos over the TAB	sta  TextHPos	bra  mainLoop;---------------------------------------------------------------foundEnd	jsr  FreeWidthTable	lda  TextHPos		;copy our ending position to TempWord	sta  TempWord	pla		;restore TextHPos	sta  TextHPos	jsr  GetJust		;get the just and push it on the stack	pha	jsr  GetRightMargin		;take the right edge and subtract the end	sec		;..of the line to determine how many pixels	sbc  TempWord		;..are left on the line. Leave it in A-Reg	plx		;restore the just into X-Reg	cpx  #rightJust	beq  doRight	cpx  #fullJust	beq  doFull;---------------------------------------------------------------doCenter	cmp  #$8000		;this sets the carry properly for the	ror  a		;..shift right;---------------------------------------------------------------doRight	plx		;restore the saved line height and ascent	stx  LineAscent	plx	stx  LineHeight	plx		;restore the saved text pointer	stx  TextPtr	plx	stx  TextPtr+2	plx	stx  TextCount	plx		;restore the saved text offset	stx  TextOffset	plx	stx  TextOffset+2	plx	stx  LineLength	rts;---------------------------------------------------------------doFull	pha		;save the amount of whitespace for divide	lda  LastLineLength	beq  @noAdjustment	jsr  IsOffsetAtEnd	beq  @noAdjustment	jsr  FindTextPtr	lda  [TextPtr]	and  #$00FF	cmp  #CR	beq  @noAdjustment	jsr  FindLineInfo	lda  SuperStart	clc	adc  SuperLength	tax	lda  SuperStart+2	adc  SuperLength+2	ldy  #TERecord.TextLength+2	cmp  [RecordPtr],y	bne  @notAtEnd	dey	dey	txa	cmp  [RecordPtr],y	beq  @noAdjustment@notAtEnd	lda  TextOffset	sec	sbc  LastLineLength	sta  TextOffset	bcs  @1	dec  TextOffset+2@1	jsr  FindTextPtr	ldy  LastLineLength	ldx  #0	shortm@loop	dey	cpy  #$FFFF	beq  @done	lda  [TextPtr],y	cmp  #' '	bne  @loop	inx	bra  @loop@done	longm	cpx  #0		;if no spaces then there is no adjustment	beq  @noAdjustment	pla		;get back the amount of whitespace and	PushLongSpace		;..divide by the number of spaces to find	pha		;..the spaceExtra	phx	_FixRatio	ldy  #GrafPort.SpExtra	;set both the spaceExtra field of the	pla		;..grafPort and the variable FixExtraSpace	sta  FixExtraSpace	sta  [DrawPortPtr],y	iny	iny	lda  1,s		;leave a word on the stack so noAdjustment	sta  FixExtraSpace+2	;..can take it off	sta  [DrawPortPtr],y@noAdjustment	pla		;restore the stack	lda  #0		;return an adjustment of zero	brl  doRight;---------------------------------------------------------------	ENDP****************************************************************IsThereAnotherTab	PROCNAME  Entry;---------------------------------------------------------------	PushZLong TextPtr		;save text pointer	jsr  FindTextPtr	jsr  FindLineInfo	jsr  GetSuperCount	tax	shortm@loop	txy	lda  [TextPtr],y	cmp  #TAB	beq  foundOne	dex	bpl  @loop	clc	bra  exit;---------------------------------------------------------------foundOne	sec;---------------------------------------------------------------exit	longm	PullLong TextPtr	rts;---------------------------------------------------------------	ENDP****************************************************************MoveOverTab	PROCNAME  Export;---------------------------------------------------------------	phx		;save X-Reg	jsr  GetTabType		;what kind of tabs do we have here ?	cmp  #noTabs		;noTabs = use the width of a space	beq  useSpace	cmp  #equalTabs		;equalTabs = move to the next evenly spaced	beq  doEvenTabs		;..tab stop;---------------------------------------------------------------doTabList	jsr  GetTabPtr		;must be a list then - get a ptr to the tab list	ldy  #2		;skip the tab kind and start with the data@loop	lda  [TempPtr],y		;get the next tab stop (MUST BE ASCENDING !)	iny		;move our index to the next tab stop's data	iny	iny	iny	cmp  TextHPos		;are we past our current HPos yet ?	bmi  @loop		;..nope, so loop	beq  @loop	cmp  #$FFFF		;if we are at the end, then use a space	bne  foundNewPos		;..otherwise, exit with the new position;---------------------------------------------------------------useSpace	ldy  #' '		;get the width of a space	lda  [WidthTablePtr],y	;..the width table.	and  #$00FF	clc	adc  TextHPos	bra  foundNewPos;---------------------------------------------------------------doEvenTabs	jsr  GetTabNumber		;get the number of pixels for each tab	sta  TempWord		;save it temporarily	lda  #0@clear	clc		;find the first tab that is to the right@loop	adc  TempWord		;..of the current HPos	cmp  TextHPos	bcc  @loop		;fast loop	beq  @clear		;slow loop (extra 2 cycles);---------------------------------------------------------------foundNewPos	plx		;restore X-Reg	rts;---------------------------------------------------------------	ENDP****************************************************************	END