************************************************************************                      GSTextEdit  Version 1.0*                        File: highlevel.aii**               Copyright Apple Computer, Inc. 1988-89,92*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.** 8/8/90	Mensch* Fixed bug in common style record stuff in GetSelectionStyle. This should now* produce a proper style record** 4-Oct-90	Dave Lyons** Rolled version to $8103.** Fixed a problem in TEScroll doTopOffset where we were sometimes clipping the* character position to the end of the text even if we had a valid position.** The bad case was when the high word of the position was smaller than the high* word of the maximum allowed position (the end of the text)--then it went ahead* and compared the low words to see if we were too big!  Added a single BNE to* fix it.** 28-Jan-92	Dave Lyons** Fixed error-exit path in TEInsert, where it was leaving 4 bytes on the stack* and crashing (when you run out of memory).  (This was crashing Monte's* VolTest application.)** Fixed a hanging bug in TEScroll.  Verb 1 was hanging when you scrolled* forwards to a character position that didn't fall on the beginning of* a line.************************************************************************* 17-Jun-92	Dave Lyons (6.0.1d6)** Version $8104.** FMStatus call pushes zero result space in case Font Manager isn't* even loaded.***********************************************************************	INCLUDE  'GlobalIncludes'DaveStatus	equ  33****************************************************************TECallTable	PROC  EXPORTTheStart	dc.l (TheEnd-TheStart)/4	dc.l TEBootInit-1		; call $01	dc.l TEStartup-1		; call $02	dc.l TEShutdown-1		; call $03	dc.l TEVersion-1		; call $04	dc.l TEReset-1		; call $05	dc.l TEStatus-1		; call $06	dc.l NullRoutine-1		; call $07	dc.l NullRoutine-1		; call $08	dc.l TENew-1		; call $09	dc.l TEKill-1		; call $0A	dc.l TESetText-1		; call $0B	dc.l TEGetText-1		; call $0C	dc.l TEGetTextInfo-1	; call $0D	dc.l TEIdle-1		; call $0E	dc.l TEActivate-1		; call $0F	dc.l TEDeactivate-1		; call $10	dc.l TEClick-1		; call $11	dc.l TEUpdate-1		; call $12	dc.l TEPaintText-1		; call $13	dc.l TEKey-1		; call $14	dc.l TEUndo-1		; call $15	dc.l TECut-1		; call $16	dc.l TECopy-1		; call $17	dc.l TEPaste-1		; call $18	dc.l TEClear-1		; call $19	dc.l TEInsert-1		; call $1A	dc.l TEReplace-1		; call $1B	dc.l TEGetSelection-1	; call $1C	dc.l TESetSelection-1	; call $1D	dc.l TEGetSelectionStyle-1	; call $1E	dc.l TEStyleChange-1	; call $1F	dc.l TEOffsetToPoint-1	; call $20	dc.l TEPointToOffset-1	; call $21	dc.l TEGetDefProc-1		; call $22	dc.l TEGetRuler-1		; call $23	dc.l TESetRuler-1		; call $24	dc.l TEScroll-1		; call $25	dc.l TEGetInternalProc-1	; call $26	dc.l TEGetLastError-1	; call $27	dc.l TECompactRecord-1	; call $28TheEnd	ENDP****************************************************************TEBootInit	PROC  EXPORT	EXPORT TEResetTEReset	EXPORT NullRoutineNullRoutine	lda  #0	clc	rtl	ENDP****************************************************************TEStartUp	PROCNAME  Export;---------------------------------------------------------------	DefineStackOrigD	wordRTL1	block 3RTL2	block 3InputDPage	wordInputUserID	word;---------------------------------------------------------------;---------------------------------------------------------------	jsl  IncBusyFlg		;increment the busy flag	phd		;save the original direct page.	ldx  #teAlreadyStarted	dec  a		;check the WAP. if it is not zero, we	inc  a		;..are already started, so return error.	bne  error2	lda  InputDpage,s		;set the direct page and the WAP	tcd	jsr  SetTheWAP	lda  InputUserID,s		;set the userID	sta  UserID;;;	PushWordSpace		;make sure the font manager is started	pea 0		;17-Jun-92 DAL -- in case FM isn't even loaded	_FMStatus	ldx  #teNeedsTools	pla	beq  error1	PushLongSpace	PushWord #0		;system toolset	PushWord #$04		;toolset number for quickdraw	_GetWAP	PullAX	sta  QDDirectPage		;cache quickdraw's direct page	lda  #8*1024		;make sure we have enough memory	jsr  GetSmallHandle	bcc  allOK;---------------------------------------------------------------error1	phx	lda  #0		;set the WAP to zero	jsr  SetTheWAP	plxerror2	brl  allDone;---------------------------------------------------------------allOK	jsr  KillHandle	ldax #GrafPort.RecordSize	ldy  #$C000		;locked and fixed	jsr  GetSpecialHandle	jsr  DerefAX	stax DrawPortPtr	jsr  GetPort		;save the current port	PushZLong DrawPortPtr	_OpenPort	ldy  #GrafPort.ClipRgn	;copy the clip region into the visRgn	jsr  GetPortLong		;..so we don't have to worry about	PushAX		;..clipping	ldy  #GrafPort.VisRgn	jsr  GetPortLong	PushAX	_CopyRgn	jsr  SetPort		;restore the current port	ldy  #GrafPort.FontFlags	;set the text drawing to use full dithered	lda  #%0000000000000100	;..patterns	sta  [DrawPortPtr],y	ldy  #GrafPort.Width	;get the starting handle for the offscreen	lda  [DrawPortPtr],y	;..buffer	jsr  GetSmallHandle	stax DataBufferHandle	ldax #2		;size of two	ldy  #$0300		;attributes of purgable	jsr  GetSpecialHandle	stax WidthTableHandle	PushAX	_PurgeHandle		;start with this purged	stz  WidthTableDepth	lda  #2		;start the offset at two	sta  WidthTableOffset	ldax #4		;size of two	ldy  #$0010		;attributes of no bank cross	jsr  GetSpecialHandle	stax PPToPortCodeHandle	jsr  clearSizeField		;clear the size fields to start with	ldax #4		;size of two	ldy  #$0010		;attributes of no bank cross	jsr  GetSpecialHandle	stax ScrollCodeHandle	jsr  clearSizeField		;clear the size fields to start with	stzl RecordInUse		;clear the in use variables	stz  SuperInUse;---------------------------------------------------------------	ldx  #0		;no error codeallDone	lda  7,s		;move 8 bytes on the stack over the input	sta  11,s	lda  5,s	sta  9,s	lda  3,s	sta  7,s	lda  1,s	sta  5,s	pla		;pull off four bytes of garbage	pla	phb		;save the data bank	brl  QuickExit;---------------------------------------------------------------;---------------------------------------------------------------clearSizeField	jsr  DerefAX		;clear the size fields to start with	stax TempPtr	ldy  #2	lda  #0	sta  [TempPtr]	sta  [TempPtr],y	rts;---------------------------------------------------------------	ENDP****************************************************************TEShutDown	PROCNAME  Export;---------------------------------------------------------------	ldy  #0	jsr  QuickEntry		;setup the TE direct page and the busy flag	lda  #0		;set the WAP to zero	jsr  SetTheWAP	PushZLong DrawPortPtr	;close the offscreen grafPort	_ClosePort	PushLongSpace		;dispose of the offscreen grafPort	PushZLong DrawPortPtr	_FindHandle	PullAX	jsr  KillHandle	ldax DataBufferHandle	;kill the offscreen buffer	jsr  KillHandle	ldax WidthTableHandle	;kill the width table handle	jsr  KillHandle	ldax PPToPortCodeHandle	;kill the pptoport code handle	jsr  KillHandle	ldax ScrollCodeHandle	;kill the scroll code handle	jsr  KillHandle	ldx  #0	brl  QuickExit;---------------------------------------------------------------	ENDP****************************************************************TEVersion	PROCNAME  Export;---------------------------------------------------------------	DefineStackRTL1	block 3RTL2	block 3output	word;---------------------------------------------------------------	lda  #TEVersionNumber	sta  output,s	brl  NullRoutine;---------------------------------------------------------------	ENDP****************************************************************TEStatus	PROCNAME  Export;---------------------------------------------------------------	DefineStackRTL1	block 3RTL2	block 3output	word;---------------------------------------------------------------	ldx  #FALSE		;return $0000 if not started up	cmp  #0	beq  notStarted          IF FinalRelease <> 0 THEN	ldx  #TRUE          ELSE	ldx  #DaveStatus          ENDIFnotStarted	txa	sta  output,s	brl  NullRoutine;---------------------------------------------------------------	ENDP****************************************************************TENew	PROCNAME  Export;---------------------------------------------------------------	DefineStackorigB	byteorigD	wordRTL1	block 3RTL2	block 3result	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4		;number of parameters	jsr  QuickEntry		;setup the TE direct page and the busy flag	movl ParameterSpace,ParameterPtr	;copy the input to the parameter pointer	ldy  #TEParam.textFlags+2	;check to see if the record is a control	lda  [ParameterPtr],y	;..or not	and  #fNotControl	beq  doControl	jsr  FakeNewControl	bra  setIt;---------------------------------------------------------------doControl	PushLongSpace	jsr  GetPort		;push a pointer to the current port	PushWord  #0		;single pointer verb	PushZLong ParameterPtr	_NewControl2;---------------------------------------------------------------setIt	bcs  error	pla	plx	sta  result,s	sta  RecordHandle	txa	sta  result+2,s	sta  RecordHandle+2	jsr  DerefRecordHandle	ldy  #TERecord.LastErrorCode	;return the error from the defProc	lda  [RecordPtr],y	tax	beq  @noError	phx	ldax RecordHandle	jsr  KillControl	plx@noError	brl  QuickExit;---------------------------------------------------------------error	tax	pla	pla	brl  QuickExit;---------------------------------------------------------------	ENDP****************************************************************TEKill	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry		;setup the TE direct page and the busy f.	jsr  GetTEHighFlags		;check to see if the record is a control	and  #fNotControl		;..or not	beq  doControl;---------------------------------------------------------------	lda  #0		;pass nothing for the parameters	tax	ldy  #dispCtl		;the message is dispose	jsr  CallDefProc	jsr  UnlockRecordHandle	ldax RecordHandle		;kill the main record handle	jsr  KillHandle	bra  done		;return the error from kill handle;---------------------------------------------------------------doControl	jsr  UnlockRecordHandle	ldax RecordHandle		;dispose of the TE control.	jsr  KillControl;---------------------------------------------------------------done	sta  0		;return the error from DisposeControl	PullAX		;pull off the saved origin	jsr  SetPort	ldx  0		;we are using $00 as scratch space	brl  QuickExit;---------------------------------------------------------------	ENDP****************************************************************TESetText	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longxInputStyleRef	longxInputStyleVerb	wordxInputTextLength	longxInputTextRef	longxInputTextVerb	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #20	jsr  StandardEntry		;setup the TE direct page and the busy f.	jsr  KillBlockList		;destroy the block list and get a fresh	jsr  NewBlockList		;..one	ldy  #TERecord.StyleSuper	;kill the old style super array and get a	jsr  KillSuperHandle	;..new one	ldy  #TERecord.StyleSuper	jsr  GetNewSuperHandle	jsr  SetInitialTextAndStyle	;return the error code from this routine	bcs  exit	jsr  GetViewRect		;redraw the viewRect	jsr  CopyTempToDrawRect	jsr  DoDraw	ldx  #0		;no errorexit	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEGetText	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longxOutputStyleRef	longxOutputStyleVerb	wordxBufferLength	longxBufferRef	longxBufferVerb	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #20	jsr  StandardEntry		;setup the TE direct page and the busy f.	jsr  GetTextLength		;return the total text size	sta  ReturnSpace,s	txa	sta  ReturnSpace+2,s	jsr  ExtractText	bcs  exit		;if got an error, then exit	jsr  ExtractStylesexit	brl  StandardExit		;the X-Reg will be set by ExtractStyles;---------------------------------------------------------------	ENDP****************************************************************TEGetTextInfo	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longbufferCount	wordbufferPtr	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #10	jsr  StandardEntry		;setup the TE direct page and the busy f.	inc  bufferCount	jsr  decBufferCount;---------------------------------------------------------------doCharCount	jsr  GetTextLength		;set the character count field	ldy  #TEInfoRecord.charCount	jsr  setBufferLong	jsr  decBufferCount;---------------------------------------------------------------doLineCount	ldy  #TERecord.LineSuper	;set the line count field	jsr  CountSuperItems	ldy  #TEInfoRecord.lineCount	jsr  setBufferLong	jsr  decBufferCount;---------------------------------------------------------------doFormat	jsr  GetStyleRecordSize	;set the format memory needed field		ldy  #TEInfoRecord.formatMemory	jsr  setBufferLong	jsr  decBufferCount;---------------------------------------------------------------doTotal	lda  #TERecord.RecordSize+1	;add an extra one for the input handle	sta  MoveLength		;..field in the record. (it's size is	stz  MoveLength+2		;..always one)	jsr  GetVertScrollBar	beq  @skip1	PushAX	jsr  GetHandleSize	jsr  addToMoveLength@skip1	ldy  #TERecord.LineSuper	jsr  CalculateSuperSize	jsr  addToMoveLength	ldy  #TERecord.StyleSuper	jsr  CalculateSuperSize	jsr  addToMoveLength	jsr  CachedBlockToPtr	;set TempPtr to our current block@loop1	jsr  MoveToPrevBlock	;move back to the first block	bcc  @loop1	@loop2	PushZLong BlockHandle	jsr  GetHandleSize	jsr  addToMoveLength	jsr  MoveToNextBlock	bcc  @loop2	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  GetHandleSize	jsr  addToMoveLength	ldy  #TERecord.RulerList	jsr  PushRecordLong	jsr  GetHandleSize	jsr  addToMoveLength	ldax MoveLength	ldy  #TEInfoRecord.totalMemory	jsr  setBufferLong	jsr  decBufferCount;---------------------------------------------------------------doStyleCount	ldy  #TERecord.StyleList	jsr  GetRecordLong	PushAX	jsr  GetHandleSize	PushLongSpace	PushLongSpace	PushAX	PushLong #TEStyle.RecordSize	_LongDivide	PullAX	ply		;pull garbage	ply	ldy  #TEInfoRecord.styleCount	jsr  setBufferLong	jsr  decBufferCount;---------------------------------------------------------------doRulerCount	lda  #1		;set the ruler count field to one	ldy  #TEInfoRecord.rulerCount	sta  [bufferPtr],y	iny	iny	dec  a	sta  [bufferPtr],y	jsr  decBufferCount;---------------------------------------------------------------	ldx  #teInvalidPCount	;if there are still more params, return an error;---------------------------------------------------------------exit	brl  StandardExit;---------------------------------------------------------------;---------------------------------------------------------------decBufferCount	dec  bufferCount	beq  @atEnd	rts@atEnd	pla	ldx  #0	bra  exit;---------------------------------------------------------------setBufferLong	sta  [bufferPtr],y	iny	iny	txa	sta  [bufferPtr],y	rts;---------------------------------------------------------------addToMoveLength	clc	adc  MoveLength	sta  MoveLength	txa	adc  MoveLength+2	sta  MoveLength+2	rts;---------------------------------------------------------------	ENDP****************************************************************TEIdle	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	jsr  DoIdleEvent	ldx  #0	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEActivate	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	jsr  MakeControlActive	ldx  #0	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEDeactivate	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	and  #ÅfCtlTarget	sta  [RecordPtr],y	lda  #0		;pass zero for the parameters	tax	ldy  #ctlChangeActivity	;the message is change activity	jsr  CallDefProc	ldx  #0	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEClick	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longxTheEventPtr	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #8	jsr  StandardEntry	jsr  AreWeInvisible		;if invisible, then exit	bne  exit	ldy  #EventRecord.where	lda  [TheEventPtr],y	sta  TempLong	iny	iny	lda  [TheEventPtr],y	sta  TempLong+2	PushZPtr TempLong		;convert the point to local coordinates	_GlobalToLocal	ldax TempLong		;pass the point in local coordinates	ldy  #testCtl		;the message is test	jsr  CallDefProc	ldy  #dragCtl		;pass the part code that was returned	jsr  CallDefProc		;the message is dragexit	ldx  #0		;no error	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEUpdate	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	ldy  #TERecord.SelectionActive	lda  [RecordPtr],y	tax	lda  #0	ldy  #drawCtl		;the message is draw	jsr  CallDefProc	ldx  #0		;no error	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEPaintText	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longpaintFlags	wordtheRectPtr	longstartingLine	longtheGrafPort	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #18	jsr  StandardEntry		;setup the TE direct page and the busy f.	PushZLong theGrafPort	jsr  SetPort	jsr  GetNewRgn	PushAX		;save one copy for the dispose	PushAX		;save one copy for the setClip	PushAX	_GetClip	jsr  GetNewRgn	PushAX		;save one copy for the dispose	PushAX		;save one copy for the sectRgn	PushAX		;save one copy for the rectRgn	PushZLong theRectPtr	_RectRgn	PushLongSpace		;combine with the original clipping rgn	_GetClipHandle	lda  3,s		;leave the result in the original clip	pha		;..rgn	lda  3,s	pha	_SectRgn	jsr  KillRgn		;dispose of the temporary region;---------------------------------------------------------------	ldy  #TERecord.LineSuper	jsr  ClearSuperCache	stzl TextOffset	stzl TheLineNumber@loop	jsr  IsOffsetAtEnd	beq  foundEnd	lda  TheLineNumber	cmp  startingLine	bne  @1	lda  TheLineNumber+2	cmp  startingLine+2	beq  foundFirst@1	ldy  #TERecord.LineSuper	jsr  FindSuperInfo	jsr  MoveOffsetToNextItem	incl TheLineNumber	bra  @loop;---------------------------------------------------------------foundEnd	_SetClip		;restore the original clipping region	jsr  KillRgn		;dispose of the temporary region	lda  #$FFFF		;return line number $FFFF FFFF	sta  ReturnSpace,s	sta  ReturnSpace+2,s	ldx  #teInvalidLine	brl  allDone;---------------------------------------------------------------*** 2-Feb-93 JCM - Hacked fix for GS+'s full justification bug report. I'll spend time making this***                right for 6.1, but for now this works.foundFirst	pei  DrawPortPtr+2	pei  DrawPortPtr		lda  theGrafPort	sta  DrawPortPtr	lda  theGrafPort+2	sta  DrawPortPtr+2*** End 2-Feb-93 JCM	ldy  #Rect.top	lda  [theRectPtr],y	sta  TextVPos;---------------------------------------------------------------mainLoop	jsr  FindLineInfo	lda  TextVPos	clc	adc  LineHeight	tax	ldy  #Rect.bottom	cmp  [theRectPtr],y	ble  @notTheLast	lda  paintFlags	and  #fPartialLine	beq  cleanup@notTheLast	lda  SuperStart	clc	adc  SuperLength	pha	lda  SuperStart+2	adc  SuperLength+2	pha	phx	jsr  PaintLine	pla	sta  TextVPos	pla	sta  TextOffset+2	pla	sta  TextOffset	lda  TextVPos	ldy  #Rect.bottom	cmp  [theRectPtr],y	bge  cleanup	jsr  IsOffsetAtEnd	bne  mainLoop	lda  #$FFFF	sta  TheLineNumber	sta  TheLineNumber+2;---------------------------------------------------------------*** 2-Feb-93 JCM - Hacked fix for GS+'s full justification bug report. I'll spend time making this***                right for 6.1, but for now this works.cleanup	pla	sta  DrawPortPtr	pla	sta  DrawPortPtr+2	*** End - 2-Feb-93 JCM		_SetClip		;restore the original clipping region	jsr  KillRgn		;dispose of the temporary region	lda  TheLineNumber	sta  ReturnSpace,s	lda  TheLineNumber+2	sta  ReturnSpace+2,s	ldx  #0		;no errorallDone	phx	jsr  SetWindowPort	plx	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEKey	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longxTheEventPtr	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #8	jsr  StandardEntry	jsr  GetTEHighFlags		;should we be selecting text ? If not,	and  #fDisableSelection	;..then we can't take keys either	bne  exit	jsr  DoKeystrokeexit	ldx  #0		;no error	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEUndo	PROCNAME  Export	ldy  #0		;number of parameters	jsr  StandardEntry; ###################################################################################; ##############################  insert routine here  ##############################; ###################################################################################	ldx  #0		;no error	brl  StandardExit	ENDP****************************************************************TECut	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	jsr  CutGuts		;this will set the X-Reg	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TECopy	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	jsr  CopyGuts		;this will set the X-Reg	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEPaste	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	jsr  PasteGuts		;this will set the X-Reg	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEClear	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #4	jsr  StandardEntry	jsr  ClearGuts		;this will set the X-Reg	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEInsert	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longxInputStyleRef	longxInputStyleVerb	wordxInputTextLength	longxInputTextRef	longxInputTextVerb	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #20	jsr  StandardEntry	jsr  UnhilightSelection	jsr  GetSelectionLength	PushAX		;save the original selection length	jsr  SetSelectionEnd	;make the selection a caret	jsr  TranslateInputVerbs	bcs  error2	jsr  ReplaceText	bcs  error1	jsr  ReleaseInputVerbs	jsr  UnhilightSelection	jsr  GetSelectionStart	ldax TextOffset		;set the new anchor point	ldy  #TERecord.AnchorPoint	jsr  SetRecordLong	pla	clc	adc  TextOffset	sta  TextOffset	pla	adc  TextOffset+2	sta  TextOffset+2	jsr  SetSelectionEnd	jsr  HilightSelection	ldx  #0		;no errorexit	brl  StandardExit;---------------------------------------------------------------error1*** added 28-Jan-92 DAL -- yank the old selection length of the stack	pla	pla*** end 28-Jan-92	phx	jsr  ReleaseInputVerbs	plx;---------------------------------------------------------------error2	phx	jsr  HilightSelection	plx	bra  exit;---------------------------------------------------------------	ENDP****************************************************************TEReplace	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longxInputStyleRef	longxInputStyleVerb	wordxInputTextLength	longxInputTextRef	longxInputTextVerb	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #20	jsr  StandardEntry	jsr  TranslateInputVerbs	bcs  error	jsr  ReplaceText	bcs  @saveError	ldx  #0@saveError	phx	jsr  ReleaseInputVerbs	plxerror	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEGetSelection	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longtheEndPtr	longtheStartPtr	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #12	jsr  StandardEntry	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	ldy  #2	sta  [theStartPtr]	txa	sta  [theStartPtr],y	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	ldy  #2	sta  [theEndPtr]	txa	sta  [theEndPtr],y	ldx  #0		;no error	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TESetSelection	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longtheEndOffset	longtheStartOffset	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #12	jsr  StandardEntry	jsr  ClearSavedHPos		;clear the saved horizontal position	ldax theStartOffset		;see if we need to swap the two ends	cmpl theEndOffset	blt  @skipSwap	lda  theEndOffset		;swap the start and the end, so that the	ldx  theStartOffset		;..start is always less than or equal to	sta  theStartOffset		;..the end	stx  theEndOffset	lda  theEndOffset+2	ldx  theStartOffset+2	sta  theStartOffset+2	stx  theEndOffset+2@skipSwap	jsr  GetTextLength		;clip both of them to the text length	cmpl theStartOffset	bge  @noClip1	stax theStartOffset@noClip1	cmpl theEndOffset	bge  @noClip2	stax theEndOffset@noClip2	jsr  IsTheSelectionACaret	beq  setTheNewOne	lda  theStartOffset	cmp  theEndOffset	bne  @checkCombine	lda  theStartOffset+2	cmp  theEndOffset+2	beq  setTheNewOne@checkCombine	jsr  GetSelectionStart	cmpl theEndOffset,TextOffset	blt  setTheNewOne	jsr  GetSelectionEnd	cmpl theStartOffset,TextOffset	ble  combineThem;---------------------------------------------------------------setTheNewOne	jsr  UnhilightSelection	ldax theStartOffset		;set the anchor point and the new selection	stax TextOffset		;..start	ldy  #TERecord.AnchorPoint	jsr  SetRecordLong	jsr  SetSelectionStart	ldax theEndOffset	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  HilightSelection	brl  exit;---------------------------------------------------------------combineThem	jsr  GetSelectionStart	cmpl theStartOffset,TextOffset	blt  @extendStart	beq  @skipStart@contractStart	ldy  #TERecord.SelectionEnd	jsr  PushRecordLong	ldax theStartOffset	jsr  SetRecordLong	jsr  InvertSelection	ldax theStartOffset	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	bra  @restoreEnd@extendStart	ldy  #TERecord.SelectionEnd	jsr  PushRecordLong	jsr  GetSelectionStart	jsr  SetSelectionEnd	ldax theStartOffset	ldy  #TERecord.SelectionStart	jsr  SetRecordLong	jsr  InvertSelection@restoreEnd	PullAX	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong@skipStart	jsr  GetSelectionEnd	cmpl theEndOffset,TextOffset	blt  @contractEnd	beq  @skipEnd@extendEnd	ldy  #TERecord.SelectionStart	jsr  PushRecordLong	jsr  GetSelectionEnd	jsr  SetSelectionStart	ldax theEndOffset	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong	jsr  InvertSelection	bra  @restoreStart@contractEnd	ldy  #TERecord.SelectionStart	jsr  PushRecordLong	ldax theEndOffset	jsr  SetRecordLong	jsr  InvertSelection	ldax theEndOffset	ldy  #TERecord.SelectionEnd	jsr  SetRecordLong@restoreStart	PullAX	ldy  #TERecord.SelectionStart	jsr  SetRecordLong@skipEnd;---------------------------------------------------------------exit	ldy  #TERecord.SelectionStart	jsr  ScrollToSelection	ldx  #0		;no error	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEGetSelectionStyle	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longbufferHandle	longcommonPtr	longcommonFlag	word		;this is a temporary equate for outputstyleCount	word		;this is a temporary equate for the style count;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #12		;number of parameters	jsr  StandardEntry	lda  #%111111		;the common flag is inited to use everything	sta  commonFlag	jsr  IsTheSelectionACaret	bnel notACaret;---------------------------------------------------------------isACaret	PushZLong bufferHandle	lda  #TEStyle.RecordSize+2	ldx  #0	jsr  SetHandleSize	Deref bufferHandle,DestPtr	lda  #1	sta  [DestPtr]	lda  #2	addl DestPtr	ldy  #TERecord.NullStyleActive	lda  [RecordPtr],y	bpl  @notNull@useNull	lda  #TERecord.NullStyle	clc	adc  RecordPtr	sta  TempPtr	lda  RecordPtr+2	adc  #0	sta  TempPtr+2	bra  @caretDone@notNull	jsr  GetSelectionStart	jsr  FindStyleInfo	lda  TextOffset	cmp  SuperStart	bne  @1	lda  TextOffset+2	cmp  SuperStart+2	bne  @1	ora  TextOffset	beq  @1	decl TextOffset	jsr  FindStyleInfo	incl TextOffset	bra  @2@1	jsr  FindStyleInfo@2	jsr  SetupStylePtr@caretDone	jsr  copyAStyle		;copy the style into the buffer handle	movl commonPtr,DestPtr	;copy the style into common pointer	jsr  copyAStyle	ldx  #0		;this is the error code	brl  reallyDone;---------------------------------------------------------------notACaret	PushZLong bufferHandle	;set the buffer size to two	ldax #2	jsr  SetHandleSize	stz  styleCount		;zero the initial style counter	ldy  #TERecord.StyleList	;lock down the style list	jsr  PushRecordLong	jsr  LockHandle	jsr  GetSelectionStart	;copy the starting style into commonPtr	jsr  FindStyleInfo	jsr  SetupStylePtr	movl commonPtr,DestPtr	jsr  copyAStyle	bra  enterLoop		;save cycles - don't setup twice;---------------------------------------------------------------mainLoop	jsr  FindStyleInfo		;find the style offset and get a pointer	jsr  SetupStylePtr		;..to the style infoenterLoop	PushZLong bufferHandle	;get a pointer to the start of the buffer	jsr  DerefHandle	clc	adc  #2	sta  MemoryPtr	txa	adc  #0	sta  MemoryPtr+2	ldx  styleCount		;compare the current style with all the@nextStyle	cpx  #0		;..styles already in the buffer. If we	beq  mustAdd		;..get a match, then don't add the style	ldy  #0		;..again.@loop	lda  [TempPtr],y	cmp  [MemoryPtr],y	beq  @nextWord	dex	lda  #TEStyle.RecordSize	addl MemoryPtr	bra  @nextStyle@nextWord	iny	iny	cpy  #TEStyle.RecordSize	blt  @loop;---------------------------------------------------------------noAdd	addl SuperStart,SuperLength,TextOffset	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl TextOffset	bgt  mainLoop;---------------------------------------------------------------	ldx  #0allDone	phx	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  UnlockHandle	Deref bufferHandle,MemoryPtr	;get a pointer to the start of the buffer	lda  styleCount	sta  [MemoryPtr]	plx		;get back the error codereallyDone	lda  commonFlag		;return the common flag	sta  ReturnSpace,s	brl  StandardExit;---------------------------------------------------------------mustAdd	lda  [TempPtr]		;set the new common flag if things don't	cmp  [commonPtr]		;..match	beq  @1	lda  #fUseFont	trb  commonFlag	@1	shortm	ldy  #TEStyle.fontSize	lda  [TempPtr],y	cmp  [commonPtr],y	beq  @2	lda  #fUseSize	trb  commonFlag	@2	longm	ldy  #TEStyle.foreColor	lda  [TempPtr],y	cmp  [commonPtr],y	beq  @3	lda  #fUseForeColor	trb  commonFlag	@3	ldy  #TEStyle.backColor	lda  [TempPtr],y	cmp  [commonPtr],y	beq  @4	lda  #fUseBackColor	trb  commonFlag	@4	ldy  #TEStyle.userData	lda  [TempPtr],y	cmp  [commonPtr],y	bne  @5	iny	iny	lda  [TempPtr],y	cmp  [commonPtr],y	beq  @6@5	lda  #fUseUserData	trb  commonFlag	@6;; 7/31/90	Mensch; The following confusing bit of code seems to have a bit of a problem in that it performs no; real usefull function. Since there is a bug where the attributes entry in the common; style record is not correct (the bit should always be set that its right!). I will insert code; here that will make the common attributes more correct, I will do this by simply always ; only allowing bits that are common in ALL styles in the selection be highlighted. And only; reset the flag in certain specific instances	shortm	ldy  #TEStyle.fontAttr	lda  [TempPtr],y	; see if these attributes are different	cmp  [commonPtr],y	beq  @6_2; attributes are not equal , lets trim the common record back..	and  [commonPtr],y	sta  [commonPtr],y	; excess attributes now trimmed	bne  @6_2	; now, if there is still any common style, then simply end@clearIt	lda  #fUseAttributes	trb  commonFlag@6_2	longm	PushZLong bufferHandle	PushZLong bufferHandle	PushZLong bufferHandle	jsr  GetHandleSize	stax MoveLength	clc	adc  #TEStyle.RecordSize	bcc  @7	inx@7	jsr  SetHandleSize	bcs  memoryError	jsr  DerefHandle	clc	adc  MoveLength	sta  DestPtr	txa	adc  MoveLength+2	sta  DestPtr+2	jsr  copyAStyle	inc  styleCount	brl  noAdd;---------------------------------------------------------------memoryError	pla	pla	jsr  SetLastErrorCode	brl  allDone;---------------------------------------------------------------;---------------------------------------------------------------copyAStyle	ldy  #2	lda  [TempPtr]	sta  [DestPtr]@loop	lda  [TempPtr],y		sta  [DestPtr],y	iny	iny	cpy  #TEStyle.RecordSize	blt  @loop	rts;---------------------------------------------------------------	ENDP****************************************************************TEStyleChange	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longtheStylePtr	longtheStyleFlag	wordfontAttrFlag	word		;scratch variablesnoWrapFlag	word		;scratch variables;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #10		;number of parameters	jsr  StandardEntry	jsr  GetTEHighFlags		;if the record is read only, then don't	and  #fReadOnly		;..change the style	bnel allDone	jsr  TakeCareOfUpdate	;make sure any update event is handled first	jsr  CenterTheSelection	;make sure the selection is on screen	jsr  ClearSavedHPos		;clear the saved horizontal position	jsr  ClearOffsetCache	;we want the cache set to the SelectionStart	lda  #$FFFF		;for now indicate no word wrap. If we ever	sta  noWrapFlag		;..change anything except color, this will be cleared	jsr  GetTEHighFlags		;check for the record being a single style	and  #fSingleStyle		;..record	beq  notSingle;---------------------------------------------------------------doSingle	stzl TextStyleOffset	;use the first (only) style in the list	lda  theStyleFlag		;if we are not switching attributes then	and  #fSwitchAttributes	;..skip the pre-check	beq  @skipSwitch	jsr  SetupStylePtr		;setup TempPtr to point to the style	stz  fontAttrFlag		;clear the switch attributes flag	shortm	ldy  #TEStyle.fontAttr	lda  [TempPtr],y	and  [theStylePtr],y	cmp  [theStylePtr],y	longm	beq  @skipSwitch		;if the attribute was not set, then add it	dec  fontAttrFlag		;the attribute was not set, so remove it@skipSwitch	jsr  makeNewStyle		;create the new style	ldy  #TEStyle.RecordSize-2	;copy the style back into the style list@loop	tyx	lda  TempStyle,x	sta  [TempPtr],y	dey	dey	bpl  @loop	jsr  SetDirtyFlag		;mark the record as dirty	bit  noWrapFlag		;if the only change was color, then skip	bmi  @skipWrap		;..the word wrap	brl  doFullWrap@skipWrap	jsr  GetViewRect		;assume we are going to draw the entire 	jsr  CopyTempToDrawRect	;..viewRect	brl  callDoDraw;---------------------------------------------------------------notSingle	jsr  IsTheSelectionACaret	;if the selection is a caret then set the	beq  setTheNull		;..null style.	lda  theStyleFlag		;if we are not switching attributes then	and  #fSwitchAttributes	;..skip the pre-check	beq  @skipSwitch	stz  fontAttrFlag	jsr  GetSelectionStart	;pre-scan the styles to find out if the@loop	jsr  FindStyleInfo		;..passed attributes are common to the	jsr  GetLongSuperCount	;..entire selection. If they are NOT then	clc		;..set the fontAttrFlag to -1	adc  TextOffset		;if the fontAttrFlag is plus, then we are	sta  TextOffset		;..removing the passed attributes, otherwise	txa		;..we are adding them	adc  TextOffset+2	sta  TextOffset+2	jsr  SetupStylePtr	shortm	ldy  #TEStyle.fontAttr	lda  [TempPtr],y	and  [theStylePtr],y	cmp  [theStylePtr],y	longm	beq  @1	dec  fontAttrFlag		;there was a style difference, so set the	bra  @skipSwitch		;flag to add styles and exit the loop@1	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl TextOffset	bgt  @loop@skipSwitch	jsr  GetSelectionStart	;start the style change loop with the	jsr  ShouldWePartialWrap	;if we are doing a full word wrap then	bcc  mainLoop		;..skip the unhilight	jsr  UnhilightSelection	;remove the selection hilighting	bra  mainLoop		;..selection start;---------------------------------------------------------------setTheNull	jsr  GetSelectionStart	;find the style of the previous character	lda  TextOffset		;if text offset is zero, then skip the	bne  @1		;..decrement	lda  TextOffset+2	beq  @2	dec  TextOffset+2@1	dec  TextOffset@2	jsr  FindStyleInfo	ldy  #TERecord.NullStyleActive	;should we use the null style ?	lda  [RecordPtr],y	bmi  @useNull@useSuper	jsr  copyStyleIntoTemp	;nope, so copy the previous style into	bra  @checkSwitch		;..TempStyle and check for switch attr@useNull	ldy  #TERecord.NullStyle	ldx  #0		;here we should copy the null style into@loop1	lda  [RecordPtr],y		;..TempStyle	sta  TempStyle,x	iny	iny	inx	inx	cpx  #TEStyle.RecordSize	blt  @loop1@checkSwitch	lda  theStyleFlag		;if we are not switching attributes then	and  #fSwitchAttributes	;..skip the pre-check	beq  @skipSwitch	stz  fontAttrFlag	shortm	lda  TempStyle+TEStyle.fontAttr	ldy  #TEStyle.fontAttr	and  [theStylePtr],y	cmp  [theStylePtr],y	longm		;if the style attributes are already set	beq  @skipSwitch		;..then remove them	dec  fontAttrFlag@skipSwitch	jsr  makeNewStyle2		;make a new style from TempStyle	ldy  #TERecord.NullStyle	ldx  #0@loop2	lda  TempStyle,x	sta  [RecordPtr],y	iny	iny	inx	inx	cpx  #TEStyle.RecordSize	blt  @loop2	ldy  #TERecord.NullStyleActive	lda  #$FFFF	sta  [RecordPtr],y	brl  allDone;---------------------------------------------------------------mainLoop	jsr  FindStyleInfo		;get the current style	jsr  makeNewStyle		;create the new one	addl SuperStart,SuperLength,TempLong	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl TempLong	blt  @useSelectionEnd	ldax TempLong@useSelectionEnd	sec	sbc  TextOffset	sta  SuperLength	txa	sbc  TextOffset+2	sta  SuperLength+2	tdc		;make a pointer to the temporary style	clc		;..and add it to the style list	adc  #TempStyle	ldx  #0	jsr  AddToStyleList	bcs  drawIt		;if there was an error, then exit	jsr  ChangeStyleItem	;this updates TextOffset also.	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl TextOffset	bgt  mainLoop;---------------------------------------------------------------drawIt	jsr  SetDirtyFlag	jsr  GetViewRect		;assume we are going to draw the entire 	jsr  CopyTempToDrawRect	;..viewRect	bit  noWrapFlag	bmi  noWrap	jsr  ShouldWePartialWrap	bcc  doFullWrap;---------------------------------------------------------------doPartialWrap	jsr  GetSelectionLength	;remove the line starts for the selection	stax InputTextLength	;..but make sure the total length remains	jsr  ReplaceLines		;..the same	jsr  IncrementalWordWrap	;rewrap just what we need to	lda  DrawRect.top	cmp  DrawRect.bottom	beq  @skipDraw	jsr  DoDraw@skipDraw	jsr  HilightSelection	bra  allDone;---------------------------------------------------------------doFullWrap	jsr  InitialWordWrap	bra  callDoDraw;---------------------------------------------------------------noWrap	jsr  ShouldWePartialWrap	bcc  @skip	jsr  HilightSelection	;hilight the selection again@skip	jsr  GetSelectionStart	jsr  OffsetToVPos	bcs  @1	mov  TextVPos,DrawRect.top@1	jsr  GetSelectionEnd	jsr  OffsetToVPos	bcs  @2	jsr  FindLineInfo	lda  TextVPos	clc	adc  LineHeight	sta  DrawRect.bottom@2callDoDraw	jsr  DoDraw;---------------------------------------------------------------allDone	ldx  #0		;no error	brl  StandardExit;---------------------------------------------------------------;---------------------------------------------------------------copyStyleIntoTemp	jsr  SetupStylePtr		;get a pointer to the current style and	ldy  #TEStyle.RecordSize-2	;..copy it to the temp buffer@loop	lda  [TempPtr],y	tyx	sta  TempStyle,x	dey	dey	bpl  @loop	rts;---------------------------------------------------------------;---------------------------------------------------------------makeNewStyle	jsr  copyStyleIntoTemp	;copy the style to the TempStyle buffermakeNewStyle2	lda  theStyleFlag	and  #fReplaceFont	beq  @1	ldy  #TEStyle.fontFamily	lda  [theStylePtr],y	sta  TempStyle+TEStyle.fontFamily	stz  noWrapFlag@1	lda  theStyleFlag	and  #fReplaceSize	beq  @2	ldy  #TEStyle.fontSize	shortm	lda  [theStylePtr],y	sta  TempStyle+TEStyle.fontSize	longm	stz  noWrapFlag@2	lda  theStyleFlag	and  #fReplaceForeColor	beq  @3	ldy  #TEStyle.foreColor	lda  [theStylePtr],y	sta  TempStyle+TEStyle.foreColor@3	lda  theStyleFlag	and  #fReplaceBackColor	beq  @4	ldy  #TEStyle.backColor	lda  [theStylePtr],y	sta  TempStyle+TEStyle.backColor@4	lda  theStyleFlag	and  #fReplaceUserData	beq  @5	ldy  #TEStyle.userData	lda  [theStylePtr],y	sta  TempStyle+TEStyle.userData	iny	iny	lda  [theStylePtr],y	sta  TempStyle+TEStyle.userData+2	stz  noWrapFlag@5	lda  theStyleFlag	and  #fReplaceAttributes	beq  @6	ldy  #TEStyle.fontAttr	shortm	lda  [theStylePtr],y	sta  TempStyle+TEStyle.fontAttr	longm	stz  noWrapFlag@6	lda  theStyleFlag	and  #fSwitchAttributes	beq  @7	shortm	ldy  #TEStyle.fontAttr	lda  [theStylePtr],y	bit  fontAttrFlag	bpl  @removeThem	ora  TempStyle+TEStyle.fontAttr	bra  @storeIt@removeThem	eor  #$FF	and  TempStyle+TEStyle.fontAttr@storeIt	sta  TempStyle+TEStyle.fontAttr	longm	stz  noWrapFlag@7	rts;---------------------------------------------------------------;---------------------------------------------------------------ShouldWePartialWrap	PushZLong TextOffset	jsr  GetSelectionStart	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	sec	sbc  TextOffset	sta  TempLong	txa	sbc  TextOffset+2	sta  TempLong+2	asl  TempLong	rol  TempLong+2	PullLong TextOffset	jsr  GetTextLength	cmpl TempLong		;carry clear = full wrap, carry set =	rts		;..partial wrap;---------------------------------------------------------------	ENDP****************************************************************TEOffsetToPoint	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longhorzPosPtr	longvertPosPtr	longtheOffset	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #16	jsr  StandardEntry;---------------------------------------------------------------	stzl TempLong	stzl TextOffset	bra  @loopEnd@loop	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	cmpl theOffset,TextOffset	blt  foundLine	lda  LineHeight	addl TempLong@loopEnd	jsr  IsOffsetAtEnd	bne  @loop	ldy  #TERecord.LineAtEndFlag	lda  [RecordPtr],y	beq  foundLine	lda  LineHeight	addl TempLongfoundLine	ldy  #TERecord.VertScrollPos	;multiply the current scroll position by	jsr  GetRecordLong		;..the vertAmount and subtract it from	jsr  MultiplyByScrollAmount	;..our current position	jsr  NegateAX	clc	adc  TempLong	sta  TempLong	txa	adc  TempLong+2	sta  TempLong+2	ldy  #TERecord.ViewRect.top	;offset our position by the viewrect.top	lda  [RecordPtr],y	addl TempLong	lda  TempLong		;adjust for the VPos delta	sec	ldy  #TERecord.TopTextVPos	sbc  [RecordPtr],y	sta  TempLong	bcs  @1	dec  TempLong+2@1	ldy  #2		;return the vertical position	lda  TempLong	sta  [vertPosPtr]	lda  TempLong+2	sta  [vertPosPtr],y;---------------------------------------------------------------findHorzPos	movl theOffset,TextOffset	jsr  OffsetToHPos	ldy  #2	lda  TextHPos	sta  [horzPosPtr]	lda  #0	sta  [horzPosPtr],y	ldx  #0		;no errorerror	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEPointToOffset	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longhorzPos	longvertPos	long;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #12	jsr  StandardEntry	lda  horzPos		;convert horzPos down to a word value.	ldx  horzPos+2		;..if it is still negative we use zero	bpl  @positive		;..if it is bigger than $FFFF, we use $FFFF	lda  #0	bra  @useHorz@positive	beq  @useHorz	lda  #$FFFF@useHorz	sta  TextHPos;---------------------------------------------------------------	ldy  #TERecord.VertScrollPos	;multiply the current scroll position by	jsr  GetRecordLong		;..the vertAmount and add it from	jsr  MultiplyByScrollAmount	;..our current position	clc	adc  vertPos	sta  vertPos	txa	adc  vertPos+2	sta  vertPos+2	lda  vertPos		;offset our position by the viewrect.top	sec	ldy  #TERecord.ViewRect.top	sbc  [RecordPtr],y	sta  vertPos	bcs  @1	dec  vertPos+2@1	ldy  #TERecord.TopTextVPos	lda  [RecordPtr],y	addl vertPos;---------------------------------------------------------------	stzl TextOffset	bra  enterLoopmainLoop	jsr  FindLineInfo	lda  vertPos	sec	sbc  LineHeight	sta  vertPos	lda  vertPos+2	sbc  #0	sta  vertPos+2	bcc  foundLine	jsr  MoveOffsetToNextItementerLoop	jsr  IsOffsetAtEnd	bne  mainLoop	bra  returnItfoundLine	jsr  HPosToOffset;---------------------------------------------------------------returnIt	lda  TextOffset	sta  ReturnSpace,s	lda  TextOffset+2	sta  ReturnSpace+2,s	ldx  #0		;no errorerror	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TEGetRuler	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longtheRulerRef	longtheRulerVerb	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #10	jsr  StandardEntry	ldx  #teInvalidVerb		;check for an invalid verb	lda  theRulerVerb	and  #ÅrefIsMask	bnel error	ldy  #TERecord.RulerList	jsr  PushRecordLong	jsr  PushRecordLong	jsr  GetHandleSize		;get the size of the ruler list into	stax MoveLength		;..MoveLength	jsr  LockHandle		;lock down the handle and put the pointer	stax SourcePtr		;..in SourcePtr	lda  theRulerVerb		;determine what type of reference we were	and  #refIsMask		;..passed;	cmp  #refIsPointer		;since refIsPointer is zero, don't compare	beq  @doPointer	cmp  #refIsHandle	beq  @doHandle	cmp  #refIsResource	beq  @doResource;---------------------------------------------------------------@doNewHandle	jsr  makeNewHandle		;create the new handle	ldy  #2	lda  TempLong	sta  [theRulerRef]	lda  TempLong+2	sta  [theRulerRef],y	bra  @moveIt;---------------------------------------------------------------@doResource	PushLongSpace		;try to load the given resource	PushWord #rTERuler		PushZLong theRulerRef	_LoadResource	tax	pla	sta  TempLong	pla	sta  TempLong+2	bcc  @useThisRes		;if we were able to load it, then use the	cpx  #$1E06		;..existing handle	bne  unlockList		;on any other error, we exit@makeNewRes	jsr  makeNewHandle		;we need to make a new one here, so create	jsr  BlockMove		;..a new handle	PushZLong TempLong		;the handle to make into a resource	PushWord #$0300		;purgable	PushWord #rTERuler	PushZLong theRulerRef	;the resource ID	_AddResource	tax	bra  unlockList@useThisRes	jsr  resizeHandle	jsr  BlockMove	PushWord #$FFFF	PushWord #rTERuler	PushZLong theRulerRef	_MarkResourceChange	tax	bra  unlockList;---------------------------------------------------------------@doHandle	movl theRulerRef,TempLong	jsr  resizeHandle	bra  @moveIt;---------------------------------------------------------------@doPointer	movl theRulerRef,DestPtr;---------------------------------------------------------------@moveIt	jsr  BlockMove	ldx  #0;---------------------------------------------------------------unlockList	phx	ldy  #TERecord.RulerList	jsr  PushRecordLong	jsr  UnlockHandle	plx	jsr  SetLastErrorCodeerror	brl  StandardExit;---------------------------------------------------------------;---------------------------------------------------------------makeNewHandle	ldax MoveLength	jsr  GetLargeHandle	bcs  memoryError	stax TempLong	bra  derefTempLongresizeHandle	PushZLong TempLong	ldax MoveLength	jsr  SetHandleSize	bcs  memoryErrorderefTempLong	Deref TempLong,DestPtr	rtsmemoryError	pla		;pull off the return address	bra  unlockList;---------------------------------------------------------------	ENDP****************************************************************TESetRuler	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longtheRulerRef	longtheRulerVerb	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #10	jsr  StandardEntry	ldx  #teInvalidVerb		;check for an invalid verb	lda  theRulerVerb	and  #ÅrefIsMask	bnel error	lda  theRulerVerb		;determine what type of reference we were	and  #refIsMask		;..passed;	cmp  #refIsPointer		;since refIsPointer is zero, don't compare	beq  doPointer	cmp  #refIsHandle	beq  doHandle	cmp  #refIsResource	bnel error;---------------------------------------------------------------doResource	ldy  #rTERuler	ldax theRulerRef	jsr  LoadResource	bra  joinHandle;---------------------------------------------------------------doHandle	ldax theRulerRefjoinHandle	PushAX		;duplicate the item on the stack twice	PushAX		;..for the lock and the get handle size	PushAX	jsr  GetHandleSize	stax MoveLength	jsr  LockHandle	stax SourcePtr	bra  copyTheRuler;---------------------------------------------------------------doPointer	movl theRulerRef,SourcePtr	ldy  #TERuler.tabType	lda  [SourcePtr],y	iny	iny	cmp  #noTabs		;if no tabs, then this is it	beq  @setLength	iny	iny	cmp  #equalTabs	beq  @setLength	dey	dey@loop	lda  [SourcePtr],y	iny	iny	inc  a		;fast compare with $FFFF	bne  @loop@setLength	sty  MoveLength	stz  MoveLength+2;---------------------------------------------------------------copyTheRuler	ldy  #TERecord.RulerList	jsr  PushRecordLong	jsr  PushRecordLong	ldax MoveLength	jsr  SetHandleSize	bcs  memoryError	jsr  DerefHandle	stax DestPtr	jsr  BlockMove	lda  theRulerVerb		;if the verb is refIsPointer, then skip	beq  @skipUnlock		;..the unlock	jsr  UnlockHandle@skipUnlock	jsr  InitialWordWrap	jsr  DoDraw	jsr  ClearSavedHPos		;clear the saved horizontal position	jsr  SetDirtyFlag;---------------------------------------------------------------	ldx  #0		;no errorerror	brl  StandardExit;---------------------------------------------------------------memoryError	pla	pla	phx	PushZLong theRulerRef	jsr  UnlockHandle	plx	jsr  SetLastErrorCode	bra  error;---------------------------------------------------------------	ENDP****************************************************************TEScroll	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longhorzAmount	longvertAmount	longtheScrollVerb	word;---------------------------------------------------------------;---------------------------------------------------------------	ldy  #14	jsr  StandardEntry	ldy  #TERecord.TextFlags+2	;check to see if we should scroll. If not	lda  [RecordPtr],y		;..then exit	and  #fNoScroll	bne  exit	ldx  #teInvalidVerb		;check for a verb overflow. If the verb	lda  theScrollVerb		;..is ok, then jump thru the table.	cmp  #6	bge  error	jsr  TakeCareOfUpdate	;make sure any update event is handled first	lda  theScrollVerb	asl  a	tax	jmp  (table,x);---------------------------------------------------------------exit	ldx  #0		;no errorerror	brl  StandardExit;---------------------------------------------------------------;---------------------------------------------------------------table	dc.w  doTopOffset	dc.w  doTopOffset	dc.w  doTopLine	dc.w  doTopLine	dc.w  doSetValue	dc.w  doOffsetValue;---------------------------------------------------------------;---------------------------------------------------------------doTopLine	ldy  #TERecord.LineSuper	jsr  GetSuperRecordPtr	jsr  MoveToFirstSuperHandle	jsr  GetSuperMaxIndex	lda  vertAmount		;copy the line number into TempLong	sta  TempLong	lda  vertAmount+2	sta  TempLong+2	ora  TempLong		;if the line number to scroll to is zero	beq  moveToOffset		;..then scroll to a text offset of zero	stzl vertAmount		;otherwise start at zero@outerLoop	ldy  #SuperBlock.RecordSize+2@loop	lda  [TempPtr],y	bmi  @skip	tax	dey	dey	lda  [TempPtr],y	clc	adc  vertAmount	sta  vertAmount	txa	adc  vertAmount+2	sta  vertAmount+2	iny	iny	lda  TempLong	bne  @1	dec  TempLong+2@1	dec  a	sta  TempLong	ora  TempLong+2	beq  moveToOffset@skip	tya	clc	adc  #8	tay	cpy  SuperMaxIndex	blt  @loop	jsr  MoveToNextHandle	bcc  @outerLoop		;if we are at the end, then just move to	bra  moveToOffset		;..the last offset;---------------------------------------------------------------;---------------------------------------------------------------doTopOffset	ldy  #TERecord.TextLength	;make sure the amount is less than the	jsr  GetRecordLong		;..total length. If it isn't, then clip	cpx  vertAmount+2		;..it.	blt  @clipIt	bne  @checkEnd		;added this line 4-Oct-90 DAL (was clipping accidentally)	cmp  vertAmount	beq  @checkEnd	bge  @findStart@clipIt	stax vertAmount@checkEnd	ldy  #TERecord.LineAtEndFlag	;now check for whether we have an extra	lda  [RecordPtr],y		;..line at the end. If we do, then keep	bne  @skip		;..the ending offset.@findStart	movl vertAmount,TextOffset	;otherwise round down to the nearest line	jsr  FindLineInfo		;..start	movl SuperStart,vertAmount@skip;---------------------------------------------------------------;---------------------------------------------------------------moveToOffset	ldy  #TERecord.TopTextVPos	lda  [RecordPtr],y	sta  TempLong	stz  TempLong+2	jsr  GetScreenTopOffset	cmpl vertAmount,TextOffset	blt  moveBack	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	cmpl vertAmount,TextOffset	blt  inFirstLine;---------------------------------------------------------------moveForward	jsr  GetScreenTopOffset	jsr  NegateTempLong@loop	jsr  FindLineInfo	jsr  MoveOffsetToNextItem	lda  LineHeight	addl TempLong	cmpl vertAmount,TextOffset*** 28-Jan-92 DAL -- replace BNE with BGT to fix hang when scroll-to pos is not at beginning of line;;;	bne  @loop	beq  @done	bcs  @loop@done*** end 28-Jan-92	jsr  getCenterValue	sta  TempWord	ldax TempLong	sec	sbc  TempWord	bcs  @1	dex	bpl  @1	jsr  NegateAX	bra  switchToBack@1	jsr  DivideByScrollAmount	bra  doTheScroll;---------------------------------------------------------------moveBack	jsr  GetScreenTopOffset@loop	decl TextOffset	jsr  FindLineStart	lda  LineHeight	addl TempLong	cmpl vertAmount,TextOffset	blt  @loopinFirstLine	jsr  getCenterValue	ldx  TempLong+2	clc	adc  TempLong	bcc  switchToBack	inxswitchToBack	jsr  DivideByScrollAmount	jsr  NegateAX	bra  doTheScroll;---------------------------------------------------------------;---------------------------------------------------------------doSetValue	ldy  #TERecord.VertScrollPos	;get the difference between the new value	lda  vertAmount		;..and the old one and store it back in	sec		;..vertAmount.	sbc  [RecordPtr],y	sta  vertAmount	iny	iny	lda  vertAmount+2	sbc  [RecordPtr],y		;then, fall through into doOffsetValue	sta  vertAmount+2		;..to do the actual scrolldoOffsetValue	ldax vertAmount		;A-Reg and X-Reg contain the amount to scroll;---------------------------------------------------------------doTheScroll	jsr  ScrollByAmount		;..Then do it and fall thru into Exit	brl  exit;---------------------------------------------------------------;---------------------------------------------------------------getCenterValue	lda  theScrollVerb	dec  a		;small compare with one	beq  @doCenter	dec  a		;small compare with three	dec  a	beq  @doCenter	lda  #0	rts@doCenter	jsr  GetViewRect	lda  TempRect.bottom	sec	sbc  TempRect.top	lsr  a	rts;---------------------------------------------------------------	ENDP****************************************************************TEGetDefProc	PROCNAME  Export;---------------------------------------------------------------	DefineStackRTL1	block 3RTL2	block 3output	long;---------------------------------------------------------------	lda  #TEDefProc		;return the defProc pointer	sta  output,s	lda  #^TEDefProc	sta  output+2,s	brl  NullRoutine;---------------------------------------------------------------	ENDP****************************************************************TEGetInternalProc	PROCNAME  Export;---------------------------------------------------------------	DefineStackRTL1	block 3RTL2	block 3output	long;---------------------------------------------------------------	lda  #TEInternalProc	;return the internal proc pointer	sta  output,s	lda  #^TEInternalProc	sta  output+2,s	brl  NullRoutine;---------------------------------------------------------------	ENDP****************************************************************TEInternalProc	PROCNAME  Export	rtl	ENDP****************************************************************TEGetLastError	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longclearFlag	word;---------------------------------------------------------------;---------------------------------------------------------------	pha		;clear the stack error code	lda  #0	sta  15,s	pla	ldy  #6	jsr  StandardEntry	ldy  #TERecord.LastErrorCode	lda  [RecordPtr],y	sta  ReturnSpace,s	lda  clearFlag	beq  exit	ldy  #TERecord.LastErrorCode	lda  #0	sta  [RecordPtr],yexit	ldx  #0		;no error	brl  StandardExit;---------------------------------------------------------------	ENDP****************************************************************TECompactRecord	PROCNAME  Export;---------------------------------------------------------------	DefineStackuserBank	byteuserDirectPage	worduserReturnAddr	block  6xSpace1	long		;this is the space for the old RecordHandlexSpace2	long		;..and RecordPtr. these declarations makexRecordHandle	long		;..sure that xRecordHandle is correct.;---------------------------------------------------------------;---------------------------------------------------------------	jsl  IncBusyFlg		;increment busy flag (doesn't change ANYTHING)	phd		;save the user's direct page	phb		;save the user's data bank	ldx  #teNotStarted		;load the not started error, just in case	tay		;..then, check to see if TextEdit is	beq  exit		;..started	tcd		;set textedit's direct page	phk		;set the data bank to textedit's program	plb		;..bank	PushZLong RecordHandle	;save the old record handle and the old	PushZLong RecordPtr		;..record pointer	lda  xRecordHandle,s	;copy the record handle	sta  RecordHandle	lda  xRecordHandle+2,s	sta  RecordHandle+2	ldy  #4		;save the locked state of the record handle	lda  [RecordHandle],y	;lock the main record handle and deref	pha		;..it	ora  #$8000	sta  [RecordHandle],y	jsr  DerefRecordHandle;---------------------------------------------------------------	ldy  #TERecord.LineSuper	;compact the line starts	jsr  CompactSuperHandle	ldy  #TERecord.StyleSuper	;compact the style runs	jsr  CompactSuperHandle	jsr  CompactStyleList	;compact the style list;---------------------------------------------------------------	ldy  #4		;restore the state of the record handle	pla	sta  [RecordHandle],y	PullLong RecordPtr	PullLong RecordHandle	ldx  #0		;no error;---------------------------------------------------------------exit	lda  userReturnAddr+4,s	;copy the return address over the parameters	sta  userReturnAddr+8,s	lda  userReturnAddr+2,s	sta  userReturnAddr+6,s	lda  userReturnAddr,s	sta  userReturnAddr+4,s	plb		;restore the user's data bank	pld		;restore user's direct page	pla		;clean the parameter off the stack	pla	txa		;put the error code into A	cmp  #1		;set the carry flag	jml  DecBusyFlg		;decrement busy flag and return to caller;---------------------------------------------------------------	ENDP****************************************************************CompactStyleList	PROCNAME  Export;---------------------------------------------------------------FirstHandle	equ  WorkArea;---------------------------------------------------------------;---------------------------------------------------------------	lda  RecordInUse		;if this record is in use, then don't	cmp  RecordHandle		;..crunch the style list	bne  doIt	lda  RecordInUse+2	cmp  RecordHandle+2	bne  doIt	rts;---------------------------------------------------------------doIt	PushZLong TempPtr		;save all the variables we are going to	PushZLong SuperRecordPtr	;..use	PushZLong TheSuperHandle	PushZLong TextStyleOffset	PushZWord SuperMaxIndex	PushZWord TempWord	PushZLong MoveLength	PushZLong FirstHandle;---------------------------------------------------------------	ldy  #TERecord.StyleSuper	;setup super record pointer	jsr  GetSuperRecordPtr	jsr  MoveToFirstSuperHandle	;save the first super handle	movl TheSuperHandle,FirstHandle	jsr  GetSuperMaxIndex	;get and save the SuperMaxIndex	ldy  #TERecord.StyleList	;scan thru the style list backwards stripping	jsr  PushRecordLong		;..off the styles at the very end that are	jsr  GetHandleSize		;..NOT used	sec	sbc  #4	bcs  @loop	dex@loop	stax MoveLength	sec	sbc  #TEStyle.RecordSize	bcs  @1	dex@1	stax TextStyleOffset	jsr  LookForStyle	bcc  checkAll	ldax TextStyleOffset	bra  @loop;---------------------------------------------------------------checkAll	stzl TextStyleOffset	;now start scanning forwards thru the styles@loop	jsr  LookForStyle		;is the style used ? If so, move to the	bcc  @nextStyle		;..next style	lda  MoveLength		;the style was NOT used here, so check to	sec		;..see if we are at the end of the new	sbc  #TEStyle.RecordSize	;..style list. If we are, then we are thru	sta  MoveLength	bcs  @1	dec  MoveLength+2@1	lda  TextStyleOffset	cmp  MoveLength	bne  @2	lda  TextStyleOffset+2	cmp  MoveLength+2	beq  @done		;swap this style with the one at the end@2	jsr  SwapOutTheStyle@nextStyle	lda  TextStyleOffset	;move TextStyleOffset to the next item	clc		;..in the list.	adc  #TEStyle.RecordSize	sta  TextStyleOffset	bcc  @3	inc  TextStyleOffset+2@3	cmp  MoveLength		;are we at the end ? If we are, then	bne  @loop		;..resize the list	lda  TextStyleOffset+2	cmp  MoveLength+2	bne  @loop@done;---------------------------------------------------------------resizeList	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  PushRecordLong	ldax MoveLength		;add an extra four for the terminator	clc	adc  #4	bcc  @1	inx@1	jsr  SetHandleSize	jsr  DerefHandle	clc	adc  MoveLength	sta  TempPtr	txa	adc  MoveLength+2	sta  TempPtr+2	ldy  #0	jsr  TerminateTempPtr;---------------------------------------------------------------	PullLong FirstHandle	PullLong MoveLength	PullWord TempWord	PullWord SuperMaxIndex	PullLong TextStyleOffset	PullLong TheSuperHandle	PullLong SuperRecordPtr	PullLong TempPtr	rts;---------------------------------------------------------------;---------------------------------------------------------------LookForStyle	movl FirstHandle,TheSuperHandle	jsr  SuperHandleToPtr@blockLoop	ldy  #SuperBlock.RecordSize+2@itemLoop	sty  TempWord	lda  [TempPtr],y	bmi  @nextItem	iny	iny	lda  [TempPtr],y	cmp  TextStyleOffset	bne  @nextItem	iny	iny	lda  [TempPtr],y	cmp  TextStyleOffset+2	beq  @foundIt@nextItem	lda  TempWord	clc	adc  #SuperItemSize	tay	cpy  SuperMaxIndex	blt  @itemLoop	jsr  MoveToNextHandle	bcc  @blockLoop	rts		;carry set indicates NOT found.@foundIt	clc	rts;---------------------------------------------------------------;---------------------------------------------------------------SwapOutTheStyle	movl FirstHandle,TheSuperHandle	jsr  SuperHandleToPtr@blockLoop	ldy  #SuperBlock.RecordSize+2@itemLoop	sty  TempWord	lda  [TempPtr],y	bmi  @nextItem	iny	iny	lda  [TempPtr],y	cmp  MoveLength	bne  @nextItem	iny	iny	lda  [TempPtr],y	cmp  MoveLength+2	bne  @nextItem	lda  TextStyleOffset+2	sta  [TempPtr],y	dey	dey	lda  TextStyleOffset	sta  [TempPtr],y@nextItem	lda  TempWord	clc	adc  #SuperItemSize	tay	cpy  SuperMaxIndex	blt  @itemLoop	jsr  MoveToNextHandle	bcc  @blockLoop	ldy  #TERecord.StyleList	jsr  PushRecordLong	jsr  DerefHandle	pha	clc	adc  TextStyleOffset	sta  DestPtr	txa	adc  TextStyleOffset+2	sta  DestPtr+2	pla	adc  MoveLength		;carry is always clear here	sta  SourcePtr	txa	adc  MoveLength+2	sta  SourcePtr+2	ldy  #TEStyle.RecordSize-2@copyLoop	lda  [SourcePtr],y	sta  [DestPtr],y	dey	dey	bpl  @copyLoop	PushZLong TextStyleOffset	ldax MoveLength@lookLoop	stax MoveLength	sec	sbc  #TEStyle.RecordSize	bcs  @1	dex@1	stax TextStyleOffset	jsr  LookForStyle	bcc  @done	ldax TextStyleOffset	bra  @lookLoop@done	PullLong TextStyleOffset	rts;---------------------------------------------------------------	ENDP****************************************************************SetTheWAP	PROCNAME  Entry	PushWord #0		;system toolset	PushWord #TEToolNumber	;toolset number for textedit	pea  $0000		;set the WAP to A-Reg	pha	_SetWAP	rts	ENDP****************************************************************GetDirectPage	PROCNAME  Export	PushLongSpace	PushWord #0		;system toolset	PushWord #TEToolNumber	;toolset number for textedit	_GetWAP	PullAX	rts	ENDP****************************************************************; A-Reg,X-Reg are the parameters and Y-Reg is the message;CallDefProc	PROCNAME  Export	PushLongSpace		;leave space for the result	phy		;pass the message	PushAX		;pass the parameters	PushZLong RecordHandle	;pass the record handle	jsl  TEDefProc		;call the defProc	jsr  LockRecordHandle	;lock the record back down	PullAX		;get back the returned value	rts	ENDP****************************************************************TakeCareOfUpdate	PROCNAME  Export;---------------------------------------------------------------	jsr  GetTEHighFlags		;if the textedit record is not a control	and  #fNotControl		;..then don't do this	bne  noUpdate	jsr  GetWindowPortPtr	;get the update region pointer into	ldy  #WindowRecord.wUpdateRgn+2	;..memoryPtr	jsr  PushTempPtrLong	jsr  DerefHandle	stax MemoryPtr	lda  [MemoryPtr]		;check the update region to see if it is	cmp  #10		;..empty	bne  checkForUpdate	ldy  #Rgn.bounds.top	lda  [MemoryPtr],y	ldy  #Rgn.bounds.bottom	cmp  [MemoryPtr],y	bpl  noUpdate	ldy  #Rgn.bounds.left	lda  [MemoryPtr],y	ldy  #Rgn.bounds.right	cmp  [MemoryPtr],y	bmi  checkForUpdate;---------------------------------------------------------------noUpdate	rts;---------------------------------------------------------------checkForUpdate	ldy  #TERecord.BoundsRect	;get the bounds rect of the textedit box	jsr  CopyIntoTempRect	;..into TempRect	ldy  #GrafPort.BoundsRect.top	;convert TempRect.topLeft into global	lda  TempRect.top		;..coordinates	sec	sbc  [TempPtr],y	sta  TempRect.top	iny	iny	lda  TempRect.left	sec	sbc  [TempPtr],y	sta  TempRect.left	ldy  #GrafPort.BoundsRect.top	;convert TempRect.botRight into global	lda  TempRect.bottom	;..coordinates	sec	sbc  [TempPtr],y	sta  TempRect.bottom	iny	iny	lda  TempRect.right	sec	sbc  [TempPtr],y	sta  TempRect.right	ldy  #Rgn.bounds.top	;if the top of the update region is greater	lda  [MemoryPtr],y		;..than the bottom of the textedit box	cmp  TempRect.bottom	;..then they don't intersect	bge  noUpdate	ldy  #Rgn.bounds.bottom	;if the bottom of the update region is	lda  [MemoryPtr],y		;..less than the top of the textedit	cmp  TempRect.top		;..box then they don't intersect	ble  noUpdate	ldy  #Rgn.bounds.left	;if the left of the update region is greater	lda  [MemoryPtr],y		;..than the right of the textedit box	cmp  TempRect.right		;..then they don't intersect	bge  noUpdate	ldy  #Rgn.bounds.right	;if the right of the update region is	lda  [MemoryPtr],y		;..less than the left of the textedit	cmp  TempRect.left		;..box then they don't intersect	ble  noUpdate;---------------------------------------------------------------mustUpdate	ldy  #WindowRecord.wUpdateRgn+2	;save the old update region handle	jsr  PushTempPtrLong	jsr  GetNewRgn		;get a new temp region for our update region	PushAX		;for the kill region	stax TempLong	ldy  #WindowRecord.wUpdateRgn+2	jsr  PushTempPtrLong	PushZLong TempLong	_CopyRgn	PushZLong TempLong	ldy  #GrafPort.BoundsRect.topLeft+2	jsr  PushTempPtrLong	_OffsetRgn	ldy  #GrafPort.VisRgn+2	jsr  PushTempPtrLong	PushZLong TempLong	PushZLong TempLong	_SectRgn	ldy  #WindowRecord.wUpdateRgn	lda  TempLong	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y	jsr  swapVisAndUpdate	;swap the visible and update regions so	ldy  #TERecord.SelectionActive	;..we clip to the update region	lda  [RecordPtr],y	tax	lda  #0	ldy  #drawCtl		;the message is draw	jsr  CallDefProc	jsr  GetVertScrollBar	beq  @1	PushAX	_DrawOneCtl@1	jsr  GetGrowBoxHandle	beq  @2	PushAX	_DrawOneCtl@2		jsr  GetWindowPortPtr	jsr  swapVisAndUpdate	;restore the original visible region	jsr  KillRgn	ldy  #WindowRecord.wUpdateRgn	;restore the original update handle	pla	sta  [TempPtr],y	iny	iny	pla	sta  [TempPtr],y	ldy  #TERecord.BoundsRect	;validate the bounds rect of the textedit	jsr  CopyIntoTempRect	;..control, so we don't draw it twice	PushZPtr TempRect	_ValidRect	rts;---------------------------------------------------------------;---------------------------------------------------------------swapVisAndUpdate	ldy  #GrafPort.VisRgn	lda  [TempPtr],y	sta  TempLong	iny	iny	lda  [TempPtr],y	sta  TempLong+2	ldy  #WindowRecord.wUpdateRgn+2	lda  [TempPtr],y	tax	dey	dey	lda  [TempPtr],y	ldy  #GrafPort.VisRgn	sta  [TempPtr],y	iny	iny	txa	sta  [TempPtr],y	ldy  #WindowRecord.wUpdateRgn	lda  TempLong	sta  [TempPtr],y	iny	iny	lda  TempLong+2	sta  [TempPtr],y	rts;---------------------------------------------------------------;---------------------------------------------------------------PushTempPtrLong	plx	lda  [TempPtr],y	pha	dey	dey	lda  [TempPtr],y	pha	phx	rts;---------------------------------------------------------------	ENDP****************************************************************	END