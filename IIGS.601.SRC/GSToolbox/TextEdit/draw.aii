************************************************************************                      GSTextEdit  Version 1.0*                          File: draw.aii**               Copyright Apple Computer, Inc. 1988-89*                        All rights reserved***** Notes** All the routines in GSTextEdit must be called in full native mode and* return that way.** All the files in GSTextEdit must be assembled with the "-unsafe"* option to pass unresolved references to the linker.***** Change History** 30 May 89	Dave Good** Cleaned up comments for final release.***********************************************************************	INCLUDE  'GlobalIncludes'****************************************************************GetDrawRect	PROCNAME  Export;---------------------------------------------------------------	jsr  GetViewRect		;clip to the text rectangle	ldy  #TERecord.inPort	;use the record's grafPort	jsr  GetRecordLong	stax MemoryPtr	ldy  #GrafPort.VisRgn+2	;get the region handle, deref it and store	lda  [MemoryPtr],y		;..in memory pointer	tax	dey	dey	lda  [MemoryPtr],y	jsr  DerefAX	stax MemoryPtr;---------------------------------------------------------------	ldy  #8		;compare right point	lda  [MemoryPtr],y	cmp  TempRect.right	bpl  @1	sta  TempRect.right@1	ldy  #6		;compare bottom point	lda  [MemoryPtr],y	cmp  TempRect.bottom	bpl  @2	sta  TempRect.bottom@2	ldy  #4		;compare left point	lda  [MemoryPtr],y	cmp  TempRect.left	bmi  @3	sta  TempRect.left@3	cmp  TempRect.right		;check for empty rect	bpl  zeroIt	ldy  #2		;compare top point	lda  [MemoryPtr],y	cmp  TempRect.top	bmi  @4	sta  TempRect.top@4	cmp  TempRect.bottom	;check for empty rect	bmi  copyIt;---------------------------------------------------------------zeroIt	jsr  ZeroTempRect;---------------------------------------------------------------copyIt	brl  CopyTempToDrawRect;---------------------------------------------------------------	ENDP****************************************************************Draw1Proc	PROC;---------------------------------------------------------------	EXPORT  DrawFromOffset	ENTRY   DrawLine;---------------------------------------------------------------;---------------------------------------------------------------DrawFromOffset	jsr  CheckInvisible		;if invisible, then skip drawing	lda  TextHPos		;TextHPos is where to copy the line to	sec		;..when copying the text to the screen	ldy  #TERecord.ViewRect.left	sbc  [RecordPtr],y		;PnLoc.h is the pixel position in the	sta  TextHPos		;..offscreen buffer where we should start	ldy  #GrafPort.PnLoc.h	;..drawing the text	sta  [DrawPortPtr],y	bra  commonCode;---------------------------------------------------------------DrawLine	jsr  GetLeftEdge	sta  TextHPos	jsr  AdjustForJust	clc	adc  TextHPos	ldy  #GrafPort.PnLoc.h	;TextHPos is zero because for an entire	sta  [DrawPortPtr],y	;..line, we need to erase the area to the	stz  TextHPos		;..left of the line;---------------------------------------------------------------commonCode	jsr  SetupAndClearBuffer	;setup the drawing buffer	bcc  @gotTheBuffer	brl  SetLastErrorCode	;just exit without drawing anything@gotTheBuffer	jsr  FindTextPtr		;find the text pointer and lock the block	PushZLong BlockHandle	;..that contains it. Also save a copy for	PushZLong BlockHandle	;..unlocking it	jsr  LockHandle	jsr  FindLineInfo		;get the length of the line we are going	jsr  GetSuperCount		;..to draw. We never draw more than 64K	sta  LineLength	ldax SuperStart		;set the starting offset for the line.	stax LineStartOffset	clc		;set the ending offset for the line.	adc  SuperLength	sta  LineEndOffset	txa	adc  SuperLength+2	sta  LineEndOffset+2	PushZLong TextPtr		;GetLeftEdge kills the textpointer	PushZLong TextOffset	;get the left edge of the line into our	movl LineStartOffset,TextOffset	;..saved left edge	jsr  GetLeftEdge	sta  LineStartLeft	jsr  AdjustForJust	clc	adc  LineStartLeft	sta  TempRect.left	sta  TempRect.right	PullLong TextOffset	PullLong TextPtr		;restore the text pointer	stz  TempRect.top		;this sets TempRect to the default rect	lda  LineHeight	sta  TempRect.bottom	ldy  #TERecord.SelectionEnd	;find the difference between the end of	lda  [RecordPtr],y		;..the selection and the current spot	sec	sbc  TextOffset	sta  SelcEndOffset	iny	iny	lda  [RecordPtr],y	sbc  TextOffset+2	beq  @1	lda  #$FFFF	sta  SelcEndOffset@1	ldy  #TERecord.SelectionStart	;do the same thing for the selection	lda  [RecordPtr],y		;..start	sec	sbc  TextOffset	sta  SelcStartOffset	iny	iny	lda  [RecordPtr],y	sbc  TextOffset+2	beq  @2	lda  #$FFFF	sta  SelcStartOffset@2	ldy  LineLength	beql allDone	dey	lda  [TextPtr],y	and  #$00FF	cmp  #CR	bne  @notACR	dec  LineLength	beql allDone@notACR	ldy  #GrafPort.PnLoc.v	;set the vertical coordinate of the port	lda  LineAscent	sta  [DrawPortPtr],y;---------------------------------------------------------------partLoop	jsr  FindStyleInfo		;find the current style	jsr  GetSuperCount		;get the length of the current style and	cmp  LineLength		;..see if it is bigger than the line. If	blt  @saveCount		;..so, then clip to the line.	lda  LineLength@saveCount	sta  TextCount	ldy  #0		;if there is a TAB in the part then stop	shortm		;..at it.@loop	lda  [TextPtr],y	cmp  #TAB	beq  @foundTab	iny	cpy  TextCount	blt  @loop@foundTab	longm	cpy  SelcStartOffset	;clip the count to the selection	blt  @1	ldy  SelcStartOffset@1	cpy  SelcEndOffset	blt  @2	ldy  SelcEndOffset@2	sty  TextCount	cpy  #0	beq  @skipDraw	jsr  InstallFontAndColor	PushZLong TextPtr		;draw the text.	PushZWord TextCount	_DrawText	jsr  ReleaseFont@skipDraw	lda  SelcStartOffset	;see if stopped on a selection. If we did	sec		;..then set the correct horizontal pos.	sbc  TextCount	bne  @notStart	ldy  #GrafPort.PnLoc.h	lda  [DrawPortPtr],y	sta  TempRect.left	lda  #$FFFF@notStart	sta  SelcStartOffset	lda  SelcEndOffset	sec	sbc  TextCount	bne  @notEnd	ldy  #GrafPort.PnLoc.h	lda  [DrawPortPtr],y	sta  TempRect.right	lda  #$FFFF@notEnd	sta  SelcEndOffset	ldy  TextCount		;if we moving to the last character of	cpy  LineLength		;..the line, then don't check the next	beq  @skip		;..character for a TAB	ldy  TextCount	lda  [TextPtr],y	and  #$00FF	cmp  #TAB	beq  doTab@skip	lda  TextCount		;move the TextOffset forward.	addl TextOffsetnextPart	lda  TextCount		;move the TextPtr forward.	addl TextPtr	lda  LineLength		;reduce the line length	sec	sbc  TextCount	sta  LineLength	beq  allDone	brl  partLoop;---------------------------------------------------------------doTab	inc  TextCount	lda  TextCount		;move the TextOffset forward.	addl TextOffset	PushZWord TextHPos	ldy  #GrafPort.PnLoc.h	lda  [DrawPortPtr],y	sta  TextHPos	jsr  MoveOverTab	sta  TextHPos	jsr  AdjustForJust	clc	adc  TextHPos	ldy  #GrafPort.PnLoc.h	sta  [DrawPortPtr],y	dec  SelcEndOffset	bne  @1	ldy  #GrafPort.PnLoc.h	lda  [DrawPortPtr],y	sta  TempRect.right	lda  #$FFFF	sta  SelcEndOffset@1	dec  SelcStartOffset	bne  @2	ldy  #GrafPort.PnLoc.h	lda  [DrawPortPtr],y	sta  TempRect.left	lda  #$FFFF	sta  SelcStartOffset@2	pla	sta  TextHPos	bra  nextPart;---------------------------------------------------------------allDone	ldy  #TERecord.SelectionActive	lda  [RecordPtr],y	bmi  skipInvert	ldy  #TERecord.SelectionState	;if the selection is not on the screen	lda  [RecordPtr],y		;..then don't draw it	bpl  skipInvert	jsr  IsTheSelectionACaret	beq  skipInvert	ldy  #TERecord.SelectionStart	jsr  GetRecordLong	cmpl LineEndOffset	bge  skipInvert	cmpl LineStartOffset	bge  @useLeft	lda  LineStartLeft	sta  TempRect.left@useLeft	ldy  #TERecord.SelectionEnd	jsr  GetRecordLong	cmpl LineStartOffset	blt  skipInvert	cmpl LineEndOffset	blt  @useRight	bne  @useEdge	jsr  IsOffsetAtEnd	bne  @useEdge	ldy  #TERecord.LineAtEndFlag	lda  [RecordPtr],y	beq  @useRight@useEdge	ldy  #GrafPort.PortRect.right	lda  [DrawPortPtr],y	sta  TempRect.right@useRight	lda  TempRect.left	cmp  TempRect.right	beq  skipInvert	ldy  #TERecord.FilterProc+1	lda  [RecordPtr],y	beq  @noFilter	jsr  PassTempRect		;pass the TempRect in the TERecord	lda  #doHilightBuffer	;call the filter proc	jsr  CallFilterProc	bne  skipInvert@noFilter	PushZPtr TempRect	_InvertRect;---------------------------------------------------------------skipInvert	jsr  SetWindowPort	lda  DrawRect.top	cmp  TextVPos	bmi  @noClip1	beq  @noClip1	tax	sec	sbc  TextVPos	sta  TempRect.top	stx  TextVPos@noClip1	lda  TempRect.bottom	clc	adc  TextVPos	cmp  DrawRect.bottom	bmi  @noClip2	lda  DrawRect.bottom	sec	sbc  TextVPos	clc	adc  TempRect.top	cmp  TempRect.bottom	bge  @noClip2	sta  TempRect.bottom@noClip2	jsr  FastPPToPort	lda  TextVPos	sec	sbc  TempRect.top	sta  TextVPos	PushZLong DataBufferHandle	jsr  UnlockHandle	jsr  UnlockHandle		;this unlock's the block handle	movl LineEndOffset,TextOffset	;set textoffset to the end of the line	rts;---------------------------------------------------------------	ENDP****************************************************************DoDraw	PROCNAME  Export;---------------------------------------------------------------	jsr  CheckInvisible		;if invisible, then skip drawing	jsr  GetViewRect		;clip the draw rect to the view rect	lda  TempRect.top	cmp  DrawRect.top	bmi  @1	sta  DrawRect.top@1	lda  TempRect.left	cmp  DrawRect.left	bmi  @2	sta  DrawRect.left@2	lda  TempRect.bottom	cmp  DrawRect.bottom	bpl  @3	sta  DrawRect.bottom@3	lda  TempRect.right	cmp  DrawRect.right	bpl  @4	sta  DrawRect.right@4	lda  DrawRect.left		;check to see if the remaining DrawRect	cmp  DrawRect.right		;..is empty. If it is, then exit	bpl  @exit	lda  DrawRect.top	cmp  DrawRect.bottom	bpl  @exit	lda  DrawRect.top	sta  TextVPos	jsr  VPosToOffset	bcs  doExtra	bra  drawLoop@exit	rts;---------------------------------------------------------------drawLoop	jsr  IsOffsetAtEnd	beq  doExtra	jsr  FindLineInfo	pei  LineHeight	jsr  DrawLine	pla	clc	adc  TextVPos	sta  TextVPos	cmp  DrawRect.bottom	bmi  drawLoop	bra  allDone;---------------------------------------------------------------doExtra	lda  TextVPos	cmp  DrawRect.top	bge  @1	lda  DrawRect.top@1	sta  TempRect.top	lda  DrawRect.bottom	sta  TempRect.bottom	lda  DrawRect.left	sta  TempRect.left	lda  DrawRect.right	sta  TempRect.right	jsr  ClipAndEraseRect;---------------------------------------------------------------allDone	ldy  #TERecord.SelectionActive	lda  [RecordPtr],y	bmi  inactive;---------------------------------------------------------------active	jsr  IsTheSelectionACaret	bne  exit	ldy  #TERecord.SelectionState	lda  [RecordPtr],y	bpl  exit	jsr  makeCaretRect	brl  ClipAndInvertRect;---------------------------------------------------------------inactive	jsr  GetTEHighFlags		;check to see if we are drawing an	and  #fDrawInactiveSelc	;..inactive selection. If not, then exit	beq  exit	PushLongSpace		;save the old clip region handle	_GetClipHandle	jsr  GetNewRgn		;get a temporary region	PushAX		;push a copy for _DisposeRgn	PushAX		;push a copy for _SetClipHandle	PushAX		;push a copy for _SectRgn	PushAX		;push a copy for _RectRgn	PushZPtr DrawRect	_RectRgn	lda  15,s		;push a copy of the old clip region	pha	lda  15,s	pha	lda  7,s		;push a copy of the temp region	pha	lda  7,s	pha	_SectRgn	_SetClipHandle	jsr  DoInvertInactive	jsr  KillRgn		;kill the temp region	_SetClipHandle		;reset the original clip handleexit	rts;---------------------------------------------------------------;---------------------------------------------------------------makeCaretRect	jsr  GetSelectionStart	jsr  CachedOffsetToPoint	bcs  @exit	jsr  FindLineInfo	lda  TextVPos	cmp  DrawRect.top	bpl  @topOK	lda  DrawRect.top@topOK	sta  TempRect.top	lda  TextVPos	clc	adc  LineHeight	cmp  DrawRect.bottom	bmi  @bottomOK	lda  DrawRect.bottom@bottomOK	sta  TempRect.bottom	lda  TextHPos	cmp  DrawRect.left	bpl  @leftOK	lda  DrawRect.left@leftOK	sta  TempRect.left	lda  TextHPos	inc  a	cmp  DrawRect.right	bmi  @rightOK	lda  DrawRect.right@rightOK	sta  TempRect.right	lda  TempRect.top	cmp  TempRect.bottom	bpl  @exit	lda  TempRect.left	cmp  TempRect.right	bpl  @exit	rts@exit	pla	rts;---------------------------------------------------------------	ENDP****************************************************************PaintLine	PROCNAME  Export;---------------------------------------------------------------	DSECT ParameterSpacexRecordHandle	longpaintFlags	wordtheRectPtr	longstartingLine	longtheGrafPort	long;---------------------------------------------------------------;---------------------------------------------------------------	jsr  FindLineStart	lda  SuperLength	ldx  SuperLength+2	beq  @lessThan64K	lda  #$FFFF@lessThan64K	sta  LineLength	jsr  GetLeftEdge	sta  TextHPos	jsr  AdjustForJust	clc	adc  TextHPos	ldy  #Rect.left	adc  [theRectPtr],y	ldy  #GrafPort.PnLoc.h	sta  [theGrafPort],y	lda  TextVPos	clc	adc  LineAscent	ldy  #GrafPort.PnLoc.v	sta  [theGrafPort],y	jsr  FindTextPtr		;find the text pointer and lock the block	PushZLong BlockHandle	;..that contains it. Also save a copy for	PushZLong BlockHandle	;..unlocking it	jsr  LockHandle	ldy  LineLength	beql allDone	dey	lda  [TextPtr],y	and  #$00FF	cmp  #CR	bne  @notACR	dec  LineLength	beql allDone@notACR;---------------------------------------------------------------partLoop	jsr  FindStyleInfo	jsr  GetSuperCount	cmp  LineLength	blt  @saveCount	lda  LineLength@saveCount	sta  TextCount	ldy  #0		;if there is a TAB in the part then stop	shortm		;..at it.@loop	lda  [TextPtr],y	cmp  #TAB	beq  @foundTab	iny	cpy  TextCount	blt  @loop@foundTab	longm	sty  TextCount	tya		;this compares with zero	beq  @skipDraw	lda  paintFlags	and  #fDontDraw	bne  @skipDraw	PushZLong DrawPortPtr	movl theGrafPort,DrawPortPtr	jsr  InstallFontAndColor	PushZLong TextPtr		;draw the text.	PushZWord TextCount	_DrawText	jsr  ReleaseFont	PullLong DrawPortPtr@skipDraw	ldy  TextCount		;if we moving to the last character of	cpy  LineLength		;..the line, then don't check the next	beq  @skip		;..character for a TAB	ldy  TextCount	lda  [TextPtr],y	and  #$00FF	cmp  #TAB	beq  doTab@skip	lda  TextCount		;move the TextOffset forward.	addl TextOffsetnextPart	lda  TextCount		;move the TextPtr forward.	addl TextPtr	lda  LineLength		;reduce the line length	sec	sbc  TextCount	sta  LineLength	beq  allDone	brl  partLoop;---------------------------------------------------------------doTab	inc  TextCount	lda  TextCount		;move the TextOffset forward.	addl TextOffset	ldy  #GrafPort.PnLoc.h	lda  [theGrafPort],y	ldy  #Rect.left	sec	sbc  [theRectPtr],y	sta  TextHPos	jsr  MoveOverTab	sta  TextHPos	jsr  AdjustForJust	clc	adc  TextHPos	ldy  #Rect.left	adc  [theRectPtr],y	ldy  #GrafPort.PnLoc.h	sta  [theGrafPort],y	bra  nextPart;---------------------------------------------------------------allDone	jsr  UnlockHandle		;this unlock's the block handle	incl TheLineNumber	rts;---------------------------------------------------------------	ENDP****************************************************************EraseFrame	PROCNAME  Export	jsr  SaveBackground	stz  TempWord	jsr  GetTEHighFlags	and  #fDrawBounds	beq  @noFrame	dec  TempWord@noFrame	ldy  #TERecord.BoundsRect	ldx  #0@loop	lda  [RecordPtr],y	bit  TempWord	bpl  @2	cpx  #4	blt  @1	dec  a	bra  @2@1	inc  a@2	sta  DrawRect,x	sta  TempRect,x	iny	iny	inx	inx	cpx  #8	blt  @loop	jsr  GetVertScrollBar	beq  @noBar	stax TempPtr	jsr  DerefTempPtr	ldy  #CtrlRecord.ctlRect.left	lda  [TempPtr],y	sta  DrawRect.right	sta  TempRect.right@noBar	ldy  #TERecord.ViewRect.top	lda  [RecordPtr],y	sta  TempRect.bottom	jsr  EraseTempRect	ldy  #TERecord.ViewRect.bottom	lda  [RecordPtr],y	sta  TempRect.top	mov  DrawRect.bottom,TempRect.bottom	jsr  EraseTempRect	ldy  #TERecord.ViewRect.left	lda  [RecordPtr],y	sta  TempRect.right	mov  DrawRect.top,TempRect.top	jsr  EraseTempRect	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	sta  TempRect.left	mov  DrawRect.right,TempRect.right	jsr  EraseTempRect	jsr  RestoreBackground	rts	ENDP****************************************************************SetupColorPtr	PROCNAME  Export	ldy  #TERecord.ColorRef	jsr  GetRecordLong	stax TempPtr	ora  TempPtr+2		;check for a zero ref and use defaults	beq  @useDefaults	ldy  #TERecord.CtrlMoreFlags	lda  [RecordPtr],y	and  #colorIsMask	cmp  #colorIsPointer	beq  @done		;0 is pointer so all done	cmp  #colorIsHandle	beq  @IsHandle@IsResource	ldy  #rTEColorTable	ldax TempPtr	jsr  LoadResource	stax TempPtr@IsHandle	jsr  DerefTempPtr@done	rts@useDefaults	ldax #defaultColors	stax TempPtr	rtsdefaultColors	dc.w  $FFFF		;white inside	dc.w  $0000		;black bounding box	dc.w  $0000		;black hilight color	dc.w  $0000		;black caret color	dc.w  0		;vert scroll bar verb	dc.l  0		;vert scroll bar ref	dc.w  0		;horz scroll bar verb	dc.l  0		;horz scroll bar ref	dc.w  0		;grow box verb	dc.l  0		;grow box ref	ENDP****************************************************************ClipTempRect	PROCNAME  Export	lda  TempRect.top		;check for a null rect	cmp  TempRect.bottom	bpl  empty	lda  TempRect.left	cmp  TempRect.right	bpl  empty	ldy  #TERecord.ViewRect.top	lda  [RecordPtr],y	cmp  TempRect.top	bmi  @1	beq  @1	sta  TempRect.top@1	cmp  TempRect.bottom	bpl  empty	ldy  #TERecord.ViewRect.left	lda  [RecordPtr],y	cmp  TempRect.left	bmi  @2	beq  @2	sta  TempRect.left@2	cmp  TempRect.right	bpl  empty	ldy  #TERecord.ViewRect.bottom	lda  [RecordPtr],y	cmp  TempRect.bottom	bpl  @3	sta  TempRect.bottom@3	cmp  TempRect.top	bmi  empty	beq  empty	ldy  #TERecord.ViewRect.right	lda  [RecordPtr],y	cmp  TempRect.right	bpl  @4	sta  TempRect.right@4	cmp  TempRect.left	bmi  empty	beq  empty	clc	rtsempty	sec	rts	ENDP****************************************************************Draw2Proc	PROC	EXPORT ClipAndInvertRect	EXPORT ClipAndEraseRect;---------------------------------------------------------------ClipAndEraseRect	PushZLong TempRect	PushZLong TempRect+4	jsr  ClipTempRect	bcs  cleanup	jsr  SaveBackground	jsr  EraseTempRect	jsr  RestoreBackground	bra  cleanup;---------------------------------------------------------------ClipAndInvertRect	jsr  CheckInvisible		;if invisible, then skip drawing	PushZLong TempRect	PushZLong TempRect+4	jsr  ClipTempRect	bcs  cleanup	ldy  #TERecord.FilterProc+1	lda  [RecordPtr],y	beq  @noFilter	jsr  PassTempRect		;pass the TempRect in the TERecord	lda  #doHilightRect		;call the filter proc	jsr  CallFilterProc	bne  cleanup@noFilter	jsr  InvertTempRect;---------------------------------------------------------------cleanup	PullLong TempRect+4	PullLong TempRect	rts;---------------------------------------------------------------	ENDP****************************************************************EraseTempRect	PROC  ENTRY;---------------------------------------------------------------	ldy  #TERecord.FilterProc+1	lda  [RecordPtr],y	beq  @noFilter	jsr  PassTempRect		;pass the TempRect in the TERecord	lda  #doEraseRect		;call the filter erase	jsr  CallFilterProc	bne  allDone@noFilter	PushZPtr TempRect	_EraseRect;---------------------------------------------------------------allDone	ldy  #TERecord.FilterProc+1	lda  [RecordPtr],y	beq  @noFilter	jsr  PassTempRect		;pass the TempRect in the TERecord	lda  #doRectChanged		;call the filter proc	brl  CallFilterProc@noFilter	rts;---------------------------------------------------------------	ENDP****************************************************************CheckInvisible	PROCNAME  Export	jsr  AreWeInvisible	beq  @nope	pla		;pull the return address to skip a level@nope	rts	ENDP****************************************************************GetNewRgn	PROCNAME  Export	PushLongSpace	_NewRgn	PullAX	rts	ENDP****************************************************************ZeroTempRect	PROCNAME  Export	stz  TempRect.top	stz  TempRect.left	stz  TempRect.bottom	stz  TempRect.right	rts	ENDP****************************************************************GetPort	PROCNAME  Export;---------------------------------------------------------------PortRef	equ  36;---------------------------------------------------------------;---------------------------------------------------------------	ply	ldx  QDDirectPage	lda  >PortRef+2,x	pha	lda  >PortRef,x	pha	phy	rts;---------------------------------------------------------------	ENDP****************************************************************SetPort	PROCNAME  Export	ply		;get the return address into Y-Reg	pla		;get the port pointer into A-Reg and X-Reg	plx	phy		;push the return address back on the stack	phx		;push the port pointer back on the stack	pha	_SetPort	rts	ENDP****************************************************************	END