+4PZ_pPrPort	equ PZ_pdevBuf+4PZ_hPrint	equ PZ_pPrPort+4portsize	equ 172; Printer Driver callsoPrintDefault	equ 0*4oPrValidate	equ 1*4oPrStlDialog	equ 2*4oPrJobDialog	equ 3*4oPrDrvrVer	equ 4*4 oPrOpenDoc	equ 5*4oPrCloseDoc	equ 6*4oPrOpenPage	equ 7*4oPrClosePage	equ 8*4oPrPicfile	equ 9*4oPrControl	equ 10*4oPrError	equ 11*4oPrSetError	equ 12*4oGetDeviceName	equ 13*4oPrPixelMap	equ 14*4oPrGetPrinterSpecs	equ 15*4oPrGetPgOrientation	equ 16*4; Port Driver callsoDevPrChanged	equ 0*4oDevStartup	equ 1*4oDevShutdown	equ 2*4oDevOpen	equ 3*4oDevRead	equ 4*4oDevWrite	equ 5*4oDevClose	equ 6*4oDevStatus	equ 7*4oDevAsyncRead	equ 8*4oDevWriteBack	equ 9*4oPrPortVer	equ 10*4 oDevIsItSafe	equ 11*4oNextNewPortCall	equ 12*4	; NOTE: this is a place holder name only, use this		; constant for the next new port driver calllenentry	equ 20Init	equ $01RegisterName	equ $0ERemoveName	equ $0FLookUpName	equ $10ConfirmName	equ $11pTemp	equ $0;------------------------------------------;; Equates from procedure ReadDirData;;------------------------------------------ListEntrySize	equ 38	; 33 + 4 + 1