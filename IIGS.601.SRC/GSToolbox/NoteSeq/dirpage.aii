	pagesize 71;------------------------------------------;; Equates from procedure ;;------------------------------------------doneflag  equ      0                   ; set if seq is completed (0 StartSeq)flag1     equ      doneflag+2          ; user flag 1             (0            flag2     equ      flag1+1             ; user flag 2              0flag3     equ      flag2+1             ; user flag 3              0flag4     equ      flag3+1             ; user flag 4              0flag5     equ      flag4+1             ; user flag 5              0flag6     equ      flag5+1             ; user flag 6              0flag7     equ      flag6+1             ; user flag 7              0flag8     equ      flag7+1             ; user flag 8              0 SAppStart)inpattp   equ      flag8+1             ; in pattern flag  0,FFFF. 0 StartSeq.mode      equ      inpattp+2           ; Sequencer mode async/synctickfract equ      mode+2              ; fractional tick incrementtickcount equ      tickfract+2         ; tick count for seq itemsincrement equ      tickcount+2         ; how many facts per countd1        equ      increment+2         ; first scratch registerd2        equ      d1+4                ; second scratch registerd3        equ      d2+4                ; third scratch registerseq       equ      d3+4                ; the current sequence itemcurphrase equ      seq+4               ; current pattern in phrase.curpatt   equ      curphrase+2         ; current seqitem in pattern.level     equ      curpatt+2           ; depth in table of phrases.delaytime equ      level+2             ; tick count to start on againcomplrout equ      delaytime+2         ; completion routinemididp    equ      complrout+4         ; the dp for midi.numinsts  equ      mididp+2            ; number of instruments in inst table.insttab   equ      numinsts+2          ; pointer to the instrument tableRelAddr	  equ      insttab+4		   ; relative address used, MyFlags has bank.MyFlags   equ      RelAddr+2           ; low byte RelAddress bank.									   ; flag for interrupt handler, try to quit.errhandlr equ      MyFlags+2           ; ptr to users error handler.databank  equ      errhandlr+4         ; the users data bank reg.SysExlDB  equ      databank+2          ; the data bank used for SysExl Cmd.SeqItem  equ  SysExlDB+2               ; space to save the current seq item.maxduration equ SeqItem+4NoteOnAddr     equ maxduration+2NoteOffAddr    equ noteonaddr+4AllocAddr      equ noteoffaddr+4MidiWriteAddr  equ allocaddr+4phrasetab equ      $100-166                 ; 90gentab    equ      $100-70           ; information for generatorsgentabdur equ      $100              ; information for generatorsgentabdur1 equ      $00              ; information for generatorsgentabtrk equ      $140              ; information for generatorsgentabtrk1 equ      $40              ; information for generatorstrkinfo   equ      $200-128  ; the track info tablebase      equ      0ignoreint equ      $8000notignoreint equ      $7FFFnottrytoquit equ	   $BFFFtrytoquit equ		$4000curtrk    equ      d2                  ; the track we are playing on curgen    equ      d2+2* MIDIInputPoll	equ		$E11DD8			; address for polling midi. get from E16.midi.********************************************************************************* File SEQDIRPAGE.A -- Direct page equates for the Note Sequencer** Copyright nineteen eighty seven too nineteen eighty eight.* All rights reserved. Apple Computer, Inc. '87-'88/'88.**   Modification History**   5 Jan 87     JW     New Today*   2 Feb 87     JW     Added generator table stuff*  14 Mar 88   MD    Added SeqItem, switch away from saving seq item on stack.*************************************************************************************************************************************************************** Note that the first 10 bytes are accessible by the application.            ** They can never be moved!!!!                                                *******************************************************************************;$10;$20;$30;$40;$56;end;$5A or 90.******************** - Start Of Phrase Table - ********************************** the Phrase table is an array of 12 8 byte entries.* it is always the last thing in the first page of direct page* The entries are arranged as:;         phrase low          1 word;         phrase hi           1 word;         index               1 word;         scratch             1 word******************* - End Of Phrase Table - ****************************************************** - Start Of Generator Table - ******************************** generator table -- This table contains the information we need for dealing* with note synthesizer it looks like:  ;         duration  1 word       $8080;         semitone  1 word       $8080;         track     1 byte       $80* The following is information for keeping track of MIDI Voices.;          duration 1 word        $8000;          track    1 byte (Hi)   $80  low nibble is channel #;          Semitone 1 byte (Low)  $00******************* - End Of Generator Table - *************************************************** - Start Of Track Info Table - *****************************; the track info table contains various pieces of information about the; individual tracks. There are 8 bytes used per track. It is broken; down as follows:;         priority   -word;         scratch    -word     low nibble is midi channel, msb 1 if midi.;         instrument -long     zero if no internal voices.; ; The scratch is there because I'm sure I'll find something that will have; to be placed in here.******************* - End Of Track Info Table - *******************************