;------------------------------------------;; Equates from procedure seqdata;;------------------------------------------seqwap         equ    $E1017E           ; Sequencer's not Schedulers.seqtnum        equ    26                ; The Note Sequencers Tool Number.ver_num        equ    $0104             ; prototype bit taken out 5/31/89, HY.gstatreg       equ    $E1C03Cgdatareg       equ    $E1C03Dgadrl          equ    $E1C03Egadrh          equ    $E1C03Fsysvol         equ    $E100CAdoc_ctrl       equ    $A0timer_osc      equ    $0Edoc_irq_bit    equ    $08doc_halt_bit   equ    $01doc_halt_mask  equ    $FENSPollVer		equ		$0103		; version 1.2 of N.Synth polls midi.errNSWrngVer	equ		$1A07		; error N.Synth is an incompatible version.********************************************************************************** Copyright nineteen eighty seven too nineteen eigthy eight.* All rights reserved. Apple Computer, Inc. '87-'88/'88.******************************************************************************************************************************************************************* File SEQ.DATA.ASM** Miscellaneous system dependant equates for the note sequencer.** 6 Jan 87     JW New Today*********************************************************************************		EXPORT	seqdata  seqdata  PROC; The Error Equates.; sound glu equates		ENDP