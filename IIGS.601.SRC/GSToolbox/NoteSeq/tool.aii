************************************************************************ Note Sequencer** Copyright Apple Computer 1987-1988* All Rights Reserved*** Change History** 28 Jun 88	Steven Glass** Removed all export statements.  Changed name of SeqFPT to * NoteSeqCallTable and exported it.  Formatted the file with* AsmMatIIGS.** 7 July 88	Matt Denman** Changed version number.  Changed short and long to use all.macros equ.* I also now use the standard all.macros not my own. I also include the * equates files for: Midi, NoteSeq.  Also fixed problem of handling errors* SeqStartUp.***********************************************************************	string asis	blanks off	pagesize 71	print NOGEN, NOMDIR, NOHDR, pushstrip	equ $E10184;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	print off	ENTRY AllocGlue	ENTRY ErrorHndlr	ENTRY FindVol	ENTRY Midi2Out	ENTRY Midi3Out	ENTRY MidiCntrlChng	ENTRY MidiNoteOff	ENTRY doMidiNoteOn	ENTRY doMidiPitchBend	ENTRY doMidiPolyKey	ENTRY MidiPressureChng	ENTRY MidiProgramChng	ENTRY MidiSelctChnlMode	ENTRY MidiSysExl	ENTRY MidiSystemCommon	ENTRY MidiSystemRealTime	ENTRY MidiWriteGlue	ENTRY NotImp	ENTRY NotImp2	ENTRY NoteOffGlue	ENTRY NoteOnGlue	ENTRY SysExlDataBank	ENTRY TickWrap	ENTRY allnoteoff	ENTRY callcmplt	ENTRY callRoutine	ENTRY checkoff	ENTRY chngtempo	ENTRY clearincr	ENTRY clrgentabls	ENTRY decflag	ENTRY deref	ENTRY dopbend	ENTRY endcall	ENTRY errout	ENTRY finddur	ENTRY findtone	ENTRY findtrk	ENTRY findval2	ENTRY getloc	ENTRY gettime	ENTRY doifgo	ENTRY incflag	ENTRY instn2ptr	ENTRY dojump	ENTRY justmidi	ENTRY noteoff	ENTRY noteon	ENTRY oendcall	ENTRY oerrout	ENTRY plypatt	ENTRY progchng	ENTRY quitsequence	ENTRY seqactive	ENTRY seqappst	ENTRY seqboot	ENTRY seqint	ENTRY seqreset	ENTRY seqshtdwn	ENTRY seqvers	ENTRY setflag	ENTRY setincr	ENTRY setinst	ENTRY settrkinfo	ENTRY startint	ENTRY startseq	ENTRY startseqrel	ENTRY starttimer	ENTRY stepseq	ENTRY stopint	ENTRY stopseq	ENTRY turnseqnotesoff	ENTRY vibdepth	MACHINE M65816	INCLUDE 'E16.MIDI';	INCLUDE 'E16.NoteSeq';; 2/2/90 Mensch; The following equates were added from the e16.NoteSeq file because that files can not be; included due to the number of symbol conflicts;noRoomMidiErr EQU $1A00noCommandErr EQU $1A01  ; can't understand the current SeqItemnoRoomErr EQU $1A02  ; sequence is more than twelve levels deepstartedErr EQU $1A03  ; Note Sequencer is already startednoNoteErr EQU $1A04  ; can't find the note to be turned off by the current SeqItemnoStartErr EQU $1A05  ; Note Sequencer not started yetinstBndsErr EQU $1A06  ; Instrument number out of Instrument boundary rangensWrongVer EQU $1A07  ; incompatible versions of NoteSequencer and NoteSynthesizer; offset constants for LocRecocurPhraseItem EQU 0ocurPattItem EQU 2ocurLevel EQU 4;;	INCLUDE 'all.macros'; private macros	macro&lab	SetMode16&lab	rep #$30	longa on	longi on	ENDM	macro&lab	SetMode8&lab	sep #$30	longa off	longi off	ENDM	INCLUDE 'chng.his.aii'	INCLUDE 'dirpage.aii'	INCLUDE 'data.aii'	print pop**********************************************************************************    File SEQ_TOOL_A -- Note Sequencer Function Pointer Table*	    Required Tool Calls** Copyright nineteen eighty seven too nineteen eighty eight.* All rights reserved. Apple Computer, Inc. '87-'88/'88.**    Modification History**    5 Jan 87	    JW    New Today*   17 Feb 87	    JW    Completely re-wrote the required calls*    2 June 87	    JW    Converted	to APW from MPW*   10/6/88	MD	Added Relative Address stuff.*********************************************************************************NoteSeqCallTable	PROC EXPORTFPT	DC.L $16	; number of calls	DC.L seqboot-1	; 1 - boot init routine	DC.L seqappst-1	; 2 - application startup	DC.L seqshtdwn-1	; 3 - application shutdown	DC.L seqvers-1	; 4 - tool version number	DC.L seqreset-1	; 5 - system reset	DC.L seqactive-1	; 6 - tool initialized?	DC.L notimp-1	; 7 - reserved by system	DC.L notimp-1	; 8 - reserved by system	DC.L setincr-1	; 9 - set increment	DC.L clearincr-1	; 0A - clear increment	DC.L gettime-1	; 0B - get current seq time	DC.L getloc-1	; 0C - get pos in sequence	DC.L allnoteoff-1	; 0D - all notes off	DC.L settrkinfo-1	; 0E - setup the trackinfo info	DC.L startseq-1	; 0F - play the sequence	DC.L stepseq-1	; 10 - play next item	DC.L stopseq-1	; 11 - stop seq being played	DC.L setinst-1	; 12 - set inst table	DC.L startint-1	; 13 - start NS interrupt	DC.L stopint-1	; 14 - stop NS interrupt	DC.L startseqrel-1	; 15 - play the relative sequence.	ENDP**********************************************************************************  seqboot -- call number 1**  This routine is called when the sequencer is first loaded into*  ram. Nothing is actually done until the startup call**  Inputs: none**  Outputs: none**  Errors: none**  Registers: not preserved*********************************************************************************seqboot	PROC	ldy #$00	jmp oendcall	; I told you it did	nothing	ENDP***************** -	SeqStartUp - Call Number 2 - *********************************			                   **  seqstartup -- call number 2		                   **			                   **  This routine handles intializing the	Note Seq., Note Synth. and Sound Tools.**  It requires 3 pages of direct page:		                   **        1 goes to sound tools/note synthesizer.	                   **        2 go to the sequencer.		                   **			                   **			                   **  Inputs:     direct page : word < top	of stack >	                   **              mode	       : word  ; 0 = async 1 = sync 2-FFFF not defined     **	             If High Bit set might use MidiTools           **              update_rate : word ; 500	= 200hz	                   **              increment   : word ; how	many fracts per tick                   **			                   **  Outputs:    none			                   **			                   **  Errors:     returns StartedErr NSStartUp and SoundStart errors              **			                   **  Calls:      ClrGenTabls, StopTimer, SetWap.	                   **			                   **  Sets Up:    synthdp, seqwap, databank, mode, increment, gentables, all flags**              tickfract, and tickcount.	                   **			                   **  History:    3-7-88   Cleaned up format.	                   **	    Added StartedErr.	                   **              3/14/88  Only do 4 stz to clear flags 1-8.	                   **	    Adjusted phb so	that I could use only one error entry. **	    Fixed error of bad stack if N.Synth	is already started.**              6/30/88  Moved set wap to end of call, after nsstartup.         **                       This way I don't think I'm started when I'm not.       **              7/6/88   Deleted started error section that wasn't being used,  **                       and fixed bug were I didn't set my wap correctly.      *********************************************************************************seqappst	PROC*         using	seqdatadirpage	equ 15	; some equates for stackrel stuffmode1	equ 13update1	equ 11incr	equ 9rtls	equ 3-8olddp	equ 1	; old direct page	phd	; old dir page on stack	tax	; set my flags.	beq goon	; if zero than no wap so not started.	lda #StartedErr	; get error code, (cary not effected).	jmp error	; return the error.goon	phb	; their bank.	phb	lda dirpage+2,s	tax	; save it till after we setup dp	clc	adc #$100	; our dirpage is the last two pages	tcd	sta >seqwap	; also so we don't getwap in int hndlr; save their databank	pla	; get their bank.	and #$00FF	; only want one byte.	sta databank	; save their bank.; first we initialize the sound tools. If something bad happens here,; then there is no point in going further.	pha	; space for NSVersion	_NSVersion	; Make sure it's midi polling ver.	pla	and #$7FFF	; Don't care if it's a prototype.	cmp #NSPollVer	; version with midi	polling.	bcs @0	; if set version is	ok.	lda #errNSWrngVer	; wrong version error number.	jmp error	; report error and quit.@0	lda dirpage,s	; initialize the sound tools	pha	_soundstartup	bcc @1	jmp error; now store the id and the mode in direct page@1	lda mode1,s	sta mode	; put mode in direct page	bmi A2	jmp nomidiA2	pushlong #0	; space for result.	pushword #0	; system tool.	pushword #$0E20	; midiwritepacket call number.	_GetFuncPtr	pla	; save address in MidiWriteAdd.	sta MidiWriteAddr	pla	sta MidiWriteAddr+2nomidi	pushlong #0	; space for result.	pushword #0	; system tool.	pushword #$0B19	; midiwritepacket call number.	_GetFuncPtr	pla	; save address in MidiWriteAdd.	sta NoteOnAddr	pla	sta NoteOnAddr+2	pushlong #0	; space for result.	pushword #0	; system tool.	pushword #$0C19	; midiwritepacket call number.	_GetFuncPtr	pla	; save address in MidiWriteAdd.	sta NoteOffAddr	pla	sta NoteOffAddr+2	pushlong #0	; space for result.	pushword #0	; system tool.	pushword #$0919	; midiwritepacket call number.	_GetFuncPtr	pla	; save address in MidiWriteAdd.	sta AllocAddr	pla	sta AllocAddr+2	lda incr,s	sta increment; make sure that we	zero out the counters as a matter of general; principle.	stz tickfract	; zero out counters	stz tickcount	stz maxduration; Clear out the variables needed for _GetLoc.	lda #$FFFF	sta doneflag	stz complrout	; mark no comp routine.	stz complrout+2	; incase someone does a _StopSeq		; before a _startSeq	stz level	stz curpatt	stz curphrase; Clear all of the user flags. (flags are 1 byte, writing two bytes)	stz flag1*         stz	flag2	stz flag3*         stz	flag4	stz flag5*         stz	flag6	stz flag7*         stz	flag8; Clear the genarator table	jsr clrgentabls; I need to initialize the note synthesizer so that I can have it call me; during it's interupts.  However, I don't want it to interrupt if I'm ; not playing. So once the note synthesizer is started I turn off the; interrupt and don't turn it back on until I am done playing a sequence.; So an application	must make a startints call after starting the note seq.; and before they want to make note synth calls.; Interupts disabled.	php	sei	; No Interupts.	lda #ignoreint	sta MyFlags	lda update1+1,s	; initialize the note synth	pha	; +1 because of php	above	lda mode	and #$0001	bne noupdates	pushlong #seqint	; update routine for sequencer	bra gogonoupdates	pushlong #$0000gogo	_nsstartup	bcs errorp	plp	; ints back on.; Interupts enabled.; set the wap showing that the sequencer is started up.; and so the tool locator will keep track of the direct page for us.	pea 00	; system tool	pea seqtnum	; tool number 26	pea 00	lda >seqwap	; get the seqwap	pha	; direct page for seq	_setwap; restore the direct page and cleanupendc	pld	; restore old direct page	ldy #$08	jmp oendcallerrorp	plp	pha	; save the error code.	_SoundShutDown	pla	; restore the error	code.error	pld	ldy #$08	tax	lda #0	sta >seqwap	; cancel the dp since error.	jmp oerrout	ENDP*********************************************************************************  seqshutdown -- call number 3**  Inputs: none**  Outputs: none**  Errors: NSNotInit**  Calls:      _SetWap, _NSShutDown, _SoundShutDown.**  Registers: none preserved**  Assumes:    WAP in A from tool locator is zero if we don't have one.*              If we don't have a WAP we weren't started.**  History:    3/14/88 now I check to see if I'm started after my tcd.*              3/28/88  rewrote comments. add Calls:********************************************************************************seqshtdwn	PROC*         using	seqdata	phd	; push old dir page	tcd	; get my dirpage and set z bit.	php	sei	beq myerror	; if 0, no dp and I	didnt get started.	pea 00	; system	pea seqtnum	; tool 26	pea 00	; new WAP = 00	pea 00	_SetWAP	lda #$00	sta >seqwap	; zero out the stash also - just in case	_nsshutdown	; shutdown the note	synth	bcs error	; if error process it.	_soundshutdown	; shutdown the sound tools	plp	ldy #$00	jmp endcall	; bye byemyerror	lda #nostarterrerror	plp	ldy #$00	tax	jmp errout	ENDP;---------------------------------------------------------------;;  seqversion -- call number 4;;  Inputs:;;  Outputs: version	number : word;;  Errors: none. Should never have any.;;---------------------------------------------------------------seqvers	PROC*         using	seqdata	lda #ver_num	sta 7,s	ldy #$00	jmp oendcall	ENDP*********************************************************************************			                   **  seqreset -- call	number 5		                   **			                   **  If Sequencer is started up then I TurnSeqNotesOff.	                   **			                   **  Inputs:     none			                   **			                   **  Outputs:    none			                   **			                   **  Errors:     none			                   **			                   **  History:    3/14/88  Started to reformat.	                   **              3/28/88  Now I check to see if I'm started.                     **              9/19/88  Use end call routine that pulls D-reg                  *********************************************************************************seqreset	PROC	phd	; save old direct page.	tcd	; set my direct page.	beq exit	; if no dp then quit.	jsr turnseqnotesoffexit	ldy #$00	jmp endcall	; do nothing for now	ENDP*********************************************************************************			                   **  seqactive -- call number 6		                   **			                   **  This routine makes the assumption that if the WAP is non-zero               **  then we have been initialized.		                   **			                   **  Inputs:     none			                   **			                   **  Outputs:    status : word	; 0 = unactive, ~0 = active            **			                   **  Errors:     none			                   **			                   **  History:    3/0?/88  Now I do a tax instead of a pha, pla to set cnd codes. **			                   *********************************************************************************seqactive	PROC*         using	seqdata	tax	; set condition codes	beq deaddog	; we're not really here	lda #$FFFF	; return truedeaddog	sta 7,s	ldy #$00	jmp oendcall	ENDP;---------------------------------------------------------------;;  NotImp;  a generic dummy call for all occasions;;  Inputs:;;  Outputs:;;---------------------------------------------------------------notimp	PROC	ldy #$00	jmp oendcall	; do nothing	ENDP; the dreaded include files;          copy	 seq.play.asm; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.*********************************************************************************			                   **  PlaySeq			                   **			                   **  Main code for sequence interpreter.		                   **			                   **  This routine is called from the interrupt handler when the count is         **  incremented. It assumes that there is a pointer to a phrase in the          **  phrase table. This is setup initially by the StartSeq call. The             **  phrase table is added to by this routine.	                   **			                   **			                   **  Errors:     noroomerr,		                   **              PlyPatt errors		                   **			                   **  Calls:      PlyPatt, CallCmplt, ErrorHndlr, StopTimer.	                   **			                   **  History:    2/9/87   New Version of player by JW	                   **              3/14/88  Started to change the formatt.	                   **	    Put in chages discussed by Don and I. MD.              **	    Rewrote: go_on2, phrdone, notyet, gotphrase.           **	    inc dp, lda dp -> lda dp, inc a, sta dp.               **	    Relocated exit and error to avoid brl.                 **	    Changed branching of error after jsr plypatt.          **	    Reset location information before quiting.             **              3/16/88  Changed jmp callcmplt to quitsequence                  **	10/6/88  Added RelAddr to pointers.	                   **			                   *********************************************************************************playseq	PROC*         using	seqdata; The main part;; The logic goes something like this:;; First check inpattp, FFFF if in it 0 if not in a pattern.	 If in a patt; then go straight to play pattern.  Then check again and if still in a patt; quit because we hit a delay. Otherwize go on to get a pattern.;; 1.) we look at the first item in the phrase and if its a termination;   item then we terminate and return to the caller.;; 2.) if the first item is another phrase then we call seqplay with that;   phrase.;; 3.) if the item is a pattern then we call plypatt with the pattern;; in the case of 2 or 3 we loop until we find a terminator.; check the pattern	index to see if we belong here.	lda inpattp	; See if we are in the middle of a pat.	beq go_on	; if not parse through to one.	jsr plypatt	; Else start playing the pattern.	bcs error	; if error, return it.noerr	lda inpattp	; Are we still in a	pattern?	beq go_on	; If No parse through to a pattern.	bra exit	; Otherwize exit until next time.; before we go on to play the next item	in the phrase, we need to restore; seq so that it points to the phrase. The current phrase should be in ; the table and indexed by level. Note that if this is the first time; through then StartSeq had better have	set up the table.go_on		; 	lda level	; how deep we are	asl a	; [0..11] of 8 bytes each.	asl a	asl a	tax	lda phrasetab,x	; get the low part	sta seq	lda phrasetab+2,x	; get the high part	sta seq+2	lda phrasetab+4,x	; get the current item index	sta curphrase; since were not in	a pattern, we need to move to the next item in the; phrase and play it.go_on3		; 	stz curpatt	; reset items to seqro	lda curphrase	inc a	; move to next pattern or phrase.	sta curphrase	; save the current patt or phrase.	sta phrasetab+4,x	; save curphrase off	asl a	; make it an index to the next item.	asl a	tay; check for the next item being a terminator. 'seq' is a dir page ; location that always contains a pointer to the current item being; worked on. Here it is assumed that the pointer is to a phrase. In; playpatt 'seq' points to the pattern being played.; If we go to notyet: A = first seq word, y = set to get second seq word.go_on2	lda [seq],y	; current phrase we	are working on.	iny	iny	cmp [seq],y	; see if the same.	bne notyet	; if not then can't be a terminator.	cmp #$FFFF	; if both bytes same, see if $FFFF.	bne notyet	; if not then it must be a terminator.; at this point, we	have finished playing a phrase. One of two things must; be done. ;         1) if the	phrase we finished wasn't the top level then we need;            to pick up where we were prior to the descent. ;         ;         2) if the	phrase was to top level then we need to	call the ;            compleletion routine.;	entry phrdonephrdone		;       	lda level	; get the level.	beq docmplt	; if level zero then done with the seq.*        sec		; get next level.*        sbc   levelsize	; subtract the size	of level(pre Indx).*  do the above when I change level to be pre Indexed.	dec a	; get next level.	sta level	; save new level.	bra go_on	; parse the next item (Phrase pointer).docmplt	stz level	; clear locations for _getloc.	stz curpatt	;	stz curphrase	;	clc	; no error coming into callcmplt.	jmp quitsequence	; quit the sequence.* make error and exit more centrally located for speed of exit.exit	clc	rts; entries into error for loading error codes.ToCommandErr	lda #nocommanderr	bra errorToNoRoomErr	lda #noroomerr; First thing: save	the error code in d3+2.error	sta d3+2	; save error for errorhndlr; Call the error handler	phb	; save my bank.	jsl ErrorHndlr	; call the users error handler.; get my directpage	back	lda >SeqWap	; get my dirpage.	tcd	; and reset my dirpage just incase.; get my bank back.	plb	; get my data bank back.; Now call completion routine.	jmp callcmplt	; quit the sequence.	clc	; dont report err to interupt hndlr.	rts; If its not a terminator, then it had better be a phrase or a pattern.; If its a phrase then we need to do a depth first search uptil we find ; a pattern. Once we find a pattern (or	if we started with one) we need to; set up the variables so that playpatt	is called the next time. notyet		; 	clc	; Add RelAddr to my pointer.	adc RelAddr	;	sta d1	; save the 1st word	of seq pointer.	lda [seq],y	; get the 2nd word of pointer.	sta d1+2	; save in temp space.	lda MyFlags	; get RelAddr high byte.	and #$00FF	; and only the bank.	adc d1+2	; and finally add it.	sta d1+2	; and save it.	ldy #2	; index for high word of ptr.	lda [d1],y	; get the high word.	ora [d1]	; get the tag field	of the header	beq gotpatt	; looks like we got	a pattern; looks like we got	ourselves another phrase. If there is still room in ; the table then we	move the pointer into seq and also into	the phrase; table. Otherwise we return an error.gotphrase	dec a	; see if it was one, now zero.	bne tocommanderr	; if not zero it wasn't a phrase.dophrase	lda level	; where are we in the table?*        cmp   leveltablesize-levelsize	; see if there is any room in table.* do something like	this with symbolic equates.	cmp #$0B	; number of levels - 1.	bcs tonoroomerr	; if no room, return error.*        clc		;*        adc   levelsize	; increment to next	level.	inc a	; increment to next	level.roomleft	sta level	; save the new level	asl a	; turn level into an index	asl a	asl a	tax	lda d1	; move the phrase into the table and seq	sta phrasetab,x	sta seq	lda d1+2	sta phrasetab+2,x	sta seq+2	stz phrasetab+4,x	; initialize curphrase to 00	stz curphrase	jmp go_on3	; play it again, sam.gotpatt	lda d1	; move the pointer into seq	sta seq	lda d1+2	sta seq+2	stz curpatt	lda #$FFFF	sta inpattp	jmp playseq	;go play the pattern now.	ENDP*********************************************************************************			                   **  QuitSequence			                   **			                   **  This is called when the sequence wants to quit.  It makes sure that all     **  notes with durations are turned off before it will quit the sequence.       **			                   **  Calls:      CallCmplt.		                   **			                   **  Sets:       TryToQuit = 0 decremented for each call,	                   **			                   **  Called by:  StopSeq, PlaySeq.		                   **			                   **  History:    3/16/88  New.		                   **			                   *********************************************************************************quitsequence	PROC*        using SeqData	lda tickcount	; get number of ticks.	cmp maxduration	; check if all notes should be off.	bge docmplt	; if should be off callcmplt.	lda #TryToQuit	; set try to quit.	ora MyFlags	sta MyFlags	rtsdocmplt	jsr callcmplt	rts	ENDP*********************************************************************************			                   **  CallCmplt			                   **			                   **  This routine is called when the sequence is through playing.                **  It calls the user supplied completion routine, if there is one.             **  This is also called if there is an abotion due to an error or StopSeq call. **  completetion routine then the done flag is set to $FFFF	                   **			                   **  Assumes:    carry set if error (being called by because an err occured).    **			                   **  Calls:      StopTimer, Users Error Handler.	                   **			                   **  Sets:       DoneFlag = $FFFF.		                   **			                   **  Regesters:  DataBank and DP are preserved.	                   **			                   **  Called by:  StopSeq, PlaySeq.		                   **			                   **  History:    3/14/88  Started to change formatt.	                   **	    Don't set ignoreint, becase it's set by stoptimer.     **			                   *********************************************************************************callcmplt	PROC*        using SeqData	lda #ignoreint	ora MyFlags	sta MyFlagsdocomplt	lda complrout	; check for a completion routine	ora complrout+2	beq nocompl; looks like we have a completion routine so we call it. The routine ; should return with an rtl.; Poll Midi before AllocGenerator.	jsl MIDIInputPoll	phb	; save my bank	phk	; program bank for return.	pea return-1	; push address to return to.	pei complrout+1	; push bytes 3,2 of	complrout.	lda databank	; get their databank	pha	; push junk and their databank.	plb	; get their data bank setup.	lda complrout	; get byte 2, 1 of complrout.	dec a	; make it point correctly.	sta 1,s	; rewrite 2, 1 over	2, and junk.	rtl	; go to complrout.return		; 	plb	; save my databank	lda >seqwap	; get my directpage.	tcd	; set my directpage.; there is no completion routine so we set the done flag and get out; of here.nocompl	lda #$FFFF	sta doneflag	lda #$00	clc	rts	ENDP;          copy	 seq.ppatt.asm*  Copyright nineteen eighty seven too nineteen eighty eight.*  All rights reserved. Apple Computer,	Inc. '87-'88/'88.*********************************************************************************			                   **  plypatt			                   **			                   **  Parses the current pattern and performs the action descibed by the seqitem. **			                   **  History:    2/10/87  New Version by JW.	                   **              3/14/88  Changed Formatt.	                   **	    Rewrote everything.	                   **	    Not putting seq	item on stack any more.                **              3/16/88  Adding code to support turning duration notes.         **			                   *********************************************************************************plypatt	PROC*         using	seqdata; If delaying quit until times up.  Otherwize clr delaytime	and play pattern.ckdelay	lda delaytime	; see if i'm delaying, and how long.	beq cont1	; if no delay continue, else...	cmp tickcount	; see if time is up	yet.	beq clrflg	; if so continue.	bcs exit	; else exit.clrflg	stz delaytime; Turn off all the notes with expired durations.cont1	jsr checkoff	; turn off notes as	appropriate.; Get the next seq item.nxtitem	jsl MIDIInputPoll	lda curpatt	; get the curpatt.	inc a	; make it point to the next one.	sta curpatt	; save the new curpatt.	asl a	; make it into an index	asl a	;	tay	;	lda [seq],y	; get the low part of the item	sta seqitem	; save in seqitem	iny	;	iny	;	lda [seq],y	; get the high part	of the item	sta seqitem+2	; save in seqitem.	cmp seqitem	; see if they are the same.	bne itsok	; if not equal then	not a terminator.	cmp #$FFFF	; check for terminator	bne itsok	; Not FFFF and same	then not a term.	stz inpattp	; ended pattern, not inpattp.*        bra   exit		; done with this patt, move on!exit	clc	; no error.	rts	; exit to plyseq.commanderr	lda #nocommanderr	;error	sec	; error.	rts	; exit to plyseq.********************************************************************************itsok	lda seqitem	; get the low word.	bpl notnote	; if plus then it must be control call.; If it's a rest just set the delay time.	and #$7F00	; Get tone.	beq delayset	; if zero then filler so set the delay.; Must be a note command. If the tone is 0 then we have a filler note. If; volume is 0 then it is a note off.notrest	lda seqitem	; get low word in accum.	and #$7F	; get the volume of	the note	beq offcmd	; vol = 0 is a note	off; turn on the note.	The duration is returned in A. High bit	is delay.	jsr noteon	; turn the note on	bcs error	and #$07FF	; get just the delay.*        clc		;	adc tickcount	; add on the tick count.	cmp maxduration	; see if farthest note yet.	blt chkchrd	; if not chk the chord bit.	sta maxduration	; save as new maxduration.chkchrd	bit seqitem-1	; set n from chord bit.	bmi nxtitem	; if chord set then	do the next item.;if no delay exit.	bit seqitem+2	; check if delay bit set.	bmi delayset	; if delay, then set it, else exit.	clc	; no error.	rts	; quit.; set the delay.delayset	lda seqitem+2	; get the word with	delay.	and #$07FF	; get just the delay.	clc	;	adc tickcount	; add current tick count.	sta delaytime	; save as new time to delay until.	clc	; no error	rts	; exit.********************************************************************************; If not a note then call the routine corresponding to the command number.notnote	and #$007F	; get the command number.	cmp #10	; see if it's a normal command.	blt docmd	; if so doit.	cmp #22	; else see if it's a midi command.	bge @1	; see if it's still legit.	bit mode	; see if using midi.	bpl chkchord	; if no midi, then chk chord and quit.	bra docmd	;@1	cmp #31	;	bge commanderr	; not a ligitamate command if ge.docmd	asl a	; make into index for jsr table.	tax	;; Poll Midi before AllocGenerator.	phx	jsl MIDIInputPoll	plx	jsr (cmdtable,x)	; jsr to appropriate routine.chkchord	bit seqitem-1	; see if chord bit set.	bpl @1	; if no chord exit.	brl nxtitem	; chord, so do next item now.@1	clc	; no error	rts	; exit.********************************************************************************; turn off the requested note.offcmd	jsr noteoff	; turn the note off	bcs error	; if an error return it.	bit seqitem-1	; get chord bit in high bit.	bpl exit	; if clear exit.	jmp nxtitem	; else do nextitem.********************************************************************************; Table for commands.  Assuming that routines are in the same bank as plypatt.cmdtable	DC.W dopbend	; 0. pitchbend	DC.W chngtempo	; change the value of increment	DC.W TurnSeqNotesOff ; all notes off	DC.W dojump	; goto seqitem	DC.W vibdepth	; vibrato depth	DC.W progchng	; program change	DC.W setflag	; set a flag	DC.W doifgo	; test a flag and branch	DC.W incflag	; increment a flag	DC.W decflag	; decrement a flag	DC.W MidiNoteOff	; 10. play a midi note off.	DC.W doMidiNoteOn	; play a midi note on.	DC.W doMidiPolyKey	; Midi Polyphonic key.	DC.W MidiCntrlChng	; Midi Control Change.	DC.W MidiProgramChng ; Midi Program change.	DC.W MidiPressureChng	DC.W doMidiPitchBend ; Pitch Bend.	DC.W MidiSelctChnlMode	DC.W MidiSysExl	DC.W MidiSystemCommon	DC.W MidiSystemRealTime	DC.W SysExlDataBank	; 21. sets H.Word tobe used for SysExl.	DC.W NotImp2	; 22.	DC.W NotImp2	; 23.	DC.W NotImp2	; 24.	DC.W NotImp2	; 25.	DC.W NotImp2	; 26.	DC.W NotImp2	; 27.	DC.W NotImp2	; 28.	DC.W NotImp2	; 29.	DC.W CallRoutine	; 30.	ENDP;          copy	 seq.start.asm*  copyright nineteen eighty seven too nineteen eighty eight.*  All rights reserved. Apple Computer,	Inc. '87-'88/'88.*********************************************************************************  Tool Call #15**  Startseq -- this	routine is the main	tool call to the sequencer*  it should do the	following:*        1.) initialize phrindex, curphrase, curpatt, and pattindex*        2.) dereference the phrase handle and place that in seq*        3.) call playseq**  Inputs:     User	Completion Routine:	long*              User	Error Handler:	long*              Sequence Handle:	long*              RelativeAddr Pointer	long (only for startseqrel)*	*  Calls:      playseq, starttimer, _MidiInfo**  Sets Up:    CurPhrase, CurPatt, Level, inpattp, delaytime, doneflag,*              complrout, errhandlr, seq, ignoreint.**  Errors:     noroomerr, wrngtyperr**  History:    3/15/88  Started to reformatt.*              3/16/88  zeroed maxduration, and TryToQuit.*              6/30/88  Fixed error returning.*         	10/6/88  Add StartSeqRel call, and make appropriate changes.********************************************************************************startseq	PROC*        using seqdataseqhand	equ 9compl	equ 13errhand	equ 17	phd	; save old direct page	tcd	; set the flags. and get my dp.	bne itsok	lda #nostarterr	; if zero no wap, and not started.	jmp Erroritsok	stz reladdr	; initialize to zero.	stz reladdr+1	; Initalize high word to zero.		bra join	Entry startseqrelstartseqrel	phd	; save old direct page	tcd	; set the flags. and get my dp.	bne @1	lda #nostarterr	; if zero no wap, and not started.	jmp Error@1	lda seqhand,s	; Initialize reladdr to handles pointer.	sta d1	lda seqhand+2,s	sta d1+2	ldy #1	lda [d1]	sta reladdr	lda [d1],y	sta reladdr+1; now that we grok the fullness of our WAP we initialize the counters; but first we see if they supplied a midi buffer, if they need one.join 	lda mode	; see if midi.	bpl initcount	; if no midi zero the counters.	pea 0	; if doing midi check that ...	pea 0	; it is started up and that it ...	pea miOutputChars	; has an output buffer.	_MidiInfo	; Only care if there is an error.	tax	; save error if one. 	pla	; pull off the result...	pla	; and ignore it.	bcc A3	; carry still set if error.	txa	; there was an error so restore it.	jmp error	; report the error and quit.A3	pushlong #0	; space for result	pushword #0	; system tool.	pushword #32	; midi tool set number.	_GetWap	; get the wap.	tax	; preserve error if there is one.	pla	; get the result	sta mididp	; get the midi dp for MIDIWriteGlue.	pla	; get high word (0).	beq doerr	; if not zero midi isn't started correctly.	bcc initcount	; carry still set if an error.	txa	; get error code back.	jmp error	; return error.doerr	lda #miToolsErr	; midi tools not started up.	jmp errorinitcount	stz curphrase	stz curpatt	stz level	stz inpattp	stz delaytime	lda #nottrytoquit	and MyFlags	sta MyFlags	stz maxduration	stz DoneFlag; save the completion routine to the DP	lda compl,s	sta complrout	lda compl+2,s	sta complrout+2; save the error handler to the DP	lda errhand,s	sta errhandlr	lda errhand+2,s	sta errhandlr+2; now we move the sequence to seq and dereference it	lda seqhand,s	sta seq	lda seqhand+2,s	sta seq+2	ldy #$2	; get ready to dereference it.	lda [seq]	; get the low part.	tax	; save for now.	lda [seq],y	; get high part.	sta seq+2	; save dereferenced	handle.	stx seq	; save dereferenced	handle.; need to make sure	that phrasetab is setup correctly for the job	lda seq	sta phrasetab	lda seq+2	sta phrasetab+2	stz phrasetab+4	; zero out curphrase too; now we call playseq to play it	php	sei	jsr playseq	bcs errorp; we also have to tell the interrupt handler that it is ok to process; interrupts.	jsr starttimer	lda mode	; get the mode	and #$0001	; if interupting don't ignoreint.	bne getp	lda DoneFlag	; if sequence is already done ...	bne getp	; ...dont zero the ignoreint flg.	lda #notignoreint	; clear ignoreint.	and MyFlags	sta MyFlagsgetp	plp;all done	ldy #$C	; strip off the stack.	jmp endcallerrorp	plperror	ldy #$C	; strip off the stuff on the stack.errtax	tax 	jmp errout	ENDP;______________________________________________________________________;; settrkinfo - this	routine will set the instrument and priority for; a particular track.;; inputs: tracknum	: word ; track to fix;         instnum	: word ; index into	inst table;         priority	: word ; for da note synth brah;; outputs: none; ;  Errors: InstBndsErr;; All registers are	trashed;;settrkinfo	PROC*         using	seqdatatracknum	equ 9instnum	equ 11priority	equ 13	;should be 13 not 15, right? md 7/27/87.	phd	tcd	; set up direct page ; instn2ptr takes the track number in A	and the instnum on the stack and; sets the instptr field of the trkinfo	correctly. x is; the trkinfo on return	lda instnum,s	bmi nointernals	; msb set dont play	internals.	and #$7fff	; mask off high bit.	cmp numinsts	bge error	pha	lda tracknum+2,s	and #$000F	; only 16 different	tracks.	jsr instn2ptr	pla	; pop instnum	bra dorest	; store the rest of	the info.nointernals	lda tracknum,s	; get the track number	and #$000F	; only 16 different	tracks.	asl a	; make into index	asl a	;	asl a	;	clc	;	adc #trkinfo	;	tax	stz <4,x	; zero out instrument pointer.	stz <6,xdorest	lda priority,s	sta <base,x	lda tracknum,s	; get the midi channel.	bmi midi	lda #0	bra saveit	; no midi so store zero in scratch.midi	and #$0F00	; get only the midi	channel.	xba	; put in low word.	ora #$8000	; set midi bit.saveit	sta <2,x	; save in scratch area.	ldy #$06	jmp endcallerror	ldy #$08	ldx #instbndserr	jmp errout	ENDP;___________________________________________________________________;; remember the routine assumes instnum on the stack and track in Ainstn2ptr	PROCinstnum	equ 3	asl a	asl a	asl a	clc	adc #trkinfo	tax	phx	pei <insttab+2	; push the table	pei <insttab	_hlock	jsl MIDIInputPoll	; don't lose midi input when changeing isnt.	plx	php	sei	; just in case	ldy #$02	; deref the handle	lda [insttab]	sta d1	lda [insttab],y	sta d1+2	lda instnum+1,s	; get the number	asl a	asl a	; adjust for long table	tay	iny	; get past length word.	iny	lda [d1],y	; low word of instrument	sta <base+4,x	iny	iny	lda [d1],y	; hi word of instrument	sta <base+6,x	plp	phx	pei <insttab+2	; unlock the handle	pei <insttab	_hunlock	plx	jsl MIDIInputPoll	; don't lose midi input when changeing isnt.	rts	ENDP;_____________________________________________________________________;; Tool Call #18;; SetInst -- sets the direct page variable InstTab to the handle; supplied;; Inputs:  Insthndl	: handle ; Handle to an instrument table.;; Output:  none;;  Errors: none;; All registers are	trashed.; setinst	PROCinst	equ 9	phd	tcd	; set wap as direct	page	lda inst,s	; set the instrument table	sta d1	; save it in a temp	lda inst+2,s	sta d1+2	; save it in a temp	pushword d1+2	;lock the insttable	handle.	pushword d1	_HLock	jsr deref	; deref hndl in d1 and put pointer in d2.	lda [d2]	; get the number of	inst in table.	sta numinsts	; save it in number	of instruments.	lda d1	sta insttab	;save a copy of the	inst table.	lda d1+2	sta insttab+2	pushword d1+2	;lock the insttable	handle.	pushword d1	_HUnLock	ldy #$04	jmp endcall	ENDP;____________________________________________________________________;;; Tool Call #17;; StopSeq -- This routine will stop the	sequencer, and turn	off all; notes. If next is	true then the sequencer will behave as if it has; encountered a termination command. If	next is false then the timers are; stopped and the completion routine is	called.;; inputs: next : word    ; 0 = stop 1 =	next; ; output: none;;  Errors: none;; all registers get	trashed;  History:    3/16/88  jsr to quitsequence instead of callcmplt.stopseq	PROC*         using seqdatanext	equ 9	phd	tcd	; save the old direct page and set up mine	jsr TurnSeqNotesOff	; turn off all sequencer notes.	lda next,s	beq calldone; we just have to fake the sequencer into thinking that it is done with; the current object	lda inpattp	beq notinpatt	stz inpattp	bra donenotinpatt	jsr phrdone	; unwind the stack	bra donecalldone	jsr quitsequencedone		; 	ldy #$2	jmp endcall	; go home	ENDP;          copy	 seq.step.asm; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.;_____________________________________________________________________;;   Tool Call #16;;   StepSeq -- This	routine advances the sequence count by 1 and;   then calls playseq. It basically will play the next seq	item.;   Note that using	this can be really tricky. The application is;   responsible for	the timing of the sequencer. Weird (and	sometimes;   wonderful things can happen if the application doesn't provide a;   steady beat.;;   There are no arguments to this call.;;  Errors: none;*  History:    3/16/88  Added code to call quit sequence.;stepseq	PROC*        using seqdata	phd	; set my work area and save the old dirpage	tcd	beq nostart	php	sei	inc tickcount	; increment the clock	bit MyFlags	; see if I'm tring to quit.	bvc playnow	; if not tring to quit playseq.	jsr checkoff	; otherwize turn off notes if needed.	jsr quitsequence	; try to quit the sequence again.	bra done	; exit.playnow	jsr playseq	; play the item	bcs errordone	plp	ldy #$00	jmp endcall	; bye byenostart	lda #nostarterrerror	plp	ldy #$00	tax	jmp errout	ENDP;          copy	 seq.end.asm; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.*********************************************************************************  The endcall routines use the rom endcall vectors at $E10180 and $E10184.**  Assumes:    y = number of bytes to be striped.*              x = error, for error out	routines.**  Calls:      Strip.**  History:    3/15/88  Started to reformatt.*	    Deleted bsyend,	and busystrip.********************************************************************************endcall	PROC	pld	; restore the direct page	ENTRY oendcalloendcall		;       	ldx #$00	; no error.	clc	jml strip	ENDPerrout	PROC	pld	ENTRY oerroutoerrout		;       	sec	jml strip	ENDP*********************************************************************************  ErrorHndlr**  This routine calls the users error handler**  Called by:  PlaySeq (JSL)**  Calls:      User	Error Handler**  Assumes:    DP and DataBank will be restored by caller (PlaySeq).*              Users routine returns with an RTL to caller (PlaySeq).**  If ErrHandler then*        Set their data bank*        A = error.*        call their	error handler (and return)*  Else  Return*  EndIf********************************************************************************ErrorHndlr	PROC	lda ErrHandlr+1	; get bytes 2, 3 of	their err handler.	ora ErrHandlr	; get bytes 1, 2 of	their err handler.	beq return	; if all three bytes are zero, rtl.	pei ErrHandlr+1	; push bytes 3 and 2.	pei DataBank	; push junk, and data bank.	plb	; set the data bank.	lda ErrHandlr	; get bytes 2 and 1.	dec a	; make sure it starts correct.	sta 1,s	; write bytes 2 and	1 over 2 and junk.	lda d3+2	; get error back	cmp #1	; set carry.return	rtl	; call users rout. which returns to caller		; of ErrorHndlr.	ENDP;          copy	 seq.int.asm*  Copyright nineteen eighty seven too nineteen eighty eight.*  All rights reserved. Apple Computer,	Inc. '87-'88/'88.*********************************************************************************			                   **  seqint			                   **			                   **  This routine is called by the interrupt handler of the note synthesizer.    **  If ignoreints is	set or increment is	cleared, we return.	 Otherwize we inc  **  tickcount until it equals increment,	then we play the sequence.  If we      **  overflow the tickcount we need to call tick wrap.	                   **			                   **  Called by:  Note	Synth interupt.		                   **			                   **  Calls:      TickWrap, PlaySeq.		                   **			                   **  Sets Up:    TickCount, TickFract.		                   **			                   **  History:    3/15/88  Started reformatting.	                   **	    Slight modification for speed improvement.             **              3/16/88  added code to call quitsequence.	                   **			                   *********************************************************************************seqint	PROC*        using seqdata	php	; save condition codes.	SetMode16	; interupt handler is in 8 bit mode.	phd	; save old dirpage.	lda >seqwap	; get our DP back.	tcd	; set our DP.	bit MyFlags	; see if we should process the interrupt	bmi exit	; don't if ignoreint.	lda increment	; get the increment.	beq exit	; if zero then don't play.	inc tickfract	; next tickfract.	cmp tickfract	; see if we have counted to increment.	beq inctick	; if so increment tick count.	bpl exit	; if not quit.inctick	stz tickfract	; got a new tick so	clr tickfract.	inc tickcount	; and increment tick count.	bpl playit	; if not overflow playit.OverFlow	stz tickcount	; zero it out if >=$8000	jsr TickWrap	; Take care of the tick wrap stuff.playit	bit MyFlags	; see if we're trying to quit.	bvc playnow	; if not play the sequence now.	jsr checkoff	; turn off any notes.	jsr quitsequence	; and try to quit.	bra exit	; then return.playnow	jsr playseq	; play the thingexit	clc	; errors were passed to user vector.	pld	plp	; restore old modes, etc.	rtl	ENDP*********************************************************************************			                   **  TickWrap			                   **			                   **  When TickCount wraps this procedure is called, and I check if the high bit  **  of the trk is set, if so it is waiting for a note off, so we dont do anythig**  otherwize we AND	the duration with $7FFF so that we wont	miss any tick by   **  overflowing, or cut notes off to early.	                   **			                   **             MidiNoteOn/Free   Wrapped	 Playing  Error	                   **      dur	 1             1	    0       0	                   **      trk	 1             0	    0       1	                   **			                   **  The error condition above isn't checked for.                                **			                   **  This was put in line to save time.		                   **			                   **  History:    3/15/88  Formatt changed.	                   **	    Made it faster.		                   **			                   *********************************************************************************TickWrap	PROC*        using seqdata; Poll Midi.	jsl MIDIInputPoll	lda #$8000	; want to clear high bit.	trb delaytime	; reset delay time.	trb maxduration	; reset max duration.	php	sep #$20	; make 8 bit accumulator.	longa off	; generate 8 bit acc code.	lda #$80	; number to AND for	trb.to0	bit 3+gentab+1	; get the trk, see if note off needed.	bmi to1	; if so, wait for a	note off.	trb 0+gentab+1	; turn duration into unwrapped value.to1	bit 8+gentab+1	; get the trk, see if note off needed.	bmi to2	; if so, wait for a	note off.	trb 5+gentab+1	; turn duration into unwrapped value.to2	bit 13+gentab+1	; get the trk, see if note off needed.	bmi to3	; if so, wait for a	note off.	trb 10+gentab+1	; turn duration into unwrapped value.to3	bit 18+gentab+1	; get the trk, see if note off needed.	bmi to4	; if so, wait for a	note off.	trb 15+gentab+1	; turn duration into unwrapped value.to4	bit 23+gentab+1	; get the trk, see if note off needed.	bmi to5	; if so, wait for a	note off.	trb 20+gentab+1	; turn duration into unwrapped value.to5	bit 28+gentab+1	; get the trk, see if note off needed.	bmi to6	; if so, wait for a	note off.	trb 25+gentab+1	; turn duration into unwrapped value.to6	bit 33+gentab+1	; get the trk, see if note off needed.	bmi to7	; if so, wait for a	note off.	trb 30+gentab+1	; turn duration into unwrapped value.to7	bit 38+gentab+1	; get the trk, see if note off needed.	bmi to8	; if so, wait for a	note off.	trb 35+gentab+1	; turn duration into unwrapped value.to8	bit 43+gentab+1	; get the trk, see if note off needed.	bmi to9	; if so, wait for a	note off.	trb 40+gentab+1	; turn duration into unwrapped value.to9	bit 48+gentab+1	; get the trk, see if note off needed.	bmi toA	; if so, wait for a	note off.	trb 45+gentab+1	; turn duration into unwrapped value.toA	bit 53+gentab+1	; get the trk, see if note off needed.	bmi toB	; if so, wait for a	note off.	trb 50+gentab+1	; turn duration into unwrapped value.toB	bit 58+gentab+1	; get the trk, see if note off needed.	bmi toC	; if so, wait for a	note off.	trb 55+gentab+1	; turn duration into unwrapped value.toC	bit 63+gentab+1	; get the trk, see if note off needed.	bmi toD	; if so, wait for a	note off.	trb 60+gentab+1	; turn duration into unwrapped value.toD	bit 68+gentab+1	; get the trk, see if note off needed.	bmi ChkMidi	; if so, wait for a	note off.	trb 65+gentab+1	; turn duration into unwrapped value.ChkMidi	plp	longa on	; assemble conde with 16 bit acc.; Poll Midi.	jsl MIDIInputPoll	lda mode	; get the mode.	bpl exit	; if no midi than quit.	ldy #$20	; do it 32 times.	ldx #$100	; get into DP two.again	lda gentabtrk1,x	; get trk, see if note off needed.	bmi nexttrk	; if not go to next	trk.	lda gentabdur1,x	; get durration.	and #$7fff	; update so it can be seen.	sta gentabdur1,x	; save it.nexttrk	inx	inx	dey	bne again; Poll Midi.exit	jsl MIDIInputPoll	rts	ENDP;________________________________________________________________________; ; StopTimer & StartTimer - StopTimer halts the generator that the ; note synth is using as a timer. It works only because of an intimate; knowledge of how the note synth works. Kids should not try this without; adult supervision. StartTimer is almost as bad since it forces the ; interrupt on. ;; Of course if the note synth changes, we probably will have to change; these too. Oh, well.stoptimer	PROC*         using	seqdata	shortm	; 8 bit accum	lda >gadrl	; save address reg 	pha	lda #doc_ctrl+timer_osc ; set up the address	php	; no interupts. In sound glue.	sei	sta >gadrl	lda >gstatreg	; save old mode	and #$F0	; mask the low nybble	pha	lda >sysvol	and #$0F	; zero out high nybble	sta >gstatreg	lda >gdatareg	lda >gdatareg	ora #doc_halt_bit	; halt the osc	sta >gdatareg	pla	; restore mode with	correct vol	ora >sysvol	sta >gstatreg	plp	pla	sta >gadrl	; put back old address	longm	; back to 16 bit a. (and x).	rts	ENDPstarttimer	PROC*         using	seqdata	shortm	; 8 bit accumulator.	lda >gadrl	; save address reg 	pha	lda #doc_ctrl+timer_osc ; set up the address	php	; no interupts. In sound glue.	sei	sta >gadrl	lda >gstatreg	; save old mode	and #$F0	; mask off low nybble	pha	lda >sysvol	and #$0F	; select DOC w/ cur	sysvol	sta >gstatreg	lda >gdatareg	lda >gdatareg	and #doc_halt_mask	; enable timer osc interrupt	sta >gdatareg	pla	; restore mode with	correct vol	ora >sysvol	sta >gstatreg	plp	pla	sta >gadrl	; put back old address	Longm	; 16 bit accumulator. (still 16 bit x).	rts	ENDP;_____________________________________________________________________          ;; Tool Call #19;; StartInt and StopInt are tool calls that correspond to Starttimer and; stoptimer. There are provided to let an application force	the timer; on so the Note Synthesizer can be called. The application	can get ; itself in alot of	trouble this way, so be careful;; Errors: None;_____________________________________________________________________          ;StartInt	PROC	phd	tcd	jsr starttimer	ldy #$00	jmp endcall	ENDP;_____________________________________________________________________          ;; Tool Call #20;; Errors: None;_____________________________________________________________________          ;StopInt	PROC	phd	tcd	jsr stoptimer	ldy #$00	jmp endcall	ENDP;          copy	 seq.deref.asm*  Copyright nineteen eighty seven too nineteen eighty eight.*  All rights reserved. Apple Computer,	Inc. '87-'88/'88.*  deref -- dereferences the handle in d1 and places the pointer in*  d2deref	PROC	lda [d1]	; low part	sta d2	ldy #$02	lda [d1],y	sta d2+2	rts	ENDP;          copy	 seq.chkgen.asm;_____________________________________________________________________;; Checkoff -- This routine will check the list of generators that are ; on and will turn off any that should be turned off.;; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.;; Inputs: none; ; Outputs: none;; A and X are trashedcheckoff	PROC*         using	seqdata; Poll Midi.	jsl MIDIInputPoll; x is initialized so its offset is the	start of the table	ldx #gentab	ldy #$00	; generator index.; start scanning the table. If the time	is 00 then the generator is not; on, otherwise we pick up the largest valueagain		; 	lda <base,x	; get the value	bmi nextitem	; high bit set means gen off, or MIDI, or wrap.	cmp tickcount	; compare it to the	current time	beq TurnOff	; If equal than turn it off.	bge nextitem	; its not less, so we skip to next item; we've found a time that is lower so we need to turn off that note.TurnOff	phy	; save y value	phx	; save x value	phx	; save x value	phy	; generator number	lda <2,x	; get the semitone	sta d3+2	pha	jsl NoteOffGlue	plx	; get the registers	backmiditoo	lda mode	; see if MIDI enabled.	bpl nomidi	; if not don't do a midi command.	lda <4,x	; get the track	and #$000F	; get just the track	asl a	asl a	asl a	clc	adc #trkinfo	; get index to track.	tax	lda <2,x	; get the scratch.	bpl nomidi	; if not don't do a midi command.	and #$000f	; get midi channel.	sta d3	; save midi channel.	lda #$80	; make trk zero and	note off.	ora d3	; or in the midi channel.	xba	; swap bytes.	tax	; put command and channel in HByte of x.	lda 0	; zero volume for note off.	ora d3+2	; or in the semitone.	jsr Midi3Out	; put out the midi command.NoMidi	plx	ply; reset the generator table.	lda #$8080	sta <base,x	; reset duration	sta <3,x	; reset semitones 2nd byte and trk's byte.nextitem	iny	; next osc.	cpy #$0E	; only do for 0D or	0-13 times, 14 osc.	bge chkmidi	; if done, check if	midi notes are on.	txa	; move on to the next item	clc	; ** gentab entries	are now 5 bytes 2/10 JW	adc #$05	tax	bra again; Check if any notes need to be turned off by MIDI.; Poll Midi.ChkMidi	jsl MIDIInputPoll	lda mode	; check if Midi is even on.	bpl exit	; if not on exit.	ldx #gentabdur	; get offset to gen	for midi.	ldy #31	; do it for osc 0-31.MLoop	lda <base,x	; get duration of osc y.	bmi nextosc	; if high bit set, skip to next.	cmp tickcount	; see if time to turn off.	beq turnoscoff	; if equal turn off	the osc.	bge nextosc	; get the next osc if ok.TurnOscOff	phx	; save regesters.	phy	;	lda <gentabtrk1,x	; get trk and semitone.	sta d3	; save it for semitone.	ora #$8000	; make it a note off call.	and #$FF00	; note off and trk only.	tax	; and save in x.	lda d3	; get trk and semitone.	and #$007F	; no trk or vol only semitone.	jsr Midi3Out	; send the midi command.	ply	; get regesters back	plx	;	lda #$8000	;	sta <base,x	; reset duration	sta <gentabtrk1,x	; reset trk and semitone info.nextosc	dey	; next osc.	bmi exit	; if past zero were	done.	inx	; get next generator.	inx	;	bra MLoop	; keep going until done.; now that all of the generators have been checked, we pull	the next off; time off of the stack and return; poll MIDIexit	jsl MIDIInputPoll	rts	ENDP;          copy	 seq.note.asm; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.;_______________________________________________________________________;; NoteOn -- allocates a generator from the note synth and plays the note; placing an appropriate off time in the generator table.;; Input:  Seq Item on the stack;; Output: Off time.	High bit set if delay bit is set. ;         00 means that there is no off	time. ie. MIDI style;         Note that	in this case $FFFF is stored in the gentab, not the;         00 that is returned;; All registers are	trashed.;; Errors: AlreadyOn, NoneAvailable;_____________________________________________________________________          ;noteon	PROC*         using	seqdata; Get all of the note information and store it.; Duration: d1; Track:    curtrk; Volume:   d3; Semitone: d3+2	jsr finddur	; get the time off	sta d1	jsr findtrk	sta curtrk	jsr FindVol	; Get the volume	sta d3	; temp storage.	jsr findtone	; still need stack clean, so ...	sta d3+2	; push volume after	getting tone.; get the Index to the current track in	the trkinfo table.	lda curtrk	asl a	; track info table is 8 bytes wide	asl a	asl a	; index into track info table	clc	adc #trkinfo	; adjust the offset	for the second page	of	tax	; work area; check to see if we need to do the internal voices.	lda <4,x	; get inst ptr high	word.	bne Internal	; if not zero play internal notes.	lda <6,x	; get rest of ptr.	bne internal	; internal voices.	jsr justmidi	; do just midi.	brl exit	; quit.; Do the Internal voices.Internal	phx	; save the index twice.	phx; get a generator from the note synth	lda <base,x	; get the priority.	pha	; space for result	pha	; priority	jsl AllocGlue	bcc goon	brl allocerr	; only real error is NoneAvailible = $1921goon	jsl MIDIInputPoll	pla	; generator number	sta <curgen	; another scratchpad location; now we need to push the semitone, volume and instrument pointer	plx	; saved index from above, first one.	pei <curgen	; generator number	PushWord d3+2	; semitone	PushWord d3	; volume	lda <6,x	; push the instrument pointer	pha	lda <4,x	pha; turn the note on!	jsl NoteOnGlue	bcs error	; only legal error is AlreadyOn = $1924	jsl MIDIInputPoll	; don't lose the midi.; Get the scratch regester in the trk table and see if we need to do midi.	plx	; get the index into trkinfo table, second time.	lda mode	; See if Midi set.	bpl RevTable	; if not revise the	table.	lda <2,x	; get the scatch.	bpl RevTable	; if high bit clear, don't play midi.; If Midi turn the midi note on.	lda #$9000	; No trk for now, but note on	ora <1,x	; or in the channel.	tax	; put midi and channel in H X.	lda d3	; push volume	xba	; get vol in upper byte.	ora d3+2	; now do tone.	jsr Midi3Out	; put out the Midi Command.; Save the duration	and update the generator table, for internal voices.revtable	lda d1	; get the duration.	and #$7FFF	; mask off delay bitstuffval	tay	; save the duration	temporarily	lda curgen	asl a	; a slimy multiply by 5 for the index into	asl a	;    the table	clc	adc curgen	; adjust offset to generator tables	clc	adc #gentab	tax	; index in X	tya	; duration back in A	bne Dur	lda curtrk	ora #$80	sta curtrk	lda #$8000	; set duration so it wont ever get cleared.	bra SavDurDur	clc	adc tickcount	; add the current tick count to duration.SavDur	sta <base,x	; save the duration	lda d3+2	; get the tone back	sta <base+2,x	; save the semitone	sep #$20	; 8 bit m 16 bit x	longa off	lda curtrk	sta <base+4,x	; save the track	SetMode16; everything seems to be done. We return the duration to the caller.exit	lda d1	; get the duration back	clc	rtsallocerr	plx	plxerror	sec	plx	rts	ENDP;----------------------------------------------------------------------;; JustMidi;; play the midi note on.; x should be indexing into the trkinfo	table, on entry.;JustMidi	PROC*          using seqdata	lda mode	; See if midi enabled.	bpl exit	; no midi quit.	lda <2,x	; get the scratch from track.	bpl exit	; no midi quit.	and #$000f	; get the midi channel.	sta curtrk	; save in curtrk.	ldx #gentabdur	; index to table.	ldy #31	; # of times -1 I want to do this.again	lda <gentabtrk1,x	; get the track.	bpl next	; if not set it's in use as a note on already.	phx	; save my regesters.	lda #$90	; make it a note on.	ora Curtrk	; and set the correct cannel.	xba	; and put it in upper byte.	tax	; put in high byte of x.	lda d3	; get the volume.	xba	; and put it in upper byte.	ora d3+2	; or in the tone in	lower byte.	jsr Midi3Out	; put out the Midi command.; set the midi generator tables.	plx	; get x back.	lda d1	; get the duration.	and #$7FFF	; mask of the delay	bit.	beq nodur	; if duration is zero then save $8000.	clc	adc tickcount	; add current tick count.	sta <base,x	; save the duration.	bra done	; now we are done.next	dey	; next midi osc.	bmi error	; if no more room don't play it.	inx	; next generator.	inx	bra again	; do it again.nodur	lda #$8000	; show that midi note on type osc.	sta <base,x	; save it.done	lda curtrk	; get the track.	xba	; put in high byte.	ora d3+2	; or in semitone.low byte.	sta <gentabtrk1,x	; save the semitone	and trk.exit	rtserror	sec	lda #NoRoomMidiErr	rts	ENDP;________________________________________________________________________;; NoteOff -- This command causes causes	the envelope generator for; the given note to	go to the release stage. The volume will usually; drop to zero in a	short time. When the envelope reaches zero the; generator will be	released by the note synthesizer.;; we will mark the generator as being free since it is likely to be; stolen if necessary.; ; Inputs: seq item on stack;; Outputs: none;; Errors: NoNoteErr;; all registers are	trashed;;_____________________________________________________________________          noteoff	PROC*         using	seqdata	jsr findtrk	; find out which track we are dealing with	sta curtrk	jsr findtone	; get the semitone	sta d3; we have to loop through the generator	table looking for the generator; that is playing the right semitone on	the right track. 	ldx #gentab	; initialize y for the generator table.	ldy #$00	; use x as a counter for the gen numagain	lda <2,x	; get the semitone	cmp d3	bne nexttrk	; if not the right semitone, get the next trk; we have a semitone that matches. Now we have to see if it	is on the ; right trackchecktrk	lda <4,x	; get the track	and #$000F	; it's only a byte value with one valid nible.	cmp curtrk	; is it the same track?	beq done	; we got it, we got	it; since we didn't hit move on to the next itemnexttrk	cpy #$0D	; Only have 13 osc.	in table.	bge MidiOnly	; check the midi tables for the note off.	iny	; next generator	txa	; move to the next semitone	clc	adc #$05	taxloop1	bra again; we seem to have found the right semitone on the right track. so we turn; off ze note.done	phx	; save the index to	genarator in gentab	lda curtrk	; get curtrk.	asl a	; make into index for trkinfo.	asl a	asl a	clc	adc #trkinfo	tax	; use as index.	lda <4,x	; get instptr high word.	bne doInternl	; if instrument defined play int.	lda <6,x	; get instptr low word.	beq chkmidi	; no internal instrument, Midi?DoInternl	phy	; generator number	pei d3	; semitone	jsl NoteOffGlue	bra clrGenTbl	; clear the generator table.chkmidi	lda mode	; see if Midi is being used.	bpl exit	; if not exit.	lda <2,x	; get the scratch regester.	bmi domidi	; there is midi so doit.	brl exit	; if there isnt midi quit.domidi	and #$000F	; get midi channel,	from scratch.	sta d3+2	; save for now.	lda d3+2	; get the channel.	ora #$80	; or in the note off.	xba	; put the command in high byte.	tax	; put in x.	lda 0	; zero volume.	ora d3	; get semitone.	jsr Midi3Out	; put out the midi command.; now that the note	is off we need to zero out the durationClrGenTbl	plx	; get the index back, at track	lda #$8080	sta <3,x	; reset trk and part of semitone	sta <base,x	; zero out the duration	bra exit; Check the midi tables to see if the note off is in there.MidiOnly	lda mode	; see if MIDI is used.	bpl error	; if not midi cant find note.	lda curtrk	; get curtrk.	asl a	; make into index for trkinfo.	asl a	asl a	clc	adc #trkinfo	tax	lda <2,x	; get the scratch regester.	bpl error	; no midi so couldn't find note.	and #$000f	; get just the channel #.	xba	; put in high byte.	ora d3	; or in the semitone.	sta d2	; save what Im looking for in d2.	ldx #gentabdur	; get index to generator table.	ldy #$31	; only have 31+1 midi generators.loop	lda <gentabtrk1,x	; get the trk and semitone.	cmp d2	; see if it's what I want.	bne next	; if not get the next.	phy	; save regesters.	phx	;	lda d2	; get semitone and trk.	and #$0F00	; get just the trk.	ora #$8000	; note off.	tax	; put in x.	lda d2	; get semitone and trk.	and #$007F	; keep semitone.	jsr Midi3Out	; put out midi command.	plx	; restore regesters.	ply	;	bra exitNext	dey	; next osc.	bmi error	; oops, we cant find it.	inx	; next generator.	inx	bra loop* Need to put this in and then clear the table or return an	error.; RTS for routine when done.error	lda #nonoteerr	; no matching note on	sec	rtsexit	clc	rts	ENDP;          copy	 seq.efx.asm; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.*********************************************************************************			                   **  This file contains all of the special effects routines:	                   **			                   *********************************************************************************notimp2	PROC	rts	ENDPCallRoutine	PROC ; 30.		php	phb	phd	jsl RoutineGlue	pld	plb	plp	rtsRoutineGlue	pei databank-1	; push flag8 and junk.	phk	; add one byte of junk	pla	; get 2 bytes of junk off.	lda SeqItem+2	;	sec	sbc #1	pha	RTL		ENDP;_____________________________________________________________;; dopbend -- set the pitchbend value for a track.;; pitchbend acts as	if an imaginary pitch wheel had been moved; the pitch is altered according to the	difference of the current; pitch value and the new value. If the	difference is positive then; the pitch is increased, if negative it is decreased. ;; Note: pitchbend affects a track rather than an individual	note.;;  inputs : a legal	seq item on the stackdopbend	PROC*         using seqdata	jsr findtrk	; get the track number	sta curtrk	; and save it	jsr findtone	; works for getting	val1	sta d3	lda seqitem+2	; get the high word	of seqitem.	xba	; get what I want in low.	and #$7	; only low 3 bits.	sta d3+2	; save 3 bits of reserved info.	cmp #2	; see whats set.	beq domidi	; do the midi one.; we have to loop through the generator	table looking for all generators; that are linked to the track	ldx #gentab+4	; initialize x for the track field	ldy #$00	; use y as a counter for the gen numagain	lda <base,x	; get the track	and #$F	; mask off the garbage	cmp curtrk	beq bendit	; bend the note; since we didn't hit move on to the next itemloop1	cpy #$0F	; check if done all	tracks.	bge done	iny	; next generator	txa	; move to the next semitone	clc	adc #$05	tax	bra again; we have a track that matches, so we bend it! bendit	phx	; save the registers	phy	pha	phd	; save our direct page	pei d3	; push the wheel position; get the N. Synth DP, which is infront	of my dp.	tdc	; get my dp.	sec	;	sbc #$100	; get synth dp	tcd	tya	; get the gen number in A	asl a	; x16	asl a	asl a	asl a	clc	adc #$04	; move to pitch bend	tax	; move index into x	pla	; get the pitch value back	shortm	; 8 bit accumulator.	sta <base,x	; set the new value	Longm	; 16 bit accumulator. (still 16 bit x).	pld	; restore all of the registers	pla	ply	plx	bra loop1	; check for any more on that trackDone	lda d3+2	; get reserved bits.	cmp #$1	; see if internal only	beq exit	; if so dont do midi.;check if midi pitch bend is needed.domidi	lda Mode	; see if doing midi	at all.	bpl exit	; if no midi, exit.	lda curtrk	; get the track.	asl a	; make into index	asl a	;	asl a	;	clc	adc #trkinfo	tax	;	lda 2,x	; get the scratch area.	bpl exit	; if no midi on this trk, exit.	and #$f	; get the midi channel.;do midi pitch bend.	ora #$E0	; or in command.	xba	; save in high byte.	tax	; save in x.	lda d3	; get the ptich change.	xba	; save in high byte.	jsr Midi3Out	; put out the midi.exit	rts	ENDP;_____________________________________________________________;; chngtempo -- changes the tempo of the	piece;; chngtempo allows the sequence to alter the tempo of the piece.; this is accomplished by supplying a new value for increment; note that the track information for this command is ignored. It is; not possible to alter the tempo of one track relative to another.;;  inputs : a legal	seq item on the stackchngtempo	PROC	jsr findtone	; this works great for getting the new val	sta increment	rts	ENDP;___________________________________________________________________________;; dojump -- goto a new item in the current pattern;; The format of the	seqitem for jump is	a little weird. We allow 15-bits; for specifying the item to go to. This seems limiting at first, until you; realize that the max sequence size is	64k. Since each item is 4 bytes, there; is a maximum of 16k items in a pattern. ;; Note that this routine does no range checking. It assume that the value ; passed to it is legal. If for some reason you give an index greater than ; the number of items in the pattern, you are in BIG!!!! trouble.;; input: a legal seq item on the stack.;; track information	is not used;dojump	PROC	jsr findtone	; get val 1 - high byte of item to jump	to	xba	; put it on top	sta d3	; save it 	jsr findval2	; get val 2 - low byte of item to jump to	ora d3	; add in the top part	dec a	; playpatt does an inc	sta curpatt	; we are now there	rts	ENDP;___________________________________________________________________________;; TurnSeqNotesOff;; Turns the Sequencers Notes Off. Turns	off all the notes that the sequencer; knows about and clears the their tables.;; Input: nil;; Output: nil;; Calls: _allnotesoff, clrgentabls, midi3out.;; Hist: new 3-2-88.;; _allnotesoff;        if MIDI;        then turn off all midi notes that sequencer knows about.;        end if; jsr clrgentabls;_________________________________________________________________________TurnSeqNotesOff	PROC*        using seqdata	_AllNotesOff	lda mode	bpl ClrTabls; check if any internals were doing midi too.	ldx #gentab	; get index to gen table info.	ldy #14	; 14 possible osc.; check if any playing.chkosc	lda <3,x	; get track in high	byte.	bmi nextosc	; if msb set not used.	phx	; save the x into gentable.	phy	; save which generator.	stx d3	; save the index into gentable.	and #$0F00	; get just the track, from lda <3,x.	xba	; put in low byte.	asl a	; make into index for trkinfo.	asl a	;	asl a	;	clc	;	adc #trkinfo	;	tax	; index into trkinfo table.	lda <2,x	; get scratch.	bpl donext	; if nomidi on this	trk do next osc.	and #$000F	; get just trk from	scratch.	ora #$0080	; note off.	xba	; put in high byte.	pha	; save x (tobe) for	midi3out.	ldx d3	; get index to gentable.	lda <2,x	; get the semitone.	plx	; save the x regester.	jsr midi3out	; put out the midi command.donext	ply	; restore index to gen table.	plxnextosc	txa	; get x	clc	adc #$5	; add 5. to next osc.	tax	; put back in x.	dey	;	bne chkosc	; check next osc.; turn off all the midi notes that the sequencer knows about.	ldx #gentabtrk	; get index to midi	trk, semitone.	ldy #32	; do it 32 times.; get the info and see if its a note.check	lda <0,x	; load the trk and semitone.	bmi next	; if high bit set its not used.	phx	; save regesters.	phy	;	sta d3	; save info.	and #$0F00	; get the track.	ora #$8000	; make it a note off.	tax	; first byte in x.	lda d3	; get the info.	and #$00FF	; get just the tone.	jsr midi3out	; send the midi packet.	ply	; restore regesters.	plx	;next	inx	; next voice spot.	inx	;	dey	; adjust amount left to do.	bne check	; check the next one.; clear the generator tables.ClrTabls	jsr clrgentabls	rts	; done.	ENDP*********************************************************************************; Clear Generator tablesClrGenTabls	PROC	jsl MIDIInputPoll	ldy #64	ldx #gentabdur	lda #$8000	; want high bits set.clrgendur	sta 0,x	; force dp	inx	inx	dey	bne clrgendur	jsl MIDIInputPoll	ldy #35	ldx #gentab	lda #$8080clrgentab	sta 0,x	inx	inx	dey	bne clrgentab	jsl MIDIInputPoll	rts	ENDP;_____________________________________________________________;; vibdepth -- set the vibrato depth value for a track.;; vibdepth acts as if an imaginary mod wheel had been moved.; the vibrato depth	is altered according to the difference of the current; value and the new	value. If the difference is positive then; the depth is increased, if negative it is decreased.; 00 is a special case that indicates no vibrato. This save	some cpu time.;; Note: vibdepth affects a track rather	than an individual note.;;  inputs : a legal	seq item on the stackvibdepth	PROC*         using seqdata	jsr findtrk	; get the track number	sta curtrk	; and save it	jsr findtone	; works for getting	val1	sta d3	; get the vibrato depth; we have to loop through the generator	table looking for all generators; that are linked to the track	ldx #gentab+4	; initialize x for the track field	ldy #$00	; use y as a counter for the gen numagain	lda <base,x	; get the track	and #$FF	; mask off the garbage	cmp curtrk	beq setdepth	; bend the note; since we didn't hit move on to the next itemloop1	cpy #$0F	; if y = 14 then we're in trouble	bge done	iny	; next generator	txa	; move to the next semitone	clc	adc #$05	tax	bra again; we have a track that matches, so we bend it! setdepth	phx	; save the registers	phy	pha	jsl MIDIInputPoll	pla	ply	plx	phx	; save the registers	phy	pha	phd	; save our direct page	pei d3	; push the wheel position; get the N. Synth DP, which is infront	of my dp.	tdc	; get my dp.	sec	;	sbc #$100	; get synth dp	tcd	tya	; get the gen number in A	asl a	; x16	asl a	asl a	asl a	clc	adc #$05	; move to pitch bend	tax	; move index into x	pla	; get the pitch value back	shortm	; 8 bit accumulator.	sta <base,x	; set the new value	Longm	; 16 bit acc. (still 16 bit x).	pld	; restore all of the registers	pla	ply	plx	bra loop1	; check for any more on that trackdone	lda mode	; get mode.	bpl exit	; if no midi quit.; see if midi set in command	lda #$0100	;	bit seqitem+2	; see if internal only bit set.	bne exit	; if and isn't 0 then int only.	lda curtrk	; get the current trk.	asl a	; make into index.	asl a	;	asl a	;	clc	;	adc #trkinfo	; add trk info table.	tax	;	lda 2,x	; get the scratch location.	bpl exit	; if no midi on this track quit.	and #$f	; get midi channel.	ora #$B0	; or in control change.	xba	; put in high byte.	tax	; put in x for midi3out.	lda seqitem+2	; get the high word.	xba	; put bit 23 in high byte.	bmi exit	; get out of here.	lda seqitem+2	;	and #$007F	; get control number.	xba	; put in h byte	ora d3	; or in vib depth value.	xba	; put in correct order.	jsr midi3Out	; put out midi command.exit	rts	ENDP;__________________________________________________________________________;; Progchng -- change the instrument associated with a track	to another.;; Expects the instrument number in Val 1 and the  track to be valid; NOTE: The instrument number must be valid for the table. No range; checking is performed. New Instruments can not be added to the table; from the sequencer;; input: a valid seqitem on the stackprogchng	PROC	jsr findtone	; get the contents of val1	tax	jsr findtrk	; get the track	sta d3	lda seqitem+3	; get high byt of second word.	and #$7	; and off high 3 bytes.	sta d3+2	; save temporarily.	cmp #2	; see if midi only.	beq midionly	; if so do midi only.	lda d3	phx	; instnum on stack	jsr instn2ptr	pla	; pop instnummidionly	lda Mode	; see if MIDI int.	bpl exit	; if no MIDI quit.	lda d3+2	; get reserved 3 bits.	cmp #1	; see if internal only.	beq exit	; if so quit.	lda d3	; get trk.	asl a	; make into index.	asl a	;	asl a	;	clc	;	adc #trkinfo	;	lda 2,x	; get the scratch	bpl exit	; if no midi exit.	and #$f	; get midi channel.	sta d3+2	; save in x for midi out.	lda seqitem+1	; 2nd and 3rd word.	and #$7F00	; get only program change.	ora #$C0	; make program change.	ora d3+2	; or in channel number.	jsr Midi2Out	; put out midi cmd.exit	rts	ENDP;__________________________________________________________________________;; SetFlag -- Set the specified flag to the supplied value.;; Expects the first	3 bits from Val1 to	be a flag and the last 4 bits to; be the value. Val2 is not used;; inputs:  a valid seqitem on the stack;setflag	PROC*         using seqdata	jsr findtone	; get the contents of val1	shortm	; 8 bit accumulator.	tay	and #$07	; mask off flag number	tax	; move index into x	tya	and #$78	; mask off value	lsr A	; We want to be aligned to the ...	lsr A	; ... Right. MLD 10/28/87	lsr A	; (Fixes Regester Bug).	sta flag1,x	; store the value in the flag	Longm	; 16 bit accumulator. <still 16 bit x).	rts	ENDP;_________________________________________________________________________;; doIfGo -- Test the specified flag for	the supplied value.	If true a branch; is performed. No action otherwise. ;; The branch value is in the range of -128 to +127. Note that the branch ; is specified in items, rather than bytes.;;  History:    3/15/88  Rewrote to make	smaller and faster.;	    Also fixed a bug with negative branch ranges.*******************************************************************************doifgo	PROC*         using seqdata	jsr findtone	; get contents of val1	setMode8		tay	and #$07	; mask off flag number	tax	; move index into x	tya	and #$78	; mask off value	lsr A	; We want to be aligned to the ...	lsr A	; ... Right. MLD 10/28/87	lsr A	; (Fixes Regester Bug).	cmp flag1,x	; compare value to flag	SetMode16		bne exit	; not equal -- no branch in seq	jsr findval2	; get the displacement	php	; save error condition codes.	bit #$80	; see if value is negative or not.	beq add	; if not negative add it in 16.	sep #$20	; 8 bit accumulator	for adding.	longa offadd	clc	adc curpatt	; add to the current pattern	plp	; reset mode.	longa on	dec a	; curpatt is incremented first thing.	sta curpatt	; save curpatt.exit	rts	; quit.	ENDP;__________________________________________________________________________;; IncFlag -- Increment the value of a flag. The low 3 bits of val1 contain; the flag number. The top 4 bits must be 00.;; input: a valid seqitem on the stack;;incflag	PROC*         using	seqdata	jsr findtone	; get the contents of val1	and #$07	shortm	; 8 bit accumulator.	tax	inc flag1,x	; increment the flag	Longm	; 16 bit accumulator.	rts	ENDP;__________________________________________________________________________;; DecFlag -- Decrement the value of a flag. The low 3 bits of val1 contain; the flag number. The top 4 bits must be 00.;; input: a valid seqitem on the stack;;decflag	PROC*         using	seqdata	jsr findtone	; get the contents of val1	and #$07	Shortm	; 8 bit accumulator.	tax	dec flag1,x	; increment the flag	Longm	; 16 bit accumulator.	rts	ENDP;__________________________________________________________________________;         ; Midi3Out;; Out puts 3bytes of midi data.; the last  two bytes in the paramater shuld be in the accumulator. H=3 l=2.; the next one should be in the low byte of the x regester.	x H=1, L= -.;Midi3Out	PROC	;	pha	; push the 3rd and 2nd bytes.	phx	; push the first byte, and extra.	PushLong #0	; no time stamp.	PushWord #$0700	; Length.	tsc	; get stack pointer.	inc a	; point it to array.	inc a	; point it to array.	pea 0	; push the space.	pea 0	; stack is zero bank.	pha	; push the stack address.	jsl MidiWriteGlue	tsc	; get stack pointer	. . .	clc	; and reajust it to	where it was...;          adc	     #10	     ; before MidiArray was pushed on.	adc #12	; before MidiArray was pushed on.	tcs	; and reset the stack.	rts	; done.	ENDP;__________________________________________________________________________;         ; Midi2Out;; Out puts 2bytes of midi data.; the first two bytes in the paramater shuld be in the accumulator. H=2 l=1.;Midi2Out	PROC	;	pha	; push the 2nd and 1st bytes.	PushLong #0	; no time stamp.	PushWord #6	; Length.	tsc	; get stack pointer.	inc a	; point it to array.	pea 0	; push the space.	pea 0	; stack is zero bank.	pha	; push the stack address.	jsl MidiWriteGlue	tsc	; get stack pointer	. . .	clc	; and reajust it to	where it was...	adc #10	; before MidiArray was pushed on.;          adc	     #08	     ; before MidiArray was pushed on.	tcs	; and reset the stack.	rts	; done.	ENDP;__________________________________________________________________________;         ; Midi1Out;; Out puts 1bytes of midi data.; the first two bytes in the paramater shuld be in the accumulator. H=junk l=1.;Midi1Out	PROC	;	pha	; push the junk and	1st bytes.	PushLong #0	; no time stamp.	PushWord #5	; Length.	tsc	; get stack pointer.	inc a	; point it to array.	pea 0	; push the space.	pea 0	; stack is zero bank.	pha	; push the stack address.	jsl MidiWriteGlue	tsc	; get stack pointer	. . .	clc	; and reajust it to	where it was...	adc #10	; before MidiArray was pushed on.	tcs	; and reset the stack.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Note Off;; Does a midi note off command.MidiNoteOff	PROC	;	lda seqitem	; get the low word.	and #$F00	; mask off the channel.	ora #$8000	; or in the midi note off.	tax	; save in x reg.	lda seqitem+2	; get the 2 byte data.	jsr Midi3Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Note On;; Does a midi note on command.doMidiNoteOn	PROC	;	lda seqitem	; get the low word.	and #$F00	; mask off the channel.	ora #$9000	; or in the midi note on.	tax	; save in x reg.	lda seqitem+2	; get the 2 byte data.	jsr Midi3Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi System Real Time Command.;; Does a midi system real time command.MidiSystemRealTime	PROC	;	lda seqitem+2	; get the high word.	and #$7	; mask only the 3 bits.	ora #$F8	; or in the midi system real time.	pha	; push the junk and	1st bytes.	pea $8000	pea $0000	; negative # put out now!	PushWord #5	; Length.	tsc	; get stack pointer.	inc a	; point it to array.	pea 0	; push the space.	pea 0	; stack is zero bank.	pha	; push the stack address.	jsl MidiWriteGlue	tsc	; get stack pointer	. . .	clc	; and reajust it to	where it was...	adc #10	; before MidiArray was pushed on.	tcs	; and reset the stack.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Polyphonic key Command.;; Does a midi Polyphonic key command.doMidiPolyKey	PROC	lda seqitem	; get the low word.	and #$F00	; mask only the channel.	ora #$A000	; or in the midi command.	tax	; put in x.	lda seqitem+2	; get the high word.	jsr Midi3Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Control Command.;; Does a midi Control command.MidiCntrlChng	PROC	lda seqitem	; get the low word.	and #$F00	; mask only the channel.	ora #$B000	; or in the midi command.	tax	; put in x.	lda seqitem+2	; get the high word.	jsr Midi3Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Program change Command.;; Does a midi Program change command.MidiProgramChng	PROC	lda seqitem	; get the low word.	and #$F00	; mask only the channel.	ora #$C000	; or in the midi command.	ora seqitem+2	; get the high word.	xba	; switch order of bytes.	jsr Midi2Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Pressure chng  Command.;; Does a midi Pressure chng  command.MidiPressurechng	PROC	lda seqitem	; get the low word.	and #$F00	; mask only the channel.	ora #$D000	; or in the midi command.	ora seqitem+2	; get the high word.	xba	; switch order of bytes.	jsr Midi2Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Pitch Bend Cmd.;; Does a midi Pitch	Bend.doMidiPitchBend	PROC	lda seqitem	; get the low word.	and #$F00	; mask only the channel.	ora #$E000	; or in the midi command.	tax	; put in x.	lda seqitem+2	; get the high word.	jsr Midi3Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Channel mode	message.;; Does a midi Channel mode message.MidiSelctChnlMode	PROC	lda seqitem	; get the low word.	and #$F00	; mask only the channel.	ora #$B000	; or in the midi command.	tax	; put in x.	lda seqitem+2	; get the high word.	jsr Midi3Out	; put out the command.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Sys Exlusive;; Takes a Pointer to a midi array and puts it out.MidiSysExl	PROC	pha	; space for MidiWritePacket.	lda SysExlDB	; get the high Word	of SysExl Ptr.	pha	; push it.	lda seqitem+2	; get the high word.	pha	; push the low word	of the Ptr.	jsl MidiWriteGlue	; send out the packet.	pla	; get result.	rts	; done.	ENDP;_____________________________________________________________________________;; Midi Sys Exlusive	Data Bank;; Sets the Data Bank to be used for Sys	Exlusive commands.SysExlDataBank	PROC	lda seqitem+2	; get the high word.	sta SysExlDB	; save the high word of Pointer.	rts	ENDP;_____________________________________________________________________________;; Midi System Common.;; Generates a midi system common command.MidiSystemCommon	PROC; find out how many	bytes to put out.	lda seqitem	; get the low word.	and #$1800	; get just bits 11 and 12.	bne check1	; if not zero check	if 1 byte only.; put out one byte.; first get the operand. sss.	lda seqitem	; get low word of seq item.	and #$0700	; get bits 8, 9, and 10.	ora #$F000	; make it a system common command.	xba	; put in low byte for midi1out.	jsr midi1out	; put out the midi command.	rts	; Exit.; check if only one	byte of data.check1	cmp #$0800	; see if only one bit set.	bne twobytes	; if note equal than put 2 bytes out.; put out one byte of data.; first get the operand. sss.	lda seqitem	; get low word of seq item.	and #$0700	; get bits 8, 9, and 10.	ora #$F000	; make it a system common command.	ora seqitem+2	; or in the data byte.	xba	; put cmd in low byte for midi2out.	jsr Midi2Out	; put out the Midi Command.	rts	; Exit.; put out two bytes	of data.; first get the two	bytes.TwoBytes	lda seqitem+2	tax	; put in x for midi3out.; then build the command with the operand. sss.	lda seqitem	; get low word of seq item.	and #$0700	; get bits 8, 9, and 10.	ora #$F000	; make it a system common command.	jsr midi3out	; put out the midi command.	rts	; Exit.	ENDP;          copy	 seq.util.asm;______________________________________________________________;; File SEQ.UTIL.A;; This file contains the various utility routine for the; various sequncer calls.;; Modification History;;  12 Jan 87   JW	    New today;   9 Feb 87   JW	    Accessor functions for note commands added;;______________________________________________________________; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.;________________________________________________________________________;;;  These routines extract the various parts from note commands.;;; Note that the seq	items look like:; (the numbers are the widths of the fields in bits);;  --------------------------------------------------------; |1|  4  |        11         |1|    7	  |1|      7       |;  --------------------------------------------------------;; bit  31 is the delay bit. It will cause the sequencer to wait until;         this item	has completed playing;; bits 27-30 contain the track number;; bits 16-26 contain the duration of the note. For MIDI style notes, this;            field should be zero;; bit  15 is the note bit. It is set for note commands, cleared otherwise; ; bits 8-14 contain	the semitone number. ;; bit  7 is the chord bit. It informs the sequencer that this note is part;        or a chord	as are all following notes with the chord bit set.;        After encountering a noteon with the chord bit set, the ;        sequencer will continue to fetch items until it encounters a noteon;        command without the chord bit set or another command. A noteon ;        command without the chord bit set is considered as	part of the chord.;; ; bits 0-6  contain	the volume of the note to be played. If	the volume;            zero then the note is considered a note off command;; NOTE: by the time	any of these routines get control there	are;       4 bytes of return information on the stack. the seqitem;       starts at 5,s; This routine looks at the note on the	stack and returns the tone number;; This routine will	look at the seq item on the stack and return; the track number in the accumulator.findtrk	PROC*         using seqdata; first find out what track we are talking about. 	lda seqitem+2	; high word of seq item	xba	; high byte on bottom	lsr a	lsr a	lsr a	and #$000F	; zero everything but the track	rts	ENDPfindtone	PROC*         using	seqdata	lda seqitem	; get the low part of the item	xba	; put byte with tone on bottom	and #$7F	; mask off note bit.	rts	ENDP; This routine will	look at the seq item on the stack and return the volfindvol	PROC*         using	seqdata	lda seqitem	; get the low part of the item	and #$7F	; mask off garbage	rts	ENDP; This routine will	look at the seq item and return the duration and delayfinddur	PROC*         using	seqdata	lda seqitem+2	; get the high part	and #$87FF	; mask off track info	rts	ENDP; This routine will	look at the seq item on the stack and return the cmdfindcmd	PROC*         using	seqdata	lda seqitem	; get the low part of the item	and #$7F	; mask off garbage	rts	ENDP; -- this routine will return the contents of val2 from a control itemfindval2	PROC*         using	seqdata	lda seqitem+2	; get the high part	and #$FF	; mask off high byte	rts	ENDP;          copy	 seq.mtool.asm; Copyright nineteen eighty seven too nineteen eighty eight.; All rights reserved. Apple Computer, Inc. '87-'88/'88.;_____________________________________________________________________;; This file contains an odd collection of tool calls available from ; the sequencer.;; Note that although they don't check they all assume that there has ; been a call to start seq made prior to making any of these calls.; If there hasn't been ...;;;____________________________________________________________________;; Call #9;; SetIncr -- set the increment value.;;; Normally the increment value is set once during the startup call.; by making this call the application can change it.;; Note that the increment can also be changed from within the sequence; itself by using a	tempo command. Since the increment is a	global; variable, life can get very weird if you aren't careful.;; inputs: increment	: word;; Errors: None;_____________________________________________________________________;setincr	PROC*         using seqdataincr	equ 9	phd	tcd	; set up my wap as dirpage	lda incr,s	; get the value of incr	sta <increment	ldy #$02	jmp endcall	ENDP;____________________________________________________________________;; ClearIncr -- clear the increment value.;; Call #10;; Normally the increment value is set once during the startup call.; by making this call the application can change it.;; ClearIncr will clear the value of increment. This will cause the ; sequencer to pause. Notes that are on	will not get turned	off, etc.; The old value of increment is returned.;; output: increment	: word;; Errors: None;_____________________________________________________________________;clearincr	PROC*         using seqdataincr	equ 9	phd	tcd	; set up my wap as dirpage	lda <increment	; get the value of incr	sta incr,s	stz <increment	ldy #$00	jmp endcall	ENDP;____________________________________________________________________;;; Call #11;; GetTime -- this routine will return the current value of the; timer. If the sequencer is not stopped then this value will ; probably not be correct. It will however give the application an; approximate idea of where the sequencer is at.;;; output -- timer :	word;; Errors: None;_____________________________________________________________________;gettime	PROC*         using seqdatatime	equ 9	phd	; set the direct page to my wap	tcd	lda <tickcount	sta time,s	ldy #$00	jmp endcall	ENDP;____________________________________________________________________;; Call #12;; GetLoc -- will return the phrase index, patt index and level.; again, unless the	sequencer has been stopped, this information is; probably only a best guess. ;; output  phrase : word;         patt : word;         level : word;; Errors: None;_____________________________________________________________________;getloc	PROC*         using seqdataphrase	equ 9patt	equ 11lev	equ 13	phd	tcd	; set my wap ad dirpage	lda <curphrase	sta phrase,s	lda <curpatt	sta patt,s	lda <level	sta lev,s	ldy #$00	jmp endcall	ENDP;_____________________________________________________________________;;; Call #13;; All Notes Off -- This routine just calls the code for the	all off; control call. I thought some people might want to make the call from ; an application. It might be especially useful with the ClearIncr call.;;; Inputs:  none;; Errors: None;_____________________________________________________________________;allnoteoff	PROC	phd	tcd	; set up direct page	jsr TurnSeqNotesOff	; sequencer notes should be turned off.	ldy #$00	jmp endcall	ENDP;          copy	 seq.glue.asm*********************************************************************************			                   **  This file contains the glue routines	used to by pass the	tool locator       **  for the following calls. _NoteOn _NoteOff _AllocGen _MidiWritePacket.       **			                   *********************************************************************************NoteOnGlue	PROC	phk	; push extra RTL.	lda #GlueReturn-1	;	pha	lda NoteOnAddr+1	; address of call.	pha	phb	; extra byte.	lda NoteOnAddr	sta 1,s	;	tdc	; get my dp.	sec	sbc #$100	; N. Synth dp.; Poll Midi before NoteOn.	pha	jsl MIDIInputPoll	plaGlueReturn	rtl	ENDPNoteoffGlue	PROC	phk	; push extra RTL.	lda #GlueReturn-1	;	pha	lda NoteOffAddr+1	; address of call.	pha	phb	; extra byte.	lda NoteOffAddr	sta 1,s	;	tdc	; get my dp.	sec	sbc #$100	; N. Synth dp.; Poll Midi before NoteOff.	pha	jsl MIDIInputPoll	plaGlueReturn	rtl	ENDPAllocGlue	PROC	phk	; push extra RTL.	lda #GlueReturn-1	;	pha	lda AllocAddr+1	; address of call.	pha	phb	; extra byte.	lda AllocAddr	sta 1,s	;	tdc	; get my dp.	sec	sbc #$100	; N. Synth dp.; Poll Midi before AllocGenerator.	pha	jsl MIDIInputPoll	plaGlueReturn	rtl	ENDPMidiwriteglue	PROC	phk	; push extra RTL.	lda #GlueReturn-1	;	pha	lda MidiWriteAddr+1	; address of call.	pha	phb	; extra byte.	lda MidiWriteAddr	sta 1,s	;	lda mididpGlueReturn	rtl	ENDP	END