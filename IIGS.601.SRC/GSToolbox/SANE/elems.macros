;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; File:  MACRO.o;; Macros for building 65816 Elems V0.0;; Status: First attempt;; Copyright Apple Computer, Inc., 1983-1986;; All Rights Reserved;;;; Written by C. Hausmann, 1983;;;; Modification History;;      21Mar86 CRL     Revised for 65816;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;------------------------------------------------------------------------------;;       POP Macros:;;------------------------------------------------------------------------------;                 MACRO                 POP2           &N1                PLA                STA             &N1                PLA                STA             &N1+1                MEND;                 MACRO                 POP3           &N1                PLA                STA             &N1                PLA                STA             &N1+1                PLA                STA             &N1+2                MEND;                 MACRO                 POP4           &N1                PLA                STA             &N1                PLA                STA             &N1+1                PLA                STA             &N1+2                PLA                MEND;;------------------------------------------------------------------------------;;       PUSH Macros:;;------------------------------------------------------------------------------;                 MACRO                 PUSH2          &N1                LDA             &N1+1                PHA                LDA             &N1                PHA                MEND;                 MACRO                 PUSH3          &N1                LDA             &N1+2                PHA                LDA             &N1+1                PHA                LDA             &N1                PHA                MEND;                 MACRO                 PUSH4          &N1                LDA             #$0                PHA                LDA             &N1+2                PHA                LDA             &N1+1                PHA                LDA             &N1                PHA                MEND;                 MACRO                 PUSHZP         &N1                LONGA           ON                LONGI           ON                REP             #$30                PEA             0                CLC                TDC                ADC             #&N1                PHA                SEP             #$30                LONGA           OFF                LONGI           OFF                MEND;                 MACRO                 PUSHWORD       &N1                LONGA           ON                LONGI           ON                REP             #$30                LDA             #&N1                PHA                SEP             #$30                LONGA           OFF                LONGI           OFF                MEND;;------------------------------------------------------------------------------;;       MOVE Macros:       Moves Location1 -> Location2;;------------------------------------------------------------------------------;                 MACRO                 MOVE2          &N1,&N2                LDA             &N1                STA             &N2                LDA             &N1+1                STA             &N2+1                MEND;                 MACRO                 MOVE3          &N1,&N2                LDA             &N1                STA             &N2                LDA             &N1+1                STA             &N2+1                LDA             &N1+2                STA             &N2+2                MEND;                 MACRO                 MOVECA         &N1,&N2                LONGA           ON                LONGI           ON                REP             #$30                CLC                TDC                ADC             #&N1                STA             &N2                SEP             #$30                LONGA           OFF                LONGI           OFF                STZ             &N2+2                MEND;;------------------------------------------------------------------------------;;       COPY_EXTEND Macro:  Copies data pointed to by address in %1 to location;                           %2 on zero page;;------------------------------------------------------------------------------;                 MACRO&LABEL           COPY_EXTEND    &N1,&N2                PHX                LDY             #$9                TYX&LABEL          LDA             [&N1],Y                STA             &N2,X                DEY                DEX                BPL             &LABEL                PLX                MEND;;------------------------------------------------------------------------------;;       SANE Macros:;;------------------------------------------------------------------------------;                 MACRO                 FBGE           &N1                BVS             &N1                BEQ             &N1                MEND;                 MACRO                 FBPLUS         &N1                BPL             &N1                MEND;                 MACRO                 FBUGT          &N1                BVS             &N1                BMI             *+4                BNE             &N1                MEND;                 MACRO                 FBLT           &N1                BMI             &N1                MEND;                 MACRO                 FBULE          &N1                BMI             &N1                BEQ             &N1                BVC             &N1                MEND;                 MACRO                 FBLE           &N1                BMI             &N1                BEQ             &N1                MEND;                 MACRO                 FBEQ           &N1                BEQ             &N1                MEND;                 MACRO                 FBNE           &N1                BMI             &N1                BVS             &N1                BNE             &N1                MEND;                 MACRO                 FBGT           &N1                BVS             &N1                MEND;                 MACRO                 FBULT          &N1                BMI             &N1                BVS             *+4                BNE             &N1                MEND;                 MACRO                 CallEl                REP             #$30                JSL             Call_El                MEND;                 MACRO                 CallFp                REP             #$30                JSL             Call_Fp                MEND;; END OF FILE;