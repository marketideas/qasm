	EJECT********************************************************************************GetKeyTranslation	PROC EXPORT** Description:	returns the current keyboard translation number*** Inputs:   None** Outputs:  	TransID:WORD** External Refs:** Entry Points:********************************************************************************SaveDPage	equ 1RTL1	equ SaveDPage+2RTL2	equ RTL1+3Result	equ RTL2+3; first set up the stack the way we want to see it!	phd	; save the old direct register	tcd	; and use the EMDirectPage	bne @OK1	; If em's dpage is zero then tool not started	ldx #ActiveErr	; return error if em not started	bra @ErrOut;; If we get here, everything is groovy!@OK1; get the current translation from BRAM ...	pha	; room for result	lda #kTransBParamLoc	pha	_ReadBParam	; get our parameter	bcs @1	; if error skip next line	lda #0	; no error, use zero here@1	tax	; store the error in <X>	pla	sta Result,s	; save it as our result@ErrOut	pld	; restore the direct page	txa	; put the error in <A>	cmp #1	; and set the carry if error <>0	RTL	; and exit.		EndP		EJECT********************************************************************************SetKeyTranslation	PROC EXPORT** Description:	Dumps the old key translation table that we were using, and*	if the number passed is valid, sets a new one. If the passed*	number is invalid, then we set it to $FF, or standard.*** Inputs:	TransID:WORD** Outputs:  	None** External Refs:** Entry Points:********************************************************************************SaveDPage	equ 1RTL1	equ SaveDPage+2RTL2	equ RTL1+3TransID	equ RTL2+3; first set up the stack the way we want to see it!	phd	; save the old direct register	tcd	; and use the EMDirectPage	bne @OK1	; If em's dpage is zero then tool not started	ldx #ActiveErr	; return error if em not started	brl @ErrOut;; If we get here, everything is groovy!@OK1; First thing to do is swap in the Apps resID if the event manager exists...	stz <kTransTemp		pea 0	_ResourceStatus	pla	beq @NoResMgr	; if zero, no resource manager...	pha	_GetCurResourceApp	pla	sta <kTransTemp		pei <ProgID	; swap the apps res file in...	_SetCurResourceApp@NoResMgr; get the current translation from BRAM ...	lda <kTransRef	; test to see if we have a table in current use...	ora <kTransRef+2		bne @OK2	brl @LoadNew	; if not, just load us a new one!@OK2	pha	; room for result	lda #kTransBParamLoc	pha	_ReadBParam	; get our parameter	bcc @1	; if error skip next line	tax	; place the error in <X>	pla	; strip the offending junk from the stack	brl @ErrOut	; and report the error@1	pla	; convert it to the right number	and #$00FF	ora #$0600	; add event mgr ID	tax	; save it in <X> for a second...	pea $8021	; ktrans resource type	pea $0FFF	; resource ID; create the low byte of the ID here!	phx	; event manager resource #1	_ReleaseRomResource	; now call releaseROMResource	bcc @2	; 	tax	; place the error in <X>	pla	; strip the offending junk from the stack	brl @ErrOut	; and report the error@2;; This next routine tries to load the passed ktrans table, if its -1, it will try to; load the default.@LoadNew	stz <ktransRef	stz <ktransRef+2	stz <kTransFlag	lda TransID,s	; load in the translation ID	bpl @LN0010		pha	; room for result	pea kTransBParamLoc	_ReadBParam	; get our parameter	pla	sta TransID,s	; and save this as the proper translation to load@LN0010	lda TransID,s	; get the desired translation...	beq @DLKTDone	; if zero, then bag it!	and #$00FF	ora #$0600	; add event mgr ID	tax	; save it in <X> for a seconf...	pha	; room for result	pha	pea $8021	; ktrans resource type	pea $0FFF	; resource ID; create the low byte of the ID here!	phx 	; event manager resource #	_GetRomResource	; now call getROMResource	bcc @LN0020	; If any error occured, try the default translation...	pla	pla	lda transID,s	; get the current trans ID...	cmp #$00FF	; is it the default?	beq @LN0015	; if so, skip the next line...	lda #$00FF	; if an error occured, use ROM based res	sta TransID,s	bra @LN0010	; and try again!; This next two lines should never be executed, but just in case....@LN0015	lda #00	; set the translation to none	sta TransID,s	bra @DLKTDone	@LN0020	pla	sta <ktransRef	; save the resource handle	pla	sta <ktransRef+2	; save the pointer+2@DLKTDone	lda TransID,s	; now set batteryRAM to the new value	pha	lda #kTransBParamLoc	pha	_WriteBParam	; and write the battery parameter.	lda #0	; set no error@ErrOut	phx		pea 0	_ResourceStatus	pla	beq @NoResMgr2	; if zero, no resource manager...		pei <kTransTemp	; swap the apps res file in...	_SetCurResourceApp@NoResMgr2	plx	lda RTL1+4,s	; move the return address	sta RTL1+6,s	lda RTL1+2,s	; move the return address	sta RTL1+4,s	lda RTL1,s	; move the return address	sta RTL1+2,s	pld	; restore the direct page	pla	; discard parameter overhead	txa	; put the error in <A>	cmp #1	; and set the carry if error <>0	RTL	; and exit.	EndP	