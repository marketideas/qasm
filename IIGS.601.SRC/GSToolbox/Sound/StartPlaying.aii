***          Copyright Apple Computer, Inc. 1985-1989	 ******          All Rights Reserved		 ******	include 'all.macros'	;removed 17-Sep-90 DAL	include 'm16.util2'	include 'Snd.Equ.aii'********************************************************** 08 Aug 90  Braz** Removed odd oscillator code to prevent trashing * one shot mode set up by FFSetUpSound.** FFSetUpSound now always leaves odd osc in swap halted.******************************************************************************************************************* StartPlaying** This call Takes a word and for each bit set clears the halt bit for the* Corresponding generator.** Note: If the generator numbering ever changes this call will have to change.*********************************************************StartPlaying	PROC EXPORT	import osctable	longa on	longi on		phd		; save callers dp.	tcd		; get my dp.	beq nostart		; no start err.		php		; save state.	sei		; disable interupts.	ldx #16		; gen number.	lda w1+3,s		; get the paramater.	nextgen	beq exit	dex		; dec x to mark new generator.	asl a		; set the carry flag, if osc x to be started.	bcc nextgen		; if clear check nextgen.		pha	shortm		; set a to 8 bits.	lda >osctable,x	; get the actual osc to start.	clc	adc #eocr		; add address to Ensonic Osc Control Reg.	sta gadrl		; point to the control byte for my gen.	lda >irq_volume	; get vol, no inc, to doc.	sta gstatreg	; set to my mode. no inc, to doc.	lda gdatreg		; false read.	lda gdatreg		; get the contol value.	tay		; save for now	and #$0E		; get ie, M1, M0 bits.	bne @1		; if any are set then it just needs to be started.	tya 		; else it is realy supposed to be in swap mode.	ora #$0E		; put in swap mode with IRQ,*	tay		; save control reg.*	lda gadrl		; odd osc is still in loop mode.*	pha		; save for now.*	inc a		; so point to it.*	sta gadrl*	tya		; get control reg back (swap halted).*	sta gdatreg		; halt in swap mode odd osc.*	pla		; get gadrl back for even osc.*	sta gadrl		; point to even osc.*	tya		; get control reg back (swap halted).	and #$FE		; start it.*	sta gdatreg		; reset mode for odd osc.	bra @2		; continue checking@1	tya		; get my control value back.	and #$FE		; clear the low bit (halt bit).@2	sta gdatreg		; start the generator.	longm		; set a to 16 bits.	pla		; get the paramater back.	bne nextgen		; if bits set we aren't done.	exit	ldx #0	; no error.	plp	; restore interupts.	endc 2	; quit, pop paramater, and replace dp.nostart	ldx #NotInitted	; sound tools weren't started.	eout 2	; quit, pop paramater, report err, and replace dp.;; >>>--- exit Start Playing --->>>;;		ENDP			END