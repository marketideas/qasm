********************************************************** Serve.gen: This routine will update the waveform pointers for a*            oscillator.************************************************************	include 'all.macros'	;removed 17-Sep-90 DAL	include 'm16.util2'	include 'Snd.Equ.aii'		import set_gcb	import set_doc_regs		LONGA OFF	LONGI OFF	export serve_genserve_gen	proc		; service oscillator irq	lda gcb_tbl,x	; get the mode byte	beq exit_serve_gen	; this one not in use	and #$0F		; 4 bits of mode	cmp #ffsynth_mode	; is it our mode?	bne other_mode	; not ours pass control	lda gcb_tbl,x	; get the mode back	bpl next_wave_chunk	; waveform completed	LONGA ONchk_pblock	rep #$20		; check for another param block	lda gcbp_ptr,x	; get the pointer	ora gcbp_ptr+1,x	beq no_more_waves		export set_pblockset_pblock	lda gcb_mode,x	; get the mode	and #$FF7F		; mask off wave ended bit	pha 		; save the mode & gen number	lda gcbp_ptr+2,x	; get next wave parameter pointers	and #$00FF		; low byte only	pha 		; save upper word of parameter block	lda gcbp_ptr,x	; get low word of parameter block	pha	lda #$0000		; reset mode byte & gen. number	sta gcb_mode,x	tsc 		; get stack pointer	sec 	sbc #$09		; cheat a bunch	tcs 	jsr set_gcb		; set the generator control block	tsc 		; get the stack pointer	clc 		;	adc #$0F		; put the stack back	tcs 		; put the stack back	LONGA OFF	sep #$20	lda #$03		; new wave/must set doc regs.	sta gcb_new_wave,x	;	jsr next_wave_chunk	; move next block of wave	bra exit_serve_gen	; keep goingno_more_waves	LONGA OFF	sep #$20	lda #$01		; halt this oscillator	jsr sdoc_ctrl	; set the control byte in the DOCexit_serve_gen	rts 		; >>>--- exit serve.gen --->>>other_mode			; user defined mode	jsl sram_base+user_irq	; call their handler	rts 		; all done with this one	export next_wave_chunknext_wave_chunk	lda #gptrinc+gramsel 	; select DOC ram with auto incr	ora >irq_volume	; include system volume	sta gstatreg	lda osc_num_temp	; get the oscillator number	LONGA ON	LONGI ON	rep #$30	ror A		; even or odd oscillator	lda gcb_O0_start,x	; get the DOC wave buffer start address	bcc set_even	clc	adc gcb_doc_count,x	; odd oscillator DOC bufferset_even	sta gadrl		; set DOC ram address	php 		; save micro status register	lda gcb_wave_pos,x	; set source work pointer	sta scratch	;	lda gcb_wave_pos+1,x	sta scratch+1	lda gcb_doc_count,x	; get the number of bytes to move	xba 		; save number of pages to move	sta page_count	; save number of bytes to move	ldy #$0000		; reset work counter	lda gcb_wave_count,x 	; check for end of wave	beq wave_donewave_mover	sep #$30	; 8 bits pleasemove_loop			;	lda [scratch],y	; get a byte	sta gdatreg		; write it to the sound glu	iny	bne move_loop	; move one page	rep #$20	inc scratch+1	; bump source pointer	dec gcb_wave_count,x 	; decrement wave page count	beq wave_done	;	dec page_count	; decr number pages to move	bne wave_mover	lda scratch		; set new wave start position	sta gcb_wave_pos,x	lda scratch+1	sta gcb_wave_pos+1,x	bra exit_wave_mover	; all done for this blockwave_done			;	lda page_count	; did we fill the DOC buffer?	dec A	beq @1	LONGA OFF	LONGI OFF	sep #$30		lda #$00		; pad with 8 zeros	ldy #$40		; need 64 zeroes@2	sta gdatreg	dey	bne @2	LONGA OFF@1	sep #$20* make sure if it is the first time this osc has played,* that it has the freq and stuff set up. so just copy the code as if it wasn't,* done, and then set the mode.	lda osc_num_temp	; get the oscillator number	and #$01		; check for even or odd osc	clc 		; assume odd oscillator	bne @3		bra @4 		; if not odd don't mess with it.@3	rol A	and gcb_new_wave,x	; get the new wave marker*** Bug Fix 2/7/90 MLC*	beq end_wave_move	; BUG - LastBlock bit will NOT be set!!!!!	beq @4		; now it's set....	eor gcb_new_wave,x	; clear even/odd oscillator bit	sta gcb_new_wave,x	; and save updated marker	jsr set_doc_regs	; setup doc registers* now the freq and stuff should be all set up.@4	lda #$80		; mark wave done in mode byte	ora gcb_mode,x	sta gcb_mode,x	rep #$20		; check for more waves	lda gcbp_ptr,x	ora gcbp_ptr+1,x	bne exit_wave_mover	; leave control alone if more waves to follow	LONGA OFF	sep #$20	lda #03		; set to play & halt when done	jsr sdoc_ctrl	; set control register	bra end_wave_moveexit_wave_mover	LONGA OFF	sep #$20	lda osc_num_temp	; get the oscillator number	and #$01		; check for even or odd osc	clc 		; assume odd oscillator	bne @1	sec@1	rol A	and gcb_new_wave,x	; get the new wave marker	beq end_wave_move	eor gcb_new_wave,x	; clear even/odd oscillator bit	sta gcb_new_wave,x	; and save updated marker	jsr set_doc_regs	; setup doc registersend_wave_move	plp 		; restore micro status	rts 		; >>>--- exit wave.mover --->>>	TITLE 'Shut oscillator off'	EJECT********************************************************** sdoc.ctrl: Sets the control register for a oscillator.**     Import: AL = contents to write to osc. control reg.*********************************************************;;	export sdoc_ctrlsdoc_ctrl	pha 		; save control byte	lda #00		; point to DOC no auto incr.	ora >irq_volume	; include system volume	sta gstatreg	;	clc	lda osc_num_temp	; get oscillator number	adc #eocr		; point to control register	sta gadrl	lda gdatreg 	; false read.	lda gdatreg 	; get current stereo position.	and #$F0		; get stereo setting.	ora 1,s		; or in control byte.	sta gdatreg		; write out control byte	pla 		; remove the control byte.	rts 		; >>>--- exit sdoc.ctrl --->>>	endp	end