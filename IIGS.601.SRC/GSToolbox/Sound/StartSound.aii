***          Copyright Apple Computer, Inc. 1985-1989	 ******          All Rights Reserved		 ***	TITLE 'Start sound function call'	EJECT**********************************************************	08 Aug 90   Braz**	Added code to handle OneOscFlag for FFSetUpSound**	Added code to prevent overwrite of last of two*	oscillators for FFStartPlaying (used in SetUpSound)****************************************************************************************************************** SetUpSound is the same as StartSound with the exception that it doesn't start the gen.** Start.sound: This routine will start a generator running.  The mode,*              generator number and parameter block address are passed*              on the stack.**     Import: sp + B = gen #*             sp + A = mode*             sp + 9 = parameter block bank*             sp + 8 = parameter block addrh*             sp + 7 = parameter block addrl*             sp + 6 = rtl address*             sp + 3 = rtl address************************************************************	include 'all.macros'	;removed 17-Sep-90 DAL	include 'm16.util2'	include 'Snd.Equ.aii'	import set_gcb	import setup_doc_ram	import osctable		longa on	longi on	Export SetUpSoundSetUpSound	PROC	phd		; save direct regester.	php 		; save status reg	tcd		; get my dp.	bne @1		; if not zero we were started up.	lda #NotInitted	; Sound Tools wasn't started up.	jmp error_out	; quit returning error.@1	sei 		; no interruptions please	stz SndFlags	; Don't start the generator.	bra DoStartSound	; Continue as if startsound call.	Export StartSoundStartsound	phd 		; save direct register	php 		; save status reg	tcd		; get my dp.	bne @1		; if not zero we were started up.	lda #NotInitted	; Sound Tools wasn't started up.	brl error_out	; quit returning error.@1	sei 		; no interruptions please	lda #StartGenFlg	; Set flag to standard FFStartSound call.	sta SndFlagsDoStartSound		; Entry for FFSetUpCall.	jsr set_gcb		; set up gcb	bcc NotFarAway	jmp error_out	; go away with an errorNotFarAway	phx 		; save the gcb pointer	jsr setup_doc_ram	; move from system ram to DOC ram	plx 		; restore gcb pointer	LONGA OFF	LONGI OFF	sep #$30	phx 		; save gcb.index ;	lda gcb_gen,x	; get the generator number	and #$0F	tax	lda >osctable,x	; get oscillator number	clc 		; point to control registers	adc #eocr	sta gadrl	lda >irq_volume	; point to DOC with no auto incr.	sta gstatreg	;	plx 	lda gcb_gen,x	; get generator number	and #$F0		; keep channel number	ora #$0E		; SWAP, Irq enable, GO (halt OFF)	bit SndFlags+1	; check if OneOscFlg is set.	bpl @1		; both oscillators ($80 = 0ne osc only)	and #$FA		; One-Shot	bit SndFlags+1	; another BRAZ attempt to get FFStartPlaying	bvs New2		; to set the sound done flag in the control	ora #01		; reg. so FFSoundDoneStatus works for a	bra New2		; single oscillator@1	bit SndFlags+1	; check to see if we really want to start the gen.	bvs New2		; if StartGenFlg set then start it now.;from here to New2 is code to halt the gen for setupparm call.; it is necessary to switch mode to loop and halt for both osc.	phx		; save gcb index.	and #$F1		; force into loop mode no irq.	ora #01		; otherwize make sure the bit is halted.	tax		; save for now. X has Ctrl Reg for EVEN	lda gadrl		; get the address.	tay		; save address for now.	inc a		; point to odd osc.	sta gadrl		; because it needs to be switched out of loop mode.	lda gdatreg		; Braz' new code to fix FFStartPlaying bug	lda gdatreg	cmp #$03	beq SkipOddOsc	ora #$0F	sta gdatreg*	txa		; get my control value back*	sta gdatreg		; halt loop mode odd osc.SkipOddOsc	tya		; get value for control reg for even osc.	sta gadrl		; and point to it.	txa		; get my control value back again.	plx 		; restore x.New2	sta gdatreg		; write to DOC control reg.	LONGA ON	LONGI ON	rep #$30	lda gcb_gen,x	; get the generator number	and #$0F	tay	lda #$00	secshift_bits	rol A		; shift the active bit into position	clc	dey	bpl shift_bits	ora >sram_base+active_oscs	; mark generator active	sta >sram_base+active_oscs	ldx #00exit_start	plp 		; restore status register	endc 6;error_out	tax 		; get the error code	plp 		; restore status  register	eout 6		; go out with an error;; >>>--- exit start sound --->>>;;	endp	end