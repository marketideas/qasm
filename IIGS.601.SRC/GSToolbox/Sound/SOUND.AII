****************************************************************** Sound Tools** Copyright Apple Computer, Inc.  1986-1989* All Rights Reserved** This file implements the low level sound tool set.* It has one entry point, the SoundCallTable.** Change History** 09 Jun 88	Mike Askins and Steven Glass** Code converted from EDASM to MAX** 10 Jun 88	Steven Glass** Call table made public.* Fill bytes removed at end of file.*** 29 Jun 88	Matt Denman** Added init of MidiInputPoll (makes it an RTL) in SBoot.** 7 July 88	Matt Denman** Deleted equ * at labels.  Hopefully my labels will be found now.** 25 July 88	Matt Denman** Deleted * seq statements and don't use code_bank equate any more.*** 04 Aug 88	Steven Glass** Removed all uses of the macro ToolCall and replace them with* the official macro.** Fixed a number of attempts to push a long address on the* stack that was done with a pea SoundTools+2 instead of* using the PushLong macro.** 12 Sept 88	Matt Denman** Added three new calls.  FFSetUpSound, FFStartPlaying and FFSetUpParams.** 13 March 89	Harry Yee** Initialize the old MidiInputPoll vector ($E11DD8) to an RTL. We were* breaking some apps because the old Note Synthesizer and new sound tool* were not compatible. This old vector is used by the serial firmware* and gets initialized when the app gets ready to print. So initializing this* old vector does not hurt printing because this vector just gets reinitialized* when printing takes place. We just want to make these apps work as long* as possible (i.e. until printing takes place)*** 2/7/90	Mark Cecys* BUG FIX: 'LastBlock' bit was not getting set when 'NextWave' is used. Fixed bug in* "ServeGen.aii".*****************************************************************	print off	include 'all.macros'	include 'E16.MIDI'	include 'snd.equ.aii'		TITLE 'Cortland Sound Firmware'	EJECT	import StartSound	import SetupSound	import serve_gen	import fsynth_irq	import illmode_error	import SStartup	import SStart_Stat	import StopSound	import Sound_Status	import Gen_Stat	import StartPlaying	import SetUpParam	import ReadParam		print on, nogen, nomdir, nohdrSoundTools	PROC	EJECT************************************************************** the Sound Tools Function Pointer Table**************************************************************	Export SoundCallTableSoundCallTableSTFPT	DC.W (EndSFPT-STFPT)/4		DC.W 0	; for 32 bit count	DC.L SBoot-1	; 1: power-up init	DC.L SStartup-1	; 2: appl startup	DC.L SShutdn-1	; 3: appl shutdown	DC.L STVer-1	; 4: return version info	DC.L SReset-1	; 5: Reset entry	DC.L sstart_stat-1	; 6: tool status	DC.L NotImp-1	; 7: reserved entry	DC.L NotImp-1	; 8: reserved entry	DC.L WriteEblock-1	; 9: move data from RAM to SRAM	DC.L ReadEblock-1	; A: move data from SRAM to RAM	DC.L EntryVect-1	; B: return entry table address	DC.L GetVolume-1	; C: Get a volume level	DC.L SetVolume-1	; D: Set a volume level	DC.L StartSound-1	; E: start sounding	DC.L StopSound-1	; F: stop sounding	DC.L sound_status-1	; 10: active generators word	DC.L Gen_stat-1	; 11: generator busy?	DC.L Smirq-1	; 12: set sound interrupt vector	DC.L suirq-1	; 13 set user synthesizer vector	DC.L gen_ctrl_bytes-1 ; 14 read generator control bytes	DC.L SetUpSound-1	; 15 same as soundstart but doesn't start the gen.	DC.L StartPlaying-1 ; 16 Start specified generators running.	DC.L SetUpParam-1	; 17 Set first two byte of GCB and doc reg as spec.	DC.L ReadParam-1	; 18 Read the DocRam into paramater block.;           Ram based sound tools go here;;EndSFPT		; 	EJECT	LONGA ON 	; assume native m=0, x=0	LONGI ON 	;************************************************************** SBoot is system power-up entry.* It erases the 64K SRAM to all $80 (the DAC Midval)* and inits the DOC registers*** Change History** 29 Jun 88	Matt Dennman** Added init of MidiInputPoll (makes it an RTL)**************************************************************Sboot		;	php 	; no interruptions	sei 	;	lda #$6B	; RTL	sta MidiInputPoll	sta >$E11DD8	jsr wipe_doc_ram	; set doc ram to $80ssboot_1	ldx #sram_size	; number of sound ram locations	lda #$0000	; reset number of active oscillators	LONGA OFF	Sep #$20	; 8-bit ACsram_zap_loop	sta >sram_base+sram_start,x	; clear work ram	dex 	; decrement count	bpl sram_zap_loop	; keep going until all zeroed	lda >irq_volume	; get the system	asl A	; convert to 8 bit form	asl A	;	asl A	;	asl A	;	sta >sram_base+sysvolloc	; save it away	lda >DOCFlag	; check if DOC installed	bne @1	; if not, clear M-bit and exit	jsr InitDoc	; initialize the DOC chip@1		;	plp 	; m, x & irq statusExit0M	rep #$20	; reset M-bitnotimp		;	oendc 0** DOC is present so init it*InitDOC	lda #GPtrInc+GRegSel	; setup to acc regs and increment	ora >IRQ_Volume	; get 4-bit sysvol image	sta >GStatReg	; and setup the GLU	lda #EOEnb	; osc enable reg	sta >Gadrl	lda #62	; 32 oscs	sta >GDatReg	jsr StopDOC	; all vols to 0, all osc off	LONGA ON 	;	rep #$20	;	lda #illmode_error	; apple snd vector	sta >asnd_vect+1	;	sta >sram_base+user_irq_vect	;	LONGA OFF 	;	sep #$20	;	lda #^SoundTools	; point to our code bank	sta >asnd_vect+3	;	sta >sram_base+user_irq_vect+2	;	lda #$5C	; we get to the users vector through a JMP long	sta >asnd_vect	;	sta >sram_base+user_irq	;	LONGA ON 	; 16 bit accum, memory	rep #$20	;	pea sound_vect_ref	; sound vector ref. number	PushLong  #illmode_error	; invalid sound interrupt	_SetVector	rts 	; >>>--- exit InitDoc --->>>** Stop all DOC oscs, set all Vols to 0, and clear sound-on flag** Called w/ M=1, X=0*	LONGA OFF 	;stopdoc		;	php 	;	sei 	; no interruptions	lda #GPtrInc+GRegSel	ora >IRQ_Volume	sta >GStatReg	; setup for register access	lda #EFreqhi	;	sta >Gadrl	lda #$00	;	jsr Fill32	; stop all oscs	lda #EFreqlo	; point set the freq to zero	sta >Gadrl	lda #00	;	jsr Fill32	;	lda #EVol	sta >GAdrl	; point to VolReg0	lda #0	sta >sram_base+SoundOn	; clear the sound playing flag	jsr Fill32	; set all Vols=0	lda #EwavPage	; point to DOC ram page $0000	sta >Gadrl	lda #00	;	jsr Fill32	; stop all oscs	lda #EBTR	; size & resolution = $0000	sta >Gadrl	lda #00	;	jsr Fill32	; all oscs	lda #EOCR	; halt all oscillators, no IRQ	sta >Gadrl	lda #EOCRHlt	; halt, interrupts off	jsr Fill32	; stop all oscs	lda >Irq_volume	; get the system volume	and #$0F	; select doc no auto incr.	sta >Gstatreg	;write to sound glu control	lda #eoir	; point to Ensoniq irq register	sta >Gadrl	;	lda >Gdatreg	; dummy read	ldx #$22	; 34 timesstopdoc_2	lda >Gdatreg	; read irq status	dex 	; decrement count	bne stopdoc_2	; 34 times	plp 	;	rts** Fill the 32 registers pointed to by the GLU with the* 8-bit value in the A-reg** called w/ M=1, X=0*Fill32	ldx #$20F32a	sta >GDatReg	; write to a register	dex	bne F32a	rts	LONGA ON 	;************************************************************** SShutDown stops all sound, kills sound interrupts,* and resets our WAP to zero***   Called SoundShutdown*  Returns No Error**************************************************************sshutdn		;	LONGA ON 	;	LONGI ON 	;	php 	; save interrupt bit	sei 	; no interruptions	lda #0	SetWAP 0,MyToolNum	brl Sboot_1	; shut down rest of system************************************************************** Version number tool returns the current Sound Tool* version #.**    Called:  pea 0 ; return value placeholder*             SoundVersion** Returns: X,Y unchanged.  Version on stack*************************************************************STVer	lda #Version	; get version #	sta W1,s	; place in stack	oendc 0************************************************************** SReset Tool simply stops all sound and sound interrupts**  Called:  SoundReset* Returns:  No error**************************************************************SReset	sep #$20	; M=1	jsr StopDOC	; stop all activity	rep #$20	; M=0	oendc 0************************************************************** EntryVect tool returns the address of the entry-vector* and utility address table.** called:  pea $0*          pea $0 ; 32 bit placeholder*          _GetTableAddress** returns: 32-bit address of utility address table**************************************************************EntryVect	lda #EntryTabl	sta W1,s	; insert in stack placeholder	lda #^EntryTabl	sta W2,S	jmp Exit0M	; clr M-bit and exitt	EJECT************************************************************** The Entry table for fast access to the sound utilities.** Th address of this table is passed back by the Sound Tools* "EntryVect" function.*************************************************************EntryTabl	DC.L RdSReg	DC.L WrtSReg	DC.L RdSRAM	DC.L WrtSRAM	DC.L RdSNxt	DC.L WrtSNxt	DC.L osctable	DC.L gentable	DC.L gcb_xlate	DC.L dis_incr	EJECT************************************************************** Low level entry calls to access individual DOC* registers and RAM locations.** All entered in Native mode with M=1 and X=0.*************************************************************	LONGA OFF 	;rdsreg		;	jsr AccSReg	; setup to access registers	bra SRead	; and read it*rdsram		;	jsr AccSRAM	; setup to acces sound RAMsread		;	lda >GDatReg	; a dummy read to prime the SGlurdsnxt		;	lda >GDatReg	; get the data	rtl 	; and get out*wrtsreg		;	jsr AccSReg	; setup to access registers	bra WrtSNxt*wrtsram		;	jsr AccSRAM	; setup to acces SRAMwrtsnxt		;	sta >GDatReg	; write the data	rtl 	; and return*accsram		;	pha 	; save the AC	LONGA ON	rep #$20	;	txa 	; get reg/addr	sta gadrl	; save reg/addr value	LONGA OFF 	;	sep #$20	; 8 bit accumulator	lda #GPtrInc+GRAMSel	; access RAM and increment	bra acc1accsreg		;	pha	txa 	; get reg/addr	sta gadrl	; point to reg/addr	lda #GPtrInc	; access registers and incrementacc1		;	ora >IRQ_Volume	; or in volume 4-lsbs	sta >GStatReg	; and set the glue status register	pla 	; restore the AC	rts;dis_incr		;	lda >gstatreg	; read the sound glu control	and #$D0	; mask off sys vol & auto incr	ora >IRQ_Volume	; or in volume 4-lsbs	sta >GStatReg	; and set the glue status register	rtl 	; >>>--- exit dis.incr --->>>;;** Satisfy assembler to prevent errors*RateTable	SetupGen	equ NotImpNote	equ NotImpSIntRate	equ NotImpOctavetable	NoteTable	**	include 'tables.aii';;	TITLE 'Set doc ram to $80s'	EJECT********************************************************** Wipe.doc.ram: This routine will fill all of the Doc ram to $80*********************************************************;;wipe_doc_ram		;	LONGA OFF 	;	LONGI OFF 	;	sep #$20	;	rep #$10	;	lda #0	;	sta >Gadrl	; 0 to Gadrl and Gadrh	sta >Gadrh	;	lda #GPtrInc+GRamSel	ora >IRQ_Volume	; get 4-bit sysvol image	sta >GStatReg	; access RAM and increment	lda #$80	; data valueSB1	sta >GDatReg	inx	bne SB1	; loop 64K times	LONGA ON 	;	LONGI ON 	;	rep #$30	;	rts 	; >>>--- exit wipe.doc.ram --->>>;;	EJECT********************************************************** ReadEblock: This function will read a specified number of bytes from*              DOC ram into a user specified buffer anywhere in memory.*              All parameters are passed on the stack.  The stack is*              configured as follows:**     Entry:*              +----------+*              |   $00    |*              +----------+          e=0 ; native mode*              |   Bank   |          m=0 ; 16 bit accumulator/memory*              +----------+          x=0 ; 16 bit index registers*              |Addr. high|*              +----------+*              | Addr low |*              +----------+*              |DOC addrl |*              +----------+*              |DOC addrh |*              +----------+*              |count low |*              +----------+*              |Count high|*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*    SP >>--->>|          |**     Exit:*         e = 0 ; native mode*         m = 0 ; 16 bit accumulator*         x = 0 ; 16 bit index registers*         A = 0, carry = 0 for successful call*         A = error code, carry = 1 for call failed*********************************************************;;	LONGA ON 	;ReadEblock		;	lda >DOCFlag	and #$FF	; mask to low-byte	beq REB1	; 0 indicates DOC installed	ldx #NoDOCErr	oeout 8	; exit w/ err messageREB1	phd 	; save direct register	lda $09,s	; get the count	tax 	; save the count	dec A	; adjust for possible one byte write to $FFFF	clc 	; check for range error	adc $0B,s	; add in the starting address	bcc rrange_ok	; within range	ldx #$0011	; mark a range error	eout 8	; routine will pop direct registerrrange_ok		;	ldy #$00	; point to system ram buffer	lda $0B,s	; point to 1st Ensoniq ram locatio to read	sta >gadrl	;	tsc 	; make a direct page	tcd 	;	LONGA OFF 	;	sep #$20	; 8 bit accumulator	lda #Gptrinc+Gramsel	; point to Ensoniq ram with auto incr.	ora >Irq_volume	; include the system volume	sta >Gstatreg	;	lda >gdatreg	; dummy readreadeloop		;	lda >gdatreg	; get a data byte	sta [$0D],y	; put it away	iny 	; bump ram pointer	dex 	; decrement count	bne readeloop	; keep going until zero	rep #$20	; 16 bit accumulator/memory	endc 8	; it worked go away;;	EJECT********************************************************** Write.Eblock: This function will write a specified number of bytes from*              system ram into DOC ram. The starting address is provided*              by the application. Parameters are passed on the stack.*              The stack is configured as follows:**     Entry:*              +----------+*              |   $00    |*              +----------+          e=0 ; native mode*              |   Bank   |          m=0 ; 16 bit accumulator/memory*              +----------+          x=0 ; 16 bit index registers*              |Addr. high|*              +----------+*              | Addr low |*              +----------+*              |DOC addrl |*              +----------+*              |DOC addrh |*              +----------+*              |count low |*              +----------+*              |Count high|*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*    SP >>--->>|          |**     Exit:*         e = 0 ; native mode*         m = 0 ; 16 bit accumulator*         x = 0 ; 16 bit index registers*         A = 0, carry = 0 for successful call*         A = error code, carry = 1 for call failed*********************************************************;;	LONGA ON 	;WriteEblock		;	lda >DOCFlag	; get the DOC installed flag	and #$FF	; mask to lo-byte	beq WEB1	; DOC installed if = 0	lda #NoDOCErr	; error message	oeout 8	; exit w/ messageWEB1	phd 	; save direct register	lda $09,s	; get the count	tax 	; save the count	dec A	; adjust for 1 byte write to $FFFF	clc 	; check for range error	adc $0B,s	; add in the starting address	bcc wrange_ok	; within range	ldx #$0011	; mark a range error	eout 8	; routine will pop direct registerwrange_ok		;	ldy #$00	; point to data source	lda $0B,s	; the addr. of 1st Ensoniq ram location to write	sta >gadrl	; point to end of DOC ram to read	tsc 	; make a direct page	tcd 	;	LONGA OFF 	;	sep #$20	; 8 bit accumulator	lda #Gptrinc+Gramsel	; enable ram access & auto incr.	ora >Irq_volume	; include the system volume	sta >Gstatreg	;writeeloop		;	lda [$0D],y	; get a data byte	sta >gdatreg	; put it away	iny 	; bump source pointer	dex 	; decrement count	bne writeeloop	; keep going until zero	rep #$20	; 16 bit accumulator/memory	endc 8	; it worked go away;;	EJECT	LONGA ON************************************************************** SetVolume tool sets either a DOC oscillator Volume or* the system Volume.  DOC VolNum's are 0-31. VolNum's 31-255* all set the system volume.** All Volume levels are 8-bits (0-255).  The current* system volume hardware only supports 16 volume levels* so only the upper 4-bits of the volume level are used.***    Called:  pea VolLevel*             pea VolNum*             _SetSoundVolume**  Returns:  nothing**************************************************************SetVolume	jsr WhichVol	; system vol or DOC vol?	LONGA OFF	lda W2,s	; get the volume setting	bcs SSVol	; WhichVol sets cy for sysvol	sta >GDatReg	; write volume to 1st osc	sta >GDatReg	; and the 2nd osc.Exit2M	rep #$20	; reset M-bit	oendc 4	; and exit, dropping 2 wds*SSVol	sta >Sram_base+SysVolLoc	; save the 8-bit vol value	lsr a	lsr a	lsr a	lsr a	; divide by 16	sta >IRQ_Volume	; save 4-bit version	sta >GStatReg	; set sys hardware volume	bra Exit2M	; reset M & exit************************************************************** GetVolume tool acts like SetVolume except it returns the* specified volume level.**    Called: pea $0 ; return value placeholder*            pea VolNum*            _GetSoundVolume**  Returns: specified volume level**************************************************************GetVolume	jsr WhichVol	; sys vol or DOC vol	LONGA OFF	bcs GSVol	; sysvol if cy set	lda >GDatReg	; a dummy read	lda >GDatReg	; read the DOC osc vol.	bra GSV1GSVol	lda >Sram_base+sysvolloc	; read the system volumeGSV1	sta W2,s*Exit1M	rep #$20	; set 16-bit AC	LONGA ON	oendc 2	; exit w/o pld, drop 1 wd.** WhichVol examines the volnum in the top stack parm* and returns w/ cy set if > 15.  If VolNum is < 16,* the sound glu is setup and pointed to the first osc in* the specified logical sound generator.*	LONGA OFFWhichVol	sep #$20	; 8-bit m	lda W2,s	; get VolNum	cmp #15	; >15? set cy for SysVol.	bcs WVR	; return if SysVol	xba 	; get B-Reg	lda #0	; and clear it	xba 	; get back AC	tax	lda >OscTable,x	; get phys osc number	adc #EVol	; add DOC vol reg base addr	sta >Gadrl	; set glu addr	lda #GRegSel+gptrinc	; DOC select / auto incr	ora >IRQ_Volume	; get the 4-bit sysvol image	sta >GStatReg	; set GLU to access DOC, not RAMWVR	rts;;	TITLE 'Sound tools startup call status'	EJECT********************************************************** Sstart.stat: This routine will return the status of the sound tools*              startup call.**     Import: stack+1 ; room for status result*             stack+2 ;*********************************************************;;Sstart_stat		;	sep #$20	; 8 bit accumulator	lda >sram_base+start_stat	; get status for startup call	sta $7,s	; put result on the stack	sta $08,s	; one word	rep #$20	; back to 16 bit accumulator	oendc 0;;	TITLE 'Get sound status'	EJECT********************************************************** Sound.status: This routine will return a word showing which*               oscillators are active.**     Import: Function # = $00*             +------------+*             | status low |    Room for one word of status*             +------------+*             | Status high|*             +------------+*             |  low byte  |*             +------------+*             |  high byte |*             +------------+*             |    bank    |*             +------------+*             |  low byte  |*             +------------+*             |  high byte |*             +------------+*             |    bank    |*             +------------+* SP >>>--->>**     Export:*            (Stack+8) = high byte of DOC active oscillators*            (Stack+7) = low byte of DOC active oacillators**     Errors:*            NONE*********************************************************;;Sound_status		;	lda >sram_base+Active_oscs	; get active oscillators word	sta $07,s	; put in the holding location	oendc 0	; no parameters to strip off;;	TITLE 'Sound tools generator_status'	EJECT********************************************************** Gen.stat: This routine will return the status of a generator**     Import: stack+1 ; room for status result*             stack+2 ;*             stack+3 ; generator number*             stack+4 ;*********************************************************;	LONGA ON 	;	LONGI ON 	;;Gen_stat		;	cmp #$0000	; check if wap installed	beq gen_stat_error	;	phd 	; save direct register	pha 	; set direct register	pld 	;	lda $09,s	; get generator number	cmp #$000F	; keep generator $00-$0E	bcc @1	; bad generator number	ldx #badgen	; invalid generator number	eout 2@1	tax 	; form generator table index	LONGA OFF 	;	LONGI OFF 	;	sep #$30	;	lda #$FF	; assume gen busy	xba 	;	lda >gcb_xlate,x	; get address of gcb	tax 	;	LONGA ON 	;	LONGI ON 	;	rep #$30	lda gcb_mode,x	; get the mode byte for the oscillator	xba 	; gen # high byte, mode low byteexit_gen_stat		;	rep #$30	sta $0B,s	;	endc 2;;gen_stat_error		;	LONGA ON 	;	LONGI ON 	;	ldx #wap_error	; mark an error	oeout 2;;	TITLE 'Set Master interrupt vector'	EJECT********************************************************** Smirq: This routine will set the master interrupt vector to a user*        specified vector.  If this vector is changed it is the*        responsibility of the user to service the interrupts generated*        by the DOC.**     Entry:*              +----------+*              |   $00    |*              +----------+          e=0 ; native mode*              |   Bank   |          m=0 ; 16 bit accumulator/memory*              +----------+          x=0 ; 16 bit index registers*              |Addr. high|*              +----------+     New master interrupt address*              |Addr. low |*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*    SP >>--->>|          |**     Exit:*         e = 0 ; native mode*         m = 0 ; 16 bit accumulator*         x = 0 ; 16 bit index registers*         A = 0, carry = 0 for successful call*********************************************************;;	LONGA ON	LONGI ONSmirq		;	lda >sram_base+wap_installed	; get the wap installed flag	and #$00FF	; low byte	bne set_mvect	; install user vector	ldx #wap_error	; no work area	oeout 4set_mvect		;	pea sound_vect_ref	; sound irq vector ref number	lda $0B,s	; get the vector address	pha 	;	lda $0B,s	; offset by two bytes	pha 	;	_SetVector	LONGA OFF 	;	sep #$20	;	lda #$FF	; mark master irq vector installed	sta >sram_base+mirq_defined	;	LONGA ON	rep #$20	;	oendc 4	; strip 4 bytes off the stack;;	TITLE 'Set Users interrupt vector'	EJECT********************************************************** Suirq: This routine will set the users interrupt vector to a value*        defined by the caller.  If the synthesizer is not one defined*        for the firmware control will be passed to the users synth.*        code.  On powerup the users interrupt vector will be pointed*        a invalid synthesizer error routine.**     Entry:*              +----------+*              |   $00    |*              +----------+          e=0 ; native mode*              |   Bank   |          m=0 ; 16 bit accumulator/memory*              +----------+          x=0 ; 16 bit index registers*              |Addr. high|*              +----------+     New users interrupt address*              |Addr. low |*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*              | RTL bank |*              +----------+*              | RTL alow |*              +----------+*              | RTL ahi  |*              +----------+*    SP >>--->>|          |**     Exit:*         e = 0 ; native mode*         m = 0 ; 16 bit accumulator*         x = 0 ; 16 bit index registers*         A = 0, carry = 0 for successful call*********************************************************;;Suirq		;	lda >sram_base+wap_installed	; check if wap installed	and #$00FF	;	bne set_uvect	; installed set user vector	ldx #wap_error	; not installed report error	oeout 4set_uvect		;	lda >sram_base+user_irq_vect	; hand back old vector to caller	sta $0B,s	;	lda >sram_base+user_irq_vect+2	;	and #$00FF	; low byte only	sta $0D,s	;	lda $07,s	; get the low word of the address	sta >sram_base+user_irq_vect	; save it	lda $08,s	; get upper word of users vector	sta >sram_base+user_irq_vect+1	;	php 	; save status	LONGA OFF 	;	sep #$20	;	lda #$5C	; we get to him through a JMP long	sta >sram_base+user_irq	;	plp 	; restore status	oendc 4	; strip 4 bytes and exit;;	EJECT********************************************************** Gen.ctrl.bytes: This call will read the control register for each*                of the oscillators corresponding to a generator.**     Import: sp-9 = room for result*             sp-7 = generator number to read*********************************************************;	LONGA ON 	;	LONGI ON 	;;Gen_ctrl_bytes		;	php 	;	sei 	; no interruptions	lda $08,s	; get the generator number	cmp #$000F	; check for valid generator	bcs bad_generator	; invalid generator number	tax 	; get oscillator number	lda >osctable,x	;	and #$00FF	;	adc #$A0	; offset to control registers	tax 	;	tay 	; save oscillator number	LONGA OFF 	;	sep #$20	;	jsl rdsreg	; read oscillator ctrl reg.	sta $0A,s	; save the control byte	jsl rdsnxt	; read the next oscillator	and #$01	; save control byte	and $0A,s	; must be 1 for wave to be ended	beq @1	; wave ended	ldx #$08	; delay a minimum of 40 usecs.@3	dex 	;	bne @3	; delay for a while	tyx 	; get oscillator number back	jsl rdsreg	; read oscillator ctrl reg.	sta $0A,s	; save the control byte	jsl rdsnxt	;	and #$01	; save control byte	and $0A,s	; must be 1 for wave to be ended	beq @1	; wave ended	lda #$FF	; wave has ended@1	sta $0A,s	;	sta $0B,s	;	LONGA ON 	;	plp 	; restore status register	oendc 2bad_generator		;	plp 	;	ldx #badgen	; invalid generator number	oeout 2	;		ENDP	END	