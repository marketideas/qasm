***          Copyright Apple Computer, Inc. 1985-1989,1991	******          All Rights Reserved	***	TITLE 'Set up generator control block'	EJECT********************************************************** Set.gcb: This routine will set up the gcb parameter block for a *          generator.**     Import: sp + D = gen #*             sp + C = mode*             sp + B = parameter block bank*             sp + A = parameter block addrh*             sp + 9 = parameter block addrl*             sp + 8 = rts address*             sp + 6 = rtl address*             sp + 3 = rtl address*********************************************************	include 'all.macros'	include 'Snd.Equ.aii'	import next_wave_chunk	import sdoc_ctrl	import set_pblock	import gcb_xlate	import osctable		export set_gcbset_gcb	proc	;	LONGA OFF	LONGI OFF	sep #$30	; 8 accum / index regs	lda gen_no_loc+11,s	; get the generator number	and #$0F	; 16 generators max	cmp #$000F	; gen 15 reserved for system use	bcc gen_ok	; generators 0-E only!	brl gen_err	; invalid generator numbergen_ok	tax 	;	lda >gcb_xlate,x	; get the gcb entry address	tax 	; index into gcb table	lda >sram_base+wap_installed	; check for a valid work area	bne label_01	; no work area assigned?	brl wap_install_err	;label_01	lda >sram_base+wap_addr+1	; get the work area pointer	pha 	;	lda >sram_base+wap_addr	;	pha 	;	pld 	; set new direct register	lda gcb_tbl,x	; get mode byte for generator	and #$0F	; check the synth mode	beq gen_not_busy	; generator free	brl gen_busy_err	;gen_not_busy	ora >sram_base+mirq_defined	; check for master irq defined	bne label_00	; everybody happy	brl irq_vect_err	; otherwise interrupt vector error	LONGA ONlabel_00	rep #$20	;	lda pptr_addl_loc+11,s	; parameter table address 	sta tmp_pram_ptr	;	lda pptr_addh_loc+11,s	;	sta tmp_pram_ptr+1	;	ldy #next_wave_ptr	; get the parameter block for possible next waveform	lda [tmp_pram_ptr],y	;	sta gcbp_ptr,x	; set new pointer	iny 	;	lda [tmp_pram_ptr],y	;	sta gcbp_ptr+1,x	;	iny 	; point to the volume	iny 	;	iny 	;	sep #$20	;	lda [tmp_pram_ptr],y	; get the DOC volume setting	sta gcb_doc_volume,x	;	rep #$20	;buff_size_ok		;	lda mode_loc+11,s	; get the mode byte	and #$00FF	; low nibble	cmp #ffsynth_mode	; is it free form synthesizer?	bne mode_err	; an error if not	lda mode_loc+11,s	; get the mode & gen #	sta gcb_mode,x	; save it	ldy #wave_start	; point to the beginning of param block	lda [tmp_pram_ptr],y	;	sta gcb_wave_pos,x	;	iny 	; bump to bank	lda [tmp_pram_ptr],y	;	sta gcb_wave_pos+1,x	;	iny 	;	iny 	;	iny 	;	lda [tmp_pram_ptr],y	; get the byte count	sta gcb_wave_count,x	;	ldy #doc_buff_start	; get the start of the DOC buffer	lda [tmp_pram_ptr],y	;	sta gcb_o0_start,x	; save it	LONGA OFF	LONGI OFF	sep #$30	;	ldy #doc_buff_size	; get the size of the doc buffer	lda [tmp_pram_ptr],y	; get the doc buffer code	LONGA ON	LONGI ON	rep #$30	and #$07	; three bits	phx 	; save gcb.index	asl A	; times 2 for table alignment	tax 	; form table index	lda >buff_siz_tbl,x	;	plx 	; restore gcb.index	sta gcb_doc_count,x	; save the DOC buffer size	rts 	; >>>--- exit set.gcb --->>>;;	LONGA ON	LONGI ON	; changed index registers to long for errors - Braz 8-24-90	wap_install_err		; wap not installed error	rep #$30	lda #wap_error	; mark wap not installed error	sec 	; mark an error	rts 	;;;gen_busy_err		;	rep #$30	;	lda #gen_busy_error	; generator already busy error	sec 	; mark an error	rts 	;;;gen_err		;	rep #$30	;	lda #badgen	; invalid gen number	sec 	; mark an error	rts 	;;;mode_err		;	rep #$30	;	lda #illmode	; generator mode error	sec 	; mark an error	rts 	;;;irq_vect_err		;	rep #$30	;	lda #mirq_error	; master irq vector not assigned	sec 	; mark an error	rts 	;;;*** dead code, 3-Dec-91 DAL;;inv_buff_size		;;;	rep #$30	;;;	lda #buff_siz_error	; mark a DOC buffer size error;;	sec 	; mark an error;;	rts 	;*** end of dead code;;buff_siz_tbl		;	DC.W $0100	; 256 bytes for $0	DC.W $0200	; 512 bytes for $1	DC.W $0400	; 1024 bytes for $2	DC.W $0800	; 2048 bytes for $3	DC.W $1000	; 4096 bytes for $4	DC.W $2000	; 8192 bytes for $5	DC.W $4000	; 16384 bytes for $6	DC.W $8000	; 32768 bytes for $7;;	TITLE 'Fill Doc ram buffers'	EJECT********************************************************** Setup.doc.ram: This routine will fill the DOC ram buffers for OSC N &*                osc. N+1.**     Import: e=0, m=0, x=0*             (gcb.gen) = generator number*             (gcb.wave.pos) = System ram wave position*             (gcb.wave.count) = number of waveform byte in sys ram*             (gcb.o0.start) = start of DOC buffer for osc. N*             (gcb.doc.count) = number of bytes in DOC buffer*********************************************************;;	LONGA ON 	;	LONGI ON 	;	export setup_doc_ramsetup_doc_ram		;	rep #$30	;	ldy #$0000	; clear index register	tya 	; clear registers	LONGA OFF 	;	sep #$20	;	phx 	; save the gcb.index	lda gcb_gen,x	; get the generator number	and #$0F	; remove channel info	tax 	;	lda >osctable,x	; get the oscillator number	plx 	; restore gcb index	pha 	;	sta osc_num_temp	; save oscillator number	lda #$03	; mark a new wave, both oscs.	sta gcb_new_wave,x	;	jsr next_wave_chunk	; move data for osc N	sep #$20	;	pla 	; get oscillator back	inc A	; next oscillator	sta osc_num_temp	;	lda gcb_mode,x	; look for wave ended	bpl @1	;	rep #$20	; 16 bits	lda gcbp_ptr,x	; next wave parameter pointer	ora gcbp_ptr+1,x	;	bne @2	;	dec osc_num_temp	; go back to the even oscillator	jsr set_doc_regs	; init the registers	LONGA On	lda SndFlags	; mark only one osc.	ora #OneOscFlg	; 	sta SndFlags	;	LONGA OFF 	;	sep #$20	;	bra @3	; go away@2	jsr set_pblock	; more waves to follow	sep #$20	;	bit gcb_mode,x	; has wave ended	bpl @4	;	jsr set_doc_regs	; initialize the DOC	rep #$20	;	lda gcbp_ptr,x	; more waves after this?	ora gcbp_ptr+1,x	;	bne @4	;	sep #$20	;	lda #$03	; no more waves after this	jsr sdoc_ctrl	; make it quit@4		;	bra @3	; go away@1		;	jsr next_wave_chunk	; move data for osc N	LONGA On	rep #$20	; 16 bits	lda SndFlags	; clear one oscillator marker	and #clrOneOscFlg	; 	sta SndFlags	;	LONGA OFF	;	sep #$20	; 8 bits	@3	rts 	; >>>--- exit setup.ram --->>>;;	TITLE 'Setup DOC registers routine'	EJECT********************************************************** Set.DOC.regs: This routine will set up the DOC to run as a FF synth.*               it sets up the frequency, control registers table size*               & resolution bits in the DOC.**     Import: A = oscillator number*             (gcb.doc.siz)  number of pages code ($00-$07)*             (gcb.o0.start) oscillator N start address*             (gcb.wave.freq) frequency for oscillator N & osc N+1*********************************************************;;	LONGA OFF 	;	LONGI OFF 	;	export Set_doc_regsSet_doc_regs 		;	php 	;	phb 	; save data bank register	stx gcb_index_temp	; save gcb index	LONGA OFF 	;	LONGI OFF 	;	sep #$30	lda #sram_bank	; set data bank register	pha 	;	plb 	;	lda #$00	; select DOC, no auto incr	ora >irq_volume	; include system volume	sta sgctrl	; write to sound glu control	ldy #doc_buff_size	; get size of DOC buffer	lda [tmp_pram_ptr],y	;	and #$07	; lower three bits	asl A	;	asl A	;	asl A	;	ora [tmp_pram_ptr],y	; form the size and resolution	xba 	; save the data to write	lda osc_num_temp	; get oscillator number	clc 	;	adc #ebtr	; point to size resolution	tax 	;	xba 	; get value to write	stx sgadrl	; set register pointer	sta sgdata	; write the byte	lda #Efreqlo	; point to frequency reg	clc 	;	adc osc_num_temp	; point to low freq in oscillator N	tax 	; save reg	ldy #wave_freq	; get low byte of frequency	lda [tmp_pram_ptr],y	; get the low byte of the freq.	stx sgadrl	; set register pointer	sta sgdata	; write the byte	lda #Efreqhi	; point to high freq reg	clc 	;	adc osc_num_temp	;	tax 	;	ldy #wave_freq+1	; high byte of frequency	lda [tmp_pram_ptr],y	;	stx sgadrl	; set register pointer	sta sgdata	; write the byte	lda #Evol	; point DOC volume register	clc 	;	adc osc_num_temp	;	tax 	;	ldy #doc_volume	; get the volume setting	lda [tmp_pram_ptr],y	;	beq no_vol_change	;	stx sgadrl	; set register pointer	sta sgdata	; write the byteno_vol_change	lda #Ewavpage	; point to addr pointer	clc 	;	adc osc_num_temp	;	tay 	; save reg number	ldx gcb_index_temp	; get the gcb index back	lda gcb_o0_start+1,x	; get high byte of address	pha 	; save page	tya 	; get the oscillator number	ror A	;	pla 	; get page number back	bcc even_osc	; if odd must bump start address	clc 	;	adc gcb_doc_count+1,x	; calc new page numbereven_osc		;	tyx 	; get oscillator number back	stx sgadrl	; set register pointer	sta sgdata	; write the byte	lda #eocr	; point to the control register	clc 	;	adc osc_num_temp	;	pha 	; save data to write	ldx gcb_index_temp	; get the gcb index	lda gcb_gen,x	; get the channel info	and #$F0	;	ora #$0F	; remove halt mode 4 (11)	plx 	; get new reg  number back	stx sgadrl	; set register pointer	sta sgdata	; write the byte	ldx gcb_index_temp	; get gcb index back	plb 	; restore data bank register	plp 	; restore status register	rts 	; >>>--- exit set.doc.regs --->>>	endp	end