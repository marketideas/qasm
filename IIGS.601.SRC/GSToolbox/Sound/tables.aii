	TITLE 'Oscillator table'	EJECT************************************************************** Table of Physical DOC oscillator #'s indexed by* the logical Sound generator number (0-f)** Entries point to the first osc of each osc-pair* used as a sound generator*************************************************************	export OsctableOsctable	;	DC.B $00,$10,$08,$18	DC.B $04,$14,$0C,$1C	DC.B $02,$12,$0A,$1A	DC.B $06,$16,$0E,$1E;;	TITLE 'Generator table'	EJECT************************************************************** Gen.table: Table of Physical sound generator #'s indexed by*            the DOC oscillator number $00-$1F.*            Entries point to generator number for that pair of oscs.*************************************************************	export GentableGentable		;	DC.B $00,$00	; osc # $00,$01	DC.B $08,$08	; osc # $02,$03	DC.B $04,$04	; osc # $04,$05	DC.B $0C,$0C	; osc # $06,$07	DC.B $02,$02	; osc # $08,$09	DC.B $0A,$0A	; osc # $0A,$0B	DC.B $06,$06	; osc # $0C,$0D	DC.B $0E,$0E	; osc # $0E,$0F	DC.B $01,$01	; osc # $10,$11	DC.B $09,$09	; osc # $12,$13	DC.B $05,$05	; osc # $14,$15	DC.B $0D,$0D	; osc # $16,$17	DC.B $03,$03	; osc # $18,$19	DC.B $0B,$0B	; osc # $1A,$1B	DC.B $07,$07	; osc # $1C,$1D	DC.B $0F,$0F	; osc # $1E,$1F;;	TITLE 'Gen # to gcg addr table'	EJECT********************************************************** gcb.xlate: This table translates the gen number into a gcb entry*            address.**     Import: X = generator number**     Export: X = gcb start addr corresponding to gen #*********************************************************;;	export gcb_xlategcb_xlate		;	DC.B gen0_gcb	;	DC.B gen1_gcb	;	DC.B gen2_gcb	;	DC.B gen3_gcb	;	DC.B gen4_gcb	;	DC.B gen5_gcb	;	DC.B gen6_gcb	;	DC.B gen7_gcb	;	DC.B gen8_gcb	;	DC.B gen9_gcb	;	DC.B genA_gcb	;	DC.B genB_gcb	;	DC.B genC_gcb	;	DC.B genD_gcb	;	DC.B genE_gcb	;