***          Copyright Apple Computer, Inc. 1985-1989	 ******          All Rights Reserved		 **** MidiInputPoll	equ $E101b2	; vector to poll MIDI input for		;  MIDI Tool Set (get from E16.MIDI).;* code_bank	equ $00FF	; running out of bank $FFfake_it	equ $0000	; make it think it runs out of bank $00sram_base	equ $E10000	;sram_bank	equ $00E1	; sound ram work areasram_start	equ $1DB0	; start of ram work area* Note Synth uses E11DC4-E11DCFsram_end	equ $1DCF	; end of sound variablessram_size	equ sram_end-sram_start	; number of bytes* start	equ $3E00	; code runs @ $003E00* max_size	equ $4800-$3E00	; ROM space to use	EJECT** Equates for Sound Glu and ENSONIQ DOC*sgctrl	equ $C03C	; sound glu control registersgdata	equ $C03D	;sgadrl	equ $C03E	; sound glu address low;GStatReg	equ $E1C03C	; sound Glu Stat RegGDatReg	equ $E1C03D	; sound Glu Data RegGAdrl	equ $E1C03E	; sound glu addr-lo RegGAdrH	equ $E1C03F	; sound glu addr-hi Reg** GLU status register bits*Gvol	equ $0f	; bits 0-3GPtrInc	equ $20	; bit 5GPtrNoInc	equ $00	; bit 5 not setGRAMSel	equ $40	; bit 6GRegSel	equ $00	; bit 6 not setGBusy	equ $80	; bit 7auto_incr	equ $20	; Sound glu auto incr enable** Ensoniq register offsets:*  add oscillator # (0-$1f)*EFreqLo	equ $0	; frequency low byteEFreqHi	equ $20	; frequency hi byteEVol	equ $40	; volumeEWavDat	equ $60	; waveform sampleEWavPage	equ $80	; waveform table start pageEOCR	equ $A0	; oscillator control regEBTR	equ $C0	; bank sel, tbl size, resolution** individual ensoniq registers*EOIR	equ $E0	; Oscillator interrupt registerEOEnb	equ $E1	; oscillator enable registerEAtoD	equ $E2	; A/D converter data*** Oscillator Control Register bit assignments*EOCRChnl	equ $F0	; channel assignment bitsEOCRIE	equ $08	; interrupt enable bitEOCRID	equ $F7	; interrupt disableEOCRM2	equ $04	; M2 mode bitEOCRM1	equ $02	; M1 mobe bitEOCRHlt	equ $01	; halt bit** Oscillator Bank, Table size, Resolution register*  bit assignments*EBTRTbl	equ $38	; bits 3,4,5 select table sizeEBTRRes	equ $07	; bits 0,1,2 select resolutionEBTRBnk	equ $40	; bit 6 selects bank** Oscillator interrupt register bit assignments*EOIRIrq	equ $80	; bit 7 is IRQ active if 0EOIROsc	equ $3E	; bits 1-5 show interrupting osc #** Duration Timer equates*DurVal	equ EWavDat+31	; duration osc valueDurEOCR	equ EOCR+31	; duration osc contrl RegDurFreql	equ EFreqlo+31	; duration osc freq lo byteDurFreqh	equ EFreqHi+31	; duration freq hi byte*sys_vol_reg	equ $20	; volume register;;	TITLE 'Sound Tools equates'	EJECT********************************************************** General equates*MyToolNum	equ 8	; Sound Tool numbersound_tool	equ mytoolnum	;** External references*Dispatch	equ $E10000	; Tool dispatcher call addressSIntAddr	equ $E1002D	; sound interrupt vector locDOCFlag	equ $E100D6	; DOC present if zeroIRQ_Volume	equ $E100CA	; 4-bit volume byteasnd_vect	equ $E10148	; apple reserved oscillators irq vectors** Version equates*Version	equ $0300	; version # new romVersion_patch equ $0303** Sound Tools error codes**  Added $08 Hi byte to all error codes - Braz 8-24-90NoDOCErr	equ $0810	; DOC and RAM not installedRangeErr	equ $0811	; addr + count wrapped in DOC RAMNotInitted	equ $0812	; tried to use STools w/o startupwap_error	equ notinitted	; no work area pointer installedBadGen	equ $0813	; illegal logical gen #IllMode	equ $0814	; illegal synthesizer modegen_busy_error	equ $0815	; generator already busy errorbuff_siz_error	equ $0816	; DOC buffer size errormirq_error	equ $0817	; master irq errorstart_err	equ $0818	; sound tools already started erroruncsndirq	equ $08FF	; unclaimed sound interrupt** Stack offset equates*Ret1	equ 1	; return to Tool handlerRet2	equ Ret1+3	; return to callerW1	equ Ret2+3	; top word parameterW2	equ W1+2	; 2nd  "    "W3	equ W2+2	; 3rd  "    "W4	equ W3+2	; 4th  "    "W5	equ W4+2	; 5th  "    "W6	equ W5+2	; 6th  "    "W7	equ W6+2	; 7th  "    "W8	equ W7+2	; 8th  "    ";;**      General equates**	SndFlags equatesOneOscFlg	equ $8000	; high bit. Set if one osc only.ClrOneOscFlg	equ $7FFF	; high bit cleared.StartGenFlg	equ $4000	; 2nd highest bit. Set if to start gen.ClrStartGenFlg	equ $BFFF	; 2nd highest bit cleared.;;Sound_id_tag	equ $4200	; Sound ID tag for misc.toolsSound_vect_ref	equ $000B	; interrupt vector ref. number;;ffsynth_mode	equ $01	; free form synthesizerosc_no_irq	equ $E100CC	; sound oscillator generating irq**   parameters on the stack for start sound*gen_no_loc	equ $06	; generator numbermode_loc	equ $05	; mode locationbank_pptr_high	equ $04	; high byte of 32 bit long wordpptr_bank_loc	equ $03	; parameter block pointer bankpptr_addh_loc	equ $02	; param. block pointer addrhpptr_addl_loc	equ $01	; param. block pointer addrl;;**     Free form synth parameter block*;;wave_start	equ $0000	; wave start address (4 bytes)wave_size	equ $0004	; wave size (2 bytes)wave_freq	equ $0006	; sample frequency (2 bytes)Doc_buff_start	equ $0008	; DOC buffer start addr. (2 bytes)Doc_buff_size	equ $000A	; DOC buffer size (2 bytes)next_wave_ptr	equ $000C	; pointer to next wave parameter block (4 bytes)doc_volume	equ $0010	; DOC volume setting (2 bytes);;	TITLE 'Sound firmware zero page defs'	EJECT********************************************************** sound.zpg: This file contains all of the zero page equates for the*            sound firmware.*********************************************************;**     Free form synth GCB parameter definitions*;;gcb_mode	equ $0000	; FFsynth modegcb_gen	equ $0001	; FFsynth gen/chan no.gcb_wave_pos	equ $0002	; sys ram wave positongcb_wave_count	equ $0005	; sys ram wave countgcbp_ptr	equ $0007	; parameter table pointergcb_o0_start	equ $000A	; start point for DOCgcb_doc_count	equ $000C	; DOC wave sizegcb_doc_volume	equ $000E	; Doc volumegcb_new_wave	equ $000F	; new wave marker/counter;;	DSect 0	;gcb_tbl	equ 0	;gen0_gcb	BYTE $00	; gen 0 mode byte	BLOCK $0F,$00	;gen1_gcb	BYTE $00	; gen 1 mode byte	BLOCK $0F,$00	;gen2_gcb	BYTE $00	; gen 2 mode byte	BLOCK $0F,$00	;gen3_gcb	BYTE $00	; gen 3 mode byte	BLOCK $0F,$00	;gen4_gcb	BYTE $00	; gen 4 mode byte	BLOCK $0F,$00	;gen5_gcb	BYTE $00	; gen 5 mode byte	BLOCK $0F,$00	;gen6_gcb	BYTE $00	; gen 6 mode byte	BLOCK $0F,$00	;gen7_gcb	BYTE $00	; gen 7 mode byte	BLOCK $0F,$00	;gen8_gcb	BYTE $00	; gen 8 mode byte	BLOCK $0F,$00	;gen9_gcb	BYTE $00	; gen 9 mode byte	BLOCK $0F,$00	;genA_gcb	BYTE $00	; gen A mode byte	BLOCK $0F,$00	;genB_gcb	BYTE $00	; gen B mode byte	BLOCK $0F,$00	;genC_gcb	BYTE $00	; gen C mode byte	BLOCK $0F,$00	;genD_gcb	BYTE $00	; gen D mode byte	BLOCK $0F,$00	;genE_gcb	BYTE $00	; gen E mode byte	BLOCK $0F,$00	;FooBarMike	DSectSizegcb_tbl_siz	equ FooBarMike-gcb_tbl	; gcb table size;;;scratch	BYTE $00	;scratch_more	WORD $0000	;tmp_pram_ptr	BYTE $00	; working parameter pointertmp_more	WORD $0000	;osc_num_temp	BYTE $0000	;gcb_index_temp	BYTE $0000	;page_count	WORD $0000	; number of pages to be movedSndFlags	BYTE $00	; One_Osc_Flg, and StartGenFlg.FooBarSteve	DSectSizezpg_size	equ FooBarSteve-gcb_tbl	; number of bytes defined for zero page;;	TITLE 'Sound Bank $E1 equates variables'	EJECT********************************************************** sound.ram.equ: This file contains all of the soundvariables defined*                reside in bank $E1.*********************************************************;;	dsect sram_start	; start of ram work areasysvolloc	BYTE $00	; 8 bit system volume versionsoundon	BYTE $00	; sound on status flagactive_oscs	WORD $0000	; active generators 16 bitsoff_bits	WORD $0000	; Mask for gens to shutoffwap_installed	BYTE $00	; work area installed markerwap_addr	WORD $0000	; work area pointer address holdermirq_defined	BYTE $00	; master irq handler defined errortemp_3	WORD $0000	;new_wave	BYTE $00	; new wave markeruser_irq	BYTE $00	;user_irq_vect	WORD $0000	;user_irq_vect_more	BYTE $00	;start_stat	BYTE $00	; sound tools startup call status;*	MACRO	SetWAP &UorS,&TSNum	; ptr in A,Y	pea &UorS	pea &TSNum	pea $0000	; long word for work area	pha	_SetWap	MENDToStrip	equ $E10184	; Jmp vector to 0ErrOut routine;; 	MACRO 	Endc &numbytes 	pld	ldx #0 	ldy #&numbytes	; 	jml ToStrip	; 	MEND 	;;	MACRO	Oendc &numbytes	ldy #&numbytes	ldx #0	jml ToStrip	; with no PLD	MEND;	MACRO	Eout &numbytes	pld	ldy #&numbytes	; bytes to strip	jmp ToStrip	; with PLD	MEND;	MACRO	Oeout &numbytes	ldy #&numbytes	; bytes to strip	jml ToStrip	; without PLD	MEND;