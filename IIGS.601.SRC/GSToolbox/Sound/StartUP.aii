ault user irq vector routine	rep #$30	pea sound_tool*256+uncsndirq	; unclaimed snd irq									; NOTE: Will never come back!	PushLong #unc_snd_irq			; unclaimed sound irq	_SysFailMgrunc_snd_irq	DC.W unirq_siz			; unclaimed irq size	DC.W $0D	; 5 lines down	DC.W $0A	;	DC.W $0A	;	DC.W $0A	;	DC.W $0A	;	DC.W $0A	;	DC.B '      Unclaimed Sound Interrupt 'unirq_siz	equ *-unc_snd_irq-1		; string size	EndP	end