***          Copyright Apple Computer, Inc. 1985-1989	 ******          All Rights Reserved		 ***	include 'all.macros'	include 'Snd.Equ.aii'********************************************************** Stop.Sound: This routine will stop a Sound generator in the DOC.*             It checks the active flag and stops only the oscillators*             which are running.**     Import: Function # = $00*             +------------+*             |  Mask low  |*             +------------+*             | Mask high  |*             +------------+*             |  low byte  |*             +------------+*             |  high byte |*             +------------+*             |    bank    |*             +------------+*             |  low byte  |*             +------------+*             |  high byte |*             +------------+*             |    bank    |*             +------------+* SP >>>--->>*********************************************************;;Stopsound	proc EXPORT	import osctable	import gcb_xlate	phd	;save direct register	phb	; save data bank register	php	; save m & x bits	sei	; no interruptions	tcd	; set direct reg to	our WAP	longa off	;	sep #$20	; 8 bit accumulator	lda #sram_bank	; point to working ram	pha	;	plb	;	lda sgctrl	; read the Sound glu control register	and #$F0	; mask off low nibble	ora >irq_volume	; include the system volume	pha	; save it	and #gvol	; select the DOC with no auto incr	ora #auto_incr	; sound glu auto incr. enabled	sta sgctrl	; and leave sys volume alone	longa on	;	rep #$20	;	lda >sram_base+active_oscs ; get active	oscillators	and $0C,s	; include the mask	sta >sram_base+off_bits ; save bits for	oscillators to turn	off	eor >sram_base+active_oscs ; turn off active bits on specified oscs_	sta >sram_base+active_oscs ;	ldx #$10	; 16 generators $00-$0Fosc_off_loop	equ *	;	dex	; point to first oscillator	longa on	;	rep #$20	; back into 16 bit accum / memory	lda >sram_base+off_bits ; get oscillators to shut off	asl A;	sta >sram_base+off_bits ;	bcs osc_off	; if set then turn it off	beq osc_off_exit	; all done go away	bra osc_off_loop	; keep going until all offosc_off	equ *	;	longa off	;	sep #$20	; 8 bit accum / memory	lda >osctable,x	; get the oscillator number	pha	; save oscillator number	clc	; point to oscillator number	adc #efreqlo	; point to low byte	of frequency	sta sgadrl	;	stz sgdata	; zero out both oscillators	stz sgdata	;	lda $01,s	; get oscillator number	clc	;	adc #efreqhi	; point to high byte of frequency reg	sta sgadrl	;	stz sgdata	; zero out both oscillators	stz sgdata	;	lda $01,s	; get oscillator number	clc	;	adc #eocr	;check_again	equ *	sta sgadrl	;	xba	; save register number;               lda	    sgdata	; get current DOC control reg;               lda	    sgdata	;;               and	    #eocrid	; disable interrupts;               ora	    #eocrhlt	; halt the oscillator	lda #$01	; with no irqs	xba	;	sta sgadrl	; point to oscillator control	xba	;	sta sgdata	; for both oscillators	sta sgdata	; write out new DOC	control byte	xba	; get reg number	sta sgadrl	;	xba	; keep reg number	lda sgdata	; discard this read	lda sgdata	; even oscillator control byte	and #$01	; keep halt bit	and sgdata	; if non zero go do	next generator	bne go_do_next	;	lda #$14	; kill 50+ usecs. minimum to let DOC complete cyclekill_loop	dec A	;	bne kill_loop	;	xba	; get register number back	bra check_again	;go_do_next	equ *	;	pla	; restore oscillator number	clc	;	adc #evol	; point to volume registers	sta sgadrl	;	stz sgdata	; turn down off the	volume	stz sgdata	; for both oscillators	lda >sram_base+wap_installed ; check for wap installed	beq osc_off_loop	; and if installed then mark mode byte free	phx	; save count	lda #$00	;must set 'b' part of 'c'=0	xba	;	lda >gcb_xlate,x	; get index into gcb for oscillator	tax	;	stz <gcb_mode,x	; clear first word of gcb	stz <gcb_gen,x	;	plx	; restore count	brl osc_off_loop	;osc_off_exit	equ *	;	longa off	sep #$20	; 8 bits accum / memory	pla	; restore sound glu	control register	sta sgctrl	; put it back	plp	; restore status register	plb	; restore data bank	register	endc 2	; two bytes to strip off	ENDP			END