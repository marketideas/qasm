	TITLE 'End call routine'	EJECT********************************************************** Endcall: This routine will move 6 bytes (2 RTL addresses) up the*          stack.  This call will preserve the Direct register and*          accumulator.**     Import:*            A = error code*            P = status flag*            X = number of BYTES to strip**     Export:*            A = error code*            P = status flag*********************************************************;;	LONGA ON 	;	LONGI ON 	;Endcall		;	pld 	; restore direct registerOendcall		; endcall w/o restore dir. reg	ldx #$0000	; successful call	bra oerrout	;Errout		;	pld 	;oerrout		;	tya 	; save the byte count	txy 	; save error code	tax 	; get the count back	cpx #$0000	; check for no movement	beq no_games	; nothing to move	php 	; save the micro status	phd 	; save direct register	tsc 	; get stack pointer	pha 	; set new direct register	pld 	;	lda $08,s	; get a word 1 off the stack	sta $08,x	; move it up x number of bytes	lda $06,s	; get word 2 off the stack	sta $06,x	; move it up x number of bytes	lda $04,s	; get word three of the stack	sta $04,x	; move it up x number of bytes	tsc 	; save stack ptr position	sta $04,s	;	txa 	; get the byte count	clc 	; calculate new stack pointer	adc $04,s	; new stack pointer	adc #$0003	; skip stat. & direct register	pld 	; restore direct register	plp 	; restore status register	tcs 	; point to new stack locationno_games		;	tya 	; restore error code	cmp #$01	; set carry if an error	bcc @1	; everybody happy	ora #sound_tool*256@1		;	rtl 	; >>>--- exit endcall --->>>;;