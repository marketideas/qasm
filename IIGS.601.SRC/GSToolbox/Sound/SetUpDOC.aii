mode,x					; get the mode.			and 	#$F							; and only the mode.			ora		[tmp_pram_ptr]				; and put it in the word paramater.			bra 	cnt1						; continue.SetMode		lda 	[tmp_pram_ptr]				; get the word paramater.			and		#$0F0F						; get just mode and gen number.			sta 	gcb_mode,x					; save the infor in gcb_mode and gcb_gen.Cnt1		plx									; get gen num back.	; Get Osc in x for index to DOC registers.			lda		>OscTable,x					; x has generator in it, get osc.			and 	#$00FF						; OscTable is a byte sized table.			tax									; put osc index in to x.	; See if we set Registers for first osc.			lda 	[tmp_pram_ptr]				; if high bit set do first osc.			pha			bpl 	@1							; if plus, check to see if we do second osc.			jsl 	TransferData				; set up the doc regester for first osc.@1			inx 								; move to second osc.			pla									; if 2nd highest bit set do second osc.			and 	#$4000						; get just 2nd highest bit.			beq 	done						; if cleared, don't do second osc and quit.			lda		tmp_pram_ptr				; get low byte of pointer.			clc									;			adc		#6							; point to Second Regester list.			sta		tmp_pram_ptr				; save it.			lda		tmp_pram_ptr+2				; just in case we wraped add carry			adc		#0							; to the high byte.			sta		tmp_pram_ptr+2				; save it.						jsl 	TransferData				; set up the doc regester for second osc.done		pla									; Restore DP value.			sta		tmp_pram_ptr+2			pla			sta		tmp_pram_ptr				plp									; restore interupts.*			ldx #0								; no error.			endc 4								; quit, pop paramater, and replace dp.	nostarterr	ldx #NotInitted						; sound tools weren't started.			eout 4								; quit, pop paramater, report err, and replace dp.;; >>>--- exit Set Up Param --->>>;;; >>>--- start of routines used by SetUpParam --->>>;* x has osc number. tmp_pram_ptr points to start of data to write.TransferData	php				sei									; no interupts while adressing DOC.								phx				jsl		MIDIInputPoll				; Poll MIDI.				plx								Shortm								; Short Accumulator for Doc.				lda		>Irq_volume					; Get vol.				sta		gstatreg					; Set Sound Glu mode to Doc, no incr.								txa									; Get the Oscilator Index.				sta		gadrl						; Point glu to FreqLow of Oscillator.				ldy		#2							; Index into Paramaters.				loop			bit		SndFlags+1					; Check high bit of flags.				bpl		@1							; If Set Read the value.				lda		[tmp_pram_ptr],y			; Get Value to set.				sta		gdatreg						; Write new value.@1				lda		gdatreg						; False read.				lda		gdatreg						; Read value.				sta		[tmp_pram_ptr],y			; Save the value.								iny									; Get ready to save next param.				cpy		#8							; Is Y = 8 ?				beq		exit						; If Yes exit, if no keep going.				lda		gadrl						; Get current address.				cpy		#5				beq		@2				clc									;				adc 	#$20						; Point to next regester.				sta 	gadrl						; Save it.				bra		loop						; do next.@2				clc				adc 	#$40						; Skip sample and go to Table.				sta 	gadrl						; Save it.				bra		loop						; do next.			exit			plp									;				rtl				;; >>>--- end of routines used by Set Up Param  --->>>;;				ENDP												END