***          Copyright Apple Computer, Inc. 1985-1989	 ******          All Rights Reserved		 ************************************************************* Fsynth.irq: This routine will service interrupts for the DOC free*             form synthesizer.**     Import:*             (E100CC) = oscillator number generating irq.**     Export: A, X, Y, D = same as entry*********************************************************;;;***	include 'all.macros'	;removed 17-Sep-90 DAL	include 'm16.util2'	include 'Snd.Equ.aii'		import gentable	import gcb_xlate	import serve_gen	LONGA OFF 	;	LONGI OFF 	;		export fsynth_irqFsynth_irq	proc	;	phd 	; save direct register	lda >sram_base+wap_addr+1	; point to our work area	pha 	;	lda >sram_base+wap_addr	;	pha 	;	pld 	;	lda >osc_no_irq	;nxt_osc_irq		;	sep #$30	; native	clc 	; no carry please	ror A	; put it in workable form	and #$1F	; 32 oscillators	sta osc_num_temp	; save the oscillator number	cmp #$1E	; check for oscillator 30-31	bcc not_apple	; not apple reserved	jsl apple_snd	; will return through CLC, RTL	bra chk_nxt_osc	; check rest of oscillatorsnot_apple		;	tax 	; save the oscillator number	lda >gentable,x	; get generator number	tax 	;	lda >gcb_xlate,x	; get the start addr of the gcb	tax 	;	php 	; save status reg	jsr serve_gen	;	plp 	; restore statuschk_nxt_osc		;	sep #$20	;	lda >irq_volume	; select DOC no auto incr	sta gstatreg	;	lda #eoir	; read DOC irq register	sta gadrl	;	lda gdatreg	; read the DOC irq register	lda gdatreg	;	bpl nxt_osc_irq	; got a live one!!exit_firq		;	pld 	; restore direct register	clc 	; according to Peter	rtl 	;;;apple_snd		;	jmp >asnd_vect	; go to the Apple reserved vector	endp	end