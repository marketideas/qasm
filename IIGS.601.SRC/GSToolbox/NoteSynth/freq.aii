	Blanks Off	Print	off;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	GAdrL	IMPORT	GDataReg	IMPORT	GStatReg	IMPORT	GptrInc	IMPORT	MidiHookGlue	IMPORT	MidiHookVect	IMPORT	SysVol	IMPORT	doc_freqhi	IMPORT	doc_freqlo	IMPORT	freqtable	IMPORT	gcb_ID	IMPORT	gcb_doc	IMPORT	gcb_pitchbend	IMPORT	gcb_vcb	IMPORT	gcb_vib_cur	IMPORT	gcb_vib_depth	IMPORT	gcb_vib_inc	IMPORT	long	IMPORT	output_table	IMPORT	short	IMPORT	vcb_Apitch	IMPORT	vcb_Bpitch	IMPORT	vibrato_table;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	pitchtofreq	print on, NoGen, NoHdr, NoMdir******************************************************************  pitch_out**  Inputs: gcb must be in dp.  come in with i and a either way.**  Outputs: returns index long, memory short, as requested.******************************************************************		EXPORT	pitch_out pitch_out PROC		print	push		print	off		INCLUDE	'gcb.aii'		INCLUDE 'Note.Macros' 		INCLUDE	'ns.equ'		INCLUDE	'E16.MIDI'		print	pop		both shortapitch   equ 3                          ; stack frame from abpitch   equ 1                          ; pitch point of view.afreqhi equ 4                           ; stack frame later, fromafreqlo equ 3                           ; a frequency point of view.bfreqhi equ 2bfreqlo equ 1         lda   gcb_vib_depth         beq   no_nothin                ; compute LFO as a running         lda   gcb_vib_inc              ; phase accumulator         clc         adc   gcb_vib_cur         sta   gcb_vib_cur         bmi   below* here, the lfo phase was between 0 and 127.  Go up in pitch.         tax         lda   >vibrato_table,x         adc   gcb_vib_depth            ; add two logs together         sbc   #127         bmi   no_nothin         tax                            ; and look up in exp table         lda   >output_table,x         mem_long         and   #$00FF         bra   vib_out                  ; vib out wants long mem* here, the lfo phase was between -128 and -1. Go down in pitch.         longa off         longi offbelow    eor  #$FF                      ; negate any negative part         tax                            ; before going in to table         lda   >vibrato_table,x         adc   gcb_vib_depth            ; add two logs together         sbc   #127         bmi   no_nothin         tax                            ; and look up in exp table         lda   >output_table,x         mem_long         and   #$00FF         eor   #$FFFF                   ; negate the result of mult         bra   vib_outno_nothin mem_long                   ; we jumped here before going long         lda   #0* when we get here, acc is long and it hold the vibrato pitchvib_out  asl   a                        ; total range +- 512         pha* Now the vibrato is in on the stack, as a signed 16 bit number, in my pitch* format.  To this we add the pitchbend, if there is any.* memory is long, index is short!         lda   gcb_pitchbend         and   #$ff         sec         sbc   #$40                     ; turn into signed word         pha                            ; on the stack* multiply by the three bit pitchbend amt         lda   gcb_ID                   ; bits 456 are the ones...         xba         asl   a                        ; now they are bits 13,14,15         bpl   not4                     ; if the hi bit is set, its a         pla                            ; 4 semitone range         asl   a         asl   a         bra   itbe1not4     asl   a                        ; next bit set?         bpl   not2                     ; then its 2 semitone range         pla         asl   a         bra   itbe1not2     pla                            ; otherwise, assume 1 bititbe1    asl   a                        ; mul by four to get         asl   a                        ; +- $100 per semitone* Now the pitchbend amount, is in a, in my pitch format.         adc   1,s                      ; add in the lfo         sta   1,s                      ; and leave it on the stack         ldy   #vcb_Bpitch         lda   (gcb_vcb),y              ; add the pitch offset to         clc         adc   1,s                      ; the A and B pitches         pha         ldy   #vcb_Apitch         lda   (gcb_vcb),y         clc         adc   3,s                      ; and leave them on the stack         sta   3,s                      ; with B at 1, A at 3.* This is a hack to alow midi to be pulled during the NS interupt.		both long						; index was short.		pha         JSL   MIDIInputPoll					; dp, and banks are preserved.         pla* With out this midi data is lost when playing the NS.***************************************************************** NOW there are the two pitches on the stack. (and A is still in acc!)* convert them to frequencies.         both long;apitch   equ 3                          ; stack frame from a;bpitch   equ 1                          ; pitch point of view.;afreqhi equ 4                           ; stack frame later, from;afreqlo equ 3                           ; a frequency point of view.;bfreqhi equ 2;bfreqlo equ 1* convert pitches on stack to frequencies on stack***      lda   apitch,s                 ;(its already there!)         jsr   pitchtofreq              ; NOTE ABSOLUTE ADDRESSING         sta   afreqlo,s         lda   bpitch,s         jsr   pitchtofreq         sta   bfreqlo,s         php                            ; save users irq pref, both long         sei                            *********** NO IRQS *****************         mem_short         lda   gcb_doc         clc         adc   #doc_freqlo         sta   >GAdrL                    ; talking to DOC freq lo reg         lda   >SysVol         ora   #GptrInc                 ; with auto inc         sta   >GStatReg         lda   afreqlo+1,s         sta   >GDataReg         lda   bfreqlo+1,s         sta   >GDataReg         lda   gcb_doc         adc   #doc_freqhi         sta   >GAdrL         lda   afreqhi+1,s                ; now the freq hi         sta   >GDataReg         lda   bfreqhi+1,s         sta   >GDataReg         plp                            ; cli and BOTH LONG ************         pla         pla                            ; clean up the stack!         mem_short                   ; as requested by update         rts		ENDP******************************************************************  PitchToFreq**  Inputs:     Pitch word in A, full native mode**  Outputs:    Freq word in A**  Uses:       x and y*******************************************************************		EXPORT	PitchToFreq PitchToFreq PROC*        using tables         longi on         longa onoctave   equ   12*256         ldy   #10                      maximum octave count         sec         sbc   #octave         bmi   hitbottomloop     dey                            keep subtracting octaves to         sbc   #octave                  find out how many         bpl   loophitbottom adc  #octave                  went too far; back up. (carry was ok)* now the octave count is in y and the remainder is in a         and   #$FFFE         tax                            *** NOTE ABSOLUTE ADDRESSING ***         lda   >freqtable,x             lookup in top octave table* now we have the right pitch, but the wrong octave, in a         dey         bmi   doneshift    lsr   A                        divide by two for each octave down         dey         bpl   shiftdone     rts		ENDP		END