SrcDir	=	:ObjDir	=	:obj:LstDir	=	:lst:Defines	=	{SrcDir}Note.aii							¶			{SrcDir}Note.Macros							¶			{SrcDir}GCB.aiiSources	=	{SrcDir}note.exec.aii						¶			{SrcDir}alloc.aii							¶			{SrcDir}noteon.aii							¶			{SrcDir}noteoff.aii							¶			{SrcDir}update.aii							¶			{SrcDir}freq.aii							¶			{SrcDir}tables.aii							Objects	=	{ObjDir}note.exec.aii.obj					¶			{ObjDir}alloc.aii.obj						¶			{ObjDir}noteon.aii.obj						¶			{ObjDir}noteoff.aii.obj						¶			{ObjDir}update.aii.obj						¶			{ObjDir}freq.aii.obj						¶			{ObjDir}tables.aii.obj						Lists	=	{LstDir}note.exec.aii.lst					¶			{LstDir}alloc.aii.lst						¶			{LstDir}noteon.aii.lst						¶			{LstDir}noteoff.aii.lst						¶			{LstDir}update.aii.lst						¶			{LstDir}freq.aii.lst						¶			{LstDir}tables.aii.lst									tool025	Ä	{Objects} {SrcDir}makefile				LINKIIGS {Objects} -o tool025 -t tol#	DUPLICATEIIGS -y -mac tool025 tool025# 	MAKEBINIIGS tool025 -o tool025.bin# 	EQUAL :Orig:tool025bin tool025.bin# 	DELETE tool025.bin{ObjDir}	Ä	{SrcDir}.aii.obj	Ä	.aii	ASMIIGS -o {ObjDir} {SrcDir}{Default}.aii	{ObjDir}note.exec.aii.obj			Ä	{SrcDir}note.exec.aii		{Defines}{ObjDir}alloc.aii.obj				Ä	{SrcDir}alloc.aii			{Defines}{ObjDir}noteon.aii.obj				Ä	{SrcDir}noteon.aii			{Defines}{ObjDir}noteoff.aii.obj				Ä	{SrcDir}noteoff.aii			{Defines}{ObjDir}update.aii.obj				Ä	{SrcDir}update.aii			{Defines}{ObjDir}freq.aii.obj				Ä	{SrcDir}freq.aii			{Defines}{ObjDir}tables.aii.obj				Ä	{SrcDir}tables.aii			{Defines}listings	Ä	{Sources}	ECHO "Last listings made `Date`" > listings	ASMIIGS -l -lo {LstDir} -o {ObjDir} {NewerDeps}	LINKIIGS {Objects} -o {LstDir}listlink -l > {LstDir}link.lst	DELETE {LstDir}listlink	MAKE listings2 > MAKE.PRINT.CMDS	MAKE.PRINT.CMDS	DELETE MAKE.PRINT.CMDS	listings2	Ä	{Lists} {Defines} {LstDir}link.lst	ECHO "Last listings made `Date`" > listings2	PRINT -h -r -f monaco -s 6 -hf helvetica -hs 12 {NewerDeps}	backup		Ä	BACKUP -a -t 'TEXT' -e -from {SrcDir} -to 1	tobuild		Ä	BACKUP -a -t 'TEXT' -e -from {SrcDir} -to Trouble:Sources:midi:miditools:	search		Ä	SEARCH -i Reg_expr alloc.aii freq.aii gcb.aii makefile Note.aii Note.Exec.aii Note.Macros NoteOff.aii NoteOn.aii ns.equ Tables.aii Update.aii	dup			Ä	DUPLICATEIIGS -y -mac tool025 tool025	duplicate	Ä	DUPLICATEIIGS -y -mac tool025 tool025		