	Blanks off;------------------------------------------;; Instrument and WaveList Equates;		;------------------------------------------vcb_envelope     equ 0vcb_release_seg  equ 24vcb_priority_inc equ 25vcb_current_seg  equ 26vcb_Apitch       equ 28vcb_Bpitch       equ 30vcb_size       equ 32inst_envelope     equ 0inst_release_seg  equ 24inst_priority_inc equ 25inst_pb_range     equ 26                ; pitch bend rangeinst_vib_depth    equ 27inst_vib_inc      equ 28                ; vibrato rateinst_spare        equ 29                ; 1 bytes spare..inst_Awavecount   equ 30inst_Bwavecount   equ 31inst_size         equ 32wp_topkey      equ 0wp_addr        equ 1wp_size        equ 2wp_ctrl        equ 3wp_pitch       equ 4;------------------------------------------------------------------------------------;; Equates for Shared DP of SoundTools ; 	All DP equates from F0-FF are used only while interupts are disabled,;	and the original values must be preserved.;;------------------------------------------------------------------------------------Priority_table	equ	$F0	; Long Pointer to RAM with priority table.min				equ	$F4	; Byte Minimum priority found in Alloc Gen.;------------------------------------------------------------------------------------;; Equates from procedure mydata;;------------------------------------------------------------------------------------num_of_gen equ 14vcb_ram		equ	16		; offset from MyRamPtr to vcb_ram area.* my 8 bytes of reserved ram in bank e1.** It will be set up like this:cubbyhole equ $E11DC4                   ;12 bytes of my own, forevermyram_ptr      equ cubbyhole   * 3 byte pointer to my ram areamyflags        equ cubbyhole+3 * 1 byte with 2 flags:busy_bit equ $80               * bit7 set when update is running;awake_bit equ $1               * bit0 set when Note syn has been initialized.user_bit equ $2                * bit2 set when user passed us a vector forupdatenot_user_bit equ $D			   * all bits set but user_bit, bit 2.not_user_bit_w equ $FFFD	   * all bits set but user_bit, bit 2.reenable_bit equ $4mydp           equ cubbyhole+4 * hi byte of my DP page pointerold_vector     equ cubbyhole+5 * previous IRQ vector stored as 3 bytesuserjump       equ cubbyhole+8 * put jml hereuserUpdate     equ cubbyhole+9 * address of user's routineMy_ID    equ 2                          ; I'm a note synthesizerMy_tool_number equ  25version_number equ $0104SoundTVer	   equ	$0204				; version of the sound tools that I need.update_rate equ 500                     ; default update rate 250 = 10 ms                                        ; 500 = 5 ms,  200 Hz  (.4 Hz steps)NSID		equ		$4119				; ID to use for New Handle call.errNoneAvail equ my_tool_number*256+$21 ; alloc errorerrBadGennum equ my_tool_number*256+$22 ; dealloc errorerrNotStarted equ my_tool_number*256+$23 ;function called before startuperrAlreadyOn equ my_tool_number*256+$24 ; noteon errorerrSoundWrngVer equ my_tool_number*256+$25 ; The sound tools is an incompatible version.errStarted equ my_tool_number*256+1  ; startup errorsoundNotInit equ my_tool_number*256+2;------------------------------------------;; Equates from procedure DOC;;------------------------------------------* Equates for Sound Glu and DOCGStatReg       equ $E1C03C                ; sound glu control/status  registerGDataReg       equ $E1C03D                ; dataGAdrL          equ $E1C03E                ; address lowGAdrH          equ $E1C03F                ; address high* Glu status register bitsGvol           equ $0F                  ; bits 0-3GptrInc        equ $20GptrNoInc      equ $20                  ; (reset bit 5)GRAMsel        equ $40GRegSel        equ $40                  ; (reset 6 to talk to DOC)GBusy          equ $80* DOC registersdoc_freqlo     equ 0doc_freqhi     equ $20doc_vol        equ $40doc_addr       equ $80doc_ctrl       equ $A0doc_size       equ $C0* DOC control register bitsdoc_irq_bit    equ $08doc_halt_bit   equ $01doc_halt_reset equ $03                  ; single cycle mode resets accumDispatch       equ $E10000              ; the big tool* useful control register stateSysVol         equ $E100CA              ; 4 bit volume for everyone* other goodiestimer_osc      equ $0etimer_gen      equ $0e