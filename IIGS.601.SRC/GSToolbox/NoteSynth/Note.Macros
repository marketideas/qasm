 MACRO&lab both &l		IF	&l='short' GOTO .a&lab rep #$30 longa on longi on mexit.a&lab sep #$30 longa off longi off mend MACRO&LAB MEM_Long		IF	'&L'='short' GOTO .A&lab rep #$20 longa on mend MACRO&Lab Mem_Short&lab sep #$20 longa off mend macro&lab     index &l		IF	&l='short' GOTO .a&lab     rep   #$10         longi on         mexit.a&lab     sep   #$10         longi off         mend