;-------------------------------------------------;; Region Equates;; These are now ordered differently.  The order; is in the order they are used. For example,; the Text routines call SetUpPortRegions which; fills in ScanMaskRef thru ScanPtrB.;; Init and Seek Rgn start using RgnPtr, StatePtr; and the Rest.  The Text routines can call; SetUpPortRegions, use the space needed by Init; and Seek Rgn until these are called.ScanMaskRef    equ EndOfGlobalsRgnHandleA     equ ScanMaskRef+4RgnPtrA        equ RgnHandleA+4StatePtrA      equ RgnPtrA+4ScanPtrA       equ StatePtrA+4RgnHandleB     equ ScanPtrA+4RgnPtrB        equ RgnHandleB+4StatePtrB      equ RgnPtrB+4ScanPtrB       equ StatePtrB+4End1Regions    equ ScanPtrB+4          ; Here is where it is safe for;                                       ; the text routines to share;                                       ; the space.RgnHandleC     equ ScanPtrB+4RgnPtrC        equ RgnHandleC+4StatePtrC      equ RgnPtrC+4ScanPtrC       equ StatePtrC+4End2Regions    equ StatePtrC           ; Here is where rgndefs starts using;                                       ; this zp space that is not used;                                       ; until after any rgndef call are;                                       ; complete.RgnPtr         equ ScanPtrC+4StatePtr       equ RgnPtr+4ScanPtr        equ StatePtr+4DataPtr        equ ScanPtr+4MinX           equ DataPtr+4MaxX           equ MinX+2LeftH          equ MaxX+2RLeftmask      equ LeftH+2RRightMask     equ RLeftMask+2RFirstWord     equ RRightMask+2RLastWord      equ RFirstWord+2BufChanged     equ RLastWord+2LeftMask       equ BufChanged+2RightMask      equ LeftMask+2NonRectRegions equ RightMask+2;----------------------------------------------------;; The following equates overlay the region area; of zero page for a short time.  They are only used; when the user calls;;     SetBufStuff;     ForceBufStuff;     RestoreBufDims;NewTBHeight    equ RgnHandleANewMaxFontWidth equ NewTBHeight+2NewTBRowWords  equ NewMaxFontWidth+2NewFontWidth   equ NewTBRowWords+2ForcedFont     equ NewFontWidth        ; this is sharedEndOfRegions   equ NonRectRegions+2ZZEndOfRegions equ EndofRegionsRgnCache       equ 756                 ; 12 back from page 4RgnCacheSize   equ 10280               ; cache size;-----------------------------------------------------------;; Region equates for "init.seek";;----------------------------------------------;; Offsets in state record for rectangular; region.;S_GenLInfo     equ 0S_LOffSet      equ S_GenLInfo+2           ; 2S_LMask        equ S_LOffset+2            ; 4S_ROffset      equ S_LMask+2              ; 6S_RMask        equ S_ROffset+2            ; 8S_ScanBuf      equ S_RMask+2              ; 10S_ScanSize     equ S_ScanBuf+4            ; 14S_RgnTop       equ S_ScanSize+2           ; 16S_RgnBot       equ S_RgnTop+2             ; 18;----------------------------------------------;; Offsets in state record for non-rectangular; region.;;S_GenLInfo     equ 0                    ; 0S_RgnPtr       equ S_GenLInfo+2         ; 2S_DataPtr      equ S_RgnPtr+4           ; 6;S_ScanBuf      equ S_DataPtr+4         ; 10;S_ScanSize     equ S_ScanBuf+4         ; 14S_ThisV        equ S_ScanSize+2         ; 16S_NextV        equ S_ThisV+2            ; 18S_MinX         equ S_NextV+2            ; 20S_MaxX         equ S_MinX+2             ; 22S_LeftH        equ S_MaxX+2             ; 24S_currVpos     equ S_LeftH+2S_DataIndex      equ S_currVpos+2S_SeekDir      equ S_DataIndex+2StateRecSize   equ S_SeekDir+2