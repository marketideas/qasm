; The equates in this file are also used by the cursor routines.MinRect        equ 0MasterSCB      equ MinRect+8UserID         equ MasterSCB+2PortSCB        equ UserID+2            ;   0ImageRef       equ PortSCB+2           ;   2Width          equ ImageRef+4          ;   6BoundsRect     equ Width+2             ;   8PortRect       equ BoundsRect+8        ;  16LocInfo        equ PortSCBEndPart1Globals equ PortRect+8;-----------------------------------------------;; Starting at zero on the page after the zero; page we we normally use are a number of variables; that are not pointers but we need to keep around; The include the current pattern and drawing mask.; Code that addresses these bytes must be careful; to use an appropriate addressing mode to get; it right.;RandSeed       equ 0FontWidth      equ RandSeed+4ScreenHandle   equ FontWidth+2FirstPortHandle equ ScreenHandle+4TheFillPat     equ FirstPortHandle+4TheDrawMask    equ TheFillPat+32SysFont        equ TheDrawMask+32CursorStart    equ SysFont+4;-----------------------------------------------;; This is a location used to store the old value; of the scan line interrupt vector.;OldScanInt     equ $E02000-4;-------------------------------------------------;; DirtyDPFlags Equates;BackPatternOK	equ $4000			; set if pat contains the pre shifted back pat...BackPatternBad	equ $A7FF			; this can reset the BackPatternPenPatOK		equ $2000			; set if pat contains pre-shifted pen patternPenPatBad		equ $C7FF			; this means the pen pat is bad...PenMaskOK		equ $0400			; current pen mask in qd's dpage is OK...PenMaskBad		equ $FBFF			AllPatsBad		equ $87FF			; reset both pattern flags to zeroDirtyFlagsOK	equ $8000			; set if we can actually use the dirty flags...InvPatternOK	equ $1000			; an inverted pattern is set...SolidPatOK		equ $0800			; indicates that the pattern on DP is solidPortBad			equ $8000			; a change to the grafport resets all the flagsPenVisok		equ $0001			; define a pen visible flag, if set pen visible, clear/checkNoPictRecord	equ $0002			; set if we are recording a picNoRgnRecord		equ $0004			; set if we are recording a regionNoPolyRecord	equ $0008			; set if we are recording a polygon...NoUserGrafProcs	equ $0010			; user has installed grafprocs...PortLocOK		equ $0020			; set if the portLoc is OKDrawStateBad	equ $FFC0			; used to reset all 6 draw flags...TestDrawState	equ PenVisOK+NoRgnRecord+NoUserGrafProcs+PortLocOK+NoPictRecord+NoPolyRecord+DirtyFlagsOKTestLineDrawState equ PenVisOK+NoRgnRecord+NoUserGrafProcs+PortLocOK+NoPictRecord+NoPolyRecord+PenPatOK+PenMaskOK+DirtyFlagsOKPreDrawOK		equ PortLocOK+PenPatOK+PenMaskOK+DirtyFlagsOK;-----------------------------------------------------------;; Starting at $100-4 on page 3 we have...Bennet1			equ $100-4Bennet2			equ Bennet1-4Gary1			equ Bennet2-4FastRomFont		equ Gary1-4DirtyDPFlags	equ FastROMFont-4	; used to tell what pretions of DP are still OKDrawIconTemp	equ DirtyDPFlags-8	; 8 bytes for DrawIcon (2-Oct-91 DAL);; free space down to $80