; The cursor routines use nothing more.PortRef        equ EndPart1GlobalsMaxWidth       equ PortRef+4Temp           equ MaxWidth+2Temp2          equ Temp+4PicHandle      equ Temp2+4             ; handle to current picturePicIndex       equ PicHandle+4         ; index into current pictureDrawVerb       equ PicIndex+2DrawNoun       equ DrawVerb+2WhosCalling    equ DrawNoun-1BufferHandle   equ DrawNoun+2CurrentY       equ BufferHandle+4      ; Current scan line being drawn toHowFarToShift  equ CurrentY+2TextBufHandle  equ HowFarToShift+2     ; Handle to memory used as text bufTextBufRowWords equ TextBufHandle+4    ; num words in row of text bufTextBufHeight  equ TextBufRowWords+2   ; num scan lines in text bufEndOfGlobals   equ TextBufHeight+2ZZEndofGlobals equ EndOfGlobalsTRUE           equ $FFFFFALSE          equ $0000MaxInt         equ 32767/2             ; largest number I can deal with