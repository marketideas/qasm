CombinedMask   equ EndofRegionsNotMaskAndDest equ CombinedMask+2SrcStartWord   equ NotMaskAndDest+2SrcFinishWord  equ SrcStartWord+2NumSrcWords    equ SrcFinishWord+2SrcIndex       equ NumSrcWords+2SrcRef         equ SrcIndex+2DestStartWord  equ SrcRef+4DestFinishWord equ DestStartWord+2NumDestWords   equ DestFinishWord+2DestIndex      equ NumDestWords+2DestRef        equ DestIndex+2ShiftTemp      equ DestRef+4ShiftTemp2     equ ShiftTemp+2ThisWord       equ ShiftTemp2+2VertBackward   equ ThisWord+2HorBackward    equ VertBackward+2SrcSCB         equ HorBackward+2SrcPixelMapRef equ SrcSCB+2SrcWidth       equ SrcPixelMapRef+4SrcBounds      equ SrcWidth+2SrcRect        equ SrcBounds+8XferMode       equ SrcRect+8ClipToPortToo  equ XferMode+2DestPoint      equ PortRect             ; becomes rect laterDestRect       equ DestPointDestSCB        equ PortSCB             ; use the standard port infoDestPixelMapRef equ DestSCB+2          ; for this so can do shield cursorDestWidth      equ DestPixelMapRef+4DestBounds     equ DestWidth+2ZZEndOfSlice   equ ClipToPortToo+2