;------------------------------------------------------------;; Equates for the picture itself;o_PicSize      equ 0o_PicFrame     equ 2o_PicData      equ 10;------------------------------------------------------------;; Equates for the picture state record.;o_ThePic       equ 0                    ; handle to real pictureo_PicMax       equ o_ThePic+4           ; current size of picture handleo_PicIndex     equ o_PicMax+4           ; next free byte in pictureo_PicClipRgn   equ o_PicIndex+4         ; handle to clip rgno_PicOrigin    equ o_PicClipRgn+4o_PicBkPat     equ o_PicOrigin+4        ; current background patterno_PicFontID    equ o_PicBkPat+32o_PicTxFace    equ o_PicFontID+4o_PicTxMode    equ o_PicTxFace+2o_PicTxSize    equ o_PicTxMode+2o_PicSpExtra   equ o_PicTxSize+2o_PicChExtra   equ o_PicSpExtra+4o_PicFontFlags equ o_PicChExtra+4o_PicTxLoc     equ o_PicFontFlags+2o_PicFgColor   equ o_PicTxLoc+4o_PicBgColor   equ o_PicFgColor+2o_PicPnMode    equ o_PicBgColor+2o_PicPnLoc     equ o_PicPnMode+2o_PicPnSize    equ o_PicPnLoc+4o_PicPnPat     equ o_PicPnSize+4o_PicFillPat   equ o_PicPnPat+32o_PicTheRect   equ o_PicFillPat+32o_PicPnMask    equ o_PicTheRect+8o_PicOvSize    equ o_PicPnMask+8o_PicArcRot    equ o_PicOvSize+4o_PicVersion   equ o_PicArcRot+2PicSaveRecSize equ o_PicVersion+2