;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------m_temp		equ	$ECseg		equ	$F0seg_tab		equ	$4Csegment_size	equ	$2000max_blk_size	equ	segment_size-6;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------	ENTRY	act_seg	ENTRY	free_blks	ENTRY	seg_integ	ENTRY	tot_blks	;======================================================================;Patch GS/OS code.;		This routine patches allocate and deallocate routines;		in GS/OS.  We do this so we can detect memory failure.;;Input:		None;output:	None;;======================================================================alloc_seg	equ	$01FC1C		;alloc_zerorelease_seg	equ	$01FC20		;deallocate		longa	on		longi	onPatch		proc		import	integrity_diag				rep	#$30		phk		plb			;set my bank please				lda	>alloc_seg	;we have the original address		sta	self_mod1		lda	>alloc_seg+2		sta	self_mod1+2				lda	our_allocate		sta	>alloc_seg		lda	our_allocate+2		sta	>alloc_seg+2;;Patch Release_Seg code;		lda	>release_seg	;we have the original address		sta	self_mod2		lda	>release_seg+2		sta	self_mod2+2				lda	our_deallocate		sta	>release_seg		lda	our_deallocate+2		sta	>release_seg+2		rtl			;we our done!!!				our_allocate	jml	do_alloc_check	;Code that is stored in service vectors!!!our_deallocate	jml	do_dealloc_checkdo_alloc_check		phb		phk		plb		php		jsl	integrity_diag		plp		plbself_mod1	jml	$ffffffdo_dealloc_check		phb		phk		plb		php		jsl	integrity_diag		plp		plbself_mod2	jml	$ffffff		rtl				endp;====================================================================================================;Error_routine:	This routine will call the death manager with an error code.  The routine will not;		return to the caller.  The routine is called with a JSR so I can display the;		address if I want to.;;Input:        ;               A <- Offending segment's offset in the segment table;               X <- Exception Code;               Y <- Position in segment;                   ..000...;               b = k;;;Output:        A = undefined;               X = undefined;               Y = undefined;               P = nvmxdizc;                   ..000...;               b = k;;;;====================================================================================================			longa	on		longi	on		error_routine	proc				sta	AReg		stx	XReg		sty	YReg		sta	>$FFF000		;hit ROM for logic analyzer		phx				ldx	#ascii_size@loop		lda	ascii_info,x		sta	>$020000,x		dex		bpl	@loop				plx		txa		pha				;push the error code				asl	a			;times 2 for word table		tay		lda	error_tbl-2,y		tax		lda	#^error_tbl		;push high word		pha		phx				;push low word				lda	#$0000		sta	>$E100ff		;clear busy flag!		cli				;make sure irq is enabled		ldx	#$1503			;call the death manager		jsl	$e10000		brk	$ff		string	pascalerr1            dc.b	'OSMem: bad leading subseg size: 'err2            dc.b	'OSMem: bad trailing subseg size: 'err3            dc.b	'OSMem: free block count conflict: 'err4            dc.b	'OSMem: used block in free list: 'err5            dc.b	'OSMem: forward link out of range: 'err6            dc.b	'OSMem: back link inconsistent: 'err7            dc.b	'OSMem: missing trailing dtag: ' err8            dc.b	'OSMem: missing forward dtag: ' 		string	asisAscii_info		dc.b	'Seg tbl offset'AReg		dc.w	00		dc.b	'Exception cond'XReg		dc.w	00		dc.b	'Pos in segment'YReg		dc.w	00ascii_size	equ	*-ascii_infoerror_tbl		dc.w	err1		dc.w	err2		dc.w	err3		dc.w	err4		dc.w	err5		dc.w	err6		dc.w	err7		dc.w	err8		endp;======================================================================; select_seg : Find the	next segment in	the segment table;;Created:	April 8, 1987;Modified:	April 24, 1987;Author:	Mike Askins;;Copyright Apple Computer Inc. 1987  All rights	reserved;;Input:		A = Offset of last segment searched;		X = <undefined>;		Y = <undefined>;		P = nvmxdizc;		    ..000...;	  seg_tab = Pointer to segment table;;Output:	A = trashed;		X = preserved;		Y = Offset of newly found segment;		P = nvmxdizc;		    ..000..E  1	-> End of segment table;		b = preserved;	   m_temp = trashed;;======================================================================select_seg	proc		tay		lda	[seg_tab]		sta	m_temp		bra	next_elementvalid_entry					; 		iny				;Move up to high word of entry		iny		lda	[seg_tab],y		;Check IT out...		bmi	next_element2		;If the	MSB is set, free block		dey				;Get back the current offset		dey		rts				;Return	with carry clear and Ynext_element					; 		iny				;Move to next position		inynext_element2					; 		iny		iny		cpy	m_temp			;Off the end		blt	valid_entry		;Still less than the limithigh_tail_it					; 		rts				;Return	CS : off end of	table 		endp		mm_deref	proc				;Entry just to dereference a mm	handle		tya				;Move the high part into the acc		phb				;Save current DBR		xba				;Swap so bank is pulled	last		pha				;Push bank then	$00		plb				;Pull the $00		plb				;DBR now set for handle		lda	|$0002,x		;Get low part		tay		lda	|$0000,x		;Get hi	part		tax		plbnevermind		rts		endp;==========================================================================; integrity.diag : Check the structure of managed memory and crash to the;                   monitor if an inconsistency is found.;; Created:      August 17, 1987; Modified:     November 12, 1987; Author:       Mike Askins;; Copyright Apple Computer Inc. 1987  All rights reserved;; Input:        A = <undefined>;               X = <undefined>;               Y = <undefined>;; Output:       A = preserved;               X = preserved;               Y = preserved;               P = nvmxdizc;                   ..000..E -> 'Out of Memory';               b = preserved;          m_temp = trashed;;=======================================================================; This routine checks all managed memory segments.  If it finds a problem;  it gracefully crashes into the monitor with the registers set as follows:;               A <- Offending segment's offset in the segment table;               X <- Exception Code;               Y <- Position in segment;  Exception Codes:;               $0001   Subsegment has leading size out of range;               $0002   Subsegment has inconsistent trailing size;               $0003   # of free blocks in segment inconsistent w/ free list;               $0004   Used block found in free list;               $0005   Forward link out of range;               $0006   Backward link is inconsistent;               $0007   Trailing dummy tab is missing;               $0008   Leading dummy tag is missing		EXPORT	integrity_diag  integrity_diag  PROC; Hey Mike, we killed this routine for the demo                pha                phx                phy                jsl     seg_integ                bcc     okay                jmp	error_routineokay	;                 ply                plx                pla                rtl		ENDP		EXPORT	seg_integ       seg_integ       PROC; Walk the segment table checking each active segment to see if it is;  currently valid.                lda     #$0000                sta     |act_seg        ;# of segments counter                sta     |free_blks      ;# of free blocks counter                sta     |tot_blks       ;# blocks (free+used) counternext_seg	;                 jsr     select_seg                bcs     done_okay                inc     |act_seg                phy                jsr     check_seg       ;Set Y and X if there's a problem                pla                bcc     next_seg; Return the segment offset in A,...                rtl                     ;Return:  THIS SEGMENT IS BAD!done_okay	;                 lda     #$0000          ;Zero out the results cuz memory's okay                tax                tay                clc                rtl                     ;Return:  MANAGED MEMORY IS OKAY!check_seg	; ; Check this segment (handle passed in X and Y).;  Verify that ...;               1)      The dummy tags are correct;               2)      Each subsegment's length words are consistent;               3)      The (doubly linked) free list includes only free blocks;               4)      The backward and forward links of blocks in the;                        free list are correct.                lda     [seg_tab],y                tax                iny                iny                lda     [seg_tab],y                tay                jsr     mm_deref                stx     <seg                sty     <seg+2                ldy     #$0002                lda     #$8000                cmp     [<seg],y        ;First dummy                bne     out8                ldy     #segment_size-2                cmp     [<seg],y        ;Second dummy                bne     out7; Check each subsegment and verify that each one has matching size fields                ldy     #$0004                ldx     #$0000next_block	;                 lda     [<seg],y                sta     <m_temp         ;Keep around the leading size                bmi     nb1                inc     |free_blks      ;Upkeep total amount of free blocks                inx                     ;Count this guy if a free blocknb1	;                 inc     |tot_blks       ;Count this sub-segment                and     #$7FFF          ;Strip the top bit                cmp     #max_blk_size+1                bcs     out1            ;Leading block size too large                pha                     ;Push leading size                tya                adc     1,s                dec     a                dec     a               ;Find the trailing size                tay                pla                     ;Throw it away                lda     [<seg],y                cmp     <m_temp                bne     out2            ;Trailing block size inconsistent                iny                iny                cpy     #segment_size-2 ;More subsegments?                blt     next_block      ;Yup; Now check the integrity of the free list by verifying each forward & backward;  link.  Make sure that the number of free blocks discovered above is the;  same as the number of blocks found in the free list.                ldy     #$0000          ;Start out at the free list header                lda     #$FFFE          ;Init the 'last visited' location                sta     <m_tempcs1	;                 lda     [<seg],y        ;Get a block index                beq     done            ;We are to the end of the list                dex                     ;Count this object                bmi     out3            ;Forward links say too many free blocks                cmp     #$0004                blt     out5            ;This index is too small                cmp     #segment_size-1                bge     out5            ;This index is too big                tay                lda     [<seg],y        ;Got the size of this block                bmi     out4            ;Whoa... used block in free list                phy                     ;Keep index while we get backward link                iny                     ;Move to backward link                iny                iny                iny                lda     [<seg],y        ;Make sure the back link is correct                ply                     ;Reclaim block's index                cmp     <m_temp         ;Is that back link okay?                bne     out6            ;Back link did not match last block idx                sty     <m_temp         ;Sneak idx here for next back link check                iny                     ;Move to forward link                iny                bra     cs1             ;Got index of next block...done            txa                     ;Did # of free blocks = # in free list                bne     out3            ;Too few items in the free list                clc                rts                     ;THIS SEGMENT IS MORE THAN WONDERFUL!outout	;                 sec                rtsout7            ldx     #$0007          ;Trailing dummy tag is missing                bra     outoutout8            ldx     #$0008          ;Forward dummy tag is missing                bra     outoutout1            ldx     #$0001          ;Subsegment has a leading size error                bra     outoutout2            ldx     #$0002          ;Sub has an inconsistent trailing size                bra     outoutout3            ldx     #$0003          ;Free block count conflict                bra     outoutout4            ldx     #$0004          ;Used block in free list                bra     outoutout5            ldx     #$0005          ;Forward link out of range                bra     outoutout6            ldx     #$0006          ;Back link inconsistent                bra     outout		EXPORT	act_segact_seg		DC.W	0		;# of segments counter		EXPORT	free_blksfree_blks	DC.W	0		;# of free blocks counter		EXPORT	tot_blkstot_blks	DC.W	0		;# blocks (free+used) counter		ENDP		end