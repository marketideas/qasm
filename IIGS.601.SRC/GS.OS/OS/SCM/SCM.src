		print	nohdr,nomdir,nogen		pagesize 70		string	asisdo_force_lock	equ	1	;set to 0 to skip the calls that lock and unlock				; all of GS/OS-managed memory on each and every				; GS/OS call.********************************************************************************* GS/OS System Call Manager ("SCuM")* * Authors:**	Mike Askins	Jan, 1987 - Oct, 1988	*	Jim Jatczynski	Jan, 1987 - Oct, 1988*	Bryan Atsatt	Oct, 1988 - Sep, 1989*	Cary Farrier	Sep, 1989 - Dec, 1990*	Greg Branche	Jan, 1991 - Feb, 1992*	Dave Lyons/Greg July, 1992 - Present** 	a.k.a. "SCuM Lords"** Copyright (c) 1987-93 Apple Computer, Inc.  All Rights Reserved*******************************************************************************		eject*******************************************************************************                                                                            **                  System Call Manager Modification History                  **                                                                            **                                                                            ** Date		Ver	Who	Description                                  ** -------------------------------------------------------------------------- ** 18 Dec 87 - 06/20/90	See an archived version of this file.  I don't see any*			point in wasting all the space for a history lesson.*			I've picked up the revision history after System Disk*			5.0.4 was frozen. (Greg Branche)** 09/25/90		CAF	Uncommented all the console speedup routines, *				now character output is about 28% faster, but*				could use some more work particularly in the*				find_fcr area.  Optimized some code in*				os_shutdown to free up more space, as marked*				by {CAF}.** 01/24/91	3.07(?)	GAB	Removed all code that maintained the unclaimed*				  interrupt counter.*				Added support for JudgeName.** 02/12/91	4.00d1	GAB	Reworked do_type_7 procedure to support the*				  new Init Manager code.** 02/21/91	4.00d2	GAB	Implemented enhanced Volume call.*				Shrunk the GetFSTInfo call a little, and changed*				  the result buffer pointer check so that a NULL*				  pointer is allowed.  Previously, a NULL pointer*				  would produce a param_range_error.*				Checked remaining calls that include a GS/OS result*				  buffer parameter, and they all now allow a NULL*				  pointer.** 02/27/91	4.00d3	GAB	Implemented enhanced GetRefInfo call.*				Cleaned up do_type_7 so that the caller's parameter*				  block is no longer altered.  Since the FST's*				  now accept any pCount from 1-6, and they use*				  the name pointed to by path2_ptr, the parmBlock*				  doesn't need to be modified.** 03/07/91	4.00d4	GAB	$E1 segment now starts at address $E1DA00 instead of*				  $E1DC00.*				When GS/OS displays the dialog asking the user to*				  insert a disk, it will now continually scan all*				  online block devices that contain removeable media*				  (except for Disk ]['s) looking for a disk insertion*				  event.  When GS/OS recognizes that a disk is inserted,*				  the dialog will go away as if the user pressed the*				  Return key to accept the default selection.  (This is*				  actually implemented as a new System Service Call,*				  which AlertWindow calls as part of its event loop.) In*				  addition, SysBeep2 is also called with a beep code*				  of $C030 (disk request, silent by default, activated*				  on next call to GetNextEvent).*				When processing calls to FSTs that contain a pathname*				  parameter (the infamous "bouncing" process), SCM now*				  post-processes the error code returned by the FST in*				  an attempt to prioritize the error.  See the GS/OS*				  Delta ERS for details.*				When processing a pathname that starts with a digit,*				  GS/OS now attempts to determine whether the leading*				  number is a prefix or not.  If it decides that the*				  number is NOT a prefix, it processes the pathname*				  using the default prefix instead of setting the*				  prefix number to the supplied prefix.  This means*				  that you can now specify filenames such as*				  "6.0 Systems" without having to build a full*				  pathname first.** 03/11/91	4.00d5	GAB	OSShutdown call now supports automatically ejecting*				  disks.  If the call is a full shutdown call (not*				  a restart call), or if it is a restart call and*				  bit 2 of the flags is also set, the device*				  dispatcher is called with a command code of 3*				  (full shutdown) instead of 2 (normal shutdown).** 04/24/91	4.00d6	GAB	OSShutdown fixed so that it does not eject disks*				  during a restart call.*				SysBeep2 changed to SysBeep in getkey procedure,*				  since we're not guaranteed that SysBeep2 exists*				  at the time that it's called (i.e. during booting).** 05/09/91	4.00d7	GAB	Volume call enhanced so that if a duplicate volume*				  error is returned from an FST, and the pCount is 7*				  or greater, SCM will fill the caller's parameter*				  block in with the FST ID of the FST that is*				  returning the error, as well as the characteristics*				  parameter.  The device ID parameter is also*				  returned.*				do_type_7 now checks the reqFileSysID parameter to*				  ensure that it refers to an FST that supports*				  formatting prior to calling the Format Manager.** 05/21/91	4.00d8	GAB	do_type_7 now returns error code $65 when a*				  reqFileSysID specifies an FST that is installed*				  in the system but that does not support formatting.** 05/28/91	4.00d9	GAB	do_type_7 defers judgement to the Init Manager on*				  whether or not the reqFileSysID parameter is*				  valid.  This reverses the change made in d7.** 06/07/91	4.00d10	GAB	Main call dispatcher now performs the character FST*				  write check inline, instead of as a subroutine*				  call.*				Device manager calls are special cased like the*				  Character FST Write calls.*				Modified GIM NewHandle call to allocate a new block*				  as locked if the lock_mem call count is non-zero*				  (i.e. if the rest of GIM memory is already locked)** 06/19/91	4.00d11 GAB	Move force_lock and force_unlock from main call*				  dispatcher to FST call dispatcher.*				Set bit 5 of AlertWindow flags so that any*				  buttons displayed in the window are located*				  as suggested by HIG.** 07/24/91	4.00d12 GAB	Changed SysBeep2 flags so that the beep is NOT*				  silent by default.** 07/31/91	4.00d13	GAB	Changed do_type_7 so that bit 13 of the call's*				  'flags' parameter is allowed.  Setting this*				  bit in a Format call will inhibit the display*				  of the 'Initializing' information dialog.** 08/16/91	4.00d14	GAB	Changed volume call so that bit 4 of the returned*				  characteristics parameter will be set if the*				  volume in question contains any open files.** 08/31/91	4.00d15	GAB	Changed do_force_unlock flag so that the calls to*				  force_lock and force_unlock are back where they*				  originally were (within the main call dispatcher)*				  instead of within the Call_FST subroutine.  I*				  forgot that the "speeded-up" calls to the*				  Character FST also go through the Call_FST*				  subroutine, which means that when I added the*				  force_lock and force_unlock around the actual*				  FST call, I slowed down the baud rate again.*				Added logic to call processing to speed up*				  character I/O by not calling inc_busy_flag &*				  dec_busy_flag when the character FST is called.*				  Duplicates functionality of QuickConsole INIT.*				Fixed get_ref_num to work properly if one of the*				  standard I/O prefixes is specified (10, 11,*				  or 12) when the prefix contains a device*				  name.*				Changed do_type_2 so that if a file_busy error*				  is returned from the FST, SCM will see if the*				  caller was attempting to open prefix 11 or*				  prefix 12 (stdout or stderr). If so, SCM then*				  checks the pCount, which must be less than 4 (*				  since it can't return all of the file information*				  described by the remaining parameters).  If the*				  pCount is within range, the system will then*				  compare the contents of the two prefixes.  If*				  the prefixes are identical (except for character*				  case), GS/OS will return the same refnum as*				  used for the alternate i/o stream (e.g. if*				  prefix 12 is being opened, but the physical*				  file has already been opened as prefix 11,*				  GS/OS will duplicate the stdout prefix for*				  stderr).  This was done to better support*				  i/o redirection.*				Changed do_type_3 so that if a close call is*				  being made with a refnum that applies to BOTH*				  stdout and stderr, the call completes without*				  error, but the file is not actually closed.  In*				  this case, the stderr stream will be the first*				  one logically closed (it's internal refnum is*				  zeroed).*				Added SetStdRefNum call to allow an application*				  (like ORCA) to specifically set the refnum*				  associated with one of the standard i/o*				  prefixes.  Parameter block is identical*				  to GetStdRefNum.  The refnum supplied must*				  refer to a currently open file.*				Bug fix in e1_volume_call.  No longer attempts*				  to return the "open_files" bit of the charac-*				  teristics word if an error is reported by the*				  called FST.*				Had to shuffle some subroutines around from*				  segment to segment to get all of the above*				  to fit.** 09/05/91	4.00d16	GAB	In return_from_lc, checking the state of bit 14*				  of io_flag prior to calling the signal dispatcher*				  was not working properly.  It should now.** 10/10/91	4.00d17 GAB	do_insert_scan modified to skip the status call*				  on an Apple SCSI tape drive.** 10/30/91	4.00d18	GAB	e1_volume_call modified to use the device number*				  stored in dev_num ($36) instead of whatever*				  is left over in drvr_dev_num ($00).** 11/07/91	4.00d19 GAB	new_volume_call modified to zero the string*				  length word in the volume name result buffer*				  prior to calling the FSTs.*				release_v_ptrs optimized.** 11/13/91	4.00d20 GAB	new_volume_call reverted back to its original,*				  pre-4.0d19 form.  Applications are allowed to*				  use the same buffer for both input and output*				  strings for the Volume call.  If SCM zeros*				  the length word, it's actually zeroing the*				  length word of the input pathname.*				Removed code that set 'shutdown_flag', since*				  no one ever reads the value that's stored there.** 12/05/91	4.00d21	GAB	Altered call_fsts to handle the new flags parameter*				  to the ChangePath call.  If bit 15 of the flags*				  word is set AND pathname 1 consists of ONLY a*				  device name (i.e. the volume name is being changed),*				  the Loader_Rename call is skipped.** 12/07/91	4.00d22	GAB	Remove 'and #$00FF' from s_sys_death.  It shouldn't be*				  altering the error code in the first place.*				Add support in set_prefix and get_prefix to allow caller*				  to set and retrieve the '@' prefix.  This is done*				  by specifying a prefix number of $FFFF (-1) in the*				  SetPrefix and GetPrefix parameter blocks.** 01/06/92	4.00d23	GAB	In call_fsts, if an FST returns an error code with the*				  priority bit set (bit 15), SCM will exit the subroutine*				  immediately.  Having the priority bit set means that the*				  FST is claiming that the call belonged to it.  Therefore*				  there's no reason to continue the call loop and allow*				  the remaining FSTs to encounter an error which won't*				  be reported to the caller (since the error with the*				  priority bit set will be the one returned in any case).*				os_shutdown now initializes sys_prefs to 0 prior to*				  displaying the shutdown dialog to ensure that the dialog*				  is actually displayed.** 01/18/92	4.00d24	GAB	Moved e1_get_ref_info back into bank 0 (since optimizing*				  release_v_ptrs freed up enough room for it) and removed*				  it from bank $E1.*				Moved init_fst_tbl into miscellaneous segment to free up*				  some room in the bank $E1 segment.  Also rewrote routine*				  to be more memory efficient.*				$E1 segment now starts at $E1D980 to make room for*				  the following fix.*				Loader_Rename now scans through all active FCRs to see*				  if any portion of an open file's pathname is being*				  changed.  If so, the name stored with the FCR is*				  changed to reflect the new pathname.** 01/23/92	4.00d25	GAB	When the original pathname was specified as ONLY*				  a device name for a ChangePath call, meaning that*				  the volume name was being changed, the*				  insert_vol_name call within Loader_Rename was*				  occurring AFTER the volume name had already been*				  changed by the FST.  This means that the original*				  pathname had the _new_ volume name used instead*				  of the actual original volume name.  I've added*				  the rename_preamble routine that is used by*				  call_fsts PRIOR to calling the FST so that the*				  REAL original volume name can be determined.** 02/10/92	4.00d26	GAB	Fixed bug in xlate_path which was allowing a 0-length*				  pathname to be accepted without generating a*				  bad_path_syntax error.  When I optimized the*				  call in the last version, I missed changing*				  the BNE at is_null into a BEQ to syntax_err.********************************************************************************** Begin 6.0.1** 17-Jul-92	4.02d8 DAL	Changed restart_system to store a little piece*				  of code at $F0 instead of $0300 (it bugged me*				  to have it trash $0300).*				Changed which_one to force screen dimmers to*				  un-dim before choosing whehter to use the*				  Super Hi-Res screen or not.  Reorganized code*				  to come close to breaking even in bytes.*				Minor optimizations to save enough bytes for the*				  above changes.** 20-Jul-92	DAL		Changed the above SendRequest in which_one to*				  clean up the stack on a dispatcher error,*				  since this can get used during boot before*				  the toolbox is patched (before SendRequest*				  actually exists!).** 12-Aug-92	DAL		Changed SysBeep2 call in s_mount_msg to clean up*				  stack on error (in case Tool.Setup isn't loaded*				  yet).** 20-Aug-92	DAL		Added $01FCE0 s_toolbox_msg, new entry point to*				  the s_full_error routine for AlertMessage to*				  call from the Misc Tools.  Random optimizations*				  to save enough bytes to fit in the above.** 2-Sep-92	DAL		Made two changes to OSShutDown:*				  ¥It was accidentally skipping the DeskShutDown*				  call if flag bit 2 was clear.*				  ¥It wasn't calling os_p8_switch to tell DoRight*				  that GS/OS was going away.** 15-Dec-92	DAL		Two changes disp_common_int:*				  ¥Returns CLC if and only if at least one interrupt*				   handler claimed the interrupt (was previously*				   clearing carry when the *last* handler claimed it).*				  ¥Restores MSLOT after dispatching to an IRQ.OTHER*				   handler.*				  ¥Lots of optimizations to make room for the above,*				   including removing a redundant check in create_seg*				   to see if we need to lock a newly-created handle.** 2-Mar-93	DAL		Added code to put a $4C at $BF00 at the beginning of*				  every GS/OS call, so the Vulcan without a loaded*				  driver will be happy.  Steve Stephenson and I spent*				  long enough investigating this that we fixed it even*				  though it is stupid (Vulcan should not be looking*				  at $BF00 after boot).*				For debugging convenience, on the way out of a GS/OS*				  call we store any nonzero error code at $FC/4242.** 9-Mar-93	DAL		Added code in OSShutDown to call os_p8_switch with*				  A = $8000, so the Ethernet card can cleanly shut*				  down and revert to its original $Cn00 state.********************************************************************************		print	push		print	off		eject*********************************************************************************   Imported Addresses********************************************************************************		import	cash_add		import	cash_del_vol		import	cash_delete		import	cash_find		import	cash_flsh_def		import	cash_init		import	cash_shutdown		import	dev_dispatch		import	e1_app_filename		import	e1_msg_address		import	e1_volname		import	eq_msg_address		import	g_dispatch		import	get_b0_buff		import	get_dnum		import	get_stacked_id		import	init_pack		import	lc_dispatcher		import	p16quit		import	post_driver		import	rename_bootvol		import	set_disk_sw		import	set_gsos_speed		import	slot_arbiter		import	supervisory		import	to_bank0_core				import	insert_driver		import	init_pack_end		import	e1_gsos_ok				eject********************************************************************************* Exported addresses********************************************************************************		export	s_flags:equ		export	entry_size:equ		export	id:equ		export	alert_ptr:equ		export	subst_ptr:equ				export	add_fst		export	deallocate		export	event_queue		export	fst_count		export	fst_tbl		export	gsos_id		export	init_scm		export	os_event		export	restart_system		export	set_prefix_33		export	shutdown_scm		export	close_all_files		export	v_ptr1		export	v_ptr2						eject*********************************************************************************   Forward addresses********************************************************************************		entry	add_element		entry	alloc_int		entry	alloc_record		entry	alloc_string		entry	alloc_zero		entry	allocate		entry	allocfcr		entry	allocvcr		entry	altcharsv		entry	begin_session		entry	bind_int		entry	build_icr		entry	cab_2		entry	calc_span		entry	call_fsts		entry	call_fst		entry	case_mask		entry	char_index		entry	check_call		entry	chk_app_buf		entry	class		entry	classify_char		entry	col80sv		entry	common_disp_jmp		entry	common_int_ent		entry	copy_ext_string		entry	copy_gstring		entry	copy_xlate		entry	create_seg		entry	ctype_vector		entry	curr_fst		entry	cvt0to1		entry	cvt1to0		entry	cvt_normal_exit		entry	dealloc_int		entry	deallocate		entry	death_sub_tbl		entry	default_b_data		entry	dequeue_signal		entry	deref2		entry	deref2_vp		entry	deref_int		entry	interrupt_state		entry	disp_stub_1		entry	disp_stub_2		entry	dispatch_busy		entry	do_button		entry	do_fst		entry	do_get_last_dev		entry	do_judgename		entry	do_quit		entry	do_type_0		entry	do_type_1		entry	do_type_2		entry	do_type_3		entry	do_type_4		entry	do_type_5		entry	do_type_6		entry	do_type_7		entry	domvxonstack		entry	draw_box		entry	empty_vect		entry	end_session		entry	entry_mode		entry	entry_point		entry	entry_type		entry	event_code		entry	event_flags		entry	event_queue		entry	expand_path		entry	fatal_err_num		entry	fatal_err_str		entry	fcr_id_hand		entry	fe_xlate		entry	find_fst		entry	find_record		entry	findfcr		entry	findvcr		entry	findvcrcase		entry	free		entry	free_id		entry	free_mm_seg		entry	fst_count		entry	fst_entry_size		entry	fst_flags		entry	fst_spec		entry	fst_tbl		entry	gbuf		entry	gderef		entry	get_boot_vol		entry	get_fst_info		entry	get_level		entry	get_level_flag		entry	get_mm_id		entry	get_name		entry	get_pfx		entry	get_prefix		entry	get_record		entry	get_sys_prefs		entry	get_version		entry	getfcr		entry	getkey		entry	getvcr		entry	gotoxy		entry	gprex_alt_ent		entry	grab_mm_seg		entry	grow_list		entry	gs_move_info		entry	gsos_id		entry	handled		entry	icr_id_hand		entry	init_fst_tbl		entry	init_gim		entry	init_int		entry	init_list		entry	init_signal		entry	inline_entry		entry	int_disp_jump		entry	inverse		entry	is_bouncer		entry	is_volume_only		entry	jump_v		entry	kill_element		entry	last_fst		entry	lcbank1_twice		;2-Mar-93 DAL		entry	lc_inline_entry		entry	lc_stack_entry		entry	lc_state		entry	ldxy_idhand		entry	len_to_delim		entry	link_record		entry	list_index		entry	loc_1		entry	loc_2		entry	lock_flag		entry	lock_hand		entry	lockmem		entry	look_at_char		entry	loop45		entry	low_allocate		entry	m_abortmove		entry	m_contdomove		entry	m_movefinished		entry	m_scon_dcon		entry	m_scon_ddec		entry	m_scon_dinc		entry	m_sdec_dcon		entry	m_sdec_ddec		entry	m_sdec_dinc		entry	m_sinc_dcon		entry	m_sinc_ddec		entry	m_sinc_dinc		entry	make_seg		entry	map_vi		entry	map_vp		entry	map_vrn		entry	merge_free		entry	mm_deref		entry	modesave		entry	movetable		entry	mybc		entry	name_search		entry	newline		entry	newvidsv		entry	null_call		entry	null_flag		entry	num		entry	obj_list_tab		entry	obj_type		entry	os_add_queue		entry	os_delete_queue		entry	os_event		entry	os_shutdown		entry	out		entry	out2		entry	out80		entry	page2sv		entry	patch_vector		entry	path_to_fst_id		entry	prefices		entry	prodos_index		entry	char_index		entry	prompt		entry	queue_signal		entry	release_record		entry	release_v_ptrs		entry	releasefcr		entry	releasevcr		entry	rename_record		entry	renamefcr		entry	renamevcr		entry	replace80		entry	res_block		entry	reserve_id		entry	reset_cache		entry	restart_system		entry	restore_screen		entry	restore_vector		entry	return_1		entry	return_2		entry	return_from_fst		entry	return_from_lc		entry	s_full_error		entry	s_get_boot_pfx		entry	s_get_sys_gbuf		entry	s_mount_msg		entry	parse_path		entry	s_report_error		entry	s_report_fatal		entry	s_set_boot_pfx		entry	s_signal		entry	s_sys_death		entry	save_screen		entry	save_x		entry	save_y		entry	script_current		entry	script_start		entry	search_seg		entry	seg_0_end		entry	seg_1_end		entry	seg_2_end		entry	seg_3_end		entry	seg_4_end		entry	seg_tab_hand		entry	select		entry	select_seg		entry	session_status		entry	set_level		entry	set_pfx		entry	set_pfx_32		entry	set_pfx_32_alt		entry	set_prefix		entry	set_ptr		entry	set_sys_prefs		entry	set_tab_ptr		entry	set_type		entry	setupformvx		entry	signal_beat		entry	signal_free		entry	signal_head		entry	signal_table		entry	snuggles		entry	stack_entry		entry	stp2		entry	str_to_int		entry	sub_ptr_1		entry	sub_ptr_2		entry	sub_str_1		entry	sub_str_2		entry	sub_str_3		entry	swapout		entry	switchtab		entry	system_level		entry	temp_error		entry	text_alert		entry	textsv		entry	type_3_alt		entry	ul_hand		entry	ul_mem		entry	unbind_int		entry	unbind_int2		entry	unbind_int_vec		entry	unfree		entry	unlink_record		entry	unlock_hand		entry	unlockmem		entry	user_int_entry		entry	v_ptr1		entry	v_ptr2		entry	vcr_id_hand		entry	vect_disp_base		entry	vect_disp_hand		entry	vrn_to_index		entry	which_one		entry	wreck_icr		entry	xlate_count		entry	xlate_path		entry	xlate_path2		entry	xlate_script				entry	dev_manager		entry	init_path_vars		entry	std_ref_num		entry	get_std_ref_num		entry	get_ref_num		entry	shutdown_reboot		entry	more		entry	volume_parms		entry	device_name		entry	dev_name_length		entry	insert_vol_name		entry	path_script		entry	case_mask2		entry	fork_num			entry	case_sense		entry	displacement		entry	fcr_index		entry	found_count		entry	install_int_vec		entry	remove_int_vec		entry	interrupt_patch		entry	int_patch_1		entry	int_patch_2		entry	int_patch_3		entry	patch_state		entry	get_ref_info		entry	vidtab		entry	seg_tab_copy		entry	do_all		entry	gsos_lc_entry		entry	dispatch_signal		entry	disp_user_int		entry	disp_common_int		entry	do_volume_call		entry	force_lock		entry	force_unlock		entry	ul_mem2		entry	alt_rel_vcr		entry	init_parsepath		entry	grab_fixed_seg		entry	init_spcl_list		entry	play_script		entry	do_alert_window		entry	loader_rename		entry	lock_vector		entry	unlock_vector		entry	seg_tab_last			eject*********************************************************************************   Includes********************************************************************************		include	'common.equ.src'		include	'hw.equ.src'		include	'gsos.macros.src'		include 'driver.equ.src'		print	pop		eject		*********************************************************************************   Equates********************************************************************************;===============================================================================; Data for processor functions;===============================================================================m16		equ	$20			;mode setting value for 16-bit mx16		equ	$10			;mode setting value for 16-bit xmx16		equ	$30			;mode setting value for 16-bit m and xm8		equ	$20			;mode setting value for 8-bit mx8		equ	$10			;mode setting value for 8-bit xmx8		equ	$30			;mode setting value for	8-bit m and xn_flag		equ	$80			;n status flagv_flag		equ	$40			;v status flagm_flag		equ	$20			;m mode flagx_flag		equ	$10			;x mode flagb_flag		equ	$10			;b status flagd_flag		equ	$08			;d mode flagi_flag		equ	$04			;i mode flagz_flag		equ	$02			;z status flagc_flag		equ	$01			;c status flage_flag		equ	$01			;e mode flagnot_c_flag	equ	$FFFE			;complement of c_flagnot_z_flag	equ	$FFFD			;complement of z_flagmx16_or_d_flag	equ	$38			;mask to turn off m, x, and d bits;===============================================================================; Data in the GS/OS global space in bank $E1;===============================================================================active_flag	equ	os_flag			;GS/OS external active flag word						;bit 15=0:  GS/OS inactive						;bit 15=1:  GS/OS active						;bits 14-0:  reservedis_active	equ	$8000			;value for GS/OS active (use ora)is_inactive	equ	$7FFF			;value for GS/OS inactive (use and);shutdown_flag	equ	$E100B8			;flag to indicate gquit vs. shutdown;do_gquit	equ	$0000			;indicate that a gquit is in progress;do_shutdown	equ	$0001			;indicate that shutdown is in progresssys_busy_flag	equ	$e100ff			;System busy flag (0=not busy).;===============================================================================; Data used by the GS/OS shell system call processor.;===============================================================================is_inline	equ	$0006			;value for inline type os callis_stack	equ	$0000			;value for stack type os callis_native	equ	$0000			;value for call from native modeis_emulation	equ	$8000			;value for call from emulation modei_bit_mask	equ	$0400			;mask to recover i bit from stacked Pdefault_prefs	equ	$8000;===============================================================================; GS/OS system direct page equates;===============================================================================perm_work	equ	span2+2			;direct page permanent work areauser_stack	equ	perm_work		;pointer to base of user stack (4 bytes)temp_work	equ	$D4			;direct page temporary work areas_temp1		equ	temp_works_temp2		equ	s_temp1+4s_temp3		equ	s_temp2+4s_temp4		equ	s_temp3+4s_temp5		equ	s_temp4+4;===============================================================================; Aliases for direct page equates;===============================================================================;; Aliases used by SCM entry routines;call_block	equ	s_temp1			;pointer to GS/OS call block;; Aliases used by pathname translation routines.;in_ptr		equ	s_temp1			;pointer to input string data structurein_curr		equ	s_temp2			;pointer to output string data structurein_end		equ	s_temp2+2		;offset of current position in inputout_ptr		equ	s_temp3			;offset	one past end of inputout_curr	equ	s_temp4			;offset of current position in outputout_end		equ	s_temp4+2		;offset	one past end of outputcontrol		equ	s_temp5			;upper case flag and separator charmax_span	equ	s_temp5+2		;maximal span between separators in a						;...pathname;===============================================================================; Miscellaneous constants;===============================================================================sep		equ	$3A			;canonical separator characternul		equ	$00			;ASCII null (string terminator)bit0		equ	$0001			;Value for bit 0.bit1		equ	$0002			;Value for bit 1.bit2		equ	$0004			;Value for bit 2.bit3		equ	$0008			;Value for bit 3.bit4		equ	$0010			;Value for bit 4.bit5		equ	$0020			;Value for bit 5.bit6		equ	$0040			;Value for bit 6.bit7		equ	$0080			;Value for bit 7.bit8		equ	$0100			;Value for bit 8.bit9		equ	$0200			;Value for bit 9.bitA		equ	$0400			;Value for bit A.bitB		equ	$0800			;Value for bit B.bitC		equ	$1000			;Value for bit C.bitD		equ	$2000			;Value for bit D.bitE		equ	$4000			;Value for bit E.bitF		equ	$8000			;Value for bit F.;===============================================================================; Data for tool calls;===============================================================================inc_busy_flag	equ	$E10064			;address of inc_busy_flag calldec_busy_flag	equ	$E10068			;address of dec_busy_flag call;===============================================================================; FST Table Data Structures;===============================================================================max_fsts	equ	16			;maximum number	of FSTs allowed; offsets of fields within an FST Table entryfst_hdr_ptr	equ	0			;pointer to FST headerapp_entry	equ	fst_hdr_ptr+4		;address of FST's application entry ptsys_entry	equ	app_entry+4		;address of FST's system entry pointid		equ	sys_entry+4		;FST id values_flags		equ	id+2			;flags						;bit 15 =0, do not upper case pathnames						; =1, force upper case in pathnames						;bit 14 =0, the FST is a block FST						; =1, the FST is a character FSTentry_size	equ	s_flags+2table_size	equ	max_fsts*entry_sizeinit_fst	equ	$0002			;code to init FST callkill_fst	equ	$0004			;code to shtdwn of FSTkill_vcr	equ	$0006			;code to free FST specific data from VCRflush_def	equ	$0008			;code to flush deferred	blks on a VCR;------------------------------------------;; Equates from procedure session_data;;------------------------------------------session_on	equ	$0001			;value for session in progresssession_off	equ	$0000			;value for no session in progress;------------------------------------------;; Equates from procedure alert_data;;------------------------------------------mount_msg_num1	equ	1			;Error number for mount messagemount_msg_num2	equ	46			;Alternate error # for mount messageright_arrow	equ	$15left_arrow	equ	$08up_arrow	equ	$0Bdown_arrow	equ	$0Areturn_key	equ	$0Dnull0		equ	$00xbias		equ	1ybias		equ	2box_orig_x	equ	0box_orig_y	equ	6box_width	equ	40box_height	equ	13buttons		equ	3button_x	equ	0			;button x position (column)button_y	equ	button_x+1		;button y position (row)button_len	equ	button_y+1		;number	of characters in button labelbutton_resp	equ	button_len+1		;response if button is pressedrecord_len	equ	button_resp+1		;length	of this recordnum_buttons	equ	1			;button number of button being processeddefault_button	equ	num_buttons+2		;button number of default buttonbutton_table	equ	default_button+2	;button	characteristics tabledelim_char	equ	button_table+(buttons*record_len)alert_ptr	equ	delim_char+2		;pointer to the alert stringsubst_ptr	equ	alert_ptr+4		;pointer to the substitution tabletemp		equ	subst_ptr+4		;general temporarysubst_str_ptr	equ	temp+2			;pointer to substitution stringselected_button	equ	subst_str_ptr+4		;the selected buttonch		equ	selected_button+2	;cursor horizontal positioncv		equ	ch+1			;cursor vertical positionaptr		equ	cv+1			;general purpose pointerdp_size		equ	aptr+4-1		;size of direct page word spaces_error		equ	51s_subst_ptr	equ	47dp_save_area	equ	$e0d000			;save area for GS/OS direct page and one;; Equates from procedure save_screen;storage		equ	$E0D000;----------------------------------------------------------------------------;; GIM Equates;;----------------------------------------------------------------------------; Dynalist Constantslist_alc_flag	equ	$8000			;MSB indicates active entry in segtablist_min_size	equ	4			;Minimum size (entries) of a listlist_grow_inc	equ	8			;Inc (entries) in which	list is grownlist_stump	equ	4			;Size of proto-listlist_size	equ	0			;Location of size (bytes) in list memorylist_freehead	equ	2			;Location of free header in list memory; Segment Allocation Constantssegment_size	equ	$2000fwd_ovrhead	equ	10			;Amount of overhead at the front of blkblock_ovrhd	equ	12			;Total # of bytes of overhead each blockmax_blk_size	equ	segment_size-6		;Segment size -free header -dummytagsmin_blk_size	equ	block_ovrhd+4		;4 bytes is smallest usable spacebsize1		equ	$0000flink		equ	$0002			;Used for unallocated blocksblink		equ	$0004			;Used for unallocated blockssucc		equ	$0002			;Used for allocated recordspred		equ	$0006			;Used for allocated recordsseg_tab_stump	equ	$0004			;Table Size + free headerseg_tab_free	equ	$0002			;Free header location in segment tableinit_block	equ	$0004			;Begins	after the free header & Dumtagdtag1_posn	equ	$0002			;First dummy tag positiondtag1_valu	equ	$8000			;MSB set to indicate allocated blockdtag2_posn	equ	segment_size-2		;Second dummy tab positiondtag2_valu	equ	dtag1_valu		;Same as first tagsize1_posn	equ	init_block+bsize1	;First size word (tag = unallocated)size2_posn	equ	dtag2_posn-2		;2nd size word just before dummy tagfwd_posn	equ	init_block+flink	;Forward Link positionback_posn	equ	init_block+blink	;Backward link positionhead_valu	equ	$FFFE			;Kluge to make back patch work okayfree_posn	equ	$0000			;Position in segment of free headernullval		equ	$0000; Object List Constantsnum_obj_lists	equ	2+25			;Number of different types of objectsnumber_prefix	equ	34			;Number of prefixes allowed (incl '*' & '@'); List Offsetsvcr_list	equ	$0000			;Head pointer for VCRsfcr_list	equ	$0004			;Head pointer for FCRsicr_list	equ	$0008			;Head pointers for ICRs** Miscellaneous	Equates*dib_dev_char	equ	$0008			;Offset to device characteristics in dib.block_dev_mask	equ	%0000000010000000	;Block/Character device bit. character_fst	equ	$0009			;ID for character fst.close_call_num	equ	$0014			;Call number for close call.flush_call_num	equ	$0015			;Call number for flush call.d_rename_num	equ	$0036			;d_rename call num.d_calls_start	equ	$002c			;Start of device call #'s.d_calls_end	equ	$0031			;End of device call #'s.d_calls_type	equ	$000a			;Call type for device calls.set_user_level	equ	$8000			;User level OR mask.cflag		equ	$01			;Processor Status maskvflag		equ	$40			;Processor Status maskmm_id_tag	equ	$3100			;Tag for misc tools getID callmm_normal_attr	equ	$0008			;No spcl mem.mm_fixed_attr	equ	$4008			;Fixed, no spcl mem.icr_size	equ	6			;Size of Interrupt Control Record; Error Codesinit_nomem_err	equ	$0000fst_brs_err	equ	$0000al_nomem_err	equ	$0000cs_nomem_err	equ	$0000; GIM Zero Page Permanent Storageseg_tab		equ	$004C			;4size		equ	seg_tab+4		;2; GIM Zero Page Temporariestemporals	equ	$00E8ptr		equ	temporals		;4m_temp		equ	ptr+4			;4seg		equ	m_temp+4		;4vp		equ	seg+4			;4vcr		equ	vp+4			;4hand		equ	vcr+4			;4pb_ptr		equ	hand			;4;; Signal equates;sig_link	equ	0			;offset	of link field to next recordsig_priority	equ	2			;offset of priority fieldsig_hand_addr	equ	4			;offset of signal handler address fieldsig_rec_size	equ	8			;number of bytes in signal recordsig_null_ptr	equ	$8000			;null pointer for signal queuenum_signals	equ	8			;maximum number of signals in queuedisp_free	equ	$0000			;values for dispatch_busydisp_busy	equ	$8000;------------------------------------------;; Equates from procedure interrupt_data;;------------------------------------------i_temp		equ	$F8			;temporary direct page offsetuser_int_vector	equ	$0003FE			;address of user interrupt vectoro_table_length	equ	list_size		;offset	of table length fieldo_free_list	equ	list_freehead		;offset	of free entry list headero_first_entry	equ	4			;offset of first table entryo_int_hand_addr	equ	0			;offset of interrupt handler addresso_vrn		equ	4			;offset of interrupt vector index (VI)num_vects	equ	25vect_disp_len	equ	num_vects*4;------------------------------------------;; Equates from procedure m_move_equ;;------------------------------------------source		equ	$16			; 4-byte source addressdest		equ	$12			; 4-byte destination addresscount		equ	$0e			; 4-byte transfer countmovecommand	equ	$0c			; 2-byte command wordreturnmove	equ	$09			; 3-byte return addresstempcount	equ	$07			; 2-byte temporary transfer countdomove		equ	$03			; 4-byte mvn 0000 / rtl instructionsstackused	equ	$14			; number of bytes on stack used** Segment equates...*header_length	equ	$30seg_0_start	equ	$009a00			;Segment start address.seg_0_max	equ	$00a280			;Segment end address+1.seg_1_start	equ	$00b300			;Segment start address.seg_1_max	equ	globals_end		;Segment end address+1.seg_2_start	equ	$00d000			;Segment start address.seg_2_max	equ	$010000			;Segment end address+1.seg_3_start	equ	$01fc00			;Segment start address.seg_3_max	equ	$01fd00			;Segment end address+1.seg_4_start	equ	$e1d980			;Segment start address.seg_4_max	equ	$e1e000			;Segment end address+1.		gbla	&segment_pc		;Allocate a global counter.			eject********************************************************************************* Begin oscall segment: $009A00-00A280*		SEG	'oscall_seg'		;Becomes scm_seg_0.		resetpc				;Reset pc.********************************************************************************		eject;===============================================================================; GS/OS SYSTEM CALL MANAGER;===============================================================================; This module performs all general processing of GS/OS system calls from the; point at which they are issued by an application to the point at which they; are passed to other parts of the system, including other parts of the System; Call Manager for further processing.;===============================================================================		eject;===============================================================================; Main entry points for GS/OS system calls from application programs;===============================================================================;; Created:	4/1/87; Modified:	1/25/88  Moved IncBusyFlag call to just before DecBusyFlag; Author:	JJ;; Entry points:;   inline_entry  inline GS/OS call vectored from $E100A8;   stack_entry   stack-based GS/OS call vectored from $E100B0; Enter:;   The caller must have made either an inline GS/OS call or a stack GS/OS call;   An inline call has the following format:;     jsl $E100A8;     dc  i2'call_num';     dc  i4'parm_block';   A stack call has the following format:;     push parm_block onto stack (4 bytes);     push call_num onto stack (2 bytes);     jsl $E100B0; Input:;   There are no requirements on register contents or processor mode.; Output:;   A	 0=call successful, non-zero error code for unsuccessful call;   X	 unchanged;   Y	 unchanged;   D	 unchanged;   S	 call parameters (if any) and return address pulled off stack;   P	 see below;   DB	 unchanged;   PB	 unchanged;   PC	 address of location following GS/OS call block;   n	 undefined;   v	 undefined;   m	 unchanged if e=0 at time of call; otherwise, undefined;   x	 unchanged if e=0 at time of call; otherwise, undefined;   b	 undefined;   d	 unchanged;   i	 unchanged;   z	 0=call unsuccessful, 1=call successful;   c	 0=call successful, 1=call unsuccessful;   e	 unchanged;===============================================================================		eject;===============================================================================; Beginning of the GS/OS shell system call processor.  This module must be; loaded below the language card since it must always be accessible.  Within; this code segment, we use long absolute addressing to	refer to certain data; rather than setting up the DBR and using short absolute.  This is done; deliberately because, at this point, we would have to save DBR on the user's; stack before setting it.  Our goal is to minimize the amount of user stack; space we use, so we will wait to save DBR and use faster addressing modes; until we establish the GS/OS stack a bit later on.;===============================================================================oscall_module	proc				;GS/OS system call handling		entry	stack_entry		entry	inline_entry		entry	gbuf		entry	return_from_lc		longa	on		longi	ongbuf		DS.B	$400			;global buffer for FST useinline_entry					;entry point for inline type call		php				;save P	on user stack		sei				;disable interrupts temporarily		clc				;force cpu into native mode...		xce				;... and save old mode in c		php				;save old value of e placed in c by xce		rep	#mx16_or_d_flag		;force 16-bit m and x and binary mode		lda	>active_flag		;is GS/OS active?		bmi	inl_actv_exit		;yes, exit immediately		lda	#is_inline		;flag indicating inline type call		bra	common_entry		;go on to common processingstack_entry					;entry point for stack type call		php				;save P	on user stack		sei				;disable interrupts temporarily		clc				;force cpu into native mode...		xce				;... and save old mode in c		php				;save old value of e placed in c by xce		rep	#mx16_or_d_flag		;force 16-bit m and x and binary mode		lda	>active_flag		;is GS/OS active?		bmi	stk_actv_exit		;yes, exit immediately		lda	#is_stack		;flag indicating stack type callcommon_entry	sta	>entry_type		;remember whether inline or stack call		ror	a			;get caller's processor mode saved ...		and	#$8000			;... in	c by xce above, and remember ...		sta	>entry_mode		;... it in entry_mode		txa				;save x	and y registers	at this point		sta	>save_x			;... because inc_busy_flag is entitled		tya				;... to	change them since it is almost		sta	>save_y			;... a tool call	if 0 then		jsl	inc_busy_flag		;increment the system busy flag	endif		lda	>active_flag		;set active flag		ora	#is_active		sta	>active_flag		lda	1,s			;restore state of caller's i bit ...		and	#i_bit_mask		;... from first	copy of P on stack		bne	d_1			;interrupts were disabled, do nothing		cli				;otherwise, reenable interruptsd_1		sep	#mx8			;set up	8-bit m and x temporarily		longa	off		longi	off;		lda	>statereg		;save current language card state;		sta	>lc_state;		lda	>lcbank1		;select and write enable language ...;		lda	>lcbank1		;... card RAM bank 1 (really 0);;		lda	#$00			;zero out power up byte;		sta	>$0003f4*** added 2-Mar-93 DAL -- stuff a $4C at $00/BF00 so the Vulcan thinks we are in P8 (ick)		phb		pea	$0000		plb		plb				;set B to 0 for a sec		lda	|statereg		sta	|lc_state		;save current language card state		jsr	lcbank1_twice		stz	$03F4			;zero out the power-up byte		lda	#$4C		sta	$BF00		plb*** end 2-Mar-93		rep	#mx16			;go back to 16-bit m and x		longa	on		longi	on		jmp	gsos_lc_entry		;continue processing in language card						;return	at label return_from_lc below;===============================================================================; GS/OS was active before the call, so exit with the gsos_active error since the; system is not	reentrant.  For inline type call, no stack adjustment is; necessary; for stack type call, squeeze 6 bytes out of the stack before; continuing with normal exit.;===============================================================================inl_actv_exit					;exit from inline call when GS/OS active		clc				;update	return address to point past ...		lda	3,s			;... call_num and parm_block pointer		adc	#$0006			;since code can't cross bank boundary,		sta	3,s			;we only need to increment low word		bra	actv_exitstk_actv_exit					;exit from stack call when GS/OS active		jsr	stack_squeeze		;squeeze call_num and parm_block pointeractv_exit	lda	#gsos_active		;error code for GS/OS already active		plp				;restore caller's processor mode		xce		plp				;restore caller's processor status		rep	#z_flag			;clear z flag to indicate error		sec				;set c flag to indicate error		rtl				;return to caller;===============================================================================; Return from portion of shell that executes in language card;===============================================================================return_from_lc					;must finish up processing outside ...						;... language card because we have ...						;... to	restore user's memory state		Import	io_flag		sei				;temporarily disable interrupts while						;manipulating active flag, etc.		lda	>active_flag		;clear the GS/OS active flag*** optimized 2-Mar-93 DAL (saved 1 byte);;;		and	#is_inactive		;note: can't get here if GS/OS was ...		asl	a		lsr	a*** end 2-Mar-93		sta	>active_flag		;... active		lda	>entry_type		;determine whether inline or stack type		beq	stack_exit		;branch if stack type call		clc				;inline call-adjust return address by 6		adc	3,s			;note: entry_type = 6 in this case		sta	3,s		bra	common_exitstack_exit	jsr	stack_squeeze		;squeeze out call_num and parm_blockcommon_exit	lda	>save_x			;restore x register		tax		lda	>save_y			;restore y register		tay		lda	>temp_error		;save global error code on stack since*** added 2-Mar-93 DAL for convenience of debugging		beq	@skip		sta	>$FC4242		;trigger logic analyzer@skip*** end 2-Mar-93		pha				;... it could be changed by a GS/OS						;... call initiated by dec_busy_flag		sep	#m8			;go to 8-bit m temporarily		lda	>lc_state		;save caller's LC state on stack		pha		rep	#m16			;return to 16-bit m;; Restore interrupt state to user's interrupt state before calling; dec_busy_flag.  This minimizes the amount of time interrupts are explicitly; disabled by GS/OS.;		lda	4,s			;get the two values of P from stack		and	#i_bit_mask		;isolate state of user's i bit		bne	d_2			;interrupts were disabled, do nothing		cli				;otherwise, enable interruptsd_2		lda	>io_flag		;should we call dec_busy?		bmi	@dont_call		;no...		jsl	dec_busy_flag		;decrement system busy flag and ...						;potentially launch pending tasks.						;note: dec_busy_flag and all tasks ...						;... it launches are required to ...						;... save and restore all registers@dont_call;; Call the signal dispatcher.  Set c = state of i bit when application; called GS/OS.;		lda	>io_flag		;should we call the signal dispatcher?		bit	#$4000		bne	@no_signals		;no...		lda	5,s			;get application's P register		lsr	a			;shift i bit into c		lsr	a		lsr	a		jsr	dispatch_signal		;do it (see if we get lucky)@no_signals		sep	#m8			;back to 8-bit m to get caller's		pla				;...LC state and restore it		sta	>statereg		rep	#m16		pla				;restore the error code to the a reg		plp				;restore caller's processor mode		xce		plp				;restore caller's P register (c and ...						;... z modified	to reflect call status)		rtl				;return to caller;==============================================================================; stack_squeeze:  used when returning from a stack type GS/OS call to squeeze;		  the 4-byte param_blk_ptr and 2-byte call_number our of the;		  stack;; Enter:	jsr	stack_squeeze;; Input:	nvmxdizc;		..000...;; Output:	A = trashed;===============================================================================stack_squeeze	lda	6,s			;copy 7 bytes to a location 6 bytes ...		sta	12,s			;... higher in the stack		lda	4,s		sta	10,s		lda	2,s		sta	8,s		pla				;tricky:  byte 2 is moved twice		sta	5,s		pla				;remove extra 4 bytes from stack		pla		rts		end_proc		eject;===============================================================================;===============================================================================; below_lc_int;; Interrupt system code that must exist in bank $00 below the langauge card (for; various reasons).;===============================================================================;===============================================================================;===============================================================================; user_int_entry;; Whenever the firmware interrupt handler fails to resolve an interrupt by; polling all of the standard interrupt vectors, it finally vectors control; through the user interrupt vector at $00/03FE, which GS/OS has patched to; point to this routine.  This routine sets up the proper processing; environment and hands control to the language card portion of the interrupt; manager.;; On entry to this routine,;		D = $0000;		DBR = $00;		e = emulation mode;		i = disabled;		speed = 1 MHz;===============================================================================user_int_entry	proc		phb				;save DBR		phd				;save D		lda	|statereg		;save the value of the state register		pha				;...on the stack		jsr	lcbank1_twice		jsr	|disp_user_int		;go to dispatch user interrupt		pla				;restore state register value		sta	|statereg		pld				;restore D		plb				;restore DBR		rti				;return to interrupt firmware		end_proc*** added 2-Mar-93 DAL;===============================================================================; lcbank1_twice -- enable LC bank 1 for read/write;; Do  lda |lcbank1  twice (save some bytes).;===============================================================================lcbank1_twice	proc		lda	|lcbank1		lda	|lcbank1		rts		endp*** end 2-Mar-93 DAL		eject;===============================================================================; disp_stub_1;; Below language card code needed to hand control to a P16 interrupt handler and; return from the interrupt handler.;===============================================================================disp_stub_1	proc		entry	int_disp_jumpint_disp_jump		jsr	>$000000		;JSL to	the interrupt handler. Address						;...is modified by interrupt dispatcher		sep	#mx8			;go to 8-bit mode to access soft switch		jsr	lcbank1_twice		rep	#mx16			;return	to 16-bit m and x		jmp	return_1		;return to language card portion of code		end_proc		eject;===============================================================================; common_disp_entry;; When a firmware interrupt vector has been patched by a class 1 alloc_interrupt; call, the interrupt system is set up to hand control to a location in the; Vector Dispatch Table (somewhere in memory), which then routes control to this; routine.  This routine sets up the proper processing environment and hands; control to the language card portion of the interrupt manager.;; On entry to this routine:;		D = $0000 for other than irq.aptalk or irq.serial;		D = undefined for irq.aptalk or irq.serial;		DBR = $00 for other than irq.aptalk or irq.serial;		DBR = undefined for irq.aptalk or irq.serial;		e = native;		m = 8-bit;		x = 8-bit;		i = disabled;		speed = high;===============================================================================common_int_ent	proc		phb				;save DBR		phd				;save D		phk				;set DBR=PBR=$00		plb		lda	|statereg		;save value of statereg		pha		jsr	lcbank1_twice		jsr	disp_common_int		;go to lc code to dispatch interrupt		pla				;recover state register value		sta	|statereg		pld				;restore D		plb				;restore DBR		rtl				;return to interrupt firmware		end_proc		eject;===============================================================================; disp_stub_2;; Below language card code needed to hand control to a GS/OS interrupt handler; and return from the interrupt handler.;===============================================================================disp_stub_2	proc		entry	common_disp_jmpcommon_disp_jmp		jsr	>$000000		;JSL to	the interrupt handler. Address						;...is modified by interrupt dispatcher		sep	#mx8			;go to 8-bit mode to access soft switch		jsr	lcbank1_twice		rep	#mx16			;return	to 16-bit m and x		jmp	return_2		;return to language card portion of code		end_proc		eject;===============================================================================; Signal Data;; NOTE: The equates in this record are commented out and are here for ;	documentation purposes only.  The actual definitions are at the start;	of this file.;===============================================================================signal_data	proc		entry	signal_head		entry	signal_free		entry	signal_table		entry	dispatch_busy		entry	interrupt_state;; Offsets of fields in the signal records.;;sig_link	equ	0		;offset of link field to next record;sig_priority	equ	2		;offset of priority field;sig_hand_addr	equ	4		;offset of signal handler address field;sig_rec_size	equ	8		;number of bytes in signal record;; Signal queue data structures.;signal_head	dc.w	0000			;signal queue headersignal_free	dc.w	0000			;free list header for signal records;sig_null_ptr	equ	$8000		;null pointer for signal queue;num_signals	equ	8		;maximum number of signals in queuesignal_table	ds.b	sig_rec_size*num_signals;; State variables for signal dispatching.;dispatch_busy	dc.w	0000		;tells if dispatch_signal has been					;called but not yet returned;disp_free	equ	$0000		;values for dispatch_busy;disp_busy	equ	$8000interrupt_state	dc.w	0000		;flag used by dispatch_signal to keep					;...track of interrupt state on entry					;= $0000, interrupts enabled					;= $8000, interrupts disabled.		end_proc		eject;==============================================================================; Heartbeat task for dispatching signals.;==============================================================================signal_beat	procbeat_count	equ	60			;launch every 60 heartbeats		DC.L	$00000000		;space for linknum_beats	DC.W	beat_count		;heartbeat count betweeen launches		DC.W	$a55a			;signature		phk		plb		lda	|statereg		pha		jsr	lcbank1_twice		rep	#mx16			;enter 16-bit m and x mode		lda	|signal_head		;Anything in the signal queue?		bmi	done			;Nope, so do nothing.		lda	>sys_busy_flag		;Yes, is system busy?		bne	done			;Yes, so do nothing.		jsr	install_int_vec		;Nope, so install our patch.		done		lda	#beat_count		;restore the beat count		sta	>num_beats		sep	#mx16			;back to 8-bit m and x mode		pla		sta	|statereg		rtl		end_proc		eject*********************************************************************************        Name:	interrupt_patch** Description:	Handles dispatching signals with interrupts ENABLED.  This code*		CANNOT reside in the LC area since the LC ROM may be switched*		in at interrupt time.**      Author:	Bryan Atsatt*     Created:	Feb 22, 1989*    Modified:	**       Entry:	irq ONLY!  Don't call this code.**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**		int_patch_1			;JMP original vector.*		int_patch_2			;JMP original vector.*		int_patch_3			;JMP original vector.**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..?**        Exit:	rti**        Uses:	Lots of stuff** Copyright Apple Computer, Inc. 1989  All rights reserved.*******************************************************************************interrupt_patch	procbank_0_rti	equ	$0000c072		;Address of an RTI instruction						;in bank zero.  If this ever						;moves we're in trouble but						;Fern assures me it never will!		entry	int_patch_1		entry	int_patch_2		entry	int_patch_3** This code will be called from the main interrupt vector.  Is this an IRQ?* Exit to original vector if not...*		bvs	int_patch_1		;No, so jump to original vec.** Yes.  Set native mode then check to see if we came in in emulation mode.  If* we did, skip ahead to is_emulation...*		clc				;Set native mode.		xce		php				;Save mode.  Is emulation?		bcs	is_emul_mode		;Yes, so skip ahead.** We're in native mode so simulate an IRQ so that RTI will return at our* return address after interrupt is handled, then jump off to the original* vector...*		phk				;Put our bank on stack.		pea	our_return		;Put our return adr on stack.		php				;Put our status on stack.int_patch_1	jmp	>00000000		;Jump to original vector.** We're in emulation mode.  Go to 8 bit m and test to see if this is really* a break instruction.  If so, branch down to is_break...*is_emul_mode	sep	#m8			;Go to 8 bit m.		longa	off				pha				;Save A.		lda	03,s			;Get original status.		and	#b_flag			;Is break instruction?		bne	is_break		;Yes, so skip ahead.** Not a break so simulate an IRQ so that RTI will return at our return* address after interrupt is handled, then jump off to the original* vector...* 		pla				;Pop off saved A.		plp				;Restore status.		php				;Put it back on stack.		phk				;Put our bank on stack.		pea	our_return		;Put our return adr on stack.		php				;Put our status on stack.int_patch_2	jmp	>00000000		;Jump to original vector.** It's an emulation mode break instruction so just restore the state and* jump off to original vector...*is_break	pla				;Pop off saved A.		plp				;Recover status.		xce				;Restore emulation mode.int_patch_3	jmp	>00000000		;Jump to original vector.** When the interrupt handler does an RTI, we will get control back here.  Save* the state of the system and set it up for our purposes...*our_return	rep	#mx16			;Set 16 bit m and x.		longa	on		longi	on				pha				;Save A.		phx				;Save X.		phy				;Save Y.		phb				;Save B.		phk				;Set data bank = program bank.		plb		cld				;Make sure we're not in dec.		sep	#m8			;Go to 8 bit m. 		lda	|statereg		;Save statereg so can restore.		pha		jsr	lcbank1_twice		rep	#m8			;Back to 16 bit m.** At this point, interrupts are GUARANTEED to be enabled since the only way* to get here is from an IRQ and the RTI will restore the state.  Now we get* to the point of all this work, which is to dispatch signals with interrupts* enabled if there are any to dispatch AND the system is not busy.** First we will remove this patch (interrupt_patch) from the main vector so we* won't go thru this again until another signal gets queued up.  Should we do* the dispatch?*		jsr	remove_int_vec		;Remove our patch.		lda	|signal_head		;Anything in the queue?		bmi	main_exit		;Nope, so exit.		lda	>sys_busy_flag		;Yes, is the system busy?		bne	main_exit		;Yes, so exit.** Yes, so go do it...*		clc				;Indicate interrupts enabled.		jsr	dispatch_signal		;Go dispatch all signals.** Alright, we're all done.  Restore the state of the system and RTI if we came* in in native mode, else skip ahead to emulation_exit...*main_exit	sep	#m8			;Go to 8 bit m. 		pla				;Restore state of LC.		sta	|statereg		rep	#m8			;Back to 16 bit m.		plb				;Restore B.		ply				;Restore Y.		plx				;Restore X.		pla				;Restore A.		plp				;Restore original status.  Did						; we come in from emulation?		bcs	emulation_exit		;Yes, so skip ahead.		rti				;No, so exit.** We came in in emulation mode so we need to go back to that mode and then jump* off to an RTI instruction that lives in bank zero...*emulation_exit	xce				;Go back to emulation mode.		jmp	>bank_0_rti		;Go to bank zero RTI.		end_proc		eject;===============================================================================; Data used by the GS/OS shell system call processor.  This module must be in; the same bank as the GS/OS System Call Manager.;; NOTE: The equates in this record are commented out and are here for ;	documentation purposes only.  The actual definitions are at the start;	of this file.;===============================================================================oscall_data	proc	export		entry	entry_type		entry	entry_mode		entry	lc_state		entry	save_x		entry	save_y		entry	temp_error		entry	seg_tab_copy		entry_type	dc.w	0000		;records inline vs. stack type call					;  =is_inline inline type call					;  =is_stack stack type call;is_inline	equ	$0006		;value for inline type os call;is_stack	equ	$0000		;value for stack type os callentry_mode	dc.w	0000		;records whether cpu was in native or					; emulation mode before GS/OS call					;  =is_native native mode					;  =is_emulation emulation mode;is_native	equ	$0000		;value for call from native mode;is_emulation	equ	$8000		;value for call from emulation modelc_state	dc.b	00		;saved language card statesave_x		dc.w	0000		;saved value of x registersave_y		dc.w	0000		;saved value of y register;i_bit_mask	equ	$0400		;mask to recover i bit from stacked Ptemp_error	dc.w	0000		;temporary storage for system error code** The following long is a copy of seg_tab which is maintained for deref_int...*seg_tab_copy	dc.l	00000000		;Copy of seg_tab.		end_proc		eject;===============================================================================; xlate_script;; Translate pathnames according to the script for the current call.;; Created:	1/27/88; Modified:	1/12/89; Author:	JJ;; Enter:	jsr	xlate_script;; Input:	script_start		offset of beginning of script;		fst_flags		pathname translation control flags;		P = nvmxdizc;		    ..000...;; Output:	performs pathname translation as directed by the script and;		fst_flags;;		A = if c=0, undefined; if c=1, error code;		X = trashed;		Y = trashed;		P = nvmxdizc;		    ..000..|;			   0=no error, 1=error;===============================================================================xlate_script	proc** Initialize pathname variables...*		jsr	init_path_vars		;Initialize pathname variables.;; Execute the pathname translation operators in the script.;		lda	|script_start		;reinitialize script address to start		sta	|script_currentdo_script	jsr	play_script		;get script information in A and X		beq	end_of_script		;zero indicates end of script		tay				;save script byte in Y		and	#$00F0			;isolate 'opcode' of the script		cmp	#$0030			;is it pathname pointer?		bne	do_script		;no, try next script codeis_pathptr	tya				;recover script code		and	#$000F			;isolate offset to pathname to translate		jsr	xlate_path		;translate the pathname		inc	|xlate_count		;increment pathname translation count		bcc	do_script		;continue with script if no error		rts				;return if there is an errorend_of_script					; ;return without error		clc		rts		end_proc		eject;===============================================================================;; move_info revision history;; the general move routine (m_sinc_dinc) algorithm in this program is based;    on the one used by the memory manager.  it has been updated for gs/os;    purposes and in hopes that new hardware will take over this functionality];    in the future.;; memory manager move routine is by rich williams in original iigs rom.;    later modified for prodos16 by jim jatczynski.;; 1/04/88  fab	1st release as move_info routine by fern bachman jr.; 1/18/88  fab	m_sdec_dcon / m_scon_ddec needed cpy #$ffff in loop to test for;			falling through an address into the next lower bank.;		m_sinc_ddec / m_sdec_dinc fixed counter calculation in to;			include count+1 when doing 8 bit increment.;		m_scon_dinc changed inc <dest to inc <dest+2 for correct dest;			bank increment;		performance statistics table added;;===============================================================================;===============================================================================;; performance statistics table;;  #   subroutine	time/byte    time/$10000 bytes;-------------------------------------------------------;  0   m_scon_dcon	 7.36 usec	 485.8 msec;  1   m_sinc_dcon	 9.30 usec	 615.6 msec;  2   m_sdec_dcon	10.48 usec	 691.9 msec;  4   m_scon_dinc	 9.30 usec	 615.6 msec;  5   m_sinc_dinc	 2.78 usec	 180.7 msec;  6   m_sdec_dinc	18.20 usec	1209.0 msec;  8   m_scon_ddec	10.48 usec	 691.9 msec;  9   m_sinc_ddec	18.20 usec	1209.0 msec;  a   m_sdec_ddec	2.78 usec	 180.8 msec;;===============================================================================		eject;===============================================================================; move_info;; Moves	a block of data from a source location to a destination location.;; Calling sequence:;   1. Place machine in full native mode (e=0, m=0, x=0);;   2. Push high order word of source pointer onto stack;   3. Push low order word of source pointer;   4. Push high order word of destination pointer;   5. Push low order word of destination pointer;   6. Push high order word of transfer count;   7. Push low order word of transfer count;;   8. Push command byte;	_______________________________________________;      |  |  |	|  |  |	 |  |  |  |  |	|  |  |	 |  |  |;      |15|14|13|12|11|10|09|08|07|06|05|04|03|02|01|00|;      |__|__|__|__|__|__|__|__|__|__|__|__|__|__|__|__|;;	bits 15/14	= reserved;	bits 13/12/11	= move mode;			= 000		=reserved;			= 001		=block move;			= 010-111	=reserved;	bits 10/9/8/7	= reserved;	bits 6/5/4	= reserved;	bits 3/2	= destination incrementer;			= 00 (+0)	=constant destination;			= 01 (+1)	=increment destination by 1;			= 10 (-1)	=decrement destination by 1;			= 11		=reserved;	bits 1/0	= source incrementer;			= 00 (+0)	=constant source;			= 01 (+1)	=increment source by 1;			= 10 (-1)	=decrement source by 1;			= 11		=reserved;;   9. jsl move_info;		eject;		  Stack	on entry;      _______________________________________;     |					      |;     |-     high word of source pointer     -|;     |_______________________________________|	  s+$10;     |					      |;     |-     low word of source	pointer	     -|;     |_______________________________________|	  s+$0e;     |					      |;     |-  high word of destination pointer   -|;     |_______________________________________|	  s+$0c;     |					      |;     |-  low word of destination pointer    -|;     |_______________________________________|	  s+$0a;     |					      |;     |-     high word of transfer count     -|;     |_______________________________________|	  s+$08;     |					      |;     |-     low word of transfer count	     -|;     |_______________________________________|	  s+$06;     |					      |;     |-	    command word	     -|;     |_______________________________________|	  s+$04;     |					      |;     |-				     -|;     |		    return address	      |;     |-				     -|;     |_______________________________________|	  s+$01;;; Outputs:	if no error then;		a= $0000;		c= 0;		if error then;		a= error code;		c= 1;		data bank and direct register are preserved;		a= error code;		x,y = scrambled;; Notes:	The high byte of source, dest, and Count must be zero;		The source and destination blocks must not overlap;		This routine executes self modifying code on the stack;			and therefore is romable and reentrant;===============================================================================m_move_equ	proc; zero page locations used on stack		end_proc	gs_move_info	proc		entry	m_movefinished		entry	m_abortmove		longa	on		longi	on		pha				; push two bytes on stack for tempcount		pea	$6b00			;push an rtl instruction onto stack; note the a place holder of $00 was left on the stack when the rtl instrucion;  was placed on the stack.  that byte will become the high byte of the operand;  for the mvn instruction about to be pushed onto the stack; now put an mvn xxxx instruction on the stack (operand is modified later)		pea	$0054			;mvn and low byte of mvn operand		phd				; save user's direct page pointer 'd'		tsc				; make direct page correspond to stack		tcd; zero page is now on stack here; zero page after pha, phd, push of 'mvn xxxx, rtl' tsc and tcd;      _______________________________________;     |					      |;     |-     high word of source pointer     -|;     |_______________________________________|	  $18;     |					      |;     |-     low word of source	pointer	     -|;     |_______________________________________|	  $16;     |					      |;     |-  high word of destination pointer   -|;     |_______________________________________|	  $14;     |					      |;     |-  low word of destination pointer    -|;     |_______________________________________|	  $12;     |					      |;     |-     high word of transfer count     -|;     |_______________________________________|	  $10;     |					      |;     |-     low word of transfer count	     -|;     |_______________________________________|	  $0e;     |					      |;     |-	    command word	     -|;     |_______________________________________|	  $0c;     |					      |;     |-				     -|;     |		    return address	      |;     |-				     -|;     |_______________________________________|	  $09;     |					      |;     |-	   temp	count word	     -|;     |_______________________________________|	  $07;     |		      rtl		      |;     |_______________________________________|	  $06;     |					      |;     |-				     -|;     |	 domove	   mvn 0000   ;(modified code)|;     |-				     -|;     |_______________________________________|	  $03;     |					      |;     |-	  user's direct page         -|;     |_______________________________________|	  $01; stack	moves down when phb info, rtl's info, and rts are placed on stack;      _______________________________________;     |	       user's data bank register      |;     |_______________________________________|;     |	   rts back from jsr domvxonstack     |;     |-				     -|;     |_______________________________________|;     |					      |;     |-				     -|;     |	rtl which points to continuation addr |;     |-				     -|;     |_______________________________________|;     |					      |;     |-				     -|;     |	      rtl which	points to domove      |;     |-				     -|;     |_______________________________________|;		phb				; save dbr on stack (mvn trashes it)		lda	<source+2		;is high byte of dest/src/count = 0 ??		ora	<dest+2		ora	<count+2		and	#$ff00		bne	m_abortmove		;not = then a high byte <>=0 was found; if the number of bytes to move equals zero we are done before we started		lda	<count		ora	<count+2		beq	m_movefinished		;finished before we started (ha! ha!); to speed up the most common move routine we will check for it now and;    not let it go through the normal move dispatcher		lda	<movecommand		;test if valid or not		cmp	#move_sinc_dinc		;test for most common mode first		beq	m_sinc_dinc		;= then do it quickly; to speed up the second most common move routine we will check for it now and;    not let it go through the normal move dispatcher		cmp	#move_sdec_ddec		;test for the 2nd most common mode first		bne	move_info4		jmp	m_sdec_ddec		;= then do it quickly; the next 'bit' instruction uses a mask to test for invalid commands and;   invalid options.  this mask (found in equates/common.equ) must change as;   other commands become valid.move_info4		bit	#movevaliditymask	;reserved bits set?		bne	m_abortmove		bit	#moveblkcmd		;if moveblkcmd bit isn't set then error		beq	m_abortmove; if we	fall to here then figure out which move to do		and	#$000f			;upper 3 nibbles are not important		asl	a			;set up 'x' to get to rest of moves		tax; most of the move routines need this function so all routines will incur the;   overhead.  this is better and shorter than making it a callable subroutine.; make count into 2's complement so we can increment to $00000000 instead of;   decrementing to $00000000 since it is faster to increment than decrement;   32 bits worth of data (no compares needed).		lda	<count			;low word of count		eor	#$ffff		tay				;save for later		lda	<count+2		;high word of count		eor	#$ffff			;'a'=high word and 'y'=low word now		iny				;make 2's complement now		bne	move_info8		inc	amove_info8		sty	<count			;leave on zero page		sta	<count+2		;leave on zero page; warning - code that gets jumped to from here assumes count is in 'y'		jmp	(movetable,x)		;off to routine; common exit routine is here. all errors and move routines finish up here.m_movefinished					;	 ;no bytes left to move		clc				;indicate no error encountered		bcc	no_m_abortmovem_abortmove		sec				;indicate an error was encounteredno_m_abortmove		rep	#$30			;must exit in full native mode		plb				; restore dbr		lda	<returnmove		; move return address past parameters		sta	<source+1		lda	<returnmove+1		; move return address past parameters		sta	<source+2		pld				; restore user's direct register		tsc				; set s to proper value		php				;save 'c' around addition		clc		adc	#stackused		;number of bytes used on stack		plp				;restore correct exit 'c'		tcs				;fix up stack; set 'a' correctly for exit based on 'c'		lda	#$0000			;assume no errors		bcc	cleanexit		lda	#parm_range_err		;it's an error if herecleanexit		rtl		end_proc		m_sinc_dinc	proc				;5 source incs - destination incs; move with incrementing source address and incrementing destination address; get ready to do the standard move		jsr	setupformvx		;set up for mvn/mvp		bra	m_mdfirst; main move loopm_mdmore		sta	<count+2		; more bytes to move		lda	<domove+1		; a = srcdst banks		cpx	#$0001			; bank cross? if x=0		bcs	m_mdxnot0		adc	#$0100			; add 1 to source bankm_mdxnot0		cpy	#$0000			; did destination cross bank?		bne	m_mdyis0		inc	am_mdyis0		sta	<domove+1m_mdfirst		txa				; if count > -x then bank cross		eor	#$ffff		cmp	<tempcount		bcs	m_mdxok		sta	<tempcount		; only move -x bytesm_mdxok		tya				; will destination cross bank?		eor	#$ffff		cmp	<tempcount		bcs	m_mdyok		sta	<tempcount		; only move -y bytesm_mdyok		jsr	domvxonstack		bpl	m_mdmore		jmp	m_movefinished		end_proc		m_scon_dcon	proc				;0 source constant -destination constant;move with the source = constant address and the dest = constant address; 'y' contains count on entry		ldx	<count+2		;high byte of count in 'x'; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since m_movefinished does;    it for us.		sep	#$20			;make 'a' register 8 bitsm_scon_dconlp		lda	[<source]		;indirectly get source information		sta	[<dest]			; and write it to the dest location; decrement counter by incrementing it to $00000000		iny				;increment move	counter here		bne	m_scon_dconlp		;loop if didn't drop to zero yet		inx				;increment high	byte of move counter		bne	m_scon_dconlp		;loop if done		jmp	m_movefinished		end_proc		m_sinc_dcon	proc				;1 source incs - destination constant;move with the source = incrementing address and the dest = constant address; 'y' contains count on entry		tyx				;low word of count is in 'y' on entry		ldy	#$0000			;start at first source byte; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since m_movefinished does;    it for us.		sep	#$20			;must use 8 bit 'a' registerm_sinc_dconlp		lda	[<source],y		;get value to write		sta	[<dest]			; and write it to constant location; set up for new source address		iny				;go to next source location		bne	m_sinc_dconlp2		;loop if not = 0 yet; the next inc is an eight bit increment but that is ok since the high;    byte of the high word is always zero to start anyway		inc	<source+2		;increment bank number; decrement counter by incrementing it to $00000000m_sinc_dconlp2		inx				;increment to 0		bne	m_sinc_dconlp		;loop if not done		inc	<count+2		;increment low byte of count word		bne	m_sinc_dconlp		;not = 0 then just continue		inc	<count+3		;increment upper byte of word too		bne	m_sinc_dconlp		;loop if not done		jmp	m_movefinished		;all done so exit		end_proc		m_sdec_dcon	proc				;2 source decs - destination constant;move with the source = decrementing address and the dest = constant address; 'y' contains count on entry		tyx				;low word of count		ldy	<source			;start at first source address		stz	<source			;reset source pointer; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since m_movefinished does;    it for us.		sep	#$20			;must use 8 bit 'a' registerm_sdec_dconlp		lda	[<source],y		;get next data byte to move		sta	[<dest]			;store at constant destination		dey				;decrement to next source location		cpy	#$ffff			;dec through 0 then adjust source bank		bne	m_sdec_dconlp2		;<>= then do some more; the next dec is an eight bit decrement but that is ok since the caller;   should never be decrementing in bank $00 and expect to go into bank $ff.		dec	<source+2		;decrement source bank; decrement counter by incrementing it to $00000000m_sdec_dconlp2		inx				;adjust counter		bne	m_sdec_dconlp		;<>= then do some more		inc	<count+2		;increment low byte of count word		bne	m_sdec_dconlp		;not = 0 then just continue		inc	<count+3		;increment upper byte of word too		bne	m_sdec_dconlp		;<>= then do some more		jmp	m_movefinished		;done when we fall to here		end_proc		m_scon_dinc	proc				;4 source constant - destination incs;move with the source = constant address and the dest = incrementing address; 'y' contains count on entry		tyx				;low word of count		ldy	#$0000			;start at first destination byte; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since m_movefinished does;    it for us.		sep	#$20			;must use 8 bit 'a' registerm_scon_dinclp		lda	[<source]		;get constant value to write		sta	[<dest],y		; and write it to incrementing location; set up for new source address		iny				;go to next source location		bne	m_scon_dinclp2		;loop if not = 0 yet; the next inc is an eight bit increment but that is ok since the high;    byte of the high word is always zero to start anyway		inc	<dest+2			;increment bank number; decrement counter by incrementing it to $00000000m_scon_dinclp2		inx				;increment to 0		bne	m_scon_dinclp		;loop if not done		inc	<count+2		;increment low byte of count word		bne	m_scon_dinclp		;not = 0 then just continue		inc	<count+3		;increment upper byte of word too		bne	m_scon_dinclp		;loop if not done		jmp	m_movefinished		;all done so exit		end_proc		m_sdec_dinc	proc				;6 source decs - destination incs;move with the source = decrementing address and the dest = incrementing address		ldy	<source			;decrementing address		stz	<source			;reset source address		ldx	#$0000			;incrementing address; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since m_movefinished does;    it for us.		sep	#$20			;must use 8 bit 'a' registerm_sdec_dinclp		lda	[<source],y		;get a byte to transfer		phy				;save 'y'		txy				;get destination address		sta	[<dest],y		;save the byte		ply				;restore source index		dey				;next source index		cpy	#$ffff			;did we fall through 0 ??		bne	m_sdec_dinclp2		;if not go here; the next dec is an eight bit decrement but that is ok since the caller;   should never be decrementing in bank $00 and expect to go into bank $ff.		dec	<source+2		;back up a bankm_sdec_dinclp2		inx				;next destination index		bne	m_sdec_dinclp4		;loop if no bank cross; the next inc is an eight bit increment but that is ok since the high;    byte of the high word is always zero to start anyway		inc	<dest+2			;next bank please; decrement counter by incrementing it to $00000000m_sdec_dinclp4		inc	<count			;increment low word of count		bne	m_sdec_dinclp		inc	<count+1		bne	m_sdec_dinclp		inc	<count+2		;increment upper word of count		bne	m_sdec_dinclp		inc	<count+3		bne	m_sdec_dinclp		;loop if not done		jmp	m_movefinished		;exit via common routines		end_proc		m_scon_ddec	proc				;8 source constant - destination decs;move with the source = constant address and the dest = decrementing address; 'y' contains count on entry		tyx				;low word of count		ldy	<dest			;start at first destination address		stz	<dest			;reset destination pointer; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since m_movefinished does;    it for us.		sep	#$20			;must use 8 bit 'a' registerm_scon_ddeclp		lda	[<source]		;get constant source byte		sta	[<dest],y		;store at decrementing destination		dey				;decrement to next source location		cpy	#$ffff			;dec through 0 then adjust dest bank		bne	m_scon_ddeclp2		;<>= then do some more; the next dec is an eight bit decrement but that is ok since the caller;   should never be decrementing in bank $00 and expect to go into bank $ff.		dec	<dest+2			;decrement source bank; decrement counter by incrementing it to $00000000m_scon_ddeclp2		inx				;adjust counter		bne	m_scon_ddeclp		;<>= then do some more		inc	<count+2		;increment low byte of count word		bne	m_scon_ddeclp		;not = 0 then just continue		inc	<count+3		;increment upper byte of word too		bne	m_scon_ddeclp		;<>= then do some more		jmp	m_movefinished		;done when we fall to here		end_proc		m_sinc_ddec	proc				;9 source incs - destination decs;move with the source = incrementing address and the dest = decrementing address		ldy	#$0000			;incrementing address		ldx	<dest			;decrementing address		stz	<dest			;reset destination address; set the 'm' bit to 1 for 8 bit mode since we're moving one byte at a time.; we don't have to reset to 16 bit mode for 'a' here since m_movefinished does;    it for us.		sep	#$20			;must use 8 bit 'a' registerm_sinc_ddeclp		lda	[<source],y		;get a byte to transfer		phy				;save 'y'		txy				;get destination address		sta	[<dest],y		;save the byte		ply				;restore source index		iny				;next source index		bne	m_sinc_ddeclp2		;if not go here; the next inc is an eight bit increment but that is ok	since the high;    byte of the high word is always zero to start anyway		inc	<source+2		;next bankm_sinc_ddeclp2		dex				;next destination index		cpx	#$ffff			;fallen	through $0000 yet??		bne	m_sinc_ddeclp4		;loop if no bank cross; the next dec is an eight bit decrement but that is ok	since the caller;   should never be decrementing in bank $00 and expect	to go into bank	$ff.		dec	<dest+2			;next bank please; decrement counter by incrementing it to $00000000m_sinc_ddeclp4		inc	<count			;increment low word of count		bne	m_sinc_ddeclp		inc	<count+1		bne	m_sinc_ddeclp		inc	<count+2		;increment upper word of count		bne	m_sinc_ddeclp		inc	<count+3		bne	m_sinc_ddeclp		;loop if not done		jmp	m_movefinished		;exit via common routines		end_proc		m_sdec_ddec	proc				;a source decs - destination decs; move with decrementing source	address	and decrementing destination address; set the move instuction in zero page to mvp		lda	#$0044			;mvp instruction		sta	<domove			;upper byte doesn't matter it's modified		jsr	setupformvx		;set up for mvn/mvp		bra	ddm_mdfirst; main move loopddm_mdmore		sta	<count+2		; more bytes to move		lda	<domove+1		; 'a' = srcdst banks		cpx	#$ffff			; bank cross? if x=0		bne	ddm_mdxnot0		sec		sbc	#$0100			; subtract 1 to source bankddm_mdxnot0		cpy	#$ffff			; did destination cross bank?		bne	ddm_mdyis0		dec	addm_mdyis0		sta	<domove+1ddm_mdfirst		txa				; if count > source then bank cross		cmp	<tempcount		bcs	ddm_mdxok		sta	<tempcount		; only move source bytesddm_mdxok		tya				; will destination cross bank?		cmp	<tempcount		bcs	ddm_mdyok		sta	<tempcount		; only move dest bytesddm_mdyok		jsr	domvxonstack		bpl	ddm_mdmore		jmp	m_movefinished		;exit via common routines		end_proc		setupformvx	proc; set up the self modifying code to contain destination; and source in	operand	of mvn/mvp instruction constructed on stack.		lda	<source+2		;get source bank		xba		ora	<dest+2			;or in destination bank		sta	<domove+1		;put bank into mvn/mvp instruction; decrement count because it contains actual transfer count whereas; remainder of routine assumes it contains transfer count - 1		lda	<count		bne	m_ara1		dec	<count+2m_ara1		dec	<count; a move instuction is already on zero page at this point in the code; initialize registers and tempcount for mvn/mvp on stack		ldx	<source			; X = low word of source		ldy	<dest			; Y = low word of dest		lda	<count		sta	<tempcount		rts		end_proc		domvxonstack	proc		entry	m_contdomove; set up the address to	rtl to which does the mvn on stack; this is the equivalent of a self modifying jmp absolute long instruction.		phk				;push rtl return on stack		pea	m_contdomove-1		;push rtl return address-1 on stack		pea	$0000			;we'll leave high byte $00 on stack		plb				; for setting correct execution bank.		tsc				;where are we now?		clc		adc	#$0009			;where are we going?						;+2 around user's direct page on stack						;+1 around user's data bank on stack						;+3 around m_contdomove rtl info on stack						;+2 around rts from jsr domvxonstack						;+1 around execution bank just put on stk		pha				;full rtl info on stack		lda	<tempcount		; get the number of bytes to move		rtl				;execute on stack in case we're in romm_contdomove					;		;return here after mvn		lda	<count			; count	= count	- bytes moved		clc				; actual bytes moved 1 more than count		sbc	<tempcount		sta	<count		sta	<tempcount		lda	<count+2		sbc	#$0000		rts		end_proc		movetable	proc		DC.W	m_scon_dcon		;0 source constant -destination constanty		DC.W	m_sinc_dcon		;1 source incs - destination constant		DC.W	m_sdec_dcon		;2 source decs - destination constant		DC.W	m_abortmove		;3 illegal move sequence requested		DC.W	m_scon_dinc		;4 source constant - destination incs		DC.W	m_abortmove		;5 src/dest incs should never get here		DC.W	m_sdec_dinc		;6 source decs - destination incs		DC.W	m_abortmove		;7 illegal move sequence requested		DC.W	m_scon_ddec		;8 source constant - destination decs		DC.W	m_sinc_ddec		;9 source incs - destination decs		DC.W	m_abortmove		;a src/dest decs should never get here		DC.W	m_abortmove		;b illegal move sequence requested		DC.W	m_abortmove		;c illegal move sequence requested		DC.W	m_abortmove		;d illegal move sequence requested		DC.W	m_abortmove		;e illegal move sequence requested		DC.W	m_abortmove		;f illegal move sequence requested		end_proc		eject********************************************************************************* End oscall segment: $009A00-00A280********************************************************************************		freespace	SCM segment 0,seg_0_start,seg_0_max,&segment_pc		eject********************************************************************************* Begin miscellaneous segment: $00B300-globals_end (~$00B9EE)*		SEG	'misc_seg'		;Becomes scm_seg_1		resetpc				;Reset counter.********************************************************************************		eject*********************************************************************************        Name:	os_event** Description:	Notify anyone in the os_event_queue who wants this event that*		it has occured.  The A, X, and Y registers on the stack will be*		passed to the notify_procs in the respective registers.**      Author:	Bryan Atsatt*     Created:	Nov 17, 1988*    Modified:	Dec 1, 1988	BPA	set direct page to zero before*					calling notify_proc.*		Jan 16, 1989 	BPA	Changed code storage to local variable*					and saved link_pointer across call to*					notify_proc.*		Sep 13, 1989	CAF	preserved the value of 'code' across the*					call to notify_proc.*		Sep 15, 1989	CAF	moved the code that pushes 'code' onto the*					stack to before the a,x,y registers are*					loaded (I was trashing A before)*		Sep 18, 1989	CAF	fixed stack relative offsets when loading*					the a,x,y registers (I pushed 4 bytes onto*					the stack)**       Entry:	jsl $1fcc4**       Input:  A = low word of event code.*               X = high word of event code.*               Y = undefined.*               P = nvmxdizc*		    ..000...**		Stack:  *               	|   previous contents	|*               	|_______________________|*               	|  A register parameter | word*               	|_______________________|*               	|  X register parameter | word*               	|_______________________|*               	|  Y register parameter | word*               	|_______________________|*               	|   	                | 3 bytes*               	|     return address	| *               	|_______________________|*               	|   	                | <- SP**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...*			   *		Stack:  *               	|   previous contents	|*               	|_______________________|*               	|   	                | <- SP**        Exit:	rtl**        Uses:	event_queue*		s_temp1*		s_temp2** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************		os_event	proclink_pointer	equ	s_temp1			;Pointer to queue header temp.** First set environment and save off the event code...*		phb				;Save data bank.		phk				;Set to our code bank.		plb		sta	code			;Save low word.		stx	code+2			;Save high word.** Get pointer to next handler (if any) from our header...*		lda	event_queue		;Get low word.		ldx	event_queue+2		;Get high word.** Save link pointer and exit if nil. Else, add offset to code entry point,* and self-modify our jsl address...*queue_loop	sta	<link_pointer		;Set low word of address.		stx	<link_pointer+2		;Set high word..	 		ora	<link_pointer+2		;Nil pointer?		beq	exit			;Yep, so we're done.	 ** Should we call this guy?  If not, skip him...*		ldy	#event_flags-event_queue   ;Get offset to lo word of flags.		lda	[<link_pointer],y	   ;Get low word of flag.		and	code		   	   ;Any bits match?		tax				   ;Save result.		ldy	#event_flags-event_queue+2 ;Get offset to hi word of flags.		lda	[<link_pointer],y	   ;Get hi word of flag.		and	code+2		   	   ;Any bits match?		bne	do_it			   ;Yes, so continue.		txy				   ;Nope, any in the low word?		beq	next_link		   ;Nope, so skip it.** Stuff the event code into the queue header, calculate entry point, load up the* registers and jsl to the code entry point...*do_it		ldy	#event_code-event_queue+2 ;Point to hi word of event code.		sta	[<link_pointer],y	  ;Stuff in header.		txa			  	  ;Get low word of code.		ldy	#event_code-event_queue	  ;Point to lo word of event code.		sta	[<link_pointer],y	  ;Stuff in header.		clc				;Calculate entry point.		lda	<link_pointer		ldx	<link_pointer+2		adc	#entry_point-event_queue		bcc	save_it		inx		save_it		sta	jsl_address+1		;Set low word of address.		sep	#x8			;Set 8 bit index.		stx	jsl_address+3		;Set high byte of address.		rep	#x8			;Restore 16 bit index.	 		lda	code			; <9/13/89 CAF>		pha				; <9/13/89 CAF>		lda	code+2			; <9/13/89 CAF>		pha				; <9/13/89 CAF>		lda	5+4,s			;Get Y parameter.		tay		lda	7+4,s			;Get X parameter.		tax		lda	9+4,s			;Get A parameter.				pei	<link_pointer		;Save pointer.		pei	<link_pointer+2		phd				;Save direct register.		phb				;Save bank register.		pea	0000			;Set direct register to zero.		pldjsl_address	jsl	$000000			;Call handler (SELF-MODIFIED!)		plb				;Restore bank.		pld				;Restore direct register.		pla				;Restore pointer.		sta	<link_pointer+2		pla		sta	<link_pointer				pla				; <9/13/89 CAF>		sta	code+2			; <9/13/89 CAF>		pla				; <9/13/89 CAF>		sta	code			; <9/13/89 CAF>** Now load up next link and loop...*next_link	ldy	#0002			;Point to high word of link.		lda	[<link_pointer],y	;Get high word.		tax				;Put in X.		lda	[<link_pointer]		;Get low word.		bra	queue_loop		;Loop.** We're all done.  Restore data bank, move return address up stack and exit...*exit		plb				;Restore data bank.		lda	2,s			;Move return address up.		sta	8,s		lda	1,s			;(overlapping)		sta	7,s		clc				;Adjust stack pointer.		tsc		adc	#6		tcs		rtl				;Exit.code		dc.l	00000000		;Space for event code.		end_proc		eject*********************************************************************************        Name:	os_add_queue and os_delete_queue** Description:	Adds/deletes call handler to/from os_event_queue.**      Author:	Bryan Atsatt*     Created:	Nov 18, 1988*    Modified:	Jan 4, 1989	BPA	Added logic to count notify_procs with*					volume_change flag set.**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined.*               P = nvmxdizc*		    ..000...**      Output:  A = error code if error.*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 = no error*			   1 = error**        Exit:	rts**        Uses:	AddToQueue (misctools)*		DeleteFromQueue (misctools)*		set_ptr*		s_temp1*		s_temp2*		s_temp3** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************os_add_queue	procadd_del_flag	equ	s_temp1			;Temp equate.		lda	#$0001			;Select add.		bra	do_it		entry	os_delete_queue	os_delete_queue	lda	#$ffff			;Select delete.do_it		sta	<add_del_flag		;Save selection.** Is the pointer nil?*		jsr	set_ptr			;Bump pointer to first parm.		lda	[<pb_ptr]		;Get low word of pointer.		tax				;Save it.		ldy	#0002			;Point to high word of pointer.		ora	[<pb_ptr],y		;Nil?		beq	bad_parm		;Yep.*		* Nope, so push parameters for call...*		lda	[<pb_ptr],y		;Get high word of pointer.		pha				;Push caller's pointer.		phx		pea	event_queue>>16		;Push pointer to our header.		pea	event_queue** Now call either AddToQueue or DeleteFromQueue and exit if error...*		lda	<add_del_flag		;AddToQueue?		bmi	delete			;Nope.				_AddToQueue			;Yes, do add call.		bcc	success			;success.bad_parm	lda	#parm_range_err		;Exit with error.		sec		rtsdelete		_DeleteFromQueue		;Do delete call.		bcs	bad_parm		;error ->** We were successful, so exit with carry clear...*success		rts				; carry is already clear		end_proc		eject*********************************************************************************        Name:	set_prefix_33** Description:	Sets prefix 33, the '@' prefix.**      Author:	Bryan Atsatt*     Created:	Nov 21, 1988*    Modified:	Nov 30, 1988	BPA	Fixed set_prefix_33 so does not*					count trailing zero in length word*		Dec 12, 1988	BPA	Added CLC after string copy.**       Entry:	jsl**       Input:  A = low word of pointer to class 1 string*               X = high word of pointer to class 1 string*               Y = undefined.*               P = nvmxdizc*		    ..000...**      Output:  A = error code if error.*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 = no error*			   1 = error**        Exit:	rtl**        Uses:	set_ptr*		allocate*		deallocate*		s_temp1*		s_temp2*		m_temp** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************set_prefix_33	procstring_ptr	equ	s_temp1			;Temporary equate.buffer_ptr	equ	s_temp2			;Temporary equate.** Set pointer to string...*		sta	<string_ptr		;Set low word of pointer.		stx	<string_ptr+2		;Set high word.** Allocate memory for new prefix.  Exit if fail...*		lda	[<string_ptr]		;Get length.		inc	a			;Bump by two for length word.		inc	a		inc	a			;Bump it one for the added zero.		jsl	allocate		;Allocate memory.		bcs	exit			;Exit on error.** Add VP to prefices table, and set buffer_ptr to new buffer...*		lda	#33			;Select prefix 33.		jsr	set_pfx			;Install new VP.		lda	>prefices,x		;Recover low word of VP.		tax		jsl	deref2			;Dereference VP.		stx	<buffer_ptr		;Save pointer.		sty	<buffer_ptr+2** Deallocate old VP if any...*		ldy	<m_temp+2		;Was there a VP to deallocate?		bmi	do_copy			;Nope.		ldx	<m_temp			;Yes, so get rid of it.		jsl	deallocate** Now copy the string into the buffer, add a trailing zero and exit...*do_copy		lda	[<string_ptr]		;Get length of string in X.		sta	[<buffer_ptr]		;Set new length.		tax				;Save length in X.				longa	off			;Set 8 bit mode.		sep	#m8		ldy	#0002			;Point to first character.copy_loop	lda	[<string_ptr],y		;Copy byte.		sta	[<buffer_ptr],y		iny				;Bump offset.		dex				;Done all?		bne	copy_loop		;Nope, so loop.		lda	#00			;Add trailing zero.		sta	[<buffer_ptr],y				longa	on			;Set 16 bit mode.		rep	#m8				clc				;No error.exit		rtl				;Exit.		end_proc		eject*********************************************************************************        Name:	get_std_ref_num** Description:	Returns refnum for last file opened for prefix 10,11 or 12.**      Author:	Bryan Atsatt*     Created:	Feb 8, 1989*    Modified:	Feb 8, 1989**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**		std_ref_num		;table of 3 refnums (0=undefined).**      Output:  A = Error code if error.*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 no error*			   1 error**        Exit:	rts**        Uses:	set_ptr** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************get_std_ref_num	proc** Set up our access to the parameter block...*		jsr	set_ptr			;Set pb_ptr** Make sure the prefix requested is 10, 11 or 12...*		ldx	#parm_range_err		;Assume error.		ldy	#pblk_37_pfxnum		;Get offset to prefix.		lda	[<pb_ptr],y		;Get the prefix number.		sec				;Put in range 0-2.		sbc	#10		cmp	#3			;In range?		bcs	error			;Nope.** It is. Make sure the requested ref_num is valid...*		ldx	#data_unavail		;Assume error.		asl	a			;Use as word offset.		tay		lda	std_ref_num,y		;Get ref_num. Valid?		bne	valid			;Yep.		error		sec				;Nope, so return error.		txa		rts** It is, so stuff it in the user's parameter block and exit...*valid		ldy	#pblk_37_refnum		;Get offset to parm.		sta	[<pb_ptr],y		;Stuff it.		clc				;Indicate no error.		rts				;Exit.		end_proc		eject*********************************************************************************        Name:	set_std_ref_num** Description:	Sets refnum for prefix 10,11 or 12 (std i/o channels).**      Author:	Greg Branche*     Created:	September 1, 1991*    Modified:	**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**		std_ref_num		;table of 3 refnums (0=undefined).**      Output:  A = Error code if error.*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 no error*			   1 error**        Exit:	rts**        Uses:	set_ptr** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************set_std_ref_num	proc		Import	std_prefix_num,last_ref_num** Set up our access to the parameter block...*		jsr	set_ptr			;Set pb_ptr** Make sure the prefix requested is 10, 11 or 12...*		ldx	#parm_range_err		;Assume error.		ldy	#pblk_37_pfxnum		;Get offset to prefix.		lda	[<pb_ptr],y		;Get the prefix number.		sec				;Put in range 0-2.		sbc	#10		cmp	#3			;In range?		bcs	error			;Nope.** It is. Save the index into the std_ref_num table*		asl	a			;Use as word offset.		sta	std_prefix_num		;Save for later.** Make sure the requested ref_num is valid...*		ldx	#invalid_ref_num	;Assume error again.		ldy	#pblk_37_refnum		;Get offset to parm.		lda	[<pb_ptr],y		;Retrieve the refnum.		beq	error			;Ya can't have a zero refnum, meathead!		sta	last_ref_num		;Save it.		jsl	findfcr			;Make sure there's an FCR for the refnum.		bcs	bad_refnum		;No go, Joe!** It is, so stuff it in the std_ref_num table and exit...*		ldy	std_prefix_num		;Get the proper index value.		lda	last_ref_num		;And the actual refnum.		sta	std_ref_num,y		clc				;Indicate no error.		rts				;Exit.error		sec				;Nope, so return error.		txabad_refnum		rts		end_proc		eject*********************************************************************************        Name:	insert_vol_name** Description:	If the input path contained a device name/number, this routine*		will attempt to build a new output string with the volume name*		replacing the device name/number.**      Author:	Bryan Atsatt*     Created:	Feb 20, 1989*    Modified:	Jan 23, 1992**       Entry:	jsl**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**		param_blk_ptr		;Points to caller's parms.*		fst_flags		;Set up by expand_path*		path1_ptr		;Set up by expand_path*		v_ptr1			;Set up by expand_path**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0**		path1_ptr		;Points to original or new outpath.**        Exit:	rtl**        Uses:	alloc_string** Copyright Apple Computer, Inc. 1989  All rights reserved.*******************************************************************************insert_vol_name	procclass1_volume	equ	$2008			;Class 1 volume call #.volume_x2	equ	$0010			;Volume call # times 2.exp_path_num	equ	$200e			;Expand_path call number.period		equ	$002e			;Period.** Was there a device name or number in the path?  Exit if not...*		ldy	#0002			;Get offset to first char.		lda	[<path1_ptr],y		;Get first character.		and	#$00ff			;Isolate low byte.		cmp	#period			;Is period?		beq	do_it			;Yep.		rtl				;Nope, so exit,** Yes, so we need to do a volume call to try to get the name for the selected* device.  First save some parameters...*do_it		lda	|v_ptr1			;Save v_ptr1.		pha		lda	|v_ptr1+2		pha		pei	<param_blk_ptr		;Save param_blk_ptr.		pei	<param_blk_ptr+2		pei	<call_number		;save current call number		pei	<path1_ptr		;Save path1_ptr.		pei	<path1_ptr+2				lda	|fst_flags		;Save flags word.		pha** Copy just the device name/number into our input path...*		sep	#m8			;Go to 8 bit A.		longa	off		ldy	#0001			;Point to first char-1.		ldx	#$ffff			;Point to start-1.		copy_name	iny				;Bump offsets.		inx		lda	[<path1_ptr],y		;Copy name to device_name.		sta	device_name+2,x		;Save it.		beq	set_length		;Done if zero.		cmp	#sep			;Is separator?		bne	copy_name		;Nope, so loop.set_length	stz	device_name+2,x		;Add terminator.				rep	#m8			;Back to 16 bit A.		longa	on				stx	device_name		;Set length.		stx	dev_name_length		;Save for later.** Do call and exit to restore_exit if error...*		jsr	do_volume_call		;Go do volume call.		ply				;Recover flags word.		sty	|fst_flags		ply				;Recover pointer.		sty	<path1_ptr+2		ply		sty	<path1_ptr		bcs	restore_exit		;Exit if error. ** Call succeeded.  Now path1_ptr points to original translated path and* device_name holds volume name.  Now let's figure out the length of the* new, concatenated string.  To do this, we have to get the length of the* original path minus the device name/number and add the length of the* volume name to it...*		sec				;Prepare to subtract.		lda	[<path1_ptr]		;Get original length.		sbc	dev_name_length		;Subtract device name len.		clc				;Now add volume name len.		adc	device_name		adc	#0003			;Add 3 for length word and 0.		tay				;And put new length in Y.** Ok, length is in Y, go allocate string.  Exit to restore_exit if error...*		lda	#0001			;Set so allocate will use		sta	|xlate_count		; path2_ptr and v_ptr2.		jsr	alloc_string		;Get space for a new string.		bcs	restore_exit		;Error.** Alright, we're all set to do the copy into the space pointed to by* path2_ptr.  First copy the volume name in, forcing the case if required...*		sep	#m8			;Go to 8 bit A.		longa	off		lda	#%11111111		;Init mask to no change.		ldx	|fst_flags		;Force case?		bpl	set_mask		;Nope, so leave mask alone.		lda	#%11011111		;Yes, set to clear bit. set_mask	sta	|case_mask2		ldx	device_name		;Get offset to end of string.		stz	device_name+2,x		;Add null terminator.				ldy	#0001			;Init offset.volume_loop	iny				;Bump offset.		lda	device_name,y		;Get byte.		cmp	#'a'			;Is lower case?		bcc	save_it			;Nope.		cmp	#'z'+1			;Maybe.		bcs	save_it			;Nope.		and	|case_mask2		;Yes, so mask it.save_it		sta	[<path2_ptr],y		;Copy it.		cmp	#00			;Reached end?		bne	volume_loop		;Nope, so loop.** Now, starting from the end of the device name/number in the original path,* copy to the end of our new string...*		tyx				;Save destination offset.		ldy	dev_name_length		;Get offset to 1st char after						; the device name in original.		iny				;Bump past length word.		iny						append_loop	lda	[<path1_ptr],y		;Get byte.		phy				;Save source offset.		txy				;Recover destination offset.		sta	[<path2_ptr],y		;Copy byte.		ply				;Recover source offset.		iny				;Bump offsets.		inx		cmp	#00			;Done with append?		bne	append_loop		;Nope, so loop.** Now set the new length using the value in X minus 3 for the length word* and the null terminator...*		rep	#m8			;Back to 16 bit A.		longa	on				dex				;Subtract 3 from length.		dex		dex		txa		sta	[<path2_ptr]		;Save new length.** Now set path1_ptr = path2_ptr so when we exit, expand_path will use the* new path...*		lda	<path2_ptr		;Copy pointer.		sta	<path1_ptr		lda	<path2_ptr+2		sta	<path1_ptr+2** We're done, so restore environment and exit...*restore_exit	pla				;Restore call number.		sta	<call_number		pla				;Restore param_blk_ptr.		sta	<param_blk_ptr+2		pla		sta	<param_blk_ptr		pla				;Restore v_ptr1.		sta	|v_ptr1+2		pla		sta	|v_ptr1				clc				;Force no error.		rtl				;Exit.		end_proc		eject*********************************************************************************        Name:	do_volume_call** Description:	Does an internal volume call.**      Author:	Bryan Atsatt*     Created:	Mar 9, 1989*    Modified:	**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**		path1_ptr		;Points to device name/number.**      Output:  A = error code*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 no error*			   1 error**        Exit:	rts**        Uses:	do_type_2*		volume_name*		device_name** Copyright Apple Computer, Inc. 1989  All rights reserved.*******************************************************************************do_volume_call	procclass1_volume	equ	$2008			;Class 1 volume call #.volume_x2	equ	$0010			;Volume call # times 2.** Set up the environment for the volume call...*		lda	#path_script		;Point script_start to special		sta	script_start		; script for pathname only.		lda	#class1_volume		;Set call number.		sta	<call_number				lda	#volume_x2		;Set num to call # times 2.		sta	|num		lda	#volume_parms		;Set param_blk_ptr to our parms.		sta	<param_blk_ptr		lda	#volume_parms>>16		sta	<param_blk_ptr+2		lda	|class			;Save class.		pha		lda	#0002			;Set to class 1.		sta	|class** Do call, restore class and exit...*		jsr	do_type_2		;Go do volume call.		plx				;Restore class.		stx	|class		rts				;Exit.				end_proc		eject*********************************************************************************        Name:	get_ref_num** Description:	Returns a ref_num if selected pathname is open.**      Author:	Bryan Atsatt*     Created:	Feb 21, 1989*    Modified:	Jun 2, 1989   BPA  Was returning access when pcount was 2!**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**		param_blk_ptr		;Points to caller's parms.**      Output:  A = Error code*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 no error*			   1 error code in A**        Exit:	rts**        Uses:	xlate_path*		getfcr*		find_fst*		release_v_ptrs** Copyright Apple Computer, Inc. 1989  All rights reserved.*******************************************************************************get_ref_num	proc		Import	e1_get_ref_num,std_prefix_nummsb_mask	equ	s_temp1			;Temp equate.character	equ	s_temp2			;Temp equate.fcr_ptr_temp	equ	s_temp3			;Temp equate.ref_offset	equ	$0006			;Offset to ref_num parm.access_offset	equ	$0008			;Offset to access_parmfork_offset	equ	$000a			;Offset to form_num parm.case_offset	equ	$000c			;Offset to case_sense parm.disp_offset	equ	$000e			;Offset to displacement parm.** First set up the default controls in case parameters are not present in the* parameter list, and initalize pathname translation variables... *		stz	|fork_num		;Select data fork.		stz	|case_sense		;Select insensitive.		lda	#0001			;Select 1st match.		sta	|displacement		jsr	init_path_vars		;Init pathname variables.		stz	std_prefix_num		;assume it's not a Std I/O prefix number** We know pcount is in range 'cuz it was checked by check_call.  Now let's* check the remaining parameters, overwriting the defaults where required...*		lda	[<param_blk_ptr]	;Get pcount.		tax		cpx	#4			;Do we have a fork_num?		bcc	set_case		;Nope.		ldy	#fork_offset		;Yes, get offset.		lda	[<param_blk_ptr],y	;Get parm.		cmp	#0002			;In range 0-1?		bcs	parm_error		;No, so error.		sta	|fork_num		;Yes, so save control.				cpx	#5			;Yes do we have a case parm?		bcc	set_case		;Nope.		ldy	#case_offset		;Yes, get offset.		lda	[<param_blk_ptr],y	;Get parm.		cmp	#0002			;In range 0-1?		bcs	parm_error		;No, so error.		sta	|case_sense		;Yes, so save control.		cpx	#6			;Yes do we have a disp parm?		bcc	set_case		;Nope.		ldy	#disp_offset		;Yes, get offset.		lda	[<param_blk_ptr],y	;Get parm.		sta	|displacement		;Yes, so save control.		bra	set_case		;Continue.		parm_error	lda	#parm_range_err		;Return parm_range_err.		sec		bra	release_exit		;Exit.** Now let's set up fst_flags to force upper case if case_insensitive selected* and set case_mask2 accordingly...*set_case	lda	#$8000			;Assume force upper case.		ldx	#%1111111111011111		ldy	|case_sense		;Case insensitive requested?		beq	set_flags		;Yep.		lda	#0000			;No, so don't force case.		ldx	#%1111111111111111set_flags	sta	|fst_flags		;Save flags.		stx	|case_mask2		;Save OR mask.** Now try translation. This will set path1_ptr to the translated name.  Exit* if error...*		lda	#0002			;Get offset in parm list.		jsr	xlate_path		;Do translation.		bcs	release_exit		;Exit on error.; call part 2, located in another bank		jsl	e1_get_ref_numrelease_exit	pha				;Save error.		php				;Save status.		jsr	release_v_ptrs		;Release vps.		plp				;Recover status.		pla				;Recover error code.		rts				;Exit.				end_proc		eject*********************************************************************************        Name:	get_ref_info** Description:	Returns access and pathname of open file with selected ref_num.**      Author:	Bryan Atsatt*     Created:	Feb 23, 1989*    Modified:	**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**		param_blk_ptr		;Points to caller's parms.**      Output:  A = Error code*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 no error*			   1 error code in A**        Exit:	rts**        Uses:	findfcr*		chk_app_buf*		copy_ext_string** Copyright Apple Computer, Inc. 1989  All rights reserved.*******************************************************************************get_ref_info	proc		Import	e1_get_ref_inforef_offset	equ	$0002			;Offset to ref_num parm.access_offset	equ	$0004			;Offset to access parmoutpath_offset	equ	$0006			;Offset to output path parm.rsrcNum_offset	equ	$000alevel_offset	equ	$000c** Since we got here we know that pcount is between 2 and 5, inclusive.  First let's see if* we have an FCR with the ref_num given to us.  Exit with error if not...*		ldy	#ref_offset		;Get offset to ref_num.		lda	[<param_blk_ptr],y	;Get ref_num.		jsl	findfcr			;Do we have one?		bcs	exit			;Nope.		jsl	deref2			;Yes, dereference vp.		stx	<s_temp1		;Save pointer.		sty	<s_temp1+2** Ok, we found one, now get access bits and put them in the parameter list...*		ldy	#fcr_access		;Get offset to access.		lda	[<s_temp1],y		;Get access.		and	#%0000000000000011	;Isolate access bits.		ldy	#access_offset		;Get offset into parms.		sta	[<param_blk_ptr],y	;Stuff it in.** Did the caller want the pathname?  Exit with carry clear if not...*		lda	[<param_blk_ptr]	;Get pcount.		cmp	#0003			;Want pathname?		bcc	exit			;Nope, so exit.** Yes, so get pointer to pathname from FCR, and check to make sure that the* output buffer is large enough.  Exit with error if not...*		ldy	#fcr_path_name		;Get offset to name.		lda	[<s_temp1],y		;Get low word.		tax				;Save it.		iny		iny		lda	[<s_temp1],y		;Get high word.		tay				;Put in Y.		jsl	deref2			;Dereference it.		stx	<m_temp			;Save pointer.		sty	<m_temp+2				ldy	#outpath_offset		;Get offset to outpath parm.		lda	[<m_temp]		;Get length of pathname.		jsr	chk_app_buf		;App buffer big enough?		beq	null_ptr		;if NULL pointer, skip it!		bcs	exit			;Nope, so exit with error.** It's big enough, so do the copy*		jsr	copy_ext_string		;Copy the string.** Now check for a request of the new parameters*null_ptr		lda	[<param_blk_ptr]	;Get pcount.		cmp	#$0004			;either of the new parameters wanted?		bcc	exit			;no, just exit		php				;save Z flag (pCount status)		ldy	#fcr_access		;get the access word		lda	[<s_temp1],y		;bit 14 is 0 if data fork is open,		and	#$4000			;clear all but that bit		asl	a			;shift into position		asl	a		rol	a			;and rotate into bottom bit		ldy	#rsrcNum_offset		sta	[<param_blk_ptr],y		plp				;retrieve Z flag		beq	done			;if set, pCount == 4		ldy	#fcr_level		;get the file system level used		lda	[<s_temp1],y		;  when the file was opened		ldy	#level_offset		sta	[<param_blk_ptr],ydone		clc				;no errorsexit		rts				;Exit.		end_proc		eject*********************************************************************************        Name:	install_int_vec** Description:	Installs interrupt_patch into main interrupt vector.  Does*		nothing if already installed.**      Author:	Bryan Atsatt*     Created:	Feb 22, 1989*    Modified:	**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..?**        Exit:	rts**        Uses:	intmgrv			;Main interrupt vector.** Copyright Apple Computer, Inc. 1989  All rights reserved.*******************************************************************************install_int_vec	proc** Are we already installed?*		lda	|patch_state		;Are we already installed?		bne	exit			;Yes, so do nothing.** No, so do install.  First disable interrupts, then patch our patch with* the contents of the main interrupt vector...*		php				;Save status.		sei				;Disable interrupts.		inc	|patch_state		;Set state to installed.				lda	>intmgrv		;Get current vector, low.		sta	|int_patch_1		;Patch first location.		sta	|int_patch_2		;Patch second location.		sta	|int_patch_3		;Patch third location.		lda	>intmgrv+2		;Get current vector, high.		sta	|int_patch_1+2		;Patch first location.		sta	|int_patch_2+2		;Patch second location.		sta	|int_patch_3+2		;Patch third location.** Now put address of our interrupt_patch into the main interrupt vector, * restore interrupt status and exit...*		lda	#interrupt_patch	;Get address, low.		sta	>intmgrv+1		;Stuff it into vector.		lda	#interrupt_patch>>8	;Get address, middle.		sta	>intmgrv+2		;Stuff it into vector.		plp				;Restore status.exit		rts				;Done.		end_proc		eject*********************************************************************************        Name:	remove_int_vec** Description:	Remove interrupt_patch from main interrupt vector.  Does*		nothing if already removed.**      Author:	Bryan Atsatt*     Created:	Feb 22, 1989*    Modified:	**       Entry:	jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..?**        Exit:	rts**        Uses:	intmgrv			;Main interrupt vector.** Copyright Apple Computer, Inc. 1989  All rights reserved.*******************************************************************************remove_int_vec	proc** Are we currently installed?*		lda	|patch_state		;Are we installed?		beq	exit			;No, so do nothing.** Yes, so remove our patch.  First disable interrupts and set patch_state to* zero...*		php				;Save status.		sei				;Disable interrupts.		stz	|patch_state		;Set state to not installed.** Now restore original vector, restore interrupt status and exit...*		lda	|int_patch_1		;Get original vector and put		sta	>intmgrv		; back in main vector.		lda	|int_patch_1+2		sta	>intmgrv+2				plp				;Restore interrupt status.exit		rts				;Exit.		end_proc		eject*********************************************************************************        Name:	init_parsepath** Description:	Clears internal variables for parse_path call.**      Author:	Bryan Atsatt*     Created:	Nov 16, 1988*    Modified:	Apr 17, 1989**       Entry:	jsl $1fcd4**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..0 = initialize*			   1 = release vps.**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..x**        Exit:	rtl**        Uses:	init_path_vars*		release_v_ptrs** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************init_parsepath	proc		phb				;Save data bank.		phk				;Set to our code bank.		plb		bcc	do_init			;We're doing an init.		jsr	release_v_ptrs		;Release vps.		bra	exit			;Exit.do_init		jsr	init_path_vars		;Do initialization.exit		plb				;Restore data bank.		rtl				;Exit.				end_proc		eject*********************************************************************************        Name:	parse_path** Description:	Translate pathname into canonical format for FST_Specific calls.**        NOTE:	Must call system service call Init_Parse_path once before*		calling this routine.**      Author:	Bryan Atsatt*     Created:	Nov 16, 1988*    Modified:	Apr 7, 1989**       Entry:	jsl $1fcc0**       Input:  A = offset to pathname pointer in parameter list.*               X = fst attribute flags word from FST header.*               Y = 0000 to select pathname1, 0001 to select pathname2.*               P = nvmxdizc*		    ..000...**      Output:  A = error code if error.*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..1 = error*			   0 = no error**		path_flag	;indicates which pathname active.*		dev1_num	;device number if present and path1 active.*		dev2_num	;device number if present and path2 active.*		span1		;maximum name length if path1 active.*		span2		;maximum name length if path2 active.*		path1_ptr	;pointer to pathname if path1 active.*		path2_ptr	;pointer to pathname if path2 active.**        Exit:	rtl**        Uses:	xlate_path** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************parse_path	proc		phb				;Save data bank.		phk				;Set to our code bank.		plb				sty	|xlate_count		;Select pathname.		ldy	|fst_flags		;Save current flags.		phy		stx	|fst_flags		;Set flags word.		jsr	xlate_path		;Do the name munging.		ply				;Restore flags.		sty	|fst_flags				plb				;Restore data bank.		rtl				;Exit				end_proc		eject*********************************************************************************        Name:	force_lock and force_unlock** Description:	Locks or unlocks all of GS/OS managed memory.**      Author:	Bryan Atsatt*     Created:	Mar 27, 1989*    Modified:	Mar 27, 1989**       Entry:	jsl**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000...**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*		    ..000..x**        Exit:	rtl**        Uses:	ul_mem2** Copyright Apple Computer, Inc. 1988  All rights reserved.*******************************************************************************rtl		equ	$6b			;Opcode for RTL.jml		equ	$5c			;Opcode for JML.force_lock	proc		entry	force_unlock		ldx	#%0000000000000011	;Select lock.		lda	#rtl			;Get RTL opcode.		bra	do_it			;Go do it.force_unlock	ldx	#%0000000000000000	;Select unlock.		lda	#jml			;Get JML opcode.** Patch or restore system service entry points for lock and unlock memory and* call ul_mem2 selecting either lock or unlock...*		longa	offdo_it		sep	#$20			;Go to 8 bit A.				sta	>lock_vector		;Patch/restore vector.		sta	>unlock_vector		;Patch/restore vector.				longa	on		rep	#$20			;Back to 16 bit A.		txa				;Get lock/unlock flag.		lsr	a			;Set/clear carry.		jmp	ul_mem2			;Go do it.				end_proc		eject;===============================================================================; init_fst_tbl:	 Initialize FST	Table to the empty state.;; Created:	4/10/87; Modified:	4/11/87; Author:	JJ;; Enter:	jsr	init_fst_tbl;		assumes DBR set to bank 0 (bank containing FST table);; Input:	P = nvmxdizc;		    ..000...;; Output:	P = nvmxdizc;		    ..000..|;			   0=no	error, 1=could not initialize table;===============================================================================init_fst_tbl	Proc		stz	fst_count		;initialize number of FSTs to 0		lda	#$FFFF			;set flag to indicate ProDOS FST not yet		sta	|prodos_index		;... loaded		sta	|char_index		clc				;indicate no error		rts		end_proc		eject********************************************************************************* A bunch of small routines were moved from the gim_seg to here (below)...********************************************************************************copy_ext_string	proc		entry	copy_gstring		entry	more		lda	[m_temp]		bra	overcopy_gstring;Copy a	GS/OS string (2	byte length) from source [m_temp] to dest [ptr]		lda	[m_temp]		;Got the length		inc	a			;Compensate for trailing zeroover		inc	a			;Comp for length word		tay				;Length in Ymore		deymore2		lda	[m_temp],y		;Byte from source		sta	[ptr],y			; into destination		tya		beq	noxtra			;We've copied the last word		dey		bne	more			;Okay as long as we haven't hit zero		bra	more2			;Odd length copy... skip a deynoxtra		rts		entry	to_copy_stringto_copy_string		jsr	copy_ext_string		rtl		end_procldxy_idhand	proc		entry	obj_type		pha		lda	>obj_type		rol	a			;Put type into carry (C<-1 means FCR)		lda	>fcr_id_hand		bcs	skipa		lda	>vcr_id_handskipa		tax		lda	>fcr_id_hand+2		bcs	skipb		lda	>vcr_id_hand+2skipb		tay		pla				;Pull back A		rtsobj_type	DS.B	2			;Msb is	flag indicating FCR/VCR		end_procderef2_vp	proc		pha		stx	vp			;Keep for later		sty	vp+2		jsl	deref2		stx	vcr		sty	vcr+2		pla		rts		end_procset_type	proc		pha		ror	a		sta	>obj_type		pla		rts		end_proclist_index	proc		lda	>obj_type		rol	a		lda	#vcr_list		bcc	skip		lda	#fcr_listskip		rts		end_proc		eject;===============================================================================; release_v_ptrs;; Release space	occupied by strings pointed to by virtual pointers; v_ptr	and v_ptr2.;; Created:	6/12/87; Modified:; Author:	JJ;; Enter:	jsr	release_v_ptrs;; Input:	v_ptr1	first virtual pointer;		v_ptr2	second virtual pointer;		P = nvmxdizc;		    ..000...;; Output:	v_ptr1 and v_ptr2 are set to zero;		A = trashed;		X = trashed;		Y = trashed;		P = nvmxdizc;		    ..000...;===============================================================================release_v_ptrs	proc		ldy	|v_ptr1+2		ldx	|v_ptr1			;release first virtual pointer if it is		bne	do_it2			;...non-zero.  Do nothing if it is zero.		tya				;check the high word		beq	do_2do_it2		jsr	>deallocate		;release storage		stz	|v_ptr1			;zero out virtual pointer		stz	|v_ptr1+2do_2		ldy	|v_ptr2+2		ldx	|v_ptr2			;release second	virtual	pointer if it is		bne	do_it4			;...non-zero.  Do nothing if it is zero.		tya		beq	do_3do_it4		jsr	>deallocate		;release storage		stz	|v_ptr2			;zero out virtual pointer		stz	|v_ptr2+2do_3		rts		end_proc		eject;==============================================================================; is_bouncer;; Determine whether or not the error code in A is a bouncing error.;; Created:	1/28/88; Modified:; Author:	JJ;; Input:	A = error code to test;		P = nvmxdizc;		    ..000...;; Output:	A = error code to test;		P = nvmxdizc;		    ..000.|.;			  z = 0, error is not a	bouncing error;			  z = 1, error is a bouncing error;===============================================================================is_bouncer	proc		sep	#$20			;only compare low byte		longa	off		cmp	#vol_not_found		beq	is_bounce		cmp	#unknown_vol		beq	is_bounce		cmp	#bad_path_syntax		beq	is_bounce		cmp	#bad_system_call		beq	is_bounce		cmp	#invalid_pcount		beq	is_bounce		cmp	#not_block_dev		beq	is_bounce		cmp	#network_error*		beq	is_bouncenot_bounceis_bounce		rep	#$20			;back to 16-bit accumulator		longa	on		rts		end_proc		eject;===============================================================================; call_fst:	Perform	all of the processing needed to	call an	individual FST;		designated by the offset of the	base of	its entry in the;		FST Table (0, 16, 32,...).  This routine sets up the proper;		environment for	the;		FST and	saves and restores its own environment around the FST;		call.  It assumes the FST call parameters on direct page are;		already	set up.;; Created:	5/11/87; Modified:	6/5/87;		7/31/87	 Changed definition of A register input.; Author:	JJ;; Enter:	jsr	call_fst;; Input:	A = offset of the FST's entry in the FST table;		P = nvmxdizc;		    ..000...;; Output:	A = if c=0, undefined; if c=1, error code;		    relays the error code returned by the FST;;		X = trashed;		Y = trashed;		P = nvmxdizc;		    ..000..|;			   0=no	error, 1=error;; Side effects:	The called FST performs	the call if it can.;===============================================================================call_fst	proc		entry	return_from_fst		import	save_s;; Set up pathname translation jump vector to the FST's application entry point.;		tax		lda	|fst_tbl+app_entry,x	;get application entry point		sta	|jump_vector+1		;... and set up jump vector for		lda	|fst_tbl+app_entry+1,x	;... later jump to FST		sta	|jump_vector+2;; Prepare to call the FST;	if do_force_lock=0 then		jsl	force_lock		;lock all of GS/OS memory for the FST	endif		phd				;save D		tsc				;save S		sta	|save_s		ldx	|num			;X = 2*call_number		ldy	|class			;Y = 2*subclass;; pass control to the FST;jump_vector	jmp	>$000000		;code above modifies this jump addressreturn_from_fst					;FST returns here by way of vector in					 	;... system service entry point table;; Restore DBR to proper	value;		phk		plb;; Handle the error returned by the FST;		rep	#mx16			;force full native mode		bcs	ar1			;branch	if FST returned an error		lda	#$0000			;if no error, force A to 0ar1*	and	#$00FF			;force high byte of error number to 0;; Restore registers;		ldx	|save_s			;restore S		txs		pld				;restore D	if do_force_lock=0 then		pha				;save error code		jsl	force_unlock		;unlock our memory again		pla				;restore error code	endif;; Set c	bit according to error number, which is	still in A;		cmp	#$0001			;set c bit according to error number		rts		end_proc		eject;===============================================================================; do_type_0;; Handle calls with call type of zero.	This is	a system error condition.;===============================================================================do_type_0	proc		jsr	>s_sys_death		end_proc		eject;===============================================================================; do_type_1;; Handle read_block and	write_block calls.  These are unconditionally passed; to the ProDOS	FST, if	it exists.;===============================================================================do_type_1	proc		lda	|prodos_index		;get index number of ProDOS FST		cmp	#$FFFF			;does ProDOS FST exist		beq	no_prodos		jmp	call_fst		;call the ProDOS FST, return from thereno_prodos	lda	#os_unsupported		;indicate that ProDOS FST is unavailable		sec		rts		end_proc		eject;==============================================================================; cmp_11_12;; Compares contents of prefixes 11 and 12.;; Created:	9/1/91; Modified:; Author:	GAB;; Output:	P = nvmxdizc;		    ..000.|.;			  z = 0, prefixes are not equal;			  z = 1, prefixes are equal;===============================================================================cmp_11_12	Proc				;compare prefix 11 to prefix 12		Import	string_compare,case_mask		lda	#11			;get the pointer to prefix 11		jsr	get_pfx		pei	m_temp+2		;save pointer		pei	m_temp		lda	#12			;now get the pointer to prefix 12		jsr	get_pfx		pla				;restore prefix 11 pointer		sta	ptr		pla		sta	ptr+2		lda	#$0020			;set flag for case-insensitive compare		sta	case_mask		jsr	string_compare		;compare dem strings		rts				;return with proper Z flag		end_proc		eject******************************************************************************** FST Table Data Structures** NOTE:	 The equates in	this record are	commented out and are here for *	 documentation purposes	only.  The actual definitions are at the start*	 of this file.** WARNING:  This data MUST reside in non-language-card memory so that the*	    Init Mgr can access it to build it's FST list.********************************************************************************fst_tbl_data	proc		entry	fst_entry_size		entry	fst_count		entry	fst_tbl		entry	prodos_index		entry	char_index		entry	curr_fst		entry	last_fst		entry	fst_flags;max_fsts	equ	16		;maximum number	of FSTs allowed; offsets of fields within an FST Table	entry;fst_hdr_ptr	equ	0		;pointer to FST header;app_entry	equ	fst_hdr_ptr+4	;address of FST's application entry pt;sys_entry	equ	app_entry+4	;address of FST's system entry point;id		equ	sys_entry+4	;FST id value;s_flags	equ	id+2		;flags					;bit 15=0, do not upper case pathnames					;      =1, force upper case in pathnames					;bit 14=0, the FST is a block FST					;      =1, the FST is a character FST;entry_size	equ	s_flags+2;table_size	equ	max_fsts*entry_sizefst_entry_size	dc.w	entry_size		;word containing size of each entryfst_count	ds.b	2			;current number	of FSTs in tablefst_tbl		ds.b	table_size		;the FST Tableprodos_index	dc.w	0000			;index of entry for ProDOS FSTchar_index	dc.w	0000			; index of entry for Char FST						; =$FFFF if there is no ProDOS or Char FST;init_fst	equ	$0002			;code to init FST call;kill_fst	equ	$0004			;code to shtdwn of FST;kill_vcr	equ	$0006			;code to free FST specific data from VCR;flush_def	equ	$0008			;code to flush deferred	blks on a VCRcurr_fst	dc.w	0000			;offset of table entry for FST						;...to be called nextlast_fst	dc.w	0000			;offset	of byte just past end						;...of FST tablefst_flags	dc.w	0000			;FST's pathname translation attributes		end_proc		eject********************************************************************************* Miscellaneous Data ** NOTE:	 The equates in	this record are	commented out and are here for *	 documentation purposes	only.  The actual definitions are at the start*	 of this file.********************************************************************************misc_data	proc		entry	hs_fst_flag		entry	iso_fst_header		entry	iso_fst_id		entry	std_ref_num		entry	std_prefix_num		entry	last_ref_num		entry	volume_parms		entry	volume_name		entry	device_name		entry	dev_name_length		entry	case_mask2		entry	fork_num			entry	case_sense		entry	displacement		entry	fcr_index		entry	found_count		entry	patch_state		entry	num		entry	class		entry	type		entry	script_start		entry	script_current		entry	save_s		entry	xlate_count		entry	xlate_type		entry	cont_offset		entry	str_len		entry	prefix_number		entry	default_prefix		entry	fstError		entry	first_fst		entry	volname_vp		entry	volname_ptr		entry	v_ptr1		entry	v_ptr2		entry	partial_len		entry	save_control		entry	char_mask		entry	handler_addr		entry	s_level** The following table holds the ref_nums for standard prefixes 10,11 & 12. A* value of zero means that the ref_num is undefined.  The two words following* the table are used to know when and how to update the table.*		entry	stdin_refnum,stdout_refnum,stderr_refnumstd_ref_numstdin_refnum	dc.w	0000			;Ref_num for prefix 10.stdout_refnum	dc.w	0000			;Ref_num for prefix 11.stderr_refnum	dc.w	0000			;Ref_num for prefix 12.std_prefix_num	dc.w	0000			;Standard prefix number.last_ref_num	dc.w	0000			;Last reference #.** The following data is used to simulate an ISO 9660 FST.  The hs_fst_flag is* set by add_fst when the High Sierra FST is added, and the iso_fst_header is* updated at the same time by copying the High Sierra FST header (up to the* name length) onto it...*		hs_fst_flag	dc.w	0000			;1 = High Sierra FST loaded.						;Set by add_fst.						iso_fst_header	dc.b	'FST '			;Load identification (4 bytes).		dc.l	00000000		;Entry point for application calls.		dc.l	00000000		;Entry point for system calls.iso_fst_id	dc.w	$000C			;ISO 9660 ID.		dc.w	$9800			;Flags: uppercase, clear msb.,read-only		dc.w	$8201			;Version 2.01, development		dc.w	$800			;Normal block size.   (2k)		dc.l	$57800			;Maximum blocks/volume. (700Mb)		dc.l	4			;Minimum blocks/volume. (8k)		dc.l	$2bbf7800		;Maximum file size.   (699.97Mb)		dc.l	00000000		;Reserved.		dc.b	8			;Length of FST name.		dc.b	'ISO 9660'		;Text of FST name.** The following data is used in the expand_path call to simulate a volume call* so we can return the volume name when a device name/number begins the path...*volume_parms	dc.w	2			;Pcount.		dc.l	device_name		;Pointer to device name.		dc.l	volume_name		;Pointer to volume name output.volume_name	dc.w	50			;Length of output buffer.device_name	ds.b	48			;Input AND output buffer.dev_name_length	dc.w	0000			;Temp storage for name length.case_mask2	dc.w	0000			;Mask for volume name copy.** The following are state variables for the get_ref_num call...*fork_num	dc.w	0000			;0 = data, 1 = resource.case_sense	dc.w	0000			;0 = insensitive, 1 = sensitivedisplacement	dc.w	0000			;0 = count 'em, else find Nth.fcr_index	dc.w	0000			;Current FCR index.found_count	dc.w	0000			;Count of matching paths.** The following variable indicates whether or not the interrupt_patch is* currently installed in the main interrupt vector...*patch_state	dc.w	0000			;0=not installed, 1=installed** The following data came from call_proc_data...*		Export	num,class		;for use by Init Mgrnum		DC.W	0000			;2 * primary call numberclass		DC.W	0000			;2 * subclass numbertype		DC.W	0000			;2 * call typescript_start	DC.W	0000			;pointer to beginning of call's scriptscript_current	DC.W	0000			;pointer to current entry in script		entry	save_script_startsave_script_start dc.w	0000			;used to save script start around rename_preamblesave_s		DC.W	0000			;save value of S before	calling FSTxlate_count	DC.W	0000			;during pathname translation, this						;...variable indicates whether the						;...first, second, etc. pathname in the						;...given parameter block is being						;...translatedxlate_type	DC.W	0000			;translation type						;$0000=translation for 'normal' call						;$0001=translation for set_prefix callcont_offset	DC.W	0000			;temporary value indicating where to						;continue processing a pathname after						;calling another procedurestr_len		DC.W	0000			;string length of pathname or part of						;pathname during pathname translationprefix_number	DC.W	0000			;prefix number determined from prefix						;designatordefault_prefix	DC.W	0000			;default prefix number to be used in						;xlate_path when it processes a partial						;pathname without a prefix designatorfstError	DC.W	0000			;error code returned by FST deemed most						;...likely to handle the callfirst_fst	DC.W	0000			;FST table index of FST deemed most						;...likely to handle the call. It is						;...called before any other FST.volname_vp	DC.L	00000000		;temporary vp to volume name used by						;...do_type_2volname_ptr	DC.L	00000000		;temporary ptr to volume name used by						;...do_type_2v_ptr1		DC.L	00000000		;temporary virtual pointers used duringv_ptr2		DC.L	00000000		;...pathname translation		entry	path1_v_ptr		;used only during ChangePathpath1_v_ptr	ds.l	1partial_len	DC.W	0000			;length of partial pathname during						;pathname translationsave_control	DC.B	00			;controlling separator for the pathnamechar_mask	DC.B	00			;mask for all pathname charactershandler_addr	DC.L	00000000		;address of routine that processes the						;current system calls_level		DC.W	0000			;level variable	used to communicate						;...between the do_type_6 and do_type_3		entry	dev_statusdev_status	dc.w	0000			;used for result of device status call		entry	do_runqdo_runq		dc.w	0			;flag set by s_mount_msg to use a						;  RunQ handler to recognize a disk						;  insertion.		entry	io_flagio_flag		dc.w	0			;bit flags for fast character I/O		entry	gsos_idgsos_id		DC.W	0		entry	SizeRectSizeRect	DC.W	0,0,200,640		;RECT used by os_shutdown		end_proc		eject********************************************************************************* End miscellaneous segment: $00B300-globals_end (~$00B9EE)********************************************************************************		freespace	SCM segment 1,seg_1_start,seg_1_max,&segment_pc		eject********************************************************************************* Begin scm_main segment: $00D000-00FFFF*		SEG	'scm_main'		;Becomes scm_seg_2		resetpc				;Reset counter.********************************************************************************		eject;===============================================================================; System Call Information Tables;===============================================================================sys_call_info	proc;===============================================================================; info_ptr table:  top level table for accessing system	call information;; The first word of this table holds a value one greater than the highest legal; system call number.  The rest	of the table has a pointer for each system call; to the descriptor table entry	for the	call.  A call is illegal if 1) the call ; number is zero, 2) the call number is	greater	than or	equal to the value in; the first word of the	table, 3) its table entry is zero, or 4) the high byte; of the call number is	$01, indicating	a call that should have	been handled by; APW.;===============================================================================		entry	info_ptr		entry	end_info_ptr		entry	ctype_vector		entry	path_script		import	new_volume_callinfo_ptr	DC.W	(end_info_ptr-info_ptr)/2 ;number of vectors in	table + 1		DC.W	create			;$01-create		DC.W	destroy			;$02-destroy		DC.W	s_os_shutdown		;$03-os_shutdown		DC.W	change_path		;$04-change_path		DC.W	set_file_info		;$05-set_file_info		DC.W	s_get_file_info		;$06-get_file_info		DC.W	s_judge_name		;$07-JudgeName		DC.W	volume			;$08-volume		DC.W	s_set_prefix		;$09-set_prefix		DC.W	s_get_prefix		;$0A-get_prefix		DC.W	clear_backup		;$0B-clear_backup_bit		DC.W	s_set_sys_prefs		;$0C-set_sys_prefs		DC.W	s_null			;$0D-null		DC.W	s_expand_path		;$0E-expand_path		DC.W	s_get_sys_prefs		;$0F-get_sys_prefs		DC.W	s_open			;$10-open		DC.W	s_newline		;$11-newline		DC.W	s_read			;$12-read		DC.W	write			;$13-write		DC.W	s_close			;$14-close		DC.W	flush			;$15-flush		DC.W	set_mark		;$16-set_mark		DC.W	get_mark		;$17-get_mark		DC.W	set_eof			;$18-set_eof		DC.W	s_get_eof		;$19-get_eof		DC.W	s_set_level		;$1A-set_level		DC.W	s_get_level		;$1B-get_level		DC.W	get_dir_entry		;$1C-get_dir_entry		DC.W	s_begin_session		;$1D-begin_session		DC.W	s_end_session		;$1E-end_session		DC.W	s_session_stat		;$1F-session_status		DC.W	get_dev_num		;$20-get_dev_number		DC.W	get_last_dev		;$21-get_last_dev		DC.W	read_block		;$22-read_block		DC.W	write_block		;$23-write_block		DC.W	s_format		;$24-format		DC.W	s_erase_disk		;$25-erase_disk		DC.W	s_reset_cache		;$26-reset_cache		DC.W	s_get_name		;$27-get_name		DC.W	s_get_boot_vol		;$28-get_boot_bol		DC.W	s_quit			;$29-quit		DC.W	s_get_version		;$2A-get_version		DC.W	s_get_fst_info		;$2B-get_fst_info		DC.W	s_d_info		;$2C-d_info		DC.W	s_d_status		;$2D-d_status		DC.W	s_d_control		;$2E-d_control		DC.W	s_d_read		;$2F-d_read		DC.W	s_d_write		;$30-d_write		DC.W	s_alloc_int		;$31-alloc_interrupt		DC.W	s_dealloc_int		;$32-dealloc_interrupt		DC.W	fst_specific		;$33-fst_specific_call		dc.w	s_add_queue		;$34-add_to_queue		dc.w	s_delete_queue		;$35-delete_from_queue		dc.w	s_d_rename		;$36-d_rename		dc.w	s_get_std_ref		;$37-get_std_ref_num		dc.w	s_get_ref_num		;$38-get_ref_num		dc.w	s_get_ref_info		;$39-get_ref_info		dc.w	s_set_std_ref		;$3A-set_std_ref_numend_info_ptr;===============================================================================; Call Descriptor Table;; This table describes aspects of each system call that	are relevant for call; preprocessing	by the System Call Manager.  Words in the info_ptr table point; to this table.  This table is	formatted as follows:;; Top level locations in the table (e.g. create) are tables of pointers	to; lower	level structures in the	table.	Each top level structure corresponds to; one system call.  The	first byte is one greater than the maximum class number ; for the call.	 This is followed by a word for	each subclass in the range from; 0 to the maximum subclass number (one	less than the value in the first word).; A value of zero in a subclass	word indicates that the	given subclass does not; exist.  A value other	than zero is a pointer to a table of information that; completely describes the call.  The descriptor table consists	of a series of; entries (a script), each element of which is defined as follows:;; 76543210  Meaning;; 00000000  End	of script; 0001xxxx  Specifies the call type.  The two bytes immediately	following this;	    code contain the call type premultiplied by	2 to serve as an index;	    into the ctype_vector table.  xxxx is undefined.; 0010vvvv  Minimum parameter count for	the given call and subclass is vvvv; 0011vvvv  There is a pathname	pointer	at offset vvvv in the parameter	block;	    corresponding to a pathname	input; 0100vvvv  There is a reference number	input at offset	vvvv in	the parameter;	    block; 0101vvvv  There is a pathname	pointer	at offset vvvv in the parameter	block;	    corresponding to a pathname	output.; 0110vvvv  Maximum parameter count for	the given call and subclass is vvvv; 1110xxxx  Execute a special processing routine whose address is contained in;	    the	following 3 bytes.  xxxx is undefined; 1111oooo  Escape to alternate	script opcode number oooo.;;	    Remaining values are reserved;===============================================================================;don't expand the macros.  makes the listing really messy ;-)		print	push		print	nogencreate		classes	2			;$01		info_at	create0		info_at	create1create0		ctype	2		pathptr	0		end_scriptcreate1		ctype	2		pcount	1		pathptr	2		end_scriptdestroy		classes	2			;$02		info_at	destroy0		info_at	destroy1destroy0	ctype	2		pathptr	0		end_scriptdestroy1	ctype	2		pcount	1		pathptr	2		end_scripts_os_shutdown	classes	2			;$03		no_such_class		info_at	s_os_shutdown1s_os_shutdown1	ctype	4		pcount	1		maxpcnt	1		exec	os_shutdown		end_scriptchange_path	classes	2			;$04		info_at	change_path0		info_at	change_path1change_path0	ctype	2		pathptr	0		pa