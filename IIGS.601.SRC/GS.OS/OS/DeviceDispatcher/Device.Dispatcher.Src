*********************************************************************************               Copyright (c) 1987-1992*               Apple Computer, Inc.*               All rights reserved.**********************************************************************************               GS/OS Device Dispatcher**               This binary file to be loaded into*               location $E0E000.**               Written by: Raymond B. Montagne********************************************************************************** Revision History:** mm/dd/yy Ver.   Who What** 04/13/87 through 6/07/89*		  GAB For revision history within these dates, see an archived*			version of this file.** 03/11/91 6.0d28 GAB During a full shutdown (command == 3), the dispatcher*			will now call each driver that supports removeable*			media to perform an Eject command.*		      sp_trans_id table changed so that a device with a*			SmartPort ID of $0D is now translated to a GS/OS*			device ID of $0B (printer).** 03/25/91 6.0d30 GAB set_wait_mode was not validating the request count*			correctly.  It would return an invalid parameter error*			when the request count != 0, instead of != 2.  Fixed.*		      Various call dispatches have been enhanced to use the*			Absolute Indexed Indirect addressing mode.** 04/11/91 6.0d32 GAB Find_File fixed so that it compares the two string lengths*			prior to comparing the contents of the strings.*		      Replaced all calls to get_cold_flag with a direct access load*			of the warm/cold boot flag.  Sure, it may cost one extra*			byte per access, but it's also 12 cycles faster.*		      do_file_load now saves the carry flag correctly on entry.** 04/15/91 6.0d32 GAB Duplicate supervisor drivers are now unloaded correctly with*			the supervisor list being patched up properly.  Prior versions*			were modifying the supervisor headers instead of the*			supervisor list.** 07/12/91 6.0d44 GAB Problem: When switching back to GSOS from P8, GQuit is passing*			the address of Boot.Driver to the device dispatcher for the*			restart.  During the original boot, though, the device*			dispatcher disposed of Boot.Driver when the loaded AppleTalk*			driver was brought into memory to replace it.  I fixed it so*			that if BOOT.DRIVER is replaced by a subsequent loaded*			driver, BOOT.DRIVER is simply sent a Shutdown command, but*			no UserShutdown is performed (i.e. it's not removed from*			memory).** 09/05/91 6.0d48 GAB Bug fix:  During dd_shutdown, the System Loader was making*			OS calls to close the load file when a non-restartable*			driver was shutdown.  This trashed the driver number that*			the dispatcher was using as an index into the device list*			to ensure that all drivers were shutdown.  This has been*			fixed by saving and restoring the driver number around*			the call to shutdn_driver.*		      Bug fix:  In shutdn_driver, the code was checking the boot*			device to see if it was a generated driver, and not shutting*			it down if it is (since it was never really started up in*			the first place).  Unfortunately, it was using a leftover*			driver_dib_ptr.  I added a call to set_dib_ptr just prior*			to the check to ensure that we're looking at the correct*			DIB.** 09/26/91 6.0d51 GAB Bug fix:  During startup, the dispatcher was not respecting*			the setting of the "hardware independent" bit of a driver's*			slot number (stored in the DIB).  Fixed by storing the*			full 16-bit value of the driver's slot number in*			copy_cur_name (instead of zeroing the upper 8 bits), and*			skipping the check in slot_unit_chk if the current*			DIB's bit is set.** 11/13/91 6.0d58 GAB Add logic to generated driver READ handler so that read*			requests to a Pascal interface will always return a*			character in the user's buffer if the firmware actually*			returns a character to us.  The generated core has been*			modified to always return a character in the low byte*			of the accumulator, and any possible error code in the*			high byte.  If an error did occur, the carry will be*			set on return from the bank 0 core, and the error code*			will be shifted up from $2x (what the firmware returns)*			to $3x (which will take it out of the range of the "real"*			device driver errors.** 9-Mar-93 6.0.1d14 JCM	No code-level changes in this file. I updated the diagrams*			of the device characteristics word to cover the newly defined*			"device follows guidelines" bit ($0010).********************************************************************************scsi_alert	equ	43unidisk_alert	equ	44appledisk_alert	equ	45		print	off		include	'gsos.macros.src' 		include	'common.equ.src' 		include	'hw.equ.src' 		include	'driver.equ.src' 		import	b0_core		import	bank0_dsptch		import	block_cnt		import	buf_to_system		import	buff_to_cache		import	cache_to_buff		import	call_list_ptr		import	config_ram		import	get_fmt_list		import	get_fmt_reqcnt		import	get_fmt_slist		import	get_fmt_unit		import	machine_id		import	param_list_ptr		import	set_fmt_clist		import	set_fmt_list		import	set_fmt_req		import	set_fmt_unit		import	sys_buffer		import	system_to_buf		import	sp_stat3		import	esp_stat3		import	slot_arbiter		import	set_gsos_speed		import	lc_dispatcher		import	STOP_SCRN_CHK		import	start_scrn_chk				print	on		eject***************************************************************** The following are signature bytes for ProDOS block devices.****************************************************************		export	bank_e0_segr	bank_e0_segr	proc		DataChk	offpro_sig		dc.b	$03		; $Cn05 signature		dc.b	$00		; $Cn03 signature		dc.b	$20		; $Cn01 signature		dc.b	$00		; $Cn07 SmartPort signature***************************************************************** The following are signature bytes for Pascal1.1 devices.****************************************************************pascal_sig		dc.b	$38		; $Cn05 signature		dc.b	$18		; $Cn07 signature		dc.b	$01		; $Cn0B signature***************************************************************** The following are $Cn0C type bytes for Pascal1.1 devices.* Note that the least significant nibble is not relevant to* the Pascal1.1 device type.****************************************************************pascal_type		dc.b	$10		; printer		dc.b	$30		; serial		dc.b	$40		; modem		dc.b	$80		; 80 Column		dc.b	$90		; Network / Bus***************************************************************** The following data is for a SmartPort parameter list* to be used in making a Unit 0 status call to determine* the number of devices connect to the SmartPort interface.* Note that this data must be moved to bank 0 for a standard* SmartPort call.****************************************************************sp_unit0            		dc.b	$03		; parameter count		dc.b	$00		; unit 0		dc.w	sys_buffer	; buffer pointer		dc.b	$00		; status code		dc.b	$00		; spare (required for g.read)		dc.b	$00		eject******************************************************************* This table is used to translate SmartPort type bytes* into GSOS Driver ID Numbers.  GS/OS ID numbers are as* follows:**	$0000	AppleDisk 5.25*	$0001	Profile (5 Meg)*	$0002	Profile (10 Meg)*	$0003	AppleDisk 3.5 or UniDisk 3.5*	$0004	SCSI Generic*	$0005	SCSI Hard Disk*	$0006	SCSI Tape Drive*	$0007	SCSI CD ROM*	$0008	SCSI Printer*	$0009	Modem*	$000A	Console*	$000B	Printer*	$000C	Serial LaserWriter*	$000D	AppleTalk LaserWriter*	$000E	RAM Disk*	$000F	ROM Disk*	$0010	File Server*	$0011	IBX Driver*	$0012	Apple DeskTop Bus*	$0013	Hard Disk Generic*	$0014	Floppy Disk Generic*	$0015	Tape Drive Generic*	$0016	Character Device Generic*	$0017	MFM Floppy Disk*	$0018	Network Generic*	$0019	SCSI Sequential Access Device******************************************************************sp_trans_id				; sp = GS/OS Device ID Number		dc.w	$000E		; 00 = 0E Ram Disk		dc.w	$0003		; 01 = 03 Disk 3.5		dc.w	$0002		; 02 = 02 JVC HD (ProFILE)		dc.w	$0004		; 03 = 04 SCSI (generic)		dc.w	$000F		; 04 = 0F Rom Disk		dc.w	$0007		; 05 = 07 SCSI CD-ROM		dc.w	$0006		; 06 = 06 SCSI Tape		dc.w	$0005		; 07 = 05 SCSI HD		dc.w	$0019		; 08 = 19 SCSI Sequential Device		dc.w	$001A		; 09 = 1A SCSI Printer		dc.w	$0000		; 0A = 00 AppleDisk5.25		dc.w	$0014		; 0B = 14 Reserved (BERT)		dc.w	$0000		; 0C = 00 Reserved (BERT)		dc.w	$000B		; 0D = 0B Printer		dc.w	$0000		; 0E = 00 Clock (not for A//GS)		dc.w	$0009		; 0F = 09 Modem		dc.w	$0003		; 10 = 03 Super Drive** Note that SmartPort ID's above $0F will be translated to GS/OS ID $0014* signifying a generic floppy disk.*		eject***************************************************************** Variables, Handles and ID's are stored in this data area.****************************************************************dev_list_id	dc.w	0		; save device list ID heredev_list_hndl	dc.l	0		; save device list handle heredev_list_size	dc.l	0		; size of device list handlehandle_size	dc.l	0		; handle size used by set_handle_size*****************************************************************	The following variables are used in managing the*	device dispatcher file list associated with the*	P8 restart from memory code.****************************************************************file_list_id	dc.w	0		; user ID assigned to the file listfile_list_hndl	dc.l	0		; handle assigned to the file listfile_list_size	dc.l	0		; size of file list handlefile_list_index	dc.w	0		; current index into the file listfile_list_entry	dc.w	0file_list_cnt	dc.w	0		; number of entries in the file list*****************************************************************	The following variables are used in managing the*	device and supervisor list as well as generated DIBs.****************************************************************gen_drvr_id	dc.w	0		; generated driver list id heregen_drvr_hndl	dc.l	0		; generated driver list handledrvr_list_size	dc.l	0		; size of DIB/GDIB listgen_count	dc.w	0		; running count of generated driversgen_slot_num	dc.w	0		; slot for current device generationtotal_gen	dc.w	0		; total number of generated driversname_buff	ds.b	8		; buffer for device name generationdrvr_list	dc.w	14drvr_list_str	dc.b	'SYSTEM:DRIVERS' drvr_list_id	dc.w	0		; user id for 'DRVR.LIST'drvr_file_num	dc.w	0		; file number for 'DRVR.LIST'driver_count	dc.w	1		; number of devicesload_device	dc.w	2		; current device being loadedold_dev_num	dc.w	0		; device number of replaced devicecur_dev_num	dc.w	0		; device number of current devicecurrent_name	ds.b	32		; name of current loaded drivercurrent_slot	dc.w	0		; slot for current devicecurrent_unit	dc.w	0		; unit for current devicecurrent_version	dc.w	0		; version for current devicecurrent_dev_id	dc.w	0		; Device ID for current devicecur_user_id	dc.w	0		; user ID for loaded deviceshutdown_id	dc.w	0		; current ID of driver being purgeddd_os_call	dc.w	0		; OS call that currently is executingdib_count	dc.w	0		; number of dibs this filestart_count	dc.w	0		; number of DIBs indicated by auxtypepurge_flag	dc.w	0		; non zero if 1 loaded device startedd_boot_slot	dc.w	0		; my boot slotsup_drvr_id	dc.w	0		; user ID for supervisor driver listsup_drvr_hndl	dc.l	0		; handle for supervisor driver listsup_drvr_cnt	dc.w	0		; count of supervisor driverssup_drvr_num	dc.w	0		; supervisory driver numbercur_sib_id	dc.w	0		; current supervisor IDcur_sib_ver	dc.w	0		; current supervisor versioncur_sup		dc.w	0		; current supervisor duplicate searchpro_char	dc.w	0		; for building device characteristics** The following variables are used to manage the alert dialog* display when a device driver is required.*ud_count	dc.w	0		; number of UniDisks foundad_count	dc.w	0		; number of AppleDisks foundscsi_count	dc.w	0		; number of SCSI's found		eject********************************************************************************* A driver's DIB must contain the following information:**               Long    Link Pointer*               Long    Entry Pointer*               Word    Device Characteristics (see below)*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |__ RESERVED (cleared to 0)*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |______ RESERVED (cleared to 0)*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________ Media remov*   |   |   |   |   |   |   |   |   |   |   |   |   |______________ Format*   |   |   |   |   |   |   |   |   |   |   |   |__________________ Driver follows guidelines*   |   |   |   |   |   |   |   |   |   |   |______________________ Read*   |   |   |   |   |   |   |   |   |   |__________________________ Write*   |   |   |   |   |   |   |   |   |______________________________ Block Dev*   |   |   |   |   |   |   |   |__________________________________ Speed Group*   |   |   |   |   |   |   |______________________________________ Speed Group*   |   |   |   |   |   |__________________________________________ Fixed Name*   |   |   |   |   |______________________________________________ Restartable*   |   |   |   |__________________________________________________ Device Busy (managed by dispatcher)*   |   |   |______________________________________________________ Linked*   |   |__________________________________________________________ Generated*   |______________________________________________________________ RamRom Disk**               Long    Block Count*               32      Device Name*               Word    Slot Number*               Word    Unit Number*               Word    Version Number as follows:*                       XYYZ where: X  = Major release version*                                   YY = Minor release version*                                   Z  = (A)lpha, (B)eta, (E)xerimental or*                                        0 for final release.*               Word    Device ID Number     (Icon selector)*               Word    Head Device Link     (Logically linked device)*               Word    Forward Device Link  (Logically linked device)*               Long    Extended DIB Pointer (only if external access to data is allowed)*               Word    DIB Device Number    (initialized by device dispatcher)** The following is the DIB for the boot volume driver.********************************************************************************boot_dib			dc.l	$00000000	; link_ptr		dc.l	g_dispatch	; entry_ptr		dc.w	$43EC		; dev_char %0100001111101100		dc.l	$FFFFFFFF	; blk_cnt    (default = max.)		dc.b	$04		; dev_name   (default = DEV1)		dc.b	'DEV1                           '				dc.w	0		; slot_num   (default set by bootinit)		dc.w	1		; unit_num   (default = Unit #1)		dc.w	0		; ver_num    (default = 0.00)		dc.w	4		; dev_id_num (default = AppleDisk3.5)		dc.w	0		; head device link		dc.w	0		; forward device link		dc.l	0		; Extended DIB pointer		dc.w	1		; DIB device number** The following is a GDIB for a generated driver.  Note that* many DIB and GDIB parameters will have to be modified* conditional on the actual device for which a driver is* being generated for.*		dc.w	1		; drvr_class (default std SmartPort)		dc.w	$0001		; drvr_type (default = DISK3.5)		dc.w	$00C0		; drvr_subtype (default = AppleDisk3.5)		dc.w	$FFFF		; cache_mask		dc.w	512		; block_size   (default = $0200 = 512)		dc.w	1		; Hardware Unit Number		eject******************************************************************* The following data structures are used by the device dispatcher* only while loading device drivers as a result of a STARUP call* being issued to the device dispatcher (Device #0).  Note that* these data areas should probably be defined as equates in* bank 0 Ram since they waste memory here and bank 0 is safe* when these data areas are needed.******************************************************************dev_os_data	d_boot_vol_list	dc.w	1		; pcount		dc.l	boot_vol_nameboot_vol_name	dc.w	32		; string buffer lengthboot_vol_str	ds.b	34		; string and string lengthsys_drivers	dc.b	'SYSTEM:DRIVERS' d_open_list	dc.w	2		; pcount = minimumd_open_ref_num	dc.w	0		; reference numberd_open_path	dc.l	boot_vol_strd_close_list	dc.w	1		; pcount = minimumd_close_ref_num	dc.w	0		; reference numberdir_entry_list	dc.w	13		; pcount (need AuxType)dir_ref_num	dc.w	0		; reference numberdir_entry_null	dc.w	0dir_entry_base	dc.w	0		; basedir_entry_disp	dc.w	0		; displacementdir_entry_name	dc.l	d_file_name	; pointer to name stringdir_entry_num	dc.w	0		; entry numberdir_entry_ft	dc.w	0		; FileTypedir_entry_eof	dc.l	0		; EOFdir_entry_blk	dc.l	0		; block countdir_entry_date	ds.b	8		; create date / time (must be manually converted)dir_entry_mod	ds.b	8		; mod date / time (must be manually converted)dir_entry_acc	dc.w	0		; accessdir_entry_aux	dc.l	0		; AuxTypedir_entry_fst	dc.w	0		; file system IDdir_entry_ol	dc.l	0		; option list pointerdev_get_f_info	dc.w	4		; pcountget_file_path	dc.l	driver_name	; file to get info on		dc.w	0		; accessdev_file_type	dc.w	0		; FileType must be $BBdev_aux_type	dc.l	0		; AuxType must be $01XXdriver_name	dc.w	32driver_name_str	ds.b	34d_file_name	dc.w	32file_name_str	ds.b	34set_prefix_list	dc.w	2		; pcountprefix_num	dc.w	0		; prefix numberprefix_str	dc.l	boot_vol_strx_unit		dc.w	0		; hardware unit numberstack_address	dc.w	0		eject****************************************************************** This is the main entry point for the device dispatcher.* Note that calls to device zero specify calls to the dispatcher* and not to a particular device.  Non-zero device numbers* will be passed on to that specific device.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0	** EXIT:         A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Same as on entry*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0	if no error*			¥ ¥ 0 0 0 ¥ ¥ 1  0	if error*****************************************************************		export	dev_dispatchdev_dispatch			longa	on		longi	on				lda	<drvr_call_num	; is it a startup or shutdown?		cmp	#$0001		beq	a_drvr_done_it	; no, dont modify the flag or purging breaks!!!		sta	>dd_os_calla_drvr_done_it		cmp	#$0004		; is it a legal command?		bge	illegal_req	; no		asl	a		; make index to dispatch table		tax		phb		phk		plb		jsr	(dev_d_table,x)	; get dispatch entry		plb		rtl** Received an illegal request.  Return with an error.*illegal_req		lda	#drvr_bad_req	; set error		sec		rtl** The following is a table of dispatch entry points for the* device dispatcher functions.**               $0000   Startup call to device dispatcher.*               $0001   Call to set DIB pointer for current device.*               $0002   Shutdown call to device dispatcher.*               $0003	Full shutdown call to device dispatcher (with eject).*		$0004 - $FFFF Are not implemented.*dev_d_table	dc.w	dd_boot			; startup call		dc.w	dd_get_dib		; set DIB pointer		dc.w	dd_shutdn		; shutdown call		dc.w	dd_full_shutdn				eject***************************************************************** This routine sets the Y register to point into the* device list to the current device entry based on* drvr_dev_num on direct page.  The device list must* contain a longword count of entries in the device* list followed by 8 bytes per device entry.  The index* is set as follows:** INDEX = ((drvr_dev_num-1) * 8) + 4** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = unchanged*               X Reg = unchanged*               Y Reg = index for [<drvr_dev_ptr],y - points at current device*               B Reg = unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************set_dev_index              		longa	on		longi	on				pha			; preserve through call		lda	<drvr_dev_num		jsr	times_8_plus_4	; Y = (A * 8) + 4		pla		rtstimes_8_plus_4             		longa	on		longi	on		dec	a		; calculate supervisory list entry		sec		rol	a		asl	a		asl	a		tay			; set SIB pointer		rts		eject****************************************************************** This routine is used to install a driver for the boot* volume that can be used by the GS/OS and System Loader* to bring in the rest of the operating system.  If the * DRVR_DIB_PTR is NIL at startup then a generated driver* will be installed as the initial boot device.  This driver* may be replaced at any time during the boot process if a* duplicate loaded driver exists for the same slot and unit* that the boot is occuring from.  If the DRVR_DIB_PTR is* not NIL then a loaded driver will be used during the boot* process.  Regardless of which type of driver is used during* the boot process, a default generated DIB will be used as a* master copy when generating device drivers for peripherals* that have no loaded driver.** (1) Allocate new handle for device list of size = 12 bytes* (2) Set device count to $00000001* IF DRVR_DIB_PTR = NIL THEN* (3) Set 1st DIB pointer entry to point to boot volume driver* (4) Set correct slot in boot volume DIB.* ELSE* (3) Install BOOT.DRIVER DIB pointer in device list.* (4) Install BOOT.DRIVER User ID in device list.* THEN* (5) Load supervisory drivers* (6) Start supervisory drivers* (7) Load device drivers* (8) Start device drivers* (9) Generate drivers* END** Each device list entry is 8 bytes.  The device list will* consist of a longword count of the number of entries in* the device list as well as the entries for each device.* The entries for each device consists of a longword pointer* to the devices DIB followed by a word used to maintain the* disk switched status when bouncing through FST's and an* additional word reserved for future expansion.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0*	 DRVR_DIB_PTR =	NIL if no BOOT.DRIVER or . . .*			Address of BOOT.DRIVER DIB*	 BOOT_USER_ID =	User ID of BOOT.DRIVER ($3Fxx)** EXIT:         A Reg = Error code*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0	if no error*			¥ ¥ 0 0 0 ¥ ¥ 1  0	if error*****************************************************************dd_boot				longa	on		longi	on		lda	>dev_start_flag		; for thermometer to poll for safe OS calls		dec	a		sta	>dev_start_flag		stz	<post_drvr_tbl		; make sure no drivers are posted		stz	<post_drvr_tbl+2** Set the ProDOS global page to NIL.  This prevents incompatable* applications from running by luck.  NOTE that $BF32 must be maintained* as $00 for compatibility with SCSI2 while $BF00 must be maintained * as $4C for the Apple][ Memory Expansion Card (Slinky).*		ldx	#$003F		lda	#$0000global_nil		sta	>$00BF00,x		dex		bpl	global_nil** In case there are any Apple][ Memory Expansion cards residing* in the slots, need to initialize $BF00 so that these devices* will format themselves as ProDOS devices.*		lda	#$004C			; Place a 'JMP' instruction in $BF00		sta	>$00BF00				lda	>warm_cold_flag		; is this a warm start?		bne	build_dev_list		; yes, dont need parameters or newhandle** Setup Class 0 configuration ram.*		pea	sys_buffer>>16		; pointer to buffer		pea	sys_buffer		_readbram		ldx	#config_ram		; point at configuration ram		lda	>sys_buffer+$84		sta	>0,x			; ProDOS configuration				eject** Now allocate an 12 byte block for the device list.*        _________________* $0000 |_               _|   Count of number of devices*       |_               _|*       |_               _|*       |_________________|* $0004 |_               _|   Pointer to device #1 DIB*       |_               _|*       |_               _|*       |_________________|* $0008 |_               _|   Device #1 dispatcher maintained diskswitch*       |_________________|* $000A |_               _|   Device #1 Driver User ID (loaded driver only)*       |_________________|** First need to get an ID for the memory segment that will* be allocated for the device list.*		lda	#$3F00			; get a $3Fxx user id		jsr	get_new_id		sta	|dev_list_id		; save device list handle ID		ldx	#$000C		stx	|dev_list_size		ldy	#$8008			; locked, fixed & no special mem		jsr	get_new_handle		stx	|dev_list_hndl		sty	|dev_list_hndl+2** Now build the device list.  Number of devices will be set to one.* The first entry in the device list will point at the boot volume* driver.*build_dev_list		jsr	deref_dev_list		; dereference device list handle		ldy	#$0002			; point at device count		lda	#$0001			; device count = $00000001		sta	[<drvr_dev_ptr]		dec	a		sta	[<drvr_dev_ptr],y		iny				; point at first DIB entry		iny** The following code was added for system disk 4.1 to accomodate booting* from a BOOT.DRIVER such as AppleTalk.*		lda	<drvr_dib_ptr		; Is boot occuring from a BOOT.DRIVER?		ora	<drvr_dib_ptr+2		beq	no_boot_drvr		; no, use default DIB for booting** Boot is occuring from a BOOT.DRIVER.  Install boot driver DIB address and* User ID into the device list and proceed with the boot process.*		lda	<drvr_dib_ptr		; install BOOT.DRIVER DIB		sta	[<drvr_dev_ptr],y		lda	<drvr_dib_ptr+2		iny		iny		sta	[<drvr_dev_ptr],y		bra	set_boot_id** Boot is occuring from a built in firmware peripheral driver.  Install* the default DIB into the device list and proceed with the boot process.*no_boot_drvr			stz	<boot_user_id		; no user ID on generated boot driver		lda	#boot_dib		; set entry = boot volume DIB address		sta	[<drvr_dev_ptr],y		sta	<drvr_dib_ptr		; and set current DIB pointer		iny		iny		lda	#boot_dib>>16		; NOTE: location must be bank $E0		sta	[<drvr_dev_ptr],y		sta	<drvr_dib_ptr+2set_boot_id		lda	#$0000			; init disk switched status		iny		iny		sta	[<drvr_dev_ptr],y		iny				; init driver User ID		iny		lda	<boot_user_id		; init disk switched status & user ID		sta	[<drvr_dev_ptr],y** Now set the slot in the DIB for the boot volume.*		inc	<drvr_dev_num		; boot volume is device #1		jsr	set_dib_ptr		; set DIB ptr on direct page		lda	<boot_slot		; get boot slot		xba				; set for dib construction routine		sta	<fw_addr		stz	<fw_addr+2		lda	#$0001			; unit number		jsr	generate_slot		; generate DIB slot and unit numbers		ldy	#slot_num		; set boot slot parameter int/ext		lda	[<drvr_dib_ptr],y		sta	<boot_slot		sta	|d_boot_slot** Correct default driver class and cache mask if not a* SmartPort interface for boot device.  (Rev v0.27)*		ldy	#dev_char		lda	[<drvr_dib_ptr],y		and	#$4000			; is device generated?		beq	class_ok		; no, dont modify the DIB				ldy	#$C007			; need ($Cn07)		lda	[<fw_addr],y		and	#$00FF			; is this a smartport interface		beq	class_ok				lda	#$0000			; dont cache ProDOS devices		ldy	#drvr_class		sta	[<drvr_dib_ptr],y		ldy	#cache_mask		sta	[<drvr_dib_ptr],yclass_ok 		eject** Now allocate an 1 longword block for the filename list.  Eventually, this* handle will be set to the maximum number of files contained in the * :boot:system:drivers directory.  After drivers have been loaded, the* handle will be reduced to fit the number of actual file name entries.* The structure of the filename list is as follows:**			 _________________*	BASE		|_               _|   Filename entry #1*			|_               _|*			|_               _|*			|_________________|*				 ¥*				 ¥*				 ¥*			 _________________*	BASE+(n*48)	|_               _|   Filename entry #n*			|_               _|*			|_               _|*			|_________________|** The structure of each filename entry is a 48 byte structure as follows:**			 _________________*	BASE=0		|_               _|   FileType of filename entry*			|_________________|*	BASE+2		|_               _|   AuxType of filename entry*			|_________________|*	BASE+4		|_               _|   User ID of filename entry*			|_________________|*	BASE+6		|_               _|   Load Address of filename entry*			|_               _|*			|_               _|*			|_________________|*	BASE+10		|_               _|   32 byte filename*			|	          |*				 ¥*				 ¥*				 ¥*			|_               _|*			|_________________|*	BASE+42		|_               _|   Restart Flag of filename entry*			|_________________|*	BASE+44		|_               _|   Base device number of filename entry*			|_________________|*	BASE+46		|_               _|   RESERVED for filename entry*			|_________________|** First need to get an ID for the memory segment that will be allocated for the filename list.*		lda	>warm_cold_flag		; is this a warm start?		bne	have_fl_hndl		; yes				lda	#$3F00			; get a $3Fxx user id		jsr	get_new_id		sta	|file_list_id		; save device list handle ID		ldx	#$0004			; size of block		ldy	#$8008			; locked, fixed & no special mem		jsr	get_new_handle		stx	|file_list_hndl		sty	|file_list_hndl+2have_fl_hndl		eject****************************************************************** This routine counts how many loaded and generated drivers* exist excluding the boot volume slot (don't need to allocate* space in list twice for this device).  The device list handle* size will be increased to accomodate the number of devices* that are to be installed in the device list.  In addition, the* dispatcher error list handle will be increased.  Then each* loaded driver and generated driver will be installed into the* device list.  After being installed in the device list, each* driver will be issued a 'drvr_startup' call.  If a driver* returns an error from this call, the driver will be removed* from the device list and both the device list and error list* handle sizes will be updated.** WARNING!!!!!!*               This call must not be issued until the*               bank 0 dispatcher is loaded.*****************************************************************		longa	on		longi	on** Need to determine how many loaded drivers exist.* Result count of how many loaded drivers is added* to the value of the transfer count on direct page.*		stz	|total_gen		; no generated drivers have been built yet		pei	<boot_slot		; preserve boot slot around drvr calls		jsr	count_l_drvr		; count loaded drivers** This following routine was added for the P8 switch and grows the size of the* file list handle to accomodate the maximum number of driver files contained* in the driver directory.*		lda	>warm_cold_flag		; is this a warm start?		bne	fl_size_ok		; no, leave the file list alone				lda	|file_list_cnt		; get current driver count		jsr	calc_file_index		; determine handle size		sta	|file_list_size		jsr	put_handle_size		; save parameters for set_handle_size				ldx	|file_list_hndl		; this is the handle for sethandlesize		ldy	|file_list_hndl+2		jsr	set_handle_size		; set the file list handle size		bcc	have_fl_h		jmp	time_to_diehave_fl_h		lda	|file_list_hndl		; dereference the file list handle		ldx	|file_list_hndl+2		jsr	deref_handle		sta	<file_list_ptr		sty	<file_list_ptr+2				ldy	|file_list_size		dey		dey		lda	#0clr_file_list		sta	[<file_list_ptr],y		dey		dey		bpl	clr_file_list				stz	|file_list_entry		stz	|current_file** End of code added for P8 switch....*fl_size_ok		pla		sta	<boot_slot** Need to determine how many generated drivers exist.* Result count of how many generated drivers is added* to the value of the transfer count on direct page.*		jsr	count_g_drvr		; count generated drivers		eject** Device list requires 8 bytes per device.  Multiply device* count by 8 before setting device list handle size.  The total* maximum number of devices that may be installed is 8190.** Each device list entry consists of:*        _________________*       |_               _|   Pointer to device's DIB*       |_               _|*       |_               _|*       |_________________|*       |_               _|   Device's dispatcher maintained diskswitch*       |_________________|*       |_               _|   Device's Driver User ID (loaded driver only)*       |_________________|*		ldy	#$0002			; set device count		lda	#$0000		sta	[<drvr_dev_ptr],y		lda	|driver_count		sta	[<drvr_dev_ptr]		jsr	calc_dev_size		; calculate device list size		jsr	put_handle_size		; save parameters for set_handle_size** Now need to set device list handle size to accomodate drivers.*		ldx	|dev_list_hndl		; this is the handle for sethandlesize		ldy	|dev_list_hndl+2		jsr	set_handle_size		; set the device list handle size		bcc	have_dev_h		jmp	time_to_diehave_dev_h		jsr	deref_dev_list		; and dereference device list handle** During loading of device drivers, the driver's User ID should* must be maintained for the first successfully loaded device* associated with a driver.  Unsuccessfully loaded devices are* purged.  If the first device is purged, the User ID must be* maintained for the next device.  This is easily done by pre* clearing the device list and only writing the User ID into the* device list during the load.*		ldy	|dev_list_size		; point at one past last entry		cpy	#$0008			; if only one device its generated		beq	clr_dev_done		; then dont clear the list		lda	#$0000clr_dev_list		dey				; point at user id of previous entry		dey		sta	[<drvr_dev_ptr],y	; init device list User ID		dey		dey		dec	a			; init device list disk switch status		sta	[<drvr_dev_ptr],y		dey		dey		inc	a			; Init device list dib pointer		sta	[<drvr_dev_ptr],y		dey		dey		sta	[<drvr_dev_ptr],y		cpy	#$000C		bne	clr_dev_listclr_dev_done** Need an ID for allocation of memory for generated driver's DIB and GDIB.*		lda	>warm_cold_flag		; is this a warm start?		bne	no_gdib_id		; yes				lda	#$3D00			; get a $3Fxx user id		jsr	get_new_id		sta	|gen_drvr_id		; save device list handle IDno_gdib_id** Now must allocate memory for generated drivers DIB's and GDIB's.**                DIB    64 bytes per driver*            +__GDIB__  12 bytes per generated driver*              TOTAL    76 bytes per generated driver** Note that loaded drivers carry their own DIB with the driver so* no additional memory allocation is required for these devices.*		pha				; space for multiply result		pha		lda	|total_gen		; number of generated drivers		bne	nofixie		inc	a			;force one as default		sta	|total_gen		; fake out number of generated driversnofixie		pha				; multiplicand = # generated drivers		pea	dib_size		; multiplier = 76 bytes per driver		_multiply		bcc	have_size		; if no error		jmp	time_to_die		; die if can't get boot volumehave_size		plx				; size for new handle		stx	|drvr_list_size		pla		stx	|handle_size		; in case sethandlesize due to warm start		sta	|handle_size+2				lda	>warm_cold_flag		; is this a warm start?		bne	warm_gdib_size		; yes				lda	|gen_drvr_id		; get device list handle ID		ldy	#$8008			; locked, fixed & no special mem		jsr	get_new_handle		stx	|gen_drvr_hndl		sty	|gen_drvr_hndl+2		bra	deref_gdib		warm_gdib_size		ldx	|gen_drvr_hndl		; resize GDIB handle on restart		ldy	|gen_drvr_hndl+2		jsr	set_handle_size		bcc	deref_gdib		jmp	time_to_diederef_gdib		jsr	deref_drv_list		; and dereference driver list handle** Need an ID for allocation of memory for supervisory driver list.*		lda	>warm_cold_flag		; is this a warm start?		bne	warm_sup_hndl				lda	#$3E00			; get a $3Exx user id		jsr	get_new_id		sta	|sup_drvr_id		; save device list handle ID** Now must allocate memory for supervisory driver list.*		lda	|sup_drvr_cnt		; size of block to create		sec		rol	a		asl	a		asl	a		tax				; size of new handle		lda	|sup_drvr_id		; User ID for new handle		ldy	#$8008			; locked, fixed & no special mem		jsr	get_new_handle		stx	|sup_drvr_hndl		sty	|sup_drvr_hndl+2warm_sup_hndl		lda	|sup_drvr_hndl		; dereferenc supervisor handle		ldx	|sup_drvr_hndl+2		jsr	deref_handle		sta	<sup_drvr_ptr		stx	<sup_drvr_ptr+2				lda	|sup_drvr_cnt		; init supervisor driver count		sta	[<sup_drvr_ptr]		lda	#$0000		ldy	#$0002		sta	[<sup_drvr_ptr],y** Now need to load all RAM LOADED DRIVERS.  As each driver is* loaded, a pointer to the driver's DIB is placed into the* device list and the device count is incremented for each device* installed into the device list*		lda	#$0002			; set device number = boot volume + 1		sta	<drvr_dev_num		stz	<post_drvr_tbl		; make sure no drivers are posted		stz	<post_drvr_tbl+2		jsr	load_drivers		; load all ram loaded drivers** Now need to generate all RAM LOADED DRIVERS.  As each driver is* generated, a pointer to the driver's DIB is placed into the* device list and the device count is incremented.  In addition, a* DIB is generated as well as a GDIB and placed into the generated* driver list.*		jsr	gen_drivers		; generate all drivers** Now must issue a startup call to each driver.  If a driver* returns an error as a result of a DRVR_STARTUP call, the* driver will be purged from the device list.*		lda	#$0001			; point at boot volume		sta	<drvr_dev_num** Update class and device id number for boot volume prior to* issuing a drvr_startup call.*		jsr	set_dib_ptr		; point at boot volume DIB		ldy	#dev_char		; is this a generated driver?		lda	[<drvr_dib_ptr],y		rol	a		rol	a		bcc	loaded_boot		; yes, dont update the DIB		ldy	#slot_num		lda	[<drvr_dib_ptr],y		xba				; need $Cn00 before identifying device		and	#$0700		ora	#$C000		sta	<fw_addr		stz	<fw_addr+2		jsr	ident_slot		; X = class		ldy	#drvr_class		; update class		txa		sta	[<drvr_dib_ptr],y		and	#$0003			; want class, not subclass		asl	a		tax		ldy	#$0001			; 1 device this slot		tya				; this is unit #1		sta	|gen_count		; name must remain .D1		jsr	(build_dib,x)		; update boot volume dib		jsr	startup_l_drvr		; startup boot device** Find first generated driver beyond the boot device and then startup* all remaining generated devices.*loaded_boot		inc	<drvr_dev_num		; search for 1st generated driverfind_g_drvr		jsr	set_dib_ptr		; point at driver DIB		ldy	#dev_char		; is this a generated driver?		lda	[<drvr_dib_ptr],y		rol	a		rol	a		bcs	dev_start_loop		; yes, startup remaining drivers!!!		inc	<drvr_dev_num		; else point at next device		lda	<drvr_dev_num		cmp	[<drvr_dev_ptr]		blt	find_g_drvr		beq	find_g_drvr		bra	startup_done		; only startup generated drivers!dev_start_loop		stz	<drvr_call_num		; force device startup call		jsl	dev_dispatcher		; issue startup call to device		inc	<drvr_dev_num		; point at next device to startup		lda	[<drvr_dev_ptr]		; get number of devices		cmp	<drvr_dev_num		; check if all devices started		bge	dev_start_loop		; loop until all devices startedstartup_done		stz	<drvr_dev_num		; restore original input parameters		stz	<drvr_tran_cnt		; no data is returned		stz	<drvr_tran_cnt+2		jsr	fix_dev_handle		; now set the device list size		lda	#no_error		sta	>dev_start_flag		clc		rtsvector_table 		jml	move_info		; $01FC70 = move routine				eject***************************************************************** The following routine returns a user ID from the miscellaneous* tool set.*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |*   |   |   |   |   |   |   |   |   |___|___|___|___|___|___|___|__  Assigned by ID manager*   |   |   |   |   |   |   |   |*   |   |   |   |   |___|___|___|__________________________________  Assigned by Application*   |   |   |   |        *   |___|___|___|__________________________________________________  Legislated by convention**	$30XX		Cannot be used*	$31XX		SCM*	$32XX		Gloader / Gquit*	$33XX		File System Translators*	$34XX		Express Loader*	$35XX		Reserved:*	$36XX		Reserved:*	$37XX		Reserved:*	$38XX		Reserved:*	$39XX		User ID for loaded device driver*	$3AXX		User ID for loaded supervisor driver*	$3BXX		Segments allocated by supervisor drivers*	$3CXX		Segments allocated by device drivers*	$3DXX		Allocated for generated DIB's*	$3EXX		Supervisory driver list*	$3FXX		Device driver list & Device Dispatcher Components** ENTRY: Call via 'JSR'*               A Reg = User ID*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = User ID*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0	if no error*			¥ ¥ 0 0 0 ¥ ¥ 1  0	if error****************************************************************get_new_id		longa	on		longi	on				pha				; space for result		pha				; nyxx ID		_getnewid		plx				; pull ID off stack		bcs	time_to_die		; die if can't get boot volume		txa		rts				eject***************************************************************** The following routine returns a handle of the length specified.*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |__  AttrBank*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |______  AttrAddr*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________  AttrPage*   |   |   |   |   |   |   |   |   |   |   |   |   |______________  AttrNoSpec*   |   |   |   |   |   |   |   |   |   |   |   |__________________  AttrNoCross*   |   |   |   |   |   |   |   |   |___|___|______________________  Reserved*   |   |   |   |   |   |   |___|__________________________________  AttrPurge*   |   |   |___|___|___|__________________________________________  Reserved*   |   |__________________________________________________________  AttrFixed*   |______________________________________________________________  AttrLocked** ENTRY: Call via 'JSR'*               A Reg = User ID*               X Reg = Size of handle (0 to 65535 bytes)*               Y Reg = Handle Attributes*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code*               X Reg = Least significant word of handle*               Y Reg = Most significant word of handle*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0	if no error*			¥ ¥ 0 0 0 ¥ ¥ 1  0	if error****************************************************************get_new_handle		longa	on		longi	on				pha			; space for result		pha		pea	$0000		; size of block is 12 bytes		phx		pha			; user ID		phy			; locked, fixed & no special mem		pea	$0000		; pointer to block		pea	$0000		_newhandle		plx			; least significant word of handle		ply			; most significant word of handle		bcc	have_new_handletime_to_die		jsl	sys_death	; return with tool errorhave_new_handle		rts		eject***************************************************************** The following routine sets the length of a locked handle.* Note that the maximum handle size is 65535 bytes.** ENTRY: Call via 'JSR'*	  handle_size =	Longword value indicating size to set handle to*               A Reg = Undefined*               X Reg = Least significant word of handle*               Y Reg = Most significant word of handle*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************set_handle_size		longa	on		longi	on				tsc		sta	|stack_address				phy				; this will be the handle to lock		phx				lda	|handle_size+2		; this will be the handle size		pha		lda	|handle_size		pha		phy				; this is the handle for sethandlesize		phx				phy				; this is the handle for hunlock		phx		_hunlock			; unlock the handle		bcs	tool_err_exit		; if can't unlock handle				_sethandlesize			; set the handle size		bcs	lock_it			; if can't resize handlelock_handle		_hlock				; and lock the handletool_err_exit		ldx	|stack_address		txs		rts		lock_it		ldx	|stack_address		; point at handle to lock		dex		dex		dex		dex		txs		_hunlock			; lock the handle		sec				; an error occurred		lda	#$02FF			; but I really dont know what it was anymore!		bra	tool_err_exit		eject***************************************************************** The following routine unlocks and purges a handle.** ENTRY: Call via 'JSR'*               A Reg = User ID of handle*               X Reg = Least significant word of handle*               Y Reg = Most significant word of handle*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************dispose_handle		longa	on		longi	on				pha				; dispose the user ID				phy				; this will be the handle to lock		phx				phy				; this is the handle for hunlock		phx		_hunlock			; unlock the handle		bcs	time_to_die		; if can't unlock handle				_disposehandle			; toss the ma'ma		bcs	time_to_die		; if can't unlock handle		_deleteid		bcs	time_to_die		; if can't unlock handle		rts		eject***************************************************************** The following routine is used to dereference the handle* for the memory segment used to maintain generated driver* DIB's and GDIB's.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0	if no error*			¥ ¥ 0 0 0 ¥ ¥ 1  0	if error****************************************************************deref_drv_list		longa	on		longi	on		lda	|gen_drvr_hndl		ldx	|gen_drvr_hndl+2		jsr	deref_handle		sta	<gen_drvr_ptr		stx	<gen_drvr_ptr+2		rts		eject***************************************************************** This routine counts the number of devices supported by all* GS/OS device drivers residing in the SYSTEM/DRIVERS* subdirectory on the boot volume.  GS/OS drivers must have* a FileType of $BB and an AuxType of $01XX.  The least* significant 6 bits of least significant byte of the AuxType* field indicate the number of devices supported by a driver.* The two most significant bits of the least significant byte* indicate the type of GS/OS driver (device driver or supervisory* driver).** AuxType: Device Driver*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |___|___|___|___|___|_ # Devices*   |   |   |   |   |   |   |   |   |   |_________________________ 0*   |   |   |   |   |   |   |   |   |_____________________________ 0*   |___|___|___|___|___|___|___|_________________________________ = %00000001** AuxType: Supervisory Driver*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |___|___|___|___|___|_ 0*   |   |   |   |   |   |   |   |   |   |_________________________ 1*   |   |   |   |   |   |   |   |   |_____________________________ 0*   |___|___|___|___|___|___|___|_________________________________ = %00000001** AuxType: Boot Driver*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |___|___|___|___|___|_ = %000001*   |   |   |   |   |   |   |   |   |   |_________________________ 0*   |   |   |   |   |   |   |   |   |_____________________________ 1*   |___|___|___|___|___|___|___|_________________________________ = %00000001** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************count_l_drvr		longa	on		longi	on** Get the boot volume.*		_get_boot_vol d_boot_vol_list		bcc	open_drvr_file		jmp	time_to_die		; die if can't get boot volume** Open '/BOOT/SYSTEM/DRIVERS/'*open_drvr_file		lda	#64			; set buffer length		sta	|boot_vol_name		sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off		ldx	|boot_vol_str		; append 'SYSTEM/DRIVERS'		inx		ldy	#0append_str		lda	|sys_drivers,y		sta	|boot_vol_str+1,x		inx		iny		cpy	#$0E		bne	append_str		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on		dex		stx	|boot_vol_str		; don't forget to set the string length		jsr	do_my_open		; open driver file		bcc	it_opened		jmp	no_loaded_drvrs		; if no driversit_opened		lda	|d_open_ref_num		sta	|dir_ref_num		sta	|d_close_ref_num** Get directory entry with base and displacement values* set to zero to return the number of entries in the DRIVERS* subdirectory.*		jsr	set_dir_base		; GET_DIR_ENTRY (base=disp=0)		bcs	no_drivers		; if cant count drivers		lda	|dir_entry_num		; save number of entries in directory		beq	no_drivers		; if no drivers** Get directory entries for each file in the DRIVERS subdirectory.* If a file has a FileType of $BB and an AuxType of $01XX then* add the least significant six bits of the AuxType to the current* driver count.  Loop until all directory entries in the DRIVER* subdirectory have been examined.*get_entry_loop		jsr	next_entry		; GET_DIR_ENTRY		bcs	no_drivershave_drvr_cnt		lda	|dir_entry_ft		; is file type $BB?		and	#$00FF		cmp	#$00BB		bne	not_a_driver		; no				lda	|dir_entry_aux		; is aux type $01XX?		and	#$FF00		cmp	#$0100		bne	not_a_driver		; no				lda	|dir_entry_aux		; is it a device driver?		and	#$00C0		beq	device_drvr		; yes				cmp	#$0040			; is it a supervisory driver?		bne	not_a_driver		; no				inc	|sup_drvr_cnt		; yes, increment supervisor count				lda	>warm_cold_flag		; is this a warm start?		bne	not_a_driver		; yes				inc	|file_list_cnt		; and file count		bra	not_a_driverdevice_drvr		lda	|dir_entry_aux		; else add XX to driver count		and	#$003F		clc		adc	|driver_count		sta	|driver_count		lda	>warm_cold_flag		; is this a warm start?		bne	not_a_driver		; yes		inc	|file_list_cnt		; and file count		not_a_driver		bra	get_entry_loop		; loop until no more entriesno_drivers		jsr	do_my_close		; close /boot/system/drivers		bcc	no_loaded_drvrs		jmp	time_to_die		; die if can't get boot volumeno_loaded_drvrs		rts		eject***************************************************************** This routine is used to count the number of generated* drivers to be loaded.  The number of device drivers* is added to the current contents of DRVR_TRAN_CNT.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************count_g_drvr		longa	on		longi	on		lda	#$000F		; initial slot is 15 (7 external)		sta	|gen_slot_num		count_g_loop		lda	|gen_slot_num	; request the slot		jsl	dyn_slot_arbiter		bcs	next_g_slot	; if slot was not available		lda	|gen_slot_num	; create $Cn00 pointer		xba		and	#$0700		ora	#$C000		sta	<fw_addr		stz	<fw_addr+2				jsr	ident_slot	; identify device in slot		pha		clc			; adjust total driver count		adc	|driver_count		sta	|driver_count		pla			; adjust generated driver count		clc		adc	|total_gen		sta	|total_gennext_g_slot		dec	|gen_slot_num	; next slot to search		bne	count_g_loop		dec	|total_gen	; boot volume already exists		rts		eject***************************************************************** This routine is used to identify the device in a slot.** ENTRY:        fwaddr  = (lw) base address of slot to identify*               A Reg   = Undefined*               X Reg   = Undefined*               Y Reg   = Undefined*             Dir Reg   = GS/OS Direct Page*               B Reg   = Current bank executing in*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg   = Number of devices this slot*               X Reg   = Device Type (0,1 or 2 where 0 includes subtype)*               Y Reg   = Undefined*             Dir Reg   = GS/OS Direct Page*               B Reg   = Current bank executing in*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0	if no error*			¥ ¥ 0 0 0 ¥ ¥ 1  0	if error****************************************************************ident_slot		longa	on		longi	on		sep	#$30		; 8 bit 'm' & 'x'		longa	off		longi	off		stz	<fw_addr	; make sure it's $Cn00		ldy	#$05		; point at signature in rom		ldx	#$00		; point at signature listchck_pro_sig		lda	[<fw_addr],y	; check signature bytes		cmp	pro_sig,x	; is it ProDOS/SmartPort		bne	check_pascal	; no		dey			; point at next signature in rom		dey		inx			; point at next signature in list		cpx	#$03		; done all ProDOS signatures?		bne	chck_pro_sig	; no		ldy	#$07		; point at signature in rom		lda	[<fw_addr],y	; is it a SmartPort peripheral?		bne	check_prodos	; no		eject***************************************************************** Got here if it's a SmartPort device.  Need to make a status call* to unit 0 to determine number of devices.  Must execute the* stack futz, switch to emulation mode, place a SmartPort unit* zero status call in bank 0, execute the call and unfutz the* stack.****************************************************************		longa	off		longi	off*  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | SmartPort Type ID ($CnFB)* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |__ RAM Card*   |   |   |   |   |   |   |______ SCSI Interface Card*   |   |   |   |   |   |__________ Reserved (must be 0)*   |   |   |   |   |______________ Reserved (must be 0)*   |   |   |   |__________________ Reserved (must be 0)*   |   |   |______________________ Reserved (must be 0)*   |   |__________________________ Interface Supports Super Calls*   |______________________________ Interface Supports Extended Calls*		ldy	#$FB		; get SmartPort ID Type		lda	[<fw_addr],y		and	#%00000010		php				ldy	#$FF		; calculate SmartPort entry point		lda	[<fw_addr],y		clc		adc	#$03		sta	<fw_addr		plp			; is this a SCSI device?		rep	#$30		; 16 bit 'm' & 'x'		longa	on		longi	on		bne	it_is_a_scsi	; if SCSI install one device		jsr	setup_sp_stat	; setup for smartport status call		jsl	b0_core		; execute unit 0 status call		bcs	no_device	; no device if error returned		lda	>sys_buffer	; else get number of devicesset_sp_class		ldx	#$0001		; driver class = 1		jmp	g_search_doneit_is_a_scsi		jsr	setup_sp_stat	; setup for smartport status call		jsl	b0_core		; execute unit 0 status call		bcs	no_device	; no device if error returned		lda	>sys_buffer	; if no devices		beq	set_sp_class		lda	#$0001		; SCSI is always one device		bra	set_sp_class		eject***************************************************************** Got here if it's a ProDOS device.  Assume at least one device.* If configuration ram is set, determine if a second device is* present and update the count as appropriate.  No driver will* be generated for DISK][ devices.  These devices will not be* tallied by this routine.****************************************************************check_prodos		longa	off		longi	off				ldx	#$00		; driver class = 0, subclass = 0		ldy	#$FF		; point at entry offset byte		lda	[<fw_addr],y	; is it a 16 sector DISK][?		sta	<fw_addr	; set entry point		beq	g_search_done	; yes				inc	a		; is it a 13 sector DISK][?		beq	g_search_done	; yes				lda	#$02		; assume 2 devices per slot for now		bra	g_search_done		eject***************************************************************** It's not ProDOS or SmartPort so need to determine* if it's Pascal1.1****************************************************************check_pascal		longa	off		longi	off				ldy	#$05		; point at signature in rom		ldx	#$00		; point at signature listchck_p_sig		lda	[<fw_addr],y	; check signature bytes		cmp	pascal_sig,x	; is it Pascal1.1		bne	check_basic	; no				iny			; point at next signature in rom		iny		inx			; point at next signature in list		cpx	#$02		; done all Pascal signatures?		bne	chck_p_sig	; no				ldy	#$0B		; point at last signature		lda	[<fw_addr],y	; check signature bytes		cmp	pascal_sig,x	; is it Pascal1.1		bne	check_basic	; no** It's a Pascal1.1 device.  Need to know if it is one of the* following Pascal1.1 device types:**               Printer*               Serial*               Modem*               80 Column*               Network / Bus*		iny			; point at signature in rom		lda	[<fw_addr],y	; check signature bytes		and	#$F0		; most significant nibble only relevantchck_p_type		cmp	pascal_sig,x	; is it a legal device?		beq	legal_pascal	; yes				inx			; point at next signature in list		cpx	#$08		; done all Pascal1.1 types?		bne	chck_p_type	; no		bra	no_devicelegal_pascal		lda	#$01		; if legal, mark 1 device		ldx	#$80		; driver class = 0, subclass = 1		bra	g_search_done		eject***************************************************************** Got here if it is not a Pascal1.1 device.  Need to determine* if a rom resides in the slot to make an educated guess about* the existance of a BASIC device.****************************************************************check_basic		ldy	#$00		; check rom		tyx		lda	[<fw_addr],y		beq	g_search_done	; if initialization entry is a BRK				inc	a				beq	g_search_done	; if initialization entry is a SBC LONG,X				dec	a		; restore A = ROM contents ($Cn00)basic_rom_chk		cmp	[<fw_addr],y	; check rom		bne	no_device				dex		bne	basic_rom_chk				lda	#$01		; rom appears stable, set 1 device		ldx	#$80		; driver class = 0, subclass = 1		bra	g_search_doneno_device		sep	#$20		; 8 bit 'm'		longa	off				lda	#$00		; no device this slotg_search_done		rep	#$30		; 16 bit 'm' and 'x'		longa	on		longi	on				and	#$007F		; maximum is 127 per slot		rts		eject***************************************************************** This routine sets up the bank 0 dispatcher with a standard* SmartPort status call to unit 0 with a status code of 0.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = 0=m=x=e** EXIT:         A Reg = Last byte of parameter list*               X Reg = Address of SmartPort command*               Y Reg = Address of parameter list+7*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = 0=m=x=e****************************************************************setup_sp_stat		longa	on		longi	on		lda	>call_list_ptr	; get address where command resides		tax		lda	#$0000		; set command = status call		sta	>0,x		lda	#param_list_ptr	; set parameter list pointer		sta	>1,x		tay		lda	#$EAEA		; 2 nop instructions		sta	>3,x		phx		tyx			; point into the parameter list		sep	#$20		; 8 bit 'm'		longa	off		ldy	#sp_unit0	; point at parameter listsetup_unit0		lda	|0,y		; move parameter list to bank 0		sta	>0,x		inx		iny		cpy	#sp_unit0+7		bne	setup_unit0		plx		rts		eject***************************************************************** The following routine dereferences the device list handle and* stores the resulting pointer on GS/OS direct page.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS Direct Page*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Unchanged*             Dir Reg = GS/OS Direct Page*        DRVR_DEV_PTR = Now points at device list*            Bank Reg = Current bank executing in*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0***************************************************************deref_dev_list		longa	on		longi	on		ldx	|dev_list_hndl+2	; get file handle		lda	|dev_list_hndl		jsr	deref_handle		; dereference the handle		sta	<drvr_dev_ptr		; set pointer on direct page		sty	<drvr_dev_ptr+2		rts		eject******************************************************************* This routine optains the DIB pointer for the device specified* by the current DRVR_DEV_NUM from the device list to set the* DRVR_DIB_PTR on GS/OS direct page.*                  __________________*           $0000 |_                _|   ... Number of devices*           $0001 |_                _|*           $0002 |_                _|*           $0003 |__________________|*           $0004 |_                _|   ... Pointer to device #1 DIB*           $0005 |_                _|*           $0006 |_                _|*           $0007 |__________________|*           $0008 |_                _|   ... Device #1 disk switched status*           $0009 |__________________|*           $000A |_                _|   ... Device #1 User ID*           $000B |__________________|*           $000C |_                _|   ... Pointer to device #2 DIB*           $000D |_                _|*           $000E |_                _|*           $000F |__________________|*           $0010 |_                _|   ... Device #2 disk switched status*           $0011 |__________________|*           $0012 |_                _|   ... Device #2 User ID*           $0013 |__________________|*           $0014  ...** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			x x 0 0 0 x x x  ** EXIT:         A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*        DRVR_DIB_PTR = Now points at DIB for current DRVR_DEV_NUM*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************set_dib_ptr		longa	on		longi	on		pha		phy		php		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on		lda	<drvr_dev_num		; device number to set DIB pointer for		dec	a			; calculate index into device list		sec		rol	a		asl	a		asl	a		tay		lda	[<drvr_dev_ptr],y	; set the DIB pointer		sta	<drvr_dib_ptr		iny		iny		lda	[<drvr_dev_ptr],y		sta	<drvr_dib_ptr+2		plp		ply		pla		rts		eject**************************************************************** This routine is used to load and install all RAM LOADED* DRIVERS.  After each driver is loaded, it is installed* into the device list.  A DRVR_STARTUP call will be issued* to each driver.  If a driver returns an error, the driver* will be purged from the device list.** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************load_drivers		longa	on		longi	on		pei	<boot_slot	; preserve for driver generation		lda	#$0001		; 1st supervisor is supervisor #1		sta	[<sup_drvr_ptr]		jsr	do_my_open	; open '/boot/system/drivers'		bcs	no_l_drivers				lda	|d_open_ref_num	; save reference number for close		sta	|d_close_ref_num		jsr	set_my_prefix	; set_prefix to /boot/system/drivers		bcs	no_l_drivers				jsr	load_supervisor	; load supervisory drivers		jsr	load_dev_driver	; load device driversno_l_drivers		_get_boot_vol d_boot_vol_list		jsr	set_my_prefix	; set prefix back to boot vol		jsr	do_my_close	; close '/boot/system/drivers'		lda	|load_device	; prepare to generate drivers		sta	<drvr_dev_num		pla		sta	<boot_slot		rts		eject******************************************************************* Get directory entries for each file in the DRIVERS subdirectory.* If a file has a FileType of $BB and an AuxType of $0140 then* the driver is a supervisory driver and will be loaded and started.** All drivers are of a FileType of $BB.  GS/OS Device drivers* use a AuxType of $01XX for active drivers or $81XX for any* inactive drivers.  The least significant 6 bits of the least* significant byte of the AuxType indicates the number of* devices supported by the driver.*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   | Supervisory* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | Drivers:* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |___|___|___|___|___|__ %xxxxxxxx*   |   |   |   |   |   |   |   |   |   |__________________________ 1*   |   |   |   |   |   |   |   |   |______________________________ 0*   |___|___|___|___|___|___|___|__________________________________ %00000001** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************load_supervisor		longa	on		longi	on		jsr	set_dir_base		; prepare to walk driver directory		lda	#$0001		sta	[<sup_drvr_ptr]		; init 1st supervisory load number		lda	|sup_drvr_cnt		bne	sup_entry_loop** Supervisor driver count pointed at next entry to be loaded.  Since* there was no entry to be loaded, the correct driver count is the* current count-1.*no_sups 		lda	[<sup_drvr_ptr]		dec	a		sta	[<sup_drvr_ptr]		rts** Each GET_DIR_ENTRY call will automatically advance through the* /boot/system/drivers/ directory.  Walk directory checking the* filetype and auxtype for GS/OS supervisory drivers.*sup_entry_loop		jsr	next_entry		; GET_DIR_ENTRY		bcs	no_sups			; ** REVISED v0.07a02				jsr	check_filetype		; is it filetype $BB?		bne	sup_entry_loop		; no, try the next file		cmp	#$0140			; is this a supervisory driver?		bne	sup_entry_loop		; no		eject** Driver is a supervisory driver.  Load and install the supervisory* driver into the supervisory driver list.  A header must reside at* the load address of the supervisory driver after an initialload2* has been executed to bring in the supervisory driver.  The structure* of this header is seen below:*                ____________________*       +$0000  |_                  _|*               |_    Supervisor    _|*               |_   Driver Entry   _|*               |____________________|*       +$0004  |_    Supervisor    _|*               |_________ID_________|*       +$0006  |_    Supervisor    _|*               |_______Version______|*       +$0008  |_                  _|*               |_    Supervisor    _|*       +$000A  |_   Name Pointer   _|*               |____________________|*       +$000C  |_  Characteristic  _|*               |____________________|*       +$000E  |_     Reserved     _|*               |____________________|*		sec				; flag that load is a supervisor driver		jsr	do_file_load		; and load the driver** Install the supervisor into the supervisor list and start it.*                _____________________  _*   +$0000      |_                   _|  |*               |_ Supervisor Driver _|  |_ Device list entry count*               |_       Count       _|  |*               |_____________________| _|*   +$0004      |_                   _|  |*               |_   Entry pointer   _|  |*               |_   in supervisor   _|  |*               |_____________________|  |_ Supervisory driver entry*   +$0008      |_   Supervisor ID   _|  |*               |_____________________|  |*   +$000A      |_      User ID      _|  |*               |_____________________| _|*		bcs	sup_entry_loop		; if cannot load supervisor				lda	[<sup_drvr_ptr]		; get current supervisor number		sta	|cur_sup		; set in case purge is neccessary		jsr	set_sup_index				lda	|temp_user_id		; set supervisor's USER ID		sta	[<sup_drvr_ptr],y				jsr	y_minus_6		; point at SIB pointer		lda	|temp_load_addr		; set SIB pointer in list and dp		sta	[<sup_drvr_ptr],y		sta	<sib_ptr		iny		iny		lda	|temp_load_addr	+2		sta	[<sup_drvr_ptr],y		sta	<sib_ptr+2				phy		ldy	#sib_id			; SIB ID Number (SIB index)		lda	[<sib_ptr],y		tyx		ply				; and install in supervisor list		iny		iny		sta	[<sup_drvr_ptr],y				sta	|cur_sib_id		; save for duplicate check		txy		iny		iny		lda	[<sib_ptr],y		; get supervisor version #		sta	|cur_sib_ver		; save for duplicate check** Obtain the supervisor restart flag and install into the device* dispatcher file list structure.*		ldy	#sib_char		; get supervisor characteristics		lda	[<sib_ptr],y		jsr	set_restart** Now that supervisory driver is loaded, issue a supervisor_startup* call.  If supervisory driver returns an error as a result of the* startup call, load next supervisor over this position.*		lda	[<sup_drvr_ptr]		; get current startup supervisor		ldx	#$0000			; startup call		jsl	sup_drvr_disp		; call supervisory driver		bcc	dont_unload_sup		; if no error on startup** Supervisor driver couldnot startup.  Unload segment and purge* memory for this supervisory driver.*		dec	|current_file		; next file list entry will be at same as current		lda	|cur_sup		; go NUKE that supervisor driver		jsr	purge_sup		bra	sup_entry_loop** Now check to see if this is a duplicate supervisory driver.* The check is based on the supervisor ID only.  If a duplicate* is found then the highest version supervisor will be kept.* In the case of duplicate version numbers, the first supervisor* loaded will be kept.*dont_unload_sup 		lda	[<sup_drvr_ptr]		; point at previous supervisor ?????		sta	|cur_supunload_sup_loop		dec	|cur_sup		; decrement counter		beq	no_other_sup		; if only 1 supervisor loaded		lda	|cur_sup		; get the supervisor number		jsr	set_sib_ptr		; point at previous SIB		ldy	#sib_id			; is this a duplicate SIB?		lda	[<sib_ptr],y		cmp	|cur_sib_id		bne	unload_sup_loop		; no		ldy	#sib_ver		; is this a higher version SIB?		lda	[<sib_ptr],y		cmp	|cur_sib_ver		blt	keep_cur_sib** The new SIB is a lower or equal version.  In this case it must be* shutdown and purged.*		dec	|current_file		; next file list entry will be at same as current		lda	[<sup_drvr_ptr]		sta	|cur_sup		jsr	shutdn_sup		; shutdown & purge supervisor		jmp	sup_entry_loop** The new supervisor is a duplicate of a higher version of this supervisor.* The old supervisor must be shutdown and purged.*keep_cur_sib		lda	|cur_sup		; supervisor number		jsr	shutdn_sup		; shutdown & purge supervisor		lda	[<sup_drvr_ptr]		; get SIB list info to swap		jsr	set_sup_index		ldx	#$0003sib_swap_loop0 		lda	[<sup_drvr_ptr],y		pha				; save SIB addr, user id & type		dey		dey		dex		bpl	sib_swap_loop0		lda	|cur_sup		jsr	times_8_plus_4		; make index to list entry		ldx	#$0003sib_swap_loop1 		pla		sta	[<sup_drvr_ptr],y		iny		iny		dex		bpl	sib_swap_loop1		jmp	sup_entry_loop** If driver loaded and started correctly then point at next entry* to be loaded.*no_other_sup 		lda	[<sup_drvr_ptr]		inc	a		sta	[<sup_drvr_ptr]** Check if all entries in the /boot/system/drivers/ directory have* been checked as being a supervisory driver.  If unchecked entries* remain in the directory, loop to check remaining entries.*not_sup_drvr 		jmp	sup_entry_loop		; yes		eject******************************************************************* This routine calculates an index into the supervisory driver* list for the supervisory driver specified in the A register.** ENTRY: via a 'JSR'*               A Reg = Supervisory driver number*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*               A Reg = Index to supervisory driver's User ID entry*               X Reg = Unchanged*               Y Reg = Index to supervisory driver's User ID entry*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************set_sup_index		longa	on		longi	on		dec	a		; point at supervisor user id		asl	a		asl	a		asl	a		clc		adc	#$000A		tay		rts		eject******************************************************************* Now that supervisory drivers are loaded, reset parameters for* get_dir_entry to start at top of directory and load GS/OS device* drivers.  All drivers are of a FileType of $BB.  GS/OS Device* drivers use a AuxType of $01XX for active drivers or $81XX for* any inactive drivers.  The least significant 6 bits of the least* significant byte of the AuxType indicates the number of* devices supported by the driver.*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   | Device* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | Drivers:* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |___|___|___|___|___|__ DIB count*   |   |   |   |   |   |   |   |   |   |__________________________ 0*   |   |   |   |   |   |   |   |   |______________________________ 0*   |___|___|___|___|___|___|___|__________________________________ %00000001** The device driver list consists of a longword count specifying the* number of devices followed by an four word entry for each device* consisting of a longword pointer to the device's DIB, a disk switched* status word and a memory USER ID word.*                ____________________  _*       +$0000  |_                  _|  |*               |_     Number of    _|  |_ Driver list entry count*               |_  Device Drivers  _|  |*               |____________________| _|*       +$0004  |_                  _|  |*               |_      Pointer     _|  |*               |_      to DIB      _|  |*               |____________________|  |_ Device driver entry (8 bytes)*       +$0008  |_    Disk Switch   _|  |*               |____________________|  |*       +$000A  |_      USER ID     _|  |*               |____________________| _|** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************load_dev_driver		longa	on		longi	on		jsr	set_dir_base		; to reset to top of directory		bcc	drvr_entry_loopno_dev_drvrs		jmp	no_dev_drivers** Get_dir_entry list is now at top of directory.  Ok to check next* directory entry for GS/OS device driver type & auxtype prior to* loading driver.*drvr_entry_loop		jsr	next_entry		; GET_DIR_ENTRY		bcs	no_dev_drvrs		jsr	check_filetype		; is file type $BB (GS/OS driver)?		bne	drvr_entry_loop		; no		cmp	#$0100			; is it a device driver?		bne	drvr_entry_loop		; no** File is a driver.  Call the system loader to bring in the* driver file then issue a startup call to each device supported* by the driver.  If all devices return errors as a result of the* startup call then unload the driver.*		lda	|start_count		; any drivers to startup?		beq	drvr_entry_loop		; nomany_dibs		stz	|purge_flag		; driver not started successfully yet.		clc				; flag that load is a device driver		jsr	do_file_load		; and load the driver** Install the driver into the device list and startup the driver.*		php				; save any tool error		lda	|load_device		sta	<drvr_dev_num		jsr	set_dev_index		; set device list pointer		plp		tyx		jsr	y_plus_6		; point at User ID		lda	|temp_user_id		; set device user ID		sta	[<drvr_dev_ptr],y		sta	|cur_user_id		txy				; point at DIB pointer		lda	|temp_load_addr		; point at driver		sta	<drvr_dib_ptr		lda	|temp_load_addr+2		sta	<drvr_dib_ptr+2		bcs	drvr_entry_loop** Now that we know where the file loaded, walk all the DIB's* and install each device supported by the driver into the* device list.  Each driver must support the following header:**         _________________* +$0000 |_               _| ... Offset to 1st DIB*        |_________________|* +$0002 |_               _| ... Number of devices*        |_________________|* +$0004 |_               _| ... Offset to 1st control parameter list*        |_________________|* +$0006 |_               _| ... Offset to 2nd control parameter list*        |_________________|*        etc...*		clc				; caclulate pointer to 1st DIB		lda	[<drvr_dib_ptr]		; offset + load addr = DIB addr		adc	<drvr_dib_ptr		tax		lda	#$0000		adc	<drvr_dib_ptr+2		sta	<drvr_dib_ptr+2		; set DIB addr		stx	<drvr_dib_ptr		pha				; insert DIB pointer in device list		txa		sta	[<drvr_dev_ptr],y		iny		iny		pla		sta	[<drvr_dev_ptr],y** Startup driver and check for duplicates.*		jsr	startup_l_drvr		; startup & check for dupes		dec	|dib_count		; so we dont load to many		bcc	next_link		; if no dupe then walk link ptrs		dec	|load_device		; next device at this position		bne	next_link		; if more dibs this driver ** v0.12a01		jsr	set_dev_restart		; insert startup flag in file list structure		inc	|load_device		; else point at current entry		bra	check_purge** Insert any linked DIB's into the device list.*next_link		jsr	set_dev_restart		; insert startup flag in file list structure		phy				; insert device number in file list structure		ldy	#dib_dev_num		lda	[<drvr_dib_ptr],y		ply		iny		iny		sta	[<file_entry_ptr],y				inc	|load_device		; next loaded device		lda	|load_device		sta	<drvr_dev_num** If link pointer in DIB is NIL then no more devices to install.* If not NIL then need to continue installing devices if the DIB* count does not exceed the number of DIB's that was indicated* by the driver file's auxtype.*		ldy	#link_ptr+2		; is there a linked DIB?		lda	[<drvr_dib_ptr]		tax		ora	[<drvr_dib_ptr],y		beq	check_purge		; no (v0.05 a09)		lda	|dib_count		; done as many as specified in auxtype?		beq	check_purge		; if no more should it be purged** The link field in the DIB was not NIL.  Need to create an entry* in the device list for the linked DIB.*		lda	[<drvr_dib_ptr],y		pha		phx		jsr	set_dev_index		; point at DIB entry in device list		pla				; and insert DIB entry		sta	[<drvr_dev_ptr],y		tax		iny		iny		pla		sta	[<drvr_dev_ptr],y		jsr	y_plus_4		stx	<drvr_dib_ptr		; initialize DIB pointer		sta	<drvr_dib_ptr+2		lda	|cur_user_id		; and insert USER ID in device list		sta	[<drvr_dev_ptr],y** Startup driver and check for duplicates.*		jsr	startup_l_drvr		; startup & check for dupes		dec	|dib_count		bcc	next_link		; if no error walk DIBs		dec	|load_device		; else next device in this position		bra	next_linkno_dev_drivers		rtscheck_purge		lda	|purge_flag		; should driver be purged?		bne	to_drvr_entry		; no				lda	|cur_user_id		; else prepare to purge		jsr	purge_driverto_drvr_entry		jmp	drvr_entry_loop		set_dev_restart		ldy	#dev_char		; insert startup flag in file list structure		lda	[<drvr_dib_ptr],y		asl	a		asl	a		asl	a		asl	a		jmp	set_restart		eject******************************************************************* The following routine sets the base and displacement for* subsequent get_dir_entry calls to the top of the directory* in preperation for walking the directory.  The second entry* point is used to walk the directory.** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************set_dir_base		longa	on		longi	on		lda	>warm_cold_flag		; is this a warm start?		beq	cold_dir_base		; no		stz	|current_file		; on warm start, point at base of file entry list		clc		rtscold_dir_base		stz	|dir_entry_base		; to reset to top of directory		stz	|dir_entry_disp		bra	make_the_call				eject******************************************************************* The following routine sets the base and displacement for* subsequent get_dir_entry calls to the top of the directory* in preperation for walking the directory.  The second entry* point is used to walk the directory.** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************next_entry         		longa	on		longi	on				lda	>warm_cold_flag		; is this a warm start?		beq	cold_next_entry		; no				inc	|current_file		; reference next file list entry		lda	|current_file		; is the next entry valid?		cmp	|file_list_cnt		blt	get_file_entry		; yes		beq	get_file_entry		; yes		sec				; no, return an error if past end of list		rtsget_file_entry		jsr	calc_file_index		; point at current file entry		ldy	#file_auxtype		lda	[<file_entry_ptr]	; return filetype like get_dir_entry call		sta	|dir_entry_ft		lda	[<file_entry_ptr],y	; return auxtype like get_dir_entry call		sta	|dir_entry_aux		ldy	#file_name		; return filename like get_dir_entry call		ldx	#0xfer_name		lda	[<file_entry_ptr],y		sta	|file_name_str,x		iny		iny		inx		inx		cpx	#32			; always copy 32 bytes regardless of real length		blt	xfer_name		clc		rts		cold_next_entry		lda	#$0001			; base & displacement for next directory entry		sta	|dir_entry_base		sta	|dir_entry_dispmake_the_call		_get_dir_entry dir_entry_list		rts		eject******************************************************************* The following routine executes the initial load of a supervisor* or device driver.** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0	load a device driver*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0	load a supervisor driver** EXIT:  via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************do_file_load		longa	on		longi	on		php				; save carry (device vs. supervisor flag)		lda	>warm_cold_flag		; is this a warm start?		beq	do_cold_load		; no		jsr	find_file		; find file in file list		bcs	do_cold_load		; now found in list, load from disk		do_mem_load*		ldy	#file_auxtype		; set up carry in case need to load from disk*		lda	[<file_entry_ptr],y*		xba*		rol	a*		rol	a		ldy	#file_restart		; is driver restartable from memory		lda	[<file_entry_ptr],y		beq	do_cold_load		; no, go get it from disk		plp				; clean up stack (carry not used)		ldy	#file_user_id		; user ID of memory resident driver		lda	[<file_entry_ptr],y		sta	|temp_user_id				ldy	#file_load_addr		; load address of memory resident driver		lda	[<file_entry_ptr],y		sta	|temp_load_addr		iny		iny		lda	[<file_entry_ptr],y		sta	|temp_load_addr+2		clc				; never return an error if loading from memory		rts		do_cold_load		plp				; retrieve carry		pha				; space for dir.page/stack size		pha				; space for dir.page/stack addr		pha				; space for starting address		pha		pha				; space for ID		lda	#$3900			; assume device driver		bcc	have_ld_id		; assumed correctly		lda	#$3A00			; ID to be assigned by loader for supervisor driverhave_ld_id		pha				; put desired ID on stack		pea	file_name_str>>16		pea	file_name_str		pea	$0001			; NO SPECIAL MEMORY!!!		pea	$0001			; class 1 pathname string		_InitialLoad2		ply				; save driver user ID		sty	|temp_user_id		ply				; save driver load address		plx		sty	|temp_load_addr		stx	|temp_load_addr+2		ply				; dir. page / stack address		plx				; dir. page / stack size		bcs	no_file_entry		; if error, dont create file list entry		lda	>warm_cold_flag		; is this a warm start?		bne	refresh_list		; yes, only update current file list entry** GET_DIR_ENTRY should have already aquired the filetype and auxtype.* Just set the pointer to the file entry and store all the parameters* into the entry.*		inc	|current_file		; on cold start point at next entryrefresh_list		lda	|current_file		jsr	calc_file_index				lda	|temp_filetype		; install filetype in file list entry		sta	[<file_entry_ptr]				ldy	#file_auxtype		; install auxtype in file list entry		lda	|temp_auxtype		sta	[<file_entry_ptr],y				ldy	#file_user_id		; install user ID in file list entry		lda	|temp_user_id		sta	[<file_entry_ptr],y				ldy	#file_load_addr		; install load address in file list entry		lda	|temp_load_addr		sta	[<file_entry_ptr],y		iny		iny		lda	|temp_load_addr+2		sta	[<file_entry_ptr],y				ldy	#file_name		ldx	#file_name_strinsert_name		lda	|0,x		sta	[<file_entry_ptr],y		inx		inx		iny		iny		cpy	#file_restart		bne	insert_name		clc** NOTE: the routine that called the DO_FILE_LOAD must initialize the restartable* flag and dev_num flag entries in the file list.*no_file_entry		rts		set_restart		ldy	#file_restart		and	#$8000		sta	[<file_entry_ptr],y		rtstemp_load_addr	dc.l	0			; load address of drivertemp_user_id	dc.w	0			; driver user idtemp_filetype	dc.w	0			; driver filetypetemp_auxtype	dc.w	0			; driver auxtype		eject******************************************************************* The following routine checks the current filetype for use* as either a GS/OS device driver or supervisory driver.** ENTRY: via a 'JSR'*        dir_entry_ft = FileType of current driver file*       dir_entry_aux = AuxType of current driver file*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*          |dib_count = AuxType ANDed with $003F*               A Reg = AuxType ANDed with $FFC0*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x      0*                                   x x      Set by filetype compare******************************************************************check_filetype		longa	on		longi	on		lda	|dir_entry_ft	; is file type $BB (GS/OS driver)?		sta	|temp_filetype		and	#$00FF		cmp	#$00BB		php		lda	|dir_entry_aux	; prepare for auxtype checking		sta	|temp_auxtype		pha		and	#$003F		sta	|dib_count	; preserve dib count if neccessary		sta	|start_count		pla		and	#$FFC0		plp		rts		eject******************************************************************* The following routine sets prefix 0 to the pathname passed* in the prefix list.******************************************************************set_my_prefix		longa	on		longi	on		_set_prefix set_prefix_list		rts******************************************************************* The following routine opens the pathname passed in the* open list.******************************************************************do_my_open		longa	on		longi	on		lda	>warm_cold_flag		; is this a warm start?		beq	cold_open		; no				ldx	|file_list_hndl		; yes, lock the file list handle		ldy	|file_list_hndl+2		phy		phx		_hlock		bcc	warm_open		jmp	time_to_diewarm_open		lda	|file_list_hndl		; dereference the file list handle		ldx	|file_list_hndl+2		jsr	deref_handle		sta	<file_list_ptr		sty	<file_list_ptr+2		clc		rtscold_open					; open /SYSTEM.DISK/SYSTEM/DRIVERS		_open	d_open_list		rts******************************************************************* The following routine closes the pathname passed in the* close list.******************************************************************do_my_close		longa	on		longi	on		lda	>warm_cold_flag		; is this a warm start?		beq	cold_close		; no				ldx	|file_list_hndl		; yes, unlock the file list handle		ldy	|file_list_hndl+2		phy		phx		_hunlock		bcc	warm_close		jmp	time_to_diecold_close					; close /SYSTEM.DISK/SYSTEM/DRIVERS		_close	d_close_listwarm_close		rts		eject******************************************************************* The following routines were implemented strictly for code* reduction.******************************************************************y_plus_6		longi	on				iny		inyy_plus_4		iny		iny		iny		iny		rtsy_minus_6		longi	on				dey		deyy_minus_4		dey		dey		dey		dey		rts		eject****************************************************************** This routine is used to startup a loaded driver and check* that the driver is not a duplicate entry.  If a duplicate,* the device with the highest version number will be kept.* In the case of duplicate version number, the last loaded* device will be deleted.  Deletion of a device includes a* shutdown call to the driver prior to purging the driver.* Duplicate checking starts at one device below the currrent* device specified by DRVR_DEV_NUM and concludes with the* boot device.** ENTRY: Call via 'JSR'*        drvr_dev_num = Device number of current device*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0  If device is not a duplicate*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0  If device is a duplicate*****************************************************************startup_l_drvr		longa	on		longi	on** Insert the device number in the DIB for startup.*		ldy	#dib_dev_num		lda	<drvr_dev_num		sta	[<drvr_dib_ptr],y		sta	|cur_dev_num	; needed in case startup fails** Issue a startup call to the device.  If it cant start then* the DIB contents are not valid and the device should be purged.*		stz	<drvr_call_num		jsl	dev_dispatcher	; issue startup call to device		bcc	dup_chk		; if startup succeeded check for dups		rtsdup_chk_done		inc	|purge_flag	; started successfully		lda	|cur_dev_num	; restore dib pointer to current device		sta	<drvr_dev_num		jsr	set_dib_ptr		rts** This routine will check for duplicate devices.  A check by slot and unit* is attempted first.  If the slot & unit are unique, the name is checked to* verify that it is unique.  If either the slot & unit or the name is detected* as a duplicate then the version number is checked.  The lowest version* device (or last loaded if version numbers match) is shutdown and purged.*dup_chk		jsr	copy_cur_name	; copy current DIB info for dup check		clcdup_chk_loop		dec	<drvr_dev_num	; point at previous device		beq	dup_chk_done	; if no more devices		jsr	set_dib_ptr	; point at dup check dib		jsr	slot_unit_chk	; check for dup slot & unit		bcs	found_dup	; if a duplicate was found		jsr	name_chk	; check for dup name		bcc	dup_chk_loop	; if not a duplicate		eject** A duplicate was detected.  Determine which device is the lower version* or last loaded and shutdown that device.  If device that was shutdown* was the first loaded then copy the current device list entry to the* position of the device that was shutdown.  Update the device count to* reflect the fact that a device was shutdown and purged.*found_dup		longa	on		longi	on		ldy	#ver_num	; determine lowest version		lda	[<drvr_dib_ptr],y		cmp	|current_version		bge	keep_first	; if first is highest or same, keep it** Last loaded is a higher version number.  Shutdown the first loaded* duplicate and purge it.  Then copy the device list entry from the* last loaded device to the first loaded device's position.*		lda	<drvr_dev_num	; REV. 0.09a02		sta	|old_dev_num		dec	a		; are we replacing device #1 (possibly Boot.Driver)?		bne	@not_boot_driver ; no...		ldy	#10		;offset to device #1 UserID in device list		lda	[<drvr_dev_ptr],y		cmp	<boot_user_id	; is it the Boot.Driver?		bne	@not_boot_driver ; no, shutdown normally		lda	#drvr_shutdn	; else issue a shutdown call to the driver		sta	<drvr_call_num	; but don't purge it from memory		jsl	dev_dispatcher		bra	@unlink_driver	; then replace the entry with the new entry@not_boot_driver		jsr	shutdn_driver	; else shutdown & purge the first one@unlink_driver		inc	|purge_flag	; started successfully		jsr	set_dev_index	; now need device list index		phy		lda	|cur_dev_num		sta	<drvr_dev_num		jsr	set_dev_index		lda	#$0004		; words to relocate		sta	>post_indexcopy_dev_entry		lda	[<drvr_dev_ptr],y		iny		iny		tyx			; save source pointer		ply			; get destination pointer		sta	[<drvr_dev_ptr],y		iny		iny		phy			; save destination pointer		txy			; get source pointer		lda	>post_index		dec	a		sta	>post_index		bne	copy_dev_entry		ply		jsr	set_dib_ptr	; point at the DIB that was kept		ldy	#dib_dev_num	; V0.09a02 update DIB_DEV_NUM		lda	|old_dev_num		sta	[<drvr_dib_ptr],y		bra	dup_all_gone** First loaded was the higher version so shutdown and purge the last* loaded.*keep_first		lda	|cur_dev_num	; set device # for last loaded		sta	<drvr_dev_num		jsr	shutdn_driver	; shutdown & purge the driver		jsr	set_dib_ptr	; point at the DIB that was keptdup_all_gone		sec		rts		eject****************************************************************** This routine checks to see that the slot & unit in the* active DIB are not duplicates of the slot & unit contained* in the current slot & unit images.** ENTRY: Call via 'JSR'*        drvr_dev_num = Device number of current device*        drvr_dib_ptr = Points to DIB for current device*        current_slot = Slot being checked*        current_unit = Unit being checked*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0  If device is not a duplicate*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0  If device is a duplicate*****************************************************************slot_unit_chk		longa	on		longi	on		ldy	#slot_num		; point at slot in DIB		lda	[<drvr_dib_ptr],y		bmi	not_a_dup		; "hardware independent" bit is set		and	#$000F		cmp	|current_slot		; check slot against current		bne	not_a_dup		; if slot unique				iny				; else prepare to check unit		iny		lda	[<drvr_dib_ptr],y		cmp	|current_unit		; check unit against current		bne	not_a_dup		; if unit uniqueits_a_dup		sec		rtsnot_a_dup		clc		rts		eject****************************************************************** This routine checks the name of the active DIB against the* name in the current name image.** ENTRY: Call via 'JSR'*        drvr_dev_num = Device number of current device*        drvr_dib_ptr = Points to DIB for current device*        current_name = Name being checked*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0  If device is not a duplicate*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0  If device is a duplicate*****************************************************************name_chk		longa	on		longi	on		sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off		ldy	#dev_name		; point at name in DIB		ldx	|current_name		; get length of current namechk_dev_name		lda	[<drvr_dib_ptr],y		cmp	|current_name-dev_name,y		bne	not_dup_name		iny				; scan until no match or end of string		dex		bpl	chk_dev_name		sec				; if reached end of string then DUPE!		bcs	name_chk_donenot_dup_name		clcname_chk_done		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on		rts		eject******************************************************************* This routine copies the name of the device specified by the* current DIB pointer in preperation for checking for a duplicate* device name.  The slot, unit, device ID and version number are* also copied.** ENTRY: via a 'JSR'*       <drvr_dib_ptr = Points to DIB for current <drvr_dev_num*               A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*       |current_name = device name extracted from DIB**               A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0******************************************************************copy_cur_name		longa	on		longi	on		lda	<drvr_dev_num		sta	|cur_dev_num		sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off		ldy	#dev_namecopy_dev_name		lda	[<drvr_dib_ptr],y		sta	|current_name-dev_name,y		iny		cpy	#head_link		bne	copy_dev_name;		stz	|current_slot+1		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on		rts		eject***************************************************************** This routine is used to generate drivers for existing slot* resident firmware interfaces.  As each slot is identified,* the slot is compared to existing loaded drivers in the device* list.  If a driver is found for the current slot, no driver* will be generated for that slot.  If a driver is generated,* a DRVR_STARTUP call will be issued to the driver.  If the* driver returns an error, the driver will be purged from* the device list.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0*        drvr_dev_num = device number of 1st generated driver** EXIT:         A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************gen_drivers		longa	on		longi	on		jsr	deref_drv_list		; set driver list pointer		ldx	#$0000		jsr	set_dev_index		; point into device listdib_ptr_loop		lda	<gen_drvr_ptr		; copy entry into device list		sta	[<drvr_dev_ptr],y		iny		iny		lda	<gen_drvr_ptr+2		sta	[<drvr_dev_ptr],y		pha		iny					iny		lda	#$0000			; initialize driver disk switched flag		sta	[<drvr_dev_ptr],y		iny				; initialize driver User ID		iny		sta	[<drvr_dev_ptr],y		iny				; point at next device list entry		iny		lda	<gen_drvr_ptr		; calculate next entry		clc		adc	#dib_size		; 66 bytes per DIB		sta	<gen_drvr_ptr		pla		adc	#$0000		sta	<gen_drvr_ptr+2		inx		cpx	|total_gen		bne	dib_ptr_loop		jsr	deref_drv_list		; restore driver list pointer** Copy default DIB/GDIB to generated driver list*		ldy	|drvr_list_size		; number bytes to move -2 (last word)		dey		deyreset_src_addr		ldx	#boot_dib+74		; Source addressfirst_dib		lda	|0,x			; copy default DIB/GDIB		sta	[<gen_drvr_ptr],y		dex				; next source address		dex		cpx	#boot_dib-2		bne	src_addr_ok		; if haven't copied entire source		ldx	#boot_dib+74		; Reset pointer to source addresssrc_addr_ok		dey				; next destination address		dey		bpl	first_dib		; 1 copy for each gen. driver** Point at initial slot for proper device generation.*		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on		lda	#$000F			; initial slot is 15 (7 external)		sta	|gen_slot_num		lda	#$0002			; initialize generate counter		sta	|gen_count** While generating devices, always request that the slot be installed via* the slot arbiter.  This code was inserted in system disk 4.1.*gen_dib_loop		lda	|gen_slot_num		; request slot from slot arbiter		jsl	dyn_slot_arbiter		bcs	set_next_slot		; point at next slot to generate a device for** Ident_slot requires a pointer to the slot firmware.  The slot arbiter slot* request is converted into a $00Cn00 address by limiting the slot address to * slots 0 through 7 (since only seven slots reside actively in the system).*		lda	|gen_slot_num		; create a pointer to $Cn00 for current slot		xba		and	#$0700		ora	#$C000		sta	<fw_addr		stz	<fw_addr+2** Point at the DIB to be generated and identify the peripheral resident in the* slot.  Note that if the peripheral exists, all DIB information will be* constructed and placed into the current DIB data structure (the DIB pointed* to by drvr_dib_ptr).*		jsr	set_dib_ptr		; v0.01 a02 (init DIB ptr)		jsr	ident_slot		; identify class of device		beq	set_next_slot		; if no devices this slot** A peripheral exists in the current slot.  Go build a DIB for the peripheral* class that was detected in the slot.*		tay				; save device count		txa				; get driver peripheral class		pha		and	#$0003			; want peripheral class, not peripheral subclass		asl	a		tax		pla		php				; save environment		pea	build_ret-1		; return from build		jmp	(build_dib,x)		; go build proper peripheral class of driverbuild_ret		plp				; restore environmentset_next_slot		dec	|gen_slot_num		; point at next slot to generate a device for		bne	gen_dib_loop		; build more DIB's if not slot #0** After completing generation of peripheral device DIB data structures, the* device number is left at a value equal to the actual number of devices* plus one.  Adjust the device count and install the device count into the* device list before exiting back to the top level of the device dispatcher* startup routine.*		dec	<drvr_dev_num		; set number of devices		lda	<drvr_dev_num		sta	[<drvr_dev_ptr]		rts		eject******************************************************************* This routine checks to see if a loaded driver is already* installed for the current slot that at driver is being* generated for.** ENTRY: Call via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************chk_dup_load		longa	on		longi	on** Move the current device name into a unique buffer* and check against all other names.*		pha		phx		phy		pei	<fw_addr+2		pei	<fw_addr		pei	<drvr_dev_num		jsr	copy_cur_namecheck_name		rep	#$30		; 16 bit 'm' & 'x'		longa	on		longi	on		dec	<drvr_dev_num	; point at previous device		bne	keep_checking		clc		bra	check_donekeep_checking		jsr	set_dib_ptr	; point at DIB under test		jsr	slot_unit_chk	; check for unique slot & unit		bcc	not_same_devcheck_done		pla			; restore device number		jsr	leave_dib_alone		pla		sta	<fw_addr		pla		sta	<fw_addr+2		jmp	pull_y_x_a		eject** Slot, Unit & Device ID are not the same.  Check that the name is* unique.  If not, modify the name and recheck until it is unique.*not_same_dev		longa	on		longi	on		jsr	name_chk	; is this a duplicate name?		bcc	check_name	; no		pla			; reset to current device		pha		jsr	leave_dib_alone		inc	|gen_count	; regenerate name with new #		jsr	gen_name		jsr	copy_cur_name	; prepare to search for a duplicate		bra	check_name		eject******************************************************************* Dispatch table for DIB construction.  Dispatch is based on* class of driver being constructed.** ENTRY:        A Reg = Driver Class & Subclass*               X Reg = Driver Class*               Y Reg = Number of devices in current slot*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg =*               X Reg =*               Y Reg =*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************build_dib	dc.w	build_class0		; vector for BASIC, Pascal1.1 & ProDOS		dc.w	build_class1		; vector for Standard SmartPort		dc.w	build_class2		; vector for Extended SmartPort** Routine to build DIB/GDIB for class 0 drivers.*build_class0		longa	on		longi	on		jsr	set_dib_ptr		; set DIB pointer current dev num		ldy	#drvr_class		; set driver class		sta	[<drvr_dib_ptr],y		and	#$0080			; BASIC or Pascal1.1?		beq	build_prodos		jmp	build_char		eject** Device is a ProDOS block device if got here.* Default device characteristics apply as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|__ Reserved*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________ Media remov*   |   |   |   |   |   |   |   |   |   |   |   |   |______________ Format*   |   |   |   |   |   |   |   |   |   |   |   |__________________ Driver follows guidelines*   |   |   |   |   |   |   |   |   |   |   |______________________ Read*   |   |   |   |   |   |   |   |   |   |__________________________ Write*   |   |   |   |   |   |   |   |   |______________________________ Block Dev*   |   |   |   |   |   |   |   |__________________________________ Speed Group*   |   |   |   |   |   |   |______________________________________ Speed Group*   |   |   |   |   |   |__________________________________________ Fixed Name*   |   |   |   |   |______________________________________________ Restartable*   |   |   |   |__________________________________________________ Device Busy*   |   |   |______________________________________________________ Linked*   |   |__________________________________________________________ Generated*   |______________________________________________________________ RamRom Disk*build_prodos	lda	#$0001			; unit numbernext_prodos	jsr	generate_slot		; generate slot number** Must set device characteristics based on contents* of location $CnFE.*  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |______  1 = Device status can be read*   |   |   |   |   |   |   |__________  1 = Device can be read from*   |   |   |   |   |   |______________  1 = Device can be written to*   |   |   |   |   |__________________  1 = Device can be formatted*   |   |   |___|______________________ nn = Number of volumes (0 - 3)*   |   |______________________________  1 = Device is interruptable*   |__________________________________  1 = Medium is removable*		stz	|pro_char		sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off		stz	<fw_addr		ldy	#$00FE			; get ProDOS characteristics		lda	[<fw_addr],y		pha		and	#%00001000		; format bit		sta	|pro_char		pla		rol	a			; convert remaining bits to GS/OS		rol	a		rol	a		rol	a		and	#%01100100		; read, write & removable bits		tsb	|pro_charchk_done		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on		lda	|pro_char		; generated, blockdev & speed group		ora	#%0100001110000000		jsr	set_dev_char		; set device characteristics		jsr	gen_name		; generate device name 'DEVn'		lda	#$0000		ldy	#drvr_class		; set driver class		sta	[<drvr_dib_ptr],y** Now need to know if device requires a status call* in order to determine the total number of blocks* on the media.*		ldy	#$00FC			; does device require status for size?		lda	[<fw_addr],y		bne	have_dev_size		; no** Device requires a status call to determine total* number of blocks.  Set <FW_ADDR to point to the* ProDOS device entry point = $Cn00 + ($CnFF) and* issue the status call to the device.*		sep	#$20			; 8 bit 'm'		longa	off		ldy	#$00FF			; set ProDOS entry point		lda	[<fw_addr],y		sta	<fw_addr		rep	#$20			; 16 bit 'm'		longa	on		lda	>call_list_ptr		; get address where dispatch returns		tax		lda	#$EAEA			; 'nop' 'nop'		sta	>0,x		sta	>2,x		sta	>3,x		ldy	#unit_num		; create ProDOS Unit Number		lda	[<drvr_dib_ptr],y		dec	a		lsr	a			; carry is now unit number		php		ldy	#slot_num		lda	[<drvr_dib_ptr],y		xba				; high byte is STATUS command		asl	a		asl	a		asl	a		asl	a		asl	a		plp		ror	a		sta	>pcmd			; ProDOS command and unit number		jsl	b0_core			; execute class 0 status for size		bcc	have_c0_size		; if status was successful** Status may return WRPROT as an error.  In this case the size is* still available and the DIB should be built. (8-11-88 RBM).*		cmp	#drvr_wr_prot		; is it a WRPROT error?		beq	have_c0_size		; yes		rts				; else bomb out on this DIB** On return from status call, the 16 bit native mode X* register contains the number of blocks on the ProDOS* block device.*have_c0_size	txahave_dev_size	ldy	#blk_cnt		; set number of blocks in DIB		sta	[<drvr_dib_ptr],y		pha		lda	#$0000		iny		iny		sta	[<drvr_dib_ptr],y		lda	#$FFFF			; set cache priority		ldy	#cache_mask		sta	[<drvr_dib_ptr],y		pla** Now generate a device ID number based on the total* block count (since we dont have any other method for* ProDOS devices).*		ldx	#$0002			; ID number = ProFILE 10M		cmp	#19456			; is this a ProFILE 10M?		beq	set_dev_id		; yes				cmp	#9728			; is this a ProFILE 5M?		bne	not_profile		; no				dex				; ID number = ProFILE 5M		bra	set_dev_id		not_profile	ldx	#$0014			; ID number = Generic Floppy		cmp	#1600			; is the block count <= 1600 blocks?		blt	set_dev_id		; yes				dex				; ID number = Generic Hard Disk		set_dev_id	jsr	set_id_num		; set device ID in DIB		jsr	set_gen_ver		; set driver version number in DIBcheck_if_last		ldy	#slot_num		; get current slot		lda	[<drvr_dib_ptr],y		and	#$000F			; strip resource flags off		tax		lda	>config_ram		; get ProDOS configuration ram		unit_counter	ror	a			; get # ProDOS units into carry		dex		bpl	unit_counter		bcc	prodos_done		; if only 1 unit this slot				ldy	#unit_num		; done all ProDOS units?		lda	#$0002			; max ProDOS unit number		cmp	[<drvr_dib_ptr],y		beq	prodos_done** Some ProDOS block devices only support a single volume.* Calls to unit 2 must be blocked on these cards.*		sep	#$20			; 8 bit 'm'		longa	off		stz	<fw_addr		rep	#$20			; 16 bit 'm'		longa	on		ldy	#$00FE			; point at device characteristics		lda	[<fw_addr],y		and	#$0010			; any more devices?		beq	prodos_done		; no				lda	<drvr_dev_num		; is this the boot unit?		dec	a		beq	prodos_done		; yes				ldy	#unit_num		; reset unit before checking dup boot		lda	[<drvr_dib_ptr],y		pha				; save next unit		jsr	chk_dup_load		; does a loaded driver already exist?		bcs	dup_load_0		; yes				jsr	chk_dup_boot		; check if device is same as boot		dup_load_0	jsr	set_dib_ptr		; point at DIB for next device		pla				; restore next unit		inc	a		jmp	next_prodos		; more units to do		prodos_done	lda	<drvr_dev_num		; **** CHANGE **** v0.28		dec	a			; is this the boot unit?		beq	dup_load_1		; yes, dont check for dups				jsr	chk_dup_load		; does a loaded driver already exist?		bcs	dup_load_1		; yes				jsr	chk_dup_boot		; check if device is same as boot		dup_load_1	rts		eject** Device is a BASIC or Pascal1.1 character device if got here.* Set the device characteristics as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|__ Reserved*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________ Media remov*   |   |   |   |   |   |   |   |   |   |   |   |   |______________ Format*   |   |   |   |   |   |   |   |   |   |   |   |__________________ Driver follows guidelines*   |   |   |   |   |   |   |   |   |   |   |______________________ Read*   |   |   |   |   |   |   |   |   |   |__________________________ Write*   |   |   |   |   |   |   |   |   |______________________________ Block Dev*   |   |   |   |   |   |   |   |__________________________________ Speed Group*   |   |   |   |   |   |   |______________________________________ Speed Group*   |   |   |   |   |   |__________________________________________ Fixed Name*   |   |   |   |   |______________________________________________ Restartable*   |   |   |   |__________________________________________________ Device Busy*   |   |   |______________________________________________________ Linked*   |   |__________________________________________________________ Generated*   |______________________________________________________________ RamRom Disk*build_char	lda	#%0100001101100000		jsr	set_dev_char		; set device characteristics		lda	#$0000			; no blocks on character device		iny		iny		sta	[<drvr_dib_ptr],y		iny		iny		sta	[<drvr_dib_ptr],y		jsr	gen_name		; generate device name 'Dn'		lda	#$0001			; unit number		jsr	generate_slot		; generate slot number** Set the device ID number based on the driver's slot and* battery ram parameters.  Internal slots 1, 2, 3 and 7 are* special cased.  Internal slots 1 and 2 device ID's are* based on battery ram configurations for these slots.*		ldy	#dev_id_num		; point at DIB device ID		cmp	#$0001			; is it internal slot 1?		bne	id_not_slot1		; no				dec	aid_slot1_2	pha				; space for result		pha				; parameter is 'Port1 Printer/Modem'		_readbparm		ldx	#$000B			; assume ID = Printer		pla				; is ID a printer?		beq	have_char_id		; yes				ldx	#$0009			; assume ID = modem		cmp	#$0001			; no, is it a modem?		beq	have_char_id		; yes, go ID modem		ldx	#$0018			; not a modem or printer, set network generichave_char_id	jsr	set_id_num		; now set ID number		bra	set_not_open		; continue		id_not_slot1	cmp	#$0002			; is it internal slot 2?		bne	id_not_slot2		; no				lda	#$000C		bra	id_slot1_2		; continue		id_not_slot2	cmp	#$0003			; is it internal slot 3?		bne	id_not_slot3		; no		sec				; Dont generate a driver for slot 3		bra	dup_load_2		id_not_slot3	cmp	#$0007			; is it internal slot 7?		bne	id_not_slot7		; no		ldx	#$0018			; driver is a network		jsr	set_id_num		; now set ID number		bra	set_not_open		; continueid_not_slot7		ldx	#$0016			; driver is a generic character device		jsr	set_id_num		; now set ID number** Set device OPEN flag to 'Not Open'.*set_not_open		ldy	#open_flag		; set to not open		lda	#$0000		sta	[<drvr_dib_ptr],y		jsr	set_gen_ver		; set driver version #		jsr	chk_dup_load		; does a loaded driver already exist?		bcs	dup_load_2		; yes		jsr	chk_dup_boot		; check if device is same as bootdup_load_2		rts		eject** Device is a Standard SmartPort device if got here.* A status call to the device is required before the* device characteristics word can be set.  The default* device characteristics for a SmartPort device is as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |___|__ Reserved*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________ Media remov*   |   |   |   |   |   |   |   |   |   |   |   |   |______________ Format*   |   |   |   |   |   |   |   |   |   |   |   |__________________ Driver follows guidelines*   |   |   |   |   |   |   |   |   |   |   |______________________ Read*   |   |   |   |   |   |   |   |   |   |__________________________ Write*   |   |   |   |   |   |   |   |   |______________________________ Block Dev*   |   |   |   |   |   |   |   |__________________________________ Speed Group*   |   |   |   |   |   |   |______________________________________ Speed Group*   |   |   |   |   |___|__________________________________________ Reserved*   |   |   |   |__________________________________________________ Device Busy*   |   |   |______________________________________________________ Linked*   |   |__________________________________________________________ Generated*   |______________________________________________________________ RamRom Disk** The device characteristics word will be substantially modified* for a SmartPort character device.*build_class1		longa	on		longi	on** Device may be an Extended SmartPort device if got here.* A status call to the device is required to determine if* the device as well as the firmware interface supports the* extended SmartPort device protocol.  If not, the device* class will be modified to a class 1 device.  All other* DIB/GDIB setup is identical to the class 1 device.*build_class2	lda	#$0001			; unit number		sta	|x_unit			; init hardware unit numberclass2_loop		jsr	set_dib_ptr		; set DIB pointer current dev num		phy				; Number of devices this slot		phx				; initial class (needs verified)		pha				; unit number		ldy	#drvr_class		; set driver class		txa		sta	[<drvr_dib_ptr],y		lda	#$FFFF			; set cache priority		ldy	#cache_mask		sta	[<drvr_dib_ptr],y		pla				; unit number		pha		php		jsr	generate_slot		; generate slot number		jsr	setup_sp_stat		; setup bank0 core for status call		plp		pla				; need device unit number in parmlist		ldx	#param_list_ptr		; pointer to parameter list		sep	#$20			; 8 bit 'm'		longa	off		sta	>1,x			; set unit number in parameter list		lda	#$03			; status code = DIB status = $03		sta	>4,x		rep	#$20			; 16 bit 'm'		longa	on		jsl	b0_core			; execute device status call		ldy	#blk_cnt		; set number of blocks		lda	>sys_buffer+1		sta	[<drvr_dib_ptr],y		iny		iny		lda	>sys_buffer+3		and	#$00FF		sta	[<drvr_dib_ptr],y		lda	>sys_buffer		; get device general status byte		and	#$00E8			; mask unused bits		ora	#$4300			; mark device as generated		sep	#$10			; 8 bit 'x'		longi	off		clc				; assume not a Ram or Rom Disk		pha		lda	>sys_buffer+$16		; get device subtype		and	#%00100000		; want media removable bit		eor	#%00100000		lsr	a		lsr	a		lsr	a		ora	1,s			; place media romovable into dev_char		sta	1,s		lda	>sys_buffer+$15		; get device type byte		asl	a			; Extended to carry, keep type * 2		tay				; Y = SmartPort device type * 2		pla		tyx				; X = SmartPort device type * 2		bne	not_ram_diskram_rom_disk		ora	#$8000			; set Ram/Rom Disk		and	#$FFF8			; Ram/Rom Disk not removable		sec		bra	have_dev_charnot_ram_disk		cpx	#$08			; is it a Ram Disk?		beq	ram_rom_disk		; yes		clchave_dev_char		rep	#$10			; 16 bit 'x'		longi	on		jsr	set_dev_char		; set device characteristics		bcs	disable_cache		; dont modify mask if not a Ram or Rom Disk				cpx	#$0002			; is this an AppleDisk3.5?		bne	cache_mask_ok		; nodisable_cache		ldy	#cache_mask		; no cache for Ram or Rom disk		lda	#$0000			; cache mask of zero disable caching for the device		sta	[<drvr_dib_ptr],ycache_mask_ok		lda	#$0014			; assume a generic floppy disk		cpx	#$0021			; is it a known SmartPort id? (SmartPort Type * 2 +1)		bge	have_sp_trans		; no, use assumed ID				lda	|sp_trans_id,x		; set device id numberhave_sp_trans		ldy	#dev_id_num		sta	[<drvr_dib_ptr],y		ldy	#drvr_type		; set GDIB type		lda	>sys_buffer+$15		pha		and	#$00FF		sta	[<drvr_dib_ptr],y		pla				; set GDIB subtype		xba		and	#$00FF		iny		iny		sta	[<drvr_dib_ptr],y		sep	#$20			; 8 bit 'm'		longa	off		asl	a			; extended flag to carry		rep	#$20			; 16 bit 'm'		longa	on** Both the interface and the device itself must indicate that* extended calls are supported in order to have the device* installed as a class 2 (Extended SmartPort) device.*		ldy	#drvr_class		lda	[<drvr_dib_ptr],y		bcs	class_is_ok		; if device is extended, dont mod class		cmp	#$0002			; is driver extended?		bne	class_is_ok		; no		dec	a			; yes, must make it nonextended		sta	[<drvr_dib_ptr],yclass_is_ok		lda	>sys_buffer+$17		; set version number		ldy	#ver_num		sta	[<drvr_dib_ptr],y** Early versions of the SCSI Interface Card Firmware do not* operate properly when using the Extended SmartPort interface* with Interrupts running.  Any SCSI card with a firmware* version number less than 2 will be installed as a class 1* device thereby limiting the device to standard SmartPort calls.*  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |     SmartPort Type ID $CnFB* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |__ 0 = RAM CARD*   |   |   |   |   |   |   |______ 1 = SCSI*   |   |   |___|___|___|__________ 0 = RESERVED*   |   |__________________________ 1 = Supports SuperCalls*   |______________________________ 1 = Supports Extended Calls*		pei	<fw_addr		; save $Cn00+($CnFF)+3		sep	#$20			; 8 bit 'm'		longa	off		stz	<fw_addr		; need ($CnFB)		ldy	#$00FB		lda	[<fw_addr],y		lsr	a			; is this a SCSI interface?		lsr	a		rep	#$20			; 16 bit 'm'		longa	on		pla				; restore $Cn00+($CnFF)+3		sta	<fw_addr		bcc	not_scsi		; no		ldy	#ver_num		lda	[<drvr_dib_ptr],y		cmp	#$0002			; is this the NEW scsi rom?		bge	not_scsi		; yes, don't modify the driver class		ldy	#drvr_class		; else set the class to 1		sta	[<drvr_dib_ptr],ynot_scsi** Now generate a name for the current device being* installed into the device list.*		jsr	gen_name		; generate device name 'Dn'** Check if done generating devices for this peripheral* card.  Make sure this device is not a duplicate device* for a driver already loaded or the generated boot device.*		ldy	#unit_num		; get current device unit number		lda	[<drvr_dib_ptr],y		inc	a			; and set for next device		plx				; driver class		ply				; number of devices		dey		beq	build_done		jsr	chk_dup_load		; does a loaded driver already exist?		bcs	dup_load_3		; yes		jsr	alert_check		; check if ALERT for loaded driver should be displayed		bcs	dup_load_3		; if ALERT was displayed and generated driver was tossed		jsr	chk_dup_boot		; check if device is same as bootdup_load_3		jmp	class2_loop		; loop until all devices generatedbuild_done		lda	<drvr_dev_num		; was this the boot device?		dec	a		beq	dup_load_5		; yes		jsr	chk_dup_load		; does a loaded driver already exist?		bcs	dup_load_4		; yes		jsr	alert_check		; check if ALERT for loaded driver should be displayed		bcs	dup_load_4		jsr	chk_dup_boot		; check if device is same as bootdup_load_4		rtsdup_load_5		jsr	alert_check		; check if ALERT for loaded driver should be displayed		rts		eject******************************************************************* If this is a UniDisk3.5 drive then only build the device if it is* unit $0001 and the slot number is equal to the boot slot.  The loaded* driver for the UniDisk3.5 is absolutely neccessary to properly use* the media and assure that corruption will not occur.** This routine will also display alerts for the AppleDisk3.5 driver but* will allow use of this driver without caching at reduced performance.*** ENTRY: via a 'JSR'*		A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0*           Boot_Slot = Slot number of boot volume** EXIT: via an 'RTS'*		A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0 Not a LIRON or LIRON is boot device*			¥ ¥ 0 0 0 ¥ ¥ 1  0 LIRON is not boot device******************************************************************alert_check		longa	on		longi	on		pha		phx		phy		ldy	#drvr_type		; get SmartPort driver type		lda	[<drvr_dib_ptr],y		cmp	#$0001			; is it a UniDisk3.5 or AppleDisk3.5 drive?		bne	not_ad			; no, go ahead and build the device		ldy	#drvr_subtype		; get SmartPort driver subtype		lda	[<drvr_dib_ptr],y	; is it a UniDisk3.5		bne	not_ud			; no		jsr	boot_slot_unit		; is it a boot device?		beq	boot_ud			; yes, go ahead and generate itnot_ud_boot		lda	|ud_count		; has dialog already been displayed?		bne	no_ud_dialog		; yes		lda	#unidisk_alert		; display driver alert dialog		jsr	driver_alertno_ud_dialog		sec				; it's a unidisk & not in the boot position		inc	|ud_count		; only display dialog once!!!pull_y_x_a		ply		plx		pla		rtsboot_ud		lda	|ud_count		; has UniDisk dialog been displayed?		bne	no_ud_alert		; yes		lda	#unidisk_alert		; display driver alert dialog		jsr	driver_alertno_ud_alert		inc	|ud_count		; only display dialog once!!!		ldy	#cache_mask		; disable cache on UniDisk generated driver		lda	#$0000		sta	[<drvr_dib_ptr],y		bra	alert_exitnot_ud		cmp	#$00C0			; is it an AppleDisk3.5 drive?		bne	alert_exit		; no		lda	|ad_count		; has dialog been displayed already?		bne	alert_exit		; yes, dont redisplay it				lda	#appledisk_alert	; display driver alert dialog		jsr	driver_alert		inc	|ad_count		; set flag so redisplay will not occur		bra	alert_exitnot_ad		cmp	#$0005			; is it a SCSI hard disk device?		beq	do_scsi_alert		; yes		cmp	#$0007			; is it a SCSI CD-ROM		bne	alert_exit		; nodo_scsi_alert		lda	|scsi_count		; has dialog been displayed already?		bne	scsi_alert_exit		; yes, dont redisplay it				lda	#scsi_alert		; display driver alert dialog		jsr	driver_alertscsi_alert_exit		inc	|scsi_count		; set flag so redisplay will not occur		jsr	boot_slot_unit		; is it the boot device?		sec		bne	no_scsi_dialog		; yes, flag as duplicatealert_exit		clc				; indicate driver was not tossedno_scsi_dialog		jmp	pull_y_x_a		driver_alert		pha				; error number of driver alert		lda	#0			; push NIL pointers (no substitution strings)		pha		pha		pha		pha		tay		lda	>warm_cold_flag		; is this a boot or an OS switch?		bne	no_thermometer		; it's an OS switch				tya		jsl	stop_scrn_chk		; dont want text screen left up after dialog		jsl	report_error		; display the alert dialog		jsl	start_scrn_chk		; back to thermometer		rtsno_thermometer		tya		jsl	report_error		; display the alert dialog		rtsboot_slot_unit		ldy	#slot_num		lda	[<drvr_dib_ptr],y		cmp	|d_boot_slot		; is this the boot slot		bne	aint_boot		; no				ldy	#unit_num		lda	[<drvr_dib_ptr],y		dec	a			; is this the boot unitaint_boot		rts				eject******************************************************************* This routine verifies that the current device is not a* duplicate of the boot volume device.  If so, the device* number is not incremented.  If not, the device number is* incremented.  When the device number is not incremented, the* next device will be built over the current device thus purging* the duplicate device.** ENTRY:        A Reg = Undefined*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0*           Boot_Slot = Slot number of boot volume** EXIT:         A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************chk_dup_boot		longa	on		longi	on		pha		phy		ldy	#slot_num	; get current device slot		lda	[<drvr_dib_ptr],y		cmp	<boot_slot		bne	not_dup_boot	; it's ok to generate next device				iny			; get current unit #		iny		lda	[<drvr_dib_ptr],y		cmp	#$0001		; boot volume is always unit #1		beq	chk_dup_done	; it's a duplicate, purge itnot_dup_boot		inc	|gen_count	; else setup for next device		inc	<drvr_dev_numchk_dup_done		ply		pla		rts		eject******************************************************************* This routine sets the DIB unit and slot numbers.  The Unit* number is passed as input to this routine through the* accumulator.  The slot number is based on <fw_addr.* If the slot is external, $0008 will be added to the* initial slot value before placing the slot number into the DIB.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*           Boot_Slot = Slot number of boot volume** EXIT:         A Reg = Slot number*               X Reg = Undefined*               Y Reg = Pointer to DIB slot number*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************generate_slot		longa	on		longi	on		ldy	#unit_num	; set unit number		sta	[<drvr_dib_ptr],y		dey			; point at DIB slot number		dey		lda	<fw_addr	; get $CnXX		xba		and	#$0007		; extract the slot number		sta	[<drvr_dib_ptr],y		php			; save environment		sep	#$20		; 8 bit 'm'		longa	off		cmp	#$03		; is slot set to slot #3?		bne	not_slot3	; if not		lda	>rdc3rom	; internal or external?		rol	a		bra	set_int_extnot_slot3		tax		lda	>sltromsel	; get slot rom selectionslot_check		ror	a		dex		bpl	slot_checkset_int_ext		lda	#$00		; assume internal		bcc	int_slot		lda	#$08		; slots 8-15 are externalint_slot		plp			; restore environment		longa	on		and	#$00FF		; insert SLOT_NUM		ora	[<drvr_dib_ptr],y		sta	[<drvr_dib_ptr],y		pha		phy		lda	<drvr_dev_num	; insert DIB_DEV_NUM ** REV. 0.10a02		ldy	#dib_dev_num		sta	[<drvr_dib_ptr],y		ply		pla		rts		eject******************************************************************* This routine is used to generate an ASCII name for generated* devices and places that name into the DIB.  The value of the* generated driver counter is converted to decimal prior to* converting the count to ASCII.  All leading zero's will be* removed from the final string resulting in the name 'Dn' where* n is the value of the generated driver counter.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*           Boot_Slot = Slot number of boot volume** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************gen_name		longa	on		longi	on		pha			; preserve environment		phx		phy		lda	|gen_count	; # of current generated driver		pha			; is integer to be converted		pea	name_buff>>16	; Pointer to output string		pea	name_buff		pea	$0005		; length of output string		pea	$0000		; unsigned integer		_int2dec		sep	#$20		; 8 bit 'm'		longa	off		ldy	#dev_name+4	; point into name after count & 'DEV'		ldx	#$0000xfer_fl_name		lda	|name_buff,x	; get ascii		cmp	#$20		; is it a ' ' ascii character?		bne	move_string	; no, now pointing at 1st character		inx			; else point at next character and		bra	xfer_fl_name	; continue search for 1st valid char.		move_string				; ; now move string into DIB		lda	|name_buff,x	; get ascii		sta	[<drvr_dib_ptr],y		iny		inx		cpx	#$0005		bne	move_string				tya			; calculate string length		clc			; -1 since ptr past string		sbc	#dev_name		ldy	#dev_name	; and set string length		sta	[<drvr_dib_ptr],y		rep	#$20		; 16 bit 'm'		longa	on		jmp	pull_y_x_a		eject******************************************************************* This routine sets the DIB device ID number based on the* contents of the X register.******************************************************************set_id_num		longa	on		longi	on		ldy	#dev_id_num		; point at DIB ID number		txa				; and set the ID		bra	set_dib_parm******************************************************************* This routine sets the DIB device characteristics based* on the contents of the A register.******************************************************************set_dev_char		longa	on		longi	on		ldy	#dev_char		; set device characteristics		bra	set_dib_parm******************************************************************* This routine sets the DIB version number.******************************************************************set_gen_ver		longa	on		longi	on		ldy	#ver_num		; point at DIB version number		lda	#$2000			; and set the version numberset_dib_parm		sta	[<drvr_dib_ptr],y		rts		eject****************************************************************** This routine sets the DIB pointer on direct page for the* device specified by the Device ID Number.  This allows an* FST direct access to DIB information for a particular device.*****************************************************************dd_get_dib		longa	on		longi	on		lda	<dev_id_ref		; check device number		cmp	[<drvr_dev_ptr]		blt	id_ref_ok		beq	id_ref_ok				lda	#invalid_dev_num	; incorrect ID, no device error		sec		rtsid_ref_ok		sta	<drvr_dev_num		; set device number		jsr	set_dib_ptr		; set pointer to DIB		stz	<drvr_dev_num		; restore device number		lda	#$0004			; set transfer count		sta	<drvr_tran_cnt		stz	<drvr_tran_cnt+2		clc				; no error has occured		rts		eject****************************************************************** This function walks the device list looking for a driver that* supports removeable media.  When one is found, an Eject call* is made to the driver to have it eject it's media.  When the* entire device list is scanned, the function falls through into* the normal dispatcher shutdown procedure*****************************************************************dd_full_shutdn		lda	[<drvr_dev_ptr]		; point at last device		beq	no_drvr_shutdn		sta	<drvr_dev_num		; save here		stz	<drvr_buf_ptr		; not used, zero out		stz	<drvr_buf_ptr+2		stz	<drvr_req_cnt		; not used, zero out		stz	<drvr_req_cnt+2loop		jsr	set_dib_ptr		; make a dib pointer for this device		ldy	#dev_char		; index to characteristics		lda	[<drvr_dib_ptr],y		and	#%0000000000000100	; removeable media?		beq	no_eject		; no, skip it		lda	#2			; control subcall = Eject		sta	<drvr_ctrl_code		lda	#6			; driver call = Control		sta	<drvr_call_num		jsl	dev_dispatcher		; call the driver (recursive!)no_eject		dec	<drvr_dev_num		; loop through all devices		bne	loop		; fall through into dd_shutdn		eject****************************************************************** This function is used to shutdown the device dispatcher.* Then a drvr_shutdn call will be issued to each device in the* device list.  The memory used to maintain the device* list will be released and the ID for the device list will* be deleted.** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0   if no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0   if error*****************************************************************dd_shutdn		longa	on		longi	on		lda	[<drvr_dev_ptr]		; point at last device		beq	no_drvr_shutdn		shutdn_loop		sta	<drvr_dev_num		pha				; save the device number		jsr	shutdn_driver		; shutdown the driver		pla				; retrieve the device number		dec	a			; step backwards through device list		bne	shutdn_loop		; until all devices shut down		no_drvr_shutdn		lda	[<sup_drvr_ptr]		; point at last supervisor		beq	no_sup_shutdn		sup_shutdn_loop		jsr	shutdn_sup		; shutdown the supervisor		lda	[<sup_drvr_ptr]		dec	a		sta	[<sup_drvr_ptr]		bne	sup_shutdn_loop		; no, then loop for next device		no_sup_shutdn		lda	>warm_cold_flag		; is this a warm start?		bne	warm_shutdown		; no** Purge memory used by the device list.*		lda	|dev_list_id		; device id of handle to dispose		ldy	|dev_list_hndl+2	; handle to dispose		ldx	|dev_list_hndl		jsr	dispose_handle		; toss the handle and user ID** Purge memory used by the generated drivers.*		lda	|gen_drvr_id		; device id of handle to dispose		ldy	|gen_drvr_hndl+2	; handle to dispose		ldx	|gen_drvr_hndl		jsr	dispose_handle		; toss the handle and user ID** Purge memory used by the supervisory driver list.*		lda	|sup_drvr_id		; device id of handle to dispose		ldy	|sup_drvr_hndl+2	; handle to dispose		ldx	|sup_drvr_hndl		jsr	dispose_handle		; toss the handle and user ID** Purge memory used by the file list.*		lda	|file_list_id		; device id of handle to dispose		ldy	|file_list_hndl+2	; handle to dispose		ldx	|file_list_hndl		jsr	dispose_handle		; toss the handle and user ID** If a BOOT.DRIVER is in place, dispose of it*		lda	<boot_user_id		; get the ID		beq	warm_shutdown		; no BOOT.DRIVER to dispose of		jsr	purge_driver		; go throw it awaywarm_shutdown		lda	#$0002			; preinit load device in case of warm start		sta	|load_device				stz	|ud_count		; display them dialogs next time!!!		stz	|ad_count		stz	|scsi_countreturn_no_err		lda	#no_error		clc		rts		eject****************************************************************** This routine is used to shutdown a driver.  Note that if the* driver returns an error then the memory for which that driver* was initially loaded into will remain locked and fixed.  If* the driver returned no error then the memory associated with* the User ID entry in the device list will be purged.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************shutdn_driver		longa	on		longi	on		lda	<drvr_dev_num		; is this the boot device?		dec	a		bne	not_boot		; no				jsr	set_dib_ptr		; get the correct DIB pointer		ldy	#dev_char		; is this a generated driver?		lda	[<drvr_dib_ptr],y		and	#$4000		bne	dont_unload		; yes, don't shutdn since not startednot_boot		lda	#drvr_shutdn		; set call = driver shut down		sta	<drvr_call_num		jsl	dev_dispatcher		; and shut it down		bcs	dont_unloadcheck_type		lda	|dd_os_call		; is driver being shutdown during startup?		beq	unload_it		; yes, purge it & mark file list				lda	>warm_cold_flag		; is this a warm start?		beq	unload_it		; yes				ldy	#dev_char		; is driver restartable?		lda	[<drvr_dib_ptr],y		and	#$0800		bne	dont_unload		; no, else nuke the ma'maunload_it		jsr	set_dev_index		; point at user ID in device list		jsr	y_plus_6		; and get current user ID		lda	[<drvr_dev_ptr],y		bne	purge_driver		; if !0, unload & release memorydont_unload		rts		eject****************************************************************** This routine is used to shutdown a supervisor.** ENTRY: Call via 'JSR'*               A Reg = Supervisor driver number*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************shutdn_sup		longa	on		longi	on		ldx	#$0001			; set call = supervisor shut down		pha		jsl	sup_drvr_disp		; and shut it down		plx		eject****************************************************************** This routine is used to purge a supervisory driver.** ENTRY: Call via 'JSR'*               A Reg = Supervisor driver number*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************purge_sup		longa	on		longi	on		lda	|dd_os_call		; is driver being shutdown during startup?		beq	purge_sup_1		; yes, purge it & mark file list				lda	>warm_cold_flag		; is this a warm start?		beq	purge_sup_1		; yes				ldy	#sib_char		; is driver restartable?		lda	[<sib_ptr],y		bmi	dont_unload		; no, else nuke the ma'mapurge_sup_1		txa				; point at user ID in supervisor list		jsr	set_sup_index		lda	[<sup_drvr_ptr],y		beq	dont_unload		; NIL is not a valid driver user ID				eject***************************************************************** This routine unloads and purges the segment defined by the* user ID passed as input to the call.  The USER ID will be* deleted from the system.** ENTRY: via a 'JSR'*               A Reg = USER ID of segment to shutdown*               X Reg = Undefined*               Y Reg = Undefined*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:  via 'RTS'*               A Reg = USER ID of segment that was shutdown*               X Reg = Unchanged*               Y Reg = Unchanged*            Bank Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*           Stack Reg = GS/OS Stack*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0****************************************************************purge_driver		longa	on		longi	on		sta	|shutdown_id		; user ID to shutdown				phx		phy		pha				; space for result		pha				; USER ID		pea	$0000			; Quit Flag		_usershutdown		pla				; result User ID from shutdown				jsr	mark_file_list		; mark the driver in the file list as purged				ply		plx		rts		eject****************************************************************** This routine is the central dispatcher for generated driver* calls.  This routine parses the command number and dispatches* control to the device driver via the proper generated driver* core routine.  The driver block number and buffer address are* preserved throughout the driver call by the driver dispatcher.** ENTRY:        A Reg = Call number*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Same as on entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error*****************************************************************		export	g_dispatchg_dispatch		longa	on		longi	on		phb				; save environment		phd		phk				; set environment in case call was		plb				; from the system service call table		pea	direct_base		pld** Set MSLOT prior to dispatch since some Pascal1.1 devices* dont setup this parameter.*		ldy	#slot_num		; obtain slot number from DIB		lda	[<drvr_dib_ptr],y		sep	#$20		longa	off		and	#$07			; create $Cn for mslot		ora	#$C0		sta	>mslot		rep	#$20		longa	on		lda	<drvr_call_num		; redundant but system service needs it		cmp	#max_command		; is it a legal command?		bge	g_illegal_req		; no		tay				; save command #		ldx	#$0000save_parms		lda	<drvr_dev_num,x		; save GS/OS call parameters		pha		lda	<drvr_blk_num,x		pha		inx		inx		cpx	#$000C			; up to but not including DRVR_TRAN_CNT		bne	save_parms		lda	>pcmd			; save absolute zero page parameters		pha		lda	>pbuffer		pha		lda	>pblock		pha		lda	>$00CFFF		; bang out all peripheral cards		tya				; restore command #		asl	a			; make index to dispatch table		tax		jsr	(dispatch,x)		; get dispatch entry		tay				; save error code		pla		sta	>pblock		pla		sta	>pbuffer		pla		sta	>pcmd		ldx	#$000A			; number of words to restorerestore_parms		pla				; restore GS/OS call parameters		sta	<drvr_blk_num,x		pla		sta	<drvr_dev_num,x		dex		dex		bpl	restore_parms		pld				; restore environment		plb		bcs	gen_exit		; force error code 0 if flag cleared		ldy	#no_errorgen_exit		tya				; restore error code		rtl** Received an illegal request.  Return with an error.*g_illegal_req		pld				; restore environment		plb		lda	#drvr_bad_req		; set error		sec		rtl** The following is a table of dispatch entry points for driver functions.*dispatch	dc.w	g_startup		; entry for startup function		dc.w	g_open			; entry for open function		dc.w	g_read			; entry for read function		dc.w	g_write			; entry for write function		dc.w	g_close			; entry for close function		dc.w	g_status		; entry for status function		dc.w	g_control		; entry for control function		dc.w	g_flush			; entry for flush function		dc.w	g_shutdn		; entry for shutdown function		eject****************************************************************** This routine is used to startup a generated device driver.* This routine will only be called by the device dispatcher* when the device list is being constructed.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_startup		longa	on		longi	on		jmp	return_no_err		eject******************************************************************* ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = SmartPort Command*               B Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = SmartPort Command*               X Reg = Points to parameter list in bank 0*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************setup_sp_call		longa	on		longi	on				lda	>call_list_ptr	; get address where command resides		tax		tya			; set SmartPort command		sta	>0,x		lda	#param_list_ptr	; set parameter list pointer		sta	>1,x		tay		lda	#$EAEA		; 2 nop instructions		sta	>3,x		tyx			; point into parameter list		ldy	#slot_num	; setup fw_addr with entry point		lda	[<drvr_dib_ptr],y		and	#$0007		; limit to slots 1-7		xba		ora	#$C0FF		sta	<fw_addr		sep	#$20		; 8 bit 'm'		longa	off		lda	[<fw_addr]	; get entry point offset from $Cn00		clc			; bias for SmartPort		adc	#$03		sta	<fw_addr		iny			; need correct unit number from dib		iny		lda	[<drvr_dib_ptr],y		xba		lda	#$03		; parameter count is 3		rep	#$20		longa	on		sta	>0,x		; set SmartPort pcnt & unit number		lda	#sys_buffer	; buffer pointer		sta	>2,x		rts		eject****************************************************************** This routine is used to open a character device driver.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_open		longa	on		longi	on				jsr	check_if_char		; is the device a character device		bne	g_open_done		; no, it's a block device		ldy	#open_flag		; is the device already open?		lda	[<drvr_dib_ptr],y		bmi	g_prior_open		; yes, don't need to do it again		jsl	bank0_dsptch		; and issue device level open		bcs	cant_open		lda	#$FFFF			; else set device open		ldy	#open_flag		sta	[<drvr_dib_ptr],yg_open_done		jmp	return_no_errg_prior_open					; Driver error, already open		lda	#drvr_prior_open		seccant_open		rts				eject****************************************************************** This routine is used determine if the device currently being* accessed is a character device.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Block or character device bit from characteristics*               X Reg = Unchanged*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x 0 x  0	if block device*                       x x 0 0 0 x 1 x  0	if character device*****************************************************************check_if_char		longa	on		longi	on				ldy	#dev_char		; is the device a character device		lda	[<drvr_dib_ptr],y		and	#$0080		rts						eject****************************************************************** This routine is used read data from either a generated* character or block device.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_read		longa	on		longi	on		ldy	#dev_char		; check device for read allowed		lda	[<drvr_dib_ptr],y		tax		and	#$0020		bne	read_allowed		lda	#invalid_access		; read not allowed erruh		sec		rtsread_allowed** Determine if the device is a character or block device.*		txa		xba		rol	a		bcc	char_read		; if device is a character device		jmp	block_read		; if device is a block device		eject** The following routine is executed only if the read call* is directed toward a character device.  A read from the* device is only allowed if the device is open.*char_read		lda	<drvr_blk_size		; is it a character read?		beq	char_read_ok		; yep		lda	#not_block_dev		; not a block device error		sec		rtschar_read_ok		ldy	#open_flag		; is device open?		lda	[<drvr_dib_ptr],y		bne	dev_is_open		; yes		lda	#drvr_not_open		sec		rts** The device is open.  Check for device class for dispatch* to proper routine.*dev_is_open		lda	<drvr_req_cnt		ora	<drvr_req_cnt+2		bne	valid_req_c0		jmp	return_no_errvalid_req_c0		ldy	#drvr_class		; is this a class 0 character device?		lda	[<drvr_dib_ptr],y		and	#$000F		bne	not_c0_char		; no		eject** Only single character I/O transactions are possible with* class 0 devices.  Need to know if this is a class 0 device.*		ldy	#$0000			; buffer indexc0_char_loop		phy		jsl	bank0_dsptch		; read character from device		ply		php				; save carry		sep	#$20			; 8 bit 'm'		longa	off		sta	[<drvr_buf_ptr],y	; place returned character into buffer		rep	#$20			; 16 bit 'm'		longa	on		inc	<drvr_tran_cnt		; bump transfer count		bne	c0_tran_bump		inc	<drvr_tran_cnt+2c0_tran_bump		iny				; next buffer location		bne	c0_buf_loc		inc	<drvr_buf_ptr+2c0_buf_loc		plp				; retrieve error status returned by bank 0		bcs	c0_char_err		; if device returned an error		jsr	chk_request_cnt		; was requested count exhausted?		bcs	c0_char_loop		; no		rtsc0_char_err		xba				; place error code in low byte		and	#$00FF			; clear high byte		rts				; and back to dispatcherchk_request_cnt		lda	<drvr_req_cnt		; was requested count exhausted?		cmp	<drvr_tran_cnt		bne	req_pending		lda	<drvr_req_cnt+2		cmp	<drvr_tran_cnt+2		bne	req_pending		clc		rtsreq_pending		sec		rts		eject** Class 1 devices must be double buffered if the buffer address* is not in bank 0.  Need to know if this is a class 1 device.*not_c0_char		dec	a		bne	not_c1_char		; it must be a class 2 devicec1_char_loop		sec				; calculate remaining request count		lda	<drvr_req_cnt		sbc	<drvr_tran_cnt		tay		lda	<drvr_req_cnt+2		sbc	<drvr_tran_cnt+2		bne	c1_req_max		; remainder exceeds max packet		cpy	#768		bge	c1_req_max		; remainder exceeds max packet		sty	<drvr_blk_size		; set remainder as size		bra	c1_size_okc1_req_max		lda	#767			; set request = max packet size		sta	<drvr_blk_sizec1_size_ok		lda	<drvr_buf_ptr		; setup for double buffering		sta	<buf_ptr		lda	<drvr_buf_ptr+2		sta	<buf_ptr+2		lda	#sys_buffer		sta	<drvr_buf_ptr		stz	<drvr_buf_ptr+2		jsl	bank0_dsptch		; read character from device		bcs	c1_err_exit		jsl	system_to_buf		; copy data to ultimate destination		jsr	chk_request_cnt		; was requested count exhausted?		bcs	c1_char_loopc1_err_exit		stz	<drvr_blk_size		; $0000 for character devices		rts		eject** Class 2 devices require no double buffering.*not_c1_charc2_char_loop		sec				; calculate remaining request count		lda	<drvr_req_cnt		sbc	<drvr_tran_cnt		tay		lda	<drvr_req_cnt+2		sbc	<drvr_tran_cnt+2		bne	c2_req_max		; remainder exceeds max packet		cpy	#768		bge	c2_req_max		; remainder exceeds max packet		sty	<drvr_blk_size		; set remainder as size		bra	c2_size_okc2_req_max		lda	#767			; set request = max packet size		sta	<drvr_blk_sizec2_size_ok		jsl	bank0_dsptch		; read character from device		bcs	c2_err_exit		jsr	chk_request_cnt		; was requested count exhausted?		bcs	c2_char_loopc2_err_exit		stz	<drvr_blk_size		; $0000 for character devices		rts		eject******************************************************************* The following routine is executed only if the read call is* directed toward a block device.  If the request count or initial* block number is invalid, return with the appropriate error.******************************************************************block_read		longa	on		longi	on				jsr	calc_n_blk		; check request_cnt = block_size * n		bcc	req_cnt_ok		; ok if integral multiple		rts				; else return with errorreq_cnt_ok		lda	<drvr_req_cnt		ora	<drvr_req_cnt+2		bne	valid_req_b		jmp	return_no_err** Generated drivers maintain a cache enable mask in* the GDIB to prevent RAM or ROM disks from being* cached.  Set the current cache enable based on* the mask.*valid_req_b		ldy	#cache_mask		lda	[<drvr_dib_ptr],y		and	<drvr_cache		sta	<drvr_cache** A different algorithm is executed for class 2 devices.* Determine what class device is being used before* executing the block read.*		ldy	#drvr_class		lda	[<drvr_dib_ptr],y		cmp	#$0002		bne	block_read_01		; if it's a class 0 or 1 device		jmp	block_read_2		; only if it's a class 2 device		eject** The following routine is executed for read calls directed* toward class 0 or class 1 block devices.*block_read_01		bit	<drvr_fst_num		; is this a deferred ID access		bmi	c01_dev_acc		; yes, force device access		clc				; specify block search		jsl	cache_find_blk		; is the block in the cache?		bcs	c01_dev_acc		; no, may want to cache it though.		jsl	cache_to_buff		; yes, read block from cache to buffer		ldy	#dev_char		; is device removable media?		lda	[<drvr_dib_ptr],y		and	#$0004		beq	c01_next_block		; not removable - dont status		jsr	c0_dev_stat		; check for disk switched error** The following five lines were added to accomodate ProDOS devices that return* a write protected error on a readblock call.  *		bcc	c01_next_block		; if no error was returned from firmware		cmp	#drvr_wr_prot		; was the error a write protect error?		beq	c01_next_block		; Yes, ignore it (not valid error on readblock)		sec				; else normal error handling follows		bra	c01_errorc01_next_block** Block has been read.  Need to adjust the block address* and buffer pointer in preperation for the next read if* a multiple block transaction is in process.  If the* request count has been satisfied, no further action is required.*		jsr	adj_buf_ptr		; point at next buffer		jsr	adjust_block		; prepare for next block		bcc	block_read_01		; more blocks to read		clc				; all done with no errors		lda	#$0000c01_error		rts** This routine accesses the device directly.  If the buffer* address specified in the call is not in bank0, the data* must be double buffered through the bank0 system buffer.*c01_dev_acc		lda	<drvr_buf_ptr+2		; is buffer in bank 0?		bne	double_buffer		; no, must double buffer data		jsl	bank0_dsptch		; read data from device to buffer		bcs	c01_error		; if error from devicec01_cache		bit	<drvr_fst_num		; is this a deferred ID access		bmi	c01_next_block		; no, dont cache this block		lda	<drvr_cache		; should this block be cached		beq	c01_next_block		; no		jsl	cache_add_blk		; request a block from the cache		bcs	c01_next_block		; no block was available for caching		jsl	buff_to_cache		; copy data to cached block		bra	c01_next_block		; and loop for next block** Preserve the current buffer pointer while redirecting the* current I/O request to the system buffer in bank 0.*double_buffer		ldy	<drvr_buf_ptr+2		; save current buffer pointer		ldx	<drvr_buf_ptr		phy		phx		lda	#sys_buffer		; new destination is system buffer		sta	<drvr_buf_ptr		stz	<drvr_buf_ptr+2		jsl	bank0_dsptch		; read block into system buffer		plx				; restore current buffer pointer		ply		sty	<drvr_buf_ptr+2		stx	<drvr_buf_ptr		bcs	c01_error		; if driver error		jsl	system_to_buf		; copy data to ultimate destination		bra	c01_cache		; now execute caching		eject** The following routine is executed for read calls* directed toward class 2 block devices.*block_read_2		bit	<drvr_fst_num		; force device access		bmi	c2_dev_acc		clc				; specify block search		jsl	cache_find_blk		; is the block in the cache?		bcs	c2_not_cached		; no, may want to cache it though.		jsl	cache_to_buff		; yes, read block from cache to buffer		ldy	#dev_char		; is device removable media?		lda	[<drvr_dib_ptr],y		and	#$0004		beq	c2_no_purge		; not removable - dont status		jsr	c2_dev_stat		; check for disk switched error		bcs	c2_errorc2_no_purge** Block has been read.  Need to adjust the block address* and buffer pointer in preperation for the next read if* a multiple block transaction is in process.  If the* request count has been satisfied, no further action is required.*		jsr	adj_buf_ptr		; adjust new buffer address		jsr	adjust_block		; prepare for next block		bcc	block_read_2		; more blocks to read		clc				; all done with no errors		lda	#$0000c2_error		rts** If block is not in cache or volume ID is zero, must force* access to the device to read the block.*c2_dev_acc		jsl	bank0_dsptch		; force access to the device		bcs	c2_error		; if error from device		bra	c2_no_purge		; and continue with transaction** If block is not cached, action depends on the cache enable in the* current call.  If the cache enable is zero then must force access* to the device.  If cache enable is nonzero, a request for a block* for caching must be made of the cache manager.  If no block is granted,* then must force access to the device while reading only to the buffer.* if the block is granted, the block is read from the device to the buffer* and then transferred from the buffer to the cache.*c2_not_cached		lda	<drvr_cache		; is the enable = 0?		beq	c2_dev_acc		; yes, force device access w/o caching		jsl	bank0_dsptch		; force access to the device		bcs	c2_error		; if error from device		jsl	cache_add_blk		; request a block for caching		bcs	c2_no_cache		jsl	buff_to_cache		; copy data to the cachec2_no_cache		bra	c2_no_purge		; and continue with transaction		eject******************************************************************* The following routine is used to increment the block address* in preperation for the next I/O transaction. Then the transfer* count is compared to the request count with the carry set as a* result of the compare.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if transfer count ³ request count*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if transfer count < request count******************************************************************adjust_block		longa	on		longi	on		clc				; update transfer count		lda	<drvr_blk_size		adc	<drvr_tran_cnt		sta	<drvr_tran_cnt		bcc	no_tran_carry		inc	<drvr_tran_cnt+2no_tran_carry		inc	<drvr_blk_num		; point at next block		bne	no_blk_carry		inc	<drvr_blk_num+2no_blk_carry		lda	<drvr_tran_cnt+2		cmp	<drvr_req_cnt+2		; compare MSB trans to req		bcc	tran_req_done		lda	<drvr_tran_cnt		; compare LSB trans to req		cmp	<drvr_req_cnttran_req_done		rts				; carry set if I/O transaction done		eject******************************************************************* This routine is used to calculate the number of contiguous* blocks to be read from the device.  An error will be* returned if the request count is zero or is not an* integral multiple of the block size.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code or unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error******************************************************************calc_n_blk		longa	on		longi	on				lda	#$0000		pha			; space for remainder		pha		pha			; space for quotient		pha		pei	<drvr_req_cnt+2	; numerator		pei	<drvr_req_cnt		pea	$0000		; denominator		pei	<drvr_blk_size		_longdivide		ldx	#drvr_bad_parm	; bad parameter error		pla			; number of blocks to read		sta	>block_cnt		pla		sta	>block_cnt+2		pla			; remainder count		ora	1,s		sta	1,s		pla		bcs	req_error	; if tool returned error (div by 0?)		beq	no_req_error		secreq_error		txa			; restore error codeno_req_error		rts		eject******************************************************************* The following routine updates the buffer pointer after a* block read.** ENTRY:        A Reg = Error code from device*               X Reg = Transfer Count*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                           0 0 0        0*                       x x       x x x     PRESERVED******************************************************************adj_buf_ptr		longa	on		longi	on				php		pha		clc			; adjust buffer pointer		lda	<drvr_blk_size		adc	<drvr_buf_ptr		sta	<drvr_buf_ptr		lda	#$0000		adc	<drvr_buf_ptr+2		sta	<drvr_buf_ptr+2		pla		plp		rts		eject******************************************************************* The following routine sets up location FW_ADDR to point at* the SmartPort entry point prior to executing a call to the* midpoint entry within the bank 0 dispatcher.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************setup_fwaddr		longa	on		longi	on				pha		phy		ldy	#slot_num	; get current device slot #		lda	[<drvr_dib_ptr],y		and	#$0007		; limit to internal slot ref		xba		ora	#$C0FF		; now have $CnFF		sta	<fw_addr		stz	<fw_addr+2		sep	#$20		; 8 bit 'm'		longa	off		lda	[<fw_addr]	; ($CnFF)		clc		adc	#$03		sta	<fw_addr	; $Cn00 + ($CnFF) + 3		rep	#$20		; 16 bit 'm'		ply		pla		rts		eject******************************************************************* The following routine issues a status call to any class* device to check for disk switched or offline.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Condition code*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error******************************************************************get_dev_stat		longa	on		longi	on		phx		phy		ldy	#drvr_class		lda	[<drvr_dib_ptr],y		and	#$003F		; is this a class 0 device?		beq	c0_stat_entry	; yes		dec	a		; is this a class 1 device?		beq	c0_stat_entry	; yes		phb					pea	$0000		; data bank must point at parameter list		plb		plb		ldy	#unit_num	; insert the unit number into the parameter lists		lda	[<drvr_dib_ptr],y				sep	#$20		; 8 bit 'm'		longa	off				sta	>esp_stat3+6				rep	#$20		; 16 bit 'm'		longa	on				jmp	c2_stat_entry	; then must be a class 2 device		eject******************************************************************* The following routine issues a status call to a class 0 or 1* device to check for disk switched.  If the device is a UniDISK3.5,* then a condition code will be returned from the device.  All* other class 1 devices indicate disk switched through bit 0 of* the general status byte returned on a device status call.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Condition code*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error******************************************************************c0_dev_stat		longa	on		longi	on		phx		phyc0_stat_entry		ldy	#drvr_class		lda	[<drvr_dib_ptr],y		and	#$003F		; is this a class 0 device?		beq	c0_disksw_stat	; yes, can only check for offline		ldy	#unit_num		lda	[<drvr_dib_ptr],y		pha		jsr	setup_sp_stat	; setup bank0 core for status call		longa	off		pla			; need device unit number in parmlist		ldx	#param_list_ptr	; pointer to parameter list		sta	>1,x		; set unit number in parameter list		pla			; clean up stack		rep	#$20		; 16 bit 'm'		longa	on		jsr	setup_fwaddr	; fw_addr = $Cn00 + ($CnFF) + 3		jsl	b0_core		; execute device status call		tax		bcs	c0_dsw_done*  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | SmartPort General Status Byte* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |__ 1 = Disk switched*   |   |   |   |   |   |   |______ 1 = Device currently interrupting*   |   |   |   |   |   |__________ 1 = Write protect*   |   |   |   |   |______________ 1 = Format allowed*   |   |   |   |__________________ 1 = Device online or Disk in drive*   |   |   |______________________ 1 = Read allowed*   |   |__________________________ 1 = Write allowed*   |______________________________ 1 = Block device*		ldx	#drvr_disk_sw	; assume it's switched		lda	>sys_buffer		eor	#$0010		; change online to offline		and	#$0011		; offline or disksw?		lsr	a		bcs	c0_dsw_done	; assumed correct		sec		php		ldx	#drvr_off_line	; assume it's offline		plp		bne	c0_dsw_done	; assumed correct		ldx	#no_error		clcc0_dsw_done 		txa			; restore error code		ply		plx		rts** If a class 0 block device, can only determine online from* a status call.  This will be mapped into a diskswitched* error resulting in flushing the volume from the cache and* a subsequent swap_out call.  Note that a status call cannot* be issued to a ProFILE at this time due to firmware problems.* Device specific code may be added later to handle the ProFILE.*c0_disksw_stat		ldx	#no_error	; assume it's a ProFILE		clc		ldy	#dev_id_num	; is it a ProFILE?		lda	[<drvr_dib_ptr],y		dec	a		beq	c0_dsw_done	; yes, it's ProFILE 5meg		dec	a		beq	c0_dsw_done	; yes, it's ProFILE 10meg** It's not a ProFILE so set up the bank 0 dispatcher to issue a* status call to the ProDOS interface to determine device status.*		lda	>call_list_ptr	; insert 5 dispatcher 'NOP's		tax		lda	#$EAEA		sta	>0,x		sta	>2,x		sta	>3,x		ldy	#slot_num	; set up fw_addr = $Cn00 + ($CnFF)		lda	[<drvr_dib_ptr],y		and	#$0007		xba		ora	#$C0FF		sta	<fw_addr		stz	<fw_addr+2	; fw_addr = $00Cn00 + ($00CnFF)		sep	#$20		; 8 bit 'm'		longa	off		lda	[<fw_addr]		sta	<fw_addr** Need to setup absolute direct page for dispatch to ProDOS* block device status call.  Only the slot/unit parameter* needs to be constructed as follows:*  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | = PUNIT* |___|___|___|___|___|___|___|___|*   |   |   |   |   |___|___|___|____ UNDEFINED*   |   |___|___|____________________ SLOT NUMBER*   |________________________________ UNIT NUMBER*		ldy	#unit_num	; get unit number (v0.06 a02)		lda	[<drvr_dib_ptr],y		dec	a		lsr	a		; unit to carry		php		lda	<fw_addr+1	; get $Cn		ror	a		ror	a		ror	a		ror	a		plp		ror	a		; now have slot/unit		xba		lda	#$00		rep	#$20		; 16 bit 'm'		longa	on		sta	>pcmd		; set up for dispatch		jsl	b0_core		; and execute status call		tax			; return device status		bra	c0_dsw_done		eject******************************************************************* The following routine issues a status call to a class 2 device* to check for disk switched.  Class 2 devices indicate disk* switched through bit 0 of the general status byte returned* on a device status call.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = K*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Condition code*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error******************************************************************c2_dev_stat		longa	on		longi	on		phx		phy		phb		pea	$0000			; point data bank at call list bank		plb		plb		ldy	#unit_num		; insert the unit number into the parameter lists		lda	[<drvr_dib_ptr],y				sep	#$20			; 8 bit 'm'		longa	off				sta	>sp_stat3+4		sta	>esp_stat3+6				rep	#$20			; 16 bit 'm'		longa	on				ldy	#drvr_class		; is this SmartPort or extended SmartPort?		lda	[<drvr_dib_ptr],y		dec	a		bne	c2_stat_entry		; it's extended SmartPort		ldx	#sp_stat3		; X = pointer to call list		lda	<drvr_dev_num		; execute SmartPort call		jsl	to_b0_core		bra	sp_stat_check		c2_stat_entry		ldx	#esp_stat3		; X = pointer to call list		lda	<drvr_dev_num		; execute extended SmartPort call		jsl	to_b0_core				eject**  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | SmartPort General Status Byte* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |__ 1 = Disk switched*   |   |   |   |   |   |   |______ 1 = Device currently interrupting*   |   |   |   |   |   |__________ 1 = Write protect*   |   |   |   |   |______________ 1 = Format allowed*   |   |   |   |__________________ 1 = Device online or Disk in drive*   |   |   |______________________ 1 = Read allowed*   |   |__________________________ 1 = Write allowed*   |______________________________ 1 = Block device*sp_stat_check		plb		ldx	#$0000			; assume no error		lda	>sys_buffer		; get general status byte		ror	a			; bit 0 = DISKSW		bcs	c2_dsw_stat		; if disk switch occured		and	#$0008			; is device off line?		bne	c2_dsw_done		; noc2_dsw_stat		sec		ldx	#drvr_disk_sw		; else report errorc2_dsw_done		txa				; restore error code		ply		plx		rts		eject****************************************************************** This routine is used to write to either a character or a* block device. Note that a deferred write mode has been* implemented for block devices.  If a block has a cache* priority of =>$8000 then the block will only be written* to the device if a cached block is not available for the* data.  If a cached block is available then the data will* be written to the cache and NOT to the device.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_write		longa	on		longi	on		ldy	#dev_char	; check device for write allowed		lda	[<drvr_dib_ptr],y		tax		and	#$0040		bne	write_allowed		lda	#invalid_access	; write not allowed erruh		sec		rtswrite_allowed** Determine if the device is a character or block device.*		txa		xba		rol	a		bcc	char_write	; it's a character device		jmp	block_write	; it's a block device		eject** The following routine is executed only if the write call* is directed toward a character device.*char_write		lda	<drvr_blk_size		; is it a character read?		beq	char_write_ok		; yep		lda	#not_block_dev		; not a block device error		sec		rtschar_write_ok		ldy	#open_flag		; is device open?		lda	[<drvr_dib_ptr],y		bne	device_is_open		; yes		lda	#drvr_not_open		sec		rts** The device is open.  Only single character I/O transactions* are possible with class 0 devices.  Need to know if this is* a class 0 device.*device_is_open		lda	<drvr_req_cnt		; any request?		ora	<drvr_req_cnt+2		bne	valid_req_c0w		jmp	return_no_errvalid_req_c0w		ldy	#drvr_class		; is this a class 0 character device?		lda	[<drvr_dib_ptr],y		and	#$000F		bne	not_cl0_char		; no		ldy	#$0000			; buffer indexcl0_char_loop		sep	#$20			; 8 bit 'm'		longa	off		lda	[<drvr_buf_ptr],y		rep	#$20			; 16 bit 'm'		longa	on		phy		jsl	bank0_dsptch		; read character from device		ply		inc	<drvr_tran_cnt		; bump transfer count		bne	cl0_tran_bump		inc	<drvr_tran_cnt+2cl0_tran_bump		iny				; next buffer location		bne	cl0_buf_loc		inc	<drvr_buf_ptr+2cl0_buf_loc		bcs	cl0_char_err		; if device returned an error		jsr	chk_request_cnt		; was requested count exhausted?		bcs	cl0_char_loop		rtscl0_char_err		xba				; place error code in low byte		and	#$00FF			; clear high byte		rts				; and back to dispatcher		eject** Class 1 devices must be double buffered if the buffer address* is not in bank 0.  Need to know if this is a class 1 device.*not_cl0_char		dec	a		bne	not_cl1_char		; it must be a class 2 devicecl1_char_loop		sec				; calculate remaining request count		lda	<drvr_req_cnt		sbc	<drvr_tran_cnt		tay		lda	<drvr_req_cnt+2		sbc	<drvr_tran_cnt+2		bne	cl1_req_max		; remainder exceeds max packet		cpy	#768		bge	cl1_req_max		; remainder exceeds max packet		sty	<drvr_blk_size		; set remainder as size		bra	cl1_size_okcl1_req_max		lda	#767			; set request = max packet size		sta	<drvr_blk_sizecl1_size_ok		lda	<drvr_buf_ptr		; setup for double buffering		sta	<buf_ptr		lda	<drvr_buf_ptr+2		sta	<buf_ptr+2		lda	#sys_buffer		sta	<drvr_buf_ptr		stz	<drvr_buf_ptr+2		jsl	buf_to_system		; copy data from ultimate destination		jsl	bank0_dsptch		; read character from device		bcs	cl1_err_exit		jsr	chk_request_cnt		; was requested count exhausted?		bcs	cl1_char_loopcl1_err_exit		stz	<drvr_blk_size		; $0000 for character devices		rts		eject** Class 2 devices require no double buffering.*not_cl1_charcl2_char_loop		sec				; calculate remaining request count		lda	<drvr_req_cnt		sbc	<drvr_tran_cnt		tay		lda	<drvr_req_cnt+2		sbc	<drvr_tran_cnt+2		bne	cl2_req_max		; remainder exceeds max packet		cpy	#768		bge	cl2_req_max		; remainder exceeds max packet		sty	<drvr_blk_size		; set remainder as size		bra	cl2_size_okcl2_req_max		lda	#767			; set request = max packet size		sta	<drvr_blk_sizecl2_size_ok		jsl	bank0_dsptch		; read character from device		bcs	c2_error_exit		lda	<drvr_tran_cnt		; was requested count exhausted?		jsr	chk_request_cnt		; was requested count exhausted?		bcs	cl2_char_loopc2_error_exit		stz	<drvr_blk_size		; $0000 for character devices		rts		eject** The following routine is executed only if the write call is* directed toward a block device.  If the request count or initial* block number is invalid, return with the appropriate error.*block_write		jsr	calc_n_blk	; check request_cnt = block_size * n		bcc	bwr_req_cnt_ok	; ok if integral multiple		rts			; else return with errorbwr_req_cnt_ok		lda	<drvr_req_cnt	; any request?		ora	<drvr_req_cnt+2		bne	valid_req_b0w		jmp	return_no_err** Generated drivers maintain a cache priority mask in* the GDIB to prevent RAM or ROM disks from being* cached.  Set the current cache priority based on* the mask.*valid_req_b0w		ldy	#cache_mask		lda	[<drvr_dib_ptr],y		and	<drvr_cache		sta	<drvr_cache** A different algorithm is executed for class 2 devices.* Determine what class device is being used before* executing the block write.*		ldy	#drvr_class		lda	[<drvr_dib_ptr],y		cmp	#$0002		bne	block_wr_01	; if it's a class 0 or 1 device		jmp	block_wr_2	; only if it's a class 2 device		eject** The following routine is executed for write calls directed* toward class 0 or class 1 block devices.*block_wr_01		clc			; specify block search		jsl	cache_find_blk	; is block in cache?		bcc	c01_wr_cache	; yes, write to cache		lda	<drvr_cache	; should block be cached?		beq	c01_wr_dev	; no		jsl	cache_add_blk	; else request a block		bcs	c01_wr_dev	; if block couldn't be allocatedc01_wr_cache		jsl	buff_to_cache	; write block to cache		clc			; no error in case deferred mode		bit	<drvr_cache	; deferred mode?		bpl	c01_wr_dev	; no		jsr	adj_buf_ptr	; set next buffer address		bra	wr01_donec01_wr_dev		lda	<drvr_buf_ptr+2	; is buffer in bank 0?		bne	dbl_buffer	; no, must double buffer data		jsl	bank0_dsptch	; write data to device from buffer		jsr	adj_buf_ptr	; set next buffer address		bra	wr01_donedbl_buffer		jsl	buf_to_system		lda	<drvr_buf_ptr	; save destination pointer		sta	<buf_ptr		lda	<drvr_buf_ptr+2		sta	<buf_ptr+2		lda	#sys_buffer	; new destination is system buffer		sta	<drvr_buf_ptr		stz	<drvr_buf_ptr+2		jsl	bank0_dsptch	; read block into system buffer		php			; save device error flag		pha			; save device error code		clc			; calculate next destination address		lda	<buf_ptr		adc	<drvr_blk_size		sta	<drvr_buf_ptr		lda	<buf_ptr+2		adc	#$0000		sta	<drvr_buf_ptr+2		pla			; restore device error code		plp			; restore device error flagwr01_done		bcs	wr_error	; exit if an error occured!		jsr	adjust_block	; else, prepare for next block		bcc	block_wr_01	; more blocks to write		jmp	return_no_errwr_error		rts		eject** The following routine is executed for write calls* directed toward class 2 block devices.*block_wr_2		clc			; specify block search		jsl	cache_find_blk	; is the block in the cache?		bcc	c2_wr_cache	; yes, xfer from buf to cache		lda	<drvr_cache	; add to cache?		beq	c2_wr_dev	; no		jsl	cache_add_blk	; else add block to cache		bcs	c2_wr_dev	; if block was not allocatedc2_wr_cache		jsl	buff_to_cache	; yes, read block from cache to buffer		bit	<drvr_cache	; deferred mode?		bmi	c2_wr_done	; yes, dont xfer to devicec2_wr_dev		jsl	bank0_dsptch	; write through to the device		bcs	wr_error	; if device returned errorc2_wr_done		jsr	adj_buf_ptr	; set next buffer address		jsr	adjust_block	; set next block address		bcc	block_wr_2	; if more blocks to write		jmp	return_no_err		eject****************************************************************** This routine is used to close a character device driver.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_close		longa	on		longi	on				jsr	check_if_char	; is the device a character device		bne	g_close_done	; no, it's a block device		ldy	#open_flag	; is the device already closed?		lda	[<drvr_dib_ptr],y		bpl	g_prior_close	; yes, don't need to do it again		lda	#$0000		; else set device closed		sta	[<drvr_dib_ptr],y		ldy	#drvr_class	; is this a class 0 device		lda	[<drvr_dib_ptr],y		and	#$000F		beq	g_close_done	; yes, dont issue a device call		jsl	bank0_dsptch	; and issue device level close		rtsg_close_done		clc		rtsg_prior_close				; ; Driver error, already closed		lda	#drvr_not_open		sec		rts		eject****************************************************************** This routine is used to startup a generated device driver.* This routine will only be called by the device dispatcher* when the device list is being constructed.** Status calls include: $0000 Return Device Status*                       $0001 Return Control Parameters*                       $0002 Return Wait / No Wait Status*                       $0003 Return Format Options*                       $0004 Return Partition Map** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_status		longa	on		longi	on** Need to verify that the status code specifies a* legal status request.*		lda	<drvr_stat_code		; is this a legal status request?		cmp	#$0005		blt	legal_status		; yes		lda	#drvr_bad_code		; else return 'BAD CODE' error		rts** It's a legal status.  Dispatch to the appropriate status routine.*legal_status		asl	a		tax		jmp	(status_dispatch,x)	; return through appropriate handler		eject******************************************************************* Class 0 generated drivers do not support any meaningful device* status call.  A device status word will be generated based on* information in the DIB for class 0 devices.  Class 1 and 2 devices* support a device status call.  A SmartPort status 0 call will be* issued to these devices and the general SmartPort status byte will* be used to generate a device status word.  Character device status* is based on the open flag maintained in the GDIB.** Status List:  Word    Device Status*               Long    Block Count******************************************************************dev_status		longa	on		longi	on		ldx	#drvr_bad_parm		; assume invalid request count		lda	<drvr_req_cnt+2		; request must be for 6 bytes!		bne	to_stat_errchk_lo_req		lda	<drvr_req_cnt		cmp	#$0002			; request > or = to minimum?		blt	to_stat_err		; no		cmp	#$0007			; request < or = to maximum?		blt	ds_req_cnt_ok		; yesto_stat_err		jmp	status_errds_req_cnt_ok		jsr	check_if_char		; is the device a character device?		bne	block_dev_s		; no, it's a block device** Character device status is returned as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |__ OPEN*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |______ INTERRUPT*   |   |   |   |   |   |   |   |   |   |   |   |   |___|__________ 0 RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |__________________ ONLINE*   |   |   |   |   |   |   |   |   |   |   |______________________ BUFFER FULL*   |   |   |   |___|___|___|___|___|___|__________________________ 0 RESERVED*   |   |   |______________________________________________________ BACKGROUND BUSY*   |   |__________________________________________________________ LINKED*   |______________________________________________________________ 0 RESERVED*		lda	#%0000000000010000	; preinitialize device status		sta	[<drvr_slist_ptr]				lda	#$0001			; Pascal1.1 status is request for input ready		jsl	bank0_dsptch		bcc	have_c_stat		; if no character available				lda	[<drvr_slist_ptr]	; indicate buffer not empty		ora	#%0000000000100000		sta	[<drvr_slist_ptr]have_c_stat		ldy	#open_flag		; driver must have a GDIB		lda	[<drvr_dib_ptr],y		and	#%0000000000000001		ora	[<drvr_slist_ptr]	; insert open/closed status bit		sta	[<drvr_slist_ptr]		sep	#$20			; 8 bit 'm'		longa	off		ldy	#$0002			; block count is zero for character		lda	#$00c_stat_loop		cpy	<drvr_req_cnt		; xfer data to status list		beq	c_stat_done		sta	[<drvr_slist_ptr],y		iny		bra	c_stat_loopc_stat_done		rep	#$20			; 16 bit 'b'		longa	ondev_stat_xfer		lda	<drvr_req_cnt		; set transfer count		sta	<drvr_tran_cnt		jmp	stat_done		eject** Block device status is returned as follows:*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |__ DISK SW*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |______ INTERRUPT*   |   |   |   |   |   |   |   |   |   |   |   |   |   |__________ WRITE PROT*   |   |   |   |   |   |   |   |   |   |   |   |   |______________ 0 RESERVED*   |   |   |   |   |   |   |   |   |   |   |   |__________________ ONLINE*   |   |   |   |___|___|___|___|___|___|__________________________ 0 RESERVED*   |   |   |______________________________________________________ BACKGROUND BUSY*   |   |__________________________________________________________ LINKED*   |______________________________________________________________ BLOCK COUNT UNCERTAIN*block_dev_s		ldy	#drvr_class		; is this a class 0 device?		lda	[<drvr_dib_ptr],y		and	#$000F		bne	not_class_0		; no** Class 0 device's can only return wrprot or offline as an* error code.  Issue a status call and check the error status* in order to generate a general status word.  Then set the* block count based on the DIB contents.*		jsl	bank0_dsptch		; call ProDOS block device		tay		lda	#$0010			; assume media online		bcc	set_c0_dstat		; assumed correct		lda	#$0014			; else, assume write protected		cpy	#drvr_wr_prot		; is device write protected?		beq	set_c0_dstat		; yes		lda	#$0000			; else it's off lineset_c0_dstat 		sta	[<drvr_slist_ptr]		sta	>sys_buffer				ldy	#drvr_class		; is this a class 0 device?		lda	[<drvr_dib_ptr],y		beq	to_c0_blk_stat		; yes, DIB block count is not dynamic				ldy	#dev_char		; is this a removable media device?		lda	[<drvr_dib_ptr],y		and	#$0004		beq	c0_blk_stat		; no, DIB block count is not dynamic				ldy	#blk_cnt		; set block count in DIB		txa		sta	[<drvr_dib_ptr],y		iny		iny		lda	#$0000		sta	[<drvr_dib_ptr],yto_c0_blk_stat		bra	c0_blk_stat** Class 1 and 2 devices may support dynamic block counts based* on the media type currently inserted.  Issue a call to the* device to determine the size and update the DIB prior to* returning the status and block count.*not_class_0		ldy	#blk_cnt		; assume that an error will occur		lda	[<drvr_dib_ptr],y		sta	>sys_buffer+1		iny		iny		lda	[<drvr_dib_ptr],y		sta	>sys_buffer+3		jsl	bank0_dsptch		; call SmartPort device		tax				; save error status		bcc	no_c1_err		; don't check error if wasnt one		and	#$00FF		cmp	#drvr_disk_sw		; was there a disk switched error?		beq	set_dsw_off		; yes		cmp	#drvr_off_line		; was the device off line?		beq	no_c1_err		; yes		cmp	#drvr_wr_prot		; was the device write protected?		beq	no_c1_err		; yesstatus_err 		sec				; assume error and set error flag		txa				; restore error code		bne	stat_err		; assumed correct		clcstat_err		rtsset_dsw_off		sep	#$20			; 8 bit 'm'		longa	off		lda	#$01			; set media switched & offline		sta	>sys_buffer		; fake diskswitched status		rep	#$20			; 16 bit 'm'		longa	on		bra	no_c1_err		eject** The SmartPort general status byte returned from the SmartPort* status call is as follows:*  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |     SmartPort general status byte* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |___    1 = Disk Switched or Open*   |   |   |   |   |   |   |_______    1 = Interrupt*   |   |   |   |   |   |___________    1 = Write Protect or Data Available*   |   |   |   |   |_______________    1 = Format Allowed*   |   |   |   |___________________    1 = Online*   |   |   |_______________________    1 = Read Allowed*   |   |___________________________    1 = Write Allowed*   |_______________________________    1 = Block Device, 0 = Character Device** Device manager D_INFO call has DRVR_SLIST_PTR set to the* SYS_BUFFER.  Updating the status word will write over the* block count so update the block count in the DIB prior to* returning the device status.*no_c1_err		ldy	#dev_char		; is this a removable media device?		lda	[<drvr_dib_ptr],y		and	#$0004		beq	c1_static		; yes, DIB block count is not dynamic				lda	>sys_buffer		; is device online?		and	#$0010		beq	c1_static		; no, dynamic DIB block count cannot be determined				ldy	#blk_cnt		; adjust block count in DIB		lda	>sys_buffer+1		sta	[<drvr_dib_ptr],y		iny		iny		lda	>sys_buffer+3		and	#$00FF		sta	[<drvr_dib_ptr],y** Now it is safe to return the general status word.*c1_static		lda	>sys_buffer		; get SmartPort general status byte		and	#$0017			; mask for GS/OS status		sta	>sys_buffer** Obtain the block count from the DIB and stuff it into the* caller's status list.*c0_blk_stat		ldy	#blk_cnt		; get block count in DIB		lda	[<drvr_dib_ptr],y		sta	>sys_buffer+2		tax		iny		iny		lda	[<drvr_dib_ptr],y		sta	>sys_buffer+4** Copy status information to status list as specified by* the current request count.*get_blk_stat		sep	#$20			; 8 bit 'm'		longa	off		ldy	#$0000		tyxb_stat_loop 		lda	>sys_buffer,x		sta	[<drvr_slist_ptr],y		inx		iny		cpy	<drvr_req_cnt		bne	b_stat_loop		rep	#$20			; 16 bit 'm'		longa	on** Check for a disk switched or offline condition.  If either of these* conditions exist then a disk switch must be posted to the system service* call tables for cache/vcr management.*		lda	[<drvr_slist_ptr]	; get current status		eor	#$0010			; is device offline or disk switched?		and	#$0011		beq	dev_stat_xfer0		; no		jsl	set_disksw		; else, swapout and del_cache_voldev_stat_xfer0		lda	<drvr_blk_size		; is this a standard block?		cmp	#512		bne	std_blk_ok		; yes		lda	[<drvr_slist_ptr]		ora	#$8000			; set unvalidated block count bit		sta	[<drvr_slist_ptr]std_blk_ok		jmp	dev_stat_xfer		eject******************************************************************* Generated drivers have no configuration parameter list.** Status List:  Word    Length of configuration parameter list*               Data    Configuration parameter list******************************************************************get_ctrl_parm		longa	on		longi	on						eject******************************************************************* Generated drivers only operate in wait moded since there is* no way to find out if data is available from a device.** Status List:  Word    Wait Mode******************************************************************get_wait_stat		longa	on		longi	on				ldx	#drvr_bad_parm		; assume that the request count is invalid		lda	<drvr_req_cnt+2		; is the request count = $00000002?		beq	get_wait		; yes, do the callx_stat_err		jmp	status_err		; else exit with errorget_wait		lda	<drvr_req_cnt		; was any data requested?		beq	nil_req			; no, no error & exit		cmp	#$0002			; were the correct number of bytes requested?		bne	x_stat_err		; nogive_em_squat		lda	#$0000			; return NO WAIT status		sta	[<drvr_slist_ptr]set_tran_cnt		lda	#$0002			; update transfer count		sta	<drvr_tran_cntnil_req		bra	stat_done		******************************************************************* Generated drivers do not support partitioning.  No partition map* will be returned in the status list.** Status List:  To be defined...******************************************************************get_partition		longa	on		longi	onstat_done		lda	#$0000		; no error from this call		clc		rts		eject******************************************************************* Generated drivers have limited support of the get format options* status call.  This call is issued directly to SmartPort devices.* If an error results, a default options list will be returned.* If an error is not generated, the list returned from the SmartPort* device is passed to the caller verbatim.** Status List:  Word    Entry count*               Word    Displayed entry count*               Word    Recommended default option*               Word    Option that current media is formatted* 16 byte entry:*               Word    Refnum*               Word    Linknum*               Word    Flags*               Long    Block count*               Word    Block size*               Word    Interleave factor*               Word    Media size******************************************************************get_format		longa	on		longi	on** Character Devices and class 0 block devices do not support this call.*		ldy	#drvr_class		lda	[<drvr_dib_ptr],y		cmp	#$0002		bne	no_options	; don't dispatch if can't get options		ldy	#drvr_subtype	; does this device support it?		lda	[<drvr_dib_ptr],y		and	#$0040		; bit 6 = SuperCalls ...		beq	no_options	; device doesnt support fmt options		lda	#drvr_bad_parm	; assume bad request count		ldx	<drvr_req_cnt+2	; verify request count		bne	no_options	; if invalid request count		sep	#$20		; 8 bit 'm'		longa	off		phk		pea	$0000		plb		plb		ldy	#unit_num	; install unit for device call		lda	[<drvr_dib_ptr],y		sta	|get_fmt_unit		rep	#$20		; 16 bit 'm'		longa	on		lda	<drvr_slist_ptr		sta	|get_fmt_slist		lda	<drvr_slist_ptr+2		sta	|get_fmt_slist+2		lda	<drvr_req_cnt	; and list buffer size		sta	|get_fmt_reqcnt		ldx	#get_fmt_list	; execute device call		lda	<drvr_dev_num		jsl	to_b0_core		plb		bcs	no_options	; no options if call unsuccessful		lda	<drvr_req_cnt	; else indicate buffer size		sta	<drvr_tran_cntno_options		jmp	return_no_err		eject******************************************************************* The following table is used to dispatch to status functions* specified by the status code passed on GS/OS direct page.******************************************************************status_dispatch	dc.w	dev_status		dc.w	get_ctrl_parm		dc.w	get_wait_stat		dc.w	get_format		dc.w	get_partition		eject****************************************************************** This routine is used to startup a generated device driver.* This routine will only be called by the device dispatcher* when the device list is being constructed.** Control call: $0000   Reset Device*               $0001   Format Device*               $0002   Eject Media*               $0003   Set Control Parameters*               $0004   Set Wait / No Wait Mode*               $0005   Set Format Options*               $0006   Set Partition Owner*               $0007   Arm Signal*               $0008   Disarm Signal*               $0009   Set Partition Map*       $000A - $7FFF   Reserved by Apple Computer, Inc.*       $8000 - $FFFF   Device Specific** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = 16 bit 'm' & 'x' native mode** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = 16 bit 'm' & 'x' native mode*****************************************************************g_control		longa	on		longi	on** Need to verify that the control code specifies a* legal control request.*		lda	<drvr_ctrl_code		; is this a legal control request?		cmp	#$000A		blt	legal_control		; yesbad_code_err		lda	#drvr_bad_code		; else return 'BAD CODE' error		rts** It's a legal control request.  Dispatch to the appropriate control routine.*legal_control		asl	a		tax		jmp	(ctrl_dispatch,x)	;return through appropriate handler		eject******************************************************************* This routine supports the device reset call.  Note that class* 0 devices cannot be reset.  Also, of class 1 devices, the UniDisk3.5* requires special attention.  The reset call does not work properly* on this device.  Instead, an execute call will be issued to this* device with an address of $E7D9.  This address forces all original* hooks to be restored within the UniDisk3.5.  This entry point is* supported on all versions of the UniDisk3.5 firmware.  All other* class 1 & 2 devices will receive a RESET call.** Control List: None******************************************************************dev_reset		longa	on		longi	on		ldy	#drvr_class		; is this a class 0 device?		lda	[<drvr_dib_ptr],y		and	#$007F		bne	maybe_unidisk		jmp	no_can_domaybe_unidisk		ldy	#drvr_type		; is it a 3.5 inch disk?		lda	[<drvr_dib_ptr],y		dec	a		bne	do_reset		; no, go ahead and issue a reset		iny				; is it a UniDisk3.5		iny		lda	[<drvr_dib_ptr],y		bne	do_reset		; no, go ahead and issue a reset** This routine executes the RESET_HOOK routine in the UniDisk3.5 firmware.*		ldy	#$0004			; SmartPort command is CONTROL		jsr	setup_sp_call		; setup for SmartPort control call		sep	#$20			; 8 bit 'm'		longa	off		lda	#$05			; ctrl code = Execute		sta	>4,x		rep	#$20			; 16 bit 'm'		longa	on		lda	#$0006			; count word		sta	>sys_buffer		lda	#$0000			; A = $00, X = $00		sta	>sys_buffer+2		lda	#$2400			; Y = $00, P   $24		sta	>sys_buffer+4		lda	#$E7D9			; PC = $E7D9		sta	>sys_buffer+6		jsl	b0_core			; execute		rtsdo_reset		jsl	bank0_dsptch		; issue reset to device		rts		eject******************************************************************* This routine is used to format a block device.  If the device is not* a block device then no action is taken and an INVALID_ACCESS error* will be returned.** Control List: None******************************************************************dev_format		longa	on		longi	on		jsr	check_if_char		; is the device a block device?		beq	no_can_do** It's a block device.  Go ahead and attempt to format the media.*format_blk_dev		clc		ldy	#dev_char		; is device format supported?		lda	[<drvr_dib_ptr],y		and	#$0008			; if not formattable then a=0 for no error		beq	dont_format		; no		jsl	bank0_dsptch		; else issue the formatdont_format		rts		eject******************************************************************* Issue an eject to a block device.  If this call is issued to a* character device then no action will be taken and no error will be returned.** Control List: None******************************************************************dev_eject		longa	on		longi	on		jsr	check_if_char		; is the device a block device?		beq	no_can_do		; no - no action required		ldy	#drvr_class		; is it a class 0 device		lda	[<drvr_dib_ptr],y		beq	no_can_do		; yes - no action required		ldy	#drvr_type		; is it a UniDisk3.5 drive?		lda	[<drvr_dib_ptr],y		cmp	#$0001		beq	do_dev_eject		; yes, eject it!		tax		ldy	#drvr_class		; is it a class 2 device		lda	[<drvr_dib_ptr],y		cmp	#$0002		bne	no_can_do		; no - no action required		txa		cmp	#$0005			; is it a SCSI CD-ROM?		beq	do_scsi_eject		; yes, try to eject it		cmp	#$0006			; is it a SCSI Tape?		beq	do_scsi_eject		; yes, try to eject it		cmp	#$0007			; is it a SCSI Hard Disk?		bne	no_can_do		; no - no action requireddo_scsi_eject		ldy	#drvr_class		; is this SCSI a class 2 device?		lda	[<drvr_dib_ptr],y		cmp	#$0002		bne	no_can_do		; no, don't try to eject it!do_dev_eject		jsl	bank0_dsptch		; else do eject		rts		eject******************************************************************* This routine supports the set configuration parameter call.* Generated drivers do not support configuration parameters.** Control List: Word    Length of control list*               Data    Configuration parameters******************************************************************set_ctrl		longa	on		longi	on		bra	no_can_do******************************************************************* This routine supports the set wait/no wait function.  Note that only* wait mode is supported by generated drivers.  Any attempt to set no* wait mode for generated drivers results in a BAD REQUEST error.** Control list: Word    Wait / No Wait Mode*               Long    No Wait Mode Completion Vector******************************************************************set_wait		longa	on		longi	on		ldx	#drvr_bad_parm		; assume that the request count is invalid		lda	<drvr_req_cnt+2		bne	go_status_err		lda	<drvr_req_cnt		; is the request count = $00000002?		cmp	#$0002		bne	go_status_err		; no, error		lda	[<drvr_clist_ptr]	; setting wait mode on?		bne	go_status_err		; no, can't do itno_can_do		lda	#$0000			; no error		clc		rtsgo_status_err	jmp	status_err		eject******************************************************************* This routine sets the format options in preperation* for a subsequent format call.  Only class 2 SmartPort* devices support this function.  *** NOTE *** This entire* call was rewritten for revision v0.29.** Control List: Word    Length of control list*               Word    Format reference number*               Word    Interleave factor******************************************************************set_fmt		longa	on		longi	on		ldy	#drvr_class	; is this a class 2 device		lda	[<drvr_dib_ptr],y		cmp	#$0002		bne	no_can_do	; no		phk		pea	$0000		plb		plb		ldy	#unit_num	; set SmartPort unit #		lda	[<drvr_dib_ptr],y		sta	|set_fmt_unit		lda	<drvr_clist_ptr	; set SmartPort control list ptr		sta	|set_fmt_clist		lda	<drvr_clist_ptr+2		sta	|set_fmt_clist+2		lda	<drvr_req_cnt	; set SmartPort request count		sta	|set_fmt_req		lda	<drvr_dev_num		ldx	#set_fmt_list		jsl	to_bank0_core	; call SmartPort		plb		bcc	set_fmt_done	; if SmartPort returned with no error		lda	<drvr_req_cnt	; else indicate buffer size		sta	<drvr_tran_cnt		jmp	return_no_errset_fmt_done		lda	<drvr_req_cnt	; indicate buffer size		sta	<drvr_tran_cnt		lda	<drvr_req_cnt+2		sta	<drvr_tran_cnt+2		bra	no_can_do	; not supported		eject******************************************************************* This routine is used to support partitioned devices and will* reassign an existing partition to the current FST.  Generated* drivers do not support this function.** Control List: Word    String Length*               String  Partition Owner******************************************************************set_partn		longa	on		longi	on******************************************************************* This routine is used to arm a signal tied to a driver and* envoked from an application.** Control List: Word    Signal Code*               Word    Priority*               Long    Signal Handler Address******************************************************************dev_arm		longa	on		longi	on******************************************************************* This routine is used to disarm a signal tied to a driver and* envoked from an application.** Control List: Word    Signal Code******************************************************************dev_disarm		longa	on		longi	on******************************************************************* This routine is used to set the partition map.  This call is* not supported by the generated driver.** Control List: To be defined....******************************************************************set_p_map		longa	on		longi	on		bra	no_can_do		eject******************************************************************* The following table is used to dispatch to status functions* specified by the status code passed on GS/OS direct page.******************************************************************ctrl_dispatch	dc.w	dev_reset		dc.w	dev_format		dc.w	dev_eject		dc.w	set_ctrl		dc.w	set_wait		dc.w	set_fmt		dc.w	set_partn		dc.w	dev_arm		dc.w	dev_disarm		dc.w	bad_code_err		dc.w	set_p_map		eject****************************************************************** This routine is used to write any data remaining in a drivers* internal buffer to the device in preperation for a driver* shutdown call.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_flush		longa	on		longi	on		clc		rts		eject****************************************************************** This call is issued to a device to shutdown the device prior* to purging a driver from the device list.  The driver will* release any system resources it has aquired as a result of* the driver startup call or an open call.  If neccessary, a* close call will be issued to the device.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************g_shutdn		longa	on		longi	on		ldy	#drvr_class		; is this a class 0 or 2 device?		lda	[<drvr_dib_ptr],y		and	#$0001		beq	g_shutdn_done		; yes, dont need to dispatch				ldy	#dev_id_num		; is it a LIRON?		lda	[<drvr_dib_ptr],y		cmp	#$0003		beq	g_shutdn_done		; yesnot_liron		jsl	bank0_dsptch		; execute device reset callg_shutdn_done		jmp	return_no_err		eject******************************************************************* ROUTINE:      GET_DNUM** This routine searches the DIB tables for each device that* has been installed into the device list to determine the* device number for a given device name.  The device names* contained in the DIB's must be in UPPER case.  The search* will be case insensitive (bit 5 will be masked).  Note that* devices names contained within the DIB are real ASCII, not* Apple-ASCII (in other words, the MSB is cleared).** ENTRY: via a 'JSL'*		A Reg = Unspecified*               X Reg = Low word pointer to P-String*               Y Reg = High word pointer to P-String*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: return via an 'RTL'*		A Reg = Error code if error, Device number if no error*               X Reg = Low word pointer to P-String*               Y Reg = High word pointer to P-String*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if no error & A Reg = DevNum*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if error & A Reg = Error Code******************************************************************		export	get_dnum	get_dnum		longa	on		longi	on		phb		phk		plb		stx	<fw_addr	; set pointer for indirection		sty	<fw_addr+2		lda	<drvr_dev_num	; preserve last device accessed		pha		lda	[<drvr_dev_ptr]	; get total number of devices		sta	<drvr_dev_numid_dev_loop		jsr	set_dib_ptr	; set pointer to the devices dib		sep	#$20		; 8 bit 'm'		longa	off		ldy	#dev_name	; point at device name count byte		lda	[<drvr_dib_ptr],y		sta	|char_cnt	; char_cnt = length of name in DIB		cmp	[<fw_addr]	; same application character count?		beq	check_dev_name	; yes, see if it's the same name		rep	#$20		; 16 bit 'm'		longa	on		dec	<drvr_dev_num	; point at next device		bne	id_dev_loop	; $0001 is last devicecant_find_it** If cant find name check for .Dn or .Dnn.  If either of these* cases is found then convert the ascii number suffix to a hex* number and return it as the device number.*		ldy	#$0001		; make sure it's a 'D'		lda	[<fw_addr],y		and	#$005F		; strip high bit and convert to upper		cmp	#$0044		; uppercase 'D'		bne	not_dot_d_n	; sorry, no .xn, only .Dn		iny		lda	[<fw_addr]	; get application string length		and	#$00FF		cmp	#$0002		; is it a .Dn format?		beq	strip_n		; yes		cmp	#$0003		; is it a .Dnn format?		bne	not_dot_d_n	; nostrip_nn		lda	[<fw_addr],y	; copy n portion of string		sta	|dn_string		bra	convert_itstrip_n		lda	[<fw_addr],y	; copy n portion of string		and	#$00FF		ora	#$2000		sta	|dn_string		deyconvert_it		pha			; space for result		pea	dn_string>>16	; pointer to string		pea	dn_string		phy			; length of string		pea	$0000		; not a signed integer		_dec2int		pla			; assume it was legal		bcs	not_dot_d_n	; no		beq	not_dot_d_n	; bad dev num!		sta	<drvr_dev_num	; assume it's good & set device number		jsr	set_dib_ptr	; set DIB pointer so device type can be checked		lda	<drvr_dev_num	; but is it really a good device number?		cmp	[<drvr_dev_ptr]		blt	have_n		; good dev num!		beq	have_n		; good dev num!** REVISION: v0.04 a05* If .Dnn and nn exceeds device count, return invalid_dev_num.*		pla			; restore device number		jsr	leave_dib_alone		plb		sec			; invalid device number error		lda	#invalid_dev_num		rtlleave_dib_alone		beq	leave_dib				sta	<drvr_dev_num		jsr	set_dib_ptrleave_dib		rts		not_dot_d_n		pla			; restore device number		jsr	leave_dib_alone		plb		sec			; device not found error		lda	#dev_not_found		rtl** Device name has same number of characters as pathname so* check the device name against the pathname.**     [<drvr_dib_ptr] = pointer to current device's DIB*          [<fw_addr] = pointer to search name (P-String)*               A Reg = character count*               X Reg = Unspecified*               Y Reg = points at device name character count in DIB*check_dev_name		longa	off		longi	on		iny			; point at first characters		ldx	#$0001check_name_loop		phy		txy		lda	[<fw_addr],y	; character from P-String		and	#%01111111	; make sure MSB off		ply		cmp	#'a'		; $00-60 does not need case changed		blt	case_ok		cmp	#$7B		; $7B-7F does not need case changed		bge	case_ok		and	#%11011111case_ok		cmp	[<drvr_dib_ptr],y		bne	wrong_dev	; name miscompared		inx			; point at next character		iny		dec	|char_cnt		bne	check_name_loophave_n		rep	#$20		; 16 bit 'm'		longa	on				ldy	#dev_char	; is this a character device?		lda	[<drvr_dib_ptr],y		xba		and	#$8000		eor	#$8000		sta	>char_dev_flag	; flag = $8000 if character device or $0000 if block device		ldx	<drvr_dev_num	; current devnum is it		pla			; restore device number		jsr	leave_dib_alone		plb		clc			; no error, A will have devnum		txa		rtlwrong_dev		longa	off		rep	#$20		; 16 bit 'm'		longa	on		dec	<drvr_dev_num	; next device to check		beq	cant_find_what	; error if no more devices		jmp	id_dev_loop	; check if more devicescant_find_what		jmp	cant_find_itchar_cnt	dc.w	0		; number of charactersdn_string	dc.w	0		; string .Dn or .Dnn conversion		export	console_stringconsole_string	dc.b	7		; this string is required by the INIT Manager		dc.b	'CONSOLE'				eject****************************************************************** This routine is used to set up the bank 0 core routine for* a dispatch.  This routine assumes a GDIB is located* contiguous to the DIB for the device being accessed.** WARNING:      This call can only be called from within a*               device driver.  Note that bank 0 of the*               language card must be banked in.** ENTRY: via a 'JSL'*               A Reg = Undefined*               X Reg = Pointer to dispatcher list*               Y Reg = Unspecified*               B Reg = Dispatcher list Bank*             Dir Reg = Unspecified*         DIB Pointer = Pointer to DIB containing slot & class*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************		export	to_bank0_core	to_bank0_core		longa	on		longi	on		phd			; need GS/OS direct page		phb		pea	direct_base		pld		ldy	#drvr_class	; is this a class 1 or 2 device?		lda	[<drvr_dib_ptr],y		and	#$003F		bne	ok_for_core	; yes, prepare for dispatch		plb		pld		sec			; else return an error		lda	#invalid_access		rtlok_for_core		jsr	go_to_core	; dispatch to SmartPort device		plb		pld		rtl		eject******************************************************************* ENTRY: via a 'JSR'*               A Reg = Unspecified*               X Reg = Pointer to dispatcher list*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*                       DRVR_DEV_NUM specifies current device*                       DRVR_DIB_PTR points to current DIB*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code if carry set, else unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************go_to_core		longa	on		longi	on		lda	|3,x		; get 3 words of dispatch list		pha		lda	|1,x		pha		lda	|0,x		tay		pha		lda	>call_list_ptr	; get address where command resides		tax		pla			; set command		sta	>0,x		pla			; and parameter list pointer		sta	>1,x		pla		sta	>3,x		tya			; validate extended command		and	#$0040		bne	do_extended	; if extended		lda	#$EAEA		; else patch 2 NOP's over upper pointer		sta	>3,xdo_extended		ldy	#slot_num	; set up for dispatch		lda	[<drvr_dib_ptr],y		and	#$0007		xba		ora	#$C000		; now have $Cn00		sta	<fw_addr		stz	<fw_addr+2		ldy	#$00FF		; need #Cn00 + ($CnFF) + 3		sep	#$20		; 8 bit 'm'		longa	off		lda	[<fw_addr],y		clc		adc	#$03		sta	<fw_addr		rep	#$20		; 16 bit 'm'		longa	on		jsl	b0_core		; dispatch to bank 0 core routines		rts		eject****************************************************************** This routine returns the address of the bank 0 system buffer.** ENTRY: via a 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Unchanged*               X Reg = Address of bank 0 system buffer*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************		export	get_b0_buffget_b0_buff		longa	on		longi	on				ldx	#sys_buffer		clc		rtl				eject****************************************************************** This is the supervisory dispatcher.  It is responsible for* dispatching to the correct supervisory driver.  Calls with* a supervisory driver number of zero reference the dispatcher* itself.** Calls to supevisor driver dispatcher (driver #0):**               $0000   Return driver number for driver ID*               $0001   Set SIB Pointer** Calls to supervisory drivers (driver #1 - n):**               $0000   Startup*               $0001   Shutdown*               $0002   Call specified in parameter block** ENTRY: via a 'JSL'*               A Reg = Supervisory Driver Number*               X Reg = Call Number*               Y Reg = Supervisory ID*               B Reg = Dispatcher list Bank*             Dir Reg = Unspecified*               P Reg = N V M X D I C Z  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTL'*               A Reg = Error code*               X Reg = Supervisory driver number*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I C Z  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************		export	supervisory	supervisory		longa	on		longi	on		phb		phk		plb		pha			; is this a driver call?		pla		bne	get_sib		; yes		txa			; call number		cmp	#$0002		; get sup or get sib?		bge	bad_sup_call	; if illegal call		asl	a		tax		jsr	(sup_table,x)		plb		rtlbad_sup_call		lda	#drvr_bad_req		sec		plb		rtlget_sib		phx			; preserve call number		pha			; preserve supervisor number		jsr	set_sib_ptr	; set pointer to SIB		pla		plx		bcc	have_sib		plb		rtlhave_sib		pha		ldy	#$0001		; point at supervisory entry point		lda	[<sib_ptr]		sta	|call_sup+1		lda	[<sib_ptr],y		sta	|call_sup+2		placall_sup		jsl	>$000000	; call supervisory driver		plb		rtldo_sib_ptr		tya		bra	set_sib_ptrsup_table	dc.w	get_sup_num		dc.w	do_sib_ptr		eject******************************************************************* ENTRY: via a 'JSL'*               A Reg = Supervisory Driver Number*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Dispatcher list Bank*             Dir Reg = Unspecified*               P Reg = N V M X D I C Z  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTL'*               A Reg = Error code*               X Reg = Supervisory driver number*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I C Z  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************get_sup_num		longa	on		longi	on		sty	|sup_drvr_num		; supervisory ID to search for		lda	#$0001sib_search		jsr	set_sib_ptr		; point at this sib		bcs	no_sup			; if cant find supervisor		ldy	#$0004			; point at supervisory ID in SIB		lda	[<sib_ptr],y		cmp	|sup_drvr_num		; is it the ID we are searching for?		beq	found_sup		; yes		inx				; advance to the next driver please		txa				; else point at next sib and		bra	sib_search		; continue searchfound_sup		lda	#no_error		clcno_sup		rts		eject******************************************************************* Supevisory driver number is valid.  Calculate the entry point in* the supervisory driver list for this driver and set the SIB pointer* prior to calling the driver.*                ______________________  _*               |_                    _|  |*               |_ Supervisory Driver _|  |_ Device list entry count*               |_        Count       _|  |*               |______________________| _|*               |_                    _|  |*               |_    Pointer to      _|  |*               |_        SIB         _|  |*               |______________________|  |_ Supervisory driver entry*               |_   Supervisor ID    _|  |*               |______________________|  |*               |_       User ID      _|  |*               |______________________| _|** ENTRY: via a 'JSL'*               A Reg = Supervisory Driver Number*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Dispatcher list Bank*             Dir Reg = Unspecified*               P Reg = N V M X D I C Z  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTL'*               A Reg = Error code*               X Reg = Supervisory driver number*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I C Z  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************set_sib_ptr		longa	on		longi	on		tax			; save supervisory number		cmp	[<sup_drvr_ptr]	; valid supervisory driver?		blt	valid_sup		beq	valid_sup		lda	#dev_not_found		sec		rtsvalid_sup		jsr	times_8_plus_4	; Y = (A * 8) + 4		lda	[<sup_drvr_ptr],y		sta	<sib_ptr		iny		iny		lda	[<sup_drvr_ptr],y		sta	<sib_ptr+2		jmp	return_no_err				eject****************************************************************** This system service routine installs into the device list the* driver whose DIB address is passed in the X and Y registers.* Then a startup call is issued to the new device.  If the device* returns an error it will be purged from the device list.** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*               A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************		export	insert_driver	insert_driver		longa	on		longi	on		phb			; need my data bank		phk		plb		lda	<post_drvr_tbl	; any drivers to install?		ora	<post_drvr_tbl+2		bne	do_install	; yes		jmp	none_posted	; off to common exitdo_install		pei	<drvr_dev_num		pei	<drvr_call_num		lda	#0000		sta	>post_indexinsert_loop		lda	>post_index	; any drivers to install?		cmp	[<post_drvr_tbl]		beq	install_done	; no		pha		lda	[<drvr_dev_ptr]	; increment device count		inc	a		sta	[<drvr_dev_ptr]		sta	<drvr_dev_num	; init device number for startup		jsr	set_dev_index	; point into device list entry** Calculate index into high DIB address in post driver list as follows:* Index = (post_index * 4) + 6* Index will be pointed at the high word of the DIB address to install.*		pla			; reference driver to install		sec		inc	a		rol	a		asl	a		phy		tay		lda	>post_index		inc	a		sta	>post_index** Aquire the DIB address from the post table.*		lda	[<post_drvr_tbl],y		tax		dey		dey		lda	[<post_drvr_tbl],y		ply** Install the DIB, disk switched status and USER ID into the device list.*		sta	[<drvr_dev_ptr],y		iny		iny		txa		sta	[<drvr_dev_ptr],y		iny		iny		lda	#$0000		; init device disk switched		sta	[<drvr_dev_ptr],y		iny			; init device USER ID = $0000		iny		sta	[<drvr_dev_ptr],y** Set DIB pointer for driver and then issue a startup call* to the driver.*		jsr	set_dib_ptr	; set DIB pointer for startup		jsr	startup_l_drvr	; startup the driver		bcc	insert_loop	; if startup is ok		lda	[<drvr_dev_ptr]	; next driver same place startup failed		dec	a		sta	[<drvr_dev_ptr]		bra	insert_loop	; see if more devices to installinstall_done		jsr	fix_dev_handle	; set device list handle size		plx		stx	<drvr_call_num		plx		stx	<drvr_dev_num		beq	leave_dib_3				jsr	set_dib_ptr	; restore original DIB pointerleave_dib_3		stz	<post_drvr_tbl		stz	<post_drvr_tbl+2none_posted	lda	#0000		sta	>post_index	; clear post in progress flag		plb		rtl		eject******************************************************************* Driver installation is complete.  To cleanup, set the device list* handle size to the size of the current device list.  The number* of entries in the device list is multiplied by eight and the* device count is added to the result to calculate the device list* handle size.** ENTRY: via a 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************fix_dev_handle		longa	on		longi	on		php		pha		phx		phy		lda	[<drvr_dev_ptr]		; get number of devices		jsr	calc_dev_size		; get device list size		jsr	put_handle_size		; save parameters for set_handle_size				ldy	|dev_list_hndl+2	; handle to set size of...		ldx	|dev_list_hndl		jsr	set_handle_size		; set the size of the handle		bcc	have_d_h		jmp	time_to_diehave_d_h		jsr	deref_dev_list		; dereference device list handle		ply		plx		pla		plp		rts		eject******************************************************************* This routine calculates the index into the file list.*			 _________________*	BASE		|_               _|   Filename entry #1*			|_               _|*			|_               _|*			|_________________|*				 ¥*				 ¥*				 ¥*			 _________________*	BASE+(n*48)	|_               _|   Filename entry #n*			|_               _|*			|_               _|*			|_________________|** The structure of each filename entry is a 48 byte structure as follows:**			 _________________*	BASE=0		|_               _|   FileType of filename entry*			|_________________|*	BASE+2		|_               _|   AuxType of filename entry*			|_________________|*	BASE+4		|_               _|   User ID of filename entry*			|_________________|*	BASE+6		|_               _|   Load Address of filename entry*			|_               _|*			|_               _|*			|_________________|*	BASE+10		|_               _|   32 byte filename*			|	          |*				 ¥*				 ¥*				 ¥*			|_               _|*			|_________________|*	BASE+42		|_               _|   Restart Flag of filename entry*			|_________________|*	BASE+44		|_               _|   Base device number of filename entry*			|_________________|*	BASE+46		|_               _|   RESERVED for filename entry*			|_________________|** ENTRY: via a 'JSR'*               A Reg = File list entry number*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*               A Reg = Least significant word size of file list*               X Reg = Most significant word size of file list*               Y Reg = Index into file list*               B Reg = Undefined*             Dir Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************calc_file_index		longa	on		longi	on		sta	|current_file		; need current file number		tay		beq	no_file_index		dec	a		and	#$000F		asl	a		tax		lda	|file_list_tbl,x		sta	|file_index		lda	|current_file		dec	a		and	#$00F0		lsr	a		lsr	a		lsr	a		tax		lda	|file_list_tbl,x		asl	a		asl	a		asl	a		asl	a		adc	|file_index		sta	|file_index				pha		clc		adc	<file_list_ptr		; set pointer to entry		sta	<file_entry_ptr		lda	#0		adc	<file_list_ptr+2		sta	<file_entry_ptr+2		pla				tay				; Y = index to current entry		clc		adc	#$0030			; A = size from base to top of this entryno_file_index		ldx	#0		rtscurrent_file	dc.w	0file_index	dc.w	0file_list_tbl	dc.w	$0000			; entry # 1 index		dc.w	$0030			; entry # 2 index		dc.w	$0060			; entry # 3 index		dc.w	$0090			; entry # 4 index		dc.w	$00C0			; entry # 5 index		dc.w	$00F0			; entry # 6 index		dc.w	$0120			; entry # 7 index		dc.w	$0150			; entry # 8 index		dc.w	$0180			; entry # 9 index		dc.w	$01B0			; entry # 10 index		dc.w	$01E0			; entry # 11 index		dc.w	$0210			; entry # 12 index		dc.w	$0240			; entry # 13 index		dc.w	$0270			; entry # 14 index		dc.w	$02A0			; entry # 15 index		dc.w	$02D0			; entry # 16 index				eject******************************************************************* This routine dereferences a handle.** ENTRY: via a 'JSR'*               A Reg = Least significant word of handle*               X Reg = Most significant word of handle*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*               A Reg = Least significant word of pointer*               X Reg = Most significant word of pointer*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************deref_handle		longa	on		longi	on				phb		phx		plb		tax		ldy	|2,x		lda	|0,x		tyx		plb		plb		rts				eject****************************************************************** This system service routine posts a DIB address for future* driver installation.  Installation will occur following the* current or next return from the device dispatcher.**                _____________________*       +$0000  |_                   _|*               |_  Count of number  _|*               |_  DIBs to install  _|*               |_____________________|*       +$0004  |_                   _|*               |_    Pointer to     _|*               |_    first DIB      _|*               |_____________________|*       +$0008  |_                   _|*               |_    Pointer to     _|*               |_    second DIB     _|*               |_____________________|** ENTRY: via a 'JSL'*               A Reg = Undefined*               X Reg = DIB address (low)*               Y Reg = DIB address (high)*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTL'*               A Reg = Error code (no_error, drvr_busy or out_of_mem)*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 if drivers can be installed*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 if drivers cannot be installed*****************************************************************		export	post_driverpost_driver            		longa	on		longi	on		phb		phk		plb		phd		lda	#direct_base		tcd		lda	<post_drvr_tbl	; is a call pending?		ora	<post_drvr_tbl+2		beq	post_it		; no		jmp	cant_post_drvr	; yes, cant install this one!post_it		stx	<post_drvr_tbl		; save addr of posted driver table		sty	<post_drvr_tbl+2** Current device list size is added to size of post driver install* list to set device list handle size (8 bytes per device).*		clc		lda	[<post_drvr_tbl]		adc	[<drvr_dev_ptr]		jsr	calc_dev_size		; get device list size		jsr	put_handle_size		ldy	|dev_list_hndl+2	; handle to set size of...		ldx	|dev_list_hndl		jsr	set_handle_size		; set the handle size		post_exit		php				; save exit status		pha		jsr	deref_dev_list		; dereference device list handle		pla				; restore exit status		plp		pld		plb		rtl** If memory could not be allocated then an error indicating this* condition must be returned.*no_memory		longa	on		longi	on		stz	<post_drvr_tbl		stz	<post_drvr_tbl+2		jsr	fix_dev_handle	; set device list handle size		lda	#out_of_mem	; cant allocate for post_driver		sec		bra	post_exitcant_post_drvr		lda	#drvr_busy	; cannot install driver right now.		sec		pld		plb		rtlput_handle_size		sta	|handle_size		stx	|handle_size+2		rts		eject******************************************************************* The following routine calculates the handle size for the* device list based on the number of devices passed as input* in A.  NOTE that an artificial limit of 63 devices currently* exists.** ENTRY: via a 'JSR'*               A Reg = Low word number of devices*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*      |dev_list_size = Size of device list*               A Reg = Device list handle size*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************calc_dev_size		longa	on		longi	on		stz	|dev_list_size+2** Size = (device count * 8) + 4*		sec		rol	a		asl	|dev_list_size+2		asl	a		asl	|dev_list_size+2		asl	a		asl	|dev_list_size+2** Return with device list size.*		sta	|dev_list_size		ldx	|dev_list_size+2		rts		eject******************************************************************* The following routine walks each entry of the file list to find* the file entry with the user ID (shutdown_id) of a driver being* purged.  The file entry will be marked as purged by writting a* zero to the file entry file type.** ENTRY: via a 'JSR'*               A Reg = Low word number of devices*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*      |dev_list_size = Size of device list*               A Reg = Device list handle size*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************mark_file_list		longa	on		longi	on				lda	|current_file		pha		lda	|dd_os_call		; is purge during os startup?		bne	no_file_entries		; no, dont remove it from the list				lda	|file_list_cnt		; point at last entry		beq	no_file_entries				sta	|current_filewalk_loop_1		lda	|current_file		; set pointer to file entry		jsr	calc_file_index				ldy	#file_user_id		; is current entry the shutdown ID?		lda	[<file_entry_ptr],y		cmp	|shutdown_id		beq	found_file_id		; yes				dec	|current_file		; else check if more entries		bne	walk_loop_1		; if more entries		bra	no_file_entries		; ID is not in the file entry** Mark the current file entry as purged by zeroing out the file type* in the file list entry.*found_file_id		lda	#0			; zero out file type		sta	[<file_entry_ptr]		sta	[<file_entry_ptr],y	; zero out user ID so for subsequent searchno_file_entries		pla		sta	|current_file		jsr	calc_file_index		rts				eject******************************************************************* The following routine walks each entry of the file list to find* the file containing the file name that matches the string in* file_name_str.** ENTRY: via a 'JSR'*               A Reg = Low word number of devices*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTS'*      |dev_list_size = Size of device list*               A Reg = Device list handle size*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0	File found in memory*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0	File not found in memory*****************************************************************find_file		longa	on		longi	on				lda	|file_list_cnt		; are there any file list entries?		beq	no_fl_entry		; no, return error to load from disk				lda	#$0001			; start at first entry		sta	|current_filefind_loop_1		lda	|current_file		; set pointer to file entry		jsr	calc_file_index				ldy	#file_name		; is current entry the target driver?		lda	[<file_entry_ptr],y		beq	wrong_entry		; nil string length is not valid!		cmp	|file_name_str		; same length?		bne	wrong_entry_2		; no, can't be equal				tax				; put length into X		sec				; allow for string length word		adc	#file_name		; make index to last character of name		tay		sep	#$20			; 8 bit 'm'		longa	off		find_loop_2		lda	[<file_entry_ptr],y			cmp	|file_name_str+1,x		bne	wrong_entry		; wrong file list entry if string mismatch		dey		dex		bne	find_loop_2		rep	#$21			; 16 bit 'm' and CLC to		longa	on			;   indicate file found in memory		rtswrong_entry		rep	#$20			; 16 bit 'm'		longa	onwrong_entry_2		inc	|current_file		; else check if more entries		lda	|file_list_cnt		cmp	|current_file		bge	find_loop_1		; if more entriesno_fl_entry			sec				; indicate file not found in memory		rts				endp		end