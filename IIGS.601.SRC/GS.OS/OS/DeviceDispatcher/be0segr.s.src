******************************************************************* be0segR** Framework for building load segment b00segR.******************************************************************header_length   equ	$30be0segr_org     equ	$E0E000be0segr_start	equ	be0segr_org				IMPORT	be0segr_endbe0segr_header  PROC	org     be0segr_org-header_length		msb     on		DC.W	be0segr_end-be0segr_start		DC.L	be0segr_org		DC.W	0000		DC.B	'Dispatcher            v04.00'		DC.B	00		msb     off		ENDP			d_be0segr_dummy PROC	org     be0segr_org		ENDP		end