*********************************************************************************               	Copyright (c) 1987 - 1992*               	Apple Computer, Inc.*               	All rights reserved.**********************************************************************************               GS/OS Fast Device Dispatcher*               Written by: Raymond B. Montagne**               This OMF2 file to be loaded into managed fast memory*		by GLoader.  Proper installation includes a call to*		the base address of the segment.**		Memory User ID's for GS/OS components are as follows:**                       $30XX Cannot be used*                       $31XX SCM*                       $32XX Gloader / Gquit*                       $33XX File System Translators*                       $34XX Express Loader*                       $35XX Reserved:*                       $36XX Reserved:*                       $37XX Reserved:*                       $38XX Reserved:*                       $39XX User ID for loaded device driver*                       $3AXX User ID for loaded supervisor driver*                       $3BXX Segments allocated by supervisor drivers*                       $3CXX Segments allocated by device drivers*                       $3DXX Allocated for generated DIB's*                       $3EXX Supervisory driver list*                       $3FXX Device driver list & Device Dispatcher Components********************************************************************************** Revision History:** mm/dd/yy Version 	Who 	What** 01/04/89 v4.10 dxx	RBM	Ported device manager, device dispatcher and time *				critical system service calls to fast ram.  Re-write*				of device access verification routines for performance*				enhancement.** 01/07/89		RBM	Startup & shutdown do not patch and restore $E1020X*				vectors for move_info, system_speed and slot_arbiter.*				These vectors must not be patched to point to $01FCxx*				because they cannot be called with the rom selected.*				Vector patching has been ported back to the bank $E0*				device dispatcher startup and shutdown calls.** 01/08/89		RBM	Fixed access detection so that format control call *				is passed on to a SLINKY.** 01/09/89		RBM	Speed enhancement in D_READ and D_WRITE.** 01/25/89		RBM	Added system call $2036 D_RENAME.** 02/06/89	2.1a02	RBM	Added capability of disabling D_RENAME and limited*				rename function so that console driver could not*				be renamed.** 02/07/89		RBM	D_RENAME can no longer be disabled.  D_RENAME*				can be used on CONSOLE.  D_RENAME now checks*				the device characteristics to determine if the*				device can be renamed.** 02/08/89		RBM	D_RENAME now changes the replacement string into upper*				case ascii prior to renaming the target device.** 02/09/89		RBM	Preserve $E1 vectors for set system speed and slot*				arbiter.  Intercept device dispatcher shutdown call*				and restore these vectors.** 02/14/89	2.1a03	RBM	Transfer count is now preserved around dynamic driver installation.** 02/22/89	2.1d12	RBM	D_Info class 1 now checks for minimum pcount.** 02/28/89	2.1d13	RBM	D_INFO class 1 now checks for max pcount of $000B.  DIB_DEV_NUM*				will not be returned.** 03/01/89	2.1d13+	RBM	D_INFO class 1 now returns invalid_dev_num for a device number of*				$0000.** 03/10/89	2.1d13+ RBM	D_INFO with pcount max reduced to $000A broke several applications.*				Changed max pcount to $000B.  Update DOC.**  3/20/89	d14	RBM	Fixed slot arbiter code where branch occured from 16 bit mode*				to 8 bit mode code.**				D_CONTROL call for format now deletes all blocks from the cache.**  3/24/89			Fixed width of block count returned on D_INFO (BRC#46513).**  3/29/89	d16	RBM	D_calls to device $0000 now return error $0011 = Invalid_Dev_Num.**  4/06/89	d18	RBM	D_STATUS & CONTROL allows a status/control list pointer of zero*				on calls that do not use a parameter list.**  4/19/89	d19	RBM	Status call $0000 (device status) is now post processed so that*				both insertion and ejection events are posted to the os queue.**  4/25/89	d20	RBM	Renaming a device to it's current name will not return an error.**  5/12/89	d22	RBM	Set disk switch now parses for status call.  If a status call*				with status code $0000, and not a linked device, the offline*				status is examined.  SWAP_OUT, CACHE_DEL_VOL and POST_EVENT*				will only be executed if the device is offline.  If SET_DISK_SW*				is called from a non status call or a status call where the*				status code is not equal to $0000 then SWAP_OUT, CACHE_DEL_VOL *				and POST_EVENT will be executed.**  5/15/89	d22	RBM	Changed parsing of status from within disk switch system service*				call.  Redundant posting to the os queue will not occur.  Conflicting*				posting to the os queue will not occur.  Swap_out and Cache_Del_Vol*				will occur unconditionally.**  5/25/89	d23	RBM	Bit 0 of status word not maniplulated for character devices.  Previous*				implementation set bit 0 when online/offline state changed regardless*				of device type.**  5/30/89	d25	RBM	Device status is not post processed by the device dispatcher if *				the request count to the status call was less than 2 meaning that*				the device status word was not requested.**  6/02/89	d25+	RBM	Set disk switch no longer stores zero do devnum.**  6/12/89	d29	RBM	If status returns online and switched, cache_del_vol and swap_out*				will be called directly from the device dispatcher prior to exit*				back to the FST level.**				D_WRITE / D_READ now loads the device number prior to calling*				the system service routine 'SWAP_OUT'.**  01/03/90	6.0d5	GAB	D_Info call corrected so that the result buffer supplied*				for the device name will not be overflowed.**  04/24/91	6.0d33	GAB	new_dispatch fixed so that it recognizes the new*				full_shutdown ($0003) call number.**  06/04/91	6.0d39	GAB	Optimizations performed.**  10/30/91	6.0d55	GAB	Fixed call dispatching so that out-of-range*				call numbers to the dispatcher are not treated*				like Shutdown calls.**  12/07/91	6.0d61	GAB	Fixed post-processing of disk-switched and offline*				status so that if a driver reports both disk-switched*				and online at the same time, an insertion event is*				_always_ posted to the notification queue.**  6-Mar-93    6.0.1d14 JCM	DStatus and DControl now use the new device characteristics*				bit $0010 to determine if a driver can accept all subcalls.**  9-Mar-93    6.0.1d14 JCM	The previous fix stopped us from dispatching device-specific*				calls if the new bit wasn't set. All calls >= $8000 should get*				to drivers regardless of this bit setting, and they now do.**  9-Mar-93    6.0.1d14 JCM	Optimized the previous fix to cut out 6 bytes.********************************************************************************		print	push		print	off		include	'gsos.macros.src' 		include	'common.equ.src' 		include	'hw.equ.src' 		include	'driver.equ.src'		print	pop		eject;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		entry	new_dispatch		entry	gsos_speed		entry	set_dib_ptr		entry	get_disp_err		entry	clear_disp_err		entry	d_control		entry	d_info		entry	d_read		entry	d_status		entry	d_write		entry	set_dib_pointer		entry	slot_arbiter		entry	dev_mgr		entry	set_disk_switch		entry	d_rename		entry	dev_mgr_fail;		entry	os_names		eject****************************************************************** This is the main entry point for the device dispatcher.* Note that calls to device zero specify calls to the dispatcher* and not to a particular device.  Non-zero device numbers* will be passed on to that specific device.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0	** EXIT:         A Reg = Undefined*               X Reg = Unchanged*               Y Reg = Unchanged*             DIR Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************		export	install_dev_svc	install_dev_svc	proc		longa	on		longi	on				phb				; save caller's DBR		phk				; set to our bank		plb		lda	to_dispatch		; install device dispatcher system service vector		sta	>dev_dispatcher		lda	to_dispatch+2		sta	>dev_dispatcher+2		lda	#$0000		pha				; space for status result		pha				; space for A Reg. result		pha				; space for X Reg. result		pha				; space for Y Reg. result		pha				; A Reg. at entry		pha				; X Reg. at entry		pha				; Y Reg. at entry		pea	$FE1F			; Emulation entry point		_FWEntry		pla				; Y reg. result		plx				; X reg. result		plx				; A reg. result		plx				; Processor status result		dec	a			; is the rom version = $0001?		beq	dont_save_e1		; yes, dont save bank e1 vectors (they dont exist)				lda	>e1_set_speed		; save bank $E1 system speed vector		sta	old_set_speed		lda	>e1_set_speed+2		sta	old_set_speed+2				lda	>e1_slot_arbiter	; save bank $E1 slot arbiter vector		sta	old_arbiter		lda	>e1_slot_arbiter+2		sta	old_arbiter+2				lda	>e1_move		; save bank $E1 move routine vector		sta	old_move		lda	>e1_move+2		sta	old_move+2		dont_save_e1		lda	move_info		; install bank $E1 move routine vector		sta	>e1_move		lda	move_info+2		sta	>e1_move+2				lda	to_gsos_speed		; install set_sys_speed system service vector		sta	>set_sys_speed		sta	>e1_set_speed		lda	to_gsos_speed+2		sta	>set_sys_speed+2		sta	>e1_set_speed+2				lda	to_slot_arbiter		; install slot arbiter system service vector		sta	>dyn_slot_arbiter		sta	>e1_slot_arbiter		lda	to_slot_arbiter+2		sta	>dyn_slot_arbiter+2		sta	>e1_slot_arbiter+2		lda	to_set_disk_sw		; install disk switch system service vector		sta	>set_disksw		lda	to_set_disk_sw+2		sta	>set_disksw+2				lda	to_dev_mgr		; install device manager system service vector		sta	>dev_mgr_svc		lda	to_dev_mgr+2		sta	>dev_mgr_svc+2		;		lda	#<os_names		; initialize the pointer to GS/OS names;		sta	>$01FCFC;		lda	#^os_names;		sta	>$01FCFE		plb				; restore caller's DBR		rtl		to_dispatch	jmp	>new_dispatchto_gsos_speed	jmp	>gsos_speedto_slot_arbiter	jmp	>slot_arbiterto_set_disk_sw	jmp	>set_disk_switchto_dev_mgr	jmp	>dev_mgrold_set_speed	sec				; old $E1 vector for set system speed		rtl		nop		nop		old_arbiter	sec				; old $E1 vector for slot arbitration		rtl		nop		nop		old_move	sec				; old $E1 vector for move routine		rtl		nop		nop		eject****************************************************************** This is the main entry point for the device dispatcher.* Note that calls to device zero specify calls to the dispatcher* and not to a particular device.  Non-zero device numbers* will be passed on to that specific device.** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0	** EXIT:         A Reg = Error code*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Same as on entry*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ 0  0	if no error*			¥ ¥ 0 0 0 ¥ ¥ 1  0	if error*****************************************************************		export	new_dispatch	new_dispatch		longa	on		longi	on				lda	<drvr_dev_num		; is this a call to the dispatcher?		bne	device_call		; no, it's to a device		lda	<drvr_call_num		; is it a shutdown call?		cmp	#$0002		beq	@shutdown		; yes, normal shutdown		cmp	#$0003			; full shutdown?		bne	to_old_disp		; no, let old dispatcher handle it		@shutdown		jsl	>old_dev_disp		; else call old dispatcher				lda	>old_set_speed		; restore bank $E1 system speed vector		sta	>e1_set_speed		lda	>old_set_speed+2		sta	>e1_set_speed+2				lda	>old_arbiter		; restore bank $E1 slot arbiter vector		sta	>e1_slot_arbiter		lda	>old_arbiter+2		sta	>e1_slot_arbiter+2				lda	>old_move		; restore bank $E1 move routine vector		sta	>e1_move		lda	>old_move+2		sta	>e1_move+2				lda	#no_error		rtl		to_old_disp		jmp	>old_dev_disp		; this call is handled by the old device dispatcherdevice_call 		cmp	[<drvr_dev_ptr]		; is it a legal device number?		blt	dev_num_ok		; yes		beq	dev_num_ok		lda	#invalid_dev_num 	; illegal device number		sec		rtl** Clear out the transfer count prior to dispatching to the* device.  Set DIB pointer prior to dispatch to device.*dev_num_ok 		phb				; need my bank!!!		phk		plb		pei	<drvr_cache		; preserve cache priority** Qualify cache priority based on global sessions flag. (Rev. v0.26)*		lda	>session_stat		; is a deferred sessiion in progress?		ror	a		ror	a		ora	#$7FFF		and	<drvr_cache		sta	<drvr_cache** Null out the transfer count.*		stz	<drvr_tran_cnt+2		stz	<drvr_tran_cnt** Set the DIB pointer for the current device to be accessed.*		lda	<drvr_dev_num		; device number to set DIB pointer for		dec	a			; calculate index into device list		sec		rol	a		asl	a		asl	a		tay		lda	[<drvr_dev_ptr],y	; set the DIB pointer		sta	<drvr_dib_ptr		iny		iny		lda	[<drvr_dev_ptr],y		sta	<drvr_dib_ptr+2		ldy	#entry_ptr		; now get ready for dispatch		lda	[<drvr_dib_ptr],y		sta	|drvr_call+1		iny		lda	[<drvr_dib_ptr],y		sta	|drvr_call+2** Check device access attributes v.s. call number.*		ldy	#dev_char		; pointer to DIB device characteristics		lda	<drvr_call_num		; get access attributes mask for this call		asl	a		tax		lda	|access_table,x		beq	dont_check_acc		; if access does not need checked on this call		bmi	chk_ctrl_access		; if access is control code specific		and	[<drvr_dib_ptr],y		bne	access_ok		; if device access allowed on this callexit_invalid_acc		pea	invalid_access		; else exit with an error		brl	common_dsp_exitchk_ctrl_access		lda	[<drvr_dib_ptr],y	; get the device characteristics		and	#%0100000000000000	; is this a generated driver?		beq	dont_check_acc		; no, let the driver do it's own checking		lda	<drvr_ctrl_code		; get access attributes this control call		cmp	#$0009			; is this device specific		bge	dont_check_acc		; yes, dont check attributes		asl	a		tax		lda	ctrl_access_tbl,x		beq	dont_check_acc		; if access does not need checked on this call		and	[<drvr_dib_ptr],y		bne	dont_check_acc		ldy	#dev_char		; is the device a character device		lda	[<drvr_dib_ptr],y		and	#$0080		bne	exit_invalid_acc	; no, access not allowed on this call		lda	#no_error		; yes, exit with no error		clc		brl	no_stat_dsp_err** Check access v.s. device type.*access_ok		lda	[<drvr_dib_ptr],y		and	#%0000000010000000	; is this a block device?		bne	chk_blk_acc		; yes		lda	<drvr_blk_size		; is block size zero for a character device?		beq	dont_check_acc		; yes, go check attributes against call		pea	not_block_dev		; else exit with an error		brl	common_dsp_exitchk_blk_acc		lda	<drvr_blk_size		; is block size nonzero for a block device?		bne	dont_check_acc		; yes, go check attributes against call		pea	drvr_bad_parm		; else exit with an error		brl	common_dsp_exit** Bit 12 of device characteristics should be set to indicate* that the driver is busy.*dont_check_acc		lda	[<drvr_dib_ptr],y		tax		and	#%0001000000000000	; is device already busy?		beq	dev_not_busy		; no		pea	drvr_busy		; else return driver busy error		brl	common_dsp_exit		dev_not_busy	txa		ora	#%0001000000000000		sta	[<drvr_dib_ptr],y** Access is allowed.  Go ahead and dispatch to the driver.*		xba		and	#$0003		cmp	#$0003			; does speed need to be set?		beq	entry_speed_ok		; no		jsl	set_sys_speed		; set speed for dispatchentry_speed_ok		pha				; and save current speed setting		lda	<drvr_call_num		; device needs the call number in A** Call the device driver.*		export	drvr_calldrvr_call               		jsl	>$000000		; self modified for driver entry		plx				; get speed setting prior to driver call		phk		plb		php				; save error code & status		pha		txa				; restore original system speed		cmp	#$0003			; does speed need to be set?		beq	exit_speed_ok		; no		jsl	set_sys_speed		; set speed for dispatchexit_speed_ok** Bit 12 of device characteristics should be cleared to indicate* that the driver is no longer busy.*		ldy	#dev_char		; set *BUSY in device characteristics		lda	[<drvr_dib_ptr],y		and	#%1110111111111111		sta	[<drvr_dib_ptr],y		pla		plp** Now need to post process any disk switched or off-line* error into a dispatcher maintained disk switched error* required for FST bouncing.*		bcc	no_dsp_err		; if no driver error this time		cmp	#drvr_disk_sw		; was error a disk switched?		beq	set_dsp_sw		; yes		cmp	#drvr_off_line		; was error off-line?		beq	set_dsp_sw		; yes		pha		bra	common_dsp_exit** Either an OFFLINE or DISKSWITCHED error returned from the* device will be mapped into a dispatcher maintained DISKSWITCHED error.*set_dsp_sw	pha		jsl	set_disksw		; mark device switch as neccessaryalready_set	bra	common_dsp_exit** If the device returned no error at all, then clear any pending* dispatcher maintained disk switched error.  The VCRs have already* been marked as offline.  Redundant calls to SWAP_OUT and* DEL_CACHE_VOL are not neccessary.  NOTE that the internal error* should only be cleared on a media access such as read, write or format.*no_dsp_err		ldy	#dev_char		; was call to a character device?		lda	[<drvr_dib_ptr],y		and	#%0000000010000000		beq	no_stat_dsp_err		; yes, no status to clear				lda	#no_error		ldy	<drvr_call_num	  	; was it a read call?		cpy	#drvr_read		beq	its_clear_time	  	; yes, clear dispatcher maintained error				cpy	#drvr_write		; was it a write call?		beq	its_clear_time	  	; yes, clear dispatcher maintained error				cpy	#drvr_control		; is it a control call?		bne	no_stat_dsp_err		; no, leave dispatcher maintained error alone				ldy	<drvr_ctrl_code		; is it a format call?		cpy	#drvr_format		bne	no_stat_dsp_err	  	; no, leave dispatcher error alone!its_clear_time		jsr	clear_disp_err	  	; clear dispatcher maintained errorno_stat_dsp_err						pha** The error status returned to the caller is the device status* returned by the driver call with the high byte cleared.*common_dsp_exit		clc				; assume no error		pla				; restore error code		beq	no_err			; if no driver or dispatcher error		secno_err		plx				; restore cache priority		stx	<drvr_cache		plb		php				; save error code & status		pha** Need to check if any dynamic driver installation is required.*		lda	>post_index		; is installation in progress? (BA)		bne	dont_insert		; yes, dont install redundantly!				lda	<post_drvr_tbl		; any drivers to install?		ora	<post_drvr_tbl+2		beq	dont_insert		; no				pei	<drvr_tran_cnt		; preserve transfer count around dynamic install		pei	<drvr_tran_cnt+2				jsl	dynamic_install		; install any pending drivers				pla		sta	<drvr_tran_cnt+2		pla		sta	<drvr_tran_cnt** If returning from a status call with a status code of $0000 then* must post process the general status word being returned in the* status list.  If online and no disk switch is indicated, then clear * dispatcher maintained disk switch status.  If clearing this status * results in a change the set the disk switch bit in the general status * word being returned in the status list.*dont_insert		ldy	#dev_char		; is the device a character device?		lda	[<drvr_dib_ptr],y		and	#$0080		beq	not_stat_ret		; yes, dont do any status bit manipulation				lda	<drvr_call_num		; is this a return from a status call?		cmp	#drvr_status		bne	not_stat_ret		; no, dont clear dispatcher maintained error		lda	<drvr_stat_code		; is this a general status call?		bne	not_stat_ret		; no, dont clear dispatcher maintained error				lda	<drvr_req_cnt		; was any status requested?		cmp	#$0002		blt	not_stat_ret		; if no status was requested.		lda	[<drvr_slist_ptr]	; is driver reporting a disk switch or offline?		eor	#$0010		and	#$0011		beq	chk_online_flag		; no				and	#$0010			; is driver offline?		beq	force_insert		; no, must be an insertion event				jsr	get_disp_err		; get dispatcher maintained error		bne	not_stat_ret		; if dont need to change diskswitch				jsl	set_disk_switch		; else mark list as offline/switched		jsr	set_dsw_bit		; set disk switch in status word		bra	not_stat_retforce_insert		jsr	get_disp_err		; get Y set up to access error variable		lda	#$FFFF			; reset to force an insertion notification		sta	[<drvr_dev_ptr],ychk_online_flag		lda	[<drvr_slist_ptr]	; is driver reporting a disk switch?		ror	a		bcc	no_on_sw		; nope!		jsl	cache_del_vol		; delete blocks from the cache		lda	<drvr_dev_num		; and mark VCRs as OFFLINE		jsl	swap_out		; to make life easier for FST'sno_on_sw		jsr	get_disp_err		; get dispatcher maintained error		beq	not_stat_ret		; if dont need to change diskswitch		jsr	set_dsw_bit		; set disk switch in status word		jsr	clear_disp_err		; clear dispatcher maintained errornot_stat_ret		pla				; restore error code & status		plp		rtlset_dsw_bit		lda	[<drvr_slist_ptr]	; set disk switch bit in general status word		ora	#$0001		sta	[<drvr_slist_ptr]		rts				eject****************************************************************** The following table provides a faster means of checking device* access prior to dispatching to the device driver.  Position of* bits in the mask are as follows:**			 Use control code access table*			 |*			 | *			 |       Block Device*			 |       |Write*			 |       ||Read*			 |       ||| Formatable*			 |       ||| |Removable*			 |       ||| ||*			%nxxxxxxxnnnxnnxx*		or...*			%0000000000000000 = dont check access this call.*****************************************************************access_table		dc.w	%0000000000000000	; access for startup		dc.w	%0000000000000000	; access for open		dc.w	%0000000000100000	; access for read		dc.w	%0000000001000000	; access for write		dc.w	%0000000000000000	; access for close		dc.w	%0000000000000000	; access for status		dc.w	%1000000000000000	; access for control		dc.w	%0000000000000000	; access for flush		dc.w	%0000000000000000	; access for shutdownctrl_access_tbl			dc.w	%0000000000000000	; access for reset device		dc.w	%0000000000000000	; access for format device		dc.w	%0000000000000100	; access for eject media		dc.w	%0000000000000000	; access for set configuration parameters		dc.w	%0000000000000000	; access for set wait mode		dc.w	%0000000000000000	; access for set format options		dc.w	%0000000000000000	; access for assign partition owner		dc.w	%0000000000000000	; access for arm signal		dc.w	%0000000000000000	; access for disarm signal		endp		eject******************************************************************* This routine optains the DIB pointer for the device specified* by the current DRVR_DEV_NUM from the device list to set the* DRVR_DIB_PTR on GS/OS direct page.*                  __________________*           $0000 |_                _|   ... Number of devices*           $0001 |_                _|*           $0002 |_                _|*           $0003 |__________________|*           $0004 |_                _|   ... Pointer to device #1 DIB*           $0005 |_                _|*           $0006 |_                _|*           $0007 |__________________|*           $0008 |_                _|   ... Device #1 disk switched status*           $0009 |__________________|*           $000A |_                _|   ... Device #1 User ID*           $000B |__________________|*           $000C |_                _|   ... Pointer to device #2 DIB*           $000D |_                _|*           $000E |_                _|*           $000F |__________________|*           $0010 |_                _|   ... Device #2 disk switched status*           $0011 |__________________|*           $0012 |_                _|   ... Device #2 User ID*           $0013 |__________________|*           $0014  ...** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*			x x 0 0 0 x x x  ** EXIT:         A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Same as execution bank*             Dir Reg = GS/OS Direct Page*        DRVR_DIB_PTR = Now points at DIB for current DRVR_DEV_NUM*               P Reg = N V M X D I Z C  E*			¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************		export	set_dib_ptrset_dib_ptr	proc		longa	on		longi	on		pha		phy		php		rep	#$30				; 16 bit 'm' & 'x'		longa	on		longi	on		lda	<drvr_dev_num			; device number to set DIB pointer for		dec	a				; calculate index into device list		sec		rol	a		asl	a		asl	a		tay		lda	[<drvr_dev_ptr],y		; set the DIB pointer		sta	<drvr_dib_ptr		iny		iny		lda	[<drvr_dev_ptr],y		sta	<drvr_dib_ptr+2		plp		ply		pla		rts		endp				eject****************************************************************** This routine sets the device dispatcher maintained disk* switched error for the device specified on GS/OS direct page.* This call is implemented for device drivers supporting any* device specific status calls which may detect either an* OFFLINE or DISKSW condition.  These conditions will be* returned as status rather than an error.  In this case, the* driver must request that the dispatcher maintained disk* switched status be set.** If the disk switch status has been previously set then no* action is performed by this call.  If the disk switch status* has not been set then it will be set and subsequent calls* will be issued to SWAP_OUT and DEL_CACHE_VOL.** NOTE: This routine was modified in version 0.08 a04 to check* if the current device is a linked device.  If a linked device,* the routine sets disk switch for each linked device starting* with the head device and proceeding to the last forward* linked device.** ENTRY: via a 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************		export	set_disk_switchset_disk_switch	proc           		longa	on		longi	on** Save register contents*		phd		phb		phy		phx		pha	if 0 then		pei	<drvr_dev_num		pea	direct_base		pld** Must determine if the current device is a linked device.  If a* linked device then all linked devices must be set as disk switched* including purging of cached volumes and marking the VCRs for* each device as being switched.*		jsr	set_dib_ptr		; point at current DIB		ldy	#forward_link		lda	[<drvr_dib_ptr],y		dey		dey		ora	[<drvr_dib_ptr],y		bne	set_linked_dsw		; if it's a linked device** Its not a linked device so only the current device cached block* and VCR is affected.*		jsr	set_dsw			; mark device & post ejection to queuealready_set_dsw		pla		sta	<drvr_dev_num		jsr	set_dib_ptr	else		jsr	set_dsw			; mark device & post ejection to queue	endif** Restore registers*		pla		plx		ply		plb		pld		rtl	if 0 then** All linked devices must be set as disk switched including purging* of cached volumes and marking the VCRs for each device as being switched.*set_linked_dsw		lda	[<drvr_dib_ptr],y		beq	set_dsw_loop		;We're at the head already. (BA)		sta	<drvr_dev_numset_dsw_loop		jsr	set_dsw			; set disk sw for current device		ldy	#forward_link		lda	[<drvr_dib_ptr],y		beq	already_set_dsw		; all done with linked devices		sta	<drvr_dev_num		; point at next device		bne	set_dsw_loop		; and loop if more devices to do	endif** If the disk switch status has been previously set then no* action is performed by this call.  If the disk switch status* has not been set then it will be set and subsequent calls* will be issued to SWAP_OUT and DEL_CACHE_VOL.*set_dsw							jsr	set_dib_ptr		; point at current DIB		jsr	get_disp_err		; get dispatcher maintained error		bne	set_dsw_done		; if disk switch already set** Only mark the device offline if the device is truly offline.* (Changed for d22 on May 15, 1989 {RBM}).*		lda	<drvr_call_num		; is it a status call?		cmp	#$0005		bne	mark_offline		; no, post to queue unconditionally				lda	<drvr_stat_code		; is it general status?		bne	mark_offline		; no, post to queue unconditionally				lda	[<drvr_slist_ptr]	; is device offline?		and	#%0000000000010000		bne	dont_mark		; no, dont mark if onlinemark_offline		jsr	get_disp_err		; need index into device list		lda	#$2E00			; mark device offline		sta	[<drvr_dev_ptr],ydont_mark		jsl	cache_del_vol		; delete blocks from the cache		lda	<drvr_dev_num		; and mark VCRs as OFFLINE		jsl	swap_out		; to make life easier for FST's** Only post the event to the OS queue if the device is truly offline.* (Changed for d22 on May 15, 1989 {RBM}).*		lda	<drvr_call_num		; is it a status call?		cmp	#$0005		bne	post_ejection		; no, post to queue unconditionally				lda	<drvr_stat_code		; is it general status?		bne	post_ejection		; no, post to queue unconditionally				lda	[<drvr_slist_ptr]	; is device offline?		and	#%0000000000010000		bne	set_dsw_done		; no, dont mark if online** Events are posted to the OS queue as follows:**		A Reg =	Event Code (least significant word)*		X Reg =	Event Code (most significant word)*		Y Reg =	*			Device Number*			?????*	Stack Pointer >	*post_ejection		pei	<drvr_dev_num		lda	#0		pha		pha		tax				; XA = event code = disk ejection		lda	#$0010		jsl	post_os_event		; notify the finder of a swapset_dsw_done	rts		export	get_disp_errget_disp_err		lda	<drvr_dev_num		; index into device list		asl	a		asl	a		asl	a		tay		lda	[<drvr_dev_ptr],y	; get device dispatcher maintained error		rts** The following routine clears the mark in the device list indicating that* media for the device specified by the current device number on GS/Os direct* page is online.*		export	clear_disp_errclear_disp_err		jsr	get_disp_err		; get device dispatcher maintained error		beq	no_post_insert		; If error is already cleared		lda	#no_error		; clear dispatcher maintained error		sta	[<drvr_dev_ptr],y		pei	<drvr_dev_num		; A register for event notification is device number		pha				; X retister for event notification is $0000		pha				; Y retister for event notification is $0000		tax				; XA = event code = disk insertion		lda	#$0008		jsl	post_os_event		; notify the finder of a swapno_post_insert		lda	#no_error		rts				endp				eject******************************************************************* This table is used to dispatch to device manager functions* based on the current call number as follows:**   CALL NUMBER:	DEVICE MANAGER FUNCTION:**	$X02C		D_INFO*	$X02D		D_STATUS*	$X02E		D_CONTROL*	$X02F		D_READ*	$X030		D_WRITE*	$X036		D_RENAME******************************************************************		export	dev_mgr_data	dev_mgr_data	proc						;using   drvr_equ		export	dev_mgr_tbldev_mgr_tbl   		dc.w	d_info			; $x02C - 0		dc.w	d_status		; $x02D - 1		dc.w	d_control		; $x02E - 2		dc.w	d_read			; $x02F - 3		dc.w	d_write			; $x030 - 4		dc.w	dev_mgr_fail		; $x031 - 5		dc.w	dev_mgr_fail		; $x032 - 6		dc.w	dev_mgr_fail		; $x033 - 7		dc.w	dev_mgr_fail		; $x034 - 8		dc.w	dev_mgr_fail		; $x035 - 9		dc.w	d_rename		; $x036 - A		export	d_info_datad_info_data		dc.w	0			; 1 = device number (input)		dc.l	0			; 2 = string pointer (input)		dc.w	dev_char		; 3 = device characteristics in DIB		dc.w	blk_cnt			; 4 = block count in DIB		dc.w	slot_num		; 5 = slot number in DIB		dc.w	unit_num		; 6 = unit number in DIB		dc.w	ver_num			; 7 = version number in DIB		dc.w	dev_id_num		; 8 = device ID number in DIB		dc.w	head_link		; 9 = backward device link		dc.w	forward_link		; A = forward device link		dc.l	extended_dib		; B = extended DIB pointer		dc.w	dib_dev_num		; C = device number of this device		export	name_lengthname_length	dc.w	0			; length of device name string		export	slot_reqslot_req	dc.w	0			; current slot being requested of arbiter		endp				eject******************************************************************* This is the main entry point for the device manager.  It is* responsible for parsing the command and dispatching to the* appropriate function.** CALL NUMBER:	$002C = Class 0 D_INFO* 		$202C = Class 1 D_INFO* 		$202D = Class 1 D_STATUS* 		$202E = Class 1 D_CONTROL* 		$202F = Class 1 D_READ* 		$2030 = Class 1 D_WRITE* 		$2036 = Class 1 D_RENAME** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error Code*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Unchanged*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 = no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 = error******************************************************************		export	dev_mgr		dev_mgr		proc		longa	on		longi	on		lda	<call_number		; index to dispatch table		and	#$00FF		sec		sbc	#$002C		bcc	dev_mgr_fail		; system death if cant deal with call		cmp	#$000B		bge	dev_mgr_fail		asl	a		tax		lda	<call_number		; precheck class		and	#$E000		beq	class_ok		; branck if class 0		cmp	#$2000			; or is it class 1		bne	dev_mgr_fail		; branch if not class 0 or 1class_ok		stz	<drvr_fst_num		; device manager is FST #0;		stz	<drvr_tran_cnt		; prezero transfer count;		stz	<drvr_tran_cnt+2		phb		phk		plb		jsr	(dev_mgr_tbl,x)		; dispatch to function		plb		rtl		export	dev_mgr_faildev_mgr_fail		lda	#bad_system_call		sec		rtl				endp		eject******************************************************************* This routine implements the device info call (D_INFO).* This call is supported in both class 0 and class 1* environments.** CLASS 0:	Word	Device Number*		Long	Pointer to output string** CLASS 1:	0 Word	PCount*		1 Word	Device Number*		2 Long	Pointer to output string*		3 Word	Device characteristics*		4 Long	Block count*		5 Word	Slot Number*		6 Word	Unit Number*		7 Word	Version Number*		8 Word	Device ID Number*		9 Word	Head Device Link*		A Word	Forward Device Link*		B Long	Extended DIB Pointer*		C Word	DIB Device Number** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error Code*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 = no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 = error******************************************************************		export	d_info		d_info		proc		longa	on		longi	on		lda	<call_number		; what class call is this?		and	#$E000		bne	c1_d_info		; branch if a class 1 call		lda	[<param_blk_ptr]		bne	c0_dev_num_ok		lda	#invalid_dev_num		sec		rts** It's a class 0 call if got here.  Only need to return the* device's name in the caller's buffer.*c0_dev_num_ok		ldy	#$0000			; no pcount for class 0get_dev_name		lda	[<param_blk_ptr],y** The following code was added to reduce OS overhead by eliminating calls to* the device dispatcher via the language card dispatcher.*		jsr	set_dib_pointer		; set GS/OS DIB pointer		bcc	good_dev_num		; if valid device number		rts				; else exit with errorgood_dev_num		iny				; set pointer to device name buffer		iny		lda	[<param_blk_ptr],y		sta	<drvr_buf_ptr		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_buf_ptr+2		ora	<drvr_buf_ptr		; is it a NIL pointer		beq	name_copied		; yes then don't copy name		sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off		ldy	#dev_name		; point at device name length		ldx	#$00			; caller's buffer pointer** Copy device name length.*		lda	[<drvr_dib_ptr],y		phy		txy		sta	[<drvr_buf_ptr],y		ply** Point at next character but leave space for a '.' to* be inserted prior to the actual device name.*		iny		inx		inxcopy_dev_name		lda	[<drvr_dib_ptr],y		phy		txy		sta	[<drvr_buf_ptr],y		ply		iny		inx		txa		dec	a		cmp	[<drvr_buf_ptr]		beq	copy_dev_name		blt	copy_dev_name				ldy	#$0001			; now insert the '.' & adjust length		lda	#$2E		sta	[<drvr_buf_ptr],y		lda	[<drvr_buf_ptr]		inc	a		sta	[<drvr_buf_ptr]				rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on		name_copied		lda	#no_error		clc		rts		eject******************************************************************* A class 1 D_INFO call will issue a device status call to the* device since the block count contained in the DIB is a dynamic* parameter updated by the device status call.** CLASS 1:	0 Word	PCount*		1 Word	Device Number*		2 Long	Pointer to output string*		3 Word	Device characteristics*		4 Long	Block count*		5 Word	Slot Number*		6 Word	Unit Number*		7 Word	Version Number*		8 Word	Device ID Number*		9 Word	Head Device Link*		A Word	Forward Device Link*		B Long	Extended DIB Pointer******************************************************************c1_d_info		lda	[<param_blk_ptr]		cmp	#$000C			; check pcount in range		blt	good_pcnt		; branch if pcount okd_info_bad_p		lda	#invalid_pcount		; else exit with error		sec		rts** Call has a legal PCount.  See if pcount specifies that the block* count is to be returned.  If so, issue a status call to update the* block count in the DIB for current online media prior to returning* contents of the DIB.*good_pcnt		cmp	#$0002			; is it less than the minimum pcount		blt	d_info_bad_p		; yes, then invalid pcount		ldy	#$0002			; is device number for a device?		lda	[<param_blk_ptr],y		bne	non_zero_dev		; maybe, let's try it and find out!		lda	#invalid_dev_num	; zero is not a valid device number!!!		sec		rtsnon_zero_dev		lda	[<param_blk_ptr]		cmp	#$0004			; does pcount include block count?		bge	do_dev_stat		; yes** Block count is not being requested.  Just verify the device number* prior to returning requested DIB parameters.  The following code has* been modified to reduce OS overhead by eliminating unneccessary calls * through the language card dispatcher.*		ldy	#$0002		lda	[<param_blk_ptr],y		jsr	set_dib_pointer		; set GS/OS DIB pointer		bcc	dev_num_ok		; if valid device number		rts				; else exit with error** Block count has been requested.  Issue a device status call to update* the block count in the DIB prior to returning the requested DIB* parameters.*do_dev_stat		ldy	#$0002			; at minimum, return device nameget_c1_name		lda	[<param_blk_ptr],y		sta	<drvr_dev_num		; set device number from param block		jsl	get_sys_buf		; point at internal system buffer		stx	<drvr_slist_ptr		stz	<drvr_slist_ptr+2		lda	#drvr_dev_stat		; status code = device status		sta	<drvr_stat_code		lda	#$0006			; request count = $00000006		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		lda	#512			; specify block size for status		sta	<drvr_blk_size		lda	#drvr_status		; issue a blind status call		sta	<drvr_call_num		; (this updates block count in DIB)		jsl	dev_dispatcher		bcc	dev_num_ok		and	#$00FF*  8/11/88 fab changed error from dev_not_found to invalid_dev_num		cmp	#invalid_dev_num 	; v00.17 b01		bne	dev_num_ok		sec		rts** Device number is OK.  Return the DIB parameters as requested.** Copy parameters from DIB as specified by P-Count.*dev_num_ok		lda	#2		sta	|cur_paramcheck_done		lda	|cur_param		; have all parameters been passed?		cmp	[<param_blk_ptr]		beq	dib_done		; yes		inc	a			; else point at next parameter		sta	|cur_param		asl	a		tax		lda	|p_blk_offset,x		; get offset in parameter block		sta	|parm_offset		lda	|p_width,x		; get length of next parameter		sta	|cur_length		lda	|p_offset,x		; get DIB offset for parameter		sta	|dib_parm_offsetc1_parm_loop		ldy	|dib_parm_offset		lda	[<drvr_dib_ptr],y	; get parameter from DIB		ldy	|parm_offset		sta	[<param_blk_ptr],y	; and pass to caller's parameter block		inc	|dib_parm_offset	; point at next DIB parameter		inc	|dib_parm_offset		inc	|parm_offset		; point at next parameter block parameter		inc	|parm_offset		dec	|cur_length		; decrement remaining length by word		dec	|cur_length		bne	c1_parm_loop		bra	check_done** Now that all of the numeric parameters have been copied to the user's parameter block,* copy the device name to the supplied buffer, but only if a buffer has been supplied and* only if the supplied buffer is large enough.*dib_done				ldy	#$0004			; set pointer to device name buffer		lda	[<param_blk_ptr],y		sta	<drvr_buf_ptr		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_buf_ptr+2		ora	<drvr_buf_ptr		; is it a NIL pointer		beq	d_info_exit		; yes then don't copy name		lda	[<drvr_buf_ptr]		; is buffer size zero?		cmp	#$0004			; is buffer size big enough for length?		blt	d_info_exit		; no, then don't copy name		ldy	#dev_name		; else let's set the string length		lda	[<drvr_dib_ptr],y		and	#$001F		inc	a			; account for additional '.' character		sta	|name_length		ldy	#$0002		sta	[<drvr_buf_ptr],y		clc		adc	#3			; account for size words		cmp	[<drvr_buf_ptr]		; compare to size of supplied buffer		bcc	will_fit		; buffer is large enough, copy name		lda	#buff_too_small		; else return the error		rts				; (carry is already set)** Point at 1st character but leave space for a '.' to* be inserted prior to the actual device name.*will_fit		sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off		ldy	#dev_name+1		; point at 1st name character		ldx	#$05			; caller's buffer pointercopy_c1_name		lda	[<drvr_dib_ptr],y		phy		txy		sta	[<drvr_buf_ptr],y		ply		iny				; point next DIB character		txa		inx				; point next caller's buffer		dec	a		dec	a		dec	a		cmp	|name_length		; has entire string been moved?		blt	copy_c1_name		; no** Name is copied.  Insert a '.' at head of string.*		ldy	#$04			; now insert the '.' & adjust length		lda	#$2E		sta	[<drvr_buf_ptr],y		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	ond_info_exit	clc		lda	#no_error		rtscur_param	dc.w	0cur_length	dc.w	0parm_offset	dc.w	0dib_parm_offset	dc.w	0p_width		dc.w	2	; parameter 0 = (w)  pcount		dc.w	2	; parameter 1 = (w)  device number		dc.w	2	; parameter 2 = (lw) device name pointer		dc.w	2	; parameter 3 = (w)  device characteristics		dc.w	4	; parameter 4 = (lw) block count		dc.w	2	; parameter 5 = (w)  slot number		dc.w	2	; parameter 6 = (w)  unit number		dc.w	2	; parameter 7 = (w)  version number		dc.w	2	; parameter 8 = (w)  device ID number		dc.w	2	; parameter 9 = (w)  head link		dc.w	2	; parameter A = (w)  forward link		dc.w	4	; parameter B = (lw) extended DIB pointer		dc.w	2	; parameter C = (w)  DIB device numberp_offset	dc.w	$0000	; parameter 0 = (w)  pcount		dc.w	$0000	; parameter 1 = (w)  device number		dc.w	$000E	; parameter 2 = (32) device name pointer		dc.w	$0008	; parameter 3 = (w)  device characteristics		dc.w	$000A	; parameter 4 = (lw) block count		dc.w	$002E	; parameter 5 = (w)  slot number		dc.w	$0030	; parameter 6 = (w)  unit number		dc.w	$0032	; parameter 7 = (w)  version number		dc.w	$0034	; parameter 8 = (w)  device ID number		dc.w	$0036	; parameter 9 = (w)  head link		dc.w	$0038	; parameter A = (w)  forward link		dc.w	$003A	; parameter B = (lw) extended DIB pointer		dc.w	$003E	; parameter C = (w)  DIB device number		p_blk_offset		dc.w	$0000	; pcount		dc.w	$0002	; device number		dc.w	$0004	; device name pointer		dc.w	$0008	; device characteristics		dc.w	$000A	; block count		dc.w	$000E	; slot number		dc.w	$0010	; unit number		dc.w	$0012	; version number		dc.w	$0014	; device ID number		dc.w	$0016	; head device link		dc.w	$0018	; forward device link		dc.w	$001A	; extended DIB pointer		dc.w	$001C	; DIB device number				endp		eject******************************************************************* This routine provides applications direct access to a device* through the status call.  This routine is responsible for* setting up the device driver environment prior to dispatching* to the device driver via the device dispatcher.** The minimum pcount for status is $0005 indicating that the* following parameters are required.**               word    input           pcount*               word    input           device number*               word    input           control code*               long    input           control list pointer*               long    input           request count*               long    output          transfer count** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode (16 bit 'm' & 'x')** EXIT:         A Reg = Error Code*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode*                       c=0 if no error occured*                       c=1 if error occured******************************************************************		export	d_status	d_status	proc		longa	on		longi	on** The code required to implement the D_STATUS call is* identical to the code required to implement the* D_CONTROL call.  Just fall through to D_CONTROL.*		endp		eject******************************************************************* This routine provides applications direct access to a device* through the control call.  This routine is responsible for* setting up the device driver environment prior to dispatching* to the device driver via the device dispatcher.** The minimum pcount for control is $0005 indicating that the* following parameters are required.**               word    input           pcount*               word    input           device number*               word    input           control code*               long    input           control list pointer*               long    input           request count*               long    output          transfer count** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode (16 bit 'm' & 'x')** EXIT:         A Reg = Error Code*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode*                       c=0 if no error occured*                       c=1 if error occured******************************************************************		export	d_controld_control	proc		longa	on		longi	on		lda	<call_number		; is this a class 1 call?		and	#$E000		bne	d_ctrl			; branch if class 1				lda	#bad_system_call		sec		rts** Only class 1 is supported by this call.  Class 2 through 7* have already been parsed out by the main entry point to the* device manager.*d_ctrl		lda	[<param_blk_ptr]		cmp	#$0005		beq	do_d_ctrl		; branch if pcnt ok		lda	#invalid_pcount		; else exit with invalid pcount errord_control_error	sec				;6-Mar-93 JCMd_invalid	rts				;6-Mar-93 JCM		** Parameter count is correct.  Issue device status call.  Maybe.*do_d_ctrl	ldy	#$0002		lda	[<param_blk_ptr],y	; get target device number		sta	<drvr_dev_num		; device number		jsr	set_dib_pointer		; set GS/OS DIB pointer		bcs	d_invalid		; if invalid device number					iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_ctrl_code		; control code		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_clist_ptr		; control list pointer		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_clist_ptr+2		ora	<drvr_clist_ptr		; is it a NIL pointer?		bne	not_nil_ptr		; no** REVISED 4/6/89 version 5.0 d18 by RBM as requested by Greg Branche.** Check if NIL control list pointer is allowed based on* the status or control call.*		lda	<call_number		; is this a status call?		ror	a		bcs	invalid_nil_ptr		; yes, all status calls require a status list ptr				lda	<drvr_ctrl_code		; is it a reset, format or eject call?		cmp	#$0003		blt	not_nil_ptr		; yes, NIL control list pointer is validinvalid_nil_ptr		lda	#drvr_bad_parm		; else bad parameter error		sec		rtsnot_nil_ptr		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_req_cnt		; request count		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_req_cnt+2* 6-Mar-93 JCM - We now check bit $0010 of the specified device's characteristics word to determine if*		 it can handle calls that were not defined before 6.0.1. We shouldn't have had to have*		 done this since the guidelines say drivers are to return errors for calls they don't*		 know about, but when do developers read documentation? RamFAST is a fine example of*		 a driver that does random things for previously undefined status and control codes.				ldy	#dev_char		; pointer to DIB device characteristics		lda	[<drvr_dib_ptr],y	; get the device characteristics		and	#$0010			; get "driver is clean" bit (driver follows guidelines)		pha				; save for either d_control or d_status		lda	<call_number		ror	a		bcc	is_control		ldx	#drvr_status		; we're doing a D_Status call		pla				; "driver is clean" characteristics bit		bne	set_call_num		; driver can accept any call		lda	<drvr_ctrl_code		bmi	set_call_num		; pass all device-specific calls on to the driver		cmp	#5			; maximum DStatus code + 1 (ReturnPartitionMap)		blt	set_call_num		; driver should be able to handle the standard callsreturn_bad_code	lda	#drvr_bad_code				bra	d_control_error		is_control	ldx	#drvr_control		; else prepare for control call				pla				; "driver is clean" characteristics bit		bne	is_call_format		; driver can take any call				lda	<drvr_ctrl_code		bmi	set_call_num		; pass all device-specific calls on to the driver				cmp	#10			; maximum DControl code + 1 (SetPartitionMap)		bge	return_bad_codeis_call_format	lda	<drvr_ctrl_code		; is it a format call?		dec	a		bne	set_call_num		; no				jsl	set_disksw		; yes, delete all blocks from the cacheset_call_num		stx	<drvr_call_num		jsl	dev_dispatcher		tax				; save error code		ldy	#$000E			; return transfer count		lda	<drvr_tran_cnt		sta	[<param_blk_ptr],y		iny		iny		lda	<drvr_tran_cnt+2		sta	[<param_blk_ptr],y		txa				; restore error code		rts				; return with device status		endp		eject******************************************************************* This routine executes the read function directly to from* device.  It is responsible for setting up the environment* for the device driver prior to dispatching to the device* driver via the device dispatcher.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode (16 bit 'm' & 'x')** EXIT:         A Reg = Error Code*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode*                       c=0 if no error occured*                       c=1 if error occured******************************************************************		export	d_read		d_read		proc		longa	on		longi	on** The code neccessary to implement D_READ is identical to that* required to implement D_WRITE.  Just fall into the D_WRITE* call.*		endp		eject******************************************************************* This routine executes the write function directly to the* device.  It is responsible for setting up the environment* for the device driver prior to dispatching to the device* driver via the device dispatcher.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode (16 bit 'm' & 'x')** EXIT:         A Reg = Error Code*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = full native mode*                       c=0 if no error occured*                       c=1 if error occured******************************************************************		export	d_write		d_write		proc		longa	on		longi	on		lda	<call_number		; is this a class 1 call?		and	#$E000		bne	d_wr			; branch if class 1				lda	#bad_system_call		sec		rtsbad_pcount		lda	#invalid_pcount		; else exit with invalid pcount error		sec		rtsd_invalid	lda	#invalid_dev_num		sec		rtsbad_parm		lda	#drvr_bad_parm		; else bad parameter error		sec		rts** Only class 1 is supported by this call.  Class 2 through 7* have already been parsed out by the main entry point to the* device manager.*d_wr		lda	[<param_blk_ptr]		cmp	#$0006		bne	bad_pcount		; pcount no good!** Issue device write call.*do_d_write	ldy	#$0002			; setup for device status call		lda	[<param_blk_ptr],y	; get target device number		beq	d_invalid		; cant call device $0000not_d_invalid		sta	<drvr_dev_num		; device number		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_buf_ptr		; buffer pointer		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_buf_ptr+2		ora	<drvr_buf_ptr		; is it a NIL pointer		beq	bad_parm		not_nil		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_req_cnt		; request count		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_req_cnt+2		; request count		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_blk_num		; block number		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_blk_num+2		; block number		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_blk_size		; block size		beq	no_cache_stuff		; yes, no system service required				jsl	cache_del_vol		; mark internal data structures as if a switch...		lda	<drvr_dev_num		; had occurred to preserve system.		jsl	swap_out** Parameter block is set up.  Purge any blocks in the cache for this* volume and set the cache priority to zero prior to issuing a call* to read or write from or to the device.*no_cache_stuff		stz	<drvr_cache		; cache priority = 0000		stz	<drvr_fst_num		; no FST is accessing device** Now it's save to access the device.  Go ahead and dispatch to device.*		ldx	#drvr_write		; assume it's a write call		lda	<call_number		and	#$000F		beq	set_call_num		; assumed correct		dex				; else prepare for read callset_call_num		stx	<drvr_call_num		jsl	dev_dispatcher		tax				; preserve read/write error status** Send transfer count back to caller.*		ldy	#$0012		lda	<drvr_tran_cnt		sta	[<param_blk_ptr],y		iny		iny		lda	<drvr_tran_cnt+2		sta	[<param_blk_ptr],y		txa				; restore read/write error status		rts				endp				eject******************************************************************* This routine implements the device info call (D_INFO).** Note that this call can only be issued from a CDEV or INIT.* Dynamic renaming causes too many management problems for* prefix 10,11 and 12 which are used for I/O redirection.** Note that dynamic renaming is not supported if the target* device is the console driver.  The console driver is a* mandatory component of the operating system and as such is* not dynamic in nature.  The target device name will be * converted to upper case prior to renaming the target.** CLASS 0:      Not Supported!!!** CLASS 1:    0 Word    PCount (Minimum = Maximum = $0002)*             1 Word    Device Number*             2 Long    Pointer to replacement string** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error Code*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0 = no error*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0 = error** Valid error codes that can be returned from this call are:**	$0004 = Invalid PCount*	$0011 = Invalid Device Number*	$0067 = Duplicate Device*	$0053 = Parameter Range Error*	$0029 = Driver Busy (cannot be renamed)******************************************************************		export	d_rename		d_rename	proc		longa	on		longi	on				lda	<call_number		; is this a class 1 call?		and	#$E000		bne	d_rename_c1		; branch if class 1		lda	#bad_system_call		sec		rts** Only class 1 is supported by this call.  Class 2 through 7* have already been parsed out by the main entry point to the* device manager.*d_rename_c1 		lda	[<param_blk_ptr]	; pcount must be 2 for this call		cmp	#$0002		beq	do_rename_c1		; branch if pcnt ok				lda	#invalid_pcount		; else exit with invalid pcount error		sec		rts** Parameter count is correct.  Check if the new name is a duplicate name.*do_rename_c1		ldy	#$0004			; Set pointer to replacement name		lda	[<param_blk_ptr],y		sta	<drvr_clist_ptr		iny		iny		lda	[<param_blk_ptr],y		sta	<drvr_clist_ptr+2				lda	[<drvr_clist_ptr]	; make class 1 string like offset pstring		xba		sta	[<drvr_clist_ptr]		xba		cmp	#32			; check replacement string length		bge	wrong_length		tay		beq	wrong_length				sep	#$20			; 8 bit 'm'		longa	off				ldy	#$0001			; copy name to buffercopy_name_loop		lda	[<drvr_clist_ptr],y		cmp	#$61			; is it a lower case alpha?		blt	not_alpha		; no		cmp	#$7B		bge	not_alpha		; no		and	#$DF			; else make it upper casenot_alpha		sta	|new_name-1,y		iny		cpy	#33		bne	copy_name_loop				rep	#$20			; 16 bit 'm'		longa	off		** Search entire device list checking existing names against the replacement* name.  If a duplicate name is detected then return a DUPE_DEVICE error $0067.*		lda	[<drvr_dev_ptr]		; get last device number		inc	a			; point one past the last device		sta	<drvr_dev_num		; and start the name searchdup_chk_loop		dec	<drvr_dev_num		; point at previous device		beq	dup_chk_done		; if no more devices		jsr	set_dib_ptr		; point at dup check dib				sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off				ldy	#dev_name		ldx	#0name_chk_loop		lda	[<drvr_dib_ptr],y	; character from DIB device name		cmp	|new_name,x		; check against replacement name		bne	not_same_name		iny		inx		cpx	|new_name		; compare until mismatch or end of string		blt	name_chk_loop		beq	name_chk_loop** Name is same as existing device.  Is existing device the target* device (are we naming something to it's current name)?* CHANGED 5.00 D 20 (April 25, 1989 by RBM).*		lda	<drvr_dev_num		ldy	#2		cmp	[<param_blk_ptr],y		beq	name_chk_loop		; same device, continue search				sec				; else, error if name matched different device		lda	#dup_device		bra	name_chk_donenot_same_name		clc				; no error if name mismatchedname_chk_done		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on				bcs	rename_done		; if it's a duplicate name		bcc	dup_chk_loop		; if not a duplicatewrong_length		lda	#parm_range_err		sec		bra	rename_done** The requested name is not already assigned to an existing device.* Set the DIB pointer for the target device to be renamed.*dup_chk_done		ldy	#$0002			; get device number to set DIB pointer		lda	[<param_blk_ptr],y		sta	<drvr_dev_num		jsr	set_dib_pointer		bcs	rename_done				ldy	#dev_char		; can the device be renamed?		lda	[<drvr_dib_ptr],y		and	#$0400		beq	can_rename		sec				; device cannot be renamed		lda	#invalid_access		bra	rename_done		can_rename		sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off				ldy	#dev_name		ldx	#0rename_dib		lda	|new_name,x		; replacement name (pstring)		sta	[<drvr_dib_ptr],y		iny		inx		cpx	|new_name		blt	rename_dib		beq	rename_dib		lda	#' 'space_loop		cpy	#slot_num		; do spaces need to be added?		bge	no_spaces		sta	[<drvr_dib_ptr],y		iny		bra	space_loopno_spaces		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on				lda	#no_error		clcrename_done		php		pha		lda	[<drvr_clist_ptr]	; restore class 1 string		xba		sta	[<drvr_clist_ptr]		pla		and	#$00FF		plp		rtsnew_name	dc.b	0			; length of replacement name		ds	32			; ascii replacement name				endp		eject****************************************************************** The following routine checks that a requested slot selection* is valid.  If so, the requested slot is selected and the* appropriate screen holes are copied in prior to passing* control back to the calling routine.** NOTE:  No dynamic slot selection occurs at this time.** ENTRY: via a 'JSL'*               A Reg = %000000000000xxxx Requested slot*               	%100000000000xxxx NULL request*               	%000000010000xxxx Save current as default configuration*               	%000000100000xxxx Restore default configuration*               	%000000110000xxxx Restore bit encoded configuration*               X Reg = Undefined or bit encoded configuration*  ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |* | F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |* |___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |_ 0*   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |_____ 1 = slot 1 active*   |   |   |   |   |   |   |   |   |   |   |   |   |   |_________ 1 = slot 2 active*   |   |   |   |   |   |   |   |   |   |   |   |   |_____________ 1 = slot 3 active*   |   |   |   |   |   |   |   |   |   |   |   |_________________ 1 = slot 4 active*   |   |   |   |   |   |   |   |   |   |   |_____________________ 1 = slot 5 active*   |   |   |   |   |   |   |   |   |   |_________________________ 1 = slot 6 active*   |   |   |   |   |   |   |   |   |_____________________________ 1 = slot 7 active*   |   |   |   |   |   |   |   |_________________________________ 0*   |   |   |   |   |   |   |_____________________________________ 1 = slot 9 active*   |   |   |   |   |   |_________________________________________ 1 = slot A active*   |   |   |   |   |_____________________________________________ 1 = slot B active*   |   |   |   |_________________________________________________ 1 = slot C active*   |   |   |_____________________________________________________ 1 = slot D active*   |   |_________________________________________________________ 1 = slot E active*   |_____________________________________________________________ 1 = slot F active**               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT: via an 'RTL'*               A Reg = Error code*               X Reg = bit encoded slot configuration*               Y Reg = Unspecified*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0   If slot was granted*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0   If slot was not granted*****************************************************************		export	slot_arbiterslot_arbiter	proc		longa	on		longi	on		phb				; need my data bank $E0 for I/O access		phk		plb		clc				; assume not a slot request		tay		and	#$0300			; is request for bit encoded configuration?		bne	exit			; yes		tya				sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off		sta	|slot_req		; save requested slot selection		and	#$07			; strip external bit		beq	bad_sel			; slot 0 or 8 not valid		cmp	#$03			; slot 3 is a special case		beq	slot3_req		tay				; is current slot external?		lda	>sltromselloop		ror	a		dey		bpl	loop			; c=1 if external on loop exitcheck_slot		lda	|slot_req		; was request for an external		and	#$08		bcs	chk_if_ext		; yes		bne	bad_sel			; if is int. but requested ext.good_sel		clc				; must be what was requested		bra	exitchk_if_ext		bne	good_selbad_sel		secexit		php				; preserve error flag				sep	#$20			; 8 bit 'm'	(3/20/89 RBM)		longa	off				lda	>sltromsel		; get slot		pha				; and create bit encoded configuration		xba		pla		plp				; restore error flag		rep	#$30		longa	on		longi	on		eor	#$00FF			; complete bit encoded configuration		and	#$FEFE		tax		lda	#no_error		; assume no error occured		bcc	real_exit		; if assumed correct		lda	#dev_not_found		; else cant grant the requested slotreal_exit		plb		rtlslot3_req		longa	off		longi	off		lda	>rdc3rom		; need slot 3 selection		rol	a		bra	check_slot		; c=1 if slot 3 is external				endp		eject****************************************************************** This routine sets the system speed in preperation for* calling a speed dependent device driver.  Speed settings* are in the least significant two bits of the accumulator* defined as follows:**               00      1.0  mHz*               01      2.6  mHz*               10      >2.6 mHz*               11      Not speed dependent (no change)** ENTRY: via a 'JSL'*               A Reg = Requested speed*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Speed prior to requested change*               X Reg = Undefined*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*****************************************************************		export	gsos_speedgsos_speed	proc		longa	on		longi	on		and	#$0003			; mask unwanted bits		sta	>current_speed		; update current speed		cmp	#$0003			; any change?		beq	speed_exit		; no		cmp	#$0002			; >2.6 mhz?		bne	range_ok		; yes, cant do that yet!!!		dec	a			; so try 2.6 mhzrange_ok		sep	#$20			; 8 bit 'm'		longa	off		tay				; save next speed setting		lda	>cyareg			; get current setting		and	#%10000000		clc		rol	a		rol	a		tax				; X = previous speed		tya		beq	set_slow		lda	#%10000000		; set fast speed		ora	>cyareg		sta	>cyareg		bra	keep_previousset_slow		lda	>cyareg			; set slow speed		and	#%01111111		; set slow speed		sta	>cyaregkeep_previous		txa				; and keep previous speed		rep	#$20			; 16 bit 'm'		longa	onspeed_exit		and	#$0003		rtl		endp		eject****************************************************************** This routine sets the DIB pointer on GS/OS direct page for* the device specified in the A register.** ENTRY: via a 'JSL'*               A Reg = Device Number*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:         A Reg = Error code*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0    If no error *                       ¥ ¥ 0 0 0 ¥ ¥ 1  0    If error*****************************************************************		export	set_dib_pointerset_dib_pointer	proc		longa	on		longi	on;;;		cmp	#$0000			; is this a legal device number?		inc	a			;6-Mar-93 JCM		dec	a			;6-Mar-93 JCM		bne	maybe_legal		; it might be, lets check range...past_last_dev		lda	#invalid_dev_num		sec		rtsmaybe_legal		cmp	[<drvr_dev_ptr]		; is this a legal device number?		beq	dev_in_range		; yes		bge	past_last_dev		; nodev_in_range		phy		dec	a			; set pointer to DIB		sec		rol	a		asl	a		asl	a		tay		lda	[<drvr_dev_ptr],y		sta	<drvr_dib_ptr		iny		iny		lda	[<drvr_dev_ptr],y		sta	<drvr_dib_ptr+2		ply		lda	#no_error		; exit with no error		clc		rts		endp				eject;****************************************************************;*;* Hey, someone had to put our names somewhere!!!;*;****************************************************************;		export	os_names;os_names	proc;;		dc.b	'The GS/OS 6.0 Engineering Team',$0D,$0D;		dc.b	'The Bosses',$09,'F. Bachman & L. Collings',$0D;		dc.b	'System Control Manager',$09,'C. Farrier & G. Branche',$0D;		dc.b	'ProDOS FST',$09,'C. Ewy',$0D;		dc.b	'ExpressLoad',$09,'G. Branche',$0D;		dc.b	'High Sierra FST',$09,'C. Ewy',$0D;		dc.b	'Character FST',$09,'C. Ewy',$0D;		dc.b	'Console Driver',$09,'G. Branche',$0D;		dc.b	'GLoader & GQuit',$09,'G. Branche',$0D;		dc.b	'Device Manager',$09,'G. Branche',$0D;		dc.b	'Device Dispatcher',$09,'G. Branche',$0D;		dc.b	'Bank Zero Dispatcher',$09,'G. Branche',$0D;		dc.b	'Generated Drivers',$09,'G. Branche',$0D;		dc.b	'AppleDisk3.5 Driver',$09,'J. Arkley, G. Branche',$0D;		dc.b	'UniDisk3.5 Driver',$09,'G. Branche',$0D;		dc.b	'AppleDisk5.25 Driver',$09,'M. Stein, G. Branche',$0D;		dc.b	'AppleShare FST',$09,'M. Day',$0D;		dc.b	'AppleShare Drivers',$09,'M. Day',$0D;		dc.b	'Cache Manager',$09,'R. Chiang, Rob Turner',$0D;		dc.b	'SCSI Manager',$09,'M. Gulick',$0D;		dc.b	'SCSI HD & CD ROM Disk',$09,'M. Gulick',$0D;		dc.b	'System Loader',$09,'G. Branche',$0D,$00;		;		endp		end