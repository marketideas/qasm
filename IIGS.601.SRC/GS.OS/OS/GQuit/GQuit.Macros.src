		MACRO &lab 		_BlockMove &lab 		ldx 	#$2B02 		jsl $E10000		MEND 	       MACRO&lab	       _FWEntry&lab	       ldx     #$2403	       jsl     $E10000	       MEND	       MACRO&lab	       _DeleteID&lab	       ldx     #$2103	       jsl     $E10000	       MEND	       MACRO&lab	       _RenamePathname&lab	       ldx     #$1311	       jsl     $E10000	       MEND	       MACRO&lab	       _LGetPathname2&lab	       ldx     #$2211	       jsl     $E10000	       MEND	       MACRO&lab	       _GetUserID2&lab	       ldx     #$2111	       jsl     $E10000	       MEND	       MACRO&lab	       _InitialLoad2&lab	       ldx     #$2011	       jsl     $E10000	       MEND	       MACRO&lab	       _TLTextMountVolume&lab	       ldx     #$1201	       jsl     $E10000	       MEND	       MACRO&lab	       _endsession1 &params&lab	       jsl     $E100A8	       DC.W    $201e	       DC.L    &params	       MEND	       MACRO&lab	       _QUIT1  &params&lab	       jsl     $E100A8	       DC.W    $2029	       DC.L    &params	       MEND	       MACRO&lab	       _OPEN1  &params&lab	       jsl     $E100A8	       DC.W    $2010	       DC.L    &params	       MEND	       MACRO&lab	       _CLOSE1 &params&lab	       jsl     $E100A8	       DC.W    $2014	       DC.L    &params	       MEND	       MACRO&lab	       _GETPREFIX1 &params&lab	       jsl     $E100A8	       DC.W    $200A	       DC.L    &params	       MEND	       MACRO&lab	       _SETPREFIX1 &params&lab	       jsl     $E100A8	       DC.W    $2009	       DC.L    &params	       MEND	       MACRO&lab	       _GETFILEINFO1 &params&lab	       jsl     $E100A8	       DC.W    $2006	       DC.L    &params	       MEND	       MACRO&lab	       _GetDirEntry1 &params&lab	       jsl     $E100A8	       DC.W    $201C	       DC.L    &params	       MEND	       MACRO&lab	       _Volume1 &params&lab	       jsl     $E100A8	       DC.W    $2008	       DC.L    &params	       MEND	       MACRO&lab	       _GetDevNumber1 &params&lab	       jsl     $E100A8	       DC.W    $2020	       DC.L    &params	       MEND	       MACRO&lab	       _FSTSpecific1 &params&lab	       jsl     $E100A8	       DC.W    $2033	       DC.L    &params	       MEND	       MACRO&lab	       _DInfo1 &params&lab	       jsl     $E100A8	       DC.W    $202C	       DC.L    &params	       MEND	       MACRO&lab	       _SetTSPtr&lab	       ldx     #$0A01	       jsl     $E10000	       MEND	       MACRO&lab	       _SETLEVEL &params&lab	       jsl     $E100A8	       DC.W    $1A	       DC.L    &params	       MEND	       MACRO&lab	       _LGetPathname&lab	       ldx     #$1111	       jsl     $E10000	       MEND	       MACRO&lab	       _GetUserID&lab	       ldx     #$1011	       jsl     $E10000	       MEND	       MACRO&lab	       _InitialLoad&lab	       ldx     #$0911	       jsl     $E10000	       MEND	       MACRO&lab	       _Restart&lab	       ldx     #$0A11	       jsl     $E10000	       MEND	       MACRO&lab	       _UserShutDown&lab	       ldx     #$1211	       jsl     $E10000	       MEND	       MACRO&lab	       _TotalMem&lab	       ldx     #$1D02	       jsl     $E10000	       MEND	       MACRO&lab	       _CompactMem&lab	       ldx     #$1F02	       jsl     $E10000	       MEND	       MACRO&lab	       _ReAllocHandle&lab	       ldx     #$0A02	       jsl     $E10000	       MEND	       MACRO&lab	       _SetHandleSize&lab	       ldx     #$1902	       jsl     $E10000	       MEND	       MACRO&lab	       _DisposeHandle&lab	       ldx     #$1002	       jsl     $E10000	       MEND	       MACRO&lab	       _FindHandle&lab	       ldx     #$1A02	       jsl     $E10000	       MEND	       MACRO&lab	       _NewHandle&lab	       ldx     #$0902	       jsl     $E10000	       MEND	       MACRO&lab	       _HLock&lab	       ldx     #$2002	       jsl     $E10000	       MEND	       MACRO&lab	       _HUnLock&lab	       ldx     #$2202	       jsl     $E10000	       MEND	       MACRO&lab	       _GetNewID&lab	       ldx     #$2003	       jsl     $E10000	       MEND	       MACRO&lab	       _SysFailMgr&lab	       ldx     #$1503	       jsl     $E10000	       MEND	       MACRO&lab	       _DeskShutDown&lab	       ldx     #$0305	       jsl     $E10000	       MEND	       MACRO&lab	       _InstallCDA&lab	       ldx     #$0F05	       jsl     $E10000	       MEND	       MACRO&lab	       _InstallNDA&lab	       ldx     #$0E05	       jsl     $E10000	       MEND	       MACRO&lab	       _OPEN   &params&lab	       jsl     $E100A8	       DC.W    $10	       DC.L    &params	       MEND	       MACRO&lab	       _READ   &params&lab	       jsl     $E100A8	       DC.W    $12	       DC.L    &params	       MEND	       MACRO&lab	       _READ1  &params&lab	       jsl     $E100A8	       DC.W    $2012	       DC.L    &params	       MEND	       MACRO&lab	       _CLOSE  &params&lab	       jsl     $E100A8	       DC.W    $14	       DC.L    &params	       MEND	       MACRO&lab	       _GETFILEINFO &params&lab	       jsl     $E100A8	       DC.W    6	       DC.L    &params	       MEND	       MACRO&lab	       _SETPREFIX &params&lab	       jsl     $E100A8	       DC.W    9	       DC.L    &params	       MEND	       MACRO&lab	       _GETPREFIX &params&lab	       jsl     $E100A8	       DC.W    $0A	       DC.L    &params	       MEND	       MACRO&lab	       _SETMARK	&params&lab	       jsl     $E100A8	       DC.W    $16	       DC.L    &params	       MEND	       MACRO&lab	       _GETEOF &params&lab	       jsl     $E100A8	       DC.W    $19	       DC.L    &params	       MEND	       MACRO&lab	       _GETEOF1	&params&lab	       jsl     $E100A8	       DC.W    $2019	       DC.L    &params	       MEND	       MACRO&lab	       _GETPATHNAME &params&lab	       jsl     $E100A8	       DC.W    $27	       DC.L    &params	       MEND	       MACRO&lab	       _GETBOOTVOL &params&lab	       jsl     $E100A8	       DC.W    $28	       DC.L    &params	       MEND	       MACRO&lab	       _DisposHandle&lab	       ldx     #$1002	       jsl     $E10000	       MEND	       MACRO&lab	       _DisposAll&lab	       ldx     #$1102	       jsl     $E10000	       MEND		MACRO		_PurgeAll		ldx	#$1302		jsl	$E10000		MEND;...............................................................;;	 Define	string;;	 Generates a Pascal type of string;...............................................................	       MACRO	       str     &string	       lclc    &sset&sset	       SETC    &SETTING('STRING')	       STRING  PASCAL	       dc.B    &string	       STRING  &sset	       MEND	       MACRO&lab	       pull1   &SYSOPR&lab					       ; 	       shortm	       pla	       IF      &SYSOPR=''	       GOTO .end	       sta     &SYSOPR.end	       longm	       MEND	       MACRO&lab	       add4    &a1,&a2,&a3&lab					       ; 	       LCLC    &C1	       LCLC    &C2	       LCLC    &REST1	       LCLC    &REST2&C2	       SETC    &SUBSTR(&a2,1,1)&REST2	       SETC    &SUBSTR(&a2,2,255)	       IF      &a1		       = '' GOTO .a&C1	       SETC    &SUBSTR(&a1,1,1)&REST1	       SETC    &SUBSTR(&a1,2,255)	       lda     &a1.a	       clc	       adc     &a2	       sta     &a3	       IF      &a1		       <> '' GOTO .b	       lda     #0	       GOTO    .d.b	       IF      &C1='#'		       GOTO .c	       lda     &a1+2	       GOTO    .d.c	       lda     #^&REST1.d	       IF      &C2='#'		       GOTO .e	       adc     &a2+2	       GOTO    .f.e	       adc     #^&REST2.f	       sta     &a3+2	       MEND	       MACRO&lab	       sub4    &a1,&a2,&a3&lab					       ; 	       LCLC    &C1	       LCLC    &C2	       LCLC    &REST1	       LCLC    &REST2&C2	       SETC    &SUBSTR(&a2,1,1)&REST2	       SETC    &SUBSTR(&a2,2,255)	       IF      &a1		       = '' GOTO .a&C1	       SETC    &SUBSTR(&a1,1,1)&REST1	       SETC    &SUBSTR(&a1,2,255)	       lda     &a1.a	       sec	       sbc     &a2	       sta     &a3	       IF      &a1		       <> '' GOTO .b	       lda     #0	       GOTO    .d.b	       IF      &C1='#'		       GOTO .c	       lda     &a1+2	       GOTO    .d.c	       lda     #^&REST1.d	       IF      &C2='#'		       GOTO .e	       sbc     &a2+2	       GOTO    .f.e	       sbc     #^&REST2.f	       sta     &a3+2	       MEND	       MACRO&lab	       long&lab					       ; 	       rep     #%00110000	       longa   on	       longi   on	       MEND	       MACRO&lab	       longm&lab					       ; 	       rep     #%00100000	       longa   on	       MEND	       MACRO&lab	       short&lab					       ; 	       sep     #%00110000	       longa   off	       longi   off	       MEND	       MACRO&lab	       shortm&lab					       ; 	       sep     #%00100000	       longa   off	       MEND	       MACRO&lab	       Tool    &tool_num,&func_num,&param_list,&error_jmp&lab					       ; 	       IF      &param_list	       = '' GOTO .a	       push4   #&param_list.a	       ldx     #&tool_num+&func_num<<8	       jsl     $E10000	       IF      &error_jmp	       = '' GOTO .d	       bcc     *+5	       brl     &error_jmp.d	       MEND	       MACRO&lab	       push    &sysopr	       IF      &sysopr		       = '' GOTO .a&lab	       pushword	&sysopr	       MEXIT.a&lab	       pushword	       MEND	       MACRO&lab	       push4   &sysopr	       IF      &sysopr		       = '' GOTO .a&lab	       pushlong	&sysopr	       MEXIT.a&lab	       pushlong	       MEND	       MACRO&lab	       move    &one,&two	       IF      &one		   	= '' GOTO .a	       IF      &two		   	= '' GOTO .b&lab	       moveword	&one,&two	       MEXIT.b&lab	       moveword	&one	       MEXIT.a&lab	       moveword	       MEND	       MACRO&lab	       pullxy  &addr&lab					       ; 	       plx	       ply	       IF      &addr		       = '' GOTO .a	       stx     &addr	       sty     &addr+2.a	       MEND;............................................................;;	 Push long (4 bytes) onto stack;;    pushlong address		  - push contents of address;    pushlong address,x		  - push contents of address,x;    pushlong const,s		  - push contents of stack+const    ;    pushlong #address/const	  - push address or constant;    pushlong [zeropage],offset	  - push using indirect	address;...............................................................	       MACRO	       pushlong	&addr,&offset	       IF      &addr[1:1]='#'	       THEN	       pea     &addr[2:255]>>16	       pea     |&addr[2:255]	       ELSEIF  &addr[1:1]='['	       THEN	       ldy     #&offset+2	       pushword	&addr,y	       ldy     #&offset	       pushword	&addr,y	       ELSEIF  &offset='s'	       THEN	       pushword	&addr+2,s	       pushword	&addr+2,s	       ELSEIF  &offset=''	       THEN	       pushword	&addr+2	       pushword	&addr	       ELSE	       pushword	&addr+2,&offset	       pushword	&addr,&offset	       ENDIF	       MEND;...............................................................;;	 Push 2	bytes onto stack;;    pushword loc     -- pushes	bytes onto stack from 'loc';    pushword loc,x   -- pushes	bytes onto stack from 'loc,x';    pushword #n      -- pushes	constant #n onto stack;    pushword	      -- pushes	bytes onto stack (from A);...............................................................	       MACRO	       pushword	&addr,&reg	       IF      &addr[1:1]='#'	       AND &SETTING('LONGA')='ON' THEN	       pea     |&addr[2:255]	       ELSE	       IF      &addr­''		       THEN	       IF      &reg­''		       THEN 	       lda			       &addr,&reg	       ELSE	       lda			       &addr	       ENDIF	       ENDIF	       pha	       ENDIF	       MEND	       MACRO&lab	       stay    &addr,&offset&lab					       ; 	       LCLC    &C&C	       SETC    &SUBSTR(&addr,1,1)	       IF      &C='['		       GOTO .zeropage	       IF      &C='>'		       GOTO .long1	       IF      &offset		       = '' GOTO .no_offset	       IF      &offset='s'	       GOTO .stack	       IF      &C='|'		       GOTO .long2	       sta     &addr,&offset	       sty     &addr+2,&offset	       MEXIT.long1	       IF      &offset		       <> '' GOTO .long2	       sta     &addr	       pha	       tya	       sta     &addr+2	       pla	       MEXIT.stack	       sta     &addr,&offset	       pha	       tya	       sta     &addr+4,&offset	       pla	       MEXIT.long2	       sta     &addr,&offset	       pha	       tya	       sta     &addr+2,&offset	       pla	       MEXIT.no_offset	       sta     &addr	       sty     &addr+2	       MEXIT.zeropage	       pha	       phy	       ldy     #&offset	       sta     &addr,y	       lda     1,s	       ldy     #&offset+2	       sta     &addr,y	       ply	       pla	       MEND	       MACRO&lab	       moveword	&from,&to1,&to2&lab					       ; 	       LCLC    &C&C	       SETC    &SUBSTR(&from,1,1)	       IF      &C='['		       GOTO .zeropage	       lda     &from	       sta     &to1	       IF      &to2		       = '' GOTO .a	       sta     &to2.a	       MEXIT.zeropage	       IF      &to1='0'		       GOTO .b	       ldy     #&to1	       lda     &from,y	       sta     &to2	       MEXIT.b	       lda     &from	       sta     &to2	       MEND	       MACRO&lab	       Check_Error &error_jmp&lab					       ; 	       bcc     @1	       jsr     &error_jmp@1					       ; 	       MEND	       MACRO&lab	       Switch8&lab	       sep     #$30	       longa   off	       longi   off	       MEND	       MACRO&lab	       Switch16&lab	       rep     #$30	       longa   on	       longi   on	       MEND***************************************************************************************************** This macro automatically formats the version string for the text splash screen from the* sys_version equated value.		macro		verNum		lcla	&major,&minor,&proto		lclc	&verString&major		seta	((sys_version AND $7F00) >> 8)&minor		seta	(sys_version AND $00FF)&proto		seta	(sys_version AND $8000)&verString	setc	&concat(&i2s(&major),'.',&i2s(&minor,-2))		if	&proto <> 0 then&verString	setc	&concat(&verString,'p')		endif		dc.b	'&verString'		endm				macro		verDate		dc.b	'&SysDate'		endm ***************************************************************************************************** This macro allows us to define a graphic bitmap as a series of hex bytes.  This is used* for the graphic splash screen icon and text strings.	MACRO	hex		&arg	lclc	&bytes,&hexStr&hexStr	setc	&arg	if	(&len(&hexStr) AND 1) <> 0 then		aerror	'Odd number of bytes in HEX directive'&hexStr		setc	&concat(&hexStr,'0')	; make it even	endif&bytes	setc	&concat('$',&substr(&hexStr,1,2))&hexStr	setc	&substr(&hexStr,3, &len(&hexStr)-2)	while	&len(&hexStr)>0 do&bytes		setc	&concat(&bytes,',$',&substr(&hexStr,1,2))&hexStr		setc	&substr(&hexStr,3, &len(&hexStr)-2)	endwhile	dc.b	&bytes	MEND