		string	asis		pagesize 70		machine	M65816		print	nohdr,nogen		;don't expand macros		print	push		print	off		include	'common.equ.src'		include	'hw.equ.src'		include	'gquit.macros.src'		print	pop		eject**********************************************************************************The file START.GS.OS is organized as follows -** memory location |  memory location    |  equate* where code is   |  where code is      |  for org* executed        |  loaded             |*                 |                     |*  _______________* |               |* | gs/os         |* |  buffers      |* |   start here  |* |               |* ------------------- 9a00* |               |* |     open      |* |               |* -----e0dfff------* |               |* |               |* |    e0.obj     |* |               |* |               |* -----e0d000------                     e0_obj_pstn* -----e1dfff------* |               |* |    e1.obj     |* |               |* -----e1d100------__ 8400              e1_obj_pstn* -----0081ff------* |               |* |    b0.obj     |* |               |* -----008200------__ 8200              b0_obj_pstn* -----0080ff------* |               |* |               |* |   gldr.obj    |* |               |* |               |* -----006800--------6800               gldr_obj_pstn* |               |* |               |* |     open      |* |               |* |               |* -----00????--------????* |               |* |               |* |   boot.obj    |* |               |* |               |* -----002000--------2000               boot_obj_pstn*********************************************************************************		eject**********************************************************************************                         GQuit Revision History***********************************************************************************  Revision history notes prior to System 6.0 release have been purged from this*  file.  If you require them, please refer to a version of this file archived*  prior to System 6.0.***********************************************************************************			     System Disk 6.0*                              8/90 - 7/91*********************************************************************************** 8/07	---- 3.03 Release ---- System Disk 5.0.3** 8/22	G. Branche*	Modified Launch_P8App to support passing a second filename to a P8 Application.*	  This involved changes to launch_p8app, setup_p8, and load_app.** 9/24	G. Branche*	Added second text string to the graphics splash screen displaying the*	  current version number of the system disk.  Also cleaned up the splash*	  screen code a little.** 1/11/91 G.Branche*	Changed system version text string to "System 6.0".*	Added alloc_boot_mem procedure used to allocate the bank 0 memory*	  used by GLoader during booting.** 2/17	G. Branche*	Modified GQuit so that it tries to determine if the GS/OS application*	  being launched supports the desktop interface, as defined by its*	  auxtype.  If it does, GQuit will leave the screen in whatever state*	  it finds it.  If the app does not support the desktop interface,*	  GQuit will force the display of the text screen.*	Moved Init_text_tools to bank $E1 to make some room for the above*	  enhancement in bank $E0.** 03/??	G. Branche*	Added support for Program Launcher code resource.** 05/31	G. Branche*	GLoader now checks the state of the shift key during booting to*	  determine whether or not to load INIT's and DA's.** 06/11	G. Branche*	P8 quit patch modified to use an MVN instruction to move the quit code*	  to $1000 instead of moving the bytes manually.*	P8 quit patch fixed to account for shrinking of original P8 calldisp*	  subroutine.** 07/30	G. Branche*	Quit now displays a non-fatal dialog if InitialLoad2 fails, allowing*	  the user to either return to the launching application, or restarting*	  the system.** 08/02 G. Branche*	When launching a P8 application, GQuit now identifies the file system*	  that the P8 application is residing on.  If the file system is not*	  ProDOS or AppleShare, GQuit displays an informational dialog notifying*	  the user that P8 applications can only be launched from volumes which*	  P8 can recognize (ProDOS or AppleShare).  The user is given the choice*	  of restarting the system or returning to the launching application.** 08/12	G. Branche*	Changed both GLoader and GQuit to support System Loader 4.0 (with both*	  System Loader and ExpressLoad merged).** 08/25	G. Branche*	Cleaned out old System Loader support code that is no longer required*	  with Loader 4.0.*	Changed Loader Entry address from $1A000 to $1A600.*	When P16Quit receives an error within the get_info_sub subroutine, it*	  will display the "Restart/Return" dialog, allowing the user to return*	  to the previous application.  This matches what happens when an*	  error occurs during the InitialLoad of the next application.** 09/06 G. Branche*	Added logic in setup which initialized the AppleTalk Bank $E1 vectors if*	  we're NOT booting over AppleTalk.  This should allow a user to launch*	  the ProDOS file as an application without having the system die when it*	  tries to use one of the (no longer valid) AppleTalk vectors.*	When launch_p16_app received an OutOfMemory error from the loader when*	  loading the Start application (like the Finder), it would display the*	  new dialog giving the user a chance to return to the launching*	  application.  Since there WAS no launching application on the quit*	  stack, GQuit would try to launch the Start application (like the Finder)*	  again.  Again, GQuit would receive an OutOfMemory error, and give the*	  user a chance to return to the launching application. (Can you say*	  "infinite loop"?  I knew you could!)  I changed the code so that instead*	  of simply calling pop_id to retrieve an ID off of the quit stack, it*	  now calls get_next_prog to pop an ID off of the quit stack and, if no*	  ID was available, bring in the Program Launcher.*	Add PurgeAll($A002) call just after executing Tool.Setup.** 09/19	G. Branche*	Added code in setup_p8 which zeros the ProDOS device ID stored at $43*	  in zero page.  P8 uses this value as the boot device ID when it sorts*	  the device list, so it shouldn't be using a garbage value.*	When removing the thermometer heartbeat task, I now clear the SHR*	  linearization bit.** 09/23	G. Branche*	Changed p8_calldisp_patch to account for size change in P8's calldisp*	  routine.*	Changed splash screen code so that it no longer clears the linearization*	  bit when it shuts down the heartbeat task.  It now clears the bit*	  when it initially displays the SHR screen, and then sets it only long*	  enough to update the thermometer bar.** 10/10	G. Branche*	Changed "Extensions Off" bitmap to read "No Inits/DAs"** 10/28 G. Branche*	Altered error message #52 (Unable to launch next application) to add*	  display of error code causing the display of the message.*	Moved "dispose_xxx" routines to bank $E1 code to make room for above*	  change.** 11/13 G. Branche*	Altered application launching sequence to check QuickDraw status before*	  turning off the SHR screen.  If QD says it's active, we leave the*	  screen in whatever state we found it.*	Altered GLoader to use the new global OSPublicFlags variable in bank*	  $E1.  Bit 15 is used to notify the rest of the system when GLoader*	  hasn't loaded any INITs and DAs because the user pressed the shift*	  key during booting.** 12/09 G. Branche*	Fixed "No Inits/DAs" bitmap to remove an extra pixel from the right*	  edge of the second "s".*	Added code in GQuit to clear the fake menu bar displayed on the SHR*	  screen if the launching application is returned to for whatever*	  reason (e.g. launching a non-GS/OS-aware app with a full pathname*	  longer than 64 characters).  This is done by blasting pixel data*	  directly to the SHR video buffer, but only if the SHR screen is*	  currently being displayed.** 12/11	G. Branche*	call_launcher now performs a ResourceStartup call prior to loading the*	  Program Launcher code resource, and a ResourceShutdown call once the*	  launcher returns.** 01/09/92 G. Branche*	New vector defined, at $E100B4, named os_p8_switch.  This is initialized*	  to an RTL by GLoader in the same manner that the normal os_switch vector*	  is set up.  The vector will be called by launch_p16app when GQuit is*	  about to switch from P8 to GS/OS, but _before_ P8 is removed from memory.*	  This will give clients an opportunity to remove themselves from the P8*	  environment before P8 disappears (e.g. EtherTalk).** 01/14/92 G. Branche*	In get_next_prog, I've bracketed the call to Call_Launcher with logic to*	  save the SysPrefs, set them to 0 to prevent the Volume Mount dialog*	  when Standard File can't find the volume associated with the currently*	  set prefix, and then restore them to the original setting after*	  Call_Launcher returns.** 01/18/92 G. Branche*	Changed e1_obj_max to $E1D980 (from $E1DA00) to free up even more room*	  for SCM (to implement fcr renaming).** 02/12/92 G. Branche*	Fixed set_prefixes in GQuit so that an application's pathname is allowed*	  to have a trailing pathname separator.  Previously, this would cause*	  GQuit to overwrite a bank of memory and eventually crash.*********************************************************************************** *** System 6.0.1 ***** 17-Feb-92 Dave Lyons*       Changed splash screen to read "System 6.1 under construction".** 3-Mar-92 Dave Lyons*       Revert to "System 6.0" splash screen for 6.0d78.** 6-Mar-92 Dave Lyons*       Re-revert to "System 6.1 under construction" for 6.1d2.** 26-May-92 Dave Lyons*       Re-re-revert to "System 6.0.1 under construction" for 6.0.1d4.** 4-Jun-92 Dave Lyons*	Redefine os_p8_switch to be called with A=$0000 when leaving P8 (the*	  old way), and $0001 when leaving GS/OS.  (A was already zero in 6.0.)*	Two small optimizations to save 4 bytes & make it still fit.** 20-Oct-92 Dave Lyons*	Fixed "No Inits/DAs" to white out the version area first, so long*	  versions don't stick out the edges.  (Yes, I said I wasn't ever*	  going to fix that, but I did.)** 23-Oct-92 Dave Lyons*       Tried the following change, then commented it out:*	;If UNIT ($43) is still zero, make it something else ($50), because zero*       ;  is dangerous (if fed to ON_LINE, for example, it will return much more*       ;  data than expected).  This should only be zero in the somewhat strange*       ;  case that you network-booted into GS/OS, and then switched to P8 but*       ;  have so many devices online that your boot volume isn't in DEVLST.*	Optimizations to fit in the above change.*	NOTE:  Can save bytes by consolidating 5 NewHandle calls between*	  org_dummy_5 and org_dummy_6.*	Can consolidate two calls to _GetDevNumber1 e1_gdn_parms1 (save 4?).** 18-Feb-93 DAL*	Fixed accidental 16-bit keyboard read in pause mode.** 9-Mar-93 DAL*	Added code to clear the "press any key" message after they hit*	a key.  Took out "In pause mode!!!" before the message.** 1-Apr-93 SS*       Changed splash screen to read "System 6.0.1".*********************************************************************************		eject**********************************************************************************                                                                               **                     GLoader and GQuit equates                                 **                                                                               **               Copyright Apple Computer, Inc. 1986-1993                        **                                                                               **                        All Rights Reserved                                    **                                                                               **********************************************************************************;-------------------------------------------------------------------------------; equates for ORGs;-------------------------------------------------------------------------------boot_obj_pstn	equ	$002000		;boot code executes heregldr_obj_pstn	equ	$006800		;gldr.obj executes heregldr_obj_pad	equ	$008200		;org here to pad gldr.obj to next codeb0_obj_pstn	equ	$008200		;b0.obj executes hereb0_obj_pad	equ	$008400		;org here to pad b0.obj to next codeb0_obj_size	equ	$000200		;size of b0.objb0e1_obj_pstn	equ	$e1d000		;b0.obj lives here until executede0_obj_pstn	equ	$e0d000		;e0.obj executes heree0_obj_max	equ	$e0e000		;e0.obj must not hit this addresse1_obj_pstn	equ	$e1d200		;e1.obj executes heree1_obj_max	equ	$e1d980		;e1.obj must not hit this address;-------------------------------------------------------------------------------; ProDOS 8 equates;-------------------------------------------------------------------------------ProDOS8		equ	$00BF00		; ProDOS 8 entry pointmliactive	equ	$00bf9b		; ProDOS 8's mli active flagPAR		equ	$000040		; ProDOS 8's parameter table pointerp8calldisp_adr	equ	$FEFD		; 2-byte vector to p8calldispp8_compat_byte	equ	$2EFA		; 1-byte compatibility version #p8_compat_value	equ	4		; current compatibility version #p8_file_eof	equ	$42E8		; current size of P8 filep8_max_length	equ	64		; max length of P8 pathname or prefix;-------------------------------------------------------------------------------; ProDOS 8 command numbers;-------------------------------------------------------------------------------p8_gfi_num	equ	$c4		; GetFileInfo command numberp8_setpfx_num	equ	$c6		; SetPrefix command numberp8_open_num	equ	$c8		; Open command numberp8_read_num	equ	$ca		; Read command numberp8_close_num	equ	$cc		; Close command numberp8_eof_num	equ	$d1		; GetEOF command number;-------------------------------------------------------------------------------; miscellaneous equates;-------------------------------------------------------------------------------lang_card_start	equ	$d000		; address of first language card bytelang_card_size 	equ	$1000		; 4k is size of language card bankwork_seg_size	equ	$10000		; 64k bytes in work segment sizezp_size		equ	4096		; Default user zp/stack sizeid_stack_size	equ	64		; Size of the id_stackskip_std_bit	equ	$2000		; 'skip_std' bit in Quit Flags;-------------------------------------------------------------------------------; GLDR's fatal error equates;-------------------------------------------------------------------------------start_fst_err	equ	4init_gsos_err	equ	5load_fst_err	equ	6prefix_0_err	equ	7prefix_2_err	equ	8sys_search_err	equ	9no_sys_file_err	equ	10tool_setup_err	equ	11load_setup_err	equ	12load_da_err	equ	13ts_type_err	equ	17fst_type_err	equ	34boot_drvr_err	equ	36drvr_type_err	equ	37res_mgr_err	equ	38rm_type_err	equ	39express_err	equ	40gsosdev_err	equ	42load_fst_err2	equ	57load_setup_err2	equ	58load_da_err2	equ	59;-------------------------------------------------------------------------------; GQUIT's fatal error equates;-------------------------------------------------------------------------------p8_version_err	equ	14quit_err	equ	15no_p8_err2	equ	18p8_path_err2	equ	56;-------------------------------------------------------------------------------; GQUIT's non-fatal error equates;-------------------------------------------------------------------------------no_p8_err 	equ	20aware_err1	equ	53aware_err2	equ	54p8_path_err	equ	55;-------------------------------------------------------------------------------; file type equates;-------------------------------------------------------------------------------shell_ftype	equ	$b5		; ProDOS 16 shell file typesys_ftype	equ	$ff		; Old '.system' file types16_ftype	equ	$b3		; New '.sys16' file typeperm_ftype	equ	$b6		; Permanent setup file typetemp_ftype	equ	$b7		; Temporary setup file typenda_ftype	equ	$b8		; New Desk Accessory file typecda_ftype	equ	$b9		; Classic Desk Accessory file typedrvr_ftype	equ	$bb		; Driver file typefst_ftype	equ	$bd		; FST file type;-------------------------------------------------------------------------------; aux type equates;-------------------------------------------------------------------------------drvr_atype	equ	$0181		; boot driver aux typegsos_aware	equ	$DB01		; app is "GS/OS aware"gsos_aware_mask	equ	$FF01		; mask for "GS/OS aware" auxtype;-------------------------------------------------------------------------------; memory segment ID equates;-------------------------------------------------------------------------------scm_id_type	equ	$3100		; SCM memory segment ID typegquit_id_type	equ	$3200		; GLoader/GQuit memory segment ID typefst_id_type	equ	$3300		; FST memory segment ID typedrvr_id_type	equ	$3900		; loaded driver memory segment ID typedev_id_type	equ	$3F00		; GS.OS.DEV memory segment ID typeDA_id_type	equ	$5000		; Desk Accessory memory segment ID typesetup_id_type	equ	$A000		; Setup file memory segment ID type;-------------------------------------------------------------------------------; firmware entry point equates;-------------------------------------------------------------------------------eighty_columns	equ	$c300		;enable eighty columnscrout		equ	$fd8e		;output a carriage returncout		equ	$fded		;output the ascii char in A;-------------------------------------------------------------------------------; softswitch equates;-------------------------------------------------------------------------------newvideo	equ	$c029		;bit 7 = super hires disable/enable bite0rdc3rom	equ	$e0c017		;slot 3 status;-------------------------------------------------------------------------------; vector equates;-------------------------------------------------------------------------------tobramsetup	equ	$e10094		;vector to bramsetup routinea_t_vect	equ	$e1103a		;AppleTalk priority vector;-------------------------------------------------------------------------------; memory manager attribute word equates;-------------------------------------------------------------------------------; The following are attributes words used in calls to the memory manager.; The individual bits of the memory manager attributes word mean the following:;; Bit 15     : 1 - segment is locked so purge is impossible.; Bit 14     : 1 - segment is fixed and so cannot be moved.; Bits 10-13 : unused and set to 0.; Bits 8-9   : 0 - not purgable ;                 1 - least purgable.; Bits 5-7   : unused and set to 0.; Bit 4      : 0 - can cross bank boundary ;      1 - can't cross bank boundary.; Bit 3      : 0 - may use special memory ;       1 - may not use special mem; Bit 2      : 0 - page alignment not required ;  1 - page alignment required.; Bit 1      : 0 - segment not at fixed address ; 1 - segment is at fixed address.; Bit 0      : 0 - segment not in a fixed bank ;  1 - segment is in a fixed bank.;-------------------------------------------------------------------------------;boot_attrib and reboot_attrib are different in order to fix a bug where the;installer wouldn't run after a cold boot on a minimum system configuration;due to the loader allocating locked segments below GLoader's 64K buffer.;This problem only occurs after a cold boot.;By having boot_attrib specify bank alignment, the installer runs.;This should be fixed correctly in 4.1 by allocating the loader's segments;before allocating GLoader's 64K buffer.;		Attribute bit positions:;			 Locked;			 |Fixed;			 ||Unused;			 ||||||Purge level;			 ||||||||Unused;			 |||||||||||NoCrossBank;			 ||||||||||||NoSpecialMem;			 |||||||||||||PageAligned;			 ||||||||||||||FixedAddress;			 |||||||||||||||FixedBank;			 ||||||||||||||||;			 vvvvvvvvvvvvvvvvboot_attrib	equ	%1000000000011001	;buffer will be in mid memorymm_attrib	equ	%1100000000010011zp_attrib	equ	%1100000100010101path_attrib	equ	%1100000000011000storage_attrib	equ	%0000000000001000p8copy_attrib	equ	%0000000100001000;-------------------------------------------------------------------------------; shadow register equates;-------------------------------------------------------------------------------; The individual bits of the shadow register are interpreted as follows:;; bit 7 : Must be zero.; bit 6 : 0 enables I/O and language cards ;     1 disables.; bit 5 : 0 enables text page 2 shadowing;       1 disables.; bit 4 : 0 enables aux hi-res page shadowing ;  1 disables.; bit 3 : 0 enables 32K video buffer shadowing ; 1 disables.; bit 2 : 0 enables hi-res page 2 shadowing ;    1 disables.; bit 1 : 0 enables hi-res page 1 shadowing ;    1 disables.; bit 0 : 0 enables text page 1 shadowing ;      1 disables.;-------------------------------------------------------------------------------P16_shadowmask	equ	$1e		; Enable only text for P16 applications.P8_shadowmask	equ	$08		; Enable all shadowing except for sup-hires for P8 apps.text_page_2_bit	equ	$20;-------------------------------------------------------------------------------; GS/OS header equates;-------------------------------------------------------------------------------; The header for all binary files which are to be appended to GS.OS is:;;               dc      i2'xxxx_len'    ;number of bytes to load in;               dc      i4'xxxx_dest'   ;address where the segment goes;               dc      i2'xxxx_flag'   ;flag byte (explained shortly);               dc      c'this code. ver# 0.02' ;any text string (msb on);;               flag=   bit 15   = 0/1 swap in language card bank 0/1;                       bit 14-1 = reserved and must be set to zero;                       bit 0    = 0/1 call system loader to relocate start FST;; The code segment follows this header information.;; The file GS.OS is a combination of header/code segments appended together; into one file.;; Following the last set of header/code segments you must place a $ffff word.; This signifies the end of the table.;-------------------------------------------------------------------------------gs_os_hdr_len	equ	$30		;each header is padded to $30 bytes longhdr_code_len	equ	$00		;offset to code length in headerhdr_code_dest	equ	$02		;offset to code destination in headerhdr_lc_flag	equ	$06		;offset to language card flag in headerhdr_msg		equ	$08		;offset to actual message in header;-------------------------------------------------------------------------------; FST header equates;-------------------------------------------------------------------------------fst_id_offset	equ	12		;offset to FST ID in FST headerfst_name_offset	equ	36		;offset to name string in FST header;-------------------------------------------------------------------------------; FST ID equates;-------------------------------------------------------------------------------appleshare_id	equ	$0d		;AppleShare FST ID;===============================================================================;; System Loader Equates;;===============================================================================Loader_Entry	equ	$01A600		;location of Loader 4.0Loader_TSN	equ	$0011		;System loader's tool set numberSCM_Start	equ	$009A00		;Start of SCM's bank 0 space;-------------------------------------------------------------------------------; Miscellaneous Equates;-------------------------------------------------------------------------------Loader_Mem	equ	$7000		;loader's user ID; Memory Manager Allocation AttributesLocked		equ	%1000000000000000Fixed		equ	%0100000000000000No_Cross_Bank	equ	%0000000000010000No_Special_Mem	equ	%0000000000001000		eject**********************************************************************************                                                                               **                         Imported Addresses                                    **                                                                               **********************************************************************************		IMPORT	add_fst		IMPORT	deallocate		IMPORT	init_scm		IMPORT	restart_system		IMPORT	shutdown_scm		IMPORT	v_ptr1		IMPORT	os_event		IMPORT	set_prefix_33		IMPORT	cache_in_queue		IMPORT	close_all_files**********************************************************************************                                                                               **               Forward Addresses and Entries                                   **                                                                               **********************************************************************************		ENTRY	alloc_err		ENTRY	alloc_gsos_mem		ENTRY	alloc_os_mem		ENTRY	alloc_p8_mem		ENTRY	alloc_storage		ENTRY	alloc_user_zp		ENTRY	alloc_boot_mem		ENTRY	alloc_work_mem		ENTRY	auxtype		ENTRY	b0_reload_msg		ENTRY	big_system		ENTRY	boot_complete		ENTRY	boot_hndl		ENTRY	buf_hndl		ENTRY	buf_ptr		ENTRY	call_fw		ENTRY	check_id_stack		ENTRY	close_parms1		ENTRY	close_ref		ENTRY	colon_2_slash		ENTRY	compare_string		ENTRY	concat		ENTRY	copy_gsos_segs		ENTRY	copy_to_buf		ENTRY	copy_volname		ENTRY	custom_boot		ENTRY	da_type		ENTRY	da_path		ENTRY	dispose_os_mem		ENTRY	dispose_path		ENTRY	dispose_storage		ENTRY	dispose_user_zp		ENTRY	divide		ENTRY	do_fst_stuff		ENTRY	driver_path		ENTRY	e0_end		ENTRY	e1_appleshare		ENTRY	e1_app_filename		ENTRY	e1_app_volname		ENTRY	e1_aux_type		ENTRY	e1_bank0_save		ENTRY	e1_besc		ENTRY	e1_btn1_label		ENTRY	e1_btn2_label		ENTRY	e1_c3_status		ENTRY	e1_close_parms1		ENTRY	e1_close_ref		ENTRY	e1_cons_path		ENTRY	e1_current_id		ENTRY	e1_current_os		ENTRY	e1_dev_address		ENTRY	e1_drvr_address		ENTRY	e1_drvr_id		ENTRY	e1_end		ENTRY	e1_fatal_msg		ENTRY	e1_fst_parms1		ENTRY	e1_fst_ptr		ENTRY	e1_gbv_parms		ENTRY	e1_gdn_dnum		ENTRY	e1_gdn_parms1		ENTRY	e1_gdn_ptr		ENTRY	e1_geof_eof		ENTRY	e1_geof_parms1		ENTRY	e1_geof_ref		ENTRY	e1_getpfx_num		ENTRY	e1_getpfx_parms1		ENTRY	e1_gfi_atype		ENTRY	e1_gfi_eof		ENTRY	e1_gfi_ftype		ENTRY	e1_gfi_parms1		ENTRY	e1_gfi_ptr		ENTRY	e1_gsos_ok		ENTRY	e1_gsos_segs		ENTRY	e1_gsos_segs2		ENTRY	e1_id_stack		ENTRY	e1_id_stack_index		ENTRY	e1_lib_path		ENTRY	e1_load_type		ENTRY	e1_mount_msg		ENTRY	e1_msg_address		ENTRY	e1_mslot		ENTRY	e1_no_storage		ENTRY	e1_null_str		ENTRY	e1_open_id		ENTRY	e1_open_parms1		ENTRY	e1_open_ref		ENTRY	e1_os_mem_id		ENTRY	e1_os_switch		ENTRY	e1_p8_path		ENTRY	e1_p8copy_flag		ENTRY	e1_p8copy_hndl		ENTRY	e1_p8copy_id		ENTRY	e1_p8copy_ptr		ENTRY	e1_p8copy_size		ENTRY	e1_p8quit_path		ENTRY	e1_patch1_adr		ENTRY	e1_patch2_adr		ENTRY	e1_path_hndl		ENTRY	e1_path_id		ENTRY	e1_path_len		ENTRY	e1_path_ptr		ENTRY	e1_prefix_buf		ENTRY	e1_prefix_buf1		ENTRY	e1_quit_flags		ENTRY	e1_quit_prefix		ENTRY	e1_read_count		ENTRY	e1_read_parms1		ENTRY	e1_read_ref		ENTRY	e1_sess_parms1		ENTRY	e1_setpfx0_parms		ENTRY	e1_setpfx2_parms1		ENTRY	e1_setpfx_num		ENTRY	e1_setpfx_parms1		ENTRY	e1_setpfx_ptr		ENTRY	e1_start_flag		ENTRY	e1_start_prog0		ENTRY	e1_start_prog1		ENTRY	e1_storage_id		ENTRY	e1_sys_filename		ENTRY	e1_user_id		ENTRY	e1_volname		ENTRY	e1_volume_id		ENTRY	e1_volume_parms1		ENTRY	e1_volume_ptr		ENTRY	e1_word_temp		ENTRY	e1_zp_size		ENTRY	e1_zp_handle		ENTRY	e1_zp_start		ENTRY	errmsg_path		ENTRY	fatal_fn_err		ENTRY	filename		ENTRY	filename1		ENTRY	filetype		ENTRY	fst_path		ENTRY	find_sys_file		ENTRY	fst_address		ENTRY	gde_auxtype		ENTRY	gde_disp		ENTRY	gde_filetype		ENTRY	gde_parms1		ENTRY	gde_ref		ENTRY	get_info_sub		ENTRY	get_next_prog		ENTRY	got_filename		ENTRY	gotp8		ENTRY	gs_os_credit		ENTRY	gsos_err		ENTRY	gsos_fatal_err		ENTRY	gsos_fatal_err2		ENTRY	gsos_nonfatal		ENTRY	gsos_path		ENTRY	gsosdev_path		ENTRY	heart_active		ENTRY	iload_file		ENTRY	iload_type		ENTRY	init_text_tools		ENTRY	initialize_data		ENTRY	launch_app		ENTRY	launch_p16app		ENTRY	load_adr		ENTRY	load_app		ENTRY	load_app_begin		ENTRY	load_app_end		ENTRY	load_boot_drvr		ENTRY	load_da		ENTRY	load_da_files		ENTRY	load_err_msgs		ENTRY	load_file_adr		ENTRY	load_file_len		ENTRY	load_from_mem		ENTRY	load_fsts		ENTRY	load_gsosdev		ENTRY	load_setup		ENTRY	load_setup_files		ENTRY	load_start_fst		ENTRY	loader_err		ENTRY	loader_install		ENTRY	make_full_path		ENTRY	make_start_paths		ENTRY	mem_size_err		ENTRY	moveblock		ENTRY	msgfile_err		ENTRY	new_time		ENTRY	open_parms1		ENTRY	open_ref		ENTRY	p8_fatal_err		ENTRY	p8_fatal_err2		ENTRY	p8_mount_vol		ENTRY	p8_prefix_err		ENTRY	path_buf		ENTRY	path_len		ENTRY	perm_msg_size		ENTRY	pop_id		ENTRY	pressanykey		ENTRY	print_message		ENTRY	push_id		ENTRY	quit_parms1		ENTRY	read_the_file		ENTRY	relocate_segs		ENTRY	resmgr_name		ENTRY	resmgr_path		ENTRY	restart_heartbeat		ENTRY	s16name		ENTRY	save_filetype		ENTRY	save_mslot		ENTRY	setpfx0_parms1		ENTRY	set_prefixes		ENTRY	setup_P8_begin		ENTRY	setup_P8_end		ENTRY	setup_path		ENTRY	skip_cdas		ENTRY	slash_2_colon		ENTRY	splash_screen		ENTRY	start_app_chk		ENTRY	start_scrn_chk		ENTRY	startfst_name		ENTRY	startfst_path		ENTRY	startpath		ENTRY	stop_scrn_chk		ENTRY	stop_splash		ENTRY	sysname		ENTRY	system_death		ENTRY	temp_setup		ENTRY	text_flag		ENTRY	toolsetup_name		ENTRY	toolsetup_path		ENTRY	unload_file		ENTRY	vol_path		ENTRY	volname_err		entry	draw_ext_off		eject**********************************************************************************                                                                               **                               GLoader                                         **                                                                               **               Copyright Apple Computer, Inc. 1986-1993                        **                                                                               **                        All Rights Reserved                                    **                                                                               *******************************************************************************************************************************************************************		SEG	'seg_gldr'org_dummy_1	proc	org gldr_obj_pstn		endp*********************************************************************************;===============================================================================; setup;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack is set to $01ff on entry.; Stack is set to GQuit's stack on exit.;; Standard entry point is at $6800.  A,X and Y are undefined.;; Entry point for custom boot is at $6803.  Register values should be -;   A - custom boot flags;   X - 0 (currently unused);   Y - 0 (currently unused);===============================================================================setup		PROC		lda	#0		;initialize custom boot flags to 0custom_entry				;entry point for custom boot		sta	|custom_boot	;save custom boot flags		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****; make sure external cx rom is active to fix a bug in the 1.0gs rom; which caused the internal cx rom space to be left mapped in after a; boot failure (ie. boot disk not in drive) on smartport.;let's start with a known memory state.  it should be safe to do this.		lda	#$0c		;enable rom/lcbnk 2/external $cn00 space		sta	statereg;get the boot slot # and save it for later (we have to do this before we put;up any text which will change the value in mslot)		lda	>mslot		sta	>save_mslot;put up the graphics version of the gs/os splash screen if no key was pressed		rep	#$30		;***** begin 16-bit mode *****		lda	|boot_obj_pstn+12 ;get aux type of START.GS.OS		jsr	splash_screen	;to use as boot time value		sep	#$30		;***** begin 8-bit mode *****;determine if graphics screen is up or if we should put up the text screen		stz	|text_flag+1	;clear out hi byte of flag		lda	|heart_active	;get keypress flag from graphics code		sta	|text_flag	;and save		beq	skip_text	;if 0 then graphics screen is up;a key was pressed so the text version of the splash screen should be put up;first check to see if internal slot 3 is enabled;if not, don't put up any text		lda	>e0rdc3rom	;get slot 3 status		and	#$80		;only want bit 7		eor	#$80		;invert the bit		sta	|text_flag	;and save		beq	skip_text	;if 0 then internal slot 3 disabled;put up the text version of the gs/os splash screen		lda	#$a0		;space character		jsr	eighty_columns	;clr scrn + enable 80 cols in basic		ldy	#$00		;display product namegsos_name_loop	lda	gs_os_credit,y		beq	gsos_name_done	;done when a zero is encountered		jsr	cout		;output the character to the screen		iny		bra	gsos_name_loop	;always loop waiting for a zerogsos_name_doneskip_text; now let's set up the shadow register to ensure graphics shadowing; off and text page 1 shadowing on (preserve state of text page 2 shadowing)		lda	shadow		and	#text_page_2_bit		ora	#p16_shadowmask		sta	shadow; disable interrupts so we can initialize tools and the memory manager.; this is done to allow pr# booting to work!!		php			;save interrupt status		sei			;turn off interrupts		asl	|custom_boot+1	;skip this part of the boot process?		bcs	skipit1		;yes		jsl	>initdismgr	;initialize the tools and the memory mgr		jsr	$FE1F		;call ROM ID routine		dey			;ROM00 (better not be)		bmi	skipit1		;they're gonna crash eventually anyway		bne	@ROM03		;if non-zero, must be ROM03 or greater		jsl	$FF1C06		;call ROM to initialize ATalk vectors		bra	skipit1@ROM03		jsl	$FDE594		;call ROM to initialize ATalk vectorsskipit1; disable AppleTalk and SCC		asl	|custom_boot+1	;skip this part of the boot process?		bcs	skipit2		;yes		stz	|$c047		;disable AppleTalk interrupts		stz	|$c041		lda	#$09		;disable SCC		sta	|$c039		lda	#$c0		sta	|$c039		lda	#$0b		;enable oscillator		sta	|$c039		lda	#$d2		sta	|$c039skipit2; restore interrupt state		plp; if the graphics splash screen is up then re-enable the VBL interrupts; since initdismgr turned them off		jsr	restart_heartbeat; now we must initialize the emulation stack save location at $010101 to; $fb, so when rom tool calls are made, the convention of setting the stack; pointer to the value present at $010101 when called from a program using; a native stack, can ensure not trashing the emulation mode stack		lda	#$fb		sta	>alemstkptr; write enable language card bank 0		ldy	lcbank1		ldy	lcbank1; Now let's initialize some global flags		lda	#$01		;indicate that this was a GS/OS boot		sta	>os_boot		lda	#$ff		;indicate that OS is not running yet		sta	>os_kind		asl	|custom_boot+1	;skip this part of the boot process?		bcs	skipit3		;yes		lda	#$6b		;RTL opcode		sta	>os_switch	;initialize os_switch notification list.		sta	>os_p8_switch	;and the P8 switch notification list.skipit3; begin 16-bit native mode		longa	on		longi	on		rep	#$30		;***** begin 16-bit mode *****; indicate to GS/OS, FSTs, drivers, etc. that this is a "cold" start		lda	#$0000		sta	>warm_cold_flag; set the stack to GQuit's stack		lda	#gquit_stack_top		tcs; Now relocate the GQuit code into the $e0 and $e1 language cards.; Note - this code assumes the language card bank 0 is active on entry.; The B0 and E1 code goes to the 1st $d000 bank of the $e1 language card.		ldx	#b0_obj_pstn	;source adr		ldy	#lang_card_start ;dest adr		lda	#e1_end-b0e1_obj_pstn-1	;number of bytes to reloc - 1.		mvn	0, $E10000	;move from bank 0 to bank $E1; The E0 code goes to the 1st $d000 bank of the $e0 language card.		ldx	#b0_obj_pstn+(e1_end-b0e1_obj_pstn) ;source adr		ldy	#lang_card_start ;dest adr		lda	#e0_end-e0_obj_pstn-1 ;number of bytes to reloc - 1.		mvn	0, $E00000	;move from bank 0 to bank $E0; set data bank register back to $00		phk			;the previous MVN instruction set the		plb			;data bank register to $E0; copy boot slot # into GQuit's data area		lda	|save_mslot		sta	>e1_mslot; get a user id to use when allocating reserved memory segments for GS/OS and ProDOS 8		pha			;space for result		pea	gquit_id_type	;GLoader/GQuit use $32xx		_getnewid		pla			;get id		sta	>e1_os_mem_id	;and save for use by GQuit; get a user id to use when allocating space for the Quit pathname		pha			;space for result		pea	gquit_id_type	;GLoader/GQuit use $32xx		_getnewid		pla			;get id		sta	>e1_path_id	;and save for use by GQuit; get a user id to use when allocating space to save GS/OS while ProDOS 8 is running		pha			;space for result		pea	gquit_id_type	;GLoader/GQuit use $32xx		_getnewid		pla			;get id		sta	>e1_storage_id	;and save for use by GQuit; get a user id to use when allocating space to save a copy of P8		pha			;space for result		pea	gquit_id_type	;GLoader/GQuit use $32xx		_getnewid		pla			;get id		sta	>e1_p8copy_id	;and save for use by GQuit; Allocate the bank 0 memory currently being used by GLoader		jsl	alloc_boot_mem		bcs	@oops		;huh???; Allocate GS/OS's reserved memory segments.		jsl	alloc_gsos_mem		bcc	got_gsos_mem@oops 		ldx	#alloc_err	;address of error msg		jmp	system_death	;doesn't returngot_gsos_mem; Now ask for 64k of memory space outside of banks $00/$01 which will be used to; load GS/OS and related files.		jsl	alloc_work_mem		bcc	got_work_mem	;if c=1, error in A		ldx	#mem_size_err	;address of error msg		jmp	system_death	;doesn't returngot_work_mem; fall through into 'main'		eject;===============================================================================; main;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack is set to GQuit's stack on entry and exit.;===============================================================================main		DataChk	Off		longa	on		longi	on; check for a depressed shift key, which means that the user does not wish; to have INIT's and DA's loaded		lda	#0		; assume we're gonna load extensions		sta	>os_public_flags		lda	>$E1C025	; get keyboard modifier flags		lsr	a		; shift key down?		bcc	@load_extensions ; no, go ahead and load the extensions		jsr	draw_ext_off	; draw the skip message		lda	#$8000		sta	>os_public_flags ; set the flag for the rest of the system@load_extensions; Get the name of the boot volume		pea	e1_volname>>16	;pointer to space for volume name		pea	e1_volname		ldx	#6		;offset to GetBootName routine		jsr	(boot_obj_pstn,x) ;get the volume name		bcc	got_volname	;if c=1, error in A		ldx	#volname_err	;address of error msg		jmp	system_death	;doesn't returngot_volname; Get the name of the start fst		pea	startfst_name>>16 ;pointer to space for fst name		pea	startfst_name		ldx	#8		;offset to GetFstName routine		jsr	(boot_obj_pstn,x) ;get the start fst name; Create the pathname of the start fst		pea	1		;indicate class 1 strings		pea	startfst_path>>16 ;Push ptr to string1		pea	startfst_path		pea	startfst_name>>16 ;Push ptr to string2		pea	startfst_name		pea	startfst_path>>16 ;Push ptr to resultant string		pea	startfst_path		jsl	concat; Now look for */SYSTEM/GS.OS and read it into memory		ldx	#gsos_path	;address of partial pathname		ldy	#gsos_path>>16		jsr	read_the_file 	;read in the file		bcc	read_ok		;if c=1, error in A		ldx	#gsos_err	;address of error msg		jmp	system_death	;doesn't returnread_ok		jsr	relocate_segs	;relocate the code segments; Install the system loader		jsl	loader_install		bcc	loader_ok	;if c=1, error in A		ldx	#loader_err	;address of error msg		jmp	system_death	;doesn't returnloader_ok; Load */SYSTEM/ERROR.MSG		ldx	#errmsg_path	;address of partial pathname		ldy	#errmsg_path>>16		jsr	read_the_file 	;read in the file		bcs	msg_file_error		jsr	load_err_msgs	;call the loader		bcc	msgfile_okmsg_file_error		ldx	#msgfile_err	;address of error msg		jmp	system_death	;doesn't returnmsgfile_ok; Make sure our error messages are not suppressed		lda	>sys_prefs	;get preferences flag		and	#$DFFF		;clear bit 13		sta	>sys_prefs; Load and startup */SYSTEM/GS.OS.DEV		ldx	#gsosdev_path 	;address of partial pathname		ldy	#gsosdev_path>>16		jsr	read_the_file 	;read in the file		bcs	gsosdev_error		jsr	load_gsosdev	;call the loader		bcc	gsosdev_ok; We got an error reading in the GS.OS.DEV file or from the loadergsosdev_error		ldx	#gsosdev_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; The GS.OS.DEV file was read in without an errorgsosdev_ok; Read in the start FST file		ldx	#startfst_path 	;address of partial pathname		ldy	#startfst_path>>16		jsr	read_the_file 	;read in the file		bcs	start_fst_error		lda	|filetype	;get the start FST's filetype		cmp	#fst_ftype	;is it an FST file?		bne	fst_type_error	;no - so report an error		lda	|auxtype	;get the start FST's auxtype		bmi	fst_type_error	;it's disabled so report an error		jsr	load_start_fst	;call the loader		bcc	start_fst_ok; We got an error reading in the start FST or from the loaderstart_fst_error		ldx	#start_fst_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; The start FST is disabled or has the wrong file typefst_type_error		ldx	#fst_type_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; The start FST file was read in without an errorstart_fst_ok; Read in the custom boot driver file if requested		asl	|custom_boot	;load a custom boot driver?		bcc	skipit4		;no		ldx	#driver_path	;address of partial pathname		ldy	#driver_path>>16		jsr	read_the_file 	;read in the file		bcs	boot_drvr_error		lda	|filetype	;get the boot driver's filetype		cmp	#drvr_ftype	;is it a driver file?		bne	drvr_type_error	;no - so report an error		lda	|auxtype	;get the boot driver's auxtype		cmp	#drvr_atype	;is it the correct type?		bne	drvr_type_error	;no - so report an error		jsr	load_boot_drvr	;call the loader		bcc	boot_drvr_ok; We got an error reading in the boot driver or from the loaderboot_drvr_error		ldx	#boot_drvr_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; The boot driver has the wrong file type or the wrong aux typedrvr_type_error		ldx	#drvr_type_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; The boot driver file was read in without an errorboot_drvr_ok; Custom boot driver is not requestedskipit4; Free up the 64K buffer used to load in GS/OS and related files		lda	|buf_hndl+2	;handle to mem buffer		pha		lda	|buf_hndl		pha		_disposehandle; Now let's initialize the AppleTalk priority vector		asl	|custom_boot	;skip this part of the boot process?		bcs	skipit5		;yes		lda	#$006b		; an 'RTL' followed by 3 nulls		sta	>a_t_vect		lda	#$0000		sta	>a_t_vect+2skipit5; Do GS/OS initialization sequence here...		_CompactMem		;{gab - 04/03/90}; set direct reg to GS/OS direct page for calls to SCM and device dispatcher		phd			;save direct register		pea	direct_base	;setup GS/OS direct page		pld; initialize SCM		jsl	>init_scm		bcs	init_error; add in the start FST		ldx	|fst_address	;get load address of start.fst		ldy	|fst_address+2 	;x=low word  --  y=high word		jsl	>add_fst	;notify SCM		bcs	init_error; initialize the device dispatcher		_CompactMem		;{gab - 04/03/90}		stz	<drvr_dev_num	;device number = dispatcher		stz	<drvr_call_num	;call number = boot init		lda	>e1_mslot	;get boot slot #		and	#$0007		;mask off bits which must be 0		sta	<boot_slot	;boot slot #		lda	>e1_drvr_address ;load address of custom boot driver if		sta	<drvr_dib_ptr	;one was requested, else nil		lda	>e1_drvr_address+2		sta	<drvr_dib_ptr+2		lda	>e1_drvr_id	;user ID of custom boot driver if one		sta	<boot_user_id	;was requested, else 0		jsl	>dev_dispatcher	;initialize the device dispatcher		bcs	init_error; restore direct register		pld		bra	init_ok; got an error during GS/OS initializationinit_error		ldx	#init_gsos_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; GS/OS was initialized without errorinit_ok; Indicate that GS/OS is now up and running so that the report_fatal routine can; attempt to shutdown GS/OS if a fatal error occurs.		lda	#1		sta	>e1_gsos_ok; Now install the rest of the FSTs in the */SYSTEM/FSTS subdirectory		jsr	load_fsts		bcc	fsts_ok		ldy	|got_filename	;do we have a filename for the error msg?		bne	fst_fn_err	;yes - so put up a special msg		ldx	#load_fst_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no returnfst_fn_err	ldx	#load_fst_err2	;message #		jmp	fatal_fn_err	;fatal error - no returnfsts_ok; This is code to pause the load sequence if a key has been pressed.		lda	|text_flag	;should the text message be put up?		beq	skip_msg	;no		sep	#$30		;***** begin 8-bit mode *****		longi	off		longa	off		lda	kbd		;'-' if key is pressed		bpl	nokeythistime2	;'+' then no key pressed this time		sta	kbdstrb		;clear keypress and wait for another		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		ldy	#$00		;display 'press any key to continue'pressanykeylp		lda	pressanykey,y	;get character		and	#$00ff*** The next line was branching to pressanykeydone in 16-bit mode, 18-Feb-93 DAL		beq	@1		;'0' is terminator		phy			;save Y		ldx	#cout		jsr	call_fw		ply			;restore Y		iny			;next character		bra	pressanykeylp@1		sep	#$30		;***** begin 8-bit mode *****		longi	off		longa	offpressanykeydone		lda	kbd		;to continue with the boot		bpl	pressanykeydone	;loop til key pressed		sta	kbdstrb		;clear keypress and continue with boot*** added 9-Mar-93 DAL -- remove the "press any key" message		lda	#0		sta	$24		;HTAB to 0		sta	$57b		;80-col cursor-horizontal		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		lda	#80@blanks		pha		lda	#$A0		;space		ldx	#cout		jsr	call_fw		pla		dec	a		bne	@blanks*** end 9-Mar-93nokeythistime2		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	onskip_msg; Now set prefix 0 to the boot volume name		_setprefix1 setpfx0_parms1		bcc	pfx0_ok		ldx	#prefix_0_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no returnpfx0_ok; Set the library prefix to '*/SYSTEM/LIBS'		_setprefix1 e1_setpfx2_parms1		bcc	pfx2_ok		ldx	#prefix_2_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no returnpfx2_ok; Set OS_Kind to $01 to indicate that GS/OS is running		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	#$01		sta	>OS_Kind		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on; Now look for '*/SYSTEM/START'		lda	#startpath	;set up parameters for call		sta	>e1_gfi_ptr		lda	#startpath>>16		sta	>e1_gfi_ptr+2		_getfileinfo1 e1_gfi_parms1		bcs	no_start		lda	>e1_gfi_ftype	;check filetype of START file		cmp	#s16_ftype		beq	found_startno_start; No START file in SYSTEM directory was found, so look for 1st; '.system' or '.sys16' file in volume directory		jsr	find_sys_file		bcc	found_sysfile		cmp	#end_of_dir	; end of directory error?		beq	no_sysfile	; yes - so there is no sys file		ldx	#sys_search_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; No .sys16 or .system file was found so report an errorno_sysfile		ldx	#no_sys_file_err ;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; A .sys16 or .system file entry was foundfound_sysfile; A START file was foundfound_start; Now load and execute '*/SYSTEM/SYSTEM.SETUP/TOOL.SETUP'		_CompactMem		;{gab - 04/03/90}		lda	#toolsetup_path	;setup parameters for call		sta	>e1_gfi_ptr		lda	#toolsetup_path>>16		sta	>e1_gfi_ptr+2		_getfileinfo1 e1_gfi_parms1 ; does the file exist?		bcs	ts_file_error	; no - so report an error		lda	>e1_gfi_ftype	; get filetype of TOOL.SETUP		cmp	#perm_ftype	; is it the correct filetype?		bne	bad_ts_type	; no - so report an error		ldx	#toolsetup_path	; X gets lo word of pathname address		ldy	#toolsetup_path>>16 ; Y gets hi word of pathname adrs		jsr	load_setup	; Go load and run the file		bcc	tools_ok	; Branch if successful; The TOOL.SETUP file doesn't exist or we got an error trying to execute itts_file_error		ldx	#tool_setup_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; The TOOL.SETUP file has the wrong file typebad_ts_type		ldx	#ts_type_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; TOOL.SETUP was loaded and executed without errortools_ok		pea	$A000		;purge any leftover Tool.Setup stuff		_PurgeAll; Now load and execute '*/SYSTEM/SYSTEM.SETUP/RESOURCE.MGR'		lda	#resmgr_path	;setup parameters for call		sta	>e1_gfi_ptr		lda	#resmgr_path>>16		sta	>e1_gfi_ptr+2		_getfileinfo1 e1_gfi_parms1 ; does the file exist?		bcs	rm_file_error	; no - so report an error		lda	>e1_gfi_ftype	; get filetype of RESOURCE.MGR		cmp	#perm_ftype	; is it the correct filetype?		bne	bad_rm_type	; no - so report an error		ldx	#resmgr_path	; X gets lo word of pathname address		ldy	#resmgr_path>>16 ; Y gets hi word of pathname adrs		jsr	load_setup	; Go load and run the file		bcc	resmgr_ok	; Branch if successful; The RESOURCE.MGR file doesn't exist or we got an error trying to execute itrm_file_error		ldx	#res_mgr_err 	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; The RESOURCE.MGR file has the wrong file typebad_rm_type		ldx	#rm_type_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no return; RESOURCE.MGR was loaded and executed without errorresmgr_ok; Load and execute any other setup files in */SYSTEM/SYSTEM.SETUP		lda	>os_public_flags ; load INIT's and DA's?		bpl	@load_extensions ; yes...		jsl	>a_t_vect	; init AppleTalk priority queue		bra	nodaerr		; then skip loading of INITs and DAs@load_extensions 		jsl	stop_scrn_chk	; disable screen monitoring		jsr	load_setup_files		bcc	nosetuperr		ldy	|got_filename	;do we have a filename for the error msg?		bne	setup_fn_err	;yes - so put up a special msg		ldx	#load_setup_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no returnsetup_fn_err	ldx	#load_setup_err2 ;message #		jmp	fatal_fn_err	;fatal error - no returnnosetuperr 		jsl	start_scrn_chk	; enable screen monitoring; Now initialize the AppleTalk priority queue		jsl	>a_t_vect; Install all Desk Accessories in the /*/SYSTEM/DESK.ACCS subdirectory		_CompactMem		;{gab - 04/03/90}		jsr	load_da_files		bcc	nodaerr		ldy	|got_filename	;do we have a filename for the error msg?		bne	da_fn_err	;yes - so put up a special msg		ldx	#load_da_err	;message #		jmp	>gsos_fatal_err2 ;fatal error - no returnda_fn_err	ldx	#load_da_err2 	;message #		jmp	fatal_fn_err	;fatal error - no returnnodaerr; Create class 0 and class 1 versions of the start program pathname		jsl	make_start_paths; Enable screen monitoring		jsl	start_app_chk; If the start file is a ProDOS 8 file (filetype $FF) then fill the thermometer; up to the end, stop the splash screen, write out the new auxtype and switch; into text mode before P8 gets loaded.		lda	|save_filetype	;get the filetype of the start file		cmp	#sys_ftype	;is it a ProDOS 8 file?		bne	not_p8		;no		jsl	stop_splash	;yes - so shutdown the splash screennot_p8; Resize the segment allocated for the ERROR.MSG file in order to get rid of the; temporary error messages which are only needed during initial boot.		pea	0		;hi word of new size		lda	|perm_msg_size		pha			;lo word of new size		pha			;space for handle result		pha		lda	>e1_msg_address+2		pha			;starting address of the segment		lda	>e1_msg_address		pha		_FindHandle		;get handle to the segment		_SetHandleSize		;resize the segment; Indicate to GS/OS, FSTs, drivers, etc. that any future startup and; shutdown calls are "warm" (ie - we are switching between operating systems)		lda	#$0001		sta	>warm_cold_flag		_CompactMem		;{gab - 04/03/90}; Free up the memory used by GLoader		lda	|boot_hndl+2	;handle to bank 0 memory		pha		lda	|boot_hndl		pha		_disposehandle; Now do a class 1 Quit call to execute the start program		_quit1	quit_parms1		DataChk	off		ENDP		eject;===============================================================================; system_death;; Entry is in 16-bit native mode.;; Inputs:       A - error # to display;               X - address of error message  (must be in bank $00);; Outputs:      none;; Notes:        This routine does not return.;; Displays an error message and error number using the SysFailMgr tool call.;===============================================================================system_death	PROC		longa	on		longi	on		pha			; Push error number on stack.		pea	$0000		; Assumes bank $00 for location of msg!		phx			; Push address of error message.		_sysfailmgr		; doesn't return		ENDP		eject;===============================================================================; fatal_fn_err;; Entry is in 16-bit native mode.; Data bank register is set to bank $00.;; Inputs:       A - error code;		X - message #;		filename - contains name of file which caused the error (class 1);; Outputs:      none;; Notes:        This routine does not return.;; Generate a fatal error while running under GS/OS.;===============================================================================fatal_fn_err	PROC		longa	on		longi	on		tay			;save error # in Y		lda	#stack_top	;set up correct stack		tcs		phy			;error #		phx			;message #		lda	|filename	;get length word of filename		xba			;swap bytes to convert it to class 0 format		sta	|filename		pea	filename>>16	;push ptr to substitution string		pea	filename+1		jsl	report_fatal	;fatal error - no return		ENDP		eject;===============================================================================; load_err_msgs;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       X - file eof;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;		e1_msg_address - load address of the error messages data;		perm_msg_size - size of permanent section of the file;		e1_patch1_adr - load address of first QuickDraw patch;		e1_patch2_adr - load address of second QuickDraw patch;; Notes:	Two QuickDraw patches have been added to the beginning of the;		error messages file.  This routine saves the load addresses of the;		patches and calculates the load address of the actual start of the;		error messages data.  The patches were put in the error messages file;		because they must be permanently resident in non-special memory and;		must not move.;; This routine calls the system loader's InitialLoad2 routine to load the error; messages file from memory.  The first word of the error messages data contains the size; in bytes of the permanent section of the file.  This value is used by GLoader to; shrink the segment allocated for the file after the temporary messages are; no longer needed.;===============================================================================load_err_msgs	PROC		longa	on		longi	on		lda	#scm_id_type	;segment ID type to use		jsr	load_from_mem	;call the loader		bcs	done		lda	|load_adr	;get load address of first QuickDraw patch		sta	>e1_patch1_adr	;and save		tax		lda	|load_adr+2		sta	>e1_patch1_adr+2		tay		clc		txa			;calculate load address of second QuickDraw patch		adc	#13		sta	>e1_patch2_adr	;and save		tax		tya		adc	#0		sta	>e1_patch2_adr+2		tay		clc		txa			;calculate load address of error messages data		adc	#13		sta	>e1_msg_address	;and save for SCM		sta	<0		tya		adc	#0		sta	>e1_msg_address+2		sta	<2		lda	[<0]		;get size of permanent section of file		sta	|perm_msg_size	;and savedone		rts		ENDP		eject;===============================================================================; load_gsosdev;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       X - file eof;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;		e1_dev_address - load address of the GS.OS.DEV file;; This routine calls the system loader's InitialLoad2 routine to load the; GS.OS.DEV file from memory.  It then does a JSL to the entry address.;===============================================================================load_gsosdev	PROC		longa	on		longi	on		lda	#dev_id_type	;segment ID type to use		jsr	load_from_mem	;call the loader		bcs	done		lda	|load_adr+2	; get hi word of entry address		sta	>e1_dev_address+2 ;save		xba			; swap bytes		sta	|goadr+2	; and store below		lda	|load_adr	; get lo word of entry address		sta	>e1_dev_address ; save		sta	|goadr+1	; and store belowgoadr		jsl	goadr		;*** Modified above to JSL to GS.OS.DEVdone		rts		ENDP		eject;===============================================================================; load_start_fst;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       X - file eof;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;		fst_address - load address of the start FST;; This routine calls the system loader's InitialLoad2 routine to load the start; FST file from memory.  It then checks the FST's ID to see if it is the AppleShare; FST and sets a flag if it is.  If the text splash screen is being put up,; it then prints out the FST's message field.;===============================================================================load_start_fst	PROC		longa	on		longi	on		lda	#fst_id_type	;segment ID type to use		jsr	load_from_mem	;call the loader		bcs	done		lda	|load_adr	;save starting address for later		sta	|fst_address		lda	|load_adr+2		sta	|fst_address+2		jsr	do_fst_stuff	;check fst ID and maybe print comment field		clc			;indicate no errordone		rts		ENDP		eject;===============================================================================; load_boot_drvr;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       X - file eof;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;		e1_drvr_address - load address of the boot driver;		e1_drvr_id - segment ID of boot driver;; This routine calls the system loader's InitialLoad2 routine to load the boot; driver file from memory.;===============================================================================load_boot_drvr	PROC		longa	on		longi	on		lda	#drvr_id_type	;segment ID type to use		jsr	load_from_mem	;call the loader		bcs	done		lda	|load_adr	;save starting address for		sta	>e1_drvr_address ;device dispatcher		lda	|load_adr+2		sta	>e1_drvr_address+2		lda	>e1_user_id	;save user ID for device dispatcher		sta	>e1_drvr_iddone		rts		ENDP		eject;===============================================================================; load_fsts;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is preserved.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       none;; Outputs:      c - 0 if FSTs loaded successfully ; 1 if not;               A - contains error code if c=1;		got_filename - 1 if got a filename for the error msg; 0 if not;; This routine installs all FSTs (except the start FST) in the FSTS subdirectory.; It then checks the FST's ID to see if it is the AppleShare FST.; If this is the initial boot of GS/OS and the text splash screen is being put; up, this routine will print out the comment field of each FST after it's; successfully loaded.;===============================================================================load_fsts	PROC; set direct register to point to GS/OS direct page for calls to SCM		phd			;save direct register		pea	direct_base	;setup gsos direct page		pld; copy '*/SYSTEM/FSTS' into pathname buffer		ldx	#fst_path		jsr	copy_to_buf; open the FSTS directory		_open1	open_parms1		bcc	open_ok		jmp	got_err2open_ok; copy the reference number into the getdirentry and close parameter lists		lda	|open_ref		sta	|gde_ref		sta	|close_ref; append a colon to the end of the directory pathname		ldx	|path_buf	; get length of pathname (class 1)		inx			; add 1 for colon		stx	|path_buf	; and store		stx	|path_len	; and save for later		inx		lda	#':'		; append a colon to end of pathname		sta	|path_buf,x; intialize the directory entry index to 0		stz	|gde_disp; loop through the directory entries and install all valid FSTsnext_entry		inc	|gde_disp	; increment entry index		_getdirentry1 gde_parms1 ;get the next directory entry		bcs	got_err		lda	|gde_auxtype	;get the entry's auxtype		bmi	next_entry	;if hi bit is set, don't load file		lda	|gde_filetype 	;get the entry's filetype		cmp	#fst_ftype	;is it an FST file?		bne	next_entry	;no - so skip it		jsr	make_full_path	;create the full pathname of the file		pea	startfst_name>>16 ; Address of start fst name		pea	startfst_name		pea	filename>>16	; Address of entry's file name.		pea	filename		jsl	compare_string	; Is the filename the start fst name?		bcc	next_entry	; yes - so it was already loaded.		lda	#1		sta	|iload_type	; initial load using class 1 pathname		ldx	#path_buf	; X gets lo word of pathname address.		ldy	#path_buf>>16 	; Y gets high word of pathname address.		lda	#fst_id_type	; segment ID type		jsr	iload_file	; load the FST		bcs	got_fn_err		ldx	|load_adr	;get FST's load address		ldy	|load_adr+2		jsl	>add_fst	;notify SCM		bcc	fst_added_ok		cmp	#0		;got an error - was it non-fatal?		bne	got_fn_err	;no		jsr	unload_file	;yes - so unload the FST		bra	next_entry	;and continuefst_added_ok		jsr	do_fst_stuff	;check fst ID and maybe print comment field		bra	next_entry	;loop until done with all FST's; indicate that we have a filename for the error message then fall thrugot_fn_err	inc	|got_filename; close FSTS directorygot_err		pha			; save error code		_close1	close_parms1	; close the directory		pla			; retrieve error code; if error code is 'end of directory' then don't report the error; otherwise, we got a real error so report itgot_err2		pld			; restore direct register		cmp	#end_of_dir	; end of directory error?		beq	no_err		; yes - so not really an error		sec			; indicate error		rtsno_err		clc			; indicate no error		rts		ENDP		eject;===============================================================================; do_fst_stuff;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is preserved.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       load_adr - starting address of the FST;; Outputs:      none;; Notes:	The direct register is set to point to load_adr which;		contains the starting address of the FST.  This is done so that;		indirect addressing can be used to access the contents of the;		FST header.;; This routine checks the FST's ID to see if it is the AppleShare FST and sets; a flag if it is.; If the text splash screen is being put up, this routine will then print out; the message field of the FST header. The message field is immediately after; the name field in the FST header.  Both fields begin with a length byte.;===============================================================================do_fst_stuff	PROC		longa	on		longi	on		phd			;save direct register		pea	load_adr	;set direct register to load_adr		pld			;so we can use indirect addressing		ldy	#fst_id_offset	;offset to ID field in FST header		lda	[<0],y		;get the FST's ID		cmp	#appleshare_id	;is it AppleShare?		bne	cont		;no		sta	>e1_appleshare	;yes - so set flagcont		lda	|text_flag	;should we put up the fst message?		beq	skip_msg	;no		clc		ldy	#fst_name_offset ;get offset to name string		lda	[<0],y		;get length byte of name string		and	#$00ff		;mask off hi byte		inc	a		;add 1 for length byte of name string		inc	a		;and 1 for length byte of message string		adc	#fst_name_offset ;add name string offset		adc	<0		;add start address of fst		tax			;to create the address of the first		lda	<2		;character of the message		adc	#0		tay		jsr	print_message	;print the messageskip_msg		pld			;restore direct register		rts		ENDP		eject;===============================================================================; load_setup_files;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       none;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;		got_filename - 1 if got a filename for the error msg; 0 if not;; This routine will load and execute all setup files in */SYSTEM/SYSTEM.SETUP; except for the TOOL.SETUP and RESOURCE.MGR files which were already loaded; and executed.;===============================================================================load_setup_files PROC		longa	on		longi	on; first, copy '*/SYSTEM/SYSTEM.SETUP/' into pathname buffer		ldx	#setup_path	; get address of string		jsr	copy_to_buf		lda	|path_buf	; get length of pathname (class 1)		sta	|path_len	; and save for later; initialize the directory entry index to 0		stz	|gde_disp; loop through the directory entries and load and execute all valid setup files;; Note that we must close the directory before we execute each setup file and; then reopen the directory after the file has executed since setup files can; do a CloseAll.open_setup		lda	|path_len	; get length of pathname		dec	a		; subtract 1 for trailing colon		sta	|path_buf	; and store		_open1	open_parms1	; open the directory file.		bcs	bcs_setuperr2		lda	|open_ref	; copy reference number into		sta	|gde_ref	; getdirentry parameter list		sta	|close_ref	; and close parameter listnext_entry		inc	|gde_disp	; increment entry index		_getdirentry1 gde_parms1 ;get the next directory entry		bcs	setuperr		lda	|gde_auxtype	;get the entry's auxtype		bmi	next_entry	;if hi bit is set, don't load file		stz	|temp_setup	;initialize flag for permanent setup file		lda	|gde_filetype	;get the entry's filetype		cmp	#perm_ftype	;is it a permanent setup file?		beq	cont		;yes		cmp	#temp_ftype	;is it a temporary setup file?		bne	next_entry	;no - so skip it		inc	|temp_setup	;indicate that the setup file is temporarycont		jsr	make_full_path	;create full pathname of file		pea	toolsetup_name>>16 ; Address of 'TOOL.SETUP'.		pea	toolsetup_name		pea	filename>>16	; Address of entry's file name.		pea	filename		jsl	compare_string	; Is the filename 'TOOL.SETUP'?		bcc	next_entry	; yes - so it was already loaded.		pea	resmgr_name>>16 ; Address of 'RESOURCE.MGR'.		pea	resmgr_name		pea	filename>>16	; Address of entry's file name.		pea	filename		jsl	compare_string	; Is the filename 'RESOURCE.MGR'?		bcc	next_entry	; yes - so it was already loaded.		_close1	close_parms1	; close the setup directorybcs_setuperr2	bcs	setuperr2		ldx	#path_buf	; X gets lo word of pathname address.		ldy	#path_buf>>16 	; Y gets high word of pathname address.		jsr	load_setup	; Go load and run the setup file.		bcs	got_fn_err		jmp	open_setup	; loop if no error; indicate that we have a filename for the error messagegot_fn_err	inc	|got_filename		rts; close the SYSTEM.SETUP directory and check the error code; if error code is 'end of directory' then don't report the errorsetuperr		pha			; save error code		_close1	close_parms1	; close the setup directory.		pla			; retrieve error code		cmp	#end_of_dir	; end of directory error?		beq	nosetuperr	; yes - so not really an error		sec			; indicate errorsetuperr2	rtsnosetuperr	clc			; indicate no error		rts		ENDP		eject;===============================================================================; load_setup;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is preserved.;; Inputs:       X - low word of pathname address;               Y - high word of pathname address;               temp_setup - 0 if the setup file is permanent;			     <>0 if the setup file is temporary;; Outputs:      c - 0 if no error ; 1 if error;               A - error code if c=1;; This routine will load and execute permanent and temporary setup files.;; The Direct and Stack registers will be set to point to the starting and; ending address respectively of the zero page segment allocated by the system; loader via the InitialLoad call.  If the InitialLoad of the setup file; returns a zero in the zero page starting address parameter, then a zero page; segment will be allocated for the setup file and will be deallocated after; the setup file has executed.;; On entry to the setup program the A register will contain the user ID for; the program, and X and Y will be zeroed.;; A word of 0 will be pushed on the stack just before control is passed to the setup; program.  If a permanent setup program decides that it wants to be shutdown, it; should set the low bit of the word on the stack.  The setup program will then be; shutdown when control returns to load_setup.  Temporary setup files will always; be shutdown after they have executed.;===============================================================================load_setup	PROC		longa	on		longi	on		phd			; save our direct register.		lda	#1		sta	|iload_type	; initial load using class 1 pathname		lda	#setup_id_type	; get proper user ID.		jsr	iload_file	; Go load the file pointed to by X,Y.		bcs	exit		lda	|load_adr+2	; get hi word of entry address		xba			; swap bytes		sta	goadr+2		; and store below		lda	|load_adr	; get lo word of entry address		sta	goadr+1		; and store below		jsl	alloc_user_zp	; set file's direct register		bcs	exit		tsx			; temporarily save our S in X.		tcs			; set file's stack pointer		phx			; Save our S on the file's stack.		phb			; Save our Data Bank reg on file's stack.		lda	>e1_user_id	; Setup program gets his id from A reg.		ldx	#0		; Zero x,y as we would for an application...		txy		phx			; push a flag word of 0 on the stackgoadr		jsl	goadr		;*** Modified above to JSL to setup prog		pla			; retrieve the flag word from the stack		plb			; Restore our data bank register.		plx			; restore our S register.		txs		lsr	a		; does the setup file want to be shutdown?		bcs	shutdown	; yes		lda	temp_setup	; was it a temporary setup file?		beq	cont		; no - so don't do a shutdown callshutdown	jsr	unload_file		bcs	exitcont		jsl	dispose_user_zp	; get rid of file's zero page segmentexit		pld			; restore our direct register		rts			; c holds error condition ; A holds error        code.		ENDP		eject;===============================================================================; load_da_files;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       none;; Outputs:      c - 0 if no error ; 1 if error;               A - error code if c=1;		got_filename - 1 if got a filename for the error msg; 0 if not;; This routine will install both Classic and New Desk Accessories in the; */SYSTEM/DESK.ACCS subdirectory.  If the maximum number of CDAs have been; installed, it will stop installing CDAs but will continue installing NDAs.;===============================================================================load_da_files	PROC		longa	on		longi	on; first, copy the pathname '*/SYSTEM/DESK.ACCS/' into pathname buffer		ldx	#da_path	; get address of string		jsr	copy_to_buf		lda	|path_buf	; get length of pathname (class 1)		sta	|path_len	; and save for later; open the DESK.ACCS subdirectory		_open1	open_parms1	; open the directory file.		bcs	DA_open_err		lda	|open_ref	; copy reference number into		sta	|gde_ref	; getdirentry parameter list		sta	|close_ref	; and close parameter list; initialize the directory entry index to 0		stz	|gde_disp; loop through the directory entries and install all valid DA filesnext_entry		inc	|gde_disp	; increment entry index		_getdirentry1 gde_parms1 ;get the next directory entry		bcs	DAerr		lda	|gde_auxtype	;get the entry's auxtype		bmi	next_entry	;if hi bit is set, don't load file		lda	|gde_filetype 	;get the entry's filetype		cmp	#nda_ftype	;is it a New DA file?		beq	cont		;yes		cmp	#cda_ftype	;is it a Classic DA file?		bne	next_entry	;no - so skip it		ldx	|skip_cdas	;have we installed the max # of CDA's?		bne	next_entry	;yes - so skip this CDAcont		sta	|da_type	;save filetype for later		jsr	make_full_path	;create full pathname of fileloadit		ldx	#path_buf	; X gets lo word of pathname address		ldy	#path_buf>>16 	; Y gets high word of pathname address		jsr	load_da		; go install the desk accessory		bcc	next_entry	; loop if no error		cmp	#$0501		; 'too many CDAs' error?		bne	got_fn_err	; no - so can't continue; We got a 'too many CDAs' error while installing a CDA, so shutdown the CDA; we got the error on and quit installing CDAs but continue installing NDAs.		jsr	unload_file	; shut down the CDA		inc	|skip_cdas	; set flag so no more CDAs will be installed		bra	next_entry; got an error trying to open the DESK.ACCS directory; if error code is 'file not found' then don't report the errorDA_open_err	cmp	#file_not_found	; 'file not found' error?		beq	noDAerr		; yes - so not really an error		rts			; no - so return the error; indicate that we have a filename for the error message then fall thrugot_fn_err	inc	|got_filename; close the DESK.ACCS directory and check the error code; if error code is 'end of directory' then don't report the error; if error code is 'version error' then don't report the error since this is; returned by the GetDirEntry call and means that DESK.ACCS isn't a directoryDAerr		pha			; save error code		_close1	close_parms1	; close the DA directory.		pla			; retrieve error code		cmp	#end_of_dir	; 'end of directory' error?		beq	noDAerr		; yes - so not really an error		cmp	#version_error	; 'not a directory' error?		beq	noDAerr		; yes - so not really an error		sec			; indicate error		rtsnoDAerr		clc			; indicate no error		rts		ENDP		eject;===============================================================================; load_da;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       X - low word of pathname address;               Y - high word of pathname address;               da_type - desk accessory file type;; Outputs:      c - 0 if no error ; 1 if error;               A - error code if c=1;; Notes:        If a handle cannot be found for an installed DA, an;               error code of zero is returned since the memory manager;               FindHandle call does not return an error when no handle;               is found for a given address.;; This routine will load and install the desk accessory file designated by; the pathname pointed to by X and Y.  Da_type contains the filetype of the; desk accessory (ie, New Desk Accessory vs Classic Desk Accessory).;===============================================================================load_da		PROC		longa	on		longi	on		lda	#1		sta	|iload_type	; initial load using class 1 pathname		lda	#DA_id_type	; get proper user ID type.		jsr	iload_file	; Go load the file pointed to by X,Y.		bcs	exit		pha			; Now get the handle to the DA.		pha			; Push space for the handle result.		lda	|load_adr+2	; Push hi word of address of DA.		pha		lda	|load_adr	; Push low word of address of DA.		pha		_findhandle		; Find the handle to the DA just loaded.		lda	1,s		; Make sure the handle is not null		ora	2,s		; indicating no handle to the DA!		bne	foundhandle	; Branch if handle found.		pla			; No handle! Clear stack and return error!		pla			; ** Note that the error code returned is 0!		sec			; Denote error.		rts			; and returnfoundhandle		lda	|da_type	; get the filetype.		cmp	#nda_ftype	; is it a New DA file?		bne	its_cda		; no - it's a Classic DA file.		_installNDA		; Install the New desk accessory.		rts			; and returnits_cda		_installCDA		; Install the Classic desk accessory.		bcc	exit;*** Note - if installCDA gets an error, it returns a random error code.;*** Since the only error it checks for is 'too many DAs' we can stuff the;*** correct error code in A ourselves.		lda	#$0501		; fix the error codeexit		rts		ENDP		eject;===============================================================================; alloc_boot_mem;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is preserved.;; Inputs:       e1_os_mem_id - contains the ID used by GLDR and GQuit when;                              allocating memory segments.;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; Allocate the memory used by GLoader to ensure that nobody else; tries to allocate it during the boot process.; The segment is allocated with a $32xx segment ID.;===============================================================================alloc_boot_mem 	PROC		import	org_dummy_2GLoader_len	equ	gldr_obj_pad-gldr_obj_pstn		longa	on		longi	on		pha			;space for handle result		pha		pea	GLoader_len>>16 ;hi word of seg size		pea	|GLoader_len	;lo word of seg size		lda	>e1_os_mem_id		pha			;segment user id		pea	%0100000000010011 ;seg attributes word (fixed, noCross, fixed address, fixed bank)		pea	$0000		;ask for bank 0		pea	org_dummy_1	;(GLoader's starting address)		_newhandle		plx			;retrieve handle for disposal later		stx	|boot_hndl		plx		stx	|boot_hndl+2		rts			;with C and Acc unchanged from NewHandle call		ENDP		eject;===============================================================================; alloc_work_mem;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is preserved.;; Inputs:       e1_os_mem_id - contains the ID used by GLDR and GQuit when;                              allocating memory segments.;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;               buf_hndl - contains the handle to the allocated segment;               buf_ptr - contains the pointer to the allocated segment;; Allocate a 64K memory segment outside of banks 0 and 1.; The segment is allocated with a $32xx segment ID.;===============================================================================alloc_work_mem 	PROC		longa	on		longi	on		pha			;space for handle result		pha		pea	work_seg_size>>16 ;hi word of seg size		pea	|work_seg_size	;lo word of seg size		lda	>e1_os_mem_id		pha			;segment user id		pea	boot_attrib	;seg attributes word		pea	$0004		;ask for bank 4 {gab - 04/23/90}		pea	$0000		_newhandle		bcs	done		;if c=1, error in A		phd			;save direct register		tsc		tcd			;point direct register at stack		lda	<3		;save handle to the memory segment		sta	|buf_hndl		lda	<5		sta	|buf_hndl+2		lda	[<3]		;dereference handle		sta	|buf_ptr		ldy	#2		lda	[<3],y		sta	|buf_ptr+2		pld			;restore direct register		clc			;indicate no errordone		plx			;pull handle off stack		plx		rts		ENDP		eject;===============================================================================; read_the_file;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       X - low word of address of partial pathname of file to read;		Y - high word of address of partial pathname of file to read;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;		X - lo word of file's EOF;		Y - hi word of file's EOF;		filetype - file's filetype;		auxtype - file's auxtype;; This routine calls the ReadInFile routine in the boot code to read in a file.;===============================================================================read_the_file	PROC		longa	on		longi	on		pha			;8 byte space for results		pha		pha		pha		phy			;ptr to partial pathname (input)		phx		lda	|buf_ptr+2	;pointer to mem buffer		pha		lda	|buf_ptr		pha		ldx	#4		;offset to ReadInFile routine		jsr	(boot_obj_pstn,x) ;Read in the file		plx			;get filetype		stx	|filetype	;and save		plx			;get auxtype		stx	|auxtype	;and save		plx			;get lo word of eof		ply			;get hi word of eof		rts		ENDP		eject;===============================================================================; load_from_mem;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       X - file eof;               A - segment ID type;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;; This routine calls the system loader's InitialLoad2 routine to load a; file from memory.;===============================================================================load_from_mem	PROC		longa	on		longi	on;set up table of address of segment in memory and length for special iload.;note: segment must be less than 64K-48 bytes !!!!!!!!!!!!!!!!!;;special iload info table is as follows;               dc      i4'load_file_address_in_memory';               dc      i2'load_file_length'		pha			;save segment ID type		stx	|load_file_len 	;save for iload		lda	|buf_ptr		sta	|load_file_adr 	;low word of where in memory it is		lda	|buf_ptr+2		sta	|load_file_adr+2 ;high word of where in memory it is; set up registers for special iload call as follows;               y = high word of address to table containing special iload info;               x = low word of address to table containing special iload info		lda	#2		sta	|iload_type	;do initial load from memory		ldy	#load_file_adr>>16 ;hi word of table address		ldx	#load_file_adr 	;lo word of table address		pla			;retrieve segment ID type		jsr	iload_file	;do the initial load		rts		ENDP		eject;===============================================================================; iload_file;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       X - low word of pathname address or table address;               Y - high word of pathname address or table address;               A - segment ID type  (Main field should be zero);; Outputs:      c - 0 if no error ; 1 if error;               A - error code if c=1;               load_adr - 4 byte starting address of the loaded file;               e1_user_id - user ID of the file loaded;               e1_zp_start - starting address of the zero page segment;               e1_zp_size - size in bytes of the zero page segment;; This routine first calls the ID manager for a unique ID given an ID type.; The returned ID is then used in the InitialLoad2 call for the file.; All outputs from the load call are returned in the above named variables.; This routine is intended to load only setup files, DA files, FST files,; and the custom boot driver file so they will NEVER be loaded into special memory!;===============================================================================iload_file	PROC		longa	on		longi	on		phx			; Save pathname or table address		phy		pha			; Push space for result		pha			; segment ID type		_getnewid		; get a unique user ID		bcc	ok		plx			; clean up stack		plx		plx		rts			; Return with c set by call, error in A.ok		pla			; get the new user ID		ply			; Retrieve pathname or table address		plx		pha			; Push 10 bytes for result space		pha		pha		pha		pha		pha			; Push user ID		phy			; Push hi word of pathname or table adrs		phx			; Push lo word of pathname or table adrs		pea	1		; File cannot load into special mem.		lda	|iload_type	; Push load type info		pha		_initialload2		; Load the file		tay			; save error code		pla			; Pull user id		sta	>e1_user_id		pla			; Get low adrs of program entry		sta	|load_adr		pla			; Get hi adrs of entry		sta	|load_adr+2		pla			; Pull zero page buffer address.		sta	>e1_zp_start		pla			; Pull size of buffer.		sta	>e1_zp_size		tya			; restore error code		rts			; Return with c set by call, error in A.		ENDP		eject;===============================================================================; unload_file;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       e1_user_id - User ID to shut down;; Outputs:      A - error code if c=1;               c - 0 if no error, 1 if error;; Calls the system loader's UserShutDown call to unload a file.;===============================================================================unload_file	PROC		longa	on		longi	on		pha			; Stack space for ID result.		lda	>e1_user_id		pha			; Push input ID.		pea	0		; Push input Flags.		_usershutdown		plx			; ignore return ID.		rts		ENDP		eject;===============================================================================; find_sys_file;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       none;; Outputs:      c - 0 if no error ; 1 if        error.;               A - error code if c=1;; This routine will look for the first file in the volume directory that has; filetype $B3 (S16) and whose name ends with '.SYS16' OR that has filetype; $FF (SYS) and whose name ends with '.SYSTEM'.; If '*/SYSTEM/P8' does not exist then it will only look for S16 files.; If a valid file is found, its name is copied into 'e1_sys_filename' as a; class 0 string.;===============================================================================find_sys_file	PROC		DataChk	off		longa	on		longi	on; first, check to see if P8 exists		lda	#e1_p8_path	;set up parameters for call		sta	>e1_gfi_ptr		lda	#e1_p8_path>>16		sta	>e1_gfi_ptr+2		_getfileinfo1 e1_gfi_parms1		bcs	nop8		inc	|gotp8		;indicate that P8 existsnop8; now, copy the pathname '*/' into pathname buffer		ldx	#vol_path	; get address of string		jsr	copy_to_buf; open the volume directory		_open1	open_parms1	; open the volume directory		bcs	start_err2		lda	|open_ref	; copy reference number into		sta	|gde_ref	; getdirentry parameter list		sta	|close_ref	; and close parameter list; initialize the directory entry index to 0		stz	|gde_disp; loop through the directory entries to find the first .system or .sys16 filecheck_entry		inc	|gde_disp	;increment entry index		_getdirentry1 gde_parms1 ;get the next directory entry		bcs	start_err		lda	|gde_filetype 	;get the entry's filetype		ldx	#s16name	;address of string		cmp	#s16_ftype	;is it a .sys16 file?		beq	check_name	;yes		ldx	|gotp8		;does P8 exist?		beq	check_entry	;no - so can't run a SYS file		ldx	#sysname	;address of string		cmp	#sys_ftype	;is it a .system file?		bne	check_entry	;no - so check next entrycheck_name		phx			;push address of string to match		ldy	#0		lda	(1,s),y		;get length of string to match		and	#$00ff		;mask off hi byte		tay		cmp	|filename	;is filename > string to match?		bcs	no_match	;no - so not a start file		ldx	|filename	;get length word of filename		inx			;add 1 for extra length byte		sep	#$30		;***** begin 8-bit mode		longa	off		longi	offname_loop				;compare strings from end		lda	|filename,x	;get character from filename		cmp	#'a'		;convert to upper case		bcc	cvt_done		cmp	#'{'		bcs	cvt_done		sec		sbc	#$20cvt_done		cmp	(1,s),y		;compare to test string		bne	no_match	;found a mismatch		dex		dey		bne	name_loop		rep	#$30		;***** return to 16-bit mode		longa	on		longi	on		pla			;clean up stack		bra	found_it	;the strings matchno_match		rep	#$30		;***** return to 16-bit mode		longa	on		longi	on		pla			;clean up stack		bra	check_entry	;no match so check next entry; got an error searching for a .system or .sys16 filestart_err		pha			; save error code		_close1	close_parms1	; close the directory.		plx			; retrieve error code		bcs	start_err2	; got an error from Close call		sec			; indicate error		txa			; put original error code back in Astart_err2		rts; a .sys16 or .system file entry was found so copy filename into data area; and save the filetypefound_it		ldx	|filename	;get length word of filenamecopy_loop		lda	|filename,x	;copy filename into local data area		sta	>e1_sys_filename,x ;as a class 1 string		dex		bpl	copy_loop		lda	>e1_sys_filename ;get name length word		inc	a		;add 1 for leading colon		ora	#$3A00		;add leading colon & convert to class 0		sta	>e1_sys_filename ;string		lda	|gde_filetype 	;get the filetype again		sta	|save_filetype	;save for later		clc			;indicate no error		rts		DataChk	on		ENDP		eject;===============================================================================; copy_to_buf;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit;; Inputs:       X - contains low word of string address;; Outputs:      path_buf - contains a copy of the string;; This routine copies a string into path_buf.; The string must be class 1 format and must be in bank $00.;===============================================================================copy_to_buf	PROC		longa	on		longi	on		phx			;push string address on stack		ldy	#0		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	off		lda	(1,s),y		;get length of string		tay		iny			;add 1 since it's a class 1 stringloop		lda	(1,s),y		;copy string into path_buf		sta	|path_buf,y		dey		bpl	loop		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		plx			;clean up stack		rts		ENDP		eject;===============================================================================; make_full_path;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit;; Inputs:       path_buf - contains a partial pathname (class 1);               path_len - contains the length word of the partial pathname;               filename - contains a filename (class 1);; Outputs:      path_buf - contains a full pathname (class 1);; This routine creates a full pathname (class 1) by appending the filename; contained in filename onto the partial pathname contained in path_buf.;===============================================================================make_full_path	PROC		longa	on		longi	on		lda	|path_len	;get length of partial path		sta	|path_buf	;and store		pea	1		; indicate class 1 strings		pea	path_buf>>16	; Push ptr to string1		pea	path_buf		pea	filename>>16	; Push ptr to string2		pea	filename		pea	path_buf>>16	; Push ptr to resultant string		pea	path_buf		jsl	concat		; create full pathname		rts		ENDP		eject;===============================================================================; relocate_segs;; Enter:           jsr;; Input:           A = undefined;                  X = undefined;                  Y = undefined;                  P = nvmxdizc;                      ..000...        <- '.' = undefined;               mode = native;                  b = k;             LCBank = undefined;; Output:          A = undefined;                  X = undefined;                  Y = undefined;                  P = nvmxdizc;                      ..000...        <- '.' = undefined;               mode = native;                  b = k;             LCBank = undefined;; Input Stack Parameters:  none;; Output Stack Parameters: none;;; This routine will utilize the header/code segment commands at the beginning; of each file segment to relocate the segments to the correct place.;; The header for all binary files which are to be appended to gs.os is:;;               dc      i2'xxxx_len'    ;number of bytes to load in;               dc      i4'xxxx_dest'   ;address where the segment goes;               dc      i2'xxxx_flag'   ;flag byte (explained shortly);               dc      c'this code. ver# 0.02' ;any text string (msb on);;               flag -  bit 15   = 0/1 swap in language card bank 0/1;                       bit 14-1 = reserved and must be set to zero;                       bit 0    = 0/1 call sys loader to relocate start FST;; The code segment follows this header information.;; Following the last set of header/code segments is a $ffff word.; This signifies the end of the table.;===============================================================================relocate_segs	PROC		longa	on		longi	ongs_os_pointer	equ	1		phd			;save direct register		lda	|buf_ptr+2	;push mem buf pointer on stack		pha		lda	|buf_ptr		pha		tsc		tcd			;set direct register to stack;test if last segment already moved before proceedingmove_loop		ldy	#hdr_code_len	;test for $ffff terminator		lda	[<gs_os_pointer],y		inc	a		;increments to $0000 when done		bne	move_seg1	;<>= then more to move		sep	#$20		;switch to 8 bit mode to hit softswitch		lda	lcbank1		;switch in language card bank 0		lda	lcbank1		;and write enable it		rep	#$20		;back to 16-bit mode		pla			;clean up stack		pla		pld			;restore direct register		rts			;back to caller since we're donemove_seg1		lda	|text_flag	;should we put up the header message?		beq	skip_msg	;no		clc		lda	<gs_os_pointer	;calculate address of message		adc	#hdr_msg		tax		lda	<gs_os_pointer+2		adc	#0		tay		jsr	print_message	;print the messageskip_msg		clc			;prepare to add		lda	#gs_os_hdr_len	;calculate where the code starts		adc	<gs_os_pointer		tax			;save in x til high word is calculated		ldy	<gs_os_pointer+2 ;high word of pointer to gs.os		bcc	move_seg4	;'c'=0 then no carry		iny			;'c'=1 then must add carrymove_seg4		phy			;source address high word for move		phx			;source address low word for move		ldy	#hdr_code_dest+2 ;offset to high word of destination adr		lda	[<gs_os_pointer],y		pha			;destination address high word for move		dey			;get to low word of destination address		dey		lda	[<gs_os_pointer],y		pha			;destination address low word for move		pea	$0000		;high word of count to move always=$0000		ldy	#hdr_code_len	;offset to code length low word		lda	[<gs_os_pointer],y		pha			;code length low word		ldy	#hdr_lc_flag	;offset to language card flag		lda	[<gs_os_pointer],y ;'-' if second language card bank		asl	a		;save status in carry		sep	#$20		;switch to 8 bit mode to hit softswitch		lda	lcbank1		;assume first language card bank		lda	lcbank1		;assume first language card bank		bcc	lcbank_setup	;'c'=0 then we're done with lang card		lda	lcbank2		;code requires second language card bank		lda	lcbank2		;code requires second language card banklcbank_setup		rep	#$20		;back to normal mode		jsr	moveblock	;move the code to correct memory area;now move gs_os_pointer to point to the next segment in memory		clc			;prepare to add		ldy	#hdr_code_len	;add code len+hdr len+ptr for next hdr		lda	[<gs_os_pointer],y ;code length is 1 word in len only!!!		adc	<gs_os_pointer	;low word of pointer		sta	<gs_os_pointer	;save new pointer		bcc	update_ptr_don1		inc	<gs_os_pointer+2 ;add 1 if carry was setupdate_ptr_don1		clc			;prepare to add		lda	<gs_os_pointer	;low word of pointer		adc	#gs_os_hdr_len	;low word of header length (high word=0)		sta	<gs_os_pointer	;save new pointer		bcc	update_ptr_don2		inc	<gs_os_pointer+2 ;add 1 if carry was setupdate_ptr_don2		jmp	move_loop	;loop til terminator is found		ENDP		eject;===============================================================================; print_message;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is preserved.;; Inputs:	X = low word of address of first character of message; 		Y = high word of address of first character of message;; Outputs: 	none;; Prints out a message.; X and Y must contain the address of the first character of the message.; The message must end with a null ($00).;===============================================================================print_message	PROCmsg_ptr		equ	1		longa	on		longi	on;if a key hasn't been pressed don't waste time displaying messages		sep	#$20		;8 bit 'm' to test key		lda	kbd		;'-' if key is pressed		bpl	nokeynomessage	;'+' so skip printing message;a key has been pressed		rep	#$20		;return to 16-bit m		phd			;save direct page on stack		phy			;push address of message on stack		phx		tsc		tcd			;set direct reg to point to stack		ldy	#$0000		;start at first byte to displayloop		lda	[<msg_ptr],y	;pick up a character to display		and	#$00ff		beq	done		;$00 is terminator		ora	#$0080		;set high bit in case someone forgot!!!		phy			;save Y		ldx	#cout		jsr	call_fw		;output the character		ply			;restore Y		iny			;next character please		bra	loop		;fall outdone		ldx	#crout		;always go to next line when done		jsr	call_fw		pla			;clean up stack		pla		pld			;restore direct page;branch here if not printingnokeynomessage		rep	#$20		;return to 16-bit m		rts			;back to caller;------------------------------------------------------------------------------		EXPORT 	call_fwcall_fw		pha			;push space for result		pha		pha		pha		pha			;push A		phx			;push X		phy			;push Y		phx			;address of routine to call		_FWEntry		pla			;ignore results		pla		pla		pla		rts		ENDP		eject;===========================================================================; 'Big Splash' by:;;                Rob Turner;                   and;               Bryan Atsatt;                   and;              Steven E. Glass;;Entry points:;; splash_screen:        input A = total time; restart_heartbeat:    input none; boot_complete:        input none; stop_progress:        input none;;; Change History;; 27 Jul 88      Steven Glass;; No longer changes the border color.  Instead uses the border color as; the background color.;; 11 Nov 88	Rob Turner;;		Added Stop_Splash routine.  GLoader calls this routine if;		it is switching to ProDOS8.;; 30 Nov 88	Rob Turner;;		Fixed linear bit problem when switching to text mode.  Now;		When we switch to text we disable linear mode, then when we;		switch to graphics mode I turn on the linear bit.;; 06 Dec 88	Rob Turner;;		Fixed a bug with the fill routine.  If text mode was enabled;		Then linear bit was wrong;; 23 Sep 90	Greg Branche;		Moved "WelcomeÉ" text up and added second text string;		to display system disk version number.;===========================================================================********************************************************************************* Equates...*		Macro&label		PointAddress &y,&x	;macro generates memory address equate for given point		lcla	&lineBase, &pixOffset&lineBase	seta	&y*$a0		;each line is $A0 bytes&pixOffset	seta	&x/4		;640 mode, 4 pixels per byte&label		equ	$E12000+&lineBase+&pixOffset		EndM		longa	on		longi	onsplash_screen	PROCline		equ	$A0		;number of bytes per scan linedisplay_buffer	equ	$e12000display_buf_end	equ	$e1a000buf_len		equ	display_buf_end-display_buffergraph_chk_loc	PointAddress 58,148	;contains a $00F0graph_chk_val	equ	$00F0scan_control	equ	$e19d00color_palette	equ	$e19e00box_start	PointAddress 57,148icon_start	PointAddress 62,176progress_start	PointAddress 88,292prog_draw_start	PointAddress 89,292border_register	equ	$e1c034pascal_cursor	equ	$E10400		;check for pascal cursorscreen_test	equ	$E007F7		;check for pascal charscreen_char	equ	$E5		;a normal 'e'space		equ	$A0		;a normal ' 'display_switch	equ	$c029graphics_mode	equ	$80linear_mode	equ	$40keyboard	equ	$C000keyboard_strobe	equ	$C010screen_ptr	equ	$00icon_ptr	equ	$04retry_delay	equ	180		;wait three secondstext_Count	equ	25no_screen	equ	'RT'our_special_color equ	$DDDD		; fill to finder desktop pattern.		php			;save m and x bits		phb			;save caller's bank register		phk		plb			;set data bank to our bank please		rep	#$30		stz	armed		;we are not armed yet		cmp	#$0000		;time for this boot		bne	good_time		inc	a		;minimum is one!!!good_time		cmp	#no_screen	;do not display anything		beq	no_show		sta	our_counter	;internal tick counter timer		sta	local_counter		stz	heart_active	;are we running		longa	off		sep	#$20		lda	>keyboard	;should we start?		bpl	do_startup	;we want to runno_show		longa	on		rep	#$20		sta	heart_active		jmp	abortdo_startup		rep	#$20		longa	on		lda	#$0000		sta	new_time		sta	progress_complete ;file has not been updated. (Default)		sta	app_armed		inc	a		sta	task_time	;task timer for heartbeat task		pea	$20E1		;switch data bank to graphics memory and set 8-bit accumulator		plb		plp		longa	off** Set display area to linear mode...*		lda	#linear_mode	;Make sure we are in text/linear mode.		tsb	display_switch		longa	on		rep	#$20** Clear screen to "desktop blue" and init scan-line control bytes and color palettes...*		lda	#our_special_color	;get the color pattern		sta	display_buffer		;and store in first word of display buffer		ldx	#display_buffer AND $FFFF	;move from first byte of display buffer		ldy	#(display_buffer AND $FFFF)+2	;to third byte of display buffer		lda	#buf_len-3		;for entire buffer (filling buffer with color pattern)		phb				;save DBR		mvn	display_buffer,display_buffer		plb				;restore DBR** Set all scan-line control bytes to 640 mode...*		ldx	#$00fe		lda	#$8080scb_loop	sta	scan_control,x		dex		dex		bpl	scb_loop** Fill in color palette...*		ldx	#$000epalette_loop	lda	>palette,x		sta	color_palette,x		sta	color_palette+$10,x		dex		dex		bpl	palette_loop** Turn on graphics display and exit...*		longa	on		rep	#$20		stz	icon_ptr+2	;data for icon and text is ALWAYS in bank 0		lda	#$00E1		;and ALWAYS get's written to bank $E1		sta	screen_ptr+2		jsr	draw_box	;draw the standard white box		jsr	draw_icon	;draw the IIGS Icon		jsr	draw_text	;draw 'Welcome the IIGS'		jsr	draw_progress	;draw the progress bar please 		jsr	graphics_on		jsr	start_heartbeat	;start the draw progressabort		plb			;restore caller's bank and status reg		plp		rts;=============================================================================;start_scrn_chk This routine will start the screen monitor code.;               It will also turn on the graphics display;============================================================================= 		EXPORT	start_scrn_chkstart_scrn_chk		phb			;save data bank register		phk		plb		php		sei		longa	on		longi	on		rep	#$30		lda	app_armed	;have we decided to stop already?		bmi	start_exit		lda	heart_active	;are we running		bne	start_exit		lda	progress_complete ;Have we decided to stop already		bmi	start_exitnot_stopped		longa	on		rep	#$30		jsr	graphics_on	;turn the graphics screen back on		lda	#$FFFF		sta	armed		;yes we are armedstart_exit		plp			;restore interupts		plb		rtl;=============================================================================;stop_splash	stops the splash screen and enables text mode;		only used by GLoader when the start app is P8 based;=============================================================================		EXPORT	stop_splashstop_splash		phb			;save data bank register		phk		plb		php		sei			;stop!!!		longa	on		longi	on		rep	#$30		jsr	boot_complete	;fill up the progress bar & disable interupts		plp			;restore interrupts		plb		rtl;=============================================================================;stop_scrn_chk  stops heartbeat task from checking for a change in the;               screen;;=============================================================================		EXPORT	stop_scrn_chkstop_scrn_chk		phb			;save data bank register		phk		plb		php		sei			;stop!!!		longa	on		longi	on		rep	#$30		lda	heart_active		bne	stop_exit		stz	armed		;turn off check please		jsr	graphics_on	;turn the grphics screen back onstop_exit		plp			;restore interrupts		plb		rtl;=============================================================================;start_app_chk  This routine will start monitoring the application screens;=============================================================================		EXPORT	start_app_chkstart_app_chk		phb		phk		plb		php		sei		rep	#$30		longa	on		longi	on		lda	app_armed	;see if we have already seen a change		bmi	app_exit	;just exit please		lda	heart_active		bne	app_exit		jsl	start_scrn_chk	;turn on graphics display please		lda	#$FFFF		sta	app_armed	;turn on the application flagapp_exit		plp			;restore interupts		plb		rtl;=============================================================================;Code that starts the heartbeat task;=============================================================================		EXPORT	restart_heartbeatrestart_heartbeatstart_heartbeat		php			;save m and x bits		phb			;save caller's bank register		phk		plb			;set data bank to our bank please		rep	#$30		lda	heart_active	;are we running?		bne	not_active		lda	>task_time		sta	>task_counter		lda	#^taskheader	;address of task header		pha		lda	#taskheader		pha		ldx	#$1203		jsl	$E10000		;add a heartbeat task		pea	$0002		;now start the heart beat interupt		ldx	#$2303		jsl	$E10000not_active		plb			;restore caller's bank and status reg		plp		rts;===========================================================================;Heart Beat Task that will manage the progress bar;===========================================================================taskheader		DC.L	00000000	;link to the next tasktask_counter	DC.W	1		;interupt each and every time		DC.B	$5A,$A5		;signature for Ray		php		phk		plb		rep	#$30		;16 bit please		lda	progress_complete		bpl	not_complete	;we have not completed progress		jsr	do_update	;update the file		bcc	halt		;we are done		cmp	#$0007		;OS busy?		beq	exit_task	;we are not done yet.halt		jsr	stop_heartbeat	;finsh up please		stz	task_counter		bra	exit_task	;we are gonenot_complete;;The next two checks mean the following:; IF Application NOT running AND text enabled THEN skip draw;		lda	app_armed	;have we started looking for application?		bmi	@we_are_looking		sep	#$20		;8 bit mode for softswitch		lda	>display_switch		rep	#$20		bpl	exit_task	;skip draw and time change if text is on.@we_are_looking		inc	new_time		jsr	check_screens	;see if we are done??		bcc	no_change_yet		lda	app_armed	;can we shut down yet?		bpl	no_change_yet	;no we cannot shutdownquit_now		jsr	boot_complete		bra	exit_task	;just a labelno_change_yet		dec	local_counter		bne	exit_task		jsr	add_progress		lda	our_counter		sta	local_counterexit_task		lda	task_time	;reset the heartbeat timer		sta	task_counter		plp		rtl** Turn on graphics display and exit...*graphics_on		longa	off		sep	#$20		lda	display_switch		and	#Ålinear_mode	;clear linear bit		ora	#graphics_mode	;turn on the graphics screen again		sta	display_switchsetup_scrn_char		lda	#screen_char		sta	>screen_test		longa	on		rep	#$20		rts;============================================================================;Check_Screen;check screen will determine if we are thru booting the system disk.;To determine if we are thru we monitor both the graphics and text based;screens.  If we detect a change in one of the screens we decide that;we must be thru booting the system.;;============================================================================check_screens		lda	armed		;are we looking for a change?		bpl	chk_graphics	;no we are not looking, But if graphics					;change stop anyway.		lda	>screen_test		and	#$00FF		cmp	#screen_char	;should we switch to text?		beq	chk_graphics	;check the graphics screen		lda	app_armed	;should we check 80 col. init? 		bpl	skip_restore		lda	hack_wait	;wait two seconds please		beq	chk_cursor		dec	hack_wait		bra	chk_graphicschk_cursor		lda	>os_kind	;is P8 running?		and	#$00FF		;(just another hack for switching) 		beq	skip_restore		lda	>pascal_cursor	;check for cursor		and	#$00FF		cmp	#$0020 		bne	skip_restorechk_graphics		lda	>graph_chk_loc	;user now sees something nice		cmp	#graph_chk_val		bne	were_done	;you bet we have booteddont_check		clc		rtswere_done		lda	#$FFFF		;same as Application start		sta	app_armed	;set flag so we will shutdownskip_restore		sec		rts;============================================================================add_progress		pei	screen_ptr+2	;push the high		pei	screen_ptr		lda	display_switch	;save the current mode		pha		ora	#$0040		;set linear mode so the fill works correctly		sep	#$20		sta	display_switch	;turn on the graphics please		rep	#$20		lda	#<prog_draw_start		sta	screen_ptr		lda	#^prog_draw_start		sta	screen_ptr+2no_write		lda	mask_index		ldy	curr_index	;where am I		cpy	#36		;max index		bcc	not_special		cmp	#$0003		;are we done?		bcs	no_way		;we are donenot_special		asl	a		tax		lda	mask_tbl,x		sta	mask		ldx	mask_index		inx		cpx	#$0008		bcc	store_mask		inc	curr_index		inc	curr_index		ldx	#$0000store_mask	stx	mask_index		lda	[screen_ptr],y		and	mask		sta	[screen_ptr],y		jsr	bump_ptr	;next line		lda	[screen_ptr],y		and	mask		sta	[screen_ptr],y		jsr	bump_ptr	;next line		lda	[screen_ptr],y		and	mask		sta	[screen_ptr],y		jsr	bump_ptr	;next line		lda	[screen_ptr],y		and	mask		sta	[screen_ptr],y		bra	exit_pleaseno_wayexit_please		pla		sta	display_switch		pla		sta	screen_ptr		pla		sta	screen_ptr+2		rtsmask_tbl	DC.B	$7F,$FF		DC.B	$4F,$FF		DC.B	$F7,$FF		DC.B	$F4,$FF		DC.B	$FF,$7F		DC.B	$FF,$4F		DC.B	$FF,$F7		DC.B	$FF,$F4;=============================================================================		EXPORT	boot_completeboot_complete		phb		phk		plb		jsr	save_new_time		cmp	#$0007		;OS Busy?		bne	stop_everything		lda	#$8000		sta	progress_complete		lda	#retry_delay	;wait three seconds please		sta	task_time		bra	keep_beatstop_everything		jsr	stop_heartbeatkeep_beat		plb		rts		EXPORT	stop_progressstop_progress		phb		phk		plb		jsr	stop_heartbeat		plb		rtsstop_heartbeat		pea	TaskHeader>>16		pea	TaskHeader		ldx	#$1303		;remove heartbeat task please		jsl	$E10000		rts;=============================================================================save_new_time		jsr	divide		;get the new_time		lda	our_counter		cmp	new_time		beq	skip_update	;do not update diskdo_update		lda	new_time	;is the time zero?		beq	system_screwed		lda	>$e100a8	;is the OS loaded?		and	#$00FF		;clear address.		cmp	#$005C		;look for a Jump long instruction		beq	sys_loadednot_gsosskip_update		lda	#$0000		rtssys_loaded		lda	>$e100bc	;look at the OS kind byte.		and	#$00FF		cmp	#$0001		;is GS/OS running?		bne	not_gsos	;P8 is running so exit please		lda	>dev_start_flag	;see if Ray is starting up still.		beq	@do_set_info	;Ray is not busy!!!		lda	#$0007		;simulate OS Busy please.		sec		rts@do_set_info		jsl	$e100a8		;call GS/OS		DC.W	$2005		;set file info		DC.L	info_listsystem_screwed		rts;=============================================================================draw_box		lda	#<box_start	;start of box		sta	screen_ptr		jsr	draw_white		jsr	draw_black		ldx	#45		;draw 45 middle linesloop1		jsr	draw_middle		dex		bne	loop1		jsr	draw_black		jmp	draw_white;=============================================================================draw_icon		lda	#<icon_start		sta	screen_ptr		lda	#icon		sta	icon_ptr		ldx	#icon_heightoutter_loop1 		ldy	#icon_width-2		jsr	copy_line	;copy the entire line		clc		lda	icon_ptr		adc	#icon_width		sta	icon_ptr		dex		bne	outter_loop1		rts			;we are done;=============================================================================draw_text		lda	#<text1_start		sta	screen_ptr		lda	#text1		sta	icon_ptr		ldx	#text1_heightoutter_loop2		ldy	#text1_width-2 		jsr	copy_line	;move the entire line		clc		lda	icon_ptr		adc	#text1_width		sta	icon_ptr		dex		bne	outter_loop2second_line		lda	#<text2_start		sta	screen_ptr		lda	#text2		sta	icon_ptr		ldx	#text2_height@outter_loop2		ldy	#text2_width-2		jsr	copy_line	;copy bitmap line to screen memory		clc		lda	icon_ptr		adc	#text2_width		sta	icon_ptr		dex		bne	@outter_loop2		rts			;we are done;=============================================================================		entry	draw_ext_offdraw_ext_off		lda	#$00E1		sta	screen_ptr+2*** added 20-Oct-92 DALwhite_out_area	PointAddress 77,250		lda	#<white_out_area		sta	screen_ptr		ldx	#9			;store 9 lines@storeLine	lda	#$ffff		ldy	#56@storeWord	sta	[<screen_ptr],y		dey		dey		bpl	@storeWord		clc		lda	<screen_ptr		adc	#$a0		sta	<screen_ptr		dex		bpl	@storeLine*** end 20-Oct-92		lda	#<ext_off_start		sta	screen_ptr		lda	#ext_off		sta	icon_ptr		stz	icon_ptr+2		ldx	#ext_off_height@loop		ldy	#ext_off_width-2		jsr	copy_line	;copy bitmap line to screen memory		clc		lda	icon_ptr		adc	#ext_off_width		sta	icon_ptr		dex		bne	@loop		rts			;we are done;=============================================================================copy_line	;copies bitmap from array to screen memory@loop		lda	[icon_ptr],y		sta	[screen_ptr],y		dey		beq	@loop		dey		bpl	@loop		;move the entire line		bra	bump_ptr;=============================================================================draw_progress		lda	#<progress_start		sta	screen_ptr		jsr	draw_prog_line	;draw one black line please		ldx	#$0004prog_loop		jsr	draw_prog_end		dex		bne	prog_loop;fall through to draw_prog_line;=============================================================================draw_prog_line		ldy	#35		lda	#$0000		sta	[screen_ptr],y		deyloopA1		sta	[screen_ptr],y		dey		dey		bpl	loopA1		bra	bump_ptr	;move to the next line please;=============================================================================draw_prog_end		lda	[screen_ptr]		and	#$FF0F		sta	[screen_ptr]		ldy	#35		lda	[screen_ptr],y		and	#$F0FF		sta	[screen_ptr],y		bra	bump_ptr	;move to the next line please;=============================================================================draw_white		ldy	#85		;move 86 bytes please		lda	#$FFFF		sta	[screen_ptr],y		deyloopA		sta	[screen_ptr],y		dey		dey		bpl	loopA		bra	bump_ptr	;move to the next line please;=============================================================================draw_black		ldy	#85		;move 86 bytes please		lda	#$0F00		sta	[screen_ptr],y		dey		lda	#$0000loopB		sta	[screen_ptr],y		dey		dey		bne	loopB		lda	#$00F0		sta	[screen_ptr],y		bra	bump_ptr	;move to the next line please;=============================================================================draw_middle		ldy	#85		;move 86 bytes please		lda	#$0FFF		sta	[screen_ptr],y		dey		lda	#$FFFFloopC		sta	[screen_ptr],y		dey		dey		bne	loopC		lda	#$FFF0		sta	[screen_ptr],y;fall through to bump_ptr to move to the next linebump_ptr		clc		lda	screen_ptr		adc	#123+37		;point to the next line please		sta	screen_ptr		rts;=============================================================================total_time	DC.W	00		;time during last bootour_counter	DC.W	5local_counter	DC.W	00curr_index	DC.W	0mask		DC.W	0mask_index	DC.W	0progress_complete DC.W	00task_time	DC.W	00armed		DC.W	00app_armed	DC.W	00text_counter	DC.W	00hack_wait	DC.W	120		;wait two seconds		EXPORT	heart_activeheart_active	DC.W	00info_list	DC.W	04		;thru aux type field		DC.L	gs_os_path		DC.W	$E3		;access		DC.W	$F9		;file type		EXPORT	new_timenew_time		DC.L	00		;real time to bootgs_os_path	DC.W	20		DC.B	'*:system:start.gs.os'palette		dc.w	$0000		; black		dc.w	$0F00		; red		dc.w	$00F0		; green		dc.w	$0FFF		; white		dc.w	$0000		; black		dc.w	$000F		; blue		dc.w	$0FF0		; yellow		dc.w	$0FFF		; whiteicon_height	equ	32icon_width	equ	((28-1)>>1)+1icon		hex	FFFFFFFFFFFFFFFFFFFFFFFFFFFF		hex	FFFFFFFFF030FFFFFFFFFFFFFFFF		hex	FFFFFFFF03FF0FFFFFFFFFFFFFFF		hex	FFFFFFF03FFFF0FFFFFFFFFFFFFF		hex	FFFFFF03FFFFFF0FFFFFFFFFFFFF		hex	FFFFF03FFCFFFFF3030FFFFFFFFF		hex	FFFF03FFFFCFFFF0FFF0FFFFFFFF		hex	FFF03FFCFFFCFF0FFF00FFFFFFFF		hex	FF33FFFFCFFFF0FFF0F0FFFFFFFF		hex	FF00FFFFFCFF0FFF0FF0FFFFFFFF		hex	FF030FFFFFF0FFF0FDF0FFFFFFFF		hex	FF0330FFFF0FFF0FDDF0FFFFFFFF		hex	FFF3330FF0FFF0FDDDF033FFFFFF		hex	FF0F3330F0FF0FDDDDF0FF3FFFFF		hex	FF03F3333C30FDDDDF0FFF3FFFFF		hex	FF033F3330F0FDDDF00FFF3FFFFF		hex	FF0333F330F0FDDF0F0FFFF3FFFF		hex	FF03333F30F0FDF0FF0FFFFF3CFF		hex	FF033333F0F0FF0FFF0F0FFFCCCF		hex	FFF033333F00F0FFF0F0F0FFFCCF		hex	FFFF033333F00FFF0F0F3F0FFFFF		hex	FFFFF033330FFAF0F0FF33F0FFFF		hex	FFFFFF03330F4F0F0F3FFF0FFFFF		hex	FFFFFFF0330FF0F0F3F3F0FFFFFF		hex	FFFFF4FF030F0F0F3F3F0FFFFFFF		hex	FFFF4FFFF0F0F0F3F3F0FFFFFFFF		hex	FF44F44FFF0F0F3F3F0FFFFFFFFF		hex	F4FFFFFFFFF0FFF3F0FFFFFFFFFF		hex	F4FFFFFFFFFC0FFF0FFFFFFFFFFF		hex	FF4F4F4FFFFFC0F0FFFFFFFFFFFF		hex	FFF4F4FFFFFFFF0FFFFFFFFFFFFF		hex	FFFFFFFFFFFFFFFFFFFFFFFFFFFFtext1_start	PointAddress 66,292text1_width	equ	$0025text1_height	equ	$0009text1		hex	FC3FFC3FFFFC0FFFFFFFFFFFFFFFFFFFFFFC3F		hex	FFFFFFFC3FC3FFFFFFFFFC3FC3FFFFFFFFFF		hex	FC3FFC3FFFFF0FFFFFFFFFFFFFFFFFFFFFFC3F		hex	FFFFFFFC3FC3FFFFFFFFFC3FC3FFFFFFFFFF		hex	FC3C3C3F00FF0FF00FF00FC00C0FF00FFFF00F		hex	F00FFFF00FC00FF00FFFFC3FC3FF00FF00FF		hex	FF0C30FC3C3F0FC3C3C3C3C0C0C3C3C3FFFC3F		hex	C3C3FFFC3FC0C3C3C3FFFC3FC3FC3C3C3C3F		hex	FF0000FC3C3F0FC3FFC3C3C3C3C3C3C3FFFC3F		hex	C3C3FFFC3FC3C3C3C3FFFC3FC3FC3FFC3FFF		hex	FF0000FC003F0FC3FFC3C3C3C3C3C003FFFC3F		hex	C3C3FFFC3FC3C3C003FFFC3FC3FC303F00FF		hex	FFC3C3FC3FFF0FC3FFC3C3C3C3C3C3FFFFFC3F		hex	C3C3FFFC3FC3C3C3FFFFFC3FC3FC3C3FFC3F		hex	FFC3C3FC3C3F0FC3C3C3C3C3C3C3C3C3FFFC