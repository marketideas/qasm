FFFFFFFFFFFFFFFFFFC03FFFF00FFFF0FF		HEX	FC3C3FFFFFFFFF0FFFFFFFFFFFFF0FFFFFCF0FFF00FF		HEX	FC3FFC3C3F00FC00FF00F0003FFF003FFF0F0FFFF0FF		HEX	FF00FC3C3C3FFF0FFC3C30C30FFF0F0FFF0F0FFFF0FF		HEX	FFFC3C303F00FF0FFC0030C30FFF0F0FFF0F0FFFF0FF		HEX	FC3C3F0C3FFC3F0C3C3FF0C30FFF0F0FFF0F3FFFF0FF		HEX	FF00FCFC3F00FFC0FF00F0C30FFFC03F0F00FF0F000F		HEX	FFFFFF00FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF		HEX	FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF*** end 1-Apr-93Ext_Off_start	PointAddress 78,320Ext_Off_width	equ	$0017Ext_Off_height	equ	$0008Ext_Off		HEX	CFC3FFFFFFF00FFFFFF0FFFFFFFFFFFC3C00FF		HEX	00FFFFFF		HEX	C3C3FFFFFFFC3FFFFFFFFF0FFFFFFFF0FC3C3C		HEX	3C3FFFFF		HEX	C0C3F00FFFFC3FC00FC0FC00FF00FFC3FC3C3C		HEX	3C3F00FF		HEX	C003C3C3FFFC3FC3C3F0FF0FFC3FFF0FFC3C3C		HEX	3C3C3FFF		HEX	C303C3C3FFFC3FC3C3F0FF0FFF00FC3FFC3C3C		HEX	003F00FF		HEX	C3C3C3C3FFFC3FC3C3F0FF0C3FFC30FFFC3C3C		HEX	3C3FFC3F		HEX	C3F3F00FFFF00FC3C3C03FC0FF00F3FFFC00FC		HEX	3C3F00FF		HEX	FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF		HEX	FFFFFFFF		ENDP********************************************************************************        Name:  divide** Description:  Does 16 bit division. dividend/divisor = dividend w/remainder.**     Created:  June 20, 1988*    Modified:  June 20, 1988*      Author:  Bryan Atsatt  (adapted from '6502 Software Design')**       Entry:  jsr**       Input:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*                   ..000...*               B = K**               new_time                ;16 bit new_time.*               divisor                 ;16 bit divisor.**      Output:  A = undefined*               X = undefined*               Y = undefined*               P = nvmxdizc*                   ..000..0*               B = K**               new_time                ;quotient*               remainder               ;remainder**        Uses:  All registers*               new_time*               divisor*               remainder** Copyright Apple Computer, Inc. 1987-1993  All rights reserved.******************************************************************************divide		PROC** Initialize...*		ldx	#32		;Get bit count.		stz	remainder	;Clear remainder.		stz	remainder+2** Do division and exit...*div_loop	asl	new_time	;Shift new_time & quotient left.		rol	new_time+2		rol	remainder	;Shift partial new_time left.		rol	remainder+2		sec			;Subtract low bytes.		lda	remainder		sbc	divisor		tay			;Save low result.		lda	remainder+2	;Subtract high bytes.		sbc	divisor+2	;Divisor > new_time?		bcc	next_bit	;Yes.		inc	new_time	;No, set bit in quotient.		sty	remainder	;Enter result in partial new_time.		sta	remainder+2next_bit	dex			;Done all bits?		bne	div_loop	;No, so loop.		lda	remainder	;do we need to bump the result?		cmp	#$004A		;the magic value		bcc	no_bump		inc	new_timeno_bump		rts			;Yes, so exit.divisor		DC.L	148remainder	DC.L	00		ENDP		eject;===============================================================================; loader_install;; System Loader install program;===============================================================================loader_install	PROC		longa	on		longi	on;tell Tool Locator where Loader Caller is		pea	0000		;Was push System Tool indicator		pea	Loader_TSN	;Was push Loader Tool number		pea	#^Loader_Entry	;Loader Call Table		pea	#<Loader_Entry		_SetTSPtr		rtl		ENDP		eject;===============================================================================;; gldr_data;;===============================================================================gldr_data	PROC;-------------------------------------------------------------------------------; parameter blocks for GS/OS calls;-------------------------------------------------------------------------------		EXPORT	open_parms1open_parms1				;Open - class 1 parameter list		DC.W	3		;parameter count		EXPORT	open_refopen_ref	DS.B	2		;reference number		EXPORT	open_pathopen_path	DC.L	path_buf	;pointer to pathname		DC.W	1		;read access		EXPORT	close_parms1close_parms1				;Close - class 1 parameter list		DC.W	1		;parameter count		EXPORT	close_refclose_ref	DS.B	2		;reference number		EXPORT	gde_parms1gde_parms1				;GetDirEntry - class 1 parameter list		DC.W	13		;parameter count		EXPORT	gde_refgde_ref		DS.B	2		;reference number		DS.B	2		;flags		DC.W	0		;base		EXPORT	gde_dispgde_disp	DS.B	2		;displacement		DC.L	filename1	;ptr to class 1 output string		DS.B	2		;entry number		EXPORT	gde_filetypegde_filetype	DS.B	2		;file type		DS.B	4		;eof		DS.B	4		;block count		DS.B	8		;create date and time		DS.B	8		;mod date and time		DS.B	2		;access		EXPORT	gde_auxtypegde_auxtype	DS.B	4		;aux type		EXPORT	quit_parms1quit_parms1				;Quit - class 1 parameter list		DC.W	2		;parameter count		DC.L	e1_start_prog1	;ptr to system program pathname		DC.W	0		;don't return, don't restart		EXPORT	setpfx0_parms1setpfx0_parms1				;SetPrefix 0 - class 1 parameter list		DC.W	2		;parameter count		DC.W	0		;set prefix 0/.		DC.L	e1_volname	;points to boot volume name;-------------------------------------------------------------------------------; general storage;-------------------------------------------------------------------------------		EXPORT	save_mslotsave_mslot	DS.B	2		;boot slot #		EXPORT	temp_setuptemp_setup	DS.B	2		;1 = setup file should be shutdown		EXPORT	da_typeda_type		DS.B	2		;desk accessory file type (CDA vs NDA)		EXPORT	gotp8gotp8		DC.W	0		;1 = P8 is on boot disk (init to 0)		EXPORT	custom_bootcustom_boot	DS.B	2		;flags for custom boot		EXPORT	skip_cdasskip_cdas	DC.W	0		;1 = max # of CDAs installed (init to 0)		EXPORT	save_filetypesave_filetype	DS.B	2		;filetype of start application		EXPORT	perm_msg_sizeperm_msg_size	DS.B	2		;size of permanent section of ERROR.MSG file		EXPORT	big_systembig_system	DC.W	0		;1 = system is > 512K (init to 0)		EXPORT	boot_hndlboot_hndl	DS.B	4		;handle to GLoader memory segment		EXPORT	buf_hndlbuf_hndl	DS.B	4		;handle to buffer		EXPORT	buf_ptrbuf_ptr		DS.B	4		;pointer to buffer		EXPORT	save_dsave_d		DS.B	2		;temp to save direct register		EXPORT	text_flagtext_flag	DS.B	2		;0 = don't put up msgs, $FFFF = put up msgs		EXPORT	path_lenpath_len	DS.B	2		;length of partial pathname		EXPORT	iload_typeiload_type	DS.B	2		;type of initial_load to do		EXPORT	load_adrload_adr	DS.B	4		;address of loaded file		EXPORT	filetypefiletype	DS.B	2		;filetype returned by read_the_file		EXPORT	auxtypeauxtype		DS.B	2		;auxtype returned by read_the_file		EXPORT	got_filenamegot_filename	DC.W	0		;1 = got a filename for error msg (init to 0); The following 4 bytes are used for storing the load address of the start FST		EXPORT	fst_addressfst_address	DS.B	4; The following table is used when loading the start FST, ERROR.MSG,; GS.OS.DEV, and BOOT.DRIVER files; load_file_len MUST immediately follow load_file_adr.		EXPORT	load_file_adrload_file_adr DS.B	4		;address of load file		EXPORT	load_file_lenload_file_len DS.B	2		;length of load file; The following 36 bytes are used when making a class 1 GetDirEntry call.; The first 2 bytes contain the buffer size.  The next 34 bytes are used for -; length (2 bytes), filename (32 bytes).		EXPORT	filename1filename1	DC.W	36		;size header for class 1 output string		EXPORT	filenamefilename	DS.B	34		;must follow filename1; The following buffer is used to build pathnames when loading the setup files,; desk accessories and FSTs.  The pathnames are class 1 strings.; Maximum length of a pathname is 54 bytes -;   '*/SYSTEM/SYSTEM.SETUP/' (22 bytes), filename (32 bytes)		EXPORT	path_bufpath_buf	DS.B	56; The following bytes are used for storing the name of the start FST in; class 1 format with no leading or trailing separators.		EXPORT	startfst_namestartfst_name 	DS.B	34		ENDP;===============================================================================;; gldr_strings;;===============================================================================gldr_strings	PROC		msb	on;column indicator 1-40    1234567890123456789212345678931234567894;                41-80    1234567895123456789612345678961234567898		EXPORT	gs_os_creditgs_os_credit	dc.b	$8d		DC.B	'Welcome to the world of GS/OS      v'		verNum			;macro defined at beginning of file		DC.B	'     The Apple IIGS Operating System'		DC.B	$8d,$8d		;terminate with a <cr> and skip a line		DC.B	'Copyright 1983-1993 by Apple Computer, '		DC.B	'Inc.  '		verDate			;macro defined at beginning of file		dc.b	'   All rights reserved.'		DC.B	$8d,$8d,0	;terminate message with a $00		EXPORT	pressanykeypressanykey	DC.B	$8d		;carriage return		DC.B	'-->  Press space bar to continue  <--'		DC.B	0		;terminate message with a $00		msb	off		EXPORT	mem_size_errmem_size_err	str	'RAM disk too large or not enough memory. Error=$'		EXPORT	alloc_erralloc_err	str	'Error allocating memory for GS/OS. Error=$'		EXPORT	volname_errvolname_err	str	'Error reading boot disk name. Error=$'		EXPORT	gsos_errgsos_err	str	'Error loading GS.OS file. Error=$'		EXPORT	loader_errloader_err	str	'Error installing System Loader. Error=$'		EXPORT	msgfile_errmsgfile_err	str	'Error loading ERROR.MSG file. Error=$'		EXPORT	sysnamesysname		str	'.SYSTEM'		EXPORT	s16names16name		str	'.SYS16'		EXPORT	toolsetup_nametoolsetup_name	DC.W	10		;class 1 string		DC.B	'TOOL.SETUP'		EXPORT	resmgr_nameresmgr_name	DC.W	12		;class 1 string		DC.B	'RESOURCE.MGR'		EXPORT	gsos_pathgsos_path	DC.W	12		;class 1 string		DC.B	'SYSTEM:GS.OS'		EXPORT	errmsg_patherrmsg_path	DC.W	16		;class 1 string		DC.B	'SYSTEM:ERROR.MSG'		EXPORT	gsosdev_pathgsosdev_path	DC.W	16		;class 1 string		DC.B	'SYSTEM:GS.OS.DEV'		EXPORT	startfst_pathstartfst_path 	DC.W	12		;class 1 string		DC.B	'SYSTEM:FSTS:'		DS.B	32		;space for start fst name		EXPORT	driver_pathdriver_path	DC.W	26		;class 1 string		DC.B	'SYSTEM:DRIVERS:BOOT.DRIVER'		EXPORT	vol_pathvol_path	DC.W	2		;class 1 string		DC.B	'*:'		EXPORT	fst_pathfst_path	DC.W	13		;class 1 string		DC.B	'*:SYSTEM:FSTS'		EXPORT	setup_pathsetup_path	DC.W	22		;class 1 string		DC.B	'*:SYSTEM:SYSTEM.SETUP:'		EXPORT	toolsetup_pathtoolsetup_path	DC.W	32		;class 1 string		DC.B	'*:SYSTEM:SYSTEM.SETUP:TOOL.SETUP'		EXPORT	resmgr_pathresmgr_path	DC.W	34		;class 1 string		DC.B	'*:SYSTEM:SYSTEM.SETUP:RESOURCE.MGR'		EXPORT	da_pathda_path		DC.W	19		;class 1 string		DC.B	'*:SYSTEM:DESK.ACCS:'		EXPORT	startpathstartpath	DC.W	14		;class 1 string		DC.B	'*:SYSTEM:START'		ENDP*********************************************************************************org_dummy_2	proc	org gldr_obj_pad	;pad to next code segment		endp*********************************************************************************		eject**********************************************************************************                                                                               **                               GQuit - B0 segment                              **                                                                               **                       Copyright Apple Computer, Inc. 1986-1993                **                                                                               **                               All Rights Reserved                             **                                                                               *******************************************************************************************************************************************************************		SEG	'seg_b0'org_dummy_3	proc	org b0_obj_pstn		endp*********************************************************************************		eject;===============================================================================; display_msg;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to $01xx on entry and exit.;; Inputs:       none;; Outputs:      none;; Notes:	must return with an RTL since called from E0 code;; This routine clears the screen and displays the "One moment please..." message.;===============================================================================display_msg 	PROC		longa	on		longi	on		phb			;save data bank reg		phk		plb			;set data bank reg to bank $00		sec		xce			;***** begin emulation mode *****		longa	off		;stack ptr is now set to emulation stack		longi	off		lda	|statereg	;get current state register		pha			;and save		lda	#$0c		;enable rom/lcbnk 2/external $cn00 space		sta	|statereg		lda	|mixclr		;clear mixed mode		lda	|txtset		;switch in text		lda	|txtpage1	;switch in text page 1		lda	|rdc3rom	;save state of slot 3		php		sta	|setintc3rom	;enable 80 column firmware for message		lda	#$80		;disable super hires		trb	|newvideo		lda	#$8d		;carriage return is first character		jsr	eighty_columns	;enable 80 cols/clear screen/reset hooks		ldy	#$00		;pick up length of message to displaymsg_loop		lda	|b0_reload_msg,y ;get byte to display		beq	msg_done	;test if done yet		jsr	cout		;output to screen		iny			;next please		bra	msg_loop	;loop til donemsg_done		plp			;restore 80 column card status		bpl	nochange	;'+' then we were in 80 columns		sta	|setslotc3rom	; else reenable external cardnochange		pla		sta	|statereg	;restore state register		ldy	|lcbank1		ldy	|lcbank1	;write enable lc bank 0		clc		xce			;***** return to native mode *****		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		plb			;restore data bank reg		rtl		ENDP		eject;===============================================================================; copy_gsos_segs;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.; Direct register is preserved.;; Inputs:       none;; Outputs:      none;; Notes:	must return with an RTL since called from E0 code;; This routine loops through the e1_gsos_segs table and copies the GS/OS segments; either to or from the storage areas allocated for them depending on which OS is; currently running.;===============================================================================copy_gsos_segs 	PROC		DataChk	Off		longa	on		longi	on		phd			;save direct register		pha			;allocate space on stack to use		pha			;as direct page		tsc		tcd			;set direct register to stack		ldx	#0		;init table indexloop		stx	|e1_word_temp	  ;save table index		lda	|e1_gsos_segs+8,x ;get handle to storage area		sta	<1		lda	|e1_gsos_segs+10,x		sta	<3		lda	|e1_current_os		bmi	its_p8		lda	|e1_gsos_segs+4,x ;hi word of source address		pha		lda	|e1_gsos_segs+2,x ;lo word of source address		phaits_p8		ldy	#2		lda	[<1],y		  ;hi word of dest/source address		pha		lda	[<1]		  ;lo word of dest/source address		pha		lda	|e1_current_os		beq	its_gsos		lda	|e1_gsos_segs+4,x ;hi word of dest address		pha		lda	|e1_gsos_segs+2,x ;lo word of dest address		phaits_gsos		pea	0		  ;hi word of xfer count		lda	|e1_gsos_segs+6,x ;lo word of xfer count		pha		lda	|e1_gsos_segs,x	;get LC bank		beq	lc_ok		sep	#$30		;go to 8-bit mode to hit soft_switches		lda	lcbank2		;R/W enable lang card bank 2		lda	lcbank2		rep	#$30		;return to 16-bit modelc_ok		jsr	moveblock		sep	#$30		;go to 8-bit mode to hit soft_switches		lda	lcbank1		;R/W enable lang card bank 1		lda	lcbank1		rep	#$30		;return to 16-bit mode		clc		lda	|e1_word_temp	;retrieve table index		adc	#12		tax			;adjust index to point to next table entry		lda	|e1_gsos_segs,x	;at end of table?		bpl	loop		;no		pla			;clean up stack		pla		pld			;restore direct register		rtl		DataChk	On		ENDP		eject;===============================================================================; moveblock;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is preserved.; Direct register is preserved.;; Inputs:       high order word of source pointer;               low order word of source pointer;               high order word of destination pointer;               low order word of destination pointer;               high order word of transfer count;               low order word of transfer count;; Outputs:      none;; Notes:        The high byte of Source, Dest, and Count must be zero.;               The source and destination blocks must not overlap.;               This routine contains self modifying code.;; Moves a block of data from a source location to a destination location.;===============================================================================moveblock	PROC; stack offsetsSource		equ	15		; 4-byte source addressDest		equ	11		; 4-byte destination addressCount		equ	07		; 4-byte transfer countReturnMove	equ	05		; 3-byte return addressTempCount	equ	03		; 2-byte temporary transfer count		longa	on		longi	on		pha			; push two bytes on stack for TempCount		phd			; save D		tsc			; make direct page correspond to stack		tcd; get ready to do the move		phb			; save DBR on stack (MVN trashes it)		lda	<Count		ora	<Count+2		beq	MoveAbort		ldx	<Source		; X = low word of Source		ldy	<Dest		; Y = low word of Dest; set up the self modifying code to contain dst src		lda	<Dest+2		; make sure high byte of Dest is 0		and	#$00ff		sta	<Dest+2		lda	<Source+2	; get source bank		and	#$00ff		; make sure high byte of Source is 0		xba		ora	<Dest+2		; OR in dest bank (high byte must be 0)		sta	>DoMove+1	; put bank values into MVN instruction; decrement Count because it contains actual transfer count whereas; remainder of routine assumes it contains transfer count - 1		lda	<Count		bne	ArA1		dec	<Count+2ArA1		dec	<Count; initialize TempCount		lda	<Count		sta	<TempCount		bra	mdFirst; main move loopmdMore		sta	<Count+2	; more bytes to move		lda	>DoMove+1	; A = SrcDst banks		cpx	#$0001		; bank cross? if X=0		bcs	mdXNot0		adc	#$0100		; add 1 to source bankmdXNot0		cpy	#$0000		; did destination cross bank?		bne	mdYIs0		inc	amdYIs0		sta	>DoMove+1mdFirst		txa			; if count > -X then bank cross		eor	#$ffff		cmp	<TempCount		bcs	mdXOk		sta	<TempCount	; only move -X bytesmdXOk		tya			; will destination cross bank?		eor	#$ffff		cmp	<TempCount		bcs	mdYOk		sta	<TempCount	; only move -Y bytesmdYOk		lda	<TempCount	; get the number of bytes to move; the following 3 bytes are the actual move instruction; this routine dynamically modifies the source and destination banksDoMove		mvn	0,0		; WARNING - BANK VALUES GET CHANGED DYNAMICALLY!!!		lda	<Count		; Count = Count - bytes moved		clc			; actual bytes moved 1 more than count		sbc	<TempCount		sta	<Count		sta	<TempCount		lda	<Count+2		sbc	#$0000		bpl	mdMore; clean up everything before returningMoveAbort		plb			; restore DBR		lda	<ReturnMove	; move return address past parameters		sta	<Source+2		pld			; restore D		tsc			; set S to proper value		clc		adc	#$000e		tcs			;fix up stack		rts		ENDP		eject;===============================================================================;; b0_strings;;===============================================================================b0_strings	PROC		EXPORT	b0_reload_msg		msb	onb0_reload_msg	DC.B	'One moment please...'		DC.B	0		;terminate msg with a $00		msb	off		ENDP*********************************************************************************org_dummy_4	proc	org b0_obj_pad	;pad to next code segment		endp*********************************************************************************		eject**********************************************************************************                                                                               **                               GQuit - E0 segment                              **                                                                               **                       Copyright Apple Computer, Inc. 1986-1993                **                                                                               **                               All Rights Reserved                             **                                                                               *******************************************************************************************************************************************************************		SEG	'seg_e0'org_dummy_5	proc	org e0_obj_pstn		endp*********************************************************************************;==============================================================================; ProDOS 8 QUIT;; Entry is in 8-bit native mode.; Exit is in 16-bit native mode.;; Data bank register is set to bank $00 on entry.; Direct register is set to $000000 on entry.; Stack pointer is set to $01xx on entry.;; Data bank register is set to bank $E1 on exit.; Direct register is set to $000000 on exit.; Stack pointer is set to $01xx on exit.;; This is the entry point for QUIT calls originating from ProDOS 8.;==============================================================================p8quit		PROC		DataChk	off		longa	off		longi	off; First, let's ensure a known machine state.; Shadow I/O space, language cards and text page 1 only.; Preserve state of text page 2 shadowing.; Set normal zero page and stack, page 1, read main memory, write main memory,; read ROM off, language card 1st bank.; Turn off 80STORE.; Setup system to match battery ram parameters except for slot stuff.		lda	>shadow		and	#text_page_2_bit		ora	#p16_shadowmask		sta	>shadow		stz	|statereg		stz	|clr80col		sec		jsl	tobramsetup; Now begin 16-bit mode		rep	#$30		;***** begin 16-bit mode *****		longa	on		longi	on; Increment the system busy flag 		jsl	>incbusyflg; Set the data bank register to bank $E1		pea	$e1e1		plb		plb; Identify the current operating system as ProDOS 8		lda	#$8000		sta	|e1_current_os; Set initial values of variables to zero where needed		jsr	initialize_data; Initialize prefix flag to say that QUIT call specified a full pathname		lda	#$ffff		sta	|e1_quit_prefix; Now let's set the data bank register to bank $00		pea	$0000		plb		plb; Now check the quit type		ldy	#1		lda	(<PAR),y		and	#$00ff		cmp	#$00ee		bne	no_path		;it's not $EE, so there's no pathname; It's an extended quit call, so copy the pathname into e1_p8quit_path		phd			; save direct register		ldy	#2		; Get the pointer to the user's		lda	(<PAR),y	; pathname from his parameter list.		tcd			; and store in direct register		lda	<0		; Get first word of user's pathname.		tax			; save for later		and	#$00ff		; mask off hi byte		cmp	#p8_max_length+1 ; check length byte - is it too long?		bcc	len_ok		; nosyntax_error	lda	#bad_path_syntax ; yes - so report a syntax error		jmp	p8_fatal_err2	; fatal error - no returnlen_ok		txa			; get back first word of pathname		xba			; get first character into low byte		and	#$00ff		; mask off length byte		cmp	#'/'		; does pathname begin with a slash?		beq	full_path	; yes - so it's a full pathname		lda	#0		sta	>e1_quit_prefix	; indicate that pathname was partialfull_path		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	off		ldx	<0		; Get length of pathname in Xpath_loop		lda	<0,x		; Copy user pathname to e1_p8quit_path		sta	>e1_p8quit_path,x		dex		bpl	path_loop		rep	#$30		;***** begin 16-bit mode *****		longa	on		longi	on		pld			;retore direct register		lda	#e1_p8quit_path	;set up pointer to pathname		sta	>e1_path_ptr		lda	#e1_p8quit_path>>16		sta	>e1_path_ptr+2no_path; Now begin 8-bit mode		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	off; Since we're not going back to ProDOS 8, clear the active flag; (This must be done after we have used <PAR but before our first OS call)		stz	|mliactive	; Zero the MLIACTV flag; Clear the ProDOS 8 bit map		ldx	#24		lda	#0loop1		sta	|$BF58,X		dex		bne	loop1		inc	a		sta	|$BF6F		; Mark ProDOS 8 global page in use		lda	#$CF		sta	|$BF58		; and pages 0,1,4,5,6,7; Set the level to zero		txa		sta	|$BF94		; Zero the level; Drop some code into bank $00 for making a P8 Close call; (No need to preserve anything.  We ain't goin back, no mo.)		ldx	#close_end-close_start-1 ;# of bytes to move - 1loop2		lda	>close_start,x		sta	|$200,x		; store the code at $000200		dex		bpl	loop2		jsl	>$000200	; make the call - don't worry about errors; Now get P8's prefix for later use; Drop some code into bank $00 for making a P8 GetPrefix call		ldx	#pfx_end-pfx_start-1 ;# of bytes to move - 1.loop3		lda	>pfx_start,x		sta	|$200,x		; store the code at $000200		dex		bpl	loop3		jsl	>$000200	; make the call		rep	#$30		;***** begin 16-bit mode *****		bne	local_fatal	; fatal error - no return		sep	#$30		;***** begin 8-bit mode *****; Copy ProDOS 8's prefix into GQuit's data area		ldx	|$280		; Get length byte of the prefixcopy_pfx	lda	|$280,x		; Copy the prefix		sta	>e1_prefix_buf,x		dex		bpl	copy_pfx; Now begin 16-bit mode		rep	#$30		;***** begin 16-bit mode *****		longa	on		longi	on; Now let's set the data bank register to bank $E1		pea	$e1e1		plb		plb; Check to see if the Quit call specified a pathname to link to		lda	|e1_p8quit_path		and	#$00ff		beq	no_path2; The Quit call specified a pathname...		lda	|e1_quit_prefix	;did Quit call specify full pathname?		bmi	full_path2	;yes		clc		lda	|e1_prefix_buf	;check length of prefix+pathname		adc	|e1_p8quit_path		and	#$00ff		cmp	#p8_max_length+1 ;is it too long?		bcc	len_ok2		;no		jmp	syntax_error	;yes - so report a syntax errorlen_ok2		pea	0		;indicate class 0 strings		pea	e1_prefix_buf>>16 ;push address of string 1 to concat		pea	e1_prefix_buf		pea	e1_p8quit_path>>16 ;push address of string 2 to concat		pea	e1_p8quit_path		pea	e1_p8quit_path>>16 ;push address of resultant string		pea	e1_p8quit_path		jsl	concat		;concat the stringsfull_path2		clc			;indicate class 0 string		jsr	copy_volname	;copy volname for mount_volume window		jsr	get_info_sub	;get info about the application		bcc	got_next_proglocal_fatal	jmp	p8_fatal_err	;fatal error - no return; The Quit call did not specify a pathname...; Decide on next program to executeno_path2		jsr	get_next_prog		bcs	local_fatal	;fatal error - no return; We now have a program to execute so launch itgot_next_prog		jmp	launch_app;-------------------------------------------------------------------------------; Get Prefix code;; Entry is in 8-bit native mode.; Exit is in 8-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       none;; Outputs:      z - 1 if no error ; 0 if error;               A - error code if z=0;; Notes:        This code is moved to $00/0200 and executed there.;; This is the Bank $00 code used to make the P8 Get Prefix call.;-------------------------------------------------------------------------------pfx_start		DC.B	$38		;sec		DC.B	$FB		;xce - go to emulation mode		DC.B	$20		;jsr ProDOS8 - Call ProDOS 8		DC.W	ProDos8		DC.B	$c7		;Get Prefix command number		DC.W	pfx_parms-pfx_start+$200 ;Address of parameter list		DC.B	$29		;and #$ff		DC.B	$FF		DC.B	$18		;clc - Go back to native mode		DC.B	$FB		;xce - Note: Must use z flag to check error!		DC.B	$6B		;rtlpfx_parms				;parameter list for P8 Get Prefix call		DC.B	1		;number of parameters is 1		DC.W	$280		;pointer to prefix bufferpfx_end;-------------------------------------------------------------------------------; Close code;; Entry is in 8-bit native mode.; Exit is in 8-bit native mode.; Data bank register is set to bank $00 on entry and exit.;; Inputs:       none;; Outputs:      none;; Notes:        This code is moved to $00/0200 and executed there.;; This is the Bank $00 code used to make the P8 Close call.;-------------------------------------------------------------------------------close_start		DC.B	$38		;sec		DC.B	$FB		;xce - go into emulation mode		DC.B	$20		;jsr ProDOS8 - Call ProDOS 8		DC.W	ProDos8		DC.B	$CC		;Close command number		DC.W	close_parms-close_start+$200 ;address of parm list		DC.B	$08		;php		DC.B	$18		;clc		DC.B	$FB		;xce - go back to native mode		DC.B	$28		;plp		DC.B	$6B		;rtlclose_parms				;parameter list for P8 Close call		DC.B	1		;number of parameters is 1		DC.B	0		;ref numclose_end		DataChk	on		ENDP		eject;==============================================================================; ProDOS 16 QUIT;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.;; Data bank register is unknown at entry.; Direct register is set to the GS/OS direct page at $00BD00 on entry.; Stack pointer is set to the application's stack on entry. ??;; Data bank register is set to bank $E1 on exit.; Direct register is set to the GS/OS direct page at $00BD00 on exit.; Stack pointer is set to GQuit's stack on exit.;; Inputs:       Y - call class * 2;               X - prefix #, if quit call specified a partial pathname;                   $FFFF, if quit call did not specify a partial pathname;               <param_blk_ptr - pointer to the Quit call parameter block;               <path_flag - bit 14 is set if a pathname was specified;               <path1_ptr - pointer to the Quit pathname in class 1 format;                            (partial pathnames are expanded by SCM);               >v_ptr1 - SCM's virtual pointer to the pathname;; This is the entry point for QUIT calls originating from GS/OS.;==============================================================================		EXPORT	p16quitp16quit		PROC		DataChk	off		Import	gsos_nonfatal2		longa	on		longi	on; First, let's save the call class and the prefix info for later.		tya			;Y contains call class * 2		sta	>e1_word_temp		txa			;X contains the prefix # (if quit call		sta	>e1_quit_prefix	;specified a partial pathname); Now, let's ensure a known machine state.; Shadow I/O space, language cards and text page 1 only.; Preserve state of text page 2 shadowing.; Set normal zero page and stack, page 1, read main memory, write main memory,; read ROM off, language card 1st bank.; Turn off 80STORE.		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	>shadow		and	#text_page_2_bit		ora	#p16_shadowmask		sta	>shadow		lda	#$00		sta	>statereg		sta	>clr80col		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****; Now, let's set the stack to GQuit's own stack.; But before we do, we must check what the stack is currently set to.; If it's Page 1 we must set $010100 to the value in S.		tsc			; get current stack		and	#$FF00		; look at high byte		cmp	#$0100		; is it 1?		bne	set_new_stack	; no, so never mind		tsc			; get it again		sep	#$30		; go into 8 bit mode		sta	>mnemstkptr	; store it		rep	#$30		; back to 16 bit modeset_new_stack	lda	#gquit_stack_top ; set stack to GQuit's own stack		tcs; Set the data bank register to bank $E1.		pea	$e1e1		plb		plb; Identify the current operating system as GS/OS		stz	|e1_current_os; Set initial values of variables to zero where needed		jsr	initialize_data; Tell SCM to automatically put up the 'mount volume' dialog; and make sure our error messages are not suppressed		lda	>sys_prefs	;get preferences flag		ora	#$8000		;set bit 15 - mount volume bit		and	#$DFFF		;clear bit 13 - error messages bit		sta	>sys_prefs; Get the 'flags' word from the Quit parameter block and store for future use.; If the Quit call was a Class 1 call, we have to check the 'parameter count'; first to see if the 'flags' word was specified.		ldy	|e1_word_temp	;retrieve call class * 2		beq	get_flags	;class 0 so we know there is a flag word		lda	[<param_blk_ptr] ;class 1 so check parameter count		cmp	#2		;does parameter block contain flag word?		bcc	no_params	;no, so skip next sectionget_flags;		tya;		clc;		adc	#$0004		;create offset to flags word;		tay*** optimized 4-Jun-92 DAL to save 2 bytes (now I just need two more)		iny		iny		iny		iny*** end 4-Jun-92		lda	[<param_blk_ptr],y ;get flags word		sta	|e1_quit_flags	;and saveno_params; Is the pathname pointer null or the pathname length zero?		bit	<path_flag	; bit 14 is set if pathname1 is non-null		bvc	no_path		; pathname pointer is null so no path		lda	[<path1_ptr]	; get length word of pathname1		beq	null_path	; pathname length is 0; The Quit call specified a pathname...; Call the memory manager to allocate space to make a copy of the pathname; since SCM's copy isn't locked down and will move if memory is compacted.		jsr	copy_pathname	;copy pathname into our own data area		bcs	local_fatal; Now notify SCM that we're done with its copy of the pathname so it can; deallocate the data area.; The direct register must be set to the GS/OS direct page for the call to SCM		lda	>v_ptr1		;get pathname's virtual ptr from SCM		tax		lda	>v_ptr1+2		tay		jsl	>deallocate	;notify SCM to deallocate space; Since we're not going back to GS/OS, clear the active flag; (we must do this after we have copied the pathname but before our first;  OS call)		lda	>os_flag	; Clear bit 15 (GS/OS Active Flag)		asl	a		lsr	a		sta	>os_flag; SCM always gives us a full pathname so now copy the volume name from the; front of the pathname into a separate string which will be used for the; 'mount volume' window.		sec			;indicate class 1 string		jsr	copy_volname	;copy volname for mount_volume window; Call the loader and the OS to get information about the application.		jsr	get_info_sub	;get info about application		bcc	got_next_prog	;no errors		jsr	gsos_nonfatal2	;display dialog		lda	|e1_quit_flags	;is current app putting it's ID on the stack?		bpl	no_path		;no, so just ignore the supplied pathname		asl	a		;clear the PushID bit		lsr	a		sta	|e1_quit_flags	;and put back		lda	|e1_Current_id	;get the ID of the current app		sta	e1_open_id	;and store as ID of next program to launch		lda	#$B3		;must be application type		sta	e1_load_type		jmp	got_next_prog	;fake it	; The Quit call specified a pathname of length 0...null_path; Notify SCM that we're done with its copy of the pathname so it can; deallocate the data area.; The direct register must be set to the GS/OS direct page for the call to SCM		lda	>v_ptr1		;get pathname's virtual ptr from SCM		tax		lda	>v_ptr1+2		tay		jsl	>deallocate	;notify SCM to deallocate space;fall thru to no_path; The Quit call did not specify a pathname...no_path; Since we're not going back to GS/OS, clear the active flag; (this must be done before our first OS call)		lda	>os_flag	; Clear bit 15 (GS/OS Active Flag)		asl	a		lsr	a		sta	>os_flag; Check the quit flags		lda	|e1_quit_flags	; Is he trying to be put on the stack		bpl	flags_ok	; without a path to go to?; If we reach this point, the user did a QUIT with no pathname but with the high; bit of the flag word set.  This is not allowed.  But, since it serves no; purpose to halt the system with a system death message, we now will clear; both currently used flag bits and continue execution.; This means that the program that gave us this incorrect QUIT call will NOT be; restartable from memory and will NOT be put on the program return stack.		and	#$3fff		; Mask off stack and restart flags.		sta	|e1_quit_flags	; and leave the rest alone.flags_ok; Decide on the next program to execute.		jsr	get_next_prog		bcc	got_next_proglocal_fatal	jmp	gsos_fatal_err	;fatal error - no return; We now have a program to execute...got_next_prog; Check if this is the very first call to GQuit.; e1_current_id will have a non-zero value except on the very first call.		lda	|e1_Current_id		beq	close_files; Determine if we need to push this id on the stack		lda	|e1_quit_flags	; Get the Quit call's 'flags' word		bpl	no_push_id	; Skip if no return attribute		jsr	push_id		; Push the id onto ID stack		bcs	local_fatal	; fatal error - no returnno_push_id; Call the loader to shutdown the current application.		pha			; Stack space for ID result.		lda	|e1_Current_id	; ID of program being shutdown		pha		lda	|e1_quit_flags	; Tells loader how to shutdown		and	#%1100000000000000	; Mask bits that the loader doesn't use.		pha		_usershutdown		; Call Loader.		plx			; Discard return ID.		bcs	local_fatal; Check if GQuit allocated the current app's ZP and dispose it if we did		jsl	dispose_user_zp		bcs	local_fatal; Close all open application files by setting the level to zero and doing a CLOSE all.; (Ignore errors on these calls.)close_files		_setlevel parms		_close	parms; Launch the application		jmp	launch_app;-------------------------------------------------------------------------------; parms;; Parameter table for SetLevel and Close calls;-------------------------------------------------------------------------------parms		DC.B	$00,$00;-------------------------------------------------------------------------------; copy_pathname;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.; Direct register is set to GS/OS direct page on entry and exit.;; Inputs:       <path1_ptr - pointer to SCM's copy of the expanded Quit;                            pathname in class 1 format;                            (partial pathnames are expanded by SCM);; Outputs:      e1_path_ptr - pointer to GQuit's copy of the Quit pathname;               e1_path_hndl - handle to GQuit's copy of the Quit pathname;               A - error code if c=1;               c=0 if no error, else c=1;; This routine makes a copy of the pathname specified in a P16 Quit call.; We have to do this since SCM's copy of the pathname is not locked and; if it moves we're in big trouble.  The reason we can't just lock it and use; it is that if we have to go to P8, the data area in which the pathname lives; is disposed when we shutdown GS/OS.  So, we have to make our own copy.;-------------------------------------------------------------------------------		longa	on		longi	on		entry	copy_pathnamecopy_pathname;first, get the handle associated with the pathname ptr SCM is using		pha			;space for result		pha		pei	<path1_ptr+2	;pointer to pathname in SCM land		pei	<path1_ptr		_FindHandle		sec			;indicate error just in case;		lda	1,s		;is handle nil?;		ora	3,s*** optimized 4-Jun-29 DAL to save two bytes (hooray!)***   A handle can never be $xx0000xx, so checking the middle word is fine.		lda	2,s*** end 4-Jun-92 DAL		beq	got_error2	;yes - so return error (A=0);The handle is now on the stack.  Put another copy of the handle on the stack;since both the HLock and HUnLock calls require the handle as input.		lda	1,s		;get lo word of handle		tax		lda	3,s		;get hi word of handle		pha			;push hi word		phx			;push lo word;now, lock the handle so that the NewHandle call will not cause the;pathname to move		_HLock		bcs	got_error2;allocate space so we can make a copy of the pathname		pha			; reserve space for Handle result		pha		ldx	#$0000		phx			; hi word of seg size ($0000)		lda	[<path1_ptr]	; get length of pathname		inc	a		; add 2 for length word		inc	a		pha			; lo word of seg size		lda	|e1_path_id	; segment id		pha		pea	path_attrib	; seg attributes word		phx			; hi word of seg location ($0000)		phx			; lo word of seg location ($0000)		_newhandle		bcs	got_error4;save the handle to the allocated space and then dereference the handle		phd			;save direct register		tsc		tcd			;point direct register at stack		lda	<3		;get handle to memory		sta	|e1_path_hndl	;and save		lda	<5		sta	|e1_path_hndl+2		lda	[<3]		;dereference handle		sta	|e1_path_ptr	;and save		tax		ldy	#2		lda	[<3],y		sta	|e1_path_ptr+2		tay		pld			;restore direct register		pla			;clean up stack		pla;store pointer to allocated space on GS/OS direct page		sty	<path2_ptr+2		stx	<path2_ptr;copy the pathname from SCM's area into the allocated space		lda	[<path1_ptr]	;get length word		tayloop		lda	[<path1_ptr],y		sta	[<path2_ptr],y		dey		beq	loop		dey		bpl	loop;now we can unlock SCM's copy of the pathname		_HUnLock;return (c and A are set from HLock call)		rts;got an error from the memory manager so clean up the stack and return errorgot_error4		plx		plxgot_error2		plx		plx		rts		DataChk	on		ENDP		eject;==============================================================================; initialize_data;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.; Direct register is unknown.;; Inputs:       none;; Outputs:      none;; This routine sets the initial values of certain variables to zero.;==============================================================================initialize_data	PROC		DataChk	off		longa	on		longi	on		stz	|e1_quit_flags		stz	|e1_open_id		stz	|e1_load_type		stz	|e1_start_flag		stz	|e1_os_switch		stz	|e1_p8quit_path		stz	|e1_path_ptr		stz	|e1_path_ptr+2		stz	|e1_path_hndl		stz	|e1_path_hndl+2		stz	|e1_path_len		rts		DataChk	on		ENDP		eject;==============================================================================; copy_volname;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.; Direct register is preserved.;; Inputs:       e1_path_ptr - points to the expanded Quit pathname;               c - 0 if e1_path_ptr points to a class 0 string;                   1 if e1_path_ptr points to a class 1 string;; Outputs:      e1_app_volname - contains the volume name (class 0 always);; Copies the volume name from the expanded Quit pathname into e1_app_volname; for use by the 'mount volume' routine.;==============================================================================copy_volname	PROC		DataChk	off		phd			;save direct register		lda	|e1_path_ptr+2	;push string ptr onto stack		pha		lda	|e1_path_ptr		pha		tsc			;set direct register to point to stack		tcd		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		ldy	#1		;assume class 0 string to start		ldx	#1		;skip length byte		lda	#'/'		;separator to look for		pha		bcc	class0		iny			;class 1 string so skip another byte		lda	#':'		;different separator to look for		sta	1,sclass0		lda	#'/'		;store beginning slash		sta	|e1_app_volname,xloop		inx		iny		lda	[<1],y		;copy volume name		sta	|e1_app_volname,x		cmp	1,s		bne	loop		;loop until hit a separatordone		dex			;don't count the separator		stx	|e1_app_volname	;store length byte		pla			;pull separator off stack		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****		pla			;pull pointer off stack		pla		pld			;restore direct register		rts		DataChk	on		ENDP		eject;==============================================================================; get_next_prog;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       none;; Outputs:      e1_open_id - id of next program to execute if stack not empty;               A - error code if c=1;               c=0 if no error, else c=1;; The Quit call didn't specify a pathname to link to so pop the ID stack.; If the ID stack is empty, execute the program launcher;==============================================================================get_next_prog	PROC		DataChk	off		Import	call_launcher		longa	on		longi	on; We have no program to link to so pop the ID stack to see if we have a; program to return to.		jsr	Pop_id		; Pop the ID stack		bcc	done		; carry set if stack is empty; We have no program to link to and nothing on the stack to return to.; So, default to the start program if we're currently running P8, or; run the Program Launcher if we're running GS/OS.		lda	|e1_current_os	;which OS is running?		bmi	its_p8		lda	e1_quit_flags	;is the app smart enough to be restarted?		and	#%0001000000000000		bne	@restart_it	;yes, just restart the start app; Since there's no userID on the quit stack to quit to, we'll bring in the Program Launcher; to allow the user to interactively select the next application to launch.		lda	>sys_prefs	;get current system preferences		pha			;save around call to program launcher		lda	#0		;set to not display mount dialog		sta	>sys_prefs				jsl	call_launcher	;go execute the program launcher		pla			;retrieve SysPrefs		sta	>sys_prefs	;restore original setting		phx			;save returned userID		phx			;twice		jsr	copy_pathname	;copy pathname into our own data area		ldx	#$1102		;DisposeAll		jsl	$E10000		;(userid already on stack)		ldx	#$2103		;DeleteID (id already on stack)		jsl	$E10000		sec			;it's a class 1 string		bra	continue2	;then continue as before@restart_it		ldx	#e1_start_prog1	;GS/OS is in so we need a class 1 string		ldy	#e1_start_prog1>>16		sec			;class 1 string for 'copy_volname'		bra	contits_p8		inc	|e1_start_flag	;indicate we're launching start prog		ldx	#e1_start_prog0	;P8 is in so we need a class 0 string		ldy	#e1_start_prog0>>16		clc			;class 0 string for 'copy_volname'cont		stx	|e1_path_ptr	;store pointer to correct string		sty	|e1_path_ptr+2continue2		jsr	copy_volname	;copy volname for mount_volume window		jsr	get_info_subdone		rts			;carry clear if no error, else set		DataChk	on		ENDP		eject;==============================================================================; launch_app;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       none;; Outputs:      none;; Shut down the Desk Manager in case the application didn't to ensure; that no interrupt routines will be calling GS/OS or ProDOS 8 incorrectly.; Then determine if application is P8 or P16 and jump to correct routine.;; The DeskShutDown call can cause memory to move so it must be done after; the Quit pathname has been copied into our own locked data area.;; NOTE: We don't want to deallocate interrupts.  If we're not switching; operating systems, they probably want to live if the QUITing application; didn't deallocate them.  If we are switching operating systems, the handlers; are going to be overwritten and we can, and will, shut off known Apple //gs; interrupt sources before going to ProDOS 8.  However, we haven't any way to; shut off hardware interrupts from some unknown source, so if interrupts are; still running...CRASH!!!;==============================================================================launch_app	PROC		DataChk	off		longa	on		longi	on		_DeskShutDown		lda	|e1_Load_Type	; Get load type		cmp	#$00ff		; Is it P8?		beq	launch_p8app	; yes		jmp	launch_p16app	; no, so must be P16 app		eject;===============================================================================; launch_p8app;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.;; Data bank register is set to bank $E1 on entry.; Direct register is set to GS/OS direct page at $00BD00 on entry from p16quit.; Direct register is set to $000000 on entry from p8quit.; Stack pointer is set to GQuit's stack on entry from p16quit.; Stack pointer is set to $01xx on entry from p8quit.;; Data bank register is set to bank $00 on exit.; Direct register is set to $0000 on exit.; Stack pointer is set to $01fb on exit.;; Attempt to launch a P8 application.;===============================================================================launch_p8app		longa	on		longi	on		lda	|e1_current_os	; Check to see which OS is running.		bpl	its_gsos	; It's GS/OS.		lda	#$01fb		; set stack at $01fb for emulation mode		tcs		jmp	its_P8		; It's ProDOS 8.;-------------------------------------------------------------------------------its_gsos		Import	e1_fst_id		lda	|e1_fst_id	;make sure that the P8 application resides		cmp	#proDOSFSID	; on a ProDOS or AppleShare volume		beq	@continue		cmp	#appleShareFSID		beq	@continue		ldx	#65		;non-fatal error message		jmp	no_can_do@continue; Indicate that we are switching operating systems.		inc	|e1_os_switch; Set OS_Kind to $ff to indicate that we are switching operating systems; and that interrupt tasks should not make OS calls		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	#$ff		sta	|OS_Kind		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on; We are currently using class 1 strings so convert them to class 0 strings...; First, check to see if we're relaunching the start program.; If so, change e1_path_ptr to point to the start program's class 0 pathname.		lda	|e1_start_flag	;are we relaunching the start prog?		beq	not_start	;no		lda	#e1_start_prog0	;yes - so get pointer to class 0 string		sta	|e1_path_ptr		lda	#e1_start_prog0>>16		sta	|e1_path_ptr+2		bra	get_gsos_pfxnot_start; The Quit call specified the pathname of a program to link to.; First, convert the class 1 string to a class 0 string.		ldx	|e1_path_ptr+2	;push ptr to source string (class 1)		phx		ldy	|e1_path_ptr		phy		phx			;push ptr to dest string (class 0)		phy		jsl	>cvt_1to0	;convert class 1 string to class 0; Now, convert the class 1 separators (:) to class 0 separators (/).		ldy	|e1_path_ptr+2	;get pointer to string in X and Y		ldx	|e1_path_ptr		jsl	colon_2_slash	;replace colons with slashes; Get the correct GS/OS prefix which will be used to set ProDOS 8's prefix.get_gsos_pfx		lda	|e1_quit_prefix	;get Quit call's pathname prefix		cmp	#32		;was the prefix '*' ?		bne	not_star	;no		_getbootvol e1_gbv_parms ;class 0 call		bcc	class0_pfx		jmp	gsos_fatal_err	;fatal error - no returnnot_star		stz	|e1_getpfx_num	;initialize to prefix 0		cmp	#$ffff		;was a prefix specified?		beq	get_zero	;no - so get prefix 0		sta	|e1_getpfx_num	;yes - so get the specified prefixget_zero		_getprefix1 e1_getpfx_parms1 ;class 1 call		bcc	prefix_ok		cmp	#buff_too_small	;if buffer was too small then prefix		beq	its_too_long	;was > 65 chars so report syntax err		jmp	gsos_fatal_err	;fatal error - no returnprefix_ok; Now, convert the prefix string from class 1 to class 0		pea	e1_prefix_buf>>16 ;push ptr to source string (class 1)		pea	e1_prefix_buf		pea	e1_prefix_buf>>16 ;push ptr to dest string (class 0)		pea	e1_prefix_buf		jsl	>cvt_1to0	;convert class 1 string to class 0; Now, convert the class 1 separators (:) to class 0 separators (/).		ldy	#e1_prefix_buf>>16 ;get string pointer in X and Y		ldx	#e1_prefix_buf		jsl	colon_2_slash	;replace colons with slashesclass0_pfx; Check to make sure that the length of the pathname minus the length of; the prefix (if specified) is less than 65 characters.		pea	0		;init prefix length to 0		lda	|e1_quit_prefix	;was a prefix specified?		bmi	no_prefix	;no		lda	|e1_prefix_buf	;yes - so put prefix length on stack		and	#$00ff		sta	1,sno_prefix		lda	|e1_path_ptr		sta	<path1_ptr	;store string ptr on GS/OS direct page		lda	|e1_path_ptr+2	;we can use path1_ptr as a temp		sta	<path1_ptr+2		sec		lda	[<path1_ptr]	;get length		and	#$00ff		;mask off hi byte		sbc	1,s		;subtract length of prefix		plx			;clean up stack		cmp	#p8_max_length+1 ;is it longer than maximum P8 pathname?		bcc	length_ok	;noits_too_long		lda	|e1_quit_flags	;was previous app put on ID stack?		bpl	cant_cancel	;no		ldx	#p8_path_err	;message #no_can_do		jsr	gsos_nonfatal	;put up non-fatal error		jsr	pop_id		;pop ID of previous app off stack		jmp	launch_p16app	;and relaunch itcant_cancel				;can't recover so put up fatal error msg		ldx	#p8_path_err2	;message #		jmp	gsos_fatal_err2	;fatal error - no returnlength_ok; Check to see if we have a copy of the P8 file in memory		lda	|e1_p8copy_flag	;do we have a saved copy of P8?		bmi	no_copy		;no		jsr	deref_and_lock	;yes - so deref and lock the handle		bcc	notify_q	;carry set if block was purgedno_copy; Go load the P8 file...; First, try to open the P8 file.open_call	_open1	e1_open_parms1	; Open the P8 file.		bcc	open_p8_ok		cmp	#file_not_found	;was the error 'file not found' ?		bne	local_fatal	;no - so put up fatal error message		lda	|e1_quit_flags	;was previous app put on ID stack?		bpl	no_pop_back	;no - so put up fatal error message		ldx	#no_p8_err	;message #		jsr	gsos_nonfatal	;put up non-fatal error		jsr	pop_id		;pop ID of previous app off stack		jmp	launch_p16app	;and relaunch itno_pop_back				;can't recover so put up fatal error msg		ldx	#no_p8_err2	;message #		jmp	gsos_fatal_err2	;fatal error - no returnopen_p8_ok*** added 4-Jun-92 DAL, mainly for EtherTalk card; Call OS_P8_Switch vector with A = $0001 for leaving-GS/OS, for; things like the ETalk driver, which have no convenient way to; instally a notify proc on ROM 1.		lda	#$0001		jsl	>os_p8_switch*** end 4-Jun-92; Notify the OS event queue that we are just about to switch to ProDOS 8.; The Direct register must be set to GS/OS direct page for the call to SCM.notify_q		pha			; push 3 words of garbage		pha		pha		lda	#switch_to_p8	;lo word of the event code		ldx	#>switch_to_p8  ;hi word of the event code		jsl	>os_event	;call SCM; If we have a copy of the P8 file in memory, then copy it down to $2000		lda	|e1_p8copy_flag		cmp	#1		;do we have a valid handle?		bne	read_p8		;no - so read in the file from disk		lda	|e1_p8copy_ptr+2 ;hi word of src		pha		lda	|e1_p8copy_ptr	;lo word of src		pha		lda	#$0000		pha			;hi word of dest ($0000)		pea	$2000		;lo word of dest		pha			;hi word of xfer count ($0000)		lda	|e1_p8copy_size	;lo word of xfer count		pha		pea	move_sinc_dinc	;command byte		jsl	>move_info	;call SCM to do the copy		jmp	p8copy_done; The file is open, so now read it into memory at $2000 and close the file.read_p8		lda	|e1_open_ref	; Put ref no. into other parm lists		sta	|e1_close_ref		sta	|e1_geof_ref		sta	|e1_read_ref		_geteof1 e1_geof_parms1	; Get # of bytes in P8 file		bcc	eof_oklocal_fatal	jmp	gsos_fatal_err	; fatal error - no returneof_ok		lda	|e1_geof_eof	; get # of bytes to read		sta	|e1_p8copy_size	; save		sta	|e1_read_count	; only low word is needed		stz	|e1_read_count+2 ; High word is zero		_read1	e1_read_parms1	; Read in P8		bcs	local_fatal		_close1	e1_close_parms1	; Close the P8 file		bcs	local_fatal; ProDOS 8 is now loaded at $2000.  Check the "GS/OS compatibility byte".		lda	|e1_geof_eof	;get size of P8 file		cmp	#p8_file_eof	;is it the correct size?		bne	bad_version	;no		lda	>P8_compat_byte	;size is OK so get the compatibility byte		and	#$00FF		;mask off hi byte		cmp	#P8_compat_value		beq	version_okbad_version	ldx	#p8_version_err	;message #		jmp	gsos_fatal_err2	;fatal error - no returnversion_ok; Save a copy of the P8 file in non-special memory		pha			;space for Handle result		pha		pea	$0000		;hi word of size		lda	|e1_p8copy_size	;lo word of size		pha		lda	|e1_p8copy_id	;user id		pha		pea	p8copy_attrib	;attributes		pha			;loc ptr - unused		pha		lda	|e1_p8copy_flag	;do we have a purged handle?		beq	realloc		;yes - so reallocate it		_newhandle		;allocate a new handle		plx		ply		bcs	p8copy_done2	;got an error - don't report it		stx	|e1_p8copy_hndl		sty	|e1_p8copy_hndl+2		bra	copy_p8realloc		lda	|e1_p8copy_hndl+2 ;purged handle		pha		lda	|e1_p8copy_hndl		pha		_ReAllocHandle		;reallocate it		plx			;clean up stack		plx		bcs	p8copy_done2	;got an error - don't report itcopy_p8		jsr	deref_and_lock	;dereference and lock the handle		ldx	#$0000		phx			;hi word of src ($0000)		pea	$2000		;lo word of src		lda	|e1_p8copy_ptr+2 ;hi word of dest		pha		lda	|e1_p8copy_ptr	;lo word of dest		pha		phx			;hi word of xfer count ($0000)		lda	|e1_p8copy_size	;lo word of xfer count		pha		pea	$0805		;command byte		jsl	>move_info	;call SCM to do the copy; We're done with the copy of P8 so unlock the blockp8copy_done		lda	|e1_p8copy_hndl+2		pha		lda	|e1_p8copy_hndl		pha		_HUnlockp8copy_done2; Tell the Slot Arbiter to save the slot 3 screenholes since the ProDOS 8 loader; will enable the internal slot 3 rom.  Do NOT check for errors on this call.		lda	#$0003		;slot 3		jsl	>dyn_slot_arbiter		stx	|e1_besc	;save the "bit encoded slot configuration"; Save the slot 3 rom status (internal vs external) since the ProDOS 8 loader; will enable the internal slot 3 rom and we need to restore the correct value; when we eventually get back to GS/OS.		sep	#$30		;***** begin 8-bit mode *****		lda	>rdc3rom	;get slot 3 status		sta	|e1_c3_status	;and save		rep	#$30		;***** return to 16-bit mode *****; Notify SCM that it should do an EndSession call and then close all open application; files and all open system files and write them out to disk if necessary.; (must be done before the device dispatcher is shutdown); (Direct register must be set to GS/OS direct page)		jsl	>close_all_files; Indicate that GS/OS is no longer in a valid state so that the report_fatal routine; will not try to shutdown GS/OS if a fatal error occurs.		stz	|e1_gsos_ok; Shut down the device dispatcher.; (must be done before SCM is shutdown); (Direct register must be set to GS/OS direct page)		stz	<drvr_dev_num	;device number = dispatcher		lda	#2		sta	<drvr_call_num	;call number = shutdown		jsl	>dev_dispatcher		bcs	local_fatal2; Shut down SCM.; (Direct register must be set to GS/OS direct page)		jsl	>shutdown_scm		bcc	scm_oklocal_fatal2	jmp	gsos_fatal_err	; fatal error - no returnscm_ok		pea	0		; code for switch from GS/OS to P8		ldx	#$1F11		; internal function number for SwitchHandler		jsl	$E10000		; notify the loader that we're switching; Now, let's effectively take out the loader as a tool so it won't be called on; a control reset, or on a call to the reset routine in the firmware.  We will; do this by making a SetTSPtr call with the loader's tool number, and pointing; the function table pointer to a location containing 2 bytes of zeros.  The 2; zero bytes are the count of how many functions there are in the tool set.; The Dispatcher will read this zero, and know not to bother making the TLReset; call to the loader.		pea	0		; Loader is a System toolset		pea	Loader_TSN	; loader's tool set #		pea	zero_word>>16	; Push hi byte of adrs of zero word		pea	zero_word**$ff	; Push lo byte of adrs of zero word		_setTSPtr		; Install the ptr to our zero word; Patch the GS/OS entry vectors to jump to the QuickDraw patches which are at the; start of the error messages file.  This is done so that if a P8 app starts up QuickDraw; (which is a legal thing to do), QuickDraw won't crash when it tries to make GS/OS calls; (which it shouldn't be doing).  The GS/OS entry vectors are restored to their proper; values by the init_SCM routine in SCM.		lda	|e1_patch1_adr	; get load address of first patch and		sta	|$e100b0+1	; store it in the GS/OS stack entry vector after the JML		lda	|e1_patch1_adr+1 ;ignore hi byte of load address		sta	|$e100b0+2		lda	|e1_patch2_adr	; get load address of second patch and		sta	|$e100a8+1	; store it in the GS/OS normal entry vector after the JML		lda	|e1_patch2_adr+1 ;ignore hi byte of load address		sta	|$e100a8+2; Compact memory so that we have a better chance of getting storage space for GS/OS		_CompactMem; Allocate memory to store GS/OS in while ProDOS 8 is running		stz	|e1_no_storage	;init flag to indicate that we got storage		jsr	alloc_storage	;allocate storage areas for GS/OS		bcc	storage_ok	;did we get all the storage areas we need?		jsl	dispose_storage	;no - so get rid of the storage areas we got		inc	|e1_no_storage	;indicate that we don't have storage areas		bra	dispose_os	;skip over some codestorage_ok; Move the B0 code to bank 0 where it must run from.		ldx	#<b0e1_obj_pstn	; source address of code to relocate		ldy	#b0_obj_pstn	; dest address		lda	#b0_obj_size-1	; # of bytes to move - 1.		phb			; save data bank reg		mvn	$E10000,0	; move from bank $E1 to bank $00		plb			; restore data bank reg; Copy parts of GS/OS into storage areas  (this is B0 code)		jsl	copy_gsos_segs; Dispose of any memory which GQuit or GLDR allocated for GS/OS.dispose_os		jsl	dispose_os_mem		bcs	local_fatal2; Now allocate all of special memory for ProDOS 8.		jsr	alloc_p8_mem		bcs	local_fatal2; Set direct register to emulation zero page ($000000) for ProDOS 8.		lda	#$0000		tcd; Set stack to $01fb for ProDOS 8.		lda	#$01fb		tcs; Now we must move the code that calls ProDOS 8's loader to bank 0; because we must go into emulation mode and have the ROM banked in!		phb			; Save current DBR.		ldx	#setup_P8_begin	; Source adr. of Bank 0 code to reloc.		ldy	#$0000200	; Dest adr. (origin) of bank 0 code.		lda	#setup_P8_end-setup_P8_begin-1 ; # of bytes to move - 1.		mvn	$E00000,0	; move from bank $E0 to bank 0; Call ProDOS 8's loader and patch ProDOS 8  (DBR is set to 0 from previous MVN)		jsl	>$000200	; call setup_p8		plb			; Restore DBR.; Update e1_current_os since we have just changed to ProDOS 8.		lda	#$8000		sta	|e1_current_os; Move GS/OS's prefix down to $0200 so we can set ProDOS 8's prefix		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	|e1_prefix_buf	; get length byte		taxmove_pfx	lda	|e1_prefix_buf,x		sta	>$000200,x		dex		bpl	move_pfx		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****; fall into next section;-------------------------------------------------------------------------------its_p8; Set current_id to zero since it is now undefined.		stz	|e1_current_id; Set the SHADOW register up for P8 applications and set OS_Kind to $00; to indicate that ProDOS 8 is running		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	>shadow		and	#text_page_2_bit ; preserve state of text page 2 shadowing		ora	#P8_shadowmask	; All shadowing on (//e simulation)		sta	>shadow		stz	|OS_Kind	; 0 signifies that P8 is running		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****; Call the first routine in the auto linked chain of routines that; need to know when the OS is going to be changed.; (This must be done before we start making P8 calls.)		jsl	>OS_Switch	; Notify the routines.; Strip the prefix off the application's pathname if a partial pathname; was specified in the Quit call		lda	|e1_quit_prefix	;was it a partial pathname?		bmi	store_path	;no - so don't have to strip off prefix		lda	|e1_path_ptr	;put ptr to pathname on direct page		sta	<0		lda	|e1_path_ptr+2		sta	<2		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		sec		lda	[0]		;get length byte of full pathname		sbc	|e1_prefix_buf	;subtract length byte of prefix		ldy	|e1_prefix_buf	;to create length of partial pathname		sta	[0],y		;store just before partial pathname		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****		clc			;adjust e1_path_ptr to point to the		lda	|e1_prefix_buf	;partial pathname		and	#$00ff		adc	|e1_path_ptr		sta	|e1_path_ptr		lda	|e1_path_ptr+2		adc	#0		sta	|e1_path_ptr+2; Store the application's pathname at $280 abiding by P8's conventions.store_path		lda	|e1_path_ptr		sta	<0		lda	|e1_path_ptr+2		sta	<2		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	[<0]		;get length byte		tay		taxmove_loop	lda	[<0],y		sta	>$000280,x		dey		dex		bpl	move_loop		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****; If we got here from a P16 Quit call which specified a pathname, we must now; deallocate the space we obtained for the copy of the pathname; since we are done using the pathname.		jsl	dispose_path		bcc	dispose_ok		jmp	p8_fatal_err2	;fatal error - no returndispose_ok		lda	>$1000		; does the quit code start with a CLD? ($D8)		and	#$00FF		cmp	#$00D8		beq	@move_launcher	; yes, so it's not our custom launch code		lda	>$100E		; pick up the ID bytes		cmp	#'G'+('Q'<<8)	; is it GQuit's custom launcher?		beq	@do_launch	; yes, we can use it!@move_launcher; Now move the application's loading code into bank zero since it; makes ProDOS 8 calls.		ldx	#setup_p8_end	; Source adr. of code to move.		ldy	#load_app_begin	; Dest adr. of code.		lda	#load_app_end-load_app_begin-1 ; # of bytes to move - 1.		mvn	$E00000,0	; MVN from bank $e0 to $00.; Data bank register is now set to bank $00 from previous MVN.@do_launch		pea	0		;must set DBR to 0 for emulation mode		plb		plb; Decrement the system busy flag		jsl	>decbusyflg; Load and run the program.		lda	>e1_os_switch	;must pass value of this flag to P8 launcher		jmp	>$001010	;jump to relocated QUIT code;---------------------------------------------------------------------------------; deref_and_lock;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.; Direct register is set to GS/OS direct page at $00BD00 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       e1_p8copy_hndl - handle to copy of P8;; Outputs:      c - 1 if handle was purged; 0 if handle is valid;		e1_p8copy_ptr - ptr to copy of P8 (if e1_p8copy_hndl is valid);		e1_p8copy_flag - 0 if handle was purged, 1 if handle is valid;; Dereference and lock e1_p8copy_hndl.;---------------------------------------------------------------------------------deref_and_lock		longa	on		longi	on		stz	|e1_p8copy_flag	;indicate that we have a purged handle		sec			;ditto		lda	|e1_p8copy_hndl	;put handle on direct page		sta	<path1_ptr	;we can use path1_ptr		lda	|e1_p8copy_hndl+2		sta	<path1_ptr+2		lda	[<path1_ptr]	;dereference the handle		sta	|e1_p8copy_ptr		ldy	#2		lda	[<path1_ptr],y		sta	|e1_p8copy_ptr+2		ora	|e1_p8copy_ptr	;has the handle been purged?		beq	d_and_l_done	;yes		ldy	#4		lda	[<path1_ptr],y	;get attributes		ora	#$8000		;lock the segment		sta	[<path1_ptr],y		inc	|e1_p8copy_flag	;indicate that we have a valid handle		clc			;dittod_and_l_done	rts		DataChk	on		ENDP		eject;===============================================================================; setup_p8;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to $01xx on entry and exit.;; Inputs:       none;; Outputs:      none;; Notes:        This code is moved to $00/0200 and executed there.;===============================================================================setup_P8	PROC		EXPORT	setup_P8_beginsetup_P8_begin		longa	off		longi	off		sec		xce			;***** begin emulation mode ******** 23-Oct-92 DAL -- Zero is a nasty problem when it gets left in***   DEVNUM.  Let's lie and say $50 instead.;;;		stz	$43		;zero P8's boot device ID		lda #$50		sta $43*** end 23-Oct-92; Now call the alternate entry point in the ProDOS 8 loader that; will set up ProDOS 8, but instead of executing a system program,; will return to the caller.		lda	|romin		; Enable ROM for ProDOS.		jsr	$2006		; use new GQuit entry point		ldy	|lcbank1	; R/W enable LCb1 for GQUIT.		ldy	|lcbank1		clc		xce			;***** return to 8-bit native *****; *** gab ***; Need to patch the P8 kernel to first move the dispatcher code from $D100 to $1000.; After it's moved, we can  check the P8 quit parameters for the signature byte ($EE); signifying a pathname quit.  If it is, we  can go directly to GQuit.  If it's a normal; quit, we should transfer control to $1000 (the dispatcher code).  This way, if the user; has installed their own dispatcher code over our code, the user's dispatcher will gain; control (instead of going off to GQuit).; *** end ***; Now enable LCb1 to patch the P8 kernel. This patch will check to see; if the P8 quit call was a pathname quit with $ee as an input parameter,; and if so jump directly to GQUIT.  If not, then it will move the three; pages at $d100 LCb2 to $1000 and jmp $1000 as usual.		ldy	|lcbank1		lda	|p8calldisp_adr	;get the address of p8calldisp		sta	<0		;and store on zero page		lda	|p8calldisp_adr+1		sta	<1		ldy	#patch_size-1	;get length of patchlkoop		lda	|patch_begin-setup_p8_begin+$200,y		sta	(<0),y		; This is the patch address!		dey		bpl	lkoop		longa	on		longi	on		rep	#$30		; Return in 16 bit mode.		rtl			; Back to GQUIT!;-------------------------------------------------------------------------------; P8calldisp patch;; This is the patch code that patches the code in ProDOS that moves the 3; pages of quit code from $d100 in bank0 lc to $1000.  Beware that if the; patched code changes in size, this patch must do the same.  Also beware; that if the contents of $bf04,$bf05 (currently it's CALLDISP) changes, this; patch must do the same.;-------------------------------------------------------------------------------patch_begin		longa	off		longi	offmax_size	equ	$2D		;maximum size the patch can grow tobra_target	equ	patch_begin+max_size; *** gab ***; this has been rearranged so that the move is done prior to checking for the signature; byte.  This is so that the launcher code is in place whether it's a normal quit or; a pathname quit.		lda	|lcbank2	; R/W enable LCb2		lda	|lcbank2		longa	on		longi	on		clc			; *** gab *** go into native mode		xce		rep	#$30		;***** return to 16-bit mode *****		ldx	#$D100		;source of move		ldy	#$1000		;destination of move		lda	#$300-1		;move $300 bytes		mvn	0,0		;move within bank 0		longa	off		longi	off		sep	#$30		; *** gab *** 8 bit mode		lda	|lcbank1	; R/W enable LCb1		lda	|lcbank1		ldy	#1		lda	($40),y		;get quit param		cmp	#$ee		;is it this?		bne	jjjj		;no it's not, do the move, like always		jmp	>P8quit		;yes it is, go to pquitjjjj		longa	off		longi	off		sec		xce			;***** begin emulation mode *****	if (*-patch_begin) = max_size-1 then		nop			;dummy byte to let execution fall through	elseif (*-patch_begin) < max_size then		bra	bra_target	;must jump around left-over garbage	else		; just let the code fall into the original code	endif		patch_size	equ	*-patch_begin	;size of this patch  if patch_size>max_size then    aerror &concat('P8 Quit patch too long by $', &i2s(patch_size-max_size,-4,1), ' bytes!')  endif		EXPORT	setup_P8_endsetup_P8_end		ENDP		eject; The functionality of this segment has been placed in an alternate dispatcher; segment that is copied to bank 2 of the language card by the P8 setup routine; within P8 itself.  This copy is here so that we can copy it down to bank; 0 and use it when the normal quit routine has been overwritten by a user-; installed Quit routine (such as ProSel).;; The alternate dispatcher code resides at $1010 in memory after a P8 quit call.; The first 14 bytes of $1000 area of memory is reserved for the patch that forces; the quit call to jump to P8Quit, with the bytes at $100E and $100F reserved for; GQuit's ID bytes (currently 'GQ').;===============================================================================; load_app;; Entry is in 16-bit native mode.; Exit is in emulation mode.; Data bank register is set to bank $00 on entry and exit.; Direct register is set to $0000 on entry and exit.; Stack pointer is set to $01fb on entry and exit.;; Inputs:       Acc = value of e1_OS_Switch;; Outputs:      none;; Notes:        This code is moved to $00/1010 and executed there.;; Loads and executes a ProDOS 8 application.;===============================================================================load_app	PROC	tempOrg $1010		DataChk	Off		CodeChk	Off		EXPORT	load_app_beginload_app_begin; Go into emulation mode to load and run ProDOS 8 application.		longa	off		longi	off		sec		xce			;***** begin emulation mode *****		tax			; Are we switching from P16 to P8?		beq	load_it		; no; We are switching from P16 to P8, so we must pass prefix 0 from P16 to; the P8 prefix.setpfx_call	jsr	|ProDOS8		DC.B	p8_setpfx_num	;command number		DC.W	p8_setpfx_list	;parameter list		bcc	setpfx_ok		jsr	p8error2	; handle error.		bra	setpfx_call	; try again.setpfx_ok; Now, load in the application beginning at $2000.load_it; Open the application file.open_call	jsr	|ProDOS8		DC.B	p8_open_num		DC.W	p8_open_list		bcc	open_ok		jsr	p8error		; handle error.		bra	open_call	; try again.open_ok; Do a GetEOF call so we know how many bytes to read.eof_call	jsr	|ProDOS8		DC.B	p8_eof_num		DC.W	p8_eof_list		bcc	eof_ok		jsr	p8error		; handle error.		bra	eof_call	; try again.eof_ok; Get the size of the file and store in the Read parameter list.		lda	|p8_eof		sta	|p8_read_count		lda	|p8_eof+1		sta	|p8_read_count+1; Read in the application.read_call	jsr	|ProDOS8		DC.B	p8_read_num		DC.W	p8_read_list		bcc	read_ok		jsr	p8error		; handle error.		bra	read_call	; try again.read_ok; Close the application file.close_call	jsr	|ProDOS8		DC.B	p8_close_num		DC.W	p8_close_list		bcc	close_ok		jsr	p8error		; handle error.		bra	close_call	; try again.close_ok;*** added 23-Oct-92 DAL -- If UNIT ($43) is still zero, make it something else,;***   because zero is dangerous (if fed to ON_LINE, for example, it will return;***   much more data than expected).  This should only be zero in the somewhat;***   strange case that you network-booted into GS/OS, and then switched to P8;***   but have so many devices online that your boot volume isn't in DEVLST.;		lda	$bf30;		bne	@okay;		lda	#$50;		sta	$bf30;@okay;*** end 22-Oct-92; Now, execute the application.		lda	|romin		; Enable ROM.		jmp	$2000		; Execute the application.;-------------------------------------------------------------------------------p8error		ldy	|lcbank1	; Enable LCb1 for error routines		ldy	|lcbank1		clc		xce			;***** begin native mode *****		rep	#$30		;***** begin 16-bit mode *****		jsl	p8_mount_vol		bcc	ret_pressed		jmp	>p8_fatal_errp8error2		ldy	|lcbank1	; Enable LCb1 for error routines		ldy	|lcbank1		clc		xce			;***** begin native mode *****		rep	#$30		;***** begin 16-bit mode *****		jsl	p8_prefix_err		bcc	ret_pressed		jmp	>p8_fatal_errret_pressed		sec		xce			;***** return to emulation mode *****		rts;-------------------------------------------------------------------------------; ProDOS 8 parameter lists;-------------------------------------------------------------------------------p8_setpfx_list				; Set prefix parameter list.		DC.B	1		; Number of parameters is 1.		DC.W	$200		; Address of where prefix is.p8_open_list		DC.B	3		; Parameter count is 3.		DC.W	$280		; Pathname is at $280.		DC.W	$1c00		; I/O buffer location.		DS.B	1		; Reference numberp8_eof_list		DC.B	2		; Number of parameters is 2.		DC.B	1		; Reference number is 1 (Only open file).p8_eof		DS.B	3		; 3 byte EOF value.p8_read_list		DC.B	4		; Number of parameters is 4.		DC.B	1		; Reference number is 1.		DC.W	$2000		; Read into $2000. (Bank 0 of course)p8_read_count	DS.B	2		; Number of bytes to read.		DS.B	2		; Transfer count.p8_close_list		DC.B	1		; Number of parameters is 1.		DC.B	1		; Close reference number is 1.		EXPORT	load_app_endload_app_end		DataChk	On		CodeChk	On		ENDP		eject;===============================================================================; launch_p16app;; Entry is in 16-bit native mode.; Exit is in 8-bit native mode.;; Data bank register is set to bank $E1 on entry.; Direct register is set to GS/OS direct page at $00BD00 on entry from p16quit.; Direct register is set to $000000 on entry from p8quit.; Stack pointer is set to GQuit's stack on entry from p16quit.; Stack pointer is set to $01xx on entry from p8quit.;; Data bank register is set to bank $E1 on exit.; Direct register is set to application's direct page on exit.; Stack pointer is set to application's stack on exit.;; Attempt to launch a P16 application.;===============================================================================launch_p16app	PROC		DataChk	off		Import	gsos_nonfatal2		longa	on		longi	on		lda	|e1_current_os	;Check to see which OS is running.		bmi	its_P8		;It's ProDOS 8.		jmp	its_gsos	;It's GS/OS.;-------------------------------------------------------------------------------its_p8		lda	|e1_no_storage	; do we have GS/OS storage areas?		beq	storage_ok	; yes - so continue		jmp	>restart_system	; call SCM to restart the systemstorage_ok*** NOTE THAT A = $0000 HERE, EVEN IN 6.0 (4-Jun-92 DAL); Let everybody know that P8 is going away before it actually goes away		jsl	>os_p8_switch	; A = $0000 for leaving P8; Indicate that we are switching operating systems.		inc	|e1_os_switch; Set OS_Kind to $ff to indicate that we are switching operating systems; and that interrupt tasks should not make OS calls		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	#$ff		sta	|OS_Kind		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on; Dispose of ProDOS 8's reserved memory segments		jsl	dispose_os_mem		bcc	dispose_oklocal_p8_fatal	jmp	p8_fatal_err2	;fatal error - no returndispose_ok; Allocate GS/OS's reserved memory segments		jsl	alloc_gsos_mem		bcs	local_p8_fatal; Move the B0 code to bank 0 where it must run from		ldx	#<b0e1_obj_pstn	; source address of code to relocate		ldy	#b0_obj_pstn	; dest address		lda	#b0_obj_size-1	; # of bytes to move - 1.		phb			; save data bank reg		mvn	$E10000,0	; move from bank $E1 to bank $00		plb			; restore data bank reg; Clear the screen and put up the "One moment please..." message  (this is B0 code)		jsl	display_msg; Copy GS/OS back into its assigned locations  (this is B0 code)		jsl	copy_gsos_segs; Now set the stack to GQuit's own stack.; But before we do, we must check what the stack is currently set to.; If it's Page 1 we must set $010100 to the value in S.		tsc			; get current stack		and	#$FF00		; look at high byte		cmp	#$0100		; is it 1?		bne	set_new_stack	; no, so never mind		tsc			; get it again		sep	#$30		; go into 8 bit mode		sta	>mnemstkptr	; store it		rep	#$30		; back to 16 bit modeset_new_stack	lda	#gquit_stack_top ; set stack to GQuit's own stack		tcs; Make sure our error messages are not suppressed		lda	>sys_prefs	;get preferences flag		and	#$DFFF		;clear bit 13		sta	>sys_prefs; Dispose of GS/OS storage areas		jsl	dispose_storage		bcs	local_gs_fatal; Now, let's re-install the loader as a tool		pea	0		; indicate this is a System toolset		pea	Loader_TSN	; loader's tool set #		pea	#^Loader_Entry		pea	#<Loader_Entry		_setTSPtr		pea	1		; code for switch from P8 to GS/OS		ldx	#$1F11		; internal function number for SwitchHandler		jsl	$E10000; Now restart GS.OS.DEV		lda	|e1_dev_address+2 ; get hi word of entry address		xba			; swap bytes		sta	>dev_adr+2	; and store below		lda	|e1_dev_address	; get lo word of entry address		sta	>dev_adr+1	; and store belowdev_adr		jsl	dev_adr		;*** Modified above to JSL to GS.OS.DEV; Set direct reg to GS/OS direct page for calls to SCM and device dispatcher		pea	direct_base	;setup gsos direct page		pld; Initialize SCM		jsl	>init_scm		bcc	scm_oklocal_gs_fatal	jmp	gsos_fatal_err	;fatal error - no returnscm_ok; Initialize the device dispatcher		stz	<drvr_dev_num	;device number = dispatcher		stz	<drvr_call_num	;call number = boot init		lda	|e1_mslot	;get boot slot #		and	#$0007		;mask off bits which must be 0		sta	<boot_slot	;boot slot #		lda	|e1_drvr_address ;load address of custom boot driver if		sta	<drvr_dib_ptr	;one was requested, else nil		lda	|e1_drvr_address+2		sta	<drvr_dib_ptr+2		lda	|e1_drvr_id	;user ID of custom boot driver if one		sta	<boot_user_id	;was requested, else 0		jsl	>dev_dispatcher	;initialize the device dispatcher		bcs	local_gs_fatal; Indicate that GS/OS is now up and running so that the report_fatal routine can; attempt to shutdown GS/OS if a fatal error occurs.		inc	|e1_gsos_ok; Update e1_current_os since we have now switched to GS/OS.		stz	|e1_current_os; Restore the slot 3 rom status (internal vs external) since the ProDOS 8; loader enabled the internal slot 3 rom.		sep	#$30		;***** begin 8-bit mode *****		lda	|e1_c3_status	;get the slot 3 rom status		bpl	no_change	;internal rom was in so no change		sta	>setslotc3rom	;map in the external slot romno_change		rep	#$30		;***** return to 16-bit mode *****; Tell the Slot Arbiter to restore the slot 3 screenholes since the ProDOS 8 loader; enabled the internal slot 3 rom.  Do NOT check for errors on this call.		ldx	|e1_besc	;get the "bit encoded slot configuration"		lda	#$0300		;slot 3		jsl	>dyn_slot_arbiter; Set prefix 0 to whatever P8's prefix was.		_setprefix e1_setpfx0_parms		bcs	local_gs_fatal; Set the library prefix to its default: '/*/system/libs'.; This only gets done when the last OS was ProDOS 8, since it might; have been changed to a different (and valid) value in GS/OS land.		_setprefix1 e1_setpfx2_parms1bcs_gs_fatal	bcs	local_gs_fatal; Notify the OS event queue that we have just switched to GS/OS.; The Direct register must be set to GS/OS direct page for the call to SCM.		pha			; push 3 words of garbage		pha		pha		lda	#switch_to_gsos	;lo word of the event code		ldx	#>switch_to_gsos ;hi word of the event code		jsl	>os_event	;call SCM; Check to see if we have the ID of the program we are launching.; If not, we have to convert the pathname string to class 1.		lda	|e1_open_id	; do we have an ID?		bne	have_id		; yes; We are currently using class 0 strings so convert them to class 1 strings...; First, check to see if we're relaunching the start program.; If so, change e1_path_ptr to point to the start program's class 1 pathname.		lda	|e1_start_flag	;are we relaunching the start prog?		beq	not_start	;no		lda	#e1_start_prog1	;yes - so get pointer to class 1 string		sta	|e1_path_ptr		lda	#e1_start_prog1>>16		sta	|e1_path_ptr+2		bra	convert_donenot_start; The Quit call specified the pathname of a program to link to.; Convert the class 0 string to a class 1 string.		ldx	|e1_path_ptr+2	;push ptr to source string (class 0)		phx		ldy	|e1_path_ptr		phy		phx			;push ptr to dest string (class 1)		phy		jsl	>cvt_0to1	;convert class 0 string to class 1; Now, convert the class 0 separators (/) to class 1 separators (:).		ldy	|e1_path_ptr+2	;get pointer to string in X and Y		ldx	|e1_path_ptr		jsl	slash_2_colon	;replace slashes with colonsconvert_donehave_id; fall into next section;-------------------------------------------------------------------------------its_gsos		Import	force_get_info; Set OS_Kind to $01 to indicate that GS/OS is running		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	#$01		sta	|OS_Kind		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on; Make sure cache will be purged if system runs out of memory		jsl	>cache_in_queue; Make sure that the .CONSOLE device exists before launching the application		lda	#e1_cons_path		;set up the pathname ptr parameter		sta	|e1_gdn_ptr		;for the call		lda	#e1_cons_path>>16		sta	|e1_gdn_ptr+2		_getdevnumber1 e1_gdn_parms1	;class 1 call		bcs	bcs_gs_fatal; Set prefixes 1 and 9 to the application's pathname.; Set prefix 33 to the application's USER folder.; Set prefixes 10,11,12 to '.CONSOLE'.try_again		jsr	set_prefixes		bcs	bcs_gs_fatal; If we have an ID at this point, it was pulled off the ID stack so restart; the application.		lda	|e1_open_id	; do we have an ID?		bne	restart_it	; yes - so do a restart call; We have a pathname but not an ID so check to see if the application has been; previously run. If it has, then maybe we can use the ID for a restart call.		pha			; Push space for output user ID.		lda	|e1_path_ptr+2	; push ptr to pathname		pha		lda	|e1_path_ptr		pha		_getuserid2		pla			; Pull off output user ID		bcs	unknown_app	; loader has no record of this app		sta	|e1_open_id	; save ID for the Restart call; We found an ID for the app so check to see if it's currently on the ID stack.; If so, force an InitialLoad since we don't want to relaunch an app which; is sitting on the ID stack.		jsr	check_id_stack	; is the ID on the stack?		bcs	init_load	; yes - so force an InitialLoad		jsr	force_get_info	; get the file info		lda	|e1_aux_type	; check the aux type		and	#$FF02		; check for signature byte and desktop bit		cmp	#$DB02		bne	restart_it	; not a desktop app, leave e1_open_id as-is		lda	#$8000		; else set bit 15		tsb	|e1_open_id; Restart the application from memory.restart_it		pha			; Push 10 bytes for result space		pha			; for Restart call.		pha		pha		pha		lda	|e1_open_id		asl	a		; clear our SHR bit		lsr	a		pha			; Push user ID on stack.		_restart		; Restart the Application.		bra	get_outputs	; Outputs are the same as for InitLoad.; The loader has no record of the app so check its partial path length.; If the length is > 64 characters then check the auxtype of the app; to see if it's "GS/OS aware" (ie - uses prefixes 8 and above).; If not, put up a warning message since the app may not be able to run; correctly since prefixes 0-7 are limited to 64 characters.unknown_app		lda	|e1_path_len	;get length of app's partial path		cmp	#p8_max_length+1 ;is the string > 64 chars?		bcc	path_len_ok	;no - so it's OK		lda	|e1_aux_type	;yes - so get the app's auxtype		and	#gsos_aware_mask ;mask off certain bits		cmp	#gsos_aware	;is the app "GS/OS aware"?		beq	path_len_ok	;yes - so no need for a warning		lda	|e1_quit_flags	;was previous app put on ID stack?		bpl	no_pop_back	;no - so put up different message		ldx	#aware_err1	;message #		jsr	gsos_nonfatal	;put up non-fatal error message		ror	a		;2='Cancel' selected, 1='Continue' selected		bcs	path_len_okrtn_to_previous; before returning to the launching app, clear the fake menu bar on the SHR screen; but only if the SHR screen is currently being displayed		lda	newvideo	;read NewVideo byte		and	#$0080		;SHR displayed?		beq	@no_blast	;no, don't touch screen		lda	#$FFFF		;clear with white pixels		ldx	#11*160		;11 scan lines * 160 bytes per scan line@1		dex		dex		sta	>$E120A0,x	;leave black line at top and bottom of menu bar		bne	@1		;loop until done@no_blast		jsr	get_next_prog	;get ID of next application to launch		jmp	try_again	;and relaunch itno_pop_back				;can't relaunch previous app		ldx	#aware_err2	;message #		jsr	gsos_nonfatal	;put up non-fatal error messagepath_len_ok				;path length is OK or "Continue" selected; Load the application from disk.; First, try loading the app in non-special memory.  If that fails, then; try loading the app in special memory.init_load		lda	#1		; initialize flag to indicate that special		sta	|e1_word_temp	; memory cannot be used		pha			; push 10 bytes for result space		pha			; for Initial Load call		pha		pha		pharetry_load	pea	0		; assume we need to get a new User ID		lda	|e1_path_ptr+2	; push ptr to pathname		pha		lda	|e1_path_ptr		pha		lda	|e1_word_temp		pha			; indicate whether special memory can be used		pea	1		; indicate that pathname is class 1		_initialload2		; load the application		bcc	get_outputs	; the app was loaded without error		dec	|e1_word_temp	; got an error - was special mem allowed?		beq	retry_load	; no-so retry the load but allow special mem; Get the outputs from the Restart call or the InitialLoad callget_outputs		tax			; save error code		pla			; Pull user id		sta	|e1_user_id		pla			; Pull lo word of program start address		sta	>goadr		pla			; Pull hi word of program start address		sta	>goadr+2		pla			; Pull zero page buffer address		sta	|e1_zp_start		pla			; Pull zero page buffer size		sta	|e1_zp_size		bcc	okbad_adr		txa			; restore error code		jsr	gsos_nonfatal2	; display dialog		jmp	rtn_to_previousok		ldx	#not_system_file ; error code in case goadr is 0;;; 		lda	>goadr		; is the program start address 0?;;;		ora	>goadr+2*** optimized 23-Oct-92 DAL -- valid address is never in page zero		lda	>goadr+1*** end 23-Oct-92		beq	bad_adr		; yes - so report error; If we got here from a P16 Quit call which specified a pathname, we must now; deallocate the space we obtained for the copy of the pathname; since we are done using it.		jsl	dispose_path		bcc	path_disposedlocal_gs_fatal2	jmp	gsos_fatal_err	;fatal error - no returnpath_disposed; Tell SCM to not put up the 'mount volume' dialog automatically		lda	>sys_prefs	;get preferences flag		asl	a		;clear bit 15		lsr	a		sta	>sys_prefs; Now, initialize the text tools and ignore all errors		jsl	Init_text_tools; Call the first routine in the auto linked chain of routines that; need to know when the OS is going to be changed.		jsl	>OS_Switch	; Notify the routines.; Now setup the user's direct register and stack pointer		jsl	alloc_user_zp		bcs	local_gs_fatal2		tcs			; set user's stack pointer; make sure the text screen is displayed for those apps that are not; "Desktop Aware"		pea	$0000		; space for result		ldx	#$0604		; QDStatus		jsl	$E10000		pla			; retrieve result		bne	@show_shr	; QD is active, just leave the screen as-is		lda	|e1_open_id	; do we need to turn off the SHR screen?		bmi	@show_shr	; no, this app is a desktop app		bne	@show_text	; yes, doesn't say it supports desktop@check_aux		lda	|e1_aux_type	; check the aux type of the file		and	#$FF02		; check signature byte and destop app bit		cmp	#$DB02		; is it a desktop app?		beq	@show_shr	; yup, leave SHR enabled@show_text		sep	#$20		; 8-bit accumulator		longa	off		lda	>$E0C029	; get the newVideo byte		and	#%01111111	; clear the SHR bit		sta	>$E0C029	; then turn the text screen on		rep	#$20		; back to 16-bit accumulator		longa	on@show_shr; Decrement the system busy flag		jsl	>decbusyflg; Now, move the code which will launch the app onto the application's stack		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		ldx	#go_end-go	; # of bytes to move to user's stack.loop		lda	>go-1,x		; Get the byte to move.		pha			; Push it onto app's stack.		dex			; Next byte of code to move.		bne	loop		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****; The stack pointer now points just below the code we moved onto the stack.; We must disable interrupts since we are going to mess with the stack pointer; and if an interrupt occurs, the code we just moved onto the stack will be; trashed. Interrupts will be re-enabled by the RTI.		sei		tsc			; Put S in A for use as part of JMP		inc	a		; Adjust A to point to code on stack		sta	>stack_adr	; Store lo word of code addr after JMP		inc	a		; Now set S to point to 1 below the RTI stuff		inc	a		; so when RTI is executed, we will jmp off to		inc	a		; the application in 16 bit mode/interrupts on		tcs			; Stack now ready for the RTI.		lda	|e1_user_id	; User gets his id from A reg.		sta	|e1_current_id	; Update e1_current_id so can later shutdown app.		ldx	#$0000		; Set X and Y to zero to denote the application		txy			; is not being run from a shell program; Jump to the code on the stack which will then do an RTI to launch the app		longa	off		longi	off		sep	#$30		; Must be 8 bit to jmp to code on stack!		DC.B	$5c		; Jump long opcode to jump to stack codestack_adr	DS.B	2		; Low 2 bytes of the stack code's entry address		DC.B	0		; High byte of address is zero for stack.;-------------------------------------------------------------------------------; code which is moved onto the stackgo		DC.B	$cd,$81,$c0	; cmp $c081 to enable the ROM		DC.B	$40		; RTI opcode to jmp to the application.		DC.B	$00		; Will be value of P for application.goadr		DS.B	3		; Will contain starting address of appgo_end		DS.B	1		; Space for unused fourth byte of above adr.		DataChk	on		ENDP		eject;===============================================================================; set_prefixes;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.; Direct register is set to GS/OS direct page at $00BD00 on entry and exit.; Stack pointer is set to GQuit's stack on entry and exit.;; Inputs:       none;; Outputs:      c - 0 if no error ; 1 if error.;               A - error code if c=1;               e1_path_len - length of (pathname-filename);; Notes:	The parameter block for the DInfo call must not be in our $E0 or;		$E1 language card space since the Device Dispatcher will switch in;		bank 1 of the language cards thereby switching out the parameter;		block.  So, by setting the Direct register to the bottom of;		GQuit's stack space we can use the area starting at $00/BB00 for;		the parameter block and the device name buffer as well as other;		temporary variables.;; This routine sets prefixes 1 and 9 to the application's partial pathname (the; full pathname to the application but with the filename removed).  If the; partial pathname is longer than 64 characters, then prefix 1 is set to; a null string.  If the AppleShare FST has not been loaded into the system, then; prefix 33 (@) is also set to the app's partial pathname.  If the AppleShare FST; has been loaded into the system, then this routine will check to see if the; application being launched resides on an AppleShare volume.  If so, the; routine will then ask the AppleShare FST for the correct pathname to use when; setting prefix 33.  Otherwise, prefix 33 will be set to the partial pathname.; If the 'skip_std' bit of the Quit Flags is clear then prefixes 10, 11 and 12; will be set to '.CONSOLE'.  If the 'skip_std' bit is set to 1,; then prefixes 10, 11 and 12 will not be changed.;===============================================================================set_prefixes	PROC		DataChk	off; Direct page equatespath_ptr	equ	0		;ptr to application's pathnamefullpath_len	equ	4		;length of application's full pathnamepartialpath_len	equ	6		;length of application's partial pathname					;DInfo - class 1 parameter listdinfo_pcount	equ	8		  ;parameter countdinfo_dnum	equ	10		  ;device numberdinfo_ptr	equ	12		  ;ptr to output buffer for device name					;class 1 output buffer for device nameheader		equ	16		  ;header (2 bytes)buffer		equ	18		  ;buffer (33 bytes); Address equatesdinfo_parms1	equ	gquit_stack_end+dinfo_pcount ;address of DInfo parameter listheader_adr	equ	gquit_stack_end+header	;address of output buffer headerbuffer_adr	equ	gquit_stack_end+buffer	;address of output buffer; Misc. equatesheader_value	equ	35		;size of output buffer + header		longa	on		longi	on; Set the direct register to the bottom of GQuit's stack space		phd			;save original direct register		lda	#gquit_stack_end		tcd; Check the 'skip_std' bit of the Quit Flags.; If it's clear, then set prefixes 10, 11 and 12 to '.CONSOLE'.; If it's set, then don't set prefixes 10, 11 and 12.		lda	|e1_quit_flags		and	#skip_std_bit		bne	skip_std_prefixes		lda	#e1_cons_path		sta	|e1_setpfx_ptr	;set the ptr parameter for the SetPrefix call		lda	#e1_cons_path>>16		sta	|e1_setpfx_ptr+2		ldx	#3			;we have to set 3 prefixes		lda	#10		sta	|e1_setpfx_num		;prefix # to setsetpfx_loop;;;		_setprefix1 e1_setpfx_parms1 	;class 1 call		jsr	SetPrefix1_e1_setpfx_parms1	;opt 23-Oct-92 DAL		bcs	bcs_done2		inc	|e1_setpfx_num		dex		bne	setpfx_loopskip_std_prefixes; Copy the ptr to the application's full pathname onto direct page.; If we only have the app's ID, get its pathname from the loader.		ldx	|e1_path_ptr	; put ptr to app's pathname in X,Y		ldy	|e1_path_ptr+2		lda	|e1_open_id	; if we have an ID, we don't know the		beq	got_pathname	; app's pathname so get it from the loader		pha			; push space for output pathname pointer		pha		asl	a		; clear our SHR bit		lsr	a		pha			; push app's ID		pea	1		; input file number		_lgetpathname2		; get the pathname from the loader		plx			; put ptr to app's pathname in X,Y		ply		bcs	bcs_done2got_pathname		stx	<path_ptr	; store pathname ptr on direct page		sty	<path_ptr+2; Strip off the filename so that we are left with a partial pathname.; Also, save the application's filename in e1_app_filename for SCM to use.		lda	[<path_ptr]	; Get length of app's full pathname		sta	<fullpath_len	; and save so we can restore it later		tay			; put in Y for use as index		iny*** G. Branche; Check for a trailing separator first.  If found, simply decrement the; length so that it's not a part of the pathname any longer		lda	[<path_ptr],y	; get last character in pathname		and	#$00FF		cmp	#':'		; trailing colon?		bne	@no_trailer	; no...		dey			; else decrement length to remove it		tya		dec	a		; one more time (for iny above)		sta	[<path_ptr]	; reset the length		sta	<fullpath_len@no_trailer*** end change		ldx	#0		; counter for filename length		longa	off		longi	off		sep	#$20		;***** begin 8-bit m mode *****char_loop	lda	[<path_ptr],y	; Now strip off the file name to yield		dey			; the partial path to the application		inx			; Determine filename length at same time		cmp	#':'		; Class 1 string so separator is colon		bne	char_loop	; Check next character		dey			; Subtract 1 for the separator		dex			; ditto		phy			;save partial pathname length on stack		stx	|e1_app_filename ;store length of filename		ldy	<fullpath_len	;get back length of full pathname		inyname_loop	lda	[<path_ptr],y	;copy filename into e1_app_filename		sta	|e1_app_filename,x ;which is a class 0 string		dey		dex		bne	name_loop		longa	on		longi	on		rep	#$20		;***** return to 16-bit m mode *****		pla			; retrieve partial pathname length		sta	[<path_ptr]	; Update the length word.; Set prefix 9 (the application prefix) to the application's partial pathname.		lda	#9		sta	|e1_setpfx_num		lda	<path_ptr	; Get pathname ptr and store into the		sta	|e1_setpfx_ptr	; SetPrefix parameter list		lda	<path_ptr+2		sta	|e1_setpfx_ptr+2;;;		_setprefix1 e1_setpfx_parms1 ;class 1 call		jsr	SetPrefix1_e1_setpfx_parms1	;opt 23-Oct-92 DALbcs_done2	bcs	bcs_done; Set prefix 1 (the application prefix) to the application's partial pathname.; If the partial pathname is longer than 64 chars then set prefix 1 to a null string.; Save the length of the partial path for later.		lda	#1		sta	|e1_setpfx_num		lda	[<path_ptr]	;get length word		sta	|e1_path_len	;and save for later		cmp	#p8_max_length+1 ;is the string > 64 chars?		bcc	len_ok		;no - so OK to set prefix 1		lda	#e1_null_str	;get ptr to null string and store in		sta	|e1_setpfx_ptr	;the SetPrefix parameter list		lda	#e1_null_str>>16		sta	|e1_setpfx_ptr+2len_ok;;;		_setprefix1 e1_setpfx_parms1 ;class 1 call		jsr	SetPrefix1_e1_setpfx_parms1	;opt 23-Oct-92 DAL 		bcs	bcs_done; Set prefix 33 (the USER folder prefix)...; First, check to see if the AppleShare FST has been loaded into the system		lda	|e1_appleshare	;has the AppleShare FST been loaded?		bne	got_ashare	;yes		jmp	set_to_app	;no - so set 33 to the app pathnamegot_ashare; The AppleShare FST has been loaded into the system so we need to determine if; the application being launched resides on an AppleShare volume.; Adjust the length word of the application's pathname to only include the; volume name so we can make a GetDevNumber call		lda	[<path_ptr]	;get the length word of the partial path		sta	<partialpath_len ;and save		ldy	#2		;skip length word and beginning separatorloop		iny		lda	[<path_ptr],y	;get next char		and	#$00ff		;mask off hi byte		cmp	#':'		;is it a class 1 separator?		bne	loop		;no		dey			;adjust length count to not include		dey			;the separator		tya		sta	[<path_ptr]	;and store length of volume name; Make a GetDevNumber call to translate the volume name into a device number		lda	<path_ptr	;store the volume name ptr into the		sta	|e1_gdn_ptr	;GetDevNumber parameter list		lda	<path_ptr+2		sta	|e1_gdn_ptr+2		_getdevnumber1 e1_gdn_parms1	;class 1 callbcs_done	bcs	done; Restore the length word of the application's partial pathname		lda	<partialpath_len		sta	[<path_ptr]; Make a DInfo call to translate the device number into a device name		lda	#2		sta	<dinfo_pcount	;set the pcount parameter for the DInfo call		lda	|e1_gdn_dnum		sta	<dinfo_dnum 	;set the device # param for the Dinfo call		lda	#header_adr		sta	<dinfo_ptr	;set the ptr parameter for the Dinfo call		stz	<dinfo_ptr+2		lda	#header_value	;initialize the size header for the output		sta	<header		;buffer (max devname length is 31 chars)		_dinfo1	dinfo_parms1	;class 1 call		bcs	done; Now make a Volume call to determine which file system resides on the volume		lda	#buffer_adr		sta	|e1_volume_ptr	;set the ptr parameter for the Volume call		_volume1 e1_volume_parms1	;class 1 call		bcc	ok		cmp	#buff_too_small	;did we get a "buffer too small" error?		beq	ok		;yes - so ignore it		sec			;no - so indicate a real error		bra	doneok; Check if the file system on the volume is AppleShare.		lda	|e1_volume_id	;get the file system ID		cmp	#appleshare_ID	;is it AppleShare?		bne	set_to_app	;no - so set 33 to the app pathname; The application is being launched from an AppleShare volume so ask the; AppleShare FST for the correct path to use when setting prefix 33.; If we get an error back, set prefix 33 to the application's partial pathname.		_fstspecific1 e1_fst_parms1	;class 1 call		bcs	set_to_app		;non-fatal error		lda	|e1_fst_ptr		;lo word of pathname ptr		ldx	|e1_fst_ptr+2		;hi word of pathname ptr		bra	set_it; Set prefix 33 to the application's partial pathname.set_to_app		lda	<path_ptr	;lo word of pathname ptr		ldx	<path_ptr+2	;hi word of pathname ptr; Set prefix 33set_it		phd			;save direct register		pea	direct_base	;setup gsos direct page for call to SCM		pld		jsl	set_prefix_33	;set prefix 33		pld			;restore direct register		bcs	done; Restore the original length word of the application's pathname		lda	<fullpath_len		sta	[<path_ptr]done		pld			;restore original direct register		rts*** Subrootinized 23-Oct-92 DAL (3 calls; replaces 30 bytes w/ 20, saving 10)SetPrefix1_e1_setpfx_parms1		_SetPrefix1 e1_setpfx_parms1	;class 1 call		rts*** end of subroutine		DataChk	on		ENDP		eject;==============================================================================; get_info_sub;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       e1_path_ptr - points to the pathname of the file;; Outputs:      e1_open_id   - id of next program to run  (P16 programs only);               e1_load_type - filetype of next program to run;               e1_aux_type - auxtype of next program to run;               c=0 if no error, else c=1;               A - error code if c=1;; This routine will return information about a file.;==============================================================================get_info_sub	PROC		DataChk	off		longa	on		longi	on		bit	|e1_current_os	; Which operating system is running?		bmi	Get_Info_8	; It's ProDOS 8		jmp	Get_Info_16	; It's GS/OS*********************************************************************************               Current operating system is ProDOS 8********************************************************************************Get_Info_8		Import	e1_fst_id; Go to 8-bit mode		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	off; Save current data bank register and switch DBR to bank $00		phb		pea	$0000		plb		plb; Save off enough space in bank $00 for the data structure and a pathname buffer		ldx	#65+Get_Data_Size ;size of data structure + 65 bytessave_loop	lda	|Bank0-1,X	;for pathname buffer		sta	>e1_Bank0_Save-1,X		dex		bne	save_loop; Now copy the data structure into bank $00		ldx	#Get_Data_Size	;size of data structurecopy_loop	lda	>Get_Data-1,X		sta	|Bank0-1,X		dex		bne	copy_loop; Now move pathname into bank $00 for P8 calls		rep	#$30		;***** begin 16-bit mode *****		longa	on		longi	on		phd			;save current direct register		lda	>e1_path_ptr+2	;push ptr to pathname on stack		pha		lda	>e1_path_ptr		pha		tsc		tcd			;set direct register to point to stack		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	off		lda	[<1]		;get length byte of pathname		taymove_loop	lda	[<1],y		sta	|P8_pathname,y	;move pathname into bank $00		dey		bpl	move_loop		pla			;clean up stack		pla		pla		pla		pld			;restore direct register; Make a ProDOS 8 GetFileInfo call		lda	#p8_gfi_num		sta	|P8_Call+5		lda	#<Get_Info_Parm		sta	|P8_Call+6		lda	#Get_Info_Parm/$100		sta	|P8_Call+7		jsr	make_the_call		bcs	p8_return; Check the application's filetype		lda	|Get_Info_Parm+4 ; Get the application's file type.		jsr	check_type	; Make sure its a system program.		bcs	p8_return		cmp	#sys_ftype	; Is it a P8 application?		beq	p8_app		; yes		clc			; no - so indicate no error		bra	p8_return; It's a P8 application so we need to check the file size to make sure it will; fit in bank $00 between $2000 and $beff.p8_app; Make a ProDOS 8 Open call		lda	#p8_open_num		sta	|P8_Call+5		lda	#<Open_Parm		sta	|P8_Call+6		lda	#Open_Parm/$100		sta	|P8_Call+7		jsr	make_the_call		bcs	p8_return; Make a ProDOS 8 GetEOF call		lda	#p8_eof_num		sta	|P8_Call+5		lda	#<Get_EOF_Parm		sta	|P8_Call+6		lda	#Get_EOF_Parm/$100		sta	|P8_Call+7		jsr	make_the_call		bcs	p8_return; Make a ProDOS 8 Close call		lda	#p8_close_num		sta	|P8_Call+5		lda	#<Close_Parm		sta	|P8_Call+6		lda	#Close_Parm/$100		sta	|P8_Call+7		jsr	make_the_call		bcs	p8_return; Now check the file size.		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		ldx	#2		lda	|Get_EOF_Parm,X		cmp	#$9F00		;is the file too big?		bcc	p8_return	;no		lda	#out_of_mem	;yes - so indicate error; Restore bank $00 space and returnp8_return		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	off		pha			;save error code if any		php			;save carry info		lda	#proDOSFSID	;assume ProDOS FST ID		sta	>e1_fst_id	;(has to be for P8 calls)		ldx	#65+Get_Data_Sizerestore_loop	lda	>e1_Bank0_Save-1,X		sta	|Bank0-1,X		dex		bne	restore_loop		plp			;restore carry info		pla			;restore error code		plb			;restore DBR		rep	#$30		;***** return to 16-bit mode *****		rts			;c=0 if no error, else c=1;-------------------------------------------------------------------------------make_the_call		jsl	p8_call		beq	call_ok		rep	#$30		;***** begin 16-bit mode *****		jsl	p8_mount_vol		sep	#$30		;***** return to 8-bit mode *****		bcc	make_the_call	;mount window put up - return pressed		rts			;esc pressed or window not put upcall_ok		clc		rts;-------------------------------------------------------------------------------; get_data structureget_data				; This data structure must be moved					; to bank $00 in order to call ProDOS 8.		DC.B	$0A		; (Get_Info Parmameters)		DC.W	P8_Pathname	;      |		DS.B	15		;      |		DC.B	$03		; (Open Parameters)		DC.W	P8_Pathname	;      |		DC.W	IO_Buf		;      |		DS.B	1		;      |		DC.B	$02,$01		; (Get_EOF Parameters)		DS.B	3		;      |		DC.B	$01,$00		; (Close Parameters)		DC.B	$38		;SEC (P8_Call)		DC.B	$FB		;XCE   |		DC.B	$20,$00,$BF	;JSR $BF00		DC.B	$00		;      |		DC.B	$00,$00		;      |		DC.B	$18		;CLC   |		DC.B	$FB		;XCE   |		DC.B	$6B		;RTL   |get_data_size	equ	*-get_data	;  <---' 		EXPORT	bank0_area_used:equbank0_area_used equ	get_data_size+65; location equatesio_buf		equ	$002000		; for our I/O bufferbank0		equ	$000200		; for our ProDOS 8 call area; Offsets into get_data structureget_info_parm	equ	bank0open_parm	equ	get_info_parm+18get_eof_parm	equ	open_parm+6close_parm	equ	get_eof_parm+5p8_call		equ	close_parm+2p8_pathname	equ	bank0+get_data_size*********************************************************************************               Current operating system is GS/OS********************************************************************************Get_Info_16		longa	on		longi	on; First check to see if the program we want to launch has been previously run.; If so, then we know it's a P16 file.; NOTE - the reason this call is made instead of just doing the GetFileInfo call; is because GetFileInfo will spin the disk. So, if the ID exists, we save time.		pha			; Push space for output user ID.		lda	|e1_path_ptr+2	; Push pointer to the pathname and		sta	|e1_gfi_ptr+2	; also store in e1_gfi_parms1 for later		pha		lda	|e1_path_ptr		sta	|e1_gfi_ptr		pha		_getuserid2		pla			; Pull off output user ID.		bcs	no_id		; No ID		lda	#s16_ftype	; Set load type to a P16 system file type.		sta	|e1_load_type		rts			; return with carry clear; This entry point is used to force a GetFileInfo call on the file specified by e1_path_ptr.; It's used to get the auxtype of a file that the loader knows about, but which GS/OS doesn't.; By checking the auxtype, we can determine whether or not to leave the SHR screen enabled.		entry	force_get_infoforce_get_info		lda	|e1_path_ptr+2	; set up pathname pointer in parameter block		sta	|e1_gfi_ptr+2		lda	|e1_path_ptr		sta	|e1_gfi_ptr		;fall into the following section; The application has not been previously run, so now make a GetFileInfo call to; determine the file type and to detect any possible errors that may occur if; we try to load and execute the file.no_id		_GetFileInfo1 e1_gfi_parms1		bcc	@no_err		cmp	#buff_too_small	; option list buffer too small?		bne	ret_cs		; no, must be a real error@no_err		lda	|e1_gfi_atype	; Get the auxtype of the file		sta	|e1_aux_type	; and save for later		lda	|e1_gfi_ftype	; Get the filetype of the file		jsr	check_type	; Make sure it's a system file type		bcs	ret_cs		cmp	#sys_ftype	; is it a P8 application?		bne	ret_cc		; no; It's a ProDOS 8 application, so check the file size to be; sure it will fit in bank $00 between $2000 and $BEFF.		lda	|e1_gfi_eof+2	; get hi word of the eof		bne	too_big		lda	|e1_gfi_eof	; get lo word of the eof		cmp	#$9F00		bcc	ret_cctoo_big		lda	#out_of_mem	; yes - so indicate errorret_cs		sec			; indicate error		rtsret_cc		clc			; indicate no error		rts;-------------------------------------------------------------------------------; check_type;; Entry is in 8-bit or 16-bit native mode.; Exit is in same mode as entry.; Data bank register is unknown at entry.;; Checks file type to see if it's type $b3, $b5, or $ff. If not, reports an; error.;; Inputs:       A = file type to check;; Outputs:      A = input file type if no error, else error code;               e1_load_type = set to input value of A;               c=0 if no error, else c=1;-------------------------------------------------------------------------------check_type		php			; Save processor status.		rep	#$30		;***** begin 16-bit mode *****		longa	on		longi	on		and	#$00ff		; Strip off hi byte of passed type.		sta	>e1_load_type		cmp	#s16_ftype	; Is it a ProDOS 16 system file?		beq	type_ok		; yes		cmp	#shell_ftype	; Is it a ProDOS 16 shell file?		beq	type_ok		; yes		cmp	#sys_ftype	; Is it a ProDOS 8 system file?		beq	type_ok		; yes		lda	#not_system_file ; None of the above so report error		plp			; Restore mode		sec			; indicate error		rtstype_ok		plp			; Restore mode		clc			; indicate no error		rts		DataChk	on		ENDP		eject;===============================================================================; alloc_gsos_mem;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is preserved.;; Inputs:       none;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; Notes:	Must return with an RTL since called from GLDR and E0 code.;; This routine loops through the e1_gsos_segs2 table and uses the information to; allocate the reserved memory segments for GS/OS and the System Loader.; The segments are allocated with a $32xx segment ID.;===============================================================================alloc_gsos_mem 	PROC		DataChk	off		longa	on		longi	on		phb			;save data bank register		pea	$e1e1		plb			;set data bank register to bank $e1		plb		ldx	#0		;init table indexloop		stx	|e1_word_temp	;save table index		ldy	|e1_gsos_segs2+4,x ;hi word of seg location		lda	|e1_gsos_segs2+2,x ;lo word of seg location		pha		lda	|e1_gsos_segs2+6,x ;seg size		plx		jsr	alloc_os_mem	;allocate the segment		bcs	done		lda	|e1_word_temp	;retrieve table index		adc	#12		tax			;adjust index to point to next table entry		lda	|e1_gsos_segs2,x ;at end of table?		bpl	loop		;nodone		plb			;restore data bank register		rtl		DataChk	on		ENDP		eject;===============================================================================; alloc_p8_mem;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       none;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; Allocate all necessary memory for the Apple //e program environment.; The segments are allocated with a $32xx segment ID.;; Specifically the memory allocated is:;; Bank $00 : $0800-$bfff ; All //e memory allocatable via memory manager.; Bank $01 : $0800-$bfff ; All //e memory allocatable via memory manager.; Bank $e0 : $2000-$5fff ; Hi-res pgs 1 & 2.; Bank $e1 : $2000-$9fff ; Hi-res pgs 1 & 2, Super Hi-res.;===============================================================================alloc_p8_mem 	PROC		longa	on		longi	on		lda	#$b800		; From $0800-$0BFFF		ldx	#$0800		; Starting at $800		ldy	#$0000		; Bank $00		jsr	alloc_os_mem		bcs	done		; Branch if error.		lda	#$b800		; From $0800-$0BFFF		ldx	#$0800		; Starting at $800.		ldy	#$0001		; Bank $01.		jsr	alloc_os_mem		bcs	done		; Branch if error.		lda	#$4000		; From $2000-$5FFF		ldx	#$2000		; Starting at $2000		ldy	#$00e0		; Bank $E0.		jsr	alloc_os_mem		bcs	done		; Branch if error.		lda	#$8000		; From $2000-$9FFF		ldx	#$2000		; Starting at $2000		ldy	#$00e1		; Bank $E1.		jsr	alloc_os_memdone		rts			; Carry set if error, clear if no error.		ENDP		eject;===============================================================================; alloc_os_mem;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.;; Inputs:       A - # of bytes to allocate.;               X - Lo word of start address of segment.;               Y - Hi word of start address of segment.;               e1_os_mem_id - contains the ID used by GLDR and GQuit when;                              allocating reserved memory segments for GS/OS and P8.;; Outputs:      c - 0 if no error; 1 if error.;               A - error code if c=1;               X - Low word of handle to allocated segment.;               Y - High word of handle.;; This routine is used to allocate reserved memory segments for GS/OS and P8.; The segments are allocated with the attributes - locked, fixed, not purgable,;   can't cross bank boundary, may use special memory, fixed address, fixed bank.; The segments are allocated with a $32xx segment ID.; This routine only allows a 2 byte segment size.;===============================================================================alloc_os_mem	PROC		longa	on		longi	on		pha			; Reserve space for Handle result.		pha		pea	0		; Hi word of seg size.		pha			; Low word of seg size (input).		lda	>e1_os_mem_id	; segment id		pha		pea	mm_attrib	; Seg attributes word.		phy			; Hi  word of seg location (input)		phx			; Low word of seg location (input)		_newhandle		plx			; Pull Handle to the memory segment,		ply			; saving it in X and Y.		rts		ENDP		eject;===============================================================================; alloc_storage;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       e1_storage_id - contains the ID used by GQuit when;                               allocating storage space for GS/OS.;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; Allocate segments to store GS/OS in while ProDOS 8 is running.; The segments are allocated with a $32xx segment ID.;===============================================================================alloc_storage 	PROC		DataChk	off		longa	on		longi	on		ldx	#0loop		lda	|e1_gsos_segs,x		bmi	done		pha			; space for handle result		pha		pea	0		; hi word of seg size		lda	|e1_gsos_segs+6,x ; lo word of seg size		pha		lda	|e1_storage_id		pha		pea	storage_attrib	; seg attributes word		lda	#0		pha			; hi word of seg location		pha			; lo word of seg location		stx	|e1_word_temp		_newhandle		bcs	error		ldx	|e1_word_temp		pla			; pull handle to the memory segment		sta	|e1_gsos_segs+8,x ; and save		pla		sta	|e1_gsos_segs+10,x		txa		adc	#12		tax		bra	looperror		plx			;clean up stack		plxdone		rts		DataChk	off		ENDP		eject;===============================================================================; alloc_user_zp;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is preserved.; Direct register is set to the user's zero page on exit.;; Inputs:       e1_zp_start - start address of user's zero page; 0 if none allocated;               e1_zp_size - size of user's zero page; 0 if none allocated;; Outputs:      c - 0 if no error ; 1 if error.;               A - starting address of user's stack if c=0; else error code if c=1;               e1_zp_start - start address of user's zero page;               e1_zp_size - size of user's zero page;               e1_zp_handle - handle to user's zero page; 0 if allocated by loader;; Notes:        This routine alters the direct page register.;		Must return with an RTL since called from GLDR and E0 code.;; This routine sets up the user's Direct register and sets A to the start; of the user's stack.  If the loader has allocated the user's zero page; segment, then this routine uses the values returned by the loader.  Otherwise,; it will allocate a zero page segment with the following attributes:; locked, fixed memory, purge level of 1, no bank crossing, may use special; memory, page aligned, not fixed address, fixed bank.; The segment size will be 4K.;===============================================================================alloc_user_zp	PROC		DataChk	off		longa	on		longi	on		phb			; save data bank register		pea	$e1e1		; set data bank register to bank $E1		plb		plb;determine if loader allocated user's zero page		lda	|e1_zp_start	; did loader allocate user's zero page?		bne	set_d_reg	; yes;allocate a zero page segment for user		pha			; Reserve space for Handle result.		pha		ldx	#$0000		phx			; Hi word of seg size. ($0000)		lda	#zp_size	; Default zero page size		pha		sta	|e1_zp_size	; Save zero page size for later		lda	|e1_user_id	; Use user's ID for his zero page segment		pha		pea	zp_attrib	; Seg attributes word.		phx			; Address of segment to be		phx			; somewhere in bank 0. (X still 0)		_newhandle		tay			; save error code		tsc			; move our direct page to stack so we		tcd			; can dereference the handle		lda	[<1]		; get address of user's zero page - only lo		sta	|e1_zp_start	; word since it's a bank 0 address.		pla			; pull Handle to the memory segment		sta	|e1_zp_handle	; and save		pla		sta	|e1_zp_handle+2		tya			; Restore error code.		bcs	exit		lda	|e1_zp_start	; retrieve start address of user's zero page;set D register to user's zero page;set A register to user's stackset_d_reg	tcd			; set Direct register		clc			; then add zero page size to set stack		adc	|e1_zp_size	; A now equals user's S + 1.		dec	a		; Adjust for proper S value.exit		plb			; restore data bank register		rtl		DataChk	on		ENDP		eject;===============================================================================; id_routines;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Each entry in the id_stack consists of 4 bytes.  They are used as follows -;   Byte 0 is the lo byte of the current id;   Byte 1 is the hi byte of the current id;   Byte 2 is the lo byte of the quit flag;   Byte 3 is the hi byte of the quit flag;===============================================================================id_routines	PROC		DataChk	off		longa	on		longi	on;-------------------------------------------------------------------------------; push_id;; Inputs:       none;; Outputs:      c - 1 if stack full, else 0;               A - error code if c=1;-------------------------------------------------------------------------------		EXPORT	push_idpush_id		ldx	|e1_id_stack_index ;get index to id_stack		cpx	#id_stack_size	;are we at the end?		bcs	push_id0	;yes		lda	>newvideo	;get current screen state		and	#%10000000	;only need SHR status		xba			;put into high byte of accumulator		ora	|e1_current_id	;combine with current id		sta	|e1_id_stack,x	;save it		inx		inx		lda	|e1_quit_flags	;get quit flags		sta	|e1_id_stack,x	;save it		inx		inx		bra	pnp_outpush_id0	lda	#stack_overflow	;id stack full error		rts			;return with carry set;-------------------------------------------------------------------------------; pop_id;; Inputs:       none;; Outputs:      c - 1 if stack was empty, else 0;-------------------------------------------------------------------------------		EXPORT	pop_idpop_id		lda	|e1_id_stack_index ;Get index to ID Stack		beq	empty_stack	;ID stack is empty		lda	#$b3		sta	|e1_load_type	;set the load type		ldx	|e1_id_stack_index ;get index to id stack		dex		dex		dex		dex		lda	|e1_id_stack,x	;get id		sta	|e1_open_id	;save previous idpnp_out		stx	|e1_id_stack_index ;update the index to id stack		clc			;indicate no error		rtsempty_stack	sec			;indicate error		rts;-------------------------------------------------------------------------------; check_id_stack;; Inputs:       e1_open_id - ID to check for;; Outputs:      c - 1 if ID on stack, else 0;; This routine will search the ID stack to see if the ID for the program; we are launching is already on the stack.;-------------------------------------------------------------------------------		EXPORT	check_id_stackcheck_id_stack		ldx	|e1_id_stack_index ;get index to id_stackcheck_loop		dex			;point to next record		dex		dex		dex		bpl	check_it		clc			;if done with stack, return carry clear		rtscheck_it	lda	|e1_id_stack,x	;get the user id		asl	a		;clear SHR bit		lsr	a		cmp	|e1_open_id	;does it match?		bne	check_loop	;no		sec			;yes - so return carry set		rts		DataChk	on		ENDP		eject;===============================================================================; gsos_nonfatal;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.;; Inputs:       X - message #;; Outputs:      A - return value of selected button;; Notes:        This routine may not return.;		This routine assumes that a button return value of 0;		always corresponds to a "Restart" button.;; Generate a non-fatal error while running under GS/OS.; If the message displayed contains a "Restart" button and the user selects it,; this routine will call SCM to restart the system.  Otherwise, this routine will; return the value of the selected button.;===============================================================================gsos_nonfatal	PROC		Import	shutdown_reboot		longa	on		longi	on		phx			;message #		lda	#0		pha			;ptr to substitution string 1 (unused)		phacall_scm		pha			;ptr to substitution string 2 (unused)		pha		jsl	report_error	;put up non-fatal error message		bne	return		;A=0 if 'Restart' button selected		jmp	>shutdown_reboot;call SCM to restart the systemreturn		rts			;A = return value of selected button		entry	gsos_nonfatal2gsos_nonfatal2		DataChk	Off		Import	e1_errBuf,e1_errStr		pha			;put error number on stack		pea	e1_errBuf>>16	;buffer address		pea	e1_errBuf		pea	4		;buffer length		ldx	#$220B		;Int2Hex call		jsl	$E10000				pea	#52		;message #		pea	e1_errStr>>16	;subsititution string pointer		pea	e1_errStr		lda	#0		;borrow remainder of code		bra	call_scm		DataChk	On		ENDP		eject;===============================================================================; gsos_fatal_err; gsos_fatal_err2;; Entry is in 16-bit native mode.; Data bank register is unknown.;; Inputs:       A - error code;		X - message # (on entry to gsos_fatal_err2);; Outputs:      none;; Notes:        This routine does not return.;; Generate a fatal error while running under GS/OS.;===============================================================================gsos_fatal_err	PROC		longa	on		longi	on		ldx	#quit_err		EXPORT	gsos_fatal_err2gsos_fatal_err2		tay			;save error # in Y		lda	#stack_top	;set up correct stack		tcs		phy			;error #		phx			;message #		lda	#0		pha			;no substitution string		pha		jsl	report_fatal	;fatal error - no return		ENDP		eject;===============================================================================; p8_fatal_err; p8_fatal_err2;; Entry is in 16-bit native mode.; Data bank register is unknown.;; Inputs:       A - error code;; Outputs:      none;; Notes:        This routine does not return.;; Generate a fatal error using the System Failure Manager.;===============================================================================p8_fatal_err	PROC		longa	on		longi	on; Mask off high byte of error code since it may be garbage.		and	#$00ff; Push error code on stack as input to system death call.		EXPORT	p8_fatal_err2p8_fatal_err2		pha; Move our system death message out of the LC area to anywhere else before dying.		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	>e1_fatal_msg	;get length byte		taxfatal_loop	lda	>e1_fatal_msg,x		sta	>$002000,x		dex		bpl	fatal_loop		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****; Call the system death manager - doesn't return		pea	$0000		; Message pointer hi-word		pea	$2000		; Message pointer lo-word		_sysfailmgr		ENDP		EXPORT	e0_ende0_end		PROC		ENDP*********************************************************************************org_dummy_6	proc	org e0_obj_max, skip	;generate an error if E0 code		endp				;is too big*********************************************************************************		eject**********************************************************************************                                                                               **                               GQuit - E1 segment                              **                                                                               **                       Copyright Apple Computer, Inc. 1986-1993                **                                                                               **                               All Rights Reserved                             **                                                                               *******************************************************************************************************************************************************************		SEG	'seg_e1'org_dummy_7	proc	org e1_obj_pstn, noskip		endp*********************************************************************************		eject;===============================================================================; p8_mount_vol;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.;; Inputs:       A - error code;; Outputs:      A - error code (hi byte set to 0);               c - 0 if mount volume window put up and 'return' was pressed;                   1 if window not put up or if window put up and 'esc' pressed;; Notes:        Must exit with an RTL since called from bank 0 code.;; If the error code is volume_not_found ($45) or no disk in drive ($2F),; then put up a window asking the user to insert the needed volume.;===============================================================================p8_mount_vol	PROC		DataChk	off		longa	on		longi	on		ldy	#e1_app_volname>>16 ;set up ptr to volume name		ldx	#e1_app_volname; If the p8_mount_vol2 entry point is called, X and Y must already be set up.		EXPORT	p8_mount_vol2p8_mount_vol2; If error code is 'volume not found' or 'no disk in drive' then put up the; Mount Volume window, otherwise return with carry set.		and	#$00ff		;just in case		cmp	#vol_not_found		beq	cont		cmp	#drvr_off_line		beq	cont		sec			;indicate error not handled		rtl			;error code still in Acont		pha			;save error code in case ESC pressed		phy			;push ptr to volume name on stack		phx		tsc		phd			;save D reg		tcd			;point D reg at stack		lda	[<1]		;get length byte and leading separator		dec	a		;don't count leading separator		xba			;then swap the bytes so the volume name		sta	[<1]		;does not contain the separator		pha			; Room for result		pea	e1_mount_msg>>16		pea	e1_mount_msg		phy			; hi word of ptr to volume name		inx			; skip separator		phx			; lo word of ptr to volume name		pea	e1_btn1_label>>16 ; 'Return'		pea	e1_btn1_label		pea	e1_btn2_label>>16 ; 'Escape'		pea	e1_btn2_label		_TLTextMountVolume		lda	[<1]		;restore first 2 bytes of volume name		xba			;back to their original positions		inc	a		;and values		sta	[<1]		pla			;Which button: 1=Return, 2=Escape		pld			;restore D reg		plx			;pull volume name ptr off stack		plx		cmp	#1		;which button was pressed?		bne	escape_pressed		clc			;indicate Return was pressed		pla			;pull original error code off stack		rtl			;return with carry clearescape_pressed	sec			;Indicate Escape was pressed		pla			;restore error code		rtl			;return with carry set		DataChk	on		ENDP		eject;===============================================================================; p8_prefix_err;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.;; Inputs:       A - error code;               e1_prefix_buf - contains the prefix being used to set ProDOS 8's;                               prefix;; Outputs:      X - lo word of ptr to volume name;               Y - hi word of ptr to volume name;               A - error code;; Notes:        This routine jumps into the p8_mount_vol routine at the entry;               point p8_mount_vol2.  Control does not return to this routine.;; An error occurred while trying to set ProDOS 8's prefix.  So we need to; set up X and Y to point to the correct volume name so that the 'mount volume'; message will have the correct volume name.;===============================================================================p8_prefix_err	PROC		DataChk	off		longa	on		longi	on		pha			;save error code;adjust length of e1_prefix_buf to only contain the length of the volume name;since the prefix may be a pathname		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		ldx	#1		;skip leading slashloop		txa		cmp	>e1_prefix_buf	;at end of string?		beq	done		;yes		inx		lda	>e1_prefix_buf,x		cmp	#'/'		bne	loop		;loop until find a slash		dex			;don't count slash		txa		sta	>e1_prefix_buf	;store new length bytedone		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****		ldy	#e1_prefix_buf>>16 ;set up ptr to volume name		ldx	#e1_prefix_buf		pla			;retrieve error code		jmp	>p8_mount_vol2	;put up the mount volume message		DataChk	on		ENDP		eject;===============================================================================; get_stacked_id;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.; Direct register is unknown.;; Inputs:       none;; Outputs:      A - ID of next item on ID stack, 0 if stack empty;; Notes:        Must return with an RTL since called from SCM.;; This routine returns the ID of the next item on the ID stack.; If the ID stack is empty, it returns 0.; This routine is called by SCM in response to a system service call.;===============================================================================		EXPORT	get_stacked_idget_stacked_id	PROC		longa	on		longi	on		lda	>e1_id_stack_index ;get current stack index		beq	done		;0 if stack is empty		dec	a		;adjust index to point to		dec	a		;next ID on stack		dec	a		dec	a		tax		lda	>e1_id_stack,x	;get the IDdone		rtl		ENDP		eject;===============================================================================; rename_bootvol;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.; Direct register is preserved.;; Inputs:       X - lo word of pointer to string;               Y - hi word of pointer to string;; Outputs:      c - 0 if no error ; 1 if error;               A - error code if c=1;; Notes:        Must return with an RTL since called from SCM.;; Called by SCM when the boot volume has been renamed.; The string containing the new boot volume name is in class 1 format and has; a leading colon but not an ending colon.;===============================================================================		EXPORT	rename_bootvolrename_bootvol	PROCstring_ptr	equ	3		;offset into stack		phy			;push string pointer onto stack		phxldr_ok		phd			;save direct register		tsc			;set direct register to point to stack		tcd		lda	[<string_ptr]	;get length word		inc	a		;add 1 for extra length byte		tay		tax		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	offloop		lda	[<string_ptr],y	;copy new volume name into		sta	>e1_volname,x	;GQuit's data area		dey		dex		bpl	loop		;loop until done with string		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		pld			;restore direct register		pla			;clean up stack		pla		jsl	make_start_paths ;create the start program pathnames		rtl		ENDP		eject;===============================================================================; concat;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is preserved.; Direct register is preserved.;; Inputs:       SP+15 = 0 if class 0 strings, 1 if class 1 strings;               SP+11 = Address of String1;               SP+7  = Address of String2;               SP+3  = Address of String3 (result string);               SP+1  = Return address - 1 (From the JSL);; Outputs:      none;; Notes:        Any altered stack usage will alter stack equate values!;               Must return with an RTL since called from GLDR and B0 code.;; Concat will concatinate two strings and place the result in a third string.; The strings may be all class 0 strings or all class 1 strings.; String1 and String3 may be the same string.;===============================================================================concat		PROC; equates for direct register addressingclass		equ	19ptr1		equ	15ptr2		equ	11ptr3		equ	7		longa	on		longi	on		phb			; Save current bank.		pea	$e1e1		plb			; set data bank reg to bank $E1		plb		phd			; Save D. (Note stack indexing consequences!)		tsc			; Equate D to S for addressing access.		tcd		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	[<ptr2]		; get length of string2		tay			; save for later		clc		adc	[<ptr1]		; add to length of string1		sta	[<ptr3]		; to get length of string3		tax			; save length of string3 in X		lda	<class		; class 1 strings?		beq	class0		; no		iny			; yes - so add 1 for extra length byte		inxclass0copystr2	lda	[<ptr2],y	; first copy string2 into string3		phy			; save string2's index		txy			; get string3's index		sta	[<ptr3],y		tyx			; save string3's index		ply			; retrieve string2's index		dex		dey		cpy	<class		; stop at byte 0 if class 0 strings		bne	copystr2	; stop at byte 1 if class 1 strings		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****		lda	<ptr1		; if the ptr to string1 is the same		cmp	<ptr3		; as the ptr to string3 then don't		bne	not_equal	; bother copying string1 into string3		lda	<ptr1+2		; since they are the same string		cmp	<ptr3+2		; and the length byte has already		beq	copy_done	; been changednot_equal		longa	off		longi	off		sep	#$30		;***** begin 8-bit mode *****		lda	[<ptr1]		; get length of string1		tay		lda	<class		; class 1 strings?		beq	class00		; no		iny			; yes - so add 1 for extra length byteclass00copystr1	lda	[<ptr1],y	; now copy string1 into string3		phy			; save string1's index		txy			; get string3's index		sta	[<ptr3],y		tyx			; save string3's index		ply			; retrieve string1's index		dex		dey		bne	copystr1	; loop until done copying string1		longa	on		longi	on		rep	#$30		;***** return to 16-bit mode *****copy_done		pld			; Restore Direct reg. (Changes stack indexing!)		plb			; Restore caller's DBR.		lda	1,s		; Now move up the 3 byte return address...		sta	15,s		; to proper place in the stack.		lda	2,s		; We're forced to move the middle return byte twice..		sta	16,s		tsc			; Adjust stack up to spot below return adr.		clc		adc	#14		tcs			; Set S to proper return value.		rtl		ENDP		eject;===============================================================================; compare_string;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is preserved.; Direct register is preserved.;; Inputs:       4 bytes - pointer to string 1;               4 bytes - pointer to string 2;		3 bytes - return address;; Outputs:      c - 0 if strings match, 1 if strings don't match.;; Notes:	Must return with an RTL since called from GLDR and B0 code.;; This routine compares two class 1 strings to see if they are the same.; This routine does a case-insensitive compare.;===============================================================================compare_string	PROC		longa	on		longi	onstr1char	equ	1ptr2		equ	9ptr1		equ	13		phb			;save data bank register		phd			;save direct register		pha			;make space to store char		tsc		tcd			;set direct register to stack		lda	[<ptr1]		; Get length of string1.		cmp	[<ptr2]		; Is it the same length as string2?		bne	notsame		; no		inc	a		; add 1 for extra length byte		tay		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	offnextchar	lda	[<ptr1],y	; get char from string1		jsr	cvt_to_upper	; convert to upper case		sta	<str1char	; and save on stack		lda	[<ptr2],y	; get char from string2		jsr	cvt_to_upper	; convert to upper case		cmp	<str1char	; cmpare chars		bne	notsame		dey		bne	nextchar		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		clc			; Indicate that the strings matched		bra	donenotsame		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		sec			; Set carry denoting no matchdone		pla			; pull char storage off stack		pld			; restore direct register		plx			; pull B, RTN1 off stack		ply			; pull RTN2, RTN3 off stack		pla			; pull inputs off stack		pla		pla		pla		phy			; push RTN2, RTN3 back on stack		phx			; push B, RTN1 back on stack		plb			; restore data bank		rtl;-------------------------------------------------------------------------------; If the character in A is a lower-case alphabetic character then convert it; to upper-case.cvt_to_upper		longa	off		longi	off		cmp	#'a'		bcc	cvt_done		cmp	#'{'		bcs	cvt_done		sec		sbc	#$20cvt_done	rts		ENDP		eject;===============================================================================; slash_2_colon;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.; Direct register is preserved.;; Inputs:       X - lo word of pointer to string;               Y - hi word of pointer to string;; Outputs:      none;; Scans a class 1 string and converts all slashes (/) to colons (:).;===============================================================================slash_2_colon	PROCstring_ptr	equ	3		;offset into stack		phy			;push string pointer onto stack		phx		phd			;save direct register		tsc			;set direct register to point to stack		tcd		lda	[<string_ptr]	;get length word		beq	xlate_done	;quit if length is 0		tay		iny			;add 1 for extra length byte		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	offxlate_loop	lda	[<string_ptr],y	;get next character		cmp	#'/'		;is it a slash?		bne	xlate_cont	;no		lda	#':'		;yes - so replace it with a colon		sta	[<string_ptr],yxlate_cont	dey		bne	xlate_loop	;loop until done with string		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	onxlate_done		pld			;restore direct register		pla			;clean up stack		pla		rtl		ENDP		eject;===============================================================================; colon_2_slash;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.; Direct register is preserved.;; Inputs:       X - lo word of pointer to string;               Y - hi word of pointer to string;; Outputs:      none;; Scans a class 0 string and converts all colons (:) to slashes (/).;===============================================================================colon_2_slash	PROCstring_ptr	equ	3		;offset into stack		phy			;push string pointer onto stack		phx		phd			;save direct register		tsc			;set direct register to point to stack		tcd		sep	#$30		;***** begin 8-bit mode *****		longa	off		longi	off		lda	[<string_ptr]	;get length byte		beq	xlate_done	;quit if length is 0		tayxlate_loop	lda	[<string_ptr],y	;get next character		cmp	#':'		;is it a colon?		bne	xlate_cont	;no		lda	#'/'		;yes - so replace it with a slash		sta	[<string_ptr],yxlate_cont	dey		bne	xlate_loop	;loop until done with stringxlate_done		rep	#$30		;***** return to 16-bit mode *****		longa	on		longi	on		pld			;restore direct register		pla			;clean up stack		pla		rtl		ENDP		eject;===============================================================================; make_start_paths;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.; Direct register is unknown.;; Inputs:       e1_volname -  contains the name of the boot volume;                             in class 1 format;               e1_sys_filename - contains the filename of the start program;                                 in class 0 format;; Outputs:      e1_start_prog0 - contains the pathname of the start program;                                in class 0 format;               e1_start_prog1 - contains the pathname of the start program;                                in class 1 format;; Notes:        Must return with an RTL since called from GLDR and E0 code.;===============================================================================make_start_paths PROC		DataChk	off		longa	on		longi	on; first, convert e1_volname into class 0 format		lda	>e1_volname	; get length word		xba		sta	>e1_volname	; and swap bytes for class 0 format; now create a class 1 version of the start program pathname		pea	0		; indicate class 0 strings		pea	e1_volname>>16	; Push ptr to string1		pea	e1_volname+1		pea	e1_sys_filename>>16 ; Push ptr to string2		pea	e1_sys_filename		pea	e1_start_prog1>>16 ; Push ptr to resultant string		pea	e1_start_prog1+1		jsl	concat		lda	>e1_start_prog1	;get length of full pathname		and	#$ff00		xba			;swap bytes to make it a		sta	>e1_start_prog1	;class 1 length word; now create a class 0 version of the start program pathname		pea	0		; indicate class 0 strings		pea	e1_volname>>16	; Push ptr to string1		pea	e1_volname+1		pea	e1_sys_filename>>16 ; Push ptr to string2		pea	e1_sys_filename		pea	e1_start_prog0>>16 ; Push ptr to resultant string		pea	e1_start_prog0		jsl	concat; convert e1_volname back to class 1 format		lda	>e1_volname	; get length word		xba		sta	>e1_volname	; and swap bytes back to class 1 format; now scan the class 0 pathname and translate the colons into slashes		ldy	#e1_start_prog0>>16 ;get pointer to string in X and Y		ldx	#e1_start_prog0		jsl	colon_2_slash	;convert colons to slashes		rtl		DataChk	on		ENDP		eject;===============================================================================; init_text_tools;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       none;; Outputs:      none;; Notes:        The calling routine does not care if there are any errors when;               this routine is called so we don't check for any and save lots;               of bytes for missing bcs's.;; This routine is called before P16 applications are launched so they; can immediately utilize character I/O.;; Moved to bank $E1 to make a little room in bank $E0, 02/17/91, GAB.;;===============================================================================init_text_tools	PROC		longa	on		longi	on; Make the following Text Tool Set calls -; SetInGlobals ($090c), SetOutGlobals ($0a0c), SetErrGlobals ($0b0c); These calls set the 'global AND mask' and the 'global OR mask' for the; input device, the output device and the error output device.		ldx	#$090cloop1		phx			;save counter for later		pea	$00ff		;global AND mask for device		pea	$0080		;global OR mask for device		jsl	>dispatch1		clc		pla			;get counter		adc	#$0100		tax		cmp	#$0c0c		bcc	loop1		;do until carry set; Make the following Text Tool Set calls -; SetInputDevice ($0f0c), SetOutputDevice ($100c), SetErrorDevice ($110c); These calls set the input device, the output device and the error output; device to a Pascal type device in slot 3.		ldx	#$0f0cloop2		phx			;save counter for later		pea	$0001		;pascal device type		pea	$0000		pea	$0003		;slot 3		jsl	>dispatch1		clc		pla			;get counter		adc	#$0100		tax		cmp	#$120c		bcc	loop2		;do until carry set; Make the following Text Tool Set call -; InitTextDev ($150c) to initialize the input device ($0000), the error output; device ($0001) and the output device ($0002); Note - only do this if slot 3 is set internal		lda	>rdc3rom	;slot 3 status is in bit 7		xba			;swap bytes so bit 7 is now in bit 15		bmi	done		;branch if slot 3 is set external		lda	#$0002loop3		pha			;save counter for later		pha			;pretend like pea instruction		ldx	#$150c		;init it		jsl	>dispatch1		pla			;get counter		dec	a		bne	loop3		;do until 0done		rtl		ENDP		eject;===============================================================================; call_launcher;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       none;; Outputs:      pointer to pathname in path1_ptr;		UserID of Launcher in X;;; This routine is called when there is no application ID on the quit; stack to return to.  Instead of simply launching the start application; again, the old Program Launcher will be presented to the user to allow; her to select the next application to launch.;;===============================================================================call_launcher	PROC		DataChk	offnew_userID	equ	1handle		equ	3		tsc			;make local direct page		sec		sbc	#6		;need 6 bytes of local storage		tcs		phd		tcd		pha			;result space		pea	$3000		;use GS/OS id type		ldx	#$2003		;GetNewID		jsl	$E10000		lda	1,s		;retrieve new ID, but leave on stack		sta	new_userID		ldx	#$021e		;ResourceStartup call		jsl	$E10000				pha			;result space		pha		ldx	#$3403		;GetCodeResConverter		jsl	$E10000		; leave proc pointer on stack for following call		pea	$8017		;rCodeResource		pea	1		;logFlags		ldx	#$281e		;ResourceConverter		jsl	$E10000		lda	>sys_prefs	;get preferences flag		pha			;save for a bit		lda	#$C000		;set to show mount dialog w/o cancel button		sta	>sys_prefs		pha			;result space		pha		pea	$8017		;rCodeResource		pea	$07ff		;resource id ($07ff0001)		pea	$0001		ldx	#$0e1e		;LoadResource		jsl	$E10000		plx			;retrieve handle		stx	handle		plx		stx	handle+2		plx			;retrieve old sysPrefs		bcc	@loaded_ok	;no error, continue		jmp	>p8_fatal_err2@loaded_ok		txa		sta	>sys_prefs	;restore system preferences		ldy	#1		lda	[handle],y	;deref the returned handle		sta	>vector+2	;store the address (self modifying code)		lda	[handle]		sta	>vector+1vector		jsl	>$000000	;address is self-modified; deref the returned handle		tya			;high word into Acc		phb			;save DBR		xba		pha		plb		plb			;set DBR to bank of Handle		lda	|0,x		;address of Pointer		ldy	|2,x		;bank of Pointer		plb			;restore DBR		clc			;adjust past buffer length word		adc	#2		bcc	@1		iny@1		phy			;save pointer on stack		pha		pea	3		;purge level		pea	$8017		;rCodeResource		pea	$07ff		;resource id		pea	$0001		ldx	#$171e		;ReleaseResource		jsl	$E10000		ldx	#$031E		;ResourceShutdown		jsl	$E10000		pla			;retrieve pathname pointer		ply		ldx	new_userID	;return userID		pld			;restore original direct page		sta	<path1_ptr	;store the pointer		sty	<path1_ptr+2		pla			;clean up stack		pla		pla		rtl			;back to get_next_prog		EndP		eject;===============================================================================; dispose_os_mem;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       e1_os_mem_id - contains the ID used by GLDR and GQuit when;                              allocating reserved memory segments.;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; Disposes of all memory segments which were allocated using the segment ID; e1_os_mem_id.;===============================================================================dispose_os_mem	PROC		DataChk	off		longa	on		longi	on		lda	|e1_os_mem_id		bra	do_dispose		eject;===============================================================================; dispose_storage;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       e1_storage_id - contains the ID used by GQuit when;                               allocating storage space for GS/OS.;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; Disposes of all memory segments which were allocated using the segment ID; e1_storage_id.;===============================================================================		Entry	dispose_storagedispose_storage		longa	on		longi	on		lda	|e1_storage_iddo_dispose		pha		_DisposAll		rtl		DataChk	on		ENDP		eject;===============================================================================; dispose_user_zp;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is unknown.;; Inputs:       e1_zp_handle - contains the handle to the zero page;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; Notes:	Must return with an RTL since called from GLDR and E0 code.;; This routine checks to see if GQuit allocated the zero page segment and if so; it disposes of it.;===============================================================================dispose_user_zp	PROC		longa	on		longi	on		lda	>e1_zp_handle+2	; Put handle on the stack first then		pha			; see if it's nil		lda	>e1_zp_handle		pha		ora	3,s		beq	its_nil		_DisposeHandle		;wasn't nil so dispose it		tax			;save error temporarily		lda	#0		sta	>e1_zp_Handle	;set handle to nil		sta	>e1_zp_Handle+2		txa			;retrieve error code		rtl		eject;===============================================================================; dispose_path;; Entry is in 16-bit native mode.; Exit is in 16-bit native mode.; Data bank register is set to bank $E1 on entry and exit.;; Inputs:       e1_path_hndl - contains the handle to the pathname copy;; Outputs:      c - 0 if no error, 1 if error;               A - error code if c=1;; This routine checks to see if a copy of the Quit pathname was made and if so; it disposes of the memory which was allocated to hold the copy.;===============================================================================		entry	dispose_pathdispose_path		longa	on		longi	on		lda	|e1_path_hndl+2	;put handle on stack first then		pha			;see if it's nil		lda	|e1_path_hndl		pha		ora	3,s		beq	its_nil		_DisposeHandle		;wasn't nil so dispose it		rtlits_nil					;nothing to do so clean up stack		pla		pla		clc			;indicate no error		rtl		ENDP		eject;===============================================================================;; e1_data;;===============================================================================e1_data		PROC;-------------------------------------------------------------------------------; Tables;-------------------------------------------------------------------------------		EXPORT	e1_gsos_segse1_gsos_segs		DC.W	0		;language card bank (0/1)		DC.L	$00D000		;starting address		DC.W	$3000		;size in bytes		DC.L	0		;handle to storage area		DC.W	1		;language card bank (0/1)		DC.L	$00D000		;starting address		DC.W	$1000		;size in bytes		DC.L	0		;handle to storage area		DC.W	0		;language card bank (0/1)		DC.L	$01D000		;starting address		DC.W	$3000		;size in bytes		DC.L	0		;handle to storage area		DC.W	1		;language card bank (0/1)		DC.L	$01D000		;starting address		DC.W	$1000		;size in bytes		DC.L	0		;handle to storage area		EXPORT	e1_gsos_segs2e1_gsos_segs2; SCM's bank 0 memory		DC.W	0		;language card bank (0/1)		dc.l	SCM_Start	;starting address		dc.w	$C000-SCM_Start	;size in bytes		DC.L	0		;handle to storage area; 1K for use by AppleDisk 3.5 driver Scatter Read routines		DC.W	0		;language card bank (0/1)		DC.L	$01BC00		;starting address		DC.W	$0400		;size in bytes		DC.L	0		;handle to storage area; for use by System Loader		DC.W	0		;language card bank (0/1)		dc.l	Loader_Entry	;starting address		dc.w	$1BC00-Loader_Entry	;size		DC.L	0		;handle to storage area		DC.W	$ffff		;terminator;-------------------------------------------------------------------------------; GS/OS parameter lists;-------------------------------------------------------------------------------		EXPORT	e1_setpfx0_parmse1_setpfx0_parms			;SetPrefix 0 - class 0 parameter list		DC.W	0		;set prefix 0/		DC.L	e1_prefix_buf	;ptr to prefix		EXPORT	e1_gbv_parmse1_gbv_parms				;GetBootVol - class 0 parameter list		DC.L	e1_prefix_buf	;ptr to prefix buffer		EXPORT	e1_getpfx_parms1		EXPORT	e1_getpfx_nume1_getpfx_parms1			;GetPrefix - class 1 parameter list		DC.W	2		;parameter counte1_getpfx_num	DS.B	2		;prefix #		DC.L	e1_prefix_buf1	;ptr to prefix buffer		EXPORT	e1_setpfx_parms1		EXPORT	e1_setpfx_num		EXPORT	e1_setpfx_ptre1_setpfx_parms1			;SetPrefix - class 1 parameter list		DC.W	2		;parameter counte1_setpfx_num	DS.B	2		;prefix #e1_setpfx_ptr	DS.B	4		;ptr to prefix		EXPORT	e1_setpfx2_parms1e1_setpfx2_parms1			;SetPrefix 2 - class 1 parameter list		DC.W	2		;parameter count		DC.W	2		;set prefix 2/		DC.L	e1_lib_path	;ptr to prefix		EXPORT	e1_open_parms1		EXPORT	e1_open_ref		EXPORT	e1_open_pathe1_open_parms1				;Open - class 1 parameter list		DC.W	3		;parameter counte1_open_ref	DS.B	2		;reference numbere1_open_path	DC.L	e1_p8_path	;pointer to pathname		DC.W	1		;read access		EXPORT	e1_close_parms1		EXPORT	e1_close_refe1_close_parms1				;Close - class 1 parameter list		DC.W	1		;parameter counte1_close_ref	DS.B	2		;reference number		EXPORT	e1_read_parms1		EXPORT	e1_read_ref		EXPORT	e1_read_buf		EXPORT	e1_read_counte1_read_parms1				;Read - class 1 parameter list		DC.W	4		;parameter counte1_read_ref	DS.B	2		;reference number.e1_read_buf	DC.L	$2000		;pointer to read buffer.e1_read_count	DS.B	4		;number of bytes to read.		DS.B	4		;unused		EXPORT	e1_geof_parms1		EXPORT	e1_geof_ref		EXPORT	e1_geof_eofe1_geof_parms1				;GetEOF - class 1 parameter list		DC.W	2		;parameter counte1_geof_ref	DS.B	2		;reference numbere1_geof_eof	DS.B	4		;eof		EXPORT	e1_gfi_parms1		EXPORT	e1_gfi_ptr		EXPORT	e1_gfi_ftype		EXPORT	e1_gfi_atype		EXPORT	e1_gfi_eofe1_gfi_parms1				;GetFileInfo - class 1 parameter list		DC.W	9		;parameter counte1_gfi_ptr	DS.B	4		;ptr to pathname		DS.B	2		;accesse1_gfi_ftype	DS.B	2		;filetypee1_gfi_atype	DS.B	4		;auxtype		DS.B	18		;unused fields		dc.l	e1_option_liste1_gfi_eof	DS.B	4		;eof		Export	e1_fst_ide1_option_list	dc.w	48		;option list total size		ds.w	1		;space for returned sizee1_fst_id	ds.w	1		;space for returned FST ID		ds.b	44		;remainder of option list		EXPORT	e1_sess_parms1e1_sess_parms1				;EndSession - class 1 parameter list		DC.W	0		;parameter count		EXPORT	e1_gdn_parms1		EXPORT	e1_gdn_ptr		EXPORT	e1_gdn_dnume1_gdn_parms1				;GetDevNumber - class 1 parameter list		DC.W	2		;parameter counte1_gdn_ptr	DS.B	4		;ptr to volume namee1_gdn_dnum	DS.B	2		;device number		EXPORT	e1_volume_parms1		EXPORT	e1_volume_ptr		EXPORT	e1_volume_ide1_volume_parms1			;Volume - class 1 parameter list		DC.W	5		;parameter counte1_volume_ptr	DC.L	0		;ptr to device name (initialize to 0)		DC.L	e1_prefix_buf1	;ptr to volume name - unused		DS.B	4		;total blocks - unused		DS.B	4		;free blocks - unusede1_volume_id	DS.B	2		;file system ID		EXPORT	e1_fst_parms1		EXPORT	e1_fst_ptre1_fst_parms1				;FST Specific - class 1 parameter list		DC.W	3		;parameter count		DC.W	appleshare_id	;fst #		DC.W	8		;command #e1_fst_ptr	DS.B	4		;ptr to pathname;-------------------------------------------------------------------------------; general storage;-------------------------------------------------------------------------------		EXPORT	e1_word_tempe1_word_temp	DS.B	2		;scratch word		EXPORT	e1_os_mem_ide1_os_mem_id	DS.B	2		;ID assigned to GS/OS and P8 reserved memory		EXPORT	e1_storage_ide1_storage_id	DS.B	2		;ID assigned to GS/OS storage		EXPORT	e1_p8copy_ide1_p8copy_id	DS.B	2		;ID assigned to copy of P8		EXPORT	e1_p8copy_hndle1_p8copy_hndl	DS.B	4		;handle to copy of P8		EXPORT	e1_p8copy_ptre1_p8copy_ptr	DS.B	4		;pointer to copy of P8		EXPORT	e1_p8copy_sizee1_p8copy_size	DS.B	4		;size of copy of P8		EXPORT	e1_p8copy_flage1_p8copy_flag	DC.W	$ffff		;$ffff-no hndl;0-purged hndl;1-valid hndl		EXPORT	e1_path_ide1_path_id	DS.B	2		;ID assigned to Quit pathname data area		EXPORT	e1_path_hndle1_path_hndl	DS.B	4		;handle to pathname data area		EXPORT	e1_path_ptre1_path_ptr	DS.B	4		;ptr to pathname of program to launch		EXPORT	e1_path_lene1_path_len	DS.B	2		;length of partial path of program to launch		EXPORT	e1_drvr_ide1_drvr_id	DC.W	0		;ID assigned to boot driver (init to 0)		EXPORT	e1_user_ide1_user_id	DS.B	2		;user's segment ID		EXPORT	e1_current_ide1_current_id	DS.B	2		;ID of S16 prog that called QUIT		EXPORT	e1_open_ide1_open_id	DS.B	2		;ID of S16 prog to be launched		EXPORT	e1_quit_prefixe1_quit_prefix	DS.B	2		;prefix # from QUIT pathname parameter		EXPORT	e1_quit_flagse1_quit_flags	DS.B	2		;flags from P16 QUIT parameters		EXPORT	e1_current_ose1_current_os	DS.B	2		;$8000=ProDOS 8,  $0000=GS/OS		EXPORT	e1_load_typee1_load_type	DS.B	2		;$00FF=SYS prog,  $00B3=S16 prog		EXPORT	e1_aux_typee1_aux_type	DS.B	2		;aux type of S16 prog to be launched		EXPORT	e1_start_flage1_start_flag	DS.B	2		;1 if relaunching start prog, 0 if not		EXPORT	e1_full_pathe1_full_path	DS.B	2		;1 if using full pathname, 0 if partial		EXPORT	e1_applesharee1_appleshare	DC.W	0		;<>0 if AppleShare FST loaded, 0 if not		EXPORT	e1_no_storagee1_no_storage	DS.B	2		;0 if GS/OS storage allocated, 1 if not		EXPORT	e1_OS_switche1_OS_switch	DC.W	0		;1 if switching operating systems, 0 if not		EXPORT	e1_mslote1_mslot	DS.B	2		;boot slot #		EXPORT	e1_c3_statuse1_c3_status	DS.B	2		;slot 3 rom status		EXPORT	e1_besce1_besc		DS.B	2		;bit encoded slot configuration		EXPORT	e1_zp_handlee1_zp_handle	DC.L	0		;handle to user's zp segment (init to 0)		EXPORT	e1_zp_starte1_zp_start	DS.B	2		;address of start of user's zp segment		EXPORT	e1_zp_sizee1_zp_size	DS.B	2		;size of user's zp segment		EXPORT	e1_id_stack_indexe1_id_stack_index DC.W	0		;ID stack pointer (init to 0)		EXPORT	e1_id_stacke1_id_stack	DS.B	64		;IDs of programs to return to; The following 8 bytes are used for storing the load addresses of the two QuickDraw patches; which are contained at the front of the error messages file.		EXPORT	e1_patch1_adre1_patch1_adr	DC.L	0		EXPORT	e1_patch2_adre1_patch2_adr	DC.L	0; The following word is accessed by the report_fatal routine in SCM to determine; if GS/OS should be shutdown before the system is reset.		EXPORT	e1_gsos_oke1_gsos_ok	DC.W	0		;1 if GS/OS is up and running, 0 if not; The following 4 bytes are used for storing the load address of the file; */SYSTEM/GS.OS.DEV		EXPORT	e1_dev_addresse1_dev_address	DS.B	4; The following 4 bytes are used for storing the load address of the file; */SYSTEM/DRIVERS/BOOT.DRIVER		EXPORT	e1_drvr_addresse1_drvr_address	DC.L	0		;initialized to nil; The following 4 bytes are used for storing the load address of the file; */SYSTEM/ERROR.MSG		EXPORT	e1_msg_addresse1_msg_address	DS.B	4		;accessed by SCM; The following bytes are used for storing the name of the boot volume; in class 1 format beginning with a colon.		EXPORT	e1_volnamee1_volname	DS.B	35		;accessed by SCM; The following bytes are used for storing the application's filename; in class 0 format with no separators.		EXPORT	e1_app_filenamee1_app_filename	DS.B	33		;accessed by SCM; The following bytes are used for storing the application's volume name or the; boot volume name in class 0 format for the P8 'mount volume' window.		EXPORT	e1_app_volnamee1_app_volname	DS.B	35;Class 0 string containing the pathname of the start program.;Maximum length of pathname is 67 bytes as follows - length (1 byte),;slash (1 byte), volume name (32 bytes), slash (1 byte), filename (32 bytes)		EXPORT	e1_start_prog0e1_start_prog0	DS.B	67;Class 1 string containing the pathname of the start program.;Maximum length of pathname is 68 bytes as follows - length (2 bytes), separator;(1 byte), volume name (32 bytes), separator (1 byte), filename (32 bytes)		EXPORT	e1_start_prog1e1_start_prog1	DS.B	68; The following bytes are used for storing the pathname specified in a P8; Quit call.  We need 67 bytes since the pathname may be converted to class 1.		EXPORT	e1_p8quit_pathe1_p8quit_path	DS.B	67; The following bytes are used for storing a prefix which came from P8; or which will be used to set P8's prefix.; The first 2 bytes are for the buffer size when making a class 1 GetPrefix; call.  The next 67 bytes are used for - length (2 bytes),; prefix (64 bytes - the P8 maximum), trailing slash (1 byte).		EXPORT	e1_prefix_buf1e1_prefix_buf1	DC.W	69		;size header for class 1 output string		EXPORT	e1_prefix_bufe1_prefix_buf	DS.B	67		;must follow e1_prefix_buf1; The following bytes are used when setting prefix 1 to a null string; and when making a Volume call		EXPORT	e1_null_stre1_null_str	DC.W	0		;a null string; The following bytes are used for temporarily saving bank $00 data when making; ProDOS 8 calls from the get_info_sub routine		EXPORT	e1_bank0_savee1_bank0_save	DS.B	bank0_area_used; This buffer is used for Int2Hex calls.		Entry	e1_errStr,e1_errBufe1_errStr	dc.b	4		;length byte (always 4 characters)e1_errBuf	ds.b	4		;space for hex digits		ENDP		eject;===============================================================================;; e1_strings;;===============================================================================e1_strings	PROC		EXPORT	e1_sys_filename		EXPORT	e1_p8_path		EXPORT	e1_lib_path		EXPORT	e1_cons_path		EXPORT	e1_fatal_msg		EXPORT	e1_mount_msg		EXPORT	e1_btn1_label		EXPORT	e1_btn2_labele1_sys_filename	DC.B	13		;class 0 string		DC.B	':SYSTEM:START'		DS.B	20		;extra space needed for 32 char namee1_p8_path	DC.W	11		;class 1 string		DC.B	'*:SYSTEM:P8'e1_lib_path	DC.W	13		;class 1 string		DC.B	'*:SYSTEM:LIBS'e1_cons_path	DC.W	8		;class 1 string		DC.B	'.CONSOLE';-------------------------------------------------------------------------------; Message for P8_Fatal_Error routine;-------------------------------------------------------------------------------; The maximum length of this message is 35 characters.; (The error code will be displayed immediately following the final character.)e1_fatal_msg	DC.B	35		; Length byte		DC.B	'Can'		DC.B	$27		DC.B	't run next application. Error=$';-------------------------------------------------------------------------------; Messages for P8_Mount_Vol routine;-------------------------------------------------------------------------------; The maximum length of this message is 35 characters.; The button labels must not be more than 16 characters.e1_mount_msg	str	'Please insert the disk:'e1_btn1_label	DC.B	13		DC.B	'Accept: '		DC.B	$1b		;Basic turn mousetext on code		DC.B	$0f		;Basic turn inverse mode on		DC.B	$4d		;Mousetest return character		DC.B	$0e		;Basic turn normal mode on		DC.B	$18		;Basic turn mousetext off codee1_btn2_label	str	'Cancel: Esc'		ENDP		EXPORT	e1_ende1_end		PROC		ENDP*********************************************************************************org_dummy_8	proc	org e1_obj_max, skip	;generate an error if E1 code		endp				;is too big*********************************************************************************		END