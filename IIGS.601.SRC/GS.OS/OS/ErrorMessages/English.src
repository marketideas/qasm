		title	'Error Message File--English Version';===============================================================================; Error	message	file.  English version.;; Copyright Apple Computer, Inc. 1988,1989.  All rights reserved.;===============================================================================;;  Modification	history:;;  01-Feb-88	all	Initial	release;  15-Feb-88	ADS	strings	added for text mode init pack;  24-Feb-88	ADS	string 28 added;  08-Mar-88	JJ	Modified volume	mount message to conform to standard;			user interface conventions.;  31-Mar-88	JJ	Make changes to	support	latest definition of;			AlertWindow;  14-Jun-88	JJ	Added system shutdown message;  12-Jul-88	JJ	Added message 34 and modified message 17.;  01-Aug-88	FAB/MSA	Added message 35 'Soft Error', mod'd message 3;  25-Oct-88	BPA	Converted to MAX.;  09-Nov-88	CAE	Added messages 36 and 37 for GLoader.;  10-Nov-88	CAE	Added messages 38 and 39 for GLoader.;  08-Dec-88	CAE	Added message 40 for GLoader.;  21-Dec-88	CAE	Added string 41 for Init Manager.;  04-Jan-89	CAE	Added message 42 for GLoader.;  24 Jan 89	RBM	Added device dispatcher strings (text only);  25-Jan-89	CAE	Commented out the graphics versions of GLoader's fatal messages;  07-Feb-89	CAE	Fixed total_size declaration;  13-Feb-89	CAE	Divided file into PERMANENT and TEMPORARY sections.;			Moved GLoader's error messages into the TEMPORARY section.;			Changed total_size variable to perm_size.;  17-Feb-89	MSD	Added message 47 for AppleTalk not found.;  23-Feb-89	TGH	Added messages 48-51 for server messages.;  27-Feb-89  	BPA	Added message 52 for unclaimed interrupts.;  02-Mar-89	TGH	Added return values to ATALK buttons so they will be;			displayed in the finder.  (When bit 13 of sys_prefs set.);  14-Mar-89	CAE	Changed button return values for message 20.;			Added messages 53 and 54 for GQuit.;  15-Mar-89	CAE	Added messages 55 and 56 for GQuit.;  28-Mar-89	CAE	Added messages 57-59 for GLoader.;  27-Apr-89	CAE	Changed "volume" to "disk" in 3 messages.;  11-May-89	CAE	Fixed length byte for m28string.;  12-May-89	TGH	Added message 60. Not enough memory for AppleTalk.;  17-May-89	CAE	Removed graphics versions of messages to save space.  ;			Adjusted text versions to work in graphics and text modes.;  18-May-89	CAE	Replaced "cr" with "space_cr" in most messages so that a;			space will be used in graphics mode and a carriage return;			will be used in text mode.  ;			Adjusted sizes of graphics windows.;  23-May-89	CAE	Added two QuickDraw patches at start of file.;  06-Feb-91	GAB	Added and/or modified strings used by Init Mgr.;			Fixed patch used for inline GS/OS entry to adjust the;			  return address past the call parameters.;  26-Mar-91	GAB	Removed >65535 unclaimed interrupts message.;			Resized Volume Mount graphics dialog.;  30-Jul-91	GAB	Added new GQuit non-fatal dialog, used when an;			  application fails the InitialLoad.;  02-Aug-91	GAB	Added new GQuit non-fatal dialog, used when a user;			  attempts to launch a P8 application from a non-;			  ProDOS and non-AppleShare volume. (Message 65);  27-Sep-91	MSD	Added substitution string *2 to messages 48 and 49 so;			  that server shutdown messages can display the time;			  and date the server will or has shut down.;  28-Oct-91	GAB	Changed message #52 to include a substitution string;			  so that the actual error number can be displayed.;  24-Mar-92	DAL	Changed message #65 to read "disks" instead of "volumes".;  06-Apr-92	MSD	Added messages #66 (no AppleTalk hardware) and #67 (no;			  AppleTalk driver loaded).  In message #47, changed;			  "re-boot" to "restart".;  10-Feb-93 	SS	Added message #68 for the RAM5 driver.;   2-Mar-93	DAL	Changed the "Untitled" default to "untitled" (for init;			manager).;;===============================================================================;*******************************************************************************;; 	WARNING!!		WARNING!!		WARNING!!				;; This file has been divided into PERMANENT and TEMPORARY sections.; All TEMPORARY error messages are available during INITIAL boot only!!; They are not available during OS switches or after GLoader has passed ; control to GQuit to launch the startup application.; This file is now only loaded by GLoader during the initial boot.; Just before the startup application is launched, GLoader shrinks the memory; segment containing this file so that all TEMPORARY error messages are; no longer available.; This file is no longer reloaded when switching from ProDOS 8 to GS/OS.; If an error message must be available while GS/OS is operating or during an OS ; switch, the message must be placed in the PERMANENT section of this file.;; 	WARNING!!		WARNING!!		WARNING!!				;;*******************************************************************************;; Constants for	window size descriptor (wsd).;ws_custom	equ	$30			;custom	window sizews_2small	equ	$31			;2 lines, smallest widthws_3small	equ	$32			;3 lines, larger widthws_4small	equ	$33			;4 lines, larger widthws_5small	equ	$34			;5 lines, larger widthws_2medium	equ	$35			;2 lines, larger widthws_3medium	equ	$36			;3 lines, larger widthws_4medium	equ	$37			;4 lines, larger widthws_5large	equ	$38			;5 lines, larger widthws_6large	equ	$39			;6 lines, largest width;; Constants for	icon descriptor	(id).  Not supported by	text version.;no_icon		equ	$30custom_icon	equ	$31stop_icon	equ	$32note_icon	equ	$33caution_icon	equ	$34disk_icon	equ	$35disk_swap_icon	equ	$36;; Constants for	standard button	titles (bti) of	the form *n.  Standard button; titles are supported only in the graphics version.bt_ok		equ	$30bt_cancel	equ	$31bt_try_again	equ	$32bt_yes		equ	$33bt_no		equ	$34;; Constants for	string termination characters.;e_null		equ	$00			;nullht		equ	$09			;horizontal tabcr		equ	$0D			;carriage returnspace_cr	equ	$8D			;space for graphics, carriage return for textesc		equ	$1B			;escape;; console driver control codes;saveTxtPort	equ	$01			;save the current text portsetTxtPortSize	equ	$02			;set the text port boundariesclearBOL	equ	$03			;clear to beginning of linepopTxtPort	equ	$04			;pop text porthScroll		equ	$05			;horizontal scrollsetVertPosition	equ	$06			;set vertical cursor positionbell		equ	$07			;beep!backspace	equ	$08			;backspacetab		equ	$09linefeed	equ	$0AclearEOS	equ	$0B			;clear to end of text portclearScreen	equ	$0C			;clear textport & home cursorcarriageReturn	equ	$0Dnormal		equ	$0E			;set display format to normalinverse		equ	$0F			;set display format to inversespaceExpansion	equ	$10			;DLE space expansioncolumn40	equ	$11			;set 40-column modecolumn80	equ	$12			;set 80-column modeclearBOS	equ	$13			;clear to beginning of text portsetHorzPosition	equ	$14			;set horizontal positionsetCursWord	equ	$15			;set cursor movement wordscrollDown	equ	$16			;scroll text down one linescrollUp	equ	$17			;scroll text up one linemouseOff	equ	$18			;disable MouseText mappinghomeCursor	equ	$19			;reset cursor to upper left cornerclearLine	equ	$1A			;clear current cursor linemouseOn		equ	$1B			;enable MouseText mappingcursorRight	equ	$1C			;move cursor rightclearEOL	equ	$1D			;clear to end of linegotoxy		equ	$1E			;goto x,ycursorUp	equ	$1F			;move cursor up;===============================================================================; Data structure format:;; 1 word	Size of PERMANENT section of this file.;; 1 word	Number of error	messages.;; 1 word	Offset of first	alert string, text version.; 1 word	Offset of first	alert string, graphics version.;; 1 word	Offset of second alert string, text version.; 1 word	Offset of second alert string, graphics	version.; . . .	. . . .	. . . .	. . . .	. . . .	. . . .	. . . .	. . . .	.;; 1 word	Offset of nth alert string, text version.;		Offset of nth alert string, graphics version.;; Alert	strings	have the basic format used in Task Master's AlertWindow call,; with a few additions.	 The format is roughly as follows:;; wsd id \ msg \ bt1 \ bt2 \ bt3 stc r1	r2 r3;; wsd is the window size descriptor;; id is	the icon descriptor;; \ is the termination character used to separate succeeding parts of the string;; msg is the main alert	message	string.	 It may	contain	any character acceptable; to LETextBox2	except the termination character.  Special indicators of the; form *0, *1, ..., *9 are to be replaced by corresponding substitution	strings.;; bt1, bt2, and	bt3 are	button titles.	Contrary to the	syntax accepted	by; alert_window,	default	button titles are not allowed in the file.;; stc (the string termination character) is either an ASCII $00	or ASCII $13;; The preceding	fields are described completely	in the definition of the; AlertWindow call.;; r1, r2, and r3 are the responses to be returned when the user	presses	the; first	(left),	second,	or third button, respectively.	Legal values are the; ASCII	codes for characters 0 through 9 (i.e. $30, $31, ..., $39).;;===============================================================================		EXPORT	error_dataerror_data	PROC		longa	on		longi	on;*******************************************************************************;; The following 16 bytes are patches for QuickDraw.  When GQuit switches from GS/OS; to ProDOS 8, the load address of QD_patch1 is stored at the GS/OS stack entry vector; ($e1/00b0) and the load address of QD_patch2 is stored at the GS/OS normal entry; vector ($e1/00a8).  This is done so that if a ProDOS 8 application starts up ; QuickDraw (which is a legal thing to do), the QuickDraw startup routine won't crash; when it tries to make GS/OS calls (which it shouldn't be doing).  The patches are; here because they must be in a permanent, non-moveable piece of non-special memory.; The sizes of these patches are hard-coded in GLoader!  The patches MUST be the; first thing in the file and MUST be followed by "perm_size".;;*******************************************************************************stack_entry_patch		lda	1,s		;this patch is 13 bytes long		sta	7,s		lda	2,s		sta	8,s		pla		pla		pla		bra	patch_exitinline_entry_patch			;this patch is 13 bytes long		clc			;update	return address to point	past ...		lda	1,s		;... call_num and parm_block pointer		adc	#$0006		;since code can't cross bank boundary,		sta	1,s		;we only need to increment low wordpatch_exit	lda	#$ff		sec		rtl		EXPORT	perm_sizeperm_size	DC.W	end_of_perm_msgs-error_data		EXPORT	message_countmessage_count	DC.W	(past_offset_tbl-offset_tbl)/4;-------------------------------------------------------------------------------		EXPORT	offset_tbloffset_tbl m0		DC.W	m0text-*		DC.W	m0text-*m1		DC.W	m1text-*		DC.W	m1text-*m2		DC.W	m2text-*		DC.W	m2text-*m3		DC.W	m3text-*		DC.W	m3text-*m4		DC.W	m4text-*		DC.W	m4text-*m5		DC.W	m5text-*		DC.W	m5text-*m6		DC.W	m6text-*		DC.W	m6text-*m7		DC.W	m7text-*		DC.W	m7text-*m8		DC.W	m8text-*		DC.W	m8text-*m9		DC.W	m9text-*		DC.W	m9text-*m10		DC.W	m10text-*		DC.W	m10text-*m11		DC.W	m11text-*		DC.W	m11text-*m12		DC.W	m12text-*		DC.W	m12text-*m13		DC.W	m13text-*		DC.W	m13text-*m14		DC.W	m14text-*		DC.W	m14text-*m15		DC.W	m15text-*		DC.W	m15text-*m16		DC.W	m16text-*		DC.W	m16text-*m17		DC.W	m17text-*		DC.W	m17text-*m18		DC.W	m18text-*		DC.W	m18text-*m19		DC.W	m19text-*		DC.W	m19text-*m20		DC.W	m20text-*		DC.W	m20text-*m21		DC.W	m21string-*		DC.W	0000m22		DC.W	m22string-*		DC.W	0000m23		DC.W	m23string-*		DC.W	0000m24		DC.W	m24string-*		DC.W	0000m25		DC.W	m25string-*		DC.W	0000m26		DC.W	m26string-*		DC.W	0000m27		DC.W	m27string-*		DC.W	0000m28		DC.W	m28string-*		DC.W	0000m29		DC.W	m29string-*		DC.W	0000m30		DC.W	m30string-*		DC.W	0000m31		DC.W	m31string-*		DC.W	0000m32		DC.W	m32text-*		DC.W	m32text-*m33		DC.W	m33text-*		DC.W	m33text-*m34		DC.W	m34text-*		DC.W	m34text-*m35		DC.W	m35text-*		DC.W	m35text-*m36		DC.W	m36text-*		DC.W	m36text-*m37		DC.W	m37text-*		DC.W	m37text-*m38		DC.W	m38text-*		DC.W	m38text-*m39		DC.W	m39text-*		DC.W	m39text-*m40		DC.W	m40text-*		DC.W	m40text-*m41		DC.W	m41string-*		DC.W	0000m42		DC.W	m42text-*		DC.W	m42text-*		m43		DC.W	m43text-*		DC.W	m43text-*m44		DC.W	m44text-*		DC.W	m44text-*m45		DC.W	m45text-*		DC.W	m45text-*		m46		DC.W	m46text-*		DC.W	m46text-*m47		DC.W	m47text-*		DC.W	m47text-*m48		DC.W	m48text-*		DC.W	m48text-*m49		DC.W	m49text-*		DC.W	m49text-*m50		DC.W	m50text-*		DC.W	m50text-*m51		DC.W	m51text-*		DC.W	m51text-*m52		DC.W	m52text-*		DC.W	m52text-*m53		DC.W	m53text-*		DC.W	m53text-*m54		DC.W	m54text-*		DC.W	m54text-*m55		DC.W	m55text-*		DC.W	m55text-*m56		DC.W	m56text-*		DC.W	m56text-*m57		DC.W	m57text-*		DC.W	m57text-*m58		DC.W	m58text-*		DC.W	m58text-*m59		DC.W	m59text-*		DC.W	m59text-*m60		DC.W	m60text-*		DC.W	m60text-*m61		DC.W	m61string-*		;used by Init Mgr.		DC.W	0m62		dc.w	m62string-*		;used by Init Mgr.		DC.W	0m63		dc.w	m63string-*		;used by Init Mgr.		DC.W	0m64		dc.w	m64string-*		;used by Init Mgr.		DC.W	0m65		dc.w	m65text-*		dc.w	m65text-*m66		dc.w	m66text-*		; no AppleTalk hardware		dc.w	m66text-*m67		dc.w	m67text-*		; no AppleTalk driver		dc.w	m67text-*		m68		dc.w	m68text-*		; ROM 1 RAM disk size mismatch		dc.w	m68text-*				EXPORT	past_offset_tblpast_offset_tbl					 ;===============================================================================;; Start of PERMANENT messages.;;===============================================================================;; Message 0:  Prints substitution strings *0 and *1 and	gives Yes, No, and;	      Cancel buttons;m0text						; 		DC.B	ws_4medium		;4 lines, medium width		DC.B	note_icon		;note icon		DC.B	'\*0'			;print substitution string 0		DC.B	cr		DC.B	'*1\'			;print substitution string 1		DC.B	'Yes\'			;button	0:  'Yes'		DC.B	'^No\'			;button	1:  'No'		DC.B	'Cancel'		;button	2:  'Cancel'		DC.B	e_null			;end of	alert string		DC.B	'012'			;button	response mapping;; Message 1:  Mount volume.;m1text						; ;		DC.B	ws_5small		;5 lines		DC.B	ws_2medium		;? lines		DC.B	disk_swap_icon		;disk swap icon		DC.B	'\Please insert the disk:';		DC.B	cr,cr		dc.b	space_cr,space_cr		DC.B	'*0\'			;substitute volume name		DC.B	'Cancel\'		;right button:	'Cancel'		DC.B	'^OK'			;left button:  'OK'		DC.B	e_null			;end of	alert string		DC.B	'100'			;button	response mapping;; Message 2:  Disk is write protected.;m2text						; 		DC.B	ws_3medium		;3 lines		DC.B	disk_icon		;disk icon		DC.B	'\Disk *0'		DC.B	space_cr		DC.B	'is write protected.  Please '		DC.B	space_cr		DC.B	'write enable it.\'		DC.B	'^OK\'			;left button:  'OK'		DC.B	'No'			;right button:	'No'		DC.B	e_null			;end of	alert string		DC.B	'010';; Message 3:  Disk is damaged.;m3text						; 		DC.B	ws_3medium		;3 lines		DC.B	disk_icon		;disk icon		DC.B	'\Disk *0'		DC.B	space_cr		DC.B	'may be damaged.  Please move data to'		DC.B	space_cr		DC.B	'another disk.\'		DC.B	'^OK'			;left button:  'OK'		DC.B	e_null			;end of	alert string		DC.B	'000';; Messages 4-13 are GLoader fatal error messages.; They are contained in the temporary section of this file.;;; Messages 14-15 are GQUIT fatal error messages.;m14text						; 		DC.B	ws_2medium		;2 lines, medium width		DC.B	stop_icon		;stop icon		DC.B	'\Sorry, ProDOS 8 is not a compatible'		DC.B	space_cr		DC.B	'version.\'		DC.B	'^Restart'		DC.B	e_null		DC.B	'000'm15text						; 		DC.B	ws_3medium		;3 lines, medium width		DC.B	stop_icon		;stop icon		DC.B	'\Sorry, system error *1 occurred'		DC.B	space_cr		DC.B	'while trying to run the next'		DC.B	space_cr		DC.B	'application.\'		DC.B	'^Restart'		DC.B	e_null		DC.B	'000'm16text						; 		DC.B	ws_3medium		;3 lines, medium width		DC.B	caution_icon		;Danger, danger		DC.B	'\Disk *0'		DC.B	space_cr		DC.B	'was prematurely ejected.'		DC.B	space_cr		DC.B	'The disk structure may be damaged.\'		DC.B	'^OK'		DC.B	e_null		DC.B	'000';; Message 17 is a GLoader fatal error message.; It is contained in the temporary section of this file.;;; Message 18 is a GQUIT fatal error message.;m18text						; 		DC.B	ws_3medium		;3 lines, medium width		DC.B	stop_icon		;stop icon		DC.B	'\Sorry, this application requires '		DC.B	space_cr		DC.B	'the P8 file to be in the SYSTEM '		DC.B	space_cr		DC.B	'subdirectory.\'		DC.B	'^Restart'		DC.B	e_null		DC.B	'000';; Message 19 - GS/OS System Error;m19text						; 		DC.B	ws_4medium		;4 lines, medium width		DC.B	stop_icon		;stop icon		DC.B	'\GS/OS System Error'		DC.B	cr,cr		DC.B	'Address = $*0       LC bank = $*1'		DC.B	cr		DC.B	'Error code = $*2\'		DC.B	'^Restart'		DC.B	e_null		DC.B	'000';; Message 20 is a GQUIT non-fatal error message.;m20text						; 		DC.B	ws_3medium		;3 lines, medium width		DC.B	stop_icon		;stop icon		DC.B	'\Sorry, this application requires '		DC.B	space_cr		DC.B	'the P8 file to be in the SYSTEM '		DC.B	space_cr		DC.B	'subdirectory.\'		DC.B	'Restart\'		DC.B	'^Cancel'		DC.B	e_null		DC.B	'010';--------------------------------------------------------------------------------------;  Strings 21-31 and 61-63 are owned by the Initialization Manager.;  They	are not	window definitions - just strings.		string	Pascalm21string	DC.B	'Initialize device  .'m22string	DC.B	'as 'm23string	DC.B	'Initialize'm24string	DC.B	'Cancel'		string	AsIsm25string	DC.B	m25_len		DC.B	$1e,3+32,18+32		DC.B	'Select: Tab '		DC.B	$ca,$20,$cb		DC.B	'  Cancel: Esc  Initialize: '		DC.B	$c1,$cdm25_len		equ	*-m25string-1		string	Pascalm26string	DC.B	' File System '		string	asism27string	DC.B	m27_len		DC.B	$14,31+32		DC.B	' Format 'm27_len		equ	*-m27string-1		string	Pascalm28string	DC.B	'This file system won''t use the entire disk.'m29string	DC.