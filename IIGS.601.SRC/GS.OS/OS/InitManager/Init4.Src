		string	asis		pagesize 70				longa	on		longi	on		;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		Import	LC_Dispatcher		Import	Call_Deref		Import	Call_Alloc		Import	Call_Release		Import	Call_Dispatch		print	push		print	off		Include	'common.equ.src' 		include	'init.equ.src'		print	pop;===============================================================================;; init4.src;;===============================================================================init_4_header	PROC	org init_4_org-header_length		Import	init_4_start,init_4_end		msb	on		DC.W	init_4_end-init_4_start		DC.L	init_4_org		DC.W	$8000		DC.B	'Init Manager part 4   v04.01' 		DC.B	00		msb	off		ENDP		init_4_start	PROC	org init_4_org			ENDP		Eject;==========================================================;;  file init.4;;  Contains miscellaneous procedures used by the Init Mgr.;;  Copyright (C) 1988-1992 Apple Computer, Inc.;  All Rights Reserved.;;==========================================================		eject;==========================================================;;  add_size_str;;  Convert the size given at init_temp_2 into ascii, then;  append it to the string pointed to by init_temp_1.;;  Inputs:      init_temp_1 = p-string pointer;               init_temp_2 = long # to convert;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================add_size_str	Proc		Import	dest_buffer		with	my_direct_page		pei	<init_temp_2+2		; value to convert		pei	<init_temp_2		pea	dest_buffer>>16		; where to put it		pea	dest_buffer		pea	dest_length		; how much space		pea	0			; unsigned input		ldx	#$270B			; long2dec		jsl	$E10000		ldx	#-1			; find start of actual str		sep	#$20			; 8-bit acc		longa	off		lda	#' '			; skip spacesadd_size_1		inx				; bump index		cmp	dest_buffer,X		; a space?		beq	add_size_1		; yes, skip itadd_size_2		dex				; adjust string pointer		phx				; (pushes 2 bytes)		clc				; calculate length of string		lda	#dest_length		; byte		sbc	1,s			; byte		sta	dest_buffer,X		; insert length byte		rep	#$20			; 16 bit acc		longa	on		pla				; clean stack		txa				; get offset		clc		adc	#<dest_buffer		tax		lda	#0		adc	#^dest_buffer		tay;		fall through to add_string		eject;==========================================================;;  add_string;;  Append the string pointed to by X and Y to the string;  pointed to by init_temp_1.;;;  Inputs:      X,Y = p-string source pointer;               init_temp_1 = p-string dest pointer;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================		entry	add_stringadd_string	stx	<init_temp_2		sty	<init_temp_2+2		lda	#1			; source offset		sta	<init_temp_3		lda	[<init_temp_1]		; dest offset		inc	a		and	#$00FF		sta	<init_temp_3+2		dec	a			; fix for length comp		clc		adc	[<init_temp_2]		; compute new length		sep	#$30			; 8 bit acc + index		longa	off		longi	off		sta	[<init_temp_1]		; store new length		lda	[<init_temp_2]		; src len is xfer ct		taxadd_string_1		ldy	<init_temp_3		; src offset		lda	[<init_temp_2],y		ldy	<init_temp_3+2		; dest offset		sta	[<init_temp_1],y		inc	<init_temp_3		; 8 bit inc but thats ok		inc	<init_temp_3+2		dex				; xfer counter		bne	add_string_1		rep	#$30			; 16 bit acc + index		longa	on		longi	on		rts		EndP		eject;==========================================================;;  make_fmt_str;;  This takes the info found in a device format record;  and creates a descriptive string.  The string has the;  following format:;;  nnn k  mm:1;;  The size figure always appears ;  the interleave factor;  only appears when valid ( != 0 ).;;  The size figure is repeated as specified by a format;  options list ;  or it is calculated if there is only;  a single, DIB-synthesized option.;;  input:       A = entry number to calculate with;;  output:      df_string = VP of a p-string;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  This routine may move memory.;;==========================================================make_fmt_str	Proc		Import	colon_one,two_spaces,fmt_str_tb,dot_five,jsl_fmt_ptr		Import	which_call		with	my_direct_page,fmt_list_record		pha				; remember my victim		lda	#16			; make it 16 bytes		sec		jsl	call_alloc		stx	<init_temp_2		sty	<init_temp_2+2		ldx	<fmt_list_vp		; call_deref fmt list only		ldy	<fmt_list_vp+2		; (fst_list not around yet!)		jsl	call_deref		stx	<fmt_list_ptr		sty	<fmt_list_ptr+2		pla		jsl	jsl_fmt_ptr		ldx	<init_temp_2		ldy	<init_temp_2+2		jsl	call_deref		stx	<init_temp_1		sty	<init_temp_1+2		ldy	#df_string		; install string vp		lda	<init_temp_2		sta	[<fmt_list_entry],y		iny		iny		lda	<init_temp_2+2		sta	[<fmt_list_entry],y;  If we have a size figure, use it.		ldy	#df_fmt_size		lda	[<fmt_list_entry],y		beq	make_fmt_str_1		sta	<init_temp_2		; this is the number to use		stz	<init_temp_2+2		; its only a word		jsr	add_size_str		; convert and insert		ldy	#df_flags		; what are the units?		lda	[<fmt_list_entry],y		and	#$000C			; bits 2 and 3, times 4		tax		bra	make_fmt_str_4		; add units and interleave;  no size figure given.  Calculate from dib.  If >5 Mb, use Mb,;  otherwise display as # of k.make_fmt_str_1		ldy	#df_block_ct+2		; divide block ct by 2		lda	[<fmt_list_entry],y		lsr	a			; to get #k		tax				; (remember hi wd for a moment)		dey		dey		lda	[<fmt_list_entry],y		ror	a;  If the just-rolled-out bit is 1, the fractional size is > 0.5 k.;  So, in that case we round up.		bcc	rnd_str_1		inc	a		bne	rnd_str_1		; incrementing a long		inxrnd_str_1		sta	<init_temp_2		stx	<init_temp_2+2;  If the size is too big for K's, display Mb's.		txy				; >64 mb?		bne	make_fmt_str_2		cmp	#$1400			; >5 Mb?		bge	make_fmt_str_2		jsr	add_size_str		; its k.  add the string		ldx	#4		bra	make_fmt_str_4;  generated string, >5 meg.  convert to megs.make_fmt_str_2			ldx	#10			; divide by 2^10make_fmt_str_3		lsr	<init_temp_2+2		ror	<init_temp_2		dex		bne	make_fmt_str_3				php				; save carry status from last "ror"		jsr	add_size_str		; Now megs.  add the string		plp				; retrieve carry status		bcc	no_dot_five		; if carry is set we need to add a ".5"		ldx	#<dot_five		; get address of the string		ldy	#^dot_five		jsr	add_string		; and add it		no_dot_five				ldx	#8;  add the units string indexed by Xmake_fmt_str_4		lda	fmt_str_tb+2,X		; make ptr to add string		tay		lda	fmt_str_tb,X		tax		jsr	add_string		; stick it on;  now add the interleave, if necessary		lda	|which_call		; if Erase call - don't add interleave		bne	make_fmt_str_5		ldy	#df_interleave		lda	[<fmt_list_entry],y		beq	make_fmt_str_5		; if zero, N/A		pha		ldx	#<two_spaces		ldy	#^two_spaces		jsr	add_string		pla		sta	<init_temp_2		; add interleave value		stz	<init_temp_2+2		jsr	add_size_str		ldx	#<colon_one		ldy	#^colon_one		jsr	add_stringmake_fmt_str_5		rts		EndP		eject;==========================================================;;  query_driver;;  Calls the specified driver with a request for formatting;  options.  If none are available, assume a single format;  option and get info from the DIB.  Build a data structure;  based on the formatting options found.;;  Inputs:      dev_num = requested device;;  Outputs:     fmt_list_vp = VP of the new structure;               fmt_disp_cnt = number of entries therein;               fmt_def_fmt = driver specified default;               fmt_cur_med = currently installed media's fmt #;               A = if C == 1, contains error #;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0=no error, 1=device not formattable;;  This routine may move memory.;;==========================================================query_driver	Proc	Export		Import	cp8_t2x_t3y		Import	which_call		with	my_direct_page,fmt_list_record;  setup.  allocate a buffer for the status lists		lda	#256			;start out with 256 byte buffer		phaget_slist_buf					;buffer size is in A register		jsl	call_alloc		;allocate the buffer		stx	<init_temp_1		sty	<init_temp_1+2		jsl	call_deref		stx	<init_temp_2		sty	<init_temp_2+2;  step 1:  get_dib_ptr and see if this guy can format		stz	<drvr_dev_num		lda	#get_dib_ptr		sta	<drvr_call_num		lda	<dev_num		sta	<drvr_buf_ptr		jsl	call_dispatch		bcs	query_drv_err		ldy	#8			; characteristics word		lda	[<drvr_dib_ptr],y		bit	#$0080			; character device?		bne	query_drv_a		lda	#not_block_dev		bra	query_drv_errquery_drv_a		bit	#%0000000001000000	; write allowed?** 28 Feb 92  GAB** ProFile lies about its ability to accept a format call		;beq	@no_write		; no, so obviously can't format		;bit	#%0000000000001000	; formatting allowed?**		bne	query_drv_0		; yes, we can use it@no_write		lda	#drvr_wr_prot		bra	query_drv_err;  step 2:  ask the driver for formatting info;           for a Format call do Get_Format_Options;           for an Erase call do Get_Device_Statusquery_drv_0		lda	<dev_num		sta	<drvr_dev_num		lda	#drvr_status		sta	<drvr_call_num		lda	<init_temp_2		; dest ptr		sta	<drvr_slist_ptr		lda	<init_temp_2+2		sta	<drvr_slist_ptr+2		stz	<drvr_req_cnt+2;		lda	|which_call;		bne	its_erase_call		ldx	#$0003			; get_format_options		lda	1,s			; get buffer size;		bra	do_status_call;its_erase_call;		ldx	#0			; get_device_status;		lda	#6			; request countdo_status_call		stx	<drvr_ctrl_code		sta	<drvr_req_cnt		jsl	call_dispatch		bcs	query_drv_err		lda	|which_call		;if it's an Erase call		bne	query_drv_3a		;skip the next part;  step 3:  based on the result, build a table of format optionsstep_3		lda	<drvr_tran_cnt		; check return count		ora	<drvr_tran_cnt+2		beq	query_drv_3a		brl	query_drv_3b;  we interrupt this program to bring you the error handlerquery_drv_err		pha				;save error code		ldx	<init_temp_1		;dump the fmt data struct		ldy	<init_temp_1+2		jsl	call_release		pla				;retrieve error code		bne	real_error		;it was a real error		clc				;buffer was too small so		lda	1,s			;increase the requested size		adc	#256		sta	1,s		brl	get_slist_bufreal_error		plx				;pull buffer size off stack		sec		rtl;  step 3a:  no returned info.  simulate single entry using DIB info;;  mem_ptr      = set later;  mem_flag     = 0 (enabled, not selected);  fill_byte    = 0;  refnum       = 0;  conf_num     = 1;  alias        = 0;  flags        = 0 (universal type) (set size units later);  block_ct     = from DIB;  block_sz     = assume 512 bytes;  interleave   = 0 (means n/a);  fmt_size     = set later;  one_fst      = set later;  string       = set laterquery_drv_3a		lda	#1			; one entry		sta	<fmt_disp_cnt		sta	<fmt_cur_med		sta	<fmt_def_fmt		sta	<fmt_total_cnt		lda	#df_size		; size of 1 entry		jsr	get_fmt_mem		lda	#1			; driver conf. refnum = 1		ldy	#df_conf_num		sta	[<fmt_list_ptr],y		dec	a			; assume universal format		ldy	#df_flags		sta	[<fmt_list_ptr],y		lda	<drvr_tran_cnt		; were any format options returned?		ora	<drvr_tran_cnt+2		beq	@no_fmt_options		; no, leave format type as universal		ldy	#6			; get current option #		lda	[<init_temp_2],y		bne	@got_option		; if non-zero, use it		dey		dey		lda	[<init_temp_2],y	; else get the recommended option #@got_option		sta	<init_temp_3		; save for comparisons		lda	[<init_temp_2]		; get # of options		sta	<init_temp_3+2		ldy	#8			; look at the first entry refnum@loop		lda	[<init_temp_2],y		cmp	<init_temp_3		; is this the one we're looking for?		beq	@use_this_entry		; yes, use it's info		tya				; else look at next option		clc		adc	#16			; entry size		tay		dec	<init_temp_3+2		; have we looked at all options yet?		bne	@loop			; no, try again		bra	@no_fmt_options		; couldn't find it?????@use_this_entry		tya				; offset to entry's flags word		clc		adc	#4			; add offset to first entry flags word		tay		lda	[<init_temp_2],y	; get the flags word		ldy	#df_flags		sta	[<fmt_list_ptr],y	; put into list record		@no_fmt_options	if 0 then	; let Format use the status call too		lda	|which_call		bne	erase_call_3a		ldy	#$0A+2			; block count from DIB		lda	[<drvr_dib_ptr],y		tax		dey		dey		lda	[<drvr_dib_ptr],y		bra	cont_3a	endiferase_call_3a		tdc				; make a destination pointer		clc		adc	#<init_temp_3		; use init_temp_3 & init_temp_4		sta	<drvr_slist_ptr		; as the destination buffer		stz	<drvr_slist_ptr+2	; always in bank 0		stz	<drvr_req_cnt+2		ldx	#0			; get_device_status		lda	#6			; request count		stx	<drvr_ctrl_code		; other parms left over from		sta	<drvr_req_cnt		;   get_format_options call		jsl	call_dispatch		ldy	#4			; block count from status call		lda	[<drvr_slist_ptr],y		tax		dey		dey		lda	[<drvr_slist_ptr],ycont_3a		ldy	#df_block_ct		sta	[<fmt_list_ptr],y		iny		iny		txa		sta	[<fmt_list_ptr],y		lda	#512			; assume 512 byte blocks		iny		iny		sta	[<fmt_list_ptr],y		brl	query_drv_4;  step 3b:  use the returned data from the driver to build my listquery_drv_3b		lda	[<init_temp_2]		;get # of entries in list		asl	a		asl	a		asl	a		asl	a			;multiply by 16		adc	#8			;and add 8 to get total list size		cmp	1,s			;was our buffer large enough?		bcc	cont_3b			;yes - so we got the whole list		lda	#0			;no - so we need to get a bigger buffer		brl	query_drv_errcont_3b		lda	[<init_temp_2]		; return options count		sta	<fmt_total_cnt		tax		lda	#0query_sz_lp		adc	#df_size		; calculate array size		dex		bne	query_sz_lp		jsr	get_fmt_mem		stx	<init_temp_3		sty	<init_temp_3+2;  now walk through the returned list copying info		ldy	#2		lda	[<init_temp_2],y 	; # entries to display		sta	<fmt_disp_cnt		iny		iny		lda	[<init_temp_2],y 	; default refnum		sta	<fmt_def_fmt		iny		iny		lda	[<init_temp_2],y 	; current media		sta	<fmt_cur_med		clc				; set ptr to 1st entry		lda	<init_temp_2		adc	#8		sta	<init_temp_2		lda	<init_temp_2+2		adc	#0		sta	<init_temp_2+2		ldx	#0			; x is entry counter		txy				; y is entry offsetcopy_fmt_lp		clc				; move up 6 bytes into dest		lda	<init_temp_3		adc	#6			; (skipping mem_ptr, mem_flag,		sta	<init_temp_3		;  and fill_byte)		lda	<init_temp_3+2		adc	#0		sta	<init_temp_3+2		txa				; write my refnum		sta	[<init_temp_3],y		clc				; move up 8 bytes into dest		lda	<init_temp_3		adc	#8			; (skipping over my refnum,		sta	<init_temp_3		;  one_fst, and string vp)		lda	<init_temp_3+2		adc	#0		sta	<init_temp_3+2		phx		tyx		jsl	cp8_t2x_t3y		; copy 8 words;                                       	; (conf num, alias, flags, block;                                       	;  count, block size, interleave,;                                       	;  format size)		plx		inx		cpx	<fmt_total_cnt		; done?		bne	copy_fmt_lp;  step #4: clean up that messquery_drv_4		ldx	<init_temp_1		ldy	<init_temp_1+2		jsl	call_release;  step #5: create a string for each entry		lda	#0query_drv_5_lp		pha		jsr	make_fmt_str		pla		inc	a		cmp	<fmt_disp_cnt		bne	query_drv_5_lp;  step #6:  escape while there's time.		plx				;pull buffer size off stack		clc		rtl; This subroutine simply calls alloc_seg for the fmt list memoryget_fmt_mem		sec				; cleared, please!		jsl	call_alloc		stx	<fmt_list_vp		sty	<fmt_list_vp+2		jsl	call_deref		stx	<fmt_list_ptr		sty	<fmt_list_ptr+2		rts		EndP		eject;==========================================================;;  jsl fst_scan;;  Examine each on-line FST.  For each which supports;  formatting, build an entry in a table at fst_list_vp.;  Here because it directly references fst_tbl_data.;;  Outputs:     fst_list_vp = VP of new data structure;               fst_list_cnt = number of entries therein;               A = error number if C == 1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0=no error, 1=no FST's available;;  This routine may move memory.;;==========================================================fst_scan	Proc	Export		Import	call_judgename,jn_parms:jn_parmBlock		Import	call_deref,call_alloc,call_lock_mem,call_unlock_mem		Import	fst_tbl,fst_count,entry_size,s_flags,id		Import	cp4_t2x_t3y,cp1_t2x_t3y		with	my_direct_page,fst_list_record		with	jn_parms		lda	#3			; initialize pCount for JudgeName calls		sta	>pCount		lda	>fst_count		; probably in another bank		tax		lda	#0fst_scan_1		adc	#ff_size		; computing fst struct size		dex				; = fst_count * ff_size		bne	fst_scan_1		sec		jsl	call_alloc		stx	<fst_list_vp		sty	<fst_list_vp+2		jsl	call_deref		stx	<fst_list_ptr		sty	<fst_list_ptr+2		stx	<init_temp_3		; pointer as I walk thru		sty	<init_temp_3+2		; the new structure		stz	<fst_list_cnt		; size of new structure		stz	<init_temp_1		; fst number currently processing		lda	#<fst_tbl		; pointer to src list		sta	<init_temp_4		lda	#^fst_tbl		sta	<init_temp_4+2		jsl	call_lock_mem		; lock the list down temporarily;  loop here for each FST in the table.  Temps usage:;;  init_temp_1.w = fst counter;  init_temp_2   = pointer to fst header, current entry;  init_temp_3   = pointer to my table, current entry;  init_temp_4   = pointer to SCM's fst table, current entryfst_scan_2		ldy	#s_flags		; first- does it format?		lda	[<init_temp_4],y		and	#$2000			; *** check this field position		bne	@got_one		brl	fst_scan_3		; no format allowed this FST@got_one		lda	<fst_list_cnt		; ok.  write data into my record		ldy	#ff_refnum		; starting w/refnum		sta	[<init_temp_3],y		ldy	#id			; then file system #		lda	[<init_temp_4],y		ldy	#ff_fs_num		sta	[<init_temp_3],y		sta	>fileSysID		; store into Parm Block for JudgeName call		lda	[<init_temp_4]		; build ptr to actual header		sta	<init_temp_2		ldy	#2		lda	[<init_temp_4],y		sta	<init_temp_2+2		ldx	#18			; offset of fst block size		ldy	#ff_block_sz		jsl	cp1_t2x_t3y		; copy 1 word + 2 longs		jsl	cp4_t2x_t3y		ldy	#s_flags		; get the fst attributes again		lda	[<init_temp_4],y		and	#0003			; keeping lower 2 bits		ldy	#ff_flags		sta	[<init_temp_3],y		pea	call_judgename>>16		pea	call_judgename		pea	0		jsl	>lc_dispatcher		; call JudgeName to get the prompt pointer				ldy	#ff_prompt		; store prompt pointer into list member		lda	>syntax		sta	[<init_temp_3],y		ldy	#ff_prompt+2		lda	>syntax+2		sta	[<init_temp_3],y				clc		lda	<init_temp_2		; build ptr to format name string		adc	#36		ldy	#ff_mem_ptr		sta	[<init_temp_3],y		iny		iny		lda	<init_temp_2+2		adc	#0		sta	[<init_temp_3],y;  done with this entry.  Move to next entry of my table		clc				; point to next entry		lda	<init_temp_3		adc	#ff_size		sta	<init_temp_3		lda	<init_temp_3+2		adc	#0		sta	<init_temp_3+2		inc	<fst_list_cnt;  after checking each fst, move to next fstfst_scan_3		clc		lda	<init_temp_4		adc	#entry_size		sta	<init_temp_4		lda	<init_temp_4+2		adc	#0		sta	<init_temp_4+2		inc	<init_temp_1		; counter of fst's		lda	<init_temp_1		cmp	>fst_count		beq	fst_scan_4		brl	fst_scan_2;  Did we find any?  (maybe we booted off of High Sierra and;   no ProDOS was available.  Unlikely but hey, who knows?)fst_scan_4		jsl	call_unlock_mem		; unlock memory		lda	#0		cmp	<fst_list_cnt		; c set if =0		bcc	fst_scan_5		lda	#invalid_fst_opfst_scan_5		rtl		EndP;===============================================================================;; init.4.e;;===============================================================================init_4_end	PROC			ENDP		init_4_dummy	PROC	org init_4_max, skip	;generate an error if code is too big		ENDP		END		