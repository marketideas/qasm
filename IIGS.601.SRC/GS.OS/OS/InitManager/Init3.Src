		string	asis		pagesize 70;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		IMPORT	call_dispatch		Import	fst_adj_fmts		IMPORT	lc_dispatcher		IMPORT	std_buffer		print	push		print	off		include	'common.equ.src' 		include	'init.equ.src'			include	'hw.equ.src'	new_video	equ	$00C029		print	pop		;===============================================================================;; init.3.s;;===============================================================================		longa	on		longi	on		init_3_header	PROC	org init_3_org-header_length		Import	Init_3_start,Init_3_end		msb	on		DC.W	init_3_end-init_3_start		DC.L	init_3_org		DC.W	$8000		DC.B	'Init Manager part 3   v04.01' 		DC.B	00		msb	off		ENDPinit_3_start	PROC	org init_3_org		ENDP		include	'init.data.src'	;==========================================================;;  file init.3;;  Contains the data segment and text interface portions of;  the init package.;;  Author:      Andy Stadler;  Created:     29-Jan-88;  Modified:    See modification history below;;  Copyright (C) 1988-1989 Apple Computer, Inc.;  All Rights Reserved.;;==========================================================		macro		_gotoxy	&h,&v		lda	#gotoxy		jsr	write_char		lda	#(&h+32)+((&v+32)<<8)		jsr	write_2char		endm		DataChk	Off		eject;==========================================================;;  jsl  get_string;;  Looks up the specified string from the error messages.;;  Inputs:      A = string #;;  Outputs:     X,Y = pointer to string;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  uses init_temp_1;;==========================================================get_string	Proc	Export		Import	get_msg_address		with	my_direct_page		inc	a			; calc table offset		asl	a		asl	a		sta	<init_temp_1		pea	get_msg_address>>16		pea	get_msg_address		pea	0		jsl	>lc_dispatcher		txa				; index into table		clc		adc	<init_temp_1		sta	<init_temp_1		tya		adc	#0		sta	<init_temp_1+2		lda	[<init_temp_1]		; calc string start		clc		adc	<init_temp_1		tax		ldy	<init_temp_1+2		rtl		ENDP		eject;==========================================================;;  deref_lists;;  fmt_list_vp  ->  fmt_list_ptr;  fst_list_vp  ->  fst_list_ptr;;  Inputs:      fmt_list_vp = VP of available formats;               fst_list_vp = VP of available file systems.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================deref_lists	Proc	Export		Import	call_deref		with	my_direct_page		ldx	<fmt_list_vp		ldy	<fmt_list_vp+2		jsl	call_deref		stx	<fmt_list_ptr		sty	<fmt_list_ptr+2		ldx	<fst_list_vp		ldy	<fst_list_vp+2		jsl	call_deref		stx	<fst_list_ptr		sty	<fst_list_ptr+2		rtl		EndP		eject;==========================================================;;  call_open;;  Open the console driver!;;  Outputs:     A = error code IF C = 1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 if opened OK, 1 if not;;==========================================================call_open	Proc		lda	|cons_dev_num		sta	<drvr_dev_num		lda	#drvr_open		sta	<drvr_call_num		jsl	>call_dispatch		rts		EndP		eject;==========================================================;;  call_status;;  Perform a status call to the console driver.  This only;  works for a max of 2 bytes of data because it always;  uses std_buffer.  The driver is called with a request;  count of 2.;;  Outputs:     std_buffer = contains data returned;               <drvr_tran_cnt = transferred data count;               A = error code IF C = 1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 if status OK, 1 if not;;==========================================================call_status	Proc		sta	<drvr_stat_code		lda	#drvr_status		bra	common_call		; rest is shared with call_control		eject;==========================================================;;  call_control;;  Perform a control call to the console driver.  This only;  works for a max of 2 bytes of data because it always;  uses std_buffer.  The driver is called with a request;  count of 2.;;  Outputs:     std_buffer = contains data to send;               <drvr_tran_cnt = transferred data count;               A = error code IF C = 1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 if status OK, 1 if not;;  console_dispatch - calls the console driver directly.;;  Inputs:	A = low byte of request count (high byte always 0);		X = low word of control list pointer;		Y = high word of control list pointer;		drvr_ctrl_code and drvr_call_num must be;		initialized prior to entering console_dispatch.; ;==========================================================		Entry	call_control,console_dispatchcall_control		sta	<drvr_ctrl_code		lda	#drvr_control; from here down is shared by call_statuscommon_call		sta	<drvr_call_num		ldx	#<std_buffer		ldy	#^std_buffer		lda	#2console_dispatch		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		stx	<drvr_slist_ptr		sty	<drvr_slist_ptr+2		lda	|cons_dev_num		sta	<drvr_dev_num		jsl	>call_dispatch		rts		EndP		eject;==========================================================;;  call_close;;  done, close that puppy!;;  Outputs:     A = error code IF C = 1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 if closed OK, 1 if not;;==========================================================call_close	Proc		lda	|cons_dev_num		sta	<drvr_dev_num		lda	#drvr_close		sta	<drvr_call_num		jsl	>call_dispatch		rts		EndP		eject;==========================================================;;  get_input_port;;  Performs a GetInputPort call to the console driver;;  Outputs:     A = error code IF C = 1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 if closed OK, 1 if not;;==========================================================get_input_port	Proc		Import	input_port:InputPortRec		lda	#$8001			; subcall = GetInputPort		sta	<drvr_stat_code				lda	#drvr_status		; make a status call		sta	<drvr_call_num				ldx	#input_port		; status list = InputPortRec		ldy	#^input_port				lda	#$0011			; sizeof(InputPortRec)		brl	console_dispatch	; call the console driver (rts)		EndP		eject;==========================================================;;  write_num_str;;  Write the string specified by A.  This is the index #;  for a string in the error.msg file.;;  Inputs:      A = string # to print;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;;==========================================================write_num_str	Proc		Import	get_string		jsl	get_string		bra	write_pstring		; (rts)		eject;==========================================================;;  write_2char;;  Write the characters contained in A: lo byte, then high.;;  Inputs:      A = 2 ascii chars;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  Uses:        init_temp_1;;==========================================================		Entry	write_2charwrite_2char		pha		jsr	write_char		pla		xba;		bra	write_char		; (rts)		;fall into write_char		eject;==========================================================;;  write_char;;  Write the character in the low byte of A.;;  Inputs:      A = ascii to write;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  Uses:        init_temp_1;;==========================================================		Entry	write_charwrite_char		and	#$00FF			; make p string		xba		inc	a		sta	>std_buffer		ldx	#<std_buffer		ldy	#^std_buffer;		brl	write_pstring		;fall into write_pstring		eject;==========================================================;;  write_pstring;  write_gstring;;  Write the specified string.  In the write_gstring call,;  there is a special hack which skips over the first;  character of the string, this eliminates the separator;  which is $80 or ':' or other nastiness.;;  Inputs:      X,Y = pointer to a (p- or g-) string;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  Uses: init_temp_1;;==========================================================		Entry	write_pstringwrite_pstring		with	my_direct_page		stx	<init_temp_1		sty	<init_temp_1+2		inx				; make ptr to text		bne	write_pstr_1		inywrite_pstr_1		lda	[<init_temp_1]		; get length		and	#$00FF		bra	common_write		entry	write_gstringwrite_gstring		stx	<init_temp_1		sty	<init_temp_1+2		txa				; add 3 (skip length and separator)		clc		adc	#3		tax		bcc	write_gstr_1		inywrite_gstr_1		lda	[<init_temp_1]		; get length;  common part of write_n_string : length in A, ptr in X,Y		entry	common_writecommon_write		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		stx	<drvr_buf_ptr		sty	<drvr_buf_ptr+2		lda	|cons_dev_num		sta	<drvr_dev_num		lda	#drvr_write		sta	<drvr_call_num		stz	<drvr_blk_size		jsl	call_dispatch		rts		EndP		eject;==========================================================;;  find_console;;  Call the get_dnum routine in the Device Dispatcher to;  get the device # of the device named 'CONSOLE'.;;  The p-string 'CONSOLE' is contained in the Device Dispatcher;  itself since the Init Mgr has no room left in its $00/B200;  space for the string and the string can't live in LC Bank1 space.;;  Outputs:     cons_dev_num = device #  ;               A = error # if c=1, else trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 = ok, 1 = device not found;;==========================================================find_console	Proc		 		Import	console_string,get_dnum		pea	get_dnum>>16		;address of get_dnum routine		pea	get_dnum		pea	$0000			;lc bank 0		ldx	#console_string		;address of p-string "CONSOLE"		ldy	#console_string>>16		jsl	>lc_dispatcher		sta	|cons_dev_num		;device #		rts		EndP		eject;==========================================================;;  restore_state;;  Rolls data from vid_state (see above) back into the;  various soft switches.;;  Inputs:      vid_state = (as shown above);;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================restore_state	Proc		with	my_direct_page		sep	#$30		longa	off		longi	off		lda	|vid_state		; put where easier to get at		sta	<init_temp_1		lda	|new_video		; just touch bit 7 here		rol	a		ror	<init_temp_1		ror	a		sta	|new_video		ldy	#0			; easy source of zeros		ror	<init_temp_1		tya		rol	a			; setup 0 or 1 index		tax		sta	|clr80vid,X		; to hit paired soft switches		ror	<init_temp_1		tya		rol	a		tax		sta	|clraltchar,X		ror	<init_temp_1		tya		rol	a		tax		sta	|txtpage1,X		ror	<init_temp_1		tya		rol	a		tax		sta	|txtclr,X		ror	<init_temp_1		tya		rol	a		tax		sta	|clr80col,X		rep	#$30		longa	on		longi	on		rts		EndP		eject;==========================================================;;  save_state;;  Preserves the state of the video modes.  Everything;  pertaining to a text-based screen is saved.  The status;  bits are rolled into the byte 'vid_state' as follows:;   ___ ___ ___ ___ ___ ___ ___ ___;  |   |   |   |   |   |   |   |   |;  | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |;  |___|___|___|___|___|___|___|___|;    |   |   |   |   |   |   |   |__new video;    |   |   |   |   |   |   |______80 vid;    |   |   |   |   |   |__________alt char;    |   |   |   |   |______________page 2;    |   |   |   |__________________text mode;    |   |   |______________________80 col;    |___|__________________________(always 0);;  Then we put everything the way _we_ want it!;;  Outputs:     vid_state = (as shown above);               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================save_state	Proc		with	my_direct_page		sep	#$30			; 8 bit mode for all this		longa	off		longi	off		stz	<init_temp_1		lda	|rd80col		; get info 1 bit at a time		rol	a		rol	<init_temp_1		lda	|rdtext		rol	a		rol	<init_temp_1		lda	|rdpage2		rol	a		rol	<init_temp_1		lda	|altcharset		rol	a		rol	<init_temp_1		lda	|rd80vid		rol	a		rol	<init_temp_1		lda	|new_video		rol	a		rol	<init_temp_1		lda	#$36			; 80col tx p1 altch 80vid oldvideo		sta	|vid_state		rep	#$30		longa	on		longi	on		pei	<init_temp_1		jsr	restore_state		; now make screen for ME		pla		sta	|vid_state		rts		EndP		eject;==========================================================;;  save_cons_state;;  Preserves the state of the console driver- whether it;  was open ; and what wait & read modes were set.  Then it;  is opened (if necessary) and set for raw read + wait mode.;  The original state is stored in console_state in the;  following format:;   ______ ___ ___ ___ ___ ___ ___ ___ ___;  |      |   |   |   |   |   |   |   |   |;  | 15-8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |;  |______|___|___|___|___|___|___|___|___|;      |    |   |   |   |   |   |   |   |__console open;      |    |   |   |   |   |   |   |______no_wait_mode;      |    |   |   |   |   |   |__________raw input mode;      |____|___|___|___|___|______________always 0;;  Then we put everything the way _we_ want it!;;  Outputs:     console_state = (as shown above);               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================save_cons_state	Proc		Import	dflt_input_port,term_list,term_list_len:equ		Import	call_alloc,call_deref		with	my_direct_page		lda	#0			; get driver status		jsr	call_status		lda	>std_buffer		and	#1		sta	<init_temp_1		bne	sk_open_con		; already open		jsr	call_opensk_open_con		lda	#2			; get wait mode		jsr	call_status		lda	>std_buffer		rol	a		rol	<init_temp_1		lda	#$8005			; get read mode		jsr	call_status		lda	>std_buffer		rol	a;  create final product and store at >console_state		lda	<init_temp_1		rol	a		sta	|console_state;  buffer off any existing Input Port record, Terminator list, and;  default string		lda	#17			;17 bytes for Input Port record		jsl	call_alloc		stx	save_in_port		sty	save_in_port+2		jsl	call_deref		;leave pointer in X and Y		lda	#$8001			;GetInputPort		sta	<drvr_stat_code		lda	#drvr_status		sta	<drvr_call_num		lda	#17			;requestCount		jsr	console_dispatch	;make the call		lda	#514			;514 bytes for maximum terminator list		jsl	call_alloc		stx	save_term_list		sty	save_term_list+2		jsl	call_deref		;leave pointer in X and Y		lda	#$8002			;GetTerminators		sta	<drvr_stat_code		lda	#drvr_status		sta	<drvr_call_num		lda	#514			;requestCount		jsr	console_dispatch	;make the call		lda	<drvr_tran_cnt		;save the length of the returned record		sta	save_list_len		lda	#255			;255 bytes for default string		jsl	call_alloc		stx	save_dflt_string		sty	save_dflt_string+2		jsl	call_deref		;leave pointer in X and Y		lda	#$8006			;GetDefaultString		sta	<drvr_stat_code		lda	#drvr_status		sta	<drvr_call_num		lda	#255			;requestCount		jsr	console_dispatch		lda	<drvr_tran_cnt		;save the length of the string		sta	dflt_string_len;  now set:  wait mode, raw read mode		lda	#0		sta	>std_buffer		lda	#4			; set wait mode		jsr	call_control		lda	#$8000		sta	>std_buffer		lda	#$8003			; set raw read mode		jsr	call_control; now we send the terminator list to the console driver		lda	#$8001			; SetTerminators		sta	<drvr_ctrl_code		lda	#drvr_control		; make a control call		sta	<drvr_call_num		lda	#term_list_len		ldx	#<term_list		ldy	#^term_list		jsr	console_dispatch	; call the console driver		lda	#$8000			; SetInputPort		sta	<drvr_ctrl_code		lda	#drvr_control		; make a control call		sta	<drvr_call_num		lda	#5			; only modify first 5 bytes		ldx	#<dflt_input_port		ldy	#^dflt_input_port		jsr	console_dispatch	; call the console driver		rts		EndP		eject;==========================================================;;  restore_console;;  Sets the console driver back into its original state.;;  Inputs:      console_state = (as shown above);;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================restore_console	Proc		Import	call_deref,call_release		with	my_direct_page; restore the original Input Port, Terminator List, and default string		ldx	save_dflt_string		ldy	save_dflt_string+2		jsl	call_deref		;leave pointer in X and Y		lda	#$8004			; SetDefaultString		sta	<drvr_ctrl_code		lda	#drvr_control		sta	<drvr_call_num		lda	dflt_string_len		; requestCount		jsr	console_dispatch		ldx	save_dflt_string	; deallocate buffer		ldy	save_dflt_string+2		jsl	call_release		ldx	save_term_list		ldy	save_term_list+2		jsl	call_deref		;leave pointer in X and Y		lda	#$8001			; SetTerminators		sta	<drvr_ctrl_code		lda	#drvr_control		sta	<drvr_call_num		lda	save_list_len		; requestCount		jsr	console_dispatch		ldx	save_term_list		; deallocate buffer		ldy	save_term_list+2		jsl	call_release		ldx	save_in_port		ldy	save_in_port+2		jsl	call_deref		;leave pointer in X and Y		lda	#$8000			; SetInputPort		sta	<drvr_ctrl_code		lda	#drvr_control		sta	<drvr_call_num		lda	#17			; requestCount		jsr	console_dispatch		ldx	save_in_port		; deallocate buffer		ldy	save_in_port+2		jsl	call_release; restore the other settings		lda	|console_state		sta	<init_temp_1		lda	#0		ror	<init_temp_1		ror	a		sta	>std_buffer		lda	#$8003			; set read mode		jsr	call_control		lda	#0		ror	<init_temp_1		ror	a		sta	>std_buffer		lda	#0004			; set wait/no-wait mode		jsr	call_control		lda	<init_temp_1		; was it open?		bne	sk_close_cons		; yes, don't close		jsr	call_closesk_close_cons				 		rts		EndP		eject;==========================================================;;  save_tx_screen;;  Prepare the text screen for use:;;  (1)  Push viewport (sets full size);  (2)  Save entire screen;  (3)  If video mode changed, clear entire screen;;  Outputs:     port_save = saved screen image;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================save_tx_screen 	Proc		Import	gsos_id		with	my_direct_page		lda	#$01			; push vp		jsr	write_char;  get memory for a port buffer		lda	#0		pha				; returns long		pha		pha				; size 1920 + 2		pea	1920+2		lda	>gsos_id		; use Mike's memory ID		pha		pea	$C000			; locked		pha				; bank doesn't matter		pha		ldx	#$0902			; NewHandle		jsl	$E10000		pla		sta	<init_temp_1		pla		sta	<init_temp_1+2		lda	[<init_temp_1]		; deref the handle		sta	|scr_save_buf		sta	<drvr_slist_ptr		ldy	#2		lda	[<init_temp_1],y		sta	|scr_save_buf+2		sta	<drvr_slist_ptr+2; save the port		lda	#$8003			; save text port		sta	<drvr_stat_code		lda	#drvr_status		sta	<drvr_call_num		lda	|cons_dev_num		sta	<drvr_dev_num		lda	#1920+2		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		jsl	>call_dispatch; clear screen if mode changed		lda	|vid_state		and	#$0017			; want: text on, altchar on,		cmp	#$0016			;       80vid on, new vid off		beq	sk_clr_scr		lda	#$0C			; clear that puppy		jsr	write_charsk_clr_scr		rts		EndP				eject;==========================================================;;  restore_tx_scr;;  Restore the text screen to its original state;;  Inputs:      port_save = saved screen image;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================restore_tx_scr	Proc		lda	#$04			; 'pop port'		jsr	write_char		; (to the prev, which is full scr)		lda	#$8002			; restore text port		sta	<drvr_ctrl_code		lda	#drvr_control		sta	<drvr_call_num		lda	|cons_dev_num		sta	<drvr_dev_num		lda	|scr_save_buf		sta	<drvr_slist_ptr		lda	|scr_save_buf+2		sta	<drvr_slist_ptr+2		lda	#1920+2		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		jsl	>call_dispatch;  toss out the memory		pha		pha		lda	|scr_save_buf+2		pha		lda	|scr_save_buf		pha		ldx	#$1A02			; findHandle		jsl	$E10000		ldx	#$1002			; disposeHandle		jsl	$E10000; and restore to the original port		lda	#$04			; 'pop port'		brl	write_char		; (rts)		EndP		eject;==========================================================;;  txTextBox2;;  Prints the supplied string within the message box in;  the text dialog.;;  Inputs:      X, Y = pointer to pascal string to print;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  Variable usage:;		strPtr = supplied pointer to the string;		strLen = length of string;;==========================================================txTextBox2	Proc		with	my_direct_pagestrPtr		equ	init_temp_3strLen		equ	init_temp_4window_width	equ	47			;width of the message box		stx	<strPtr		sty	<strPtr+2		lda	[<strPtr]		; get the string length		and	#$00ff		sta	<strLen		inc	<strPtr			; bump pointer to actual text		bne	set_new_port		inc	<strPtr+2set_new_port; Set a new text port to the dimensions of the message box		lda	#saveTxtPort+(setTxtPortSize<<8)		jsr	write_2char		lda	#(16+32)+((15+32)<<8)	; 16, 15		jsr	write_2char		lda	#(62+32)+((18+32)<<8)	; 62, 18		jsr	write_2char		lda	#clearScreen		; clear the port		jsr	write_char		while_loop	; while (strlen<window_width)		lda	<strLen			; get the string length		cmp	#window_width+1		; less than the width of the window?		bcc	end_while		; yes, just display the string		ldy	#window_width-1		; start search at window_width into string		sep	#$20			; 8-bit accumulator		longa	off		lda	#' '			; search for a space@search		cmp	[strPtr],y		; is there a space there?		beq	@space_found		; yes...		dey				; else step back one character		bne	@search			; and keep searching		ldy	#window_width-1		; if no space found, just fill the line@space_found		phy				; save position of space		rep	#$20			; back to 16-bit accumulator		longa	on		ldx	<strPtr			; get the string pointer into X & Y		ldy	<strPtr+2		lda	1,s			; get the length		sec				; (+1 to skip the space)		adc	<strPtr			; set pointer to remainder of string		sta	<strPtr		bcc	@1		inc	<strPtr+2@1		lda	<strLen			; get original length		clc				; (-1 to skip the space)		sbc	1,s			; calculate remaining length		sta	<strLen		pla				; retrieve length of string segment		jsr	common_write		; go write the string				lda	#carriageReturn		; move to next line		jsr	write_char		bra	while_loop		; go back and do it againend_while		lda	<strLen			; get the remaining string length		beq	done			; if 0, we're done		ldx	<strPtr			; get the string pointer		ldy	<strPtr+2		jsr	common_write		; write the stringdone		lda	#popTxtPort		; restore the original text port		brl	write_char		; (rts)		EndP		eject;==========================================================;;  draw_top_select;;  Any time top_bar_pos is changed, call this routine to;  draw the 'File System' vs. 'Format' selector bar.;;  Inputs:      top_bar_pos = -1 for FS, 0 for niether, 1 for FMT;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================draw_top_select	Proc		with	my_direct_page		_gotoxy	5,6		lda	#inverse		; inverse text control code		pha		dec	a			; turn into a normal code				ldx	<top_bar_pos		; get current setting		bne	@which_one		; something get's inverted!		sta	1,s			; put 'normal' code on stack		bra	draw_top_sel_1		; then draw the headers		@which_one		bpl	draw_top_sel_1		; Format should be inverse		sta	1,s			; else normal 'Format'		inc	a			; and inverse 'File System'draw_top_sel_1		jsr	write_char		lda	#26			; ' File System '		jsr	write_num_str		pla		jsr	write_char		; retrieve correct code for 'Format'		lda	#27			; htab and print 'Format'		brl	write_num_str		; (rts)		EndP		eject;==========================================================;;  write_line;;  Draws the line which forms the top & bottom of the;  init window.;;  Inputs:	A = number of characters to write;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  Uses: init_temp_2;;  Modified 1-13-89 CAE;;==========================================================write_line	Proc		with	my_direct_page		sta	<init_temp_2		; save # of chars to write		lda	#$1C			; move-right		jsr	write_charwrite_ln_lp		lda	#'_'				jsr	write_char		dec	<init_temp_2		bne	write_ln_lp		lda	#$1C			; move-right		brl	write_char		; (rts)		EndP		eject;==========================================================;;  setup_name;;  fills our buffer with the currently entered volume name;;==========================================================setup_name	Proc		Import	call_deref,get_string				with	my_direct_page		ldx	path_vp			; deref the VP to our buffer		ldy	path_vp+2		jsl	call_deref		stx	txt_name_ptr		sty	txt_name_ptr+2		lda	<path2_ptr		; make pointer to volume name string		ora	<path2_ptr+2		; was a volume name supplied?		bne	@set_it_up		; yes, use it		lda	#61			; get the default volume name string		jsl	get_string		stx	<init_temp_1		sty	<init_temp_1+2		lda	[<init_temp_1]		; get the length byte		bra	do_copy@set_it_up		lda	<path2_ptr		; make pointer to volume name string		clc		adc	#2			; point to separator		sta	<init_temp_1		lda	<path2_ptr+2		; high word too		adc	#0		sta	<init_temp_1+2		lda	[<path2_ptr]		; get the length word		dec	a			; adjust for missing separatordo_copy		and	#$00FF			; clear high byte		cmp	#33			; >32 characters?		bcc	@ok			; no...		lda	#32			; else max it out@ok		tay				; into Y for indexing		sep	#$20			; 8 bit accumulator		pha				; save length _byte_@loop		lda	[<init_temp_1],y	; copy name to our buffer		sta	[txt_name_ptr],y		dey		bne	@loop			; loop until string is copied		pla				; retrieve length _byte_		sta	[txt_name_ptr]		; store it		rep	#$20			; back to 16-bit accumulatordone		rts		endp		eject;==========================================================;;  draw_tx_wind;;  (1)  Push port;  (2)  Set to border port;  (3)  Draw border;  (4)  Draw static stuff (dev name... volume...  press RETURN etc);;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================draw_tx_wind	Proc		Import	get_string		with	my_direct_page;  set for window		lda	#$0201			; push vp, set vp		jsr	write_2char		lda	#$222E			; 14, 2		jsr	write_2char		lda	#$3561			; 65, 21		jsr	write_2char		lda	#$1715			; disable scroll		jsr	write_2char; draw window		lda	#50			; width		jsr	write_line		; draw top line		lda	#19			; sides counter		sta	<init_temp_2draw_side_lp		lda	#$10DA			; side bar, expand spaces		jsr	write_2char		lda	#$DF52			; 50 spaces, side bar		jsr	write_2char		dec	<init_temp_2		bne	draw_side_lp		lda	#50			; width		jsr	write_line		; draw bottom line		_gotoxy	6,2		ldx	#21			; get first string for Format call		lda	which_call		; was the call Format or Erase?		beq	its_format		; it was Format		ldx	#29			; get first string for Erase callits_format	txa		jsr	write_num_str		; write out the string		stz	<drvr_dev_num		; get name from DIB		lda	#get_dib_ptr		sta	<drvr_call_num		lda	<dev_num		sta	<drvr_buf_ptr		jsl	call_dispatch		lda	<drvr_dib_ptr		; make pointer to name string		clc		adc	#$0E		tax		lda	<drvr_dib_ptr+2		adc	#0		tay		jsr	write_pstring		; and write the mother		_gotoxy	6,4		lda	#22			; 'as volume'		jsr	write_num_str		bit	pb_flags		; editable volume name?		bmi	@its_a_control		; yes, its an editLine control		lda	#'"'			; quote the name		jsr	write_char		ldx	<txt_name_ptr		; write volume name		ldy	<txt_name_ptr+2		jsr	write_pstring		lda	#'"'		jsr	write_char		bra	@name_drawn@its_a_control		lda	#64		jsr	write_num_str		; draw the box		@name_drawn		ldx	#25			; get prompt string for Format call		lda	which_call		; was the call Format or Erase?		beq	its_format2		; it was Format		ldx	#31			; get string for Erase callits_format2	txa		jsr	write_num_str		; write out the string		stz	<top_bar_pos		; assume editable name		bit	pb_flags		; is it really?		bmi	@editable		; yes		dec	<top_bar_pos		; else set FST title inverse@editable		jsr	draw_top_select		; draw the list headers				lda	#62			; start with the caution message		sta	currentFST		; init to show which message is displayed		jsl	get_string		brl	txTextBox2		; draw it in the window		EndP		eject;==========================================================;;  make_tx_ptr;;  Form a pointer to a particular member of one of the;  lists.;;  Inputs:      A = entry #;               tx_list_ptr = pointer to text list record;;  Outputs:     tx_list_entry = pointer to one of its members;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================make_tx_ptr	Proc		with	my_direct_page,tx_list_record		tax				; if zero, offset = 0		beq	make_tx_ptr_2		lda	#0		ldy	#list_entry_size	; (offset of entry size)make_tx_ptr_1		clc		adc	[<tx_list_ptr],y		dex		bne	make_tx_ptr_1make_tx_ptr_2		clc		adc	[<tx_list_ptr]		sta	<tx_entry_ptr		ldy	#2		lda	#0		adc	[<tx_list_ptr],y		sta	<tx_entry_ptr+2		rts		EndP		eject;==========================================================;;  setup_lists;;  Plug in data about the member lists and draw the lists.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================setup_lists	Proc		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		with	my_direct_page,tx_list_record		lda	<fst_list_ptr		sta	|tx_list_1.member_ptr		lda	<fst_list_ptr+2		sta	|tx_list_1.member_ptr+2		lda	<fst_list_cnt		sta	|tx_list_1.num_entries		lda	#$FFFF			; initialize selections		sta	|tx_list_1.current_entry		inc	a			; init scroll to top		sta	|tx_list_1.top_entry		lda	#<tx_list_1		sta	<tx_list_ptr		lda	#^tx_list_1		sta	<tx_list_ptr+2		jsr	draw_list		lda	<fmt_list_ptr		sta	|tx_list_2.member_ptr		lda	<fmt_list_ptr+2		sta	|tx_list_2.member_ptr+2		lda	<fmt_disp_cnt		sta	|tx_list_2.num_entries		lda	#$FFFF			; initialize selections		sta	|tx_list_2.current_entry		inc	a			; init scroll to top		sta	|tx_list_2.top_entry		lda	#<tx_list_2		sta	<tx_list_ptr		lda	#^tx_list_2		sta	<tx_list_ptr+2;		bra	draw_list		; (rts)		; fall into draw_list		eject;==========================================================;;  draw_list;;  Any time one of the lists is changed, call this routine;  to draw it.  Contains auto-scroll logic (if the currently;  selected entry is missing, bring it into view).;;  Inputs:      tx_list_ptr = ptr to text list record;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================		Entry	draw_listdraw_list		Import	set_list_str		ldy	#port			; set to this port		lda	[<tx_list_ptr],y		sta	>set_list_str+3		iny		iny		lda	[<tx_list_ptr],y		sta	>set_list_str+5		ldx	#<set_list_str		ldy	#^set_list_str		jsr	write_pstring; scroll (adjust top #) if current selection not visible		ldy	#current_entry		; A = current sel.		lda	[<tx_list_ptr],y		cmp	#$FFFF			; -1 = no selection		beq	draw_list_0		; no adjustment.		iny		iny				; CMP A vs. top #		cmp	[<tx_list_ptr],y		bge	draw_list_01		; bra if not before top		sta	[<tx_list_ptr],y 	; put selection at top of window		bra	draw_list_0draw_list_01		sta	<init_temp_1		; see if past bottom edge		lda	[<tx_list_ptr],y		clc				; A = top + 3		adc	#3		cmp	<init_temp_1		bge	draw_list_0		lda	<init_temp_1		; put selection at 4		sec		sbc	#3		sta	[<tx_list_ptr],y; draw or erase top arrowdraw_list_0		ldy	#top_entry 		; if top is non-zero draw arrow		lda	[<tx_list_ptr],y		beq	draw_list_1		lda	#$CB0E			; draw up arrow (normal, arrow)		jsr	write_2char		bra	draw_list_2draw_list_1		lda	#$200E			; clear up arrow (normal, space)		jsr	write_2char;  draw or erase bottom arrowdraw_list_2		ldy	#num_entries 		; if len-top >= 5 draw down arr.		lda	[<tx_list_ptr],y		sec		ldy	#top_entry		sbc	[<tx_list_ptr],y		cmp	#5		blt	draw_list_3		_gotoxy	0,3		lda	#$19CA			; down arrow, home cursor		jsr	write_2char		bra	draw_list_4draw_list_3		_gotoxy	0,3		lda	#$1920			; space, home cursor		jsr	write_2char;  draw entries one by onedraw_list_4		ldy	#top_entry		lda	[<tx_list_ptr],y		sta	<tx_cur_entry		lda	#4			; how many to draw		sta	<init_temp_3;  loop here per entrydraw_list_5		lda	<tx_cur_entry		ldy	#num_entries		; past end?		cmp	[<tx_list_ptr],y		blt	draw_list_55;  we are past the end.  just clear the line		lda	#clearLine		; this would erase the arrows		jsr	write_char		; but think, no arrows could be		brl	draw_list_9;  this is a real entrydraw_list_55		jsr	make_tx_ptr		; make pointer to mem list entry		lda	<tx_cur_entry		; if selected one, draw inversed		ldy	#current_entry		cmp	[<tx_list_ptr],y		beq	draw_list_6		ldy	#4			; if disabled, draw parens		lda	[<tx_entry_ptr],y	; get mem_flag from record		and	#$0020			; check bit 5		bne	draw_list_7		; not selectable;  prepare for normal, selectable.		lda	#$1C1C			; forward		jsr	write_2char		lda	#' '				jsr	write_char		per	finish_normal-1		bra	draw_list_8;  prepare for selected itemdraw_list_6		lda	#$1C1C			; forward 2		jsr	write_2char		lda	#$200F			; inverse, space		jsr	write_2char		per	finish_sel-1		bra	draw_list_8;  prepare for disabled itemdraw_list_7		lda	#$1C1C			; forward		jsr	write_2char		lda	#'('				jsr	write_char		per	finish_disa-1;  now draw the member stringdraw_list_8		lda	[<tx_entry_ptr]		tax		sta	<init_temp_2		ldy	#2		lda	[<tx_entry_ptr],y		tay		sta	<init_temp_2+2		brl	write_pstring		; rts to previously pushed addrfinish_normal		lda	#' '				jsr	write_char		bra	draw_list_9finish_sel		lda	#$0E20			; space, normal		jsr	write_2char		bra	draw_list_9finish_disa		lda	#')'				jsr	write_char;  now pad field, CR and go to next onedraw_list_9		lda	[<init_temp_2]		; now calc length for padding		and	#$00FF		pha		sec		lda	#15+32		sbc	1,s		and	#$00FF		ora	#$0D00		sta	>std_buffer+2		lda	#$1003			; pstring: $10 char_count CR		sta	>std_buffer		pla		ldx	#<std_buffer		ldy	#^std_buffer		jsr	write_pstring		inc	<tx_cur_entry		dec	<init_temp_3		beq	draw_list_10		brl	draw_list_5draw_list_10		lda	#$04			; pop vp		brl	write_char		; (rts)		EndP		eject;==========================================================;;  choose_fmt;;  Pick a format to select, by the following algorithm:;;  (1)  If a format already selected & it's enabled, stay w/it.;  (2)  If the driver's 'default' is available, choose it.;  (3)  Else just take whatever is available.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================choose_fmt	Proc		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		with	my_direct_page,fmt_list_record		lda	#<tx_list_2		sta	<tx_list_ptr		lda	#^tx_list_2		sta	<tx_list_ptr+2		lda	|tx_list_2.current_entry		cmp	#$FFFF		beq	choose_fmt_1		; nothing selected.		jsr	make_tx_ptr		; selected.  see if available.		ldy	#df_mem_flag		lda	[<tx_entry_ptr],y		and	#$0020			; disable bit		bne	choose_fmt_1		rts				; dis. bit off = enabled.  stay.;  The current selection is not available.  Try the driver default.choose_fmt_1		stz	<init_temp_1		; entry counterchoose_fmt_2		lda	<init_temp_1		jsr	make_tx_ptr		ldy	#df_conf_num		lda	[<tx_entry_ptr],y		cmp	<fmt_def_fmt		bne	choose_fmt_3		ldy	#df_mem_flag		; got it!  enabled?		lda	[<tx_entry_ptr],y		and	#$0020		bne	choose_fmt_4		; no.  no need to keep looping		bra	choose_fmt_6choose_fmt_3		inc	<init_temp_1		; loop and try another		lda	<init_temp_1		cmp	<fmt_disp_cnt		bne	choose_fmt_2;  default didn't work.  just take whatever's out there!choose_fmt_4		stz	<init_temp_1choose_fmt_5		lda	<init_temp_1		jsr	make_tx_ptr		ldy	#df_mem_flag		; available?		lda	[<tx_entry_ptr],y		and	#$0020		beq	choose_fmt_6		inc	<init_temp_1		; no need to test.  something		bra	choose_fmt_5		; must be available!choose_fmt_6		lda	<init_temp_1		; we like it.  select it.		sta	|tx_list_2.current_entry		brl	draw_list		; update screen.		EndP		eject;==========================================================;;  do_down_arrow;;  When the down arrow is pressed, move a selection bar;  to the next available option.  If none, just freeze.;;  Inputs:      top_bar_pos = -1 for FS, 1 for FMT;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================do_down_arrow	Proc		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		with	my_direct_page,tx_list_record,fst_list_record		ldx	#<tx_list_1		; which is current?		ldy	#^tx_list_1		lda	<top_bar_pos		bmi	do_down_1		ldx	#<tx_list_2		; oops, guessed wrong		ldy	#^tx_list_2do_down_1		stx	<tx_list_ptr		sty	<tx_list_ptr+2;  starting with the current entry +1, look for an opening		ldy	#current_entry		lda	[<tx_list_ptr],y 	; current entry #		phado_down_lp		lda	1,s		inc	a		sta	1,s		ldy	#num_entries		; see if at last yet		cmp	[<tx_list_ptr],y		beq	do_down_2		; if so, no change!		jsr	make_tx_ptr		; not last.  see if avail.		ldy	#ff_mem_flag		; check enable/disable bits		lda	[<tx_entry_ptr],y		and	#$0020		beq	@select_it		; enabled, so select it		lda	1,s			; get the entry number again		ldy	#top_entry		; is this entry below the bottom?		sec		sbc	#3		cmp	[<tx_list_ptr],y		beq	do_down_lp		bcc	do_down_lp		; within window, keep searching		lda	[<tx_list_ptr],y	; else must adjust top entry		inc	a		sta	[<tx_list_ptr],y		bra	do_down_lp		; try another.@select_it		lda	1,s			; this one is active		ldy	#current_entry		sta	[<tx_list_ptr],y 	; set new current #;  and redraw the listdo_down_2		pla		jsr	draw_list;  finally, fix fmt enable bits for this fst		bra	fix_fmt_bits		; (see do_up_arrow)		eject;==========================================================;;  do_up_arrow;;  When the up arrow is pressed, move a selection bar;  to the previous available option.  If none, just freeze.;;  Inputs:      top_bar_pos = -1 for FS, 1 for FMT;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================		entry	do_up_arrowdo_up_arrow		Import	jsl_fst_ptr		ldx	#<tx_list_1		; which is current?		ldy	#^tx_list_1		lda	<top_bar_pos		bmi	do_up_1		ldx	#<tx_list_2		; oops, guessed wrong		ldy	#^tx_list_2do_up_1		stx	<tx_list_ptr		sty	<tx_list_ptr+2;  starting with the current entry -1, look for an opening		ldy	#current_entry		lda	[<tx_list_ptr],y 	; current entry #		phado_up_lp		lda	1,s		beq	do_up_2			; top.  can't go further.		dec	a		sta	1,s		jsr	make_tx_ptr		; not last.  see if avail.		ldy	#4			; check enable/disable bits		lda	[<tx_entry_ptr],y		and	#$0020		beq	@select_it		; enabled, select it		lda	1,s			; get the entry number again		ldy	#top_entry		; is it off the top?		cmp	[<tx_list_ptr],y	; below this entry?		bcs	do_up_lp		; within window, continue searching		lda	[<tx_list_ptr],y	; else must adjust top entry		dec	a		bmi	do_up_lp		; can't be > 0		sta	[<tx_list_ptr],y		bra	do_up_lp		; no.  try another.@select_it		lda	1,s			; this one is active		ldy	#current_entry		sta	[<tx_list_ptr],y 	; set new current #;  fix stack and redraw the listdo_up_2		pla		jsr	draw_list;  if it was an fst, adjust format enable bitsfix_fmt_bits		lda	<top_bar_pos		bpl	q_fix		lda	|tx_list_1.current_entry		jsl	jsl_fst_ptr		; setting up fst_list_entry		jsl	fst_adj_fmts		jsr	choose_fmt		ldx	#<tx_list_2		; and redraw the format list		ldy	#^tx_list_2		stx	<tx_list_ptr		sty	<tx_list_ptr+2		jsr	draw_listq_fix		rts		EndP		eject;==========================================================;;  tx_too_big;;  If the current fst is not big enough for the current;  format, we will let them format, but we give them a;  nasty note.;;  e.g. ProDOS (32Mb max) onto an HD40SC.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================tx_too_big	Proc		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		Import	chk_fst_size,jsl_fmt_ptr,jsl_fst_ptr		Import	get_string		clc		lda	|tx_list_1.current_entry ; make fst and fmt pointers		bmi	tx_no_warn		; no FST currently selected		jsl	jsl_fst_ptr		clc		lda	|tx_list_2.current_entry		bmi	tx_no_warn		; no format currently selected		jsl	jsl_fmt_ptr;  find out if the current pair is ok		jsl	chk_fst_size		; fills the string if a problem		bcc	tx_no_warn;  and display the warning (if there is one)		lda	#28			; warning string		cmp	currentFST		; is the message already displayed?		beq	tx_no_warn		; yes, just leave it up		sta	currentFST		jsl	get_string		jsr	txTextBox2		; draw the text		sec				; signify that the message was drawn		;  no warning.  determine if we need to change the current messagetx_no_warn		rts		EndP		eject;==========================================================;;  tx_check_name;;  Performs a full JudgeName call with the user-supplied;  volume name prior to exiting the dialog box.;;  Outputs:     P = nvmxdizc;                   ..000..|;                          0=no error, 1=name not acceptable;;  Direct page variable usage is:;;	init_temp_2 = pointer to JudgeName result buffer;	init_temp_3 = VP of result buffer;	init_temp_4 = pointer to source of name;;==========================================================tx_check_name	Proc	Export		Import	call_judgename		Import	call_deref,call_alloc,call_release		Import	call_lock_mem,call_unlock_mem		Import	jn_parms:jn_parmBlock		with	my_direct_page,fst_list_record		with	jn_parms		; gonna use JudgeName parmblock; first convert the Pascal string to a GS/OS result buffer containing the name		lda	#36			; GS/OS result buffer		jsl	call_alloc		; allocate memory for the pathname		stx	init_temp_3		; save VP		sty	init_temp_3+2		jsl	call_lock_mem		; lock it down		ldx	init_temp_3		; deref the VP		ldy	init_temp_3+2		jsl	call_deref		; turn it into a pointer		stx	init_temp_2		; save pointer		sty	init_temp_2+2		txa				; save in JudgeName parmblock too		sta	>jn_parms.name		tya		sta	>jn_parms.name+2		lda	#36			; buffer length		sta	[init_temp_2]		; store in buffer		lda	<init_temp_2		; now adjust pointer past length words		clc		adc	#3		sta	<init_temp_2		bcc	@no_carry		inc	<init_temp_2+2@no_carry		lda	<txt_name_ptr		; this is the source pointer		sta	<init_temp_4		lda	<txt_name_ptr+2		sta	<init_temp_4+2		lda	[<txt_name_ptr]		; get the current length		and	#$00FF			; clear garbage bytedo_copy		pha				; save till after copy		tay				; into Y for indexing		beq	@its_null		; oops!  NULL volume name, skip copy		sep	#$20			; 8-bit accumulator@loop		lda	[<init_temp_4],y	; move string to our buffer		sta	[<init_temp_2],y		dey		bne	@loop			; until all copied		rep	#$20			; back to 16-bit accumulator@its_null		lda	<init_temp_2		; adjust pointer back to beginning of string		bne	@1		dec	<init_temp_2+2@1		dec	<init_temp_2		pla				; retrieve length		sta	[<init_temp_2]		; set string length; now we can see if the FST is happy with the supplied name		lda	#6			; reset pCount		sta	>jn_parms.pCount		ldy	#ff_fs_num		; get the FST ID		lda	[tx_entry_ptr],y	; (tx_entry_ptr set up by caller)		sta	>jn_parms.fileSysID		lda	#0		sta	>jn_parms.nameFlags	;clear translation flags				pea	call_judgename>>16		pea	call_judgename		pea	0		jsl	>lc_dispatcher		; call JudgeName to get the prompt pointer		jsl	call_unlock_mem		; unlock memory				ldx	<init_temp_3		; release the result buffer		ldy	<init_temp_3+2		jsl	call_release		lda	>jn_parms.nameFlags	; was the FST happy?		and	#$E000			; mask off reserved bits		cmp	#$0001			; condition carry		rts				; and return		EndP		eject;==========================================================;;  force_message;;  Forces the drawing of the JudgeName prompt, unless it's;  already being displayed.  ;;  chk_message;;  Updates the contents of the message area in the dialog.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================chk_message	Proc		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		Import	get_string		with	my_direct_page,fst_list_record		lda	<top_bar_pos		; which 'control' is the active control?		beq	force_message		; the editLine 'control', draw the prompt		jsr	tx_too_big		; update warning string		bcs	done			; if message drawn, skip prompt		entry	force_messageforce_message		lda	|tx_list_1.current_entry ; get currently selected FST		cmp	currentFST		; same as currently displayed msg #?		beq	done			; yes, just leave it alone		cmp	#-1			; is anything selected?		beq	done			; no, skip it		bit	pb_flags		; is the name editable?		bpl	done			; no, there's no need to show the message		lda	#tx_list_1		; else must put up new message		sta	<tx_list_ptr		lda	#^tx_list_1		sta	<tx_list_ptr+2		lda	|tx_list_1.current_entry ; get the FST number again		sta	currentFST		; save for comparison later		jsr	make_tx_ptr		; make a pointer to the member record		ldy	#ff_prompt		; get the pointer to the JudgeName prompt		lda	[tx_entry_ptr],y		tax		iny		iny		lda	[tx_entry_ptr],y		tay		jsr	txTextBox2		; draw the stringdone		rts		EndP		eject;==========================================================;;  handle_edit;;  Handles the actions necessary when the editLine 'control';  is the currently active control;;  Outputs:     init_choice = 0 if ok pressed,;                             1 if cancel;		top_bar_pos = -1 if tab is pressed;;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================handle_edit	Proc		Import	term_list,term_list_len:equ		Import	input_port:InputPortRec		with	my_direct_page; first, we have to set the default string		lda	#$8004			; SetDefaultString		sta	<drvr_ctrl_code		lda	#drvr_control		; make a control call		sta	<drvr_call_num		lda	[<txt_name_ptr]		; get length of current name		and	#$00ff			; that's our request count		ldy	<txt_name_ptr+2		; get pointer to buffer		ldx	<txt_name_ptr		inx				; bump past length byte		bne	@1		iny@1		jsr	console_dispatch	; make the control call; position the cursor to the beginning of the input fieldread_reentry		_gotoxy	9,4; now we can enter UIR mode and let the user edit the string		lda	#0			; turn on UIR		sta	>std_buffer		lda	#$8003			; SetReadMode		jsr	call_control		; make the control call		lda	#drvr_read		; do the read		sta	<drvr_call_num		lda	|cons_dev_num		sta	<drvr_dev_num		lda	<txt_name_ptr		ldx	<txt_name_ptr+2		inc	a			;bump past length byte		bne	@2		inx@2		sta	<drvr_slist_ptr		stx	<drvr_slist_ptr+2		lda	#32			;maximum of 32 characters		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		jsl	>call_dispatch		lda	<drvr_tran_cnt		; retrieve the string length		sta	<init_temp_4		; store here temporarily; now that we're back from the console driver, turn off UIR mode		lda	#$8000			; turn off UIR		sta	>std_buffer		lda	#$8003			; SetReadMode		jsr	call_control		; make the control call; now we get the current Input Port settings to determine which terminator; halted the Console Driver read		jsr	get_input_port		; go get the InputPortRec		lda	>input_port.exitType	; get the terminator number		and	#$00FF			; exitType is only a byte		cmp	#4			; one of the help terminators?		bcc	@not_help		; no...		jsr	force_message		; else must have been OA-?		bra	read_reentry		; update message and reenter read mode@not_help		tay				; save in Y		lda	<init_temp_4		; get the returned length		sep	#$20			; 8-bit store		sta	[<txt_name_ptr]		; set new string length		rep	#$20		ldx	#0			; assume user entered 'ok'		dey				; was it terminator #1?		beq	@accept_terminator	; yes...		inx				; else make X = 1		dey				; was it terminator #2 (ESC)?		beq	@accept_terminator	; yes...; else must have been terminator #3 (TAB)		dec	<top_bar_pos		; was 0, now -1 to highlight the FST list		jsr	draw_top_select		; update the highlighting		ldx	#-1			; re-init init_choice@accept_terminator		rts				; back to the 'event handler' loop				endp		eject;==========================================================;;  text_loop;;  Event loop for the text display.  Waits for keystrokes,;  processes them until return or esc pressed.;;  Outputs:     init_choice = 0 if ok pressed,;                             1 if cancel;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================text_loop	Proc		Import	get_string		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		Import	input_port:InputPortRec		with	my_direct_page		stz	<init_choice		; set to -1		dec	<init_choicetext_loop_0		lda	<init_choice		; done yet?		bpl	done		lda	<top_bar_pos		; which 'control' is currently active?		bne	list_current		; one of the lists...		jsr	handle_edit		; else go handle the edit 'control'		stx	<init_choice		; store the correct value to halt		txa				; check the returned value		bmi	go_chk_message		; negative means continue the loop		bne	name_good		; != 0 means canceldone		lda	#tx_list_1		; get currently selected FST ID		sta	<tx_list_ptr		lda	#^tx_list_1		sta	<tx_list_ptr+2		lda	|tx_list_1.current_entry ; get the FST record number		jsr	make_tx_ptr		; make a pointer to the member record		jsr	tx_check_name		; go do a JudgeName call		bcc	name_good		; checked out OK!		bit	pb_flags		; was it an editable name?		bpl	name_good		; no, just let the FST generate an error		pea	$0009			; "bad input" beep type		ldx	#$3803			; SysBeep2		jsl	$E10000			; get the user's attention		lda	#63			; message = "The supplied name is unacceptable..."		sta	currentFST		jsl	get_string		; go get the message pointer		jsr	txTextBox2		; draw the caution message		dec	<init_choice		; reset to continue the loop		bra	text_loop_0		; re-enter the event loopname_good		rtsgo_chk_message		jsr	chk_message		; go update the message box		bra	text_loop_0		; then re-enter looplist_current		lda	#drvr_read		; read 1 char		sta	<drvr_call_num		lda	|cons_dev_num		sta	<drvr_dev_num		lda	#<std_buffer		sta	<drvr_slist_ptr		lda	#^std_buffer		sta	<drvr_slist_ptr+2		lda	#1		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		jsl	>call_dispatch; case on key pressed		jsr	get_input_port		; get the InputPort settings		lda	>input_port.lastChar	; get the last char and modifier bits		and	#%1100001111111111	; mask out unimportant modifiers		cmp	#$0009			; was it a TAB?		bne	not_tab; handle tab by rotating through the three 'controls'do_tab		ldx	#1			; assume FST list is current control		lda	<top_bar_pos		; better check, though		bmi	@1			; yup, switch to format list		dex				; else switch to editLine 'control'		bit	pb_flags		; is the volume name editable?		bmi	@1			; yes, we can activate the control		dex				; else simply toggle between lists@1		stx	<top_bar_pos		; store the new setting		jsr	draw_top_select		; redraw the highlighting		bra	go_chk_message		; then make sure the right message is displayednot_tab		cmp	#$0A			; down arrow?		bne	not_down_arrowgo_down_arrow		jsr	do_down_arrow		bra	go_chk_message		; make sure the correct JudgeName prompt is shownnot_down_arrow		cmp	#$0B			; up arrow?		bne	not_up_arrowgo_up_arrow		jsr	do_up_arrow		bra	go_chk_messagenot_up_arrow		cmp	#$813F			; Open_Apple '?'?		beq	is_help			; yes...		cmp	#$802F			; Open-Apple '/'?		bne	not_help		; no...is_help		bit	pb_flags		; editable name?		bpl	bad_input		; no, help not available		jsr	force_message		; force the display of the JudgeName prompt		bra	leapfrognot_help		cmp	#$800D			; Open-Apple return?		bne	not_return		; no, try something else		stz	<init_choice		; signal return		bra	leapfrognot_return		cmp	#$001B			; escape?		bne	bad_input		; nothing else is legal		inc	<init_choice		; signal esc		inc	<init_choice		rtsbad_input;  illegal key.  beep and loop.		pea	8			; bad keypress		ldx	#$3803			; sysbeep2		jsl	$E10000leapfrog		brl	text_loop_0		EndP		eject;==========================================================;;  preset_choices;;  Pick the defaults, by (1) attempting to choose the;  driver default format (see choose_fmt for details) and;  (2) taking the 1st FST listed by that format.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================preset_choices	Proc		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		Import	jsl_fst_ptr,fst_adj_fmts		with	my_direct_page,fmt_list_record,fst_list_record		jsr	choose_fmt		; picks a default format		lda	pb_reqFileSysID		; valid FST ID supplied?		bne	set_default		; yes, use it as initial selection; At this point, the supplied FST ID is 0.  This means that the caller doesn't; really care what the initially selected FST is.  So, since the first FST in the; list is the boot FST, we should make sure that it's the one that is initially; selected.  (Well, we should supply SOME kinda default, shouldn't we?)		lda	|tx_list_2.current_entry ; get that format's FST		jsr	make_tx_ptr		ldy	#df_one_fst		lda	[<tx_entry_ptr],y		sta	|tx_list_1.current_entry ; and select that fst		bra	draw_lists		; then go draw the listsset_default		lda	#<tx_list_1		; use the FST list		sta	<tx_list_ptr		lda	#^tx_list_1		sta	<tx_list_ptr+2		lda	#0			; start at the beginning of the list@loop		sta	init_temp_1		; save the member #		jsr	make_tx_ptr		; go make a pointer		ldy	#ff_fs_num		; get the FST ID from the record		lda	[<tx_entry_ptr],y		cmp	pb_reqFileSysID		; do they match?		beq	@select_it		; yes, select it		bit	pb_flags		; is the FST selectable?		bvs	@next_one		; yes, leave the entry as is		ldy	#ff_mem_flag		; else dim it		lda	[<tx_entry_ptr],y		ora	#%00100000		sta	[<tx_entry_ptr],y		bra	@next_one@select_it		ldy	#ff_mem_flag		; set the selected bit		lda	[<tx_entry_ptr],y		bit	#%01100000		; first, is it selectable?		bne	@next_one		; no, so don't select it		ora	#%10000000		sta	[<tx_entry_ptr],y		lda	<init_temp_1		; get the current index		sta	tx_list_1.current_entry	; set the current selection@next_one		lda	init_temp_1		; bump counter		inc	a			; are we done yet?		cmp	fst_list_cnt		bne	@loop			; no, go do the next one		lda	tx_list_1.current_entry	; did anything get selected?		bpl	draw_lists		; yes...		lda	#0			; else scan the list again, looking for@loop2		sta	<init_temp_1		;  the first selectable FST		jsr	make_tx_ptr		ldy	#ff_mem_flag		; get the flags		lda	[<tx_entry_ptr],y		bit	#%01100000		; is it selectable?		beq	@got_it			; yes, go select it		lda	<init_temp_1		inc	a		cmp	fst_list_cnt		bne	@loop2@got_it		ora	#%10000000		; set the selected bit		sta	[<tx_entry_ptr],y		lda	<init_temp_1		sta	tx_list_1.current_entrydraw_lists		lda	tx_list_1.current_entry		jsl	jsl_fst_ptr		; make a pointer to the entry		jsl	fst_adj_fmts		; disable any inappropriate formats		lda	#<tx_list_1		sta	<tx_list_ptr		lda	#^tx_list_1		sta	<tx_list_ptr+2		brl	draw_list		EndP		eject;==========================================================;;  record_tx_sel;;  Convert list selections to chosen_fst and chosen_fmt.;;  Outputs:     chosen_fst = entry # of selected FST;               chosen_fmt = entry # of selected format;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================record_tx_sel	Proc		Import	tx_list_1:tx_list_record,tx_list_2:tx_list_record		with	my_direct_page,fst_list_record				lda	#tx_list_1		sta	<tx_list_ptr		lda	#^tx_list_1		sta	<tx_list_ptr+2		lda	|tx_list_1.current_entry		jsr	make_tx_ptr		; make pointer to FST list record		ldy	#ff_fs_num		; get the FST ID		lda	[<tx_entry_ptr],y		sta	<chosen_fst		lda	|tx_list_2.current_entry ; fmt		sta	<chosen_fmt; now we have to fix up the name so that it's in the proper format		lda	<txt_name_ptr		; get source pointer		ldx	<txt_name_ptr+2				ldy	which_class		; class 1?		bne	@class1			; yes, go handle it		inc	a			; else bump by 1 to make room for		bne	do_copy			; ..leading separator		beq	@bump_high_word@class1		clc				; class 1, leading separator &		adc	#2			; ..high byte of length word		bcc	do_copy@bump_high_word		inxdo_copy		sta	<init_temp_4		; store as destination pointer		stx	<init_temp_4+2		lda	[<txt_name_ptr]		; get length		and	#$00FF			; clear garbage byte		beq	@class_1		; if null, skip the copy		pha				; save length		tay				; put into Y for indexing		sep	#$20			; 8-bit accumulator		longa	off		@loop		lda	[<txt_name_ptr],y	; move up within buffer		sta	[<init_temp_4],y		dey		bne	@loop		lda	#':'			; leading separator		sta	[<init_temp_4]		rep	#$20			; 16-bit accumulator again		longa	on		pla				; retrieve length		inc	a			; bump by 1 to account for separator		ldy	which_class		; class 1 call needs a word length		bne	@class_1		ora	#'/'<<8			; else combine with class 0 separator@class_1		sta	[<txt_name_ptr]		; store the length		rts				; and we're done		EndP		eject;==========================================================;;  display_msg;;  Displays a graphics or text message which says 'Initializing...'.;;  Inputs:	none;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  Added CAE 12/21/88;  Modified CAE 7/27/89 to fix a bug in which |cons_dev_num was;	not initialized if doing a non-dialog Format in text mode.;;==========================================================display_msg	Proc	Export		longa	on		longi	on		Import	get_string		with	my_direct_page		lda	pb_flags		;get the flags		bit	#%0010000000000000	;caller wishes to inhibit the window?		beq	@show_window		;no, go ahead and display it		rtl				;else just short circuit it@show_window		lda	<init_screen		bpl	do_text_msg;put up a graphics message		inc	|msg_flag		;indicate that a graphics message was put up; save caller's cursor, and set it to the watch cursor		pha		pha		ldx	#$8F04			; GetCursorAdr		jsl	>$e10000		pla		sta	|save_cursor		pla		sta	|save_cursor+2		ldx	#$0A12			;WaitCursor		jsl	$E10000			;(no effect if QDAux not set up)		pha				;space for result		pha		pea	msg_parms>>16		pea	msg_parms		ldx	#$090E			;NewWindow		jsl	>$e10000		pla		sta	|msg_window		pla			sta	|msg_window+2				pha				; save old port		pha		ldx	#$1C04			; GetPort		jsl	>$e10000		pla		sta	|save_port		pla		sta	|save_port+2				lda	|msg_window+2		; set new port		pha		lda	|msg_window		pha		ldx	#$1B04			; SetPort		jsl	>$e10000		pea	45		pea	14		ldx	#$3A04			;MoveTo		jsl	>$e10000				lda	#41		jsl	get_string		phy		phx		ldx	#$A504			;DrawString		jsl	>$e10000			bra	done	;put up a text messagedo_text_msg		jsr	find_console		; get device # of .CONSOLE	** added 7/27/89 CAE **		bcs	done			; got an error			** added 7/27/89 CAE **				dec	|msg_flag		;indicate that a text message was put up				jsr	save_state		; save video mode state		jsr	save_cons_state		; save console driver state		jsr	save_tx_screen 		; save current text screen		lda	#$0201			; push vp, set vp		jsr	write_2char		lda	#$2A3A			; 26, 10		jsr	write_2char		lda	#$2D56			; 54, 13		jsr	write_2char		lda	#$1715			; disable scroll		jsr	write_2char		lda	#27			; width		jsr	write_line		; draw top line		lda	#3			; sides counter		sta	<init_temp_2side_loop	lda	#$10DA			; side bar, expand spaces		jsr	write_2char		lda	#$DF3B			; 27 spaces, side bar		jsr	write_2char		dec	<init_temp_2		bne	side_loop		lda	#27			; width		jsr	write_line		; draw bottom line		_gotoxy	7,2		lda	#41				jsr	write_num_str		; write out the stringdone		rtl		EndP				eject;==========================================================;;  remove_msg;;  Removes the 'Initializing...' message.;;  Inputs:	none;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  Added 1/9/88 CAE;;==========================================================remove_msg	Proc	Export		longa	on		longi	on		phb				; remember gs/os data bank		pea	$0101			; our data is in bank 1		plb		plb				lda	|msg_flag		;did we put a message up?		beq	rmv_done		;no - so nothing to remove		bmi	remove_text_msg		;yes - it was a text message		;remove a graphics message		lda	|save_port+2		;restore the original port		pha		lda	|save_port		pha		ldx	#$1B04			; SetPort		jsl	>$e10000		lda	|msg_window+2		;remove the message window		pha		lda	|msg_window		pha		ldx	#$0B0E			; CloseWindow		jsl	>$e10000		lda	|save_cursor+2		;restore caller's original cursor		pha		lda	|save_cursor		pha		ldx	#$8E04		jsl	>$e10000		bra 	rmv_done		;remove a text messageremove_text_msg	jsr	restore_tx_scr		; restore the original text screen		jsr	restore_console		; restore console driver to its original state		jsr	restore_state		; restore original video modermv_done	plb				;restore gs/os data bank register		rtl		EndP		Eject;==========================================================;;  non_dialog;;  The calling program specified which FST to use in the;  parameter block so all we need to do is get the default;  format for the device.;;  Inputs:      fmt_list_vp = vp of the format options list;               fst_list_vp = vp of the file system options;;  Outputs:     chosen_fst = selected fst #;               chosen_fmt = selected fmt #;               init_choice = 0;               A = error # if c=1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0=no error, 1=error;;  This routine added 4-88 CAE;==========================================================non_dialog	Proc	Export		Import	choose_def_fmt2,jsl_fst_ptr,jsl_deref		with	my_direct_page,fst_list_record		longa	on		longi	on		stz	path_vp			;make sure we return a NULL VP		stz	path_vp+2		;  for the volume name; first, get the FST ID # specified in the call		ldy	#$000c			;offset to requested FST field		lda	[<param_blk_ptr],y 	;get requested FST		bne	@1			;non zero means look for it		lda	#invalid_fst_id		;zero is a bad FST ID #		sec		rtl@1		pha				;save on stack; now search through the list to find the specified FST ID and ensure that; the FST supports formatting.		jsl	deref_lists		stz	<init_temp_1		;entry counterxlate_fst		lda	<init_temp_1		jsl	jsl_fst_ptr		;create ptr to fst entry		ldy	#ff_fs_num		lda	[<fst_list_entry],y 	;get FST ID # from entry		cmp	1,s			;does it match the requested FST ID #?		beq	xlate_done		;yes - so we found the correct entry		inc	<init_temp_1		;no - so check the next entry		lda	<init_temp_1		cmp	<fst_list_cnt		;at end of list?		bne	xlate_fst		;no		pla				;yes - so clean up stack		lda	#invalid_fst_op		;return error		rtl				;carry is setxlate_done		pla				;clean up stack		sta	<chosen_fst		;save fst id; now enable the available formats for this FST		jsl	fst_adj_fmts; now select the default format		jsl	choose_def_fmt2		bcs	@oops			;if error occurs, exit; now set up the correct outputs		lda	<init_temp_1		;record item #		sta	<chosen_fmt		;format ref #		stz	<init_choice		clc				;indicate no error@oops		rtl		EndP		eject;==========================================================;;  init.tx;;  Text based user interface for the init package.  Puts;  up a dialog window and prompts the user for selection;  of formatting options.;;  Author:      Andy Stadler;  Created:     31-Jan-88;  Modified:    See modification history below;;  Copyright Apple Computer, Inc. 1987-1989;  All rights reserved.;;==========================================================;;  Modification history:;;  15-Feb-88    ADS     Initial release;  23-Feb-88    ADS     General crunching;                       'Format too large' indicator added;  30-Mar-88    CAE     Changed to use strings which say;                       'Format' or 'Erase' instead of 'Initialize';  12-Jan-89	CAE	Renamed some routines and moved some code around ;  13-Jan-89	CAE	Modified write_line routine to take # of chars as input;  08-Feb-89	CAE	Added error check in tx_dialog after calling find_console.;			Changed find_console to ask for the device # of the device ;			named "CONSOLE" instead of just searching DIBs for a console device.;==========================================================;==========================================================;;  jsl tx_dialog;;  Main level for the text-based user interface.  Saves;  the state of the screen hardware and the console driver,;  then takes over, displaying text mode, drawing a window,;  and showing all the info within the window.;;  Inputs:      fmt_list_vp = vp of the format options list;               fst_list_vp = vp of the file system options;;  Outputs:     chosen_fst = selected fst # if init_choice = 0;               chosen_fmt = selected fmt # if init_choice = 0;               init_choice = 0=OK, 1=cancel;               A = error code if c=1 else trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;			   0 = no error; 1 = error;;==========================================================tx_dialog	Proc	Export			               		Import	fix_ptrs,call_alloc				with	my_direct_page		longa	on		longi	on		jsr	find_console		; get device # of .CONSOLE		bcs	tx_dialog_done		; got an error		jsr	save_state		; save video mode state		jsr	save_cons_state		; save console driver state		jsr	save_tx_screen		; save current text sreen		lda	#36			; allocate 36 bytes for name		jsl	call_alloc		stx	path_vp		sty	path_vp+2		jsl	>fix_ptrs		; lock memory, make str ptrs		jsr	setup_name		; fill our name buffer		jsr	draw_tx_wind		; draw the window		jsr	setup_lists		; plug in data & draw		jsr	preset_choices		; select some defaults		jsr	text_loop		jsr	restore_tx_scr		; restore original text screen		jsr	restore_console		; restore console driver state		jsr	restore_state		; restore video mode state		jsr	record_tx_sel		; retrieve the settings		clc				; indicate no errortx_dialog_done	rtl		EndP		Eject;===============================================================================;; init.3.e;;===============================================================================		DataChk	oninit_3_end	PROC			ENDP		init_3_dummy	PROC	org init_3_max, skip	;generate an error if code is too big		ENDP		END