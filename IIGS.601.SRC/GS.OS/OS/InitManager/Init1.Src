		string	asis		pagesize 70		print	push		print	off		Include	'Common.Equ.Src' 		include	'init.equ.src'	saved_dp	equ	$01FD00		print	pop;===============================================================================;; init.1.s;;===============================================================================init_1_header	PROC	org init_1_org-header_length		Import	Init_1_end,init_1_start		msb	on		DC.W	init_1_end-init_1_start		DC.L	init_1_org		DC.W	$0000		DC.B	'Init Manager part 1   v04.00' 		DC.B	00		msb	off		ENDPinit_1_start	PROC	org init_1_org		ENDP				;==========================================================;;  file init.1;;  This is the interface area of the init package.  It is;  called by SCM in response to a $24 FORMAT or $25 ERASE_;  DISK application call.  In addition, it contains code;  and data which may be needed outside of the language cards.;;  Author:      Andy Stadler;  Created:     26-Jan-88;  Modified:    See modification history below;;  Copyright (C) 1988-1989 Apple Computer, Inc.;  All Rights Reserved.;;==========================================================;;  Modification history:;;  01-Feb-88    ADS     Initial release;  04-Feb-88    ADS     std_buffer, strings added;  15-Feb-88    ADS     strings removed  get_str_addr added;  23-Feb-88    ADS     crunching.  cp[n]_t2x_t3y created;  09-Jan-89	CAE	added init_pack_end routine;;==========================================================		DataChk	off					;using   common_equ					;using   init_equ					;using   fst_tbl_data		longa	on		longi	on		Eject;==========================================================;;  jsl init_pack;;  Is the entry point for SCM.;;  Inputs:      X = call number x 2;               Y = call class x 2;               dev_num = device number to be formatted;               path2_ptr = volume name of new volume;;  Outputs:     A = fst id if !C;                 = error # if C;                 = 0 if format cancelled;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 = no error, 1 = error;;  This routine may move memory.;;==========================================================init_pack	Proc	Export		Import	init_main,lc_dispatcher		pea	init_main>>16		pea	init_maininit_cont			pea	1		; into the card!		jsl	lc_dispatcher		rtl;==========================================================;;  jsl init_pack_end;;  Entry point called by SCM after the format or erase is completed.;;  Inputs:      none;;  Outputs:     A = error # if C;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 = no error, 1 = error;;  This routine may move memory.;  This routine added 1/9/89 CAE.;;==========================================================		EXPORT	init_pack_endinit_pack_end				               		Import	remove_msg		pea	remove_msg>>16		pea	remove_msg		bra	init_cont		EndP		Eject*****************************************************************************************************save_my_dp	Proc** Description*	Saves the FST work area prior to making a call to an FST** Inputs:*	none** Outputs:*	none** External Refs:		with	my_direct_page** Entry Points:*	none*		longa	on			; mode		longi	on*****************************************************************************************************		ldx	#my_dp_size-2@loop		lda	<my_direct_page,x	;copy from direct page to save area		sta	>saved_dp,x		dex		dex		bpl	@loop			;loop until X drops below $00		rts		EndProc		Eject*****************************************************************************************************restore_dp	Proc** Description*	Restores the contents of my direct page after a call to an FST** Inputs:*	none** Outputs:*	none** External Refs:		with	my_direct_page** Entry Points:*	none*		longa	on			; mode		longi	on*****************************************************************************************************		php				;save status		pha				;and possible error code		ldx	#my_dp_size-2@loop		lda	>saved_dp,x		;copy from save area to direct page		sta	<my_direct_page,x		dex		dex		bpl	@loop			;until X drops below $00				pla				;restore accumulator		plp				; and status		rts		EndProc		Eject*****************************************************************************************************call_judgename	Proc	Export** Description*	Used by Init Manager to perform an internal call to an FST's JudgeName*	facility.  Must first buffer off some SCM variables, then call a SCM*	internal entry point, then restore SCM's variables.** Inputs:*	jn_parms set up properly** Outputs:*	Acc = error code from JudgeName call, if any*	jn_parms contains parameters returned from call** External Refs:		Import	do_judgename,jn_parms		Import	class,num		; in SCM** Entry Points:*	none*		longa	on			; mode		longi	on*****************************************************************************************************		phb				; save current DBR		pea	$0000			; set to SCM's data bank		plb		plb		pei	<param_blk_ptr		;Save parameter block pointer.		pei	<param_blk_ptr+2		lda	#jn_parms		;Set param_blk_ptr to our parms.		sta	<param_blk_ptr		lda	#jn_parms>>16		sta	<param_blk_ptr+2		pei	<call_number		;Save call number.		lda	#$2007			;Set call number (JudgeName).		sta	<call_number				lda	|num			;Save num		pha		lda	#7*2			;Set num to call # times 2.		sta	|num		lda	|class			;Save class.		pha		lda	#0002			;Set to class 1.		sta	|class		jsr	save_my_dp		; save my direct page values		jsr	do_judgename		; make the JudgeName call		jsr	restore_dp		; restore my direct page values		plx				;Restore class.		stx	|class				plx				;Restore num.		stx	|num		plx				;Restore call number.		stx	<call_number		plx				;Restore parameter block pointer.		stx	<param_blk_ptr+2		plx		stx	<param_blk_ptr		plb				; restore my DBR		rtl		export	jn_parmsjn_parms	ds	jn_parmBlock		;parameter block for JudgeName call		EndProc		eject;==========================================================;;  cp[n]_t2x_t3y;;  Copies n words of data from [<init_temp_2],x;  to [<init_temp_3],y and increments each by 2n.;;  Inputs:      init_temp_2 = source base;               init_temp_3 = dest base;               X = source data offset;               Y = dest data offset;;  Outputs:     A = trashed;               X = incremented by 2n;               Y = incremented by 2n;               P = nvmxdizc;                   ..000...;;==========================================================cp8_t2x_t3y	Proc	Export		Export	CP1_T2X_T3Y,CP4_T2X_T3Y		with	my_direct_page		jsl	cp4_t2x_t3ycp4_t2x_t3y		jsl	cp2_t2x_t3ycp2_t2x_t3y		jsl	cp1_t2x_t3ycp1_t2x_t3y		phy		txy		lda	[<init_temp_2],y		ply		sta	[<init_temp_3],y		inx		inx		iny		iny		rtl		EndP		eject;==========================================================;;  jsl get_msg_address;;  called by the language card stuff to get the address;  of the strings table.;;==========================================================get_msg_address	Proc	Export		Import	e1_msg_address		lda	>e1_msg_address		tax		lda	>e1_msg_address+2		tay		rtl		EndP if 0 then;==========================================================;; record used to save and restore my direct page variables around; a call to an FST;;==========================================================saved_dp	Record		ds.b	my_dp_size		EndR endif		eject;==========================================================;;  Contained here is data which MUST be in non-language;  card area, because it is accessed by the console driver.;;==========================================================std_buffer	Record	Export		DC.L	0		Export	set_list_strset_list_str	DC.B	6		DC.B	$01,$02		; push vp, set vp		DC.B	0,0,0,0; the order of the following terminators is important.  If you change it, you must; change the constant comparison operands in 'handle_edit'		Export	term_list,term_list_len:equterm_list			dc.b	$7f,%11100011	; termMask		dc.w	5		; termCount (5 terminators)		dc.b	$0d,%10000000	; Return w/Apple key		dc.b	$1b,%00000000	; Esc		dc.b	$09,%00000000	; Tab		dc.b	'?',%10100001	; Open-Apple ?, interrupt		dc.b	'/',%10100000	; Open-Apple /, interruptterm_list_endterm_list_len	equ	term_list_end-term_list		Export	dflt_input_portdflt_input_port	dc.b	' '		; fillChar		dc.b	$80		; defCursor		dc.b	$80		; cursorMode		dc.b	$FF		; beepFlag		dc.b	$00		; entryType		Export	input_portinput_port	ds	InputPortRec		EndR		DataChk	on		;===============================================================================;; init.1.e;;===============================================================================init_1_end	PROC			ENDP		init_1_dummy	PROC	org init_1_max, skip	;generate an error if code is too big		ENDP		END