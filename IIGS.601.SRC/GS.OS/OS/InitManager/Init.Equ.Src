		string	asis;==========================================================;;  init.equ;;  Direct page, data structure definitions, etc for;  the GS/OS initialization package.;;  Author:      Andy Stadler;  Created:     15-Dec-87;;  Copyright (C) 1987-1989 Apple Computer, Inc.;  All Rights Reserved.;;==========================================================;; data template for the format list records;fmt_list_record	record	0df_mem_ptr	ds.l	1		; pointer to stringdf_mem_flag	ds.b	1		; list mgr enable bitsdf_fill_byte	ds.b	1		; filler byte (unused)df_refnum	ds.w	1		; my refnumdf_one_fst	ds.w	1		; first applicable fstdf_string	ds.l	1		; descriptor string vpdf_conf_num	ds.w	1		; driver's refnumdf_alias	ds.w	1		; alias format refnumdf_flags	ds.w	1		; format type flagsdf_block_ct	ds.l	1		; blocks createddf_block_sz	ds.w	1		; block sizedf_interleave	ds.w	1		; interleave factor 1:ndf_fmt_size	ds.w	1		; format total size (for display)df_size		endr;; data template for the FST list records;fst_list_record	record	0ff_mem_ptr	ds.l	1		; pointer to stringff_mem_flag	ds.b	1		; list mgr enable bitsff_fill_byte	ds.b	1		; filler byte (unused)ff_refnum	ds.w	1		; my entry #ff_fs_num	ds.w	1		; file system #ff_block_sz	ds.w	1		; block sizeff_max_blocks	ds.l	1		; max block countff_min_blocks	ds.l	1		; min block countff_flags	ds.w	1		; format type flagsff_match_ct	ds.w	1		; applicable dev fmt countff_match_lst	ds.l	1		; applicable dev fmt listff_prompt	ds.l	1		; pointer to prompt string returned by JudgeNameff_size		endr;; data template for the text list records;tx_list_record	Record	0member_ptr	ds.l	1		; pointer to member list recordsport		ds.b	4		; rect defining textportnum_entries	ds.w	1		; number of entries in listcurrent_entry	ds.w	1		; current selectiontop_entry	ds.w	1		; entry currently displayed at toplist_entry_size	ds.w	1		; size of member records		EndR;; data template for my Direct Page usage;my_direct_page	record	$80		; starts in FST work areafmt_list_vp	ds.l	1		; VP to format list recordsfmt_list_ptr	ds.l	1		; pointer to format list recordsfmt_list_entry	ds.l	1		; pointer to single format list recordfmt_disp_cnt	ds.w	1		; number of records in format list to displayfmt_total_cnt	ds.w	1		; number of records in format listfst_list_vp	ds.l	1		; VP to FST list recordsfst_list_ptr	ds.l	1		; pointer to FST list recordsfst_list_entry	ds.l	1		; pointer to single FST list recordfst_list_cnt	ds.w	1		; number of records in FST listfmt_def_fmt	ds.w	1		; driver's default formatfmt_cur_med	ds.w	1	chosen_fst	ds.w	1		; selected FSTchosen_fmt	ds.w	1		; selected formatinit_choice	ds.w	1		; result of dialog, 0 = cancel, 1 = do it!init_screen	ds.w	1		; state of screen on entry - grx vs. txtinit_temp_1	ds.l	1		; temporary storageinit_temp_2	ds.l	1	init_temp_3	ds.l	1	init_temp_4	ds.l	1	common_end; the following are for use by the Graphics dialog only		org	common_endsave_rts	ds.w	1		; used to save RTS address during tool callinit_window	ds.l	1		; window record pointer for grx windowok_handle	ds.l	1		; handle to default button control recordedit_handle	ds.l	1		; handle to editLine control recordlist1_handle	ds.l	1		; handle to FST list control recordlist2_handle	ds.l	1		; handle to format list control recordend_grx_dp			;end of graphics direct page; the following are used by the Text dialog only		org	common_endtop_bar_pos	ds.w	1		; currently active 'control'tx_cur_entry	ds.w	1	tx_list_ptr	ds.l	1	tx_entry_ptr	ds.l	1	txt_name_ptr	ds.l	1		;pointer to name buffer for text dialogend_txt_dp				;end of text direct page		org			;reset assembler PC to maxend_my_dpmy_dp_size	equ	end_my_dp-my_direct_page		endr;------------------------------------------header_length	equ	$30init_1_org	equ	$00b200init_1_max	equ	$00b300init_2_org	equ	$00d400init_2_max	equ	$00e000init_3_org	equ	$01d000init_3_max	equ	$01e000init_4_org	equ	$E0d400init_4_max	equ	$E0e000; miscellaneous equatesdest_length	equ	16; control id equatesCancelButtonID	equ	1defaultButtonID equ	2fstListID	equ	3intrlvListID	equ	4editLineID	equ	5jn_parmBlock	Record	0			;template for parameter blockpCount		ds.w	1			;pCount, get's set externallyfileSysID	ds.w	1			;file system IDnameType	ds.w	1			;name type = volume namesyntax		ds.l	1			;storage for syntax prompt pointermaxLen		ds.w	1			;max length of namename		ds.l	1			;points to new volume namenameFlags	ds.w	1			;translation flags		EndRInputPortRec	Record	0			;template for Console Driver InputPortRecfillChar	ds.b	1defCursor	ds.b	1cursorMode	ds.b	1beepFlag	ds.b	1entryType	ds.b	1exitType	ds.b	1lastChar	ds.b	1lastMod		ds.b	1lastTermChar	ds.b	1lastTermMod	ds.b	1cursorPos	ds.b	1inputLength	ds.b	1originH		ds.b	1originX		ds.b	2originV		ds.b	1		EndR		Macro		_SysBeep		ldx	#$2c03		jsl	$E10000		MEndcautionIcon	equ	$07ff0004stopIcon	equ	$07ff0002rIcon		equ	$8001; console driver control codessaveTxtPort	equ	$01			;save the current text portsetTxtPortSize	equ	$02			;set the text port boundariesclearBOL	equ	$03			;clear to beginning of linepopTxtPort	equ	$04			;pop text porthScroll		equ	$05			;horizontal scrollsetVertPosition	equ	$06			;set vertical cursor positionbell		equ	$07			;beep!backspace	equ	$08			;backspacetab		equ	$09linefeed	equ	$0AclearEOS	equ	$0B			;clear to end of text portclearScreen	equ	$0C			;clear textport & home cursorcarriageReturn	equ	$0Dnormal		equ	$0E			;set display format to normalinverse		equ	$0F			;set display format to inversespaceExpansion	equ	$10			;DLE space expansioncolumn40	equ	$11			;set 40-column modecolumn80	equ	$12			;set 80-column modeclearBOS	equ	$13			;clear to beginning of text portsetHorzPosition	equ	$14			;set horizontal positionsetCursWord	equ	$15			;set cursor movement wordscrollDown	equ	$16			;scroll text down one linescrollUp	equ	$17			;scroll text up one linemouseOff	equ	$18			;disable MouseText mappinghomeCursor	equ	$19			;reset cursor to upper left cornerclearLine	equ	$1A			;clear current cursor linemouseOn		equ	$1B			;enable MouseText mappingcursorRight	equ	$1C			;move cursor rightclearEOL	equ	$1D			;clear to end of linegotoxy		equ	$1E			;goto x,ycursorUp	equ	$1F			;move cursor up