		string	asis		pagesize 70				longa	on		longi	on		;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------		Import	CurrentFST		IMPORT	get_string		IMPORT	lc_dispatcher		IMPORT	warn_rect		IMPORT	which_call		IMPORT	which_class		print	push		print	off		Include	'common.equ.src' 		include	'init.equ.src'		include 'E16.Control'		include 'E16.Window'		print	pop;===============================================================================;; init.2.s;;===============================================================================init_2_header	PROC	org init_2_org-header_length		Import	init_2_start,init_2_end		msb	on		DC.W	init_2_end-init_2_start		DC.L	init_2_org		DC.W	$8000		DC.B	'Init Manager part 2   v04.02'	;2-Apr-93 SS		DC.B	00		msb	off		ENDP		init_2_start	PROC	org init_2_org			ENDP		Eject;==========================================================;;  file init.2;;  Contains the main dispatcher, core routines and the;  graphics user interface portions of the init package,;  or at least as much of them as will fit in 3k.;;  Author:      Andy Stadler;  Created:     29-Jan-88;  Modified:    See modification history below;;  Copyright (C) 1988-1989 Apple Computer, Inc.;  All Rights Reserved.;;==========================================================;==========================================================;;  file init.main;;  Actually handles dispatching the $24 and $25 calls.;;  Author:      Andy Stadler;  Created:     1-Jan-88;  Modified:    See modification history below;;  Copyright (C) 1987 Apple Computer, Inc.;  All Rights Reserved.;;==========================================================;;  Modification history:;;  01-Feb-88    ADS     Initial release;  23-Feb-88    ADS     Setting my own data bank;                       Using that for data area references;  06-Apr-88    CAE     Modified to handle new field in class 1 calls;  21-Dec-88	CAE	Added line in init_main to jsr to display_msg;  09-Jan-89	CAE	Added line in init_main to clear msg_flag;  09-Mar-89	CAE	Moved jsr setup_screen to init_present to fix bug;  26-Jul-89	CAE	Split setup_screen into 2 routines and modified;			init_present to fix bug in which the init_screen;			flag was not initialized in the non-dialog mode;			which caused display_msg to screw up.;==========================================================;==========================================================;;  init.grx;;  Super hires graphics based user interface for the;  init package.  Puts up a dialog window and prompts;  the user for selection of formatting options.;;  Author:      Andy Stadler;  Created:     11-Jan-88;  Modified:    See modification history below;;  Copyright Apple Computer, Inc. 1987-1989;  All rights reserved.;;==========================================================;;  Mod history;;  01-Feb-88    ADS     Initial release;  15-Feb-88    ADS     Added entry points for init.tx;                       Changed to use international strings;  23-Feb-88    ADS     General crunching;                       Additions for 'format too large' indicator;  30-Mar-88    CAE     Changed to use strings which say;                       'Format' or 'Erase' instead of 'Initialize';  06-Apr-88    CAE     Modified to handle new field in class 1 calls;;==========================================================		eject;==========================================================;;  file init.core;;  Contains the main routines for the init package.;  Everything past the entry vectors but not including;  user interface.;;  This is all a part of the bank 1 language card area.;;  Author:      Andy Stadler;  Created:     15-Dec-87;  Modified:    See modification history below;;  Copyright (C) 1987 Apple Computer, Inc.;  All Rights Reserved.;;==========================================================;;  Modification history:;;  01-Feb-88    ADS     initial release;  04-Feb-88    ADS     hooked to actual text dialog;  10-Feb-88    ADS     make_fmt_str will round up drive;                       sizes instead of truncating, so a;                       19.8 Meg hard disk says 20MB.;  23-Feb-88    ADS     General crunching;                       Use of abs mode for data area refs;                       call_tools_0 added;                       Stuff for 'size warning' messages added;  06-Apr-88    CAE     modified to handle new field in class 1 Format;                       and Erase calls;  04-May-88    CAE     Format options now show only current;                       block size if Erase call made;                       Strings in make_fmt_str routine;                       moved to data segment to gain space.;  29-Jun-88    CAE     Fixed compare code in cmp_fmt_fst.;  21-Jul-88    CAE     Fixed compare code in chk_fst_size.;  22-Jul-88    CAE     Fixed setup_screen so that it goes;                       into text mode if ListMgr not loaded.;  08-Feb-89	CAE	Added check for error after call to ;			tx_dialog in init_present.;  23-Mar-89	CAE	Modified make_fmt_str to not round up Megs;==========================================================init_core	Proc	Export;==========================================================;;  jsl call_alloc       (alloc_seg);  jsl call_deref       (deref);  jsl call_release     (release_seg);  jsl call_dispatch    (dev_dispatcher);;  Since this code is in the language card, glue is needed;  to get to external routines.;;  jsr call_tools_0     ($E10000);;  Saving 1 byte per call adds up!;;  Inputs & Outputs:  As per the actual routines.;;; Change History;; 10 Feb 89	Bryan, Ray and Steve;; To save a few bytes we share a little code.;;==========================================================		EXPORT	call_alloccall_alloc		pea	#^alloc_seg		pea	|alloc_seg		;Low word only		bra	ShareDispatch		EXPORT	call_derefcall_deref		pea	#^deref		pea	|deref			;Low word only		bra	ShareDispatch		EXPORT	call_releasecall_release		pea	#^release_seg		pea	|release_seg		;Low word only		bra	ShareDispatch		EXPORT	call_dispatchcall_dispatch		pea	#^dev_dispatcher		pea	|dev_dispatcher		;Low word only		bra	ShareDispatch		Export	call_lock_memcall_lock_mem		pea	#^lock_mem		; sys service call		pea	|lock_mem		;Low word only		bra	ShareDispatch		Export	call_unlock_memcall_unlock_mem		pea	#^unlock_mem		;sys service call		pea	|unlock_mem		;Low word onlyShareDispatch	pea	0		jsl	>lc_dispatcher		rtl		entry	call_tools_0call_tools_0		with	my_direct_page		pla		sta	<save_rts		jsl	$E10000		pei	<save_rts		rts		EndP		eject;==========================================================;;  nextmember_1;  nextmember_2;;  This quite common call is centralized here.;;  Outputs:     A = item number returned from NextMember call;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..0;;==========================================================nextmember_1	Proc		with	my_direct_page		ldx	<list1_handle		ldy	<list1_handle+2		bra	nextmember_com		Entry	nextmember_2nextmember_2		ldx	<list2_handle		ldy	<list2_handle+2nextmember_com		lda	#0		pha				; word result		pha				; NIL = search all entries		phy				; handle to list control		phx		ldx	#$121C			; NextMember2		jsr	call_tools_0		pla				; result		rts		EndP		eject;==========================================================;;  make_fmt_ptr;;  fmt_list_entry  <-  fmt_list_ptr + (A * fd_size);;  Inputs:      fmt_list_ptr = ptr to list of available formats;               A = index number of desired entry;;  Outputs:     fmt_list_entry = ptr to desired entry;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================make_fmt_ptr	Proc		with	my_direct_page,fmt_list_record		tax		beq	make_fmt_ptr_2		; if index == 0 then offset = 0		lda	#0make_fmt_ptr_1		clc		adc	#df_size		dex		bne	make_fmt_ptr_1make_fmt_ptr_2		clc		adc	<fmt_list_ptr		sta	<fmt_list_entry		lda	#0		adc	<fmt_list_ptr+2		sta	<fmt_list_entry+2		rts		export	jsl_fmt_ptrjsl_fmt_ptr	jsr	make_fmt_ptr		; so I can call from bank 1		rtl		EndP		eject;==========================================================;;  make_fst_ptr;;  fst_list_entry  <-  fst_list_ptr + (A * ff_size);;  Inputs:      fst_list_ptr = ptr to list of available file systems;               A = index number of desired entry;;  Outputs:     fst_list_entry = ptr to desired entry;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================make_fst_ptr	Proc		with	my_direct_page,fst_list_record		tax		beq	make_fst_ptr_2		; if index == 0 then offset = 0		lda	#0make_fst_ptr_1		clc		adc	#ff_size		dex		bne	make_fst_ptr_1make_fst_ptr_2		clc		adc	<fst_list_ptr		sta	<fst_list_entry		lda	#0		adc	<fst_list_ptr+2		sta	<fst_list_entry+2		rts		EXPORT	jsl_fst_ptrjsl_fst_ptr	jsr	make_fst_ptr		; so I can call from bank 1		rtl		EndP		eject;==========================================================;;  cmp_fmt_fst;;  Compare a file system with a hard format and determine;  if they are compatible.;;  The rules are:;  (0)  if we are doing $25 ERASE_DISK, only the currently;               installed media is legal.;  (1)  flags:  one or both must be 0 (universal), OR;               the flags must match;  (2)  block count: driver block count must be within;               minimum and [maximum] specified by FST.;  (3)  block size: must match.;;  If they don't match, take a look at the alias field, because;  there might be another format which does.;;  Inputs:      fmt_list_entry = ptr to format in question;               fst_list_entry = ptr to file system in question;;  Outputs:     A = if C = 0, index # of selected FST;                   if C = 1, not valid;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 == compatible, 1 == incompatible;;  Uses:        init_temp_4;;==========================================================cmp_fmt_fst	Proc		with	my_direct_page,fst_list_record,fmt_list_record		pei	<fmt_list_entry		; record starting point		pei	<fmt_list_entry+2cmp_fmt_fst_0		lda	|which_call		; if FORMAT, all formats legal		beq	cmp_fmt_fst_05;  erase_disk, only current format is legal		ldy	#df_conf_num		; get driver's number		lda	[<fmt_list_entry],y		cmp	<fmt_cur_med		bne	cmp_fmt_fst_nocmp_fmt_fst_05		ldy	#df_flags		lda	[<fmt_list_entry],y		and	#$0003		beq	cmp_fmt_fst_1		; universal driver.  OK		ldy	#ff_flags		eor	[<fst_list_entry],y		and	#$0003		beq	cmp_fmt_fst_1		; driver & fst match.  OK		lda	[<fst_list_entry],y		and	#$0003		beq	cmp_fmt_fst_1		; universal fst, OK		cmp	#$0003			; Apple ][ only?		bne	cmp_fmt_fst_no		; nope, no match		ldy	#df_flags		; look at the device flags again		lda	[<fmt_list_entry],y		lsr	a			; Apple-generic format?		bcc	cmp_fmt_fst_no		; no, can't use it;  compare the block sizes.cmp_fmt_fst_1		ldy	#df_block_sz		lda	[<fmt_list_entry],y		ldy	#ff_block_sz		cmp	[<fst_list_entry],y		bne	cmp_fmt_fst_no;  compare the block count with the min & max.  this is messy;  because 4 byte comparisons.		ldy	#df_block_ct		; get device block count		lda	[<fmt_list_entry],y		sta	<init_temp_4		iny		iny		lda	[<fmt_list_entry],y		sta	<init_temp_4+2		ldy	#ff_min_blocks+2		cmp	[<fst_list_entry],y	;is block count < min allowed?		blt	cmp_fmt_fst_no		;yes - so no match		bne	cmp_min_ok		;it's > min allowed so OK		dey		dey		lda	<init_temp_4		cmp	[<fst_list_entry],y		blt	cmp_fmt_fst_nocmp_min_ok					;block count >= min allowed;  match!  return carry clear		clc		bra	cmp_fmt_fst_y;  no match.  if alias, loop.  If none, return carry clearcmp_fmt_fst_no		ldy	#df_alias		lda	[<fmt_list_entry],y		beq	cmp_fmt_fst_x		sta	<init_temp_4		; must look for this entry		stz	<init_temp_4+2		; countercmp_fmt_fst_lp		lda	<init_temp_4+2		jsr	make_fmt_ptr		ldy	#df_conf_num		lda	[<fmt_list_entry],y		cmp	<init_temp_4		beq	cmp_fmt_fst_0		; found alias!		inc	<init_temp_4+2		lda	<init_temp_4+2		cmp	<fmt_total_cnt		bne	cmp_fmt_fst_lpcmp_fmt_fst_x		seccmp_fmt_fst_y		ldy	#df_refnum		; get the refnum		lda	[<fmt_list_entry],y		plx				; restore starting point		stx	<fmt_list_entry+2		plx		stx	<fmt_list_entry		rts		EndP		eject;==========================================================;;  deref_lists;;  fmt_list_vp  ->  fmt_list_ptr;  fst_list_vp  ->  fst_list_ptr;;  Inputs:      fmt_list_vp = VP of available formats;               fst_list_vp = VP of available file systems.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================jsl_deref	Proc	Export		Import	deref_lists		jsl	deref_lists		; so I can call into bank 1		rts		EndP		eject;==========================================================;;  find_matches;;  First, for each file system, build a list of all applicable;  formatting options.  Then, for each format, find the;  number of the first applicable file system.  If no matches;  are found for a particular entry, make it non-selectable (dim).;  If no matches are found in the entire group, formatting is;  impossible.;;  Inputs:      fmt_list_vp = VP of available formats;               fst_list_vp = VP of available file systems.;;  Outputs:     A = error code if C == 1;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0=no error, 1=no matches found;;  This routine may move memory.;;==========================================================find_matches	Proc	Export		with	my_direct_page,fst_list_record,fmt_list_record		Import	pb_reqFileSysID,pb_flags;  for each fst, check all formats		stz	<init_temp_1		; fst counter		stz	<init_temp_3		; match counter;  loop here through file systemsfind_matches_1		lda	<fmt_disp_cnt		; get memory for the list		asl	a			; word entries		sec		jsl	call_alloc		phy		phx		jsr	jsl_deref		; make ptrs		lda	<init_temp_1		jsr	make_fst_ptr		ldy	#ff_match_lst		; install vp of list into fst rec		pla		sta	[<fst_list_entry],y		tax		iny		iny		pla		sta	[<fst_list_entry],y		tay		jsl	call_deref		; make ptr to new list		stx	<init_temp_2		sty	<init_temp_2+2		stz	<init_temp_1+2		; fmt counter;  loop here through formats, checking against the current fstfind_matches_2		lda	<init_temp_1+2		jsr	make_fmt_ptr		jsr	cmp_fmt_fst		; are they compatible?		bcs	find_matches_3		; no.;  compatible.  insert fmt index in fst's list		ldy	#ff_match_ct		lda	[<fst_list_entry],y		inc	a		sta	[<fst_list_entry],y		dec	a		asl	a		tay		lda	<init_temp_1+2		sta	[<init_temp_2],y		inc	<init_temp_3		; flag successes;  move to next fmtfind_matches_3		inc	<init_temp_1+2		lda	<init_temp_1+2		cmp	<fmt_disp_cnt		bne	find_matches_2;  Dim if no matches found.  Move to next fst		ldy	#ff_match_ct		lda	[<fst_list_entry],y		bne	find_matches_35		ldy	#ff_mem_flag		lda	#%01100000		; disable & inactive bits		sta	[<fst_list_entry],yfind_matches_35		inc	<init_temp_1		lda	<init_temp_1		cmp	<fst_list_cnt		bne	find_matches_1;  now do the whole thing over but searching for a single fst;  to match each format.		stz	<init_temp_1		; fmt counter;  loop here through formatting optionsfind_matches_4		lda	<init_temp_1		jsr	make_fmt_ptr		stz	<init_temp_1+2		; fst counter;  loop here through file systems, checking against the current formatfind_matches_5		lda	<init_temp_1+2		jsr	make_fst_ptr		jsr	cmp_fmt_fst		; are they compatible?		bcc	find_matches_6		; yes;  no match.  try next file system		inc	<init_temp_1+2		lda	<init_temp_1+2		cmp	<fst_list_cnt		bne	find_matches_5;  no fst matches this format.  disable it		ldy	#df_mem_flag		lda	#%01100000		; disable & inactive bits		sta	[<fmt_list_entry],y		bra	find_matches_7;  compatible.  insert fst index in fmt recordfind_matches_6		ldy	#df_one_fst		lda	<init_temp_1+2		; index # of this fst		sta	[<fmt_list_entry],y		inc	<init_temp_3		; flag successes;  move to next fmtfind_matches_7		inc	<init_temp_1		lda	<init_temp_1		cmp	<fmt_disp_cnt		bne	find_matches_4;  all done.  return error if no lists built		ldx	#drvr_wr_prot		; assume error		lda	<init_temp_3		bne	find_matches_8error		txa				; put error code in accumulator		sec		rtsfind_matches_8		lda	pb_reqFileSysID		; valid ID supplied?		beq	@skip_check		; no, must be selectable; The caller supplied an FST ID that they want us to use for the format. Therefore,; we should probably check the supplied ID to make sure that it's in our list of FSTs; that support formatting.  If not, we either return an InvalidFSTop error code (if the; FST is not selectable), or we zero the reqFileSysID variable so that the default FST; is automatically selected.		lda	#0		sta	<init_temp_1@loop		jsr	make_fst_ptr		ldy	#ff_fs_num		; get the FST ID from the record		lda	[<fst_list_entry],y		cmp	pb_reqFileSysID		; do they match?		beq	@found_it		; yes, go check the format count@next_one		inc	init_temp_1		; bump counter		lda	init_temp_1		; are we done yet?		cmp	fst_list_cnt		bne	@loop			; no, go do the next one		bit	pb_flags		; selectable FST?		bvs	@set_id			; yes, just ignore		ldx	#invalid_fst_op		; FST not found in the list		bra	error@set_id		stz	pb_reqFileSysID		; clear the variable		bra	@skip_check@found_it		ldx	#invalid_fst_op		; preset error code		ldy	#ff_match_ct		; get the format match count for this FST		lda	[<fst_list_entry],y	; if there's no compatible format,		beq	error			;   then we error out@skip_check		lda	#0			; no error		clc		rts		EndP		eject;==========================================================;;  jsl chk_fst_size;;  Formatting FST's onto 'too-large' volumes is allowed ;;  but a warning is presented if this is true to remind;  the user that they are a bozo.;;  Inputs:      fst_list_entry = currently selected fst;               fmt_list_entry = currently selected fmt;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 = fst fits format;                          1 = format too big;;==========================================================chk_fst_size	Proc	Export		with	my_direct_page,fst_list_record,fmt_list_record		jsr	cmp_fmt_fst		; I know they match.  This points us		jsr	make_fmt_ptr		; to the actual fmt (if alias'd);  Now compare the block counts		ldy	#ff_max_blocks+2		lda	[<fst_list_entry],y		ldy	#df_block_ct+2		cmp	[<fmt_list_entry],y		blt	chk_fst_err		; too big in hi word		bne	chk_fst_ok		; smaller in hi word		ldy	#ff_max_blocks		; hi word is equal if get here		lda	[<fst_list_entry],y		ldy	#df_block_ct		cmp	[<fmt_list_entry],y		blt	chk_fst_err		; too big in lo wordchk_fst_ok		clc		rtlchk_fst_err		sec		rtl		EndP		eject;==========================================================;;  set_driver_fmt;;  Transmit a selected hard format option to the driver.;  There is no error checking, because if the driver has;  no options, it simply ignores the call.;;  Inputs:      chosen_fmt = my refnum of chosen format;               dev_num = driver number;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================set_driver_fmt	Proc	Export		with	my_direct_page,fmt_list_record		jsr	jsl_deref		; convert my ref# to drivers ref#		lda	<chosen_fmt		jsr	make_fmt_ptr		ldy	#df_conf_num		lda	[<fmt_list_entry],y		sta	<init_temp_1		; becomes the control list		lda	#direct_base+init_temp_1		sta	<drvr_clist_ptr		stz	<drvr_clist_ptr+2		lda	<dev_num		sta	<drvr_dev_num		lda	#$0006			; 6 = 'control'		sta	<drvr_call_num		dec	a			; 5 = 'set format options'		sta	<drvr_ctrl_code		lda	#2		sta	<drvr_req_cnt		stz	<drvr_req_cnt+2		jsl	call_dispatch		rts		EndP		eject;==========================================================;;  grx_too_big;;  If the current fst is not big enough for the current;  format, we will let them format, but we give them a;  nasty note.;;  e.g. ProDOS (32Mb max) onto an HD40SC.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================grx_too_big	Proc		Import	draw_caution		with	my_direct_page		jsr	nextmember_1		; fst selected?		beq	grx_clr_warn		; nothing selected		dec	a			; fix ListMgr's item number		jsr	make_fst_ptr		; fill in fst_list_entry		jsr	nextmember_2		; fmt selected?		beq	no_change		; nothing selected		dec	a			; fix ListMgr's item number		jsr	make_fmt_ptr		; fill in fmt_list_entry;  find out if the current pair is ok		jsl	chk_fst_size		; fills the string if a problem		bcc	no_change;  display the warninggrx_show_warn		lda	#28-64			; message # - 64		cmp	currentFST		; is the message already displayed?		beq	no_change		; yes, don't bother redisplaying		sta	currentFST		; update message #		lda	#28			; get the real message #		jsr	draw_caution		; go draw the message		sec				; signify that we put up the messageno_change		rts;  everybody happy.  No warning		Entry	grx_clr_warngrx_clr_warn		pea	warn_rect>>16		; bounding box		pea	warn_rect		ldx	#$5504			; EraseRect		jsr	call_tools_0		stz	currentFST		; clear message area		clc				; no message is displayed now		rts		EndP		eject;==========================================================;;  setup_screen1;  setup_screen2;;  Examine the current configuration of the system to;  determine if we can legally use the graphics based;  interface.  If not, we will have to create a text;  based interface using the console driver.;;  Outputs:     init_screen = -1 = graphics;                              0 = text;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================setup_screen1	Proc	Export         		with	my_direct_page		stz	<init_screen		;init to text mode		pha		ldx	#$0605			; DeskStatus		jsr	call_tools_0		pla		beq	setup_text		pea	0			; in case list mgr isn't loaded		ldx	#$061C			; ListStatus		jsr	call_tools_0		pla		beq	setup_text		sep	#$20			; 8 bit accum.		lda	|$C029			; new_video		rep	#$20		and	#$0080			; super high res on?		beq	setup_text		pha				; result space		ldx	#$1704			; GetMasterSCB		jsr	call_tools_0		pla		and	#%10000000		; 320 or 640 mode?		beq	setup_text		; 320, use text mode		pha		pha		ldx	#$2F02			; RealFreeMem		jsr	call_tools_0		pla		pla		cmp	#$0001			; 64k available?		blt	setup_text		dec	<init_screen		; passed all tests so use graphics modesetup_text	rts				 		EndP;----------------------------------------------------------setup_screen2	Proc	Export		Import	gsos_id		with	my_direct_page;  try to get a 1k stack for the grx routines.		lda	#0		pha				; returns long		pha		pha				; size $00000400  (1k)		pea	$400		lda	>gsos_id		; use Mike's memory ID		pha		pea	$C011			; locked,no bank cross,spec. bank		lda	#0		pha				; must be bank 0		pha		ldx	#$0902			; NewHandle		jsr	call_tools_0		pla		sta	<init_window		; cached here for now		pla		sta	<init_window+2		bcc	got_grx_stack		stz	<init_screen		; didn't get mem so use text modegot_grx_stack	rts		EndP		eject;==========================================================;;  set_grx_stack;;  Many of the toolbox routines require more stack space;  than is provided by GS/OS.  The screen chooser has;  reserved 1k for me and cached its handle at <init_window.;;  Inputs:      GS/OS stack: |  ret addr  |  of my caller;                            |-          -|;                            |            | <- SP;;  Outputs:     New stack:   |  GS/OS SP  |;                            |-          -|;                            |  ret addr  | of my caller;                            |-          -|;                            |            | <- SP;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  This routine may move memory.;;==========================================================set_grx_stack	Proc		with	my_direct_page		lda	[<init_window]		; the base of the new stack		clc		adc	#$03FF			; and this is the new SP		sta	<init_window		plx				; get return addr		tsc		tay		lda	<init_window		tcs				; set to new stack		phy				; push old sp		phx				; push ret addr		rts		EndP		eject;==========================================================;;  reset_grx_stack;;  Switch back to the normal GS/OS stack.;;  Inputs:      New stack:   |  GS/OS SP  |;                            |-          -|;                            |  ret addr  | of my caller;                            |-          -|;                            |            | <- SP;;  Outputs:     GS/OS stack: |  ret addr  |  of my caller;                            |-          -|;                            |            | <- SP;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================reset_grx_stack	Proc		with	my_direct_page		pla				; store return addr		sta	<init_temp_1		pla				; store GS/OS stack addr		sta	<init_temp_1+2		tsc				; find handle for my stack		pha		pha		pea	0			; always bank 0		pha		ldx	#$1A02			; FindHandle		jsr	call_tools_0		plx				; save it		ply		lda	<init_temp_1+2		; restore GS/OS stack		tcs		phy				; then dump the 1k stack		phx		ldx	#$1002			; DisposeHandle		jsr	call_tools_0		pei	<init_temp_1		; return address		rts		EndP		eject;==========================================================;;  fix_cursor;  restore_cursor;;  Often the calling application sets the cursor to the;  'watch' cursor because init can be a time consuming;  operation.  For the purposes of my interface, I need;  a pointer.;;  'fix_cursor' stores the current state of the cursor;  and replaces it with the standard pointer.;;  Outputs:     save_cursor = pointer to old cursor record;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  'restore_cursor' puts it back to whatever the application;  wanted.;;  Inputs:      save_cursor = pointer to original cursor;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================fix_cursor	Proc		Import	save_cursor		pha		pha		ldx	#$8F04			; GetCursorAdr		jsr	call_tools_0		pla		sta	|save_cursor		pla		sta	|save_cursor+2		ldx	#$CA04			; InitCursor		jsr	call_tools_0		rts		Entry	restore_cursorrestore_cursor		lda	|save_cursor+2		pha		lda	|save_cursor		pha		ldx	#$8E04		jsr	call_tools_0		rts		EndP		eject;==========================================================;;  fix_ptrs;;  (1)  lock down GS/OS memory so ptrs stay the same;;  (2)  Loop through format list, making pointers to;       the strings.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..0;;==========================================================fix_ptrs	Proc	Export		with	my_direct_page,fmt_list_record		jsl	call_lock_mem		jsr	jsl_deref		stz	<init_temp_1		; entry counterfix_ptrs_lp		lda	<init_temp_1		jsr	make_fmt_ptr		ldy	#df_string		; get the vp		lda	[<fmt_list_entry],y		tax		iny		iny		lda	[<fmt_list_entry],y		tay		jsl	call_deref		tya		ldy	#df_mem_ptr+2		sta	[<fmt_list_entry],y		dey		dey		txa		sta	[<fmt_list_entry],y		inc	<init_temp_1		lda	<init_temp_1		cmp	<fmt_disp_cnt		bne	fix_ptrs_lp		rtl		EndP		eject;==========================================================;;  setup_window;;  Create the window for the init dialog.  Also adds the;  first two controls, 'ok' and 'cancel'.;;  Outputs:     init_window = grafport of the window;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..0;;  This routine may move memory.;;==========================================================setup_window	Proc		Import	MyControls,name_default,subArray		Import	cancel_title,dflt_title,editLine		Import	init_wnd_parms,pb_flags		with	my_direct_page; create the window		pha				; returns ptr to it		pha		pea	init_wnd_parms>>16		pea	init_wnd_parms		ldx	#$090E			; NewWindow		jsr	call_tools_0		pla		sta	<init_window		pla		sta	<init_window+2; set up the volume name string pointer		lda	<path2_ptr		; make pointer to volume name string		ora	<path2_ptr+2		; was a volume name supplied?		bne	@set_it_up		; yes, set the length byte		lda	#61			; get the default volume name string		jsl	get_string		bra	@continue@set_it_up		lda	<path2_ptr		; make pointer to volume name string		clc		adc	#2			; point to $80 separator		sta	<init_temp_1		tax				; save in X		lda	<path2_ptr+2		; high word too		adc	#0		sta	<init_temp_1+2		tay				; save in Y		lda	[<path2_ptr]		; get the length word		sep	#$20			; 8-bit accumulator		dec	a			; account for missing separator		sta	[<init_temp_1]		; store on top of the $80		rep	#$20@continue		stx	name_default		; store in control template		sty	name_default+2; set up pointers to the control strings		ldx	#23			; get 'ok' string for Format call		lda	which_call		; was the call Format or Erase?		beq	its_format		; it was Format		ldx	#30			; get 'ok' string for Erase callits_format	txa		jsl	get_string		stx	dflt_title		sty	dflt_title+2		lda	#24			; get 'cancel' string		jsl	get_string		stx	cancel_title		sty	cancel_title+2; set up the list of control template pointers		ldx	#myControls+16		;just past pointers for required templates		bit	pb_flags		;editable volume name?		bpl	@static_name		;no...		lda	#editLine		;else put template pointer into list		sta	|$0000,x		inx		inx		lda	#^editLine		sta	|$0000,x		inx		inx@static_name		stz	|$0000,x		;terminate list		inx		inx		stz	|$0000,x; add the controls to the window		pha				;Result space (not used here)		pha		pei	<init_window+2		pei	<init_window		pea	$0003			;Ptr to list of Ptrs		pea	MyControls>>16		;Ptr to Ptr list		pea	MyControls		ldx	#$3110			;NewControl2		jsr	call_tools_0		pla				;Discard (not used here)		pla; retrieve the handle of the LineEdit record if it existsget_handles		bit	pb_flags		;editable volume name?		bpl	@static_name		;no...		pha				;space for result		pha		pei	<init_window+2		pei	<init_window		pea	editLineID>>16		;ID of editLineControl		pea	editLineID		ldx	#$3010			;GetCtlHandleFromID		jsr	call_tools_0		pla				;retrieve handle		sta	init_temp_1		pla		sta	init_temp_1+2				ldy	#2			;deref the control handle		lda	[init_temp_1]		sta	init_temp_2		lda	[init_temp_1],y		sta	init_temp_2+2		ldy	#octlData		;offset to LineEdit record handle		lda	[init_temp_2],y		sta	edit_handle		iny		iny		lda	[init_temp_2],y		sta	edit_handle+2@static_name; retrieve the handle of the default button control (for highlighting purposes)		pha				;space for result		pha		pei	<init_window+2		pei	<init_window		pea	defaultButtonID>>16	;ID of default button		pea	defaultButtonID		ldx	#$3010			;GetCtlHandleFromID		jsr	call_tools_0		pla				;retrieve handle		sta	ok_handle		pla		sta	ok_handle+2		; retrieve the handle to the fst list control		pha				;space for result		pha		pei	<init_window+2		; where it is		pei	<init_window		pea	fstListID>>16		;ID of fst list control		pea	fstListID		ldx	#$3010			;GetCtlHandleFromID		jsr	call_tools_0		plx		stx	<list1_handle		ply		sty	<list1_handle+2; sort the FST list before we display it		lda	#$0000		pha				; no custom sort proc		pha		phy				; sort the FST list		phx				; (X and Y still contain the handle)		ldx	#$151C			; SortList2		jsr	call_tools_0; retrieve the handle to the format options list control		pha				;space for result		pha		pei	<init_window+2		; where it is		pei	<init_window		pea	intrlvListID>>16	;ID of options list control		pea	intrlvListID		ldx	#$3010			;_GetCtlHandleFromID		jsr	call_tools_0		pla		sta	<list2_handle		pla		sta	<list2_handle+2; set up for initial JudgeName message		lda	#-2		sta	currentFST		;init variable		clc				;no errors		rts		EndP		eject;==========================================================;;  setup_lists;;  Conveniently, my data structures are compatible with;  those of the list manager.  So really all I do is tell;  the list mgr where they are, and it sets up the lists;  for me.;;  Inputs:      fst_list_ptr = deref'd & locked addr of list;               fmt_list_ptr = deref'd & locked addr of list;               init_window = grafport of the window;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..0;;  This routine may move memory.;;==========================================================setup_lists	Proc		Import	list1_size,list1_ref		Import	list2_size,list2_ref		Import	pb_reqFileSysID,pb_flags		Import	fst_adj_fmts		with	my_direct_page,fst_list_record		stz	<init_temp_1+2		; init # of selected FST		lda	pb_reqFileSysID		; valid FST ID supplied?		bne	set_default		; yes, use it as initial selection; At this point, the supplied FST ID is 0.  This means that the caller doesn't; really care what the initially selected FST is.  So, since the first FST in the; list is the boot FST, we should make sure that it's the one that is initially; selected.  (Well, we should supply SOME kinda default, shouldn't we?)		ldy	#ff_mem_flag		; get offset of memFlag field		lda	[<fst_list_ptr],y	; set it as selected		ora	#%10000000		sta	[<fst_list_ptr],y		bra	init_fst_template	; then go set the pointer in the templateset_default		stz	init_temp_1		; start at the beginning of the list@loop		lda	init_temp_1		; get the member #		jsr	make_fst_ptr		; go make a pointer		ldy	#ff_fs_num		; get the FST ID from the record		lda	[<fst_list_entry],y		cmp	pb_reqFileSysID		; do they match?		beq	@select_it		; yes, select it		bit	pb_flags		; only one FST selectable?		bvs	@next_one		; no, leave other FSTs selectable		ldy	#ff_mem_flag		; else dim it		lda	[<fst_list_entry],y		ora	#%01100000		sta	[<fst_list_entry],y		bra	@next_one@select_it		ldy	#ff_mem_flag		; set the selected bit		lda	[<fst_list_entry],y		bit	#%01100000		; first, is it selectable?		bne	@next_one		; no, so don't select it		ora	#%10000000		sta	[<fst_list_entry],y		lda	<init_temp_1		; remember which FST we've selected		sta	<init_temp_1+2@next_one		inc	init_temp_1		; bump counter		lda	init_temp_1		; are we done yet?		cmp	fst_list_cnt		bne	@loop			; no, go do the next oneinit_fst_template		lda	<init_temp_1+2		; make a pointer to the selected FST		jsr	make_fst_ptr		jsl	fst_adj_fmts		; then initialize the format selections; fill in the control template for the FST List control		lda	<fst_list_cnt		; how many entries		sta	|list1_size		lda	<fst_list_ptr		; where it be		sta	|list1_ref		lda	<fst_list_ptr+2		sta	|list1_ref+2;  Now fill in the template for the format options list control		lda	<fmt_disp_cnt		; how many entries		sta	|list2_size		lda	<fmt_list_ptr		; where it be		sta	|list2_ref		lda	<fmt_list_ptr+2		sta	|list2_ref+2		clc				; no errors		rts		EndP		eject;==========================================================;;  grx_check_name;;  Performs a full JudgeName call with the user-supplied;  volume name prior to exiting the dialog box.;;  Outputs:     P = nvmxdizc;                   ..000..|;                          0=no error, 1=name not acceptable;		path_vp = vp of name if acceptable;;  This routine may move memory.;;  Direct page variable usage is:;;	init_temp_2 = pointer to JudgeName result buffer;	init_temp_3 = handle to LineEdit item;	init_temp_4 = pointer to LineEdit item, or static name;;==========================================================grx_check_name	Proc	Export		Import	path_vp,call_judgename,name_default,pb_flags		Import	call_deref,call_alloc,call_release		Import	jn_parms:jn_parmBlock		with	my_direct_page		with	jn_parms		;gonna use JudgeName parmblock; first, get some memory to use as a Result Buffer for the JudgeName call		lda	#36			;GS/OS result buffer		jsl	call_alloc		;allocate memory for the pathname		stx	path_vp			;save VP		sty	path_vp+2		jsl	call_deref		;turn it into a pointer		stx	init_temp_2		;save pointer		sty	init_temp_2+2		txa				;save in JudgeName parmblock too		sta	>jn_parms.name		tya		sta	>jn_parms.name+2		lda	#36			;buffer length		sta	[init_temp_2]		;store in buffer		bit	pb_flags		;editable name?		bmi	@editable		;yes...		lda	name_default		;else get pointer to the name		sta	init_temp_4		lda	name_default+2		sta	init_temp_4+2		lda	[init_temp_4]		;get the length		and	#$00FF			;clear high byte		pha				;put on stack for later		inc	init_temp_4		;adjust pointer to text of name		bne	fill_result_buffer		inc	init_temp_4+2		bra	fill_result_buffer@editable		pha				;result space		pei	edit_handle+2		;handle of editLine record		pei	edit_handle		ldx	#$2314			;LEGetTextLen		jsl	$E10000		;leave length on stack		pha				;result space		pha		pei	edit_handle+2		;handle of editLine record		pei	edit_handle		ldx	#$2214			;LEGetTextHand		jsl	$E10000		pla				;retrieve handle		sta	init_temp_3		pla		sta	init_temp_3+2		lda	[init_temp_3]		;deref LineEdit text handle		sta	init_temp_4		ldy	#2		lda	[init_temp_3],y		sta	init_temp_4+2fill_result_buffer		ldy	#2		lda	1,s			;retrieve LineEdit item length		cmp	#33			;> 32 characters?		bcc	@good_length		;no...		lda	#32			;else peg it out at 32		sta	1,s			;update length on stack@good_length		sta	[init_temp_2],y		;store in buffer		lda	init_temp_2		;adjust pointer to result buffer		clc		adc	#4			;to skip buffer length and string length		sta	init_temp_2		bcc	@1		inc	init_temp_2+2@1		ply				;retrieve length		sep	#$20			;8-bit accumulator		longa	off		dey				;adjust for first character@loop		lda	[init_temp_4],y		sta	[init_temp_2],y		dey		bpl	@loop			;copy volume name to result buffer		rep	#$20			;16-bit accumulator again		longa	on		lda	#6			;reset pCount		sta	>jn_parms.pCount		lda	#0		sta	>jn_parms.nameFlags	;clear translation flags				pea	call_judgename>>16		pea	call_judgename		pea	0		jsl	>lc_dispatcher		; call JudgeName to get the prompt pointer		lda	>jn_parms.nameFlags	;was the FST happy?		and	#$E000			;mask off reserved bits		clc				;assume it was OK		beq	@name_good		;yes, exit		ldx	path_vp			;get the VP to the result buffer		ldy	path_vp+2		jsl	call_release		;release it back to the system		stz	path_vp			;null out pointer		stz	path_vp+2		sec				;return error@name_good		rts		EndP		eject;==========================================================;;  draw_caution;;  Draws the Caution icon and an associated message in the;  message area on the screen.;;  Input:	A = Error.Msg # of message to display;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;		init_temp_1 = trashed;;==========================================================draw_caution	Proc		Import	first_rect,warn_rect		with	my_direct_page		pha				; save message # on stack		pea	warn_rect>>16		;clear the message area first		pea	warn_rect		ldx	#$5504			;EraseRect		jsr	call_tools_0		pha				; result space		pha		pea	rIcon			; resource type		pea	cautionIcon>>16		; ID of resource		ldx	#<stopIcon		; assume we're using the stop icon		lda	9,s			; get the message #		cmp	#63			; is it the Bad Name message?		beq	@use_stop_icon		; yes, use the stop icon		ldx	#<cautionIcon		; else use the caution icon@use_stop_icon		phx				; put the icon ID on the stack		ldx	#$0e1e			; LoadResource (actually preloaded)		jsr	call_tools_0		; get the Icon out of Sys.Resources		pla				; retrieve handle		sta	init_temp_1		pla		sta	init_temp_1+2		bcs	@skip_icon		; just in case the icon isn't available		ldy	#2			; deref handle		lda	[init_temp_1],y		pha				; put pointer on stack		lda	[init_temp_1]		pha		pea	%1111000000000000	; displayMode		pea	20			; horizontal position		pea	87			; vertical position		ldx	#$0b12			; DrawIcon		jsr	call_tools_0@skip_icon		lda	1,s			; retrieve message #		jsl	get_string		sty	<init_temp_1+2		; save pointer to string		stx	<init_temp_1		inx				; bump past length byte		bne	@1		iny@1		phy				; put pointer on stack		phx		lda	[<init_temp_1]		; get length byte		and	#$00FF			; clear high byte		pha				; put on stack		pea	first_rect>>16		pea	first_rect		pea	0			; justification		ldx	#$2014			; LETextBox2		jsr	call_tools_0				pla				; retrieve message #		sec				; it's either 62 or 63		sbc	#64			; make either -1 or -2		sta	currentFST		rts		EndP		eject;==========================================================;;  fill_msg_box;;  Determines which message to draw in the message box, then;  draw it in.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================fill_msg_box	Proc		Import	draw_jn_prompt,pb_flags				lda	currentFST		; is the initial warning up?		bmi	draw_first_msg		; yes, restore it		bne	@1			; no, draw real message@clr_warning		jmp	grx_clr_warn		; else no current selection, clear box@1		bit	pb_flags		; is the volume name editable?		bpl	@clr_warning		; no, no sense in putting up a prompt		jsr	nextmember_1		; figure out current selection		stz	currentFST		; force an update		jmp	draw_jn_prompt		; then go draw the prompt; draw the initial warning messagedraw_first_msg		clc		adc	#64			; make either 62 or 63		jmp	draw_caution		; draw the caution Icon & message		EndP		eject;==========================================================;;  draw_window;;  Since we don't take updates, I do this manually after;  the window is open and the stuff is there ready to draw.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================draw_window	Proc	Export		Import	name_default,my_dp,pb_flags		with	my_direct_page		phb				; save DBR		pea	$0101			; set to our data bank		plb		plb		phd				; save TaskMaster's direct page		lda	my_dp			; set to my direct page		tcd		pei	save_rts		; save this, since we're in the middle						; of a TaskMaster call; draw "Initializing" or "Erasing" as appropriate		pea	40			; horizontal position		pea	14			; vertical position		ldx	#$3A04			; MoveTo		jsr	call_tools_0				ldx	#21			; get "Initializing" string for Format call		lda	which_call		; was the call Format or Erase?		beq	its_format2		; it was Format		ldx	#29			; get top string for Erase callits_format2	txa		jsl	get_string		phy				; put string pointer on stack		phx		ldx	#$A504			; DrawString		jsr	call_tools_0; draw the device name		stz	<drvr_dev_num		; device name is in DIB		lda	#get_dib_ptr		sta	<drvr_call_num		lda	<dev_num		sta	<drvr_buf_ptr		jsl	call_dispatch		lda	<drvr_dib_ptr		; make ptr to string		clc		adc	#$0E		tax				; save low word in X		lda	<drvr_dib_ptr+2		; high word too!		adc	#0000			; propogate any carry		pha				; put pointer on stack		phx		ldx	#$A504			; DrawString		jsr	call_tools_0; now the "as " string		pea	40			; horizontal position		pea	29			; vertical position		ldx	#$3A04			; MoveTo		jsr	call_tools_0		lda	#22			; get the "as " string		jsl	get_string		phy				; put string pointer on stack		phx		ldx	#$A504			; DrawString		jsr	call_tools_0; now the volume name, but only if its static		bit	pb_flags		; editable volume name?		bmi	@its_a_control		; yes, its an editLine control		pea	'Ò'			; else draw static text		ldx	#$A404			; surrounded by quotes		jsr	call_tools_0		; DrawChar		lda	name_default+2		; pointer to string		pha		lda	name_default		pha		ldx	#$A504			; DrawString		jsr	call_tools_0				pea	'Ó'		ldx	#$A404			; DrawChar		jsr	call_tools_0@its_a_control		pei	<init_window+2		pei	<init_window		ldx	#$1010			; DrawControls		jsr	call_tools_0; fill the message box appropriately		jsr	fill_msg_box		pla				; restore save_rts		sta	<save_rts		pld				; restore direct page		plb				; restore DBR		rtl		EndP		eject;==========================================================;;  choose_def_fmt;;  Choose a format entry by the following algorithm:;  (1)  If already one, leave them alone;  (2)  If fmt_def_fmt available, choose it;  (3)  Else choose first enabled fmt;;  Input:       fmt_def_fmt = driver refnum of default entry;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================choose_def_fmt	Proc		Import	choose_def_fmt2		with	my_direct_page; do step 1 of algorithm		jsr	nextmember_2		beq	choose_def_1		; nothing selected		rts; do step 2 of algorithm and then step 3 if necessarychoose_def_1		jsl	choose_def_fmt2;  now select this entry		inc	<init_temp_1		; ListMgr starts counting at 1!		pei	<init_temp_1		; member item number		pei	<list2_handle+2		; control handle of format list		pei	<list2_handle		ldx	#$141C			; SelectMember2		jsr	call_tools_0		rts		EndP		Eject;==========================================================;;  choose_def_fmt2;;  Choose a format entry by the following algorithm:;  (1)  If fmt_def_fmt available, choose it;  (2)  Else choose first enabled fmt;;  Input:       fmt_def_fmt = driver refnum of default entry;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;		fmt_list_entry -> member record to select;		init_temp_1	= item number of record;;==========================================================choose_def_fmt2	Proc	Export		with	my_direct_page,fmt_list_record;  First choice:  The driver-specified default format, if available		stz	<init_temp_1		; entry counterchoose_def_2		lda	<init_temp_1		jsr	make_fmt_ptr		ldy	#df_conf_num		; look for specified fmt		lda	[<fmt_list_entry],y		cmp	<fmt_def_fmt		bne	choose_def_3		ldy	#df_mem_flag		; is it available?		lda	[<fmt_list_entry],y		and	#%01100000		clc				; assume it is.		beq	choose_def_7		; yes!		bne	choose_def_4		; no.  no need to look further.choose_def_3		inc	<init_temp_1		lda	<init_temp_1		cmp	<fmt_disp_cnt		bne	choose_def_2;  Second choice:  Whatever's available.choose_def_4		stz	<init_temp_1		; entry counterchoose_def_5		lda	<init_temp_1		jsr	make_fmt_ptr		ldy	#df_mem_flag		; is it available?		lda	[<fmt_list_entry],y		and	#%01100000		clc				; assume it is.		beq	choose_def_7		; yes!choose_def_6		inc	<init_temp_1		lda	<init_temp_1		cmp	<fmt_disp_cnt		;at the end of the list?		bne	choose_def_5		;no, check some more		lda	#invalid_fst_op		;else no matches		secchoose_def_7		rtl		EndP		eject;==========================================================;;  jsl fst_adj_fmts;;  Whichever fst is selected controls the hiliting of the;  formats.  Given an fst in fst_list_entry, scan through;  the format options, selectively enabling and disabling;  them.;;  Inputs:      fst_list_entry = selected fst;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================fst_adj_fmts	Proc	Export		with	my_direct_page,fst_list_record,fmt_list_record		stz	<init_temp_1		; count fmt's		ldy	#ff_match_ct		; get match list size		lda	[<fst_list_entry],y		asl	a			; double it		sta	<init_temp_2		; cache it		stz	<init_temp_2+2		; (counter*2, start at 0)		iny		iny				; setup match list ptr		lda	[<fst_list_entry],y		tax		iny		iny		lda	[<fst_list_entry],y		tay		jsl	deref		stx	<init_temp_3		sty	<init_temp_3+2fst_adj_lp		lda	<init_temp_1		jsr	make_fmt_ptr		ldy	#df_refnum		lda	[<fmt_list_entry],y		ldy	<init_temp_2+2		cpy	<init_temp_2		; done w/known fmts?		beq	disable_fmt		; yes.  disable all others.		cmp	[<init_temp_3],y		bne	disable_fmt		; in my list? no, disable.		ldy	#df_mem_flag		; enable it!		lda	[<fmt_list_entry],y		and	#Å%01100000		; bits 5 & 6 off		sta	[<fmt_list_entry],y		inc	<init_temp_2+2		; bump to next known		inc	<init_temp_2+2		bra	fst_adj_nxdisable_fmt		ldy	#df_mem_flag		; disable it!		lda	[<fmt_list_entry],y		and	#Å%10000000		; bit 7 off		ora	#%01100000		; bit 5 & 6 on		sta	[<fmt_list_entry],yfst_adj_nx		inc	<init_temp_1		; move to next fmt		lda	<init_temp_1		cmp	<fmt_disp_cnt		bne	fst_adj_lp		rtl		EndP		eject;==========================================================;;  draw_jn_prompt;;  Determines whether or not to draw the prompt string;  supplied by the JudgeName call;;  Input:	A = ListMgr item # of currently selected member;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000.x.;                         0	= currently selected FST changed;                         1	= no change needed;;==========================================================draw_jn_prompt	Proc		Import	pb_flags		with	my_direct_page,fst_list_record		dec	a			; fix ListMgr's number base		jsr	make_fst_ptr		; make a pointer to the member record		ldy	#ff_fs_num		; get the selected FST ID		lda	[<fst_list_entry],y		cmp	currentFST		; has it changed?		beq	@no_change		; no, no need to update the prompt		sta	currentFST		; reset the variable		bit	pb_flags		; is the name editable?		bpl	@no_change		; no, so don't draw anything		ldy	#ff_prompt+2		; index to prompt pointer		lda	[<fst_list_entry],y	; retrieve the pointer		sta	init_temp_1+2		; save for use later		tax				; save here too		ldy	#ff_prompt		; get low word of pointer		lda	[<fst_list_entry],y		sta	init_temp_1		inc	a			;bump pointer past length byte		bne	@1		inx@1		phx				;put pointer on stack		pha		lda	[init_temp_1]		;get length		and	#$00FF			;clear high byte		pha				;and onto stack for call		pea	warn_rect>>16		;message rect		pea	warn_rect		pea	0			;justification (left justified)		ldx	#$2014			; LETextBox2		jsr	call_tools_0		rep	#%00000010		; clear Z flag@no_change		rts		EndP		eject;==========================================================;;  edit_handler;;  handles a control hit in the EditLine control;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================edit_handler	Proc		import	pb_flags		with	my_direct_page		lda	currentFST		;non-JudgeName text displayed?		bpl	chk_name_len		;no...		jsr	nextmember_1		;get the current selection		bne	@2			;if none,		jsr	grx_clr_warn		;   clear the message area		bra	disable_ok		;then dim the default button@2		jsr	draw_jn_prompt		;else draw the JudgeName prompt; examine length of LineEdit text and adjust highlighting on OK button; accordingly		entry	chk_name_lenchk_name_len		bit	pb_flags		;is there an editable name?		bpl	@1			;no, don't bother checking the length		pha				;result space		pei	edit_handle+2		;handle of editLine record		pei	edit_handle		ldx	#$2314			;LEGetTextLen		jsr	call_tools_0		pla				;retrieve length		beq	disable_ok		;if zero, disable default button@1		jsr	nextmember_1		;is there an FST selected?		beq	disable_ok		;no...		jsr	nextmember_2		;is there a format selected?		beq	disable_ok		;no...						;else fall through into enable_ok		eject;==========================================================;;  enable_ok;;  Make sure the ok button is turned on.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================		Entry	enable_okenable_ok			pea	0			; =active		bra	call_highlight;==========================================================;;  disable_ok;;  (1)  Turn off the OK button;  (2)  Make all formats available if applicable;  (3)  Nothing selected either side;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================		Entry	disable_okdisable_ok		pea	255			; =inactivecall_highlight		pei	<ok_handle+2		pei	<ok_handle		ldx	#$1110			; HiliteControl		jsr	call_tools_0		rts		EndP		eject;==========================================================;;  fst_click;;  User clicked on the FST list control.  If no entry is;  selected, disable the ok button and enable all format;  options.  If an entry is indeed selected, scan through;  the format options, selectively enabling and disabling;  them.  If the currently selected fmt becomes unavailable,;  select the first ok one.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================fst_click	Proc		with	my_direct_page		jsr	nextmember_1		bne	fst_click_1		jsr	grx_clr_warn		; clear the message box		jmp	disable_ok		; no selection. OK off.;  Ok.  Now work on the fmt option list.fst_click_1		pha				; save selection #		jsr	grx_too_big		; tell user if fst too small		pla				; retrieve selection #		bcs	@no_change		; don't draw prompt if TooBig is displayed		jsr	draw_jn_prompt		; fix up the judgename prompt		beq	@no_change		; if no selection change...		jsl	fst_adj_fmts		; alter format enable bits;  now redraw the fmt list		pea	#0			; NIL = redraw everybody		pei	list2_handle+2		; in the fmt list		pei	list2_handle		ldx	#$111C			; DrawMember2		jsr	call_tools_0		jsr	choose_def_fmt		; and adjust selection@no_change		jmp	chk_name_len		; adjust highlighting on OK button		EndP		eject;==========================================================;;  fmt_click;;  User clicked on the format options list control.  If;  no entry is selected, disable the OK button.  If an entry;  is selected, and an fst is already selected, we're done.;  If an entry is selected, but no fst is selected, choose;  the 1st applicable fst, and do fst_click to fix the enable;  bits of the other format entries.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================fmt_click	Proc		with	my_direct_page,fmt_list_record		jsr	nextmember_2		bne	fmt_click_1		jmp	disable_ok		; no selection. OK off.;  see if an FST is also selected.fmt_click_1		dec	a			; WE start counting from 0		jsr	make_fmt_ptr		jsr	nextmember_1		beq	fmt_click_2		jmp	chk_name_len		; adjust highlighting on OK button;  We must select the first available fst.fmt_click_2		ldy	#df_one_fst		; get fst #		lda	[<fmt_list_entry],y		inc	a		pha				; item number		pei	list1_handle+2		pei	list1_handle		ldx	#$141C			; SelectMember2		jsr	call_tools_0		jmp	fst_click		; (rts)		EndP		eject;==========================================================;;  control_hit;;  TaskMaster reported a control hit to us.  Figure out which;  one it was and act on it.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================control_hit	Proc		Import	TaskData4		with	my_direct_page; examine current FST selection to determine if it's changed since the last; time through here.  If it has, we have to change the message string		pha				;result space		pha		ldx	#$1C04			;GetPort		jsr	call_tools_0		;save current port				pei	<init_window+2		;set current window		pei	<init_window		ldx	#$1B04			;SetPort		jsr	call_tools_0		lda	TaskData4		;get control ID		asl	a			;turn it into an index		tax		jsr	(handlers,x)		;call the control hit handler		ldx	#$1B04			;SetPort		jsr	call_tools_0		;reset port		ignore		rts				;back to event loophandlers	dc.w	ignore			;dummy entry (no control ID 0)		dc.w	cancel_handler		;Cancel button		dc.w	default_handler		;default button handler		dc.w	fst_click		;FST List control		dc.w	fmt_click		;format list control		dc.w	edit_handler		;line edit control		eject; The Cancel button was pressed.  Exit without doing anything...cancel_handler		lda	#1			;cancel button pressed		sta	<init_choice		rts				;back to event loop, will exit; The default (Initialize or Erase) button was pressed.  Must set up the volume; name currently in the LineEdit control and perform a JudgeName call to the; currently selected FST.  If the FST is happy, we can complete the dialog.  If; the volume name is no good, we'll tell the user and stay in the dialog to give; them a chance to fix the name.default_handler		Import	pb_flags		Import	jn_parms:jn_parmBlock		with	my_direct_page,fst_list_record		with	jn_parms		;gonna use JudgeName parmblock		jsr	nextmember_1		;get the current selection		dec	a		jsr	make_fst_ptr		;point to the member record		ldy	#ff_fs_num		;get the FST ID		lda	[fst_list_entry],y		sta	>fileSysID		;store in parmblock		jsr	grx_check_name		;go do a JudgeName call		bcc	@name_good		;checked out OK!		bit	pb_flags		;was it an editable name?		bpl	@name_good		;no, just let the FST generate an error		pea	$0009			;"bad input" beep type		ldx	#$3803			;SysBeep2		jsr	call_tools_0		;get the user's attention		lda	#63			;message = "The supplied name is unacceptable..."		jsr	draw_caution		;draw the caution message		rts				;then re-enter the event loop@name_good		stz	<init_choice		;the "ok" button was pressed		rts				;back to event loop, will exit		EndP		eject;==========================================================;;  grx_loop;;  Event loop for the graphics window.  Waits for mouse;  clicks or keystrokes.;;  Outputs:     init_choice = 0 if ok pressed, 1 if cancel;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================grx_loop	Proc		Import	TaskRecord,grx_too_big,pb_flags,TaskData4		Import	draw_window,last_control		with	my_direct_page		stz	<init_choice		; set to -1		dec	<init_choicegrx_loop_0		lda	<init_choice		; done yet?		bpl	doneno_event 		lda	#0		pha				;result space		pha		pea	TaskRecord>>16		;pointer to extended task record		pea	TaskRecord		pea	$4000+(draw_window>>16)	 ;pointer to update routine		pea	draw_window		;bit 30=can draw while GS/OS is busy, 10-Jul-92 DAL		pea	$8000			;eventHook - auto convert command-.		pha				; to ESC keypress		pha				;BeepProc pointer		pha				;(NULL = use SysBeep2)		pea	%0000000000001001	;flags		ldx	#$640E			;DoModalWindow		jsr	call_tools_0		pla				;retrieve result		plx				;high word - not used		tax				;did we have a control hit?		beq	no_event		;no, just loop		sta	TaskData4		;store the control ID		jsr	control_hit		;handle the control hit		lda	TaskData4		;get the control ID again		cmp	#defaultButtonID	;was it the Initialize button?		bne	grx_loop_0		;no, just continue normally		lda	<init_choice		;was JudgeName happy?		bmi	no_event		;no, so skip the too big messagedone		rts		EndP		eject;==========================================================;;  record_grx_sel;;  Convert list selections to chosen_fst and chosen_fmt.;;  Outputs:     chosen_fst = entry # of selected FST;               chosen_fmt = entry # of selected format;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================record_grx_sel	Proc		import	path_vp		with	my_direct_page,fst_list_record		stz	<chosen_fst		stz	<chosen_fmt		jsr	nextmember_1		beq	record_grx_1		dec	a			;fix ListMgr's item #		jsr	make_fst_ptr		;make pointer to record		ldy	#ff_fs_num		;get the FST ID		lda	[<fst_list_entry],y		sta	<chosen_fstrecord_grx_1		jsr	nextmember_2		beq	record_grx_2		dec	a			;fix ListMgr's item #		sta	<chosen_fmtrecord_grx_2		ldx	path_vp			;get VP of pathname		ldy	path_vp+2		tya				;better see if it's valid		ora	path_vp		beq	no_path			;no pointer to deref!		jsl	call_deref		stx	init_temp_1		;save pointer		sty	init_temp_1+2		txa				;offset by 3 for dest pointer		clc				;(leave room for leading separator)		adc	#1		sta	init_temp_2		tya		adc	#0		sta	init_temp_2+2		ldy	#2			;get pathname length		lda	[init_temp_1],y		inc	a			;bump by 1 for leading separator		sta	[init_temp_1]		;move up over buffer length word		clc		adc	#2		sta	init_temp_3		;save as length comparator		lda	which_class		;make a class 0 or class 1 string?		bne	do_copy			;class 1, go do it		lda	init_temp_1+2		;else decrement destination pointer		bne	@1		dec	init_temp_1+2@1		dec	init_temp_1do_copy		sep	#$20			;8-bit accumulator		longa	off		lda	#':'			;start with a leading separator		sta	[init_temp_1],y		;store in string		iny				;y now equals 3@loop		lda	[init_temp_2],y		sta	[init_temp_1],y		iny		cpy	init_temp_3		bcc	@loop		rep	#$20			;back to 16-bit accumulator		longa	onno_path		rts		EndP		eject;==========================================================;;  remove_window;;  Close the selection window.  This kills the controls too.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================remove_window	Proc		with	my_direct_page		pei	<init_window+2		pei	<init_window		ldx	#$0B0E			; CloseWindow		jsr	call_tools_0		rts		EndP		Eject;==========================================================;;  grx_dialog;;  Build and actuate the graphics based dialog.  The box;  is an alert window, and it contains the following;  items:;;  String at the top:    Please select a file system and format:;  Left list control:    Available file systems;  Right list control:   Available formats;  Buttons:              Cancel (normal);                        Ok     (bold);;  Inputs:      fmt_list_vp = vp of the format options data;               fst_list_vp = vp of the file sys options;;  Outputs:     chosen_fst = selected fst # if init_choice=0;               chosen_fmt = selected fmt # if init_choice=0;               init_choice = 0=OK, 1=Cancel;               A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;  This routine may move memory.;;==========================================================grx_dialog	Proc	Export		with	my_direct_page,fmt_list_record		jsr	set_grx_stack		; make a bigger one		jsl	fix_ptrs		; at the last moment (locks GIM mem)		jsr	setup_lists		; create lists		jsr	setup_window		; create window & controls		pha				; save old port		pha		ldx	#$1C04			; GetPort		jsr	call_tools_0		pei	<init_window+2		pei	<init_window		ldx	#$1B04			; SetPort		jsr	call_tools_0		jsl	choose_def_fmt2		; find the record of the default format		ldy	#df_mem_flag		; then set the selected bit		lda	[fmt_list_entry],y		ora	#%10000000		sta	[fmt_list_entry],y		jsr	fmt_click		; (after setting fmt, will choose fst)		jsr	fix_cursor		; reset the cursor to the arrow		jsr	grx_loop		; handle clicks & such		bne	@canceled		; if init_choice != 0, user canceled		jsr	record_grx_sel		; what did they finally pick?@canceled		jsr	restore_cursor		; set it back to the app's setting		ldx	#$1B04			; SetPort (to previous one)		jsr	call_tools_0		jsr	remove_window		; close the winder		jsl	call_unlock_mem		; unlock GIM mem		jsr	reset_grx_stack		; reset to GS/OS stack		rts		EndP		eject;==========================================================;;  init_present;;  Make a presentation to the user.  This is where we;  split to graphics or text based dialog routines.;  If the Format or Erase call is class 1 and pcount > 3;  then the calling program is requesting a specific FST;  so don't put up a dialog at all.;;  Outputs:     A = if c=0, ID of selected fst;                   if c=1, 0 if cancel selected, error # if error occurred;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0 = ok to format, 1 = cancel or error;;==========================================================init_present	Proc	Export		Import	tx_dialog,non_dialog,pb_flags		with	my_direct_page		jsr	setup_screen1		;determine if we are running in text or graphics mode				lda	which_class		;was this a class 1 call?		beq	do_dialog		;no - so always put up dialog		lda	pb_flags		;yes - so get the flags for the call		bit	#%1101111111111111	;(don't include bit 13 in check)		bne	do_dialog		;if non-zero, present dialog; all variables are specified in the call, just do the operation		jsl	non_dialog		bcs	present_cancel		;error occurred		bra	present_done; put up a dialogdo_dialog		lda	<init_screen		bpl	present_text;  use the graphics dialog		jsr	setup_screen2		;try to allocate a 1K stack for the graphics routines		bcs	present_text		;couldn't get stack so use text mode		jsr	grx_dialog		bra	present_done;  use the text dialogpresent_text		jsl	tx_dialog		bcs	present_cancel		;error occurred;  now return A & C depending on 'init_choice'present_done		lda	#0		lsr	<init_choice		;set carry if Cancel is selectedpresent_cancel		rts		EndP		eject;==========================================================;;  init_shutdown;;  Init package is done.  We must walk through the structures;  and release any memory we're using.;;  Outputs:     A = trashed;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000...;;==========================================================init_shutdown	Proc	Export		with	my_direct_page,fmt_list_record,fst_list_record		lda	<fmt_list_vp		; list exist?		ora	<fmt_list_vp+2		beq	init_shut_4		; if no fmt list, no fst list!		jsr	jsl_deref		stz	<init_temp_1;  Loop through fmt entries, deleting the stringsinit_shut_1		lda	<init_temp_1		jsr	make_fmt_ptr		ldy	#df_string		; get the VP		lda	[<fmt_list_entry],y		tax		iny		iny		lda	[<fmt_list_entry],y		tay		jsl	call_release		; dropped!		inc	<init_temp_1		; next.  done?		lda	<init_temp_1		cmp	<fmt_disp_cnt		bne	init_shut_1		ldx	<fmt_list_vp		; and dump the master list		ldy	<fmt_list_vp+2		jsl	call_release;  very similar routine:  release match lists from fsts, then;  dump the fst list.		lda	<fst_list_vp		ora	<fst_list_vp+2		beq	init_shut_4		lda	<fst_list_cnt		; any FSTs in the list?		beq	dump_master		; no, just dump the master VP		stz	<init_temp_1init_shut_3		lda	<init_temp_1		jsr	make_fst_ptr		ldy	#ff_match_lst		; get the VP		lda	[<fst_list_entry],y		tax		iny		iny		lda	[<fst_list_entry],y		tay		jsl	call_release		; dropped!		inc	<init_temp_1		; next.  done?		lda	<init_temp_1		cmp	<fst_list_cnt		bne	init_shut_3dump_master		ldx	<fst_list_vp		; and dump the master list		ldy	<fst_list_vp+2		jsl	call_releaseinit_shut_4		rts		EndP		eject;==========================================================;;  init_main;;  Called by SCM to pre-process the format call.  Presents;  a selection of format and file system options to the user,;  and based on the choice made, presets the driver and returns;  an FST number, which the SCM then calls.;;  Inputs:      dev_num = requested device;               X = call # x 2;               Y = call class x 2;               path2_ptr = pointer to volume name string;;  Outputs:     A = if c == 0, ID number of selected FST;                   if c != 0, 0 if Cancel selected;                              error # is error condition;               X = trashed;               Y = trashed;               P = nvmxdizc;                   ..000..|;                          0=no error, 1=cancel selected or;                                        init pack failed;;  This routine may move memory.;;==========================================================init_main	Proc	Export		Import	display_msg,FST_Scan,query_driver		Import	msg_flag,path_vp,my_dp,pb_flags,pb_reqFileSysID		Import	jn_parms:jn_parmBlock		with	jn_parms,my_direct_page,fst_list_record		phb				; remember gs/os data bank		pea	$0101			; our data is in bank 1		plb		plb		tdc				; remember our DP for update routine		sta	my_dp		stz	<fmt_list_vp		stz	<fmt_list_vp+2		stz	<fst_list_vp		stz	<fst_list_vp+2		txa				; call # x2, $48 or $4A		sec		sbc	#$0048			; now its zero or non-zero		sta	|which_call		sty	|which_class		stz	|msg_flag		;initialize flag - added 1/89 CAE		lda	#1			;nameType = 1 (for JudgeName)		sta	>nameType		stz	pb_flags		;initialize to 0		stz	pb_reqFileSysID;; the following sets the flags word appropriately, according to the following; table.  If pCount >= 5, we leave the flags alone, since they were specified by; the user.  Only the upper four bits of the flags are specified in the table.; Only the upper 2 bits are actually used.;; Class 0; -------;  %0100 (since volume name is supplied in a class 0 call);; Class 1	pCount	volName == NULL		volName != NULL; -------	------	----------------	----------------; 		1	N/A (%1100)		N/A (%1100);		2	%1100			%0100;		3	%1100			%0100;		4	%1000			%0000 (no dialog);		lda	|which_class		;is it a class 1 call?		beq	@synthesize		;no, the flags will by synthesized		lda	[<param_blk_ptr]	;get the pCount		cmp	#4			;reqFileSysID included?		bcc	@synthesize		;no, so synthesize flags too		ldy	#$0c			;offset of parm		lda	[<param_blk_ptr],y	;get the parameter		sta	pb_reqFileSysID		;store		lda	[<param_blk_ptr]	;get the pCount		cmp	#5			;were the flags included?		bcc	@synthesize		;no, we will synthesize them		ldy	#$0E			;offset of flags parameter		lda	[<param_blk_ptr],y	;get the flags		sta	pb_flags		;store the flags value@synthesize; now we validate the flag values		lda	pb_reqFileSysID		;is there a valid reqFileSysID?		bne	@req_valid		;yes, leave flags as defined		lda	pb_flags		;no, so..		ora	#$4000			;..allow user to select		sta	pb_flags@req_valid		lda	<path2_ptr		;null name supplied?		ora	<path2_ptr+2		bne	@name_valid		;no, leave flags as is		lda	pb_flags		;else allow user to edit the name		ora	#$8000		sta	pb_flags@name_valid		jsl	query_driver		bcs	exit_24		jsl	fst_scan		; build FST list		bcs	exit_24		jsr	find_matches		bcs	exit_24		jsr	init_present		bcs	exit_24		lda	|which_call		; if $25 ERASE, don't set		bne	sk_set_fmt		; the formatting options		jsr	set_driver_fmt		jsl	display_msg		; Added CAE 12/21/88sk_set_fmt		lda	<chosen_fst		; return the selected FST		clc				; no errorexit_24		php				; save carry		pha				; save FST value or error code		jsr	init_shutdown		ldx	path_vp			; return new volume name VP		ldy	path_vp+2		;   in X and Y		pla				;   and FST ID in Acc		plp		plb		rtl				; back to SCM		EndP		;===============================================================================;; init.2.e;;===============================================================================init_2_end	PROC			ENDP		init_2_dummy	PROC	org init_2_max, skip	;generate an error if code is too big		ENDP		END		