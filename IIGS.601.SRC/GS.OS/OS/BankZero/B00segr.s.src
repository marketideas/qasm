;===============================================================================; b00segR;; Framework for building load segment b00segR.;;===============================================================================header_length   equ    $30b00segr_org     equ    $00AA00b00segr_start	equ	B00segr_org				IMPORT	b00segr_end		b00segr_header  PROC	org     b00segr_org-header_length		msb     on		DC.W	b00segr_end-b00segr_start		DC.L	b00segr_org		DC.W	0000		DC.B	'Bank0 Disp.           v04.00'		DC.B	00		msb     off		ENDP			d_b00segr_dummy PROC	org     b00segr_org		ENDP		END