******************************************************************               Copyright (c) 1987, 1988*               Apple Computer, Inc.*               All rights reserved*******************************************************************               GS/OS Bank 0 Dispatcher**		This code resides in bank $00 location $AA00.*******************************************************************               Written by: Raymond B. Montagne******************************************************************* REVISION HISTORY:** DATE     VER. BY   DESCRIPTION** 04/07/87 0.01 RBM  Initial coding of bank 0 dispatcher** 05/27/87 0.02 RBM  Speed selection is now based on bit 3 of the*                    slot number contained in the DIB.** 09/25/87 0.03 RBM  UNFUTZ masks A-Reg on no error** 10/05/87 0.04 RBM  OPEN call inits hook table for BASIC devices.** 11/19/87 0.05 RBM  Fixed Pascal1.1 interface for startup, close,*                    flush, control & status calls.*                    Fixec Pascal1.1 interface for open call.** 12/03/87 0.06 RBM  Relocated to $00AA00.** 12/21/87 0.07 RBM  Fixed UNFUTZ to pass ProDOS error through.*                    Seperated dispatcher into more files.** 01/02/88 0.08 RBM  Fixed language card dispatcher.** 01/13/88 0.09 RBM  Fixed trash in upper byte of error code.** 01/30/88 0.10 RBM  Translate SmartPort error codes to legitimate*                    GS/OS error codes. (see unfutz in bank0/bank0.dispatcher)*                    Language card dispatcher now preserves the state of*                    the carry flag through entry. (see lc.dispatcher)** v0.01 a01     RBM  Alpha release.** v0.04 a01     RBM  New release.** v0.05 a01     RBM  New release.** v0.05 a01     RBM  Fixed absolute reference in unfutz code to*                    a long reference.  Return from class 0 character*                    devices sometimes used wrong thread (BASIC v.s. Pascal).** v0.05 a02     RBM  Parameter lists used by the generated driver core*                    routines to call the SmartPort interface(s) directly*                    via the bank $00 dispatcher now reside in the bank $00*                    dispatchers memory space.  This was neccessary since the*                    rom is enabled during firmware calls making parameters*                    in the device dispatcher's address space inaccessable*                    to the SmartPort interface being called.** v0.06 a01     RBM  New release.** v0.07 a01     RBM  New release.** v0.08 a01     RBM  Class 0 character devices now use highest level*                    interface available and is not selectable.  This*                    means that Pascal devices cannot be configured*                    to use the BASIC interface.** v0.08 a02     RBM  Preserve interrupt enable status across the dispatch*                    to a firmware interface.** v0.08 a03     RBM  Rearranged how interrupt status is preserved so that*                    SmartPort soft error codes are not lost.** v0.08 a04     RBM  During counting of generated driver, always exit as*                    if class 1 or class 2 device.** v0.09 a01     RBM  Class 1 and class 2 soft errors are filtered out.** v0.09 a02     RBM  Well, they almost were.  Reference needed to be*                    long when checking exit type during unfutz.** v0.09 a03     RBM  Select bank $00 before calling a card.** v0.10 a02     RBM  Added a bank $00 resident routine to determine the*                    machine rom version number.** v0.16 b01     GRT  fixed external slot bit problem in basic_type found in*                    bank0/bank0.dispatch** v0.16 b01     GRT  fixed external slot bit problem in UNFUTZ found in*                    bank0/bank0.dispatch and BIT problem with c0_flag** v0.16 b02     GRT  added code to make sure drvr_blk_num+2 is zero for*                    prodos block devices*                    new label in bank0.dispatch is "pro_blk_bad"** v04.10 a01	RBM	General code reduction.  Added main entry for slot*			arbiter to preserve the rom state (statereg bit 3)*			and switch in RAM prior to dispatching to the*			slot arbiter core routine resident in the language *			card adjacent to the device manager.  Added parameter*			lists to be used with the bank 0 core dispatcher so*			that standard and extended SmartPort DIB status calls*			may be issued by the driver core routines resident in*			the device dispatcher.** v4.10 d9	RBM	Reduce os overhead in language card dispatcher.*			Set system speed eliminates unneccessary calls through*			the language card dispatcher.** v4.10 d10	RBM	Removed intermediate layer for language card dispatching*			to language card resident system service call routines now*			resident in fast managed memory.** v4.10 d11	RBM	ProDOS calls are not pre parsed for block out of range.*			This responsibility is passed on to the target firmware*			interface.** v4.10 d14	RBM	Fixed UniDisk3.5 access for block size $020C.** 11/13/91	GAB	Fixed Pascal Protocol handler so that a character read*			  from the Pascal firmware will ALWAYS be returned in*			  the accumulator.*			Replaced all BRL opcodes with JMP opcodes, since this*			  code resides at an absolute location in memory and is*			  always loaded as a binary image.** 11/21/91	GAB	Fixed SmartPort error code translation.  A SmartPort*			  error code of $11 (bad unit number) used to get*			  translated into a $22 (bad parameter) GS/OS error*			  code.  I've changed this so it's translated into*			  GS/OS error $28 (no device connected).*****************************************************************		eject;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		entry	dispatcher		entry	esp_ctrl_trans		entry	esp_stat_trans		entry	ext_dev_stat		entry	ext_eject		entry	ext_format		entry	ext_reset		entry	ext_set_dcb		entry	fw_return		entry	g_fmt_pcnt		entry	lc_jump_addr		entry	parm_list_ptr		entry	pro_trans		entry	set_fmt_p		entry	set_reg		entry	set_sp_command		entry	sp_close		entry	sp_command		entry	sp_control		entry	sp_ctrl_trans		entry	sp_flush		entry	sp_open		entry	sp_read		entry	sp_shut_dn		entry	sp_start_up		entry	sp_stat_trans		entry	sp_status		entry	sp_translate		entry	sp_write		entry	std_dev_stat		entry	std_eject		entry	std_format		entry	std_reset		entry	std_set_dcb		entry	sys_buffer		entry	b0_get_dev_char		entry	set_move_cnt		Print	Off		include	'common.equ.src' 		include	'hw.equ.src' 		include	'driver.equ.src' 		Print	On		EJECT******************************************************************* SYSTEM I/O BUFFER:******************************************************************		export	the_sys_buffer	the_sys_buffer	proc		export	sys_buffersys_buffer				; system buffer is at beginning		ds.b	$020C		; system buffer is 524 bytes long				endp		EJECT****************************************************************** This code segment is the bank 0 dispatcher for generated* drivers running under the GS/OS.  This routine must reside* in bank 0 and performs the switch to emulation mode prior* to calling a slot resident firmware based device driver.** ENTRY:        A = Call Number*               X = Input character*               Y = Undefined*               D = GS/OS direct page*               B = Undefined*               S = Native mode stack*               P = 0=m=x=e*               Transfer count must be set to current*               count as the transfer count will be*               adjusted by this routine**               NOTE: At entry, the portion of the bank 0 dispatcher not*               resident in bank 0 is responsible for setting up the*               parameter inputs on the direct page workspace for the device*               being called.** EXIT:         A = Error Code or Output Character*               X = X & Y from emulation dispatch*                   8 bit X in low byte of 16 bit X register*                   8 bit Y in high byte of 16 bit X register *               Y = Unchanged*               D = GS/OS direct page*               B = Unchanged*               S = Native mode stack*               P = 0=m=x=e (c=1 if error, else 0)*****************************************************************		export	b0dsptch	b0dsptch	proc		export	bank0_dsptchbank0_dsptch		jmp	dispatcher	; data area follows entry point		endp***************************************************************** The following is a pointer to the data area to be used for* setting up a SmartPort parameter list****************************************************************		export	param_list	param_list	proc		export	call_list_ptrcall_list_ptr		dc.w	sp_command		endp		EJECT***************************************************************** This following variables are used to set the default number* of devices per slot for ProDOS block device cards.  This is* done to prevent ghost device drivers for devices interfaced* through the ProDOS block device protocol that may not exist* *  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | Internal Slots* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |___ 1=Nonconfigured, 0=Configured*   |   |   |   |   |   |   |_______ Slot #1  -  0=1 device, 1=2 devices*   |   |   |   |   |   |___________ Slot #2  -  0=1 device, 1=2 devices*   |   |   |   |   |_______________ Slot #3  -  0=1 device, 1=2 devices*   |   |   |   |___________________ Slot #4  -  0=1 device, 1=2 devices*   |   |   |_______________________ Slot #5  -  0=1 device, 1=2 devices*   |   |___________________________ Slot #6  -  0=1 device, 1=2 devices*   |_______________________________ Slot #7  -  0=1 device, 1=2 devices*  ___ ___ ___ ___ ___ ___ ___ ___* |   |   |   |   |   |   |   |   |* | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 | External Slots* |___|___|___|___|___|___|___|___|*   |   |   |   |   |   |   |   |___ 1=Nonconfigured, 0=Configured*   |   |   |   |   |   |   |_______ Slot #9  -  0=1 device, 1=2 devices*   |   |   |   |   |   |___________ Slot #10 -  0=1 device, 1=2 devices*   |   |   |   |   |_______________ Slot #11 -  0=1 device, 1=2 devices*   |   |   |   |___________________ Slot #12 -  0=1 device, 1=2 devices*   |   |   |_______________________ Slot #13 -  0=1 device, 1=2 devices*   |   |___________________________ Slot #14 -  0=1 device, 1=2 devices*   |_______________________________ Slot #15 -  0=1 device, 1=2 devices****************************************************************		export	prodos_config	prodos_config	proc			export	config_ramconfig_ram		dc.b	$00		; all 1 device and not configured		dc.b	$00		; all 1 device and not configured		export	c0_flagc0_flag		dc.w	0		endp		EJECT***************************************************************** The following variables apply to the bank 0 dispatcher only.* There was no room available for them on direct page.****************************************************************		export	dsptch_vars	dsptch_vars	proc		export	b0_buff_ptrb0_buff_ptr	ds.b	4		; (lw) Bank0 dispatcher buffer pointer		export	b0_blk_numb0_blk_num	ds.b	4		; (lw) Bank0 dispatcher block number		export	param_list_ptrparam_list_ptr		export	parm_listparm_list	ds.b	12		; (12) Parameter list class 1 & 2;                                       ; (b)  Parameter count;                                       ; (b)  Unit Number;                                       ; (lw) Buffer Pointer;                                       ; (lw) Block Address		export	b0_tempb0_temp		ds.b	2		; (w)  Temporary storage		export	d_classd_class		ds.b	1		; (b)  Driver class		export	save_spsave_sp		ds.b	2		; (w)  native stack pointer		export	a_rega_reg		ds.b	1		; (b)  Accumulator on dispatch		export	block_cntblock_cnt	ds.b	4		; (lw) block counter		export	block_numblock_num	ds.b	4		; (lw) block number for current read		eject******************************************************************* The following parameter lists are used by the generated* driver core routines when calling a SmartPort interface* via the bank $00 core routines.******************************************************************		export	get_fmt_listget_fmt_list	dc.b	$4B		; get format options call		dc.l	g_fmt_pcnt	; pointer to SmartPort parameter list		export	g_fmt_pcntg_fmt_pcnt	dc.b	3		; 3 parameters		export	get_fmt_unitget_fmt_unit	dc.b	0		; unit number (from DIB)		export	get_fmt_slistget_fmt_slist	dc.l	0		; pointer to status list		export	get_fmt_reqcntget_fmt_reqcnt	dc.w	0		; request count		export	set_fmt_listset_fmt_list	dc.b	$4A		; command		dc.l	set_fmt_p	; pointer to parameter list		export	set_fmt_pset_fmt_p	dc.b	3		; parameter count		export	set_fmt_unitset_fmt_unit	dc.b	0		; unit number		export	set_fmt_clistset_fmt_clist	dc.l	0		; control list pointer		export	set_fmt_reqset_fmt_req	dc.w	0		; request count		export	sp_stat3sp_stat3	dc.b	$00		; command		dc.w	sp_stat3_p	; pointer to parameter list		export	sp_stat3_psp_stat3_p	dc.b	3		; parameter count		dc.b	0		; unit number		dc.l	sys_buffer	; status list pointer		dc.b	3		; status code		export	esp_stat3esp_stat3	dc.b	$40		; command		dc.l	esp_stat3_p	; pointer to parameter list		export	esp_stat3_pesp_stat3_p	dc.b	3		; parameter count		dc.b	0		; unit number		dc.l	sys_buffer	; status list pointer		dc.b	3		; status code		endp		eject** The following is a hook table maintained for BASIC device drivers.* This table is intialized by the DRVR_STARTUP call.*		export	hook_table	hook_table	proc		dc.b	$05		; slot 1 BASIC input entry point		dc.b	$07		; slot 1 BASIC output entry point		dc.b	$05		; slot 2 BASIC input entry point		dc.b	$07		; slot 2 BASIC output entry point		dc.b	$05		; slot 3 BASIC input entry point		dc.b	$07		; slot 3 BASIC output entry point		dc.b	$05		; slot 4 BASIC input entry point		dc.b	$07		; slot 4 BASIC output entry point		dc.b	$05		; slot 5 BASIC input entry point		dc.b	$07		; slot 5 BASIC output entry point		dc.b	$05		; slot 6 BASIC input entry point		dc.b	$07		; slot 6 BASIC output entry point		dc.b	$05		; slot 7 BASIC input entry point		dc.b	$07		; slot 7 BASIC output entry point				endp		EJECT****************************************************************** This code segment is the bank 0 dispatcher for generated* drivers running under the GS/OS.  This routine must reside* in bank 0 and performs the switch to emulation mode prior* to calling a slot resident firmware based device driver.** ENTRY:        A = Call Number*               X = Input character*               Y = Undefined*               D = GS/OS direct page*               B = Undefined*               S = Native mode stack*               P = 0=m=x=e*               Transfer count must be set to current*               count as the transfer count will be*               adjusted by this routine**               NOTE: At entry, the portion of the bank 0 dispatcher not*               resident in bank 0 is responsible for setting up the*               parameter inputs on the direct page workspace for the device*               being called.** EXIT:         A = Error Code or Output Character*               X = X & Y from emulation dispatch*                   8 bit X in low byte of 16 bit X register*                   8 bit Y in high byte of 16 bit X register *               Y = Unchanged*               D = GS/OS direct page*               B = Unchanged*               S = Native mode stack*               P = 0=m=x=e (c=1 if error, else 0)*****************************************************************		export	dispatcher	dispatcher	proc		longa	on		longi	on** This routine sets the stack pointer to page 1 in preparation* for switching to emulation mode.*		tay			; save A Reg input		tsc			; save native sp		sta	>save_sp		sep	#$20		; 8 bit 'm'		longa	off		xba			; get stack page in A		dec	a		; is stack in page 1?		beq	pg1		; yes		lda	#$01		; if not, set page 1		xba		lda	>emulstack	; get emulation mode stack pointer		tcs			; to set page 1 stack pointer** Stack pointer is now set to emulation mode stack.  Need to preserve the* device driver data bank prior to dispatching.  Will assume a worse case* dispatch of class 3 and store 5 NOP instructions following the return* address.  If not type 2, return from firmware driver will fall through* the NOP with minimal impact on execution time.  This allows one single* bank 0 dispatcher to be used for all generated drivers.*pg1		phb			; save environment		phd		phk			; data bank must be $00 for firmware		plb		sty	|a_reg		; A reg for firmware		lda	#$EA		; must lay down the 5 nop's		ldx	#$0004noploop		sta	|fw_return,x		dex		bpl	noploop** Not in emulation mode yet.  Direct page is to GS/OS direct page for* indirect access of rom locations internal to the firmware driver to* be called.  This is needed to locate the entry points within the* firmware driver so that the dispatch to the proper entry point can* be made.*		stz	<fw_addr		ldy	#slot_num	; slot where fw resides		lda	[<drvr_dib_ptr],y		and	#$07		; slots 1 through 7 are valid		ora	#$C0		; make $Cn		sta	<fw_addr+1	; and save for $CnXX		stz	<fw_addr+2		ldy	#drvr_class	; get this driver's class		lda	[<drvr_dib_ptr],y		sta	<d_class	; save for easier access		and	#$3F		; mask character device flag		beq	class0		; if a class 0 call		jmp	not_class0	; if not a class 0 device** Got here if either a ProDOS block device or a character device such* as BASIC or Pacal1.1.  Must determine if character device to avoid* setting up absolute zero page parameters for a ProDOS block device.*class0		longa	off		longi	on		bit	<d_class	; character device?		bmi	char_dev	; yes** It is a ProDOS block device if got here.  Must set up call parameters* on absolute zero page.  Also must determine the ProDOS block device* entry point as follows:**               ($CnFF) + $Cn00 = ProDOS entry point*prodos		longa	off		longi	on		ldy	#$00FF		; get ProDOS block entry point		lda	(<fw_addr),y		sta	<fw_addr** ProDOS unit number is constructed from DIB unit and slot.*		ldy	#unit_num	; create ProDOS Unit Number		lda	[<drvr_dib_ptr],y		dec	a		lsr	a		; carry is now unit number		php		ldy	#slot_num		lda	[<drvr_dib_ptr],y		jsr	a_times_16		asl	a		plp		ror	a		sta	>punit		; ProDOS unit number** Translate GS/OS driver call number to ProDOS call number* and set for dispatch to device.*		ldx	<drvr_call_num		lda	|pro_trans,x		sta	>pcmd** Set up ProDOS block device call parameters for the* buffer address and block address.*		rep	#$20		; 16 bit 'm'		longa	on		lda	<drvr_buf_ptr	; set ProDOS buffer pointer		sta	|pbuffer		lda	<drvr_blk_num	; set ProDOS block number		sta	|pblock		lda	<drvr_blk_num+2	; check buffer in range		beq	prodos_okprodos_error		ldx	#drvr_bad_block	; flag bad block error		sec		pld			; restore native environment		plb		lda	>save_sp		tcs		txa			; error code must be in A Reg		rtlprodos_ok		sep	#$20		; 8 bit 'm'		longa	off		jmp	set_reg		; ready for dispatch** It is either a BASIC or Pascal1.1 character device if got here.* Must determine which type it is using the Pascal1.1 firmware* signature bytes as follows:**               $Cn05 = $38 (standard)*               $Cn07 = $18 (standard)*               $Cn0B = $01 (generic signature of firmware cards)*char_dev		longa	off		longi	on		sep	#$10		; 8 bit 'x'		longi	off		lda	#$FF		; assume its a Pascal1.1 device		sta	|c0_flag		ldy	#$05		lda	[<fw_addr],y	; $Cn05 = $38 if Pascal1.1		cmp	#$38		bne	basic_type	; if not Pascal1.1		iny		iny		lda	[<fw_addr],y	; $Cn07 = $18 if Pascal1.1		cmp	#$18		bne	basic_type	; if not Pascal1.1		ldy	#$0B		lda	[<fw_addr],y	; $Cn0B = $01 if Pascal1.1		dec	a		beq	pascal_type	; if a Pascal1.1 device** If got here, then device is a BASIC device.  Dispatch must be through* the address previously obtained through the I/O hooks unless this is an* initialization dispatch to $Cn00.  Standard BASIC entry points are as* follows:*               $Cn00   Initializtion entry point*               $Cn05   Input routine entry point*               $Cn07   Output routine entry point** Many BASIC devices do not support the standard input and output entry* points.  All BASIC devices modify the I/O hooks located at $0036-0039* in absolute zero page.  The result of the initialization call to a* BASIC device will store the hooks into a hook table for the input and* output dispatches.  The input routine entry point will be obtained* from $0038 while the output routine entry point will be obtained from* $0036.*basic_type		longa	off		longi	off		stz	|c0_flag	; flag that its a BASIC device		ldy	#slot_num	; get slot		lda	[<drvr_dib_ptr],y		and	#$F7		;clear external slot bit		dec	a		asl	a		tax		lda	<drvr_call_num	; get driver call number		cmp	#drvr_read	; is this a read call?		beq	get_hook	; yes		inx		cmp	#drvr_write	; is this a write call?		beq	get_hook	; yes		cmp	#drvr_open	; is it an open call				sec			; assume it's not an open		bne	char_ret_1	; no other BASIC dispatch possible		lda	#$00		; set for BASIC init call on open		bra	set_fw_addrget_hook		lda	|hook_table,x	; get low byte entry $CnXXset_fw_addr		sta	<fw_addr	; set low byte of $CnXX entry point		jmp	set_reg		; and go to dispatch** If got here, then device is a Pascal1.1 driver.  Dispatch must get the* proper entry point for the firmware driver by reading the firmware driver* rom.  Pascal1.1 entry points are defined as follows:**               $Cn0D   Initialization routine offset*               $Cn0E   Read routine offset*               $Cn0F   Write routine offset*               $Cn10   Status routine offset*pascal_type		longa	off		longi	off		ldy	#$0D		; assume initialization call		lda	<drvr_call_num		cmp	#drvr_open	; is this an open call?		beq	pascal_entry	; yes		iny		cmp	#drvr_read	; is this a read call?		beq	pascal_entry	; yes		iny		cmp	#drvr_write	; is this a write call?		beq	pascal_entry		iny		cmp	#drvr_status	; is this a status call?		beq	pascal_entry	; yeschar_ret		clc			; no error exitchar_ret_1				; or pass carry from previous routine		rep	#$30		; 16 bit 'm' & 'x'		longa	on		longi	on		pld			; restore native environment		plb		lda	>save_sp		tcs		lda	#no_error	; A Reg has error code		rtlpascal_entry		lda	[<fw_addr],y	; get firmware entry point offset		sta	<fw_addr		bra	set_reg		; now ready for dispatch** If got here the device is either a class 1 or class 2 driver.  Must* determine which class it is since the call structure is not the same* for both of these classes of driver.*not_class0		longa	off		longi	on		dec	a		; is it a class 1 driver?		bne	class2		; no, must be class 2** If got here the device is a class 1 driver using the standard* SmartPort interface.  Must set up a SmartPort parameter block* in bank 0.  Then a command byte and word pointer to the parameter* list must be stored over the first 3 nop's just after the bank 0* dispatch return address.**               ($CnFF) + $Cn00 + $03 = SmartPort entry point*class1		longa	off		longi	on		ldy	#$00FF		; get ProDOS block entry point		lda	(<fw_addr),y		clc			; now add 3 to get SmartPort entry		adc	#$03		sta	<fw_addr** Now must set up call number, parameter list pointer and the* parameter list itself.  Parameter lists take on many formats.*		jsr	set_sp_command	; set up smartport command		bcs	no_sp_dsptch	; if dispatch doesnt apply to device		rep	#$20		; 16 bit 'm'		longa	on		lda	#parm_list	; set pointer to parameter list		sta	|parm_list_ptr		sep	#$20		; 8 bit 'm'		longa	off		jmp	set_reg		; ready for dispatchno_sp_dsptch		pld		plb		rep	#$20		; 16 bit 'm'		longa	off		lda	>save_sp	; restore native mode stack		tcs		lda	#$0000		; report no error		clc		rtl			; and return like an extended dispatch** If got here the device is a class 2 driver using the extended* SmartPort interface.  Must set up an extended SmartPort parameter* block in any bank. A command byte and longword pointer to the parameter* list must be stored over the all 5 nop's just after the bank 0* dispatch return address.**               ($CnFF) + $Cn00 + $03 = SmartPort entry point*class2		longa	off		longi	on		ldy	#$00FF		; get ProDOS block entry point		lda	(<fw_addr),y		clc			; now add 3 to get SmartPort entry		adc	#$03		sta	<fw_addr		jsr	set_sp_command	; set up smartport command		bcs	no_sp_dsptch	; if dispatch doesnt apply to device		lda	#$40		; make it an extended command		tsb	|sp_command		rep	#$20		; 16 bit 'm'		longa	on		lda	#parm_list	; set pointer to parameter list		sta	|parm_list_ptr		stz	|parm_list_ptr+2		sep	#$20		; 8 bit 'm'		longa	off		bra	set_reg		EJECT***************************************************************** Now ready to dispatch to firmware driver.  Must set up registers for* emulation mode dispatch as follows:**               X = $Cn*               Y = $n0*               A = character to output** The address on direct page (fw_addr) must be decremented and* placed on the stack since the mechanism for the dispatch is* an 'RTS' instruction.  Prior to dispatching, the direct register* must be set to absolute zero page.  Switch to emulation mode* occurs here.  This routine must switch the ROM in prior to* dispatching to the firmware.  In addition, the system speed will* be set to SLOW if the dispatch is to a slot rather than a port. ** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = $00*             DIR Reg = GS/OS Direct Page*               P Reg = 8 bit 'm', 8 or 16 bit 'x', native mode*             FW_ADDR = Entry point in firmware** EXIT:         A Reg = As returned from firmware*               X Reg = Combined X & Y returned from firmware*               Y Reg = Y returned from firmware*               B Reg = $00*             DIR Reg = GS/OS Direct Page*               P Reg = Carry returned from firmware*                       16 bit 'm' & 'x' native mode****************************************************************** The core routine is provided only for the device dispatcher* which must call SmartPort prior to having a device list* constructed.****************************************************************		export	b0_coreb0_core		rep	#$30		; 16 bit 'm' & 'x'		longa	on		longi	on** This routine sets the stack pointer to page 1 in preperation* for switching to emulation mode.*		tsc			; save native sp		sta	>save_sp		sep	#$20		; 8 bit 'm'		longa	off		xba			; get stack page in A		dec	a		; is stack in page 1?		beq	page1		; yes		lda	#$01		; if not, set page 1		xba		lda	>emulstack	; get emulation mode stack pointer		tcs			; to set page 1 stack pointerpage1		phb		phd		phk			; need data bank = $00		plb		eject***************************************************************** This is the normal entry for dispatches to firmware via* the bank 0 dispatcher.** Native and emulation stacks contain the following:** NATIVE STACK          EMULATION STACK**      K                 .*      PCH               .*      PCL               .*      .                 Data Bank*      .                 Dir Reg High*      .                 Dir Reg Low****************************************************************		export	set_regset_reg		longa	off;               longi   not determined at this entry point** Save system environment prior to dispatch.* 		sep	#$10		; 8 bit 'x'		longi	off		lda	|cyareg		; save system speed		pha		lda	|statereg	; and rom enable		pha** Must determine if the slot the dispatch will be executed to* is internal or external prior to setting the system speed.* System speed will be forced slow for external slots.*		ldy	#slot_num	; get slot number		lda	[<drvr_dib_ptr],y		and	#%00001000	; if bit 3=1 then external		jsr	a_times_16		trb	|cyareg		; set system speed		lda	#%00001000	; turn on the rom		sta	|statereg		php			; in case card disables IRQ** Now get ready for dispatch by placing return address as well* as dispatch address on the stack.* 		rep	#$20		; 16 bit 'm'		longa	on		pea	fw_return-1	; return address will be 5 nops		lda	<fw_addr	; decrement address prior to push		dec	a		pha** Ready for dispatch and return so set emulation mode and* register states for dispatch.*		sec			; set emulation mode		xce		longa	off		longi	off		ldx	<fw_addr+1	; set up register states		txa			; have $Cn in X		jsr	a_times_16		tay		lda	|a_reg		pea	$0000		; set absolute zero page		pld		phk		plb		eject** Native and emulation stacks contain the following:** NATIVE STACK          EMULATION STACK**      K                 .*      PCH               .*      PCL               .*      .                 Data Bank*      .                 Dir Reg High*      .                 Dir Reg Low*                        CYA Register*                        State Register*                        processor Status (save IRQ enable)*                        FW_RET-1 (High)*                        FW_RET-1 (Low)*                        ENTRY-1 (High)*                        ENTRY-1 (Low)*		rts			; dispatch to ENTRY		EJECT***************************************************************** On return from fw_addr, the execution address depends on the driver* class that the fw_addr dispatch was executed to.** Class 0 will resume at fw_return* Class 1 will resume at fw_return+3* Class 2 will resume at fw_return+5****************************************************************		export	fw_returnfw_return		export	sp_commandsp_command		dc.b	$ea		; NOP or SmartPort command		export	parm_list_ptrparm_list_ptr		dc.b	$ea		; NOP or Parameter list pointer		dc.b	$ea		; NOP or Parameter list pointer		dc.b	$ea		; NOP or Parameter list pointer		dc.b	$ea		; NOP or Parameter list pointer		eject***************************************************************** Must restore driver environment while preserving the status* that was returned from the firmware driver.  The environment* includes direct page, data bank & stack pointer.  Additionally,* the proper error status for the device must be returned.* Error status varies among devices as follows:** BASIC:        No error status is supported.*               A Reg = Character*               X Reg = Undefined*               Y Reg = Undefined** PASCAL:       A Reg = Character*               X Reg = Error Code*               Y Reg = $n0** ProDOS:       A Reg = Error code if carry set*               X Reg = Low byte block count on STATUS*               Y Reg = High byte block count on STATUS** SmartPort:    A Reg = Error code if carry set*               X Reg = Low byte transfer count on READ/RDBLK*               Y Reg = High byte transfer count on READ/RDBLK****************************************************************		export	unfutzunfutz            		longa	off		longi	off** Save away the error code while switching modes.* The V flag will be set if a soft error occured.  Soft* errors will be filtered before returning to the generated* driver core routines.*		stx	|sp_command	; in case returning from pascal		sta	|a_reg		php		pla		sta	|b0_temp** Restore system environment on return from dispatch.* 		plp			; restore IRQ enable		pla		sta	|statereg	; restore system state reg (rom enbl)		pla		sta	|cyareg		; save system speed		pld			; restore native mode direct page		plb			; restore native mode data bank** Switch back to native mode.*		xce			; preserve carry while switching modes		clc		xce			; native mode 8 bit 'm' & 'x'** Both 8 bit emulation mode index registers will now be combined* into a single 16 bit native mode index register.  The high byte* of the 16 bit X register will contain the value of the 8 bit* emulation mode Y register while the low byte of the 16 bit X* register will contain the value of the 8 bit emulation mode* X register.*		tya			; combine 8 bit index to a 16 bit reg		xba		txa		rep	#$30		; 16 bit 'm' & 'x'		longa	on		longi	on				tax		eject** Now restore native mode stack before returning to generated* driver core routines.*  _______________* |       |       |* | HIGH  |  LOW  |     16 bit X Register* |_______|_______|*     |       |________ 8 bit X returned by device*     |________________ 8 bit Y returned by device*		lda	>save_sp	; restore stack pointer		tcs** If this was a return from a SmartPort call then error codes* may need post-processed.  The dib may not contain the driver* class so the five 'NOP' instructions stored for class 0 devices* inline with the dispatch is examined to determine the driver class.*		lda	>parm_list_ptr	; are we counting devices?		cmp	#$EAEA		bne	not_c0_ret	; maybe** If this was an OPEN call to a BASIC device, then need to* save the I/O Hook in table for all other dispatches.*		ldy	#drvr_class	; need driver class....		lda	[<drvr_dib_ptr],y		beq	pro_ret		; if it's a ProDOS device		cmp	#$0080		; is it a character device?		bne	not_c0_ret	; no, don't init hook table** new code <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<* Changed BIT |c0_flag to the following. Note c0_flag is a byte!* Bit 7 of C0 flag is set if a Pascal1.1 device or cleared if* a BASIC device.*		lda	>c0_flag-1	; BASIC or Pascal1.1?		bmi	p_ret		; minus if a Pascal1.1 device** It's a BASIC device.  If this was an OPEN call then* need to initialize the hook table for this device.* If not an OPEN then just return with no error!*b_ret		lda	<drvr_call_num	; is it an open call?		cmp	#drvr_open		bne	not_b_open	; no, don't init hook table		ldy	#slot_num		lda	[<drvr_dib_ptr],y		and	#$0007		;clear external slot bit		dec	a		;minus one for zero based table.		asl	a		tax			; now have proper index to table		sep	#$20		; 8 bit 'm'		longa	off		lda	>in_hook	; send input hook to table		sta	>hook_table,x		inx		lda	>out_hook	; send output hook to table		sta	>hook_table,x		rep	#$20		; 16 bit 'm'		longa	onnot_b_open		lda	>a_reg		; exit with value		and	#$00FF		clc		rtl** Returned from a Pascal1.1 device.  If 8 bit quantity returned* in X register is zero then return value with no error.  If 8* bit quantity returned in X register was nonzero then return* X as error.*p_ret		lda	<drvr_call_num	; is it a status call?		cmp	#$0005		bne	not_p_status				jsr	get_fw_status	; carry as returned from device		rtlnot_p_status		sec			; restore error flag (X register) from device		lda	>sp_command		and	#$00FF		beq	not_b_open	; if no error, return data		sep	#$20		; else shift into 8-bit mode		longa	off		ora	#%00010000	; shift firmware error code into $30-$3F		xba			; put error code into high byte		lda	>a_reg		; get the returned accumulator value into low byte		rep	#$20		; back to 16-bit mode		longa	on		rtl			; return to generated driver** Return was from a ProDOS block device.  If value returned* in accumulator from device was nonzero then return with that* value as the error code.*pro_ret		jsr	get_fw_status	; get carry flag and accumulator from firmware		bcs	pro_error	; if device errored		lda	#no_error	; else make sure error is clearedpro_error		rtlget_fw_status		lda	>b0_temp	; restore error flag from device		ror	a		lda	>a_reg		; get returned error code		and	#$00FF		rts** Returned from a SmartPort device.  If any soft error* occured, this error is mapped to no error prior to* returning to the device driver.*not_c0_ret		lda	>a_reg		; retrieve the error code		and	#$0040		; is it a soft error?		bne	soft_error	; yes, not really an error		lda	>a_reg		; does error code need translated?		and	#$00FF		cmp	#$0001		; is it a BADCMD?		bne	not_bad_cmd	; noset_bad_parm		lda	#drvr_bad_parm	; else translate error code		bra	new_errornot_bad_cmd		cmp	#$0004		; is it a BADPCNT?		beq	set_bad_parm	; yes		cmp	#$0011		; is it a BADUNIT?		beq	set_no_dev	; yes		cmp	#$0006		; is it a BUSSERR?		bne	not_busserr	; no		lda	#drvr_io_error	; else translate error code		bra	new_errorset_no_dev		lda	#drvr_no_dev		bra	new_errornot_busserr		cmp	#$001F		; is it a NOINT?		bne	new_error	; nosoft_error		lda	#no_error	; NOINT is not an error!!!new_error		sta	>a_reg		; save new error code		sec			; assume an error occured		lda	>a_reg		; get returned error code		bne	exit_time	; assumed correct		clc		lda	#no_error	; else make sure error is clearedexit_time		rtl		export	a_times_16a_times_16		asl	a		asl	a		asl	a		asl	a		rts		endp		EJECT****************************************************************** This routine translates the GS/OS driver call number into* a SmartPort call.  If no translation is possible, the* Carry flag will be set on return.  This routine will examine* the DIB if the call is a read or write request to determine* if the device is a character device.  Character devices will* receive a read or write command while block devices will* receive readblock or writeblock commands.  A format command* will only be issued to character devices.  Some other calls* will have to be processed at the level just above the bank 0* dispatcher (such as : Set_Newline, Get_Newline).** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Bank Zero*               P Reg = 0=e=x, 1=m** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             DIR Reg = GS/OS Direct Page*               B Reg = Bank Zero*               P Reg = 0=e=x, 1=m,*                       C=1 if dispatch doesnt apply.*                       C=0 if dispatch does apply & parameter*                       block is set up.*****************************************************************		export	set_sp_command	set_sp_command	proc		longa	off		longi	on		rep	#$21		; 16 bit 'm' & carry clear		longa	on		pea	set_sp_ret-1	; on return from setup routine		lda	<drvr_call_num	; get GS/OS command		asl	a		tax		lda	|sp_translate,x	; routine to do setup		pha		rts			; dispatch to setupset_sp_ret				; ; back to central dispatcher		sep	#$20		; 8 bit 'm'		longa	off		rts** Both the startup and shutdown calls are always translated into* a a standard control call with a control code of $00 to reset the device.*		export	sp_start_upsp_start_up		longa	on		longi	on		export	sp_shut_dnsp_shut_dn		longa	on		longi	on		lda	#$0004		; SmartPort control call		sta	|sp_command		ldy	#unit_num-1	; want dib unit number in high byte		lda	[<drvr_dib_ptr],y		and	#$FF00		; low byte will be pcount		ora	#$0003		sta	|parm_list		stz	|parm_list+2	; no control list		stz	|parm_list+3	; control code = reset device ($00)		rts** The open call only applies to character devices.  The carry will* be returned set if the dispatch is referencing a block device.* Only standard OPEN parameter blocks will be generated for character* devices.		export	sp_opensp_open		longa	on		longi	on		jsr	b0_get_dev_char	; get device characteristics		beq	sp_open_char	; if character device		sec			; else no dispatch		rtssp_open_char		lda	#$0006		; SmartPort OPEN callsp_open_close		sta	|sp_command		ldy	#unit_num-1	; want dib unit number in high byte		lda	[<drvr_dib_ptr],y		and	#$FF00		; low byte will be pcount		ora	#$0001		rts				export	b0_get_dev_charb0_get_dev_char		ldy	#dev_char	; get at device characteristics		lda	[<drvr_dib_ptr],y		and	#$0080		; block or character device?		rts** This call applies to both character and block devices.  If the device* is a character device, a standard or extended read parameter block will* be generated.  If the device is a block device and the block size is not* 512 bytes, then a standard or extended read parameter block will be* generated.  If the device is a block device and the block size is 512 bytes* then a standard or extended readblock parameter block will be generated.* The generation of standard versus extended parameters blocks is based on* the driver class obtained from the GDIB.*		export	sp_readsp_read		longa	on		longi	on		lda	#$0001		; standard SP readblock call** This entry point used to set initial SmartPort command up.* If the device is a character device, the command will be* converted from a block device command to a character device* command.*sp_rd_wr		sta	|sp_command	; set initial sp command		jsr	b0_get_dev_char	; is this a character device?		bne	not_sp_char	; no, it's a block device** If the block is a nonstandard size or the device is a character* device, the command is converted here to a character device command.*not_std_block		lda	|sp_command	; convert command to extended		clc		adc	#$0007		sta	|sp_command		bra	set_rd_parms	; now setup the read parameter block** If the block size is not a standard 512 byte block then must* use the SmartPort character device protocol to access a non* standard block size.  This routine sets the proper command* based on the requested block size.*not_sp_char		lda	<drvr_blk_size	; is request standard block size (512)?		cmp	#$0200		bne	not_std_block	; no** Now must determine if device supports extended commands.  If so, the* command will be converted to the extended format.*set_rd_parms		ldy	#drvr_class	; does it support extended calls?		lda	[<drvr_dib_ptr],y		cmp	#$0002		bne	not_extended	; no** Now need to know if it's a character or block device call in order* to set the proper parameter block up for the call.*		lda	sp_command	; else change to extended call		and	#$0008		; block or character call?		bne	ext_char	; it's an extended character call** It's a block device so let's set up the extended block device* parameter block.*		ldy	#unit_num-1	; want dib unit number in high byte		lda	[<drvr_dib_ptr],y		and	#$FF00		; low byte will be pcount		ora	#$0003		sta	|parm_list		lda	<drvr_buf_ptr	; set buffer pointer		sta	|parm_list+2		lda	<drvr_buf_ptr+2		sta	|parm_list+4		lda	<drvr_blk_num	; set block address		sta	|parm_list+6		sta	>$FF3000	; *** WARNING *** this overflows the code space		lda	<drvr_blk_num+2		sta	|parm_list+8		clc		rts** It's a character device so let's set up the extended character* device parameter block.*ext_char		ldy	#unit_num-1	; want dib unit number in high byte		lda	[<drvr_dib_ptr],y		and	#$FF00		; low byte will be pcount		ora	#$0004		sta	|parm_list		lda	<drvr_buf_ptr	; set buffer pointer		sta	|parm_list+2		lda	<drvr_buf_ptr+2		sta	|parm_list+4		lda	<drvr_blk_size	; set block size		sta	|parm_list+6		lda	<drvr_blk_num	; set block address		sta	|parm_list+8		lda	<drvr_blk_num+2		sta	|parm_list+10		clc		rts** It's an standard command so let's leave the command alone and just* set up the pointer to the parameter list.*not_extended** Now need to know if it's a character or block device call in order* to set the proper parameter block up for the call.*		lda	|sp_command	; is it a character device call?		and	#$0008		bne	std_char	; yes, go set up character parms** It's a block device so let's set up the extended block device* parameter block.*		ldy	#unit_num-1	; want dib unit number in high byte		lda	[<drvr_dib_ptr],y		and	#$FF00		; low byte will be pcount		ora	#$0003		sta	|parm_list		lda	<drvr_buf_ptr	; set buffer pointer		sta	|parm_list+2		lda	<drvr_blk_num	; set block address		sta	|parm_list+4		sta	>$FF3000	; *** WARNING *** this overflows the code space		lda	<drvr_blk_num+1		sta	|parm_list+5		clc		rts** It's a character device so let's set up the extended character* device parameter block.*std_char		ldy	#unit_num-1	; want dib unit number in high byte		lda	[<drvr_dib_ptr],y		and	#$FF00		; low byte will be pcount		ora	#$0004		sta	|parm_list		lda	<drvr_buf_ptr	; set buffer pointer		sta	|parm_list+2		ldy	#block_size	; set block size		lda	[<drvr_dib_ptr],y		sta	|parm_list+4		lda	<drvr_blk_num	; set block address		sta	|parm_list+6		lda	<drvr_blk_num+1		sta	|parm_list+7		clc		rts** This call applies to both character and block devices.  If the device* is a character device, a standard or extended write parameter block will* be generated.  If the device is a block device and the block size is not* 512 bytes, then a standard or extended write parameter block will be* generated.  If the device is a block device and the block size is 512 bytes* then a standard or extended writeblock parameter block will be generated.* The generation of standard versus extended parameters blocks is based on* the driver class obtained from the GDIB.*		export	sp_writesp_write		longa	on		longi	on		lda	#$0002		; SmartPort writeblock command		jmp	sp_rd_wr** The close call only applies to character devices.  The carry will* be returned set if the dispatch is referencing a block device.* Only standard CLOSE parameter blocks will be generated for character* devices.		export	sp_closesp_close		longa	on		longi	on		jsr	b0_get_dev_char	; is this a block or character device?		beq	sp_close_char	; if character device		sec			; else no dispatch		rtssp_close_char		lda	#$0007		; SmartPort CLOSE call		jmp	sp_open_close** This routine sets up the device for a Status dispatch.  If the* device supports extended format, an extended status call will* be issued.  For standard status calls, the system buffer will* be used to return status information.*		export	sp_statussp_status		longa	on		longi	on		ldy	#sp_stat_trans	; assume standard status		lda	<d_class		and	#$000F		dec	a		; is it a class 1 device?		beq	setup_plist	; yes, assumed correct!		ldy	#esp_stat_trans	; else point at extended list		bra	setup_plist	; and setup command/plist		export	sp_controlsp_control           		longa	on		longi	on		ldy	#sp_ctrl_trans	; assume standard control		lda	<d_class		and	#$000F		dec	a		; is it a class 1 device?		beq	setup_plist	; yes, assumed correct!		ldy	#esp_ctrl_trans	; else point at extended list		EJECT****************************************************************** This code segment sets up the SmartPort command and the* parameter list associated with that command.  This routine* is only used by GS/OS status or control calls** ENTRY:        A Reg = Undefined*               X Reg = Undefined*               Y Reg = Pointer to translate table*             Dir Reg = GS/OS direct page*               B Reg = Undefined*               S Reg = Native mode stack*               P Reg = 0=m=x=e** EXIT:         A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = GS/OS direct page*               B Reg = Unchanged*               S Reg = Native mode stack*               P Reg = 0=m=x=e (c=1 if error, else 0)*****************************************************************setup_plist		sty	get_ptr+1	; self modify - lda |$0000,x		lda	<drvr_stat_code	; point at parameter list		asl	a		taxget_ptr		lda	|$0000,x	; get parameter list address		tax		ldy	#$0000set_command	lda	|$0000,x		sta	|sp_command	; set up command		inxplist_loop	lda	|$0000,x	; build the parameter list		sta	|parm_list,y		iny		inx		cpy	#$0007		bne	plist_loop		ldy	#unit_num	; patch unit number from the DIB		lda	[<drvr_dib_ptr],y		xba		ora	|parm_list		sta	|parm_list		lda	<drvr_stat_code	; is this an eject?		cmp	#$0002		bne	sys_buf_done		stz	|sys_buffer	; control list needs $0000 countsys_buf_done		clc		rts** There is no equivalent function for smartport.  No dispatch will be* issued to a device.  This routine will return with carry set to indicate* no dispatch should occur.*		export	sp_flushsp_flush		longa	on		longi	on		sec		rts		endp** The following tables are used to translate GS/OS driver* call numbers into either standard or extended SmartPort* driver call numbers.*		export	sp_translate	sp_translate	proc		dc.w	sp_start_up-1	; startup		dc.w	sp_open-1	; open		dc.w	sp_read-1	; read		dc.w	sp_write-1	; write		dc.w	sp_close-1	; close		dc.w	sp_status-1	; status		dc.w	sp_control-1	; control		dc.w	sp_flush-1	; flush		dc.w	sp_shut_dn-1	; shut down** The following table is used to translate GS/OS status codes to a* SmartPort command # and status code.  The table contains a list of* pointers to default parameter lists for the SmartPort call.*		export	sp_stat_transsp_stat_trans		dc.w	std_dev_stat	; return device status		export	esp_stat_transesp_stat_trans		dc.w	ext_dev_stat	; return device status** The following table is used to translate GS/OS status codes to a* SmartPort command # and control code.  The table contains a list of* pointers to default parameter lists for the SmartPort call.*		export	sp_ctrl_transsp_ctrl_trans		dc.w	std_reset	; reset device		dc.w	std_format	; format device		dc.w	std_eject	; eject media		dc.w	std_set_dcb	; set control parameters		export	esp_ctrl_transesp_ctrl_trans		dc.w	ext_reset	; reset device		dc.w	ext_format	; format device		dc.w	ext_eject	; eject media		dc.w	ext_set_dcb	; set control parameters** The following tables are the actual parameter lists referenced above.* The first byte is the command number.  The parameter list starts at* the second byte.		export	std_dev_statstd_dev_stat	dc.b	$00		; status command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.w	sys_buffer	; status list pointer		dc.b	$00		; status code is for device status		export	ext_dev_statext_dev_stat	dc.b	$40		; status command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.l	sys_buffer	; status list pointer		dc.b	$00		; status code is for device status		export	std_resetstd_reset	dc.b	$04		; control command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.w	sys_buffer	; status list pointer		dc.b	$00		; status code is for device status		export	ext_resetext_reset	dc.b	$40		; control command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.l	sys_buffer	; status list pointer		dc.b	$00		; status code is for device status		export	std_formatstd_format	dc.b	$03		; format command		dc.b	$01		; pcnt		dc.b	$00		; unit number must come from DIB		export	ext_formatext_format	dc.b	$43		; format command		dc.b	$01		; pcnt		dc.b	$00		; unit number must come from DIB		export	std_ejectstd_eject	dc.b	$04		; control command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.w	sys_buffer	; status list pointer		dc.b	$04		; status code is for eject		export	ext_ejectext_eject	dc.b	$44		; control command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.l	sys_buffer	; status list pointer		dc.b	$04		; status code is for eject		export	std_set_dcbstd_set_dcb	dc.b	$04		; control command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.w	sys_buffer	; status list pointer		dc.b	$01		; status code is for set DCB		export	ext_set_dcbext_set_dcb	dc.b	$44		; control command		dc.b	$03		; pcnt		dc.b	$00		; unit number must come from DIB		dc.l	sys_buffer	; status list pointer		dc.b	$01		; status code is for set DCB** The following tables are used to translate GS/OS driver* call numbers into ProDOS block device call numbers.*		export	pro_transpro_trans		dc.b	$00		; startup -> status		dc.b	$00		; open    -> status		dc.b	$01		; read    -> read		dc.b	$02		; write   -> write		dc.b	$00		; close   -> status		dc.b	$00		; status  -> status		dc.b	$03		; control -> format		dc.b	$00		; flush   -> status		dc.b	$00		; shutdn  -> status		endp		EJECT******************************************************************* The following routine copies data from the system buffer to* the buffer specified in the call parameter list.** ENTRY:        A Reg = Error code from device*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'*                       c = 0 if no error from device*                       c = 1 if error from device** EXIT:         A Reg = Unchanged*               X Reg = Unchanged*               Y Reg = Unchanged*               B Reg = Unchanged*             Dir Reg = Unchanged*               P Reg = Unchanged******************************************************************		export	system_to_buf	system_to_buf	proc		sec		bra	buffer_xfer				EJECT****************************************************************** This routine is used to transfer data from the buffer* specified in the parameter list to the system buffer.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = 16 bit 'm' & 'x' native mode** EXIT:         A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Current Program Bank*             Dir Reg = GSOS Direct Page*               P Reg = 16 bit 'm' & 'x' native mode*****************************************************************		export	buf_to_systembuf_to_system             		longa	on		longi	on		clcbuffer_xfer		php		pha		phx		phy		phb		bcc	from_device				pea	sys_buffer>>16	; source is buffer		pea	sys_buffer		pei	<drvr_buf_ptr+2	; destination is buffer		pei	<drvr_buf_ptr		bra	do_buf_xfer		from_device		pei	<drvr_buf_ptr+2	; source is buffer		pei	<drvr_buf_ptr		pea	sys_buffer>>16	; destination is buffer		pea	sys_bufferdo_buf_xfer		pea	$0000		; transfer count		pei	<drvr_blk_size		pea	move_sinc_dinc	; src incr & dest incr		jsl	move_info	; go do it to it		plb		ply		plx		pla		plp		rtl		EJECT******************************************************************* The following routine copies the contents of a block that* resides in the cache to the buffer specified by the driver* call.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'** EXIT:         A Reg = Unspecified*               X Reg = Same as entry*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'******************************************************************		export	cache_to_buffcache_to_buff		pei	<drvr_cach_ptr+2 ; source is buffer		pei	<drvr_cach_ptr		pei	<drvr_buf_ptr+2	; destination is buffer		pei	<drvr_buf_ptr		bra	set_move_cnt	; transfer count		EJECT******************************************************************* The following routine copies the contents of a block that* resides in the buffer specified by the driver call to the* cache.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'** EXIT:         A Reg = Unspecified*               X Reg = Same as entry*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = 16 bit 'm' & 'x'******************************************************************		export	buff_to_cachebuff_to_cache		pei	<drvr_buf_ptr+2	; source is buffer		pei	<drvr_buf_ptr		pei	<drvr_cach_ptr+2 ; destination is buffer		pei	<drvr_cach_ptr		export	set_move_cntset_move_cnt		pea	$0000		; transfer count		pei	<drvr_blk_size		pea	move_sinc_dinc	; src incr & dest incr		jsl	move_info	; go do it to it		rtl		eject******************************************************************* The following routine calls the system ID routine.  All* register outputs reflect the machine ID values returned from* the rom call except that the processor status will indicate* Z=0 if the rom version is $01.** ENTRY:        A Reg = Unspecified*               X Reg = Unspecified*               Y Reg = Unspecified*               B Reg = Unspecified*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x x  0** EXIT:         A Reg = Unspecified*               X Reg = Same as entry*               Y Reg = Unspecified*               B Reg = Same as entry*             Dir Reg = GS/OS Direct Page*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x 0 x  0 If not rom version 01*                       x x 0 0 0 x 1 x  0 If rom version 01******************************************************************		export	machine_idmachine_id		longa	on		longi	on		sep	#$20		; 8 bit 'm'		longa	off		lda	>statereg	; preserve rom select		pha		ora	#%00001000	; and select the rom		sta	>statereg		rep	#$20		; 16 bit 'm'		longa	on		phb		phk		plb		sec		jsr	$FE1F		; call monitor rom ID routine		plb		xba		sep	#$20		; 8 bit 'm'		longa	off		pla			; restore rom selection		sta	>statereg		rep	#$20		; 16 bit 'm'		longa	on		xba		and	#$00FF		cpy	#$0001		rtl		endp		eject******************************************************************* This routine is used to dispatch to a routine in any* language card space based on the LC MODE.** ENTRY: Call via a 'JSL' instruction.....**        Stack prior to 'JSL' is as follows:**                       Byte            ; so address occupies a longword*                       K               ; dispatch address*                       PC              ; dispatch address*                       LC MODE         ; word describing LC where:*               SP --->                 ;     $0000 = LC bank 0*                                       ;     $0001 = LC bank 1**               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*               B Reg = Undefined*             Dir Reg = Undefined*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x    0*                                     x     as set by caller** AT DISPATCH TO ROUTINE IN LC:**         Routine is called via a 'JSL' instruction.....**               A Reg = Unchanged*               X Reg = unchanged*               Y Reg = unchanged*               B Reg = unchanged*             Dir Reg = unchanged*               P Reg = N V M X D I Z C  E*                       x x 0 0 0 x x    0*                                     x     as set by caller** EXIT:         A Reg = value returned from routine in LC*               X Reg = value returned from routine in LC*               Y Reg = value returned from routine in LC*               B Reg = value returned from routine in LC*             Dir Reg = value returned from routine in LC*               P Reg = N V M X D I Z C  E*                           0 0 0 x x    0*                       x x                 based on value in A Reg*                                        x  as set by routine that was called******************************************************************		export	lc_dispatcher	lc_dispatcher	proc		longa	on		longi	onlc_bank		equ	1		; byte - current LC bankdir_reg		equ	lc_bank+1	; word - direct register on entrya_reg		equ	dir_reg+2	; word - accumulator on entryret_addr	equ	a_reg+2		; addr - who called -1lc_mode		equ	ret_addr+3	; word - new LC banklc_addr		equ	lc_mode+2	; long - address to dispatch to** Change stack to direct page for easy manipulation of parameters*		pha			; save environment		phd		sep	#$20		; 8 bit 'm'		longa	off		lda	>statereg	; set destination LC bank		pha		tsc			; change stack into direct page		tcd** Move LC bank (bit 0 of input word) to bit 2 for hardware* register manipulation.*		lda	#%00000001	; reconfigure mode word		and	<lc_mode		php		asl	a		asl	a		plp		sta	<lc_mode		lda	>statereg		and	#%11111011		ora	<lc_mode		sta	>statereg** Preset dispatch address*		lda	<lc_addr+2		sta	>lc_jump_addr+3		rep	#$20		; 16 bit 'm'		longa	on		lda	<lc_addr		sta	>lc_jump_addr+1** Move parameters on stack for easy exit on return from LC.*		phx		ldx	#$0006clean_stack		lda	<lc_bank,x		sta	<ret_addr+1,x		dex		dex		bpl	clean_stack		plx		phk			; clean up stack for dispatch		pla		pld			; set registers for dispatch		pla** Dispatch to function resident in LC.*		export	lc_jump_addrlc_jump_addr		jsl	>$000000	; self modified to destination address		rep	#$30		; make sure in 16 bit 'm' & 'x'		longa	on		longi	on		sta	5,s		; save registers for return		tdc		sta	3,s		phk			; clean off remaining byte		pla		sep	#$20		; 8 bit 'm'		longa	off		pla			; restore original LC		sta	>statereg		rep	#$20		; 16 bit 'm'		longa	on		pld		pla		rtl		endp		end