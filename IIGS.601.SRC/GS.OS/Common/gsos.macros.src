 Pcount (minimum = $0003)*        Input          Word            Level*&lab jsl $E100A8	DC.B	$1B,$20	DC.L	&params MEND MACRO&lab _Get_Dir_Entry &params** GS/OS System Call: GET_DIR_ENTRY (subclass 1)**        Input          Word            Pcount (minimum = $0005)*        Input          Word            Reference number*        Input          Word            $0000*        Input          Word            Base*        Input          Word            Displacement*        Input          Long            Pointer to output NAME string*        Output         Word            Entry number*        Output         Word            FileType*        Output         Long            EOF*        Output         Long            Block count*        Output         DoubleLong      Create date / time*        Output         DoubleLong      Mod date / time*        Output         Word            Access*        Output         Long            AuxType*        Output         Word            File system ID*        Input          Long            Option list pointer*&lab jsl $E100A8	DC.B	$1C,$20	DC.L	&params MEND MACRO&lab _Get_Dev_Number &params** GS/OS System Call: GET_DEV_NUMBER (subclass 1)**        Input          Word            Pcount (minimum = $0002)*        Input          Long            Pointer to device name*        Input          Word            Device number*&lab jsl $E100A8	DC.B	$20,$20	DC.L	&params MEND MACRO&lab _Get_Last_Dev &params** GS/OS System Call: GET_LAST_DEV (subclass 1)** WARNING: There is no class 1 equivalent for this call!!!* MEND MACRO&lab _Read_Block &params** GS/OS System Call: READ_BLOCK (subclass 1)**        Input          Word            Pcount (minimum = $0003)*        Input          Word            Device number*        Input          Long            Pointer to data buffer*        Input          Word            Block address*&lab jsl $E100A8	DC.B	$22,$20	DC.L	&params MEND MACRO&lab _Write_Block &params** GS/OS System Call: WRITE_BLOCK (subclass 1)**        Input          Word            Pcount (minimum = $0003)*        Input          Word            Device number*        Input          Long            Pointer to data buffer*        Input          Word            Block address*&lab jsl $E100A8	DC.B	$22,$20	DC.L	&params MEND MACRO&lab _Format &params** GS/OS System Call: FORMAT (subclass 1)**        Input          Word            Pcount (minimum = $0003)*        Input          Long            Pointer to device name*        Input          Long            Pointer to volume name*        Input          Word            File system ID*&lab jsl $E100A8	DC.B	$24,$20	DC.L	&params MEND MACRO&lab _Erase_Disk &params** GS/OS System Call: ERASE_DISK (subclass 1)**        Input          Word            Pcount (minimum = $0003)*        Input          Long            Pointer to device name*        Input          Long            Pointer to volume name*        Input          Word            File system ID*&lab jsl $E100A8	DC.B	$25,$20	DC.L	&params MEND MACRO&lab _Get_Pathname &params** GS/OS System Call: GET_PATHNAME (subclass 1)** WARNING: This call is not implemented!!!*&lab jsl $E100A8	DC.B	$26,$20	DC.L	&params MEND MACRO&lab _Get_Name &params** GS/OS System Call: GET_NAME (subclass 1)**        Input          Word            Pcount (minimum = $0001)*        Input          Long            Pointer to output string*&lab jsl $E100A8	DC.B	$27,$20	DC.L	&params MEND MACRO&lab _Get_Boot_Vol &params** GS/OS System Call: GET_BOOT_VOL (subclass 1)**        Input          Word            Pcount (minimum = $0001)*        Input          Long            Data_Buffer*&lab jsl $E100A8	DC.B	$28,$20	DC.L	&params MEND MACRO&lab _Quit &params** GS/OS System Call: QUIT (subclass 1)**        Input          Word            Pcount (minimum = $0000)*        Input          Long            Pointer to pathname*        Input          Word            Flags*&lab jsl $E100A8	DC.B	$29,$20	DC.L	&params MEND MACRO&lab _Get_Version &params** GS/OS System Call: GET_VERSION (subclass 1)**        Input          Word            Pcount (minimum = $0001)*        Output         Word            Version number*&lab jsl $E100A8	DC.B	$2A,$20	DC.L	&params MEND MACRO&lab _Get_FST_Info &params** GS/OS System Call: GET_FST_INFO (subclass 1)**        Input          Word            Pcount (minimum = $0001)*        Input          Word            FST number*        Output         Word            File system ID*        Input          Long            Pointer to FST name string*        Output         Word            Version*        Output         Word            Attributes*        Output         Word            Block size*        Output         Long            Maximum volume size*        Output         Long            Maximum file size*&lab jsl $E100A8	DC.B	$2B,$20	DC.L	&params MEND MACRO&lab _D_Info &params** GS/OS System Call: D_INFO (subclass 1)**        Input          Word            Pcount (minimum = $0002)*        Input          Word            Device number*        Input          Long            Pointer to device name*        Output         Word            Device characteristics*        Output         Long            Total blocks*        Output         Word            Slot number*        Output         Word            Unit number*        Output         Word            Version number*        Output         Word            Device ID number*&lab jsl $E100A8	DC.B	$2C,$20	DC.L	&params MEND MACRO&lab _D_Status &params** GS/OS System Call: D_STATUS (subclass 1)**        Input          Word            Pcount (minimum = $0005)*        Input          Word            Device number*        Input          Word            Status code*        Input          Long            Pointer to status list*        Input          Long            Request count*        Output         Long            Transfer count*&lab jsl $E100A8	DC.B	$2D,$20	DC.L	&params MEND MACRO&lab _D_Control &params** GS/OS System Call: D_CONTROL (subclass 1)**        Input          Word            Pcount (minimum = $0005)*        Input          Word            Device number*        Input          Word            Control code*        Input          Long            Pointer to control list*        Input          Long            Request count*        Output         Long            Transfer count*&lab jsl $E100A8	DC.B	$2E,$20	DC.L	&params MEND MACRO&lab _D_Read &params** GS/OS System Call: D_READ (subclass 1)**        Input          Word            Pcount (minimum = $0006)*        Input          Word            Device number*        Input          Long            Pointer to data buffer*        Input          Long            Request count*        Input          Long            Starting block*        Input          Word            Block size*        Output         Long            Transfer count*&lab jsl $E100A8	DC.B	$2F,$20	DC.L	&params MEND MACRO&lab _D_Write &params** GS/OS System Call: D_WRITE (subclass 1)**        Input          Word            Pcount (minimum = $0006)*        Input          Word            Device number*        Input          Long            Pointer to data buffer*        Input          Long            Request count*        Input          Long            Starting block*        Input          Word            Block size*        Output         Long            Transfer count*&lab jsl $E100A8	DC.B	$30,$20	DC.L	&params MEND MACRO&lab _Alloc_Interrupt &params** GS/OS System Call: ALLOC_INTERRUPT (subclass 1)**        Input          Word            Pcount (minimum = $0002)*        Output         Word            Interrupt number*        Input          Long            Pointer to interrupt handler*        Input          Word            Polling order*&lab jsl $E100A8	DC.B	$31,$20	DC.L	&params MEND MACRO&lab _Dealloc_Interrupt &params** GS/OS System Call: DEALLOC_INTERRUPT (subclass 1)**        Input          Word            Pcount (minimum = $0001)*        Input          Word            Interrupt number*&lab jsl $E100A8	DC.B	$32,$20	DC.L	&params MEND MACRO&lab _GetNextEvent&lab ldx #$0A06 jsl $E10000 MEND MACRO&lab _WindStatus&lab ldx #$060E jsl $E10000 MEND         MACRO&lab     str   &string&lab	DC.B	L:&string	DC.B	'&string'         MEND;............................................................;;        Pull long (4 bytes) from stack;;    pulllong address             - pull off stack to address;    pulllong addr1,addr2         - pull off stack into 2 places;    pulllong [zeropage],offset   - pull off stack and store indirectly             ;    pulllong                     - pull off stack and leave in A;...............................................................	MACRO	pulllong &addr1,&addr2	IF &addr1='' THEN		pullword		pullword	ELSEIF &addr2='' THEN		pullword  &addr1		pullword  &addr1+2	ELSEIF &addr1[1:1]='[' THEN		ldy   #&addr2		pullword  &addr1,y		ldy   #&addr2+2		pullword  &addr1,y	ELSE		pullword  &addr1		sta   &addr2		pullword  &addr1+2		sta   &addr2+2	ENDIF	MEND;...............................................................;;        Pull 2 bytes from stack;;    pullword loc     -- pulls bytes off stack and stores in 'loc';    pullword loc,x   -- pulls bytes off stack and stores in 'loc,x';    pullword         -- pulls bytes off stack and leaves in A;...............................................................	MACRO	pullword &addr,&reg		pla	IF &addr­'' THEN		IF &reg­'' THEN			sta		&addr,&reg		ELSE			sta		&addr		ENDIF	ENDIF	MEND;............................................................;;        Push long (4 bytes) onto stack;;    pushlong address             - push contents of address;    pushlong address,x           - push contents of address,x;    pushlong const,s             - push contents of stack+const    ;    pushlong #address/const      - push address or constant;    pushlong [zeropage],offset   - push using indirect address;...............................................................	MACRO	pushlong &addr,&offset	IF &addr[1:1]='#' THEN		pea		&addr[2:255]>>16		pea		|&addr[2:255]	ELSEIF &addr[1:1]='[' THEN		ldy		#&offset+2		pushword &addr,y		ldy		#&offset		pushword &addr,y	ELSEIF &offset='s' THEN		pushword &addr+2,s		pushword &addr,s	ELSEIF &offset='' THEN		pushword  &addr+2		pushword  &addr	ELSE		pushword &addr+2,&offset		pushword &addr,&offset	ENDIF	MEND;...............................................................;;        Push 2 bytes onto stack;;    pushword loc     -- pushes bytes onto stack from 'loc';    pushword loc,x   -- pushes bytes onto stack from 'loc,x';    pushword #n      -- pushes constant #n onto stack;    pushword         -- pushes bytes onto stack (from A);...............................................................	MACRO	pushword &addr,&reg	IF &addr[1:1]='#' AND &SETTING('LONGA')='ON' THEN		pea		|&addr[2:255]	ELSE		IF &addr­'' THEN			IF &reg­'' THEN 				lda		&addr,&reg			ELSE				lda		&addr			ENDIF		ENDIF		pha	ENDIF	MEND MACRO&lab _DisposeRgn&lab ldx #$6804 jsl $E10000 MEND MACRO&lab _NewRgn&lab ldx #$6704 jsl $E10000 MEND MACRO&lab _RectRgn&lab ldx #$6C04 jsl $E10000 MEND MACRO&lab _Desktop&lab ldx #$0C0E jsl $E10000 MEND MACRO&lab _GetFirstWindow&lab ldx #$520E jsl $E10000 MEND MACRO&lab _GetNextWindow&lab ldx #$2A0E jsl $E10000 MEND MACRO&lab _RefreshDesktop&lab ldx #$390E jsl $E10000 MEND MACRO&lab _DeskShutDown&lab ldx #$0305 jsl $E10000 MEND MACRO&lab _CloseAllNDAs&lab ldx #$1D05 jsl $E10000 MEND MACRO&lab _GetCursorAdr&lab ldx #$8F04 jsl $E10000 MEND MACRO&lab _InitCursor&lab ldx #$CA04 jsl $E10000 MEND MACRO&lab _SetCursor&lab ldx #$8E04 jsl $E10000 MEND MACRO&lab _LEStatus&lab ldx #$0614 jsl $E10000 MEND MACRO&lab _CtlStatus&lab ldx #$0610 jsl $E10000 MEND MACRO&lab _AddToQueue&lab ldx #$2e03 jsl $E10000 MEND MACRO&lab _DeleteFromQueue&lab ldx #$2f03 jsl $E10000 MEND		macro&lab		end_script&lab		DC.B	00		mend		macro&lab		ctype	&op&lab		DC.B	$10		DC.W	&op*2		mend		macro&lab		pcount	&count&lab		DC.B	$20+&count		mend		macro&lab		pathptr	&offset&lab		DC.B	$30+&offset		mend		macro&lab		refnum	&offset&lab		DC.B	$40+&offset		mend		macro&lab		outpath	&offset&lab		DC.B	$50+&offset		mend		macro&lab		maxpcnt	&count&lab		DC.B	$60+&count		mend		macro&lab		exec	&address&lab		DC.B	$E0		DC.A	&address		mend		macro&lab		escape	&op		DC.B	$F0+&op		mend		macro&lab		classes	&count&lab		DC.B	&count		mend		macro&lab		info_at	&ptr&lab		DC.W	&ptr		mend		macro		no_such_class		DC.W	0000		mend		macro&lab		set_isn	&isn		lda	#&isn		bra	common_dispatch		mend		macro&lab		dnum	&offset&lab		DC.B	$70+&offset		mend		MACRO&lab		_SetHeartBeat&lab		ldx	#$1203		jsl	$E10000		MEND		MACRO&lab		_IntSource&lab		ldx	#$2303		jsl	$E10000		MEND		MACRO&lab		_DelHeartBeat&lab		ldx	#$1303		jsl	$E10000		MEND		macro		writehex &value				lcla	&val&val		seta	&eval(&value)		lclc	&hex&hex		setc	'0123456789ABCDEF'			lcla	&h0,&h1,&h2,&h3,&h4,&h5&h5		seta	(&val/$100000)&h4		seta	(&val-(&h5*$100000))/$10000&h3		seta	(&val-(&h5*$100000)-(&h4*$10000))/$1000&h2		seta	(&val-(&h5*$100000)-(&h4*$10000)-(&h3*$1000))/$100&h1		seta	(&val-(&h5*$100000)-(&h4*$10000)-(&h3*$1000)-(&h2*$100))/$10&h0		seta	(&val-(&h5*$100000)-(&h4*$10000)-(&h3*$1000)-(&h2*$100)-(&h1*$10))		write	'$'		write	&hex[&h5+1]		write	&hex[&h4+1]		write	&hex[&h3+1]		write	&hex[&h2+1]		write	&hex[&h1+1]		write	&hex[&h0+1]		endm		macro		writelnhex	&value		writehex	&value		writeln		''		endm		macro		resetpc		gbla	&segment_pc		;Allocate a global counter.&segment_pc	seta	0			;Reset counter.		endm		macro		end_proc		gbla	&segment_pc		;Allocate a global counter.&segment_pc	seta	&segment_pc+&ord(*)	;Bump seg size counter.		endp		endm				macro		end_record		gbla	&segment_pc		;Allocate a global counter.&segment_pc	seta	&segment_pc+&ord(*)	;Bump seg size counter.		endr		endm				macro		freespace	&name,&start,&max,&len		lcla		&free&free		seta		&eval(&max)-&eval(&start)-&len		write		&name		write		' ('		writehex	&start		write		'-'		writehex	&max		write		'): '		writehex	&free		write		' ('		write		&free		writeln		') free bytes.'	if &free<0 then				;if code overran segment boundaries		aerror		&concat('Code size overflow in ',&name)	endif				endm