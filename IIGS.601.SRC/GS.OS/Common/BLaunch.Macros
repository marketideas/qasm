;-----------------------------------------------;;   ProDOS 8 Macros;;-----------------------------------------------		MACRO&LAB	QUIT	&DCB&LAB	JSR		$BF00		DC.B	$65		DC.W	&DCB		MEND		MACRO&LAB	GETFILEINFO &DCB&LAB	JSR		$BF00		DC.B	$C4		DC.W	&DCB 		MEND				MACRO&LAB	SETPREFIX &DCB&LAB 	JSR		$BF00		DC.B	$C6		DC.W	&DCB 		MEND				MACRO&LAB	GETPREFIX &DCB&LAB	JSR		$BF00		DC.B	$C7		DC.W	&DCB		MEND				MACRO&LAB 	OPEN	&DCB&LAB	JSR		$BF00		DC.B	$C8		DC.W	&DCB		MEND				MACRO&LAB	READ	&DCB&LAB	JSR		$BF00		DC.B	$CA		DC.W	&DCB		MEND				MACRO&LAB	CLOSE 	&DCB&LAB	JSR		$BF00		DC.B	$CC		DC.W	&DCB		MEND		MACRO&LAB	GETEOF	&DCB&LAB	JSR		$BF00		DC.B	$D1		DC.W	&DCB		MEND;-----------------------------------------------;;   General Purpose Macros;;-----------------------------------------------		MACRO		native &mode		clc		xce		IF &mode­'' THEN			&mode		ELSE			long		ENDIF		MEND			MACRO		emulation		sec		xce		longa	off		longi	off		MEND		MACRO		long		rep		#%00110000		longa	on		longi	on		MEND		MACRO		longm		rep		#%00100000		longa	on		MEND		MACRO		short		sep		#%00110000		longa	off		longi	off		MEND		MACRO		shortm		sep		#%00100000		longa	off		MEND;-----------------------------------------------;;   Toolbox Macros;;-----------------------------------------------		MACRO &lab 	_TLStartUp &lab 	ldx		#$0201      	jsl 	$E10000 		MEND 		MACRO &lab	_TLShutDown &lab	ldx		#$0301 		jsl		$E10000 		MEND 		MACRO&lab	_TLTextMountVolume&lab	ldx		#$1201		jsl		$E10000		MEND				MACRO&lab	_MessageCenter&lab	ldx		#$1501		jsl		$E10000		MEND				MACRO&lab	_MMStartUp&lab	ldx		#$0202		jsl		$E10000		MEND		MACRO &lab	_MMShutDown &lab	ldx		#$0302 		jsl		$E10000 		MEND 		MACRO&lab	_NewHandle&lab	ldx		#$0902		jsl		$E10000		MEND		MACRO&lab	_DisposeHandle&lab	ldx		#$1002		jsl		$E10000		MEND		MACRO&lab	_SysFailMgr&lab	ldx		#$1503		jsl		$E10000		MEND		MACRO&lab	_Int2Hex&lab	ldx		#$220b		jsl		$E10000		MEND