## make sure the GSOS variable is initialized#set GSOS {GSProjects}GS.OS:export GSOS## Set up the shell variables...#execute {GSOS}Scripts:GSOSvariables## Make the shell look in the Scripts folder for scripts...#set Commands "{Commands},{Scripts}"## Now we can start the build of the new SCSI drivers#Build -e SCSIManager					# the SCSI device managerBuild -e HD.Driver						# the SCSI HD DriverBuild -e CD.Driver						# the CD-ROM driver## Now we can start the build of GS/OS#Build -e OS