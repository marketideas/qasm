# UpdateGSOSonSystemDisk## This script copies the local image of the system disk for GS/OS up to the# disk4.1 and tools4.1 images on fettuccine.#duplicate -d -y {SystemDisk}prodos 		fettuccine:disk4.1:PRODOSduplicate -d -y {SDsystem}gs.os 		fettuccine:disk4.1:system:GS.OSduplicate -d -y {SDsystem}p8 			fettuccine:disk4.1:system:P8duplicate -d -y {SDsystem}start.gs.os 		fettuccine:disk4.1:system:START.GS.OSduplicate -d -y {SDsystem}gs.os.dev 		fettuccine:disk4.1:system:GS.OS.DEVduplicate -d -y {SDsystem}error.msg 		fettuccine:disk4.1:system:ERROR.MSGduplicate -d -y {SDfsts}pro.fst 		fettuccine:disk4.1:system:fsts:PRO.FSTduplicate -d -y {SDfsts}char.fst 		fettuccine:disk4.1:system:fsts:CHAR.FSTduplicate -d -y {SDfsts}hs.fst 			fettuccine:tools4.1:system:fsts:HS.FSTduplicate -d -y {SDdrivers}appledisk3.5 	fettuccine:disk4.1:system:drivers:APPLEDISK3.5duplicate -d -y {SDdrivers}console.driver 	fettuccine:disk4.1:system:drivers:CONSOLE.DRIVERduplicate -d -y {SDdrivers}scsihd.driver 	fettuccine:tools4.1:system:drivers:SCSIHD.DRIVERduplicate -d -y {SDdrivers}scsicd.driver 	fettuccine:tools4.1:system:drivers:SCSICD.DRIVERduplicate -d -y {SDdrivers}scsi.manager 	fettuccine:tools4.1:system:drivers:SCSI.MANAGERduplicate -d -y {SDdrivers}unidisk3.5 		fettuccine:tools4.1:system:drivers:UNIDISK3.5duplicate -d -y {SDdrivers}appledisk5.25 	fettuccine:tools4.1:system:drivers:APPLEDISK5.25