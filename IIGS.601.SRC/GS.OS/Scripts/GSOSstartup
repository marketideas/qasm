## Set up the shell variables...#execute {GSOS}Scripts:GSOSvariables## Set default tab for new windows to eight...#set tab 8 ;export tab## Make the shell look in the Scripts folder for scripts...#set Commands "{Commands},{Scripts}"export Commands## If the SkipGSOSmount flag is not set, mount project,set checkout directories,# and update the project menu...#if !{SkipGSOSmount}	mountproject A2CE_Sources:gsprojects:gs.os	checkoutdir -project gs.osº -r {GSOS}	addmenu Project '(-' ''	addMenu Project 'Update GSOS' ¶		'echo >> "{WorkSheet}"; checkout -p -project gs.osº -r -a ³³ {WorkSheet}'## Otherwise, create the Project menu...#else  if !{AlreadyHaveProjectMenu}	AddMenu Project 'New Project' 'NewProject -w ³³ "{WorkSheet}"'	AddMenu Project 'Check In' 'CheckIn -w ³³ "{WorkSheet}"'	AddMenu Project 'Check Out' 'CheckOut -w ³³ "{WorkSheet}"'	AddMenu Project '(-'   	''	AddMenu Project 'Mount All' ¶					'MountAll {GSOS}:'	AddMenu Project 'Mount Toolbox' ¶					'mountproject A2CE_Sources:GSProjects:GSToolbox ; ¶					 CheckOutDir -project GSToolboxº {GSOS}:GSToolbox: -r'	AddMenu Project 'Mount Includes' ¶					'mountproject A2CE_Sources:GSProjects:Includes ; ¶					 CheckOutDir -project Includesº {MPW} -r'	AddMenu Project 'Mount GS.OS' ¶					'mountproject A2CE_Sources:GSProjects:GS.OS ; ¶					 CheckOutDir -project GS.OSº {GSOS} -r'	AddMenu Project 'Mount A.U.G.' ¶					'mountproject A2CE_Sources:GSProjects:a.u.g. ; ¶					 CheckOutDir -project a.u.g.º {GSOS}:a.u.g.: -r'	AddMenu Project 'Mount BASIC' ¶					'mountproject A2CE_Sources:GSProjects:BASIC.SYSTEM ; ¶					 CheckOutDir -project BASIC.SYSTEMº {GSOS}:BASIC.SYSTEM -r'	AddMenu Project 'Mount Odds N Ends' ¶					'mountproject A2CE_Sources:GSProjects:SD.ODDS.N.ENDS ; ¶					 CheckOutDir -project SD.ODDS.N.ENDSº {GSOS}:SD.ODDS.N.ENDS: -r'	AddMenu Project '(-'   	''	AddMenu Project 'Update All' 		¶					'open {worksheet};	¶					 echo "Updating All..." >> "{WorkSheet}"; ¶					 CheckOutAll -newer '	AddMenu Project 'Update Toolbox' 	¶					'open {worksheet};	¶					 echo "Updating GSToolbox..." >> "{WorkSheet}"; ¶					 CheckOut -project GSToolboxº -r -newer -p '	AddMenu Project 'Update Includes' 	¶					'open {worksheet};	¶					 echo "Updating Includes..." >> "{WorkSheet}"; ¶					 CheckOut -project Includesº -r -newer -p '	AddMenu Project 'Update GS.OS' 		¶					'open {worksheet};	¶					 echo "Updating GS.OS..." >> "{WorkSheet}"; 	¶					 CheckOut -project GS.OSº -r -newer -p '	AddMenu Project 'Update BASIC' 		¶					'open {worksheet};	¶					 echo "Updating BASIC..."  >> "{WorkSheet}";	¶					 CheckOut -project BASIC.SYSTEMº -r -newer -p '	AddMenu Project 'Update A.U.G.' 	¶					'open {worksheet};	¶					 echo "Updating A.U.G...." >> "{WorkSheet}";	¶					 CheckOut -project a.u.g.º -r -newer -p '	AddMenu Project 'Update Odds N Ends' 	¶					'open {worksheet};	¶					 echo "Updating Odds N Ends..." >> "{WorkSheet}"; ¶					 CheckOut -project SD.ODDS.N.ENDSº -r -newer -p '  endend## Set up the GSOS directories menu...#addmenu GSOS 'HFS.FST' 'set item "HFS.FST"; set dir "{HFS}" ; execute GSOSdirectory'addmenu GSOS 'ProDOSFST' 'set item "ProDOSFST"; set dir "{ProDOS}" ; execute GSOSdirectory'addmenu GSOS 'CharacterFST' 'set item "CharacterFST"; set dir "{Character}" ; execute GSOSdirectory'addmenu GSOS 'HighSierraFST' 'set item "HighSierraFST"; set dir "{HighSierra}" ; execute GSOSdirectory'addmenu GSOS 'PascalFST' 'set item "PascalFST"; set dir "{PascalFST}" ; execute GSOSdirectory'addmenu GSOS 'DOS3.3FST' 'set item "DOS3.3FST"; set dir "{DOS3.3}" ; execute GSOSdirectory'addmenu GSOS '(-' ''addmenu GSOS 'OS' 'set item "OS"; set dir "{OS}" ; execute GSOSdirectory'addmenu GSOS 'FSTs' 'set item "FSTs"; set dir "{FSTs}" ; execute GSOSdirectory'addmenu GSOS 'Boot' 'set item "Boot"; set dir "{GSOSboot}" ; execute GSOSdirectory'addmenu GSOS 'Common' 'set item "Common"; set dir "{Common}" ; execute GSOSdirectory'addmenu GSOS 'Loader' 'set item "Loader"; set dir "{Loader}" ; execute GSOSdirectory'addmenu GSOS 'ExpressLoad' 'set item "ExpressLoad"; set dir "{ExpressLoad}" ; execute GSOSdirectory'addmenu GSOS 'Object' 'set item "Object"; set dir "{Object}" ; execute GSOSdirectory'addmenu GSOS 'Scripts' 'set item "Scripts"; set dir "{Scripts}" ; execute GSOSdirectory'addmenu GSOS 'Drivers' 'set item "Drivers"; set dir "{Drivers}" ; execute GSOSdirectory'addmenu GSOS 'Listings' 'set item "Listings"; set dir "{Listings}" ; execute GSOSdirectory'addmenu GSOS 'MakeFiles' 'set item "MakeFiles"; set dir "{MakeFiles}" ; execute GSOSdirectory'addmenu GSOS 'SystemDisk' 'set item "SystemDisk"; set dir "{SystemDisk}" ; execute GSOSdirectory'addmenu GSOS 'WorkFolder' 'set item "WorkFolder"; set dir "{WorkFolder}" ; execute GSOSdirectory'addmenu GSOS 'SupervisoryDrivers' 'set item "SupervisoryDrivers"; set dir "{SupervisoryDrivers}" ; execute GSOSdirectory'addmenu GSOS '(-' ''addmenu GSOS 'SCM' 'set item "SCM"; set dir "{SCM}" ; execute GSOSdirectory'addmenu GSOS 'Gquit' 'set item "Gquit"; set dir "{Gquit}" ; execute GSOSdirectory'addmenu GSOS 'BankZero' 'set item "BankZero"; set dir "{BankZero}" ; execute GSOSdirectory'addmenu GSOS 'InitManager' 'set item "InitManager"; set dir "{InitManager}" ; execute GSOSdirectory'addmenu GSOS 'CacheManager' 'set item "CacheManager"; set dir "{CacheManager}" ; execute GSOSdirectory'addmenu GSOS 'ErrorMessages' 'set item "ErrorMessages"; set dir "{ErrorMessages}" ; execute GSOSdirectory'addmenu GSOS 'DeviceDispatcher' 'set item "DeviceDispatcher"; set dir "{DeviceDispatcher}" ; execute GSOSdirectory'addmenu GSOS '(-' ''addmenu GSOS 'SDsystem' 'set item "SDsystem"; set dir "{SDsystem}" ; execute GSOSdirectory'addmenu GSOS 'SDdrivers' 'set item "SDdrivers"; set dir "{SDdrivers}" ; execute GSOSdirectory'addmenu GSOS 'SDfsts' 'set item "SDfsts"; set dir "{SDfsts}" ; execute GSOSdirectory'addmenu GSOS 'SDdeskaccs' 'set item "SDdeskaccs"; set dir "{SDdeskaccs}" ; execute GSOSdirectory'addmenu GSOS '(-' ''addmenu GSOS 'SCSI.Manager' 'set item "SCSI.Manager(1meg)"; set dir "{SCSI.Manager(1meg)}" ; execute GSOSdirectory'## Set the current directory to GSOS and set printoptions...#set item "OS"; set dir "{GSOS}" ; execute GSOSdirectoryset printoptions '-b2 -font Courier -size 7'