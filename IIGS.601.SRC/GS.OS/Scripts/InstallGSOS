# InstallGSOS# By Bryan Atsatt## This script will mount the GS.OS project, set the correct checkout directories# and add some needed commands to your UserStartup file...# directory ::set GSOS `directory`directory {GSOS}MakeFiles > dev:null ³ dev:null || ¶(loop	alert "Please set the directory to GSOS..."	directory `getfilename -d`	set GSOS `directory`	directory {GSOS}MakeFiles > dev:null ³ dev:null && break	continueend)directory :scriptsbegin	echo	echo '#'	echo '# Set up for GS/OS project...'	echo '#'	echo 'set GSOS '`echo {GSOS}`' ;export GSOS'	echo 'execute {GSOS}Scripts:GSOSstartup'end >> {MPW}UserStartupexecute {GSOS}Scripts:GSOSstartup