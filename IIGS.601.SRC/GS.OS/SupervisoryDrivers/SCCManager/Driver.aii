		msb	off		string	asis		print	sym		print	nopage		print	nomdir;---------------------------------------------------------------------------------;;			AppleTalk Supervisory Driver;;			    Copyright (c) 1988-1992;			   Apple Computer, Inc.;			   All rights reserved.;;---------------------------------------------------------------------------------;; The SCC supervisory driver goes in the */SYSTEM/DRIVERS/ directory.  It MUST; have the following attributes set correctly.;;	File type  - $00 BB;	Aux type   - $000 0140;;---------------------------------------------------------------------------------;; 0.01a		03/27/88	TGH	-First attempt;; 0.02a		05/20/88	TGH	-Now loads the files ATALK.PROTOCOLS;; 0.03a		06/07/88	TGH	-Searches the DRIVER directory for any;					 files of type $BB and aux type of $0400;					 and loads them.;; 0.04a		07/05/88	TGH	-Took out statereg access;					-Fixed alphabetizing bug.;; 0.05a		07/11/88	TGH	-Added slot search;; 0.06a		10/12/88	TGH	-Changed the way driver looks for;					 AppleTalk in ROM2 and ROM3.;; 00.05		11/29/88	TGH	-Changed version to match system disk.;					-Fixed bug for ROM01 AppleTalk slot;					 check.;; 2.18A		1/5/89		TGH	-Added Get_Status and Set_Status calls.;					-No longer unloads if AppleTalk off.;; 2.1CB		1/5/89		TGH	-Changed AppleTalk_Client parameters.;					-Now pass ATalk Channel # in A when;					 calling ATalk protocols.;; 2.1DB		3/6/89		TGH	-Added restart capabilities.;					-Added shutdown code to reset the SCC.;; NOTE: I changed the version number to it's final value (2.01).  From now on,;       changes will be refered to by build disk name (e.g. 5.0 d19) and date.;; 5.0 d20	4/24/89		TGH	-Changed version number to 0201 (2.01).;; 5.0 d22	5/1/89		TGH	-I now handle low memory condition;					 while loading ATALK files.;; 5.0 d25	6/1/89		TGH	-Changed the version number to final;;		8/7/89		MSD	-The channel usage tables are word-wide;					 but the routines were accessing them;					 with byte-wide offsets, causing entries;					 to overlap.  Fixed.;; 6.0 d42	1-Jul-91	MSD	AppleTalk driver files are now sorted in a;					case-insensitive way.;; 6.0 d47	3-Sep-91	MSD	Added support for an EtherTalk bit in an;					AppleTalk driver's auxtype.  Code now checks;					Battery RAM location $62 to see whether to;					load LocalTalk or EtherTalk drivers.; 6.0 d70	7-Feb-92	MSD	Changed version to 2.02 final.; 6.0.1d3	6-Apr-92	MSD	Changed version to 2.03 prototype.  Uses two;					new error messages #66 (No AppleTalk hardware);					and #67 (No AppleTalk driver).; 6.0.1d6	18-Jun-92	MSD	Don't display message #67 if we network booted;					(i.e. ProtocolType<>0).;; 6.0.1d12	14-Dec-92	DAL	Make slot number be 8..15 for an external;					Ethernet card.  If we do this wrong, the system;					gets horribly confused on return from ProDOS 8.;; 6.0.1d13	21-Jan-93	DAL	Add a new call GetSlotNumber ($0005) to get the;					0..15 net slot number.  Routine is get_slotnum.;					The AppleShare FST needs this to know whether;					we are using Ethernet or not.;; 6.0.1d14	9-Mar-93	DAL	Check for Ethernet card version at $CnF7, not;					at $CnFE.;; 6.0.1d16	1-Apr-93	DAL	Check for Ethernet ROM version 2.0d25 or higher,;					not any old 2.0 version.  Changed this file's;					version to 2.03 final.;;---------------------------------------------------------------------------------		print	off		include 'all.macros'		print	onVersion		equ	$2030			;Version 2.03ATalk_Dispatch	equ	$E11014AT_PriorityVec	equ	$E1103A			;Address of vector listAT_Port		equ	$E101C0			;AT Port for ROM2 or >AT_Slot		equ	$E101C1			;AT Slot for ROM2 or >warm_cold_flag	equ	$E101CF			;word 0 = cold 1 = warm.sltromsel	equ	$C02D		print	off		include	'equates'		print	on		entry	dispatch,\			startup,\			shutdown,\			dev_startup,\			get_status,\			set_status,\			get_slotnum,\			others		:CODE;---------------------------------------------------------------------------------;; Header	This 'routine' is the header information needed for all;		supervisory drivers.;Header		proc		dc.l	Dispatch	;Entry point		dc.w	0001		;AppleTalk supervisory driver ID #		dc.w	Version		;Version number		dc.l	DriverName	;Pointer to supervisor name		dc.w	$8000		;SIB characteristics.		dc.w	0		;Reserved wordDriverName	dc.b	11		dc.b	'SCC.MANAGER'		dcb.b	21,$20		endp;---------------------------------------------------------------------------------;; Disp_Table	This 'routine' is the dispatch table for all calls made;		to this driver.;disp_table	proc		dc.w	startup		;0 = Startup routine		dc.w	shutdown	;1 = Shutdown routine	;Supervisor specific call below here		dc.w	dev_startup	;2 = Driver unit#/slot request (AppleTalkClient)		dc.w	get_status	;3 = GetChannelStatus		dc.w	set_status	;4 = SetChannelStatus		dc.w	get_slotnum	;5 = GetSlotNumber, 0..15 (21-Jan-93 DAL)		dc.w	others		;Invalid calls		endp;---------------------------------------------------------------------------------;; Dispatch	This is the main entry point for the SCC supervisory driver.;;	Calls		Function;;	$0000		Startup;	$0001		Shutdown;	$0002		Device Startup;	$0003		Get Channel Status;	$0004		Set Channel Status;	$0005		Get Slot Number;	$0006-$FFFF	Unspecified (invalid);dispatch	procmax_command	equ	$0005		phb				;Save the GS/OS bank register		phk				;Setup our bank register		plb		txa				;Transfer call # to Accum		cmp	#max_command+1		;Max call number?		blt	doit			;<, go call it.		lda	#max_command+1		;Otherwise do othersdoit		asl	a		tax		jsr	(disp_table,x)		;opt 21-Jan-93 DAL		plb				;Restore the GS/OS bank register		rtl				;Return to GS/OS		endp;---------------------------------------------------------------------------------;; Startup	This routine is the supervisor's startup routine. It first checks;		to see if AppleTalk is 'turned on'.  If it is, it load all;		AppleTalk driver files in the DRIVER subdirectory.;		entry	Channel1startup		proc		ENTRY	Slot_Num,Next_Unit,RomVersion,ATChannel,LinkTypeWork1		equ	$00			;LongWork2		equ	$04			;LongString1		equ	$08			;LongString2		equ	$0C			;LongMyHandle	equ	$10			;LongZeroHandle	equ	$14			;LongTempChar	equ	$18			;byteSupWork		equ	$60			; available for supervisory drivers		longa	on		longi	on		lda	restart_flag		;Have I already started?		bne	Exit			;Branch if yes.		dec	restart_flag		;Else mark me as started.		jsr	FindSlot		bcs	Exit			;Carry set = No AppleTalk.		ldx	ATChannel		;Mark channel n as 'in-use'		beq	@none		dex				;by AppleTalk.		lda	#0001		sta	Channel1,x@none		stz	error_shown		; no message shown yet		jsr	LoadFiles		;Load all AppleTalk driver files.		bcc	Exit		lda	error_shown		; was a message already displayed?		bne	@shown				pea	0060			;No memory for AppleTalk		PushLong #NullMessage		PushLong #NullMessage		jsl	>$01FC94		;REPORT_ERROR@shown		stz	ATChannel		;Turn AppleTalk off		stz	Slot_NumExit		lda	#$0002			;Initialize our unit counter.		sta	Next_Unit		lda	#no_error		clc		rts				;Return to our dispatcher.error_shown	dc.w	0			; non-zero if LoadFiles already showed an errorrestart_flag	dc.w	0NullMessage	dc.w	0;---------------------------------------------------------------------------------;; Below we find the appletalk slot if any, and whether we're using LocalTalk or; EtherTalk.  We also determine and set ROMVersion.  (This used to happen in FindLTalk; because slot settings are version dependent -- this caused the ROMVersion to be; set to 0 if EtherTalk was selected.  Fixed 3-Jun-92 MSD.);FindSlot		pha			;Space for result		pha			;Space for result		pha			;Space for result		pha			;Space for result		pea	0000		;A on entry		pea	0000		;X on entry		pea	0000		;Y on entry		pea	$FE1F		;Emulation mode entry point		_FWEntry		pla			;Y on exit		plx			;X on exit		plx			;A on exit		plx			;Status byte					;At this point, A (Y on exit) holds the					;ROM version number.		and	#$007F			;Strip off prototype bit (high bit)		sta	ROMVersion		;Store for later use		pha			; result space		pea	$0061		; LocalTalk/EtherTalk setting		_ReadBParam		pla			; get LocalTalk/EtherTalk setting		cmp	#2		; EtherTalk?		beq	@GotLink		lda	#1		; otherwise, must be LocalTalk@GotLink		dea			; change to 0/1		sta	LinkType	; save result for later		beq	FindLTalk	; zero, find out which SCC channel we're using;; Find the EtherTalk card's slot.  Need to find 'ATLK', $01, $xx, $yy at $CnF9 where; $yy >= $20.;FindETalk;;;		lda	#$C7F9		; point to slot 7		lda	#$C7F7		; point to slot 7 (changed 9-Mar-93 DAL)		sta	SupWork		stz	SupWork+2@loop1;;;		ldy	#3		; offset to 'K' $01		ldy	#5		;offset to 'K' $01 (changed 9-Mar-93 DAL)@loop2		lda	[SupWork],y		cmp	IDBytes-2,y	;changed 9-Mar-93 DAL		bne	@next		dey		cpy	#2		;added 9-Mar-93 DAL		bpl	@loop2*** changed 9-Mar-93 DAL;;;		ldy	#5		; offset to version;;;		lda	[SupWork],y		lda	[SupWork]*** end 9-Mar-93		cmp	#$2025		; must be 2.0d25 or later (1-Apr-93 DAL)		bge	@found		; yep, found it@next		dec	SupWork+1	; move down a slot		lda	SupWork		; get slot pointer		cmp	#$C100		; slot 1 or more?		bge	@loop1		; yes, so start scanning slot		bra	NoAppleTalk	; nothing found!@found		stz	ATChannel	; not using an SCC channel		lda	SupWork+1		and	#$000F		; get slot number		jsr	FixSlotNumber	; If needed, add 8 for external slot (14-Dec-92 DAL)		sta	Slot_Num		clc			; no error		rtsIDBytes		dc.b	'ATLK',$01*** added 14-Dec-92 DAL -- If slot A is external, add 8FixSlotNumber	pha		and	#7		tax		lda	>sltromsel	; get slot rom selectionslot_check	ror	a		dex		bpl	slot_check		bcc	int_slot		pla		ora	#$0008		; slots 8-15 are external		rtsint_slot	pla		rts*** end 14-Dec-92		FindLTalk	lda	ROMVersion		; which version?		cmp	#0002			;There really isn't a ROM 2		bcs	ROM3			;but that's OK (its ROM 3).ROM0orROM1	pha				;Space for result		pea	$0027			;Slot 7 setting		_ReadBParam		pla				;Pull the data		bne	NoAppleTalk		lda	#0001		sta	ATChannel		;Assume channel 1		pha				;Space for result		pea	$0021			;Slot 1 setting		_ReadBParam		pla		bne	@L1		inc	ATChannel		;Make it = 2@L1		lda	#0007		bra	DoneROMCheckROM3		lda	>AT_Port		and	#$00FF		beq	NoAppleTalk		sta	ATChannel		lda	>AT_Slot		and	#$00FFDoneROMCheck	sta	Slot_Num		clc		rtsNoAppleTalk		stz	Slot_Num		stz	ATChannel				pea	0066			;No AppleTalk hardware		PushLong #NullMessage		PushLong #NullMessage		jsl	>$01FC94		;REPORT_ERROR		sec		rtsSlot_Num	dc.w	0			;We are in slot n.Next_Unit	dc.w	$0001			;Start with unit #1.RomVersion	dc.w	0			;ROM version (byte).ATChannel	dc.w	0			;SCC channel AppleTalk uses.LinkType	dc.w	0	; 0 = LocalTalk, 1 = EtherTalk;---------------------------------------------------------------------------------;; LoadFiles	This routine will do the following:;;		1) Allocate a 5K chunk of memory.;		2) Get all the AppleTalk protocol driver file;		   names and stick them in the 5K chunk along;		   with pointers to those names.;		3) Sort the names by manipulating the pointers.;		4) Load the files by pointer order.;		5) Deallocate the 5K chunk of memory.;LoadFiles	stz	ProtocolType		lda	>AT_PriorityVec+2	;If the priority chain has anything		bne	SkipLoad		lda	>AT_PriorityVec		cmp	#$006B			;but a $6B000000 in it, then appletalk		beq	LoadProtocols		;has already been loaded and I don't		cmp	#$6B6B			;have to load it now.		beq	LoadOProtocolsSkipLoad	clc		rtsLoadOProtocols	lda	#$0080			;Load only optional protocols		sta	ProtocolTypeLoadProtocols	tdc		sta	ZeroPageHold		stz	FilesFound		;Mark no files found yet.;	Below we get a block of memory to store the file names;	of the files to load and pointers to those names.;	If we have trouble getting the block of memory, we just;	leave with the carry set which means AppleTalk won't be;	available.  This might not be totally true because we might;	not have any RAM based patches, but we can't take the chance.		PushWord #0			;Make sure we have a unique		PushWord #$A100			;ID number.		_GetNewID		PullWord MyID		bcc	@GotID		rts				; return with carry set;; Here, we're allocating one page in bank 0 for use as a direct page.;@GotID		PushLong #0		PushLong #$0100			;.25K		PushWord MyID		PushWord #$C015			;Attributes		PushLong #0			;Must be in bank 0		_NewHandle			;Ask for a one page chunk.		bcc	@GotHandle		pla				;Fix the stack		pla		rts				; return with carry set@GotHandle	tsc				;Set the zero page to our stack and		tcd				;dereference the handle and transfer		lda	[1]			;the result to the direct register.		tcd		PullLong ZeroHandle		;Save the handle for deleting.		PushLong #0		PushLong #$1400			;5K		PushWord MyID		PushWord #$0100			;Attributes		PushLong #0			;I don't care where it starts		_NewHandle			;Ask for a 5K chunk.		PullLong MyHandle		bcc	@GotHandle1		jmp	PurgeZP@GotHandle1	PushLong MyHandle		;Now lock it down so we can de-		_HLock				;reference it without it moving.		ldy	#0002		lda	[MyHandle]		;Dereference 5K chunk,		sta	Work1			;Store it on zero page		sta	PrefixBuffer		clc		adc	#0002		sta	OpenBuffer		lda	[MyHandle],y		;Don't forget the high word.		sta	Work1+2		sta	PrefixBuffer+2		adc	#0000		sta	OpenBuffer+2;	Now we try to open the */SYSTEM/DRIVERS/ subdirectory		lda	#$1400-2		;Initialize Get_Prefix's		sta	[Work1]			;G-String.		jsl	>$E100A8		dc.w	$200A			;Class 1 Get_Prefix		dc.l	GetPrefix		bcc	@GotPrefix		jmp	PurgeMemory		;Leave with carry set!@GotPrefix	jsl	>$E100A8		dc.w	$2010			;Class 1 Open		dc.l	OpenDir		bcc	@GoodOpen		;Branch if no error		jmp	PurgeMemory		;Leave with carry set!@GoodOpen	lda	OpenDir+2		;Move the reference number into		sta	EntryList+2		;get_dir_entry and close call		sta	CloseDir+2		;blocks.		clc		lda	Work1		adc	#0136		sta	[Work1]		sta	Work2		lda	Work1+2		adc	#0000		sta	[Work1],y		sta	Work2+2; Below we loop until we have looked at ALL the files in the driver; directory on the boot disk.  If there is any kind of an error on the; the directory, we stop searching.LoadLoop	lda	Work2			;Move the next entry pointer into		sta	EntryPtr		;the GetNextEntry call block.		lda	Work2+2		sta	EntryPtr+2		lda	#0032			;Initialize the G-String to 32.		sta	[Work2]		jsl	>$E100A8		dc.w	$201C			;Class 1 GetDirEntry		dc.l	EntryList		bcs	DoneSearch		;If there was an error, stop looking.; Now see if we should load this particular file with our given machine configuration.; First we test the filetype (must be $BB = driver).  Second we test the auxtype (must; be $02xx = AppleTalk driver).  Third we test the "optional protocol" bit (set for; non-Apple drivers); if it is clear (i.e. an Apple-supplied required driver) and we've; already loaded all the required drivers, then the file won't get loaded.  Fourth, if; the "optional" bit was clear, test the EtherTalk bit against the selected link.; Fifth (and last), compare the maximum ROM version.; First, test file type		lda	EntryType		;Load the file type.		cmp	#$00BB			;Is it a driver file?		bne	LoadLoop		;Branch if not, keep looking.; Second, auxtype = $02xx		lda	EntryAUX		;Load the aux type.		and	#$FF00			;Only look at the high byte		cmp	#$0200			;Is it an AppleTalk driver file?		bne	LoadLoop		;Branch if not, keep looking.; Third, test "optional" bit and required drivers already loaded		lda	ProtocolType		;Load the aux type again!		beq	@L1			;Branch if load all protocols.		bit	EntryAux		;Otherwise check protocol type.		beq	LoadLoop		;Branch if not to load.@L1; Fourth, test "optional" bit and link type		lda	EntryAUX		bit	#$0080			; is "optional" bit set?		bne	@L2			; yes, so don't check link type		and	#$0010			; get LocalTalk/EtherTalk bit		lsr	a			; shift down to 0/1		lsr	a		lsr	a		lsr	a		cmp	LinkType		; same as our link type?		bne	LoadLoop		; no, so don't load it@L2; Fifth, check ROM version		lda	EntryAUX		and	#$000F			;Only look at the low byte		cmp	ROMVersion		;Only load the file if it's ROM ID		bcc	LoadLoop		;byte is <= the current ROM version.		lda	Work1		clc		adc	#0004		sta	Work1		lda	Work1+2		adc	#0000		sta	Work1+2		ldy	#0002		lda	Work2			;Ok, we got a valid file, keep		clc				;it in the list by bumping our		adc	#0034			;index by 1 field.		sta	Work2		sta	[Work1]		lda	Work2+2		adc	#0000		sta	Work2+2		sta	[Work1],y		inc	FilesFound		;Bump our file counter.		lda	FilesFound		;Make sure we don't load more		cmp	#0100			;than 100 files.		bge	DoneSearch		brl	LoadLoop;	We've found all the files we can, now close the directoryDoneSearch	jsl	>$E100A8		dc.w	$2014			;Class 1 Close		dc.l	CloseDir;	If we haven't found any files, then we just release our;	memory segment and leave.		lda	FilesFound		;Did we find any files?		beq	@L1			;If there are no files, just leave.		cmp	#0002			;Is there more than 1 file?		bge	SortThem				jmp	LoadThem		;If there is only 1 files, just load it.@L1; Begin 18-Jun-92 MSD		lda	ProtocolType		; if non-zero, then already loaded basic driver		beq	@L2			; no drivers loaded yet, so display message		brl	FixVector		; skip over sorting/loading protocols@L2; End 18-Jun-92 MSD		pea	0067			;No AppleTalk driver		PushLong #NullMessage		PushLong #NullMessage		jsl	>$01FC94		;REPORT_ERROR		dec	error_shown		; don't display memory error message				sec				;should have loaded a driver!		jmp	PurgeMemory		;There are no files, just leave.;	Here we sort the files using a bubble sort to put them in;	alphabetical order (A...z where 'A' == 'a').  1-Jun-91 MSDSortThem	lda	#0001		sta	LoadTemp		;What file are we looking at.		ldy	#0002		lda	[MyHandle]		;Dereference 5K chunk,		sta	Work1			;Store it on zero page		lda	[MyHandle],y		;Don't forget the high word.		sta	Work1+2Search1Loop	lda	LoadTemp		;Load the main index		tax		clc		ldy	#0002		lda	[Work1]		adc	#0002		sta	String1			;Dereference the pointer and store it		lda	[Work1],y		sta	String1+2		lda	Work1		sta	Work2		lda	Work1+2		sta	Work2+2Search2Loop	lda	Work2		clc		adc	#0004		sta	Work2		lda	Work2+2		adc	#0000		sta	Work2+2		clc		ldy	#0002		lda	[Work2]		adc	#0002		sta	String2			;Dereference the pointer and store it		lda	[Work2],y		sta	String2+2		sep	#$20		longa	off		ldy	#0001ScanLoop	iny;; 1-Jul-91 MSD:	Changed the comparison to be case-insensitive.;		Note that String2 must be converted first so the;		order of the compare isn't changed (String1 - String2).;;		lda	[String1],y;		cmp	[String2],y		lda	[String2],y		cmp	#'a'		blt	@upper2		cmp	#'z'+1		bge	@upper2		and	#$5F		; convert to upper case@upper2		sta	TempChar	; save for comparison				lda	[String1],y		cmp	#'a'		blt	@upper1		cmp	#'z'+1		bge	@upper1		and	#$5F@upper1		cmp	TempChar;; End of 1-Jul-91 MSD change.;		beq	Cont1Loop		blt	NoChange		bge	SwapThemCont1Loop	tya		cmp	[String1]		beq	Cont2Loop		bge	NoChangeCont2Loop	cmp	[String2]		beq	ScanLoop		blt	ScanLoopSwapThem	rep	#$20		longa	on		ldy	#$0002SwapLoop	lda	[Work1],y		pha		lda	[Work2],y		sta	[Work1],y		pla		sta	[Work2],y		dey		dey		bpl	SwapLoopNoChange	rep	#$20		longa	on		inx		cpx	FilesFound		blt	Search2Loop		lda	Work1		clc		adc	#0004		sta	Work1		lda	Work1+2		adc	#0000		sta	Work1+2		inc	LoadTemp		lda	LoadTemp		cmp	FilesFound		bge	LoadThem		jmp	Search1Loop;	Now that they're in order, we load them in that orderLoadThem	ldy	#0002		lda	[MyHandle]		sta	Work1			;Dereference the pointer and store it		lda	[MyHandle],y		sta	Work1+2		ldx	#0000			;Start with index 0.LoadThemLoop	phx				;Save our file counter.		PushWord #0		PushWord #0		PushLong #0		PushWord #0		PushWord MyID		ldy	#0002		lda	[Work1]		clc		adc	#0002		tax		lda	[Work1],y		adc	#0000		pha		phx		PushWord #$0001		PushWord #$0001		_InitialLoad2		PullWord		PullLong patchit		PullWord		PullWord		bcc	@InitFile		plx				;Fix the stack		sec		bra	PurgeMemory@InitFile	lda	ATChannel		;Load the ATChannel in A		ldx	RomVersion		;Load the ROM version in X		ldy	Slot_Num		;Load the ATalk slot # in Y		jsl	doit			;JSL to the begining of it.		lda	Work1			;Bump our file name pointer by		clc				;one field.		adc	#0004		sta	Work1		lda	Work1+2		adc	#0000		sta	Work1+2		plx				;Restore our file counter.		inx				;Increment the puppy.		cpx	FilesFound		;Our we done yet?		blt	LoadThemLoop		;Branch for some more if not.FixVector;	We have to stuff a dummy vector into the priority chain so that we;	won't load the protocols again later.  We do this because we can't;	garauntee that something will install itself into the chain.		lda	>AT_PriorityVec		;Get the old vector and stuff		sta	NextJmp			;it into our structure.		lda	>AT_PriorityVec+2		sta	NextJmp+2		lda	Ourjml			;Stuff our jump long into the		sta	>At_PriorityVec		;priority chain vector.		lda	Ourjml+2		sta	>AT_PriorityVec+2;	We have to get rid of our memory segments before we leave.		clc				;Clear the carry flag (no error).PurgeMemory	php				;Save carry flag		PushLong MyHandle		;Get rid of our chunk of memory.		_DisposeHandle			;These calls don't care about						;being locked or not.		plp				;Restore carry flagPurgeZP		php				;Save carry flag		PushLong ZeroHandle		lda	ZeroPageHold		tcd				;Restore the direct page register.		_DisposeHandle			;Get rid of our zero page.		plp				;Restore carry flag		rts				;Th, th, that's all folks!PEntry		bra	NextJmpNextJmp		DS.B	4		DC.W	$7FFF			;medium priorityOurjml		jml	PEntry			;Code that jumps to above structuredoit		dc.b	$5Cpatchit		ds.l	1ProtocolType	ds.w	1ZeroPageHold	ds.w	1MyID		ds.w	1LoadTemp	ds.w	1GetPrefix	dc.w	$0002			;Parameter count		dc.w	$0000			;Prefix numberPrefixBuffer	dc.l	0			;Buffer pointerOpenDir		dc.w	$0002			;Parameter count		dc.w	0			;Reference numberOpenBuffer	dc.l	0EntryList	dc.w	$000D			;Parameter count		dc.w	0			;Reference number		dc.w	0			;Flags		dc.w	1			;Base		dc.w	1			;DisplacementEntryPtr	dc.l	0			;Name pointer		dc.w	0			;Entry numberEntryType	dc.w	0			;File type		dc.l	0			;EOF		dc.l	0			;Block count		dc.l	0,0			;Create date and time		dc.l	0,0			;Mod date and time		dc.w	0			;AccessEntryAUX	dc.l	0			;AUX timeCloseDir	dc.w	$0001			;Parameter count		dc.w	0			;Reference numberFilesFound	dc.w	0		endp;---------------------------------------------------------------------------------;; ShutDown	This routine will release any resource gained during startup.;		It will also turn off the SCC if this is a SHUTDOWN as opposed;		to a OSSWITCH type shutdown call.  This will fix the problem that;		an AppleTalk interupt would come in and jump to the old vectors;		which are no longer valid because of a re-boot.shutdown	proc		longa	on		longi	on		lda	#$0000			;No error.		clc		rts;		lda	warm_cold_flag	;0 = cold, 1 = warm;		bne	@L1;;		php			;We better disable interupts;		sei			;while we reset the SCC.;;		sep	#$30		;Short all!;		longa	off;		longi	off;;		lda	#$00;		sta	>$00C047	;Clear any 1/4 sec interupt.;		lda	>$00C041;		and	#$EF		;Disable 1/4 sec interupt source.;		sta	>$00C041;		lda	#$09		;Disable SCC;		sta	>$00C039;		lda	#$C0;		sta	>$00C039;		lda	#$0B		;Enable oscillator;		sta	>$00C039;		lda	#$D2;		sta	>$00C039;;		plp			;Re-enable interupts and mode.;;		longa	on;		longi	on;;@L1		lda	#0000;		clc;		rts		endp;---------------------------------------------------------------------------------;;			BELOW ARE THE DRIVER SPECIFIC CALLS!;;---------------------------------------------------------------------------------;; Dev_Startup	This routine routine returns the slot number and unit number;		to be used by the calling AppleTalk driver.;;		 Return Parameter Block;;		 _______________________;		|			|;		|	Slot #		|;		|	(Word)		|;		|_______________________|;		|			|;		|	Channel #	|;		|	(Word)		|;		|_______________________|;		|			|;		|	Unit #		|;		|	(Word)		|;		|_______________________|;dev_startup	proc		longa	on		longi	on		lda	ATChannel		ora	Slot_Num		beq	bad_exit		ldy	#0000			;Index to slot value.		lda	Slot_Num		;Load the slot # to use.		sta	[sup_parm_ptr],y	;Store it in calling drivers		iny				;call block.		iny		lda	ATChannel		;Load the ATChannel #		sta	[sup_parm_ptr],y		iny		iny		lda	Next_Unit		;Store a unique UnitNumber in		beq	bad_exit		;(Branch if we wrapped.)		sta	[sup_parm_ptr],y	;the calling drivers call block.		inc	Next_Unit		;Bump our unit number.		lda	#$0000		clc		rtsbad_exit	lda	#$0088			;Too many units! (more than 64		sec				;thousand  needless to say, this		rts				;should never happen) or ATALK						;not turned on.		endp;---------------------------------------------------------------------------------;; Get_Status	This routine returns the current status of the SCC channels.;get_status	proc		entry	Channel1,Channel2,\			Channel1Count,Channel2Count		longa	on		longi	on		ldy	#0000		lda	Channel1		;Load channel 1 status.		sta	[sup_parm_ptr],y	;Store it in calling drivers		iny				;call block.		iny		lda	Channel2		;Load channel 2 status		sta	[sup_parm_ptr],y	;Store it.		lda	#$0000		clc		rtsChannel1	dc.w	0Channel2	dc.w	0Channel1Count	dc.w	0Channel2Count	dc.w	0		endp;---------------------------------------------------------------------------------;; Set_Status	The routine sets the status of the specified SCC channel.;;		    Parameter Block;;		 _______________________;		|			|;		|	Channel #	|;		|	(Word)		|;		|_______________________|;		|			|;		|	Status		|;		|	(Word)		|;		|_______________________|;;; The Channel # can be the following values:;;	1 = Channel 1;	2 = Channel 2;; The Status can be the following values:;;	0 = Channel to be freed;	1 = Channel used;	2 = Channel used but can be shared;set_status	proc		longa	on		longi	on		ldy	#0000		lda	[sup_parm_ptr],y	;Load the channel to set.		beq	@L1			;If <0 or >2 then error.		cmp	#0003		bcc	GoodChannel@L1		lda	#drvr_bad_parm		sec		rtsGoodChannel; Note: X should be index to channel status table (table of words),; so it needs to be 2*(channel-1) instead of channel-1.		dea				; indexes start at 0, not 1		asl	a			; double for word-wide index		tax				; use X to index channel table.		ldy	#0002		lda	[sup_parm_ptr],y	;Load the control value		tay				;and save it in Y.		lda	Channel1,x		;Status of the req. channel.		beq	SaveState		cmp	#0002			;Is it dedicated?		beq	ShareIt		tya		beq	ZeroIt			;Only a zero is valid						;(giving up resource).NotAvailable	lda	#drvr_no_resrc		sec		rtsZeroIt		stz	Channel1,x		;Channel available.		stz	Channel1Count,x		;No clients.		bra	GoodExitShareIt		tya		beq	DecIt		cmp	#0001		beq	NotAvailable		bra	SaveStateDecIt		dec	Channel1Count,x		bne	GoodExit		bra	ZeroItSaveState	tya		beq	GoodExit		sta	Channel1,x		inc	Channel1Count,xGoodExit	lda	#$0000			;No error.		clc		rts		endp;---------------------------------------------------------------------------------;; get_slotnum	Return the 0..15 slot number for the network.  For Ethernet;		this will be 9..15.;; New routine 21-Jan-93 DAL;get_slotnum	proc		longa	on		longi	on		lda	Slot_Num		sta	[<sup_parm_ptr]		lda	#0		clc		rts		EndP;---------------------------------------------------------------------------------;; Others	This routine routine does absolutely nothing and is called only;		if a driver calls us with an invalid call number.;others		proc		longa	on		longi	on		lda	#$0020			;Just return with a 'bad request'		clc				;error.		rts		endp;---------------------------------------------------------------------------------		END