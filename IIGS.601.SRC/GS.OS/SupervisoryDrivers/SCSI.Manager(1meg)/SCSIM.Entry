;*******************************************************;;	'SCSIM.ENTRY';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains code to handle all Calls to the;	SCSI Manager and serves as the main ENTRY point for;	all calls..;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		smbusy_flag					IMPORT		sdriver_no_hold					IMPORT		sm_call_no					IMPORT		max_cmd					IMPORT		our_zpg_hold					IMPORT		bind_scsi_irq					IMPORT		tout_header					IMPORT		arbtout_header					IMPORT		scsim_chars					IMPORT		get_zpage					IMPORT		zpg_savebuff					IMPORT		zpg_hold					IMPORT		our_zpg_hold					IMPORT		snooper_ptr					IMPORT		error_stat					IMPORT		gsos_zpg_hold					IMPORT		allocate_memory					IMPORT		handle_hold					IMPORT		clear_memory					IMPORT		cmd_table					IMPORT		scsi_status					IMPORT		scsi_message;					ENTRY							PRINT		OFF					INCLUDE		'SCSIM.Equates'					INCLUDE		'Common.Equ.Src'					INCLUDE		'HW.Equ.Src';					INCLUDE		'M16.MEMORY'					INCLUDE		'M16.UTIL'					INCLUDE		'M16.MISCTOOL'					PRINT		ON					EJECT;*******************************************************;;	'scsi_man_exec';;	This module controls the command execution of the;	SCSI Manager.  All commands flow through this;	routine.  It validates the command to make sure it;	is within range, to the specific call.;;	NOTE:;		This code assumes that Supervisor startup call;		is the first call made to the SCSI Manager and;		can occur only once during any system startup;		session.;;	Inputs:		e,m,x		=	0 (full native);				Acc			=	Supervisors driver number;				X reg		=	SCSI Manager command number;				Y reg		=	Supervisor ID;				dpage		=	GS/OS Direct page;				Stack		=	GS/OS stack space;				Speed		=	fast;;	Output:		e,m,x		=	0 (full native);				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	Error code or supervisor;								driver number;				dpage		=	GS/OS direct page;				B			=	ENTRY;				X reg		=	undefined;				Y reg		=	undefined;		;*******************************************************					EXPORT	scsi_man_execscsi_man_exec		PROC											;											; point to our code bank &											; check if scsi manager											; already busy											;					sta		$FF0400			;for debug purposes					phb						;save data bank register					phd						;save direct register					phk						;point to our code segment					plb						;data bank reg saved by Sup. Disp.					bit		|smbusy_flag					bpl		@75					lda		#sm_busy_err	;mark scsi manager busy error					brl		execend			;and go away											;											; SCSI Manager not busy go											; issue the call											;@75					jsl		incbusyflag		;increment busy flag to prevent CDA access					sta		|sdriver_no_hold;save supervisor driver number					stx		|sm_call_no		;save the call number					cpx		#max_cmd		;check if command in range					bcc		rangok											;											; command out of range report											; the error											;					lda		#scsicmd_err	;command out of range					brl		execendrangok				cpx		#startup		;check for startup					beq		warmchk											;											; non startup call enters here											;					lda		|our_zpg_hold	;point to our zero page					tcd					brl		clrerr											;											; Check for a warmstart.  If											; warmstart install allocate a											; zero page and restore the zero											; page data back into to it.											; Also, no matter if warmstart											; or cold start install interrupt											; handler and heartbeat task											; handler.											;warmchk				jsr		bind_scsi_irq	;install our irq handler					bcc		@100			;go away if error					brl		rsrcerr											;											; startup the VBL interrupts											; source											;@100				pea		$0002			;vertical irq reference number					_IntSource											;											; Install timeout handler											; heartbeat task											;					PUSHLONG	#tout_header					_SetHeartBeat					bcc		@105					brl		rsrcerr											;											; Install arbitration timeout											; heartbeat task											; @105				PUSHLONG	#arbtout_header					_SetHeartBeat					bcc		@110					brl		rsrcerr@110				bit		|scsim_chars	;check bit 15 for restartable					bpl		coldst			;coldstart if not restartable					lda		>warm_cold_flag					and		#$0001					beq		coldst			;Z=1 marks a coldstart go do it											;											; allocate zero page area											;warmst				jsr		|get_zpage					bcs		rsrcerr			;go away if error											;											; Restore Saved Values.											;					PUSHLONG	#zpg_savebuff	;source address					PUSHWORD	#NULL			;destination address High					PUSHWORD	|zpg_hold		;destination address Low 					PUSHLONG	#maxzpg_space 					PUSHWORD	#move_sinc_dinc					jsl		move_info					lda		|zpg_hold		;set our direct register					clc						;point to the 2nd zero page					adc		#driverzpgsize					sta		|our_zpg_hold	;Save to eliminate future calcs.					stz		|snooper_ptr+2	;clear high word of the snooper cda pointer					sta		|snooper_ptr	;save the address of the zero page					tcd						;point to our zero page					stz		|error_stat		;clear the error status field					bra		warmend			;go away											;											; Coldstart											;coldst				tdc						;save GS/OS zero page address (will need later)					sta		|gsos_zpg_hold						jsr		allocate_memory	;get our work memory					bcc		memok											;											; failed to allocate working											; resources											;rsrcerr				lda		#sm_rsrc_err	;scsi manager could not allocate memory					bra		execend			;go away											;											; dereference our handle											;memok				lda		|handle_hold	;setup handle pointer					sta		scratchzpg					lda		|handle_hold+2					sta		scratchzpg+2											;											; form I/O table address											;					lda		[scratchzpg]	;form memory pointer					sta		<io_table_ptr					tax						;low word of pointer					ldy		#$0002					lda		[scratchzpg],y					sta		<io_table_ptr+2					tay						;high word of pointer					txa						;form address of SDR table					clc											;											; Form SDR table address											;					adc		#iotsize					sta		<sdr_table_ptr					sty		<sdr_table_ptr+2					sta		<next_sdr		;link to first sdr					sty		<next_sdr+2					lda		#default_sdrs	;number of default SDRs					sta		<avail_sdrs											;											; clear newly acquired memory											;					lda		#min_mem_size	;number of bytes to clear					jsr		clear_memory	;go clear themclrerr				stz		|error_stat		;clear error status					lda		|sm_call_no		;get the call number back					asl		a				;two byte pointers					tax					jsr		(cmd_table,x)	;go to it!											;											; all calls return here except											; SHUTDOWN											;											; clear scsi call status and											; message working variables											;warmend				stz		|scsi_status					stz		|scsi_message					jsl		decbusyflag		;adjust the busy flag (CDAs can come in)					lda		|error_stat		;check for non zero status					stz		|error_stat		;clear the error status fieldexecend				sta		$FF0402			;**** Debug					pld						;restore GS/OS direct page					plb						;restore data bank register					cmp		#$0001			;set carry on errors					rtl					ENDP					EJECT					END