;*******************************************************;;	'SCSIM.Claim.Devs';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains code to handle the Claim Devices;	Call.;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		error_stat					IMPORT		get_plist					IMPORT		find_sdr;					ENTRY							PRINT		OFF					INCLUDE		'SCSIM.Equates';					INCLUDE		'Common.Equ.Src';					INCLUDE		'HW.Equ.Src';					INCLUDE		'M16.MEMORY';					INCLUDE		'M16.UTIL';					INCLUDE		'M16.MISCTOOL'					PRINT		ON					EJECT;*******************************************************;;	'scsim_claimdevs';;	This module will mark specific SDR records as;	claimed the the driver who made the immmediatelly;	previous Req_Devices  call from the same driver.;;	Called via 'JSR';;	Inputs:		e,m,x		=	0 (full native);;	Outputs:	e,m,x		=	0 (full native);				Acc			=	0;				Carry		=	0;				Y reg		=	Unspecified;				X reg		=	Unspecified;				P reg		=	0=M=X=e;				D Page		=	GS/OS Direct Page;				Bank		=	Ours;;	Errors:		See Spec.;;*******************************************************					EXPORT	scsim_claimdevsscsim_claimdevs		PROC											;											; get parameter list pointer											; & point to buffer											;					stz		|error_stat		;reset error status					jsr		get_plist		;point to the parameter list					stx		<plist_ptr		;form pointer to parameter list					sty		<plist_ptr+2					ldy		#destbuffptr	;get destination buffer address					lda		[plist_ptr],y					sta		<buffer_ptr					ldy		#destbuffptr+2					lda		[plist_ptr],y					sta		<buffer_ptr+2					ldy		#total_devcount	;total number of devices in the list					lda		[buffer_ptr],y					sta		<scratchzpg					bra		get_id											;											; find SDR matching this ID											;next_id				dec		<scratchzpg		;decrement the total device count in the list					bne		@100			;check next ID if count not zero					clc						;otherwise mark success & quit					rts@100				lda		<buffer_ptr		;bump to the next id in the list					adc		#reqENTRY_size	;size of each device ENTRY in list					sta		<buffer_ptr					bcc		get_id					inc		<buffer_ptr+2get_id				ldy		#device_id		;point to the ID field in claim parameter list					lda		[buffer_ptr],y	;get the slot number					bpl		next_id			;Doesn't want it.  Do next one in list.					and		#$7fff					sta		<dev_id			;save the id sought					ldy		#device_slot	;point to the slot field in claim parameter list					lda		[buffer_ptr],y	;get the ID					sta		<slot_no					jsr		find_sdr		;get the SDR address (C=1 then invalid ID)						bcs		exit			;if error then go away											;											; mark device claimed if not											; claimed previously											;					sty		<sdr_ptr		;save the SDR address					sta		<sdr_ptr+2					ldy		#device_id		;set high bit to mark claimed					lda		[sdr_ptr],y		;device claimed marker (bit 15 of device id)					bmi		@error			;if already set then an error					ora		#claimed		;Set the bit					sta		[sdr_ptr],y					bra		next_id@error				lda		#bad_scsi_id					sta		|error_stat		;mark ID errorexit				rts						;>>>--- scsim_claimdevs --->>>					ENDP						EJECT					END