;*******************************************************;;	'SCSIM.Startup';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains code to handle the Startup Call.;	It will allocate all the resources needed by the;	SCSI Manager to become operational.  It determines;	how many scsi devices are online and build all the;	routing data structures to gain access to those;	devices.;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		find_scsi					IMPORT		init_sdr_tbl					IMPORT		tout_header					IMPORT		user_id					IMPORT		error_stat					IMPORT		schedule_unbind;					ENTRY							PRINT		OFF					INCLUDE		'SCSIM.Equates';					INCLUDE		'Common.Equ.Src';					INCLUDE		'HW.Equ.Src'					INCLUDE		'M16.MEMORY'					INCLUDE		'M16.UTIL'					INCLUDE		'M16.MISCTOOL'					PRINT		ON					EJECT;*******************************************************;;	'scsim_startup';;	Main Entry point to the 'Startup' routine.  This is;	called after the Manager is loaded.  The code that;	follows sets up the Manager's environment, then;	calls Memory Manager to allocate space for the SDRs.;;	From this point, we need to build the SDR for each;	device. ;;	Called via 'JSR';;	Inputs:		e,m,x		=	0 (full native);;	Outputs:	e,m,x		=	0 (full native);				Acc			=	0;				Carry		=	0;				Y reg		=	Unspecified;				X reg		=	Unspecified;				P			=	0=M=X=e;				D Page		=	GS/OS Direct Page;				Bank		=	Ours;;	Errors:		See Spec.;;*******************************************************;					EXPORT	scsim_startupscsim_startup		PROC											;											; go look for SCSI Peripheral											; cards/ports											;					jsr		find_scsi		;go look for scsi cards/ports					bcs		@85				;none found report error (we get purged)											;											; initiaize SCSI Device Record											; (SDR) table											;					jsr		init_sdr_tbl	;initialize scsi device records					bcs		@85				;none found report error (we get purged)					rts											;											; Delete timeout heartbeat task											; if errors											;@85					PUSHLONG	#tout_header					_DelHeartBeat					bcs		@250			;someone destroyed our heartbeat											;											; Unbind our IRQ via the SCHEDULER											;					jsr		schedule_unbind											;											; dispose our memory											;					PUSHWORD	|user_id	;dispose of zero page and work areas					_disposeall					bcs		@250			;dispose of memory allocated to us											;											; dispose our ID back to Misc.											; Tools											;					PUSHWORD	|user_id	;dispose our ID					_DeleteID					bcc		sfail@250				jsl		gsos_sys_death	;bad news could not dispose our memorysfail				lda		#scsi_start_err	;mark error					sta		|error_stat					secexit				rts						;>>>--- scsi_man_startup --->>>					ENDP						EJECT					END