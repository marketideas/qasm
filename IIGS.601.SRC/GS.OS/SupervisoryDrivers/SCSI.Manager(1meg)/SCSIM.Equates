;*******************************************************;;	SCSI Manager 'Equates' file.;;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************;*******************************************************;;	Revision History:;;*******************************************************;	June		1,		1989		Rev. 5.1 Started.;	July		10,		1989		Merged Equates from;									the GS/OS 5.0 Final;									Disk.;*******************************************************;;	'SCSIM.Equates';;	This file contains all the global equates for the;	SCSI Manager.  Only those items below that are;	marked as "**** Changable ****" can be altered;	safely without detailed intimate knowledge of how;	the generic driver functions.  Any other values;	should only be modified by someone who understands;	how this generic driver functions.;;	Copyright Apple Computer, Inc. 1988-1989;	All rights reserved.;;*******************************************************											;											; Bit Location equates											;null				equ		%0000000000000000bit_0				equ		%0000000000000001bit_1				equ		%0000000000000010bit_2				equ		%0000000000000100bit_3				equ		%0000000000001000bit_4				equ		%0000000000010000bit_5				equ		%0000000000100000bit_6				equ		%0000000001000000bit_7				equ		%0000000010000000bit_8				equ		%0000000100000000bit_9				equ		%0000001000000000bit_10				equ		%0000010000000000bit_11				equ		%0000100000000000bit_12				equ		%0001000000000000bit_13				equ		%0010000000000000bit_14				equ		%0100000000000000bit_15				equ		%1000000000000000true				equ		$0001false				equ		$0000;****************** DEBUG CONDITIONAL assembly switch ****************************;debug				equ		falseDisc_ReSel			equ		false;;*******************************************************;;	SCSI Manager hardware equates;;*******************************************************;io_space			equ		$00C000					;base address for I/O space;*******************************************************													;													; SCSI ports I/O space (READ)													;currdata			equ		$0000					;current scsi data;*******************************************************													;													; 5380 command register													;initcmdreg			equ		$0001					;initiator command registerdatabuson			equ		bit_0					;assert scsi data busattention			equ		bit_1					;assert SCSI ATN*select				equ		bit_2					;assert SCSI SEL*busy				equ		bit_3					;assert SCSI BSY*asrtack				equ		bit_4					;assert SCSI ACK*arbitlost			equ		bit_5					;lost arbitration statusdifferenab			equ		bit_5					;enable differential (NCR 5381 only!)arbinprog			equ		bit_6					;arbitration in progresstestmode			equ		bit_6					;enable test modeassertrst			equ		bit_7					;assert RST*;*******************************************************													;													; 5380 mode register													;	modereg				equ		$0002					;5380 Mode registerarbitrate			equ		bit_0					;start arbitration phasedmaenable			equ		bit_1					;enable DMA modemonitorbsy			equ		bit_2					;monitor BSY*eopirqenb			equ		bit_3					;enable EOP* interruptparirqenb			equ		bit_4					;enable parity interruptparchkenb			equ		bit_5					;enable parity checkingtargetenb			equ		bit_6					;set target modeblkdmaenb			equ		bit_7					;enable Block Mode DMA;*******************************************************													;													; 5380 Target command register													;targcmdreg			equ		$0003					;5380 target command registerassertio			equ		bit_0					;assert I/O*assertcd			equ		bit_1					;assert C/D*assertmsg			equ		bit_2					;assert MSG*assertreq			equ		bit_3					;assert REQ*lastbyte			equ		bit_7					;last byte sent (53C80 only!);*******************************************************													;													; Current SCSI bus status register													;curbusstat			equ		$0004					;5380 current bus status Reg (READ Only)dbp					equ		bit_0					;scsi bus paritysel					equ		bit_1					;scsi bus SEL*io					equ		bit_2					;scsi bus I/O*cd					equ		bit_3					;scsi bus C/D*msg					equ		bit_4					;scsi bus MSG*req					equ		bit_5					;scsi bus REQ*bsy					equ		bit_6					;scsi bus BSY*rst					equ		bit_7					;scsi bus reset													;													; SCSI Bus phases bit patterns													;data_out_phase		equ		$0000					;$0000data_in_phase		equ		io/4					;$0001cmd_phase			equ		cd/4					;$0002stat_phase			equ		(io+cd)/4				;$0003invalid_phase1		equ		msg/4					;$0004invalid_phase2		equ		(io+msg)/4				;$0005msg_out_phase		equ		(cd+msg)/4				;$0006msg_in_phase		equ		(io+cd+msg)/4			;$0007;*******************************************************sel_enabl_reg		equ		$0004					;5380 Select Enable Reg (WRITE Only);*******************************************************													;													; Bus & Status Reg (READ Only)													;busstat				equ		$0005					;bus & status registerack					equ		bit_0					;scsi bus ACK*atn					equ		bit_1					;scsi bus ATN*busyerr				equ		bit_2					;busy error statusphasematch			equ		bit_3					;scsi bus phase match statusscsiirq				equ		bit_4					;5380 irq pending flagparityerr			equ		bit_5					;scsi data parity errordrq					equ		bit_6					;DMA request asserted (DRQ)end_dma				equ		bit_7					;end of dma transfer status;;*******************************************************start_dma_send		equ		$0005					;5380 Start DMA Send (WRITE Only);*******************************************************indatareg			equ		$0006					;scsi data input Reg (READ Only);*******************************************************start_dma_trecv		equ		$0006					;5380 Start DMA Target Receive													;(WRITE Only);*******************************************************resetpreg			equ		$0007					;scsi reset parity Reg (READ Only)resetirqreg			equ		$0007					;clear 5380 pending irq (READ Only);*******************************************************start_dma_irecv		equ		$0007					;5380 Start DMA Initiator Receive													;(WRITE Only);*******************************************************													;													; SCSI ports I/O space (Write)													;outdatareg			equ		$0000					;output data registerselectereg			equ		$0004					;scsi device id during select phasedmasndreg			equ		$0005					;start DMA send registertdmarecv			equ		$0006					;start DMA receive targetidmarecv			equ		$0007					;start DMA receive initiator;;;*******************************************************;;          SCSI DMA controller registers (Cocoon);;*******************************************************;dmaaddrl			equ		$0008					;low byte of source/dest dma addressdmaaddrh			equ		$0009					;high byte of source/dest dma addressdmacntl				equ		$000A					;low byte of dma byte countdmacnth				equ		$000B					;high byte of dma byte count													;													; DMA controller control bit definitions													;dmactl				equ		$000C					;dma chip control registerpseudo_dma			equ		bit_0					;Pseudo Dma enable			( READ/WRITE )real_dma			equ		bit_1					;Real Dma enable			( READ/WRITE )addr_roll			equ		bit_2					;Address Rollover			( READ )dis_stop_dma		equ		bit_3					;DMA ignores IRQs			( READ/WRITE )watch_dog			equ		bit_4					;DMA Watch Dog Timer		( READ )irq_enable			equ		bit_5					;5380 INT Enable			( READ/WRITE )dma_enabled			equ		bit_6					;DMA Enabled bit			( READ )dma_stopped			equ		bit_7					;DMA stop by irq status		( READ )fixit_reg			equ		$000D					;Cocoon Fixit Register ( WRITE )kick_dma			equ		bit_0					;Restart DMA after rollover or IRQreset_5380			equ		bit_1					;Reset the 5380clear_test			equ		bit_6					;Clear Test Modeset_test			equ		bit_7					;Set Test Modepriority			equ		$000E					;Cocoon Priority ( READ )prio_mask			equ		bit_5++\				;Mask for priority							bit_6++\							bit_7fire_watch			equ		$000E					;Cocoon Fire Watchdog ( WRITE )fire_watch_bit		equ		bit_7speed_cont			equ		$000F					;Cocoon Speed Control ( READ/WRITE )dma_speed			equ		bit_7					;DMA Speed Control (1 = slow, 0 = fast);;*******************************************************;;	OLD SCSI card hardware registers;;*******************************************************;io_stbreset			equ		$CFFF					;reset I/O strobe space registeropdmadatareg		equ		$0008					;data in/out pseudo DMA registercard_priot_reg		equ		$0009					;priority jumper block i/o addressocard_breg			equ		$000A					;old scsi card rom/ram bank select registeropdmareg			equ		$000D					;Pseudo-DMA mode enable old scsi carddrqstatreg			equ		$000E					;b7 = DRQ status bit of address $C0NE													;													; OLD SCSI CARD internal ram variables/equates													;scsi_init			equ		$00C809					;Init flagsdat_start			equ		$00C831					;Start of SDAT ramgs_flag				equ		$00C8F3					;GS system flagdibtab_start		equ		$00C931					;start of DIBTAB ramdibtab_len			equ		$001B					;length of dibtab record					EJECT;*******************************************************;;	SCSI bus timeout equates;;*******************************************************bus_set_delay		equ		$FF						;bus SET delaybus_res_hold		equ		$FF						;bus RESET hold time (25 usec min.)sel_abort_tout		equ		$20						;bus SELECT abort time (200 usec max)sel_timeout			equ		$A100					;SELECT Timeout (250 millisec min.)millisec_count		equ		$00CB					;count for 1 millisecond delayusec125				equ		66						;count for 256 usec delaybres_ready_del		equ		275						;275 millllisecarbtcount			equ		120						;2 second arbitration timeout;;*******************************************************;;	Misc Hardware registers;;*******************************************************dma_bank_reg		equ		$00C037					;system dma bank registerslotromsel			equ		$00C02D					;slot rom select register					EJECT;*******************************************************;;	SCSI Manager zero page equates;;*******************************************************;driver_zpg			equ		$0000					;256 bytes reserved for device driversdriverzpgsize		equ		$0100;scsizpg				equ		$0000					;start of our zero page area													;													; zero page working pointer variables													;zpgwptrs			equ		scsizpgdev_slot			equ		scsizpg					;slot numberdev_id				equ		dev_slot+2				;id of device soughtpversion			equ		dev_id+2				;parameter list version numbercall_attrbs			equ		pversion+2				;call attribute flagscalltout			equ		call_attrbs+2			;number of 1/4 secs call must complete withincompvector			equ		calltout+2				;completion routine vectorscsicptr			equ		compvector+4			;scsi command pointerdclst_ptr			equ		scsicptr+4				;pointer to buffer structurereq_count			equ		dclst_ptr+4				;working register for byte count requestedasense_ptr			equ		req_count+4				;autosense buffer pointermsgb_ptr			equ		asense_ptr+4			;message buffer pointerendzwvars			equ		msgb_ptr+4				;end zero page work variableswptrssize			equ		endzwvars-zpgwptrs		;number of bytes in working pointers													;													; zero page misc variables													;logunit				equ		endzwvars				;logical unit work variableslot_no				equ		logunit+2				;slot number work variableio_offset			equ		slot_no+2				;work io space address work variabledma_offset			equ		io_offset+4				;dma controller io space address work variableplist_ptr			equ		dma_offset+4			;parameter list pointerdc_pc				equ		plist_ptr+4				;working data chain inst prog. countercurr_dci_ptr 		equ		dc_pc+4					;work current data chain inst pointerbuffer_ptr			equ		curr_dci_ptr+4			;work buffer pointerbyte_ctr			equ		buffer_ptr+4			;work byte counterxfer_count			equ		byte_ctr+4				;working register for byte count transferred;numscsi_cards		equ		xfer_count+4			;number of scsi cards found in systemsdrsonline			equ		numscsi_cards+2			;number of sdrs onlinesdrstocheck			equ		sdrsonline+2			;working varialbleactive_sdr			equ		sdrstocheck+2			;pointer to currently active SDRio_table_ptr		equ		active_sdr+4			;points to I/O tableiorec_ptr			equ		io_table_ptr+4			;I/O record pointersdr_table_ptr		equ		iorec_ptr+4				;scsi device records table pointersdr_ptr				equ		sdr_table_ptr+4			;SDR record pointer	next_sdr			equ		sdr_ptr+4				;contains address of next available SDRavail_sdrs			equ		next_sdr+4				;number of available SDRsscratchzpg			equ		avail_sdrs+2			;scratchpad pointertemp1				equ		scratchzpg+4			;scratchpadtemp2				equ		temp1+4					;scraattchpadaddr_table_ptr		equ		temp2+4					;routine tables pointertick_addr			equ		addr_table_ptr+4		;system wide tick counter addresszpgsize				equ		tick_addr+4-scsizpg		;scsi manager has 1 page of zero page space max.;max_zpgcode			equ		$0080					;largest code space for zero page routinesmaxzpg_space		equ		$0200					;2 pages for zero page space max.driver_zpg_size		equ		$0100					;one page of drivers (2nd page for scsi manager)zeropg_code			equ		$0080					;start of zero page codezpgbank				equ		$0000					;zero page always in bank $0000;*******************************************************;;	GS/OS zero page equates;;*******************************************************;sib_plptr			equ		$0078					;pointer to parameter list for scsi managergsoszpgscratch		equ		$0060					;scratch zero page area in gs/os zero page					EJECT;*******************************************************;;	Parameter list field definitions for Request Devices &;	Claim Devices calls.;;*******************************************************													;													; Get Devices parameter list fields													;getdevs_plst		equ		$0000scsi_dtype			equ		$0000					;scsi device typeintcomvect			equ		$0002					;intercommnunication vectordestbuffptr			equ		$0006					;destination buffer pointer													;													; destination buffer field definitions													;zpg_addr			equ		$0000					;offset to zero page fieldtotal_devcount		equ		$0002					;total device count fielddevice_slot			equ		$0004					;slot number fielddevice_id			equ		$0006					;scsi device id field;reqENTRY_size		equ		device_id\							-total_devcount			;number of bytes per ENTRY;					EJECT;*******************************************************;;	Parameter list field definitions for SCSI I/O call;;*******************************************************													;													; I/O call parameter list													;io_call_plst		equ		$0000plst_slot			equ		$0000					;device ID := slot & unit numberplst_devid			equ		$0002					;parameter list device IDplst_version		equ		$0004					;parameter list versionplst_attrbs			equ		$0006					;attributes wordplst_timeout		equ		$0008					;timeout in 1/4 sec countsplst_comp_vect		equ		$000A					;Completion vectorplst_cmd_ptr		equ		$000E					;pointer to scsi cmd listplst_dchainptr		equ		$0012					;pointer to data chain instructionsplst_reqxfr_cnt		equ		$0016					;request/transfered byte countplst_autos_ptr		equ		$001A					;pointer to autosense bufferplst_msg_ptr		equ		$001E					;pointer to message buffer pointerplst_Reserved		equ		$0022					;reserved (must be $0000)													;													; parameter list attribute bits definitions													;plst_disc_bit		equ		bit_15					;parameter list attribute bit for disconnectplst_msgin_bit		equ		bit_14					;save message in bytes in message bufferplst_msgout_bit		equ		bit_13					;message out bytes in message buffer for targetplst_attresbits		equ		$7FFF					;param list attributes word reserved bits													;													; DATA CHAINING INSTRUCTION DEFINITION													;dci_opcode			equ		$0000					;opcode fielddci_count_field		equ		$0004					;count fielddci_offset			equ		$0008					;offset fielddci_save			equ		$000C					;data chain instruction save areadci_size			equ		dci_save+4\							-dci_opcode				;number of bytes in data chain instructionmaxdcis				equ		32						;maximum of 32 data chain inst per i/o call					EJECT;*******************************************************;;	SCSI Manager Errors;;*******************************************************success				equ		$0000				;scsi_man_err		equ		$FE00				;generic scsi manager errorbad_dev_type		equ		$FE01				;invalid SCSI device typeckcondition			equ		$FE02				;check conditionbad_scsi_id			equ		$FE03				;invalid SCSI device IDcondmetgood			equ		$FE04				;condition met goodplist_error			equ		$FE05				;invalid SCSI Mgr. parameter blockbad_buff_size		equ		$FE06				;invalid buffer sizesm_rsrc_err 		equ		$FE07				;unable to allocate mgr. resourcestarget_busy			equ		$FE08				;target busysm_shutdown_err		equ		$FE09				;unable to shutdown scsi managerscsicmd_err			equ		$FE0A				;scsi manager command out or rangescsi_start_err		equ		$FE0B				;scsi manager already started errorno_startup_err		equ		$FE0C				;SCSI Manager not started errorno_scsi_hardware	equ		$FE0D				;no scsi cards foundirq_install_err		equ		$FE0E				;unable to install scsi irq handlerirq_remove_err		equ		$FE0F				;unable to unbind scsi irq handlerintermed_good		equ		$FE10				;intermediate status good (linked cmds)calltout_err		equ		$FE11				;call timeout errorget_dib_err			equ		$FE12				;get_dib_ptr call failedgen_scsi_bus_err 	equ		$FE13				;general scsi bus errorbus_free_err		equ		$FE14				;bus freee phase errorarbit_phase_err		equ		$FE15				;bus arbitration errorsel_phase_err		equ		$FE16				;select phase errorint_cond_met_good	equ		$FE17				;intermediate/condition met/goodcmd_phase_err		equ		$FE18				;command phase errordata_phase_err		equ		$FE19				;data phase errorbad_msg_err			equ		$FE1A				;message phase errorreserve_conflict	equ		$FE1B				;reservation conflictstat_phase_err		equ		$FE1C				;status phase errorscsi_bus_Res_err 	equ		$FE1D				;SCSI bus reset errorno_scsi_devs		equ		$FE1E				;general scsi hardware errorno_scsi_err			equ		$FE1F				;No SCSI signatured hardware foundinv_scsi_irq		equ		$FE20				;Invalid SCSI interrupt generatedinv_code_err		equ		$FE21				;seq opcode routine should not have gone to bcs handlerinv_phase_err		equ		$FE22				;Invalid phase patternsm_busy_err			equ		$FE23				;SCSI Manager busy errorautosfail_err		equ		$FE24				;Autosense call failed												;												; SCSI target status error codes												;queue_full			equ		$FE28				;queue full status												;$FExx where xx = scsi status byte		EJECT;*******************************************************;;	SCSI message definitions;;*******************************************************cmd_complete		equ		$0000				;command completeextended_msg		equ		$0001				;extended message markersave_dat_ptr		equ		$0002				;save data pointer messagerest_data_ptr		equ		$0003				;restore data pointer messagedisconnect			equ		$0004				;disconnect messageinit_err_detect		equ		$0005				;initiator detected errorabort_msg			equ		$0006				;abort transaction messagerEJECT_msg			equ		$0007				;rEJECT messagenop_msg				equ		$0008				;NO operation messagepar_err_msg			equ		$0009				;parity error messagelink_comp_msg		equ		$000A				;linked command complete messagelink_compwf_msg		equ		$000B				;linked command complete with flag messagebus_dev_res_msg		equ		$000C				;bus device reset messagesdata_follows		equ		$000D				;auto Sense data followsidentify_msg		equ		$0080				;$80-$FF = Identify message					EJECT;*******************************************************;;	SCSI Manager Data structures;;*******************************************************;;	SCSI Manager I/O Space Table;;*******************************************************;;	This table contains all the entries for each Slot,;	scsi devices and logical units within scsi devices.;	The bitmap of the scsi device logical units is;	broken down as follows:;;	I/O table record:;	+-----------+-----------+;	|    	Slot Number		|	slots 0-F (slot 0,8 do not exist) slots 9-F external ;	+-----------+-----------+;	| SCSI hardware version	|	hardware version identification;	+-----------+-----------+;	|    5380 base addr		|	Low word $C0X0 where X := (slot# * $10) + $80;	+-----------+-----------+;	|   5380 bank number	|	bank number of scsi controller base;	+-----------+-----------+;	| DMA Control base addr |	Low word $C0X0 where X := (slot# * $10) + $80;	+-----------+-----------+;	|  DMA controller bank	|	DMA controller bank;	+-----------+-----------+;	| Card/port attributes	|;	+-----------+-----------+;	|   Initiator Priority	|;	+-----------+-----------+;	| SCSI Device 0 Logical	|	Bit Map for Logical units on SCSI Device 0;	+-----------+-----------+;	| SCSI Device 1 Logical	|	Bit Map for Logical units on SCSI Device 1;	+-----------+-----------+;	| SCSI Device 2 Logical	|	Bit Map for Logical units on SCSI Device 2;	+-----------+-----------+;	| SCSI Device 3 Logical	|	Bit Map for Logical units on SCSI Device 3;	+-----------+-----------+;	| SCSI Device 4 Logical	|	Bit Map for Logical units on SCSI Device 4;	+-----------+-----------+;	| SCSI Device 5 Logical	|	Bit Map for Logical units on SCSI Device 5;	+-----------+-----------+;	| SCSI Device 6 Logical	|	Bit Map for Logical units on SCSI Device 6;	+-----------+-----------+;	| SCSI Device 7 Logical	|	Bit Map for Logical units on SCSI Device 7;	+-----------+-----------+;	|		RESERVED		|	Room for future expansion;	+-----------+-----------+;;	NOTE:	1.	If the Slot Number field is zero then;				no SCSI card/port was found in this;				position Otherwise it contains the slot;				number;			2.	The Intiator priority defined by the;				cards Built-in SCSI ports are defined;				have the highest priority $07;;	card/port_attrbs:;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	 | | | | | | | | | | | | | | | |;	 | | | | | | | | | | | | +-+-+-+----- scsi hardware version;	 | | | | | | | | | | | +------------- card/built-in port 	0=port, 1=card;	 | | | | | | | | | | +--------------- IRQ support		0=no irq 1=generates irq;	 | | | | | | | | | +----------------- DMA support		0=no DMA 1=DMA transfers;	 +-+-+-+-+-+-+-+-+------------------- RESERVED;;	scsi hardware version:;	0000 = Old SCSI card;	0001 = New SCSI card;	0010 = Option 4 built-in port;	0011-1111 Reserved;;	Device word:;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	 | | | | | | | | | | | | | | +-+------ Logical unit 0;	 | | | | | | | | | | | | +-+---------- Logical unit 1;	 | | | | | | | | | | +-+-------------- Logical unit 2;	 | | | | | | | | +-+------------------ Logical unit 3;	 | | | | | | +-+---------------------- Logical unit 4;	 | | | | +-+-------------------------- Logical unit 5;	 | | +-+------------------------------ Logical unit 6;	 +-+---------------------------------- Logical unit 7;;	Each pair of bits is encoded as follows:;;*******************************************************;scan_lu				equ		%00 				;This logical unit needs to be scanned forlu_online			equ		%01 				;This logical unit is online leave aloneselect_active		equ		%10 				;Currently trying to select this scsi devicelu_scan_end			equ		%11					;Do not check for Logical units beyond this one;;*******************************************************;iorecord			equ		$0000slot				equ		iorecordhwd_type			equ		slot+2scsi_base			equ		hwd_type+2			;scsi controller base addressscsi_bank			equ		scsi_base+2			;high word of scsi controller basedma_base			equ		scsi_bank+2			;io base addr for dma controlldma_bank			equ		dma_base+2			;dma control bank addressio_attrbs			equ		dma_bank+2			;this slots/port attributesinitpriot			equ		io_attrbs+2			;Initiator priorityd0logicals			equ		initpriot+2			;device 0 logical units bit mapd1logicals			equ		d0logicals+2		;device 1 logical units bit mapd2logicals			equ		d1logicals+2		;device 2 logical units bit mapd3logicals			equ		d2logicals+2		;device 3 logical units bit mapd4logicals			equ		d3logicals+2		;device 4 logical units bit mapd5logicals			equ		d4logicals+2		;device 5 logical units bit mapd6logicals			equ		d5logicals+2		;device 6 logical units bit mapd7logicals			equ		d6logicals+2		;device 7 logical units bit mapend_iorecord		equ		d7logicals+2		;iorec_size			equ		end_iorecord\							-iorecord			;size I/O record size;*******************************************************;;	io_attrbs bit definitions & defaults;;*******************************************************												;												; Hardware version types												;old_scsi_card		equ		$0000new_scsi_card		equ		$0001;					equ		$0002				;opt4_scsi;					equ		$8000+0				;vendor_spec0;					equ		$8000+1				;vendor_spec1;					equ		$8000+2				;vendor_spec2;					equ		$8000+3				;vendor_spec3;					equ		$8000+4				;vendor_spec4;					equ		$8000+5				;vendor_spec5;					equ		$8000+6				;vendor_spec6;					equ		$8000+7				;vendor_spec7												;												; I/O attribute bits												;external_card		equ		$0002irq_support			equ		$0004dma_support			equ		$0008;old_card_attrbs		equ		$0010				;old card, external, no irq or DMA supportnew_card_attrbs		equ		$0070				;new scsi card attributes					EJECT;*******************************************************;;	I/O table;;*******************************************************io_table			equ		$0000				;io table definitions0_iorec			equ		io_table\							+iorec_size			;slot 0 internals1_iorec			equ		s0_iorec\							+iorec_size			;slot 1s2_iorec			equ		s1_iorec\							+iorec_size			;slot 2s3_iorec			equ		s2_iorec\							+iorec_size			;slot 3s4_iorec			equ		s3_iorec\							+iorec_size			;slot 4s5_iorec			equ		s4_iorec\							+iorec_size			;slot 5s6_iorec			equ		s5_iorec\							+iorec_size			;slot 6s7_iorec			equ		s6_iorec\							+iorec_size			;slot 7s8_iorec			equ		s7_iorec\							+iorec_size			;slot 0 externals9_iorec			equ		s8_iorec\							+iorec_size			;slot 1sA_iorec			equ		s9_iorec\							+iorec_size			;slot 2sB_iorec			equ		sA_iorec\							+iorec_size			;slot 3sC_iorec			equ		sB_iorec\							+iorec_size			;slot 4sD_iorec			equ		sC_iorec\							+iorec_size			;slot 5sE_iorec			equ		sD_iorec\							+iorec_size			;slot 6sF_iorec			equ		sE_iorec\							+iorec_size			;slot 7end_iotable			equ		sF_ioreciotsize				equ		end_iotable\							-io_table			;io_table size					EJECT;*******************************************************;;	Scsi Device Record (SDR);;*******************************************************;;	+-----------+-----------+;	|	  Next SDR Link		|	Address of next SDR record (LONG);	+-----------------------+;	|	  sdr_plist_ptr		|	pointer to parameter list tied to this device (LONG);	+-----------+-----------+;	|       Device Id		|	ID assigned to this Logical Unit (WORD);	+-----------+-----------+;	|   SCSI Device Type 	|	See standard for definition (WORD);	+-----------------------+;	| SCSI standard Version |	Refer to SCSI standard (WORD);	+-----------+-----------+;	|		SDR Flags		|	scsi device access attributes (WORD);	+-----------+-----------+;	|		SDR SubLU		|	sub logical unit (reserved must be zero) (WORD);	+-----------+-----------+;	|	 SDR Logical Unit	|	Logical unit number (WORD);	+-----------+-----------+;	|	 Target priority	|	Target priority record belongs to (WORD);	+-----------+-----------+;	|	  Host priority		|	Initiator priority this LU talks to (WORD);	+-----------+-----------+;	|		SDR Slot		|	card slot no. for this LU (WORD);	+-----------+-----------+;	|						|;	+--  5380 Base Addrs  --+	I/O base address for 5380 (LONG);	|						|;	+-----------+-----------+;	|						|;	+--   DMA Base Addrs  --+	I/O base address for 5380 DMA control (LONG);	|						|;	+-----------+-----------+;	|						|;	+-- Timeout Remaining --+	call timeout remaining (seconds) (LONG);	|						|;	+-----------+-----------+;	|						|;	+-- completion Vector --+	completion vector (LONG);	|						|;	+-----------+-----------+;	|						|;	+-- Next Command Byte --+	position of next command byte to send (LONG);	|						|;	+-----------+-----------+;	|						|	Field to save data chain instruction during;	+-- Data Chain Offset --+	Save pointers call (LONG);	|						|;	+-----------+-----------+;	|						|	current position of buffer address (2's complement form);	+------ Buffer Ptr -----+;	|						|;	+-----------+-----------+;	|						|;	+-- Current byte count--+	Byte count place holder (LONG);	|						|;	+-----------+-----------+;	|						|;	+--  Context RAM HNDL --+	Handle to RAM for Context Switches (LONG);	|						|;	+-----------+-----------+;	|		Reserved 		|	Expansion (WORD);	+-----------+-----------+;;;	Device ID:;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	 | | | | | | | | | | | | | | | |;	 | | | | | | | | | | | | | | | |;	 | | | | | | +-+-+-+-+-+-+-+-+-+-----	Device ID assigned by SCSI Manager;	 | +-+-+-+-+-------------------------	RESERVED;	 +-----------------------------------	Claimed bit 1= Claimed by driver;;;	Logical Unit Attrbs:;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|;	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;	 | | | | | | | | | | | | | | | |;	 | | +-+-+-+-+-+-+-+-+-+-+-+-+-+-----	RESERVED;	 | +---------------------------------	SDR record busy flag;	 +-----------------------------------	Removeable media;;	SCSI_DEVICE_TYPE BYTE DEFINITION: (Inquiry call;	definition);	Bits 0-4;	$00		=	Direct access device (magnetic disk);	$01		=	Sequential access device (magnetic tape);	$02		=	Printer device;	$03		=	PROCessor device;	$04		=	Write-once direct access device (some;				optical disks);	$05		=	Read-only direct access device (optical;				disks);	$06		=	Scanner device;	$07		=	Optical Memory devices (optical disks);	$08		=	Changer device (jukeboxes);	$09		=	Communications device;	$0A-$0F =	RESERVED;	$10		=	Apple Tape Drive;	$1E		=	Target device ???;	$1F		=	Unknown device type;;	Bits 5-7;	000		=	Type defined by bits 0-4 connected to this LU;	001		=	Target SCSI ID able to support type defined;				by bits 0-4;	010		=	RESERVED;	011		=	LU not able to support Logical unit;	1XX		=	Vendor Unique;;*******************************************************sdr_record			equ		$0000				;scsi manager scsi device recordnxt_sdr_lnk			equ		sdr_record			;(4)link to next SDR in the queuesdr_plist_ptr		equ		nxt_sdr_lnk+4		;(4)pointer to parameter list tied to this devicesdr_device_id		equ		sdr_plist_ptr+4		;(2)ID assigned by SCSI managersdr_devtype			equ		sdr_device_id+2		;(2)SCSI Device type definitionsdr_standard_vers	equ		sdr_devtype+2		;(2)scsi standards versionsdr_flags			equ		sdr_standard_vers+2	;(2)scsi device access attributessdr_sublu			equ		sdr_flags+2			;(2)sub logical unit (reserved must be zero)sdr_logunit			equ		sdr_sublu+2			;(2)Logical unit numbersdr_targ_priot		equ		sdr_logunit+2		;(2)Target device prioritysdr_init_priot		equ		sdr_targ_priot+2	;(2)Initiator priority this LU talks tosdr_slot			equ		sdr_init_priot+2	;(2)card slot no. for this LUsdr_5380_base		equ		sdr_slot+4			;(4)I/O base address for 5380sdr_dma_base		equ		sdr_5380_base+4		;(4)I/O base address for 5380 DMA controlsdr_timeout			equ		sdr_dma_base+2		;(4)call timeout remaining (seconds)sdr_completion_vect	equ		sdr_timeout+4		;(4)completion vectorsdr_cmd_ptr			equ		sdr_completion_vect\							+4					;(4)position of next command byte to sendsdr_dc_offset		equ		sdr_cmd_ptr+4		;(4)Position of current data chain instructionsdr_Buffer_ptr		equ		sdr_dc_offset+4		;(4)address of next data byte in buffersdr_byte_count		equ		sdr_buffer_ptr+4	;(4)intermediate byte countcontext_hndl		equ		sdr_byte_count+4	;(4) Handle to RAM for context Switchsdr_reserved		equ		context_hndl+4		;(2) room for expansionend_sdr_record		equ		sdr_reserved+2sdrrec_size			equ		end_sdr_record\							-sdr_record			;size of scsi device record;;	SCSI DEVICE RECORD (SDR) attributes word bit definitions;;	bits 0-D reserved & must be zero;sdr_attrb_busy		equ		bit_15				;SDR busy marker bitsdr_attrb_tout		equ		bit_14				;call timed outsdr_attrb_disc		equ		bit_13				;disconnect flagsdr_attrb_purge		equ		bit_12				;flag to mark purge on next timeout IRQsdr_attrb_rmb		equ		bit_7				;media removeable bit					EJECT;*******************************************************;;	SCSI device types as defined by the SCSI 2 standard;;*******************************************************;;	$00 =	Direct access device (magnetic disk);	$01 =	Sequential access device (magnetic tape);	$02 =	Printer device;	$03 =	PROCessor device;	$04 =	Write-once direct access device (some;			optical disks);	$05 =	Read-only direct access device (optical;			disks);	$06 =	Scanner device;	$07 =	Optical Memory devices (optical disks);	$08 =	Changer device (jukeboxes);	$09 =	Communications device;	$0A-$10 = RESERVED;	$1E =	Target device ???  (SEE STANDARD);	$1F =	Unknown device type;diraccdev			equ		$0000seqaccdev			equ		$0001prnterdev			equ		$0002PROCdev				equ		$0003wrtoncedev			equ		$0004readonlydev			equ		$0005scannerdev			equ		$0006optmemdev			equ		$0007changerdev			equ		$0008commdev				equ		$0009apple_tape			equ		$0010targetdev			equ		$001Eunknowndev			equ		$001F					EJECT;*******************************************************;;	SCSI Manager misc. equates;;*******************************************************;startup				equ		$0000				;scsi manager call numbersshutdown			equ		$0001request_devs		equ		$0002claim_devs			equ		$0003io_call				equ		$0005scsi_manager_id		equ		$0002				;See SCSI supervisor driver ERSbind_irq			equ		$2031				;class 1 bind interrupt call numberbind_pcount			equ		$0003				;bind irq parameter countunbind_irq			equ		$2032				;class 1 unbind irq call numberunbind_pcount		equ		$0001				;unbind parameter countadd_notify_proc		equ		$2034				;class 1 Add Notify Proc call numberadd_notify_pcount	equ		$0001				;Add Notify Proc parameter countdel_notify_proc		equ		$2035				;class 1 Del Notify Proc call numberdel_notify_pcount	equ		$0001				;Del Notify Proc parameter countgsos_busy			equ		$0007				;GS/OS busy error generated during Unbind irqother_irq_vrn		equ		$0017				;IRQ other VRNscsi_vrn			equ		other_irq_vrn		;our vrn for now will change in option 4mtool_id_type		equ		$3B00				;supervisors driver id type from misc. toolsinitpriority		equ		$0007				;SCSI priority for initiatorwait_phase_rcnt		equ		$0003				;high word of wait_phase retry countqtrsec				equ		$000F				;15 ticks for 1/4 secondmax_slots			equ		$0008				;maximum number of slots internal & externalmax_scsi_devs		equ		$0008				;maximum scsi device on bus per slotmax_targets			equ		$0007				;maximum number of SCSI targets per slotmax_logunits		equ		$0008				;maximum number of SCSI Logical unitsinqbsize			equ		$100				;2 buffers 256 bytes eachinqbstart			equ		$0002				;start of inquiry buffer data areamem_page			equ		$0100				;256 bytes per memory pagesdrsperpage			equ		mem_page\							/sdrrec_size		;number of sdrs per pagedefault_sdrs		equ		sdrsperpage*2		;minimum number of SDRs allocatedsdr_memory			equ		default_sdrs\							*sdrrec_size		;amount of default SDR memorymax_sdrs			equ		max_slots\							*max_targets\							*max_logunits		;max SCSI Device recordsmin_mem_size		equ		iotsize\			;I/O table size							+sdr_memory			;two memory pages for sdrs to start withmin_cmd_size		equ		$0006				;smallest scsi command 6 bytesmid_cmd_size		equ		$000A				;middle scsi command 10 bytesmax_cmd_size		equ		$000C				;largest scsi command 12 bytesdont_scan_dev		equ		$FFFF				;Do not scan any logicalsno_device			equ		$FFFF  				;marker for no scsi device foundlunotavail			equ		$007F				;byte 1 of inquiry (LU not available)claimed				equ		bit_15				;bit 15 of sdr_id field marks device claimedslot0				equ		$0000				;slot7				equ		$0007				;slot7ext			equ		$000F				;slot 7 external;scsid0				equ		$0000				;scsi device number 0scsid1				equ		$0001				;scsi device number 1scsid2				equ		$0002				;scsi device number 2scsid3				equ		$0003				;scsi device number 3scsid4				equ		$0004				;scsi device number 4scsid5				equ		$0005				;scsi device number 5scsid6				equ		$0006				;scsi device number 6scsid7				equ		$0007				;scsi device number 7;scsi_prior0			equ		bit_0				;scsi device 0 priorityscsi_prior1			equ		bit_1				;scsi device 1 priorityscsi_prior2			equ		bit_2				;scsi device 2 priorityscsi_prior3			equ		bit_3				;scsi device 3 priorityscsi_prior4			equ		bit_4				;scsi device 4 priorityscsi_prior5			equ		bit_5				;scsi device 5 priorityscsi_prior6			equ		bit_6				;scsi device 6 priorityscsi_prior7			equ		bit_7				;scsi device 7 priority;lu0					equ		$0000				;logical unit numberslu1					equ		$0020				;in logical unit fieldlu2					equ		$0040				;within the scsi command lu3					equ		$0060				;packet. (bits 5-7 of byte 0)lu4					equ		$0080lu5					equ		$00A0lu6					equ		$00C0lu7					equ		$00E0												;												; Memory attribute equates												;attrlock			equ		bit_15				;Block is locked down.attrfixed			equ		bit_14				;Block can't move in memattrpurg1			equ		bit_8				;Purge level 1attrpurg2			equ		bit_9				;Purge level 2attrpurg3			equ		bit_8+bit_9			;Purge level 3attrnocross			equ		bit_4				;May not cross banksattrnospec			equ		bit_3				;don't use special memattrpage			equ		bit_2				;Page allignedattraddr			equ		bit_1				;Remain at fixed addressattrbank			equ		bit_0				;Remain in fixed banksm_buffer_attrs		equ		attrlock++\			;Attributes of requested mem.							attrfixed++\							attrnocross++\							attrnospec++\							attrpagezpg_attrbs			equ		attrlock++\			;scsi Manager zero page MM attributes							attrfixed++\							attrnocross++\							attrpage++\							attrbankgsos_sys_death		equ		$01FC44				;GS/OS system death system service routineslot_arbit			equ		$01FCBC				;GS/OS system service routine slot arbitratoreunich_vect			equ		$01FCD8				;Use this wrong and be come a eunich.incbusyflag			equ		$E10064				;Increment Busy flag ENTRY pointdecbusyflag			equ		$E10068				;Decrement Busy flag ENTRY pointstack_ENTRY			equ		$E100B0				;GS/OS stack based call ENTRY pointsystem_busy_flag	equ		$E100FF				;System Busy Flag.System_Type			equ		$E1018E				;³ 6 = 10 Speedrom_message			equ		$0020				;message number for rev c rom requiredrev_c_rom			equ		$0002				;version number for version C scsi rom;*******************************************************;;	Data Chaining equates;;*******************************************************dc_size				equ		$0010				;16 bytes per data chain instruction;dc_loop_inst		equ		$ffffffff			;-1 defines loop ocodedc_stop_inst		equ		$00000000												;												; chain instructions field positions												;dc_opcode			equ		$0000				;long word field for the data chain opcodedc_count			equ		$0004				;long word field for count fielddc_offset			equ		$0008				;long word field for offsetdc_sav_ptrs			equ		$000C				;long word field for save pointers field;*******************************************************;;	SCSI Manager sequence number equates;;*******************************************************oend				equ		$0000				;end of sequence markerirq_hand			equ		$0000				;irq handlerphase_hand			equ		$0001				;phase handlerhwdchk				equ		$0002				;hardware type checksetup				equ		$0003				;setup routinebfreeph				equ		$0004				;bus freearbph				equ		$0005				;arbitrateselectph			equ		$0006				;selectdoutph				equ		$0007				;data out phasedinph				equ		$0008				;data in phasecmdph				equ		$0009				;command phasestatph				equ		$000A				;status phasemoutph				equ		$000D				;message outminph				equ		$000E				;message in;*******************************************************;;	Byte definitions of INQUIRY packet;;*******************************************************;;	inquiry packet field positions;inq_packet			equ		$0000inq_devtype			equ		$0000				;scsi device typeinq_rmb				equ		$0001				;bit 7 = removeable bitinq_version			equ		$0002				;standard supported version informationinq_attrbs			equ		$0007				;attribute bits for target (see standard);;	Inquiry	packet bit definitions;scsidt_mask			equ		$007F				;mask for device typescsi_rmb			equ		$0080				;removeable media bitscsi_svers			equ		$0007				;scsi standard version number					EJECT