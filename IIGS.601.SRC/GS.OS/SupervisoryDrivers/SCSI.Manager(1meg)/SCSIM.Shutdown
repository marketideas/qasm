;*******************************************************;;	'SCSIM.Shutdown';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains code to handle the Shutdown Call.;	It will deallocate all the resources used by the;	SCSI Manager to become operational.;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		tout_header					IMPORT		arbtout_header					IMPORT		scsim_chars					IMPORT		zpg_hold					IMPORT		zpg_savebuff					IMPORT		zpg_handle					IMPORT		user_id					IMPORT		sdriver_no_hold					IMPORT		schedule_unbind					IMPORT		zap_oldcard;					ENTRY							PRINT		OFF					INCLUDE		'SCSIM.Equates'					INCLUDE		'Common.Equ.Src'					INCLUDE		'HW.Equ.Src'					INCLUDE		'M16.MEMORY'					INCLUDE		'M16.UTIL'					INCLUDE		'M16.MISCTOOL'					PRINT		ON					EJECT;*******************************************************;;	'scsim_shutdown';;	Main Entry point to the 'Shutdown' routine.  This;	is called before the Manager is unloaded.  The code;	that follows clears up the Manager's environment,;	then calls Memory Manager to deallocate space.;;	Called via 'JSR';;	Inputs:		e,m,x		=	0 (full native);;	Outputs:	e,m,x		=	0 (full native);				Acc			=	0;				Carry		=	0;				Y reg		=	Unspecified;				X reg		=	Unspecified;				P reg		=	0=M=X=e;				D Page		=	GS/OS Direct Page;				Bank		=	Ours;;	Errors:		See Spec.;;*******************************************************					EXPORT	scsim_shutdownscsim_shutdown		PROC											;											; delete our timeout heartbeat											; task											;					PUSHLONG	#tout_header					_DelHeartBeat					bcs		death			;go away if error											;											; delete arbitration heartbeat											; task											;					PUSHLONG	#arbtout_header					_DelHeartBeat					bcs		death			;go away if error											;											; check characteristics word											; for restartable.  If											; restartable then check											; warm_cold_flag to see if											; going to sleep or being											; killed.											;					bit		|scsim_chars	;check bit 15 for restartable					bpl		@100			;coldshutdown if not restartable					lda		>warm_cold_flag					and		#$0001					beq		@100			;Z=1 marks a cold shutdown go do it											;											; warmshutdown saves zero page											; in a internal buffer within											; the manager											;											;											; Save Zero Page Values.											;					PUSHWORD	#NULL			;source address High					PUSHWORD	|zpg_hold		;source address Low					PUSHLONG	#zpg_savebuff	;destination address 					PUSHLONG	#maxzpg_space 					PUSHWORD	#move_sinc_dinc					jsl		move_info											;											; now dispose the zero page area											; allocated											;					PUSHLONG	|zpg_handle					_disposeHandle					bcs		death					bra		wrmshut			;go away												;											; dispose all memory allocated											; to us											;@100				PUSHWORD	|user_id	;dispose all memory we allocated					_disposeAll					bcs		death			;dispose of memory allocated to us											;											; dispose our ID back to Misc.											; Tools											;					PUSHWORD	|user_id	;dispose our ID back to misc tools					_DeleteIdwrmshut				jsr		zap_oldcard											;											; Unbind our IRQ via the SCHEDULER											;					jsr		schedule_unbind											;											; get supervisor driver number											; if clean shutdown											;					lda		|sdriver_no_hold					rtsdeath				jsl		gsos_sys_death	;call system death will not return					ENDP						EJECT					END