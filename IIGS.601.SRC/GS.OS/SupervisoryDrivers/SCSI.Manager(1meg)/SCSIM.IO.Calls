;*******************************************************;;;	'SCSIM.IO.Calls';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains code to handle the IO Calls;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		get_plist					IMPORT		ioplchk					IMPORT		setzpgvars					IMPORT		find_sdr					IMPORT		error_stat					IMPORT		copy_plist					IMPORT		setup_call_env					IMPORT		set_iorec_ptr					IMPORT		addr_tables					IMPORT		callrtn					IMPORT		getticks					IMPORT		tick_count					IMPORT		saveptrs					IMPORT		busy_sdr_count					IMPORT		asense_flag					IMPORT		scsi_status					IMPORT		senseid					IMPORT		sense_slot					IMPORT		sensebstruc					IMPORT		sensecnt0					IMPORT		sensecnt1					IMPORT		sense_slot					IMPORT		set_plist					IMPORT		callcomp;					ENTRY							PRINT		OFF					INCLUDE		'SCSIM.Equates';					INCLUDE		'Common.Equ.Src';					INCLUDE		'HW.Equ.Src';					INCLUDE		'M16.MEMORY'					INCLUDE		'M16.UTIL';					INCLUDE		'M16.MISCTOOL'					PRINT		ON					EJECT;*******************************************************;;	'scsim_io';;	This module handles all request for IO Data from the;	device, regardless if it is a Data or Device;	Transaction.;;	Called via 'JSR';;	Inputs:		e,m,x		=	0 (full native);;	Outputs:	e,m,x		=	0 (full native);				Acc			=	0;				Carry		=	0;				Y reg		=	Unspecified;				X reg		=	Unspecified;				D Page		=	GS/OS Direct Page;				Bank		=	Ours;;	Errors:		See Spec.;;*******************************************************					EXPORT	scsim_ioscsim_io			PROC												;												; get parameter list address and												; validate the parameter list												;					jsr		get_plist					stx		<plist_ptr					sty		<plist_ptr+2					jsr		ioplchk				;validate I/O call parameter list					bcs		@l_exit_1												;												; setup working variables from												; parameter list												;					ldx		<plist_ptr					ldy		<plist_ptr+2					jsr		setzpgvars			;setup zero page work pointers												;												; find SDR matching ID from parameter												; list												;					jsr		find_sdr					bcs		@l_exit_1					sty		<sdr_ptr					sta		<sdr_ptr+2					sty		<active_sdr					sta		<active_sdr+2												;												; check if SDR already busy												;					ldy		#sdr_flags					lda		[sdr_ptr],y					and		#sdr_attrb_busy					beq		@10					lda		#target_busy					sta		|error_stat					sec@l_exit_1			lda		|error_stat			;get possible error code back					rts												;												; copy parameters into SDR, mark												; SDR busy												;@10					php							;no interruptions					sei					lda		[sdr_ptr],y					ora		#sdr_attrb_busy					sta		[sdr_ptr],y					plp							;restore interrupt enable bit					jsr		copy_plist												;												; setup work variables from SDR												; and issue call to the target												;					jsr		setup_call_env					ldy		<slot_no			;get the slot number					jsr		set_iorec_ptr		;point to the I/O record for this SDR												;												; point to routines table for this												; type of scsi card												;					ldy		#hwd_type					lda		[iorec_ptr],y					asl		a					asl		a					tay					lda		|addr_tables,y					sta		<addr_table_ptr					lda		|addr_tables+2,y					sta		<addr_table_ptr+2												;												; arbitrate for the SCSI bus and												; then Select the target												;					lda		#arbph				;go arbitrate for control of scsi bus					jsr		callrtn					bcs		@l_exit					lda		#selectph			;select the target device					jsr		callrtn					bcs		@l_exit												;												; do some hardware initialization												;					lda		#setup					jsr		callrtn												;												; start the timeout heartbeat task												;					jsr		getticks			;get number of ticks to load into					sta		|tick_count			;the task header												;												; do a save pointers prior to talking												; to the target in case the first												; communication from the target is a												; restore pointers message												;					jsr		saveptrs												;												; bump the busy SDR count and then go												; to the phase handler												;					inc		|busy_sdr_count					lda		#phase_hand			;phase handler for old scsi card					jsr		callrtn					bcs		@l_exit												;												; check scsi status byte for success.												; If failed see if autosense required												;					lda		|asense_flag		;see if returning from a autosense call					beq		@75					;not autosense												;												; if autosense failed mark it failed												; and quit												;					bcs		@l_exit					lda		|scsi_status		;if status byte not zero then mark failed					bne		@55					lda		<error_stat					beq		@l_exit@55					sec@l_exit				brl		exit												;												; call was not autosense. See if												; autosense enabled and previous call												; failed then issue a request sense												; call to the same target.												;@75					lda		|scsi_status					beq		statok												;												; The following code will be executed												; only if the call failed and autosense												; is enabled.  If autosense is enabled												; then SCSIM_IO will be called again.												;					ldy		#plst_autos_ptr		;see if the auto sense pointer nonzero					lda		[plist_ptr],y					ldy		#plst_autos_ptr+2					ora		[plist_ptr],y					php							;Save the result of the .OR.					lda		|scsi_status		;Get the Status in case the Pointer is Null					plp							;Restore the .OR. Result for the branch condition					beq		@100				;Branch if the AutoSense Pointer is Null.												;												; save the scsi status byte and												; parameter list pointer for later												; restore												;					pha							;save scsi status of previous call					jsr		get_plist			;get call's parameter list pointer					phy							;save old parameter list pointer					phx												;												; setup the ID & buffer pointer for												; the request sense call												;					lda		<dev_id				;device id to issue request sense for					sta		|senseid					lda		<slot_no			;slot number to issue call for					sta		|sense_slot					ldy		#plst_autos_ptr					lda		[plist_ptr],y					sta		|sensebstruc					ldy		#plst_autos_ptr+2					lda		[plist_ptr],y					sta		|sensebstruc+2					lda		#$0014				;20 bytes maximum requested					sta		|sensecnt0			;byte count requested in scsi command packet					sta		|sensecnt1			;byte count in data chaining instructions					ldx		#sense_slot			;point to request sense parameter list					ldy		#^sense_slot					jsr		set_plist												;												; set autosense in progress flag and												; clear SDR busy flag for mode sense												; call												;					dec		|asense_flag		;mark autosense in progress					ldy		#sdr_flags			;clear busy bit (*** change for					lda		[sdr_ptr],y			;disconnect case ***)					and		#sdr_attrb_busy\							--$FFFF					sta		[sdr_ptr],y					jsr		scsim_io			;issue the autosense call												;												; restore parameter list pointer and												; scsi status for previous call												;					plx							;restore parameter list pointer					ply					jsr		set_plist			;restore the parameter list pointer					lda		|error_stat			;get status from request sense call					cmp		#$0001				;check of request sense failed					pla							;restore status from call prior					bcc		@100				;to request sense					ora		#$0080				;bit 7 marks request sense failed@100				ora		#scsi_man_err		;include $FE00 (marks error)					sta		|error_stat			;scsi status error overides other errors					stz		|asense_flag		;reset the autosense flag												;												; call completion routine if vector												; non-zero												;statokexit				jsr		callcomp			;call completion routine if a pointer exists					dec		|busy_sdr_count 	;command completed one less SDR					bne		@100					stz		|tick_count			;reset heartbeat counter no busy sdrs@100				ldy		#sdr_flags			;clear busy bit (*** change for					lda		[sdr_ptr],y			;disconnect case ***)					and		#sdr_attrb_busy\							--$FFFF					sta		[sdr_ptr],yerrexit				lda		|error_stat			;get possible error code backautosexit			rts							;>>>--- scsim_io --->>>					ENDP						EJECT					END