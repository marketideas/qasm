;*******************************************************;;	'SCSIM.Misc';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains code to various misc.;	Transactions, device maintainence and Card Support.;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		snooper_ptr					IMPORT		handle_hold					IMPORT		zpg_handle					IMPORT		zpg_hold					IMPORT		our_zpg_hold					IMPORT		our_irq_flag					IMPORT		cyareg_hold					IMPORT		num_dev_types					IMPORT		ahold					IMPORT		addr_tables					IMPORT		error_stat					IMPORT		devices_found					IMPORT		hwd_version					IMPORT		ioattrbs					IMPORT		init_priority					IMPORT		last_acc_slot2					IMPORT		last_acc_id2					IMPORT		lutemp					IMPORT		ckluflag					IMPORT		scsi_status					IMPORT		scsi_message					IMPORT		more_dci					IMPORT		busy_sdr_count					IMPORT		target_priority					IMPORT		chkbusfloat					IMPORT		yhold					IMPORT		scsi_variables					IMPORT		work_vars_buffer					IMPORT		work_vars_size					IMPORT		gsos_zpg_hold					IMPORT		last_sdr_ptr2					IMPORT		last_acc_slot1					IMPORT		last_acc_id1					IMPORT		last_sdr_ptr1					IMPORT		last_acc_flag					IMPORT		user_id					IMPORT		smbusy_flag					IMPORT		clear_state					IMPORT		smboot_slot					IMPORT		ident_modify					ENTRY		clear_memory					ENTRY		get_zpage					ENTRY		inq_buff					ENTRY		chk_scsi_type					ENTRY		set_iorec_ptr					ENTRY		setup_work_vars					ENTRY		calltarget					ENTRY		nextlu					ENTRY		build_sdr					ENTRY		scan_scsi_devs					ENTRY		save_work_vars					ENTRY		rest_work_vars					ENTRY		smartp_scsi_chk					ENTRY		millisec_delay					ENTRY		setzpgvars					ENTRY		get_plist					ENTRY		set_plist					ENTRY		find_sdr					ENTRY		setonline					ENTRY		setnoscan					ENTRY		alloc_nxt_sdr					ENTRY		id_assignment					ENTRY		adjtout					ENTRY		ckdcilst					ENTRY		getnextID					ENTRY		assgnid					ENTRY		unbind_scsi_irq					ENTRY		irq_id					ENTRY		inq_lunit					ENTRY		tulunit					ENTRY		sense_lunit					PRINT		OFF					INCLUDE		'SCSIM.Equates'					INCLUDE		'Common.Equ.Src'					INCLUDE		'HW.Equ.Src'					INCLUDE		'Driver.Equ.Src'					INCLUDE		'M16.MEMORY'					INCLUDE		'M16.UTIL'					INCLUDE		'M16.MISCTOOL'					INCLUDE		'M16.SCHEDULER'					PRINT		ON					EJECT;__Memory_Manager_Calls__;*******************************************************;;	'allocate_memory';;	This routine will allocate an ID from the Misc.;	Tools and issue a New_handle call to the memory;	manager using this ID.  The Handle returned will be;	saved away to be used during Shutdown of the SCSI;	Manager.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	GS/OS Direct page;				Stack			=	GS/OS stack space;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				user_id			=	ID given to us by Misc.;									Tools;				smhandle_hold	=	handle address from memory;									manager;				scsim_ptr		=	actual buffer address from;									handle;				Carry			=	0 for successful call;								=	1 for error during call;				Acc				=	Error code or supervisor;									driver number;				dpage			=	Our direct page;				X reg			=	Mem Handle Low;				Y reg			=	Mem Handle High;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None.;;*******************************************************;					EXPORT	allocate_memoryallocate_memory		PROC												;												; Get an ID from Misc tools												;					pha							;room for ID from Misc. Tools					pea		#mtool_id_type		;ID type for sup. drivers from misc. tools					_getnewid					ply							;get our ID assuming call succeeded					bcs		@30					;check for error					sty		|user_id												;												; allocate our zero page area												;					jsr		|get_zpage					bcs		@30					;go away if error					ldx		|zpg_hold			;go zero out the memory					ldy		#$0000 					lda		#maxzpg_space					jsr		clear_memory		;FIX ME MSG					lda		|our_zpg_hold		;set our direct register					stz		|snooper_ptr+2		;clear high word of the snooper cda pointer					sta		|snooper_ptr		;save the address of the zero page					tcd							;point to our zero page												;												; allocate our work space												;					PUSHLONG	#null			;room for handle					PUSHLONG	#min_mem_size	;our work area size of 3 pages					PUSHWORD	|user_id		;our user ID					PUSHWORD	#attrlock++\	;Attributes of requested mem.								attrfixed++\								attrnocross++\								attrnospec++\								attrpage					PUSHLONG	#null			;location pointer (will be ignored)					_newhandle					;allocate our memory area					ply							;assume all ok					plx					bcs		@30					;go away if error					sty		|handle_hold		;save our handle					stx		|handle_hold+2	@30					rts					ENDP					EJECT;*******************************************************;;	'get_zpage';;	This routine requests $200 bytes of memory on bank;	$00 to be used for Zero Page addressing.  The First;	$100 is for driver use and the second $100 is for;	the manager's usage.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				user_id			=	Our User ID;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Our;				dpage			=	GS/OS;				Stack			=	GS/OS stack space;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				zpg_hold		=	Address on Bank $00  (WORD);				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error code ;				Carry			=	0 for successful call;								=	1 for error during call;				dpage			=	Our direct page;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		Memory Manager Errors;;*******************************************************;					EXPORT	get_zpageget_zpage			PROC											;											; allocate our zero page area											;					PUSHLONG	#null			;room for handle					PUSHLONG	#maxzpg_space	;zero page					PUSHWORD	|user_id		;our user ID					PUSHWORD	#attrlock++\	;scsi Manager zero page MM attributes								attrfixed++\								attrnocross++\								attrpage++\								attrbank					PUSHWORD	#zpgbank		;must be in bank zero & page aligned					PUSHWORD	#null			;don't really care where in bank $00					_newhandle				;allocate our memory area					ply						;assume all ok					plx					pha						;Preserve Error if any.					sty		<sup_parm_ptr 	;this pointer used as scratch during startup					stx		<sup_parm_ptr+2					sty		|zpg_handle		;save our handle					stx		|zpg_handle+2					lda		[sup_parm_ptr]	;Save Zpage Pointer					sta		|zpg_hold					clc					adc		#driverzpgsize	;Save Our Zpage Pointer					sta		|our_zpg_hold					pla						;Restore Error if any.					rts					ENDP					EJECT;*******************************************************;;	'clear_memory';;	This routine clears a specified number of bytes;	starting at a given location.  It assumes no bank;	crossings!!!!;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	Number of bytes to clear;				X reg			=	Low word of first location;									to clear;				Y reg			=	High word of first location;									to clear;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	GS/OS stack space;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				zpg_hold		=	Address on Bank $00  (WORD);				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None.;;*******************************************************;					EXPORT	clear_memoryclear_memory		PROC					;FIX ME MSG											;											; Zero out the Memory											;					PUSHLONG	#cm_null	;source address					phy						;Destination High					phx						;Destination Low 					pea			$0000					pha						;Byte Count 					PUSHWORD	#move_scon_dinc					jsl		move_info					rts						;>>>--- clear_memory --->>>											;											; Data for this routine.											;cm_null				dc.w	null					ENDP					EJECT			;*******************************************************;;	'callcomp';;	This module will call the completion routine if a;	pointer exists;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				error_stat		=	error code to report;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	GS/OS Direct Page;				Stack			=	GS/OS stack space;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined ;				Carry			=	0 for successful call;				dpage			=	GS/OS Direct Page;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None.;;*******************************************************;					EXPORT	callcompcallcomp			PROC												;												; Call Completion Routine if												; pointer is non-zero.												;					ldy		#plst_comp_vect+2					lda		[plist_ptr],y					ldy		#plst_comp_vect					ora		[plist_ptr],y					beq		@125				;go away if pointer zero					lda		[plist_ptr],y					sta		@100+1					iny					lda		[plist_ptr],y					sta		@100+2					lda		|error_stat@100				jsl		$000000				;*** SELF MODIFYING CODE@125				rts							;>>>--- callcomp --->>>					ENDP						EJECT;*******************************************************;;	'copy_plist';;	This module will copy the parameter list into SDR;;	Inputs:		e,m,x		=	0 (full native);				plist_ptr	=	points to the parameter list;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	fast;;	Output:		e,m,x		=	0 (full native);				Carry		=	0 for successful call;				Acc			=	undefined;				dpage		=	Ours direct page;				Bank		=	ENTRY;				X reg		=	ENTRY;				Y reg		=	undefined;;*******************************************************					EXPORT	copy_plistcopy_plist			PROC												;												; copy the timeout into the SDR												; record												;					ldy		#plst_timeout					lda		[plist_ptr],y					jsr		adjtout				;convert 1/4/s to 1/60/s counts					ldy		#sdr_timeout					sta		[sdr_ptr],y					ldy		#sdr_timeout+2					txa					sta		[sdr_ptr],y												;												; copy completion vector into sdr												;					ldy		#plst_comp_vect					lda		[plist_ptr],y					ldy		#sdr_completion_vect					sta		[sdr_ptr],y					ldy		#plst_comp_vect+2					lda		[plist_ptr],y					ldy		#sdr_completion_vect+2					sta		[sdr_ptr],y												;												; copy the SCSI command list pointer												;					ldy		#plst_cmd_ptr					lda		[plist_ptr],y					ldy		#sdr_cmd_ptr					sta		[sdr_ptr],y					ldy		#plst_cmd_ptr+2					lda		[plist_ptr],y					ldy		#sdr_cmd_ptr+2					sta		[sdr_ptr],y												;												; copy the address of the parameter												; list into the SDR												;					ldy		#sdr_plist_ptr					lda		<plist_ptr					sta		[sdr_ptr],y					ldy		#sdr_plist_ptr+2					lda		<plist_ptr+2					sta		[sdr_ptr],y					rts							;>>>--- copy_plist --->>>					ENDP						EJECT;*******************************************************;;	'ioplchk';;	This module will validate I/O call parameter list;;	Inputs:		e,m,x		=	0 (full native);				plist_ptr	=	points to the parameter list;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	fast;;	Output:		e,m,x		=	0 (full native);				error_stat	=	Error Code if any;				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	undefined;				dpage		=	Ours direct page;				Bank		=	ENTRY;				X reg		=	ENTRY;				Y reg		=	undefined;;*******************************************************;					EXPORT	ioplchkioplchk				PROC												;												; check for slots 0-F												;					ldy		#plst_slot					lda		[plist_ptr],y					cmp		#$0010					bge		plfail				;fail it if out of range					ldy		#plst_devid			;check ID for nonzero					lda		[plist_ptr],y					beq		plfail					ldy		#plst_version		;check the parameter block version					lda		[plist_ptr],y					bne		plfail												;												; check reserved attribute bits												; for zero												;					stz		|ident_modify					ldy		#plst_attrbs					lda		[plist_ptr],y					beq		@attributes_ok					and		#plst_attresbits					bne		plfail;-------------------------------------------------------------------------------------					IF		Disc_ReSel	=	true	then												;												; Set to allow Disconect.												;					lda		#bit_6				;DiscPriv of Identify Message.					tsb		|ident_modify					ENDIF;-------------------------------------------------------------------------------------												;												; check the timeout for nonzero												;@attributes_ok		ldy		#plst_timeout					lda		[plist_ptr],y					beq		plfail												;												; check the command list pointer												; for nonzero												;					ldy		#plst_cmd_ptr					lda		[plist_ptr],y					ldy		#plst_cmd_ptr+2					ora		[plist_ptr],y					beq		plfail												;												; check reserved field for zero												;					ldy		#plst_reserved					lda		[plist_ptr],y					ldy		#plst_reserved+2					ora		[plist_ptr],y					bne		plfail												;												; make sure request count and data												; chain pointer are consistent with												; each other												;					ldy		#plst_dchainptr		;check data chain pointer for zero					lda		[plist_ptr],y					ldy		#plst_dchainptr+2					ora		[plist_ptr],y					bne		@100				;if data chain ptr zero then req count must = 0					ldy		#plst_reqxfr_cnt					ora		[plist_ptr],y					bne		plfail					ldy		#plst_reqxfr_cnt+2					ora		[plist_ptr],y					bne		plfail					beq		@150				;both zero go away@100				jmp		ckdcilst			;go check data chain inst list for stop inst												;												; we got here, the parameter list												; must be OK												;@150				clcplexit				rts							;>>>>---- I/O parameter list check --->>>												;												; failed parameter list check												;plfail				lda		#plist_error		;error for parameter list error					sta		|error_stat					sec					rts					ENDP						EJECT;*******************************************************;;	'callrtn';;	This routine will pass control to a routine defined;	in a address table for a specific interface type;;	Inputs:		e,m,x		=	0 (full native);				plist_ptr	=	points to the parameter list;				Acc			=	Routine Number to call;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	fast;;	Output:		All values are dependent on which;				routine was called.  Output will follow;				the definition for that routine.;;*******************************************************;					EXPORT	callrtncallrtn				PROC												;												; Generate offset for vector, get												; the long vector and call it.												;					asl		a					taycallit				lda		(addr_table_ptr),y					dec		a					pha					rts							;call the routine					ENDP						EJECT;*******************************************************;;	'scsi_irq_hand';;	This module will handle all interrupts which are;	generated by SCSI peripheral cards or internal scsi;	ports found during the "FIND_SCSI" subroutine call.;;	Inputs:		e,m,x		=	short m and x;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	undefined;				Stack		=	undefined;				Speed		=	undefined;;	Output:		e,m,x		=	ENTRY;				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	Error Code if any;				dpage		=	ENTRY;				Bank		=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;				Stack		=	ENTRY;;*******************************************************;					;EXPORT	scsi_irq_handscsi_irq_hand		PROC												;												;					php							;save m and x					sei							;disable being interupted												;												; Put in long m and x												;					LONGMX					phy							;save work registers					phx					phd							;save direct register					phb							;save data bank					phk							;point data bank to us					plb					lda		|our_zpg_hold		;point to our zero page					tcd												;												; save some variables we are												; about to clobber												;					lda		<io_offset			;save the 5380 registers address pointer					pha					jsr		save_work_vars		;save our work area in case irqed? ourselves		pha												;												; check the slots for nonzero												;					lda		#$FFFF				;assume not our irq					sta		|our_irq_flag					ldy		#$0000@100				tyx							;save index to start of io record					lda		[io_table_ptr],y	;see if scsi is source of irq					beq		@200				;if zero no card in this slot					tya							;point to the hardware base address					clc					adc		#scsi_base			;get the base address of the 5380					tay					lda		[io_table_ptr],y					sta		<io_offset							phx					ldx		<io_offset			;point to specific i/o space												;												; If it is a Bus Phase Mismatch IRQ,												; then just blow it off.  Otherwise,												; Treat it as a potential Disconnect/												; ReSelect event.												;					lda		>curbusstat,x		;look for Bus Phase Mismatch IRQ					and		#end_dma*256++\		;Port 5 bit 7							drq*256++\			;Port 5 bit 6							parityerr*256++\	;Port 5 bit 5							scsiirq*256++\		;Port 5 bit 4							phasematch*256++\	;Port 5 bit 3							busyerr*256++\		;Port 5 bit 2							ack*256++\			;Port 5 bit 0							rst++\				;Port 4 bit 7							bsy++\				;Port 4 bit 6							req++\				;Port 4 bit 5							sel					;Port 4 bit 1												;												; Only these bits should be set.  All the												; other bits used for the mask above must												; be equal to '0'.												;					cmp		#scsiirq*256++\		;Port 5 bit 4							bsy++\				;Port 4 bit 6							req					;Port 4 bit 5					bne		@chk_other_IRQs		;No Bus Phase Mismatch IRQ					SHORTM					lda		>resetirqreg,x		;Reset Bus Phase Mismatch IRQ					LONGM					plx							;That's all it was.  We're out of here!					stz		|our_irq_flag		;$0000 = serviced one of our IRQs					bra		irq_hand_exit		;service one card per interrupt@chk_other_IRQs		plx					and		#scsiirq*256		;check for scsi irq pending					beq		@200					jsr		serve_irq			;go service interrupt					stz		|our_irq_flag		;$0000 = serviced one of our IRQs					bra		irq_hand_exit		;service one card per interrupt@200				txa							;point to next i/O record					clc					adc		#iorec_size					tay							;check if beyond end of io table					cmp		#iotsize					bcc		@100irq_hand_exit		pla							;restore contents of i/o offset					sta		<io_offset					lda		|our_irq_flag		;flag <> 0 if our irq					pha							;save the value of the flag					jsr		rest_work_vars		;restore our working variables					pla							;restore flag of our irq service					plb							;restore environment					pld					plx							;restore work registers					ply					plp							;restore m and x					longa	off					cmp		#$01					rtl					longa	onserve_irq			phx							;save register					ldx		<io_offset			;point to i/o space					SHORTM						;m=1					lda		>resetirqreg,x		;reset the irq pending bit					LONGM						;m=0					plx							;restore register					rts							;very dumb handler so far!!					ENDP						EJECT;*******************************************************;;	'low_ptrs_init';;	This routine will setup source/dest and byte;	counters to optimize for data transfers.  The byte;	count is made 2's complement so it can double as;	byte counter and buffer index.  The buffer address;	will be modified to compensate for the change in the;	byte counter.  The routine sets things up to;	optimize the data transfers from the hardware into;	buffers and viceversa.  Transfers of very few bytes;	(5-20 bytes) will suffer some degradation but;	transfers of blocks will receive a major performance;	improvement.;	;	Inputs:		e,m,x		=	0 (full native);				buffer_ptr	=;				byte_ctr	=;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	fast;;	Output:		e,m,x		=	0 (full native);				buffer_ptr	=	undefined;				byte_ctr	=	undefined;				X reg		=	ENTRY;				Y reg		=	undefined;				dpage		=	Ours direct page;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	fast;				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	undefined;;*******************************************************;					EXPORT	low_ptrs_initlow_ptrs_init		PROC					sec							;2's complement low word of byte count					lda		#$0000				;to make counter incrementing and can					sbc		<byte_ctr			;double as source/destination pointer					tay							;save modified counter					php							;save 16 bit status (just want carry bit)					php					lda		#$0000					sbc		<byte_ctr+2			;high word of byte count					sta		<byte_ctr+2			;save high word of updated count					clc							;update source pointer to compensate byte count					lda		<buffer_ptr			;becoming 2's complement					adc		<byte_ctr						sta		<buffer_ptr						pla							;restore carry bit					and		#$0001					bne		@100				;if carry set don't subtract					lda		<buffer_ptr+2		;include possible borrow					sbc		#$0000							sta		<buffer_ptr+2@100				sty		<byte_ctr			;Y contains low word of byte count					rts							;>>>--- low_ptrs_setup --->>>					ENDP					EJECT;*******************************************************;;	'slow_down';;	This routine will read the setting of the system;	speed, save it away and then set the system slow.;	;	Inputs:		e,m,x		=	0 (full native);				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	undefined;;	Output:		e,m,x		=	0 (full native);				cyareg_hold	=	old setting of system speed;				X reg		=	ENTRY;				Y reg		=	ENTRY;				dpage		=	Ours direct page;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	SLOW;				Acc			=	undefined;;*******************************************************;					;EXPORT	slow_downslow_down			PROC					SHORTM						;m=1					lda		>cyareg				;read current setting					sta		<cyareg_hold		;save it					and		#<%01111111			;b7 = 0 slow down					sta		>cyareg				;write modified register					LONGM						;restore m					rts							;>>>--- slow_down --->>>					ENDP					EJECT;*******************************************************;;	'restore_cya';;	This routine will restore the contents of the cya;	register to the setting saved away by the slow_down;	routine in 'cya_hold'.;	;	Inputs:		e,m,x		=	0 (full native);				cyareg_hold	=	old setting of system speed;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	undefined;;	Output:		e,m,x		=	0 (full native);				X reg		=	ENTRY;				Y reg		=	ENTRY;				dpage		=	Ours direct page;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	Setting prior to last;								slowdown call;				Acc			=	undefined;;*******************************************************;					;EXPORT	restore_cyarestore_cya			PROC					SHORTM						;m=1					lda		<cyareg_hold		;restore setting of CYA reg					sta		>cyareg					LONGM						;restore m,x					rts							;>>>--- restore_cya --->>>					ENDP					EJECT;*******************************************************;;	'bind_scsi_irq';;	This module will install the scsi manage interrupt;	handler by issuing a BIND_IRQ system call to GS/OS;	to install the interrupt in its vectoring list.  The;	call will be issued as a stack based GS/OS call.;	;	Inputs:		e,m,x		=	0 (full native);				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	undefined;;	Output:		e,m,x		=	0 (full native);				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Ours direct page;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	ENTRY;				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	Error Code;;*******************************************************;					EXPORT	bind_scsi_irqbind_scsi_irq		PROC					PUSHLONG	#bind_irq_pblk	;bind parameter block					PUSHWORD	#bind_irq		;bind irq call number					jsl		stack_entry			;GS/OS stack based call entry point					bcc		@exit				;nobody happy					lda		#irq_install_err	;bad news!!					sta		|error_stat@exit				rts												;												; Parametre List for Bind IRQ Call												;bind_irq_pblk		dc.w	bind_pcount			;3 parameters					EXPORT	irq_idirq_id				dc.w	$0000				;our irq identifier returned here					dc.w	scsi_vrn			;SCSI Manager VRN					dc.l	scsi_irq_hand		;SCSI Manager interrupt handler					ENDP					EJECT;*******************************************************;;	'schedule_unbind';;	This routine will unbind the SCSI Manager interrupt;	handle from GS/OS either by doing it now if the;	System is not busy, ar by using the scheduler if it;	is busy.;	;	Inputs:		e,m,x		=	0 (full native);				irq_id		=	Irq to unbind;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	undefined;;	Output:		e,m,x		=	0 (full native);				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	ENTRY;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	ENTRY;				Carry		=	undefined;				Acc			=	undefined;;*******************************************************;					EXPORT	schedule_unbindschedule_unbind		PROC;					lda		>system_busy_flag		;Is the System Busy?;					bne		@shedule_it				;No.  Unbind IRQ.					jsl		unbind_scsi_irq			;Yes.  Set SCHEDULER to call unbind.					rts@shedule_it			PUSHWORD	#null				;Space for Result					PUSHLONG	#unbind_scsi_irq	;task_pointer					_SchAddTask										pla					rtsunbind_pblk			dc.w	unbind_pcount		;1 parameterunbind_irq_id		dc.w	$0000				;irq id to unbind					ENDP					EJECT;*******************************************************;;	'unbind_scsi_irq';;	This routine will unbind the SCSI Manager interrupt;	handle from GS/OS.;	;	Inputs:		e,m,x		=	0 (full native);				irq_id		=	Irq to unbind;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Our Direct page;				Stack		=	GS/OS stack space;				Speed		=	undefined;;	Output:		e,m,x		=	0 (full native);				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Ours direct page;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	ENTRY;				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	Error Code;;*******************************************************;					;EXPORT	unbind_scsi_irqunbind_scsi_irq		PROC					lda		|gsos_zpg_hold	coldst				tcd							;save GS/OS zero page address (will need later)					pea		#0000					plb					plb					lda		>irq_id					jsl		eunich_vect										phk					plb					lda		|our_zpg_hold		;point to our zero page					tcd					rtl;					lda		>irq_id				;setup our irq id;					sta		>unbind_irq_id;;					PUSHLONG	#unbind_pblk	;parameter block;					PUSHWORD	#unbind_irq		;class 1 unbind irq;;					jsl		stack_entry			;GS/OS stack based call entry point;;					rtl;;unbind_pblk			dc.w	unbind_pcount		;1 parameter;unbind_irq_id		dc.w	$0000				;irq id to unbind;					ENDP					EJECT;*******************************************************;;	'find_scsi';;	This routine will check 16 slots for the presence of;	SCSI cards/ports It calls 'DYN_SLOT_ARBITER' with;	the accumulator containing the slot number sought.;	If the slot is found then it PROCeeds to check for;	SCSI signatures and card/port type (old scsi card vs;	new).  The routine builds a I/O table which contains;	information about each of the scsi cards or ports;	found.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				error_stat		=	error code to report;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					EXPORT	find_scsifind_scsi			PROC					stz		<numscsi_cards		;reset total cards found count					ldy		#slot7ext			;start with slot 7 external					sty		<slot_no			;save the slot number					jsr		set_iorec_ptr		;form pointer for this slot's I/O record					bra		find_loop_altfind_scsi_loop		lda		<iorec_ptr			;point to next lower record					sec					sbc		#iorec_size						sta		<iorec_ptrfind_loop_alt		lda		<slot_no			;get the slot number					jsl		slot_arbit			;check with the slot arbitrator					bcs		not_scsi_card		;mark no card available					jsr		smartp_scsi_chk		;check if smartport scsi implementation					bcs		not_scsi_card					jsr		chk_scsi_type		;check type of scsi card					bcc		next_slotnot_scsi_card		lda		#$0000				;marks not valid cardset_slot			ldy		#slot				;point to slot field					sta		[iorec_ptr],y		;set slot number slot numbernext_slot			dec		<slot_no			;next lower slot					bpl		find_scsi_loop						lda		#no_scsi_hardware	;assume  no cards will be found					sta		|error_stat			;assume no scsi cards found					lda		<numscsi_cards		;will contain total scsi card found count					beq		find_scsi_exit		;assume no cards found					ldy		#bres_ready_del		;give scsi devs 275 millisecs to come ready					jsr		millisec_delay		;after scsi bus reset cycle					stz		|error_stat			;report success (cards found)find_scsi_exit		lda		|error_stat			;check for no scsi hardware error					cmp		#$0001				;set carry if no cards					rts							;>>>--- find_scsi --->>>					ENDP							EJECT;*******************************************************;;	'chk_scsi_type';;	This routine will check the scsi card type looking;	for valid APPLE scsi cards and ports.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				iorec_ptr		=	I/O Record Pointer;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	chk_scsi_typechk_scsi_type		PROC					lda		#num_dev_types		;check for valid scsi card/port type					bra		@150				;types go from $0000@100				sta		ahold				;save type					asl		a					;times 4 for 32 bit table ENTRY					asl		a					tay					lda		|addr_tables,y		;point to proper address table for dev type					sta		<addr_table_ptr					lda		|addr_tables+2,y					sta		<addr_table_ptr+2					lda		#hwdchk				;check card type routine					jsr		callrtn				;call_routine through address table					bcc		@200				;carry clear = found it & I/O record was setup					lda		ahold				;restore type@150				dec		a					;decrement type					bpl		@100@200				rts							;>>>--- check_scsi_type --->>>							ENDP					EJECT;*******************************************************;;	'set_iorec_ptr';;	This module sets up the iorec_ptr to a given value;	based on the contents of SLOT_NO.;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	slot number;				Y reg			=	undefined;				dpage			=	Our direct page;				Stack			=	GS/OS stack space;				Speed			=	fast;;	Output:		e,m,x			=	0 (full native);				io_rec_ptr		=	address of I/O record;									corresponding to slot_no;				X reg			=	ENTRY;				Y reg			=	undefined;				Carry			=	0 for successful call;				Acc				=	Error code or supervisor;									driver number;				dpage			=	Our direct page;				Stack			=	GS/OS stack space;				Speed			=	fast;		;*******************************************************;					EXPORT	set_iorec_ptrset_iorec_ptr		PROC					lda		#slot0					clc							;bump by increments of iorecsize@100				adc		#iorec_size					dey					bne		@100					clc							;include address of I/O table					adc		<io_table_ptr					sta		<iorec_ptr					lda		<io_table_ptr+2		;set I/O record pointer					sta		<iorec_ptr+2					rts					ENDP					EJECT;*******************************************************;;	'init_sdr_tbl';;	This routine sets up the SDR for a specific scsi;	logical unit found on the SCSI bus.  If the number;	of default SDRs built exceeds the number the number;	of default SDRs space a SetHandleSize call will be;	made to grow our work  area.  If we must grow our;	work area, it increases by enough bytes to allocate;	8 SDRs (4 pages of memory).;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				slot_no			=	peripheral card/port slot no.;				inqb_ptr		=	pointer to inquiry buffer containing data;				scsi_mem_ptr	=	pointer to our work area;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;				SDRs will be built for each logical;				device found;;	Errors:		See Error Listing on Equates file;;*******************************************************;					EXPORT	init_sdr_tblinit_sdr_tbl		PROC												;												; find SCSI devices & types by Issuing												; an Inquiry call												;					lda		#no_scsi_devs					sta		|devices_found		;assume we do not find any targets					ldy		#slot0				;check slot 0 through slot F@100				lda		[io_table_ptr],y	;check the slot number for $0000					beq		@200					phy					tay							;save slot number					jsr		set_iorec_ptr		;point to i/o record for this slot					jsr		setup_work_vars		;setup working variable from i/o record					ply							;point at start of I/O record					phy					jsr		scan_scsi_devs		;go look for scsi devices					ply@200				tya							;point to next I/O record					clc					adc		#iorec_size					cmp		#iotsize			;see if all records checked					tay							;next record index					bcc		@100					lda		|devices_found		;assume no devices found					bne		exit					jsr		id_assignment		;walk through the SDR table assigning IDs					bcs		errexitexit				clcerrexit				rts					ENDP							EJECT;*******************************************************;;	'setup_work_vars';;	This routine will copy several parameters from a;	given I/O record into several working variables.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;		The following variables loaded from the;		I/O record;				io_offset		=	long word;				dma_offset		=	long word;				io_attrbs		=	word;				init_priority	=	word;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	setup_work_varssetup_work_vars		PROC					ldy		#slot					lda		[iorec_ptr],y		;check for slot/port present					sta		<slot_no			;save the slot number					jsl		slot_arbit			;enable this slot if we can					ldy		#hwd_type					lda		[iorec_ptr],y		;get hardware type					sta		|hwd_version					ldy		#scsi_base					lda		[iorec_ptr],y		;point to base address of scsi controller					sta		<io_offset					ldy		#scsi_bank					lda		[iorec_ptr],y		;high word of scsi controller io address					sta		<io_offset+2					ldy		#dma_base					lda		[iorec_ptr],y					sta		<dma_offset					ldy		#dma_bank					lda		[iorec_ptr],y					sta		<dma_offset+2					ldy		#io_attrbs			;point to hardware attributes					lda		[iorec_ptr],y					sta		|ioattrbs					ldy		#initpriot					lda		[iorec_ptr],y					sta		|init_priority												;												; point to card's address table												;					phx					lda		|hwd_version		;get hardware type					asl		a					asl		a					tax					lda		|addr_tables,x		;pointer to this interface routines addr table					sta		<addr_table_ptr					lda		|addr_tables+2,x					sta		<addr_table_ptr+2					plx					rts					ENDP						EJECT;*******************************************************;;	'check_logicals';;	This module will check logical units which may exist;	under SCSI devices.  Checking is done by issuing a;	scsi Inquiry call to scsi device IDs. The call will;	request 256 bytes of data and save it away.  When;	the Inquiry call is made to the next logical unit the;	data returned by that call will be compared against;	the data saved away.  If they match then the current;	Logical unit will not have a SDR built for it.  Also,;	there will be no further scanning of logical units;	under this scsi device ID.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		Those from 'call_target';;*******************************************************;					;EXPORT	check_logicalscheck_logicals		PROC					stz		<dev_id				;fake the find_sdr routine					stz		|last_acc_id2					stz		|lutemp				;logical units for device temp flags (assume all ok)					stz		|ckluflag			;$FFFF marks when we have 2 inq buffers to compare					stz		<logunit			;logical unit #0-7					stz		|ident_modify		;Disconnect Flag												;												; setup some variables so we can issue												; find_sdr subroutine call												;					lda		<slot_no			;set the slot number					sta		|last_acc_slot2					sta		|tu_slot					sta		|inq_slot			;in the parameter list					sta		|sense_slot					lda		#lu0				;check Logical units 0-7 (in scsi packet form)					SHORTM						;m=1 					sta		|tulunit			;logical unit for test unit ready parameter list 					sta		|inq_lunit			;logical unit number in inquiry cmd packet  					sta		|sense_lunit		;logical unit number in req_sense cmd packet					LONGM						;m=0checklu				ldx		#tu_slot			;point to test unit ready parameter list					ldy		#^tu_slot					jsr		set_plist					jsr		calltarget			;issue call to the target (ignore status from target)					ldx		#inq_slot			;point to inquiry paramter list					ldy		#^inq_slot			;get our bank address					jsr		set_plist			;set parameter list					jsr		calltarget			;issue call to the target					bcs		errexit				;go away if error												;												; check if inquiry call succeeded												;					lda		|scsi_status		;scsi status & message byte must be zero if ok					ora		|scsi_message					beq		@125				;good call go mark it in the list												;												; inq call failed figure out why												;					jsr		get_plist			;save old parameter list pointer					phy					phx					ldx		#sense_slot			;point to request sense parameter list					ldy		#^sense_slot		;get our bank address					jsr		set_plist			;set parameter list					jsr		calltarget			;issue call to the target					plx							;point back to inquiry parameter list					ply					jsr		set_plist					lda		|scsi_status		;see if request sense failed					bne		@150					lda		|sense_buff			;get the error class					and		#$007F				;mask off the valid bit					cmp		#$0070				;check for class 7 code $00					bne		@150				;class was not 7 or code <> zero					lda		|sense_buff+2		;get the sense key and check if device really exists					and		#$000F				;keep the sense key only					beq		@125				;we are ok mark device as existing					cmp		#$0001				;check for recovered error					beq		@125					cmp		#$0006				;check for unit attention					bne		@150@125				lda		|inq_buff			;check first byte for lu not supported ($7F)					and		#$00FF					cmp		#lunotavail					bne		@200@150				ldy		|inq_lunit			;get the LU #					jsr		setnoscan			;LU not available (don't scan for it again)					jsr		nextlu					bne		@150				;once an lu fails mark remaining LUs not available					beq		exit				;for this SCSI ID												;												; Mark LU online & build SDR												;@200				ldy		|inq_lunit			;mark this LU online					jsr		setonline					jsr		build_sdr			;build an SDR for this LU (may get tossed later)					stz		|devices_found		;we have a scsi target online												;												; **** TEST CODE ****												; Eleiminate support for multiple LUs.												;					bra		@275@250				ldy		|inq_lunit			;get the LU #					jsr		setnoscan			;LU not available (don't scan for it again)@275				jsr		nextlu					bne		@250				;once an lu fails mark remaining LUs not available					beq		exit				;for this SCSI ID;					jsr		nextlu;					beq		exit				;for this SCSI ID;					brl		checklu												;												; **** TEST CODE ****												; Eleiminate support for multiple LUs.												;exit				lda		|lutemp				;get the logical unit bit mapping					clcerrexit				rts												;												; This module contains a canned												; packet for test unit ready call												;tu_slot				dc.w	$0000				;slot number					dc.w	$0000				;id field					dc.w	$0000				;parameter list version					dc.w	$0000				;flags					dc.w	$0008				;give call 2 seconds to complete					dc.l	$00000000			;completion vector					dc.l	tuscmd				;pointer to scsi test unit ready												; command packet					dc.l	$00000000			;no byte count returned					dc.l	$00000000			;message buffer pointer					dc.l	$00000000			;reservedtuscmd				dc.b	$00					;command number					EXPORT	tulunittulunit				dc.b	$00					;no data coming back					dc.l	$00000000			;4 bytes of zero												;												; This module contains the parameter												; list for the Inquiry call made to												; interrogate devices on the scsi bus												; when building the SDRs.												;inq_slot			dc.w	$0000				;low  word of 32 bit device ID field					dc.w	$0000				;id = $0000					dc.w	$0000				;parameter list version					dc.w	$0000				;flags					dc.w	$0004				;1 sec Timeout					dc.l	$00000000			;no completion vector					dc.l	inqcmd				;scsi command pointer					dc.l	dcstruc				;data chaining instructions					dc.l	$00000040			;request 8 bytes					dc.l	$00000000			;message buffer pointer					dc.l	$00000000			;reservedinqcmd				dc.b	$12					;inquiry command					EXPORT	inq_lunitinq_lunit			dc.b	$00					;b7-b5 = Logical unit, b4-b0 = reserved					dc.b	$00					;reserved					dc.b	$00					;reserved					dc.b	$08					;8 bytes of data requested					dc.b	$00					;Vendor unique & flag & link bitsdcstruc				dc.l	inq_buff			;inquiry buffer address					dc.l	inq_end-inq_buff	;byte count to request					dc.l	$00000000			;number to add to buffer address					dc.l	$00000000			;save inquiry pointer area												;												; This module contains the parameter												; list for the Inquiry call made to												; interrogate devices on the scsi bus												; when building the SDRs.												;					EXPORT	sense_slotsense_slot			dc.w	$0000				;low  word of 32 bit device ID field					EXPORT	senseidsenseid				dc.w	$0000				;id = $0000					dc.w	$0000				;parameter list version					dc.w	$0000				;flags					dc.w	$0010				;give the call 16 secs to complete					dc.l	$00000000			;completion vector					dc.l	sense_cmd			;scsi command pointer					dc.l	sensebstruc			;DC instructions for request sense					dc.l	$00000004			;request 4 bytes					dc.l	$00000000			;autosense buffer pointer					dc.l	$00000000			;message buffer pointer					dc.l	$00000000			;reservedsense_cmd			dc.b	$03					;request Sense					EXPORT	sense_lunitsense_lunit			dc.b	$00					;b7-b5 = Logical unit, b4-b0 = reserved					dc.b	$00					;reserved					dc.b	$00					;reserved					EXPORT	sensecnt0sensecnt0			dc.b	$00					;forces 4 bytes of request sense data					dc.b	$00					;Control byte					EXPORT	sensebstrucsensebstruc			dc.l	sense_buff			;sense buffer					EXPORT	sensecnt1sensecnt1			dc.l	$00000000			;sense byte count requested					dc.l	$00000000			;number to add to buffer address					dc.l	$00000000			;save inquiry pointer area					dc.l	$00000000			;DCStop Area					dc.l	$00000000			;DCStop Area					dc.l	$00000000			;DCStop Area					dc.l	$00000000			;DCStop Area					;EXPORT	sense_buffsense_buff			ds.b	$04					;24 byte buffer for request sense & inq calls					EXPORT	inq_buff					EXPORT	inq_endinq_buff			ds.b	$40					;40 byte inquiry bufferinq_end					ENDP					EJECT;*******************************************************;;	'calltarget';;	This routine issues a call to a target device and;	returns with the SCSI status and scsi message bytes;	set to what the target returned.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	Low word of parameter list address;				Y reg			=	High word of parameter list address;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				|scsi_status	=	status byte returned by the target;				|scsi_message	=	message byte returned by the target;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined ;				Carry			=	0 for successful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	calltargetcalltarget			PROC					jsr		get_plist			;get the parameter list for this call					jsr		setzpgvars			;setup zero page work variables					jsr		find_sdr			;find a scsi device record to match					bcs		errexit												;												; initialize more DCI instructions flag												;					lda		#$FFFF					sta		|more_dci												;												; go access the target												;					lda		#arbph				;go arbitrate for control of scsi bus					jsr		callrtn					bcs		errexit				;go away if an error occurs					lda		#selectph			;select the target device					jsr		callrtn					bcs		errexit				;go away if an error occurs					lda		#setup					jsr		callrtn					lda		#phase_hand			;phase handler for old scsi card					jsr		callrtn					stz		|busy_sdr_count		;compensate for decrement in the msg completeerrexit				rts					ENDP					EJECT;*******************************************************;;	'nextlu';;	This routine will bump the logical unit ID work;	fields and decide if it has rolled past LU 7.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				|inq_lunit		=	MODIFIED;				|tulunit		=	MODIFIED;				|sense_lunit	=	MODIFIED;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	0 for successful call;				Z Bit			=	1 if rolled past LU 7;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	nextlunextlu				PROC					SHORTM						;m=1												;												; see if lu 7 checked												;					inc		<logunit			;logical unit number 0-7					lda		|inq_lunit					clc					adc		#lu1					sta		|tulunit			;update the test unit ready cmd packet					sta		|inq_lunit			;update inquiry cmd packet					sta		|sense_lunit		;update req_sense cmd packet					LONGM						;m=0					rts					ENDP					EJECT;*******************************************************;;	'build_sdr';;	This routine builds the SCSI device records for each;	logical unit found in the system.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	build_sdrbuild_sdr			PROC												;												; allocate next SDR record												;					jsr		alloc_nxt_sdr		;get the address for the next SDR					bcs		exit					sty		<sdr_ptr+2					sta		<sdr_ptr												;												; device type from inquiry buffer												;					lda		|inq_buff\							+inq_devtype		;get the device type & standard version					and		#$00FF				;low byte only					ldy		#sdr_devtype					sta		[sdr_ptr],y												;												; scsi standard version												;					lda		|inq_buff\							+inq_version					and		#$00FF				;low byte only					ldy		#sdr_standard_vers					sta		[sdr_ptr],y												;												; mark removeable bit in attributes												;					ldy		#sdr_flags			;point to LU attributes word					lda		inq_buff+inq_rmb	;check for removeable media					and		#scsi_rmb			;bit 7 only					beq		@50					lda		#sdr_attrb_rmb		;mark removeable bit in SDR					ora		[sdr_ptr],y					sta		[sdr_ptr],y												;												; save Slot, Device priority,												; Initiator priority & logical unit												; in SDR												;@50					phx									ldy		#sdr_logunit					lda		<logunit			;our logical unit number					sta		[sdr_ptr],y					ldy		#sdr_targ_priot		;target priority					lda		|target_priority					sta		[sdr_ptr],y					ldy		#sdr_init_priot		;initiator priority					lda		|init_priority					sta		[sdr_ptr],y					ldy		#sdr_slot			;slot number					lda		<slot_no					sta		[sdr_ptr],y												;												; copy parameters from the scsi io												; record into the SDR												;					ldy		#scsi_base			;point to the hardware addr in io record					lda		[iorec_ptr],y					ldy		#sdr_5380_base					sta		[sdr_ptr],y					ldy		#scsi_base+2					lda		[iorec_ptr],y					ldy		#sdr_5380_base+2					sta		[sdr_ptr],y					ldy		#dma_base			;dma controller base address						lda		[iorec_ptr],y					ldy		#sdr_dma_base					sta		[sdr_ptr],y					ldy		#dma_base+2						lda		[iorec_ptr],y					ldy		#sdr_dma_base+2		;write them into the SDR					sta		[sdr_ptr],y					inc		<sdrsonline			;bump the number of SDRs in the table					plxexit				rts					ENDP					EJECT;*******************************************************;;	'scan_scsi_devs';;	This module scans a particular scsi slot or scsi;	built-in port for SCSI devices online.  The scsi;	devices are checked from scsi dev 7 through scsi dev;	0.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined ;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	scan_scsi_devsscan_scsi_devs		PROC					jsr		chkbusfloat			;check for floating scsi bus					bcs		scexit				;if floating, we are done here					lda		#scsi_prior7		;start with priority 7					sta		|target_priority					ldy		#d7logicals			;start at scsi device 7					bra		chkdupscloop				jsr		check_logicals		;check logical units (A=$FFFF no logicals)					bcc		setd				;C=0 if scsi device found	duplic				lda		#no_device			;assume no scsi device found	setd				ldy		|yhold				;restore device number					sta		[iorec_ptr],y					dey							;point to next scsi device table ENTRY					dey					stz		|error_stat			;clear possible select error from no targetskipp				lsr		|target_priority	;set for next priority					bcs		scexit	chkdup				sty		|yhold				;save the table index					lda		|init_priority		;if target = initiator priority skip it					cmp		|target_priority					beq		duplic				;skip this one					bra		scloopscexit				rts					ENDP							EJECT;*******************************************************;;	'save_work_vars';;	This routine will save our working variables into a;	holding buffer.;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Stack			=	undefined;				Bank			=	undefined;				Speed			=	undefined;;	Output:		e,m,x			=	ENTRY;				X reg			=	ENTRY;				Y reg			=	ENTRY;				Carry			=	undefined;				Acc				=	ENTRY;				dpage			=	ENTRY;				Stack			=	ENTRY;				Bank			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	save_work_varssave_work_vars		PROC					phx							;save registers					pha					ldx		#work_vars_sizesave_loop			lda		|scsi_variables,x	;save a piece of GS/OS zero page					sta		|work_vars_buffer,x					dex					beq		save_loop					dex					bpl		save_loop					pla							;restore registers					plx					rts							;>>>--- save work_vars --->>>					ENDP					EJECT;*******************************************************;;	'rest_work_vars';;	This routine will restore our work variables into;	their respective locations from a holding buffer;	used to copy them into during an IRQ;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Stack			=	undefined;				Bank			=	undefined;				Speed			=	undefined;;	Output:		e,m,x			=	ENTRY;				X reg			=	ENTRY;				Y reg			=	ENTRY;				Carry			=	undefined;				Acc				=	ENTRY;				dpage			=	ENTRY;				Stack			=	ENTRY;				Bank			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	rest_work_varsrest_work_vars		PROC					phx							;save registers					pha					ldx		#work_vars_sizerestore_loop		lda		|work_vars_buffer,x					sta		|scsi_variables,x	;restore a piece of zero page					dex					beq		restore_loop					dex					bpl		restore_loop					pla							;restore registers					plx					rts							;>>>--- restore work vars --->>>							ENDP					EJECT;*******************************************************;;	'smartp_scsi_chk';;	This routine checks for smartport SCSI devices;	signatures.;;		$CN01	=	$20;		$CN03	=	$00;		$CN05	=	$03;		$CN07	=	$00;;	and if match then checks;;		$CNFB bit 1 = 1 signifying a SCSI Smartport;		device;;	If the above criteria is met then a check against;	part of the rom image will be made and if a match is;	found then it is assumed that the card is an old;	Apple II scsi card.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				slot_no			=	slot number to check;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	ENTRY;				Y reg			=	ENTRY;				Acc				=	undefined;				1.	Carry		=	0 and;					Overflow	=	0 old apple scsi card;				2.	Carry		=	1 and;					Overflow	=	x not scsi card;				3.	Carry		=	0 and;					Overflow	=	1 scsi card but not old Apple;									scsi card;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	smartp_scsi_chksmartp_scsi_chk		PROC					phx							;save registers					phy					lda		<slot_no			;get slot number					and		#slot7				;mask off internal/external bit					xba							;times $100					tax							;index for soft switches					SHORTM					lda		>io_space+1,x		;check $00CN01 = $20					cmp   	#$0020					bne		@100				;go away if no match					lda		>io_space+3,x		;check $00CN03 = $00					bne		@100				;go away if no match					lda		>io_space+5,x		;check $00CN05 = $03					cmp		#$0003					bne		@100				;go away if no match					lda		>io_space+7,x		;check $00CN07 = $00					bne		@100				;go away if no match					lda		>io_space+$FB,x		;check $00CNFB bit 1					and		#%0000000000000010	;bit 1 must be one for scsi					bne		@200@100				sec							;C=1 (not scsi card)					bcs		@300@200				clc							;C=0 (scsi card)@300				LONGM					ply							;restore registers					plx					rts							;>>>-- check_slot --->>>					ENDP					EJECT;*******************************************************;;	'millisec_delay';;	This routine will delay a number of milliseconds;	specified by the contents of the A register.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	delay count 1-65536;									($0000=65536 millisecs);				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	null;				Y reg			=	null;				Acc				=	undefined;				Carry			=	ENTRY;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					;EXPORT	millisec_delaymillisec_delay		PROC					php							;save m,x, and IRQ					sei							;no interruptions					SHORTM						;m=1					lda		>cyareg				;get cya register contents					pha					and		#<%01111111			;slow the system down					sta		>cyareg					pla							;keep old cya register settingdelay_millisec		ldx		#millisec_count		;1 millisecond delay countmillis_del_loop		dex							; 2 cycles					bne		millis_del_loop		; 3 (2 if branch fails)					dey					bne		delay_millisec		;keep delaying until zero					sta		>cyareg				;restore cya register					longa	on					;Fix Assembler					plp							;restore m,x, and IRQ					rts					ENDP					EJECT;*******************************************************;;	'setzpgvars';;	This routine will setup all the zero page pointers;	to access the parameters list provided by the device;	driver.  Also, the routine validates the parameter;	list and initializes internal work variables.  This;	routine will work for SCSI_IO call only!;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	Low parm list ptr from caller;				Y reg			=	High parm list ptr from caller;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None;;*******************************************************;					EXPORT	setzpgvarssetzpgvars			PROC												;												; copy parameters into work variables												;					stx		<plist_ptr					sty		<plist_ptr+2					ldy		#plst_slot			;get the ID of the device (slot & unit number)					ldx		#0000				;destination index@100				lda		[plist_ptr],y		;get the ID of device sought					sta		<zpgwptrs,x					inx					inx					iny					iny					cpy		#wptrssize			;check if all pointers moved					blt		@100													;												; clear parameter list request count												; need field for transfer count												;@150				ldy		#plst_reqxfr_cnt	;clear parameter list request count					lda		#$0000				;a copy of the request count saved in zpg					sta		[plist_ptr],y					ldy		#plst_reqxfr_cnt+2					sta		[plist_ptr],y												;												; initialize the DC PC to start of data												; chain instructions												;					lda		<dclst_ptr					sta		<dc_pc					lda		<dclst_ptr+2					sta		<dc_pc+2					clc					rts						ENDP						EJECT;*******************************************************;;	'get_plist';;	This routine gets the address of the parameter list;	address from the SIB.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	Low word of parm list addr;				Y reg			=	High word of parm list addr;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None;;*******************************************************;					EXPORT	get_plistget_plist			PROC					ldx		|gsos_zpg_hold		;point to GS/OS zero page					lda		>sib_plptr+2,x					tay					lda		>sib_plptr,x		;get address of parameter list					tax					rts					ENDP					EJECT;*******************************************************;;	'set_plist';;	This routine sets the address of the parameter list;	address in the SIB.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	Low word of parm list addr;				Y reg			=	High word of parm list addr;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	ENTRY;				Acc				=	undefined;				Carry			=	ENTRY;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					EXPORT	set_plistset_plist			PROC					txa					ldx		|gsos_zpg_hold		;point to GS/OS zero page					sta		>sib_plptr,x		;set address of parameter list					tya					sta		>sib_plptr+2,x					rts					ENDP						EJECT;*******************************************************;;	'find_sdr';;	This module will walk compare the slot & scsi device;	id against the IDs of each scsi device record;	looking for a match.  If the ID is found sdr_ptr;	will be set with the address of this scsi device;	record.  If it is not found carry will be set to;	signify an error.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				|dev_id			=	id sought;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	index to start of specific;									I/O record;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	low word of SDR record address;				X reg			=	low word of SDR record address;				Acc				=	high lword of SDR record address;								=	Error Code if Carry Set;				Carry			=	0;								=	1 if no ID found;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		See Error Listing on Equates file;;*******************************************************;					EXPORT	find_sdrfind_sdr			PROC					lda		|last_acc_slot2		;get last accessed slot number					cmp		<dev_slot					bne		@100				;check alternate accessed slot field if no match					lda		|last_acc_id2					cmp		<dev_id					bne		@100				;check alternate accessed id field					ldy		|last_sdr_ptr2					lda		|last_sdr_ptr2+2					bra		@setsdr				;set the pointer for the sdr record@100				lda		|last_acc_slot1		;get the id sought					cmp		<dev_slot			;compare against last accessed slot					bne		@200				;check alternate accessed slot field if no match					lda		|last_acc_id1						cmp		<dev_id					bne		@200					ldy		|last_sdr_ptr1					lda		|last_sdr_ptr1+2					bra		@setsdr				;set the pointer for the sdr record@200				lda		<sdr_table_ptr+2	;form work pointer					sta		<sdr_ptr+2					lda		<sdr_table_ptr					sta		<sdr_ptr					lda		<sdrsonline			;number of sdrs to check					sta		<sdrstocheck@300				ldy		#sdr_slot			;point to the slot number in this SDR					lda		[sdr_ptr],y					cmp		<dev_slot			;compare against sought slot					bne		@325					ldy		#sdr_device_id		;point to ID field within SDR					lda		<dev_id				;get the device ID					cmp		[sdr_ptr],y			;compare IDs					beq		@400@325				ldy		#$0002				;get address to next SDR					lda		[sdr_ptr],y					pha					lda		[sdr_ptr]					sta		<sdr_ptr					pla					sta		<sdr_ptr+2					dec		<sdrstocheck					bne		@300@nosdr				stz		|last_acc_id1		;clear both last_acc_id fields					stz		|last_acc_id2					lda		#bad_scsi_id		;report an error					sta		|error_stat					sec							;mark bad id					rts												;												; return the address of the SDR												;@400				ldx		|last_acc_flag		;get last access flag/index					lda		<dev_slot			;slot number					sta		|last_acc_slot1,x	;save the slot number					lda		<dev_id					sta		|last_acc_id1,x		;save the id of this field					lda		<sdr_ptr			;get the address of the SDR					sta		|last_sdr_ptr1,x					tay					lda		<sdr_ptr+2					sta		|last_sdr_ptr1+2,x												;												; toggle the accessed flag so we												; know which pointer to change next												; time we do not find the slot &												; unit we seek.												;					pha							;save high word of sdr address					txa							;toggle the flag & form new index					eor		#last_acc_id2\							-last_acc_id1					sta		|last_acc_flag		;save the flag/index for next time					pla@setsdr				clc							;mark successendfsdr				rts						ENDP					EJECT;*******************************************************;;	'priot_to_dev';;	This routine will convert a scsi priority number;	into a scsi device number.  For example scsi;	priority $80 = $07.;;	NOTE:	This routine will hang in an infinite loop if;			priority = $0000;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	scsi priority to convert;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	scsi device number;				Y reg			=	undefined;				Acc				=	scsi device number;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		ID '0' Passed;;*******************************************************;					EXPORT	priot_to_devpriot_to_dev		PROC					sec							;Preload Error					and		#$00FF				;priority $80-$01 only					beq		@rts					clc					ldx		#$0007				;start with scsi device $0007					xba							;in high byte of accumulator@100				asl		a					;shift scsi priority into carry					bcs		@200					dex					bra		@100@200				txa							;dev number in accumulator@rts				rts					ENDP						EJECT;*******************************************************;;	'getticks';;	This routine will check the timeout count for a;	value greater than $10000.  If the value is greater,;	it subtracts $FFFF from the value and returns with;	the accumulator set to $FFFF.  If the value is less;	than $10000, the accumulator will be set to the value;	of the low word of the timeout.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				[SDR_PTR]		=	record containing the timeout;									value to check;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	value of low timeout word.;								=	$FFFF if value in 32 bit timeout;									field greater than $10000;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None;;*******************************************************;					EXPORT	getticksgetticks			PROC												;												; check high word of timeout > $0000												;					ldy		#sdr_timeout+2					lda		[sdr_ptr],y					php												;												; get contents timeout low word then												; check if high word was zero												;					ldy		#sdr_timeout					lda		[sdr_ptr],y					plp					bne		@100				;high word was zero go away with low												;word contents												;												; clear low word of timeout count												;					pha					lda		#$0000					sta		[sdr_ptr],y					pla					rts							;go away												;												; subtract $FFFF from low word save												; result and adjust high word												;@100				sec					sbc		#$FFFF					sta		[sdr_ptr],y					ldy		#sdr_timeout+2		;point to high word of timeout					lda		[sdr_ptr],y					sbc		#$0000					sta		[sdr_ptr],y					lda		#$FFFF				;value to load into heartbeat header					rts					ENDP						EJECT;*******************************************************;;	'setonline';	'setnoscan';	'setlupatt';;	The next three routine will set the corresponding;	bit combinations in the logical unit field positions;	of each scsi I/O record.  There are three possible;	bit patterns which may be set for each logical unit.;;	Logical Unit Bitmap:;;		 F E D C B A 9 8 7 6 5 4 3 2 1 0;		+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;		|   |   |   |   |   |   |   |   |   SCSI Device N Logical unit bitmap;		+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+;		 LU7 LU6 LU5 LU4 LU3 LU2 LU1 LU0;;	Bit Pattern Definitions;		00	=	Unit needs scanning;		01	=	Logical unit online do not scan;		10	=	Currently selecting SCSI device for these;				8 logicals;		11	=	Logical unit not available (do not scan;				for it);;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	LU # to update in word pattern;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;;scanpatt			equ		$0000				;bit pattern for scan for logical unitonlinepatt			equ		$0001				;bit pattern for logical unit online;selecton			equ		$0002				;bit pattern for currently selecting scsi targetnotscanned			equ		$0003				;bit pattern for DO NOT scan for this LUlu_bit_code			PROC					EXPORT	setonlinesetonline			lda		#onlinepatt			;01 = LU online					bra		setlupatt					EXPORT	setnoscansetnoscan			lda		#notscanned			;11 = do not scan logical unitsetlupatt			phx					pha							;save the 2 bit pattern to write out					tya					and		#$00FF				;low byte only					lsr		a					;shift them to low 3 bits then times 2					lsr		a					lsr		a					lsr		a					tax							;index into mask table for LUs					lda		luptbl,x					ora		|lutemp					eor		luptbl,x			;two bits corresponding to LU # should be clear					sta		|lutemp					pla							;get pattern to write					cpx		#lu0					beq		@150				;don't shift if LU zero already@100				asl		a					;shift it into proper position					dex					bne		@100@150				ora		|lutemp				;set the appropriate bits					sta		|lutemp					plx					rtsluptbl				dc.w	$0003				;LU 0 pattern mask					dc.w	$000C				;LU 1 pattern mask					dc.w	$0030				;LU 2 pattern mask					dc.w	$00C0				;LU 3 pattern mask					dc.w	$0300				;LU 4 pattern mask					dc.w	$0C00				;LU 5 pattern mask					dc.w	$3000				;LU 6 pattern mask					dc.w	$C000				;LU 7 pattern mask					ENDP							EJECT;*******************************************************;;	'alloc_nxt_sdr';;	This routine returns the next SDR address available.;	If no space is available the routine will call the;	memory manager and request enough space for a;	specific number of SDRs.  If an error is returned;	from the memory manager the call exits with an error.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	High word of SDR address;				Acc				=	Low word of SDR address;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					;EXPORT		alloc_nxt_sdralloc_nxt_sdr		PROC					lda		<avail_sdrs				;if already zero then quit					bne		@100					lda		#sm_rsrc_err			;got an error from get handle call					sta		|error_stat					sec					rts												;												; get SDR address												;@100				lda		<next_sdr+2				;get the SDR address					pha					lda		<next_sdr					pha					dec		<avail_sdrs				;decrement number of available SDRs					beq		getmem					;had one left go allocate more space					clc								;bump to next SDR (cannot cross banks)					adc		#sdrrec_sizesetlink				sta		[next_sdr]				;form link address for next SDR					pha								;save low 16 bits of next sdr address					lda		5,s						;get the high word of the SDR address					inc		next_sdr					inc		next_sdr					sta		[next_sdr]					pla								;restore low 16 bits of next sdr address					sta		<next_sdr				;save next SDR address					bra		exitgetmem				lda		#default_sdrs			;assume we can get the memory for more sdrs					sta		<avail_sdrs					PUSHLONG	#null				;room for handle					PUSHLONG	#default_sdrs\								*sdrrec_size		;high word of number of bytes required					PUSHWORD	|user_id			;our ID					PUSHWORD	#attrlock++\		;Attributes of requested mem.								attrfixed++\								attrnocross++\								attrnospec++\								attrpage					PUSHLONG	#null				;address (not used in this call)					_NewHandle					pla								;get handle off the stack					ply					bcc		@100					lda		#$0000					sta		[next_sdr]					ldy		#$0002					sta		[next_sdr],y					lda		#sm_rsrc_err		;got an error from get handle call					sta		|error_stat					stz		<avail_sdrs			;could not get memory					bra		exit				;go away with last SDR address EVER!!!												;												; get pointer to new memory & form link												; to next available SDR												;@100				sta		<scratchzpg					sty		<scratchzpg+2					lda		[scratchzpg]					sta		[next_sdr]					pha							;save new low word of next SDR pointer					ldy		#$0002					lda		[scratchzpg],y					sta		[next_sdr],y												;												; form new Next_SDR address pointer &												; set avail_sdrs to default sdrs												;					sta		next_sdr+2					pla					sta		next_sdr												;												; clear newly allocated memory												;					phx					lda		#default_sdrs\							*sdrrec_size		;number of bytes to clear					ldx		next_sdr			;address of first location					ldy		next_sdr+2					jsr		clear_memory		;wipe the new memory					plx					dec		<avail_sdrs			;decrement available SDRsexit				pla							;get SDR address & quit					plyerrexit				rts					ENDP						EJECT;*******************************************************;;	'getnxtdci';;	This routine will get the pointer to the next DC;	instruction and return it to the caller.  The;	routine performs the following steps:;;		1.	Check if first instruction in DCP;			(data chaining packet);		2.	If first then;			a) reset DC PC;			b) setup working pointers;			c) clear first instruction flag;			d) jump back to getnxtdci;		3.	bump DC PC.;		4.	get first long word of instruction;		5.	If zero then go to DCSTOP;		6.	If -1 then go to DCLOOP;		7.	Must buffer address goto to Buffer handler.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					EXPORT	getnxtdcigetnxtdci			PROC					lda		<dc_pc				;data chain pc in terms of bytes					sta		<curr_dci_ptr		;form pointer to current DC instruction					lda		<dc_pc+2					sta		<curr_dci_ptr+2												;												; check for DCMOVE, DCLOOP & DCSTOP												; instructions												;					ldy		#dc_opcode			;start at the beginning of the instruction					lda		[curr_dci_ptr],y					pha							;save the instruction					ldy		#dc_opcode+2					ora		[curr_dci_ptr],y	;check for DCSTOP					bne		@over					brl		dcstop@over				lda		1,s					;check for DCLOOP					and		[curr_dci_ptr],y					cmp		#dc_loop_inst					beq		dcloop												;												; must be a buffer address												;					lda		[curr_dci_ptr],y	;get high word of buffer address					sta		<buffer_ptr+2					pla							;get low byte of buffer address					sta		<buffer_ptr					ldy		#dc_count			;get the byte count					lda		[curr_dci_ptr],y					sta		<byte_ctr					ldy		#dc_count+2					lda		[curr_dci_ptr],y					sta		<byte_ctr+2					clc					jsr		bump_addr			;add offset to address and save it					jsr		bump_pc				;bump the DCI prog counter												;												; Check the Buffer Address to see if												; this DCMove instruction will be out												; side the limits of DMA for this												; Machine Type.												;					clc					lda		<buffer_ptr					adc		<byte_ctr					lda		<buffer_ptr+2					adc		<byte_ctr+2					cmp		#$00E0					bge		@try_dma					pha					lda		>System_Type					cmp		#$0006					bge		@chk_10speed		;It's a ten-speed.  Let it go on.					pla					cmp		|rom_01				;Will the transfer end in bank					blt		@try_dma			;$42 or Greater?					bra		@do_pdma@chk_10speed		pla					cmp		|rom_03				;Will the transfer end in bank					blt		@try_dma			;$50 or Greater?@do_pdma			sep		#$40				;Set the V flag to disable DMA					clc					rts							;return to caller with address & count@try_dma			clv							;Clear the V flag to enable DMA					clc					rts							;return to caller with address & count												;												; DMA Range Storage												;					EXPORT		rom_01rom_01				dc.w	$0042					EXPORT		rom_03rom_03				dc.w	$0050												;												; Looping Data chaining instruction (DCLOOP)												;dcloop				pla							;discard low byte of instruction address					ldy		#dc_count			;get the number of passes through the loop					lda		[curr_dci_ptr],y	;bump past this instruction if zero					pha					ldy		#dc_count+2					lda		[curr_dci_ptr],y					ora		1,s					bne		deccnt				;otherwise decrement the loop count					jsr		bump_pc				;bump the DCI pc					pla							;discard working low word of loop count					brl		getnxtdci			;go back for another DC instruction												;												; decrement the loop count												;deccnt				pla					dec		A					;decrement the low word of the loop count					ldy		#dc_count			;get index to loop count					sta		[curr_dci_ptr],y	;save the low word of the count					bne		dcbra				;go to specified offset if nonzero					ldy		#dc_count+2					lda		[curr_dci_ptr],y					dec		A					sta		[curr_dci_ptr],y	;decrement high word of loop count					beq		goagain				;loop exausted see if more instructions												;												; loop not exausted get relative offset												; and branch												;dcbra				ldy		#dc_offset			;get the loop instruction offset					lda		[curr_dci_ptr],y	;low word of offset					sta		<scratchzpg			;offset times 16					ldy		#dc_offset+2					lda		[curr_dci_ptr],y					sta		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					clc					lda		<scratchzpg			;get low word of offset*16					adc		<dc_pc				;adjust the chaining inst. prog. counter					sta		<dc_pc					lda		<scratchzpg+2		;get high word of offset*16					adc		<dc_pc+2					sta		<dc_pc+2goagain				brl		getnxtdci			;go execute next instruction												;												; DCSTOP instruction handler												;dcstop				pla							;discard high word of instruction					iny							;point to 2nd long word of dcstop					iny					lda		[curr_dci_ptr],y	;check low 24 bits for nonzero (routine address)					iny					ora		[curr_dci_ptr],y	;check for DCSTOP					beq		@110				;a real DCSTOP instruction												;												; DCSPECIAL instruction												;					lda		[curr_dci_ptr],y	;get bits 8-23 of routine address					sta		@100+2				;self modify high byte of JSL address					dey					lda		[curr_dci_ptr],y	;get bits 0-15 of routine address					sta		@100+1				;self modify low word of JSL address@100				jsl		$00000000			;the user returns back to us or hell breaks loose					jsr		bump_pc				;bump the data chaining program counter					brl		getnxtdci			;go get the next instruction												;												; all done with DCSTOP instruction												;@110				stz		|more_dci			;reset more data chain instructions flagnodci				secexit				rts												;												; Bump the DCI program counter												;bump_pc				php					pha					lda		<dc_pc				;bump the data chain prog. counter					clc					adc		#dc_size			;bump by data chain intruction size					sta		<dc_pc					bcc		@100					inc		<dc_pc+2			;bump chaining program counter@100				pla					plp					rts												;												; ADD the contents of the offset field												; to the address field												;bump_addr			php							;save Carry					ldy		#dc_offset					lda		[curr_dci_ptr],y					ldy		#dc_opcode					clc					adc		[curr_dci_ptr],y					sta		[curr_dci_ptr],y	;write out the modified address					ldy		#dc_offset+2		;get high word of offset to add to the address					lda		[curr_dci_ptr],y					ldy		#dc_opcode+2					adc		[curr_dci_ptr],y					sta		[curr_dci_ptr],y					plp							;restore Carry					rts					ENDP					EJECT;*******************************************************;;	'smatch';;	Found a slot match adjust the link pointers and set;	the IDs;;	BEFORE:;			+-----------+	  +-----------+		+-----------+;	Head >>>|  SDR N-1  | >>> |   SDR N   | >>>	|  SDR N+1  |;			+-----------+	  +-----------+		+-----------+;;	AFTER:			;			+-----------+	  +-----------+		+-----------+;	Head >>>|  SDR  N   | >>> |  SDR N-1  | >>>	|  SDR N+1  |;			+-----------+	  +-----------+		+-----------+;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				scratchzpg		=	address of SDR N;				sdr_ptr			=	address of SDR N-1;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					;EXPORT		smatchsmatch				PROC					lda		<scratchzpg+2		;check for already in right order					eor		<sdr_ptr+2					bne		@100					lda		<scratchzpg					eor		<sdr_ptr					beq		assgnid@100				ldy		#$0002				;point to nxt_sdr_ptr field high word					lda		[scratchzpg],y		;SDR N+1 address into SDR N-1 link ptr					sta		[sdr_ptr],y					lda		[scratchzpg]					sta		[sdr_ptr]					lda		<sdr_table_ptr+2	;save pointer to head of list					pha					lda		<sdr_table_ptr					pha					lda		<scratchzpg+2		;write SDR N address in head link					sta		<sdr_table_ptr+2					lda		<scratchzpg					sta		<sdr_table_ptr					pla							;link SDR N to SDR N-1					sta		[scratchzpg]					pla							;restore high word of old sdr_table_ptr					sta		[scratchzpg],y												;												; Assign the IDs starting with $0001												;					EXPORT		assgnidassgnid				lda		<sdrsonline			;number of SDRs to assign IDs for					sta		<sdrstocheck					lda		<sdr_table_ptr+2					sta		<scratchzpg+2					lda		<sdr_table_ptr					sta		<scratchzpgnextid				ldy		#sdr_slot			;point to the slot field within the SDR					lda		[scratchzpg],y		;get the slot for this SDR					jsr		getnextID					ldy		#sdr_device_id		;point to ID field in SDR					sta		[scratchzpg],y					dec		<sdrstocheck					clc							;assume all done					beq		alldone				;count of zer means all doneonemore				ldy		#$0002				;point to link field					lda		[scratchzpg],y		;get address of next SDR					pha					lda		[scratchzpg]					sta		<scratchzpg					pla					sta		<scratchzpg+2					bra		nextidalldone				plx					rts					ENDP					EJECT;*******************************************************;;	'touthandler';;	This module will check for tasks which may be;	pending and have timed out.  The routine walks the;	SDR list and checks if the busy bit is set. If the;	bit is set then it decrements the timeout count.  If;	the count rolls to zero, the busy bit will be reset;	and a timeout error will be reported to the caller.;	;	Inputs:		e,m,x		=	undefined;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	undefined;				Stack		=	undefined;				Speed		=	undefined;;	Output:		e,m,x		=	ENTRY;				Carry		=	ENTRY;				Acc			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;				dpage		=	ENTRY;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	ENTRY;;*******************************************************					;EXPORT	touthandlertouthandler			PROC												;												; HeartBeat task header												;					EXPORT	tout_header					EXPORT	tick_counttout_header			dc.l	$00000000			;room for link pointertick_count			dc.w	$0000				;tick count before irq					dc.w	$A55A				;manual is wrong A55A signature correct												;												; save environment we will be playing with												;timeout				php							;save m and x					LONGMX					pha							;save registers					phx					phy					phd							;save direct register					phb					phk					plb												;												; point to our zero page												;					lda		|our_zpg_hold					tcd												;												; check for SDR Busy bit set												;					ldy		#sdr_flags					lda		[active_sdr],y					and		#sdr_attrb_busy					beq		exit												;												; SDR is busy decrement timeout												; count & check for zero												;					jsr		getticks					sta		|tick_count			;tick count before next irq					bne		exit												;												; go tell driver the call it issued												; timed out												;					ldy		#sdr_completion_vect;call the intercomm vector					lda		[active_sdr],y		;get address of completion vector					sta		calldvr+1			;form jsl address					iny					ora		[active_sdr],y					beq		exit				;Completion Vector already called					lda		[active_sdr],y					sta		calldvr+2												;												; mark SCSI Manager busy so drivers												; can not issue another call now												; then notify driver of the timeout.												;					lda		|smbusy_flag		;save current setting of SCSI Manager busy flag					pha					lda		#busy					sta		|smbusy_flag					lda		#calltout_err		;tell driver its call timed out					sec					sta		|error_stat			;and keep error for future referencecalldvr				jsl		$000000				;**** SELF MODIFYING CODE					jsr		clear_state			;remove this scsi transaction					dec		|busy_sdr_count		;one less busy SDR					ldy		#sdr_flags					lda		[active_sdr],y					and		#sdr_attrb_busy\							--$FFFF				;clear busy bit in attribute word					sta		[active_sdr],y												;												; restore state of SCSI Manager busy												; flag												;					pla					sta		|smbusy_flag												;												; all done set for next interrrupt												; (0000 is possible) and go away												;exit				plb					pld							;restore direct register					ply					plx					pla					plp					rtl					ENDP					EJECT;*******************************************************;;	'setup_call_env';;	This routine will copy all the work variables from;	the SCSI Device record into working variables.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				|plist_ptr		=	record matching the sought ID;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	Error Code ;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					EXPORT	setup_call_envsetup_call_env		PROC					ldy		#sdr_logunit		;logical unit					lda		[sdr_ptr],y					sta		<logunit					ldy		#sdr_targ_priot		;target priority					lda		[sdr_ptr],y					sta		|target_priority					ldy		#sdr_init_priot		;initiator priority					lda		[sdr_ptr],y					sta		|init_priority					ldy		#sdr_slot			;slot number					lda		[sdr_ptr],y					sta		<slot_no					ldy		#sdr_5380_base		;5380 I/O base address					lda		[sdr_ptr],y					sta		<io_offset					ldy		#sdr_5380_base+2					lda		[sdr_ptr],y					sta		<io_offset+2					ldy		#sdr_dma_base		;5380 DMA controller base address					lda		[sdr_ptr],y					sta		<dma_offset					ldy		#sdr_dma_base+2					lda		[sdr_ptr],y					sta		<dma_offset+2												;												; setup work flags etc...												;					lda		#$FFFF				;setup for possible DCI instructions					sta		|more_dci					rts					ENDP						EJECT;*******************************************************;;	'id_assignment';;	This routine will determine the boot slot and assign;	the SDR which contains the target with the highest;	scsi priority ID 1.  This way the boot continues from;	the same target when the SCSI driver got control.;	IDs are assigned based on slot number.  Each slot;	starts with ID 1 and increments for each device found;	on that slot.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				sdr_table_ptr	=	points to first SDR in table;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;			Each SDR contains an ID based on Slot &;			unit number.;;	Errors:		;;*******************************************************;					;EXPORT	id_assignmentid_assignment		PROC					phx							;save register					lda		<sdrsonline			;number of sdrs available					sta		<sdrstocheck					bne		@100					plx					rts							;say goodnight!!@100				lda		<sdr_table_ptr		;point to the start of the SDR table					sta		<scratchzpg					lda		<sdr_table_ptr+2					sta		<scratchzpg+2												;												; issue get_dib_ptr call for unit												; one to find boot slot number												;					phd							;save our zero page					lda		|gsos_zpg_hold		;point to GS/OS zero page					tcd					pei		<drvr_dib_ptr+2		;save the driver dib pointer					pei		<drvr_dib_ptr					pei		<dev_id_ref			;save the id reference number					pei		<drvr_dev_num		;save current device number					stz		<drvr_dev_num		;select device dispatcher					lda		#$0001				;unit number one					sta		<dev_id_ref					lda		#get_dib_ptr					sta		drvr_call_num					jsl		dev_dispatcher		;issue get_dib_ptr to device dispatchjer					ldy		#slot_num					lda		[drvr_dib_ptr],y							sta		|smboot_slot					pla							;restore gsos zero page					sta		<drvr_dev_num		;restore GS/OS direct page					pla					sta		<dev_id_ref					pla					sta		<drvr_dib_ptr					pla					sta		<drvr_dib_ptr+2					pld							;point back to our direct page					bcc		dibok				;if we fail, we get purgeddibfail				sec					lda		#get_dib_err		;get_dib_ptr failed					sta		|error_stat					plx					rts												;												; get the slot number of the boot device												;dibok				lda		<scratchzpg			;make the previous sdr link point					sta		<sdr_ptr			;to sdr N					lda		<scratchzpg+2					sta		<sdr_ptr+2ckslot				ldy		#sdr_slot			;point to the slot field within the SDR					lda		[scratchzpg],y					cmp		|smboot_slot					bne		@over					brl		smatch				;found matching slots adjust link pointers												;												; slots do not match check next SDR												;@over				dec		<sdrstocheck		;if count zero go assign ids					bne		@over_1					jmp		assgnid@over_1				ldy		#$0002				;point to next SDR												;												; save this SDR's address												;					lda		<scratchzpg+2		;keep SDR's address					sta		<sdr_ptr+2					lda		<scratchzpg					sta		<sdr_ptr					lda		[scratchzpg]					pha					lda		[scratchzpg],y		;set address for next SDR					sta		<scratchzpg+2					pla					sta		<scratchzpg					bra		ckslot				;go check the slot number					ENDP						EJECT;*******************************************************;;	'cleanup_sdr';;	This routine will reset working parameters in the;	SDR back to zero.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				[sdr_ptr]		=	address of SDR to cleanup;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					EXPORT	cleanup_sdrcleanup_sdr			PROC					lda		#$0000												;												; clear the data chaining instructions												; pointer												;					ldy		#sdr_cmd_ptr					sta		[sdr_ptr],y					ldy		#sdr_cmd_ptr+2					sta		[sdr_ptr],y												;												; clear the buffer pointer and byte count												;					ldy		#sdr_buffer_ptr					sta		[sdr_ptr],y					ldy		#sdr_buffer_ptr+2					sta		[sdr_ptr],y					ldy		#sdr_byte_count					sta		[sdr_ptr],y					ldy		#sdr_byte_count+2					sta		[sdr_ptr],y					rts					ENDP					EJECT;*******************************************************;;	'adjtout';;	This routine will convert the 1/4 second timeout;	count passed by the caller into 1/60 second tick;	count.  The routine also adds the current tick count;	to the calculated 1/60 sec timeout count and returns;	it in a pair of registers.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	1/4 sec timeout value;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	High word of timeout count;				Y reg			=	undefined;				Acc				=	Low word of timeout count;				Carry			=	0 for successful call;									1 for unsuccessful call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					;EXPORT	adjtoutadjtout				PROC					pha							;save 1/4 sec count					stz		scratchzpg			;work area					stz		scratchzpg+2					clc					asl		a					;times 16					rol		<scratchzpg+2					asl		a					rol		<scratchzpg+2					asl		A					rol		<scratchzpg+2					asl		A					rol		<scratchzpg+2					sec					sbc		1,s					;but we really want times 15					sta		<scratchzpg					lda		<scratchzpg+2					sbc		#$0000					plx							;discard 1/4 set count off the stack					tax					lda		<scratchzpg					rts					ENDP					EJECT;*******************************************************;;	'saveptrs';;	This routine will do a save pointers in the data;	chaining instructions.  For Buffer addresses it;	copies the address into the save pointer field.  For;	Loop instructions, it copies the loop count into the;	save pointer.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				[sdr_ptr]		=	Ptr to parameter list containing;									data chain instructions to do save;									pointers on.;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				scratchzpg		=	addr of data chaining instructions;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					EXPORT		saveptrssaveptrs			PROC												;												; point to the data chaining instructions												;					phy							;save work registers					phx					ldy		#sdr_plist_ptr		;get the address of the parameter list					lda		[sdr_ptr],y					sta		<scratchzpg					ldy		#sdr_plist_ptr+2					lda		[sdr_ptr],y					sta		<scratchzpg+2					ldy		#plst_dchainptr		;get the pointer to the data chain instructions					lda		[scratchzpg],y					tax					ldy		#plst_dchainptr+2					lda		[scratchzpg],y					sta		<scratchzpg+2		;point to opcode field of data chain instruction					stx		<scratchzpg					sta		<temp1+2			;point to save ptr area of data chaining instruction					txa					clc					adc		#dci_save					sta		<temp1													;												; save pointers until stop instruction												; (max of 32 instructions including stop)												;					ldy		#$0000				;point to start of data chain instructions listmovloop				lda		[scratchzpg],y		;get the instruction					tax							;save low word of instruction					iny					iny					ora		[scratchzpg],y					beq		exit				;if stop instruction go away					cmp		#$FFFF				;check for loop instruction					beq		movlcnt				;if loop instruction move loop count					lda		[scratchzpg],y		;high word of buffer address					sta		[temp1],y			;save in high word of save area					dey					dey					lda		[scratchzpg],y		;low word of buffer address					sta		[temp1],y			;to save areanxtdci				tya					clc					adc		#dci_size			;bump to next data chain instruction					tay					bra		movloop				;do next instruction												;												; instruction was a loop instruction												; move the loop count												;movlcnt				iny							;bump to the loop count field					iny					lda		[scratchzpg],y		;get the loop count					tax							;save low word of loop count					iny					iny					lda		[scratchzpg],y		;get the high word of the count					dey							;point back to the loop instruction opcode					dey					dey					dey					sta		[temp1],y			;save the high word of the loop count					dey					dey					txa					sta		[temp1],y			;save the low word of the loop count					bra		nxtdci				;Y points at the start of instructionexit				plx							;restore registers					ply					rts					ENDP						EJECT;*******************************************************;;	'ckdcilst';;	This routine will validate that there are a maximum;	of 32 data chaining instructions and that the last;	instruction is a stop instruction.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					;EXPORT	ckdcilstckdcilst			PROC												;												; point to data chain instruction list												;					phx					phy					ldy		#plst_dchainptr					lda		[plist_ptr],y					sta		<scratchzpg					ldy		#plst_dchainptr+2					lda		[plist_ptr],y					sta		<scratchzpg+2												;												; walk the list looking for stop instructions												;					ldx		#maxdcis			;maximum number of data chain instructions					ldy		#$0000@100				clc							;assume we find a stop inst within 32 instructions					lda		[scratchzpg],y					iny					iny					ora		[scratchzpg],y					beq		exit					dey							;back down to low word of opcode					dey					sec							;assume we will fail at this point					dex							;decrement instruction count remaining					beq		exit				;if zero then exit with error					tya							;point to next instruction					clc					adc		#dci_size					tay					bra		@100exit				ply					plx					rts					ENDP					EJECT;*******************************************************;;	'getnextid';;	This routine will return the next ID available for;	devices on the slot number specified in the;	accumulator.  The slot number will be truncated to;	a value between $00 and $0F.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	slot number;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	ID number;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					;EXPORT	getnextidgetnextid			PROC					phx							;save work registers					and		#$000F				;truncate the slot number to $00-$0F					tax					SHORTM						;m=1					inc		|slot_table,x		;bump to next available ID					lda		|slot_table,x		;next available ID for this slot					LONGM						;m=0					plx							;restore work registers					rtsslot_table			dc.w	$0000				;a table of 16 one byte entries (slots 0-F)					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000					ENDP						EJECT					END