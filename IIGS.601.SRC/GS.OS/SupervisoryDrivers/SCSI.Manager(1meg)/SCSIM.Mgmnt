;*******************************************************;;	SCSI Manager 'Management' file.;;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	Copyright Apple Computer, Inc. 1988,90;;*******************************************************;*******************************************************;;	This file contains those routines that are used for;	the management of structures, Memory, Parameter;	lists as well as support routines needed to make;	the Manager do what it do so well.;;*******************************************************;*******************************************************;;	Revision History:;;*******************************************************;	June		1,		1989		Rev. 5.1 Started.					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		priot_to_dev					IMPORT		more_dci					IMPORT		getnxtdci					IMPORT		new_phase					IMPORT		scsi_status					IMPORT		scsi_message					IMPORT		msg_out_byte					IMPORT		current_phase					IMPORT		more_phases					IMPORT		cleanup_sdr					IMPORT		error_stat					IMPORT		low_ptrs_init					IMPORT		callrtn					IMPORT		init_priority					IMPORT		target_priority					IMPORT		phase_hold					IMPORT		our_zpg_hold					IMPORT		cyareg_hold					IMPORT		ident_modify					IMPORT		work_vars_size					IMPORT		user_id					IMPORT		rom_01					IMPORT		rom_03					ENTRY		oscsi_irq_hand					ENTRY		cocoon_irq_hand					ENTRY		oscsi_phases					ENTRY		cocoon_phases					ENTRY		oscsi_hwd_check					ENTRY		cocoon_hwd_check					ENTRY		oscsi_setup					ENTRY		cocoon_setup					ENTRY		oscsi_bus_free					ENTRY		cocoon_bus_free					ENTRY		oscsi_arbitrate					ENTRY		cocoon_arbitrate					ENTRY		oscsi_select					ENTRY		cocoon_select					ENTRY		oscsi_data_out					ENTRY		cocoon_data_out					ENTRY		oscsi_data_in					ENTRY		cocoon_data_in					ENTRY		oscsi_cmd					ENTRY		cocoon_cmd					ENTRY		oscsi_status					ENTRY		cocoon_status					ENTRY		oscsi_bad					ENTRY		cocoon_bad					ENTRY		oscsi_msg_out					ENTRY		cocoon_msg_out					ENTRY		oscsi_msg_in					ENTRY		cocoon_msg_in					ENTRY		badmin					ENTRY		badmout					ENTRY		badmout					ENTRY		msgin_tbl					ENTRY		msgout_tbl					ENTRY		singmout					ENTRY		Save_PTR					ENTRY		discon					ENTRY		validate_msg					ENTRY		set_old_scsi					ENTRY		osend_bytes					ENTRY		send_byte					ENTRY		orecv_bytes					ENTRY		cocoon_read					ENTRY		cocoon_write					ENTRY		orecv_byte					ENTRY		callzpg					ENTRY		ozeropgcode					ENTRY		patch1					ENTRY		ocopyzcode					ENTRY		oinit_5380					ENTRY		ozap_5380					ENTRY		bus_reset					ENTRY		chk_sel_tout					ENTRY		sel_abort_wait					ENTRY		bus_status					ENTRY		DMA_req_count					ENTRY		DMA_buffer_ptr					ENTRY		DMA_dma_cnt					ENTRY		DMA_dma_addr					ENTRY		DMA_dma_bank					ENTRY		DMA_direction					ENTRY		DMA_do_bank_chk					PRINT		OFF					INCLUDE		'SCSIM.Equates'					INCLUDE		'Common.Equ.Src'					INCLUDE		'HW.Equ.Src'					INCLUDE		'M16.MEMORY'					INCLUDE		'M16.UTIL';					INCLUDE		'M16.MISCTOOL'					PRINT		ON					EJECT			;___Phasing_Tables___;*******************************************************;;	'hdw_setup_tbls';;	Old SCSI card Sequencer & routines table;;	Not Called;;	Inputs:		None;;	Outputs:	None;;	Errors:		None;;*******************************************************					;EXPORT	hdw_setup_tblshdw_setup_tbls		PROC												;												; Old scsi card routines address												; table												;					EXPORT	oaddr_tbloaddr_tbl			dc.w	oscsi_irq_hand					dc.w	oscsi_phases					dc.w	oscsi_hwd_check					dc.w	oscsi_setup					dc.w	oscsi_bus_free					dc.w	oscsi_arbitrate					dc.w	oscsi_select												;												; Phasing routines table												;oscsi_tbl_2			dc.w	oscsi_data_out		;NOTE: Must remain in this relative position					dc.w	oscsi_data_in		; because phase bits used as index into					dc.w	oscsi_cmd			; this table. Please see SCSI standard					dc.w	oscsi_status		; and oscsi_phases					dc.w	oscsi_bad			;reserved (invalid phase combination)					dc.w	oscsi_bad			;reserved (invalid phase combination)					dc.w	oscsi_msg_out					dc.w	oscsi_msg_inoscsi_offset		equ		oscsi_tbl_2\		;index to start of phase addr tbl							-oaddr_tbl												;												; Cocoon routines address table												;					EXPORT	cocoon_tblcocoon_tbl			dc.w	cocoon_irq_hand					dc.w	cocoon_phases					dc.w	cocoon_hwd_check					dc.w	cocoon_setup					dc.w	cocoon_bus_free					dc.w	cocoon_arbitrate					dc.w	cocoon_select												;												; Cocoon routines address table												;cocoon_tbl2			dc.w	cocoon_data_out					dc.w	cocoon_data_in					dc.w	cocoon_cmd					dc.w	cocoon_status					dc.w	cocoon_bad					dc.w	cocoon_bad					dc.w	cocoon_msg_out					dc.w	cocoon_msg_incocoon_offset		equ		cocoon_tbl2\		;index to start of phase addr tbl							-cocoon_tbl					IF		oscsi_offset	=	cocoon_offset	THEN					EXPORT		phase_offset:EQUphase_offset		equ		oscsi_offset		;index to start of phase addr tbl					ELSE					The two tables are not equal					ENDIF					ENDP					EJECT;_____Setup_Code_____;*******************************************************;;	'oscsi_irq_hand';;	Old scsi card interrupt handler. The old scsi card;	does not support interrupts!!!;;	Inputs:		e,m,x		=	0 (full native);;	Output:		e,m,x		=	0 (full native);				Carry		=	1 for error during call;				Acc			=	ENTRY;				dpage		=	ENTRY;				B			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;		;*******************************************************					;EXPORT	oscsi_irq_handoscsi_irq_hand		PROC					sec							;go back to GS/OS irq handler					rts							ENDP					EJECT;*******************************************************;;	'cocoon_irq_hand';;	Inputs:		e,m,x		=	0 (full native);;	Output:		e,m,x		=	0 (full native);				Carry		=	1 for error during call;				Acc			=	ENTRY;				dpage		=	ENTRY;				B			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;		;*******************************************************					;EXPORT	cocoon_irq_handcocoon_irq_hand		PROC					sec							;go back to GS/OS irq handler					rts							ENDP					EJECT;*******************************************************;;	'oscsi_phases';	'cocoon_phases';;	This routine will wait for a target device to go;	into its phasing and then will pass control to;	different scsi phasing routines until a Message;	Complete is received from the target device.;;	Inputs:		e,m,x		=	0 (full native);;	Output:		e,m,x		=	0 (full native);				Carry		=	1 for error during call;				Acc			=	ENTRY;				dpage		=	ENTRY;				B			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;		;*******************************************************					;EXPORT	oscsi_phasesoscsi_phases		PROC					EXPORT	cocoon_phasescocoon_phases					dec		|more_phases		;initialize phase handler trigger												;												; check more_phases flag each loop												; through the phase handler												;@100				lda		|more_phases		;we remain here until legitimate bus free					beq		exit					ldx		<io_offset			;point to specific i/o space@200				lda		>curbusstat,x					and		#bsy++sel			;look for unexpected bus free					beq		errexit												;												; not bus free go check which phase												;@250				cmp		#bsy				;bsy and/or sel set check which					bne		@100				;if sel* asserted  then check again												;												; toggle DMA mode to reset the phase												; mismatch and allow REQ to come through												;					SHORTM						;m=1					lda		>modereg,x					pha							;****					and		#dmaenable--\							$FF					sta		>modereg,x;					ora		#dmaenable					pla							;****					sta		>modereg,x					LONGM												;												; check for REQ to go asserted												;					lda		>curbusstat,x		;get target command register					and		#req					beq		@100												;												; vector to new phase												;					lda		>curbusstat,x					lsr		a					lsr		a					and		#$0007				;keep phase bits												;												; match the phase bits in target												; command register												;					SHORTM						;m=1					sta		>targcmdreg,x                                                                                                                       	;match the phase bits					LONGM						;m=0												;												; save the phase information for later												; comparison when multiple data chain												; instructions are called.												;					stz		|new_phase			;assume not a new phase					cmp		|current_phase		;same phase as last time??					beq		@125				;set new phase  flag if different					sta		|current_phase		;save the phase value					dec		|new_phase@125				clc					adc		#phase_offset/2		;offset into phasing routines in addr table							jsr		callrtn				;go to the phasing routines for this interface					bra		@100				;go check for more phases												;												; if bus free when it should not have												; been report an error												;errexit				lda		#bus_free_err					sta		|error_stat					stz		|more_phases					secexit				jsr		ozap_5380			;clean up the 5380 registers					rts					ENDP					EJECT;*******************************************************;;	'oscsi_hwd_check';;	This module checks to see if the SCSI Card in;	question is in fact a SCSI Card.  If it is, then is;	it a Rev. "C" or is it a "Cacoon" Card?;;	Inputs:		e,m,x		=	0 (full native);				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Ours;				Stack		=	Ours;				Speed		=	fast;;	Output:		e,m,x		=	0 (full native);				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	Error code or supervisor;								driver number;				dpage		=	Ours;				Bank		=	Ours;				X reg		=	undefined;				Y reg		=	undefined;		;*******************************************************					;EXPORT	oscsi_hwd_checkoscsi_hwd_check		PROC					lda		<slot_no			;get the slot					and		#slot7				;mask off internal external bit					xba							;times 256					clc							;point to end of rom image					adc		#old_rom_size-2		;check if old scsi card rom image (REV B & REV C roms)					tax					ldy		#old_rom_size-2@100				lda		>io_space+$00,x					eor		|old_rom,y					bne		@200				;not an old apple scsi card					dex					dex					dey					dey					bpl		@100												;												; Check for REV C SCSI rom												;												; point to bank $00 of old scsi card												; check location $C8XX for $02.  If												; $02 then REV C otherwise check for												; a 'Cacoon' Card.  If neither then												; report error and do not install card												; in the tables												;					SHORTM						;m=1					php					sei					lda		>$00CFFF			;turn off I/O strobe  space all cards					lda		<slot_no					and		#slot7				;keep low 3 bits					xba							;we want to access $CNXX space					tax					lda		>io_space,x			;to turn on I/O strobe space					plp							;restore possible irq enable					txa					xba					asl		a					;form DEV-SEL space address					asl		a					asl		a					asl		a					adc		#$80					tax					lda		#$00				;point to bank $00 of the SCSI rom					sta		>io_space\							+ocard_breg,x					lda		>$00CFFC			;get the rom rev C flag					cmp		#rev_C_rom					LONGM						;m=0 					beq		@150				;install the card for NOW!! G.A.												;												; This routine will report the requirement												; for a REV C SCSI rom												;					lda		<slot_no			;get the slot number					and		#slot7				;keep low 3 bits					clc					adc		#$0030				;convert to a ascii slot number					sta		>slot_string+1		;include it in the message string					PUSHWORD	#rom_message	;message number					PUSHLONG	#slot_string	;rom message string address					PUSHLONG	#null			;null substition string 0					jsl		report_error		;call system service routine@150				jsr		set_old_scsi		;it is an old scsi card go set the I/O record					clc							;C=0 old scsi card					rts							;go away@200				sec							;C=1 NOT old scsi card or wrong rev rom					rts					slot_string			dc.b	$01					;size of string					dc.w	$0000;*******************************************************;;	SCSI rom image;;	This module contains a partial image of the rev. B;	and rev. C scsi roms. The segment of code is the;	same in both roms and will be used to check the rom;	code in the old SCSI card against the pattern. If a;	match is found the scsi manager assumes that this;	is a OLD version SCSI card. The code resides in the;	I/O Select address space from $CN00 thru $CN57.;;*******************************************************					longa	off					longi	offold_rom				ldx		#$20				;what comments????					ldx		#$00					ldx		#$03					ldx		#$00					lda		$CFFF					cld					php					sei					lda		#$60					sta		|$07F8					jsr		$07F8					tsx					lda		|$0100,x					sta		|$07F8					plp					lda		|$CFFF					lda		|$07F8					sta		<$1A					lda		#$00					sta		<$19					tay					lda		($19),y					ldy		#$0A					lda		#$00					sta		($19),y					lda		#$55					sta		|$C8E3					lda		|$07F8					and		#$0F					clc					adc		#$08					asl		a					asl		a					asl		a					asl		a					sta		|$C81A					tay					ldx		#$00					lda		#$05					jsr		|$CFCC					lda		#$01					sta		|$C81D					sta		|$C800					dc.b	$20					;opcode for JSR (we want even byte count)old_rom_size		equ		*-old_rom					longa	on					longi	on					ENDP					EJECT;*******************************************************;;	'cocoon_hwd_check';;	Inputs:		e,m,x		=	0 (full native);;	Output:		e,m,x		=	0 (full native);				Carry		=	1 for error during call;				Acc			=	ENTRY;				dpage		=	ENTRY;				B			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;		;*******************************************************					;EXPORT	cocoon_hwd_checkcocoon_hwd_check 	PROC												;												; Check for Cacoon SCSI rom												;												; Issue smartport status $01 call.												;					php					sei					ldx		#$0032-2					txy@is_loop_0			lda		@is_code,y					sta		<zeropg_code,x					dex					dex					txy					bpl		@is_loop_0					lda		<slot_no			;get the slot					and		#slot7				;mask off internal external bit					xba							;times 256					tax					lda		>io_space+$FE,x					and		#$ff00					xba					clc					adc		#$C003					stx		@is_slot					clc					adc		@is_slot					sta		<zeropg_code+\							@is_call+1-\							@is_code					lda		|our_zpg_hold		;point to our zero page					xba					sta		@stuffit+2@stuffit			jsl		>zeropg_code					plp					clc					lda		@is_carry					and		#$00ff					beq		@is_over@is_no_good			sec					rts@is_over			lda		|@is_stat1					cmp		#$0024					bne		@is_no_good					lda		<slot_no			;save the slot number					ldy		#slot				;point to slot field					sta		[iorec_ptr],y		;slot number					lda		#new_scsi_card					ldy		#hwd_type			;save hardware version					sta		[iorec_ptr],y					lda		#new_card_attrbs	;new scsi card attributes					ldy		#io_attrbs					sta		[iorec_ptr],y					lda		<slot_no			;get the slot number					and		#slot7				;mask off internal/external bit					asl		a					;times 16					asl		a					asl		a					asl		a					adc		#io_space+$0080		;dev-sel address $C0NX					ldy		#scsi_base			;offset for base_address of scsi port in record					sta		[iorec_ptr],y		;the base addr bank & dma address already zero					sta		<io_offset			;the bank and DMA controller address := $0000					stz		<io_offset+2					tax					SHORT						;m=1,x=1 to fix the F.O. Hardware.					lda		>priority+$C000,x	;get the priority for this card					lsr		a					lsr		a					lsr		a					lsr		a					lsr		a					eor		#%00000111					tax					lda		@priority_tbl,x					LONGMX					and		#$00FF				;mask of read from $C0NB					ldy		#initpriot			;set it as initiator priority					sta		[iorec_ptr],y					lda		#$0000				;clear other fields in I/O record					ldy		#scsi_bank					sta		[iorec_ptr],y		;clear bank field of scsi controller base addr					ldy		#dma_base					sta		[iorec_ptr],y		;clear DMA controller base addr & bank					ldy		#dma_bank					sta		[iorec_ptr],y					ldy		#io_attrbs					sta		[iorec_ptr],y					ldy		#d0logicals			;clear logical unit fields for scsi devices@100				sta		[iorec_ptr],y		;8 device fields 2 bytes each scsi device					iny					iny					cpy		#max_scsi_devs\							*2+d0logicals		;2 bytes per device field					bcc		@100					txa							;initiator priority												;												; convert to scsi device number												;					asl		a					;times 2 because I/O record dev fields = words					clc					adc		#d0logicals			;point to device fields  within i/o record					tay					lda		#dont_scan_dev		;do not scan initiator priority for logicals					sta		[iorec_ptr],y					inc		<numscsi_cards		;bump the scsi cards total					clc					rts							;>>>--- set_old_scsi --->>>												;												; Data Area for this munge.												;@priority_tbl		dc.b	bit_0					dc.b	bit_1					dc.b	bit_2					dc.b	bit_3					dc.b	bit_4					dc.b	bit_5					dc.b	bit_6					dc.b	bit_7												;												; Code to call smart port from												; bank 0												;@is_code			phd					phb					pea		$0000					pld					phk					plb					php					tsc					sta		>@stack					sec					xce					php					SHORT@is_call			jsr		|$c000					dc.b	$00+$40					dc.l	@is_data					bcs		@is_err					lda		#$00@is_err				sta		>@is_carry					plp					xce					lda		>@stack					tcs					plp					plb					pld					longa	on					longi	on					rtl@is_data			dc.b	$03					dc.b	$00					dc.l	@is_stat1					dc.b	$01@is_slot			dc.w	$0000@is_carry			dc.w	$0000@stack				dc.w	$0000@is_stat1			dcb.b	256,0							ENDP					EJECT;*******************************************************;;	'oscsi_irq_hand';;	This module will setup all the required variables;	and pointers before performing a specified function;	requested by the caller.  The routine performs the;	following functions:;		1.	Gets the parameter list pointer from the SIB;		2.	Sets up a parameter list pointer;		3.	Sets up all the zero page pointers to access;			all the buffers;		4.	Loads the index of the next routine in the;			table to run;;	'cocoon_setup';;	There is no setup for the Cocoon Card.  It is done;	in the data I/O Sections.;;	Inputs:		e,m,x		=	0 (full native);				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	undefined;				Bank		=	undefined;				Stack		=	undefined;				Speed		=	undefined;;	Output:		e,m,x		=	0 (full native);				Acc			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;				Carry		=	0 for no error.;				dpage		=	ENTRY;				Bank		=	ENTRY;				Speed		=	ENTRY;		;*******************************************************					;EXPORT	oscsi_setuposcsi_setup			PROC					jsr		oinit_5380			;initialize old scsi card registers					EXPORT	cocoon_setupcocoon_setup					jsr		ocopyzcode			;download high speed routines into zpg.					clc							;mark success					rts							ENDP					EJECT;*******************************************************;;	'oscsi_irq_hand';;	Old scsi card Bus Free support;;	Inputs:		e,m,x		=	0 (full native);;	Output:		e,m,x		=	0 (full native);				Carry		=	1 for error during call;				Acc			=	ENTRY;				dpage		=	ENTRY;				B			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;		;*******************************************************					;EXPORT	oscsi_bus_freeoscsi_bus_free		PROC					sec					rts							ENDP					EJECT;*******************************************************;;	'cocoon_bus_free';;	Inputs:		e,m,x		=	0 (full native);;	Output:		e,m,x		=	0 (full native);				Carry		=	1 for error during call;				Acc			=	ENTRY;				dpage		=	ENTRY;				B			=	ENTRY;				X reg		=	ENTRY;				Y reg		=	ENTRY;		;*******************************************************					;EXPORT	cocoon_bus_freecocoon_bus_free		PROC					sec							;go back to GS/OS irq handler					rts							ENDP					EJECT;*******************************************************;;	'oscsi_arbitrate';	'cocoon_arbitrate';;	This module will arbitrate for the SCSI bus.  The;	contents of the accumulator contain the ID of the;	Initiator.  This routine will wait until the;	arbitration succeds.;;	Inputs:		e,m,x			=	0 (full native);				initiator_id	=	SCSI ID of device wanting bus;				io_offset		=	Register offset (slot*$10+$80);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	Ours;				Stack			=	GS/OS;				Bank			=	Ours;				Speed			=	undefined;;	Output:		e,m,x			=	0 (full native);				X reg			=	undefined;				Y reg			=	undefined;				Carry			=	0 if successful arbitration;									1 if arbitration failed;				Error_stat		=	arbitration phase error ($FE15);				Acc				=	$FE15 if an error else = 0;				dpage			=	ENTRY;				Bank			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_arbitrateoscsi_arbitrate		PROC					EXPORT	cocoon_arbitratecocoon_arbitrate					phd							;save direct register					lda		<io_offset			;i/o register offset					tcd												;												; start the arbitration timeout heartbeat												; task												;					lda		#arbtcount			;arbitrate timeout count (approx. 2 secs)					sta		|arbtick_count					SHORTM						;m=1					lda		|init_priority		;get priority of our initiator					stz		<initcmdreg			;****					stz		<targcmdreg			;clear the phase bits					sta		<outdatareg			;write Initiator ID												;												; check the arbitration timeout count												; field for zero												;@10					lda		|arbtick_count					ora		|arbtick_count+1					beq		arbitrate_tout		;if nonzero check again later					stz		<modereg			;reset arbitrate bit					lda		#arbitrate			;then set arbitrate bit					sta		<modereg					bit		<initcmdreg			;wait for bus free					bvc		@10					nop							;wait 2.2+ usec					nop					nop					nop					nop					lda		#arbitlost			;check for loss of arbitration					and		<initcmdreg					bne		@10					lda		<currdata			;otherwise reset arbitrate bit &					eor		|init_priority		;check for higher priority on bus					beq		@30					;nobody else wants the bus					cmp		|init_priority		;otherwise try again					bcs		@10@30					lda		#arbitlost			;check for arbitrate loss					and		<initcmdreg			;if not lost we win					bne		@10					;otherwise go try again;					lda		#select++\;							atn					;assert select with attention;					ora		<initcmdreg			;include other bits of register;					and		#<%10011111			;mask off test & differential;					sta		<initcmdreg			;write out modified register					lda		#select				;assert select					ora		<initcmdreg			;include other bits of register					and		#<%10011111			;mask off test & differential					sta		<initcmdreg			;write out modified register					clc							;mark successarbit_exit			LONGM						;m=0					pld							;restore direct register					stz		|arbtick_count		;clear the timeout count					rts												;												; arbitration timeout												;arbitrate_tout		LONGM						;m=0					lda		#arbit_phase_err					sta		|error_stat					sec					pld							;restore direct register					stz		|arbtick_count		;clear the timeout count					rts												;												; Arbitration timeout heartbeat service												; routine												;					EXPORT	arbtout_headerarbtout_header		dc.l	$00000000			;room for link pointerarbtick_count		dc.w	$0000				;tick count before irq					dc.w	$A55A				;manual is wrong A55A signature correct												;												; count field in the header is the flag												; for timout												;												;the count field in heartbeat task header												;= $0000 marks timeout.					rtl					ENDP					EJECT;*******************************************************;;	'oscsi_select';	'cocoon_select';;	This routine will select a particular SCSI target;	device.  The routine assumes that the routine;	Arbitration_phase has been called previously and;	succeeded in gaining control of the SCSI bus.;;	Inputs:		e,m,x			=	0 (full native);				initiator_id	=	scsi device who has scsi bus;				target_id		=	scsi ID of target we want;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	ENTRY;				Y reg			=	ENTRY;				Carry			=	0 for no error.;									1 for error during call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_selectoscsi_select		PROC					EXPORT	cocoon_selectcocoon_select					phd							;save direct register					lda		<io_offset			;get slot offset for 5380 registers					tcd					SHORTM						;m=1					stz		<selectereg			;clear the reselect ID register					lda		|init_priority		;post our ID and targets ID on bus					ora		|target_priority					sta		<outdatareg					lda		#identify_msg		;we want to send an identify message					sta		|msg_out_byte					lda		#<databuson			;assert our ID & target ID on bus					ora		<initcmdreg			;include other bits of register					and		#<%10011111			;mask off test & differential					sta		<initcmdreg			;write out modified register					lda		#<arbitrate			;reset arbitrate bit					trb		<modereg					lda		#busy--\			;reset BSY*							%10011111					and		<initcmdreg			;include other bits in register					sta		<initcmdreg			;write out new initiator cmd. reg.					jsr		chk_sel_tout		;wait for target to assert BSY*					bcc		remove_sel			;bus select success or failselect_fail			jsr		sel_abort_wait		;wait select abort time & check BSY*remove_sel			lda		#<select--\			;on success or fail clear SEL* line							%10011111					and		<initcmdreg			;include other bits in register					sta		<initcmdreg			;write out new initiator cmd. reg.					bcc		select_ok			;go away if all ok					lda		#atn--\				;remove atn & turn off bus on select fail							%10011111					and		<initcmdreg			;include other bits in register					sta		<initcmdreg			;write out new initiator cmd. reg.					lda		#databuson--\							%10011111					and		<initcmdreg			;include other bits in register					sta		<initcmdreg			;write out new initiator cmd. reg.					LONGM						;m=0					lda		#sel_phase_err		;mark select phase error					sta		|error_stat			;and let SCSI bus go free					pld							;restore direct register					sec							;mark an error					rts					longa	off					;Put Asm in SHORT Mode for the next												;2 linesselect_ok			lda		#databuson--\		;turn off the data bus							%10011111					and		<initcmdreg			;include other bits in register					sta		<initcmdreg			;write out new initiator cmd. reg.					LONGM						;m=0					pld							;restore direct register					stz		|error_stat			;mark select ok					clc							;mark success					rts					ENDP					EJECT			;____Phasing_Code____;*******************************************************;;	'oscsi_data_out';	'cocoon_data_out';;	This routine will use DMA and the cocoon card to;	send data to the target.;;	Inputs:		e,m,x			=	0 (full native);				scsicptr		=	Pointer to CDB  (LONG);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	ENTRY;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Carry			=	0 for no error.;									1 for error during call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_data_outoscsi_data_out		PROC					pea		$0000				;Flag to call old card.					bra		data_out;					bra		chk_DMA				;**** Experimental ****					EXPORT	cocoon_data_outcocoon_data_out					pea		$8000				;Flag to call Cocoon card.												;												;**** Experimental ****												; v v v v v v v v v v v												;;chk_DMA				sta		>$ff0410;					lda		>dmactl,x;					and		#dma_enabled;					bne		@real_dma												;												; Set thresholds for System RAM Only.												;;					lda		#$0002;					ldy		#$0010;					bra		@set_size												;												; Set full DMA Range.												;;@real_dma			lda		#$0042;					ldy		#$0050												;												; Save Sizes for 'getnxtdci' Call.												;;@set_size			sta		|rom_01;					sty		|rom_03												;												; ^ ^ ^ ^ ^ ^ ^ ^ ^ ^ ^												;**** Experimental ****												;data_out			lda		|more_dci			;check for more DCI instructions					beq		exit					jsr		getnxtdci			;next data chain instruction (buffer & count returned)					bcs		exit				;no more DCI instructions					lda		1,s;					bmi		@cocoon					bmi		@cocoon1					jsr		osend_bytes			;go write bytes					bra		@over;@cocoon				clv							;Try to use real DMA@cocoon1			jsr		cocoon_write		;go receive from cocoon using DMA												;												; update the transfer count												;@over				clc					ldy		#plst_reqxfr_cnt					lda		<xfer_count			;update the transfered byte count					adc		[plist_ptr],y					sta		[plist_ptr],y					ldy		#plst_reqxfr_cnt+2					lda		<xfer_count+2					adc		[plist_ptr],y					sta		[plist_ptr],y												;												; check for a phase mismatch												;					jsr		bus_status			;get the status of the scsi bus					and		#$0800				;check for phase match					beq		exit				;go away if phase changed					stz		|new_phase			;phase has not changed					bra		data_out			;go receive next groupt of bytesexit				pla							;Yank our flag					sta		>$ff0412					rts					ENDP							EJECT;*******************************************************;;	'oscsi_data_in';	'cocoon_data_in';;	This routine will use DMA and the cocoon card to;	receive data from the target.;;	Inputs:		e,m,x			=	0 (full native);				scsicptr		=	Pointer to CDB  (LONG);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	ENTRY;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Carry			=	0 for no error.;									1 for error during call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_data_inoscsi_data_in		PROC					pea		$0000				;Flag to call old card.					bra		data_in;					bra		chk_DMA				;**** Experimental ****					EXPORT	cocoon_data_incocoon_data_in					pea		$8000				;Flag to call Cocoon card.												;												;**** Experimental ****												; v v v v v v v v v v v												;;chk_DMA				sta		>$ff0420;					lda		>dmactl,x;					and		#dma_enabled;					bne		@real_dma												;												; Set thresholds for System RAM Only.												;;					lda		#$0002;					ldy		#$0010;					bra		@set_size												;												; Set full DMA Range.												;;@real_dma			lda		#$0042;					ldy		#$0050												;												; Save Sizes for 'getnxtdci' Call.												;;@set_size			sta		|rom_01;					sty		|rom_03												;												; ^ ^ ^ ^ ^ ^ ^ ^ ^ ^ ^												;**** Experimental ****												;data_in				lda		|more_dci			;check for more DCI instructions					beq		exit					jsr		getnxtdci			;next data chain instruction (buffer & count returned)					bcs		exit				;no more DCI instructions					lda		1,s;					bmi		@cocoon					bmi		@cocoon1					jsr		orecv_bytes			;go receive from the old card					bra		@over;@cocoon				clv							;Try to use real DMA@cocoon1			jsr		cocoon_read			;go receive from cocoon using DMA												;												; update the transfer count												;@over				clc					ldy		#plst_reqxfr_cnt					lda		<xfer_count			;update the transfered byte count					adc		[plist_ptr],y					sta		[plist_ptr],y					ldy		#plst_reqxfr_cnt+2					lda		<xfer_count+2					adc		[plist_ptr],y					sta		[plist_ptr],y												;												; check for a phase mismatch												;					jsr		bus_status			;get the status of the scsi bus					and		#$0800				;check for phase match					beq		exit				;go away if phase changed					stz		|new_phase			;phase has not changed					bra		data_in				;go receive next groupt of bytesexit				pla							;Yank our flag					sta		>$ff0422					rts					ENDP							EJECT					;EXPORT	oscsi_cmdoscsi_cmd			PROC********************************************************************		This routine will send a scsi command to a*               previously selected device.  The command pointer*               address must be provided in cmd_ptr.**               Note: This call assumes that the target device*               has been selected and has the BSY*, C/D* and REQ**               lines asserted (target waiting for command from*               initiator.**                ENTRY: e,m,x=0*			(cmd_ptr:long word) = address of scsi command*			(cmd_size:long word) = number of bytes in command**                Exit:  e,m,x=0******************************************************************					sta		>$ff0430					SHORTM					lda		#attention--\		;Remove Attention							%10011111					and		>initcmdreg,x		;include other bits in register					sta		>initcmdreg,x		;write out new initiator cmd. reg.												;												; Stuff Logical Unit Number in												; Command Packet.												;					ldy		#null+1				;Second Byte					lda		<logunit			;Get the logical unit					asl		a					;0000 0xxx					asl		a					;0000 xxx0					asl		a					;000x xx00					asl		a					;00xx x000					asl		a					;0xxx 0000					asl		a					;xxx0 0000					ora		[scsicptr],y					sta		[scsicptr],y					LONGM					lda		#max_cmd_size		;assume command is 12 bytes					sta		<byte_ctr			;if not max, phase change pulls us out					stz		<byte_ctr+2			;clear high word of byte count					lda		<scsicptr			;setup pointer for send bytes					sta		<buffer_ptr					lda		<scsicptr+2					sta		<buffer_ptr+2					jsr		osend_bytes			;send the command on the scsi bus					sta		>$ff0432					rts					ENDP							EJECT;*******************************************************;;	'cocoon_cmd';;	This routine will send out the command bytes via;	polled I/O to the Cocoon Card.  This may change to;	pDMA in the future, but there is currently a;	problem with that.;;	Inputs:		e,m,x			=	0 (full native);				scsicptr		=	Pointer to CDB  (LONG);				Acc				=	undefined;				X reg			=	io_offset;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	ENTRY;				Y reg			=	undefined;				Carry			=	0 for no error.;									1 for error during call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	cocoon_cmdcocoon_cmd			PROC					sta		>$ff0430					SHORTM												;												; Stuff Logical Unit Number in												; Command Packet.												;					ldy		#null+1				;Second Byte					lda		<logunit			;Get the logical unit					asl		a					;0000 0xxx					asl		a					;0000 xxx0					asl		a					;000x xx00					asl		a					;00xx x000					asl		a					;0xxx 0000					asl		a					;xxx0 0000					ora		[scsicptr],y					sta		[scsicptr],y					ldy		#null-1				;start with the first byte@loop				iny					lda		[scsicptr],y		;Get Command Byte					jsr		send_byte			;send the byte on the scsi bus					bcc		@loop					LONGM					sty		<xfer_count					stz		<xfer_count+2					sta		>$ff0432					rts					ENDP							EJECT;*******************************************************;;	'oscsi_status';	'cocoon_status';;	This routine will handle the reading of the status;	byte from the SCSI bus.  The I/O of the byte is made;	in programmed I/O mode.;;	Inputs:		e,m,x			=	0 (full native);				target_id		=	scsi ID of target we want;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	target_id;				Y reg			=	ENTRY;				Carry			=	0 for no error.;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_statusoscsi_status		PROC					EXPORT	cocoon_statuscocoon_status					sta		>$ff0440					jsr		orecv_byte					sta		|scsi_status		;save the scsi call status byte					clc							;will always succeed					sta		>$ff0442					rts							;>>>--- oscsi_status --->>>					ENDP							EJECT;*******************************************************;;	'oscsi_bad';	'cocoon_bad';;	This routine will set the error code inv_phase_err;	in error_stat, sets the carry bit and exits.;;	Inputs:		e				=	0 (full native);				m,x				=	undefined;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e				=	ENTRY;				m,x				=	ENTRY;				error_stat		=	inv_phase_err;				Acc				=	inv_phase_err;				X reg			=	ENTRY;				Y reg			=	ENTRY;				Carry			=	1 for an error.;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_badoscsi_bad			PROC					EXPORT	cocoon_badcocoon_bad					sta		>$ff0450					php					LONGM						;m=0					lda		#inv_phase_err		;mark phase bits error					sta		|error_stat					plp							;m=?					sec					sta		>$ff0452					rts					ENDP					EJECT;*******************************************************;;	'oscsi_msg_out';	'cocoon_msg_out';;	This routine will send the value located in;	'msg_out_byte to the target.;;	Inputs:		e,m,x			=	0 (full native);				msg_out_byte	=	SCSI Message Byte to Send;				io_offset		=	Register offset (slot*$10+$80);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	Ours;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Carry			=	0 for no error.;									1 for error during call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_msg_outoscsi_msg_out		PROC					EXPORT	cocoon_msg_outcocoon_msg_out					sta		>$ff0460					jsr		@do_it					sta		>$ff0462					rts@do_it				lda		|msg_out_byte		;check if trying to send identify msg					jsr		|validate_msg		;range check the message					bcs		@badmout			;invalid message number					lda		|msg_out_byte		;valid check for identify					cmp		#identify_msg					bge		moident					asl		a					;address table index = msg*4					asl		a					tax					jsr		(msgout_tbl,x)		;call message service routine					rts												;												; Bad Message Out												;@badmout			lda		#bad_msg_err		;report a bad message error					sta		|error_stat					sec					rts												;												; IDENTIFY message out												;moident				ora		<logunit			;include the logical unit					ora		|ident_modify		;Include any other flags.					bra		singmout												;												; Send Message Byte												;sndmbyte			lda		|msg_out_byte												;												; single byte message out routine												;					EXPORT		singmoutsingmout			SHORTM						;m=1,x=0					ldx		<io_offset			;point to proper io location					xba							;save the message byte					lda		>modereg,x			;use programmed I/O mode					pha							;save mode register					and		#%11111101					sta		>modereg,x					lda		#attention--\		;Remove Attention							%10011111					and		>initcmdreg,x		;include other bits in register					sta		>initcmdreg,x		;write out new initiator cmd. reg.					xba					sta     >currdata,x   		;write out the byte					lda		#databuson			;assert the data bus					ora		>initcmdreg,x					sta		>initcmdreg,x					lda		#asrtack			;assert ACK*					ora		>initcmdreg,x		;initiator command register					sta		>initcmdreg,x		;write modified register@req_loop			lda		#<req				;wait for REQ* to go false					and		>curbusstat,x		;get current scsi bus status					bne		@req_loop			;and wait until REQ* is false					lda		>initcmdreg,x		;get initiator cmd register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register    				lda		#databuson--\		;turn off the data bus							%11111111					and		>initcmdreg,x					sta		>initcmdreg,x					pla							;restore mode register					sta		>modereg,x					LONGM					rts					ENDP					EJECT;*******************************************************;;	'oscsi_msg_in';	'cocoon_msg_in';;	This routine will handle the reading of the message;	byte(s) from the SCSI bus.  The I/O of the byte is;	made in programmed I/O mode.;;	Inputs:		e,m,x			=	0 (full native);				io_offset		=	Register offset (slot*$10+$80);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	0 (full native);				scsi_message	=	call message byte;				Acc				=	undefined;				X reg			=	target_id;				Y reg			=	ENTRY;				Carry			=	0 for no error.;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	oscsi_msg_inoscsi_msg_in		PROC					EXPORT	cocoon_msg_incocoon_msg_in					sta		>$ff0470					jsr		@do_it					sta		>$ff0472					rts@do_it				ldx		<io_offset			;point to DEV-SEL space for specific slot					SHORTM					lda		<modereg,x					and		#dmaenable					beq		@non_dma_mode					lda		<modereg,x					and		#dmaenable--\							$ff					sta		<modereg,x					sec@non_dma_mode					lda		>currdata,x			;read a msg byte (may be extended msg)					bcc		@long					pha					lda		<modereg,x					ora		#dmaenable					sta		<modereg,x					pla@long				LONGM					and		#$00FF				;low byte					sta		|scsi_message		;save it					jsr		validate_msg		;go see if valid (range check it)					bcc		msginok												;												; message is invalid REJECT it (bad												; message in)												;					EXPORT		badminbadmin				lda		#rEJECT_msg			;rEJECT message					sta		|msg_out_byte		;for data out phase					ldx		<io_offset			;point to DEV-SEL space for specific slot					SHORTM					sta		>outdatareg,x		;write reject message byte.					lda		#asrtack			;assert ACK*					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register					lda		#attention			;force target to msg_out phase					ora		>initcmdreg,x		;include other bits of register					and		#<%10011111			;mask off test & differential					sta		>initcmdreg,x		;write out modified register@req_loop			lda		#<req				;wait for REQ* to go false					and		>curbusstat,x		;get current scsi bus status					bne		@req_loop			;and wait until REQ* is false					lda		>initcmdreg,x		;get initiator cmd register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					LONGM					rts							;go away (next phase should be MSG out phase)												;												; message byte was within range												; use msg # as index and call message												; service routine												;msginok				SHORTM					lda		#asrtack			;assert ACK*					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register@req_loop			lda		#<req				;wait for REQ* to go false					and		>curbusstat,x		;get current scsi bus status					bne		@req_loop			;and wait until REQ* is false					lda		>initcmdreg,x		;get initiator cmd register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					LONGM					lda		|scsi_message					cmp		#identify_msg					blt		@100												;												; identify message from target convert												; to restore pointers												;					lda		#rest_data_ptr					sta		|scsi_message												;												; form table index and call message												; service routine												;@100				asl		a					;index into table := msg # * 4					asl		a					tax					jsr		(|msgin_tbl,x)		;call service routine					rts					ENDP							EJECT;___Message_Center___;*******************************************************;;	'msgin_tbl';	'msgout_tbl';;	Address table for message service routines each;	ENTRY has following format;;		Table ENTRY;		Message		msg_in_address	 msg_out_address;					+---------------+---------------+;			N		|	L	|	H	|	L	|	H	|;					+---------------+---------------+;;*******************************************************;					;EXPORT		msgin_tblmsgin_tbl			PROC					dc.w	cmd_compmsg			;old scsi command complete msg in					EXPORT		msgout_tblmsgout_tbl			dc.w	badmout				;handler for cmd complete msg out					dc.w	badmin,badmout		;extended message					dc.w	Save_PTR,badmout	;save data pointers					dc.w	badmin,badmout		;restore data pointers					dc.w	discon,badmout		;disconnect (old card can not!)					dc.w	badmin,badmout		;initiator detected error					dc.w	badmin,abortmout	;abort message					dc.w	rEJECTmi,rEJECTmo	;rEJECT message					dc.w	badmin,badmout		;nop					dc.w	badmin,badmout		;message parity error					dc.w	badmin,badmout		;linked command complete					dc.w	badmin,badmout		;linked command complete with flag					dc.w	badmin,badmout		;autosense data follows;*******************************************************;;		MESSAGE Handlers;;*******************************************************												;												; command complete message												;												;cmd_compmsg			lda		#$FFFF				;reset current phase value					sta		|current_phase					stz		|more_phases					rts												;												; REJECT message in												;rEJECTmi			lda		|msg_out_byte		;see if we sent an identify message					xba							;check for bit 7 set					bmi		@100				;ignore the identify												;												; message in state machine  goes here												;@100				rts												;												; REJECT message out												;rEJECTmo			lda		#rEJECT_msg			;send a reject message to the target					jsr		singmout			;send the message byte					rts												;												; ABORT message out												;abortmout			lda		#abort_msg			;send an abort message to the target					jsr		singmout			;send the message byte					stz		|more_phases		;clean up and quit					jsr		cleanup_sdr					rts												;												; bad message handler (message out phase)												;					EXPORT	badmoutbadmout				jsr		abortmout					lda		#bad_msg_err		;report a bad message error					sta		|error_stat					sec					rts					ENDP					EJECT;*******************************************************;;	'Save_PTR';;	This module will the 'Save Pointer' message from the;	target.  The methode of operation is as follows:;;	Check to see if RAM has already been allocated.  If;	so then skip to Lock handle.;;	Request a section of movable RAM for our context;	switch.  If not available, then we will reject the;	message.;;	Place handle in the SDR.;;	Lock the handle for now.;;	Copy the environs to the memory.;;	Unlock the handle.;;	;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	undefined;				Carry			=	undefined;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None.;;*******************************************************;					EXPORT	Save_PTRSave_PTR			PROC												;												; Make sure that the Phase handler												; continues untill the disconnect												; or until the bus goes free.												;					lda		#$FFFF				;reset current phase value					sta		|current_phase					sta		|more_phases												;												; Reject the message for now.												;					jmp		badmin												;												; Do we need any RAM?												;					ldy		#context_hndl					lda		[active_sdr],y					tax					ldy		#context_hndl+2					ora		[active_sdr],y					beq		@get_handle			;Yes we do.  Let's get it.					lda		[active_sdr],y					tay					bra		@lock_down												;												; No.  Then let's get some RAM												;												; Allocate our work space@get_handle										;					PUSHLONG	#null			;room for handle					PUSHLONG	#work_vars_size	;our work area size					PUSHWORD	|user_id		;our user ID					PUSHWORD	#attrnocross++\	;Attributes of requested mem.								attrnospec++\								attrpage					PUSHLONG	#null			;location pointer (will be ignored)					_newhandle					;allocate our memory area					ply							;assume all ok					plx					bcc		@Stuff_n_SDR												;												; No.  Reject the message.												;					jmp		badmin												;												; Place handle in SDR												;@Stuff_n_SDR		txa							;A'=X					tyx							;X'=Y					ldy		#context_hndl					sta		[active_sdr],y					phx							;Stack=X'=Y					tax							;X=A'=X					pla							;A'=Stack=Y					ldy		#context_hndl+2					sta		[active_sdr],y					tay							;Y=A'=Y												;												; We have the Handle, now lock it.												;@lock_down			stx		<temp1					sty		<temp1+2					ldy		#$0004					lda		[temp1],y					ora		#%1000000000000000	;Cheap Lock Down					sta		[temp1],y												;												; Handle is locked.  Deref it.												;@deref_it			ldy		#$0002					lda		[temp1]					tax					lda		[temp1],y					tay												;												; Memory is Locked and Derefed.  Now												; we need to do the context switch.												; IRQs will be locked out.												;@clear_it										rts					ENDP						EJECT;*******************************************************;;	'discon';;	This module will the 'DISSCONNECT' message from the;	target.  The method of operation is as follows:;;	Request a section of movable RAM for our context;	switch.  If not available, then we will reject the;	message.;;	Place handle in the SDR.;;	Lock the handle for now.;;	;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	message byte to validate;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	message #;				Carry			=	0 for valid message;									1 for bad message;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					EXPORT	discondiscon				PROC												;												; Reject the message for now.												;					jmp		badmin					and		#$00FF				;low byte only					cmp		#identify_msg		;check for identify message type					bge		@msg_ok					cmp		#sdata_follows		;check if greater than msg $0C (i.e. $0D sense data follows)					blt		@rts					sec					rts@msg_ok				clc@rts				rts					ENDP						EJECT;*******************************************************;;	'validate_msg';;	This module will validate the message to be sent to;	the target or received from the target.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				Acc				=	message byte to validate;				X reg			=	undefined;				Y reg			=	undefined;				Bank			=	Ours;				dpage			=	Ours;				Stack			=	undefined;				Speed			=	fast;;	Output:		e,m,x			=	ENTRY;				X reg			=	undefined;				Y reg			=	undefined;				Acc				=	message #;				Carry			=	0 for valid message;									1 for bad message;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		;;*******************************************************;					EXPORT	validate_msgvalidate_msg		PROC					and		#$00FF				;low byte only					cmp		#identify_msg		;check for identify message type					bge		@msg_ok;-------------------------------------------------------------------------------------					IF		Disc_ReSel	=	false	then					cmp		#save_dat_ptr		;check if < save Data Pointer MSG					blt		@rts				;yes.					cmp		#init_err_detect	;Check if > Disconnect MSG					blt		@sec				;No.  Force the rejection.					ENDIF;-------------------------------------------------------------------------------------					cmp		#sdata_follows		;check if greater than msg $0C (i.e. $0D sense data follows)					blt		@rts@sec				sec					rts@msg_ok				clc@rts				rts					ENDP						EJECT;____IO_Code_Segs____;*******************************************************;;	'orecv_bytes';	'osend_bytes';;	This routine will setup the low level byte transfer;	routine to receive data from a target into an;	intiatiator or to send data from the initiator to a;	target.  It copies a short code stub into zero;	page to adjust the byte transfer direction.;	It also calls low_ptrs_init to setup the byte;	counters and pointer addresses;;	Inputs:		e,m,x			=	0 (full native);				scsicptr		=	Pointer to CDB  (LONG);				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	ENTRY;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Carry			=	0 for no error.;									1 for error during call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;		;*******************************************************					;EXPORT	orecv_bytesorecv_bytes			PROC												;												; download the receive byte stub												; into zero page												;					lda		|new_phase			;check of new or same phase as last time					beq		nextbuf					lda		|rcvstub			;small piece of code to zero page					sta		<patch1-ozeropgcode\							+zeropg_code					lda		|rcvstub+2					sta		<patch1-ozeropgcode\							+zeropg_code+2					lda		|rcvstub+3					sta		<patch1-ozeropgcode\							+zeropg_code+3												;												; initialize the 5380 controller												;					jsr		oinit_5380			;enable pseudo-DMA mode (old scsi card)					SHORTM					sta		>idmarecv,x			;enable pseudo dma receive mode					LONGM												;												; save the requested byte count												;nextbuf				lda		<byte_ctr					sta		<req_count					lda		<byte_ctr+2					sta		<req_count+2					jsr		low_ptrs_init		;adjust byte count and pointer					phb							;save current data bank, it will be changed					jsl		callzpg				;call routine in zero page												;												; save the transfered byte count												;@100				php							;save carry bit					clc					tya					adc		<req_count					sta		<xfer_count					lda		<byte_ctr+2					adc		<req_count+2					sta		<xfer_count+2					plp							;restore carry bit					plb							;restore data bank					rtsrcvstub				lda		|opdmadatareg,x		;recv code stub					sta		[buffer_ptr],y					ENDP					EJECT					;EXPORT	osend_bytesosend_bytes			PROC					lda		|new_phase			;check new phase flag for phase change					beq		nextbuf				;dont reinit if same phase as last time					lda		|sndstub			;small piece of code to zero page					sta		<patch1-ozeropgcode\							+zeropg_code					lda		|sndstub+2					sta		<patch1-ozeropgcode\							+zeropg_code+2					lda		|sndstub+3					sta		<patch1-ozeropgcode\							+zeropg_code+3					jsr		oinit_5380			;enable pseudo-DMA mode												;												; turn on the scsi data bus and kick												; start the DMA PROCess												;					SHORTM					lda		#$01					sta		>initcmdreg,x					sta		>dmasndreg,x		;enable pseudo dma send mode					LONGM												;												; save the requested byte count												;nextbuf				lda		<byte_ctr					sta		<req_count					lda		<byte_ctr+2					sta		<req_count+2					jsr		low_ptrs_init		;2's complement byte count & pointer					phb							;save current data bank, it will be changed					jsl		callzpg				;call routine in zero page												;												; save the transfered byte count												;@100				php							;save carry bit					clc					tya					adc		<req_count					sta		<xfer_count					lda		<byte_ctr+2					adc		<req_count+2					sta		<xfer_count+2					plp							;restore carry bit												;												; check for more data chaining												; instructions												;					plb					rtssndstub				lda		[buffer_ptr],y		;send code stub					sta		|opdmadatareg,x							ENDP					EJECT;*******************************************************;;	'cocoon_read';;	This routine will setup the sandwich chip for DMA,;	kick it and then monitor it for IRQs, or Bank;	rollovers, as well as any timeouts.;;	ENTRY:		JSR;;	Inputs:		e,m,x			=	0 (full native);				scsicptr		=	Pointer to CDB  (LONG);				Overflow		=	0 for DMA.;									1 for Pseudo DMA;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				dpage			=	undefined;				Bank			=	Ours;				Stack			=	GS/OS;				Speed			=	undefined;;	Output:		e,m,x			=	ENTRY;				Acc				=	undefined;				X reg			=	undefined;				Y reg			=	undefined;				Carry			=	0 for no error.;									1 for error during call;				dpage			=	ENTRY;				Bank			=	ENTRY;				Stack			=	ENTRY;				Speed			=	ENTRY;;	Errors:		None.;;*******************************************************					;EXPORT	cocoon_readcocoon_read			PROC					lda		#$0000					bra		dma_it					EXPORT	cocoon_writecocoon_write					lda		#$0080				;For short mode												;												; Set the direction flag												;dma_it				sta		DMA_direction												;												; Check for real or pseudo DMA Mode.												; We will load address in 16 bit												; mode.  This will put bit 6 of the												; register in bit 6 of the Acc												;												;												;**** Experimental ****												; v v v v v v v v v v v												;					bvs		@do_pseudo					lda		>dmactl,x					and		#dma_enabled					bne		@real_dma@do_pseudo			brl		@pseudo_stuff;					bvc		@real_dma;					brl		@pseudo_stuff												;												; ^ ^ ^ ^ ^ ^ ^ ^ ^ ^ ^												;**** Experimental ****												;												;												; Clear the transfer count												;@real_dma			stz		<xfer_count					stz		<xfer_count+2												;												; Init bank rollover flag.  Must												; validate the first bank rollover												; that this call receives from sandwich.												;					dec		DMA_do_bank_chk												;												; Get the I/O Offset												;					ldx		<io_offset												;												; save the requested byte count												;					lda		<byte_ctr					sta		<req_count					sta		DMA_req_count					lda		<byte_ctr+2					sta		<req_count+2					sta		DMA_req_count+2												;												; Set Buffer Pointer												;					lda		<buffer_ptr+2					sta		DMA_buffer_ptr+2					lda		<buffer_ptr					sta		DMA_buffer_ptr;*******************************************************;;	Special processing.;;	There is a problem with the way that bank rollover;	is handled in the sandwich chip.  If the previous;	call ended at $xx/FFFF then the call would have;	terminated normaly without reporting a bank;	rollover.  But, because it did reach the end of a;	bank, it will report a rollover for the next byte;	transfered regardless to that bytes address and;	regardless to that bytes relationship to the data;	written at $xx/FFFF.;;	To fix the problem we will check the address;	pointer in sandwich when we get a rollover.  If it;	is not = 0 then we will ignor it.  If it is zero,;	we will then increment the bank.  For this to work,;	in any situation, we must insure that the starting;	buffer pointer is not = 0.;;*******************************************************												;												; Check if low words of both the count												; and buffer are = 0.												;												; 'Acc' Low buff pointer loaded above.												;					ora		DMA_req_count					bne		@dma_loop			;No.  Process normally																								;												; Setup to read first $8000 and leave												; $8000 for next pass of the loop.												; Make sure that the high word is 'dec'												; by 1.												;					lda		#$8000					sta		DMA_dma_cnt			;For this request					sta		DMA_req_count		;For next time.					bra		@bank_sub			;subtract 1 from high word of count												;												; Set Byte Counter to the low word												; of the requested byte count												;@dma_loop			lda		DMA_req_count					sta		DMA_dma_cnt			;Save for later					php							;Is it 0?					stz		DMA_req_count		;Update the remainding Byte Count					plp							;Is dma count = 0					beq		@bank_sub			;Yes.  Treat as a 17 bit value					sec							;put the carry back					bra		@finish_sub@bank_sub			clc@finish_sub			lda		DMA_req_count+2					sbc		#$0000					sta		DMA_req_count+2@bump_ptrs			clc							;Update the next buffer address					lda		DMA_buffer_ptr					sta		DMA_dma_addr					adc		DMA_dma_cnt					sta		DMA_buffer_ptr					php							;Save Carry from the Add.					cmp		DMA_dma_addr					bne		@over_carry			;Not $xxxxx + $10000					plp					sec							;Treat as $xxxxx + $10000					php@over_carry			plp							;Restore Carry from Add (or Pseudo Carry)					lda		DMA_buffer_ptr+2					sta		DMA_dma_bank					adc		#$0000					sta		DMA_buffer_ptr+2												;												; DANGER DANGER DANGER DANGER DANGER												; This line may cause problems.  Test												; fully.  Added 12-03-91 by MSG.												; DANGER DANGER DANGER DANGER DANGER												;					dec		DMA_do_bank_chk		;Set flag.  We have changed the Bank.												;												; DANGER DANGER DANGER DANGER DANGER												;												; Setup DMA Count, Buffer, and Bank												;					sec					lda		#$0000					sbc		DMA_dma_cnt			;Convert to two's compliment.					sta		>dmacntl,x					lda		DMA_dma_addr					sta		>dmaaddrl,x					SHORTM						;m=1					lda		DMA_dma_bank					sta		>dma_bank_reg												;												; initialize the 5380 controller												;@time_out			lda		#null					sta		>dmactl,x			;Turn DMA off					lda		#fire_watch_bit		;fire watchdog timer					ora		>fire_watch,x		;in the control register					and		#%10011111			;mask off unused bits					sta		>fire_watch,x		;fire watchdog timer					eor		#fire_watch_bit					sta		>fire_watch,x		;clear watchdog timer					eor		#fire_watch_bit					sta		>fire_watch,x		;fire watchdog timer					lda		>modereg,x			;Get the mode register					and		#dmaenable--\		;mask off dma							$FF					sta		>modereg,x					lda		#dmaenable			;Now turn on DMA					ora		>modereg,x					and		#$7F				;mask off block mode dma					sta		>modereg,x												;												; Were IRQs Disabled?												;					php					pla							;we are in 8 bit mode.					and		#%00000100			;I Bit					bne		@disable			;SEI was done.					lda		#real_dma++\		;Enable DMA on the Sandwich							irq_enable			;Enable IRQ					bra		@start_dma@disable			lda		#real_dma++\		;Enable DMA on the Sandwich							dis_stop_dma		;Disable IRQ@start_dma			sta		>dmactl,x					php					sei					lda		>cyareg				;read current setting					sta		cyareg_hold			;save it					and		#<%01111111			;b7 = 0 slow down					sta		>cyareg				;write modified register					lda		DMA_direction					bmi		@dma_send					sta		>idmarecv,x			;enable DMA Initiator receive					bra		@dma_done@dma_send			sta		>dmasndreg,x		;enable DMA send register@dma_done			lda		cyareg_hold			;Restore the CYA Register					sta		>cyareg					plp							;Allow IRQs to steal Processor												;												; check to see why DMA stopped 												;					lda		>busstat,x			;check for a phase mismatch					bmi		@end_dma_B			;if end of dma then quit, else restart					and		#phasematch					beq		@end_call_B			;keep going until count expires or												;phase change					lda		>dmactl,x			;What does sandwich have to say about												;this.					tay					and		#addr_roll					bne		@next_bank			;Bank Rollover.					lda		>currdata,x					lda		>initcmdreg,x					lda		>modereg,x					lda		>curbusstat,x					lda		>busstat,x					lda		>resetirqreg,x					tya					and		#watch_dog					bne		@restart_B			;IRQ Stoped us.  Restart												;												; Reset the Watchdog Timer												;					lda		>dmactl,x					pha							;Save current Value					lda		#null					sta		>dmactl,x			;Turn only Sandwich DMA off					lda		#fire_watch_bit		;fire watchdog timer					ora		>fire_watch,x		;in the control register					and		#%10011111			;mask off unused bits					sta		>fire_watch,x		;fire watchdog timer					eor		#fire_watch_bit					sta		>fire_watch,x		;clear watchdog timer					eor		#fire_watch_bit					sta		>fire_watch,x		;fire watchdog timer					pla					and		#irq_enable++\		;Not setting these bits, only							dis_stop_dma++\		;making sure that of the bits that							real_dma++\			;were set and can be written are.							pseudo_dma			;All others are masked out.;					sta		>dmactl,x;					bra		@restart					pha							;Save Control Register Value					lda		DMA_direction		;The following code is for writes only.					bpl		@brl_start_dma					lda		>targcmdreg,x		;Was the byte in the 53c80 sent?					and		#lastbyte					bne		@brl_start_dma		;Yes.  Continue on.					LONGM					lda		>dmaaddrl,x			;No it wasn't sent yet.  The code at					dec		a					;@start_dma will lose it.  Back off					sta		>dmaaddrl,x			;pointer and count by 1.					lda		>dmacntl,x					dec		a					sta		>dmacntl,x					SHORTM@brl_start_dma		pla							;Restore Control Register Value.					brl		@start_dma												;												; Stepping stone for these two branches.												;@end_dma_B			bra		@end_dma@end_call_B			bra		@end_call@restart_B			bra		@restart												;												; See note on ENTRY to this routine for												; an explanation of why I'm doing this.												;@next_bank			lda		DMA_do_bank_chk					beq		@inc_it				;Already been done					LONGM						;m=0					stz		DMA_do_bank_chk		;Clear flag					lda		>dmaaddrl,x			;Did it rollover?					beq		@maybe				;Check count to be sure					SHORTM						;m=1					bra		@restart			;No.					longa	on					;for assembler	m=0@maybe				sec							;Maybe! Did it really rollover?					lda		#$0000					sbc		DMA_dma_cnt			;Convert to two's compliment.					cmp		>dmacntl,x					SHORTM						;m=1					beq		@restart			;No.  It did not really rollover.@inc_it				lda		>dma_bank_reg		;Account for Bank Rollover					inc		a					sta		>dma_bank_reg					@restart			php					sei					lda		>cyareg				;read current setting					sta		cyareg_hold			;save it					and		#<%01111111			;b7 = 0 slow down					sta		>cyareg				;write modified register					lda		#kick_dma			;force the DMA to continue					sta		>fixit_reg,x					brl		@dma_done			;loop until someone tells us to quit@end_dma			LONGM					clc					bra		@update_counts@end_call			LONGM					sec												;												; Update the transfer count												;@update_counts		php					lda		DMA_dma_cnt					php					clc					adc		<xfer_count					sta		<xfer_count					rol		a					plp					sec					beq		@bank_add					ror		a@bank_add			lda		<xfer_count+2					adc		#null					sta		<xfer_count+2												;												; Adjust for any data not transfered												;					clc					lda		>dmacntl,x					adc		<xfer_count			;2's compliment add = subtract					sta		<xfer_count					bcc		@fixed_it					lda		<xfer_count+2					sbc		#null					sta		<xfer_count+2												;												; Was this the end of the call or only DMA?												;@fixed_it			plp					bcs		@call_done												;												; Adjust for any data not transfered												;					lda		DMA_req_count					ora		DMA_req_count+2					beq		@call_done					brl		@dma_loop					@call_done			rts							;Call ended early;*******************************************************;;	'@pseudo_stuff';;	Use un-real stuff to get the data from or to the;	card.  First we must download the receive or send;	byte stub into zero page, init cocoon and run.;	;*******************************************************@pseudo_stuff		lda		|new_phase			;check of new or same phase as last time					beq		@nextbuf					lda		DMA_direction					beq		@pseudo_read					lda		@pseudo_snd			;small piece of code to zero page					sta		<patch1-ozeropgcode\							+zeropg_code					lda		@pseudo_snd+2					sta		<patch1-ozeropgcode\							+zeropg_code+2					lda		@pseudo_snd+3					sta		<patch1-ozeropgcode\							+zeropg_code+3					bra		@pseudo_init@pseudo_read		lda		@pseudo_rcv			;small piece of code to zero page					sta		<patch1-ozeropgcode\							+zeropg_code					lda		@pseudo_rcv+2					sta		<patch1-ozeropgcode\							+zeropg_code+2					lda		@pseudo_rcv+3					sta		<patch1-ozeropgcode\							+zeropg_code+3												;												; initialize the 5380 controller												;@pseudo_init		SHORTM						;m=1					lda		>modereg,x			;Get the mode register					and		#dmaenable--\		;mask off dma							$7F					sta		>modereg,x					ora		#dmaenable			;Now turn on DMA					sta		>modereg,x					lda		#pseudo_dma					sta		>dmactl,x			;enable pseudo DMA xfers old card					lda		DMA_direction					bne		@pseudo_wdma					sta		>idmarecv,x			;enable pseudo dma receive mode					bra		@pseudo_long@pseudo_wdma		sta		>dmasndreg,x		;enable pseudo dma send mode@pseudo_long		LONGM												;												; save the requested byte count												;@nextbuf			lda		<byte_ctr					sta		<req_count					lda		<byte_ctr+2					sta		<req_count+2					jsr		low_ptrs_init		;adjust byte count and pointer					phb							;save current data bank, it will be changed					jsl		callzpg				;call routine in zero page												;												; save the transfered byte count												;@100				php							;save carry bit					clc					tya					adc		<req_count					sta		<xfer_count					lda		<byte_ctr+2					adc		<req_count+2					sta		<xfer_count+2					plp							;restore carry bit					plb							;restore data bank					rts@pseudo_rcv			lda		|indatareg,x		;recv code stub					sta		[buffer_ptr],y@pseudo_snd			lda		[buffer_ptr],y		;send code stub					sta		|outdatareg,x							ENDP					EJECT;*******************************************************;;	'send_byte';;	This routine will send a byte contained in the Acc.;	to a device on the scsi bus.  The byte is sent in;	Programmed I/O mode.  The routine assumes that all;	the required work to to send bytes on the bus has;	been proviously done.  The routine writes the byte;	out to the scsi bus asserts ACK*, waits for the;	target to deassert REQ* and then deasserts the ACK*.;;	Inputs:		e,x			=	0 (full native);				m			=	1;				Acc			=	Byte to send;				X reg		=	io_offset;				Y reg		=	undefined;				dpage		=	Ours;				Bank		=	Ours;				Stack		=	GS/OS stack space;				Speed		=	undefined;;	Output:		e,x			=	0 (full native);				m			=	1;				X reg		=	ENTRY;				Y reg		=	ENTRY;				Carry		=	0 for successful call;							=	1 for error during call;				dpage		=	ENTRY;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	ENTRY;		;*******************************************************					;EXPORT	send_bytesend_byteT  		    PROC					longa	off					xba							;save the data byte					lda		>modereg,x			;use programmed I/O mode					pha							;save mode register					and		#$FD					sta		>modereg,x@req_loop					lda		#phasematch			;Check for a phase mismatch					and		>busstat,x					beq		@error_out			;Unexpected Phase Change					lda		#<req					and		>curbusstat,x		;get current scsi bus status					beq		@req_loop			;and wait until REQ* is true					lda		#phasematch			;Check for a phase mismatch					and		>busstat,x					beq		@error_out			;Unexpected Phase Change					xba					sta     >outdatareg,x		;write out the byte					lda		#databuson			;Turn on Data Bus					ora		>initcmdreg,x		;include other bits of register					sta		>initcmdreg,x		;write out modified register					lda		#attention--\		;Remove Attention							%10011111					and		>initcmdreg,x		;include other bits in register					sta		>initcmdreg,x		;write out new initiator cmd. reg.					lda		#asrtack			;assert ACK*					ora		>initcmdreg,x		;initiator command register					sta		>initcmdreg,x		;write modified register@req_loop1			lda		#<req				;wait for REQ* to go false					and		>curbusstat,x		;get current scsi bus status					bne		@req_loop1			;and wait until REQ* is false					lda		>initcmdreg,x		;get initiator cmd register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					clc					bra		@out@error_out			sec@out				pla							;restore mode register					sta		>modereg,x					rts					longa	on					ENDP					EJECT;*******************************************************;;	'send_byte';;	This routine will send a byte contained in the Acc.;	to a device on the scsi bus.  The byte is sent in;	Programmed I/O mode.  The routine assumes that all;	the required work to to send bytes on the bus has;	been proviously done.  The routine writes the byte;	out to the scsi bus asserts ACK*, waits for the;	target to deassert REQ* and then deasserts the ACK*.;;	Inputs:		e,x			=	0 (full native);				m			=	1;				Acc			=	Byte to send;				X reg		=	io_offset;				Y reg		=	undefined;				dpage		=	Ours;				Bank		=	Ours;				Stack		=	GS/OS stack space;				Speed		=	undefined;;	Output:		e,x			=	0 (full native);				m			=	1;				X reg		=	ENTRY;				Y reg		=	ENTRY;				Carry		=	0 for successful call;							=	1 for error during call;				dpage		=	ENTRY;				Bank		=	ENTRY;				Stack		=	ENTRY;				Speed		=	ENTRY;		;*******************************************************					;EXPORT	send_bytesend_byte  		    PROC					longa	off					xba							;save the data byte					lda		#attention--\		;Remove Attention							%10011111					and		>initcmdreg,x		;include other bits in register					sta		>initcmdreg,x		;write out new initiator cmd. reg.@req_loop					lda		#phasematch			;Check for a phase mismatch					and		>busstat,x					beq		@error_out			;Unexpected Phase Change					lda		#<req					and		>curbusstat,x		;get current scsi bus status					beq		@req_loop			;and wait until REQ* is true					lda		#phasematch			;Check for a phase mismatch					and		>busstat,x					beq		@error_out			;Unexpected Phase Change					xba					sta     >outdatareg,x		;write out the byte					lda		#databuson			;Turn on Data Bus					ora		>initcmdreg,x		;include other bits of register					sta		>initcmdreg,x		;write out modified register;					lda		#asrtack			;assert ACK*;					ora		>initcmdreg,x		;initiator command register					ora		#asrtack			;assert ACK*					sta		>initcmdreg,x		;write modified register;@req_loop1			lda		#<req				;wait for REQ* to go false;					and		>curbusstat,x		;get current scsi bus status					lda		#<req				;wait for REQ* to go false@req_loop1			and		>curbusstat,x		;get current scsi bus status					bne		@req_loop1			;and wait until REQ* is false					lda		>initcmdreg,x		;get initiator cmd register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					clc					rts@error_out			sec					rts					longa	on					ENDP					EJECT;___Misc_Code_Segs___;*******************************************************;;	'set_old_scsi';;	This routine will setup the I/O record for a;	particular slot with parameters for an old scsi;	card.;;	Inputs:		e,m,x		=	0 (full native);				slot_no		=	Slot Number of card.;				io_rec_ptr	=	Pointer to the IO Record;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Ours;				Stack		=	GS/OS;				Speed		=	fast;;	Output:		e,m,x		=	0 (full native);				Carry		=	0 for successful call;							=	1 for error during call;				Acc			=	Error code or supervisor;								driver number;				dpage		=	GS/OS direct page;				B			=	ENTRY;				X reg		=	undefined;				Y reg		=	undefined;		;*******************************************************					;EXPORT	set_old_scsiset_old_scsi		PROC					lda		<slot_no			;save the slot number					ldy		#slot				;point to slot field					sta		[iorec_ptr],y		;slot number					lda		#old_scsi_card					ldy		#hwd_type			;save hardware version					sta		[iorec_ptr],y					lda		#old_card_attrbs	;old apple card default attributes					ldy		#io_attrbs					sta		[iorec_ptr],y					lda		<slot_no			;get the slot number					and		#slot7				;mask off internal/external bit					asl		a					;times 16					asl		a					asl		a					asl		a					adc		#io_space+$0080		;dev-sel address $C0NX					ldy		#scsi_base			;offset for base_address of scsi port in record					sta		[iorec_ptr],y		;the base addr bank & dma address already zero					sta		<io_offset			;the bank and DMA controller address := $0000					stz		<io_offset+2					tax					SHORTM						;m=1 to fix the F.O. Hardware.					lda		>card_priot_reg,x	;get the priority for this card					bne		@75					;if no jumper installed force priot 7					lda		#$80@75					LONGM					and		#$00FF				;mask of read from $C0NB					ldy		#initpriot			;set it as initiator priority					sta		[iorec_ptr],y					lda		#$0000				;clear other fields in I/O record					ldy		#scsi_bank					sta		[iorec_ptr],y		;clear bank field of scsi controller base addr					ldy		#dma_base					sta		[iorec_ptr],y		;clear DMA controller base addr & bank					ldy		#dma_bank					sta		[iorec_ptr],y					ldy		#io_attrbs					sta		[iorec_ptr],y					ldy		#d0logicals			;clear logical unit fields for scsi devices@100				sta		[iorec_ptr],y		;8 device fields 2 bytes each scsi device					iny					iny					cpy		#max_scsi_devs\							*2+d0logicals		;2 bytes per device field					bcc		@100					ldy		#initpriot			;initiator priority					lda		[iorec_ptr],y					jsr		priot_to_dev		;convert to scsi device number					asl		a					;times 2 because I/O record dev fields = words					clc					adc		#d0logicals			;point to device fields  within i/o record					tay					lda		#dont_scan_dev		;do not scan initiator priority for logicals					sta		[iorec_ptr],y					inc		<numscsi_cards		;bump the scsi cards total					rts							;>>>--- set_old_scsi --->>>					ENDP					EJECT					;EXPORT	orecv_byteorecv_byte			PROC;********************************************************	This routine will read ONE byte from the NCR 5380 in programmed I/O mode.*	The routine assumes that the phases are in a input phase where data is*	being received by the initiator.**	ENTRY:	e=0*		io_offset = C0NX address space for NCR 5380**	Exit	e,m,x = 0*		A = $00XX (byte read from the 5380)*;*******************************************************					php					SHORTM						;m=1					ldx		<io_offset			;point to proper io location					lda		>currdata,x			;get the byte					xba							;save it away					lda		#asrtack			;assert ACK*					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register@req_loop			lda		#<req				;wait for REQ* to go false					and		>curbusstat,x		;get current scsi bus status					bne		@req_loop			;and wait until REQ* is false					lda		>initcmdreg,x		;get initiator cmd register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					LONGM						;m=0					xba							;restore the byte					and		#$00FF				;keep low byte only					plp							;m=?					rts					ENDP					EJECT					;EXPORT callzpgcallzpg				PROC;********************************************************	This routine will pass control to location $0080 of the*	SCSI Manager zero page. It assumes there is valid code to*	run at that location. This routine MUST be called through*	a JSL instruction because the code in zero page will return*	through an RTL instructinon.**	ENTRY: e=0,m=0,x=0**	Exit:	e,m,x=0*		registers trashed*;*******************************************************					pea		$0000				;force bank $00 for code bank and data bank					plb							;flush one byte off the stack					tdc					clc					adc		#zeropg_code					dec		A					pha					rtl							;call routine in zero page					ENDP					EJECT;*******************************************************;;	'ozeropgcode';;	This routine will send or receive a number of bytes;	to or from a scsi i/o port.  This call assumes that;	the scsi port is in a appropriate phase to send or;	receive bytes  Depending on whether bytes are being;	sent or received a low level routine in SCSI Manager;	zero page will be modified to send or receive bytes.;	Note: The routine is optimized for fast transfers. It;	assumes that once a byte is found bytes will come in;	faster than we can check for them The second check;	for a byte should only occur if we are talking to;	slow scsi devices.;;                ENTRY:	e,m,x=0;			X = $C0NX;			sndbptr	= pointer to buffer to send;			sndbcnt	= byte count to send;;                Exit: 	e,m,x = 0;			sndbcnt = $00000000;;*******************************************************					;EXPORT		ozeropgcodeozeropgcode			PROC					SHORTM						;m=1@100				bit		|busstat,x			;check for DRQ					bvs		patch1					lda		#phasematch			;check for a phase mismatch					bit		|busstat,x					bne		@100				;keep going until count expires or phase												;change					bra		patch1statloop			bit		|busstat,x			;check for DRQ					bvc		nextcheckbumpcount			iny							;bump count/buffer index					beq		uppercheck					EXPORT		patch1patch1				lda		[buffer_ptr],y		;transfer a byte					sta		|opdmadatareg,xnextcheck			bit		|busstat,x			;check for DRQ                                                                                                                                                                                                                                                                                                                                                                                                                                                                                					bvs		bumpcount			;go transfer another byte					lda		#phasematch			;check for a phase mismatch					bit		|busstat,x					bne		statloop			;keep going until count expires or phase												;change					sep		#$40				;mark phase changed status					iny							;adjust the transfered byte count for humans					bne		exit_byteio					LONGM						;m=0					inc		<buffer_ptr+2		;bump the high word of the buffer					inc		<byte_ctr+2			;bump the high word of the byte count					bra		exit_byteio			;phase changed go awayuppercheck			LONGM						;m=0					inc		<buffer_ptr+2		;bump high word of buffer address					inc		<byte_ctr+2			;bump high word of byte count					SHORTM						;m=1					bne		patch1				;keep going until zero												;												; exit byte I/O routine												;exit_byteio			LONGM						;m=0					clc					rtlsize				equ		*-ozeropgcode					IF		 size	AND	$00000001	then	;check if odd byte count					nop							;odd byte count insert NOP					ENDIF					EXPORT		oscsibytesize:equoscsibytesize		equ		*-ozeropgcode		;number of bytes in routine					ENDP									EJECT					;EXPORT	ocopyzcodeocopyzcode			PROC;********************************************************	This module copies some high speed routines into zero page space reserved*	for low level I/O fast access routines.  These routines are specific to*	the OLD scsi card.**	ENTRY:	e,m,x=0*		X= byte count to copy**	Exit:	X = trashed*;*******************************************************					ldx		#oscsibytesize@100				lda		|ozeropgcode,x		;copy words at a time					sta		<zeropg_code,x					dex					dex					bpl		@100					rts						ENDP						EJECT					;EXPORT	oinit_5380oinit_5380			PROC;********************************************************	This routine will initialize the NCR 5380 chip on an old scsi card*	implementation.  Also, it enables pseudo-DMA mode on the 5380 and on the*	SCSI card.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0*;*******************************************************					php					SHORTM					phx					ldx		<io_offset					lda		#dmaenable			;enable DMA on the 5380					ora		>modereg,x			;in the mode register					and		#$7F				;mask off block mode dma					sta		>modereg,x					lda		#$00					sta		>opdmareg,x			;enable pseudo DMA xfers old card					plx					longa	on					plp							;m=?					rts					ENDP					EJECT					;EXPORT	ozap_5380ozap_5380			PROC;********************************************************	This routine will initialize the NCR 5380 registers on the old scsi card*	to a known state.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0*;*******************************************************					php					SHORTM						;m=1					phx					ldx		<io_offset					lda		#$0000				;write zeros to registers					sta		>initcmdreg,x		;initiator command register					sta		>modereg,x					sta		>targcmdreg,x		;target command register					plx					longa	on					plp							;m=?					rts					ENDP					EJECT					;EXPORT	opdmaoffopdmaoff			PROC;********************************************************	This routine will turn of DMA mode in the 5380 and check to see if the*	target phase bits changed to a new phase.**	ENTRY:	e,m,x = 0*		X=Dev-sel registers offset**	Exit:	e,m,x = 0*		C=1 if phase changed*;*******************************************************					SHORTM					lda		#dmaenable--$FF		;read 5380 mode register					and		>modereg,x			;clear dma enable bit					sta		>modereg,x					LONGM					rts					ENDP					EJECT					;EXPORT	oscsi_dma_enaboscsi_dma_enab		PROC;********************************************************dma_enable:    This module will set DMA mode in the NCR 5380*       	and dma mode in the Sandwich chip.  If carry is*       	set then Pseudo-DMA will be enabled in the*       	sandwich chip.**       ENTRY: e=0,m=0,x=0*              Carry = 0        set true DMA in sandwich*              Carry = 1        set Pseudo DMA in sandwich*            	  D = $C0XX (points to dev-sel space for card selected)**       Exit: e=0,m=1*             A=trashed*;*******************************************************					php							;save m,x					SHORTM					ldx		<io_offset			;point to dev-sel space					lda		#<dmaenable			;turn on dma mode in 5380					ora		>modereg,x					sta		>modereg,x					longa	on					plp							;restore m,x					rts					ENDP									;EXPORT	oscsi_dma_disaboscsi_dma_disab		PROC;********************************************************oscsi_dma_disab:	This routine will disable ANY dma modes which*       		may be set.**       ENTRY: e=0,m=0*              io_offset = I/O space index**       Exit: same as ENTRY*;*******************************************************					php							;save m,x					SHORTM					ldx		<io_offset			;index for I/O registers					lda		>modereg,x			;read the mode register					and		#<%11111101			;disable DMA in 5380					sta		>modereg,x					longa	on					plp							;restore m,x					rts					ENDP					EJECT;********************************************************set_ack:       This routines will set the ACK* line true or false.**       ENTRY: e=0,m=0*              io_offset = I/O space index*              carry = 1        set ACK* true*              carry = 0        set ACK* false**       Exit: A= trashed*;*******************************************************					;EXPORT	set_ack_trueset_ack_true		PROC					php							;save m,x					SHORTM					ldx		<io_offset			;I/O address offset					lda		#<asrtack					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register					longa	on					plp							;restore m,x					rtsset_ack_false		PROC 					php							;save m,x					SHORTM					ldx		<io_offset			;I/O address offset					lda		>initcmdreg,x		;get initiator cmd register					and		#<%10001111			;mask off tst mode,diff. mode, ACK*					sta		>initcmdreg,x		;write out modified register					longa	on					plp							;restore m,x					rts					ENDP					EJECT******************************************************************wait_req       This routines will wait for REQ* to go true or*       	false.**       ENTRY: e=0,m=0**       Exit: A= trashed******************************************************************					;EXPORT	wait_req_truewait_req_true		PROC					php							;save m,x					SHORTM					ldx		<io_offset@100				lda		#<req					and		>curbusstat,x		;get current scsi bus status					beq		@100				;and wait until REQ* is true					longa	on					plp							;restore m,x					rtswait_req_false		PROC     					php							;save m,x					SHORTM					ldx		<io_offset@100				lda		#<req					and		>curbusstat,x		;get current scsi bus status					bne		@100				;and wait until REQ* is false					longa	on					plp							;restore m,x					rts					ENDP							EJECT					;EXPORT	wait_drq_truewait_drq_true		PROC******************************************************************wait_drq_true: This routine will wait for DRQ (DMA request) to*       	go true or false depending on the setting of the*       	carry bit.**       ENTRY: e=0,m=0*            	io_offset = I/O space index*              carry = 1        wait for DRQ* to        be asserted*              carry = 0        wait for REQ* to        be deasserted**       Exit: A= trashed******************************************************************					php							;save m,x					SHORTM@loop				ldx		<io_offset					lda		#<drq					and		>busstat,x			;get DMA request status					beq		@loop				;and wait until REQ* is true					longa	on					plp							;restore m,x					rts					ENDP					EJECT					;EXPORT	wait_busywait_busy			PROC******************************************************************Wait_busy:     This routine waits for BSY* to go true before*       	returning to the caller.**       ENTRY: e=0,m=0*            	io_offset = I/O space index**       Exit: same as ENTRY******************************************************************					php							;save m,x					SHORTM					ldx		<io_offset@10					lda		>curbusstat,x		;check for busy					and		#<bsy					beq		@10					;and wait until it comes					longa	on					plp							;restore m,x					rts					ENDP					EJECT					;EXPORT	message_phasemessage_phase		PROC******************************************************************message.phase: This routine will waits for the message phase*       	and reads in the message byte.**       ENTRY: e=0, m=0*            	io_offset = I/O space index**       Exit: same as ENTRY******************************************************************					php							;save m,x					SHORTM					ldx		<io_offset@req_loop			lda		#<req					and		>curbusstat,x		;get current scsi bus status					beq		@req_loop			;and wait until REQ* is true					lda		>currdata,x			;get message byte from target					pha							;save the status					lda		#asrtack					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					pla							;restore status byte					longa	on					plp							;restore m,x					rts					ENDP							EJECT					;EXPORT	status_phasestatus_phase		PROC******************************************************************status_phase:  This routine will set the REQ*, I/O* & C/D**       	lines to match the status phase signal setup**       ENTRY:	e=0, m=0*            	io_offset = I/O space index**       Exit: same as ENTRY******************************************************************					php							;save m,x					SHORTM					ldx		<io_offset@req_loop			lda		#<req					and		>curbusstat,x		;get current scsi bus status					beq		@req_loop			;and wait until REQ* is true					lda		>currdata,x			;get SCSI status byte from target					pha							;save the status					lda		#asrtack			;assert ACK*					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					pla							;restore status byte					longa	on					plp							;restore m,x					rts					ENDP							EJECT					EXPORT	chkbusfloatchkbusfloat			PROC**********************************************************************************	This routine will attempt to check if the SCSI bus is floating due to*	no peripherals turned on or connected to the current card/port.  SCSI*	peripherals provide termination power.  This check is not 100% effective*	since the bus floating can float signals high or low depending on how*	the hardware feels!!  This routine is intended as a gross check for no*	target or target powered off.**	ENTRY	e,m,x = 0*		None**	Exit:	e,m,x=0*		registers used are saved and restored**********************************************************************************					phx							;save registers					pha					jsr		bus_status			;read the status of the scsi bus signals					and		#bsy\				;mask off unwanted bits except for BSY							+sel\				;SEL							+io\				;I/O							+cd\				;C/D							+msg				;MSG					clc							;assume not floating												;												; since we did a bus reset ealier the												; result must be zero or else we assume												; it is a floating bus.												;					beq	fexitfloat				sec							;assume floatingfexit				pla							;restore registers					plx					rts							ENDP									EJECT					;EXPORT	wait_for_phasewait_for_phase		PROC*********************************************************************************	This routine will wait for a phase specified by the contents of the*	accumulator. If the phase changes to a phase other than the requested*	phase, the V bit will be set and carry will be cleared.  On exit, if the*	phase matches the requested phase then the Target command register bits 0-2*	will be set to match the requested phase.**	ENTRY:	e,m,x=0*		A = phase bit pattern*		+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*		|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*		+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+* 		 | | | | | | | | | | | | | | | |* 		 | | | | | | | | | | | | | +-+-+------ (MSG,C/D,I/O) Phase bit pattern:* 		 +-+-+-+-+-+-+-+-+-+-+-+-+------------ Reserved**	Exit:	e,m,x = 0*		C = 0,V = 0 if changed to phase requested*		C = 0,V = 1 if phase changed to phase other than requested*		C = 1,V = X if phase lines never changed during the sampling period*		A = phase bit pattern**	Phase bit combinations:*	000 = Data Out*	001 = Data In*	010 = Command*	011 = Status*	100 = Invalid phase (reserved for future scsi standard expansion)*	101 = Invalid phase (reserved for future scsi standard expansion)*	110 = Message Out*	111 = Message IN*********************************************************************************					and		#$0007				;mask off upper 13 bits					pha							;save phase bits												;												; save the current phase setting												;					ldx		<io_offset					lda		>curbusstat,x		;get target command register					lsr		A					lsr		A					and		#$0007					sta		|phase_hold												;												; clear possible ACK asserted bit												;					SHORTM					lda		#asrtack--\							%10011111					and		>initcmdreg,x		;include other bits in register					sta		>initcmdreg,x		;write out new initiator cmd. reg.					LONGM												;												; 196608 times retry count for valid												; phase check												;					stz		<scratchzpg			;retry count := count * $10000					lda		#wait_phase_rcnt					sta		<scratchzpg+2												;												; check the bus status for the phase												; we want												;@100				sec							;assume timeout					dec		<scratchzpg			;decrement retry count					bne		@150					dec		<scratchzpg+2					beq		error@150				ldx		<io_offset			;point to specific i/o space					lda		>curbusstat,x		;get target command register					and		#$00FF					tax							;save the phase bits					and		#bsy++sel			;look for BSY* asserted and SEL* not asserted					beq		@100					cmp		#bsy				;bsy and/or sel set check which					bne		@100				;if sel* asserted  then check again					txa							;get the status back					lsr		A					;REQ*,I/O*,C/D* to low 3 bits					lsr		A					and		#$0007				;mask off upper 13 bits					cmp		|phase_hold			;check if phase has changed					beq		@100				;wait until match					sep		#$40				;phase changed, assume not the phase we want					cmp		1,s					;check if sought phase					bne		@100				;phase other than requested (go along with it)					rep		#$40				;V=1 & C=0 if phase other than sought					SHORTM					ldx		<io_offset			;point back to the dev-sel space for this card					lda		1,s					;set the target command register to match phases					sta		>targcmdreg,x					LONGM@200				clc							;got the phase we wanterror				pla					rts**********************************************************************************get_phase:*	This routine will read the phase bits and return them in the accumulator*	It will also return the overflow bit set if we are in a bus free phase.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0*		A = b2 = MSG*		    b1 = C/D*		    b0 = I/O**		V = 1 if bus free*		C = 1 if invalid phase**********************************************************************************					;EXPORT	get_phaseget_phase			ldx		<io_offset			;point to specific i/o space					sep		#$40				;V=1 assume bus free					lda		>curbusstat,x		;get target command register					and		#$00FF				;low byte only					lsr		A					;REQ*,I/O*,C/D* to low 3 bits					lsr		A					bcs		exit				;if C=1 then SEL* asserted and should not be					cmp		#bsy				;check for BSY* asserted					bcc		@100					clc					clv							;V=0 not bus free@100				and		#%00000111			;mask off upper 5 bitsexit				rts					ENDP					EJECT;*******************************************************;;	'bus_reset';;	This routine will assert the scsi RST* line for 125;	usec (Mac recomended value) and clear the bus reset.;;	NOTE: 	The 125 usec delay will be approx. 2.8 times;			longer if running in slow mode.  The routine;			does not check system speed.  Also, it is;			the responsibility of the caller to delay;			275 milliseconds to allow time for the scsi;			devices to initialize themselves.;;	Inputs:		e,x			=	0 (full native);				m			=	undefined;				io_offset	=	dev-sel space index;				Acc			=	undefined;				X reg		=	undefined;				Y reg		=	undefined;				dpage		=	Ours;				Stack		=	undefined;				Bank		=	Ours;				Speed		=	undefined;;	Output:		e,m,x		=	ENTRY;				Carry		=	ENTRY;				Acc			=	undefined;				X reg		=	ENTRY;				Y reg		=	ENTRY;				dpage		=	ENTRY;				Stack		=	ENTRY;				Bank		=	ENTRY;				Speed		=	ENTRY;		;*******************************************************					;EXPORT	bus_resetbus_reset			PROC					php							;save m,x					sei					SHORTM					phx							;save registers					ldx		<io_offset					lda		#%10000000			;scsi bus reset					sta		>initcmdreg,x					lda		#<usec125			;delay 125 usecsusec_delay_loop		dec		A					bne		usec_delay_loop					lda		>initcmdreg,x		;clear scsi bus reset bit and					and		#<%00011111			;test mode bit and differential bit					sta		>initcmdreg,x					plx					plp							;restore m,x					rts					longa	on					ENDP					EJECT;*******************************************************;;	'chk_sel_tout';;	This routine will check for select timeout.  From;	the time the initiator removes BSY* the target must;	assert BSY* within a select ABORT time.  If this;	does not occur then carry will be set to mark an;	error.;;	Inputs:		e,x			=	0;				m			=	1;				Acc			=	undefined;				X reg		=	io_offset;				Y reg		=	undefined;				dpage		=	io_offset;				Bank		=	Ours;				Stack		=	GS/OS;				Speed		=	undefined;;	Output:		e,m,x		=	ENTRY;				Acc			=	undefined;				X reg		=	ENTRY;				Y reg		=	ENTRY;				Carry		=	0 for select success;								1 for select failure;				dpage		=	ENTRY;				Bank		=	ENTRY;				Speed		=	ENTRY;		;*******************************************************					;EXPORT	chk_sel_toutchk_sel_tout		PROC					longa	off					;m=1					phy							;save register					ldy		#sel_timeout		;count for delay of 250 millisec min@loop				lda		<curbusstat			;check for BSY* from target					and		#<bsy					bne		@selected			;go away if target responded					dey							;decrement count					bne		@loop				;keep checking until count=0 or					ply							;restore register					sec							;count=00 report error					rts@selected			ply							;restore register					clc					rts					longa	on					ENDP					EJECT;*******************************************************;;	'sel_abort_wait';;	This module will wait release the SCSI data bus and;	wait one select abort timeout (200 usec) while;	checking for BSY* from the desired target device.;	If BSY* is not received from the target then SEL*;	will be released and the bus will be allowed to go;	back to the bus free phase and the carry will be set.;;	Inputs:		e,x			=	0;				m			=	1;				Acc			=	undefined;				X reg		=	io_offset;				Y reg		=	undefined;				dpage		=	io_offset;				Bank		=	Ours;				Stack		=	GS/OS;				Speed		=	undefined;;	Output:		e,m,x		=	ENTRY;				Acc			=	undefined;				X reg		=	ENTRY;				Y reg		=	ENTRY;				Carry		=	0 BSY* asserted;								1 failure;				dpage		=	ENTRY;				Bank		=	ENTRY;				Speed		=	ENTRY;		;*******************************************************					;EXPORT	sel_abort_waitsel_abort_wait		PROC					longa	off					;m=1					phy							;save register					ldy		#<sel_abort_tout 	;select abort timeout@loop				lda		<curbusstat			;SCSI bus status register					and		#<bsy				;check for BSY* from target					bne		@pass				;if BSY* asserted then OK					dey							;decrement timer					bne		@loop				;until zero					ply							;restore register					sec							;mark an error					rts@pass				ply							;restore register					clc							;mark success					rts					ENDP					EJECT					;EXPORT	match_phasesmatch_phases		PROC******************************************************************match_phases:  This routine will set the MSG*, C/D* and I/O**       lines on the initiator 5380 the same as the*       MSG*, C/D* and I/O* lines on the target.  The*       routine toggles lines, it does not look to make*       sure that the we have made through the arbitrate*       and select phases successfully.**       ENTRY: e=0*              X=register offset**       Exit: Same as ENTRY******************************************************************					php							;save m,x					SHORTM					lda		>curbusstat,x		;get the settings of MSG*,C/D*,I/O*					lsr		A					;set MSG, C/D, I/O as low 3 bits					lsr		A					and		#<%00000111			;mask off remaining bits					sta		>targcmdreg,x					longa	on					plp							;restore m,x					rts					ENDP					EJECT					;EXPORT pdma_recv_datapdma_recv_data		PROC******************************************************************pdma_recv_data  This routine will read 512 bytes of data from a*                a target device.  The data will be stored in*                the location pointed by [data_buffer_ptr].  The*                byte count will be specified by RECV_SIZE. The*                routine expects to use pseudo dma mode to do the*                data transfers. It calls the enable dma routine*                with carry set to enable the pseudo dma mode.**                ENTRY: e=0*                          (data_buffer_ptr:long word) = data buffer address*                          (recv_size:word) = number of bytes to receive*                       X = register offset for specific 5380**                Exit:  same as ENTRY******************************************************************					clc							;data phase complete					rts					ENDP					EJECT					;EXPORT	rdma_recv_datardma_recv_data		PROC******************************************************************rdma_recv_data This routine will read 512 bytes of data from a*       	a target device. The data will be stored in*      	 	the location pointed by [data_buffer_ptr].  The*       	byte count will be specified by RECV_SIZE. The*       	routine expects to use pseudo dma mode to do the*       	data transfers. It calls the enable dma routine*       	with carry set to enable the pseudo dma mode.**       ENTRY: e=0*                 (data_buffer_ptr:long word) = data buffer address*                 (recv_size:word) = number of bytes to receive*              X = register offset for specific 5380**       Exit:  same as ENTRY******************************************************************					clc							;data phase complete					rts					ENDP					EJECT					;EXPORT	rdma_send_datardma_send_data		PROC******************************************************************rdma_send_data This routine will write 512 bytes of data to a*       	a target device. The data will be stored in*       	the location pointed by [data_buffer_ptr].  The*      	 	byte count will be specified by xmit_SIZE. The*       	routine expects to use real dma mode to do the*       	data transfers. It calls the enable dma routine*       	with carry clear to enable the real dma mode.**       ENTRY: e=0*              carry = 0 (real dma)*              (data_buffer_ptr:long word) = data buffer address*              (recv_size:word) = number of bytes to receive*              X = register offset for specific 5380**       Exit:  same as ENTRY******************************************************************					clc							;data phase complete					rts					ENDP					EJECT					;EXPORT	bus_statusbus_status			PROC****************************************************************** This module will read the status registers from the SCSI chip* and return them to the caller in the accumulator.  This code* can be called in native or emulation mode. Bits 0-7 will be* returned in the A register and bits 8-15 will be returned in the* B register.**          Stat_reg:*          +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*          |F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*          +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*           | | | | | | | | | | | | | | | |*           | | | | | | | | | | | | | | | +---- Data bus parity*           | | | | | | | | | | | | | | +------ SEL**           | | | | | | | | | | | | | +-------- I/O**           | | | | | | | | | | | | +---------- C/D**           | | | | | | | | | | | +------------ MSG**           | | | | | | | | | | +-------------- REQ**           | | | | | | | | | +---------------- BSY**           | | | | | | | | +------------------ RST**           | | | | | | | +-------------------- ACK**           | | | | | | +---------------------- ATN**           | | | | | +------------------------ Busy error*           | | | | +-------------------------- Phase Match*           | | | +---------------------------- IRQ request*           | | +------------------------------ Parity Error*           | +-------------------------------- DMA Request*           +---------------------------------- End of DMA**       ENTRY:  e,m,x=0**       Exit:   e,m,x=0*		C reg = bus status word******************************************************************					phx							;save register					ldx		<io_offset			;io address					lda		>curbusstat,x					plx							;restore register					rts					ENDP					EJECT					EXPORT	clear_stateclear_state			PROC*************************************************************************************	This routine will remove a pending task which has timedout.  It clears the*	work variables within the SCSI Manager record (SDR) removes the task from*	the SCSI bus and returns an error to the caller.**	ENTRY:	e,m,x = 0*		[sdr_ptr] points to the record to discard**	Exit:	e,m,x = 0*		A,X,Y undefined*************************************************************************************												;												; save some scsi manager internals												;					lda		<io_offset+2					pha					lda		<io_offset					pha												;												; point to the I/O space corresponding												; to this SDR												;					ldy		#sdr_5380_base					lda		[active_sdr],y					sta		<io_offset					tax							;I/O index register					ldy		#sdr_5380_base+2					lda		[active_sdr],y					sta		<io_offset+2												;												; send abort message to the target												;					lda		#abort_msg			;setup message out byte in case end up in msgout phase					sta		|msg_out_byte					SHORTM					lda		#attention					ora		>initcmdreg,x		;include other bits of register					and		#<%10011111			;mask off test & differential					sta		>initcmdreg,x		;write out modified register					LONGM					lda		#msg_out_phase					jsr		wait_for_phase					bcs		@75					bvs		@75					;phase changed to other than requested												;												; send the abort byte to the target												; right now!												;					ldx		<io_offset			;point to proper io location					SHORTM					lda		#attention--\		;Remove Attention							%10011111					and		>initcmdreg,x		;include other bits in register					sta		>initcmdreg,x		;write out new initiator cmd. reg.					lda		>modereg,x			;use programmed I/O mode					pha							;save mode register					and		#$FD					sta		>modereg,x@req_loop			lda		#<req					and		>curbusstat,x		;get current scsi bus status					beq		@req_loop			;and wait until REQ* is true					lda		#abort_msg			;send the abort message					sta     >outdatareg,x		;write out the byte					lda		#asrtack			;assert ACK*					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register@req_loop1			lda		#<req				;wait for REQ* to go false					and		>curbusstat,x		;get current scsi bus status					bne		@req_loop1			;and wait until REQ* is false					lda		>initcmdreg,x		;get initiator cmd register					and		#%10011111--\		;mask off tst mode,diff. mode							asrtack				;and strip ACK*					sta		>initcmdreg,x		;write out modified register					pla							;restore mode register					sta		>modereg,x					LONGM					bra		@85												;												; if "wait for phase" timed out reset												; the bus												;@75					jsr		bus_reset@85					ldx		<io_offset					lda		#invalid_phase1					sta		>targcmdreg,x												;												; toggle 5380 DMA enable bit to allow												; req to come through												;					SHORTM					lda		#dmaenable					eor		>modereg,x					sta		>modereg,x					eor		>modereg,x					sta		>modereg,x					LONGM					jsr		cleanup_sdr@100				pla					sta		<io_offset					pla					sta		<io_offset+2					stz		|more_phases		;forces exit in phase handler					rts					ENDP					EJECT;*******************************************************;;	'zap_oldcard';;	This module will reset some parameters kept in the;	OLD SCSI card's ram.  This will force the card to;	rebuild its tables (SDATS) when control is passed;	to PRODOS 8.;;	Inputs:		e,m,x		=	0;				Acc			=	undefined;				X reg		=	io_offset;				Y reg		=	undefined;				dpage		=	Ours;				Bank		=	Ours;				Stack		=	GS/OS;				Speed		=	undefined;;	Output:		e,m,x		=	ENTRY;				Acc			=	undefined;				X reg		=	ENTRY;				Y reg		=	ENTRY;				Carry		=	undefined;				dpage		=	ENTRY;				Bank		=	ENTRY;				Speed		=	ENTRY;		;*******************************************************					EXPORT	zap_oldcardzap_oldcard			PROC												;												; save work registers for later restore												;					phx					phy												;												; Initialize the loop counter.												;					lda		#16-1					sta		@loop_count												;												; Start with the first I/O Record												;					lda		<io_table_ptr					sta		<iorec_ptr					lda		<io_table_ptr+2					sta		<iorec_ptr+2												;												; Is it a valid Slot?												;@loop				lda		[iorec_ptr]					beq		@next_slotl			;No.  Next Slot												;												; Is it the old Card?												;					ldy		#hwd_type					lda		[iorec_ptr],y					beq		@old_card			;Shut Down Old Card.					cmp		#$0001				;Is it Cocoon?					bne		@next_slotl			;No.  Next Slot												;												; Shut of Sandwich Chip.												;					ldy		#scsi_base			;point to card DEV-SEL space					lda		[iorec_ptr],y					tax					lda		#$0000					SHORTM					sta		>initcmdreg,x					sta		>modereg,x					sta		>targcmdreg,x					sta		>sel_enabl_reg,x					sta		>dmaaddrl,x					sta		>dmaaddrh,x					sta		>dmacntl,x					sta		>dmacnth,x					sta		>dmactl,x					LONGM@next_slotl			bra		@next_slot			;No.  Next Slot												;												; Old Card. Reset I/O Strobe memory												; ($C800-$CFFE) and turn on this cards												; I/O strobe space												;@old_card			lda		>io_stbreset		;access $CFFF (reset I/O strobe space)					ldy		#slot				;get the slot number					lda		[iorec_ptr],y					and		#slot7				;mask off the external slot bit					xba							;times $100					tax							;access $CNXX space to turn on I/O strobe space					lda		>io_space,x			;for this card												;												; point to bank $00 of the old card's ram												;					ldy		#scsi_base			;point to card DEV-SEL space					lda		[iorec_ptr],y					tax					lda		#$0000				;point to card's bank zero rom and bank												;zero ram					SHORTM					sta		>ocard_breg,x					LONGM												;												; zero out working parameters in the												; cards ram (forces tables reinit)												;					lda		#0000					sta		>scsi_init			;clear init flag					sta		>sdat_start			;clear SDAT ID's					sta		>sdat_start\							+dibtab_len*1					sta		>sdat_start\							+dibtab_len*2					sta		>sdat_start\							+dibtab_len*3					sta		>sdat_start\							+dibtab_len*4					sta		>sdat_start\							+dibtab_len*5					sta		>sdat_start\							+dibtab_len*6					sta		>dibtab_start		;clear dibtab ID's.					sta		>dibtab_start\							+dibtab_len*1					sta		>dibtab_start\							+dibtab_len*2					sta		>dibtab_start\							+dibtab_len*3					sta		>dibtab_start\							+dibtab_len*4					sta		>dibtab_start\							+dibtab_len*5					sta		>dibtab_start\							+dibtab_len*6					inc		a					sta		>gs_flag			;force GS_flag true (nonzero)												;												; Any more to do?												;@next_slot			dec		@loop_count					bmi		@out				;No.  Out of here.												;												; Yes.  Bump the pointer to the next 1.												;					clc					lda		<iorec_ptr					adc		#iorec_size					sta		<iorec_ptr					brl		@loop@out				ply					plx					rts												;												; Loop Counter.												;@loop_count			dc.w	$0000					ENDP						EJECT;*******************************************************;;	'cocoon_data';;	This area contains the data that will be switched;	during a re_selection;;	Inputs:		None.;;	Output:		None;		;*******************************************************					;EXPORT	cocoon_datacocoon_data			PROC					EXPORT	DMA_req_countDMA_req_count		dc.l	null				;Remaining Count to read					EXPORT	DMA_buffer_ptrDMA_buffer_ptr		dc.l	null				;Current Buffer Pointer					EXPORT	DMA_dma_cntDMA_dma_cnt			dc.w	null				;DMA Count		this time					EXPORT	DMA_dma_addrDMA_dma_addr		dc.w	null				;DMA Address	this time					EXPORT	DMA_dma_bankDMA_dma_bank		dc.w	null				;DMA Bank		this time					EXPORT	DMA_directionDMA_direction		dc.w	null				;DMA direction	you know.					EXPORT	DMA_do_bank_chkDMA_do_bank_chk		dc.w	null				;Validate Bank rollover if ­ 0					ENDP					EJECT;*******************************************************;;	'context_data';;	This area contains the space that is used for the;	Cocoon Context switch durring Disconnect and;	Re-Selection.  Each Table has enough space for;	eight (8) entries or disconnects.;;	Inputs:		None.;;	Output:		None;		;*******************************************************context_data		PROC	;EXPORTCTX_req_cnt_l		dcb.w	8,null				;Remaining Low Count to readCTX_req_cnt_h		dcb.w	8,null				;Remaining High Count to readCTX_buff_ptr_l		dcb.w	8,null				;Current Low Buffer PointerCTX_buff_ptr_h		dcb.w	8,null				;Current High Buffer PointerCTX_dma_cnt			dcb.w	8,null				;DMA CountCTX_dma_addr		dcb.w	8,null				;DMA AddressCTX_dma_bank		dcb.w	8,null				;DMA BankCTX_direction		dcb.w	8,null				;DMA direction	you know.CTX_do_bank_chk		dcb.w	8,null				;Validate Bank rollover if ­ 0CCON_dmaaddr		dcb.w	8,null				;Current Cocoon DMA AddressCCON_dmacntl		dcb.w	8,null				;Current Cocoon DMA CountCCON_dmactl			dcb.b	8,null				;Current Cocoon DMA Control RegisterGS_bank_reg			dcb.b	8,null				;Current GS Bank Register ($00C037)					ENDP					EJECT					END