;*******************************************************;;	'SCSIM.Variables';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains all Variable Storage used by the;	SCSI Manager;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816;					IMPORT		;					ENTRY							PRINT		OFF					INCLUDE		'SCSIM.Equates'					PRINT		ON					EJECT;*******************************************************;;	SCSI Manager internal variables;;*******************************************************					EXPORT	scsi_variablesscsi_variables		PROC					EXPORT	smbusy_flag					EXPORT	sdriver_no_hold					EXPORT	sm_call_no					EXPORT	zpg_savebuff					EXPORT	gsos_zpg_hold					EXPORT	handle_hold					EXPORT	user_id					EXPORT	zpg_hold					EXPORT	zpg_handle					EXPORT	busy_sdr_count					EXPORT	asense_flag					EXPORT	our_irq_flag					EXPORT	ahold					EXPORT	devices_found					EXPORT	hwd_version					EXPORT	ioattrbs					EXPORT	last_acc_id2					EXPORT	lutemp					EXPORT	ckluflag					EXPORT	last_acc_slot2					EXPORT	yhold					EXPORT	work_vars_buffer					EXPORT	last_sdr_ptr2					EXPORT	last_acc_slot1					EXPORT	last_acc_id1					EXPORT	last_sdr_ptr1					EXPORT	last_acc_flag					EXPORT	smboot_slot;;					EXPORT	our_zpg_hold					EXPORT	error_stat					EXPORT	scsi_status					EXPORT	scsi_message					EXPORT	more_phases					EXPORT	new_phase					EXPORT	current_phase					EXPORT	init_priority					EXPORT	target_priority					EXPORT	msg_out_byte					EXPORT	more_dci					EXPORT	ident_modify					EXPORT	cyareg_hold					EXPORT	phase_holdsmbusy_flag			dc.w	$0000				;scsi manager busy flag (powers up cleared)ahold				dc.w	$0000yhold				dc.w	$0000user_id				dc.w	$0000				;our ID provided by memory managerhandle_hold			dc.l	$00000000			;our handle place holderzpg_handle			dc.l	$00000000			;zero page handle place holderzpg_hold			dc.w	$0000				;zero page adddress holderour_zpg_hold		dc.w	$0000				;our zero page adddress holdergsos_zpg_hold		dc.w	$0000				;GS/OS zero page placeholdersdriver_no_hold		dc.w	$0000				;scsi Manager supervisor driver numbersm_call_no			dc.w	$0000				;scsi manager call number holderasense_flag			dc.w	$0000				;autosense in progress flagerror_stat			dc.w	$0000		devices_found		dc.w	$0000				;SCSI devices found connected to card/port flaglogicals_found		dc.w	$0000				;Logical units found for scsi device IDlast_acc_slot1		dc.w	$0000				;slot number field of device last accessedlast_acc_id1		dc.w	$0000				;last id accessed holder record 1last_sdr_ptr1		dc.l	$00000000			;pointer to last sdr accessed record 1last_acc_slot2		dc.w	$0000				;slot number field of device last accessedlast_acc_id2		dc.w	$0000				;last id accessed holder record 2last_sdr_ptr2		dc.l	$00000000			;pointer to last sdr accessed record 2last_acc_flag		dc.w	$0000				;flag & index for last access pointer updatingtarget_priority		dc.w	$0000				;target priorityinit_priority		dc.w	$0000				;initiator priorityhwd_version			dc.w	$0000				;hardware version numberioattrbs			dc.w	$0000				;I/O Attributescyareg_hold			dc.b	$00					;cya register holding locationour_irq_flag		dc.w	$0000				;scsi manager interrupt flagmore_dci			dc.w	$0000				;more data chain instructs. available flagmore_phases			dc.w	$0000				;more phases phase handler triggerscsi_status			dc.w	$0000				;scsi call status fieldscsi_message		dc.w	$0000				;scsi call message field;msg_out_byte		dc.w	$0000				;message byte to send during message out phaseident_modify		dc.w	$0000				;Disconnect and other Flagslutemp				dc.w	$0000				;bitpattern for each possible LU on a SCSI IDckluflag			dc.w	$0000				;toggle flag marking when to compare inq bufferssmboot_slot			dc.w	$0000				;slot number boot occuring frombusy_sdr_count		dc.w	$0000				;count of number of busy SDRsphase_hold			dc.w	$0000				;placeholder for current phase bitscurrent_phase		dc.w	$FFFF				;totally invalid valid when loadednew_phase			dc.w	$FFFF				;new phase flag					EXPORT	work_vars_size:equwork_vars_size		equ		*-scsi_variableswork_vars_buffer 	ds.b	work_vars_size		;holding buffer for work variables during IRQzpg_savebuff		ds.b	maxzpg_space					ds.b 27						;added 27 bytes of padding to sparse out one block (30-Jan-92 DAL)					ENDP						EJECT					END