;*******************************************************;;	SCSI Driver Main Driver.;;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************;*******************************************************;;	'SCSIM.Header';;	This file contains all Structures required to be a;	loadable Supervisory Driver.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		scsi_man_exec					IMPORT		scsim_startup					IMPORT		scsim_shutdown					IMPORT		scsim_reqdevs					IMPORT		scsim_claimdevs					IMPORT		scsim_io					IMPORT		oaddr_tbl					IMPORT		cocoon_tbl;					ENTRY							EJECT					INCLUDE		'SCSIM.Equates'					INCLUDE		'Common.Equ.Src'					INCLUDE		'HW.Equ.Src'					PRINT		OFF;					INCLUDE		'M16.MEMORY';					INCLUDE		'M16.UTIL';					INCLUDE		'M16.MISCTOOL'					PRINT		ON			;*******************************************************;;	This dummy Procedure is used to inform the loader,;	'Drivers start with data but are not data segments'.;	The loader may load what it thinks to be a data;	segment accross bank boundries.  This is not good;	for code.;;*******************************************************					;EXPORT	dummydummy				PROC					ENDP			;*******************************************************;;	Header as required by the device dispatcher for;	drivers.;;*******************************************************					;EXPORT		scsi_man_headerscsi_man_header		PROC					dc.l	scsi_man_exec		;Entry address to scsi Manager					dc.w	SCSI_Manager_ID		;scsi manager := $0002scsim_version		dc.w	$5040				;version 2.1 5.0.4					dc.l	manager_name		;name string of manager					EXPORT		scsim_charsscsim_chars			dc.w	$8000				;restartable supervisory driver					dc.w	$0000				;RESERVED					EXPORT		snooper_ptrsnooper_ptr			dc.l	$00000000			;will hold the address of Managers zero pagemanager_name		dc.b	'SCSI.MANAGER'		;SCSI Managerpad					dcb.b	20,' '				;20 spaces of pad for max name 32 bytes;					ENDP;*******************************************************;;	SCSI Manager command table;;*******************************************************;					EXPORT	cmd_tablecmd_table			PROC					dc.w	scsim_startup					dc.w	scsim_shutdown					dc.w	scsim_reqdevs					dc.w	scsim_claimdevs					dc.w	scsim_io					EXPORT	max_cmd:equmax_cmd				equ		(*-cmd_table)/2					ENDP					EJECT;*******************************************************;;	Address table for routines defined for each;	interface type;;*******************************************************;					EXPORT	addr_tablesaddr_tables			PROC;					dc.l	oaddr_tbl			;table for old scsi card					dc.l	cocoon_tbl			;table for Cocoon card;					dc.l	future_tbl;					dc.l	vendor_spec0;					dc.l	vendor_spec1;					dc.l	vendor_spec2;					dc.l	vendor_spec3;					dc.l	vendor_spec4;					dc.l	vendor_spec5;					dc.l	vendor_spec6;					dc.l	vendor_spec7							EXPORT	num_dev_types:equnum_dev_types		equ		(*-addr_tables)/4	;number of device types;					ENDP					EJECT					END