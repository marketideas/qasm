;*******************************************************;;	'SCSIM.Req.Devs';;	Written by:;	;					Gus Andrade;;	Modified for new card by:;;					Matt Gulick.;					Started June 1,1989;;	This file contains code to handle the Request;	Devices Call.;;	Copyright Apple Computer, Inc. 1988,89;	All rights reserved.;;*******************************************************					STRING		PASCAL					BLANKS		OFF					PAGESIZE	70					PRINT		NOGEN					PRINT		NOMDIR					MACHINE		M65816					IMPORT		error_stat					IMPORT		get_plist					IMPORT		zpg_hold;					Entry							PRINT		OFF					INCLUDE		'SCSIM.Equates';					INCLUDE		'Common.Equ.Src';					INCLUDE		'HW.Equ.Src';					INCLUDE		'M16.MEMORY';					INCLUDE		'M16.UTIL';					INCLUDE		'M16.MISCTOOL'					PRINT		ON					EJECT;*******************************************************;;	'scsim_reqdevs';;	This module will handle will return IDs for all;	devices mathching a requested device type.;;	Called via 'JSR';;	Inputs:		e,m,x		=	0 (full native);;	Outputs:	e,m,x		=	0 (full native);				Acc			=	0;				Carry		=	0;				Y reg		=	Unspecified;				X reg		=	Unspecified;				P reg		=	0=M=X=e;				D Page		=	GS/OS Direct Page;				Bank		=	Ours;;	Errors:		See Spec.;;*******************************************************					EXPORT	scsim_reqdevsscsim_reqdevs		PROC					stz		|error_stat		;reset error status					jsr		get_plist		;point to the parameter list					stx		<plist_ptr		;form pointer to parameter list					sty		<plist_ptr+2					ldy		#destbuffptr	;get destination buffer address					lda		[plist_ptr],y					sta		buffer_ptr					ldy		#destbuffptr+2					lda		[plist_ptr],y					sta		buffer_ptr+2					lda		|zpg_hold		;get the driver's zero page address					sta		[buffer_ptr]					ldy		#scsi_dtype		;check for device type					lda		[plist_ptr],y					jsr		devtype_chk		;check for valid device type					bcc		@100					lda		#bad_dev_type					sta		|error_stat					rts						;bad type go away@100				ldx		<sdrsonline		;set number of sdrs to compare against					stx		<sdrstocheck					bne		@200					ldx		#$0000			;zero devices found					txa					pha						;call status					sta		|error_stat					bra		all_done@200				jsr		build_reqlist	;build list of devices matching device typereqexit				rts						;>>>--- scsim_reqdevs --->>>											;											; check for valid scsi device											; type											;devtype_chk			and		#$001F			;low 5 bits only					beq		good_type		;if zero then ok					cmp		#apple_tape		;check for apple tape drive					beq		good_type					cmp		#commdev+1		;check for types A-F					bge		bad_typegood_type			clcbad_type			rts						;>>>--- devtype_chk --->>>											;											; build request list for caller											;build_reqlist		pha					ldx		#$0000			;clear device counter					lda		sdr_table_ptr	;point to the SCSI device records					sta		<scratchzpg					lda		sdr_table_ptr+2					sta		<scratchzpg+2check_type			ldy		#sdr_devtype	;index to device type field					lda		[scratchzpg],y					and		#$00FF			;low byte only (devtype one byte)					cmp		1,s				;compare the types					beq		type_matchchk_next_sdr		dec		<sdrstocheck	;see if more sdrs to check					beq		all_done					ldy		#nxt_sdr_lnk	;point to next sdr in the list					lda		[scratchzpg],y	;check next SDR					pha					ldy		#nxt_sdr_lnk+2					lda		[scratchzpg],y					sta		<scratchzpg+2					pla					sta		<scratchzpg					bra		check_type											;											; Found an SDR record which											; matches the type tell caller											;type_match			ldy		#sdr_device_id	;get the device ID of the target					lda		[scratchzpg],y					bmi		chk_next_sdr	;Device has been claimed					ldy		#device_id					sta		[buffer_ptr],y					ldy		#sdr_slot		;include the slot number					lda		[scratchzpg],y					ldy		#device_slot	;point to Slot number field					sta		[buffer_ptr],y					inx						;bump number of matching devices count					lda		<buffer_ptr		;bump address					clc					adc		#reqEntry_size	;by one Entry size					sta		<buffer_ptr					bcc		chk_next_sdr	;go check the next sdr					inc		<buffer_ptr+2					bra		chk_next_sdr											;											; write out device count found											; to match the type											;all_done			ldy		#destbuffptr	;point to start of the destination buffer					lda		[plist_ptr],y					sta		<scratchzpg					ldy		#destbuffptr+2					lda		[plist_ptr],y					sta		<scratchzpg+2					ldy		#total_devcount	;point to device count field					txa					sta		[scratchzpg],y	;write the count					pla					rts							ENDP						EJECT					END