					TITLE		'GS/OS SCSI Manager' 					MACHINE		M65816					PRINT		ON,GEN,NOSYM,OBJ,MCALL,NOMDIR					PAGESIZE	70		;****************************************************************;	SCSI_Manager:	This program controls access to SCSI devices;	which may by connected to peripheral cards or built'in SCSI;	ports.  The program removes all direct access to the hardware;	from the device drivers. The SCSI Manager controls the;	following:;;	- Hardware resources management.;		1.	Support startup and shutdown as defined by the;			Supervisor Dispatcher.;		2.	Support call interface between SCSI drivers and the;			SCSI manager.;		3.	Built-in NCR 5380 support.;		4.	Support for current SCSI card implementation.;		5.	Low level phase support to access SCSI devices;			a. Bus free Phase;			b. Arbitration Phase;			c. Selection Phase;			d. Reselection Phase;			e. Command Phase;			f. Data Phase.;			g. Bus reset Phase;		6.	Manage SCSI DMA controller.;		7.	SCSI interrupt support (Used in Reselection);	- Message routing between Drivers and physical devices.;	- Cache support as defined by GS/OS;	- Async SCSI call support.;		1.	Issuing calls to devices Asynchronously;		2.	Posting completion routines for Async SCSI calls.;*****************************************************************;;	REVISION HISTORY:;;System Bug Fix		Manager	Creator	Description of bug fixed;Vers:	Date:		Version		;;	5-26-88		D0.01	GAA	Start SCSI Manager code development;;	12-1-88		0.01A	GAA	Alpha release of manager;;	12-12-88	0.02A	GAA	1. Bug fix for crash on startup with;					   no cards present;					2. Added Autosensing support code;					3. Bus float check looks for bus free;					   to tell if card present.;;	12-30-88	0.03A	GAA	1. Fixed a crash bug when autosense was;					   enabled and mode sense call failed.;					2. Fixed a bug where pdmaoff was dropping;					   a byte between data chaining instrucntions;					3. Added code to zero out some of the;					   internal parameters in the old SCSI;					   card to force to rebuild its SDATS;					   when launching a Prodos 8 application;;	01-07-89	0.04	GAA	1. Fixed a bug where the memory I allocated;					   for myself was disposed of when an error;					   was encountered during startup but the;					   code segment was not because I returned;					   to the Supervisory Dispatcher with;					   carry cleared.  This made the system;					   crash in various ways.;;	01-15-89	0.05	GAA	1. Added code to increment the BUSY flag on ENTRY;					   to the SCSI Manager and decrement on exit to;					   prevent access to desk accessories during calls;					   to the SCSI Manager. Long delays in Desk Accs can;					   lockup targets and the Manager.;					2. Phase Handler will no longer hang on a call which;					   has timed out.;					3. Modified the Logical unit scanner to stop the scan;					   for LUs on a scsi ID if access to an LU fails. Will;					   not install the LU that failed and ones that follow.;					4. Now issuing a Test Unit Ready prior to Inquiry call;					   to force target to clear sense data generated by the;					   the bus reset to the bus during the scsi card slot;					   scan.;;	01-23-89	0.06	GAA	1. Fixed infinite loop bug when there was no jumper;					   installed on the initiator priority jumper on th3e;					   OLD scsi card.;;	01-24-89	0.07	GAA	1. Fixed a bug where the Manager was dropping devices;					   because the 5380 was sending $00 instead of $80;					   during the message out phase for the identify.  This;					   appears to go out because the target select register;					   was set to the initiator priority after we have won;					   arbitration and are trying select the target.  Also;					   the assert data bus bit is set every time I come into;					   phase handler to make sure that the bus is turned on.;;	01-27-89	0.08	GAA	1. Fixed a bug where the phase bits were being set before;					   set before checking to see if request was asserted.;;	01-30-89	0.09	GAA	1. Bug fix: returned $FE00 for a call which failed;					   with a check condition ($02). Should have returned;					   $FE02.  This occurred only when a call failed and;					   no autosense pointer was provided.;;4.1D11	02-8-89		0.0A	GAA	1. Fixed a bug where the last byte of each DCMOVE data chain;					   instruction was being dropped when multiple data chaining;					   instructions were issued to the SCSI Manager with one call.;					2. Fixed a bug where the data chaining prog. counter;					   was not being bumped to the next instruction for;					   DCMOVE instructions.;					3. Fixed a bug where the savepointers routine was not;					   setting the pointer for the save field properly.;					4. Added code to add the contents of the DCoffset field to;					   the address field in the DCMOVE instruction each time a;					   DCMOVE instruction is accessed.;					5. Moved the Select timeout back to 250 millisecs from;					   from 350 millisecs.;;4.1D12	02-15-89	0.0B	GAA	1. Fixed a bug where the transfer count update routine was;					   not updating the high word of the transfer count.;					2. Bug fix where the transfer count field was not updated;					   when data was being written to a target.;					3. Bug fix: When two SCSI cards installed with;					   different initiator priorities the entries in;					   the I/O table for logical unit encoding were;					   shifted by one logical unit.;;4.1D13	03-06-89	0.0C	GAA	1. Bug fix: was returning $FE00 when autosensing was;					   enabled for a call and the autosense call succeeded;					   on a device specific $801B.;					2. Added the code to the SCSI Manager for WarmStart;					   and shutdown.;					3. Removed the check for REQ in the Osend_bytes routine;					   It was to there to try and prevent the problem;					   with the transfer count being off by one on writ3tes;					   to a target.  The fix did not work!!!  Drivers;					   must insure that the number of bytes specified in;					   the req/xfer count field of the parameter block;					   match the number of bytes specified in the CDB.;;4.1D14	03-17-89			1. NO CHANGES;;4.1D15	03-21-89	0.0D	GAA	1. The initial release for beta.;					2. Changed the ID assignment to match the format of the;					   ID fields as defined by the device dispatcher.  The;					   ID field now is a 32 bit ENTRY with the low word set;					   to the slot number and the next word an ID incrementing;					   from $0001 to $FFFF.;					3. Added the detection for the rev C SCSI rom.  If the rom ;					   installed is not a rev. C a message will be displayed on;					   the screen and that card will be installed in the;					   device list (for the time being).;;4.1D16	03-17-89	1. NO CHANGES;;4.1d17	04-03-89	0.0E	GAA	1. Fixed a bug where the SDRSTOCHECK counter was not;					   being reloaded when booting from a floppy when;					   the call to ASSIGNID subroutine call was made.;;					2. Fixed a bug where index to the sdr was pointing to;					   the slot field instead of the link field for the next;					   SDR in the list.  This caused the SDR to contain erroneous;					   ID information during the ID assignment PROCess.;;					3. Fixed a bug in the zap_oldcard routine to mask off the;					   external slot bit prior using it to turn on the ;					   $CNXX space for a card.;;4.1D18	04-07-89	0.0F	GAA	1. Added a vector to store the address of my zero ;					   page so the Snooper CDA can have access to   my;					   handles and access to my tables for display;					   purposes.;;					2. Fixed a bug in the Find_sdr routine.  The last ;					   accessed pointers were not being updated and;					   this in turn was forcing the scan through the;					   entire SDR table to find the requested device.;;					3. Bug fix in irq handler where was returning the;					   wrong polarity on the carry when an interrupt;					   was serviced for a SCSI card.;;					4. Bug fix in irq handler where the pointer to the;					   record in the I/O table was not pointing to the;					   slot field in the record when trying to check;					   to see if a slot had a scsi card installed with a;					   possible interrupt which needed servicing.;;					5. Fixed bug with auto sensing where the slot number;					   portion of the ID was not being set prior to;					   issuing a Request sense call for autosense.;;	5.0 d29	6-10-89		Fixed bug in claim devices call.;;;--------------------------------------------------------------------------;;		INCLUDE FILES;;--------------------------------------------------------------------------;					PRINT		OFF					include		'M16.misctool'					include		'M16.memory'					PRINT		ON					EJECT;;****************** DEBUG CONDITIONAL assembly switch ****************************;debug				equ		$0000					;debug mode 1 = enabled;******************************************************************          SCSI Manager hardware equates******************************************************************io_space			equ		$00C000					;base address for I/O space**          SCSI ports I/O space (READ)*currdata			equ		$0000					;current scsi datainitcmdreg			equ		$0001					;initiator command registermodereg				equ		$0002					;5380 Mode registertargcmdreg			equ		$0003					;5380 target command registercurbusstat			equ		$0004					;5380 current bus status registerbusstat				equ		$0005					;bus & status registerindatareg			equ		$0006					;scsi data input registerresetpreg			equ		$0007					;scsi reset parity registerresetirqreg			equ		$0007					;clear 5380 pending irq**          SCSI ports I/O space (Write)*outdatareg			equ		$0000					;output data registerselectereg			equ		$0004					;scsi device id during select phasedmasndreg			equ		$0005					;start DMA send registertdmarecv			equ		$0006					;start DMA receive targetidmarecv			equ		$0007					;start DMA receive initiator;;*******************************************************************          SCSI DMA controller registers (Sandwich)******************************************************************;dmaaddrl			equ		$0008					;low byte of source/dest dma addressdmaaddrh			equ		$0009					;high byte of source/dest dma addressdmacntl				equ		$000A					;low byte of dma byte countdmacnth				equ		$000B					;high byte of dma byte countdmactl				equ		$000C					;dma chip control registeredmar5380			equ		$000D					;enable DMA & reset 5380 registerrestart_dma_reg		equ		$000D					;restart interrupted dma registerreset_5380			equ		$000D					;reset NCR 5380 register;;******************************************************************	OLD SCSI card hardware registers*****************************************************************;io_stbreset			equ		$CFFF					;reset I/O strobe space registeropdmadatareg		equ		$0008					;data in/out pseudo DMA registercard_priot_reg		equ		$0009					;priority jumper block i/o addressocard_breg			equ		$000A					;old scsi card rom/ram bank select registeropdmareg			equ		$000D					;Pseudo-DMA mode enable old scsi carddrqstatreg			equ		$000E					;b7 = DRQ status bit of address $C0NE;;	OLD SCSI CARD internal ram variables/equates;scsi_init			equ		$00C809					;Init flagsdat_start			equ		$00C831					;Start of SDAT ramgs_flag				equ		$00C8F3					;GS system flagdibtab_start		equ		$00C931					;start of DIBTAB ramdibtab_len			equ		$001B					;length of dibtab record;	EJECT*******************************************************************          NCR 5380 general equates********************************************************************          5380 command register*databuson			equ		$01						;assert scsi data busattention			equ		$02						;assert SCSI ATN*select				equ		$04						;assert SCSI SEL*busy				equ		$08						;assert SCSI BSY*asrtack				equ		$10						;assert SCSI ACK*arbitlost			equ		$20						;lost arbitration statusdifferenab			equ		$20						;enable differential (NCR 5381 only!)arbinprog			equ		$40						;arbitration in progresstestmode			equ		$40						;enable test modeassertrst			equ		$80						;assert RST***          5380 mode register*arbitrate			equ		$01						;start arbitration phasedmaenable			equ		$02						;enable DMA modemonitorbsy			equ		$04						;monitor BSY*eopirqenb			equ		$08						;enable EOP* interruptparirqenb			equ		$10						;enable parity interruptparchkenb			equ		$20						;enable parity checkingtargetenb			equ		$40						;set target modeblkdmaenb			equ		$80						;enable Block Mode DMA**          5380 Target command register*assertio			equ		$01						;assert I/O*assertcd			equ		$02						;assert C/D*assertmsg			equ		$04						;assert MSG*assertreq			equ		$08						;assert REQ*lastbyte			equ		$80						;last byte sent (53C80 only!)**          Current SCSI bus status register*dbp					equ		$01						;scsi bus paritysel					equ		$02						;scsi bus SEL*io					equ		$04						;scsi bus I/O*cd					equ		$08						;scsi bus C/D*msg					equ		$10						;scsi bus MSG*req					equ		$20						;scsi bus REQ*bsy					equ		$40						;scsi bus BSY*rst					equ		$80						;scsi bus reset**          Bus & Status register*ack					equ		$01						;scsi bus ACK*atn					equ		$02						;scsi bus ATN*busyerr				equ		$04						;busy error statusphasematch			equ		$08						;scsi bus phase match statusscsiirq				equ		$10						;5380 irq pending flagparityerr			equ		$20						;scsi data parity errordrq					equ		$40						;DMA request asserted (DRQ)end_dma				equ		$80						;end of dma transfer status;;;;*******************************************************************       DMA controller control bit definitions******************************************************************;;spseudodma			equ		%00000001			;Sandwich Pseudo Dma enablerealdma				equ		%00000010			;Sandwich Real Dma enableststmode			equ		%00000100			;Sandwich test modesdisstopdma			equ		%00001000			;Disable stop DMA on irqdmadir				equ		%00010000			;DMA direction bit (read only)ssystemdma			equ		%01000000			;System DMA status bit (read only)dma_stopped			equ		%10000000			;DMA stop by irq status (read only);;*******************************************************************       SCSI bus timeout        equates******************************************************************bus_set_delay		equ		$FF					;bus SET delaybus_res_hold		equ		$FF					;bus RESET hold time (25 usec min.)sel_abort_tout		equ		$20					;bus SELECT abort time (200 usec max)sel_timeout			equ		$A100				;SELECT Timeout (250 millisec min.)millisec_count		equ		$00CB				;count for 1 millisecond delayusec125				equ		66					;count for 256 usec delaybres_ready_del		equ		275					;275 millllisecarbtcount			equ		120					;2 second arbitration timeout;;**********************************************************************************       Misc Hardware registers*********************************************************************************dma_bank_reg		equ		$00C037				;system dma bank registerslotromsel			equ		$00C02D				;slot rom select register;;		EJECT**********************************************************************************	SCSI Manager zero page equates*********************************************************************************;driver_zpg			equ		$0000				;256 bytes reserved for device driversdriverzpgsize		equ		$0100;scsizpg				equ		$0000				;start of our zero page area;;;	zero page working pointer variables;zpgwptrs			equ		scsizpgdev_slot			equ		scsizpg				;slot numberdev_id				equ		dev_slot+2			;id of device soughtpversion			equ		dev_id+2			;parameter list version numbercall_attrbs			equ		pversion+2			;call attribute flagscalltout			equ		call_attrbs+2		;number of 1/4 secs call must complete withincompvector			equ		calltout+2			;completion routine vectorscsicptr			equ		compvector+4		;scsi command pointerdclst_ptr			equ		scsicptr+4			;pointer to buffer structurereq_count			equ		dclst_ptr+4			;working register for byte count requestedasense_ptr			equ		req_count+4			;autosense buffer pointermsgb_ptr			equ		asense_ptr+4		;message buffer pointerendzwvars			equ		msgb_ptr+4			;end zero page work variableswptrssize			equ		endzwvars-zpgwptrs	;number of bytes in working pointers;;	zero page misc variables;logunit				equ		endzwvars			;logical unit work variableslot_no				equ		logunit+2			;slot number work variableio_offset			equ		slot_no+2			;work io space address work variabledma_offset			equ		io_offset+4			;dma controller io space address work variableplist_ptr			equ		dma_offset+4		;parameter list pointerdc_pc				equ		plist_ptr+4			;working data chain inst prog. countercurr_dci_ptr 		equ		dc_pc+4				;work current data chain inst pointerbuffer_ptr			equ		curr_dci_ptr+4		;work buffer pointerbyte_ctr			equ		buffer_ptr+4		;work byte counterxfer_count			equ		byte_ctr+4			;working register for byte count transferred;numscsi_cards		equ		xfer_count+4		;number of scsi cards found in systemsdrsonline			equ		numscsi_cards+2		;number of sdrs onlinesdrstocheck			equ		sdrsonline+2		;working varialbleactive_sdr			equ		sdrstocheck+2		;pointer to currently active SDRio_table_ptr		equ		active_sdr+4		;points to I/O tableiorec_ptr			equ		io_table_ptr+4		;I/O record pointersdr_table_ptr		equ		iorec_ptr+4			;scsi device records table pointersdr_ptr				equ		sdr_table_ptr+4		;SDR record pointer	next_sdr			equ		sdr_ptr+4			;contains address of next available SDRavail_sdrs			equ		next_sdr+4			;number of available SDRsscratchzpg			equ		avail_sdrs+2		;scratchpad pointertemp1				equ		scratchzpg+4		;scratchpadtemp2				equ		temp1+4				;scraattchpadaddr_table_ptr		equ		temp2+4				;routine tables pointertick_addr			equ		addr_table_ptr+4	;system wide tick counter addresszpgsize				equ		tick_addr+4-scsizpg	;scsi manager has 1 page of zero page space max.;max_zpgcode			equ		$0080				;largest code space for zero page routinesmaxzpg_space		equ		$0200				;2 pages for zero page space max.driver_zpg_size		equ		$0100				;one page of drivers (2nd page for scsi manager)zeropg_code			equ		$0080				;start of zero page codezpgbank				equ		$0000				;zero page always in bank $0000*********************************************************************************	GS/OS zero page equates********************************************************************************sib_plptr			equ		$0078				;pointer to parameter list for scsi managergsoszpgscratch		equ		$0060				;scratch zero page area in gs/os zero page	EJECT******************************************************************	Parameter list field definitions for Request Devices &*	Claim Devices calls.*****************************************************************;;	Get Devices parameter list fields;getdevs_plst		equ		$0000scsi_dtype			equ		$0000				;scsi device typeintcomvect			equ		$0002				;intercommnunication vectordestbuffptr			equ		$0006				;destination buffer pointer;;;	destination buffer field definitions;zpg_addr			equ		$0000				;offset to zero page fieldtotal_devcount		equ		$0002				;total device count fielddevice_slot			equ		$0004				;slot number fielddevice_id			equ		$0006				;scsi device id field;reqENTRY_size		equ		device_id\							-total_devcount		;number of bytes per ENTRY;		EJECT******************************************************************	Parameter list field definitions for SCSI I/O call*****************************************************************;;	I/O call parameter list;io_call_plst		equ		$0000plst_slot			equ		$0000				;device ID := slot & unit numberplst_devid			equ		$0002				;parameter list device IDplst_version		equ		$0004				;parameter list versionplst_attrbs			equ		$0006				;attributes wordplst_timeout		equ		$0008				;timeout in 1/4 sec countsplst_comp_vect		equ		$000A				;Completion vectorplst_cmd_ptr		equ		$000E				;pointer to scsi cmd listplst_dchainptr		equ		$0012				;pointer to data chain instructionsplst_reqxfr_cnt		equ		$0016				;request/transfered byte countplst_autos_ptr		equ		$001A				;pointer to autosense bufferplst_msg_ptr		equ		$001E				;pointer to message buffer pointerplst_Reserved		equ		$0022				;reserved (must be $0000);;	parameter list attribute bits definitions;plst_disc_bit		equ		$8000				;parameter list attribute bit for disconnectplst_msgin_bit		equ		$4000				;save message in bytes in message bufferplst_msgout_bit		equ		$2000				;message out bytes in message buffer for targetplst_attresbits		equ		$7FFF				;param list attributes word reserved bits;;;	DATA CHAINING INSTRUCTION DEFINITION;dci_opcode			equ		$0000				;opcode fielddci_count_field		equ		$0004				;count fielddci_offset			equ		$0008				;offset fielddci_save			equ		$000C				;data chain instruction save area;dci_size			equ		dci_save+4\							-dci_opcode			;number of bytes in data chain instructionmaxdcis				equ		32					;maximum of 32 data chain inst per i/o call;		EJECT**********************************************************************************       SCSI Manager Errors*********************************************************************************success				equ		$0000				;scsi_man_err		equ		$FE00				;generic scsi manager errorbad_dev_type		equ		$FE01				;invalid SCSI device typeckcondition			equ		$FE02				;check conditionbad_scsi_id			equ		$FE03				;invalid SCSI device IDcondmetgood			equ		$FE04				;condition met goodplist_error			equ		$FE05				;invalid SCSI Mgr. parameter blockbad_buff_size		equ		$FE06				;invalid buffer sizesm_rsrc_err 		equ		$FE07				;unable to allocate mgr. resourcestarget_busy			equ		$FE08				;target busysm_shutdown_err		equ		$FE09				;unable to shutdown scsi managerscsicmd_err			equ		$FE0A				;scsi manager command out or rangescsi_start_err		equ		$FE0B				;scsi manager already started errorno_startup_err		equ		$FE0C				;SCSI Manager not started errorno_scsi_hardware	equ		$FE0D				;no scsi cards foundirq_install_err		equ		$FE0E				;unable to install scsi irq handlerirq_remove_err		equ		$FE0F				;unable to unbind scsi irq handlerintermed_good		equ		$FE10				;intermediate status good (linked cmds)calltout_err		equ		$FE11				;call timeout errorget_dib_err			equ		$FE12				;get_dib_ptr call failedgen_scsi_bus_err 	equ		$FE13				;general scsi bus errorbus_free_err		equ		$FE14				;bus freee phase errorarbit_phase_err		equ		$FE15				;bus arbitration errorsel_phase_err		equ		$FE16				;select phase errorint_cond_met_good	equ		$FE17				;intermediate/condition met/goodcmd_phase_err		equ		$FE18				;command phase errordata_phase_err		equ		$FE19				;data phase errorbad_msg_err			equ		$FE1A				;message phase errorreserve_conflict	equ		$FE1B				;reservation conflictstat_phase_err		equ		$FE1C				;status phase errorscsi_bus_Res_err 	equ		$FE1D				;SCSI bus reset errorno_scsi_devs		equ		$FE1E				;general scsi hardware errorno_scsi_err			equ		$FE1F				;No SCSI signatured hardware foundinv_scsi_irq		equ		$FE20				;Invalid SCSI interrupt generatedinv_code_err		equ		$FE21				;seq opcode routine should not have gone to bcs handlerinv_phase_err		equ		$FE22				;Invalid phase patternsm_busy_err			equ		$FE23				;SCSI Manager busy errorautosfail_err		equ		$FE24				;Autosense call failed;;	SCSI target status error codes;queue_full			equ		$FE28				;queue full status												;$FExx where xx = scsi status byte;******************************************************************	Bus Status word bit definitions*****************************************************************;bparstat			equ		$0001				;bus parity status bitbselstat			equ		$0002				;bus selectbiostat				equ		$0004				;bus I/Obcdstat				equ		$0008				;bus C/Dbmsgstat			equ		$0010				;bus MSGbreqstat			equ		$0020				;bus REQbbsystat			equ		$0040				;bus BSYbrststat			equ		$0080				;bus RST (scsi bus reset)backstat			equ		$0100				;bus ACK status bitbatnstat			equ		$0200				;bus ATNbbsyerrstat			equ		$0400				;bus BSY errorbphasematch			equ		$0800				;bus phase match statusbirqstat			equ		$1000				;5380 irq pendingbparerrstat			equ		$2000				;scsi bus parity error statusbdmareqstat			equ		$4000				;DRQ status bitbenddmastat			equ		$8000				;End of DMA statusbeopstat			equ		$8000				;bus end of DMA status;;		EJECT******************************************************************	SCSI Bus phases bit patterns*****************************************************************;data_out_phase		equ		$0000data_in_phase		equ		$0001cmd_phase			equ		$0002stat_phase			equ		$0003invalid_phase1		equ		$0004invalid_phase2		equ		$0005msg_out_phase		equ		$0006msg_in_phase		equ		$0007;;******************************************************************	SCSI message definitions*****************************************************************;cmd_complete		equ		$0000				;command completeextended_msg		equ		$0001				;extended message markersave_dat_ptr		equ		$0002				;save data pointer messagerest_data_ptr		equ		$0003				;restore data pointer messagedisconnect			equ		$0004				;disconnect messageinit_err_detect		equ		$0005				;initiator detected errorabort_msg			equ		$0006				;abort transaction messagerEJECT_msg			equ		$0007				;rEJECT messagenop_msg				equ		$0008				;NO operation messagepar_err_msg			equ		$0009				;parity error messagelink_comp_msg		equ		$000A				;linked command complete messagelink_compwf_msg		equ		$000B				;linked command complete with flag messagebus_dev_res_msg		equ		$000C				;bus device reset messagesdata_follows		equ		$000D				;auto Sense data followsidentify_msg		equ		$0080				;$80-$FF = Identify message;					EJECT******************************************************************          SCSI Manager Data structures******************************************************************          SCSI Manager I/O Space Table****************************************************************** This table contains all the entries for each Slot, scsi devices* and logical units within scsi devices. The bitmap of the scsi* device logical units is broken down as follows:**	I/O table record:*	+-----------+-----------+*	|    	Slot Number	|	slots 0-F (slot 0,8 do not exist) slots 9-F external *	+-----------+-----------+*	| SCSI hardware version	|	hardware version identification*	+-----------+-----------+*	|    5380 base addr	|	Low word $C0X0 where X := (slot# * $10) + $80*	+-----------+-----------+*	|   5380 bank number	|	bank number of scsi controller base*	+-----------+-----------+*	| DMA Control base addr |	Low word $C0X0 where X := (slot# * $10) + $80*	+-----------+-----------+*	|  DMA controller bank	|	DMA controller bank*	+-----------+-----------+*	| Card/port attributes	|*	+-----------+-----------+*	|   Initiator Priority	|*	+-----------+-----------+*	| SCSI Device 0 Logical	|	Bit Map for Logical units on SCSI Device 0*	+-----------+-----------+*	| SCSI Device 1 Logical	|	Bit Map for Logical units on SCSI Device 1*	+-----------+-----------+*	| SCSI Device 2 Logical	|	Bit Map for Logical units on SCSI Device 2*	+-----------+-----------+*	| SCSI Device 3 Logical	|	Bit Map for Logical units on SCSI Device 3*	+-----------+-----------+*	| SCSI Device 4 Logical	|	Bit Map for Logical units on SCSI Device 4*	+-----------+-----------+*	| SCSI Device 5 Logical	|	Bit Map for Logical units on SCSI Device 5*	+-----------+-----------+*	| SCSI Device 6 Logical	|	Bit Map for Logical units on SCSI Device 6*	+-----------+-----------+*	| SCSI Device 7 Logical	|	Bit Map for Logical units on SCSI Device 7*	+-----------+-----------+*	| 	RESERVED	|	Room for future expansion*	+-----------+-----------+**	NOTE: 1.If the Slot Number field is zero then*		no SCSI card/port was found in this position*		Otherwise it contains the slot number*	      2.The Intiator priority defined by the cards*		Built-in SCSI ports are defined have the highest priority $07**  card/port_attrbs:*  +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*  |F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*  +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*   | | | | | | | | | | | | | | | |*   | | | | | | | | | | | | +-+-+-+----- scsi hardware version*   | | | | | | | | | | | +------------- card/built-in port 	0=port, 1=card*   | | | | | | | | | | +--------------- IRQ support		0=no irq 1=generates irq*   | | | | | | | | | +----------------- DMA support		0=no DMA 1=DMA transfers*   +-+-+-+-+-+-+-+-+------------------- RESERVED**	scsi hardware version:*	0000 = Old SCSI card*	0001 = New SCSI card*	0010 = Option 4 built-in port*	0011-1111 Reserved**  Device word:*  +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*  |F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*  +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*   | | | | | | | | | | | | | | +-+------ Logical unit 0*   | | | | | | | | | | | | +-+---------- Logical unit 1*   | | | | | | | | | | +-+-------------- Logical unit 2*   | | | | | | | | +-+------------------ Logical unit 3*   | | | | | | +-+---------------------- Logical unit 4*   | | | | +-+-------------------------- Logical unit 5*   | | +-+------------------------------ Logical unit 6*   +-+---------------------------------- Logical unit 7**	Each pair of bits is encoded as follows:*scan_lu				equ		%00 				;This logical unit needs to be scanned forlu_online			equ		%01 				;This logical unit is online leave aloneselect_active		equ		%10 				;Currently trying to select this scsi devicelu_scan_end			equ		%11					;Do not check for Logical units beyond this one******************************************************************;iorecord			equ		$0000slot				equ		iorecordhwd_type			equ		slot+2scsi_base			equ		hwd_type+2			;scsi controller base addressscsi_bank			equ		scsi_base+2			;high word of scsi controller basedma_base			equ		scsi_bank+2			;io base addr for dma controlldma_bank			equ		dma_base+2			;dma control bank addressio_attrbs			equ		dma_bank+2			;this slots/port attributesinitpriot			equ		io_attrbs+2			;Initiator priorityd0logicals			equ		initpriot+2			;device 0 logical units bit mapd1logicals			equ		d0logicals+2		;device 1 logical units bit mapd2logicals			equ		d1logicals+2		;device 0 logical units bit mapd3logicals			equ		d2logicals+2		;device 1 logical units bit mapd4logicals			equ		d3logicals+2		;device 0 logical units bit mapd5logicals			equ		d4logicals+2		;device 1 logical units bit mapd6logicals			equ		d5logicals+2		;device 0 logical units bit mapd7logicals			equ		d6logicals+2		;device 1 logical units bit mapend_iorecord		equ		d7logicals+2		;iorec_size			equ		end_iorecord\							-iorecord			;size I/O record size**	io_attrbs bit definitions & defaults*;;	Hardware version types;old_scsi_card		equ		$0000new_scsi_card		equ		$0001opt4_scsi			equ		$0002;;;	I/O attribute bits;external_card		equ		$0002irq_support			equ		$0004dma_support			equ		$0008;old_card_attrbs		equ		$0010				;old card, external, no irq or DMA supportnew_card_attrbs		equ		$000F				;new scsi card attributes;		EJECT*******************************************************************	I/O table******************************************************************;io_table			equ		$0000				;io table definitions0_iorec			equ		io_table\							+iorec_size			;slot 0 internals1_iorec			equ		s0_iorec\							+iorec_size			;slot 1s2_iorec			equ		s1_iorec\							+iorec_size			;slot 2s3_iorec			equ		s2_iorec\							+iorec_size			;slot 3s4_iorec			equ		s3_iorec\							+iorec_size			;slot 4s5_iorec			equ		s4_iorec\							+iorec_size			;slot 5s6_iorec			equ		s5_iorec\							+iorec_size			;slot 6s7_iorec			equ		s6_iorec\							+iorec_size			;slot 7s8_iorec			equ		s7_iorec\							+iorec_size			;slot 0 externals9_iorec			equ		s8_iorec\							+iorec_size			;slot 1sA_iorec			equ		s9_iorec\							+iorec_size			;slot 2sB_iorec			equ		sA_iorec\							+iorec_size			;slot 3sC_iorec			equ		sB_iorec\							+iorec_size			;slot 4sD_iorec			equ		sC_iorec\							+iorec_size			;slot 5sE_iorec			equ		sD_iorec\							+iorec_size			;slot 6sF_iorec			equ		sE_iorec\							+iorec_size			;slot 7end_iotable			equ		sF_ioreciotsize				equ		end_iotable\							-io_table			;io_table size;;					EJECT*********************************************************************************	Scsi Device Record (SDR)**********************************************************************************	+-----------+-----------+*	|						|	Address of next SDR record*	+---- Next SDR Link ----+*	|						|	See Device ID definition below*	+-----------+-----------+*	|       Device Id		|	ID assigned to this Logical Unit (LU)*	+-----------+-----------+*	|Logical Unit Attributes|	See Logical_unit_attributes definition below*	+-----------+-----------+*	|   SCSI Device Type 	|	See standard for definition*	+-----------------------+*	| SCSI standard Version |	Refer to SCSI standard*	+-----------+-----------+*	|     Target_priority	|	Target priority record belongs to*	+-----------+-----------+*	|						|	Intercommunication vector for driver who owns*	+-- Intercomm. Vector --+	this device.*	|						|*	+-----------+-----------+*	|						|	Vector to pass control on Reselect IRQ*	+--completion Vector----+*	|						|*	+-----------+-----------+*	|						|	Field to save data chain instruction during*	+-- Data Chain Offset --+	Save pointers call*	|						|*	+-----------------------+*	|						|	call terminal count in tics*	+------- Timeout -------+*	|						|*	+-----------+-----------+*	|						|	current position of buffer address (2's complement form)*	+------ Buffer Ptr -----+*	|						|*	+-----------+-----------+*	|						|	Byte count place holder*	+-- Current byte count--+*	|						|*	+-----------+-----------+*	|		Reserved		|	Expansion*	+-----------+-----------+*	|						|	Expansion*	+------- Reserved ------+*	|						|*	+-----------+-----------+*	|						|	Expansion*	+--------Reserved ------+*	|						|*	+-----------+-----------+***  Device ID:*  +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*  |F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*  +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*   | | | | | | | | | | | | | | | |*   | | | | | | | | | | | | | | | |*   | | | | | | +-+-+-+-+-+-+-+-+-+-----	Device ID assigned by SCSI Manager*   | +-+-+-+-+-------------------------	RESERVED*   +-----------------------------------	Claimed bit 1= Claimed by driver*** 	Logical Unit Attrbs:*	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*	|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+* 	 | | | | | | | | | | | | | | | |* 	 | | +-+-+-+-+-+-+-+-+-+-+-+-+-+-----	RESERVED* 	 | +---------------------------------	SDR record busy flag*	 +-----------------------------------	Removeable media** SCSI_DEVICE_TYPE BYTE DEFINITION: (Inquiry call definition)*	Bits 0-4*	$00 = Direct access device (magnetic disk)*	$01 = Sequential access device (magnetic tape)*	$02 = Printer device*	$03 = PROCessor device*	$04 = Write-once direct access device (some optical disks)*	$05 = Read-only direct access device (optical disks)*	$06 = Scanner device*	$07 = Optical Memory devices (optical disks)*	$08 = Changer device (jukeboxes)*	$09 = Communications device*	$0A-$10 = RESERVED*	$1E = Target device ???*	$1F = Unknown device type**	Bits 5-7*	000 = Type defined by bits 0-4 connected to this LU*	001 = Target SCSI ID able to support type defined by bits 0-4*	010 = RESERVED*	011 = LU not able to support Logical unit*	1XX = Vendor Unique*********************************************************************************;;sdr_record			equ		$0000				;scsi manager scsi device recordnxt_sdr_lnk			equ		sdr_record			;(4)link to next SDR in the queuesdr_plist_ptr		equ		nxt_sdr_lnk+4		;(4)pointer to parameter list tied t to this devicesdr_device_id		equ		sdr_plist_ptr+4		;(2)ID assigned by SCSI managersdr_devtype			equ		sdr_device_id+2		;(2)SCSI Device type definitionsdr_standard_vers	equ		sdr_devtype+2		;(2)scsi standards versionsdr_flags			equ		sdr_standard_vers+2	;(2)scsi device access attributessdr_sublu			equ		sdr_flags+2			;(2)sub logical unit (reserved must be zero)sdr_logunit			equ		sdr_sublu+2			;(2)Logical unit numbersdr_targ_priot		equ		sdr_logunit+2		;(2)Target device prioritysdr_init_priot		equ		sdr_targ_priot+2	;(2)Initiator priority this LU talks tosdr_slot			equ		sdr_init_priot+2	;(2)card slot no. for this LUsdr_5380_base		equ		sdr_slot+4			;(4)I/O base address for 5380sdr_dma_base		equ		sdr_5380_base+4		;(4)I/O base address for 5380 DMA controlsdr_timeout			equ		sdr_dma_base+2		;(4)call timeout remaining (seconds)sdr_completion_vect	equ		sdr_timeout+4		;(4)completion vectorsdr_cmd_ptr			equ		sdr_completion_vect\							+4					;(4)position of next command byte to sendsdr_dc_offset		equ		sdr_cmd_ptr+4		;(4)Position of current data chain instructionsdr_Buffer_ptr		equ		sdr_dc_offset+4		;(4)address of next data byte in buffersdr_byte_count		equ		sdr_buffer_ptr+4	;(4)intermediate byte countsdr_reserved1		equ		sdr_byte_count+4	;(6) room for expansionsdr_reserved2		equ		sdr_reserved1+2end_sdr_record		equ		sdr_reserved2+4;sdrrec_size			equ		end_sdr_record\							-sdr_record			;size of scsi device record;;;;	SCSI DEVICE RECORD (SDR) attributes word bit definitions;;	bits 0-D reserved & must be zero;sdr_attrb_busy		equ		$8000				;SDR busy marker bitsdr_attrb_tout		equ		$4000				;call timed outsdr_attrb_disc		equ		$2000				;disconnect flagsdr_attrb_purge		equ		$1000				;flag to mark purge on next timeout IRQsdr_attrb_rmb		equ		$0080				;media removeable bit;	EJECT******************************************************************	SCSI device types as defined by the SCSI 2 standard*******************************************************************	$00 = Direct access device (magnetic disk)*	$01 = Sequential access device (magnetic tape)*	$02 = Printer device*	$03 = PROCessor device*	$04 = Write-once direct access device (some optical disks)*	$05 = Read-only direct access device (optical disks)*	$06 = Scanner device*	$07 = Optical Memory devices (optical disks)*	$08 = Changer device (jukeboxes)*	$09 = Communications device*	$0A-$10 = RESERVED*	$1E = Target device ???  (SEE STANDARD)*	$1F = Unknown device type*diraccdev			equ		$0000seqaccdev			equ		$0001prnterdev			equ		$0002PROCdev				equ		$0003wrtoncedev			equ		$0004readonlydev			equ		$0005scannerdev			equ		$0006optmemdev			equ		$0007changerdev			equ		$0008commdev				equ		$0009targetdev			equ		$001Eunknowndev			equ		$001F;;					EJECT******************************************************************          SCSI Manager misc. equates*****************************************************************;startup				equ		$0000				;scsi manager call numbersshutdown			equ		$0001request_devs		equ		$0002claim_devs			equ		$0003io_call				equ		$0005scsi_manager_id		equ		$0002				;See SCSI supervisor driver ERSbind_irq			equ		$2031				;class 1 bind interrupt call numberbind_pcount			equ		$0003				;bind irq parameter countunbind_irq			equ		$2032				;class 1 unbind irq call numberunbind_pcount		equ		$0001				;unbind parameter countgsos_busy			equ		$0007				;GS/OS busy error generated during Unbind irqother_irq_vrn		equ		$0017				;IRQ other VRNscsi_vrn			equ		other_irq_vrn		;our vrn for now will change in option 4stack_ENTRY			equ		$E100B0				;GS/OS stack based call ENTRY pointslot_arbit			equ		$01FCBC				;GS/OS system service routine slot arbitratorgsos_sys_death		equ		$01FC44				;GS/OS system death system service routinemtool_id_type		equ		$3B00				;supervisors driver id type from misc. toolsinitpriority		equ		$0007				;SCSI priority for initiatorwait_phase_rcnt		equ		$0003				;high word of wait_phase retry countqtrsec				equ		$000F				;15 ticks for 1/4 secondmax_slots			equ		$0008				;maximum number of slots internal & externalmax_scsi_devs		equ		$0008				;maximum scsi device on bus per slotmax_targets			equ		$0007				;maximum number of SCSI targets per slotmax_logunits		equ		$0008				;maximum number of SCSI Logical unitsinqbsize			equ		$0100				;2 buffers 256 bytes eachinqbstart			equ		$0002				;start of inquiry buffer data areamem_page			equ		$0100				;256 bytes per memory pagesdrsperpage			equ		mem_page\							/sdrrec_size		;number of sdrs per pagedefault_sdrs		equ		sdrsperpage*2		;minimum number of SDRs allocatedsdr_memory			equ		default_sdrs\							*sdrrec_size		;amount of default SDR memorymax_sdrs			equ		max_slots\							*max_targets\							*max_logunits		;max SCSI Device recordsmin_mem_size		equ		iotsize\			;I/O table size							+sdr_memory			;two memory pages for sdrs to start withmax_cmd_size		equ		$000C				;largest scsi command 12 bytesdont_scan_dev		equ		$FFFF				;Do not scan any logicalsno_device			equ		$FFFF  				;marker for no scsi device foundlunotavail			equ		$007F				;byte 1 of inquiry (LU not available)claimed				equ		$8000				;bit 15 of sdr_id field marks device claimedslot0				equ		$0000				;slot7				equ		$0007				;slot7ext			equ		$000F				;slot 7 external;scsid0				equ		$0000				;scsi device number 0scsid1				equ		$0001				;scsi device number 1scsid2				equ		$0002				;scsi device number 2scsid3				equ		$0003				;scsi device number 3scsid4				equ		$0004				;scsi device number 4scsid5				equ		$0005				;scsi device number 5scsid6				equ		$0006				;scsi device number 6scsid7				equ		$0007				;scsi device number 7;scsi_prior0			equ		$0001				;scsi device 0 priorityscsi_prior1			equ		$0002				;scsi device 1 priorityscsi_prior2			equ		$0004				;scsi device 2 priorityscsi_prior3			equ		$0008				;scsi device 3 priorityscsi_prior4			equ		$0010				;scsi device 4 priorityscsi_prior5			equ		$0020				;scsi device 5 priorityscsi_prior6			equ		$0040				;scsi device 6 priorityscsi_prior7			equ		$0080				;scsi device 7 priority;lu0					equ		$0000				;logical unit numberslu1					equ		$0020				;in logical unit fieldlu2					equ		$0040				;within the scsi command lu3					equ		$0060				;packet. (bits 5-7 of byte 0)lu4					equ		$0080lu5					equ		$00A0lu6					equ		$00C0lu7					equ		$00E0;lock_bit			equ		%1000000000000000	;lock bit for our handlesm_buffer_attrs		equ		%1100000000011100	;our work data buffer MM attributeszpg_attrbs			equ		%1100000000010101	;scsi Manager zero page MM attributes;							 |||||||||||||||+--- Fixed bank;							 ||||||||||||||+---- Fixed address;							 |||||||||||||+----- Page aligned;							 ||||||||||||+------ May not use special memory;							 |||||||||||+------- May not cross bank boundaries;							 ||||||||+++-------- RESERVED;							 ||||||++----------- Purge level 00 (don't purge);							 ||++++------------- RESERVED;							 |+----------------- Block FIXED may not move;							 +------------------ Block Locked may not move or purge;;incbusyflag			equ		$E10064				;Increment Busy flag ENTRY pointdecbusyflag			equ		$E10068				;Decrement Busy flag ENTRY point;rom_message			equ		$0020				;message number for rev c rom requiredrev_c_rom			equ		$0002				;version number for version C scsi rom;***********************************************************************************	Data Chaining equates**********************************************************************************;dc_size				equ		$0010				;16 bytes per data chain instruction;dc_loop_inst		equ		$FFFFFFFF			;-1 defines loop ocodedc_stop_inst		equ		$00000000;;	chain instructions field positions;dc_opcode			equ		$0000				;long word field for the data chain opcodedc_count			equ		$0004				;long word field for count fielddc_offset			equ		$0008				;long word field for offsetdc_sav_ptrs			equ		$000C				;long word field for save pointers field;***********************************************************************************	SCSI Manager sequence number equates**********************************************************************************oend				equ		$0000				;end of sequence markerirq_hand			equ		$0000				;irq handlerphase_hand			equ		$0001				;phase handlerhwdchk				equ		$0002				;hardware type checksetup				equ		$0003				;setup routinebfreeph				equ		$0004				;bus freearbph				equ		$0005				;arbitrateselectph			equ		$0006				;selectdoutph				equ		$0007				;data out phasedinph				equ		$0008				;data in phasecmdph				equ		$0009				;command phasestatph				equ		$000A				;status phasemoutph				equ		$000D				;message outminph				equ		$000E				;message in;***************************************************************************************	Byte definitions of INQUIRY packet**************************************************************************************;;	inquiry packet field positions;inq_packet			equ		$0000inq_devtype			equ		$0000				;scsi device typeinq_rmb				equ		$0001				;bit 7 = removeable bitinq_version			equ		$0002				;standard supported version informationinq_attrbs			equ		$0007				;attribute bits for target (see standard);;	Inquiry	packet bit definitions;scsidt_mask			equ		$007F				;mask for device typescsi_rmb			equ		$0080				;removeable media bitscsi_svers			equ		$0007				;scsi standard version number;;;	includes for GS/OS;					EJECT					include		'common.equ.src'					include		'driver.equ.src'					include		'hw.equ.src';					EJECT***********************************************************************Entries:	ALL the ENTRY definitions go here\**********************************************************************;					ENTRY		scsi_man_header					ENTRY		snooper_ptr					ENTRY		scsim_chars					ENTRY		cmd_table					ENTRY		addr_tables					ENTRY		oaddr_tbl					ENTRY		scsi_variables					ENTRY		scsi_man_exec					ENTRY		allocate_memory					ENTRY		clear_memory					ENTRY		move_bytes					ENTRY		scsim_startup					ENTRY		tout_header					ENTRY		scsim_shutdown					ENTRY		scsim_reqdevs					ENTRY		scsim_claimdevs					ENTRY		scsim_io					ENTRY		tick_count					ENTRY		callrtn					ENTRY		scsi_irq_hand					ENTRY		old_scsi_tbls					ENTRY		oscsi_irq_hand					ENTRY		oscsi_hwd_check					ENTRY		set_old_scsi					ENTRY		oscsi_bus_free					ENTRY		oscsi_setup					ENTRY		oscsi_data_out					ENTRY		oscsi_data_in					ENTRY		oscsi_status					ENTRY		oscsi_msg_in					ENTRY		oscsi_msg_out					ENTRY		ocopyzcode					ENTRY		osend_cmd					ENTRY		osend_bytes					ENTRY		orecv_bytes					ENTRY		osend_byte					ENTRY		orecv_byte					ENTRY		callzpg					ENTRY		oscsibyteio					ENTRY		ozeropgcode					ENTRY		low_ptrs_init					ENTRY		ophase_handler					ENTRY		oinit_5380					ENTRY		ozap_5380					ENTRY		opdmaoff					ENTRY		obad_phase					ENTRY		tu_slot					ENTRY		tulunit					ENTRY		inq_slot					ENTRY		inq_lunit					ENTRY		sense_plist					ENTRY		sense_slot					ENTRY		senseid					ENTRY		sense_lunit					ENTRY		sensebstruc					ENTRY		sensecnt0					ENTRY		sensecnt1					ENTRY		inq_plist					ENTRY		sense_buff					ENTRY		inq_buff					ENTRY		arbitrate_phase					ENTRY		arbtout_header					ENTRY		Select_phase					ENTRY		res_icmd_bits					ENTRY		set_icmd					ENTRY		res_icmd					ENTRY		set_icmd_bits					ENTRY		oscsi_dma_enab					ENTRY		oscsi_dma_disab					ENTRY		set_ack_true					ENTRY		set_ack_false					ENTRY		wait_req_true					ENTRY		wait_req_false					ENTRY		wait_drq_true					ENTRY		slow_down					ENTRY		restore_cya					ENTRY		wait_busy					ENTRY		message_phase					ENTRY		status_phase					ENTRY		chkbusfloat					ENTRY		wait_for_phase					ENTRY		bind_scsi_irq					ENTRY		unbind_scsi_irq					ENTRY		bus_reset					ENTRY		find_scsi					ENTRY		chk_scsi_type					ENTRY		set_iorec_ptr					ENTRY		init_sdr_tbl					ENTRY		setup_work_vars					ENTRY		check_logicals					ENTRY		calltarget					ENTRY		nextlu					ENTRY		set_io_addrs					ENTRY		build_sdr					ENTRY		scan_scsi_devs					ENTRY		rest_sromsel					ENTRY		save_work_vars					ENTRY		rest_work_vars					ENTRY		chk_sel_tout					ENTRY		sel_abort_wait					ENTRY		smartp_scsi_chk					ENTRY		millisec_delay					ENTRY		match_phases					ENTRY		pdma_recv_data					ENTRY		rdma_recv_data					ENTRY		rdma_send_data					ENTRY		bus_status					ENTRY		setzpgvars					ENTRY		get_plist					ENTRY		set_plist					ENTRY		find_sdr					ENTRY		priot_to_dev					ENTRY		dev_to_priot					ENTRY		get_tick_addr					ENTRY		getticks					ENTRY		get_targp					ENTRY		setscan					ENTRY		alloc_nxt_sdr					ENTRY		getnxtdci					ENTRY		setup_call_env					ENTRY		id_assignment					ENTRY		validate_msg					ENTRY		touthandler					ENTRY		clear_state					ENTRY		cleanup_sdr					ENTRY		adjtout					ENTRY		saveptrs					ENTRY		ckdcilst					ENTRY		setnoscan					ENTRY		setonline					ENTRY		oaddr_tbl					ENTRY		zap_oldcard					ENTRY		zpg_savebuff					ENTRY		getnextid;					EJECTscsi_man_header		PROC**********************************************************************************	SIB Header for SCSI Manager*********************************************************************************;					EXPORT		scsim_chars					EXPORT		snooper_ptr;					dc.l	scsi_man_exec		;ENTRY address to scsi Manager					dc.w	SCSI_Manager_ID		;scsi manager := $0002scsim_version		dc.w	$1000				;version 1.0 Final for release 5.0					dc.l	manager_name		;name string of managerscsim_chars			dc.w	$8000				;restartable supervisory driver					dc.w	$0000				;RESERVED;snooper_ptr			dc.l	$00000000			;will hold the address of Managers zero pagemanager_name		dc.b	namelen				;length of name (Pascal string)					dc.b	'SCSI.MANAGER'		;SCSI Managernamelen				equ		*-manager_name-1pad					dcb.b	20,' '				;20 spaces of pad for max name 32 bytes;					ENDP					EXPORT	cmd_tablecmd_table			PROC*********************************************************************************	SCSI Manager command table********************************************************************************;					dc.w	scsim_startup					dc.w	scsim_shutdown					dc.w	scsim_reqdevs					dc.w	scsim_claimdevs					dc.w	scsim_io					EXPORT	max_cmd:equmax_cmd				equ		(*-cmd_table)/2					ENDP					EJECT					EXPORT	addr_tablesaddr_tables			PROC**********************************************************************************		Address table for routines defined for each interface type*********************************************************************************;;old_addr_table		dc.l	oaddr_tbl			;table for old scsi card							EXPORT	num_dev_types:equnum_dev_types		equ		(*-addr_tables)/4	;number of device types;					ENDP					EJECT					EXPORT	scsi_variablesscsi_variables		PROC**********************************************************************************		SCSI Manager internal variables*********************************************************************************;					EXPORT	smbusy_flag					EXPORT	ahold					EXPORT	xhold					EXPORT	yhold					EXPORT	ourcode_bank					EXPORT	handle_hold					EXPORT	zpg_handle					EXPORT	zpg_hold					EXPORT	gsos_zpg_hold					EXPORT	sdriver_no_hold					EXPORT	sm_call_no					EXPORT	asense_flag					EXPORT	error_stat					EXPORT	user_id					EXPORT	devices_found					EXPORT	last_acc_slot1					EXPORT	last_acc_id1					EXPORT	last_sdr_ptr1					EXPORT	last_acc_slot2					EXPORT	last_acc_id2					EXPORT	last_sdr_ptr2					EXPORT	last_acc_flag					EXPORT	hwd_version					EXPORT	ioattrbs					EXPORT	init_priority					EXPORT	target_priority					EXPORT	initiator_id					EXPORT	target_id					EXPORT	cyareg_hold					EXPORT	slotrom_hold					EXPORT	bus_stat_hold					EXPORT	our_irq_flag					EXPORT	identify_flag					EXPORT	work_vars_buffer					EXPORT	more_dci					EXPORT	more_phases					EXPORT	scsi_status					EXPORT	scsi_message					EXPORT	msg_out_byte					EXPORT	lutemp					EXPORT	ckluflag					EXPORT	move_cnt					EXPORT	smboot_slot					EXPORT	busy_sdr_count					EXPORT	phase_hold					EXPORT	current_phase					EXPORT	new_phase					EXPORT	zpg_savebuff;smbusy_flag			dc.w	$0000				;scsi manager busy flag (powers up cleared)ahold				dc.w	$0000xhold				dc.w	$0000yhold				dc.w	$0000ourcode_bank		dc.w	$0000				;bank we run fromuser_id				dc.w	$0000				;our ID provided by memory managerhandle_hold			dc.l	$00000000			;our handle place holderzpg_handle			dc.l	$00000000			;zero page handle place holderzpg_hold			dc.w	$0000				;zero page adddress holdergsos_zpg_hold		dc.w	$0000				;GS/OS zero page placeholdersdriver_no_hold		dc.w	$0000				;scsi Manager supervisor driver numbersm_call_no			dc.w	$0000				;scsi manager call number holder;asense_flag			dc.w	$0000				;autosense in progress flagerror_stat			dc.w	$0000		devices_found		dc.w	$0000				;SCSI devices found connected to card/port flaglogicals_found		dc.w	$0000				;Logical units found for scsi device ID;last_acc_slot1		dc.w	$0000				;slot number field of device last accessedlast_acc_id1		dc.w	$0000				;last id accessed holder record 1last_sdr_ptr1		dc.l	$00000000			;pointer to last sdr accessed record 1last_acc_slot2		dc.w	$0000				;slot number field of device last accessedlast_acc_id2		dc.w	$0000				;last id accessed holder record 2last_sdr_ptr2		dc.l	$00000000			;pointer to last sdr accessed record 2last_acc_flag		dc.w	$0000				;flag & index for last access pointer updating;target_priority		dc.w	$0000				;target priorityinit_priority		dc.w	$0000				;initiator priorityhwd_version			dc.w	$0000				;hardware version numberioattrbs			dc.w	$0000				;slot/port attributes;initiator_id		dc.w	$0000				;initiating scsi device idtarget_id			dc.w	$0000				;target scsi device idcyareg_hold			dc.b	$00					;cya register holding locationslotrom_hold		dc.b	$00					;SLOTROMSEL holding locationbus_stat_hold		dc.w	$0000				;SCSSI bus status place holderour_irq_flag		dc.w	$0000				;scsi manager interrupt flagidentify_flag		dc.w	$0000				;send identify msg byte flag;more_dci			dc.w	$0000				;more data chain instructs. available flagmore_phases			dc.w	$0000				;more phases phase handler triggerscsi_status			dc.w	$0000				;scsi call status fieldscsi_message		dc.w	$0000				;scsi call message field;msg_out_byte		dc.w	$0000				;message byte to send during message out phaselutemp				dc.w	$0000				;bitpattern for each possible LU on a SCSI IDckluflag			dc.w	$0000				;toggle flag marking when to compare inq buffersmove_cnt			dc.w	$0000				;byte count to move by move_bytes routinesmboot_slot			dc.w	$0000				;slot number boot occuring frombusy_sdr_count		dc.w	$0000				;count of number of busy SDRsphase_hold			dc.w	$0000				;placeholder for current phase bitscurrent_phase		dc.w	$FFFF				;totally invalid valid when loadednew_phase			dc.w	$FFFF				;new phase flag;					EXPORT	work_vars_size:equwork_vars_size		equ		*-scsi_variableswork_vars_buffer 	ds.b	work_vars_size		;holding buffer for work variables during IRQzpg_savebuff		ds.b	maxzpg_space					ENDP						EJECT					EXPORT	scsi_man_execscsi_man_exec		PROC******************************************************************************* Description:	This module controls the command execution of the SCSI*		Manager.  All commands flow through this routine.*		It validates the command to make sure it is within range,*		installs our memory work area pointers and then passes control*		to the specific call.**	NOTE: 	This code assumes that Supervisor startup call is the first*		call made to the SCSI Manager and can occur only once during*		any system startup session.**	Inputs:	e,m,x=0	(full native)*		A = Supervisors driver number*		X = SCSI Manager command number*		Y = Supervisor ID*		D = GS/OS Direct page*		Stack = GS/OS stack space*		Speed = fast***	Output:	e,m,x=0 (full native)*		C = 0 for successful call*		C = 1 for error during call*		A = Error code or supervisor driver number*		D = GS/OS direct page*		B same as ENTRY*		X,Y trashed*		*****************************************************************************;###					longa	on					longi	on;;	point to our code bank & check if scsi manager already busy;					sta		$FF0400				;for logic analyzer trigger purposes					phb							;save data bank register					phd							;save direct register					phk							;point to our code segment					plb							;data bank reg saved by Sup. Disp.					bit		|smbusy_flag					bpl		@75					lda		#sm_busy_err		;mark scsi manager busy error					brl		execend				;and go away;	;	SCSI Manager not busy go issue the call;@75					jsl		incbusyflag			;increment busy flag to prevent CDA access					sta		|sdriver_no_hold	;save supervisor driver number					stx		|sm_call_no			;save the call number					cpx		#max_cmd			;check if command in range					bcc		rangok;;	command out of range report the error;					lda		#scsicmd_err		;command out of range					brl		execend;rangok				cpx		#startup			;check for startup					beq		warmchk					brl		notst;;	Check for a warmstart.  If warmstart install allocate a zero page and;	restore the zero page data back into to it. Also, no matter if warmstart;	or cold start install interrupt handler and heartbeat task handler.;warmchk				jsr		bind_scsi_irq		;install our irq handler					bcc		@100				;go away if error					brl		rsrcerr;;	startup the VBL interrupts source;@100				pea		$0002				;vertical irq reference number					_IntSource;;	Install timeout handler heartbeat task;					pea		tout_header>>16					pea		tout_header					_SetHeartBeat					bcc		@105					brl		rsrcerr;;	Install arbitration timeout heartbeat task;@105				pea		arbtout_header>>16					pea		arbtout_header					_SetHeartBeat					bcc		@110					brl		rsrcerr@110				bit		|scsim_chars		;check bit 15 for restartable					bpl		coldst				;coldstart if not restartable					lda		>warm_cold_flag					and		#$0001					beq		coldst				;Z=1 marks a coldstart go do it;;	allocate zero page area;warmst				pha							;room for handle					pha					pea		|maxzpg_space>>16	;zero page					pea		|maxzpg_space					lda		|user_id			;our user ID					pha					pea		zpg_attrbs			;attributes for our zero page					pea		zpgbank				;must be in bank zero & page aligned					pea		$0000				;don't really care where in bank $00					_newhandle					;allocate our memory area					ply							;assume all ok					plx					bcs		rsrcerr				;go away if error					sty		|zpg_handle			;save our handle					stx		|zpg_handle+2					sty		<sup_parm_ptr 		;this pointer used as scratch during startup					stx		<sup_parm_ptr+2					lda		[sup_parm_ptr]						sta		|zpg_hold					tay							;setup destination address of buffer					ldx		#zpg_savebuff		;X = source address, Y = destination address 					lda		#maxzpg_space					sta		|move_cnt			;move_cnt := number of bytes to move;					longa	off					sep		#$20				;m=1					phb							;get destination bank					pla					xba					lda		#$00				;get source bank					longa	on					rep		#$20				;m=0					jsr		move_bytes					lda		|zpg_hold			;set our direct register					clc							;point to the 2nd zero page					adc		#driverzpgsize					stz		|snooper_ptr+2		;clear high word of the snooper cda pointer					sta		|snooper_ptr		;save the address of the zero page					tcd							;point to our zero page					stz		|error_stat			;clear the error status field					bra		warmend				;go away;;	Coldstart;coldst				tdc							;save GS/OS zero page address (will need later)					sta		|gsos_zpg_hold						phk							;save our code bank address					phk					pla							;bank of parameter list					and		#$00FF					sta		|ourcode_bank					jsr		allocate_memory		;get our work memory					bcc		memok;;	failed to allocate working resources;rsrcerr				lda		#sm_rsrc_err		;scsi manager could not allocate memory					bra		execend				;go away;;	dereference our handle;memok				lda		|handle_hold		;setup handle pointer					sta		scratchzpg					lda		|handle_hold+2					sta		scratchzpg+2;;	form I/O table address;					ldy		#$0000					lda		[scratchzpg],y		;form memory pointer					sta		<io_table_ptr					tax							;low word of pointer					ldy		#$0002					lda		[scratchzpg],y					sta		<io_table_ptr+2					tay							;high word of pointer					txa							;form address of SDR table					clc;;	Form SDR table address;					adc		#iotsize					sta		<sdr_table_ptr					sty		<sdr_table_ptr+2					sta		<next_sdr			;link to first sdr					sty		<next_sdr+2					lda		#default_sdrs		;number of default SDRs					sta		<avail_sdrs;;	clear newly acquired memory;					lda		#min_mem_size		;number of bytes to clear					jsr		clear_memory		;go clear them					bra		clrerr;;	non startup call enters here;notst				lda		|zpg_hold			;point to our zero page					clc							;point to our zero page area					adc		#driverzpgsize		;2nd zero page is mine					tcdclrerr				stz		|error_stat			;clear error status					lda		|sm_call_no			;get the call number back					asl		A					;two byte pointers					tax					jsr		(cmd_table,x)		;go to it!												;all calls return here except SHUTDOWN;;	clear scsi call status and message working variables;warmend				stz		|scsi_status					stz		|scsi_message					jsl		decbusyflag			;adjust the busy flag (CDAs can come in)					lda		|error_stat			;check for non zero status					stz		|error_stat			;clear the error status fieldexecend					sta		$FF0402				;**** Debug					pld							;restore GS/OS direct page					plb							;restore data bank register					cmp		#$0001				;set carry on errors					rtl					ENDP					EJECT					EXPORT	allocate_memoryallocate_memory		PROC*********************************************************************************	This routine will allocate an ID from the Misc. Tools and issue a*	New_handle call to the memory manager using this ID.  The Handle returned*	will be save away to be used during Shutdown of the SCSI Manager.**	ENTRY:	e,m,x=0**	Exit:	e,m,x=0*		Y restored*		X restored*		(user_id):= ID given to us by Misc. Tools*		(smhandle_hold) := handle address from memory manager*		(scsim_ptr) := actual buffer address from handle*		*********************************************************************************;;;;					longa	on					longi	on;;	Get an ID from Misc tools;					pha							;room for ID from Misc. Tools					pea		#mtool_id_type		;ID type for sup. drivers from misc. tools					_getnewid					;					ply							;get our ID assuming call succeeded					bcs		@30					;check for error					sty		|user_id;;	allocate our zero page area;					pha							;room for handle					pha					pea		|maxzpg_space>>16	;zero page					pea		|maxzpg_space					lda		|user_id			;our user ID					pha					pea		zpg_attrbs			;attributes for our zero page					pea		zpgbank				;must be in bank zero & page aligned					pea		$0000				;don't really care where in bank $00					_newhandle					;allocate our memory area					ply							;assume all ok					plx					bcs		@30					;go away if error					sty		<sup_parm_ptr 		;this pointer used as scratch during startup					stx		<sup_parm_ptr+2					lda		[sup_parm_ptr]						sta		|zpg_hold					sty		|zpg_handle			;save our handle					stx		|zpg_handle+2					ldx		|zpg_hold			;go zero out the memory					ldy		#$0000 					lda		#maxzpg_space					jsr		clear_memory					lda		|zpg_hold			;set our direct register					clc							;point to the 2nd zero page					adc		#driverzpgsize					stz		|snooper_ptr+2		;clear high word of the snooper cda pointer					sta		|snooper_ptr		;save the address of the zero page					tcd							;point to our zero page;;	allocate our work space;					pha							;room for handle					pha							;					pea		|min_mem_size>>16	;our work area size of 3 pages					pea		|min_mem_size					lda		|user_id			;our user ID					pha					pea		sm_buffer_attrs		;attributes for our buffer					pea		$0000				;location pointer (will be ignored)					pea		$000					_newhandle					;allocate our memory area					ply							;assume all ok					plx					bcs		@30					;go away if error					sty		|handle_hold		;save our handle					stx		|handle_hold+2	@30					rts							;>>>--- allocate_memory --->>>;					ENDP					EJECT					EXPORT	clear_memoryclear_memory		PROC*********************************************************************************	This routine clears a specified number of bytes starting at a given*	location.  It assumes no bank crossings!!!!**	ENTRY:	e,m,x = 0*		A = Number of bytes to clear*		X = Low word of first location to clear*		Y = High word of first location to clear**	Exit:	e,m,x = 0*		A,X,Y undefined*********************************************************************************;;					longa	on					longi	on;					stx		<sup_parm_ptr		;sup_parm_ptr used as scratch during					sty		<sup_parm_ptr+2		;startup					dec		A					;adjust count to compensate for dest start					sta		|move_cnt			;number of bytes to clear					lda		#$0000				;clear first two locations					sta		[sup_parm_ptr]					tya							;save the bank					inx					txy							;destination address					and		#$00FF				;keep low byte of bank					pha							;					xba							;source & destination banks the same					ora		1,s					plx							;trash word on stack					ldx		<sup_parm_ptr		;restore source address;					lda		#$0000				;fill pattern						jsr		move_bytes			;go clear memory					rts							;>>>--- clear_memory --->>>;					ENDP					EXPORT	move_bytesmove_bytes			PROC************************************************************************************	This routine will move a specified number of bytes from a source address*	to a destination address.  Please NOTE that this routine contains self*	modifying code.**	ENTRY:	e,m,x = 0*		A accum = Dest bank*		B accum = Source bank*		move_cnt = number of bytes to move*		X = Source address*		Y = Dest address**	Exit:	e,m,x = 0*		A = $FFFF*		X,Y = undefined*		Data Bank register saved and restored************************************************************************************;;					longa	on					longi	on;					phb							;save data bank					sta		move_it+1			;save source & destination banks					lda		move_cnt			;number of bytes to move					dec		A					;adjust byte countmove_it				mvn		$00,$00				;*** WARNING self modifying code!!!! ***					plb							;restore data bank register					rts							;>>>>--- move_bytes ---->>>>;					ENDP						EJECT					EXPORT	scsim_startupscsim_startup		PROC********************************************************************************* 	This module will allocate all the resources needed by the SCSI Manager*	to become operational.  It determines how many scsi devices are online*	and build all the routing data structures to gain access to the devices.**	Input:	e,m,x=0**	Output:	e,m,x=0*		C=0 if successful*		C=1 if SCSI Manager startup failed*		A = Supervisor driver number if successful call*		A = error code if call failed*********************************************************************************;					longa	on					longi	on;;	go look for SCSI Peripheral cards/ports;					jsr		find_scsi			;go look for scsi cards/ports					bcs		@85					;none found report error (we get purged);;	initiaize SCSI Device Record (SDR) table;					jsr		init_sdr_tbl		;initialize scsi device records					bcc		exit;;	Delete timeout heartbeat task if errors;@85					pea		tout_header>>16		;high word of timeout task header					pea		tout_header					_DelHeartBeat					bcs		@250				;someone destroyed our heartbeat;;	dispose our memory;					lda		|user_id			;dispose of zero page and work areas					pha					_disposeall					bcs		@250				;dispose of memory allocated to us;;	dispose our ID back to Misc. Tools;					lda		|user_id			;dispose our ID					pha					_DeleteID					bcc		sfail@250				jsl		gsos_sys_death		;bad news could not dispose our memorysfail				lda		#scsi_start_err		;mark error					sta		|error_stat					secexit				rts							;>>>--- scsi_man_startup --->>>;					ENDP			EJECT					EXPORT	scsim_shutdownscsim_shutdown	PROC********************************************************************************* 	This module will perform the necessary functions to get the*	SCSI Manager resources allocated during startup released*	back to the system and shutdown the scsi hardware.**	Input:	e,m,x=0**	Output:	e,m,x=0*		C=0 if successful*		C=1 error occurred*		A = Supervisor driver number if successful call*		A = error code if call failed*********************************************************************************;;	unbind our interrupt handler;					jsr		unbind_scsi_irq		;					bcs		death				;go away if error;;	delete our timeout heartbeat task;					pea		tout_header>>16					pea		tout_header					_DelHeartBeat					bcs		death				;go away if error;;	delete arbitration heartbeat task;					pea		arbtout_header>>16					pea		arbtout_header					_DelHeartBeat					bcs		death				;go away if error;;	check characteristics word for restartable.  If restartable then;	check warm_cold_flag to see if going to sleep or being killed.;					bit		|scsim_chars		;check bit 15 for restartable					bpl		@100				;coldshutdown if not restartable					lda		>warm_cold_flag					beq		@100				;Z=1 marks a cold shutdown go do it;;	warmshutdown saves zero page in a internal buffer within the manager;					tdc							;get our zero page area					sec					sbc		#driverzpgsize		;include the zero page area allocated for drivers					tax							;keep as source address					ldy		#zpg_savebuff		;get the destination buffer address 					lda		#maxzpg_space					sta		|move_cnt			;move_cnt := number of bytes to move					longa	off					sep		#$20				;m=1					lda		#$00				;source memory bank number					xba					phb					pla							;get destination buffer bank address					longa	on					rep		#$20				;m=0					jsr		move_bytes			;save the zero page areas;;	now dispose the zero page area allocated;					lda		|zpg_handle+2					pha					lda		|zpg_handle					pha					_disposeHandle					bcs		death					bra		wrmshut				;go away	;;	dispose all memory allocated to us;@100				lda		|user_id			;dispose all memory we allocated					pha					_disposeAll					bcs		death				;dispose of memory allocated to us;;	dispose our ID back to Misc. Tools;					lda		|user_id			;dispose our ID back to misc tools					pha					_DeleteIdwrmshut				jsr		zap_oldcard					lda		|sdriver_no_hold	;get supervisor driver number if clean shutdown ;MSG wrmshut				lda		|sdriver_no_hold	;get supervisor driver number if clean shutdown 					rts							;>>>--- scsim_shutdown --->>>death				jsl		gsos_sys_death		;call system death will not return;					ENDP					EJECT					EXPORT	scsim_reqdevsscsim_reqdevs		PROC*********************************************************************************	This module will handle will return IDs for all devices mathching a*	requested device type.**	Input:	e,m,x=0**	Output:	e,m,x=0*		C=0 if successful*		C=1 if SCSI Manager device call failed*		A = Supervisor driver number if successful call*		A = error code if call failed*********************************************************************************;;					longa	on					longi	on;					stz		|error_stat			;reset error status					jsr		get_plist			;point to the parameter list					stx		<plist_ptr			;form pointer to parameter list					sty		<plist_ptr+2					ldy		#destbuffptr		;get destination buffer address					lda		[plist_ptr],y					sta		buffer_ptr					ldy		#destbuffptr+2					lda		[plist_ptr],y					sta		buffer_ptr+2					lda		|zpg_hold			;get the driver's zero page address;					sta		[buffer_ptr]		;save the driver zero page address					sta		[buffer_ptr]					ldy		#scsi_dtype			;check for device type					lda		[plist_ptr],y					jsr		devtype_chk			;check for valid device type					bcc		@100					lda		#bad_dev_type					sta		|error_stat					bra		reqexit				;bad type go away@100				ldx		<sdrsonline			;set number of sdrs to compare against					stx		<sdrstocheck					bne		@200					ldx		#$0000				;zero devices found					txa					pha							;call status					sta		|error_stat					bra		all_done@200				jsr		build_reqlist		;build list of devices matching device typereqexit				rts							;>>>--- scsim_reqdevs --->>>;	;	check for valid scsi device type;Apple_tape			equ		$0010				;Apple tape drivecomm_dtype			equ		$0009				;communications device;devtype_chk			and		#$001F				;low 5 bits only					beq		good_type			;if zero then ok					cmp		#apple_tape			;check for apple tape drive					beq		good_type					cmp		#apple_tape+1		;check for devices 11-1F					bcs		bad_type			;if so, bad news					cmp		#comm_dtype+1		;check for types A-F					bcs		bad_typegood_type			clcbad_type			rts							;>>>--- devtype_chk --->>>;;	build request list for caller;build_reqlist		pha					ldx		#$0000				;clear device counter					lda		sdr_table_ptr		;point to the SCSI device records					sta		<scratchzpg					lda		sdr_table_ptr+2					sta		<scratchzpg+2check_type			ldy		#sdr_devtype		;index to device type field					lda		[scratchzpg],y					and		#$00FF				;low byte only (devtype one byte)					cmp		1,s					;compare the types					beq		type_matchchk_next_sdr		dec		<sdrstocheck		;see if more sdrs to check					beq		all_done;					ldy		#nxt_sdr_lnk		;point to next sdr in the list					lda		[scratchzpg],y		;check next SDR					pha					ldy		#nxt_sdr_lnk+2					lda		[scratchzpg],y					sta		<scratchzpg+2					pla					sta		<scratchzpg					bra		check_type;;	Found an SDR record which matches the type tell caller;type_match			inx							;bump number of matching devices count					ldy		#sdr_slot			;include the slot number					lda		[scratchzpg],y		;					ldy		#device_slot		;point to Slot number field					sta		[buffer_ptr],y					ldy		#sdr_device_id		;get the device ID of the target					lda		[scratchzpg],y					ldy		#device_id					sta		[buffer_ptr],y					lda		<buffer_ptr			;bump address					clc					adc		#reqENTRY_size		;by one ENTRY size					sta		<buffer_ptr					bcc		chk_next_sdr		;go check the next sdr					inc		<buffer_ptr+2					bra		chk_next_sdr		;;	write out device count found to match the type;all_done			ldy		#destbuffptr		;point to start of the destination buffer					lda		[plist_ptr],y					sta		<scratchzpg					ldy		#destbuffptr+2					lda		[plist_ptr],y					sta		<scratchzpg+2					ldy		#total_devcount		;point to device count field					txa					sta		[scratchzpg],y		;write the count					pla					rts							ENDP						EJECT					EXPORT	scsim_claimdevsscsim_claimdevs		PROC*********************************************************************************	This module will mark specific SDR records as claimed the the driver*	who made the immmediatelly previous Req_Devices  call from the same*	driver.**	Input:	e,m,x=0**	Output:	e,m,x=0*		C=0 if successful*		C=1 if SCSI Manager device call failed*		A = Supervisor driver number if successful call*		A = error code if call failed*********************************************************************************;;;	get parameter list pointer & point to buffer;					stz		|error_stat			;reset error status					jsr		get_plist			;point to the parameter list					stx		<plist_ptr			;form pointer to parameter list					sty		<plist_ptr+2					ldy		#destbuffptr		;get destination buffer address					lda		[plist_ptr],y					sta		<buffer_ptr					ldy		#destbuffptr+2					lda		[plist_ptr],y					sta		<buffer_ptr+2					ldy		#total_devcount		;total number of devices in the list					lda		[buffer_ptr],y					dec		a					sta		<scratchzpg					bra		get_id;;	find SDR matching this ID;next_id				dec		<scratchzpg			;decrement the total device count in the list					bpl		@100				;check next ID if count not zero					clc							;otherwise mark success & quit					rts;@100				lda		<buffer_ptr			;bump to the next id in the list					adc		#reqENTRY_size		;size of each device ENTRY in list					sta		<buffer_ptr					bcc		get_id					inc		<buffer_ptr+2get_id				ldy		#device_id			;point to the ID field in claim parameter list					lda		[buffer_ptr],y		;get the ID					bpl		next_id				;Doesn't want it.  Do next one in list.					and		#$7fff					sta		<dev_id				;save the id sought					ldy		#device_slot		;point to the slot field in claim parameter list					lda		[buffer_ptr],y		;get the slot number					sta		<slot_no			;					jsr		find_sdr			;get the SDR address (C=1 then invalid ID)						bcs		exit				;if error then go away;;	mark device claimed if not claimed previously;					sty		<sdr_ptr			;save the SDR address					sta		<sdr_ptr+2					ldy		#device_id			;set high bit to mark claimed					lda		[sdr_ptr],y			;device claimed marker (bit 15 of device id)					bmi		@error				;if already set then an error					ora		#claimed			;Set the bit					sta		[sdr_ptr],y					bra		next_id@error				lda		#bad_scsi_id					sta		|error_stat			;mark ID errorexit				rts							;>>>--- scsim_claimdevs --->>>;					ENDP					EJECT					EXPORT	scsim_ioscsim_io			PROC*********************************************************************************	This module will handle all calls passed to it by drivers.**	Input:	e,m,x=0**	Output:	e,m,x=0*		C=0 if successful*		C=1 if SCSI Manager io call failed*		A = Supervisor driver number if successful call*		A = error code if call failed*********************************************************************************;;;	get parameter list address and validate the parameter list;					jsr		get_plist					stx		<plist_ptr					sty		<plist_ptr+2					jsr		ioplchk				;validate I/O call parameter list					bcc		@60					brl		errexit;;	setup working variables from parameter list;@60					ldx		<plist_ptr					ldy		<plist_ptr+2					jsr		setzpgvars			;setup zero page work pointers;;	find SDR matching ID from parameter list;					jsr		find_sdr					bcc		@75					brl		errexit@75					sty		<sdr_ptr					sta		<sdr_ptr+2					sty		<active_sdr					sta		<active_sdr+2;;	check if SDR already busy;					ldy		#sdr_flags					lda		[sdr_ptr],y					and		#sdr_attrb_busy					beq		@100					lda		#target_busy					sta		|error_stat					sec					brl		errexit;;	copy parameters into SDR, mark SDR busy;@100				php							;no interruptions					sei					lda		[sdr_ptr],y					ora		#sdr_attrb_busy					sta		[sdr_ptr],y					plp							;restore interrupt enable bit					jsr		copy_plist;;	setup work variables from SDR and issue call to the target;					jsr		setup_call_env					ldy		<slot_no			;get the slot number					jsr		set_iorec_ptr		;point to the I/O record for this SDR;;	point to routines table for this type of scsi card;					ldy		#hwd_type					lda		[iorec_ptr],y					asl		A					tay					lda		|addr_tables,y					sta		<addr_table_ptr					lda		|addr_tables+2,y					sta		<addr_table_ptr+2;;	arbitrate for the SCSI bus and then Select the target;					lda		#arbph				;go arbitrate for control of scsi bus					jsr		callrtn					bcc		@125				;go select if arbitration succeeded					brl		exit@125				lda		#selectph			;select the target device					jsr		callrtn					bcc		@150				;go away if an error occurs					brl		exit;;	do some hardware initialization;@150				lda		#setup					jsr		callrtn;;	start the timeout heartbeat task;					jsr		getticks			;get number of ticks to load into the task header					sta		|tick_count;;	do a save pointers prior to talking to the target in case the;	first communication from the target is a restore pointers message;					jsr		saveptrs;;	bump the busy SDR count and then go to the phase handler;					inc		|busy_sdr_count					lda		#phase_hand			;phase handler for old scsi card					jsr		callrtn					bcc		error				;check for possible SCSI status error					brl		exit;;	check scsi status byte for success.  If failed see if autosense required;error				lda		|asense_flag		;see if returning from a autosense call					beq		@75					;not autosense;;	if autosense failed mark it failed and quit;					bcc		@50					brl		exit@50					lda		|scsi_status		;if status byte not zero then mark failed					bne		@55					lda		<error_stat					beq		@60@55					sec@60					brl		exit;;	call was not autosense. See if autosense enabled and previous call failed;	then issue a request sense call to the same target.;@75					lda		|scsi_status					beq		statok;;	The following code will be executed only if the call failed and autosense;	 is enabled.  If autosense is enabled then SCSIM_IO will be called again.;					ldy		#plst_autos_ptr		;see if the auto sense pointer nonzero					lda		[plist_ptr],y					ldy		#plst_autos_ptr+2					ora		[plist_ptr],y					beq		@100;;	save the scsi status byte and parameter list pointer for later restore;					lda		|scsi_status					pha							;save scsi status of previous call					jsr		get_plist			;get call's parameter list pointer					phy							;save old parameter list pointer					phx;;	setup the ID & buffer pointer for the request sense call;					lda		<dev_id				;device id to issue request sense for					sta		|senseid					lda		<slot_no			;slot number to issue call for					sta		|sense_slot					ldy		#plst_autos_ptr					lda		[plist_ptr],y					sta		|sensebstruc					ldy		#plst_autos_ptr+2					lda		[plist_ptr],y					sta		|sensebstruc+2					lda		#$00FF				;256 bytes maximum requested					longa	off					sep		#$20				;m=1					sta		|sensecnt0			;byte count requested in scsi command packet					longa	on					rep		#$20				;m=0					sta		|sensecnt1			;byte count in data chaining instructions					ldx		#sense_plist		;point to request sense parameter list					ldy		|ourcode_bank					jsr		set_plist;;	set autosense in progress flag and clear SDR busy flag for mode sense call;					dec		|asense_flag		;mark autosense in progress					ldy		#sdr_flags			;clear busy bit (*** change for disconnect case ***)					lda		[sdr_ptr],y					and		#sdr_attrb_busy\							--$FFFF					sta		[sdr_ptr],y					jsr		scsim_io			;issue the autosense call;;	restore parameter list pointer and scsi status for previous call;					plx							;restore parameter list pointer					ply					jsr		set_plist			;restore the parameter list pointer					lda		|error_stat			;get status from request sense call					cmp		#$0001				;check of request sense failed					pla							;restore status from call prior to request sense					bcc		@100					ora		#$0080				;bit 7 marks request sense failed@100				ora		#scsi_man_err		;include $FE00 (marks error)					sta		|error_stat			;scsi status error overides other errors					stz		|asense_flag		;reset the autosense flag;;	call completion routine if vector non-zero;statok				jsr		callcomp			;call completion routine if a pointer existsexit				dec		|busy_sdr_count 	;command completed one less SDR					bne		@100					stz		|tick_count			;reset heartbeat counter no busy sdrs@100				ldy		#sdr_flags			;clear busy bit (*** change for disconnect case ***)					lda		[sdr_ptr],y					and		#sdr_attrb_busy\							--$FFFF					sta		[sdr_ptr],yerrexit				lda		|error_stat			;get possible error code backautosexit			rts							;>>>--- scsim_io --->>>;;----------------------------------------------------------------------------;	call completion routine if a pointer exists;;	ENTRY:	e,m,x = 0;		error_stat = error code to report;;	exit:	e,m,x = 0;		A,Y trashed;;----------------------------------------------------------------------------;callcomp			ldy		#plst_comp_vect+2	;					lda		[plist_ptr],y					ldy		#plst_comp_vect					ora		[plist_ptr],y					beq		@125				;go away if pointer zero					lda		[plist_ptr],y					sta		@100+1					iny					lda		[plist_ptr],y					sta		@100+2					lda		|error_stat@100				jsl		$000000				;*** SELF MODIFYING CODE@125				rts							;>>>--- callcomp --->>>;;;----------------------------------------------------------------------------;	Copy parameter list into SDR;;	ENTRY:	e,m,x = 0;		plist_ptr: points to the parameter list;;	Exit:	e,m,x = 0;;----------------------------------------------------------------------------;;	copy the timeout into the SDR record;copy_plist			ldy		#plst_timeout					lda		[plist_ptr],y					jsr		adjtout				;convert timeout from 1/4 sec into 1/60 sec counts					ldy		#sdr_timeout					sta		[sdr_ptr],y					ldy		#sdr_timeout+2					txa					sta		[sdr_ptr],y;;	copy completion vector into sdr;					ldy		#plst_comp_vect					lda		[plist_ptr],y					pha					ldy		#plst_comp_vect+2					lda		[plist_ptr],y					ldy		#sdr_completion_vect+2					sta		[sdr_ptr],y					pla					ldy		#sdr_completion_vect					sta		[sdr_ptr],y;;	copy the SCSI command list pointer;					ldy		#plst_cmd_ptr					lda		[plist_ptr],y					ldy		#sdr_cmd_ptr					sta		[sdr_ptr],y					ldy		#plst_cmd_ptr+2					lda		[plist_ptr],y					ldy		#sdr_cmd_ptr+2					sta		[sdr_ptr],y;;	copy the address of the parameter list into the SDR;					ldy		#sdr_plist_ptr					lda		<plist_ptr					sta		[sdr_ptr],y					ldy		#sdr_plist_ptr+2					lda		<plist_ptr+2					sta		[sdr_ptr],y					rts							;>>>--- copy_plist --->>>;;----------------------------------------------------------------------------;	Validate I/O call parameter list;;	ENTRY:	e,m,x = 0;		plist_ptr: points to parameter list;;	Exit:	e,m,x = 0;		C=0 if success otherwise failed;		C=1 if failed check & error_stat = error code;;----------------------------------------------------------------------------;ioplchk				ldy		#plst_slot			;check for slots 0-F					lda		[plist_ptr],y					cmp		#$0010					bcs		plfail				;fail it if out of range					ldy		#plst_devid			;check ID for nonzero					lda		[plist_ptr],y					beq		plfail					ldy		#plst_version		;check the parameter block version					lda		[plist_ptr],y					bne		plfail;;	check reserved attribute bits for zero;					ldy		#plst_attrbs					lda		[plist_ptr],y					and		#plst_attresbits					bne		plfail;;	check the timeout for nonzero;					ldy		#plst_timeout					lda		[plist_ptr],y					beq		plfail;;	check the command list pointer for nonzero;					ldy		#plst_cmd_ptr					lda		[plist_ptr],y					ldy		#plst_cmd_ptr+2					ora		[plist_ptr],y					beq		plfail;;	check reserved field for zero;					ldy		#plst_reserved					lda		[plist_ptr],y					ldy		#plst_reserved+2					ora		[plist_ptr],y					bne		plfail;;	make sure request count and data chain pointer are consistent with each other;					ldy		#plst_dchainptr		;check data chain pointer for zero					lda		[plist_ptr],y					ldy		#plst_dchainptr+2					ora		[plist_ptr],y					bne		@100				;if data chain ptr zero then req count must = 0					ldy		#plst_reqxfr_cnt					ora		[plist_ptr],y					bne		plfail					ldy		#plst_reqxfr_cnt+2					ora		[plist_ptr],y					bne		plfail					beq		@150				;both zero go away@100				jsr		ckdcilst			;go check data chain inst list for stop inst					bcs		plfail;;	we got here, the parameter list must be OK;@150				clcplexit				rts							;>>>>---- I/O parameter list check --->>>;;	failed parameter list check;plfail				lda		#$0000					ldy		#plst_reqxfr_cnt	;Set transfer Count to Zero					sta		[plist_ptr],y					ldy		#plst_reqxfr_cnt+2					sta		[plist_ptr],y					lda		#plist_error		;error for parameter list error					sta		|error_stat					sec					rts;					ENDP						EJECT					EXPORT	callrtncallrtn				PROC********************************************************************************	This routine will pass control to a routine defined in a address table*	for a specific interface type**	ENTRY:	e,m,x=0*		X = routine number**	Exit:	e,m,x=0*		A,X,Y undefined********************************************************************************;;					asl		A					;times 2 for table index					taycallit				lda		(addr_table_ptr),y					dec		A					;adjust address					pha					rts							;call the routine;					ENDP					EJECT					EXPORT	scsi_irq_handscsi_irq_hand		PROC*********************************************************************************	This module will handle all interrupts which are generated by SCSI*	peripheral cards or internal scsi ports found during the "FIND_SCSI"*	subroutine call.*********************************************************************************;;					longa	on					longi	on					rep		#$30				;m=0, x=0;					phy							;save work registers					phx					phd							;save direct register					phb							;save data bank					phk							;point data bank to us					plb					lda		|zpg_hold			;point to our zero page					clc					adc		#driverzpgsize					tcd;;		save some variables we are about to clobber;					lda		<io_offset			;save the 5380 registers address pointer					pha					jsr		save_work_vars		;save our work area in case irqed? ourselves		pha;;		check the slots for nonzero;					lda		#$FFFF				;assume not our irq					sta		|our_irq_flag					ldy		#$0000@100				tyx							;save index to start of io record					lda		[io_table_ptr],y	;see if scsi is source of irq					beq		@200				;if zero no card in this slot					tya							;point to the hardware base address					clc					adc		#scsi_base			;get the base address of the 5380					tay					lda		[io_table_ptr],y					sta		<io_offset							jsr		bus_status			;go read status of scsi bus					sta		|bus_stat_hold		;save the status					lda		#birqstat			;check for scsi irq pending					bit		|bus_stat_hold					beq		@200					jsr		serve_irq			;go service interrupt					inc		|our_irq_flag		;$0000 = serviced one of our IRQs					bra		irq_hand_exit		;service one card per interrupt@200				txa							;point to next i/O record					clc					adc		#iorec_size					tay							;check if beyond end of io table					cmp		#iotsize					bcc		@100irq_hand_exit		pla							;restore contents of i/o offset					sta		<io_offset					lda		|our_irq_flag		;flag <> 0 if our irq					pha							;save the value of the flag					jsr		rest_work_vars		;restore our working variables					pla							;restore flag of our irq service					plb							;restore environment					pld					plx							;restore work registers					ply					cmp		#$0001					rtl							;>>>--- exit irq_hand --->>>;serve_irq			phx							;save register					ldx		<io_offset			;point to i/o space					sep		#$20				;m=1					lda		>resetirqreg,x		;reset the irq pending bit					rep		#$20				;m=0					jsr		bus_status			;**** debug make sure went away					plx							;restore register					rts							;very dumb handler so far!!;					ENDP											EJECT*********************************************************************************	This module contains all the code which makes up the OLD SCSI card*	portion of the SCSI Manager.********************************************************************************					EXPORT	old_scsi_tblsold_scsi_tbls		PROC*********************************************************************************		Old SCSI card Sequencer & routines table********************************************************************************;;**	Old scsi card routines address table*					EXPORT	oaddr_tbloaddr_tbl			dc.w	oscsi_irq_hand					dc.w	ophase_handler					dc.w	oscsi_hwd_check					dc.w	oscsi_setup					dc.w	oscsi_bus_free					dc.w	arbitrate_phase					dc.w	select_phase**	Phasing routines table**					EXPORT	phase_addr_tbl;phase_addr_tbl		dc.w	oscsi_data_out		;NOTE: Must remain in this relative position					dc.w	oscsi_data_in		; because phase bits used as index into					dc.w	osend_cmd			; this table. Please see SCSI standard					dc.w	oscsi_status		; and ophase_handler					dc.w	obad_phase			;reserved (invalid phase combination)					dc.w	obad_phase			;reserved (invalid phase combination)					dc.w	oscsi_msg_out					dc.w	oscsi_msg_in;					EXPORT	phase_offset:equphase_offset		equ		phase_addr_tbl\							-oaddr_tbl			;index to start of phase addr tbl;					ENDP					EJECT					EXPORT	oscsi_irq_handoscsi_irq_hand		PROC*********************************************************************************	Old scsi card interrupt handler.*	The old scsi card does not support interrupts!!!*********************************************************************************					sec							;go back to GS/OS irq handler					rtl							ENDP									EJECT					EXPORT	oscsi_hwd_checkoscsi_hwd_check		PROC*********************************************************************************	Old scsi card interrupt handler.*	The old scsi card does not support interrupts!!!*********************************************************************************;;					longa	on					longi	on;					lda		<slot_no			;get the slot					and		#slot7				;mask off internal external bit					xba							;times 256					clc							;point to end of rom image					adc		#old_rom_size-2		;check if old scsi card rom image (REV B & REV C roms)					tax					ldy		#old_rom_size-2@100				lda		>io_space+$00,x					eor		|old_rom,y					bne		@200				;not an old apple scsi card					dex					dex					dey					dey					bpl		@100;;	Check for REV C SCSI rom;;	point to bank $00 of old scsi card;	check location $C8XX for $02;	if $02 then REV C otherwise report error;	and do not install card in the tables;					longa	off					sep		#$20				;m=1					php					sei					lda		>$00CFFF			;turn off I/O strobe  space all cards					lda		<slot_no					and		#slot7				;keep low 3 bits					xba							;we want to access $CNXX space					tax					lda		>io_space,x			;to turn on I/O strobe space					plp							;restore possible irq enable					txa					xba					asl		A					;form DEV-SEL space address					asl		A					asl		A					asl		A					adc		#$80					tax					lda		#$00				;point to bank $00 of the SCSI rom					sta		>io_space\							+ocard_breg,x					lda		>$00CFFC			;get the rom rev C flag					cmp		#rev_C_rom					longa	on					rep		#$20				;m=0 					beq		@150				;install the card for NOW!! G.A.;;	This routine will report the requirement for a REV C SCSI rom;					lda		<slot_no			;get the slot number					and		#slot7				;keep low 3 bits					clc					adc		#$0030				;convert to a ascii slot number					sta		>slot_string+1		;include it in the message string					lda		#rom_message		;message number					pha					pea		slot_string>>16		;rom message string address					pea		slot_string					pea		$0000				;null substition string 0					pea		$0000					jsl		report_error		;call system service routine@150				jsr		set_old_scsi		;it is an old scsi card go set the I/O record					clc							;C=0 old scsi card					bcc		@300				;go away@200				sec							;C=1 NOT old scsi card or wrong rev rom@300				rts;slot_string			dc.b	$01					;size of string					dc.w	$0000*********************************************************************************	SCSI rom image*********************************************************************************	This module contains a partial image of the rev. B and rev. C scsi roms.*	The segment of code is the same in both roms and will be used to check*	the rom code in the old SCSI card against the pattern. If a match is found*	the scsi manager assumes that this is a OLD version SCSI card. The code*	resides in the I/O Select address space from $CN00 thru $CN57.********************************************************************************;;					longa	off					longi	off;old_rom				ldx		#$20				;what comments????					ldx		#$00					ldx		#$03					ldx		#$00					lda		$CFFF					cld					php					sei					lda		#$60					sta		|$07F8					jsr		$07F8					tsx					lda		|$0100,x					sta		|$07F8					plp					lda		|$CFFF					lda		|$07F8					sta		<$1A					lda		#$00					sta		<$19					tay					lda		($19),y					ldy		#$0A					lda		#$00					sta		($19),y					lda		#$55					sta		|$C8E3					lda		|$07F8					and		#$0F					clc					adc		#$08					asl		A					asl		A					asl		A					asl		A					sta		|$C81A					tay					ldx		#$00					lda		#$05					jsr		|$CFCC					lda		#$01					sta		|$C81D					sta		|$C800					dc.b	$20					;opcode for JSR (we want even byte count);old_rom_size		equ		*-old_rom;					ENDP							EJECT					EXPORT	set_old_scsiset_old_scsi		PROC*********************************************************************************	This routine will setup the I/O record for a particular slot with*	parameters for an old scsi card.**	ENTRY:	e,m,x = 0*		slot_no*		io_rec_ptr**	Exit:	e,m,x=0*********************************************************************************;;;					longa	on					longi	on;					lda		<slot_no			;save the slot number					ldy		#slot				;point to slot field					sta		[iorec_ptr],y		;slot number					lda		#old_scsi_card					ldy		#hwd_type			;save hardware version					sta		[iorec_ptr],y					lda		#old_card_attrbs	;old apple card default attributes					ldy		#io_attrbs					sta		[iorec_ptr],y					lda		<slot_no			;get the slot number					and		#slot7				;mask off internal/external bit					asl		A					;times 16					asl		A					asl		A					asl		A					adc		#io_space+$0080		;dev-sel address $C0NX					ldy		#scsi_base			;offset for base_address of scsi port in record		sta		[io_table_ptr],y	;and save it in the table					sta		[iorec_ptr],y		;the base addr bank & dma address already zero					sta		<io_offset			;the bank and DMA controller address := $0000					stz		<io_offset+2					tax;					longa	off					sep		#$20				;m=1 to fix the F.O. Hardware.;					lda		>card_priot_reg,x	;get the priority for this card					bne		@75					;if no jumper installed force priot 7					lda		#$80;					longa	on@75					rep		#$20;					and		#$00FF				;mask of read from $C0NB					ldy		#initpriot			;set it as initiator priority					sta		[iorec_ptr],y					lda		#$0000				;clear other fields in I/O record					ldy		#scsi_base+2					sta		[iorec_ptr],y		;clear bank field of scsi controller base addr					ldy		#scsi_base+4					sta		[iorec_ptr],y		;clear DMA controller base addr & bank					ldy		#scsi_base+6					sta		[iorec_ptr],y					ldy		#scsi_base+8					ldy		#d0logicals			;clear logical unit fields for scsi devices@100				sta		[iorec_ptr],y		;8 device fields 2 bytes each scsi device					iny					iny					cpy		#max_scsi_devs\							*2+d0logicals		;2 bytes per device field					bcc		@100					ldy		#initpriot			;initiator priority					lda		[iorec_ptr],y					jsr		priot_to_dev		;convert to scsi device number					asl		A					;times 2 because I/O record dev fields = words					clc					adc		#d0logicals			;point to device fields  within i/o record					tay					lda		#dont_scan_dev		;do not scan initiator priority for logicals					sta		[iorec_ptr],y					jsr		bus_reset			;reset scsi bus for this card					inc		<numscsi_cards		;bump the scsi cards total					rts							;>>>--- set_old_scsi --->>>;					ENDP					EJECT					EXPORT	oscsi_bus_freeoscsi_bus_free		PROC*********************************************************************************	Old scsi card Bus Free support********************************************************************************					sec					rts							;>>>--- exit oscsi_bus_free --->>>									ENDP									EJECT					EXPORT	oscsi_setuposcsi_setup			PROC*********************************************************************************	This module will setup all the required variables and pointers before*	performing a specified function requested by the caller.  The routine*	performs the following functions:*		1. Gets the parameter list pointer from the SIB*		2. sets up a parameter list pointer*		3. sets up all the zero page pointers to access all the buffers*		4. loads the index of the next routine in the table to run*********************************************************************************;;					longa	on					longi	on;@100				jsr		oinit_5380			;initialize old scsi card registers					jsr		ocopyzcode			;download high speed routines into zpg.					clc							;mark success@200				rts							;>>>--- oscsi_setup --->>>							ENDP					EJECT					EXPORT	oscsi_data_outoscsi_data_out		PROC*********************************************************************************	Old scsi card data out phase********************************************************************************;;					lda		|more_dci			;check for more DCI instructions					beq		exit					jsr		getnxtdci			;next data chain instruction (buffer & count returned)					bcs		exit				;no more DCI instructions					jsr		osend_bytes			;go write bytes;;	update the transfer count;					ldy		#plst_reqxfr_cnt					clc					lda		<xfer_count			;update the transfered byte count					adc		[plist_ptr],y					sta		[plist_ptr],y					ldy		#plst_reqxfr_cnt+2					lda		<xfer_count+2					adc		[plist_ptr],y					sta		[plist_ptr],y;;	check for a phase mismatch;					jsr		bus_status			;get the status of the scsi bus					and		#$0800				;check for phase match					beq		exit				;go away if phase changed					stz		|new_phase			;phase has not changed					bra		oscsi_data_out		;go receive next groupt of bytesexit				rts							;>>>--- oscsi_data_out --->>>;							ENDP									EJECT					EXPORT	oscsi_data_inoscsi_data_in		PROC*********************************************************************************	Old scsi card data in phase********************************************************************************;;;					lda		|more_dci			;check for more DCI instructions					beq		exit					jsr		getnxtdci			;next data chain instruction (buffer & count returned)					bcs		exit				;no more DCI instructions					jsr		orecv_bytes			;go receive bytes;;	update the transfer count;					ldy		#plst_reqxfr_cnt					clc					lda		<xfer_count			;update the transfered byte count					adc		[plist_ptr],y					sta		[plist_ptr],y					ldy		#plst_reqxfr_cnt+2					lda		<xfer_count+2					adc		[plist_ptr],y					sta		[plist_ptr],y;;	check for a phase mismatch;					jsr		bus_status			;get the status of the scsi bus					and		#$0800				;check for phase match					beq		exit				;go away if phase changed					stz		|new_phase			;phase has not changed					bra		oscsi_data_in		;go receive next groupt of bytesexit				rts							;>>>--- oscsi_data_in --->>>;					ENDP									EJECT					EXPORT	oscsi_statusoscsi_status		PROC*********************************************************************************	This routine will handle the reading of the status byte from the SCSI*	bus.  The I/O of the byte is made in programmed I/O mode.**	ENTRY:	e=0**	Exit:	e,m,x = 0*		scsi_statbyte := call status byte*********************************************************************************;;					longa	on					longi	on;					jsr		orecv_byte					sta		|scsi_status		;save the scsi call status byte					clc							;will always succeed					rts							;>>>--- oscsi_status --->>>;							ENDP;												EJECT					EXPORT	oscsi_msg_inoscsi_msg_in		PROC*********************************************************************************	This routine will handle the reading of the message byte(s) from the SCSI*	bus.  The I/O of the byte is made in programmed I/O mode.**	ENTRY:	e=0**	Exit:	e,m,x = 0*		scsi_message := call message byte*********************************************************************************;;;					longa	on					longi	on					rep		#$30				;m=0, x=0;					sep		#$20				;m=1					ldx		<io_offset			;point to DEV-SEL space for specific slot					lda		>currdata,x			;read a msg byte (may be extended msg)					rep		#$20				;m=0					and		#$00FF				;low byte					sta		|scsi_message		;save it					jsr		validate_msg		;go see if valid (range check it)					bcc		msginok;;	message is invalid REJECT it (bad message in);obadmin				lda		#rEJECT_msg			;rEJECT message					sta		|msg_out_byte		;for data out phase					lda		#atn				;force target to msg_out phase					jsr		set_icmd					jsr		set_ack_true		;assert ACK					jsr		wait_req_false		;wait for target to remove REQ					jsr		set_ack_false		;remove ACK					bra		exit				;go away (next phase should be MSG out phase);;	message byte was within range;	use msg # as index and call message service routine;msginok				jsr		set_ack_true		;assert ACK					jsr		wait_req_false		;wait for target to remove REQ					jsr		set_ack_false		;remove ACK					lda		|scsi_message					cmp		#identify_msg					bne		@100;;	identify message from target convert to restore pointers;					lda		#rest_data_ptr					sta		|scsi_message;;	form table index and call message service routine;@100				asl		A					;index into table := msg # * 4					asl		A					tax					jsr		(|omsgin_tbl,x)		;call service routineexit				rep		#$30				;m=0,x=0					rts							;>>>--- oscsi_status --->>>;		;									EJECT*********************************************************************************	Old scsi card Message out phase********************************************************************************;;					EXPORT	oscsi_msg_outoscsi_msg_out		lda		|msg_out_byte		;check if trying to send identify msg					jsr		|validate_msg		;range check the message					bcc		@100				;invalid message number					brl		obadmout@100				lda		|msg_out_byte		;valid check for identify					cmp		#identify_msg					beq		moident					asl		A					;address table index := msg# * 4					asl		A					tax					jsr		(omsgout_tbl,x)		;call message service routine					bra		exit;;	IDENTIFY message out;moident				ora		<logunit			;include the logical unit (no reselect);;	single byte message out routine;					longa	off					longi	onsingmout			sep		#$20				;m=1					rep		#$10				;x=0					ldx		<io_offset			;point to proper io location					xba							;save the message byte					lda		>modereg,x			;use programmed I/O mode					pha							;save mode register					and		#$FD					sta		>modereg,x					lda		#attention			;deassert attention					jsr		res_icmd					xba					sta     >currdata,x   		;write out the byte					lda		#01					;assert the data bus					ora		>initcmdreg,x					sta		>initcmdreg,x					jsr     set_ack_true		;assert the ACK* line					jsr     wait_req_false		;wait for REQ* to go false					jsr     set_ack_false		;negate ACK*    				lda		#01					;turn off the data bus					eor		>initcmdreg,x					sta		>initcmdreg,x					pla							;restore mode register					sta		>modereg,x					longa	on					longi	on					rep		#$30				;m,x = 0					rts;sndmbyte			lda		|msg_out_byte					bra		singmout;;					EJECT*********************************************************************************	address table for message service routines*	each ENTRY has following format**	table ENTRY*	(msg_number)	msg_in_address	 msg_out_address*			+--------------+-----------------+*	     N		|   L   |   H  |   L    |    H   |*			+--------------+-----------------+*******************************************************************************;;omsgin_tbl			dc.w	ocmd_complete		;old scsi command complete msg inomsgout_tbl			dc.w	obadmout			;handler for cmd complete msg out					dc.w	obadmin,obadmout	;extended message					dc.w	obadmin,obadmout	;save data pointers					dc.w	obadmin,obadmout	;restore data pointers					dc.w	obadmin,obadmout	;disconnect (old card can not!)					dc.w	obadmin,obadmout	;initiator detected error					dc.w	obadmin,abortmout	;abort message					dc.w	rEJECTmi,obadmout	;rEJECT message					dc.w	obadmin,obadmout	;nop					dc.w	obadmin,obadmout	;message parity error					dc.w	obadmin,obadmout	;linked command complete					dc.w	obadmin,obadmout	;linked command complete with flag					dc.w	obadmin,obadmout	;autosense data follows;;		MESSAGE Handlers;;---------------------------------------;	command complete message;---------------------------------------;;					longa	on					longi	on;ocmd_complete		lda		#$FFFF				;reset current phase value					sta		|current_phase					stz		|more_phases					rts							;we are done!;;	REJECT message in;rEJECTmi			lda		|msg_out_byte		;see if we sent an identify message					xba							;check for bit 7 set					bmi		@100				;ignore the identify;;	message in state machine  goes here;@100				brl		exit				;go away (next phase should be MSG out phase);;	ABORT message out;abortmout			lda		#abort_msg			;send an abort message to the target					jsr		singmout			;send the message byte					stz		|more_phases		;clean up and quit					jsr		cleanup_sdr					brl		exit;;	bad message handler (message out phase);obadmout			lda		#bad_msg_err		;report a bad message error					sta		|error_stat					sec					brl		exit;							ENDP					EJECT					EXPORT	ocopyzcodeocopyzcode			PROC*********************************************************************************	This module copies some high speed routines into zero page space reserved*	for low level I/O fast access routines.  These routines are specific to*	the OLD scsi card.**	ENTRY:	e,m,x=0*		X= byte count to copy**	Exit:	X = trashed*********************************************************************************;					import	oscsibytesize;					ldx		#oscsibytesize@100				lda		|oscsibyteio,x		;copy words at a time					sta		<zeropg_code,x					dex					dex					bpl		@100					rts							;>>>--- ocopyzcode --->>>						ENDP						EJECT					EXPORT	osend_cmdosend_cmd			PROC********************************************************************		This routine will send a scsi command to a*               previously selected device.  The command pointer*               address must be provided in cmd_ptr.**               Note: This call assumes that the target device*               has been selected and has the BSY*, C/D* and REQ**               lines asserted (target waiting for command from*               initiator.**                ENTRY: e,m,x=0*			(cmd_ptr:long word) = address of scsi command*			(cmd_size:long word) = number of bytes in command**                Exit:  e,m,x=0******************************************************************;;					longa	on					longi	on							lda		#atn				;remove ATN if asserted					jsr		res_icmd					lda		#max_cmd_size		;assume command is 12 bytes					sta		<byte_ctr			;if not max phase change pulls us out					stz		<byte_ctr+2			;clear high word of byte count					lda		<scsicptr			;setup pointer for send bytes					sta		<buffer_ptr					lda		<scsicptr+2					sta		<buffer_ptr+2					jsr		osend_bytes			;send the command on the scsi bus					rts							;>>>--- osend_cmd --->>>					ENDP									EJECT					EXPORT	osend_bytesosend_bytes			PROC******************************************************************	This routine will setup the low level byte transfer*	routine to send data from the initiator to a target.*	It also calls low_ptrs_init to setup the byte counters*	and pointer addresses**	ENTRY	e,m,x=0**	Exit:	e,m,x=0******************************************************************;					import	patch_addr1;					longa	on					longi	on;					lda		|new_phase			;check new phase flag for phase change					beq		nextbuf				;dont reinit if same phase as last time					lda		|sndstub			;small piece of code to zero page					sta		<patch_addr1;					LDA		[buffer_ptr],y					lda		|sndstub+2					sta		<patch_addr1+2					lda		|sndstub+3					sta		<patch_addr1+3					jsr		oinit_5380			;enable pseudo-DMA mode;;	turn on the scsi data bus and kick start the DMA PROCess;					longa	off					sep		#$20				;m=1					lda		#$01					sta		>initcmdreg,x					sta		>dmasndreg,x		;enable pseudo dma send mode					longa	on					rep		#$20				;m=0;;	save the requested byte count;nextbuf				lda		<byte_ctr					sta		<req_count					lda		<byte_ctr+2					sta		<req_count+2					jsr		low_ptrs_init		;2's complement byte count & pointer					phb							;save current data bank, it will be changed					jsl		callzpg				;call routine in zero page;;	save the transfered byte count;@100				php							;save carry bit					clc					tya					adc		<req_count					sta		<xfer_count					lda		<byte_ctr+2					adc		<req_count+2					sta		<xfer_count+2					plp							;restore carry bit;;	check for more data chaining instructions;					plbexitsnd				rts							;>>>--- osend_bytes --->>>;sndstub				lda		[buffer_ptr],y		;send code stub					sta		|opdmadatareg,x		;							ENDP					EJECT					EXPORT	orecv_bytesorecv_bytes			PROC******************************************************************	This routine will setup the low level byte transfer*	routine to receive data from a target into an intiatiator.*	It copies a short code stub into zero page to adjust the*	byte transfer direction.**	ENTRY	e,m,x=0**	Exit:	e,m,x=0******************************************************************;					import	patch_addr1;;	download the receive byte stub into zero page;					lda		|new_phase			;check of new or same phase as last time					beq		nextbuf					lda		|rcvstub			;small piece of code to zero page					sta		<patch_addr1;					LDa		|indatareg,x					lda		|rcvstub+2;					STa		[buffer_ptr],y					sta		<patch_addr1+2					lda		|rcvstub+3					sta		<patch_addr1+3;;	initialize the 5380 controller;					jsr		oinit_5380			;enable pseudo-DMA mode (old scsi card)					longa	off					sep		#$20				;m=1					sta		>idmarecv,x			;enable pseudo dma receive mode					longa	on					rep		#$20				;m=0;;	save the requested byte count;nextbuf				lda		<byte_ctr					sta		<req_count					lda		<byte_ctr+2					sta		<req_count+2;					jsr		low_ptrs_init		;adjust byte count and pointer					phb							;save current data bank, it will be changed					jsl		callzpg				;call routine in zero page;;	save the transfered byte count;@100				php							;save carry bit					clc					tya					adc		<req_count					sta		<xfer_count					lda		<byte_ctr+2					adc		<req_count+2					sta		<xfer_count+2					plp							;restore carry bit					plb							;restore data bankexitrcv				rts							;>>>--- orecv_bytes --->>>;rcvstub				lda		|opdmadatareg,x		;recv code stub					sta		[buffer_ptr],y					ENDP;					EJECT					EXPORT	osend_byteosend_byte  	    PROC******************************************************************osend_byte:     This routine will send a byte contained in the*                A accumulator to a device on the scsi bus.  The*		 byte is sent in Programmed I/O mode.  The*                routine assumes that all the required work to*                to send bytes on the bus has been proviously done.*                The routine writes the byte out to the scsi bus*                asserts ACK*, waits for the target to deassert REQ**                and then deasserts the ACK*.**                ENTRY: e=0,m=1*                       B=byte to send*                       X=5380 register offset**                Exit: same as ENTRY******************************************************************;					longa	off					longi	on;;					php							;save m,x					sep		#$20				;m=1					rep		#$10				;x=0					ldx		<io_offset			;point to proper io location					xba							;save the data byte					lda		>modereg,x			;use programmed I/O mode					pha							;save mode register					and		#$FD					sta		>modereg,x					jsr		wait_req_true		;wait for request true					xba					sta     >outdatareg,x		;write out the byte					jsr     set_ack_true		;assert the ACK* line					jsr     wait_req_false		;wait for REQ* to go false					jsr     set_ack_false		;negate ACK*					pla							;restore mode register					sta		>modereg,x					plp							;restore m,x					rts							;>>>--- osend_byte --->>>;					ENDP					EJECT					EXPORT	orecv_byteorecv_byte			PROC*********************************************************************************	This routine will read ONE byte from the NCR 5380 in programmed I/O mode.*	The routine assumes that the phases are in a input phase where data is*	being received by the initiator.**	ENTRY:	e=0*		io_offset = C0NX address space for NCR 5380**	Exit	e,m,x = 0*		A = $00XX (byte read from the 5380)*********************************************************************************;;					longa	off					longi	on;					php							;save m,x					sep		#$20				;m=1					rep		#$10				;x=0					ldx		<io_offset			;point to proper io location					lda		>currdata,x			;get the byte					xba							;save it away					jsr     set_ack_true	    ;assert the ACK* line					jsr     wait_req_false		;wait for REQ* to go false					jsr     set_ack_false		;negate ACK*;					longa	on					rep		#$20				;m=0					xba							;restore the byte					and		#$00FF				;keep low byte only					plp							;restore m,x					rts							;>>>--- orecv_byte --->>>;					ENDP;					EJECT					EXPORT callzpgcallzpg				PROC******************************************************************	This routine will pass control to location $0080 of the*	SCSI Manager zero page. It assumes there is valid code to*	run at that location. This routine MUST be called through*	a JSL instruction because the code in zero page will return*	through an RTL instructinon.**	ENTRY: e=0,m=0,x=0**	Exit:	e,m,x=0*		registers trashed******************************************************************;					longa	on					longi	on;					pea		$0000				;force bank $00 for code bank and data bank					plb							;flush one word off the stack					tdc					clc					adc		#zeropg_code					dec		A					pha					rtl							;call routine in zero page					EJECToscsibyteio			PROC					ENDP******************************************************************oscsibyteio	This routine will send or receive a number of bytes*		to or from a scsi i/o port.  This call assumes*		that the scsi port is in a appropriate phase to*		send or receive bytes  Depending on whether bytes*		are being sent or received a low level routine in*		SCSI Manager zero page will be modified to send or*		receive bytes.  Note: The routine is optimized for*		fast transfers. It assumes that once a byte is found*		bytes will come in faster than we can check for them*		The second check for a byte should only occur if we*		are talking to slow scsi devices.**                ENTRY:	e,m,x=0*			X = $C0NX*			sndbptr	= pointer to buffer to send*			sndbcnt	= byte count to send**                Exit: 	e,m,x = 0*			sndbcnt = $00000000******************************************************************ozeropgcode			PROC;;					longa	off					longi	on					sep		#$20				;m=1					rep		#$10				;x=0@100				bit		|busstat,x			;check for DRQ					bvs		patch1					lda		#phasematch			;check for a phase mismatch					bit		|busstat,x					bne		@100				;keep going until count expires or phase change					bra		patch1statloop			bit		|busstat,x			;check for DRQ					bvc		nextcheckbumpcount			iny							;bump count/buffer index					beq		uppercheckpatch1				lda		[buffer_ptr],y		;transfer a byte					sta		|opdmadatareg,xnextcheck			bit		|busstat,x			;check for DRQ                                                                                                                                                                                                                                                                                                                                                                                                                                                                                					bvs		bumpcount			;go transfer another byte					lda		#phasematch			;check for a phase mismatch					bit		|busstat,x					bne		statloop			;keep going until count expires or phase change					sep		#$40				;mark phase changed status					iny							;adjust the transfered byte count for humans					bne		exit_byteio					rep		#$20				;m=0					inc		<buffer_ptr+2		;bump the high word of the buffer					inc		<byte_ctr+2			;bump the high word of the byte count					bra		exit_byteio			;phase changed go away;uppercheck			rep		#$20				;m=0					inc		<buffer_ptr+2		;bump high word of buffer address					inc		<byte_ctr+2			;bump high word of byte count					sep		#$20				;m=1					bne		patch1				;keep going until zero;;	exit byte I/O routine;					longa	on					longi	onexit_byteio			rep		#$30				;m=0,x=0exit1				clc					rtl							;>>>--- oscsibyteio --->>>;;size				equ		*-ozeropgcode;					IF		 size	AND	$00000001	then	;check if odd byte count					nop							;odd byte count insert NOP					ENDIF					EXPORT	oscsibytesize:equoscsibytesize		equ		*-ozeropgcode		;number of bytes in routine						EXPORT	patch_addr1:equpatch_addr1			equ		patch1-ozeropgcode\							+zeropg_code;					ENDP									EJECT					EXPORT	low_ptrs_initlow_ptrs_init	PROC********************************************************************************* low_ptrs_init	This routine will setup source/dest and byte counters to optimize*		for data transfers.  The byte count is made 2's complement*		so it can double as byte counter and buffer index.  The buffer*		address will be modified to compensate for the change in the byte*		counter.  The routine sets things up to optimize the data transfers*		from the hardware into buffers and viceversa.  Transfers of very few*		bytes (5-20 bytes) will suffer some degradation but transfers of blocks will*		receive a major performance improvement.**		ENTRY:	e,m,x=0*			buffer_ptr*			byte_ctr***		Exit:	e,m,x = 0*			buffer_ptr trashed*			byte_ctr trashed*********************************************************************************;;							longa	on					longi	on					rep		#$30				;m,x=0							sec							;2's complement low word of byte count					lda		#$0000				;to make counter incrementing and can					sbc		<byte_ctr			;double as source/destination pointer					tay							;save modified counter					php							;save 16 bit status (just want carry bit)					php					lda		#$0000					sbc		<byte_ctr+2			;high word of byte count					sta		<byte_ctr+2			;save high word of updated count					clc							;update source pointer to compensate byte count					lda		<buffer_ptr			;becoming 2's complement					adc		<byte_ctr						sta		<buffer_ptr						pla							;restore carry bit					and		#$0001					bne		@100				;if carry set don't subtract					lda		<buffer_ptr+2		;include possible borrow					sbc		#$0000							sta		<buffer_ptr+2@100				sty		<byte_ctr			;Y contains low word of byte count					rts							;>>>--- low_ptrs_setup --->>>					ENDP					EJECT					EXPORT	ophase_handlerophase_handler		PROC*********************************************************************************	This routine will wait for a target device to go into its phasing*	and then will pass control to different scsi phasing routines until a*	Message Complete is received from the target device.**	ENTRY	e,m,x=0**	Exit	e,m,x=0*********************************************************************************;;;					longa	on					longi	on;					ldx		#$FFFF					stx		|more_phases		;initialize phase handler trigger;;	check more_phases flag each loop through the phase handler;@100				lda		|more_phases		;we remain here until legitimate bus free					beq		exit					ldx		<io_offset			;point to specific i/o space@200				lda		>curbusstat,x					and		#bsy++sel			;look for unexpected bus free					beq		errexit;;	not bus free go check which phase;@250				cmp		#bsy				;bsy and/or sel set check which					bne		@100				;if sel* asserted  then check again;;	toggle DMA mode to reset the phase mismatch and allow REQ to come through;					longa	off					sep		#$20				;m=1					lda		>modereg,x					and		#dmaenable--\							$FF					sta		>modereg,x					ora		#dmaenable					sta		>modereg,x;;	check for REQ to go asserted;					longa	on					rep		#$20					lda		>curbusstat,x		;get target command register					and		#req					beq		@100;;	vector to new phase;					lda		>curbusstat,x					lsr		A					lsr		A					and		#$0007				;keep phase bits;;	match the phase bits in target command register;					sep		#$20				;m=1					sta		>targcmdreg,x                                                                                                                       	;match the phase bits					rep		#$20				;m=0;;	save the phase information for later comparison when multiple data;	chain instructions are called.;					stz		|new_phase			;assume not a new phase					cmp		|current_phase		;same phase as last time??					beq		@125				;set new phase  flag if different					sta		|current_phase		;save the phase value					dec		|new_phase@125				clc					adc		#phase_offset/2		;offset into phasing routines in addr table							jsr		callrtn				;go to the phasing routines for this interface					bra		@100				;go check for more phases;;	if bus free when it should not have been report an error;errexit				lda		#bus_free_err					sta		|error_stat					stz		|more_phases					secexit				jsr		ozap_5380			;clean up the 5380 registers					rts							;>>>--- ophase_handler --->>>					ENDP;;					EJECT					EXPORT	oinit_5380oinit_5380			PROC**********************************************************************************	This routine will initialize the NCR 5380 chip on an old scsi card*	implementation.  Also, it enables pseudo-DMA mode on the 5380 and on the*	SCSI card.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0**********************************************************************************;					php					longa	off					longi	on					sep		#$20				;m=1					rep		#$10				;x=0;					phx					ldx		<io_offset					lda		#dmaenable			;enable DMA on the 5380					ora		>modereg,x			;in the mode register					and		#$7F				;mask off block mode dma					sta		>modereg,x					lda		#$00					sta		>opdmareg,x			;enable pseudo DMA xfers old card					plx					plp							;restore m,x					rts							;>>>--- onit_5380 --->>>;					ENDP;					EJECT					EXPORT	ozap_5380ozap_5380			PROC**********************************************************************************	This routine will initialize the NCR 5380 registers on the old scsi card*	to a known state.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0**********************************************************************************;					php					longa	off					longi	on					sep		#$20				;m=1					rep		#$10				;x=0;					phx					ldx		<io_offset					lda		#$0000				;write zeros to registers					sta		>initcmdreg,x		;initiator command register					sta		>modereg,x					sta		>targcmdreg,x		;target command register					plx					plp							;restore m,x					rts							;>>>--- onit_5380 --->>>;					ENDP;					EJECT					EXPORT	opdmaoffopdmaoff			PROC**********************************************************************************	This routine will turn of DMA mode in the 5380 and check to see if the*	target phase bits changed to a new phase.**	ENTRY:	e,m,x = 0*		X=Dev-sel registers offset**	Exit:	e,m,x = 0*		C=1 if phase changed**********************************************************************************;;					longa	off					longi	on					sep		#$20				;m=1;					lda		#dmaenable--$FF		;read 5380 mode register					and		>modereg,x			;clear dma enable bit					sta		>modereg,xexit				rep		#$20				;m=0					rts							;>>>--- opdmaoff --->>>;					ENDP;					EJECT					EXPORT	obad_phaseobad_phase			PROC***********************************************************************************	This routine will set the error code inv_phase_err in error_stat, sets*	the carry bit and exits.**	ENTRY: e=0**	Exit:	e=0, m,x = same as ENTRY*		C=1*		error_stat := inv_phase_err**********************************************************************************;;					php					longa	on					rep		#$20				;m=0;					lda		#inv_phase_err		;mark phase bits error					sta		|error_stat					sec					rts							;>>>--- exit bad_phase --->>>;					ENDP					EJECT					EXPORT	tuplisttuplist				PROC*********************************************************************************	This module contains a canned packet for test unit ready call********************************************************************************;					EXPORT	tulunit					EXPORT	tu_slot;tu_slot				dc.w	$0000				;slot number					dc.w	$0000				;id field					dc.w	$0000				;parameter list version					dc.w	$0000				;flags					dc.w	$0008				;give call 2 seconds to complete					dc.l	$00000000			;completion vector					dc.l	tuscmd				;pointer to scsi test unit ready command packet					dc.l	$00000000			;no byte count returned					dc.l	$00000000			;message buffer pointer					dc.l	$00000000			;reserved;;					EXPORT	tulunittuscmd				dc.b	$00					;command number $00 (test unit ready)tulunit				dc.b	$00					;no data coming back (also scsi command packet)					dc.l	$00000000			;4 bytes of zero;					ENDP;;					EXPORT	inq_plistinq_plist			PROC*********************************************************************************	This module contains the parameter list for the Inquiry call made to*	interrogate devices on the scsi bus when building the SDRs.********************************************************************************;					EXPORT	inq_slot					EXPORT	inq_lunit;inq_slot			dc.w	$0000				;low  word of 32 bit device ID field					dc.w	$0000				;id = $0000					dc.w	$0000				;parameter list version					dc.w	$0000				;flags					dc.w	$0004				;give the call 1 sec to complete (4*250 millisec)					dc.l	$00000000			;completion vector (no completion vector)					dc.l	inqcmd				;scsi command pointer					dc.l	dcstruc				;data chaining instructions					dc.l	$00000008			;request 8 bytes					dc.l	$00000000			;message buffer pointer  (zero = throw data on floor)					dc.l	$00000000			;reserved;inqcmd				dc.b	$12					;inquiry commandinq_lunit			dc.b	$00					;b7-b5 = Logical unit, b4-b0 = reserved					dc.b	$00					;reserved					dc.b	$00					;reserved					dc.b	$FF					;255 bytes of data requested					dc.b	$00					;Vendor unique & flag & link bits;dcstruc				dc.l	inq_buff			;inquiry buffer address					dc.l	inqbsize			;byte count to request					dc.l	$00000000			;number to add to buffer address					dc.l	$00000000			;save inquiry pointer area (must be set to zero);					ENDP					EXPORT	sense_plistsense_plist			PROC*********************************************************************************	This module contains the parameter list for the Inquiry call made to*	interrogate devices on the scsi bus when building the SDRs.********************************************************************************;					EXPORT	sense_slot					EXPORT	senseid					EXPORT	sense_lunit;sense_slot			dc.w	$0000				;low  word of 32 bit device ID fieldsenseid				dc.w	$0000				;id = $0000					dc.w	$0000				;parameter list version					dc.w	$0000				;flags					dc.w	$0010				;give the call 16 secs to complete					dc.l	$00000000			;completion vector					dc.l	sense_cmd			;scsi command pointer					dc.l	sensebstruc			;data chaining instructions for request sense					dc.l	$00000004			;request 256 bytes					dc.l	$00000000			;autosense buffer pointer (not available)					dc.l	$00000000			;message buffer pointer  (zero = throw data on floor)					dc.l	$00000000			;reserved;					EXPORT	sense_lunit					EXPORT	sensebstruc					EXPORT	sensecnt0					EXPORT	sensecnt1					EXPORT	sense_buff					EXPORT	inq_buff;sense_cmd			dc.b	$03					;request Sensesense_lunit			dc.b	$00					;b7-b5 = Logical unit, b4-b0 = reserved					dc.b	$00					;reserved					dc.b	$00					;reservedsensecnt0			dc.b	$00					;forces 4 bytes of request sense data					dc.b	$00					;Control byte;sensebstruc			dc.l	sense_buff			;sense buffersensecnt1			dc.l	$00000000			;sense byte count requested (filled by manager)					dc.l	$00000000			;number to add to buffer address					dc.l	$00000000			;save inquiry pointer area (must be set to zero);sense_buff			ds.b	$04					;260 byte buffer for request sense & inq calls;inq_buff			ds.b	$100				;256 byte inquiry buffer					ENDP;;					EJECT;					EXPORT	arbitrate_phasearbitrate_phase		PROC****************************************************************** Arbitrate:    This module will arbitrate for the SCSI bus*       The contents of the accumulator contain the ID*       of the Initiator.  This routine will wait until*       the arbitration succeds.**       ENTRY:    (initiator_id) = SCSI ID of device wanting bus*                 (io_offset) = Register offset (slot #*$10+$80)**       Exit:     e,m,x = 0*		C = 0 if successful arbitration*		C = 1 if arbitration failed*		  Error_stat := arbitration phase error ($FE15)******************************************************************;;					longa	on					longi	on					rep		#$30				;m=0,x=0					phd							;save direct register					lda		<io_offset			;i/o register offset					tcd;;	start the arbitration timeout heartbeat task;					lda		#arbtcount			;arbitrate timeout count (approx. 2 secs)					sta		|arbtick_count;					longa	off					sep		#$20				;m=1					lda		|init_priority		;get priority of our initiator					stz		<targcmdreg			;clear the phase bits					sta		<outdatareg			;write Initiator ID;;	check the arbitration timeout count field for zero;@10					lda		|arbtick_count					ora		|arbtick_count+1					beq		arbitrate_tout		;if nonzero check again later					stz		<modereg			;reset arbitrate bit					lda		#<arbitrate			;then set arbitrate bit					sta		<modereg					bit		<initcmdreg			;wait for bus free					bvc		@10					nop							;wait 2.2+ usec					nop					nop					nop					nop					lda		#<arbitlost			;check for loss of arbitration					and		<initcmdreg					bne		@10					lda		<currdata			;otherwise reset arbitrate bit &					eor		|init_priority		;check for higher priority on bus					beq		@30					;nobody else wants the bus					cmp		|init_priority		;otherwise try again					bcs		@10@30					lda		#<arbitlost			;check for arbitrate loss					and		<initcmdreg			;if not lost we win					bne		@10					;otherwise go try again					lda		#select++atn		;assert select with attention					jsr		set_icmd_bits					clc							;mark successarbit_exit			pld							;restore direct register					longa	on					longi	on					rep		#$30				;m,x=1					stz		|arbtick_count		;clear the timeout count					rts							;>>>--- arbitrate_phase --->>>;;	arbitration timeout;					longa	onarbitrate_tout		rep		#$20				;m=0					lda		#arbit_phase_err					sta		|error_stat					sec					bra		arbit_exit;;	Arbitration timeout heartbeat service routine;					EXPORT	arbtout_header;arbtout_header		dc.l	$00000000			;room for link pointerarbtick_count		dc.w	$0000				;tick count before irq					dc.w	$A55A				;manual is wrong A55A signature correct;;	count field in the header is the flag for timout;					rtl							;the count field in heartbeat task header												;= $0000 marks timeout.;					ENDP					EJECT					EXPORT	Select_phaseSelect_phase		PROC****************************************************************** Select_Phase: This routine will select a particular*       SCSI target device.  The routine*       assumes that the routine Arbitration_phase*       has been called previously and succeeded*       in gaining control of the SCSI bus.**       ENTRY: e=0*              (initiator_id) = scsi device who has scsi bus*              (target_id) = scsi ID of target we want**       Exit: same as ENTRY*****************************************************************;;					php							;save m,x					longa	on					longi	on					rep		#$30				;m=0,x=0					phd							;save direct register					lda		<io_offset			;get slot offset for 5380 registers					tcd			;					longa	off					sep		#$20				;m=1					stz		<selectereg			;clear the reselect ID register					lda		|init_priority		;post our ID and targets ID on bus					ora		|target_priority					sta		<outdatareg					lda		#identify_msg		;we want to send an identify message					sta		|msg_out_byte					lda		#<databuson			;assert our ID & target ID on bus					jsr		set_icmd_bits					lda		#<arbitrate			;reset arbitrate bit					trb		<modereg					lda		#<busy				;reset BSY*					jsr		res_icmd_bits					jsr		chk_sel_tout		;wait for target to assert BSY*					bcc		remove_sel			;bus select success or failselect_fail			jsr		sel_abort_wait		;wait select abort time & check BSY*remove_sel			lda		#<select			;on success or fail clear SEL* line					jsr		res_icmd_bits		;INITIATOR now has control of target					longa	on					rep		#$20				;m=0					bcc		select_ok			;go away if all ok					lda		#atn				;remove atn & turn off bus on select fail					jsr		res_icmd_bits					lda		#databuson					jsr		res_icmd_bits					lda		#sel_phase_err		;mark select phase error					sta		|error_stat			;and let SCSI bus go free					pld							;restore direct register					plp							;restore m,x & mark error					sec							;mark an error					bcs		select_exit			;go away with errorselect_ok			lda		#databuson			;turn off the data bus					jsr		res_icmd_bits					pld							;restore direct register					stz		|error_stat			;mark select ok					plp							;restore m,x					clc							;mark successselect_exit			rts							;>>>--- select_phase --->>>;					ENDP					EJECT					EXPORT	res_icmd_bitsres_icmd_bits		PROC******************************************************************Res_Icmd_bits: This routine will reset a specified number of*       bits in the SCSI Initiator command register. The*       bit positions to be reset must be set in the*       A register.**       ENTRY:    e=0,m=0*                 io_offset = index into I/O dev-sel space*       Exit:     same as ENTRY******************************************************************;;					php							;save m,x					longa	off					sep		#$20				;m=1					pha							;save bits to reset					ora		<initcmdreg			;include other bits in register					eor		1,s					;now reset desired bits					and		#<%10011111			;mask test mode & different. enable					sta		<initcmdreg			;write out new initiator cmd. reg.					pla							;clean up the stack					plp							;restore m,x					rts							;>>>--- res_icmd_bits --->>>;					ENDP					EJECT					EXPORT	set_icmdset_icmd			PROC******************************************************************set_icmd: This routine will set specified bits in the*       SCSI initiator command register and mask off the*       test mode bit and the Differential mode enable*       bit.**       ENTRY:    e=0*                 A=bits        to set*            	  X = $C0XX (points to dev-sel space for card selected)**       Exit:     e=0*                 X=same        as ENTRY*                 A=trashed******************************************************************;;					php							;save m,x					longa	off					sep		#$20				;m=1					ora		>initcmdreg,x		;include other bits of register					and		#<%10011111			;mask off test & differential					sta		>initcmdreg,x		;write out modified register					plp							;restore m,x					rts							;>>>--- set_icmd_bits --->>>;					ENDP;					EJECT					EXPORT	res_icmdres_icmd			PROC******************************************************************Res_Icmd: This routine will reset a specified number of*       bits in the SCSI Initiator command register. The*       bit positions to be reset must be set in the*       A register.**       ENTRY:    e=0,m=0*                 X = C0NX address*       Exit:     same as ENTRY******************************************************************;;					php							;save m,x					longa	off					sep		#$20				;m=1					pha							;save bits to reset					ora		>initcmdreg,x		;include other bits in register					eor		1,s					;now reset desired bits					and		#<%10011111			;mask test mode & different. enable					sta		>initcmdreg,x		;write out new initiator cmd. reg.					pla							;clean up the stack					plp							;restore m,x					rts							;>>>--- res_icmd_bits --->>>;					ENDP					EJECT					EXPORT	set_icmd_bitsset_icmd_bits		PROC******************************************************************set_icmd_bits: This routine will set specified bits in the*       SCSI initiator command register and mask off the*       test mode bit and the Differential mode enable*       bit.**       ENTRY:    e=0,m=0*                 A=bits        to set*            	  D = $C0XX (points to dev-sel space for card selected)**       Exit:     e=0,m=1*                 X=same        as ENTRY*                 A=trashed******************************************************************;;					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset					ora		<initcmdreg			;include other bits of register					and		#<%10011111			;mask off test & differential					sta		<initcmdreg			;write out modified register					plp							;restore m,x					rts							;>>>--- set_icmd_bits --->>>;					ENDP;;					EXPORT	oscsi_dma_enaboscsi_dma_enab		PROC******************************************************************dma_enable:    This module will set DMA mode in the NCR 5380*       	and dma mode in the Sandwich chip.  If carry is*       	set then Pseudo-DMA will be enabled in the*       	sandwich chip.**       ENTRY: e=0,m=0,x=0*              Carry = 0        set true DMA in sandwich*              Carry = 1        set Pseudo DMA in sandwich*            	  D = $C0XX (points to dev-sel space for card selected)**       Exit: e=0,m=1*             A=trashed******************************************************************;					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset			;point to dev-sel space					lda		#<dmaenable			;turn on dma mode in 5380					ora		>modereg,x					sta		>modereg,x					plp							;restore m,x					rts							;>>>--- oscsi_dma_enab --->>>;					ENDP									EXPORT	oscsi_dma_disaboscsi_dma_disab		PROC******************************************************************oscsi_dma_disab:	This routine will disable ANY dma modes which*       		may be set.**       ENTRY: e=0,m=0*              io_offset = I/O space index**       Exit: same as ENTRY******************************************************************;					php							;save m,x					longa	off					sep		#$20				;m=1;					ldx		<io_offset			;index for I/O registers					lda		>modereg,x			;read the mode register					and		#<%11111101			;disable DMA in 5380					sta		>modereg,x					plp							;restore m,x					rts							;>>>--- dma_disable --->>>;					ENDP					EJECT******************************************************************set_ack:       This routines will set the ACK* line true or false.**       ENTRY: e=0,m=0*              io_offset = I/O space index*              carry = 1        set ACK* true*              carry = 0        set ACK* false**       Exit: A= trashed******************************************************************;					EXPORT	set_ack_trueset_ack_true		PROC					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset			;I/O address offset					lda		#<asrtack					ora		>initcmdreg,x		;initiator command register					and		#<%10011111			;mask off test mode & differential					sta		>initcmdreg,x		;write modified register					plp							;restore m,x					rts							;>>>--- wait_req_true --->>>set_ack_false		PROC 					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset			;I/O address offset					lda		>initcmdreg,x		;get initiator cmd register					and		#<%10001111			;mask off tst mode,diff. mode, ACK*					sta		>initcmdreg,x		;write out modified register					plp							;restore m,x					rts							;>>>--- set_ack_false --->>>;					ENDP					EJECT******************************************************************wait_req       This routines will wait for REQ* to go true or*       	false.**       ENTRY: e=0,m=0**       Exit: A= trashed******************************************************************;					EXPORT	wait_req_truewait_req_true		PROC					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset@100				lda		#<req					and		>curbusstat,x		;get current scsi bus status					beq		@100				;and wait until REQ* is true					plp					rts							;>>>--- wait_req_true --->>>;wait_req_false		PROC     					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset@100				lda		#<req					and		>curbusstat,x		;get current scsi bus status					bne		@100				;and wait until REQ* is false					plp							;restore m,x					rts							;>>>--- wait_req_true --->>>;;					ENDP									EJECT					EXPORT	wait_drq_truewait_drq_true		PROC******************************************************************wait_drq_true: This routine will wait for DRQ (DMA request) to*       	go true or false depending on the setting of the*       	carry bit.**       ENTRY: e=0,m=0*            	io_offset = I/O space index*              carry = 1        wait for DRQ* to        be asserted*              carry = 0        wait for REQ* to        be deasserted**       Exit: A= trashed******************************************************************;					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset					lda		#<drq					and		>busstat,x			;get DMA request status					beq		wait_drq_true		;and wait until REQ* is true					plp							;restore m,x		rts			;>>>--- wait_req_true --->>>;					ENDP					EXPORT	slow_downslow_down	PROC******************************************************************slow_down:     This routine will read the setting of the system*       	speed, save it away and then set the system slow.**       ENTRY: e=0,m=0**       Exit: e=0,m=0*             (speed_setting) := old setting of system speed*             CYAREG-b7 := 0 slow******************************************************************;;					php							;save m,x					longa	off					sep		#$20				;m=1					lda		>cyareg				;read current setting					sta		<cyareg_hold		;save it					and		#<%01111111			;b7 = 0 slow down					sta		>cyareg				;write modified register					plp							;restore m,x					rts							;>>>--- slow_down --->>>;					ENDP					EJECT					EXPORT	restore_cyarestore_cya			PROC*****************************************************************restore_cya:   This routine will restore the contents of the*       	cya register to the setting saved away by the*       	slow_down routine in 'cya_hold'.**       ENTRY: e=,m=0*              (cya_hold) := contents to write into cyareg**       Exit: e=0,m=1 cyareg := (cya_hold)******************************************************************;;					php							;save m,x					longa	off					sep		#$20				;m=1					lda		<cyareg_hold		;restore setting of CYA reg					sta		>cyareg					plp							;restore m,x					rts							;>>>--- restore_cya --->>>;					ENDP					EJECT					EXPORT	wait_busywait_busy			PROC******************************************************************Wait_busy:     This routine waits for BSY* to go true before*       	returning to the caller.**       ENTRY: e=0,m=0*            	io_offset = I/O space index**       Exit: same as ENTRY******************************************************************;;					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset@10					lda		>curbusstat,x		;check for busy					and		#<bsy					beq		@10					;and wait until it comes					plp							;restore m,x					rts							;>>>--- wait_busy --->>>;					ENDP					EJECT					EXPORT	message_phasemessage_phase		PROC******************************************************************message.phase: This routine will waits for the message phase*       	and reads in the message byte.**       ENTRY: e=0, m=0*            	io_offset = I/O space index**       Exit: same as ENTRY******************************************************************;					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset					jsr		wait_req_true		;wait for REQ*					lda		>currdata,x			;get message byte from target					pha							;save the status					jsr		set_ack_true		;assert ACK*					jsr		set_ack_false		;reset ACK*					pla							;restore status byte					plp							;restore m,x					rts							;>>>--- status phase --->>>;					ENDP							EJECT					EXPORT	status_phasestatus_phase		PROC******************************************************************status_phase:  This routine will set the REQ*, I/O* & C/D**       	lines to match the status phase signal setup**       ENTRY:	e=0, m=0*            	io_offset = I/O space index**       Exit: same as ENTRY******************************************************************					longa	off;					php							;save m,x					longa	off					sep		#$20				;m=1					ldx		<io_offset					jsr		wait_req_true		;wait for REQ*					lda		>currdata,x			;get SCSI status byte from target					pha							;save the status					jsr		set_ack_true		;assert ACK*					jsr		set_ack_false		;reset ACK*					pla							;restore status byte					plp							;restore m,x					rts							;>>>--- status phase --->>>;					ENDP							EJECT					EXPORT	chkbusfloatchkbusfloat			PROC**********************************************************************************	This routine will attempt to check if the SCSI bus is floating due to*	no peripherals turned on or connected to the current card/port.  SCSI*	peripherals provide termination power.  This check is not 100% effective*	since the bus floating can float signals high or low depending on how*	the hardware feels!!  This routine is intended as a gross check for no*	target or target powered off.**	ENTRY	e,m,x = 0*		None**	Exit:	e,m,x=0*		registers used are saved and restored**********************************************************************************					longa	on					longi	on					phx							;save registers					pha					jsr		bus_status			;read the status of the scsi bus signals					and		#bbsystat\			;mask off unwanted bits except for BSY							+bselstat\			;SEL							+biostat\			;I/O							+bcdstat\			;C/D							+bmsgstat			;MSG					clc							;assume not floating;;	since we did a bus reset ealier the result must ;	be zero or else we assume it is a floating bus.;					beq	fexit;float				sec							;assume floatingfexit				pla							;restore registers					plx					rts							;>>>--- chkbusfloat --->>>							ENDP									EJECT					EXPORT	wait_for_phasewait_for_phase		PROC*********************************************************************************	This routine will wait for a phase specified by the contents of the*	accumulator. If the phase changes to a phase other than the requested*	phase, the V bit will be set and carry will be cleared.  On exit, if the*	phase matches the requested phase then the Target command register bits 0-2*	will be set to match the requested phase.**	ENTRY:	e,m,x=0*		A = phase bit pattern*		+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*		|F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*		+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+* 		 | | | | | | | | | | | | | | | |* 		 | | | | | | | | | | | | | +-+-+------ (MSG,C/D,I/O) Phase bit pattern:* 		 +-+-+-+-+-+-+-+-+-+-+-+-+------------ Reserved**	Exit:	e,m,x = 0*		C = 0,V = 0 if changed to phase requested*		C = 0,V = 1 if phase changed to phase other than requested*		C = 1,V = X if phase lines never changed during the sampling period*		A = phase bit pattern**	Phase bit combinations:*	000 = Data Out*	001 = Data In*	010 = Command*	011 = Status*	100 = Invalid phase (reserved for future scsi standard expansion)*	101 = Invalid phase (reserved for future scsi standard expansion)*	110 = Message Out*	111 = Message IN*********************************************************************************;;					longa	on					longi	on;					and		#$0007				;mask off upper 13 bits					pha							;save phase bits;;	save the current phase setting;					ldx		<io_offset					lda		>curbusstat,x		;get target command register					lsr		A					lsr		A					and		#$0007					sta		|phase_hold;;	clear possible ACK asserted bit;					lda		#asrtack					jsr		res_icmd;;	196608 times retry count for valid phase check;					stz		<scratchzpg			;retry count := count * $10000					lda		#wait_phase_rcnt					sta		<scratchzpg+2;;	check the bus status for the phase we want;@100				sec							;assume timeout					dec		<scratchzpg			;decrement retry count					bne		@150					dec		<scratchzpg+2					beq		error@150				ldx		<io_offset			;point to specific i/o space					lda		>curbusstat,x		;get target command register					and		#$00FF					tax							;save the phase bits					and		#bsy++sel			;look for BSY* asserted and SEL* not asserted					beq		@100					cmp		#bsy				;bsy and/or sel set check which					bne		@100				;if sel* asserted  then check again					txa							;get the status back					lsr		A					;REQ*,I/O*,C/D* to low 3 bits					lsr		A					and		#$0007				;mask off upper 13 bits					cmp		|phase_hold			;check if phase has changed					beq		@100				;wait until match					sep		#$40				;phase changed, assume not the phase we want					cmp		1,s					;check if sought phase					bne		@100				;phase other than requested (go along with it)					rep		#$40				;V=1 & C=0 if phase other than sought					longa	off					sep		#$20				;m=1					ldx		<io_offset			;point back to the dev-sel space for this card					lda		1,s					;set the target command register to match phases					sta		>targcmdreg,x					longa	on					rep		#$20				;m=0@200				clc							;got the phase we wanterror				pla					rts							;>>>--- wait_phase --->>>**********************************************************************************get_phase:*	This routine will read the phase bits and return them in the accumulator*	It will also return the overflow bit set if we are in a bus free phase.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0*		A = b2 = MSG*		    b1 = C/D*		    b0 = I/O**		V = 1 if bus free*		C = 1 if invalid phase**********************************************************************************;					EXPORT	get_phaseget_phase			ldx		<io_offset			;point to specific i/o space					sep		#$40				;V=1 assume bus free					lda		>curbusstat,x		;get target command register					and		#$00FF				;low byte only					lsr		A					;REQ*,I/O*,C/D* to low 3 bits					lsr		A					bcs		exit				;if C=1 then SEL* asserted and should not be					cmp		#bsy				;check for BSY* asserted					bcc		@100					clc					rep		#$40				;V=0 not bus free@100				and		#%00000111			;mask off upper 5 bitsexit				rts							;>>>--- get_phase --->>>					ENDP						EJECT					EXPORT	bind_scsi_irqbind_scsi_irq		PROC*********************************************************************************	This module will install the scsi manage interrupt handler by issuing*	a BIND_IRQ system call to GS/OS to install the interrupt in its vectoring*	list.  The call will be issued as a stack based GS/OS call.**	ENTRY:	e,m,x=0*		bind_irq_bblk*		*********************************************************************************;					EXPORT	irq_id					longa	on					longi	on;					pea		bind_irq_pblk>>16	;high word of bind parameter block					pea		bind_irq_pblk		;low word					pea		bind_irq			;bind irq call number					jsl		stack_ENTRY			;GS/OS stack based call ENTRY point					bcc		bind_irq_exit		;every body happy					lda		#irq_install_err	;bad news!!					sta		|error_statbind_irq_exit		rts							;>>>--- bind_scsi_irq --->>>		bind_irq_pblk		dc.w	bind_pcount			;3 parametersirq_id				dc.w	$0000				;our irq identifier returned here					dc.w	scsi_vrn			;SCSI Manager VRN					dc.l	scsi_irq_hand		;SCSI Manager interrupt handler					ENDP					EXPORT	unbind_scsi_irqunbind_scsi_irq		PROC*********************************************************************************	This routine will unbind the SCSI Manager interrupt handle from GS/OS.**	ENTRY:	e,m,x=0*		irq_id**	EXPORT: e,m,x=0*********************************************************************************;;					longa	on					longi	on;					lda		irq_id				;setup our irq id					sta		|unbind_irq_id					pea		unbind_pblk>>16		;high word of parameter block					pea		unbind_pblk			;low word					pea		unbind_irq			;class 1 unbind irq					jsl		stack_ENTRY			;stack base GS/OS call					bcc		unbind_irq_exit					eor		#gsos_busy			;if gsos busy error ignore it (JJ said so)					bne		@100					clc					bcc		unbind_irq_exit@100				lda		#irq_remove_err		;irq remove error@110				sta		|error_statunbind_irq_exit		rts							;>>>--- unbind_irq --->>>;unbind_pblk			dc.w	unbind_pcount		;1 parameterunbind_irq_id		dc.w	$0000				;irq id to unbind					ENDP					EJECT					EXPORT	bus_resetbus_reset			PROC******************************************************************bus_reset:     This routine will assert the scsi RST* line for*       	125 usec (Mac recomended value) and clear the bus*       	reset.**       ENTRY:	e=0, m=X*             	io_offset = dev-sel space index for I/O for card**       Exit:	e=0, m=0, x=0*		X=(io_offset)*		*       NOTE: 	The 125 usec delay will be approx. 2.8 times*             	longer if running in slow mode.  The routine*             	does not check system speed.  Also, it is the*		responsibility of the caller to delay 275*		milliseconds to give time to the scsi devices*		to initialize themselves.******************************************************************;;;					php							;save m,x					longa	off					longi	on					sep		#$20				;m=1					rep		#$10				;x=0					phx							;save registers;					ldx		<io_offset					lda		#<%10000000			;scsi bus reset					sta		>initcmdreg,x					lda		#<usec125			;delay 125 usecsusec_delay_loop		dec		A					bne		usec_delay_loop					lda		#<%00011111			;clear scsi bus reset bit and					and		>initcmdreg,x		;test mode bit and differential bit					sta		>initcmdreg,x					plx					plp							;restore m,x					rts							;>>>--- bus_reset --->>>;					ENDP					EJECT					EXPORT	find_scsifind_scsi			PROC*********************************************************************************	This routine will check 16 slots for the presence of SCSI cards/ports*	It calls 'DYN_SLOT_ARBITER' with the accumulator containing the slot*	number sought.  If the slot is found then it PROCeeds to check for SCSI*	signatures and card/port type (old scsi card vs new).  The routine*	builds a I/O table which contains information about each of the scsi cards*	or ports found.*********************************************************************************;;;	;;					longa	on					longi	on;;					stz		<numscsi_cards		;reset total cards found count					ldy		#slot7ext			;start with slot 7 external					sty		<slot_no			;save the slot number					jsr		set_iorec_ptr		;form pointer for this slot's I/O record					bra		find_loop_altfind_scsi_loop		lda		<iorec_ptr			;point to next lower record					sec					sbc		#iorec_size						sta		<iorec_ptrfind_loop_alt		lda		<slot_no			;get the slot number					jsl		slot_arbit			;check with the slot arbitrator					bcs		not_scsi_card		;mark no scsi card available					jsr		smartp_scsi_chk		;check if smartport scsi implementation					bcs		not_scsi_card					jsr		chk_scsi_type		;check type of scsi card					bcc		next_slotnot_scsi_card		lda		#$0000				;marks not valid cardset_slot			ldy		#slot				;point to slot field					sta		[iorec_ptr],y		;set slot number slot numbernext_slot			dec		<slot_no			;next lower slot					bpl		find_scsi_loop						lda		#no_scsi_hardware	;assume  no cards will be found					sta		|error_stat			;assume no scsi cards found					lda		<numscsi_cards		;will contain total scsi card found count					beq		find_scsi_exit		;assume no cards found					ldy		#bres_ready_del		;give scsi devs 275 millisecs to come ready					jsr		millisec_delay		;after scsi bus reset cycle					stz		|error_stat			;report success (cards found)find_scsi_exit		lda		|error_stat			;check for no scsi hardware error					cmp		#$0001				;set carry if no cards					rts							;>>>--- find_scsi --->>>					ENDP							EJECT					EXPORT	chk_scsi_typechk_scsi_type		PROC*********************************************************************************	This routine will check the scsi card type looking for valid APPLE*	scsi cards and ports.**	ENTRY:	e,m,x=0*		iorec_ptr**	Exit:	e,m,x=0*		A,X,Y = undefined*********************************************************************************;;					longa	on					longi	on;					lda		#num_dev_types		;check for valid scsi card/port type					bra		@150				;types go from $0000@100				sta		ahold				;save type					asl		A					;times 4 for 32 bit table ENTRY					asl		A					tay					lda		|addr_tables,y		;point to proper address table for dev type					sta		<addr_table_ptr					iny					iny					lda		|addr_tables,y					sta		<addr_table_ptr+2					lda		#hwdchk				;check card type routine					jsr		callrtn				;call_routine through address table					bcc		@200				;carry clear = found it & I/O record was setup					lda		ahold				;restore type@150				dec		A					;decrement type					bpl		@100@200				rts							;>>>--- check_scsi_type --->>>							ENDP					EJECT					EXPORT	set_iorec_ptrset_iorec_ptr		PROC*********************************************************************************	This module sets up the iorec_ptr to a given value based on the contents*	of SLOT_NO.**	ENTRY:	e,m,x=0*		Y = slot number**	Exit:	e,m,x=0*		io_rec_ptr = address of I/O record corresponding to slot_no*********************************************************************************;;					longa	on					longi	on;					lda		#slot0					clc							;bump by increments of iorecsize@100				adc		#iorec_size					dey					bne		@100@200				clc							;include address of I/O table					adc		<io_table_ptr					sta		<iorec_ptr					lda		<io_table_ptr+2		;set I/O record pointer					sta		<iorec_ptr+2					rts							;>>>--- iotbl_index --->>>					ENDP					EJECT					EXPORT	init_sdr_tblinit_sdr_tbl		PROC*********************************************************************************	This routine sets up the SDR for a specific scsi logical unit found on*	the SCSI bus.  If the number of default SDRs built exceeds the number*	the number of default SDRs space a SetHandleSize call will be made to*	grow our work  area.  If we must grow our work area, it increases by*	enough bytes to allocate 8 SDRs (4 pages of memory).**		ENTRY:	e,m,x=0*			slot_no		:= peripheral card/port slot no.*			inqb_ptr	:= pointer to inquiry buffer containing data*			scsi_mem_ptr	:= pointer to our work area**		Exit:	e,m,x=0*			SDRs will be built for each logical device found*********************************************************************************;;;					longa	on					longi	on;;	find	SCSI devices & types by Issuing an Inquiry call;					lda		#no_scsi_devs					sta		|devices_found		;assume we do not find any targets					ldy		#slot0				;check slot 0 through slot F@100				lda		[io_table_ptr],y	;check the slot number for $0000					beq		@200					phy					tay							;save slot number					jsr		set_iorec_ptr		;point to i/o record for this slot					jsr		setup_work_vars		;setup working variable from i/o record					ply							;point at start of I/O record					phy					jsr		scan_scsi_devs		;go look for scsi devices					ply@200				tya							;point to next I/O record					clc					adc		#iorec_size					cmp		#iotsize			;see if all records checked					tay							;next record index					bcc		@100					lda		|devices_found		;assume no devices found					bne		exit					jsr		id_assignment		;walk through the SDR table assigning IDs					bcs		errexitexit				clcerrexit				rts							;>>>--- setup_buffers --->>>;					ENDP							EJECT					EXPORT	setup_work_varssetup_work_vars		PROC*********************************************************************************	This routine will copy several parameters from a given I/O record into*	several working variables.**	ENTRY:	e,m,x = 0*		Y=index to start of specific I/O record**	Exit:	e,m,x = 0*		The following variables loaded from the I/O record*			io_offset:	long word*			dma_offset:	long word*			io_attrbs:	word*			init_priority	word*********************************************************************************;;					longa	on					longi	on;					ldy		#slot					lda		[iorec_ptr],y		;check for slot/port present					sta		<slot_no			;save the slot number					jsl		slot_arbit			;enable this slot if we can					ldy		#slot+2					lda		[iorec_ptr],y		;get hardware type					sta		|hwd_version					ldy		#slot+4					lda		[iorec_ptr],y		;point to base address of scsi controller					sta		<io_offset					ldy		#slot+6					lda		[iorec_ptr],y		;high word of scsi controller io address					sta		<io_offset+2					ldy		#slot+8					lda		[iorec_ptr],y					sta		<dma_offset					ldy		#slot+10					lda		[iorec_ptr],y					sta		<dma_offset+2					ldy		#slot+12			;point to hardware attributes					lda		[iorec_ptr],y					sta		|ioattrbs					ldy		#slot+14					lda		[iorec_ptr],y					sta		|init_priority;;	point to card's address table;					phx					lda		|hwd_version			;get hardware type					asl		A					tax					lda		|addr_tables,x		;pointer to this interface routines addr table					sta		<addr_table_ptr					inx					inx					lda		|addr_tables,x					sta		<addr_table_ptr+2					plx					rts							;>>>--- setup_work_vars --->>>;					ENDP						EJECT					EXPORT	check_logicalscheck_logicals		PROC*********************************************************************************	This module will check logical units which may exist under SCSI devices.*	Checking is done by issuing a scsi Inquiry call to scsi device IDs. The*	call will request 256 bytes of data and save it away.  When the Inquiry*	call is made to the next logical unit the data returned by that call will*	be compared against the data saved away.  If they match then the current*	Logical unit will not have a SDR built for it.  Also, there will be no*	further scanning of logical units under this scsi device ID.**	ENTRY:	e,m,x=0**	Exit:	e,m,x=0*********************************************************************************;;					stz		<dev_id				;fake the find_sdr routine					lda		<slot_no					sta		|last_acc_slot2					stz		|last_acc_id2					stz		|lutemp				;logical units for device temp flags (assume all ok)					stz		|ckluflag			;$FFFF marks when we have 2 inq buffers to compare					stz		<logunit			;logical unit #0-7;;	setup some variables so we can issue find_sdr subroutine call;					lda		<slot_no			;set the slot number					sta		|tu_slot					sta		|inq_slot			;in the parameter list					sta		|sense_slot					lda		#lu0				;check Logical units 0-7 (in scsi packet form)					sep		#$20				;m=1 					sta		|tulunit			;logical unit for test unit ready parameter list 					sta		|inq_lunit			;logical unit number in inquiry cmd packet  					sta		|sense_lunit		;logical unit number in req_sense cmd packet;					longa	on					rep		#$20				;m=0checklu				ldx		#tuplist			;point to test unit ready parameter list					ldy		|ourcode_bank					jsr		set_plist					jsr		calltarget			;issue call to the target (ignore status from target)					ldx		#inq_plist			;point to inquiry paramter list					ldy		|ourcode_bank		;get our bank address					jsr		set_plist			;set parameter list					jsr		calltarget			;issue call to the target					if		debug 			then;;	DEBUG CODE enabled ALL LU's succeed;					bra		@200				;if debugging then assume all LUs present					else					bcs		errexit				;go away if error					endif;;	check if inquiry call succeeded;					lda		|scsi_status		;scsi status & message byte must be zero if ok					ora		|scsi_message					beq		@125				;good call go mark it in the list;;	inq call failed figure out why;					longa	on					rep		#$20				;m=0					jsr		get_plist			;save old parameter list pointer					phy					phx					ldx		#sense_plist		;point to request sense parameter list					ldy		|ourcode_bank		;get our bank address					jsr		set_plist			;set parameter list					jsr		calltarget			;issue call to the target					plx							;point back to inquiry parameter list					ply					jsr		set_plist					lda		|scsi_status		;see if request sense failed					bne		@150					lda		|sense_buff			;get the error class					and		#$007F				;mask off the valid bit					cmp		#$0070				;check for class 7 code $00					bne		@150				;class was not 7 or code <> zero					lda		|sense_buff+2		;get the sense key and check if device really exists					and		#$000F				;keep the sense key only					beq		@125				;we are ok mark device as existing					cmp		#$0001				;check for recovered error					beq		@125					cmp		#$0006				;check for unit attention					bne		@150@125				lda		|inq_buff			;check first byte for lu not supported ($7F)					and		#$00FF					cmp		#lunotavail					bne		@200@150				ldy		|inq_lunit			;get the LU #					jsr		setnoscan			;LU not available (don't scan for it again)					jsr		nextlu					bne		@150				;once an lu fails mark remaining LUs not available					beq		exit				;for this SCSI ID;;	Mark LU online & build SDR;@200				ldy		|inq_lunit			;mark this LU online					jsr		setonline					jsr		build_sdr			;build an SDR for this LU (may get tossed later)					stz		|devices_found		;we have a scsi target online					jsr		nextlu				;bump to next logical unit number					beq		exit					brl		checkluexit				lda		|lutemp				;get the logical unit bit mapping					clcerrexit				rts							;>>>--- exit check.logicals --->>>;					ENDP					EJECT					EXPORT	calltargetcalltarget			PROC*********************************************************************************	This routine issues a call to a target device and returns with the*	SCSI status and scsi message bytes set to what the target returned.**	ENTRY:	e,m,x = 0*		X = low word of parameter list address*		Y = High word of parameter list address**	Exit:	e,m,x = 0*		|scsi_status := status byte returned by the target*		|scsi_message:= message byte returned by the target*********************************************************************************;					longa	on					longi	on;					jsr		get_plist			;get the parameter list for this call					jsr		setzpgvars			;setup zero page work variables					bcs		errexit					jsr		find_sdr			;find a scsi device record to match					bcs		errexit;;	initialize more DCI instructions flag;					lda		#$FFFF					sta		|more_dci;;	go access the target;					lda		#arbph				;go arbitrate for control of scsi bus					jsr		callrtn					bcs		errexit				;go away if an error occurs					lda		#selectph			;select the target device					jsr		callrtn					bcs		errexit				;go away if an error occurs					lda		#setup					jsr		callrtn					lda		#phase_hand			;phase handler for old scsi card					jsr		callrtn					stz		|busy_sdr_count		;compensate for decrement in the msg completeerrexit				rts;					ENDP					EJECT					EXPORT	nextlunextlu				PROC************************************************************************	This routine will bump the logical unit ID work fields and*	decide if it has rolled past LU 7.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0*		Z = 1 if rolled past LU 7*		A = trashed*		inq_lunit 	MODIFIED*		tulunit		MODIFIED*		sense_lunit	MODIFIED***********************************************************************;					longa	off					sep		#$20				;m=1;;	see if lu 7 checked;					inc		<logunit			;logical unit number 0-7					lda		|inq_lunit					clc					adc		#lu1					sta		|tulunit			;update the test unit ready cmd packet					sta		|inq_lunit			;update inquiry cmd packet					sta		|sense_lunit		;update req_sense cmd packet					longa	on					rep		#$20				;m=0					rts							;>>>--- nextlu --->>>;					ENDP					EJECTset_io_addrs		PROC*********************************************************************************	This module will issue an Unit zero status code one call to the currently*	selected slot.  The call should return an error or respond with the*	the vendor id and the base address parameters for hardware devices found*	on that card.**	ENTRY:	e,m,x=0**	Exit:	e,m,x=0*********************************************************************************;;					sec							;report error					rts							;>>>--- set_io_addrs --->>>;					ENDP					EJECT					EXPORT	build_sdrbuild_sdr			PROC*********************************************************************************	This routine builds the SCSI device records for each logical unit found*	in the system...**	ENTRY:	e,m,x=0***	Exit:	e,m,x=0*********************************************************************************;;;	allocate next SDR record;					jsr		alloc_nxt_sdr		;get the address for the next SDR					bcs		exit					sty		<sdr_ptr+2					sta		<sdr_ptr;;	device type from inquiry buffer;					lda		|inq_buff\							+inq_devtype		;get the device type & standard version					and		#$00FF				;low byte only					ldy		#sdr_devtype					sta		[sdr_ptr],y;;	scsi standard version;					lda		|inq_buff\							+inq_version					and		#$00FF				;low byte only					ldy		#sdr_standard_vers					sta		[sdr_ptr],y;;	mark removeable bit in attributes;					ldy		#sdr_flags			;point to LU attributes word					lda		inq_buff+inq_rmb	;check for removeable media					and		#scsi_rmb			;bit 7 only					beq		@50					lda		#sdr_attrb_rmb		;mark removeable bit in SDR					ora		[sdr_ptr],y					sta		[sdr_ptr],y;;	save Slot, Device priority, Initiator priority & logical unit in SDR;@50					phx									ldy		#sdr_logunit					lda		<logunit			;our logical unit number					sta		[sdr_ptr],y					ldy		#sdr_targ_priot		;target priority					lda		|target_priority					sta		[sdr_ptr],y					ldy		#sdr_init_priot		;initiator priority					lda		|init_priority					sta		[sdr_ptr],y					ldy		#sdr_slot			;slot number					lda		<slot_no					sta		[sdr_ptr],y;	;	copy parameters from the scsi io record into the SDR;					ldy		#scsi_base			;point to the hardware addr in io record					lda		[iorec_ptr],y					pha					ldy		#scsi_base+2					lda		[iorec_ptr],y					pha					ldy		#dma_base			;dma controller base address						lda		[iorec_ptr],y					pha					ldy		#dma_base+2						lda		[iorec_ptr],y					pha					ldy		#sdr_dma_base+2		;write them into the SDR					pla					sta		[sdr_ptr],y					ldy		#sdr_dma_base					pla					sta		[sdr_ptr],y					ldy		#sdr_5380_base+2					pla					sta		[sdr_ptr],y					ldy		#sdr_5380_base					pla					sta		[sdr_ptr],y					inc		<sdrsonline			;bump the number of SDRs in the table					plxexit				rts							;>>>--- build_sdr --->>>					ENDP					EJECT					EXPORT	scan_scsi_devsscan_scsi_devs		PROC*********************************************************************************	This module scans a particular scsi slot or scsi built-in port for*	SCSI devices online.  The scsi devices are checked from scsi dev 0*	through scsi dev 6.  SCSI dev 7 is never checked; it is assumed to*	be the initiator.**	ENTRY:	e,m,x=0*		Carry=0 for external slot*		Carry=1 for internal scsi port*		io_offset = dev-sel address offset for this card/port*		Y= I/O table index*		init_priority = $0007 (priority 7 always initiator)**	Exit:	e,m,x=0*		A=trashed*		X= I/O table index*		Y points at the DMA offset bank word in the current slot record*********************************************************************************;;;;					longa	on					longi	on;					jsr		chkbusfloat			;check for floating scsi bus					bcs		scexit				;if floating, we are done here					lda		#scsi_prior7		;start with priority 7					sta		|target_priority					ldy		#d7logicals			;start at scsi device 7					bra		chkdupscloop				jsr		check_logicals		;check logical units (A=$FFFF no logicals)					bcc		setd				;C=0 if scsi device found	duplic				lda		#no_device			;assume no scsi device found	setd				ldy		|yhold				;restore device number					sta		[iorec_ptr],y					dey							;point to next scsi device table ENTRY					dey					stz		|error_stat			;clear possible select error from no targetskipp				lsr		|target_priority	;set for next priority					bcs		scexit	chkdup				sty		|yhold				;save the table index					lda		|init_priority		;if target = initiator priority skip it		;next priority					cmp		|target_priority					beq		duplic				;skip this one					bra		scloopscexit				rts							;>>>--- exit scan_scsi_devices --->>>;;					ENDP							EJECT					EXPORT	rest_sromselrest_sromsel		PROC**************************************************************************************	This routine will write the contents of slotrom_hold back into SLOTROMSEL*	register.**	ENTRY:	e,m,x=0*		(slotrom_hold) := value to restore slotromsel register to**	Exit:	e,m,x=0*		SLOTROMSEL register := slotrom_hold**************************************************************************************;;					php							;save m,x					longa	off					longi	on					sep		#$20				;m=1;					pha							;save accumulator					lda		#%00001000			;check if slot internal or external					trb		|slotrom_hold		;& reset bit 4 to zero					beq		@10					;$C3XX internal					lda		>setslotc3rom					bra		@20@10					lda		>setintc3rom@20					lda		|slotrom_hold		;write slotrom register					sta		>slotromsel					pla							;restore accumulator					plp							;restore m,x					rts							;>>>--- exit restore_slotromsel --->>>					ENDP					EJECT					EXPORT	save_work_varssave_work_vars		PROC*********************************************************************************	This routine will save our working variables into a holding buffer.**	ENTRY:	e,m,x=0*		work vars*		work_vars_buffer**	Exit:	e,m,x=0*		registers saved and restored*********************************************************************************;;					php							;save m,x					longa	on					longi	on					rep		#$30					phx							;save registers					pha					ldx		#$0000save_loop			lda		|scsi_variables,x	;save a piece of GS/OS zero page					sta		|work_vars_buffer,x					inx					inx					cpx		#work_vars_size					bcc		save_loop					pla							;restore registers					plx					plp							;restore m,x					rts							;>>>--- save work_vars --->>>					ENDP					EJECT							EXPORT	rest_work_varsrest_work_vars		PROC*********************************************************************************	This routine will restore our work variables into their respective*	locations from a holding buffer used to copy them into during an IRQ**	ENTRY:	e,m,x=0*		Work vars*		work_vars_buffer**	Exit:	e,m,x=0*		registers saved and restored*********************************************************************************;;					php							;save m,x					longa	on					longi	on					rep		#$30					phx							;save registers					pha					ldx		#$0000restore_loop		lda		|work_vars_buffer,x					sta		|scsi_variables,x	;restore a piece of zero page					inx					inx					cpx		#work_vars_size					bcc		restore_loop					pla							;restore registers					plx					plp							;restore m,x					rts							;>>>--- restore work vars --->>>							ENDP					EJECT					EXPORT	chk_sel_toutchk_sel_tout		PROC******************************************************************chk_sel_tout:  This routine will check for select timeout.*       	From the time the initiator removes BSY* the*       	target must assert BSY* within a select ABORT*       	time.  If this does not occur then carry will be*       	set to mark an error.**       ENTRY: e=0*              X=register offset ($00XX) XX=slot * $10 + $80**       Exit: e=0*             carry = 0 for select success*             carry = 1 for select failure******************************************************************;					php							;save status					longa	off					longi	on					sep		#$20				;m=1					rep		#$10				;x=0					phy							;save register					ldy		#sel_timeout		;count for delay of 250 millisec minselchk_loop 					lda		<curbusstat			;check for BSY* from target					and		#<bsy					bne		sel_success			;go away if target responded					dey							;decrement count					bne		selchk_loop			;keep checking until count=0 or					ply							;restore register					plp							;restore m,x					sec							;count=00 report error					bra		selchk_exitsel_success					ply							;restore register					plp							;restore status register					clcselchk_exit					rts							;>>>--- chk_sel_tout --->>>					ENDP					EJECT					EXPORT	sel_abort_waitsel_abort_wait		PROC******************************************************************sel_abort_wait:This module will wait release the SCSI data bus*       	and wait one select abort timeout (200 usec)*       	while checking for BSY* from the desired target*       	device.  If BSY* is not received from the target*       	then SEL* will be released and the bus will be*      	 	allowed to go back to the bus free phase.  Also*       	if the target does not respond carry will be set*       	and the accumulator will contain an error code.**       ENTRY: e=0*              X=register offset**       Exit: e=0*             A = 0, C=0 for successful response from target*             A = $XXXX C=1 for SELECT failure*             X = register offset******************************************************************;					php							;save status					longa	off					longi	off					sep		#$30				;m=1,x=1					phy							;save register					ldy		#<sel_abort_tout 	;select abort timeoutsel_abort_loop					lda		<curbusstat			;SCSI bus status register					and		#<bsy				;check for BSY* from target					bne		select_pass			;if BSY* asserted then OK					dey							;decrement timer					bne		sel_abort_loop		;until zero					ply							;restore register					plp							;restore status					sec							;mark an error					bra		sel_abort_exit		;go awayselect_pass										;target finally responded					ply							;restore register					plp							;restore m,x					clc							;mark successsel_abort_exit					rts					ENDP					EJECT					EXPORT	smartp_scsi_chksmartp_scsi_chk		PROC**************************************************************************************	This routine checks for smartport SCSI devices signatures.**				$CN01 = $20*				$CN03 = $00*				$CN05 = $03*				$CN07 = $00*	and if match then checks*				$CNFB bit 1 = 1 signifying a SCSI Smartport device**	If the above criteria is met then a check against part of the rom image will*	be made and if a match is found the it is assumed that the card is a old*	Apple  II scsi card.**	ENTRY:	e,m,x=0*		slot_no = slot number to check**	Exit:	e,m,x=0*		C=0,V=0 old apple scsi card*		C=1,V=X not scsi card*		C=0,V=1 scsi card but not old  apple scsi card**************************************************************************************;;					longa	on					longi	on;					phx							;save registers					phy					lda		<slot_no			;get slot number					and		#slot7				;mask off internal/external bit					xba							;times $100					tax							;index for soft switches;					lda		>io_space+1,x		;check $00CN01 = $20					and 	#$00FF				;mask off upper byte					cmp   	#$0020					bne		@100				;go away if no match					lda		>io_space+3,x		;check $00CN03 = $00					and 	#$00FF				;mask off upper byte					bne		@100				;go away if no match					lda		>io_space+5,x		;check $00CN05 = $03					and 	#$00FF				;mask off upper byte					cmp		#$0003					bne		@100				;go away if no match					lda		>io_space+7,x		;check $00CN07 = $00					and 	#$00FF				;mask off upper byte					bne		@100				;go away if no match					lda		>io_space+$FB,x		;check $00CNFB bit 1					and		#%0000000000000010	;bit 1 must be one for scsi					beq		@100@200				clc							;C=0 (scsi card)					bcc		@300@100				sec							;C=1 (not scsi card)					bcs		@300@300				ply							;restore registers					plx					rts							;>>>-- check_slot --->>>					ENDP					EJECT					EXPORT	millisec_delaymillisec_delay		PROC******************************************************************millisec_delay:This routine will delay a number of milliseconds*       	specified by the contents of the A register.**       ENTRY: 	e=0,m=0,x=0*              	Y reg = delay count 1-65536 ($0000=65536 millisecs)**       Exit: 	e=0,m=0,x=0*             	A = trashed*            	Y = $0000*		X = $0000******************************************************************;;					longa	on					longi	on;;					php							;save m,x					sei							;no interruptions					longa	off					longi	on					sep		#$20				;m=1					rep		#$10				;x=0					lda		>cyareg				;get cya register contents					pha					and		#<%01111111			;slow the system down					sta		>cyareg					pla							;keep old cya register settingdelay_millisec 					ldx		#millisec_count		;1 millisecond delay countmillis_del_loop 					dex							; 2 cycles					bne		millis_del_loop		; 3 (2 if branch fails)					dey					bne		delay_millisec		;keep delaying until zero					sta		>cyareg				;restore cya register					plp							;restore m,x					rts							;>>>--- millisec_delay --->>>					ENDP					EJECT					EXPORT	match_phasesmatch_phases		PROC******************************************************************match_phases:  This routine will set the MSG*, C/D* and I/O**       lines on the initiator 5380 the same as the*       MSG*, C/D* and I/O* lines on the target.  The*       routine toggles lines, it does not look to make*       sure that the we have made through the arbitrate*       and select phases successfully.**       ENTRY: e=0*              X=register offset**       Exit: Same as ENTRY******************************************************************;					php							;save m,x					longa	off					sep		#$20				;m=1					lda		>curbusstat,x		;get the settings of MSG*,C/D*,I/O*					lsr		A					;set MSG, C/D, I/O as low 3 bits					lsr		A					and		#<%00000111			;mask off remaining bits					sta		>targcmdreg,x					plp							;restore m,x					rts							;>>>--- match phases --->>>					ENDP					EJECT					EXPORT pdma_recv_datapdma_recv_data		PROC******************************************************************pdma_recv_data  This routine will read 512 bytes of data from a*                a target device.  The data will be stored in*                the location pointed by [data_buffer_ptr].  The*                byte count will be specified by RECV_SIZE. The*                routine expects to use pseudo dma mode to do the*                data transfers. It calls the enable dma routine*                with carry set to enable the pseudo dma mode.**                ENTRY: e=0*                          (data_buffer_ptr:long word) = data buffer address*                          (recv_size:word) = number of bytes to receive*                       X = register offset for specific 5380**                Exit:  same as ENTRY******************************************************************;;					clc							;data phase complete					rts							;>>>--- recv_data--->>>					ENDP					EJECT					EXPORT	rdma_recv_datardma_recv_data		PROC******************************************************************rdma_recv_data This routine will read 512 bytes of data from a*       	a target device. The data will be stored in*      	 	the location pointed by [data_buffer_ptr].  The*       	byte count will be specified by RECV_SIZE. The*       	routine expects to use pseudo dma mode to do the*       	data transfers. It calls the enable dma routine*       	with carry set to enable the pseudo dma mode.**       ENTRY: e=0*                 (data_buffer_ptr:long word) = data buffer address*                 (recv_size:word) = number of bytes to receive*              X = register offset for specific 5380**       Exit:  same as ENTRY******************************************************************;;					clc							;data phase complete					rts							;>>>--- recv_data--->>>					ENDP					EJECT					EXPORT	rdma_send_datardma_send_data		PROC******************************************************************rdma_send_data This routine will write 512 bytes of data to a*       	a target device. The data will be stored in*       	the location pointed by [data_buffer_ptr].  The*      	 	byte count will be specified by xmit_SIZE. The*       	routine expects to use real dma mode to do the*       	data transfers. It calls the enable dma routine*       	with carry clear to enable the real dma mode.**       ENTRY: e=0*              carry = 0 (real dma)*              (data_buffer_ptr:long word) = data buffer address*              (recv_size:word) = number of bytes to receive*              X = register offset for specific 5380**       Exit:  same as ENTRY******************************************************************;;					clc							;data phase complete					rts							;>>>--- rdma_send_data --->>>					ENDP					EJECT					EXPORT	bus_statusbus_status			PROC****************************************************************** This module will read the status registers from the SCSI chip* and return them to the caller in the accumulator.  This code* can be called in native or emulation mode. Bits 0-7 will be* returned in the A register and bits 8-15 will be returned in the* B register.**          Stat_reg:*          +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*          |F|E|D|C|B|A|9|8|7|6|5|4|3|2|1|0|*          +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*           | | | | | | | | | | | | | | | |*           | | | | | | | | | | | | | | | +---- Data bus parity*           | | | | | | | | | | | | | | +------ SEL**           | | | | | | | | | | | | | +-------- I/O**           | | | | | | | | | | | | +---------- C/D**           | | | | | | | | | | | +------------ MSG**           | | | | | | | | | | +-------------- REQ**           | | | | | | | | | +---------------- BSY**           | | | | | | | | +------------------ RST**           | | | | | | | +-------------------- ACK**           | | | | | | +---------------------- ATN**           | | | | | +------------------------ Busy error*           | | | | +-------------------------- Phase Match*           | | | +---------------------------- IRQ request*           | | +------------------------------ Parity Error*           | +-------------------------------- DMA Request*           +---------------------------------- End of DMA**       ENTRY:  e,m,x=0**       Exit:   e,m,x=0*		C reg = bus status word******************************************************************;					longa	on					longi	on					phx							;save register					ldx		<io_offset			;io address					lda		>curbusstat,x					plx							;restore register					rts							;>>>--- exit bus_status --->>>;					ENDP					EJECT					EXPORT	setzpgvarssetzpgvars			PROC*********************************************************************************	This routine will setup all the zero page pointers to access the*	parameters list provided by the device driver.  Also, the routine*	validates the parameter list and initializes internal work variables.*	This routine will work for SCSI_IO call only!**	ENTRY:	e,m,x=0*		parameter list from caller**	Exit:	e,m,x=0*		C=1 if timeout value = $0000*********************************************************************************						longa	on					longi	on;;	copy parameters into work variables;					stx		<plist_ptr					sty		<plist_ptr+2					ldy		#plst_slot			;get the ID of the device (slot & unit number)					ldx		#0000				;destination index@100				lda		[plist_ptr],y		;get the ID of device sought					sta		<zpgwptrs,x					inx					inx					iny					iny					cpy		#wptrssize			;check if all pointers moved					bcc		@100	;;	clear parameter list request count need field for transfer count;@150				ldy		#plst_reqxfr_cnt	;clear parameter list request count					lda		#$0000				;a copy of the request count saved in zpg					sta		[plist_ptr],y					ldy		#plst_reqxfr_cnt+2					sta		[plist_ptr],y;;	initialize the DC PC to start of data chain instructions;					lda		<dclst_ptr					sta		<dc_pc					lda		<dclst_ptr+2					sta		<dc_pc+2					clc							;mark no errors@300				rts							;>>>--- setwrkptrs --->>>						ENDP						EJECT					EXPORT	get_plistget_plist			PROC*********************************************************************************	This routine gets the address of the parameter list address from the SIB.**	ENTRY:	e,m,x=0**	Exit:	e,m,x=0*		X = Low word of parameter list address*		Y = High word of parameter list address**********************************************************************************;;						longa	on					longi	on						phd							;save direct register					lda		|gsos_zpg_hold		;point to GS/OS zero page					tcd					ldx		<sib_plptr			;get address of parameter list					ldy		<sib_plptr+2					pld							;restore direct register					rts							;>>>--- get_plist --->>>					ENDP					EXPORT	set_plistset_plist			PROC*********************************************************************************	This routine sets the address of the parameter list address in the SIB.**	ENTRY:	e,m,x=0*		X = Low word of parameter list address*		Y = High word of parameter list address**	Exit:	e,m,x=0**********************************************************************************;;						longa	on					longi	on						phd								;save direct register					lda		|gsos_zpg_hold			;point to GS/OS zero page					tcd					stx		<sib_plptr				;set address of parameter list					sty		<sib_plptr+2					pld								;restore direct register					rts								;>>>--- set_plist --->>>					ENDP						EJECT					EXPORT	find_sdrfind_sdr			PROC********************************************************************************	This module will walk compare the slot & scsi device id against the *	IDs of each scsi device record looking for a match.  If the ID is found*	sdr_ptr will be set with the address of this scsi device record.  If it*	is not found carry will be set to signify an error.**	ENTRY:	e,m,x=0*		dev_id = id sought**	Exit:	e,m,x=0*		Y = low word of SDR record address*		A = high lword of SDR record address*		& carry = 0*		Carry = 1 if no ID found********************************************************************************;;					longa	on					longi	on						lda		|last_acc_slot2		;get last accessed slot number					cmp		<dev_slot					bne		@100				;check alternate accessed slot field if no match					lda		|last_acc_id2					cmp		<dev_id					bne		@100				;check alternate accessed id field					ldy		|last_sdr_ptr2					lda		|last_sdr_ptr2+2					bra		@setsdr				;set the pointer for the sdr record@100				lda		|last_acc_slot1		;get the id sought					cmp		<dev_slot			;compare against last accessed slot					bne		@200				;check alternate accessed slot field if no match					lda		|last_acc_id1						cmp		<dev_id					bne		@200					ldy		|last_sdr_ptr1					lda		|last_sdr_ptr1+2					bra		@setsdr				;set the pointer for the sdr record;	@200				lda		<sdr_table_ptr+2	;form work pointer					sta		<sdr_ptr+2					lda		<sdr_table_ptr					sta		<sdr_ptr					lda		<sdrsonline			;number of sdrs to check					sta		<sdrstocheck@300				ldy		#sdr_slot			;point to the slot number in this SDR					lda		[sdr_ptr],y					cmp		<dev_slot			;compare against sought slot					bne		@325					ldy		#sdr_device_id		;point to ID field within SDR					lda		<dev_id				;get the device ID					cmp		[sdr_ptr],y			;compare IDs					beq		@400@325				ldy		#nxt_sdr_lnk+2		;get address to next SDR					lda		[sdr_ptr],y					pha					lda		[sdr_ptr]					sta		<sdr_ptr					pla					sta		<sdr_ptr+2					dec		<sdrstocheck					bne		@300@nosdr				stz		|last_acc_id1		;clear both last_acc_id fields					stz		|last_acc_id2					lda		#bad_scsi_id		;report an error					sta		|error_stat					sec							;mark bad id					bra		endfsdr;;	return the address of the SDR;@400				ldx		|last_acc_flag		;get last access flag/index					lda		<dev_slot			;slot number					sta		|last_acc_slot1,x	;save the slot number					lda		<dev_id					sta		|last_acc_id1,x		;save the id of this field					lda		<sdr_ptr			;get the address of the SDR					sta		|last_sdr_ptr1,x					tay					lda		<sdr_ptr+2					sta		|last_sdr_ptr1+2,x;;	toggle the accessed flag so we know which pointer to change next time;	we do not find the slot & unit we seek.;					pha							;save high word of sdr address					txa							;toggle the flag & form new index					eor		#last_acc_id2\							-last_acc_id1					sta		|last_acc_flag		;save the flag/index for next time					pla@setsdr				clc							;mark successendfsdr				rts							;>>>--- find_sdr --->>>>						ENDP					EJECT					EXPORT	priot_to_devpriot_to_dev		PROC********************************************************************************	This routine will convert a scsi priority number into a scsi device*	number.  For example scsi priority $80 = $07.*	NOTE: This routine will hang in an infinite loop if priority = $0000**	ENTRY:	e,m,x=0*		A = scsi priority to convert**	Exit:	e,m,x=0*		A=scsi device number*		X=scsi device number********************************************************************************;;					and		#$00FF				;priority $80-$01 only!					clc					ldx	#$0007					;start with scsi device $0007					xba							;in high byte of accumulator@100				asl		A					;shift scsi priority into carry					bcs		@200					dex					bra		@100				;hang around if priority = $0000 (should never happen)@200				txa							;dev number in accumulator					rts							;>>>--- exit priot_to_dev					ENDP							EXPORT	dev_to_priotdev_to_priot		PROC********************************************************************************	This routine will convert a scsi device number into a scsi bus priority.**	ENTRY:	e,m,x = 0*		A = device number to convert**	Exit:	e,m,x = 0*		A = priority number*		X = device number converted********************************************************************************;;					and		#$0007				;devices $0000-$0007 only!					tax					lda		dtop_tbl,x			;table translation					rts							;>>>--- dev_to_priot --->>>;					EXPORT	dtop_tbldtop_tbl			dc.b	$01					;device 0 = priority $01					dc.b	$02					;device 1 = priority $02					dc.b	$04					;device 1 = priority $04					dc.b	$08					;device 1 = priority $08					dc.b	$10					;device 1 = priority $10					dc.b	$20					;device 1 = priority $20					dc.b	$40					;device 1 = priority $40					dc.b	$80					;device 1 = priority $80					ENDP							EJECT					EXPORT	get_tick_addrget_tick_addr		PROC*********************************************************************************	This routine will call the Misc tools and request the address of the*	system tick counter.**	ENTRY:	e,m,x = 0**	Exit:	tick_addr := address of system tick counter*********************************************************************************;tick_refnum	equ		$0005						;tick counter address reference number;					longa	on					longi	on;					pha							;room for long result					pha					pea		tick_refnum			;tick reference number ($0005 := tick count address)					_GetAddr					;misc. tools get address call					pla							;save the address					sta		<tick_addr					pla					sta		<tick_addr+2					rts							;>>>--- get_tick_addr --->>>;					ENDP;					EJECT					EXPORT	getticksgetticks			PROC************************************************************************************	This routine will check the timeout count for a value greater than $10000.*	If the value is greater, it subtracts $FFFF from the value and returns*	with the accumulator set to $FFFF.  If the value is less than $10000,*	the accumulator will be set to the value of the low word of the timeout.**	ENTRY:	e,m,x = 0*		[SDR_PTR] := record containing the timeout value to check**	Exit:	e,m,x = 0*		A := $FFFF if value in 32 bit timeout field greater than $10000*		A := value of low timeout word.************************************************************************************;					longa	on					longi	on;;	check high word of timeout > $0000;					ldy		#sdr_timeout+2					lda		[sdr_ptr],y					php;;	get contents timeout low word then check if high word was zero;					ldy		#sdr_timeout					lda		[sdr_ptr],y					plp					bne		@100				;high word was zero go away with low word contents;;	clear low word of timeout count;					pha					lda		#$0000					sta		[sdr_ptr],y					pla					bra		exit				;go away;;	subtract $FFFF from low word save result and adjust high word;@100				sec					sbc		#$FFFF					sta		[sdr_ptr],y					iny					iny							;point to high word of timeout					lda		[sdr_ptr],y					sbc		#$0000					sta		[sdr_ptr],y					lda		#$FFFF				;value to load into heartbeat headerexit				rts;					ENDP						EJECT					EXPORT	get_targpget_targp			PROC**********************************************************************************	This routine will extract the scsi ID from the DEVICE ID requested by*	the caller.**	ENTRY:	e,m,x = 0*		dev_id := device ID assigned by scsi manager**	Exit:	e,m,x = 0*		A = target priority***********************************************************************************;					longa	on					longi	on;					phx					lda		<dev_id				;get the ID					asl		A					;put scsi id in low 3 bits of high byte					asl		A					xba							;low byte					and		#$0007				;keep low 3 bits					tax					lda		|dtop_tbl,x			;convert to bit position encoding					and		#$00FF				;low byte only					plx					rts							;>>>--- get_targp --->>>;					ENDP;					EJECT*************************************************************************************	The next four routine will set the corresponding bit combinations in*	the logical unit field positions of each scsi I/O record.  There are*	 four possible bit patterns which may be set for each logical unit.**	Logical Unit Bitmap:*	 F E D C B A 9 8 7 6 5 4 3 2 1 0*	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*	|   |   |   |   |   |   |   |   |   SCSI Device N Logical unit bitmap*	+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+*	 LU7 LU6 LU5 LU4 LU3 LU2 LU1 LU0**		Bit Pattern Definitions*		00 = Unit needs scanning*		01 = Logical unit online do not scan*		10 = Currently selecting SCSI device for these 8 logicals*		11 = Logical unit not available (do not scan for it)**	ENTRY: e,m,x = 0*		Y = LU # to update in word pattern************************************************************************************;scanpatt			equ		$0000				;bit pattern for scan for logical unitonlinepatt			equ		$0001				;bit pattern for logical unit onlineselecton			equ		$0002				;bit pattern for currently selecting scsi targetnotscanned			equ		$0003				;bit pattern for DO NOT scan for this LU;setscan				PROC					lda		#scanpatt			;00 = scan for logical unit					bra		setlupatt			;go set bits corresponding to this LU;					EXPORT	setonlinesetonline			lda		#onlinepatt			;01 = LU online					bra		setlupatt;					EXPORT	selectingselecting			lda		#selecton			;10 = currently selecting target					bra		setlupatt;					EXPORT	setnoscansetnoscan			lda		#notscanned			;11 = do not scan logical unit;setlupatt			phx					pha							;save the 2 bit pattern to write out					tya					and		#$00FF				;low byte only					lsr		A					;shift them to low 3 bits then times 2					lsr		A					lsr		A					lsr		A					tax							;index into mask table for LUs					lda		luptbl,x					ora		|lutemp					eor		luptbl,x			;two bits corresponding to LU # should be clear					sta		|lutemp					pla							;get pattern to write					cpx		#lu0					beq		@150				;don't shift if LU zero already@100				asl		A					;shift it into proper position					dex					bne		@100@150				ora		|lutemp				;set the appropriate bits					sta		|lutemp					plx					rts							;>>>--- exit lu bit pattern set routines --->>>;luptbl				dc.w	$0003				;LU 0 pattern mask					dc.w	$000C				;LU 1 pattern mask					dc.w	$0030				;LU 2 pattern mask					dc.w	$00C0				;LU 3 pattern mask					dc.w	$0300				;LU 4 pattern mask					dc.w	$0C00				;LU 5 pattern mask					dc.w	$3000				;LU 6 pattern mask					dc.w	$C000				;LU 7 pattern mask;					ENDP							EJECTalloc_nxt_sdr		PROC************************************************************************************	This routine returns the next SDR address available.  If no space is*	available the routine will call the memory manager and request enough space*	for a specific number of SDRs.  If an error is returned from the memory*	manager the call exits with an error.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0*		A = low word of SDR address & C=0 of call succeeds*		Y = high word of SDR address**		A,Y undefined and C=1 if error encountered************************************************************************************;					longa	on					longi	on;					lda		<avail_sdrs				;if already zero then quit					bne		@100					lda		#sm_rsrc_err			;got an error from get handle call					sta		|error_stat					sec					brl		errexit;;	get SDR address;@100				lda		<next_sdr+2				;get the SDR address					pha					lda		<next_sdr					pha					dec		<avail_sdrs				;decrement number of available SDRs					beq		getmem					;had one left go allocate more space					clc								;bump to next SDR (cannot cross banks)					adc		#sdrrec_sizesetlink				sta		[next_sdr]				;form link address for next SDR					pha								;save low 16 bits of next sdr address					lda		5,s						;get the high word of the SDR address					inc		next_sdr					inc		next_sdr					sta		[next_sdr]					pla								;restore low 16 bits of next sdr address					sta		<next_sdr				;save next SDR address					bra		exit;getmem				lda		#default_sdrs			;assume we can get the memory for more sdrs					sta		<avail_sdrs					pha								;room for handle					pha					pea		default_sdrs\							*sdrrec_size>>16		;high word of number of bytes required					pea		default_sdrs\							*sdrrec_size			;number of bytes required					lda		|user_id				;our ID					pha					pea		sm_buffer_attrs			;locked not cross banks,....					pea		$0000					;address (not used in this call)					pea		$0000					_NewHandle					pla								;get handle off the stack					ply					bcc		@100;					ldy		#nxt_sdr_lnk		;no more SDRs tag link to next SDR with zeroes					lda		#$0000					sta		[next_sdr],y					ldy		#nxt_sdr_lnk+2					sta		[next_sdr],y					lda		#sm_rsrc_err		;got an error from get handle call					sta		|error_stat					stz		<avail_sdrs			;could not get memory					bra		exit				;go away with last SDR address EVER!!!;;	get pointer to new memory & form link to next available SDR;@100				sta		<scratchzpg					sty		<scratchzpg+2					ldy		#$0000					lda		[scratchzpg],y					sta		[next_sdr],y					pha							;save new low word of next SDR pointer					ldy		#$0002					lda		[scratchzpg],y					sta		[next_sdr],y;;	form new Next_SDR address pointer & set avail_sdrs to default sdrs;					sta		next_sdr+2					pla					sta		next_sdr;;	clear newly allocated memory;					phx					lda		#default_sdrs\							*sdrrec_size		;number of bytes to clear					ldx		next_sdr			;address of first location					ldy		next_sdr+2					jsr		clear_memory		;wipe the new memory					plx					dec		<avail_sdrs			;decrement available SDRsexit				pla							;get SDR address & quit					plyerrexit				rts							;>>>--- alloc_nxt_sdr --->>>;					ENDP						EJECT					EXPORT	getnxtdcigetnxtdci			PROC***********************************************************************************	This routine will get the pointer to the next DC instruction and return it*	to the caller.  The routine performs the following steps:**		1. Check if first instruction in DCP	(data chaining packet)*		2. If first then*			a) reset DC PC*			b) setup working pointers*			c) clear first instruction flag*			d) jump back to getnxtdci*		3. bump DC PC.*		4. get first long word of instruction*		5. If zero then go to DCSTOP*		6. If -1 then go to DCLOOP*		7. Must buffer address goto to Buffer handler.************************************************************************************;;					lda		<dc_pc				;data chain pc in terms of bytes					sta		<curr_dci_ptr		;form pointer to current DC instruction					lda		<dc_pc+2					sta		<curr_dci_ptr+2;;	check for DCMOVE, DCLOOP & DCSTOP instructions;					ldy		#dc_opcode			;start at the beginning of the instruction					lda		[curr_dci_ptr],y					pha							;save the instruction					ldy		#dc_opcode+2					ora		[curr_dci_ptr],y	;check for DCSTOP					beq		dcstop;					lda		1,s					;check for DCLOOP					and		[curr_dci_ptr],y					cmp		#dc_loop_inst					beq		dcloop;;	must be a buffer address;					lda		[curr_dci_ptr],y	;get high word of buffer address					sta		<buffer_ptr+2					pla							;get low byte of buffer address					sta		<buffer_ptr					ldy		#dc_count			;get the byte count					lda		[curr_dci_ptr],y					sta		<byte_ctr					ldy		#dc_count+2					lda		[curr_dci_ptr],y					sta		<byte_ctr+2					clc					jsr		bump_addr			;add offset to address and save it					jsr		bump_pc				;bump the DCI prog counter					brl		exit				;return to caller with address & count;;	Looping Data chaining instruction (DCLOOP);dcloop				pla							;discard low byte of instruction address					ldy		#dc_count			;get the number of passes through the loop					lda		[curr_dci_ptr],y	;bump past this instruction if zero					pha					ldy		#dc_count+2					lda		[curr_dci_ptr],y					ora		1,s					bne		deccnt				;otherwise decrement the loop count					jsr		bump_pc				;bump the DCI pc					pla							;discard working low word of loop count					bra		getnxtdci			;go back for another DC instruction;;	decrement the loop count;deccnt				pla					dec		A					;decrement the low word of the loop count					ldy		#dc_count			;get index to loop count					sta		[curr_dci_ptr],y	;save the low word of the count					bne		dcbra				;go to specified offset if nonzero					ldy		#dc_count+2					lda		[curr_dci_ptr],y					dec		A					sta		[curr_dci_ptr],y	;decrement high word of loop count					beq		goagain				;loop exausted see if more instructions;;	loop not exausted get relative offset and branch;dcbra				ldy		#dc_offset			;get the loop instruction offset					lda		[curr_dci_ptr],y	;low word of offset					sta		<scratchzpg			;offset times 16					ldy		#dc_offset+2					lda		[curr_dci_ptr],y					sta		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					asl		<scratchzpg					rol		<scratchzpg+2					clc					lda		<scratchzpg			;get low word of offset*16					adc		<dc_pc				;adjust the chaining inst. prog. counter					sta		<dc_pc					lda		<scratchzpg+2		;get high word of offset*16					adc		<dc_pc+2					sta		<dc_pc+2goagain				brl		getnxtdci			;go execute next instruction;;	DCSTOP instruction handler;dcstop				pla							;discard high word of instruction					iny							;point to 2nd long word of dcstop					iny					lda		[curr_dci_ptr],y	;check low 24 bits for nonzero (routine address)					iny					ora		[curr_dci_ptr],y	;check for DCSTOP					beq		@110				;a real DCSTOP instruction;;	DCSPECIAL instruction;					lda		[curr_dci_ptr],y	;get bits 8-23 of routine address					sta		@100+2				;self modify high byte of JSL address					dey					lda		[curr_dci_ptr],y	;get bits 0-15 of routine address					sta		@100+1				;self modify low word of JSL address@100				jsl		$00000000			;the user returns back to us or hell breaks loose					jsr		bump_pc				;bump the data chaining program counter					brl		getnxtdci			;go get the next instruction;;	all done with DCSTOP instruction;@110				stz		|more_dci			;reset more data chain instructions flagnodci				secexit				rts							;>>>>---- getnextdci ---->>>;;----------------------------------------------------------------------------;;	Bump the DCI program counter;;	ENTRY:	e,m,x = 0;		dc_pc;;	exit:	e,m,x = 0;		dc_pc := dc_pc + 16;;----------------------------------------------------------------------------;bump_pc	php					pha					lda		<dc_pc				;bump the data chain prog. counter					clc					adc		#dc_size			;bump by data chain intruction size					sta		<dc_pc					bcc		@100					inc		<dc_pc+2			;bump chaining program counter@100				pla					plp					rts							;>>>--- exit bump_pc --->>>;;;----------------------------------------------------------------------------;;	ADD the contents of the offset field to the address field;;	ENTRY:	e,m,x = 0;		curr_dci_ptr:	pointer to current DC instruction;;	Exit:	e,m,x = 0;		[DCMOVE_opcode] := [DCMOVE_opcode]+[DCMOVE_offset];;----------------------------------------------------------------------------;bump_addr			php							;save Carry					ldy		#dc_offset+2		;get high word of offset to add to the address					lda		[curr_dci_ptr],y					pha					ldy		#dc_offset					lda		[curr_dci_ptr],y					ldy		#dc_opcode					clc					adc		[curr_dci_ptr],y					sta		[curr_dci_ptr],y	;write out the modified address					pla							;get the high word of the offset					ldy		#dc_opcode+2					adc		[curr_dci_ptr],y					sta		[curr_dci_ptr],y					plp							;restore Carry					rts							;>>>--- exit bump_addr ---->>>;					ENDP					EXPORT	setup_call_envsetup_call_env		PROC**********************************************************************************	This routine will copy all the work variables from the SCSI Device record*	into working variables.**	ENTRY:	e,m,x = 0*		plist_ptr points to the record matching sought ID**	Exit:	e,m,x = 0*		working parameters*		updated**********************************************************************************;;					ldy		#sdr_logunit		;logical unit					lda		[sdr_ptr],y					sta		<logunit					ldy		#sdr_targ_priot		;target priority					lda		[sdr_ptr],y					sta		|target_priority					ldy		#sdr_init_priot		;initiator priority					lda		[sdr_ptr],y					sta		|init_priority					ldy		#sdr_slot			;slot number					lda		[sdr_ptr],y					sta		<slot_no					ldy		#sdr_5380_base		;5380 I/O base address					lda		[sdr_ptr],y					sta		<io_offset					ldy		#sdr_5380_base+2					lda		[sdr_ptr],y					sta		<io_offset+2					ldy		#sdr_dma_base		;5380 DMA controller base address					lda		[sdr_ptr],y					sta		<dma_offset					ldy		#sdr_dma_base+2					lda		[sdr_ptr],y					sta		<dma_offset+2;;	setup work flags etc...;					lda		#$FFFF				;setup for possible DCI instructions					sta		|more_dci					rts							;>>>--- setup_call_env --->>>;					ENDP						EXPORT	id_assignmentid_assignment		PROC**********************************************************************************	This routine will determine the boot slot and assign the SDR which*	contains the target with the highest scsi priority ID 1.  This way*	the boot continues from the same target when the SCSI driver got control.*	IDs are assigned*	based on slot number.  Each slot starts with ID 1 and increments for each*	device found on that slot.**	ENTRY:	e,m,x = 0*		sdr_table_ptr: points to the first SDR in the table**	Exit:	e,m,x = 0*		Each SDR contains an ID based on Slot & unit number.*		A,X,Y undefined.**********************************************************************************;					longa	on					longi	on					phx							;save register					lda		<sdrsonline			;number of sdrs available					sta		<sdrstocheck					bne		@100					brl		alldone				;if zero go away@100				lda		<sdr_table_ptr		;point to the start of the SDR table					sta		<scratchzpg					lda		<sdr_table_ptr+2					sta		<scratchzpg+2;;	issue get_dib_ptr call for unit one to find boot slot number;					phd							;save our zero page					lda		|gsos_zpg_hold		;point to GS/OS zero page					tcd					pei		<drvr_dib_ptr+2		;save the driver dib pointer					pei		<drvr_dib_ptr					pei		<dev_id_ref			;save the id reference number					pei		<drvr_dev_num		;save current device number					stz		<drvr_dev_num		;select device dispatcher					lda		#$0001				;unit number one					sta		<dev_id_ref					lda		#get_dib_ptr					sta		drvr_call_num					jsl		dev_dispatcher		;issue get_dib_ptr to device dispatchjer					ldy		#slot_num					lda		[drvr_dib_ptr],y							sta		|smboot_slot					pla							;restore gsos zero page					sta		<drvr_dev_num		;restore GS/OS direct page					pla					sta		<dev_id_ref					pla					sta		<drvr_dib_ptr					pla					sta		<drvr_dib_ptr+2					pld							;point back to our direct page					bcc		dibok				;if we fail, we get purged;dibfail	sec					lda		#get_dib_err		;get_dib_ptr failed					sta		|error_stat					brl		alldone;;	get the slot number of the boot device;dibok				lda		<scratchzpg			;make the previous sdr link point					sta		<sdr_ptr			;to sdr N					lda		<scratchzpg+2					sta		<sdr_ptr+2ckslot				ldy		#sdr_slot			;point to the slot field within the SDR					lda		[scratchzpg],y					cmp		|smboot_slot					beq		smatch				;found matching slots adjust link pointers;;	slots do not match check next SDR;					dec		<sdrstocheck		;if count zero go assign ids					beq		assgnid					ldy		#nxt_sdr_lnk+2		;point to next SDR;;	save this SDR's address;					lda		<scratchzpg+2		;keep SDR's address					sta		<sdr_ptr+2					lda		<scratchzpg					sta		<sdr_ptr					lda		[scratchzpg]					pha					lda		[scratchzpg],y		;set address for next SDR					sta		<scratchzpg+2					pla					sta		<scratchzpg					bra		ckslot				;go check the slot number;;;********************************************************************************;;	found a slot match adjust the link pointers and set the IDs;;********************************************************************************;;	scratchzpg := address of SDR N;	sdr_ptr	:= address of SDR N-1;;BEFORE:;				+-----------+			+-----------+			+-----------+;Head >>------>>|  SDR N-1  | >>----->>	|   SDR N   | >>----->> |   SDR N+1 |;				+-----------+			+-----------+			+-----------+;;			;AFTER:			;				+-----------+			+-----------+			+-----------+;Head >>----->> |  SDR  N   | >>----->>	|  SDR N-1  | >>----->> |  SDR N+1  |;	  		 	+-----------+			+-----------+			+-----------+;;********************************************************************************;	smatch				lda		<scratchzpg+2		;check for already in right order					eor		<sdr_ptr+2					bne		@100					lda		<scratchzpg					eor		<sdr_ptr					beq		assgnid;@100				ldy		#nxt_sdr_lnk+2		;point to nxt_sdr_ptr field high word					lda		[scratchzpg],y		;SDR N+1 address into SDR N-1 link ptr					sta		[sdr_ptr],y					lda		[scratchzpg]					sta		[sdr_ptr]					lda		<sdr_table_ptr+2	;save pointer to head of list					pha					lda		<sdr_table_ptr					pha					lda		<scratchzpg+2		;write SDR N address in head link					sta		<sdr_table_ptr+2					lda		<scratchzpg					sta		<sdr_table_ptr					pla							;link SDR N to SDR N-1					sta		[scratchzpg]					pla							;restore high word of old sdr_table_ptr					sta		[scratchzpg],y;;	Assign the IDs starting with $0001;assgnid				lda		<sdrsonline			;number of SDRs to assign IDs for					sta		<sdrstocheck					lda		<sdr_table_ptr+2					sta		<scratchzpg+2					lda		<sdr_table_ptr					sta		<scratchzpgnextid				ldy		#sdr_slot			;point to the slot field within the SDR					lda		[scratchzpg],y		;get the slot for this SDR					jsr		getnextID					ldy		#sdr_device_id		;point to ID field in SDR					sta		[scratchzpg],y					dec		<sdrstocheck					clc							;assume all done					beq		alldone				;count of zer means all done;onemore				ldy		#nxt_sdr_lnk+2		;point to link field					lda		[scratchzpg],y		;get address of next SDR					pha					lda		[scratchzpg]					sta		<scratchzpg					pla					sta		<scratchzpg+2					bra		nextidalldone				plx					rts							;say goodnight!!;					ENDP					EJECT					EXPORT	validate_msgvalidate_msg		PROC**********************************************************************************	This module will validate the message to be sent to the target or*	received from the target.**	ENTRY:	e,m,x = 0*		A = message byte to validate**	Exit:	e,m,x = 0*		A = $00XX where XX = message number &C = 0 if valid message*		A = $00XX where XX = message # & C=1 for bad message**********************************************************************************;					longa	on					longi	on;					php					rep		#$30				;m,x=0					and		#$00FF				;low byte only					cmp		#identify_msg		;check for identify message type					bcs		msg_ok					cmp		#sdata_follows		;check if greater than msg $0C (i.e. $0D sense data follows)					bcc		msg_ok					plp							;restore m,x					sec							;bad news					bcs		exitmsg_ok				plp							;restore m,x					clcexit				rts							;>>>--- validate_msg --->>>;					ENDP						EXPORT	touthandlertouthandler			PROC********************************************************************************	This module will check for tasks which may be pending and have timed*	out.  The routine walks the SDR list and checks if the busy bit is set.*	If the bit is set then it decrements the timeout count.  If the count*	rolls to zero, the busy bit will be reset and a timeout error will be*	reported to the caller.**	ENTRY:	e,m,x = 0*		All registers saved & restored*		NOTE: ENTRY to this routine is made through an interrupt*		      from a previously installed heartbeat task.**	Exit:	e,m,x = 0*		C = 1 if timeout has occurred*		A = timeout error code*		X = Low word of SDR*		Y = High word of SDR**********************************************************************************;;;	HeartBeat task header;					EXPORT	tout_header					EXPORT	tick_count;tout_header	dc.l	$00000000					;room for link pointertick_count	dc.w	$0000						;tick count before irq					dc.w	$A55A				;manual is wrong A55A signature correct;;	save environment we will be playing with;timeout				php							;save m,x					longa	on					longi	on					rep		#$30				;m,x=0					pha							;save registers					phx					phy					phd							;save direct register;;	point to our zero page;					lda		|zpg_hold					clc							;point to SCSI Manager zero page					adc		#driver_zpg_size					pha					pld;;	check for SDR Busy bit set;					ldy		#sdr_flags					lda		[active_sdr],y					and		#sdr_attrb_busy					beq		exit;;	SDR is busy decrement timeout count & check for zero;					jsr		getticks					sta		|tick_count			;tick count before next irq					bne		exit;;	go tell driver the call it issued timed out;					ldy		#sdr_completion_vect;call the intercomm vector					lda		[active_sdr],y		;get address of completion vector					sta		calldvr+1			;form jsl address					iny					lda		[active_sdr],y					sta		calldvr+2;;	mark SCSI Manager busy so drivers can not issue another call now;	then notify driver of the timeout.;					lda		|smbusy_flag		;save current setting of SCSI Manager busy flag					pha					lda		#busy					sta		|smbusy_flag					lda		#calltout_err		;tell driver its call timed out					sec					sta		|error_stat			;and keep error for future referencecalldvr				jsl		$000000				;**** SELF MODIFYING CODE					jsr		clear_state			;remove this scsi transaction					dec		|busy_sdr_count		;one less busy SDR					ldy		#sdr_flags					lda		[active_sdr],y					and		#sdr_attrb_busy\							--$FFFF				;clear busy bit in attribute word					sta		[active_sdr],y;;	restore state of SCSI Manager busy flag;					pla					sta		|smbusy_flag;;	all done set for next interrrupt (0000 is possible) and go away;exit				pld							;restore direct register					ply					plx					pla					plp							;restore m,x					xce					rtl							;>>>--- tout_handler --->>>;					ENDP;					EJECT					EXPORT	clear_stateclear_state			PROC*************************************************************************************	This routine will remove a pending task which has timedout.  It clears the*	work variables within the SCSI Manager record (SDR) removes the task from*	the SCSI bus and returns an error to the caller.**	ENTRY:	e,m,x = 0*		[sdr_ptr] points to the record to discard**	Exit:	e,m,x = 0*		A,X,Y undefined*************************************************************************************;					longa	on					longi	on;;;	save some scsi manager internals;					lda		<io_offset+2					pha					lda		<io_offset					pha;;	point to the I/O space corresponding to this SDR;					ldy		#sdr_5380_base					lda		[active_sdr],y					sta		<io_offset					tax							;I/O index register					ldy		#sdr_5380_base+2					lda		[active_sdr],y					sta		<io_offset+2;;	 send abort message to the target;					lda		#abort_msg			;setup message out byte in case end up in msgout phase					sta		|msg_out_byte					lda		#attention					jsr		set_icmd					lda		#msg_out_phase					jsr		wait_for_phase					bcs		@75					bvs		@75					;phase changed to other than requested;;	send the abort byte to the target right now!;					ldx		<io_offset			;point to proper io location					lda		#attention				;clear the attention bit					jsr		res_icmd					lda		#abort_msg				;send the abort message					jsr		osend_byte					bra		@85;;	if "wait for phase" timed out reset the bus;@75					jsr		bus_reset@85					ldx		<io_offset					lda		#invalid_phase1					sta		>targcmdreg,x;;	toggle 5380 DMA enable bit to allow req to come through;					longa	off					sep		#$20				;m=1					lda		#dmaenable					eor		>modereg,x					sta		>modereg,x					eor		>modereg,x					sta		>modereg,x					longa	on					rep		#$20				;m=0					jsr		cleanup_sdr@100				pla					sta		<io_offset					pla					sta		<io_offset+2					stz		|more_phases		;forces exit in phase handler					rts;					ENDP					EJECT					EXPORT	cleanup_sdrcleanup_sdr			PROC**********************************************************************************	This routine will reset working parameters in the SDR back to zero.**	ENTRY:	e,m,x = 0*		[sdr_ptr] := address of SDR to cleanup**	Exit:	e,m,x = 0*		A,Y trashed**********************************************************************************;					longa	on					longi	on;;	cleanup the timeout field;					lda		#$0000					ldy		#sdr_timeout					sta		[sdr_ptr],y					ldy		#sdr_timeout+2					sta		[sdr_ptr],y;;	clear completion vector;					ldy		#sdr_completion_vect					sta		[sdr_ptr],y					ldy		#sdr_completion_vect+2					sta		[sdr_ptr],y;;	clear the command field pointer;					ldy		#sdr_cmd_ptr					sta		[sdr_ptr],y					ldy		#sdr_cmd_ptr+2					sta		[sdr_ptr],y;;	clear the data chaining instructions pointer;					ldy		#sdr_cmd_ptr					sta		[sdr_ptr],y					ldy		#sdr_cmd_ptr+2					sta		[sdr_ptr],y;;	clear the buffer pointer and byte count;					ldy		#sdr_buffer_ptr					sta		[sdr_ptr],y					ldy		#sdr_buffer_ptr+2					sta		[sdr_ptr],y					ldy		#sdr_byte_count					sta		[sdr_ptr],y					ldy		#sdr_byte_count+2					sta		[sdr_ptr],y					rts							;>>>--- cleanup_sdr --->>>;					ENDP					EJECT					EXPORT	adjtoutadjtout				PROC**********************************************************************************	This routine will convert the 1/4 second timeout count passed by the*	caller into 1/60 second tick count.  The routine also adds the current*	tick count to the calculated 1/60 sec timeout count and returns it in*	a pair of registers.**	ENTRY:	e,m,x = 0*		A = 1/4 sec timeout value**	Exit:	e,m,x = 0*		A = low word of 1/60th sec timeout count*		X = high word of 1/60th sec timeout count**********************************************************************************;;					longa	on					longi	on;					pha							;save 1/4 sec count					stz		scratchzpg			;work area					stz		scratchzpg+2					clc					asl		A					;times 16					rol		<scratchzpg+2					asl		A					rol		<scratchzpg+2					asl		A					rol		<scratchzpg+2					asl		A					rol		<scratchzpg+2					sec					sbc		1,s					;but we really want times 15					sta		<scratchzpg					lda		<scratchzpg+2					sbc		#$0000					plx							;discard 1/4 set count off the stack					tax					lda		<scratchzpg					rts								;>>>--- adjtout --->>>;					ENDP;					EJECTsaveptrs			PROC***********************************************************************************	This routine will do a save pointers in the data chaining instructions.*	For Buffer addresses it copies the address into the save pointer field.*	For Loop instructions, it copies the loop count into the save pointer.**	ENTRY:	e,m,x = 0*		[sdr_ptr] points to parameter list containing data chain*			  instructions to do save pointers on.**	Exit:	e,m,x = 0*		A = trashed*		scratchzpg:= address of data chaining instructions***********************************************************************************;					longa	on					longi	on;;	point to the data chaining instructions;					phy							;save work registers					phx					ldy		#sdr_plist_ptr		;get the address of the parameter list					lda		[sdr_ptr],y					tax					ldy		#sdr_plist_ptr+2					lda		[sdr_ptr],y					sta		<scratchzpg+2					stx		<scratchzpg					ldy		#plst_dchainptr		;get the pointer to the data chain instructions					lda		[scratchzpg],y					tax					ldy		#plst_dchainptr+2					lda		[scratchzpg],y					sta		<scratchzpg+2		;point to opcode field of data chain instruction					stx		<scratchzpg					sta		<temp1+2			;point to save ptr area of data chaining instruction					txa					clc					adc		#dci_save					sta		<temp1	;;	save pointers until stop instruction (max of 32 instructions including stop);					ldy		#$0000				;point to start of data chain instructions listmovloop				lda		[scratchzpg],y		;get the instruction					tax							;save low word of instruction					iny					iny					ora		[scratchzpg],y					beq		exit				;if stop instruction go away					cmp		#$FFFF				;check for loop instruction					beq		movlcnt				;if loop instruction move loop count					lda		[scratchzpg],y		;high word of buffer address					sta		[temp1],y			;save in high word of save area					dey					dey					lda		[scratchzpg],y		;low word of buffer address					sta		[temp1],y			;to save areanxtdci				tya					clc					adc		#dci_size			;bump to next data chain instruction					tay					bra		movloop				;do next instruction;;	instruction was a loop instruction move the loop count;movlcnt				iny							;bump to the loop count field					iny					lda		[scratchzpg],y		;get the loop count					tax							;save low word of loop count					iny					iny					lda		[scratchzpg],y		;get the high word of the count					dey							;point back to the loop instruction opcode					dey					dey					dey					sta		[temp1],y			;save the high word of the loop count					dey					dey					txa					sta		[temp1],y			;save the low word of the loop count					bra		nxtdci				;Y points at the start of instruction;exit				plx							;restore registers					ply					rts							;>>>--- saveptrs --->>>;					ENDP						EJECTckdcilst			PROC*********************************************************************************	This routine will validate that there are a maximum of 32 data chaining*	instructions and that the last instruction is a stop instruction.**	ENTRY:	e,m,x = 0**	Exit:	scratchzpg trashed*		A = undefined*********************************************************************************;					longa	on					longi	on;;	point to data chain instruction list;					phx					phy					ldy		#plst_dchainptr					lda		[plist_ptr],y					sta		<scratchzpg					ldy		#plst_dchainptr+2					lda		[plist_ptr],y					sta		<scratchzpg+2;;	walk the list looking for stop instructions;					ldx		#maxdcis+1			;max # of DC Cmds + 1 for DCStop					ldy		#$0000@100				clc							;assume we find a stop inst within 32 instructions					lda		[scratchzpg],y					iny					iny					ora		[scratchzpg],y					beq		exit					dey							;back down to low word of opcode					dey					sec							;assume we will fail at this point					dex							;decrement instruction count remaining					beq		exit				;if zero then exit with error					tya							;point to next instruction					clc					adc		#dci_size					tay					bra		@100exit				ply					plx					rts							;>>>--- ckdcilst --->>>;					ENDP					EJECT					EXPORT	getnextidgetnextid			PROC*******************************************************************************Getnextid:	This routine will return the next ID available for devices on*		the slot number specified in the accumulator.  The slot number*		will be truncated to a value between $00 and $0F.**		ENTRY:	e,m,x = 0*			A = slot number**		Exit:	e,m,x = 0*			A = ID number*******************************************************************************;					longa	on					longi	on;					phx							;save work registers					and		#$000F				;truncate the slot number to $00-$0F					tax					sep		#$20				;m=1					inc		|slot_table,x		;bump to next available ID					lda		|slot_table,x		;next available ID for this slot					rep		#$20				;m=0					plx							;restore work registers					rts							;>>>--- getnextid --->>>;slot_table			dc.w	$0000				;a table of 16 one byte entries (slots 0-F)					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000					dc.w	$0000;					ENDP;					EJECT					EXPORT	zap_oldcardzap_oldcard			PROC***********************************************************************	This module will reset some parameters kept in the OLD SCSI*	card's ram.  This will force the card to rebuild its tables (SDATS)*	when control is passed to PRODOS 8.**	ENTRY:	e,m,x = 0**	Exit:	e,m,x = 0*		A = $0001***********************************************************************;;					longa	on					longi	on;;	save work registers for later restore;					phx					phy;;	reset I/O Strobe memory ($C800-$CFFE) and turn on this cards I/O strobe space;					lda		>io_stbreset		;access $CFFF (reset I/O strobe space)					ldy		#sdr_slot			;get the slot number					lda		[sdr_ptr],y					and		#slot7				;mask off the external slot bit					xba							;times $100					tax							;access $CNXX space to turn on I/O strobe space					lda		>io_space,x			;for this card;;	point to bank $00 of the old card's ram;					ldy		#sdr_5380_base		;point to card DEV-SEL space					lda		[sdr_ptr],y					tax					lda		#$0000				;point to card's bank zero rom and bank zero ram					sep		#$20				;m=1					sta		>ocard_breg,x					rep		#$20;;	zero out working parameters in the cards ram (forces tables reinit);					lda		#0000					sta		>scsi_init			;clear init flag					sta		>sdat_start			;clear SDAT ID's					sta		>sdat_start\							+dibtab_len*1					sta		>sdat_start\							+dibtab_len*2					sta		>sdat_start\							+dibtab_len*3					sta		>sdat_start\							+dibtab_len*4					sta		>sdat_start\							+dibtab_len*5					sta		>sdat_start\							+dibtab_len*6					sta		>dibtab_start		;clear dibtab ID's.					sta		>dibtab_start\							+dibtab_len*1					sta		>dibtab_start\							+dibtab_len*2					sta		>dibtab_start\							+dibtab_len*3					sta		>dibtab_start\							+dibtab_len*4					sta		>dibtab_start\							+dibtab_len*5					sta		>dibtab_start\							+dibtab_len*6					inc		A					sta		>gs_flag			;force GS_flag true (nonzero)					ply					plx					rts							;>>>--- exit zap_oldcard --->>>;					ENDP					END					EJECT	