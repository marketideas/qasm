		INCLUDE	'Loader.Preamble'header_length	EQU	$30zloader_start	EQU	Loader_Entryzloader_org	EQU	Loader_EntryzloaderLC_start	EQU	Loader_LC_Start;===============================================================================; zloader;; Framework for building load segment zloader.;;===============================================================================		SEG	'Loader'zloader_header	PROC	ORG zloader_org-header_length		IMPORT	zloader_end		MSB	ON		DC.W	zloader_end-zloader_start		DC.L	zloader_org		DC.W	0000		DC.B	'System Loader         v04.02'		DC.B	00		if	(*-zloader_header)<header_length then		dcb.b	header_length-(*-zloader_header),0		endif		MSB	OFF		ENDP		SEG	'Loader_LC'zloader_lc_header Proc	org zloaderLC_start-header_length		IMPORT	zloaderLC_end		MSB	ON		DC.W	zloaderLC_end-zloaderLC_start		DC.L	Loader_LC_Start		DC.W	0000		DC.B	'System Loader,Pt 2    v04.00'		DC.B	00		if	(*-zloader_lc_header)<header_length then		dcb.b	header_length-(*-zloader_lc_header),0		endif		MSB	OFF		EndP		END