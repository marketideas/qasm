		TITLE	', INIT.LOAD.a - myInitLoad'*******************************************************************               private Initial Load subroutine*               separated from main InitialLoad routines to*               solve reentrancy problems.**  Inputs:      (already stored in input_parms)*               UserID (2 bytes)*               Address of Load File Pathname (4 bytes)*               Special Memory Flag (2 bytes)*               Input Type (2 bytes)*  Outputs:     UserID (2 bytes)*               Starting Address (4 bytes)*               Address of Direct Page/Stack (2 bytes)*               Size of Direct Page/Stack (2 bytes)*  Errors:      $0000 - Operation successful*               $1102 - OMF Version error*               $1104 - File not Load File*               $1108 - UserID error*               $1109 - SegNum out of sequence*               $110A - Illegal load record found*               $110B - Load Segment is foreign*               $02xx - Memory Manager error*               $00xx - ProDOS I/O error******************************************************************myInitLoad	Proc		with	DirectPage, Globals		Import	delete_user_id,close_dynamic_file, \		expand_path,open_load_file,check_express_seg,  \		alloc_id,			get_express_seg, load_statics, save_start, \		find_user_id,			Setup_Buf_PtrsIType		equ	input_parms		;input TypeISpecial	equ	IType+2			;input Special Memory FlagIAddress	equ	ISpecial+2		;input Address of Load File NameIUserID		equ	IAddress+4		;input UserIDOUserID		equ	3			;output UserID (allow for return address)OAddress	equ	OUserID+2		;output Load AddressOZP_Addr	equ	OAddress+4		;output Direct Page/Stack AddressOZP_Size	equ	OZP_Addr+2		;output Direct Page/Stack Size		jsr	InitInit		;common initialize;;        initialize output variables;		lda	#0		sta	OAddress,s		;output Load Address		sta	OAddress+2,s		sta	OZP_Addr,s		;output Direct Page/Stack Address		sta	OZP_Size,s		;output Direct Page/Stack Size		lda	IType			;get the input type		beq	@old_style		;type 0 means class 0 pathname supplied		cmp	#$0001			;see if this is a pathname load		beq	@do_expand		;this is a class 1 string		jmp	old_loader		;else must be a System Loader call;;Now we need to do an Expand Path on the Input name.;@old_style		lda	IAddress		;get the pointer to the pathname		ldy	IAddress+2		ldx	#0			;convert type 0 to type 1		jsr	Convert_Pathname		lda	TempBuff		;get pointer to converted pathname		ldy	TempBuff+2		bra	@expand_it@do_expand		lda	IAddress		ldy	IAddress+2@expand_it		jsr	Expand_Pathname		;perform an ExpandPath call		bcs	@error_exit		lda	TempBuff		sta	PathnamePtr		lda	TempBuff+2		sta	PathnamePtr+2		jsr	open_load_file		;open the file please		bcs	@error_exit		lda	IUserID			;go and get the user ID		jsr	alloc_id		bcs	@skip_to_error		;pass the error back to the caller		sta	OUserID,s		and	#$F000		cmp	#Application		bne	@not_app		inc	Keep_Open@not_app		jsr	check_express_seg	;see if this is an expressload file		bcc	@its_expressed		jsr	Setup_Buf_Ptrs		jmp	old_loader_continue	;call the standard loader and let it try;;At this point all errors that we encounter must be returned to the caller since the file is mine.;@its_expressed						;setup the special memory flag		lda	ISpecial		sta	spec_mem_flag		;user's preference		jsr	get_express_seg		;load in the express load segment@skip_to_error		bcs	@error_exit		;pass the error back to the caller		jsr	load_statics		;load all the static segments		bcs	@dispose_exit		;pass the error back to the caller		jsr	save_start		;save starting address and stack info		lda	stack_size		;return the correct parameters		sta	OZP_Size,s		lda	stack_addr		sta	OZP_Addr,s		lda	starting_addr+2		;address of the Application		and	#$00FF		sta	OAddress+2,s		lda	starting_addr		sta	OAddress,s		lda	|USERID		sta	OUserID,s		pea	uTempBuff		;UserID		_DisposeAll			;dispose of temporary memory		lda	#$0000@error_exit		rts				;we were successful!!; this is used when an error occurs after loading at least one segment into memory.; in this case, we must do a pseudo-userShutdown to clean up memory and dispose of; the user ID.@dispose_exit		pha				;save the error code		lda	|USERID		jsr	find_user_id		;get pointer to user_id_table		ldy	#ID_Table_Entry.ExpressHandle		lda	[temp_ptr],y		;get the ExpressLoad handle		sta	ExpressHandle		iny		iny		lda	[temp_ptr],y		sta	ExpressHandle+2		jsr	close_dynamic_file	;close file if any segments were dynamic		lda	temp_ptr		;setup the User_ID pointer to point to the entry		sta	user_id_ptr		lda	temp_ptr+2		sta	user_id_ptr+2		pha				;space for handle		pha		pei	user_id_ptr+2		;lock down the user ID table		pei	user_id_ptr		_FindHandle		lda	3,s			;duplicate the handle on the stack		pha		lda	3,s		pha		_HLock		lda	#nuke_id		;delete the ID and the memory		jsr	delete_user_id		;remove the user_id please		_HUnlock			;unlock the user ID table		pea	uTempBuff		;UserID		_DisposeAll			;dispose of temporary memory		pla				;restore error code		rts		entry	type3_InitLoadold_loader;;        if Input Type is 3, get UserID from Pathname Table;		cmp	#3		bne	cont1type3_InitLoad		ldy	#PT_UserID		lda	[IAddress],y		sta	|USERID		bra	cont3;;        if Main ID field of input UserID is not 0, use UserID as is;cont1		lda	IUserID			;go and get the user ID		jsr	alloc_id		bcc	@1		jmp	Error_Exit@1;;       set Keep Open flag if UserID is an Application type;cont3		tax				;save in X for a bit		and	#$F000		cmp	#Application		bne	cont3a		inc	Keep_Open;;       if Input Type is 4, use the Loader's internal Resource UserID;cont3a		txa		sta	OUserID,s		;save original UserID (with changes) as output		lda	IType		cmp	#4		bne	cont5		ldx	#uResourcecont5		stx	|USERID			;save in global USERID;;        load IAddress into A,Y and point Open packet to a null string;		lda	#<zero		sta	|POpen.pathname		lda	#^zero		sta	|POpen.pathname+2		lda	IAddress		ldy	IAddress+2;;        check Input Type;		ldx	IType;;        Input Type=2 or 4, set Memory Load Flag, and go right to Open;		cpx	#2		beq	cont6		cpx	#4		bne	cont7;;       Input type must be 2 or 4 here;cont6		inc	Memory_Load		phy		pha		bra	cont10;;        Input Type=3, get pathname from Pathname Table;cont7		clc		adc	#PT_Path		sta	TempZero		bcc	@1		iny@1		sty	TempZero+2		phy		pha;;        open file;cont10		lda	#0			;no time/date stamp		pha		pha		pha		pha		jsr	Open_File		bcs	error_skipold_loader_continue;;        do pass 1;		stz	Pass			;Loader pass		stz	Pass2_Needed		;Pass2 Needed flag		stz	|Header_Mark		;set mark to 1st Segment Header		stz	|Header_Mark+2		stz	FirstMemSeg		;set first Memory Segment entry to 0		stz	FirstMemSeg+2		stz	Segment_Skipped		;clear Segment Skipped flag		ldx	IType			;if Input Type 3, use File Number		lda	#1			;  from Pathname Table		cpx	#3			;otherwise use 1		bne	cont11		ldy	#PT_FileNum		lda	[IAddress],ycont11		sta	CFileNum		lda	#1		sta	CSegNum			;set Segment Number to 1;;       Add the pathname to the pathname table.  We'll fill in the starting and;       direct page addresses after we get the segments into memory.;		cpx	#3			;X still contains IType		bcs	loop1		lda	|USERID			;UserID		pha		pea	1			;File Number		lda	|POpen.modDateTime+6	;mod_date		pha		lda	|POpen.modDateTime+4		pha		lda	|POpen.modDateTime+2		pha		lda	|POpen.modDateTime		pha		lda	#0			;Direct Page and Starting Address		pha				;will get filled in after we get the		pha				;segments loaded		pha		pha		lda	|POpen.pathname+2	;address of File Name		pha		lda	|POpen.pathname		pha		jsr	Add_Pathnameerror_skip		bcs	error_skip_2;;        read next Segment Header;loop1		jsr	Next_Header		bcc	cont14			;if no error, continue		cmp	#NoFind			;is mark past EOF?		bne	error_skip_2		;no, real errorcont12		jmp	end_pass1		;pass is done;;        if this segment is Dynamic, skip it;cont14		lda	Header.Kind		bpl	cont15			;dynamic bit is bit 15skip_it		inc	Segment_Skippedeloop2		inc	CSegNum			;(copied from eloop1)		bra	loop1			;repeat;;        if this segment is a Skip Segment, skip it;cont15		bit	#Skip_Segment		bne	skip_it;;        if this segment is a Library Dictionary Segment, skip it;cont16		and	#$1F		cmp	#Lib_Segment		beq	eloop2;;        process segment;		stz	CAddress		;set Segment Address to 0		stz	CAddress+2		ldx	ISpecial		jsr	Do_Segment		bcc	_1error_skip_2		jmp	Error_Exit_1;;       if Input Type is 4, change UserID of Segment to original UserID;		lda	IType		cmp	#4		bne	cont17		pha				;output Handle		pha		lda	Header.Org+2		;Address of Segment		pha		lda	Header.Org		pha		_FindHandle			;get Handle to Segment		plx		ply		stx	Handle			;output Handle		sty	Handle+2		bcs	error_skip_2		lda	OUserID,s		ldy	#6		sta	[Handle],y;;        if this segment is an Initialization Segment, process it;cont17		lda	Header.Kind		;KIND field		and	#$1F			;extract type		cmp	#Init_Segment		;is it Initialization type?		bne	cont18		lda	Header.Org		ldy	Header.Org+2		jsr	Do_Init_Segment		bra	eloop1;;        if this segment is the Direct Page/Stack segment, get its info;        for ZP_Addr and ZP_Size;cont18		cmp	#Direct_Segment		bne	cont18a		lda	Header.Org		sta	OZP_Addr,s		lda	Header.Length		sta	OZP_Size,s		bra	eloop1;;        if the output Load Address is still 0, use load address in current;        segment as OAddress;cont18a		lda	OAddress,s		ora	OAddress+2,s		bne	eloop1		lda	Header.Org		clc		adc	Header.Entry		sta	OAddress,s		lda	Header.Org+2		adc	Header.Entry+2		sta	OAddress+2,s;;        increment current Segment Number;eloop1		inc	CSegNum		jmp	loop1			;repeat;;       pass 1  is finished;;       if Keep_Open flag is set and there were no skipped;       segments or input type is not 3, clear Keep_Open flag;end_pass1	lda	Keep_Open		beq	cont19		lda	IType		cmp	#3		beq	cont20		lda	Segment_Skipped		bne	cont19		stz	Keep_Open;;       if not Input Type 3 or 4, fill in Direct Page and Starting Address;       entries in the Pathname Table;cont19		lda	IType		cmp	#3		bcs	cont20		lda	|USERID			;UserID		pha		pea	1			;File Number		lda	|POpen.pathname+2	;address of File Name		pha		lda	|POpen.pathname		pha		jsr	Find_Pathname		;find the pathname entry		bcc	@got_it			;so far, so good		phk				;restore DBR		plb		bcs	Error_Exit		;not found?  Somethin's wierd!@got_it		lda	OZP_Addr,s		;Direct Page/Stack Address		sta	|PT_ZP_Addr,x		;store into pathname table entry		lda	OZP_Size,s		;Direct Page/Stack Size		sta	|PT_ZP_Size,x		lda	OAddress+2,s		;Starting Address		sta	|PT_Address+2,x		lda	OAddress,s		sta	|PT_Address,x		phk				;restore DBR		plb;;        dispose of Temporary Buffer;cont20		pea	uTempBuff		;UserID		_DisposeAll;;        check whether another pass is needed;		lda	Pass2_Needed		;is pass 2 needed?		beq	cont21;;        another pass is needed, do pass 2;		inc	Pass;;        position file at Relocation Dictionary in current Segment;		lda	#0			;output Offset		pha		pha		pea	ML_FirstEntry>>16	;Offset of 1st entry		pea	|ML_FirstEntryloop2		jsr	Next_Dictionary		plx				;output offset		ply		bcs	Error_Exit;;        if CSegNum=0, there are no more entries in Mark List;		lda	CSegNum		beq	cont21;;        process Segment;		phy				;save next Mark List Offset		phx		ldx	ISpecial		jsr	Do_Segment		plx				;Mark List Offset		ply		bcs	Error_Exit		lda	#0			;output OffSet		pha		pha		phy				;Mark List Offset		phx		bra	loop2;;       if Input Type 4, remove all entries for this Resource from the Memory Segment Table;cont21		lda	IType		cmp	#4		bne	return		lda	|USERID			;UserID		pha		pea	SEGTBL>>16		;Memory Segment Table		pea	|SEGTBL		jsr	Remove_UserIDreturn		lda	#0zero		equ	return+1		;location containing zero;;        exit cleanup;Error_Exit	pha				;save status;;        close file;		jsr	Close_File;;        dispose of Mark List;		pea	uMarkList		;UserID		_DisposeAll;;        dispose of temporary buffers;		pea	uTempBuff		;UserID		_DisposeAll;;        if an error occurred, and not Input Type 3, do complete shutdown of userid;		lda	1,s			;retrieve status from stack		beq	cont22			;no errors!		lda	IType		cmp	#3		beq	cont22		pha				;make space for output UserID		lda	|USERID			;input UserID		sta	input_parms+2		;set up direct page for UserShutdown call		stz	input_parms		;Quit Flag		jsr	myUserShutdown		;make the call		pla				;remove output UserIDcont22		pla				;restore status		rts				;back to caller		EndP		TITLE	', INIT.LOAD.a - InitLoad'*******************************************************************              Initial Load ($09)**  Inputs:     UserID (2 bytes)*              Address of Load File Pathname (4 bytes)*              Special Memory Flag (2 bytes)*  Outputs:    UserID (2 bytes)*              Starting Address (4 bytes)*              Address of Direct Page/Stack (2 bytes)*              Size of Direct Page/Stack (2 bytes)*  Errors:     $0000 - Operation successful*              $1102 - OMF Version error*              $1104 - File not Load File*              $1108 - UserID error*              $1109 - SegNum out of sequence*              $110A - Illegal load record found*              $110B - Load Segment is foreign*              $02xx - Memory Manager error*              $00xx - ProDOS I/O error******************************************************************InitLoad	PROC		LoadSegCheck		with	DirectPage, Globals		ldx	#func_9_param_cnt	;get the number of parameters of the stack		jsr	get_parametersISpecial	equ	input_parms		;input  Special Memory FlagIAddress	equ	ISpecial+2		;input  Address of Load File NameIUserID		equ	IAddress+4		;input  UserIDOUserID		equ	1			;output UserIDOAddress	equ	OUserID+2		;output Load AddressOZP_Addr	equ	OAddress+4		;output Direct Page/Stack AddressOZP_Size	equ	OZP_Addr+2		;output Direct Page/Stack Size;;       translate the call into an InitialLoad2 call internally;		ldx	#IUserID-ISpecial	;move input parameters to correct locations@loop		lda	ISpecial,x		;get a word		sta	ISpecial+2,x		;and move it		dex		dex		bpl	@loop			;until all moved		stz	ISpecial		;make this a type 0 InitialLoad2 call		jsr	myInitLoad		;call the real workhorse		jmp	return_to_caller	;back to application		ENDP		TITLE	', INIT.LOAD.a - InitLoad2'*******************************************************************              Initial Load 2 ($20)**  Inputs:     UserID (2 bytes)*              Address of Load File Pathname (4 bytes)*              Special Memory Flag (2 bytes)*              Input Type (2 bytes)*  Outputs:    UserID (2 bytes)*              Starting Address (4 bytes)*              Address of Direct Page/Stack (2 bytes)*              Size of Zero Page/Stack (2 bytes)*  Errors:     $0000 - Operation successful*              $1102 - OMF Version error*              $1104 - File not Load File*              $1108 - UserID error*              $1109 - SegNum out of sequence*              $110A - Illegal load record found*              $110B - Load Segment is foreign*              $02xx - Memory Manager error*              $00xx - ProDOS I/O error**  Input Type - 0 Pathname is Type 0 Pathname*               1 Pathname is Type 1 Pathname*               2 Address points to a packet containing:**                   Starting Address of In Memory Load  File (4 bytes)*                   Length  of In Memory Load File (2 bytes)**               3 Address points to a Pathname Table entry*               4 Address points to a packet containing:**                   Starting Address of Code Resource in memory (4 bytes)*                   Length of Code Resource (2 bytes)**   The Load File is kept open if:**       The UserID has Application type AND*       Input Type is 3 OR*       Some Load Segments were skipped (dynamic or skip)******************************************************************InitLoad2	PROC	Export		LoadSegCheck		ldx	#func_20_param_cnt	;get the number of parameters of the stack		jsr	get_parameters		jsr	myInitLoad		;call the _real_ InitialLoad function		jmp	return_to_caller		ENDP		TITLE	', INIT.LOAD.a - InitInit'*******************************************************************              Initial Load and Restart Initialization******************************************************************InitInit	PROC		with	DirectPage, Globals;;        initialize globals;		stz	|USERID			;global USERID;;        initialize zero page variables;		stz	Memory_Load		;clear Memory Load flag		stz	Keep_Open		;clear Keep Open flag;;        cleanup Loader tables;		pea	0			;all UserID's		jsr	Cleanup		rts		ENDP