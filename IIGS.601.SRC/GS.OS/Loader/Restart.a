		TITLE	', RESTART.a - Restart'*******************************************************************              Restart ($0A)**  Inputs:     UserID (2 bytes)*  Outputs:    UserID (2 bytes)*              Starting Address (4 bytes)*              Address of Zero Page/Stack (2 bytes)*              Size of Zero Page/Stack (2 bytes)*  Errors:     $0000 - Operation successful*              $1101 - Application not found*              $1108 - UserID error*              $00xx - ProDOS I/O error*              $02xx - Memory Manager error******************************************************************Restart		PROC		LoadSegCheck		with	DirectPage, Globals		Import	find_user_id,merge_path,lock_statics, \			remove_segment,open_load_file,load_statics, \			close_load_file,save_start,save_dp,restore_dp, \			delete_user_id,zero_handles,check_express_seg,get_express_seg		ldx	#func_0A_param_cnt	;get the number of parameters of the stack		jsr	get_parametersIUserID		equ	input_parms		;input  UserIDOUserID		equ	1			;output UserIDOAddress	equ	OUserID+2		;output Load AddressOZP_Addr	equ	OAddress+4		;output Zero Page/Stack AddressOZP_Size	equ	OZP_Addr+2		;output Zero Page/Stack Size		lda	IUserID			;lets see if we know about this user ID		jsr	find_user_id		;If found temp_ptr setup		bcc	@continue		brl	old_loader		;not my job@continue;;At this point all errors that we encounter must be returned to the caller since the file is mine.;		ldy	#ID_Table_Entry.ExpressHandle		lda	[temp_ptr],y		;get the ExpressLoad handle		tax		iny		iny		lda	[temp_ptr],y		tay		bne	@have_handle		txa		bne	@have_handle		;we have the handle		lda	#ExpressSegLost		sec		jmp	@error_exit		;report error to the caller.@have_handle		jsr	merge_path		;we now have the expanded ExpressLoad pathname		jsr	chk_mod_date		;make sure the file hasn't changed		bne	@must_reload		;it's changed, reload the whole thing		jsr	lock_statics		;lock the static segments please		bcs	@must_reload		;something got purged...		jsr	kick_start		bcs	@error_exit		;report error to the caller.		bra	@clean_exit;;If we get here we need to remove the old info and reload the application from disk;@must_reload		ldy	#4			;lock the ExpressSeg handle		lda	[ExpressHandle],y		ora	#$8000		sta	[ExpressHandle],y		lda	#purge_all		;remove all segments		ldx	#$0000			;LOAD flags AND mask COMPARE value BEQ REMOVE_IT		jsr	remove_segment		;deallocate the segments		lda	PathnamePtr		;make a copy of the pathname		ldy	PathnamePtr+2		jsr	Expand_Pathname		lda	TempBuff		;copy pointer to PathnamePtr		sta	PathnamePtr		lda	TempBuff+2		sta	PathnamePtr+2				lda	#keep_id		;indicate that we must keep the ID		jsr	delete_user_id		jsr	zero_handles		;reset everything		jsr	open_load_file		;open the file		bcs	@error_exit		jsr	check_express_seg	;read ExpressLoad segment header in		bcs	@error_exit		;just in case...		jsr	get_express_seg		;load the ExpressLoad segment		bcs	@error_exit		;report error to the caller				stz	spec_mem_flag		;allow special memory if necessary		jsr	load_statics		;load all the static segments		php				;save carry		pha				;save possible error code		jsr	close_load_file		;close the file and restore sys_prefs		pea	uTempBuff		;dispose of temporary pathname		_DisposeAll		pla				;restore error code		plp				;restore carry		bcs	@error_exit		;report error to the caller.@clean_exit		jsr	save_start		lda	stack_size		;return the correct parameters		sta	OZP_Size,s		lda	stack_addr		sta	OZP_Addr,s		lda	starting_addr+2		;address of the Application		and	#$00FF		sta	OAddress+2,s		lda	starting_addr		sta	OAddress,s		lda	|USERID		sta	OUserID,s		lda	#$0000@outta_here		jmp	return_to_caller	;we were successful!!@error_exit		ldx	IUserID		bne	@outta_here		;If the user_id was zero let Lou try.old_loader		jsr	InitInit		;common initialize;;        initialize output variables;		lda	#0		sta	OAddress,s		;zero output address		sta	OAddress+2,s;;        if Main ID field of input UserID is 0, error;		lda	IUserID		and	#$FF		bne	cont1		lda	#BadUser		bra	error_skip;;        look for Pathname Table entry corresponding to UserID;cont1		pei	IUserID			;UserID		lda	#1		pha				;FileNum		dec	a		pha				;Address of pathname (none)		pha		jsr	Find_Pathname		bcs	cont1a;;        extract data from Pathname Table entry;		lda	|PT_UserID,x		sta	OUserID,s		lda	|PT_ZP_Addr,x		sta	OZP_Addr,s		lda	|PT_ZP_Size,x		sta	OZP_Size,s		lda	|PT_Address,x		sta	OAddress,s		lda	|PT_Address+2,x		sta	OAddress+2,s;;        check if Pathname Table entry actually found;cont1a		phk		plb				;restore DBR		lda	#NoFind		bcc	_1error_skip		jmp	Error_Exit_1;;        UserID is known to System Loader, save as USERID;		lda	IUserID		sta	|USERID;;        extract pathname from Pathname Table entry;		jsr	Get_Pathname		bcs	error_skip;;        Counter will count # of dynamic segments encountered;		stz	Counter;;        zero handle to first Memory Segment Table entry;		stz	FirstMemSeg		stz	FirstMemSeg+2;;        set start of Memory Segment search to begining of Table;		lda	|SEGTBL		sta	Handle		lda	|SEGTBL+2		sta	Handle+2;;        search Memory Segment Table for Load File Segments for;        this UserID;loop1		lda	#0			;output Handle		pha		pha		pei	IUserID			;UserID		pha				;File Number (all)		pha				;Segment Number (all)		jsr	Next_MemSeg		;find next Load Segment		pla		sta	TempZero		;output Handle		pla		sta	TempZero+2;;        if entry found then:;;              1) if 1st entry found, set FirstMemSeg to entry handle;              2) process entry;;        if entry not found then:;;              1) if no entries found, application is incomplete;              2) if some entries found, application is complete;		lda	FirstMemSeg		ora	FirstMemSeg+2		;A=0 means no entries found yet		bcc	cont3		beq	cont2;;        entry not found but some have been found, application is complete;		jmp	complete		;no more, all found;;        entry not found and none have been found, application is incomplete;cont2		jmp	incomplete;;        entry found, if not first, process;cont3		bne	cont4;;        entry found and its the first, set FirstMemSeg to handle of entry;		lda	TempZero		sta	FirstMemSeg		lda	TempZero+2		sta	FirstMemSeg+2;;        if memory segment is for a dynamic segment, dispose it;        and if this is the first dynamic segment encountered,;        unload all Jump Table entries for this UserID;;        normally a dynamic segment would already be purged but;        if an application was not shut-down, dynamic segments;        are still in memory.  This will mess up the logic further;        on which makes all segments unpurgeable (i.e. static).;cont4		lda	|MS_Kind,x		bit	#Dyn_Segment		beq	cont6		phx				;save X		lda	|MS_Handle+2,x		pha		lda	|MS_Handle,x		pha		_DisposeHandle			;error is OK		plx				;restore X		stz	|MS_Handle,x		stz	|MS_Handle+2,x		lda	Counter			;is this first dynamic segment?		bne	cont5			;if not, skip unload JTL entries		lda	|MS_UserID,x		;UserID		pha		lda	#0		pha				;File Number (all)		pha				;Segment Number (all)		phk				;restore DBR		plb		jsr	Unload_JTLcont5		inc	Counter			;bump dynamic segment counter		bra	eloop1;;        check memory segment handle in entry to see if segment in memory.;cont6		lda	|MS_Handle,x		;if memory segment handle is 0,		ora	|MS_Handle+2,x		;  handle has been disposed		beq	cont7		lda	|MS_Handle,x		;memory segment handle		ldy	|MS_Handle+2,x		jsr	DeRef			;dereference		bcc	eloop1cont7		jmp	incomplete		;if NIL, Application incompleteeloop1		phk				;restore original DBR		plb		jmp	loop1;;        all segments appear to be in memory.  Lock and make all segments;        unpurgeable.;complete	phk				;restore DBR		plb;;        scan through segments again;;;        set start of Memory Segment search to FirstMemSeg;		lda	FirstMemSeg		sta	Handle		lda	FirstMemSeg+2		sta	Handle+2loop2		lda	#0			;output Handle		pha		pha		pei	IUserID			;UserID		pha				;File Number (all)		pha				;Segment Number (all)		jsr	Next_MemSeg		;find next Load Segment		pla		sta	TempZero		;output Handle		pla		sta	TempZero+2		bcc	cont8		jmp	cont10;;        if this segment is a Reload Segment, then reload it using same address;cont8		lda	|MS_Kind,x		bit	#Reload_Segment		beq	cont9		phx				;save X		phb				;save DBR		pei	Handle+2		;save Handle		pei	Handle		lda	#0			;output address		pha		pha		lda	|MS_UserID,x		;UserID		pha		lda	|MS_FileNum,x		;File Number		pha		lda	|MS_SegNum,x		;Segment Number		pha		lda	|MS_Handle,x		;memory segment handle		ldy	|MS_Handle+2,x		;memory segment handle		jsr	DeRef			;get memory address		phy		pha				;Segment Address		phk				;restore DBR		plb		jsr	Find_Segment		pla				;output address		pla				;(not used)		pla		sta	Handle			;restore Handle		pla		sta	Handle+2		plb				;restore DBR		plx				;restore X		bcc	eloop2error_skip_2		jmp	Error_Exit;;        if this segment is an Initialization Segment, execute it;cont9		and	#$1F		cmp	#Init_Segment		bne	eloop2		phx				;save X		lda	|MS_Handle,x		;handle to segment in memory		ldy	|MS_Handle+2,x		jsr	DeRef			;dereference handle (A,Y - address)		jsr	Do_Init_Segment		plx				;restore Xeloop2;;        lock and make purgeable handle to memory for Load Segment;		pea	0			;Purge Level (purgeable) for SetPurge call		lda	|MS_Handle+2,x		;Handle		pha		tay				;save for a bit		lda	|MS_Handle,x		pha		phy				;again for HLock call		pha		_HLock		_SetPurge		phk				;restore original DBR		plb		jmp	loop2cont10		phk				;restore DBR		plb;;        purge all other memory segments that are still floating around;		pei	IUserID			;UserID		_PurgeAll		lda	#0			;signify no error		bra	Error_Exit;;        not enough information is left in memory to restart the application.;incomplete	phk				;restore DBR		plb;;        do UserShutdown for UserID.  The ShutDown will look like a 'Reload';        shutdown except that the Pathname table is also purged of the UserID.;        So what we are actually doing is removing everything that has to do;        with the UserID except we are not removing the UserID itself. The;        reason we do not want to remove the UserID is that we are about to do;        an Initial Load with that UserID.;		jsr	save_dp			;save our direct page		pha				;make space for returned UserID		lda	IUserID			;set up direct page for private call		sta	input_parms+2		;UserID		lda	#$8000		sta	input_parms		;Quit Flag		jsr	myUserShutdown		;call private function		pla				;retrieve UserID returned from _UserShutdown		jsr	restore_dp		;restore direct page;;        remove UserID from Pathname Table (Shutdown didn't do this);		pha				;put UserID back on stack		pea	PATHTBL>>16		pea	|PATHTBL		jsr	Remove_UserID;;       if pathname is NULL (i.e. Memory Loaded file), exit with No Find error;		lda	TempBuff		ora	TempBuff+2		bne	cont11		lda	#NoFind		bra	Error_Exit;;        do InitialLoad;cont11; space is already on stack for return parameters;               lda     #0;               pha                             ;output UserID;               pha                             ;output Starting Address (0);               pha;               pha                             ;output Zero Page/Stack info (0);               pha		lda	IUserID			;fill in input_parms for InitalLoad		sta	input_parms+8		;UserID		lda	TempBuff+2		sta	input_parms+6		;buffer address		lda	TempBuff		sta	input_parms+4		stz	input_parms+2		;Special Memory flag		lda	#1		sta	input_parms		;Input Type		jsr	myInitLoad		;do the InitialLoad;;        error exit;Error_Exit	phk				;restore DBR		plb		pha				;save return status		pea	uTempBuff		;dispose of any temporary memory buffers		_DisposeAll		pla				;retrieve original return status		jmp	return_to_caller;-----------------------------------------------------------------------------------------kick_start		Import	chk_dynamic_seg,open_load_file,save_ref_num, \		make_HET_ptr,			reset_jmp_tables,reload_inits, \		reload_restart,			restore_start,close_load_file		stz	file_open		;indicate that the file is closed		stz	starting_addr		;reset all of our variables		stz	starting_addr+2		stz	stack_addr		;there is no stack		stz	stack_size		jsr	chk_dynamic_seg		;does the file contain any dynamic segments		bcs	@no_dynamics		jsr	open_load_file		;open the file please		bcs	@error_out		;report error to the caller.		jsr	save_ref_num@no_dynamics		jsr	make_HET_ptr		;make pointer to Header Entry Table		jsr	reset_jmp_tables	;delete any references to dynamic segments		jsr	reload_inits		;please restart any init segments		bcs	@error_out		jsr	reload_restart		;please reload any restart segments.		bcs	@error_out		jsr	restore_start		clc@error_out		php		pha		lda	file_open		;is the file open?		beq	@skip_close		jsr	close_load_file@skip_close		pla		plp		rts;====================================================================================================;chk_mod_date:	compares modification date of file (from GetFileInfo) against date;		stored within ExpressLoad segment in memory;chk_mod_date		Import	lock_handles,unlock_handles		jsr	lock_handles		;lock down Express segment				lda	#$0007			;7 parms for GetFileInfo call		sta	PGetFileInfo.pCount		lda	PathnamePtr		sta	PGetFileInfo.pathname		sec		sbc	#8			;mod date is stored 8 bytes before pathname		sta	temp_ptr		;set up pointer for eventual comparison		lda	PathnamePtr+2		sta	PGetFileInfo.pathname+2		sbc	#0		sta	temp_ptr+2		jsl	$E100A8			;make the call		dc.w	GetFileInfo		dc.l	PGetFileInfo		tax				;clear Z flag on error		bcs	no_good			;just abort on error; now that we have the file's mod date in memory, set up a pointer to the buffered; mod date in the ExpressLoad segment		ldy	#6			;compare 8 bytes@loop		lda	[temp_ptr],y		;get a word		cmp	PGetFileInfo.modDateTime,y		bne	no_good			;exit if unequal		dey		dey				;loop through entire field		bpl	@loop		sep	#%00000010		;set Z flag to show they're equalno_good		php				;save return status		jsr	unlock_handles		;unlock the handles again		plp				;return status		rts				ENDP