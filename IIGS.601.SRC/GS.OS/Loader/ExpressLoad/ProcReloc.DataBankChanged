				;setup for the new bank please@low_only		jmp	shift_patch		;the the patch please						eject;====================================================================================================;;This routine will process a compressed relocation entry;;Structure pointed to by Reloc_dict_ptr;;		opcode $F5	(1 Byte);		patch_cnt	(1 byte: number of bytes to patch);		bit_shift	(1 byte: (+) = ASL (-) = LSR;		patch_offset	(2 bytes: offset from the start of the segment);		patch_value	(2 bytes: offset from the start of the segment);;====================================================================================================		cReloc_handler		ldy	#$0001		lda	(reloc_dict_ptr),y	;get the patch cnt and bit shift		sep	#$20		sta	patch_cnt		;the number of bytes to patch 1,2 or 3		xba		sta	shift_cnt		rep	#$20			;back to 16 bit mode		ldy	#$0003			;point the patch offset		clc		lda	(reloc_dict_ptr),y		adc	base_ptr		;base address		sta	patch_ptr		;address to patch		lda	#$0000		adc	base_ptr+2		sta	patch_ptr+2		;high word of patch address		ldy	#$0005			;point to the patch value field		clc		lda	(reloc_dict_ptr),y		adc	base_ptr		sta	patch_value		lda	#$0000		adc	base_ptr+2		sta	patch_value+2		;what we will patch with		clc		lda	reloc_dict_ptr		;bump the relocation dictionary pointer please		adc	#$0007		sta	reloc_dict_ptr		bcc	@low_only		inc	reloc_dict_ptr+2	;don't forget the high byte please		pei	reloc_dict_ptr+1		plb		plb				;setup for the new bank please@low_only		jmp	shift_patch		;the the patch please		eject;====================================================================================================;;This routine will process a Interseg relocation entry;;Structure pointed to by Reloc_dict_ptr;;		opcode $E3	(1 Byte);		patch_cnt	(1 byte: number of bytes to patch);		bit_shift	(1 byte: (+) = ASL (-) = LSR;		patch_offset	(4 bytes: offset from the start of the segment);		file number	(2 bytes: file number of load f