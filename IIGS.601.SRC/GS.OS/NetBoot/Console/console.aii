	MACHINE M65816	INCLUDE 'console.equates'	INCLUDE 'my.macros'	longa off	longi offConsRec	Record 0	;defined area for dataWIND_L	DS.B 1WIND_T	DS.B 1WIND_R	DS.B 1WIND_B	DS.B 1CSR_X	DS.B 1CSR_Y	DS.B 1CUR_LINE	DS.B 1COLMODE	DS.B 1LASTCOL	DS.B 1INVBYTE	DS.B 1CONTROL	DS.B 1COUNT	DS.B 2SPEED	DS.B 1BLNKRATE	DS.B 1CURSER	DS.B 1CURRCHAR	DS.B 1DATA_LEN	DS.B 2SCRATCH_X	DS.B 1SCRATCH_Y	DS.B 1CHR_HB	DS.B 1StrTemp	DS.B 1WrtParms		; StringPtr	DS.B 2StrLen	DS.B 1	DS.B 1buflen	DS.B 1savx	DS.B 1HomeX	DS.B 1HomeY	DS.B 1prsavx	DS.B 1OptByte	DS.B 1MaxLen	DS.B 1ContOff	DS.B 1Buffer	DS.B 256	;Keyboard buffer for input routineZTemp	DS.B 24LIdx	DS.B 2TextPtrs	ds.w 4	;four pointers to stringsStkPtr	ds.b 1Stack	ds.b StackSize	ENDRListRec	record 0LastSel	DS.B 1PassFlag	DS.B 1ListOpt	DS.B 1ListCount	DS.B 1XPos	DS.B 1YPos	DS.B 1Inc	DS.B 1MYPos	DS.B 1TempCont	DS.B 1MoreFlag	DS.B 1TopIndex	ds.b 1WindowSize	ds.b 1	endr;; entries from input.aii;	entry input,FrameRect,ListHandler,WritePointer,Message;; entries from Strings.aii;	entry CompareStr,MoveStr,NextStr;; entries in console.aii that used to be exports;** CONSOLE DRIVER ROUTINE** DESIGNED AND WRITTEN BY HOWARD W. RIDENOUR** COMPLETED AND DE-BUGGED BY JOHN W. SHIOLI** COPYRIGHT 1985 ParaMIS CORPORATION* ALL RIGHTS RESERVED*;; Modified 10/11/87	by Mark Day; Allows execution on 65816 in any bank.; Must be called in	8-bit mode (native mode if in a bank other than 0).; This will run unmodified on a 65C02, since the extra opcodes of the 65816; are NOP's on the 65C02.;; 4/13/88 Converted	to MAX source (msd);;------------------------------------------------------------;; COMMAND INTERPRETER;;            A = COMMAND;          X,Y = POINTER TO PARAMETER LIST;	EXPORT ConsDrvrConsDrvr	PROC	import Cons_Init,Write,GetCsr,GetStat,SaveWind	import RestWind,Get_Kbd,Write_X,WrtCStg,GotoXY	import Input,FrameRect,ListHandler,WritePointer	import DoViewPort,SetCursor,Message,CenterString	import PrintHex,ParmText,CompareStr,MoveStr	import NextStr,SortArray,FindItem	Import ConsData:ConsRec	with ConsData	pha	jsr SavZp	pla	jsr StartAsm	pha	jsr RestZp	pla	rts	entry StartAsmStartAsm		;               	CLD	bit #$80	beq @1	jmp StackConsDrvr@1	CMP #LASTCMD	;BAD COMMAND ?	BCS CmdErr	STX LISTPTR	;STORE LIST POINTER	STY LISTPTR+1	ASL A	taxCmdJMP	jmp (CmdTbl,x)CmdErr	LDA #BADCMD	SEC	RTSStackConsDrvr	;	phx	;save the x and Y registers	phy	;	and #$7f	;clear the high bit, which indiactes a stack based parameter	CMP #LASTCMD	;is the command in our list	BCS CmdErr	;if no, return an error	asl a	;multiply by 2	tax	;into the x register for indexing	jsr CmdJmp	;jsr to the routine with six bytes on the stack plus parameters	ply	;restore x and Y registers	plx	;	rtsSavZp	phx	ldx #$0fThisPt	lda LineIdx,x	sta Ztemp,x	dex	bpl ThisPt	plx	lda LIdx	sta LineIdx	lda LIdx+1	sta LineIdx+1	rtsRestZp		; 	phx	lda LineIdx	sta LIdx	lda LineIdx+1	sta LIdx+1	ldx #$0fThisPt2	lda Ztemp,x	sta LineIdx,x	dex	bpl ThisPt2	plx	rts;;;;  COMMAND TABLE;CMDTBL		; 	DC.W CONS_INIT	;00	DC.W WRITE	;01	DC.W GETCSR	;02	DC.W GETSTAT	;03	DC.W SAVEWIND	;04	DC.W RESTWIND	;05	DC.W GET_KBD	;06	DC.W WRITE_X	;07	DC.W WrtCStg	;08	DC.W GotoXY	;09	DC.W Input	;0a	 	DC.W FrameRect	;0b	DC.W ListHandler	;0c	DC.W WritePointer	;0d	DC.W DoViewPort	;0e	DC.W SetCursor	;0f	DC.W Message	;10	DC.W CenterString	;11	DC.W PrintHex	;12	dc.w ParmText	;13	dc.w CompareStr	;94	dc.w MoveStr	;95	dc.w NextStr	;96	dc.w SortArray	;97	dc.w FindItem	;98;	ENDP;------------------------------------------------;;   INTITIALIZE ROUTINE;;PARAMETER LIST: SCREEN MODE-1 BYTE $80=80 COL;	                $00=40 COL;;               EXPORT  CONS_INIT CONS_INIT	PROC	import SetLi,Clr_Wind	Import ConsData:ConsRec	with ConsData	LDY #0	;Set a null index	LDA (LISTPTR),Y	;GET SCREEN MODE	sta ColMode	;save the mode	ROL A	;80 COL MODE ?	BCS INIT_1	LDA #39	STA LASTCOL	;SETUP LAST COL	phb	pea $E0E0	plb	plb	STA S_40COL	;Turn off the 80 col card	plb	JMP INIT_2INIT_1		; 	phb	pea $E0E0	plb	plb	STA S_80COL	;TURN ON 80 COL	STA STORE80	plb	LDA #79	STA LASTCOL	;SETUP LAST COLINIT_2	STY WIND_L	;SETUP WINDOW BYTES	STY WIND_T	LDA #LASTLINE	STA WIND_B	LDA LASTCOL	STA WIND_R	phb	pea $E0E0	plb	plb	STA ALTCHAR	;TURN ON ALT CHAR SET	plb	LDA #$80	STA INVBYTE	;NORMAL MODE	LDA #DFCNTL	;DEFAULT CONTROL BYTE	STA CONTROL	LDA #DFBLKRTE	;DEFAULT BLINK RATE	STA BLNKRATE	LDA #0	JSR SETLI	;SET LINE ZERO	STY CSR_Y	;SETUP CURSER	STY CSR_X	lda #$20	sta Curser	;initally the cursor is a inverse space	JSR CLR_WIND	stz ContOff	;control characters	on....	lda #StackSize	;initalize the internal stack	sta StkPtr	;and zero page pointers	LDA #NOERR	CLC	RTS	ENDP;------------------------------------------------------------;; WRITE TO SCREEN COMMAND;;          PARAMETER LIST:    PTR TO DATA - 2 BYTES;	          DATA LENGTH - 2 BYTES;WRITE	PROC Export	import SetLi,ClrLine,Clr_Eow,ClrLB	import To_Scrn,From_Scrn,ClrEol,Clr_Wind	import Clr_WB	Import ConsData:ConsRec	with ConsData	LDY #0	;SETUP Y	LDA (LISTPTR),Y	;SETUP POINTER TO DATA	STA DATA_PTR	INY	LDA (LISTPTR),Y	STA DATA_PTR+1	INY	LDA (LISTPTR),Y	;SETUP DATA LENGTH	EOR #$FF	;IN ONES COMPLIMENT	STA DATA_LEN	INY	LDA (LISTPTR),Y	EOR #$FF	STA DATA_LEN+1WRT_LOOP	JSR NXTCHAR	;GET NEXT CHAR	BCS WRT_DONE	lda Chr_HB	bpl WL1	lda #'?'WL1		; 	CMP #SPACE	;CONTROL CHAR ?	BCC CNTL	JSR CHAR	JMP WRT_LOOPCNTL	bit ContOff	bmi CNTL1	ASL A	;MULT BY 2	TAX	;USE AS INDEX	JSR CNTL_CHARCNTL1	JMP WRT_LOOPWRT_DONE	LDA #NOERR	CLC	RTS;;	entry NXTCHARNXTCHAR		;               	INC DATA_LEN	;INC COUNT	BNE NC_1	INC DATA_LEN+1	BNE NC_1	SEC	;DONE	RTSNC_1	LDY #0	;Set up a null index	LDA (DATA_PTR),Y	;GET CHAR	STA CHR_HB	;Preserve the origional form	AND #%01111111	;REMOVE HI BIT	INC DATA_PTR	BNE NC_2	INC DATA_PTR+1NC_2	CLC	RTS;	entry CNTL_CHARCNTL_CHAR		;               	LDA CNTL_TBL,X	STA CNTLJMP+1	LDA CNTL_TBL+1,X	STA CNTLJMP+2CNTLJMP	JMP 0	; jump to routine (self-modifying);; CONTROL CHAR ROUTINE VECTOR TABLE;CNTL_TBL		; 	DC.W C_NOP	;00 	DC.W C_CLRWB	;01	DC.W C_SETWIND	;02 	DC.W C_RSTWIND	;03	DC.W C_CLRWIND	;04 	DC.W C_CLREOW	;05 	DC.W C_CLRLN	;06 	DC.W C_BELL	;07 	DC.W C_CSR_L	;08	DC.W C_HTAB	;09 	DC.W C_CSR_D	;0A	DC.W C_CSR_U	;0B	DC.W C_CLEOL	;0C 	DC.W C_CR	;0D	DC.W C_NORM	;0E	DC.W C_INV	;0F 	DC.W C_MTON	;10	DC.W C_VTAB	;11 	DC.W C_HOME	;12 	DC.W C_MTOFF	;13	DC.W C_CSR_POS	;14 	DC.W C_CSR_R	;15	DC.W C_SCR_U	;16 	DC.W C_SCR_D	;17 	DC.W C_SCR_L	;18	DC.W C_SCR_R	;19	DC.W C_SETCNTL	;1A	DC.W C_CLLNB	;1B	DC.W C_ReptChar	;1C	DC.W C_WaitChar	;1D	DC.W C_UNDEF	;1E	DC.W C_UNDEF	;1F;;------------------------------------------------------------;;   OUTPUT CHAR TO SCREEN;	entry CHARCHAR		;               	tax	CMP #$40	;CHAR IN MT RANGE ?	BCC CHAR_2	CMP #$60	BCS CHAR_2	LDA #MT_BIT	;CHECK MT BIT	BIT CONTROL	BEQ CHAR_1	TXA	JMP CHR_3Char_1	lda #Inv_Bit	bit Control	beq Char_2	txa	and #%10111111	;clear the d6 bit	jmp Chr_3Char_2	txa	;restore the accumulator	ora InvByteCHR_3		; 	LDY CSR_X	;GET CURSER X POS	JSR TO_SCRN	;OUTPUT TO SCREEN	LDA CONTROL	BPL CHAR_ND	;ADVANCE ?	ROL A	;ADVANCE VERT ?	BMI CHAR_3	JSR C_CSR_R	;MOVE CURSER RIGHT	JMP CHAR_NDCHAR_3	JSR C_CSR_D	;MOVE CURSER DOWNCHAR_ND	RTS;;------------------------------------------------------------;;   NO OPERATION;C_NOP		; 	RTS;;------------------------------------------------------------;;   CLEAR WINDOW FROM BEGINNING;C_CLRWB		; 	JMP CLR_WB;;------------------------------------------------------------;;    SET WINDOW;C_SETWIND		; 	LDX #4	;SETUP COUNTSW_1	JSR NXTCHAR	;GET NEXT CHAR	BCS SW_ND	;NO CHAR - QUIT	STA HOLD_W,X	;HOLD	DEX	BNE SW_1	LDA #LASTLINE	CMP HOLD_B	;PAST LAST LINE ?	BCC SW_ND	LDA HOLD_B	CMP HOLD_T	;TOP BELOW BOTTOM ?	BCC SW_ND	LDA LASTCOL	CMP HOLD_R	;PAST RIGHT BOUNDARY ?	BCC SW_ND	LDA HOLD_R	CMP HOLD_L	;LEFT PAST RIGHT ?	BCC SW_ND	LDX #4	;SETUP COUNT	LDY #0SW_2	LDA HOLD_W,X	;GET FROM HOLD	STA WIND_L,Y	;SET PARAMETER	INY	DEX	BNE SW_2	LDA WIND_L	;HOME CURSER	STA CSR_X	LDA WIND_T	STA CSR_Y	JSR SETLISW_ND	RTS;;     HOLD_W	DS.B 1HOLD_B	DS.B 1HOLD_R	DS.B 1HOLD_T	DS.B 1HOLD_L	DS.B 1;;------------------------------------------------------------;;    RESET WINDOW;C_RSTWIND		; 	LDA #0	STA WIND_L	;ZERO WINDOW LEFT AND TOP	STA WIND_T	STA CSR_X	;HOME CURSER	STA CSR_Y	JSR SETLI	;SET NEW LINE INDEX	TO 0	LDA #LASTLINE	STA WIND_B	;SET WINDOW BOTTOM AND RIGHT	LDA LASTCOL	STA WIND_R	RTS;;------------------------------------------------------------;;   CLEAR WINDOW;C_CLRWIND		; 	JMP CLR_WIND;;------------------------------------------------------------;;   CLEAR TO END OF	WINDOW;C_CLREOW		; 	LDY CSR_X	;GET CURSER X	LDX CSR_Y	;GET CURSER X	JMP CLR_EOW	;CLEAR TO END OF WINDOW;;------------------------------------------------------------;;   CLEAR LINE;C_CLRLN		; 	JMP CLRLINE;;----------------------------------------------------------- ;;   BELL;C_BELL		; 	LDA #$40	;DURATION	STA B_LNGTHBELL_1	LDA #$02	;SHORT DELAY	JSR B_WAIT	phb	pea $E0E0	plb	plb	STA SPKR	plb	LDA #$24	;LONG DELAY	JSR B_WAIT	phb	pea $E0E0	plb	plb	STA SPKR	plb	DEC B_LNGTH	BNE BELL_1	RTS;; WAIT ROUTINE;B_WAIT	SECB_WAIT2	PHAB_WAIT3	SBC #1	BNE B_WAIT3	PLA	SBC #1	BNE B_WAIT2	RTS;B_LNGTH	DS.B 1;;------------------------------------------------------------;;   MOVE CURSER LEFT;C_CSR_L		; 	LDA CSR_X	;GET CURSER X	CMP WIND_L	;= WINDOW L ?	BEQ CSRL_1	DEC CSR_X	;MOVE CURSER LEFT	RTSCSRL_1	LDA CONTROL	AND #WRAP_BIT	;WRAP ON ?	BEQ CSRL_ND	LDA WIND_R	STA CSR_X	;MOVE CURSER TO WINDOW RIGHT	JSR C_CSR_U	;MOVE CURSER UPCSRL_ND	RTS;;------------------------------------------------------------;;   SET HORIZONTAL CURSER POSITION;;         NEXT CHAR	= POSITION;C_HTAB		; 	JSR NXTCHAR	;GET NEXT CHAR	BCS HT_ND	;NO CHAR	CLC	ADC WIND_L	;CONVERT TO ABSOLUTE	CMP WIND_R	BCC HT_1	BEQ HT_1	LDA WIND_R	;If overflow, default to maxHT_1	STA CSR_X	;SET CURSER XHT_ND	RTS;;------------------------------------------------------------;;   MOVE CURSER DOWN;C_CSR_D		; 	LDA CSR_Y	;GET CURSER Y	CMP WIND_B	;= WINDOW BOTTOM ?	BEQ CSRD_1	INC CSR_Y	; MOVE CURSER DOWN	LDA CSR_Y	JSR SETLI	;SET NEW LINE INDEX	RTSCSRD_1	LDA CONTROL	AND #SCROL_BIT	;SCROLL ON ?	BEQ CSRD_ND	JSR C_SCR_U	;SCROLL UPCSRD_ND	RTS;;------------------------------------------------------------;;   MOVE CURSER UP;C_CSR_U		; 	LDA CSR_Y	;GET CURSER Y	CMP WIND_T	;= WINDOW TOP ?	BEQ CSRU_1	DEC CSR_Y	;MOVE CURSER UP	LDA CSR_Y	JSR SETLI	;SET NEW LINE INDEX	RTSCSRU_1	LDA CONTROL	AND #SCROL_BIT	;SCROLL ON ?	BEQ CSRU_ND	JSR C_SCR_D	;SCROLL DOWNCSRU_ND	RTS;;------------------------------------------------------------;;   CLEAR TO END OF	LINE;C_CLEOL		; 	LDY CSR_X	;GET CURSER X	JSR CLREOL	;CLEAR TO END OF LINE	RTS;;------------------------------------------------------------;;   CARRIAGE RETURN;C_CR		; 	LDA WIND_L	;GET WIND LEFT	STA CSR_X	;SET CURSER X	LDA CONTROL	AND #LF_BIT	;LINE FEED BIT SET ?	BEQ CR_ND	JSR C_CSR_D	;MOVE CURSER DOWNCR_ND	RTS;;------------------------------------------------------------;;   SET NORMAL MODE;C_NORM		; 	LDA #INV_BIT	;GET INVERSE BIT	EOR #$FF	;REVERSE	AND CONTROL	;CLEAR BIT	STA CONTROL	LDA #$80	STA INVBYTE	;SET INVERSE BYTE	RTS;;------------------------------------------------------------;;   SET INVERSE MODE;C_INV		; 	LDA #INV_BIT	;GET INVERSE BIT	ORA CONTROL	;ADD TO CONTROL BYTE	STA CONTROL	LDA #0	STA INVBYTE	;ZERO INVERSE BYTE	RTS;;------------------------------------------------------------;;  MOUSETEXT ON;C_MTON		; 	LDA #MT_BIT	;GET BIT	ORA CONTROL	;ADD TO CONTROL BYTE	STA CONTROL	RTS;;------------------------------------------------------------;;   SET CURSER VERTICAL POSITION;;          NEXT CHAR = POSITION;C_VTAB		; 	JSR NXTCHAR	;GET NEXT CHAR	BCS VT_ND	;NO CHAR	CLC	ADC WIND_T	;CONVERT TO ABSOLUTE	CMP WIND_B	;= WINDOW BOTTOM ?	BCC VT_1	BEQ VT_1	LDA WIND_B	;If overflow, set to maxVT_1	STA CSR_Y	;SET CURSER Y	JSR SETLI	;SET NEW LINE INDEXVT_ND	RTS;;------------------------------------------------------------;;   HOME CURSER;C_HOME		; 	LDA WIND_L	;GET WINDOW LEFT	STA CSR_X	;SET CURSER TO WINDOW LEFT	LDA WIND_T	;GET WINDOW TOP	STA CSR_Y	;SET CURSER Y	JSR SETLI	;SET NEW LINE INDEX	RTS;;------------------------------------------------------------;;   MOUSETEXT OFF;C_MTOFF		; 	LDA #MT_BIT	;GET MOUSTEXT BIT	EOR #$FF	;REVERSE BITS	AND CONTROL	;CLEAR BIT IN CONTROL BYTE	STA CONTROL	RTS;;------------------------------------------------------------;;   SET CURSER POSITION;;        NEXT 2 CHAR = POS - X,Y;C_CSR_POS		; 	JSR NXTCHAR	;GET NEXT CHAR	BCS CSRP_ND	;NO CHAR	TAX	;SAVE X POS	JSR NXTCHAR	;GET Y POS	BCS CSRP_ND	; NO CHAR	entry SetPosSetPos		;               ;x=XPOS a=YPOS	CLC	ADC WIND_T	;CONVERT TO ABSOLUTE	CMP WIND_B	;PAST BOTTOM ?	BEQ CSRP_1	BCC CSRP_1	LDA WIND_B	;If overflow, set to maxCSRP_1	TAY	TXA	CLC	ADC WIND_L	;CONVERT TO ABSOLUTE	CMP WIND_R	;PAST RIGHT ?	BEQ CSRP_2	BCC CSRP_2	LDA WIND_R	;If overflow, set to maxCSRP_2	STA CSR_X	;SET X	STY CSR_Y	;SET Y	TYA	JSR SETLI	;SET NEW LINE INDEXCSRP_ND	RTS;;------------------------------------------------------------;;   MOVE CURSER RIGHT;C_CSR_R		; 	LDA CSR_X	;GET CURSER X POS	CMP WIND_R	;= WINDOW RIGHT ?	BEQ CSRR_1	INC CSR_X	;MOVE CURSER RIGHT	RTSCSRR_1	LDA CONTROL	;GET CONTROL BYTE	AND #WRAP_BIT	;WRAP SET ?	BEQ CSRR_ND	;NO	LDA WIND_L	STA CSR_X	;SET CURSER TO WINDOW LEFT	JSR C_CSR_D	;MOVE CURSER DOWNCSRR_ND	RTS;;------------------------------------------------------------;;   SCROLL UP;C_SCR_U		; 	LDA WIND_T	;START AT TOP	STA DEST_LINE	;SAVE DEST LINESCRU_1	LDA DEST_LINE	;GET DEST LINE	CMP WIND_B	;AT BOTTOM ?	BEQ SCRU_2	STA SRC_LINE	;SAVE AS THE SOURCE	LINE	INC SRC_LINE	JSR MOVELINE	;MOVE LINE	INC DEST_LINE	JMP SCRU_1SCRU_2	JSR SETLI	;SET LINE INDEX	JSR CLRLINE	;CLEAR LAST LINE	LDA CSR_Y	;RESET LINE INDEX	JSR SETLI	RTS;; MOVE LINE;MOVELINE		; 	LDY WIND_L	;START AT LEFTML_1	LDA SRC_LINE	;GET THE SOURCE LINE #	JSR SETLI	JSR FROM_SCRN	;GET THE NEXT CHAR ON LINE	PHA	;SAVE IT;	LDA DEST_LINE	JSR SETLI	PLA	JSR TO_SCRN	;TRANSFER ONE LINE UP (SAME COLUMN);	INY	;SET TO NEXT COLUMN	CPY WIND_R	;At the right yet ?	BCC ML_1	BEQ ML_1	RTS;SRC_LINE	DS.B 1	;SOURCE LINEDEST_LINE	DS.B 1	;DESTINATION LINE;;------------------------------------------------------------;;   SCROLL DOWN;C_SCR_D		; 	LDA WIND_B	;START AT BOTTOM	STA DEST_LINE	;SAVE DEST LINESCRD_1	LDA DEST_LINE	;GET DEST LINE	CMP WIND_T	;AT TOP ?	BEQ SCRD_2	STA SRC_LINE	;SAVE AS THE SOURCE	LINE	DEC SRC_LINE	JSR MOVELINE	;MOVE LINE	DEC DEST_LINE	JMP SCRD_1SCRD_2	JSR SETLI	JSR CLRLINE	LDA CSR_Y	JSR SETLI	RTS;;-----------------------------------------------------------;;   SCROLL LEFT;C_SCR_L		; 	LDY WIND_L	;Start at left	STY DEST_COL	;Save as Destination collumnSCRL_1	LDY DEST_COL	;Get the Dest col	CPY WIND_R	;At right ?	BEQ SCRL_2	INY	STY SRC_COL	;Save as the source	collumn	JSR MOVECOL	;Move the collumn	INC DEST_COL	JMP SCRL_1SCRL_2	JSR CLRCOL	;Clear the last collumn	LDA CSR_Y	;Reset the line index	JSR SETLI	RTS;; MOVE COLLUMN;MOVECOL		; 	LDX WIND_T	;Start at topMC_1	TXA	JSR SETLI	LDY SRC_COL	;Get the source col	#	JSR FROM_SCRN	;Get that char;	LDY DEST_COL	JSR TO_SCRN	;Transfer the char to new col;	INX	;Set to next line	CPX WIND_B	BCC MC_1	BEQ MC_1	RTS;SRC_COL	DS.B 1	;Source collumnDEST_COL	DS.B 1	;Destination collumn;;-----------------------------------------------------------;;   SCROLL RIGHT;C_SCR_R		; 	LDY WIND_R	;Start at right	STY DEST_COL	;Save as Destination collumnSCRR_1	LDY DEST_COL	;Get the Dest col	CPY WIND_L	;At left ?	BEQ SCRR_2	DEY	STY SRC_COL	;Save as the source	collumn	JSR MOVECOL	;Move the collumn	DEC DEST_COL	JMP SCRR_1SCRR_2	JSR CLRCOL	;Clear the last collumn	LDA CSR_Y	;Reset the line index	JSR SETLI	RTS;;-----------------------------------------------------------;;   CLEAR COLLUMN;;      Y = COLLUMN #;CLRCOL		; 	LDX WIND_T	;Start from topCCOL_1	TXA	JSR SETLI;	LDA #SPACE_HB	JSR TO_SCRN	CPX WIND_B	;At bottom ?	BEQ CCOL_2	INX	JMP CCOL_1CCOL_2	RTS;;-----------------------------------------------------------;;   SET CONTROL BYTE;;       NEXT CHAR =	CONTROL BYTE;;	BIT 7 = ADVANCE;	BIT 6 = ADVANCE VERTICAL;	BIT 5 = WRAP;	BIT 4 = SCROLL;	BIT 3 = INVERSE;	BIT 2 = MOUSETEXT;	BIT 1 = LINE FEED AFTER CR;	BIT 0 = INPUT ECHO;C_SETCNTL		; 	JSR NXTCHAR	;GET NEXT CHAR	BCS SC_ND	;NO CHAR	LDA CHR_HB	;Get the full (high	bit) form of byte	STA CONTROL	;STORE CONTROL BYTESC_ND	RTS;;------------------------------------------------------------;;   CLEAR LINE FROM	BEGINNING;C_CLLNB		; 	JMP CLRLB;;;------------------------------------------------------------;;   SET SPEED;C_SETSP		; 	JSR NXTCHAR	;GET SPEED	BCS SP_ND	STA SPEEDSP_ND	RTS************************************************************ Repeat a Character N times***********************************************************C_ReptChar		; 	jsr NxtChar	bcs C_ReptNd	beq C_ReptNd	pha	jsr NxtChar	bcs C_ReptNd	ply	;restore the y register	cmp #$20	bcc C_ReptNdlup	phy	pha	jsr Char	pla	ply	dey	bne lupC_ReptNd	rts************************************************************ Wait for the amount specified by N***********************************************************C_WaitChar		; 	jsr NxtChar	;get N 	bcs C_WaitNd	beq C_WaitNd	lda Chr_HB	jsr B_WaitC_WaitNd	rts;------------------------------------------------------------;;   UNDEFINED CONTROL CHAR;C_UNDEF		; 	RTS	ENDP;;------------------------------------------------------------;;   GET STATUS ROUTINE;;        PARAMETER LIST:  DATA POINTER - 2 BYTES;;;        RETURN:  DATA BUFFER:  0 - CSR_X;	            1 - CSR_Y;	            2 - WIND_L;	            3 - WIND_T;	            4 - WIND_R;	            5 - WIND_B;	            6 - CONTROL;;               EXPORT  GETSTAT  GETSTAT	PROC	Import ConsData:ConsRec	with ConsData	ldy #0	LDA CSR_X	;Get the Status Information	STA (LISTPTR),Y	; and save it in the data buffer:	INY	LDA CSR_Y	STA (LISTPTR),Y	INY	LDA WIND_L	STA (LISTPTR),Y	INY	LDA WIND_T	STA (LISTPTR),Y	INY	LDA WIND_R	STA (LISTPTR),Y	INY	LDA WIND_B	STA (LISTPTR),Y;	INY	LDA CONTROL	STA (LISTPTR),Y;	LDA #NOERR	CLC	RTS	ENDP;;------------------------------------------------------------;;   SAVE WINDOW ROUTINE;;        PARAMETER LIST:  DATA POINTER - 2 BYTES;;       RETURN:   DATA BUFFER = NO_ OF LINES;	            COLLUMNS PER LINE;	            WINDOW DATA;;;SAVEWIND	PROC Export	import From_Scrn,SetLi		Import ConsData:ConsRec	with ConsData	LDY #0	;SETUP Y	LDA LISTPTR	;SETUP POINTER TO DATA	STA DATA_PTR	LDA LISTPTR+1	STA DATA_PTR+1;	LDY #0	;Set pointer to 0	SEC	LDA WIND_B	;Get the last line	SBC WIND_T	;Subtract the first	line	CLC	ADC #1	STA (DATA_PTR),Y	;<-- Total # of lines;	INY	SEC	LDA WIND_R	;Calculate the # of	collumns	SBC WIND_L	CLC	ADC #1	STA (DATA_PTR),Y;	JSR INC_DP	;Set data pointer to start of data area	JSR INC_DP;	LDX #0	LDA WIND_T	STA CUR_LINE	;Reset the current lineSAVWND_1		; 	JSR SETLI	;Set line index to value in A	LDY WIND_L	;Set to 1st collumn;SAVWND_2		; 	JSR FROM_SCRN	;Get the next character	STA (DATA_PTR,X)	;Save it in data area	JSR INC_DP	;Increnment the data pointer;	INY	;Set to next collumn	CPY WIND_R	;End of collumn ?	BEQ SAVWND_2	BCC SAVWND_2;	INC CUR_LINE	;Set to next line	LDA CUR_LINE	;Check it	CMP WIND_B	BEQ SAVWND_1	BCC SAVWND_1;	LDA #NOERR	CLC	RTS;;	entry INC_DPINC_DP		;               	PHA	LDA DATA_PTR	CLC	ADC #1	STA DATA_PTR;	LDA #0	ADC DATA_PTR+1	STA DATA_PTR+1	PLA	RTS;	ENDP;;------------------------------------------------------------;;   RESTORE WINDOW ROUTINE;RESTWIND	PROC Export	import SetLi,To_Scrn	Import ConsData:ConsRec	with ConsData	LDY #0	;SETUP Y	LDA LISTPTR	;SETUP POINTER TO DATA	STA DATA_PTR	LDA LISTPTR+1	STA DATA_PTR+1;	LDY #0	LDA (DATA_PTR),Y	;Get the # of lines	CLC	ADC WIND_T	;Calculate the last	line	STA LINE;	INY	LDA (DATA_PTR),Y	;Get the # of collumns	CLC	ADC WIND_L	STA COLL;	JSR INC_DP	;Set the pointer to	start of data area	JSR INC_DP;	LDX #0	;Set up a null index	LDA WIND_T	;Start at top of window	STA CUR_LINERSTWND_1		; 	JSR SETLI	;Set the line index	for TO_SCRN	LDY WIND_L	;Start at left edge	of screen;RSTWND_2		; 	LDA (DATA_PTR,X)	;Get next char from	buffer	JSR TO_SCRN	;Put it on the screen	JSR INC_DP	;Set the pointer to	next position;	CPY WIND_R	BCS RSTWND_3	CPY COLL	BCS RSTWND_3	INY	JMP RSTWND_2;RSTWND_3		; 	LDA CUR_LINE	;Test the line #	CMP WIND_B	BCS RSTWND_4	CMP LINE	BCS RSTWND_4	INC CUR_LINE	LDA CUR_LINE	JMP RSTWND_1;RSTWND_4		; 	LDA #NOERR	CLC	RTS;LINE	DS.B 1COLL	DS.B 1	ENDP;;------------------------------------------------------------;;  GET CURSER ROUTINE;;         RETURN:;           Y = Cursor Line Number;           X = Cursor Column Number;           A = CHARACTER AT THAT LOCATION;;               EXPORT  GETCSR   GETCSR	PROC	import From_Scrn,SetLi	Import ConsData:ConsRec	with ConsData	LDY CSR_X	LDA CSR_Y	JSR SETLI	JSR FROM_SCRN	;Get the current character	PHA	;Save it;	LDA CSR_X	;GET CURSER X	SEC	SBC WIND_L	;CONVERT TO RELATIVE	TAX	;PLACE IT IN X;	LDA CSR_Y	;GET CURSER Y	SEC	SBC WIND_T	;CONVERT TO RELATIVE	TAY	;PLACE IT IN Y;	PLA	;Retreve the current character	CLC	RTS	ENDP;; ClearKBD -- clear	the keyboard strobe.  Replaces;       STA     KEYDOWN;; GetKBD -- get character from keyboard.  Replaces;       LDA     KEYBOARD;; Written by Mark Day, 10/11/87;;               EXPORT  ClearKBD ClearKBD	PROC	phb	pea $E0E0	plb	plb	STA KEYDOWN	plb	rts	ENDP;               EXPORT  LoadKBD LoadKBD	PROC	phb	pea $E0E0	plb	plb	LDA KEYBOARD	plb	ora #0	; because the PLB changes N and Z flags	rts	ENDP;;-------------------------------------------------;;   GET INPUT CHAR ROUTINE;;PARAMETER LIST: CURSER TYPE-1 BYTE $80=INSERT(_);	                $00=OVERSTRIKE;;        RETURN:  A	= CHARACTER INPUT;                 X	= APPLE KEY STATE:;	      BIT 7 = OPEN APPLE DOWN;	      BIT 6 = CLOSED APPLE DOWN;;;               EXPORT  GET_KBD  GET_KBD	PROC	import To_Scrn	Import ConsData:ConsRec	with ConsData	lda Curser	beq GetKbd2GKB_2		; 	LDA #0	STA COUNT	;Clear the low byte	of the counter;	JSR GETCSR	;Get the curent character	STA CURRCHAR	LDY CSR_X	;Get curser col (LINEIDX is set by GETC;GKB_3	LDA CURSER	;Get the curser character	JSR TO_SCRN	;Put it on the screen	LDA BLNKRATE	;Get the blink rate	STA COUNT+1	;Use as high byte in counter	JSR READSTRB	;Read the keyboard strobe	BCC GKB_4	;Got an input, return_;	LDA CURRCHAR	;Remove the curser	JSR TO_SCRN	LDA BLNKRATE	;Set the curser off	time	STA COUNT+1	JSR READSTRB	;Read the keyboard strobe	BCS GKB_3;GKB_4		; 	jsr ClearKBD	;Clear the key strobe	PHA	;Preserve the character	LDA CONTROL	;Get the control bit	LSR A	;Put the low bit into C	PLA	BCC GKB_5	;If Echo bit is off, restore the char;	CMP #SPACE_HB	;is it a control character ?	BCC GKB_5	;If so, don't echo it;	CPX #0	;Is it an Apple Char ?	BNE GKB_5	;If so, no echo_;	JSR TO_SCRN	;Echo the character	AND #%01111111	;Strip off the high	bit	CLC	RTS;GKB_5		; 	PHA	;Save A	LDA CURRCHAR	;Remove the curser	JSR TO_SCRN	PLA	;Restore A	AND #%01111111	;Strip off the high	bit	RTS;GETKBD2		; ;Get key w/o a curser 	jsr ClearKBDGETKBD3		; 	jsr LoadKBD	;Read the keyboard	BPL GETKBD3	JSR RDSTR_1	;Got the char, now get apple keys	AND #%01111111	;Strip off the high	bit	jsr ClearKBD	;Clear the keyboard	strobe	RTS;READSTRB		; 	jsr LoadKBD	;Read the keyboard	BMI RDSTR_1	DEC COUNT	;Decrement the curser count	BNE READSTRB	DEC COUNT+1	BNE READSTRB	SEC	;No character in	RTS;RDSTR_1		; 	PHA	;Preserve A	phb	pea $E0E0	plb	plb	ASL SWITCH0	;Put the OA bit into C	LDA SWITCH1	;Get the CA bit	plb	AND #%10000000	;Mask out the extra	bits	ROR A	;Put SW0 in bit 7, SW1 in 6, and 0 in C	TAX	; and then put the whole thing in X	PLA	;Restore A	RTS	ENDP;;------------------------------------------------------------;;   CLEAR WINDOW FROM BEGINNING;CLR_WB	PROC Export	import ClrLine,ClrLB,SetLi	Import ConsData:ConsRec	with ConsData	LDX WIND_T	;Start at top lineCLWB_1	TXA	;Put the line index	into A	JSR SETLI	;Calculate the line	index	CPX CSR_Y	;Are we AT the current line ?	BEQ CLWB_2	;If so, go do a CLRLB	JSR CLRLINE	;Otherwise, clear the whole line	INX	;Set to next line	JMP CLWB_1CLWB_2	JMP CLRLB	;Clear the current line to curser	ENDP;------------------------------------------------------------;; CLEAR WINDOW ROUTINE;;               CLR_WIND	PROC Export	import Clr_Eow	Import ConsData:ConsRec	with ConsData	LDX WIND_T	;GET WINDOW TOP	LDY WIND_L	;GET WINDOW LEFT	JSR CLR_EOW	;CLEAR TO END OF WIND	RTS	ENDP;;------------------------------------------------------------;; CLEAR TO END OF WINDOW ROUTINE;;      Y = START POS OF FIRST LINE;      X = FIRST LINE #;;               EXPORT  CLR_EOW  CLR_EOW	PROC	Import SetLi,ClrEOL	Import ConsData:ConsRec	with ConsData 	TXA	JSR SETLI	;SET LINE INDEXCLW_1	JSR CLREOL	;CLEAR TO END OF LINE	CPX WIND_B	;AT BOTTOM ?	BEQ CLW_2	INX	;NEXT LINE	TXA	JSR SETLI	;SET LINE INDEX	LDY WIND_L	;START AT BEG OF LINE	JMP CLW_1CLW_2	LDA CSR_Y	;RESTORE LINE INDEX	JSR SETLI	RTS	ENDP;;-----------------------------------------------------------;; CLEAR LINE ROUTINE;;    LINEIDX = LINE;;               CLRLINE	PROC Export	import ClrEol	Import ConsData:ConsRec	with ConsData	LDY WIND_L	;GET WINDOW LEFT	JMP CLREOL	;CLEAR TO EOL	ENDP;------------------------------------------------------------;; CLEAR TO END OF LINE ROUTINE;;       Y = START POSITION;;       X - UNCHANGED;CLREOL	PROC Export	import To_Scrn	Import ConsData:ConsRec	with ConsData	LDA #SPACE	;GET SPACE CHAR	ora invbyteCLEOL_1	JSR TO_SCRN	;OUTPUT TO WINDOW	CPY WIND_R	;END OF LINE ?	BEQ CLEOL_2	INY	JMP CLEOL_1CLEOL_2	RTS	ENDP;;------------------------------------------------------------;;   CLEAR LINE FROM	BEGINNING;CLRLB	PROC Export	import To_Scrn	Import ConsData:ConsRec	with ConsData	LDA #SPACE_HB	LDY WIND_L	;START AT LEFTCLLB_1	JSR TO_SCRN	;OUTPUT TO WINDOW	INY	CPY CSR_X	;REACHED CURSER POS	YET ?	BNE CLLB_1	RTS	ENDP;;------------------------------------------------------------;; SET LINE INDEX ROUTINE;;    A = LINE NUMBER;    X,Y - UNCHANGED;SETLI	PROC Export	Import ConsData:ConsRec	with ConsData	STY SCRATCH_Y	;SAVE Y	ASL A	;MULT LINE BY 2	TAY	;USE AS INDEX	LDA LINETBL,Y	;GET VALUE FROM TABLE	STA LINEIDX	;PUT IN LINE INDEX	INY	LDA LINETBL,Y	STA LINEIDX+1	LDY SCRATCH_Y	;RESTORE Y	RTS;; LINE INDEX TABLE ;LINETBL		; 	DC.W $400	DC.W $480	DC.W $500	DC.W $580	DC.W $600	DC.W $680	DC.W $700	DC.W $780	DC.W $428	DC.W $4A8	DC.W $528	DC.W $5A8	DC.W $628	DC.W $6A8	DC.W $728	DC.W $7A8	DC.W $450	DC.W $4D0	DC.W $550	DC.W $5D0	DC.W $650	DC.W $6D0	DC.W $750	DC.W $7D0	ENDP;;------------------------------------------------------------;; OUTPUT TO SCREEN ROUTINE;;     Y = COLUMN;     A = CHAR;     LINEIDX = LINE;;     X,Y,A UNCHANGED;TO_SCRN	PROC Export	Import ConsData:ConsRec	with ConsData	STX SCRATCH_X	;SAVE X	STY SCRATCH_Y	;SAVE Y	BIT COLMODE	;CHECK COL MODE	BMI TO_SCR_2	;80 COLTO_SCR_1		; 	phb	; save bank while accessing screen	bit ColMode	;check the mode	bvc Scr2	;not in gs mode	pea 0	; switch to bank 0 for screen	plb	plbScr2	STA (LINEIDX),Y	;STORE CHAR TO SCREEN	plb	; get old bankTO_SCR_3	LDY SCRATCH_Y	;RESTORE Y	LDX SCRATCH_X	;RESTORE X	RTS;; 80 COL;TO_SCR_2	TAX	;SAVE A	TYA	LSR A	;CHECK LOW BIT OF COL #	TAY	TXA	BCS TO_SCR_1	;STORE IN PAGE 1	phb	; save bank while accessing screen	bit ColMode	;check the mode	bvc Scr1	;not in gs mode	pea 0	; switch to bank 0 for screen	plb	plbScr1	LDX PAGE2	;TURN ON PAGE 2	STA (LINEIDX),Y	;STORE CHAR TO SCREEN	LDX PAGE1	;TURN ON PAGE 1	plb	;get old bank	JMP TO_SCR_3	ENDP;;------------------------------------------------------------;;   READ CHAR FROM SCREEN;;      Y = COLUMN;      LINEIDX = LINE;;    RETURN:;      A = CARACTER;;               EXPORT  FROM_SCRN FROM_SCRN	PROC	Import ConsData:ConsRec	with ConsData	STX SCRATCH_X	;SAVE X	STY SCRATCH_Y	;SAVE Y	BIT COLMODE	;CHECK COL MODE	BMI FR_SCR_2	;80 COLFR_SCR_1		; 	phb	; save bank during i/o	pea $E0E0	; switch to bank $E0 for i/o	plb	plb	LDA (LINEIDX),Y	;GET CHAR FROM SCREEN	plb	; back to old bankFR_SCR_3	LDY SCRATCH_Y	;RESTORE Y	LDX SCRATCH_X	;RESTORE X	RTS;; 80 COL;FR_SCR_2		; 	TYA	LSR A	;CHECK LOW BIT OF COL #	TAY	BCS FR_SCR_1	;STORE IN PAGE 1	phb	; save bank during i/o	pea $E0E0	; switch to bank $E0 for i/o	plb	plb	LDX PAGE2	;TURN ON PAGE 2	LDA (LINEIDX),Y	;GET CHAR FROM SCREEN	LDX PAGE1	;TURN ON PAGE 1	plb	; back to old bank	JMP FR_SCR_3	ENDP;               EXPORT  Write_X  Write_X	PROC	Import ConsData:ConsRec	with ConsData	ldx ListPtr	stx MyChar+1	WriteStr MyChar	rtsMyChar	dc.b 1	ds.b 1	ENDP************************************************************ WriteCString - Write a string of characters to the screen* that is in the C String format. (Terminated in zero.)* Up to 32768 characters* Rick Hoiberg 11/4/86***********************************************************;               EXPORT  WrtCStg  WrtCStg	PROC	import Write	Import ConsData:ConsRec	with ConsData	ldy ListPtr+1	sty Scratch_Y	ldy #0	;set up for indexingdoloop	lda (ListPtr),y	;get the character	beq countdun	;if zero we are at the end of the string	iny	;add one to the count	bne doloop	;if no zero get the	next character	inc wrtparms+3	;update our new Write Parameter list	inc ListPtr+1	;move across the page boundry	bra doloop	;and repeatcountdun	sty wrtparms+2	;got the count, now	set up the new	lda listPtr	;parameter list.  Old ListPtr points	sta wrtparms	;to our data	lda Scratch_Y	;this was the original ListPtr High byte	sta wrtparms+1	;	lda #wrtparms	;and now we will make ListPtr Point to	sta listptr	;our new parameter list	lda #>wrtparms	;	sta listptr+1	jmp Write	;and let Write do the rest for us...	ENDP************************************************************ GotoXY - Positions the Cursor at the coordinates* in the X register	(XPOS) and the Y register (YPOS)** Rick Hoiberg 11/20/86***********************************************************;               EXPORT  GotoXY   GotoXY	PROC	Import ConsData:ConsRec	with ConsData	ldx ListPtr	lda ListPtr+1	Jsr SetPos	rts	ENDP;------------------------------------------------------------;;   SHORT BUFFER MOVE ROUTINE;;      X = COUNT;      SRC = SOURCE	POINTER;      DEST = DEST POINTER;;               EXPORT  BUFMOV   ;BUFMOV	PROC;	LDY #$FF	;SETUP Y;BFM_1	INY;	LDA (SRC),Y	;MOVE BYTE;	STA (DEST),Y;	DEX	;DEC COUNT;	BNE BFM_1;	RTS;	ENDPDoViewPort	PROC Export	ldy #0	lda (ListPtr),y	sta SX1	iny	lda (ListPtr),y	sta SY1	iny	lda (ListPtr),y	sta SX2	iny	lda (ListPtr),y	sta SY2	WriteStr SViewPrms	rts	SViewPrms		; 	DC.B $05	DC.B $02SX1	DS.B 1SY1	DS.B 1SX2	DS.B 1SY2	DS.B 1	ENDP;               EXPORT  SetCursor SetCursor	PROC	Import ConsData:ConsRec	with ConsData	ldx ListPtr	stx Curser	rts	ENDP;               EXPORT  CenterString    CenterString	PROC	Import ConsData:ConsRec	with ConsData	lda ListPtr	;save the pointer to the string for later	pha	;use.	lda ListPtr+1	;because we will call the console driver	pha	;ourselves	ldy #0	;get the length of the string	lda (ListPtr),y	;this is it	lsr a	;divide by 2	sta StrTemp	;save here for the subtraction	sec	;get ready for subtraction	lda Wind_R	;find the center point of the window	sbc Wind_L	;by subtracting the	right from the left	lsr a	;divide by 2 	sec	sbc StrTemp	;calculate the starting x position	pha	;save the x start position	GetXY	;get the current XY	coordinates	plx	;and change the x	lda #CD_GotoXY	;goto this new XY position	jsr StartAsm	;	ply	;restore pointer to	the string	plx	;	WritePointer	;print the string	rts	;and then we are done	ENDP	Export PrintHexPrintHex	Proc	Import ConsData:ConsRec	with ConsData	ldy #0	lda (ListPtr),y	;first byte in the list is the number of bytes	cmp #5	;this version supports up to 4 bytes	bge @1	tax	;into the x register	stx HexList@2	iny	;increment y	lda (ListPtr),y	;get the remaining bytes from the parameter list	sta HexList,x	;this is our internal buffer	dex	;until x = 0	bne @2	ldx HexList	;get the count back	ldy #0	;for each byte@3	iny	;get the byte	lda HexList,y	;	jsr HexOut	dex	;again until x = 0	bne @3@1	rtsHexOut		;	phx	;save the registers	phy	;print the Hex value	pha	lsr a	lsr a	lsr a	lsr a	jsr DoHex	pla	jsr DoHex	ply	;restore the registers	plx	rtsDoHex		;	and #$0f	ora #$30	cmp #$3a	bcc @1	adc #6@1	tax	lda #CD_WriteChar	jsr StartAsm	rtsHexList	ds.b 5	ENDP;-----------------------------------------------;ParmText takes four pointers from;the parameter list	and uses them whenever;^0 - ^3 is encountered in the Message Handler;-----------------------------------------------ParmText	Proc	Import ConsData:ConsRec	with ConsData	ldy #0	ldx #4@1	lda (ListPtr),y	;is the pointer a null?	iny	ora (ListPtr),y	;is the high byte null?	beq @2	;it is, so dont change the pointer	dey	;reset the y register back to the pointer	lda (ListPtr),y	;Get the pointers from the parameter list	sta TextPtrs,y	;store the pointer into our internal buffer	iny	;next y	lda (ListPtr),y	;get the high byte	sta TextPtrs,y	;@2	iny	;next y	dex	bne @1	;until x = 0	rts	;all done*	include 'input.aii'	include 'Strings.aii'ConsData	ds ConsRecListData	ds ListRec	end