;--------------------------------------------------------------------------------;; 15-Nov-90 MSD	Fixed SortArray to handle two-byte offsets into the list of;	string pointers.;; 04-Mar-90 MSD	Changed a BNE to BMI in CompareStr where it was testing the;	case insensitive bit.  Also fixed the problem where it was;	returning the wrong (opposite) answer when one string was;	a substring of the other.;; 17-Jun-91 MSD	Fixed SortArray to exit when asked to sort less than 2 items.;;--------------------------------------------------------------------------------*********************************************************** CompareStr compares two strings.  When set, the high bit * of CompareFlag enables case sensitivity for the compare* routine.** The result is returned in bit 7 and bit 6 of the result* byte.  Bit 6 is the equal flag and bit 7 is the greater * than flag.** If String1 = String2 then B7=0 & B6=0	* If String1 < String2 then B7=0 & B6=1	* If String1 > String2 then B7=1 & B6=1	*   * Input:* ---------------------------------------* |            CompareFlag	|* ---------------------------------------* ---------------------------------------* |		|* --        Pointer to String2         --* |		|* ---------------------------------------* ---------------------------------------* |		|* --        Pointer to String1         --* |		|* ---------------------------------------* Output:* ---------------------------------------* |              Result	|* ---------------------------------------**********************************************************	CompareStr	Proc Export	;	Import PullStack,PushStack	jsr PullStack	ldx #3@SP1	lda StrPtr,x	sta SavePtr,x	dex	bpl @SP1	PullWord StrPtr2	PullWord StrPtr	pla	sta CaseFlag	ldy #0	lda (StrPtr),y	;See if string one is larger that string 2	cmp (StrPtr2),y	;	bcc DoStgCmp	;it is, so use String 1	lda (StrPtr2),y	;get string 2DoStgCmp		; 	tax	;transfer the length of the string	beq @Cmp3@CmpLup	iny	lda (StrPtr),y	;get the first string	and #$7F	;no hi ascii	bit CaseFlag	;check for case sensitive	bmi @Cmp1	;if not dont convert to Upper case		;jsr UCConv	cmp #$60	blt @Cmp1	cmp #$7B	bge @Cmp1	and #$5F	;lower to upper case		@Cmp1	sta CompTemp	;keeper place	lda (StrPtr2),y	;the byte in the second string	and #$7F	;no hi ascii	bit CaseFlag	;check for case sensitive	bmi @Cmp2	;if not dont convert to Upper case		; MSD: bne changed to bmi		;jsr UCConv	cmp #$60	blt @Cmp2	cmp #$7B	bge @Cmp2	and #$5F	;lower to upper case		@Cmp2	cmp CompTemp	;compare the two bytes	bne @CompOut1	;if not equal then we are done and flags are set	dex	;do the next character	bne @CmpLup	;if x = 0 then we have tested all of the bytes@Cmp3		;and they match	ldy #0	;Are the lengths the same?		; MSD: Changed order of following compare since it		; was backwards.	lda (StrPtr2),y	cmp (StrPtr),y	;the flags are set	bne @CompOut1	lda #0	;the strings are equal	bra @CompOut3	;return a result of zero	@CompOut1	bcc @Compout2	lda #%11000000	;the carry is set, so set bits 7 and bits 6	bra @CompOut3	;to indicate that String1 > String2	@Compout2	lda #%01000000	;the carry is clear indicate that String1 < String2@CompOut3	pha	ldx #3@SP2	lda SavePtr,x	sta StrPtr,x	dex	bpl @SP2	jmp PushStack	;bye bye....CompTemp	ds.b 1CaseFlag	ds.b 1SavePtr	ds.l 1	EndP*********************************************************** NextStr calculates the next string in an array of* strings and returns the pointer to the next string.** Input:* ---------------------------------------* |		|* --        Pointer to String          --* |		|* ---------------------------------------* Output:* ---------------------------------------* |		|* --        Pointer to String          --* |		|* ---------------------------------------**********************************************************	Export NextStrNextStr	Proc	;	Import PullStack,PushStack	jsr PullStack	;take 6 bytes from the stack	ldx #3@SP1	lda StrPtr,x	sta SavePtr,x	dex	bpl @SP1	pla	;get the pointer to the string	sta StrPtr	;	pla	;	sta StrPtr+1	;	ldy #0		lda (StrPtr),y	inc a	;add one to the length@NS1	clc	adc StrPtr	tax	;put the result back onto the stack	lda StrPtr+1	adc #0	pha	;high byte goes first	txa	pha	;then the low byte	ldx #3@SP2	lda SavePtr,x	sta StrPtr,x	dex	bpl @SP2	jmp PushStack	;restore the 6 bytes to the stack and return to callerSavePtr	ds.l 1	EndP*********************************************************** MovStr moves a Pascal type string to a destiniation * buffer offset by the value passed in offset.** Input:* ---------------------------------------* |              Offset	|* ---------------------------------------* ---------------------------------------* |		|* --     Pointer to Dest Buffer        --* |		|* ---------------------------------------* ---------------------------------------* |		|* --     Pointer to Source String      --* |		|* ---------------------------------------* Output:*  None**********************************************************		Export MoveStrMoveStr	Proc	;	Import PullStack,PushStack	jsr PullStack	ldx #3@SP1	lda StrPtr,x	sta SavePtr,x	dex	bpl @SP1	pla	;get the pointer to the string	sta StrPtr	;get the pointer of the string to be moved	pla	;	sta StrPtr+1	;	pla	sta StrPtr2	;now get the destination buffer	pla	sta StrPtr2+1	clc	pla	;now get the offset	adc StrPtr2	;add it to the destination buffer	sta StrPtr2	;	lda StrPtr2+1	;	adc #0	;	sta StrPtr2+1	;	ldy #0	lda (StrPtr),y	;get the length of the string to be moved	tax	sta (StrPtr2),y	;if the string length is zero store it and leave	beq @MS2	iny @MS1 	lda (StrPtr),y	;move the string	sta (StrPtr2),y	iny	dex	;until x = 0	bne @MS1@MS2	ldx #3@SP2	lda SavePtr,x	sta StrPtr,x	dex	bpl @SP2		jmp PushStackSavePtr	ds.l 1	EndP*********************************************************** SortArray sorts an array of strings passed by the pointer * the number of strings in the ** Input:* ---------------------------------------* |         Number of Strings	|* ---------------------------------------* ---------------------------------------* |		|* -- Pointer to an Array of Strings    --* |		|* ---------------------------------------**********************************************************SortArray	Proc Export	Import PullStack,PushStack	StrPtr3	equ $EA	;MSD: Was $8A (???)MathTemp	equ $EC	;MSD: holds 2nd byte of offset to string pointer table		jsr PullStack	PullWord StrPtr	;Get the pointer to the Array	pla 	;and the number of items	cmp #2	; less than 2 items to sort?	bge HaveSome	; no, got enough to sort	jmp PushStack	; yes, not enough to sort so exitHaveSome	dec a	;zero based for array indexing	sta LastItem	stz Count@LoopTop	;	ldx Count	stx TempIndex	;this is the temporary index that will locate	txa	;the smallest string	jsr GetString1	;	@CompareLoop	lda #0	;set for case insensitive	pha	;	txa	;get the loop counter	inc a	;plus one	jsr GetString2	PushWord String2	PushWord String1	_CompareStr	pla	bpl @CL1	;if plus then String1 <> String2	txa	inc a	sta TempIndex	;this is the smallest string	jsr GetString1	@CL1	inx	cpx LastItem	bne @CompareLoop		lda Count	;save the pointer to the string in this position	cmp TempIndex	beq @CL2	jsr GetString1		lda TempIndex	;save the pointer to the string in this position	asl a	;each pointer in the array is two bytes	stz MathTemp	;MSD: upper byte of offset	rol MathTemp	;MSD: fix upper byte;	clc	;MSD: the STZ and ROL cleared carry		adc StrPtr	;calculate the zero page pointer to the smallest string	sta StrPtr2	;from the beginning of the array buffer	lda StrPtr+1	;	adc MathTemp	;MSD: add upper byte	sta StrPtr2+1	;	lda Count	asl a	;	stz MathTemp	;MSD: upper byte of offset	rol MathTemp	;MSD: fix upper byte;	clc	;MSD: STZ and ROL cleared carry	adc StrPtr	;	sta StrPtr3	;	lda StrPtr+1	;	adc MathTemp	;MSD: add upper byte	sta StrPtr3+1	;	ldy #0	lda (StrPtr2),y	;now make Array(Count) := Array(TempIndex);	sta (StrPtr3),y	iny	;both bytes of the pointer	lda (StrPtr2),y	;	sta (StrPtr3),y	dey	;make y = 0 again	lda String1	sta (StrPtr2),y	;now make Array(TempIndex) := String1	iny	lda String1+1	sta (StrPtr2),y	;@CL2	inc Count	lda Count	cmp LastItem	beq @CL3	jmp @LoopTop@CL3	jmp PushStack	GetString1	;	asl a	;each pointer in the array is two bytes	stz MathTemp	;MSD: upper byte of offset	rol MathTemp	;MSD: fix upper byte;	clc	;get the first byte	adc StrPtr	;	sta StrPtr2	lda StrPtr+1	adc MathTemp	;MSD: add upper byte	sta StrPtr2+1	ldy #0	lda (StrPtr2),y	sta String1	;store it into the String1 for comparison	iny	;	lda (StrPtr2),y	;high byte	sta String1+1	;	rts	GetString2	;	asl a	;each pointer in the array is two bytes	stz MathTemp	;MSD: upper byte of offset	rol MathTemp	;MSD: fix upper byte;	clc	;get the first byte	adc StrPtr	;	sta StrPtr2	lda StrPtr+1	adc MathTemp	;MSD: add upper byte	sta StrPtr2+1	ldy #0	lda (StrPtr2),y	sta String2	;store it into the String1 for comparison	iny	;	lda (StrPtr2),y	;high byte	sta String2+1	;	rts	LastItem	ds.b 1TempIndex	ds.b 1Count	ds.b 1String1	ds.w 1String2	ds.w 1	EndP	*********************************************************** FindItem does a search on an array of strings * passed by the pointer. The other parameter is the number of* items.  The result returns the index to the item.** Input:* ---------------------------------------* |         Number of Strings	|* ---------------------------------------* ---------------------------------------* |		|* -- Pointer to an Array of Strings    --* |		|* ---------------------------------------* |		|* --   Pointer to item to be found     --* |		|* ---------------------------------------* ---------------------------------------* Output:* ---------------------------------------* |              Result	|* ---------------------------------------**********************************************************FindItem	Proc Export	Import PullStack,PushStackMathTemp	equ $EC	;MSD: holds 2nd byte of offset to string pointer table	jsr PullStack	;set up the stack	PullWord StrPtr	PullWord ArrayPtr	plx	;get the number of items to search	ldy #0@CompareLoop	lda #0	pha	;set for case insensitivity	tya	jsr GetString1	PushWord String1	;push string 2	PushWord StrPtr	;push string 1	_CompareStr	;compare the strings	pla	;get the result	beq @CL1	;if equal we found our guy	iny	dex	;	bne @CompareLoop	;	lda #0	;return that the item was not found	pha	;	bra @CL2@CL1	iny	;return the index of the item found	tya	;index plus one	pha	;@CL2	jmp PushStackGetString1	;	phy	asl a	;each pointer in the array is two bytes	stz MathTemp	;MSD: upper byte of offset	rol MathTemp	;MSD: fix upper byte	clc	;get the first byte	adc ArrayPtr	;	sta StrPtr2	lda ArrayPtr+1	adc MathTemp	;MSD: add upper byte	sta StrPtr2+1	ldy #0	lda (StrPtr2),y	sta String1	;store it into the String1 for comparison	iny	;	lda (StrPtr2),y	;high byte	sta String1+1	;	ply	rtsArrayPtr	ds.w 1String1	ds.w 1	EndP			Export PullStackPullStack	Proc	import ConsData:ConsRec	with ConsData	PullWord MyReturn	;store it here	ldy StkPtr	ldx #8@MovLoop	pla	;pull the byte	sta Stack,y	;store the byte	dey	dex	bne @MovLoop	;until all six bytes are moved	sty StkPtr	PushWord MyReturn	;restore return address	rtsMyReturn	ds.w 1	EndPPushStack	Proc	import ConsData:ConsRec	with ConsData	ldy StkPtr	;now move the bytes from our stack to the 6502 stack	ldx #8@MovLoop	iny	lda Stack,y	pha	dex	bne @MovLoop	sty StkPtr	rts	;back to the original calling routine	EndP