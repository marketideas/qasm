*************************************************************** Line Input Routine**       Parameters:*       OptionByte	    dc      h'00'	->              ;B7	- Display '*' for typed characters*		<-              ;B6	- Default modified*       MyLen	    ds      1	                ;maximum length of input*       InBuff	    ds      2	                ;pointer to the callers	buffer*	    dc      a'MyTermList'           ;pointer to the list of	terminating chars**       MyTermList	    anop*	    dc      h'03'	                ;number of characters in the list*	    dc      i1'Escape'              ;The list contains ascii characters with*	    dc      i1'TabHB'               ;the option of the high	bit indicates*	    dc      i1'CrHB'                ;whether the callers buffer gets updated*		                ;or	not*************************************************************Input	PROC ExportTermPtr	equ $ecBufPtr	equ $eeMoveParm		; 	Import ConsData:ConsRec	with ConsData	lda ListPtr	;get the current ListPtr	sta MyListPtr	;save it for future	use	lda ListPtr+1	;and the high byte	sta MyListPtr+1	;we need this as well	ldy #0	;set up for zero page indexing	lda (ListPtr),y	;to get the parameters passed to	sta OptByte	;this routine	iny	lda (ListPtr),y	sta MaxLen	;Maximum input Length	iny	lda (ListPtr),y	sta StrPtr	;This the pointer to the default	iny	;String and the Output Buffer	lda (ListPtr),y	sta StrPtr+1	iny	lda (ListPtr),y	;This is the list of terminating	sta TermPtr	;Characters.  The high bit of each	iny	;character indicates if the Output	lda (ListPtr),y	;Buffer is to be updated with that	sta TermPtr+1	;Termination Character.	GetXY	stx HomeX	sty HomeY	lda control	;modify the console	control byteto	and #$fe	;clear the echo bit	sta control	;	lda Curser	;preserve the current cursor	sta OldCurser	;	lda #$df	;and change it to the underline character	sta Curser	;	stz ClearFlag	;this flag indicates how the underlines	are drawnRestore	ldy #0	lda (StrPtr),y	sta BufLen	beq NoClrMovLup	iny	lda (StrPtr),y	;check for zero!!!!	sta Buffer-1,y	cpy BufLen	bne MovLupNoClr	tya	tax	stz buffer,x	ldx #0	jsr prbuf	;print the buffer	jsr PrUndrLin	lda #$40	trb OptByte	;reset the bit to indicate modified buffer*keyin		; 	jsr SetCursor	jsr GetKey	sta char	jsr CheckTerm	;check to see if we	got a termination	bcc chkcmd	;character	lda Control	;restore the console control byte	ora #$01	;	sta Control	;	lda OldCurser	;restore the old cursor	sta Curser	;	lda #$80	;remove any extra underline characters	sta ClearFlag	;indicate to use spaces to draw underline	jsr PrUndrLin	;draw the underline	lda Char	rts	;Were outta here!chkcmd	cmp #$15	;right cursor key moves one position to	the right	beq jfwd	;         	cmp #8	;left cursor key moves one position to the left	beq jbck	;        	cmp #$04	;Control-D deletes the character one cursor position back	beq jdel	;         	cmp #$7f	;Delete key deletes	the character one cursor position back	beq jdel	;         	cmp #$0b	;up cursor key moves to the end of the edit line          	beq jautf	;        	cmp #$0a	;down cursor key moves to the beginning	of the edit line	                 	beq jautb	;         	cmp #$19	;Control-Y clears to the end of a line.	       	beq jtrunc	;          	cmp #$18	;Control-X clears the entire line	  	beq jclear	;          	cmp #$12	;Control-R restores	the Default input	       	beq jrest	;           	cmp #$20	;any other character should be an ascii	symbol	blt jkeyin	;if it is less than	a space, ignore it	                 	jmp insert	;otherwise insert it at the current cursor position	         jkeyin	jmp keyin	;to the top of the loop                jfwd	jmp fwdarr	;               jbck	jmp bckarrjclear	jmp clearjdel	jmp deletejautf	ldx BufLen	jmp Keyinjautb		; 	ldx #0	jmp keyinjtrunc	jmp clreobjrest	jmp restore	;                 *fwdarr		; 	lda buffer,x	bne fd1	jsr DoBell	bra fd2fd1	inx	lda Char	jsr PrChar	;fd2	jmp keyin*bckarr		; 	cpx #0	bne bk1	jsr DoBell	bra bk2bk1	dex	jsr PrCharbk2	jmp keyin**clear		; 	ldx #0	stz Buffer,x	stx BufLen	jsr PrUndrLin	lda #$40	tsb OptByte	;the default has been modified	jmp Keyin*delete		; 	cpx #0	bne Del1	jsr DoBell	jmp keyin	;if at beginning of	buffer, no deleteDel1	stx savx	;store the x registerDel2	cpx buflen	;are we at the buffer end?	beq Del3	lda buffer,x	beq Del3	sta buffer-1,x	inx	bra Del2Del3		; 	dec buflen	ldx buflen	stz buffer,x	ldx savx	dex	jsr prbuf	jsr PrUndrLin	lda #$40	tsb OptByte	;the default has been modified	jmp keyin	;and return*insert		; ;insert a character into buffer	stx savx	;at the current cursor position.	ldx buflen	cpx MaxLen	bne Clr1	ldx SavX	jsr DoBell	jmp keyinClr1		; 	ldx SavX	lda buffer,x	;get the current position	beq Clr3	;if not eob, then insert at position	ldx BufLenClr2		; 	lda buffer,x	;move the buffer down one byte	sta buffer+1,x	;Yeah, That's the ticket!               	dex	cpx savx	bne Clr2	lda buffer,x	sta buffer+1,xClr3	lda char	inc buflen	ldx Buflen	stz buffer,x	;here is the end	ldx savx	sta buffer,x	;store the input character	jsr prbuf	;print the buffer	inx	lda #$40	tsb OptByte	;the default has been modified	jmp keyin*prchar		; ;print the character in the accumulator	phx	pha	phy	tax	lda #CD_WriteChar	jsr StartAsm	ply	pla	plx	rts***** put buffer into applesoft *****clreob		; ;clear to end of buffer	stz buffer,x	stx Buflen	jsr PrUndrLin	lda #$40	tsb OptByte	;the default has been modified	jmp keyin*GetKey		; 	phx	phy	GetKey	ply	plx	rts*SetCursor		; 	phx	jsr HomeCursor	pla	;get the Buffer position	pha	;back on the stack to restore X	ldy #0	secSBLup		; 	pha	sbc #80	bcc SBPass	iny	bra SBLupSBPass	pla	sta SavX	tya	clc	adc HomeY	tay	lda SavX	clc	adc HomeX	tax	lda #9	jsr StartAsm	plx	rts	;*HomeCursor		; 	ldy HomeY	ldx HomeX	lda #9	jsr StartAsm	ldx #0	rts*DoBell		; 	phx	pha	Bell	pla	plx	rts*CheckTerm		; 	phx	ldy #0	;set up the index register	lda (TermPtr),y	;and get the number	of Term Characters	tax	;into the X register	inyNxterm	lda (TermPtr),y	;get the first Term	Char	and #$7f	;clear the high bit	for compare	cmp Char	;is it the key pressed?	beq Match	;we gots us a terminator!	dex	;try the next one	beq NoMatch	;all have been tryed, so quit	iny	;next one	bra Nxterm*NoMatch		; 	plx	;recover the x register	lda Char	clc	;clear the carry	rts	;indicate no Match*Match	lda (TermPtr),y	;see if an Update is required	bmi Update	;it is so move the Buffer	lda #$40	trb OptByte	;clear the default modified	bra UpDun	;no, so returnUpdate		; 	lda BufLen	;get the Buffer Length	ldy #0	;set up the y register of indexing	sta (StrPtr),y	;store the Length	iny	;UpLup	lda Buffer-1,y	;get the first byte	beq UpDun	;when we reach zero	we are done	sta (StrPtr),y	;store the character	iny	;and then get the next	bra UpLup	;repeat until zeroUpDun		; 	lda MyListPtr	;restore the old pointer to Input Parm list	sta ListPtr	lda MyListPtr+1	;	sta ListPtr+1	ldy #0	;it is the first byte in the list	lda OptByte	;	sta (ListPtr),y	;update the option byte in input parameters	plx	;recover the x register	sec	;indicate that a Termination Character	rts	;was pressed and then bye....***prbuf		; 	stx prsavx	phx	phy	jsr SetCursor	lda #buffer	clc	adc prsavx	tax	lda #>buffer	adc #0	tay	bit OptByte	bmi Encript	lda #8	jsr StartAsmPBufDun	ply	plx	rtsEncript		; 	sty BufPtr+1	stx BufPtr	ldy #0EN1	lda (BufPtr),Y	beq PBufDun	lda #'*'	jsr PrChar	iny	bra EN1*PrUndrLin		; 	phx	ldx BufLen	jsr SetCursor	stx SavX	sec	lda MaxLen	sbc SavX	beq ULinDun	bit ClearFlag	bmi ClearChar	sta UnLinCnt	ReptChar UnderLineULinDun	plx	jsr SetCursor	rtsClearChar		; 	sta ClearCnt	ReptChar ClearLin	bra ULinDunClearLin		; 	DC.W CLChars	DC.W 3CLChars	DC.B ReptCharClearCnt	DC.B $00	DC.B ' 'UnderLine		; 	DC.W ULChars	DC.W 5ULChars	DC.B $10,$1cUnLinCnt	DC.B $00	DC.B 'I'	DC.B $13Char	DS.B 1ClearFlag	DS.B 1OldCurser	DS.B 1MyListPtr	DS.B 2	ENDP	FrameRect	PROC Export	Import ConsData:ConsRec	with ConsData	ldy #0	lda (ListPtr),y	sta HomeX	iny	lda (ListPtr),y	sta HomeY	iny	lda (ListPtr),y	sta X2	iny	lda (ListPtr),y	sta Y2	ldy HomeY	;move the cursor	ldx HomeX	lda #9	jsr StartAsm	lda X2	sec	sbc HomeX	sta UnLinCnt	sta BUnLinCnt	ReptChar UnderLine	dec HomeXDoBars	inc HomeY	ldy HomeY	ldx HomeX	lda #9	jsr StartAsm	WriteCStr LeftBar	ldy HomeY	ldx X2	lda #9	jsr StartAsm	WriteCStr RightBar	ldy HomeY	cpy Y2	bne DoBars	ldx HomeX	inx	iny	lda #9	jsr StartAsm	ReptChar BUnderLine	rtsUnderLine		; 	DC.W ULChars	DC.W 3ULChars	DC.B $1cUnLinCnt	DC.B $00	DC.B '_'BUnderLine		; 	DC.W BULChars	DC.W 5BULChars	DC.B MTON	DC.B $1cBUnLinCnt	DC.B $00	DC.B 'L'	DC.B MTOFFLeftBar	DC.B $10,$5a,$13,$00RightBar	DC.B $10,$5f,$13,$00X2	DS.B 1Y2	DS.B 1	ENDP************************************************************ ListHandler - Handles an Array of Strings for Selection*       Parameter List: *       SelXPos	    Byte    <--*       SelYPos	    Byte    <--*       Increment	    Byte    <--*       ArrayCnt	    Byte    <-- -->*       StgArrayPtr	    Pointer <--*       SelArray	    Pointer <-- *               B7 - Item Selected*               B6 - Item Disabled	        ;can not be	modified*       SelIndex	    Byte    <-- -->*       ListOption	    Byte    <--*               B7 - Enable multiple selections*               B6 - Enable keyboard navigation*               B2 - Enable Selection Fill *               B1 - Enable Check Mark** Rick Hoiberg 2/8/87** 12-Jun-91 MSD	Added single character keyboard navigation.*	If the key presses isn't special (arrow),*	go to the first string greater or equal*	to the key.* 18-Jun-91 MSD	Fixed keyboard navigation to not assume the*	array of pointers to strings began on a*	page boundary.**********************************************************ListHandler	PROC ExportNavChar	equ $EA	; 12-Jun-91 MSDNavIndex	equ $EB	; 12-Jun-91 MSDMyPtr	equ $ecArrayPtr	equ $eeSelXPos	equ 0SelYPos	equ 1Increment	equ 2ArrayCnt	equ 3StgArrayPtr	equ 4SelArray	equ 6SelIndex	equ 8ListOptByte	equ 9	Import ConsData:ConsRec,ListData:ListRec	import MakeMark	with ConsData	with ListData	lda ListPtr	;save the Parameter	list pointer	sta MyPtr	lda ListPtr+1	sta MyPtr+1	ldy #ListOptByte	;get the option byte	lda (MyPtr),y	sta ListOpt	ldy #StgArrayPtr	;get the Array of strings	lda (MyPtr),y	sta StrPtr	;and store it in zero page	iny	lda (MyPtr),y	sta StrPtr+1	ldy #ArrayCnt	;number of items in	array	lda (MyPtr),y	sta ListCount	;list Count	ldy #Increment	;increment between lines	lda (MyPtr),y	sta Inc	ldy #SelXPos	;the X position of where to start	lda (MyPtr),y	sta Xpos	iny	lda (MyPtr),y	;and the Y Position	sta YPos	;display the list	ldy #SelArray	;Selection Array to	indicate which items are	lda (MyPtr),y	;selected and disabled	sta ArrayPtr	;zero page pointer for indexing	iny	lda (MyPtr),y	sta ArrayPtr+1	ldy #SelIndex	;get the item selected	lda (MyPtr),y	sta LastSel	;indicate that this	was the last selection	jsr DrawList	;then highlight the	selected itemGKLoop		;	ldx XPos	;this is the starting horizontal position	ldy MYPos	;and the current y position	lda #CD_GotoXY	;move the cursor to the current XY position	jsr StartAsm	;calling the console driver internal entry point	WriteChar Inv	;set the mode to inverse	ldx LastSel	Jsr DrawItem	WriteChar NormGoKey	GetKey	cmp #10	;down arrow means that we increase the list	bne GK1	;not down arrow check the up arrow	**************************************** Down Arrow Pressed***************************************	ldx LastSel	;get the last selection	cpx ListCount	;if x < ListCount then Update index	bcc GK3	WriteChar Bell	;sound the alarm	bra GoKeyGK3	;	ldx XPos	;this is the starting horizontal position	ldy MYPos	;and the current y position	lda #CD_GotoXY	;move the cursor to the current XY position	jsr StartAsm	;calling the console driver internal entry point	ldx LastSel	;clear inverse from the current item	jsr DrawItem	;redraw the item	inc LastSel	;next index	lda Csr_Y	;are we at the bottom of the window?	cmp Wind_B	;	bne DA1	;if not then we do not need to scroll	WriteChar SCRU	;scroll the list up	inc TopIndex	lda MoreFlag	beq GKLoop	;if zero, then "More" is not used	cmp TopIndex	;it has a value, so compare it to the top index	bne GKLoop	;if it is not equal, then do nothing	lda #0	;it is equal so, clear "More"	jsr DrawMore	;		bra GKLoop	;return to the get key loop	DA1	lda MyPos	;the selection moved down without a scroll	inc a	;add one to the scroll	clc	;add the increment	adc Inc	;	sta MYPos	;update the temporary MYPos position	jmp GKLoop	GK1	cmp #11	bne GK2	**************************************** Up Arrow Pressed***************************************	ldx LastSel	;get the last selection	cpx #1	bne GK4	WriteChar Bell	bra GoKey	GK4	;	ldx XPos	;this is the starting horizontal position	ldy MYPos	;and the current y position	lda #CD_GotoXY	;move the cursor to the current XY position	jsr StartAsm	;calling the console driver internal entry point	ldx LastSel	;clear inverse from the current item	jsr DrawItem	;redraw the item	dec LastSel	;next index	lda Csr_Y	;are we at the bottom of the window?	cmp Wind_T	;	bne UA1	;if not then we do not need to scroll	WriteChar SCRD	;scroll the list down	dec TopIndex	lda MoreFlag	bne @2	;if not zero, then "More" is used	jmp GKLoop@2	cmp TopIndex	;it has a value, so compare it to the top index	beq @3	;if it is not equal, then do nothing	lda #$80	;it is not equal so, draw "More"	jsr DrawMore	;	@3	jmp GKLoop	;return to the get key loop	UA1	lda MyPos	;the selection moved down without a scroll	dec a	;subtract one from the scroll	sec	;subtract the increment	sbc Inc	;	sta MYPos	;update the temp MYPos position	jmp GKLoop		GK2	cmp #Escape	bne GK6	**************************************** Escape Key Pressed***************************************	pha	ldy #SelIndex	;nothing has been selected	lda #0	sta (MyPtr),y	;store a zero in the Selected Item field of record	ldx XPos	;this is the starting horizontal position	ldy MYPos	;and the current y position	lda #CD_GotoXY	;move the cursor to the current XY position	jsr StartAsm	;calling the console driver internal entry point	ldx LastSel	;clear inverse from the current item	jsr DrawItem	;redraw the item	pla	rts	;no updates, were outta here!*GK6	cmp #RTArrow	beq GK7	cmp #LTArrow	beq GK7	cmp #Space	bne GK8	******************************************** Right Arrow, Left Arrow or Space Pressed*******************************************GK7	;	bit ListOpt	bmi LA2	jmp GKLoop	;Multiple Selections not enabledLA2		ldy LastSel	lda (ArrayPtr),y	;Item enabled/disabled?	bit #$40	;check bit 6 of the Selection array for this item	beq LA1	;if set, then this item is disabled	WriteChar Bell	;sound the alarm	bra LA3LA1	eor #$80	;Select Index	sta (ArrayPtr),y	;update the Selection arrayLA3	jmp GKLoop	;return to the top of the loop and reprint item GK8	cmp #CR	beq GK9;==========================================; A non-special key was pressed.; Try keyboard navigation.;==========================================	bit ListOpt	bvc @exit	; bit 6 clear => don't navigate; Save navigation character	cmp #'a'	; convert to upper case for compares	blt @gotchar	cmp #'z'+1	bge @gotchar	and #$DF	; convert lower case to upper case@gotchar	sta NavChar	; Un-highlight the currently selected item	ldx XPos	;this is the starting horizontal position	ldy MYPos	;and the current y position	lda #CD_GotoXY	;move the cursor to the current XY position	jsr StartAsm	;calling the console driver internal entry point	ldx LastSel	;clear inverse from the current item	jsr DrawItem	;redraw the item; Go find the first string greater or equal to the key	stz NavIndex	; start looking at 0th item@loop	lda StrPtr+1	; get address of string pointer array	sta StrPtr2+1	; make my own copy I can muck with	lda StrPtr	sta StrPtr2	lda NavIndex	; get string number	asl a	; *2 as index into array of pointers	tay	; put offset in Y	bcc @nocarry	inc StrPtr2+1	; overflow into page number@nocarry	lda (StrPtr2),y	; get low byte of string pointer	tax	; save in X for a second	iny	lda (StrPtr2),y	; get high byte of string pointer	stx StrPtr2	sta StrPtr2+1	; StrPtr2 will now point to the string itself	lda (StrPtr2)	; is string null by chance?	beq @next	; yes, so try next string	ldy #1	; want to compare against first char of string	lda (StrPtr2),y*** 2-Feb-93 DAL -- Mask off bit 7 like the sorting does	and #$7F*** end 2-Feb-93	cmp #'a'	; convert to upper case for compare	blt @upper	cmp #'z'+1	bge @upper	and #$DF	; make it upper case@upper	cmp NavChar	; is string less than key pressed?	bge @found	; greater or equal, so that's the one@next	inc NavIndex	lda NavIndex	cmp ListCount	; did we go past the end of the list?	bne @loop	; no, so try again	dec NavIndex	; past end of list, so choose the last one; Re-draw the list with the selected item highlighted@found	lda NavIndex	ina	; add 1 for 1-based index	sta LastSel	;indicate that this	was the last selection	jsr DrawList	;then highlight the	selected item@exit	jmp GKLoop	;key pressed was not usable	******************************************** Return Key Pressed*******************************************GK9	; 	pha	lda #2	;test Bit 1 of the List Options byte	bit ListOpt	;and see if marking is on	beq NoMark	;if not set, then marking is off	lda #$80	;make a mark	jsr MakeMark	;NoMark	lda LastSel	;here is our selection to be returned	ldy #SelIndex	;point to the field within the record	sta (MyPtr),y	;update the field	pla	;restore accumulator	rts	;and leaveDrawList		;	jsr CalcWindow	;calculate the WindowSize, TopIndex & MoreFlag	ldx TopIndex	;get the index of the first item in the list	ldy YPos	;start at the first position in the window 	sty MYPos	;this is the temporary vertical positionNxtStr	phx	;this is the index into the string array	ldx XPos	;this is the starting horizontal position	ldy MYPos	;and the current y position	lda #CD_GotoXY	;move the cursor to the current XY position	jsr StartAsm	;calling the console driver internal entry point	plx	;get the index	jsr DrawItem	;draw this item	cpx ListCount	;are we at the bottom of the list?	beq @DL1	;if so, we are done with DrawList	lda Csr_Y	;get the current cursor position	cmp Wind_B	;are we at the bottom of the window?	beq @DL1	;	inx	;increment the index	inc MYPos	;update the Ypos for the next item	lda MYPos	;add the increment	clc		adc inc	sta MYPos	;	bra NxtStr@DL1	bit MoreFlag	;check to see if "More" needs to be written	beq @DL2	;if zero, then no "More" is no required	lda TopIndex	cmp MoreFlag	;is the TopIndex => MoreFlag?	bge @DL2	;if so, then dont display "More"	lda #$80	;high bit in accumulator means to draw it	jsr DrawMore	;draw it on the screen@DL2	sec	;Update the temporary Y position for the beginning of the list	lda LastSel	;get the current selection	sbc TopIndex	;compare it to the Top index limit	bmi @DL3	;if the LastSel<TopIndex or LastSel = TopIndex	beq @DL3	;then MyPos = 1.	sta MYPos	;if LastSel>TopIndex then MYPos = LastSel - TopIndex	bra DispDun@DL3	stz MYPos	;otherwise, start at the first item in the listDispDun	clc	;now add back the orignal Vertical position	adc YPos	;	sta MYPos	;and Update the temporary vertical position	rts		******************************************** Draw the "More" prompt*******************************************DrawMore		; 	phx	;save the x register	pha	;and the accumulator	lda Wind_R	;get the position of the right window	sec	;	sbc Wind_L	;subtract it from the left to get the window width	lsr a	;divide by 2 to find the center	sbc #3	;and then subtract 3	clc	adc Wind_L	;add it to the left window position	tay	;into the y register	lda Wind_B	;get the bottom of the window	inc a	;add one more	jsr SetLi	;move the cursor to that line	pla	;recover the accumulator from the entry	bpl ClearMore	;if high bit is clear, then erase "More"	ldx #0	;set the index to zero MorLoop	lda More,x	;move each character to the screen	beq DM1	;until the character loaded is zero	ora #$80	;set the high bit	jsr To_Scrn	;put it on the screen	iny	;increment the y register to move the cursor	inx	;next character	bra MorLoop	;ClearMore	ldx #6	;draw 6 - characters to erase "More"	lda #$4c	;mousetext is on!ClrLoop	jsr To_Scrn	;to the screen	iny	;move the cursor	dex	;until x = 0	bne ClrLoop	;DM1	lda CSR_Y	;restore the orginal cursor postion	jsr SetLi	;	plx	;restore x	rts	More	DC.B ' More '	DC.B $00************************************************************* This routine Draws the Item in the list that is passed* to it in the x register.************************************************************DrawItem	;	lda StrPtr+1	;MSD: preserve high byte of StrPtr	pha	;MSD: on stack	phx	;save the X register	txa	;transfer to the a register	dec a	;decrement by 1, since item 1 is = to array 0.	asl a	;multiply by two	bcc @noinc	;MSD: carry into high byte?	inc StrPtr+1	;MSD: yes, so fudge pointer@noinc	tay	;and get the pointers to the string	lda (StrPtr),y	;	pha	;onto the stack for temporary storage	iny	;	lda (StrPtr),y	;get the upper byte of the pointer	pha	;onto the stack	phx	;transfer the x to y.	ply	;	bit ListOpt	;test the high bit of ListOptions	bpl WLP3	;if not set, then multiple selections not enabled	lda (ArrayPtr),y	;get input from the selection array	bpl WLP2	;if the high bit is set, then this item is selected	lda #$80	;flag to indicate that the flag is to be drawn	jsr MakeMark	;	bra WLP1	;WLP2	lda #0	;flag to indicate that a space is to be drawn 	jsr MakeMark	;WLP1	inc CSR_X	;move the x position one space to the rightWLP3	lda #$80	;turn off control characters		sta ContOff	;	ply	;get the pointers back from the stack	plx	;	WritePointer	;Write the string 	stz ContOff	;restore control characters	lda #4	;check to see if the fill bit is on	bit ListOpt	beq NoFill	WriteChar ClEol	;clear to the end of lineNoFill	plx	;restore the x register	pla	;MSD: restore high byte of StrPtr	sta StrPtr+1	;MSD	rts	;and return	************************************************************* This routine calculates the window size in lines and the* index number for the first line in the window as well as* the MoreFlag indicator************************************************************CalcWindow	;	lda Wind_B	;subtract the window bottom from the	sec	;window top to get the number of lines	sbc Wind_T	;	inc a	;add one more for correct number of printable lines	sta WindowSize		lda ListCount	;compare the Array Size to the Window Size	cmp WindowSize	blt CW1	;branch if less than or equal to	beq CW1	;WindowSize	sec		sbc WindowSize	;subtract the WindowSize from the Array Count	inc a	;add one more for the upper limit of TopIndex	sta MoreFlag	;MoreFlag now contains the upper TopIndex limit	bra CW2CW1	stz MoreFlag	;If MoreFlag = 0, then More is never displayed	lda #1	;set TopIndex = 0	bra CW3CW2	lda LastSel	;when entered, this value = Selected Index	cmp MoreFlag	;compare the Selection Index to the TopIndex limit	blt CW3	;if less than or equal, then the TopIndex = SelIndex	beq CW3	;	lda MoreFlag	;otherwise, TopIndex = TopIndex limit	sta TopIndex	bra CWDoneCW3	sta TopIndexCWDone	rts			ENDP************************************************************* MakeMark places a mousetext check mark beside the* current item in the list.************************************************************	MakeMark	PROC Export	Import ConsData:ConsRec	import ListData:ListRec	with ConsData	with ListData	phx	;save the x register	php	;and the status flags	lda Csr_Y	;get the current vertical cursor position	sec	;and subtract it from the window top	sbc Wind_T	;to find the local position	tay	;into the y register	ldx XPos	;get the current horizontal position	dex	;move to the left twice	dex	;	lda #CD_GotoXY	;move the cursor	Jsr StartAsm	;	plp	;recover the status flag	bpl EraseMark	;if the zero flag is clear, erase the mark	WriteCStr CheckMark	;print the check mark	plx	;recover x 	rts	;and returnEraseMark	ldy Csr_X	;get the current horizontal position	lda #$A0	;this is the space character used to erase	jsr To_Scrn	;out to the screen	inc Csr_X	;move the cursor	plx	;recover x	rts	;and returnCheckMark		; 	DC.B MTON	;turn mousetext on	DC.B 'D'	;this is the mousetext character for a check mark	DC.B MTOFF	;turn mousetext off	DC.B $00	;termination character	ENDP	;end of ListHandler procedure************************************************************* WritePointer prints a Pascal Type String to the current* console driver position.************************************************************	WritePointer	PROC Export	Import ConsData:ConsRec	with ConsData	ldy #0	;set y index to zero	lda (ListPtr),y	;get the length of the string	sta StrLen	;update StrLen in WrtParms	stz StrLen+1	;Pascal strings are 1..255	ldx ListPtr	;get the pointer to the string passed in List Pointer	inx	;and one to go past the length byte	bne WP1	;if not zero, the high byte does not need to be	inc ListPtr+1	;updatedWP1	stx StringPtr	;update StringPtr in WrtParms	lda ListPtr+1	;both the high and low bytes	sta StringPtr+1	;	ldx #WrtParms	;set up the parameters to make the call	ldy #>WrtParms	;	lda #CD_Write	;the write console driver command	jsr StartAsm	;print it	rts	;and return	ENDP************************************************************ Message - Assists	in the writing of Error messages to* the screen.*       Parameter List: *       MessageOptFlag  Byte    <--     *               B7 - Alert/Dialog Bit (Alert has ok only, Dialog has OK & cancel) Alert = High.*               B6 - DrawBox Only*               B5 - Restore Box Only*       Message	    Word    <--*       FilterProc	    Word    <--*       FrameRect	    Long    <--*       WindowBuffer    Word    <--** Rick Hoiberg 7/27/87***********************************************************	Message	PROC Export	;next Err # = 9	Import ConsData:ConsRec	with ConsDataNoDebug	equ 1	;this is set to one	for a NoDebug ReleaseMessOptByte	equ 0MessagePtr	equ 1FilterProc	equ 3FramRect	equ 5WindBuff	equ 9	ldy #MessOptByte	;get the option byte	lda (ListPtr),y	bpl DoBox	and #$80DoBox	sta MessOpt	ldy #MessagePtr	;get the text to be	printed in the box.	lda (ListPtr),y	sta MessPtr	;and store it our ParmList	iny	lda (ListPtr),y	sta MessPtr+1	ldy #FilterProc	;Get the Filter Procedure	lda (ListPtr),y	sta DoProc+1	;list count	iny	lda (ListPtr),y	sta DoProc+2Mess1	ldy #WindBuff	;number of items in	array	lda (ListPtr),y	sta WindowBuffer	;Get the Windowbuffer	iny	lda (ListPtr),y	sta WindowBuffer+1	ldx #0	;and the Frame Rectangle	ldy #FramRect	;the X position of where to startFrameLoop	lda (ListPtr),y	sta rect,x	iny	inx	cpx #4	bne FrameLoop	lda #%00100000	;Check to see if it	is a Restore Only 	bit MessOpt	;operation	beq GoAhead	;if not, continue	jmp RestoreBoxGoAhead	jsr DrawBox	;Draw the Box and save the current window	bit MessOpt	;is this a DrawBox only operation?	bvc WriteMessage	;if not, continue	rts	;if so, we are done.WriteMessage	ldx MessPtr	;Write the message to the screen	ldy MessPtr+1	jsr Writeit	;and let the Macro do the Rest	lda DoProc+2	;is there a filter procedure?	beq WaitHere	;there is no Filter	Procedure	jsr DoProc	;Do the procedure via patched JmpWaitHere		; 	bit MessOpt	;is this an Alert?	bmi AlertBox	WriteCStr DialogPmt	;no, so draw dialog	prompt	bra GetMyKeyAlertBox	WriteCStr AlertPmt	;Draw the alert promptGetMyKey	GetKey	;wait for a keypress	pha	cmp #Return	;is the Key a Return?	beq GoodKey	;isss good...	IF  NoDebug	GOTO .NoCrash	cmp #$7f	;use the Delete key	for debugging	beq Brk.NoCrash	bit MessOpt	;is this an Alert?	bmi MyKey	;if so, the only acceptable key is Return	cmp #Escape	;if it is a dialog,	check for Escape	beq GoodKeyMyKey	pla	;restore the stack	bra GetMyKey	;wait for the next key.GoodKey	jsr RestoreBox	;got our key, now restore the Original window	pla	;indicate which key	was pressed	rts	;and return.Brk	brk	;Crash and burn, please?DrawBox		; 	Status StatusBuff	;get the original window	dec Rect	;save area X1 = Rect X1-1	inc Rect+2	;save area X2 = Rect X2+1	inc Rect+3	;save area Y2 = Rect Y2+1	SViewPort Rect	;set the viewport for the save area	inc Rect	;restore Rect	dec Rect+2	dec Rect+3	StoreWind WindowBuffer ;save the original window	   	WriteChar RstWind	;Clear the original	window	FrameRect Rect	;and draw the rectangle	inc Rect+1	;MessWind Y1 = Rect	Y1+1	dec Rect+2	;MessWind X2 = Rect	X2-1	SViewPort Rect	dec Rect+1	;restore Rect	inc Rect+2	WriteChar ClrWind	;clear the Box	lda #$80	sta DrawFlag	;indicate that there is valid window data	rts	;in WindowBuffer & OrigWindowRestoreBox		; 	bit DrawFlag	;is the window data	in valid?	bpl NoRestore	;if not, don't do anything	dec Rect	;save area X1 = Rect X1-1	inc Rect+2	;save area X2 = Rect X2+1	inc Rect+3	;save area Y2 = Rect Y2+1	SViewPort Rect	;set the viewport to the save area	RestorWind WindowBuffer ;restore the original window	SViewPort OrigWindow ;and the original viewport	stz DrawFlagNoRestore	rtsWriteit		;	stx StrPtr	;here is the pointer to the string	sty StrPtr+1	ldy #0	;get the length of the string	lda (StrPtr),y	;	tax	;into the x registerWriteOne	iny	;index into the string          	lda (StrPtr),y	;get the character	cmp #'^'	;is the character an "^"?	beq DoParm	;if so, check the TextPtrsSendIt	phx	;it wasn't so send the character to the	phy	;console driver one	byte at a time	tax	;using the x register	lda #CD_WriteChar	;write character command	jsr StartAsm	;this is the internal console entry point	ply	;restore x and y	plxNextChar	dex	;until we reach the	end of the string	bne WriteOne	;	rtsDoParm		;	iny	;the next character	in the string	lda (StrPtr),y	;get it	cmp #'0'	;is the character a	0?	blt @2	;if it is less than	0, send it	cmp #'4'	;if it is greater than 3, send it	bge @2	phy	;save the registers	phx	;	and #$0f	asl a	;times 2	tay	lda TextPtrs,y	;	iny	;increment the index	ora TextPtrs,y	;the parameters are	pointing to a string	bne @1	;print string if pointer is not null	plx	;the pointer was a null byte, so restore x and y	ply	;@2	dey	;set y back to its original value	lda #'^'	;restore ^ back to accumulator	bra Sendit	;and send it@1	lda TextPtrs,y	;get the high byte	tax	;into the x register for now	dey	;decrement y to point to the low byte	lda TextPtrs,y	;get the low byte	phx	;transfer x register to the y register	ply	;high byte into y	tax	;low byte into the x register from A	WritePointer	;print the string pointed to	plx	;restore x and y	dex	;clear off one of the counts from x	ply	;restore y	jmp NextChar	;return to the WriteIt loopDoProc	jmp 0	;self-modifyingMessPtr	DS.B 2WindowBuffer	DS.B 2MessOpt	DS.B 1Rect	DS.B 4DrawFlag	DC.B $00StatusBuff		; 	DS.B 2OrigWindow	DS.B 4	DS.B 1DialogPmt	DC.B CPOS	DC.B 1	DC.B 5	DC.B 'Cancel: Esc'	DC.B CPOS	DC.B 54	DC.B 5	DC.B 'OK: '	DC.B MTON	DC.B 'M'	DC.B MTOFF	DC.B $00AlertPmt		; 	DC.B CPOS	DC.B 54	DC.B 5	DC.B 'OK: '	DC.B MTON	DC.B 'M'	DC.B MTOFF	DC.B $00	entry ConsDrvrEndConsDrvrEnd		;               	ENDP