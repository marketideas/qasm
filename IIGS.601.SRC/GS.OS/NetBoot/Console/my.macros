	MACRO&LAB	WriteCStr &N1&LAB	LDX #&N1	ldy #>&N1	lda #8	jsr StartAsm	MEND	MACRO&lab	WriteChar &Char&lab	ldx #&Char	lda #CD_WriteChar	jsr StartAsm	mend	macro&lab	Bell&lab	ldx #7	lda #CD_WriteChar	jsr StartAsm	mend	macro&lab	GetKey&lab	lda #6	jsr StartAsm	mend	macro&lab	GotoXY &X,&Y&lab	ldx #&X	ldy #&Y	lda #9	jsr StartAsm	mend	macro&lab	ReptChar &RCParms&lab	ldx #&RCParms	ldy #>&RCParms	lda #1	jsr StartAsm	mend	macro&lab	WriteStr &Str&Lab	ldx #&Str	ldy #>&Str	lda #CD_WrtPtr	jsr StartAsm	mend	macro&lab	WritePointer&lab	lda #CD_WrtPtr	jsr StartAsm	mend	macro&lab	SViewPort &SVParms&lab	ldx #&SVParms	ldy #>&SVParms	lda #CD_DoViewPort	jsr StartAsm	mend	macro&lab	FrameRect &N1&Lab	ldx #&N1	ldy #>&N1	lda #$0b	jsr StartAsm	mend	macro&lab	GetXY&lab	lda #2	jsr StartAsm	mend	macro&LAB	StoreWind &WindBuff&LAB	ldx &WindBuff	ldy &WindBuff+1	lda #4	jsr StartAsm	MEND	macro&LAB	RestorWind &WindBuff&LAB	ldx &WindBuff	ldy &WindBuff+1	lda #5	jsr StartAsm	MEND	macro&lab	Status &N1&Lab	ldx #&N1	ldy #>&N1	lda #$03	jsr StartAsm	mend	macro&lab	PullWord &Word&Lab	pla	sta &Word	pla	sta &Word+1	mend		macro&lab	_CompareStr&Lab	lda #CD_CompareStr	pha	;this needs to be done because we are	pha	;calling internally.	jsr StartAsm	pla	;restore the stack	pla	mend		macro&lab	_MoveStr&Lab	lda #CD_MoveStr	pha	;this needs to be done because we are	pha	;calling internally.	jsr StartAsm	pla	;restore the stack	pla	mend		macro&lab	_NextStr&Lab	lda #CD_NextStr	pha	;this needs to be done because we are	pha	;calling internally.	jsr StartAsm	pla	;restore the stack	pla	mend;...............................................................;;        Push 2 bytes onto stack;;    pushword loc     -- pushes bytes onto stack from 'loc';    pushword #n      -- pushes constant #n onto stack;...............................................................	MACRO&lab	pushword &addr	longa off	IF &addr[1:1]='#' THEN&lab	  lda #>&addr[2:255]	  pha	  lda #<&addr[2:255]	  pha	ELSE&lab	  lda &addr+1	  pha	  lda &addr	  pha	ENDIF	MEND