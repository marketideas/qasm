	macro&lab	str &stuff	string pascal&lab	dc.b &stuff	string asis	mend	macro&lab	cstr &stuff	string c&lab	dc.b &stuff	string asis	mend	macro&lab	InitConsole&lab	ldy #>InitParm	ldx #<InitParm	lda #0	jsr ConsDrvr	mend	MACRO&LAB	WriteCStr &N1&LAB	LDX #<&N1	ldy #>&N1	lda #8	jsr ConsDrvr	MEND	MACRO&LAB	ClrEol&LAB	LDX #$C	LDA #7	JSR ConsDrvr	MEND	MACRO&LAB	Home&LAB	LDX #$0C	LDA #4	JSR ConsDrvr	MEND	MACRO&lab	WriteChar &Char&lab	ldx #&Char	lda #7	jsr ConsDrvr	mend	macro&lab	Bell&lab	ldx #7	lda #7	jsr ConsDrvr	mend	macro&lab	GetKey&lab	lda #6	jsr ConsDrvr	mend	macro&lab	GotoXY &X,&Y&lab	ldx #&X	ldy #&Y	lda #CD_GotoXY	jsr ConsDrvr	mend	macro&lab	GetXY&lab	lda #2	jsr ConsDrvr	mend	macro&lab	ReptChar &RCParms&lab	ldx #<&RCParms	ldy #>&RCParms	lda #1	jsr ConsDrvr	mend	macro&lab	Input &InParms&lab	ldx #<&InParms	ldy #>&InParms	lda #$0a	jsr ConsDrvr	mend	macro&lab	SViewPort &SVParms&lab	ldx #<&SVParms	ldy #>&SVParms	lda #CD_DoViewPort	jsr ConsDrvr	mend	macro&lab	FrameRect &N1&Lab	ldx #<&N1	ldy #>&N1	lda #$0b	jsr ConsDrvr	mend	macro&lab	WriteStr &Str&Lab	ldx #<&Str	ldy #>&Str	lda #CD_WrtPtr	jsr ConsDrvr	mend	macro&LAB	StoreWind &WindBuff&LAB	ldx #<&WindBuff	ldy #>&WindBuff	lda #4	jsr ConsDrvr	MEND	macro&LAB	RestorWind &WindBuff&LAB	ldx #<&WindBuff	ldy #>&WindBuff	lda #5	jsr ConsDrvr	MEND	macro&lab	ListHandler &ListParms&lab	ldx #<&ListParms	ldy #>&ListParms	lda #CD_ListHandler	jsr ConsDrvr	mend	macro&lab	WritePointer&lab	lda #CD_WrtPtr	jsr ConsDrvr	mend	macro&lab	CursorOff&lab	ldx #0	lda #CD_SetCursor	jsr ConsDrvr	mend	macro&lab	Message &MessParm&lab	ldx #<&MessParm	ldy #>&MessParm	lda #CD_Message	jsr ConsDrvr	mend	macro&lab	CenterStr &Str&Lab	ldx #<&Str	ldy #>&Str	lda #CD_CenterStr	jsr ConsDrvr	mend	macro&lab	PrintHex &Str&Lab	ldx #<&Str	ldy #>&Str	lda #CD_PrintHex	jsr ConsDrvr	mend	macro&lab	ParmText &List&Lab	ldx #<&List	ldy #>&List	lda #CD_ParmText	jsr ConsDrvr	mend	macro&lab	PullWord &Word&Lab	pla	sta &Word	pla	sta &Word+1	mend	macro&lab	_CompareStr&Lab	lda #CD_CompareStr	jsr ConsDrvr	mend	macro&lab	_MoveStr&Lab	lda #CD_MoveStr	jsr ConsDrvr	mend	macro&lab	_NextStr&Lab	lda #CD_NextStr	jsr ConsDrvr	mend	macro&lab	_SortArray&Lab	lda #CD_SortArray	jsr ConsDrvr	mend	macro&lab	_FindItem&Lab	lda #CD_FindItem	jsr ConsDrvr	mend;...............................................................;;        Push 2 bytes onto stack;;    pushword loc     -- pushes bytes onto stack from 'loc';    pushword #n      -- pushes constant #n onto stack;...............................................................	MACRO&lab	pushword &addr	longa off	IF &addr[1:1]='#' THEN&lab	  lda #>&addr[2:255]	  pha	  lda #<&addr[2:255]	  pha	ELSE&lab	  lda &addr+1	  pha	  lda &addr	  pha	ENDIF	MEND