;-----------------------------------------------;;   Imported addresses;;-----------------------------------------------	IMPORT	APrefix	IMPORT	BuildAFPro	IMPORT	ByeBye	IMPORT	ConsDrvr	IMPORT	InsQuit	IMPORT	Setatinit	IMPORT	a192	IMPORT	access	IMPORT	chooser	IMPORT	cxfer	IMPORT	logoff	IMPORT	logon	IMPORT	mecc	IMPORT	namer	IMPORT	off**************************************************************************				selector.asm**	Copyright Apple Computer Inc., 1987*	All rights reserved**	Written by  Richard B. Hoiberg*	Created: 1-Jun-87**	Modification history:** 10-Jul-92 MSD	Ported to MPW environment.  Added NetPrefs application*		for Apple II Ethernet Card.*************************************************************************		longa 	off		longi	off		MACHINE	M65C02			INCLUDE	'cons.macros'		INCLUDE	'console.equates'mli		equ	$BF00Open		equ	$c8Read		equ	$caClose		equ	$ccRomIn		equ	$c082SetVid		equ	$fe93SetKbd		equ	$fe89Home		equ	$fc58Clr80Vid	equ	$c00cSetAltChar	equ	$c00fClr80Col	equ	$c000OurPath		equ	$280BasStart	equ	$2000		EXPORT	Selector	Selector	PROC		export	ErrorHandler		import	LoaderLen:equ		import	Bottom		CrHB		equ   	$8dTabHB		equ	$89WindowBuff	equ	$8000StgPtr		equ	$83StgPtr2		equ	$85IOBuff		equ	$9600ZP		equ	$1000MySelector	equ	0			;this is equal to zero for workstation selectorBuildDisk	equ	0			;this is equal to one for build utilityNull		equ	0				jsr	InsQuit		InitConsole 		FrameRect FrameParms1		SViewPort MainWindow		WriteCStr Title		ReptChar TitLine		CursorOffSelect1		jsr	ClearWindow		GotoXY	5,4		WriteCStr SelectApp		FrameRect FrameParms3		WriteCStr Prompt1GoList	; 		SViewPort ListWindow		WriteChar ClrWind		ldx	#1		stx	SelIndex		lda	#TitleArray		sta	StgArrayPtr		lda	#>TitleArray		sta	StgArrayPtr+1		lda	AppCount		sta	ArrayCnt		stz	SelXPos		stz	SelYPos		stz	Increment		ldx	#4			;set for fill mode		stx	ListOptByte		ListHandler ListParms		lda	SelIndex		beq	quitSel		dec	a		asl	a		tay		lda	#PathArray		sta	StgPtr2		lda	#>PathArray		sta	StgPtr2+1		lda	(StgPtr2),y		pha		iny		lda	(StgPtr2),y		tax				;the high byte into the X register for LaunchApp		ply				;the low byte of the path into the Y reg		jsr	LaunchApp		;off we go never to return		jmp	Select1QuitSel	; 		ldy	#0		ldx	#2		jsr	ErrorHandler		cmp	#Return		bne	QS1		jmp	ByeByeQS1	; 		jmp	GoList			;Temp fix for nowLaunchApp	; 		sty	StgPtr		stx	StgPtr+1		lda	#0			;CLEAR THE PRODOS SYSTEM MAP		tayCLRBM		sta	$BF58,Y			;    		iny		cpy	#23         		;22 TIMES		bne	CLRBM		lda	#1          		;SET THE 23RD BIT TO ONE		sta	$BF58,Y        		;		lda	#$cf		sta	$bf58* SET UP THE PATH TO FIND THE REST OF THE FILES		ldy	#0		lda	(StgPtr),y		tax		sta	OurPath,yMuvLup		iny		lda	(StgPtr),y		sta	OurPath,y		dex		bne	MuvLup		jsr	mli	DC.B	$c6	DC.W	SetPrefix 		bcc 	Doit 		ldy	#$80 		ldx	#0		jsr	ErrorHandler		rtsDoIt	;  		ldx	#00 			;ELSE NEW INDEX TO 0MovLP 		lda 	ZPLabel,X 		;MOVING LOADER CODE TO PAGE ZERO 		sta	zp,X 			;ONE AT A TIME 		inx  				;NEXT ONE 		cpx 	#LoaderLen 		;WAS THAT THE LAST ONE 		bne 	MovLP			;TAKEN IF NOT 		jmp 	zp 			;GIVE THE SHOW TO LOADERUpdatePtr	; 		inc	StgPtr2		bne	UP2		inc	StgPtr2+1UP2		rts************************************************** MovStr moves a Pascal type string to 		** the buffer pointed to by StgPtr. 		** 						** The string to be moved is passed with 	** the A register containing the low		** byte of the pointer and the X			** register contains the high byte.		** The Y register is the Offset.			************************************************** 			MovStr	; 		sta	StgPtr2		stx	StgPtr2+1		sty	YTemp		ldy	#0		lda	(StgPtr2),y		tax					;number of characters to transfer		php		ldy	YTemp		sta	(StgPtr),y		plp		beq	MStr3		inc	YTemp		inc	StgPtr2		bne	MStr1		inc	StgPtr2+1MStr1		ldy	#0MStr2	; 		phy		lda	(StgPtr2),y		ldy	YTemp		sta	(StgPtr),y		inc	YTemp		ply		iny		dex		bne	MStr2MStr3		rts		DoGetInput	; 		GotoXY	0,10		ReptChar TitLine		WriteCStr Prompt2		GotoXY 	3,11		WriteCStr Prompt1		GotoXY 	3,15		WriteCStr PassField		GotoXY 	3,13		WriteCStr NameField		GotoXY	9,13		WriteStr NameBuffer		jmp	GN2GetName		stz	OptionByte		lda	#32		sta	MyLen		lda	#NameBuffer		sta	InBuff		lda	#>NameBuffer		sta	InBuff+1		GotoXY	9,13		Input	MyParms		cmp	#Return		beq	GNDun		cmp	#Escape		bne	GN2		sec		rtsGN2		lda	#08		sta	MyLen		lda	#PassBuffer		sta	InBuff		lda	#>PassBuffer		stz	PassBuffer		sta	InBuff+1		lda	#$80		sta	OptionByte		GotoXY	13,15		Input	MyParms		cmp	#Return		beq	GNDun		cmp	#Escape		bne	GN3		sec		rtsGN3		jmp	GetNameGNDun	; 		clc					;indicate that Return was pressed! 		rts			ClearWindow	; 		lda	#3		sta	MainWindow+1		SViewPort MainWindow		WriteChar ClrWind		lda	#1		sta	MainWindow+1		SViewPort MainWindow		rts			ErrorHandler	; ;next Err # = 9		cpy	#0		bmi	YIsGood		ldy	#0YIsGood	; 		txa		asl	a		tax		lda	MessTbl,x		;get the low byte of pointer to the String		sta	MessPtr			;into the Y register for a second		lda	FilProcTbl,x		sta	FilterProc		inx				;increment the pointer		lda	MessTbl,x		;get the high byte of pointer to the String			sta	MessPtr+1		;		lda	FilProcTbl,x		sta	FilterProc+1		sty	MessOptGoMessage	Message	MessParms		rtsPathProc	; 		GetXY		ldx	#1		lda	#CD_GotoXY		jsr	ConsDrvr		ldx	#<OurPath		ldy	#>OurPath		WritePointer		rtsPrefixProc	; 		GetXY		ldx	#1		lda	#CD_GotoXY		jsr	ConsDrvr		ldx	SetPrefix+1		ldy	SetPrefix+2		WritePointer		rtsInitParm	DC.B	$80MyParms	; OptionByte	DC.B	$00	;option ByteMyLen		DS.B 1				;maximum input lengthInBuff		DS.B 2				;Buffer for input/output	DC.W	MyTermList	;Termination CharactersMessParms	; MessOpt		DS.B 1MessPtr		DS.B 2FilterProc	DC.B	$00,$00Rect	; 	DC.B	10	;x1	DC.B	9	;y1	DC.B	70	;x2	DC.B	15	;y2WindBuff	DC.W	WindowBuffNameBuffer	DC.B	$03	DC.B	'ROD'	;Thank you Rick!!! fm: Jack		DS.B 32		PassBuffer	DC.B	$00	DC.B	'PassWord'      		NameField	DC.B	'Name: '	DC.B	$00PassField	DC.B	'Password:'	DC.B	$00	MyTermList	; 	DC.B	$03	DC.B	Escape	DC.B	TabHB	DC.B	CrHB	;3 characters Esc, Tab and Return	ListParms	; SelXPos		DS.B 1SelYPos		DS.B 1Increment		DS.B 1ArrayCnt		DS.B 1StgArrayPtr		DS.B 2SelArray	DC.W	0SelIndex		DS.B 1ListOptByte		DS.B 1YTemp		DS.B 1FrameParms1	; Point1	DC.B	15	;x1	DC.B	00	;y1Point2	DC.B	65	;x2	DC.B	20	;y2FrameParms3	; 	DC.B	5	;x1	DC.B	5	;y1 viewport+1	DC.B	45	;x2 viewport-1	DC.B	14	;y2         	MainWindow	DC.B	15	DC.B	1	DC.B	64	DC.B	20ListWindow	DC.B	20	DC.B	7	DC.B	59	DC.B	15         	SelectApp	Cstr	'Select an application to run:'Mess0	; 	DC.B	(Mess0End-Mess0)-1	DC.B	Return	DC.B	' An error occurred setting the startup prefix:'	DC.B	Return	DC.B	ReturnMess0End	; Mess1	; 	DC.B	(Mess1End-Mess1)-1	DC.B	Return	DC.B	' An error occurred launching the path:'	DC.B	Return	DC.B	ReturnMess1End	; Mess2	; 	DC.B	(Mess2End-Mess2)-1	DC.B	Return	DC.B	'  Do you want to quit the Workstation Selector program?'Mess2End	; MessTbl	DC.W	Mess0	DC.W	Mess1	DC.W	Mess2         	FilProcTbl	; 	DC.W	PrefixProc	DC.W	PathProc	DC.W	NullPrompt1	; 	DC.B	CPOS	DC.B	1	DC.B	19	DC.B	'Select:'	DC.B	MTON	DC.B	'K J'	DC.B	MTOFF	DC.B	CPOS	DC.B	20	DC.B	19	DC.B	'Quit: Esc'	DC.B	CPOS	DC.B	40	DC.B	19	DC.B	'Accept:'	DC.B	MTON	DC.B	'M'	DC.B	MTOFF	DC.B	$00		Prompt2	DC.B	CPOS	DC.B	1	DC.B	5	DC.B	'OK: '	DC.B	MTON	DC.B	'M'	DC.B	MTOFF	DC.B	CPOS	DC.B	45	DC.B	5	DC.B	'Cancel: Esc'	DC.B	$00			TitLine	; 	DC.W	ULChars	DC.W	5ULChars	; 	DC.B	MTON	DC.B	ReptCharLinCnt	DC.B	50	DC.B	'L'	;top of the window underline character	DC.B	MTOFFSetPrefix	; 	DC.B	$01	DC.W	Bottom-18		APPCount	DC.B	$09Title	DC.B	'  '	DC.B	MTON	DC.B	'A'	DC.B	MTOFF	DC.B	' AppleShare II Workstation V1.1d1 '	DC.B	Inv	DC.B	CLEOL	DC.B	Norm	DC.B	CR	DC.B	$00	;end of C StringTitleArray	; 	DC.W	Title1	DC.W	Title2	DC.W	Title3	DC.W	Title4	DC.W	Title5	DC.W	Title6	DC.W	Title7	DC.W	Title8	DC.W	Title9PathArray	; 	DC.W	Path1	DC.W	Path2	DC.W	Path3	DC.W	Path4	DC.W	Path5	DC.W	Path6	DC.W	Path7	DC.W	Path8	DC.W	Path9		Title1		str	'Access Privileges'Path1		str	'sys.apps/access/access'Title2		str	'Chooser II'Path2		str	'sys.apps/chooser/chooser.ii'Title3		str	'FastCopy'Path3		str	'fast.copy'Title4		str	'File Server Log On'Path4		str	'sys.apps/logon'Title5		str	'File Server Log Off'Path5		str	'sys.apps/logoff'Title6		str	'Printer Namer'Path6		str	'sys.apps/namer/Namer.ii'Title7		str	'ProDOS BASIC'Path7		str	'Sys.Apps/BASIC.System'Title8		str	'System Utilities'Path8		str	'sys.apps/system.util/sysutil.system'Title9		str	'Apple IIGS Network Preferences'Path9		str	'sys.apps/net.prefs'ZPLabel		ENDPZPLoaderORG	proc	temporg $1000		export	LoaderLen:equ		import	ErrorHandler		ZPLoader	; 		jsr	mli 			;ISSUE THE PRODOS OPEN COMMAND	DC.B	OPEN	;	DC.W	LaunOpen	;		beq	OpenOk		ldy	#$80		ldx	#1		jsr	ErrorHandler	  	rtsOpenOk 		lda 	OpenRef 			;GET A REF NUM 		sta 	ReadRef 		;SAVE IT FOR READ		jsr	mli 			;AND ISSUE THE READ COMMAND	DC.B	READ	;	DC.W	LaunRead	;	  	beq	ReadOk	  	rtsReadOk		jsr	mli			;AND NOW ISSUE THE CLOSE COMMAND	DC.B	CLOSE	;	DC.W	LaunClose	;  		cld 		lda 	RomIn			 		jsr 	SetVid			 		jsr	SetKbd					jsr	Home			 		sta 	Clr80Vid		 		sta	SetAltChar		 		sta	Clr80Col			 	jmp	BasStartLaunOpen	; 	DC.B	3	DC.W	OurPath	DC.W	$bb00OpenRef		DS.B 1*LaunRead	; 	DC.B	4ReadRef		DS.B 1	DC.W	$2000	DC.W	$ffff	DC.W	0000*LaunClose	; 	DC.B	1	DC.B	0LdrBottom	; LoaderLen	equ	LdrBottom-ZPLoader	;objend		endp				end