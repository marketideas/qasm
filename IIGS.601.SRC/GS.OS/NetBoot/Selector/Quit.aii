		Machine M65C02;------------------------------------------;; Equates from procedure ;;------------------------------------------MOVE		equ	$FE2CA1		equ	$3CA2		equ	$3EA4		equ	$42COUT		equ 	$FDEDkbdstrb	equ	$c010kbd		equ	$c000 MVTAB		equ	$FB5BLastDev		equ	$bf30mli		equ	$bf00Clr80Vid	equ	$c00cclraltchar	equ	$c00eclr80col	equ	$c000setnorm		equ	$fe84setvid		equ	$fe93setkbd		equ	$fe89RomIn		equ	$c082init		equ	$fb2fOurPath		equ	$280int_start 	equ 	$2000IO_BUFF 	EQU 	$9600qdest 		EQU 	$D100 qHOME 		EQU 	$FC58StgPtr		equ	$83VARPNT 		EQU 	$83FORPNT 		EQU 	$85CHKCOM 		EQU 	$DEBEPTRGET 		EQU 	$DFE3WHERE 		EQU 	$5EBUFPTR 		EQU 	$FALEN 		EQU 	$FCSYSMAP 		EQU 	$BF58DEVLST 		EQU 	$BF32DEVCNT 		EQU 	$BF31qspkr		equ	$c030ch		equ	$24;OURPATH	GEQU	$280			;PATH FROM WHERE WE CAME FROM;STGPTR		GEQU	$FA;MLI		GEQU	$BF00		macro&lab		str	&parm		string	pascal&lab		dc.b	&parm		string	asis		endm		InsQuit		proc	export		import	APrefix:equ		import	Bottom;APrefix	equ	Bottom-18*MOVBEG	; 		lda	LastDev		sta	UnitNum		jsr	mli	DC.B	$c5	DC.W	OnLine		lda	OnLinBuf		and	#$0f		tay		inc	a		inc	a		sta	Bottom-18		; APrefix		lda	#'/'		sta	Bottom-17		; APrefix+1		sta	Bottom-16,yTheLoop		lda	OnLinBuf,y		sta	Bottom-17,y		dey		bne	TheLoop		lda	#<qdest			;Set up the zero page registers		STA	A4			;for the Apple // monitor move		LDA	#>qdest			;routine		STA	A4+1			;Destination to move to.		LDA	#Movend			;Beginning of Block to be moved		STA	A1		lda	#>Movend       		;high order pointer of block		sta	a1+1 		lda	#Bottom     		;low order byte of end of block 		STA	A2			;byte by adding beginning + length		lda	#>Bottom		;this is the ending byte 		STA	A2+1			;Store it onto the high byte of A2		LDY	#0			;SET UP Y REGISTER FOR MOVE 		LDA 	$C082 		LDA 	$C081 		LDA 	$C081		JSR	MOVE			;Move Data Block to NEWBASE		LDA 	$C082 		RTSOnLine	; 	DC.B	$02UnitNum		DS.B 1	DC.W	OnLinBufOnLinBuf		DS.B 16MOVENDLoaderORG	proc	temporg $1000* 		CLD		sta	RomIn		sta	clr80vid		sta	clraltchar		sta	clr80col		jsr	setnorm		jsr	init		jsr	setvid		jsr	setkbd 		JSR 	qHOME 		LDX 	#$17 		LDA 	#1 		STA 	SYSMAP,X 		DEX 		LDA 	#0S2 		STA 	SYSMAP,X 		DEX 		BPL 	S2 		LDA 	#$CF 		STA 	$BF58 		ldx	#$ff 		txs			;restore the stack...repeat 		JSR 	MLI	DC.B	$C6	DC.W	SET_PREFIX 		BCC 	S5		ldx	#1		jsr	goerr		bra	repeatS5		lda	#Fname		sta	StgPtr		lda	#>Fname		sta	StgPtr+1		ldy	#0		lda	(StgPtr),y		tax		sta	OurPath,yMuvLup2		iny		lda	(StgPtr),y		sta	OurPath,y		dex		bne	MuvLup2		JSR 	MLI	DC.B	$C8	DC.W	FOPEN 		BCC 	S1 		ldx	#2		jsr	goerr		bra	s5S1 		LDA 	FOPEN+5 		STA 	FREAD+1 		JSR 	MLI	DC.B	$CA	DC.W	FREADS4	; 		jsr	mli	DC.B	$42	DC.W	FINaming		JSR 	MLI	DC.B	$CC	DC.W	QCLOSES6 		JMP 	$2000PrintBlk	;         	sta    	stgptr       	;SET UP ZERO PAGE        	STX    	StgPtr+1     	;        	sty    	BlockLen        ;SAVE THE NUMBER OF CHARACTERS TO PRINT        	ldy    	#0              ;START WITH CHARACTER #1PLOOP   	lda    	(StgPtr),Y     	;GET THE CHARACTER        	ORA    	#$80            ;SET THE HIGH BIT         	jsr    	cout            ;OUTPUT TO SCREEN        	iny                   	;INCREMENT Y REGISTER        	cpy    	BlockLen       	;CHECK TO SEE IF WERE AT THE END OF BLK        	bne    	PLoop           ;IF NOT CONTINUE        	inc    	ch          	;add one to ch, not sure why??        	rts                  	;IF SO, WE ARE DONEgopos	;          	dey                 	;Setup the Y screen coordinates from 1-24, not the         	tya                 	;monitior 0-23.         	jsr   	mvtab          	;set the vertical position         	dex                 	;Setup the X screen coordinates from 1-80, not the         	stx   	ch            	;set the horizontal position.         	rts                 	;and returngoerr	; 		phx		jsr	qHOME		jsr	DrawBox		plx		cpx	#1		beq	NoVolErr		cpx	#2		beq	NoFileErrNoVolErr        ldy   	#7         	ldx   	#5         	jsr   	gopos         	;set the cursor position         	lda   	#qmsg1         	ldx   	#>qmsg1         	ldy   	qmsg1len         	jsr   	printblk 	;print the message		ldy	#9		ldx	#5		jsr	GoPos         	lda   	#prefix		inc	a		php         	ldx   	#>prefix		plp		bne	ge1		inxge1	;          	ldy   	prefix         	jsr   	printblk 	;print the messagewaitkey  	ldy   	#13            	;move the cursor to position y = 15         	ldx   	#5             	;x = 10         	jsr   	gopos           ;         	lda   	#qmsg2          ;and prompt the user for some action         	ldx   	#>qmsg2         	ldy   	qmsg2len         	jsr   	printblknopass	; 		jsr	qbell	   	sta   	kbdstrbnokey    	lda   	kbd         	bpl   	nokey         	cmp   	#$A0          		;is it a space character?         	bne   	nopass		rts		NoFileErr	;          	ldy   	#7         	ldx   	#5         	jsr   	gopos                    ;set the cursor position           	lda   	#qmsg3                   ;and prompt the user for some action         	ldx   	#>qmsg3         	ldy   	qmsg3len         	jsr   	printblk		ldy	#9		ldx	#5		jsr	GoPos         	lda   	#fname		inc	a		php         	ldx   	#>fname		plp		bne	ge2		inxge2	;          	ldy   	fname         	jsr   	printblk 	;print the message         	jmp   	waitkey		qbell	;          	LDA   	#$40                     ;DURATION         	STA   	B_LNGTH                  BELL_1   	LDA   	#$02                     ;SHORT DELAY         	JSR   	B_WAIT                            	STA   	QSPKR                              	LDA   	#$24                     ;LONG DELAY         	JSR   	B_WAIT                            	STA   	QSPKR                              	DEC   	B_LNGTH                           	BNE   	BELL_1                            	RTS		DrawBox	; 		lda	#10		sta	DrawCnt		ldy	#5		sty	Ypos		ldx	#2		jsr	GoPos		ldx	#37DrawLup1	lda	#$20			;an inverse space character		jsr	cout		dex		bne	DrawLup1Frame		inc	Ypos		ldy	Ypos		ldx	#2		jsr	GoPos		lda	#$20		jsr	Cout		ldy	Ypos		ldx	#38		jsr	GoPos		lda	#$20		jsr	Cout		dec	DrawCnt			;until the count equals zero		bne	Frame		ldy	YPos		ldx	#2		jsr	GoPos		ldx	#36DrawLup2	lda	#$20			;an inverse space character		jsr	cout		dex		bne	DrawLup2		rts				;; WAIT ROUTINE;B_WAIT   	SEC                            B_WAIT2  	PHA                            B_WAIT3  	SBC   	#1                                	BNE   	B_WAIT3                           	PLA                                     	SBC   	#1                                	BNE   	B_WAIT2                           	RTS                            ;B_LNGTH		DS.B 1                        FINaming	; 	DC.B	$00	DC.B	$33	DC.W	0	DC.B	$00	DC.B	$80FOPEN	DC.B	$03	DC.W	FNAME	DC.W	IO_BUFF		DS.B 1FREAD	DC.B	$04REFNUM		DS.B 1DATBUF	DC.W	$2000REQCNT	DC.W	$FFFFTRNSCNT	DC.W	0000QCLOSE	DC.B	$01	DC.B	$00SET_PREFIX	; 	DC.B	$01	DC.W	PREFIXFNAME 		STR 	'selector.system'		DS.B $80BLOCKLEN		DS.B 1Ypos		DS.B 1DrawCnt		DS.B 1qMSG1LEN 	str     'Insert the Volume:'qmsg2len 	str     'Press the Space Bar to Continue'qmsg3len 	str	'Unable to read the file:'qmsg1		equ	qMsg1Len+1qmsg2		equ	qMsg2Len+1qmsg3		equ	qMsg3Len+1PREFIX		DS.B 18		endp		BOTTOM		proc	export		endp				end