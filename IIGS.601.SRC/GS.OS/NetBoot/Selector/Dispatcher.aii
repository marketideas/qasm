***********************************************************							**	PRODOS 8 LOBOTOMIZED DISPATCHER ROUTINE		**							**	COPYRIGHT APPLE COMPUTER, INC. 1983-86		**							**		ALL RIGHTS RESERVED			**							**							************************************************************************************************************************ DISPATCHER 1 - This code ORGs and operates at $1000 but*   is resident in memory at $D100 in the Alt 4K bank of the*   Language Card. The QUIT call vectors to a routine high*   in the MLI that moves DISPATCHER 1 down and jumps to it.*   The move routine MUST remain somewhere between $E000-$F7FF** NOTE: This entire routine MUST remain no larger than 3 pages.************************************************************		MACHINE	M65816			longa	off		longi	offp16flag		EQU	$E100BD			; ProDOS16 booted flagCheckMach	equ	$fe1f			;Monitor Routine to check machine typeqdest		equ	$D100ch		equ	$24A1		equ	$3CA2		equ	$3EA4		equ	$42MOVE		equ	$FE2Cmli		equ	$BF00RomIn		equ	$c082Clr80Vid	equ	$c00cClr80Col	equ	$c000SetVid		equ	$fe93SetKbd		equ	$fe89Home		equ	$fc58COUT		equ 	$FDEDByeBye		proc	export; This code added by Mark Day to support quitting to ProDOS16		sec		jsr	CheckMach		;is this a //gs?		bcs	ByeBye8			;exit ProDOS8 for //e		lda	p16flag			;did we start with P16?		beq	ByeBye8			;if not, exit for ProDOS8		lda	$C08B			; hit appropriate bank switch		clc		xce		jmp	$E0D000			; and return to GQuitByeBye8	; 		lda	#<qdest			;Set up the zero page registers		STA	A4			;for the Apple // monitor move		LDA	#>qdest			;routine		STA	A4+1			;Destination to move to.		LDA	#<Dispatch		;Beginning of Block to be moved		STA	A1		lda	#>Dispatch		;high order pointer of block		sta	a1+1 		lda	#<Dispatch+$3FF     	;low order byte of end of block 		STA	A2			;byte by adding beginning + length		lda	#>Dispatch+$3FF		;this is the ending byte 		STA	A2+1			;Store it onto the high byte of A2		LDY	#0			;SET UP Y REGISTER FOR MOVE 		LDA 	$C082 		LDA 	$C081 		LDA 	$C081		JSR	MOVE			;Move Data Block to NEWBASE		LDA 	$C082		jsr	mli	DC.B	$65	DC.W	QuitParmsQuitParms	DC.B	$04,$00,$00,$00,$00Dispatch		endp		IF 0 THENDispatchORG	proc	temporg $1000		MSB	ON****PROMPT		EQU	$FFCV		EQU	$25INFOCALL	EQU	$C4SETPFXCALL	EQU	$C6GETPFXCALL	EQU	$C7OPENCALL	EQU	$C8READCALL	EQU	$CACLOSECALL	EQU	$CCEOFCALL		EQU	$D1ERRNUM		EQU	$DEPATH		EQU	$280*line3		equ	$600*ENTRY		EQU	$2000BITMAP		EQU	$BF58PFIXPTR		EQU	$BF9ASTB		EQU	$C010RAMIN		EQU	$C08B;ROMIN		EQU	$C082RAMIN2		EQU	$C083CLREOL		EQU	$FC9Csettxt		equ	$fb39;HOME		EQU	$FC58RDKEY		EQU	$FD0CCROUT		EQU	$FD8EBELL		EQU	$FF3A***;setvid		equ	$fe93setnorm	equ	$fe84init		equ	$fb2f;setkbd		equ	$fe89;clr80vid	equ	$c00cclraltchar	equ	$c00e;clr80col	equ	$c000**HEREIN		LDA	ROMIN**		sta	clr80vid		sta	clraltchar		sta	clr80col		jsr	setnorm		jsr	init		jsr	setvid		jsr	setkbd**CLRMAP		LDX	#$17		LDA	#1		STA	BITMAP,X		DEX		LDA	#$0CLRLOOP		STA	BITMAP,X		DEX		BPL	CLRLOOP		LDA	#$CF		STA	BITMAPdSTART	; **		JSR	HOME		JSR	CROUT*		ldx	#>msg0-msgstart*		JSR	PRNTLOOP		LDA	#3		STA	CV		JSR	CROUT		JSR	MLI	DC.B	GETPFXCALL	DC.W	dPREFIX		LDX	PATH		LDA	#0		STA	PATH+1,X*		ldx	path		beq	nilpfx**m1		lda	path,x		ora	#$80		sta	line3-1,x		dex		bne	m1**nilpfx	; 		LDX	#0		DEC	CV		JSR	CROUTGETKEY		JSR	RDKEY		CMP	#$8D		BEQ	GOTPFX		PHA		JSR	CLREOL		PLA		CMP	#$9B		BEQ	dSTART		CMP	#$98RESTRT		BEQ	dSTART		CMP	#$89		BEQ	BADKEY		CMP	#$FF		BEQ	X2		CMP	#$88		BNE	NOTBSX2		CPX	#$0		BEQ	*+5		DEC	CH		DEX		JSR	CLREOL		JMP	GETKEYNOTBS		BCS	MAYBEBADKEY		JSR	BELL		JMP	GETKEYMAYBE		CMP	#$DB		BCC	*+4		AND	#$DF		CMP	#$AE		BCC	BADKEY		CMP	#$DB		BCS	BADKEY		CMP	#$BA		BCC	GOODKEY		CMP	#$C1		BCC	BADKEYGOODKEY		INX		CPX	#39		BCS	RESTRT		STA	PATH,X		JSR	COUT		JMP	GETKEYGOTPFX	; 		CPX	#$0		BEQ	PRMPT		STX	PATH		JSR	MLI	DC.B	SETPFXCALL	DC.W	dPREFIX		BCC	PRMPT		JSR	BELL		LDA	#0BADPFX		BEQ	RESTRTPRMPT		JSR	HOMEPRMPT1		JSR	CROUT**		ldx	#>msg-msgstart**		JSR	PRNTLOOPretryrich	LDA	#3		STA	CV		JSR	CROUT		LDX	#0**loop1	; 		jsr	rdkey		CMP	#$9B		BNE	NOTESC		LDA	CH		BNE	PRMPT		BEQ	BADPFXNOTESC		CMP	#$98EXTNDBR		BEQ	PRMPT		CMP	#$89		BEQ	NOTGUD		CMP	#$FF		BEQ	X3		CMP	#$88		BNE	X1X3		JMP	EATEMX1		BCS	GETIN1NOTGUD		JSR	BELL		JMP	LOOP1GETIN1		CMP	#$8D		BEQ	DONE		CMP	#$DB		BCC	*+4		AND	#$DF		CMP	#$AE		BCC	NOTGUD		CMP	#$DB		BCS	NOTGUD		CMP	#$BA		BCC	ITSGUD		CMP	#$C1		BCC	NOTGUDITSGUD	; 		PHA		JSR	CLREOL		PLA		JSR	COUT		INX			CPX	#39		BCS	EXTNDBR		STA	PATH,X		JMP	LOOP1DONE	; 		LDA	#$a0		JSR	COUT		STX	PATH**		JSR	MLI	DC.B	INFOCALL	DC.W	INFO		BCC	INFOOK		JMP	ERRORINFOOK		LDA	TYPE		CMP	#$FF		BEQ	DOIT2		LDA	#1		JMP	ERRORDOIT2	; 		LDA	#0		STA	CLSNUM		JSR	MLI	DC.B	CLOSECALL	DC.W	CLS		BCC	CHKACS		JMP	ERROR**CHKACS		LDA	ACESS		AND	#1		BNE	ACSOK		LDA	#$27		JMP	ERRORACSOK	; 		JSR	MLI	DC.B	OPENCALL	DC.W	OPN		BCC	*+5		JMP	ERROR		LDA	dREFNUM		STA	REEDNUM		STA	EOFNUM**		JSR	MLI	DC.B	EOFCALL	DC.W	EOF		BCS	ERROR		LDA	EOFB+2		BEQ	EOFOK		LDA	#$27		BNE	ERROREOFOK		LDA	EOFB		STA	RCOUNT		LDA	EOFB+1		STA	RCOUNT+1		JSR	MLI	DC.B	READCALL	DC.W	REED		PHP		JSR	MLI	DC.B	CLOSECALL	DC.W	CLS		BCC	*+6		PLP		BNE	ERROR		PLP		BCS	*-4		JMP	ENTRY*EATEM	; 		LDA	CH		BEQ	EATEMBAK		DEX		LDA	#$a0		JSR	COUT		DEC	CH		DEC	CH		JSR	COUT		DEC	CHEATEMBAK	JMP	LOOP1****prntloop	; 		lda	msgstart,x		beq	done1		jsr	cout		inx		bne	prntloopdone1		rts*ERROR	; 		STA	ERRNUM		LDA	#$0C		STA	CV		JSR	CROUT		LDA	ERRNUM		CMP	#1		BNE	NEXTERR***		ldx	#>err1-msgstart*		BNE	DOERRORNEXTERR		CMP	#$40		BEQ	ERROR3		CMP	#$44		BEQ	ERROR3		CMP	#$45		BEQ	ERROR3		CMP	#$46		BEQ	ERROR3****		ldx	#>err2-msgstart*		BNE	DOERROR***error3	; 		ldx	#>err3-msgstart*DOERROR		JSR	PRNTLOOP***		JMP	retryrich**msgstart	; 			MSB	ONMSG0	DC.B	'ENTER PREFIX (PRESS ''RETURN'' TO ACCEPT)'	DC.B	0MSG	DC.B	'ENTER PATHNAME OF NEXT APPLICATION'	DC.B	0ERR1	DC.B	$87	DC.B	'NOT A TYPE ''SYS'' FILE'	DC.B	0ERR2	DC.B	$87	DC.B	'I/O ERROR            '	DC.B	0ERR3	DC.B	$87	DC.B	'FILE/PATH NOT FOUND  '	DC.B	0**********************************************************************INFO	; 	DC.B	$A	DC.W	PATHACESS	DC.B	0TYPE	DC.B	0	DCB.B $0D,0*OPN	; 	DC.B	3	DC.W	PATH	DC.W	$1800dREFNUM	DC.B	0*CLS	; 	DC.B	1CLSNUM	DC.B	0*REED	; 	DC.B	4REEDNUM	DC.B	0	DC.W	ENTRYRCOUNT	DC.W	0	DC.W	0*EOF	; 	DC.B	2EOFNUM	DC.B	0EOFB	DCB.B 3,0*dPREFIX	; 	DC.B	1PBUF	DC.W	PATH*ZZSIZ		EQU	*-HEREINZZFRE		EQU	$2FF-ZZSIZ	;objend					msb	offTHEEND	; 	endp	ENDIF		end