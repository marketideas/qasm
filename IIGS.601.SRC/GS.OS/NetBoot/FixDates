# This file automagically sets the creator dates for all of the files mentioned# in the Apple IIGS installer script Rez file.## It assumes that there are 4 files mentioned in the following order:# "ProDOS16 Boot Blocks", "ProDOS16 Image", "BASIC.SYSTEM", "P8".## Modification History:# Written by Mark Day 19-Feb-88# Set up "prefixes" for the installer scriptsset inst ":installer:"set work ":work:"open {inst}AIIGSInst.rfind ¥ {inst}AIIGSInst.r# Get the create date of the 'ProDOS16 Boot Blocks' file and copy it into# the installer script filereplace /0x[0-9a-f]Ç8È/ {todayhex} {inst}AIIGSInst.r# Get the create date of the 'ProDOS16 Image' file and copy it into# the installer script filecatinfo {work}'ProDOS16 Image' >{work}catinfo.infofind ¥ {work}catinfo.infofind /crDat/ {work}catinfo.infocopy /0x[0-9a-f]Ç8È/ {work}catinfo.infopaste /0x[0-9a-f]Ç8È/ {inst}AIIGSInst.r# Get the create date of the 'Basic.System' file and copy it into# the installer script filecatinfo {work}'Basic.System' >{work}catinfo.infofind ¥ {work}catinfo.infofind /crDat/ {work}catinfo.infocopy /0x[0-9a-f]Ç8È/ {work}catinfo.infopaste /0x[0-9a-f]Ç8È/ {inst}AIIGSInst.r# Get the create date of the 'P8' file and copy it into# the installer script filecatinfo {work}'P8' >{work}catinfo.infofind ¥ {work}catinfo.infofind /crDat/ {work}catinfo.infocopy /0x[0-9a-f]Ç8È/ {work}catinfo.infopaste /0x[0-9a-f]Ç8È/ {inst}AIIGSInst.r# Get the create date of the 'Apple //e Boot Blocks' file and copy it into# the installer script filecatinfo {work}'Apple //e Boot Blocks' >{work}catinfo.infofind ¥ {work}catinfo.infofind /crDat/ {work}catinfo.infocopy /0x[0-9a-f]Ç8È/ {work}catinfo.infopaste /0x[0-9a-f]Ç8È/ {inst}AIIGSInst.r# All done now, so save and close the script fileclose -n {work}catinfo.infodelete {work}catinfo.infosave {inst}AIIGSInst.rclose {inst}AIIGSInst.r