;------------------------------------------------------------; Fizzy.aii;; This is the second stage boot block for booting GS/OS over; the network.  This code is responsible for reading the rest; of the GS/OS image, installing the protocols, running Logon,; and jumping to the FST stub.;; Modification history:; 13-Sep-88	MSD	Initial coding (based on Toucan); 12-Jun-91	MSD	Logon has moved from $01/2000 to;			$00/6800.  Version changed to 2.2d4.; 13-Jun-91	MSD	Added ability to boot into P8.; 16-Jun-91	MSD	Update the auxtype in the FST stub;			only if the boot OS is GS/OS.; 18-Jun-91	MSD	Changed version to 2.2d5 to match the;			version of the Apple II Setup disk.;  1-Jul-91	MSD	Changed version to 2.2d7.;  9-Jul-91	MSD	Version is 2.2d8.  Changed the code that;			calls the protocol files to determine the;			correct slot on ROM 03 and later, and to;			pass the port number.  It should now work;			like the SCC Manager does.; 10-Jul-91	MSD	Added code to save and restore ABridge in;			AppleTalk's globals around the init of;			the protocols.;  1-Aug-91	MSD	Version changed to 2.2d9.  This should be;			the seed version.; 26-Aug-91	MSD	Version changed to 2.2d10.; 20-Jan-92	MSD	Now puts an RTL in os_p8_switch (which SCM;			now calls just before removing P8 on a P8;			to GS/OS switch).  Version 2.2d24.;  7-Feb-92	MSD	Changed version to 2.2 final.;  1-Apr-92	MSD	The reserved word in the header structure;			is now the hardware type: 0=all, 1=LocalTalk,;			2=EtherTalk.  Changed version to 3.0d1.;  3-Apr-92	MSD	Made a common routine to test whether a;			particular module gets loaded into the current;			configuration.; 22-Aug-92	MSD	When finding out the slot on a ROM 01, store;			the slot and port numbers at $E1/01C0..2 so that;			the ATBoot driver can depend on them.  ROM 03 Control;			Panel code sets them for LocalTalk, and the first;			stage boot block (Boot.aii file) sets them for;			booting from EtherTalk.  Version 3.0d7.; 15-Dec-92	DAL	Version 3.0d8.; 27-Jan-93	DAL	Version 3.0d13.;  9-Mar-93	DAL	Version 3.0d14.;  2-Apr-93	DAL	Version 3.0 final, to ship on Apple II Setup 3.0;			with System 6.0.1.;;------------------------------------------------------------		include	'm16.util'		include 'm16.memory'		include 'm16.misctool'		include	'm16.intmath'		macro&lab		ATCall	&parm&lab		ldx	#<&parm		ldy	#^&parm		jsl	$E11014		menddp		record	0txtpnt		ds.w	1screenpnt	ds.w	1BDSpnt		ds.l	1wrapflag	ds.w	1ATPcount	ds.w	1romvers		ds.w	1			; version of ROM in machineatslot		ds.w	1			; slot number where AppleTalk ischannel		ds.w	1			; channel number AppleTalk is usingheadpnt		ds.w	1			; points to header infoblks_total	ds.w	1			; total # of blocks to loadbytes_left	ds.w	1			; bytes left to readmyid		ds.w	1			; my MM user IDblocks_in	ds.w	1			; number of blocks loaded so farstart_time	ds.w	1			; time when we started loading filesSaveABridge	ds.w	1		endrheader		record	0			; describes layout of header recordbytes		ds.w	1			; size of file in bytesfirstblk	ds.w	1			; block # of first blockblocks		ds.w	1			; size of file's image in blocksaddr		ds.l	1			; starting address of filemaxrom		ds.w	1			; maximum ROM version supportedwhichos		ds.w	1			; 0 to load for all os's						; 1 for GS/OS only						; 2 for ProDOS 8 onlyhardware	ds.w	1			; 0 for all hardware						; 1 for LocalTalk only						; 2 for EtherTalk onlysize		endrClearScreen	equ	$FC58			; monitor's HOME routineRomin		equ	$C082			; switches in LC ROM on readLCBank2		equ	$C083			; read LC RAM bank 2Clr80Vid	equ	$C00C			; disable 80 col. hardwareSetAltChar	equ	$C00F			; switch in alternate char setClr80Col	equ	$C000			; clear 80 column storeSetVid		equ	$FE93			; force COUT to use slot 0SetNorm		equ	$FE84			; set white on black textInit		equ	$FB2F			; init text modeShadowMask	equ	$1EShadow		equ	$C035			; memory shadowing registerSpeed		equ	$C036			; sets system speedIDRom		equ	$FE1F			; find out which ROM versionMSlot		equ	$07F8			; slot of boot deviceBlockBuf	equ	$1E00			; where cross-bank blocks get putheaderloc	equ	$E00			; where to put header blockBootHardware	equ	$E0E			; where boot blocks puts hardware typeNBPbuffer	equ	$C00			; where NBP lookup puts dataBufferLen	equ	$200			; size of NBP bufferlook_addr	equ	nbpbuffer		; internet address of serverToolInitPatch	equ	$6864			; where in Start.GS.OS to patch outToolPatchLen	equ	$0020			; length+1 of memory to patch outToolInit	equ	$FE0000			; init tools and Memory ManagerLine1		equ	$4A8			; "Starting up over the Network"Line2		equ	$5A8			; spinning cursor on this lineLine3		equ	$6A8			; server name on this lineFirstLine	equ	$400			; start of first screen lineLine21		equ	$650			; where "Progress" goesLine22		equ	$6D0			; top of thermometerLine23		equ	$750			; middleLine24		equ	$7D0			; bottom of thermometerScreenSpinner	equ	Line2+19		; screen address of spinning cursorLogon		equ	$006800			; where Logon is putATPortNumber	equ	$E101C0			; port number AppleTalk is usingATSlotNumber	equ	$E101C1			; slot number AppleTalk is usingRPMSlotNumber	equ	$E101C2			; slot number RPM is usingos_switch	equ	$E100AC			; OS Switch notification chainswitchkind	equ	$E100BC			; kind of OS switch (0 = into P8)os_p8_switch	equ	$E100B4			; called just before P8 is shut downATTickCount	equ	$E1DA00ABridge		equ	$E1D013			; global bridge node numberFST_Stub	equ	$2000			; startup routine in stubP8Init		equ	$2003			; init entry for ProDOS 8BootUnit	equ	$43			; where P8 expects its boot unit numberfizzy		proc		with	dp;------------------------------------------------------------; Set up the system in a known state.  Initialize the memory; manager, tools, display, etc.;------------------------------------------------------------		LONGI OFF		LONGA OFF		sec		xce                      ; emulation mode		sta	Romin		sta	Clr80vid		sta	Clr80col 		jsr	Init		jsr	Setvid		jsr 	Setnorm		jsr	ClearScreen		sta	Setaltchar;------------------------------------------------------------; Find out which version of the ROM we're running on.;------------------------------------------------------------		sec		jsr	IDRom		tya					; ROM version in A		and	#$7F				; strip off prototype bit		sta	romvers		stz	romvers+1		cmp	#1				; must be at least 01 ROM		bge	ok_rom_vers		brl	bad_rom				; put message on screenok_rom_vers		clc		xce					; Set Native Mode		php					; save interrupt state		sei		lda	#shadowmask		sta	shadow		jsl	ToolInit			; set up tools, clear memory		plp					; restore interrupt state		rep	#$30		longa	on		longi	on;; Find out which OS to boot into;		lda	#1		sta	BootOS		; default to GS/OS				pha			; space for result		pea	$0062		; want AppleTalk OS flag		ldx	#$0C03		; ReadBParam		jsl	$E10000		; (toolbox dispatch)		pla			; get OS flag from stack				cmp	#2		; was it P8?		bne	got_os		; no, so default to GS/OS		sta	BootOS		; tell Fizzy to use P8got_os;; Find out what slot AppleTalk is in;		lda	BootHardware		cmp	#2		; using EtherTalk hardware?		bge	from_cp		; if so, Control Panel locations are set				lda	#7			; assume slot 7		sta	ATSlot		lda	romvers		cmp	#2			; ROM version greater than 01?		bge	from_cp			; newer, so Control Panel tells us;; Here, we're using ROM 01.  Determine the channel based on settings; of the slot 1 and 2 settings.;		lda	#1			; assume printer port		sta	channel				pha				; space for word result		pea	$0021			; slot 1 setting BRAM index		ldx	#$0C03			; ReadBParam		jsl	$E10000			; call the toolbox		pla		bne	got_channel		; was Your Card, so leave channel=1				inc	channel			; slot 1 was Printer Port, sogot_channel		lda	channel		sta	ATPortNumber		; overwrites ATSlotNumber		lda	#$0707			; slot 7 for ATSlotNumber		sta	ATSlotNumber		; and RPMSlotNumber		bra	got_slot		; assume we're using modem port;; ROM version 03 or greater here.  E1/01C1 contains slot.;from_cp		lda	ATSlotNumber		; copy Control Panel's		and	#$00FF			; slot is only 1 byte wide!		sta	ATSlot			; slot number to local				lda	ATPortNumber		; get port from Control Panel		and	#$00FF			; only 1 byte wide		sta	channel			; save as channel for protocols		got_slot		;------------------------------------------------------------; Should get a unique user ID for the memory segments;------------------------------------------------------------		pha					; room for result		pea	$AD00				; my type/auxID		_GetNewID		pla					; get my user ID		sta	myid		sep	#$30		longa	off		longi	off;------------------------------------------------------------; Display version of Fizzy boot;------------------------------------------------------------		ldy	Version		ldx	#39				; start at right edge of screenVersionLoop	lda	Version,y			; get one char		ora	#$80				; make it printable		sta	FirstLine,x			; put on screen		dex		dey		bne	VersionLoop		rep	#$30		longa	on		longi	on;------------------------------------------------------------; Here, the first stage boot left the address of the server; in the NBP buffer.  I should really check here to see if; the ROM version is >= 01.;------------------------------------------------------------		bra	FoundServer;------------------------------------------------------------; Force restart of boot process.  Try to find another server; or reboot if no server found.;------------------------------------------------------------Restart;; Should do a DisposeAll for memory allocated by my UserID;		pei	myid			; push my user ID		_DisposeAll; clear server name on screen		ldy	#36		lda	#$A0A0			; normal spacesClearNameLoop		sta	Line3+2,y		; clear two chars of server name		sta	Line23+1,y		; and two of thermometer		dey		dey		bpl	ClearNameLoop		sta	Line3			; get last bit of server name cleared		sta	ScreenSpinner		; and the spinner		ATCall	Lookup		bcs	TryROM		lda	NBPMatches		bne	FoundServerTryROM		sec		xce		jsr	ClearScreen		clc		xce		rep	#$30		ATCall	RebootFoundServer;------------------------------------------------------------; Copy address of server to ATP parameters;------------------------------------------------------------		lda	NBPbuffer		sta	ATPnetaddr		lda	NBPbuffer+2		sta	ATPnetaddr+2;------------------------------------------------------------; Display the "Starting up over the Network" message;------------------------------------------------------------		lda	#BootMess			; get pointer to string		ldy	#Line1				; and where to put it		jsr	Center				; center and display it;------------------------------------------------------------; Now tell the user just which server was found;------------------------------------------------------------		lda	#NBPbuffer+5		ldy	#Line3		jsr	Center;------------------------------------------------------------; Print the thermometer.  First "Progress";------------------------------------------------------------		lda	#Progress		ldy	#line21		jsr	Center;------------------------------------------------------------; Now draw top, bottom of thermometer;------------------------------------------------------------		ldy	#36thermprint		lda	#$DFDF				; underlines		sta	line22+1,y		lda	#$4C4C				; super lines		sta	line24+1,y		dey		dey		bpl	thermprint;------------------------------------------------------------; Now draw left, right of thermometer;------------------------------------------------------------		lda	#$A05A				; left side		sta	Line23		lda	#$5FA0				; right side		sta	Line23+38;------------------------------------------------------------; Remember the current real time so we can compute how long; it is taking to boot (for the thermometer).;------------------------------------------------------------		sep	#$10			; short A for soft switches		longi	off				ldx	LCBank2			; get LC switched in				lda	ATTickCount		; get current time		sta	start_time		ldx	Romin			; switch ROM back in		rep	#$10		longi	on		;------------------------------------------------------------; Compute number of blocks to download;------------------------------------------------------------		stz	blks_total		lda	#headerloc+$100+header.size		sta	headpntsize_loop		lda	(headpnt)			; is that all the files?		beq	got_size				jsr	test_load			; will it load?		bcc	next_size			; no, try next one		ldy	#header.blocks		clc		lda	(headpnt),y			; get length of this file		adc	blks_total			; add to total count		sta	blks_totalnext_size		clc		lda	headpnt		adc	#header.size			; point to next entry		sta	headpnt		bra	size_loopgot_size;------------------------------------------------------------; Start downloading the various pieces in the image.;------------------------------------------------------------		stz	blocks_in			; no blocks read yet		lda	#headerloc+$100+header.size		sta	headpnt				; point to first real entryload_loop		lda	(headpnt)			; get byte count; is that all?		beq	all_loaded				jsr	test_load			; does it load?		bcc	next_load			; no, try next one		ldy	#header.addr+2		lda	(headpnt),y			; what bank is this in?		cmp	#2				; at least bank 2?		blt	skip_mm				; no, so don't allocate memory; Allocate memory for file from MM		pha					; long -- room for result		pha		pea	0				; size, high word		ldy	#header.bytes		lda	(headpnt),y			; get size of block		pha		pei	myid				; push my user ID		pea	$C012				; attributes		ldy	#header.addr+2		lda	(headpnt),y			; get start address (high)		pha		dey		dey		lda	(headpnt),y			; get start address (low)		pha		_NewHandle		bcc	@ok		brk	0				; just for now@ok		pla					; ignore handle		pla					; since fixed address blockskip_mm		jsr	load_one			; load one filenext_load		clc		lda	headpnt		adc	#header.size			; bump to next header entry		sta	headpnt		bra	load_loopthe_jump		jml	0				; used in calling protocols		dc.b	0				; allow long after JMLall_loaded;------------------------------------------------------------; Find out the current real time for thermometer;------------------------------------------------------------		lda	BootOS		cmp	#1				; GS/OS?		bne	cls				; no, don't update FST stub!				sep	#$10		longi	off				ldx	LCBank2				; get LC switched in				sec		lda	ATTickCount		sbc	start_time			; get time so far		sta	FST_stub+12			; save as auxtype				ldx	Romin				; back to ROM in LC				rep	#$10		longi	on;------------------------------------------------------------; Clear the screen so user knows that loading is done.;------------------------------------------------------------cls		sec		xce		jsr	ClearScreen		clc		xce		rep	#$30		IF 0 THEN;------------------------------------------------------------; Display the splash screen with copyright message;------------------------------------------------------------		lda	#Splash1			; get pointer to string		ldy	#Line1				; and where to put it		jsr	Center				; center and display it		lda	#Splash2			; get pointer to string		ldy	#Line2				; and where to put it		jsr	Center				; center and display it		lda	#Splash3			; get pointer to string		ldy	#Line3				; and where to put it		jsr	Center				; center and display it		ENDIF		;------------------------------------------------------------; Now, it's time to install (call) all the protocols;------------------------------------------------------------;; Save off ABridge while I init the protocols and restore later;		sep	#$20		longa	off		lda	LCBank2			; get LC switched in		lda	ABridge			; get router node number		sta	SaveABridge		; save it while I start up the protocols		lda	Romin			; switch ROM back in		rep	#$20		longa	on				lda	#$006B				; RTL <null>		sta	os_switch			; in OS switch chain		sta	os_p8_switch			; and os_p8_switch chain		lda	#$0000		sta	os_switch+2			; before drivers get loaded!		sta	os_p8_switch+2		lda	#headerloc+$100+header.size		sta	headpnt				; point to first real entrycall_loop		lda	(headpnt)			; byte count = 0?		beq	all_called			; if so, we're done		jsr	test_load			; did it load?		bcc	next_call			; no, don't call it		ldy	#header.addr		lda	(headpnt),y		sta	the_jump+1			; save low word for jump		iny		iny		lda	(headpnt),y			; get high word		sta	the_jump+3			; save bank byte for jump		cmp	#2				; at least bank 2?		blt	next_call				lda	channel				; A = channel #		ldx	romvers				; X = rom version		ldy	ATSlot				; Y = slot number		jsl	the_jump			; call the protocolnext_call		clc		lda	headpnt		adc	#header.size		sta	headpnt		bra	call_loopall_called;; Restore the old ABridge value;		sep	#$20		longa	off		lda	LCBank2		lda	LCBank2				; write enable		lda	SaveABridge		sta	ABridge		lda	Romin		rep	#$20		IF 0 THEN;------------------------------------------------------------; Finally, it is time to make an AppleTalk Init call to; make sure AppleTalk is turned on, has a node number, etc.;------------------------------------------------------------		ATCall	InitParms;------------------------------------------------------------; Wait a little bit for user to read splash screen and for; RTMP to find a bridge.;------------------------------------------------------------		sep	#$20		; 8 bits for I/O access		longa	off		lda	Speed		; get processor speed		pha		and	#$7F		; force slow mode		sta	Speed		ldy	#65		; about 4 seconds@delay1		ldx	#20000		; 100 ms@delay2		dex		bne	@delay2		dey		bne	@delay1		pla			; recover processor speed		sta	Speed		rep	#$20		longa	on		ENDIF		;------------------------------------------------------------; See if we should boot into ProDOS 8;------------------------------------------------------------		lda	BootOS		dea			; was A=1 (GS/OS)?		beq	ToLogon		; yes, go into GS/OS				sec		xce			; 8-bit emulation mode		longa	off		longi	off				lda	atslot		asl	a		asl	a		asl	a		asl	a		sta	BootUnit	; Tell P8 which slot we're using				jsr	P8Init		; let P8 init itself				clc		xce			; back to native mode		rep	#$30		; full 16-bit registers		longa	on		longi	on				lda	#0		sta	>switchkind	; pretend a GS/OS to P8 switch		jsl	os_switch	; let AppleTalk fix things up		;------------------------------------------------------------; Log on to file server;------------------------------------------------------------ToLogon		lda	BootOS		; tell Logon which OS to use		jsl	Logon		phk		plb					; fix my bank!!!;------------------------------------------------------------; Use FST stub to start up (load and run GLoader).;------------------------------------------------------------		sep	#$20				; byte wide slot number		longa	off		lda	ATSlot		ora	#$C0				; get in $Cn form		sta	MSlot				; save boot slot for GLoader		rep	#$20				; back to full native		longa	on		jmp	FST_stub		;------------------------------------------------------------; Center -- center a line on screen;------------------------------------------------------------Center		sta	txtpnt				; save pointer to text		sty	screenpnt			; and pointer to screen memory		sep	#$20				; for length bytes		longa	off		sec		lda	#38				; width of screen		sbc	(txtpnt)			; minus length of string		lsr	a				; divided by two is offset		rep	#$20				; and back		longa	on		and	#$FF				; get only low byte		clc					; add to start of line		adc	screenpnt		sta	screenpnt			; gives pointer to display		lda	(txtpnt)			; get length		and	#$FF				; mask off length byte		tay					; and into Y		sep	#$20				; 8 bits for characters		longa	off@loop		lda	(txtpnt),y		ora	#$80				; ready to display		cmp	#$A0				; printable?		bge	@print		lda	#$AA				; otherwise an asterisk@print		sta	(screenpnt),y		dey		bne	@loop		rep	#$20		longa	on		rts;------------------------------------------------------------; Test a module's header to determine if it should be loaded; given the machine's current configuration.  Returns carry; set if it should load.;------------------------------------------------------------test_load		ldy	#header.maxrom		lda	(headpnt),y		; get maximum ROM version		cmp	romvers			; is real ROM larger?		blt	@noload		ldy	#header.whichos		lda	(headpnt),y		; which OS does it support?		beq	@ok_os			; all, so it may still load		cmp	BootOS		bne	@noload@ok_os		ldy	#header.hardware		lda	(headpnt),y		; which hardware to load under?		beq	@yesload		; all, so load it		cmp	BootHardware		bne	@noload@yesload		sec		dc.b	$90			; BCC opcode (never taken, skip CLC)@noload		clc		rts;------------------------------------------------------------; Load a single file from the image.  The start address,; size in bytes, and size in blocks are in direct page; variables by now.;------------------------------------------------------------load_one		ldy	#header.addr		lda	(headpnt),y			; get load address		sta	BDSAddr				; save for ATP's use		iny		iny		lda	(headpnt),y		sta	BDSAddr+2				ldy	#header.firstblk		lda	(headpnt),y			; get first block number		sta	ATPBlockNum				lda	(headpnt)			; get number of bytes		sta	bytes_left		@loop		lda	#1				; only want first response block		sta	ATPbitmap			; overwrite # responses		lda	bytes_left		cmp	#$200				; a whole block to read?		blt	@size				; if not, use this as size		lda	#$200				; assume a block at a time@size		sta	BDS				; save as buffer size		ATCall	ATPreq		bcs	@err		inc	blocks_in		lda	blocks_in		and	#3				; take block mod 4		tay					; as index to		lda	Spinner,y			;   spinner table		and	#$00FF				; only a byte wide		ora	#$A000				; second char is space		sta	ScreenSpinner			; put on screen;------------------------------------------------------------; Compute cell of thermometer to display as blocks * 37 / total;------------------------------------------------------------		pha			; long space for result		pha		pei	blocks_in	; push blocks loaded		pea	37		; push constant 38		_Multiply		pla			; get low word of product; leave a word on stack as room for remainder		pha			; room for quotient		pha			; numerator		pei	blks_total	; denominator		_UDivide		ply			; quotient		plx			; throw away remainder		sep	#$20		; 8 bit mode for characters		longa	off		tya			; get quotient low byte		and	#1		; mask off odd/even		ora	#$56		; grid char		sta	Line23+1,y	; and put it on screen		rep	#$20		longa	on;------------------------------------------------------------; Do a small delay between packets to help reduce server load;------------------------------------------------------------		sep	#$20		; 8 bits for I/O access		longa	off		lda	Speed		; get processor speed		pha		ora	#$80		; force fast mode		sta	Speed		ldy	#8192		; about right for fast mode@delay		dey		bne	@delay		pla			; recover processor speed		sta	Speed		rep	#$20		longa	on		inc	BDSAddr+1			; bump by 2 pages (1 block)		inc	BDSAddr+1		inc	ATPBlockNum			; get next block		sec		lda	bytes_left			; how many more bytes?		sbc	BDS				; minus how mnay we just read		sta	bytes_left			; anyhting else to read?		beq	@exit		brl	@loop				; if so, go get them bytes@exit		rts@err		pla					; yank return address		brl	Restart				; try it all over again		;------------------------------------------------------------; Display error message about wrong ROM version;------------------------------------------------------------bad_rom		longa	off		longi	off		ldy	#0@loop		lda	rom_mess,y		beq	@done		sta	line2,y		iny		bra	@loop@done		bra	@doneVersion		dc.b	@end-@start@start		dc.b	'3.0'		dc.b	' (GS/OS)'@end		IF 0 THENSplash1		str	'AppleTalk Network Startup'Splash2		str	'(C) Apple Computer, Inc. 1988-1993'Splash3		str	'All Rights Reserved'		ENDIF		BootMess		str	'Starting up over the network'Progress		str	'Progress'ServerName		str	'='		str	'GS/OS Image'		str	'*'Spinner		msb	on		dc.b	'-\|/'		msb	offLookup		dc.b	0,16		; sync NBPLookup		dc.w	0		; result		dc.l	0		; completion		dc.l	ServerName	; what to look for		dc.b	4,32		; retry count and interval (was 8,16)		dc.w	0		; RESERVED		dc.w	BufferLen	; buffer length		dc.l	NBPbuffer	; address of buffer		dc.b	1		; maximum matchesNBPMatches	dc.b	0		; actual matches		dc.b	0		; allow matches to be a wordReboot		dc.b	0,6		; sync Boot call		dc.w	0		; resultInitParms		dc.b	0,1		; sync. Init		dc.w	0		; result		dc.b	$80		; full init		dc.w	0		; ProDOS entry point		dc.w	0		; Reserved		dc.b	0		; node number		dc.w	0		; (Reserved, I think)ATPreq		dc.b	0,18		; synchronous ATPrequest		dc.w	0		; result		dc.l	0		; no completion		dc.b	0		; socket used for transactionATPnetaddr	dc.l	0		; address		dc.w	0		; TID		dc.w	0		; sending zero data bytes		dc.l	0		; normally, address of data buffer		dc.b	3		; User bytes:	machine typeATPBlockNum	dc.w	0		;		block number		dc.b	0		;		unused		dc.b	1		; one response buffer		dc.l	BDS		; point to info about buffer(s)		dc.b	$00		; flags: at least once transaction		dc.b	4,64		; retry interval, count	       				; was 4,64ATPbitmap	dc.b	0		; current bitmap		dc.b	0		; number of repsonses received		dc.w	0,0,0		; reserved;BDS		dc.w	$200		; incoming packet buffer lengthBDSAddr		dc.l	BlockBuf	; buffer address placed here		dc.l	0		; user bytes		dc.w	0		; actual lengthBootOS		dc.w	0		; 1 = GS/OS, 2 = P8rom_mess		msb	on		dc.b	'GS/OS requires ROM version 01 or newer.',00		endwith					; with dp		endp		end	