;------------------------------------------------------------; Aristotle Patch code.  To create Aristotle Menu Display; version 1.0.1, take version 1.0, append this code, and; make the JMP at the beginning jump to $6B92 (where this; code will reside when loaded).;; Written by Mark Day;------------------------------------------------------------LCBank2		equ	$C083LCBank1		equ	$C08BPatchOrg	equ	$6B92QuitOrg		equ	$987LCQuit		equ	$D100			; address of quit code in LCMLI		equ	$BF00P8Quit		equ	$65			; ProDOS 8 Quit callGQuit		equ	$E0D000			; where P8 enters GQuitOSBooted	equ	$E100BD			; tells which OS was bootedTheJump		equ	$800			; start of Menu DisplayOldJump		equ	$5D15			; where JMP at $800 used to pointMachID		equ	$FE1F			; identify IIe vs. IIGSPatch		proc	temporg PatchOrg		import	Quit,QuitEnd		longa	off			; runs in emulation mode		longi	off		lda	#<OldJump		sta	TheJump+1		; store low word of addr		lda	#>OldJump		sta	TheJump+2				sec		jsr	MachID			; what machine are we on?		bcs	done			; on a IIe, so don't patch		lda	OSBooted		; which OS was booted?		cmp	#1			; P16 or GS/OS?		bne	done			; if not, don't patch		;------------------------------------------------------------; We booted P16 or GS/OS.  Assume it was GS/OS and patch; the quit routine to just return back to GS/OS instead; of rebooting the machine.;------------------------------------------------------------		ldy	#QuitEnd-Quit-1		; index of last byte to moveloop		lda	QuitReal,y		; get code where stored		sta	Quit,y			; put code at run address		dey		bpl	loopdone		jmp	TheJump			; go run Menu DisplayQuitReal		endpQuit		proc	entry,temporg QuitOrg		entry	QuitEnd				longa	off			; runs in emulation mode		longi	off		lda	LCBank2			; Make LC R/W		lda	LCBank2		ldy	#QuitEnd-LCCode-1	; index of last byte to moveloop		lda	LCCode,y		; copy quit code to LC		sta	LCQuit,y		dey		bpl	loop		jsr	MLI		dc.b	P8Quit			; quit back to top of GS/OS		dc.w	QuitList		; quit stack.		brk	0			; should NEVER return!QuitList		dc.b	4			; 4 parameters		ds.b	6			; 6 bytes of $00;------------------------------------------------------------; This code will overwrite the Aristotle quit code in the; language card.  It will simply return to the GQuit to allow; a return to the Start program.  Note: this code runs at; $1000.;------------------------------------------------------------LCCode		cld		lda	LCBank1		clc		xce		jml	GQuitQuitEnd		endp		end