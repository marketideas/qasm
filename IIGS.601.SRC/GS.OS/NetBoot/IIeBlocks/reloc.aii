		machine	m65c02		longa	off		longi	off		;; These would normally be defined from -d on command line;;P8Size		equ	16509;LogonSize	equ	17744TotalSize	equ	P8Size+LogonSize	; total number of bytes to moveLastPage	equ	TotalSize mod 256	; number of bytes in last pageFullPages	equ	TotalSize - LastPage	; number of bytes in whole pages;; Key addresses after relocation;P8Start		equ	$2000			; where P8 gets loadedLogonStart	equ	P8Start+P8Size		; where Logon gets loadedLogonEnd	equ	LogonStart+LogonSize	; end of Logon after relocationsrc		equ	$FC			; pointer to source of movedest		equ	$FE			; pointer to end of moveReloc		proc	org $800;; Point to the last (partial) page to move;		lda	#<P8Start+FullPages		sta	dest		lda	#>P8Start+FullPages		sta	dest+1		lda	#<FirstByte+FullPages		sta	src		lda	#>FirstByte+FullPages		sta	src+1;; Set up to move the last (partial page) then fall into the whole; page move loop (as if part of the last page was already moved).;		ldy	#LastPage		; number of bytes in the last page		ldx	#FullPages div 256	; number of whole pagesloop		lda	(src),y		sta	(dest),y		dey		cpy	#$FF			; end of page?		bne	loop				dec	src+1			; move to previous page		dec	dest+1		dex				; one less page to go		cpx	#$FF			; did last page?		bne	loop;; Now that code is relocated;		jmp	LogonStart		; jump to relocated LogonFirstByte		endp		end