***************************************************** des - data encryption standard. This routine is called with* low byte of the parameter list in the	X reg and the high* byte of the parameter list in the Y reg.*** written by    07-03-86*       david su** modified : 01-27-87 06:00 (tde)*  5-29-87: Converted source to MacToGS	(rbh)*  4-15-88: Converted source to MAX (msd)** (c) 1987 paramis corporation* (c) 1987 Apple Computer Inc* all rights reserved**       Parameter List: *       Pointer	    pointer <--	        ;*       Encription Key  pointer <--	        ;This is an	eight byte padded password*       Result	    pointer -->	        ;Eight Bytes** Rick Hoiberg 5/29/87***********************************************************	MACHINE M65C02	longa off	longi off	EXPORT desdes	PROCZp0	equ $c0Zp1	equ $c2** save four bytes of Zero page*	lda Zp0	;save on stack	pha	lda Zp0+1	pha	lda Zp1	pha	lda Zp1+1	pha** save parameter list location*	stx Zp0	;save parameter list pointer	sty Zp0+1** save key in our work area*	lda (Zp0)	;save key	sta Zp1	ldy #$01	lda (Zp0),y	sta Zp1+1;	ldy #$07	;move all eight bytes of keydes1	lda (Zp1),y	sta key,y	dey	bpl des1** save password in our work area*	ldy #$02	lda (Zp0),y	sta Zp1	iny	lda (Zp0),y	sta Zp1+1;	ldy #$07	;move all eight bytes of keydes2	lda (Zp1),y	sta random,y	dey	bpl des2;;;** initialize the count*	ldx #0des4		; 	stZ des_count,x	inx	cpx #32	bne des4;	jsr keysched	jsr encode;;** save result*	ldy #$04	lda (Zp0),y	sta Zp1	iny	lda (Zp0),y	sta Zp1+1;	ldy #$07	;move all eight bytes of keydes3	lda des_work1,y	sta (Zp1),y	dey	bpl des3** restore Zero page*	pla	sta Zp1+1	pla	sta Zp1	pla	sta Zp0+1	pla	sta Zp0	rts;;**************************************************** keysched : key schedule** this module takes	64 bits key and generates* the sixteen 48-bit keys k(1),k(2),...,k(16)** entry : none** exit  : none****************************************************keysched		; 	ldx #0key1		; 	stx des_x	;	lda pc1tbl,x	sta remainder	lda #8	sta des_countkey2		; 	dec des_count	sec	lda remainder	sbc #08	sta remainder	beq key22	;= 0 ?	bcs key2	;> 0 ?;key22		; 	clc	lda remainder	adc #8	sta remainder;	ldx remainder	bne key24	;x = 0 ?	ldx #8	;set to 8, if yeskey24		; 	dex	lda des_msk,x	ldy des_count	clc	and key,y	beq key3	seckey3		; 	ldx #$07key4		; 	rol des_work1,x	php	dex	bmi key5	plp	bra key4;key5		; 	plp	ldx des_x	inx	cpx #56	bne key1;** divide pc1 result	into c0/d0*	ldx #0key6		; 	lda des_work2,x	sta des_cd,x	inx	cpx #7	bne key6;** rotate c and d left by rotate(n) times*key9		; 	ldx #0keya		; 	stx des_x	;save # of times;	ldy #0keyb		; 	clc	lda des_cd	;save left most bit(cn)	rol a	php;	lda des_msk+3	;save left most bit(dn)	clc	and des_cd+3	beq keyb0	seckeyb0		; 	ldx #6keyc		; 	rol des_cd,x	dex	bpl keyc;	lda des_cd+3	and #%11101111	;clear right most bit(cn)	sta des_cd+3;	lda #0	plp	;restore left most bit(cn)	ror a	;move left most bit(cn)	ror a	;to right most bit(cn)	ror a	ror a	ora des_cd+3	sta des_cd+3;	ldx des_x	iny	lda rotat_left,x	sta des_temp	cpy des_temp	bne keyb;** permutation 2*	ldy #0keye		; 	sty des_y	;	lda pc2tbl,y	sta remainder	lda #7	;7 bytes toal for cn+dn	sta des_countkeyf		; 	dec des_count	sec	lda remainder	sbc #08	sta remainder	beq keyf0	;= 0 ?	bcs keyf	;> 0 ?;keyf0		; 	clc	lda remainder	adc #8	sta remainder;	ldx remainder	bne keyf2	;x = 0 ?	ldx #8	;set to 8, if yeskeyf2		; 	dex	lda des_msk,x	ldy des_count	clc	and des_cd,y	beq key0	seckey0		; 	ldx #7key01		; 	rol des_work1,x	php	dex	bmi key02	plp	bra key01;key02		; 	plp	ldy des_y	iny	cpy #48	bne keye;** move result of perm 2 to k(n)*	ldx #0key03		; 	lda des_work3,x	ldy des_k	sta k1,y	inc des_k	inx	cpx #6	bne key03;	ldx des_x	inx	cpx #16	beq key04	jmp keya;key04	rts;;**************************************************** encode - encryption module** entry : random1,...,random8** exit  : des_work1,...,des_work8****************************************************encode		; 	stZ des_y	;init des_y;	ldx #0ecd1		; 	stx des_x	;	lda iniptbl,x	sta remainder	lda #8	sta des_countecd2		; 	dec des_count	sec	lda remainder	sbc #08	sta remainder	beq ecd22	;= 0 ?	bcs ecd2	;> 0 ?;ecd22		; 	clc	lda remainder	adc #8	sta remainder;	ldx remainder	bne ecd24	;x = 0 ?	ldx #8	;set x to 8, if yesecd24		; 	dex	lda des_msk,x	ldy des_count	clc	and random,y	beq ecd3	sececd3		; 	ldx #7ecd4		; 	rol des_work1,x	php	dex	bmi ecd5	plp	bra ecd4;ecd5		; 	plp	ldx des_x	inx	cpx #64	bne ecd1;** move result of init perm to left/right block* move 8 times - first 4 bytes = des_l1*       - second 4 bytes = des_r1*	ldx #0ecd6		; 	lda des_work1,x	sta des_l1,x	inx	cpx #08	bne ecd6;** perform rn = ln eor f(rn,kn)* transform right 32 bits into 48 bits*	stz key_x	;initiaiZe k(n) pointer	ldx #0ecd60		; 	stx des_x1	;save counter;	ldx #0ecd65		; 	lda des_r1,x	;save rn origin to temp	sta des_temp1,x	inx	cpx #4	bne ecd65;	ldx #0ecd7		; 	stx des_x	;;	lda etbl,x	;perform e function	sta remainder	lda #4	;4 bytes only	sta des_countecd8		; 	dec des_count	sec	lda remainder	sbc #08	sta remainder	beq ecd82	;= 0 ?	bcs ecd8	;> 0 ?;ecd82		; 	clc	lda remainder	adc #8	sta remainder;	ldx remainder	bne ecd84	;x = 0 ?	ldx #8	;set x to 8, if yesecd84		; 	dex	lda des_msk,x	ldy des_count	clc	and des_r1,y	beq ecd9	sececd9		; 	ldx #5ecda		; 	rol des_work3,x	php	dex	bmi ecdb0	plp	bra ecda;ecdb0		; 	plp	ldx des_x	inx	cpx #48	beq ecdb1	jmp ecd7;** eor with k(48 bits)*ecdb1		; 	ldy #0ecdb		; 	ldx key_x	;get current k(n) pointer	lda k1,x	eor des_work3,y	sta des_work3,y	inx	stx key_x	;save pointer for k(n) blocks	iny	cpy #6	bne ecdb;** transform 48 bits	into 32 bits s(b1),...,s(bn)*	ldx #0ecdc		; 	jsr saddr	stx des_temp	lda des_work3	;des_work will shift 6 times	and #%10000100	;bit 7/2 are row #'s	bpl ecdd	and #%01111111	;strip out high bit	ora #%00001000	;save high bit to bit 3ecdd		; 	lsr a	lsr a	tax	;save row #		;	lda des_work3	and #%01111000	;bit 6-3 are column	#'s	lsr a	lsr a	lsr a	;column # in acc now		;ecde		; 	cpx #0	beq ecdf	clc	adc #16	;find s tbl pointer	dex	;decrement row #	bra ecde;ecdf		; 	tay	lda s1,y	asl a	;shift result to high byte	asl a	asl a	asl a;** move result to des_r1*	ldy #4ecd10		; 	rol a	ldx #3ecd11		; 	rol des_temp2,x	php	dex	bmi ecd110	plp	bra ecd11;ecd110		; 	plp	dey	bne ecd10;** shift des_work left 6 more times*	ldy #6ecd12		; 	ldx #5ecd13		; 	rol des_work3,x	dex	bpl ecd13	dey	bne ecd12;** 8 times already?*	ldx des_temp	inx	cpx #8	beq ptbl0	jmp ecdc	;do next s tbl;** perform 32 bits permutation* use ptbl*ptbl0		; 	ldx #0ptbl1		; 	stx des_x2	lda ptbl,x	sta remainder	lda #4	sta des_countptbl2		; 	dec des_count	sec	lda remainder	sbc #08	sta remainder	beq ptbl22	;= 0 ?	bcs ptbl2	;> 0 ?;ptbl22		; 	clc	lda remainder	adc #8	sta remainder;	ldx remainder	bne ptbl24	;x = 0 ?	ldx #8	;set to 8, if yesptbl24		; 	dex	lda des_msk,x	ldy des_count	clc	and des_temp2,y	beq ptbl3	secptbl3		; 	ldx #3ptbl4		; 	rol des_r1,x	php	dex	bmi ptbl5	plp	bra ptbl4;ptbl5		; 	plp	ldx des_x2	inx	cpx #32	bne ptbl1;;** exclusive or with	left block* perform function = ln eor f(rn,kn)*	ldx #0ecd112		; 	lda des_r1,x	;load rn	eor des_l1,x	;eor with ln	sta des_r1,x	;save result to rn	inx	cpx #4	bne ecd112;	ldx #0ecd115		; 	lda des_temp1,x	;move rn origin to ln	sta des_l1,x	inx	cpx #4	bne ecd115;** 16 times already?*	ldx des_x1	inx	cpx #16	beq ecd140	jmp ecd60	;yes, go back;** perform inverse permutation*ecd140		; 	jsr swap	;swap left and right halves	ldx #0ecd14		; 	stx des_x	;	lda invptbl,x	sta remainder	lda #8	sta des_countecd15		; 	dec des_count	sec	lda remainder	sbc #08	sta remainder	beq ecd152	;= 0 ?	bcs ecd15	;> 0 ?;ecd152		; 	clc	lda remainder	adc #8	sta remainder;	ldx remainder	bne ecd154	;x = 0 ?	ldx #8	;set x to 8, if yesecd154		; 	dex	lda des_msk,x	ldy des_count	clc	and des_l1,y	beq ecd16	sececd16		; 	ldx #7ecd17		; 	rol des_work1,x	php	dex	bmi ecd18	plp	bra ecd17;ecd18		; 	plp	ldx des_x	inx	cpx #64	bne ecd14;	rts	;end of des modules;swap		; ;switch des_l1 and des_r1	ldx #3swap1	lda des_l1,x	pha	lda des_r1,x	sta des_l1,x	pla	sta des_r1,x	dex	bpl swap1	rts		;** increment s table	pointer**       x = s# (0-7)*saddr	clc	lda #s1	adc tab64l,x	sta ecdf+2	lda #>s1	adc tab64h,x	sta ecdf+3	rtstab64l	DC.B 0,64,128,192,0,64,128,192tab64h	DC.B 0,0,0,0,1,1,1,1;;**************************************************** des data area***************************************************;;iniptbl	DC.B 7,15,23,31,39,47,55,63	DC.B 5,13,21,29,37,45,53,61	DC.B 3,11,19,27,35,43,51,59	DC.B 1,9,17,25,33,41,49,57	DC.B 8,16,24,32,40,48,56,64	DC.B 6,14,22,30,38,46,54,62	DC.B 4,12,20,28,36,44,52,60	DC.B 2,10,18,26,34,42,50,58;invptbl	DC.B 25,57,17,49,9,41,1,33	DC.B 26,58,18,50,10,42,2,34	DC.B 27,59,19,51,11,43,3,35	DC.B 28,60,20,52,12,44,4,36	DC.B 29,61,21,53,13,45,5,37	DC.B 30,62,22,54,14,46,6,38	DC.B 31,63,23,55,15,47,7,39	DC.B 32,64,24,56,16,48,8,40;etbl	DC.B 1,32,31,30,29,28	DC.B 29,28,27,26,25,24	DC.B 25,24,23,22,21,20	DC.B 21,20,19,18,17,16	DC.B 17,16,15,14,13,12	DC.B 13,12,11,10,9,8	DC.B 9,8,7,6,5,4	DC.B 5,4,3,2,1,32;pc1tbl	DC.B 8,16,24,32,40,48,56	DC.B 64,7,15,23,31,39,47	DC.B 55,63,6,14,22,30,38	DC.B 46,54,62,5,13,21,29	DC.B 2,10,18,26,34,42,50	DC.B 58,3,11,19,27,35,43	DC.B 51,59,4,12,20,28,36	DC.B 44,52,60,37,45,53,61;;convert from des algorithm;base 56pc2tbl	DC.B 43,40,46,33,56,52,54,29	DC.B 42,51,36,47,34,38,45,53	DC.B 31,49,41,50,30,37,44,55	DC.B 16,5,26,20,10,2,27,17	DC.B 6,12,24,9,13,8,18,1	DC.B 23,4,11,15,7,21,28,25;ptbl	DC.B 17,26,13,12,4,21,5,16	DC.B 32,18,10,7,28,15,2,23	DC.B 31,25,9,19,1,6,30,24	DC.B 14,20,3,27,11,22,29,8		;s1	DC.B 14,4,13,1,2,15,11,8	DC.B 3,10,6,12,5,9,0,7	DC.B 0,15,7,4,14,2,13,1	DC.B 10,6,12,11,9,5,3,8	DC.B 4,1,14,8,13,6,2,11	DC.B 15,12,9,7,3,10,5,0	DC.B 15,12,8,2,4,9,1,7	DC.B 5,11,3,14,10,0,6,13;s2	DC.B 15,1,8,14,6,11,3,4	DC.B 9,7,2,13,12,0,5,10	DC.B 3,13,4,7,15,2,8,14	DC.B 12,0,1,10,6,9,11,5	DC.B 0,14,7,11,10,4,13,1	DC.B 5,8,12,6,9,3,2,15	DC.B 13,8,10,1,3,15,4,2	DC.B 11,6,7,12,0,5,14,9;s3	DC.B 10,0,9,14,6,3,15,5	DC.B 1,13,12,7,11,4,2,8	DC.B 13,7,0,9,3,4,6,10	DC.B 2,8,5,14,12,11,15,1	DC.B 13,6,4,9,8,15,3,0	DC.B 11,1,2,12,5,10,14,7	DC.B 1,10,13,0,6,9,8,7	DC.B 4,15,14,3,11,5,2,12		;s4	DC.B 7,13,14,3,0,6,9,10	DC.B 1,2,8,5,11,12,4,15	DC.B 13,8,11,5,6,15,0,3	DC.B 4,7,2,12,1,10,14,9	DC.B 10,6,9,0,12,11,7,13	DC.B 15,1,3,14,5,2,8,4	DC.B 3,15,0,6,10,1,13,8	DC.B 9,4,5,11,12,7,2,14		;s5	DC.B 2,12,4,1,7,10,11,6	DC.B 8,5,3,15,13,0,14,9	DC.B 14,11,2,12,4,7,13,1	DC.B 5,0,15,10,3,9,8,6	DC.B 4,2,1,11,10,13,7,8	DC.B 15,9,12,5,6,3,0,14	DC.B 11,8,12,7,1,14,2,13	DC.B 6,15,0,9,10,4,5,3		;s6	DC.B 12,1,10,15,9,2,6,8	DC.B 0,13,3,4,14,7,5,11	DC.B 10,15,4,2,7,12,9,5	DC.B 6,1,13,14,0,11,3,8	DC.B 9,14,15,5,2,8,12,3	DC.B 7,0,4,10,1,13,11,6	DC.B 4,3,2,12,9,5,15,10	DC.B 11,14,1,7,6,0,8,13;s7	DC.B 4,11,2,14,15,0,8,13	DC.B 3,12,9,7,5,10,6,1	DC.B 13,0,11,7,4,9,1,10	DC.B 14,3,5,12,2,15,8,6	DC.B 1,4,11,13,12,3,7,14	DC.B 10,15,6,8,0,5,9,2	DC.B 6,11,13,8,1,4,10,7	DC.B 9,5,0,15,14,2,3,12;s8	DC.B 13,2,8,4,6,15,11,1	DC.B 10,9,3,14,5,0,12,7	DC.B 1,15,13,8,10,3,7,4	DC.B 12,5,6,11,0,14,9,2	DC.B 7,11,4,1,9,12,14,2	DC.B 0,6,10,13,15,3,5,8	DC.B 2,1,14,7,4,10,8,13	DC.B 15,12,9,0,3,5,6,11;des_msk	DC.B 1	DC.B 2	DC.B 4	DC.B 8	DC.B 16	DC.B 32	DC.B 64	DC.B 128;key	DS.B 8;random	DS.B 8;des_work1	DC.B 0des_work2	DC.B 0des_work3	DC.B 0des_work4	DC.B 0des_work5	DC.B 0des_work6	DC.B 0des_work7	DC.B 0des_work8	DC.B 0;des_count	DC.B 0remainder	DC.B 0key_x	DC.B 0des_x	DC.B 0des_x1	DC.B 0des_x2	DC.B 0des_y	DC.B 0des_k	DC.B 0des_temp	DC.B 0des_temp1	DS.B 4des_temp2	DS.B 4;des_l1	DS.B 4des_r1	DS.B 4;des_cd	DS.B 7;k1	DS.B 6k2	DS.B 6k3	DS.B 6k4	DS.B 6k5	DS.B 6k6	DS.B 6k7	DS.B 6k8	DS.B 6k9	DS.B 6k10	DS.B 6k11	DS.B 6k12	DS.B 6k13	DS.B 6k14	DS.B 6k15	DS.B 6k16	DS.B 6;rotat_left	DC.B 1,1,2,2,2,2,2,2	DC.B 1,2,2,2,2,2,2,1;;	ENDP	end