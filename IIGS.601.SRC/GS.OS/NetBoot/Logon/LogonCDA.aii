;------------------------------------------------------------; LogonCDA.aii;; This is an experimental version of the GS/OS-based Logon; CDA.;;------------------------------------------------------------		INCLUDE	'cons.macros'		include	'Console.equates'; macro to make an AppleTalk call for P16		macro&lab		ATCall	&Parm&lab		phx			; X and Y must be preserved		phy		rep	#$30		longa	on		longi	on		ldx	#&parm		ldy	#^&parm		jsl	$E11014		; Ram Dispatch		sep	#$30		longa	off		longi	off		ply		plx		mend*************************************************** OSFlag indicates the application type and is defined* as follows:** ProDOS 16 application = 64* ProDOS 8 application = 0* ProDOS 16 Boot Blocks = 192* ProDOS 8 Boot Blocks = 128***************************************************OSFlag		equ	64		;ProDOS 16 Application	NBPBuffLen	equ	8192AFPVersion	equ	$0200		;AFP version 2.0; These buffers must be defined storage	for P16.  In P8, they would be equates; to areas between $800 and $2000.LogonRec	Record	0ReplyBuff	DS.B	768ArrayBuff	DS.B	512WindowBuff	DS.B	512MySelArray	DS.B	256FSName		DS.B	64NameBuffer	DS.B	64PassBuffer	DS.B	16NewPassWrd	DS.B	16LogPckt		DS.B	128Prefix		DS.B	128SessBuff	DS.B	1024CompSelArray	DS.B	256NBPBuffer	ds.b	NBPBuffLen		EndRLogonCDA	PROC export		export	(InitParm,FrameParms1,MainWindow):code		export	(TitLine,SelXPos,SelYPos):code		export	(Increment,Selindex,StgArrayPtr):code		export	(ArrayCnt,ListOptByte,ListParms):code		export	(RestoreBox,MessParms,MessPtr):code		export	(FilterProc,MessOpt):code		export	(MessageWind,MainWindow):code				export	(Mess0,Mess20,Mess15):code				import	ConsDrvr		import	LogonData:LogonRec		with	LogonData				string	pascal		dc.b	'Logon'		string	asis		dc.l	StartUp		dc.l	ShutDown		StartUp		phk		plb		rep	#$30		longa	on		longi	on				pha			; space for result		ldx	#$2903		; GetIRQEnable		jsl	$E10000		; find out what IRQs are enabled				pea	$0001		; disable keyboard interrupts		ldx	#$2303		; IntSource		jsl	$E10000				sep	#$30		longa	off		longi	off		lda	#$C0		sta	InitParm		InitConsole		CursorOff		jsr	Logon		rep	#$30		longa	on		longi	on				pla			; get interrupt status		and	#$0080		; were keyboard interrupts enabled?		beq	ShutDown	; no, so don't turn them on				pea	$0000		; (re)enable keyboard interrupts		ldx	#$2303		; IntSource		jsl	$E10000ShutDown		rtl				INCLUDE	'logon.main'		INCLUDE	'icon.aii'		ENDPLogonData	ds	LogonRec		end