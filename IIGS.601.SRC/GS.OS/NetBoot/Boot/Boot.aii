;------------------------------------------------------------; Boot.aii;; Copyright Apple Computer, Inc 1988-1993; All Rights Reserved;; This is the first stage boot block for booting GS/OS over; the network.;; Modification history:; 12-Sep-88	MSD	Initial coding (based on Toucan); ??-???-??		Lots of revisions...; 31-Mar-92	MSD	If booting over EtherTalk, make a quick;			patch to RamDispatch that calls the card;			so Fizzy and other "files" can be loaded.; 27-Jan-93	DAL	Skips the 5-second '...' delay for Ethernet;			(see skipTheDelay).;  9-Mar-93	DAL	¥Put a version number at the beginning so;			the Ethernet ROM can check for it.;			¥Forces Battery RAM to be set correctly.; 24-Mar-93	DAL	¥Added an additional check when we decide;			if Ethernet is the startup device or not.;			If the card still looks like a bootable;			device at this point, then we are not booting;			from Ethernet!  When the card initializes, it;			changes its ID bytes to look like a printer;			instead.;  2-Apr-93	DAL	¥Now requires Ethernet ROM 2.0d25 or later.;			If it's earlier, we ignore the card, and the;			system assumes you're trying to boot from;			LocalTalk instead.;;------------------------------------------------------------RamDispatch	equ	$E11014		macro&lab		ATCall	&parm&lab		ldx	#<&parm		ldy	#^&parm		jsl	RamDispatch		mendhoriz		equ	0			; var: screen positionatp_count	equ	2			; var: number of blocks to readptr		equ	4hardware	equ	6			; temporary: which hardwareboot_unit	equ	$43			; boot unit number, $n0headerloc	equ	$E00			; where to put header blockBootHardware	equ	$E0E			; 1=LocalTalk, 2=EtherTalkfizzylen	equ	$F04			; length of Fizzy in header blocknbpbuffer	equ	$C00			; where NBP lookup puts datalook_addr	equ	nbpbuffer		; internet address of serverfizzy		equ	$1000			; load address of Fizzyline2		equ	$480			; screen address for charsspeed		equ	$C036			; register for system speedATPortNumber	equ	$E101C0			; port number used by AppleTalkATSlotNumber	equ	$E101C1			; slot being used by AppleTalkRPMSlotNumber	equ	$E101C2			; slot number being used by RPMboot		proc		import	lookup,reboot,atp,bds,checkbytes		import	atp_addr,blocknum,bitmap		import	buffer,matches		import	atlk1,etalkstr*** added 9-Mar-93 DAL;------------------------------------------------------------; Here is an embedded version number at the very beginning; of the boot blocks.;------------------------------------------------------------		jmp	@continue		dc.b	'ATLK'		dc.w	$2000			;version number@continue*** end 9-Mar-93				clc		xce				; set native mode		phk				; let us use short addressing		plb		sep	#$30			; 8 bits for I/O		longa	off		longi	off		;------------------------------------------------------------; Try to determine if we booted from an EtherTalk card.  If; so, display a little string and patch RamDispatch with a; little hack to call the card's ProDOS 8 entry point.;; To determine if we booted from an EtherTalk card, check; location $00/0043.  If it is of the form $n0 where n is; in the range 1..7 and there is a card with the correct; EtherTalk ID bytes in slot n, then assume we booted from it.;------------------------------------------------------------		stz	hardware		; assume LocalTalk		stz	hardware+1		; clear a whole word				lda	boot_unit		beq	not_ETalk		; zero is invalid		bit	#$8F			; any invalid bits set?		bne	not_ETalk;; Boot_unit is a valid unit number.  See if there is an EtherTalk card there.;		lsr	a		lsr	a		lsr	a		lsr	a		ora	#$C0			; A = $Cn		sta	ptr+1			; set up pointer to card Cnxx		lda	#$F9			; ID bytes at $CnF9		sta	ptr				ldy	#4@loop		lda	(ptr),y		cmp	atlk1,y		bne	not_ETalk		dey		bpl	@loop;; The ID bytes match.  Now let's see if the version is $2000 or more; (meaning it is an EtherTalk card, or at least as intelligent);*** changed 9-Mar-93 DAL to read version from $CnF7..8;;;		ldy	#6			; offset to version high byte;;;		lda	(ptr),y			; get from $CnFF		lda	#$f8		sta	ptr		lda	(ptr)*** end 9-Mar-93		cmp	#$20			; at least version 2.0?		blt	not_ETalk		; no, can't be EtherTalk*** added 2-Apr-93 DAL -- require Ethernet ROM 2.0d25 or later		dec	ptr			;$CnF7		lda	(ptr)		cmp	#$25			;must be $25 or higher		blt	not_ETalk*** end 2-Apr-93*** added 24-Mar-93 DAL -- Make sure the card does *not* still look like a***    bootable device.  If it does, we are not booting from it!		stz	ptr		ldy	#1		lda	(ptr),y			;check $Cn01; it's $20 if we're "bootable"		cmp	#$20		beq	not_ETalk*** end 24-Mar-93;; The card IS an EtherTalk card.  Put a character on screen and patch; the RamDispatch vector.;		inc	hardware				lda	#'!'+$80		sta	$0427			; right edge, first line on screen				lda	ptr+1			; get $Cn		sta	PatchJSR+2		; fix up the patch code				and	#$0F			; A=slot number		sta	>ATSlotNumber		sta	>RPMSlotNumber		lda	#0			; not using a built-in serial port		sta	>ATPortNumber				rep	#$20		longa	on		lda	ToPatch		sta	RamDispatch		lda	ToPatch+2		sta	RamDispatch+2		sep	#$20		longa	offnot_ETalk*** added 9-Mar-93 DAL;; We are network booting from either LocalTalk or Ethernet.  We; KNOW which one (hardware = 0 for LocalTalk, 1 for Ethernet),; so force the Battery RAM to be set appropriately.;		longa on		longi on		rep #$30		lda	hardware		;0=LocalTalk, 1=Ethernet		inc	a		pha				;Network medium: 1=LocalTalk, 2=Ethernet		pea	$0061;		_WriteBParam		ldx	#$0B03		jsl	$e10000		sep #$30		longa off		longi off*** end 9-Mar-93;------------------------------------------------------------; Delay about 5 seconds so other CPUs can get this first; block from the server.  Display some dots so the user knows; that something is happening.;------------------------------------------------------------*** 27-Jan-93 DAL -- No need to delay for Ethernet		lda	hardware		; nonzero = Ethernet		bne	skipTheDelay*** end 27-Jan-93		lda	speed			; find out our current speed		pha				; save for later restore		and	#$7F			; force slow mode		sta	speed			; set speed to slow		rep	#$10			; long mode for X,Y		longi	on		ldx	#0		ldy	#16			; 64K * 16 * 5 cycles = 5M cyclesdelay		dex		bne	delay		lda	#$AE			; normal period		sta	line2,y			; put on screen		dey		bne	delay				pla				; get old speed		sta	speedskipTheDelay	rep	#$30			; back to full native		longa	on		longi	on;------------------------------------------------------------; Here is where the boot process is restarted.  Remove; indication of progress on screen.  Look for a server, etc.;------------------------------------------------------------restart		stz	horiz			; start display at left of line		ldy	#38			; size of line to clear		lda	#$A0A0			; two normal spacesclearscrlp		sta	line2,y			; clear some of the line		dey		dey				; index to next word		bpl	clearscrlp		ATCall	lookup			; find a server		bcs	lookerr			; reboot if error		lda	matches			; did we find anything?		bne	getheader		; if so, continue boot;------------------------------------------------------------; Here, the NBP lookup for a server failed.  Let the ROMs; have another try at booting.;------------------------------------------------------------lookerr		ATCall	reboot			; force ROM to retry boot		brk				; should never return!;------------------------------------------------------------; If we get here, we did find a server for the second image.; We have to read the first block to see if it is the correct; version and to find out how much more we have to read.;------------------------------------------------------------getheader		lda	look_addr		; copy internet address		sta	atp_addr		; for ATP reuqest use		lda	look_addr+2		sta	atp_addr+2				stz	blocknum		; start with block 0		lda	#1			; only read 1 block		sta	atp_count		lda	#<headerloc		; copy address of buffer		sta	buffer			; where header is to be stored		jsr	fetch			; go get the block		ldy	#6			; last word's indexcheckloop		lda	checkbytes,y		; get what it should be		cmp	headerloc,y		; is that what we got?		bne	restart			; if not, try another server		dey		dey				; index to next word		bpl	checkloop		; check some more;------------------------------------------------------------; Now read Fizzy in at $1000.  Note that buffer pointer and; block number were bumped by "fetch".;------------------------------------------------------------		lda	fizzylen		; get length of Fizzy in blocks		sta	atp_count		; save number of blocks to read		jsr	fetch			; go read Fizzy		lda	hardware		; 0=LocalTalk, 1=EtherTalk		ina				; change to 1 or 2		sta	BootHardware		; let Fizzy know what hardware		jmp	fizzy			; go to Fizzy;------------------------------------------------------------; Fetch;; This routine reads a given number of blocks into the; current buffer address at the current block number.  The; buffer address and block number are updated on completion.;------------------------------------------------------------fetch		lda	#1			; only want 1 block at a time		sta	bitmap		ATCall	atp			; make an ATP request		bcs	fetcherr		; handle any errors				sep	#$20			; 8 bits for text handling		longa	off		lda	#$AA			; get an asterisk		ldy	horiz			; get index to screen		sta	line2,y			; put char on screen		iny				; point to next screen position		sty	horiz			; update index		rep	#$20			; back to full native		longa	on				inc	blocknum		; go to next block		inc	buffer+1		; point buffer to next block		inc	buffer+1		; ($200 bytes)		dec	atp_count		; one less block to do		bne	fetch			; continue reading if more		rts				; return to callerfetcherr		pla				; remove return address		brl	restart			; try booting againToPatch		jml	>DispatchPatchDispatchPatch		cpy	#0			; bank had better be zero!		beq	@ok		brk	$BB			; bank is messed up!@ok		stx	PatchPBPtr				sec		xce				; force emulation mode		PatchJSR	jsr	$C714			; call card's entry point		dc.b	$42			; AppleTalk callPatchPBPtr	dc.w	0				xce				; preserve carry in e flag		clc		xce				; back to native mode, restore carry		rep	#$30			; force long registers				rtl		endpcheckbytes	dc.b	'GSOSBOOT'		; signature of header blockservername	record		string	pascal		dc.b	'='		dc.b	'ProDOS16 Image'		dc.b	'*'		string	asis		endrbds		record		entry	buffer		dc.w	512			; response buffer is 512 bytesbuffer		dc.l	0			; address for response		dc.l	0			; returned user bytes		dc.w	0			; actual length		endratp		record		entry	atp_addr,blocknum,bitmap		dc.b	0,18			; sync. SendATPReq		dc.w	0			; result		dc.l	0			; no completion routine		dc.b	0			; socket numberatp_addr	dc.l	0			; destination address		dc.w	0			; TID		dc.w	0			; request buffer size		dc.l	0			; request buffer address		dc.b	3			; User bytes:	machineblocknum	dc.w	0			;		block number		dc.b	0			;		unused		dc.b	1			; 1 response buffer		dc.l	bds			; pointer to response BDS		dc.b	0			; ATP flags: at least once		dc.b	8,32			; retry every 2 seconds, 32 timesbitmap		dc.b	0			; bitmap of blocks to receive		dc.b	0			; number of responses received		dc.w	0,0,0			; RESERVED		endrlookup		record		entry	matches		dc.b	0,16			; sync. NBPLookup		dc.w	0			; result		dc.l	0			; no completion routine		dc.l	servername		; pointer to name to find		dc.b	8,16			; try every 2 seconds, 16 times		dc.w	0			; RESERVED		dc.w	256			; size of buffer		dc.l	nbpbuffer		; address of buffer		dc.b	1			; only want 1 matchmatches		dc.b	0			; actual matches		dc.b	0			; let matches be a word value		endrreboot		record		dc.b	0,6			; sync. boot		dc.w	0			; result		endratlk1		dc.b	'ATLK',$01		; ID bytes for EtherTalk card		end