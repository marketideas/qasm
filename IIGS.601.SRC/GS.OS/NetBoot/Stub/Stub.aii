;------------------------------------------------------------; Stub.aii;; This is the FST stub used when booting GS/OS over the net.; Written by Mark Day.;------------------------------------------------------------		entry	(startup,readinfile,getbootname):code		entry	(getfstname,PutWord,PutPath):code		entry	(StartCommand,SendCommand,ConvertError):code		entry	(getbootinfo):code		entry	(ListBuffer):data		RamDispatch	equ	$E11014			; native mode AppleTalk entryCommandBuf	equ	$1000			; where SPCommand packet is builtReplyBuf	equ	$1200			; where SPCommand reply data goesBufferSize	equ	$1000			; size of ListSessions bufferpriority_vec	equ	$E1103A			; AppleTalk priority vectorafpCloseFork	equ	4			; close an AFP forkafpOpenFork	equ	26			; open a fork of an AFP fileafpRead		equ	27			; read from forkdp		record	0nameptr		ds.l	1			; buffer pointer to return nameslistptr		ds.l	1			; pointer for ListSessionsbufptr		ds.l	1			; pointer to buffer for readmark		ds.l	1			; where in file to read fromforkrefnum	ds.l	1			; AFP's open fork refnumcmd_index	ds.w	1			; index into command packetmath_temp	ds.l	1		endrheader		proc		entry	aux_value				jmp	startup		nop				dc.w	readinfile		dc.w	getbootname		dc.w	getfstname		dc.w	startup-header		; size of permanent codeaux_value	dc.w	0		endpbootvolname	ds	34			; room for 32 char G-StringSessRefnum	dc.w	0			; Boot volume's SessRefnumVolID		dc.w	0			; Boot volume's VolID;------------------------------------------------------------; This is the parameter list for the SPCommand call; which is used to send out an AFP command.;------------------------------------------------------------SPCommand	record		dc.b	0,$20		; sync, call numberResult		dc.w	0		dc.l	0		; completion routineSRef		dc.b	0		; session reference #ComLen		dc.w	0		; command block lengthComAddr		dc.l	CommandBuf	; command block addressRepBufLen	dc.w	0		; reply buffer lengthRepAddr		dc.l	0		; reply buffer addressComRes		dc.l	0		; result (from server)RepLen		dc.w	0		; actual reply length		endrreadinfile	proc		with	dp		;------------------------------------------------------------; Pull input parameters from stack;------------------------------------------------------------		lda	3,s			; get low word of buffer address		sta	bufptr		lda	5,s			; and high word		sta	bufptr+2				lda	7,s			; get low word of pathname pointer		sta	nameptr		lda	9,s		sta	nameptr+2				lda	1,s			; copy return address over last		sta	9,s			; input parameter				pla				; squeeze extra bytes from stack		pla		pla		pla;------------------------------------------------------------; Do an FPOpenFork on the file;------------------------------------------------------------		lda	#afpOpenFork		jsr	StartCommand				lda	VolID			; put in VolID		jsr	PutWord				lda	#$0000			; DirID = 2		jsr	PutWord		lda	#$0200		jsr	PutWord				lda	#$0020			; ProDOS info		jsr	PutWord			; in bitmap				lda	#$2100			; read, deny write		jsr	PutWord			; as access mode				jsr	PutPath			; put path in packet		jsr	SendCommand		; send out the command		jsr	ConvertError		bcc	@ok		brl	exit@ok				lda	ReplyBuf+2		; get open fork refnum		sta	forkrefnum				lda	ReplyBuf+4		; get ProDOS filetype		sta	3,s			; and return it		lda	ReplyBuf+6		; get ProDOS auxtype (low)		sta	5,s			; and return it				stz	mark			; start from beginning of file		stz	mark+2		;------------------------------------------------------------; Do FPReads until we get an error (EOF error is OK);------------------------------------------------------------read_loop		lda	#afpRead		; start a Read command		jsr	StartCommand				lda	forkrefnum		; AFP open fork refnum		jsr	PutWord				lda	mark+2			; offset high word		xba		jsr	PutWord		lda	mark			; offset low word		xba		jsr	PutWord				lda	#0			; request $1200 bytes		jsr	PutWord		lda	#$0012			; $1200, byte-flipped		jsr	PutWord				lda	#0			; no newline stuff		jsr	PutWord				lda	bufptr			; reply directly to user buffer		sta	SPCommand.RepAddr		lda	bufptr+2		sta	SPCommand.RepAddr+2				jsr	SendCommand		jsr	ConvertError		; turn into ProDOS error code		bcc	@ok		cmp	#$4C			; EOF?  If so, check transfer count		bne	closeit			; not EOF, so return it@ok		clc				; move mark to end of reply		lda	mark		adc	SPCommand.RepLen		sta	mark		lda	mark+2		adc	#0		sta	mark+2		clc				; point buffer past reply		lda	bufptr		adc	SPCommand.RepLen		sta	bufptr		lda	bufptr+2		adc	#0		sta	bufptr+2		lda	SPCommand.ComRes+2	; what error did server return?		beq	read_loop		; no error continues		lda	#0			; no errorcloseit		pha;------------------------------------------------------------; Do an FPClose on the fork;------------------------------------------------------------		lda	#afpCloseFork		jsr	StartCommand				lda	forkrefnum		; fork refnum		jsr	PutWord		jsr	SendCommand; Should NEVER get an error on that call		pla				; restore error code		cmp	#1			; set carry if error		bcs	exit			; return if error		;------------------------------------------------------------; Return EOF of file and go back to caller.;------------------------------------------------------------		lda	mark		sta	7,s			; return EOF low word		lda	mark+2		sta	9,s			; return EOF high word				clc				; no error		lda	#0exit		rts		endwith				; with dp		endpgetbootname	proc		with	dp		lda	3,s			; get low word of buffer address		sta	nameptr		lda	5,s			; get high word		sta	nameptr+2				lda	1,s			; copy return address over last parameter		sta	5,s		pla				; remove space of long parameter from stack		pla		ldy	bootvolname		; get length of name		iny				; plus 1 for last byte index		sep	#$20			; 8 bit mode to mvoe chars		longa	offloop		lda	bootvolname,y		; get a byte of the name		sta	[nameptr],y		; put it where GLoader wants it		dey		bpl	loop			; index is 0..length+1				rep	#$20			; back to full native		longa	on				clc				; never get an error on this routine		lda	#0		rts				endwith				; with dp		endp;------------------------------------------------------------; StartCommand initializes some values in SPCommand parameter; list and puts the command number (in A) into the packet.;------------------------------------------------------------StartCommand	proc		with	SPCommand		ldy	SessRefnum		; fill in session refnum		sty	SRef		ldy	#$1200			; reply up to $1200 bytes		sty	RepBufLen				ldy	#<ReplyBuf		; reply in reply buffer		sty	RepAddr		ldy	#^ReplyBuf		sty	RepAddr+2				stz	dp.cmd_index		; start from the beginning; fall through into PutWord		endwith				; with SPCommand		endp;------------------------------------------------------------; PutWord puts the word in A into the packet;------------------------------------------------------------PutWord		proc		ldx	dp.cmd_index		; get index to packet		sta	CommandBuf,x		; put word in		inx				; bump pointer by 2 bytes		inx		stx	dp.cmd_index		rts		endp;------------------------------------------------------------; PutPath puts the G-String pointed to by nameptr into the; command packet.;------------------------------------------------------------PutPath		proc		with	dp		lda	[nameptr]		; get length		xba				; in second byte		ora	#2			; path type is 2: long names		jsr	PutWord		lda	[nameptr]		; get length again		ina				; plus 1 is last index		ina				; plus 1 is stopping point		sta	math_temp		ldy	#2			; index to first char		ldx	cmd_index		; index into packet		sep	#$20			; 8-bit A for chars		longa	offloop		lda	[nameptr],y		cmp	#':'			; separator?		bne	@stuff			; no, so put it in		lda	#0			; separator becomes a NUL@stuff		sta	CommandBuf,x		iny		inx		cpy	math_temp		; done yet?		bne	loop		stx	cmd_index		; save index back				rep	#$20			; back to full native		longa	on		rts		endwith				; with dp		endp;------------------------------------------------------------; SendCommand does the actual SPCommand call;------------------------------------------------------------SendCommand	proc		lda	dp.cmd_index		; length of command packet		sta	SPCommand.ComLen				ldx	#<SPCommand		ldy	#^SPCommand		jsl	RamDispatch		; do the SPCommand		bcc	exit				lda	#$2F			; assume device offline if ASP failedexit		rts				endp;------------------------------------------------------------; ConvertError checks the AFP error code and returns the; appropriate ProDOS error code.;; On entry, A = result from SPCommand call;------------------------------------------------------------ConvertError	proc		bcs	done			; propagate ASP errors				lda	SPCommand.ComRes+2	; get AFP error code		beq	done			; return with no error?				cmp	#$66EC			; file not found?		bne	x1		lda	#$46			; file not found!		bra	donex1		cmp	#$6FEC			; EOF error		bne	x2		lda	#$4C			; EOF error		bra	donex2		cmp	#$78EC			; access denied?		bne	x3		lda	#$4E			; access denied		bra	donex3		lda	#$27			; I/O error for the restdone		cmp	#1			; set carry if error		rts				; go back		endp;------------------------------------------------------------; Temporary code starts here (code used only when booting,; and not when switching).  The first routine MUST be; "startup" since I use it to compute the size of the; permanent code.;------------------------------------------------------------startup		procstart_loc	equ	$6800			; where START.GS.OS is loadedGLoader2	equ	$6803			; alternate entry for GLoader;------------------------------------------------------------; I already know that I'm running on a GS with rev 01 or; later ROMs.  Do some simple initialization and load the; file START.GS.OS from the boot volume.;------------------------------------------------------------		lda	#0		tcd				; direct register = $0000		pea	$0000		plb		plb				; bank register = $0000		lda	#$01FF		tcs				; stack register = $01FF				lda	#$6B6B			; RTL RTL		sta	priority_vec		; don't load primary AppleTalk drivers		lda	#0		sta	priority_vec+2				jsr	getbootinfo		; find user volume;------------------------------------------------------------; Here is where error checking code would go.;------------------------------------------------------------		pha				; push 8 bytes for return values		pha		pha		pha		pea	start_path>>16		; push address of pathname		pea	start_path		pea	start_loc>>16		; push load address		pea	start_loc		jsr	readinfile		; go get the file		bcc	got_file		; if no errors, continue		pha				; push error code		pea	NoStartGSOS>>16		pea	NoStartGSOS		; push pointer to string		ldx	#$1503			; SysFailMgr		jsl	$E10000			; go do the fatal errorgot_file		pla				; ignore file type		pla		ldx	aux_value		; has it been set yet?		bne	skip_aux		; yes, so use that value		sta	aux_value		; save auxtype of fileskip_aux		pla				; ignore EOF		pla;------------------------------------------------------------; Now start up GS/OS.;------------------------------------------------------------		lda	#$F800			; bypass AppleTalk/SCC init, etc.		jmp	GLoader2		; let GLoader do the rest;------------------------------------------------------------; Pathname of GLoader/GQuit;------------------------------------------------------------start_path	dc.w	path_end-path_begin	; it's a G-Stringpath_begin	dc.b	'SYSTEM:START.GS.OS'path_endNoStartGSOS		dc.b	@end-@start@start		dc.b	'Cannot load file Start.GS.OS',$0D		dc.b	'Error=$'@end		endpgetfstname	proc		with	dp		lda	3,s			; get low word of buffer address		sta	nameptr		lda	5,s			; get high word		sta	nameptr+2				lda	1,s			; copy return address over last parameter		sta	5,s		pla				; remove space of long parameter from stack		pla		ldy	the_name		; get length of name		iny				; plus 1 for last byte index		sep	#$20			; 8 bit mode to mvoe chars		longa	offloop		lda	the_name,y		; get a byte of the name		sta	[nameptr],y		; put it where GLoader wants it		dey		bpl	loop			; index is 0..length+1				rep	#$20			; back to full native		longa	on				clc				; never get an error on this routine		lda	#0		rts		the_name	dc.w	textend-textstarttextstart	dc.b	'AppleShare.FST'textend		endwith				; with dp		endpListSessions	record		dc.b	0			; synchronous only		dc.b	$2F			; list sessions call numberResult		dc.w	0			; result codeBufLen		dc.w	BufferSizeBufPtr		dc.l	ListBuffer		; address of bufferEntries		dc.b	0			; entries returned		endr;------------------------------------------------------------; GetBootInfo is called by Startup to determine the name of; the boot volume and to save off the SessRefnum and VolID.;------------------------------------------------------------getbootinfo	proc		with	dp		ldx	#<ListSessions		; do an FIListSessions call		ldy	#^ListSessions		jsl	RamDispatch		bcs	no_vol			; return an error		lda	ListSessions.Entries	; how many entries returned?		and	#$00FF			; only a byte is valid		beq	no_vol			; no entries, return an error		tax				; put in X for counting		lda	#<ListBuffer		; set up pointer to ListSessions buffer		sta	listptr		lda	#^ListBuffer		sta	listptr+2;------------------------------------------------------------; Scan the buffer returned by ListSessions for a user volume.;------------------------------------------------------------loop				lda	[listptr]		; get session and slot/drive		and	#$0100			; is it a user volume?		bne	found_it		; yes, so go return it				clc		lda	listptr		adc	#32			; size of session/volume record		sta	listptr			; point to next entry in buffer		lda	listptr+2		adc	#0		sta	listptr+2				dex				; any more entries?		bne	loop;------------------------------------------------------------; If we get here, we couldn't find a user volume.;------------------------------------------------------------no_vol		sec				; indicate an error		rts;------------------------------------------------------------; At this point, a user volume was found.  Copy the G-String; with leading colon to boot volume name buffer.;------------------------------------------------------------found_it		ldy	#2			; offset to length byte		lda	[listptr],y		; get length byte		and	#$00FF			; only a byte		ina				; plus 1 for colon;		sta	[nameptr]		; save as length word		sta	bootvolname		; save for getbootname		tax				; save length for loop				sep	#$20			; 8-bit A for chars		longa	off		lda	#':'			; put colon in front		sta	[listptr],y		; overwrite length bytecopy_loop		lda	[listptr],y;		sta	[nameptr],y		; copy char to buffer		sta	bootvolname,y		; copy to bootvolname buffer		iny		dex				; done all chars yet?		bne	copy_loop				rep	#$20			; back to full native		longa	on		lda	[listptr]		; get sessrefnum, slot/drive		and	#$00FF			; SessRefnum only		sta	SessRefnum				ldy	#$1E			; offset to VolID		lda	[listptr],y		sta	VolID				clc				; no error		rts		endwith				; with dp		endpListBuffer	record		endr		end