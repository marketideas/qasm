;------------------------------------------------------------; Start.aii;; This program handles logging on/off of file servers and; launching a user's startup application.  It uses the; MessageCenter to remember whether this is a first time boot,; local/remote boot, and quick logoff/ask me.;; This file should be installed as the file '*:System:Start'; on the User Volume.;; Written by Mark Day;; Modification History; ??-???-88	MSD	First release; 11-Jan-89	MSD	Added local boot disk support.; 27-Jan-89	MSD	Major restructuring.;			Added check for AppleShare FST.; 24-Jul-89	MSD	Added code to set the default printer;			at the same time the prefix is being;			set and the startup app is being;			launched.  (version 1.0.1); 13-Apr-91	MSD	System 6.0 does a shutdown if there is;			no application to quit to and the quit;			stack is empty.  This means that after;			the user's application quits, we're in;			trouble.  Therefore, launch the START;			program on the new volume first.  (We;			can't leave the original START program;			on the stack since its volume may no;			longer be online).;;			A new flag in the message center flags;			says that this is a volume switch, not;			a quit from a user application.; 19-Jun-91	MSD	Version 1.0.2d2.  Now passes 1 in A to;			tell Logon that we're using GS/OS.;  3-Sep-91	MSD	Before quitting to the user's startup;			application, or the START program, I do;			a GetFileInfo to make sure it exists.; 17-Sep-91	MSD	Version 1.0.2d3.  Changed how setup files;			are loaded.  A zero word is pushed just;			before they're JSL'd to.  If a permanent;			setup file sets bit 0 of that word, it;			will be unloaded just like a temporary;			setup file.  This makes network booting;			work like GLoader.;  7-Feb-92	MSD	Changed version number to 1.0.2 final;			for 6.0d70 (GM) build.;------------------------------------------------------------;		print	push,off		include	'Cons.Macros'		include	'Console.Equates'		include	'M16.Locator'		include 'M16.Memory'		include	'M16.ProDOS'		include	'M16.GSOS'		include 'M16.Desk'		include 'M16.Loader'		include	'M16.Resources'		include	'Start.m';		print	pop		MyMsgType	equ	$0088		; message type for AppleTalkaddMessage	equ	$0001		; command to add a messagegetMessage	equ	$0002		; command to get a messageNDA_type	equ	$B8		; New Desk AccessoryCDA_type	equ	$B9		; Classic Desk AccessorySETUP_type	equ	$B6		; permanent setupTEMP_type	equ	$B7		; temporary setupdp		record	0myuserid	ds.w	1		; my user ID (from MM)localflag	ds.w	1		; high bit set if booted locallybootflag	ds.w	1		; high bit set if bootingquickflag	ds.w	1		; high bit set if quicklogoffnewvolflag	ds.w	1		; high bit set if switching boot volumesmsghandle	ds.l	1		; handle to messagemsgptr		ds.l	1		; pointer to messagemailflag	ds.w	1		; set if mail waitingLoadMemID	ds.w	1		; user ID returned by LoaderZPStart		ds.w	1		; start of direct page segmentZPSize		ds.w	1		; size of direct page segmentLoadAddr	ds.l	1		; address where file was loadedLoadHandle	ds.l	1		; handle of file's memorysavesize		endrafp_driver	equ	$001E		; device type for AFP driverashare_f_sys	equ	$000D		; file_sys_id for AppleSharebad_dev_num	equ	$0011		; error code: invalid device numberadb_modifiers	equ	$C025		; I/O: modifiers latch		import	(StartLogon,ConsDrvr):code		import	(ListParms,SelXPos,SelYPos):code		import	(Increment,ArrayCnt,MySelArray):code		import	(StgArrayPtr,SelIndex,ListOptByte):code		import	(InitParm,TitLine):code		import	(MainWindow,FrameParms1):code		import	(RestoreBox,MessParms,MessPtr):code		import 	(FilterProc,MessOpt):code		import	(MessageWind,MainWindow):code				import	(Mess0,Mess20,Mess15):codestart		proc		with	dp				import	InfoParms:tDInfo		import	FSTInfoParms:tFSTInfo				import	(get_flags,set_booted):code		import	(do_logon,do_logoff):code		import	(load_files,check_mail,launch_app,launch_start):code		import	(one_moment,set_boot_vol,clear_boot_vol):code		import	(eject_all,shut_down):code		import	ErrorHandler:code				import	(Title,MenuPrompt,MenuList):code				phk		plb			; get current bank for short addressing;------------------------------------------------------------; Init the console driver so we can display messages;------------------------------------------------------------		sep	#$30		longa	off		longi	off		lda	#$C0		sta	InitParm	; set up for 65816		InitConsole		WriteChar RSTWind	; reset window		WriteChar ClrWind	; clear window just in case		CursorOff		; don't want flashing cursor		rep	#$30		longa	on		longi	on		;------------------------------------------------------------; Start up the memory manager.;------------------------------------------------------------		pha			; space for user ID		_MMStartup		pla			; recover user ID		sta	myuserid;------------------------------------------------------------; Make sure AppleShare is up and running.;------------------------------------------------------------		lda	#1		sta	FSTInfoParms.fst_num	; start with first FSTcheck_atalk		_GetFSTInfoGS FSTInfoParms		bcs	no_atalk		; no more FSTs => no AppleShare		lda	FSTInfoParms.file_sys_id		cmp	#ashare_f_sys		; is it AppleShare?		beq	yes_atalk		; yes, so we're OK				inc	FSTInfoParms.fst_num	; try next FST		bra	check_atalkno_atalk		ldx	#3			; AppleTalk not present error		jsr	ErrorHandler		jsr	eject_all		; eject all devices		jsr	shut_down		; reboot the machine		bra	no_atalk		; should never get here!		yes_atalk;------------------------------------------------------------; Determine if we booted over the net or locally.;------------------------------------------------------------		stz	localflag		; assume booted from server		lda	#1			; boot device is always #1		sta	InfoParms.dev_num		_DInfoGS InfoParms		; figure out what kind it is		lda	InfoParms.dev_type	; get device type		cmp	#afp_driver		beq	from_server		; it was a server		lda	#$8000		tsb	localflag		; set local volume flagfrom_server;------------------------------------------------------------; Allocate a new handle for getting/setting message info.;------------------------------------------------------------		pha			; push long space		pha		pea	tMessage.size>>16		pea	tMessage.size		pei	myuserid	; push my user ID		pea	$0000		; get me anything		pea	0>>16		; don't care where		pea	0		_Newhandle				pla		sta	msghandle		pla		sta	msghandle+2		;------------------------------------------------------------; Get the flags from MessageCenter;------------------------------------------------------------		jsr	get_flags;------------------------------------------------------------; Did we just switch to a new boot volume?;------------------------------------------------------------		bit	newvolflag	; just log onto new boot volume?		bpl	norm_quit	; no, so handle as usual		jsr	set_booted	; clear newvolflag in message center		jsr	launch_app	; launch app from ATINIT		bra	select1		; error: log offnorm_quit;------------------------------------------------------------; Are we booting this time?;------------------------------------------------------------		bit	bootflag	; booting?		bpl	switch		; no, switch users;------------------------------------------------------------; We're booting.  If it's local, we need to log on;------------------------------------------------------------		bit	localflag	; are we local?		bpl	skipbootlog	; no, so don't log on				jsr	do_logon	; local boot disk logonskipbootlog		jsr	one_moment	; keep user entertained;------------------------------------------------------------; If we booted locally, don't bother loading personal setup; files and desk accessories;------------------------------------------------------------		bit	localflag	; local?		bmi	skipbootsetup	; yes, don't load files				jsr	load_files	; load setups and DAsskipbootsetup		jsr	set_booted	; remember that we've booted		jsr	check_mail	; see if user has any mail		jsr	launch_app	; try to launch their startup application		bra	select1		; must be an error, do quick logoff;------------------------------------------------------------; Here, we are running Start other than the first time.  So; the user's application has quit and we need to see what to; do next.;------------------------------------------------------------switch		bit	quickflag	; do they want quick logoff?		bmi	select1		; yes, they want quick logoff;------------------------------------------------------------; They don't have QuickLogoff installed, so put up the menu; of choices and see what they want to do next.;------------------------------------------------------------selectloop		jsr	get_selection	; find out what user wants to do		dea			; was A=1 (logoff)?		beq	select1		; go do quick logoff		dea			; was A=2 (restart app)?		beq	select2		; go do restart		dea			; was A=3 (reboot)?		beq	select3		bra	selectloop	; should never get here!!;------------------------------------------------------------; User either has QuickLogoff installed, or has chosen the; logoff option from the menu.;------------------------------------------------------------select1		jsr	clear_boot_vol	; close files on boot volume		jsr	do_logoff	; log off of all servers		jsr	do_logon	; log them onto a server		jsr	one_moment	; keep user entertained		jsr	check_mail	; see if they have any mail				bit	localflag	; did they boot locally?		bmi	skipsetvol	; if so, don't set boot volume				jsr	set_boot_vol	; use new boot volume nameskipsetvol		jsr	launch_start	; launch START on new volume		bra	select1		; must be an error, do quick logoff;------------------------------------------------------------; User has chosen to re-run the startup application;------------------------------------------------------------select2		jsr	launch_app		bra	select1		; must be an error, do quick logoff;------------------------------------------------------------; User chose to reboot.  Eject all media and reboot machine.;------------------------------------------------------------select3		jsr	clear_boot_vol	; close files, etc.		jsr	eject_all	; eject all media		jsr	shut_down	; do an OS_Shutdown		bra	selectloop	; should never get here!!!;------------------------------------------------------------; Get_Selection; This routine puts up the menu with the logoff, re-run, and; reboot options.  It returns the choice number (1-3) in A.;------------------------------------------------------------get_selection				sep	#$30		longa	off		longi	off				WriteChar RSTWind		WriteChar ClrWind		FrameRect FrameParms1	; draw the main box		SViewPort MainWindow	; draw inside frame		WriteCStr Title		; draw the title		ReptChar TitLine	; and the line below it				WriteCStr MenuPrompt	; draw prompt at bottom of screenmenu_loop		ldx	#10		stx	SelXPos		ldx	#3		stx	SelYPos		ldx	#1		stx	Increment		stx	SelIndex		lda	#<MenuList		sta	StgArrayPtr		lda	#>MenuList		sta	StgArrayPtr+1		lda	#3		sta	ArrayCnt		sta	ListOptByte		ListHandler ListParms	; go get user's selection				cmp	#Return		; did they press return?		bne	menu_loop				rep	#$30		; back to full native mode		longa	on		longi	on		lda	SelIndex	; what did he select?		and	#$00FF		; mask off only a byte		rts		endwith			; with dp		endp;------------------------------------------------------------; Eject all volumes on-line;------------------------------------------------------------eject_all	proc		import	InfoParms:tDInfo		import	EjectParms:tControl		lda	#1			; first unit number		sta	InfoParms.dev_num	; save as device number@loop		_DInfoGS InfoParms		cmp	#bad_dev_num		; invalid device number?		beq	@done		lda	InfoParms.dev_num	; get device number		sta	EjectParms.dev_num	; save for eject		_DControlGS EjectParms		; eject the device@next		inc	InfoParms.dev_num		bra	@loop@done		rts		endp;------------------------------------------------------------; Shut down the machine (using OS_Shutdown);------------------------------------------------------------shut_down	proc		jsl	$E100A8		; GS/OS call		dc.w	$2003		; class 1 OS Shutdown		dc.l	ShutDownParms	; pointer to parameter list		rtsShutDownParms		dc.w	1		; pcount = 1		dc.w	0		; shutdown_flag = power off		endp		;------------------------------------------------------------; Do_Logoff; Log off of all file servers;------------------------------------------------------------do_logoff	proc		import	InfoParms:tDInfo		import	EjectParms:tControl				lda	#1			; first unit number		sta	InfoParms.dev_num	; save as device number@loop		_DInfoGS InfoParms		cmp	#bad_dev_num		; invalid device number?		beq	@done		lda	InfoParms.dev_type	; get device type		cmp	#afp_driver		; is it an AFP driver?		bne	@next				lda	InfoParms.dev_num	; get device number		sta	EjectParms.dev_num	; save for eject		_DControlGS EjectParms		; eject the device@next		inc	InfoParms.dev_num		bra	@loop@done		rts				endp		;------------------------------------------------------------; Do_Logon; Log on to a file server;------------------------------------------------------------do_logon	proc		jsr	StartLogon	; go do the logon		rts		endp;------------------------------------------------------------; One_Moment; Put up the "One moment please..." dialog.;------------------------------------------------------------one_moment	proc		import	(MessRect,moment_str):data		sep	#$30		longa	off		longi	off				WriteChar RSTWind		FrameRect MessRect		SViewPort MessageWind		WriteChar ClrWind		WriteCStr moment_str				rep	#$30		longa	on		longi	on		rts		endp;------------------------------------------------------------; Clear_Boot_Vol;; If we booted diskless, then we need to close everything; down (like closing SYS.RESOURCES on the boot volume) so; that the boot volume can be ejected.;------------------------------------------------------------clear_boot_vol	proc		with	dp		import	(GetLevelParms,SetLevelParms):code		import	CloseParms:tClose				bit	localflag		; did we boot locally?		bmi	exit			; yes, so don't close things				pea	$0001			; "Sys.Resources"		_CloseResourceFile				pea	$0000			; all user files		_CloseResourceFile				_GetLevelGS GetLevelParms	; get the current open file level		_SetLevelGS SetLevelParms	; set to system level=0		stz	CloseParms.refnum	; 0=close everything		_CloseGS CloseParms		; do the close call		_SetLevelGS GetLevelParms	; restore levelexit		rts		endwith		endp;------------------------------------------------------------; Set_Boot_Vol;; Set the name of the boot volume to the name of the user; volume.;------------------------------------------------------------set_boot_vol	proc		with	dp		import	(SetStarParms,SysResPath):code		import	(GetLevelParms,SetLevelParms):code				jsl	$E100A8			; GS/OS		dc.w	$2033			; FST specific		dc.l	SetStarParms		; pointer to parm list		;		pei	myuserid;		_ResourceStartup				_GetLevelGS GetLevelParms	; get the current open file level		_SetLevelGS SetLevelParms	; set to system level=0		pha				; space for resource file ID		pea	$0001			; request read only		pea	$0000			; no resource map in memory		pea	$0000		pea	$0000			; NIL => use SYS.RESOURCES		pea	$0000		_OpenResourceFile		pla				; get resource file ID		_SetLevelGS GetLevelParms	; restore level		;		_ResourceShutdown		rts				endwith		endp;------------------------------------------------------------; Message Center routines; get_flags - get message and set up booting flags; set_booted - set message flag that we've booted before;------------------------------------------------------------;------------------------------------------------------------; The data in the message is a word, formatted as follows:; bit 15	Set if already booted (don't do first time stuff); bit 14	Set if QuickLogoff desired; bit 13	Set if we got launched after logoff/logon; bits 12..0	<unused, should be clear>;; Bit	Bit; 15	13	Meaning; ---	---	-------;  0	 0	The OS was just booted for the first time.  Must;		do Logon (if we booted locally) and load startup files;		and DAs.  Set Bit 15.  Launch app given in ATINIT.;		STAY ON QUIT STACK.;;  0	 1	Invalid combination.;;  1	 0	User's application is quitting back to us.  If user;		does logoff/logon, set bit 13 and launch START from;		new volume.  DON'T STAY ON QUIT STACK.;;  1	 1	We just got launched because new user logged on.;		Launch application given in ATINIT.;		STAY ON QUIT STACK.;------------------------------------------------------------get_flags	proc		with	dp		stz	bootflag		stz	quickflag		stz	newvolflag				pea	getMessage		; want to get the message		pea	MyMsgType		; my message ID		pei	msghandle+2		pei	msghandle		_MessageCenter				lda	[msghandle]		; deref handle to message		sta	msgptr		ldy	#2		lda	[msghandle],y		sta	msgptr+2				ldy	#tMessage.data		bcc	@ok			; don't use defaults		lda	#$0000		sta	[msgptr],y@ok		lda	[msgptr],y		eor	#$8000			; default = booting		asl	a		ror	bootflag		asl	a		ror	quickflag		asl	a		ror	newvolflag				rts		endwith				; with dp		endpset_booted	proc		with	dp		jsr	get_flags		; make sure I've got quicklogoff flag				ldy	#tMessage.data		lda	[msgptr],y		; get message data		ora	#$8000			; set already booted flag		and	#$DFFF			; clear new boot vol flag		sta	[msgptr],y				pea	addMessage		; want to add new message		pea	MyMsgType		; my message ID		pei	msghandle+2		pei	msghandle		_MessageCenter		rts				endwith				; with dp		endpset_newvol	proc		with	dp		jsr	get_flags		; make sure I've got quicklogoff flag				ldy	#tMessage.data		lda	[msgptr],y		; get message data		ora	#$2000			; set new boot vol flag		sta	[msgptr],y				pea	addMessage		; want to add new message		pea	MyMsgType		; my message ID		pei	msghandle+2		pei	msghandle		_MessageCenter		rts				endwith				; with dp		endp;------------------------------------------------------------; Check_Mail; See if there is anything in the user's mail folder.  If; anything is found, put up a dialog.;------------------------------------------------------------check_mail	proc		with	dp		import	OpenParms:tOpen		import	CloseParms:tClose		import	GetDir:tGetDirEntry				import	(set_prefix,ErrorHandler):code		import	MailPath:code				jsr	set_prefix		; set prefix 9 to user's folder				stz	mailflag		; assume no mail				lda	#<MailPath		sta	OpenParms.path		; make sure path is for Mail		lda	#^MailPath		sta	OpenParms.path+2		_OpenGS	OpenParms		bcs	nomail		lda	OpenParms.refnum		sta	GetDir.refnum		; copy refnum for GetDirEntry		sta	CloseParms.refnum	; and for Close		stz	GetDir.base		; Base = Displacement = 0		stz	GetDir.disp				_GetDirEntryGS GetDir		bcs	nomail2				lda	GetDir.entry_num	; anything in the mail folder?		beq	nomail2			; no, so no mail present		dec	mailflag		; yes, mail was therenomail2		_CloseGS CloseParms		bit	mailflag		; was there mail?		bpl	nomail			; no, so no message				ldx	#1		jsr	ErrorHandler		; tell user that there is mailnomail		rts				endwith				; with dp		endp;------------------------------------------------------------; test_file; Does a GetFileInfo on a file to make sure it exists and is; a file (not a directory).  On entry, a pointer to the pathname; (a PString) is passed in A,X (A high, X low).;------------------------------------------------------------test_file	proc		import	GetFInfoParms				stx	GetFInfoParms	; set up pointer to path		sta	GetFInfoParms+2				jsl	$E100A8		; GS/OS entry		dc.w	$0006		; class 0 GetFileInfo		dc.l	GetFInfoParms				bcs	exit		; return if error				lda	GetFInfoParms+6	; get file type		cmp	#$000F		; directory?		beq	errexit				clc			; a file exists		bcc	exiterrexit		secexit		rts				endp;------------------------------------------------------------; Load_Files; Load setup and desk accessory files;------------------------------------------------------------load_files	proc		with	dp				import	GetDir:tGetDirEntry		import	OpenParms:tOpen		import	CloseParms:tClose		import	SetupPath:code		import	LoadPath:code		import	temp_name:code		import	set_prefix:code		import	ErrorHandler:code				jsr	set_prefix	; set prefix 9 to user's folder;------------------------------------------------------------; Start scanning the directory for Setups and DAs;------------------------------------------------------------		stz	GetDir.disp		; last entry was 0		stz	GetDir.refnum		; directory not open yet		stz	GetDir.base		; base = absolute		loop		inc	GetDir.disp		; go to next entry		jsr	open_setup		; open the directory		bcs	done			; any error, abort		_GetDirEntryGS GetDir		; get the entry		bcs	close			; any error, close and exit				lda	GetDir.aux_type		; is high bit of auxtype set?		bmi	loop			; yes, so skip this file				lda	GetDir.file_type	; what kind of file is it?				cmp	#NDA_type		; is it an NDA?		bne	not_NDA		jsr	Load_NDA		; Load the NDA		bra	loop			; go to next filenot_NDA		cmp	#CDA_type		bne	not_CDA		jsr	Load_CDA		bra	loopnot_CDA		cmp	#SETUP_type		bne	not_SETUP		jsr	Load_SETUP		bra	loopnot_SETUP		cmp	#TEMP_type		bne	not_TEMP		jsr	Load_TEMP		bra	loopnot_TEMP		bra	loop			; other type, do next fileclose		jsr	close_setupdone		rts		;------------------------------------------------------------; Open "9:Setup";------------------------------------------------------------open_setup		lda	GetDir.refnum		; is it already open?		bne	@ok			; yes, so we're ok		lda	#<SetupPath		sta	OpenParms.path		lda	#^SetupPath		sta	OpenParms.path+2				_OpenGS	OpenParms		bcs	@exit			; if error, skip scan		lda	OpenParms.refnum	; get file's refnum		sta	GetDir.refnum		; for use in GetDirEntry@ok		clc				; no error@exit		rts;------------------------------------------------------------; Close "9:Setup";------------------------------------------------------------close_setup		lda	GetDir.refnum		; get directory's refnum		sta	CloseParms.refnum	; and use it for closing		_CloseGS CloseParms		; do the close call		stz	GetDir.refnum		; mark it as closed		rts;------------------------------------------------------------; Load a CDA;------------------------------------------------------------Load_CDA		lda	#$5000			; DA's memory manager type		jsr	FetchFile		; load file into memory		bcs	@exit			; ignore errors		phy				; push handle of DA		phx		_InstallCDA			; install that puppy@exit		rts;------------------------------------------------------------; Load an NDA;------------------------------------------------------------Load_NDA		lda	#$5000			; DA's memory manager type		jsr	FetchFile		; load file into memory		bcs	@exit			; ignore errors		phy				; push handle of DA		phx		_InstallNDA			; install that puppy@exit		rts;------------------------------------------------------------; Load a permanent setup file;------------------------------------------------------------Load_SETUP		jsr	ExecFile		; load and run the setup		bcs	@exit			; abort if couldn't load		tya				; get "unload me" flag in A		lsr	a			; was bit 0 set?		bcc	@exit			; no, so don't unload		pha				; room for result		pei	LoadMemID		; push MM ID of file		pea	0		_UserShutDown		pla				; remove user ID@exit		rts;------------------------------------------------------------; Load a temporary setup file;------------------------------------------------------------Load_TEMP		jsr	ExecFile		; load and run setup		bcs	@exit			; abort if couldn't load		pha				; result space		pei	LoadMemID		; push MM ID file used		pea	0		_UserShutDown		pla				; remove user ID@exit		rts;------------------------------------------------------------; Do InitialLoad on file;------------------------------------------------------------FetchFile		pha				; save requested user ID;; Create the pathname SetupName":"temp_name to be used for the; initial load call.;		sep	#$20			; short A for chars		longa	off				ldy	#0@loop1		lda	SetupPath+2,y		sta	LoadPath+2,y		; copy byte of "9:Setup"		iny		cpy	SetupPath		; copied all of "9:Setup"?		bne	@loop1				lda	#':'			; colon to separate		sta	LoadPath+2,y		; put colon in path		iny				; bump path pointer				ldx	#0			; start of filename@loop2		lda	temp_name+4,x		; get filename byte		sta	LoadPath+2,y		; copy to path		iny		inx		cpx	temp_name+2		; copied all of filename?		bne	@loop2			; if more to go, loop				sty	LoadPath		; save length of combined path		rep	#$20			; back to full native		longa	on;; Have the loader load the file in for me;		pla				; recover user ID type		pha				; push 5 words of space		pha		pha		pha		pha		pha				; push user ID type (in A)		pea	LoadPath>>16		pea	LoadPath		pea	1			; no special memory		pea	1			; input type = class 1 path		_InitialLoad2		pla		sta	LoadMemID		; save loader's mem ID for file		plx		ply		stx	LoadAddr		; save load address		sty	LoadAddr+2		pla		sta	ZPStart			; save start of DP/Stack segment		pla		sta	ZPSize			; save size of DP/Stack segment		bcc	@ok			; continue if no error		ldx	#4			; can't load a file		jsr	ErrorHandler		sec		bcs	@exit@ok		pha		pha				; room for handle		phy				; push load address		phx		_FindHandle		plx		ply		stx	LoadHandle		; save handle of file		sty	LoadHandle+2@exit		rts;------------------------------------------------------------; Execute a permanent or temporary setup file.;; A word of zero is pushed just before the JSL.  This word; can be modified by the setup file.  After the JSL, this; word is returned in Y.;------------------------------------------------------------ExecFile		jsr	close_setup		; directory must be closed		lda	#$A000			; MM type for setups		jsr	FetchFile		; try to load it		bcs	@exit			; abort if error		jsr	save_zp			; save off my direct page		lda	LoadAddr		; get load address		sta	TheJML+1		; modify jump address		lda	LoadAddr+2		sta	TheJML+3		phd				; save direct page register		tsx				; save stack pointer in X		lda	ZPStart			; any DP/Stack?		beq	@def			; no, use defaults		tcd				; set up new DP		clc		adc	ZPSize			; get end of segment		dea				; minus 1 byte is last byte		tcs				; set new stack pointer@def		phx				; save old stack pointer		phb				; save bank		lda	LoadMemID		; pass user ID in A		ldx	#0			; X = Y = 0		txy		phy				; push "unload me" word of zeroes		jsl	TheJML			; call the setup		ply				; recover "unload me" flag		plb				; restore bank		plx				; restore stack		txs		pld				; restore D		jsr	rest_zp			; Note: Y not modified!!!		clc				; no error@exit		rtsTheJML		jml	0			; used to jump to setups		dc.b	0			; extra byte overwritten;------------------------------------------------------------; Save off direct page variables;------------------------------------------------------------save_zp		ldx	#savesize@loop		lda	0,x		sta	zp_store,x		dex		dex		bpl	@loop		rts;------------------------------------------------------------; Restore direct page variables.; NOTE: Y must NOT be modified by this routine!!!;------------------------------------------------------------rest_zp		ldx	#savesize@loop		lda	zp_store,x		sta	0,x		dex		dex		bpl	@loop		rts		zp_store		ds	savesize+2		endwith		endp		;------------------------------------------------------------; Set_Prefix; Set prefix 9 to user's folder;------------------------------------------------------------set_prefix	proc		jsl	$E100A8		; GS/OS call		dc.w	$2033		; class 1 FST_Specific		dc.l	SpecParms	; pointer to parameter list				lda	SpecPathPtr	; copy path pointer to SetPrefix		sta	spPath		lda	SpecPathPtr+2		sta	spPath+2				_SetPrefixGS spParms	; prefix 9 = ":vol:Users:user"		rtsSpecParms		dc.w	3		; pcount = 3		dc.w	$000D		; FST ID		dc.w	8		; command = get_user_pathSpecPathPtr	dc.l	0		; returned path pointerspParms		dc.w	2		dc.w	9		; set prefix 9spPath		dc.l	SpecPathPtr	; path to set		endp		;------------------------------------------------------------; Launch_app; Launch user's startup application.  This routine only; returns on a fatal error.;------------------------------------------------------------launch_app	proc		with	dp		import	OpenParms:tOpen		import	CloseParms:tClose		import	ReadParms:tRead		import	SMarkParms:tSetMark		import	ConfigInfo:tATINIT		import	PMSetPrinter:data				import	ErrorHandler:code		import	ATInitPath:code		import	(SetPfxParms,LaunchParms):code		;------------------------------------------------------------; Open user's ATINIT file to see which app to launch;------------------------------------------------------------		jsr	set_prefix		; set prefix 9 to user's folder				lda	#<ATInitPath		sta	OpenParms.path		; make sure we open ATINIT		lda	#^ATInitPath		sta	OpenParms.path+2		_OpenGS	OpenParms		bcc	@opened		ldx	#2			; 2 = bad ATINIT		jsr	ErrorHandler		rts@opened		lda	OpenParms.refnum	; get file's refnum		sta	SMarkParms.refnum	; for use in SetMark		sta	ReadParms.refnum	; and Read		sta	CloseParms.refnum	; and Close				lda	#1		sta	SMarkParms.base		lda	#tATINIT.size		; size of ATINIT file		sta	SMarkParms.disp				_SetMarkGS SMarkParms		; set Mark relative to EOF		bcc	@markset		ldx	#2		jsr	ErrorHandler		bra	launch_close@markset				lda	#tATINIT.size		sta	ReadParms.req_cnt		lda	#<ConfigInfo		sta	ReadParms.buf_addr		lda	#^ConfigInfo		sta	ReadParms.buf_addr+2				_ReadGS	ReadParms		; read ATINIT to buffer		bcc	@read		ldx	#2		jsr	ErrorHandler		bra	launch_close@read;; Should really check to see that we got as much as we asked for;		_CloseGS CloseParms		;; Set this user's default printer;		sep	#$20			; 8-bit A to copy byte		longa	off		lda	ConfigInfo.PFlags	; get printer flags from ATINIT		and	#$FE			; clear the "return printer" bit		sta	PMSetPrinter+8		; copy into PMSetPrinter parms		rep	#$20			; back to full native		longa	on		ldx	#<PMSetPrinter		; point to parameter list		ldy	#^PMSetPrinter		jsl	$E11014			; make the AppleTalk call;; Set the default prefix;		_Set_Prefix SetPfxParms		; Set prefix on launch				pei	myuserid		_MMShutDown			; shut down MM before I quit		ldx	#<ConfigInfo.Path		lda	#^ConfigInfo.Path		jsr	test_file		; see if file exists		bcs	launch_err		; no, so put up an error alert		_Quit	LaunchParms		; quit to startup applicationlaunch_err		ldx	#2			; 2 = bad configuration		jsr	ErrorHandler		rtslaunch_close		_CloseGS CloseParms		rts		endwith				; with dp		endplaunch_start	proc	export		import	(ToSTARTParms,STARTPath,ErrorHandler):code				jsr	set_newvol		; going to launch from new volume				pei	dp.myuserid		_MMShutDown			; shut down MM before I quit				ldx	#<STARTPath		lda	#^STARTPath		jsr	test_file		; see if it exists		bcs	err				_Quit	ToSTARTParms		; launch *:System:STARTerr		ldx	#6			; 6 = couldn't launch *:System:START		jsr	ErrorHandler		rts				endp		MailPath	proc		dc.w	End-StartStart		dc.b	'9:Mail'End		endpATInitPath	proc		dc.w	End-StartStart		dc.b	'9:Setup:ATINIT'End		endp		SetupPath	proc		dc.w	End-StartStart		dc.b	'9:Setup'End		endp		SysResPath	proc		dc.w	End-StartStart		dc.b	'*:System:System.Setup:Sys.Resources'End		endpSTARTPath	proc		dc.b	End-StartStart		dc.b	'*:System:START'End		endp		ConfigInfo	ds	tATINITSetPfxParms	proc		dc.w	0			; prefix #0		dc.l	ConfigInfo.prefix	; prefix to set		endp		LaunchParms	proc		dc.l	ConfigInfo.Path		; app to launch		dc.w	$C000			; restartable, stack me		endpToSTARTParms	proc		dc.l	STARTPath		; app to launch		dc.w	$4000			; restartable, don't stack me		endpGSMess3		proc		dc.b	End-StartStart		dc.b	CR		dc.b	'  AppleShare has not been installed or not enabled.',CR		dc.b	'  Please enable AppleTalk through the Control Panel',CR		dc.b	'  and install AppleShare.  Press Return to reboot.',CREnd		endpGSMess4		proc		dc.b	End-StartStart		dc.b	CR		dc.b	'  An error occurred while loading the file:',CREnd		endpGSMess5		proc		dc.b	End-StartStart		dc.b	CR		dc.b	'  Starting AppleShare Startup',CREnd		endpGSMess6		proc		dc.b	End-StartStart		dc.b	CR		dc.b	'  The AppleShare Startup program could not be run.',CR		dc.b	'  Please make sure the server has been properly set',CR		dc.b	'  up for Apple IIGS network startup.',CREnd		endpErrorHandler	proc		import	temp_name:code				ldy	#$80		; signal alert onlyErrorHandler2		txa		asl	a		tax		lda	GSMessTbl,x		sta	MessPtr		lda	FilProcTbl,x		sta	FilterProc		sep	#$30		longa	off		longi	off		sty	MessOpt		Message	MessParms		rep	#$30		longa	on		longi	on		and	#$FF		; mask off key pressed		rtsGSMessTbl		dc.w	Mess0		; 0 = unknown error		dc.w	Mess20		; 1 = you have mail		dc.w	Mess15		; 2 = bad startup configuration		dc.w	GSMess3		; 3 = AppleTalk not present		dc.w	GSMess4		; 4 = Can't load file:		dc.w	GSMess5		; 5 = Starting...		dc.w	GSMess6		; 6 = Couldn't launch *:System:STARTFilProcTbl		dc.w	0		; 0 = unknown error		dc.w	0		; 1 = you have mail		dc.w	0		; 2 = bad startup configuration		dc.w	0		; 3 = AppleTalk not present		dc.w	LoadPathProc	; 4 = Can't load file:		dc.w	0		; 5 = Starting...		dc.w	0		; 6 = Couldn't launch *:System:STARTLoadPathProc		longa	off		longi	off		GetXY		ldx	#2		lda	#CD_GotoXY		jsr	ConsDrvr		lda	temp_name+3	; turn G-String into P-String		pha		lda	temp_name+2		sta	temp_name+3		ldx	#temp_name+3		ldy	#>temp_name+3		WritePointer		pla		sta	temp_name+3	; restore G-String		rts		longa	on		longi	on		endpTitle		proc		dc.b	'  ',MTON,'A',MTOFF		dc.b	' AppleShare Startup V1.0.2 '		dc.b	Inv,CLEOL,Norm,CR,$00				endpMenuPrompt	proc		dc.b	CPOS,1,19	; GOTOXY(1,19)		dc.b	'Select:',MTON,'K J',MTOFF		dc.b	CPOS,40,19		dc.b	'Accept:',MTON,'M',MTOFF		dc.b	0				endpLogoffStr	str	'Log off from file servers'RunStr		str	'Return to startup application'BootStr		str	'Shut Down'MenuList	proc		dc.w	LogoffStr	; "Log off..."		dc.w	RunStr		; "Re-Run ..."		dc.w	BootStr		; "Shutdown"		endp		MessRect	proc		DC.B	10	;x1		DC.B	9	;y1		DC.B	70	;x2		DC.B	15	;y2		endp		moment_str	proc		dc.b	CR,CR,'  One moment please...',$00		endptemp_name	proc		dc.w	35		ds.b	33		endpLoadPath	proc		ds.b	40		; room for <len>9:Setup:<31chars>		endp		InfoParms	proc		dc.w	8		dc.w	0		; device #		dc.l	temp_name		dc.w	0		; characteristics		dc.l	0		; total blocks		dc.w	0		; slot		dc.w	0		; unit		dc.w	0		; version		dc.w	0		; device type		endpEjectParms	proc		dc.w	5		dc.w	0		; device #		dc.w	2		; eject code		dc.l	EjectParms	; pointer to control list (unused)		dc.l	0		; request count		dc.l	0		; transfer count		endpOpenParms	proc		dc.w	6		; up through filetype		dc.w	0		; refnum		dc.l	0		; pathname pointer		dc.w	1		; request access = read only		dc.w	0		; resource number		dc.w	0		; returned: access word		dc.w	0		; returned: filetype		endpGetDir		proc		dc.w	13		; through auxtype		dc.w	0		; refnum		dc.w	0		; flags		dc.w	0		; base		dc.w	0		; displacement		dc.l	temp_name	; pointer to name		dc.w	0		; entry number		dc.w	0		; filetype		dc.l	0		; EOF		dc.l	0		; blocks used		dc.l	0,0		; create date/time		dc.l	0,0		; mod date/time		dc.w	0		; access		dc.l	0		; auxtype		endpCloseParms	proc		dc.w	1		dc.w	0		; refnum		endpReadParms	proc		dc.w	5		dc.w	0		; refnum		dc.l	0		; data buffer		dc.l	0		; request count		dc.l	0		; transfer count		dc.w	0		; do not cache blocks		endpSMarkParms	proc		dc.w	3		dc.w	0		; refnum		dc.w	0		; base		dc.l	0		; displacement		endpFSTInfoParms	proc		dc.w	2		dc.w	0		; fst_num		dc.w	0		; file_sys_id		endpGetLevelParms	proc		dc.w	2		dc.w	0		; level		dc.w	0		; user/system flag		endpSetLevelParms	proc		dc.w	2		dc.w	0		; level 0 (lowest)		dc.w	0		; set system level		endpSetStarParms	proc		dc.w	2		dc.w	$000D		; AppleShare FST ID		dc.w	$4D44		; set boot prefix command		dc.w	0		; GS/OS direct page address		endpGetFInfoParms	record		dc.l	0		; pathname pointer goes here		dc.w	0		; access		dc.w	0		; filetype		dc.l	0		; auxtype		dc.w	0		; storage type		dc.l	0		; create date/time		dc.l	0		; mod date/time		dc.l	0		; blocks used		endrPMSetPrinter	record		dc.b	0,$28		; sync. PMSetPrinter		dc.w	0		; result		dc.l	ConfigInfo.PEntity		dc.b	0		; printer flags		dc.w	2		; flush after 1/2 second		dc.w	30*4		; timeout at 30 seconds		dc.w	20		; 20 buffers		endr				end