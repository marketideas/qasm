*opennet* this file moves all new code that is going into bank* $e0 language card area.  It checks for a card and calls init.* After init it calls the start vectors for any protocols that* have been added, like PAP, RPM, ZIP, and any patches.*           by*           Greg Seitz*           15-Apr-86** Copyright Apple Computer, Inc.  1986* All Rights Reserved* Version 1.2** 24-Sept-86 (RBH)* Changed interrupt vector for the ParaMIS card for the umpteenth time* it is now CN19** 30-Sept-86 (RBH)* Turn on interrupts for the Apple //** 12-May-87 (rbh)* -added the network call to set the user name.** 30-Jun-87 (rbh)* Converted source code to MactoGS assembler* removed support for ProDOS 16 and the Apple //GS** 2-July-87 (rbh)* Added the console driver so that a dialog box could be drawn on the screen* and user could enter name if set to null.** 21-July-87 (rbh)* Added support so that Atinit can be used with the server firmware.** 28-Sept-87 (rbh)* Fixed bug where workstation disk was locked causing ProDOS to crash.** 1-Dec-87 (rbh)* Added routines to display message when not run on an enhanced //e** 1-Dec-87 (rbh)* Derivation of names and NoNamers are no longer stored on the* workstation card.** 7-Jun-91 (msd)* Converted source to MPW IIGS.  Fixed the bug where the PMSetPrinter* setting the default printer doesn't get the printer flag byte from* the end of the ATINIT file like it should.  Changed to version 1.4.** 6-Aug-91 (MSD)* The loop that finds the card's slot was stopping once it found the* 'ATLK' ID bytes; if the machine ID was something it didn't know about* (like 0 for the GS's built-in LocalTalk), it just returned.  It now* will resume scanning the other slots.** 18-Jun-92 (MSD)* The data section (user name, printer name, etc.) was in the middle of the file,* not at the end of the file like it's supposed to be.  Removed the data section* which is now in the file ATInit.data.aii.** 29-Jun-92 (MSD)  Version 1.4d3* If the machine (hardware) ID is $F0, then the card is still doing its diagnostics.* It used to put up the BadCard message.  It now loops back to test the ID byte.* If the card somehow hung in diagnostics, the LED _should_ be RED (but this code* will be in an infinite loop).*		include	'::Console:Console.Equates'   		include '::Console:cons.macros'		longa 	off 		longi	off  		machine	m65C02		import	ConsDrvr				import	username,prflag,prname	; from atinit.data.aii		CheckMach	equ	$fe1f			;Monitor Routine to check machine typemli		equ	$bf00bootkind	equ	$e100bdcardptr		equ	$feStgPtr		equ	$faStgPtr2		equ	$fcWindowBuff	equ	$8000			;WindowBuff[512]CrHB		equ   	$8dIOBuff		equ	$9600checkabort	proc	exportRomIn		equ	$c082RomID		equ	$fbc0			;ID byte for the //e Rom RevSetVid		equ	$fe93SetKbd		equ	$fe89Home		equ	$fc58ch		equ	$24kbdstrb		equ	$c010kbd		equ	$c000 COUT		equ 	$FDEDVTABA		equ	$FB5BMachID		equ	$bf98Clr80Vid	equ	$c00cSetAltChar	equ	$c00fClr80Col	equ	$c000Speaker		equ	$c030NameOffset	equ	133Open		equ	$c8Write		equ	$cbSetMark		equ	$ceClose		equ	$ccGetEof		equ	$d1SetPrefix	equ	$c6Flush		equ	$cdGetPrefix	equ	$c7Null		equ	0NameLen		equ	31		stz	ServerFlag		lda	$c061			;get open apple button		bmi	NoUpLoad		jsr	Check2e			;check to see if the 2e is enhanced		bcc	A2eOKNoUpLoad		clc		rts				;otherwise just returnA2eOK		lda	#$f9		sta	cardptr		lda	#$c7		sta	cardptr+1NxtSlot		ldy	#3ckloop		lda	(cardptr),y		cmp	idtbl,y		bne	NoMatch		dey		bpl	ckloopCheckMachID		ldy	#4		lda	(cardptr),y		; get hardware type byte	   		cmp	#1			; workstation		beq	Doit		cmp	#2			; server		bne	Ck2		lda	#$80		sta	ServerFlag		bra	DoitCk2		cmp	#$f0			; still doing diagnostics		beq	CheckMachID		; yes, so keep looking at it		cmp	#$ff			; failed diagnostics		beq	BadCard		bne	NoMatch			; 6-Aug-91 MSD: unknown ID, try other slotsCkOut		rtsBadCard		InitConsole		CursorOff		ldy	#$80			;Alert message		ldx	#0			;The card failed powerup diagnostics		jsr	ErrorHandler		;Tell the user		jmp	alldone			;and leave without initalizationNoMatch		dec	cardptr+1		lda	cardptr+1		cmp	#$c0			;are we finished scanning the slots?		bne	NxtSlot		jmp	alldoneDoit		lda	mli+1		sta	ProEntPt		;setup the ProDos Entry Point		lda	mli+2		sta	ProEntPt+1		lda	#$14					sta	CardVect		bit	ServerFlag		bmi	NotWk1			;not a workstation card so don't set up mli.		sta	mli+1NotWk1		lda	CardPtr+1		sta	CardVect+1		sta	aiparms+3		bit	ServerFlag		bmi	NotWk2			;not a workstation card so don't set up mli.		sta	mli+2		NotWk2		jsr	GoCard		dc.b	$42		dc.w	initparms		jsr	mli		dc.b	$40		dc.w	aiparms		cli				;turn on interrupts for Apple //e		jsr	GoProDOS		dc.b	GetPrefix		dc.w	PrefixParm		jsr	GoCard		dc.b	SetPrefix		dc.w	PrefixParm*setprinter; --> Begin 7-Jun-91 MSD; When setting the default printer, we must use the printer flags; stored at the end of ATINIT, not assume it was a LaserWriter.		lda	prflag			; Get printer type from ATINIT data		sta	theflag			; use it to set the printer type; <-- End 7-Jun-91 MSD		jsr	GoCard		dc.b	$42		dc.w	setprint		InitConsole		CursorOff		lda	UserName		beq	GetNameDoSetName		jmp	RegisterNameGetName		jsr	DrawBox		WriteCStr Prompt1		GotoXY	50,0		WriteCStr Version		WriteCStr EnterName		Input	MyParms		jsr	RestoreBox		lda	UserName		beq	DS2		jsr	UpdateName		bra	DoSetNameDS2		lda	#UserName		sta	StgPtr		lda	#>UserName		sta	StgPtr+1		lda	#NoUser		ldx	#>NoUser		ldy	#0		jsr	MovStrRegisterName		lda	#RegName		sta	StgPtr		lda	#>RegName		sta	StgPtr+1		lda	#UserName		ldx	#>UserName		ldy	#9		jsr	MovStrDoType		sec		jsr	CheckMach		bcs	TwoE		ldy	Ytemp		lda	#GSType		ldx	#>GSType		jsr	MovStr		bra	DoRegNameTwoE		ldy	Ytemp		lda	#TwoEType		ldx	#>TwoEType		jsr	MovStrDoRegName		ldy	Ytemp		lda	#ZoneName		ldx	#>ZoneName		jsr	MovStr		jsr	DrawBox		GotoXY	50,0		WriteCStr Version		WriteCStr RegNameStr1		ldx	#UserName		ldy	#>UserName		WritePointer		WriteCStr RegNameStr2		jsr	GoCard		dc.b	$42		dc.w	RegstrName		php		jsr	RestoreBox		plp		bcc	alldone		jsr	DeriveName		bcs	alldone		jmp	RegisterNamealldone 		lda 	RomIn			 		jsr 	SetVid			 		jsr	SetKbd			 		sta 	Clr80Vid		 		sta	SetAltChar		 		sta	Clr80Col 		clc		rtserror		lda	initparms+2		;get error code		sec		rtsDeriveName		stz	NoNameFlag		ldx	UserName		lda	UserName,x		cmp	#'>'		bne	DN1		lda	#$80		sta	NoNameFlagDN1		lda	DeriveCnt		bne	DN2		jsr	AddOne		bra	DN3DN2		cmp	#9		bne	DN3		jsr	AddOneDN3		cmp	#99		bne	DN4		sec				;99 times, give it up!		rtsDN4		ldx	UserName		;get the Length of the string		bit	NoNameFlag		bpl	DN5		dexDN5		inc	UserName,x		lda	UserName,x		cmp	#$3A			;is it an Ascii '0'?		bne	DNDun		lda	#$30		sta	UserName,x		dex		inc	UserName,xDNDun		inc	DeriveCnt		clc		rtsAddOne		pha		cmp	#9		bne	AO2		lda	UserName		cmp	#NameLen		beq	AO1		inc	a		inc	UserNameAO1		tax		bit	NoNameFlag		bpl	AO4		dexAO4		lda	#$2f		sta	UserName,x		dex		lda	#$31		sta	UserName,x		bra	AODunAO2		lda	UserName		cmp	#NameLen		beq	AO3		inc	a		inc	UserNameAO3		tax		bit	NoNameFlag		bpl	AO6		dexAO6		lda	#$30		sta	UserName,xAODun		bit	NoNameFlag		bpl	AO5		lda	#'>'		ldx	UserName		sta	UserName,xAO5		pla		rts	UpdateName		jsr	mli		dc.b	Open		dc.w	OpenParm		bcc	UN1		rtsUN1		lda	OpenParm+5		;get the reference Number		sta	WriteParm+1		sta	GetEofParm+1		sta	SetMarkParm+1		sta	FlushParm+1		sta	CloseParm+1		jsr	mli		dc.b	GetEof		dc.w	GetEofParm		bcs	UN4		sec		lda	GetEofParm+2		sbc	#NameOffset		sta	PrName		sta	SetMarkParm+2		lda	GetEofParm+3		sbc	#>NameOffset		sta	SetMarkParm+3		lda	GetEofParm+4		sbc	#0		sta	SetMarkParm+4UN3		jsr	mli		dc.b	SetMark		dc.w	SetMarkParm		bcs	UN4		jsr	mli			;all is still well, write the name out to the ATINIT file		dc.b	Write		;		dc.w	WriteParm		;		bcs	UN8		jsr	mli			;this is a special fix for the UniDisk 3.5		dc.b	Flush		;which does not know when it writes to a file		dc.w	FlushParm		;that the disk is write protected		bcc	UN4			;UN8		cmp	#$2F			;is the device online?		beq	UN2			;no it isnt		cmp	#$2b			;any error but write protect (2b) is undefined		bne	UN4			;UN2		ldy	#$80			;alert -> Please write enable this volume:		ldx	#1		jsr	ErrorHandler		bra	UN3UN4		jsr	mli		dc.b	Close		dc.w	CloseParm		rts		Check2e		sec				;check to see if the machine is a //gs		jsr	CheckMach		;		bcc	IIeGood			;if so, we are done		lda	#0			;load the accumulator		inc	a			;this is a 65C02 instruction		beq	NoGood2e		;if zero, this is a 6502		lda	MachID			;get the ProDOS MachID		and	#$F2			;clear the unwanted bits		cmp	#%10110010		;this should be the result 128K, 80 Col		bne	NoGood2e		lda	RomID			;check for enhanced roms		cmp	#$E1			;check for debugger roms		beq	IIeGood		cmp	#$E0			;is the byte E0?		bne	NoGood2e		;Off we go to display the messageIIeGood		clc				;clear the carry flag		rts				;we have passed the testNoGood2e		jsr	Home			;clear the screen		jsr	DrawInvBox		;draw a box for display	        ldy   	#7         	ldx   	#5         	jsr   	gopos         		;set the cursor position         	lda   	#qmsg1         	ldx   	#>qmsg1         	ldy   	qmsg1len         	jsr   	printblk 		;print the message		ldy	#9		ldx	#5		jsr	GoPos         	lda   	#qmsg2         	ldx   	#>qmsg2ge1         	ldy   	qmsg2len         	jsr   	printblk 	;print the message		jsr	Dobellnopass		jmp	nopassPrintBlk        	sta    	stgptr       	;SET UP ZERO PAGE        	STX    	StgPtr+1     	;        	sty    	BlockLen        ;SAVE THE NUMBER OF CHARACTERS TO PRINT        	ldy    	#0              ;START WITH CHARACTER #1PLOOP   	lda    	(StgPtr),Y     	;GET THE CHARACTER        	ORA    	#$80            ;SET THE HIGH BIT         	jsr    	cout            ;OUTPUT TO SCREEN        	iny                   	;INCREMENT Y REGISTER        	cpy    	BlockLen       	;CHECK TO SEE IF WERE AT THE END OF BLK        	bne    	PLoop           ;IF NOT CONTINUE        	inc    	ch          	;add one to ch, not sure why??        	rts                  	;IF SO, WE ARE DONEgopos         	dey                 	;Setup the Y screen coordinates from 1-24, not the         	tya                 	;monitior 0-23.         	jsr   	VTABA          	;set the vertical position         	dex                 	;Setup the X screen coordinates from 1-80, not the         	stx   	ch            	;set the horizontal position.         	rts                 	;and returnDobell         	LDA   	#$40                     ;DURATION         	STA   	B_LNGTH                  BELL_1   	LDA   	#$02                     ;SHORT DELAY         	JSR   	B_WAIT                            	STA   	Speaker                              	LDA   	#$24                     ;LONG DELAY         	JSR   	B_WAIT                            	STA   	Speaker                              	DEC   	B_LNGTH                           	BNE   	BELL_1                            	RTS		DrawInvBox		lda	#10		sta	DrawCnt		ldy	#5		sty	Ypos		ldx	#2		jsr	GoPos		ldx	#37DrawLup1	lda	#$20			;an inverse space character		jsr	cout		dex		bne	DrawLup1Frame		inc	Ypos		ldy	Ypos		ldx	#2		jsr	GoPos		lda	#$20		jsr	Cout		ldy	Ypos		ldx	#38		jsr	GoPos		lda	#$20		jsr	Cout		dec	DrawCnt			;until the count equals zero		bne	Frame		ldy	YPos		ldx	#2		jsr	GoPos		ldx	#36DrawLup2	lda	#$20			;an inverse space character		jsr	cout		dex		bne	DrawLup2		rts;; WAIT ROUTINE;B_WAIT   	SEC                            B_WAIT2  	PHA                            B_WAIT3  	SBC   	#1                                	BNE   	B_WAIT3                           	PLA                                     	SBC   	#1                                	BNE   	B_WAIT2                           	RTS                            ;B_LNGTH  	ds.b	1****************************************** MovStr moves a Pascal type string to 	** the buffer pointed to by StgPtr. 	** 					** The string to be moved is passed with ** the A register containing the low	** byte of the pointer and the X		** register contains the high byte.	** The Y register is the Offset.		******************************************MovStr		sta	StgPtr2		stx	StgPtr2+1		sty	YTemp		ldy	#0		lda	(StgPtr2),y		tax					;number of characters to transfer		ldy	YTemp				;get the offset		sta	(StgPtr),y			;store the length byte		inc	YTemp				;increment the temporary counter		inc	StgPtr2				;increment the 		bne	MStr1		inc	StgPtr2+1MStr1		ldy	#0MStr2		phy		lda	(StgPtr2),y		ldy	YTemp		sta	(StgPtr),y		inc	YTemp		ply		iny		dex		bne	MStr2		rtsErrorHandler		cpy	#0			;if minus flag clear then this is an alert		bmi	IsAlert			;you can only accept!		ldy	#0			;if minus flag clear then this is a dialog IsAlert						;with two possible paths.		txa		asl	a		tax		lda	MessTbl,x		;get the low byte of pointer to the String		sta	MessPtr			;into the Y register for a second		lda	FilProcTbl,x		sta	FilterProc		inx				;increment the pointer		lda	MessTbl,x		;get the high byte of pointer to the String			sta	MessPtr+1		;		lda	FilProcTbl,x		sta	FilterProc+1		sty	MessOptGoMessage	Message	MessParms		rtsPrefixProc		GetXY		ldx	#2		lda	#CD_GotoXY		jsr	ConsDrvr		ldx	PrefixParm+1		ldy	PrefixParm+2		WritePointer		rtsDrawBox		lda	#%01000000		sta	MessOpt		Message	MessParms		rts		RestoreBox		lda	#%00100000		sta	MessOpt		Message	MessParms		rtsGoCard		jmp	(CardVect)GoProDOS	jmp	(ProEntPt)InitParm 	dc.b	$80MessParmsMessOpt		ds.b	1MessPtr		ds.b	2FilterProc	dc.w	0Rect		dc.b	10        	;x1         	dc.b	9       	;y1		dc.b	70       	;x2         	dc.b	15       	;y2WindBuff	dc.w	WindowBuffMessTbl		dc.w	Mess0		dc.w	Mess1FilProcTbl	dc.w	Null		dc.w	PrefixProcMess0		dc.b	(Mess0End-Mess0)-1		dc.b	Return		dc.b	'  The workstation card failed power up diagnostics.'	;Here 		dc.b	Return		dc.b	Return		dc.b	'  AppleTalk has not been initalized.'Mess0EndMess1		dc.b	(Mess1End-Mess1)-1		dc.b	Return		dc.b	'  Please write enable this volume:'		dc.b	ReturnMess1EndBlockLen	ds.b	1DrawCnt		ds.b	1YPos		ds.b	1Version		dc.b	'V1.4d3'		dc.b	$00RegNameStr1	dc.b	CPOS		dc.b	3		dc.b	1		dc.b	'Registering "'		dc.b	$00EnterName	dc.b	CPOS		dc.b	3		dc.b	1		dc.b	'Please Enter a User Name:'		dc.b	CPOS		dc.b	3		dc.b	3		dc.b	$00RegNameStr2	dc.b	'"'		dc.b	CPOS		dc.b	3		dc.b	3		dc.b	'on the AppleTalk Network...'		dc.b	$00Prompt1		dc.b	CPOS		dc.b	1		dc.b	5		dc.b	'Esc: Cancel'		dc.b	CPOS		dc.b	54		dc.b	5		dc.b	'OK: '		dc.b	MTON		dc.b	'M'		dc.b	MTOFF		dc.b	$00MyParmsOptionByte	dc.b	$00			;option ByteMyLen		dc.b	NameLen		;maximum input lengthInBuff      	dc.w	UserName		;Buffer for input/output       		dc.w	MyTermList		;Termination Characters		MyTermList 		dc.b	$02		dc.b	Escape 		dc.b	CrHB    		;2 characters Esc and Returninitparms	dc.b	0,1			; sync Init		dc.w	0		dc.b	$40ProEntPt	dc.l	0		;past junk		dc.b	$00			;pick a node, any node		dc.w	0aiparms		dc.b	2		dc.b	0		dc.w	$C719		; interrupt entry in firmwaresetprint		dc.b	0,$28		dc.w	0		dc.l	prname		; printer's entity nametheflag		dc.b	$a0			;bit5 = ImageWriter Emulation		dc.w	2			;Flush Buffer Timmer		dc.w	30*4		;Session Timeout		dc.w	20			;number of buffers for RPM		OpenSkt		dc.b	$00		dc.b	$0b		dc.w	0SocketNum	ds.b	1		dc.l	$800		RegstrName	dc.b	$00		dc.b	$0e		dc.w	0		dc.l	0		dc.l	RegName		dc.b	$04		dc.b	$04		dc.w	0RegSocket	dc.b	$04		dc.b	$00		GetEofParm	dc.b	$02		ds.b	1		ds.b	3PrefixParm	dc.b	$01		dc.w	PrefixBuff		OpenParm		dc.b	3		dc.w	FName		dc.w	IOBuff		dc.b	1		CloseParm		dc.b	1		dc.b	0WriteParm		dc.b	$04		ds.b	1		dc.w	UserName		dc.w	33				;write request count		ds.b	2		SetMarkParm	dc.b	$02		ds.b	1		ds.b	3FlushParm	dc.b	$01			;Parameter count		ds.b	1			;file reference number		idtbl		dc.b	'ATLK'Ytemp		ds.b	1TwoEtype	str	'Apple IIe'GStype		str	'Apple IIgs'NoUser		str	'<Untitled>'		ds.b	2FName		str	'ATINIT'zonename	str	'*'RegName		ds.b	64PrefixBuff	ds.b	64ServerFlag	ds.b	1CardVect	ds.b	2DeriveCnt	dc.b	$00NoNameFlag	ds.b	1qMSG1LEN 	str     'APPLETALK REQUIRES AN ENHANCED 'qmsg2len 	str     '128K APPLE IIE SYSTEM.'qmsg1		equ	qMsg1Len+1qmsg2		equ	qMsg2Len+1		endp		end