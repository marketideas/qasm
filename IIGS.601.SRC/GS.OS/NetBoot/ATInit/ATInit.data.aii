****************************************** This area is the Data structure area	** for Networking applications to modify	** the User name and Printer.  Nothing 	** can be changed in this area that 	** would change the number of bytes.	******************************************atinitdata	PROC		export	username,prflag,prname		username 	dc.b	$00		; No user name (so user will be asked first time)	 	ds.b	32		; room for rest of name		prflag		DC.B $a0		;Printer flag.prname					;Default printer name goes here.		ds.b	99		; always reserve 99 bytes for printer name		ENDP		end		