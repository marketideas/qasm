## Build## This script will build the Apple II Setup disk for GS/OS# System Software version 6.0.## Written by Mark Day.## This script assumes that the files "ProDOS16 Boot Blocks",# "ProDOS16 Image", "Apple //e Boot Blocks", "P8", and "Basic.System"# are present in the folder called "Work".## This script will build to a Macintosh "System Tools" version 6.0.7# or "Apple II Setup" disk, and create the complete installer disk.### 16-Jun-91 MSD		V2.2d5.	Updated versions for P8 and BASIC.System.# 26-Aug-91 MSD		v2.2d11	Changed P8 version to 1.5.# 28-Oct-91 MSD		v2.2d19 Defined releasedate for installer script to#					be {todayhex}.  Changed installer script creator/type#					from 'cfbj' to 'bjbc'.#  7-Feb-92 MSD		Changed version number to 2.2 final.  Changed copyright#					dates in 'vers' resources to include 1992.# 14-Feb-92 MSD		Hard-coded the variable "todayhex".#					Forced "today" to be 2/14/92 12:00:00 PM.#  2-Mar-92 MSD		Forced "today" to be 3/2/92 12:00:00 PM.  Changed#					"todayhex" to match.#  1-Apr-92 MSD		Version 3.0d1.  "today" and "todayhex" now set automatically.## 15-Jul-92 MSD		Version 3.0d4.  This is the version that will be seeded with#					DoRight (Apple II Ethernet Card).# 12-Aug-92 MSD		Version 3.0d5.  Includes Logon 1.5d1 and ETalk driver that#					first implemented RamGoComp (but not tested).# 22-Aug-92 MSD		Version 3.0d7.  Includes the changes to Fizzy to store the#					slot number at ATSlotNumber ($E101C1).  Requires Boot.Driver#					from System Disk 6.0.1d10.# 25-Nov-92 DAL		Version 3.0d8.  Added analyzer trigger to Logon.Main on an#					unknown error.# 27-Jan-93 DAL		Version 3.0d13.  Removed 5-second '...' delay for Ethernet#					case, in Boot.aii.#  8-Feb-93 DAL		Changed copyrights to end with 1993.#  9-Mar-93 DAL		Version 3.0d14.# 17-Mar-93 DAL		Version 3.0d15.#  2-Apr-93 DAL		Version 3.0.### Make sure we exit if an error happens#set exit 1set thisvers	3.0				; export thisversset todayhex	"`date -n`"set today		"`date -s -c {todayhex}`"set todayhex	"`evaluate -h {todayhex}`"set	a2s			"Apple II Setup:"set	inst		":installer:"set work		":work:"## First, make sure a "System Tools:" or "Apple II Setup:"# disk is online (and give user a chance to insert it).#Loop	Break If "`Exists -d "{a2s}"`"	Confirm "Please insert ¶"{a2s}¶"" || Exit 1End## Fix the versions, dates, and filetypes of the installed files#Rez	{inst}Bullwinkle.r ¶	-o {work}'Apple //e Boot Blocks'Rez {inst}BootBlocks.r ¶	-o {work}'ProDOS16 Boot Blocks'Rez {inst}Image.r ¶	-o {work}'ProDOS16 Image'Rez	{inst}P8.r ¶	-o	{work}P8Rez	{inst}Basic.r ¶	-o	{work}Basic.SystemSetVersion -t 'vers' -i 1 -version {thisvers}¶	-verstring "^, © Apple Computer, Inc. 1988-1993"¶	{work}"ProDOS16 Boot Blocks"SetVersion -t 'vers' -i 2 -version {thisvers}¶	-verstring "Apple II Setup ^"¶	{work}"ProDOS16 Boot Blocks"SetVersion -t 'vers' -i 1 -version {thisvers}¶	-verstring "^, © Apple Computer, Inc. 1988-1993"¶	{work}"ProDOS16 Image"SetVersion -t 'vers' -i 2 -version {thisvers}¶	-verstring "Apple II Setup ^"¶	{work}"ProDOS16 Image"SetVersion -t 'vers' -i 1 -version 1.5¶	-verstring "^, © Apple Computer, Inc. 1983-1993"¶	{work}"Basic.System"SetVersion -t 'vers' -i 2 -version {thisvers}¶	-verstring "Apple II Setup ^"¶	{work}"Basic.System"SetVersion -t 'vers' -i 1 -version 2.0¶	-verstring "^, © Apple Computer, Inc. 1983-1993"¶	{work}"P8"SetVersion -t 'vers' -i 2 -version {thisvers}¶	-verstring "Apple II Setup ^"¶	{work}"P8"SetVersion -t 'vers' -i 1 -version {thisvers}¶	-verstring "^, © Apple Computer, Inc. 1983-1993"¶	{work}"Apple //e Boot Blocks"SetVersion -t 'vers' -i 2 -version {thisvers}¶	-verstring "Apple II Setup ^"¶	{work}"Apple //e Boot Blocks"SetFile -t 'ZSYS' -c 'MACS' -a S -d "{today}" -m "{today}" {work}'ProDOS16 Boot Blocks'SetFile -t 'ZSYS' -c 'MACS' -a S -d "{today}" -m "{today}" {work}'ProDOS16 Image'SetFile -t 'ZSYS' -c 'MACS' -a S -d "{today}" -m "{today}" {work}'Apple //e Boot Blocks'SetFile -t 'PSYS' -c 'pdos'      -d "{today}" -m "{today}" {work}'P8'SetFile -t 'PSYS' -c 'pdos'      -d "{today}" -m "{today}" {work}'Basic.System'## Build the Installer script#Rez {inst}Apple2GSInstallerScript.r ¶	-o {work}'Apple II Script' ¶	-c 'bjbc' ¶	-t 'bjbc' ¶	-d "releasedate={todayhex}"SetVersion -t 'vers' -i 1 -version {thisvers}¶	-verstring "^, © Apple Computer, Inc. 1988-1993"¶	{work}"Apple II Script"SetVersion -t 'vers' -i 2 -version {thisvers}¶	-verstring "Apple II Setup ^"¶	{work}"Apple II Script"SetFile -d "{today}" -m "{today}" {work}'Apple II Script'## Copy the files to the installer disk#newfolder "{a2s}System Folder" · Dev:Null || Set Status 0duplicate -y "{work}ProDOS16 Boot Blocks"	"{a2s}System Folder:"duplicate -y "{work}ProDOS16 Image"			"{a2s}System Folder:"duplicate -y "{work}Apple //e Boot Blocks"	"{a2s}System Folder:"duplicate -y "{work}P8"						"{a2s}System Folder:"duplicate -y "{work}Basic.System"			"{a2s}System Folder:"## Set the Installer's 'vers' (2) resource to be our disk name.#SetVersion -t 'vers' -i 2 -version {thisvers}¶	-verstring "Apple II Setup ^"¶	"Apple II Setup:Installer"## Run ScriptCheck to update the dates and sizes in the script## Note: ScriptCheck seems to get confused if the disk is already online,# so I eject it and let ScriptCheck ask you to insert it.#eject "{a2s}"ScriptCheck "{work}Apple II Script"duplicate -y "{work}Apple II Script" "{a2s}"## Move the installer script's icon to the right place.#SetFile -a i -l 128,64 "{a2s}Apple II Script"