*************************************************************				   Bird's Better Bye**				   80 Column Version**					Begun 8	Jun	87**			   Added Pop: April	23,	1988** Revision History:** 05/29/90	GAB	Modified for use as official ProDOS Quit code*				Changed P8 calls to macros*				Converted to 'C02 code, but this is currently*					not used.  If the code becomes too long,*					the C02 code can be used to shrink it again.*				Changed signaling of directories in display *					from a '/' to a Mousetext folder*				File list now scrolls up and down** 07/29/91	GAB	Turned on 'C02 code.*				Fixed so that if a subdirectory cannot be*				  opened, the code will no longer move on to*				  the next volume.*				Fixed handling of errors within the directory*				  read loop so that the file is actually*				  closed prior to continuing.************************************************************			Machine	M65C02			Print	Push			Print	off			Include 'M16.P8'		;P8 MLI macros			Include	'E16.8Bit'		;8-bit memory location equates			Include 'E16.P8'		;P8 equates			Print	Pop			PRINT	NOSYM* Buffer AddressesBuff0		equ		$0280Buff1		equ		$0281NameBuff	equ		$1400Op_Buff		equ		$1C00Rd_Buff		equ		$2000MaxFiles	equ		(Op_Buff-NameBuff)>>4StSys		equ		$2000TypeLen		equ		$2000				;type and length info for fileFilType		equ		$2010Access		equ		$201EDirInfo		equ		$2023****************************************************************************************************MyZeroPage	Record	0					;my own zero page usage			org		$60; NOTE:  SetMarkParms MUST reside before $80 on zero page to maintain; compatibility with AppleShareSetMarkParms DS.B	1					;SET_MARK (CE)Mark_Rn		DS.B	1					;file reference	numberFPos_Lo		DS.B	1					;new file positionFPos_Mid	DS.B	1					;FPos_HiI	DS.B	1					;	 last part of above* VariablesLstPntr		ds.w	1					;device	list pointerValcnt		ds.b	1					;name counterFileCount	ds.b	1					;# of displayable files in directoryNameLen		ds.b	1					;length of filenameCounter		ds.b	1					;general purpose counterLevel		ds.b	1					;directory level* File Name	Storage	PointersStoLo		ds.b	1					;lo	byteStoHi		ds.b	1					;hi	byte ($17)* Directory	VariablesEntLen		ds.b	1					;ENTRY_LENGTH storageEntBlk		ds.b	1					;ENTRYS_PER_BLOCK storageCountLo		ds.b	1					;FILE_COUNT	(lo	byte)CountHi		ds.b	1					;FILE_COUNT	(hi	byte)BlkFlag		ds.b	1					;block flag	/ counter			org		BlkFlagBlkFil		ds.b	1					;Valid files read this block* Scroll control variablestopName		ds.b	1					;index number of top name in display* table used to store filetypesFilStore	ds.b	MaxFiles			;table of filetypeszpEnd if zpEnd>$ff then 			aerror	'myZeroPage overflow!' endif			EndR****************************************************************************************************Better_Bye	PROC	Export,TempOrg $1000			With	myZeroPage			cld							;clear to binary mode;										 to conform to Apple specs			lda		RomOvr				;make sure ROM is switched in			stz		ResetVector			;set up	new RESET VECTOR			lda		#$10				;we live at $1000			sta		ResetVector+1			jsr		SetPwrC				;and Power up byte			lda		#$a0				;space character			jsr		Init80				;initialize 80-column text card* Set up BITMAP	in Global Page			ldx		#$17MapLoop		stz		MemTabl,x			dex			bpl		MapLoop			inc		BitMap2				;protect Global	Page			lda		#$cf				;protect zero page,	stack and page 1			sta		MemTabl			lda		#2					;init SetMarkParms pCount			sta		SetMarkParms* Drive	Selector			ldx		DevCnt				;get device	count and			stx		LstPntr				; and store	in zero	pageDS1			lda		DevNum				;get last slot / drive			bne		VolName				;if	<> 0, then start hereDS2			ldx		LstPntr				;get device	list pointer			lda		DevLst,x			;get UNIT_NUMBER from list			cpx		#$01				;make sure it's real			bcs		DS3					;if	so change list pointer			ldx		DevCnt				;get device	count			inx							;increment,	next step decrementsDS3			dex							;decrement list	pointer	and			stx		LstPntr				;	restore* Get and Store	Volume NameVolName		sta		Ol_Unit				;store UNIT_NUMBER for ONLINE			_ON_LINE OnLineParms		;make ONLINE call			bcs		DS2					;error check			stz		Level				;haven't read root directory yet			lda		Buff1				;load description byte			and		#$0f				;mask for name length			beq		DS2					;if	0, then	try next unit			adc		#$02				;add 2 to length			tax							;put name length in	X regVNam1			stx		Buff0				;save the name length			lda		#$2f				;put '/' in	A reg			sta		Buff1				;store in front	of and			sta		Buff0,x				;  end of name			stz		Buff1,x				;put NULL after	complete name* Open and Read	DirectoryRdDir		_Open	OpenParms			bcc		@no_err				;good open			lda		Level				;trying to open root directory?			beq		DS2					;yes, just move to next volume			jsr		Bell1				;beep 'em			jsr		do_pop				;and stay at same level			stx		Buff0			jmp		KeyLoop@no_err			inc		Level			stz		FileCount			;zero out FileCount			lda		Open_Rn				;get file reference	number			sta		Read_Rn				;store in READ and SET_MARK			sta		Mark_Rn				;	parm lists			lda		#$2b				;set READ parm list	for			sta		Len_Lo				;  Directory Header	length			stz		Len_Lo+1			jsr		doRead			bcs		Done				;error check* Get Directory	Information** After	reading	directory the following* will be in these places:**	ENTRY_LENGTH		   @ $2023*	ENTRYS_PER_BLOCK	   @ $2024*	FILE_COUNT (lo byte)   @ $2025*	FILE_COUNT (hi byte)   @ $2026			ldx		#$03				;get ENTRY_LENGTH,DirLoop		lda		DirInfo,x			; and FILE_COUNT and store in zero			sta		EntLen,x			; page			dex			bpl		DirLoop				;loop until	through			sta		Len_Lo				;put ENTRY_LENGTH in READ parm list			lda		#$01			sta		BlkFil				;set block file	counter	to 1			stz		FPos_Mid			;zero out MSB's of File Position in SET_MARK			stz		FPos_HiI			;  parm	list			lda		CountLo				;see if	there any files			ora		CountHi				;  in Directory			bne		ReadFil				;if	so,	continueDone		bra		CloDir				;go	close Directory	File* Check	next file in DirectoryReadFil		bit		CountHi				;check MSB of FILE_COUNT			bmi		Done				;if	set	we're doneSetUp		lda		FPos_Mid			;get mid byte of SET_MARK file position			and		#$fe				;reset LSB			sta		FPos_Mid			;  and save			ldy		BlkFil				;get block file	counter			lda		#$00				;zero A	reg			cpy		EntBlk				;have we read all entrys this block?			bcc		SetLoop				;if	not	continue			tay							;if	so,	zero Y reg and			sty		BlkFil				; reset	block counter /	flag			inc		FPos_Mid			;incr mid byte of file pos* Set up SET_MARK parameters for next file to* be read. If we transfer to second	sector,	handle itSecHalf		inc		FPos_Mid			;incr mid byte of file posSetLoop		dey							;decrement file	 block counter			clc			bmi		SetMark			adc		EntLen				;add entry length to A reg			bcc		SetLoop				;determine if we flopped into			bcs		SecHalf				;  second half of block,;								  		 if so increment $12FESetMark		adc		#$04				;add 4 to A	reg			sta		FPos_Lo				;put in	lo byte	of SET_MARK			_SET_MARK SetMarkParms			bcs		Done				;error handling			jsr		doRead				;read directory file			bcs		Done				;error handling			inc		BlkFil				;increment files read count			lda		TypeLen				;get file len/type			and		#$f0				;mask off high nibble			beq		SetUp				;deleted file, try next	one			dec		CountLo				;decrement lo FILE_COUNT			bne		ReadChk				;			dec		CountHi				; and hi FILE_COUNT	if nessReadChk		ror		Access				;check ACCESS bit			bcc		ReadFil				;if	no read, try next file			lda		FilType				;get FILE_TYPE			cmp		#$0f				;DIR file?			beq		FilNamCk			;	then continue			cmp		#$ff				;SYS file?			bne		ReadFil				; no, read next	fileFilNamCk	ldx		FileCount			;get valid files read			cpx		#MaxFiles			;if > size of filename buffer			bcs		CloDir				; then close directory			sta		FilStore,x			;store FILE_TYPE in	zero page			jsr		NameCalc			;go	set	up storage area* Move File	to storage area			ldy		#$0f				;15	in Y regMovLoop		lda		TypeLen,y			;get byte of file name			sta		(StoLo),y			;store in directed area			dey							;decrement pointer			bpl		MovLoop				;loop 'til name trasnsfered			iny							;set Y = 0 again			and		#$0f				;mask for lo nibble	(NAME_LEN)			sta		(StoLo),y			;restore in	Name Buffer			inc		FileCount			;increment valid file counter			bne		ReadFil				;go	get	next file (branch always)* Error	HandlerError		jmp		DS2					;try next unit* Close	DirectoryCloDir		_Close	CloseParms				;CLOSE directory file			bcs		Error* Print	Page Header			jsr		SetTxt				;use full screen for window			jsr		Home				;clear screen			lda		#23					;position cursor to bottom of screen			jsr		TabV				;set vert pos			ldy		#$00				;zero y	reg			lda		#20					;horizontal position			jsr		SetHorz				;print 'ESC...'	@ pos in A reg* Print	Volume Name			jsr		HomeCursor			;position cursor to upper left corner			ldx		#$00				;zero X	regVNamLoop	lda		Buff1,x				;get char			beq		@showFiles			;if	NULL then through			jsr		OutPut				;output	char			inx							;			bne		VNamLoop			;continue loop@showFiles			stz		ValCnt				;init ValCnt			stz		TopName				;init top filename index			lda		FileCount			;get number	of valid files			beq		KeyLoop				;if	no files, go elsewhere			cmp		#21					;more than what will fit within window?			bcc		@1					;no...			lda		#20@1			sta		Counter				;store loop counter			lda		#2					;set window dimensions			sta		WndTop			sta		WndLft			lda		#22			sta		WndWdth			sta		WndBtmHFileCnt			jsr		NamePrnt			;output	file name to screen			inc		ValCnt			dec		Counter				;dec file counter			bne		HFileCnt			;continue spittin' out names			stz		ValCnt			beq		InvName				;if	last file, it needs	to be INVERSE (branch always)* Left or Up ArrowUpArrow		jsr		NamePrnt			;print old NAME	in NORMAL			ldx		ValCnt				;get old NAME number			beq		InvName				;already at the top name!			dec		ValCnt				;else fix index			lda		CV					;get current cursor line			cmp		#2					;at top line of window?			bne		InvName				;no, move up normally			dec		topName				;fix offset index			lda		#$16				;else scroll window down a line			bne		scroll				;branch always* Right	or Down	ArrowDwnArrow	jsr		NamePrnt			;print old NAME	in NORMAL			ldx		ValCnt				;get old NAME number			inx							;add one			cpx		FileCount			bcs		InvName				;already at last filename!			stx		ValCnt				;else update index			lda		CV					;get current cursor position			cmp		#21					;already on bottom line of window?			bne		InvName				;no, move cursor normally			inc		topName				;update offset index			lda		#$17				;else scroll window up a linescroll			jsr		CoutInvName		jsr		SetInv				;INVERSE text			jsr		NamePrnt			;output	last file name* Keyboard Read	RoutineKeyLoop		lda		Key					;get Keyboard input			bpl		KeyLoop				;loop til key pressed			sta		strobe				;clear strobe			jsr		SetNorm				;set NORMAL	video* Keyboard Filter			ldx		FileCount			;are there any files displayed?			beq		skipArrows			;no, don't accept arrow keys or RETURN			cmp		#$8d				;RTN? run selected file			beq		RunIt			cmp		#$8a				;DOWN?			beq		DwnArrow			;	move down a	name			cmp		#$8b				;UP?			beq		UpArrow				;	yes, move up a nameskipArrows			cmp		#$89				;TAB?			beq		NewVol				;	new volume			cmp		#$9B				;ESC?			bne		KeyLoop				;	no, try again;											else pop up a directory* Pop a	directory levelPop			jsr		do_pop			dec		Level			bra		SelDir2do_pop			ldx		Buff0Pop2		dex			lda		Buff0,X			cmp		#$2F				;slash			bne		Pop2			cpx		#$01			bne		@done			ldx		Buff0@done			rtsNewVol		jmp		DS2					;set up	new	unit number* RETURN on	Directory FileSelDir		inx	SelDir2		jmp		VNam1				;get new Directory Info* Run Selected FileRunIt		_SET_PREFIX	SetPfxParms			bcs		NewVol				;error handler			ldx		ValCnt				;get NAME number			jsr		NameCalc			;set up	NAME storage area			ldx		Buff0				;get prefix	lengthNew_Pref	iny							;set Y reg = 1			lda		(StoLo),y			;get char of NAME			inx			sta		Buff0,x				;put in	proper buffer location			cpy		NameLen				;check length of NAME			bcc		New_Pref			;loop 'til all transfered			stx		Buff0				;put prefix	length into	buffer			ldy		ValCnt				;get file number			lda		FilStore,y			;get FILE_TYPE			bpl		SelDir				;if	DIR, go	else where			jsr		SetTxt				;reset to full window			jsr		Home				;makes for no flash			lda		#$95				;Ctrl U	char			jsr		COut				;	hope it	kills 80 columns --> works			_Open	OpenParms			bcs		NewVol			lda		Open_Rn				;move ref num from OPEN	parm			sta		Read_Rn				;  READ 			lda		#$ff				;simply read the entire file			sta		Len_Lo			sta		Len_Lo+1			jsr		doRead				;READ selected file			php							;temp push of status			_Close	CloseParms			;CLOSE selected	file;										 ignore any error from CLOSEFinish		plp							;pull status from stack			bcs		NewVol				;if	we had a read error, handle	it			jmp		StSys				;transfer control to selcted file************************************************************														  **				 Video Output Subroutines				  **														  ************************************************************* Standard Video Output	for	MessagesSetHorz		sta		CHMsgLoop		lda		msg1,y				;get TEXT from Data	Area			beq		MsgDone				;if	null we're done			jsr		COut				;OutPut	text			iny							;increment counter			bne		MsgLoop				;loop (always taken)MsgDone		rts							;loop escape clause* Name Pointer Calculator for NAME Storage AreaNameCalc			stz		StoHi				;init high byte of 16-bit shift			txa			asl		a					;shift to high nybble			rol		StoHi			asl		a			rol		StoHi			asl		a			rol		StoHi			asl		a			rol		StoHi			sta		StoLo				;place in Lo Pointer			lda		#>NameBuff			clc			adc		StoHiSto_Pointer	sta		StoHi				;put $16 ($17) in Hi Pointer			ldy		#$00				;Y reg = 0			lda		(StoLo),y			;A = file NAME length			sta		NameLen				;temp storage			rts* Output a File	NAME LineNamePrnt	lda		#2					;set h pos to 2			sta		OurCH				;set horizontal	position			ldx		ValCnt				;get file NAME number			txa			sec			sbc		TopName				;calculate line # to put name on			inc		a			inc		a			jsr		TabV				;set vert pos			lda		FilStore,x			;get FILE_TYPE (x is unchanged by TabV)			bmi		SysName				;if	SYS	file jump			stz		OurCH				;adjust cursor position			lda		INVFLG				;save current inverse setting			pha			ldy		#FldrMsg-Msg1			jsr		MsgLoop				;display the folder			pla							;restore inverse setting			sta		INVFLGSysName		jsr		spcOut				;output a 'space'			jsr		NameCalc			;calc name locationLoopName	iny							;Y reg = 1 (first time around)			lda		(StoLo),y			;get character of NAME			jsr		OutPut				;put on	screen			cpy		NameLen				;end of	NAME?			bcc		LoopName			;loop 'til donespcOut		lda		#$a0				;load and OutPut a			bne		myCOut				;  'space' (branch always)HomeCursor	lda		#$99				;screen control - Home cursorOutPut		ora		#$80				;set high bitmyCout		jmp		COut				;put on	screendoRead		_Read	ReadParms			rts* Data Area			msb		onMsg1		DC.B	'RETURN: Select | TAB: Chg Vol | ESC: Back',$00FldrMsg		dc.b	$0f					;INVERSE control code			dc.b	$1b					;enable MouseText			dc.b	'XY'				;folder characters			dc.b	$18					;disable MouseText			dc.b	$0e					;NORMAL control code			dc.b	0			msb		off* Parameter	AreaOpenParms	DC.B	$03					;OPEN (C8)			DC.W	Buff0				;address of	pathname			DC.W	Op_Buff				;address of	file bufferOpen_Rn		DC.B	$00					;reference numberCloseParms	DC.B	$01					;CLOSE (CC)			DC.B	$00					;file reference	numberOnLineParms	DC.B	$02					;ONLINE	(C5)Ol_Unit		DC.B	$60					;unit number, default at S6, D1			DC.W	Buff1				;data bufferSetPfxParms	DC.B	$01					;SET_PREFIX	(C6)			DC.W	Buff0				;address of	Pathname; The last four bytes of this parameter block _may_ extend beyond our 768 byte; limit, since the request count is set prior to using the parameter block, and; the transfer count isn't used at all (except by ProDOS);ReadParms	DC.B	$04					;READ (CA)Read_Rn		DC.B	$01					;file reference	number			DC.W	Rd_Buff				;data buffer addressLen_Lo		;DC.B	$00,$00				;requested length			;DC.B	$00,$00				;actual	length			Export	Bye_EndBye_EndBye_Len		equ		Bye_End-Better_Bye	if Bye_Len>$300 then			aerror	&concat('Better Bye code length overflow by $',&i2s((Bye_Len-$300),-4,1),' bytes.')	endif			ENDP			END