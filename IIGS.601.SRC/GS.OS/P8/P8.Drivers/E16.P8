;; E16.P8 - ProDOS 8 eqates;* MLI Global PageMLI			equ		$BF00				;MLI entry vectorDevAdr01	equ		$BF10				;device driver addressesDevNum		equ		$BF30				;last slot / driveDevCnt		equ		$BF31				;count - 1DevLst		equ		$BF32				;active	device listMemTabl		equ		$BF58				;start of tableBitMap2		equ		$BF6F				;start of tableDateLo		equ		$BF90				;bits 15-9=Yr, 8-5=Mo, 4-0=DayTimeLo		equ		$BF92				;bits 12-8=hr, 5-0=min, low-hi formatLevel		equ		$BF94				;file levelBUBit		equ		$BF95				;backup bitMachID		equ		$BF98				;machine identificationSltByt		equ		$BF99				;1 bit indicates active ROM in slotPFixPtr		equ		$BF9A				;if 0, no prefix activeMLIActv		equ		$BF9B				;if <> 0, MLI call in progressCmdAdr		equ		$BF9C				;return address of last call to MLISaveX		equ		$BF9E				;X-Reg on entry to MLISaveY		equ		$BF9F				;Y-Reg on entry to MLIIBakVer		equ		$BFFCIVersion	equ		$BFFD				;version # of currently running interpreterKBakVer		equ		$BFFEKVersion	equ		$BFFF				;version # of MLI