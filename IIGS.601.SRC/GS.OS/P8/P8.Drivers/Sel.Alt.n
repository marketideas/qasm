				print	off				include	'blaunch.macros'				print	on,nogen,nopage,nohdr****************************************************************** sel.alt.n*	alternate program selector segment for P8 when used* 	in conjunction with GS/OS.** Description*	This code is used in place of the standard P8 interactive*	program selector when P8 is started up by GQuit.  It is called*	by GQuit when GQuit is passing control from one application to*	another, and the new application is an 8-bit application.**	This code first loads the specified P8 application at $2000 in*	bank 0 of memory.  It then checks the message center for a*	possible message specifying the name of a file.  This file is*	passed on to any 8-bit application that follows the guidelines*	on page 88 of the P8 Technical Reference Manual.  When the*	message handling is completed, this segment will pass control*	on to the freshly loaded app.** Version 1.0*	January 30, 1989	-	Greg Branche*****************************************************************				machine	m65816			;using the '816 heredevoffline		equ		$2f				; device off line, or no disk in drive.vnferr			equ		$45				; volume not foundvolbuf			equ		$f00			; buffer for volume nameramin			equ		$c08bromin			equ		$c082			; swap rom in, write protect ramP8Quit			equ		$E0D000alt_dispatch	proc	org $1000; first	16 bytes reserved for patch	by GQuit; currently, patch looks like this:; WARNING - Do NOT start with a CLD instruction (as other replacement; quit code is supposed to do).  GQuit checks this to see if this version; of the quit code is available.				lda		|ramin			;enable	LC Bank	1 for GQuit				clc						;go	to native mode				xce				jmp		>P8Quit			;go	to GQuit				ds.b	(alt_dispatch + 16) - * -2	;offset to paragraph boundary				dc.b	'GQ'			;ID bytes so GQuit can identify us;===============================================================================; load_app;; Entry	is in 16-bit native	mode.; Exit is in emulation mode.; Data bank	register is	set	to bank	$00	on entry and exit.; Direct register is set to	$0000 on entry and exit.; Stack	pointer	is set to $01fb	on entry and exit.;; Inputs:		Acc	= value	of E1_OS_Switch	(0 or 1, 1 = yes, we're switching);; Outputs:		none;; Notes:		This code is moved to $00/1010 and executed	there.;; Loads	and	executes a ProDOS 8	application.;===============================================================================; first, copy the prefix passed from GS/OS to our own volume name buffer; this is done so that if there's an error setting P8's prefix, we can issue; a pretty error message.launcher				shortm					;8-bit accumulator				pha						;save the switch status				ldx		#$200			;point to passed prefix				jsr		copy_volname	;copy the name into the buffer				pla						;retrieve the switch status				; Go into emulation	mode to	load and run ProDOS	8 application.				emulation				;begin emulation mode				ora		#0				; Are we switching from	P16	to P8?				beq		load_it			; no; We are switching from	P16	to P8, so we must pass prefix 0	from P16 to; the P8 prefix.  The prefix is passed at $00/0200 by GQuit.setpfx_call		SetPrefix p8_setpfx_list				bcc		setpfx_ok				jsr		p8error			; handle error.				bra		setpfx_call		; try again.setpfx_ok; Now, load	in the application beginning at	$2000.load_it				xce						;go to native mode (carry already clear)				rep		#$10			;16-bit registers, but leave 8-bit accumulator				longa	off				longi	on				lda		$281			;is the application name a complete pathname?				cmp		#'/'				bne		use_pfx			;no, use prefix as volume name (already set up)				ldx		#$280			;else use the application name!				jsr		copy_volname	;copy the volume name to the bufferuse_pfx				emulation				;back to emulation mode				; Open the application file.open_call		Open	p8_open_list				bcc		open_ok				jsr		p8error			; handle error.				bra		open_call		; try again.open_ok				lda		o_refnum		;copy refnum to parameter lists				sta		eof_refnum				sta		r_refnum				sta		c_refnum				; Do a GetEOF call so we know how many bytes to	read.eof_call		GetEOF	p8_eof_list				bcc		eof_ok				jsr		p8error			; handle error.				bra		eof_call		; try again.eof_ok; Get the size of the file and store in	the	Read parameter list.				lda		|p8_eof				sta		|p8_read_count				lda		|p8_eof+1				sta		|p8_read_count+1; Read in the application.read_call		Read	p8_read_list				bcc		read_ok				jsr		p8error			; handle error.				bra		read_call		; try again.read_ok; Close	the	application	file.close_call		Close	p8_close_list				bcc		close_ok				jsr		p8error			; handle error.				bra		close_call		; try again.close_ok				jsr		do_launch		;check for possible	passing	of second pathname				bne		Here_We_Go		;if	no filename, then just run the program				jsr		CheckForDrive	;else make sure	the	volume containing the file is online				bcc		Here_We_Go		;if so, then off we go!				lda		#vnferr				bra		p8_fatal_err	;if	not	online,	then just quit; Now, execute the application.Here_We_Go				lda		|romin			; Enable ROM.				jmp		$2000			; Execute the application.;-------------------------------------------------------------------------------p8error				native	long			;switch	into 16-bit	native mode				jsr		p8_mount_vol				bcs		p8_fatal_errret_pressed				emulation				;back to emulation mode				rts;===============================================================================; p8_fatal_err;; Entry	is in whatever mode you want (it get's switched immediatedly to native).; Data bank	register is	unknown	at entry.;; Inputs:		A -	error code;; Outputs:		none;; Notes:		This routine does not return.;; Generate a fatal error while running under ProDOS	8.;===============================================================================p8_fatal_err				native					;switch into high gear!				and		#$00ff			; mask off high	byte of	error code				pha						;put on	stack for IntMath tool call				pea		errvalstr>>16	;put address of	string buffer				pea		errvalstr				pea		4				;make string 4 digits long				_Int2Hex				;convert value to hex string				pha						;make space	for	return value				pea		QuitStr1>>16	;push first	error message address				pea		QuitStr1				pea		QuitStr2>>16	;push second error message address				pea		QuitStr2				pea		e1_btn1_label>>16 ;push	first button text address				pea		e1_btn1_label				pea		QuitBtn2>>16	;push second button	text address (null string)				pea		QuitBtn2				_TLTextMountVolume		;make the dialog box				pla						;retrieve button press (not	used)				emulation				;shift back to emulation mode				Quit	QuitParms		;then just quit back to GQuit;===============================================================================; p8_mount_vol;; Entry	is in 16-bit native	mode.; Exit is in 16-bit	native mode.; Data bank	register is	unknown.;; Inputs:		A -	error code;				volbuf = name of volume to mount;; Outputs:		A -	error code (hi byte	set	to 0);				c -	0 if mount volume window put up	and	'return' was pressed;					1 if window	not	put	up or if window	put	up and 'esc' pressed;; If the error code	is volume_not_found	($45) or no	disk in	drive ($2F),; then put up a	window asking the user to insert the needed	volume.;===============================================================================p8_mount_vol				longa	on				longi	on				ldy		#volbuf>>16		;set up	ptr	to volume name				ldx		#volbuf; If error code	is 'volume not found' or 'no disk in drive'	then put up	the; Mount	Volume window, otherwise return	with carry set.				and		#$00ff			;just in case				cmp		#vnferr				beq		cont				cmp		#devoffline				beq		cont				sec						;indicate error	not	handled				rts						;error code	still in Acont				pha						;save error	code in	case ESC pressed				phy						;push ptr to volume	name on	stack				phx				tsc				phd						;save D	reg				tcd						;point D reg at	stack				lda		[<1]			;get length	byte and leading separator				dec		a				;don't count leading separator				xba						;then swap the bytes so	the	volume name				sta		[<1]			;does not contain the separator				pha						; Room for result				pea		e1_mount_msg1>>16				pea		e1_mount_msg1				phy						; hi word of ptr to	volume name				inx						; skip separator				phx						; lo word of ptr to	volume name				pea		e1_btn1_label>>16 ;	'Return'				pea		e1_btn1_label				pea		e1_btn2_label>>16 ;	'Escape'				pea		e1_btn2_label				_TLTextMountVolume				lda		[<1]			;restore first 2 bytes of volume name				xba						;back to their original	positions				inc		a				;and values				sta		[<1]				pla						;Which button: 1=Return, 2=Escape				pld						;restore D reg				plx						;pull volume name ptr off stack				plx				cmp		#1				;which button was pressed?				bne		escape_pressed				clc						;indicate Return was pressed				pla						;pull original error code off stack				rts						;return	with carry clearescape_pressed	sec						;Indicate Escape was pressed				pla						;restore error code				rts						;return	with carry set*****************************************************************copy_volname** Description*	copies the volume name from the given pathname to the volume*	name buffer.** Inputs:*	X -> length byte of complete pathname containing volume name** Outputs:*	volume name is stored in volbuf	*****************************************************************				longa	off				longi	on								lda		|1,x			;get the first slash				sta		volbuf+1				ldy		#2				;initialize the length count@1				lda		|2,x			;now copy the volume name				cmp		#'/'			;up	to the separating slash				beq		@2				sta		volbuf,y				inx				iny				bra		@1@2				dey						;fix character count				tya						;get the length into the accumulator				sta		volbuf			;store the resultant string	length				rts****************************************************************** Do_Launch** This routine translates a	filename message from the message center* to the currently launching P8	application	if the application can* accept a second filename.** First, it	checks the application for the correct structure (as* defined on page 88 of	the	ProDOS 8 Technical Reference Manual).* If the application meets the requirements, it	then checks	for	a* filename message in the message center.  If found, the filename* is copied	into the application's filename buffer.** This routine is entered and exited in	emulation mode.** On exit, the Z flag in the processor status register is set (BEQ)* if a filename	was	correctly passed to	the	application.  The flag* is clear (BNE) if	it couldn't be done.*****************************************************************do_launch				longa	off				longi	off								lda		$2000			;does the app start	with a jump?				cmp		#$4c				bne		go_fer_it		;no, doesn't follow the convention				lda		#$ee			;now check for the signature bytes				cmp		$2003				bne		go_fer_it		;first one doesn't match, just skip it				cmp		$2004				beq		get_msg			;both match, we	can	do itgo_fer_it				rts						;else just return to launch	the	app	    get_msg				lda		#-1				;put flag conditioning value on	stack (assume error)				pha				native	long			;native	mode, 16-bit registers				pha						;make room on stack	for	UserID				_MMStartUp				;start up the memory manager				pla						;get the UserID				pha						;and leave it on the stack				pha						;make room on stack	for	new	handle				pha				pea		0				;get a 10-byte block of	memory				pea		10				pha						;put the UserID	on the stack (still in Acc)				pea		0				;totally unrestricted block				pha						;LocationPtr (not used)				pha				_NewHandle				;go	get	the	block of memory				pla						;get the handle	from the stack				plx				bcs		oops_no_mem		;ERROR?	Just forget	I mentioned	anything then...				phx						;leave the handle on the stack				pha				pea		2				;"get" a message				pea		1				;get a type	1 message (filename	message)				phx						;put the message handle	on the stack				pha						;(still contained in Acc and X-Reg)				_MessageCenter				bcs		oops_no_msg		;What, no message???				pha						;leave 4 bytes free	on stack				pha						;(will be used as a	direct page	pointer)				tsc						;get the stack pointer				phd						;save current direct register				inc		a				;point to new direct page space				tcd						;make our own direct page				lda		[4]				;de-reference the handle				sta		0				ldy		#2				lda		[4],y				sta		2				ldy		#6				;get the message command				lda		[0],y				bne		bad_msg			;if	print, then	just skip it				lda		0				;adjust	pointer	to point to	filename string				clc				adc		#8				sta		0				bcc		no_carry				inc		2no_carry				lda		[0]				;get the length	of the string				and		#$00ff			;mask off high byte	(leaving just the length)				shortm					;8-bit accumulator				cmp		$2005			;check against length of application buffer				beq		samelen			;if	equal, then	continue with move				bcs		bad_msg			;if	too	long, then just	forget itsamelen				tay						;put string	length into	Y (high	byte too)nameloop				lda		[0],y			;get a character				sta		$2006,y			;store it in the app's filename buffer				sta		$0200,y			;and in our prefix buffer				dey				bpl		nameloop		;until all moved				lda		#0				;change	flag conditioning value	on stack				sta		13,s			;to indicate that we have passed a filenamebad_msg				longm					;16-bit	accumulator				pld						;restore direct	register				pla						;fix stack (handle and UserID still	on stack)				pla				pea		3				;now, delete the message (we're done with it)				pea		1				;message type 1				pha						;garbage handle (it's not used, anyway)				pha				_MessageCenter			;go delete the messageoops_no_msg				_DisposeHandle			;throw away	the	message (handle still on stack)oops_no_mem				_MMShutDown				;shut down the memory manager (UserID still on stack)				emulation				;back to emulation mode				pla						;condition Z-flag with value on	stack				bne		done				ldx		$0200			;get length of pathname				lda		#'/'			;look for slash@loop				cmp		$0200,x				beq		@found			;when found, set prefix				dex				bne		@loop				bra		done			;if no slash, just skip it@found				dex						;don't include trailing slash				stx		$0200			;set new length				SetPrefix p8_setpfx_list ;set the P8 Prefix				lda		#0				;set Z flagdone				rts						;now go	launch the app****************************************************************** CheckForDrive** This routine is entered and exited in	emulation mode.** The carry	flag is	used to	signal if the disk can be found.* 	clear = disk was found*	set   = disk couldn't be found*****************************************************************CheckForDrive				clc						;go into native mode				xce				rep		#$10			;16-bit registers, but 8-bit accumulator				longa	off				longi	on				ldx		#$2006			;point to pathname buffer				jsr		copy_volname	;copy volume name to bufferLookForDisk				emulation				;go into emulation mode				GetFileInfo	GFIParams	;try to	get	info on	the	volume				bcc		DoIt1			;volume	found, continue				native					;(must be in native mode)				jsr		p8_mount_vol	;else ask the user to mount	the	volume				bcc		LookForDisk		;if	<return> pressed, try again				emulation				;switch	back to	emulation				sec						;make sure the carry's setDoIt1				rts						;and return;-------------------------------------------------------------------------------; ProDOS 8 parameter lists;-------------------------------------------------------------------------------p8_setpfx_list							; Set prefix parameter list.				DC.B	1				; Number of	parameters is 1.				DC.W	$200			; Address of where prefix is.p8_open_list				DC.B	3				; Parameter	count is 3.				DC.W	$280			; Pathname is at $280.				DC.W	$1c00			; I/O buffer location.o_refnum		DS.B	1				; Reference	numberp8_eof_list				DC.B	2				; Number of	parameters is 2.eof_refnum		DS.B	1				; Reference	numberp8_eof			DS.B	3				; 3	byte EOF value.			  p8_read_list				DC.B	4				; Number of	parameters is 4.r_refnum		DS.B	1				; Reference	number				DC.W	$2000			; Read into	$2000. (Bank 0 of course)p8_read_count	DS.B	2				; Number of	bytes to read.				DS.B	2				; Transfer count. (so what?)p8_close_list				DC.B	1				; Number of	parameters is 1.c_refnum		DS.B	1				; Close	reference numberQuitParms				dc.b	4				; 4	parameters for Quit	call				dc.b	0				; Quit back	to whoever launched	us				dc.w	0				; (it had better be GQuit!)				dc.b	0				dc.w	0GFIParams		DC.B	10				DC.W	volbuf				DS.B	1				; access				DS.B	1				; file type				DS.B	2				; aux type				DS.B	1				; storage type				DS.B	2				; blocks used				DS.B	2				; mod date				DS.B	2				; mod time				DS.B	2				; cre date				DS.B	2				; cre time;-------------------------------------------------------------------------------; Messages for P8_Fatal_Error routine;-------------------------------------------------------------------------------; The maximum length of	this message is	35 characters.; (The error code will be displayed	immediately	following the final	character.)QuitStr1		DC.B	27				; Length byte				DC.B	'Can'				DC.B	$27				DC.B	't run next application.'QuitStr2		dc.b	20				dc.b	'ProDOS Error = $'ErrValStr		dc.b	'    '			;hex error code	gets stored	here by	_Int2HexQuitBtn2		dc.b	0				;null string (no 2nd button);-------------------------------------------------------------------------------; Messages for P8_Mount_Vol	routine;-------------------------------------------------------------------------------; The maximum length of	this message is	35 characters.; The button labels	must not be	more than 16 characters.				string	pascale1_mount_msg1	dc.b	'Please insert the disk:'				string	asise1_btn1_label	DC.B	13				DC.B	'Accept: '				DC.B	$1b				;Basic turn	mousetext on code				DC.B	$0f				;Basic turn	inverse	mode on				DC.B	$4d				;Mousetest return character				DC.B	$0e				;Basic turn	normal mode	on				DC.B	$18				;Basic turn	mousetext off code				string	pascale1_btn2_label	dc.b	'Cancel: Esc'				string	asis********************************************************************************* end of sel.alt.n                                                             ********************************************************************************* if (*-alt_dispatch)>$300 then   aerror &concat('Code length overflow by $', &i2s(*-alt_dispatch,4,1),' bytes.') endif				endp				end