  X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_sys		longa	on		longi	on						cmp	#$0015		; was key a right arrow?		beq	sys_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	sys_arrow	; yes		clc		rtssys_arrow				jsr	home		; clear screen		jsr	wait_vbl	; wait for vertical blanking time                pea     sys_page>>16	; Display GS/OS Direct Page                pea     sys_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays all the GS/OS block diagram** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_block		longa	on		longi	on						cmp	#$0015		; was key a right arrow?		beq	block_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	block_arrow	; yes		clc		rtsblock_arrow			jsr	home		; clear screen		lda	|mode		; set inverse display mode		pha		lda	#inverse		sta	|mode		jsr	wait_vbl	; wait for vertical blanking time                pea     block_page>>16	; Display GS/OS Direct Page                pea     block_page                jsr     writecstring		pla		sta	|mode		clc		rts				eject******************************************************************* This routine displays all the GS bank $E1 vectors** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_bank_e1		longa	on		longi	on						cmp	#$0015			; was key a right arrow?		beq	e1_arrow		; yes				cmp	#$0008			; was key a left arrow?		beq	e1_arrow		; yes		clc		rtse1_arrow			jsr	home			; clear screen		jsr	wait_vbl		; wait for vertical blanking time                pea     bank_e1_page>>16	; Display GS/OS Direct Page                pea     bank_e1_page                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays all the GS/OS system service calls** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*   