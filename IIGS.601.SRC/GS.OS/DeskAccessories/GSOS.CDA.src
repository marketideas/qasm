c.w	12			; c - GS/OS FST Numbers		dc.w	13			; D - GS/OS FST Headers		dc.w	13			; d - GS/OS FST Headers		dc.w	14			; E - GS/OS Block Diagram		dc.w	14			; e - GS/OS Block Diagram		dc.w	15			; F - GS Bank $E1 vectors		dc.w	15			; f - GS Bank $E1 vectors		dc.w	16			; G - Express Loader Info		dc.w	16			; g - Express Loader Info		dc.w	17			; H - Device dispatcher file list		dc.w	17			; h - Device dispatcher file list		dc.w	18			; I - vbl		dc.w	18			; i - vbl		dc.w	19			; J - Death Trap		dc.w	19			; j - Death Trap		dc.w	20			; K - Driver Calls		dc.w	20			; k - Driver Calls		dc.w	21			; L - Device Characteristics		dc.w	21			; l - Device Characteristics		dc.w	22			; M - Supervisor Characteristics		dc.w	22			; m - Supervisor Characteristics		dc.w	23			; N - Memory Attributes		dc.w	23			; n - Memory Attributes		dc.w	24			; O - GS/OS Memory Map		dc.w	24			; o - GS/OS Memory Map		dc.w	25			; P - Visit Monitor		dc.w	25			; p - Visit Monitor		dc.w	26			; Q - System User ID		dc.w	26			; q - System User ID		dc.w	27			; R - 		dc.w	27			; r - 		dc.w	28			; S - 		dc.w	28			; s - 		dc.w	29			; T - 		dc.w	29			; t - 		dc.w	30			; U - 		dc.w	30			; u - 		dc.w	31			; V - 		dc.w	31			; v - 		dc.w	32			; W - 		dc.w	32			; w - 		dc.w	33			; X - 		dc.w	33			; x - 		dc.w	34			; Y - 		dc.w	34			; y - 		dc.w	35			; Z - 		dc.w	35			; z -                 eject******************************************************************************** This routine waits for a key from the keyboard.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Key character (7 bit ascii) in lsb*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************wait_key		longa	on		longi	on				sep	#$20		; 8 bit 'm'		longa	offkey_loop		lda	>keydata	; any key pending?		bpl	key_loop	; no, wait for key				sta	>keystrobe	; clear key register		rep	#$20		; 16 bit 'm'		longa	on				and	#$007F		rts		                eject******************************************************************************** This routine waits for a hex data from the keyboard.  As data is input, it* will be displayed at the current cursor position and the cursor position * will be subsequently advanced to the next valid cursor position.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = hex value*               X Reg = Unchanged*               Y Reg = Unchanged*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ 0  0	key is valid hex*                       ¥ ¥ 0 0 0 ¥ ¥ 1  0	key is not valid hex*******************************************************************************wait_hex		longa	on		longi	on				phx		phy				lda	|ch		pha		lda	|cv		pha		lda	|mode		pha				lda	#flashing		; set mode to inverse		sta	|mode		lda	#' '			; and display cursor		jsr	writecharanother_key		jsr	wait_key		; wait for keyboard input		ldx	#0hex_key_loop		cmp	|hex_key_tbl,x		; find valid hex key entry		beq	have_hex_key		inx		inx		cpx	#hex_data_tbl-hex_key_tbl		bne	hex_key_loop		cmp	#escape_key		bne	another_key		; if invalid then get another key		sec		lda	#' '		bcs	escaped_hexhave_hex_key			cmp	#$0041			; is it an alpha?		blt	have_alpha		; yes		and	#$00DF			; else force upper casehave_alpha		clcescaped_hex		tay				; perserve character		pla		sta	|mode		pla		sta	|cv		pla		sta	|ch		php		phx		phy		jsr	vtab			; reset cursor position		pla				; restore character and...		jsr	writechar		; write the character to the screen		plx		lda	|hex_data_tbl,x		; get the hex equivalent		plp				; restore error status		ply		plx		rtshex_key_tbl	dc.w	'0'		dc.w	'1'		dc.w	'2'		dc.w	'3'		dc.w	'4'		dc.w	'5'		dc.w	'6'		dc.w	'7'		dc.w	'8'		dc.w	'9'		dc.w	'A'		dc.w	'a'		dc.w	'B'		dc.w	'b'		dc.w	'C'		dc.w	'c'		dc.w	'D'		dc.w	'd'		dc.w	'E'		dc.w	'e'		dc.w	'F'		dc.w	'f'		hex_data_tbl	dc.w	0		dc.w	1		dc.w	2		dc.w	3		dc.w	4		dc.w	5		dc.w	6		dc.w	7		dc.w	8		dc.w	9		dc.w	10		dc.w	10		dc.w	11		dc.w	11		dc.w	12		dc.w	12		dc.w	13		dc.w	13		dc.w	14		dc.w	14		dc.w	15		dc.w	15		                eject******************************************************************************** This routine waits for a hex data from the keyboard.  As data is input, it* will be displayed at the current cursor position and the cursor position * will be subsequently advanced to the next valid cursor position.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = hex word value*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************wait_byte		longa	on		longi	on		ldx	#2			; set data length		bra	wait_hex_entry		******************************************************************************** This routine waits for a hex data from the keyboard.  As data is input, it* will be displayed at the current cursor position and the cursor position * will be subsequently advanced to the next valid cursor position.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = hex word value*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************wait_word		longa	on		longi	on		ldx	#4			; set data length		bra	wait_hex_entry		                eject******************************************************************************** This routine waits for a hex data from the keyboard.  As data is input, it* will be displayed at the current cursor position and the cursor position * will be subsequently advanced to the next valid cursor position.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = least significant hex word value*               X Reg = most significant hex word value*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************wait_long		longa	on		longi	on				ldx	#8			; set data lengthwait_hex_entry		stz	|word_data		stz	|word_data+2		stx	|hex_data_len				dexwait_word_loop		phx		jsr	wait_hex		; wait for keyboard input		bcs	escaped_wait		; no data if escaped		pha		txa				; is this a high nibble?		lsr	a			; C=nibble index, X=byte index		tax		pla		bcc	low_nibble		; C=1 if high nibble, C=0 if low nibble		asl	a			; put data in high nibble		asl	a		asl	a		asl	alow_nibble		ora	|word_data,x		sta	|word_data,x		plx		dex		bpl	wait_word_loopword_done		lda	#$000D			; output cr/lf		jsr	writechar		lda	|word_data		; exit with data		ldx	|word_data+2		clc		rtsescaped_wait		lda	#$000D			; output cr/lf		jsr	writechar		sec				; set escaped flag		plx		lda	#0		tax		rts		hex_data_len	dc.w	0word_data	ds	12		eject******************************************************************* This routine displays all CDA display options.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_page1		longa	on		longi	on				cmp	#$0015		; was key a right arrow?		beq	p1_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	p1_arrow	; yes		clc		rtsp1_arrow			jsr	home		jsr	wait_vbl	; wait for vertical blanking time                pea     cda_page1>>16	; Display CDA options                pea     cda_page1                jsr     writecstring		clc		rts				eject******************************************************************* This routine displays all the driver parameters on the * GS/OS direct page.** ENTRY: Call via 'JSR'*               A Reg = Character from keyboard*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************display_dir_pg		longa	on		longi	on						cmp	#$0015		; was key a right arrow?		beq	p2_arrow	; yes				cmp	#$0008		; was key a left arrow?		beq	p2_arrow	; yes		clc		rtsp2_arrow				jsr	home		; clear screen		jsr	wait_vbl	; wait for vertical blanking time                pea     cda_page2>>16	; Display GS/OS Direct Page                pea     cda_page2                jsr     writecstring		lda	#45		; display OS call name		sta	|ch		stz	|cv		lda	<call_number	; is this a legal call number?		and	#$00FF		cmp	#$0034		blt	display_call	; yes		lda	#$0000		; nodisplay_call		asl	a		; now display call name		asl	a		tax		lda	|call_name_table+2,x		pha		lda	|call_name_table,x		pha		jsr	writecstring				lda	#3		; adjust cursor position		jsr	set_ch2		                lda     <drvr_dev_num                jsr     display_int		lda	#3		; adjust cursor position		jsr	set_ch4		                lda     <call_number                jsr     display_int			lda	#4		; adjust cursor position		jsr	set_ch2		                lda     <drvr_call_num                jsr     display_int		lda	#4		; adjust cursor position		jsr	set_ch3		             