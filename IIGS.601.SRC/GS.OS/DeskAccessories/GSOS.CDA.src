		String	AsIs****************************************************************************************************               			Copyright (c) 1987-1992*               			Apple Computer, Inc.*               			All rights reserved.*****************************************************************************************************  GGG   SSS      *  OOO   SSS        SSS  N   N  OOO   OOO  PPPP  EEEEE RRRR* G   G S   S     * O   O S   S      S   S N   N O   O O   O P   P E     R   R* G     S        *  O   O S          S     NN  N O   O O   O P   P E     R   R* G  GG  SSS    *   O   O  SSS        SSS  N N N O   O O   O PPPP  EEEE  RRRR* G   G     S  *    O   O     S          S N  NN O   O O   O P     E     R R* G   G S   S *     O   O S   S      S   S N   N O   O O   O P     E     R  R*  GGG   SSS  *      OOO   SSS        SSS  N   N  OOO   OOO  P     EEEEE R   R**	Written by Ray Montagne***************************************************************************************************** WARNING!!!!!!**			This CDA accesses and displays internal data*			structures of the operating system.  This is *			data that is not intended for public distribution.*			This CDA is not to be distributed outside the*			engineering community at Apple Computer, Inc.***************************************************************************************************** REVISION HISTORY:** Date		Version	By	Description** 12 May 87 	v1.00	RBM	Initial release of DIB CDA.* 24 Jul 87 	v1.01	C/M	Added Cache Manager CDA.* 06 Aug 87 	v1.02	RC	Added cache glu.* 03 Dec 87 	v1.03	RBM	Modified for expanded DIB's.* 20 Jan 88 	v1.04	RBM	Changed DIB for DIB_DEV_NUM.* 28 Jan 88 	v1.05	RBM	Restore DIB pointer on the way out.* 31 Mar 88 	v0.07	RBM	Added supervisor fields.* 29 Nov 88	v2.00	RBM	Ported CDA to MAX environment.* 30 Nov 88	v4.10	RBM	Added built in 80 column display driver.*  1 Dec 88	v4.11	RBM	Expanded displays for internal distribution.*  2 Dec 88	v4.12	RBM	Added display pages for vcr and fcr.*  3 Dec 88	v4.13	RBM	Added display functions to dereference virtual*				pointers.  FCR display page now displays the *				fst name.*  4 Dec 88	v4.14	RBM	Added FST specific display pages for*				fcr and vcr displays.  VCR page now displays the*				volume name.*  5 Dec 88	v4.15	RBM	Restructured mechanism for displaying fst specific*				vcr and fcr pages to reduce code size.  The direct *				page display now displays the call name.*  5 Dec 88	v4.16	RBM	Removed call checking from vcr & fcr display page*				routines.*  5 Dec 88	v4.17	RBM	Added limited scrolling of vcr and fcr pages.**  6 Dec 88	v4.18	RBM	Do not dereference a virtual pointer with the*				most significant bit of the vp set to a one.**  7 Dec 88	v4.19	RBM	A more robust method is now used to determine*				that a virtual pointer is valid prior to*				dereferencing the virtual pointer.  The method*				for validating a vp will work as long as GS/OS*				continues to allocate 8k memory segments.**  9 Dec 88	v4.20	RBM	Added cache header display page.** 21 Dec 88	v4.21	RBM	Added field in AppleTalk FCR.**  3 Jan 89	v4.22	RBM	Extended DIB pointer now displayed correctly.** 19 Jan 89	v4.23	RBM	Added display pages for OS calls, System service*				calls and OS error codes.** 19 Jan 89	v4.24	RBM	Added display page for OS user ID numbers.** 25 Jan 89	v4.25	RBM	Added new ProDOS FST VCR parameter.** 25 Jan 89	v4.26	RBM	Cache display can now scroll through cached blocks.** 25 Jan 89	v4.27	RBM	Cache block number displayed lsb twice.**  7 Feb 89	4.28	RBM	Single keystroke for goto page added for copyright*				page to ease dispatching.**  8 Feb 89	4.29	RBM	After initial entry to CDA, subsequent CDA entries*				will display the last page that was displayed when*				the CDA was previously exited.**				Trap converted to text display while preserving the*				current display mode.**				Keyboard Interrupts are suspended during execution *				of the desk accessory in order to prevent keystrokes*				from being stolen from the CDA.  (This should have*				been provided by the CDA Manager).**				Screen is homed prior to displaying the block diagram.** 14 Feb 89	4.30	RBM	Expanded key function table to accomodate all pages.** 17 Feb 89	4.31	RBM	Fixed bug with indirect dereference call now via jsr.*				Pascal FST added to block diagram.*				Escape from trap display menu outputs cr/lf.** 19 Feb 89	4.32	RBM	System Call Trap is functional.** 20 Feb 89	4.33	RBM	FCR display now displays full pathnames.** 21 Feb 89	4.34	RBM	Added display page for FST headers.** 22 Feb 89	4.35	RBM	Added display page for bank $E1 vectors.** 28 Feb 89	4.36	RBM	Added display for Express Load.**  1 Mar 89	4.37	RBM	Added display page for device dispatcher file list.**  1 Mar 89	4.38	RBM	Supervisor display now shows supervisor characteristics word.**  1 Mar 89	4.39	RBM	Both VCR and FCR display pages now parse carriage returns out*				of the volume or file pathname strings during display.  Carriage*				returns are replaced with the '@' character.  This prevents*				unwanted screen manipulation and damage to other text on the *				screen when an invalid VCR or FCR virtual pointer is currently*				set on GS/OS direct page.**  2 Mar 89	4.40	RBM	Moved temp (a longword on GS/OS direct page used by the CDA*				for indirection, yet saved and restored around CDA execution)*				from location $60 (used by the cache manager) to location*				$50 which is not current used by a component of the GS/OS.**				Added line to file list page to display user ID of driver file.**				FCR file name is now displayed on line 6 rather than 5.  Line 5*				is the file name address and was being written over by the file*				name string.**				SIB display now properly obtains supervisor characteristics word*				and reserved field word.**  2 Mar 89	4.41	RBM	Updated file name list display page for new data structure.**  2 Mar 89	4.42	RBM	Rearranged file list parameters to match os implementation.**  2 Mar 89	4.43	RBM	Fixed display of file list pointer.**  3 Mar 89	4.44	RBM	Fixed display of device dispatcher file list.*				Added parameter to FST header display to show base address*				of the FST header as requested by Bryan Atsatt.**  3 Mar 89	4.45	RBM	Fixed display of device dispatcher file list current filename.**  8 Mar 89	4.46	RBM	File list display now dereferences the file list handle prior*				to displaying the file list entry.** 10 Mar 89	4.47	RBM	Added VBL queue display page.** 30 Mar 89	4.48	RBM	System Death Trap** 30 Mar 89	4.49	RBM	Driver Calls reference** 30 Mar 89	4.4A	RBM	Device Characteristics Word reference** 30 Mar 89	4.4B	RBM	Supervisor Characteristics Word reference** 30 Mar 89	4.4C	RBM	Memory Attributes reference** 30 Mar 89	4.4D	RBM	GS/OS Memory Map** 30 Mar 89	4.4E	RBM	Visit Monitor** 30 Mar 89	4.4F	RBM	User ID Display**  6 Apr 89	4.50	RBM	Rewrote single key dispatcher for page 0.**  6 Apr 89	4.51	RBM	Added SCSI Manager Internal Data structure dumper.**  7 Apr 89	4.52	RBM	Added current slot under view to scsi i/o record display.** 20 Apr 89	4.53	RBM	New AppleShare FST VCR & FCR display.** 20 Apr 89	4.54	RBM	Added device ID list display.** 25 Apr 89	4.55	RBM	Shortened trap display strings so text window does not*				truncate display of call number.** 25 Apr 89	4.56	RBM	Added display page information for AppleShare FST.** 15 May 89	4.57	RBM	Quick key for system service call table pointed at the*				display page for the system calls.** 16 May 89	4.58	RBM	Added display page for device status word.** 16 May 89	4.59	RBM	Fixed character status word so that wrprot is not indicated*				for character devices.** 17 May 89	4.5A	RBM	Added display page for ascii chart.**		4.5B	RBM	Write c string now supports two character tabs.  The first*				character is a tab while the character immediately following*				the tab is the cursor horizontal position.  Most strings have*				been compressed using tabs.** 23 May 89	4.5C	RBM	Expanded memory map display to include bank 0 and managed memory.** 13 Jun 89	4.5D	RBM	All of GS/OS direct page is preserved throughout execution of the*				desk accessory.  The GS/OS Stack Entry trap is now insensitive to*				the processor mode when called.  When the trap is active, a store*				occurs to bank $F80000 + offset prior to execution of the GS/OS*				call where offset = GS/OS call number.  A store occurs to bank*				$F90000 + offset after execution of the GS/OS call.  This allows a*				trigger to be used with the logic analyzer on any GS/OS call when*				the trap is active.** 24 Dec 91	5.01	GAB	Updated source to match version 5.01.  It looks like the only*				difference between 4.5D and 5.01 is the addition of HFS data*				structure support.  (I have no idea where the original 5.01*				source is.  It certainly wasn't in Projector.)** 24 Dec 91	6.0d1	GAB	Updated to support changes in System 6.** 19 Jan 92	6.0d2	GAB	¥ Fixed display_fcr_pg to check for a NULL pointer prior to*				trying to display the contents of the FCR.*				¥ Added templates for displaying Pascal FCRs and MSDOS VCRs*				and FCRs.***************************************************************************************************		eject****************************************************************************************************			DESK ACCESSORY EQUATES***************************************************************************************************os_entry	equ	$E100A8		; in line entry to GS/OSos_stk_entry	equ	$E100B0		; stack entry to GS/OStool_locator	equ	$E10000		; Tool locator entry pointkeydata		equ	$E1C000		; keyboard data (bit 7 = key down)clr80col	equ	$E1C000		; disable 80 column storeset80col	equ	$E1C001		; enable 80 column storeclr80vid	equ	$E1C00C		; disable 80 column hardwareset80vid	equ	$E1C00D		; enable 80 column hardwareclraltchar	equ	$E1C00E		; normal LC flashing UCsetaltchar	equ	$E1C00F		; normal inverse, LC, no flashkeystrobe	equ	$E1C010		; keyboard strobe (bit 7 = key in data register)rdvbl		equ	$E1C019		; vertical blanking (bit 7 = not vbl)altcharset	equ	$E1C01E		; bit 7 = alternate character set enabledrd80vid		equ	$E1C01F		; bit 7 = 80 column hardware enablednewvideo	equ	$E1C029		; new video stufftxtclr		equ	$E1C050		; switch in graphics (not text)txtset		equ	$E1C051		; switch in text (not graphics)mixclr		equ	$E1C052		; clear mixed modemixset		equ	$E1C053		; set mixed mode (4 lines text)txtpage1	equ	$E1C054		; set text page 1txtpage2	equ	$E1C055		; set text page 2rom_in		equ	$E1C081		; ROM in, write enable LC ramstate_reg	equ	$E1C068		; //GS State Registermain_text_pg	equ	$E00400		; 1/2 80 column text pagealt_text_pg	equ	$E10400		; 1/2 80 column text pagegsos_dir_page	equ	$00BD00		; GS/OS Direct Pagegsos_stack_ptr	equ	$00BFFF		; GS/OS Stack Pointerfst_table_ptr	equ	$00B9F2		; location of pointer to FST tabletemp		equ	$000050		; temporary direct page work spacecur_field_len	equ	$000080		; used during editstr_index	equ	cur_field_len+2	; used during editrc_cache_vp	equ	str_index+2	; used by cache DArc_cache_ptr	equ	rc_cache_vp+4	; used by cache DApage_cnt	equ	36		; number of display pagesnormal		equ	%0000000011111111	; normal video modeinverse		equ	%0000000000111111	; inverse video modeflashing	equ	%0000000001111111	; flashing video modeescape_key	equ	$1Btab_key		equ	$09tab		equ	tab_keydelete_key	equ	$7Ft_hex		equ	0t_handle	equ	1t_vp		equ	2t_pstr		equ	3t_c1instr	equ	4t_c1outstr	equ	5t_cstr		equ	6t_binary	equ	7byte		equ	1word		equ	2ptr		equ	3long		equ	4double_long	equ	8fst_header	equ	0			; (lw)      fst header id string (FST )fst_hdr_app	equ	fst_header+4		; (lw)      application call entryfst_hdr_sys	equ	fst_hdr_app+4		; (lw)      system call entryfst_hdr_id	equ	fst_hdr_sys+4		; (w)       FST ID numberfst_hdr_flag	equ	fst_hdr_id+2		; (w)       FST Flag wordfst_hdr_ver	equ	fst_hdr_flag+2		; (w)       FST Version wordfst_hdr_blk	equ	fst_hdr_ver+2		; (w)       FST block sizefst_hdr_max_blk	equ	fst_hdr_blk+2		; (lw)      FST maximum block countfst_hdr_min_blk	equ	fst_hdr_max_blk+4	; (lw)      FST minimum block countfst_hdr_max_f	equ	fst_hdr_min_blk+4	; (lw)      FST minimum block countfst_hdr_res	equ	fst_hdr_max_f+4		; (lw)      FST minimum block countfst_hdr_string	equ	fst_hdr_res+4		; (pstring) FST namefile_list_cnt	equ	$E0E051			; Device Dispatcher file list entry count		eject****************************************************************** The following are equates used to access the device dispatcher* file list structure.*****************************************************************file_list_hndl	equ	$E0E045			; handle to GS/OS file name listfile_list_ptr	equ	$2C			; pointer to GS/OS file name listfile_entry_ptr	equ	$56			; pointer to GS/OS file name list entryfile_filetype	equ	0			; (w)	driver filetypefile_auxtype	equ	file_filetype+2		; (w)	driver auxtypefile_user_id	equ	file_auxtype+2		; (w)	driver user idfile_load_addr	equ	file_user_id+2		; (lw)	driver load addressfile_name	equ	file_load_addr+4	; (32)	file name (32 bytes maximum)file_restart	equ	file_name+32		; (w)	driver restart flagfile_dev_num	equ	file_restart+2		; (w)	driver base device numberfile_reserved	equ	file_dev_num+2		; (w)	reserved field		print	off		eject****************************************************************** The following are direct page equates on the GS/OS* direct page for driver usage.*****************************************************************stack_top       equ    $00BFFF         ; initial value of system stack pointerdirect_base     equ    $00BD00         ; base address of system direct pagegquit_stack_top equ    $00BCFF         ; gquit sets stk here for boot/switchingdrvr_start      equ    $0000           ; start location of driver parametersgs_start        equ    $0030           ; start of GS/OS parametersfst_start       equ    $0080           ; start of FST parameterscache_wspace    equ    $005A           ; beginning addr of cache mgr w/spacedrvr_wspace     equ    $006A           ; ***** NUKE THIS LATER ****sup_wspace      equ    $006C           ; supervisory driver workspacedrvr_dev_num    equ    drvr_start      ; (w)  device numberdrvr_call_num   equ    drvr_dev_num+2  ; (w)  call numberdrvr_buf_ptr    equ    drvr_call_num+2 ; (lw) buffer pointerdrvr_slist_ptr  equ    drvr_call_num+2 ; (lw) buffer pointerdrvr_clist_ptr  equ    drvr_call_num+2 ; (lw) buffer pointerboot_slot       equ    drvr_buf_ptr    ; (w)  boot slot for dispatcher onlydev_id_ref      equ    drvr_buf_ptr    ; (w)  indirect device IDdev_char_config equ    drvr_buf_ptr+2  ; (w)  BASIC/Pascal1.1 configurationdev_pro_config  equ    drvr_buf_ptr+4  ; (w)  ProDOS configurationdrvr_req_cnt    equ    drvr_buf_ptr+4  ; (lw) request countboot_user_id   	equ    drvr_req_cnt+2  ; (w)  transfer countdrvr_tran_cnt   equ    drvr_req_cnt+4  ; (lw) transfer countdrvr_blk_num    equ    drvr_tran_cnt+4 ; (lw) block numberdrvr_blk_size   equ    drvr_blk_num+4  ; (w)  block sizedrvr_fst_num    equ    drvr_blk_size+2 ; (w)  File System Translator Numberdrvr_stat_code  equ    drvr_fst_num    ; (b)  status code for status calldrvr_ctrl_code  equ    drvr_fst_num    ; (b)  control code for control calldrvr_vol_id     equ    drvr_fst_num+2  ; (w)  volume iddrvr_cache      equ    drvr_vol_id+2   ; (w)  Cache Prioritydrvr_cach_ptr   equ    drvr_cache+2    ; (lw) pointer to cached blockdrvr_dib_ptr    equ    drvr_cach_ptr+4 ; (lw) pointer to active DIBdrvr_dev_ptr    equ    drvr_dib_ptr+4  ; (lw) pointer to device list		eject****************************************************************** Cache Manager Direct Page*****************************************************************cache_cur_ptr   equ    cache_wspace    ; (lw) pointer to current cache cellcache_nxt_ptr   equ    cache_cur_ptr+4 ; (lw) pointer to next cache cellcache_pre_ptr   equ    cache_nxt_ptr+4 ; (lw) pointer to prev cache cellcache_bkt_ptr   equ    cache_pre_ptr+4 ; (lw) pointer to bucket listdefault_cache_size equ $0040           ;16k is default cache size****************************************************************** Supervisory Driver Direct Page*****************************************************************post_drvr_tbl   equ    sup_wspace      ; (lw) for dynamic driver installationsup_drvr_ptr    equ    sup_wspace+4    ; (lw) ptr to supervisor driver listsib_ptr         equ    sup_drvr_ptr+4  ; (lw) ptr to SIBsup_parm_ptr    equ    sib_ptr+4       ; (lw) ptr to supervisor parameters****************************************************************** The following are absolute zero page equates for use by* slot resident firmware based ProDOS block device drivers.*****************************************************************pcmd            equ    $0042           ; (b)  ProDOS device commandpunit           equ    $0043           ; (b)  ProDOS unit numberpbuffer         equ    $0044           ; (w)  ProDOS buffer addresspblock          equ    $0046           ; (w)  ProDOS block number****************************************************************** The following are equates for driver command types.*****************************************************************drvr_startup    equ    $0000           ; driver startup commanddrvr_open       equ    $0001           ; driver open commanddrvr_read       equ    $0002           ; driver read commanddrvr_write      equ    $0003           ; driver write commanddrvr_close      equ    $0004           ; driver close commanddrvr_status     equ    $0005           ; driver status commanddrvr_control    equ    $0006           ; driver control commanddrvr_flush      equ    $0007           ; driver flush commanddrvr_shutdn     equ    $0008           ; driver shutdown command****************************************************************** The following are equates for dispatcher command types.*****************************************************************dsptch_bootinit equ    $0000           ; dispatcher boot init commandget_dib_ptr     equ    $0001           ; return a drivers DIB pointerdsptch_shutdn   equ    $0002           ; dispatcher shutdown command		eject****************************************************************** GS/OS Direct Page Equates*****************************************************************call_number     equ    gs_start        ; FST call numberparam_blk_ptr   equ    call_number+2   ; pointer to user's parameter blockdev_num         equ    param_blk_ptr+4 ; device number from parameter blockdev1_num        equ    dev_num         ; alias name for dev_numdev2_num        equ    dev1_num+2      ; second device numberpath1_ptr       equ    dev2_num+2      ; ptr to 1st partial/entire pathnamefcr_ptr         equ    path1_ptr       ; pointer to file control recordpath2_ptr       equ    path1_ptr+4     ; ptr to 2nd partial/entire pathnamevcr_ptr         equ    path2_ptr       ; pointer to volume control recordpath_flag       equ    path2_ptr+4     ; flag for path information*                                       ;*                                       ; bit  14: 0 = pathname1 is null*                                       ;      14: 1 = pathname1 is non-null*                                       ;*                                       ;      06: 0 = pathname2 is null*                                       ;      06: 1 = pathname2 is non-null*                                       ;span1           equ    path_flag+2	; largest distance between path1 term.span2           equ    span1+2		; max dist. between seperators for path2 ****************************************************************** The following are equates for GS/OS error codes.*****************************************************************no_error        equ	$00             ; no error has occuredbad_system_call equ	$01             ; bad system call numberinvalid_pcount  equ	$04             ; invalid parameter countgsos_active     equ	$07             ; gsos already activedev_not_found   equ	$10             ; device not foundinvalid_dev_num equ	$11             ; invalid device numberdrvr_bad_req    equ	$20             ; bad request or commanddrvr_bad_code   equ	$21             ; bad control or status codedrvr_bad_parm   equ	$22             ; bad call parameterdrvr_not_open   equ	$23             ; character device not opendrvr_prior_open equ	$24             ; character device already openirq_table_full  equ	$25             ; interrupt table fulldrvr_no_resrc   equ	$26             ; resources not availabledrvr_io_error   equ	$27             ; I/O errordrvr_no_dev     equ	$28             ; device not connecteddrvr_busy       equ	$29             ; driver is busy & not availabledrvr_wr_prot    equ	$2B             ; device is write protecteddrvr_bad_count  equ	$2C             ; invalid byte countdrvr_bad_block  equ	$2D             ; invalid block numberdrvr_disk_sw    equ	$2E             ; disk has been switcheddrvr_off_line   equ	$2F             ; device off line / no media presentbad_path_syntax equ	$40             ; invalid pathname syntaxinvalid_ref_num equ	$43             ; invalid reference numberpath_not_found  equ	$44             ; subdirectory does not existvol_not_found   equ	$45             ; volume not foundfile_not_found  equ	$46             ;dup_pathname    equ	$47             ; create or rename with existing namevolume_full     equ	$48             ;vol_dir_full    equ	$49             ; volume directory fullversion_error   equ	$4A             ;bad_store_type  equ	$4B             ; bad storage typeend_of_file     equ	$4C             ;out_of_range    equ	$4D             ; position out of rangeinvalid_access  equ	$4E             ; access not allowedbuff_too_small  equ	$4F             ; buffer too smallsofterrorlow    equ	$50             ; errors from $50 to $6f are soft errorsfile_busy       equ	$50             ; file is already opendir_error       equ	$51             ; directory errorunknown_vol     equ	$52             ; unknown volume typeparm_range_err  equ	$53             ; parameter out of rangeout_of_mem      equ	$54             ; out of memorydup_volume      equ	$57             ; duplicate volume namenot_block_dev   equ	$58             ; not a block deviceinvalid_level   equ	$59             ; specified level outside legal rangedamaged_bitmap  equ	$5A             ; block number too largebad_path_names  equ	$5B             ; invalid pathnames for change_pathnot_system_file equ	$5C             ; not an executable fileos_unsupported  equ	$5D             ; operating system not supportedstack_overflow  equ	$5F             ; too many applications on stackdata_unavail    equ	$60             ; data unavailableend_of_dir      equ	$61             ; end of directory has been reachedinvalid_class   equ	$62             ; invalid FST call classres_not_found   equ	$63             ; file does not contain req. resourceinvalid_fst_id  equ	$64             ; specified FST is not present in systeminvalid_fst_op  equ	$65             ; FST does not handle this type of callfst_caution     equ	$66             ; FST handled call, but result is weirddup_device      equ	$67             ; used internally only!!!dev_list_full   equ	$68             ; device list is fullsup_list_full   equ	$69             ; supervisor list is fullsofterrorhigh   equ	$6f             ; maximum soft error number allowedresource_exist	equ	$70		;Cannot expand file, resource already exist		res_add_err	equ	$71		;cannot add resource fork to this type file.********************************************************************************* Fatal Errors:*****************************************************************unclaimed_irq   equ    $01             ; unclaimed interruptsd_scm_dealloc  equ    $02             ; deallocation errorsd_scm_alloc    equ    $03             ; allocation errorwrong_os_ver    equ    $11             ; wrong operating system version****************************************************************** FST equates: to be removed when lou loader is working!!!!!!!!!*****************************************************************char_fst_entry  equ    $095000         ;address of Character FST header****************************************************************** DRIVER Equates:*****************************************************************drvr_dev_stat   equ    $0000           ; device status codedrvr_ctrl_stat  equ    $0001           ; return control parmsdrvr_get_wait   equ    $0002           ; return wait/no-wait modedrvr_get_format equ    $0003           ; get format optionsdrvr_reset      equ    $0000           ; reset the devicedrvr_format     equ    $0001           ; physically format the devicedrvr_eject      equ    $0002           ; eject the mediadrvr_set_ctrl   equ    $0003           ; set control parmsdrvr_set_wait   equ    $0004           ; set wait/no-wait modedrvr_set_format equ    $0005           ; set format optionsdrvr_set_ptn    equ    $0006           ; assign partition ownerdrvr_insert     equ    $0007           ; logical media insertion		eject****************************************************************** System Service Table Equates:*****************************************************************dev_dispatcher  equ	$01FC00         ;dev_dispatchcache_find_blk  equ	$01FC04         ;cash_findcache_add_blk   equ	$01FC08         ;cash_addcache_init      equ	$01FC0C         ;cache initializationcache_shutdn    equ	$01FC10         ;cash_shutdowncache_del_blk   equ	$01FC14         ;cash_deletecache_del_vol   equ	$01FC18         ;cash_del_volalloc_seg       equ	$01FC1C         ;alloc_zerorelease_seg     equ	$01FC20         ;deallocatealloc_vcr       equ	$01FC24         ;allocvcrrelease_vcr     equ	$01FC28         ;releasevcralloc_fcr       equ	$01FC2C         ;allocfcrrelease_fcr     equ	$01FC30         ;releasefcrswap_out        equ	$01FC34         ;swapoutderef           equ	$01FC38         ;deref2get_sys_gbuf    equ	$01FC3C         ;s_get_sys_gbufsys_exit        equ	$01FC40         ;s_sys_exitsys_death       equ	$01FC44         ;s_sys_deathfind_vcr        equ	$01FC48         ;findvcrfind_fcr        equ	$01FC4C         ;findfcrset_sys_speed   equ	$01FC50         ; set system speedcache_flsh_def  equ	$01FC54         ; flush deferred blocks from cacherename_vcr      equ	$01FC58         ;renamevcrrename_fcr      equ	$01FC5C         ;renamefcrget_vcr         equ	$01FC60         ;getvcrget_fcr         equ	$01FC64         ;getfcrlock_mem        equ	$01FC68         ;lockmemunlock_mem      equ	$01FC6C         ;unlockmemmove_info       equ	$01FC70         ;block move routinescvt_0to1        equ	$01FC74         ;cvt0to1cvt_1to0        equ	$01FC78         ;cvt1to0replace_80      equ	$01FC7C         ;replace80to_b0_core      equ	$01FC80         ;to_bank0_coregen_dispatch    equ	$01FC84         ;g_dispatchsignal          equ	$01FC88         ;signal_eventget_sys_buf     equ	$01FC8C         ;get_b0_bufset_disksw      equ	$01FC90         ;set_disk_swreport_error    equ	$01FC94         ;s_report_errormount_message   equ	$01FC98         ;s_mount_msgfull_error      equ	$01FC9C         ;s_full_errorreport_fatal    equ	$01FCA0         ;s_report_fatalsup_drvr_disp   equ	$01FCA4         ; supervisory dispatcherinstall_driver  equ	$01FCA8         ; install device driverget_boot_pfx    equ	$01FCAC         ;s_get_boot_pfxset_boot_pfx    equ	$01FCB0         ;s_set_boot_pfxalloc_cache_seg equ	$01FCB4         ;low_allocateget_stked_id    equ	$01FCB8         ;get id of prog at top of GQUIT stackdyn_slot_arbiter equ	$01FCBC         ; slot arbitration routineparse_pathname	equ	$01FCC0		;parse a pathnamehandle_os_event	equ	$01FCC4		;notify external code about os event.post_switch	equ	$01FCFC		; post a disk swap to FINDER (v4.1 only)system_death	equ	$E1001C		; the rom death mama		eject		****************************************************************** Volume Control Record (VCR) Equates*****************************************************************vcr_size        equ    18              ;Currently 18 bytes in lengthvcr_id          equ    $0000           ;offset to volume IDvcr_name        equ    vcr_id+2        ;offset to volume name pointervcr_status      equ    vcr_name+4      ;offset volume statusvcr_open_cnt    equ    vcr_status+2    ;offset to number of open files on vol.vcr_fst_id      equ    vcr_open_cnt+2  ;offset to owner ID numbervcr_dev         equ    vcr_fst_id+2    ;offset to where volume was last seenvcr_fst_ptr     equ    vcr_dev+2       ;offset to where volume was last seenvcr_swapped     equ    $4000           ;FLAG:Volume is swapped out (1 = true)vcr_swapped_in  equ    $BFFF           ;FLAG:Volume is swapped invcr_wr_enable   equ    $2000           ;FLAG:Volume has been seen write enabledvcr_wr_unknown  equ    $DFFF           ;FLAG:Volume has not been seen wrenbld****************************************************************** File Control Record Equates:*****************************************************************fcr_ref_num     equ    $0000fcr_path_name   equ    fcr_ref_num+2fcr_fst_id      equ    fcr_path_name+4fcr_vol_id      equ    fcr_fst_id+2fcr_level       equ    fcr_vol_id+2fcr_newline     equ    fcr_level+2fcr_newline_len equ    fcr_newline+4fcr_mask        equ    fcr_newline_len+2fcr_access      equ    fcr_mask+2		eject;--------------------------------------------------------------------------; cache header equates;; Copyright (c) 1987 Apple Computer Inc. All rights reserved.; author: Ray (Rowdy Yates) Chiang;--------------------------------------------------------------------------c_lru_fwd       equ    $0000           ;vp to  forward LRU vp linkc_lru_bwd       equ    c_lru_fwd+4     ;vp to backward LRU vp linkc_bkt_fwd       equ    c_lru_bwd+4     ;vp to  forward bucket vp linkc_bkt_bwd       equ    c_bkt_fwd+4     ;vp to backward bucket vp linkc_blknum        equ    c_bkt_bwd+4     ;block number  of cached blockc_blksize       equ    c_blknum+4      ;block   size  of cached blockc_fstnum        equ    c_blksize+2     ;FST number    of cached blockc_volumeid      equ    c_fstnum+2      ;volume id     of cached blockc_devnum        equ    c_volumeid+2    ;device number of cached blockc_priority      equ    c_devnum+2      ;cache priorityc_cellsize      equ    c_priority+2    ;size of this cache cellc_reserved      equ    c_cellsize+2    ;reservedc_headerlen     equ    c_reserved+4    ;length of cache headerc_cached_data   equ    c_reserved+4    ;offset to cached data block		eject****************************************************************** The following are equates for the driver's DIB*****************************************************************link_ptr        equ     $0000           ; (lw) link pointer to next dibentry_ptr       equ     link_ptr+4      ; (lw) pointer to driver entry pointdev_char        equ     entry_ptr+4     ; (w)  device characteristicsblk_cnt         equ     dev_char+2      ; (lw) number of blocks on devicedev_name        equ     blk_cnt+4       ; (32) count and ascii nameslot_num        equ     dev_name+32     ; (w)  slot where driver residesunit_num        equ     slot_num+2      ; (w)  unit within slotver_num         equ     unit_num+2      ; (w)  version number of driverdev_id_num      equ     ver_num+2       ; (w)  device ID numberhead_link       equ     dev_id_num+2    ; (w)  backward device link (devnum)forward_link    equ     head_link+2     ; (w)  backward device link (devnum)ext_dib_ptr	equ     forward_link+2  ; (lw) pointer to DIB extension data structuredib_dev_num     equ     ext_dib_ptr+4	; (w)  device number assigned DIB at startup****************************************************************** The following are equates for the driver's GDIB*****************************************************************drvr_class      equ     dib_dev_num+2   ; (w)  driver classdrvr_type       equ     drvr_class+2    ; (w)  driver typedrvr_subtype    equ     drvr_type+2     ; (w)  driver subtypecache_mask      equ     drvr_subtype+2  ; (w)  cache mask (block dev) oropen_flag       equ     cache_mask      ; (w)  open flag (character dev)block_size      equ     open_flag+2     ; (w)  block sizehardware_unit	equ     block_size+2    ; (w)  Reserved fieldvbl_head_ptr	equ	$E100D8		; (lw)	pointer to 1st vbl task queue entry		Print	on		eject;-----------------------------------------------;;   Forward addresses and entries;;-----------------------------------------------		entry	da_start		entry	da_shutdn		eject*******************************************************************		Desk Accessory Headers******************************************************************		export	os_trap_daos_trap_da	proc		string	pascal				dc.b	'GS/OS Internal Snooper'				string	asis		dc.l	da_start			; da startup		dc.l	da_shutdn			; da shutdown				endp		eject******************************************************************* This entry point is for shutting down the desk accessory.  It * has no function and returns imediately to the desk manager.** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************		export	da_shutdnda_shutdn	proc		longa	on		longi	on				rtl				endp				eject******************************************************************* This entry point is for running the GS/OS DIB dumper classic* desk accessory.  This CDA can dump portions of GS/OS direct* page associated with device drivers by mnemonic as well as* parameters within a device driver DIB as specifiec by the* device number currently on GS/OS direct page or input by the* user after the initial parameter display.** ENTRY: Call via 'JSL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTL'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Same as entry*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0******************************************************************		export	da_startda_start	proc		longa	on		longi	on		pha				; save environment		phx		phy		phd		phb		phk				; data bank = program bank		plb		php				sep	#$30			; 8 bit 'm' & 'x'		longa	off		longi	off				lda	>state_reg		; save the ROM state		pha		lda	#$00			; enable RAM read		sta	>state_reg				lda	>rd80vid		; save current 80 column video mode		pha		sta	>set80vid		; enable 80 column video mode		sta	>set80col				lda	>altcharset		; save current character set		pha		sta	>clraltchar		; and select normal character set		rep	#$30			; 16 bit 'm' & 'x'		longa	on		longi	on						pea	#gsos_dir_page		pld** Save GS/OS Direct page.*		ldx	#$00FEsave_dir_pg		lda	<gsos_dir_page,x		sta	|saved_page,x		dex		dex		bpl	save_dir_pg				pha				; space for result		ldx	#$2903			; get irq enable		jsl	tool_locator		pea	$0001			; disable keyboard interrupts		ldx	#$2303			; intsource		jsl	tool_locator				lda	<drvr_dev_num		; check driver device number is legal		bne	legal_dev_num		; it is		inc	<drvr_dev_num		; device 0 not legal so point at 1st devicelegal_dev_num		jsr	save_screen		; preserve current 80 column screen		jsr	set_dib_ptr		; point at current DIB		jsr	set_sib_ptr		; point at current SIB		lda	#$0015			; fake a right arrow key		jsr	dispatch		; display CDA options				eject** Now allow parameters to be input before next call.*next_call			jsr	edit_parm		; call parameter editor		bcc	next_call		; if not an exitquit_da		pla				; get previous interrupt source		asl	a			; create keyboard interrupt ref num		xba		and	#$0001		eor	#$0001		pha				; $0000=Enable Keyboard IRQ, $0001=Disable Keyboard IRQ		ldx	#$2303			; intsource		jsl	tool_locator				jsr	restore_screen		; restore original 80 column screen** Restore GS/OS Direct page.*		ldx	#$00FErestore_dir_pg		lda	|saved_page,x		sta	<gsos_dir_page,x		dex		dex		bpl	restore_dir_pg				sep	#$20			; 8 bit 'm'		longa	off				pla				; was alternate character set enabled?		bpl	no_altchar		; no		sta	>setaltchar		; else restore character setno_altchar		pla				; was 80 column video enabled?		bmi	no_40col		; yes		sta	>clr80col		; else restore 40 column video mode		sta	>clr80vidno_40col		pla				; restore ROM / RAM enable		sta	>state_reg		plp				; restore environment		plb		pld		ply		plx		pla		rtl                eject******************************************************************************** This routine waits for a key from the keyboard.** ENTRY: Call via 'JSR'*               A Reg = Undefined*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Undefined*               B Reg = Undefined*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0** EXIT:   Via an 'RTS'*               A Reg = Key character (7 bit ascii) in lsb*               X Reg = Undefined*               Y Reg = Undefined*             Dir Reg = Unchanged*               B Reg = Unchanged*               P Reg = N V M X D I Z C  E*                       ¥ ¥ 0 0 0 ¥ ¥ ¥  0*******************************************************************************edit_parm		longa	on		longi	on				jsr	wait_key		; wait for keyboard input		ldx	#0000			; key table indexchk_key_loop		cmp	|key_table,x		; is key in table		beq	found_key		; yes		inx		inx		cpx	#key_func_tbl-key_table		bne	chk_key_loop		; if key not found, go to same pagedispatch		stz	|ch			; home cursor		stz	|cv		tay				; preserve character for page display routine		lda	|vector_index		; calculate page display routine address		asl	a		tax		lda	|vector_table,x		pha		tya				; restore character for page display routine		rts				; and dispatch to page display routine		found_key		tay				; preserve key stroke		lda	|key_func_tbl,x		; get address of function		pha		tya				; restore keystroke		rts				; and dispatch to the functiongo_escape	sec				; else exit with DA quit flag                rtsgo_right_arrow	inc	|vector_index		; point at next CDA page		ldx	|vector_index		; overflow page list?		cpx	#page_cnt		blt	new_dispatch		; no, go to CDA page		ldx	#$0001			; else wrap CDA page		stx	|vector_index		bra	new_dispatch		go_left_arrow	dec	|vector_index		; point at previous CDA page		bmi	wrap_cda_page		bne	new_dispatch		; if no CDA page overflowwrap_cda_page	ldx	#page_cnt-1		; else wrap CDA page		stx	|vector_indexnew_dispatch	pha		jsr	home			; clear screen & home cursor position		pla		go_down_arrow	go_up_arrow	bra	dispatch		; go to pagego_copyright	stz	|vector_index		; get back to copyright page		lda	#$0015		bra	dispatch		select_page		ldy	|vector_index		; is current page = $0000?		bne	dispatch		; no, go to current page				lda	|key_hex_tbl,x		; translate key to vector index		sta	|vector_index		; select proper page		lda	#$0015			; act like a scroll switched pages		bra	new_dispatch				eject		key_table	dc.w	$001B			; escape		dc.w	$003F			; ?		dc.w	$0015			; right arrow		dc.w	$0008			; left arrow		dc.w	$000A			; down arrow		dc.w	$000B			; up arrow		dc.w	'0'			; 0 - Copyright Statement		dc.w	'1'			; 1 - GS/OS System Calls		dc.w	'2'			; 2 - GS/OS System Service Calls		dc.w	'3'			; 3 - GS/OS Error Codes		dc.w	'4'			; 4 - GS/OS USER ID		dc.w	'5'			; 5 - GS/OS Direct Page		dc.w	'6'			; 6 - GS/OS DIB		dc.w	'7'			; 7 - GS/OS SIB		dc.w	'8'			; 8 - GS/OS VCR		dc.w	'9'			; 9 - GS/OS FCR		dc.w	'A'			; A - GS/OS Cache		dc.w	'a'			; a - GS/OS Cache		dc.w	'B'			; B - GS/OS Trap		dc.w	'b'			; b - GS/OS Trap		dc.w	'C'			; C - GS/OS FST Numbers		dc.w	'c'			; c - GS/OS FST Numbers		dc.w	'D'			; D - GS/OS FST Headers		dc.w	'd'			; d - GS/OS FST Headers		dc.w	'E'			; E - GS/OS Block Diagram		dc.w	'e'			; e - GS/OS Block Diagram		dc.w	'F'			; F - GS Bank $E1 vectors		dc.w	'f'			; f - GS Bank $E1 vectors		dc.w	'G'			; G - Express Loader Info		dc.w	'g'			; g - Express Loader Info		dc.w	'H'			; H - Device dispatcher file list		dc.w	'h'			; h - Device dispatcher file list		dc.w	'I'			; I - vbl		dc.w	'i'			; i - vbl		dc.w	'J'			; J - Death Trap		dc.w	'j'			; j - Death Trap		dc.w	'K'			; K - Driver Calls		dc.w	'k'			; k - Driver Calls		dc.w	'L'			; L - Device Characteristics		dc.w	'l'			; l - Device Characteristics		dc.w	'M'			; M - Supervisor Characteristics		dc.w	'm'			; m - Supervisor Characteristics		dc.w	'N'			; N - Memory Attributes		dc.w	'n'			; n - Memory Attributes		dc.w	'O'			; O - GS/OS Memory Map		dc.w	'o'			; o - GS/OS Memory Map		dc.w	'P'			; P - Visit Monitor		dc.w	'p'			; p - Visit Monitor		dc.w	'Q'			; P - System User ID		dc.w	'q'			; p - System User ID		dc.w	'R'			; R - SCSI Direct Page		dc.w	'r'			; r - SCSI Direct Page		dc.w	'S'			; S - SCSI I/O record		dc.w	's'			; s - SCSI I/O record		dc.w	'T'			; T - SCSI device record		dc.w	't'			; t - SCSI device record		dc.w	'U'			; U - SCSI Internals		dc.w	'u'			; u - SCSI internals		dc.w	'V'			; V - Device ID List		dc.w	'v'			; v - Device ID List		dc.w	'W'			; W - Device Status		dc.w	'w'			; w - Device Status		dc.w	'X'			; X - ASCII Chart		dc.w	'x'			; x - ASCII Chart		dc.w	'Y'			; Y - unused		dc.w	'y'			; y - unused		dc.w	'Z'			; Z - unused		dc.w	'z'			; z - unused				eject		key_func_tbl	dc.w	go_escape-1		; escape		dc.w	go_copyright-1		; ?		dc.w	go_right_arrow-1	; rigth arrow		dc.w	go_left_arrow-1		; left arrow		dc.w	go_down_arrow-1		; down arrow		dc.w	go_up_arrow-1		; up arrow		dc.w	select_page-1		; 0 - Copyright statement		dc.w	select_page-1		; 1 - GS/OS System Calls		dc.w	select_page-1		; 2 - GS/OS System Service Calls		dc.w	select_page-1		; 3 - GS/OS Error Codes		dc.w	select_page-1		; 4 - GS/OS USER ID		dc.w	select_page-1		; 5 - GS/OS Direct Page		dc.w	select_page-1		; 6 - GS/OS DIB		dc.w	select_page-1		; 7 - GS/OS SIB		dc.w	select_page-1		; 8 - GS/OS VCR		dc.w	select_page-1		; 9 - GS/OS FCR		dc.w	select_page-1		; A - GS/OS Cache		dc.w	select_page-1		; a - GS/OS Cache		dc.w	select_page-1		; B - GS/OS Trap		dc.w	select_page-1		; b - GS/OS Trap		dc.w	select_page-1		; C - GS/OS FST Numbers		dc.w	select_page-1		; c - GS/OS FST Numbers		dc.w	select_page-1		; D - GS/OS FST Headers		dc.w	select_page-1		; d - GS/OS FST Headers		dc.w	select_page-1		; E - GS/OS Block Diagram		dc.w	select_page-1		; e - GS/OS Block Diagram		dc.w	select_page-1		; F - GS Bank $E1 vectors		dc.w	select_page-1		; f - GS Bank $E1 vectors		dc.w	select_page-1		; G - Express Loader Info		dc.w	select_page-1		; g - Express Loader Info		dc.w	select_page-1		; H - Device dispatcher file list	