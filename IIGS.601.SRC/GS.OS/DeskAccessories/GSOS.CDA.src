ard Disk',tab,24,'$0005 | Tape Drive (Generic)',tab,56,'$0015',$0D		dc.b	'SCSI Tape Drive',tab,24,'$0006 | Character (Generic)',tab,56,'$0016',$0D		dc.b	'SCSI CD ROM ',tab,24,'$0007 | MFM Floppy Disk',tab,56,'$0017',$0D		dc.b	'SCSI Printer',tab,24,'$0008 | Network (Generic)',tab,56,'$0018',$0D		dc.b	'Modem',tab,24,'$0009 | Sequential Access',tab,56,'$0019',$0D		dc.b	'Console',tab,24,'$000A | SCSI Scanner',tab,56,'$001A',$0D		dc.b	'Printer',tab,24,'$000B | Scanner',tab,56,'$001B',$0D		dc.b	'Serial LaserWriter',tab,24,'$000C | LaserWriter SC',tab,56,'$001C',$0D		dc.b	'AppleTalk LaserWriter',tab,24,'$000D | AppleTalk Main',tab,56,'$001D',$0D		dc.b	'RAM Disk',tab,24,'$000E | AppleTalk File Server',tab,56,'$001E',$0D		dc.b	'ROM Disk',tab,24,'$000F | AppleTalk RPM',tab,56,'$001F',$00		ejectas_fst_page		dc.b	'AppleShare FST Info',$0D		dc.b	'=============================================================',$0D		dc.b	'cmd',tab,24,'$',tab,30,'| cmd',tab,56,'$',$0D		dc.b	'result',tab,24,'$',tab,30,'| volid',tab,56,'$',$0D		dc.b	'completion',tab,20,'$',tab,30,'| bitmap',tab,56,'$',$0D		dc.b	tab,24,'$',tab,30,'|==============================',$0D		dc.b	'ticks',tab,24,'$',tab,30,'| reply',tab,56,'$',$0D		dc.b	tab,20,'$',tab,30,'| date',tab,52,'$',$0D		dc.b	'==============================|==============================',$0D		dc.b	'lastmod             $',tab,30,'| devnum',tab,56,'$',$0D		dc.b	'modcount',tab,24,'$',tab,30,'|==============================',$0D		dc.b	'==============================| cmd',tab,56,'$',$0D		dc.b	'cmd',tab,24,'$',tab,30,'| result',tab,56,'$',$0D		dc.b	'result',tab,24,'$',tab,30,'| completion',tab,52,'$',$0D		dc.b	'completion',tab,20,'$',tab,30,'|',tab,56,'$',$0D		dc.b	'sessrefnum',tab,24,'$',tab,30,'| ticks',tab,56,'$',$0D		dc.b	'cmdlen',tab,24,'$',tab,30,'|',tab,56,'$',$0D		dc.b	'cmdaddr',tab,20,'$',tab,30,'|==============================',$0D		dc.b	'repbuflen',tab,24,'$',tab,30,'|',$0D		dc.b	'repbufaddr',tab,20,'$',tab,30,'|',$0D		dc.b	'cmdres',tab,20,'$ ',tab,30,'|',$0D		dc.b	'replen',tab,24,'$',tab,30,'|',$00**	SCRIPT	dc.w	n					; number of elements in script*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 1st script element*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 2nd script element*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 3rd script element*		dc.w	ch,cv,len,type,type,res1,res2,res3	; 4th script element*		etc.**	where:	cv	A word value indicating horizontal screen position.*		ch	A word value indicating vertical screen position.*		len	A word value indicating length of the display field.*		offset	A word value indicating the position of data relative to [<temp]*		type	A word indicating the type of data to be displayed:*				$0000 = Hex*				$0001 = Handle*				$0002 = Virtual Pointer*				$0003 = Pascal String*				$0004 = Class 1 input string*				$0005 = Class 1 output string*				$0006 = C String*				$0007 = Binary*		res1	A reserved word ($0000).*		res2	A reserved word ($0000).*		res3	A reserved word ($0000).*as_fst_script	dc.w	30					; number of items in script		dc.w	25,2,word,$0000,t_hex,0,0,0		; cmd		dc.w	25,3,word,$0002,t_hex,0,0,0		; result		dc.w	21,4,long,$0004,t_hex,0,0,0		; completion		dc.w	25,5,word,$0008,t_hex,0,0,0		; 		dc.w	25,6,word,$000A,t_hex,0,0,0		; ticks		dc.w	21,7,long,$000C,t_hex,0,0,0		; 		dc.w	21,9,long,$0010,t_hex,0,0,0		; lastmod		dc.w	25,10,word,$0014,t_hex,0,0,0		; modcount		dc.w	25,12,word,$0016,t_hex,0,0,0		; cmd		dc.w	25,13,word,$0018,t_hex,0,0,0		; result		dc.w	21,14,long,$001A,t_hex,0,0,0		; completion		dc.w	27,15,byte,$001E,t_hex,0,0,0		; sessrefnum		dc.w	25,16,word,$001F,t_hex,0,0,0		; cmdlen		dc.w	21,17,long,$0021,t_hex,0,0,0		; cmdaddr		dc.w	25,18,word,$0025,t_hex,0,0,0		; repbuflen		dc.w	21,19,long,$0027,t_hex,0,0,0		; repbufaddr		dc.w	21,20,long,$002B,t_hex,0,0,0		; cmdres		dc.w	25,21,word,$002F,t_hex,0,0,0		; replen		dc.w	57,2,word,$0031,t_hex,0,0,0		; cmd		dc.w	57,3,word,$0033,t_hex,0,0,0		; volid		dc.w	57,4,word,$0035,t_hex,0,0,0		; bitmap		dc.w	57,6,word,$0037,t_hex,0,0,0		; reply		dc.w	53,7,long,$0039,t_hex,0,0,0		; date		dc.w	57,9,word,$003D,t_hex,0,0,0		; devnum		dc.w	57,11,word,$003F,t_hex,0,0,0		; cmd		dc.w	57,12,word,$0041,t_hex,0,0,0		; result		dc.w	53,13,long,$0043,t_hex,0,0,0		; completion		dc.w	57,14,word,$0047,t_hex,0,0,0		; 		dc.w	57,15,word,$0049,t_hex,0,0,0		; ticks		dc.w	53,16,long,$004B,t_hex,0,0,0		; dev_stat_page		dc.b	'GS/OS Block and Character Device Status',$0D		dc.b	'============================================================================',$0D		dc.b	'   ______________ Block Count Uncertain',$0D		dc.b	'  |    __________ Linked Device',$0D		dc.b	'  |   |    ______ Background Busy',$0D		dc.b	'  |   |   |                                    __ Online',$0D		dc.b	'  |   |   |                                   |        __________ Wrprot',$0D		dc.b	'  |   |   |                                   |       |    ______ Interrupt',$0D		dc.b	'  |   |   |                                   |       |   |    __ Disksw',$0D		dc.b	'  |   |   |                                   |       |   |   |',$0D		dc.b	' ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ___ ',$0D		dc.b	'|   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |   |',$0D		dc.b	'| F | E | D | C | B | A | 9 | 8 | 7 | 6 | 5 | 4 | 3 | 2 | 1 | 0 |',$0D		dc.b	'|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|___|',$0D		dc.b	'      |   |                               |   |           |   |__ Open',$0D		dc.b	'      |   |                               |   |           |______ Interrupt',$0D		dc.b	'      |   |                               |   |__ Online',$0D		dc.b	'      |   |                               |______ Buffer Full',$0D		dc.b	'      |   |______ Background Busy',$0D		dc.b	'      |__________ Linked Device',$0D,$0D		dc.b	'All unused bits are returned as zero.',$00		ascii_page		dc.b	'Ascii Chart',$0D		dc.b	'=========================