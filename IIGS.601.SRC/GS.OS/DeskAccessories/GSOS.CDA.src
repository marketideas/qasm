fst_id_str	dc.b	'Character  ',$00msdos_id_str	dc.b	'MS-DOS     ',$00hs_id_str	dc.b	'High Sierra',$00unk_id_str	dc.b	'Unknown    ',$00at_id_str	dc.b	'AppleShare ',$00fst_id_table		dc.l	prodos_id_str		; fst  1 = ProDOS FST		dc.l	dos_id_str		; fst  2 = DOS 3.3 FST		dc.l	dosxx_id_str		; fst  3 = DOS 3.1 & DOS 3.2 FST		dc.l	pascal_id_str		; fst  4 = Apple][ Pascal FST		dc.l	mfs_id_str		; fst  5 = MFS FST		dc.l	hfs_id_str		; fst  6 = HFS FST		dc.l	lisa_id_str		; fst  7 = LISA FST		dc.l	cpm_id_str		; fst  8 = Apple CP/m		dc.l	cfst_id_str		; fst  9 = Character FST		dc.l	msdos_id_str		; fst  A = MS-DOS FST		dc.l	hs_id_str		; fst  B = High Sierra FST		dc.l	unk_id_str		; fst  C = Unknown FST		dc.l	at_id_str		; fst  D = AppleShare FST		dc.l	unk_id_str		; fst  E = Unknown FST		dc.l	unk_id_str		; fst  F = Unknown FST		dc.l	unk_id_str		; fst 10 = Unknown FST		eject** The following variables are used to dispatch to the different CDA display pages.*vector_table	dc.w	display_page1-1		; Display copyright notice		dc.w	display_sys-1		; display system calls		dc.w	display_svc-1		; display system service calls		dc.w	display_err-1		; display system error codes		dc.w	display_id-1		; display GS/OS user ID numbers		dc.w	display_dir_pg-1	; Display GS/OS direct page		dc.w	display_dib_pg-1	; Display GS/OS device information blocks		dc.w	display_sib_pg-1	; Display GS/OS supervisor information blocks		dc.w	display_vcr_pg-1	; Display GS/OS volume control record		dc.w	display_fcr_pg-1	; Display GS/OS file control record		dc.w	display_cmi_pg-1	; Display GS/OS cache manager information		dc.w	display_trap-1		; display trap menus		dc.w	display_fst-1		; display FST numbers		dc.w	display_fst_hdr-1	; display FST headers		dc.w	display_block-1		; display GS/OS block diagram		dc.w	display_bank_e1-1	; display bank $E1 vectors		dc.w	display_express-1	; display express load info		dc.w	display_file_list-1	; display device dispatcher file list		dc.w	display_vbl-1		; display vbl interrupt queue		dc.w	death_trap-1		; trap system death		dc.w	display_driver-1	; display driver calls		dc.w	display_dev_char-1	; display device characteristics		dc.w	display_sup_char-1	; display supervisor characteristics		dc.w	display_mem_attr-1	; display memory attributes		dc.w	display_mem_map-1	; display GS/OS memory map		dc.w	goto_monitor-1		; enter the monitor		dc.w	display_user_id-1	; display system user ID		dc.w	display_scsi-1		; display SCSI direct page		dc.w	display_scsi_io-1	; display SCSI i/o record		dc.w	display_scsi_dev-1	; display SCSI device record		dc.w	display_scsi_int-1	; display SCSI internals		dc.w	display_dev_id-1	; V = Device ID List		dc.w	display_stat-1		; W = Device Status		dc.w	display_ascii-1		; X = Ascii Chart		dc.w	display_s-1		; Y = vaporware		dc.w	display_s-1		; Z = vaporware		dc.w	display_death-1		; one past last menu item - display trap infofst_vcr_table	dc.l	prodos_vcr_page		; fst 1 = ProDOS FST		dc.l	dos_vcr_page		; fst 2 = DOS 3.3 FST		dc.l	dosxx_vcr_page		; fst 3 = DOS 3.1 & DOS 3.2 FST		dc.l	pascal_vcr_page		; fst 4 = Apple][ Pascal FST		dc.l	mfs_vcr_page		; fst 5 = MFS FST		dc.l	hfs_vcr_page		; fst 6 = HFS FST		dc.l	lisa_vcr_page		; fst 7 = LISA FST		dc.l	cpm_vcr_page		; fst 8 = Apple CP/m		dc.l	cfst_vcr_page		; fst 9 = Character FST		dc.l	msdos_vcr_page		; fst A = MS-DOS FST		dc.l	hs_vcr_page		; fst B = High Sierra FST		dc.l	unk_vcr_page		; fst C = Unknown FST		dc.l	at_vcr_page		; fst D = AppleShare FSTfst_fcr_table	dc.l	prodos_fcr_page		; fst 1 = ProDOS FST		dc.l	dos_fcr_page		; fst 2 = DOS 3.3 FST		dc.l	dosxx_fcr_page		; fst 3 = DOS 3.1 & DOS 3.2 FST		dc.l	pascal_fcr_page		; fst 4 = Apple][ Pascal FST		dc.l	mfs_fcr_page		; fst 5 = MFS FST		dc.l	hfs_fcr_page		; fst 6 = HFS FST		dc.l	lisa_fcr_page		; fst 7 = LISA FST		dc.l	cpm_fcr_page		; fst 8 = Apple CP/m		dc.l	cfst_fcr_page		; fst 9 = Character FST		dc.l	msdos_fcr_page		; fst A = MS-DOS FST		dc.l	hs_fcr_page		; fst B = High Sierra FST		dc.l	unk_fcr_page		; fst C = Unknown FST		dc.l	at_fcr_page		; fst D = AppleShare FST		eject** The following tables are used to determine the script address used to * display the fst specific data within a vcr or fcr display page.*fst_vcr_data	dc.w	prodos_vcr		; fst 1 = ProDOS FST		dc.w	dos_vcr			; fst 2 = DOS 3.3 FST		dc.w	dosxx_vcr		; fst 3 = DOS 3.1 & DOS 3.2 FST		dc.w	pascal_vcr		; fst 4 = Apple][ Pascal FST		dc.w	mfs_vcr			; fst 5 = MFS FST		dc.w	hfs_vcr			; fst 6 = HFS FST		dc.w	lisa_vcr		; fst 7 = LISA FST		dc.w	cpm_vcr			; fst 8 = Apple CP/m		dc.w	cfst_vcr		; fst 9 = Character FST		dc.w	msdos_vcr		; fst A = MS-DOS FST		dc.w	hs_vcr			; fst B = High Sierra FST		dc.w	unk_vcr			; fst C = Unknown FST		dc.w	at_vcr			; fst D = AppleShare FSTfst_fcr_data	dc.w	prodos_fcr		; fst 1 = ProDOS FST		dc.w	dos_fcr			; fst 2 = DOS 3.3 FST		dc.w	dosxx_fcr		; fst 3 = DOS 3.1 & DOS 3.2 FST		dc.w	pascal_fcr		; fst 4 = Apple][ Pascal FST		dc.w	mfs_fcr			; fst 5 = MFS FST		dc.w	hfs_fcr			; fst 6 = HFS FST		dc.w	lisa_fcr		; fst 7 = LISA FST		dc.w	cpm_fcr			; fst 8 = Apple CP/m		dc.w	cfst_fcr		; fst 9 = Character FST		dc.w	msdos_fcr		; fst A = MS-DOS FST		dc.w	hs_fcr			; fst B = High Sierra FST		dc.w	unk_fcr			; fst C = Unknown FST		dc.w	at_fcr			; fst D = AppleShare FST		eject** The following are scripts used to display fst specific VCR data.* Scripts have a word count describing the number of items in the script.* Each item is described by 4 words of data as follows:**		word	horizontal cursor position of displayed data*		word	vertical cursor position of displayed data*		word	length of data field in bytes*		word	offset from beginning of vcr where data can be obtained &*			flag indicating if the data is a virtual pointer that needs*			to be dereferenced.  *prodos_vcr	dc.w	21			; number of items in script		dc.w	13,12,4,$0012		; vcr_res (most significant lw)		dc.w	21,12,4,$000E		; vcr_res (least significant lw)		dc.w	53,